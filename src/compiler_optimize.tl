                      [_t-bce-version : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [bce-version-result : OptFunctionCtxResult
                        (opt-bce-version-function-with-context-result
                          type-segment-bases
                          summaries.direct-call-clean
                          flag-exit-context
                          loop-cluster-verified?
                          flag-exit)]
                      [bce-version : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "bce_version"
                          (match bce-version-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [bce-version-context : OptCfgContext
                        (match bce-version-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-bce-version : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "bce_version"
                            name
                            _t-bce-version)
                          unit)]
                      ;; Constant fills become one tl_mem_fill8 call BEFORE the
                      ;; unroller sees them: unrolling a fill spends an 11-
                      ;; instruction version guard and a 4-per-slot remainder to
                      ;; reach 1.19 instructions per slot, while the runtime
                      ;; helper's `rep stosq` is 1.0 flat with neither. Running
                      ;; here also means the rewrite reads the versioner's own
                      ;; freshly built `__bce_guard`, which is what licenses
                      ;; dropping the loop (see the pass header).
                      [_t-fill-call : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [fill-call-result : OptFunctionCtxResult
                        (opt-fill-call-function-with-context-result
                          bce-version-context
                          loop-cluster-verified?
                          bce-version)]
                      [fill-call : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "fill_call"
                          (match fill-call-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [fill-call-context : OptCfgContext
                        (match fill-call-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-fill-call : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "fill_call"
                            name
                            _t-fill-call)
                          unit)]
                      ;; Byte copies become one tl_mem_copy_fwd call, and for
                      ;; the same reason fills do: it has to happen BEFORE the
                      ;; unroller, both because the unrolled x2 body is what
                      ;; costs 3.5 instructions per byte and because the rewrite
                      ;; reads the versioner's own freshly built `__bce_guard`
                      ;; for its trip-count fact (see the pass header).
                      [_t-copy-call : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [copy-call-result : OptFunctionCtxResult
                        (opt-copy-call-function-with-context-result
                          fill-call-context
                          loop-cluster-verified?
                          fill-call)]
                      [copy-call : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "copy_call"
                          (match copy-call-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [copy-call-context : OptCfgContext
                        (match copy-call-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-copy-call : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "copy_call"
                            name
                            _t-copy-call)
                          unit)]
                      ;; Canonical counted-loop unrolling (x4) runs on
                      ;; the versioned blocks. A successful rewrite
                      ;; versions at most one loop per pipeline iteration and
                      ;; rebuilds the context for the new CFG, so the stages
                      ;; below keep valid dominance facts.
                      [_t-unroll : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [unroll-result : OptFunctionCtxResult
                        (opt-unroll-function-with-context-result
                          type-segment-bases
                          copy-call-context
                          loop-cluster-verified?
                          copy-call)]
                      [unrolled : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "unroll"
                          (match unroll-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [unroll-context : OptCfgContext
                        (match unroll-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-unroll : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "unroll"
                            name
                            _t-unroll)
                          unit)]
                      ;; Byte-compose load combining runs immediately after the
                      ;; unroller: a constant-trip loop unrolled THIS iteration
                      ;; exposes its straight-line compose here, and the round's
                      ;; DCE below removes the dead byte loads/casts/shifts. The
                      ;; pass only rewrites instructions in place (no CFG or
                      ;; frame change), so the unroll context stays valid.
                      [_t-load-combine : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [load-combine : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "load_combine"
                          (match unrolled
                            [(ir.CompilerIrFunction.Function
                                _name
                                _params
                                _ret-ty
                                unrolled-frame
                                unrolled-blocks)
                              (ir.CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                unrolled-frame
                                (opt-load-combine-blocks
                                  unrolled-frame
                                  unrolled-blocks))]))]
                      [_p-load-combine : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "load_combine"
                            name
                            _t-load-combine)
                          unit)]
                      ;; Linear-function test replacement runs here, after
                      ;; bce_version and unroll: both key their rewrites on the
                      ;; counter phi this pass retires, so it has to see their
                      ;; output rather than take their input away. The retired
                      ;; form is handed straight to affine-fold/GVN below.
                      [_t-lftr : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [lftr-result : OptFunctionCtxResult
                        (opt-lftr-function-with-context-result
                          type-segment-bases
                          unroll-context
                          loop-cluster-verified?
                          load-combine)]
                      [lftr : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "lftr"
                          (match lftr-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [lftr-context : OptCfgContext
                        (match lftr-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-lftr : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "lftr"
                            name
                            _t-lftr)
                          unit)]
                      ;; LFTR materializes an end pointer in an inner loop's
                      ;; preheader after the ordinary LICM run. Give that fresh
                      ;; invariant (and any induction-created address recipe)
                      ;; one motion opportunity in the same pipeline iteration;
                      ;; otherwise an enclosing repetition loop recomputes it
                      ;; forever because the fixpoint rebuilds the LFTR shape
                      ;; after each earlier LICM run.
                      [_t-post-lftr-licm : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [post-lftr-licm-result : OptFunctionCtxResult
                        (opt-licm-function-with-context-result-and-direct-call-clean
                          type-segment-bases
                          lftr-context
                          loop-cluster-verified?
                          summaries.direct-call-clean
                          summaries.global-cell
                          true
                          lftr)]
                      [post-lftr-licm : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "post_lftr_licm"
                          (match post-lftr-licm-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [post-lftr-licm-context : OptCfgContext
                        (match post-lftr-licm-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-post-lftr-licm : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "post_lftr_licm"
                            name
                            _t-post-lftr-licm)
                          unit)]
                      ;; Invariant-offset Gep splitting. Two orderings pin it
                      ;; here. It has to follow bce_version, because only the
                      ;; fast clone drops the BoundsCheck that keeps the
                      ;; `invariant + counter` Add multi-use, and a split that
                      ;; leaves the Add live costs an instruction instead of
                      ;; saving one. It also has to follow the post-LFTR LICM,
                      ;; which is what lifts a versioned clone's descriptor data
                      ;; load into its preheader: until that runs the array base
                      ;; is still defined INSIDE the body, so the address is not
                      ;; yet recognizable as base-plus-invariant.
                      [_t-gep-offset : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [gep-offset-result : OptFunctionCtxResult
                        (opt-gep-offset-function-with-context-result
                          type-segment-bases
                          post-lftr-licm-context
                          loop-cluster-verified?
                          post-lftr-licm)]
                      [gep-offset : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "gep_offset"
                          (match gep-offset-result
                            [(OptFunctionCtxResult.Result f _) f]))]
                      [gep-offset-context : OptCfgContext
                        (match gep-offset-result
                          [(OptFunctionCtxResult.Result _ ctx) ctx])]
                      [_p-gep-offset : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "gep_offset"
                            name
                            _t-gep-offset)
                          unit)]
                      [unroll-frame : i64 (opt-function-frame gep-offset)]
                      ;; Affine chain folding must see the unroller's output
                      ;; INSIDE the same pipeline iteration: a lowered while
                      ;; loop spends iteration 1 on SSA+rotation and unrolls in
                      ;; iteration 2 (the fixpoint cap), so the fold-position
                      ;; run above never sees the fresh copies. The pass only
                      ;; rewrites instructions in place (no CFG change), so the
                      ;; post-LFTR LICM context stays valid below.
                      [unroll-blocks : ir.CompilerIrBlockList
                        (opt-affine-fold-blocks
                          (opt-function-frame gep-offset)
                          (opt-function-blocks gep-offset))]
                      ;; Cross-block global value numbering + copy propagation
                      ;; runs after local GVN/SCCP/CFG/LICM cleanup, on
                      ;; the post-stack-promotion frame so its slots stay
                      ;; consistent with the promoted blocks. It reuses the
                      ;; context the post-LFTR LICM handed back: affine folding
                      ;; only rewrites instructions, so that pass's output
                      ;; blocks preserve the same CFG.
                      ;; Its entry verify rides the loop-cluster verification:
                      ;; every pass in between post-verifies its own rewrite
                      ;; (falling back to its verified input), so a verified
                      ;; cluster input arrives here still verified.
                      [_t-global : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [global : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "global_gvn"
                          (if run-heavy?
                            (opt-global-value-number-function-with-context
                              type-segment-bases
                              gep-offset-context
                              loop-cluster-verified?
                              (ir.CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                unroll-frame
                                unroll-blocks))
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              unroll-frame
                              unroll-blocks)))]
                      [_p-global : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "global_gvn"
                            name
                            _t-global)
                          unit)]
                      [global-blocks : ir.CompilerIrBlockList
                        (opt-function-blocks global)]
                      ;; Substitute proven constant-global divisors with
                      ;; their literals before divrem-safety, so the literal
                      ;; divisor both enables the backend magic-multiply path and
                      ;; lets divrem-safety drop the zero/overflow guards. This
                      ;; only rewrites operand values, leaving the CFG
                      ;; structure intact, so the post-LFTR LICM context stays
                      ;; valid for the divrem-safety pass below.
                      [const-div-blocks : ir.CompilerIrBlockList
                        (opt-const-global-move-rewrite-summary-blocks
                          summaries
                          (opt-const-divisor-rewrite-summary-blocks
                            summaries
                            global-blocks))]
                      [_t-divrem-safety : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [divrem-safe : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "divrem_safety"
                          name
                          params
                          ret-ty
                          unroll-frame
                          (if run-heavy?
                            (opt-divrem-safety-blocks-with-context
                              type-segment-bases
                              gep-offset-context
                              params
                              const-div-blocks)
                            const-div-blocks))]
                      [_p-divrem-safety : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "divrem_safety"
                            name
                            _t-divrem-safety)
                          unit)]
                      ;; Split multi-use Geps into per-use single-use Geps so
                      ;; the backend's indexed-memory fusion fires on every
                      ;; Load/StorePtr (the quicksort swap shape). DCE then
                      ;; drops the now-unused original Gep defs.
                      [_t-gep-split : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [gep-split : ir.CompilerIrFunction
                        (if run-heavy?
                          (opt-gep-split-function
                            type-segment-bases
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              unroll-frame
                              divrem-safe))
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            unroll-frame
                            divrem-safe))]
                      [_p-gep-split : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "gep_split"
                            name
                            _t-gep-split)
                          unit)]
                      ;; Second rotation round. `flag_exit` is what makes a
                      ;; guarded compare loop rotatable at all: it retires the
                      ;; monotone flag's re-test and folds every outside reader
                      ;; of a loop-carried value to a literal, leaving a
                      ;; single-test header whose phis have no reader outside
                      ;; the loop -- exactly the shape `rotate_ssa` accepts, and
                      ;; the one it already rotates when the flag never escapes
                      ;; (`it-map-insert-from`). The rotation stage cannot see
                      ;; that shape: it sits six passes ABOVE `flag_exit`, a
                      ;; lowered `while` keeps its flag live at a non-phi reader
                      ;; through pipeline iteration 1 (flag_exit's C4) so the
                      ;; conversion lands on iteration 2, and
                      ;; `optimize-function-max-iterations` is 2 -- the
                      ;; rotatable shape is produced strictly after the last
                      ;; upstream chance to rotate it. Both clones of
                      ;; `benchmarks/intern_table`'s `it-slice-eq?` byte compare
                      ;; stayed top-tested for exactly that reason and paid an
                      ;; unconditional back-edge `jmp` on every byte.
                      ;;
                      ;; Placed below `global_gvn`, and that is not incidental.
                      ;; Rotation duplicates the header guard into the preheader
                      ;; with the phi's INIT value substituted, so a counted
                      ;; loop starting at zero clones `lt 0, n` -- which is
                      ;; textually the trip-count test `bce_version` already
                      ;; built for its own `__bce_guard`. Run above GVN, the
                      ;; clones CSE into that one compare, its three branch
                      ;; users stop being single-use, and the backend has to
                      ;; materialize the bool (`cmp`/`setl`/`movzbq`, then a
                      ;; `test` per site) instead of folding each into a
                      ;; `cmp`/`jcc`. Measured on `it-slice-eq?` that cost five
                      ;; instructions per call and ate a third of the rotation's
                      ;; win, and it regressed cfg_domloops and lex_source
                      ;; outright. Below GVN each clone stays single-use and
                      ;; fuses. Nothing downstream needs the top-tested shape:
                      ;; `cmp_sink` and `successor_sink` are block-local,
                      ;; `bool_branch_late` builds its own context, and the
                      ;; trailing dce/fold/cfg retire the landing block.
                      ;; The pass is unchanged and still verifier-gated; a loop
                      ;; the upstream stage already rotated has no unconditional
                      ;; back edge left, so `opt-loop-rotation-edge-compatible?`
                      ;; makes this round a no-op on it.
                      [_t-rotate-ssa-late : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [rotate-ssa-late : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "rotate_ssa"
                          (if run-heavy?
                            (match (opt-rotate-ssa-function-with-context-result
                              (opt-cfg-context-build
                                (opt-function-blocks gep-split))
                              false
                              gep-split)
                              [(OptFunctionCtxResult.Result f _) f])
                            gep-split))]
                      [_p-rotate-ssa-late : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "rotate_ssa"
                            name
                            _t-rotate-ssa-late)
                          unit)]
                      [gep-split-frame : i64
                        (opt-function-frame rotate-ssa-late)]
                      [gep-split-blocks : ir.CompilerIrBlockList
                        (opt-function-blocks rotate-ssa-late)]
                      [_t-cmp-sink : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      ;; Sink loop-closing compares next to their branches so
                      ;; the backend's compare+branch fusion fires past the
                      ;; flag-safe pointer-increment Gep (the counted-fill
                      ;; shape's setl/movzbq/test/jne becomes cmp;jcc).
                      [cmp-sink : ir.CompilerIrBlockList
                        (opt-cmp-sink-blocks gep-split-blocks)]
                      [_p-cmp-sink : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "cmp_sink"
                            name
                            _t-cmp-sink)
                          unit)]
                      [_t-successor-sink : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [successor-sink-function : ir.CompilerIrFunction
                        (if run-heavy?
                          (opt-successor-sink-function
                            type-segment-bases
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              gep-split-frame
                              cmp-sink))
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            gep-split-frame
                            cmp-sink))]
                      [successor-sink : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "successor_sink"
                          name
                          params
                          ret-ty
                          (opt-function-frame successor-sink-function)
                          (opt-function-blocks successor-sink-function))]
                      [successor-sink-frame : i64
                        (opt-function-frame successor-sink-function)]
                      [_p-successor-sink : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "successor_sink"
                            name
                            _t-successor-sink)
                          unit)]
                      ;; BCE versioning runs after the early bool-branch pass
                      ;; and may be the final CFG rewrite at the two-iteration
                      ;; fixpoint cap. Lower its materialized And guards here,
                      ;; after the passes that consume a single condition value
                      ;; and before DCE/regalloc. The shared helper retains its
                      ;; clone + verify rollback boundary.
                      [_t-bool-branch-late : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [bool-branch-late-input : ir.CompilerIrFunction
                        (ir.CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          successor-sink-frame
                          successor-sink)]
                      [bool-branch-late-result : OptFunctionPassResult
                        (if run-heavy?
                          (opt-bool-branch-chain-function-with-context-result
                            type-segment-bases
                            (if (opt-bool-branch-chain-blocks-have-candidate?
                              successor-sink)
                              (opt-cfg-context-build successor-sink)
                              (opt-cfg-context-empty))
                            false
                            bool-branch-late-input)
                          (OptFunctionPassResult.Result
                            bool-branch-late-input
                            false))]
                      [bool-branch-late-function : ir.CompilerIrFunction
                        (match bool-branch-late-result
                          [(OptFunctionPassResult.Result f _) f])]
                      [bool-branch-late : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "bool_branch_late"
                          name
                          params
                          ret-ty
                          (opt-function-frame bool-branch-late-function)
                          (opt-function-blocks bool-branch-late-function))]
                      [bool-branch-late-frame : i64
                        (opt-function-frame bool-branch-late-function)]
                      [_p-bool-branch-late : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "bool_branch_late"
                            name
                            _t-bool-branch-late)
                          unit)]
                      ;; Below every loop pass on purpose: it consumes a loop
                      ;; the versioner and the dominating-comparison fold have
                      ;; both already refused, and it reads the ROTATED shape
                      ;; (preheader jump, latch compare) that rotation and LICM
                      ;; leave behind. The `dce` below retires nothing it needs;
                      ;; the latch compare is retyped in place, not replaced.
                      [_t-ubound : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [ubound-input : ir.CompilerIrFunction
                        (ir.CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          bool-branch-late-frame
                          bool-branch-late)]
                      [ubound-function : ir.CompilerIrFunction
                        (match (if run-heavy?
                          (opt-ubound-function-pass
                            type-segment-bases
                            ubound-input)
                          (OptFunctionPassResult.Result ubound-input false))
                          [(OptFunctionPassResult.Result f _) f])]
                      [ubound : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "ubound"
                          name
                          params
                          ret-ty
                          (opt-function-frame ubound-function)
                          (opt-function-blocks ubound-function))]
                      [ubound-frame : i64 (opt-function-frame ubound-function)]
                      [_p-ubound : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "ubound"
                            name
                            _t-ubound)
                          unit)]
                      ;; Give every branch reading a GVN-unified comparison its
                      ;; own copy, so each site fuses to `cmp`/`jcc` instead of
                      ;; sharing one materialised boolean. Last in the pipeline
                      ;; on purpose: any CSE round below it would fold the
                      ;; copies straight back together. The `dce` that follows
                      ;; retires an original whose every reader took a copy.
                      [_t-cmp-dup : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [cmp-dup-function : ir.CompilerIrFunction
                        (opt-cmp-dup-function
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            ubound-frame
                            ubound))]
                      [cmp-dup : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "cmp_dup"
                          name
                          params
                          ret-ty
                          (opt-function-frame cmp-dup-function)
                          (opt-function-blocks cmp-dup-function))]
                      [cmp-dup-frame : i64
                        (opt-function-frame cmp-dup-function)]
                      [_p-cmp-dup : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "cmp_dup"
                            name
                            _t-cmp-dup)
                          unit)]
                      [_t-dce : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [dced : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "dce"
                          name
                          params
                          ret-ty
                          cmp-dup-frame
                          (opt-dce-block-list-array-fixpoint
                            cmp-dup-frame
                            cmp-dup
                            8))]
                      [_p-dce : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "dce"
                            name
                            _t-dce)
                          unit)]
                      ;; Pure scheduling, and last on purpose: it exists only
                      ;; to satisfy the backend's ADJACENCY requirement for the
                      ;; gep-load memory-operand folds, so nothing may run
                      ;; below it that could separate a pair again. Running it
                      ;; under `dce` also means the use tally it needs sees no
                      ;; dead readers, so a load whose only surviving consumer
                      ;; is the fold's BinOp is recognised as single-use.
                      [_t-load-sink : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [load-sink : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "load_sink"
                          name
                          params
                          ret-ty
                          cmp-dup-frame
                          (opt-load-sink-blocks cmp-dup-frame dced))]
                      [_p-load-sink : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "load_sink"
                            name
                            _t-load-sink)
                          unit)]
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        cmp-dup-frame
                        load-sink))]))]))])))

(define (optimize-function-once
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (optimize-function-once-with-summaries
    pools
    type-segment-bases
    func
    (opt-loop-bce-empty-summaries)))

;; Level 2 keeps the self-build path lightweight while preserving the explicit
;; optimized-level checks for local scalar cleanup, bounds checks, stack
;; promotion, CFG cleanup, DCE, and program-level reachability pruning.
(defenum OptLevel1PreDceResult
  (Result ir.CompilerIrFunction (__tl_dyn-array i64)))

(define (optimize-function-once-level2-pre-dce-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : OptLevel1PreDceResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [load-cse-profile : profile_state.CompilerProfileMetrics
          (profile_state.compiler-profile-state-metrics summaries.profile-state)]
        [_t-fold : i64 (cfg compile-profile (profile.now-ms) 0)]
        [folded : ir.CompilerIrBlockList
          (compiler-opt-debug-observe-blocks
            type-segment-bases
            "fold"
            name
            params
            ret-ty
            frame
            (optimize-block-list-for-function
              load-cse-profile
              pools
              type-segment-bases
              frame
              params
              blocks))]
        [_p-fold : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish
              summaries.profile-state
              "fold"
              name
              _t-fold)
            unit)]
        [loop-bce : ir.CompilerIrBlockList
          (if summaries.enabled
            (opt-loop-bce-blocks type-segment-bases summaries params folded)
            folded)]
        [_t-ctor-fwd : i64 (cfg compile-profile (profile.now-ms) 0)]
        [ctor-fwd : ir.CompilerIrBlockList
          (compiler-opt-debug-observe-blocks
            type-segment-bases
            "ctor_fwd"
            name
            params
            ret-ty
            frame
            (opt-ctor-fwd-function-blocks frame loop-bce))]
        [_p-ctor-fwd : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish
              summaries.profile-state
              "ctor_fwd"
              name
              _t-ctor-fwd)
            unit)]
        [_t-promote : i64 (cfg compile-profile (profile.now-ms) 0)]
        [promoted : ir.CompilerIrFunction
          (compiler-opt-debug-observe-function
            type-segment-bases
            "stack_promote"
            (opt-aggregate-stack-promote-function
              type-segment-bases
              (ir.CompilerIrFunction.Function name params ret-ty frame ctor-fwd)))]
        [_p-promote : unit
          (cfg
            compile-profile
            (compiler-opt-profile-pass-finish
              summaries.profile-state
              "stack_promote"
              name
              _t-promote)
            unit)]
        (match promoted
          [(ir.CompilerIrFunction.Function _ _ _ promoted-frame promoted-blocks)
            (let
              [_t-cfg : i64 (cfg compile-profile (profile.now-ms) 0)]
              [used : (__tl_dyn-array i64) (opt-used-array-new promoted-frame)]
              [cfg : ir.CompilerIrBlockList
                (compiler-opt-debug-observe-blocks
                  type-segment-bases
                  "cfg"
                  name
                  params
                  ret-ty
                  promoted-frame
                  (opt-cfg-simplify-blocks-in-place promoted-blocks used))]
              [_p-cfg : unit
                (cfg
                  compile-profile
                  (compiler-opt-profile-pass-finish
                    summaries.profile-state
                    "cfg"
                    name
                    _t-cfg)
                  unit)]
              (OptLevel1PreDceResult.Result
                (ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  promoted-frame
                  cfg)
                used))]))]))

(define (optimize-function-once-level2-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunction
  (match (optimize-function-once-level2-pre-dce-with-summaries
    pools
    type-segment-bases
    func
    summaries)
    [(OptLevel1PreDceResult.Result pre-dce used)
      (match pre-dce
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [_t-dce : i64 (cfg compile-profile (profile.now-ms) 0)]
            [dced : ir.CompilerIrBlockList
              (compiler-opt-debug-observe-blocks
                type-segment-bases
                "dce"
                name
                params
                ret-ty
                frame
                (opt-dce-block-list-array-in-place used blocks))]
            [_p-dce : unit
              (cfg
                compile-profile
                (compiler-opt-profile-pass-finish
                  summaries.profile-state
                  "dce"
                  name
                  _t-dce)
                unit)]
            (ir.CompilerIrFunction.Function name params ret-ty frame dced))])]))

(define (optimize-function-pass-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (let
    [next : ir.CompilerIrFunction
      (optimize-function-once-with-summaries
        pools
        type-segment-bases
        func
        summaries)]
    [changed : bool (not (opt-function-eq type-segment-bases func next))]
    (OptFunctionPassResult.Result
      (if changed
        next
        func)
      changed)))

(define (optimize-function-fixed-pass-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [remaining : i64]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (if (<= remaining 0)
    (OptFunctionPassResult.Result func false)
    (match (optimize-function-pass-with-summaries
      pools
      type-segment-bases
      func
      summaries)
      [(OptFunctionPassResult.Result next changed)
        (if changed
          (match (optimize-function-fixed-pass-with-summaries
            pools
            type-segment-bases
            next
            (- remaining 1)
            summaries)
            [(OptFunctionPassResult.Result fixed _)
              (OptFunctionPassResult.Result fixed true)])
          (OptFunctionPassResult.Result func false))])))

(define (optimize-function-fixed-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [remaining : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunction
  (match (optimize-function-fixed-pass-with-summaries
    pools
    type-segment-bases
    func
    remaining
    summaries)
    [(OptFunctionPassResult.Result next _) next]))

(define (optimize-function-fixed
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [remaining : i64]) : ir.CompilerIrFunction
  (optimize-function-fixed-with-summaries
    pools
    type-segment-bases
    func
    remaining
    (opt-loop-bce-empty-summaries)))

(define (opt-if-convert-final-pass
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match (opt-if-convert-function-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next changed)
      (OptFunctionPassResult.Result
        (compiler-opt-debug-observe-function
          type-segment-bases
          "if_convert"
          next)
        changed)]))

(define (opt-if-convert-final
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-if-convert-final-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next _) next]))

(define (optimize-function
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (opt-if-convert-final
    type-segment-bases
    (optimize-function-fixed
      pools
      type-segment-bases
      func
      (optimize-function-max-iterations))))

;; Opt levels (0/1/2): 0 = none, 1 = cheap stack-only (the fast self-compile
;; path), 2 = the full optimizer + scalar register allocation + inlining (the
;; quality "ship" build). The old four-level scheme (with a redundant -fast level
;; between 0 and the cheap level) was collapsed: old level 2 became level 1 and
;; old level 3 became level 2.
(define (optimize-function-with-level-and-summaries-pass
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : OptFunctionPassResult
  (if (= level 0)
    (OptFunctionPassResult.Result func false)
    (if (= level 1)
      ;; Keep the documented cheap self-compile path cheap.  The final
      ;; if-conversion boundary performs CFG and natural-loop analysis and is
      ;; reserved for the release-quality level below; compare/test lowering
      ;; remains part of this single optimizer pass.
      (let
        [next : ir.CompilerIrFunction
          (optimize-function-once-level2-with-summaries
            pools
            type-segment-bases
            func
            summaries)]
        [changed : bool (not (opt-function-eq type-segment-bases func next))]
        (OptFunctionPassResult.Result
          (if changed
            next
            func)
          changed))
      (match (optimize-function-fixed-pass-with-summaries
        pools
        type-segment-bases
        func
        (optimize-function-max-iterations)
        summaries)
        [(OptFunctionPassResult.Result fixed fixed-changed)
          (match (opt-if-convert-final-pass type-segment-bases fixed)
            [(OptFunctionPassResult.Result final if-convert-changed)
              (let
                [unswitched : ir.CompilerIrFunction
                  (compiler-opt-debug-observe-function
                    type-segment-bases
                    "licm_unswitch"
                    (opt-licm-unswitch-final type-segment-bases final))]
                [unswitch-changed : bool
                  (not (opt-function-eq type-segment-bases final unswitched))]
                ;; Last position in the pipeline on purpose: the arm blocks this
                ;; removes are lowering artifacts, but versioning, unrolling and
                ;; unswitching all clone blocks after the last CFG cleanup, so
                ;; running anywhere earlier would leave their copies behind.
                (match (opt-cfg-straighten-final-pass
                  type-segment-bases
                  unswitched)
                  [(OptFunctionPassResult.Result
                      straightened
                      straighten-changed)
                    (OptFunctionPassResult.Result
                      straightened
                      (or
                        fixed-changed
                        if-convert-changed
                        unswitch-changed
                        straighten-changed))]))])]))))

(define (optimize-function-with-level-and-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunction
  (match (optimize-function-with-level-and-summaries-pass
    pools
    type-segment-bases
    func
    level
    summaries)
    [(OptFunctionPassResult.Result next _) next]))

(define (optimize-function-with-level
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [level : i64]) : ir.CompilerIrFunction
  (optimize-function-with-level-and-summaries
    pools
    type-segment-bases
    func
    level
    (opt-loop-bce-empty-summaries)))

;; Optimizer input carrier (opt2 only).
;;
;; The whole-program inline stage runs in a dedicated arena, and by the time it
;; returns only its final rewritten bodies are still read: the devirtualized
;; function index, the call graph, the SCC and census tables, every superseded
;; caller generation, and every superseded spans array are already dead. Those
;; leftovers are the majority of that arena (measured on the self-compile: 460
;; MiB committed, of which a deep copy of the surviving reachable functions is
;; 204 MiB), and a bump arena cannot release them piecewise. The per-function
;; optimizer loop then reads the surviving functions from end to end, so the
;; whole arena -- dead generations included -- would otherwise stay resident
;; across the loop, which is where the opt2 process peak forms.
;;
;; So copy just the surviving functions into a carrier arena, release the inline
;; arena before the loop starts, and release the carrier once the loop has
;; escaped every optimized function into the enclosing arena. The copy costs one
;; transient overlap of the two arenas before the loop -- cheaper than carrying
;; the dead generations through it, because the loop's own scratch peak lands on
;; top of whatever the input costs.
;;
;; Level 1 keeps the direct path: its inline stage is the cheap tiny-leaf pass,
;; whose arena is a fraction of the level-2 one, and the cheap self-compile path
;; must not pay for a whole-program copy.
(define (opt-optimizer-input-carrier [level : i64]) : i64
  (if (< level 2)
    0
    (arena.tl_arena_make)))

(define (opt-optimizer-input-carry
  [pools : ast.AstNodePoolContext]
  [carrier : i64]
  [funcs : ir.CompilerIrFunctionList]) : ir.CompilerIrFunctionList
  (if (= carrier 0)
    funcs
    (let
      [home : i64 (arena.tl_arena_current)]
      [_enter : unit
        (unsafe
          (arena.tl_arena_set carrier))]
      [carried : ir.CompilerIrFunctionList
        (ir.compiler-ir-clone-function-list pools funcs)]
      [_leave : unit
        (unsafe
          (arena.tl_arena_set home))]
      carried)))

;; Both optimizer-input arenas report under the same mid-phase label: each is
;; read at its high-water mark and destroyed before the "optimize" phase
;; snapshot, so neither belongs in that snapshot's unique-root total.
(define (opt-release-optimizer-input-arena [owner : String] [handle : i64]) : unit
  (begin
    (allocation_profile.compiler-allocation-profile-control!
      2
      "optimize.inline"
      owner
      handle)
    (unsafe
      (arena.tl_arena_destroy handle))))

;; Per-function arena escape. The optimizer fixpoint allocates up to
;; ~80 throwaway IR copies per function (10 iterations x ~8 passes), none freed
;; by the bump allocator. To cap peak memory we run each function's optimization
;; in a reusable scratch arena, deep-`clone` only the final result back into the
;; enclosing (program) arena, then rewind the scratch so a single function's
;; transient generations are reclaimed before the next function is processed.
;; Level 1 is a single cheap pass sequence, so it combines final DCE, compaction,
;; and escape materialization into one enclosing-arena pass instead of compacting
;; in scratch and then cloning the whole function. The scratch path remains for
;; opt2/fixpoint.
(define (optimize-function-list-with-level-and-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [funcs : ir.CompilerIrFunctionList]
  [level : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunctionList
  (if (= level 0)
    funcs
    (if (= level 1)
      (let
        [scratch : i64 (arena.tl_arena_make)]
        [result : ir.CompilerIrFunctionList
          (optimize-function-list-level1-escaping-with-summaries
            pools
            type-segment-bases
            funcs
            scratch
            summaries)]
        (begin
          (allocation_profile.compiler-allocation-profile-control!
            2
            "optimize"
            "optimizer-scratch"
            scratch)
          (unsafe
            (arena.tl_arena_destroy scratch))
          result))
      (let
        [scratch : i64 (arena.tl_arena_make)]
        [result : ir.CompilerIrFunctionList
          (optimize-function-list-escaping-with-summaries
            pools
            type-segment-bases
            funcs
            level
            scratch
            summaries)]
        (begin
          (allocation_profile.compiler-allocation-profile-control!
            2
            "optimize"
            "optimizer-scratch"
            scratch)
          (unsafe
            (arena.tl_arena_destroy scratch))
          result)))))

(define (optimize-function-level1-escaping-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [_profile-name : String
      (cfg compile-profile (compiler-opt-profile-function-name func) "")]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [_t-body : i64 (cfg compile-profile (profile.now-ms) 0)]
        [pre-dce-result : OptLevel1PreDceResult
          (optimize-function-once-level2-pre-dce-with-summaries
            pools
            type-segment-bases
            func
            summaries)]
        [_profile-body : unit
          (cfg
            compile-profile
            (compiler-opt-profile-escape-finish "body" 1 _profile-name _t-body))]
        (match pre-dce-result
          [(OptLevel1PreDceResult.Result pre-dce used)
            (match pre-dce
              [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
                (let
                  [_t-dce : i64 (cfg compile-profile (profile.now-ms) 0)]
                  [scratch-head : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set enclosing))
                    (let
                      [escaped-blocks : ir.CompilerIrBlockList
                        (opt-dce-block-list-array-escape pools used blocks)]
                      [escaped : ir.CompilerIrFunction
                        (ir.CompilerIrFunction.Function
                          (ir.compiler-ir-symbol-clone name)
                          (ir.compiler-ir-clone-param-list pools params)
                          (ir.compiler-ir-clone-type pools ret-ty)
                          frame
                          escaped-blocks)]
                      [_profile-dce : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-escape-finish
                            "dce_escape"
                            1
                            _profile-name
                            _t-dce))]
                      [new-enclosing : i64 (arena.tl_arena_current)]
                      [_t-restore : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [_restore : unit
                        (unsafe
                          (arena.tl_arena_set scratch-head)
                          (arena.tl_region_reset mark)
                          (arena.tl_arena_set new-enclosing))]
                      [_profile-restore : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-escape-finish
                            "restore"
                            1
                            _profile-name
                            _t-restore))]
                      escaped)))])])))))

(define (optimize-function-list-level1-escaping-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [funcs : ir.CompilerIrFunctionList]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunctionList
  (match funcs
    [(ir.CompilerIrFunctionList.Nil) (ir.CompilerIrFunctionList.Nil)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (let
        [_start : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-start summaries.profile-state))]
        [optimized : ir.CompilerIrFunction
          (optimize-function-level1-escaping-with-summaries
            pools
            type-segment-bases
            func
            scratch
            summaries)]
        [_report : unit
          (cfg
            compile-profile
            (compiler-opt-scratch-region-report-function-escaping
              type-segment-bases
              optimized
              scratch))]
        [_finish : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-finish
              summaries.profile-state
              "function"
              (compiler-opt-profile-function-name func)))]
        (ir.compiler-ir-function-cons
          optimized
          (optimize-function-list-level1-escaping-with-summaries
            pools
            type-segment-bases
            (__tl-box-place rest)
            scratch
            summaries)))]
    [(ir.CompilerIrFunctionList.Array seq)
      (ir.compiler-ir-function-list-compact
        (optimize-function-list-level1-escaping-with-summaries
          pools
          type-segment-bases
          (ir.compiler-ir-function-seq-to-list seq)
          scratch
          summaries))]))

(define (optimize-function-list-escaping-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [funcs : ir.CompilerIrFunctionList]
  [level : i64]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunctionList
  (match funcs
    [(ir.CompilerIrFunctionList.Nil) (ir.CompilerIrFunctionList.Nil)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (let
        [_start : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-start summaries.profile-state))]
        [optimized : ir.CompilerIrFunction
          (optimize-function-escaping-with-summaries
            pools
            type-segment-bases
            func
            level
            scratch
            summaries)]
        [_report : unit
          (cfg
            compile-profile
            (compiler-opt-scratch-region-report-function-escaping
              type-segment-bases
              optimized
              scratch))]
        [_finish : unit
          (cfg
            compile-profile
            (compiler-opt-profile-detail-finish
              summaries.profile-state
              "function"
              (compiler-opt-profile-function-name func)))]
        (ir.compiler-ir-function-cons
          optimized
          (optimize-function-list-escaping-with-summaries
            pools
            type-segment-bases
            (__tl-box-place rest)
            level
            scratch
            summaries)))]
    [(ir.CompilerIrFunctionList.Array seq)
      (ir.compiler-ir-function-list-compact
        (optimize-function-list-escaping-with-summaries
          pools
          type-segment-bases
          (ir.compiler-ir-function-seq-to-list seq)
          level
          scratch
          summaries))]))

;; Optimize one function inside `scratch`, compact its blocks there, then escape
;; the result by deep-cloning it into the enclosing arena and rewinding `scratch`
;; for reuse. Even a no-op function must cross this ownership boundary: the
;; optimizer input belongs to the lower-IR arena, which is released before the
;; backend consumes the optimized program.
(define (optimize-function-escaping-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [level : i64]
  [scratch : i64]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [_profile-name : String
      (cfg compile-profile (compiler-opt-profile-function-name func) "")]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [_t-body : i64 (cfg compile-profile (profile.now-ms) 0)]
        [body-result : OptFunctionPassResult
          (optimize-function-with-level-and-summaries-pass
            pools
            type-segment-bases
            func
            level
            summaries)]
        [_profile-body : unit
          (cfg
            compile-profile
            (compiler-opt-profile-escape-finish
              "body"
              level
              _profile-name
              _t-body))]
        (match body-result
          [(OptFunctionPassResult.Result body _)
            (let
              [_t-compact : i64 (cfg compile-profile (profile.now-ms) 0)]
              [optimized : ir.CompilerIrFunction
                (ir.compiler-ir-function-compact-blocks body)]
              [_profile-compact : unit
                (cfg
                  compile-profile
                  (compiler-opt-profile-escape-finish
                    "compact"
                    level
                    _profile-name
                    _t-compact))]
              [scratch-head : i64 (arena.tl_arena_current)]
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (let
                  [_t-clone : i64 (cfg compile-profile (profile.now-ms) 0)]
                  [escaped : ir.CompilerIrFunction
                    (ir.compiler-ir-clone-function pools optimized)]
                  [_profile-clone : unit
                    (cfg
                      compile-profile
                      (compiler-opt-profile-escape-finish
                        "clone"
                        level
                        _profile-name
                        _t-clone))]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  [_t-restore : i64 (cfg compile-profile (profile.now-ms) 0)]
                  [_restore : unit
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))]
                  [_profile-restore : unit
                    (cfg
                      compile-profile
                      (compiler-opt-profile-escape-finish
                        "restore"
                        level
                        _profile-name
                        _t-restore))]
                  escaped)))])))))

(defenum OptMaybeFunction
  (No)
  (Some ir.CompilerIrFunction))

(defenum OptSlotList
  (Nil)
  (Cons i64 (Box OptSlotList)))

(defstruct OptFunctionNameIndex
  (ids opt_i64_i64_map.Map))

(defstruct OptFunctionIndex
  (names OptFunctionNameIndex)
  (values (__tl_dyn-array ir.CompilerIrFunction))
  (leaf-starts (__tl_dyn-array i64)))

(defstruct OptCallGraph
  (count i64)
  (edges (__tl_dyn-array OptSlotList)))

(defstruct OptInlineCensus
  ;; All three maps are keyed by OptFunctionIndex dense slots. IR spellings are
  ;; resolved once at the index boundary and never retained as census keys.
  (refcount opt_i64_i64_map.Map)
  (addrtaken opt_i64_i64_map.Map)
  ;; The same references as `refcount`, each weighted by the loop nesting depth
  ;; of the block that holds it. See opt-inline-census-depth-weight.
  (hotcount opt_i64_i64_map.Map))

;; (next block index, saw a back edge) from one function's back-edge marking.
(defenum OptInlineDepthMark
  (Mark i64 bool))

(defstruct OptSccResult
  (scc-of (__tl_dyn-array i64))
  (order (__tl_dyn-array i64)))

(defenum OptSccDiscoverState
  (State i64 i64))

(defenum OptSccPopState
  (State i64 i64))

;; Reachability working set keyed on each function's dense index slot (the value
;; OptFunctionIndex.names already maps a name to). `reachable` dedups by slot
;; (a generated i64/i64 map) and the worklist carries slots, so per-edge dedup,
;; membership, and pop-and-resolve are O(1) i64 compares instead of re-hashing
;; and string_eq-ing the name (string_eq was ~6% of an opt1 self-compile,
;; dominated by these
;; reach/cfg sweeps). One name->slot probe per reference stays (unavoidable to
;; resolve a reference), but the index value is a plain slot, so no global intern
;; table is mutated -- IR names live in the transient optimize arena and interning
;; them would dangle a table pointer after the rewind.
(defstruct OptReachWorklist
  (items opt_dense_i64_vec.Vec)
  (len i64))

(defenum OptReachWorklistPop
  (Empty)
  (Item i64 OptReachWorklist))

(define (opt-reach-worklist-new) : OptReachWorklist
  (OptReachWorklist (opt_dense_i64_vec.with-capacity 16) 0))

(define (opt-reach-worklist-push
  [worklist : OptReachWorklist (:consume)]
  [slot : i64]) : OptReachWorklist
  (let
    [items : opt_dense_i64_vec.Vec worklist.items]
    [len : i64 worklist.len]
    (begin
      (if (< len (opt_dense_i64_vec.len (& items)))
        (opt_dense_i64_vec.set (&mut items) len slot)
        (opt_dense_i64_vec.push (&mut items) slot))
      (OptReachWorklist items (+ len 1)))))

(define (opt-reach-worklist-pop [worklist : OptReachWorklist]) : OptReachWorklistPop
  (let
    [len : i64 worklist.len]
    (if (<= len 0)
      (OptReachWorklistPop.Empty)
      (let
        [next-len : i64 (- len 1)]
        (OptReachWorklistPop.Item
          (array-ref (opt_dense_i64_vec.slots (& worklist.items)) next-len)
          (OptReachWorklist worklist.items next-len))))))

(defenum OptReachState
  (State opt_i64_i64_map.Map OptReachWorklist opt_i64_i64_map.Map i64))

(defenum OptRuntimeStringHelper
  (No)
  (Some String i64))

(defenum OptPrunedProgram
  (Program ir.CompilerIrGlobalList ir.CompilerIrFunctionList))

(define (opt-pruned-program-globals [pruned : OptPrunedProgram]) : ir.CompilerIrGlobalList
  (match pruned
    [(OptPrunedProgram.Program globals _) globals]))

(define (opt-pruned-program-functions [pruned : OptPrunedProgram]) : ir.CompilerIrFunctionList
  (match pruned
    [(OptPrunedProgram.Program _ functions) functions]))

(define (opt-function-index-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (opt-function-list-count [functions : ir.CompilerIrFunctionList]) : i64
  (match functions
    [(ir.CompilerIrFunctionList.Nil) 0]
    [(ir.CompilerIrFunctionList.Cons _ rest)
      (+ 1 (opt-function-list-count (__tl-box-place rest)))]
    [(ir.CompilerIrFunctionList.Array seq)
      (ir.compiler-ir-function-seq-count seq)]))

(define (opt-function-name-index-add
  [names : OptFunctionNameIndex (:consume)]
  [name : i64]
  [slot : i64]) : OptFunctionNameIndex
  (let
    [ids : opt_i64_i64_map.Map names.ids]
    [name-id : i64 (ir.compiler-ir-symbol-id name)]
    (begin
      (if (>= name-id 0)
        (opt_i64_i64_map.insert-ref! (&mut ids) name-id slot)
        unit)
      (OptFunctionNameIndex ids))))

(define (opt-function-index-fill
  [functions : ir.CompilerIrFunctionList]
  [names : OptFunctionNameIndex (:consume)]
  [values : (__tl_dyn-array ir.CompilerIrFunction)]
  [leaf-starts : (__tl_dyn-array i64)]
  [index : i64]) : OptFunctionNameIndex
  (match functions
    [(ir.CompilerIrFunctionList.Nil) names]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (begin
            (set! (array-ref values index) func)
            (set!
              (array-ref leaf-starts index)
              (opt-symbol-leaf-start (ir.compiler-ir-symbol-text name)))
            (opt-function-index-fill
              (__tl-box-place rest)
              (opt-function-name-index-add names name index)
              values
              leaf-starts
              (+ index 1)))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-function-index-fill
        (ir.compiler-ir-function-seq-to-list seq)
        names
        values
        leaf-starts
        index)]))

(define (opt-function-index-build [functions : ir.CompilerIrFunctionList]) : OptFunctionIndex
  (let
    [count : i64 (opt-function-list-count functions)]
    [values : (__tl_dyn-array ir.CompilerIrFunction)
      (array.make-array ir.CompilerIrFunction count)]
    [leaf-starts : (__tl_dyn-array i64) (array.make-array i64 count)]
    [names : OptFunctionNameIndex
      (opt-function-index-fill
        functions
        (OptFunctionNameIndex
          (opt_i64_i64_map.with-capacity (opt-function-index-capacity count)))
        values
        leaf-starts
        0)]
    (OptFunctionIndex names values leaf-starts)))

(define (opt-function-index-count [index : OptFunctionIndex]) : i64
  (array-length index.values))

(define (opt-function-index-slot-id [index : OptFunctionIndex] [name-id : i64]) : option_i64.Option
  (if (< name-id 0)
    (option_i64.None)
    (let
      [slot : i64 (opt_i64_i64_map.get-value-or (& index.names.ids) name-id -1)]
      (if (>= slot 0)
        (option_i64.Some slot)
        (option_i64.None)))))

(define (opt-function-index-slot [index : OptFunctionIndex] [name : i64]) : option_i64.Option
  (opt-function-index-slot-id index (ir.compiler-ir-symbol-id name)))

;; Resolve a function by its dense index slot (the value held in `names` and in
;; the reachability worklist). Slots only come from a successful name lookup, so
;; they are always in range.
(define (opt-function-index-at-slot [index : OptFunctionIndex] [slot : i64]) : ir.CompilerIrFunction
  (array-ref index.values slot))

(define (opt-slot-list-contains? [slots : OptSlotList] [slot : i64]) : bool
  (match slots
    [(OptSlotList.Nil) false]
    [(OptSlotList.Cons item rest)
      (if (= item slot)
        true
        (opt-slot-list-contains? (__tl-box-place rest) slot))]))

(define (opt-slot-list-add [slots : OptSlotList] [slot : i64]) : OptSlotList
  (if (opt-slot-list-contains? slots slot)
    slots
    (OptSlotList.Cons slot (box slots))))

(define (opt-slot-list-count [slots : OptSlotList]) : i64
  (match slots
    [(OptSlotList.Nil) 0]
    [(OptSlotList.Cons _ rest)
      (+ 1 (opt-slot-list-count (__tl-box-place rest)))]))

(define (opt-callgraph-add-callee
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [name : i64]) : OptSlotList
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot) (opt-slot-list-add callees slot)]
    [(option_i64.None) callees]))

;; Deliberately call-only: address-taken function values are reachability roots,
;; but they are not direct call-graph edges for the inliner.
(define (opt-callgraph-instr
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [instr : ir.CompilerIrInstr]) : OptSlotList
  (match instr
    [(ir.CompilerIrInstr.Call _ name _ _)
      (opt-callgraph-add-callee index callees name)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        (opt-callgraph-add-callee index callees name))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [name (__tl-project-field (__tl-box-place payload-box) callee)]
        (opt-callgraph-add-callee index callees name))]
    [(ir.CompilerIrInstr.TailCall name _ _)
      (opt-callgraph-add-callee index callees name)]
    [_ callees]))

(define (opt-callgraph-instr-seq-from
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [instr-index : i64]
  [count : i64]) : OptSlotList
  (if (>= instr-index count)
    callees
    (opt-callgraph-instr-seq-from
      index
      (opt-callgraph-instr index callees (array-ref slots instr-index))
      slots
      (+ instr-index 1)
      count)))

(define (opt-callgraph-instr-seq
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [instrs : ir.CompilerIrInstrSeq]) : OptSlotList
  (opt-callgraph-instr-seq-from index callees instrs.slots 0 instrs.len))

(define (opt-callgraph-blocks
  [index : OptFunctionIndex]
  [callees : OptSlotList]
  [blocks : ir.CompilerIrBlockList]) : OptSlotList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) callees]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-callgraph-blocks
            index
            (opt-callgraph-instr-seq index callees instrs)
            (__tl-box-place rest))])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [acc : OptSlotList callees]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! acc (opt-callgraph-instr-seq index acc instrs))])
              (set! i (+ i 1))))
          acc))]))

(define (opt-callgraph-callees
  [index : OptFunctionIndex]
  [func : ir.CompilerIrFunction]) : OptSlotList
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-callgraph-blocks index OptSlotList.Nil blocks)]))

(define (opt-callgraph-init-edges
  [edges : (__tl_dyn-array OptSlotList)]
  [slot : i64]
  [count : i64]) : unit
  (if (>= slot count)
    unit
    (begin
      (set! (array-ref edges slot) OptSlotList.Nil)
      (opt-callgraph-init-edges edges (+ slot 1) count))))

(define (opt-callgraph-build-slots
  [index : OptFunctionIndex]
  [edges : (__tl_dyn-array OptSlotList)]
  [values : (__tl_dyn-array ir.CompilerIrFunction)]
  [slot : i64]
  [count : i64]) : unit
  (if (>= slot count)
    unit
    (begin
      (set!
        (array-ref edges slot)
        (opt-callgraph-callees index (array-ref values slot)))
      (opt-callgraph-build-slots index edges values (+ slot 1) count))))

(define (opt-callgraph-build [index : OptFunctionIndex]) : OptCallGraph
  (let
    [count : i64 (opt-function-index-count index)]
    [edges : (__tl_dyn-array OptSlotList) (array.make-array OptSlotList count)]
    [values : (__tl_dyn-array ir.CompilerIrFunction) index.values]
    (begin
      (opt-callgraph-init-edges edges 0 count)
      (opt-callgraph-build-slots index edges values 0 count)
      (OptCallGraph count edges))))

(define (opt-inline-census-capacity [index : OptFunctionIndex]) : i64
  (opt-function-index-capacity (opt-function-index-count index)))

;; --- loop-depth-weighted reference counting ---------------------------------
;;
;; A static reference count answers "how many places name this callee", and
;; every admission band above spends it as if it also answered "how often does
;; this callee run". For an absorbed or duplicated body those are the same
;; question -- the body moves to the sites, so the count is the growth. For the
;; shared-accessor tier they are not: that tier's whole argument is the callee's
;; DYNAMIC weight, and a per-element accessor reached from four sites inside one
;; scan loop runs orders more often than one named from sixty straight-line
;; sites.
;;
;; So the census keeps a second count in the currency the accessor tier actually
;; wants: each reference is weighted by the loop nesting depth of the block that
;; holds it, W^min(depth, cap). This is the classic static frequency estimate
;; (LLVM and GCC both weight a loop level by about ten); W is 8 here because it
;; is a power of two, and the cap is 2 so one weight is exactly the tier's
;; existing 64-reference floor. Read as an admission rule, the floor now says:
;; sixty-four straight-line references, OR eight references inside a loop, OR
;; one reference inside a nested loop -- three statements of the same evidence
;; that the callee is dynamically dominant.
;;
;; The weight is never below 1, so this count is always at least the raw count
;; and no callee that used to clear a floor stops clearing it.
(define (opt-inline-census-depth-base) : i64
  8)

(define (opt-inline-census-depth-cap) : i64
  2)

(define (opt-inline-census-depth-weight [depth : i64]) : i64
  (let
    [capped : i64
      (if (> depth (opt-inline-census-depth-cap))
        (opt-inline-census-depth-cap)
        depth)]
    [weight : i64 1]
    [level : i64 0]
    (begin
      (while (< level capped)
        (begin
          (set! weight (* weight (opt-inline-census-depth-base)))
          (set! level (+ level 1))))
      weight)))

;; Per-block loop depth of the function currently being censused. Depth is
;; estimated from BACK EDGES IN BLOCK ORDER -- an edge whose target sits at or
;; before its source -- rather than from dominator-based natural loops, because
;; the census walks every function in the program and a dominator solve per
;; function is the cost this file already refuses to pay eagerly (see
;; opt-inline-caller-facts-ensure!). The two agree on every reducible CFG this
;; compiler lowers, and where they disagree the estimate is only a weight: a
;; wrong answer misprices a candidate, it cannot make an inline unsound.
;;
;; While edges are marked, each header slot holds one past its furthest latch.
;; Coalescing by header is load-bearing: a reducible loop may have several
;; latches (for example, two `continue` paths), but those edges describe one
;; loop level rather than nested loops. A descending pass turns the coalesced
;; ranges into a difference sequence, and a prefix sum then produces every
;; block's depth. The whole estimate stays linear in blocks plus edges.
(define opt-inline-census-depth-slots : (__tl_dyn-array i64)
  (array.make-array i64 64))
(define opt-inline-census-depth-count : i64
  0)
(define opt-inline-census-depth-active? : bool
  false)

;; Weight of the block the census is currently walking, read by add-ref. A
;; global instead of a threaded parameter for the same reason the site facts
;; above are globals: the census walk is a value-threading fold and every arm
;; would otherwise carry a constant.
(define opt-inline-census-site-weight : i64
  1)

;; The scratch outlives optimizer arena rewinds for the same reason the CFG
;; label table does, so it grows in the IR label arena.
(define (opt-inline-census-depth-reserve! [count : i64]) : unit
  (if (<= count (array-length opt-inline-census-depth-slots))
    unit
    (let
      [size : i64 (array-length opt-inline-census-depth-slots)]
      (begin
        (while (< size count)
          (set! size (* size 2)))
        (in-arena
          (arena.Arena (ir.compiler-ir-label-arena))
          (set! opt-inline-census-depth-slots (array.make-array i64 size)))))))

(define (opt-inline-census-depth-clear! [count : i64]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (set! (array-ref opt-inline-census-depth-slots i) 0)
        (set! i (+ i 1))))))

(define (opt-inline-census-depth-stamp!
  [blocks : ir.CompilerIrBlockList]
  [generation : i64]
  [start : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) start]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (begin
            (opt-cfg-label-table-put! label start generation)
            (opt-inline-census-depth-stamp!
              (__tl-box-place rest)
              generation
              (+ start 1)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label _)
                  (opt-cfg-label-table-put! label (+ start i) generation)])
              (set! i (+ i 1))))
          (+ start count)))]))

;; One edge. Only a target at or before the source opens a loop; a forward edge
;; (including the fall-through this walk never has to ask about, which always
;; goes to the next block) contributes nothing. Keep the furthest latch for a
;; header so multiple backedges into one loop do not manufacture extra nesting.
(define (opt-inline-census-depth-edge!
  [target : i64]
  [generation : i64]
  [source : i64]) : bool
  (let
    [id : i64 (opt-cfg-label-table-get target generation)]
    (if (and (>= id 0) (<= id source))
      (let
        [end : i64 (+ source 1)]
        [previous : i64 (array-ref opt-inline-census-depth-slots id)]
        (begin
          (if (> end previous)
            (set! (array-ref opt-inline-census-depth-slots id) end)
            unit)
          true))
      false)))

(define (opt-inline-census-depth-switch-cases!
  [cases : ir.CompilerIrSwitchCaseList]
  [generation : i64]
  [source : i64]
  [found : bool]) : bool
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil) found]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ label)
          (opt-inline-census-depth-switch-cases!
            (__tl-box-place rest)
            generation
            source
            (or (opt-inline-census-depth-edge! label generation source) found))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-inline-census-depth-switch-cases!
        (ir.compiler-ir-switch-case-seq-to-list seq)
        generation
        source
        found)]))

(define (opt-inline-census-depth-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [generation : i64]
  [source : i64]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [i : i64 0]
    [found : bool false]
    (begin
      (while (< i count)
        (begin
          (match (array-ref slots i)
            [(ir.CompilerIrInstr.Jump label)
              (set!
                found
                (or
                  (opt-inline-census-depth-edge! label generation source)
                  found))]
            [(ir.CompilerIrInstr.Branch _ true-label false-label)
              (begin
                (set!
                  found
                  (or
                    (opt-inline-census-depth-edge! true-label generation source)
                    found))
                (set!
                  found
                  (or
                    (opt-inline-census-depth-edge!
                      false-label
                      generation
                      source)
                    found)))]
            [(ir.CompilerIrInstr.TotalEnumBranch _ true-label false-label)
              (begin
                (set!
                  found
                  (or
                    (opt-inline-census-depth-edge! true-label generation source)
                    found))
                (set!
                  found
                  (or
                    (opt-inline-census-depth-edge!
                      false-label
                      generation
                      source)
                    found)))]
            [(ir.CompilerIrInstr.Switch _ _ cases default-label)
              (begin
                (set!
                  found
                  (or
                    (opt-inline-census-depth-edge!
                      default-label
                      generation
                      source)
                    found))
                (set!
                  found
                  (opt-inline-census-depth-switch-cases!
                    cases
                    generation
                    source
                    found)))]
            [(ir.CompilerIrInstr.TotalEnumSwitch _ _ cases default-label _)
              (begin
                (set!
                  found
                  (or
                    (opt-inline-census-depth-edge!
                      default-label
                      generation
                      source)
                    found))
                (set!
                  found
                  (opt-inline-census-depth-switch-cases!
                    cases
                    generation
                    source
                    found)))]
            [_ unit])
          (set! i (+ i 1))))
      found)))

(define (opt-inline-census-depth-mark!
  [blocks : ir.CompilerIrBlockList]
  [generation : i64]
  [start : i64]
  [found : bool]) : OptInlineDepthMark
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptInlineDepthMark.Mark start found)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-inline-census-depth-mark!
            (__tl-box-place rest)
            generation
            (+ start 1)
            (or (opt-inline-census-depth-instrs! instrs generation start) found))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [i : i64 0]
        [any? : bool found]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    any?
                    (or
                      (opt-inline-census-depth-instrs!
                        instrs
                        generation
                        (+ start i))
                      any?))])
              (set! i (+ i 1))))
          (OptInlineDepthMark.Mark (+ start count) any?)))]))

(define (opt-inline-census-depth-prefix! [count : i64]) : unit
  (let
    [i : i64 1]
    (while (< i count)
      (begin
        (set!
          (array-ref opt-inline-census-depth-slots i)
          (+
            (array-ref opt-inline-census-depth-slots i)
            (array-ref opt-inline-census-depth-slots (- i 1))))
        (set! i (+ i 1))))))

;; Convert the header -> furthest-latch records into range deltas. Descending
;; order lets this reuse the same array: every interval end is after its header,
;; so its header record has already been consumed before an earlier interval
;; can write a closing delta into that slot.
(define (opt-inline-census-depth-ranges! [count : i64]) : unit
  (let
    [i : i64 (- count 1)]
    (while (>= i 0)
      (let
        [end : i64 (array-ref opt-inline-census-depth-slots i)]
        (begin
          (set! (array-ref opt-inline-census-depth-slots i) 0)
          (if (> end i)
            (begin
              (set!
                (array-ref opt-inline-census-depth-slots i)
                (+ (array-ref opt-inline-census-depth-slots i) 1))
              (set!
                (array-ref opt-inline-census-depth-slots end)
                (- (array-ref opt-inline-census-depth-slots end) 1)))
            unit)
          (set! i (- i 1)))))))

;; Install per-block depths for one function. A body with no back edge at all --
;; the common case -- leaves the estimate inactive and every site weighs 1, so
;; the prefix pass is skipped and the walk never reads the array.
(define (opt-inline-census-depths-build! [blocks : ir.CompilerIrBlockList]) : unit
  (let
    [count : i64 (ir.compiler-ir-block-list-count blocks)]
    (begin
      (set! opt-inline-census-depth-active? false)
      (set! opt-inline-census-depth-count 0)
      (set! opt-inline-census-site-weight 1)
      (if (< count 2)
        unit
        (let
          [generation : i64 (opt-cfg-label-table-begin!)]
          (begin
            (opt-inline-census-depth-reserve! (+ count 1))
            (opt-inline-census-depth-clear! (+ count 1))
            (opt-inline-census-depth-stamp! blocks generation 0)
            (match (opt-inline-census-depth-mark! blocks generation 0 false)
              [(OptInlineDepthMark.Mark _ found)
                (if found
                  (begin
                    (opt-inline-census-depth-ranges! count)
                    (opt-inline-census-depth-prefix! count)
                    (set! opt-inline-census-depth-count count)
                    (set! opt-inline-census-depth-active? true))
                  unit)])))))))

(define (opt-inline-census-depth-at [position : i64]) : i64
  (if (and
    opt-inline-census-depth-active?
    (< position opt-inline-census-depth-count))
    (array-ref opt-inline-census-depth-slots position)
    0))

(define (opt-inline-census-bump-map
  [map : opt_i64_i64_map.Map (:consume)]
  [slot : i64]
  [amount : i64]) : opt_i64_i64_map.Map
  (begin
    (match (opt_i64_i64_map.get (& map) slot)
      [(opt_i64_i64_map.LookupFound count)
        (opt_i64_i64_map.insert-ref! (&mut map) slot (+ count amount))]
      [(opt_i64_i64_map.LookupMissing)
        (opt_i64_i64_map.insert-ref! (&mut map) slot amount)])
    map))

(define (opt-inline-census-add-ref
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [name : i64]) : OptInlineCensus
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (OptInlineCensus
        (opt-inline-census-bump-map census.refcount slot 1)
        census.addrtaken
        (opt-inline-census-bump-map
          census.hotcount
          slot
          opt-inline-census-site-weight))]
    [(option_i64.None) census]))

(define (opt-inline-census-add-address
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [name : i64]) : OptInlineCensus
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (let
        [addrtaken : opt_i64_i64_map.Map census.addrtaken]
        (begin
          (opt_i64_i64_map.insert-ref! (&mut addrtaken) slot 1)
          (OptInlineCensus census.refcount addrtaken census.hotcount)))]
    [(option_i64.None) census]))

(define (opt-inline-census-value
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [value : ir.CompilerIrValue]) : OptInlineCensus
  (match value
    [(ir.CompilerIrValue.Function name)
      (opt-inline-census-add-address index census name)]
    [_ census]))

(define (opt-inline-census-args-array
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [arg-index : i64]) : OptInlineCensus
  (if (>= arg-index (array-length values))
    census
    (opt-inline-census-args-array
      index
      (opt-inline-census-value index census (array-ref values arg-index))
      values
      (+ arg-index 1))))

(define (opt-inline-census-args
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [args : ir.CompilerIrCallArgs]) : OptInlineCensus
  (match args
    [(ir.CompilerIrCallArgs.Nil) census]
    [(ir.CompilerIrCallArgs.One value)
      (opt-inline-census-value index census value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (opt-inline-census-value index (opt-inline-census-value index census a) b)]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-inline-census-args-array index census values 0)]))

(define (opt-inline-census-spmd-args
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [args : ir.CompilerIrSpmdCallArgList]) : OptInlineCensus
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) census]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (opt-inline-census-spmd-args
            index
            (opt-inline-census-value index census value)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : OptInlineCensus census]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-inline-census-value index out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-inline-census-maybe-value
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [maybe : ir.CompilerIrMaybeValue]) : OptInlineCensus
  (match maybe
    [(ir.CompilerIrMaybeValue.No) census]
    [(ir.CompilerIrMaybeValue.Some value)
      (opt-inline-census-value index census value)]))

(define (opt-inline-census-phi-inputs
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [inputs : ir.CompilerIrPhiInputList]) : OptInlineCensus
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) census]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-inline-census-phi-inputs
        index
        census
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (opt-inline-census-phi-inputs
        index
        (opt-inline-census-value index census value)
        (__tl-box-place rest))]))

(define (opt-inline-census-value-list
  [index : OptFunctionIndex]
  [census : OptInlineCensus (:consume)]
  [values : ir.CompilerIrValueList]) : OptInlineCensus
  (match values
    [(ir.CompilerIrValueList.Nil) census]
    [(ir.CompilerIrValueList.Array seq)
      (opt-inline-census-value-list
        index
        census
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (opt-inline-census-value-list
        index
        (opt-inline-census-value index census value)
        (__tl-box-place rest))]))

(define (opt-inline-census-instr
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instr : ir.CompilerIrInstr]) : OptInlineCensus
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.Alloc _ _) census]
    [(ir.CompilerIrInstr.AddrOf _ _) census]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census base)
        offset)]
    [(ir.CompilerIrInstr.Load _ src _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.StorePtr dst src _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census dst)
        src)]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census dst)
        src)]
    [(ir.CompilerIrInstr.BoundsCheck idx length _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census idx)
        length)]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census lhs)
        rhs)]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.LaneId _ _ _) census]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (opt-inline-census-value index census value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-inline-census-value
          index
          (opt-inline-census-value index census lhs)
          rhs))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (opt-inline-census-value
          index
          (opt-inline-census-value index census src)
          carry))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-inline-census-value
          index
          (opt-inline-census-value index census lhs)
          rhs))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census lhs)
        rhs)]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (opt-inline-census-value
          index
          (opt-inline-census-value
            index
            (opt-inline-census-value index census mask)
            on-true)
          on-false))]
    [(ir.CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census base)
        idx)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (opt-inline-census-value
          index
          (opt-inline-census-value
            index
            (opt-inline-census-value index census base)
            idx)
          value))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-inline-census-value
          index
          (opt-inline-census-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census base)
              idx)
            value)
          mask))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-inline-census-value
          index
          (opt-inline-census-value
            index
            (opt-inline-census-value index census base)
            idx)
          mask))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        (opt-inline-census-value
          index
          (opt-inline-census-value
            index
            (opt-inline-census-value index census base)
            index-base)
          idx))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (opt-inline-census-value
          index
          (opt-inline-census-maybe-value
            index
            (opt-inline-census-value
              index
              (opt-inline-census-value index census source)
              selector-low)
            selector-high)
          active-lanes))]
    [(ir.CompilerIrInstr.TailMask _ idx length _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census idx)
        length)]
    [(ir.CompilerIrInstr.EntryArgc _) census]
    [(ir.CompilerIrInstr.EntryArgv _) census]
    [(ir.CompilerIrInstr.EntryEnvp _) census]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-inline-census-value
        index
        (opt-inline-census-value index census leaf)
        subleaf)]
    [(ir.CompilerIrInstr.Xgetbv _ idx)
      (opt-inline-census-value index census idx)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (opt-inline-census-args index census args)]
    [(ir.CompilerIrInstr.Call _ name args _)
      (opt-inline-census-add-ref
        index
        (opt-inline-census-args index census args)
        name)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-inline-census-add-ref
          index
          (opt-inline-census-args
            index
            (opt-inline-census-value index census base)
            args)
          name))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [name (__tl-project-field (__tl-box-place payload-box) callee)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-inline-census-add-ref
          index
          (opt-inline-census-spmd-args
            index
            (opt-inline-census-value index census active-mask)
            args)
          name))]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-inline-census-args
          index
          (opt-inline-census-value
            index
            (opt-inline-census-value index census base)
            func)
          args))]
    [(ir.CompilerIrInstr.TailCall name args _)
      (opt-inline-census-add-ref
        index
        (opt-inline-census-args index census args)
        name)]
    [(ir.CompilerIrInstr.Store _ value _)
      (opt-inline-census-value index census value)]
    [(ir.CompilerIrInstr.Jump _) census]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-inline-census-value index census cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-inline-census-value index census cond)]
    [(ir.CompilerIrInstr.Return maybe)
      (opt-inline-census-maybe-value index census maybe)]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-inline-census-phi-inputs index census inputs)]
    ;; Register-group ops use their operands (Pack: each word; Word: src).
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-inline-census-value-list index census words)]
    [(ir.CompilerIrInstr.Word _ src _ _)
      (opt-inline-census-value index census src)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (opt-inline-census-args
        index
        (opt-inline-census-value index census func)
        args)]
    [(ir.CompilerIrInstr.Switch idx _ _ _)
      (opt-inline-census-value index census idx)]
    [(ir.CompilerIrInstr.TotalEnumSwitch idx _ _ _ _)
      (opt-inline-census-value index census idx)]))

(define (opt-inline-census-instr-seq-from
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instrs : ir.CompilerIrInstrSeq]
  [instr-index : i64]) : OptInlineCensus
  (if (>= instr-index (ir.compiler-ir-instr-seq-count instrs))
    census
    (opt-inline-census-instr-seq-from
      index
      (opt-inline-census-instr
        index
        census
        (ir.compiler-ir-instr-seq-ref instrs instr-index))
      instrs
      (+ instr-index 1))))

(define (opt-inline-census-instr-seq
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [instrs : ir.CompilerIrInstrSeq]) : OptInlineCensus
  (opt-inline-census-instr-seq-from index census instrs 0))

;; `position` is the block's index in this function's block order, the same
;; order opt-inline-census-depths-build! numbered. Each block installs its own
;; site weight before its instructions are walked.
(define (opt-inline-census-blocks
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [blocks : ir.CompilerIrBlockList]
  [position : i64]) : OptInlineCensus
  (match blocks
    [(ir.CompilerIrBlockList.Nil) census]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (set!
              opt-inline-census-site-weight
              (opt-inline-census-depth-weight
                (opt-inline-census-depth-at position)))
            (opt-inline-census-blocks
              index
              (opt-inline-census-instr-seq index census instrs)
              (__tl-box-place rest)
              (+ position 1)))])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [acc : OptInlineCensus census]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (set!
                opt-inline-census-site-weight
                (opt-inline-census-depth-weight
                  (opt-inline-census-depth-at (+ position i))))
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! acc (opt-inline-census-instr-seq index acc instrs))])
              (set! i (+ i 1))))
          acc))]))

(define (opt-inline-census-function
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func : ir.CompilerIrFunction]) : OptInlineCensus
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (begin
        (opt-inline-census-depths-build! blocks)
        (opt-inline-census-blocks index census blocks 0))]))

(define (opt-inline-census-functions
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [functions : ir.CompilerIrFunctionList]) : OptInlineCensus
  (match functions
    [(ir.CompilerIrFunctionList.Nil) census]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (opt-inline-census-functions
        index
        (opt-inline-census-function index census func)
        (__tl-box-place rest))]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-inline-census-functions
        index
        census
        (ir.compiler-ir-function-seq-to-list seq))]))

(define (opt-inline-census-build
  [index : OptFunctionIndex]
  [functions : ir.CompilerIrFunctionList]) : OptInlineCensus
  (let
    [capacity : i64 (opt-inline-census-capacity index)]
    (opt-inline-census-functions
      index
      (OptInlineCensus
        (opt_i64_i64_map.with-capacity capacity)
        (opt_i64_i64_map.with-capacity capacity)
        (opt_i64_i64_map.with-capacity capacity))
      functions)))

(define (opt-inline-census-refcount
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : i64
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (match (opt_i64_i64_map.get (& census.refcount) slot)
        [(opt_i64_i64_map.LookupFound count) count]
        [(opt_i64_i64_map.LookupMissing) 0])]
    [(option_i64.None) 0]))

;; The loop-depth-weighted reference count. Always at least the raw count: the
;; weight of a depth-0 site is 1.
(define (opt-inline-census-hot-refcount
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : i64
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (match (opt_i64_i64_map.get (& census.hotcount) slot)
        [(opt_i64_i64_map.LookupFound count) count]
        [(opt_i64_i64_map.LookupMissing) 0])]
    [(option_i64.None) 0]))

(define (opt-inline-census-address-taken?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : bool
  (match (opt-function-index-slot index name)
    [(option_i64.Some slot)
      (opt_i64_i64_map.contains? (& census.addrtaken) slot)]
    [(option_i64.None) false]))

;; The caller-independent half of the absorbable test: exactly one static
;; reference, not address-taken, not `main`. A function that passes this is one
;; the pipeline expects to disappear into its unique call site, so asking it of
;; the CALLER answers "would growing this body cost it its own inline?".
(define (opt-inline-census-single-site?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]) : bool
  (and
    (= (opt-inline-census-refcount index census name) 1)
    (not (opt-inline-census-address-taken? index census name))
    (not (string.eq (ir.compiler-ir-symbol-text name) "main"))))

(define (opt-inline-census-absorbable?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [caller-name : i64]
  [callee-name : i64]) : bool
  (and
    (opt-inline-census-single-site? index census callee-name)
    (not (ir.compiler-ir-symbol-eq? caller-name callee-name))))

;; Largest static reference count a callee may carry and still be treated as
;; belonging to its call sites. 1 is absorption: the body moves and nothing is
;; left behind. 2 is duplication: the body is copied into both sites, and the
;; measured leaves that qualify (see opt-inline-dup-absorb-ok?) are small enough
;; that the copy is cheaper than the boundary it retires.
(define (opt-inline-dup-max-refcount) : i64
  2)

;; The reference class of a callee seen from one caller, and the one census
;; query the multiblock sites make: 0 when the callee belongs to no site,
;; otherwise its reference count (1 = absorbable, up to
;; opt-inline-dup-max-refcount = duplicable). Address-taken callees, `main`, and
;; self-calls are class 0 for the same reasons opt-inline-census-absorbable?
;; refuses them. Class 1 is exactly opt-inline-census-absorbable?, so the sites
;; that used to ask that question read this number instead of paying for a
;; second refcount lookup.
(define (opt-inline-census-absorb-class
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [caller-name : i64]
  [callee-name : i64]) : i64
  (let
    [refs : i64 (opt-inline-census-refcount index census callee-name)]
    (if (or
      (< refs 1)
      (> refs (opt-inline-dup-max-refcount))
      (ir.compiler-ir-symbol-eq? caller-name callee-name)
      (opt-inline-census-address-taken? index census callee-name)
      (string.eq (ir.compiler-ir-symbol-text callee-name) "main"))
      0
      refs)))

(define (opt-callgraph-callee-count [graph : OptCallGraph] [from-slot : i64]) : i64
  (if (or (< from-slot 0) (>= from-slot graph.count))
    -1
    (opt-slot-list-count (array-ref graph.edges from-slot))))

(define (opt-callgraph-has-edge?
  [graph : OptCallGraph]
  [from-slot : i64]
  [to-slot : i64]) : bool
  (if (or
    (< from-slot 0)
    (< to-slot 0)
    (>= from-slot graph.count)
    (>= to-slot graph.count))
    false
    (opt-slot-list-contains? (array-ref graph.edges from-slot) to-slot)))

(define (opt-scc-set-low-min!
  [lowlink : (__tl_dyn-array i64)]
  [slot : i64]
  [candidate : i64]) : unit
  (let
    [old : i64 (array-ref lowlink slot)]
    (if (< candidate old)
      (set! (array-ref lowlink slot) candidate)
      unit)))

(define (opt-scc-next-child-from
  [slots : OptSlotList]
  [after : i64]
  [best : i64]) : i64
  (match slots
    [(OptSlotList.Nil) best]
    [(OptSlotList.Cons slot rest)
      (opt-scc-next-child-from
        (__tl-box-place rest)
        after
        (if (and (> slot after) (or (< best 0) (< slot best)))
          slot
          best))]))

(define (opt-scc-next-child [graph : OptCallGraph] [slot : i64] [after : i64]) : i64
  (if (or (< slot 0) (>= slot graph.count))
    (- 0 1)
    (opt-scc-next-child-from (array-ref graph.edges slot) after (- 0 1))))

(define (opt-scc-discover!
  [slot : i64]
  [indices : (__tl_dyn-array i64)]
  [lowlink : (__tl_dyn-array i64)]
  [on-stack : (__tl_dyn-array bool)]
  [node-stack : (__tl_dyn-array i64)]
  [node-stack-len : i64]
  [next-index : i64]) : OptSccDiscoverState
  (begin
    (set! (array-ref indices slot) next-index)
    (set! (array-ref lowlink slot) next-index)
    (set! (array-ref on-stack slot) true)
    (set! (array-ref node-stack node-stack-len) slot)
    (OptSccDiscoverState.State (+ next-index 1) (+ node-stack-len 1))))

(define (opt-scc-frame-push!
  [frame-slots : (__tl_dyn-array i64)]
  [frame-nexts : (__tl_dyn-array i64)]
  [frame-len : i64]
  [slot : i64]) : i64
  (begin
    (set! (array-ref frame-slots frame-len) slot)
    (set! (array-ref frame-nexts frame-len) (- 0 1))
    (+ frame-len 1)))

(define (opt-scc-pop-component!
  [node-stack : (__tl_dyn-array i64)]
  [node-stack-len : i64]
  [on-stack : (__tl_dyn-array bool)]
  [scc-of : (__tl_dyn-array i64)]
  [root : i64]
  [scc-id : i64]) : OptSccPopState
  (let
    [len : i64 node-stack-len]
    [done : bool false]
    [members : i64 0]
    (begin
      (while (not done)
        (let
          [next-len : i64 (- len 1)]
          [slot : i64 (array-ref node-stack next-len)]
          (begin
            (set! len next-len)
            (set! (array-ref on-stack slot) false)
            (set! (array-ref scc-of slot) scc-id)
            (set! members (+ members 1))
            (if (= slot root)
              (set! done true)
              unit))))
      (OptSccPopState.State len members))))

(define (opt-scc-copy-order [source : (__tl_dyn-array i64)] [count : i64]) : (__tl_dyn-array
    i64)
  (let
    [out : (__tl_dyn-array i64) (array.make-array i64 count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set! (array-ref out index) (array-ref source index))
          (set! index (+ index 1))))
      out)))

(define (opt-scc-compute [graph : OptCallGraph]) : OptSccResult
  (let
    [count : i64 graph.count]
    [indices : (__tl_dyn-array i64) (array.make-array i64 count)]
    [lowlink : (__tl_dyn-array i64) (array.make-array i64 count)]
    [on-stack : (__tl_dyn-array bool) (array.make-array bool count)]
    [scc-of : (__tl_dyn-array i64) (array.make-array i64 count)]
    [node-stack : (__tl_dyn-array i64) (array.make-array i64 count)]
    [frame-slots : (__tl_dyn-array i64) (array.make-array i64 count)]
    [frame-nexts : (__tl_dyn-array i64) (array.make-array i64 count)]
    [order-scratch : (__tl_dyn-array i64) (array.make-array i64 count)]
    [root : i64 0]
    [next-index : i64 0]
    [node-stack-len : i64 0]
    [frame-len : i64 0]
    [scc-count : i64 0]
    (begin
      (opt-cfg-fill-i64! indices count (- 0 1))
      (opt-cfg-fill-i64! lowlink count (- 0 1))
      (opt-cfg-fill-i64! scc-of count (- 0 1))
      (opt-cfg-fill-i64! order-scratch count (- 0 1))
      (while (< root count)
        (begin
          (if (= (array-ref indices root) (- 0 1))
            (begin
              (match (opt-scc-discover!
                root
                indices
                lowlink
                on-stack
                node-stack
                node-stack-len
                next-index)
                [(OptSccDiscoverState.State next stack-len)
                  (begin
                    (set! next-index next)
                    (set! node-stack-len stack-len))])
              (set!
                frame-len
                (opt-scc-frame-push! frame-slots frame-nexts frame-len root))
              (while (> frame-len 0)
                (let
                  [frame-index : i64 (- frame-len 1)]
                  [slot : i64 (array-ref frame-slots frame-index)]
                  [child : i64
                    (opt-scc-next-child
                      graph
                      slot
                      (array-ref frame-nexts frame-index))]
                  (if (>= child 0)
                    (begin
                      (set! (array-ref frame-nexts frame-index) child)
                      (if (= (array-ref indices child) (- 0 1))
                        (begin
                          (match (opt-scc-discover!
                            child
                            indices
                            lowlink
                            on-stack
                            node-stack
                            node-stack-len
                            next-index)
                            [(OptSccDiscoverState.State next stack-len)
                              (begin
                                (set! next-index next)
                                (set! node-stack-len stack-len))])
                          (set!
                            frame-len
                            (opt-scc-frame-push!
                              frame-slots
                              frame-nexts
                              frame-len
                              child)))
                        (if (array-ref on-stack child)
                          (opt-scc-set-low-min!
                            lowlink
                            slot
                            (array-ref indices child))
                          unit)))
                    (begin
                      (if (= (array-ref lowlink slot) (array-ref indices slot))
                        (match (opt-scc-pop-component!
                          node-stack
                          node-stack-len
                          on-stack
                          scc-of
                          slot
                          scc-count)
                          [(OptSccPopState.State stack-len _)
                            (begin
                              (set! node-stack-len stack-len)
                              (set!
                                (array-ref order-scratch scc-count)
                                scc-count)
                              (set! scc-count (+ scc-count 1)))])
                        unit)
                      (set! frame-len (- frame-len 1))
                      (if (> frame-len 0)
                        (let
                          [parent : i64 (array-ref frame-slots (- frame-len 1))]
                          (opt-scc-set-low-min!
                            lowlink
                            parent
                            (array-ref lowlink slot)))
                        unit))))))
            unit)
          (set! root (+ root 1))))
      (OptSccResult scc-of (opt-scc-copy-order order-scratch scc-count)))))

;; Devirtualize syntactically known function values before program-level
;; inlining, so the existing direct-call inliner can see them.
(define (opt-devirt-known-function-instr [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.CallIndirect
        dst
        (ir.CompilerIrValue.Function name)
        args
        ty)
      (ir.CompilerIrInstr.Call dst name args ty)]
    [(ir.CompilerIrInstr.TailCallIndirect
        (ir.CompilerIrValue.Function name)
        args
        ty)
      (ir.CompilerIrInstr.TailCall name args ty)]
    [_ instr]))

;; Optimization receives compact, exclusively owned IR sequences. Rewrite their
;; mutable instruction arrays directly instead of rebuilding the entire program
;; through temporary cons lists before the inliner.
(define (opt-devirt-known-function-block! [block : ir.CompilerIrBlock]) : unit
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (ir.compiler-ir-instr-seq-rewrite! instrs opt-devirt-known-function-instr)]))

(define (opt-devirt-known-function-blocks! [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (opt-devirt-known-function-block! block)
        (opt-devirt-known-function-blocks! (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< index count)
          (begin
            (opt-devirt-known-function-block!
              (ir.compiler-ir-block-seq-ref seq index))
            (set! index (+ index 1)))))]))

(define (opt-devirt-known-function-function! [func : ir.CompilerIrFunction]) : unit
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-devirt-known-function-blocks! blocks)]))

(define (opt-devirt-known-function-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (begin
    (opt-devirt-known-function-function! func)
    func))

(define (opt-devirt-known-function-list [functions : ir.CompilerIrFunctionList]) : ir.CompilerIrFunctionList
  (begin
    (match functions
      [(ir.CompilerIrFunctionList.Nil) unit]
      [(ir.CompilerIrFunctionList.Cons func rest)
        (begin
          (opt-devirt-known-function-function! func)
          (opt-devirt-known-function-list (__tl-box-place rest))
          unit)]
      [(ir.CompilerIrFunctionList.Array seq)
        (let
          [index : i64 0]
          [count : i64 (ir.compiler-ir-function-seq-count seq)]
          (while (< index count)
            (begin
              (opt-devirt-known-function-function!
                (ir.compiler-ir-function-seq-ref seq index))
              (set! index (+ index 1)))))])
    functions))

;; ---------------------------------------------------------------------------
;; Function inlining (opt level 2 only). Splices the body of small single-block
;; leaf callees into their call sites, removing call/return overhead and exposing
;; the callee's instructions to the caller's folding/DCE/GVN and to register
;; allocation. Reserved for opt2 (the quality build) so the cheap opt1
;; self-compile path pays nothing for it.
;;
;; Determinism: fresh var ids are minted from the caller function's `vars`
;; counter (the same per-function sequential scheme lowering uses), callee bodies
;; are walked in list order, and callees are resolved through the deterministic
;; OptFunctionIndex. Param var ids (0..nparams-1) are substituted with the call's
;; argument values; other callee var ids are compacted by subtracting the dead
;; read-only param slots before shifting by the caller's var count.
;; ---------------------------------------------------------------------------
(defenum OptInlineState
  (State ir.CompilerIrInstrList i64 i64))

(defenum OptInlinePredRename
  (Rename i64 i64))

(defenum OptInlinePredRenameList
  (Nil)
  (Dense (__tl_dyn-array OptInlinePredRename) i64))

(define (opt-inline-pred-rename-ref
  [renames : OptInlinePredRenameList]
  [index : i64]) : OptInlinePredRename
  (match renames
    [(OptInlinePredRenameList.Nil) (OptInlinePredRename.Rename -1 -1)]
    [(OptInlinePredRenameList.Dense items len)
      (array-ref items (- (- len 1) index))]))

(define (opt-inline-pred-renames-tail [renames : OptInlinePredRenameList]) : OptInlinePredRenameList
  (match renames
    [(OptInlinePredRenameList.Nil) (OptInlinePredRenameList.Nil)]
    [(OptInlinePredRenameList.Dense items len)
      (if (<= len 1)
        (OptInlinePredRenameList.Nil)
        (OptInlinePredRenameList.Dense items (- len 1)))]))

(define (opt-inline-pred-renames-cons
  [old-label : i64]
  [new-label : i64]
  [renames : OptInlinePredRenameList]) : OptInlinePredRenameList
  (let
    [rename : OptInlinePredRename
      (OptInlinePredRename.Rename old-label new-label)]
    (match renames
      [(OptInlinePredRenameList.Nil)
        (let
          [items : (__tl_dyn-array OptInlinePredRename)
            (array.make-array OptInlinePredRename 4)]
          (begin
            (set! (array-ref items 0) rename)
            (OptInlinePredRenameList.Dense items 1)))]
      [(OptInlinePredRenameList.Dense items len)
        (if (< len (array-length items))
          (begin
            (set! (array-ref items len) rename)
            (OptInlinePredRenameList.Dense items (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptInlinePredRename)
              (array.make-array
                OptInlinePredRename
                (opt-dense-next-capacity len))]
            [index : i64 0]
            (begin
              (while (< index len)
                (begin
                  (set! (array-ref bigger index) (array-ref items index))
                  (set! index (+ index 1))))
              (set! (array-ref bigger len) rename)
              (OptInlinePredRenameList.Dense bigger (+ len 1)))))])))

(defenum OptInlineBlocks
  (Blocks ir.CompilerIrBlockList i64 i64))

(defenum OptInlineSpanState
  (State ir.CompilerIrInstrList i64 i64 ir.CompilerSourceSpans))

(defenum OptInlineSpanBlocks
  (Blocks ir.CompilerIrBlockList i64 i64 ir.CompilerSourceSpans))

(defenum OptInlineSpanProgram
  (Program ir.CompilerIrFunctionList ir.CompilerSourceSpans))

(defenum OptInlineMultiClone
  (Clone ir.CompilerIrBlockList ir.CompilerIrPhiInputList))

(defenum OptInlineMultiInstrClone
  (Clone ir.CompilerIrInstrList ir.CompilerIrPhiInputList))

(defenum OptInlineMultiSpanClone
  (Clone
    ir.CompilerIrBlockList
    ir.CompilerIrPhiInputList
    ir.CompilerSourceSpans))

(defenum OptInlineMultiSpanInstrClone
  (Clone
    ir.CompilerIrInstrList
    ir.CompilerIrPhiInputList
    ir.CompilerSourceSpans))

(defenum OptInlineMaybeBlockRewrite
  (NoBlockRewrite)
  (SomeBlockRewrite ir.CompilerIrBlockList i64 i64))

(defenum OptInlineMaybeSpanBlockRewrite
  (NoSpanBlockRewrite)
  (SomeSpanBlockRewrite ir.CompilerIrBlockList i64 i64 ir.CompilerSourceSpans))

(defenum OptInlineBoundsLabelScan
  (Duplicate)
  (Ok opt_string_i64_map.Map))

;; Shape pre-filter for the generic single-block path. It is evaluated on the
;; callee as it stands at decision time, before GVN and copy propagation clean
;; the body up, and naive lowering inflates a canonical arithmetic leaf by
;; roughly half: lex_source's four-parameter `ls-fold` settles at 6
;; instructions but presents as 9 here. A cap picked against final sizes
;; therefore refuses exactly the shapes it was meant to admit.
;;
;; The growth bound is opt-inline-cost-inline-with-block-weight?, not this cap.
;; The single-block path passes added-blocks 0, so raw = callee-instrs and
;; net = callee-instrs - min(callee-instrs, 3 * const-args) - 6, admitted at
;; net <= 4. With no constant arguments that prices bodies up to 10, so the old
;; cap of 8 was strictly tighter than the priced bound and refused bodies 9 and
;; 10 the cost model had already accepted -- at every call site, since the cap
;; is a property of the callee.
;;
;; Past 10 the cost formula stops bounding size at all. const-savings saturates
;; at raw, so a site whose constant arguments cover the body collapses net to
;; -6 regardless of how large the body is, and an absorbable single-site callee
;; subtracts 1000 outright. This cap is the only backstop for those two
;; branches. 12 keeps it one step past the priced ceiling from both directions:
;; 12 >= 10 leaves the zero-const-arg decision to the cost model, and 12 = 10+2
;; caps the unpriced overshoot at two instructions, which is also where a
;; canonical 8-instruction leaf lands under the same ~1.5x lowering inflation.
;; Bodies of 13 and up stay refused here even when the cost gate would take
;; them on constant arguments.
(define (opt-inline-max-body) : i64
  12)

(define (opt-inline-bounds-leaf-max-body) : i64
  48)

(define (opt-inline-cost-block-weight) : i64
  6)

(define (opt-inline-cost-call-bonus) : i64
  6)

(define (opt-inline-cost-const-arg-bonus) : i64
  3)

(define (opt-inline-cost-threshold) : i64
  4)

(define (opt-inline-cost-absorb-bonus) : i64
  1000)

(define (opt-inline-cost-block-fuel) : i64
  32)

(define (opt-inline-tiny-predicate-max-blocks) : i64
  4)

(define (opt-inline-tiny-predicate-max-instrs) : i64
  6)

(define (opt-inline-param-count [params : ir.CompilerIrParamList]) : i64
  (match params
    [(ir.CompilerIrParamList.Nil) 0]
    [(ir.CompilerIrParamList.Array seq) (ir.compiler-ir-param-seq-count seq)]
    [(ir.CompilerIrParamList.Cons _ rest)
      (+ 1 (opt-inline-param-count (__tl-box-place rest)))]))

(define (opt-inline-param-seq-sequential-from?
  [params : ir.CompilerIrParamSeq]
  [index : i64]
  [expected : i64]) : bool
  (if (>= index (ir.compiler-ir-param-seq-count params))
    true
    (match (ir.compiler-ir-param-seq-ref params index)
      [(ir.CompilerIrParam.Param _ _ vid)
        (and
          (= vid expected)
          (opt-inline-param-seq-sequential-from?
            params
            (+ index 1)
            (+ expected 1)))])))

(define (opt-inline-params-sequential?
  [params : ir.CompilerIrParamList]
  [i : i64]) : bool
  (match params
    [(ir.CompilerIrParamList.Nil) true]
    [(ir.CompilerIrParamList.Array seq)
      (opt-inline-param-seq-sequential-from? seq 0 i)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ vid)
          (if (= vid i)
            (opt-inline-params-sequential? (__tl-box-place rest) (+ i 1))
            false)])]))

(define (opt-inline-body-instr-op-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Pack _ _ _) true]
    [(ir.CompilerIrInstr.Word _ _ _ _) true]
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (opt-inline-body-instr-ok? [instr : ir.CompilerIrInstr] [np : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Gep dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Load dst _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Cast dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Pack dst _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Word dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.Call dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _) (>= dst np)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (opt-inline-body-instr-seq-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [np : i64]) : bool
  (opt-inline-body-instr-ok? (ir.compiler-ir-instr-seq-ref instrs index) np))

(define (opt-inline-instr-seq-ok-from?
  [instrs : ir.CompilerIrInstrSeq]
  [np : i64]
  [index : i64]
  [last : i64]) : bool
  (cond
    [(> index last) false]
    [(= index last) (ir.compiler-ir-instr-seq-return? instrs index)]
    [(opt-inline-body-instr-seq-ok? instrs index np)
      (opt-inline-instr-seq-ok-from? instrs np (+ index 1) last)]
    [else false]))

(define (opt-inline-instr-seq-ok? [instrs : ir.CompilerIrInstrSeq] [np : i64]) : bool
  (opt-inline-instr-seq-ok-from?
    instrs
    np
    0
    (- (ir.compiler-ir-instr-seq-count instrs) 1)))

(define (opt-inline-single-block-seq-ok?
  [seq : ir.CompilerIrInstrSeq]
  [np : i64]) : bool
  (let
    [n : i64 (ir.compiler-ir-instr-seq-count seq)]
    (if (< n 1)
      false
      (if (> (- n 1) (opt-inline-max-body))
        false
        (opt-inline-instr-seq-ok? seq np)))))

(define (opt-inline-single-block-ok?
  [blocks : ir.CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (__tl-box-place rest)
        [(ir.CompilerIrBlockList.Nil)
          (match block
            [(ir.CompilerIrBlock.Block _ seq)
              (opt-inline-single-block-seq-ok? seq np)])]
        [_ false])]
    [(ir.CompilerIrBlockList.Array seq)
      (if (= (ir.compiler-ir-block-seq-count seq) 1)
        (match (ir.compiler-ir-block-seq-ref seq 0)
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-inline-single-block-seq-ok? instrs np)])
        false)]
    [_ false]))

(define (opt-inline-single-block-cost-instrs [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Cons block _)
      (match block
        [(ir.CompilerIrBlock.Block _ seq)
          (- (ir.compiler-ir-instr-seq-count seq) 1)])]
    [(ir.CompilerIrBlockList.Array seq)
      (if (= (ir.compiler-ir-block-seq-count seq) 1)
        (match (ir.compiler-ir-block-seq-ref seq 0)
          [(ir.CompilerIrBlock.Block _ instrs)
            (- (ir.compiler-ir-instr-seq-count instrs) 1)])
        0)]
    [_ 0]))

(define (opt-inline-bounds-leaf-instr-ok?
  [instr : ir.CompilerIrInstr]
  [np : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ _ _ _) false]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) false]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) false]
    [_ (opt-inline-body-instr-ok? instr np)]))

(define (opt-inline-bounds-leaf-instr-seq-ok-from?
  [instrs : ir.CompilerIrInstrSeq]
  [np : i64]
  [index : i64]
  [last : i64]
  [has-bounds : bool]) : bool
  (if (> index last)
    false
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (= index last)
        (and has-bounds (ir.compiler-ir-instr-return? instr))
        (if (opt-inline-bounds-leaf-instr-ok? instr np)
          (opt-inline-bounds-leaf-instr-seq-ok-from?
            instrs
            np
            (+ index 1)
            last
            (or has-bounds (ir.compiler-ir-instr-bounds-check? instr)))
          false)))))

;; The admitted body band is 1..opt-inline-bounds-leaf-max-body. The band used
;; to start above opt-inline-max-body, which inverted the cost argument: a
;; 9..48 instruction bounds leaf inlined while a smaller one fell through to
;; the generic single-block path, where opt-inline-bounds-inline-ok? refuses
;; every has-bounds callee that is neither absorbable nor called with
;; all-constant arguments. The smallest bounds leaves have the highest
;; call-overhead ratio, so they were exactly the wrong class to refuse.
;;
;; Duplicating a bounds check is a static cost, not a dynamic one: the check
;; runs once per call whether it sits in the callee or in the expanded copy, so
;; the executed check count is unchanged. What disappears is the call boundary
;; itself -- the argument moves, call, and return, roughly 4-6 executed
;; instructions per call. Static growth stays bounded by the same
;; opt-inline-bounds-leaf-cost-inline? admission the 9..48 band uses
;; (callee-instrs cap, heavy gate, block fuel).
(define (opt-inline-bounds-leaf-seq-ok?
  [seq : ir.CompilerIrInstrSeq]
  [np : i64]) : bool
  (let
    [n : i64 (ir.compiler-ir-instr-seq-count seq)]
    [body : i64 (- n 1)]
    (and
      (>= n 1)
      (>= body 1)
      (<= body (opt-inline-bounds-leaf-max-body))
      (opt-inline-bounds-leaf-instr-seq-ok-from? seq np 0 (- n 1) false))))

;; Return-to-mov cloning rewrites the callee return into a Mov of the returned
;; value into the call's destination. That reproduces the call boundary exactly
;; for the non-owning scalars -- integers, Bool, Char, and Unit. Each is a
;; single-register value the Mov carries under its own declared type, and none
;; of them owns storage, so retiring the boundary retires nothing else with it.
;; Owned String and aggregate results stay out of this path; their call boundary
;; carries cleanup semantics that the bounds-leaf expansion does not reproduce.
(define (opt-inline-bounds-leaf-return-type? [ty : ast.AstType]) : bool
  (if (opt-integer-type? ty)
    true
    (match ty
      [(ast.AstType.Unit) true]
      [(ast.AstType.Bool) true]
      [(ast.AstType.Char) true]
      [_ false])))

(define (opt-inline-bounds-leaf-ok?
  [blocks : ir.CompilerIrBlockList]
  [np : i64]
  [ret : ast.AstType]) : bool
  (and
    (opt-inline-bounds-leaf-return-type? ret)
    (match blocks
      [(ir.CompilerIrBlockList.Cons block rest)
        (match (__tl-box-place rest)
          [(ir.CompilerIrBlockList.Nil)
            (match block
              [(ir.CompilerIrBlock.Block _ seq)
                (opt-inline-bounds-leaf-seq-ok? seq np)])]
          [_ false])]
      [(ir.CompilerIrBlockList.Array seq)
        (if (= (ir.compiler-ir-block-seq-count seq) 1)
          (match (ir.compiler-ir-block-seq-ref seq 0)
            [(ir.CompilerIrBlock.Block _ instrs)
              (opt-inline-bounds-leaf-seq-ok? instrs np)])
          false)]
      [_ false])))

(define (opt-inline-phi-input-label?
  [inputs : ir.CompilerIrPhiInputList]
  [label : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-inline-phi-input-label?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        label)]
    [(ir.CompilerIrPhiInputList.Cons _ input-label rest)
      (if (= input-label label)
        true
        (opt-inline-phi-input-label? (__tl-box-place rest) label))]))

(define (opt-inline-instr-seq-phi-label-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [label : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (if (opt-inline-phi-input-label? inputs label)
          true
          (opt-inline-instr-seq-phi-label-from? instrs (+ index 1) label))]
      ;; Inliner input is SSA, where phis form the instruction prefix.
      [_ false])))

(define (opt-inline-phi-input-labels-add
  [inputs : ir.CompilerIrPhiInputList]
  [labels : OptLabelSet]) : OptLabelSet
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) labels]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-inline-phi-input-labels-add
        (ir.compiler-ir-phi-input-seq-to-list seq)
        labels)]
    [(ir.CompilerIrPhiInputList.Cons _ label rest)
      (opt-inline-phi-input-labels-add
        (__tl-box-place rest)
        (opt-label-add labels label))]))

(define (opt-inline-instr-seq-phi-labels-add-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    labels
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (opt-inline-instr-seq-phi-labels-add-from
          instrs
          (+ index 1)
          (opt-inline-phi-input-labels-add inputs labels))]
      ;; Inliner input is SSA, where phis form the instruction prefix.
      [_ labels])))

(define (opt-inline-blocks-phi-predecessors-add
  [blocks : ir.CompilerIrBlockList]
  [labels : OptLabelSet]) : OptLabelSet
  (match blocks
    [(ir.CompilerIrBlockList.Nil) labels]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-inline-blocks-phi-predecessors-add
            (__tl-box-place rest)
            (opt-inline-instr-seq-phi-labels-add-from instrs 0 labels))])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [acc : OptLabelSet labels]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    acc
                    (opt-inline-instr-seq-phi-labels-add-from instrs 0 acc))])
              (set! i (+ i 1))))
          acc))]))

;; A successful multiblock inline moves the original block's tail to the
;; generated continuation. A matching phi input is itself the old predecessor
;; edge, so rewrite only blocks that carry one and leave every other block and
;; every non-matching phi input byte-for-byte equivalent.
(define (opt-inline-repair-successor-phis
  [blocks : ir.CompilerIrBlockList]
  [old-label : i64]
  [new-label : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (opt-inline-instr-seq-phi-label-from? instrs 0 old-label)
              (ir.compiler-ir-block
                label
                (opt-relabel-phi-instrs instrs 0 old-label new-label))
              block)
            (opt-inline-repair-successor-phis
              (__tl-box-place rest)
              old-label
              new-label))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-repair-successor-phis
        (ir.compiler-ir-block-seq-to-list seq)
        old-label
        new-label)]))

(define (opt-inline-repair-phi-predecessors
  [blocks : ir.CompilerIrBlockList]
  [renames : OptInlinePredRenameList]) : ir.CompilerIrBlockList
  (match renames
    [(OptInlinePredRenameList.Nil) blocks]
    [(OptInlinePredRenameList.Dense _ _)
      (match (opt-inline-pred-rename-ref renames 0)
        [(OptInlinePredRename.Rename old-label new-label)
          (opt-inline-repair-phi-predecessors
            (opt-inline-repair-successor-phis blocks old-label new-label)
            (opt-inline-pred-renames-tail renames))])]))

(define (opt-inline-multiblock-instr-ok?
  [instr : ir.CompilerIrInstr]
  [_np : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Switch _ _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
    [(ir.CompilerIrInstr.Return _) true]
    ;; A DIRECT tail call is an EXIT of the callee body, not a terminator the
    ;; merged caller inherits. Leaving it as a tail call would return past the
    ;; caller's own continuation, so the clone does not leave it as one: it
    ;; converts the instruction into an ordinary `Call` writing a caller-frame
    ;; slot, followed by the same `Jump cont` plus phi input that every `Return`
    ;; already produces (opt-inline-clone-multiblock-instr-seq-from). Nothing
    ;; downstream ever sees a tail call inside a merged caller, and the exit is
    ;; wired by the mechanism the multiblock path already owns.
    ;;
    ;; What refusing it cost: this clause alone, not any pricing band, held
    ;; whole bodies out of their single call site whenever ONE arm ended in
    ;; `(helper ...)`. lex_source's `ls-negative-number-start?`,
    ;; `ls-colon-token-end` and `ls-number-float?` are each absorbable by every
    ;; other measure and were refused here.
    ;;
    ;; `TailCallIndirect` stays refused. Its target is a computed value, so the
    ;; converted form would be a `CallIndirect` -- expressible, but not a shape
    ;; any measurement on this tree asks for, and the census cannot see through
    ;; a computed target to price the site. The admission stops at the direct
    ;; form the measurement covers.
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.Phi dst _ _) (>= dst 0)]
    ;; Bounds checks are inlinable: the instruction remapper freshens the
    ;; ok-label with the site prefix (the same machinery the single-block
    ;; bounds path uses), and the multiblock rewrite gates bounds-carrying
    ;; callees behind opt-inline-bounds-inline-ok? exactly like the
    ;; single-block path. This is what lets small loop-bearing helpers such
    ;; as a string-scan or hashmap probe inline into their hot single call
    ;; site instead of paying a call per iteration.
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [_ (opt-inline-body-instr-op-ok? instr)]))

(define (opt-inline-instr-seq-has-bounds-check-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (ir.compiler-ir-instr-seq-bounds-check? instrs index)
      true
      (opt-inline-instr-seq-has-bounds-check-from? instrs (+ index 1)))))

(define (opt-inline-instr-seq-has-bounds-check?
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (opt-inline-instr-seq-has-bounds-check-from? instrs 0))

(define (opt-inline-blocks-have-bounds-check? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-inline-instr-seq-has-bounds-check? instrs)
            true
            (opt-inline-blocks-have-bounds-check? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-blocks-have-bounds-check?
        (ir.compiler-ir-block-seq-to-list seq))]))

;; A body with no call of any kind. Used by the STATIC admission bands below,
;; and by none of them for a correctness reason: it is a PRICING clause.
;;
;; The clone path itself handles calls. opt-inline-clone-instr rebases a Call's
;; destination and remaps its arguments through the same staging the rest of the
;; body uses, opt-remap-spans-instr-key re-keys a cloned call's span under the
;; caller, and the multiblock structural gate (opt-inline-body-instr-op-ok?)
;; admits Call, CallIndirect and CallIndirectC on purpose -- so the ordinary
;; cost model already clones call-carrying multiblock bodies in production, and
;; compiler-optimize-inline-multiblock-nonleaf-ok? has pinned exactly that shape
;; for as long as the gate has existed. The historical claim that this path
;; "miscompiles call-carrying clones (#6307)" does not survive re-triage: #6307
;; was closed against the INLINER and re-attributed to a Linux opt2 scalar
;; register allocation pressure bug (#6288), its trigger was bounds-loop
;; widening rather than calls, and relaxing this clause in every band at once
;; still bootstraps to a stage2.s == stage3.s fixpoint and passes the whole
;; inline suite.
;;
;; What the clause actually buys a static band is the cost it CANNOT see. These
;; bands price a callee by its instruction and block counts; a callee's own
;; calls carry costs those counts do not carry -- a caller that was a leaf stops
;; being one, every value the caller holds across the imported call now has to
;; survive a caller-saved clobber, and a duplicated body brings a whole second
;; call sequence to each site it lands at. Measured on this tree: dropping the
;; clause from every band at once moves gvn_table only -0.197% and takes
;; borrowed_disjoint_store from 1,300,000,258 to 2,050,000,218, +57.69%. So the
;; bands keep it, and a body they duplicate stays a leaf by construction.
;;
;; The measured-plan tier (opt-inline-checked-ok?) does not carry this clause,
;; because it does not have to guess: it re-plans the merged caller through a
;; real allocation and reverts whatever does not repay.
(define (opt-inline-instr-call? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.SpmdCall _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(ir.CompilerIrInstr.Syscall _ _) true]
    [_ false]))

(define (opt-inline-instr-seq-call-free-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (if (opt-inline-instr-call? (ir.compiler-ir-instr-seq-ref instrs index))
      false
      (opt-inline-instr-seq-call-free-from? instrs (+ index 1)))))

(define (opt-inline-blocks-call-free? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-inline-instr-seq-call-free-from? instrs 0)
            (opt-inline-blocks-call-free? (__tl-box-place rest))
            false)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-blocks-call-free? (ir.compiler-ir-block-seq-to-list seq))]))

;; Does this body carry a direct tail call the multiblock clone will have to
;; convert into a call plus continuation wiring?
;;
;; The conversion needs one caller-frame slot to hold the converted call's
;; result, and the clone allocates those slots positionally (one per cloned
;; block, since a tail call is a terminator and a block holds at most one).
;; Asking this question first is what keeps a tail-call-free callee's frame
;; growth byte-for-byte what it was before the admission existed: no tail call,
;; no reserved slots, no change to `vars2` at any site.
(define (opt-inline-instr-tail-call? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [_ false]))

(define (opt-inline-instr-seq-has-tail-call-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-inline-instr-tail-call?
      (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-inline-instr-seq-has-tail-call-from? instrs (+ index 1)))))

(define (opt-inline-blocks-have-tail-call? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-inline-instr-seq-has-tail-call-from? instrs 0)
            true
            (opt-inline-blocks-have-tail-call? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-blocks-have-tail-call? (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-multiblock-instrs-ok-from?
  [instrs : ir.CompilerIrInstrSeq]
  [np : i64]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (if (opt-inline-multiblock-instr-ok?
      (ir.compiler-ir-instr-seq-ref instrs index)
      np)
      (opt-inline-multiblock-instrs-ok-from? instrs np (+ index 1))
      false)))

(define (opt-inline-multiblock-instrs-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [np : i64]) : bool
  (opt-inline-multiblock-instrs-ok-from? instrs np 0))

(define (opt-inline-multiblock-blocks-ok?
  [blocks : ir.CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-inline-multiblock-instrs-ok? instrs np)
            (opt-inline-multiblock-blocks-ok? (__tl-box-place rest) np))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-multiblock-blocks-ok?
        (ir.compiler-ir-block-seq-to-list seq)
        np)]))

(define (opt-inline-param-mutating-instr?
  [instr : ir.CompilerIrInstr]
  [np : i64]) : bool
  (match (opt-instr-def-var instr)
    [(option_i64.Some var) (< var np)]
    [(option_i64.None) false]))

(define (opt-inline-param-mutating-instrs-from?
  [instrs : ir.CompilerIrInstrSeq]
  [np : i64]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-inline-param-mutating-instr?
      (ir.compiler-ir-instr-seq-ref instrs index)
      np)
      true
      (opt-inline-param-mutating-instrs-from? instrs np (+ index 1)))))

(define (opt-inline-param-mutating-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [np : i64]) : bool
  (opt-inline-param-mutating-instrs-from? instrs np 0))

(define (opt-inline-param-mutating-blocks?
  [blocks : ir.CompilerIrBlockList]
  [np : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-inline-param-mutating-instrs? instrs np)
            true
            (opt-inline-param-mutating-blocks? (__tl-box-place rest) np))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-param-mutating-blocks?
        (ir.compiler-ir-block-seq-to-list seq)
        np)]))

(define (opt-inline-return-count-instrs-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    count
    (opt-inline-return-count-instrs-from
      instrs
      (+ index 1)
      (if (ir.compiler-ir-instr-seq-return? instrs index)
        (+ count 1)
        count))))

(define (opt-inline-return-count-instrs [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-inline-return-count-instrs-from instrs 0 0))

(define (opt-inline-return-count-blocks [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (+
            (opt-inline-return-count-instrs instrs)
            (opt-inline-return-count-blocks (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-return-count-blocks (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-cost-instrs-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    count
    (opt-inline-cost-instrs-from
      instrs
      (+ index 1)
      (if (ir.compiler-ir-instr-seq-return? instrs index)
        count
        (+ count 1)))))

(define (opt-inline-cost-instrs [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-inline-cost-instrs-from instrs 0 0))

(define (opt-inline-multiblock-cost-instrs [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (+
            (opt-inline-cost-instrs instrs)
            (opt-inline-multiblock-cost-instrs (__tl-box-place rest)))])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [total : i64 0]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! total (+ total (opt-inline-cost-instrs instrs)))])
              (set! i (+ i 1))))
          total))]))

;; Backend call emission copies pointer-shaped private MEMORY parameters into
;; callee-owned stack storage.  Inlining substitutes the caller argument and
;; would therefore alias the caller's storage, so keep this ABI boundary.
(define (opt-inline-private-memory-name? [name : String]) : bool
  (let
    [prefix : String "__tl_internal_abi_mem_s"]
    [prefix-len : i64 (string.string-length prefix)]
    [n : i64 (string.string-length name)]
    [i : i64 prefix-len]
    [digits : i64 0]
    [delimiter? : bool false]
    [valid : bool
      (and
        (>= n prefix-len)
        (string.eq (string.substring name 0 prefix-len) prefix))]
    (begin
      (while (and valid (< i n))
        (let
          [digit : i64 (cast (string.string-ref name i) : i64)]
          (if (and (>= digit 48) (<= digit 57))
            (begin
              (set! digits (+ digits 1))
              (set! i (+ i 1)))
            (if (and
              (= (cast (string.string-ref name i) : i64) 95)
              (< (+ i 1) n)
              (= (cast (string.string-ref name (+ i 1)) : i64) 95))
              (begin
                (set! delimiter? true)
                (set! i n))
              (set! valid false)))))
      (and valid (> digits 0) delimiter?))))

(define (opt-inline-private-memory-transport-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Struct name)
      (and
        (ir.compiler-ir-symbol-owned? name)
        (opt-inline-private-memory-name? (ir.compiler-ir-symbol-text name)))]
    [(ast.AstType.StructArgs name _)
      (and
        (ir.compiler-ir-symbol-owned? name)
        (opt-inline-private-memory-name? (ir.compiler-ir-symbol-text name)))]
    [_ false]))

(define (opt-inline-params-have-private-memory?
  [params : ir.CompilerIrParamList]) : bool
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) false]
    [(ir.CompilerIrParamList.Array seq)
      (opt-inline-params-have-private-memory?
        (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ ty _)
          (or
            (opt-inline-private-memory-transport-type? ty)
            (opt-inline-params-have-private-memory? (__tl-box-place rest)))])]))

(define (opt-inline-params-have-sret? [params : ir.CompilerIrParamList]) : bool
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) false]
    [(ir.CompilerIrParamList.Array seq)
      (opt-inline-params-have-sret? (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name _ _)
          (or
            (string.eq name "__sret")
            (opt-inline-params-have-sret? (__tl-box-place rest)))])]))

(define (opt-inline-multiblock-return-type-ok?
  [params : ir.CompilerIrParamList]
  [ret : ast.AstType]) : bool
  (or
    (opt-inline-params-have-sret? params)
    (opt-ssa-scalar-type? ret)
    (match ret
      [(ast.AstType.Unit) true]
      [_ false])))

(define (opt-inline-multiblock-callee-body-ok?
  [cparams : ir.CompilerIrParamList]
  [ret : ast.AstType]
  [cvars : i64]
  [cblocks : ir.CompilerIrBlockList]) : bool
  (let
    [np : i64 (opt-inline-param-count cparams)]
    (and
      (not (opt-inline-params-have-private-memory? cparams))
      (opt-inline-multiblock-return-type-ok? cparams ret)
      (opt-inline-params-sequential? cparams 0)
      (>= cvars np)
      (> (ir.compiler-ir-block-list-count cblocks) 1)
      (> (opt-inline-return-count-blocks cblocks) 0)
      (opt-inline-structure-ok-reclaiming? cblocks)
      (opt-inline-multiblock-blocks-ok? cblocks np))))

;; Per-callee memo for the multiblock admission verdict, keyed by dense index
;; slot. SCC processing is bottom-up (Tarjan pops a callee's component before
;; any caller's), and same-SCC calls are rejected before this lookup runs, so
;; whenever a caller examines a callee here the callee's body is final for the
;; rest of the pass and the cached verdict cannot go stale. A -1 slot means
;; "not yet computed". The verdict cached here is caller-independent; the
;; self-call check stays outside in opt-inline-multiblock-callee-ok-cached?.
(define opt-inline-multiblock-ok-memo : (__tl_dyn-array i64)
  (array.make-array i64 0))

(define (opt-inline-multiblock-ok-memo-install! [index : OptFunctionIndex]) : unit
  (let
    [count : i64 (opt-function-index-count index)]
    [memo : (__tl_dyn-array i64) (array.make-array i64 count)]
    (begin
      (opt-cfg-fill-i64! memo count (- 0 1))
      (set! opt-inline-multiblock-ok-memo memo))))

(define (opt-inline-multiblock-ok-memo-reset!) : unit
  (set! opt-inline-multiblock-ok-memo (array.make-array i64 0)))

(define (opt-inline-multiblock-callee-ok-cached?
  [callee-slot : i64]
  [callee : ir.CompilerIrFunction]
  [caller-name : i64]) : bool
  (match callee
    [(ir.CompilerIrFunction.Function cname cparams ret cvars cblocks)
      (if (ir.compiler-ir-symbol-eq? cname caller-name)
        false
        (if (or
          (< callee-slot 0)
          (>= callee-slot (array-length opt-inline-multiblock-ok-memo)))
          (opt-inline-multiblock-callee-body-ok? cparams ret cvars cblocks)
          (let
            [cached : i64 (array-ref opt-inline-multiblock-ok-memo callee-slot)]
            (if (>= cached 0)
              (= cached 1)
              (let
                [ok : bool
                  (opt-inline-multiblock-callee-body-ok?
                    cparams
                    ret
                    cvars
                    cblocks)]
                (begin
                  (set!
                    (array-ref opt-inline-multiblock-ok-memo callee-slot)
                    (if ok
                      1
                      0))
                  ok))))))]))

;; Admitted inline sites in the caller currently being rewritten, bumped once
;; per single-block expansion and per multiblock rewrite. When it is still zero
;; after the walk, the caller's IR and spans are exactly the input ones, so the
;; structural re-verify and SSA reconstruction have nothing new to check.
(define opt-inline-caller-site-count : i64
  0)

;; Blocks imported into the current caller by the hot-loop-leaf gate alone.
;; Kept out of `added-so-far` on purpose: a hot-loop-leaf copy must not spend
;; the caller's shared block fuel, because that fuel is what the caller's own
;; banked absorptions draw on -- spending it evicted pl-globl-line?'s
;; single-reference absorption out of pl-run-chunk when pl-line-end's copy
;; landed first, +8.4% on peephole_lines. The gate has its own fuel below, and
;; opt-inline-function adds this back when it decides whether SSA
;; reconstruction has anything new to rebuild.
(define opt-inline-caller-hot-loop-blocks : i64
  0)

;; Blocks imported into the current caller by the dominant-reference tier of
;; the shared-accessor gate alone, on the same terms and for the same reason.
;; The tier below the dominant floor keeps spending the shared fuel exactly as
;; it always did.
(define opt-inline-caller-accessor-blocks : i64
  0)

;; Blocks imported into the current caller by the branch-chain gate alone, kept
;; out of `added-so-far` for exactly the reason above: a chain copy must not
;; spend the fuel the caller's banked absorptions draw on. The chain gate has
;; its own fuel (opt-inline-branch-chain-block-fuel), and it needs a separate
;; accumulator from the hot-loop one because the two admit disjoint shapes --
;; acyclic bounds-free chains here, cyclic leaves there -- and neither should
;; be able to exhaust the other's budget.
(define opt-inline-caller-chain-blocks : i64
  0)
(define opt-inline-pred-renames : (__tl_dyn-array OptInlinePredRenameList)
  (make-array (OptInlinePredRenameList.Nil)))

(define (opt-inline-pred-renames-shared-view) : OptInlinePredRenameList
  (unsafe
    (ptr-read
      (ptr-cast
        (array-data opt-inline-pred-renames)
        : (Ptr OptInlinePredRenameList)))))

(define opt-inline-current-phi-predecessor? : bool
  false)

(define (opt-inline-callee-ok?
  [callee : ir.CompilerIrFunction]
  [caller-name : i64]) : bool
  (match callee
    [(ir.CompilerIrFunction.Function cname cparams cret cvars cblocks)
      (if (ir.compiler-ir-symbol-eq? cname caller-name)
        false
        (let
          [np : i64 (opt-inline-param-count cparams)]
          (if (and
            (not (opt-inline-params-have-private-memory? cparams))
            (opt-inline-params-sequential? cparams 0))
            (if (>= cvars np)
              (or
                (opt-inline-single-block-ok? cblocks np)
                (opt-inline-bounds-leaf-ok? cblocks np cret))
              false)
            false)))]))

(define (opt-inline-arity-ok? [args : ir.CompilerIrCallArgs] [np : i64]) : bool
  (match args
    [(ir.CompilerIrCallArgs.Nil) (= np 0)]
    [(ir.CompilerIrCallArgs.One _) (= np 1)]
    [(ir.CompilerIrCallArgs.Two _ _) (= np 2)]
    [(ir.CompilerIrCallArgs.Array arr) (= np (array-length arr))]))

(define (opt-inline-value-constant? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var _) false]
    [_ true]))

(define (opt-inline-args-array-const-count
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (array-length values))
    count
    (opt-inline-args-array-const-count
      values
      (+ index 1)
      (if (opt-inline-value-constant? (array-ref values index))
        (+ count 1)
        count))))

(define (opt-inline-args-const-count [args : ir.CompilerIrCallArgs]) : i64
  (match args
    [(ir.CompilerIrCallArgs.Nil) 0]
    [(ir.CompilerIrCallArgs.One value)
      (if (opt-inline-value-constant? value)
        1
        0)]
    [(ir.CompilerIrCallArgs.Two a b)
      (+
        (if (opt-inline-value-constant? a)
          1
          0)
        (if (opt-inline-value-constant? b)
          1
          0))]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-inline-args-array-const-count values 0 0)]))

(define (opt-inline-cost-min [a : i64] [b : i64]) : i64
  (if (< a b)
    a
    b))

(define (opt-inline-cost-crosses-heavy-gate?
  [caller-blocks : i64]
  [added-so-far : i64]
  [added-blocks : i64]) : bool
  (and
    (<= caller-blocks (opt-inline-heavy-gate-block-limit))
    (>
      (+ caller-blocks (+ added-so-far added-blocks))
      (opt-inline-heavy-gate-block-limit))))

(define (opt-inline-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [absorbable : bool]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (opt-inline-cost-inline-with-block-weight?
    callee-instrs
    added-blocks
    const-args
    absorbable
    caller-blocks
    added-so-far
    (opt-inline-cost-block-weight)))

(define (opt-inline-cost-inline-with-block-weight?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [absorbable : bool]
  [caller-blocks : i64]
  [added-so-far : i64]
  [block-weight : i64]) : bool
  (if (opt-inline-cost-crosses-heavy-gate?
    caller-blocks
    added-so-far
    added-blocks)
    false
    (if (> (+ added-so-far added-blocks) (opt-inline-cost-block-fuel))
      false
      (let
        [raw : i64 (+ callee-instrs (* block-weight added-blocks))]
        [const-savings : i64
          (opt-inline-cost-min
            raw
            (* (opt-inline-cost-const-arg-bonus) const-args))]
        [net : i64
          (-
            (- (- raw const-savings) (opt-inline-cost-call-bonus))
            (if absorbable
              (opt-inline-cost-absorb-bonus)
              0))]
        (<= net (opt-inline-cost-threshold))))))

(define (opt-inline-bool-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Bool) true]
    [_ false]))

(define (opt-inline-tiny-predicate-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Word _ _ _ _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Return _) true]
    [(ir.CompilerIrInstr.Phi dst _ _) (>= dst 0)]
    [(ir.CompilerIrInstr.Jump _) true]
    [_ false]))

(define (opt-inline-tiny-predicate-instr-seq-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (opt-inline-tiny-predicate-instr-ok?
    (ir.compiler-ir-instr-seq-ref instrs index)))

(define (opt-inline-tiny-predicate-instrs-ok-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (if (opt-inline-tiny-predicate-instr-seq-ok? instrs index)
      (opt-inline-tiny-predicate-instrs-ok-from? instrs (+ index 1))
      false)))

(define (opt-inline-tiny-predicate-instrs-ok? [instrs : ir.CompilerIrInstrSeq]) : bool
  (opt-inline-tiny-predicate-instrs-ok-from? instrs 0))

(define (opt-inline-tiny-predicate-blocks-ok? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-inline-tiny-predicate-instrs-ok? instrs)
            (opt-inline-tiny-predicate-blocks-ok? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-tiny-predicate-blocks-ok?
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-tiny-predicate-forward-successors?
  [index : OptCfgIndex]
  [source-id : i64]
  [succs : OptLabelSet]) : bool
  (match succs
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (match (opt-cfg-index-id index (opt-label-ref succs 0))
        [(option_i64.Some target-id)
          (and
            (> target-id source-id)
            (opt-inline-tiny-predicate-forward-successors?
              index
              source-id
              (opt-label-tail succs)))]
        [(option_i64.None) false])]))

(define (opt-inline-tiny-predicate-forward-edges-from?
  [index : OptCfgIndex]
  [id : i64]
  [count : i64]) : bool
  (if (>= id count)
    true
    (if (opt-inline-tiny-predicate-forward-successors?
      index
      id
      (opt-cfg-index-successors index (opt-cfg-index-label index id)))
      (opt-inline-tiny-predicate-forward-edges-from? index (+ id 1) count)
      false)))

(define (opt-inline-tiny-predicate-acyclic? [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    (opt-inline-tiny-predicate-forward-edges-from?
      index
      0
      (opt-cfg-index-block-count index))))

(define (opt-inline-tiny-predicate-callee?
  [index : OptFunctionIndex]
  [callee : ir.CompilerIrFunction]
  [census : OptInlineCensus]) : bool
  (match callee
    [(ir.CompilerIrFunction.Function callee-name cparams ret cvars cblocks)
      (let
        [np : i64 (opt-inline-param-count cparams)]
        [block-count : i64 (ir.compiler-ir-block-list-count cblocks)]
        [instr-count : i64 (opt-inline-multiblock-cost-instrs cblocks)]
        (and
          (opt-inline-bool-type? ret)
          (not (opt-inline-params-have-private-memory? cparams))
          (not (opt-inline-census-address-taken? index census callee-name))
          (> (opt-inline-census-refcount index census callee-name) 1)
          (opt-inline-params-sequential? cparams 0)
          (>= cvars np)
          (> block-count 1)
          (<= block-count (opt-inline-tiny-predicate-max-blocks))
          (<= instr-count (opt-inline-tiny-predicate-max-instrs))
          (> (opt-inline-return-count-blocks cblocks) 0)
          (opt-inline-structure-ok-reclaiming? cblocks)
          (opt-inline-tiny-predicate-acyclic-reclaiming? cblocks)
          (not (opt-inline-param-mutating-blocks? cblocks np))
          (opt-inline-tiny-predicate-blocks-ok? cblocks)))]))

(define (opt-inline-tiny-predicate-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [const-args : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (opt-inline-cost-inline-with-block-weight?
    callee-instrs
    added-blocks
    const-args
    false
    caller-blocks
    added-so-far
    0))

(define (opt-inline-rebase-var [id : i64] [np : i64] [base : i64]) : i64
  (+ base (- id np)))

(define (opt-inline-frame-growth [frame : i64] [np : i64]) : i64
  (- frame np))

(define (opt-inline-stage-arg-var [base : i64] [id : i64]) : ir.CompilerIrValue
  (ir.CompilerIrValue.Var (+ base id)))

(define (opt-inline-param-is-sret-at?
  [params : ir.CompilerIrParamList]
  [target : i64]
  [index : i64]) : bool
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) false]
    [(ir.CompilerIrParamList.Array seq)
      (opt-inline-param-is-sret-at?
        (ir.compiler-ir-param-seq-to-list seq)
        target
        index)]
    [(ir.CompilerIrParamList.Cons param rest)
      (if (= index target)
        (match param
          [(ir.CompilerIrParam.Param name _ _) (string.eq name "__sret")])
        (opt-inline-param-is-sret-at? (__tl-box-place rest) target (+ index 1)))]))

(define (opt-inline-staged-arg
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrCallArgs]
  [base : i64]
  [index : i64]
  [stage-all? : bool]) : ir.CompilerIrValue
  (if (or stage-all? (not (opt-inline-param-is-sret-at? params index 0)))
    (opt-inline-stage-arg-var base index)
    (opt-inline-clone-arg-at args index)))

(define (opt-inline-staged-args-array-fill!
  [out : (__tl_dyn-array ir.CompilerIrValue)]
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrCallArgs]
  [base : i64]
  [stage-all? : bool]
  [index : i64]) : unit
  (if (>= index (array-length out))
    unit
    (begin
      (set!
        (array-ref out index)
        (opt-inline-staged-arg params args base index stage-all?))
      (opt-inline-staged-args-array-fill!
        out
        params
        args
        base
        stage-all?
        (+ index 1)))))

(define (opt-inline-staged-args
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [stage-all? : bool]) : ir.CompilerIrCallArgs
  (cond
    [(= np 0) (ir.CompilerIrCallArgs.Nil)]
    [(= np 1)
      (ir.CompilerIrCallArgs.One
        (opt-inline-staged-arg params args base 0 stage-all?))]
    [(= np 2)
      (ir.CompilerIrCallArgs.Two
        (opt-inline-staged-arg params args base 0 stage-all?)
        (opt-inline-staged-arg params args base 1 stage-all?))]
    [else
      (let
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue np)]
        (begin
          (opt-inline-staged-args-array-fill! out params args base stage-all? 0)
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-inline-stage-param-instrs
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrCallArgs]
  [base : i64]
  [stage-all? : bool]
  [index : i64]) : ir.CompilerIrInstrList
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) ir.CompilerIrInstrList.Nil]
    [(ir.CompilerIrParamList.Array seq)
      (opt-inline-stage-param-instrs
        (ir.compiler-ir-param-seq-to-list seq)
        args
        base
        stage-all?
        index)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name ty _)
          (let
            [remaining : ir.CompilerIrInstrList
              (opt-inline-stage-param-instrs
                (__tl-box-place rest)
                args
                base
                stage-all?
                (+ index 1))]
            (if (or stage-all? (not (string.eq name "__sret")))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Mov
                  (+ base index)
                  (opt-inline-clone-arg-at args index)
                  (clone ty))
                remaining)
              remaining))])]))

(define (opt-inline-clone-arg-at [sa : ir.CompilerIrCallArgs] [id : i64]) : ir.CompilerIrValue
  (match sa
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrValue.Unit)]
    [(ir.CompilerIrCallArgs.One a) (ir.compiler-ir-clone-value a)]
    [(ir.CompilerIrCallArgs.Two a b)
      (if (= id 0)
        (ir.compiler-ir-clone-value a)
        (ir.compiler-ir-clone-value b))]
    [(ir.CompilerIrCallArgs.Array arr)
      (ir.compiler-ir-clone-value (array-ref arr id))]))

(define (opt-inline-remap-value
  [v : ir.CompilerIrValue]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrValue
  (match v
    [(ir.CompilerIrValue.Var id)
      (if (< id np)
        (opt-inline-clone-arg-at sa id)
        (ir.CompilerIrValue.Var (opt-inline-rebase-var id np base)))]
    [(ir.CompilerIrValue.Global name)
      (ir.CompilerIrValue.Global (ir.compiler-ir-symbol-clone name))]
    [(ir.CompilerIrValue.GlobalAddr name)
      (ir.CompilerIrValue.GlobalAddr (ir.compiler-ir-symbol-clone name))]
    [(ir.CompilerIrValue.Function name)
      (ir.CompilerIrValue.Function (ir.compiler-ir-symbol-clone name))]
    [(ir.CompilerIrValue.I64 n) (ir.CompilerIrValue.I64 n)]
    [(ir.CompilerIrValue.F64 bits) (ir.CompilerIrValue.F64 bits)]
    [(ir.CompilerIrValue.Bool b) (ir.CompilerIrValue.Bool b)]
    [(ir.CompilerIrValue.Char c) (ir.CompilerIrValue.Char c)]
    [(ir.CompilerIrValue.String s) (ir.CompilerIrValue.String (clone s))]
    [(ir.CompilerIrValue.Bytes s) (ir.CompilerIrValue.Bytes (clone s))]
    [(ir.CompilerIrValue.RuntimeGlobal init)
      (ir.CompilerIrValue.RuntimeGlobal (ir.compiler-ir-symbol-clone init))]
    [(ir.CompilerIrValue.Unit) (ir.CompilerIrValue.Unit)]))

(define (opt-inline-remap-args
  [a : ir.CompilerIrCallArgs]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrCallArgs
  (match a
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrCallArgs.Nil)]
    [(ir.CompilerIrCallArgs.One x)
      (ir.CompilerIrCallArgs.One (opt-inline-remap-value x sa np base))]
    [(ir.CompilerIrCallArgs.Two x y)
      (ir.CompilerIrCallArgs.Two
        (opt-inline-remap-value x sa np base)
        (opt-inline-remap-value y sa np base))]
    [(ir.CompilerIrCallArgs.Array arr)
      (let
        [n : i64 (array-length arr)]
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue n)]
        [i : i64 0]
        (begin
          (while (< i n)
            (begin
              (set!
                (array-ref out i)
                (opt-inline-remap-value (array-ref arr i) sa np base))
              (set! i (+ i 1))))
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-inline-remap-value-list
  [values : ir.CompilerIrValueList]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrValueList
  (match values
    [(ir.CompilerIrValueList.Nil) ir.CompilerIrValueList.Nil]
    [(ir.CompilerIrValueList.Array seq)
      (opt-inline-remap-value-list
        (ir.compiler-ir-value-seq-to-list seq)
        sa
        np
        base)]
    [(ir.CompilerIrValueList.Cons value rest)
      (ir.compiler-ir-value-cons
        (opt-inline-remap-value value sa np base)
        (opt-inline-remap-value-list (__tl-box-place rest) sa np base))]))

;; Inlining renames a callee's blocks by prefixing the caller-site tag onto the
;; original spelling, so the derived name is re-interned into a fresh id.
(define (opt-inline-maybe-prefix-label [prefix : String] [label : i64]) : i64
  (if (string.eq prefix "")
    label
    (ir.compiler-ir-label
      (str_cat.str-cat prefix "." (ir.compiler-ir-label-text label)))))

(define (opt-inline-clone-instr
  [instr : ir.CompilerIrInstr]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.Gep dst b o ty)
      (ir.CompilerIrInstr.Gep
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value b sa np base)
        (opt-inline-remap-value o sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.Cast dst src from to)
      (ir.CompilerIrInstr.Cast
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone from)
        (clone to))]
    [(ir.CompilerIrInstr.Bitcast dst src from to)
      (ir.CompilerIrInstr.Bitcast
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        (clone from)
        (clone to))]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        (opt-inline-rebase-var dst np base)
        op
        (opt-inline-remap-value lhs sa np base)
        (opt-inline-remap-value rhs sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        (opt-inline-rebase-var dst np base)
        op
        (opt-inline-remap-value src sa np base)
        (clone ty))]
    ;; Pack/Word need explicit remap arms; when they were inline-eligible
    ;; without them, inlined register-group instructions kept their CALLEE-local
    ;; var ids inside the caller -- an opt2 self-build miscompile (the
    ;; stage2/stage3 fixpoint diverged and no-regalloc builds bounds-aborted
    ;; in intern-str on garbage ids).
    [(ir.CompilerIrInstr.Pack dst words ty)
      (ir.CompilerIrInstr.Pack
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value-list words sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (ir.CompilerIrInstr.Word
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value src sa np base)
        index
        (clone ty))]
    [(ir.CompilerIrInstr.BoundsCheck idx len msg)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-inline-remap-value idx sa np base)
        (opt-inline-remap-value len sa np base)
        (opt-inline-maybe-prefix-label label-prefix msg))]
    [(ir.CompilerIrInstr.StorePtr d s ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-inline-remap-value d sa np base)
        (opt-inline-remap-value s sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.CopyBytes d s size)
      (ir.CompilerIrInstr.CopyBytes
        (opt-inline-remap-value d sa np base)
        (opt-inline-remap-value s sa np base)
        size)]
    [(ir.CompilerIrInstr.Call dst name a ty)
      (ir.CompilerIrInstr.Call
        (opt-inline-rebase-var dst np base)
        (ir.compiler-ir-symbol-clone name)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.CallIndirect dst callee a ty)
      (ir.CompilerIrInstr.CallIndirect
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value callee sa np base)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.CallIndirectC dst callee a ty)
      (ir.CompilerIrInstr.CallIndirectC
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-value callee sa np base)
        (opt-inline-remap-args a sa np base)
        (clone ty))]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [call-base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [a (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-cabi-store-result
          (opt-inline-remap-value call-base sa np base)
          (ir.compiler-ir-symbol-clone name)
          (opt-inline-remap-args a sa np base)
          slots))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [call-base (__tl-project-field (__tl-box-place payload-box) base)]
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [a (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-indirect-cabi-store-result
          (opt-inline-remap-value call-base sa np base)
          (opt-inline-remap-value callee sa np base)
          (opt-inline-remap-args a sa np base)
          slots))]
    [_ instr]))

(define (opt-inline-return->mov
  [instr : ir.CompilerIrInstr]
  [dst : i64]
  [ret : ast.AstType]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Return maybe)
      (match maybe
        [(ir.CompilerIrMaybeValue.Some v)
          (ir.CompilerIrInstr.Mov
            dst
            (opt-inline-remap-value v sa np base)
            (clone ret))]
        [(ir.CompilerIrMaybeValue.No)
          (ir.CompilerIrInstr.Mov dst (ir.CompilerIrValue.Unit) (clone ret))])]
    [_ (ir.CompilerIrInstr.Mov dst (ir.CompilerIrValue.Unit) (clone ret))]))

(define (opt-inline-expand-instrs-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]
  [ret : ast.AstType]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]) : ir.CompilerIrInstrList
  (if (>= index count)
    ir.CompilerIrInstrList.Nil
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (= index (- count 1))
        (ir.compiler-ir-instr-cons
          (opt-inline-return->mov instr dst ret sa np base)
          ir.CompilerIrInstrList.Nil)
        (ir.compiler-ir-instr-cons
          (opt-inline-clone-instr instr sa np base label-prefix)
          (opt-inline-expand-instrs-from
            instrs
            (+ index 1)
            count
            dst
            ret
            sa
            np
            base
            label-prefix))))))

(define (opt-inline-expand-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [dst : i64]
  [ret : ast.AstType]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]) : ir.CompilerIrInstrList
  (opt-inline-expand-instrs-from
    instrs
    0
    (ir.compiler-ir-instr-seq-count instrs)
    dst
    ret
    sa
    np
    base
    label-prefix))

;; Span policy for inlined clones: prefer the callee instruction's original
;; source span under the clone's new caller/value key. If the callee instruction
;; has no recorded span (notably the synthetic return->mov), use the call-site
;; span so the cloned instruction still points at useful user code.
(define (opt-source-spans-lookup-instr-span
  [source-spans : ir.CompilerSourceSpans]
  [function : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerMaybeSourceSpan
  (match source-spans
    [(ir.CompilerSourceSpans.Spans _ instr-entries _)
      (match (opt-remap-spans-instr-key function instr)
        [(OptRemapSpanKey.NoKey) (ir.CompilerMaybeSourceSpan.No)]
        [(OptRemapSpanKey.SomeKey key)
          (ir.compiler-source-spans-instr-entry-list-lookup-span
            instr-entries
            key)])]))

(define (opt-inline-record-clone-span
  [source-spans : ir.CompilerSourceSpans]
  [out : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]
  [callee-instr : ir.CompilerIrInstr]
  [cloned : ir.CompilerIrInstr]) : ir.CompilerSourceSpans
  (if (ir.compiler-debug-info-enabled?)
    (match (ir.compiler-source-spans-lookup-instr-location
      source-spans
      callee
      callee-instr)
      [(ir.CompilerMaybeSourceLocation.Some
          (ir.CompilerSourceLocation path-id span))
        (ir.compiler-source-spans-insert-instr-located
          out
          caller
          cloned
          path-id
          span)]
      [(ir.CompilerMaybeSourceLocation.No)
        (match (ir.compiler-source-spans-lookup-instr-location
          source-spans
          caller
          call-instr)
          [(ir.CompilerMaybeSourceLocation.Some
              (ir.CompilerSourceLocation path-id span))
            (ir.compiler-source-spans-insert-instr-located
              out
              caller
              cloned
              path-id
              span)]
          [(ir.CompilerMaybeSourceLocation.No) out]
          [_ out])]
      [_ out])
    (match (opt-source-spans-lookup-instr-span source-spans callee callee-instr)
      [(ir.CompilerMaybeSourceSpan.Some span)
        (ir.compiler-source-spans-insert-instr out caller cloned span)]
      [(ir.CompilerMaybeSourceSpan.No)
        (match (opt-source-spans-lookup-instr-span
          source-spans
          caller
          call-instr)
          [(ir.CompilerMaybeSourceSpan.Some span)
            (ir.compiler-source-spans-insert-instr out caller cloned span)]
          [(ir.CompilerMaybeSourceSpan.No) out])])))

(define (opt-inline-expand-instrs-with-spans-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]
  [ret : ast.AstType]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]) : OptInlineSpanState
  (if (>= index count)
    (OptInlineSpanState.State ir.CompilerIrInstrList.Nil base 0 out-spans)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (= index (- count 1))
        (let
          [moved : ir.CompilerIrInstr
            (opt-inline-return->mov instr dst ret sa np base)]
          [next-spans : ir.CompilerSourceSpans
            (opt-inline-record-clone-span
              source-spans
              out-spans
              caller
              call-instr
              callee
              instr
              moved)]
          (OptInlineSpanState.State
            (ir.compiler-ir-instr-cons moved ir.CompilerIrInstrList.Nil)
            base
            0
            next-spans))
        (let
          [cloned : ir.CompilerIrInstr
            (opt-inline-clone-instr instr sa np base label-prefix)]
          [next-spans : ir.CompilerSourceSpans
            (opt-inline-record-clone-span
              source-spans
              out-spans
              caller
              call-instr
              callee
              instr
              cloned)]
          (match (opt-inline-expand-instrs-with-spans-from
            instrs
            (+ index 1)
            count
            dst
            ret
            sa
            np
            base
            label-prefix
            source-spans
            next-spans
            caller
            call-instr
            callee)
            [(OptInlineSpanState.State rest-instrs next-vars _ final-spans)
              (OptInlineSpanState.State
                (ir.compiler-ir-instr-cons cloned rest-instrs)
                next-vars
                0
                final-spans)]))))))

(define (opt-inline-expand-instrs-with-spans
  [instrs : ir.CompilerIrInstrSeq]
  [dst : i64]
  [ret : ast.AstType]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]) : OptInlineSpanState
  (opt-inline-expand-instrs-with-spans-from
    instrs
    0
    (ir.compiler-ir-instr-seq-count instrs)
    dst
    ret
    sa
    np
    base
    label-prefix
    source-spans
    out-spans
    caller
    call-instr
    callee))

(define (opt-inline-empty-instr-seq) : ir.CompilerIrInstrSeq
  (ir.compiler-ir-instr-builder-to-seq
    (ir.compiler-ir-instr-builder-with-capacity 0)))

(define (opt-inline-single-block-instrs [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrInstrSeq
  (match blocks
    [(ir.CompilerIrBlockList.Cons block _)
      (match block
        [(ir.CompilerIrBlock.Block _ seq) seq])]
    [(ir.CompilerIrBlockList.Array seq)
      (if (= (ir.compiler-ir-block-seq-count seq) 1)
        (match (ir.compiler-ir-block-seq-ref seq 0)
          [(ir.CompilerIrBlock.Block _ instrs) instrs])
        (opt-inline-empty-instr-seq))]
    [_ (opt-inline-empty-instr-seq)]))

(define (opt-inline-append
  [a : ir.CompilerIrInstrList]
  [b : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match a
    [(ir.CompilerIrInstrList.Nil) b]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (ir.compiler-ir-instr-cons
        instr
        (opt-inline-append (__tl-box-place rest) b))]))

(define (opt-inline-block-append
  [a : ir.CompilerIrBlockList]
  [b : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match a
    [(ir.CompilerIrBlockList.Nil) b]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        block
        (opt-inline-block-append (__tl-box-place rest) b))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-block-append (ir.compiler-ir-block-seq-to-list seq) b)]))

(define (opt-inline-site-prefix
  [_func-name : i64]
  [block-label : i64]
  [pos : i64]
  [_callee-name : i64]) : String
  (str_cat.str-cat
    "inl."
    (ir.compiler-ir-label-text block-label)
    "."
    (string.int->string pos)))

(define (opt-inline-prefix-label [prefix : String] [label : i64]) : i64
  (opt-inline-maybe-prefix-label prefix label))

(define (opt-inline-cont-label [prefix : String]) : i64
  (ir.compiler-ir-label (str_cat.str-cat prefix ".cont")))

(define (opt-inline-remap-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [prefix : String]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-inline-remap-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        prefix
        sa
        np
        base)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-inline-remap-value value sa np base)
        (opt-inline-prefix-label prefix label)
        (opt-inline-remap-phi-inputs (__tl-box-place rest) prefix sa np base))]))

(define (opt-inline-prefix-switch-cases-acc
  [cases : ir.CompilerIrSwitchCaseList]
  [prefix : String]
  [acc : ir.CompilerIrSwitchCaseList]) : ir.CompilerIrSwitchCaseList
  (match (ir.compiler-ir-switch-case-list-force-cons cases)
    [(ir.CompilerIrSwitchCaseList.Nil) acc]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case tag label)
          (opt-inline-prefix-switch-cases-acc
            (__tl-box-place rest)
            prefix
            (ir.compiler-ir-switch-case-cons-linked
              tag
              (opt-inline-prefix-label prefix label)
              acc))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-inline-prefix-switch-cases-acc
        (ir.compiler-ir-switch-case-seq-to-list seq)
        prefix
        acc)]))

(define (opt-inline-prefix-switch-cases
  [cases : ir.CompilerIrSwitchCaseList]
  [prefix : String]) : ir.CompilerIrSwitchCaseList
  (ir.compiler-ir-switch-case-list-compact-reversed
    (opt-inline-prefix-switch-cases-acc
      cases
      prefix
      ir.CompilerIrSwitchCaseList.Nil)))

(define (opt-inline-clone-multiblock-instr
  [instr : ir.CompilerIrInstr]
  [prefix : String]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Jump label)
      (ir.CompilerIrInstr.Jump (opt-inline-prefix-label prefix label))]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (ir.CompilerIrInstr.Branch
        (opt-inline-remap-value cond sa np base)
        (opt-inline-prefix-label prefix true-label)
        (opt-inline-prefix-label prefix false-label))]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (ir.CompilerIrInstr.TotalEnumBranch
        (opt-inline-remap-value cond sa np base)
        (opt-inline-prefix-label prefix true-label)
        (opt-inline-prefix-label prefix false-label))]
    [(ir.CompilerIrInstr.Switch value tag-base cases default-label)
      (ir.CompilerIrInstr.Switch
        (opt-inline-remap-value value sa np base)
        tag-base
        (opt-inline-prefix-switch-cases cases prefix)
        (opt-inline-prefix-label prefix default-label))]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        value
        tag-base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (opt-inline-remap-value value sa np base)
        tag-base
        (opt-inline-prefix-switch-cases cases prefix)
        (opt-inline-prefix-label prefix default-label)
        (if (= trap-label (ir.compiler-ir-label-none))
          trap-label
          (opt-inline-prefix-label prefix trap-label)))]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        (opt-inline-rebase-var dst np base)
        (opt-inline-remap-phi-inputs inputs prefix sa np base)
        (clone ty))]
    [_ (opt-inline-clone-instr instr sa np base prefix)]))

(define (opt-inline-return-value
  [maybe : ir.CompilerIrMaybeValue]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : ir.CompilerIrValue
  (match maybe
    [(ir.CompilerIrMaybeValue.Some value)
      (opt-inline-remap-value value sa np base)]
    [(ir.CompilerIrMaybeValue.No) (ir.CompilerIrValue.Unit)]))

;; `tail-dst` is THIS block's reserved result slot for a converted tail call.
;; A tail call is a terminator, so a block holds at most one and one slot per
;; cloned block is exactly enough; opt-inline-clone-multiblock-blocks hands each
;; block the next slot, and the caller reserves the range above the clone's
;; rebased frame (opt-inline-multiblock-build-rewrite-seq). It is read only on
;; the TailCall arm, so a tail-call-free body never touches it.
(define (opt-inline-clone-multiblock-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiInstrClone
  (if (>= pos count)
    (OptInlineMultiInstrClone.Clone
      ir.CompilerIrInstrList.Nil
      ir.CompilerIrPhiInputList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(ir.CompilerIrInstr.Return maybe)
          (OptInlineMultiInstrClone.Clone
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Jump cont-label)
              ir.CompilerIrInstrList.Nil)
            (ir.compiler-ir-phi-input-cons
              (opt-inline-return-value maybe sa np base)
              cloned-label
              ir.CompilerIrPhiInputList.Nil))]
        ;; `return f(args)` in the callee becomes `t = f(args); goto cont` with
        ;; `t` as this edge's phi input -- the same exit wiring the Return arm
        ;; above builds, with the call it was fused into spelled back out. The
        ;; converted call carries the tail call's own result type, which is the
        ;; type a non-tail direct call to the same callee would carry, and its
        ;; arguments go through the ordinary argument remapper, so a forwarded
        ;; `__sret` pointer stays the buffer the caller supplied.
        [(ir.CompilerIrInstr.TailCall cname cargs cty)
          (OptInlineMultiInstrClone.Clone
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Call
                tail-dst
                (ir.compiler-ir-symbol-clone cname)
                (opt-inline-remap-args cargs sa np base)
                (clone cty))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Jump cont-label)
                ir.CompilerIrInstrList.Nil))
            (ir.compiler-ir-phi-input-cons
              (ir.CompilerIrValue.Var tail-dst)
              cloned-label
              ir.CompilerIrPhiInputList.Nil))]
        [_
          (let
            [cloned : ir.CompilerIrInstr
              (opt-inline-clone-multiblock-instr instr prefix sa np base)]
            (match (opt-inline-clone-multiblock-instr-seq-from
              instrs
              (+ pos 1)
              count
              cloned-label
              prefix
              cont-label
              tail-dst
              sa
              np
              base)
              [(OptInlineMultiInstrClone.Clone rest-instrs rest-inputs)
                (OptInlineMultiInstrClone.Clone
                  (ir.compiler-ir-instr-cons cloned rest-instrs)
                  rest-inputs)]))]))))

(define (opt-inline-clone-multiblock-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiInstrClone
  (opt-inline-clone-multiblock-instr-seq-from
    instrs
    0
    (ir.compiler-ir-instr-seq-count instrs)
    cloned-label
    prefix
    cont-label
    tail-dst
    sa
    np
    base))

(define (opt-inline-clone-multiblock-block
  [block : ir.CompilerIrBlock]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiClone
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [cloned-label : i64 (opt-inline-prefix-label prefix label)]
        (match (opt-inline-clone-multiblock-instr-seq
          instrs
          cloned-label
          prefix
          cont-label
          tail-dst
          sa
          np
          base)
          [(OptInlineMultiInstrClone.Clone cloned-instrs inputs)
            (OptInlineMultiClone.Clone
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block cloned-label cloned-instrs)
                ir.CompilerIrBlockList.Nil)
              inputs)]))]))

(define (opt-inline-clone-multiblock-blocks
  [blocks : ir.CompilerIrBlockList]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]) : OptInlineMultiClone
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptInlineMultiClone.Clone
        ir.CompilerIrBlockList.Nil
        ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-inline-clone-multiblock-block
        block
        prefix
        cont-label
        tail-dst
        sa
        np
        base)
        [(OptInlineMultiClone.Clone one-block one-inputs)
          (match (opt-inline-clone-multiblock-blocks
            (__tl-box-place rest)
            prefix
            cont-label
            (+ tail-dst 1)
            sa
            np
            base)
            [(OptInlineMultiClone.Clone rest-blocks rest-inputs)
              (OptInlineMultiClone.Clone
                (opt-inline-block-append one-block rest-blocks)
                (ir.compiler-ir-phi-input-list-reverse-onto
                  one-inputs
                  rest-inputs))])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-clone-multiblock-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        prefix
        cont-label
        tail-dst
        sa
        np
        base)]))

(define (opt-inline-cont-result-instr
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [ret : ast.AstType]) : ir.CompilerIrInstr
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-inline-cont-result-instr
        dst
        (ir.compiler-ir-phi-input-seq-to-list seq)
        ret)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (match (ir.compiler-ir-phi-input-list-force-cons (__tl-box-place rest))
        [(ir.CompilerIrPhiInputList.Nil)
          (ir.CompilerIrInstr.Mov
            dst
            (ir.compiler-ir-clone-value value)
            (clone ret))]
        [(ir.CompilerIrPhiInputList.Array seq)
          (if (= seq.len 0)
            (ir.CompilerIrInstr.Mov
              dst
              (ir.compiler-ir-clone-value value)
              (clone ret))
            (ir.CompilerIrInstr.Phi dst inputs (clone ret)))]
        [_ (ir.CompilerIrInstr.Phi dst inputs (clone ret))])]
    [(ir.CompilerIrPhiInputList.Nil)
      (ir.CompilerIrInstr.Mov dst (ir.CompilerIrValue.Unit) (clone ret))]))

(define (opt-inline-call-span-to-instr
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [func-name : i64]
  [call-instr : ir.CompilerIrInstr]
  [new-instr : ir.CompilerIrInstr]) : ir.CompilerSourceSpans
  (if (ir.compiler-debug-info-enabled?)
    (match (ir.compiler-source-spans-lookup-instr-location
      source-spans
      func-name
      call-instr)
      [(ir.CompilerMaybeSourceLocation.Some
          (ir.CompilerSourceLocation path-id span))
        (ir.compiler-source-spans-insert-instr-located
          out-spans
          func-name
          new-instr
          path-id
          span)]
      [(ir.CompilerMaybeSourceLocation.No) out-spans]
      [_ out-spans])
    (match (opt-source-spans-lookup-instr-span
      source-spans
      func-name
      call-instr)
      [(ir.CompilerMaybeSourceSpan.Some span)
        (ir.compiler-source-spans-insert-instr
          out-spans
          func-name
          new-instr
          span)]
      [(ir.CompilerMaybeSourceSpan.No) out-spans])))

(define (opt-inline-lookup-inlinable
  [index : OptFunctionIndex]
  [cname : i64]
  [caller-name : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(option_i64.Some callee-slot)
      (if (and
        (>= caller-scc 0)
        (= (array-ref scc-result.scc-of callee-slot) caller-scc))
        (OptMaybeFunction.No)
        (let
          [callee : ir.CompilerIrFunction (array-ref index.values callee-slot)]
          (if (opt-inline-callee-ok? callee caller-name)
            (OptMaybeFunction.Some callee)
            (OptMaybeFunction.No))))]
    [(option_i64.None) (OptMaybeFunction.No)]))

(define (opt-inline-lookup-multiblock-inlinable
  [index : OptFunctionIndex]
  [cname : i64]
  [caller-name : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(option_i64.Some callee-slot)
      (if (and
        (>= caller-scc 0)
        (= (array-ref scc-result.scc-of callee-slot) caller-scc))
        (OptMaybeFunction.No)
        (let
          [callee : ir.CompilerIrFunction (array-ref index.values callee-slot)]
          (if (opt-inline-multiblock-callee-ok-cached?
            callee-slot
            callee
            caller-name)
            (OptMaybeFunction.Some callee)
            (OptMaybeFunction.No))))]
    [(option_i64.None) (OptMaybeFunction.No)]))

(define (opt-inline-bounds-inline-ok?
  [has-bounds? : bool]
  [absorbable? : bool]
  [const-args : i64]
  [param-count : i64]) : bool
  (if has-bounds?
    (or absorbable? (= const-args param-count))
    true))

;; Keep loop-bearing bounds callees behind the general acyclic gate. `vm-run`
;; is the one measured exception: eliminating its hot dispatch-call boundary
;; wins without changing the static bounds-check count. Match the exact IR leaf
;; so similarly shaped package functions (notably `qs-partition`) stay refused.
(define (opt-inline-vm-run-bounds-loop-exception? [callee-name : i64]) : bool
  (let
    [name : String (ir.compiler-ir-symbol-text callee-name)]
    (opt-symbol-leaf-matches-from? name (opt-symbol-leaf-start name) "vm-run")))

;; --- loop-bearing bounds callee admission -----------------------------------
;;
;; A bounds-carrying callee whose body contains a loop used to be refused
;; outright, with the single measured `vm-run` name exception above. That
;; refusal is what keeps `intern_table`'s `it-load-word` behind a call: an
;; eight-iteration byte-compose loop that the constant-trip unroll and the
;; byte-compose-to-wide-load fold both rewrite into one 8-byte load as soon as
;; they can see it inside its caller. Retiring that one call boundary is worth
;; -6.6% on the row, and it lowers pressure rather than raising it: the callee
;; that absorbs it loses fourteen frame operations because the absorbed loop
;; stops existing.
;;
;; The same admission applied to every absorbable callee loses badly. What it
;; also absorbs is once-called `init`/`fill` setup helpers, into whichever
;; function holds the benchmark's hot loop. That trade buys a single call
;; boundary and pays the caller's whole allocation for it: spmd_scan's inner
;; loop went from seven to thirteen executed instructions per element -- four
;; frame operations plus a push/pop scratch pair -- to retire a call that runs
;; once per program. Three conditions separate the measured win from the
;; measured loss:
;;
;;   1. the census proves the callee absorbable, so the program does not grow;
;;   2. the callee is small, by opt-inline-bounds-loop-max-body and
;;      opt-inline-bounds-loop-max-blocks;
;;   3. the CALL SITE lies in a natural loop of the caller, so the retired
;;      boundary is repaid per iteration instead of once per program.
;;
;; A fourth, caller-side condition is owned by
;; opt-inline-bounds-loop-cascade-safe? below.
;;
;; The band is set from the measured leaf and the next size class above it.
;; `it-load-word` presents here as 26 instructions in 4 blocks; the smallest
;; corpus callees that lose are 30 instructions in 7 blocks and 51 in 15. 32
;; and 6 sit above the admitted shape and below both, so a body that needs a
;; second nesting level or a second working set is refused on structure rather
;; than on a count that happens to land right.
(define (opt-inline-bounds-loop-max-body) : i64
  32)

(define (opt-inline-bounds-loop-max-blocks) : i64
  6)

(define (opt-inline-bounds-loop-small?
  [blocks : ir.CompilerIrBlockList]
  [callee-instrs : i64]) : bool
  (and
    (<= callee-instrs (opt-inline-bounds-loop-max-body))
    (<=
      (ir.compiler-ir-block-list-count blocks)
      (opt-inline-bounds-loop-max-blocks))))

;; Facts about the caller currently being rewritten. They are installed per
;; caller, but the two that cost real work -- the natural-loop label set and
;; the bounds-check scan -- are computed on first demand and only when a small
;; absorbable loop-bearing candidate has already passed the free tests above.
;; Computing them for every function instead is +0.36% of the opt2 self-compile
;; spent on facts that almost no caller reads.
(define opt-inline-caller-facts-blocks : (__tl_dyn-array ir.CompilerIrBlockList)
  (make-array (ir.CompilerIrBlockList.Nil)))

(define (opt-inline-caller-facts-blocks-shared-view) : ir.CompilerIrBlockList
  (unsafe
    (ptr-read
      (ptr-cast
        (array-data opt-inline-caller-facts-blocks)
        : (Ptr ir.CompilerIrBlockList)))))

(define opt-inline-caller-single-site? : bool
  false)
(define opt-inline-caller-facts-ready? : bool
  false)
(define opt-inline-caller-loop-labels : (__tl_dyn-array OptLabelSet)
  (make-array (OptLabelSet.Nil)))

(define (opt-inline-caller-loop-labels-shared-view) : OptLabelSet
  (unsafe
    (ptr-read
      (ptr-cast (array-data opt-inline-caller-loop-labels) : (Ptr OptLabelSet)))))

(define opt-inline-caller-has-bounds? : bool
  false)
(define opt-inline-caller-name : i64
  0)
(define opt-inline-caller-recursion-known? : bool
  false)
(define opt-inline-caller-recursion? : bool
  false)
(define opt-inline-current-block-label : i64
  0)

(define (opt-inline-loop-label-union-from
  [acc : OptLabelSet]
  [other : OptLabelSet]
  [index : i64]
  [count : i64]) : OptLabelSet
  (if (>= index count)
    acc
    (opt-inline-loop-label-union-from
      (opt-label-add acc (opt-label-ref other index))
      other
      (+ index 1)
      count)))

(define (opt-inline-loop-labels-add
  [loops : OptNaturalLoopList]
  [acc : OptLabelSet]) : OptLabelSet
  (match loops
    [(OptNaturalLoopList.Nil) acc]
    [(OptNaturalLoopList.Cons loop rest)
      (let
        [body : OptLabelSet (opt-natural-loop-body loop)]
        (opt-inline-loop-labels-add
          (__tl-box-place rest)
          (opt-inline-loop-label-union-from acc body 0 (opt-label-count body))))]))

(define (opt-inline-caller-facts-install!
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [name : i64]
  [blocks : ir.CompilerIrBlockList]) : unit
  (begin
    (set! (array-ref opt-inline-caller-facts-blocks 0) blocks)
    (set!
      opt-inline-caller-single-site?
      (opt-inline-census-single-site? index census name))
    (set! opt-inline-caller-facts-ready? false)
    (set! (array-ref opt-inline-caller-loop-labels 0) (OptLabelSet.Nil))
    (set! opt-inline-caller-has-bounds? false)
    (set! opt-inline-caller-name name)
    (set! opt-inline-caller-recursion-known? false)
    (set! opt-inline-caller-recursion? false)
    (set! opt-inline-caller-hot-loop-blocks 0)
    (set! opt-inline-caller-chain-blocks 0)
    (set! opt-inline-caller-accessor-blocks 0)
    (set! opt-inline-caller-checked-blocks 0)
    (set! opt-inline-caller-checked-taken? false)
    (set! opt-inline-current-block-label (ir.compiler-ir-label-none))))

(define (opt-inline-caller-facts-ensure!) : unit
  (if opt-inline-caller-facts-ready?
    unit
    (begin
      (set!
        (array-ref opt-inline-caller-loop-labels 0)
        (opt-inline-loop-labels-add
          (opt-cfg-natural-loops (opt-inline-caller-facts-blocks-shared-view))
          (OptLabelSet.Nil)))
      (set!
        opt-inline-caller-has-bounds?
        (opt-inline-blocks-have-bounds-check?
          (opt-inline-caller-facts-blocks-shared-view)))
      (set! opt-inline-caller-facts-ready? true))))

(define (opt-inline-bounds-loop-site-in-loop?) : bool
  (begin
    (opt-inline-caller-facts-ensure!)
    (opt-label-contains
      (opt-inline-caller-loop-labels-shared-view)
      opt-inline-current-block-label)))

;; Does the caller call itself? Memoized on its own flag rather than folded into
;; opt-inline-caller-facts-ensure! -- the natural-loop build and the bounds scan
;; are forced by every small loop-bearing candidate, and this scan is forced
;; only by the recursive-site tier below, which is the last clause it asks.
(define (opt-inline-caller-recursive?) : bool
  (begin
    (if opt-inline-caller-recursion-known?
      unit
      (begin
        (set!
          opt-inline-caller-recursion?
          (opt-loop-bce-direct-call-self-recursive-blocks?
            opt-inline-caller-name
            (opt-inline-caller-facts-blocks-shared-view)))
        (set! opt-inline-caller-recursion-known? true)))
    opt-inline-caller-recursion?))

;; The one measured way a hot-site, small, absorbable import still loses.
;; opt_quicksort's `qs-bench` is itself a single-reference function carrying no
;; bounds checks, so it inlines into `main` for free. Importing `qs-fill` --
;; 24 instructions at a genuine in-loop site -- gives `qs-bench` its first
;; bounds-carrying loop, and this very gate then refuses `qs-bench` at its own
;; call site. The caller stops being absorbed, is emitted standalone, and
;; allocates worse: four frame operations inside `main` became thirty-six in
;; the evicted `qs-bench`, +0.285% on the row to retire a boundary worth far
;; less. The import is admissible; what it costs is the caller's own inline.
;;
;; So an import that would hand a bounds-free single-reference caller its first
;; bounds check is refused. A caller that already carries one is already
;; subject to this gate at its own site and has nothing further to lose, and a
;; caller with more than one reference was never going to be absorbed anyway.
(define (opt-inline-bounds-loop-cascade-safe?) : bool
  (begin
    (opt-inline-caller-facts-ensure!)
    (or (not opt-inline-caller-single-site?) opt-inline-caller-has-bounds?)))

;; Ordered so the two free tests run first: the lazy caller facts are only
;; forced for a candidate that is already claimed by this site and already
;; small. `claimed?` is the reference-class verdict -- absorption for a
;; single-reference callee, duplication for the two-reference case below -- so
;; both paths share one copy of the size, site, and cascade clauses.
(define (opt-inline-bounds-loop-absorb-ok?
  [claimed? : bool]
  [callee-instrs : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (and
    claimed?
    (opt-inline-bounds-loop-small? blocks callee-instrs)
    (opt-inline-bounds-loop-site-in-loop?)
    (opt-inline-bounds-loop-cascade-safe?)))

;; --- duplicating a two-reference leaf into its in-loop sites ----------------
;;
;; The admission above requires the callee to have exactly one static reference,
;; because absorption is what pays for it: the body moves, and the program does
;; not grow. A leaf with two references cannot be absorbed, only copied -- and
;; the measured population of two-reference callees that reach an in-loop site
;; is a family of character-class predicates, nine instructions in five blocks,
;; sitting one per element inside a scan loop. Copying nine instructions twice
;; to retire a call per character is the same trade the single-reference gate
;; already makes, and it measures the same way: gvn_table -1.356%, liveness_scan
;; -1.098%, cfg_domloops -0.680%, with no other row moving anywhere and the
;; corpus binaries 160 bytes SMALLER in total, because the retired call sequence
;; costs more static bytes than the duplicated body.
;;
;; The autopsy signature is the opposite of the inlining pathology this gate
;; exists to avoid: ln-fill-tokens goes from ten frame operations to one and
;; from five reloads to none, and cfg-scan-ints keeps its instruction count
;; exactly and loses two calls. Nine-instruction bodies do not move the
;; allocator.
;;
;; Everything the single-reference admission asks is asked here unchanged --
;; size, in-loop site, cascade -- through the same predicate, plus one condition
;; of its own: the body must be call-free. That is the pricing clause documented
;; at opt-inline-blocks-call-free? -- a duplicated body's own calls cost this
;; band's model things it cannot count, twice over because there are two copies
;; -- and not a clone-path limitation.
;;
;; The clause order is the cost argument. Every multiblock call site in the
;; program reaches this predicate, so the reference-class compare -- already
;; computed, one integer test -- runs first, before the block scan and before
;; the lazy caller facts. The call-free scan runs last, on the few candidates
;; that have already cleared size, site, and cascade.
;;
;; The site and cascade clauses are asked once per CALLER, from that caller's
;; own facts, so a two-reference leaf is duplicated only into those of its
;; callers that individually clear them and one caller taking the body does not
;; commit the other. (The cascade question a caller asks is still "am I a
;; single-reference function that would lose my own inline", which a
;; two-reference caller now answers "no" while itself being duplicable. That
;; caller-side widening is a separate probe; no corpus or self-compile row
;; exercises it today.)
;;
;; This has to grant the absorb credit, not merely pass the bounds gate: the
;; cost model prices a nine-instruction body in five blocks at 9 + 6*6 = 45
;; against a threshold of 4, so the block weight alone refuses every one of
;; these leaves. The single-reference bonus is what admits them, and a
;; duplication that has cleared the clauses above is the same bet.
(define (opt-inline-dup-absorb-ok?
  [absorb-class : i64]
  [callee-instrs : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (and
    (>= absorb-class 2)
    (opt-inline-bounds-loop-absorb-ok? true callee-instrs blocks)
    (opt-inline-blocks-call-free? blocks)))

;; --- absorbing a leaf into a RECURSIVE caller -------------------------------
;;
;; opt-inline-bounds-loop-absorb-ok? prices a bounds-carrying loop-bearing
;; callee by one question: does its call site lie in a natural loop of the
;; caller? That is what makes the retired boundary repay per iteration instead
;; of once per program. A natural loop is not the only construction that
;; repeats a site. opt_quicksort's `qs-sort` reaches `qs-partition` from a body
;; with no CFG loop at all when the inliner looks at it -- the site repeats by
;; RECURSION, once per pivot, 4.1M times on the measured row -- and the
;; loop-label test cannot see that. The tail-recursion-to-loop rewrite that
;; would make it visible runs after this decision.
;;
;; So this tier asks the same question in the currency the shape actually
;; carries: the CALLER calls itself, so its whole body, this site included, is
;; re-entered per recursion node. Everything else the loop tier asks is asked
;; here unchanged in spirit, and two clauses are tightened rather than relaxed:
;;
;;   1. the callee has exactly ONE static reference. This is absorption in the
;;      strict sense -- the body moves, the original is retired, the program
;;      does not grow -- so the two-reference duplication the loop tier allows
;;      is not offered here. A recursive caller is the worst place to pay for a
;;      copy that is not free;
;;   2. the body is call-free -- the pricing clause documented at
;;      opt-inline-blocks-call-free?, which a recursive caller has the most to
;;      lose from: its frame is re-entered per recursion node, so a leaf frame
;;      it stops being is paid for at every one of them. A call-free callee
;;      absorbed into a recursive caller also cannot deepen the recursion;
;;   3. the cascade clause is unchanged: an import that would hand a
;;      bounds-free single-reference caller its first bounds check costs that
;;      caller its own inline, and that trade loses wherever it is made.
;;
;; The cost model is NOT bypassed. This predicate only supplies the bounds-loop
;; disjunct; `inline?` still requires opt-inline-cost-inline? (with the
;; single-reference absorb bonus) to admit the site, so the growth budgets and
;; the heavy gate are exactly the ones every absorption already answers to.
;;
;; The band is set from the measured shape and the structure that makes it
;; safe. `qs-partition` presents here as 105 instructions in 7 blocks: one
;; scan loop, two swaps, no calls. 128 and 8 sit above it with room for the
;; same shape carrying one more block, and far below anything that would bring
;; a second working set into a recursive frame.
;;
;; The admitted population is what the clauses above predict it to be. Across
;; the whole benchmark corpus this tier claims exactly one callee --
;; `qs-partition` -- and across a full opt2 self-compile exactly two:
;; `compiler-ir-function-seq-var-count` and `opt-bit-test-plans-slot`.
;; Measured: opt_quicksort -5.369% on top of the divmod change (436,307,717 ->
;; 409,002,574 with both), every other instruction-count row byte identical,
;; opt1 self-compile -2,230 instructions. The prologue question the recursive
;; caller raises answers the right way on the measured shape: absorbing
;; `qs-partition` takes `qs-sort` from four callee-saved pushes and a
;; 72-byte frame to three and 64, because the absorbed leaf held no live
;; range across a call and the retired argument setup freed a register.
(define (opt-inline-recursive-site-max-body) : i64
  128)

(define (opt-inline-recursive-site-max-blocks) : i64
  8)

;; Ordered cheapest-first: the reference class is an integer already in hand,
;; the size clauses are counts, and only then are the caller's lazy facts
;; forced -- the self-call scan last of all.
(define (opt-inline-recursive-site-absorb-ok?
  [absorb-class : i64]
  [callee-instrs : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (and
    (= absorb-class 1)
    (<= callee-instrs (opt-inline-recursive-site-max-body))
    (<=
      (ir.compiler-ir-block-list-count blocks)
      (opt-inline-recursive-site-max-blocks))
    (opt-inline-blocks-call-free? blocks)
    (opt-inline-bounds-loop-cascade-safe?)
    (opt-inline-caller-recursive?)))

;; --- absorbing a SINGLE-SITE callee at any size -----------------------------
;;
;; Every band above prices a body against a size ceiling, because every band
;; above can be asked to COPY one. The ceilings are growth budgets: 32
;; instructions for the loop tier, 128 for the recursive-site tier, and the cost
;; model's shared block fuel of 32 on top of both. A callee with exactly one
;; static reference is the one shape none of that arithmetic applies to. Its
;; body does not get copied, it MOVES: the site takes it, the original is left
;; unreferenced, and the program's total instruction count after the rewrite is
;; what it was before, minus the call sequence and the prologue that no longer
;; run. There is no growth to bound, so a growth budget is the wrong instrument,
;; and the ceilings it imposes refuse the one class of absorption that is free.
;;
;; What the ceilings were costing is a whole benchmark row. liveness_scan's
;; `ln-recompute!` and `ln-live-out-into!` have exactly one call site each, and
;; clang absorbs both into the fixpoint loop. This compiler kept them out of
;; line, because both carry bounds checks inside loops and are far past the
;; loop tier's 32 and the recursive tier's 128 -- 368 and 217 instructions. They
;; are 14- and 10-parameter functions, so what the boundary costs is not one
;; call: it is 88 instructions of prologue per entry over 140,905 entries, plus
;; the argument marshalling, plus every value in the trio living in a frame slot
;; because it crosses a call boundary that the absorbed form does not have.
;;
;; The size ceiling comes off. Two other clauses go on in its place, and both
;; were put there by measurement, not by symmetry -- the first version of this
;; band asked the reference count and nothing else, and it LOST:
;; liveness_scan 620,776,020 -> 726,936,390, +17.10%, with both target callees
;; confirmed absorbed. The prologue arithmetic that motivated the band is real
;; and it is not the whole account. What it leaves out is that a body absorbed
;; into a LOOP puts its entire working set inside that loop, where the
;; allocator must now keep the loop's own live values across it. Absorbing
;; `ln-recompute!` into the fixpoint worklist loop cost far more in spills
;; inside that loop than the 14-argument boundary ever cost in marshalling.
;;
;; That is the trade this band makes explicit. The loop tier bounds the body
;; and demands an in-loop site: a small body is safe inside a loop, and only an
;; in-loop site repays a boundary worth little. This tier is its exact
;; complement -- it lifts the size bound and demands the opposite site:
;;
;;   1. absorb-class 1 -- exactly one static reference, not address-taken, not
;;      `main`, not a self-call from this caller. This is what makes the move
;;      free. Note that a self-RECURSIVE callee is already excluded by this
;;      number rather than by a separate test: the census counts the callee's
;;      own `Call`/`TailCall` as a reference, so a function with one external
;;      caller and one self-call counts 2 and lands in the duplication class.
;;      Mutual recursion is excluded one level up, where a callee in the
;;      caller's own SCC is refused before any of these predicates run;
;;   2. the boundary is WIDE -- opt-inline-single-site-min-params or more. This
;;      is the band's actual subject. What no size budget prices, and what
;;      absorption retires outright, is argument marshalling, and marshalling
;;      cost scales with ARITY, not with body size. Below the arity where the
;;      ABI runs out of argument registers there is no marshalling to retire,
;;      the boundary is a call and a cheap prologue, and the site-conditioned
;;      tiers above already price it correctly -- including their measured
;;      refusal of once-per-program `init`/`fill` helpers, whose absorption
;;      into a hot-loop-holding caller costs that caller its allocation. This
;;      clause is what keeps those refusals intact;
;;   3. the site is NOT in a natural loop of the caller. An unbounded body may
;;      be moved next to a loop; it may not be moved inside one. This is the
;;      clause the first version lacked, and the 17.10% above is what it costs
;;      to lack it;
;;   4. the heavy gate is kept. It is not a growth budget -- it is the block
;;      count past which the whole-function passes downstream stop running --
;;      so a merged function that would cross it is refused here for the same
;;      reason every other band refuses it. The shared block fuel is NOT kept:
;;      that budget exists to stop a caller from ballooning on copies, and this
;;      band makes no copies. Its blocks are still charged to the shared
;;      accumulator, so the bands that DO grow the caller see the real size;
;;   5. the body is call-free, the same clause the duplication and
;;      recursive-site tiers carry, for the same reason: this band's model
;;      cannot price a callee's own calls (see opt-inline-blocks-call-free?).
;;      Here it is conservatism rather than a mechanism requirement -- a move
;;      makes one copy, not two --
;;      and it costs less than it reads, because SCC order processes callees
;;      before callers, so a chain of single-site functions is absorbed
;;      bottom-up in ONE pass;
;;   6. the cascade clause, asked only when the callee actually carries bounds
;;      checks, because that is the only thing it protects against: handing a
;;      bounds-free single-reference CALLER its first bounds check used to cost
;;      that caller its own inline at the loop tier.
;;
;; Ordered cheapest-first: two integer compares, then arithmetic, then the
;; memoized caller facts, and the scan over the callee's blocks last.
;;
;; On the arity floor below: x86-64 SysV passes six integer arguments in
;; registers and Windows x64 passes four, so at eight parameters BOTH ABIs store
;; surplus arguments to the stack at the call and reload them in the callee --
;; traffic that exists only because the boundary exists, that no body-size
;; budget can see, and that absorption retires completely. Below the floor the
;; boundary is cheap enough that the site-conditioned tiers own the decision.
;; The measured population starts above it: the liveness callees this band was
;; built for present at 10 and 14 parameters, and the only compiler function it
;; claims across a whole self-compile has exactly 8.
(define (opt-inline-single-site-min-params) : i64
  8)

(define (opt-inline-single-site-absorb-ok?
  [absorb-class : i64]
  [has-bounds? : bool]
  [param-count : i64]
  [blocks : ir.CompilerIrBlockList]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (and
    (= absorb-class 1)
    (>= param-count (opt-inline-single-site-min-params))
    (not
      (opt-inline-cost-crosses-heavy-gate?
        caller-blocks
        added-so-far
        added-blocks))
    (not (opt-inline-bounds-loop-site-in-loop?))
    (or (not has-bounds?) (opt-inline-bounds-loop-cascade-safe?))
    (opt-inline-blocks-call-free? blocks)))

(define (opt-inline-multiblock-bounds-loop-ok?
  [has-bounds? : bool]
  [absorbable? : bool]
  [absorb-class : i64]
  [callee-instrs : i64]
  [callee-name : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (or
    (not has-bounds?)
    (opt-inline-bounds-loop-absorb-ok? absorbable? callee-instrs blocks)
    (opt-inline-recursive-site-absorb-ok? absorb-class callee-instrs blocks)
    (opt-inline-tiny-predicate-acyclic-reclaiming? blocks)
    (opt-inline-vm-run-bounds-loop-exception? callee-name)))

;; --- shared acyclic accessors -----------------------------------------------
;;
;; Everything above decides whether a callee BELONGS to its call sites: one
;; reference is absorbed, two are duplicated, and past that the census stops
;; answering. That leaves an entire measured class outside every gate here --
;; the per-element accessor, referenced from everywhere, which C compiles to a
;; single load and which this compiler was keeping behind a call at every one of
;; its sites. peephole_lines spent 431.7M instructions, 40.8% of the row, inside
;; one 27-instruction function reached from 146 call sites.
;;
;; Such an accessor is refused today by exactly one clause. It is acyclic, so
;; the loop gate above already passes it; it carries a bounds check, so
;; opt-inline-bounds-inline-ok? demands that it be absorbable or called with
;; all-constant arguments, and at 146 references it is neither. The cost model
;; would refuse it a second time: block weight 6 prices a nine-block body at
;; 27 + 6 * 10 = 87 against a threshold of 4.
;;
;; Admission is a dedicated disjunct and a cost-gate bypass, NOT an extension of
;; the absorb credit. The distinction is semantic, not stylistic: this callee is
;; not absorbed. It keeps its own body and stays out of line at every site this
;; gate does not take -- 12 of 146 on the measured row -- so claiming the
;; single-reference bonus would assert something false, and that bonus is read
;; by opt-inline-bounds-inline-ok? and by the phi-predecessor suppression as
;; well as by the cost model. A separate predicate states exactly what is true:
;; this shape is admitted on its own terms. It keeps the two structural budgets
;; that bound the growth -- the heavy gate and the per-caller block fuel, the
;; same pair opt-inline-bounds-leaf-cost-inline? keeps -- and those budgets are
;; what turn 146 references into 12 admitted sites and 4104 bytes.
;;
;; Measured: peephole_lines -12.264%, lex_source -0.178%, every other row byte
;; identical, opt2 self-compile -0.0289% (an improvement, on 60 admissions per
;; compile), and no banked duplication evicted anywhere.
(define (opt-inline-shared-accessor-max-body) : i64
  28)

(define (opt-inline-shared-accessor-max-blocks) : i64
  10)

;; What separates the accessors that win from the ones that lose is how often
;; they run, and nothing here can see that. The reference count is the available
;; proxy, and the measured split is wide enough to act on: pl-byte-at is
;; referenced 146 times and pays -12.3% on its row, while cfg-byte-at and
;; gvn-byte-at -- the same shape, same class, same in-loop sites -- are
;; referenced 4 times each and cost +0.771% and +1.571%, because importing a
;; bounds check into the one scan loop that uses them takes cfg-scan-ints from
;; six frame operations to twenty-three and evicts a banked duplication on the
;; way. This floor sits one above that measured loser, the same construction the
;; instruction band uses.
;;
;; The sensitivity curve is flat in both directions and the corpus fixes the
;; number exactly: 3 and 4 admit the two byte-at losers, 5 admits both winners,
;; and 6 through 146 drop ls-digit? (referenced 5 times) and with it the
;; lex_source win, while the opt2 self-compile stays within 0.01% across the
;; whole range. 5 is the only value that takes every measured win and no
;; measured loss.
;;
;; This is the opposite end of the same census the rest of this file uses:
;; absorption wants a callee referenced once, duplication twice, and this path
;; wants one referenced many times.
(define (opt-inline-shared-accessor-min-refcount) : i64
  5)

;; Two of the clauses below are per-SITE questions asked of a callee whose
;; whole admission argument is per-CALLEE, and at the top of the reference
;; distribution they refuse the sites this gate exists to take.
;;
;;   - the in-loop clause. It is the right question for an import that must
;;     repay one caller's boundary: repaid per iteration, or once per program.
;;     But `pl-byte-at` is not imported for one caller -- it is a single load
;;     behind a call at 146 references, and most of its dynamic weight arrives
;;     through straight-line byte predicates (`pl-movq-prefix?`, `pl-single-dest?`,
;;     `pl-mnemonic-call?`, `pl-record-sweep`'s fourteen unrolled probes) that
;;     are themselves called from loops one level up. Measured on
;;     benchmark/typelisp/peephole_lines: 15,308,593 dynamic calls, 186.7M
;;     instructions of self cost, and the sites carrying it are refused by this
;;     clause and nothing else.
;;   - the cascade clause. It stops an import handing a bounds-free
;;     single-reference caller its first bounds check, so that the caller keeps
;;     its own absorption. That trade is priced in absorptions: one boundary
;;     retired against one caller inline lost. `pl-indexed-rsp?` is a
;;     single-reference bounds-free caller whose in-loop sites call pl-byte-at
;;     4,631,694 times -- the largest single site group on the row -- and the
;;     clause refuses all six of them to protect one absorption.
;;
;; So both clauses are conditioned on the callee's total weight, for which the
;; reference count is the same proxy the floor above uses. Above the dominant
;; floor the callee's own dynamic weight is the whole argument and neither
;; per-site question changes the verdict; below it, both stand exactly as they
;; were.
(define (opt-inline-shared-accessor-dominant-min-refcount) : i64
  64)

;; The floor above is a floor on DYNAMIC weight, and the raw reference count was
;; only ever the available proxy for it. `pl-byte-at` clears 64 because it is
;; named 146 times; `gvn-byte-at` and `cfg-byte-at` are the identical shape --
;; one guarded load, three blocks, fourteen instructions -- reached from four
;; sites each, and they run just as often because every one of those sites is
;; inside a scan loop and three of the four are inside a nested one. The static
;; count says 4 and 146; the dynamic counts are 5.0M and 15.3M calls. The proxy
;; is what is wrong, not the floor.
;;
;; So the tier gains a second entrance on the loop-depth-weighted count
;; (opt-inline-census-hot-refcount): the SAME 64, in a currency that counts a
;; reference by how often it is reached rather than by how many times it was
;; typed. Because a depth-0 site still weighs 1, the weighted count is never
;; below the raw one, so every callee that used to enter this tier still enters
;; it on the raw count alone and nothing that was admitted becomes refused.
;;
;; Two clauses keep the new entrance inside the class it was measured on:
;;
;;   - the size ceilings above are untouched. This tier only ever admits a body
;;     of at most opt-inline-shared-accessor-max-body instructions in
;;     opt-inline-shared-accessor-max-blocks blocks, so a hot-by-depth callee
;;     that is not accessor-shaped is refused exactly as before. The tiny leaf
;;     is the class where inlining does not grow the caller's live set enough
;;     to cost a callee-saved push/pop pair per invocation, which is how a
;;     bigger import net-regresses a row.
;;   - opt-inline-shared-accessor-dominant-min-refs: the callee must still be
;;     genuinely SHARED, at least two static references. A single-reference
;;     callee belongs to absorption, which moves its body instead of copying it;
;;     letting one deeply nested site claim a tier whose argument is "many sites
;;     are hot" would claim something false and would spend this tier's fuel on
;;     a case the absorb band already owns.
;;
;; A THIRD CLAUSE STOOD HERE AND IS NOW GONE: the estimated entrance used to
;; additionally require the callee to carry NO bounds check. The argument was
;; the difference between the two counts. A raw reference count is a COUNTED
;; FACT; a depth weight is an ESTIMATE, and its error is unbounded in one
;; direction -- a loop that runs once weighs the same as a loop that runs a
;; million times. So the estimated entrance was granted only where a wrong
;; estimate is cheap, and an imported bounds check was the opposite of cheap:
;; it adds a length load, a compare, a branch and a trap edge inside the
;; caller's hottest loop, and it lengthens the live ranges there. That was not
;; taste, it was measured (#6461): both accessors that reach this tier on
;; weight alone while carrying a bounds check REGRESSED their rows even though
;; every one of their sites is inside a loop -- `gvn-byte-at` (4 references,
;; weight 200) cost gvn_table +1.329% and `cfg-byte-at` (the identical shape)
;; cost cfg_domloops +0.733%. `pl-byte-at` carries a bounds check too and won
;; -12.3% there, but it enters on 146 COUNTED references, not on an estimate,
;; which is exactly why the clause was written against the estimate alone.
;;
;; That autopsy named three mechanisms, and every one of them has since been
;; repaired by work with no connection to this gate:
;;
;;   1. THE IMPORTED GUARD DE-FUSED. The copy's bounds compare was CSE'd with
;;      the caller's own loop test; the shared boolean then had two readers, and
;;      a compare with two readers could not fold into either branch, so the
;;      caller materialised a byte and tested it where it used to branch on
;;      flags. The compare-duplication and flags-reuse branch-emission packets
;;      rematerialise the compare at each branch and emit the branch off the
;;      live flags (compiler-backend-emit-flags-reuse-branch-rest and the
;;      window rule above it), so a second reader no longer costs the first one
;;      its fusion.
;;   2. THE IMPORTED CHECK SURVIVED. The copy landed among checks that already
;;      proved its condition, but the eliminator could only retire a check
;;      against a syntactically identical one. The guard-fact implication
;;      algebra (#6480) folds a dominated compare whose true-set a dominating
;;      fact narrows into, so an equal-or-stronger dominating check now retires
;;      a dominated one; cross-array check-domain fusion (#6485, the section
;;      below) then transfers one array's proven index fact to a second array
;;      under a single loop-entry `Lj <=u Lk`, which is precisely the shape a
;;      byte-at import produces inside a scan loop.
;;   3. THE BASE AND LENGTH SPILLED. The live ranges the import opened across
;;      the loop pushed the caller past its register budget -- cfg-scan-ints
;;      went from six frame operations to twenty-three. The caller-saved rescue
;;      now generalises to whole natural-loop regions (#6485) and the
;;      loop-region eviction machinery extends it to loops whose pool is fully
;;      held, so a loop-carried base or length is split and rescued instead of
;;      left spilled; segment-precise live intervals keep the rescued homes
;;      from being handed out under a hole that is not really dead.
;;
;; With all three repaired the sign flips, and the two callees that the clause
;; was written to exclude are what pay it back. Re-measured on this tree,
;; dropping the clause buys
;;
;;     gvn_table    1,204,946,707 -> 1,185,741,272  (-19,205,435, -1.594%)
;;     cfg_domloops   812,522,536 ->   806,167,611  ( -6,354,925, -0.782%)
;;
;; with the other 20 rows of the corpus byte-identical. The admitted population
;; is exactly the two callees the clause was written against and nothing else:
;; `gvn-byte-at` and `cfg-byte-at`, four sites each, all four taken, and with
;; the last reference gone both leaves are deleted outright. Their callers are
;; the two scan loops the old autopsy indicted, and both now come out AHEAD on
;; allocation -- `cfg-scan-ints` and `gvn-scan-ints` each go from six
;; callee-saved push/pop pairs to five while absorbing four bounds checks, with
;; no stack-slot traffic on either side of the change. No other benchmark in
;; the corpus moves a single call site.
;;
;; Across a full opt2 self-compile the same tier claims four more leaves, all of
;; them one guarded element read: `compiler-reg-remap-id` (20 of its 41 sites),
;; `compiler-live-label-set-ref` (all 11), `ast-decl-list-module-id-at` (all 8)
;; and `opt-scc-set-low-min!` (both). Three of the four lose their last
;; reference and are deleted.
;;
;; The estimate is still an estimate; what changed is that being wrong about one
;; no longer costs anything, because the three mechanisms that made a wrong
;; estimate expensive are gone. The clauses that remain are the ones that bound
;; what a WRONG estimate can drag in -- body size, block count, and genuine
;; sharing -- and those are counted facts, not estimates.
(define (opt-inline-shared-accessor-dominant-min-refs) : i64
  2)

;; The tier verdict, asked identically by the gate and by the caller's fuel
;; accounting so a site admitted here always spends the fuel this tier owns.
(define (opt-inline-shared-accessor-dominant? [refs : i64] [hot-refs : i64]) : bool
  (or
    (>= refs (opt-inline-shared-accessor-dominant-min-refcount))
    (and
      (>= refs (opt-inline-shared-accessor-dominant-min-refs))
      (>= hot-refs (opt-inline-shared-accessor-dominant-min-refcount)))))

;; The dominant tier also gets its own per-caller block fuel, for the same
;; reason the hot-loop-leaf gate has one and with the same accounting: a copy
;; taken here must not spend the fuel the caller's banked single-reference
;; absorptions draw on. It also must not be RATIONED by it. The shared fuel is
;; 32 blocks and this accessor is 10, so a caller could take three copies and
;; no more -- and the measured callers are byte predicates that probe a fixed
;; window: `pl-record-sweep` holds fifteen sites, `pl-single-dest?` eleven,
;; `pl-tail-is-rsp?` four consecutive indices. Stopping at three is the worst
;; of both: the caller pays the growth and still keeps the call, and the
;; consecutive probes never end up in one block where GVN can fold their
;; bounds checks and their two global loads together.
;;
;; 160 blocks is sixteen copies of the widest admitted accessor, which covers
;; every measured caller's full window. It is spent only above the dominant
;; floor, so nothing at five references moves.
(define (opt-inline-shared-accessor-block-fuel) : i64
  160)

;; Ordered by cost: the reference count and the two size caps are integer tests
;; on values the site already has, the budgets are arithmetic, and only then do
;; the three scans run -- call-free over the callee, the memoized caller facts,
;; and last the acyclic check, which builds a CFG index per candidate. The
;; dominant-reference test is free, so it runs before each caller fact and each
;; budget it can change the answer to.
(define (opt-inline-shared-accessor-ok?
  [refs : i64]
  [hot-refs : i64]
  [callee-instrs : i64]
  [blocks : ir.CompilerIrBlockList]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (and
    ;; Either tier's own entry test. The legacy tier keeps its raw-reference
    ;; floor exactly; the dominant tier also opens on weighted references, so a
    ;; callee below the raw floor can still reach it -- and nothing that used to
    ;; be admitted is refused, because the weighted count is never smaller.
    (or
      (>= refs (opt-inline-shared-accessor-min-refcount))
      (opt-inline-shared-accessor-dominant? refs hot-refs))
    (<= callee-instrs (opt-inline-shared-accessor-max-body))
    (<=
      (ir.compiler-ir-block-list-count blocks)
      (opt-inline-shared-accessor-max-blocks))
    (if (opt-inline-shared-accessor-dominant? refs hot-refs)
      (and
        (not
          (opt-inline-cost-crosses-heavy-gate?
            caller-blocks
            (+ added-so-far opt-inline-caller-accessor-blocks)
            added-blocks))
        (<=
          (+ opt-inline-caller-accessor-blocks added-blocks)
          (opt-inline-shared-accessor-block-fuel)))
      (and
        (not
          (opt-inline-cost-crosses-heavy-gate?
            caller-blocks
            added-so-far
            added-blocks))
        (<= (+ added-so-far added-blocks) (opt-inline-cost-block-fuel))
        (opt-inline-bounds-loop-site-in-loop?)
        (opt-inline-bounds-loop-cascade-safe?)))
    (opt-inline-blocks-call-free? blocks)
    (opt-inline-tiny-predicate-acyclic-reclaiming? blocks)))

;; --- branch-chain classifiers ----------------------------------------------
;;
;; The duplication band above prices a callee at `instructions + 6 * blocks`
;; and caps it at 32 instructions in 6 blocks. Block count is the wrong
;; currency for one measured shape: the byte classifier. `ls-space?` is a
;; four-way `or` over one register -- 17 instructions in 9 blocks, every block
;; a compare and a branch -- and `ls-symbol-char?` is the same construction
;; thirteen arms wide, 118 instructions in 57 blocks. Both are refused by the
;; block cap alone, and both run per input byte: 9,377,680 and 12,909,128 calls
;; on benchmark/typelisp/lex_source, where the retired boundary is not just the
;; call and the return but the bool the callee materialises into a register for
;; the site to immediately test. C compiles these to inline bitmask tests.
;;
;; What the block cap is protecting against is a body whose blocks each do
;; work: a merge web brings a second working set into the caller and taxes its
;; allocation. A chain of compare-and-branch blocks over one value brings none.
;; So this gate keeps the instruction budget -- widened, because chain blocks
;; are cheap, not free -- and replaces the block cap with the structural fact
;; that makes blocks cheap: no block in the body holds more than
;; opt-inline-branch-chain-max-block-instrs instructions.
;;
;; Everything else stays as narrow as the bands above:
;;
;;   1. the census claims the callee (absorption at one reference, duplication
;;      at two), so the program grows by at most one extra copy;
;;   2. the body carries no bounds check. This is what lets the gate omit the
;;      cascade clause rather than widen it: opt-inline-bounds-loop-cascade-safe?
;;      exists to stop an import handing a bounds-free single-reference caller
;;      its first bounds check, and a bounds-free callee cannot do that. Both
;;      of the measured lex_source sites are refused today by that clause and
;;      by nothing else it can be read as protecting;
;;   3. the body is call-free -- the pricing clause documented at
;;      opt-inline-blocks-call-free?, which this band needs most of all: it
;;      copies one body into every one of a shared accessor's sites;
;;   4. the site lies in a natural loop of the caller, so the retired boundary
;;      is repaid per iteration rather than once per program;
;;   5. the body is acyclic -- a loop inside a chain is not a chain;
;;   6. the caller does not balloon: the heavy gate is asked about total
;;      growth, and the copy spends this gate's OWN per-caller block fuel, not
;;      the shared accumulator the caller's banked single-reference absorptions
;;      draw on. An import must never evict a banked inline.
(define (opt-inline-branch-chain-max-block-instrs) : i64
  3)

;; The chain band, in instructions. The measured shapes are `ls-space?` at 17
;; instructions in 9 blocks and `ls-symbol-char?` at 118 in 57; 128 sits above
;; the wider one. The per-block cap is what keeps a 128-instruction body from
;; being anything other than a decision chain, and the corpus population it
;; admits is small and entirely of that shape: `doc-html-syntax-space?`,
;; `ctfe-reduce-op-eq`, `lsp-uri-safe-code?`, `doc-render-anchor-char?`.
(define (opt-inline-branch-chain-max-body) : i64
  128)

(define (opt-inline-branch-chain-max-blocks) : i64
  64)

;; Two copies of the largest admitted chain, which is what `ls-tokenize` needs:
;; it holds one `ls-space?` site (10 blocks) and one `ls-symbol-char?` site
;; (58), and rationing it to the first would leave the larger call standing.
(define (opt-inline-branch-chain-block-fuel) : i64
  128)

(define (opt-inline-block-seq-branch-chain-from?
  [seq : ir.CompilerIrBlockSeq]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    true
    (match (ir.compiler-ir-block-seq-ref seq index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (if (<=
          (opt-inline-cost-instrs instrs)
          (opt-inline-branch-chain-max-block-instrs))
          (opt-inline-block-seq-branch-chain-from? seq (+ index 1) count)
          false)])))

;; No block in the body does more than compare-and-branch work. This is the
;; structural fact the cost model's block weight is a proxy for: a body whose
;; blocks are all this small adds no second working set to the caller no matter
;; how many of them there are.
(define (opt-inline-blocks-branch-chain? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (<=
            (opt-inline-cost-instrs instrs)
            (opt-inline-branch-chain-max-block-instrs))
            (opt-inline-blocks-branch-chain? (__tl-box-place rest))
            false)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-block-seq-branch-chain-from?
        seq
        0
        (ir.compiler-ir-block-seq-count seq))]))

;; Ordered by cost: the census class and the bounds flag are values the site
;; already has, the two bands and the two budgets are arithmetic, and only then
;; do the scans run -- call-free and the chain shape over the callee, the
;; memoized caller facts, and last the acyclic check, which builds a CFG index
;; per candidate.
(define (opt-inline-branch-chain-ok?
  [absorb-class : i64]
  [has-bounds? : bool]
  [callee-instrs : i64]
  [blocks : ir.CompilerIrBlockList]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (and
    (>= absorb-class 1)
    (not has-bounds?)
    (<= callee-instrs (opt-inline-branch-chain-max-body))
    (<=
      (ir.compiler-ir-block-list-count blocks)
      (opt-inline-branch-chain-max-blocks))
    ;; The heavy gate is asked about TOTAL caller growth, shared and
    ;; gate-specific alike; the block fuel is this gate's own accumulator.
    (not
      (opt-inline-cost-crosses-heavy-gate?
        caller-blocks
        (+ added-so-far opt-inline-caller-chain-blocks)
        added-blocks))
    (<=
      (+ opt-inline-caller-chain-blocks added-blocks)
      (opt-inline-branch-chain-block-fuel))
    (opt-inline-blocks-call-free? blocks)
    (opt-inline-blocks-branch-chain? blocks)
    (opt-inline-bounds-loop-site-in-loop?)
    (opt-inline-tiny-predicate-acyclic-reclaiming? blocks)))

;; --- hot loop leaves: the call-free cyclic leaf band -------------------------
;;
;; A call-free callee whose body holds a loop, admitted where the bands above
;; refuse it. The measured occupant is gvn_table's hashmap probe,
;; `gvn-facts-slot`: 114 instructions in 29 blocks as the inline stage sees it,
;; call-free, one linear-probe loop, referenced from seven sites in six callers.
;; C inlines the whole chain into one blob; this compiler kept the boundary at
;; all seven, and the row prices the callee at 248.6M dynamic instructions,
;; 18.4% of the benchmark, before any cross-boundary hoisting the barrier
;; blocks.
;;
;; Admission asks, in cost order:
;;
;;   1. the census knows the callee -- at least one reference.
;;
;;      THIS CLAUSE USED TO READ `> opt-inline-dup-max-refcount`: three
;;      references and up, so that absorption (one reference) and duplication
;;      (two) kept the class to themselves and this band began past them. That
;;      was not taste, it was measured. Widening the band to single- and
;;      two-reference callees absorbed the 53-88 instruction loop leaves into
;;      their loop callers -- `it-slice-eq?` and `it-hash-words` into
;;      `it-intern-slice`, the peephole scanner leaves, `qs-checksum` into
;;      `main` -- and regressed intern_table +22%, peephole_lines +14%,
;;      opt_quicksort +6% and cfg_domloops +2%. The mechanism the autopsy named
;;      was CALLER ALLOCATION CHURN: the imported loop brings its own working
;;      set into a caller loop that is already allocating tightly, and what the
;;      copy costs in spills exceeds the boundary it retires.
;;
;;      That mechanism has since been repaired by work with no connection to
;;      this gate, which is why the ceiling is gone:
;;
;;        - LOOP-REGION RESCUE AND SEGMENT-PRECISE INTERVALS (#6485) attack the
;;          named cost directly: an interval that used to hold a register
;;          across a whole loop region is now described by the segments it is
;;          really live in, so a second working set inside a caller loop no
;;          longer prices as if it were live throughout;
;;        - SINGLE-USE LOAD SINKING and DOMINATING-LOAD SUBSTITUTION shorten the
;;          ranges an imported body opens in the first place, which is the same
;;          pressure measured from the other end;
;;        - GUARD-FACT IMPLICATION (#6480) and CHECK-DOMAIN FUSION (#6485)
;;          retire the dominated checks a copied loop lands among, and COMPARE
;;          DUPLICATION with FLAGS-REUSE branch emission keeps the survivors
;;          folded into their branches instead of materialising booleans -- the
;;          de-fusion that used to make an imported guard cost more than it
;;          reads;
;;        - EXIT-JOIN PHI-ESCAPE VERSIONING (6264441d6) lets the versioner keep
;;          an imported loop's checks out of the loop body rather than giving
;;          up on the escape.
;;
;;      Re-measured on this tree, not one of the four historical regressions
;;      reproduces. All 22 rows are non-regressing and five improve:
;;      liveness_scan -1,363,343 (-0.244%), peephole_lines -51,197,
;;      hashmap_grow -647, opt_crc32 -10, opt_quicksort -10; the other 17 rows
;;      are byte-identical. The named historical callees are NOT what moves:
;;      intern_table's assembly is unchanged to the byte, and neither
;;      `qs-checksum` nor the peephole scanner leaves appear in the diff. The
;;      bands below still claim those first, and this band only ever sees the
;;      single- and two-reference sites those bands REFUSE, which is why the
;;      newly BAND-admitted population is four callees across the whole corpus:
;;      `ln-set-count` (liveness_scan), `get-value-or` (hashmap_grow),
;;      `pl-owners-find-reg` (peephole_lines) and stdlib's `>int` (crc32,
;;      quicksort, peephole). Compiler-wide a self-compile retires 62 more call
;;      instructions and absorbs 74 more callees outright.
;;
;;      `>= 1` rather than dropping the clause outright: a zero from the census
;;      means it has no entry for the callee at all (no slot in the function
;;      index), which is not the same fact as "referenced once". Admitting that
;;      is a widening nothing has measured, so the clause keeps the floor it can
;;      justify -- the same floor the measured tier below already asks for
;;      (opt-inline-checked-ok?'s own `>= refs 1`). opt-inline-dup-max-refcount
;;      itself is untouched and still classifies absorption against duplication
;;      for the census, which is the only other thing that reads it.
;;
;;      One interaction is worth recording because it is where the corpus win
;;      comes from. The measured tier is asked only about sites NO band takes,
;;      so every site this clause newly admits leaves that tier's candidate
;;      pool -- and the tier is budgeted in VERDICTS. On liveness_scan the base
;;      tree spent liveness's verdict pricing `ln-set-count` and rejected it;
;;      with `ln-set-count` band-admitted, the freed verdict reaches
;;      `ln-fold-live-in`, which is accepted at both its sites. The row's
;;      -0.244% is that reallocation, not the newly admitted body itself;
;;   2. the body is not address-taken;
;;   3. the caller does not balloon: the copy spends the gate's OWN per-caller
;;      block fuel (opt-inline-hot-loop-leaf-block-fuel), and the heavy gate
;;      is asked about total caller growth. The shared block fuel is
;;      deliberately NOT spent: it is what the caller's banked single-reference
;;      absorptions draw on, and spending it evicted pl-globl-line?'s
;;      absorption out of pl-run-chunk when pl-line-end's copy landed first,
;;      +8.4% on peephole_lines -- an import must never evict a banked inline;
;;   4. the body is call-free -- the pricing clause documented at
;;      opt-inline-blocks-call-free?. This band copies the biggest bodies of
;;      any, into loop sites, so the costs that clause covers land where they
;;      cost most. It is also what separates the admitted leaf from the
;;      historical wide-gate population: ln-live-out-into!, ln-fill-tokens,
;;      ln-count-tokens and byte-buf-copy-slots-range-into all carry calls;
;;   5. the retired boundary is repaid AND the import does not tax a caller
;;      loop's allocation. Measured, those are not the same thing: an in-loop
;;      site repays per iteration, but a body this size brings its own working
;;      set into the caller's loop -- pl-line-end (55 instructions, 20 blocks)
;;      copied into pl-run-chunk's per-line loop (a 34-block caller) nested the
;;      line scan inside it and churned the loop's allocation, +8.4% on
;;      peephole_lines. So the site rule has three tiers: inside the legacy
;;      32/6 band (whose bodies add no second working set, the same shapes the
;;      duplicating gate copies at two references) an in-loop site admits;
;;      above it, an in-loop site admits only into a caller small enough that
;;      the imported loop effectively replaces the caller's body -- the
;;      measured pair is gvn-facts-grow, 13 blocks, whose reinsert loop takes
;;      the probe and wins ~35M, against pl-run-chunk, 34, above; and anywhere
;;      else only a caller with no loop of its own admits, where the imported
;;      loop becomes the caller's only one. gvn-facts-slot's five
;;      straight-line sites are the measured win for the loop-free tier;
;;   6. the cascade clause, unchanged: an import must not hand a bounds-free
;;      single-reference caller its first bounds check;
;;   7. the body is genuinely cyclic: acyclic callees belong to the gates
;;      above, and the forward-edge scan is the same one they run.
;;
;; The big tier's band is set from the measured leaf and the next shapes above
;; it. 120 and 32 take `gvn-facts-slot` (114 instructions in 29 blocks); the
;; shapes just refused are `gvn-scan-ints` (148 in 46, a switch-per-byte
;; scanner whose body is a different working set from its caller's), stdlib
;; `int->string-negative-digit-count` (92 in 37, over on blocks alone), and
;; `ln-live-out-into!` (138, the historical wide-gate size class). A callee
;; copied into some
;; of its sites keeps its own body and stays reachable from the rest: the
;; census is built before the pass and only read during it, so no absorption
;; bookkeeping is needed and none is claimed.
(define (opt-inline-hot-loop-leaf-max-body) : i64
  120)

(define (opt-inline-hot-loop-leaf-max-blocks) : i64
  32)

;; Largest caller that may take a big-tier import at an in-loop site. Set from
;; the measured pair: gvn-facts-grow (13 blocks, the whole caller is the loops
;; the import joins) wins, pl-run-chunk (34 blocks, the import joins a working
;; set an order larger) loses. 16 sits above the winner and below the loser.
(define (opt-inline-hot-loop-leaf-max-caller-blocks) : i64
  16)

;; The per-caller import budget, spent from the gate's own accumulator
;; (opt-inline-caller-hot-loop-blocks), not from the shared block fuel: see
;; that variable's comment for the pl-run-chunk eviction it exists to prevent.
;; 32 blocks is one copy of the largest admitted shape; a caller holding two
;; sites of the same leaf takes the first and keeps the second's call. 64 was
;; measured for root-of-var's second probe copy and loses +0.17% on gvn_table:
;; the second copy's allocation churn exceeds a cold site's boundary saving.
(define (opt-inline-hot-loop-leaf-block-fuel) : i64
  32)

;; The caller has no natural loop of its own. Read off the same lazy caller
;; facts the site clause forces, so a candidate only pays for them once.
(define (opt-inline-caller-loop-free?) : bool
  (begin
    (opt-inline-caller-facts-ensure!)
    (= (opt-label-count (opt-inline-caller-loop-labels-shared-view)) 0)))

(define (opt-inline-hot-loop-leaf-ok?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [callee-name : i64]
  [refs : i64]
  [callee-instrs : i64]
  [blocks : ir.CompilerIrBlockList]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (and
    (>= refs 1)
    (not (opt-inline-census-address-taken? index census callee-name))
    ;; The heavy gate is asked about TOTAL caller growth, shared and
    ;; gate-specific alike; the block fuel is the gate's own accumulator.
    (not
      (opt-inline-cost-crosses-heavy-gate?
        caller-blocks
        (+ added-so-far opt-inline-caller-hot-loop-blocks)
        added-blocks))
    (<=
      (+ opt-inline-caller-hot-loop-blocks added-blocks)
      (opt-inline-hot-loop-leaf-block-fuel))
    (opt-inline-blocks-call-free? blocks)
    ;; The three site tiers of clause 5, cheapest first: the legacy-band
    ;; integer test runs before either lazy caller fact is forced.
    (or
      (and
        (opt-inline-bounds-loop-small? blocks callee-instrs)
        (opt-inline-bounds-loop-site-in-loop?))
      (and
        (<= callee-instrs (opt-inline-hot-loop-leaf-max-body))
        (<=
          (ir.compiler-ir-block-list-count blocks)
          (opt-inline-hot-loop-leaf-max-blocks))
        (or
          (opt-inline-caller-loop-free?)
          (and
            (<= caller-blocks (opt-inline-hot-loop-leaf-max-caller-blocks))
            (opt-inline-bounds-loop-site-in-loop?)))))
    (opt-inline-bounds-loop-cascade-safe?)
    (not (opt-inline-tiny-predicate-acyclic-reclaiming? blocks))))

;; --- the measured-plan check: inline, re-optimize, measure, keep or revert ---
;;
;; Every band above is PREDICTIVE. Each one names a shape, argues from a
;; measured population why that shape's inline pays, and admits it. The
;; campaign's history of inlining regressions is the history of that prediction
;; being wrong in a way no cheap clause could see: the single-site band's first
;; version asked the reference count and nothing else and cost liveness_scan
;; +17.10%, because absorbing a body into a LOOP puts its working set inside
;; that loop; the hot-loop-leaf band's reference clause exists because widening
;; it to one- and two-reference callees cost intern_table +22%, peephole_lines
;; +14% and opt_quicksort +6%.
;;
;; This tier stops predicting. It admits one site per caller from the class the
;; bands refuse -- a multi-block, loop-bearing, call-free callee past every size
;; ceiling at a hot site -- then REBUILDS THE CALLER BOTH WAYS, runs each
;; through the per-function optimizer and the register allocator, prices the two
;; plans, and keeps the inline only if the measured plan says it pays. A refused
;; site restores the caller's banked-band-only rewrite exactly: this is the
;; verifier-gated rollback idiom of opt-inline-repair-or-keep, keyed on the
;; measured plan instead of on structural verification.
;;
;; WHAT THE PLAN PRICES, and why all three terms are needed. Re-measured on this
;; tree, admitting this class predictively costs intern_table +16.3%
;; (616,947,863 -> 717,296,251), lex_source +1.82% and opt_quicksort +1.99%, and
;; pays liveness_scan -0.21%. The autopsy of the intern_table loss is NOT the
;; allocation churn the older bands document: `it-intern-slice` keeps exactly
;; six callee-saved pushes with `it-slice-eq?` absorbed and grows its frame by
;; 16 bytes. What it loses is the loop BCE VERSIONING the standalone callee gets
;; -- `it-slice-eq?` emits a `__bce_guard` plus a bounds-free `__bce_fast` inner
;; loop of seven instructions per byte, and the absorbed copy inside
;; `it-intern-slice` (a function the versioner never versions) runs the guarded
;; form at fifteen. A callee-saved/spill proxy alone reads that inline as free.
;;
;; So the plan is priced in three terms, each measured on the RE-OPTIMIZED body:
;;
;;   1. the loop-depth-weighted instruction count of the optimized blocks. This
;;      is the term that catches an optimization the merged body loses -- a
;;      de-versioned loop, a hoist that no longer fires, a check that no longer
;;      retires -- and it is the only term that sees inside a loop. The weight
;;      ladder is the census's (opt-inline-census-depth-weight), so an
;;      instruction inside one loop counts eight and inside two counts sixty
;;      four, exactly as a reference does;
;;   2. the callee-saved register count of the register allocator's plan, times
;;      two, charged once per invocation: this is the prologue tax, in the
;;      currency the allocator actually decides it in;
;;   3. the allocator's own spill weights, summed over the vars the plan spills.
;;      The weights are the frequency estimates the greedy allocator already
;;      computes, so this term prices spill TRAFFIC rather than spill count.
;;
;; The plan is read WITHOUT emission. compiler-reg-plan-function-scalar is
;; standalone-callable on one IR function (the regalloc self-tests call it that
;; way), and the two facts above are read off its assignment table. The FINAL
;; plan the emitter uses is the product of a four-stage replan/rewrite pipeline
;; inside compiler-backend-emit-function with no extracted entry point, so this
;; is a proxy, not the emitted truth -- but it is the same allocator, run on the
;; same IR, on both sides of one comparison, and nothing downstream reads it.
;; The verdict feeds only accept-or-revert.
;;
;; THE COMPARISON. Both sides are priced per invocation of the caller:
;;
;;   before = plan-cost(banked caller) + w(site) * (boundary + plan-cost(callee))
;;   after  = plan-cost(checked caller)
;;
;; where w(site) is the depth weight of the site's block. Charging the callee's
;; own plan cost times the site weight is what makes the two sides
;; commensurate: a callee loop that weighs eight inside its own body, reached
;; from a site that weighs eight, enters the merged body at depth two where it
;; weighs sixty four -- and 8 * 8 is sixty four. The boundary term is what the
;; inline retires: a call, a return, the callee's frame setup, and the argument
;; marshalling, which is why arity is in it.
;;
;; THE MARGIN. If an inline were free -- the copy exactly as good as the callee,
;; the boundary gone -- `after` would be `before` minus the boundary credit
;; w(site) * boundary. This tier keeps the site only when at least HALF that
;; modelled saving actually survives re-optimization. That is the house's
;; clear-margin discipline stated in the only currency this check has: the model
;; is an estimate on both sides, and an inline whose measured saving is a
;; rounding error against its own predicted saving is exactly the case where the
;; estimate's error, not the inline, decides the verdict.
;;
;; THE BUDGETS are what keep the check's own cost bounded, and they are not
;; taste: this check runs DURING COMPILATION, and it re-optimizes and re-plans
;; the caller twice and the callee once per candidate. opt-inline-checked-
;; program-budget verdicts per program and opt-inline-checked-max-caller-
;; verdicts per caller cap the tier at a fixed number of extra per-function
;; optimizer runs, and every clause above them is an integer test or a scan the
;; bands already run.
;;
;; SITES ARE PRICED ONE AT A TIME, IN SEQUENCE. A caller may hold more than one
;; site of this class, and the fusion prizes are exactly the callers that do --
;; a kernel's inner routine absorbing its comparison leaf AND its hash leaf.
;; Each verdict prices ONE site against the caller's current state, and the
;; state that a verdict keeps or restores is what the next site is priced
;; against. See the round driver (opt-inline-checked-rounds) for why that is the
;; only way one caller can accept one callee and refuse another.
;;
;; ORDERING. The pass is already bottom-up (Tarjan pops a callee's component
;; before any caller's), so a chain is processed leaf-upward with no ordering
;; machinery of this tier's own: by the time a caller is examined, every
;; candidate callee below it is final. That approximates the bottom-up CGSCC
;; order without the SCC scheduling, and it is why the check prices a parent
;; inline against a callee that has already absorbed its own leaves.
;;
;; NO RE-CENSUS is needed between accepted sites. The census is built before the
;; pass and only read during it, and this tier never retires a callee: it copies
;; a body into one site and leaves the original reachable from that site's
;; siblings. Reference counts and hot counts are therefore still exactly what
;; they were when the census was built.
(define (opt-inline-checked-max-body) : i64
  512)

(define (opt-inline-checked-max-blocks) : i64
  64)

;; Composite site frequency floor: the caller's own depth-weighted reference
;; count times the depth weight of the site's block. One weight is 8, so the
;; floor says "the site is reached through at least one loop level", counting a
;; loop in the caller and a loop above the caller alike. A site below it cannot
;; repay a boundary often enough for the check to be worth running.
(define (opt-inline-checked-min-frequency) : i64
  8)

;; ...and the site must be in a natural loop OF THE CALLER, not merely reached
;; through one. This is clause 3 of the loop tier and clause 5 of the hot-loop
;; tier, kept here for the reason those bands keep it and re-confirmed by
;; measurement: a once-per-call setup helper absorbed into a caller that HOLDS a
;; hot loop pays that caller's whole allocation to retire a boundary worth one
;; execution. The measured case is `cfg-build-csr` into `cfg-function` -- a
;; seven-parameter builder at a straight-line site, admitted by the plan model
;; with a modelled saving of 23 against a boundary of 13, and costing
;; cfg_domloops +1.085%. The plan model cannot see it: the tax lands on the
;; caller's LOOPS, whose register pressure the merged body raises, and the plan
;; prices an allocation once per invocation.
;;
;; The frequency floor above is subsumed by this clause on the caller's own
;; loops (a depth-1 site already weighs 8), and remains the clause that
;; disqualifies an in-loop site inside a caller nothing ever reaches.
(define (opt-inline-checked-min-site-depth) : i64
  1)

;; VERDICTS per program, not accepts. This is the tier's compile-time bound and
;; it has to count the work, which a cap on accepts does not: a rejected
;; candidate costs exactly what an accepted one costs -- one extra walk of the
;; caller, three per-function optimizer runs and three allocation plans -- and a
;; cap that refunded rejections would leave the work unbounded on a program with
;; many candidates. Twenty-four verdicts is the whole tier's budget for one
;; compilation. No benchmark in the corpus reaches it; a self-compile does, and
;; that is the point.
(define (opt-inline-checked-program-budget) : i64
  24)

;; ...and per CALLER, because the sites are priced in sequence and one caller
;; would otherwise be able to drain the program's whole budget: a caller holding
;; nine candidates would spend a verdict apiece and leave every later caller
;; unmeasured. Four is what the measured fusion chains need -- an interner
;; absorbing a comparison leaf and a hash leaf, each reachable through one
;; helper -- with a round to spare.
(define (opt-inline-checked-max-caller-verdicts) : i64
  4)

;; How many candidate sites one caller's SCAN walk ranks. Only the richest
;; opt-inline-checked-max-caller-verdicts of them can ever be priced, so the
;; table only has to be deep enough that the richest are certainly in it; past
;; that, a longer table is a longer linear scan for nothing.
(define (opt-inline-checked-scan-cap) : i64
  8)

;; The retired boundary, per call: the call and the return, the callee's frame
;; setup, and one argument move per parameter.
(define (opt-inline-checked-boundary-cost [np : i64]) : i64
  (+ 6 np))

;; A candidate's RICHNESS, which is the order the caller's sites are priced in.
;;
;; The numerator is what a free inline of the site would be worth: how often the
;; site runs times what its boundary costs. The denominator is the BODY the site
;; would copy, and it is there because the sites of one caller compete for a
;; shared allowance -- opt-inline-checked-max-blocks caps this tier's total
;; growth in a caller, so the order the sites are offered in decides which of
;; them still fit. Worth per unit of that allowance is the greedy a shared
;; ceiling makes correct.
;;
;; Measured twice over. The interner this tier exists for holds three candidates
;; in one routine that are worth exactly the same by the numerator alone (each
;; an in-loop site of a six-parameter callee: 96 apiece), so the numerator alone
;; leaves the order to the block walk -- which put a 35-block, 276-instruction
;; grow routine first and the 59-instruction comparison leaf last, where 49 of
;; the 64 blocks were spent and the leaf needed 16. And lex_source's tokenizer
;; holds four, of which only the 56-instruction digit test repays: by the
;; numerator alone it ranks last behind three larger scanners, and every one of
;; those is refused -- under the one-site cap the tokenizer's whole chance was
;; spent on the first of them. Ranking by worth per instruction copied puts the
;; digit test first and takes it: lex_source -1.16%.
;;
;; The scale keeps the ratio in integers with enough resolution that two sites
;; differing only slightly in body size still order.
(define (opt-inline-checked-richness
  [frequency : i64]
  [np : i64]
  [callee-instrs : i64]) : i64
  (/
    (* 64 (* frequency (opt-inline-checked-boundary-cost np)))
    (if (< callee-instrs 1)
      1
      callee-instrs)))

(define opt-inline-checked-active? : bool
  false)
(define opt-inline-checked-budget : i64
  0)

;; SCAN or TARGET, the two modes a caller walk runs in. A scan walk admits no
;; new site -- so its result is exactly the caller's banked-band-only rewrite,
;; the baseline the first verdict is priced against -- and records every
;; candidate it passes over. A target walk admits the sites already kept plus
;; the one new site named by the target key below.
(define opt-inline-checked-scanning? : bool
  true)

;; The target key: (callee name, caller block label, site position), the same
;; triple a site prefix is built from, so it names ONE call site of ONE callee
;; in the caller. A target walk admits the site that matches it and no other.
(define opt-inline-checked-target-callee : i64
  0)
(define opt-inline-checked-target-block : i64
  0)
(define opt-inline-checked-target-pos : i64
  (- 0 1))

;; The ACCEPTED table: the caller's sites that have already been priced and
;; kept, three columns per row (callee name, block label, site position), room
;; for opt-inline-checked-max-caller-verdicts rows.
(define opt-inline-checked-accepted : (__tl_dyn-array i64)
  (array.make-array i64 12))
(define opt-inline-checked-accepted-count : i64
  0)

;; The SCAN table: one row per candidate the scan walk found, four columns --
;; callee name, block label, site position, and the site's RICHNESS, which is
;; what a free inline of it would be worth (how often the site runs times what
;; its boundary costs). Room for opt-inline-checked-scan-cap rows. A row whose
;; richness has been set negative has already been armed as a target.
(define opt-inline-checked-scan : (__tl_dyn-array i64)
  (array.make-array i64 32))
(define opt-inline-checked-scan-count : i64
  0)

;; Verdicts spent on the caller being walked, against the per-caller cap.
(define opt-inline-checked-caller-verdicts : i64
  0)

;; Set by the admission test to say which kind of site it just admitted: a NEW
;; candidate, which consumes the walk's one new-site slot, or a re-admission of
;; an already-accepted site, which does not.
(define opt-inline-checked-new-site? : bool
  false)

;; The plan cost of the state a verdict leaves behind -- the accepted body's
;; cost when it keeps, the previous state's when it reverts -- so the next round
;; prices its site against a baseline it does not have to re-optimize. Negative
;; means "not known", which is what the first round starts from.
(define opt-inline-checked-next-state-cost : i64
  (- 0 1))
(define opt-inline-caller-checked-blocks : i64
  0)
(define opt-inline-caller-checked-taken? : bool
  false)
(define opt-inline-checked-site-weight : i64
  0)

;; The site's RAW loop depth, kept alongside its weight because the callee's
;; body has to be priced at the depth it would land at, not at the product of
;; two weights. The weight ladder saturates at opt-inline-census-depth-cap;
;; multiplying a site weight by an internal weight does not, so a callee loop
;; one level down from a site one level down would be charged 8 * 64 on the
;; `before` side against 64 on the `after` side, and every such candidate would
;; be accepted on the arithmetic alone.
(define opt-inline-checked-site-depth : i64
  0)
(define opt-inline-checked-callee-slot : i64
  (- 0 1))
(define opt-inline-checked-callee-params : i64
  0)

;; Per-program state reset, run by the level-2 inline driver before the SCC
;; walk. It resets the budget and the per-caller flags but does NOT arm the
;; tier: arming is a separate act performed by the whole-program optimizer
;; entries alone (opt-inline-checked-set-active!).
;;
;; That split is deliberate. opt-inline-program-functions is also the optimizer
;; unit tests' direct entry, and a large family of those tests asserts what the
;; BANDS do -- which sites each band refuses and why. A refusal test for one
;; band should hold that band's admission fixed; it should not silently also
;; assert that no later admitter, arguing from a measurement rather than from a
;; shape, ever takes the same site. Arming at the optimizer entries keeps every
;; band fixture testing its band, and keeps the tier live on every path that
;; actually compiles a program.
;; Per-caller reset, run by the walk entries before a caller's scan walk. It
;; empties the accepted and scan tables, returns the tier to scan mode and
;; refunds the per-caller verdict allowance.
(define (opt-inline-checked-caller-begin!) : unit
  (begin
    (set! opt-inline-checked-accepted-count 0)
    (set! opt-inline-checked-scan-count 0)
    (set! opt-inline-checked-caller-verdicts 0)
    (set! opt-inline-checked-scanning? true)))

(define (opt-inline-checked-program-begin!) : unit
  (begin
    (set! opt-inline-checked-budget (opt-inline-checked-program-budget))
    (set! opt-inline-caller-checked-taken? false)
    (opt-inline-checked-caller-begin!)))

;; Arm (or disarm) the tier. The whole-program optimizer entries arm it; a
;; fixture disarms it to assert the banked-band-only rewrite against the
;; measured one over the same input.
(define (opt-inline-checked-set-active! [on : bool]) : unit
  (set! opt-inline-checked-active? on))

(define (opt-inline-checked-armed?) : bool
  opt-inline-checked-active?)

;; What is left of the verdict budget. A program whose sites all belong to a
;; band never spends any of it, which is how a fixture asserts that a
;; band-admitted site never reaches the check.
(define (opt-inline-checked-budget-current) : i64
  opt-inline-checked-budget)

;; Verdicts spent on, and sites kept in, the caller most recently walked. Both
;; are what a fixture reads to assert the SEQUENCE: how many sites one caller
;; was allowed to price, and how many of them survived their own verdict.
(define (opt-inline-checked-caller-verdicts-current) : i64
  opt-inline-checked-caller-verdicts)

(define (opt-inline-checked-accepted-current) : i64
  opt-inline-checked-accepted-count)

;; --- the per-site key tables ------------------------------------------------
(define (opt-inline-checked-accepted-row-eq?
  [base : i64]
  [callee-name : i64]
  [block-label : i64]
  [site-pos : i64]) : bool
  (and
    (= (array-ref opt-inline-checked-accepted base) callee-name)
    (= (array-ref opt-inline-checked-accepted (+ base 1)) block-label)
    (= (array-ref opt-inline-checked-accepted (+ base 2)) site-pos)))

(define (opt-inline-checked-accepted-from?
  [callee-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [row : i64]) : bool
  (if (>= row opt-inline-checked-accepted-count)
    false
    (if (opt-inline-checked-accepted-row-eq?
      (* row 3)
      callee-name
      block-label
      site-pos)
      true
      (opt-inline-checked-accepted-from?
        callee-name
        block-label
        site-pos
        (+ row 1)))))

;; Is this site one the caller already priced and kept?
(define (opt-inline-checked-accepted?
  [callee-name : i64]
  [block-label : i64]
  [site-pos : i64]) : bool
  (and
    (> opt-inline-checked-accepted-count 0)
    (opt-inline-checked-accepted-from? callee-name block-label site-pos 0)))

;; Is this site the ONE new site the current target walk may admit?
(define (opt-inline-checked-target-match?
  [callee-name : i64]
  [block-label : i64]
  [site-pos : i64]) : bool
  (and
    (= callee-name opt-inline-checked-target-callee)
    (= block-label opt-inline-checked-target-block)
    (= site-pos opt-inline-checked-target-pos)))

;; The armed target, for a fixture that drives the sequence by hand.
(define (opt-inline-checked-target-callee-current) : i64
  opt-inline-checked-target-callee)

(define (opt-inline-checked-target-pos-current) : i64
  opt-inline-checked-target-pos)

(define (opt-inline-checked-scan-record!
  [callee-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [richness : i64]) : unit
  (if (>= opt-inline-checked-scan-count (opt-inline-checked-scan-cap))
    unit
    (let
      [base : i64 (* opt-inline-checked-scan-count 4)]
      (begin
        (set! (array-ref opt-inline-checked-scan base) callee-name)
        (set! (array-ref opt-inline-checked-scan (+ base 1)) block-label)
        (set! (array-ref opt-inline-checked-scan (+ base 2)) site-pos)
        (set! (array-ref opt-inline-checked-scan (+ base 3)) richness)
        (set! opt-inline-checked-scan-count (+ opt-inline-checked-scan-count 1))))))

;; ONE CALLEE PER CALLER, and it is a measured rule rather than a budget.
;;
;; A caller's later sites are restricted to the callee its first ACCEPT named.
;; The sequence's wins across the corpus are all one body landing at the several
;; sites that share it -- a map lookup at two probe sites of one caller
;; (hashmap_get -11.40%), a line copy at two sites of a chunk runner -- and its
;; losses are all a caller absorbing DIFFERENT bodies: a sort harness taking a
;; fill loop and then a checksum loop (opt_quicksort +2.01%), an interner taking
;; a map insert and then a hash (intern_table +1.60%). The mechanism is the one
;; the site-depth clause already records: the plan prices an allocation once per
;; invocation and cannot see the tax a merged body lays on the caller's OTHER
;; loops. Two copies of one body make one demand on the caller's frame twice
;; over; two different bodies make two independent demands, and the second is
;; what pushes the caller's own loops into spilling.
;;
;; A refused candidate does not claim the caller: only an accept does.
(define (opt-inline-checked-callee-allowed? [callee-name : i64]) : bool
  (or
    (= opt-inline-checked-accepted-count 0)
    (= (array-ref opt-inline-checked-accepted 0) callee-name)))

;; The richest allowed row still unarmed, or -1. Ties go to the earlier row, so
;; the ordering is the scan's walk order refined by richness and never depends
;; on anything but the caller's own text.
(define (opt-inline-checked-scan-best-from
  [row : i64]
  [best : i64]
  [best-richness : i64]) : i64
  (if (>= row opt-inline-checked-scan-count)
    best
    (let
      [base : i64 (* row 4)]
      [richness : i64 (array-ref opt-inline-checked-scan (+ base 3))]
      (if (and
        (> richness best-richness)
        (opt-inline-checked-callee-allowed?
          (array-ref opt-inline-checked-scan base)))
        (opt-inline-checked-scan-best-from (+ row 1) row richness)
        (opt-inline-checked-scan-best-from (+ row 1) best best-richness)))))

;; Arm the next round's target: the richest candidate the caller has left, if
;; the caller and the program can still afford a verdict. The row is spent here
;; rather than at the verdict, so a target the current state can no longer place
;; is never retried.
(define (opt-inline-checked-arm-next-target!) : bool
  (if (or
    (>=
      opt-inline-checked-caller-verdicts
      (opt-inline-checked-max-caller-verdicts))
    (<= opt-inline-checked-budget 0))
    false
    (let
      [row : i64 (opt-inline-checked-scan-best-from 0 (- 0 1) 0)]
      (if (< row 0)
        false
        (let
          [base : i64 (* row 4)]
          (begin
            (set!
              opt-inline-checked-target-callee
              (array-ref opt-inline-checked-scan base))
            (set!
              opt-inline-checked-target-block
              (array-ref opt-inline-checked-scan (+ base 1)))
            (set!
              opt-inline-checked-target-pos
              (array-ref opt-inline-checked-scan (+ base 2)))
            (set! (array-ref opt-inline-checked-scan (+ base 3)) (- 0 1))
            (set! opt-inline-checked-scanning? false)
            true))))))

;; Move the armed target into the accepted table: from here on every walk of
;; this caller rebuilds the site.
(define (opt-inline-checked-accept-target!) : unit
  (if (>=
    opt-inline-checked-accepted-count
    (opt-inline-checked-max-caller-verdicts))
    unit
    (let
      [base : i64 (* opt-inline-checked-accepted-count 3)]
      (begin
        (set!
          (array-ref opt-inline-checked-accepted base)
          opt-inline-checked-target-callee)
        (set!
          (array-ref opt-inline-checked-accepted (+ base 1))
          opt-inline-checked-target-block)
        (set!
          (array-ref opt-inline-checked-accepted (+ base 2))
          opt-inline-checked-target-pos)
        (set!
          opt-inline-checked-accepted-count
          (+ opt-inline-checked-accepted-count 1))))))

(define (opt-inline-checked-spend-verdict!) : unit
  (begin
    (set! opt-inline-checked-budget (- opt-inline-checked-budget 1))
    (set!
      opt-inline-checked-caller-verdicts
      (+ opt-inline-checked-caller-verdicts 1))))

;; The loop depth of the caller block the walk is standing in, as a census
;; weight. Built from the caller's current blocks with the census's own
;; back-edge depth estimate; the label-to-position scan is linear and only a
;; candidate that has already cleared every integer clause pays for it.
(define (opt-inline-checked-block-weight-from
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [position : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label _)
          (if (= block-label label)
            (opt-inline-census-depth-at position)
            (opt-inline-checked-block-weight-from
              (__tl-box-place rest)
              label
              (+ position 1)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-checked-block-weight-from
        (ir.compiler-ir-block-seq-to-list seq)
        label
        position)]))

(define (opt-inline-checked-site-depth-now) : i64
  (let
    [blocks : ir.CompilerIrBlockList
      (opt-inline-caller-facts-blocks-shared-view)]
    (begin
      (opt-inline-census-depths-build! blocks)
      (opt-inline-checked-block-weight-from
        blocks
        opt-inline-current-block-label
        0))))

(define (opt-inline-checked-site-frequency
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [site-weight : i64]) : i64
  (let
    [caller-hot : i64
      (opt-inline-census-hot-refcount index census opt-inline-caller-name)]
    (*
      site-weight
      (if (< caller-hot 1)
        1
        caller-hot))))

;; An ALREADY-ACCEPTED site skips every clause below. Its growth was priced in
;; the round that kept it, and the two clauses that could refuse it now -- the
;; block ceiling and the heavy gate, both of which count this tier's own blocks
;; -- have only tightened since, because the accepted sites' blocks are exactly
;; what they count. Re-refusing one would drop a kept inline out of the state
;; the next verdict is priced against, and that verdict would then be pricing
;; two changes rather than one, which is the whole thing this tier exists to
;; avoid.
;;
;; A NEW candidate is ordered cheapest-first: the tier's own state and the
;; target key, then the integer size clauses, then the growth budgets, and last
;; the site weight, which builds a depth table over the caller. In scan mode the
;; last step RECORDS the site and refuses it; in target mode it admits the one
;; site the round is pricing.
;;
;; THERE IS NO CALL-FREE CLAUSE HERE, and the omission is the point. The static
;; bands carry one (see opt-inline-blocks-call-free?) because their models price
;; a callee by its instruction and block counts and a callee's own calls cost
;; things those counts cannot carry. This tier does not price a body by counting
;; it: it rebuilds the caller with the site, re-plans the merged function through
;; a real register allocation, and keeps the site only when the measured saving
;; lands inside the accept window. A callee's calls are inside everything it
;; measures -- the merged caller's prologue, its callee-saved set and its spill
;; traffic all move when an imported call takes the caller's leaf frame away --
;; so the clause would only be refusing candidates the check is already able to
;; refuse. Measured on this tree, dropping it leaves all twenty-two
;; instruction-count rows byte identical and hands the check thirteen new
;; candidates across the corpus, of which it accepts five and reverts the rest.
(define (opt-inline-checked-ok?
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [callee-name : i64]
  [refs : i64]
  [callee-instrs : i64]
  [np : i64]
  [blocks : ir.CompilerIrBlockList]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [site-pos : i64]) : bool
  (if (not opt-inline-checked-active?)
    false
    (if (opt-inline-checked-accepted?
      callee-name
      opt-inline-current-block-label
      site-pos)
      (begin
        (set! opt-inline-checked-new-site? false)
        true)
      (and
        (not opt-inline-caller-checked-taken?)
        (> opt-inline-checked-budget 0)
        (<
          opt-inline-checked-caller-verdicts
          (opt-inline-checked-max-caller-verdicts))
        (or
          opt-inline-checked-scanning?
          (opt-inline-checked-target-match?
            callee-name
            opt-inline-current-block-label
            site-pos))
        (opt-inline-checked-callee-allowed? callee-name)
        (>= refs 1)
        (<= callee-instrs (opt-inline-checked-max-body))
        (<=
          (ir.compiler-ir-block-list-count blocks)
          (opt-inline-checked-max-blocks))
        (not (opt-inline-census-address-taken? index census callee-name))
        ;; The heavy gate is asked about TOTAL caller growth, this tier's blocks
        ;; included; the block ceiling above is also this tier's own fuel, so a
        ;; checked import never spends the fuel the caller's banked absorptions
        ;; draw on.
        (not
          (opt-inline-cost-crosses-heavy-gate?
            caller-blocks
            (+ added-so-far opt-inline-caller-checked-blocks)
            added-blocks))
        (<=
          (+ opt-inline-caller-checked-blocks added-blocks)
          (opt-inline-checked-max-blocks))
        (let
          [site-depth : i64 (opt-inline-checked-site-depth-now)]
          [site-weight : i64 (opt-inline-census-depth-weight site-depth)]
          [frequency : i64
            (opt-inline-checked-site-frequency index census site-weight)]
          (if (and
            (>= site-depth (opt-inline-checked-min-site-depth))
            (>= frequency (opt-inline-checked-min-frequency)))
            (if opt-inline-checked-scanning?
              ;; RICHNESS: what a free inline of this site would be worth --
              ;; how often the site runs times what its boundary costs. It is
              ;; the `boundary` term of the verdict itself, scaled by the
              ;; caller's own hot reference count, which is the only ranking
              ;; that puts the biggest claim in front of the smallest state.
              (begin
                (opt-inline-checked-scan-record!
                  callee-name
                  opt-inline-current-block-label
                  site-pos
                  (opt-inline-checked-richness frequency np callee-instrs))
                false)
              (begin
                (set! opt-inline-checked-site-depth site-depth)
                (set! opt-inline-checked-site-weight site-weight)
                (set! opt-inline-checked-callee-params np)
                (set!
                  opt-inline-checked-callee-slot
                  (match (opt-function-index-slot index callee-name)
                    [(option_i64.Some slot) slot]
                    [(option_i64.None) (- 0 1)]))
                (set! opt-inline-checked-new-site? true)
                true))
            false))))))

;; --- pricing one function's plan --------------------------------------------
(define (opt-inline-checked-weighted-instrs-from
  [blocks : ir.CompilerIrBlockList]
  [offset : i64]
  [position : i64]
  [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-inline-checked-weighted-instrs-from
            (__tl-box-place rest)
            offset
            (+ position 1)
            (+
              acc
              (*
                (opt-inline-census-depth-weight
                  (+ offset (opt-inline-census-depth-at position)))
                (ir.compiler-ir-instr-seq-count instrs))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-checked-weighted-instrs-from
        (ir.compiler-ir-block-seq-to-list seq)
        offset
        position
        acc)]))

;; `offset` is the loop depth the body would sit at in its caller. Zero prices a
;; body where it stands; the site's depth prices a callee's body where the
;; inline would put it, which is the only reading under which the two sides of
;; the comparison stay in the same currency once the weight ladder saturates.
(define (opt-inline-checked-weighted-instrs-at
  [func : ir.CompilerIrFunction]
  [offset : i64]) : i64
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (begin
        (opt-inline-census-depths-build! blocks)
        (opt-inline-checked-weighted-instrs-from blocks offset 0 0))]))

;; Callee-saved integer registers the plan homes a value in, read straight off
;; the assignment table against the ABI's own callee-saved list, so no backend
;; emission state is involved. The ABI is fixed to Linux on purpose: an
;; admission verdict feeds codegen, and codegen must not depend on the target.
(define (opt-inline-checked-csr-count-from
  [assignments : reg.CompilerRegAssignmentTable]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-inline-checked-csr-count-from
      assignments
      (+ index 1)
      count
      (+
        acc
        (if (reg.compiler-reg-assignments-use-register?
          assignments
          (cabi.compiler-abi-callee-saved-gp-register-id
            (cabi.CompilerRegTargetAbi.Linux)
            index))
          1
          0)))))

(define (opt-inline-checked-spill-cost-from
  [assignments : reg.CompilerRegAssignmentTable]
  [weights : (__tl_dyn-array i64)]
  [var : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= var count)
    acc
    (opt-inline-checked-spill-cost-from
      assignments
      weights
      (+ var 1)
      count
      (+
        acc
        (match (reg.compiler-reg-assignment-lookup assignments var)
          [(reg.CompilerRegMaybeLocation.Some location)
            (match location
              [(reg.CompilerRegLocation.Spill _)
                (if (< var (array-length weights))
                  (array-ref weights var)
                  0)]
              [_ 0])]
          [(reg.CompilerRegMaybeLocation.No) 0])))))

;; The plan is read STANDALONE: this tier runs the allocator on one IR function
;; from inside the optimizer, and the backend of this compile has not run yet.
;; The allocator's program maps -- aggregate group word counts, their SSE class
;; masks, and the private-memory C call names -- are facts about the IMAGE the
;; backend is emitting, installed from its program index and owned by that
;; image's arena. A standalone plan has no image, so those queries must answer
;; the way they answer in a fresh process: missing.
;;
;; That is not merely tidy. `compile --batch` reuses one process across entries,
;; so on the second entry onward those globals still name the PREVIOUS entry's
;; arena, which has been torn down -- and this tier is the first reader in the
;; compile that reaches them, arriving before the backend re-installs. Reading
;; them there dereferences freed storage: it segfaulted the build-invariance
;; corpus on generated_hashmap_global_mutation, the third entry of its first
;; opt2 chunk, inside compiler-reg-type-register-group?. Suppressing the maps
;; for the duration of the measurement gives every entry the answers the first
;; entry already gets, so the verdict stops depending on batch position as well.
(define (opt-inline-checked-alloc-cost [func : ir.CompilerIrFunction]) : i64
  (let
    [_suppress-image-maps : unit (reg.compiler-reg-suppress-program-maps! true)]
    [plan : reg.CompilerRegPlan (reg.compiler-reg-plan-function-scalar func)]
    [assignments : reg.CompilerRegAssignmentTable
      (reg.compiler-reg-plan-assignments plan)]
    [weights : (__tl_dyn-array i64)
      (reg.compiler-reg-function-spill-weights func)]
    [vars : i64
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    [cost : i64
      (+
        (*
          2
          (opt-inline-checked-csr-count-from
            assignments
            0
            (cabi.compiler-abi-callee-saved-gp-register-count
              (cabi.CompilerRegTargetAbi.Linux))
            0))
        (opt-inline-checked-spill-cost-from assignments weights 0 vars 0))]
    [_restore-image-maps : unit (reg.compiler-reg-suppress-program-maps! false)]
    cost))

;; `offset` and `entry-weight` place the body: `offset` is the loop depth its
;; instructions would sit at, and `entry-weight` is how often the body is
;; entered, which is what the prologue and the spill traffic pay per entry.
;; The check's optimizer runs are MEASUREMENTS, not pipeline stages: their
;; results are thrown away and only a bool escapes. So the developer
;; observability hooks are silenced around them. Leaving them live would make
;; `--trace-passes` report passes over functions the pipeline never optimized
;; and would push throwaway generations into the `--dump-ir` buffer, which is
;; what scripts/verify-ir-observability.sh reads.
(define (opt-inline-checked-plan-cost-at
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [offset : i64]
  [entry-weight : i64]) : i64
  (let
    [saved-verify : bool compiler-opt-debug-verify-ir]
    [_silence : unit
      (begin
        (compiler-opt-debug-set-suppressed! true)
        (set! compiler-opt-debug-verify-ir false))]
    [optimized : ir.CompilerIrFunction
      (optimize-function-with-level pools type-segment-bases func 2)]
    [_restore : unit
      (begin
        (compiler-opt-debug-set-suppressed! false)
        (set! compiler-opt-debug-verify-ir saved-verify))]
    (+
      (opt-inline-checked-weighted-instrs-at optimized offset)
      (* entry-weight (opt-inline-checked-alloc-cost optimized)))))

(define (opt-inline-checked-plan-cost
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : i64
  (opt-inline-checked-plan-cost-at pools type-segment-bases func 0 1))

;; The accept window, named so it can be pinned on its own. `saving` is the
;; modelled cost the inline removes; `boundary` is what a free inline would
;; remove. See opt-inline-checked-verdict for why the window is two-sided.
(define (opt-inline-checked-window-ok? [saving : i64] [boundary : i64]) : bool
  (and (>= (* 2 saving) boundary) (<= saving (* 2 boundary))))

;; The verdict. Both sides priced per invocation of the caller; see the tier
;; comment for the model and the margin.
;;
;; `banked-cost-in` is the priced state's cost when a previous round in this
;; caller already computed it -- the sequence prices site after site against
;; states it built itself, and re-optimizing a function this tier has already
;; optimized to read the same integer back is a third of the check's cost for
;; nothing. Negative means "not known". Whichever cost the verdict settles on
;; for the state it leaves behind is published for the next round.
(define (opt-inline-checked-verdict
  [type-segment-bases : i64]
  [checked : ir.CompilerIrFunction]
  [banked : ir.CompilerIrFunction]
  [callee : ir.CompilerIrFunction]
  [site-depth : i64]
  [site-weight : i64]
  [np : i64]
  [banked-cost-in : i64]) : bool
  (let
    [pools : ast.AstNodePoolContext (ast.ast-node-pool-reader-context-current)]
    [after : i64
      (opt-inline-checked-plan-cost pools type-segment-bases checked)]
    [banked-cost : i64
      (if (>= banked-cost-in 0)
        banked-cost-in
        (opt-inline-checked-plan-cost pools type-segment-bases banked))]
    ;; The callee priced where the inline would put it: its instructions at the
    ;; site's depth, its prologue and its spill traffic once per site
    ;; execution.
    [callee-cost : i64
      (opt-inline-checked-plan-cost-at
        pools
        type-segment-bases
        callee
        site-depth
        site-weight)]
    [boundary : i64 (* site-weight (opt-inline-checked-boundary-cost np))]
    [before : i64 (+ banked-cost (+ boundary callee-cost))]
    ;; A TWO-SIDED window, not a threshold. A free inline -- the copy exactly as
    ;; good as the callee, the boundary gone -- predicts a saving of exactly
    ;; `boundary`. The lower bound is the ordinary demand that at least half
    ;; that saving survives re-optimization. The UPPER bound is what the
    ;; measured corpus forced, and it is a statement about the model rather than
    ;; about inlining: both sides are priced through a loop-depth estimate that
    ;; reads back edges in BLOCK ORDER, and inlining is precisely the rewrite
    ;; that reorders a caller's blocks, so the two sides stop being measured in
    ;; the same currency exactly when the merged body's shape changes most. A
    ;; modelled saving many times what a free inline can produce is evidence of
    ;; that, not evidence of a brilliant merge -- and every one of the campaign's
    ;; documented losers presents that way here: `pl-line-end` into
    ;; `pl-drop-fallthrough` models a saving of 1,193 against a boundary of 64
    ;; and measures +6.3% on peephole_lines; `recompute!` into `fixpoint!` models
    ;; 972 against 160 and measures +2.5% on liveness_scan; `cfg-loop-body` into
    ;; `cfg-natural-loops` models 2,698 against 832 and measures +0.7%.
    ;;
    ;; So the tier keeps a site only when the model AGREES with the free-inline
    ;; prediction to within a factor of two in both directions. Where it does
    ;; not, the model is not trusted in either direction and the site reverts.
    ;; This is the clear-margin discipline read as a confidence interval, which
    ;; is the only honest reading of a two-sided estimate.
    [keep? : bool (opt-inline-checked-window-ok? (- before after) boundary)]
    [_publish : unit
      (set!
        opt-inline-checked-next-state-cost
        (if keep?
          after
          banked-cost))]
    keep?))

;; The check allocates three optimizer generations and three allocation plans
;; per candidate and reads one bool out of them. Run it in the inline stage's
;; verify scratch arena and rewind, exactly as the structural verifier does, so
;; none of that survives into the program arena.
(define (opt-inline-checked-verdict-reclaiming
  [type-segment-bases : i64]
  [checked : ir.CompilerIrFunction]
  [banked : ir.CompilerIrFunction]
  [callee : ir.CompilerIrFunction]
  [site-depth : i64]
  [site-weight : i64]
  [np : i64]
  [banked-cost-in : i64]) : bool
  (if (= opt-inline-verify-scratch-arena 0)
    (opt-inline-checked-verdict
      type-segment-bases
      checked
      banked
      callee
      site-depth
      site-weight
      np
      banked-cost-in)
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 opt-inline-verify-scratch-arena]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set scratch))]
      [mark : i64 (arena.tl_region_mark)]
      [ok : bool
        (opt-inline-checked-verdict
          type-segment-bases
          checked
          banked
          callee
          site-depth
          site-weight
          np
          banked-cost-in)]
      [scratch-head : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch-head)
          (arena.tl_region_reset mark))
        (set! opt-inline-verify-scratch-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set enclosing))
        ok))))

(define (opt-inline-bounds-leaf-cost-inline?
  [callee-instrs : i64]
  [added-blocks : i64]
  [caller-blocks : i64]
  [added-so-far : i64]) : bool
  (and
    (<= callee-instrs (opt-inline-bounds-leaf-max-body))
    (not
      (opt-inline-cost-crosses-heavy-gate?
        caller-blocks
        added-so-far
        added-blocks))
    (<= (+ added-so-far added-blocks) (opt-inline-cost-block-fuel))))

(define (opt-inline-try
  [instr : ir.CompilerIrInstr]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (match instr
    [(ir.CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-lookup-inlinable
        index
        cname
        func-name
        scc-result
        caller-scc)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(ir.CompilerIrFunction.Function
                callee-name
                cparams
                callee-ret
                cvars
                cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (let
                    [added-blocks : i64 0]
                    [body-instrs : ir.CompilerIrInstrSeq
                      (opt-inline-single-block-instrs cblocks)]
                    [const-args : i64 (opt-inline-args-const-count cargs)]
                    [absorbable? : bool
                      (opt-inline-census-absorbable?
                        index
                        census
                        func-name
                        callee-name)]
                    [has-bounds? : bool
                      (opt-inline-instr-seq-has-bounds-check? body-instrs)]
                    [bounds-leaf? : bool
                      (opt-inline-bounds-leaf-ok? cblocks np callee-ret)]
                    [callee-instrs : i64
                      (opt-inline-single-block-cost-instrs cblocks)]
                    (if (or
                      (and
                        (opt-inline-bounds-inline-ok?
                          has-bounds?
                          absorbable?
                          const-args
                          np)
                        (opt-inline-cost-inline?
                          callee-instrs
                          added-blocks
                          const-args
                          absorbable?
                          caller-blocks
                          added-so-far))
                      (and
                        bounds-leaf?
                        (opt-inline-bounds-leaf-cost-inline?
                          callee-instrs
                          added-blocks
                          caller-blocks
                          added-so-far)))
                      (begin
                        (set!
                          opt-inline-caller-site-count
                          (+ opt-inline-caller-site-count 1))
                        (OptInlineState.State
                          (opt-inline-expand-instrs
                            body-instrs
                            dst
                            cret
                            cargs
                            np
                            vars
                            (opt-inline-site-prefix
                              func-name
                              block-label
                              site-pos
                              callee-name))
                          (+ vars (opt-inline-frame-growth cvars np))
                          (+ added-so-far added-blocks)))
                      (OptInlineState.State
                        (ir.compiler-ir-instr-cons
                          (ir.CompilerIrInstr.Call dst cname cargs cret)
                          ir.CompilerIrInstrList.Nil)
                        vars
                        added-so-far)))
                  (OptInlineState.State
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Call dst cname cargs cret)
                      ir.CompilerIrInstrList.Nil)
                    vars
                    added-so-far)))])]
        [(OptMaybeFunction.No)
          (OptInlineState.State
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Call dst cname cargs cret)
              ir.CompilerIrInstrList.Nil)
            vars
            added-so-far)])]
    [_
      (OptInlineState.State
        (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
        vars
        added-so-far)]))

(define (opt-inline-try-with-spans
  [instr : ir.CompilerIrInstr]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanState
  (match instr
    [(ir.CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-lookup-inlinable
        index
        cname
        func-name
        scc-result
        caller-scc)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(ir.CompilerIrFunction.Function
                callee-name
                cparams
                callee-ret
                cvars
                cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (let
                    [added-blocks : i64 0]
                    [body-instrs : ir.CompilerIrInstrSeq
                      (opt-inline-single-block-instrs cblocks)]
                    [const-args : i64 (opt-inline-args-const-count cargs)]
                    [absorbable? : bool
                      (opt-inline-census-absorbable?
                        index
                        census
                        func-name
                        callee-name)]
                    [has-bounds? : bool
                      (opt-inline-instr-seq-has-bounds-check? body-instrs)]
                    [bounds-leaf? : bool
                      (opt-inline-bounds-leaf-ok? cblocks np callee-ret)]
                    [callee-instrs : i64
                      (opt-inline-single-block-cost-instrs cblocks)]
                    (if (or
                      (and
                        (opt-inline-bounds-inline-ok?
                          has-bounds?
                          absorbable?
                          const-args
                          np)
                        (opt-inline-cost-inline?
                          callee-instrs
                          added-blocks
                          const-args
                          absorbable?
                          caller-blocks
                          added-so-far))
                      (and
                        bounds-leaf?
                        (opt-inline-bounds-leaf-cost-inline?
                          callee-instrs
                          added-blocks
                          caller-blocks
                          added-so-far)))
                      (begin
                        (set!
                          opt-inline-caller-site-count
                          (+ opt-inline-caller-site-count 1))
                        (match (opt-inline-expand-instrs-with-spans
                          body-instrs
                          dst
                          cret
                          cargs
                          np
                          vars
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)
                          source-spans
                          out-spans
                          func-name
                          instr
                          cname)
                          [(OptInlineSpanState.State expanded _ _ next-spans)
                            (OptInlineSpanState.State
                              expanded
                              (+ vars (opt-inline-frame-growth cvars np))
                              (+ added-so-far added-blocks)
                              next-spans)]))
                      (OptInlineSpanState.State
                        (ir.compiler-ir-instr-cons
                          (ir.CompilerIrInstr.Call dst cname cargs cret)
                          ir.CompilerIrInstrList.Nil)
                        vars
                        added-so-far
                        out-spans)))
                  (OptInlineSpanState.State
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Call dst cname cargs cret)
                      ir.CompilerIrInstrList.Nil)
                    vars
                    added-so-far
                    out-spans)))])]
        [(OptMaybeFunction.No)
          (OptInlineSpanState.State
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Call dst cname cargs cret)
              ir.CompilerIrInstrList.Nil)
            vars
            added-so-far
            out-spans)])]
    [_
      (OptInlineSpanState.State
        (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
        vars
        added-so-far
        out-spans)]))

(define (opt-inline-walk-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineState
  (if (>= pos end)
    (OptInlineState.State ir.CompilerIrInstrList.Nil vars added-so-far)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (match (opt-inline-try
        instr
        index
        census
        func-name
        block-label
        site-pos
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)
        [(OptInlineState.State expanded vars2 added2)
          (match (opt-inline-walk-instr-seq-from
            instrs
            (+ pos 1)
            end
            index
            census
            func-name
            block-label
            (+ site-pos 1)
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc)
            [(OptInlineState.State rest-list vars3 added3)
              (OptInlineState.State
                (opt-inline-append expanded rest-list)
                vars3
                added3)])]))))

(define (opt-inline-walk-instr-seq-with-spans-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanState
  (if (>= pos end)
    (OptInlineSpanState.State
      ir.CompilerIrInstrList.Nil
      vars
      added-so-far
      out-spans)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (match (opt-inline-try-with-spans
        instr
        index
        census
        func-name
        block-label
        site-pos
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)
        [(OptInlineSpanState.State expanded vars2 added2 spans2)
          (match (opt-inline-walk-instr-seq-with-spans-from
            instrs
            (+ pos 1)
            end
            index
            census
            func-name
            block-label
            (+ site-pos 1)
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc
            source-spans
            spans2)
            [(OptInlineSpanState.State rest-list vars3 added3 spans3)
              (OptInlineSpanState.State
                (opt-inline-append expanded rest-list)
                vars3
                added3
                spans3)])]))))

;; Rewrite the instruction range [seq-start, end) through the single-block
;; expansion path and emit it as one block labelled `head-label`, with `lead`
;; spliced in front of the expansion.
;;
;; `block-label` stays the *original* block's label: it is what names inline
;; sites (opt-inline-site-prefix) and what the loop-membership fact reads, so a
;; continuation range carved out of that block keeps both. `head-label` is the
;; label the range is emitted under, which is the continuation label once a
;; multiblock rewrite has already split the block ahead of this range, and
;; `lead` carries that rewrite's result instruction into the block it opens.
;; `site-pos` and `pos` advance in lockstep everywhere in this walk, so the
;; range's first site position is `seq-start`.
(define (opt-inline-rewrite-single-block-seq
  [block-label : i64]
  [head-label : i64]
  [seq-start : i64]
  [lead : ir.CompilerIrInstrList]
  [instrs : ir.CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match (opt-inline-walk-instr-seq-from
    instrs
    seq-start
    (ir.compiler-ir-instr-seq-count instrs)
    index
    census
    func-name
    block-label
    seq-start
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc)
    [(OptInlineState.State new-instrs vars2 added2)
      (OptInlineMaybeBlockRewrite.SomeBlockRewrite
        (ir.compiler-ir-block-cons
          (ir.compiler-ir-block head-label (opt-inline-append lead new-instrs))
          ir.CompilerIrBlockList.Nil)
        vars2
        added2)]))

(define (opt-inline-multiblock-build-rewrite-seq
  [block-label : i64]
  [head-label : i64]
  [seq-start : i64]
  [lead : ir.CompilerIrInstrList]
  [instrs : ir.CompilerIrInstrSeq]
  [call-pos : i64]
  [count : i64]
  [site-pos : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : ir.CompilerIrFunction]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [index : OptFunctionIndex]) : OptInlineMaybeBlockRewrite
  (match call-instr
    [(ir.CompilerIrInstr.Call dst cname cargs cret)
      (match callee
        [(ir.CompilerIrFunction.Function callee-name cparams _ cvars cblocks)
          (let
            [np : i64 (opt-inline-param-count cparams)]
            (if (opt-inline-arity-ok? cargs np)
              (let
                [added-blocks : i64
                  (+ (ir.compiler-ir-block-list-count cblocks) 1)]
                ;; Result slots for converted tail calls: one per cloned block,
                ;; reserved above the clone's rebased frame, and reserved at all
                ;; only for a body that carries one. `added-blocks - 1` is the
                ;; callee's block count, already counted just above.
                [tail-slots : i64
                  (if (opt-inline-blocks-have-tail-call? cblocks)
                    (- added-blocks 1)
                    0)]
                [stage-all-args? : bool
                  (opt-inline-param-mutating-blocks? cblocks np)]
                [stage-args? : bool
                  (or stage-all-args? (opt-inline-params-have-sret? cparams))]
                [callee-instrs : i64
                  (+
                    (opt-inline-multiblock-cost-instrs cblocks)
                    (if stage-args?
                      np
                      0))]
                [const-args : i64 (opt-inline-args-const-count cargs)]
                [absorb-class : i64
                  (opt-inline-census-absorb-class
                    index
                    census
                    func-name
                    callee-name)]
                ;; The site-level verdict: this site claims the callee's body,
                ;; either because it is the only one (class 1, absorption) or
                ;; because the duplicating clauses admit a copy (class 2).
                [absorbable-here? : bool
                  (or
                    (= absorb-class 1)
                    (opt-inline-dup-absorb-ok?
                      absorb-class
                      callee-instrs
                      cblocks))]
                ;; Splitting a loop phi predecessor can lengthen live ranges.
                ;; Keep ordinary cost-model admission available here, but do
                ;; not let the unconditional single-reference absorb bonus
                ;; bypass its budget. #5193 owns the next bounded wrapper class.
                [tiny-predicate? : bool
                  (and
                    (not stage-args?)
                    (opt-inline-tiny-predicate-callee? index callee census))]
                ;; Bounds-carrying loops stay acyclic-only except for the exact
                ;; measured vm-run leaf selected by the shared gate (#5325).
                [has-bounds? : bool
                  (opt-inline-blocks-have-bounds-check? cblocks)]
                [refs : i64
                  (opt-inline-census-refcount index census callee-name)]
                [hot-refs : i64
                  (opt-inline-census-hot-refcount index census callee-name)]
                ;; A shared acyclic accessor is admitted on its own terms.
                [shared-accessor? : bool
                  (opt-inline-shared-accessor-ok?
                    refs
                    hot-refs
                    callee-instrs
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                ;; A call-free cyclic leaf is admitted on its own terms too: it
                ;; keeps its own body wherever this gate does not take it, so no
                ;; absorb credit is claimed -- which is what lets the gate span
                ;; every reference class, single-reference sites included,
                ;; without owing the census an absorption it did not perform.
                [hot-loop-leaf? : bool
                  (opt-inline-hot-loop-leaf-ok?
                    index
                    census
                    callee-name
                    refs
                    callee-instrs
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                ;; A callee with exactly one static reference absorbs at any
                ;; size: the body moves rather than being copied, so no growth
                ;; budget applies to it.
                [single-site-absorb? : bool
                  (opt-inline-single-site-absorb-ok?
                    absorb-class
                    has-bounds?
                    np
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                [bounds-ok? : bool
                  (or
                    (opt-inline-bounds-inline-ok?
                      has-bounds?
                      absorbable-here?
                      const-args
                      np)
                    shared-accessor?
                    hot-loop-leaf?)]
                [bounds-loop-ok? : bool
                  (or
                    (opt-inline-multiblock-bounds-loop-ok?
                      has-bounds?
                      absorbable-here?
                      absorb-class
                      callee-instrs
                      callee-name
                      cblocks)
                    hot-loop-leaf?
                    single-site-absorb?)]
                [budget-cost-ok? : bool
                  (or
                    (opt-inline-cost-inline?
                      callee-instrs
                      added-blocks
                      const-args
                      (and
                        absorbable-here?
                        (not opt-inline-current-phi-predecessor?))
                      caller-blocks
                      added-so-far)
                    (and
                      tiny-predicate?
                      (opt-inline-tiny-predicate-cost-inline?
                        callee-instrs
                        added-blocks
                        const-args
                        caller-blocks
                        added-so-far)))]
                [legacy-cost-ok? : bool (or budget-cost-ok? shared-accessor?)]
                ;; True only when the dominant-reference accessor tier is what
                ;; admits this site: its blocks spend that tier's own fuel.
                [accessor-import? : bool
                  (and
                    shared-accessor?
                    (opt-inline-shared-accessor-dominant? refs hot-refs)
                    (not budget-cost-ok?))]
                ;; A bounds-free acyclic branch chain is admitted on its own
                ;; terms: the census still claims it, but the cost model's
                ;; block weight is not what should price it.
                [branch-chain? : bool
                  (opt-inline-branch-chain-ok?
                    absorb-class
                    has-bounds?
                    callee-instrs
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                ;; The predictive verdict: every band above, unchanged.
                [band-admits? : bool
                  (and
                    bounds-ok?
                    bounds-loop-ok?
                    (or
                      legacy-cost-ok?
                      hot-loop-leaf?
                      branch-chain?
                      single-site-absorb?))]
                ;; The measured tier is asked only about sites no band takes: a
                ;; site both admit belongs to the band, which is cheaper (no
                ;; re-optimize, no re-plan) and already carries its own
                ;; measured argument.
                [checked? : bool
                  (and
                    (not band-admits?)
                    (opt-inline-checked-ok?
                      index
                      census
                      callee-name
                      refs
                      callee-instrs
                      np
                      cblocks
                      added-blocks
                      caller-blocks
                      added-so-far
                      site-pos))]
                [inline? : bool (or band-admits? checked?)]
                ;; True only when the hot-loop-leaf gate is what admits this
                ;; site: its blocks spend the gate's own fuel, not the shared
                ;; accumulator the caller's banked absorptions draw on.
                [hot-import? : bool (and hot-loop-leaf? (not legacy-cost-ok?))]
                ;; Same accounting for a chain import, against its own fuel.
                [chain-import? : bool
                  (and branch-chain? (not legacy-cost-ok?) (not hot-loop-leaf?))]
                (if inline?
                  (match (opt-inline-walk-instr-seq-from
                    instrs
                    seq-start
                    call-pos
                    index
                    census
                    func-name
                    block-label
                    seq-start
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc)
                    [(OptInlineState.State
                        prefix-instrs
                        prefix-vars
                        prefix-added)
                      (let
                        [_site-bump : unit
                          (set!
                            opt-inline-caller-site-count
                            (+ opt-inline-caller-site-count 1))]
                        [prefix : String
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)]
                        [entry-label : i64
                          (opt-inline-prefix-label
                            prefix
                            (opt-cfg-entry-label cblocks))]
                        [cont-label : i64 (opt-inline-cont-label prefix)]
                        [vars2 : i64
                          (+
                            prefix-vars
                            (+
                              (if stage-args?
                                cvars
                                (opt-inline-frame-growth cvars np))
                              tail-slots))]
                        [_hot-loop-bump : unit
                          (if hot-import?
                            (set!
                              opt-inline-caller-hot-loop-blocks
                              (+ opt-inline-caller-hot-loop-blocks added-blocks))
                            unit)]
                        [_chain-bump : unit
                          (if chain-import?
                            (set!
                              opt-inline-caller-chain-blocks
                              (+ opt-inline-caller-chain-blocks added-blocks))
                            unit)]
                        [_accessor-bump : unit
                          (if accessor-import?
                            (set!
                              opt-inline-caller-accessor-blocks
                              (+ opt-inline-caller-accessor-blocks added-blocks))
                            unit)]
                        ;; The measured tier's own accounting: its blocks, and
                        ;; the flag that says THIS walk placed its one new site.
                        ;; A re-admitted accepted site adds its blocks -- a
                        ;; later candidate is budgeted against the caller's
                        ;; whole checked growth -- but does not consume the
                        ;; walk's new-site slot. The program budget is spent by
                        ;; the VERDICT, not here, because a rejected candidate
                        ;; costs the same work an accepted one does.
                        [_checked-bump : unit
                          (if checked?
                            (begin
                              (set!
                                opt-inline-caller-checked-blocks
                                (+
                                  opt-inline-caller-checked-blocks
                                  added-blocks))
                              (if opt-inline-checked-new-site?
                                (set! opt-inline-caller-checked-taken? true)
                                unit))
                            unit)]
                        ;; A hot-loop, chain, accessor or checked import's
                        ;; blocks stay out of the shared accumulator; each gate
                        ;; charged its own fuel above.
                        [added2 : i64
                          (+
                            prefix-added
                            (if (or
                              hot-import?
                              chain-import?
                              accessor-import?
                              checked?)
                              0
                              added-blocks))]
                        [stage-instrs : ir.CompilerIrInstrList
                          (if stage-args?
                            (opt-inline-stage-param-instrs
                              cparams
                              cargs
                              prefix-vars
                              stage-all-args?
                              0)
                            ir.CompilerIrInstrList.Nil)]
                        [staged-args : ir.CompilerIrCallArgs
                          (if stage-args?
                            (opt-inline-staged-args
                              cparams
                              cargs
                              np
                              prefix-vars
                              stage-all-args?)
                            cargs)]
                        [clone-base : i64
                          (if stage-args?
                            (+ prefix-vars np)
                            prefix-vars)]
                        ;; The first slot past the clone's rebased frame: the
                        ;; callee's highest var rebases to `tail-base - 1`, and
                        ;; `vars2` above reserved `tail-slots` ids from here.
                        [tail-base : i64
                          (opt-inline-rebase-var cvars np clone-base)]
                        [prefix-instrs2 : ir.CompilerIrInstrList
                          (opt-inline-append
                            lead
                            (opt-inline-append
                              prefix-instrs
                              (opt-inline-append
                                stage-instrs
                                (ir.compiler-ir-instr-cons
                                  (ir.CompilerIrInstr.Jump entry-label)
                                  ir.CompilerIrInstrList.Nil))))]
                        (match (opt-inline-clone-multiblock-blocks
                          cblocks
                          prefix
                          cont-label
                          tail-base
                          staged-args
                          np
                          clone-base)
                          [(OptInlineMultiClone.Clone
                              cloned-blocks
                              return-inputs)
                            (let
                              [result-instr : ir.CompilerIrInstr
                                (opt-inline-cont-result-instr
                                  dst
                                  return-inputs
                                  cret)]
                              ;; The suffix opens the continuation block, so it
                              ;; is rewritten by this same scan rather than by
                              ;; the single-block walk: a second admitted
                              ;; multiblock candidate in the same block gets its
                              ;; own split instead of being evicted by whichever
                              ;; candidate came first. The scan bottoms out in
                              ;; opt-inline-rewrite-single-block-seq, which is
                              ;; exactly the walk this call site used to make,
                              ;; so a block with one admitted candidate rebuilds
                              ;; byte-for-byte as before. Every gate still runs
                              ;; per candidate, and `added2` hands the suffix the
                              ;; fuel this site already spent.
                              (match (opt-inline-try-multiblock-rewrite-seq-from
                                instrs
                                (+ call-pos 1)
                                count
                                block-label
                                cont-label
                                (+ call-pos 1)
                                (ir.compiler-ir-instr-cons
                                  result-instr
                                  ir.CompilerIrInstrList.Nil)
                                (+ site-pos 1)
                                index
                                census
                                func-name
                                vars2
                                caller-blocks
                                added2
                                scc-result
                                caller-scc)
                                [(OptInlineMaybeBlockRewrite.SomeBlockRewrite
                                    cont-blocks
                                    vars3
                                    added3)
                                  (let
                                    ;; Recorded after the suffix so a nested
                                    ;; split's rename lands behind this one:
                                    ;; opt-inline-repair-phi-predecessors
                                    ;; applies the newest rename first, and the
                                    ;; chain has to run outer-to-inner
                                    ;; (block -> cont -> cont') to leave a
                                    ;; successor phi naming the block that
                                    ;; actually reaches it.
                                    [_record-pred-rename : unit
                                      (if opt-inline-current-phi-predecessor?
                                        (set!
                                          (array-ref opt-inline-pred-renames 0)
                                          (opt-inline-pred-renames-cons
                                            head-label
                                            cont-label
                                            (opt-inline-pred-renames-shared-view)))
                                        unit)]
                                    (OptInlineMaybeBlockRewrite.SomeBlockRewrite
                                      (ir.compiler-ir-block-cons
                                        (ir.compiler-ir-block
                                          head-label
                                          prefix-instrs2)
                                        (opt-inline-block-append
                                          cloned-blocks
                                          cont-blocks))
                                      vars3
                                      added3))]
                                ;; Unreachable: the scan always ends in a
                                ;; single-block rewrite. Refusing the site is the
                                ;; safe reading if that ever changes.
                                [(OptInlineMaybeBlockRewrite.NoBlockRewrite)
                                  (OptInlineMaybeBlockRewrite.NoBlockRewrite)]))]))])
                  (OptInlineMaybeBlockRewrite.NoBlockRewrite)))
              (OptInlineMaybeBlockRewrite.NoBlockRewrite)))])]
    [_ (OptInlineMaybeBlockRewrite.NoBlockRewrite)]))

;; Scan [pos, count) for a multiblock-admitted call and rewrite the range
;; [seq-start, count) around the first one found, emitting the range's opening
;; block under `head-label` with `lead` in front of it. The rewrite recurses on
;; the suffix, so every admitted candidate in a block gets its own split rather
;; than the first one claiming the block: the "never evict a banked inline"
;; invariant the gate comments assert is structural here, not first-come.
(define (opt-inline-try-multiblock-rewrite-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [block-label : i64]
  [head-label : i64]
  [seq-start : i64]
  [lead : ir.CompilerIrInstrList]
  [site-pos : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (if (>= pos count)
    (opt-inline-rewrite-single-block-seq
      block-label
      head-label
      seq-start
      lead
      instrs
      index
      census
      func-name
      vars
      caller-blocks
      added-so-far
      scc-result
      caller-scc)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(ir.CompilerIrInstr.Call _ cname _ _)
          (match (opt-inline-lookup-multiblock-inlinable
            index
            cname
            func-name
            scc-result
            caller-scc)
            [(OptMaybeFunction.Some callee)
              (match (opt-inline-multiblock-build-rewrite-seq
                block-label
                head-label
                seq-start
                lead
                instrs
                pos
                count
                site-pos
                instr
                callee
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                index)
                [(OptInlineMaybeBlockRewrite.SomeBlockRewrite
                    blocks2
                    vars2
                    added2)
                  (OptInlineMaybeBlockRewrite.SomeBlockRewrite
                    blocks2
                    vars2
                    added2)]
                [(OptInlineMaybeBlockRewrite.NoBlockRewrite)
                  (opt-inline-try-multiblock-rewrite-seq-from
                    instrs
                    (+ pos 1)
                    count
                    block-label
                    head-label
                    seq-start
                    lead
                    (+ site-pos 1)
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc)])]
            [(OptMaybeFunction.No)
              (opt-inline-try-multiblock-rewrite-seq-from
                instrs
                (+ pos 1)
                count
                block-label
                head-label
                seq-start
                lead
                (+ site-pos 1)
                index
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc)])]
        [_
          (opt-inline-try-multiblock-rewrite-seq-from
            instrs
            (+ pos 1)
            count
            block-label
            head-label
            seq-start
            lead
            (+ site-pos 1)
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)]))))

;; A block with no direct call instruction contains no inline site: both the
;; single-block walk and the multiblock rewrite only fire on
;; CompilerIrInstr.Call. Returning the original block skips the
;; per-instruction rebuild walk without changing the result.
(define (opt-inline-instr-seq-has-call-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Call _ _ _ _) true]
      [_ (opt-inline-instr-seq-has-call-from? instrs (+ index 1))])))

(define (opt-inline-instr-seq-has-call? [instrs : ir.CompilerIrInstrSeq]) : bool
  (opt-inline-instr-seq-has-call-from? instrs 0))

(define (opt-inline-rewrite-block
  [block : ir.CompilerIrBlock]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineMaybeBlockRewrite
  (match block
    [(ir.CompilerIrBlock.Block label seq)
      (if (not (opt-inline-instr-seq-has-call? seq))
        (OptInlineMaybeBlockRewrite.SomeBlockRewrite
          (ir.compiler-ir-block-cons block ir.CompilerIrBlockList.Nil)
          vars
          added-so-far)
        (begin
          (set!
            opt-inline-current-phi-predecessor?
            (opt-label-contains phi-predecessors label))
          (set! opt-inline-current-block-label label)
          (opt-inline-try-multiblock-rewrite-seq-from
            seq
            0
            (ir.compiler-ir-instr-seq-count seq)
            label
            label
            0
            ir.CompilerIrInstrList.Nil
            0
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc)))]))

(define (opt-inline-clone-multiblock-instr-seq-with-spans-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanInstrClone
  (if (>= pos count)
    (OptInlineMultiSpanInstrClone.Clone
      ir.CompilerIrInstrList.Nil
      ir.CompilerIrPhiInputList.Nil
      out-spans)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(ir.CompilerIrInstr.Return maybe)
          (OptInlineMultiSpanInstrClone.Clone
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Jump cont-label)
              ir.CompilerIrInstrList.Nil)
            (ir.compiler-ir-phi-input-cons
              (opt-inline-return-value maybe sa np base)
              cloned-label
              ir.CompilerIrPhiInputList.Nil)
            out-spans)]
        ;; Same conversion as the span-free twin. The converted call takes the
        ;; tail call's span: it is the instruction that keeps the callee's line,
        ;; and a trap raised inside the called function has to report through it
        ;; exactly as it did when the site was a real tail call. The `Jump` gets
        ;; none, matching the Return arm.
        [(ir.CompilerIrInstr.TailCall cname cargs cty)
          (let
            [converted : ir.CompilerIrInstr
              (ir.CompilerIrInstr.Call
                tail-dst
                (ir.compiler-ir-symbol-clone cname)
                (opt-inline-remap-args cargs sa np base)
                (clone cty))]
            (OptInlineMultiSpanInstrClone.Clone
              (ir.compiler-ir-instr-cons
                converted
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Jump cont-label)
                  ir.CompilerIrInstrList.Nil))
              (ir.compiler-ir-phi-input-cons
                (ir.CompilerIrValue.Var tail-dst)
                cloned-label
                ir.CompilerIrPhiInputList.Nil)
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                converted)))]
        [_
          (let
            [cloned : ir.CompilerIrInstr
              (opt-inline-clone-multiblock-instr instr prefix sa np base)]
            [spans2 : ir.CompilerSourceSpans
              (opt-inline-record-clone-span
                source-spans
                out-spans
                caller
                call-instr
                callee
                instr
                cloned)]
            (match (opt-inline-clone-multiblock-instr-seq-with-spans-from
              instrs
              (+ pos 1)
              count
              cloned-label
              prefix
              cont-label
              tail-dst
              sa
              np
              base
              source-spans
              spans2
              caller
              call-instr
              callee)
              [(OptInlineMultiSpanInstrClone.Clone
                  rest-instrs
                  rest-inputs
                  spans3)
                (OptInlineMultiSpanInstrClone.Clone
                  (ir.compiler-ir-instr-cons cloned rest-instrs)
                  rest-inputs
                  spans3)]))]))))

(define (opt-inline-clone-multiblock-instr-seq-with-spans
  [instrs : ir.CompilerIrInstrSeq]
  [cloned-label : i64]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanInstrClone
  (opt-inline-clone-multiblock-instr-seq-with-spans-from
    instrs
    0
    (ir.compiler-ir-instr-seq-count instrs)
    cloned-label
    prefix
    cont-label
    tail-dst
    sa
    np
    base
    source-spans
    out-spans
    caller
    call-instr
    callee))

(define (opt-inline-clone-multiblock-block-with-spans
  [block : ir.CompilerIrBlock]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanClone
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [cloned-label : i64 (opt-inline-prefix-label prefix label)]
        (match (opt-inline-clone-multiblock-instr-seq-with-spans
          instrs
          cloned-label
          prefix
          cont-label
          tail-dst
          sa
          np
          base
          source-spans
          out-spans
          caller
          call-instr
          callee)
          [(OptInlineMultiSpanInstrClone.Clone cloned-instrs inputs spans2)
            (OptInlineMultiSpanClone.Clone
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block cloned-label cloned-instrs)
                ir.CompilerIrBlockList.Nil)
              inputs
              spans2)]))]))

(define (opt-inline-clone-multiblock-blocks-with-spans
  [blocks : ir.CompilerIrBlockList]
  [prefix : String]
  [cont-label : i64]
  [tail-dst : i64]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [caller : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : i64]) : OptInlineMultiSpanClone
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptInlineMultiSpanClone.Clone
        ir.CompilerIrBlockList.Nil
        ir.CompilerIrPhiInputList.Nil
        out-spans)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-inline-clone-multiblock-block-with-spans
        block
        prefix
        cont-label
        tail-dst
        sa
        np
        base
        source-spans
        out-spans
        caller
        call-instr
        callee)
        [(OptInlineMultiSpanClone.Clone one-block one-inputs spans2)
          (match (opt-inline-clone-multiblock-blocks-with-spans
            (__tl-box-place rest)
            prefix
            cont-label
            (+ tail-dst 1)
            sa
            np
            base
            source-spans
            spans2
            caller
            call-instr
            callee)
            [(OptInlineMultiSpanClone.Clone rest-blocks rest-inputs spans3)
              (OptInlineMultiSpanClone.Clone
                (opt-inline-block-append one-block rest-blocks)
                (ir.compiler-ir-phi-input-list-reverse-onto
                  one-inputs
                  rest-inputs)
                spans3)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-clone-multiblock-blocks-with-spans
        (ir.compiler-ir-block-seq-to-list seq)
        prefix
        cont-label
        tail-dst
        sa
        np
        base
        source-spans
        out-spans
        caller
        call-instr
        callee)]))

;; Span-carrying twin of opt-inline-rewrite-single-block-seq; `block-label`,
;; `head-label`, `seq-start`, and `lead` mean exactly what they mean there.
(define (opt-inline-rewrite-single-block-seq-with-spans
  [block-label : i64]
  [head-label : i64]
  [seq-start : i64]
  [lead : ir.CompilerIrInstrList]
  [instrs : ir.CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match (opt-inline-walk-instr-seq-with-spans-from
    instrs
    seq-start
    (ir.compiler-ir-instr-seq-count instrs)
    index
    census
    func-name
    block-label
    seq-start
    vars
    caller-blocks
    added-so-far
    scc-result
    caller-scc
    source-spans
    out-spans)
    [(OptInlineSpanState.State new-instrs vars2 added2 spans2)
      (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
        (ir.compiler-ir-block-cons
          (ir.compiler-ir-block head-label (opt-inline-append lead new-instrs))
          ir.CompilerIrBlockList.Nil)
        vars2
        added2
        spans2)]))

(define (opt-inline-multiblock-build-span-rewrite-seq
  [block-label : i64]
  [head-label : i64]
  [seq-start : i64]
  [lead : ir.CompilerIrInstrList]
  [instrs : ir.CompilerIrInstrSeq]
  [call-pos : i64]
  [count : i64]
  [site-pos : i64]
  [call-instr : ir.CompilerIrInstr]
  [callee : ir.CompilerIrFunction]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [index : OptFunctionIndex]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match call-instr
    [(ir.CompilerIrInstr.Call dst cname cargs cret)
      (match callee
        [(ir.CompilerIrFunction.Function callee-name cparams _ cvars cblocks)
          (let
            [np : i64 (opt-inline-param-count cparams)]
            (if (opt-inline-arity-ok? cargs np)
              (let
                [added-blocks : i64
                  (+ (ir.compiler-ir-block-list-count cblocks) 1)]
                ;; Result slots for converted tail calls: one per cloned block,
                ;; reserved above the clone's rebased frame, and reserved at all
                ;; only for a body that carries one. `added-blocks - 1` is the
                ;; callee's block count, already counted just above.
                [tail-slots : i64
                  (if (opt-inline-blocks-have-tail-call? cblocks)
                    (- added-blocks 1)
                    0)]
                [stage-all-args? : bool
                  (opt-inline-param-mutating-blocks? cblocks np)]
                [stage-args? : bool
                  (or stage-all-args? (opt-inline-params-have-sret? cparams))]
                [callee-instrs : i64
                  (+
                    (opt-inline-multiblock-cost-instrs cblocks)
                    (if stage-args?
                      np
                      0))]
                [const-args : i64 (opt-inline-args-const-count cargs)]
                [absorb-class : i64
                  (opt-inline-census-absorb-class
                    index
                    census
                    func-name
                    callee-name)]
                ;; Same site-level verdict as the non-span path.
                [absorbable-here? : bool
                  (or
                    (= absorb-class 1)
                    (opt-inline-dup-absorb-ok?
                      absorb-class
                      callee-instrs
                      cblocks))]
                [tiny-predicate? : bool
                  (and
                    (not stage-args?)
                    (opt-inline-tiny-predicate-callee? index callee census))]
                ;; Keep the span-aware path on the same exact vm-run decision.
                [has-bounds? : bool
                  (opt-inline-blocks-have-bounds-check? cblocks)]
                [refs : i64
                  (opt-inline-census-refcount index census callee-name)]
                [hot-refs : i64
                  (opt-inline-census-hot-refcount index census callee-name)]
                ;; A shared acyclic accessor is admitted on its own terms.
                [shared-accessor? : bool
                  (opt-inline-shared-accessor-ok?
                    refs
                    hot-refs
                    callee-instrs
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                ;; Same hot-loop-leaf decision as the non-span path.
                [hot-loop-leaf? : bool
                  (opt-inline-hot-loop-leaf-ok?
                    index
                    census
                    callee-name
                    refs
                    callee-instrs
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                ;; Same single-site absorption verdict as the non-span path.
                [single-site-absorb? : bool
                  (opt-inline-single-site-absorb-ok?
                    absorb-class
                    has-bounds?
                    np
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                [bounds-ok? : bool
                  (or
                    (opt-inline-bounds-inline-ok?
                      has-bounds?
                      absorbable-here?
                      const-args
                      np)
                    shared-accessor?
                    hot-loop-leaf?)]
                [bounds-loop-ok? : bool
                  (or
                    (opt-inline-multiblock-bounds-loop-ok?
                      has-bounds?
                      absorbable-here?
                      absorb-class
                      callee-instrs
                      callee-name
                      cblocks)
                    hot-loop-leaf?
                    single-site-absorb?)]
                [budget-cost-ok? : bool
                  (or
                    (opt-inline-cost-inline?
                      callee-instrs
                      added-blocks
                      const-args
                      (and
                        absorbable-here?
                        (not opt-inline-current-phi-predecessor?))
                      caller-blocks
                      added-so-far)
                    (and
                      tiny-predicate?
                      (opt-inline-tiny-predicate-cost-inline?
                        callee-instrs
                        added-blocks
                        const-args
                        caller-blocks
                        added-so-far)))]
                [legacy-cost-ok? : bool (or budget-cost-ok? shared-accessor?)]
                ;; True only when the dominant-reference accessor tier is what
                ;; admits this site: its blocks spend that tier's own fuel.
                [accessor-import? : bool
                  (and
                    shared-accessor?
                    (opt-inline-shared-accessor-dominant? refs hot-refs)
                    (not budget-cost-ok?))]
                ;; Same branch-chain decision as the non-span path.
                [branch-chain? : bool
                  (opt-inline-branch-chain-ok?
                    absorb-class
                    has-bounds?
                    callee-instrs
                    cblocks
                    added-blocks
                    caller-blocks
                    added-so-far)]
                ;; Same predictive verdict as the non-span path.
                [band-admits? : bool
                  (and
                    bounds-ok?
                    bounds-loop-ok?
                    (or
                      legacy-cost-ok?
                      hot-loop-leaf?
                      branch-chain?
                      single-site-absorb?))]
                ;; Same measured tier as the non-span path.
                [checked? : bool
                  (and
                    (not band-admits?)
                    (opt-inline-checked-ok?
                      index
                      census
                      callee-name
                      refs
                      callee-instrs
                      np
                      cblocks
                      added-blocks
                      caller-blocks
                      added-so-far
                      site-pos))]
                [inline? : bool (or band-admits? checked?)]
                ;; Same hot-import accounting as the non-span path.
                [hot-import? : bool (and hot-loop-leaf? (not legacy-cost-ok?))]
                ;; Same chain-import accounting as the non-span path.
                [chain-import? : bool
                  (and branch-chain? (not legacy-cost-ok?) (not hot-loop-leaf?))]
                (if inline?
                  (match (opt-inline-walk-instr-seq-with-spans-from
                    instrs
                    seq-start
                    call-pos
                    index
                    census
                    func-name
                    block-label
                    seq-start
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc
                    source-spans
                    out-spans)
                    [(OptInlineSpanState.State
                        prefix-instrs
                        prefix-vars
                        prefix-added
                        spans2)
                      (let
                        [_site-bump : unit
                          (set!
                            opt-inline-caller-site-count
                            (+ opt-inline-caller-site-count 1))]
                        [prefix : String
                          (opt-inline-site-prefix
                            func-name
                            block-label
                            site-pos
                            callee-name)]
                        [entry-label : i64
                          (opt-inline-prefix-label
                            prefix
                            (opt-cfg-entry-label cblocks))]
                        [cont-label : i64 (opt-inline-cont-label prefix)]
                        [vars2 : i64
                          (+
                            prefix-vars
                            (+
                              (if stage-args?
                                cvars
                                (opt-inline-frame-growth cvars np))
                              tail-slots))]
                        [_hot-loop-bump : unit
                          (if hot-import?
                            (set!
                              opt-inline-caller-hot-loop-blocks
                              (+ opt-inline-caller-hot-loop-blocks added-blocks))
                            unit)]
                        [_chain-bump : unit
                          (if chain-import?
                            (set!
                              opt-inline-caller-chain-blocks
                              (+ opt-inline-caller-chain-blocks added-blocks))
                            unit)]
                        [_accessor-bump : unit
                          (if accessor-import?
                            (set!
                              opt-inline-caller-accessor-blocks
                              (+ opt-inline-caller-accessor-blocks added-blocks))
                            unit)]
                        ;; The measured tier's own accounting: its blocks, and
                        ;; the flag that says THIS walk placed its one new site.
                        ;; A re-admitted accepted site adds its blocks -- a
                        ;; later candidate is budgeted against the caller's
                        ;; whole checked growth -- but does not consume the
                        ;; walk's new-site slot. The program budget is spent by
                        ;; the VERDICT, not here, because a rejected candidate
                        ;; costs the same work an accepted one does.
                        [_checked-bump : unit
                          (if checked?
                            (begin
                              (set!
                                opt-inline-caller-checked-blocks
                                (+
                                  opt-inline-caller-checked-blocks
                                  added-blocks))
                              (if opt-inline-checked-new-site?
                                (set! opt-inline-caller-checked-taken? true)
                                unit))
                            unit)]
                        ;; Same import accounting as the non-span path.
                        [added2 : i64
                          (+
                            prefix-added
                            (if (or
                              hot-import?
                              chain-import?
                              accessor-import?
                              checked?)
                              0
                              added-blocks))]
                        [stage-instrs : ir.CompilerIrInstrList
                          (if stage-args?
                            (opt-inline-stage-param-instrs
                              cparams
                              cargs
                              prefix-vars
                              stage-all-args?
                              0)
                            ir.CompilerIrInstrList.Nil)]
                        [staged-args : ir.CompilerIrCallArgs
                          (if stage-args?
                            (opt-inline-staged-args
                              cparams
                              cargs
                              np
                              prefix-vars
                              stage-all-args?)
                            cargs)]
                        [clone-base : i64
                          (if stage-args?
                            (+ prefix-vars np)
                            prefix-vars)]
                        ;; The first slot past the clone's rebased frame: the
                        ;; callee's highest var rebases to `tail-base - 1`, and
                        ;; `vars2` above reserved `tail-slots` ids from here.
                        [tail-base : i64
                          (opt-inline-rebase-var cvars np clone-base)]
                        [prefix-instrs2 : ir.CompilerIrInstrList
                          (opt-inline-append
                            lead
                            (opt-inline-append
                              prefix-instrs
                              (opt-inline-append
                                stage-instrs
                                (ir.compiler-ir-instr-cons
                                  (ir.CompilerIrInstr.Jump entry-label)
                                  ir.CompilerIrInstrList.Nil))))]
                        (match (opt-inline-clone-multiblock-blocks-with-spans
                          cblocks
                          prefix
                          cont-label
                          tail-base
                          staged-args
                          np
                          clone-base
                          source-spans
                          spans2
                          func-name
                          call-instr
                          callee-name)
                          [(OptInlineMultiSpanClone.Clone
                              cloned-blocks
                              return-inputs
                              spans3)
                            (let
                              [result-instr : ir.CompilerIrInstr
                                (opt-inline-cont-result-instr
                                  dst
                                  return-inputs
                                  cret)]
                              ;; Same suffix recursion as the non-span path.
                              ;; `result-instr` rides down as the continuation
                              ;; block's lead instruction, and its span is
                              ;; recorded on the way back out so the span stream
                              ;; keeps the order it had when the suffix was a
                              ;; plain single-block walk.
                              (match (opt-inline-try-multiblock-span-rewrite-seq-from
                                instrs
                                (+ call-pos 1)
                                count
                                block-label
                                cont-label
                                (+ call-pos 1)
                                (ir.compiler-ir-instr-cons
                                  result-instr
                                  ir.CompilerIrInstrList.Nil)
                                (+ site-pos 1)
                                index
                                census
                                func-name
                                vars2
                                caller-blocks
                                added2
                                scc-result
                                caller-scc
                                source-spans
                                spans3)
                                [(OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                                    cont-blocks
                                    vars3
                                    added3
                                    spans4)
                                  (let
                                    [spans5 : ir.CompilerSourceSpans
                                      (opt-inline-call-span-to-instr
                                        source-spans
                                        spans4
                                        func-name
                                        call-instr
                                        result-instr)]
                                    [_record-pred-rename : unit
                                      (if opt-inline-current-phi-predecessor?
                                        (set!
                                          (array-ref opt-inline-pred-renames 0)
                                          (opt-inline-pred-renames-cons
                                            head-label
                                            cont-label
                                            (opt-inline-pred-renames-shared-view)))
                                        unit)]
                                    (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                                      (ir.compiler-ir-block-cons
                                        (ir.compiler-ir-block
                                          head-label
                                          prefix-instrs2)
                                        (opt-inline-block-append
                                          cloned-blocks
                                          cont-blocks))
                                      vars3
                                      added3
                                      spans5))]
                                ;; Unreachable for the same reason as the
                                ;; non-span path; refusing the site is the safe
                                ;; reading.
                                [(OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)
                                  (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)]))]))])
                  (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)))
              (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)))])]
    [_ (OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)]))

;; Span-carrying twin of opt-inline-try-multiblock-rewrite-seq-from, including
;; its suffix recursion: this is the variant the driver compiles through.
(define (opt-inline-try-multiblock-span-rewrite-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [block-label : i64]
  [head-label : i64]
  [seq-start : i64]
  [lead : ir.CompilerIrInstrList]
  [site-pos : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (if (>= pos count)
    (opt-inline-rewrite-single-block-seq-with-spans
      block-label
      head-label
      seq-start
      lead
      instrs
      index
      census
      func-name
      vars
      caller-blocks
      added-so-far
      scc-result
      caller-scc
      source-spans
      out-spans)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (match instr
        [(ir.CompilerIrInstr.Call _ cname _ _)
          (match (opt-inline-lookup-multiblock-inlinable
            index
            cname
            func-name
            scc-result
            caller-scc)
            [(OptMaybeFunction.Some callee)
              (match (opt-inline-multiblock-build-span-rewrite-seq
                block-label
                head-label
                seq-start
                lead
                instrs
                pos
                count
                site-pos
                instr
                callee
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                index
                source-spans
                out-spans)
                [(OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                    blocks2
                    vars2
                    added2
                    spans2)
                  (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
                    blocks2
                    vars2
                    added2
                    spans2)]
                [(OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)
                  (opt-inline-try-multiblock-span-rewrite-seq-from
                    instrs
                    (+ pos 1)
                    count
                    block-label
                    head-label
                    seq-start
                    lead
                    (+ site-pos 1)
                    index
                    census
                    func-name
                    vars
                    caller-blocks
                    added-so-far
                    scc-result
                    caller-scc
                    source-spans
                    out-spans)])]
            [(OptMaybeFunction.No)
              (opt-inline-try-multiblock-span-rewrite-seq-from
                instrs
                (+ pos 1)
                count
                block-label
                head-label
                seq-start
                lead
                (+ site-pos 1)
                index
                census
                func-name
                vars
                caller-blocks
                added-so-far
                scc-result
                caller-scc
                source-spans
                out-spans)])]
        [_
          (opt-inline-try-multiblock-span-rewrite-seq-from
            instrs
            (+ pos 1)
            count
            block-label
            head-label
            seq-start
            lead
            (+ site-pos 1)
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)]))))

(define (opt-inline-rewrite-block-with-spans
  [block : ir.CompilerIrBlock]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineMaybeSpanBlockRewrite
  (match block
    [(ir.CompilerIrBlock.Block label seq)
      (if (not (opt-inline-instr-seq-has-call? seq))
        (OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
          (ir.compiler-ir-block-cons block ir.CompilerIrBlockList.Nil)
          vars
          added-so-far
          out-spans)
        (begin
          (set!
            opt-inline-current-phi-predecessor?
            (opt-label-contains phi-predecessors label))
          (set! opt-inline-current-block-label label)
          (opt-inline-try-multiblock-span-rewrite-seq-from
            seq
            0
            (ir.compiler-ir-instr-seq-count seq)
            label
            label
            0
            ir.CompilerIrInstrList.Nil
            0
            index
            census
            func-name
            vars
            caller-blocks
            added-so-far
            scc-result
            caller-scc
            source-spans
            out-spans)))]))

(define (opt-inline-blocks
  [blocks : ir.CompilerIrBlockList]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : OptInlineBlocks
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptInlineBlocks.Blocks ir.CompilerIrBlockList.Nil vars added-so-far)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-inline-rewrite-block
        block
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)
        [(OptInlineMaybeBlockRewrite.SomeBlockRewrite rewritten vars2 added2)
          (match (opt-inline-blocks
            (__tl-box-place rest)
            phi-predecessors
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc)
            [(OptInlineBlocks.Blocks rest-blocks vars3 added3)
              (OptInlineBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                added3)])]
        [(OptInlineMaybeBlockRewrite.NoBlockRewrite)
          (OptInlineBlocks.Blocks
            (ir.compiler-ir-block-cons block ir.CompilerIrBlockList.Nil)
            vars
            added-so-far)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc)]))

(define (opt-inline-blocks-with-spans
  [blocks : ir.CompilerIrBlockList]
  [phi-predecessors : OptLabelSet]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [func-name : i64]
  [vars : i64]
  [caller-blocks : i64]
  [added-so-far : i64]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanBlocks
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptInlineSpanBlocks.Blocks
        ir.CompilerIrBlockList.Nil
        vars
        added-so-far
        out-spans)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-inline-rewrite-block-with-spans
        block
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)
        [(OptInlineMaybeSpanBlockRewrite.SomeSpanBlockRewrite
            rewritten
            vars2
            added2
            spans2)
          (match (opt-inline-blocks-with-spans
            (__tl-box-place rest)
            phi-predecessors
            index
            census
            func-name
            vars2
            caller-blocks
            added2
            scc-result
            caller-scc
            source-spans
            spans2)
            [(OptInlineSpanBlocks.Blocks rest-blocks vars3 added3 spans3)
              (OptInlineSpanBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                added3
                spans3)])]
        [(OptInlineMaybeSpanBlockRewrite.NoSpanBlockRewrite)
          (OptInlineSpanBlocks.Blocks
            (ir.compiler-ir-block-cons block ir.CompilerIrBlockList.Nil)
            vars
            added-so-far
            out-spans)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-blocks-with-spans
        (ir.compiler-ir-block-seq-to-list seq)
        phi-predecessors
        index
        census
        func-name
        vars
        caller-blocks
        added-so-far
        scc-result
        caller-scc
        source-spans
        out-spans)]))

(define (opt-inline-bounds-labels-unique-instrs-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [seen : opt_string_i64_map.Map (:consume)]) : OptInlineBoundsLabelScan
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptInlineBoundsLabelScan.Ok seen)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BoundsCheck _ _ ok-label)
        (if (opt_string_i64_map.contains? (& seen) ok-label)
          (OptInlineBoundsLabelScan.Duplicate)
          (begin
            (opt_string_i64_map.insert-ref! (&mut seen) ok-label 1)
            (opt-inline-bounds-labels-unique-instrs-from
              instrs
              (+ index 1)
              seen)))]
      [_ (opt-inline-bounds-labels-unique-instrs-from instrs (+ index 1) seen)])))

(define (opt-inline-bounds-labels-unique-blocks?
  [blocks : ir.CompilerIrBlockList]
  [seen : opt_string_i64_map.Map (:consume)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-inline-bounds-labels-unique-instrs-from instrs 0 seen)
            [(OptInlineBoundsLabelScan.Duplicate) false]
            [(OptInlineBoundsLabelScan.Ok next-seen)
              (opt-inline-bounds-labels-unique-blocks?
                (__tl-box-place rest)
                next-seen)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-bounds-labels-unique-blocks?
        (ir.compiler-ir-block-seq-to-list seq)
        seen)]))

(define (opt-inline-bounds-labels-unique? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-inline-bounds-labels-unique-blocks?
    blocks
    (opt_string_i64_map.with-capacity 64)))

(define (opt-inline-structure-ok? [blocks : ir.CompilerIrBlockList]) : bool
  (let
    ;; The index this already builds for the phi check answers the two label
    ;; scans as well, so build it up front instead of walking the blocks twice
    ;; more first.
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    (begin
      (unless (opt-cfg-index-labels-unique? index) (return false))
      (unless (opt-inline-bounds-labels-unique? blocks) (return false))
      (unless index.targets-known (return false))
      (opt-verify-ok?
        (opt-verify-phi-predecessors-blocks (OptPredMap index) blocks)))))

;; Inlining retains rewritten IR in the program arena, but its structural
;; verifier builds only temporary CFG indexes and predecessor maps. Reuse one
;; scratch arena across the program so those per-function tables do not remain
;; live until backend emission.
(define opt-inline-verify-scratch-arena : i64
  0)

(define (opt-inline-structure-ok-reclaiming? [blocks : ir.CompilerIrBlockList]) : bool
  (if (= opt-inline-verify-scratch-arena 0)
    (opt-inline-structure-ok? blocks)
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 opt-inline-verify-scratch-arena]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set scratch))]
      [mark : i64 (arena.tl_region_mark)]
      [ok : bool (opt-inline-structure-ok? blocks)]
      [scratch-head : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch-head)
          (arena.tl_region_reset mark))
        (set! opt-inline-verify-scratch-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set enclosing))
        ok))))

(define (opt-inline-tiny-predicate-acyclic-reclaiming?
  [blocks : ir.CompilerIrBlockList]) : bool
  (if (= opt-inline-verify-scratch-arena 0)
    (opt-inline-tiny-predicate-acyclic? blocks)
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      [scratch : i64 opt-inline-verify-scratch-arena]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set scratch))]
      [mark : i64 (arena.tl_region_mark)]
      [ok : bool (opt-inline-tiny-predicate-acyclic? blocks)]
      [scratch-head : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch-head)
          (arena.tl_region_reset mark))
        (set! opt-inline-verify-scratch-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set enclosing))
        ok))))

(define (opt-inline-revert-or-keep
  [fallback : ir.CompilerIrFunction]
  [next : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match next
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (if (opt-inline-structure-ok? blocks)
        next
        fallback)]))

(define (opt-inline-repair-or-keep
  [type-segment-bases : i64]
  [fallback : ir.CompilerIrFunction]
  [next : ir.CompilerIrFunction]
  [repair? : bool]) : ir.CompilerIrFunction
  (match next
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (if (opt-inline-structure-ok-reclaiming? blocks)
        (if repair?
          (opt-ssa-construct-function type-segment-bases next)
          next)
        fallback)]))

;; The measured tier's SEQUENTIAL per-site pricing, shared by both walk entries.
;;
;; A caller is walked once in SCAN mode. The checked band admits nothing there,
;; so that walk's result is exactly the caller's banked-band-only rewrite --
;; same input function, same census, same caller facts -- which is what makes
;; the baseline a restore rather than an approximation of one; and the same walk
;; ranks every candidate it passes over. A caller with no candidate stops there
;; and pays nothing.
;;
;; Then one ROUND per verdict, richest candidate first. A target walk rebuilds
;; the caller with every site already kept PLUS the round's one new site, and
;; the verdict prices exactly that difference against the state that preceded
;; it. Keep, and the new state carries the site into the next round; revert, and
;; the previous state is what the next round is priced against.
;;
;; WHY THE SEQUENCE. The all-or-nothing alternative -- admit every candidate in
;; one walk and price the lot -- can only accept or lose the whole set, and a
;; caller's sites are not all worth the same: the measured case is an interner
;; whose two leaves both belong in it and a third caller whose one accepted leaf
;; would be dragged out by a sibling that does not repay. Per-site rollback is
;; the only shape in which one caller can keep one callee and refuse another.
;;
;; WHY RICHEST FIRST, and it is load-bearing rather than tidiness: a verdict
;; prices its site against the state that precedes it, so a poor site taken
;; first spends a round AND leaves the rich site to be priced against a caller
;; already carrying the poor one's blocks -- both of which cost the rich site
;; its verdict. Ranking by the site's own free-inline worth puts the biggest
;; claim in front of the smallest state.
;;
;; The program budget is spent by the VERDICT, so a round whose target the
;; current state can no longer place -- the block ceiling counts the accepted
;; sites' blocks, and that is the ceiling doing its job -- costs one walk and no
;; budget, and the next candidate down the ranking is still measured.
(define (opt-inline-checked-callee-at [index : OptFunctionIndex] [slot : i64]) : OptMaybeFunction
  (if (or (< slot 0) (>= slot (opt-function-index-count index)))
    (OptMaybeFunction.No)
    (OptMaybeFunction.Some (array-ref index.values slot))))

(define (opt-inline-checked-keep?
  [type-segment-bases : i64]
  [index : OptFunctionIndex]
  [checked : ir.CompilerIrFunction]
  [banked : ir.CompilerIrFunction]
  [banked-cost : i64]) : bool
  (match (opt-inline-checked-callee-at index opt-inline-checked-callee-slot)
    [(OptMaybeFunction.Some callee)
      (opt-inline-checked-verdict-reclaiming
        type-segment-bases
        checked
        banked
        callee
        opt-inline-checked-site-depth
        opt-inline-checked-site-weight
        opt-inline-checked-callee-params
        banked-cost)]
    ;; No callee to price against: the site cannot be justified, so it goes --
    ;; and the state the next round is priced against is unchanged.
    [(OptMaybeFunction.No)
      (begin
        (set! opt-inline-checked-next-state-cost banked-cost)
        false)]))

(define (opt-inline-function-walk
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret vars blocks)
      (let
        [caller-blocks : i64 (ir.compiler-ir-block-list-count blocks)]
        [phi-predecessors : OptLabelSet
          (opt-inline-blocks-phi-predecessors-add blocks (OptLabelSet.Nil))]
        [_reset-sites : unit
          (begin
            (set! opt-inline-caller-site-count 0)
            (opt-inline-caller-facts-install! index census name blocks)
            (set!
              (array-ref opt-inline-pred-renames 0)
              (OptInlinePredRenameList.Nil)))]
        (match (opt-inline-blocks
          blocks
          phi-predecessors
          index
          census
          name
          vars
          caller-blocks
          0
          scc-result
          caller-scc)
          [(OptInlineBlocks.Blocks new-blocks new-vars added)
            (if (= opt-inline-caller-site-count 0)
              func
              (let
                [repaired-blocks : ir.CompilerIrBlockList
                  (opt-inline-repair-phi-predecessors
                    new-blocks
                    (opt-inline-pred-renames-shared-view))]
                (opt-inline-repair-or-keep
                  type-segment-bases
                  func
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret
                    new-vars
                    repaired-blocks)
                  (>
                    (+
                      added
                      (+
                        opt-inline-caller-hot-loop-blocks
                        (+
                          opt-inline-caller-chain-blocks
                          opt-inline-caller-accessor-blocks)))
                    0))))]))]))

;; One round: arm the richest remaining candidate, rebuild the caller with it,
;; price it against `state`, and recurse on whichever side the verdict names.
;; The recursion terminates because arming a target spends its scan row whether
;; or not the walk can still place it.
(define (opt-inline-checked-rounds
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [state : ir.CompilerIrFunction]
  [state-cost : i64]) : ir.CompilerIrFunction
  (if (not (opt-inline-checked-arm-next-target!))
    state
    (let
      [candidate : ir.CompilerIrFunction
        (opt-inline-function-walk
          type-segment-bases
          func
          index
          census
          scc-result
          caller-scc)]
      (if (not opt-inline-caller-checked-taken?)
        ;; The state that precedes this site no longer admits it. Nothing was
        ;; priced, so nothing is spent.
        (opt-inline-checked-rounds
          type-segment-bases
          func
          index
          census
          scc-result
          caller-scc
          state
          state-cost)
        (let
          [_spend : unit (opt-inline-checked-spend-verdict!)]
          [keep? : bool
            (opt-inline-checked-keep?
              type-segment-bases
              index
              candidate
              state
              state-cost)]
          [next-cost : i64 opt-inline-checked-next-state-cost]
          [_accept : unit
            (if keep?
              (opt-inline-checked-accept-target!)
              unit)]
          (opt-inline-checked-rounds
            type-segment-bases
            func
            index
            census
            scc-result
            caller-scc
            (if keep?
              candidate
              state)
            next-cost))))))

(define (opt-inline-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]) : ir.CompilerIrFunction
  (let
    [_begin : unit (opt-inline-checked-caller-begin!)]
    [banked : ir.CompilerIrFunction
      (opt-inline-function-walk
        type-segment-bases
        func
        index
        census
        scc-result
        caller-scc)]
    (if (= opt-inline-checked-scan-count 0)
      banked
      (opt-inline-checked-rounds
        type-segment-bases
        func
        index
        census
        scc-result
        caller-scc
        banked
        (- 0 1)))))

(define (opt-inline-function-with-spans-walk
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanProgram
  (match func
    [(ir.CompilerIrFunction.Function name params ret vars blocks)
      (let
        [caller-blocks : i64 (ir.compiler-ir-block-list-count blocks)]
        [phi-predecessors : OptLabelSet
          (opt-inline-blocks-phi-predecessors-add blocks (OptLabelSet.Nil))]
        [_reset-sites : unit
          (begin
            (set! opt-inline-caller-site-count 0)
            (opt-inline-caller-facts-install! index census name blocks)
            (set!
              (array-ref opt-inline-pred-renames 0)
              (OptInlinePredRenameList.Nil)))]
        (match (opt-inline-blocks-with-spans
          blocks
          phi-predecessors
          index
          census
          name
          vars
          caller-blocks
          0
          scc-result
          caller-scc
          source-spans
          out-spans)
          [(OptInlineSpanBlocks.Blocks new-blocks new-vars added next-spans)
            (if (= opt-inline-caller-site-count 0)
              (OptInlineSpanProgram.Program
                (ir.compiler-ir-function-cons
                  func
                  ir.CompilerIrFunctionList.Nil)
                out-spans)
              (let
                [repaired-blocks : ir.CompilerIrBlockList
                  (opt-inline-repair-phi-predecessors
                    new-blocks
                    (opt-inline-pred-renames-shared-view))]
                [next : ir.CompilerIrFunction
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret
                    new-vars
                    repaired-blocks)]
                (if (opt-inline-structure-ok-reclaiming? repaired-blocks)
                  (OptInlineSpanProgram.Program
                    (ir.compiler-ir-function-cons
                      (if (>
                        (+
                          added
                          (+
                            opt-inline-caller-hot-loop-blocks
                            (+
                              opt-inline-caller-chain-blocks
                              opt-inline-caller-accessor-blocks)))
                        0)
                        (opt-ssa-construct-function type-segment-bases next)
                        next)
                      ir.CompilerIrFunctionList.Nil)
                    next-spans)
                  (OptInlineSpanProgram.Program
                    (ir.compiler-ir-function-cons
                      func
                      ir.CompilerIrFunctionList.Nil)
                    out-spans))))]))]))

(define (opt-inline-span-program-function
  [program : OptInlineSpanProgram]
  [fallback : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match program
    [(OptInlineSpanProgram.Program one _)
      (match one
        [(ir.CompilerIrFunctionList.Cons head _) head]
        [(ir.CompilerIrFunctionList.Nil) fallback]
        [(ir.CompilerIrFunctionList.Array seq)
          (if (> (ir.compiler-ir-function-seq-count seq) 0)
            (ir.compiler-ir-function-seq-ref seq 0)
            fallback)])]))

;; Same sequence as the span-free entry. Re-walking is safe on the spans side,
;; but not for the reason the shape first suggests, so the argument is written
;; out here.
;;
;; A spans value is (slots, len) by value, and every round's walk starts from
;; the SAME `out-spans` value. Rounds therefore write their entries over each
;; other's slots rather than after them, and the survivor's `len` can end up
;; covering slots the LAST round wrote. What makes that harmless is that the
;; instruction table is a KEY->span map, not a positional record, and the round
;; ordering makes the last writer's key set a SUPERSET of the survivor's: a
;; round rebuilds the accepted sites and adds at most the one armed target, so
;; every key the survivor owns is also written by the last round, carrying the
;; same span for the same instruction. A lookup of a survivor key therefore
;; finds the survivor's span whichever round physically wrote the slot.
;;
;; That superset property is the invariant to preserve. A future round that can
;; REMOVE an accepted site, or a walk that renumbers the caller's own values so
;; the same instruction changes key between rounds, would break it -- and then
;; the survivor would have to be rebuilt by a final disarmed walk rather than
;; read back out of shared slots.
(define (opt-inline-checked-span-rounds
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]
  [state : OptInlineSpanProgram]
  [state-cost : i64]) : OptInlineSpanProgram
  (if (not (opt-inline-checked-arm-next-target!))
    state
    (let
      [candidate : OptInlineSpanProgram
        (opt-inline-function-with-spans-walk
          type-segment-bases
          func
          index
          census
          scc-result
          caller-scc
          source-spans
          out-spans)]
      (if (not opt-inline-caller-checked-taken?)
        (opt-inline-checked-span-rounds
          type-segment-bases
          func
          index
          census
          scc-result
          caller-scc
          source-spans
          out-spans
          state
          state-cost)
        (let
          [_spend : unit (opt-inline-checked-spend-verdict!)]
          [keep? : bool
            (opt-inline-checked-keep?
              type-segment-bases
              index
              (opt-inline-span-program-function candidate func)
              (opt-inline-span-program-function state func)
              state-cost)]
          [next-cost : i64 opt-inline-checked-next-state-cost]
          [_accept : unit
            (if keep?
              (opt-inline-checked-accept-target!)
              unit)]
          (opt-inline-checked-span-rounds
            type-segment-bases
            func
            index
            census
            scc-result
            caller-scc
            source-spans
            out-spans
            (if keep?
              candidate
              state)
            next-cost))))))

(define (opt-inline-function-with-spans
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [caller-scc : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanProgram
  (let
    [_begin : unit (opt-inline-checked-caller-begin!)]
    [banked : OptInlineSpanProgram
      (opt-inline-function-with-spans-walk
        type-segment-bases
        func
        index
        census
        scc-result
        caller-scc
        source-spans
        out-spans)]
    (if (= opt-inline-checked-scan-count 0)
      banked
      (opt-inline-checked-span-rounds
        type-segment-bases
        func
        index
        census
        scc-result
        caller-scc
        source-spans
        out-spans
        banked
        (- 0 1)))))

(define (opt-function-index-to-list [index : OptFunctionIndex]) : ir.CompilerIrFunctionList
  (ir.CompilerIrFunctionList.Array
    (ir.CompilerIrFunctionSeq index.values (opt-function-index-count index))))

(define (opt-inline-slot-order [scc-result : OptSccResult]) : (__tl_dyn-array
    i64)
  (let
    [order : (__tl_dyn-array i64) scc-result.order]
    [scc-of : (__tl_dyn-array i64) scc-result.scc-of]
    [slot-count : i64 (array-length scc-of)]
    [scc-count : i64 (array-length order)]
    [counts : (__tl_dyn-array i64) (array.make-array i64 scc-count)]
    [starts : (__tl_dyn-array i64) (array.make-array i64 scc-count)]
    [next : (__tl_dyn-array i64) (array.make-array i64 scc-count)]
    [slots : (__tl_dyn-array i64) (array.make-array i64 slot-count)]
    [slot : i64 0]
    [order-index : i64 0]
    [offset : i64 0]
    (begin
      (while (< slot slot-count)
        (let
          [scc-id : i64 (array-ref scc-of slot)]
          (begin
            (set! (array-ref counts scc-id) (+ (array-ref counts scc-id) 1))
            (set! slot (+ slot 1)))))
      (while (< order-index scc-count)
        (let
          [scc-id : i64 (array-ref order order-index)]
          (begin
            (set! (array-ref starts scc-id) offset)
            (set! (array-ref next scc-id) offset)
            (set! offset (+ offset (array-ref counts scc-id)))
            (set! order-index (+ order-index 1)))))
      (set! slot 0)
      (while (< slot slot-count)
        (let
          [scc-id : i64 (array-ref scc-of slot)]
          [slot-index : i64 (array-ref next scc-id)]
          (begin
            (set! (array-ref slots slot-index) slot)
            (set! (array-ref next scc-id) (+ slot-index 1))
            (set! slot (+ slot 1)))))
      slots)))

;; ---- opt1 tiny-leaf inlining -----------------------------------------------
;; The cheap level inlines only call-free single-block accessor callees whose
;; body holds at most opt-inline-tiny-leaf-max-body instructions before the
;; return. Call-free admission makes SCC ordering, census, and devirt
;; unnecessary: an admitted body contains no call sites, so it can never
;; change during the pass (one program walk in any order is confluent) and a
;; self-recursive callee can never be admitted. Splices reuse the level-2
;; single-block expansion, add no blocks, and keep SSA form, so no
;; reconstruction runs. Functions without an admitted call site are probed
;; read-only and returned untouched.
(define (opt-inline-tiny-leaf-max-body) : i64
  8)

(define (opt-inline-tiny-leaf-seq-call-free-from?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]) : bool
  (if (>= pos count)
    true
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.Call _ _ _ _) false]
      [(ir.CompilerIrInstr.CallIndirect _ _ _ _) false]
      [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) false]
      [_ (opt-inline-tiny-leaf-seq-call-free-from? instrs (+ pos 1) count)])))

(define (opt-inline-tiny-leaf-blocks-call-free?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Cons block _)
      (match block
        [(ir.CompilerIrBlock.Block _ seq)
          (opt-inline-tiny-leaf-seq-call-free-from?
            seq
            0
            (ir.compiler-ir-instr-seq-count seq))])]
    [(ir.CompilerIrBlockList.Array seq)
      (if (= (ir.compiler-ir-block-seq-count seq) 1)
        (match (ir.compiler-ir-block-seq-ref seq 0)
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-inline-tiny-leaf-seq-call-free-from?
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs))])
        false)]
    [_ false]))

(define (opt-inline-tiny-leaf-callee-ok? [callee : ir.CompilerIrFunction]) : bool
  (match callee
    [(ir.CompilerIrFunction.Function _ cparams _ cvars cblocks)
      (let
        [np : i64 (opt-inline-param-count cparams)]
        (and
          (not (opt-inline-params-have-private-memory? cparams))
          (opt-inline-params-sequential? cparams 0)
          (>= cvars np)
          (opt-inline-single-block-ok? cblocks np)
          (<=
            (opt-inline-single-block-cost-instrs cblocks)
            (opt-inline-tiny-leaf-max-body))
          (opt-inline-tiny-leaf-blocks-call-free? cblocks)))]))

(define (opt-inline-tiny-leaf-admitted-flags [index : OptFunctionIndex]) : (__tl_dyn-array
    bool)
  (let
    [count : i64 (opt-function-index-count index)]
    [values : (__tl_dyn-array ir.CompilerIrFunction) index.values]
    [flags : (__tl_dyn-array bool)
      (make-array
        bool
        (if (> count 0)
          count
          1))]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set!
            (array-ref flags i)
            (opt-inline-tiny-leaf-callee-ok? (array-ref values i)))
          (set! i (+ i 1))))
      flags)))

(define (opt-inline-tiny-leaf-lookup
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [cname : i64]) : OptMaybeFunction
  (match (opt-function-index-slot index cname)
    [(option_i64.Some slot)
      (if (array-ref flags slot)
        (OptMaybeFunction.Some (array-ref index.values slot))
        (OptMaybeFunction.No))]
    [(option_i64.None) (OptMaybeFunction.No)]))

(define (opt-inline-tiny-leaf-site?
  [instr : ir.CompilerIrInstr]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ cname cargs _)
      (match (opt-inline-tiny-leaf-lookup index flags cname)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(ir.CompilerIrFunction.Function _ cparams _ _ _)
              (opt-inline-arity-ok? cargs (opt-inline-param-count cparams))])]
        [(OptMaybeFunction.No) false])]
    [_ false]))

(define (opt-inline-tiny-leaf-seq-has-site-from?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : bool
  (if (>= pos count)
    false
    (if (opt-inline-tiny-leaf-site?
      (ir.compiler-ir-instr-seq-ref instrs pos)
      index
      flags)
      true
      (opt-inline-tiny-leaf-seq-has-site-from?
        instrs
        (+ pos 1)
        count
        index
        flags))))

(define (opt-inline-tiny-leaf-seq-has-site?
  [instrs : ir.CompilerIrInstrSeq]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : bool
  (opt-inline-tiny-leaf-seq-has-site-from?
    instrs
    0
    (ir.compiler-ir-instr-seq-count instrs)
    index
    flags))

(define (opt-inline-tiny-leaf-block-has-site?
  [block : ir.CompilerIrBlock]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ seq)
      (opt-inline-tiny-leaf-seq-has-site? seq index flags)]))

(define (opt-inline-tiny-leaf-blocks-have-site?
  [blocks : ir.CompilerIrBlockList]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-inline-tiny-leaf-block-has-site? block index flags)
        true
        (opt-inline-tiny-leaf-blocks-have-site?
          (__tl-box-place rest)
          index
          flags))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-tiny-leaf-block-seq-has-site? seq 0 index flags)]))

(define (opt-inline-tiny-leaf-block-seq-has-site?
  [blocks : ir.CompilerIrBlockSeq]
  [pos : i64]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : bool
  (if (>= pos (ir.compiler-ir-block-seq-count blocks))
    false
    (if (opt-inline-tiny-leaf-block-has-site?
      (ir.compiler-ir-block-seq-ref blocks pos)
      index
      flags)
      true
      (opt-inline-tiny-leaf-block-seq-has-site? blocks (+ pos 1) index flags))))

(define (opt-inline-tiny-leaf-try
  [instr : ir.CompilerIrInstr]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]) : OptInlineState
  (match instr
    [(ir.CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-tiny-leaf-lookup index flags cname)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(ir.CompilerIrFunction.Function
                callee-name
                cparams
                _
                cvars
                cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (begin
                    (set!
                      opt-inline-caller-site-count
                      (+ opt-inline-caller-site-count 1))
                    (OptInlineState.State
                      (opt-inline-expand-instrs
                        (opt-inline-single-block-instrs cblocks)
                        dst
                        cret
                        cargs
                        np
                        vars
                        (opt-inline-site-prefix
                          func-name
                          block-label
                          site-pos
                          callee-name))
                      (+ vars (opt-inline-frame-growth cvars np))
                      0))
                  (OptInlineState.State
                    (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
                    vars
                    0)))])]
        [(OptMaybeFunction.No)
          (OptInlineState.State
            (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
            vars
            0)])]
    [_
      (OptInlineState.State
        (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
        vars
        0)]))

(define (opt-inline-tiny-leaf-walk-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]) : OptInlineState
  (if (>= pos end)
    (OptInlineState.State ir.CompilerIrInstrList.Nil vars 0)
    (match (opt-inline-tiny-leaf-try
      (ir.compiler-ir-instr-seq-ref instrs pos)
      index
      flags
      func-name
      block-label
      site-pos
      vars)
      [(OptInlineState.State expanded vars2 _)
        (match (opt-inline-tiny-leaf-walk-seq-from
          instrs
          (+ pos 1)
          end
          index
          flags
          func-name
          block-label
          (+ site-pos 1)
          vars2)
          [(OptInlineState.State rest-list vars3 _)
            (OptInlineState.State
              (opt-inline-append expanded rest-list)
              vars3
              0)])])))

(define (opt-inline-tiny-leaf-rewrite-block
  [block : ir.CompilerIrBlock]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [vars : i64]) : OptInlineBlocks
  (match block
    [(ir.CompilerIrBlock.Block label seq)
      (if (not (opt-inline-tiny-leaf-seq-has-site? seq index flags))
        (OptInlineBlocks.Blocks
          (ir.compiler-ir-block-cons block ir.CompilerIrBlockList.Nil)
          vars
          0)
        (match (opt-inline-tiny-leaf-walk-seq-from
          seq
          0
          (ir.compiler-ir-instr-seq-count seq)
          index
          flags
          func-name
          label
          0
          vars)
          [(OptInlineState.State new-instrs vars2 _)
            (OptInlineBlocks.Blocks
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block label new-instrs)
                ir.CompilerIrBlockList.Nil)
              vars2
              0)]))]))

(define (opt-inline-tiny-leaf-blocks
  [blocks : ir.CompilerIrBlockList]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [vars : i64]) : OptInlineBlocks
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptInlineBlocks.Blocks ir.CompilerIrBlockList.Nil vars 0)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-inline-tiny-leaf-rewrite-block
        block
        index
        flags
        func-name
        vars)
        [(OptInlineBlocks.Blocks rewritten vars2 _)
          (match (opt-inline-tiny-leaf-blocks
            (__tl-box-place rest)
            index
            flags
            func-name
            vars2)
            [(OptInlineBlocks.Blocks rest-blocks vars3 _)
              (OptInlineBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                0)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-tiny-leaf-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        index
        flags
        func-name
        vars)]))

(define (opt-inline-tiny-leaf-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret vars blocks)
      (if (not (opt-inline-tiny-leaf-blocks-have-site? blocks index flags))
        func
        (begin
          (set! opt-inline-caller-site-count 0)
          (match (opt-inline-tiny-leaf-blocks blocks index flags name vars)
            [(OptInlineBlocks.Blocks new-blocks new-vars _)
              (if (= opt-inline-caller-site-count 0)
                func
                (opt-inline-repair-or-keep
                  type-segment-bases
                  func
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret
                    new-vars
                    new-blocks)
                  false))])))]))

(define (opt-inline-tiny-leaf-program-functions
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]) : ir.CompilerIrFunctionList
  (let
    [index : OptFunctionIndex (opt-function-index-build functions)]
    [flags : (__tl_dyn-array bool) (opt-inline-tiny-leaf-admitted-flags index)]
    [values : (__tl_dyn-array ir.CompilerIrFunction) index.values]
    [count : i64 (opt-function-index-count index)]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set!
            (array-ref values i)
            (opt-inline-tiny-leaf-function
              type-segment-bases
              (array-ref values i)
              index
              flags))
          (set! i (+ i 1))))
      (opt-function-index-to-list index))))

(define (opt-inline-tiny-leaf-try-with-spans
  [instr : ir.CompilerIrInstr]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanState
  (match instr
    [(ir.CompilerIrInstr.Call dst cname cargs cret)
      (match (opt-inline-tiny-leaf-lookup index flags cname)
        [(OptMaybeFunction.Some callee)
          (match callee
            [(ir.CompilerIrFunction.Function
                callee-name
                cparams
                _
                cvars
                cblocks)
              (let
                [np : i64 (opt-inline-param-count cparams)]
                (if (opt-inline-arity-ok? cargs np)
                  (begin
                    (set!
                      opt-inline-caller-site-count
                      (+ opt-inline-caller-site-count 1))
                    (match (opt-inline-expand-instrs-with-spans
                      (opt-inline-single-block-instrs cblocks)
                      dst
                      cret
                      cargs
                      np
                      vars
                      (opt-inline-site-prefix
                        func-name
                        block-label
                        site-pos
                        callee-name)
                      source-spans
                      out-spans
                      func-name
                      instr
                      cname)
                      [(OptInlineSpanState.State expanded _ _ next-spans)
                        (OptInlineSpanState.State
                          expanded
                          (+ vars (opt-inline-frame-growth cvars np))
                          0
                          next-spans)]))
                  (OptInlineSpanState.State
                    (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
                    vars
                    0
                    out-spans)))])]
        [(OptMaybeFunction.No)
          (OptInlineSpanState.State
            (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
            vars
            0
            out-spans)])]
    [_
      (OptInlineSpanState.State
        (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)
        vars
        0
        out-spans)]))

(define (opt-inline-tiny-leaf-walk-seq-with-spans-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [end : i64]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [block-label : i64]
  [site-pos : i64]
  [vars : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanState
  (if (>= pos end)
    (OptInlineSpanState.State ir.CompilerIrInstrList.Nil vars 0 out-spans)
    (match (opt-inline-tiny-leaf-try-with-spans
      (ir.compiler-ir-instr-seq-ref instrs pos)
      index
      flags
      func-name
      block-label
      site-pos
      vars
      source-spans
      out-spans)
      [(OptInlineSpanState.State expanded vars2 _ spans2)
        (match (opt-inline-tiny-leaf-walk-seq-with-spans-from
          instrs
          (+ pos 1)
          end
          index
          flags
          func-name
          block-label
          (+ site-pos 1)
          vars2
          source-spans
          spans2)
          [(OptInlineSpanState.State rest-list vars3 _ spans3)
            (OptInlineSpanState.State
              (opt-inline-append expanded rest-list)
              vars3
              0
              spans3)])])))

(define (opt-inline-tiny-leaf-rewrite-block-with-spans
  [block : ir.CompilerIrBlock]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [vars : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanBlocks
  (match block
    [(ir.CompilerIrBlock.Block label seq)
      (if (not (opt-inline-tiny-leaf-seq-has-site? seq index flags))
        (OptInlineSpanBlocks.Blocks
          (ir.compiler-ir-block-cons block ir.CompilerIrBlockList.Nil)
          vars
          0
          out-spans)
        (match (opt-inline-tiny-leaf-walk-seq-with-spans-from
          seq
          0
          (ir.compiler-ir-instr-seq-count seq)
          index
          flags
          func-name
          label
          0
          vars
          source-spans
          out-spans)
          [(OptInlineSpanState.State new-instrs vars2 _ spans2)
            (OptInlineSpanBlocks.Blocks
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block label new-instrs)
                ir.CompilerIrBlockList.Nil)
              vars2
              0
              spans2)]))]))

(define (opt-inline-tiny-leaf-blocks-with-spans
  [blocks : ir.CompilerIrBlockList]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [func-name : i64]
  [vars : i64]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanBlocks
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptInlineSpanBlocks.Blocks ir.CompilerIrBlockList.Nil vars 0 out-spans)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-inline-tiny-leaf-rewrite-block-with-spans
        block
        index
        flags
        func-name
        vars
        source-spans
        out-spans)
        [(OptInlineSpanBlocks.Blocks rewritten vars2 _ spans2)
          (match (opt-inline-tiny-leaf-blocks-with-spans
            (__tl-box-place rest)
            index
            flags
            func-name
            vars2
            source-spans
            spans2)
            [(OptInlineSpanBlocks.Blocks rest-blocks vars3 _ spans3)
              (OptInlineSpanBlocks.Blocks
                (opt-inline-block-append rewritten rest-blocks)
                vars3
                0
                spans3)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-inline-tiny-leaf-blocks-with-spans
        (ir.compiler-ir-block-seq-to-list seq)
        index
        flags
        func-name
        vars
        source-spans
        out-spans)]))

(define (opt-inline-tiny-leaf-function-with-spans
  [func : ir.CompilerIrFunction]
  [index : OptFunctionIndex]
  [flags : (__tl_dyn-array bool)]
  [source-spans : ir.CompilerSourceSpans]
  [out-spans : ir.CompilerSourceSpans]) : OptInlineSpanProgram
  (match func
    [(ir.CompilerIrFunction.Function name params ret vars blocks)
      (if (not (opt-inline-tiny-leaf-blocks-have-site? blocks index flags))
        (OptInlineSpanProgram.Program
          (ir.compiler-ir-function-cons func ir.CompilerIrFunctionList.Nil)
          out-spans)
        (begin
          (set! opt-inline-caller-site-count 0)
          (match (opt-inline-tiny-leaf-blocks-with-spans
            blocks
            index
            flags
            name
            vars
            source-spans
            out-spans)
            [(OptInlineSpanBlocks.Blocks new-blocks new-vars _ next-spans)
              (if (= opt-inline-caller-site-count 0)
                (OptInlineSpanProgram.Program
                  (ir.compiler-ir-function-cons
                    func
                    ir.CompilerIrFunctionList.Nil)
                  out-spans)
                (if (opt-inline-structure-ok-reclaiming? new-blocks)
                  (OptInlineSpanProgram.Program
                    (ir.compiler-ir-function-cons
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret
                        new-vars
                        new-blocks)
                      ir.CompilerIrFunctionList.Nil)
                    next-spans)
                  (OptInlineSpanProgram.Program
                    (ir.compiler-ir-function-cons
                      func
                      ir.CompilerIrFunctionList.Nil)
                    out-spans)))])))]))

(define (opt-inline-tiny-leaf-program-functions-with-spans
  [functions : ir.CompilerIrFunctionList]
  [spans : ir.CompilerSourceSpans]) : OptInlineSpanProgram
  (let
    [index : OptFunctionIndex (opt-function-index-build functions)]
    [flags : (__tl_dyn-array bool) (opt-inline-tiny-leaf-admitted-flags index)]
    [values : (__tl_dyn-array ir.CompilerIrFunction) index.values]
    [count : i64 (opt-function-index-count index)]
    [i : i64 0]
    [current-spans : ir.CompilerSourceSpans spans]
    (begin
      (while (< i count)
        (begin
          (match (opt-inline-tiny-leaf-function-with-spans
            (array-ref values i)
            index
            flags
            current-spans
            current-spans)
            [(OptInlineSpanProgram.Program one next-spans)
              (begin
                (match one
                  [(ir.CompilerIrFunctionList.Cons head _)
                    (set! (array-ref values i) head)]
                  [(ir.CompilerIrFunctionList.Nil) unit]
                  [(ir.CompilerIrFunctionList.Array seq)
                    (if (> (ir.compiler-ir-function-seq-count seq) 0)
                      (set!
                        (array-ref values i)
                        (ir.compiler-ir-function-seq-ref seq 0))
                      unit)])
                (set! current-spans next-spans))])
          (set! i (+ i 1))))
      (OptInlineSpanProgram.Program
        (opt-function-index-to-list index)
        current-spans))))

(define (opt-inline-process-scc-order!
  [type-segment-bases : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]) : unit
  (let
    [scc-of : (__tl_dyn-array i64) scc-result.scc-of]
    [values : (__tl_dyn-array ir.CompilerIrFunction) index.values]
    [slot-order : (__tl_dyn-array i64) (opt-inline-slot-order scc-result)]
    [index-pos : i64 0]
    [slot-count : i64 (array-length slot-order)]
    (while (< index-pos slot-count)
      (begin
        (let
          [slot : i64 (array-ref slot-order index-pos)]
          [caller-scc : i64 (array-ref scc-of slot)]
          (set!
            (array-ref values slot)
            (opt-inline-function
              type-segment-bases
              (array-ref values slot)
              index
              census
              scc-result
              caller-scc)))
        (set! index-pos (+ index-pos 1))))))

(define (opt-inline-process-scc-order-with-spans
  [type-segment-bases : i64]
  [index : OptFunctionIndex]
  [census : OptInlineCensus]
  [scc-result : OptSccResult]
  [spans : ir.CompilerSourceSpans]) : ir.CompilerSourceSpans
  (let
    [scc-of : (__tl_dyn-array i64) scc-result.scc-of]
    [values : (__tl_dyn-array ir.CompilerIrFunction) index.values]
    [slot-order : (__tl_dyn-array i64) (opt-inline-slot-order scc-result)]
    [index-pos : i64 0]
    [slot-count : i64 (array-length slot-order)]
    [current-spans : ir.CompilerSourceSpans spans]
    (begin
      (while (< index-pos slot-count)
        (begin
          (let
            [slot : i64 (array-ref slot-order index-pos)]
            [caller-scc : i64 (array-ref scc-of slot)]
            (match (opt-inline-function-with-spans
              type-segment-bases
              (array-ref values slot)
              index
              census
              scc-result
              caller-scc
              current-spans
              current-spans)
              [(OptInlineSpanProgram.Program one next-spans)
                (begin
                  (match one
                    [(ir.CompilerIrFunctionList.Cons head _)
                      (set! (array-ref values slot) head)]
                    [(ir.CompilerIrFunctionList.Nil) unit]
                    [(ir.CompilerIrFunctionList.Array seq)
                      (if (> (ir.compiler-ir-function-seq-count seq) 0)
                        (set!
                          (array-ref values slot)
                          (ir.compiler-ir-function-seq-ref seq 0))
                        unit)])
                  (set! current-spans next-spans))]))
          (set! index-pos (+ index-pos 1))))
      current-spans)))

;; Inline small single-block leaf callees across the whole program. Level 2
;; (the register-allocated quality build) runs the full census/SCC pipeline;
;; level 1 runs only the call-free tiny-leaf pass above.
(define (opt-inline-program-functions
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [level : i64]) : ir.CompilerIrFunctionList
  (if (< level 2)
    (if (= level 1)
      (opt-inline-tiny-leaf-program-functions type-segment-bases functions)
      functions)
    (let
      [devirt : ir.CompilerIrFunctionList
        (opt-devirt-known-function-list functions)]
      [index : OptFunctionIndex (opt-function-index-build devirt)]
      [graph : OptCallGraph (opt-callgraph-build index)]
      [scc-result : OptSccResult (opt-scc-compute graph)]
      [census : OptInlineCensus (opt-inline-census-build index devirt)]
      [verify-scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! opt-inline-verify-scratch-arena verify-scratch)
        (opt-inline-checked-program-begin!)
        (opt-inline-multiblock-ok-memo-install! index)
        (opt-inline-process-scc-order!
          type-segment-bases
          index
          census
          scc-result)
        (let
          [out : ir.CompilerIrFunctionList (opt-function-index-to-list index)]
          [scratch-head : i64 opt-inline-verify-scratch-arena]
          (begin
            (set! opt-inline-verify-scratch-arena 0)
            (opt-inline-multiblock-ok-memo-reset!)
            (unsafe
              (arena.tl_arena_destroy scratch-head))
            out))))))

(define (opt-inline-program-functions-with-spans
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [level : i64]
  [spans : ir.CompilerSourceSpans]) : OptInlineSpanProgram
  (if (< level 2)
    (if (= level 1)
      (opt-inline-tiny-leaf-program-functions-with-spans functions spans)
      (OptInlineSpanProgram.Program functions spans))
    (let
      [devirt : ir.CompilerIrFunctionList
        (opt-devirt-known-function-list functions)]
      [index : OptFunctionIndex (opt-function-index-build devirt)]
      [graph : OptCallGraph (opt-callgraph-build index)]
      [scc-result : OptSccResult (opt-scc-compute graph)]
      [census : OptInlineCensus (opt-inline-census-build index devirt)]
      [verify-scratch : i64 (arena.tl_arena_make)]
      [_install-verify-scratch : unit
        (set! opt-inline-verify-scratch-arena verify-scratch)]
      [_begin-checked : unit (opt-inline-checked-program-begin!)]
      [_install-multiblock-memo : unit
        (opt-inline-multiblock-ok-memo-install! index)]
      [next-spans : ir.CompilerSourceSpans
        (opt-inline-process-scc-order-with-spans
          type-segment-bases
          index
          census
          scc-result
          spans)]
      [out : OptInlineSpanProgram
        (OptInlineSpanProgram.Program
          (opt-function-index-to-list index)
          next-spans)]
      [scratch-head : i64 opt-inline-verify-scratch-arena]
      (begin
        (set! opt-inline-verify-scratch-arena 0)
        (opt-inline-multiblock-ok-memo-reset!)
        (unsafe
          (arena.tl_arena_destroy scratch-head))
        out))))

(define (opt-function-list-defines?
  [functions : ir.CompilerIrFunctionList]
  [name : String]) : bool
  (match functions
    [(ir.CompilerIrFunctionList.Nil) false]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function func-name _ _ _ _)
          (if (string.eq (ir.compiler-ir-symbol-text func-name) name)
            true
            (opt-function-list-defines? (__tl-box-place rest) name))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-function-list-defines?
        (ir.compiler-ir-function-seq-to-list seq)
        name)]))

(define (opt-function-list-find
  [functions : ir.CompilerIrFunctionList]
  [name : String]) : OptMaybeFunction
  (match functions
    [(ir.CompilerIrFunctionList.Nil) (OptMaybeFunction.No)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function func-name _ _ _ _)
          (if (string.eq (ir.compiler-ir-symbol-text func-name) name)
            (OptMaybeFunction.Some func)
            (opt-function-list-find (__tl-box-place rest) name))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-function-list-find (ir.compiler-ir-function-seq-to-list seq) name)]))

;; Resolve `name` to its dense index slot with a single `ids` probe (the one
;; name->key lookup the reachability walk needs); a name that names no function in
;; this index is a no-op. The reachable set and worklist then key on that slot, so
;; the dedup, membership, and pop-and-resolve are i64 compares -- no per-edge
;; string_eq, and no global intern-table mutation (IR names are transient-arena
;; strings, so interning them would dangle a table pointer after the rewind).
(define (opt-reach-add-function
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [name : i64]) : OptReachState
  (match (opt-function-index-slot index name)
    [(option_i64.None) state]
    [(option_i64.Some slot) (opt-reach-add-function-slot state slot)]))

(define (opt-reach-add-function-slot
  [state : OptReachState (:consume)]
  [slot : i64]) : OptReachState
  (match state
    [(OptReachState.State reachable worklist globals runtime-helper-mask)
      (if (opt_i64_i64_map.contains? (& reachable) slot)
        state
        (let
          [next-reachable : opt_i64_i64_map.Map reachable]
          (begin
            (opt_i64_i64_map.insert-ref! (&mut next-reachable) slot 1)
            (OptReachState.State
              next-reachable
              (opt-reach-worklist-push worklist slot)
              globals
              runtime-helper-mask))))]))

(define (opt-reach-add-global [state : OptReachState (:consume)] [name : i64]) : OptReachState
  (match state
    [(OptReachState.State reachable worklist globals runtime-helper-mask)
      (let
        [name-id : i64 (ir.compiler-ir-symbol-id name)]
        (if (or (< name-id 0) (opt_i64_i64_map.contains? (& globals) name-id))
          state
          (begin
            (opt_i64_i64_map.insert-ref! (&mut globals) name-id 1)
            (OptReachState.State reachable worklist globals runtime-helper-mask))))]))

(define (opt-reach-add-function-leaf-from
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [leaf : String]
  [slot : i64]
  [count : i64]) : OptReachState
  (if (>= slot count)
    state
    (match (array-ref index.values slot)
      [(ir.CompilerIrFunction.Function name _ _ _ _)
        (opt-reach-add-function-leaf-from
          index
          (if (opt-symbol-leaf-matches-from?
            (ir.compiler-ir-symbol-text name)
            (array-ref index.leaf-starts slot)
            leaf)
            (opt-reach-add-function index state name)
            state)
          leaf
          (+ slot 1)
          count)])))

(define (opt-reach-add-function-leaf
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [leaf : String]) : OptReachState
  (opt-reach-add-function-leaf-from
    index
    state
    leaf
    0
    (opt-function-index-count index)))

(define (opt-runtime-prelude-string-helper [source-name : String]) : OptRuntimeStringHelper
  (let
    [start : i64 (opt-symbol-leaf-start source-name)]
    [n : i64 (string.string-length source-name)]
    ;; Cheap gate: every prelude helper leaf starts with "tl_" -- reject the
    ;; overwhelming majority of call targets with three char compares before
    ;; the exact per-name checks (all allocation-free).
    (if (or
      (< (- n start) 3)
      (not (= (string.string-ref source-name start) 't'))
      (not (= (string.string-ref source-name (+ start 1)) 'l'))
      (not (= (string.string-ref source-name (+ start 2)) '_')))
      (OptRuntimeStringHelper.No)
      (cond
        [(opt-symbol-leaf-matches-from? source-name start "tl_int_to_string")
          (OptRuntimeStringHelper.Some "int-to-string" 1)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_substring")
          (OptRuntimeStringHelper.Some "substring" 2)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_str_view")
          (OptRuntimeStringHelper.Some "str-view" 4)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat")
          (OptRuntimeStringHelper.Some "string-concat" 8)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat3")
          (OptRuntimeStringHelper.Some "string-concat3" 16)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat4")
          (OptRuntimeStringHelper.Some "string-concat4" 32)]
        [(opt-symbol-leaf-matches-from? source-name start "tl_string_concat5")
          (OptRuntimeStringHelper.Some "string-concat5" 64)]
        [else (OptRuntimeStringHelper.No)]))))

(define (opt-reach-add-runtime-prelude-string-helper
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [source-name : String]) : OptReachState
  (match (opt-runtime-prelude-string-helper source-name)
    [(OptRuntimeStringHelper.No) state]
    [(OptRuntimeStringHelper.Some helper helper-bit)
      (match state
        [(OptReachState.State _ _ _ runtime-helper-mask)
          (if (not (= (bit-and runtime-helper-mask helper-bit) 0))
            state
            ;; A self-compile contains hundreds of calls to these helpers. The
            ;; leaf scan retains every source-path spelling, but only needs to run
            ;; once per fixed runtime helper.
            (match (opt-reach-add-function-leaf index state helper)
              [(OptReachState.State reachable worklist globals mask)
                (OptReachState.State
                  reachable
                  worklist
                  globals
                  (bit-or mask helper-bit))]))])]))

(define (opt-reach-add-call-target
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [name : i64]) : OptReachState
  (opt-reach-add-runtime-prelude-string-helper
    index
    (opt-reach-add-function index state name)
    (ir.compiler-ir-symbol-text name)))

(define (opt-reach-value
  [index : OptFunctionIndex]
  [state : OptReachState]
  [value : ir.CompilerIrValue]) : OptReachState
  (match value
    [(ir.CompilerIrValue.Global name)
      (opt-reach-add-function index (opt-reach-add-global state name) name)]
    [(ir.CompilerIrValue.GlobalAddr name)
      (opt-reach-add-function index (opt-reach-add-global state name) name)]
    [(ir.CompilerIrValue.Function name)
      (opt-reach-add-function index state name)]
    [(ir.CompilerIrValue.RuntimeGlobal init)
      (opt-reach-add-function index state init)]
    [_ state]))

(define (opt-reach-call-args-array
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [arg-index : i64]) : OptReachState
  (if (>= arg-index (array-length values))
    state
    (opt-reach-call-args-array
      index
      (opt-reach-value index state (array-ref values arg-index))
      values
      (+ arg-index 1))))

(define (opt-reach-call-args
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [args : ir.CompilerIrCallArgs]) : OptReachState
  (match args
    [(ir.CompilerIrCallArgs.Nil) state]
    [(ir.CompilerIrCallArgs.One value) (opt-reach-value index state value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (opt-reach-value index (opt-reach-value index state a) b)]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-reach-call-args-array index state values 0)]))

(define (opt-reach-spmd-call-args
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [args : ir.CompilerIrSpmdCallArgList]) : OptReachState
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) state]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (opt-reach-spmd-call-args
            index
            (opt-reach-value index state value)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : OptReachState state]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-reach-value index out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-reach-maybe-value
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [maybe : ir.CompilerIrMaybeValue]) : OptReachState
  (match maybe
    [(ir.CompilerIrMaybeValue.No) state]
    [(ir.CompilerIrMaybeValue.Some value) (opt-reach-value index state value)]))

(define (opt-reach-phi-inputs
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [inputs : ir.CompilerIrPhiInputList]) : OptReachState
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) state]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-reach-phi-inputs
        index
        state
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (opt-reach-phi-inputs
        index
        (opt-reach-value index state value)
        (__tl-box-place rest))]))

(define (opt-reach-instr
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instr : ir.CompilerIrInstr]) : OptReachState
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.Alloc _ _) state]
    [(ir.CompilerIrInstr.AddrOf _ _) state]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (opt-reach-value index (opt-reach-value index state base) offset)]
    [(ir.CompilerIrInstr.Load _ src _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.StorePtr dst src _)
      (opt-reach-value index (opt-reach-value index state dst) src)]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (opt-reach-value index (opt-reach-value index state dst) src)]
    [(ir.CompilerIrInstr.BoundsCheck idx length _)
      (opt-reach-value index (opt-reach-value index state idx) length)]
    [(ir.CompilerIrInstr.Cast _ src _ _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-reach-value index (opt-reach-value index state lhs) rhs)]
    [(ir.CompilerIrInstr.UnOp _ _ src _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.LaneId _ _ _) state]
    [(ir.CompilerIrInstr.Splat _ value _ _) (opt-reach-value index state value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-reach-value index (opt-reach-value index state lhs) rhs))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (opt-reach-value index (opt-reach-value index state src) carry))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-reach-value index (opt-reach-value index state lhs) rhs))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-reach-value index (opt-reach-value index state lhs) rhs)]
    [(ir.CompilerIrInstr.MaskNot _ src _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (opt-reach-value
          index
          (opt-reach-value index (opt-reach-value index state mask) on-true)
          on-false))]
    [(ir.CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-reach-value index (opt-reach-value index state base) idx)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (opt-reach-value
          index
          (opt-reach-value index (opt-reach-value index state base) idx)
          value))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-reach-value
          index
          (opt-reach-value
            index
            (opt-reach-value index (opt-reach-value index state base) idx)
            value)
          mask))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-reach-value
          index
          (opt-reach-value index (opt-reach-value index state base) idx)
          mask))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        (opt-reach-value
          index
          (opt-reach-value index (opt-reach-value index state base) index-base)
          idx))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (opt-reach-value
          index
          (opt-reach-maybe-value
            index
            (opt-reach-value
              index
              (opt-reach-value index state source)
              selector-low)
            selector-high)
          active-lanes))]
    [(ir.CompilerIrInstr.TailMask _ idx length _)
      (opt-reach-value index (opt-reach-value index state idx) length)]
    [(ir.CompilerIrInstr.EntryArgc _) state]
    [(ir.CompilerIrInstr.EntryArgv _) state]
    [(ir.CompilerIrInstr.EntryEnvp _) state]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-reach-value index (opt-reach-value index state leaf) subleaf)]
    [(ir.CompilerIrInstr.Xgetbv _ idx) (opt-reach-value index state idx)]
    [(ir.CompilerIrInstr.Syscall _ args) (opt-reach-call-args index state args)]
    [(ir.CompilerIrInstr.Call _ name args _)
      (opt-reach-add-call-target
        index
        (opt-reach-call-args index state args)
        name)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-reach-add-call-target
          index
          (opt-reach-call-args index (opt-reach-value index state base) args)
          name))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [name (__tl-project-field (__tl-box-place payload-box) callee)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-reach-add-call-target
          index
          (opt-reach-spmd-call-args
            index
            (opt-reach-value index state active-mask)
            args)
          name))]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-reach-call-args
          index
          (opt-reach-value index (opt-reach-value index state base) func)
          args))]
    [(ir.CompilerIrInstr.TailCall name args _)
      (opt-reach-add-call-target
        index
        (opt-reach-call-args index state args)
        name)]
    [(ir.CompilerIrInstr.Store name value _)
      (opt-reach-value index (opt-reach-add-global state name) value)]
    [(ir.CompilerIrInstr.Jump _) state]
    [(ir.CompilerIrInstr.Branch cond _ _) (opt-reach-value index state cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-reach-value index state cond)]
    [(ir.CompilerIrInstr.Return maybe)
      (opt-reach-maybe-value index state maybe)]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-reach-phi-inputs index state inputs)]
    ;; Register-group ops carry word-class scalar operands (vars/consts);
    ;; lowering materializes any global/function reference into a var before
    ;; packing, so the group operands themselves reach nothing new.
    [(ir.CompilerIrInstr.Pack _ _ _) state]
    [(ir.CompilerIrInstr.Word _ src _ _) (opt-reach-value index state src)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (opt-reach-call-args index (opt-reach-value index state func) args)]
    [(ir.CompilerIrInstr.Switch idx _ _ _) (opt-reach-value index state idx)]
    [(ir.CompilerIrInstr.TotalEnumSwitch idx _ _ _ _)
      (opt-reach-value index state idx)]))

(define (opt-reach-instr-seq-from
  [index : OptFunctionIndex]
  [state : OptReachState]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [instr-index : i64]
  [count : i64]) : OptReachState
  (if (>= instr-index count)
    state
    (opt-reach-instr-seq-from
      index
      (opt-reach-instr index state (array-ref slots instr-index))
      slots
      (+ instr-index 1)
      count)))

(define (opt-reach-instr-seq
  [index : OptFunctionIndex]
  [state : OptReachState]
  [instrs : ir.CompilerIrInstrSeq]) : OptReachState
  (opt-reach-instr-seq-from index state instrs.slots 0 instrs.len))

(define (opt-reach-blocks
  [index : OptFunctionIndex]
  [state : OptReachState]
  [blocks : ir.CompilerIrBlockList]) : OptReachState
  (match blocks
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-reach-blocks
            index
            (opt-reach-instr-seq index state instrs)
            (__tl-box-place rest))])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : OptReachState state]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! out (opt-reach-instr-seq index out instrs))])
              (set! i (+ i 1))))
          out))]))

(define (opt-reach-function
  [index : OptFunctionIndex]
  [state : OptReachState]
  [func : ir.CompilerIrFunction]) : OptReachState
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-reach-blocks index state blocks)]))

(define (opt-reach-process [index : OptFunctionIndex] [state : OptReachState]) : OptReachState
  (match state
    [(OptReachState.State reachable worklist globals runtime-helper-mask)
      (match (opt-reach-worklist-pop worklist)
        [(OptReachWorklistPop.Empty) state]
        [(OptReachWorklistPop.Item slot rest)
          (let
            [popped : OptReachState
              (OptReachState.State reachable rest globals runtime-helper-mask)]
            (opt-reach-process
              index
              (opt-reach-function
                index
                popped
                (opt-function-index-at-slot index slot))))])]))

(define (opt-reach-global
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [global : ir.CompilerIrGlobal]) : OptReachState
  (match global
    [(ir.CompilerIrGlobal.Global name _ value)
      ;; A global with a non-constant initializer is set up before main by a
      ;; generated `__global_init_<name>` function that the backend calls from
      ;; the startup sequence; it is NOT referenced from the global's IR value,
      ;; so it must be added as a reachability root or the prune drops its
      ;; definition (unresolved-symbol link failure). opt-reach-add-function
      ;; no-ops when the function does not exist (constant-initialized globals).
      (opt-reach-value index state value)]))

(define (opt-reach-globals
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [globals : ir.CompilerIrGlobalList]) : OptReachState
  (match globals
    [(ir.CompilerIrGlobalList.Nil) state]
    [(ir.CompilerIrGlobalList.Cons global rest)
      (opt-reach-globals
        index
        (opt-reach-global index state global)
        (__tl-box-place rest))]
    [(ir.CompilerIrGlobalList.Array seq)
      (opt-reach-global-seq index state seq 0)]))

(define (opt-reach-global-seq
  [index : OptFunctionIndex]
  [state : OptReachState (:consume)]
  [globals : ir.CompilerIrGlobalSeq]
  [seq-index : i64]) : OptReachState
  (if (>= seq-index (ir.compiler-ir-global-seq-count globals))
    state
    (opt-reach-global-seq
      index
      (opt-reach-global
        index
        state
        (ir.compiler-ir-global-seq-ref globals seq-index))
      globals
      (+ seq-index 1))))

;; `reachable` is keyed by dense index slot; resolve each function's slot through
;; the index (the same name->slot map the reach walk used) and test membership.
(define (opt-reach-slot-set-contains-name?
  [index : OptFunctionIndex]
  [reachable : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (match (opt-function-index-slot index name)
    [(option_i64.None) false]
    [(option_i64.Some slot) (opt_i64_i64_map.contains? (& reachable) slot)]))

(define (opt-filter-reachable-functions
  [index : OptFunctionIndex]
  [functions : ir.CompilerIrFunctionList]
  [reachable : opt_i64_i64_map.Map]) : ir.CompilerIrFunctionList
  (match functions
    [(ir.CompilerIrFunctionList.Nil) (ir.CompilerIrFunctionList.Nil)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (if (opt-reach-slot-set-contains-name? index reachable name)
            (ir.compiler-ir-function-cons
              func
              (opt-filter-reachable-functions
                index
                (__tl-box-place rest)
                reachable))
            (opt-filter-reachable-functions
              index
              (__tl-box-place rest)
              reachable))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (ir.compiler-ir-function-list-compact
        (opt-filter-reachable-functions
          index
          (ir.compiler-ir-function-seq-to-list seq)
          reachable))]))

(define (opt-runtime-global? [ty : ast.AstType] [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Unit)
      (match ty
        [(ast.AstType.Unit) false]
        [_ true])]
    [_ false]))

(define (opt-filter-reachable-globals
  [globals : ir.CompilerIrGlobalList]
  [reachable : opt_i64_i64_map.Map]) : ir.CompilerIrGlobalList
  (match globals
    [(ir.CompilerIrGlobalList.Nil) (ir.CompilerIrGlobalList.Nil)]
    [(ir.CompilerIrGlobalList.Cons global rest)
      (match global
        [(ir.CompilerIrGlobal.Global name ty value)
          (if (or
            (opt-runtime-global? ty value)
            (opt_i64_i64_map.contains?
              (& reachable)
              (ir.compiler-ir-symbol-id name)))
            (ir.compiler-ir-global-cons
              global
              (opt-filter-reachable-globals (__tl-box-place rest) reachable))
            (opt-filter-reachable-globals (__tl-box-place rest) reachable))])]
    [(ir.CompilerIrGlobalList.Array seq)
      (ir.compiler-ir-global-list-compact-reversed
        (ir.compiler-ir-global-list-reverse-onto
          (opt-filter-reachable-globals
            (ir.compiler-ir-global-seq-to-list seq)
            reachable)
          ir.CompilerIrGlobalList.Nil))]))

;; Exported functions are lowered to a `provided` CompilerIrExtern.Extern whose name
;; is the function's logical name. Such functions may be called only from outside
;; TypeLisp IR (e.g. the backend-emitted bounds/division/shift checks call the
;; runtime-prelude handlers), so seed them as roots for the function-level DCE.
(define (opt-reach-add-provided-externs
  [index : OptFunctionIndex]
  [externs : ir.CompilerIrExternList]
  [state : OptReachState (:consume)]) : OptReachState
  (match externs
    [(ir.CompilerIrExternList.Nil) state]
    [(ir.CompilerIrExternList.Cons ext rest)
      (match ext
        [(ir.CompilerIrExtern.Extern name-id _ _ _ _ _ _ provided)
          (opt-reach-add-provided-externs
            index
            (__tl-box-place rest)
            (if provided
              (match (opt-function-index-slot-id index name-id)
                [(option_i64.Some slot)
                  (opt-reach-add-function-slot state slot)]
                [(option_i64.None) (opt-reach-add-function index state name-id)])
              state))])]
    [(ir.CompilerIrExternList.Array seq)
      (opt-reach-add-provided-extern-seq index seq state 0)]))

(define (opt-reach-add-provided-extern-seq
  [index : OptFunctionIndex]
  [externs : ir.CompilerIrExternSeq]
  [state : OptReachState (:consume)]
  [seq-index : i64]) : OptReachState
  (if (>= seq-index (ir.compiler-ir-extern-seq-count externs))
    state
    (match (ir.compiler-ir-extern-seq-ref externs seq-index)
      [(ir.CompilerIrExtern.Extern name-id _ _ _ _ _ _ provided)
        (opt-reach-add-provided-extern-seq
          index
          externs
          (if provided
            (match (opt-function-index-slot-id index name-id)
              [(option_i64.Some slot) (opt-reach-add-function-slot state slot)]
              [(option_i64.None) (opt-reach-add-function index state name-id)])
            state)
          (+ seq-index 1))])))

;; Return the byte offset just past the last '/' or ':' separator in `name`
;; (0 when there is none). Scanning backward from the end stops at the final
;; separator instead of walking the whole string, and reading the raw String
;; bytes skips the per-char bounds check of `string.string-ref`. Function names
;; are classified once when the reachability index is built; standalone call
;; targets classify once before all of their fixed helper-name checks.
(define (opt-symbol-leaf-start [name : String]) : i64
  (let
    [n : i64 (string.string-length name)]
    [data : (Ptr u8)
      (unsafe
        (string-data name))]
    [i : i64 (- n 1)]
    [start : i64 0]
    [done : bool false]
    (begin
      (while (if done
        false
        (>= i 0))
        (let
          ;; '/' = 47, ':' = 58
          [b : i64
            (unsafe
              (cast (ptr-read (ptr-offset data i)) : i64))]
          (if (if (= b 47)
            true
            (= b 58))
            (begin
              (set! start (+ i 1))
              (set! done true))
            (set! i (- i 1)))))
      start)))

;; Compare a leaf using a start already classified by the function index or by
;; the caller. The reachability pass checks the same indexed names for several
;; runtime helpers, so rescanning each name for its last separator dominated the
;; actual byte comparison.
(define (opt-symbol-leaf-matches-from?
  [name : String]
  [start : i64]
  [leaf : String]) : bool
  (let
    [n : i64 (string.string-length name)]
    [leaf-len : i64 (string.string-length leaf)]
    (if (not (= (- n start) leaf-len))
      false
      (let
        [name-data : (Ptr u8)
          (unsafe
            (string-data name))]
        [leaf-data : (Ptr u8)
          (unsafe
            (string-data leaf))]
        [ok : bool true]
        [i : i64 0]
        (begin
          (while (if ok
            (< i leaf-len)
            false)
            (if (=
              (unsafe
                (ptr-read (ptr-offset name-data (+ start i))))
              (unsafe
                (ptr-read (ptr-offset leaf-data i))))
              (set! i (+ i 1))
              (set! ok false)))
          ok)))))

;; Allocation-free equivalent of (string.eq (opt-symbol-leaf name) leaf) for
;; standalone callers that do not already have a classified start.
(define (opt-prune-unreachable-program
  [globals : ir.CompilerIrGlobalList]
  [functions : ir.CompilerIrFunctionList]
  [externs : ir.CompilerIrExternList]) : OptPrunedProgram
  (if (opt-function-list-defines? functions "main")
    (let
      [index : OptFunctionIndex (opt-function-index-build functions)]
      [reachable : opt_i64_i64_map.Map
        (opt_i64_i64_map.with-capacity
          (opt-function-index-capacity (opt-function-list-count functions)))]
      [reachable-globals : opt_i64_i64_map.Map
        (opt_i64_i64_map.with-capacity
          (opt-function-index-capacity
            (ir.compiler-ir-global-list-count globals)))]
      (match (opt-reach-process
        index
        (opt-reach-globals
          index
          (opt-reach-add-provided-externs
            index
            externs
            (opt-reach-add-function-leaf
              index
              (OptReachState.State
                reachable
                (opt-reach-worklist-new)
                reachable-globals
                0)
              "main"))
          globals))
        [(OptReachState.State reachable-out _ reachable-globals-out _)
          (OptPrunedProgram.Program
            (opt-filter-reachable-globals globals reachable-globals-out)
            (opt-filter-reachable-functions index functions reachable-out))]))
    (OptPrunedProgram.Program globals functions)))

(defenum OptLoopBceArgcScan
  (Scan OptLoopBceExprEnv bool bool))

(defenum OptLoopBceCleanScan
  (Scan OptLoopBceState bool))

(defenum OptLoopBceCleanPass
  (Pass opt_i64_i64_map.Map bool))

(defenum OptLoopBceIdCleanPass
  (Pass opt_i64_i64_map.Map bool))

(define (opt-loop-bce-argc-value-expr
  [env : OptLoopBceExprEnv]
  [value : ir.CompilerIrValue]) : OptLoopBceExpr
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (opt-loop-bce-expr-lookup env id)
        [(OptLoopBceExpr.Argc) (OptLoopBceExpr.Argc)]
        [_ (OptLoopBceExpr.Value value)])]
    [_ (OptLoopBceExpr.Value value)]))

(define (opt-loop-bce-argc-scan-instr
  [type-segment-bases : i64]
  [scan : OptLoopBceArgcScan]
  [instr : ir.CompilerIrInstr]) : OptLoopBceArgcScan
  (match scan
    [(OptLoopBceArgcScan.Scan env seen ok)
      (if (not ok)
        scan
        (match instr
          [(ir.CompilerIrInstr.EntryArgc dst)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind env dst (OptLoopBceExpr.Argc))
              seen
              ok)]
          [(ir.CompilerIrInstr.Mov dst src _)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind
                env
                dst
                (opt-loop-bce-argc-value-expr env src))
              seen
              ok)]
          [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind
                env
                dst
                (if (opt-loop-bce-same-width-int-cast?
                  type-segment-bases
                  from-ty
                  to-ty)
                  (opt-loop-bce-argc-value-expr env src)
                  (OptLoopBceExpr.Unknown)))
              seen
              ok)]
          [(ir.CompilerIrInstr.Bitcast dst _ _ _)
            (OptLoopBceArgcScan.Scan
              (opt-loop-bce-expr-bind env dst (OptLoopBceExpr.Unknown))
              seen
              ok)]
          [(ir.CompilerIrInstr.Return maybe)
            (match maybe
              [(ir.CompilerIrMaybeValue.Some value)
                (OptLoopBceArgcScan.Scan
                  env
                  true
                  (opt-loop-bce-expr-eq
                    type-segment-bases
                    (opt-loop-bce-argc-value-expr env value)
                    (OptLoopBceExpr.Argc)))]
              [(ir.CompilerIrMaybeValue.No)
                (OptLoopBceArgcScan.Scan env true false)])]
          [(ir.CompilerIrInstr.Jump _) (OptLoopBceArgcScan.Scan env seen false)]
          [(ir.CompilerIrInstr.Branch _ _ _)
            (OptLoopBceArgcScan.Scan env seen false)]
          [(ir.CompilerIrInstr.TotalEnumBranch _ _ _)
            (OptLoopBceArgcScan.Scan env seen false)]
          [_
            (let
              [dst : i64 (opt-gvn-instr-dst instr)]
              (if (= dst (- 0 1))
                scan
                (OptLoopBceArgcScan.Scan
                  (opt-loop-bce-expr-unbind env dst)
                  seen
                  ok)))]))]))

(define (opt-loop-bce-argc-scan-seq-from
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [scan : OptLoopBceArgcScan]) : OptLoopBceArgcScan
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    scan
    (opt-loop-bce-argc-scan-seq-from
      type-segment-bases
      instrs
      (+ index 1)
      (opt-loop-bce-argc-scan-instr
        type-segment-bases
        scan
        (ir.compiler-ir-instr-seq-ref instrs index)))))

;; Only an EntryArgc instruction can seed the argc expression tracked by the
;; full scan below. Large generated initializers can contain tens of thousands
;; of unrelated moves in one block; building and repeatedly invalidating an
;; expression environment for those functions is quadratic work that cannot
;; produce an argc-return summary.
(define (opt-loop-bce-argc-seq-has-entry? [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.EntryArgc _) (set! found true)]
          [_ (set! index (+ index 1))]))
      found)))

(define (opt-loop-bce-argc-single-block-returns?
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (if (not (opt-loop-bce-argc-seq-has-entry? instrs))
    false
    (match (opt-loop-bce-argc-scan-seq-from
      type-segment-bases
      instrs
      0
      (OptLoopBceArgcScan.Scan (OptLoopBceExprEnv.Nil) false true))
      [(OptLoopBceArgcScan.Scan _ seen ok) (and seen ok)])))

(define (opt-loop-bce-function-returns-argc?
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ params _ _ blocks)
      (if (not (= (opt-tailrec-param-count params) 0))
        false
        (match blocks
          [(ir.CompilerIrBlockList.Cons block rest)
            (match (__tl-box-place rest)
              [(ir.CompilerIrBlockList.Nil)
                (match block
                  [(ir.CompilerIrBlock.Block _ instrs)
                    (opt-loop-bce-argc-single-block-returns?
                      type-segment-bases
                      instrs)])]
              [_ false])]
          [(ir.CompilerIrBlockList.Array seq)
            (if (= (ir.compiler-ir-block-seq-count seq) 1)
              (match (ir.compiler-ir-block-seq-ref seq 0)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (opt-loop-bce-argc-single-block-returns?
                    type-segment-bases
                    instrs)])
              false)]
          [(ir.CompilerIrBlockList.Nil) false]))]))

(define (opt-loop-bce-argc-return-map
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [map : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match functions
    [(ir.CompilerIrFunctionList.Nil) map]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (begin
            (if (opt-loop-bce-function-returns-argc? type-segment-bases func)
              (opt_i64_i64_map.insert-ref!
                (&mut map)
                (ir.compiler-ir-symbol-id name)
                1)
              unit)
            (opt-loop-bce-argc-return-map
              type-segment-bases
              (__tl-box-place rest)
              map))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-loop-bce-argc-return-map
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list seq)
        map)]))

(define (opt-loop-bce-clean-storeptr-safe?
  [state : OptLoopBceState]
  [ptr : ir.CompilerIrValue]) : bool
  (match ptr
    [(ir.CompilerIrValue.Var ptr-var)
      (match (opt-loop-bce-ptr-lookup state.ptrs ptr-var)
        [(OptLoopBcePtrKind.DataSlot _) true]
        [(OptLoopBcePtrKind.DataBuffer _) true]
        [(OptLoopBcePtrKind.DataElement _) true]
        [_ false])]
    [_ false]))

(define (opt-loop-bce-clean-update-instr
  [type-segment-bases : i64]
  [scan : OptLoopBceCleanScan]
  [clean : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : OptLoopBceCleanScan
  (match scan
    [(OptLoopBceCleanScan.Scan state ok)
      (if (not ok)
        scan
        (match instr
          [(ir.CompilerIrInstr.Mov dst src _)
            (let
              [invalid : OptLoopBceState
                (opt-loop-bce-state-invalidate-def state dst)]
              (match src
                [(ir.CompilerIrValue.Var src-var)
                  (OptLoopBceCleanScan.Scan
                    (opt-loop-bce-state-bind-alias
                      invalid
                      dst
                      (opt-loop-bce-alias-resolve state.aliases src-var))
                    ok)]
                [_ (OptLoopBceCleanScan.Scan invalid ok)]))]
          [(ir.CompilerIrInstr.Alloc dst _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-bind-alias
                (opt-loop-bce-state-invalidate-def state dst)
                dst
                dst)
              ok)]
          [(ir.CompilerIrInstr.Gep dst base offset ty)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-update-gep
                type-segment-bases
                state
                (opt_i64_i64_map.with-capacity 1)
                dst
                base
                offset
                ty)
              ok)]
          [(ir.CompilerIrInstr.Load dst src ty)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-update-load
                type-segment-bases
                state
                (opt_i64_i64_map.with-capacity 1)
                dst
                src
                ty)
              ok)]
          [(ir.CompilerIrInstr.StorePtr ptr _ _)
            (OptLoopBceCleanScan.Scan
              state
              (opt-loop-bce-clean-storeptr-safe? state ptr))]
          [(ir.CompilerIrInstr.Call dst name _ _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              (opt_i64_i64_map.contains?
                (& clean)
                (ir.compiler-ir-symbol-id name)))]
          [(ir.CompilerIrInstr.TailCall name _ _)
            (OptLoopBceCleanScan.Scan
              state
              (opt_i64_i64_map.contains?
                (& clean)
                (ir.compiler-ir-symbol-id name)))]
          [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
            (OptLoopBceCleanScan.Scan state false)]
          [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
            (OptLoopBceCleanScan.Scan state false)]
          [(ir.CompilerIrInstr.SpmdCall payload-box)
            (let
              [result (__tl-project-field (__tl-box-place payload-box) result)]
              (match result
                [(ir.CompilerIrSpmdCallResult.Unit)
                  (OptLoopBceCleanScan.Scan state false)]
                [(ir.CompilerIrSpmdCallResult.Value dst _ _)
                  (OptLoopBceCleanScan.Scan
                    (opt-loop-bce-state-invalidate-def state dst)
                    false)]))]
          [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
            (OptLoopBceCleanScan.Scan state false)]
          [(ir.CompilerIrInstr.Syscall dst _)
            (OptLoopBceCleanScan.Scan
              (opt-loop-bce-state-invalidate-def state dst)
              false)]
          [(ir.CompilerIrInstr.CopyBytes _ _ _)
            (OptLoopBceCleanScan.Scan state false)]
          [(ir.CompilerIrInstr.VectorStore payload-box)
            (OptLoopBceCleanScan.Scan state false)]
          [(ir.CompilerIrInstr.PredicatedStore payload-box)
            (OptLoopBceCleanScan.Scan state false)]
          [_
            (let
              [dst : i64 (opt-gvn-instr-dst instr)]
              (OptLoopBceCleanScan.Scan
                (if (= dst (- 0 1))
                  state
                  (opt-loop-bce-state-invalidate-def state dst))
                ok))]))]))

(define (opt-loop-bce-clean-scan-seq-from
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [clean : opt_i64_i64_map.Map]
  [scan : OptLoopBceCleanScan]) : OptLoopBceCleanScan
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    scan
    (opt-loop-bce-clean-scan-seq-from
      type-segment-bases
      instrs
      (+ index 1)
      clean
      (opt-loop-bce-clean-update-instr
        type-segment-bases
        scan
        clean
        (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-loop-bce-clean-scan-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [clean : opt_i64_i64_map.Map]
  [scan : OptLoopBceCleanScan]) : OptLoopBceCleanScan
  (match scan
    [(OptLoopBceCleanScan.Scan _ ok)
      (if (not ok)
        scan
        (match blocks
          [(ir.CompilerIrBlockList.Nil) scan]
          [(ir.CompilerIrBlockList.Cons block rest)
            (match block
              [(ir.CompilerIrBlock.Block _ instrs)
                (opt-loop-bce-clean-scan-blocks
                  type-segment-bases
                  (__tl-box-place rest)
                  clean
                  (opt-loop-bce-clean-scan-seq-from
                    type-segment-bases
                    instrs
                    0
                    clean
                    scan))])]
          [(ir.CompilerIrBlockList.Array seq)
            (opt-loop-bce-clean-scan-blocks
              type-segment-bases
              (ir.compiler-ir-block-seq-to-list seq)
              clean
              scan)]))]))

(define (opt-loop-bce-function-length-clean?
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [clean : opt_i64_i64_map.Map]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-loop-bce-clean-scan-blocks
        type-segment-bases
        blocks
        clean
        (OptLoopBceCleanScan.Scan (opt-loop-bce-initial-state) true))
        [(OptLoopBceCleanScan.Scan _ ok) ok])]))

(define (opt-loop-bce-length-clean-pass
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [clean : opt_i64_i64_map.Map]) : OptLoopBceCleanPass
  (match functions
    [(ir.CompilerIrFunctionList.Nil) (OptLoopBceCleanPass.Pass clean false)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match (opt-loop-bce-length-clean-pass
        type-segment-bases
        (__tl-box-place rest)
        clean)
        [(OptLoopBceCleanPass.Pass tail-clean tail-added)
          (match func
            [(ir.CompilerIrFunction.Function name _ _ _ _)
              (if (opt_i64_i64_map.contains?
                (& tail-clean)
                (ir.compiler-ir-symbol-id name))
                (OptLoopBceCleanPass.Pass tail-clean tail-added)
                (if (opt-loop-bce-function-length-clean?
                  type-segment-bases
                  func
                  tail-clean)
                  (begin
                    (opt_i64_i64_map.insert-ref!
                      (&mut tail-clean)
                      (ir.compiler-ir-symbol-id name)
                      1)
                    (OptLoopBceCleanPass.Pass tail-clean true))
                  (OptLoopBceCleanPass.Pass tail-clean tail-added)))])])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-loop-bce-length-clean-pass
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list seq)
        clean)]))

(define (opt-loop-bce-direct-call-clean-effect? [effect : ir.CompilerIrEffect]) : bool
  (match effect
    [(ir.CompilerIrEffect.Pure) true]
    [(ir.CompilerIrEffect.MemoryRead) true]
    [(ir.CompilerIrEffect.ControlFlow) true]
    [_ false]))

(define (opt-loop-bce-direct-call-clean-target?
  [clean : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (or
    (opt_i64_i64_map.contains? (& clean) (ir.compiler-ir-symbol-id name))
    (opt-loop-bce-direct-call-clean-effect?
      (ir.compiler-ir-direct-call-effect-id name))))

(define (opt-loop-bce-direct-call-clean-instr?
  [clean : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ name _ _)
      (opt-loop-bce-direct-call-clean-target? clean name)]
    [(ir.CompilerIrInstr.TailCall name _ _)
      (opt-loop-bce-direct-call-clean-target? clean name)]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) false]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) false]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) false]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) false]
    [(ir.CompilerIrInstr.SpmdCall _) false]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) false]
    [_
      (opt-loop-bce-direct-call-clean-effect?
        (ir.compiler-ir-instr-effect instr))]))

(define (opt-loop-bce-direct-call-clean-instr-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [clean : opt_i64_i64_map.Map]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-loop-bce-direct-call-clean-instr?
        clean
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-loop-bce-direct-call-clean-instr-seq? instrs (+ index 1) clean))))

(define (opt-loop-bce-direct-call-clean-blocks?
  [blocks : ir.CompilerIrBlockList]
  [clean : opt_i64_i64_map.Map]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-loop-bce-direct-call-clean-instr-seq? instrs 0 clean)
            (opt-loop-bce-direct-call-clean-blocks? (__tl-box-place rest) clean))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-direct-call-clean-blocks?
        (ir.compiler-ir-block-seq-to-list seq)
        clean)]))

(define (opt-loop-bce-direct-call-self-recursive-instr?
  [name : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ callee _ _)
      (ir.compiler-ir-symbol-eq? name callee)]
    [(ir.CompilerIrInstr.TailCall callee _ _)
      (ir.compiler-ir-symbol-eq? name callee)]
    [_ false]))

(define (opt-loop-bce-direct-call-self-recursive-seq?
  [name : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-loop-bce-direct-call-self-recursive-instr?
        name
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-loop-bce-direct-call-self-recursive-seq? name instrs (+ index 1)))))

(define (opt-loop-bce-direct-call-self-recursive-blocks?
  [name : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-loop-bce-direct-call-self-recursive-seq? name instrs 0)
            (opt-loop-bce-direct-call-self-recursive-blocks?
              name
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-direct-call-self-recursive-blocks?
        name
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-function-direct-call-hoist-target?
  [func : ir.CompilerIrFunction]
  [clean : opt_i64_i64_map.Map]) : bool
  (match func
    [(ir.CompilerIrFunction.Function name _ _ _ blocks)
      (and
        (opt-loop-bce-direct-call-self-recursive-blocks? name blocks)
        (opt-loop-bce-direct-call-clean-blocks? blocks clean))]))

(define (opt-loop-bce-direct-call-clean-all-functions
  [functions : ir.CompilerIrFunctionList]
  [map : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match functions
    [(ir.CompilerIrFunctionList.Nil) map]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut map)
              (ir.compiler-ir-symbol-id name)
              1)
            (opt-loop-bce-direct-call-clean-all-functions
              (__tl-box-place rest)
              map))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-loop-bce-direct-call-clean-all-functions
        (ir.compiler-ir-function-seq-to-list seq)
        map)]))

(define (opt-loop-bce-direct-call-clean-filter
  [functions : ir.CompilerIrFunctionList]
  [current : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]
  [changed : bool]) : OptLoopBceIdCleanPass
  (match functions
    [(ir.CompilerIrFunctionList.Nil) (OptLoopBceIdCleanPass.Pass out changed)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (ir.compiler-ir-symbol-id name)]
            [was-clean : bool (opt_i64_i64_map.contains? (& current) name-id)]
            [keep : bool
              (and
                was-clean
                (opt-loop-bce-function-direct-call-hoist-target? func current))]
            [_record : unit
              (if keep
                (opt_i64_i64_map.insert-ref! (&mut out) name-id 1)
                unit)]
            (opt-loop-bce-direct-call-clean-filter
              (__tl-box-place rest)
              current
              out
              (or changed (and was-clean (not keep)))))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-loop-bce-direct-call-clean-filter
        (ir.compiler-ir-function-seq-to-list seq)
        current
        out
        changed)]))

(define (opt-loop-bce-direct-call-clean-fixed
  [functions : ir.CompilerIrFunctionList]
  [current : opt_i64_i64_map.Map]
  [capacity : i64]
  [remaining : i64]) : opt_i64_i64_map.Map
  (if (<= remaining 0)
    current
    (match (opt-loop-bce-direct-call-clean-filter
      functions
      current
      (opt_i64_i64_map.with-capacity capacity)
      false)
      [(OptLoopBceIdCleanPass.Pass next changed)
        (if changed
          (opt-loop-bce-direct-call-clean-fixed
            functions
            next
            capacity
            (- remaining 1))
          next)])))

(define (opt-loop-bce-direct-call-clean-map
  [functions : ir.CompilerIrFunctionList]
  [capacity : i64]) : opt_i64_i64_map.Map
  (opt-loop-bce-direct-call-clean-fixed
    functions
    (opt-loop-bce-direct-call-clean-all-functions
      functions
      (opt_i64_i64_map.with-capacity capacity))
    capacity
    (+ (opt-function-list-count functions) 1)))

;; --- direct-call memory summaries for load GVN ------------------------------
;;
;; Packed summary layout (kept nonnegative):
;;   bits 0..59  writes through that checked-reference parameter index
;;   bit 60      writes direct/reachable global storage
;;   bit 61      unknown memory effects
;;   bit 62      writes only into descriptor ELEMENT storage
;;
;; The map is built in two phases. The PESSIMISTIC phase discovers leaves first
;; and makes callers eligible in later rounds; an internal call whose target is
;; still absent makes the caller unresolved, so it never proves anything about a
;; recursive cycle. The OPTIMISTIC phase then resolves exactly what the first
;; one gave up on, by ascending Kleene iteration from the lattice bottom --
;; see opt-call-memory-optimistic-fixed.
(define (opt-call-memory-param-limit) : i64
  60)

(define (opt-call-memory-global-bit) : i64
  (shl 1 60))

(define (opt-call-memory-unknown-bit) : i64
  (shl 1 61))

;; A write whose pointer is an address INTO the element storage a descriptor's
;; data slot names -- `(i64vec.slots-mut v)` and every other slot accessor,
;; whose store lands in the heap buffer the descriptor points at rather than in
;; the descriptor (or the parameter) itself.
;;
;; This is deliberately NOT a parameter-write bit. The buffer is a DIFFERENT
;; allocation from the parameter's own storage, and the per-parameter bits mean
;; "writes through the object argument i names", which is what
;; opt-load-table-filter-call-writes turns into a root-keyed table filter. Only
;; the one question a data buffer answers on its own gets a weaker verdict here:
;; a global CELL is a symbol's own storage -- a scalar, a register group, or the
;; payload pointer of a memory-class global -- and is never the element storage
;; a descriptor points at, so a callee whose every write is of this class writes
;; no global cell no matter what its caller passed. That is the same argument
;; opt-licm-store-summary-global-write? already makes for an in-function
;; element-only store; this bit is its per-callee form. Every OTHER reader
;; treats the bit exactly like `unknown` (see opt-load-cse-state-direct-call),
;; so nothing that reasons about which caller object was written moves.
(define (opt-call-memory-element-bit) : i64
  (shl 1 62))

(define (opt-call-memory-summary-param-write? [summary : i64] [index : i64]) : bool
  (and
    (>= index 0)
    (< index (opt-call-memory-param-limit))
    (not (= (bit-and summary (shl 1 index)) 0))))

(define (opt-call-memory-summary-global? [summary : i64]) : bool
  (not (= (bit-and summary (opt-call-memory-global-bit)) 0)))

(define (opt-call-memory-summary-unknown? [summary : i64]) : bool
  (not (= (bit-and summary (opt-call-memory-unknown-bit)) 0)))

(define (opt-call-memory-summary-element? [summary : i64]) : bool
  (not (= (bit-and summary (opt-call-memory-element-bit)) 0)))

(define (opt-call-memory-summary-has-param-writes? [summary : i64]) : bool
  (not (= (bit-and summary (- (opt-call-memory-global-bit) 1)) 0)))

(define (opt-call-memory-summary-add-unknown [summary : i64]) : i64
  (bit-or summary (opt-call-memory-unknown-bit)))

(define (opt-call-memory-summary-add-global [summary : i64]) : i64
  (bit-or summary (opt-call-memory-global-bit)))

(define (opt-call-memory-summary-add-element [summary : i64]) : i64
  (bit-or summary (opt-call-memory-element-bit)))

;; The bits a call site copies out of its callee's summary unchanged: verdicts
;; about storage the caller has no argument for and therefore cannot refine.
;; The parameter bits are NOT here -- those are mapped through the arguments by
;; opt-call-memory-map-callee-param-writes.
(define (opt-call-memory-carried-mask) : i64
  (bit-or
    (opt-call-memory-element-bit)
    (bit-or (opt-call-memory-global-bit) (opt-call-memory-unknown-bit))))

(define (opt-call-memory-function-set
  [functions : ir.CompilerIrFunctionList]
  [set : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match functions
    [(ir.CompilerIrFunctionList.Nil) set]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut set)
              (ir.compiler-ir-symbol-id name)
              1)
            (opt-call-memory-function-set (__tl-box-place rest) set))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-call-memory-function-set
        (ir.compiler-ir-function-seq-to-list seq)
        set)]))

;; Find the source-level parameter index for a canonical checked-reference root
;; var. Fresh allocation roots deliberately have no parameter index.
(define (opt-call-memory-param-index-from
  [params : ir.CompilerIrParamList]
  [root-var : i64]
  [index : i64]) : i64
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) -1]
    [(ir.CompilerIrParamList.Array seq)
      (opt-call-memory-param-index-from
        (ir.compiler-ir-param-seq-to-list seq)
        root-var
        index)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (if (= var root-var)
            index
            (opt-call-memory-param-index-from
              (__tl-box-place rest)
              root-var
              (+ index 1)))])]))

(define (opt-call-memory-summary-add-root-write
  [summary : i64]
  [params : ir.CompilerIrParamList]
  [root : OptLicmRoot]) : i64
  (match root
    [(OptLicmRoot.Fresh _) summary]
    [(OptLicmRoot.Exclusive root-var)
      (let
        [index : i64 (opt-call-memory-param-index-from params root-var 0)]
        (if (and (>= index 0) (< index (opt-call-memory-param-limit)))
          (bit-or summary (shl 1 index))
          (opt-call-memory-summary-add-unknown summary)))]
    [(OptLicmRoot.Shared root-var)
      (let
        [index : i64 (opt-call-memory-param-index-from params root-var 0)]
        (if (and (>= index 0) (< index (opt-call-memory-param-limit)))
          (bit-or summary (shl 1 index))
          (opt-call-memory-summary-add-unknown summary)))]
    [(OptLicmRoot.NoRoot) (opt-call-memory-summary-add-unknown summary)]))

;; Summary construction runs before scalar SSA. Track roots only through vars
;; with one whole-function source, so textual block order or a reused lowered
;; var can never manufacture provenance. A second scan resolves same-root phis
;; and later-listed definitions without weakening that single-source gate.
(define (opt-call-memory-root-update-instr!
  [sources : opt_i64_i64_map.Map]
  [roots : (&mut roots OptLicmRootEnv)]
  [instr : ir.CompilerIrInstr]) : unit
  (match (opt-instr-def-var instr)
    [(option_i64.None) unit]
    [(option_i64.Some dst)
      (if (not (opt-gvn-stable-var? sources dst))
        (opt-licm-root-env-remove! roots dst)
        (match instr
          [(ir.CompilerIrInstr.Alloc _ _)
            (opt-licm-root-env-bind! roots dst (OptLicmRoot.Fresh dst))]
          [(ir.CompilerIrInstr.Gep _ base _ _)
            (opt-licm-root-env-copy! roots dst base)]
          [(ir.CompilerIrInstr.Mov _ src _)
            (opt-licm-root-env-copy! roots dst src)]
          [(ir.CompilerIrInstr.Cast _ src _ _)
            (opt-licm-root-env-copy! roots dst src)]
          [(ir.CompilerIrInstr.Bitcast _ src _ _)
            (opt-licm-root-env-copy! roots dst src)]
          [(ir.CompilerIrInstr.Phi _ inputs _)
            (match (opt-licm-phi-root roots inputs (OptMaybeLicmRoot.No))
              [(OptMaybeLicmRoot.No) (opt-licm-root-env-remove! roots dst)]
              [(OptMaybeLicmRoot.Some root)
                (opt-licm-root-env-bind! roots dst root)])]
          [(ir.CompilerIrInstr.Call _ name _ _)
            (if (ir.compiler-ir-symbol-eq?
              name
              cbi.compiler-builtin-id-tl-alloc)
              (opt-licm-root-env-bind! roots dst (OptLicmRoot.Fresh dst))
              (opt-licm-root-env-remove! roots dst))]
          [_ (opt-licm-root-env-remove! roots dst)]))]))

(define (opt-call-memory-root-scan-instrs!
  [sources : opt_i64_i64_map.Map]
  [roots : (&mut roots OptLicmRootEnv)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (opt-call-memory-root-update-instr!
        sources
        roots
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-call-memory-root-scan-instrs! sources roots instrs (+ index 1)))))

(define (opt-call-memory-root-scan-blocks!
  [sources : opt_i64_i64_map.Map]
  [roots : (&mut roots OptLicmRootEnv)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-call-memory-root-scan-instrs! sources roots instrs 0)])
        (opt-call-memory-root-scan-blocks! sources roots (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-call-memory-root-scan-blocks!
        sources
        roots
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-call-memory-sources
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (opt-gvn-sources-blocks
    blocks
    (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 32))))

(define (opt-call-memory-roots-with-sources
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptLicmRootEnv
  (let
    [roots : OptLicmRootEnv (opt-licm-root-env-with-capacity 17)]
    (begin
      (opt-licm-root-env-seed-params! type-segment-bases (&mut roots) params)
      (opt-call-memory-root-scan-blocks! sources (&mut roots) blocks)
      (opt-call-memory-root-scan-blocks! sources (&mut roots) blocks)
      roots)))

(define (opt-call-memory-roots
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptLicmRootEnv
  (opt-call-memory-roots-with-sources
    type-segment-bases
    (opt-call-memory-sources params blocks)
    params
    blocks))

;; --- element-storage pointer classification ---------------------------------
;;
;; A vector slot accessor -- `(i64vec.slots-mut v)` and its shared twin -- is a
;; `Gep` to the descriptor field followed by a `Load` of the descriptor itself,
;; so the write that follows is based at the accessor's RESULT and the root walk
;; above sees no parameter. What that store DOES reach is fixed by the shape,
;; though: `gep <header-typed var>, 0` is the descriptor's data slot, the load
;; through it is the heap buffer that slot names, and every further gep stays
;; inside that buffer. This map records exactly those two facts per var --
;; `data-slot` for the slot ADDRESS, `buffer` for a pointer INTO the storage --
;; so a store through a `buffer` pointer can be summarized as an element write
;; instead of falling to `unknown`.
;;
;; This mirrors opt-licm-gep-kind / opt-licm-provenance-state-instr's
;; DataSlot -> DataBuffer -> DataElement chain, minus the root rebinding: the
;; roots this pass would produce would claim the buffer IS the parameter's
;; allocation, which is what the parameter-write bits mean and is not what a
;; separately-allocated buffer is. Deriving nothing keeps the two facts apart.
;;
;; Summary construction runs before scalar SSA, so every var consulted -- the
;; classified def AND the header-typed base -- has to pass the same
;; whole-function single-source gate the root walk uses; a var written twice
;; could otherwise be a data buffer at one store and something else at another.
(define (opt-call-memory-element-kind-data-slot) : i64
  1)

(define (opt-call-memory-element-kind-buffer) : i64
  2)

(define (opt-call-memory-element-kind
  [elements : (& elements opt_i64_i64_map.Map)]
  [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (opt_i64_i64_map.get elements var)
        [(opt_i64_i64_map.LookupFound kind) kind]
        [(opt_i64_i64_map.LookupMissing) 0])]
    [_ 0]))

;; A store through this pointer lands in descriptor element storage.
(define (opt-call-memory-element-ptr?
  [elements : (& elements opt_i64_i64_map.Map)]
  [value : ir.CompilerIrValue]) : bool
  (=
    (opt-call-memory-element-kind elements value)
    (opt-call-memory-element-kind-buffer)))

(define (opt-call-memory-element-header-base?
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (and
        (opt-gvn-stable-var? sources var)
        (opt-licm-array-header-var? type-segment-bases types var))]
    [_ false]))

(define (opt-call-memory-element-bind!
  [elements : (&mut elements opt_i64_i64_map.Map)]
  [var : i64]
  [kind : i64]) : unit
  (if (= kind 0)
    (begin
      (opt_i64_i64_map.remove-ref! elements var)
      unit)
    (opt_i64_i64_map.insert-ref! elements var kind)))

(define (opt-call-memory-element-kind-for-instr
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [elements : (& elements opt_i64_i64_map.Map)]
  [instr : ir.CompilerIrInstr]) : i64
  (match instr
    ;; Inside the buffer stays inside the buffer; otherwise only the literal-
    ;; zero slot of a descriptor-typed base names the data pointer (the length
    ;; slot and every other offset do not).
    [(ir.CompilerIrInstr.Gep _ base offset ty)
      (if (opt-call-memory-element-ptr? elements base)
        (opt-call-memory-element-kind-buffer)
        (if (and
          (opt-call-memory-element-header-base?
            type-segment-bases
            sources
            types
            base)
          (opt-licm-data-slot? offset ty))
          (opt-call-memory-element-kind-data-slot)
          0))]
    ;; The data pointer read out of a slot address, or out of a
    ;; descriptor-typed var directly (offset 0 is the same word).
    [(ir.CompilerIrInstr.Load _ src _)
      (if (or
        (=
          (opt-call-memory-element-kind elements src)
          (opt-call-memory-element-kind-data-slot))
        (opt-call-memory-element-header-base?
          type-segment-bases
          sources
          types
          src))
        (opt-call-memory-element-kind-buffer)
        0)]
    [(ir.CompilerIrInstr.Mov _ src _)
      (opt-call-memory-element-kind elements src)]
    [_ 0]))

(define (opt-call-memory-element-update-instr!
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [elements : (&mut elements opt_i64_i64_map.Map)]
  [instr : ir.CompilerIrInstr]) : unit
  (match (opt-instr-def-var instr)
    [(option_i64.None) unit]
    [(option_i64.Some dst)
      (let
        [kind : i64
          (if (not (opt-gvn-stable-var? sources dst))
            0
            (opt-call-memory-element-kind-for-instr
              type-segment-bases
              sources
              types
              elements
              instr))]
        (opt-call-memory-element-bind! elements dst kind))]))

(define (opt-call-memory-element-scan-instrs!
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [elements : (&mut elements opt_i64_i64_map.Map)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (opt-call-memory-element-update-instr!
        type-segment-bases
        sources
        types
        elements
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-call-memory-element-scan-instrs!
        type-segment-bases
        sources
        types
        elements
        instrs
        (+ index 1)))))

(define (opt-call-memory-element-scan-blocks!
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [elements : (&mut elements opt_i64_i64_map.Map)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-call-memory-element-scan-instrs!
              type-segment-bases
              sources
              types
              elements
              instrs
              0)])
        (opt-call-memory-element-scan-blocks!
          type-segment-bases
          sources
          types
          elements
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-call-memory-element-scan-blocks!
        type-segment-bases
        sources
        types
        elements
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-call-memory-element-ptrs
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (let
    [types : OptSsaVarTypes (opt-licm-type-env-from-function params blocks)]
    [elements : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
    (begin
      (opt-call-memory-element-scan-blocks!
        type-segment-bases
        sources
        types
        (&mut elements)
        blocks)
      elements)))

(define (opt-call-memory-arg-at [args : ir.CompilerIrCallArgs] [index : i64]) : ir.CompilerIrMaybeValue
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrCallArgs.One value)
      (if (= index 0)
        (ir.CompilerIrMaybeValue.Some value)
        (ir.CompilerIrMaybeValue.No))]
    [(ir.CompilerIrCallArgs.Two a b)
      (cond
        [(= index 0) (ir.CompilerIrMaybeValue.Some a)]
        [(= index 1) (ir.CompilerIrMaybeValue.Some b)]
        [else (ir.CompilerIrMaybeValue.No)])]
    [(ir.CompilerIrCallArgs.Array values)
      (if (and (>= index 0) (< index (array-length values)))
        (ir.CompilerIrMaybeValue.Some (array-ref values index))
        (ir.CompilerIrMaybeValue.No))]))

(defenum OptCallMemoryCandidate
  (Unresolved)
  (Known i64))

(define (opt-call-memory-map-callee-param-writes
  [candidate : OptCallMemoryCandidate]
  [callee-summary : i64]
  [params : ir.CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [args : ir.CompilerIrCallArgs]
  [index : i64]) : OptCallMemoryCandidate
  (if (>= index (opt-call-memory-param-limit))
    candidate
    (match candidate
      [(OptCallMemoryCandidate.Unresolved) candidate]
      [(OptCallMemoryCandidate.Known summary)
        (if (not (opt-call-memory-summary-param-write? callee-summary index))
          (opt-call-memory-map-callee-param-writes
            candidate
            callee-summary
            params
            roots
            args
            (+ index 1))
          (match (opt-call-memory-arg-at args index)
            [(ir.CompilerIrMaybeValue.No)
              (OptCallMemoryCandidate.Known
                (opt-call-memory-summary-add-unknown summary))]
            [(ir.CompilerIrMaybeValue.Some value)
              (opt-call-memory-map-callee-param-writes
                (OptCallMemoryCandidate.Known
                  (opt-call-memory-summary-add-root-write
                    summary
                    params
                    (opt-licm-root-of-value roots value)))
                callee-summary
                params
                roots
                args
                (+ index 1))]))])))

(define (opt-call-memory-apply-direct-call
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : ir.CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [name : i64]
  [args : ir.CompilerIrCallArgs]) : OptCallMemoryCandidate
  (match candidate
    [(OptCallMemoryCandidate.Unresolved) candidate]
    [(OptCallMemoryCandidate.Known summary)
      (match (opt_i64_i64_map.get (& summaries) (ir.compiler-ir-symbol-id name))
        [(opt_i64_i64_map.LookupFound callee-summary)
          (opt-call-memory-map-callee-param-writes
            (OptCallMemoryCandidate.Known
              (bit-or
                summary
                (bit-and callee-summary (opt-call-memory-carried-mask))))
            callee-summary
            params
            roots
            args
            0)]
        [(opt_i64_i64_map.LookupMissing)
          (if (opt_i64_i64_map.contains?
            (& function-set)
            (ir.compiler-ir-symbol-id name))
            (OptCallMemoryCandidate.Unresolved)
            (match (ir.compiler-ir-direct-call-effect-id name)
              [(ir.CompilerIrEffect.MemoryRead) candidate]
              ;; The runtime control-flow family is the nonreturning abort set;
              ;; it writes no memory the caller can observe afterwards because
              ;; there is no afterwards. The non-call arm below already gives
              ;; ControlFlow this verdict, so a callee whose only "effect" is a
              ;; bounds/divide abort no longer summarizes as unknown.
              [(ir.CompilerIrEffect.ControlFlow) candidate]
              [_
                (OptCallMemoryCandidate.Known
                  (opt-call-memory-summary-add-unknown summary))]))])]))

;; One memory write's class. The parameter root wins whenever the pointer
;; carries one, so nothing an existing bit already describes moves; the element
;; fact is consulted only where the root walk gives up, replacing `unknown` and
;; never a parameter bit.
(define (opt-call-memory-summary-add-write
  [summary : i64]
  [params : ir.CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [elements : opt_i64_i64_map.Map]
  [ptr : ir.CompilerIrValue]) : i64
  (let
    [root : OptLicmRoot (opt-licm-root-of-value roots ptr)]
    (match root
      [(OptLicmRoot.NoRoot)
        (if (opt-call-memory-element-ptr? (& elements) ptr)
          (opt-call-memory-summary-add-element summary)
          (opt-call-memory-summary-add-unknown summary))]
      [_ (opt-call-memory-summary-add-root-write summary params root)])))

(define (opt-call-memory-candidate-instr
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : ir.CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [elements : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : OptCallMemoryCandidate
  (match candidate
    [(OptCallMemoryCandidate.Unresolved) candidate]
    [(OptCallMemoryCandidate.Known summary)
      (match instr
        [(ir.CompilerIrInstr.StorePtr ptr _ _)
          (OptCallMemoryCandidate.Known
            (opt-call-memory-summary-add-write
              summary
              params
              roots
              elements
              ptr))]
        [(ir.CompilerIrInstr.CopyBytes dst _ _)
          (OptCallMemoryCandidate.Known
            (opt-call-memory-summary-add-write
              summary
              params
              roots
              elements
              dst))]
        [(ir.CompilerIrInstr.Store _ _ _)
          (OptCallMemoryCandidate.Known
            (opt-call-memory-summary-add-global summary))]
        [(ir.CompilerIrInstr.Call _ name args _)
          (opt-call-memory-apply-direct-call
            candidate
            summaries
            function-set
            params
            roots
            name
            args)]
        [(ir.CompilerIrInstr.TailCall name args _)
          (opt-call-memory-apply-direct-call
            candidate
            summaries
            function-set
            params
            roots
            name
            args)]
        [(ir.CompilerIrInstr.Alloc _ _) candidate]
        [_
          (match (ir.compiler-ir-instr-effect instr)
            [(ir.CompilerIrEffect.Pure) candidate]
            [(ir.CompilerIrEffect.MemoryRead) candidate]
            [(ir.CompilerIrEffect.ControlFlow) candidate]
            [_
              (OptCallMemoryCandidate.Known
                (opt-call-memory-summary-add-unknown summary))])])]))

(define (opt-call-memory-candidate-instrs
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : ir.CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [elements : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptCallMemoryCandidate
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    candidate
    (opt-call-memory-candidate-instrs
      (opt-call-memory-candidate-instr
        candidate
        summaries
        function-set
        params
        roots
        elements
        (ir.compiler-ir-instr-seq-ref instrs index))
      summaries
      function-set
      params
      roots
      elements
      instrs
      (+ index 1))))

(define (opt-call-memory-candidate-blocks
  [candidate : OptCallMemoryCandidate]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [params : ir.CompilerIrParamList]
  [roots : OptLicmRootEnv]
  [elements : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : OptCallMemoryCandidate
  (match candidate
    [(OptCallMemoryCandidate.Unresolved) candidate]
    [_
      (match blocks
        [(ir.CompilerIrBlockList.Nil) candidate]
        [(ir.CompilerIrBlockList.Cons block rest)
          (match block
            [(ir.CompilerIrBlock.Block _ instrs)
              (opt-call-memory-candidate-blocks
                (opt-call-memory-candidate-instrs
                  candidate
                  summaries
                  function-set
                  params
                  roots
                  elements
                  instrs
                  0)
                summaries
                function-set
                params
                roots
                elements
                (__tl-box-place rest))])]
        [(ir.CompilerIrBlockList.Array seq)
          (opt-call-memory-candidate-blocks
            candidate
            summaries
            function-set
            params
            roots
            elements
            (ir.compiler-ir-block-seq-to-list seq))])]))

(define (opt-call-memory-direct-needs-roots?
  [summaries : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (match (opt_i64_i64_map.get (& summaries) (ir.compiler-ir-symbol-id name))
    [(opt_i64_i64_map.LookupFound summary)
      (opt-call-memory-summary-has-param-writes? summary)]
    [(opt_i64_i64_map.LookupMissing) false]))

(define (opt-call-memory-instr-needs-roots?
  [summaries : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [(ir.CompilerIrInstr.Call _ name _ _)
      (opt-call-memory-direct-needs-roots? summaries name)]
    [(ir.CompilerIrInstr.TailCall name _ _)
      (opt-call-memory-direct-needs-roots? summaries name)]
    [_ false]))

(define (opt-call-memory-instrs-need-roots?
  [summaries : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-call-memory-instr-needs-roots?
        summaries
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-call-memory-instrs-need-roots? summaries instrs (+ index 1)))))

(define (opt-call-memory-blocks-need-roots?
  [summaries : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-call-memory-instrs-need-roots? summaries instrs 0)
            (opt-call-memory-blocks-need-roots? summaries (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-call-memory-blocks-need-roots?
        summaries
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Only a direct write instruction can consult the element map, so the type
;; environment and the classification walk it needs are built only for
;; functions that contain one -- a strict subset of the ones already paying for
;; the root walk.
(define (opt-call-memory-instr-writes-memory? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (opt-call-memory-instrs-write-memory?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-call-memory-instr-writes-memory?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-call-memory-instrs-write-memory? instrs (+ index 1)))))

(define (opt-call-memory-blocks-write-memory? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-call-memory-instrs-write-memory? instrs 0)
            (opt-call-memory-blocks-write-memory? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-call-memory-blocks-write-memory?
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-call-memory-function-candidate
  [type-segment-bases : i64]
  [summaries : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [func : ir.CompilerIrFunction]) : OptCallMemoryCandidate
  (match func
    [(ir.CompilerIrFunction.Function _ params _ _ blocks)
      (if (not (opt-call-memory-blocks-need-roots? summaries blocks))
        (opt-call-memory-candidate-blocks
          (OptCallMemoryCandidate.Known 0)
          summaries
          function-set
          params
          (opt-licm-root-env-with-capacity 1)
          (opt_i64_i64_map.with-capacity 1)
          blocks)
        (let
          [sources : opt_i64_i64_map.Map
            (opt-call-memory-sources params blocks)]
          (opt-call-memory-candidate-blocks
            (OptCallMemoryCandidate.Known 0)
            summaries
            function-set
            params
            (opt-call-memory-roots-with-sources
              type-segment-bases
              sources
              params
              blocks)
            (if (opt-call-memory-blocks-write-memory? blocks)
              (opt-call-memory-element-ptrs
                type-segment-bases
                sources
                params
                blocks)
              (opt_i64_i64_map.with-capacity 1))
            blocks)))]))

(defenum OptCallMemoryBuildPass
  (Pass opt_i64_i64_map.Map bool))

(define (opt-call-memory-build-pass
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [current : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]
  [changed : bool]) : OptCallMemoryBuildPass
  (match functions
    [(ir.CompilerIrFunctionList.Nil) (OptCallMemoryBuildPass.Pass out changed)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (ir.compiler-ir-symbol-id name)]
            (match (opt_i64_i64_map.get (& current) name-id)
              [(opt_i64_i64_map.LookupFound summary)
                (begin
                  (opt_i64_i64_map.insert-ref! (&mut out) name-id summary)
                  (opt-call-memory-build-pass
                    type-segment-bases
                    (__tl-box-place rest)
                    current
                    function-set
                    out
                    changed))]
              [(opt_i64_i64_map.LookupMissing)
                (match (opt-call-memory-function-candidate
                  type-segment-bases
                  current
                  function-set
                  func)
                  [(OptCallMemoryCandidate.Unresolved)
                    (opt-call-memory-build-pass
                      type-segment-bases
                      (__tl-box-place rest)
                      current
                      function-set
                      out
                      changed)]
                  [(OptCallMemoryCandidate.Known summary)
                    (begin
                      (opt_i64_i64_map.insert-ref! (&mut out) name-id summary)
                      (opt-call-memory-build-pass
                        type-segment-bases
                        (__tl-box-place rest)
                        current
                        function-set
                        out
                        true))])]))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-call-memory-build-pass
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list seq)
        current
        function-set
        out
        changed)]))

;; Three runtime builtins have a memory footprint precise enough to summarize,
;; which lets a caller's cached load table survive them instead of being wiped:
;;
;;   - tl_alloc      : writes nothing IR-visible. Allocator bookkeeping lives in
;;                     thread-local runtime state no IR address value can name,
;;                     and the storage it returns did not exist before the call,
;;                     so no cached entry can describe it. (A recycling
;;                     tl_region_reset / tl_arena_set is deliberately NOT
;;                     summarized, so any reuse of freed storage still wipes.)
;;   - tl_array_zero : writes only through its first parameter.
;;   - tl_array_fill8: writes only through its first parameter.
;;   - tl_mem_fill8  : writes only through its first parameter (hand-asm
;;                     `rep stosq`; reads nothing but its own arguments).
;;
;; Symbols are raw interned ids (`compiler-ir-symbol-id` is the identity and
;; `compiler-ir-symbol-eq?` is `=`), so the seed key is the builtin id itself --
;; exactly what `opt-load-cse-state-direct-call` looks up for a call-site name.
;; An uninitialized builtin id is -1 and is never a call-site name, so it is
;; skipped rather than seeded (mirroring `compiler-ir-runtime-memory-write-id?`).
(define (opt-call-memory-seed-builtin
  [out : opt_i64_i64_map.Map (:consume)]
  [name-id : i64]
  [summary : i64]) : opt_i64_i64_map.Map
  (if (< name-id 0)
    out
    (let
      [next : opt_i64_i64_map.Map out]
      (begin
        (opt_i64_i64_map.insert-ref!
          (&mut next)
          (ir.compiler-ir-symbol-id name-id)
          summary)
        next))))

(define (opt-call-memory-seed-builtins [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (begin
    (cbi.compiler-builtin-refresh!)
    (opt-call-memory-seed-builtin
      (opt-call-memory-seed-builtin
        (opt-call-memory-seed-builtin
          (opt-call-memory-seed-builtin out cbi.compiler-builtin-id-tl-alloc 0)
          cbi.compiler-builtin-id-tl-array-zero
          (shl 1 0))
        cbi.compiler-builtin-id-tl-array-fill8
        (shl 1 0))
      cbi.compiler-builtin-id-tl-mem-fill8
      (shl 1 0))))

(define (opt-call-memory-build-fixed
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [function-set : opt_i64_i64_map.Map]
  [current : opt_i64_i64_map.Map]
  [capacity : i64]
  [remaining : i64]) : opt_i64_i64_map.Map
  (if (<= remaining 0)
    current
    ;; Each round builds a fresh `out` and copies rows in per function name, so
    ;; the builtin seeds are re-applied here as well as to the initial map --
    ;; otherwise they would vanish after round one.
    (match (opt-call-memory-build-pass
      type-segment-bases
      functions
      current
      function-set
      (opt-call-memory-seed-builtins (opt_i64_i64_map.with-capacity capacity))
      false)
      [(OptCallMemoryBuildPass.Pass next changed)
        (if changed
          (opt-call-memory-build-fixed
            type-segment-bases
            functions
            function-set
            next
            capacity
            (- remaining 1))
          next)])))

;; --- optimistic phase: least fixed point over the recursive residue ---------
;;
;; The pass above is a WORKLIST over a DAG: it can only ever commit a function
;; whose callees are already committed, so a call-graph CYCLE is unresolvable by
;; construction and every function that reaches one stays absent from the map.
;; That is the whole reason a self-recursive walker -- `qs-sort`, and most of a
;; compiler written as recursive list walks -- reloads a descriptor word on
;; every trip of the loop its own tail call becomes.
;;
;; The standard answer is to seed the cycle at the lattice BOTTOM and iterate up.
;; What makes that sound here, spelled out against this code:
;;
;;   THE LATTICE. A summary is a bit set (parameter bits 0..59, global, unknown,
;;   element). Order it by inclusion; join is `bit-or`; bottom is 0 ("writes
;;   nothing"); the chain height is 63. Finite, so ascending iteration
;;   terminates.
;;
;;   THE TRANSFER IS MONOTONE in the summaries map. Every path by which a callee
;;   summary reaches its caller's only ADDS bits:
;;     - opt-call-memory-apply-direct-call ors in `carried-mask` bits;
;;     - opt-call-memory-map-callee-param-writes visits index i only when the
;;       callee's bit i is SET, and each visit either ors in a parameter bit for
;;       the argument's root or ors in `unknown`; a cleared callee bit is
;;       skipped. So callee bits can add caller bits, never remove them.
;;   The two summaries-dependent SHAPE decisions are monotone too:
;;   opt-call-memory-function-candidate consults `blocks-need-roots?` (which
;;   reads the map) to decide whether to build the root environment at all, and
;;   that predicate is false only when the body has no StorePtr/CopyBytes AND no
;;   callee with parameter writes -- exactly the case in which neither the root
;;   environment nor the element map is ever consulted, so the skipped
;;   construction cannot change the result. When a growing callee summary flips
;;   it to true, the environments get BUILT and the extra parameter bits get
;;   mapped: strictly more bits, never fewer. `blocks-write-memory?` (the
;;   element-map gate) reads no summaries at all.
;;
;;   WHY THE LEAST FIXED POINT IS THE RIGHT ANSWER. A summary must over-
;;   approximate the writes of every terminating execution of the function. Any
;;   such execution performs finitely many nested calls, so its writes are
;;   covered by F^k(bottom) for some finite k, hence by the lfp. Iterating from
;;   bottom and committing only a map the transfer REPRODUCES (`changed` false)
;;   is what makes the committed map a genuine fixed point rather than an
;;   optimistic guess.
;;
;; The budget is what keeps this honest. If the iteration has not stabilized
;; within opt-call-memory-optimistic-rounds, the optimistic map is DISCARDED and
;; the pessimistic one is committed unchanged -- so an over-budget program bails
;; to exactly today's verdict (those functions stay absent, hence opaque) rather
;; than shipping a non-fixed-point. The same fallback covers the defensive
;; `Unresolved` arm below, which cannot fire: every function of the list is
;; seeded, and `function-set` is built from that same list.
(define (opt-call-memory-optimistic-rounds) : i64
  4)

;; Round zero: pessimistic rows copied through, residue rows at bottom.
(define (opt-call-memory-seed-optimistic
  [functions : ir.CompilerIrFunctionList]
  [resolved : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match functions
    [(ir.CompilerIrFunctionList.Nil) out]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (ir.compiler-ir-symbol-id name)]
            [seed : i64
              (match (opt_i64_i64_map.get (& resolved) name-id)
                [(opt_i64_i64_map.LookupFound summary) summary]
                [(opt_i64_i64_map.LookupMissing) 0])]
            (begin
              (opt_i64_i64_map.insert-ref! (&mut out) name-id seed)
              (opt-call-memory-seed-optimistic
                (__tl-box-place rest)
                resolved
                out)))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-call-memory-seed-optimistic
        (ir.compiler-ir-function-seq-to-list seq)
        resolved
        out)]))

(define (opt-call-memory-unresolved-count
  [functions : ir.CompilerIrFunctionList]
  [resolved : opt_i64_i64_map.Map]
  [count : i64]) : i64
  (match functions
    [(ir.CompilerIrFunctionList.Nil) count]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (opt-call-memory-unresolved-count
            (__tl-box-place rest)
            resolved
            (match (opt_i64_i64_map.get
              (& resolved)
              (ir.compiler-ir-symbol-id name))
              [(opt_i64_i64_map.LookupFound _) count]
              [(opt_i64_i64_map.LookupMissing) (+ count 1)]))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-call-memory-unresolved-count
        (ir.compiler-ir-function-seq-to-list seq)
        resolved
        count)]))

;; `out`, whether any residue row moved this round, and whether the round is
;; usable at all (see the `Unresolved` arm).
(defenum OptCallMemoryOptimisticPass
  (Pass opt_i64_i64_map.Map bool bool))

(define (opt-call-memory-optimistic-pass
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [resolved : opt_i64_i64_map.Map]
  [current : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]
  [changed : bool]
  [usable? : bool]) : OptCallMemoryOptimisticPass
  (match functions
    [(ir.CompilerIrFunctionList.Nil)
      (OptCallMemoryOptimisticPass.Pass out changed usable?)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (ir.compiler-ir-symbol-id name)]
            (match (opt_i64_i64_map.get (& resolved) name-id)
              ;; A pessimistically resolved row was computed from callees that
              ;; were themselves already committed, so no residue row can reach
              ;; it: it is a constant of this iteration.
              [(opt_i64_i64_map.LookupFound summary)
                (begin
                  (opt_i64_i64_map.insert-ref! (&mut out) name-id summary)
                  (opt-call-memory-optimistic-pass
                    type-segment-bases
                    (__tl-box-place rest)
                    resolved
                    current
                    function-set
                    out
                    changed
                    usable?))]
              [(opt_i64_i64_map.LookupMissing)
                (let
                  [previous : i64
                    (match (opt_i64_i64_map.get (& current) name-id)
                      [(opt_i64_i64_map.LookupFound value) value]
                      [(opt_i64_i64_map.LookupMissing) 0])]
                  (match (opt-call-memory-function-candidate
                    type-segment-bases
                    current
                    function-set
                    func)
                    ;; Unreachable in practice; taking it abandons the round.
                    [(OptCallMemoryCandidate.Unresolved)
                      (OptCallMemoryOptimisticPass.Pass out changed false)]
                    [(OptCallMemoryCandidate.Known summary)
                      (begin
                        (opt_i64_i64_map.insert-ref! (&mut out) name-id summary)
                        (opt-call-memory-optimistic-pass
                          type-segment-bases
                          (__tl-box-place rest)
                          resolved
                          current
                          function-set
                          out
                          (or changed (not (= summary previous)))
                          usable?))]))]))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-call-memory-optimistic-pass
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list seq)
        resolved
        current
        function-set
        out
        changed
        usable?)]))

(define (opt-call-memory-optimistic-fixed
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [resolved : opt_i64_i64_map.Map]
  [function-set : opt_i64_i64_map.Map]
  [current : opt_i64_i64_map.Map]
  [capacity : i64]
  [remaining : i64]) : opt_i64_i64_map.Map
  (if (<= remaining 0)
    resolved
    (match (opt-call-memory-optimistic-pass
      type-segment-bases
      functions
      resolved
      current
      function-set
      (opt-call-memory-seed-builtins (opt_i64_i64_map.with-capacity capacity))
      false
      true)
      [(OptCallMemoryOptimisticPass.Pass next changed usable?)
        (if (not usable?)
          resolved
          (if changed
            (opt-call-memory-optimistic-fixed
              type-segment-bases
              functions
              resolved
              function-set
              next
              capacity
              (- remaining 1))
            ;; The transfer reproduced this map: it is a fixed point, commit it.
            next))])))

(define (opt-call-memory-build
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [capacity : i64]) : opt_i64_i64_map.Map
  (let
    [function-set : opt_i64_i64_map.Map
      (opt-call-memory-function-set
        functions
        (opt_i64_i64_map.with-capacity capacity))]
    [resolved : opt_i64_i64_map.Map
      (opt-call-memory-build-fixed
        type-segment-bases
        functions
        function-set
        (opt-call-memory-seed-builtins (opt_i64_i64_map.with-capacity capacity))
        capacity
        (+ (opt-function-list-count functions) 1))]
    (if (= (opt-call-memory-unresolved-count functions resolved 0) 0)
      resolved
      (opt-call-memory-optimistic-fixed
        type-segment-bases
        functions
        resolved
        function-set
        (opt-call-memory-seed-optimistic
          functions
          resolved
          (opt-call-memory-seed-builtins
            (opt_i64_i64_map.with-capacity capacity)))
        capacity
        (opt-call-memory-optimistic-rounds)))))

;; Prove which globals are compile-time constants so their value can be
;; substituted for the global at its uses. The win is twofold: (a) every global
;; use otherwise emits a rip-relative load, so substituting the literal removes a
;; per-iteration memory load (the instruction-count win on opt_crc32/opt_quicksort
;; mask constants), and (b) a div/mod by such a global becomes a literal divisor
;; the backend strength-reduces with the existing magic-multiply path (matching
;; clang).
;;
;; Soundness: substituting a global's initializer is valid only when the global is
;; immutable. A global is mutated by either (1) a direct `CompilerIrInstr.Store name`
;; (the lowering of `(set! global ...)`, see compiler_lower.tl AstExpr.Set), or
;; (2) a write through a pointer derived from its address, which only exists if
;; `(& global)` was taken -- lowered to `CompilerIrValue.GlobalAddr name`. Disqualifying a
;; global on EITHER signal leaves only provably-never-written globals, whose value
;; equals the initializer at every use. The disqualify walk mirrors
;; `opt-reach-instr` arm-for-arm (and, like it, omits a wildcard arm) so adding a
;; new IR instruction fails to compile until it is handled here -- a new operand
;; position can never silently escape the address-taken check.
(define (opt-const-globals-disq-value
  [disq : opt_i64_i64_map.Map (:consume)]
  [value : ir.CompilerIrValue]) : opt_i64_i64_map.Map
  (match value
    [(ir.CompilerIrValue.GlobalAddr name)
      (begin
        (opt_i64_i64_map.insert-ref!
          (&mut disq)
          (ir.compiler-ir-symbol-id name)
          1)
        disq)]
    [_ disq]))

(define (opt-const-globals-disq-value!
  [disq : (&mut disq opt_i64_i64_map.Map)]
  [value : ir.CompilerIrValue]) : unit
  (match value
    [(ir.CompilerIrValue.GlobalAddr name)
      (opt_i64_i64_map.insert-ref! disq (ir.compiler-ir-symbol-id name) 1)]
    [_ unit]))

(define (opt-const-globals-disq-args-array
  [disq : opt_i64_i64_map.Map (:consume)]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : opt_i64_i64_map.Map
  (if (>= index (array-length values))
    disq
    (opt-const-globals-disq-args-array
      (opt-const-globals-disq-value disq (array-ref values index))
      values
      (+ index 1))))

(define (opt-const-globals-disq-args
  [disq : opt_i64_i64_map.Map (:consume)]
  [args : ir.CompilerIrCallArgs]) : opt_i64_i64_map.Map
  (match args
    [(ir.CompilerIrCallArgs.Nil) disq]
    [(ir.CompilerIrCallArgs.One value)
      (opt-const-globals-disq-value disq value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq a) b)]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-const-globals-disq-args-array disq values 0)]))

(define (opt-const-globals-disq-spmd-args
  [disq : opt_i64_i64_map.Map (:consume)]
  [args : ir.CompilerIrSpmdCallArgList]) : opt_i64_i64_map.Map
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) disq]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (opt-const-globals-disq-spmd-args
            (opt-const-globals-disq-value disq value)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : opt_i64_i64_map.Map disq]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                  (opt-const-globals-disq-value! (&mut out) value)])
              (set! i (+ i 1))))
          out))]))

(define (opt-const-globals-disq-maybe
  [disq : opt_i64_i64_map.Map (:consume)]
  [maybe : ir.CompilerIrMaybeValue]) : opt_i64_i64_map.Map
  (match maybe
    [(ir.CompilerIrMaybeValue.No) disq]
    [(ir.CompilerIrMaybeValue.Some value)
      (opt-const-globals-disq-value disq value)]))

(define (opt-const-globals-disq-phi
  [disq : opt_i64_i64_map.Map (:consume)]
  [inputs : ir.CompilerIrPhiInputList]) : opt_i64_i64_map.Map
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) disq]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-const-globals-disq-phi
        disq
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (opt-const-globals-disq-phi
        (opt-const-globals-disq-value disq value)
        (__tl-box-place rest))]))

;; Disqualify a global on a direct store to it OR on any `CompilerIrValue.GlobalAddr`
;; operand. Mirrors opt-reach-instr (no wildcard arm); the only behavioural
;; differences are that `CompilerIrInstr.Store` also records its target name and call/tail
;; targets (function names, never const-global candidates) are not scanned.
(define (opt-const-globals-disq-instr
  [disq : opt_i64_i64_map.Map (:consume)]
  [instr : ir.CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _) (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.Alloc _ _) disq]
    [(ir.CompilerIrInstr.AddrOf _ _) disq]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq base)
        offset)]
    [(ir.CompilerIrInstr.Load _ src _) (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.StorePtr dst src _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq dst) src)]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq dst) src)]
    [(ir.CompilerIrInstr.BoundsCheck idx length _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq idx)
        length)]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq lhs) rhs)]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.LaneId _ _ _) disq]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (opt-const-globals-disq-value disq value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value disq lhs)
          rhs))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value disq src)
          carry))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value disq lhs)
          rhs))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-const-globals-disq-value (opt-const-globals-disq-value disq lhs) rhs)]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq mask)
            on-true)
          on-false))]
    [(ir.CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq base)
        idx)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq base)
            idx)
          value))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq base)
              idx)
            value)
          mask))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq base)
            idx)
          mask))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq base)
            index-base)
          idx))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (opt-const-globals-disq-value
          (opt-const-globals-disq-maybe
            (opt-const-globals-disq-value
              (opt-const-globals-disq-value disq source)
              selector-low)
            selector-high)
          active-lanes))]
    [(ir.CompilerIrInstr.TailMask _ idx length _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq idx)
        length)]
    [(ir.CompilerIrInstr.EntryArgc _) disq]
    [(ir.CompilerIrInstr.EntryArgv _) disq]
    [(ir.CompilerIrInstr.EntryEnvp _) disq]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-const-globals-disq-value
        (opt-const-globals-disq-value disq leaf)
        subleaf)]
    [(ir.CompilerIrInstr.Xgetbv _ idx) (opt-const-globals-disq-value disq idx)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (opt-const-globals-disq-args disq args)]
    [(ir.CompilerIrInstr.Call _ _ args _)
      (opt-const-globals-disq-args disq args)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-const-globals-disq-args
          (opt-const-globals-disq-value disq base)
          args))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-const-globals-disq-spmd-args
          (opt-const-globals-disq-value disq active-mask)
          args))]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-const-globals-disq-args
          (opt-const-globals-disq-value
            (opt-const-globals-disq-value disq base)
            func)
          args))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (opt-const-globals-disq-args disq args)]
    [(ir.CompilerIrInstr.Store name value _)
      (begin
        (opt_i64_i64_map.insert-ref!
          (&mut disq)
          (ir.compiler-ir-symbol-id name)
          1)
        (opt-const-globals-disq-value disq value))]
    [(ir.CompilerIrInstr.Jump _) disq]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-const-globals-disq-value disq cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-const-globals-disq-value disq cond)]
    [(ir.CompilerIrInstr.Return maybe)
      (opt-const-globals-disq-maybe disq maybe)]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-const-globals-disq-phi disq inputs)]
    [(ir.CompilerIrInstr.Pack _ _ _) disq]
    [(ir.CompilerIrInstr.Word _ src _ _)
      (opt-const-globals-disq-value disq src)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (opt-const-globals-disq-args
        (opt-const-globals-disq-value disq func)
        args)]
    [(ir.CompilerIrInstr.Switch idx _ _ _)
      (opt-const-globals-disq-value disq idx)]
    [(ir.CompilerIrInstr.TotalEnumSwitch idx _ _ _ _)
      (opt-const-globals-disq-value disq idx)]))

(define (opt-const-globals-disq-seq-from
  [disq : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : opt_i64_i64_map.Map
  (if (>= index count)
    disq
    (opt-const-globals-disq-seq-from
      (opt-const-globals-disq-instr
        disq
        (ir.compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1)
      count)))

(define (opt-const-globals-disq-blocks
  [disq : opt_i64_i64_map.Map (:consume)]
  [blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) disq]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-const-globals-disq-blocks
            (opt-const-globals-disq-seq-from
              disq
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs))
            (__tl-box-place rest))])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [acc : opt_i64_i64_map.Map disq]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    acc
                    (opt-const-globals-disq-seq-from
                      acc
                      instrs
                      0
                      (ir.compiler-ir-instr-seq-count instrs)))])
              (set! i (+ i 1))))
          acc))]))

(define (opt-const-globals-disqualified
  [disq : opt_i64_i64_map.Map]
  [functions : ir.CompilerIrFunctionList]) : opt_i64_i64_map.Map
  (match functions
    [(ir.CompilerIrFunctionList.Nil) disq]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
          (opt-const-globals-disqualified
            (opt-const-globals-disq-blocks disq blocks)
            (__tl-box-place rest))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-const-globals-disqualified
        disq
        (ir.compiler-ir-function-seq-to-list seq))]))

;; A constant only earns substitution when it fits a signed 32-bit immediate, so
;; the backend can fold it directly into the instruction (`and reg, $imm32`)
;; instead of loading it. A larger constant cannot be an immediate operand and
;; must be materialized with `movabs` at every use, which is no cheaper than --
;; and, when the original global load was hoisted/CSEd to a single load feeding
;; many uses, strictly worse than -- leaving the global alone. Restricting to
;; imm32 keeps the transform a pure win (it never adds instructions) and is what
;; kept the opt1 self-compile metric from regressing on the compiler's own large
;; constant globals.
(define (opt-const-globals-imm32-fits? [n : i64]) : bool
  (and (>= n (- 0 2147483648)) (<= n 2147483647)))

;; Build the constant table: literal `CompilerIrValue.I64` globals that are not
;; disqualified (stored / address-taken), are imm32-encodable, and are nonzero.
;; Zero is excluded so a substituted divisor can never become a literal `0` (the
;; backend's magic-multiply path assumes a nonzero divisor; an actual `% 0` keeps
;; its original trapping global-load form).
(define (opt-const-globals-from-globals
  [globals : ir.CompilerIrGlobalList]
  [disq : opt_i64_i64_map.Map]
  [map : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match globals
    [(ir.CompilerIrGlobalList.Nil) map]
    [(ir.CompilerIrGlobalList.Cons global rest)
      (opt-const-globals-from-globals
        (__tl-box-place rest)
        disq
        (match global
          [(ir.CompilerIrGlobal.Global name _ value)
            (match value
              [(ir.CompilerIrValue.I64 n)
                (if (or
                  (= n 0)
                  (not (opt-const-globals-imm32-fits? n))
                  (opt_i64_i64_map.contains?
                    (& disq)
                    (ir.compiler-ir-symbol-id name)))
                  map
                  (begin
                    (opt_i64_i64_map.insert-ref!
                      (&mut map)
                      (ir.compiler-ir-symbol-id name)
                      n)
                    map))]
              [_ map])]))]
    [(ir.CompilerIrGlobalList.Array seq)
      (opt-const-globals-from-global-seq seq 0 disq map)]))

(define (opt-const-globals-from-global-seq
  [globals : ir.CompilerIrGlobalSeq]
  [index : i64]
  [disq : opt_i64_i64_map.Map]
  [map : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-global-seq-count globals))
    map
    (opt-const-globals-from-global-seq
      globals
      (+ index 1)
      disq
      (match (ir.compiler-ir-global-seq-ref globals index)
        [(ir.CompilerIrGlobal.Global name _ value)
          (match value
            [(ir.CompilerIrValue.I64 n)
              (if (or
                (= n 0)
                (not (opt-const-globals-imm32-fits? n))
                (opt_i64_i64_map.contains?
                  (& disq)
                  (ir.compiler-ir-symbol-id name)))
                map
                (begin
                  (opt_i64_i64_map.insert-ref!
                    (&mut map)
                    (ir.compiler-ir-symbol-id name)
                    n)
                  map))]
            [_ map])]))))

(define (opt-const-divisors-build
  [globals : ir.CompilerIrGlobalList]
  [functions : ir.CompilerIrFunctionList]) : opt_i64_i64_map.Map
  (let
    [capacity : i64
      (opt-function-index-capacity (ir.compiler-ir-global-list-count globals))]
    [disq : opt_i64_i64_map.Map
      (opt-const-globals-disqualified
        (opt_i64_i64_map.with-capacity capacity)
        functions)]
    (opt-const-globals-from-globals
      globals
      disq
      (opt_i64_i64_map.with-capacity capacity))))

;; The whole-program call summaries (argc-return + length-clean +
;; direct-call-clean + call-memory) gate on a function-count limit because they
;; scan function bodies across a fixpoint. The const-divisor table is independent
;; and far cheaper (one linear store scan), so it is built separately by the
;; program driver and injected here rather than tied to this gate -- see
;; optimize-program-with-level.
(define (opt-loop-bce-summary-function-limit) : i64
  ;; Dotted stdlib imports can leave small programs with more pre-prune reachable
  ;; functions than the old 64-function gate, even when the final program is still
  ;; tiny. Keep the fixpoint summary pass bounded, but high enough for those cases.
  1024)

;; Every function whose call-memory summary is exactly 0 writes no memory at
;; all: no parameter-rooted write (bits 0..59), no global storage write
;; (bit 60), no unknown effect (bit 61). That is exactly the fact
;; `direct-call-clean` stands for at a LICM call site, and the call-memory
;; builder proves it with a callgraph fixpoint whose deliberately partial map
;; leaves recursive cycles and over-limit programs unresolved -- so unioning it
;; in can only ADD leaves that provably write nothing, never relax a callee the
;; older syntactic walk had already rejected on effects.
;;
;; Only functions of the program's own list are considered: a name absent from
;; the map is unresolved and stays opaque, and indirect/C-ABI/SPMD call sites
;; have no callee name to look up and keep their unconditional
;; `opt-licm-store-summary-call-or-unknown`.
;; The `direct-call-clean` map's value is a bit set, not a presence marker.
;;
;;   bit 0 (opt-direct-call-clean-memory-bit) writes no memory at all
;;   bit 1 (opt-direct-call-clean-global-bit) writes no GLOBAL storage directly
;;   bit 2 (opt-direct-call-clean-unconditional-global-bit) writes only memory
;;         that is disjoint from every global cell (descriptor elements)
;;
;; Bit 0 is the older fact and implies bit 1. Bit 1 alone is the weaker,
;; strictly more common one: a callee that writes only through the objects its
;; parameters name -- every `(&mut v)` helper -- writes no global cell, which is
;; all the global-operand invariance question asks (opt-licm-globals-clean?).
;; Membership is therefore never a sound test on its own; every reader asks for
;; the bit it needs.
;;
;; Bit 2 is bit 1 SHARPENED, and it is the fact a DESCRIPTOR word needs. Bit 1
;; holds for two different reasons -- "every write goes through a parameter's
;; own object" and "every write goes into element storage" -- which are the same
;; verdict about global cells and OPPOSITE verdicts about the descriptor header
;; words a caller can reach: a parameter-rooted write may land on the very
;; descriptor the caller handed over, while an element write provably cannot
;; (the buffer a data slot names is a different allocation from the descriptor
;; that names it -- see opt-call-memory-element-bit for that layering argument).
;; Bit 2 is set only for the second reason, so a reader asking "can this callee
;; change a descriptor word I already loaded?" has a bit that answers it. It
;; implies bit 1 and is implied by nothing; bit 0 is a STRONGER fact but a
;; different one, and it answers the same question (a callee writing no memory
;; writes no element storage either), so the descriptor readers take either.
(define (opt-direct-call-clean-memory-bit) : i64
  1)

(define (opt-direct-call-clean-global-bit) : i64
  2)

(define (opt-direct-call-clean-unconditional-global-bit) : i64
  4)

(define (opt-direct-call-clean-has-bit?
  [direct-call-clean : opt_i64_i64_map.Map]
  [name : i64]
  [bit : i64]) : bool
  (match (opt_i64_i64_map.get
    (& direct-call-clean)
    (ir.compiler-ir-symbol-id name))
    [(opt_i64_i64_map.LookupFound bits) (not (= (bit-and bits bit) 0))]
    [(opt_i64_i64_map.LookupMissing) false]))

;; Bit 0 for the provably-write-nothing leaves, bit 1 for everything the
;; call-memory fixpoint resolved without a global-storage write and without an
;; unknown effect. Both are read off the same partial map: a name it leaves
;; absent is unresolved (recursive cycles, over-budget programs) and earns no
;; bit, so this can only ADD facts to the syntactic walk's verdict.
;;
;; A summary carrying no parameter-write bits earns the unconditional bit too:
;; its only possible writes are to descriptor element storage, disjoint from
;; every cell regardless of the arguments. A parameter-writing callee earns the
;; ordinary global bit only; LICM may use that weaker fact only when the
;; whole-program summary proves that no cell address exists anywhere.
(define (opt-loop-bce-direct-call-clean-bits [summary : i64]) : i64
  (if (= summary 0)
    (bit-or
      (opt-direct-call-clean-memory-bit)
      (bit-or
        (opt-direct-call-clean-global-bit)
        (opt-direct-call-clean-unconditional-global-bit)))
    (if (or
      (opt-call-memory-summary-global? summary)
      (opt-call-memory-summary-unknown? summary))
      0
      (bit-or
        (opt-direct-call-clean-global-bit)
        (if (opt-call-memory-summary-has-param-writes? summary)
          0
          (opt-direct-call-clean-unconditional-global-bit))))))

(define (opt-loop-bce-direct-call-clean-add-memory-clean
  [functions : ir.CompilerIrFunctionList]
  [call-memory : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match functions
    [(ir.CompilerIrFunctionList.Nil) out]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (let
            [name-id : i64 (ir.compiler-ir-symbol-id name)]
            [_record : unit
              (match (opt_i64_i64_map.get (& call-memory) name-id)
                [(opt_i64_i64_map.LookupFound summary)
                  (let
                    [bits : i64 (opt-loop-bce-direct-call-clean-bits summary)]
                    [existing : i64
                      (match (opt_i64_i64_map.get (& out) name-id)
                        [(opt_i64_i64_map.LookupFound old) old]
                        [(opt_i64_i64_map.LookupMissing) 0])]
                    (if (= (bit-or existing bits) existing)
                      unit
                      (opt_i64_i64_map.insert-ref!
                        (&mut out)
                        name-id
                        (bit-or existing bits))))]
                [(opt_i64_i64_map.LookupMissing) unit])]
            (opt-loop-bce-direct-call-clean-add-memory-clean
              (__tl-box-place rest)
              call-memory
              out))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-loop-bce-direct-call-clean-add-memory-clean
        (ir.compiler-ir-function-seq-to-list seq)
        call-memory
        out)]))

(define (opt-loop-bce-build-summaries-with-direct-call-clean
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [build-direct-call-clean : bool]
  [build-call-memory : bool]) : OptLoopBceSummaries
  (let
    [capacity : i64
      (opt-function-index-capacity (opt-function-list-count functions))]
    [argc-return : opt_i64_i64_map.Map
      (opt-loop-bce-argc-return-map
        type-segment-bases
        functions
        (opt_i64_i64_map.with-capacity capacity))]
    [length-clean : opt_i64_i64_map.Map
      (match (opt-loop-bce-length-clean-pass
        type-segment-bases
        functions
        (opt_i64_i64_map.with-capacity capacity))
        [(OptLoopBceCleanPass.Pass clean _) clean])]
    [call-memory : opt_i64_i64_map.Map
      (if build-call-memory
        (opt-call-memory-build type-segment-bases functions capacity)
        (opt_i64_i64_map.with-capacity 1))]
    ;; `call-memory` is built first so the clean map can union in its
    ;; provably-write-nothing leaves. `build-direct-call-clean` is the level>=2
    ;; gate, so opt0/opt1 keep an empty map and stay byte-identical.
    [direct-call-clean : opt_i64_i64_map.Map
      (if build-direct-call-clean
        (opt-loop-bce-direct-call-clean-add-memory-clean
          functions
          call-memory
          (opt-loop-bce-direct-call-clean-map functions capacity))
        (opt_i64_i64_map.with-capacity 1))]
    (OptLoopBceSummaries
      true
      (profile_state.compiler-profile-state-new)
      length-clean
      direct-call-clean
      call-memory
      argc-return
      (opt_i64_i64_map.with-capacity 1)
      (opt-global-cell-summary-empty))))

(define (opt-loop-bce-summaries-set-const-divisors
  [summaries : OptLoopBceSummaries]
  [const-divisors : opt_i64_i64_map.Map]) : OptLoopBceSummaries
  (OptLoopBceSummaries
    summaries.enabled
    summaries.profile-state
    summaries.length-clean
    summaries.direct-call-clean
    summaries.call-memory
    summaries.argc-return
    const-divisors
    summaries.global-cell))

(define (opt-loop-bce-summaries-set-global-cell
  [summaries : OptLoopBceSummaries]
  [global-cell : OptGlobalCellSummary]) : OptLoopBceSummaries
  (OptLoopBceSummaries
    summaries.enabled
    summaries.profile-state
    summaries.length-clean
    summaries.direct-call-clean
    summaries.call-memory
    summaries.argc-return
    summaries.const-divisors
    global-cell))

(define (opt-loop-bce-summaries-set-profile-state
  [summaries : OptLoopBceSummaries]
  [state : profile_state.CompilerProfileState]) : OptLoopBceSummaries
  (OptLoopBceSummaries
    summaries.enabled
    state
    summaries.length-clean
    summaries.direct-call-clean
    summaries.call-memory
    summaries.argc-return
    summaries.const-divisors
    summaries.global-cell))

;; Build the per-program summaries: the function-count-gated BCE/LICM call maps
;; plus the const-divisor table. The const-divisor table is built only at opt
;; level 2 (the only level whose pipeline runs the divisor rewrite), so opt0/opt1
;; -- and in particular the opt1 self-compile throughput metric -- pay nothing
;; for it and stay byte-identical. The global-cell summary follows the same
;; gate: only the level-2 pipeline runs the global_cell pass.
(define (opt-build-program-summaries
  [type-segment-bases : i64]
  [globals : ir.CompilerIrGlobalList]
  [reachable-functions : ir.CompilerIrFunctionList]
  [level : i64]) : OptLoopBceSummaries
  (opt-loop-bce-summaries-set-global-cell
    (opt-loop-bce-summaries-set-const-divisors
      (if (<=
        (opt-function-list-count reachable-functions)
        (opt-loop-bce-summary-function-limit))
        (opt-loop-bce-build-summaries-with-direct-call-clean
          type-segment-bases
          reachable-functions
          (>= level 2)
          (>= level 1))
        (opt-loop-bce-empty-summaries))
      (if (>= level 2)
        (opt-const-divisors-build globals reachable-functions)
        (opt_i64_i64_map.with-capacity 1)))
    (if (>= level 2)
      (opt-global-cell-summary-build globals reachable-functions)
      (opt-global-cell-summary-empty))))

;; Substitute a proven constant global with its literal value in
;; scalar operand positions. For an ordinary operand this lets the backend fold
;; the literal instead of emitting a per-use rip-relative load (the
;; opt_crc32/opt_quicksort mask-load win). For a div/mod divisor it produces a
;; literal `CompilerIrValue.I64`, which `compiler-backend-binop-literal-divmod-asm`
;; strength-reduces with the existing magic-multiply path (matching clang).
;; (The map is named `const-divisors` for historical reasons but now holds every
;; proven-constant global, not only divisors.)
(define (opt-const-global-subst-value
  [const-divisors : opt_i64_i64_map.Map]
  [v : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match v
    [(ir.CompilerIrValue.Global name)
      (match (opt_i64_i64_map.get
        (& const-divisors)
        (ir.compiler-ir-symbol-id name))
        [(opt_i64_i64_map.LookupFound n) (ir.CompilerIrValue.I64 n)]
        [(opt_i64_i64_map.LookupMissing) v])]
    [_ v]))

;; The early rewrite substitutes every scalar operand position whose literal
;; the round-1 local fold and the loop passes can both consume: BinOp operands
;; (compare operands feeding branches included), UnOp sources, Cast/Bitcast
;; sources, and Mov sources. Running at the start of the iteration -- before
;; induction/bce_version -- a literal global bound constant-enables unroll,
;; induction, and versioning downstream, none of which accept a global-ref
;; operand (a hidden rip-relative load, neither a literal nor an invariant SSA
;; value). Substituting Mov sources early is register-neutral: the following
;; fold propagates the literal into its uses and DCEs the Move, so a bound used
;; only in a compare still ends as an immediate operand. The older late pass
;; below (`opt-const-global-move-rewrite-*`) kept comparison-bound Moves
;; symbolic to avoid holding a constant in a register across a loop; that
;; concern does not apply here because the fold removes the Move entirely. The
;; late passes stay in place and simply become no-ops for the sites this pass
;; already covered (they still catch globals materialized mid-iteration by
;; other passes). Load/StorePtr/Gep and the vector arms keep the global's
;; hidden-load form: their operand is an address or a descriptor pointer, not
;; a scalar the fold can use.
(define (opt-const-divisor-rewrite-instr
  [const-divisors : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        dst
        op
        (opt-const-global-subst-value const-divisors lhs)
        (opt-const-global-subst-value const-divisors rhs)
        ty)]
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        dst
        (opt-const-global-subst-value const-divisors src)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        dst
        op
        (opt-const-global-subst-value const-divisors src)
        ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        dst
        (opt-const-global-subst-value const-divisors src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        dst
        (opt-const-global-subst-value const-divisors src)
        from-ty
        to-ty)]
    ;; Store values are uses like any other: leaving a const global symbolic
    ;; at a store while substituting it at compares would split a symbolic
    ;; equality (e.g. ctor_fwd forwarding the descriptor-stored global to a
    ;; length load that no longer matches the substituted loop bound), so the
    ;; stored value is substituted too. The store's target name is not a use.
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        ptr
        (opt-const-global-subst-value const-divisors value)
        ty)]
    [(ir.CompilerIrInstr.Store name value ty)
      (ir.CompilerIrInstr.Store
        name
        (opt-const-global-subst-value const-divisors value)
        ty)]
    ;; A check whose length is a const global becomes a literal-length check:
    ;; the forwarded/equality eliminations and the literal-bound reasoning
    ;; downstream both consume that form.
    [(ir.CompilerIrInstr.BoundsCheck index length label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-const-global-subst-value const-divisors index)
        (opt-const-global-subst-value const-divisors length)
        label)]
    [_ instr]))

;; One rewritten instruction per input instruction, so write straight into a
;; sized target sequence. The cons-and-reverse form this replaces allocated two
;; cells per instruction and then rebuilt the array it started from.
(define (opt-const-divisor-rewrite-seq
  [const-divisors : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-const-divisor-rewrite-instr
              const-divisors
              (ir.compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-const-divisor-rewrite-block
  [const-divisors : opt_i64_i64_map.Map]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (opt-const-divisor-rewrite-seq const-divisors instrs))]))

(define (opt-const-divisor-rewrite-blocks
  [const-divisors : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-const-divisor-rewrite-block const-divisors block)
        (opt-const-divisor-rewrite-blocks const-divisors (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-const-divisor-rewrite-blocks
        const-divisors
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Skip the whole pass (returning the blocks untouched) when no constant-global
;; divisor exists -- the common case, so the level-2 fixpoint pays only a length
;; check per function rather than a block walk.
(define (opt-const-divisor-rewrite-summary-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [const-divisors : opt_i64_i64_map.Map summaries.const-divisors]
    (if (= (opt_i64_i64_map.len (& const-divisors)) 0)
      blocks
      (opt-const-divisor-rewrite-blocks const-divisors blocks))))

;; Rewrite proven constant globals in lowering-time Moves only after the loop
;; BCE and unroll passes for this iteration have consumed their symbolic bound
;; identities. The following iteration's ordinary fold sees the literal and
;; simplifies its dependent arithmetic before late LICM. Restrict this to Moves
;; feeding non-comparison arithmetic: replacing a global used only as a loop
;; limit with an immediate can increase register pressure without enabling a
;; fold, while branchless min/bound recipes include bit/arithmetic uses. The
;; early rewrite (opt-const-divisor-rewrite-instr) already covers every
;; lowering-time Move at the start of the iteration, so in the pipeline this
;; pass now fires only on const-global Moves materialized mid-iteration by
;; other passes.
(define (opt-const-global-move-fold-vars-instr
  [vars : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
      (if (ir.compiler-ir-binop-compare? op)
        vars
        (opt-collect-value-uses (opt-collect-value-uses vars lhs) rhs))]
    [_ vars]))

(define (opt-const-global-move-fold-vars-seq
  [vars : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    vars
    (opt-const-global-move-fold-vars-seq
      (opt-const-global-move-fold-vars-instr
        vars
        (ir.compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-const-global-move-fold-vars-blocks
  [vars : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) vars]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-const-global-move-fold-vars-blocks
            (opt-const-global-move-fold-vars-seq vars instrs 0)
            (__tl-box-place rest))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-const-global-move-fold-vars-blocks
        vars
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-const-global-move-rewrite-instr
  [const-divisors : opt_i64_i64_map.Map]
  [fold-vars : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (if (opt-used-contains fold-vars dst)
        (ir.CompilerIrInstr.Mov
          dst
          (opt-const-global-subst-value const-divisors src)
          ty)
        instr)]
    [_ instr]))

(define (opt-const-global-move-rewrite-seq
  [const-divisors : opt_i64_i64_map.Map]
  [fold-vars : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-const-global-move-rewrite-instr
              const-divisors
              fold-vars
              (ir.compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-const-global-move-rewrite-block
  [const-divisors : opt_i64_i64_map.Map]
  [fold-vars : opt_i64_i64_map.Map]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (opt-const-global-move-rewrite-seq const-divisors fold-vars instrs))]))

(define (opt-const-global-move-rewrite-blocks
  [const-divisors : opt_i64_i64_map.Map]
  [fold-vars : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-const-global-move-rewrite-block const-divisors fold-vars block)
        (opt-const-global-move-rewrite-blocks
          const-divisors
          fold-vars
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-const-global-move-rewrite-blocks
        const-divisors
        fold-vars
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-const-global-move-rewrite-summary-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [const-divisors : opt_i64_i64_map.Map summaries.const-divisors]
    (if (= (opt_i64_i64_map.len (& const-divisors)) 0)
      blocks
      (opt-const-global-move-rewrite-blocks
        const-divisors
        (opt-const-global-move-fold-vars-blocks
          (opt_i64_i64_map.with-capacity 64)
          blocks)
        blocks))))

;; --- function-scope global-cell invariance (global_cell pass) ----------------
;;
;; A `CompilerIrValue.Global name` operand is a hidden LOAD of the global's cell:
;; the backend emits a fresh rip-relative read at every use, and because that
;; operand is neither a literal nor an SSA var it is invisible to GVN/LICM and
;; unacceptable to the versioning machinery as a loop bound or check length.
;; For a global G that cannot be written during a function's execution this
;; pass loads G's cell ONCE in the function's entry block (`mov %g, @G` --
;; global-ref is a legal Mov source) and rewrites every in-function use of `@G`
;; to `%g`. Downstream effects: (i) per-use rip reloads collapse to one load
;; per activation; (ii) descriptor gep+load pairs off an array global
;; (`gep @arr, 1; load`) become ordinary SSA-fed instructions -- the entry Mov
;; carries the declared array type, so the load-header classification marks %g
;; a descriptor base and the existing load-GVN/LICM machinery can dedup and
;; hoist the length/data-pointer loads out of loops; (iii) loop bounds and
;; check lengths that were global refs become invariant SSA vars, which
;; bce_version accepts.
;;
;; SOUNDNESS. G's cell cannot change value during this function's execution
;; when all of the following hold:
;;   (a) no `CompilerIrInstr.Store G` (set!) appears in THIS function's blocks
;;       (a function that stores G keeps direct per-use cell semantics);
;;   (b) `CompilerIrValue.GlobalAddr G` appears NOWHERE in the whole program, so
;;       no store_ptr/syscall/callee can reach the cell through a pointer. This
;;       set is derived from the const-global disqualify walk -- which records
;;       exactly Store targets and GlobalAddr operands, arm-for-arm so a new IR
;;       instruction fails to compile until handled -- minus this program's
;;       Store targets, so it is exactly the address-taken globals;
;;   (c) the function contains no Call/TailCall/indirect-call/SpmdCall that can
;;       RETURN: any such callee could set! G. v1 deliberately treats the whole
;;       returning call family as opaque; a callgraph refinement (block only
;;       callees that may set! G) is a later packet. Passes after this one only
;;       rewrite or clone existing instructions -- the inliner, the pipeline's
;;       only call producer, has already run -- so the no-call fact cannot be
;;       invalidated downstream. Trapping operations like BoundsCheck are not
;;       calls, and explicit panic paths diverge before any write could
;;       interleave -- which is exactly why a direct call to a non-returning
;;       trap helper is excluded from (c) as well: control never returns from
;;       it, so no use of `%g` runs after it and nothing it could write is ever
;;       read (opt-global-cell-scan-direct-call, opt-direct-call-noreturn?).
;; A set! in ANOTHER function (the loader pattern) cannot interleave with this
;; activation because (c) rules out the call that would reach it, and the
;; entry load observes any set! made before this activation -- exactly what a
;; per-use load would observe. Recursion needs no special case: today's
;; semantics already reload the cell at least once per activation (every use
;; reloads it), so materializing that load at entry is value-identical per
;; activation. The entry block dominates every use, so the rewritten SSA stays
;; well-formed. Multiple globals are loaded independently. Global sources of
;; entry-block Movs are deliberately left as direct cell loads: they are this
;; pass's own output shape, so rewriting them would re-hoist on the next
;; fixpoint iteration, and leaving them costs at most one entry-block load.
;;
;; Only single-word cells qualify (opt-global-cell-word-type?): the entry
;; Mov's declared type drives the backend's load width, and a wider
;; register-resident aggregate cell would silently load only its first word.
;; Register-resident aggregates (Struct/Enum and their Args forms) are
;; excluded because the optimizer cannot resolve their inline layouts; the
;; accepted set is exactly the types `compiler-backend-type-size` reports as
;; 1/2/4/8 without type-segment recursion.
(defstruct OptGlobalCellScan
  (refs opt_i64_i64_map.Map)
  (ref-list OptI64List)
  (stores opt_i64_i64_map.Map)
  (calls bool))

(define (opt-global-cell-scan-new) : OptGlobalCellScan
  (OptGlobalCellScan
    (opt_i64_i64_map.with-capacity 8)
    OptI64List.Nil
    (opt_i64_i64_map.with-capacity 8)
    false))

(define (opt-global-cell-scan-ref
  [scan : OptGlobalCellScan (:consume)]
  [name : i64]) : OptGlobalCellScan
  (match scan
    [(OptGlobalCellScan refs ref-list stores calls)
      (if (opt_i64_i64_map.contains? (& refs) name)
        (OptGlobalCellScan refs ref-list stores calls)
        (begin
          (opt_i64_i64_map.insert-ref! (&mut refs) name 1)
          (OptGlobalCellScan
            refs
            (OptI64List.Cons name (box ref-list))
            stores
            calls)))]))

(define (opt-global-cell-scan-store
  [scan : OptGlobalCellScan (:consume)]
  [name : i64]) : OptGlobalCellScan
  (match scan
    [(OptGlobalCellScan refs ref-list stores calls)
      (begin
        (opt_i64_i64_map.insert-ref! (&mut stores) name 1)
        (OptGlobalCellScan refs ref-list stores calls))]))

(define (opt-global-cell-scan-call [scan : OptGlobalCellScan]) : OptGlobalCellScan
  (if scan.calls
    scan
    (OptGlobalCellScan scan.refs scan.ref-list scan.stores true)))

;; Condition (c) rejects a function that may transfer control to a callee that
;; could `set! G` between the entry load and a use of `%g`. A non-returning
;; trap helper cannot: control never comes back from it, so NO use of `%g`
;; executes after it on any path, and no value it could write is ever read.
;; That is the same argument opt-direct-call-noreturn? states in full, and the
;; same one the pass header already makes for BoundsCheck and explicit panic
;; paths ("diverge before any write could interleave") -- a `call tl_oob_abort`
;; is exactly that panic path after the backend has expanded a check, or after
;; a stdlib range guard has been inlined here. Counting it would disqualify
;; every otherwise call-free function that inlines one.
(define (opt-global-cell-scan-direct-call
  [scan : OptGlobalCellScan]
  [name : i64]) : OptGlobalCellScan
  (if (opt-direct-call-noreturn? name)
    scan
    (opt-global-cell-scan-call scan)))

(define (opt-global-cell-scan-value
  [scan : OptGlobalCellScan]
  [value : ir.CompilerIrValue]) : OptGlobalCellScan
  (match value
    [(ir.CompilerIrValue.Global name)
      (opt-global-cell-scan-ref scan (ir.compiler-ir-symbol-id name))]
    [_ scan]))

(define (opt-global-cell-scan-args-array
  [scan : OptGlobalCellScan]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : OptGlobalCellScan
  (if (>= index (array-length values))
    scan
    (opt-global-cell-scan-args-array
      (opt-global-cell-scan-value scan (array-ref values index))
      values
      (+ index 1))))

(define (opt-global-cell-scan-args
  [scan : OptGlobalCellScan]
  [args : ir.CompilerIrCallArgs]) : OptGlobalCellScan
  (match args
    [(ir.CompilerIrCallArgs.Nil) scan]
    [(ir.CompilerIrCallArgs.One value) (opt-global-cell-scan-value scan value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan a) b)]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-global-cell-scan-args-array scan values 0)]))

(define (opt-global-cell-scan-spmd-args
  [scan : OptGlobalCellScan]
  [args : ir.CompilerIrSpmdCallArgList]) : OptGlobalCellScan
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) scan]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (opt-global-cell-scan-spmd-args
            (opt-global-cell-scan-value scan value)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : OptGlobalCellScan scan]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-global-cell-scan-value out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-global-cell-scan-maybe
  [scan : OptGlobalCellScan]
  [maybe : ir.CompilerIrMaybeValue]) : OptGlobalCellScan
  (match maybe
    [(ir.CompilerIrMaybeValue.No) scan]
    [(ir.CompilerIrMaybeValue.Some value)
      (opt-global-cell-scan-value scan value)]))

(define (opt-global-cell-scan-phi
  [scan : OptGlobalCellScan]
  [inputs : ir.CompilerIrPhiInputList]) : OptGlobalCellScan
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) scan]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-global-cell-scan-phi scan (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (opt-global-cell-scan-phi
        (opt-global-cell-scan-value scan value)
        (__tl-box-place rest))]))

;; Per-function fact scan: global-ref operand uses (refs), direct set! targets
;; (stores), and whether any RETURNING call-family instruction remains (calls;
;; a direct call to a non-returning trap helper is not one -- see
;; opt-global-cell-scan-direct-call). Mirrors
;; opt-const-globals-disq-instr arm-for-arm (no wildcard): a new IR instruction
;; fails to compile until classified here, so a new call-like or store-like
;; operand position can never silently escape the (a)/(c) checks. Pack words
;; carry no global operands (the same invariant opt-reach-instr relies on), so
;; they are not scanned; a missed ref is always sound (the pass rewrites a
;; subset of uses to a value-identical var), only a missed store or call is
;; not -- and those arms are exactly the ones this total match protects.
;; `entry?` marks the function's first block: Mov sources there are exempt
;; from refs because they are this pass's own output shape (see the header).
(define (opt-global-cell-scan-instr
  [scan : OptGlobalCellScan]
  [entry? : bool]
  [instr : ir.CompilerIrInstr]) : OptGlobalCellScan
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _)
      (if entry?
        scan
        (opt-global-cell-scan-value scan src))]
    [(ir.CompilerIrInstr.Alloc _ _) scan]
    [(ir.CompilerIrInstr.AddrOf _ _) scan]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan base) offset)]
    [(ir.CompilerIrInstr.Load _ src _) (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.StorePtr dst src _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan dst) src)]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan dst) src)]
    [(ir.CompilerIrInstr.BoundsCheck idx length _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan idx) length)]
    [(ir.CompilerIrInstr.Cast _ src _ _) (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan lhs) rhs)]
    [(ir.CompilerIrInstr.UnOp _ _ src _) (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.LaneId _ _ _) scan]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (opt-global-cell-scan-value scan value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-global-cell-scan-value (opt-global-cell-scan-value scan lhs) rhs))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (opt-global-cell-scan-value (opt-global-cell-scan-value scan src) carry))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-global-cell-scan-value (opt-global-cell-scan-value scan lhs) rhs))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan lhs) rhs)]
    [(ir.CompilerIrInstr.MaskNot _ src _) (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (opt-global-cell-scan-value
          (opt-global-cell-scan-value
            (opt-global-cell-scan-value scan mask)
            on-true)
          on-false))]
    [(ir.CompilerIrInstr.VectorLoad _ base idx _ _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan base) idx)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (opt-global-cell-scan-value
          (opt-global-cell-scan-value
            (opt-global-cell-scan-value scan base)
            idx)
          value))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-global-cell-scan-value
          (opt-global-cell-scan-value
            (opt-global-cell-scan-value
              (opt-global-cell-scan-value scan base)
              idx)
            value)
          mask))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-global-cell-scan-value
          (opt-global-cell-scan-value
            (opt-global-cell-scan-value scan base)
            idx)
          mask))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [idx (__tl-project-field (__tl-box-place payload-box) index)]
        (opt-global-cell-scan-value
          (opt-global-cell-scan-value
            (opt-global-cell-scan-value scan base)
            index-base)
          idx))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (opt-global-cell-scan-value
          (opt-global-cell-scan-maybe
            (opt-global-cell-scan-value
              (opt-global-cell-scan-value scan source)
              selector-low)
            selector-high)
          active-lanes))]
    [(ir.CompilerIrInstr.TailMask _ idx length _)
      (opt-global-cell-scan-value (opt-global-cell-scan-value scan idx) length)]
    [(ir.CompilerIrInstr.EntryArgc _) scan]
    [(ir.CompilerIrInstr.EntryArgv _) scan]
    [(ir.CompilerIrInstr.EntryEnvp _) scan]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-global-cell-scan-value
        (opt-global-cell-scan-value scan leaf)
        subleaf)]
    [(ir.CompilerIrInstr.Xgetbv _ idx) (opt-global-cell-scan-value scan idx)]
    [(ir.CompilerIrInstr.Syscall _ args) (opt-global-cell-scan-args scan args)]
    [(ir.CompilerIrInstr.Call _ name args _)
      (opt-global-cell-scan-args
        (opt-global-cell-scan-direct-call scan name)
        args)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-global-cell-scan-args
          (opt-global-cell-scan-value (opt-global-cell-scan-call scan) base)
          args))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-global-cell-scan-spmd-args
          (opt-global-cell-scan-value
            (opt-global-cell-scan-call scan)
            active-mask)
          args))]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (opt-global-cell-scan-args
        (opt-global-cell-scan-value (opt-global-cell-scan-call scan) func)
        args)]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (opt-global-cell-scan-args
        (opt-global-cell-scan-value (opt-global-cell-scan-call scan) func)
        args)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-global-cell-scan-args
          (opt-global-cell-scan-value
            (opt-global-cell-scan-value (opt-global-cell-scan-call scan) base)
            func)
          args))]
    [(ir.CompilerIrInstr.TailCall name args _)
      (opt-global-cell-scan-args
        (opt-global-cell-scan-direct-call scan name)
        args)]
    [(ir.CompilerIrInstr.Store name value _)
      (opt-global-cell-scan-value
        (opt-global-cell-scan-store scan (ir.compiler-ir-symbol-id name))
        value)]
    [(ir.CompilerIrInstr.Jump _) scan]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-global-cell-scan-value scan cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-global-cell-scan-value scan cond)]
    [(ir.CompilerIrInstr.Return maybe) (opt-global-cell-scan-maybe scan maybe)]
    [(ir.CompilerIrInstr.Phi _ inputs _) (opt-global-cell-scan-phi scan inputs)]
    [(ir.CompilerIrInstr.Pack _ _ _) scan]
    [(ir.CompilerIrInstr.Word _ src _ _) (opt-global-cell-scan-value scan src)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (opt-global-cell-scan-args
        (opt-global-cell-scan-value (opt-global-cell-scan-call scan) func)
        args)]
    [(ir.CompilerIrInstr.Switch idx _ _ _)
      (opt-global-cell-scan-value scan idx)]
    [(ir.CompilerIrInstr.TotalEnumSwitch idx _ _ _ _)
      (opt-global-cell-scan-value scan idx)]))

(define (opt-global-cell-scan-seq-from
  [scan : OptGlobalCellScan]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [entry? : bool]) : OptGlobalCellScan
  (if (>= index count)
    scan
    (opt-global-cell-scan-seq-from
      (opt-global-cell-scan-instr
        scan
        entry?
        (ir.compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1)
      count
      entry?)))

(define (opt-global-cell-scan-blocks
  [scan : OptGlobalCellScan]
  [blocks : ir.CompilerIrBlockList]
  [entry? : bool]) : OptGlobalCellScan
  (match blocks
    [(ir.CompilerIrBlockList.Nil) scan]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-global-cell-scan-blocks
            (opt-global-cell-scan-seq-from
              scan
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs)
              entry?)
            (__tl-box-place rest)
            false)])]
    ;; Read-only: scan the sequence instead of materialising a block cons
    ;; chain to walk once (refs #5729, same shape as the const-global walk).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [acc : OptGlobalCellScan scan]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    acc
                    (opt-global-cell-scan-seq-from
                      acc
                      instrs
                      0
                      (ir.compiler-ir-instr-seq-count instrs)
                      (and entry? (= i 0))))])
              (set! i (+ i 1))))
          acc))]))

(define (opt-global-cell-scan-functions
  [scan : OptGlobalCellScan]
  [functions : ir.CompilerIrFunctionList]) : OptGlobalCellScan
  (match functions
    [(ir.CompilerIrFunctionList.Nil) scan]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
          (opt-global-cell-scan-functions
            (opt-global-cell-scan-blocks scan blocks false)
            (__tl-box-place rest))])]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-global-cell-scan-functions
        scan
        (ir.compiler-ir-function-seq-to-list seq))]))

;; A global's cell qualifies for entry-load hoisting only when it is exactly
;; one machine word: the entry load is a single `mov %g, @G` whose Mov type is
;; the declared cell type, so a wider cell would silently load only its first
;; word. See the pass header for the full argument.
(define (opt-global-cell-word-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Ptr _) true]
    [(ast.AstType.MutPtr _) true]
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.MutRef _ _) true]
    [(ast.AstType.Box _) true]
    [(ast.AstType.String) true]
    [(ast.AstType.Str) true]
    [(ast.AstType.Bytes) true]
    [(ast.AstType.DynArray _) true]
    [(ast.AstType.Array _ _) true]
    [(ast.AstType.Func _ _) true]
    [(ast.AstType.Tuple _) true]
    [_ false]))

(define (opt-global-cell-types-fill
  [globals : ir.CompilerIrGlobalList]
  [type-index : opt_i64_i64_map.Map (:consume)]
  [types : (__tl_dyn-array ast.AstType)]
  [index : i64]) : opt_i64_i64_map.Map
  (match globals
    [(ir.CompilerIrGlobalList.Nil) type-index]
    [(ir.CompilerIrGlobalList.Cons global rest)
      (match global
        [(ir.CompilerIrGlobal.Global name ty _)
          (begin
            (set! (array-ref types index) ty)
            (opt_i64_i64_map.insert-ref!
              (&mut type-index)
              (ir.compiler-ir-symbol-id name)
              index)
            (opt-global-cell-types-fill
              (__tl-box-place rest)
              type-index
              types
              (+ index 1)))])]
    [(ir.CompilerIrGlobalList.Array seq)
      (opt-global-cell-types-fill
        (ir.compiler-ir-global-seq-to-list seq)
        type-index
        types
        index)]))

(define (opt-global-cell-type-lookup [cell : OptGlobalCellSummary] [name : i64]) : OptMaybeAstType
  (match (opt_i64_i64_map.get
    (& cell.type-index)
    (ir.compiler-ir-symbol-id name))
    [(opt_i64_i64_map.LookupFound index)
      (OptMaybeAstType.Some (array-ref cell.types index))]
    [(opt_i64_i64_map.LookupMissing) (OptMaybeAstType.No)]))

;; The address-taken set is exactly the const-global disqualified set minus the
;; program's direct-store targets: the disqualify walk records a global on a
;; `CompilerIrInstr.Store name` OR a `CompilerIrValue.GlobalAddr name` operand and
;; nothing else, so subtracting the former leaves precisely the latter. Both
;; walks are total matches over the IR, so the derivation cannot drift when the
;; IR grows an instruction variant.
(define (opt-global-cell-addr-taken-fill
  [globals : ir.CompilerIrGlobalList]
  [disq : opt_i64_i64_map.Map]
  [stores : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match globals
    [(ir.CompilerIrGlobalList.Nil) out]
    [(ir.CompilerIrGlobalList.Cons global rest)
      (match global
        [(ir.CompilerIrGlobal.Global name _ _)
          (opt-global-cell-addr-taken-fill
            (__tl-box-place rest)
            disq
            stores
            (if (and
              (opt_i64_i64_map.contains?
                (& disq)
                (ir.compiler-ir-symbol-id name))
              (not
                (opt_i64_i64_map.contains?
                  (& stores)
                  (ir.compiler-ir-symbol-id name))))
              (begin
                (opt_i64_i64_map.insert-ref!
                  (&mut out)
                  (ir.compiler-ir-symbol-id name)
                  1)
                out)
              out))])]
    [(ir.CompilerIrGlobalList.Array seq)
      (opt-global-cell-addr-taken-fill
        (ir.compiler-ir-global-seq-to-list seq)
        disq
        stores
        out)]))

(define (opt-global-cell-word-count
  [globals : ir.CompilerIrGlobalList]
  [addr-taken : opt_i64_i64_map.Map]
  [count : i64]) : i64
  (match globals
    [(ir.CompilerIrGlobalList.Nil) count]
    [(ir.CompilerIrGlobalList.Cons global rest)
      (match global
        [(ir.CompilerIrGlobal.Global name ty _)
          (opt-global-cell-word-count
            (__tl-box-place rest)
            addr-taken
            (if (and
              (opt-global-cell-word-type? ty)
              (not
                (opt_i64_i64_map.contains?
                  (& addr-taken)
                  (ir.compiler-ir-symbol-id name))))
              (+ count 1)
              count))])]
    [(ir.CompilerIrGlobalList.Array seq)
      (opt-global-cell-word-count
        (ir.compiler-ir-global-seq-to-list seq)
        addr-taken
        count)]))

;; Build the per-program global-cell summary: the declared-type table, the
;; address-taken set, and the count of globals that survive both filters (the
;; per-function pass skips its scan when that count is zero).
(define (opt-global-cell-summary-build
  [globals : ir.CompilerIrGlobalList]
  [functions : ir.CompilerIrFunctionList]) : OptGlobalCellSummary
  (let
    [count : i64 (ir.compiler-ir-global-list-count globals)]
    (if (= count 0)
      (opt-global-cell-summary-empty)
      (let
        [capacity : i64 (opt-function-index-capacity count)]
        [types : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType count)]
        [type-index : opt_i64_i64_map.Map
          (opt-global-cell-types-fill
            globals
            (opt_i64_i64_map.with-capacity capacity)
            types
            0)]
        [disq : opt_i64_i64_map.Map
          (opt-const-globals-disqualified
            (opt_i64_i64_map.with-capacity capacity)
            functions)]
        [scan : OptGlobalCellScan
          (opt-global-cell-scan-functions (opt-global-cell-scan-new) functions)]
        [addr-taken : opt_i64_i64_map.Map
          (opt-global-cell-addr-taken-fill
            globals
            disq
            scan.stores
            (opt_i64_i64_map.with-capacity capacity))]
        (OptGlobalCellSummary
          addr-taken
          type-index
          types
          (opt-global-cell-word-count globals addr-taken 0))))))

;; --- condition (a): stores a later read can OBSERVE ---------------------------
;;
;; The pass hoists ONE entry-block load of `@G` and rewrites every in-function
;; `@G` read to it, so it is correct exactly when no `set! G` this function
;; performs can be observed by one of those reads. Conditions (b) and (c)
;; already exclude every OTHER writer -- no address-taken cell can be reached
;; through a pointer, and a function containing any RETURNING call is rejected
;; outright, while the non-returning trap calls (c) still admits can make no
;; store observable at all (nothing runs after them) --
;; so only this function's own `Store G` instructions matter. A `Store G` at
;; block B, instruction index k, is observable exactly when some `@G` read runs
;; after it on some execution path, i.e. when either
;;   (i)  B reads `@G` at an index > k, or
;;   (ii) some block reachable from B's SUCCESSORS reads `@G`.
;; Everything else about G is unobservable: the cell's post-store value never
;; reaches a read in this activation, and the entry load still returns what a
;; per-use load would have returned, exactly as the pass header argues.
;;
;; (i) is decided by one backward walk per store-bearing block, accumulating the
;; globals read at strictly greater indices; the store's OWN value operand is
;; added only after the check, because it reads the pre-store value.
;; (ii) is decided by a successor walk with a visited set. The successor CSR
;; that `opt-cfg-index-build` fills already carries fallthrough edges
;; (`opt-cfg-block-successors-with-next`), and a block inside a cycle reaches
;; ITSELF, so a read placed lexically BEFORE the store still disqualifies G --
;; which is right, because the next iteration's read observes the store.
;;
;; Whenever the answer cannot be trusted -- duplicate block labels or an
;; unresolved successor target (both optimizer-verifier errors), or a walk that
;; exceeds its step budget -- every store in scope is reported observable, which
;; is precisely the whole-function rule this refinement replaces. The common
;; shape needs no CFG index at all: when every store-bearing block ends in
;; `Return` it has no successors, so (ii) is vacuous and only the backward walk
;; runs. That is the `gvn-facts-reset` shape -- a `set!` group in the returning
;; loop-exit block, after the loop whose bound reads the same cell.
(defstruct OptGlobalCellStoreScan
  (seen OptGlobalCellScan)
  (out opt_i64_i64_map.Map))

(defstruct OptGlobalCellStorePass
  (out opt_i64_i64_map.Map)
  (needs-reach bool))

;; Successor-walk step budget: blocks popped, summed over every store-bearing
;; block in the function. Exhausting it falls back to the whole-function rule
;; for the block being walked, so the cap trades sites for bounded compile time.
(define (opt-global-cell-reach-step-cap) : i64
  4096)

(define (opt-global-cell-block-return-terminated?
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (= count 0)
      false
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Return _) true]
        [_ false]))))

(define (opt-global-cell-block-has-store?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Store _ _ _) true]
      [_ (opt-global-cell-block-has-store? instrs (+ index 1) count)])))

;; Insert every `Store` target in [index, count) whose symbol id `filter`
;; contains, or every target at all when `all?` (the untrusted-CFG fallback).
(define (opt-global-cell-mark-stores-in
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [filter : opt_i64_i64_map.Map]
  [all? : bool]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index count)
    out
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Store name _ _)
        (let
          [id : i64 (ir.compiler-ir-symbol-id name)]
          [next : opt_i64_i64_map.Map out]
          (begin
            (if (or all? (opt_i64_i64_map.contains? (& filter) id))
              (opt_i64_i64_map.insert-ref! (&mut next) id 1)
              unit)
            (opt-global-cell-mark-stores-in
              instrs
              (+ index 1)
              count
              filter
              all?
              next)))]
      [_
        (opt-global-cell-mark-stores-in
          instrs
          (+ index 1)
          count
          filter
          all?
          out)])))

;; Backward walk of one block. `seen` accumulates the globals read at indices
;; strictly greater than the current one, so testing it at a `Store G` answers
;; clause (i) exactly.
(define (opt-global-cell-store-scan-back
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : OptGlobalCellStoreScan (:consume)]) : OptGlobalCellStoreScan
  (if (< index 0)
    acc
    (match acc
      [(OptGlobalCellStoreScan seen out)
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs index)]
          [next-out : opt_i64_i64_map.Map out]
          (begin
            (match instr
              [(ir.CompilerIrInstr.Store name _ _)
                (if (opt_i64_i64_map.contains?
                  (& seen.refs)
                  (ir.compiler-ir-symbol-id name))
                  (opt_i64_i64_map.insert-ref!
                    (&mut next-out)
                    (ir.compiler-ir-symbol-id name)
                    1)
                  unit)]
              [_ unit])
            (opt-global-cell-store-scan-back
              instrs
              (- index 1)
              (OptGlobalCellStoreScan
                (opt-global-cell-scan-instr seen false instr)
                next-out))))])))

(define (opt-global-cell-refs-add
  [refs : OptI64List]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match refs
    [(OptI64List.Nil) out]
    [(OptI64List.Cons name rest)
      (let
        [next : opt_i64_i64_map.Map out]
        (begin
          (opt_i64_i64_map.insert-ref! (&mut next) name 1)
          (opt-global-cell-refs-add (__tl-box-place rest) next)))]))

(define (opt-global-cell-scan-block-by-id [index : OptCfgIndex] [id : i64]) : OptGlobalCellScan
  (match (opt-cfg-index-block index id)
    [(OptMaybeBlock.No) (opt-global-cell-scan-new)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-global-cell-scan-seq-from
            (opt-global-cell-scan-new)
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            false)])]))

;; Push every not-yet-visited successor of `id`, marking at push time so each
;; block enters the stack at most once (stack capacity = block count).
(define (opt-global-cell-reach-push-succs!
  [index : OptCfgIndex]
  [visited : (__tl_dyn-array bool)]
  [stack : (__tl_dyn-array i64)]
  [sp-cell : (__tl_dyn-array i64)]
  [id : i64]) : unit
  (let
    [csr : OptCfgCsr index.succs]
    [edges : (__tl_dyn-array i64) csr.edges]
    [edge : i64 (array-ref csr.offsets id)]
    [end : i64 (array-ref csr.offsets (+ id 1))]
    (begin
      (while (< edge end)
        (begin
          (if (and
            (>= (array-ref edges edge) 0)
            (< (array-ref edges edge) (array-length visited))
            (not (array-ref visited (array-ref edges edge))))
            (begin
              (set! (array-ref visited (array-ref edges edge)) true)
              (set!
                (array-ref stack (array-ref sp-cell 0))
                (array-ref edges edge))
              (set! (array-ref sp-cell 0) (+ (array-ref sp-cell 0) 1)))
            unit)
          (set! edge (+ edge 1))))
      unit)))

;; `budget` slot 0 = remaining pops, slot 1 = truncated flag.
(define (opt-global-cell-reach-drain
  [index : OptCfgIndex]
  [visited : (__tl_dyn-array bool)]
  [stack : (__tl_dyn-array i64)]
  [sp-cell : (__tl_dyn-array i64)]
  [budget : (__tl_dyn-array i64)]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (<= (array-ref sp-cell 0) 0)
    out
    (if (<= (array-ref budget 0) 0)
      (begin
        (set! (array-ref budget 1) 1)
        out)
      (let
        [id : i64 (array-ref stack (- (array-ref sp-cell 0) 1))]
        (begin
          (set! (array-ref sp-cell 0) (- (array-ref sp-cell 0) 1))
          (set! (array-ref budget 0) (- (array-ref budget 0) 1))
          (opt-global-cell-reach-push-succs! index visited stack sp-cell id)
          (opt-global-cell-reach-drain
            index
            visited
            stack
            sp-cell
            budget
            (opt-global-cell-refs-add
              (__tl-project-field
                (opt-global-cell-scan-block-by-id index id)
                ref-list)
              out)))))))

(define (opt-global-cell-observable-stores-reach-block
  [index : OptCfgIndex]
  [visited : (__tl_dyn-array bool)]
  [stack : (__tl_dyn-array i64)]
  [sp-cell : (__tl_dyn-array i64)]
  [budget : (__tl_dyn-array i64)]
  [id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (begin
    (opt-cfg-fill-bool! visited (array-length visited) false)
    (set! (array-ref sp-cell 0) 0)
    (set! (array-ref budget 1) 0)
    (opt-global-cell-reach-push-succs! index visited stack sp-cell id)
    (let
      [reach : opt_i64_i64_map.Map
        (opt-global-cell-reach-drain
          index
          visited
          stack
          sp-cell
          budget
          (opt_i64_i64_map.with-capacity 8))]
      (opt-global-cell-mark-stores-in
        instrs
        0
        (ir.compiler-ir-instr-seq-count instrs)
        reach
        (= (array-ref budget 1) 1)
        out))))

(define (opt-global-cell-observable-stores-reach
  [index : OptCfgIndex]
  [visited : (__tl_dyn-array bool)]
  [stack : (__tl_dyn-array i64)]
  [sp-cell : (__tl_dyn-array i64)]
  [budget : (__tl_dyn-array i64)]
  [id : i64]
  [count : i64]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= id count)
    out
    (match (opt-cfg-index-block index id)
      [(OptMaybeBlock.No)
        (opt-global-cell-observable-stores-reach
          index
          visited
          stack
          sp-cell
          budget
          (+ id 1)
          count
          out)]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-global-cell-observable-stores-reach
              index
              visited
              stack
              sp-cell
              budget
              (+ id 1)
              count
              (if (and
                (opt-global-cell-block-has-store?
                  instrs
                  0
                  (ir.compiler-ir-instr-seq-count instrs))
                (not (opt-global-cell-block-return-terminated? instrs)))
                (opt-global-cell-observable-stores-reach-block
                  index
                  visited
                  stack
                  sp-cell
                  budget
                  id
                  instrs
                  out)
                out))])])))

;; Clause (i) for every block, plus "does any store-bearing block have
;; successors at all" so the CFG index is built only when clause (ii) can fire.
(define (opt-global-cell-observable-stores-local-block
  [instrs : ir.CompilerIrInstrSeq]
  [acc : OptGlobalCellStorePass (:consume)]) : OptGlobalCellStorePass
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (not (opt-global-cell-block-has-store? instrs 0 count))
      acc
      (match acc
        [(OptGlobalCellStorePass out needs-reach)
          (OptGlobalCellStorePass
            (__tl-project-field
              (opt-global-cell-store-scan-back
                instrs
                (- count 1)
                (OptGlobalCellStoreScan (opt-global-cell-scan-new) out))
              out)
            (or
              needs-reach
              (not (opt-global-cell-block-return-terminated? instrs))))]))))

(define (opt-global-cell-observable-stores-local-seq
  [seq : ir.CompilerIrBlockSeq]
  [index : i64]
  [count : i64]
  [acc : OptGlobalCellStorePass (:consume)]) : OptGlobalCellStorePass
  (if (>= index count)
    acc
    (match (ir.compiler-ir-block-seq-ref seq index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (opt-global-cell-observable-stores-local-seq
          seq
          (+ index 1)
          count
          (opt-global-cell-observable-stores-local-block instrs acc))])))

(define (opt-global-cell-observable-stores-local
  [blocks : ir.CompilerIrBlockList]
  [acc : OptGlobalCellStorePass (:consume)]) : OptGlobalCellStorePass
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-global-cell-observable-stores-local
            (__tl-box-place rest)
            (opt-global-cell-observable-stores-local-block instrs acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-cell-observable-stores-local-seq
        seq
        0
        (ir.compiler-ir-block-seq-count seq)
        acc)]))

(define (opt-global-cell-all-stores-seq
  [seq : ir.CompilerIrBlockSeq]
  [index : i64]
  [count : i64]
  [filter : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index count)
    out
    (match (ir.compiler-ir-block-seq-ref seq index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (opt-global-cell-all-stores-seq
          seq
          (+ index 1)
          count
          filter
          (opt-global-cell-mark-stores-in
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            filter
            true
            out))])))

(define (opt-global-cell-all-stores
  [blocks : ir.CompilerIrBlockList]
  [filter : opt_i64_i64_map.Map]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) out]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-global-cell-all-stores
            (__tl-box-place rest)
            filter
            (opt-global-cell-mark-stores-in
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs)
              filter
              true
              out))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-cell-all-stores-seq
        seq
        0
        (ir.compiler-ir-block-seq-count seq)
        filter
        out)]))

(define (opt-global-cell-observable-stores-indexed
  [blocks : ir.CompilerIrBlockList]
  [out : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    [count : i64 (opt-cfg-index-block-count index)]
    [budget : (__tl_dyn-array i64) (array.make-array i64 2)]
    (begin
      (set! (array-ref budget 0) (opt-global-cell-reach-step-cap))
      (set! (array-ref budget 1) 0)
      (if (or
        (<= count 0)
        (not (opt-cfg-index-labels-unique? index))
        (not index.targets-known))
        (opt-global-cell-all-stores
          blocks
          (opt_i64_i64_map.with-capacity 1)
          out)
        (opt-global-cell-observable-stores-reach
          index
          (array.make-array bool count)
          (array.make-array i64 count)
          (array.make-array i64 1)
          budget
          0
          count
          out)))))

(define (opt-global-cell-observable-stores [blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match (opt-global-cell-observable-stores-local
    blocks
    (OptGlobalCellStorePass (opt_i64_i64_map.with-capacity 8) false))
    [(OptGlobalCellStorePass out needs-reach)
      (if needs-reach
        (opt-global-cell-observable-stores-indexed blocks out)
        out)]))

;; Hoist plan for one function: candidate global symbol id -> fresh SSA var.
;; A referenced global is a candidate unless this function has a store of it
;; that a later read can observe (a), the program takes its address (b), or its
;; cell is not a single word.
(defstruct OptGlobalCellPlan
  (map opt_i64_i64_map.Map)
  (count i64))

(define (opt-global-cell-plan-build
  [cell : OptGlobalCellSummary]
  [stores : opt_i64_i64_map.Map]
  [refs : OptI64List]
  [frame-cell : (__tl_dyn-array i64)]
  [plan : opt_i64_i64_map.Map (:consume)]
  [count : i64]) : OptGlobalCellPlan
  (match refs
    [(OptI64List.Nil) (OptGlobalCellPlan plan count)]
    [(OptI64List.Cons name rest)
      (if (or
        (opt_i64_i64_map.contains? (& stores) name)
        (opt_i64_i64_map.contains? (& cell.addr-taken) name))
        (opt-global-cell-plan-build
          cell
          stores
          (__tl-box-place rest)
          frame-cell
          plan
          count)
        (match (opt-global-cell-type-lookup cell name)
          [(OptMaybeAstType.No)
            (opt-global-cell-plan-build
              cell
              stores
              (__tl-box-place rest)
              frame-cell
              plan
              count)]
          [(OptMaybeAstType.Some ty)
            (if (opt-global-cell-word-type? ty)
              (let
                [fresh : i64 (array-ref frame-cell 0)]
                [next : opt_i64_i64_map.Map plan]
                (begin
                  (set! (array-ref frame-cell 0) (+ fresh 1))
                  (opt_i64_i64_map.insert-ref! (&mut next) name fresh)
                  (opt-global-cell-plan-build
                    cell
                    stores
                    (__tl-box-place rest)
                    frame-cell
                    next
                    (+ count 1))))
              (opt-global-cell-plan-build
                cell
                stores
                (__tl-box-place rest)
                frame-cell
                plan
                count))]))]))

;; Emit the entry-block cell loads in the same ref-list order the plan
;; allocated their fresh vars.
(define (opt-global-cell-hoists-fill!
  [plan : opt_i64_i64_map.Map]
  [cell : OptGlobalCellSummary]
  [refs : OptI64List]
  [hoists : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]) : i64
  (match refs
    [(OptI64List.Nil) index]
    [(OptI64List.Cons name rest)
      (match (opt_i64_i64_map.get (& plan) name)
        [(opt_i64_i64_map.LookupMissing)
          (opt-global-cell-hoists-fill!
            plan
            cell
            (__tl-box-place rest)
            hoists
            index)]
        [(opt_i64_i64_map.LookupFound fresh)
          (match (opt-global-cell-type-lookup cell name)
            [(OptMaybeAstType.No)
              (opt-global-cell-hoists-fill!
                plan
                cell
                (__tl-box-place rest)
                hoists
                index)]
            [(OptMaybeAstType.Some ty)
              (begin
                (set!
                  (array-ref hoists index)
                  (ir.CompilerIrInstr.Mov
                    fresh
                    (ir.CompilerIrValue.Global name)
                    ty))
                (opt-global-cell-hoists-fill!
                  plan
                  cell
                  (__tl-box-place rest)
                  hoists
                  (+ index 1)))])])]))

(define (opt-global-cell-subst-value
  [plan : opt_i64_i64_map.Map]
  [v : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match v
    [(ir.CompilerIrValue.Global name)
      (match (opt_i64_i64_map.get (& plan) (ir.compiler-ir-symbol-id name))
        [(opt_i64_i64_map.LookupFound fresh) (ir.CompilerIrValue.Var fresh)]
        [(opt_i64_i64_map.LookupMissing) v])]
    [_ v]))

(define (opt-global-cell-subst-args
  [plan : opt_i64_i64_map.Map]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) args]
    [(ir.CompilerIrCallArgs.One value)
      (ir.CompilerIrCallArgs.One (opt-global-cell-subst-value plan value))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (opt-global-cell-subst-value plan a)
        (opt-global-cell-subst-value plan b))]
    [(ir.CompilerIrCallArgs.Array values)
      (let
        [count : i64 (array-length values)]
        [slots : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (set!
                (array-ref slots index)
                (opt-global-cell-subst-value plan (array-ref values index)))
              (set! index (+ index 1))))
          (ir.CompilerIrCallArgs.Array slots)))]))

(define (opt-global-cell-subst-spmd-args
  [plan : opt_i64_i64_map.Map]
  [args : ir.CompilerIrSpmdCallArgList]) : ir.CompilerIrSpmdCallArgList
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) args]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg vclass value ty)
          (ir.ir-spmd-call-arg-cons
            (ir.CompilerIrSpmdCallArg.Arg
              vclass
              (opt-global-cell-subst-value plan value)
              ty)
            (opt-global-cell-subst-spmd-args plan (__tl-box-place rest)))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
          (array.make-array ir.CompilerIrSpmdCallArg count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (match (array-ref seq.slots index)
                [(ir.CompilerIrSpmdCallArg.Arg vclass value ty)
                  (set!
                    (array-ref slots index)
                    (ir.CompilerIrSpmdCallArg.Arg
                      vclass
                      (opt-global-cell-subst-value plan value)
                      ty))])
              (set! index (+ index 1))))
          (ir.CompilerIrSpmdCallArgList.Array
            (ir.CompilerIrSpmdCallArgSeq slots count))))]))

(define (opt-global-cell-subst-maybe
  [plan : opt_i64_i64_map.Map]
  [maybe : ir.CompilerIrMaybeValue]) : ir.CompilerIrMaybeValue
  (match maybe
    [(ir.CompilerIrMaybeValue.No) maybe]
    [(ir.CompilerIrMaybeValue.Some value)
      (ir.CompilerIrMaybeValue.Some (opt-global-cell-subst-value plan value))]))

(define (opt-global-cell-subst-phi
  [plan : opt_i64_i64_map.Map]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-global-cell-subst-phi
        plan
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-global-cell-subst-value plan value)
        label
        (opt-global-cell-subst-phi plan (__tl-box-place rest)))]))

;; Rewrite planned global-ref operands to their entry-loaded SSA vars. Covers
;; every operand position (arm-for-arm, no wildcard) even though a missed ref
;; would only lose the optimization, never soundness: any `@G` left behind
;; still loads the same cell value under (a)+(b)+(c). Entry-block Mov sources
;; are exempt (see the pass header).
(define (opt-global-cell-rewrite-instr
  [plan : opt_i64_i64_map.Map]
  [entry? : bool]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (if entry?
        instr
        (ir.CompilerIrInstr.Mov dst (opt-global-cell-subst-value plan src) ty))]
    [(ir.CompilerIrInstr.Alloc _ _) instr]
    [(ir.CompilerIrInstr.AddrOf _ _) instr]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        dst
        (opt-global-cell-subst-value plan base)
        (opt-global-cell-subst-value plan offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load dst (opt-global-cell-subst-value plan src) ty)]
    [(ir.CompilerIrInstr.StorePtr dst src ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-global-cell-subst-value plan dst)
        (opt-global-cell-subst-value plan src)
        ty)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (ir.CompilerIrInstr.CopyBytes
        (opt-global-cell-subst-value plan dst)
        (opt-global-cell-subst-value plan src)
        size)]
    [(ir.CompilerIrInstr.BoundsCheck idx length msg)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-global-cell-subst-value plan idx)
        (opt-global-cell-subst-value plan length)
        msg)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        dst
        (opt-global-cell-subst-value plan src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        dst
        (opt-global-cell-subst-value plan src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        dst
        op
        (opt-global-cell-subst-value plan lhs)
        (opt-global-cell-subst-value plan rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp dst op (opt-global-cell-subst-value plan src) ty)]
    [(ir.CompilerIrInstr.LaneId _ _ _) instr]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat
        dst
        (opt-global-cell-subst-value plan value)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-vector-bin-op
          payload.dst
          payload.op
          (opt-global-cell-subst-value plan payload.lhs)
          (opt-global-cell-subst-value plan payload.rhs)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-vector-prefix
          payload.dst
          payload.op
          (opt-global-cell-subst-value plan payload.src)
          (opt-global-cell-subst-value plan payload.carry)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (ir.CompilerIrInstr.VectorReduce
        dst
        op
        (opt-global-cell-subst-value plan src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-vector-compare
          payload.dst
          payload.op
          (opt-global-cell-subst-value plan payload.lhs)
          (opt-global-cell-subst-value plan payload.rhs)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-global-cell-subst-value plan lhs)
        (opt-global-cell-subst-value plan rhs)
        lanes)]
    [(ir.CompilerIrInstr.MaskNot dst src lanes)
      (ir.CompilerIrInstr.MaskNot
        dst
        (opt-global-cell-subst-value plan src)
        lanes)]
    [(ir.CompilerIrInstr.MaskReduce dst op src lanes)
      (ir.CompilerIrInstr.MaskReduce
        dst
        op
        (opt-global-cell-subst-value plan src)
        lanes)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-select
          payload.dst
          (opt-global-cell-subst-value plan payload.mask)
          (opt-global-cell-subst-value plan payload.on-true)
          (opt-global-cell-subst-value plan payload.on-false)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.VectorLoad dst base idx lanes ty)
      (ir.CompilerIrInstr.VectorLoad
        dst
        (opt-global-cell-subst-value plan base)
        (opt-global-cell-subst-value plan idx)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-vector-store
          (opt-global-cell-subst-value plan payload.base)
          (opt-global-cell-subst-value plan payload.index)
          (opt-global-cell-subst-value plan payload.value)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-predicated-store
          (opt-global-cell-subst-value plan payload.base)
          (opt-global-cell-subst-value plan payload.index)
          (opt-global-cell-subst-value plan payload.value)
          (opt-global-cell-subst-value plan payload.mask)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-predicated-load
          payload.dst
          (opt-global-cell-subst-value plan payload.base)
          (opt-global-cell-subst-value plan payload.index)
          (opt-global-cell-subst-value plan payload.mask)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-gather-load
          payload.dst
          (opt-global-cell-subst-value plan payload.base)
          (opt-global-cell-subst-value plan payload.index-base)
          (opt-global-cell-subst-value plan payload.index)
          payload.lane-offset
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-vector-shuffle
          payload.dst
          (opt-global-cell-subst-value plan payload.source)
          (opt-global-cell-subst-value plan payload.selector-low)
          (opt-global-cell-subst-maybe plan payload.selector-high)
          (opt-global-cell-subst-value plan payload.active-lanes)
          payload.lanes
          payload.ty))]
    [(ir.CompilerIrInstr.TailMask dst idx length lanes)
      (ir.CompilerIrInstr.TailMask
        dst
        (opt-global-cell-subst-value plan idx)
        (opt-global-cell-subst-value plan length)
        lanes)]
    [(ir.CompilerIrInstr.EntryArgc _) instr]
    [(ir.CompilerIrInstr.EntryArgv _) instr]
    [(ir.CompilerIrInstr.EntryEnvp _) instr]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (ir.CompilerIrInstr.CpuId
        dst
        (opt-global-cell-subst-value plan leaf)
        (opt-global-cell-subst-value plan subleaf)
        reg-index)]
    [(ir.CompilerIrInstr.Xgetbv dst idx)
      (ir.CompilerIrInstr.Xgetbv dst (opt-global-cell-subst-value plan idx))]
    [(ir.CompilerIrInstr.Syscall dst args)
      (ir.CompilerIrInstr.Syscall dst (opt-global-cell-subst-args plan args))]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (ir.CompilerIrInstr.Call
        dst
        name
        (opt-global-cell-subst-args plan args)
        ty)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-call-cabi-store-result
          (opt-global-cell-subst-value plan payload.base)
          payload.name
          (opt-global-cell-subst-args plan payload.args)
          payload.slots))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-spmd-call
          payload.callee
          payload.backend
          payload.lanes
          (opt-global-cell-subst-value plan payload.active-mask)
          (opt-global-cell-subst-spmd-args plan payload.args)
          payload.result))]
    [(ir.CompilerIrInstr.CallIndirect dst func args ty)
      (ir.CompilerIrInstr.CallIndirect
        dst
        (opt-global-cell-subst-value plan func)
        (opt-global-cell-subst-args plan args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst func args ty)
      (ir.CompilerIrInstr.CallIndirectC
        dst
        (opt-global-cell-subst-value plan func)
        (opt-global-cell-subst-args plan args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [payload (__tl-box-place payload-box)]
        (ir.ir-instr-call-indirect-cabi-store-result
          (opt-global-cell-subst-value plan payload.base)
          (opt-global-cell-subst-value plan payload.callee)
          (opt-global-cell-subst-args plan payload.args)
          payload.slots))]
    [(ir.CompilerIrInstr.TailCall name args ty)
      (ir.CompilerIrInstr.TailCall
        name
        (opt-global-cell-subst-args plan args)
        ty)]
    [(ir.CompilerIrInstr.Store name value ty)
      (ir.CompilerIrInstr.Store
        name
        (opt-global-cell-subst-value plan value)
        ty)]
    [(ir.CompilerIrInstr.Jump _) instr]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (ir.CompilerIrInstr.Branch
        (opt-global-cell-subst-value plan cond)
        true-label
        false-label)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (ir.CompilerIrInstr.TotalEnumBranch
        (opt-global-cell-subst-value plan cond)
        true-label
        false-label)]
    [(ir.CompilerIrInstr.Return maybe)
      (ir.CompilerIrInstr.Return (opt-global-cell-subst-maybe plan maybe))]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi dst (opt-global-cell-subst-phi plan inputs) ty)]
    [(ir.CompilerIrInstr.Pack _ _ _) instr]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (ir.CompilerIrInstr.Word
        dst
        (opt-global-cell-subst-value plan src)
        index
        ty)]
    [(ir.CompilerIrInstr.TailCallIndirect func args ty)
      (ir.CompilerIrInstr.TailCallIndirect
        (opt-global-cell-subst-value plan func)
        (opt-global-cell-subst-args plan args)
        ty)]
    [(ir.CompilerIrInstr.Switch idx default-label cases trap-label)
      (ir.CompilerIrInstr.Switch
        (opt-global-cell-subst-value plan idx)
        default-label
        cases
        trap-label)]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        idx
        default-label
        cases
        trap-label
        final-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (opt-global-cell-subst-value plan idx)
        default-label
        cases
        trap-label
        final-label)]))

(define (opt-global-cell-rewrite-seq
  [plan : opt_i64_i64_map.Map]
  [entry? : bool]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-global-cell-rewrite-instr
              plan
              entry?
              (ir.compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-global-cell-rewrite-block
  [plan : opt_i64_i64_map.Map]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (opt-global-cell-rewrite-seq plan false instrs))]))

;; The entry block gets the cell loads prepended after its own rewrite (its
;; Mov sources stay exempt), so every fresh var dominates all rewritten uses.
(define (opt-global-cell-entry-block
  [plan : opt_i64_i64_map.Map]
  [hoists : (__tl_dyn-array ir.CompilerIrInstr)]
  [hoist-count : i64]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [total : i64 (+ hoist-count count)]
        [slots : (__tl_dyn-array ir.CompilerIrInstr)
          (array.make-array ir.CompilerIrInstr total)]
        [index : i64 0]
        (begin
          (while (< index hoist-count)
            (begin
              (set! (array-ref slots index) (array-ref hoists index))
              (set! index (+ index 1))))
          (set! index 0)
          (while (< index count)
            (begin
              (set!
                (array-ref slots (+ hoist-count index))
                (opt-global-cell-rewrite-instr
                  plan
                  true
                  (ir.compiler-ir-instr-seq-ref instrs index)))
              (set! index (+ index 1))))
          (ir.CompilerIrBlock.Block label (ir.CompilerIrInstrSeq slots total))))]))

(define (opt-global-cell-rewrite-blocks
  [plan : opt_i64_i64_map.Map]
  [hoists : (__tl_dyn-array ir.CompilerIrInstr)]
  [hoist-count : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-global-cell-entry-block plan hoists hoist-count block)
        (opt-global-cell-rewrite-nonentry-blocks plan (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-cell-rewrite-blocks
        plan
        hoists
        hoist-count
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-global-cell-rewrite-nonentry-blocks
  [plan : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-global-cell-rewrite-block plan block)
        (opt-global-cell-rewrite-nonentry-blocks plan (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-cell-rewrite-nonentry-blocks
        plan
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Load each hoistable global's cell once at entry and rewrite its uses. The
;; pass is a no-op (returning the function by reference) when the program has
;; no word-cell candidates, when a call-family instruction remains (c), when
;; no global is referenced, or when every referenced global is excluded by
;; (a)/(b)/cell-width.
(define (opt-global-cell-function
  [summaries : OptLoopBceSummaries]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [cell : OptGlobalCellSummary summaries.global-cell]
        (if (= cell.word-cell 0)
          func
          (let
            [scan : OptGlobalCellScan
              (opt-global-cell-scan-blocks
                (opt-global-cell-scan-new)
                blocks
                true)]
            (cond
              [scan.calls func]
              [(match scan.ref-list
                  [(OptI64List.Nil) true]
                  [(OptI64List.Cons _ _) false])
                func]
              [else
                (let
                  [frame-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
                  [_seed : unit (set! (array-ref frame-cell 0) frame)]
                  [planned : OptGlobalCellPlan
                    (opt-global-cell-plan-build
                      cell
                      (opt-global-cell-observable-stores blocks)
                      scan.ref-list
                      frame-cell
                      (opt_i64_i64_map.with-capacity 8)
                      0)]
                  (if (= planned.count 0)
                    func
                    (let
                      [hoists : (__tl_dyn-array ir.CompilerIrInstr)
                        (array.make-array ir.CompilerIrInstr planned.count)]
                      [_filled : i64
                        (opt-global-cell-hoists-fill!
                          planned.map
                          cell
                          scan.ref-list
                          hoists
                          0)]
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        (array-ref frame-cell 0)
                        (opt-global-cell-rewrite-blocks
                          planned.map
                          hoists
                          planned.count
                          blocks)))))]))))]))

(define (optimize-program [program : ir.CompilerIrProgram]) : ir.CompilerIrProgram
  (optimize-program-with-level program (compiler-optimize-default-level)))

(define (optimize-program-with-reader-context-and-level-and-profile-state
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [program : ir.CompilerIrProgram]
  [level : i64]
  [profile-state : profile_state.CompilerProfileState]) : ir.CompilerIrProgram
  (match program
    [(ir.CompilerIrProgram.Program globals functions externs)
      (if (= level 0)
        program
        ;; Levels 1 (cheap) and 2 (quality) both prune unreachable functions;
        ;; opt-inline-program-functions runs the full inliner at level 2 and
        ;; the call-free tiny-leaf pass at level 1.
        ;;
        ;; This spans-free entry keeps the inline stage in the enclosing arena.
        ;; The dedicated inline arena lives on the spans variant below, which is
        ;; the one the driver compiles through; adding it here would buy nothing
        ;; (no caller of this entry compiles a whole program) and would need the
        ;; same escape argument re-made for a second control flow.
        (begin
          (cfg compile-profile (compiler-opt-profile-start profile-state))
          (opt-inline-checked-set-active! true)
          (let
            [reachable-functions : ir.CompilerIrFunctionList
              (opt-inline-program-functions type-segment-bases functions level)]
            (begin
              (cfg
                compile-profile
                (compiler-opt-profile-finish profile-state "pre_prune"))
              (cfg compile-profile (compiler-opt-profile-start profile-state))
              (let
                [pruned : OptPrunedProgram
                  (opt-prune-unreachable-program
                    globals
                    reachable-functions
                    externs)]
                [pruned-globals : ir.CompilerIrGlobalList
                  (opt-pruned-program-globals pruned)]
                [pruned-functions : ir.CompilerIrFunctionList
                  (opt-pruned-program-functions pruned)]
                [summaries : OptLoopBceSummaries
                  (opt-loop-bce-summaries-set-profile-state
                    (opt-build-program-summaries
                      type-segment-bases
                      pruned-globals
                      pruned-functions
                      level)
                    profile-state)]
                [_load-cse-profile-reset : unit
                  (cfg
                    compile-profile
                    (compiler-opt-load-cse-profile-reset profile-state)
                    unit)]
                [optimized-functions : ir.CompilerIrFunctionList
                  (optimize-function-list-with-level-and-summaries
                    pools
                    type-segment-bases
                    pruned-functions
                    level
                    summaries)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-opt-profile-finish profile-state "functions"))
                  (cfg
                    compile-profile-summary
                    (compiler-opt-profile-summary-emit summaries.profile-state))
                  (cfg
                    compile-profile
                    (compiler-opt-load-cse-profile-emit profile-state))
                  (cfg
                    compile-profile
                    (compiler-opt-profile-start profile-state))
                  (let
                    [final-pruned
                      : OptPrunedProgram
                      ;; Keep scanning the original global initializers so a
                      ;; function referenced only from one still follows the
                      ;; existing reachability rule even if that global is
                      ;; later filtered from the emitted program.
                      (opt-prune-unreachable-program
                        globals
                        optimized-functions
                        externs)]
                    [final-globals : ir.CompilerIrGlobalList
                      (opt-pruned-program-globals final-pruned)]
                    [final-functions : ir.CompilerIrFunctionList
                      (opt-pruned-program-functions final-pruned)]
                    [late-functions : ir.CompilerIrFunctionList
                      (opt-late-function-list-with-level
                        pools
                        type-segment-bases
                        final-functions
                        level)]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-opt-profile-finish profile-state "post_prune"))
                      (ir.CompilerIrProgram.Program
                        final-globals
                        (ir.compiler-ir-function-list-compact late-functions)
                        externs)))))))))]))

(define (optimize-program-with-reader-context-and-level
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [program : ir.CompilerIrProgram]
  [level : i64]) : ir.CompilerIrProgram
  (optimize-program-with-reader-context-and-level-and-profile-state
    pools
    type-segment-bases
    program
    level
    (profile_state.compiler-profile-state-new)))

(define (optimize-program-with-level
  [program : ir.CompilerIrProgram]
  [level : i64]) : ir.CompilerIrProgram
  (let
    [pools : ast.AstNodePoolContext (ast.ast-node-pool-reader-context-current)]
    (optimize-program-with-reader-context-and-level
      pools
      (ast.ast-node-pool-context-type-segment-bases pools)
      program
      level)))

(define (opt-remap-spans-prepend-entry
  [spans : ir.CompilerSourceSpans]
  [key : ir.CompilerSourceSpansInstrKey]
  [path-id : i64]
  [span : ast.AstSourceSpan]) : ir.CompilerSourceSpans
  (ir.compiler-source-spans-insert-instr-entry-located spans key path-id span))

;; Span keys are typed (function id, var/name id) pairs, so building one is a
;; couple of integer moves and probing an entry is two integer compares; only
;; instructions whose kind can carry a span build a key at all. The key arms
;; mirror the kinds the replaced per-instruction prepend matcher accepted:
;; indirect-call destinations were looked up and then dropped by its
;; fall-through, so skipping their lookups cannot change the produced spans.
;; The entry-list probe stays the linear first-match scan: entries are
;; bounded by the 2049 fast-path cutoff.
(defenum OptRemapSpanKey
  (NoKey)
  (SomeKey ir.CompilerSourceSpansInstrKey))

(define (opt-runtime-abort-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ op _ _ _)
      (match op
        [(ir.CompilerIrBinOp.Div) true]
        [(ir.CompilerIrBinOp.Mod) true]
        [(ir.CompilerIrBinOp.Shl _) true]
        [(ir.CompilerIrBinOp.Shr _) true]
        [_ false])]
    [(ir.CompilerIrInstr.Call _ name _ _)
      (let
        [text : String (ir.compiler-ir-symbol-text name)]
        (or
          (string.eq text "stdlib/io.tl::stdlib.io/panic")
          (string.eq text "stdlib\\io.tl::stdlib.io/panic")))]
    [_ false]))

(define (opt-remap-spans-instr-key
  [function : i64]
  [instr : ir.CompilerIrInstr]) : OptRemapSpanKey
  (if (or (ir.compiler-debug-info-enabled?) (opt-runtime-abort-instr? instr))
    (match instr
      [(ir.CompilerIrInstr.Mov dst _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Alloc dst _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.AddrOf dst _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Gep dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Load dst _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Cast dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Bitcast dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.BinOp dst _ _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.UnOp dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.LaneId dst _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Splat dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.VectorBinOp payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.VectorPrefix payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.VectorCompare payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.MaskNot dst _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Select payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.PredicatedLoad payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.GatherLoad payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.VectorShuffle payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (OptRemapSpanKey.SomeKey
            (ir.CompilerSourceSpansInstrKey.Value function dst)))]
      [(ir.CompilerIrInstr.TailMask dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.EntryArgc dst)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.EntryArgv dst)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.EntryEnvp dst)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.CpuId dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Xgetbv dst _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Syscall dst _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Call dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.BoundsCheck _ _ ok-label)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Bounds function ok-label))]
      [(ir.CompilerIrInstr.SpmdCall payload-box)
        (let
          [result (__tl-project-field (__tl-box-place payload-box) result)]
          (match result
            [(ir.CompilerIrSpmdCallResult.Unit) (OptRemapSpanKey.NoKey)]
            [(ir.CompilerIrSpmdCallResult.Value dst _ _)
              (OptRemapSpanKey.SomeKey
                (ir.CompilerSourceSpansInstrKey.Value function dst))]))]
      [(ir.CompilerIrInstr.Pack dst _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [(ir.CompilerIrInstr.Word dst _ _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      ;; Tail-indirect is control flow and does not define a destination value.
      [(ir.CompilerIrInstr.TailCallIndirect _ _ _) (OptRemapSpanKey.NoKey)]
      [(ir.CompilerIrInstr.Store name _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Store function name))]
      [(ir.CompilerIrInstr.Phi dst _ _)
        (OptRemapSpanKey.SomeKey
          (ir.CompilerSourceSpansInstrKey.Value function dst))]
      [_ (OptRemapSpanKey.NoKey)])
    (OptRemapSpanKey.NoKey)))

(define (opt-remap-spans-instr
  [instr-entries : ir.CompilerSourceSpansInstrEntryList]
  [out : ir.CompilerSourceSpans]
  [function : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerSourceSpans
  (match (opt-remap-spans-instr-key function instr)
    [(OptRemapSpanKey.NoKey) out]
    [(OptRemapSpanKey.SomeKey key)
      (match (ir.compiler-source-spans-instr-entry-list-lookup
        instr-entries
        key)
        [(ir.CompilerMaybeSourceLocation.Some
            (ir.CompilerSourceLocation path-id span))
          (opt-remap-spans-prepend-entry out key path-id span)]
        [(ir.CompilerMaybeSourceLocation.No) out]
        [_ out])]
    [_ out]))

(define (opt-remap-spans-instr-seq-from
  [instr-entries : ir.CompilerSourceSpansInstrEntryList]
  [out : ir.CompilerSourceSpans]
  [function : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : ir.CompilerSourceSpans
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    out
    (opt-remap-spans-instr-seq-from
      instr-entries
      (opt-remap-spans-instr
        instr-entries
        out
        function
        (ir.compiler-ir-instr-seq-ref instrs index))
      function
      instrs
      (+ index 1))))

(define (opt-remap-spans-instr-seq
  [instr-entries : ir.CompilerSourceSpansInstrEntryList]
  [out : ir.CompilerSourceSpans]
  [function : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerSourceSpans
  (opt-remap-spans-instr-seq-from instr-entries out function instrs 0))

(define (opt-remap-spans-blocks
  [instr-entries : ir.CompilerSourceSpansInstrEntryList]
  [out : ir.CompilerSourceSpans]
  [function : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerSourceSpans
  (match blocks
    [(ir.CompilerIrBlockList.Nil) out]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-remap-spans-blocks
            instr-entries
            (opt-remap-spans-instr-seq instr-entries out function instrs)
            function
            (__tl-box-place rest))])]
    ;; Read-only walk over the blocks (the spans accumulator is threaded
    ;; forward exactly as the cons walk threaded it) (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [acc : ir.CompilerSourceSpans out]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    acc
                    (opt-remap-spans-instr-seq
                      instr-entries
                      acc
                      function
                      instrs))])
              (set! i (+ i 1))))
          acc))]))

(define (opt-remap-spans-function
  [instr-entries : ir.CompilerSourceSpansInstrEntryList]
  [out : ir.CompilerSourceSpans]
  [func : ir.CompilerIrFunction]) : ir.CompilerSourceSpans
  (match func
    [(ir.CompilerIrFunction.Function name _ _ _ blocks)
      (opt-remap-spans-blocks instr-entries out name blocks)]))

(define (opt-remap-spans-functions
  [instr-entries : ir.CompilerSourceSpansInstrEntryList]
  [out : ir.CompilerSourceSpans]
  [funcs : ir.CompilerIrFunctionList]) : ir.CompilerSourceSpans
  (match funcs
    [(ir.CompilerIrFunctionList.Nil) out]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (opt-remap-spans-functions
        instr-entries
        (opt-remap-spans-function instr-entries out func)
        (__tl-box-place rest))]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-remap-spans-functions
        instr-entries
        out
        (ir.compiler-ir-function-seq-to-list seq))]))

(define (opt-remap-spans-fast-path? [source-spans : ir.CompilerSourceSpans]) : bool
  (and
    (not (ir.compiler-debug-info-enabled?))
    (ir.compiler-source-spans-instr-count-at-least? source-spans 2049)))

(define (opt-remap-spans-program
  [source-spans : ir.CompilerSourceSpans]
  [program : ir.CompilerIrProgram]) : ir.CompilerSourceSpans
  (if (opt-remap-spans-fast-path? source-spans)
    (ir.compiler-source-spans-clear-instrs source-spans)
    (match source-spans
      [(ir.CompilerSourceSpans.Spans _ instr-entries _)
        (match program
          [(ir.CompilerIrProgram.Program _ functions _)
            (opt-remap-spans-functions
              instr-entries
              (ir.compiler-source-spans-clear-instrs source-spans)
              functions)])])))

(define (optimize-program-with-spans-and-reader-context-and-level-and-profile-state
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [program : ir.CompilerIrProgram]
  [spans : ir.CompilerSourceSpans]
  [level : i64]
  [profile-state : profile_state.CompilerProfileState]) : CompilerOptimizedProgram
  (match program
    [(ir.CompilerIrProgram.Program globals functions externs)
      (if (= level 0)
        (CompilerOptimizedProgram.Program
          (compiler-opt-debug-finish-program program)
          (opt-remap-spans-program spans program))
        (begin
          (cfg compile-profile (compiler-opt-profile-start profile-state))
          ;; Everything the inline stage builds -- the devirtualized function
          ;; index, the call graph, the SCC and census tables, every rewritten
          ;; caller body, and every superseded spans array -- is dead once
          ;; `optimize-function-list-with-level-and-summaries` below has escaped
          ;; each optimized function into this arena. Running the stage in a
          ;; dedicated arena lets that whole generation be released there
          ;; instead of riding the compiler-entry arena through the backend.
          (let
            [enclosing : i64 (arena.tl_arena_current)]
            [inline-arena : i64 (arena.tl_arena_make)]
            [_enter-inline-arena : unit
              (unsafe
                (arena.tl_arena_set inline-arena))]
            [_arm-checked : unit (opt-inline-checked-set-active! true)]
            [inlined : OptInlineSpanProgram
              (opt-inline-program-functions-with-spans
                type-segment-bases
                functions
                level
                spans)]
            [_leave-inline-arena : unit
              (unsafe
                (arena.tl_arena_set enclosing))]
            ;; The inline stage rebinds its two module-level tables on the way
            ;; out, and it does so while its own arena is current. Rebind them
            ;; again here so neither global names storage inside the arena this
            ;; function is about to destroy.
            [_rebind-inline-globals : unit
              (begin
                (opt-inline-multiblock-ok-memo-reset!)
                (set!
                  (array-ref opt-inline-pred-renames 0)
                  (OptInlinePredRenameList.Nil)))]
            (match inlined
              [(OptInlineSpanProgram.Program
                  reachable-functions
                  inline-arena-spans)
                (begin
                  (cfg
                    compile-profile
                    (compiler-opt-profile-finish profile-state "pre_prune"))
                  (cfg
                    compile-profile
                    (compiler-opt-profile-start profile-state))
                  (let
                    ;; The one inline-stage result that must survive the arena:
                    ;; the spans table is consumed after the destroy, by
                    ;; `opt-remap-spans-program` at the tail of this function.
                    [inline-spans : ir.CompilerSourceSpans
                      (ir.compiler-source-spans-escape inline-arena-spans)]
                    [pruned : OptPrunedProgram
                      (opt-prune-unreachable-program
                        globals
                        reachable-functions
                        externs)]
                    [pruned-globals : ir.CompilerIrGlobalList
                      (opt-pruned-program-globals pruned)]
                    [pruned-functions : ir.CompilerIrFunctionList
                      (opt-pruned-program-functions pruned)]
                    ;; Copy the surviving functions out of the inline arena and
                    ;; release it before the loop; see `opt-optimizer-input-carrier`.
                    ;; `pruned-globals` names the driver's globals, which live in
                    ;; the lower-IR arena and are untouched by this release.
                    [carrier : i64 (opt-optimizer-input-carrier level)]
                    [optimizer-functions : ir.CompilerIrFunctionList
                      (opt-optimizer-input-carry pools carrier pruned-functions)]
                    [_release-inline-arena-early : unit
                      (if (= carrier 0)
                        unit
                        (opt-release-optimizer-input-arena
                          "optimize-inline"
                          inline-arena))]
                    [summaries : OptLoopBceSummaries
                      (opt-loop-bce-summaries-set-profile-state
                        (opt-build-program-summaries
                          type-segment-bases
                          pruned-globals
                          optimizer-functions
                          level)
                        profile-state)]
                    [_load-cse-profile-reset : unit
                      (cfg
                        compile-profile
                        (compiler-opt-load-cse-profile-reset profile-state)
                        unit)]
                    [optimized-functions : ir.CompilerIrFunctionList
                      (optimize-function-list-with-level-and-summaries
                        pools
                        type-segment-bases
                        optimizer-functions
                        level
                        summaries)]
                    ;; No live pointer into the optimizer-input arena remains
                    ;; here. Every function in `optimized-functions` was
                    ;; deep-cloned into the enclosing arena on its way out of the
                    ;; escaping optimizer -- level 2 through
                    ;; `compiler-ir-clone-function`, level 1 through the
                    ;; equivalent DCE block escape -- `inline-spans` was copied
                    ;; out above, and `globals`/`externs` are the driver's program
                    ;; shell, which the inline stage only reads. That leaves
                    ;; `reachable-functions`, `pruned`/`pruned-functions`,
                    ;; `optimizer-functions`, `summaries`, the function index and
                    ;; the census as the arena's only referents, and all of them
                    ;; are dead from here on: nothing below this binding reads
                    ;; them. `summaries` carries only i64/i64 maps and the
                    ;; profile-state struct, never a body pointer, so the
                    ;; compile-profile-summary emit below stays valid.
                    [_release-optimizer-input : unit
                      (if (= carrier 0)
                        (opt-release-optimizer-input-arena
                          "optimize-inline"
                          inline-arena)
                        (opt-release-optimizer-input-arena
                          "optimizer-input"
                          carrier))]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-opt-profile-finish profile-state "functions"))
                      (cfg
                        compile-profile-summary
                        (compiler-opt-profile-summary-emit
                          summaries.profile-state))
                      (cfg
                        compile-profile
                        (compiler-opt-load-cse-profile-emit profile-state))
                      (cfg
                        compile-profile
                        (compiler-opt-profile-start profile-state))
                      (let
                        [final-pruned
                          : OptPrunedProgram
                          ;; Keep scanning the original global initializers so a
                          ;; function referenced only from one still follows the
                          ;; existing reachability rule even if that global is
                          ;; later filtered from the emitted program.
                          (opt-prune-unreachable-program
                            globals
                            optimized-functions
                            externs)]
                        [final-globals : ir.CompilerIrGlobalList
                          (opt-pruned-program-globals final-pruned)]
                        [final-functions : ir.CompilerIrFunctionList
                          (opt-pruned-program-functions final-pruned)]
                        [late-functions : ir.CompilerIrFunctionList
                          (opt-late-function-list-with-level
                            pools
                            type-segment-bases
                            final-functions
                            level)]
                        [optimized : ir.CompilerIrProgram
                          (ir.CompilerIrProgram.Program
                            final-globals
                            (ir.compiler-ir-function-list-compact
                              late-functions)
                            externs)]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-opt-profile-finish
                              profile-state
                              "post_prune"))
                          (CompilerOptimizedProgram.Program
                            (compiler-opt-debug-finish-program optimized)
                            (opt-remap-spans-program inline-spans optimized)))))))]))))]))

(define (optimize-program-with-spans-and-reader-context-and-level
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [program : ir.CompilerIrProgram]
  [spans : ir.CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-reader-context-and-level-and-profile-state
    pools
    type-segment-bases
    program
    spans
    level
    (profile_state.compiler-profile-state-new)))

(define (optimize-program-with-spans-and-level
  [program : ir.CompilerIrProgram]
  [spans : ir.CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (let
    [pools : ast.AstNodePoolContext (ast.ast-node-pool-reader-context-current)]
    (optimize-program-with-spans-and-reader-context-and-level
      pools
      (ast.ast-node-pool-context-type-segment-bases pools)
      program
      spans
      level)))

(define (optimize-program-with-spans-and-pools-and-level
  [pools : ast.AstNodePoolContext]
  [program : ir.CompilerIrProgram]
  [spans : ir.CompilerSourceSpans]
  [level : i64]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-reader-context-and-level
    pools
    (ast.ast-node-pool-context-type-segment-bases pools)
    program
    spans
    level))

(define (optimize-program-with-spans-and-pools-and-level-and-profile-state
  [pools : ast.AstNodePoolContext]
  [program : ir.CompilerIrProgram]
  [spans : ir.CompilerSourceSpans]
  [level : i64]
  [profile-state : profile_state.CompilerProfileState]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-reader-context-and-level-and-profile-state
    pools
    (ast.ast-node-pool-context-type-segment-bases pools)
    program
    spans
    level
    profile-state))

(define (optimize-program-with-spans
  [program : ir.CompilerIrProgram]
  [spans : ir.CompilerSourceSpans]) : CompilerOptimizedProgram
  (optimize-program-with-spans-and-level
    program
    spans
    (compiler-optimize-default-level)))

(define (opt-function-blocks [func : ir.CompilerIrFunction]) : ir.CompilerIrBlockList
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks) blocks]))

(define (opt-function-frame [func : ir.CompilerIrFunction]) : i64
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ frame _) frame]))

;; --- noalias / alias fact model ---------------------------------------------
;;
;; Optimizer-internal alias facts for IR temporaries. This section models facts
;; and conservative invalidation, proves the conservatism with self-tests, and
;; feeds the local redundant-load CSE consumer.
;;
;; A fact binds an IR temporary (var id) to one of six deliberately
;; conservative kinds:
;;   - Unique epoch : a freshly allocated root no other tracked pointer aliases,
;;                    tagged with the allocation epoch (the load-GVN state's
;;                    allocation counter at the moment the allocation ran; the
;;                    scratch/report consumer has no counter and passes 0)
;;   - ExclusiveRef : a checked mutable-reference parameter root; no other
;;                    checked root in the function may alias it
;;   - SharedRef    : a checked immutable-reference parameter root; another
;;                    SharedRef root MAY designate the same storage
;;   - Derived base : a pointer derived from root/base var `base` by safe
;;                    pointer arithmetic (Gep); it aliases only that root's
;;                    allocation/reference storage
;;   - MayAlias     : unknown provenance; may alias anything tracked
;;   - Invalidated  : a previously known fact a memory effect explicitly cleared
;;
;; Invalidation keys off `compiler-ir-instr-effect`: pure instructions keep the
;; surrounding facts (and (re)bind only their destination), memory reads keep
;; facts (the loaded value itself is MayAlias), and any instruction that can
;; mutate or unknown-observe memory (stores, vector/predicated stores, direct
;; and indirect calls, tail calls) conservatively clears ALL facts rather than
;; assuming C-style noalias. Control-flow joins intersect the per-edge sets.
(defenum OptAliasKind
  (Unique i64)
  (ExclusiveRef)
  (SharedRef)
  (Derived i64)
  (MayAlias)
  (Invalidated))

;; Alias facts live in a mutable i64->i64 hashmap keyed by var id.
;; Kinds pack into the value: a Derived root is its non-negative root var id,
;; the kind-only variants take negative codes, and Unique(epoch) takes the
;; open-ended range at or below -6 (epoch >= 0). State is threaded linearly
;; through a block (helpers mutate and return the same table); control-flow
;; joins and clears build a fresh table, so retained per-block exit states
;; are never aliased by a successor's mutations.
(defenum OptAliasFacts
  (Facts opt_i64_i64_map.Map))

(define (opt-alias-empty) : OptAliasFacts
  (OptAliasFacts.Facts (opt_i64_i64_map.with-capacity 17)))

;; Unique(epoch) encodes as -(6 + epoch), so -1 is no longer produced by any
;; kind; a stale -1 (or the unused -5) decodes to the conservative Invalidated.
(define (opt-alias-kind-encode [kind : OptAliasKind]) : i64
  (match kind
    [(OptAliasKind.Unique epoch) (- 0 (+ 6 epoch))]
    [(OptAliasKind.ExclusiveRef) -2]
    [(OptAliasKind.SharedRef) -3]
    [(OptAliasKind.MayAlias) -4]
    [(OptAliasKind.Invalidated) -5]
    [(OptAliasKind.Derived root) root]))

(define (opt-alias-kind-decode [value : i64]) : OptAliasKind
  (cond
    [(>= value 0) (OptAliasKind.Derived value)]
    [(= value -2) (OptAliasKind.ExclusiveRef)]
    [(= value -3) (OptAliasKind.SharedRef)]
    [(= value -4) (OptAliasKind.MayAlias)]
    [(<= value -6) (OptAliasKind.Unique (- (- 0 value) 6))]
    [else (OptAliasKind.Invalidated)]))

(defenum OptMaybeAliasKind
  (No)
  (Some OptAliasKind))

(define (opt-alias-kind-eq [a : OptAliasKind] [b : OptAliasKind]) : bool
  (match a
    [(OptAliasKind.Unique ea)
      (match b
        [(OptAliasKind.Unique eb) (= ea eb)]
        [_ false])]
    [(OptAliasKind.ExclusiveRef)
      (match b
        [(OptAliasKind.ExclusiveRef) true]
        [_ false])]
    [(OptAliasKind.SharedRef)
      (match b
        [(OptAliasKind.SharedRef) true]
        [_ false])]
    [(OptAliasKind.Derived ba)
      (match b
        [(OptAliasKind.Derived bb) (= ba bb)]
        [_ false])]
    [(OptAliasKind.MayAlias)
      (match b
        [(OptAliasKind.MayAlias) true]
        [_ false])]
    [(OptAliasKind.Invalidated)
      (match b
        [(OptAliasKind.Invalidated) true]
        [_ false])]))

(define (opt-alias-lookup [facts : OptAliasFacts] [var : i64]) : OptMaybeAliasKind
  (match facts
    [(OptAliasFacts.Facts map)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound value)
          (OptMaybeAliasKind.Some (opt-alias-kind-decode value))]
        [(opt_i64_i64_map.LookupMissing) (OptMaybeAliasKind.No)])]))

(define (opt-alias-remove-var [facts : OptAliasFacts (:consume)] [var : i64]) : OptAliasFacts
  (match facts
    [(OptAliasFacts.Facts map)
      (let
        [out : opt_i64_i64_map.Map map]
        (begin
          (opt_i64_i64_map.remove-ref! (&mut out) var)
          (OptAliasFacts.Facts out)))]))

(define (opt-alias-bind
  [facts : OptAliasFacts (:consume)]
  [var : i64]
  [kind : OptAliasKind]) : OptAliasFacts
  (match facts
    [(OptAliasFacts.Facts map)
      (let
        [out : opt_i64_i64_map.Map map]
        (begin
          (opt_i64_i64_map.insert-ref!
            (&mut out)
            var
            (opt-alias-kind-encode kind))
          (OptAliasFacts.Facts out)))]))

(define (opt-alias-mark-unique
  [facts : OptAliasFacts (:consume)]
  [var : i64]
  [epoch : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.Unique epoch)))

(define (opt-alias-mark-exclusive-ref
  [facts : OptAliasFacts (:consume)]
  [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.ExclusiveRef)))

(define (opt-alias-mark-shared-ref
  [facts : OptAliasFacts (:consume)]
  [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.SharedRef)))

(define (opt-alias-mark-may-alias
  [facts : OptAliasFacts (:consume)]
  [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.MayAlias)))

(define (opt-alias-mark-invalidated
  [facts : OptAliasFacts (:consume)]
  [var : i64]) : OptAliasFacts
  (opt-alias-bind facts var (OptAliasKind.Invalidated)))

;; Copy a value's fact onto `dst` (Mov/Cast of a tracked var). Root facts become
;; Derived(root) so aliases of one root retain one canonical identity; blindly
;; copying Unique/ExclusiveRef would incorrectly make the copy look disjoint.
;; An untracked source conservatively yields a MayAlias destination.
(define (opt-alias-copy-var
  [facts : OptAliasFacts (:consume)]
  [dst : i64]
  [src : i64]) : OptAliasFacts
  (match (opt-alias-lookup facts src)
    [(OptMaybeAliasKind.Some kind)
      (if (= dst src)
        facts
        (match kind
          [(OptAliasKind.Unique _)
            (opt-alias-bind facts dst (OptAliasKind.Derived src))]
          [(OptAliasKind.ExclusiveRef)
            (opt-alias-bind facts dst (OptAliasKind.Derived src))]
          [(OptAliasKind.SharedRef)
            (opt-alias-bind facts dst (OptAliasKind.Derived src))]
          [(OptAliasKind.Derived root)
            (opt-alias-bind facts dst (OptAliasKind.Derived root))]
          [(OptAliasKind.MayAlias) (opt-alias-mark-may-alias facts dst)]
          [(OptAliasKind.Invalidated) (opt-alias-mark-may-alias facts dst)]))]
    [(OptMaybeAliasKind.No) (opt-alias-mark-may-alias facts dst)]))

;; Derive `dst` through safe pointer arithmetic (Gep) from base var `base`.
;; A unique or already-derived base propagates the underlying root; anything
;; else is conservatively MayAlias.
(define (opt-alias-derive-var
  [facts : OptAliasFacts (:consume)]
  [dst : i64]
  [base : i64]) : OptAliasFacts
  (match (opt-alias-lookup facts base)
    [(OptMaybeAliasKind.Some kind)
      (match kind
        [(OptAliasKind.Unique _)
          (opt-alias-bind facts dst (OptAliasKind.Derived base))]
        [(OptAliasKind.ExclusiveRef)
          (opt-alias-bind facts dst (OptAliasKind.Derived base))]
        [(OptAliasKind.SharedRef)
          (opt-alias-bind facts dst (OptAliasKind.Derived base))]
        [(OptAliasKind.Derived root)
          (opt-alias-bind facts dst (OptAliasKind.Derived root))]
        [(OptAliasKind.MayAlias) (opt-alias-mark-may-alias facts dst)]
        [(OptAliasKind.Invalidated) (opt-alias-mark-may-alias facts dst)])]
    [(OptMaybeAliasKind.No) (opt-alias-mark-may-alias facts dst)]))

(define (opt-alias-contains?
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : bool
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.Some found) (opt-alias-kind-eq found kind)]
    [(OptMaybeAliasKind.No) false]))

(define (opt-alias-absent? [facts : OptAliasFacts] [var : i64]) : bool
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.No) true]
    [(OptMaybeAliasKind.Some _) false]))

;; A Fresh root carries (canonical root var, allocation epoch); the other roots
;; are parameter storage that predates every allocation and carry no epoch.
(defenum OptAliasRoot
  (NoRoot)
  (Fresh i64 i64)
  (Exclusive i64)
  (Shared i64))

(define (opt-alias-root-from-kind
  [facts : OptAliasFacts]
  [var : i64]
  [kind : OptAliasKind]) : OptAliasRoot
  (match kind
    [(OptAliasKind.Unique epoch) (OptAliasRoot.Fresh var epoch)]
    [(OptAliasKind.ExclusiveRef) (OptAliasRoot.Exclusive var)]
    [(OptAliasKind.SharedRef) (OptAliasRoot.Shared var)]
    [(OptAliasKind.Derived root)
      (match (opt-alias-lookup facts root)
        [(OptMaybeAliasKind.Some root-kind)
          (match root-kind
            [(OptAliasKind.Unique epoch) (OptAliasRoot.Fresh root epoch)]
            [(OptAliasKind.ExclusiveRef) (OptAliasRoot.Exclusive root)]
            [(OptAliasKind.SharedRef) (OptAliasRoot.Shared root)]
            [_ (OptAliasRoot.NoRoot)])]
        [(OptMaybeAliasKind.No) (OptAliasRoot.NoRoot)])]
    [(OptAliasKind.MayAlias) (OptAliasRoot.NoRoot)]
    [(OptAliasKind.Invalidated) (OptAliasRoot.NoRoot)]))

(define (opt-alias-root-of-var [facts : OptAliasFacts] [var : i64]) : OptAliasRoot
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.Some kind) (opt-alias-root-from-kind facts var kind)]
    [(OptMaybeAliasKind.No) (OptAliasRoot.NoRoot)]))

(define (opt-alias-root-of-value
  [facts : OptAliasFacts]
  [value : ir.CompilerIrValue]) : OptAliasRoot
  (match value
    [(ir.CompilerIrValue.Var var) (opt-alias-root-of-var facts var)]
    [_ (OptAliasRoot.NoRoot)]))

;; Only fresh allocations and checked mutable-reference roots prove a write
;; target disjoint from a DIFFERENT tracked root. SharedRef roots deliberately
;; do not: separate immutable-reference parameters may alias each other.
;; Allocation epochs play no part here -- root identity alone decides. The
;; epoch-ordering rule is a separate disjunct in the load-table keep test.
(define (opt-alias-store-root-disjoint?
  [store-root : OptAliasRoot]
  [entry-root : OptAliasRoot]) : bool
  (match store-root
    [(OptAliasRoot.Fresh store-id _)
      (match entry-root
        [(OptAliasRoot.Fresh entry-id _) (not (= store-id entry-id))]
        [(OptAliasRoot.Exclusive entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.Shared entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.NoRoot) false])]
    [(OptAliasRoot.Exclusive store-id)
      (match entry-root
        [(OptAliasRoot.Fresh entry-id _) (not (= store-id entry-id))]
        [(OptAliasRoot.Exclusive entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.Shared entry-id) (not (= store-id entry-id))]
        [(OptAliasRoot.NoRoot) false])]
    [(OptAliasRoot.Shared _) false]
    [(OptAliasRoot.NoRoot) false]))

(defenum OptAliasParamRootKind
  (NotCheckedRef)
  (SharedCheckedRef)
  (ExclusiveCheckedRef))

(define (opt-alias-param-root-kind
  [type-segment-bases : i64]
  [ty : ast.AstType]) : OptAliasParamRootKind
  (match ty
    [(ast.AstType.Ref _ _) (OptAliasParamRootKind.SharedCheckedRef)]
    [(ast.AstType.MutRef _ _) (OptAliasParamRootKind.ExclusiveCheckedRef)]
    [(ast.AstType.Region _ inner)
      (opt-alias-param-root-kind
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [_ (OptAliasParamRootKind.NotCheckedRef)]))

(define (opt-alias-seed-param
  [type-segment-bases : i64]
  [facts : OptAliasFacts (:consume)]
  [param : ir.CompilerIrParam]) : OptAliasFacts
  (match param
    [(ir.CompilerIrParam.Param _ ty var)
      (match (opt-alias-param-root-kind type-segment-bases ty)
        [(OptAliasParamRootKind.SharedCheckedRef)
          (opt-alias-mark-shared-ref facts var)]
        [(OptAliasParamRootKind.ExclusiveCheckedRef)
          (opt-alias-mark-exclusive-ref facts var)]
        [(OptAliasParamRootKind.NotCheckedRef) facts])]))

(define (opt-alias-seed-param-seq
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamSeq]
  [index : i64]
  [facts : OptAliasFacts (:consume)]) : OptAliasFacts
  (if (>= index (ir.compiler-ir-param-seq-count params))
    facts
    (opt-alias-seed-param-seq
      type-segment-bases
      params
      (+ index 1)
      (opt-alias-seed-param
        type-segment-bases
        facts
        (ir.compiler-ir-param-seq-ref params index)))))

(define (opt-alias-seed-params-from
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [facts : OptAliasFacts (:consume)]) : OptAliasFacts
  (match params
    [(ir.CompilerIrParamList.Nil) facts]
    [(ir.CompilerIrParamList.Array seq)
      (opt-alias-seed-param-seq type-segment-bases seq 0 facts)]
    [(ir.CompilerIrParamList.Cons param rest)
      (opt-alias-seed-params-from
        type-segment-bases
        (__tl-box-place rest)
        (opt-alias-seed-param type-segment-bases facts param))]))

(define (opt-alias-seed-params
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]) : OptAliasFacts
  (opt-alias-seed-params-from type-segment-bases params (opt-alias-empty)))

;; Conservative control-flow join: keep only facts that appear with an
;; identical kind on both incoming edges.
(define (opt-alias-intersect [a : OptAliasFacts] [b : OptAliasFacts]) : OptAliasFacts
  (match a
    [(OptAliasFacts.Facts amap)
      (match b
        [(OptAliasFacts.Facts bmap)
          (let
            [out : opt_i64_i64_map.Map
              (opt_i64_i64_map.with-capacity
                (+ (* (opt_i64_i64_map.len (& amap)) 2) 17))]
            [capacity : i64 (opt_i64_i64_map.capacity (& amap))]
            [i : i64 (opt_i64_i64_map.next-occupied (& amap) 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (opt_i64_i64_map.entry-at (& amap) i)
                    [(opt_i64_i64_map.EntrySome var value)
                      (match (opt_i64_i64_map.get (& bmap) var)
                        [(opt_i64_i64_map.LookupFound bvalue)
                          (if (= value bvalue)
                            (opt_i64_i64_map.insert-ref! (&mut out) var value)
                            unit)]
                        [(opt_i64_i64_map.LookupMissing) unit])]
                    [(opt_i64_i64_map.EntryNone) unit])
                  (set! i (opt_i64_i64_map.next-occupied (& amap) (+ i 1)))))
              (OptAliasFacts.Facts out)))])]))

(define (opt-alias-facts-len [facts : OptAliasFacts]) : i64
  (match facts
    [(OptAliasFacts.Facts map) (opt_i64_i64_map.len (& map))]))

;; Deep-copy the fact table. Per-block exit states are retained for every
;; successor's entry intersection, so a single-predecessor entry must not
;; alias (and then mutate) its predecessor's stored exit state.
(define (opt-alias-clone [facts : OptAliasFacts]) : OptAliasFacts
  (match facts
    [(OptAliasFacts.Facts map)
      (let
        [out : opt_i64_i64_map.Map
          (opt_i64_i64_map.with-capacity
            (+ (* (opt_i64_i64_map.len (& map)) 2) 17))]
        [capacity : i64 (opt_i64_i64_map.capacity (& map))]
        [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (opt_i64_i64_map.entry-at (& map) i)
                [(opt_i64_i64_map.EntrySome var value)
                  (opt_i64_i64_map.insert-ref! (&mut out) var value)]
                [(opt_i64_i64_map.EntryNone) unit])
              (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
          (OptAliasFacts.Facts out)))]))

;; A memory effect that can mutate or unknown-observe memory clears all facts.
;; `Alloc` is the one MemoryWrite that instead binds a fresh unique root, so it
;; is excluded by the caller below.
(define (opt-alias-effect-clears-facts? [effect : ir.CompilerIrEffect]) : bool
  (match effect
    [(ir.CompilerIrEffect.Pure) false]
    [(ir.CompilerIrEffect.MemoryRead) false]
    [(ir.CompilerIrEffect.CpuProbe) true]
    [(ir.CompilerIrEffect.MemoryWrite) true]
    [(ir.CompilerIrEffect.ControlFlow) false]
    [(ir.CompilerIrEffect.Unknown) true]))

;; True when the instruction conservatively clears ALL alias facts. The
;; call family is listed explicitly because a tail call carries a control-flow
;; IR effect yet still mutates memory; `Alloc` is excluded because it binds a
;; unique root instead of clearing.
(define (opt-alias-instr-clears-all? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Alloc _ _) false]
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.SpmdCall _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ (opt-alias-effect-clears-facts? (ir.compiler-ir-instr-effect instr))]))

(define (opt-alias-update-gep
  [facts : OptAliasFacts (:consume)]
  [dst : i64]
  [base : ir.CompilerIrValue]) : OptAliasFacts
  (match base
    [(ir.CompilerIrValue.Var base-var)
      (opt-alias-derive-var facts dst base-var)]
    [_ (opt-alias-mark-may-alias facts dst)]))

(define (opt-alias-update-copy
  [facts : OptAliasFacts (:consume)]
  [dst : i64]
  [value : ir.CompilerIrValue]) : OptAliasFacts
  (match value
    [(ir.CompilerIrValue.Var src) (opt-alias-copy-var facts dst src)]
    [_ (opt-alias-mark-may-alias facts dst)]))

;; True for the two instruction shapes that create storage that did not exist
;; before them: a frame `Alloc` and a direct `tl_alloc` runtime call. The
;; load-GVN state opens a new allocation epoch for exactly these.
(define (opt-alias-instr-fresh-alloc? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Alloc _ _) true]
    [(ir.CompilerIrInstr.Call _ name _ _)
      (ir.compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)]
    [_ false]))

;; Value/provenance transfer independent of memory invalidation. Every
;; definition first removes an older binding for the reused var id; recognized
;; pointer producers then bind the new value. This matters in the pre-SSA local
;; pipeline, where a scalar BinOp may reuse a former pointer var id.
;;
;; `epoch` is the allocation epoch to tag a fresh allocation with. Callers that
;; run an allocation counter (load GVN) pass the ALREADY-BUMPED value, so the
;; allocation's epoch is strictly greater than every load-table entry created
;; before it; the counter-free scratch/report consumer passes 0.
(define (opt-alias-update-value-facts
  [facts : OptAliasFacts (:consume)]
  [instr : ir.CompilerIrInstr]
  [epoch : i64]) : OptAliasFacts
  (let
    [base : OptAliasFacts
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst) (opt-alias-remove-var facts dst)]
        [(option_i64.None) facts])]
    (match instr
      [(ir.CompilerIrInstr.Alloc dst _) (opt-alias-mark-unique base dst epoch)]
      [(ir.CompilerIrInstr.Gep dst source _ _)
        (opt-alias-update-gep base dst source)]
      [(ir.CompilerIrInstr.Mov dst value _)
        (opt-alias-update-copy base dst value)]
      [(ir.CompilerIrInstr.Cast dst value _ _)
        (opt-alias-update-copy base dst value)]
      [(ir.CompilerIrInstr.Bitcast dst value _ _)
        (opt-alias-update-copy base dst value)]
      ;; A direct runtime allocation call returns a fresh root for subsequent
      ;; scalar-store filtering, and opens a new allocation epoch: storage that
      ;; did not exist before the call cannot alias anything cached before it.
      [(ir.CompilerIrInstr.Call dst name _ _)
        (if (ir.compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
          (opt-alias-mark-unique base dst epoch)
          base)]
      [(ir.CompilerIrInstr.Load dst _ _) (opt-alias-mark-may-alias base dst)]
      [(ir.CompilerIrInstr.EntryArgv dst) (opt-alias-mark-may-alias base dst)]
      [(ir.CompilerIrInstr.EntryEnvp dst) (opt-alias-mark-may-alias base dst)]
      [(ir.CompilerIrInstr.AddrOf dst _) (opt-alias-mark-may-alias base dst)]
      [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
        (opt-alias-mark-may-alias base dst)]
      [(ir.CompilerIrInstr.PredicatedLoad payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (opt-alias-mark-may-alias base dst))]
      [(ir.CompilerIrInstr.GatherLoad payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (opt-alias-mark-may-alias base dst))]
      [(ir.CompilerIrInstr.VectorShuffle payload-box)
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          (opt-alias-mark-may-alias base dst))]
      [_ base])))

;; Transfer function for the scratch/report alias consumer. Memory-mutating or
;; unknown instructions still clear every fact; load GVN uses the provenance-
;; preserving transfer defined beside its pointer-kind model below.
(define (opt-alias-update-facts
  [facts : OptAliasFacts (:consume)]
  [instr : ir.CompilerIrInstr]) : OptAliasFacts
  (if (opt-alias-instr-clears-all? instr)
    (opt-alias-empty)
    (opt-alias-update-value-facts facts instr 0)))

(define (opt-alias-run
  [facts : OptAliasFacts (:consume)]
  [instrs : ir.CompilerIrInstrList]) : OptAliasFacts
  (match instrs
    [(ir.CompilerIrInstrList.Nil) facts]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (opt-alias-run (opt-alias-update-facts facts instr) (__tl-box-place rest))]))

;; --- implicit scratch-region candidate report -------------------------------
;;
;; Report-only analysis for future automatic scratch regions. It recognizes
;; direct `tl_alloc` roots, tracks simple candidate-derived pointers with the
;; optimizer alias fact model, and records the first conservative blocker for a
;; function/block/loop scope. The result never rewrites IR; compile-profile
;; builds only emit deterministic detail rows to stderr.
;; Roots are a membership-only set (never traversed), so keyed dense storage
;; avoids the old linear scan as scopes accumulate allocation candidates.
(defenum OptScratchRootList
  (Empty)
  (Dense opt_i64_i64_map.Map))

(defenum OptScratchBlockerReason
  (NoBlocker)
  (Blocked String))

(defenum OptScratchAlloc
  (NoAlloc)
  (Alloc i64 i64))

(defenum OptScratchScopeState
  (State i64 i64 OptScratchRootList OptAliasFacts OptScratchBlockerReason))

(defenum OptScratchScopeReport
  (Report i64 i64 OptScratchBlockerReason))

;; Physical-layout mirror used by optimizer analyses that do have the type
;; segment pool available.  A borrowed Slice reference is the only fat Ref;
;; Region wrappers around its immediate referent are transparent.
(define (opt-reference-to-slice? [type-segment-bases : i64] [inner : i64]) : bool
  (match (ast.ast-type-segment-bases-get type-segment-bases inner)
    [(ast.AstType.Region _ nested)
      (opt-reference-to-slice? type-segment-bases nested)]
    [(ast.AstType.Slice _) true]
    [_ false]))

(define (opt-scratch-alloc-type-size
  [type-segment-bases : i64]
  [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.Char) 1]
    [(ast.AstType.Unit) 0]
    [(ast.AstType.Never) 0]
    [(ast.AstType.Expr) 0]
    [(ast.AstType.ExprList) 0]
    [(ast.AstType.Func _ _) 8]
    [(ast.AstType.Tuple _) 8]
    [(ast.AstType.Array _ _) 8]
    [(ast.AstType.DynArray _) 8]
    [(ast.AstType.Slice _) 0]
    [(ast.AstType.Box _) 8]
    [(ast.AstType.Ptr _) 8]
    [(ast.AstType.MutPtr _) 8]
    [(ast.AstType.Ref _ inner)
      (if (opt-reference-to-slice? type-segment-bases inner)
        16
        8)]
    [(ast.AstType.MutRef _ inner)
      (if (opt-reference-to-slice? type-segment-bases inner)
        16
        8)]
    [(ast.AstType.Region _ inner)
      (opt-scratch-alloc-type-size
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [(ast.AstType.Enum _) 8]
    [(ast.AstType.EnumArgs _ _) 8]
    [(ast.AstType.Struct _) 8]
    [(ast.AstType.StructArgs _ _) 8]
    [(ast.AstType.String) 8]
    [(ast.AstType.Str) 8]
    [(ast.AstType.Bytes) 8]
    [(ast.AstType.Var _) 0]
    [(ast.AstType.VarArgs _ _) 0]
    [(ast.AstType.Consume inner)
      (opt-scratch-alloc-type-size
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]))

(define (opt-scratch-root-list-new) : OptScratchRootList
  (OptScratchRootList.Empty))

(define (opt-scratch-root-list-contains?
  [roots : OptScratchRootList]
  [root : i64]) : bool
  (match roots
    [(OptScratchRootList.Empty) false]
    [(OptScratchRootList.Dense items)
      (opt_i64_i64_map.contains? (& items) root)]))

(define (opt-scratch-root-list-add
  [roots : OptScratchRootList (:consume)]
  [root : i64]) : OptScratchRootList
  (match roots
    [(OptScratchRootList.Empty)
      (let
        [items : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 4)]
        (begin
          (opt_i64_i64_map.insert-ref! (&mut items) root 1)
          (OptScratchRootList.Dense items)))]
    [(OptScratchRootList.Dense found)
      (if (opt_i64_i64_map.contains? (& found) root)
        roots
        (let
          [items : opt_i64_i64_map.Map found]
          (begin
            (opt_i64_i64_map.insert-ref! (&mut items) root 1)
            (OptScratchRootList.Dense items))))]))

(define (opt-scratch-direct-alloc
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]) : OptScratchAlloc
  (match instr
    [(ir.CompilerIrInstr.Alloc dst ty)
      (OptScratchAlloc.Alloc
        dst
        (opt-scratch-alloc-type-size type-segment-bases ty))]
    [(ir.CompilerIrInstr.Call dst name args _)
      (if (ir.compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
        (match (opt-aggregate-tl-alloc-size args)
          [(option_i64.Some size)
            (OptScratchAlloc.Alloc
              dst
              (if (> size 0)
                size
                0))]
          [(option_i64.None) (OptScratchAlloc.Alloc dst 0)])
        (OptScratchAlloc.NoAlloc))]
    [_ (OptScratchAlloc.NoAlloc)]))

(define (opt-scratch-arena-helper-call? [symbol : i64]) : bool
  (or
    (= symbol cbi.compiler-builtin-id-arena-current)
    (= symbol cbi.compiler-builtin-id-arena-mark)
    (= symbol cbi.compiler-builtin-id-arena-set-bang)
    (= symbol cbi.compiler-builtin-id-arena-rewind)
    (= symbol cbi.compiler-builtin-id-arena-destroy)
    (= symbol cbi.compiler-builtin-id-tl-region-mark)
    (= symbol cbi.compiler-builtin-id-tl-region-reset)
    (= symbol cbi.compiler-builtin-id-tl-arena-make)
    (= symbol cbi.compiler-builtin-id-tl-arena-current)
    (= symbol cbi.compiler-builtin-id-tl-arena-set)
    (= symbol cbi.compiler-builtin-id-tl-arena-destroy)
    (= symbol cbi.compiler-builtin-id-tl-arena-poison-enable)))

(define (opt-scratch-var-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [var : i64]) : bool
  (match (opt-alias-lookup facts var)
    [(OptMaybeAliasKind.Some kind)
      (match kind
        [(OptAliasKind.Unique _) (opt-scratch-root-list-contains? roots var)]
        [(OptAliasKind.ExclusiveRef) false]
        [(OptAliasKind.SharedRef) false]
        [(OptAliasKind.Derived root)
          (opt-scratch-root-list-contains? roots root)]
        [(OptAliasKind.MayAlias) false]
        [(OptAliasKind.Invalidated) false])]
    [(OptMaybeAliasKind.No) false]))

(define (opt-scratch-value-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var) (opt-scratch-var-derived? roots facts var)]
    [_ false]))

(define (opt-scratch-maybe-value-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [maybe : ir.CompilerIrMaybeValue]) : bool
  (match maybe
    [(ir.CompilerIrMaybeValue.No) false]
    [(ir.CompilerIrMaybeValue.Some value)
      (opt-scratch-value-derived? roots facts value)]))

(define (opt-scratch-value-list-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [values : ir.CompilerIrValueList]) : bool
  (match values
    [(ir.CompilerIrValueList.Nil) false]
    [(ir.CompilerIrValueList.Array seq)
      (opt-scratch-value-list-derived?
        roots
        facts
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (or
        (opt-scratch-value-derived? roots facts value)
        (opt-scratch-value-list-derived? roots facts (__tl-box-place rest)))]))

(define (opt-scratch-blocker-none? [blocker : OptScratchBlockerReason]) : bool
  (match blocker
    [(OptScratchBlockerReason.NoBlocker) true]
    [(OptScratchBlockerReason.Blocked _) false]))

(define (opt-scratch-blocker-reason
  [type-segment-bases : i64]
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instr : ir.CompilerIrInstr]) : OptScratchBlockerReason
  (match (opt-scratch-direct-alloc type-segment-bases instr)
    [(OptScratchAlloc.Alloc _ _) (OptScratchBlockerReason.NoBlocker)]
    [(OptScratchAlloc.NoAlloc)
      (match instr
        [(ir.CompilerIrInstr.Call _ name _ _)
          (if (opt-scratch-arena-helper-call? name)
            (OptScratchBlockerReason.Blocked "arena_helper")
            (OptScratchBlockerReason.Blocked "call"))]
        [(ir.CompilerIrInstr.CallIndirect _ _ _ _)
          (OptScratchBlockerReason.Blocked "call")]
        [(ir.CompilerIrInstr.CallIndirectC _ _ _ _)
          (OptScratchBlockerReason.Blocked "extern_call")]
        [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
          (OptScratchBlockerReason.Blocked "extern_call")]
        [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
          (OptScratchBlockerReason.Blocked "extern_call")]
        [(ir.CompilerIrInstr.SpmdCall payload-box)
          (OptScratchBlockerReason.Blocked "call")]
        [(ir.CompilerIrInstr.Syscall _ _)
          (OptScratchBlockerReason.Blocked "extern_call")]
        [(ir.CompilerIrInstr.TailCall _ _ _)
          (OptScratchBlockerReason.Blocked "tail_call")]
        [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
          (OptScratchBlockerReason.Blocked "tail_call")]
        [(ir.CompilerIrInstr.AddrOf _ _)
          (OptScratchBlockerReason.Blocked "raw_pointer")]
        [(ir.CompilerIrInstr.Gep _ base offset _)
          (if (opt-scratch-value-derived? roots facts offset)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (if (opt-scratch-value-derived? roots facts base)
              (match offset
                [(ir.CompilerIrValue.I64 _) (OptScratchBlockerReason.NoBlocker)]
                [_ (OptScratchBlockerReason.Blocked "raw_pointer")])
              (OptScratchBlockerReason.NoBlocker)))]
        [(ir.CompilerIrInstr.Cast _ src _ _)
          (if (opt-scratch-value-derived? roots facts src)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.Bitcast _ src _ _)
          (if (opt-scratch-value-derived? roots facts src)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.StorePtr ptr value _)
          (if (and
            (opt-scratch-value-derived? roots facts value)
            (not (opt-scratch-value-derived? roots facts ptr)))
            (OptScratchBlockerReason.Blocked "store_outer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.Store _ value _)
          (if (opt-scratch-value-derived? roots facts value)
            (OptScratchBlockerReason.Blocked "store_outer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.CopyBytes dst src _)
          (if (and
            (opt-scratch-value-derived? roots facts src)
            (not (opt-scratch-value-derived? roots facts dst)))
            (OptScratchBlockerReason.Blocked "store_outer")
            (if (or
              (opt-scratch-value-derived? roots facts dst)
              (opt-scratch-value-derived? roots facts src))
              (OptScratchBlockerReason.Blocked "raw_pointer")
              (OptScratchBlockerReason.NoBlocker)))]
        [(ir.CompilerIrInstr.VectorStore payload-box)
          (let
            [base (__tl-project-field (__tl-box-place payload-box) base)]
            [index (__tl-project-field (__tl-box-place payload-box) index)]
            [value (__tl-project-field (__tl-box-place payload-box) value)]
            (if (and
              (opt-scratch-value-derived? roots facts value)
              (not (opt-scratch-value-derived? roots facts base)))
              (OptScratchBlockerReason.Blocked "store_outer")
              (if (or
                (opt-scratch-value-derived? roots facts base)
                (opt-scratch-value-derived? roots facts index)
                (opt-scratch-value-derived? roots facts value))
                (OptScratchBlockerReason.Blocked "raw_pointer")
                (OptScratchBlockerReason.NoBlocker))))]
        [(ir.CompilerIrInstr.PredicatedStore payload-box)
          (let
            [base (__tl-project-field (__tl-box-place payload-box) base)]
            [index (__tl-project-field (__tl-box-place payload-box) index)]
            [value (__tl-project-field (__tl-box-place payload-box) value)]
            [mask (__tl-project-field (__tl-box-place payload-box) mask)]
            (if (and
              (opt-scratch-value-derived? roots facts value)
              (not (opt-scratch-value-derived? roots facts base)))
              (OptScratchBlockerReason.Blocked "store_outer")
              (if (or
                (opt-scratch-value-derived? roots facts base)
                (opt-scratch-value-derived? roots facts index)
                (opt-scratch-value-derived? roots facts value)
                (opt-scratch-value-derived? roots facts mask))
                (OptScratchBlockerReason.Blocked "raw_pointer")
                (OptScratchBlockerReason.NoBlocker))))]
        [(ir.CompilerIrInstr.VectorLoad _ base index _ _)
          (if (or
            (opt-scratch-value-derived? roots facts base)
            (opt-scratch-value-derived? roots facts index))
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.PredicatedLoad payload-box)
          (let
            [base (__tl-project-field (__tl-box-place payload-box) base)]
            [index (__tl-project-field (__tl-box-place payload-box) index)]
            [mask (__tl-project-field (__tl-box-place payload-box) mask)]
            (if (or
              (opt-scratch-value-derived? roots facts base)
              (opt-scratch-value-derived? roots facts index)
              (opt-scratch-value-derived? roots facts mask))
              (OptScratchBlockerReason.Blocked "raw_pointer")
              (OptScratchBlockerReason.NoBlocker)))]
        [(ir.CompilerIrInstr.GatherLoad payload-box)
          (let
            [base (__tl-project-field (__tl-box-place payload-box) base)]
            [index-base
              (__tl-project-field (__tl-box-place payload-box) index-base)]
            [index (__tl-project-field (__tl-box-place payload-box) index)]
            (if (or
              (opt-scratch-value-derived? roots facts base)
              (opt-scratch-value-derived? roots facts index-base)
              (opt-scratch-value-derived? roots facts index))
              (OptScratchBlockerReason.Blocked "raw_pointer")
              (OptScratchBlockerReason.NoBlocker)))]
        [(ir.CompilerIrInstr.VectorShuffle payload-box)
          (let
            [source (__tl-project-field (__tl-box-place payload-box) source)]
            [selector-low
              (__tl-project-field (__tl-box-place payload-box) selector-low)]
            [selector-high
              (__tl-project-field (__tl-box-place payload-box) selector-high)]
            [active-lanes
              (__tl-project-field (__tl-box-place payload-box) active-lanes)]
            (if (or
              (opt-scratch-value-derived? roots facts source)
              (opt-scratch-value-derived? roots facts selector-low)
              (opt-scratch-maybe-value-derived? roots facts selector-high)
              (opt-scratch-value-derived? roots facts active-lanes))
              (OptScratchBlockerReason.Blocked "raw_pointer")
              (OptScratchBlockerReason.NoBlocker)))]
        [(ir.CompilerIrInstr.Return maybe)
          (if (opt-scratch-maybe-value-derived? roots facts maybe)
            (OptScratchBlockerReason.Blocked "return_escape")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.Pack _ values _)
          (if (opt-scratch-value-list-derived? roots facts values)
            (OptScratchBlockerReason.Blocked "return_escape")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.Branch cond _ _)
          (if (opt-scratch-value-derived? roots facts cond)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
          (if (opt-scratch-value-derived? roots facts cond)
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [(ir.CompilerIrInstr.BoundsCheck index length _)
          (if (or
            (opt-scratch-value-derived? roots facts index)
            (opt-scratch-value-derived? roots facts length))
            (OptScratchBlockerReason.Blocked "raw_pointer")
            (OptScratchBlockerReason.NoBlocker))]
        [_ (OptScratchBlockerReason.NoBlocker)])]))

(define (opt-scratch-state-with-blocker
  [state : OptScratchScopeState]
  [candidate : OptScratchBlockerReason]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State allocs bytes roots facts blocker)
      (if (opt-scratch-blocker-none? blocker)
        (match candidate
          [(OptScratchBlockerReason.NoBlocker) state]
          [(OptScratchBlockerReason.Blocked _)
            (OptScratchScopeState.State allocs bytes roots facts candidate)])
        state)]))

(define (opt-scratch-state-record-alloc
  [state : OptScratchScopeState (:consume)]
  [dst : i64]
  [bytes : i64]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State alloc-count known-bytes roots facts blocker)
      (OptScratchScopeState.State
        (+ alloc-count 1)
        (+ known-bytes bytes)
        (opt-scratch-root-list-add roots dst)
        ;; The report-only scratch analysis runs no allocation counter and
        ;; never consults epochs, so every root it records is epoch 0.
        (opt-alias-mark-unique facts dst 0)
        blocker)]))

(define (opt-scratch-state-facts
  [state : OptScratchScopeState]
  [facts : OptAliasFacts]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State allocs bytes roots _ blocker)
      (OptScratchScopeState.State allocs bytes roots facts blocker)]))

(define (opt-scratch-storeptr-keeps-facts?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : bool
  (and
    (opt-scratch-value-derived? roots facts ptr)
    (not (opt-scratch-value-derived? roots facts value))))

(define (opt-scratch-update-nonalloc-facts
  [state : OptScratchScopeState (:consume)]
  [instr : ir.CompilerIrInstr]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State _ _ roots facts _)
      (opt-scratch-state-facts
        state
        (match instr
          [(ir.CompilerIrInstr.StorePtr ptr value _)
            (if (opt-scratch-storeptr-keeps-facts? roots facts ptr value)
              facts
              (opt-alias-update-facts facts instr))]
          [(ir.CompilerIrInstr.Store _ value _)
            (if (opt-scratch-value-derived? roots facts value)
              (opt-alias-update-facts facts instr)
              facts)]
          [_ (opt-alias-update-facts facts instr)]))]))

(define (opt-scratch-state-step
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [instr : ir.CompilerIrInstr]) : OptScratchScopeState
  (match state
    [(OptScratchScopeState.State _ _ roots facts _)
      (let
        [blocked : OptScratchScopeState
          (opt-scratch-state-with-blocker
            state
            (opt-scratch-blocker-reason type-segment-bases roots facts instr))]
        (match (opt-scratch-direct-alloc type-segment-bases instr)
          [(OptScratchAlloc.Alloc dst bytes)
            (opt-scratch-state-record-alloc blocked dst bytes)]
          [(OptScratchAlloc.NoAlloc)
            (opt-scratch-update-nonalloc-facts blocked instr)]))]))

(define (opt-scratch-state-initial) : OptScratchScopeState
  (OptScratchScopeState.State
    0
    0
    (opt-scratch-root-list-new)
    (opt-alias-empty)
    (OptScratchBlockerReason.NoBlocker)))

(define (opt-scratch-scope-report-from-state [state : OptScratchScopeState]) : OptScratchScopeReport
  (match state
    [(OptScratchScopeState.State allocs bytes _ _ blocker)
      (OptScratchScopeReport.Report allocs bytes blocker)]))

(define (opt-scratch-scope-scan-instrs
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [instrs : ir.CompilerIrInstrList]) : OptScratchScopeState
  (match instrs
    [(ir.CompilerIrInstrList.Nil) state]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (opt-scratch-scope-scan-instrs
        type-segment-bases
        (opt-scratch-state-step type-segment-bases state instr)
        (__tl-box-place rest))]))

(define (opt-scratch-scope-scan-instr-seq-from
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptScratchScopeState
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    state
    (opt-scratch-scope-scan-instr-seq-from
      type-segment-bases
      (opt-scratch-state-step
        type-segment-bases
        state
        (ir.compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-scratch-scope-scan-blocks
  [type-segment-bases : i64]
  [state : OptScratchScopeState]
  [blocks : ir.CompilerIrBlockList]) : OptScratchScopeState
  (match blocks
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-scratch-scope-scan-blocks
            type-segment-bases
            (opt-scratch-scope-scan-instr-seq-from
              type-segment-bases
              state
              instrs
              0)
            (__tl-box-place rest))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-scratch-scope-scan-blocks
        type-segment-bases
        state
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-scope-report-instrs
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrList]) : OptScratchScopeReport
  (opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-instrs
      type-segment-bases
      (opt-scratch-state-initial)
      instrs)))

(define (opt-scratch-scope-report-block
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : OptScratchScopeReport
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-scratch-scope-report-from-state
        (opt-scratch-scope-scan-instr-seq-from
          type-segment-bases
          (opt-scratch-state-initial)
          instrs
          0))]))

(define (opt-scratch-scope-report-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]) : OptScratchScopeReport
  (opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-blocks
      type-segment-bases
      (opt-scratch-state-initial)
      blocks)))

(define (opt-scratch-report-candidate?
  [report : OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]) : bool
  (match report
    [(OptScratchScopeReport.Report allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (opt-scratch-blocker-none? blocker))]))

(define (opt-scratch-report-blocked?
  [_type-segment-bases : i64]
  [report : OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]
  [reason : String]) : bool
  (match report
    [(OptScratchScopeReport.Report allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (match blocker
          [(OptScratchBlockerReason.Blocked found) (string.eq found reason)]
          [(OptScratchBlockerReason.NoBlocker) false]))]))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-status
    [blocker : OptScratchBlockerReason]) : String
    (match blocker
      [(OptScratchBlockerReason.NoBlocker) "candidate"]
      [(OptScratchBlockerReason.Blocked _) "blocked"])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-reason
    [blocker : OptScratchBlockerReason]) : String
    (match blocker
      [(OptScratchBlockerReason.NoBlocker) "none"]
      [(OptScratchBlockerReason.Blocked reason) reason])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-line
    [status : String]
    [scope : String]
    [function : String]
    [label : i64]
    [latch : i64]
    [allocs : i64]
    [bytes : i64]
    [reason : String]) : String
    (str_cat.str-cat
      "compile-profile-detail|scratch_region|"
      status
      "|scope="
      scope
      "|function="
      function
      "|label="
      (ir.compiler-ir-label-text label)
      "|latch="
      (ir.compiler-ir-label-text latch)
      "|allocs="
      (string.int->string allocs)
      "|known_bytes="
      (string.int->string bytes)
      "|blocker="
      reason
      "\n")))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-one
    [scope : String]
    [function : String]
    [label : i64]
    [latch : i64]
    [report : OptScratchScopeReport]) : unit
    (match report
      [(OptScratchScopeReport.Report allocs bytes blocker)
        (cfg
          compile-profile-summary
          unit
          (if (> allocs 0)
            (io.print-error
              (compiler-opt-scratch-region-report-line
                (compiler-opt-scratch-region-report-status blocker)
                scope
                function
                label
                latch
                allocs
                bytes
                (compiler-opt-scratch-region-report-reason blocker)))
            unit))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-blocks
    [type-segment-bases : i64]
    [function : String]
    [blocks : ir.CompilerIrBlockList]) : unit
    (match blocks
      [(ir.CompilerIrBlockList.Nil) unit]
      [(ir.CompilerIrBlockList.Cons block rest)
        (begin
          (match block
            [(ir.CompilerIrBlock.Block label _)
              (compiler-opt-scratch-region-report-one
                "block"
                function
                label
                (ir.compiler-ir-label "-")
                (opt-scratch-scope-report-block type-segment-bases block))])
          (compiler-opt-scratch-region-report-blocks
            type-segment-bases
            function
            (__tl-box-place rest)))]
      [(ir.CompilerIrBlockList.Array seq)
        (compiler-opt-scratch-region-report-blocks
          type-segment-bases
          function
          (ir.compiler-ir-block-seq-to-list seq))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-loops
    [type-segment-bases : i64]
    [function : String]
    [loops : OptNaturalLoopList]) : unit
    (match loops
      [(OptNaturalLoopList.Nil) unit]
      [(OptNaturalLoopList.Cons loop rest)
        (begin
          (compiler-opt-scratch-region-report-one
            "loop"
            function
            (opt-natural-loop-header loop)
            (opt-natural-loop-latch loop)
            (opt-scratch-scope-report-blocks
              type-segment-bases
              (opt-natural-loop-body-blocks loop)))
          (compiler-opt-scratch-region-report-loops
            type-segment-bases
            function
            (__tl-box-place rest)))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-function
    [type-segment-bases : i64]
    [func : ir.CompilerIrFunction]) : unit
    (match func
      [(ir.CompilerIrFunction.Function name _ _ _ blocks)
        (let
          [name-text : String (ir.compiler-ir-symbol-text name)]
          (begin
            (compiler-opt-scratch-region-report-one
              "function"
              name-text
              (ir.compiler-ir-label "-")
              (ir.compiler-ir-label "-")
              (opt-scratch-scope-report-blocks type-segment-bases blocks))
            (compiler-opt-scratch-region-report-blocks
              type-segment-bases
              name-text
              blocks)
            (compiler-opt-scratch-region-report-loops
              type-segment-bases
              name-text
              (opt-cfg-natural-loops blocks))))])))

(cfg
  compile-profile
  (define (compiler-opt-scratch-region-report-function-escaping
    [type-segment-bases : i64]
    [func : ir.CompilerIrFunction]
    [scratch : i64]) : unit
    (let
      [enclosing : i64 (arena.tl_arena_current)]
      (begin
        (unsafe
          (arena.tl_arena_set scratch))
        (let
          [mark : i64 (arena.tl_region_mark)]
          [_report : unit
            (compiler-opt-scratch-region-report-function
              type-segment-bases
              func)]
          [scratch-head : i64 (arena.tl_arena_current)]
          (unsafe
            (arena.tl_arena_set scratch-head)
            (arena.tl_region_reset mark)
            (arena.tl_arena_set enclosing)))))))

;; --- implicit scratch-region reset insertion -------------------------------
;;
;; Opt2 may wrap a proven loop-body scratch candidate with one mark before the
;; loop and one reset in the latch. The pass deliberately handles only simple
;; cleanup shapes. Any body return, candidate carried by a phi, allocation in
;; the header guard, missing unique mark block, or non-header/non-latch edge out
;; of the loop keeps the IR unchanged.
(defenum OptScratchResetApplyResult
  (Result ir.CompilerIrBlockList i64 bool))

(defenum OptScratchResetMarkBlock
  (No)
  (Some i64))

(defenum OptScratchResetMarkCandidate
  (None)
  (One i64)
  (Many))

(define (opt-scratch-scope-state-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]) : OptScratchScopeState
  (opt-scratch-scope-scan-blocks
    type-segment-bases
    (opt-scratch-state-initial)
    blocks))

(define (opt-scratch-state-candidate? [state : OptScratchScopeState]) : bool
  (match state
    [(OptScratchScopeState.State allocs _ _ _ blocker)
      (and (> allocs 0) (opt-scratch-blocker-none? blocker))]))

(define (opt-scratch-report-alloc-count [report : OptScratchScopeReport]) : i64
  (match report
    [(OptScratchScopeReport.Report allocs _ _) allocs]))

(define (opt-scratch-block-alloc-count
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) 0]
    [(OptMaybeBlock.Some block)
      (opt-scratch-report-alloc-count
        (opt-scratch-scope-report-block type-segment-bases block))]))

(define (opt-scratch-reset-mark-candidate-add
  [candidate : OptScratchResetMarkCandidate]
  [pred : i64]) : OptScratchResetMarkCandidate
  (match candidate
    [(OptScratchResetMarkCandidate.None)
      (OptScratchResetMarkCandidate.One pred)]
    [(OptScratchResetMarkCandidate.One _) (OptScratchResetMarkCandidate.Many)]
    [(OptScratchResetMarkCandidate.Many) (OptScratchResetMarkCandidate.Many)]))

(define (opt-scratch-reset-mark-candidate-scan
  [reachable : OptLabelSet]
  [body : OptLabelSet]
  [preds : OptLabelSet]
  [candidate : OptScratchResetMarkCandidate]) : OptScratchResetMarkCandidate
  (match preds
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (opt-scratch-reset-mark-candidate-scan
          reachable
          body
          (opt-label-tail preds)
          (if (and
            (opt-label-contains reachable pred)
            (not (opt-label-contains body pred)))
            (opt-scratch-reset-mark-candidate-add candidate pred)
            candidate)))]))

(define (opt-scratch-reset-mark-candidate-scan-not-label
  [reachable : OptLabelSet]
  [skip : i64]
  [preds : OptLabelSet]
  [candidate : OptScratchResetMarkCandidate]) : OptScratchResetMarkCandidate
  (match preds
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (opt-scratch-reset-mark-candidate-scan-not-label
          reachable
          skip
          (opt-label-tail preds)
          (if (and (opt-label-contains reachable pred) (not (= pred skip)))
            (opt-scratch-reset-mark-candidate-add candidate pred)
            candidate)))]))

(define (opt-scratch-reset-mark-block-from-candidate
  [candidate : OptScratchResetMarkCandidate]) : OptScratchResetMarkBlock
  (match candidate
    [(OptScratchResetMarkCandidate.One label)
      (OptScratchResetMarkBlock.Some label)]
    [_ (OptScratchResetMarkBlock.No)]))

(define (opt-scratch-reset-loop-mark-block
  [context : OptCfgContext]
  [loop : OptNaturalLoop]) : OptScratchResetMarkBlock
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some preheader)
      (OptScratchResetMarkBlock.Some preheader)]
    [(OptLoopPreheader.No)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [preds : OptLabelSet (opt-pred-map-lookup context.pred-map header)]
        [reachable : OptLabelSet context.reachable]
        (opt-scratch-reset-mark-block-from-candidate
          (if (= header (opt-natural-loop-latch loop))
            (opt-scratch-reset-mark-candidate-scan-not-label
              reachable
              header
              preds
              (OptScratchResetMarkCandidate.None))
            (opt-scratch-reset-mark-candidate-scan
              reachable
              (opt-natural-loop-body loop)
              preds
              (OptScratchResetMarkCandidate.None)))))]))

(define (opt-scratch-phi-input-derived?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-scratch-phi-input-derived?
        roots
        facts
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (or
        (opt-scratch-value-derived? roots facts value)
        (opt-scratch-phi-input-derived? roots facts (__tl-box-place rest)))]))

(define (opt-scratch-instr-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-scratch-phi-input-derived? roots facts inputs)]
    [_ false]))

(define (opt-scratch-instr-seq-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-scratch-instr-loop-carried-candidate?
        roots
        facts
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-scratch-instr-seq-loop-carried-candidate?
        roots
        facts
        instrs
        (+ index 1)))))

(define (opt-scratch-block-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-scratch-instr-seq-loop-carried-candidate? roots facts instrs 0)]))

(define (opt-scratch-blocks-loop-carried-candidate?
  [roots : OptScratchRootList]
  [facts : OptAliasFacts]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (or
        (opt-scratch-block-loop-carried-candidate? roots facts block)
        (opt-scratch-blocks-loop-carried-candidate?
          roots
          facts
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-scratch-blocks-loop-carried-candidate?
        roots
        facts
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-state-loop-carried-candidate?
  [state : OptScratchScopeState]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match state
    [(OptScratchScopeState.State _ _ roots facts _)
      (opt-scratch-blocks-loop-carried-candidate? roots facts blocks)]))

(define (opt-scratch-instr-return-exit? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Return _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ false]))

(define (opt-scratch-instr-seq-return-exit?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-scratch-instr-return-exit?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-scratch-instr-seq-return-exit? instrs (+ index 1)))))

(define (opt-scratch-successors-loop-safe?
  [body : OptLabelSet]
  [label : i64]
  [header : i64]
  [latch : i64]
  [mark-block : i64]
  [successors : OptLabelSet]) : bool
  (match successors
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [succ : i64 (opt-label-ref successors 0)]
        (and
          (or
            (opt-label-contains body succ)
            (= label header)
            (= label latch)
            (= label mark-block))
          (opt-scratch-successors-loop-safe?
            body
            label
            header
            latch
            mark-block
            (opt-label-tail successors))))]))

(define (opt-scratch-loop-block-exits-safe?
  [index : OptCfgIndex]
  [body : OptLabelSet]
  [header : i64]
  [latch : i64]
  [mark-block : i64]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (and
        (not (opt-scratch-instr-seq-return-exit? instrs 0))
        (opt-scratch-successors-loop-safe?
          body
          label
          header
          latch
          mark-block
          (opt-cfg-index-successors index label)))]))

(define (opt-scratch-loop-blocks-exits-safe?
  [index : OptCfgIndex]
  [body : OptLabelSet]
  [header : i64]
  [latch : i64]
  [mark-block : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (and
        (opt-scratch-loop-block-exits-safe?
          index
          body
          header
          latch
          mark-block
          block)
        (opt-scratch-loop-blocks-exits-safe?
          index
          body
          header
          latch
          mark-block
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-scratch-loop-blocks-exits-safe?
        index
        body
        header
        latch
        mark-block
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-scratch-loop-eligible?
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]) : bool
  (match (opt-scratch-reset-loop-mark-block context loop)
    [(OptScratchResetMarkBlock.No) false]
    [(OptScratchResetMarkBlock.Some mark-block)
      (let
        [index : OptCfgIndex context.index]
        [header : i64 (opt-natural-loop-header loop)]
        [latch : i64 (opt-natural-loop-latch loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [body-blocks : ir.CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        [state : OptScratchScopeState
          (opt-scratch-scope-state-blocks type-segment-bases body-blocks)]
        (and
          (opt-scratch-state-candidate? state)
          (or
            (= header latch)
            (=
              (opt-scratch-block-alloc-count type-segment-bases blocks header)
              0))
          (not (opt-scratch-state-loop-carried-candidate? state body-blocks))
          (opt-scratch-loop-blocks-exits-safe?
            index
            body
            header
            latch
            mark-block
            body-blocks)))]))

(define (opt-scratch-reset-mark-instr [mark-var : i64]) : ir.CompilerIrInstr
  (begin
    (cbi.compiler-builtin-refresh!)
    (ir.CompilerIrInstr.Call
      mark-var
      cbi.compiler-builtin-id-tl-region-mark
      (ir.CompilerIrCallArgs.Nil)
      (ast.AstType.I64))))

(define (opt-scratch-reset-reset-instr [reset-var : i64] [mark-var : i64]) : ir.CompilerIrInstr
  (begin
    (cbi.compiler-builtin-refresh!)
    (ir.CompilerIrInstr.Call
      reset-var
      cbi.compiler-builtin-id-tl-region-reset
      (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var mark-var))
      (ast.AstType.Unit))))

(define (opt-scratch-reset-mark-instrs [mark-var : i64]) : ir.CompilerIrInstrList
  (ir.compiler-ir-instr-cons
    (opt-scratch-reset-mark-instr mark-var)
    ir.CompilerIrInstrList.Nil))

(define (opt-scratch-reset-reset-instrs [reset-var : i64] [mark-var : i64]) : ir.CompilerIrInstrList
  (ir.compiler-ir-instr-cons
    (opt-scratch-reset-reset-instr reset-var mark-var)
    ir.CompilerIrInstrList.Nil))

(define (opt-scratch-reset-rewrite-block
  [block : ir.CompilerIrBlock]
  [preheader : i64]
  [latch : i64]
  [mark-var : i64]
  [reset-var : i64]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (= label preheader)
        (ir.CompilerIrBlock.Block
          label
          (opt-licm-insert-before-terminator-seq
            (opt-scratch-reset-mark-instrs mark-var)
            instrs))
        (if (= label latch)
          (ir.CompilerIrBlock.Block
            label
            (opt-licm-insert-before-terminator-seq
              (opt-scratch-reset-reset-instrs reset-var mark-var)
              instrs))
          block))]))

(define (opt-scratch-reset-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [preheader : i64]
  [latch : i64]
  [mark-var : i64]
  [reset-var : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-scratch-reset-rewrite-block
          block
          preheader
          latch
          mark-var
          reset-var)
        (opt-scratch-reset-rewrite-blocks
          (__tl-box-place rest)
          preheader
          latch
          mark-var
          reset-var))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-scratch-reset-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        preheader
        latch
        mark-var
        reset-var)]))

(define (opt-scratch-reset-apply-loop
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptScratchResetApplyResult
  (match (opt-scratch-reset-loop-mark-block context loop)
    [(OptScratchResetMarkBlock.No)
      (OptScratchResetApplyResult.Result blocks frame false)]
    [(OptScratchResetMarkBlock.Some mark-block)
      (OptScratchResetApplyResult.Result
        (opt-scratch-reset-rewrite-blocks
          blocks
          mark-block
          (opt-natural-loop-latch loop)
          frame
          (+ frame 1))
        (+ frame 2)
        true)]))

(define (opt-scratch-reset-apply-loops
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loops : OptNaturalLoopList]) : OptScratchResetApplyResult
  (match loops
    [(OptNaturalLoopList.Nil)
      (OptScratchResetApplyResult.Result blocks frame false)]
    [(OptNaturalLoopList.Cons loop rest)
      (if (opt-scratch-loop-eligible? type-segment-bases context blocks loop)
        (opt-scratch-reset-apply-loop context blocks frame loop)
        (opt-scratch-reset-apply-loops
          type-segment-bases
          context
          blocks
          frame
          (__tl-box-place rest)))]))

(define (opt-scratch-reset-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-scratch-reset-apply-loops
            type-segment-bases
            context
            blocks
            frame
            (opt-cfg-natural-loops-with-context blocks context))
            [(OptScratchResetApplyResult.Result next-blocks next-frame changed)
              (if changed
                (let
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)]))
                (OptFunctionCtxResult.Result func context))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-scratch-reset-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-scratch-reset-function-with-context-result
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

(define (opt-scratch-reset-function-unchecked-rewrite
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptLateRewriteResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (<=
        (ir.compiler-ir-block-list-count blocks)
        (opt-heavy-pass-block-limit))
        (let
          [context : OptCfgContext (opt-cfg-context-build blocks)]
          (match (opt-scratch-reset-apply-loops
            type-segment-bases
            context
            blocks
            frame
            (opt-cfg-natural-loops-with-context blocks context))
            [(OptScratchResetApplyResult.Result next-blocks next-frame changed)
              (if changed
                (OptLateRewriteResult.Result
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret-ty
                    next-frame
                    next-blocks)
                  true)
                (OptLateRewriteResult.Result func false))]))
        (OptLateRewriteResult.Result func false))]))

;; --- fused late (post-prune) function pass -----------------------------------
;;
;; The three post-prune rewrites -- scratch-reset, paired bounds and total
;; switch -- are independent per-function maps: none of them reads another
;; function, keeps state between functions, or observes an intermediate whole
;; program list. Run as three whole-program traversals they left three complete
;; generations of rewritten functions plus all of their CFG/loop/verify analysis
;; in the compiler-entry arena, none of it reachable once the next traversal had
;; run.
;;
;; So compose them per function instead, inside one reusable scratch arena that
;; is rewound after every function. Only a function some rewrite actually
;; changed is deep-cloned back into the enclosing arena; an untouched function
;; is already owned there, so it is returned as-is and costs nothing. That keeps
;; the enclosing arena's growth at "the functions this stage rewrote" rather
;; than "three copies of the whole program".
(define (opt-late-function-escaping
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [scratch : i64]) : ir.CompilerIrFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        (match (opt-scratch-reset-function-unchecked-rewrite
          type-segment-bases
          func)
          [(OptLateRewriteResult.Result reset-func reset-changed)
            (match (opt-late-bounds-pair-function-rewrite
              type-segment-bases
              reset-func)
              [(OptLateRewriteResult.Result paired-func paired-changed)
                (match (opt-late-total-switch-function-rewrite
                  type-segment-bases
                  paired-func)
                  [(OptLateRewriteResult.Result switched-func switched-changed)
                    (let
                      [changed : bool
                        (or reset-changed paired-changed switched-changed)]
                      [scratch-head : i64 (arena.tl_arena_current)]
                      (begin
                        (unsafe
                          (arena.tl_arena_set enclosing))
                        (let
                          ;; The rewritten function is built from a mix of
                          ;; scratch nodes and shared input nodes, so escaping
                          ;; it is a full deep clone. An unchanged function
                          ;; never entered the scratch generation at all.
                          [escaped : ir.CompilerIrFunction
                            (if changed
                              (ir.compiler-ir-clone-function
                                pools
                                switched-func)
                              func)]
                          [new-enclosing : i64 (arena.tl_arena_current)]
                          [_restore : unit
                            (unsafe
                              (arena.tl_arena_set scratch-head)
                              (arena.tl_region_reset mark)
                              (arena.tl_arena_set new-enclosing))]
                          escaped)))])])])))))

(define (opt-late-function-list-escaping
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [scratch : i64]) : ir.CompilerIrFunctionList
  (match functions
    [(ir.CompilerIrFunctionList.Nil) (ir.CompilerIrFunctionList.Nil)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (ir.compiler-ir-function-cons
        (opt-late-function-escaping pools type-segment-bases func scratch)
        (opt-late-function-list-escaping
          pools
          type-segment-bases
          (__tl-box-place rest)
          scratch))]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-late-function-list-escaping
        pools
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list seq)
        scratch)]))

(define (opt-late-function-list-with-level
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]
  [level : i64]) : ir.CompilerIrFunctionList
  (if (< level 2)
    functions
    (let
      [scratch : i64 (arena.tl_arena_make)]
      [result : ir.CompilerIrFunctionList
        (opt-late-function-list-escaping
          pools
          type-segment-bases
          functions
          scratch)]
      (begin
        ;; Every function in `result` is owned by the enclosing arena: escaped
        ;; by clone when a rewrite changed it, otherwise never copied out of
        ;; the enclosing arena in the first place. Nothing points into scratch.
        (allocation_profile.compiler-allocation-profile-control!
          2
          "optimize"
          "optimizer-late-scratch"
          scratch)
        (unsafe
          (arena.tl_arena_destroy scratch))
        result))))

(define (opt-scratch-reset-pre-ssa-function-with-context-result
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [context : OptCfgContext
          (opt-cfg-context-build (ir.compiler-ir-clone-block-list pools blocks))]
        [input : ir.CompilerIrFunction
          (ir.CompilerIrFunction.Function name params ret-ty frame blocks)]
        [preheaders-result : OptFunctionCtxResult
          (opt-loop-preheaders-function-with-context-result context false input)]
        [preheaders : ir.CompilerIrFunction
          (match preheaders-result
            [(OptFunctionCtxResult.Result f _) f])]
        [preheaders-context : OptCfgContext
          (match preheaders-result
            [(OptFunctionCtxResult.Result _ ctx) ctx])]
        (opt-scratch-reset-function-with-context-result
          type-segment-bases
          preheaders-context
          false
          preheaders))]))

;; --- block-local redundant-load CSE -----------------------------------------
;;
;; GAP4: alias-granular invalidation + store-to-load forwarding + canonical
;; address keys.
;;
;; The original pass keyed loads by raw address VALUE (the gep temp) and wiped
;; the whole table on ANY memory write. Three upgrades, shared with the
;; cross-block pass below:
;;
;; 1. CANONICAL KEYS: every array/string access re-emits a fresh descriptor
;;    gep (`Gep arr 0/1 ty`), and the only pass that unified those geps (the
;;    global GVN) runs LAST in the optimize iteration (and needs a full SSA
;;    verify), so load CSE never saw two repeats under one key. A load whose
;;    address var is a CONST-offset gep of base B is now keyed structurally as
;;    (B, byte-offset, load-type); the byte offset is offset*type-size exactly
;;    as the backend scales gep displacements. Base redefinition drops the
;;    entries (extended invalidation below), so var identity == value identity
;;    for the key's lifetime. A gep whose base is a GLOBAL operand rather than a
;;    var (`gep (Global g) k`, the shape every access to a global array/string
;;    emits, or `gep (GlobalAddr g) k`) has no base var to key on at all; those
;;    key as (global symbol, byte-offset, load-type, value-base?) off the
;;    separate OptLoadGlobalBases map, whose write-clearing lifetime is what
;;    makes the `Global` spelling sound. Chains fold: a const-offset gep of a
;;    const-offset gep sums the byte offsets and keys identically to the flat
;;    gep, while a VARIABLE offset ends the resolution (the scaled key needs a
;;    var base, so a global-based index gep keeps its own temp's raw identity).
;;
;; 2. ALIAS-GRANULAR INVALIDATION: a StorePtr/CopyBytes drops only MAY-ALIAS
;;    entries. Sound keep rules (everything else is dropped):
;;      - an ELEMENT store (pointer derived from a loaded array/string data
;;        pointer) keeps DESCRIPTOR-FIELD entries: data buffers never contain
;;        descriptor headers (descriptors are their own allocations; buffer
;;        elements are handles/scalars/inline structs) -- the LICM
;;        element-only-store proof, ported.
;;      - a DESCRIPTOR-FIELD store keeps element entries (same disjointness,
;;        mirrored) and same-base entries at provably disjoint byte ranges
;;        (two fields of one object cannot overlap).
;;      - a generic FIELD store (const-offset gep off a non-descriptor base)
;;        keeps only same-base disjoint-range entries: two handles may name
;;        the same object, and structs can live inline inside array buffers,
;;        so neither element nor other-base entries are safe.
;;    Alias facts (OptAliasFacts) are threaded exactly as before; they gate
;;    nothing here and keep their conservative store-clears semantics.
;;
;; 3. STORE-TO-LOAD FORWARDING: a classified StorePtr binds its (address, type)
;;    key to a canonical stored value, so a later same-key load becomes a Mov
;;    (the coalescer eats the copy; literal stores forward the literal). 8-byte
;;    values forward directly. Sub-word stores forward only normalized
;;    constants or values proven to have come from a same-type load, because
;;    arbitrary sub-word IR vars are not guaranteed high-bit-canonical while an
;;    actual load re-canonicalizes.
;;
;; Location kinds are tracked per pointer var (OptLoadPtrKinds); the
;; header-typedness of gep bases comes from a per-function pre-pass
;; (OptLoadHeaderSet) marking vars that are array/string descriptor handles at
;; EVERY def site (multi-def vars with disagreeing types are poisoned -- the
;; block-local pass runs pre-SSA).
;; Function-constant header-typed var set: var -> 1 (array/string handle at
;; every typed def) or 2 (poisoned: any non-handle or untyped def).
(defenum OptLoadHeaderSet
  (Sparse opt_i64_i64_map.Map)
  (Dense (__tl_dyn-array i64)))

(define (opt-load-header-set-empty) : OptLoadHeaderSet
  (OptLoadHeaderSet.Sparse (opt_i64_i64_map.with-capacity 17)))

(define (opt-load-header-set-fill-zero!
  [items : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (set! (array-ref items index) 0)
      (opt-load-header-set-fill-zero! items (+ index 1)))))

(define (opt-load-header-set-with-size [count : i64]) : OptLoadHeaderSet
  (let
    [items : (__tl_dyn-array i64) (array.make-array i64 count)]
    (begin
      (opt-load-header-set-fill-zero! items 0)
      (OptLoadHeaderSet.Dense items))))

(define (opt-load-header-set-mark
  [set : OptLoadHeaderSet (:consume)]
  [var : i64]
  [header? : bool]) : OptLoadHeaderSet
  (match set
    [(OptLoadHeaderSet.Sparse map)
      (if header?
        (if (opt_i64_i64_map.contains? (& map) var)
          set
          (let
            [out : opt_i64_i64_map.Map map]
            (begin
              (opt_i64_i64_map.insert-ref! (&mut out) var 1)
              (OptLoadHeaderSet.Sparse out))))
        (let
          [out : opt_i64_i64_map.Map map]
          (begin
            (opt_i64_i64_map.insert-ref! (&mut out) var 2)
            (OptLoadHeaderSet.Sparse out))))]
    [(OptLoadHeaderSet.Dense items)
      (if (or (< var 0) (>= var (array-length items)))
        set
        (begin
          (if header?
            (if (= (array-ref items var) 0)
              (set! (array-ref items var) 1)
              unit)
            (set! (array-ref items var) 2))
          set))]))

(define (opt-load-header-var? [set : OptLoadHeaderSet] [var : i64]) : bool
  (match set
    [(OptLoadHeaderSet.Sparse map)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound value) (= value 1)]
        [(opt_i64_i64_map.LookupMissing) false])]
    [(OptLoadHeaderSet.Dense items)
      (if (or (< var 0) (>= var (array-length items)))
        false
        (= (array-ref items var) 1))]))

;; A checked reference to an array/string descriptor addresses that descriptor
;; directly, so its parameter var is a header base for GEP/load classification
;; just like a by-value descriptor var.
(define (opt-load-header-param-type?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Ref _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [(ast.AstType.MutRef _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [(ast.AstType.Region _ inner)
      (opt-load-header-param-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [_ (opt-licm-array-header-type? type-segment-bases ty)]))

(define (opt-load-header-set-add-param
  [type-segment-bases : i64]
  [param : ir.CompilerIrParam]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (match param
    [(ir.CompilerIrParam.Param _ ty var)
      (opt-load-header-set-mark
        set
        var
        (opt-load-header-param-type? type-segment-bases ty))]))

(define (opt-load-header-set-add-param-seq
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamSeq]
  [set : OptLoadHeaderSet (:consume)]) : OptLoadHeaderSet
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-param-seq-count params)]
    [work : OptLoadHeaderSet set]
    (begin
      (while (< index count)
        (begin
          (set!
            work
            (opt-load-header-set-add-param
              type-segment-bases
              (ir.compiler-ir-param-seq-ref params index)
              work))
          (set! index (+ index 1))))
      work)))

(define (opt-load-header-set-add-params
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (match params
    [(ir.CompilerIrParamList.Nil) set]
    [(ir.CompilerIrParamList.Array seq)
      (opt-load-header-set-add-param-seq type-segment-bases seq set)]
    [(ir.CompilerIrParamList.Cons param rest)
      (opt-load-header-set-add-params
        type-segment-bases
        (__tl-box-place rest)
        (opt-load-header-set-add-param type-segment-bases param set))]))

;; Defs with a declared result type mark it; every OTHER defining instruction
;; poisons its dst (its handle-ness is unknown).
(define (opt-load-header-set-add-instr
  [type-segment-bases : i64]
  [set : OptLoadHeaderSet]
  [instr : ir.CompilerIrInstr]) : OptLoadHeaderSet
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(ir.CompilerIrInstr.Load dst _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(ir.CompilerIrInstr.Call dst _ _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(ir.CompilerIrInstr.Phi dst _ ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases ty))]
    [(ir.CompilerIrInstr.Cast dst _ _ to-ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases to-ty))]
    [(ir.CompilerIrInstr.Bitcast dst _ _ to-ty)
      (opt-load-header-set-mark
        set
        dst
        (opt-licm-array-header-type? type-segment-bases to-ty))]
    [_
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst) (opt-load-header-set-mark set dst false)]
        [(option_i64.None) set])]))

(define (opt-load-header-set-add-instr-seq-from
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (let
    [cursor : i64 index]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [work : OptLoadHeaderSet set]
    (begin
      (while (< cursor count)
        (begin
          (set!
            work
            (opt-load-header-set-add-instr
              type-segment-bases
              work
              (ir.compiler-ir-instr-seq-ref instrs cursor)))
          (set! cursor (+ cursor 1))))
      work)))

(define (opt-load-header-set-add-block-seq
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockSeq]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [work : OptLoadHeaderSet set]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks index)
            [(ir.CompilerIrBlock.Block _ instrs)
              (set!
                work
                (opt-load-header-set-add-instr-seq-from
                  type-segment-bases
                  instrs
                  0
                  work))])
          (set! index (+ index 1))))
      work)))

(define (opt-load-header-set-add-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [set : OptLoadHeaderSet]) : OptLoadHeaderSet
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-load-header-set-add-blocks
            type-segment-bases
            (__tl-box-place rest)
            (opt-load-header-set-add-instr-seq-from
              type-segment-bases
              instrs
              0
              set))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-header-set-add-block-seq type-segment-bases seq set)]))

(define (opt-load-header-set-from-function
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptLoadHeaderSet
  (opt-load-header-set-add-blocks
    type-segment-bases
    blocks
    (opt-load-header-set-add-params
      type-segment-bases
      params
      (opt-load-header-set-empty))))

(define (opt-load-header-set-from-function-with-size
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : OptLoadHeaderSet
  (opt-load-header-set-add-blocks
    type-segment-bases
    blocks
    (opt-load-header-set-add-params
      type-segment-bases
      params
      (opt-load-header-set-with-size frame))))

(define opt-load-cse-table-cap-floor : i64
  128)
(define opt-load-cse-kinds-cap-floor : i64
  96)
(define opt-load-cse-cap-hard-max : i64
  2048)
(define opt-load-cse-cap-scale-divisor : i64
  2)

(define (opt-load-cse-scaled-cap [floor : i64] [instr-count : i64]) : i64
  (let
    [from-size : i64 (/ instr-count opt-load-cse-cap-scale-divisor)]
    [with-floor : i64
      (if (> from-size floor)
        from-size
        floor)]
    (if (> with-floor opt-load-cse-cap-hard-max)
      opt-load-cse-cap-hard-max
      with-floor)))

(define (opt-load-cse-table-cap-for-size [instr-count : i64]) : i64
  (opt-load-cse-scaled-cap opt-load-cse-table-cap-floor instr-count))

(define (opt-load-cse-kinds-cap-for-size [instr-count : i64]) : i64
  (opt-load-cse-scaled-cap opt-load-cse-kinds-cap-floor instr-count))

;; Byte width of a scalar Load/StorePtr and the gep displacement scale. MUST
;; mirror compiler-backend-type-size (gep disp = offset * this); 0 means
;; zero-sized/unclassifiable and callers must treat the location as unknown.
(define (opt-load-loc-type-size [type-segment-bases : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.Char) 1]
    [(ast.AstType.Unit) 0]
    [(ast.AstType.Never) 0]
    [(ast.AstType.Expr) 0]
    [(ast.AstType.ExprList) 0]
    [(ast.AstType.Func _ _) 8]
    [(ast.AstType.Tuple _) 8]
    [(ast.AstType.Array _ _) 8]
    [(ast.AstType.DynArray _) 8]
    [(ast.AstType.Slice _) 0]
    [(ast.AstType.Box _) 8]
    [(ast.AstType.Ptr _) 8]
    [(ast.AstType.MutPtr _) 8]
    [(ast.AstType.Ref _ inner)
      (if (opt-reference-to-slice? type-segment-bases inner)
        16
        8)]
    [(ast.AstType.MutRef _ inner)
      (if (opt-reference-to-slice? type-segment-bases inner)
        16
        8)]
    [(ast.AstType.Region _ inner)
      (opt-load-loc-type-size
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [(ast.AstType.Enum _) 8]
    [(ast.AstType.EnumArgs _ _) 8]
    [(ast.AstType.Struct _) 8]
    [(ast.AstType.StructArgs _ _) 8]
    [(ast.AstType.String) 8]
    [(ast.AstType.Str) 8]
    [(ast.AstType.Bytes) 8]
    [(ast.AstType.Var _) 8]
    [(ast.AstType.VarArgs _ _) 8]
    [(ast.AstType.Consume inner)
      (opt-load-loc-type-size
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]))

;; What memory a pointer-valued var addresses:
;;   Element          -- points at/into some array/string DATA BUFFER (the
;;                       loaded data pointer, or any gep derived from one).
;;   Field B off w h  -- exactly (value of var B) + off bytes, w bytes wide at
;;                       binding time; h = B is a descriptor handle, so the
;;                       address lies inside a descriptor allocation.
;; A kind is a property of the pointer VALUE, so it survives calls and stores;
;; it dies only when its var (or a referenced base var) is redefined.
(defenum OptLoadLocKind
  (OptLoadLocUnknown)
  (OptLoadLocElement)
  (OptLoadLocField i64 i64 i64 bool)
  ;; A variable-index element pointer: base var, index var, element width,
  ;; header-typed base. Lets identical index geps of the same array share one
  ;; load key (the constant-offset Field cannot represent a var offset).
  (OptLoadLocScaledField i64 i64 i64 bool))

(define opt-load-loc-kind-base-scale : i64
  4294967296)
(define opt-load-loc-kind-offset-scale : i64
  4096)
(define opt-load-loc-kind-header-scale : i64
  4)
(define opt-load-loc-kind-width-scale : i64
  8)
(define opt-load-loc-field-base-limit : i64
  1073741824)
(define opt-load-loc-field-offset-limit : i64
  1048576)
(define opt-load-loc-field-width-limit : i64
  512)

;; Encoding: 0 unknown, 1 element, field = 2 + h*4 + w*8 + off*4096 + B*2^32
;; (always even), scaled-field = 3 + h*4 + w*8 + idx*4096 + B*2^32 (always odd).
(define (opt-load-loc-kind-encode [kind : OptLoadLocKind]) : i64
  (match kind
    [(OptLoadLocUnknown) 0]
    [(OptLoadLocElement) 1]
    [(OptLoadLocField base off width header?)
      (+
        2
        (+
          (if header?
            opt-load-loc-kind-header-scale
            0)
          (+
            (* width opt-load-loc-kind-width-scale)
            (+
              (* off opt-load-loc-kind-offset-scale)
              (* base opt-load-loc-kind-base-scale)))))]
    [(OptLoadLocScaledField base index width header?)
      (+
        3
        (+
          (if header?
            opt-load-loc-kind-header-scale
            0)
          (+
            (* width opt-load-loc-kind-width-scale)
            (+
              (* index opt-load-loc-kind-offset-scale)
              (* base opt-load-loc-kind-base-scale)))))]))

(define (opt-load-loc-kind-decode [value : i64]) : OptLoadLocKind
  (cond
    [(= value 0) (OptLoadLocUnknown)]
    [(= value 1) (OptLoadLocElement)]
    [(= (% value 2) 1)
      (OptLoadLocScaledField
        (/ value opt-load-loc-kind-base-scale)
        (%
          (/ value opt-load-loc-kind-offset-scale)
          opt-load-loc-field-offset-limit)
        (%
          (/ value opt-load-loc-kind-width-scale)
          opt-load-loc-field-width-limit)
        (= (% (/ value opt-load-loc-kind-header-scale) 2) 1))]
    [else
      (OptLoadLocField
        (/ value opt-load-loc-kind-base-scale)
        (%
          (/ value opt-load-loc-kind-offset-scale)
          opt-load-loc-field-offset-limit)
        (%
          (/ value opt-load-loc-kind-width-scale)
          opt-load-loc-field-width-limit)
        (= (% (/ value opt-load-loc-kind-header-scale) 2) 1))]))

;; Range-checked Field constructor: out-of-range components degrade to Unknown
;; (the encoding packs base<2^30, off<2^20, 0<w<512).
(define (opt-load-loc-field-checked
  [_profile-state : profile_state.CompilerProfileMetrics]
  [base : i64]
  [off : i64]
  [width : i64]
  [header? : bool]) : OptLoadLocKind
  (if (and
    (>= base 0)
    (< base opt-load-loc-field-base-limit)
    (>= off 0)
    (< off opt-load-loc-field-offset-limit)
    (> width 0)
    (< width opt-load-loc-field-width-limit))
    (OptLoadLocField base off width header?)
    (begin
      (cfg
        compile-profile
        (compiler-opt-load-cse-profile-note-field-key-drop _profile-state))
      (OptLoadLocUnknown))))

;; Range-checked ScaledField constructor (same packing limits, index in the
;; offset slot).
(define (opt-load-loc-scaled-field-checked
  [_profile-state : profile_state.CompilerProfileMetrics]
  [base : i64]
  [index : i64]
  [width : i64]
  [header? : bool]) : OptLoadLocKind
  (if (and
    (>= base 0)
    (< base opt-load-loc-field-base-limit)
    (>= index 0)
    (< index opt-load-loc-field-offset-limit)
    (> width 0)
    (< width opt-load-loc-field-width-limit))
    (OptLoadLocScaledField base index width header?)
    (begin
      (cfg
        compile-profile
        (compiler-opt-load-cse-profile-note-field-key-drop _profile-state))
      (OptLoadLocUnknown))))

;; Pointer-kind env: var -> encoded kind, plus a base-var refcount so the
;; common no-references case of a base redefinition skips the sweep. Cross-block
;; GVN uses cloneable sparse maps. The block-local pipeline uses one frame-sized
;; dense workspace per function; generation stamps reset it between blocks in
;; O(1), while an active-var vector keeps the rare base-invalidation sweep
;; proportional to live facts rather than frame size.
(defstruct OptLoadKindsDenseWork
  (kinds (__tl_dyn-array i64))
  (kind-stamps (__tl_dyn-array i64))
  (positions (__tl_dyn-array i64))
  (refs (__tl_dyn-array i64))
  (ref-stamps (__tl_dyn-array i64))
  (active (__tl_dyn-array i64)))

(defenum OptLoadPtrKinds
  (Sparse opt_i64_i64_map.Map opt_i64_i64_map.Map i64)
  (Dense OptLoadKindsDenseWork i64 i64 i64))

;; The stamp arrays are read, never a source of truth on their own: a slot is
;; live only when its stamp equals the CURRENT generation. `make-array i64`
;; hands back all-zero storage and every generation handed out is >= 1, so the
;; fresh arrays already read as "nothing is live" and an explicit zeroing pass
;; only repeats what the allocation just did.
(define (opt-load-kinds-dense-work-with-size [count : i64]) : OptLoadKindsDenseWork
  (OptLoadKindsDenseWork
    (array.make-array i64 count)
    (array.make-array i64 count)
    (array.make-array i64 count)
    (array.make-array i64 count)
    (array.make-array i64 count)
    (array.make-array i64 count)))

(define (opt-load-kinds-dense-state
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [cap : i64]) : OptLoadPtrKinds
  (OptLoadPtrKinds.Dense work generation 0 cap))

(define (opt-load-kinds-set-cap [kinds : OptLoadPtrKinds] [cap : i64]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map refs _) (OptLoadPtrKinds.Sparse map refs cap)]
    [(OptLoadPtrKinds.Dense work generation len _)
      (OptLoadPtrKinds.Dense work generation len cap)]))

(define (opt-load-kinds-empty-with-cap
  [_profile-state : profile_state.CompilerProfileMetrics]
  [cap : i64]) : OptLoadPtrKinds
  (begin
    (cfg
      compile-profile
      (compiler-opt-load-cse-profile-note-kinds-cap _profile-state cap))
    (OptLoadPtrKinds.Sparse
      (opt_i64_i64_map.with-capacity 17)
      (opt_i64_i64_map.with-capacity 17)
      cap)))

(define (opt-load-kinds-empty) : OptLoadPtrKinds
  (OptLoadPtrKinds.Sparse
    (opt_i64_i64_map.with-capacity 17)
    (opt_i64_i64_map.with-capacity 17)
    opt-load-cse-kinds-cap-floor))

(define (opt-load-kinds-lookup [kinds : OptLoadPtrKinds] [var : i64]) : OptLoadLocKind
  (match kinds
    [(OptLoadPtrKinds.Sparse map _ _)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound value) (opt-load-loc-kind-decode value)]
        [(opt_i64_i64_map.LookupMissing) (OptLoadLocUnknown)])]
    [(OptLoadPtrKinds.Dense work generation _ _)
      (if (or
        (< var 0)
        (>= var (array-length work.kinds))
        (not (= (array-ref work.kind-stamps var) generation)))
        (OptLoadLocUnknown)
        (opt-load-loc-kind-decode (array-ref work.kinds var)))]))

(define (opt-load-kinds-ref-count [refs : opt_i64_i64_map.Map] [base : i64]) : i64
  (opt_i64_i64_map.get-value-or (& refs) base 0))

(define (opt-load-kinds-dense-ref-count
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [base : i64]) : i64
  (if (or
    (< base 0)
    (>= base (array-length work.refs))
    (not (= (array-ref work.ref-stamps base) generation)))
    0
    (array-ref work.refs base)))

(define (opt-load-kinds-dense-ref-add!
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [base : i64]
  [delta : i64]) : unit
  (if (or (< base 0) (>= base (array-length work.refs)))
    unit
    (let
      [stamps : (__tl_dyn-array i64) work.ref-stamps]
      [refs : (__tl_dyn-array i64) work.refs]
      [old : i64
        (if (= (array-ref stamps base) generation)
          (array-ref refs base)
          0)]
      (begin
        (set! (array-ref stamps base) generation)
        (set! (array-ref refs base) (+ old delta))))))

(define (opt-load-kinds-ref-add
  [refs : opt_i64_i64_map.Map (:consume)]
  [base : i64]
  [delta : i64]) : opt_i64_i64_map.Map
  (let
    [next-count : i64 (+ (opt-load-kinds-ref-count refs base) delta)]
    [out : opt_i64_i64_map.Map refs]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) base next-count)
      out)))

;; Adjust the refcount of every var a kind references (Field: its base;
;; ScaledField: base and index). Keeps the base-reference sweep correct for
;; redefinitions of either.
(define (opt-load-kinds-ref-add-kind
  [refs : opt_i64_i64_map.Map]
  [kind : OptLoadLocKind]
  [delta : i64]) : opt_i64_i64_map.Map
  (match kind
    [(OptLoadLocField base _ _ _) (opt-load-kinds-ref-add refs base delta)]
    [(OptLoadLocScaledField base index _ _)
      (opt-load-kinds-ref-add
        (opt-load-kinds-ref-add refs base delta)
        index
        delta)]
    [_ refs]))

(define (opt-load-kinds-dense-ref-add-kind!
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [kind : OptLoadLocKind]
  [delta : i64]) : unit
  (match kind
    [(OptLoadLocField base _ _ _)
      (opt-load-kinds-dense-ref-add! work generation base delta)]
    [(OptLoadLocScaledField base index _ _)
      (begin
        (opt-load-kinds-dense-ref-add! work generation base delta)
        (opt-load-kinds-dense-ref-add! work generation index delta))]
    [_ unit]))

;; Remove a var's binding (refcount-adjusting). Absent vars return unchanged.
(define (opt-load-kinds-remove [kinds : OptLoadPtrKinds (:consume)] [var : i64]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map refs cap)
      (match (opt_i64_i64_map.get (& map) var)
        [(opt_i64_i64_map.LookupFound old-value)
          (let
            [map2 : opt_i64_i64_map.Map
              (let
                [out : opt_i64_i64_map.Map map]
                (begin
                  (opt_i64_i64_map.remove-ref! (&mut out) var)
                  out))]
            [refs2 : opt_i64_i64_map.Map
              (opt-load-kinds-ref-add-kind
                refs
                (opt-load-loc-kind-decode old-value)
                (- 0 1))]
            (OptLoadPtrKinds.Sparse map2 refs2 cap))]
        [(opt_i64_i64_map.LookupMissing) kinds])]
    [(OptLoadPtrKinds.Dense work generation len cap)
      (if (or
        (< var 0)
        (>= var (array-length work.kinds))
        (not (= (array-ref work.kind-stamps var) generation)))
        kinds
        (let
          [old-value : i64 (array-ref work.kinds var)]
          [pos : i64 (array-ref work.positions var)]
          [last-pos : i64 (- len 1)]
          [last-var : i64 (array-ref work.active last-pos)]
          (begin
            (opt-load-kinds-dense-ref-add-kind!
              work
              generation
              (opt-load-loc-kind-decode old-value)
              (- 0 1))
            (if (not (= pos last-pos))
              (begin
                (set! (array-ref work.active pos) last-var)
                (set! (array-ref work.positions last-var) pos))
              unit)
            (set! (array-ref work.kind-stamps var) 0)
            (OptLoadPtrKinds.Dense work generation last-pos cap))))]))

;; Bind var -> kind. Unknown removes; the env is size-capped (conservative:
;; new pointers just stay unclassified once the cap is hit).
(define (opt-load-kinds-bind
  [_profile-state : profile_state.CompilerProfileMetrics]
  [kinds : OptLoadPtrKinds]
  [var : i64]
  [kind : OptLoadLocKind]) : OptLoadPtrKinds
  (match kind
    [(OptLoadLocUnknown) (opt-load-kinds-remove kinds var)]
    [_
      (let
        [removed : OptLoadPtrKinds (opt-load-kinds-remove kinds var)]
        (match removed
          [(OptLoadPtrKinds.Sparse map refs cap)
            (let
              [current-len : i64 (opt_i64_i64_map.len (& map))]
              (begin
                (cfg
                  compile-profile
                  (compiler-opt-load-cse-profile-note-kinds-size
                    _profile-state
                    current-len))
                (cfg
                  compile-profile
                  (compiler-opt-load-cse-profile-note-kinds-cap
                    _profile-state
                    cap))
                (if (>= current-len cap)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-opt-load-cse-profile-note-kinds-cap-hit
                        _profile-state))
                    removed)
                  (let
                    [refs2 : opt_i64_i64_map.Map
                      (opt-load-kinds-ref-add-kind refs kind 1)]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-opt-load-cse-profile-note-kinds-size
                          _profile-state
                          (+ current-len 1)))
                      (OptLoadPtrKinds.Sparse
                        (let
                          [out : opt_i64_i64_map.Map map]
                          (begin
                            (opt_i64_i64_map.insert-ref!
                              (&mut out)
                              var
                              (opt-load-loc-kind-encode kind))
                            out))
                        refs2
                        cap))))))]
          [(OptLoadPtrKinds.Dense work generation len cap)
            (if (or
              (< var 0)
              (>= var (array-length work.kinds))
              (>= len cap)
              (>= len (array-length work.active)))
              (begin
                (if (or (< var 0) (>= var (array-length work.kinds)))
                  unit
                  (cfg
                    compile-profile
                    (compiler-opt-load-cse-profile-note-kinds-cap-hit
                      _profile-state)))
                removed)
              (begin
                (opt-load-kinds-dense-ref-add-kind! work generation kind 1)
                (set! (array-ref work.active len) var)
                (set! (array-ref work.positions var) len)
                (set!
                  (array-ref work.kinds var)
                  (opt-load-loc-kind-encode kind))
                (set! (array-ref work.kind-stamps var) generation)
                (cfg
                  compile-profile
                  (compiler-opt-load-cse-profile-note-kinds-size
                    _profile-state
                    (+ len 1)))
                (OptLoadPtrKinds.Dense work generation (+ len 1) cap)))]))]))

;; Redefinition of `var`: drop its own binding, and (only when some Field kind
;; references it as a base -- refcount-gated) sweep out every binding whose
;; base is `var`, because base-var identity must mean base-VALUE identity.
(define (opt-load-kinds-dense-drop-base-from
  [kinds : OptLoadPtrKinds (:consume)]
  [base : i64]
  [index : i64]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Dense work _ len _)
      (if (>= index len)
        kinds
        (let
          [bound-var : i64 (array-ref work.active index)]
          (match (opt-load-kinds-lookup kinds bound-var)
            [(OptLoadLocField found-base _ _ _)
              (if (= found-base base)
                (opt-load-kinds-dense-drop-base-from
                  (opt-load-kinds-remove kinds bound-var)
                  base
                  index)
                (opt-load-kinds-dense-drop-base-from kinds base (+ index 1)))]
            [(OptLoadLocScaledField found-base found-index _ _)
              (if (or (= found-base base) (= found-index base))
                (opt-load-kinds-dense-drop-base-from
                  (opt-load-kinds-remove kinds bound-var)
                  base
                  index)
                (opt-load-kinds-dense-drop-base-from kinds base (+ index 1)))]
            [_ (opt-load-kinds-dense-drop-base-from kinds base (+ index 1))])))]
    [_ kinds]))

(define (opt-load-kinds-invalidate-def
  [kinds : OptLoadPtrKinds (:consume)]
  [var : i64]) : OptLoadPtrKinds
  (let
    [removed : OptLoadPtrKinds (opt-load-kinds-remove kinds var)]
    (match removed
      [(OptLoadPtrKinds.Sparse map refs cap)
        (if (<= (opt-load-kinds-ref-count refs var) 0)
          removed
          (let
            [capacity : i64 (opt_i64_i64_map.capacity (& map))]
            [out : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
            [out-refs : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
            [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (opt_i64_i64_map.entry-at (& map) i)
                    [(opt_i64_i64_map.EntrySome bound-var value)
                      (let
                        [drop? : bool
                          (match (opt-load-loc-kind-decode value)
                            [(OptLoadLocField base _ _ _) (= base var)]
                            [(OptLoadLocScaledField base index _ _)
                              (or (= base var) (= index var))]
                            [_ false])]
                        (if drop?
                          unit
                          (begin
                            (opt_i64_i64_map.insert-ref!
                              (&mut out)
                              bound-var
                              value)
                            (set!
                              out-refs
                              (opt-load-kinds-ref-add-kind
                                out-refs
                                (opt-load-loc-kind-decode value)
                                1)))))]
                    [(opt_i64_i64_map.EntryNone) unit])
                  (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
              (OptLoadPtrKinds.Sparse out out-refs cap))))]
      [(OptLoadPtrKinds.Dense work generation _ _)
        (if (<= (opt-load-kinds-dense-ref-count work generation var) 0)
          removed
          (opt-load-kinds-dense-drop-base-from removed var 0))])))

(define (opt-load-kinds-dense-clone-from
  [profile-state : profile_state.CompilerProfileMetrics]
  [kinds : OptLoadPtrKinds]
  [index : i64]
  [out : OptLoadPtrKinds (:consume)]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Dense work _ len _)
      (if (>= index len)
        out
        (let
          [var : i64 (array-ref work.active index)]
          (opt-load-kinds-dense-clone-from
            profile-state
            kinds
            (+ index 1)
            (opt-load-kinds-bind
              profile-state
              out
              var
              (opt-load-kinds-lookup kinds var)))))]
    [_ out]))

(define (opt-load-kinds-clone
  [profile-state : profile_state.CompilerProfileMetrics]
  [kinds : OptLoadPtrKinds]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map refs cap)
      (let
        [out : opt_i64_i64_map.Map
          (opt_i64_i64_map.with-capacity
            (+ (* (opt_i64_i64_map.len (& map)) 2) 17))]
        [out-refs : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 17)]
        [capacity : i64 (opt_i64_i64_map.capacity (& map))]
        [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (opt_i64_i64_map.entry-at (& map) i)
                [(opt_i64_i64_map.EntrySome var value)
                  (begin
                    (opt_i64_i64_map.insert-ref! (&mut out) var value)
                    (set!
                      out-refs
                      (opt-load-kinds-ref-add-kind
                        out-refs
                        (opt-load-loc-kind-decode value)
                        1)))]
                [(opt_i64_i64_map.EntryNone) unit])
              (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
          (OptLoadPtrKinds.Sparse out out-refs cap)))]
    [(OptLoadPtrKinds.Dense _ _ _ cap)
      (opt-load-kinds-dense-clone-from
        profile-state
        kinds
        0
        (opt-load-kinds-empty-with-cap profile-state cap))]))

;; Control-flow join: keep only bindings identical on both edges.
(define (opt-load-kinds-intersect
  [profile-state : profile_state.CompilerProfileMetrics]
  [a : OptLoadPtrKinds]
  [b : OptLoadPtrKinds]) : OptLoadPtrKinds
  (match a
    [(OptLoadPtrKinds.Sparse amap _ acap)
      (match b
        [(OptLoadPtrKinds.Sparse bmap _ _)
          (let
            [out : OptLoadPtrKinds
              (opt-load-kinds-empty-with-cap profile-state acap)]
            [capacity : i64 (opt_i64_i64_map.capacity (& amap))]
            [i : i64 (opt_i64_i64_map.next-occupied (& amap) 0)]
            (begin
              (while (< i capacity)
                (begin
                  (match (opt_i64_i64_map.entry-at (& amap) i)
                    [(opt_i64_i64_map.EntrySome var value)
                      (match (opt_i64_i64_map.get (& bmap) var)
                        [(opt_i64_i64_map.LookupFound bvalue)
                          (if (= value bvalue)
                            (set!
                              out
                              (opt-load-kinds-bind
                                profile-state
                                out
                                var
                                (opt-load-loc-kind-decode value)))
                            unit)]
                        [(opt_i64_i64_map.LookupMissing) unit])]
                    [(opt_i64_i64_map.EntryNone) unit])
                  (set! i (opt_i64_i64_map.next-occupied (& amap) (+ i 1)))))
              out))]
        [(OptLoadPtrKinds.Dense _ _ _ _)
          (opt-load-kinds-intersect
            profile-state
            a
            (opt-load-kinds-clone profile-state b))])]
    [(OptLoadPtrKinds.Dense _ _ _ _)
      (opt-load-kinds-intersect
        profile-state
        (opt-load-kinds-clone profile-state a)
        b)]))

;; A (var, kind) binding that no unseen back edge can kill: the var and every
;; var its kind references are single-source, so nothing anywhere redefines
;; them and the value property is loop-invariant.
(define (opt-load-kind-binding-gvn-stable?
  [sources : opt_i64_i64_map.Map]
  [var : i64]
  [kind : OptLoadLocKind]) : bool
  (and
    (opt-gvn-stable-var? sources var)
    (match kind
      [(OptLoadLocUnknown) false]
      [(OptLoadLocElement) true]
      [(OptLoadLocField base _ _ _) (opt-gvn-stable-var? sources base)]
      [(OptLoadLocScaledField base index _ _)
        (and
          (opt-gvn-stable-var? sources base)
          (opt-gvn-stable-var? sources index))])))

;; Loop-header join when a predecessor is still unprocessed in the RPO sweep
;; (a back edge): the load table and alias facts must be dropped -- memory
;; contents and non-SSA redefinitions along the unseen edge are unknown -- but
;; a single-source var's kind is a property of its VALUE, which the back edge
;; cannot change, so those bindings carry into the loop.
(define (opt-load-kinds-filter-stable
  [profile-state : profile_state.CompilerProfileMetrics]
  [kinds : OptLoadPtrKinds]
  [sources : opt_i64_i64_map.Map]) : OptLoadPtrKinds
  (match kinds
    [(OptLoadPtrKinds.Sparse map _ cap)
      (let
        [out : OptLoadPtrKinds
          (opt-load-kinds-empty-with-cap profile-state cap)]
        [capacity : i64 (opt_i64_i64_map.capacity (& map))]
        [i : i64 (opt_i64_i64_map.next-occupied (& map) 0)]
        (begin
          (while (< i capacity)
            (begin
              (match (opt_i64_i64_map.entry-at (& map) i)
                [(opt_i64_i64_map.EntrySome var value)
                  (let
                    [kind : OptLoadLocKind (opt-load-loc-kind-decode value)]
                    (if (opt-load-kind-binding-gvn-stable? sources var kind)
                      (set!
                        out
                        (opt-load-kinds-bind profile-state out var kind))
                      unit))]
                [(opt_i64_i64_map.EntryNone) unit])
              (set! i (opt_i64_i64_map.next-occupied (& map) (+ i 1)))))
          out))]
    [(OptLoadPtrKinds.Dense _ _ _ _)
      (opt-load-kinds-filter-stable
        profile-state
        (opt-load-kinds-clone profile-state kinds)
        sources)]))

;; Kind transfer for one instruction: redefinitions first (own binding + the
;; base-reference sweep), then the deriving arms.
(define (opt-load-kinds-step
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [kinds : OptLoadPtrKinds]
  [hs : OptLoadHeaderSet]
  [instr : ir.CompilerIrInstr]) : OptLoadPtrKinds
  (let
    [invalidated : OptLoadPtrKinds
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst) (opt-load-kinds-invalidate-def kinds dst)]
        [(option_i64.None) kinds])]
    (match instr
      [(ir.CompilerIrInstr.Gep dst base offset ty)
        (match base
          [(ir.CompilerIrValue.Var bvar)
            (match (opt-load-kinds-lookup invalidated bvar)
              [(OptLoadLocElement)
                (match offset
                  ;; A variable index into an element base yields a scaled
                  ;; element pointer, so identical index geps of the same
                  ;; array share one load key.
                  [(ir.CompilerIrValue.Var index-var)
                    (opt-load-kinds-bind
                      profile-state
                      invalidated
                      dst
                      (opt-load-loc-scaled-field-checked
                        profile-state
                        bvar
                        index-var
                        (opt-load-loc-type-size type-segment-bases ty)
                        false))]
                  [_
                    (opt-load-kinds-bind
                      profile-state
                      invalidated
                      dst
                      (OptLoadLocElement))])]
              [(OptLoadLocField b0 o0 _ h0)
                (match offset
                  [(ir.CompilerIrValue.I64 k)
                    (let
                      [sz : i64 (opt-load-loc-type-size type-segment-bases ty)]
                      (if (> sz 0)
                        (opt-load-kinds-bind
                          profile-state
                          invalidated
                          dst
                          (opt-load-loc-field-checked
                            profile-state
                            b0
                            (+ o0 (* k sz))
                            sz
                            h0))
                        invalidated))]
                  [(ir.CompilerIrValue.Var index-var)
                    ;; Only a zero-offset field base is a provable element
                    ;; base; a nonzero offset would be lost by the scaled key.
                    (if (= o0 0)
                      (opt-load-kinds-bind
                        profile-state
                        invalidated
                        dst
                        (opt-load-loc-scaled-field-checked
                          profile-state
                          b0
                          index-var
                          (opt-load-loc-type-size type-segment-bases ty)
                          h0))
                      invalidated)]
                  [_ invalidated])]
              [(OptLoadLocUnknown)
                ;; `Gep dst dst ...` must not bind Field(dst,...): the base
                ;; var's post-instruction value is the RESULT, not the base.
                (match offset
                  [(ir.CompilerIrValue.I64 k)
                    (let
                      [sz : i64 (opt-load-loc-type-size type-segment-bases ty)]
                      (if (and (> sz 0) (not (= bvar dst)))
                        (opt-load-kinds-bind
                          profile-state
                          invalidated
                          dst
                          (opt-load-loc-field-checked
                            profile-state
                            bvar
                            (* k sz)
                            sz
                            (opt-load-header-var? hs bvar)))
                        invalidated))]
                  [_ invalidated])]
              [(OptLoadLocScaledField _ _ _ _)
                ;; A Gep from a scaled data-buffer address may no longer fit
                ;; the canonical ScaledField key, but it is still an element
                ;; address. Keep the coarser location fact so stores through
                ;; inline slot-field Geps do not masquerade as unknown writes.
                (opt-load-kinds-bind
                  profile-state
                  invalidated
                  dst
                  (OptLoadLocElement))])]
          [_ invalidated])]
      [(ir.CompilerIrInstr.Load dst src ty)
        (match src
          [(ir.CompilerIrValue.Var p)
            (match (opt-load-kinds-lookup invalidated p)
              [(OptLoadLocField _ off _ header?)
                (if (and
                  header?
                  (= off 0)
                  (= (opt-load-loc-type-size type-segment-bases ty) 8))
                  (opt-load-kinds-bind
                    profile-state
                    invalidated
                    dst
                    (OptLoadLocElement))
                  invalidated)]
              [_
                (if (and
                  (opt-load-header-var? hs p)
                  (= (opt-load-loc-type-size type-segment-bases ty) 8))
                  ;; A header var's first word is the data pointer (the element
                  ;; base), whether or not the var already has a Field kind.
                  (opt-load-kinds-bind
                    profile-state
                    invalidated
                    dst
                    (OptLoadLocElement))
                  invalidated)])]
          [_ invalidated])]
      [(ir.CompilerIrInstr.Mov dst src _)
        (match src
          [(ir.CompilerIrValue.Var s)
            (match (opt-load-kinds-lookup invalidated s)
              [(OptLoadLocUnknown) invalidated]
              [(OptLoadLocElement)
                (opt-load-kinds-bind
                  profile-state
                  invalidated
                  dst
                  (OptLoadLocElement))]
              [(OptLoadLocField base off width header?)
                (opt-load-kinds-bind
                  profile-state
                  invalidated
                  dst
                  (OptLoadLocField base off width header?))]
              [(OptLoadLocScaledField base index width header?)
                (opt-load-kinds-bind
                  profile-state
                  invalidated
                  dst
                  (OptLoadLocScaledField base index width header?))])]
          [_ invalidated])]
      [_ invalidated])))

;; Load-GVN treats alias roots as pointer VALUE provenance, not as cached
;; memory contents. Calls/stores still clear the load table, but they do not
;; make an unchanged checked-reference parameter stop being exclusive. A load
;; from byte offset 0 of a recognized descriptor header is the descriptor's
;; data pointer and inherits the descriptor's canonical checked/allocation
;; root; ordinary loads remain MayAlias.
;; `epoch` is the state's allocation counter AFTER `opt-load-cse-epoch-step`,
;; i.e. the epoch a fresh allocation in `instr` must be tagged with.
(define (opt-load-alias-update-facts
  [type-segment-bases : i64]
  [facts : OptAliasFacts]
  [kinds : OptLoadPtrKinds]
  [instr : ir.CompilerIrInstr]
  [epoch : i64]) : OptAliasFacts
  (match instr
    [(ir.CompilerIrInstr.Load dst src ty)
      (let
        [base : OptAliasFacts (opt-alias-remove-var facts dst)]
        (match src
          [(ir.CompilerIrValue.Var ptr)
            (match (opt-load-kinds-lookup kinds ptr)
              [(OptLoadLocField _ off _ header?)
                (if (and
                  header?
                  (= off 0)
                  (= (opt-load-loc-type-size type-segment-bases ty) 8))
                  (opt-alias-derive-var base dst ptr)
                  (opt-alias-mark-may-alias base dst))]
              [_ (opt-alias-mark-may-alias base dst)])]
          [_ (opt-alias-mark-may-alias base dst)]))]
    [_ (opt-alias-update-value-facts facts instr epoch)]))

;; Allocation-epoch counter discipline: a fresh allocation increments the
;; counter, everything else leaves it alone. The counter never decreases along
;; any path (block joins take the max, a single-predecessor entry carries it,
;; and the back-edge reset keeps the accumulated predecessors' value), so an
;; allocation's epoch is strictly greater than the creation epoch of every
;; load-table entry that already exists when it runs.
(define (opt-load-cse-epoch-step [epoch : i64] [instr : ir.CompilerIrInstr]) : i64
  (if (opt-alias-instr-fresh-alloc? instr)
    (+ epoch 1)
    epoch))

;; Load-table keys. Raw keys are address-value identity (with an element flag
;; for the keep rules); Field keys are canonical (base var, byte offset,
;; loaded type, header-typed base) so distinct gep temps of the same slot CSE.
(defenum OptLoadKey
  (Raw ir.CompilerIrValue ast.AstType bool)
  (Field i64 i64 ast.AstType bool)
  ;; A variable-index element address: base var, index var, gep element type
  ;; (the scale), header-typed base. The var-offset analog of Field -- two
  ;; structurally identical index geps of the same array key alike even though
  ;; each is a distinct temp var (the Raw key would not CSE them).
  (ScaledField i64 i64 ast.AstType bool)
  ;; A constant-offset slot reached from a GLOBAL operand: global symbol id,
  ;; byte offset, loaded type, value-base flag. Field's analog for the one base
  ;; form that is not a var at all -- a descriptor fetch group that addresses a
  ;; global (`gep @g, 1` for the length, `gep @g, 0` for the data pointer)
  ;; spends a fresh gep temp on every copy, and only this key form makes those
  ;; copies name one location. `value-base?` separates the two spellings, which
  ;; are DIFFERENT addresses: true is `gep (Global g) k`, based at the pointer
  ;; STORED in g; false is `gep (GlobalAddr g) k`, based at g's own address.
  (GlobalField i64 i64 ast.AstType bool))

;; key, cached value, and the allocation epoch the entry was created at (the
;; state's allocation counter at bind time).
(defenum OptLoadEntry
  (Entry OptLoadKey ir.CompilerIrValue i64))

(defenum OptLoadTable
  (Nil)
  (Cons OptLoadEntry (Box OptLoadTable)))

;; Resolved global-based addresses: var -> (global symbol, byte offset,
;; value-base?), in a bounded dense table. Block-local CSE mutates one table
;; linearly. Cross-block GVN clones it when a predecessor state becomes a new
;; block's entry state, just like the mutable alias facts and pointer-kind
;; tables; joins build a fresh intersection. This keeps retained predecessor
;; snapshots isolated without introducing a boxed binding chain.
;;
;; This is deliberately NOT part of OptLoadPtrKinds, because it does not have a
;; pointer kind's lifetime. A kind is a property of a pointer VALUE and survives
;; calls and stores; `gep (Global g) k` instead RE-READS the global slot on every
;; execution, so "var v addresses [g]+k" stops being true the moment anything
;; writes g. The whole map is therefore dropped by every instruction that could
;; write memory (every dispatch arm except the pure/read/control-flow one and the
;; load itself), and at a loop header whose back edge is still unprocessed. A
;; binding can only ever be consulted while no write has intervened since the gep
;; that produced it, which is exactly the condition under which the two spellings
;; of one global slot are the same address.
;;
;; `gep (GlobalAddr g) k` needs no such care -- g's own address is a link-time
;; constant -- but it rides the same map and the same conservative clearing.
(defenum OptLoadGlobalBaseEntry
  (Entry i64 i64 i64 bool))

(defstruct OptLoadGlobalBases
  (slots (__tl_dyn-array OptLoadGlobalBaseEntry))
  (len i64))

(defenum OptMaybeGlobalBase
  (No)
  (Some i64 i64 bool))

;; facts, table, pointer kinds, table cap, allocation-epoch counter, resolved
;; global-based addresses, and the owning compile-profile job.
(defenum OptLoadCseState
  (State
    OptAliasFacts
    OptLoadTable
    OptLoadPtrKinds
    i64
    i64
    OptLoadGlobalBases
    profile_state.CompilerProfileMetrics))

(defenum OptLoadCseResult
  (Result OptLoadCseState ir.CompilerIrInstr))

;; Bindings only live from a gep to the next memory write, so the map stays
;; short on its own; the cap just bounds the scan in a long write-free run of
;; global accesses.
(define opt-load-global-bases-cap : i64
  32)
(define opt-load-global-bases-initial-cap : i64
  4)

(define (opt-load-global-bases-empty) : OptLoadGlobalBases
  (OptLoadGlobalBases (array.make-array OptLoadGlobalBaseEntry 0) 0))

(define (opt-load-global-bases-clear [bases : OptLoadGlobalBases]) : OptLoadGlobalBases
  (OptLoadGlobalBases bases.slots 0))

(define (opt-load-global-bases-copy-slots
  [slots : (__tl_dyn-array OptLoadGlobalBaseEntry)]
  [len : i64]
  [capacity : i64]) : (__tl_dyn-array OptLoadGlobalBaseEntry)
  (let
    [out : (__tl_dyn-array OptLoadGlobalBaseEntry)
      (array.make-array OptLoadGlobalBaseEntry capacity)]
    [index : i64 0]
    (begin
      (while (< index len)
        (begin
          (set! (array-ref out index) (array-ref slots index))
          (set! index (+ index 1))))
      out)))

(define (opt-load-global-bases-clone [bases : OptLoadGlobalBases]) : OptLoadGlobalBases
  (let
    [len : i64 bases.len]
    (if (= len 0)
      (opt-load-global-bases-empty)
      (let
        [slots : (__tl_dyn-array OptLoadGlobalBaseEntry) bases.slots]
        (OptLoadGlobalBases
          (opt-load-global-bases-copy-slots slots len (array-length slots))
          len)))))

(define (opt-load-global-bases-lookup-from
  [slots : (__tl_dyn-array OptLoadGlobalBaseEntry)]
  [index : i64]
  [var : i64]) : OptMaybeGlobalBase
  (if (< index 0)
    (OptMaybeGlobalBase.No)
    (match (array-ref slots index)
      [(OptLoadGlobalBaseEntry.Entry bound global off value-base?)
        (if (= bound var)
          (OptMaybeGlobalBase.Some global off value-base?)
          (opt-load-global-bases-lookup-from slots (- index 1) var))])))

(define (opt-load-global-bases-lookup [bases : OptLoadGlobalBases] [var : i64]) : OptMaybeGlobalBase
  (opt-load-global-bases-lookup-from bases.slots (- bases.len 1) var))

;; Tables are unique within one block walk. Compacting in place is safe because
;; the cross-block entry path clones retained predecessor tables first.
(define (opt-load-global-bases-drop-var
  [bases : OptLoadGlobalBases]
  [var : i64]) : OptLoadGlobalBases
  (let
    [slots : (__tl_dyn-array OptLoadGlobalBaseEntry) bases.slots]
    [count : i64 bases.len]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptLoadGlobalBaseEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptLoadGlobalBaseEntry.Entry bound _ _ _)
                (if (= bound var)
                  unit
                  (begin
                    (if (not (= write read))
                      (set! (array-ref slots write) entry)
                      unit)
                    (set! write (+ write 1))))])
            (set! read (+ read 1)))))
      (OptLoadGlobalBases slots write))))

(define (opt-load-global-bases-next-capacity [current : i64]) : i64
  (let
    [candidate : i64
      (if (= current 0)
        opt-load-global-bases-initial-cap
        (* current 2))]
    (if (> candidate opt-load-global-bases-cap)
      opt-load-global-bases-cap
      candidate)))

(define (opt-load-global-bases-bind
  [bases : OptLoadGlobalBases]
  [var : i64]
  [global : i64]
  [off : i64]
  [value-base? : bool]) : OptLoadGlobalBases
  (let
    [dropped : OptLoadGlobalBases (opt-load-global-bases-drop-var bases var)]
    [len : i64 dropped.len]
    (if (or (< var 0) (< global 0) (< off 0) (>= len opt-load-global-bases-cap))
      dropped
      (let
        [old-slots : (__tl_dyn-array OptLoadGlobalBaseEntry) dropped.slots]
        [slots : (__tl_dyn-array OptLoadGlobalBaseEntry)
          (if (< len (array-length old-slots))
            old-slots
            (opt-load-global-bases-copy-slots
              old-slots
              len
              (opt-load-global-bases-next-capacity (array-length old-slots))))]
        (begin
          (set!
            (array-ref slots len)
            (OptLoadGlobalBaseEntry.Entry var global off value-base?))
          (OptLoadGlobalBases slots (+ len 1)))))))

(define (opt-load-global-base-fields-eq?
  [global : i64]
  [off : i64]
  [value-base? : bool]
  [other : OptMaybeGlobalBase]) : bool
  (match other
    [(OptMaybeGlobalBase.Some other-global other-off other-value-base?)
      (and
        (= global other-global)
        (= off other-off)
        (=
          (if value-base?
            1
            0)
          (if other-value-base?
            1
            0)))]
    [(OptMaybeGlobalBase.No) false]))

;; Control-flow join: keep only bindings identical on both edges. A var bound on
;; both edges is bound by its single definition, so agreement is the common case;
;; disagreement (or a write on one edge, which empties that edge's map) drops it.
(define (opt-load-global-bases-intersect
  [a : OptLoadGlobalBases]
  [b : OptLoadGlobalBases]) : OptLoadGlobalBases
  (let
    [a-slots : (__tl_dyn-array OptLoadGlobalBaseEntry) a.slots]
    [a-len : i64 a.len]
    [out-slots : (__tl_dyn-array OptLoadGlobalBaseEntry)
      (array.make-array OptLoadGlobalBaseEntry a-len)]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read a-len)
        (let
          [entry : OptLoadGlobalBaseEntry (array-ref a-slots read)]
          (begin
            (match entry
              [(OptLoadGlobalBaseEntry.Entry var global off value-base?)
                (if (opt-load-global-base-fields-eq?
                  global
                  off
                  value-base?
                  (opt-load-global-bases-lookup b var))
                  (begin
                    (set! (array-ref out-slots write) entry)
                    (set! write (+ write 1)))
                  unit)])
            (set! read (+ read 1)))))
      (OptLoadGlobalBases out-slots write))))

;; The global operand a gep base names, if any: `Global g` addresses the pointer
;; stored in g, `GlobalAddr g` addresses g itself. Everything else (vars,
;; literals, RuntimeGlobal -- whose read may run a hidden initializer) is not a
;; resolvable global base.
(define (opt-load-global-base-of-value [value : ir.CompilerIrValue]) : OptMaybeGlobalBase
  (match value
    [(ir.CompilerIrValue.Global g)
      (OptMaybeGlobalBase.Some (ir.compiler-ir-symbol-id g) 0 true)]
    [(ir.CompilerIrValue.GlobalAddr g)
      (OptMaybeGlobalBase.Some (ir.compiler-ir-symbol-id g) 0 false)]
    [_ (OptMaybeGlobalBase.No)]))

;; Resolve a gep's base to a global form: the base operand itself, or a var the
;; map already resolved (so const-offset gep chains sum into one key exactly as
;; a flat gep of the summed offset does).
(define (opt-load-global-base-of-gep-base
  [bases : OptLoadGlobalBases]
  [base : ir.CompilerIrValue]) : OptMaybeGlobalBase
  (match base
    [(ir.CompilerIrValue.Var v) (opt-load-global-bases-lookup bases v)]
    [_ (opt-load-global-base-of-value base)]))

;; Transfer for one instruction on the PURE/read/control-flow path (the write
;; arms clear the whole map instead). A Gep with a constant offset off a
;; resolvable global base binds its dst; a Mov copies a binding; every other
;; definition just drops its dst, because nothing else is a provable
;; global-based address.
;;
;; Both binding arms resolve the base in the PRE-def map and let
;; `opt-load-global-bases-bind` do the dst drop, so `Gep dst dst k` reads dst's
;; OLD address and then rebinds it. The catch-all arm is the one every ordinary
;; instruction takes: an already empty map cannot lose a binding, so it returns
;; without even asking for the instruction's def var.
(define (opt-load-global-bases-step
  [type-segment-bases : i64]
  [bases : OptLoadGlobalBases]
  [instr : ir.CompilerIrInstr]) : OptLoadGlobalBases
  (match instr
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (match (opt-load-global-base-of-gep-base bases base)
        [(OptMaybeGlobalBase.Some global off value-base?)
          (match offset
            [(ir.CompilerIrValue.I64 k)
              (let
                [sz : i64 (opt-load-loc-type-size type-segment-bases ty)]
                (if (> sz 0)
                  (opt-load-global-bases-bind
                    bases
                    dst
                    global
                    (+ off (* k sz))
                    value-base?)
                  (opt-load-global-bases-drop-var bases dst)))]
            ;; A variable offset leaves the constant-offset form; the gep temp
            ;; keeps its own raw identity.
            [_ (opt-load-global-bases-drop-var bases dst)])]
        [(OptMaybeGlobalBase.No) (opt-load-global-bases-drop-var bases dst)])]
    [(ir.CompilerIrInstr.Mov dst src _)
      (match (opt-load-global-base-of-gep-base bases src)
        [(OptMaybeGlobalBase.Some global off value-base?)
          (opt-load-global-bases-bind bases dst global off value-base?)]
        [(OptMaybeGlobalBase.No) (opt-load-global-bases-drop-var bases dst)])]
    [_
      (if (= bases.len 0)
        bases
        (match (opt-instr-def-var instr)
          [(option_i64.Some dst) (opt-load-global-bases-drop-var bases dst)]
          [(option_i64.None) bases]))]))

;; How a classified store writes memory (Unknown clears the whole table).
(defenum OptLoadStoreClass
  (OptLoadStoreUnknown)
  (OptLoadStoreElement)
  (OptLoadStoreField i64 i64 i64 bool))

(define (opt-load-key-eq
  [type-segment-bases : i64]
  [a : OptLoadKey]
  [b : OptLoadKey]) : bool
  (match a
    [(OptLoadKey.Raw av aty aelem)
      (match b
        [(OptLoadKey.Raw bv bty belem)
          (and
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if aelem
                1
                0)
              (if belem
                1
                0)))]
        [_ false])]
    [(OptLoadKey.Field abase aoff aty ah)
      (match b
        [(OptLoadKey.Field bbase boff bty bh)
          (and
            (= abase bbase)
            (= aoff boff)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if ah
                1
                0)
              (if bh
                1
                0)))]
        [_ false])]
    [(OptLoadKey.ScaledField abase aindex aty ah)
      (match b
        [(OptLoadKey.ScaledField bbase bindex bty bh)
          (and
            (= abase bbase)
            (= aindex bindex)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if ah
                1
                0)
              (if bh
                1
                0)))]
        [_ false])]
    [(OptLoadKey.GlobalField aglobal aoff aty avalue)
      (match b
        [(OptLoadKey.GlobalField bglobal boff bty bvalue)
          (and
            (= aglobal bglobal)
            (= aoff boff)
            (opt-type-eq type-segment-bases aty bty)
            (=
              (if avalue
                1
                0)
              (if bvalue
                1
                0)))]
        [_ false])]))

(define (opt-load-key-uses-var? [key : OptLoadKey] [var : i64]) : bool
  (match key
    [(OptLoadKey.Raw value _ _) (opt-value-is-var? value var)]
    [(OptLoadKey.Field base _ _ _) (= base var)]
    [(OptLoadKey.ScaledField base index _ _) (or (= base var) (= index var))]
    ;; A global base names no var, so no redefinition can invalidate this key.
    [(OptLoadKey.GlobalField _ _ _ _) false]))

(define (opt-load-key-type [key : OptLoadKey]) : ast.AstType
  (match key
    [(OptLoadKey.Raw _ ty _) ty]
    [(OptLoadKey.Field _ _ ty _) ty]
    [(OptLoadKey.ScaledField _ _ ty _) ty]
    [(OptLoadKey.GlobalField _ _ ty _) ty]))

;; Canonical key for an address value under the current pointer kinds and
;; resolved global bases.
;;
;; A HEADER-TYPED Field key wins outright: it is the strictly stronger key,
;; because descriptor-field entries are the ones that survive element stores.
;; Otherwise a resolved global base wins, and it is strictly stronger than a
;; plain Field key for the addresses that have one: `gep (gep (Global g) 1) 1`
;; keys off whichever temp the chain passed through under the Field form, while
;; the global form sums the offsets and matches the flat `gep (Global g) 2`.
;; Element/ScaledField vars never carry a base binding (a Load and a var-offset
;; Gep both drop their dst from the map), so those arms cannot disagree.
(define (opt-load-key-for-address
  [kinds : OptLoadPtrKinds]
  [bases : OptLoadGlobalBases]
  [addr : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptLoadKey
  (match addr
    [(ir.CompilerIrValue.Var p)
      (match (opt-load-kinds-lookup kinds p)
        [(OptLoadLocField base off _ header?)
          (if header?
            (OptLoadKey.Field base off ty header?)
            (match (opt-load-global-bases-lookup bases p)
              [(OptMaybeGlobalBase.Some global goff value-base?)
                (OptLoadKey.GlobalField global goff ty value-base?)]
              [(OptMaybeGlobalBase.No) (OptLoadKey.Field base off ty header?)]))]
        [(OptLoadLocScaledField base index _ header?)
          (OptLoadKey.ScaledField base index ty header?)]
        [(OptLoadLocElement) (OptLoadKey.Raw addr ty true)]
        [(OptLoadLocUnknown)
          (match (opt-load-global-bases-lookup bases p)
            [(OptMaybeGlobalBase.Some global off value-base?)
              (OptLoadKey.GlobalField global off ty value-base?)]
            [(OptMaybeGlobalBase.No) (OptLoadKey.Raw addr ty false)])])]
    [_ (OptLoadKey.Raw addr ty false)]))

(define (opt-load-entry-key [entry : OptLoadEntry]) : OptLoadKey
  (match entry
    [(OptLoadEntry.Entry key _ _) key]))

(define (opt-load-entry-value [entry : OptLoadEntry]) : ir.CompilerIrValue
  (match entry
    [(OptLoadEntry.Entry _ value _) value]))

(define (opt-load-entry-epoch [entry : OptLoadEntry]) : i64
  (match entry
    [(OptLoadEntry.Entry _ _ epoch) epoch]))

(define (opt-load-table-lookup
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [key : OptLoadKey]) : ir.CompilerIrMaybeValue
  (match table
    [(OptLoadTable.Nil) (ir.CompilerIrMaybeValue.No)]
    [(OptLoadTable.Cons entry rest)
      (if (opt-load-key-eq type-segment-bases (opt-load-entry-key entry) key)
        (ir.CompilerIrMaybeValue.Some (opt-load-entry-value entry))
        (opt-load-table-lookup type-segment-bases (__tl-box-place rest) key))]))

(define (opt-load-table-has-value-with-type?
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (match table
    [(OptLoadTable.Nil) false]
    [(OptLoadTable.Cons entry rest)
      (if (and
        (opt-value-eq (opt-load-entry-value entry) value)
        (opt-type-eq
          type-segment-bases
          (opt-load-key-type (opt-load-entry-key entry))
          ty))
        true
        (opt-load-table-has-value-with-type?
          type-segment-bases
          (__tl-box-place rest)
          value
          ty))]))

(define (opt-load-table-remove-key-scan
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [key : OptLoadKey]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-remove-key-scan
            type-segment-bases
            (__tl-box-place rest)
            key)]
        (if (opt-load-key-eq type-segment-bases (opt-load-entry-key entry) key)
          tail
          (OptLoadTable.Cons entry (box tail))))]))

;; Removal of an absent key returns the table unchanged instead of re-boxing
;; the whole spine (see opt-alias-remove-var).
(define (opt-load-table-len [table : OptLoadTable]) : i64
  (match table
    [(OptLoadTable.Nil) 0]
    [(OptLoadTable.Cons _ rest)
      (+ 1 (opt-load-table-len (__tl-box-place rest)))]))

;; Bind key -> value. Since granular invalidation lets tables survive stores,
;; cap growth: a fresh key is skipped once the table reaches the state cap.
(define (opt-load-table-bind
  [_profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [cap : i64]
  [key : OptLoadKey]
  [value : ir.CompilerIrValue]
  [epoch : i64]) : OptLoadTable
  (match (opt-load-table-lookup type-segment-bases table key)
    [(ir.CompilerIrMaybeValue.Some _)
      (OptLoadTable.Cons
        (OptLoadEntry.Entry key value epoch)
        (box (opt-load-table-remove-key-scan type-segment-bases table key)))]
    [(ir.CompilerIrMaybeValue.No)
      (let
        [current-len : i64 (opt-load-table-len table)]
        (begin
          (cfg
            compile-profile
            (compiler-opt-load-cse-profile-note-table-size
              _profile-state
              current-len))
          (cfg
            compile-profile
            (compiler-opt-load-cse-profile-note-table-cap _profile-state cap))
          (if (>= current-len cap)
            (begin
              (cfg
                compile-profile
                (compiler-opt-load-cse-profile-note-table-cap-hit
                  _profile-state))
              table)
            (begin
              (cfg
                compile-profile
                (compiler-opt-load-cse-profile-note-table-size
                  _profile-state
                  (+ current-len 1)))
              (OptLoadTable.Cons
                (OptLoadEntry.Entry key value epoch)
                (box table))))))]))

(define (opt-load-copy-entry-within?
  [type-segment-bases : i64]
  [entry : OptLoadEntry]
  [src-base : i64]
  [src-off : i64]
  [size : i64]) : bool
  (match (opt-load-entry-key entry)
    [(OptLoadKey.Field base off ty _)
      (let
        [width : i64 (opt-load-loc-type-size type-segment-bases ty)]
        (and
          (= base src-base)
          (> width 0)
          (>= off src-off)
          (<= (+ off width) (+ src-off size))))]
    [_ false]))

;; The synthesized destination entry is created by THIS CopyBytes, so it takes
;; the state's current allocation epoch, not the source entry's older one.
(define (opt-load-copy-transfer-entry
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [cap : i64]
  [entry : OptLoadEntry]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [src-base : i64]
  [src-off : i64]
  [dst-base : i64]
  [dst-off : i64]
  [size : i64]
  [dst-header? : bool]
  [epoch : i64]) : OptLoadTable
  (if (opt-load-copy-entry-within?
    type-segment-bases
    entry
    src-base
    src-off
    size)
    (match (opt-load-entry-key entry)
      [(OptLoadKey.Field _ off ty _)
        (let
          [key : OptLoadKey
            (OptLoadKey.Field
              dst-base
              (+ dst-off (- off src-off))
              ty
              dst-header?)]
          [value : ir.CompilerIrValue (opt-load-entry-value entry)]
          [eligible? : bool
            (if gated?
              (and
                (opt-load-key-gvn-stable? sources key)
                (opt-load-value-gvn-stable? sources value))
              true)]
          (if eligible?
            (opt-load-table-bind
              profile-state
              type-segment-bases
              table
              cap
              key
              value
              epoch)
            table))]
      [_ table])
    table))

(define (opt-load-table-transfer-copy-fields
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [source : OptLoadTable]
  [out : OptLoadTable]
  [cap : i64]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [src-base : i64]
  [src-off : i64]
  [dst-base : i64]
  [dst-off : i64]
  [size : i64]
  [dst-header? : bool]
  [epoch : i64]) : OptLoadTable
  (match source
    [(OptLoadTable.Nil) out]
    [(OptLoadTable.Cons entry rest)
      (opt-load-table-transfer-copy-fields
        profile-state
        type-segment-bases
        (__tl-box-place rest)
        (opt-load-copy-transfer-entry
          profile-state
          type-segment-bases
          out
          cap
          entry
          gated?
          sources
          src-base
          src-off
          dst-base
          dst-off
          size
          dst-header?
          epoch)
        cap
        gated?
        sources
        src-base
        src-off
        dst-base
        dst-off
        size
        dst-header?
        epoch)]))

(define (opt-load-entry-mentions-var? [entry : OptLoadEntry] [var : i64]) : bool
  (or
    (opt-value-is-var? (opt-load-entry-value entry) var)
    (opt-load-key-uses-var? (opt-load-entry-key entry) var)))

(define (opt-load-table-mentions-var? [table : OptLoadTable] [var : i64]) : bool
  (match table
    [(OptLoadTable.Nil) false]
    [(OptLoadTable.Cons entry rest)
      (if (opt-load-entry-mentions-var? entry var)
        true
        (opt-load-table-mentions-var? (__tl-box-place rest) var))]))

(define (opt-load-table-invalidate-var-scan [table : OptLoadTable] [var : i64]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [rest2 : OptLoadTable
          (opt-load-table-invalidate-var-scan (__tl-box-place rest) var)]
        (if (opt-load-entry-mentions-var? entry var)
          rest2
          (OptLoadTable.Cons entry (box rest2))))]))

;; Drop entries whose key references `var` (raw address value or canonical
;; base var), or whose cached value is `var`. The IR is not globally SSA, so
;; any reused var id must make old load facts disappear before the new
;; instruction is processed. This runs for every defining instruction, so the
;; no-match case returns the table unchanged instead of re-boxing the spine.
(define (opt-load-table-invalidate-var [table : OptLoadTable] [var : i64]) : OptLoadTable
  (if (opt-load-table-mentions-var? table var)
    (opt-load-table-invalidate-var-scan table var)
    table))

;; Does an entry provably NOT alias a classified store? (GAP4 rules; anything
;; not provably disjoint is dropped.)
(define (opt-load-ranges-disjoint?
  [alo : i64]
  [awidth : i64]
  [blo : i64]
  [bwidth : i64]) : bool
  (and
    (> awidth 0)
    (> bwidth 0)
    (or (<= (+ alo awidth) blo) (<= (+ blo bwidth) alo))))

(define (opt-load-key-alias-root [facts : OptAliasFacts] [key : OptLoadKey]) : OptAliasRoot
  (match key
    [(OptLoadKey.Raw value _ _) (opt-alias-root-of-value facts value)]
    [(OptLoadKey.Field base _ _ _) (opt-alias-root-of-var facts base)]
    ;; A scaled element address lives in the base var's buffer: rooting it at
    ;; the base is what lets an exclusive-allocation store root clear it.
    [(OptLoadKey.ScaledField base _ _ _) (opt-alias-root-of-var facts base)]
    ;; A global slot has no tracked pointer provenance. NoRoot is the
    ;; conservative answer: `opt-alias-store-root-disjoint?` never proves an
    ;; entry on NoRoot disjoint from any store, so a global-keyed entry can only
    ;; survive a store through the epoch rule or the location rule below.
    [(OptLoadKey.GlobalField _ _ _ _) (OptAliasRoot.NoRoot)]))

(define (opt-load-entry-survives-store-location?
  [type-segment-bases : i64]
  [class : OptLoadStoreClass]
  [entry : OptLoadEntry]) : bool
  (match class
    [(OptLoadStoreElement)
      ;; Element stores write data-buffer memory; only descriptor-field
      ;; entries (header-typed base) and named global CELLS are provably
      ;; outside every buffer.
      ;;
      ;; The global-cell arm is the same allocation-layer argument the header
      ;; arm makes, one level up the descriptor chain: an element address is
      ;; derived from a data pointer LOADED out of a descriptor slot, so it
      ;; addresses that allocation's payload, while a `GlobalField` key
      ;; addresses a named cell in the static data segment, which no payload
      ;; allocation overlaps. An inline global array cannot produce the key
      ;; either -- a variable-offset gep off a global drops its global-base
      ;; binding (opt-load-global-bases-step), so only constant-offset cell
      ;; words are ever keyed this way.
      (match (opt-load-entry-key entry)
        [(OptLoadKey.Field _ _ _ header?) header?]
        [(OptLoadKey.GlobalField _ _ _ _) true]
        [_ false])]
    [(OptLoadStoreField sbase slo swidth sheader?)
      (match (opt-load-entry-key entry)
        [(OptLoadKey.Raw _ _ element?)
          ;; A descriptor-field store cannot touch buffer memory; a generic
          ;; field store might (inline structs live inside buffers).
          (and element? sheader?)]
        [(OptLoadKey.Field ebase eoff ety _)
          ;; Same object (same un-redefined base var) at disjoint byte
          ;; ranges. Different base vars may name the same object -- drop.
          (and
            (= ebase sbase)
            (opt-load-ranges-disjoint?
              slo
              swidth
              eoff
              (opt-load-loc-type-size type-segment-bases ety)))]
        ;; A var-offset key cannot prove disjointness from any store: drop
        ;; (conservative, matching a generic Raw).
        [(OptLoadKey.ScaledField _ _ _ _) false]
        ;; A field store's base var may hold the global's own address, so a
        ;; global-keyed entry is never provably outside it: drop.
        [(OptLoadKey.GlobalField _ _ _ _) false])]
    [(OptLoadStoreUnknown) false]))

;; Epoch-ordering rule: freshly allocated storage is disjoint from every address
;; value that already existed when the allocation ran. So a store rooted at an
;; allocation of epoch E cannot alias an entry whose creation epoch is strictly
;; below E -- whatever that entry's own root class is (including NoRoot, an
;; untracked pointer), and whether or not the allocation escapes afterwards. The
;; inequality must be strict: an entry bound at exactly E may address the
;; allocation itself. Entries created at or after E are dropped as before.
(define (opt-load-entry-precedes-fresh-alloc?
  [store-root : OptAliasRoot]
  [entry : OptLoadEntry]) : bool
  (match store-root
    [(OptAliasRoot.Fresh _ alloc-epoch)
      (< (opt-load-entry-epoch entry) alloc-epoch)]
    [(OptAliasRoot.Exclusive _) false]
    [(OptAliasRoot.Shared _) false]
    [(OptAliasRoot.NoRoot) false]))

(define (opt-load-entry-survives-store?
  [type-segment-bases : i64]
  [facts : OptAliasFacts]
  [store-root : OptAliasRoot]
  [class : OptLoadStoreClass]
  [entry : OptLoadEntry]) : bool
  (or
    (opt-alias-store-root-disjoint?
      store-root
      (opt-load-key-alias-root facts (opt-load-entry-key entry)))
    (opt-load-entry-precedes-fresh-alloc? store-root entry)
    (opt-load-entry-survives-store-location? type-segment-bases class entry)))

;; `CompilerIrInstr.Store G, v` is the one write form whose target is a SYMBOL
;; instead of a pointer: it writes the cell named G and nothing else, so its
;; kill set can be spelled by name rather than emptying the table. An entry
;; survives when its location is provably not cell G:
;;
;;   * `GlobalField` on a DIFFERENT global -- distinct cells never overlap, and
;;     for a descriptor-valued cell the key names the object the cell POINTS AT,
;;     which `Store G` (a cell write) leaves untouched either way;
;;   * a header-typed `Field` -- a descriptor header word lives in the heap
;;     object a cell points at, never in the cell itself (a global of array or
;;     string type holds the handle, not the two header words), the same
;;     allocation-layer argument the element rule above makes;
;;   * an element-typed `Raw` -- data-buffer payload, never a cell.
;;
;; Everything else is dropped. Same-global cell words are the store's own
;; location; generic fields, scaled fields and unclassified `Raw` addresses may
;; hold the cell's own address, because `(&mut G)` on a value-typed global
;; lowers to a `Global G` operand, which the program's address-taken set (built
;; from `GlobalAddr` operands) does not record.
(define (opt-load-entry-survives-global-cell-store?
  [global : i64]
  [entry : OptLoadEntry]) : bool
  (match (opt-load-entry-key entry)
    [(OptLoadKey.GlobalField entry-global _ _ _) (not (= entry-global global))]
    [(OptLoadKey.Field _ _ _ header?) header?]
    [(OptLoadKey.ScaledField _ _ _ _) false]
    [(OptLoadKey.Raw _ _ element?) element?]))

(define (opt-load-table-filter-global-cell-store
  [table : OptLoadTable]
  [global : i64]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-filter-global-cell-store (__tl-box-place rest) global)]
        (if (opt-load-entry-survives-global-cell-store? global entry)
          (OptLoadTable.Cons entry (box tail))
          tail))]))

(define (opt-load-table-filter-store
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [facts : OptAliasFacts]
  [store-root : OptAliasRoot]
  [class : OptLoadStoreClass]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-filter-store
            type-segment-bases
            (__tl-box-place rest)
            facts
            store-root
            class)]
        (if (opt-load-entry-survives-store?
          type-segment-bases
          facts
          store-root
          class
          entry)
          (OptLoadTable.Cons entry (box tail))
          tail))]))

;; Classify a store's target from the pointer kinds; `width` is the byte size
;; actually written (StorePtr type width / CopyBytes size).
(define (opt-load-classify-store
  [kinds : OptLoadPtrKinds]
  [ptr : ir.CompilerIrValue]
  [width : i64]) : OptLoadStoreClass
  (if (<= width 0)
    (OptLoadStoreUnknown)
    (match ptr
      [(ir.CompilerIrValue.Var p)
        (match (opt-load-kinds-lookup kinds p)
          [(OptLoadLocElement) (OptLoadStoreElement)]
          [(OptLoadLocField base off _ header?)
            (OptLoadStoreField base off width header?)]
          ;; A scaled element store writes data-buffer memory (base is the
          ;; loaded data pointer), exactly like an Element store: descriptor
          ;; fields are provably outside it, so header-typed entries survive.
          [(OptLoadLocScaledField _ _ _ _) (OptLoadStoreElement)]
          [(OptLoadLocUnknown) (OptLoadStoreUnknown)])]
      [_ (OptLoadStoreUnknown)])))

;; Block-local dead-store elimination. Pending entries are stores that have not
;; yet been observed by an aliasing load or unknown memory effect.
(defenum OptDeadStoreEntry
  (Entry i64 OptLoadStoreClass))

(defstruct OptDeadStoreSet
  (slots (__tl_dyn-array OptDeadStoreEntry))
  (len i64))

(define (opt-dead-store-set-with-capacity [capacity : i64]) : OptDeadStoreSet
  (OptDeadStoreSet (array.make-array OptDeadStoreEntry capacity) 0))

(define (opt-dead-store-set-clear [pending : OptDeadStoreSet]) : OptDeadStoreSet
  (OptDeadStoreSet pending.slots 0))

(define (opt-dead-store-trackable? [class : OptLoadStoreClass]) : bool
  (match class
    [(OptLoadStoreField _ _ _ _) true]
    [_ false]))

(define (opt-dead-store-classes-exact?
  [a : OptLoadStoreClass]
  [b : OptLoadStoreClass]) : bool
  (match a
    [(OptLoadStoreField abase aoff awidth aheader?)
      (match b
        [(OptLoadStoreField bbase boff bwidth bheader?)
          (and
            (= abase bbase)
            (= aoff boff)
            (= awidth bwidth)
            (=
              (if aheader?
                1
                0)
              (if bheader?
                1
                0)))]
        [_ false])]
    [_ false]))

(define (opt-dead-store-classes-disjoint?
  [access : OptLoadStoreClass]
  [candidate : OptLoadStoreClass]) : bool
  (match access
    [(OptLoadStoreUnknown) false]
    [(OptLoadStoreElement)
      (match candidate
        [(OptLoadStoreField _ _ _ header?) header?]
        [_ false])]
    [(OptLoadStoreField abase aoff awidth aheader?)
      (match candidate
        [(OptLoadStoreElement) aheader?]
        [(OptLoadStoreField bbase boff bwidth _)
          (and
            (= abase bbase)
            (opt-load-ranges-disjoint? aoff awidth boff bwidth))]
        [(OptLoadStoreUnknown) false])]))

(define (opt-dead-store-filter-store
  [pending : OptDeadStoreSet]
  [dead : (__tl_dyn-array i64)]
  [class : OptLoadStoreClass]) : OptDeadStoreSet
  (let
    [slots : (__tl_dyn-array OptDeadStoreEntry) pending.slots]
    [count : i64 pending.len]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptDeadStoreEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptDeadStoreEntry.Entry old-index old-class)
                (if (opt-dead-store-classes-exact? old-class class)
                  (set! (array-ref dead old-index) 1)
                  (if (opt-dead-store-classes-disjoint? class old-class)
                    (begin
                      (if (not (= write read))
                        (set! (array-ref slots write) entry)
                        unit)
                      (set! write (+ write 1)))
                    unit))])
            (set! read (+ read 1)))))
      (OptDeadStoreSet slots write))))

(define (opt-dead-store-add-current
  [pending : OptDeadStoreSet]
  [index : i64]
  [class : OptLoadStoreClass]) : OptDeadStoreSet
  (if (and
    (opt-dead-store-trackable? class)
    (< pending.len (array-length pending.slots)))
    (let
      [slots : (__tl_dyn-array OptDeadStoreEntry) pending.slots]
      [len : i64 pending.len]
      (begin
        (set! (array-ref slots len) (OptDeadStoreEntry.Entry index class))
        (OptDeadStoreSet slots (+ len 1))))
    pending))

(define (opt-dead-store-filter-access
  [pending : OptDeadStoreSet]
  [class : OptLoadStoreClass]) : OptDeadStoreSet
  (let
    [slots : (__tl_dyn-array OptDeadStoreEntry) pending.slots]
    [count : i64 pending.len]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptDeadStoreEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptDeadStoreEntry.Entry _ old-class)
                (if (opt-dead-store-classes-disjoint? class old-class)
                  (begin
                    (if (not (= write read))
                      (set! (array-ref slots write) entry)
                      unit)
                    (set! write (+ write 1)))
                  unit)])
            (set! read (+ read 1)))))
      (OptDeadStoreSet slots write))))

(define (opt-dead-store-class-uses-var? [class : OptLoadStoreClass] [var : i64]) : bool
  (match class
    [(OptLoadStoreField base _ _ _) (= base var)]
    [_ false]))

(define (opt-dead-store-filter-def [pending : OptDeadStoreSet] [var : i64]) : OptDeadStoreSet
  (let
    [slots : (__tl_dyn-array OptDeadStoreEntry) pending.slots]
    [count : i64 pending.len]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [entry : OptDeadStoreEntry (array-ref slots read)]
          (begin
            (match entry
              [(OptDeadStoreEntry.Entry _ class)
                (if (opt-dead-store-class-uses-var? class var)
                  unit
                  (begin
                    (if (not (= write read))
                      (set! (array-ref slots write) entry)
                      unit)
                    (set! write (+ write 1))))])
            (set! read (+ read 1)))))
      (OptDeadStoreSet slots write))))

(define (opt-dead-store-other-keeps-pending? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Alloc _ _) true]
    [_
      (if (opt-alias-instr-clears-all? instr)
        false
        (match (ir.compiler-ir-instr-effect instr)
          [(ir.CompilerIrEffect.Pure) true]
          [_ false]))]))

(define (opt-dead-store-step
  [type-segment-bases : i64]
  [pending : OptDeadStoreSet]
  [kinds : OptLoadPtrKinds]
  [dead : (__tl_dyn-array i64)]
  [index : i64]
  [instr : ir.CompilerIrInstr]) : OptDeadStoreSet
  (let
    [after-memory : OptDeadStoreSet
      (match instr
        [(ir.CompilerIrInstr.StorePtr ptr _ ty)
          (let
            [class : OptLoadStoreClass
              (opt-load-classify-store
                kinds
                ptr
                (opt-load-loc-type-size type-segment-bases ty))]
            (opt-dead-store-add-current
              (opt-dead-store-filter-store pending dead class)
              index
              class))]
        [(ir.CompilerIrInstr.Load _ src ty)
          (opt-dead-store-filter-access
            pending
            (opt-load-classify-store
              kinds
              src
              (opt-load-loc-type-size type-segment-bases ty)))]
        [(ir.CompilerIrInstr.CopyBytes _ _ _)
          (opt-dead-store-set-clear pending)]
        [_
          (if (opt-dead-store-other-keeps-pending? instr)
            pending
            (opt-dead-store-set-clear pending))])]
    (match (opt-instr-def-var instr)
      [(option_i64.Some dst) (opt-dead-store-filter-def after-memory dst)]
      [(option_i64.None) after-memory])))

(define (opt-dead-store-compact!
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]
  [dead : (__tl_dyn-array i64)]
  [count : i64]) : unit
  (let
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (begin
          (if (= (array-ref dead read) 0)
            (begin
              (if (not (= write read))
                (set!
                  (array-ref instrs.slots write)
                  (clone (array-ref instrs.slots read)))
                unit)
              (set! write (+ write 1)))
            unit)
          (set! read (+ read 1))))
      (set! instrs.len write))))

(define (opt-dead-store-storeptr-capacity [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [stores : i64 0]
    (begin
      (while (and (< index count) (< stores 128))
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.StorePtr _ _ _) (set! stores (+ stores 1))]
            [_ unit])
          (set! index (+ index 1))))
      stores)))

(define (opt-dead-store-instr-seq-known-with-kinds
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [store-capacity : i64]
  [initial-kinds : OptLoadPtrKinds]
  [instrs : ir.CompilerIrInstrSeq (:consume)]) : ir.CompilerIrInstrSeq
  (if (>= store-capacity 2)
    (let
      [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
      [dead : (__tl_dyn-array i64) (make-array i64 count)]
      [pending : OptDeadStoreSet
        (opt-dead-store-set-with-capacity store-capacity)]
      [kinds : OptLoadPtrKinds initial-kinds]
      [index : i64 0]
      (begin
        (while (< index count)
          (let
            [instr : ir.CompilerIrInstr
              (ir.compiler-ir-instr-seq-ref instrs index)]
            (begin
              (set!
                pending
                (opt-dead-store-step
                  type-segment-bases
                  pending
                  kinds
                  dead
                  index
                  instr))
              (set!
                kinds
                (opt-load-kinds-step
                  profile-state
                  type-segment-bases
                  kinds
                  hs
                  instr))
              (set! index (+ index 1)))))
        (opt-dead-store-compact! (&mut instrs) dead count)
        instrs))
    instrs))

(define (opt-dead-store-instr-seq-known
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [store-capacity : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-dead-store-instr-seq-known-with-kinds
    (profile_state.compiler-profile-state-metrics
      (profile_state.compiler-profile-state-new))
    type-segment-bases
    hs
    store-capacity
    (opt-load-kinds-empty)
    instrs))

(define (opt-dead-store-instr-seq
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-dead-store-instr-seq-known
    type-segment-bases
    hs
    (opt-dead-store-storeptr-capacity instrs)
    instrs))

;; GVN stability for a key's referenced vars (the cross-block pass only
;; caches/forwards through single-source vars, mirroring its original
;; gates; the block-local pass needs none).
(define (opt-load-key-gvn-stable?
  [sources : opt_i64_i64_map.Map]
  [key : OptLoadKey]) : bool
  (match key
    [(OptLoadKey.Raw value _ _) (opt-gvn-value-stable? sources value)]
    [(OptLoadKey.Field base _ _ _) (opt-gvn-stable-var? sources base)]
    [(OptLoadKey.ScaledField base index _ _)
      (and
        (opt-gvn-stable-var? sources base)
        (opt-gvn-stable-var? sources index))]
    ;; The key names no var at all. The base map that produced it is emptied by
    ;; every memory write and at every unprocessed-back-edge loop header, so a
    ;; key of this form can only have been built where the global base still
    ;; held the value the walk observed.
    [(OptLoadKey.GlobalField _ _ _ _) true]))

(define (opt-load-value-gvn-stable?
  [sources : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var v) (opt-gvn-stable-var? sources v)]
    [_ true]))

(define (opt-load-subword-forward-const
  [type-segment-bases : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match ty
    [(ast.AstType.F32) (ir.CompilerIrMaybeValue.No)]
    [_
      (match (opt-normalize-const value ty)
        [(OptKnownConst.SomeConst normalized normalized-ty)
          (if (opt-type-eq type-segment-bases normalized-ty ty)
            (ir.CompilerIrMaybeValue.Some normalized)
            (ir.CompilerIrMaybeValue.No))]
        [(OptKnownConst.NoConst) (ir.CompilerIrMaybeValue.No)])]))

(define (opt-load-subword-store-forward-value
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [width : i64]) : ir.CompilerIrMaybeValue
  (if (opt-copy-safe-source? value)
    (if (> width 0)
      (match (opt-load-subword-forward-const type-segment-bases value ty)
        [(ir.CompilerIrMaybeValue.Some normalized)
          (ir.CompilerIrMaybeValue.Some normalized)]
        [(ir.CompilerIrMaybeValue.No)
          (match value
            [(ir.CompilerIrValue.Var _)
              (if (opt-load-table-has-value-with-type?
                type-segment-bases
                table
                value
                ty)
                (ir.CompilerIrMaybeValue.Some value)
                (ir.CompilerIrMaybeValue.No))]
            [_ (ir.CompilerIrMaybeValue.No)])])
      (ir.CompilerIrMaybeValue.No))
    (ir.CompilerIrMaybeValue.No)))

;; Any instruction that is neither Load/StorePtr/CopyBytes nor a clear-all:
;; drop def-invalidated entries, update alias facts and pointer kinds. This is
;; the ONLY arm that can write no memory (pure, memory-read and control-flow
;; effects only), so it is also the only one that carries global bases forward.
(define (opt-load-cse-state-step-other
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instr : ir.CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (let
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (match (opt-instr-def-var instr)
            [(option_i64.Some dst) (opt-load-table-invalidate-var table dst)]
            [(option_i64.None) table])
          (opt-load-kinds-step profile-state type-segment-bases kinds hs instr)
          table-cap
          next-epoch
          (opt-load-global-bases-step type-segment-bases bases instr)
          profile-state))]))

;; Calls/unknown effects: the table clears entirely; pointer kinds are value
;; properties and survive (only the instr's own def is invalidated). The
;; allocation counter is carried, never reset: alias facts keep their
;; Unique(epoch) roots across the clear, so a lower counter afterwards would
;; make a later entry look older than an earlier allocation. Global bases are
;; NOT value properties -- the write this instruction may perform could land on
;; a global slot -- so they clear with the table.
(define (opt-load-cse-state-clear-for-memory
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instr : ir.CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State facts _ kinds table-cap epoch bases profile-state)
      (let
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (OptLoadTable.Nil)
          (opt-load-kinds-step profile-state type-segment-bases kinds hs instr)
          table-cap
          next-epoch
          (opt-load-global-bases-clear bases)
          profile-state))]))

;; A named global-cell write. Same transfer as the clear-for-memory arm above --
;; the alias facts, the pointer kinds and the allocation counter all step
;; identically, and the global bases still CLEAR, because a binding formed
;; before the store names `contents-of-G + off`, which this instruction is
;; exactly what changes. Only the load table is treated granularly: the write
;; lands on cell G alone, so entries proven to live elsewhere are kept (see
;; opt-load-entry-survives-global-cell-store?). The cleared base map means a
;; later re-derivation rebuilds its own `GlobalField` key from a fresh
;; `Global`/`GlobalAddr` operand, so a kept entry is only ever consulted under a
;; key the walk re-proved, exactly as before this arm existed.
(define (opt-load-cse-state-global-store
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [global : i64]
  [instr : ir.CompilerIrInstr]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (let
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (opt-load-table-filter-global-cell-store table global)
          (opt-load-kinds-step profile-state type-segment-bases kinds hs instr)
          table-cap
          next-epoch
          (opt-load-global-bases-clear bases)
          profile-state))]))

;; Apply one callee parameter-write bit to the cached load table. The callee
;; summary carries no byte-range fact, so filtering is root-only: a write
;; through a fresh/exclusive argument preserves entries on different proven
;; roots; missing/unrooted/shared arguments conservatively empty the table.
(define (opt-load-table-filter-call-writes
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [facts : OptAliasFacts]
  [args : ir.CompilerIrCallArgs]
  [summary : i64]
  [index : i64]) : OptLoadTable
  (if (>= index (opt-call-memory-param-limit))
    table
    (if (not (opt-call-memory-summary-param-write? summary index))
      (opt-load-table-filter-call-writes
        type-segment-bases
        table
        facts
        args
        summary
        (+ index 1))
      (match (opt-call-memory-arg-at args index)
        [(ir.CompilerIrMaybeValue.No) (OptLoadTable.Nil)]
        [(ir.CompilerIrMaybeValue.Some value)
          (opt-load-table-filter-call-writes
            type-segment-bases
            (opt-load-table-filter-store
              type-segment-bases
              table
              facts
              (opt-alias-root-of-value facts value)
              (OptLoadStoreUnknown))
            facts
            args
            summary
            (+ index 1))]))))

;; An ELEMENT-ONLY callee's writes, as a table filter.
;;
;; The element bit means every write the callee performs (transitively) goes
;; through a pointer classified as `buffer`: an address INSIDE the heap storage
;; some descriptor's data slot names (see opt-call-memory-element-bit). That is
;; exactly the class this pass already calls `OptLoadStoreElement` for an
;; in-function store, so the callee's whole write set is summarized by ONE
;; element store at an unknown root -- and the location rule already written for
;; that class (opt-load-entry-survives-store-location?) is the whole verdict:
;; only `Field` entries on a header-typed base survive, because a descriptor
;; handle addresses a descriptor allocation and a descriptor allocation is
;; provably outside every data buffer. `opt-load-classify-store` makes the same
;; call for a scaled element store, and opt-load-table-filter-descriptor-stable
;; carries exactly these entries across a loop body proven to write only element
;; memory; this is the per-callee form of the same layer split.
;;
;; NoRoot is the right store root: the element bit deliberately does not name
;; WHICH caller object owns the written buffer, so no root-disjointness or
;; fresh-allocation-epoch claim may be made on its behalf, and
;; opt-alias-store-root-disjoint? proves nothing against NoRoot. Raw addresses,
;; ScaledField element addresses, non-header Field entries and every
;; GlobalField entry are dropped: each of those can name storage a data buffer
;; covers (a global's own storage can be the buffer of a slice built over it).
(define (opt-load-table-filter-element-call
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [facts : OptAliasFacts]) : OptLoadTable
  (opt-load-table-filter-store
    type-segment-bases
    table
    facts
    (OptAliasRoot.NoRoot)
    (OptLoadStoreElement)))

(define (opt-load-cse-state-direct-call
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [call-memory : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [dst : i64]
  [name : i64]
  [args : ir.CompilerIrCallArgs]
  [instr : ir.CompilerIrInstr]) : OptLoadCseState
  (match state
    ;; A callee may write globals, so the base map clears here even when the
    ;; summary lets table entries live: those entries survive only where the
    ;; callee provably cannot reach them, while a base map binding would have to
    ;; re-prove that the global SLOT is untouched, which no summary states.
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (let
        ;; Filtering reads the PRE-call facts and table, so a tl_alloc call
        ;; cannot use its own (not yet bound) fresh root to keep entries.
        [filtered : OptLoadTable
          (match (opt_i64_i64_map.get
            (& call-memory)
            (ir.compiler-ir-symbol-id name))
            [(opt_i64_i64_map.LookupFound summary)
              ;; Unknown effects and global writes still empty the table: an
              ;; unknown write can land anywhere, and a global write can rewrite
              ;; a descriptor-valued global cell, which is the base a descriptor
              ;; entry was keyed on. The element bit is the one verdict that
              ;; names a LAYER instead of an object, so it filters to the
              ;; descriptor layer rather than clearing (the parameter bits, if
              ;; any, then filter that result by root as before).
              (if (or
                (opt-call-memory-summary-global? summary)
                (opt-call-memory-summary-unknown? summary))
                (OptLoadTable.Nil)
                (opt-load-table-filter-call-writes
                  type-segment-bases
                  (if (opt-call-memory-summary-element? summary)
                    (opt-load-table-filter-element-call
                      type-segment-bases
                      table
                      facts)
                    table)
                  facts
                  args
                  summary
                  0))]
            [(opt_i64_i64_map.LookupMissing)
              (match (ir.compiler-ir-direct-call-effect-id name)
                [(ir.CompilerIrEffect.MemoryRead) table]
                ;; The runtime control-flow family is the nonreturning abort
                ;; set (tl_abort_label / tl_oob_abort / tl_div_abort /
                ;; tl_shift_abort). No instruction after such a call ever runs,
                ;; so no cached load it could invalidate is ever consulted;
                ;; opt-call-memory-candidate-instr already gives ControlFlow
                ;; this verdict for the non-call instruction forms.
                [(ir.CompilerIrEffect.ControlFlow) table]
                [_ (OptLoadTable.Nil)])])]
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        (OptLoadCseState.State
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)
          (opt-load-table-invalidate-var filtered dst)
          (opt-load-kinds-step profile-state type-segment-bases kinds hs instr)
          table-cap
          next-epoch
          (opt-load-global-bases-clear bases)
          profile-state))]))

;; StorePtr: granular invalidation, then store-to-load forwarding. The
;; forwarded value must be a copy-safe source (no hidden global reads). Sub-word
;; forwarding additionally requires a normalized constant or a same-type load
;; origin, so arbitrary non-canonical sub-word vars still reload from memory.
(define (opt-load-cse-state-store
  [type-segment-bases : i64]
  ;; lint-allow: unused-variable
  [hs : OptLoadHeaderSet]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [state : OptLoadCseState (:consume)]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [instr : ir.CompilerIrInstr]) : OptLoadCseState
  (match state
    ;; The store may land on a global slot (an unclassified pointer can address
    ;; anything), so the base map clears whatever the class turns out to be.
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (let
        [width : i64 (opt-load-loc-type-size type-segment-bases ty)]
        [class : OptLoadStoreClass (opt-load-classify-store kinds ptr width)]
        [store-root : OptAliasRoot (opt-alias-root-of-value facts ptr)]
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        [facts2 : OptAliasFacts
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)]
        [filtered : OptLoadTable
          (opt-load-table-filter-store
            type-segment-bases
            table
            facts
            store-root
            class)]
        (match class
          [(OptLoadStoreUnknown)
            ;; Unknown offset/location still preserves entries rooted at a
            ;; different exclusive checked or fresh allocation root, and entries
            ;; created before a fresh store root's allocation epoch.
            (OptLoadCseState.State
              facts2
              filtered
              kinds
              table-cap
              next-epoch
              (opt-load-global-bases-clear bases)
              profile-state)]
          [_
            (let
              [key : OptLoadKey (opt-load-key-for-address kinds bases ptr ty)]
              [forwardable? : bool
                (if gated?
                  (and
                    (opt-load-key-gvn-stable? sources key)
                    (opt-load-value-gvn-stable? sources value))
                  true)]
              [forwarded : ir.CompilerIrMaybeValue
                (if forwardable?
                  (if (= width 8)
                    (if (opt-copy-safe-source? value)
                      (ir.CompilerIrMaybeValue.Some value)
                      (ir.CompilerIrMaybeValue.No))
                    (opt-load-subword-store-forward-value
                      type-segment-bases
                      table
                      value
                      ty
                      width))
                  (ir.CompilerIrMaybeValue.No))]
              (OptLoadCseState.State
                facts2
                (match forwarded
                  [(ir.CompilerIrMaybeValue.Some forwarded-value)
                    (opt-load-table-bind
                      profile-state
                      type-segment-bases
                      filtered
                      table-cap
                      key
                      forwarded-value
                      next-epoch)]
                  [(ir.CompilerIrMaybeValue.No) filtered])
                kinds
                table-cap
                next-epoch
                (opt-load-global-bases-clear bases)
                profile-state))]))]))

;; CopyBytes writes `size` bytes through its dst pointer: same granular
;; invalidation, plus conservative field-to-field forwarding when source and
;; destination are disjoint ranges of the same tracked base.
(define (opt-load-cse-state-copy-bytes
  [type-segment-bases : i64]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [state : OptLoadCseState (:consume)]
  [dst : ir.CompilerIrValue]
  [src : ir.CompilerIrValue]
  [size : i64]
  [instr : ir.CompilerIrInstr]) : OptLoadCseState
  (match state
    ;; Same reasoning as the StorePtr arm: a copy through an unclassified
    ;; pointer may write a global slot, so the base map clears here too.
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (let
        [class : OptLoadStoreClass (opt-load-classify-store kinds dst size)]
        [src-class : OptLoadStoreClass (opt-load-classify-store kinds src size)]
        [store-root : OptAliasRoot (opt-alias-root-of-value facts dst)]
        [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
        [facts2 : OptAliasFacts
          (opt-load-alias-update-facts
            type-segment-bases
            facts
            kinds
            instr
            next-epoch)]
        [filtered : OptLoadTable
          (opt-load-table-filter-store
            type-segment-bases
            table
            facts
            store-root
            class)]
        (match class
          [(OptLoadStoreUnknown)
            (OptLoadCseState.State
              facts2
              filtered
              kinds
              table-cap
              next-epoch
              (opt-load-global-bases-clear bases)
              profile-state)]
          [(OptLoadStoreElement)
            (OptLoadCseState.State
              facts2
              filtered
              kinds
              table-cap
              next-epoch
              (opt-load-global-bases-clear bases)
              profile-state)]
          [(OptLoadStoreField dst-base dst-off _ dst-header?)
            (let
              [copied : OptLoadTable
                (match src-class
                  [(OptLoadStoreField src-base src-off _ src-header?)
                    (if (and
                      (= src-base dst-base)
                      (=
                        (if src-header?
                          1
                          0)
                        (if dst-header?
                          1
                          0))
                      (opt-load-ranges-disjoint? src-off size dst-off size))
                      (opt-load-table-transfer-copy-fields
                        profile-state
                        type-segment-bases
                        filtered
                        filtered
                        table-cap
                        gated?
                        sources
                        src-base
                        src-off
                        dst-base
                        dst-off
                        size
                        dst-header?
                        next-epoch)
                      filtered)]
                  [_ filtered])]
              (OptLoadCseState.State
                facts2
                copied
                kinds
                table-cap
                next-epoch
                (opt-load-global-bases-clear bases)
                profile-state))]))]))

(define (opt-load-cse-core-load
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [ty : ast.AstType]
  [instr : ir.CompilerIrInstr]) : OptLoadCseResult
  (match state
    ;; A Load writes nothing, so the base map is carried (through the same
    ;; transfer the pure arm uses -- the rewritten Mov can inherit a binding).
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (let
        ;; The dst redefinition drops stale entries first; the key is computed
        ;; from the PRE-def kinds and bases (a `Load dst <- dst` reads the old
        ;; address).
        [table2 : OptLoadTable (opt-load-table-invalidate-var table dst)]
        [key : OptLoadKey (opt-load-key-for-address kinds bases src ty)]
        [eligible? : bool
          (if gated?
            (and
              (opt-gvn-stable-var? sources dst)
              (opt-load-key-gvn-stable? sources key))
            true)]
        (match (if eligible?
          (opt-load-table-lookup type-segment-bases table2 key)
          (ir.CompilerIrMaybeValue.No))
          [(ir.CompilerIrMaybeValue.Some earlier)
            ;; Entries whose cached value is dst were dropped above, so the
            ;; rewrite never copies a var this instruction overwrites.
            (let
              [new-instr : ir.CompilerIrInstr
                (ir.CompilerIrInstr.Mov dst earlier ty)]
              [next-epoch : i64 (opt-load-cse-epoch-step epoch new-instr)]
              (OptLoadCseResult.Result
                (OptLoadCseState.State
                  (opt-load-alias-update-facts
                    type-segment-bases
                    facts
                    kinds
                    new-instr
                    next-epoch)
                  table2
                  (opt-load-kinds-step
                    profile-state
                    type-segment-bases
                    kinds
                    hs
                    new-instr)
                  table-cap
                  next-epoch
                  (opt-load-global-bases-step
                    type-segment-bases
                    bases
                    new-instr)
                  profile-state)
                new-instr))]
          [(ir.CompilerIrMaybeValue.No)
            (let
              [record? : bool
                (and eligible? (not (opt-load-key-uses-var? key dst)))]
              [next-epoch : i64 (opt-load-cse-epoch-step epoch instr)]
              (OptLoadCseResult.Result
                (OptLoadCseState.State
                  (opt-load-alias-update-facts
                    type-segment-bases
                    facts
                    kinds
                    instr
                    next-epoch)
                  (if record?
                    (opt-load-table-bind
                      profile-state
                      type-segment-bases
                      table2
                      table-cap
                      key
                      (ir.CompilerIrValue.Var dst)
                      next-epoch)
                    table2)
                  (opt-load-kinds-step
                    profile-state
                    type-segment-bases
                    kinds
                    hs
                    instr)
                  table-cap
                  next-epoch
                  (opt-load-global-bases-step type-segment-bases bases instr)
                  profile-state)
                instr))]))]))

;; Shared per-instruction dispatcher for the block-local (gated? false) and
;; cross-block (gated? true) passes. StorePtr/CopyBytes are matched before the
;; clear-all check: they ARE memory writes, handled granularly.
(define (opt-load-cse-dispatch
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [gated? : bool]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [instr : ir.CompilerIrInstr]) : OptLoadCseResult
  (match instr
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (OptLoadCseResult.Result
        (opt-load-cse-state-store
          type-segment-bases
          hs
          gated?
          sources
          state
          ptr
          value
          ty
          instr)
        instr)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (OptLoadCseResult.Result
        (opt-load-cse-state-copy-bytes
          type-segment-bases
          gated?
          sources
          state
          dst
          src
          size
          instr)
        instr)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (opt-load-cse-core-load
        type-segment-bases
        hs
        gated?
        sources
        state
        dst
        src
        ty
        instr)]
    [(ir.CompilerIrInstr.Call dst name args _)
      (OptLoadCseResult.Result
        (opt-load-cse-state-direct-call
          type-segment-bases
          hs
          call-memory
          state
          dst
          name
          args
          instr)
        instr)]
    [(ir.CompilerIrInstr.Store name _ _)
      (OptLoadCseResult.Result
        (opt-load-cse-state-global-store
          type-segment-bases
          hs
          state
          (ir.compiler-ir-symbol-id name)
          instr)
        instr)]
    [_
      (if (opt-alias-instr-clears-all? instr)
        (OptLoadCseResult.Result
          (opt-load-cse-state-clear-for-memory
            type-segment-bases
            hs
            state
            instr)
          instr)
        (OptLoadCseResult.Result
          (opt-load-cse-state-step-other type-segment-bases hs state instr)
          instr))]))

(define (opt-load-cse-instrs-from
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [state : OptLoadCseState]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match (opt-load-cse-dispatch
        type-segment-bases
        hs
        false
        sources
        call-memory
        state
        instr)
        [(OptLoadCseResult.Result next-state new-instr)
          (ir.compiler-ir-instr-cons
            new-instr
            (opt-load-cse-instrs-from
              type-segment-bases
              hs
              sources
              call-memory
              next-state
              (__tl-box-place rest)))])]))

(define (opt-load-cse-instrs
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (opt-load-cse-instrs-from
    type-segment-bases
    hs
    (opt_i64_i64_map.with-capacity 1)
    (opt_i64_i64_map.with-capacity 1)
    state
    instrs))

;; --- cross-block redundant-load GVN -----------------------------------------
(defenum OptMaybeLoadCseState
  (No)
  (Some OptLoadCseState))

(defenum OptLoadGvnBlockRewrite
  (Rewrite OptLoadCseState ir.CompilerIrInstrSeq))

(define (opt-load-cse-state-with-caps-and-facts
  [profile-state : profile_state.CompilerProfileMetrics]
  [table-cap : i64]
  [kinds-cap : i64]
  [facts : OptAliasFacts]) : OptLoadCseState
  (begin
    (cfg
      compile-profile
      (compiler-opt-load-cse-profile-note-table-cap profile-state table-cap))
    (OptLoadCseState.State
      facts
      (OptLoadTable.Nil)
      (opt-load-kinds-empty-with-cap profile-state kinds-cap)
      table-cap
      0
      (opt-load-global-bases-empty)
      profile-state)))

(define (opt-load-cse-empty-state-with-caps
  [profile-state : profile_state.CompilerProfileMetrics]
  [table-cap : i64]
  [kinds-cap : i64]) : OptLoadCseState
  (opt-load-cse-state-with-caps-and-facts
    profile-state
    table-cap
    kinds-cap
    (opt-alias-empty)))

(define (opt-load-cse-empty-state-for-size
  [profile-state : profile_state.CompilerProfileMetrics]
  [instr-count : i64]) : OptLoadCseState
  (opt-load-cse-empty-state-with-caps
    profile-state
    (opt-load-cse-table-cap-for-size instr-count)
    (opt-load-cse-kinds-cap-for-size instr-count)))

(define (opt-load-cse-empty-state-for-size-with-kinds
  [profile-state : profile_state.CompilerProfileMetrics]
  [instr-count : i64]
  [kinds : OptLoadPtrKinds]
  [facts : OptAliasFacts]) : OptLoadCseState
  (let
    [table-cap : i64 (opt-load-cse-table-cap-for-size instr-count)]
    (begin
      (cfg
        compile-profile
        (compiler-opt-load-cse-profile-note-table-cap profile-state table-cap))
      (OptLoadCseState.State
        facts
        (OptLoadTable.Nil)
        (opt-load-kinds-set-cap
          kinds
          (opt-load-cse-kinds-cap-for-size instr-count))
        table-cap
        0
        (opt-load-global-bases-empty)
        profile-state))))

;; The load table is persistent, but alias facts, pointer kinds, and global
;; bases are mutable tables; entering a block through a single predecessor must
;; process copies.
(define (opt-load-cse-state-clone-facts [state : OptLoadCseState]) : OptLoadCseState
  (match state
    [(OptLoadCseState.State
        facts
        table
        kinds
        table-cap
        epoch
        bases
        profile-state)
      (OptLoadCseState.State
        (opt-alias-clone facts)
        table
        (opt-load-kinds-clone profile-state kinds)
        table-cap
        epoch
        (opt-load-global-bases-clone bases)
        profile-state)]))

(defenum OptMaybeLoadEntry
  (No)
  (Some OptLoadEntry))

(define (opt-load-table-find-entry
  [type-segment-bases : i64]
  [table : OptLoadTable]
  [key : OptLoadKey]) : OptMaybeLoadEntry
  (match table
    [(OptLoadTable.Nil) (OptMaybeLoadEntry.No)]
    [(OptLoadTable.Cons entry rest)
      (if (opt-load-key-eq type-segment-bases (opt-load-entry-key entry) key)
        (OptMaybeLoadEntry.Some entry)
        (opt-load-table-find-entry type-segment-bases (__tl-box-place rest) key))]))

;; A joined entry must be older than every allocation both edges agree on, so it
;; keeps the LATER (larger) of the two creation epochs -- the conservative side
;; of the strict `entry-epoch < alloc-epoch` keep test.
(define (opt-load-table-intersect-entry
  [type-segment-bases : i64]
  [entry : OptLoadEntry]
  [other : OptLoadTable]) : OptMaybeLoadEntry
  (match entry
    [(OptLoadEntry.Entry key value epoch)
      (match (opt-load-table-find-entry type-segment-bases other key)
        [(OptMaybeLoadEntry.No) (OptMaybeLoadEntry.No)]
        [(OptMaybeLoadEntry.Some found)
          (if (opt-value-eq (opt-load-entry-value found) value)
            (OptMaybeLoadEntry.Some
              (OptLoadEntry.Entry
                key
                value
                (let
                  [found-epoch : i64 (opt-load-entry-epoch found)]
                  (if (< epoch found-epoch)
                    found-epoch
                    epoch))))
            (OptMaybeLoadEntry.No))])]))

(define (opt-load-table-intersect
  [type-segment-bases : i64]
  [a : OptLoadTable]
  [b : OptLoadTable]) : OptLoadTable
  (match a
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-intersect type-segment-bases (__tl-box-place rest) b)]
        (match (opt-load-table-intersect-entry type-segment-bases entry b)
          [(OptMaybeLoadEntry.Some merged)
            (OptLoadTable.Cons merged (box tail))]
          [(OptMaybeLoadEntry.No) tail]))]))

(define (opt-load-cse-state-intersect
  [type-segment-bases : i64]
  [a : OptLoadCseState]
  [b : OptLoadCseState]) : OptLoadCseState
  (match a
    [(OptLoadCseState.State
        afacts
        atable
        akinds
        atable-cap
        aepoch
        abases
        profile-state)
      (match b
        [(OptLoadCseState.State bfacts btable bkinds btable-cap bepoch bbases _)
          (OptLoadCseState.State
            (opt-alias-intersect afacts bfacts)
            (opt-load-table-intersect type-segment-bases atable btable)
            (opt-load-kinds-intersect profile-state akinds bkinds)
            (if (< atable-cap btable-cap)
              atable-cap
              btable-cap)
            ;; The counter takes the MAX so the next allocation's epoch still
            ;; exceeds every entry epoch arriving on either edge.
            (if (< aepoch bepoch)
              bepoch
              aepoch)
            (opt-load-global-bases-intersect abases bbases)
            profile-state)])]))

;; --- loop-header descriptor-entry carry ---------------------------------------
;;
;; A descriptor field load (array length/data pointer) reads memory provably
;; outside every data buffer, so a loop that only writes element memory
;; (scaled/element stores of a data pointer) cannot change it. When a loop
;; header's back edge arrives unprocessed in the RPO sweep, the entry table
;; keeps those header-typed entries whose base var is single-source instead
;; of resetting to the empty table -- provided a static scan proves the loop
;; has no calls, barriers, or stores that are not provably element-based.
;; Keep only descriptor-field entries whose base var is single-source.
(define (opt-load-table-filter-descriptor-stable
  [table : OptLoadTable]
  [sources : opt_i64_i64_map.Map]) : OptLoadTable
  (match table
    [(OptLoadTable.Nil) (OptLoadTable.Nil)]
    [(OptLoadTable.Cons entry rest)
      (let
        [tail : OptLoadTable
          (opt-load-table-filter-descriptor-stable
            (__tl-box-place rest)
            sources)]
        (match (opt-load-entry-key entry)
          [(OptLoadKey.Field base _ _ header?)
            (if (and header? (opt-gvn-stable-var? sources base))
              (OptLoadTable.Cons entry (box tail))
              tail)]
          ;; A named cell word is NOT carried, even though a loop-safe body (no
          ;; call, no clear-all, no `Store G`, element stores only) provably
          ;; leaves every cell alone, so the key would still name the same
          ;; location holding the same value. Measured: carrying it is a
          ;; register-pressure loss, because the carried handle drags the
          ;; descriptor words derived from it into the same loop-spanning live
          ;; range. One cachegrind run each, against this tier alone --
          ;; gvn_table 1,173,199,923 -> 1,169,328,223 (-3,871,700, the post-loop
          ;; re-derivation in gvn-facts-remove/-insert folding onto the
          ;; pre-loop walk) but peephole_lines 668,397,310 -> 670,418,364
          ;; (+2,021,054, +0.30%), all of it in pl_parse_line: its `pl-text`
          ;; cell, data pointer and length stop being re-derived per scan and
          ;; start being spilled and reloaded around the loop instead
          ;; (`movq %r9, 160(%rsp)` / `movq 152(%rsp), %rsi` appear where three
          ;; rip-relative loads used to be). Same shape as the call-arm carry
          ;; refusal above: the copy was never the cost, the live range is.
          [_ tail]))]))

;; Find the (single, SSA) instruction defining `var` anywhere in the function.
(define (opt-load-gvn-find-def-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (= (opt-gvn-instr-dst instr) var)
        (OptMaybeInstr.Some instr)
        (opt-load-gvn-find-def-instrs instrs (+ index 1) var)))))

(define (opt-load-gvn-find-def [blocks : ir.CompilerIrBlockList] [var : i64]) : OptMaybeInstr
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptMaybeInstr.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-load-gvn-find-def-instrs instrs 0 var)
            [(OptMaybeInstr.Some instr) (OptMaybeInstr.Some instr)]
            [(OptMaybeInstr.No)
              (opt-load-gvn-find-def (__tl-box-place rest) var)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-gvn-find-def (ir.compiler-ir-block-seq-to-list seq) var)]))

;; Is `var` provably an element (data-buffer) address? A gep of an element
;; base stays in the buffer; a load of a header descriptor's first word is the
;; data pointer (the element root); phis and movs chase through. Depth-capped
;; against non-SSA cycles.
(define (opt-load-gvn-element-base?
  [hs : OptLoadHeaderSet]
  [blocks : ir.CompilerIrBlockList]
  [var : i64]
  [depth : i64]) : bool
  (if (>= depth 8)
    false
    (match (opt-load-gvn-find-def blocks var)
      [(OptMaybeInstr.Some instr)
        (match instr
          [(ir.CompilerIrInstr.Gep _ base _ _)
            (match base
              [(ir.CompilerIrValue.Var bvar)
                (opt-load-gvn-element-base? hs blocks bvar (+ depth 1))]
              [_ false])]
          [(ir.CompilerIrInstr.Mov _ src _)
            (match src
              [(ir.CompilerIrValue.Var svar)
                (opt-load-gvn-element-base? hs blocks svar (+ depth 1))]
              [_ false])]
          [(ir.CompilerIrInstr.Load _ src _)
            (match src
              [(ir.CompilerIrValue.Var pvar)
                (if (opt-load-header-var? hs pvar)
                  true
                  (match (opt-load-gvn-find-def blocks pvar)
                    [(OptMaybeInstr.Some addr-def)
                      (match addr-def
                        [(ir.CompilerIrInstr.Gep _ gbase goff _)
                          (and
                            (match gbase
                              [(ir.CompilerIrValue.Var dvar)
                                (opt-load-header-var? hs dvar)]
                              [_ false])
                            (match goff
                              [(ir.CompilerIrValue.I64 0) true]
                              [_ false]))]
                        [_ false])]
                    [(OptMaybeInstr.No) false]))]
              [_ false])]
          [(ir.CompilerIrInstr.Phi _ inputs _)
            (opt-load-gvn-element-base-phi? hs blocks inputs (+ depth 1))]
          [_ false])]
      [(OptMaybeInstr.No) false])))

(define (opt-load-gvn-element-base-phi?
  [hs : OptLoadHeaderSet]
  [blocks : ir.CompilerIrBlockList]
  [inputs : ir.CompilerIrPhiInputList]
  [depth : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (match value
        [(ir.CompilerIrValue.Var v)
          (if (opt-load-gvn-element-base? hs blocks v depth)
            (opt-load-gvn-element-base-phi?
              hs
              blocks
              (__tl-box-place rest)
              depth)
            false)]
        [_ false])]
    ;; force-cons normalizes the array form away.
    [(ir.CompilerIrPhiInputList.Array _) true]))

;; Scan one instruction for loop-carry safety: calls and clear-alls are out,
;; stores must be element-based.
;;
;; A CALL is rejected even when the per-callee summary proves it writes no
;; descriptor field (element-only or write-free), which
;; opt-load-table-filter-element-call is happy to act on at an ordinary call
;; site. Measurement is why, and it stayed why after substitution mode landed.
;;
;; The first measurement was made against the Mov form of the rewrite. Carrying
;; a descriptor entry across a loop back edge did not DELETE the loop body's
;; load, it rewrote it to a copy of a var defined outside the loop -- and that
;; copy's source stays live around the back edge, so register allocation cannot
;; coalesce the copy away. LICM already hoists the un-rewritten load into the
;; preheader, where it runs once per loop ENTRY; the rewrite traded that for one
;; move per ITERATION. Measured on benchmarks/gvn_table (gvn-scan-ints, whose
;; outer loop's only call is the element-only vector setter): descriptor-field
;; loads fell 5,369,431 -> 2,684,716 Ir per round and the function still grew
;; 80,342,627 -> 82,683,001, because the digit-scan inner loop gained
;; `mov %r12,%r9` at 2,064,917 executions in exchange for a preheader load at
;; 1,275,750.
;;
;; RE-TESTED under substitution mode (opt-load-gvn-subst-pair), which was
;; expected to rescue the widening by deleting the load instead of copying it.
;; The rewrite half worked exactly as predicted -- with the call arm admitted,
;; gvn-scan-ints lost all three carried `gep %0, 8` + `load` pairs outright and
;; every use read the preheader load directly, the LICM shape with zero copies
;; -- and the benchmark still LOST. Admitting the call arm on top of
;; substitution mode moved gvn_table 1,179,567,963 -> 1,181,908,337 Ir
;; (+2,340,374, +0.20%) and cfg_domloops +834,661 (measured against the
;; then-current substitution build, before the loop-escape gate below); no other
;; row moved. +2,340,374 is the SAME delta the Mov form paid, which is the
;; result: the copy was never the cost. The cost is the carried value's live
;; range spanning the digit-scan inner loop, and deleting the copy does not
;; shorten it. The carry stays rejected; substitution mode ships without it.
(define (opt-load-gvn-loop-safe-instr?
  [hs : OptLoadHeaderSet]
  [blocks : ir.CompilerIrBlockList]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.StorePtr ptr _ _)
      (match ptr
        [(ir.CompilerIrValue.Var pvar)
          (opt-load-gvn-element-base? hs blocks pvar 0)]
        [_ false])]
    [(ir.CompilerIrInstr.Store _ _ _) false]
    [(ir.CompilerIrInstr.VectorStore _) false]
    [(ir.CompilerIrInstr.PredicatedStore _) false]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) false]
    [_ (not (opt-alias-instr-clears-all? instr))]))

;; Scan the loop body's blocks.
(define (opt-load-gvn-loop-safe-blocks?
  [hs : OptLoadHeaderSet]
  [all-blocks : ir.CompilerIrBlockList]
  [body : ir.CompilerIrBlockList]) : bool
  (match body
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-load-gvn-loop-safe-instr-seq? hs all-blocks instrs 0)
            (opt-load-gvn-loop-safe-blocks? hs all-blocks (__tl-box-place rest))
            false)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-gvn-loop-safe-blocks?
        hs
        all-blocks
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-load-gvn-loop-safe-instr-seq?
  [hs : OptLoadHeaderSet]
  [all-blocks : ir.CompilerIrBlockList]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (if (opt-load-gvn-loop-safe-instr?
      hs
      all-blocks
      (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-load-gvn-loop-safe-instr-seq? hs all-blocks instrs (+ index 1))
      false)))

(define (opt-load-gvn-loop-safe-contains? [safe : OptLabelSet] [label : i64]) : bool
  (opt-label-contains safe label))

(define (opt-load-gvn-loop-safe-collect
  [hs : OptLoadHeaderSet]
  [blocks : ir.CompilerIrBlockList]
  [loops : OptNaturalLoopList]) : OptLabelSet
  (match loops
    [(OptNaturalLoopList.Nil) (OptLabelSet.Nil)]
    [(OptNaturalLoopList.Cons loop rest)
      (let
        [tail : OptLabelSet
          (opt-load-gvn-loop-safe-collect hs blocks (__tl-box-place rest))]
        (if (opt-load-gvn-loop-safe-blocks?
          hs
          blocks
          (opt-natural-loop-body-blocks loop))
          (opt-label-cons (opt-natural-loop-header loop) tail)
          tail))]))

(define (opt-load-gvn-entry-from-preds
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [exit-states : (__tl_dyn-array OptMaybeLoadCseState)]
  [processed : (__tl_dyn-array bool)]
  [sources : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [label : i64]
  [empty-state : OptLoadCseState]
  [edge : i64]
  [end : i64]
  [has-state : bool]
  [saw-unprocessed : bool]
  [acc : OptLoadCseState]) : OptLoadCseState
  (if (>= edge end)
    (if saw-unprocessed
      ;; A back edge arrived unprocessed: memory contents along it are unknown,
      ;; so the table and alias facts come from empty-state, but stable kinds
      ;; are value properties the back edge cannot change -- keep them. A loop
      ;; proven to write only element memory also keeps its descriptor-field
      ;; entries (header-typed, stable base): those loads live outside every
      ;; data buffer, so the loop's stores cannot reach them. Global bases do
      ;; NOT carry: the unprocessed edge may write the global slot a binding
      ;; read, which would make the binding name a stale address.
      (match acc
        [(OptLoadCseState.State
            _
            acc-table
            acc-kinds
            _
            acc-epoch
            _
            profile-state)
          (match empty-state
            [(OptLoadCseState.State empty-facts empty-table _ empty-cap _ _ _)
              (OptLoadCseState.State
                empty-facts
                (if (opt-load-gvn-loop-safe-contains? loop-safe label)
                  (opt-load-table-filter-descriptor-stable acc-table sources)
                  empty-table)
                (opt-load-kinds-filter-stable profile-state acc-kinds sources)
                empty-cap
                ;; Carried entries keep their creation epochs, so the counter
                ;; must be the accumulated predecessors' value: resetting it to
                ;; zero would let a loop-body allocation claim an epoch that a
                ;; surviving entry already used.
                acc-epoch
                (opt-load-global-bases-empty)
                profile-state)])])
      acc)
    (let
      [pred : i64 (array-ref index.preds.edges edge)]
      (if (not (array-ref index.reachable pred))
        (opt-load-gvn-entry-from-preds
          type-segment-bases
          index
          exit-states
          processed
          sources
          loop-safe
          label
          empty-state
          (+ edge 1)
          end
          has-state
          saw-unprocessed
          acc)
        (if (not (array-ref processed pred))
          (opt-load-gvn-entry-from-preds
            type-segment-bases
            index
            exit-states
            processed
            sources
            loop-safe
            label
            empty-state
            (+ edge 1)
            end
            has-state
            true
            acc)
          (match (array-ref exit-states pred)
            [(OptMaybeLoadCseState.Some pred-state)
              (opt-load-gvn-entry-from-preds
                type-segment-bases
                index
                exit-states
                processed
                sources
                loop-safe
                label
                empty-state
                (+ edge 1)
                end
                true
                saw-unprocessed
                (if has-state
                  (opt-load-cse-state-intersect
                    type-segment-bases
                    acc
                    pred-state)
                  (opt-load-cse-state-clone-facts pred-state)))]
            [(OptMaybeLoadCseState.No)
              (opt-load-gvn-entry-from-preds
                type-segment-bases
                index
                exit-states
                processed
                sources
                loop-safe
                label
                empty-state
                (+ edge 1)
                end
                has-state
                true
                acc)]))))))

(define (opt-load-gvn-entry-state
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [exit-states : (__tl_dyn-array OptMaybeLoadCseState)]
  [processed : (__tl_dyn-array bool)]
  [sources : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [empty-state : OptLoadCseState]
  [id : i64]) : OptLoadCseState
  (let
    [index : OptCfgIndex context.index]
    [preds : OptCfgCsr index.preds]
    [entry-label : i64 context.entry-label]
    (match (opt-cfg-index-id index entry-label)
      [(option_i64.Some entry-id)
        (if (= id entry-id)
          empty-state
          (opt-load-gvn-entry-from-preds
            type-segment-bases
            index
            exit-states
            processed
            sources
            loop-safe
            (opt-cfg-index-label index id)
            empty-state
            (array-ref preds.offsets id)
            (array-ref preds.offsets (+ id 1))
            false
            false
            empty-state))]
      [(option_i64.None) empty-state])))

;; Same shape as the const-divisor rewrite: one instruction out per instruction
;; in, so the CSE state threads through an indexed walk that fills a sized target
;; sequence instead of consing a reversed list and reversing it back.
(define (opt-load-gvn-instr-seq
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]) : OptLoadGvnBlockRewrite
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    [current : OptLoadCseState state]
    (begin
      (while (< index count)
        (begin
          (set!
            current
            (match (opt-load-cse-dispatch
              type-segment-bases
              hs
              true
              sources
              call-memory
              current
              (ir.compiler-ir-instr-seq-ref instrs index))
              [(OptLoadCseResult.Result next-state new-instr)
                (begin
                  (set! (array-ref slots index) new-instr)
                  next-state)]))
          (set! index (+ index 1))))
      (OptLoadGvnBlockRewrite.Rewrite
        current
        (ir.CompilerIrInstrSeq slots count)))))

(define (opt-load-gvn-rewrite-block
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-state : OptLoadCseState]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [block : ir.CompilerIrBlock]) : OptLoadGvnBlockRewrite
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-load-gvn-instr-seq
        type-segment-bases
        hs
        entry-state
        sources
        call-memory
        instrs)]))

(define (opt-load-gvn-process-id
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [hs : OptLoadHeaderSet]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [exit-states : (__tl_dyn-array OptMaybeLoadCseState)]
  [processed : (__tl_dyn-array bool)]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [empty-state : OptLoadCseState]
  [id : i64]) : unit
  (let
    [index : OptCfgIndex context.index]
    [entry-state : OptLoadCseState
      (opt-load-gvn-entry-state
        type-segment-bases
        context
        exit-states
        processed
        sources
        loop-safe
        empty-state
        id)]
    (match (opt-cfg-index-block index id)
      [(OptMaybeBlock.No) unit]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block block-label _)
            (match (opt-load-gvn-rewrite-block
              type-segment-bases
              hs
              entry-state
              sources
              call-memory
              block)
              [(OptLoadGvnBlockRewrite.Rewrite exit-state instrs)
                (begin
                  (set!
                    (array-ref out id)
                    (OptGvnBlockResult.SomeBlock
                      (ir.CompilerIrBlock.Block block-label instrs)))
                  (set!
                    (array-ref exit-states id)
                    (OptMaybeLoadCseState.Some exit-state))
                  (set! (array-ref processed id) true))])])])))

(define (opt-load-gvn-process-rpo
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [hs : OptLoadHeaderSet]
  [sources : opt_i64_i64_map.Map]
  [call-memory : opt_i64_i64_map.Map]
  [loop-safe : OptLabelSet]
  [exit-states : (__tl_dyn-array OptMaybeLoadCseState)]
  [processed : (__tl_dyn-array bool)]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [empty-state : OptLoadCseState]
  [slot : i64]) : unit
  (let
    [index : OptCfgIndex context.index]
    [reach-count : i64 index.reach-count]
    (if (>= slot reach-count)
      unit
      (let
        [id : i64 (opt-cfg-index-rpo-id index slot)]
        (begin
          (opt-load-gvn-process-id
            type-segment-bases
            context
            hs
            sources
            call-memory
            loop-safe
            exit-states
            processed
            out
            empty-state
            id)
          (opt-load-gvn-process-rpo
            type-segment-bases
            context
            hs
            sources
            call-memory
            loop-safe
            exit-states
            processed
            out
            empty-state
            (+ slot 1)))))))

;; Cheap any-Load pre-scan for the cross-block load GVN (allocation-free,
;; exits at the first load). The pass can only rewrite a Load, so a function
;; containing no loads is returned unchanged and avoids the whole-function
;; empty state plus the three per-block arrays. One load is enough to run the
;; pass: StorePtr can seed the value table for a later load through
;; store-to-load forwarding.
(define (opt-load-gvn-instr-load? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [_ false]))

(define (opt-load-gvn-instr-seq-has-load?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-load-gvn-instr-load? (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-load-gvn-instr-seq-has-load? instrs (+ index 1)))))

(define (opt-load-gvn-block-seq-has-load?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (match (ir.compiler-ir-block-seq-ref blocks index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (if (opt-load-gvn-instr-seq-has-load? instrs 0)
          true
          (opt-load-gvn-block-seq-has-load? blocks (+ index 1)))])))

(define (opt-load-gvn-blocks-have-load? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-load-gvn-instr-seq-has-load? instrs 0)
            true
            (opt-load-gvn-blocks-have-load? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-gvn-block-seq-has-load? seq 0)]))

;; --- load-GVN substitution mode ---------------------------------------------
;;
;; opt-load-cse-core-load rewrites a redundant load to `Mov dst earlier`: a COPY
;; that only pays once register allocation coalesces it away, and that cannot
;; coalesce when the two live ranges overlap (the loop case documented at
;; opt-load-gvn-loop-safe-instr?). Substitution mode removes the copy instead of
;; hoping for a coalesce: rewrite every USE of `dst` to `earlier` and delete the
;; copy, which for loop-carried reuse equals the LICM outcome (one def outside,
;; uses inside, zero copies).
;;
;; Legality. `earlier` was available at the load, so its def dominates the load;
;; the load dominates every SSA use of `dst`; so the def dominates every
;; substituted use. Both vars are required single-source (opt-gvn-stable-var?)
;; so no intervening redefinition can break that chain -- the cross-block pass
;; already demands it of `dst`, this adds the same demand on `earlier`.
;;
;; Phi uses are the one position where the transitivity argument fails: a phi
;; input's use position is the incoming EDGE's predecessor end, not the phi's
;; block, and the load need not dominate that predecessor. opt-copy-subst-instr
;; already refuses phi inputs (and AddrOf storage names, and the private vector
;; aggregates), so those uses survive substitution -- and a surviving use is
;; exactly what keeps the copy alive here: the copy is deleted only when the
;; substituted function has ZERO remaining uses of `dst`, the same use-count
;; test DCE deletes a Mov on. A load whose value reaches a phi therefore falls
;; back to today's Mov form, with no dominance query needed.
;;
;; PRESSURE, and the one profitability gate. Against the Mov form substitution
;; never costs a register: from the copy to `dst`'s last use the Mov form keeps
;; `dst` live and `earlier` live too wherever `earlier` has a later use, so the
;; merged range is never the wider one. Against NOT eliminating the load it can,
;; because a load re-reads memory and holds nothing in between -- and the pass
;; feeds itself, so a substitution that canonicalizes one address exposes a
;; second redundant load the Mov form never reached. The shape that loses is a
;; dominating def INSIDE a loop feeding a load OUTSIDE it: the value then has to
;; survive every later block instead of dying at its loop's exit. Measured on
;; benchmarks/cfg_domloops (cfg-idom-iterate): the `%96 = load` in one inner
;; loop's header forwarded to the sibling inner loop's header two blocks later,
;; deleting a gep+load pair per iteration but pinning %96 across the second loop
;; -- 798,103,345 -> 801,917,881 Ir (+0.48%). The register the second loop lost
;; pushed its data pointer into %rbp, which the backend cannot spell as a SIB
;; base (see #rbp-base at compiler-backend-address-base-register-ok?), so each
;; indexed read grew a `movq %rbp,%rN` -- four of them across the loop's two
;; clones. So the gate: a substitution may shorten a value's live range or
;; extend it WITHIN the loops it already lives in, never carry it out of one.
;; Literals are exempt (no live range at all), which is the store-to-load
;; forwarded constant that folds a bounds guard away in the spmd rows.
(define (opt-load-gvn-subst-escapes-loop?
  [loop-masks : (__tl_dyn-array i64)]
  [def-blocks : (__tl_dyn-array i64)]
  [load-id : i64]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (or (< var 0) (>= var (array-length def-blocks)))
        true
        (let
          ;; def-blocks stores id+1, so 0 is "no def recorded in this function"
          ;; -- a parameter or an entry-live var, neither of which is in a loop.
          [def-id : i64 (- (array-ref def-blocks var) 1)]
          (if (< def-id 0)
            false
            (if (or
              (< load-id 0)
              (>= load-id (array-length loop-masks))
              (>= def-id (array-length loop-masks)))
              true
              (not
                (=
                  (bit-and
                    (array-ref loop-masks def-id)
                    (bit-not (array-ref loop-masks load-id)))
                  0))))))]
    [_ false]))

;; The gate-free half of the candidate test, shared by the pre-scan and the
;; gated walk.
(define (opt-load-gvn-subst-candidate?
  [sources : opt_i64_i64_map.Map]
  [original : ir.CompilerIrInstr]
  [rewritten : ir.CompilerIrInstr]) : bool
  (match original
    [(ir.CompilerIrInstr.Load load-dst _ _)
      (match rewritten
        [(ir.CompilerIrInstr.Mov mov-dst src _)
          (and
            (= load-dst mov-dst)
            (opt-gvn-stable-var? sources mov-dst)
            (opt-gvn-value-stable? sources src)
            (not (opt-value-is-var? src mov-dst)))]
        [_ false])]
    [_ false]))

(define (opt-load-gvn-subst-pair
  [sources : opt_i64_i64_map.Map]
  [loop-masks : (__tl_dyn-array i64)]
  [def-blocks : (__tl_dyn-array i64)]
  [load-id : i64]
  [original : ir.CompilerIrInstr]
  [rewritten : ir.CompilerIrInstr]
  [env : OptCopyEnv]) : OptCopyEnv
  (if (not (opt-load-gvn-subst-candidate? sources original rewritten))
    env
    (match rewritten
      [(ir.CompilerIrInstr.Mov mov-dst src _)
        (let
          [resolved : ir.CompilerIrValue (opt-copy-resolve env src)]
          (if (opt-load-gvn-subst-escapes-loop?
            loop-masks
            def-blocks
            load-id
            resolved)
            env
            (OptCopyEnv.Cons mov-dst resolved (box env))))]
      [_ env])))

;; Record where each var is defined, as block id + 1. The walk is in RPO, and a
;; substituted value's def dominates its load, so the def is always already
;; recorded when the load is reached.
(define (opt-load-gvn-record-def
  [def-blocks : (__tl_dyn-array i64)]
  [block-id : i64]
  [instr : ir.CompilerIrInstr]) : unit
  (let
    [dst : i64 (opt-gvn-instr-dst instr)]
    (if (or (< dst 0) (>= dst (array-length def-blocks)))
      unit
      (begin
        (set! (array-ref def-blocks dst) (+ block-id 1))
        unit))))

;; Pair the pass input block with its rewrite. The rewrite is 1:1 in index and
;; order, so an index whose input is a Load and whose output is a Mov to the
;; same dst is exactly one redundant-load rewrite.
(define (opt-load-gvn-subst-block-env
  [sources : opt_i64_i64_map.Map]
  [loop-masks : (__tl_dyn-array i64)]
  [def-blocks : (__tl_dyn-array i64)]
  [block-id : i64]
  [original : ir.CompilerIrBlock]
  [rewritten : ir.CompilerIrBlock]
  [env : OptCopyEnv]) : OptCopyEnv
  (match original
    [(ir.CompilerIrBlock.Block _ original-instrs)
      (match rewritten
        [(ir.CompilerIrBlock.Block _ rewritten-instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count original-instrs)]
            [paired? : bool
              (= count (ir.compiler-ir-instr-seq-count rewritten-instrs))]
            [index : i64 0]
            [acc : OptCopyEnv env]
            (begin
              (while (< index count)
                (begin
                  (if paired?
                    (set!
                      acc
                      (opt-load-gvn-subst-pair
                        sources
                        loop-masks
                        def-blocks
                        block-id
                        (ir.compiler-ir-instr-seq-ref original-instrs index)
                        (ir.compiler-ir-instr-seq-ref rewritten-instrs index)
                        acc))
                    unit)
                  (opt-load-gvn-record-def
                    def-blocks
                    block-id
                    (ir.compiler-ir-instr-seq-ref original-instrs index))
                  (set! index (+ index 1))))
              acc))])]))

;; Allocation-free pre-scan: does any rewrite in this function clear the
;; gate-free half of the candidate test? A function with none skips the frame
;; walk and the two per-block-id arrays entirely.
(define (opt-load-gvn-subst-block-any?
  [sources : opt_i64_i64_map.Map]
  [original : ir.CompilerIrBlock]
  [rewritten : ir.CompilerIrBlock]) : bool
  (match original
    [(ir.CompilerIrBlock.Block _ original-instrs)
      (match rewritten
        [(ir.CompilerIrBlock.Block _ rewritten-instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count original-instrs)]
            [index : i64 0]
            [found : bool false]
            (begin
              (if (= count (ir.compiler-ir-instr-seq-count rewritten-instrs))
                (while (and (not found) (< index count))
                  (begin
                    (if (opt-load-gvn-subst-candidate?
                      sources
                      (ir.compiler-ir-instr-seq-ref original-instrs index)
                      (ir.compiler-ir-instr-seq-ref rewritten-instrs index))
                      (set! found true)
                      unit)
                    (set! index (+ index 1))))
                unit)
              found))])]))

(define (opt-load-gvn-subst-any?
  [index : OptCfgIndex]
  [sources : opt_i64_i64_map.Map]
  [out : (__tl_dyn-array OptGvnBlockResult)]) : bool
  (let
    [count : i64 (array-length out)]
    [id : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< id count))
        (begin
          (match (array-ref out id)
            [(OptGvnBlockResult.SomeBlock rewritten)
              (match (opt-cfg-index-block index id)
                [(OptMaybeBlock.Some original)
                  (if (opt-load-gvn-subst-block-any? sources original rewritten)
                    (set! found true)
                    unit)]
                [(OptMaybeBlock.No) unit])]
            [(OptGvnBlockResult.NoBlock) unit])
          (set! id (+ id 1))))
      found)))

;; Natural-loop membership per block id, one bit per loop. Loops past bit 61
;; share the sentinel bit, which only ever makes the escape test coarser (two
;; loops that share a bit read as one), never unsound: the gate is a
;; profitability rule, not a legality rule.
(define (opt-load-gvn-loop-mask-bit [loop-index : i64]) : i64
  (if (< loop-index 62)
    (shl 1 loop-index)
    (shl 1 62)))

(define (opt-load-gvn-loop-mask-mark
  [loop-masks : (__tl_dyn-array i64)]
  [members : (__tl_dyn-array bool)]
  [bit : i64]) : unit
  (let
    [count : i64 (array-length loop-masks)]
    [id : i64 0]
    (begin
      (while (< id count)
        (begin
          (if (opt-loop-body-member-array-contains-id? members id)
            (begin
              (set!
                (array-ref loop-masks id)
                (bit-or (array-ref loop-masks id) bit))
              unit)
            unit)
          (set! id (+ id 1))))
      unit)))

(define (opt-load-gvn-loop-masks-fill
  [loop-masks : (__tl_dyn-array i64)]
  [loops : OptNaturalLoopList]
  [loop-index : i64]) : unit
  (match loops
    [(OptNaturalLoopList.Nil) unit]
    [(OptNaturalLoopList.Cons loop rest)
      (begin
        (opt-load-gvn-loop-mask-mark
          loop-masks
          (opt-natural-loop-body-members loop)
          (opt-load-gvn-loop-mask-bit loop-index))
        (opt-load-gvn-loop-masks-fill
          loop-masks
          (__tl-box-place rest)
          (+ loop-index 1)))]))

(define (opt-load-gvn-subst-env
  [index : OptCfgIndex]
  [sources : opt_i64_i64_map.Map]
  [loop-masks : (__tl_dyn-array i64)]
  [frame : i64]
  [out : (__tl_dyn-array OptGvnBlockResult)]) : OptCopyEnv
  (let
    [def-blocks : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [reach-count : i64 index.reach-count]
    [slot : i64 0]
    [env : OptCopyEnv (OptCopyEnv.Nil)]
    (begin
      (while (< slot reach-count)
        (begin
          (let
            [id : i64 (opt-cfg-index-rpo-id index slot)]
            (match (array-ref out id)
              [(OptGvnBlockResult.SomeBlock rewritten)
                (match (opt-cfg-index-block index id)
                  [(OptMaybeBlock.Some original)
                    (begin
                      (set!
                        env
                        (opt-load-gvn-subst-block-env
                          sources
                          loop-masks
                          def-blocks
                          id
                          original
                          rewritten
                          env))
                      unit)]
                  [(OptMaybeBlock.No) unit])]
              [(OptGvnBlockResult.NoBlock) unit]))
          (set! slot (+ slot 1))))
      env)))

;; Substitute the env through one block's instructions and count the operand
;; uses of the RESULT, so the surviving-use test below sees post-substitution
;; counts.
(define (opt-load-gvn-subst-seq
  [env : OptCopyEnv]
  [used : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (let
            [next : ir.CompilerIrInstr
              (opt-copy-subst-instr
                env
                (ir.compiler-ir-instr-seq-ref instrs index))]
            (begin
              (set! (array-ref slots index) next)
              (opt-collect-instr-uses-array used next)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-load-gvn-subst-blocks
  [env : OptCopyEnv]
  [used : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-load-gvn-subst-seq env used instrs))
            (opt-load-gvn-subst-blocks env used (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-gvn-subst-blocks
        env
        used
        (ir.compiler-ir-block-seq-to-list seq))]))

;; A rewritten load's copy is dead exactly when substitution reached every use
;; of its destination.
(define (opt-load-gvn-dead-copy?
  [env : OptCopyEnv]
  [used : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _)
      (if (opt-used-array-contains used dst)
        false
        (match (opt-copy-lookup env dst)
          [(ir.CompilerIrMaybeValue.Some _) true]
          [(ir.CompilerIrMaybeValue.No) false]))]
    [_ false]))

;; Compaction runs over the slot arrays opt-load-gvn-subst-seq just allocated,
;; so it may write them in place; the returned seq re-lengths the same storage.
(define (opt-load-gvn-drop-copies-seq
  [env : OptCopyEnv]
  [used : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (begin
          (if (opt-load-gvn-dead-copy? env used (array-ref slots read))
            unit
            (begin
              (if (not (= read write))
                (set! (array-ref slots write) (array-ref slots read))
                unit)
              (set! write (+ write 1))))
          (set! read (+ read 1))))
      (ir.CompilerIrInstrSeq slots write))))

(define (opt-load-gvn-drop-copies-blocks
  [env : OptCopyEnv]
  [used : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-load-gvn-drop-copies-seq env used instrs))
            (opt-load-gvn-drop-copies-blocks env used (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-gvn-drop-copies-blocks
        env
        used
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-load-gvn-substitute
  [frame : i64]
  [env : OptCopyEnv]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    ;; Substitution never mints a var, so the pre-substitution frame bounds the
    ;; result's var ids.
    [used : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [substituted : ir.CompilerIrBlockList
      (opt-load-gvn-subst-blocks env used blocks)]
    (opt-load-gvn-drop-copies-blocks env used substituted)))

(define (opt-load-gvn-blocks-with-context
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [sources : opt_i64_i64_map.Map]
  [hs : OptLoadHeaderSet]
  [params : ir.CompilerIrParamList]
  [call-memory : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (not (opt-load-gvn-blocks-have-load? blocks))
    ;; No loads: no rewrite can fire, so the pass output equals the input; skip
    ;; the empty state and the per-block arrays.
    blocks
    (let
      [index : OptCfgIndex context.index]
      [count : i64 (opt-cfg-index-block-count index)]
      [exit-states : (__tl_dyn-array OptMaybeLoadCseState)
        (array.make-array OptMaybeLoadCseState count)]
      [processed : (__tl_dyn-array bool) (array.make-array bool count)]
      [out : (__tl_dyn-array OptGvnBlockResult)
        (array.make-array OptGvnBlockResult count)]
      [loops : OptNaturalLoopList
        (opt-cfg-natural-loops-with-context blocks context)]
      [loop-safe : OptLabelSet (opt-load-gvn-loop-safe-collect hs blocks loops)]
      [empty-state : OptLoadCseState
        (opt-load-cse-state-with-caps-and-facts
          profile-state
          (opt-load-cse-table-cap-for-size
            (ir.compiler-ir-block-list-instruction-count blocks))
          (opt-load-cse-kinds-cap-for-size
            (ir.compiler-ir-block-list-instruction-count blocks))
          (opt-alias-seed-params type-segment-bases params))]
      (begin
        (opt-cfg-index-refresh-blocks! index blocks)
        (opt-load-gvn-process-rpo
          type-segment-bases
          context
          hs
          sources
          call-memory
          loop-safe
          exit-states
          processed
          out
          empty-state
          0)
        ;; Substitution mode: where the rewrite's uses can all be redirected to
        ;; the dominating def, redirect them and delete the copy. The env is
        ;; read from the input/output instruction pairing, so the streaming
        ;; rewrite above needs no extra plumbing; an empty env (no rewrite
        ;; fired, or every rewrite was gated out) keeps the materialized blocks
        ;; untouched.
        (let
          [materialized : ir.CompilerIrBlockList
            (opt-gvn-materialize-blocks context.doms out blocks)]
          (if (not (opt-load-gvn-subst-any? index sources out))
            materialized
            (let
              [frame : i64
                (+
                  1
                  (opt-sccp-max-var-params
                    params
                    (opt-sccp-max-var-blocks blocks (- 0 1))))]
              [loop-masks : (__tl_dyn-array i64) (array.make-array i64 count)]
              (begin
                (opt-load-gvn-loop-masks-fill loop-masks loops 0)
                (let
                  [subst : OptCopyEnv
                    (opt-load-gvn-subst-env index sources loop-masks frame out)]
                  (match subst
                    [(OptCopyEnv.Nil) materialized]
                    [_ (opt-load-gvn-substitute frame subst materialized)]))))))))))