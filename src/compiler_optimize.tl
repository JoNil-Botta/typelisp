;; compiler_optimize.tl - Selfhost optimizer: pass framework + scalar constant
;; folding.
;;
;; Runs between lowering (`lower-compiler-program`) and backend emission
;; (`compiler-backend-emit-program-for-target`). It performs conservative, scalar-only
;; local rewrites: constant folding, algebraic strength reduction, CSE, copy
;; propagation, conservative global value numbering/cross-block copy
;; propagation, conservative loop-invariant scalar hoisting, redundant
;; bounds-check elimination, conservative CFG simplification, and DCE.
;;
;; Safety:
;; - Integer `+`, `-`, `*`, bitwise ops, shifts, and `neg` are folded through
;;   helpers that normalize the result back to the instruction type. This keeps
;;   narrow signed/unsigned widths and `char` byte semantics explicit.
;; - Division, modulo, and shifts fold only when the static operands avoid the
;;   same runtime traps emitted by lowering: zero divisors, signed MIN / -1, and
;;   out-of-range shift counts remain in the IR.
;; - Tracking is block-local (reset per block), so no value is folded across a
;;   control-flow edge.
;;
;; Out of scope: broad aggregate/String/array transformations beyond
;; fixed-representation register-value SSA.
(import stdlib.io)
(cfg compile-profile (import stdlib.profile))
(cfg test (import stdlib.test))
(import stdlib.comptime)
(import stdlib.vector)
(import stdlib.text_buf)
(import compiler_allocation_profile as allocation_profile)
(import compiler_profile_state as profile_state)
(cfg (any compile-profile test) (import compiler_profile_counters as counters))
(import compiler_builtin_ids as cbi)
(import compiler_ir_types as ir)
(import compiler_intern_state as cis)
(import compiler_ast_types as ast)
(import compiler_owned_view as owned_view)
(import stdlib.runtime)

;; The inliner's measured-plan check (opt-inline-checked-*) reads one register
;; allocation plan per candidate to price the caller's prologue and spill
;; traffic. The allocator is standalone-callable on a single IR function, and
;; nothing downstream of the check reads the plan -- it feeds accept-or-revert
;; only -- so this is a read-only dependency on the allocator's own facts, not a
;; layering inversion in the pipeline.
(import compiler_regalloc as reg)
(import compiler_float as cfloat)
(import stdlib.arena)
(import stdlib.hash)
(import stdlib.hashmap)
(import (hashmap.hashmap i64 i64) as opt_string_i64_map)
(import (hashmap.hashmap i64 i64) as opt_i64_i64_map)
(import stdlib.string)
(import stdlib.str_cat_runtime as str_cat)
(cfg compile-profile-summary (import compiler_profile_summary as cps))
(import stdlib.option)
(import (option.option i64) as option_i64)
(import (vector.vector i64 core) as opt_dense_i64_vec)

(defmacro (compiler-opt-global-shared-view [place : Expr]) : Expr
  `(owned_view.compiler-owned-shared-view ,place))

(defmacro (compiler-opt-global-array-element-shared-view
  [items : Expr]
  [index : Expr]) : Expr
  `(unsafe
    (ptr-read (ptr-offset (__tl_array-data ,items) ,index))))

(defmacro (compiler-opt-borrowed-array-element-shared-view
  [items : Expr]
  [index : Expr]) : Expr
  `(clone (array-ref ,items ,index)))

;; A value that is not a Box is already the boxed value: a `(Box T)` payload
;; matched through a shared reference binds `(& T)` (SPEC section 5.13).
(defmacro (compiler-opt-box-shared-view [value : Expr]) : Expr
  (let
    [value-ty : comptime.Expr (comptime.expr-type value)]
    (if (string-eq (type-kind value-ty) "box")
      (let
        ;; Spliced into the generated pointer element type.
        ;; lint-allow: unused-variable
        [inner-ty : comptime.Expr (comptime.box-element-type value-ty)]
        `(let
          [address : i64
            (unsafe
              (ptr-read (ptr-cast (ptr-addr-of ,value) : (Ptr i64))))]
          (unsafe
            (ptr-read (int->ptr (cast address : u64) : (Ptr ,inner-ty))))))
      value)))

(defmacro (compiler-opt-box-field-shared-view [value : Expr] [field : Expr]) : Expr
  `(let
    [payload (compiler-opt-box-shared-view ,value)]
    (compiler-opt-global-shared-view (__tl-project-field payload ,field))))

;; --- whole-body instruction walks -------------------------------------------
;;
;; The instructions of a function body in block order. Like the operand walkers
;; of compiler_ir_types they expand to plain loops over a function name and its
;; context arguments, never a closure:
;;   opt-blocks-visit   (visitor ctx... instr)
;;   opt-blocks-fold    (folder ctx... acc instr), returning the next acc
;;   opt-blocks-every?  (pred ctx... instr), stopping at the first false
;;   opt-blocks-any?    (pred ctx... instr), stopping at the first true
;; The opt-instrs-* forms do the same over one instruction sequence and the
;; opt-functions-* forms over every body of a function list; the -seq forms
;; hand over each block's instruction sequence whole, the -block forms each
;; block itself.
;; One step of a walk. `mode` is `visit`, `fold` (into `var`), `every` or `any`
;; (the verdict in `var`).
(defmacro (opt-walk-step
  [mode : Expr]
  [var : Expr]
  [f : Expr]
  [instr : Expr]
  [contexts : Expr ...]) : unit
  (match mode
    [(Expr.Var name)
      (match name
        ["visit" `(,f ,@contexts ,instr)]
        ["fold" `(set! ,var (,f ,@contexts ,var ,instr))]
        [_ `(set! ,var (,f ,@contexts ,instr))])]
    [_ (comptime-error "opt-walk-step: mode must be a bare name")]))

;; Whether the walk goes on: always for `visit`/`fold`, while the verdict is
;; still open for `every`/`any`.
(defmacro (opt-walk-going [mode : Expr] [var : Expr] [more : Expr]) : bool
  (match mode
    [(Expr.Var name)
      (match name
        ["every" `(and ,var ,more)]
        ["any" `(and (not ,var) ,more)]
        [_ more])]
    [_ (comptime-error "opt-walk-going: mode must be a bare name")]))

;; What a walk reads: a named place is viewed, not moved (a reference is read
;; through), and any other expression is evaluated once.
(defmacro (opt-walk-source [source : Expr]) : Expr
  (match source
    [(Expr.Var _)
      (if (string.eq (type-kind (comptime.expr-type source)) "ref")
        `(owned_view.compiler-owned-reference-shared-view ,source)
        `(compiler-opt-global-shared-view ,source))]
    [_ source]))

(defmacro (opt-instrs-walk
  [mode : Expr]
  [var : Expr]
  [instrs : Expr]
  [f : Expr]
  [contexts : Expr ...]) : unit
  `(let
    [walk-instrs (opt-walk-source ,instrs)]
    [walk-count : i64 (ir.compiler-ir-instr-seq-count walk-instrs)]
    [walk-at : i64 0]
    (while (opt-walk-going ,mode ,var (< walk-at walk-count))
      (opt-walk-step
        ,mode
        ,var
        ,f
        (ir.compiler-ir-instr-seq-ref walk-instrs walk-at)
        ,@contexts)
      (set! walk-at (+ walk-at 1)))))

;; One block of a walk: its instructions one by one (`level` `instr`), its
;; whole instruction sequence as one item (`seq`), or the block itself
;; (`block`).
(defmacro (opt-walk-block
  [level : Expr]
  [mode : Expr]
  [var : Expr]
  [block : Expr]
  [f : Expr]
  [contexts : Expr ...]) : unit
  (match level
    [(Expr.Var name)
      (match name
        ["block"
          `(opt-walk-step
            ,mode
            ,var
            ,f
            (compiler-opt-global-shared-view ,block)
            ,@contexts)]
        ["seq"
          `(match ,block
            [(ir.CompilerIrBlock.Block _ walk-instrs)
              (opt-walk-step ,mode ,var ,f walk-instrs ,@contexts)])]
        [_
          `(match ,block
            [(ir.CompilerIrBlock.Block _ walk-instrs)
              (opt-instrs-walk ,mode ,var walk-instrs ,f ,@contexts)])])]
    [_ (comptime-error "opt-walk-block: level must be a bare name")]))

(defmacro (opt-blocks-walk
  [level : Expr]
  [mode : Expr]
  [var : Expr]
  [blocks : Expr]
  [f : Expr]
  [contexts : Expr ...]) : unit
  `(let
    [walk-seq : ir.CompilerIrBlockSeq
      (ir.compiler-ir-block-list-seq (opt-walk-source ,blocks))]
    [walk-count : i64 (ir.compiler-ir-block-seq-count walk-seq)]
    [walk-index : i64 0]
    (while (opt-walk-going ,mode ,var (< walk-index walk-count))
      (let
        [walk-block : ir.CompilerIrBlock
          (ir.compiler-ir-block-seq-ref walk-seq walk-index)]
        (opt-walk-block ,level ,mode ,var walk-block ,f ,@contexts)
        (set! walk-index (+ walk-index 1))))))

;; Every function of a `CompilerIrFunctionSeq` in list order.
(defmacro (opt-functions-walk
  [mode : Expr]
  [var : Expr]
  [functions : Expr]
  [f : Expr]
  [contexts : Expr ...]) : unit
  `(let
    [walk-function-count : i64 (__tl-project-field-name ,functions "len")]
    [walk-function : i64 0]
    (while (opt-walk-going ,mode ,var (< walk-function walk-function-count))
      (match (compiler-opt-global-array-element-shared-view
        (__tl-project-field-name ,functions "slots")
        walk-function)
        [(ir.CompilerIrFunction.Function _ _ _ _ walk-blocks _)
          (opt-blocks-walk instr ,mode ,var walk-blocks ,f ,@contexts)])
      (set! walk-function (+ walk-function 1)))))

(defmacro (opt-instrs-fold
  [instrs : Expr]
  [acc : Expr]
  [folder : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [fold-acc ,acc]
    (opt-instrs-walk fold fold-acc ,instrs ,folder ,@contexts)
    fold-acc))

(defmacro (opt-instrs-any? [instrs : Expr] [pred : Expr] [contexts : Expr ...]) : bool
  `(let
    [any-found : bool false]
    (opt-instrs-walk any any-found ,instrs ,pred ,@contexts)
    any-found))

(defmacro (opt-blocks-visit
  [blocks : Expr]
  [visitor : Expr]
  [contexts : Expr ...]) : unit
  `(opt-blocks-walk instr visit _ ,blocks ,visitor ,@contexts))

(defmacro (opt-blocks-fold
  [blocks : Expr]
  [acc : Expr]
  [folder : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [fold-acc ,acc]
    (opt-blocks-walk instr fold fold-acc ,blocks ,folder ,@contexts)
    fold-acc))

(defmacro (opt-blocks-every?
  [blocks : Expr]
  [pred : Expr]
  [contexts : Expr ...]) : bool
  `(let
    [every-ok : bool true]
    (opt-blocks-walk instr every every-ok ,blocks ,pred ,@contexts)
    every-ok))

(defmacro (opt-blocks-any? [blocks : Expr] [pred : Expr] [contexts : Expr ...]) : bool
  `(let
    [any-found : bool false]
    (opt-blocks-walk instr any any-found ,blocks ,pred ,@contexts)
    any-found))

;; The -seqs forms take each block's whole instruction sequence as one item:
;; `(visitor ctx... instrs)`, `(folder ctx... acc instrs)`, `(pred ctx... instrs)`.
(defmacro (opt-blocks-visit-seq
  [blocks : Expr]
  [visitor : Expr]
  [contexts : Expr ...]) : unit
  `(opt-blocks-walk seq visit _ ,blocks ,visitor ,@contexts))

(defmacro (opt-blocks-fold-seq
  [blocks : Expr]
  [acc : Expr]
  [folder : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [fold-acc ,acc]
    (opt-blocks-walk seq fold fold-acc ,blocks ,folder ,@contexts)
    fold-acc))

(defmacro (opt-blocks-any-seq?
  [blocks : Expr]
  [pred : Expr]
  [contexts : Expr ...]) : bool
  `(let
    [any-found : bool false]
    (opt-blocks-walk seq any any-found ,blocks ,pred ,@contexts)
    any-found))

;; And the -block forms hand over each block itself.
(defmacro (opt-blocks-fold-block
  [blocks : Expr]
  [acc : Expr]
  [folder : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [fold-acc ,acc]
    (opt-blocks-walk block fold fold-acc ,blocks ,folder ,@contexts)
    fold-acc))

(defmacro (opt-blocks-any-block?
  [blocks : Expr]
  [pred : Expr]
  [contexts : Expr ...]) : bool
  `(let
    [any-found : bool false]
    (opt-blocks-walk block any any-found ,blocks ,pred ,@contexts)
    any-found))

(defmacro (opt-functions-fold
  [functions : Expr]
  [acc : Expr]
  [folder : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [fold-acc ,acc]
    (opt-functions-walk fold fold-acc ,functions ,folder ,@contexts)
    fold-acc))

;; --- whole-body block maps --------------------------------------------------
;;
;; A fresh list of every block of a block list in order, each rewritten by a
;; function over its context arguments:
;;   opt-blocks-map         (mapper ctx... block)
;;   opt-blocks-map-seq     (mapper ctx... instrs), keeping the label
;;   opt-blocks-map-at      (mapper ctx... block-id block)
;;   opt-blocks-map-seq-at  (mapper ctx... block-id instrs), keeping the label
;; where `block-id` counts the blocks from 0 in list order.
(defmacro (opt-map-block
  [level : Expr]
  [at : Expr]
  [block : Expr]
  [f : Expr]
  [contexts : Expr ...]) : Expr
  (match level
    [(Expr.Var name)
      (match name
        ["seq"
          `(match ,block
            [(ir.CompilerIrBlock.Block map-label map-instrs)
              (ir.CompilerIrBlock.Block map-label (,f ,@contexts map-instrs))])]
        ["seq-at"
          `(match ,block
            [(ir.CompilerIrBlock.Block map-label map-instrs)
              (ir.CompilerIrBlock.Block
                map-label
                (,f ,@contexts ,at map-instrs))])]
        ["at" `(,f ,@contexts ,at ,block)]
        [_ `(,f ,@contexts ,block)])]
    [_ (comptime-error "opt-map-block: level must be a bare name")]))

(defmacro (opt-blocks-map-walk
  [level : Expr]
  [blocks : Expr]
  [f : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [map-seq : ir.CompilerIrBlockSeq
      (ir.compiler-ir-block-list-seq (opt-walk-source ,blocks))]
    [map-count : i64 (ir.compiler-ir-block-seq-count map-seq)]
    [map-out : (__tl_dyn-array ir.CompilerIrBlock)
      (__tl_make-array ir.CompilerIrBlock map-count)]
    [map-at : i64 0]
    (while (< map-at map-count)
      (set!
        (array-ref map-out map-at)
        (opt-map-block
          ,level
          map-at
          (ir.compiler-ir-block-seq-ref map-seq map-at)
          ,f
          ,@contexts))
      (set! map-at (+ map-at 1)))
    (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq map-out map-count))))

(defmacro (opt-blocks-map [blocks : Expr] [mapper : Expr] [contexts : Expr ...]) : Expr
  `(opt-blocks-map-walk block ,blocks ,mapper ,@contexts))

(defmacro (opt-blocks-map-seq
  [blocks : Expr]
  [mapper : Expr]
  [contexts : Expr ...]) : Expr
  `(opt-blocks-map-walk seq ,blocks ,mapper ,@contexts))

(defmacro (opt-blocks-map-at
  [blocks : Expr]
  [mapper : Expr]
  [contexts : Expr ...]) : Expr
  `(opt-blocks-map-walk at ,blocks ,mapper ,@contexts))

(defmacro (opt-blocks-map-seq-at
  [blocks : Expr]
  [mapper : Expr]
  [contexts : Expr ...]) : Expr
  `(opt-blocks-map-walk seq-at ,blocks ,mapper ,@contexts))

;; A fresh list built by a slice walker `(builder out blocks ctx...)` that
;; pushes the result blocks into the builder `out` in order;
;; `opt-blocks-collect` hands `(builder out ctx...)` an empty builder instead.
(defmacro (opt-blocks-build
  [blocks : Expr]
  [builder : Expr]
  [contexts : Expr ...]) : Expr
  `(let
    [build-source : ir.CompilerIrBlockList (opt-walk-source ,blocks)]
    [build-out : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity
        (ir.compiler-ir-block-list-count build-source))]
    (,builder
      (&mut build-out)
      (ir.compiler-ir-block-list-view build-source)
      ,@contexts)
    (ir.compiler-ir-block-builder-to-list build-out)))

(defmacro (opt-blocks-collect [builder : Expr] [contexts : Expr ...]) : Expr
  `(let
    [collect-out : ir.CompilerIrBlockBuilder (ir.compiler-ir-block-builder-new)]
    (,builder (&mut collect-out) ,@contexts)
    (ir.compiler-ir-block-builder-to-list collect-out)))

;; `prefix`'s blocks followed by `tail`'s, as one fresh list.
(define (opt-blocks-append
  [prefix : ir.CompilerIrBlockList]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [out : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity
        (+
          (ir.compiler-ir-block-list-count prefix)
          (ir.compiler-ir-block-list-count tail)))]
    (ir.compiler-ir-block-builder-append-list! (&mut out) prefix)
    (ir.compiler-ir-block-builder-append-list! (&mut out) tail)
    (ir.compiler-ir-block-builder-to-list out)))

(defenum ResultCompilerOptimizeLevel
  (Ok i64)
  (Err))

(defenum CompilerOptimizedProgram
  (Program ir.CompilerIrProgram ir.CompilerSourceSpans))

(defstruct OptDebugTextBufCell
  (slot (Box text_buf.TextBuf)))

(defstruct OptDebugState
  ;; Borrowed from the ambient compile job by compiler-opt-debug-configure!.
  ;; That job must outlive every observation and result read for this session.
  (dump-arena arena.Arena)
  (structural-session cis.InternStructuralSessionHandle)
  (dump-pass String)
  (dump-buf OptDebugTextBufCell)
  (verify-error String))

(defstruct OptInlineOwnedState
  (verify-scratch arena.Arena)
  (multiblock-ok-memo (__tl_dyn-array i64))
  ;; INL-5: one slot per function index, holding the shape refusal the
  ;; SINGLE-BLOCK callee gate has already reported for that callee under
  ;; --trace-passes, or -1 for "not reported yet". It is a trace-dedup ledger,
  ;; not a verdict cache: the single-block gate's answer also depends on the
  ;; CALLER (it refuses a self-call by name), so only the caller-independent
  ;; SHAPE reason is recorded here, and only so a callee with fifteen refused
  ;; sites produces one line instead of fifteen -- the property the multiblock
  ;; tracer gets from its verdict memo.
  (single-shape-traced (__tl_dyn-array i64)))

;; The optimizer's two cross-function arena protocols are process-serial, but
;; their owners and every global view backed by the surrounding compile job
;; still have to move together. Install and reset each complete substate below
;; one aggregate so a later lifetime-branded owner can consume it instead of
;; clearing unrelated globals. Refs #6257.
(defstruct CompilerOptOwnedState
  (inline-state OptInlineOwnedState)
  (debug-state OptDebugState))

(define (compiler-opt-debug-text-buf-cell-empty) : OptDebugTextBufCell
  (OptDebugTextBufCell (box (text_buf.empty))))

(define (compiler-opt-debug-text-buf-cell-append!
  [cell : OptDebugTextBufCell]
  [snapshot : String]) : unit
  (let
    [buf : text_buf.TextBuf (replace! (deref cell.slot) (text_buf.empty))]
    [next : text_buf.TextBuf
      (text_buf.append
        (if (text_buf.empty? (& buf))
          buf
          (text_buf.append buf "\n"))
        snapshot)]
    (set! (deref cell.slot) next)))

(define compiler-opt-owned-state : CompilerOptOwnedState
  (CompilerOptOwnedState
    (OptInlineOwnedState
      (arena.Arena 0)
      (__tl_make-array i64 0)
      (__tl_make-array i64 0))
    (OptDebugState
      (arena.Arena 0)
      (cis.InternStructuralSessionHandle 0)
      ""
      (compiler-opt-debug-text-buf-cell-empty)
      "")))

;; Serial compatibility reads intentionally take shallow shared views of this
;; process-global aggregate. Production optimizer work is not re-entrant.
(define (compiler-opt-owned-state-shared-view) : CompilerOptOwnedState
  (unsafe
    (ptr-read (ptr-addr-of compiler-opt-owned-state))))

;; Developer-only optimizer observability. The CLI resets this state before
;; every command, so normal compilation remains silent and allocation-free at
;; pass boundaries.
(define compiler-opt-debug-trace-passes : bool
  false)
(define compiler-opt-debug-verify-ir : bool
  false)

;; Set while the inliner's measured-plan check re-runs the per-function
;; optimizer. Those runs are MEASUREMENTS, not pipeline stages: their results
;; are thrown away and only a bool escapes, so `--trace-passes` must not report
;; passes over functions the pipeline never optimized and the `--dump-ir` buffer
;; (which scripts/verify-ir-observability.sh reads) must not receive throwaway
;; generations.
(define compiler-opt-debug-suppressed? : bool
  false)

(define (compiler-opt-debug-set-suppressed! [on : bool]) : unit
  (set! compiler-opt-debug-suppressed? on))

(define (compiler-opt-debug-configure!
  [structural-session : cis.InternStructuralSessionHandle]
  [trace-passes : bool]
  [dump-pass : String]
  [verify-ir : bool]) : unit
  (set! compiler-opt-debug-trace-passes trace-passes)
  ;; RG-1: the register allocator's home tracer rides the same flag and the
  ;; same command boundary, so `--trace-passes` turns both on and a command
  ;; that does not ask for it leaves the allocator silent.
  (reg.compiler-reg-debug-set-trace-homes! trace-passes)
  (set! compiler-opt-debug-verify-ir verify-ir)
  ;; Pass snapshots accumulate in a segmented buffer: each observation is
  ;; O(its rendered size) instead of a whole-prefix string copy.
  ;; Publish the borrowed owner and every dependent view as one value.
  ;; Configuration is a command boundary, so no inline owner is live. Reset
  ;; that substate here as well instead of carrying an empty descriptor from
  ;; an arena the preceding command may already have retired.
  (set!
    compiler-opt-owned-state
    (CompilerOptOwnedState
      (OptInlineOwnedState
        (arena.Arena 0)
        (__tl_make-array i64 0)
        (__tl_make-array i64 0))
      (OptDebugState
        (arena.current)
        structural-session
        dump-pass
        (compiler-opt-debug-text-buf-cell-empty)
        ""))))

(define (compiler-opt-debug-dump-result) : String
  (let
    [state : OptDebugState
      (compiler-opt-global-shared-view compiler-opt-owned-state.debug-state)]
    [cell : OptDebugTextBufCell state.dump-buf]
    [buf : text_buf.TextBuf (compiler-opt-box-shared-view cell.slot)]
    (text_buf.render (clone buf))))

(cfg
  test
  (define (compiler-opt-debug-dump-length) : i64
    (let
      [state : OptDebugState
        (compiler-opt-global-shared-view compiler-opt-owned-state.debug-state)]
      [cell : OptDebugTextBufCell state.dump-buf]
      [buf : text_buf.TextBuf (compiler-opt-box-shared-view cell.slot)]
      (text_buf.length (& buf)))))

(define (compiler-opt-debug-verification-error) : String
  (let
    [state : OptDebugState
      (compiler-opt-global-shared-view compiler-opt-owned-state.debug-state)]
    [verify-error : String state.verify-error]
    (string.copy (& verify-error))))

(define (compiler-opt-debug-pass-selected?
  [state : (& state OptDebugState)]
  [pass : String]) : bool
  (and
    (> (string.string-length state.dump-pass) 0)
    (string.eq state.dump-pass pass)))

(define (compiler-opt-debug-observe-function
  [type-segment-bases : i64]
  [pass : String]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (compiler-opt-global-shared-view func)
    [(Function name _ _ _ blocks _)
      (if (and
        compiler-opt-debug-trace-passes
        (not compiler-opt-debug-suppressed?))
        (io.print-error
          (str_cat.str-cat
            "optimizer-pass|"
            (ir.compiler-ir-symbol-text name)
            "|"
            (compiler-opt-global-shared-view pass)
            "|blocks="
            (string.int->string (ir.compiler-ir-block-list-count blocks))
            "|instructions="
            (string.int->string
              (ir.compiler-ir-block-list-instruction-count (& blocks)))
            "\n"))
        unit)
      (let
        [state : OptDebugState
          (compiler-opt-global-shared-view compiler-opt-owned-state.debug-state)]
        (if (and
          (not compiler-opt-debug-suppressed?)
          (compiler-opt-debug-pass-selected?
            state
            (compiler-opt-global-shared-view pass)))
          (in-arena
            state.dump-arena
            ;; The liveness-tracked cell moves the buffer out exactly once,
            ;; appends while no stale snapshot aliases its mutable store, and
            ;; restores it without cloning the accumulated prefix.
            (compiler-opt-debug-text-buf-cell-append!
              state.dump-buf
              (str_cat.str-cat
                "after "
                pass
                " @"
                (ir.compiler-ir-symbol-text name)
                "\n"
                (ir.compiler-ir-function-render
                  state.structural-session
                  type-segment-bases
                  (& func)))))
          unit))
      func]))

(defenum OptAggregatePointer
  (Pointer i64 i64))

(import (vector.vector OptAggregatePointer core) as opt_aggregate_pointer_vec)

(defenum OptAggregateAccess
  (Store i64 ast.AstType)
  (Load i64 i64 ast.AstType))

(import (vector.vector OptAggregateAccess core) as opt_aggregate_access_vec)

(defenum OptAggregateAllocCandidate
  (Candidate
    i64
    ast.AstType
    i64
    opt_aggregate_pointer_vec.Vec
    opt_aggregate_access_vec.Vec))

(import (vector.vector OptAggregateAllocCandidate core) as opt_aggregate_candidate_vec)

(defenum OptMaybeAggregateAlloc
  (No)
  (Some i64 ast.AstType i64))

(defenum OptAggregateScanResult
  (Ok opt_aggregate_pointer_vec.Vec opt_aggregate_access_vec.Vec)
  (Reject))

(defenum OptAggregatePromoteSlot
  (Slot i64 i64))

(import (vector.vector OptAggregatePromoteSlot core) as opt_aggregate_promote_slot_vec)

(defenum OptAggregatePromoteBuild
  (Build opt_aggregate_promote_slot_vec.Vec i64))

(define opt-aggregate-list-initial-capacity : i64
  4)
(define compiler-optimize-level-default : i64
  1)

(cfg
  compile-profile
  (counters.defslots
    compiler-opt-profile-starts
    24
    (compiler-opt-profile-start-ms-metric)
    (compiler-opt-profile-start-total-metric)
