      compiler-opt-load-cse-profile-max-table-size-metric
      compiler-opt-load-cse-profile-end)))

(cfg
  (any compile-profile test)
  (define (compiler-opt-load-cse-profile-note-max
    [metrics : profile_state.CompilerProfileMetrics]
