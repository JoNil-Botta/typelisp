(define (opt-instr-list-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrInstrList]
  [b : ir.CompilerIrInstrList]) : bool
  (match a
    [(ir.CompilerIrInstrList.Nil)
      (match b
        [(ir.CompilerIrInstrList.Nil) true]
        [_ false])]
    [(ir.CompilerIrInstrList.Cons ah at)
      (match b
        [(ir.CompilerIrInstrList.Cons bh bt)
          (and
            (opt-instr-eq type-segment-bases ah bh)
            (opt-instr-list-eq
              type-segment-bases
              (__tl-box-place at)
              (__tl-box-place bt)))]
        [_ false])]))

(define (opt-instr-seq-eq-from
  [type-segment-bases : i64]
  [a : ir.CompilerIrInstrSeq]
  [b : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : bool
  (let
    [cursor : i64 index]
    (begin
      (while (< cursor count)
        (if (opt-instr-eq
          type-segment-bases
          (ir.compiler-ir-instr-seq-ref a cursor)
          (ir.compiler-ir-instr-seq-ref b cursor))
          (set! cursor (+ cursor 1))
          (return false)))
      true)))

(define (opt-instr-seq-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrInstrSeq]
  [b : ir.CompilerIrInstrSeq]) : bool
  (let
    [acount : i64 (ir.compiler-ir-instr-seq-count a)]
    [bcount : i64 (ir.compiler-ir-instr-seq-count b)]
    (and
      (= acount bcount)
      (opt-instr-seq-eq-from type-segment-bases a b 0 acount))))

(define (opt-block-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrBlock]
  [b : ir.CompilerIrBlock]) : bool
  (match a
    [(ir.CompilerIrBlock.Block alabel ainstrs)
      (match b
        [(ir.CompilerIrBlock.Block blabel binstrs)
          (and
            (= alabel blabel)
            (opt-instr-seq-eq type-segment-bases ainstrs binstrs))])]))

(define (opt-block-list-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrBlockList]
  [b : ir.CompilerIrBlockList]) : bool
  (match a
    [(ir.CompilerIrBlockList.Nil)
      (match b
        [(ir.CompilerIrBlockList.Nil) true]
        [_ false])]
    [(ir.CompilerIrBlockList.Cons ah at)
      (match b
        [(ir.CompilerIrBlockList.Cons bh bt)
          (and
            (opt-block-eq type-segment-bases ah bh)
            (opt-block-list-eq
              type-segment-bases
              (__tl-box-place at)
              (__tl-box-place bt)))]
        [(ir.CompilerIrBlockList.Array seq)
          (opt-block-list-eq
            type-segment-bases
            a
            (ir.compiler-ir-block-seq-to-list seq))]
        [_ false])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-block-list-eq
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        b)]))

(define (opt-param-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrParam]
  [b : ir.CompilerIrParam]) : bool
  (match a
    [(ir.CompilerIrParam.Param aname aty aid)
      (match b
        [(ir.CompilerIrParam.Param bname bty bid)
          (and
            (string.eq aname bname)
            (= aid bid)
            (opt-type-eq type-segment-bases aty bty))])]))

(define (opt-param-list-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrParamList]
  [b : ir.CompilerIrParamList]) : bool
  (match a
    [(ir.CompilerIrParamList.Nil)
      (match b
        [(ir.CompilerIrParamList.Nil) true]
        [(ir.CompilerIrParamList.Array seq)
          (opt-param-list-eq
            type-segment-bases
            a
            (ir.compiler-ir-param-seq-to-list seq))]
        [_ false])]
    [(ir.CompilerIrParamList.Cons ah at)
      (match b
        [(ir.CompilerIrParamList.Cons bh bt)
          (and
            (opt-param-eq type-segment-bases ah bh)
            (opt-param-list-eq
              type-segment-bases
              (__tl-box-place at)
              (__tl-box-place bt)))]
        [(ir.CompilerIrParamList.Array seq)
          (opt-param-list-eq
            type-segment-bases
            a
            (ir.compiler-ir-param-seq-to-list seq))]
        [_ false])]
    [(ir.CompilerIrParamList.Array seq)
      (opt-param-list-eq
        type-segment-bases
        (ir.compiler-ir-param-seq-to-list seq)
        b)]))

(define (opt-function-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrFunction]
  [b : ir.CompilerIrFunction]) : bool
  (match a
    [(ir.CompilerIrFunction.Function aname aparams aret aframe ablocks)
      (match b
        [(ir.CompilerIrFunction.Function bname bparams bret bframe bblocks)
          (and
            (ir.compiler-ir-symbol-eq? aname bname)
            (= aframe bframe)
            (opt-param-list-eq type-segment-bases aparams bparams)
            (opt-type-eq type-segment-bases aret bret)
            (opt-block-list-eq type-segment-bases ablocks bblocks))])]))

(define (opt-function-list-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrFunctionList]
  [b : ir.CompilerIrFunctionList]) : bool
  (match a
    [(ir.CompilerIrFunctionList.Nil)
      (match b
        [(ir.CompilerIrFunctionList.Nil) true]
        [_ false])]
    [(ir.CompilerIrFunctionList.Cons ah at)
      (match b
        [(ir.CompilerIrFunctionList.Cons bh bt)
          (and
            (opt-function-eq type-segment-bases ah bh)
            (opt-function-list-eq
              type-segment-bases
              (__tl-box-place at)
              (__tl-box-place bt)))]
        [(ir.CompilerIrFunctionList.Array bseq)
          (opt-function-list-eq
            type-segment-bases
            a
            (ir.compiler-ir-function-seq-to-list bseq))]
        [_ false])]
    [(ir.CompilerIrFunctionList.Array aseq)
      (opt-function-list-eq
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list aseq)
        b)]))

(define (opt-global-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrGlobal]
  [b : ir.CompilerIrGlobal]) : bool
  (match a
    [(ir.CompilerIrGlobal.Global aname aty avalue)
      (match b
        [(ir.CompilerIrGlobal.Global bname bty bvalue)
          (and
            (ir.compiler-ir-symbol-eq? aname bname)
            (opt-type-eq type-segment-bases aty bty)
            (opt-value-eq avalue bvalue))])]))

(define (opt-global-list-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrGlobalList]
  [b : ir.CompilerIrGlobalList]) : bool
  (match a
    [(ir.CompilerIrGlobalList.Nil)
      (match b
        [(ir.CompilerIrGlobalList.Nil) true]
        [(ir.CompilerIrGlobalList.Array bseq)
          (opt-global-list-eq
            type-segment-bases
            ir.CompilerIrGlobalList.Nil
            (ir.compiler-ir-global-seq-to-list bseq))]
        [_ false])]
    [(ir.CompilerIrGlobalList.Cons ah at)
      (match b
        [(ir.CompilerIrGlobalList.Cons bh bt)
          (and
            (opt-global-eq type-segment-bases ah bh)
            (opt-global-list-eq
              type-segment-bases
              (__tl-box-place at)
              (__tl-box-place bt)))]
        [(ir.CompilerIrGlobalList.Array bseq)
          (opt-global-list-eq
            type-segment-bases
            a
            (ir.compiler-ir-global-seq-to-list bseq))]
        [_ false])]
    [(ir.CompilerIrGlobalList.Array aseq)
      (opt-global-list-eq
        type-segment-bases
        (ir.compiler-ir-global-seq-to-list aseq)
        b)]))

(define (opt-extern-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrExtern]
  [b : ir.CompilerIrExtern]) : bool
  (match a
    [(ir.CompilerIrExtern.Extern
        aid
        asource
        aname
        aty
        aabi
        asymbol
        alinks
        aprovided)
      (match b
        [(ir.CompilerIrExtern.Extern
            bid
            bsource
            bname
            bty
            babi
            bsymbol
            blinks
            bprovided)
          (and
            (= aid bid)
            (= asource bsource)
            (string.eq aname bname)
            (opt-type-eq type-segment-bases aty bty)
            (ast.ast-extern-abi-eq? aabi babi)
            (= asymbol bsymbol)
            (ast.ast-extern-link-input-list-eq? alinks blinks)
            (= aprovided bprovided))])]))

(define (opt-extern-list-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrExternList]
  [b : ir.CompilerIrExternList]) : bool
  (match a
    [(ir.CompilerIrExternList.Nil)
      (match b
        [(ir.CompilerIrExternList.Nil) true]
        [(ir.CompilerIrExternList.Array bseq)
          (opt-extern-list-eq
            type-segment-bases
            ir.CompilerIrExternList.Nil
            (ir.compiler-ir-extern-seq-to-list bseq))]
        [_ false])]
    [(ir.CompilerIrExternList.Cons ah at)
      (match b
        [(ir.CompilerIrExternList.Cons bh bt)
          (and
            (opt-extern-eq type-segment-bases ah bh)
            (opt-extern-list-eq
              type-segment-bases
              (__tl-box-place at)
              (__tl-box-place bt)))]
        [(ir.CompilerIrExternList.Array bseq)
          (opt-extern-list-eq
            type-segment-bases
            a
            (ir.compiler-ir-extern-seq-to-list bseq))]
        [_ false])]
    [(ir.CompilerIrExternList.Array aseq)
      (opt-extern-list-eq
        type-segment-bases
        (ir.compiler-ir-extern-seq-to-list aseq)
        b)]))

(define (opt-program-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrProgram]
  [b : ir.CompilerIrProgram]) : bool
  (match a
    [(ir.CompilerIrProgram.Program aglobals afunctions aexterns)
      (match b
        [(ir.CompilerIrProgram.Program bglobals bfunctions bexterns)
          (and
            (opt-global-list-eq type-segment-bases aglobals bglobals)
            (opt-function-list-eq type-segment-bases afunctions bfunctions)
            (opt-extern-list-eq type-segment-bases aexterns bexterns))])]))

(define (opt-expr-key-eq
  [type-segment-bases : i64]
  [a : OptExprKey]
  [b : OptExprKey]) : bool
  (match a
    [(OptExprKey.BinKey opa la ra ta)
      (match b
        [(OptExprKey.BinKey opb lb rb tb)
          (and
            (opt-binop-eq opa opb)
            (opt-type-eq type-segment-bases ta tb)
            (opt-value-eq la lb)
            (opt-value-eq ra rb))]
        [_ false])]
    [(OptExprKey.UnKey opa va ta)
      (match b
        [(OptExprKey.UnKey opb vb tb)
          (and
            (opt-unop-eq opa opb)
            (opt-type-eq type-segment-bases ta tb)
            (opt-value-eq va vb))]
        [_ false])]
    [(OptExprKey.CpuIdKey aleaf asubleaf areg)
      (match b
        [(OptExprKey.CpuIdKey bleaf bsubleaf breg)
          (and
            (= areg breg)
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asubleaf bsubleaf))]
        [_ false])]
    [(OptExprKey.XgetbvKey aindex)
      (match b
        [(OptExprKey.XgetbvKey bindex) (opt-value-eq aindex bindex)]
        [_ false])]))

(define (opt-expr-lookup
  [type-segment-bases : i64]
  [table : OptExprTable]
  [key : OptExprKey]) : ir.CompilerIrMaybeValue
  (match table
    [(OptExprTable.Nil) (ir.CompilerIrMaybeValue.No)]
    [(OptExprTable.Cons k var rest)
      (let
        [rest : OptExprTable (__tl-box-place rest)]
        (if (opt-expr-key-eq type-segment-bases k key)
          (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var var))
          (opt-expr-lookup type-segment-bases rest key)))]))

(define (opt-value-is-var? [value : ir.CompilerIrValue] [var : i64]) : bool
  (match value
    [(ir.CompilerIrValue.Var id) (= id var)]
    [_ false]))

(define (opt-key-uses-var? [key : OptExprKey] [var : i64]) : bool
  (match key
    [(OptExprKey.BinKey _ l r _)
      (or (opt-value-is-var? l var) (opt-value-is-var? r var))]
    [(OptExprKey.UnKey _ v _) (opt-value-is-var? v var)]
    [(OptExprKey.CpuIdKey leaf subleaf _)
      (or (opt-value-is-var? leaf var) (opt-value-is-var? subleaf var))]
    [(OptExprKey.XgetbvKey index) (opt-value-is-var? index var)]))

;; Drop every entry whose key references `var` (a stale operand) or whose result
;; is `var` (a stale definition).
(define (opt-expr-invalidate-var [table : OptExprTable] [var : i64]) : OptExprTable
  (match table
    [(OptExprTable.Nil) (OptExprTable.Nil)]
    [(OptExprTable.Cons k v rest)
      (let
        [rest2 : OptExprTable
          (opt-expr-invalidate-var (__tl-box-place rest) var)]
        (if (or (opt-key-uses-var? k var) (= v var))
          rest2
          (OptExprTable.Cons k v (box rest2))))]))

(defenum OptCseResult
  (Result OptExprTable ir.CompilerIrInstr))

(define (opt-cse-instr
  [type-segment-bases : i64]
  [table : OptExprTable]
  [instr : ir.CompilerIrInstr]) : OptCseResult
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op l r ty)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.BinKey op l r ty)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(ir.CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result
              t1
              (ir.CompilerIrInstr.Mov
                dst
                earlier
                (ir.compiler-ir-binop-result-type op ty)))]
          [(ir.CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    [(ir.CompilerIrInstr.UnOp dst op v ty)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.UnKey op v ty)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(ir.CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result t1 (ir.CompilerIrInstr.Mov dst earlier ty))]
          [(ir.CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.CpuIdKey leaf subleaf reg-index)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(ir.CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result
              t1
              (ir.CompilerIrInstr.Mov dst earlier (ast.AstType.I64)))]
          [(ir.CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (let
        [t1 : OptExprTable (opt-expr-invalidate-var table dst)]
        [key : OptExprKey (OptExprKey.XgetbvKey index)]
        (match (opt-expr-lookup type-segment-bases t1 key)
          [(ir.CompilerIrMaybeValue.Some earlier)
            (OptCseResult.Result
              t1
              (ir.CompilerIrInstr.Mov dst earlier (ast.AstType.I64)))]
          [(ir.CompilerIrMaybeValue.No)
            (OptCseResult.Result (OptExprTable.Cons key dst (box t1)) instr)]))]
    ;; Other defining instructions: invalidate their dst, keep the instruction.
    [(ir.CompilerIrInstr.Mov dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Alloc dst _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.AddrOf dst _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Gep dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Load dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Cast dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Phi dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.LaneId dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Splat dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (OptCseResult.Result (opt-expr-invalidate-var table dst) instr))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (OptCseResult.Result (opt-expr-invalidate-var table dst) instr))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (OptCseResult.Result (opt-expr-invalidate-var table dst) instr))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (OptCseResult.Result (opt-expr-invalidate-var table dst) instr))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (OptCseResult.Result (opt-expr-invalidate-var table dst) instr))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (OptCseResult.Result (opt-expr-invalidate-var table dst) instr))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.EntryArgv dst)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.EntryEnvp dst)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    ;; Calls, stores, and control flow clear all available expressions.
    [(ir.CompilerIrInstr.Syscall _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.Call _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.VectorShuffle _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.TailCall _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.Store _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.StorePtr _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) (OptCseResult.Result table instr)]
    [(ir.CompilerIrInstr.Jump _) (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.Branch _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.Return _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    ;; Register-group ops are plain defining instructions -- invalidate
    ;; their dst, keep the instruction (no CSE key for them).
    [(ir.CompilerIrInstr.Pack dst _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Word dst _ _ _)
      (OptCseResult.Result (opt-expr-invalidate-var table dst) instr)]
    [(ir.CompilerIrInstr.Switch _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _)
      (OptCseResult.Result (OptExprTable.Nil) instr)]))

(define (opt-cse-instrs
  [type-segment-bases : i64]
  [table : OptExprTable]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match (opt-cse-instr type-segment-bases table instr)
        [(OptCseResult.Result new-table new-instr)
          (ir.compiler-ir-instr-cons
            new-instr
            (opt-cse-instrs type-segment-bases new-table (__tl-box-place rest)))])]))

;; --- block-local copy propagation -------------------------------------------
;;
;; The lowerer and the CSE pass both materialize values through `CompilerIrInstr.Mov`
;; into fresh vars (CSE rewrites a redundant expression to `Mov dst earlier`).
;; Within a single basic block, track copies `dst -> source` and rewrite later
;; operand uses of `CompilerIrValue.Var dst` to `source`, so DCE can then drop the now
;; unused copy. This needs no register allocation or CFG dataflow.
;;
;; Conservative for the first slice: only `CompilerIrValue.Var` and unambiguous scalar
;; literals are recorded as copy sources (`CompilerIrValue.F64`, `CompilerIrValue.String`, and
;; globals are excluded until their backend paths are settled); `CompilerIrInstr.Phi`
;; inputs belong to predecessor edges and are never rewritten; and `CompilerIrInstr.AddrOf`
;; carries a raw var id (a storage slot), not a value operand, so it is left
;; alone. On any instruction that defines var `v`, both the mapping for `v` and
;; any mapping whose source is `CompilerIrValue.Var v` are dropped, so a reused var id in
;; the non-SSA IR never triggers a stale rewrite.
(defenum OptCopyEnv
  (Nil)
  (Cons i64 ir.CompilerIrValue (Box OptCopyEnv))
  (PackWordCons i64 i64 ir.CompilerIrValue (Box OptCopyEnv)))

(define (opt-copy-lookup [env : OptCopyEnv] [var : i64]) : ir.CompilerIrMaybeValue
  (match env
    [(OptCopyEnv.Nil) (ir.CompilerIrMaybeValue.No)]
    [(OptCopyEnv.Cons id value rest)
      (let
        [rest : OptCopyEnv (__tl-box-place rest)]
        (if (= id var)
          (ir.CompilerIrMaybeValue.Some value)
          (opt-copy-lookup rest var)))]
    [(OptCopyEnv.PackWordCons _ _ _ rest)
      (opt-copy-lookup (__tl-box-place rest) var)]))

(define (opt-copy-pack-word-lookup
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]) : ir.CompilerIrMaybeValue
  (match env
    [(OptCopyEnv.Nil) (ir.CompilerIrMaybeValue.No)]
    [(OptCopyEnv.Cons _ _ rest)
      (opt-copy-pack-word-lookup (__tl-box-place rest) group index)]
    [(OptCopyEnv.PackWordCons found-group found-index value rest)
      (if (and (= found-group group) (= found-index index))
        (ir.CompilerIrMaybeValue.Some value)
        (opt-copy-pack-word-lookup (__tl-box-place rest) group index))]))

;; Drop the mapping for `var` and any mapping whose replacement is `CompilerIrValue.Var
;; var`, so redefining either a copied destination or a copied source clears the
;; stale copy fact.
(define (opt-copy-invalidate-var [env : OptCopyEnv] [var : i64]) : OptCopyEnv
  (match env
    [(OptCopyEnv.Nil) (OptCopyEnv.Nil)]
    [(OptCopyEnv.Cons id value rest)
      (let
        [rest2 : OptCopyEnv (opt-copy-invalidate-var (__tl-box-place rest) var)]
        (if (or (= id var) (opt-value-is-var? value var))
          rest2
          (OptCopyEnv.Cons id value (box rest2))))]
    [(OptCopyEnv.PackWordCons group index value rest)
      (let
        [rest2 : OptCopyEnv (opt-copy-invalidate-var (__tl-box-place rest) var)]
        (if (or (= group var) (opt-value-is-var? value var))
          rest2
          (OptCopyEnv.PackWordCons group index value (box rest2))))]))

;; Only var copies and unambiguous scalar literals are safe to propagate in this
;; slice; F64/String/global sources stay put until their backend paths exist.
(define (opt-copy-safe-source? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var _) true]
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.Unit) true]
    [(ir.CompilerIrValue.F64 _) false]
    [(ir.CompilerIrValue.String _) false]
    [(ir.CompilerIrValue.Bytes _) false]
    [(ir.CompilerIrValue.Global _) false]
    [(ir.CompilerIrValue.GlobalAddr _) false]
    [(ir.CompilerIrValue.Function _) false]
    [(ir.CompilerIrValue.RuntimeGlobal _) false]))

(define (opt-copy-add-pack-word
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]
  [value : ir.CompilerIrValue]) : OptCopyEnv
  (if (and (opt-copy-safe-source? value) (not (opt-value-is-var? value group)))
    (OptCopyEnv.PackWordCons group index value (box env))
    env))

(define (opt-copy-add-pack-words-from
  [env : OptCopyEnv]
  [group : i64]
  [index : i64]
  [words : ir.CompilerIrValueList]) : OptCopyEnv
  (match words
    [(ir.CompilerIrValueList.Nil) env]
    [(ir.CompilerIrValueList.Array seq)
      (opt-copy-add-pack-words-from
        env
        group
        index
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (opt-copy-add-pack-words-from
        (opt-copy-add-pack-word env group index value)
        group
        (+ index 1)
        (__tl-box-place rest))]))

(define (opt-copy-update-pack-env
  [env : OptCopyEnv]
  [dst : i64]
  [words : ir.CompilerIrValueList]) : OptCopyEnv
  (opt-copy-add-pack-words-from (opt-copy-invalidate-var env dst) dst 0 words))

(define (opt-copy-mask-source? [value : ir.CompilerIrValue] [dst : i64]) : bool
  (match value
    [(ir.CompilerIrValue.Var _) (not (opt-value-is-var? value dst))]
    [_ false]))

(define (opt-copy-resolve [env : OptCopyEnv] [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (opt-copy-lookup env id)
        [(ir.CompilerIrMaybeValue.Some v) v]
        [(ir.CompilerIrMaybeValue.No) value])]
    [_ value]))

(define (opt-copy-resolve-mask [env : OptCopyEnv] [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (let
    [resolved : ir.CompilerIrValue (opt-copy-resolve env value)]
    (match resolved
      [(ir.CompilerIrValue.Var _) resolved]
      [_ value])))

(define (opt-copy-subst-value-list
  [env : OptCopyEnv]
  [values : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (match values
    [(ir.CompilerIrValueList.Nil) (ir.CompilerIrValueList.Nil)]
    [(ir.CompilerIrValueList.Array seq)
      (opt-copy-subst-value-list env (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (ir.compiler-ir-value-cons
        (opt-copy-resolve env value)
        (opt-copy-subst-value-list env (__tl-box-place rest)))]))

(define (opt-copy-subst-call-args-array
  [env : OptCopyEnv]
  [src : (__tl_dyn-array ir.CompilerIrValue)]
  [dst : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set! (array-ref dst index) (opt-copy-resolve env (array-ref src index)))
      (opt-copy-subst-call-args-array env src dst (+ index 1)))))

(define (opt-copy-subst-call-args
  [env : OptCopyEnv]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrCallArgs.Nil)]
    [(ir.CompilerIrCallArgs.One value)
      (ir.CompilerIrCallArgs.One (opt-copy-resolve env value))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (opt-copy-resolve env a)
        (opt-copy-resolve env b))]
    [(ir.CompilerIrCallArgs.Array values)
      (let
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue (array-length values))]
        (begin
          (opt-copy-subst-call-args-array env values out 0)
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-copy-resolve-spmd-value
  [env : OptCopyEnv]
  [class : ir.CompilerIrSpmdValueClass]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match class
    [(ir.CompilerIrSpmdValueClass.Uniform) (opt-copy-resolve env value)]
    [(ir.CompilerIrSpmdValueClass.Varying) (opt-copy-resolve-mask env value)]
    [(ir.CompilerIrSpmdValueClass.Mask) (opt-copy-resolve-mask env value)]))

(define (opt-copy-subst-spmd-call-arg
  [env : OptCopyEnv]
  [arg : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArg
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class value ty)
      (ir.CompilerIrSpmdCallArg.Arg
        class
        (opt-copy-resolve-spmd-value env class value)
        ty)]))

(define (opt-copy-subst-spmd-call-args-array
  [env : OptCopyEnv]
  [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [dst : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-copy-subst-spmd-call-arg env (array-ref src index)))
      (opt-copy-subst-spmd-call-args-array env src dst (+ index 1)))))

(define (opt-copy-subst-spmd-call-args
  [env : OptCopyEnv]
  [args : ir.CompilerIrSpmdCallArgList]) : ir.CompilerIrSpmdCallArgList
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) ir.CompilerIrSpmdCallArgList.Nil]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (ir.CompilerIrSpmdCallArgList.Cons
        (opt-copy-subst-spmd-call-arg env arg)
        (box (opt-copy-subst-spmd-call-args env (__tl-box-place rest))))]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 seq.len]
        [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        [out : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
          (array.make-array ir.CompilerIrSpmdCallArg count)]
        (begin
          (opt-copy-subst-spmd-call-args-array env src out 0)
          (ir.CompilerIrSpmdCallArgList.Array
            (ir.CompilerIrSpmdCallArgSeq out count))))]))

;; Rewrite the value-use operands of an instruction through the copy env. Phi
;; inputs and the raw var id of `CompilerIrInstr.AddrOf` are intentionally not rewritten.
(define (opt-copy-subst-instr [env : OptCopyEnv] [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov dst (opt-copy-resolve env src) ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        dst
        (opt-copy-resolve env base)
        (opt-copy-resolve env offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load dst (opt-copy-resolve env src) ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-copy-resolve env ptr)
        (opt-copy-resolve env value)
        ty)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (ir.CompilerIrInstr.CopyBytes
        (opt-copy-resolve env dst)
        (opt-copy-resolve env src)
        size)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op l r ty)
      (ir.CompilerIrInstr.BinOp
        dst
        op
        (opt-copy-resolve env l)
        (opt-copy-resolve env r)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op v ty)
      (ir.CompilerIrInstr.UnOp dst op (opt-copy-resolve env v) ty)]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat dst (opt-copy-resolve env value) lanes ty)]
    ;; Vector IR uses private aggregate values that the scalar copy pass cannot
    ;; type-check yet, so leave those operands untouched until a vector-aware
    ;; propagation pass exists. Mask operands are private too, so only var-to-var
    ;; mask copies are substituted; scalar bool literals are not mask constants.
    [(ir.CompilerIrInstr.VectorBinOp _) instr]
    [(ir.CompilerIrInstr.VectorPrefix _) instr]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) instr]
    [(ir.CompilerIrInstr.VectorCompare _) instr]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-copy-resolve-mask env lhs)
        (opt-copy-resolve-mask env rhs)
        lanes)]
    [(ir.CompilerIrInstr.MaskNot dst src lanes)
      (ir.CompilerIrInstr.MaskNot dst (opt-copy-resolve-mask env src) lanes)]
    [(ir.CompilerIrInstr.MaskReduce dst op src lanes)
      (ir.CompilerIrInstr.MaskReduce
        dst
        op
        (opt-copy-resolve-mask env src)
        lanes)]
    [(ir.CompilerIrInstr.Select _) instr]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) instr]
    [(ir.CompilerIrInstr.VectorStore _) instr]
    [(ir.CompilerIrInstr.PredicatedStore _) instr]
    [(ir.CompilerIrInstr.PredicatedLoad _) instr]
    [(ir.CompilerIrInstr.GatherLoad _) instr]
    [(ir.CompilerIrInstr.VectorShuffle _) instr]
    [(ir.CompilerIrInstr.TailMask _ _ _ _) instr]
    [(ir.CompilerIrInstr.EntryArgc _) instr]
    [(ir.CompilerIrInstr.EntryArgv _) instr]
    [(ir.CompilerIrInstr.EntryEnvp _) instr]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (ir.CompilerIrInstr.CpuId
        dst
        (opt-copy-resolve env leaf)
        (opt-copy-resolve env subleaf)
        reg-index)]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (ir.CompilerIrInstr.Xgetbv dst (opt-copy-resolve env index))]
    [(ir.CompilerIrInstr.Syscall dst args)
      (ir.CompilerIrInstr.Syscall dst (opt-copy-subst-call-args env args))]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (ir.CompilerIrInstr.Call dst name (opt-copy-subst-call-args env args) ty)]
    [(ir.CompilerIrInstr.CallIndirect dst func args ty)
      (ir.CompilerIrInstr.CallIndirect
        dst
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst func args ty)
      (ir.CompilerIrInstr.CallIndirectC
        dst
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-cabi-store-result
          (opt-copy-resolve env base)
          name
          (opt-copy-subst-call-args env args)
          slots))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-indirect-cabi-store-result
          (opt-copy-resolve env base)
          (opt-copy-resolve env func)
          (opt-copy-subst-call-args env args)
          slots))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (ir.ir-instr-spmd-call
          callee
          backend
          lanes
          (opt-copy-resolve-mask env active-mask)
          (opt-copy-subst-spmd-call-args env args)
          result))]
    [(ir.CompilerIrInstr.TailCall name args ty)
      (ir.CompilerIrInstr.TailCall name (opt-copy-subst-call-args env args) ty)]
    [(ir.CompilerIrInstr.Store name value ty)
      (ir.CompilerIrInstr.Store name (opt-copy-resolve env value) ty)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-copy-resolve env index)
        (opt-copy-resolve env length)
        ok-label)]
    [(ir.CompilerIrInstr.Branch cond a b)
      (ir.CompilerIrInstr.Branch (opt-copy-resolve env cond) a b)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond a b)
      (ir.CompilerIrInstr.TotalEnumBranch (opt-copy-resolve env cond) a b)]
    [(ir.CompilerIrInstr.Return maybe)
      (match maybe
        [(ir.CompilerIrMaybeValue.Some value)
          (ir.CompilerIrInstr.Return
            (ir.CompilerIrMaybeValue.Some (opt-copy-resolve env value)))]
        [(ir.CompilerIrMaybeValue.No) instr])]
    ;; `CompilerIrInstr.AddrOf` takes the address of a storage slot named by a raw var id,
    ;; not a value, so its operand must not be copy-substituted.
    [(ir.CompilerIrInstr.AddrOf _ _) instr]
    ;; `CompilerIrInstr.Alloc`/`CompilerIrInstr.Jump` have no value operands; `CompilerIrInstr.Phi` inputs
    ;; belong to predecessor edges and are not block-local copies.
    [(ir.CompilerIrInstr.Alloc _ _) instr]
    [(ir.CompilerIrInstr.LaneId _ _ _) instr]
    [(ir.CompilerIrInstr.Jump _) instr]
    [(ir.CompilerIrInstr.Phi _ _ _) instr]
    ;; Register-group ops carry value operands -- substitute copies into
    ;; the packed words / the extracted source group.
    [(ir.CompilerIrInstr.Pack dst words ty)
      (ir.CompilerIrInstr.Pack dst (opt-copy-subst-value-list env words) ty)]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (let
        [resolved-src : ir.CompilerIrValue (opt-copy-resolve env src)]
        (match resolved-src
          [(ir.CompilerIrValue.Var group)
            (match (opt-copy-pack-word-lookup env group index)
              [(ir.CompilerIrMaybeValue.Some word)
                (ir.CompilerIrInstr.Mov dst (opt-copy-resolve env word) ty)]
              [(ir.CompilerIrMaybeValue.No)
                (ir.CompilerIrInstr.Word dst resolved-src index ty)])]
          [_ (ir.CompilerIrInstr.Word dst resolved-src index ty)]))]
    [(ir.CompilerIrInstr.TailCallIndirect func args ty)
      (ir.CompilerIrInstr.TailCallIndirect
        (opt-copy-resolve env func)
        (opt-copy-subst-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        (opt-copy-resolve env index)
        base
        cases
        default-label)]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (opt-copy-resolve env index)
        base
        cases
        default-label
        trap-label)]))

;; Update the copy env after an instruction. A `Mov dst src` (with `src` already
;; substituted) records a copy when `src` is a safe, non-self source. Every other
;; defining instruction invalidates its destination. Stores and terminators
;; define no var, so the copy facts are unaffected (the env resets per block).
(define (opt-copy-update-env [env : OptCopyEnv] [instr : ir.CompilerIrInstr]) : OptCopyEnv
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (let
        [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
        (if (and (opt-copy-safe-source? src) (not (opt-value-is-var? src dst)))
          (OptCopyEnv.Cons dst src (box e1))
          e1))]
    [(ir.CompilerIrInstr.Alloc dst _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.AddrOf dst src)
      (opt-copy-invalidate-var (opt-copy-invalidate-var env dst) src)]
    [(ir.CompilerIrInstr.Gep dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Load dst _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Cast dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.LaneId dst _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ lhs rhs _)
      (let
        [e1 : OptCopyEnv (opt-copy-invalidate-var env dst)]
        (if (and (opt-value-eq lhs rhs) (opt-copy-mask-source? lhs dst))
          (OptCopyEnv.Cons dst lhs (box e1))
          e1))]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-copy-invalidate-var env dst))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.EntryArgc dst) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.EntryArgv dst) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.EntryEnvp dst) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Xgetbv dst _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Syscall dst _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.Call dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) env]
          [(ir.CompilerIrSpmdCallResult.Value dst _ _)
            (opt-copy-invalidate-var env dst)]))]
    [(ir.CompilerIrInstr.Phi dst _ _) (opt-copy-invalidate-var env dst)]
    ;; Register-group ops define their dst -- drop any stale copy fact for
    ;; it (a reused var id must not trigger a later stale rewrite).
    [(ir.CompilerIrInstr.Pack dst words _)
      (opt-copy-update-pack-env env dst words)]
    [(ir.CompilerIrInstr.Word dst _ _ _) (opt-copy-invalidate-var env dst)]
    [(ir.CompilerIrInstr.StorePtr _ _ _) (OptCopyEnv.Nil)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) (OptCopyEnv.Nil)]
    [_ env]))

(defenum OptCopyResult
  (Result OptCopyEnv ir.CompilerIrInstr))

(define (opt-copy-instr [env : OptCopyEnv] [instr : ir.CompilerIrInstr]) : OptCopyResult
  (let
    [rewritten : ir.CompilerIrInstr (opt-copy-subst-instr env instr)]
    (OptCopyResult.Result (opt-copy-update-env env rewritten) rewritten)))

(define (opt-copy-instrs [env : OptCopyEnv] [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match (opt-copy-instr env instr)
        [(OptCopyResult.Result new-env new-instr)
          (ir.compiler-ir-instr-cons
            new-instr
            (opt-copy-instrs new-env (__tl-box-place rest)))])]))

;; --- block-local redundant bounds-check elimination -------------------------
;;
;; `CompilerIrInstr.BoundsCheck index length ok-label` is a trapping side-effect: it must be kept
;; unless the same `(index, length)` pair has already been checked on every
;; preceding path within the same basic block. This pass is deliberately local.
;; It records successful checks after copy propagation has resolved operands,
;; invalidates facts when either operand var is redefined, and clears all facts
;; across calls, stores, control-flow boundaries, and phi boundaries.
(defenum OptBoundsFact
  (Fact ir.CompilerIrValue ir.CompilerIrValue))

(defenum OptBoundsFacts
  (Nil)
  (Cons OptBoundsFact (Box OptBoundsFacts)))

(defenum OptObjectLengthFact
  (None)
  (Known i64 i64))

(define (opt-bounds-length-uses-var? [length : ir.CompilerIrValue] [var : i64]) : bool
  (match length
    [(ir.CompilerIrValue.Var id)
      (if (< id 0)
        (= (- (- 0 id) 1) var)
        (= id var))]
    [_ false]))

(define (opt-object-length-lookup [fact : OptObjectLengthFact] [var : i64]) : option_i64.Option
  (match fact
    [(OptObjectLengthFact.Known fact-var object-var)
      (if (= fact-var var)
        (option_i64.Some object-var)
        (option_i64.None))]
    [(OptObjectLengthFact.None) (option_i64.None)]))

(define (opt-bounds-length-value
  [facts : OptObjectLengthFact]
  [length : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match length
    [(ir.CompilerIrValue.Var var)
      (match (opt-object-length-lookup facts var)
        [(option_i64.Some object-var)
          (ir.CompilerIrValue.Var (- 0 (+ object-var 1)))]
        [(option_i64.None) length])]
    [_ length]))

(define (opt-bounds-fact-eq
  [fact : OptBoundsFact]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : bool
  (match fact
    [(OptBoundsFact.Fact fact-index fact-length)
      (and (opt-value-eq fact-index index) (opt-value-eq fact-length length))]))

(define (opt-bounds-contains
  [facts : OptBoundsFacts]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : bool
  (match facts
    [(OptBoundsFacts.Nil) false]
    [(OptBoundsFacts.Cons fact rest)
      (let
        [rest : OptBoundsFacts (__tl-box-place rest)]
        (if (opt-bounds-fact-eq fact index length)
          true
          (opt-bounds-contains rest index length)))]))

(define (opt-bounds-add
  [facts : OptBoundsFacts]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : OptBoundsFacts
  (if (opt-bounds-contains facts index length)
    facts
    (OptBoundsFacts.Cons (OptBoundsFact.Fact index length) (box facts))))

;; Has this index passed a check against ANY length? `bounds_check` is an
;; unsigned `index < length` whose length operand is a runtime container
;; length, so it is below 2^63 and an index that passed cannot have its sign
;; bit set: reaching a point the check dominates proves `0 <= index` in the
;; SIGNED domain, whatever length was used. The dominator walk uses that to
;; discharge the nonnegative half of a LATER check on the same index whose
;; length half a dominating comparison already decided. The block-local pass
;; never asks.
(define (opt-bounds-index-checked?
  [facts : OptBoundsFacts]
  [index : ir.CompilerIrValue]) : bool
  (match facts
    [(OptBoundsFacts.Nil) false]
    [(OptBoundsFacts.Cons fact rest)
      (match fact
        [(OptBoundsFact.Fact fact-index _)
          (if (opt-value-eq fact-index index)
            true
            (opt-bounds-index-checked? (deref rest) index))])]))

(define (opt-bounds-fact-uses-var? [fact : OptBoundsFact] [var : i64]) : bool
  (match fact
    [(OptBoundsFact.Fact index length)
      (or
        (opt-value-is-var? index var)
        (opt-bounds-length-uses-var? length var))]))

(define (opt-bounds-invalidate-var [facts : OptBoundsFacts] [var : i64]) : OptBoundsFacts
  (match facts
    [(OptBoundsFacts.Nil) (OptBoundsFacts.Nil)]
    [(OptBoundsFacts.Cons fact rest)
      (let
        [rest2 : OptBoundsFacts
          (opt-bounds-invalidate-var (__tl-box-place rest) var)]
        (if (opt-bounds-fact-uses-var? fact var)
          rest2
          (OptBoundsFacts.Cons fact (box rest2))))]))

;; Index canonicalization: an array index is lowered to a fresh
;; `Cast(idx, I64->U64)` per access (see `lower-array-element-addr`), so two
;; bounds checks on the *same* logical index (e.g. read-then-write `xs[i]` in a
;; swap) carry distinct cast vars and never match by `opt-value-eq`. The cast is
;; a bit-preserving reinterpret, so the unsigned bounds comparison is identical
;; and keying the fact on the pre-cast source value is sound. `OptBoundsCastEnv`
;; maps each `I64->U64` cast dst back to its source; entries are dropped when the
;; dst or the source var is redefined, and the whole env is cleared wherever the
;; bounds facts are (calls/stores/CF/phi), so it can never outlive a redefinition
;; of the source.
(defenum OptBoundsCastEnv
  (Nil)
  (Cons i64 ir.CompilerIrValue (Box OptBoundsCastEnv)))

(define (opt-bounds-cast-unbind [env : OptBoundsCastEnv] [var : i64]) : OptBoundsCastEnv
  (match env
    [(OptBoundsCastEnv.Nil) (OptBoundsCastEnv.Nil)]
    [(OptBoundsCastEnv.Cons dst src rest)
      (let
        [tail : OptBoundsCastEnv
          (opt-bounds-cast-unbind (__tl-box-place rest) var)]
        (if (or (= dst var) (opt-value-is-var? src var))
          tail
          (OptBoundsCastEnv.Cons dst src (box tail))))]))

(define (opt-bounds-cast-bind
  [env : OptBoundsCastEnv]
  [dst : i64]
  [src : ir.CompilerIrValue]) : OptBoundsCastEnv
  (OptBoundsCastEnv.Cons dst src (box (opt-bounds-cast-unbind env dst))))

;; Resolve `value` back through one `I64->U64` reinterpret cast, if recorded.
(define (opt-bounds-cast-canon
  [env : OptBoundsCastEnv]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var var)
      (match env
        [(OptBoundsCastEnv.Nil) value]
        [(OptBoundsCastEnv.Cons dst src rest)
          (if (= dst var)
            src
            (opt-bounds-cast-canon (__tl-box-place rest) value))])]
    [_ value]))

;; Record an `I64->U64` reinterpret cast (the index/length unsigned-compare form)
;; so its dst canonicalizes to the source; other casts only invalidate the dst.
(define (opt-bounds-cast-update
  [type-segment-bases : i64]
  [env : OptBoundsCastEnv]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : OptBoundsCastEnv
  (if (and
    (opt-type-eq type-segment-bases from-ty (ast.AstType.I64))
    (opt-type-eq type-segment-bases to-ty (ast.AstType.U64)))
    (opt-bounds-cast-bind env dst src)
    (opt-bounds-cast-unbind env dst)))

(define (opt-object-length-invalidate-var
  [fact : OptObjectLengthFact]
  [var : i64]) : OptObjectLengthFact
  (match fact
    [(OptObjectLengthFact.Known length-var object-var)
      (if (or (= length-var var) (= object-var var))
        (OptObjectLengthFact.None)
        fact)]
    [(OptObjectLengthFact.None) fact]))

(define (opt-object-length-bind
  [_fact : OptObjectLengthFact]
  [length-var : i64]
  [object-var : i64]) : OptObjectLengthFact
  (OptObjectLengthFact.Known length-var object-var))

(define (opt-bounds-object-length-slot?
  [type-segment-bases : i64]
  [offset : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (match offset
    [(ir.CompilerIrValue.I64 value)
      (or
        (and (= value 1) (opt-type-eq type-segment-bases ty (ast.AstType.I64)))
        (and (= value 8) (opt-type-eq type-segment-bases ty (ast.AstType.U8))))]
    [_ false]))

(define (opt-bounds-update-facts
  [facts : OptBoundsFacts]
  [instr : ir.CompilerIrInstr]) : OptBoundsFacts
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Alloc dst _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.AddrOf dst _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Gep dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Load dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Cast dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.LaneId dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-bounds-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-bounds-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-bounds-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-bounds-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-bounds-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-bounds-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.EntryArgc dst) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.EntryArgv dst) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.EntryEnvp dst) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.CpuId _ _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Xgetbv _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Syscall _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Call _ _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.SpmdCall _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.VectorShuffle _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.TailCall _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Store _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.StorePtr _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.VectorStore _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.PredicatedStore _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Jump _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Branch _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Return _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Phi _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) facts]
    [(ir.CompilerIrInstr.Pack dst _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Word dst _ _ _) (opt-bounds-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.Switch _ _ _ _) (OptBoundsFacts.Nil)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) (OptBoundsFacts.Nil)]))

(define (opt-bounds-instrs-with-object
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [lengths : OptObjectLengthFact]
  [ptrs : OptObjectLengthFact]
  [casts : OptBoundsCastEnv]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match instr
        [(ir.CompilerIrInstr.BoundsCheck index length _)
          (let
            [index-key : ir.CompilerIrValue (opt-bounds-cast-canon casts index)]
            [length-key : ir.CompilerIrValue
              (opt-bounds-length-value lengths length)]
            (if (opt-bounds-contains facts index-key length-key)
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts
                lengths
                ptrs
                casts
                (__tl-box-place rest))
              (ir.compiler-ir-instr-cons
                instr
                (opt-bounds-instrs-with-object
                  type-segment-bases
                  (opt-bounds-add facts index-key length-key)
                  lengths
                  ptrs
                  casts
                  (__tl-box-place rest)))))]
        [(ir.CompilerIrInstr.Gep dst base offset ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [ptrs3 : OptObjectLengthFact
              (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
                (match base
                  [(ir.CompilerIrValue.Var object-var)
                    (opt-object-length-bind ptrs2 dst object-var)]
                  [_ ptrs2])
                ptrs2)]
            (ir.compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts2
                lengths2
                ptrs3
                (opt-bounds-cast-unbind casts dst)
                (__tl-box-place rest))))]
        [(ir.CompilerIrInstr.Load dst src ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [lengths3 : OptObjectLengthFact
              (if (opt-type-eq type-segment-bases ty (ast.AstType.I64))
                (match src
                  [(ir.CompilerIrValue.Var ptr-var)
                    (match (opt-object-length-lookup ptrs2 ptr-var)
                      [(option_i64.Some object-var)
                        (opt-object-length-bind lengths2 dst object-var)]
                      [(option_i64.None) lengths2])]
                  [_ lengths2])
                lengths2)]
            (ir.compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts2
                lengths3
                ptrs2
                (opt-bounds-cast-unbind casts dst)
                (__tl-box-place rest))))]
        [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
          (let
            [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [lengths2 : OptObjectLengthFact
              (opt-object-length-invalidate-var lengths dst)]
            [ptrs2 : OptObjectLengthFact
              (opt-object-length-invalidate-var ptrs dst)]
            [lengths3 : OptObjectLengthFact
              (if (and
                (opt-type-eq type-segment-bases from-ty (ast.AstType.I64))
                (opt-type-eq type-segment-bases to-ty (ast.AstType.U64)))
                (match src
                  [(ir.CompilerIrValue.Var length-var)
                    (match (opt-object-length-lookup lengths2 length-var)
                      [(option_i64.Some object-var)
                        (opt-object-length-bind lengths2 dst object-var)]
                      [(option_i64.None) lengths2])]
                  [_ lengths2])
                lengths2)]
            (ir.compiler-ir-instr-cons
              instr
              (opt-bounds-instrs-with-object
                type-segment-bases
                facts2
                lengths3
                ptrs2
                (opt-bounds-cast-update
                  type-segment-bases
                  casts
                  dst
                  src
                  from-ty
                  to-ty)
                (__tl-box-place rest))))]
        ;; An array element store cannot change any array's LENGTH (in TL a
        ;; length slot is only ever written by make-array, and user code cannot
        ;; obtain a raw pointer to it), so the (index, length-token) bounds facts
        ;; survive it. Only a store whose target is a tracked length-slot pointer
        ;; (the make-array length write) clears the facts; element stores -- which
        ;; never alias a length slot -- keep object mode and its facts. This lets a
        ;; read-then-write of the same slot (qs-swap) drop the write's check.
        [(ir.CompilerIrInstr.StorePtr ptr _ _)
          (match ptr
            [(ir.CompilerIrValue.Var ptr-var)
              (match (opt-object-length-lookup ptrs ptr-var)
                [(option_i64.Some _)
                  (ir.compiler-ir-instr-cons
                    instr
                    (opt-bounds-instrs
                      type-segment-bases
                      (OptBoundsFacts.Nil)
                      casts
                      (__tl-box-place rest)))]
                [(option_i64.None)
                  (ir.compiler-ir-instr-cons
                    instr
                    (opt-bounds-instrs-with-object
                      type-segment-bases
                      facts
                      lengths
                      ptrs
                      casts
                      (__tl-box-place rest)))])]
            [_
              (ir.compiler-ir-instr-cons
                instr
                (opt-bounds-instrs
                  type-segment-bases
                  (OptBoundsFacts.Nil)
                  casts
                  (__tl-box-place rest)))])]
        [_
          (let
            [next-facts : OptBoundsFacts (opt-bounds-update-facts facts instr)]
            [casts2 : OptBoundsCastEnv
              (match (opt-instr-def-var instr)
                [(option_i64.Some dst) (opt-bounds-cast-unbind casts dst)]
                [(option_i64.None) casts])]
            (match next-facts
              [(OptBoundsFacts.Nil)
                (ir.compiler-ir-instr-cons
                  instr
                  (opt-bounds-instrs
                    type-segment-bases
                    next-facts
                    casts2
                    (__tl-box-place rest)))]
              [_
                (match (opt-instr-def-var instr)
                  [(option_i64.Some dst)
                    (ir.compiler-ir-instr-cons
                      instr
                      (opt-bounds-instrs-with-object
                        type-segment-bases
                        next-facts
                        (opt-object-length-invalidate-var lengths dst)
                        (opt-object-length-invalidate-var ptrs dst)
                        casts2
                        (__tl-box-place rest)))]
                  [(option_i64.None)
                    (ir.compiler-ir-instr-cons
                      instr
                      (opt-bounds-instrs-with-object
                        type-segment-bases
                        next-facts
                        lengths
                        ptrs
                        casts2
                        (__tl-box-place rest)))])]))])]))

(define (opt-bounds-instrs
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [casts : OptBoundsCastEnv]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match instr
        [(ir.CompilerIrInstr.BoundsCheck index length _)
          (let
            [index-key : ir.CompilerIrValue (opt-bounds-cast-canon casts index)]
            (if (opt-bounds-contains facts index-key length)
              (opt-bounds-instrs
                type-segment-bases
                facts
                casts
                (__tl-box-place rest))
              (ir.compiler-ir-instr-cons
                instr
                (opt-bounds-instrs
                  type-segment-bases
                  (opt-bounds-add facts index-key length)
                  casts
                  (__tl-box-place rest)))))]
        [(ir.CompilerIrInstr.Gep dst base offset ty)
          (let
            [next-facts : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
            [casts2 : OptBoundsCastEnv (opt-bounds-cast-unbind casts dst)]
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (ir.compiler-ir-instr-cons
                instr
                (opt-bounds-instrs-with-object
                  type-segment-bases
                  next-facts
                  (OptObjectLengthFact.None)
                  (match base
                    [(ir.CompilerIrValue.Var object-var)
                      (opt-object-length-bind
                        (OptObjectLengthFact.None)
                        dst
                        object-var)]
                    [_ (OptObjectLengthFact.None)])
                  casts2
                  (__tl-box-place rest)))
              (ir.compiler-ir-instr-cons
                instr
                (opt-bounds-instrs
                  type-segment-bases
                  next-facts
                  casts2
                  (__tl-box-place rest)))))]
        [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
          (ir.compiler-ir-instr-cons
            instr
            (opt-bounds-instrs
              type-segment-bases
              (opt-bounds-update-facts facts instr)
              (opt-bounds-cast-update
                type-segment-bases
                casts
                dst
                src
                from-ty
                to-ty)
              (__tl-box-place rest)))]
        [_
          (ir.compiler-ir-instr-cons
            instr
            (opt-bounds-instrs
              type-segment-bases
              (opt-bounds-update-facts facts instr)
              (match (opt-instr-def-var instr)
                [(option_i64.Some dst) (opt-bounds-cast-unbind casts dst)]
                [(option_i64.None) casts])
              (__tl-box-place rest)))])]))

(defenum OptBoundsSeqState
  (Plain OptBoundsFacts OptBoundsCastEnv)
  (Object
    OptBoundsFacts
    OptObjectLengthFact
    OptObjectLengthFact
    OptBoundsCastEnv))

(defenum OptBoundsSeqStep
  (Step OptBoundsSeqState bool))

(define (opt-bounds-casts-after
  [casts : OptBoundsCastEnv]
  [instr : ir.CompilerIrInstr]) : OptBoundsCastEnv
  (match (opt-instr-def-var instr)
    [(option_i64.Some dst) (opt-bounds-cast-unbind casts dst)]
    [(option_i64.None) casts]))

(define (opt-bounds-seq-step-plain
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [casts : OptBoundsCastEnv]
  [instr : ir.CompilerIrInstr]) : OptBoundsSeqStep
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (let
        [index-key : ir.CompilerIrValue (opt-bounds-cast-canon casts index)]
        (if (opt-bounds-contains facts index-key length)
          (OptBoundsSeqStep.Step (OptBoundsSeqState.Plain facts casts) false)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Plain
              (opt-bounds-add facts index-key length)
              casts)
            true)))]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (let
        [next-facts : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [next-casts : OptBoundsCastEnv (opt-bounds-cast-unbind casts dst)]
        (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Object
              next-facts
              (OptObjectLengthFact.None)
              (match base
                [(ir.CompilerIrValue.Var object-var)
                  (opt-object-length-bind
                    (OptObjectLengthFact.None)
                    dst
                    object-var)]
                [_ (OptObjectLengthFact.None)])
              next-casts)
            true)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Plain next-facts next-casts)
            true)))]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (OptBoundsSeqStep.Step
        (OptBoundsSeqState.Plain
          (opt-bounds-update-facts facts instr)
          (opt-bounds-cast-update
            type-segment-bases
            casts
            dst
            src
            from-ty
            to-ty))
        true)]
    [_
      (OptBoundsSeqStep.Step
        (OptBoundsSeqState.Plain
          (opt-bounds-update-facts facts instr)
          (opt-bounds-casts-after casts instr))
        true)]))

(define (opt-bounds-seq-step-object
  [type-segment-bases : i64]
  [facts : OptBoundsFacts]
  [lengths : OptObjectLengthFact]
  [ptrs : OptObjectLengthFact]
  [casts : OptBoundsCastEnv]
  [instr : ir.CompilerIrInstr]) : OptBoundsSeqStep
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (let
        [index-key : ir.CompilerIrValue (opt-bounds-cast-canon casts index)]
        [length-key : ir.CompilerIrValue
          (opt-bounds-length-value lengths length)]
        (if (opt-bounds-contains facts index-key length-key)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Object facts lengths ptrs casts)
            false)
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Object
              (opt-bounds-add facts index-key length-key)
              lengths
              ptrs
              casts)
            true)))]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (let
        [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [lengths2 : OptObjectLengthFact
          (opt-object-length-invalidate-var lengths dst)]
        [ptrs2 : OptObjectLengthFact
          (opt-object-length-invalidate-var ptrs dst)]
        [ptrs3 : OptObjectLengthFact
          (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
            (match base
              [(ir.CompilerIrValue.Var object-var)
                (opt-object-length-bind ptrs2 dst object-var)]
              [_ ptrs2])
            ptrs2)]
        (OptBoundsSeqStep.Step
          (OptBoundsSeqState.Object
            facts2
            lengths2
            ptrs3
            (opt-bounds-cast-unbind casts dst))
          true))]
    [(ir.CompilerIrInstr.Load dst src ty)
      (let
        [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [lengths2 : OptObjectLengthFact
          (opt-object-length-invalidate-var lengths dst)]
        [ptrs2 : OptObjectLengthFact
          (opt-object-length-invalidate-var ptrs dst)]
        [lengths3 : OptObjectLengthFact
          (if (opt-type-eq type-segment-bases ty (ast.AstType.I64))
            (match src
              [(ir.CompilerIrValue.Var ptr-var)
                (match (opt-object-length-lookup ptrs2 ptr-var)
                  [(option_i64.Some object-var)
                    (opt-object-length-bind lengths2 dst object-var)]
                  [(option_i64.None) lengths2])]
              [_ lengths2])
            lengths2)]
        (OptBoundsSeqStep.Step
          (OptBoundsSeqState.Object
            facts2
            lengths3
            ptrs2
            (opt-bounds-cast-unbind casts dst))
          true))]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (let
        [facts2 : OptBoundsFacts (opt-bounds-invalidate-var facts dst)]
        [lengths2 : OptObjectLengthFact
          (opt-object-length-invalidate-var lengths dst)]
        [ptrs2 : OptObjectLengthFact
          (opt-object-length-invalidate-var ptrs dst)]
        [lengths3 : OptObjectLengthFact
          (if (and
            (opt-type-eq type-segment-bases from-ty (ast.AstType.I64))
            (opt-type-eq type-segment-bases to-ty (ast.AstType.U64)))
            (match src
              [(ir.CompilerIrValue.Var length-var)
                (match (opt-object-length-lookup lengths2 length-var)
                  [(option_i64.Some object-var)
                    (opt-object-length-bind lengths2 dst object-var)]
                  [(option_i64.None) lengths2])]
              [_ lengths2])
            lengths2)]
        (OptBoundsSeqStep.Step
          (OptBoundsSeqState.Object
            facts2
            lengths3
            ptrs2
            (opt-bounds-cast-update
              type-segment-bases
              casts
              dst
              src
              from-ty
              to-ty))
          true))]
    [(ir.CompilerIrInstr.StorePtr ptr _ _)
      (match ptr
        [(ir.CompilerIrValue.Var ptr-var)
          (match (opt-object-length-lookup ptrs ptr-var)
            [(option_i64.Some _)
              (OptBoundsSeqStep.Step
                (OptBoundsSeqState.Plain (OptBoundsFacts.Nil) casts)
                true)]
            [(option_i64.None)
              (OptBoundsSeqStep.Step
                (OptBoundsSeqState.Object facts lengths ptrs casts)
                true)])]
        [_
          (OptBoundsSeqStep.Step
            (OptBoundsSeqState.Plain (OptBoundsFacts.Nil) casts)
            true)])]
    [_
      (let
        [next-facts : OptBoundsFacts (opt-bounds-update-facts facts instr)]
        [next-casts : OptBoundsCastEnv (opt-bounds-casts-after casts instr)]
        (match next-facts
          [(OptBoundsFacts.Nil)
            (OptBoundsSeqStep.Step
              (OptBoundsSeqState.Plain next-facts next-casts)
              true)]
          [_
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (OptBoundsSeqStep.Step
                  (OptBoundsSeqState.Object
                    next-facts
                    (opt-object-length-invalidate-var lengths dst)
                    (opt-object-length-invalidate-var ptrs dst)
                    next-casts)
                  true)]
              [(option_i64.None)
                (OptBoundsSeqStep.Step
                  (OptBoundsSeqState.Object next-facts lengths ptrs next-casts)
                  true)])]))]))

(define (opt-bounds-instr-seq-rewrite!
  [type-segment-bases : i64]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [read : i64 0]
    [write : i64 0]
    [count : i64 instrs.len]
    [state : OptBoundsSeqState
      (OptBoundsSeqState.Plain (OptBoundsFacts.Nil) (OptBoundsCastEnv.Nil))]
    (begin
      (while (< read count)
        (let
          [instr : ir.CompilerIrInstr (clone (array-ref instrs.slots read))]
          [step : OptBoundsSeqStep
            (match state
              [(OptBoundsSeqState.Plain facts casts)
                (opt-bounds-seq-step-plain type-segment-bases facts casts instr)]
              [(OptBoundsSeqState.Object facts lengths ptrs casts)
                (opt-bounds-seq-step-object
                  type-segment-bases
                  facts
                  lengths
                  ptrs
                  casts
                  instr)])]
          (match step
            [(OptBoundsSeqStep.Step next-state keep)
              (begin
                (if keep
                  (begin
                    (if (not (= write read))
                      (set! (array-ref instrs.slots write) instr)
                      unit)
                    (set! write (+ write 1)))
                  unit)
                (set! state next-state)
                (set! read (+ read 1)))])))
      (set! instrs.len write))))

;; --- conservative CFG simplification ----------------------------------------
;;
;; Runs after block-local constant/copy propagation has exposed literal branch
;; conditions. It rewrites known boolean branches to jumps, computes reachable
;; blocks from the function entry block, drops unreachable blocks, and trims phi
;; inputs from predecessors that are no longer reachable.
(defenum OptLabelSet
  (Nil)
  ;; Slot zero is the shared high-water length; labels occupy slots 1..len in
  ;; oldest-first order. The logical set head is `items[len]`, so recursive
  ;; consumers can take an allocation-free tail view by decrementing `len`.
  ;; Extending a prefix is in-place only while it is the unique high-water
  ;; view. Extending a tail or an already-branched prefix copies first, keeping
  ;; the persistent cons semantics callers had with the old linked list.
  (Dense (__tl_dyn-array i64) i64))

(define (opt-dense-next-capacity [len : i64]) : i64
  (if (< len 4)
    4
    (* len 2)))

(define (opt-label-ref [set : OptLabelSet] [index : i64]) : i64
  (match set
    [(OptLabelSet.Nil) (ir.compiler-ir-label-none)]
    [(OptLabelSet.Dense items len) (array-ref items (- len index))]))

(define (opt-label-tail [set : OptLabelSet]) : OptLabelSet
  (match set
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense items len)
      (if (<= len 1)
        (OptLabelSet.Nil)
        (OptLabelSet.Dense items (- len 1)))]))

(define (opt-label-cons [label : i64] [set : OptLabelSet]) : OptLabelSet
  (match set
    [(OptLabelSet.Nil)
      (let
        [items : (__tl_dyn-array i64) (array.make-array i64 5)]
        (begin
          (set! (array-ref items 0) 1)
          (set! (array-ref items 1) label)
          (OptLabelSet.Dense items 1)))]
    [(OptLabelSet.Dense items len)
      (if (and (= len (array-ref items 0)) (< len (- (array-length items) 1)))
        (begin
          (set! (array-ref items (+ len 1)) label)
          (set! (array-ref items 0) (+ len 1))
          (OptLabelSet.Dense items (+ len 1)))
        (let
          [old-capacity : i64 (- (array-length items) 1)]
          [capacity : i64
            (if (< len old-capacity)
              old-capacity
              (opt-dense-next-capacity len))]
          [bigger : (__tl_dyn-array i64) (array.make-array i64 (+ capacity 1))]
          [index : i64 0]
          (begin
            (while (< index len)
              (begin
                (set!
                  (array-ref bigger (+ index 1))
                  (array-ref items (+ index 1)))
                (set! index (+ index 1))))
            (set! (array-ref bigger 0) (+ len 1))
            (set! (array-ref bigger (+ len 1)) label)
            (OptLabelSet.Dense bigger (+ len 1)))))]))

;; Membership walks the backing array directly rather than through
;; `opt-label-count` plus one `opt-label-ref` per element. The sets are tiny --
;; on a self-compile 45% of the queries are against the empty set and 88% see two
;; labels or fewer -- so the dispatch per element, not the element count, is what
;; this loop costs. Slot `len` down to slot 1 is exactly `opt-label-ref`'s index
;; 0 up to `count - 1`, newest label first.
(define (opt-label-contains [set : OptLabelSet] [label : i64]) : bool
  (match set
    [(OptLabelSet.Nil) false]
    [(OptLabelSet.Dense items len)
      (let
        [slot : i64 len]
        (begin
          (while (> slot 0)
            (if (= (array-ref items slot) label)
              (return true)
              (set! slot (- slot 1))))
          false))]))

(define (opt-label-add [set : OptLabelSet] [label : i64]) : OptLabelSet
  (if (opt-label-contains set label)
    set
    (opt-label-cons label set)))

(define (opt-label-count [set : OptLabelSet]) : i64
  (match set
    [(OptLabelSet.Nil) 0]
    [(OptLabelSet.Dense _ len) len]))

(define (opt-label-subset? [a : OptLabelSet] [b : OptLabelSet]) : bool
  (match a
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (opt-label-contains b (opt-label-ref a 0))
        (opt-label-subset? (opt-label-tail a) b))]))

(define (opt-label-set-eq? [a : OptLabelSet] [b : OptLabelSet]) : bool
  (and (opt-label-subset? a b) (opt-label-subset? b a)))

(define (opt-label-intersection [a : OptLabelSet] [b : OptLabelSet]) : OptLabelSet
  (match a
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref a 0)]
        [tail : OptLabelSet (opt-label-intersection (opt-label-tail a) b)]
        (if (opt-label-contains b label)
          (opt-label-add tail label)
          tail))]))

(defenum OptMaybeBlock
  (No)
  (Some ir.CompilerIrBlock))

(define (opt-cfg-find-block [blocks : ir.CompilerIrBlockList] [label : i64]) : OptMaybeBlock
  (let
    [cursor : ir.CompilerIrBlockList blocks]
    (begin
      (while true
        (match cursor
          [(ir.CompilerIrBlockList.Nil) (return (OptMaybeBlock.No))]
          [(ir.CompilerIrBlockList.Cons block rest)
            (match block
              [(ir.CompilerIrBlock.Block block-label _)
                (if (= block-label label)
                  (return (OptMaybeBlock.Some block))
                  (set! cursor (__tl-box-place rest)))])]
          [(ir.CompilerIrBlockList.Array seq)
            (let
              [index : i64 0]
              [count : i64 (ir.compiler-ir-block-seq-count seq)]
              (begin
                (while (< index count)
                  (let
                    [block : ir.CompilerIrBlock
                      (ir.compiler-ir-block-seq-ref seq index)]
                    (match block
                      [(ir.CompilerIrBlock.Block block-label _)
                        (if (= block-label label)
                          (return (OptMaybeBlock.Some block))
                          (set! index (+ index 1)))])))
                (return (OptMaybeBlock.No))))]))
      (OptMaybeBlock.No))))

(define (opt-cfg-block-exists? [blocks : ir.CompilerIrBlockList] [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.Some _) true]
    [(OptMaybeBlock.No) false]))

(define (opt-cfg-entry-label [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.compiler-ir-label-none)]
    [(ir.CompilerIrBlockList.Cons block _)
      (match block
        [(ir.CompilerIrBlock.Block label _) label])]
    [(ir.CompilerIrBlockList.Array seq)
      (if (> (ir.compiler-ir-block-seq-count seq) 0)
        (match (ir.compiler-ir-block-seq-ref seq 0)
          [(ir.CompilerIrBlock.Block label _) label])
        (ir.compiler-ir-label-none))]))

;; A hash-set seen-check; the incremental label-list scan made this
;; O(blocks^2) string comparisons on large functions.
(define (opt-cfg-block-labels-unique-map?
  [blocks : ir.CompilerIrBlockList]
  [seen : opt_string_i64_map.Map (:consume)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (opt_string_i64_map.contains? (& seen) label)
            false
            (begin
              (opt_string_i64_map.insert-ref! (&mut seen) label 1)
              (opt-cfg-block-labels-unique-map? (__tl-box-place rest) seen)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-block-labels-unique-map?
        (ir.compiler-ir-block-seq-to-list seq)
        seen)]))

(define (opt-cfg-block-labels-unique? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-cfg-block-labels-unique-map?
    blocks
    (opt_string_i64_map.with-capacity 64)))

(define (opt-cfg-block-label-map
  [blocks : ir.CompilerIrBlockList]
  [seen : opt_string_i64_map.Map (:consume)]) : opt_string_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) seen]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (begin
            (opt_string_i64_map.insert-ref! (&mut seen) label 1)
            (opt-cfg-block-label-map (__tl-box-place rest) seen))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-block-label-map (ir.compiler-ir-block-seq-to-list seq) seen)]))

(define (opt-cfg-label-set-known-in-map?
  [labels : OptLabelSet]
  [known : opt_string_i64_map.Map]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (opt_string_i64_map.contains? (& known) label)
          (opt-cfg-label-set-known-in-map? (opt-label-tail labels) known)))]))

(define (opt-cfg-successor-targets-known-map?
  [blocks : ir.CompilerIrBlockList]
  [known : opt_string_i64_map.Map]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (and
        (opt-cfg-label-set-known-in-map?
          (opt-cfg-block-successors-with-next
            block
            (opt-cfg-entry-label (__tl-box-place rest)))
          known)
        (opt-cfg-successor-targets-known-map? (__tl-box-place rest) known))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-successor-targets-known-map?
        (ir.compiler-ir-block-seq-to-list seq)
        known)]))

(define (opt-cfg-successor-targets-known? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-cfg-successor-targets-known-map?
    blocks
    (opt-cfg-block-label-map blocks (opt_string_i64_map.with-capacity 64))))

(define (opt-cfg-predecessors-scan
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : OptLabelSet
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptLabelSet.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label _)
          (let
            [tail : OptLabelSet
              (opt-cfg-predecessors-scan (__tl-box-place rest) label)]
            (if (opt-label-contains
              (opt-cfg-block-successors-with-next
                block
                (opt-cfg-entry-label (__tl-box-place rest)))
              label)
              (opt-label-add tail block-label)
              tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-predecessors-scan (ir.compiler-ir-block-seq-to-list seq) label)]))

(define (opt-cfg-predecessors [blocks : ir.CompilerIrBlockList] [label : i64]) : OptLabelSet
  (opt-cfg-index-predecessors (opt-cfg-index-build blocks) label))

(define (opt-cfg-filter-blocks-by-labels
  [labels : OptLabelSet]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (opt-label-contains labels label)
            (ir.compiler-ir-block-cons
              block
              (opt-cfg-filter-blocks-by-labels labels (__tl-box-place rest)))
            (opt-cfg-filter-blocks-by-labels labels (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-filter-blocks-by-labels
        labels
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-reachable-block-order [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-cfg-filter-blocks-by-labels (opt-cfg-reachable-blocks blocks) blocks))

(defenum OptDomEntry
  (Entry i64 OptLabelSet))

(defenum OptLegacyDomTable
  (Nil)
  (Cons OptDomEntry (Box OptLegacyDomTable)))

(define (opt-dom-table-lookup [table : OptLegacyDomTable] [label : i64]) : OptLabelSet
  (match table
    [(OptLegacyDomTable.Nil) (OptLabelSet.Nil)]
    [(OptLegacyDomTable.Cons entry rest)
      (let
        [rest : OptLegacyDomTable (__tl-box-place rest)]
        (match entry
          [(OptDomEntry.Entry entry-label labels)
            (if (= entry-label label)
              labels
              (opt-dom-table-lookup rest label))]))]))

(define (opt-dom-entry-eq? [a : OptDomEntry] [b : OptDomEntry]) : bool
  (match a
    [(OptDomEntry.Entry a-label a-labels)
      (match b
        [(OptDomEntry.Entry b-label b-labels)
          (and (= a-label b-label) (opt-label-set-eq? a-labels b-labels))])]))

(define (opt-dom-table-eq? [a : OptLegacyDomTable] [b : OptLegacyDomTable]) : bool
  (match a
    [(OptLegacyDomTable.Nil)
      (match b
        [(OptLegacyDomTable.Nil) true]
        [_ false])]
    [(OptLegacyDomTable.Cons a-entry a-rest)
      (match b
        [(OptLegacyDomTable.Cons b-entry b-rest)
          (and
            (opt-dom-entry-eq? a-entry b-entry)
            (opt-dom-table-eq? (__tl-box-place a-rest) (__tl-box-place b-rest)))]
        [_ false])]))

(define (opt-dom-intersect-preds-rest
  [table : OptLegacyDomTable]
  [preds : OptLabelSet]
  [current : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelSet.Nil) current]
    [(OptLabelSet.Dense _ _)
      (opt-dom-intersect-preds-rest
        table
        (opt-label-tail preds)
        (opt-label-intersection
          current
          (opt-dom-table-lookup table (opt-label-ref preds 0))))]))

(define (opt-dom-intersect-preds
  [table : OptLegacyDomTable]
  [preds : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense _ _)
      (opt-dom-intersect-preds-rest
        table
        (opt-label-tail preds)
        (opt-dom-table-lookup table (opt-label-ref preds 0)))]))

(define (opt-cfg-dominators-initial
  [blocks : ir.CompilerIrBlockList]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [all-reachable : OptLabelSet]) : OptLegacyDomTable
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptLegacyDomTable.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (opt-label-contains reachable label)
            (OptLegacyDomTable.Cons
              (OptDomEntry.Entry
                label
                (if (= label entry-label)
                  (opt-label-add (OptLabelSet.Nil) label)
                  all-reachable))
              (box
                (opt-cfg-dominators-initial
                  (__tl-box-place rest)
                  reachable
                  entry-label
                  all-reachable)))
            (opt-cfg-dominators-initial
              (__tl-box-place rest)
              reachable
              entry-label
              all-reachable))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-dominators-initial
        (ir.compiler-ir-block-seq-to-list seq)
        reachable
        entry-label
        all-reachable)]))

;; CFG index: integer block ids are assigned in block-list order and
;; reused for successor/predecessor CSR rows, reachability, RPO, and RPO slot
;; lookup. Existing callers still consume OptLabelSet adapters, but each CFG
;; snapshot is indexed once and rebuilt only after block-list-mutating
;; optimization passes.
(defenum OptI64List
  (Nil)
  (Cons i64 (Box OptI64List)))

;; Label id -> dense CFG index, without a hash map. Block labels are interned
;; ids drawn densely from `compiler-ir-label-count`, so one array indexed by the
;; label id answers the query directly. A per-build generation stamp makes
;; "belongs to this CFG" a compare instead of a clear, so a rebuild costs one
;; counter bump rather than a pass over the table (refs #5718, proposal 3).
;;
;; The table holds exactly one build, so it only serves the build itself --
;; resolving successor labels while the rows are filled. A finished index answers
;; `opt-cfg-index-id` from its own table instead (see `opt-cfg-index-id-map`),
;; because a later build stamps over this one and passes routinely query an
;; index that is no longer the newest.
(define opt-cfg-label-slot : (__tl_dyn-array i64)
  (array.make-array i64 1))
(define opt-cfg-label-stamp : (__tl_dyn-array i64)
  (array.make-array i64 1))
(define opt-cfg-label-generation : i64
  0)

;; The table outlives every optimizer scratch rewind, so it is bound in the IR
;; label arena -- the same dedicated, never-reset arena the label pool uses.
;; Growing it in the ambient arena instead leaves the globals pointing into
;; memory a later rewind frees.
(define (opt-cfg-label-table-reserve! [count : i64]) : unit
  (if (<= count (array-length opt-cfg-label-slot))
    unit
    (let
      [size : i64 (array-length opt-cfg-label-slot)]
      (begin
        (while (< size count)
          (set! size (* size 2)))
        (in-arena
          (arena.Arena (ir.compiler-ir-label-arena))
          (begin
            (set! opt-cfg-label-slot (array.make-array i64 size))
            (set! opt-cfg-label-stamp (array.make-array i64 size))))
        ;; A fresh stamp array reads as generation 0, so restart the counter
        ;; above it rather than leaving stale entries live.
        (set! opt-cfg-label-generation 0)))))

(define (opt-cfg-label-table-begin!) : i64
  (begin
    (opt-cfg-label-table-reserve! (ir.compiler-ir-label-count-value))
    (set! opt-cfg-label-generation (+ opt-cfg-label-generation 1))
    opt-cfg-label-generation))

(define (opt-cfg-label-table-put! [label : i64] [id : i64] [generation : i64]) : unit
  (if (or (< label 0) (>= label (array-length opt-cfg-label-slot)))
    unit
    (begin
      (set! (array-ref opt-cfg-label-slot label) id)
      (set! (array-ref opt-cfg-label-stamp label) generation))))

(define (opt-cfg-label-table-get [label : i64] [generation : i64]) : i64
  (if (or (< label 0) (>= label (array-length opt-cfg-label-stamp)))
    -1
    (if (= (array-ref opt-cfg-label-stamp label) generation)
      (array-ref opt-cfg-label-slot label)
      -1)))

(defstruct OptCfgCsr
  (offsets (__tl_dyn-array i64))
  (edges (__tl_dyn-array i64)))

;; `targets-known` is one of the optimizer verifier's two structural CFG checks.
;; It falls out of the build for free: `opt-cfg-index-label-set-to-ids` drops
;; successor labels it cannot resolve, so an unknown target is a short CSR row.
;; The other check needs no field -- see `opt-cfg-index-labels-unique?`. Together
;; they replace rebuilding a label map and rehashing every label and every
;; successor edge, once per verified function (refs #5718).
(defstruct OptCfgIndex
  (labels-unique bool)
  (labels (__tl_dyn-array i64))
  ;; Open-addressed label -> id table owned by this index, so a lookup stays a
  ;; probe after a later build has taken over the shared stamp table. Slots hold
  ;; `id + 1` (zero is the empty slot ZII leaves behind) and the id identifies
  ;; its own key through `labels`, so one word per slot is enough.
  (id-map (__tl_dyn-array i64))
  ;; Dense block values share CFG id order. Passes that reuse a topology
  ;; context after replacing block values refresh this array once from their
  ;; exact current list before indexed reads.
  (blocks (__tl_dyn-array ir.CompilerIrBlock))
  (succs OptCfgCsr)
  (preds OptCfgCsr)
  (reachable (__tl_dyn-array bool))
  (reach-count i64)
  (rpo (__tl_dyn-array i64))
  (rpo-num (__tl_dyn-array i64))
  (targets-known bool))

(defstruct OptPredMap
  (index OptCfgIndex))

(define (opt-cfg-index-fill-label-seq!
  [blocks : ir.CompilerIrBlockSeq]
  [generation : i64]
  [labels : (__tl_dyn-array i64)]
  [dense-blocks : (__tl_dyn-array ir.CompilerIrBlock)]
  [base : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [unique : bool true]
    (begin
      (while (< index count)
        (let
          [block : ir.CompilerIrBlock
            (ir.compiler-ir-block-seq-ref blocks index)]
          (begin
            (set! (array-ref dense-blocks (+ base index)) block)
            (match block
              [(ir.CompilerIrBlock.Block label _)
                (let
                  [fresh : bool
                    (< (opt-cfg-label-table-get label generation) 0)]
                  (begin
                    (set! (array-ref labels (+ base index)) label)
                    ;; Preserve `find-block`'s first-match behavior for an
                    ;; invalid duplicate-label CFG. Valid CFGs are unique.
                    (if fresh
                      (opt-cfg-label-table-put! label (+ base index) generation)
                      (set! unique false))))])
            (set! index (+ index 1)))))
      unique)))

(define (opt-cfg-index-fill-labels!
  [blocks : ir.CompilerIrBlockList]
  [generation : i64]
  [labels : (__tl_dyn-array i64)]
  [dense-blocks : (__tl_dyn-array ir.CompilerIrBlock)]
  [index : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            [fresh : bool (< (opt-cfg-label-table-get label generation) 0)]
            (begin
              (set! (array-ref dense-blocks index) block)
              (set! (array-ref labels index) label)
              (if fresh
                (opt-cfg-label-table-put! label index generation)
                unit)
              ;; the recursion runs first: `and` short-circuits and the rest of
              ;; the labels still have to be stamped
              (and
                (opt-cfg-index-fill-labels!
                  (__tl-box-place rest)
                  generation
                  labels
                  dense-blocks
                  (+ index 1))
                fresh)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-index-fill-label-seq! seq generation labels dense-blocks index)]))

(define (opt-i64-list-contains? [items : OptI64List] [value : i64]) : bool
  (match items
    [(OptI64List.Nil) false]
    [(OptI64List.Cons head rest)
      (if (= head value)
        true
        (opt-i64-list-contains? (__tl-box-place rest) value))]))

(define (opt-i64-list-add [items : OptI64List] [value : i64]) : OptI64List
  (if (opt-i64-list-contains? items value)
    items
    (OptI64List.Cons value (box items))))

(define (opt-i64-list-reverse-onto [items : OptI64List] [acc : OptI64List]) : OptI64List
  (match items
    [(OptI64List.Nil) acc]
    [(OptI64List.Cons head rest)
      (opt-i64-list-reverse-onto
        (__tl-box-place rest)
        (OptI64List.Cons head (box acc)))]))

(define (opt-i64-list-reverse [items : OptI64List]) : OptI64List
  (opt-i64-list-reverse-onto items (OptI64List.Nil)))

(define (opt-i64-list-count [items : OptI64List]) : i64
  (match items
    [(OptI64List.Nil) 0]
    [(OptI64List.Cons _ rest) (+ 1 (opt-i64-list-count (__tl-box-place rest)))]))

(define (opt-i64-list-fill-edges!
  [items : OptI64List]
  [edges : (__tl_dyn-array i64)]
  [index : i64]) : i64
  (match items
    [(OptI64List.Nil) index]
    [(OptI64List.Cons head rest)
      (begin
        (set! (array-ref edges index) head)
        (opt-i64-list-fill-edges! (__tl-box-place rest) edges (+ index 1)))]))

(define (opt-cfg-row-list-total
  [rows : (__tl_dyn-array OptI64List)]
  [count : i64]
  [index : i64]
  [total : i64]) : i64
  (if (>= index count)
    total
    (opt-cfg-row-list-total
      rows
      count
      (+ index 1)
      (+ total (opt-i64-list-count (array-ref rows index))))))

(define (opt-cfg-index-label-set-to-ids
  [labels : OptLabelSet]
  [generation : i64]) : OptI64List
  (match labels
    [(OptLabelSet.Nil) (OptI64List.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        [tail : OptI64List
          (opt-cfg-index-label-set-to-ids (opt-label-tail labels) generation)]
        [idx : i64 (opt-cfg-label-table-get label generation)]
        (if (< idx 0)
          tail
          (OptI64List.Cons idx (box tail))))]))

;; The successor row for this block already holds every resolved target id, in
;; label-set order, with unresolvable labels dropped -- exactly the sequence the
;; label-walking version produced. Reuse it instead of hashing each successor
;; label a second time: `opt-cfg-index-label-set-to-ids` has already paid one
;; `opt_string_i64_map.get` per edge.
(define (opt-cfg-index-add-pred-edges-from-ids!
  [pred-rows : (__tl_dyn-array OptI64List)]
  [source-id : i64]
  [succ-ids : OptI64List]) : unit
  (match succ-ids
    [(OptI64List.Nil) unit]
    [(OptI64List.Cons idx rest)
      (begin
        (set!
          (array-ref pred-rows idx)
          (opt-i64-list-add (array-ref pred-rows idx) source-id))
        (opt-cfg-index-add-pred-edges-from-ids!
          pred-rows
          source-id
          (__tl-box-place rest)))]))

;; Returns whether every successor label resolved. `opt-cfg-index-label-set-to-ids`
;; drops the ones that miss, so a short row is exactly an unknown target -- the
;; question `opt-cfg-successor-targets-known?` answered by rebuilding the label
;; map and reprobing it.
(define (opt-cfg-index-fill-row-seq!
  [blocks : ir.CompilerIrBlockSeq]
  [generation : i64]
  [succ-rows : (__tl_dyn-array OptI64List)]
  [pred-rows : (__tl_dyn-array OptI64List)]
  [base : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [known : bool true]
    (begin
      (while (< index count)
        (let
          [block : ir.CompilerIrBlock
            (ir.compiler-ir-block-seq-ref blocks index)]
          [next-label : i64
            (if (< (+ index 1) count)
              (match (ir.compiler-ir-block-seq-ref blocks (+ index 1))
                [(ir.CompilerIrBlock.Block label _) label])
              (ir.compiler-ir-label-none))]
          [succs : OptLabelSet
            (opt-cfg-block-successors-with-next block next-label)]
          [row : i64 (+ base index)]
          [succ-ids : OptI64List
            (opt-cfg-index-label-set-to-ids succs generation)]
          (begin
            (set! (array-ref succ-rows row) succ-ids)
            (opt-cfg-index-add-pred-edges-from-ids! pred-rows row succ-ids)
            (unless
              (= (opt-label-count succs) (opt-i64-list-count succ-ids))
              (set! known false))
            (set! index (+ index 1)))))
      known)))

(define (opt-cfg-index-fill-rows!
  [blocks : ir.CompilerIrBlockList]
  [generation : i64]
  [succ-rows : (__tl_dyn-array OptI64List)]
  [pred-rows : (__tl_dyn-array OptI64List)]
  [index : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ _)
          (let
            [succs : OptLabelSet
              (opt-cfg-block-successors-with-next
                block
                (opt-cfg-entry-label (__tl-box-place rest)))]
            [succ-ids : OptI64List
              (opt-cfg-index-label-set-to-ids succs generation)]
            [known : bool
              (= (opt-label-count succs) (opt-i64-list-count succ-ids))]
            (begin
              (set! (array-ref succ-rows index) succ-ids)
              (opt-cfg-index-add-pred-edges-from-ids! pred-rows index succ-ids)
              ;; The recursion comes first: `and` short-circuits, and the rest of
              ;; the rows still have to be filled.
              (and
                (opt-cfg-index-fill-rows!
                  (__tl-box-place rest)
                  generation
                  succ-rows
                  pred-rows
                  (+ index 1))
                known)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-index-fill-row-seq! seq generation succ-rows pred-rows index)]))

(define (opt-cfg-csr-fill-rows!
  [rows : (__tl_dyn-array OptI64List)]
  [count : i64]
  [offsets : (__tl_dyn-array i64)]
  [edges : (__tl_dyn-array i64)]
  [row : i64]
  [edge-index : i64]) : unit
  (if (>= row count)
    (set! (array-ref offsets count) edge-index)
    (let
      [next-edge : i64
        (opt-i64-list-fill-edges!
          (opt-i64-list-reverse (array-ref rows row))
          edges
          edge-index)]
      (begin
        (set! (array-ref offsets row) edge-index)
        (opt-cfg-csr-fill-rows! rows count offsets edges (+ row 1) next-edge)))))

(define (opt-cfg-csr-build [rows : (__tl_dyn-array OptI64List)] [count : i64]) : OptCfgCsr
  (let
    [edge-count : i64 (opt-cfg-row-list-total rows count 0 0)]
    [offsets : (__tl_dyn-array i64) (array.make-array i64 (+ count 1))]
    [edges : (__tl_dyn-array i64) (array.make-array i64 edge-count)]
    (begin
      (opt-cfg-csr-fill-rows! rows count offsets edges 0 0)
      (OptCfgCsr offsets edges))))

;; Only for arrays being *re*-initialised. `make-array` already hands back
;; zeroed memory -- `tl_array_zero` either fills the allocation or skips the
;; fill precisely when the arena is virgin and therefore already zero -- so
;; clearing a freshly allocated array to `false` repeats work the allocator has
;; already done, with a scalar loop instead of `rep stosq`.
(define (opt-cfg-fill-bool!
  [values : (__tl_dyn-array bool)]
  [count : i64]
  [value : bool]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref values i) value)
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-fill-i64!
  [values : (__tl_dyn-array i64)]
  [count : i64]
  [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref values i) value)
          (set! i (+ i 1))))
      unit)))

(define (opt-cfg-index-dfs-edges!
  [succs : OptCfgCsr]
  [reachable : (__tl_dyn-array bool)]
  [postorder : (__tl_dyn-array i64)]
  [edge : i64]
  [end : i64]
  [post-count : i64]) : i64
  (if (>= edge end)
    post-count
    (opt-cfg-index-dfs-edges!
      succs
      reachable
      postorder
      (+ edge 1)
      end
      (opt-cfg-index-dfs-postorder!
        succs
        reachable
        postorder
        (array-ref succs.edges edge)
        post-count))))

(define (opt-cfg-index-dfs-postorder!
  [succs : OptCfgCsr]
  [reachable : (__tl_dyn-array bool)]
  [postorder : (__tl_dyn-array i64)]
  [id : i64]
  [post-count : i64]) : i64
  (if (array-ref reachable id)
    post-count
    (let
      [edge : i64 (array-ref succs.offsets id)]
      [end : i64 (array-ref succs.offsets (+ id 1))]
      [next-count : i64
        (begin
          (set! (array-ref reachable id) true)
          (opt-cfg-index-dfs-edges!
            succs
            reachable
            postorder
            edge
            end
            post-count))]
      (begin
        (set! (array-ref postorder next-count) id)
        (+ next-count 1)))))

(define (opt-cfg-index-fill-rpo!
  [postorder : (__tl_dyn-array i64)]
  [rpo : (__tl_dyn-array i64)]
  [reach-count : i64]
  [index : i64]) : unit
  (if (>= index reach-count)
    unit
    (begin
      (set!
        (array-ref rpo index)
        (array-ref postorder (- (- reach-count 1) index)))
      (opt-cfg-index-fill-rpo! postorder rpo reach-count (+ index 1)))))

(define (opt-cfg-index-fill-rpo-num!
  [rpo : (__tl_dyn-array i64)]
  [rpo-num : (__tl_dyn-array i64)]
  [reach-count : i64]
  [slot : i64]) : unit
  (if (>= slot reach-count)
    unit
    (begin
      (set! (array-ref rpo-num (array-ref rpo slot)) slot)
      (opt-cfg-index-fill-rpo-num! rpo rpo-num reach-count (+ slot 1)))))

;; Power-of-two capacity with room for at least one empty slot at every size, so
;; a probe that misses always terminates on a zero word.
(define (opt-cfg-index-id-map-capacity [count : i64]) : i64
  (let
    [size : i64 2]
    (begin
      (while (< size (* count 2))
        (set! size (* size 2)))
      size)))

;; Labels inside one function are near-contiguous, so masking alone already
;; spreads them; folding the high bits down first keeps a pruned, strided label
;; set from collapsing onto one slot.
(define (opt-cfg-index-id-slot [label : i64] [mask : i64]) : i64
  (bit-and (bit-xor label (shr label 5)) mask))

;; Ids are inserted in block order and an occupied slot whose label matches is
;; left alone, so a duplicate-label CFG resolves to its first block -- the same
;; answer the legacy list scan gave before the verifier rejects it.
(define (opt-cfg-index-fill-id-map!
  [slots : (__tl_dyn-array i64)]
  [labels : (__tl_dyn-array i64)]
  [count : i64]) : unit
  (let
    [mask : i64 (- (array-length slots) 1)]
    [id : i64 0]
    (while (< id count)
      (let
        [label : i64 (array-ref labels id)]
        [slot : i64 (opt-cfg-index-id-slot label mask)]
        [placed : bool false]
        (begin
          (while (not placed)
            (let
              [entry : i64 (array-ref slots slot)]
              (if (= entry 0)
                (begin
                  (set! (array-ref slots slot) (+ id 1))
                  (set! placed true))
                (if (= (array-ref labels (- entry 1)) label)
                  (set! placed true)
                  (set! slot (bit-and (+ slot 1) mask))))))
          (set! id (+ id 1)))))))

(define (opt-cfg-index-build [blocks : ir.CompilerIrBlockList]) : OptCfgIndex
  (let
    [count : i64 (ir.compiler-ir-block-list-count blocks)]
    [labels : (__tl_dyn-array i64) (array.make-array i64 count)]
    [dense-blocks : (__tl_dyn-array ir.CompilerIrBlock)
      (array.make-array ir.CompilerIrBlock count)]
    [generation : i64 (opt-cfg-label-table-begin!)]
    [labels-unique : bool
      (opt-cfg-index-fill-labels! blocks generation labels dense-blocks 0)]
    [id-map : (__tl_dyn-array i64)
      (array.make-array i64 (opt-cfg-index-id-map-capacity count))]
    [succ-rows : (__tl_dyn-array OptI64List)
      (array.make-array OptI64List count)]
    [pred-rows : (__tl_dyn-array OptI64List)
      (array.make-array OptI64List count)]
    [reachable : (__tl_dyn-array bool) (array.make-array bool count)]
    [postorder : (__tl_dyn-array i64) (array.make-array i64 count)]
    [rpo : (__tl_dyn-array i64) (array.make-array i64 count)]
    [rpo-num : (__tl_dyn-array i64) (array.make-array i64 count)]
    [reach-count : i64 0]
    [targets-known : bool true]
    (begin
      (opt-cfg-index-fill-id-map! id-map labels count)
      (set!
        targets-known
        (opt-cfg-index-fill-rows! blocks generation succ-rows pred-rows 0))
      (opt-cfg-fill-i64! postorder count (- 0 1))
      (opt-cfg-fill-i64! rpo count (- 0 1))
      (opt-cfg-fill-i64! rpo-num count (- 0 1))
      (let
        [succ-csr : OptCfgCsr (opt-cfg-csr-build succ-rows count)]
        [pred-csr : OptCfgCsr (opt-cfg-csr-build pred-rows count)]
        (begin
          (if (> count 0)
            (set!
              reach-count
              (opt-cfg-index-dfs-postorder! succ-csr reachable postorder 0 0))
            unit)
          (opt-cfg-index-fill-rpo! postorder rpo reach-count 0)
          (opt-cfg-index-fill-rpo-num! rpo rpo-num reach-count 0)
          (OptCfgIndex
            labels-unique
            labels
            id-map
            dense-blocks
            succ-csr
            pred-csr
            reachable
            reach-count
            rpo
            rpo-num
            targets-known))))))

(define (opt-cfg-index-block-count [index : OptCfgIndex]) : i64
  (array-length index.labels))

;; `opt-cfg-index-fill-labels!` records whether every label inserted exactly
;; once. The reverse table keeps the first entry for duplicate labels so indexed
;; lookup agrees with the legacy list scan even before the verifier rejects the
;; malformed CFG.
(define (opt-cfg-index-labels-unique? [index : OptCfgIndex]) : bool
  index.labels-unique)

(define (opt-cfg-index-label [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (array-ref index.labels id)
    (ir.compiler-ir-label-none)))

;; Probing this index's own table answers the query whether or not a later build
;; has stamped over the shared one, so a stale index costs the same as the newest
;; one. An unknown label lands on an empty slot, which the capacity rule
;; guarantees exists.
(define (opt-cfg-index-id [index : OptCfgIndex] [label : i64]) : option_i64.Option
  (let
    [slots : (__tl_dyn-array i64) index.id-map]
    [labels : (__tl_dyn-array i64) index.labels]
    [mask : i64 (- (array-length slots) 1)]
    [slot : i64 (opt-cfg-index-id-slot label mask)]
    (begin
      (while true
        (let
          [entry : i64 (array-ref slots slot)]
          (if (= entry 0)
            (return (option_i64.None))
            (let
              [id : i64 (- entry 1)]
              (if (= (array-ref labels id) label)
                (return (option_i64.Some id))
                (set! slot (bit-and (+ slot 1) mask)))))))
      (option_i64.None))))

(define (opt-cfg-index-refresh-block-seq!
  [out : (__tl_dyn-array ir.CompilerIrBlock)]
  [blocks : ir.CompilerIrBlockSeq]
  [base : i64]) : i64
  (let
    [slot : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    (begin
      (while (< slot count)
        (begin
          (set!
            (array-ref out (+ base slot))
            (ir.compiler-ir-block-seq-ref blocks slot))
          (set! slot (+ slot 1))))
      (+ base count))))

(define (opt-cfg-index-refresh-blocks-from!
  [out : (__tl_dyn-array ir.CompilerIrBlock)]
  [blocks : ir.CompilerIrBlockList]
  [index : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) index]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (set! (array-ref out index) block)
        (opt-cfg-index-refresh-blocks-from!
          out
          (__tl-box-place rest)
          (+ index 1)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-index-refresh-block-seq! out seq index)]))

(define (opt-cfg-index-refresh-blocks!
  [index : OptCfgIndex]
  [blocks : ir.CompilerIrBlockList]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    (if (= count (ir.compiler-ir-block-list-count blocks))
      (begin
        (opt-cfg-index-refresh-blocks-from! index.blocks blocks 0)
        unit)
      unit)))

(define (opt-cfg-index-block [index : OptCfgIndex] [id : i64]) : OptMaybeBlock
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (OptMaybeBlock.Some (array-ref index.blocks id))
    (OptMaybeBlock.No)))

(define (opt-cfg-index-find-block [index : OptCfgIndex] [label : i64]) : OptMaybeBlock
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (opt-cfg-index-block index id)]
    [(option_i64.None) (OptMaybeBlock.No)]))

(define (opt-cfg-index-row-labels-from
  [index : OptCfgIndex]
  [csr : OptCfgCsr]
  [edge : i64]
  [end : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= edge end)
    labels
    (opt-cfg-index-row-labels-from
      index
      csr
      (+ edge 1)
      end
      (opt-label-add
        labels
        (opt-cfg-index-label index (array-ref csr.edges edge))))))

(define (opt-cfg-index-row-labels
  [index : OptCfgIndex]
  [csr : OptCfgCsr]
  [id : i64]) : OptLabelSet
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (opt-cfg-index-row-labels-from
      index
      csr
      (array-ref csr.offsets id)
      (array-ref csr.offsets (+ id 1))
      (OptLabelSet.Nil))
    (OptLabelSet.Nil)))

(define (opt-cfg-index-successors [index : OptCfgIndex] [label : i64]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (opt-cfg-index-row-labels index index.succs id)]
    [(option_i64.None) (OptLabelSet.Nil)]))

(define (opt-cfg-index-predecessors [index : OptCfgIndex] [label : i64]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (opt-cfg-index-row-labels index index.preds id)]
    [(option_i64.None) (OptLabelSet.Nil)]))

(define (opt-cfg-index-reachable? [index : OptCfgIndex] [label : i64]) : bool
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (array-ref index.reachable id)]
    [(option_i64.None) false]))

(define (opt-cfg-csr-row-contains-id?
  [csr : OptCfgCsr]
  [row : i64]
  [wanted : i64]) : bool
  (let
    [edge : i64 (array-ref csr.offsets row)]
    [end : i64 (array-ref csr.offsets (+ row 1))]
    [edges : (__tl_dyn-array i64) csr.edges]
    (begin
      (while (< edge end)
        (if (= (array-ref edges edge) wanted)
          (return true)
          (set! edge (+ edge 1))))
      false)))

(define (opt-cfg-index-reachable-predecessor?
  [index : OptCfgIndex]
  [block-id : i64]
  [predecessor-label : i64]) : bool
  (match (opt-cfg-index-id index predecessor-label)
    [(option_i64.Some predecessor-id)
      (and
        (array-ref index.reachable predecessor-id)
        (opt-cfg-csr-row-contains-id? index.preds block-id predecessor-id))]
    [(option_i64.None) false]))

;; One entry per reachable block, deduped through a hash set rather than
;; `opt-label-add`'s linear `string.eq` scan. `opt-label-add` prepends only on
;; first occurrence, and this applies the same rule, so the list -- including
;; its descending-id order -- is unchanged even when two blocks somehow share a
;; label. That case is a verifier error rather than something this function may
;; assume away, which is why the dedup is kept instead of dropped.
(define (opt-cfg-index-reachable-labels-from-seen
  [index : OptCfgIndex]
  [id : i64]
  [labels : OptLabelSet]
  [seen : opt_string_i64_map.Map (:consume)]) : OptLabelSet
  (if (>= id (opt-cfg-index-block-count index))
    labels
    (opt-cfg-index-reachable-labels-from-seen
      index
      (+ id 1)
      (if (array-ref index.reachable id)
        (let
          [label : i64 (opt-cfg-index-label index id)]
          (if (opt_string_i64_map.contains? (& seen) label)
            labels
            (begin
              (opt_string_i64_map.insert-ref! (&mut seen) label 1)
              (opt-label-cons label labels))))
        labels)
      seen)))

;; The linear original, kept for small functions. `opt-label-add` prepends only
;; on first occurrence, which is exactly what the hashed variant above does, so
;; the two build the identical list and the choice between them is invisible.
(define (opt-cfg-index-reachable-labels-from-linear
  [index : OptCfgIndex]
  [id : i64]
  [labels : OptLabelSet]) : OptLabelSet
  (if (>= id (opt-cfg-index-block-count index))
    labels
    (opt-cfg-index-reachable-labels-from-linear
      index
      (+ id 1)
      (if (array-ref index.reachable id)
        (opt-label-add labels (opt-cfg-index-label index id))
        labels))))

;; Which dedup to use is a size question. The map is not reclaimed, so building
;; one per CFG index build costs real peak memory in the optimizer, while the
;; linear scan it replaces only becomes expensive once a function has many
;; blocks. Below the threshold the scan is cheaper than the allocation; above
;; it, the O(blocks^2) comparisons dominate and the map pays for itself.
(define (opt-cfg-index-reachable-hash-threshold) : i64
  32)

(define (opt-cfg-index-reachable-labels [index : OptCfgIndex]) : OptLabelSet
  (if (<
    (opt-cfg-index-block-count index)
    (opt-cfg-index-reachable-hash-threshold))
    (opt-cfg-index-reachable-labels-from-linear index 0 (OptLabelSet.Nil))
    (opt-cfg-index-reachable-labels-from-seen
      index
      0
      (OptLabelSet.Nil)
      (opt_string_i64_map.with-capacity (opt-cfg-index-block-count index)))))

(define (opt-cfg-index-rpo-id [index : OptCfgIndex] [slot : i64]) : i64
  (if (and (>= slot 0) (< slot index.reach-count))
    (array-ref index.rpo slot)
    (- 0 1)))

(define (opt-cfg-index-rpo-num [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (array-ref index.rpo-num id)
    (- 0 1)))

(define (opt-cfg-index-rpo-label [index : OptCfgIndex] [slot : i64]) : i64
  (opt-cfg-index-label index (opt-cfg-index-rpo-id index slot)))

(define (opt-pred-map-lookup [map : OptPredMap] [label : i64]) : OptLabelSet
  (opt-cfg-index-predecessors map.index label))

(define (opt-pred-map-successors [map : OptPredMap] [label : i64]) : OptLabelSet
  (opt-cfg-index-successors map.index label))

(define (opt-cfg-dominators-step-entry
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [old : OptLegacyDomTable]
  [entry : OptDomEntry]) : OptDomEntry
  (match entry
    [(OptDomEntry.Entry label _)
      (if (= label entry-label)
        (OptDomEntry.Entry label (opt-label-add (OptLabelSet.Nil) label))
        (let
          [preds : OptLabelSet
            (opt-label-intersection
              (opt-pred-map-lookup pred-map label)
              reachable)]
          (OptDomEntry.Entry
            label
            (opt-label-add (opt-dom-intersect-preds old preds) label))))]))

(define (opt-cfg-dominators-step
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [old : OptLegacyDomTable]
  [remaining : OptLegacyDomTable]) : OptLegacyDomTable
  (match remaining
    [(OptLegacyDomTable.Nil) (OptLegacyDomTable.Nil)]
    [(OptLegacyDomTable.Cons entry rest)
      (OptLegacyDomTable.Cons
        (opt-cfg-dominators-step-entry pred-map reachable entry-label old entry)
        (box
          (opt-cfg-dominators-step
            pred-map
            reachable
            entry-label
            old
            (__tl-box-place rest))))]))

(define (opt-cfg-dominators-fixed
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]
  [table : OptLegacyDomTable]
  [remaining : i64]) : OptLegacyDomTable
  (if (<= remaining 0)
    table
    (let
      [next : OptLegacyDomTable
        (opt-cfg-dominators-step pred-map reachable entry-label table table)]
      (if (opt-dom-table-eq? table next)
        next
        (opt-cfg-dominators-fixed
          pred-map
          reachable
          entry-label
          next
          (- remaining 1))))))

(define (opt-cfg-dominators-legacy-with
  [blocks : ir.CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [entry-label : i64]) : OptLegacyDomTable
  (let
    [initial : OptLegacyDomTable
      (opt-cfg-dominators-initial blocks reachable entry-label reachable)]
    (opt-cfg-dominators-fixed
      pred-map
      reachable
      entry-label
      initial
      (+ (ir.compiler-ir-block-list-count blocks) 1))))

(define (opt-bits-words [bits : i64]) : i64
  (/ (+ bits 62) 63))

(define (opt-bits-set! [row : (__tl_dyn-array i64)] [base : i64] [bit : i64]) : unit
  (let
    [w : i64 (+ base (/ bit 63))]
    (set! (array-ref row w) (bit-or (array-ref row w) (shl 1 (% bit 63))))))

(define (opt-bits-test [row : (__tl_dyn-array i64)] [base : i64] [bit : i64]) : bool
  (not (= (bit-and (array-ref row (+ base (/ bit 63))) (shl 1 (% bit 63))) 0)))

(define (opt-bits-clear!
  [row : (__tl_dyn-array i64)]
  [base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (set! (array-ref row (+ base w)) 0)
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-and-into!
  [dst : (__tl_dyn-array i64)]
  [dst-base : i64]
  [src : (__tl_dyn-array i64)]
  [src-base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (set!
            (array-ref dst (+ dst-base w))
            (bit-and
              (array-ref dst (+ dst-base w))
              (array-ref src (+ src-base w))))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-copy!
  [dst : (__tl_dyn-array i64)]
  [dst-base : i64]
  [src : (__tl_dyn-array i64)]
  [src-base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (set! (array-ref dst (+ dst-base w)) (array-ref src (+ src-base w)))
          (set! w (+ w 1))))
      unit)))

(define (opt-bits-eq?
  [a : (__tl_dyn-array i64)]
  [a-base : i64]
  [b : (__tl_dyn-array i64)]
  [b-base : i64]
  [words : i64]) : bool
  (let
    [w : i64 0]
    [same : bool true]
    (begin
      (while (and same (< w words))
        (begin
          (if (= (array-ref a (+ a-base w)) (array-ref b (+ b-base w)))
            unit
            (set! same false))
          (set! w (+ w 1))))
      same)))

(defstruct OptDomInfo
  (index OptCfgIndex)
  (words i64)
  (rows (__tl_dyn-array i64))
  (idom (__tl_dyn-array i64))
  (tin (__tl_dyn-array i64))
  (tout (__tl_dyn-array i64)))

(define (opt-dom-row-base [words : i64] [id : i64]) : i64
  (* id words))

(define (opt-dom-fill-reachable-universe!
  [index : OptCfgIndex]
  [row : (__tl_dyn-array i64)]
  [base : i64]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [id : i64 0]
    (begin
      (while (< id count)
        (begin
          (if (array-ref index.reachable id)
            (opt-bits-set! row base id)
            unit)
          (set! id (+ id 1))))
      unit)))

(define (opt-dom-init-row!
  [index : OptCfgIndex]
  [rows : (__tl_dyn-array i64)]
  [words : i64]
  [entry-id : i64]
  [id : i64]) : unit
  (let
    [base : i64 (opt-dom-row-base words id)]
    (begin
      (opt-bits-clear! rows base words)
      (if (array-ref index.reachable id)
        (if (= id entry-id)
          (opt-bits-set! rows base id)
          (opt-dom-fill-reachable-universe! index rows base))
        unit))))

(define (opt-dom-init-rows!
  [index : OptCfgIndex]
  [rows : (__tl_dyn-array i64)]
  [words : i64]
  [entry-id : i64]) : unit
  (let
    [id : i64 0]
    [count : i64 (opt-cfg-index-block-count index)]
    (begin
      (while (< id count)
        (begin
          (opt-dom-init-row! index rows words entry-id id)
          (set! id (+ id 1))))
      unit)))

(define (opt-dom-row-from-preds!
  [index : OptCfgIndex]
  [rows : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [words : i64]
  [id : i64]) : unit
  (let
    [preds : OptCfgCsr index.preds]
    [edge : i64 (array-ref preds.offsets id)]
    [end : i64 (array-ref preds.offsets (+ id 1))]
    [saw : bool false]
    (begin
      (opt-bits-clear! scratch 0 words)
      (opt-dom-fill-reachable-universe! index scratch 0)
      (while (< edge end)
        (let
          [pred : i64 (array-ref preds.edges edge)]
          (begin
            (if (array-ref index.reachable pred)
              (begin
                (opt-bits-and-into!
                  scratch
                  0
                  rows
                  (opt-dom-row-base words pred)
                  words)
                (set! saw true))
              unit)
            (set! edge (+ edge 1)))))
      (if saw
        unit
        (opt-bits-clear! scratch 0 words))
      (opt-bits-set! scratch 0 id))))

(define (opt-dom-update-row!
  [index : OptCfgIndex]
  [rows : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [words : i64]
  [entry-id : i64]
  [id : i64]) : bool
  (if (or (= id entry-id) (not (array-ref index.reachable id)))
    false
    (let
      [base : i64 (opt-dom-row-base words id)]
      (begin
        (opt-dom-row-from-preds! index rows scratch words id)
        (if (opt-bits-eq? rows base scratch 0 words)
          false
          (begin
            (opt-bits-copy! rows base scratch 0 words)
            true))))))

(define (opt-dom-iterate-rpo!
  [index : OptCfgIndex]
  [rows : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [words : i64]
  [entry-id : i64]) : bool
  (let
    [slot : i64 0]
    [changed : bool false]
    (begin
      (while (< slot index.reach-count)
        (begin
          (if (opt-dom-update-row!
            index
            rows
            scratch
            words
            entry-id
            (opt-cfg-index-rpo-id index slot))
            (set! changed true)
            unit)
          (set! slot (+ slot 1))))
      changed)))

(define (opt-dom-fixpoint!
  [index : OptCfgIndex]
  [rows : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [words : i64]
  [entry-id : i64]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (if (opt-dom-iterate-rpo! index rows scratch words entry-id)
      (opt-dom-fixpoint! index rows scratch words entry-id (- remaining 1))
      unit)))

(define (opt-cfg-dominators-bitset-with
  [index : OptCfgIndex]
  [entry-label : i64]) : OptDomInfo
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [words : i64 (opt-bits-words count)]
    [rows : (__tl_dyn-array i64) (array.make-array i64 (* count words))]
    [scratch : (__tl_dyn-array i64) (array.make-array i64 words)]
    [empty : (__tl_dyn-array i64) (array.make-array i64 0)]
    [entry-id : i64 (- 0 1)]
    (begin
      (match (opt-cfg-index-id index entry-label)
        [(option_i64.Some id) (set! entry-id id)]
        [(option_i64.None) unit])
      (opt-dom-init-rows! index rows words entry-id)
      (if (>= entry-id 0)
        (opt-dom-fixpoint! index rows scratch words entry-id (+ count 1))
        unit)
      (OptDomInfo index words rows empty empty empty))))

(define (opt-dom-intersect-idom
  [index : OptCfgIndex]
  [idom : (__tl_dyn-array i64)]
  [left : i64]
  [right : i64]) : i64
  (let
    [a : i64 left]
    [b : i64 right]
    (begin
      (while (!= a b)
        (begin
          (while (>
            (opt-cfg-index-rpo-num index a)
            (opt-cfg-index-rpo-num index b))
            (set! a (array-ref idom a)))
          (while (>
            (opt-cfg-index-rpo-num index b)
            (opt-cfg-index-rpo-num index a))
            (set! b (array-ref idom b)))))
      a)))

(define (opt-dom-idom-from-preds
  [index : OptCfgIndex]
  [idom : (__tl_dyn-array i64)]
  [id : i64]) : i64
  (let
    [preds : OptCfgCsr index.preds]
    [edge : i64 (array-ref preds.offsets id)]
    [end : i64 (array-ref preds.offsets (+ id 1))]
    [candidate : i64 (- 0 1)]
    (begin
      (while (< edge end)
        (let
          [pred : i64 (array-ref preds.edges edge)]
          (begin
            (if (and
              (array-ref index.reachable pred)
              (>= (array-ref idom pred) 0))
              (if (< candidate 0)
                (set! candidate pred)
                (set!
                  candidate
                  (opt-dom-intersect-idom index idom pred candidate)))
              unit)
            (set! edge (+ edge 1)))))
      candidate)))

(define (opt-dom-idom-iterate-rpo!
  [index : OptCfgIndex]
  [idom : (__tl_dyn-array i64)]
  [entry-id : i64]) : bool
  (let
    [slot : i64 1]
    [changed : bool false]
    (begin
      (while (< slot index.reach-count)
        (let
          [id : i64 (opt-cfg-index-rpo-id index slot)]
          [new-idom : i64 (opt-dom-idom-from-preds index idom id)]
          (begin
            (if (and
              (!= id entry-id)
              (>= new-idom 0)
              (!= (array-ref idom id) new-idom))
              (begin
                (set! (array-ref idom id) new-idom)
                (set! changed true))
              unit)
            (set! slot (+ slot 1)))))
      changed)))

(define (opt-dom-idom-fixpoint!
  [index : OptCfgIndex]
  [idom : (__tl_dyn-array i64)]
  [entry-id : i64]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (if (opt-dom-idom-iterate-rpo! index idom entry-id)
      (opt-dom-idom-fixpoint! index idom entry-id (- remaining 1))
      unit)))

(define (opt-dom-child-rows-fill!
  [index : OptCfgIndex]
  [idom : (__tl_dyn-array i64)]
  [rows : (__tl_dyn-array OptI64List)]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [id : i64 0]
    (begin
      (while (< id count)
        (let
          [parent : i64 (array-ref idom id)]
          (begin
            (if (and
              (array-ref index.reachable id)
              (>= parent 0)
              (!= parent id))
              (set!
                (array-ref rows parent)
                (opt-i64-list-add (array-ref rows parent) id))
              unit)
            (set! id (+ id 1)))))
      unit)))

(define (opt-dom-euler-dfs!
  [children : OptCfgCsr]
  [tin : (__tl_dyn-array i64)]
  [tout : (__tl_dyn-array i64)]
  [id : i64]
  [time : i64]) : i64
  (let
    [next : i64 (+ time 1)]
    [edge : i64 (array-ref children.offsets id)]
    [end : i64 (array-ref children.offsets (+ id 1))]
    (begin
      (set! (array-ref tin id) time)
      (while (< edge end)
        (begin
          (set!
            next
            (opt-dom-euler-dfs!
              children
              tin
              tout
              (array-ref children.edges edge)
              next))
          (set! edge (+ edge 1))))
      (set! (array-ref tout id) next)
      next)))

(define (opt-dom-build-euler!
  [index : OptCfgIndex]
  [idom : (__tl_dyn-array i64)]
  [tin : (__tl_dyn-array i64)]
  [tout : (__tl_dyn-array i64)]
  [entry-id : i64]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [child-rows : (__tl_dyn-array OptI64List)
      (array.make-array OptI64List count)]
    (begin
      (opt-cfg-fill-i64! tin count (- 0 1))
      (opt-cfg-fill-i64! tout count (- 0 1))
      (if (>= entry-id 0)
        (begin
          (opt-dom-child-rows-fill! index idom child-rows)
          (let
            [children : OptCfgCsr (opt-cfg-csr-build child-rows count)]
            (begin
              (opt-dom-euler-dfs! children tin tout entry-id 0)
              unit)))
        unit))))

(define (opt-cfg-dominators-with [index : OptCfgIndex] [entry-label : i64]) : OptDomInfo
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [idom : (__tl_dyn-array i64) (array.make-array i64 count)]
    [tin : (__tl_dyn-array i64) (array.make-array i64 count)]
    [tout : (__tl_dyn-array i64) (array.make-array i64 count)]
    [empty : (__tl_dyn-array i64) (array.make-array i64 0)]
    [entry-id : i64 (- 0 1)]
    (begin
      (opt-cfg-fill-i64! idom count (- 0 1))
      (match (opt-cfg-index-id index entry-label)
        [(option_i64.Some id) (set! entry-id id)]
        [(option_i64.None) unit])
      (if (and (>= entry-id 0) (array-ref index.reachable entry-id))
        (begin
          (set! (array-ref idom entry-id) entry-id)
          (opt-dom-idom-fixpoint! index idom entry-id (+ count 1))
          (opt-dom-build-euler! index idom tin tout entry-id))
        (begin
          (opt-cfg-fill-i64! tin count (- 0 1))
          (opt-cfg-fill-i64! tout count (- 0 1))))
      (OptDomInfo index 0 empty idom tin tout))))

;; Dominance is interval containment on the Euler tour numbering `opt-cfg-
;; dominators-with` builds once per dom info: `dominator-id` dominates
;; `label-id` exactly when its [tin, tout] interval encloses the label's.
;;
;; The `reachable` array is deliberately NOT consulted. `opt-dom-build-euler!`
;; pre-fills tin/tout with -1, and its DFS reaches only the entry plus ids that
;; `opt-dom-child-rows-fill!` linked into the dom tree -- and that fill admits
;; an id only when `reachable[id]` is set. So `tin[id] >= 0` already implies
;; `reachable[id]`, and the `(>= dom-tin 0)` guard below subsumes both
;; reachability tests exactly rather than merely approximating them.
;;
;; Ids are range-checked against the tin array itself rather than the CFG block
;; count: on the Euler path the two are equal by construction (both arrays are
;; allocated at `opt-cfg-index-block-count`), and a dom info produced by the
;; test-only bitset builder carries empty tin/tout, which this bound answers
;; "does not dominate" instead of indexing off the end.
;;
;; `label-tin >= 0` is implied by `dom-tin >= 0` and `dom-tin <= label-tin`, so
;; only the dominator's tin needs its own sign test, and the tout pair is read
;; only once the tin comparisons have already held.
(define (opt-dom-info-dominates-id?
  [info : OptDomInfo]
  [dominator-id : i64]
  [label-id : i64]) : bool
  (let
    [tin : (__tl_dyn-array i64) info.tin]
    [count : i64 (array-length tin)]
    (if (and
      (>= dominator-id 0)
      (< dominator-id count)
      (>= label-id 0)
      (< label-id count))
      ;; A block dominates itself exactly when the dom tree numbered it, which
      ;; is what the general test below reduces to when both ids are equal.
      (if (= dominator-id label-id)
        (>= (array-ref tin dominator-id) 0)
        (let
          [dom-tin : i64 (array-ref tin dominator-id)]
          (and
            (>= dom-tin 0)
            (<= dom-tin (array-ref tin label-id))
            (<=
              (array-ref info.tout label-id)
              (array-ref info.tout dominator-id)))))
      false)))

(define (opt-dom-bitset-info-dominates-id?
  [info : OptDomInfo]
  [dominator-id : i64]
  [label-id : i64]) : bool
  (let
    [index : OptCfgIndex info.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and
      (>= dominator-id 0)
      (< dominator-id count)
      (>= label-id 0)
      (< label-id count))
      (if (and
        (array-ref index.reachable dominator-id)
        (array-ref index.reachable label-id))
        (opt-bits-test
          info.rows
          (opt-dom-row-base info.words label-id)
          dominator-id)
        false)
      false)))

(define (opt-dom-info-row-matches-legacy?
  [info : OptDomInfo]
  [legacy-labels : OptLabelSet]
  [label-id : i64]
  [dominator-id : i64]) : bool
  (let
    [index : OptCfgIndex info.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= dominator-id count)
      true
      (let
        [label : i64 (opt-cfg-index-label index dominator-id)]
        [legacy-has : bool (opt-label-contains legacy-labels label)]
        [info-has : bool
          (opt-dom-info-dominates-id? info dominator-id label-id)]
        (if (or (and legacy-has info-has) (and (not legacy-has) (not info-has)))
          (opt-dom-info-row-matches-legacy?
            info
            legacy-labels
            label-id
            (+ dominator-id 1))
          false)))))

(define (opt-dom-info-matches-legacy-from?
  [info : OptDomInfo]
  [legacy : OptLegacyDomTable]
  [id : i64]) : bool
  (let
    [index : OptCfgIndex info.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= id count)
      true
      (if (array-ref index.reachable id)
        (let
          [label : i64 (opt-cfg-index-label index id)]
          [legacy-labels : OptLabelSet (opt-dom-table-lookup legacy label)]
          (if (opt-dom-info-row-matches-legacy? info legacy-labels id 0)
            (opt-dom-info-matches-legacy-from? info legacy (+ id 1))
            false))
        (opt-dom-info-matches-legacy-from? info legacy (+ id 1))))))

(define (opt-dom-info-matches-legacy?
  [info : OptDomInfo]
  [legacy : OptLegacyDomTable]) : bool
  (opt-dom-info-matches-legacy-from? info legacy 0))

(define (opt-dom-info-row-matches-bitset?
  [info : OptDomInfo]
  [bitset : OptDomInfo]
  [label-id : i64]
  [dominator-id : i64]) : bool
  (let
    [index : OptCfgIndex info.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= dominator-id count)
      true
      (let
        [info-has : bool
          (opt-dom-info-dominates-id? info dominator-id label-id)]
        [bitset-has : bool
          (opt-dom-bitset-info-dominates-id? bitset dominator-id label-id)]
        (if (or (and info-has bitset-has) (and (not info-has) (not bitset-has)))
          (opt-dom-info-row-matches-bitset?
            info
            bitset
            label-id
            (+ dominator-id 1))
          false)))))

(define (opt-dom-info-matches-bitset-from?
  [info : OptDomInfo]
  [bitset : OptDomInfo]
  [id : i64]) : bool
  (let
    [index : OptCfgIndex info.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= id count)
      true
      (if (opt-dom-info-row-matches-bitset? info bitset id 0)
        (opt-dom-info-matches-bitset-from? info bitset (+ id 1))
        false))))

(define (opt-dom-info-matches-bitset? [info : OptDomInfo] [bitset : OptDomInfo]) : bool
  (opt-dom-info-matches-bitset-from? info bitset 0))

(defstruct OptCfgContext
  (index OptCfgIndex)
  (pred-map OptPredMap)
  (reachable OptLabelSet)
  (entry-label i64)
  (doms OptDomInfo))

(define (opt-cfg-context-build [blocks : ir.CompilerIrBlockList]) : OptCfgContext
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    [pred-map : OptPredMap (OptPredMap index)]
    [reachable : OptLabelSet (opt-cfg-index-reachable-labels index)]
    [entry-label : i64 (opt-cfg-entry-label blocks)]
    [doms : OptDomInfo (opt-cfg-dominators-with index entry-label)]
    (OptCfgContext index pred-map reachable entry-label doms)))

;; A cheap placeholder context built from an empty CFG. Used only as the
;; sentinel paired with a function on the non-heavy pass path, where the threaded
;; context is never consumed (all heavy passes are skipped together).
(define (opt-cfg-context-empty) : OptCfgContext
  (opt-cfg-context-build (ir.CompilerIrBlockList.Nil)))

;; Carries an optimized function together with an OptCfgContext that is
;; valid for the returned function's *current* blocks, so the next pass in
;; optimize-function-once can reuse it for entry verification and dominance
;; queries instead of rebuilding from scratch. The context is only paired with
;; the exact block list it was built from; passes that rewrite the CFG build a
;; fresh context for their output before handing it back.
(defenum OptFunctionCtxResult
  (Result ir.CompilerIrFunction OptCfgContext))

(defenum OptBlockCtxResult
  (Result ir.CompilerIrBlockList OptCfgContext bool))

;; Uniform changed-result carriers. Function-level passes all return
;; OptFunctionPassResult; lower-level helpers use the carrier matching their
;; payload. An unchanged result must carry the exact input value so callers can
;; preserve identity without rebuilding enclosing IR.
(defenum OptFunctionPassResult
  (Result ir.CompilerIrFunction bool))

(defenum OptBlockListPassResult
  (Result ir.CompilerIrBlockList bool))

(defenum OptBlockPassResult
  (Result ir.CompilerIrBlock bool))

(define (opt-cfg-context-all-blocks-reachable? [context : OptCfgContext]) : bool
  (let
    [index : OptCfgIndex context.index]
    (= index.reach-count (opt-cfg-index-block-count index))))

(define (opt-cfg-dominators [blocks : ir.CompilerIrBlockList]) : OptDomInfo
  (__tl-project-field (opt-cfg-context-build blocks) doms))

(define (opt-cfg-dominators-match-legacy? [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-dom-info-matches-legacy?
      context.doms
      (opt-cfg-dominators-legacy-with
        blocks
        context.pred-map
        context.reachable
        context.entry-label))))

(define (opt-cfg-dominators-match-bitset? [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-dom-info-matches-bitset?
      context.doms
      (opt-cfg-dominators-bitset-with context.index context.entry-label))))

(define (opt-dom-dominates?
  [table : OptDomInfo]
  [dominator : i64]
  [label : i64]) : bool
  (match (opt-cfg-index-id table.index dominator)
    [(option_i64.Some dominator-id)
      (match (opt-cfg-index-id table.index label)
        [(option_i64.Some label-id)
          (opt-dom-info-dominates-id? table dominator-id label-id)]
        [(option_i64.None) false])]
    [(option_i64.None) false]))

(define (opt-cfg-frontier-has-reachable-pred-id?
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [edge : i64]
  [end : i64]) : bool
  (if (>= edge end)
    false
    (let
      [pred-id : i64 (array-ref index.preds.edges edge)]
      (if (and
        (array-ref index.reachable pred-id)
        (opt-dom-info-dominates-id? doms label-id pred-id))
        true
        (opt-cfg-frontier-has-reachable-pred-id?
          index
          doms
          label-id
          (+ edge 1)
          end)))))

(define (opt-cfg-dominance-frontier-block?
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [block-id : i64]) : bool
  (let
    [preds : OptCfgCsr index.preds]
    (and
      (array-ref index.reachable block-id)
      (opt-cfg-frontier-has-reachable-pred-id?
        index
        doms
        label-id
        (array-ref preds.offsets block-id)
        (array-ref preds.offsets (+ block-id 1)))
      (not
        (and
          (!= label-id block-id)
          (opt-dom-info-dominates-id? doms label-id block-id))))))

;; `remaining` starts as the block list `index` was built from, so the walk
;; position is the block id.
(define (opt-cfg-dominance-frontier-blocks
  [remaining : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [label-id : i64]
  [block-id : i64]) : OptLabelSet
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (OptLabelSet.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label _)
          (let
            [tail : OptLabelSet
              (opt-cfg-dominance-frontier-blocks
                (__tl-box-place rest)
                index
                doms
                label-id
                (+ block-id 1))]
            (if (and
              (< block-id (opt-cfg-index-block-count index))
              (opt-cfg-dominance-frontier-block? index doms label-id block-id))
              (opt-label-add tail block-label)
              tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-dominance-frontier-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        index
        doms
        label-id
        block-id)]))

(define (opt-cfg-dominance-frontier-with-context
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [label : i64]) : OptLabelSet
  (let
    [index : OptCfgIndex context.index]
    [label-id : i64
      (match (opt-cfg-index-id index label)
        [(option_i64.Some id) id]
        [(option_i64.None) (- 0 1)])]
    (opt-cfg-dominance-frontier-blocks blocks index context.doms label-id 0)))

(define (opt-cfg-dominance-frontier
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : OptLabelSet
  (opt-cfg-dominance-frontier-with-context
    blocks
    (opt-cfg-context-build blocks)
    label))

(defenum ResultCompilerOptimizeVerify
  (Ok)
  (Err String))

(define (opt-verify-ok? [result : ResultCompilerOptimizeVerify]) : bool
  (match result
    [(ResultCompilerOptimizeVerify.Ok) true]
    [(ResultCompilerOptimizeVerify.Err _) false]))

(define (opt-verify-error-ok?
  [result : ResultCompilerOptimizeVerify]
  [want : String]) : bool
  (match result
    [(ResultCompilerOptimizeVerify.Err message) (string.eq message want)]
    [(ResultCompilerOptimizeVerify.Ok) false]))

;; The block is the CFG index's dense block id, not its label. Definitions are
;; collected by walking the same block list the paired `OptCfgContext` was built
;; from, and `opt-cfg-index-build` numbers blocks in that walk order, so the
;; position is the id. Recovering it by hashing the label was the single largest
;; `opt-cfg-index-id` caller (refs #5718).
(defenum OptVarDef
  (Def i64 i64 i64))

(defenum OptMaybeVarDef
  (No)
  (Some OptVarDef))

;; Function virtual-register ids are dense in [0, vars). Verification only
;; needs duplicate membership, so a bitmap avoids hashing every definition and
;; rejects malformed out-of-range ids at the same boundary.
(define (opt-var-set-add-unique! [set : (__tl_dyn-array bool)] [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length set)))
    false
    (if (array-ref set var)
      false
      (begin
        (set! (array-ref set var) true)
        true))))

;; Instruction-tag dispatch order matters here: a `match` over a payload enum
;; lowers to a linear tag compare chain, so an arm's position is its cost, and
;; anything routed to the trailing catch-all pays the whole chain. This is one
;; of the two hottest primitives in an opt2 self-compile (~70M calls), and the
;; declaration-ordered arm list made the average query walk 11.3 comparisons
;; because the terminators and memory writers -- Branch/Return/Jump/StorePtr,
;; which are non-defining and so hit the catch-all -- are among the most
;; frequent shapes in real IR.
;;
;; The arms below are ordered by measured dynamic frequency (4.2 comparisons
;; average on the same compile), and every hot non-defining shape gets an
;; explicit `None` arm near the front instead of falling through ~35
;; comparisons to reach the same answer. Variant patterns
;; over one enum are disjoint, so reordering them cannot change which arm
;; matches; the explicit `None` arms return exactly what the catch-all returned
;; for those tags. Rare vector/mask/SPMD forms and the two value-returning
;; indirect-call definition arms stay at the back. The shapes left in the
;; catch-all (aggregate C-ABI store-result calls, vector and predicated stores,
;; TailCallIndirect) keep answering `None` exactly as before.
(define (opt-instr-def-var [instr : ir.CompilerIrInstr]) : option_i64.Option
  (match instr
    [(ir.CompilerIrInstr.Alloc dst _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Gep dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Mov dst _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Call dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Load dst _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Branch _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.StorePtr _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.Return _) (option_i64.None)]
    [(ir.CompilerIrInstr.AddrOf dst _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Jump _) (option_i64.None)]
    [(ir.CompilerIrInstr.Phi dst _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.Cast dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.TailCall _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) (option_i64.Some dst)]
    ;; Pack/Word define their dst like any scalar op. Without these arms
    ;; the verifier saw every use of a register-group word as use-before-def
    ;; and silently knocked aggregate-using functions out of SSA/GVN/LICM.
    [(ir.CompilerIrInstr.Word dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Pack dst _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Store _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.Switch _ _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) (option_i64.None)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.LaneId dst _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) (option_i64.None)]
          [(ir.CompilerIrSpmdCallResult.Value dst _ _) (option_i64.Some dst)]))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (option_i64.Some dst))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.EntryArgc dst) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.EntryArgv dst) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.EntryEnvp dst) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Xgetbv dst _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.Syscall dst _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _) (option_i64.Some dst)]
    [_ (option_i64.None)]))

(define (opt-instr-def-position [instr : ir.CompilerIrInstr] [pos : i64]) : i64
  (match instr
    [(ir.CompilerIrInstr.Phi _ _ _) 0]
    [_ pos]))

(define (opt-verify-param-def-set
  [params : ir.CompilerIrParamList]
  [set : (__tl_dyn-array bool)]) : bool
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) true]
    [(ir.CompilerIrParamList.Array seq)
      (opt-verify-param-def-set (ir.compiler-ir-param-seq-to-list seq) set)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (and
            (opt-var-set-add-unique! set var)
            (opt-verify-param-def-set (__tl-box-place rest) set))])]))

(define (opt-verify-instr-def-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [set : (__tl_dyn-array bool)]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some var)
        (and
          (opt-var-set-add-unique! set var)
          (opt-verify-instr-def-seq-from instrs (+ index 1) set))]
      [(option_i64.None) (opt-verify-instr-def-seq-from instrs (+ index 1) set)])))

(define (opt-verify-block-def-set
  [blocks : ir.CompilerIrBlockList]
  [set : (__tl_dyn-array bool)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-verify-instr-def-seq-from instrs 0 set)
            (opt-verify-block-def-set (__tl-box-place rest) set))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-verify-block-def-set (ir.compiler-ir-block-seq-to-list seq) set)]))

(define (opt-verify-single-defs?
  [params : ir.CompilerIrParamList]
  [vars : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (if (< vars 0)
    false
    (let
      [set : (__tl_dyn-array bool) (array.make-array bool vars)]
      (and
        (opt-verify-param-def-set params set)
        (opt-verify-block-def-set blocks set)))))

(define (opt-var-defs-index-add!
  [items : (__tl_dyn-array OptMaybeVarDef)]
  [var : i64]
  [block-id : i64]
  [pos : i64]) : unit
  (if (and (>= var 0) (< var (array-length items)))
    (set!
      (array-ref items var)
      (OptMaybeVarDef.Some (OptVarDef.Def var block-id pos)))
    unit))

(define (opt-var-defs-index-params!
  [params : ir.CompilerIrParamList]
  [items : (__tl_dyn-array OptMaybeVarDef)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (opt-var-defs-index-params! (ir.compiler-ir-param-seq-to-list seq) items)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (begin
            (opt-var-defs-index-add! items var 0 0)
            (opt-var-defs-index-params! (__tl-box-place rest) items))])]))

(define (opt-var-defs-index-instr-seq-from!
  [instrs : ir.CompilerIrInstrSeq]
  [block-id : i64]
  [index : i64]
  [pos : i64]
  [items : (__tl_dyn-array OptMaybeVarDef)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (begin
        (match (opt-instr-def-var instr)
          [(option_i64.Some var)
            (opt-var-defs-index-add!
              items
              var
              block-id
              (opt-instr-def-position instr pos))]
          [(option_i64.None) unit])
        (opt-var-defs-index-instr-seq-from!
          instrs
          block-id
          (+ index 1)
          (+ pos 1)
          items)))))

(define (opt-var-defs-index-blocks!
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]
  [items : (__tl_dyn-array OptMaybeVarDef)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-var-defs-index-instr-seq-from! instrs block-id 0 1 items)
            (opt-var-defs-index-blocks!
              (__tl-box-place rest)
              (+ block-id 1)
              items))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-var-defs-index-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        block-id
        items)]))

;; The preceding single-definition check proves every destination is in
;; `[0, vars)`. Fill the exact-size lookup directly instead of building and
;; rescanning an intermediate definition sequence. Parameters belong to dense
;; block id 0, matching `opt-cfg-index-build`.
(define (opt-var-defs-index
  [params : ir.CompilerIrParamList]
  [vars : i64]
  [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array OptMaybeVarDef)
  (let
    [items : (__tl_dyn-array OptMaybeVarDef)
      (array.make-array OptMaybeVarDef vars)]
    (begin
      (opt-var-defs-index-params! params items)
      (opt-var-defs-index-blocks! blocks 0 items)
      items)))

;; Fused single-definition check + var->def index.
;;
;; The two facts the SSA verifier needs -- "every virtual register is defined
;; at most once" and "where each one is defined" -- are the same walk over the
;; same instructions. Deriving them separately walked every instruction twice
;; per verify and allocated a throwaway membership bitmap alongside the index
;; that already records membership: a filled slot IS a duplicate definition,
;; and an out-of-range destination is the same rejection the bitmap made at its
;; bounds check. One walk therefore produces both facts, and the index doubles
;; as the membership set. `Duplicate` carries no index because the verifier
;; rejects the function before any use query runs.
(defenum OptVarDefsIndex
  (Duplicate)
  (Index (__tl_dyn-array OptMaybeVarDef)))

(define (opt-var-defs-checked-add!
  [items : (__tl_dyn-array OptMaybeVarDef)]
  [var : i64]
  [block-id : i64]
  [pos : i64]) : bool
  (if (or (< var 0) (>= var (array-length items)))
    false
    (match (array-ref items var)
      [(OptMaybeVarDef.Some _) false]
      [(OptMaybeVarDef.No)
        (begin
          (set!
            (array-ref items var)
            (OptMaybeVarDef.Some (OptVarDef.Def var block-id pos)))
          true)])))

(define (opt-var-defs-checked-params!
  [params : ir.CompilerIrParamList]
  [items : (__tl_dyn-array OptMaybeVarDef)]) : bool
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) true]
    [(ir.CompilerIrParamList.Array seq)
      (opt-var-defs-checked-params!
        (ir.compiler-ir-param-seq-to-list seq)
        items)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (and
            (opt-var-defs-checked-add! items var 0 0)
            (opt-var-defs-checked-params! (__tl-box-place rest) items))])]))

(define (opt-var-defs-checked-instr-seq-from!
  [instrs : ir.CompilerIrInstrSeq]
  [block-id : i64]
  [index : i64]
  [pos : i64]
  [items : (__tl_dyn-array OptMaybeVarDef)]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some var)
          (and
            (opt-var-defs-checked-add!
              items
              var
              block-id
              (opt-instr-def-position instr pos))
            (opt-var-defs-checked-instr-seq-from!
              instrs
              block-id
              (+ index 1)
              (+ pos 1)
              items))]
        [(option_i64.None)
          (opt-var-defs-checked-instr-seq-from!
            instrs
            block-id
            (+ index 1)
            (+ pos 1)
            items)]))))

(define (opt-var-defs-checked-blocks!
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]
  [items : (__tl_dyn-array OptMaybeVarDef)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-var-defs-checked-instr-seq-from! instrs block-id 0 1 items)
            (opt-var-defs-checked-blocks!
              (__tl-box-place rest)
              (+ block-id 1)
              items))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-var-defs-checked-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        block-id
        items)]))

(define (opt-var-defs-index-checked
  [params : ir.CompilerIrParamList]
  [vars : i64]
  [blocks : ir.CompilerIrBlockList]) : OptVarDefsIndex
  (if (< vars 0)
    (OptVarDefsIndex.Duplicate)
    (let
      [items : (__tl_dyn-array OptMaybeVarDef)
        (array.make-array OptMaybeVarDef vars)]
      (if (and
        (opt-var-defs-checked-params! params items)
        (opt-var-defs-checked-blocks! blocks 0 items))
        (OptVarDefsIndex.Index items)
        (OptVarDefsIndex.Duplicate)))))

(define (opt-var-def-lookup
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [var : i64]) : OptMaybeVarDef
  (if (and (>= var 0) (< var (array-length defs)))
    (array-ref defs var)
    (OptMaybeVarDef.No)))

;; Block labels are unique -- every entry point into this family checks that
;; first -- so id equality decides label equality without a `string.eq`.
(define (opt-verify-var-use
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [var : i64]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match (opt-var-def-lookup defs var)
    [(OptMaybeVarDef.No)
      (ResultCompilerOptimizeVerify.Err
        "optimizer verify: use before definition")]
    [(OptMaybeVarDef.Some def)
      (match def
        [(OptVarDef.Def _ def-block def-pos)
          (if (not (opt-dom-info-dominates-id? doms def-block use-block))
            (ResultCompilerOptimizeVerify.Err
              "optimizer verify: use is not dominated by definition")
            (if (and (= def-block use-block) (>= def-pos use-pos))
              (ResultCompilerOptimizeVerify.Err
                "optimizer verify: use before definition")
              (ResultCompilerOptimizeVerify.Ok)))])]))

(define (opt-verify-var-use-on-edge
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [var : i64]
  [pred-label : i64]) : ResultCompilerOptimizeVerify
  (match (opt-var-def-lookup defs var)
    [(OptMaybeVarDef.No)
      (ResultCompilerOptimizeVerify.Err
        "optimizer verify: use before definition")]
    [(OptMaybeVarDef.Some def)
      (match def
        [(OptVarDef.Def _ def-block _)
          (if (opt-dom-info-dominates-id?
            doms
            def-block
            (match (opt-cfg-index-id doms.index pred-label)
              [(option_i64.Some pred-id) pred-id]
              [(option_i64.None) (- 0 1)]))
            (ResultCompilerOptimizeVerify.Ok)
            (ResultCompilerOptimizeVerify.Err
              "optimizer verify: use is not dominated by definition"))])]))

(define (opt-verify-value-use
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [value : ir.CompilerIrValue]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match value
    [(ir.CompilerIrValue.Var var)
      (opt-verify-var-use defs doms var use-block use-pos)]
    [(ir.CompilerIrValue.RuntimeGlobal _)
      (ResultCompilerOptimizeVerify.Err
        "optimizer verify: runtime-global marker used as an instruction value")]
    [_ (ResultCompilerOptimizeVerify.Ok)]))

(define (opt-verify-value-list-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [values : ir.CompilerIrValueList]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match values
    [(ir.CompilerIrValueList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrValueList.Array seq)
      (opt-verify-value-list-uses
        defs
        doms
        (ir.compiler-ir-value-seq-to-list seq)
        use-block
        use-pos)]
    [(ir.CompilerIrValueList.Cons value rest)
      (match (opt-verify-value-use defs doms value use-block use-pos)
        [(ResultCompilerOptimizeVerify.Ok)
          (opt-verify-value-list-uses
            defs
            doms
            (__tl-box-place rest)
            use-block
            use-pos)]
        [(ResultCompilerOptimizeVerify.Err message)
          (ResultCompilerOptimizeVerify.Err message)])]))

(define (opt-verify-call-args-array-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [use-block : i64]
  [use-pos : i64]
  [index : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (array-length values))
    (ResultCompilerOptimizeVerify.Ok)
    (match (opt-verify-value-use
      defs
      doms
      (array-ref values index)
      use-block
      use-pos)
      [(ResultCompilerOptimizeVerify.Ok)
        (opt-verify-call-args-array-uses
          defs
          doms
          values
          use-block
          use-pos
          (+ index 1))]
      [(ResultCompilerOptimizeVerify.Err message)
        (ResultCompilerOptimizeVerify.Err message)])))

(define (opt-verify-call-args-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [args : ir.CompilerIrCallArgs]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrCallArgs.One value)
      (opt-verify-value-use defs doms value use-block use-pos)]
    [(ir.CompilerIrCallArgs.Two a b)
      (opt-verify-two
        (opt-verify-value-use defs doms a use-block use-pos)
        (opt-verify-value-use defs doms b use-block use-pos))]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-verify-call-args-array-uses defs doms values use-block use-pos 0)]))

(define (opt-verify-spmd-call-args-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [args : ir.CompilerIrSpmdCallArgList]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (opt-verify-two
            (opt-verify-value-use defs doms value use-block use-pos)
            (opt-verify-spmd-call-args-uses
              defs
              doms
              (__tl-box-place rest)
              use-block
              use-pos))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [result : ResultCompilerOptimizeVerify
          (ResultCompilerOptimizeVerify.Ok)]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (< i count)
            (match result
              [(ResultCompilerOptimizeVerify.Err _) (set! i count)]
              [(ResultCompilerOptimizeVerify.Ok)
                (begin
                  (match (array-ref slots i)
                    [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                      (set!
                        result
                        (opt-verify-value-use defs doms value use-block use-pos))])
                  (set! i (+ i 1)))]))
          result))]))

(define (opt-verify-maybe-value-use
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [value : ir.CompilerIrMaybeValue]
  [use-block : i64]
  [use-pos : i64]) : ResultCompilerOptimizeVerify
  (match value
    [(ir.CompilerIrMaybeValue.No) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrMaybeValue.Some inner)
      (opt-verify-value-use defs doms inner use-block use-pos)]))

(define (opt-verify-phi-input-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [inputs : ir.CompilerIrPhiInputList]) : ResultCompilerOptimizeVerify
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-verify-phi-input-uses
        defs
        doms
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value pred-label rest)
      (match value
        [(ir.CompilerIrValue.Var var)
          (match (opt-verify-var-use-on-edge defs doms var pred-label)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-phi-input-uses defs doms (__tl-box-place rest))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])]
        [_ (opt-verify-phi-input-uses defs doms (__tl-box-place rest))])]))

(define (opt-verify-two
  [a : ResultCompilerOptimizeVerify]
  [b : ResultCompilerOptimizeVerify]) : ResultCompilerOptimizeVerify
  (match a
    [(ResultCompilerOptimizeVerify.Ok) b]
    [(ResultCompilerOptimizeVerify.Err message)
      (ResultCompilerOptimizeVerify.Err message)]))

(define (opt-verify-instr-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instr : ir.CompilerIrInstr]) : ResultCompilerOptimizeVerify
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.AddrOf _ src)
      (opt-verify-var-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (opt-verify-two
        (opt-verify-value-use defs doms base block-id pos)
        (opt-verify-value-use defs doms offset block-id pos))]
    [(ir.CompilerIrInstr.Load _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (opt-verify-two
        (opt-verify-value-use defs doms ptr block-id pos)
        (opt-verify-value-use defs doms value block-id pos))]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (opt-verify-two
        (opt-verify-value-use defs doms dst block-id pos)
        (opt-verify-value-use defs doms src block-id pos))]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (opt-verify-two
        (opt-verify-value-use defs doms index block-id pos)
        (opt-verify-value-use defs doms length block-id pos))]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (opt-verify-two
        (opt-verify-value-use defs doms lhs block-id pos)
        (opt-verify-value-use defs doms rhs block-id pos))]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.Splat _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-verify-two
          (opt-verify-value-use defs doms lhs block-id pos)
          (opt-verify-value-use defs doms rhs block-id pos)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (opt-verify-two
          (opt-verify-value-use defs doms src block-id pos)
          (opt-verify-value-use defs doms carry block-id pos)))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-verify-two
          (opt-verify-value-use defs doms lhs block-id pos)
          (opt-verify-value-use defs doms rhs block-id pos)))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-verify-two
        (opt-verify-value-use defs doms lhs block-id pos)
        (opt-verify-value-use defs doms rhs block-id pos))]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (opt-verify-two
          (opt-verify-value-use defs doms mask block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms on-true block-id pos)
            (opt-verify-value-use defs doms on-false block-id pos))))]
    [(ir.CompilerIrInstr.VectorLoad _ base index _ _)
      (opt-verify-two
        (opt-verify-value-use defs doms base block-id pos)
        (opt-verify-value-use defs doms index block-id pos))]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (opt-verify-two
          (opt-verify-value-use defs doms base block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms index block-id pos)
            (opt-verify-value-use defs doms value block-id pos))))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-verify-two
          (opt-verify-value-use defs doms base block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms index block-id pos)
            (opt-verify-two
              (opt-verify-value-use defs doms value block-id pos)
              (opt-verify-value-use defs doms mask block-id pos)))))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-verify-two
          (opt-verify-value-use defs doms base block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms index block-id pos)
            (opt-verify-value-use defs doms mask block-id pos))))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (opt-verify-two
          (opt-verify-value-use defs doms base block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms index-base block-id pos)
            (opt-verify-value-use defs doms index block-id pos))))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (opt-verify-two
          (opt-verify-value-use defs doms source block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms selector-low block-id pos)
            (opt-verify-two
              (opt-verify-maybe-value-use defs doms selector-high block-id pos)
              (opt-verify-value-use defs doms active-lanes block-id pos)))))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (opt-verify-two
        (opt-verify-value-use defs doms index block-id pos)
        (opt-verify-value-use defs doms length block-id pos))]
    [(ir.CompilerIrInstr.EntryArgc _) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrInstr.EntryArgv _) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrInstr.EntryEnvp _) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-verify-two
        (opt-verify-value-use defs doms leaf block-id pos)
        (opt-verify-value-use defs doms subleaf block-id pos))]
    [(ir.CompilerIrInstr.Xgetbv _ index)
      (opt-verify-value-use defs doms index block-id pos)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (opt-verify-call-args-uses defs doms args block-id pos)]
    [(ir.CompilerIrInstr.Call _ _ args _)
      (opt-verify-call-args-uses defs doms args block-id pos)]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-id pos)
        (opt-verify-call-args-uses defs doms args block-id pos))]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-id pos)
        (opt-verify-call-args-uses defs doms args block-id pos))]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-verify-two
          (opt-verify-value-use defs doms base block-id pos)
          (opt-verify-call-args-uses defs doms args block-id pos)))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-verify-two
          (opt-verify-value-use defs doms base block-id pos)
          (opt-verify-two
            (opt-verify-value-use defs doms func block-id pos)
            (opt-verify-call-args-uses defs doms args block-id pos))))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-verify-two
          (opt-verify-value-use defs doms active-mask block-id pos)
          (opt-verify-spmd-call-args-uses defs doms args block-id pos)))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (opt-verify-call-args-uses defs doms args block-id pos)]
    [(ir.CompilerIrInstr.Store _ value _)
      (opt-verify-value-use defs doms value block-id pos)]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-verify-value-use defs doms cond block-id pos)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-verify-value-use defs doms cond block-id pos)]
    [(ir.CompilerIrInstr.Return maybe)
      (opt-verify-maybe-value-use defs doms maybe block-id pos)]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-verify-phi-input-uses defs doms inputs)]
    [(ir.CompilerIrInstr.Alloc _ _) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrInstr.LaneId _ _ _) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrInstr.Jump _) (ResultCompilerOptimizeVerify.Ok)]
    ;; Verify register-group operands dominate their use.
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-verify-value-list-uses defs doms words block-id pos)]
    [(ir.CompilerIrInstr.Word _ src _ _)
      (opt-verify-value-use defs doms src block-id pos)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (opt-verify-two
        (opt-verify-value-use defs doms func block-id pos)
        (opt-verify-call-args-uses defs doms args block-id pos))]
    [(ir.CompilerIrInstr.Switch index _ _ _)
      (opt-verify-value-use defs doms index block-id pos)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (opt-verify-value-use defs doms index block-id pos)]))

(define (opt-verify-instr-seq-uses-from
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [pos : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ResultCompilerOptimizeVerify.Ok)
    (match (opt-verify-instr-uses
      defs
      doms
      block-id
      pos
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(ResultCompilerOptimizeVerify.Ok)
        (opt-verify-instr-seq-uses-from
          defs
          doms
          block-id
          instrs
          (+ index 1)
          (+ pos 1))]
      [(ResultCompilerOptimizeVerify.Err message)
        (ResultCompilerOptimizeVerify.Err message)])))

(define (opt-phi-input-labels [inputs : ir.CompilerIrPhiInputList]) : OptLabelSet
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (OptLabelSet.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-phi-input-labels (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons _ label rest)
      (opt-label-add (opt-phi-input-labels (__tl-box-place rest)) label)]))

(define (opt-phi-input-labels-unique-from?
  [inputs : ir.CompilerIrPhiInputList]
  [seen : OptLabelSet]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-phi-input-labels-unique-from?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        seen)]
    [(ir.CompilerIrPhiInputList.Cons _ label rest)
      (if (opt-label-contains seen label)
        false
        (opt-phi-input-labels-unique-from?
          (__tl-box-place rest)
          (opt-label-add seen label)))]))

(define (opt-phi-input-labels-match?
  [inputs : ir.CompilerIrPhiInputList]
  [preds : OptLabelSet]) : bool
  (and
    (opt-phi-input-labels-unique-from? inputs (OptLabelSet.Nil))
    (opt-label-set-eq? (opt-phi-input-labels inputs) preds)))

(define (opt-verify-phi-predecessors-instr-seq-from
  [pred-map : OptPredMap]
  [block-label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ResultCompilerOptimizeVerify.Ok)
    (match (& (array-ref instrs.slots index))
      [(ir.CompilerIrInstr.Phi _ _ _)
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Phi _ inputs _)
            (if (opt-phi-input-labels-match?
              inputs
              (opt-pred-map-lookup pred-map block-label))
              (opt-verify-phi-predecessors-instr-seq-from
                pred-map
                block-label
                instrs
                (+ index 1))
              (ResultCompilerOptimizeVerify.Err
                "optimizer verify: phi predecessor mismatch"))]
          [_
            (opt-verify-phi-predecessors-instr-seq-from
              pred-map
              block-label
              instrs
              (+ index 1))])]
      [_
        (opt-verify-phi-predecessors-instr-seq-from
          pred-map
          block-label
          instrs
          (+ index 1))])))

(define (opt-verify-phi-predecessors-blocks
  [pred-map : OptPredMap]
  [remaining : ir.CompilerIrBlockList]) : ResultCompilerOptimizeVerify
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (match (opt-verify-phi-predecessors-instr-seq-from
            pred-map
            label
            instrs
            0)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-phi-predecessors-blocks
                pred-map
                (__tl-box-place rest))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-verify-phi-predecessors-blocks
        pred-map
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-verify-block-uses
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ResultCompilerOptimizeVerify
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-verify-instr-seq-uses-from defs doms block-id instrs 0 1)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-block-uses
                defs
                doms
                (__tl-box-place rest)
                (+ block-id 1))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-verify-block-uses
        defs
        doms
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-verify-instr-seq-uses-contextual
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [pos : i64]) : ResultCompilerOptimizeVerify
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ResultCompilerOptimizeVerify.Ok)
    (match (opt-verify-instr-uses
      defs
      doms
      block-id
      pos
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(ResultCompilerOptimizeVerify.Ok)
        (opt-verify-instr-seq-uses-contextual
          defs
          doms
          block-id
          instrs
          (+ index 1)
          (+ pos 1))]
      [(ResultCompilerOptimizeVerify.Err message)
        (ResultCompilerOptimizeVerify.Err
          (str_cat.str-cat
            "block "
            (ir.compiler-ir-label-text
              (opt-cfg-index-label doms.index block-id))
            " instruction "
            (string.int->string index)
            ": "
            message))])))

(define (opt-verify-block-uses-contextual
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [doms : OptDomInfo]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ResultCompilerOptimizeVerify
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-verify-instr-seq-uses-contextual
            defs
            doms
            block-id
            instrs
            0
            1)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-block-uses-contextual
                defs
                doms
                (__tl-box-place rest)
                (+ block-id 1))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err message)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-verify-block-uses-contextual
        defs
        doms
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-verify-function-body-with-context
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match func
    [(ir.CompilerIrFunction.Function _ params _ vars blocks)
      (match (opt-var-defs-index-checked params vars blocks)
        [(OptVarDefsIndex.Duplicate)
          (ResultCompilerOptimizeVerify.Err
            "optimizer verify: duplicate var definition")]
        [(OptVarDefsIndex.Index defs)
          (let
            [doms : OptDomInfo context.doms]
            [pred-map : OptPredMap context.pred-map]
            (match (opt-verify-phi-predecessors-blocks pred-map blocks)
              [(ResultCompilerOptimizeVerify.Ok)
                (opt-verify-block-uses defs doms blocks 0)]
              [(ResultCompilerOptimizeVerify.Err message)
                (ResultCompilerOptimizeVerify.Err message)]))])]))

;; The caller derived the index (and with it the single-definition proof) for
;; exactly this function; final IR that fails that proof is not checked here at
;; all, so this entry point takes the facts rather than re-deriving them.
(define (opt-verify-final-function-body-with-defs
  [defs : (__tl_dyn-array OptMaybeVarDef)]
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [doms : OptDomInfo context.doms]
        [pred-map : OptPredMap context.pred-map]
        (match (opt-verify-phi-predecessors-blocks pred-map blocks)
          [(ResultCompilerOptimizeVerify.Ok)
            (opt-verify-block-uses-contextual defs doms blocks 0)]
          [(ResultCompilerOptimizeVerify.Err message)
            (ResultCompilerOptimizeVerify.Err message)]))]))

;; The structural CFG contract, read off the context's index rather than
;; recomputed. `context` must be valid for the function's blocks, which is the
;; standing pairing invariant for every `*-with-context` entry point.
(define (opt-verify-structure [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (let
    [index : OptCfgIndex context.index]
    (cond
      [(not (opt-cfg-index-labels-unique? index))
        (ResultCompilerOptimizeVerify.Err
          "optimizer verify: duplicate block label")]
      [(not index.targets-known)
        (ResultCompilerOptimizeVerify.Err
          "optimizer verify: unknown successor label")]
      [else (ResultCompilerOptimizeVerify.Ok)])))

(define (opt-verify-function-with-context
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (match (opt-verify-structure context)
    [(ResultCompilerOptimizeVerify.Ok)
      (opt-verify-function-body-with-context func context)]
    [(ResultCompilerOptimizeVerify.Err message)
      (ResultCompilerOptimizeVerify.Err message)]))

;; Pipeline-level verification consolidation: the opt2 pipeline verifies the
;; SSA function once per iteration before the loop-pass cluster and threads
;; the result through `verified?`. Passes in the cluster then skip their own
;; entry verify -- each pass in the cluster preserves IR validity for valid
;; input, and every mutating pass still post-verifies its own rewrite when it
;; changed something, so the per-pass entry verify only repeated the upstream
;; result. Callers outside the pipeline (tests, standalone drivers) pass
;; `false` and keep the defensive entry verify.
(define (opt-verify-gate
  [verified? : bool]
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (if verified?
    (ResultCompilerOptimizeVerify.Ok)
    (opt-verify-function-with-context func context)))

(define (opt-verify-function [func : ir.CompilerIrFunction]) : ResultCompilerOptimizeVerify
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-verify-function-with-context func (opt-cfg-context-build blocks))]))

(define (opt-verify-final-function [func : ir.CompilerIrFunction]) : ResultCompilerOptimizeVerify
  (match func
    [(ir.CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [context : OptCfgContext (opt-cfg-context-build blocks)]
        (match (opt-verify-structure context)
          [(ResultCompilerOptimizeVerify.Ok)
            ;; Final backend IR is not required to be SSA. Apply dominance/use
            ;; checks when it is SSA-shaped; otherwise the structural CFG checks
            ;; are the valid final-IR contract. The SSA-shape decision and the
            ;; index the dominance checks read are one derivation.
            (match (opt-var-defs-index-checked params vars blocks)
              [(OptVarDefsIndex.Index defs)
                (opt-verify-final-function-body-with-defs defs func context)]
              [(OptVarDefsIndex.Duplicate) (ResultCompilerOptimizeVerify.Ok)])]
          [(ResultCompilerOptimizeVerify.Err message)
            (ResultCompilerOptimizeVerify.Err message)]))]))

(define (opt-verify-function-list [functions : ir.CompilerIrFunctionList]) : ResultCompilerOptimizeVerify
  (match (ir.compiler-ir-function-list-force-cons functions)
    [(ir.CompilerIrFunctionList.Nil) (ResultCompilerOptimizeVerify.Ok)]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-verify-function-list (ir.compiler-ir-function-seq-to-list seq))]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (match func
        [(ir.CompilerIrFunction.Function name _ _ _ _)
          (match (opt-verify-final-function func)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-verify-function-list (__tl-box-place rest))]
            [(ResultCompilerOptimizeVerify.Err message)
              (ResultCompilerOptimizeVerify.Err
                (str_cat.str-cat
                  "function @"
                  (ir.compiler-ir-symbol-text name)
                  ": "
                  message))])])]))

(define (opt-verify-program [program : ir.CompilerIrProgram]) : ResultCompilerOptimizeVerify
  (match program
    [(ir.CompilerIrProgram.Program _ functions _)
      (opt-verify-function-list functions)]))

(define (compiler-opt-debug-finish-program [program : ir.CompilerIrProgram]) : ir.CompilerIrProgram
  (begin
    (if compiler-opt-debug-verify-ir
      (match (opt-verify-program program)
        [(ResultCompilerOptimizeVerify.Ok)
          (set! compiler-opt-debug-verify-error "")]
        [(ResultCompilerOptimizeVerify.Err message)
          (set! compiler-opt-debug-verify-error message)])
      unit)
    program))

;; --- standalone scalar SSA construction / mem2reg --------------------------
;;
;; This constructor rewrites repeated scalar virtual-register definitions into
;; single-assignment form and inserts phis at dominance frontiers. It is
;; deliberately verifier-gated: unsupported shapes leave the function unchanged.
;; This first slice handles functions without pre-existing phi nodes, which keeps
;; edge-sensitive phi-input rewriting separate from the lowering-time phis.
(defenum OptMaybeAstType
  (No)
  (Some ast.AstType))

(defstruct OptSsaVarTypeEntry
  (present bool)
  (ty ast.AstType))

(import (vector.vector OptSsaVarTypeEntry core) as opt_ssa_var_type_vec)

;; Dense SSA var -> AstType table. Function-local vreg ids are dense, so the
;; table is a direct-index vector; lookup is O(1) by construction instead of a
;; linear chain walk. The insertion-order sidecar preserves the retired
;; chain's newest-first walk order exactly (#5731).
(defstruct OptSsaVarTypes
  (entries opt_ssa_var_type_vec.Vec)
  (order opt_dense_i64_vec.Vec))

(define (opt-ssa-var-types-new) : OptSsaVarTypes
  (OptSsaVarTypes (opt_ssa_var_type_vec.new) (opt_dense_i64_vec.new)))

(define (opt-ssa-var-types-lookup [types : OptSsaVarTypes] [var : i64]) : OptMaybeAstType
  (let
    [entries : opt_ssa_var_type_vec.Vec types.entries]
    (if (or (< var 0) (>= var (opt_ssa_var_type_vec.len (& entries))))
      (OptMaybeAstType.No)
      (let
        [entry : OptSsaVarTypeEntry
          (array-ref (opt_ssa_var_type_vec.slots (& entries)) var)]
        (if entry.present
          (OptMaybeAstType.Some entry.ty)
          (OptMaybeAstType.No))))))

;; Newest binding wins; only a first-time binding joins the walk order.
(define (opt-ssa-var-types-set
  [types : OptSsaVarTypes (:consume)]
  [var : i64]
  [ty : ast.AstType]) : OptSsaVarTypes
  (let
    [entries : opt_ssa_var_type_vec.Vec types.entries]
    [order : opt_dense_i64_vec.Vec types.order]
    (begin
      (while (<= (opt_ssa_var_type_vec.len (& entries)) var)
        (opt_ssa_var_type_vec.push
          (&mut entries)
          (OptSsaVarTypeEntry false (ast.AstType.I64))))
      (let
        [was-present? : bool
          (__tl-project-field
            (array-ref (opt_ssa_var_type_vec.slots (& entries)) var)
            present)]
        (begin
          (opt_ssa_var_type_vec.set
            (&mut entries)
            var
            (OptSsaVarTypeEntry true ty))
          (unless was-present? (opt_dense_i64_vec.push (&mut order) var))
          (OptSsaVarTypes entries order))))))

;; Newest-first walk support: the number of bound vars and the i-th newest.
(define (opt-ssa-var-types-count [types : OptSsaVarTypes]) : i64
  (opt_dense_i64_vec.len (& types.order)))

(define (opt-ssa-var-types-newest-var [types : OptSsaVarTypes] [index : i64]) : i64
  (let
    [order : opt_dense_i64_vec.Vec types.order]
    (array-ref
      (opt_dense_i64_vec.slots (& order))
      (- (- (opt_dense_i64_vec.len (& order)) index) 1))))

(defenum OptSsaFacts
  (Facts opt_i64_i64_map.Map opt_i64_i64_map.Map OptSsaVarTypes))

(defstruct OptSsaVarBlockEntry
  (labels OptLabelSet)
  (members (__tl_dyn-array bool)))

;; Function-local vreg ids are dense. Zero in `by-var` is explicit absence;
;; present values are one-based indexes into the compact entry prefix. Both
;; arrays are sized from the function frame/type inventory in production, so
;; lookup and updates are direct without generating another collection module
;; or allocating the expensive label/member payload for absent vars (#5731).
(defstruct OptSsaVarBlocks
  (by-var (__tl_dyn-array i64))
  (entries (__tl_dyn-array OptSsaVarBlockEntry))
  (entry-count i64))

(defenum OptSsaRenameEnv
  (Nil)
  (Cons i64 i64 (Box OptSsaRenameEnv)))

(defenum OptSsaDenseEntry
  (PhiSite i64 i64 ast.AstType i64)
  (RenameBlock i64 ir.CompilerIrInstrList)
  (BlockOut i64 OptSsaRenameEnv))

(import (vector.vector OptSsaDenseEntry core) as opt_ssa_dense_vec)

(defstruct OptSsaPhiSites
  (items opt_ssa_dense_vec.Vec))

(defstruct OptSsaRenameBlocks
  (items opt_ssa_dense_vec.Vec))

(defstruct OptSsaBlockOuts
  (items opt_ssa_dense_vec.Vec))

;; These three SSA sequences share one generated dense backend. Physical push
;; is logical Cons/prepend, so indexed consumers read from the live end toward
;; zero and retain the old newest-first lookup and phi emission order.
(define (opt-ssa-phi-sites-new) : OptSsaPhiSites
  (OptSsaPhiSites (opt_ssa_dense_vec.with-capacity 4)))

(define (opt-ssa-phi-sites-count [sites : OptSsaPhiSites]) : i64
  (opt_ssa_dense_vec.len (& sites.items)))

(define (opt-ssa-phi-sites-prepend
  [sites : OptSsaPhiSites (:consume)]
  [var : i64]
  [label : i64]
  [ty : ast.AstType]
  [phi-var : i64]) : OptSsaPhiSites
  (let
    [items : opt_ssa_dense_vec.Vec sites.items]
    (begin
      (opt_ssa_dense_vec.push
        (&mut items)
        (OptSsaDenseEntry.PhiSite var label ty phi-var))
      (OptSsaPhiSites items))))

(define (opt-ssa-phi-sites-ref [sites : OptSsaPhiSites] [index : i64]) : OptSsaDenseEntry
  (let
    [items : opt_ssa_dense_vec.Vec sites.items]
    (array-ref
      (opt_ssa_dense_vec.slots (& items))
      (- (- (opt_ssa_dense_vec.len (& items)) index) 1))))

(define (opt-ssa-rename-blocks-new) : OptSsaRenameBlocks
  (OptSsaRenameBlocks (opt_ssa_dense_vec.with-capacity 4)))

(define (opt-ssa-rename-blocks-with-capacity [capacity : i64]) : OptSsaRenameBlocks
  (OptSsaRenameBlocks (opt_ssa_dense_vec.with-capacity capacity)))

(define (opt-ssa-rename-blocks-count [blocks : OptSsaRenameBlocks]) : i64
  (opt_ssa_dense_vec.len (& blocks.items)))

(define (opt-ssa-rename-blocks-prepend
  [blocks : OptSsaRenameBlocks (:consume)]
  [label : i64]
  [instrs : ir.CompilerIrInstrList]) : OptSsaRenameBlocks
  (let
    [items : opt_ssa_dense_vec.Vec blocks.items]
    (begin
      (opt_ssa_dense_vec.push
        (&mut items)
        (OptSsaDenseEntry.RenameBlock label instrs))
      (OptSsaRenameBlocks items))))

(define (opt-ssa-rename-blocks-ref [blocks : OptSsaRenameBlocks] [index : i64]) : OptSsaDenseEntry
  (let
    [items : opt_ssa_dense_vec.Vec blocks.items]
    (array-ref
      (opt_ssa_dense_vec.slots (& items))
      (- (- (opt_ssa_dense_vec.len (& items)) index) 1))))

(define (opt-ssa-block-outs-new) : OptSsaBlockOuts
  (OptSsaBlockOuts (opt_ssa_dense_vec.with-capacity 4)))

(define (opt-ssa-block-outs-with-capacity [capacity : i64]) : OptSsaBlockOuts
  (OptSsaBlockOuts (opt_ssa_dense_vec.with-capacity capacity)))

(define (opt-ssa-block-outs-count [outs : OptSsaBlockOuts]) : i64
  (opt_ssa_dense_vec.len (& outs.items)))

(define (opt-ssa-block-outs-prepend
  [outs : OptSsaBlockOuts (:consume)]
  [label : i64]
  [env : OptSsaRenameEnv]) : OptSsaBlockOuts
  (let
    [items : opt_ssa_dense_vec.Vec outs.items]
    (begin
      (opt_ssa_dense_vec.push
        (&mut items)
        (OptSsaDenseEntry.BlockOut label env))
      (OptSsaBlockOuts items))))

(define (opt-ssa-block-outs-ref [outs : OptSsaBlockOuts] [index : i64]) : OptSsaDenseEntry
  (let
    [items : opt_ssa_dense_vec.Vec outs.items]
    (array-ref
      (opt_ssa_dense_vec.slots (& items))
      (- (- (opt_ssa_dense_vec.len (& items)) index) 1))))

(defenum OptSsaPhiInsertState
  (State
    OptSsaPhiSites
    i64
    OptLabelSet
    (__tl_dyn-array bool)
    (__tl_dyn-array bool)))

(defenum OptSsaRenameState
  (State OptSsaRenameBlocks OptSsaBlockOuts i64))

(defenum OptSsaDstResult
  (Result i64 OptSsaRenameEnv i64))

(defenum OptSsaInstrResult
  (Result ir.CompilerIrInstr OptSsaRenameEnv i64))

(defenum OptSsaBlockResult
  (Result ir.CompilerIrInstrList OptSsaRenameEnv i64))

(define (opt-ssa-count [counts : opt_i64_i64_map.Map] [var : i64]) : i64
  (opt_i64_i64_map.get-value-or (& counts) var 0))

(define (opt-ssa-count-add
  [counts : opt_i64_i64_map.Map (:consume)]
  [var : i64]) : opt_i64_i64_map.Map
  (let
    [next-count : i64 (+ 1 (opt-ssa-count counts var))]
    [out : opt_i64_i64_map.Map counts]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) var next-count)
      out)))

(define (opt-ssa-scalar-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Ptr _) true]
    [(ast.AstType.MutPtr _) true]
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.MutRef _ _) true]
    [_ false]))

(define (opt-ssa-facts-bad-var [facts : OptSsaFacts (:consume)] [var : i64]) : OptSsaFacts
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (OptSsaFacts.Facts counts (opt-used-add bad var) types)]))

(define (opt-ssa-facts-add-def-bad [facts : OptSsaFacts (:consume)] [var : i64]) : OptSsaFacts
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (OptSsaFacts.Facts
        (opt-ssa-count-add counts var)
        (opt-used-add bad var)
        types)]))

(define (opt-ssa-facts-add-def-ty
  [type-segment-bases : i64]
  [facts : OptSsaFacts (:consume)]
  [var : i64]
  [ty : ast.AstType]) : OptSsaFacts
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (let
        [next-counts : opt_i64_i64_map.Map (opt-ssa-count-add counts var)]
        (if (not (opt-ssa-scalar-type? ty))
          (OptSsaFacts.Facts next-counts (opt-used-add bad var) types)
          (match (opt-ssa-var-types-lookup types var)
            [(OptMaybeAstType.No)
              (OptSsaFacts.Facts
                next-counts
                bad
                (opt-ssa-var-types-set types var ty))]
            [(OptMaybeAstType.Some old)
              (OptSsaFacts.Facts
                next-counts
                (if (opt-type-eq type-segment-bases old ty)
                  bad
                  (opt-used-add bad var))
                types)])))]))

(define (opt-ssa-facts-add-param
  [type-segment-bases : i64]
  [facts : OptSsaFacts (:consume)]
  [param : ir.CompilerIrParam]) : OptSsaFacts
  (match param
    [(ir.CompilerIrParam.Param _ ty var)
      (opt-ssa-facts-add-def-ty type-segment-bases facts var ty)]))

(define (opt-ssa-facts-add-params
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [facts : OptSsaFacts (:consume)]) : OptSsaFacts
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) facts]
    [(ir.CompilerIrParamList.Array seq)
      (opt-ssa-facts-add-params
        type-segment-bases
        (ir.compiler-ir-param-seq-to-list seq)
        facts)]
    [(ir.CompilerIrParamList.Cons param rest)
      (opt-ssa-facts-add-params
        type-segment-bases
        (__tl-box-place rest)
        (opt-ssa-facts-add-param type-segment-bases facts param))]))

(define (opt-ssa-facts-add-instr
  [type-segment-bases : i64]
  [facts : OptSsaFacts (:consume)]
  [instr : ir.CompilerIrInstr]) : OptSsaFacts
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.Load dst _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.Cast dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.BinOp dst op _ _ ty)
      (opt-ssa-facts-add-def-ty
        type-segment-bases
        facts
        dst
        (ir.compiler-ir-binop-result-type op ty))]
    [(ir.CompilerIrInstr.UnOp dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.Call dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) facts]
          [(ir.CompilerIrSpmdCallResult.Value dst class ty)
            (match class
              [(ir.CompilerIrSpmdValueClass.Uniform)
                (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
              [(ir.CompilerIrSpmdValueClass.Varying)
                (opt-ssa-facts-add-def-bad facts dst)]
              [(ir.CompilerIrSpmdValueClass.Mask)
                (opt-ssa-facts-add-def-bad facts dst)])]))]
    [(ir.CompilerIrInstr.Phi dst _ ty)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst ty)]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (opt-ssa-facts-add-def-ty type-segment-bases facts dst (ast.AstType.I64))]
    [(ir.CompilerIrInstr.AddrOf dst src)
      (opt-ssa-facts-bad-var (opt-ssa-facts-add-def-bad facts dst) src)]
    [(ir.CompilerIrInstr.Alloc dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.Gep dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.LaneId dst _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-ssa-facts-add-def-bad facts dst))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.EntryArgv dst) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.EntryEnvp dst) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.Xgetbv dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [(ir.CompilerIrInstr.Syscall dst _) (opt-ssa-facts-add-def-bad facts dst)]
    [_ facts]))

(define (opt-ssa-facts-add-instr-seq-from
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [facts : OptSsaFacts (:consume)]) : OptSsaFacts
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    facts
    (opt-ssa-facts-add-instr-seq-from
      type-segment-bases
      instrs
      (+ index 1)
      (opt-ssa-facts-add-instr
        type-segment-bases
        facts
        (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-ssa-facts-add-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [facts : OptSsaFacts (:consume)]) : OptSsaFacts
  (match blocks
    [(ir.CompilerIrBlockList.Nil) facts]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-ssa-facts-add-blocks
            type-segment-bases
            (__tl-box-place rest)
            (opt-ssa-facts-add-instr-seq-from type-segment-bases instrs 0 facts))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ssa-facts-add-blocks
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        facts)]))

(define (opt-ssa-facts-from-function
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptSsaFacts
  (opt-ssa-facts-add-blocks
    type-segment-bases
    blocks
    (opt-ssa-facts-add-params
      type-segment-bases
      params
      (OptSsaFacts.Facts
        (opt_i64_i64_map.with-capacity 64)
        (opt_i64_i64_map.with-capacity 64)
        (opt-ssa-var-types-new)))))

(define (opt-ssa-candidate? [facts : OptSsaFacts] [var : i64]) : bool
  (match facts
    [(OptSsaFacts.Facts counts bad types)
      (and
        (> (opt-ssa-count counts var) 1)
        (not (opt-used-contains bad var))
        (match (opt-ssa-var-types-lookup types var)
          [(OptMaybeAstType.Some _) true]
          [(OptMaybeAstType.No) false]))]))

(define (opt-ssa-any-candidate-types?
  [facts : OptSsaFacts]
  [types : OptSsaVarTypes]
  [index : i64]) : bool
  (if (>= index (opt-ssa-var-types-count types))
    false
    (if (opt-ssa-candidate? facts (opt-ssa-var-types-newest-var types index))
      true
      (opt-ssa-any-candidate-types? facts types (+ index 1)))))

(define (opt-ssa-any-candidate? [facts : OptSsaFacts]) : bool
  (match facts
    [(OptSsaFacts.Facts _ _ types) (opt-ssa-any-candidate-types? facts types 0)]))

(define (opt-ssa-label-members-new [index : OptCfgIndex]) : (__tl_dyn-array
    bool)
  (array.make-array bool (opt-cfg-index-block-count index)))

(define (opt-ssa-label-member? [members : (__tl_dyn-array bool)] [id : i64]) : bool
  (if (and (>= id 0) (< id (array-length members)))
    (array-ref members id)
    false))

(define (opt-ssa-label-add-with-members
  [index : OptCfgIndex]
  [members : (__tl_dyn-array bool)]
  [labels : OptLabelSet]
  [label : i64]) : OptLabelSet
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id)
      (if (opt-ssa-label-member? members id)
        labels
        (begin
          (set! (array-ref members id) true)
          (opt-label-cons label labels)))]
    [(option_i64.None) (opt-label-add labels label)]))

(define (opt-ssa-label-mark-members!
  [index : OptCfgIndex]
  [members : (__tl_dyn-array bool)]
  [labels : OptLabelSet]) : unit
  (match labels
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (begin
        (match (opt-cfg-index-id index (opt-label-ref labels 0))
          [(option_i64.Some id)
            (if (and (>= id 0) (< id (array-length members)))
              (set! (array-ref members id) true)
              unit)]
          [(option_i64.None) unit])
        (opt-ssa-label-mark-members! index members (opt-label-tail labels)))]))

(define (opt-ssa-var-blocks-with-capacity
  [var-capacity : i64]
  [entry-capacity : i64]) : OptSsaVarBlocks
  (OptSsaVarBlocks
    (array.make-array i64 var-capacity)
    (array.make-array OptSsaVarBlockEntry entry-capacity)
    0))

(define (opt-ssa-var-blocks-add
  [index : OptCfgIndex]
  [blocks : OptSsaVarBlocks (:consume)]
  [var : i64]
  [label : i64]) : OptSsaVarBlocks
  (if (or (< var 0) (>= var (array-length blocks.by-var)))
    (string.tl_oob_abort)
    (let
      [by-var : (__tl_dyn-array i64) blocks.by-var]
      [entries : (__tl_dyn-array OptSsaVarBlockEntry) blocks.entries]
      [entry-count : i64 blocks.entry-count]
      [slot : i64 (clone (array-ref by-var var))]
      (if (> slot 0)
        (let
          [entry-index : i64 (- slot 1)]
          [entry : OptSsaVarBlockEntry (clone (array-ref entries entry-index))]
          [members : (__tl_dyn-array bool) entry.members]
          [labels : OptLabelSet entry.labels]
          (begin
            (set!
              (array-ref entries entry-index)
              (OptSsaVarBlockEntry
                (opt-ssa-label-add-with-members index members labels label)
                members))
            (OptSsaVarBlocks by-var entries entry-count)))
        (if (>= entry-count (array-length entries))
          (string.tl_oob_abort)
          (let
            [members : (__tl_dyn-array bool) (opt-ssa-label-members-new index)]
            [labels : OptLabelSet
              (opt-ssa-label-add-with-members
                index
                members
                (OptLabelSet.Nil)
                label)]
            (begin
              (set!
                (array-ref entries entry-count)
                (OptSsaVarBlockEntry labels members))
              (set! (array-ref by-var var) (+ entry-count 1))
              (OptSsaVarBlocks by-var entries (+ entry-count 1)))))))))

(define (opt-ssa-var-blocks-lookup [blocks : OptSsaVarBlocks] [var : i64]) : OptLabelSet
  (let
    [by-var : (__tl_dyn-array i64) blocks.by-var]
    [entries : (__tl_dyn-array OptSsaVarBlockEntry) blocks.entries]
    (if (or (< var 0) (>= var (array-length by-var)))
      (OptLabelSet.Nil)
      (let
        [slot : i64 (array-ref by-var var)]
        (if (> slot 0)
          (__tl-project-field (array-ref entries (- slot 1)) labels)
          (OptLabelSet.Nil))))))

(define (opt-ssa-def-blocks-add-param
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [defs : OptSsaVarBlocks (:consume)]
  [param : ir.CompilerIrParam]) : OptSsaVarBlocks
  (match param
    [(ir.CompilerIrParam.Param _ _ var)
      (if (opt-ssa-candidate? facts var)
        (opt-ssa-var-blocks-add index defs var label)
        defs)]))

(define (opt-ssa-def-blocks-add-params
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [defs : OptSsaVarBlocks (:consume)]
  [params : ir.CompilerIrParamList]) : OptSsaVarBlocks
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) defs]
    [(ir.CompilerIrParamList.Array seq)
      (opt-ssa-def-blocks-add-params
        index
        facts
        label
        defs
        (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons param rest)
      (opt-ssa-def-blocks-add-params
        index
        facts
        label
        (opt-ssa-def-blocks-add-param index facts label defs param)
        (__tl-box-place rest))]))

(define (opt-ssa-def-blocks-add-instr
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [defs : OptSsaVarBlocks (:consume)]
  [instr : ir.CompilerIrInstr]) : OptSsaVarBlocks
  (match (opt-instr-def-var instr)
    [(option_i64.Some var)
      (if (opt-ssa-candidate? facts var)
        (opt-ssa-var-blocks-add index defs var label)
        defs)]
    [(option_i64.None) defs]))

(define (opt-ssa-def-blocks-add-instr-seq-from
  [cfg-index : OptCfgIndex]
  [facts : OptSsaFacts]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [instr-index : i64]
  [defs : OptSsaVarBlocks (:consume)]) : OptSsaVarBlocks
  (if (>= instr-index (ir.compiler-ir-instr-seq-count instrs))
    defs
    (opt-ssa-def-blocks-add-instr-seq-from
      cfg-index
      facts
      label
      instrs
      (+ instr-index 1)
      (opt-ssa-def-blocks-add-instr
        cfg-index
        facts
        label
        defs
        (ir.compiler-ir-instr-seq-ref instrs instr-index)))))

(define (opt-ssa-def-blocks-add-blocks
  [cfg-index : OptCfgIndex]
  [facts : OptSsaFacts]
  [blocks : ir.CompilerIrBlockList]
  [defs : OptSsaVarBlocks (:consume)]) : OptSsaVarBlocks
  (match blocks
    [(ir.CompilerIrBlockList.Nil) defs]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-ssa-def-blocks-add-blocks
            cfg-index
            facts
            (__tl-box-place rest)
            (opt-ssa-def-blocks-add-instr-seq-from
              cfg-index
              facts
              label
              instrs
              0
              defs))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ssa-def-blocks-add-blocks
        cfg-index
        facts
        (ir.compiler-ir-block-seq-to-list seq)
        defs)]))

(define (opt-ssa-def-blocks-from-function
  [index : OptCfgIndex]
  [facts : OptSsaFacts]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [var-capacity : i64]
  [entry-capacity : i64]) : OptSsaVarBlocks
  (opt-ssa-def-blocks-add-blocks
    index
    facts
    blocks
    (opt-ssa-def-blocks-add-params
      index
      facts
      (opt-cfg-entry-label blocks)
      (opt-ssa-var-blocks-with-capacity var-capacity entry-capacity)
      params)))

(define (opt-ssa-phi-add-site
  [index : OptCfgIndex]
  [state : OptSsaPhiInsertState]
  [var : i64]
  [ty : ast.AstType]
  [label : i64]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState.State
        sites
        next-var
        worklist
        work-members
        site-members)
      (match (opt-cfg-index-id index label)
        [(option_i64.Some id)
          (if (opt-ssa-label-member? site-members id)
            state
            (begin
              (set! (array-ref site-members id) true)
              (OptSsaPhiInsertState.State
                (opt-ssa-phi-sites-prepend sites var label ty next-var)
                (+ next-var 1)
                (if (opt-ssa-label-member? work-members id)
                  worklist
                  (begin
                    (set! (array-ref work-members id) true)
                    (opt-label-cons label worklist)))
                work-members
                site-members)))]
        [(option_i64.None) state])]))

(define (opt-ssa-phi-add-frontier
  [index : OptCfgIndex]
  [var : i64]
  [ty : ast.AstType]
  [frontier : OptLabelSet]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match frontier
    [(OptLabelSet.Nil) state]
    [(OptLabelSet.Dense _ _)
      (opt-ssa-phi-add-frontier
        index
        var
        ty
        (opt-label-tail frontier)
        (opt-ssa-phi-add-site index state var ty (opt-label-ref frontier 0)))]))

(define (opt-ssa-insert-phis-worklist
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [var : i64]
  [ty : ast.AstType]
  [state : OptSsaPhiInsertState]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState.State
        sites
        next-var
        worklist
        work-members
        site-members)
      (match worklist
        [(OptLabelSet.Nil) state]
        [(OptLabelSet.Dense _ _)
          (let
            [label : i64 (opt-label-ref worklist 0)]
            (opt-ssa-insert-phis-worklist
              context
              blocks
              var
              ty
              (opt-ssa-phi-add-frontier
                context.index
                var
                ty
                (opt-cfg-dominance-frontier-with-context blocks context label)
                (OptSsaPhiInsertState.State
                  sites
                  next-var
                  (opt-label-tail worklist)
                  work-members
                  site-members))))])]))

(define (opt-ssa-insert-phis-for-var
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [defs : OptSsaVarBlocks]
  [state : OptSsaPhiInsertState]
  [var : i64]
  [ty : ast.AstType]) : OptSsaPhiInsertState
  (match state
    [(OptSsaPhiInsertState.State sites next-var _ work-members site-members)
      (let
        [index : OptCfgIndex context.index]
        [worklist : OptLabelSet (opt-ssa-var-blocks-lookup defs var)]
        (begin
          (opt-cfg-fill-bool! work-members (array-length work-members) false)
          (opt-cfg-fill-bool! site-members (array-length site-members) false)
          (opt-ssa-label-mark-members! index work-members worklist)
          (opt-ssa-insert-phis-worklist
            context
            blocks
            var
            ty
            (OptSsaPhiInsertState.State
              sites
              next-var
              worklist
              work-members
              site-members))))]))

(define (opt-ssa-insert-phis-types
  [facts : OptSsaFacts]
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [defs : OptSsaVarBlocks]
  [types : OptSsaVarTypes]
  [state : OptSsaPhiInsertState]
  [index : i64]) : OptSsaPhiInsertState
  (if (>= index (opt-ssa-var-types-count types))
    state
    (let
      [var : i64 (opt-ssa-var-types-newest-var types index)]
      (match (opt-ssa-var-types-lookup types var)
        [(OptMaybeAstType.Some ty)
          (opt-ssa-insert-phis-types
            facts
            context
            blocks
            defs
            types
            (if (opt-ssa-candidate? facts var)
              (opt-ssa-insert-phis-for-var context blocks defs state var ty)
              state)
            (+ index 1))]
        [(OptMaybeAstType.No)
          (opt-ssa-insert-phis-types
            facts
            context
            blocks
            defs
            types
            state
            (+ index 1))]))))

(define (opt-ssa-insert-phis
  [facts : OptSsaFacts]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : OptSsaPhiInsertState
  (match facts
    [(OptSsaFacts.Facts _ _ types)
      (let
        [index : OptCfgIndex context.index]
        [work-members : (__tl_dyn-array bool) (opt-ssa-label-members-new index)]
        [site-members : (__tl_dyn-array bool) (opt-ssa-label-members-new index)]
        (opt-ssa-insert-phis-types
          facts
          context
          blocks
          (opt-ssa-def-blocks-from-function
            index
            facts
            params
            blocks
            frame
            (opt-ssa-var-types-count types))
          types
          (OptSsaPhiInsertState.State
            (opt-ssa-phi-sites-new)
            frame
            (OptLabelSet.Nil)
            work-members
            site-members)
          0))]))

(define (opt-ssa-env-lookup [env : OptSsaRenameEnv] [var : i64]) : option_i64.Option
  (match env
    [(OptSsaRenameEnv.Nil) (option_i64.None)]
    [(OptSsaRenameEnv.Cons original current rest)
      (if (= original var)
        (option_i64.Some current)
        (opt-ssa-env-lookup (__tl-box-place rest) var))]))

(define (opt-ssa-env-bind
  [env : OptSsaRenameEnv]
  [original : i64]
  [current : i64]) : OptSsaRenameEnv
  (OptSsaRenameEnv.Cons original current (box env)))

(define (opt-ssa-env-from-params
  [facts : OptSsaFacts]
  [params : ir.CompilerIrParamList]
  [env : OptSsaRenameEnv]) : OptSsaRenameEnv
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) env]
    [(ir.CompilerIrParamList.Array seq)
      (opt-ssa-env-from-params facts (ir.compiler-ir-param-seq-to-list seq) env)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (opt-ssa-env-from-params
            facts
            (__tl-box-place rest)
            (if (opt-ssa-candidate? facts var)
              (opt-ssa-env-bind env var var)
              env))])]))

(define (opt-ssa-env-bind-phis-from
  [sites : OptSsaPhiSites]
  [label : i64]
  [env : OptSsaRenameEnv]
  [index : i64]) : OptSsaRenameEnv
  (if (>= index (opt-ssa-phi-sites-count sites))
    env
    (match (opt-ssa-phi-sites-ref sites index)
      [(OptSsaDenseEntry.PhiSite var site-label _ phi-var)
        (opt-ssa-env-bind-phis-from
          sites
          label
          (if (= label site-label)
            (opt-ssa-env-bind env var phi-var)
            env)
          (+ index 1))]
      [_ (string.tl_oob_abort)])))

(define (opt-ssa-env-bind-phis
  [sites : OptSsaPhiSites]
  [label : i64]
  [env : OptSsaRenameEnv]) : OptSsaRenameEnv
  (opt-ssa-env-bind-phis-from sites label env 0))

(define (opt-ssa-rewrite-value
  [env : OptSsaRenameEnv]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (opt-ssa-env-lookup env var)
        [(option_i64.Some current) (ir.CompilerIrValue.Var current)]
        [(option_i64.None) value])]
    [_ value]))

(define (opt-ssa-rewrite-maybe-value
  [env : OptSsaRenameEnv]
  [value : ir.CompilerIrMaybeValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrMaybeValue.No) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrMaybeValue.Some inner)
      (ir.CompilerIrMaybeValue.Some (opt-ssa-rewrite-value env inner))]))

(define (opt-ssa-rewrite-value-list
  [env : OptSsaRenameEnv]
  [values : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (match values
    [(ir.CompilerIrValueList.Nil) (ir.CompilerIrValueList.Nil)]
    [(ir.CompilerIrValueList.Array seq)
      (opt-ssa-rewrite-value-list env (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (ir.compiler-ir-value-cons
        (opt-ssa-rewrite-value env value)
        (opt-ssa-rewrite-value-list env (__tl-box-place rest)))]))

(define (opt-ssa-rewrite-call-args-array
  [env : OptSsaRenameEnv]
  [src : (__tl_dyn-array ir.CompilerIrValue)]
  [dst : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-ssa-rewrite-value env (array-ref src index)))
      (opt-ssa-rewrite-call-args-array env src dst (+ index 1)))))

(define (opt-ssa-rewrite-call-args
  [env : OptSsaRenameEnv]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrCallArgs.Nil)]
    [(ir.CompilerIrCallArgs.One value)
      (ir.CompilerIrCallArgs.One (opt-ssa-rewrite-value env value))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (opt-ssa-rewrite-value env a)
        (opt-ssa-rewrite-value env b))]
    [(ir.CompilerIrCallArgs.Array values)
      (let
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue (array-length values))]
        (begin
          (opt-ssa-rewrite-call-args-array env values out 0)
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-ssa-rewrite-spmd-call-arg
  [env : OptSsaRenameEnv]
  [arg : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArg
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class value ty)
      (ir.CompilerIrSpmdCallArg.Arg class (opt-ssa-rewrite-value env value) ty)]))

(define (opt-ssa-rewrite-spmd-call-args-array
  [env : OptSsaRenameEnv]
  [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [dst : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-ssa-rewrite-spmd-call-arg env (array-ref src index)))
      (opt-ssa-rewrite-spmd-call-args-array env src dst (+ index 1)))))

(define (opt-ssa-rewrite-spmd-call-args
  [env : OptSsaRenameEnv]
  [args : ir.CompilerIrSpmdCallArgList]) : ir.CompilerIrSpmdCallArgList
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) ir.CompilerIrSpmdCallArgList.Nil]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (ir.CompilerIrSpmdCallArgList.Cons
        (opt-ssa-rewrite-spmd-call-arg env arg)
        (box (opt-ssa-rewrite-spmd-call-args env (__tl-box-place rest))))]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 seq.len]
        [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        [out : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
          (array.make-array ir.CompilerIrSpmdCallArg count)]
        (begin
          (opt-ssa-rewrite-spmd-call-args-array env src out 0)
          (ir.CompilerIrSpmdCallArgList.Array
            (ir.CompilerIrSpmdCallArgSeq out count))))]))

(define (opt-ssa-rename-dst
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [dst : i64]) : OptSsaDstResult
  (if (opt-ssa-candidate? facts dst)
    (OptSsaDstResult.Result
      next-var
      (opt-ssa-env-bind env dst next-var)
      (+ next-var 1))
    (OptSsaDstResult.Result dst env next-var)))

(define (opt-ssa-rename-instr
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [instr : ir.CompilerIrInstr]) : OptSsaInstrResult
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Mov out-dst (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.Load dst src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Load out-dst (opt-ssa-rewrite-value env src) ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Cast
              out-dst
              (opt-ssa-rewrite-value env src)
              from-ty
              to-ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Bitcast
              out-dst
              (opt-ssa-rewrite-value env src)
              from-ty
              to-ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.BinOp
              out-dst
              op
              (opt-ssa-rewrite-value env lhs)
              (opt-ssa-rewrite-value env rhs)
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.UnOp
              out-dst
              op
              (opt-ssa-rewrite-value env src)
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Call
              out-dst
              name
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.CallIndirect dst func args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.CallIndirect
              out-dst
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.CallIndirectC dst func args ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.CallIndirectC
              out-dst
              (opt-ssa-rewrite-value env func)
              (opt-ssa-rewrite-call-args env args)
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-call-cabi-store-result
            (opt-ssa-rewrite-value env base)
            name
            (opt-ssa-rewrite-call-args env args)
            slots)
          env
          next-var))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [lane-offset
          (__tl-project-field (__tl-box-place payload-box) lane-offset)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-gather-load
            dst
            (opt-ssa-rewrite-value env base)
            (opt-ssa-rewrite-value env index-base)
            (opt-ssa-rewrite-value env index)
            lane-offset
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-call-indirect-cabi-store-result
            (opt-ssa-rewrite-value env base)
            (opt-ssa-rewrite-value env func)
            (opt-ssa-rewrite-call-args env args)
            slots)
          env
          next-var))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit)
            (OptSsaInstrResult.Result
              (ir.ir-instr-spmd-call
                callee
                backend
                lanes
                (opt-ssa-rewrite-value env active-mask)
                (opt-ssa-rewrite-spmd-call-args env args)
                result)
              env
              next-var)]
          [(ir.CompilerIrSpmdCallResult.Value dst class ty)
            (match (opt-ssa-rename-dst facts env next-var dst)
              [(OptSsaDstResult.Result out-dst next-env out-next)
                (OptSsaInstrResult.Result
                  (ir.ir-instr-spmd-call
                    callee
                    backend
                    lanes
                    (opt-ssa-rewrite-value env active-mask)
                    (opt-ssa-rewrite-spmd-call-args env args)
                    (ir.CompilerIrSpmdCallResult.Value out-dst class ty))
                  next-env
                  out-next)])]))]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.EntryArgc out-dst)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Gep
          dst
          (opt-ssa-rewrite-value env base)
          (opt-ssa-rewrite-value env offset)
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.StorePtr
          (opt-ssa-rewrite-value env ptr)
          (opt-ssa-rewrite-value env value)
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.CopyBytes
          (opt-ssa-rewrite-value env dst)
          (opt-ssa-rewrite-value env src)
          size)
        env
        next-var)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.BoundsCheck
          (opt-ssa-rewrite-value env index)
          (opt-ssa-rewrite-value env length)
          ok-label)
        env
        next-var)]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Splat
          dst
          (opt-ssa-rewrite-value env value)
          lanes
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-vector-bin-op
            dst
            op
            (opt-ssa-rewrite-value env lhs)
            (opt-ssa-rewrite-value env rhs)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-vector-prefix
            dst
            op
            (opt-ssa-rewrite-value env src)
            (opt-ssa-rewrite-value env carry)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.VectorReduce
          dst
          op
          (opt-ssa-rewrite-value env src)
          lanes
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-vector-compare
            dst
            op
            (opt-ssa-rewrite-value env lhs)
            (opt-ssa-rewrite-value env rhs)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.MaskBinOp
          dst
          op
          (opt-ssa-rewrite-value env lhs)
          (opt-ssa-rewrite-value env rhs)
          lanes)
        env
        next-var)]
    [(ir.CompilerIrInstr.MaskNot dst src lanes)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.MaskNot dst (opt-ssa-rewrite-value env src) lanes)
        env
        next-var)]
    [(ir.CompilerIrInstr.MaskReduce dst op src lanes)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.MaskReduce
          dst
          op
          (opt-ssa-rewrite-value env src)
          lanes)
        env
        next-var)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-select
            dst
            (opt-ssa-rewrite-value env mask)
            (opt-ssa-rewrite-value env on-true)
            (opt-ssa-rewrite-value env on-false)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.VectorLoad dst base index lanes ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.VectorLoad
          dst
          (opt-ssa-rewrite-value env base)
          (opt-ssa-rewrite-value env index)
          lanes
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-vector-store
            (opt-ssa-rewrite-value env base)
            (opt-ssa-rewrite-value env index)
            (opt-ssa-rewrite-value env value)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-predicated-store
            (opt-ssa-rewrite-value env base)
            (opt-ssa-rewrite-value env index)
            (opt-ssa-rewrite-value env value)
            (opt-ssa-rewrite-value env mask)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-predicated-load
            dst
            (opt-ssa-rewrite-value env base)
            (opt-ssa-rewrite-value env index)
            (opt-ssa-rewrite-value env mask)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (OptSsaInstrResult.Result
          (ir.ir-instr-vector-shuffle
            dst
            (opt-ssa-rewrite-value env source)
            (opt-ssa-rewrite-value env selector-low)
            (opt-ssa-rewrite-maybe-value env selector-high)
            (opt-ssa-rewrite-value env active-lanes)
            lanes
            ty)
          env
          next-var))]
    [(ir.CompilerIrInstr.TailMask dst index length lanes)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.TailMask
          dst
          (opt-ssa-rewrite-value env index)
          (opt-ssa-rewrite-value env length)
          lanes)
        env
        next-var)]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.CpuId
          dst
          (opt-ssa-rewrite-value env leaf)
          (opt-ssa-rewrite-value env subleaf)
          reg-index)
        env
        next-var)]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Xgetbv dst (opt-ssa-rewrite-value env index))
        env
        next-var)]
    [(ir.CompilerIrInstr.Syscall dst args)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Syscall dst (opt-ssa-rewrite-call-args env args))
        env
        next-var)]
    [(ir.CompilerIrInstr.Store name value ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Store name (opt-ssa-rewrite-value env value) ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Branch
          (opt-ssa-rewrite-value env cond)
          true-label
          false-label)
        env
        next-var)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.TotalEnumBranch
          (opt-ssa-rewrite-value env cond)
          true-label
          false-label)
        env
        next-var)]
    [(ir.CompilerIrInstr.Return maybe)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Return (opt-ssa-rewrite-maybe-value env maybe))
        env
        next-var)]
    [(ir.CompilerIrInstr.TailCall name args ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.TailCall
          name
          (opt-ssa-rewrite-call-args env args)
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.Alloc _ _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(ir.CompilerIrInstr.AddrOf _ _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(ir.CompilerIrInstr.LaneId _ _ _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(ir.CompilerIrInstr.EntryArgv _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(ir.CompilerIrInstr.EntryEnvp _)
      (OptSsaInstrResult.Result instr env next-var)]
    [(ir.CompilerIrInstr.Jump _) (OptSsaInstrResult.Result instr env next-var)]
    [(ir.CompilerIrInstr.Phi _ _ _)
      (OptSsaInstrResult.Result instr env next-var)]
    ;; SSA-rename register-group ops -- rewrite operands with the current
    ;; env, then rename the dst.
    [(ir.CompilerIrInstr.Pack dst words ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Pack
              out-dst
              (opt-ssa-rewrite-value-list env words)
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (match (opt-ssa-rename-dst facts env next-var dst)
        [(OptSsaDstResult.Result out-dst next-env out-next)
          (OptSsaInstrResult.Result
            (ir.CompilerIrInstr.Word
              out-dst
              (opt-ssa-rewrite-value env src)
              index
              ty)
            next-env
            out-next)])]
    [(ir.CompilerIrInstr.TailCallIndirect func args ty)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.TailCallIndirect
          (opt-ssa-rewrite-value env func)
          (opt-ssa-rewrite-call-args env args)
          ty)
        env
        next-var)]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.Switch
          (opt-ssa-rewrite-value env index)
          base
          cases
          default-label)
        env
        next-var)]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (OptSsaInstrResult.Result
        (ir.CompilerIrInstr.TotalEnumSwitch
          (opt-ssa-rewrite-value env index)
          base
          cases
          default-label
          trap-label)
        env
        next-var)]))

(define (opt-ssa-rename-instr-seq-from
  [facts : OptSsaFacts]
  [env : OptSsaRenameEnv]
  [next-var : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptSsaBlockResult
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptSsaBlockResult.Result (ir.CompilerIrInstrList.Nil) env next-var)
    (match (opt-ssa-rename-instr
      facts
      env
      next-var
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptSsaInstrResult.Result instr next-env instr-next)
        (match (opt-ssa-rename-instr-seq-from
          facts
          next-env
          instr-next
          instrs
          (+ index 1))
          [(OptSsaBlockResult.Result rest out-env out-next)
            (OptSsaBlockResult.Result
              (ir.compiler-ir-instr-cons instr rest)
              out-env
              out-next)])])))

(define (opt-ssa-rename-blocks-contains-from?
  [blocks : OptSsaRenameBlocks]
  [label : i64]
  [index : i64]) : bool
  (if (>= index (opt-ssa-rename-blocks-count blocks))
    false
    (match (opt-ssa-rename-blocks-ref blocks index)
      [(OptSsaDenseEntry.RenameBlock block-label _)
        (if (= block-label label)
          true
          (opt-ssa-rename-blocks-contains-from? blocks label (+ index 1)))]
      [_ (string.tl_oob_abort)])))

(define (opt-ssa-rename-blocks-contains?
  [blocks : OptSsaRenameBlocks]
  [label : i64]) : bool
  (opt-ssa-rename-blocks-contains-from? blocks label 0))

(define (opt-ssa-rename-blocks-lookup-from
  [blocks : OptSsaRenameBlocks]
  [label : i64]
  [index : i64]) : ir.CompilerIrInstrList
  (if (>= index (opt-ssa-rename-blocks-count blocks))
    (ir.CompilerIrInstrList.Nil)
    (match (opt-ssa-rename-blocks-ref blocks index)
      [(OptSsaDenseEntry.RenameBlock block-label instrs)
        (if (= block-label label)
          instrs
          (opt-ssa-rename-blocks-lookup-from blocks label (+ index 1)))]
      [_ (string.tl_oob_abort)])))

(define (opt-ssa-rename-blocks-lookup
  [blocks : OptSsaRenameBlocks]
  [label : i64]) : ir.CompilerIrInstrList
  (opt-ssa-rename-blocks-lookup-from blocks label 0))

(define (opt-ssa-block-out-lookup-from
  [outs : OptSsaBlockOuts]
  [label : i64]
  [index : i64]) : OptSsaRenameEnv
  (if (>= index (opt-ssa-block-outs-count outs))
    (OptSsaRenameEnv.Nil)
    (match (opt-ssa-block-outs-ref outs index)
      [(OptSsaDenseEntry.BlockOut out-label env)
        (if (= out-label label)
          env
          (opt-ssa-block-out-lookup-from outs label (+ index 1)))]
      [_ (string.tl_oob_abort)])))

(define (opt-ssa-block-out-lookup [outs : OptSsaBlockOuts] [label : i64]) : OptSsaRenameEnv
  (opt-ssa-block-out-lookup-from outs label 0))

(define (opt-ssa-rename-state-add-block
  [state : OptSsaRenameState]
  [label : i64]
  [instrs : ir.CompilerIrInstrList]
  [env : OptSsaRenameEnv]
  [next-var : i64]) : OptSsaRenameState
  (match state
    [(OptSsaRenameState.State blocks outs _)
      (OptSsaRenameState.State
        (opt-ssa-rename-blocks-prepend blocks label instrs)
        (opt-ssa-block-outs-prepend outs label env)
        next-var)]))

(define (opt-ssa-rename-id
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [id : i64]
  [env : OptSsaRenameEnv]
  [state : OptSsaRenameState]) : OptSsaRenameState
  (let
    [index : OptCfgIndex context.index]
    [label : i64 (array-ref index.labels id)]
    (match (opt-cfg-index-block index id)
      [(OptMaybeBlock.No) state]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [entry-env : OptSsaRenameEnv
                (opt-ssa-env-bind-phis sites label env)]
              (match (opt-ssa-rename-instr-seq-from
                facts
                entry-env
                (match state
                  [(OptSsaRenameState.State _ _ next-var) next-var])
                instrs
                0)
                [(OptSsaBlockResult.Result renamed out-env next-var)
                  (opt-ssa-rename-children
                    context
                    blocks
                    facts
                    sites
                    id
                    out-env
                    (opt-ssa-rename-state-add-block
                      state
                      label
                      renamed
                      out-env
                      next-var)
                    0)]))])])))

(define (opt-ssa-rename-children
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [parent-id : i64]
  [env : OptSsaRenameEnv]
  [state : OptSsaRenameState]
  [child-id : i64]) : OptSsaRenameState
  (let
    [index : OptCfgIndex context.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (>= child-id count)
      state
      (let
        [idom : (__tl_dyn-array i64) context.doms.idom]
        [next-state : OptSsaRenameState
          (if (and
            (not (= child-id parent-id))
            (array-ref index.reachable child-id)
            (= (array-ref idom child-id) parent-id))
            (opt-ssa-rename-id context blocks facts sites child-id env state)
            state)]
        (opt-ssa-rename-children
          context
          blocks
          facts
          sites
          parent-id
          env
          next-state
          (+ child-id 1))))))

(define (opt-ssa-rename-missing-blocks
  [blocks : ir.CompilerIrBlockList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [initial-env : OptSsaRenameEnv]
  [state : OptSsaRenameState]) : OptSsaRenameState
  (match blocks
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [next-state : OptSsaRenameState
              (match state
                [(OptSsaRenameState.State renamed _ next-var)
                  (if (opt-ssa-rename-blocks-contains? renamed label)
                    state
                    (match (opt-ssa-rename-instr-seq-from
                      facts
                      (opt-ssa-env-bind-phis sites label initial-env)
                      next-var
                      instrs
                      0)
                      [(OptSsaBlockResult.Result out out-env out-next)
                        (opt-ssa-rename-state-add-block
                          state
                          label
                          out
                          out-env
                          out-next)]))])]
            (opt-ssa-rename-missing-blocks
              (__tl-box-place rest)
              facts
              sites
              initial-env
              next-state))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ssa-rename-missing-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        facts
        sites
        initial-env
        state)]))

(define (opt-ssa-rename-function-blocks
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : OptSsaRenameState
  (let
    [initial-env : OptSsaRenameEnv
      (opt-ssa-env-from-params facts params (OptSsaRenameEnv.Nil))]
    [entry-label : i64 (opt-cfg-entry-label blocks)]
    [index : OptCfgIndex context.index]
    [block-capacity : i64 (opt-cfg-index-block-count index)]
    (begin
      (opt-cfg-index-refresh-blocks! index blocks)
      (match (opt-cfg-index-id index entry-label)
        [(option_i64.Some entry-id)
          (opt-ssa-rename-missing-blocks
            blocks
            facts
            sites
            initial-env
            (opt-ssa-rename-id
              context
              blocks
              facts
              sites
              entry-id
              initial-env
              (OptSsaRenameState.State
                (opt-ssa-rename-blocks-with-capacity block-capacity)
                (opt-ssa-block-outs-with-capacity block-capacity)
                frame)))]
        [(option_i64.None)
          (OptSsaRenameState.State
            (opt-ssa-rename-blocks-with-capacity block-capacity)
            (opt-ssa-block-outs-with-capacity block-capacity)
            frame)]))))

;; Dead-path phi input: a candidate var can reach a phi over an edge on which
;; it has no definition -- e.g. an inner-loop counter's phi at the OUTER loop
;; header sees the function-entry path, where the counter is first defined only
;; inside the outer body. A well-formed source never READS the var along such a
;; path, so the input value is unobservable there. The previous fallback named
;; the ORIGINAL var, which made the materialized function fail the
;; use-before-definition verify and silently disabled SSA construction (and
;; with it every SSA-gated pass: GVN, load-GVN, preheaders, LICM, induction,
;; loop-BCE) for every function with a nested loop. Feed a typed zero constant
;; instead: it renders and allocates like any other constant phi input, and
;; phis whose value is never used are removed by DCE.
(define (opt-ssa-phi-undef-input [ty : ast.AstType]) : ir.CompilerIrValue
  (if (opt-float-type? ty)
    (ir.CompilerIrValue.F64 0)
    (if (opt-bool-type? ty)
      (ir.CompilerIrValue.Bool false)
      (ir.CompilerIrValue.I64 0))))

(define (opt-ssa-phi-inputs
  [preds : OptLabelSet]
  [outs : OptSsaBlockOuts]
  [var : i64]
  [ty : ast.AstType]) : ir.CompilerIrPhiInputList
  (match preds
    [(OptLabelSet.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        [env : OptSsaRenameEnv (opt-ssa-block-out-lookup outs pred)]
        [value : ir.CompilerIrValue
          (match (opt-ssa-env-lookup env var)
            [(option_i64.Some current) (ir.CompilerIrValue.Var current)]
            [(option_i64.None) (opt-ssa-phi-undef-input ty)])]
        (ir.compiler-ir-phi-input-cons
          value
          pred
          (opt-ssa-phi-inputs (opt-label-tail preds) outs var ty)))]))

;; Append this label's inserted phis to `builder`, in phi-site order. The old
;; shape recursed to the end of `sites` first and consed each phi onto the
;; returned tail, which produced the same site order through a cons node per
;; phi; pushing on the way down produces it directly. `opt-ssa-phi-inputs` is a
;; pure lookup over `pred-map`/`outs`, so evaluating it in forward site order
;; rather than reverse changes nothing it returns.
(define (opt-ssa-push-phis-for-label-from!
  [pred-map : OptPredMap]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]
  [label : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [index : i64]) : unit
  (if (>= index (opt-ssa-phi-sites-count sites))
    unit
    (begin
      (match (opt-ssa-phi-sites-ref sites index)
        [(OptSsaDenseEntry.PhiSite var site-label ty phi-var)
          (if (= site-label label)
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Phi
                phi-var
                (opt-ssa-phi-inputs
                  (opt-pred-map-lookup pred-map label)
                  outs
                  var
                  ty)
                ty))
            unit)]
        [_ (string.tl_oob_abort)])
      (opt-ssa-push-phis-for-label-from!
        pred-map
        outs
        sites
        label
        (&mut builder)
        (+ index 1)))))

(define (opt-ssa-push-phis-for-label!
  [pred-map : OptPredMap]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]
  [label : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (opt-ssa-push-phis-for-label-from! pred-map outs sites label (&mut builder) 0))

(define (opt-ssa-materialize-blocks
  [blocks : ir.CompilerIrBlockList]
  [pred-map : OptPredMap]
  [facts : OptSsaFacts]
  [renamed : OptSsaRenameBlocks]
  [outs : OptSsaBlockOuts]
  [sites : OptSsaPhiSites]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            ;; One builder per block, filled phis-then-body. The old shape built
            ;; a cons chain for each half, joined them with
            ;; `opt-aggregate-instr-list-append`, and then had
            ;; `compiler-ir-block` walk the joined spine twice more (count, then
            ;; fill-array) to rebuild the dense sequence it started from.
            [builder : ir.CompilerIrInstrBuilder
              (ir.compiler-ir-instr-builder-new)]
            (begin
              (opt-ssa-push-phis-for-label!
                pred-map
                outs
                sites
                label
                (&mut builder))
              (opt-ssa-push-rewritten-preexisting-instrs!
                facts
                outs
                (opt-ssa-rename-blocks-lookup renamed label)
                (&mut builder))
              (ir.compiler-ir-block-cons
                (ir.CompilerIrBlock.Block
                  label
                  (ir.compiler-ir-instr-builder-to-seq builder))
                (opt-ssa-materialize-blocks
                  (__tl-box-place rest)
                  pred-map
                  facts
                  renamed
                  outs
                  sites))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ssa-materialize-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        pred-map
        facts
        renamed
        outs
        sites)]))

;; Pre-existing (lowerer-emitted) phis: value-producing `if`/`match` joins
;; lower directly to Phi instructions, so a function can arrive at SSA
;; construction with phis AND multi-def `set!` locals. The renamer passes
;; such phis through untouched (their inputs are edge uses that must NOT be
;; rewritten with the current block env); the materializer rewrites each
;; input with the PREDECESSOR's out-env below, exactly like the inserted phi
;; sites, so the renamed defs reach the pre-existing joins per edge. A
;; candidate input with no binding on some edge is the dead-path case and
;; takes the typed undef constant (see opt-ssa-phi-undef-input).
(define (opt-ssa-rewrite-preexisting-phi-inputs
  [facts : OptSsaFacts]
  [outs : OptSsaBlockOuts]
  [inputs : ir.CompilerIrPhiInputList]
  [ty : ast.AstType]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-ssa-rewrite-preexisting-phi-inputs
        facts
        outs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        ty)]
    [(ir.CompilerIrPhiInputList.Cons value pred rest)
      (ir.compiler-ir-phi-input-cons
        (match value
          [(ir.CompilerIrValue.Var v)
            (if (opt-ssa-candidate? facts v)
              (match (opt-ssa-env-lookup (opt-ssa-block-out-lookup outs pred) v)
                [(option_i64.Some current) (ir.CompilerIrValue.Var current)]
                [(option_i64.None) (opt-ssa-phi-undef-input ty)])
              value)]
          [_ value])
        pred
        (opt-ssa-rewrite-preexisting-phi-inputs
          facts
          outs
          (__tl-box-place rest)
          ty))]))

;; Append the renamed block body to `builder`, rewriting pre-existing phi
;; inputs in place of the old cons-per-instruction rebuild. Traversal order is
;; unchanged: the old form evaluated the rewrite for the head before recursing
;; on the tail, and so does this one.
(define (opt-ssa-push-rewritten-preexisting-instrs!
  [facts : OptSsaFacts]
  [outs : OptSsaBlockOuts]
  [instrs : ir.CompilerIrInstrList]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match instrs
    [(ir.CompilerIrInstrList.Nil) unit]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (begin
        (ir.compiler-ir-instr-builder-push!
          (&mut builder)
          (match instr
            [(ir.CompilerIrInstr.Phi dst inputs ty)
              (ir.CompilerIrInstr.Phi
                dst
                (opt-ssa-rewrite-preexisting-phi-inputs facts outs inputs ty)
                ty)]
            [_ instr]))
        (opt-ssa-push-rewritten-preexisting-instrs!
          facts
          outs
          (__tl-box-place rest)
          (&mut builder)))]))

;; A pre-existing phi whose DST is itself a rename candidate would need its
;; definition versioned per edge -- out of scope; skip construction (the
;; lowerer emits fresh single-def phi dsts, so this does not fire today).
(define (opt-ssa-instr-seq-has-candidate-phi-dst?
  [facts : OptSsaFacts]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst _ _)
        (if (opt-ssa-candidate? facts dst)
          true
          (opt-ssa-instr-seq-has-candidate-phi-dst? facts instrs (+ index 1)))]
      [_ (opt-ssa-instr-seq-has-candidate-phi-dst? facts instrs (+ index 1))])))

(define (opt-ssa-blocks-have-candidate-phi-dst?
  [facts : OptSsaFacts]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-ssa-instr-seq-has-candidate-phi-dst? facts instrs 0)
            true
            (opt-ssa-blocks-have-candidate-phi-dst? facts (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ssa-blocks-have-candidate-phi-dst?
        facts
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-ssa-instr-seq-has-phi?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ _) true]
      [_ (opt-ssa-instr-seq-has-phi? instrs (+ index 1))])))

(define (opt-ssa-blocks-have-phi? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-ssa-instr-seq-has-phi? instrs 0)
            true
            (opt-ssa-blocks-have-phi? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ssa-blocks-have-phi? (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-ssa-construct-checked
  [fallback : ir.CompilerIrFunction]
  [next : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-verify-function next)
    [(ResultCompilerOptimizeVerify.Ok) next]
    [(ResultCompilerOptimizeVerify.Err _) fallback]))

(define (opt-ssa-construct-materialized
  [fallback : ir.CompilerIrFunction]
  [name : i64]
  [params : ir.CompilerIrParamList]
  [ret-ty : ast.AstType]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [state : OptSsaRenameState]) : ir.CompilerIrFunction
  (match state
    [(OptSsaRenameState.State renamed outs next-frame)
      (opt-ssa-construct-checked
        fallback
        (ir.CompilerIrFunction.Function
          name
          params
          ret-ty
          next-frame
          (opt-ssa-materialize-blocks
            blocks
            context.pred-map
            facts
            renamed
            outs
            sites)))]))

(define (opt-ssa-construct-materialized-with-context-result
  [fallback : ir.CompilerIrFunction]
  [name : i64]
  [params : ir.CompilerIrParamList]
  [ret-ty : ast.AstType]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [facts : OptSsaFacts]
  [sites : OptSsaPhiSites]
  [state : OptSsaRenameState]) : OptFunctionCtxResult
  (match state
    [(OptSsaRenameState.State renamed outs next-frame)
      (let
        [next-blocks : ir.CompilerIrBlockList
          (opt-ssa-materialize-blocks
            blocks
            context.pred-map
            facts
            renamed
            outs
            sites)]
        [next : ir.CompilerIrFunction
          (ir.CompilerIrFunction.Function
            name
            params
            ret-ty
            next-frame
            next-blocks)]
        [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
        (match (opt-verify-function-with-context next next-context)
          [(ResultCompilerOptimizeVerify.Ok)
            (OptFunctionCtxResult.Result next next-context)]
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionCtxResult.Result fallback context)]))]))

;; True when the entry block has an explicit CFG predecessor (e.g. the
;; tail-recursion-to-loop back edge jumps to the function entry block).
(define (opt-ssa-entry-has-preds? [context : OptCfgContext]) : bool
  (let
    [index : OptCfgIndex context.index]
    (match (opt-cfg-index-id index context.entry-label)
      [(option_i64.Some id)
        (let
          [preds : OptCfgCsr index.preds]
          [offsets : (__tl_dyn-array i64) preds.offsets]
          (> (- (array-ref offsets (+ id 1)) (array-ref offsets id)) 0))]
      [(option_i64.None) false])))

;; Give the implicit function-entry edge an ordinary CFG label when a backedge
;; targets the first lowered block. Parameters dominate this fresh preheader,
;; which makes their initial values available as normal phi inputs at the old
;; entry. The old entry remains the loop header and every existing backedge
;; remains untouched. A label collision fails closed by returning the original
;; blocks; the caller observes that their entry still has predecessors.
(define (opt-ssa-explicit-entry-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [entry : i64 (opt-cfg-entry-label blocks)]
    [preheader : i64
      (ir.compiler-ir-label
        (str_cat.str-cat (ir.compiler-ir-label-text entry) "__ssa_entry"))]
    (if (or
      (not (ir.compiler-ir-label-some? entry))
      (opt-cfg-block-exists? blocks preheader))
      blocks
      (ir.compiler-ir-block-cons
        (ir.compiler-ir-block
          preheader
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Jump entry)
            (ir.CompilerIrInstrList.Nil)))
        blocks))))

(define (opt-ssa-explicit-entry-available? [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [entry : i64 (opt-cfg-entry-label blocks)]
    (and
      (ir.compiler-ir-label-some? entry)
      (not
        (opt-cfg-block-exists?
          blocks
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text entry) "__ssa_entry")))))))

(define (opt-ssa-construct-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (opt-verify-single-defs? params frame blocks)
        func
        (let
          [facts : OptSsaFacts
            (opt-ssa-facts-from-function type-segment-bases params blocks)]
          ;; Pre-existing lowerer phis are fine (their inputs are rewritten
          ;; per edge during materialization); only a phi DST that is itself
          ;; a rename candidate is out of scope.
          (if (opt-ssa-blocks-have-candidate-phi-dst? facts blocks)
            func
            (if (not (opt-ssa-any-candidate? facts))
              func
              (let
                [context : OptCfgContext (opt-cfg-context-build blocks)]
                (if (opt-ssa-entry-has-preds? context)
                  func
                  (opt-ssa-construct-with-context
                    func
                    name
                    params
                    ret-ty
                    frame
                    blocks
                    facts
                    context)))))))]))

(define (opt-ssa-construct-with-context
  [func : ir.CompilerIrFunction]
  [name : i64]
  [params : ir.CompilerIrParamList]
  [ret-ty : ast.AstType]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [facts : OptSsaFacts]
  [context : OptCfgContext]) : ir.CompilerIrFunction
  (let
    [phi-state : OptSsaPhiInsertState
      (opt-ssa-insert-phis facts context params frame blocks)]
    (match phi-state
      [(OptSsaPhiInsertState.State sites phi-next _ _ _)
        (opt-ssa-construct-materialized
          func
          name
          params
          ret-ty
          blocks
          context
          facts
          sites
          (opt-ssa-rename-function-blocks
            context
            params
            facts
            sites
            phi-next
            blocks))])))

(define (opt-ssa-construct-with-context-result
  [func : ir.CompilerIrFunction]
  [name : i64]
  [params : ir.CompilerIrParamList]
  [ret-ty : ast.AstType]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [facts : OptSsaFacts]
  [context : OptCfgContext]) : OptFunctionCtxResult
  (let
    [phi-state : OptSsaPhiInsertState
      (opt-ssa-insert-phis facts context params frame blocks)]
    (match phi-state
      [(OptSsaPhiInsertState.State sites phi-next _ _ _)
        (opt-ssa-construct-materialized-with-context-result
          func
          name
          params
          ret-ty
          blocks
          context
          facts
          sites
          (opt-ssa-rename-function-blocks
            context
            params
            facts
            sites
            phi-next
            blocks))])))

;; `entry-context` is consumed only when `entry-context-valid?` reports that it
;; was built for `func`'s current blocks; otherwise this builds its own, exactly
;; as before. The pre-SSA rotation pass hands its context down this way.
(define (opt-ssa-construct-function-from-context-result
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [entry-context : OptCfgContext]
  [entry-context-valid? : bool]) : OptFunctionCtxResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [context : OptCfgContext
          (if entry-context-valid?
            entry-context
            (opt-cfg-context-build blocks))]
        (if (opt-verify-single-defs? params frame blocks)
          (OptFunctionCtxResult.Result func context)
          (let
            [facts : OptSsaFacts
              (opt-ssa-facts-from-function type-segment-bases params blocks)]
            (cond
              ;; Pre-existing lowerer phis are fine (their inputs are rewritten
              ;; per edge during materialization); only a phi DST that is
              ;; itself a rename candidate is out of scope.
              [(opt-ssa-blocks-have-candidate-phi-dst? facts blocks)
                (OptFunctionCtxResult.Result func context)]
              [(not (opt-ssa-any-candidate? facts))
                (OptFunctionCtxResult.Result func context)]
              [(opt-ssa-entry-has-preds? context)
                (OptFunctionCtxResult.Result func context)]
              [else
                (opt-ssa-construct-with-context-result
                  func
                  name
                  params
                  ret-ty
                  frame
                  blocks
                  facts
                  context)]))))]))

;; --- conservative global value numbering / cross-block copies ---------------
;;
;; This pass is deliberately SSA-gated. If the function verifier cannot prove
;; single definitions and dominance for every use, the pass leaves the function
;; unchanged and the existing block-local optimizer still runs. For verified
;; functions, a copy/expression fact is available only in the defining block
;; after the defining instruction, or in a block dominated by the definition's
;; block. Phi inputs are resolved at the end of their named predecessor, never
;; at the phi block itself.
(defenum OptGlobalExprKey
  (MovKey ir.CompilerIrValue ast.AstType)
  (GepKey ir.CompilerIrValue ir.CompilerIrValue ast.AstType)
  (CastKey ir.CompilerIrValue ast.AstType ast.AstType)
  (BinKey ir.CompilerIrBinOp ir.CompilerIrValue ir.CompilerIrValue ast.AstType)
  (UnKey ir.CompilerIrUnOp ir.CompilerIrValue ast.AstType))

(defenum OptMaybeGlobalExprKey
  (No)
  (Some OptGlobalExprKey))

(defenum OptGlobalExprFact
  (Fact OptGlobalExprKey i64 i64 i64))

(defenum OptGlobalCopyFact
  (Fact i64 ir.CompilerIrValue i64 i64))

;; SSA-only Pack/Word facts. Unlike the block-local pre-SSA copy fold, these
;; facts may safely carry a Var word across blocks: a verified Pack is dominated
;; by every Var in its word list, and the Pack in turn dominates any Word fact
;; accepted by the lookup below.
(defenum OptGlobalPackWordFact
  (Fact i64 i64 ir.CompilerIrValue i64 i64))

(defenum OptGlobalDenseFact
  (Expr OptGlobalExprFact)
  (Copy OptGlobalCopyFact)
  (PackWord OptGlobalPackWordFact))

(import (vector.vector OptGlobalDenseFact core) as opt_global_fact_vec)

(defstruct OptGlobalExprFacts
  (items opt_global_fact_vec.Vec))

(defstruct OptGlobalExprFactTable
  (buckets (__tl_dyn-array OptGlobalExprFacts)))

(defstruct OptGlobalCopyFacts
  (items opt_global_fact_vec.Vec))

(defstruct OptGlobalCopyFactTable
  (buckets (__tl_dyn-array OptGlobalCopyFacts)))

(defstruct OptGlobalPackWordFacts
  (items opt_global_fact_vec.Vec))

(defstruct OptGlobalPackWordFactTable
  (buckets (__tl_dyn-array OptGlobalPackWordFacts)))

;; These three fact sequences use a dense vector as a reverse-facing stack:
;; physical push is logical prepend. That preserves the old Cons construction
;; order while letting collection and bucket insertion grow geometrically.
(define (opt-global-expr-facts-new) : OptGlobalExprFacts
  (OptGlobalExprFacts (opt_global_fact_vec.new)))

(define (opt-global-expr-facts-count [facts : OptGlobalExprFacts]) : i64
  (opt_global_fact_vec.len (& facts.items)))

(define (opt-global-expr-facts-prepend
  [facts : OptGlobalExprFacts (:consume)]
  [fact : OptGlobalExprFact]) : OptGlobalExprFacts
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (begin
      (opt_global_fact_vec.push (&mut items) (OptGlobalDenseFact.Expr fact))
      (OptGlobalExprFacts items))))

(define (opt-global-expr-facts-ref [facts : OptGlobalExprFacts] [index : i64]) : OptGlobalExprFact
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (match (clone
      (array-ref
        (opt_global_fact_vec.slots (& items))
        (- (- (opt_global_fact_vec.len (& items)) index) 1)))
      [(OptGlobalDenseFact.Expr fact) fact]
      [_ (string.tl_oob_abort)])))

(define (opt-global-copy-facts-new) : OptGlobalCopyFacts
  (OptGlobalCopyFacts (opt_global_fact_vec.new)))

(define (opt-global-copy-facts-count [facts : OptGlobalCopyFacts]) : i64
  (opt_global_fact_vec.len (& facts.items)))

(define (opt-global-copy-facts-prepend
  [facts : OptGlobalCopyFacts (:consume)]
  [fact : OptGlobalCopyFact]) : OptGlobalCopyFacts
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (begin
      (opt_global_fact_vec.push (&mut items) (OptGlobalDenseFact.Copy fact))
      (OptGlobalCopyFacts items))))

(define (opt-global-copy-facts-ref [facts : OptGlobalCopyFacts] [index : i64]) : OptGlobalCopyFact
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (match (clone
      (array-ref
        (opt_global_fact_vec.slots (& items))
        (- (- (opt_global_fact_vec.len (& items)) index) 1)))
      [(OptGlobalDenseFact.Copy fact) fact]
      [_ (string.tl_oob_abort)])))

(define (opt-global-pack-word-facts-new) : OptGlobalPackWordFacts
  (OptGlobalPackWordFacts (opt_global_fact_vec.new)))

(define (opt-global-pack-word-facts-count [facts : OptGlobalPackWordFacts]) : i64
  (opt_global_fact_vec.len (& facts.items)))

(define (opt-global-pack-word-facts-prepend
  [facts : OptGlobalPackWordFacts (:consume)]
  [fact : OptGlobalPackWordFact]) : OptGlobalPackWordFacts
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (begin
      (opt_global_fact_vec.push (&mut items) (OptGlobalDenseFact.PackWord fact))
      (OptGlobalPackWordFacts items))))

(define (opt-global-pack-word-facts-ref
  [facts : OptGlobalPackWordFacts]
  [index : i64]) : OptGlobalPackWordFact
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (match (clone
      (array-ref
        (opt_global_fact_vec.slots (& items))
        (- (- (opt_global_fact_vec.len (& items)) index) 1)))
      [(OptGlobalDenseFact.PackWord fact) fact]
      [_ (string.tl_oob_abort)])))

(define (opt-global-expr-key-eq
  [type-segment-bases : i64]
  [a : OptGlobalExprKey]
  [b : OptGlobalExprKey]) : bool
  (match a
    [(OptGlobalExprKey.MovKey av aty)
      (match b
        [(OptGlobalExprKey.MovKey bv bty)
          (and (opt-value-eq av bv) (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(OptGlobalExprKey.GepKey abase aoff aty)
      (match b
        [(OptGlobalExprKey.GepKey bbase boff bty)
          (and
            (opt-value-eq abase bbase)
            (opt-value-eq aoff boff)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(OptGlobalExprKey.CastKey av afrom ato)
      (match b
        [(OptGlobalExprKey.CastKey bv bfrom bto)
          (and
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases afrom bfrom)
            (opt-type-eq type-segment-bases ato bto))]
        [_ false])]
    [(OptGlobalExprKey.BinKey aop al ar aty)
      (match b
        [(OptGlobalExprKey.BinKey bop bl br bty)
          (and
            (opt-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(OptGlobalExprKey.UnKey aop av aty)
      (match b
        [(OptGlobalExprKey.UnKey bop bv bty)
          (and
            (opt-unop-eq aop bop)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]))

(define (opt-global-expr-key-hash
  [type-segment-bases : i64]
  [key : OptGlobalExprKey]) : i64
  (match key
    [(OptGlobalExprKey.MovKey value ty)
      (hash.combine
        1
        (hash.combine
          (opt-value-hash value)
          (opt-type-hash type-segment-bases ty)))]
    [(OptGlobalExprKey.GepKey base offset ty)
      (hash.combine
        2
        (hash.combine
          (opt-value-hash base)
          (hash.combine
            (opt-value-hash offset)
            (opt-type-hash type-segment-bases ty))))]
    [(OptGlobalExprKey.CastKey value from-ty to-ty)
      (hash.combine
        3
        (hash.combine
          (opt-value-hash value)
          (hash.combine
            (opt-type-hash type-segment-bases from-ty)
            (opt-type-hash type-segment-bases to-ty))))]
    [(OptGlobalExprKey.BinKey op lhs rhs ty)
      (hash.combine
        4
        (hash.combine
          (hash.i64 (opt-binop-tag op))
          (hash.combine
            (opt-value-hash lhs)
            (hash.combine
              (opt-value-hash rhs)
              (opt-type-hash type-segment-bases ty)))))]
    [(OptGlobalExprKey.UnKey op value ty)
      (hash.combine
        5
        (hash.combine
          (hash.i64 (opt-unop-tag op))
          (hash.combine
            (opt-value-hash value)
            (opt-type-hash type-segment-bases ty))))]))

;; Key operands must hold a single unchanging value for the fact's lifetime.
;; An `CompilerIrValue.Global` operand is a hidden LOAD of a mutable global (the backend
;; emits a rip-relative read at each use site), so an instruction using one is
;; not a pure expression: reusing its result across an intervening store/call
;; that mutates the global yields a stale value. The opt2 self-build miscompile
;; was exactly this -- `ty-node-push` reused the pre-grow capacity address of
;; `ty-node-pool-slots` after the grow call replaced the array, so the bounds
;; check compared against the old capacity and aborted once the pool grew.
;; `opt-copy-safe-source?` already encodes the safe operand set: vars
;; (single-def under this pass's SSA gate) and unambiguous scalar literals.
(define (opt-global-key-for-instr [instr : ir.CompilerIrInstr]) : OptMaybeGlobalExprKey
  (match instr
    [(ir.CompilerIrInstr.Mov _ src ty)
      (if (opt-copy-safe-source? src)
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.MovKey src ty))
        (OptMaybeGlobalExprKey.No))]
    [(ir.CompilerIrInstr.Gep _ base offset ty)
      (if (and (opt-copy-safe-source? base) (opt-copy-safe-source? offset))
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.GepKey base offset ty))
        (OptMaybeGlobalExprKey.No))]
    [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
      (if (opt-copy-safe-source? src)
        (OptMaybeGlobalExprKey.Some
          (OptGlobalExprKey.CastKey src from-ty to-ty))
        (OptMaybeGlobalExprKey.No))]
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (if (and (opt-copy-safe-source? lhs) (opt-copy-safe-source? rhs))
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.BinKey op lhs rhs ty))
        (OptMaybeGlobalExprKey.No))]
    [(ir.CompilerIrInstr.UnOp _ op src ty)
      (if (opt-copy-safe-source? src)
        (OptMaybeGlobalExprKey.Some (OptGlobalExprKey.UnKey op src ty))
        (OptMaybeGlobalExprKey.No))]
    [_ (OptMaybeGlobalExprKey.No)]))

(define (opt-global-fact-available?
  [def-block-id : i64]
  [def-pos : i64]
  [use-block-id : i64]
  [use-pos : i64]
  [doms : OptDomInfo]) : bool
  (if (= def-block-id use-block-id)
    (< def-pos use-pos)
    (opt-dom-info-dominates-id? doms def-block-id use-block-id)))

(define (opt-global-block-id [doms : OptDomInfo] [label : i64]) : i64
  (match (opt-cfg-index-id doms.index label)
    [(option_i64.Some id) id]
    [(option_i64.None) (- 0 1)]))

(define (opt-global-copy-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalCopyFacts (:consume)]) : OptGlobalCopyFacts
  (if (< index 0)
    tail
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [rest-facts : OptGlobalCopyFacts tail]
      [next-tail : OptGlobalCopyFacts
        (match instr
          [(ir.CompilerIrInstr.Mov dst src _)
            (if (and
              (opt-copy-safe-source? src)
              (not (opt-value-is-var? src dst)))
              (opt-global-copy-facts-prepend
                rest-facts
                (OptGlobalCopyFact.Fact dst src block-id (+ index 1)))
              rest-facts)]
          [_ rest-facts])]
      (opt-global-copy-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-copy-facts-from-instr-seq
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [tail : OptGlobalCopyFacts (:consume)]) : OptGlobalCopyFacts
  (opt-global-copy-facts-from-instr-seq-from
    block-id
    instrs.slots
    (- instrs.len 1)
    tail))

(define (opt-global-copy-facts-from-blocks
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]
  [tail : OptGlobalCopyFacts (:consume)]) : OptGlobalCopyFacts
  (match blocks
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [rest-facts : OptGlobalCopyFacts
          (opt-global-copy-facts-from-blocks
            (__tl-box-place rest)
            (+ block-id 1)
            tail)]
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-global-copy-facts-from-instr-seq block-id instrs rest-facts)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-copy-facts-from-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        block-id
        tail)]))

(define (opt-global-copy-facts-max-dst
  [facts : OptGlobalCopyFacts]
  [max-dst : i64]) : i64
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [count : i64 (opt_global_fact_vec.len (& items))]
    [index : i64 0]
    [highest : i64 max-dst]
    (begin
      (while (< index count)
        (match (array-ref slots index)
          [(OptGlobalDenseFact.Copy (OptGlobalCopyFact.Fact dst _ _ _))
            (begin
              (if (> dst highest)
                (set! highest dst)
                unit)
              (set! index (+ index 1)))]
          [_ (set! index (+ index 1))]))
      highest)))

(define (opt-global-copy-table-insert!
  [table : OptGlobalCopyFactTable]
  [fact : OptGlobalCopyFact (:consume)]) : unit
  (match fact
    [(OptGlobalCopyFact.Fact dst src def-block-id def-pos)
      (let
        [buckets : (__tl_dyn-array OptGlobalCopyFacts) table.buckets]
        (if (and (>= dst 0) (< dst (array-length buckets)))
          (opt_global_fact_vec.push
            (&mut (__tl-project-field (array-ref buckets dst) items))
            (OptGlobalDenseFact.Copy
              (OptGlobalCopyFact.Fact dst src def-block-id def-pos)))
          unit))]))

(define (opt-global-copy-table-insert-reversed!
  [table : OptGlobalCopyFactTable]
  [facts : OptGlobalCopyFacts]) : unit
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [count : i64 (opt_global_fact_vec.len (& items))]
    [index : i64 0]
    (while (< index count)
      (match (array-ref slots index)
        [(OptGlobalDenseFact.Copy
            (OptGlobalCopyFact.Fact dst src def-block-id def-pos))
          (begin
            (opt-global-copy-table-insert!
              table
              (OptGlobalCopyFact.Fact dst src def-block-id def-pos))
            (set! index (+ index 1)))]
        [_ (set! index (+ index 1))]))))

(define (opt-global-copy-table-from-facts [facts : OptGlobalCopyFacts]) : OptGlobalCopyFactTable
  (let
    [max-dst : i64 (opt-global-copy-facts-max-dst facts (- 0 1))]
    [capacity : i64
      (if (< max-dst 0)
        1
        (+ max-dst 1))]
    [buckets : (__tl_dyn-array OptGlobalCopyFacts)
      (array.make-array OptGlobalCopyFacts capacity)]
    [table : OptGlobalCopyFactTable (OptGlobalCopyFactTable buckets)]
    (begin
      (opt-global-copy-table-insert-reversed! table facts)
      table)))

(define (opt-global-pack-word-facts-from-words
  [group : i64]
  [block-id : i64]
  [def-pos : i64]
  [index : i64]
  [words : ir.CompilerIrValueList]
  [tail : OptGlobalPackWordFacts (:consume)]) : OptGlobalPackWordFacts
  (match words
    [(ir.CompilerIrValueList.Nil) tail]
    [(ir.CompilerIrValueList.Array seq)
      (opt-global-pack-word-facts-from-words
        group
        block-id
        def-pos
        index
        (ir.compiler-ir-value-seq-to-list seq)
        tail)]
    [(ir.CompilerIrValueList.Cons value rest)
      (opt-global-pack-word-facts-from-words
        group
        block-id
        def-pos
        (+ index 1)
        (__tl-box-place rest)
        (if (and
          (opt-copy-safe-source? value)
          (not (opt-value-is-var? value group)))
          (opt-global-pack-word-facts-prepend
            tail
            (OptGlobalPackWordFact.Fact group index value block-id def-pos))
          tail))]))

(define (opt-global-pack-word-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalPackWordFacts (:consume)]) : OptGlobalPackWordFacts
  (if (< index 0)
    tail
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [next-tail : OptGlobalPackWordFacts
        (match instr
          [(ir.CompilerIrInstr.Pack group words _)
            (opt-global-pack-word-facts-from-words
              group
              block-id
              (+ index 1)
              0
              words
              tail)]
          [_ tail])]
      (opt-global-pack-word-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-pack-word-facts-from-blocks
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]
  [tail : OptGlobalPackWordFacts (:consume)]) : OptGlobalPackWordFacts
  (match blocks
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [rest-facts : OptGlobalPackWordFacts
          (opt-global-pack-word-facts-from-blocks
            (__tl-box-place rest)
            (+ block-id 1)
            tail)]
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-global-pack-word-facts-from-instr-seq-from
              block-id
              instrs.slots
              (- instrs.len 1)
              rest-facts)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-pack-word-facts-from-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        block-id
        tail)]))

(define (opt-global-pack-word-facts-max-group
  [facts : OptGlobalPackWordFacts]
  [max-group : i64]) : i64
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [count : i64 (opt_global_fact_vec.len (& items))]
    [index : i64 0]
    [highest : i64 max-group]
    (begin
      (while (< index count)
        (match (array-ref slots index)
          [(OptGlobalDenseFact.PackWord
              (OptGlobalPackWordFact.Fact group _ _ _ _))
            (begin
              (if (> group highest)
                (set! highest group)
                unit)
              (set! index (+ index 1)))]
          [_ (set! index (+ index 1))]))
      highest)))

(define (opt-global-pack-word-table-insert!
  [table : OptGlobalPackWordFactTable]
  [fact : OptGlobalPackWordFact (:consume)]) : unit
  (match fact
    [(OptGlobalPackWordFact.Fact group index value def-block-id def-pos)
      (let
        [buckets : (__tl_dyn-array OptGlobalPackWordFacts) table.buckets]
        (if (and (>= group 0) (< group (array-length buckets)))
          (opt_global_fact_vec.push
            (&mut (__tl-project-field (array-ref buckets group) items))
            (OptGlobalDenseFact.PackWord
              (OptGlobalPackWordFact.Fact
                group
                index
                value
                def-block-id
                def-pos)))
          unit))]))

(define (opt-global-pack-word-table-insert-reversed!
  [table : OptGlobalPackWordFactTable]
  [facts : OptGlobalPackWordFacts]) : unit
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [count : i64 (opt_global_fact_vec.len (& items))]
    [scan : i64 0]
    (while (< scan count)
      (match (array-ref slots scan)
        [(OptGlobalDenseFact.PackWord
            (OptGlobalPackWordFact.Fact group index value def-block-id def-pos))
          (begin
            (opt-global-pack-word-table-insert!
              table
              (OptGlobalPackWordFact.Fact
                group
                index
                value
                def-block-id
                def-pos))
            (set! scan (+ scan 1)))]
        [_ (set! scan (+ scan 1))]))))

(define (opt-global-pack-word-table-from-facts [facts : OptGlobalPackWordFacts]) : OptGlobalPackWordFactTable
  (let
    [max-group : i64 (opt-global-pack-word-facts-max-group facts (- 0 1))]
    [capacity : i64
      (if (< max-group 0)
        1
        (+ max-group 1))]
    [buckets : (__tl_dyn-array OptGlobalPackWordFacts)
      (array.make-array OptGlobalPackWordFacts capacity)]
    [table : OptGlobalPackWordFactTable (OptGlobalPackWordFactTable buckets)]
    (begin
      (opt-global-pack-word-table-insert-reversed! table facts)
      table)))

(define (opt-global-pack-word-lookup-list
  [facts : OptGlobalPackWordFacts]
  [group : i64]
  [index : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : ir.CompilerIrMaybeValue
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [scan : i64 (- (opt_global_fact_vec.len (& items)) 1)]
    [result : ir.CompilerIrMaybeValue (ir.CompilerIrMaybeValue.No)]
    [found? : bool false]
    (begin
      (while (and (not found?) (>= scan 0))
        (match (array-ref slots scan)
          [(OptGlobalDenseFact.PackWord
              (OptGlobalPackWordFact.Fact
                found-group
                found-index
                value
                def-block-id
                def-pos))
            (begin
              (if (and
                (= found-group group)
                (= found-index index)
                (opt-global-fact-available?
                  def-block-id
                  def-pos
                  use-block-id
                  use-pos
                  doms))
                (begin
                  (set! result (ir.CompilerIrMaybeValue.Some (clone value)))
                  (set! found? true))
                unit)
              (set! scan (- scan 1)))]
          [_ (set! scan (- scan 1))]))
      result)))

(define (opt-global-pack-word-lookup
  [table : OptGlobalPackWordFactTable]
  [group : i64]
  [index : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : ir.CompilerIrMaybeValue
  (let
    [buckets : (__tl_dyn-array OptGlobalPackWordFacts) table.buckets]
    (if (and (>= group 0) (< group (array-length buckets)))
      (opt-global-pack-word-lookup-list
        (array-ref buckets group)
        group
        index
        doms
        use-block-id
        use-pos)
      (ir.CompilerIrMaybeValue.No))))

(define (opt-global-copy-lookup-list
  [facts : OptGlobalCopyFacts]
  [var : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : ir.CompilerIrMaybeValue
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [index : i64 (- (opt_global_fact_vec.len (& items)) 1)]
    [result : ir.CompilerIrMaybeValue (ir.CompilerIrMaybeValue.No)]
    [found? : bool false]
    (begin
      (while (and (not found?) (>= index 0))
        (match (array-ref slots index)
          [(OptGlobalDenseFact.Copy
              (OptGlobalCopyFact.Fact dst src def-block-id def-pos))
            (begin
              (if (and
                (= dst var)
                (opt-global-fact-available?
                  def-block-id
                  def-pos
                  use-block-id
                  use-pos
                  doms))
                (begin
                  (set! result (ir.CompilerIrMaybeValue.Some (clone src)))
                  (set! found? true))
                unit)
              (set! index (- index 1)))]
          [_ (set! index (- index 1))]))
      result)))

(define (opt-global-copy-lookup
  [table : OptGlobalCopyFactTable]
  [var : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : ir.CompilerIrMaybeValue
  (let
    [buckets : (__tl_dyn-array OptGlobalCopyFacts) table.buckets]
    (if (and (>= var 0) (< var (array-length buckets)))
      (opt-global-copy-lookup-list
        (array-ref buckets var)
        var
        doms
        use-block-id
        use-pos)
      (ir.CompilerIrMaybeValue.No))))

(define (opt-global-copy-resolve-depth
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : ir.CompilerIrValue]
  [remaining : i64]) : ir.CompilerIrValue
  (if (<= remaining 0)
    value
    (match value
      [(ir.CompilerIrValue.Var id)
        (match (opt-global-copy-lookup facts id doms use-block-id use-pos)
          [(ir.CompilerIrMaybeValue.Some replacement)
            (opt-global-copy-resolve-depth
              facts
              doms
              use-block-id
              use-pos
              replacement
              (- remaining 1))]
          [(ir.CompilerIrMaybeValue.No) value])]
      [_ value])))

(define (opt-global-copy-resolve
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (opt-global-copy-resolve-depth facts doms use-block-id use-pos value 8))

(define (opt-global-copy-resolve-mask
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (let
    [resolved : ir.CompilerIrValue
      (opt-global-copy-resolve facts doms use-block-id use-pos value)]
    (match resolved
      [(ir.CompilerIrValue.Var _) resolved]
      [_ value])))

;; --- wide-literal operand suppression ---------------------------------------
;;
;; x86-64 has exactly ONE instruction form that takes a 64-bit immediate:
;; `movabsq $K, %reg`. Every other operand position -- an ALU source, the value
;; a shift shifts, a compare's operand -- encodes at most a sign-extended
;; imm32, so a constant outside [-2^31, 2^31) placed there is not an immediate
;; at all: the backend must materialize it into a register AT THE USE, once per
;; execution of the instruction.
;;
;; That flips the usual sign of propagating a constant into an operand. The
;; defining `Mov v, K` is loop-invariant, so LICM hoists it to the preheader
;; where it costs one `movabsq` per loop ENTRY; folding the literal back into
;; the operand deletes that Mov and pays a `movabsq` per ITERATION instead --
;; and, when no register is free at the use, a spill/reload pair around the
;; scavenged scratch on top. Refusing the substitution keeps the hoisted Mov,
;; and it is not the worse choice even under pressure: a constant-valued Mov is
;; rematerializable rather than spillable (compiler-reg-remat-value?), and when
;; the allocator does leave it in memory the consumer reloads it in one
;; instruction -- the same one the folded form spent materializing it.
;;
;; Flagship: `opt-bit-test-mask-block` materializes its 64-bit window mask as
;; its own `Mov` precisely so that hoist and the two-register `bt` lowering can
;; happen (see the note there). Before this rule the global copy sweep folded
;; the literal straight back into the `Shr`, and lex_source's two classifier
;; sites each paid `movabsq $4899916392364504625` on every one of the ~2.27M
;; chain entries, one of them wrapped in a `movq %r9, 8(%rsp)` /
;; `movq 8(%rsp), %r9` spill pair. Keeping the Var costs the register-rich site
;; nothing at all (a bare `bt` against the hoisted register) and the
;; register-poor site one reload, which is why the `bt` lowering had to learn to
;; place a non-register-homed mask (compiler-backend-bit-test-load-mask) before
;; this rule was a win everywhere: -2,690,288 Ir on lex_source, every other
;; benchmark row unchanged.
;;
;; Scope: the LEFT operand of a BinOp only. The backend's own wide-constant
;; relief reads the RIGHT operand exclusively
;; (compiler-backend-const-hoist-instr-wide?, which hoists a wide RHS out of a
;; loop region), and several lowerings need the right operand to still BE a
;; literal to fire at all -- the div/mod magic-multiply expansion, shift by a
;; constant count, `imul $imm, r, r`. A LEFT literal unlocks no lowering in any
;; of them; it is materialized unconditionally, so suppressing it can only
;; remove work. This is why the rule is stated by operand position rather than
;; by loop position: a wide left literal is never encodable, whatever block it
;; lands in, and the position test needs no loop analysis at this point in the
;; pipeline.
;;
;; The suppression is skipped when the other operand is also a constant, so a
;; fully-constant expression still reaches the scalar folder and folds.
(define (opt-copy-operand-imm32-fits? [n : i64]) : bool
  (and (>= n (- 0 2147483648)) (<= n 2147483647)))

(define (opt-copy-wide-literal? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 n) (not (opt-copy-operand-imm32-fits? n))]
    [_ false]))

;; The scalar literals copy propagation is allowed to move
;; (`opt-copy-safe-source?` minus `Var`): if the other operand is one of these,
;; the instruction is fully constant and folding it is the whole point.
(define (opt-copy-scalar-literal? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.Unit) true]
    [_ false]))

;; `resolved` is what copy propagation would place in the left operand and
;; `other` what it would place in the right; returns the operand to emit.
;; `original` is returned only when it is still a Var (the Mov the refusal
;; keeps alive) -- an already-literal left operand is left exactly as written.
(define (opt-global-copy-keep-wide-left
  [original : ir.CompilerIrValue]
  [resolved : ir.CompilerIrValue]
  [other : ir.CompilerIrValue]) : ir.CompilerIrValue
  (if (and
    (opt-copy-wide-literal? resolved)
    (not (opt-copy-scalar-literal? other))
    (match original
      [(ir.CompilerIrValue.Var _) true]
      [_ false]))
    original
    resolved))

(define (opt-global-copy-subst-call-args-array
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [src : (__tl_dyn-array ir.CompilerIrValue)]
  [dst : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-global-copy-resolve
          facts
          doms
          use-block-id
          use-pos
          (array-ref src index)))
      (opt-global-copy-subst-call-args-array
        facts
        doms
        use-block-id
        use-pos
        src
        dst
        (+ index 1)))))

(define (opt-global-copy-subst-call-args
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrCallArgs.Nil)]
    [(ir.CompilerIrCallArgs.One value)
      (ir.CompilerIrCallArgs.One
        (opt-global-copy-resolve facts doms use-block-id use-pos value))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (opt-global-copy-resolve facts doms use-block-id use-pos a)
        (opt-global-copy-resolve facts doms use-block-id use-pos b))]
    [(ir.CompilerIrCallArgs.Array values)
      (let
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue (array-length values))]
        (begin
          (opt-global-copy-subst-call-args-array
            facts
            doms
            use-block-id
            use-pos
            values
            out
            0)
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-global-copy-resolve-spmd-value
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [class : ir.CompilerIrSpmdValueClass]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match class
    [(ir.CompilerIrSpmdValueClass.Uniform)
      (opt-global-copy-resolve facts doms use-block-id use-pos value)]
    [(ir.CompilerIrSpmdValueClass.Varying)
      (opt-global-copy-resolve-mask facts doms use-block-id use-pos value)]
    [(ir.CompilerIrSpmdValueClass.Mask)
      (opt-global-copy-resolve-mask facts doms use-block-id use-pos value)]))

(define (opt-global-copy-subst-spmd-call-arg
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [arg : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArg
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class value ty)
      (ir.CompilerIrSpmdCallArg.Arg
        class
        (opt-global-copy-resolve-spmd-value
          facts
          doms
          use-block-id
          use-pos
          class
          value)
        ty)]))

(define (opt-global-copy-subst-spmd-call-args-array
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [dst : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-global-copy-subst-spmd-call-arg
          facts
          doms
          use-block-id
          use-pos
          (array-ref src index)))
      (opt-global-copy-subst-spmd-call-args-array
        facts
        doms
        use-block-id
        use-pos
        src
        dst
        (+ index 1)))))

(define (opt-global-copy-subst-spmd-call-args
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]
  [args : ir.CompilerIrSpmdCallArgList]) : ir.CompilerIrSpmdCallArgList
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) ir.CompilerIrSpmdCallArgList.Nil]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (ir.CompilerIrSpmdCallArgList.Cons
        (opt-global-copy-subst-spmd-call-arg
          facts
          doms
          use-block-id
          use-pos
          arg)
        (box
          (opt-global-copy-subst-spmd-call-args
            facts
            doms
            use-block-id
            use-pos
            (__tl-box-place rest))))]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 seq.len]
        [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        [out : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
          (array.make-array ir.CompilerIrSpmdCallArg count)]
        (begin
          (opt-global-copy-subst-spmd-call-args-array
            facts
            doms
            use-block-id
            use-pos
            src
            out
            0)
          (ir.CompilerIrSpmdCallArgList.Array
            (ir.CompilerIrSpmdCallArgSeq out count))))]))

;; A phi input is read on its named predecessor edge. Resolve a copy using the
;; predecessor as the use block and a position after its final instruction.
;; This folds latch-local copies such as `%next = mov %step` directly into a
;; loop-header phi without relying on whole-function register pressure for the
;; allocator to coalesce them.
(define (opt-global-copy-subst-phi-inputs
  [facts : OptGlobalCopyFactTable]
  [doms : OptDomInfo]
  [uses : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-global-copy-subst-phi-inputs
        facts
        doms
        uses
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (match value
          [(ir.CompilerIrValue.Var var)
            ;; A multiply-used copy can be an intentional live-range split.
            ;; Forward only a single-use copy into its phi edge; this removes
            ;; redundant latch/arm copies without extending the source across
            ;; other outgoing edges or phi consumers.
            (if (and
              (>= var 0)
              (< var (array-length uses))
              (= (array-ref uses var) 1))
              (opt-global-copy-resolve
                facts
                doms
                (opt-global-block-id doms label)
                9223372036854775807
                value)
              value)]
          [_ value])
        label
        (opt-global-copy-subst-phi-inputs facts doms uses (__tl-box-place rest)))]))

(define (opt-global-copy-subst-instr
  [facts : OptGlobalCopyFactTable]
  [pack-facts : OptGlobalPackWordFactTable]
  [doms : OptDomInfo]
  [uses : (__tl_dyn-array i64)]
  [block-id : i64]
  [pos : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        dst
        (opt-global-copy-resolve facts doms block-id pos base)
        (opt-global-copy-resolve facts doms block-id pos offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-global-copy-resolve facts doms block-id pos ptr)
        (opt-global-copy-resolve facts doms block-id pos value)
        ty)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (ir.CompilerIrInstr.CopyBytes
        (opt-global-copy-resolve facts doms block-id pos dst)
        (opt-global-copy-resolve facts doms block-id pos src)
        size)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-global-copy-resolve facts doms block-id pos index)
        (opt-global-copy-resolve facts doms block-id pos length)
        ok-label)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (let
        [resolved-lhs : ir.CompilerIrValue
          (opt-global-copy-resolve facts doms block-id pos lhs)]
        [resolved-rhs : ir.CompilerIrValue
          (opt-global-copy-resolve facts doms block-id pos rhs)]
        (ir.CompilerIrInstr.BinOp
          dst
          op
          (opt-global-copy-keep-wide-left lhs resolved-lhs resolved-rhs)
          resolved-rhs
          ty))]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        dst
        op
        (opt-global-copy-resolve facts doms block-id pos src)
        ty)]
    [(ir.CompilerIrInstr.Splat dst src lanes ty)
      (ir.CompilerIrInstr.Splat
        dst
        (opt-global-copy-resolve facts doms block-id pos src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (ir.CompilerIrInstr.Call
        dst
        name
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirect dst func args ty)
      (ir.CompilerIrInstr.CallIndirect
        dst
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst func args ty)
      (ir.CompilerIrInstr.CallIndirectC
        dst
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-cabi-store-result
          (opt-global-copy-resolve facts doms block-id pos base)
          name
          (opt-global-copy-subst-call-args facts doms block-id pos args)
          slots))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-indirect-cabi-store-result
          (opt-global-copy-resolve facts doms block-id pos base)
          (opt-global-copy-resolve facts doms block-id pos func)
          (opt-global-copy-subst-call-args facts doms block-id pos args)
          slots))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (ir.ir-instr-spmd-call
          callee
          backend
          lanes
          (opt-global-copy-resolve-mask facts doms block-id pos active-mask)
          (opt-global-copy-subst-spmd-call-args facts doms block-id pos args)
          result))]
    [(ir.CompilerIrInstr.TailCall name args ty)
      (ir.CompilerIrInstr.TailCall
        name
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(ir.CompilerIrInstr.Store name value ty)
      (ir.CompilerIrInstr.Store
        name
        (opt-global-copy-resolve facts doms block-id pos value)
        ty)]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (ir.CompilerIrInstr.Branch
        (opt-global-copy-resolve facts doms block-id pos cond)
        true-label
        false-label)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (ir.CompilerIrInstr.TotalEnumBranch
        (opt-global-copy-resolve facts doms block-id pos cond)
        true-label
        false-label)]
    [(ir.CompilerIrInstr.Return maybe)
      (match maybe
        [(ir.CompilerIrMaybeValue.Some value)
          (ir.CompilerIrInstr.Return
            (ir.CompilerIrMaybeValue.Some
              (opt-global-copy-resolve facts doms block-id pos value)))]
        [(ir.CompilerIrMaybeValue.No) instr])]
    [(ir.CompilerIrInstr.EntryArgc _) instr]
    [(ir.CompilerIrInstr.EntryArgv _) instr]
    [(ir.CompilerIrInstr.EntryEnvp _) instr]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (ir.CompilerIrInstr.CpuId
        dst
        (opt-global-copy-resolve facts doms block-id pos leaf)
        (opt-global-copy-resolve facts doms block-id pos subleaf)
        reg-index)]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (ir.CompilerIrInstr.Xgetbv
        dst
        (opt-global-copy-resolve facts doms block-id pos index))]
    [(ir.CompilerIrInstr.Syscall dst args)
      (ir.CompilerIrInstr.Syscall
        dst
        (opt-global-copy-subst-call-args facts doms block-id pos args))]
    [(ir.CompilerIrInstr.VectorBinOp _) instr]
    [(ir.CompilerIrInstr.VectorPrefix _) instr]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) instr]
    [(ir.CompilerIrInstr.VectorCompare _) instr]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-global-copy-resolve-mask facts doms block-id pos lhs)
        (opt-global-copy-resolve-mask facts doms block-id pos rhs)
        lanes)]
    [(ir.CompilerIrInstr.MaskNot dst src lanes)
      (ir.CompilerIrInstr.MaskNot
        dst
        (opt-global-copy-resolve-mask facts doms block-id pos src)
        lanes)]
    [(ir.CompilerIrInstr.MaskReduce dst op src lanes)
      (ir.CompilerIrInstr.MaskReduce
        dst
        op
        (opt-global-copy-resolve-mask facts doms block-id pos src)
        lanes)]
    [(ir.CompilerIrInstr.Select _) instr]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) instr]
    [(ir.CompilerIrInstr.VectorStore _) instr]
    [(ir.CompilerIrInstr.PredicatedStore _) instr]
    [(ir.CompilerIrInstr.PredicatedLoad _) instr]
    [(ir.CompilerIrInstr.GatherLoad _) instr]
    [(ir.CompilerIrInstr.VectorShuffle _) instr]
    [(ir.CompilerIrInstr.TailMask _ _ _ _) instr]
    [(ir.CompilerIrInstr.AddrOf _ _) instr]
    [(ir.CompilerIrInstr.Alloc _ _) instr]
    [(ir.CompilerIrInstr.LaneId _ _ _) instr]
    [(ir.CompilerIrInstr.Jump _) instr]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        dst
        (opt-global-copy-subst-phi-inputs facts doms uses inputs)
        ty)]
    ;; Pack operands remain unchanged. A dominated Word of a known Pack becomes
    ;; an ordinary copy; the pass's second copy sweep forwards that copy into
    ;; all non-phi uses, and late DCE retires the dead Word/Pack chain.
    [(ir.CompilerIrInstr.Pack _ _ _) instr]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (match src
        [(ir.CompilerIrValue.Var group)
          (match (opt-global-pack-word-lookup
            pack-facts
            group
            index
            doms
            block-id
            pos)
            [(ir.CompilerIrMaybeValue.Some value)
              (ir.CompilerIrInstr.Mov dst value ty)]
            [(ir.CompilerIrMaybeValue.No) instr])]
        [_ instr])]
    [(ir.CompilerIrInstr.TailCallIndirect func args ty)
      (ir.CompilerIrInstr.TailCallIndirect
        (opt-global-copy-resolve facts doms block-id pos func)
        (opt-global-copy-subst-call-args facts doms block-id pos args)
        ty)]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        (opt-global-copy-resolve facts doms block-id pos index)
        base
        cases
        default-label)]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (opt-global-copy-resolve facts doms block-id pos index)
        base
        cases
        default-label
        trap-label)]))

;; 1:1 rewrite: the output has exactly the input's length, so it is built
;; straight into a right-sized dense array instead of a cons spine that
;; `compiler-ir-block` would then have to re-count and re-copy. The result is a
;; FRESH sequence and `instrs` is not touched, so this needs no unique-ownership
;; argument -- which matters, because the opt2 fixpoint driver
;; (optimize-function-pass-with-summaries) falls back to its INPUT function when
;; a round changes nothing, and the pipeline head can still alias it. refs #5726
(define (opt-global-copy-instr-seq
  [facts : OptGlobalCopyFactTable]
  [pack-facts : OptGlobalPackWordFactTable]
  [doms : OptDomInfo]
  [uses : (__tl_dyn-array i64)]
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref out index)
            (opt-global-copy-subst-instr
              facts
              pack-facts
              doms
              uses
              block-id
              (+ index 1)
              (array-ref slots index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

;; Every rewrite in this pass keeps the block sequence -- only block contents
;; change -- so the walk position stays the id `doms`'s index assigned.
(define (opt-global-copy-blocks
  [facts : OptGlobalCopyFactTable]
  [pack-facts : OptGlobalPackWordFactTable]
  [doms : OptDomInfo]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-global-copy-instr-seq
                facts
                pack-facts
                doms
                uses
                block-id
                instrs))
            (opt-global-copy-blocks
              facts
              pack-facts
              doms
              uses
              (__tl-box-place rest)
              (+ block-id 1)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-copy-blocks
        facts
        pack-facts
        doms
        uses
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-global-expr-facts-from-instr-seq-from
  [block-id : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [tail : OptGlobalExprFacts (:consume)]) : OptGlobalExprFacts
  (if (< index 0)
    tail
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [rest-facts : OptGlobalExprFacts tail]
      [next-tail : OptGlobalExprFacts
        (match (opt-global-key-for-instr instr)
          [(OptMaybeGlobalExprKey.Some key)
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (opt-global-expr-facts-prepend
                  rest-facts
                  (OptGlobalExprFact.Fact key dst block-id (+ index 1)))]
              [(option_i64.None) rest-facts])]
          [(OptMaybeGlobalExprKey.No) rest-facts])]
      (opt-global-expr-facts-from-instr-seq-from
        block-id
        slots
        (- index 1)
        next-tail))))

(define (opt-global-expr-facts-from-instr-seq
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [tail : OptGlobalExprFacts (:consume)]) : OptGlobalExprFacts
  (opt-global-expr-facts-from-instr-seq-from
    block-id
    instrs.slots
    (- instrs.len 1)
    tail))

(define (opt-global-expr-facts-from-blocks
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]
  [tail : OptGlobalExprFacts (:consume)]) : OptGlobalExprFacts
  (match blocks
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [rest-facts : OptGlobalExprFacts
          (opt-global-expr-facts-from-blocks
            (__tl-box-place rest)
            (+ block-id 1)
            tail)]
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-global-expr-facts-from-instr-seq block-id instrs rest-facts)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-expr-facts-from-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        block-id
        tail)]))

(define (opt-global-fact-bucket-capacity [count : i64]) : i64
  (let
    [target : i64
      (if (< count 1)
        1
        (* count 2))]
    [capacity : i64 1]
    (begin
      (while (< capacity target)
        (set! capacity (* capacity 2)))
      capacity)))

(define (opt-global-expr-bucket-index
  [type-segment-bases : i64]
  [buckets : (__tl_dyn-array OptGlobalExprFacts)]
  [key : OptGlobalExprKey]) : i64
  (bit-and
    (opt-global-expr-key-hash type-segment-bases key)
    (- (array-length buckets) 1)))

(define (opt-global-expr-table-insert!
  [type-segment-bases : i64]
  [table : OptGlobalExprFactTable]
  [fact : OptGlobalExprFact (:consume)]) : unit
  (match fact
    [(OptGlobalExprFact.Fact key dst def-block-id def-pos)
      (let
        [buckets : (__tl_dyn-array OptGlobalExprFacts) table.buckets]
        [bucket : i64
          (opt-global-expr-bucket-index type-segment-bases buckets key)]
        (opt_global_fact_vec.push
          (&mut (__tl-project-field (array-ref buckets bucket) items))
          (OptGlobalDenseFact.Expr
            (OptGlobalExprFact.Fact key dst def-block-id def-pos))))]))

(define (opt-global-expr-table-insert-reversed!
  [type-segment-bases : i64]
  [table : OptGlobalExprFactTable]
  [facts : OptGlobalExprFacts]) : unit
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [count : i64 (opt_global_fact_vec.len (& items))]
    [index : i64 0]
    (while (< index count)
      (match (array-ref slots index)
        [(OptGlobalDenseFact.Expr
            (OptGlobalExprFact.Fact key dst def-block-id def-pos))
          (begin
            (opt-global-expr-table-insert!
              type-segment-bases
              table
              (OptGlobalExprFact.Fact key dst def-block-id def-pos))
            (set! index (+ index 1)))]
        [_ (set! index (+ index 1))]))))

(define (opt-global-expr-table-from-facts
  [type-segment-bases : i64]
  [facts : OptGlobalExprFacts]) : OptGlobalExprFactTable
  (let
    [capacity : i64
      (opt-global-fact-bucket-capacity (opt-global-expr-facts-count facts))]
    [buckets : (__tl_dyn-array OptGlobalExprFacts)
      (array.make-array OptGlobalExprFacts capacity)]
    [table : OptGlobalExprFactTable (OptGlobalExprFactTable buckets)]
    (begin
      (opt-global-expr-table-insert-reversed! type-segment-bases table facts)
      table)))

(define (opt-global-expr-lookup-list
  [type-segment-bases : i64]
  [facts : OptGlobalExprFacts]
  [key : OptGlobalExprKey]
  [dst : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : ir.CompilerIrMaybeValue
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    [slots : (& items (__tl_dyn-array OptGlobalDenseFact))
      (opt_global_fact_vec.slots (& items))]
    [index : i64 (- (opt_global_fact_vec.len (& items)) 1)]
    [result : ir.CompilerIrMaybeValue (ir.CompilerIrMaybeValue.No)]
    [found? : bool false]
    (begin
      (while (and (not found?) (>= index 0))
        (match (array-ref slots index)
          [(OptGlobalDenseFact.Expr
              (OptGlobalExprFact.Fact fact-key fact-dst def-block-id def-pos))
            (begin
              (if (and
                (not (= fact-dst dst))
                (opt-global-expr-key-eq type-segment-bases fact-key key)
                (opt-global-fact-available?
                  def-block-id
                  def-pos
                  use-block-id
                  use-pos
                  doms))
                (begin
                  (set!
                    result
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.Var fact-dst)))
                  (set! found? true))
                unit)
              (set! index (- index 1)))]
          [_ (set! index (- index 1))]))
      result)))

(define (opt-global-expr-lookup
  [type-segment-bases : i64]
  [table : OptGlobalExprFactTable]
  [key : OptGlobalExprKey]
  [dst : i64]
  [doms : OptDomInfo]
  [use-block-id : i64]
  [use-pos : i64]) : ir.CompilerIrMaybeValue
  (let
    [buckets : (__tl_dyn-array OptGlobalExprFacts) table.buckets]
    (opt-global-expr-lookup-list
      type-segment-bases
      (array-ref
        buckets
        (opt-global-expr-bucket-index type-segment-bases buckets key))
      key
      dst
      doms
      use-block-id
      use-pos)))

(define (opt-global-cse-instr
  [type-segment-bases : i64]
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-id : i64]
  [pos : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match (opt-global-key-for-instr instr)
    [(OptMaybeGlobalExprKey.Some key)
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (match (opt-global-expr-lookup
            type-segment-bases
            facts
            key
            dst
            doms
            block-id
            pos)
            [(ir.CompilerIrMaybeValue.Some earlier)
              (match instr
                [(ir.CompilerIrInstr.Mov _ _ ty)
                  (ir.CompilerIrInstr.Mov dst earlier ty)]
                [(ir.CompilerIrInstr.Gep _ _ _ ty)
                  (ir.CompilerIrInstr.Mov dst earlier ty)]
                [(ir.CompilerIrInstr.Cast _ _ _ to-ty)
                  (ir.CompilerIrInstr.Mov dst earlier to-ty)]
                [(ir.CompilerIrInstr.BinOp _ op _ _ ty)
                  (ir.CompilerIrInstr.Mov
                    dst
                    earlier
                    (ir.compiler-ir-binop-result-type op ty))]
                [(ir.CompilerIrInstr.UnOp _ _ _ ty)
                  (ir.CompilerIrInstr.Mov dst earlier ty)]
                [_ instr])]
            [(ir.CompilerIrMaybeValue.No) instr])]
        [(option_i64.None) instr])]
    [(OptMaybeGlobalExprKey.No) instr]))

;; The late And-branch rewrite clones shared pure compares into its source and
;; fresh `__bool_and` blocks so both the original branch and the new guard edge
;; reach backend compare/branch fusion. On the next optimizer fixpoint
;; iteration, CSE must not merge those clones back into a dominating comparison
;; -- doing so recreates the setcc/test materialization the CFG rewrite removed.
(define (opt-bool-branch-chain-generated-label? [label : i64]) : bool
  (let
    [marker : String "__bool_and."]
    [text : String (ir.compiler-ir-label-text label)]
    (string.contains (& text) (& marker))))

(define (opt-bool-branch-chain-check-block?
  [block-label : i64]
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (if (opt-bool-branch-chain-generated-label? block-label)
    true
    (let
      [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
      (if (<= count 0)
        false
        (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
          [(ir.CompilerIrInstr.Branch _ true-label false-label)
            (or
              (opt-bool-branch-chain-generated-label? true-label)
              (opt-bool-branch-chain-generated-label? false-label))]
          [_ false])))))

(define (opt-global-cse-bool-chain-compare?
  [block-label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [instr : ir.CompilerIrInstr]) : bool
  (and
    (opt-bool-branch-chain-check-block? block-label instrs)
    (match instr
      [(ir.CompilerIrInstr.BinOp _ op _ _ _) (opt-bool-branch-compare-op? op)]
      [_ false])))

;; The x2 conditional-loop unroller emits address-only `i + 1` values in each
;; copy-1 block. Keeping those equivalent adds local to their own block lets
;; the backend prove that every use is a same-block Gep index and fold them to
;; SIB displacements. Cross-block CSE would merge them into one dominating add
;; and force the offset into a register again.
(define (opt-global-cse-unroll2-address-offset?
  [block-label : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (let
    [marker : String "__unroll2_1"]
    [text : String (ir.compiler-ir-label-text block-label)]
    (and
      (string.contains (& text) (& marker))
      (match instr
        [(ir.CompilerIrInstr.BinOp _ op _ rhs _)
          (and
            (match op
              [(ir.CompilerIrBinOp.Add) true]
              [_ false])
            (match rhs
              [(ir.CompilerIrValue.I64 n) (= n 1)]
              [_ false]))]
        [_ false]))))

;; 1:1 rewrite -> dense output sequence (see opt-global-copy-instr-seq). refs #5726
(define (opt-global-cse-instr-seq
  [type-segment-bases : i64]
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [block-label : i64]
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [instr : ir.CompilerIrInstr (array-ref slots index)]
          (begin
            (set!
              (array-ref out index)
              (if (or
                (opt-global-cse-bool-chain-compare? block-label instrs instr)
                (opt-global-cse-unroll2-address-offset? block-label instr))
                instr
                (opt-global-cse-instr
                  type-segment-bases
                  facts
                  doms
                  block-id
                  (+ index 1)
                  instr)))
            (set! index (+ index 1)))))
      (ir.CompilerIrInstrSeq out count))))

(define (opt-global-cse-blocks
  [type-segment-bases : i64]
  [facts : OptGlobalExprFactTable]
  [doms : OptDomInfo]
  [all-blocks : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (opt-induction-switch-arm? doms.index all-blocks label instrs)
              block
              (ir.CompilerIrBlock.Block
                label
                (opt-global-cse-instr-seq
                  type-segment-bases
                  facts
                  doms
                  label
                  block-id
                  instrs)))
            (opt-global-cse-blocks
              type-segment-bases
              facts
              doms
              all-blocks
              (__tl-box-place rest)
              (+ block-id 1)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-global-cse-blocks
        type-segment-bases
        facts
        doms
        all-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-global-value-number-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [doms : OptDomInfo context.doms]
    [copy-fact-list : OptGlobalCopyFacts
      (opt-global-copy-facts-from-blocks blocks 0 (opt-global-copy-facts-new))]
    [copy-facts : OptGlobalCopyFactTable
      (opt-global-copy-table-from-facts copy-fact-list)]
    [pack-word-fact-list : OptGlobalPackWordFacts
      (opt-global-pack-word-facts-from-blocks
        blocks
        0
        (opt-global-pack-word-facts-new))]
    [pack-word-facts : OptGlobalPackWordFactTable
      (opt-global-pack-word-table-from-facts pack-word-fact-list)]
    [uses : (__tl_dyn-array i64) (opt-collect-blocks-uses-array frame blocks)]
    [copied : ir.CompilerIrBlockList
      (opt-global-copy-blocks copy-facts pack-word-facts doms uses blocks 0)]
    [expr-fact-list : OptGlobalExprFacts
      (opt-global-expr-facts-from-blocks copied 0 (opt-global-expr-facts-new))]
    [expr-facts : OptGlobalExprFactTable
      (opt-global-expr-table-from-facts type-segment-bases expr-fact-list)]
    [cse : ir.CompilerIrBlockList
      (opt-global-cse-blocks type-segment-bases expr-facts doms copied copied 0)]
    [cse-copy-fact-list : OptGlobalCopyFacts
      (opt-global-copy-facts-from-blocks cse 0 (opt-global-copy-facts-new))]
    [cse-copy-facts : OptGlobalCopyFactTable
      (opt-global-copy-table-from-facts cse-copy-fact-list)]
    [cse-uses : (__tl_dyn-array i64) (opt-collect-blocks-uses-array frame cse)]
    (opt-global-copy-blocks cse-copy-facts pack-word-facts doms cse-uses cse 0)))

(define (opt-global-value-number-function-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  ;; The opt2 pipeline threads the loop-cluster verification through
  ;; `verified?`: every cluster pass post-verifies its own rewrite (falling
  ;; back to its verified input on rejection), so a verified cluster input
  ;; reaches this pass still verified and the entry verify is skipped.
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (ir.CompilerIrFunction.Function
            name
            params
            ret-ty
            frame
            (opt-global-value-number-blocks-with-context
              type-segment-bases
              context
              frame
              blocks))])]
    [(ResultCompilerOptimizeVerify.Err _) func]))

(define (opt-global-value-number-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-global-value-number-function-with-context
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)]))

(define (opt-cfg-foldable-branch-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Branch cond _ _)
      (match cond
        [(ir.CompilerIrValue.Bool _) true]
        [_ false])]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (match cond
        [(ir.CompilerIrValue.Bool _) true]
        [_ false])]
    [_ false]))

(define (opt-cfg-foldable-branch-instr-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-cfg-foldable-branch-instr?
      (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-cfg-foldable-branch-instr-seq? instrs (+ index 1)))))

(define (opt-cfg-foldable-branch-block? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-cfg-foldable-branch-instr-seq? instrs 0)]))

(define (opt-cfg-blocks-have-foldable-branch? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-cfg-foldable-branch-block? block)
        true
        (opt-cfg-blocks-have-foldable-branch? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-blocks-have-foldable-branch?
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-fold-branch [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (match cond
        [(ir.CompilerIrValue.Bool known)
          (if known
            (ir.CompilerIrInstr.Jump true-label)
            (ir.CompilerIrInstr.Jump false-label))]
        [_ instr])]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (match cond
        [(ir.CompilerIrValue.Bool known)
          (if known
            (ir.CompilerIrInstr.Jump true-label)
            (ir.CompilerIrInstr.Jump false-label))]
        [_ instr])]
    [_ instr]))

;; 1:1 rewrite -> dense output sequence (see opt-global-copy-instr-seq). The
;; in-place twin below (-instr-seq-rewrite!) stays reserved for the opt1 path,
;; which owns its blocks; this form is the one the opt2 fixpoint can use,
;; because it leaves its input alone. refs #5726
(define (opt-cfg-fold-branches-instr-seq [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref out index)
            (opt-cfg-fold-branch (array-ref slots index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

(define (opt-cfg-fold-branches-block [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block label (opt-cfg-fold-branches-instr-seq instrs))]))

(define (opt-cfg-fold-branches-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-cfg-fold-branches-block block)
        (opt-cfg-fold-branches-blocks (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-fold-branches-blocks (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-fold-branches-instr-seq-rewrite!
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (begin
        (ir.compiler-ir-instr-seq-set!
          instrs
          index
          (opt-cfg-fold-branch (ir.compiler-ir-instr-seq-ref instrs index)))
        (set! index (+ index 1))))))

(define (opt-cfg-fold-branches-block-seq-rewrite!
  [blocks : ir.CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    (while (< index count)
      (begin
        (match (ir.compiler-ir-block-seq-ref blocks index)
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-cfg-fold-branches-instr-seq-rewrite! instrs)])
        (set! index (+ index 1))))))

(define (opt-cfg-fold-branches-blocks-rewrite!
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-cfg-fold-branches-instr-seq-rewrite! instrs)])
        (opt-cfg-fold-branches-blocks-rewrite! (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-fold-branches-block-seq-rewrite! seq)]))

(define (opt-cfg-instr-successors
  [set : OptLabelSet]
  [instr : ir.CompilerIrInstr]) : OptLabelSet
  (match instr
    [(ir.CompilerIrInstr.Jump label) (opt-label-add set label)]
    [(ir.CompilerIrInstr.Branch _ true-label false-label)
      (opt-label-add (opt-label-add set true-label) false-label)]
    [(ir.CompilerIrInstr.TotalEnumBranch _ true-label false-label)
      (opt-label-add (opt-label-add set true-label) false-label)]
    [(ir.CompilerIrInstr.Switch _ _ cases default-label)
      (opt-cfg-switch-case-successors (opt-label-add set default-label) cases)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ cases default-label _)
      (opt-cfg-switch-case-successors (opt-label-add set default-label) cases)]
    [_ set]))

;; Above this many cases, dedup through a hash set instead of `opt-label-add`'s
;; linear `string.eq` scan. `opt-label-add` prepends only on first occurrence, so
;; seeding the seen-set from `set` and applying the same first-occurrence rule
;; reproduces the identical list, order included. Small switches keep the linear
;; path: seeding and allocating a map is not worth it for a handful of arms, and
;; leaving them alone keeps their output trivially unchanged.
(define (opt-cfg-switch-case-hash-threshold) : i64
  16)

(define (opt-cfg-switch-seen-seed
  [set : OptLabelSet]
  [seen : opt_string_i64_map.Map (:consume)]) : opt_string_i64_map.Map
  (match set
    [(OptLabelSet.Nil) seen]
    [(OptLabelSet.Dense _ _)
      (begin
        (opt_string_i64_map.insert-ref! (&mut seen) (opt-label-ref set 0) 1)
        (opt-cfg-switch-seen-seed (opt-label-tail set) seen))]))

(define (opt-cfg-switch-case-successors-hashed
  [set : OptLabelSet]
  [cases : ir.CompilerIrSwitchCaseList]
  [seen : opt_string_i64_map.Map (:consume)]) : OptLabelSet
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil) set]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ label)
          (if (opt_string_i64_map.contains? (& seen) label)
            (opt-cfg-switch-case-successors-hashed
              set
              (__tl-box-place rest)
              seen)
            (begin
              (opt_string_i64_map.insert-ref! (&mut seen) label 1)
              (opt-cfg-switch-case-successors-hashed
                (opt-label-cons label set)
                (__tl-box-place rest)
                seen)))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-cfg-switch-case-successors-hashed
        set
        (ir.compiler-ir-switch-case-seq-to-list seq)
        seen)]))

(define (opt-cfg-switch-case-successors-linear
  [set : OptLabelSet]
  [cases : ir.CompilerIrSwitchCaseList]) : OptLabelSet
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil) set]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ label)
          (opt-cfg-switch-case-successors-linear
            (opt-label-add set label)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-cfg-switch-case-successors-linear
        set
        (ir.compiler-ir-switch-case-seq-to-list seq))]))

(define (opt-cfg-switch-case-successors
  [set : OptLabelSet]
  [cases : ir.CompilerIrSwitchCaseList]) : OptLabelSet
  (if (<
    (ir.compiler-ir-switch-case-list-count cases)
    (opt-cfg-switch-case-hash-threshold))
    (opt-cfg-switch-case-successors-linear set cases)
    (opt-cfg-switch-case-successors-hashed
      set
      cases
      (opt-cfg-switch-seen-seed set (opt_string_i64_map.with-capacity 64)))))

;; Only the five label-bearing forms above contribute an edge; every other
;; instruction returns `set` unchanged. This walk therefore tests the variant tag
;; in place -- one load off the instruction slot, no call, no label-set copy --
;; and enters `opt-cfg-instr-successors` only for the forms whose arms it
;; actually has. The arm list here is that function's arm list, so the fold is
;; unchanged; skipping a non-bearing instruction skips only an identity step.
;; Blocks average under eight instructions and about one in twelve bears an edge,
;; so the call was overwhelmingly paid to be told "nothing".
(define (opt-cfg-instr-seq-successors
  [set : OptLabelSet]
  [instrs : ir.CompilerIrInstrSeq]) : OptLabelSet
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : OptLabelSet set]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.Jump _)
              (set! out (opt-cfg-instr-successors out (array-ref slots index)))]
            [(ir.CompilerIrInstr.Branch _ _ _)
              (set! out (opt-cfg-instr-successors out (array-ref slots index)))]
            [(ir.CompilerIrInstr.TotalEnumBranch _ _ _)
              (set! out (opt-cfg-instr-successors out (array-ref slots index)))]
            [(ir.CompilerIrInstr.Switch _ _ _ _)
              (set! out (opt-cfg-instr-successors out (array-ref slots index)))]
            [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _)
              (set! out (opt-cfg-instr-successors out (array-ref slots index)))]
            [_ unit])
          (set! index (+ index 1))))
      out)))

(define (opt-cfg-terminator-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Return _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(ir.CompilerIrInstr.Switch _ _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
    [_ false]))

(define (opt-cfg-instr-seq-can-fallthrough? [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [count : i64 instrs.len]
    (if (= count 0)
      true
      (not (opt-cfg-terminator-instr? (array-ref instrs.slots (- count 1)))))))

(define (opt-cfg-block-successors-with-next
  [block : ir.CompilerIrBlock]
  [next-label : i64]) : OptLabelSet
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [explicit : OptLabelSet
          (opt-cfg-instr-seq-successors (OptLabelSet.Nil) instrs)]
        (if (and
          (ir.compiler-ir-label-some? next-label)
          (opt-cfg-instr-seq-can-fallthrough? instrs))
          (opt-label-add explicit next-label)
          explicit))]))

(define (opt-cfg-blocks-successors-scan
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : OptLabelSet
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptLabelSet.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label _)
          (if (= block-label label)
            (opt-cfg-block-successors-with-next
              block
              (opt-cfg-entry-label (__tl-box-place rest)))
            (opt-cfg-blocks-successors-scan (__tl-box-place rest) label))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-blocks-successors-scan
        (ir.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-cfg-reachable-blocks [blocks : ir.CompilerIrBlockList]) : OptLabelSet
  (opt-cfg-index-reachable-labels (opt-cfg-index-build blocks)))

(defenum OptLoopPreheader
  (No)
  (Some i64))

(defenum OptLoopPreheaderCandidate
  (None)
  (One i64)
  (Many))

(defstruct OptLoopBody
  (labels OptLabelSet)
  (members (__tl_dyn-array bool))
  (blocks ir.CompilerIrBlockList))

(defenum OptNaturalLoop
  (Loop i64 i64 OptLoopBody OptLoopPreheader))

(defenum OptMaybeNaturalLoop
  (No)
  (Some OptNaturalLoop))

(defenum OptNaturalLoopList
  (Nil)
  (Cons OptNaturalLoop (Box OptNaturalLoopList)))

(defenum OptNaturalLoopCollectState
  (State OptLabelSet OptLabelSet))

(define (opt-loop-body-fill-members!
  [index : OptCfgIndex]
  [members : (__tl_dyn-array bool)]
  [labels : OptLabelSet]) : unit
  (match labels
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (begin
        (match (opt-cfg-index-id index (opt-label-ref labels 0))
          [(option_i64.Some id)
            (if (and (>= id 0) (< id (array-length members)))
              (set! (array-ref members id) true)
              unit)]
          [(option_i64.None) unit])
        (opt-loop-body-fill-members! index members (opt-label-tail labels)))]))

(define (opt-loop-body-member-array-contains-id?
  [members : (__tl_dyn-array bool)]
  [id : i64]) : bool
  (if (and (>= id 0) (< id (array-length members)))
    (array-ref members id)
    false))

;; `blocks` is the list `index` was built from, so the walk position is the
;; block id. `opt-loop-body-member-array-contains-id?` range-checks it, which is
;; what the old missing-label arm did.
(define (opt-loop-body-blocks-from
  [members : (__tl_dyn-array bool)]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ _)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-loop-body-blocks-from
                members
                (__tl-box-place rest)
                (+ block-id 1))]
            (if (opt-loop-body-member-array-contains-id? members block-id)
              (ir.compiler-ir-block-cons block tail)
              tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-body-blocks-from
        members
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-loop-body-build
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [labels : OptLabelSet]) : OptLoopBody
  (let
    [members : (__tl_dyn-array bool)
      (array.make-array bool (opt-cfg-index-block-count index))]
    (begin
      (opt-loop-body-fill-members! index members labels)
      (OptLoopBody labels members (opt-loop-body-blocks-from members blocks 0)))))

(define (opt-loop-body-labels [body : OptLoopBody]) : OptLabelSet
  body.labels)

(define (opt-loop-body-blocks [body : OptLoopBody]) : ir.CompilerIrBlockList
  body.blocks)

(define (opt-loop-body-contains-id? [body : OptLoopBody] [id : i64]) : bool
  (opt-loop-body-member-array-contains-id? body.members id))

(define (opt-loop-body-members [body : OptLoopBody]) : (__tl_dyn-array bool)
  body.members)

(define (opt-loop-body-label-member?
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [label : i64]) : bool
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (opt-loop-body-contains-id? body id)]
    [(option_i64.None) false]))

(define (opt-loop-body-current-blocks-from
  [body : OptLoopBody]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ _)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-loop-body-current-blocks-from
                body
                (__tl-box-place rest)
                (+ block-id 1))]
            (if (opt-loop-body-contains-id? body block-id)
              (ir.compiler-ir-block-cons block tail)
              tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-body-current-blocks-from
        body
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-natural-loop-header [loop : OptNaturalLoop]) : i64
  (match loop
    [(OptNaturalLoop.Loop header _ _ _) header]))

(define (opt-natural-loop-latch [loop : OptNaturalLoop]) : i64
  (match loop
    [(OptNaturalLoop.Loop _ latch _ _) latch]))

(define (opt-natural-loop-body-info [loop : OptNaturalLoop]) : OptLoopBody
  (match loop
    [(OptNaturalLoop.Loop _ _ body _) body]))

(define (opt-natural-loop-body [loop : OptNaturalLoop]) : OptLabelSet
  (match loop
    [(OptNaturalLoop.Loop _ _ body _) (opt-loop-body-labels body)]))

(define (opt-natural-loop-body-blocks [loop : OptNaturalLoop]) : ir.CompilerIrBlockList
  (opt-loop-body-blocks (opt-natural-loop-body-info loop)))

(define (opt-natural-loop-body-contains-id? [loop : OptNaturalLoop] [id : i64]) : bool
  (opt-loop-body-contains-id? (opt-natural-loop-body-info loop) id))

;; The body's per-block-id membership bits, for callers that want to test many
;; ids against one loop without rebuilding the block list.
(define (opt-natural-loop-body-members [loop : OptNaturalLoop]) : (__tl_dyn-array
    bool)
  (opt-loop-body-members (opt-natural-loop-body-info loop)))

(define (opt-natural-loop-current-body-blocks
  [loop : OptNaturalLoop]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-loop-body-current-blocks-from (opt-natural-loop-body-info loop) blocks 0))

(define (opt-natural-loop-preheader [loop : OptNaturalLoop]) : OptLoopPreheader
  (match loop
    [(OptNaturalLoop.Loop _ _ _ preheader) preheader]))

(define (opt-natural-loop-list-count [loops : OptNaturalLoopList]) : i64
  (match loops
    [(OptNaturalLoopList.Nil) 0]
    [(OptNaturalLoopList.Cons _ rest)
      (+ 1 (opt-natural-loop-list-count (__tl-box-place rest)))]))

(define (opt-natural-loop-find
  [loops : OptNaturalLoopList]
  [header : i64]
  [latch : i64]) : OptMaybeNaturalLoop
  (match loops
    [(OptNaturalLoopList.Nil) (OptMaybeNaturalLoop.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (if (and
        (= (opt-natural-loop-header loop) header)
        (= (opt-natural-loop-latch loop) latch))
        (OptMaybeNaturalLoop.Some loop)
        (opt-natural-loop-find (__tl-box-place rest) header latch))]))

;; Membership during body collection is an O(1) id-indexed marks
;; array (the body/worklist LISTS keep their exact construction order, so
;; downstream output is byte-identical); reachability reads the CFG index's
;; bool array instead of scanning the label list.
(define (opt-natural-loop-collect-add-pred
  [index : OptCfgIndex]
  [marks : (__tl_dyn-array bool)]
  [state : OptNaturalLoopCollectState]
  [pred : i64]) : OptNaturalLoopCollectState
  (match state
    [(OptNaturalLoopCollectState.State body worklist)
      (match (opt-cfg-index-id index pred)
        [(option_i64.Some pred-id)
          (if (and
            (array-ref index.reachable pred-id)
            (not (array-ref marks pred-id)))
            (begin
              (set! (array-ref marks pred-id) true)
              ;; `marks` is the authoritative dedup here: it is seeded with the
              ;; header and the latch, this branch runs only when
              ;; `marks[pred-id]` is clear, and it is set immediately above. So
              ;; `pred` is provably absent from both sets and `opt-label-add`'s
              ;; `string.eq` membership scan always returns false. Prepending
              ;; directly builds the identical lists and drops an O(body^2)
              ;; scan per natural loop.
              (OptNaturalLoopCollectState.State
                (opt-label-cons pred body)
                (opt-label-cons pred worklist)))
            state)]
        [(option_i64.None) state])]))

(define (opt-natural-loop-collect-add-preds
  [index : OptCfgIndex]
  [marks : (__tl_dyn-array bool)]
  [preds : OptLabelSet]
  [state : OptNaturalLoopCollectState]) : OptNaturalLoopCollectState
  (match preds
    [(OptLabelSet.Nil) state]
    [(OptLabelSet.Dense _ _)
      (opt-natural-loop-collect-add-preds
        index
        marks
        (opt-label-tail preds)
        (opt-natural-loop-collect-add-pred
          index
          marks
          state
          (opt-label-ref preds 0)))]))

(define (opt-natural-loop-collect-body
  [pred-map : OptPredMap]
  [index : OptCfgIndex]
  [marks : (__tl_dyn-array bool)]
  [body : OptLabelSet]
  [worklist : OptLabelSet]) : OptLabelSet
  (match worklist
    [(OptLabelSet.Nil) body]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref worklist 0)]
        [state : OptNaturalLoopCollectState
          (opt-natural-loop-collect-add-preds
            index
            marks
            (opt-pred-map-lookup pred-map label)
            (OptNaturalLoopCollectState.State body (opt-label-tail worklist)))]
        (match state
          [(OptNaturalLoopCollectState.State next-body next-worklist)
            (opt-natural-loop-collect-body
              pred-map
              index
              marks
              next-body
              next-worklist)]))]))

(define (opt-natural-loop-mark-label!
  [index : OptCfgIndex]
  [marks : (__tl_dyn-array bool)]
  [label : i64]) : unit
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id) (set! (array-ref marks id) true)]
    [(option_i64.None) unit]))

(define (opt-natural-loop-safe-preheader-block?
  [pred-map : OptPredMap]
  [label : i64]
  [header : i64]) : bool
  (let
    [successors : OptLabelSet (opt-pred-map-successors pred-map label)]
    (and
      (= (opt-label-count successors) 1)
      (opt-label-contains successors header))))

(define (opt-natural-loop-preheader-candidate-add
  [pred-map : OptPredMap]
  [header : i64]
  [candidate : OptLoopPreheaderCandidate]
  [pred : i64]) : OptLoopPreheaderCandidate
  (match candidate
    [(OptLoopPreheaderCandidate.Many) (OptLoopPreheaderCandidate.Many)]
    [(OptLoopPreheaderCandidate.None)
      (if (opt-natural-loop-safe-preheader-block? pred-map pred header)
        (OptLoopPreheaderCandidate.One pred)
        (OptLoopPreheaderCandidate.Many))]
    [(OptLoopPreheaderCandidate.One _) (OptLoopPreheaderCandidate.Many)]))

(define (opt-natural-loop-preheader-candidate-scan
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : i64]
  [body : OptLabelSet]
  [preds : OptLabelSet]
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheaderCandidate
  (match preds
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (if (and
          (opt-label-contains reachable pred)
          (not (opt-label-contains body pred)))
          (opt-natural-loop-preheader-candidate-scan
            pred-map
            reachable
            header
            body
            (opt-label-tail preds)
            (opt-natural-loop-preheader-candidate-add
              pred-map
              header
              candidate
              pred))
          (opt-natural-loop-preheader-candidate-scan
            pred-map
            reachable
            header
            body
            (opt-label-tail preds)
            candidate)))]))

(define (opt-natural-loop-preheader-from-candidate
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheader
  (match candidate
    [(OptLoopPreheaderCandidate.One label) (OptLoopPreheader.Some label)]
    [_ (OptLoopPreheader.No)]))

(define (opt-natural-loop-find-preheader
  [_blocks : ir.CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : i64]
  [body : OptLabelSet]) : OptLoopPreheader
  (opt-natural-loop-preheader-from-candidate
    (opt-natural-loop-preheader-candidate-scan
      pred-map
      reachable
      header
      body
      (opt-pred-map-lookup pred-map header)
      (OptLoopPreheaderCandidate.None))))

(define (opt-natural-loop-build
  [blocks : ir.CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [header : i64]
  [latch : i64]) : OptNaturalLoop
  (let
    [index : OptCfgIndex pred-map.index]
    [marks : (__tl_dyn-array bool)
      (array.make-array bool (opt-cfg-index-block-count index))]
    [_seed-header : unit (opt-natural-loop-mark-label! index marks header)]
    [_seed-latch : unit (opt-natural-loop-mark-label! index marks latch)]
    ;; #M-E: a self-loop (latch == header) has body {header}. Seeding the
    ;; worklist with the latch unconditionally walked the HEADER's own
    ;; predecessors, pulling the outside guard block into the body -- which
    ;; left every rotated single-block loop with zero outside predecessors, so
    ;; preheader detection AND synthesis failed and LICM/induction never ran
    ;; on them. The classic algorithm only expands predecessors of body nodes
    ;; other than the header.
    [body-labels : OptLabelSet
      (opt-natural-loop-collect-body
        pred-map
        index
        marks
        (opt-label-add (opt-label-add (OptLabelSet.Nil) header) latch)
        (if (= header latch)
          (OptLabelSet.Nil)
          (opt-label-add (OptLabelSet.Nil) latch)))]
    [body : OptLoopBody (opt-loop-body-build blocks pred-map.index body-labels)]
    (OptNaturalLoop.Loop
      header
      latch
      body
      (opt-natural-loop-find-preheader
        blocks
        pred-map
        reachable
        header
        body-labels))))

;; `remaining` starts as the very block list `doms`'s index was built from, and
;; `opt-cfg-index-build` numbers blocks in this walk order, so `source-id` is the
;; walk position. The range guard replaces the old missing-label arm: an id past
;; the indexed block count is exactly the case a label lookup would have missed.
;; Edges come from that same index's successor CSR row instead of re-deriving the
;; block's successor label set from its instruction stream -- see the row-order
;; note on `opt-cfg-natural-loop-edges-csr`; this walk consumes the row exactly
;; as the Array walk below does.
(define (opt-cfg-natural-loop-blocks
  [all-blocks : ir.CompilerIrBlockList]
  [remaining : ir.CompilerIrBlockList]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [source-id : i64]) : OptNaturalLoopList
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (OptNaturalLoopList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            [tail : OptNaturalLoopList
              (opt-cfg-natural-loop-blocks
                all-blocks
                (__tl-box-place rest)
                pred-map
                reachable
                doms
                (+ source-id 1))]
            [index : OptCfgIndex doms.index]
            [reachable-ids : (__tl_dyn-array bool) index.reachable]
            (if (and
              (< source-id (array-length reachable-ids))
              (array-ref reachable-ids source-id))
              (opt-cfg-natural-loop-edges-csr
                all-blocks
                index
                pred-map
                reachable
                doms
                source-id
                label
                (array-ref index.succs.offsets source-id)
                (array-ref index.succs.offsets (+ source-id 1))
                tail)
              tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-natural-loop-blocks
        all-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        pred-map
        reachable
        doms
        source-id)]))

;; Back-edge scan for one block, reading its successors from the context's CSR
;; index instead of recomputing the block's successor set from its instruction
;; stream. The CSR row holds exactly the deduplicated
;; opt-cfg-block-successors-with-next set in reverse insertion order
;; (opt-label-add prepends; opt-cfg-index-label-set-to-ids keeps label-set order
;; and drops labels the index cannot resolve -- precisely the old missing-label
;; arm; opt-cfg-csr-fill-rows! reverses the row), so visiting blocks from last to
;; first and each CSR row forward while front-consing emits loops in precisely
;; the order the label-set walk produced. Reachability and ids come from the same
;; index that walk consulted (the reachable set is built from this reachable
;; array).
(define (opt-cfg-natural-loop-edges-csr
  [all-blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [source-id : i64]
  [source : i64]
  [edge : i64]
  [end : i64]
  [acc : OptNaturalLoopList]) : OptNaturalLoopList
  (if (>= edge end)
    acc
    (let
      [header-id : i64 (array-ref index.succs.edges edge)]
      [next-acc : OptNaturalLoopList
        (if (and (>= header-id 0) (< header-id (array-length index.reachable)))
          (if (and
            (array-ref index.reachable header-id)
            (opt-dom-info-dominates-id? doms header-id source-id))
            (OptNaturalLoopList.Cons
              (opt-natural-loop-build
                all-blocks
                pred-map
                reachable
                (array-ref index.labels header-id)
                source)
              (box acc))
            acc)
          acc)]
      (opt-cfg-natural-loop-edges-csr
        all-blocks
        index
        pred-map
        reachable
        doms
        source-id
        source
        (+ edge 1)
        end
        next-acc))))

(define (opt-cfg-natural-loop-block-seq-csr
  [all-blocks : ir.CompilerIrBlockList]
  [seq : ir.CompilerIrBlockSeq]
  [pos : i64]
  [context : OptCfgContext]
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [acc : OptNaturalLoopList]) : OptNaturalLoopList
  (if (< pos 0)
    acc
    (match (ir.compiler-ir-block-seq-ref seq pos)
      [(ir.CompilerIrBlock.Block label _)
        (let
          [index : OptCfgIndex context.index]
          ;; `blocks` is this seq, and the index numbers its blocks in seq
          ;; order, so the seq position is the block id.
          [next-acc : OptNaturalLoopList
            (if (< pos (array-length index.reachable))
              (opt-cfg-natural-loop-edges-csr
                all-blocks
                index
                pred-map
                reachable
                doms
                pos
                label
                (array-ref index.succs.offsets pos)
                (array-ref index.succs.offsets (+ pos 1))
                acc)
              acc)]
          (opt-cfg-natural-loop-block-seq-csr
            all-blocks
            seq
            (- pos 1)
            context
            pred-map
            reachable
            doms
            next-acc))])))

(define (opt-cfg-natural-loops-with-context
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]) : OptNaturalLoopList
  (match blocks
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-natural-loop-block-seq-csr
        blocks
        seq
        (- (ir.compiler-ir-block-seq-count seq) 1)
        context
        context.pred-map
        context.reachable
        context.doms
        (OptNaturalLoopList.Nil))]
    [_
      (opt-cfg-natural-loop-blocks
        blocks
        blocks
        context.pred-map
        context.reachable
        context.doms
        0)]))

(define (opt-cfg-natural-loops [blocks : ir.CompilerIrBlockList]) : OptNaturalLoopList
  (opt-cfg-natural-loops-with-context blocks (opt-cfg-context-build blocks)))

;; --- safe loop preheader synthesis ------------------------------------------
;;
;; LICM and induction only operate on loops with a dedicated outside predecessor
;; whose only successor is the loop header. This pass creates that block for
;; conservative natural loops and falls back to the original function if the
;; verifier rejects the result.
(defenum OptLoopPreheadersPhiRewriteResult
  (Result ir.CompilerIrPhiInputList bool))

(define (opt-loop-preheaders-outside-preds-scan
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [header : i64]
  [body : OptLabelSet]
  [preds : OptLabelSet]) : OptLabelSet
  (match preds
    [(OptLabelSet.Nil) (OptLabelSet.Nil)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        [tail : OptLabelSet
          (opt-loop-preheaders-outside-preds-scan
            reachable
            doms
            header
            body
            (opt-label-tail preds))]
        (if (and
          (opt-label-contains reachable pred)
          (not (opt-label-contains body pred))
          (not (opt-dom-dominates? doms header pred)))
          (opt-label-add tail pred)
          tail))]))

(define (opt-loop-preheaders-outside-preds
  [pred-map : OptPredMap]
  [reachable : OptLabelSet]
  [doms : OptDomInfo]
  [header : i64]
  [body : OptLabelSet]) : OptLabelSet
  (opt-loop-preheaders-outside-preds-scan
    reachable
    doms
    header
    body
    (opt-pred-map-lookup pred-map header)))

(define (opt-loop-preheaders-candidate-label [header : i64] [suffix : i64]) : i64
  (ir.compiler-ir-label
    (if (= suffix 0)
      (str_cat.str-cat (ir.compiler-ir-label-text header) "__preheader")
      (str_cat.str-cat
        (ir.compiler-ir-label-text header)
        "__preheader"
        (string.int->string suffix)))))

(define (opt-loop-preheaders-fresh-label
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [suffix : i64]) : i64
  (let
    [candidate : i64 (opt-loop-preheaders-candidate-label header suffix)]
    (if (opt-cfg-block-exists? blocks candidate)
      (opt-loop-preheaders-fresh-label blocks header (+ suffix 1))
      candidate)))

(define (opt-loop-preheaders-phi-outside-values-compatible?
  [outside : OptLabelSet]
  [inputs : ir.CompilerIrPhiInputList]
  [seen : ir.CompilerIrMaybeValue]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-loop-preheaders-phi-outside-values-compatible?
        outside
        (ir.compiler-ir-phi-input-seq-to-list seq)
        seen)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains outside label)
        (match seen
          [(ir.CompilerIrMaybeValue.No)
            (opt-loop-preheaders-phi-outside-values-compatible?
              outside
              (__tl-box-place rest)
              (ir.CompilerIrMaybeValue.Some value))]
          [(ir.CompilerIrMaybeValue.Some first)
            (and
              (opt-value-eq first value)
              (opt-loop-preheaders-phi-outside-values-compatible?
                outside
                (__tl-box-place rest)
                seen))])
        (opt-loop-preheaders-phi-outside-values-compatible?
          outside
          (__tl-box-place rest)
          seen))]))

(define (opt-loop-preheaders-header-instr-compatible?
  [outside : OptLabelSet]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-loop-preheaders-phi-outside-values-compatible?
        outside
        inputs
        (ir.CompilerIrMaybeValue.No))]
    [_ true]))

(define (opt-loop-preheaders-header-instrs-compatible-from?
  [outside : OptLabelSet]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-loop-preheaders-header-instr-compatible?
        outside
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-loop-preheaders-header-instrs-compatible-from?
        outside
        instrs
        (+ index 1)))))

(define (opt-loop-preheaders-header-compatible?
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [outside : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-loop-preheaders-header-instrs-compatible-from? outside instrs 0)])]))

(define (opt-loop-preheaders-existing-candidate-scan
  [pred-map : OptPredMap]
  [header : i64]
  [outside : OptLabelSet]
  [candidate : OptLoopPreheaderCandidate]) : OptLoopPreheaderCandidate
  (match outside
    [(OptLabelSet.Nil) candidate]
    [(OptLabelSet.Dense _ _)
      (opt-loop-preheaders-existing-candidate-scan
        pred-map
        header
        (opt-label-tail outside)
        (opt-natural-loop-preheader-candidate-add
          pred-map
          header
          candidate
          (opt-label-ref outside 0)))]))

(define (opt-loop-preheaders-existing-safe-preheader?
  [pred-map : OptPredMap]
  [header : i64]
  [outside : OptLabelSet]) : bool
  (match (opt-natural-loop-preheader-from-candidate
    (opt-loop-preheaders-existing-candidate-scan
      pred-map
      header
      outside
      (OptLoopPreheaderCandidate.None)))
    [(OptLoopPreheader.Some _) true]
    [(OptLoopPreheader.No) false]))

(define (opt-loop-preheaders-rewrite-phi-inputs-acc
  [inputs : ir.CompilerIrPhiInputList]
  [outside : OptLabelSet]
  [preheader : i64]
  [emitted : bool]
  [acc : ir.CompilerIrPhiInputList]) : OptLoopPreheadersPhiRewriteResult
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil)
      (OptLoopPreheadersPhiRewriteResult.Result
        (ir.compiler-ir-phi-input-list-reverse-onto
          acc
          (ir.CompilerIrPhiInputList.Nil))
        emitted)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-loop-preheaders-rewrite-phi-inputs-acc
        (ir.compiler-ir-phi-input-seq-to-list seq)
        outside
        preheader
        emitted
        acc)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains outside label)
        (if emitted
          (opt-loop-preheaders-rewrite-phi-inputs-acc
            (__tl-box-place rest)
            outside
            preheader
            true
            acc)
          (opt-loop-preheaders-rewrite-phi-inputs-acc
            (__tl-box-place rest)
            outside
            preheader
            true
            (ir.compiler-ir-phi-input-cons value preheader acc)))
        (opt-loop-preheaders-rewrite-phi-inputs-acc
          (__tl-box-place rest)
          outside
          preheader
          emitted
          (ir.compiler-ir-phi-input-cons value label acc)))]))

(define (opt-loop-preheaders-rewrite-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [outside : OptLabelSet]
  [preheader : i64]) : ir.CompilerIrPhiInputList
  (match (opt-loop-preheaders-rewrite-phi-inputs-acc
    inputs
    outside
    preheader
    false
    (ir.CompilerIrPhiInputList.Nil))
    [(OptLoopPreheadersPhiRewriteResult.Result rewritten _) rewritten]))

(define (opt-loop-preheaders-rewrite-header-instr
  [outside : OptLabelSet]
  [preheader : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        dst
        (opt-loop-preheaders-rewrite-phi-inputs inputs outside preheader)
        ty)]
    [_ instr]))

(define (opt-loop-preheaders-rewrite-header-instrs
  [outside : OptLabelSet]
  [preheader : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-loop-preheaders-rewrite-header-instr
              outside
              preheader
              (ir.compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-loop-preheaders-retarget-label
  [label : i64]
  [header : i64]
  [preheader : i64]) : i64
  (if (= label header)
    preheader
    label))

(define (opt-loop-preheaders-retarget-switch-cases-acc
  [cases : ir.CompilerIrSwitchCaseList]
  [header : i64]
  [preheader : i64]
  [acc : ir.CompilerIrSwitchCaseList]) : ir.CompilerIrSwitchCaseList
  (match (ir.compiler-ir-switch-case-list-force-cons cases)
    [(ir.CompilerIrSwitchCaseList.Nil) acc]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case tag label)
          (opt-loop-preheaders-retarget-switch-cases-acc
            (__tl-box-place rest)
            header
            preheader
            (ir.compiler-ir-switch-case-cons-linked
              tag
              (opt-loop-preheaders-retarget-label label header preheader)
              acc))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-loop-preheaders-retarget-switch-cases-acc
        (ir.compiler-ir-switch-case-seq-to-list seq)
        header
        preheader
        acc)]))

(define (opt-loop-preheaders-retarget-switch-cases
  [cases : ir.CompilerIrSwitchCaseList]
  [header : i64]
  [preheader : i64]) : ir.CompilerIrSwitchCaseList
  (ir.compiler-ir-switch-case-list-compact-reversed
    (opt-loop-preheaders-retarget-switch-cases-acc
      cases
      header
      preheader
      ir.CompilerIrSwitchCaseList.Nil)))

(define (opt-loop-preheaders-retarget-instr
  [instr : ir.CompilerIrInstr]
  [header : i64]
  [preheader : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Jump label)
      (ir.CompilerIrInstr.Jump
        (opt-loop-preheaders-retarget-label label header preheader))]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (ir.CompilerIrInstr.Branch
        cond
        (opt-loop-preheaders-retarget-label true-label header preheader)
        (opt-loop-preheaders-retarget-label false-label header preheader))]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (ir.CompilerIrInstr.TotalEnumBranch
        cond
        (opt-loop-preheaders-retarget-label true-label header preheader)
        (opt-loop-preheaders-retarget-label false-label header preheader))]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        index
        base
        (opt-loop-preheaders-retarget-switch-cases cases header preheader)
        (opt-loop-preheaders-retarget-label default-label header preheader))]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        (opt-loop-preheaders-retarget-switch-cases cases header preheader)
        (opt-loop-preheaders-retarget-label default-label header preheader)
        ;; This is provenance, not an executable edge. If the default edge
        ;; acquires a preheader, retain the actual abort block as the proof
        ;; target so source emission can follow and validate the forwarder.
        trap-label)]
    [_ instr]))

(define (opt-loop-preheaders-retarget-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [header : i64]
  [preheader : i64]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-loop-preheaders-retarget-instr
              (ir.compiler-ir-instr-seq-ref instrs index)
              header
              preheader))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-loop-preheaders-append-jump
  [instrs : ir.CompilerIrInstrSeq]
  [target : i64]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr (+ count 1))]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (ir.compiler-ir-instr-seq-ref instrs index))
          (set! index (+ index 1))))
      (set! (array-ref slots count) (ir.CompilerIrInstr.Jump target))
      (ir.CompilerIrInstrSeq slots (+ count 1)))))

(define (opt-loop-preheaders-rewrite-block
  [block : ir.CompilerIrBlock]
  [next-label : i64]
  [header : i64]
  [outside : OptLabelSet]
  [preheader : i64]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (= label header)
        (ir.CompilerIrBlock.Block
          label
          (opt-loop-preheaders-rewrite-header-instrs outside preheader instrs))
        (if (opt-label-contains outside label)
          (let
            [retargeted : ir.CompilerIrInstrSeq
              (opt-loop-preheaders-retarget-instrs instrs header preheader)]
            (ir.CompilerIrBlock.Block
              label
              (if (and
                (= next-label header)
                (opt-cfg-instr-seq-can-fallthrough? instrs))
                (opt-loop-preheaders-append-jump retargeted preheader)
                retargeted)))
          block))]))

(define (opt-loop-preheaders-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [outside : OptLabelSet]
  [preheader : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-loop-preheaders-rewrite-block
          block
          (opt-cfg-entry-label (__tl-box-place rest))
          header
          outside
          preheader)
        (opt-loop-preheaders-rewrite-blocks
          (__tl-box-place rest)
          header
          outside
          preheader))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-preheaders-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        header
        outside
        preheader)]))

(define (opt-loop-preheaders-new-block [preheader : i64] [header : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    preheader
    (ir.compiler-ir-instr-seq1 (ir.CompilerIrInstr.Jump header))))

(define (opt-loop-preheaders-insert-before-header
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [preheader : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (= label header)
            (ir.compiler-ir-block-cons
              (opt-loop-preheaders-new-block preheader header)
              (ir.compiler-ir-block-cons block (__tl-box-place rest)))
            (ir.compiler-ir-block-cons
              block
              (opt-loop-preheaders-insert-before-header
                (__tl-box-place rest)
                header
                preheader)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-preheaders-insert-before-header
        (ir.compiler-ir-block-seq-to-list seq)
        header
        preheader)]))

(define (opt-loop-preheaders-synthesize-loop
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [loop : OptNaturalLoop]) : OptBlockListPassResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some _) (OptBlockListPassResult.Result blocks false)]
    [(OptLoopPreheader.No)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [outside : OptLabelSet
          (opt-loop-preheaders-outside-preds
            context.pred-map
            context.reachable
            context.doms
            header
            body)]
        (if (and
          (> (opt-label-count outside) 0)
          (not
            (opt-loop-preheaders-existing-safe-preheader?
              context.pred-map
              header
              outside))
          (opt-loop-preheaders-header-compatible? blocks header outside))
          (let
            [preheader : i64 (opt-loop-preheaders-fresh-label blocks header 0)]
            [rewritten : ir.CompilerIrBlockList
              (opt-loop-preheaders-rewrite-blocks
                blocks
                header
                outside
                preheader)]
            (OptBlockListPassResult.Result
              (opt-loop-preheaders-insert-before-header
                rewritten
                header
                preheader)
              true))
          (OptBlockListPassResult.Result blocks false)))]))

(define (opt-loop-preheaders-synthesize-loops
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]) : OptBlockListPassResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-loop-preheaders-synthesize-loop blocks context loop)
        [(OptBlockListPassResult.Result next changed)
          (if changed
            (OptBlockListPassResult.Result next true)
            (opt-loop-preheaders-synthesize-loops
              blocks
              context
              (__tl-box-place rest)))])]))

(define (opt-loop-preheaders-blocks-once [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (opt-loop-preheaders-synthesize-loops
      blocks
      context
      (opt-cfg-natural-loops-with-context blocks context))))

(define (opt-loop-preheaders-blocks-once-with-context
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  ;; `context` must be valid for `blocks` (the caller's pipeline context).
  (opt-loop-preheaders-synthesize-loops
    blocks
    context
    (opt-cfg-natural-loops-with-context blocks context)))

(define (opt-loop-preheaders-blocks-fixed-result
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [remaining : i64]
  [any-changed : bool]
  [first-round? : bool]) : OptBlockListPassResult
  ;; The first round reuses the pipeline's CFG context (valid for `blocks`);
  ;; only rounds after an actual synthesis (which rewrote the CFG) pay for a
  ;; fresh context build.
  (if (<= remaining 0)
    (OptBlockListPassResult.Result blocks any-changed)
    (match (if first-round?
      (opt-loop-preheaders-blocks-once-with-context context blocks)
      (opt-loop-preheaders-blocks-once blocks))
      [(OptBlockListPassResult.Result next changed)
        (if changed
          (opt-loop-preheaders-blocks-fixed-result
            next
            context
            (- remaining 1)
            true
            false)
          (OptBlockListPassResult.Result next any-changed))])))

(define (opt-loop-preheaders-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (opt-loop-preheaders-blocks-fixed-result
    blocks
    (opt-cfg-context-build blocks)
    (+ 1 (ir.compiler-ir-block-list-count blocks))
    false
    true)
    [(OptBlockListPassResult.Result next _) next]))

(define (opt-loop-preheaders-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-loop-preheaders-blocks-fixed-result
            blocks
            context
            (+ 1 (ir.compiler-ir-block-list-count blocks))
            false
            true)
            [(OptBlockListPassResult.Result next-blocks preheaders-changed?)
              (if (not preheaders-changed?)
                ;; No preheader was synthesized: the input context still
                ;; describes the unchanged CFG, so skip the context rebuild
                ;; and the post-pass verify entirely.
                (OptFunctionCtxResult.Result func context)
                (let
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      frame
                      next-blocks)]
                  ;; Preheader synthesis may have inserted blocks, so build one
                  ;; fresh context for the rewritten CFG, reuse it for the
                  ;; post-pass verify, and hand it back for the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)])))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-loop-preheaders-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-loop-preheaders-function-with-context-result
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- simple top-test loop rotation ------------------------------------------
;;
;; This runs before scalar SSA construction. It only rotates non-SSA loops whose
;; header is a side-effect-free scalar guard ending in a conditional branch, with
;; one safe preheader and one latch. Duplicating the guard into the preheader and
;; latch preserves the zero-trip check while making the steady-state backedge
;; jump directly to the loop body. SSA construction then inserts the phis needed
;; for loop-carried values and rejects unsupported shapes through its existing
;; verifier gate.
(defenum OptLoopRotationHeader
  (No)
  (Header ir.CompilerIrInstrSeq))

(define (opt-loop-rotation-header-count
  [loops : OptNaturalLoopList]
  [header : i64]) : i64
  (match loops
    [(OptNaturalLoopList.Nil) 0]
    [(OptNaturalLoopList.Cons loop rest)
      (+
        (if (= (opt-natural-loop-header loop) header)
          1
          0)
        (opt-loop-rotation-header-count (__tl-box-place rest) header))]))

(define (opt-loop-rotation-guard-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ op _ _ _) (not (opt-binop-traps? op))]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [_ false]))

(define (opt-loop-rotation-header-prefix-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-loop-rotation-guard-instr?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-loop-rotation-header-prefix-ok? instrs (+ index 1) last))))

(define (opt-loop-rotation-body-target?
  [body : OptLabelSet]
  [header : i64]
  [label : i64]) : bool
  (and (not (= label header)) (opt-label-contains body label)))

(define (opt-loop-rotation-exit-target? [body : OptLabelSet] [label : i64]) : bool
  (not (opt-label-contains body label)))

(define (opt-loop-rotation-header-shape
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [body : OptLabelSet]) : OptLoopRotationHeader
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) (OptLoopRotationHeader.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              (OptLoopRotationHeader.No)
              (let
                [last : i64 (- count 1)]
                (match (ir.compiler-ir-instr-seq-ref instrs last)
                  [(ir.CompilerIrInstr.Branch _ true-label false-label)
                    (if (and
                      (opt-loop-rotation-header-prefix-ok? instrs 0 last)
                      (or
                        (and
                          (opt-loop-rotation-body-target?
                            body
                            header
                            true-label)
                          (opt-loop-rotation-exit-target? body false-label))
                        (and
                          (opt-loop-rotation-body-target?
                            body
                            header
                            false-label)
                          (opt-loop-rotation-exit-target? body true-label))))
                      (OptLoopRotationHeader.Header instrs)
                      (OptLoopRotationHeader.No))]
                  [_ (OptLoopRotationHeader.No)]))))])]))

(define (opt-loop-rotation-final-jump-to?
  [instrs : ir.CompilerIrInstrSeq]
  [target : i64]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (<= count 0)
      false
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Jump label) (= label target)]
        [_ false]))))

(define (opt-loop-rotation-edge-compatible?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-loop-rotation-final-jump-to? instrs target)])]))

(define (opt-loop-rotation-replace-final-jump
  [pools : ast.AstNodePoolContext]
  [instrs : ir.CompilerIrInstrSeq]
  [guard : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [instr-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [prefix-count : i64 (- instr-count 1)]
    [guard-count : i64 (ir.compiler-ir-instr-seq-count guard)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr (+ prefix-count guard-count))]
    [index : i64 0]
    (begin
      (while (< index prefix-count)
        (begin
          (set!
            (array-ref slots index)
            (ir.compiler-ir-instr-seq-ref instrs index))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index guard-count)
        (begin
          (set!
            (array-ref slots (+ prefix-count index))
            (ir.compiler-ir-clone-instr
              pools
              (ir.compiler-ir-instr-seq-ref guard index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots (+ prefix-count guard-count)))))

(define (opt-loop-rotation-rewrite-block
  [pools : ast.AstNodePoolContext]
  [block : ir.CompilerIrBlock]
  [preheader : i64]
  [latch : i64]
  [guard : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (or (= label preheader) (= label latch))
        (ir.CompilerIrBlock.Block
          label
          (opt-loop-rotation-replace-final-jump pools instrs guard))
        block)]))

(define (opt-loop-rotation-rewrite-blocks
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [guard : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (= label header)
            (opt-loop-rotation-rewrite-blocks
              pools
              (__tl-box-place rest)
              header
              preheader
              latch
              guard)
            (ir.compiler-ir-block-cons
              (opt-loop-rotation-rewrite-block
                pools
                block
                preheader
                latch
                guard)
              (opt-loop-rotation-rewrite-blocks
                pools
                (__tl-box-place rest)
                header
                preheader
                latch
                guard)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-rotation-rewrite-blocks
        pools
        (ir.compiler-ir-block-seq-to-list seq)
        header
        preheader
        latch
        guard)]))

(define (opt-loop-rotation-apply-guard
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [guard : ir.CompilerIrInstrSeq]) : OptBlockListPassResult
  (let
    [next : ir.CompilerIrBlockList
      (opt-loop-rotation-rewrite-blocks
        pools
        blocks
        header
        preheader
        latch
        guard)]
    (if (and
      (opt-cfg-block-labels-unique? next)
      (opt-cfg-successor-targets-known? next))
      (OptBlockListPassResult.Result next true)
      (OptBlockListPassResult.Result blocks false))))

(define (opt-loop-rotation-loop
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [loop : OptNaturalLoop]) : OptBlockListPassResult
  (let
    [header : i64 (opt-natural-loop-header loop)]
    [latch : i64 (opt-natural-loop-latch loop)]
    [body : OptLabelSet (opt-natural-loop-body loop)]
    [preds : OptLabelSet (opt-pred-map-lookup context.pred-map header)]
    (match (opt-natural-loop-preheader loop)
      [(OptLoopPreheader.No) (OptBlockListPassResult.Result blocks false)]
      [(OptLoopPreheader.Some preheader)
        (if (and
          (= (opt-loop-rotation-header-count loops header) 1)
          (= (opt-label-count preds) 2)
          (opt-label-contains preds preheader)
          (opt-label-contains preds latch)
          (opt-loop-rotation-edge-compatible? blocks preheader header)
          (opt-loop-rotation-edge-compatible? blocks latch header))
          (match (opt-loop-rotation-header-shape blocks header body)
            [(OptLoopRotationHeader.No)
              (OptBlockListPassResult.Result blocks false)]
            [(OptLoopRotationHeader.Header guard)
              (opt-loop-rotation-apply-guard
                pools
                blocks
                header
                preheader
                latch
                guard)])
          (OptBlockListPassResult.Result blocks false))])))

(define (opt-loop-rotation-loops
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [remaining : OptNaturalLoopList]) : OptBlockListPassResult
  (match remaining
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-loop-rotation-loop pools blocks context loops loop)
        [(OptBlockListPassResult.Result next changed)
          (if changed
            (OptBlockListPassResult.Result next true)
            (opt-loop-rotation-loops
              pools
              blocks
              context
              loops
              (__tl-box-place rest)))])]))

;; The step already builds a CFG context for `blocks`. Carry it out so the
;; fixpoint below can hand the LAST step's context -- the one built for the
;; blocks that did not rotate, i.e. exactly the blocks this pass returns -- to
;; the next pass instead of making it build an identical one.
(defenum OptLoopRotationCtxResult
  (Result ir.CompilerIrBlockList bool OptCfgContext))

(define (opt-loop-rotation-blocks-once-result
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]) : OptLoopRotationCtxResult
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    [loops : OptNaturalLoopList
      (opt-cfg-natural-loops-with-context blocks context)]
    (match (opt-loop-rotation-loops pools blocks context loops loops)
      [(OptBlockListPassResult.Result next changed)
        (OptLoopRotationCtxResult.Result next changed context)])))

(define (opt-loop-rotation-blocks-fixed-result
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]
  [remaining : i64]) : OptBlockCtxResult
  (if (<= remaining 0)
    (OptBlockCtxResult.Result blocks (opt-cfg-context-empty) false)
    (match (opt-loop-rotation-blocks-once-result pools blocks)
      [(OptLoopRotationCtxResult.Result next changed context)
        (if changed
          (opt-loop-rotation-blocks-fixed-result pools next (- remaining 1))
          ;; Every arm of `opt-loop-rotation-loops` returns its input verbatim
          ;; when it reports no change, so `context` is valid for `next`.
          (OptBlockCtxResult.Result next context true))])))

(define (opt-loop-rotation-blocks-result
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]) : OptBlockCtxResult
  ;; The natural-loop finder is dominance based, so let it decide whether the
  ;; CFG contains a loop. Textual block order is not a loop property: inlining
  ;; and block layout may put a latch before its header.
  (if (opt-ssa-blocks-have-phi? blocks)
    (OptBlockCtxResult.Result blocks (opt-cfg-context-empty) false)
    (opt-loop-rotation-blocks-fixed-result
      pools
      blocks
      (+ 1 (ir.compiler-ir-block-list-count blocks)))))

;; The SPMD lowerer emits `branch true, vector-header, tail` before the vector
;; loop. Speculatively normalize that effective single-successor edge so
;; rotation can expose a mutable gang to the dedicated unroller. The pipeline
;; commits this result only when unrolling succeeds; unsupported scan/shuffle
;; shapes therefore keep the ordinary, unnormalized rotation result.
(define (opt-loop-rotation-normalized-function-result
  [pools : ast.AstNodePoolContext]
  [func : ir.CompilerIrFunction]) : OptBlockCtxResult
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (if (opt-ssa-blocks-have-phi? blocks)
        (OptBlockCtxResult.Result blocks (opt-cfg-context-empty) false)
        (let
          [normalized : ir.CompilerIrBlockList
            (if (opt-cfg-blocks-have-foldable-branch? blocks)
              (opt-cfg-fold-branches-blocks blocks)
              blocks)]
          (opt-loop-rotation-blocks-fixed-result
            pools
            normalized
            (+ 1 (ir.compiler-ir-block-list-count normalized)))))]))

(define (opt-loop-rotation-blocks
  [pools : ast.AstNodePoolContext]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (opt-loop-rotation-blocks-result pools blocks)
    [(OptBlockCtxResult.Result out _ _) out]))

(define (opt-loop-rotation-function-result
  [pools : ast.AstNodePoolContext]
  [func : ir.CompilerIrFunction]) : OptBlockCtxResult
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-loop-rotation-blocks-result pools blocks)]))

;; --- post-SSA loop rotation (rotate_ssa) -------------------------------------
;;
;; The pre-SSA rotation pass (#2458) never fires on lowered while-loops: their
;; preheaders are synthesized by the loop-preheaders pass (#2457), which runs
;; after scalar SSA construction, so nested/inner loops stay top-tested (a
;; guard block plus a jump back on every iteration) and loop BCE misses the
;; facts it derives from the rotated shape. This pass rotates one SSA-form
;; natural loop per invocation (the surrounding fixpoint handles the rest):
;; the header's phis move to the top of the loop-body block, the header's
;; side-effect-free guard prefix plus conditional branch is cloned into the
;; preheader and the latch with fresh destinations (phi uses remapped to that
;; edge's input value), loop-carried values used after the loop are merged
;; through fresh exit phis, and the header block is replaced by an empty
;; landing block on the preheader guard's loop edge. The landing block keeps a
;; dedicated single-successor preheader for the rotated loop (the guard makes
;; the old preheader multi-successor), so LICM can still hoist loop-invariant
;; work in the same pipeline iteration; the moved phis take their preheader
;; input from the landing block, while the exit phis keep the direct
;; preheader/latch edges. The rewrite is verifier-gated; any rejected shape or
;; failed verify returns the input function unchanged.
(defenum OptRotateSsaPhiRecs
  (Nil)
  (Cons
    i64
    ir.CompilerIrValue
    ir.CompilerIrValue
    ast.AstType
    (Box OptRotateSsaPhiRecs)))

(defenum OptRotateSsaMaybePhiRecs
  (No)
  (Some OptRotateSsaPhiRecs))

(defstruct OptRotateSsaShape
  (phis ir.CompilerIrInstrSeq)
  (recs OptRotateSsaPhiRecs)
  (guard ir.CompilerIrInstrSeq)
  (cond-value ir.CompilerIrValue)
  (true-label i64)
  (false-label i64)
  (body-label i64)
  (exit-label i64))

(defenum OptRotateSsaMaybeShape
  (No)
  (Some OptRotateSsaShape))

(defenum OptRotateSsaClone
  (Clone ir.CompilerIrInstrSeq i64))

(defenum OptRotateSsaExitPhis
  (Result ir.CompilerIrInstrSeq OptCopyEnv i64))

(defenum OptRotateSsaRewrite
  (No)
  (Some ir.CompilerIrBlockList i64))

;; An accepted, verified rotation candidate: the rewritten function and the
;; fresh context built for it.
(defenum OptFunctionCtxMaybe
  (No)
  (Some ir.CompilerIrFunction OptCfgContext))

(defstruct OptRotateSsaPlan
  (header i64)
  (preheader i64)
  (latch i64)
  (land-label i64)
  (body-label i64)
  (exit-label i64)
  (body OptLabelSet)
  (phis ir.CompilerIrInstrSeq)
  (preheader-guard ir.CompilerIrInstrSeq)
  (latch-guard ir.CompilerIrInstrSeq)
  (exit-phis ir.CompilerIrInstrSeq)
  (exit-env OptCopyEnv))

(define (opt-rotate-ssa-land-label [header : i64]) : i64
  (ir.compiler-ir-label
    (str_cat.str-cat (ir.compiler-ir-label-text header) "__rotate_land")))

(define (opt-rotate-ssa-only-label? [set : OptLabelSet] [label : i64]) : bool
  (and (= (opt-label-count set) 1) (opt-label-contains set label)))

(define (opt-rotate-ssa-leading-phi-end
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    index
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ _)
        (opt-rotate-ssa-leading-phi-end instrs (+ index 1))]
      [_ index])))

;; Each header phi must carry exactly the two loop-edge inputs {preheader,
;; latch}; the record keeps (dst, preheader input, latch input, type).
(define (opt-rotate-ssa-phi-recs-from
  [phis : ir.CompilerIrInstrSeq]
  [preheader : i64]
  [latch : i64]
  [index : i64]) : OptRotateSsaMaybePhiRecs
  (if (>= index (ir.compiler-ir-instr-seq-count phis))
    (OptRotateSsaMaybePhiRecs.Some (OptRotateSsaPhiRecs.Nil))
    (match (opt-rotate-ssa-phi-recs-from phis preheader latch (+ index 1))
      [(OptRotateSsaMaybePhiRecs.No) (OptRotateSsaMaybePhiRecs.No)]
      [(OptRotateSsaMaybePhiRecs.Some recs)
        (match (ir.compiler-ir-instr-seq-ref phis index)
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (match (ir.compiler-ir-phi-input-list-force-cons inputs)
              [(ir.CompilerIrPhiInputList.Cons first-value first-label rest1)
                (match (__tl-box-place rest1)
                  [(ir.CompilerIrPhiInputList.Cons
                      second-value
                      second-label
                      rest2)
                    (match (__tl-box-place rest2)
                      [(ir.CompilerIrPhiInputList.Nil)
                        (cond
                          [(and
                              (= first-label preheader)
                              (= second-label latch))
                            (OptRotateSsaMaybePhiRecs.Some
                              (OptRotateSsaPhiRecs.Cons
                                dst
                                first-value
                                second-value
                                ty
                                (box recs)))]
                          [(and
                              (= first-label latch)
                              (= second-label preheader))
                            (OptRotateSsaMaybePhiRecs.Some
                              (OptRotateSsaPhiRecs.Cons
                                dst
                                second-value
                                first-value
                                ty
                                (box recs)))]
                          [else (OptRotateSsaMaybePhiRecs.No)])]
                      [_ (OptRotateSsaMaybePhiRecs.No)])]
                  [_ (OptRotateSsaMaybePhiRecs.No)])]
              [_ (OptRotateSsaMaybePhiRecs.No)])]
          [_ (OptRotateSsaMaybePhiRecs.No)])])))

(define (opt-rotate-ssa-phi-recs
  [phis : ir.CompilerIrInstrSeq]
  [preheader : i64]
  [latch : i64]) : OptRotateSsaMaybePhiRecs
  (opt-rotate-ssa-phi-recs-from phis preheader latch 0))

(define (opt-rotate-ssa-instr-seq-range
  [instrs : ir.CompilerIrInstrSeq]
  [first : i64]
  [last : i64]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (- last first)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (ir.compiler-ir-instr-seq-ref instrs (+ first index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-rotate-ssa-shape-from-branch
  [instrs : ir.CompilerIrInstrSeq]
  [phi-end : i64]
  [last : i64]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [body : OptLabelSet]
  [cond-value : ir.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : OptRotateSsaMaybeShape
  (let
    [true-is-body : bool
      (and
        (opt-loop-rotation-body-target? body header true-label)
        (opt-loop-rotation-exit-target? body false-label))]
    [false-is-body : bool
      (and
        (opt-loop-rotation-body-target? body header false-label)
        (opt-loop-rotation-exit-target? body true-label))]
    (if (or true-is-body false-is-body)
      (let
        [phis : ir.CompilerIrInstrSeq
          (opt-rotate-ssa-instr-seq-range instrs 0 phi-end)]
        (match (opt-rotate-ssa-phi-recs phis preheader latch)
          [(OptRotateSsaMaybePhiRecs.No) (OptRotateSsaMaybeShape.No)]
          [(OptRotateSsaMaybePhiRecs.Some recs)
            (OptRotateSsaMaybeShape.Some
              (OptRotateSsaShape
                phis
                recs
                (opt-rotate-ssa-instr-seq-range instrs phi-end last)
                cond-value
                true-label
                false-label
                (if true-is-body
                  true-label
                  false-label)
                (if true-is-body
                  false-label
                  true-label)))]))
      (OptRotateSsaMaybeShape.No))))

;; Header shape: leading phis (zero or more), then a whitelisted pure guard
;; prefix (possibly empty), then a conditional branch with one arm into the
;; loop body (never the header itself: self-loops are already rotated) and one
;; arm out of it.
(define (opt-rotate-ssa-header-shape
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [body : OptLabelSet]) : OptRotateSsaMaybeShape
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) (OptRotateSsaMaybeShape.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              (OptRotateSsaMaybeShape.No)
              (let
                [last : i64 (- count 1)]
                [phi-end : i64 (opt-rotate-ssa-leading-phi-end instrs 0)]
                (if (not
                  (opt-loop-rotation-header-prefix-ok? instrs phi-end last))
                  (OptRotateSsaMaybeShape.No)
                  (match (ir.compiler-ir-instr-seq-ref instrs last)
                    [(ir.CompilerIrInstr.Branch
                        cond-value
                        true-label
                        false-label)
                      (opt-rotate-ssa-shape-from-branch
                        instrs
                        phi-end
                        last
                        header
                        preheader
                        latch
                        body
                        cond-value
                        true-label
                        false-label)]
                    [_ (OptRotateSsaMaybeShape.No)])))))])]))

(define (opt-rotate-ssa-instr-seq-has-phi?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ _) true]
      [_ (opt-rotate-ssa-instr-seq-has-phi? instrs (+ index 1))])))

;; The rewrite prepends phis to the body and exit blocks; a pre-existing phi
;; there would have a single input labeled with the deleted header, so such
;; blocks are rejected (a missing block is rejected too).
(define (opt-rotate-ssa-block-has-phi?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) true]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-rotate-ssa-instr-seq-has-phi? instrs 0)])]))

;; Reject break-style side exits: no loop-body block other than the header may
;; branch to the exit label.
(define (opt-rotate-ssa-body-avoids-exit?
  [pred-map : OptPredMap]
  [body : OptLabelSet]
  [header : i64]
  [exit-label : i64]) : bool
  (match body
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref body 0)]
        (and
          (or
            (= label header)
            (not
              (opt-label-contains
                (opt-pred-map-successors pred-map label)
                exit-label)))
          (opt-rotate-ssa-body-avoids-exit?
            pred-map
            (opt-label-tail body)
            header
            exit-label)))]))

(define (opt-rotate-ssa-succs-inside?
  [body : OptLabelSet]
  [succs : OptLabelSet]) : bool
  (match succs
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (opt-label-contains body (opt-label-ref succs 0))
        (opt-rotate-ssa-succs-inside? body (opt-label-tail succs)))]))

;; True when the header's exit arm is the loop's ONLY way out: no body block
;; other than the header has a successor outside the body. The fresh exit phis
;; are defined in the exit block, so every outside reader of a loop-carried
;; value has to be dominated by it; with a second exit (a `break`, or a lowered
;; `(and ...)` loop condition whose second test leaves through a body block)
;; the outside reader is reachable without passing through the exit block and
;; the substitution is a dominance violation. That rewrite used to be built and
;; handed to the verifier, which rejected it -- correct, but it cost a full
;; rewrite, context build and verify per round per such loop. Only the exit-phi
;; case needs the property, so multi-exit loops with no outside reader still
;; rotate.
(define (opt-rotate-ssa-single-exit?
  [pred-map : OptPredMap]
  [body : OptLabelSet]
  [cursor : OptLabelSet]
  [header : i64]) : bool
  (match cursor
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref cursor 0)]
        (and
          (or
            (= label header)
            (opt-rotate-ssa-succs-inside?
              body
              (opt-pred-map-successors pred-map label)))
          (opt-rotate-ssa-single-exit?
            pred-map
            body
            (opt-label-tail cursor)
            header)))]))

(define (opt-rotate-ssa-uses-except-header
  [set : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [header : i64]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-rotate-ssa-uses-except-header
            (if (= label header)
              set
              (opt-collect-instr-seq-uses set instrs))
            (__tl-box-place rest)
            header)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-rotate-ssa-uses-except-header
        set
        (ir.compiler-ir-block-seq-to-list seq)
        header)]))

(define (opt-rotate-ssa-uses-outside-body
  [set : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [body : OptLabelSet]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-rotate-ssa-uses-outside-body
            (if (opt-label-contains body label)
              set
              (opt-collect-instr-seq-uses set instrs))
            (__tl-box-place rest)
            body)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-rotate-ssa-uses-outside-body
        set
        (ir.compiler-ir-block-seq-to-list seq)
        body)]))

(define (opt-rotate-ssa-instr-dst [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) dst]
    [(ir.CompilerIrInstr.Cast dst _ _ _) dst]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) dst]
    [_ (- 0 1)]))

;; The guard prefix is deleted with the header and only re-materialized with
;; fresh destinations, so every guard destination must be used exclusively
;; inside the header by the guard/branch itself; `uses` covers all other
;; blocks plus the header's own phi inputs.
(define (opt-rotate-ssa-guard-dsts-local?
  [guard : ir.CompilerIrInstrSeq]
  [uses : opt_i64_i64_map.Map]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count guard)]
    [index : i64 0]
    [local? : bool true]
    (begin
      (while (and local? (< index count))
        (let
          [dst : i64
            (opt-rotate-ssa-instr-dst
              (ir.compiler-ir-instr-seq-ref guard index))]
          (begin
            (set! local? (and (>= dst 0) (not (opt-used-contains uses dst))))
            (set! index (+ index 1)))))
      local?)))

;; Map each header-phi destination to the input value carried by one loop
;; edge: the preheader input for the preheader clone, the latch input for the
;; latch clone.
(define (opt-rotate-ssa-edge-env [recs : OptRotateSsaPhiRecs] [use-init : bool]) : OptCopyEnv
  (match recs
    [(OptRotateSsaPhiRecs.Nil) (OptCopyEnv.Nil)]
    [(OptRotateSsaPhiRecs.Cons dst init back _ rest)
      (OptCopyEnv.Cons
        dst
        (if use-init
          init
          back)
        (box (opt-rotate-ssa-edge-env (__tl-box-place rest) use-init)))]))

(define (opt-rotate-ssa-clone-guard-instr
  [env : OptCopyEnv]
  [dst : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov _ src ty)
      (ir.CompilerIrInstr.Mov dst (opt-copy-resolve env src) ty)]
    [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
      (ir.CompilerIrInstr.Cast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(ir.CompilerIrInstr.Bitcast _ src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast dst (opt-copy-resolve env src) from-ty to-ty)]
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        dst
        op
        (opt-copy-resolve env lhs)
        (opt-copy-resolve env rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp _ op src ty)
      (ir.CompilerIrInstr.UnOp dst op (opt-copy-resolve env src) ty)]
    ;; Unreachable: the guard prefix is restricted to the whitelist above; the
    ;; post-rewrite verifier rejects any duplicate definition this would leave.
    [_ instr]))

;; Clone the guard prefix with fresh destinations, remapping intra-guard uses
;; of earlier guard destinations to their fresh clones and phi-destination
;; uses through the edge env, then end with the header's branch (same arm
;; orientation) on the remapped condition.
(define (opt-rotate-ssa-clone-guard
  [env : OptCopyEnv]
  [guard : ir.CompilerIrInstrSeq]
  [cond-value : ir.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]
  [next-var : i64]) : OptRotateSsaClone
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count guard)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr (+ count 1))]
    [index : i64 0]
    [out-env : OptCopyEnv env]
    [out-var : i64 next-var]
    (begin
      (while (< index count)
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref guard index)]
          (begin
            (set!
              (array-ref slots index)
              (opt-rotate-ssa-clone-guard-instr out-env out-var instr))
            (set!
              out-env
              (OptCopyEnv.Cons
                (opt-rotate-ssa-instr-dst instr)
                (ir.CompilerIrValue.Var out-var)
                (box out-env)))
            (set! out-var (+ out-var 1))
            (set! index (+ index 1)))))
      (set!
        (array-ref slots count)
        (ir.CompilerIrInstr.Branch
          (opt-copy-resolve out-env cond-value)
          true-label
          false-label))
      (OptRotateSsaClone.Clone
        (ir.CompilerIrInstrSeq slots (+ count 1))
        out-var))))

;; Rebuild the header phis for the top of the loop-body block: same
;; destinations, initial input relabeled to the landing block (the body's new
;; preheader-side predecessor), latch input unchanged.
(define (opt-rotate-ssa-phi-rec-count [recs : OptRotateSsaPhiRecs]) : i64
  (match recs
    [(OptRotateSsaPhiRecs.Nil) 0]
    [(OptRotateSsaPhiRecs.Cons _ _ _ _ rest)
      (+ 1 (opt-rotate-ssa-phi-rec-count (__tl-box-place rest)))]))

(define (opt-rotate-ssa-moved-phis-fill!
  [recs : OptRotateSsaPhiRecs]
  [land-label : i64]
  [latch : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]) : unit
  (match recs
    [(OptRotateSsaPhiRecs.Nil) unit]
    [(OptRotateSsaPhiRecs.Cons dst init back ty rest)
      (begin
        (set!
          (array-ref slots index)
          (ir.CompilerIrInstr.Phi
            dst
            (ir.compiler-ir-phi-input-cons
              init
              land-label
              (ir.compiler-ir-phi-input-cons
                back
                latch
                (ir.CompilerIrPhiInputList.Nil)))
            ty))
        (opt-rotate-ssa-moved-phis-fill!
          (__tl-box-place rest)
          land-label
          latch
          slots
          (+ index 1)))]))

(define (opt-rotate-ssa-moved-phis
  [recs : OptRotateSsaPhiRecs]
  [land-label : i64]
  [latch : i64]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (opt-rotate-ssa-phi-rec-count recs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    (begin
      (opt-rotate-ssa-moved-phis-fill! recs land-label latch slots 0)
      (ir.CompilerIrInstrSeq slots count))))

;; For each header phi whose destination is used outside the loop body, mint a
;; fresh exit phi merging the same edge inputs at the exit block, and record
;; the destination remap for the outside-use rewrite.
(define (opt-rotate-ssa-exit-phis-from
  [recs : OptRotateSsaPhiRecs]
  [outside-uses : opt_i64_i64_map.Map]
  [preheader : i64]
  [latch : i64]
  [next-var : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [write : i64]) : OptRotateSsaExitPhis
  (match recs
    [(OptRotateSsaPhiRecs.Nil)
      (OptRotateSsaExitPhis.Result
        (ir.CompilerIrInstrSeq slots write)
        (OptCopyEnv.Nil)
        next-var)]
    [(OptRotateSsaPhiRecs.Cons dst init back ty rest)
      (if (opt-used-contains outside-uses dst)
        (begin
          (set!
            (array-ref slots write)
            (ir.CompilerIrInstr.Phi
              next-var
              (ir.compiler-ir-phi-input-cons
                init
                preheader
                (ir.compiler-ir-phi-input-cons
                  back
                  latch
                  (ir.CompilerIrPhiInputList.Nil)))
              ty))
          (match (opt-rotate-ssa-exit-phis-from
            (__tl-box-place rest)
            outside-uses
            preheader
            latch
            (+ next-var 1)
            slots
            (+ write 1))
            [(OptRotateSsaExitPhis.Result phis env out-var)
              (OptRotateSsaExitPhis.Result
                phis
                (OptCopyEnv.Cons
                  dst
                  (ir.CompilerIrValue.Var next-var)
                  (box env))
                out-var)]))
        (opt-rotate-ssa-exit-phis-from
          (__tl-box-place rest)
          outside-uses
          preheader
          latch
          next-var
          slots
          write))]))

(define (opt-rotate-ssa-exit-phis
  [recs : OptRotateSsaPhiRecs]
  [outside-uses : opt_i64_i64_map.Map]
  [preheader : i64]
  [latch : i64]
  [next-var : i64]) : OptRotateSsaExitPhis
  (opt-rotate-ssa-exit-phis-from
    recs
    outside-uses
    preheader
    latch
    next-var
    (array.make-array ir.CompilerIrInstr (opt-rotate-ssa-phi-rec-count recs))
    0))

(define (opt-rotate-ssa-subst-phi-inputs
  [env : OptCopyEnv]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-rotate-ssa-subst-phi-inputs
        env
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-copy-resolve env value)
        label
        (opt-rotate-ssa-subst-phi-inputs env (__tl-box-place rest)))]))

;; Outside-the-loop use rewriting must also rewrite phi inputs (the block-local
;; copy substitution deliberately skips them), so wrap opt-copy-subst-instr.
(define (opt-rotate-ssa-subst-instr
  [env : OptCopyEnv]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        dst
        (opt-rotate-ssa-subst-phi-inputs env inputs)
        ty)]
    [_ (opt-copy-subst-instr env instr)]))

(define (opt-rotate-ssa-rewrite-instr-seq
  [env : OptCopyEnv]
  [subst? : bool]
  [replace-final? : bool]
  [prefix : ir.CompilerIrInstrSeq]
  [guard : ir.CompilerIrInstrSeq]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [prefix-count : i64 (ir.compiler-ir-instr-seq-count prefix)]
    [body-count : i64
      (if (and replace-final? (> count 0))
        (- count 1)
        count)]
    [guard-count : i64
      (if replace-final?
        (ir.compiler-ir-instr-seq-count guard)
        0)]
    [out-count : i64 (+ prefix-count (+ body-count guard-count))]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr out-count)]
    [index : i64 0]
    (begin
      (while (< index prefix-count)
        (begin
          (set!
            (array-ref slots index)
            (ir.compiler-ir-instr-seq-ref prefix index))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index body-count)
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs index)]
          (begin
            (set!
              (array-ref slots (+ prefix-count index))
              (if subst?
                (opt-rotate-ssa-subst-instr env instr)
                instr))
            (set! index (+ index 1)))))
      (set! index 0)
      (while (< index guard-count)
        (begin
          (set!
            (array-ref slots (+ prefix-count (+ body-count index)))
            (ir.compiler-ir-instr-seq-ref guard index))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots out-count))))

(define (opt-rotate-ssa-block-touched? [plan : OptRotateSsaPlan] [label : i64]) : bool
  (or
    (= label plan.preheader)
    (= label plan.latch)
    (= label plan.body-label)
    (= label plan.exit-label)
    (and
      (not (opt-label-contains plan.body label))
      (match plan.exit-env
        [(OptCopyEnv.Nil) false]
        [_ true]))))

(define (opt-rotate-ssa-rewrite-instrs
  [plan : OptRotateSsaPlan]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [replace-final? : bool (or (= label plan.preheader) (= label plan.latch))]
    [prefix : ir.CompilerIrInstrSeq
      (cond
        [(= label plan.body-label) plan.phis]
        [(= label plan.exit-label) plan.exit-phis]
        [else (ir.compiler-ir-instr-seq-empty)])]
    [guard : ir.CompilerIrInstrSeq
      (cond
        [(= label plan.preheader) plan.preheader-guard]
        [(= label plan.latch) plan.latch-guard]
        [else (ir.compiler-ir-instr-seq-empty)])]
    (opt-rotate-ssa-rewrite-instr-seq
      plan.exit-env
      (not (opt-label-contains plan.body label))
      replace-final?
      prefix
      guard
      instrs)))

;; The deleted header's slot in the block list is reused for the landing
;; block, keeping the layout deterministic; the accepted shape guarantees no
;; block falls through into that position (the preheader and latch end with an
;; explicit jump and any other fallthrough predecessor was rejected).
(define (opt-rotate-ssa-rewrite-blocks
  [plan : OptRotateSsaPlan]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (= label plan.header)
              (ir.CompilerIrBlock.Block
                plan.land-label
                (ir.compiler-ir-instr-seq1
                  (ir.CompilerIrInstr.Jump plan.body-label)))
              (if (opt-rotate-ssa-block-touched? plan label)
                (ir.CompilerIrBlock.Block
                  label
                  (opt-rotate-ssa-rewrite-instrs plan label instrs))
                block))
            (opt-rotate-ssa-rewrite-blocks plan (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-rotate-ssa-rewrite-blocks
        plan
        (ir.compiler-ir-block-seq-to-list seq))]))

;; True when at least one header-phi destination is read outside the loop body,
;; i.e. when the rewrite has to mint exit phis at the exit block. Every clause
;; that exists only to make those phis well-formed is gated on this.
(define (opt-rotate-ssa-recs-used-outside?
  [recs : OptRotateSsaPhiRecs]
  [outside-uses : opt_i64_i64_map.Map]) : bool
  (match recs
    [(OptRotateSsaPhiRecs.Nil) false]
    [(OptRotateSsaPhiRecs.Cons dst _ _ _ rest)
      (or
        (opt-used-contains outside-uses dst)
        (opt-rotate-ssa-recs-used-outside? (__tl-box-place rest) outside-uses))]))

(define (opt-rotate-ssa-apply
  [blocks : ir.CompilerIrBlockList]
  [pred-map : OptPredMap]
  [frame : i64]
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [body : OptLabelSet]
  [shape : OptRotateSsaShape]) : OptRotateSsaRewrite
  (let
    [body-label : i64 shape.body-label]
    [exit-label : i64 shape.exit-label]
    [land-label : i64 (opt-rotate-ssa-land-label header)]
    [phis : ir.CompilerIrInstrSeq shape.phis]
    [recs : OptRotateSsaPhiRecs shape.recs]
    [guard : ir.CompilerIrInstrSeq shape.guard]
    [outside-uses : opt_i64_i64_map.Map
      (opt-rotate-ssa-uses-outside-body
        (opt_i64_i64_map.with-capacity 64)
        blocks
        body)]
    ;; The exit block only has to be the header's private successor when the
    ;; rewrite prepends phis to it. Those phis carry exactly the two loop-edge
    ;; inputs {preheader, latch}, so any third predecessor would leave them
    ;; short an input -- but with no exit phis to mint nothing is prepended,
    ;; the exit block's own predecessors are untouched, and the rotation only
    ;; swaps the header's single edge into it for the preheader's and the
    ;; latch's. `bce_version` is the measured producer of that shape: it clones
    ;; a loop into a bounds-checked and a fast version that SHARE one exit
    ;; block, so the pre-existing clause refused BOTH halves of every versioned
    ;; counted loop -- including the hot fast half.
    [exit-phis-needed? : bool
      (opt-rotate-ssa-recs-used-outside? recs outside-uses)]
    (if (and
      (not (= exit-label preheader))
      (not (opt-cfg-block-exists? blocks land-label))
      (opt-rotate-ssa-only-label?
        (opt-pred-map-lookup pred-map body-label)
        header)
      (or
        (not exit-phis-needed?)
        (and
          (opt-rotate-ssa-only-label?
            (opt-pred-map-lookup pred-map exit-label)
            header)
          (opt-rotate-ssa-single-exit? pred-map body body header)))
      (opt-rotate-ssa-body-avoids-exit? pred-map body header exit-label)
      (not (opt-rotate-ssa-block-has-phi? blocks body-label))
      (not (opt-rotate-ssa-block-has-phi? blocks exit-label))
      (opt-rotate-ssa-guard-dsts-local?
        guard
        (opt-rotate-ssa-uses-except-header
          (opt-collect-instr-seq-uses (opt_i64_i64_map.with-capacity 64) phis)
          blocks
          header)))
      ;; The preheader clone's loop arm targets the landing block instead of
      ;; the body so the rotated loop keeps a dedicated single-successor
      ;; preheader for LICM; the latch clone branches straight to the body.
      (match (opt-rotate-ssa-clone-guard
        (opt-rotate-ssa-edge-env recs true)
        guard
        shape.cond-value
        (if (= shape.true-label body-label)
          land-label
          shape.true-label)
        (if (= shape.false-label body-label)
          land-label
          shape.false-label)
        frame)
        [(OptRotateSsaClone.Clone preheader-guard after-preheader)
          (match (opt-rotate-ssa-clone-guard
            (opt-rotate-ssa-edge-env recs false)
            guard
            shape.cond-value
            shape.true-label
            shape.false-label
            after-preheader)
            [(OptRotateSsaClone.Clone latch-guard after-latch)
              (match (opt-rotate-ssa-exit-phis
                recs
                outside-uses
                preheader
                latch
                after-latch)
                [(OptRotateSsaExitPhis.Result exit-phis exit-env next-frame)
                  (OptRotateSsaRewrite.Some
                    (opt-rotate-ssa-rewrite-blocks
                      (OptRotateSsaPlan
                        header
                        preheader
                        latch
                        land-label
                        body-label
                        exit-label
                        body
                        (opt-rotate-ssa-moved-phis recs land-label latch)
                        preheader-guard
                        latch-guard
                        exit-phis
                        exit-env)
                      blocks)
                    next-frame)])])])
      (OptRotateSsaRewrite.No))))

(define (opt-rotate-ssa-loop
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptRotateSsaRewrite
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.No) (OptRotateSsaRewrite.No)]
    [(OptLoopPreheader.Some preheader)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [latch : i64 (opt-natural-loop-latch loop)]
        [body : OptLabelSet (opt-natural-loop-body loop)]
        [pred-map : OptPredMap context.pred-map]
        [header-preds : OptLabelSet (opt-pred-map-lookup pred-map header)]
        (if (and
          (not (= header latch))
          (opt-rotate-ssa-only-label?
            (opt-pred-map-successors pred-map preheader)
            header)
          (opt-loop-rotation-edge-compatible? blocks preheader header)
          (opt-loop-rotation-edge-compatible? blocks latch header)
          (= (opt-label-count header-preds) 2)
          (opt-label-contains header-preds preheader)
          (opt-label-contains header-preds latch))
          (match (opt-rotate-ssa-header-shape
            blocks
            header
            preheader
            latch
            body)
            [(OptRotateSsaMaybeShape.No) (OptRotateSsaRewrite.No)]
            [(OptRotateSsaMaybeShape.Some shape)
              (opt-rotate-ssa-apply
                blocks
                pred-map
                frame
                header
                preheader
                latch
                body
                shape)])
          (OptRotateSsaRewrite.No)))]))

(define (opt-rotate-ssa-loop-verified
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]
  [loop : OptNaturalLoop]) : OptFunctionCtxMaybe
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-rotate-ssa-loop blocks context frame loop)
        [(OptRotateSsaRewrite.No) (OptFunctionCtxMaybe.No)]
        [(OptRotateSsaRewrite.Some next-blocks next-frame)
          (let
            [next : ir.CompilerIrFunction
              (ir.CompilerIrFunction.Function
                name
                params
                ret-ty
                next-frame
                next-blocks)]
            [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
            (match (opt-verify-function-with-context next next-context)
              [(ResultCompilerOptimizeVerify.Ok)
                (OptFunctionCtxMaybe.Some next next-context)]
              [(ResultCompilerOptimizeVerify.Err _) (OptFunctionCtxMaybe.No)]))])]))

;; A candidate whose rewrite fails the post-rotation verify is a REFUSAL of
;; that loop, not the end of the round. The verify used to sit above this scan,
;; in `opt-rotate-ssa-rounds`, so the first loop whose rewrite the verifier
;; rejected retired the whole rounds loop and every loop AFTER it in the list
;; lost its chance -- for the rest of the pipeline, because the next stage
;; re-scans the same list and stops at the same poison pill. Measured in
;; `benchmarks/liveness_scan`'s `recompute!`: the `(and (< i words) (not
;; changed))` early-exit loop passes every admission clause but rotates into a
;; dominance violation (its second exit leaves the loop through a body block,
;; so the fresh exit phi does not dominate the outside reader), and the
;; writeback loop that follows it in the list was never even examined by either
;; rotation stage. Verifying per candidate keeps the same discipline -- only an
;; accepted, verified rewrite is banked -- and costs one extra verify per
;; rejected candidate per round.
(define (opt-rotate-ssa-loops
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]) : OptFunctionCtxMaybe
  (match loops
    [(OptNaturalLoopList.Nil) (OptFunctionCtxMaybe.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-rotate-ssa-loop-verified func context loop)
        [(OptFunctionCtxMaybe.Some next next-context)
          (OptFunctionCtxMaybe.Some next next-context)]
        [(OptFunctionCtxMaybe.No)
          (opt-rotate-ssa-loops func context (__tl-box-place rest))])]))

;; One rotation per round, each candidate verified on its own (in
;; `opt-rotate-ssa-loop-verified`, so a rejected one only costs its own round
;; position) and each accepted rotation followed by a fresh context: the rewrite
;; adds the landing block and
;; rewires the header's predecessors, so the loop set, the predecessor map and
;; the dominance facts all have to be rebuilt before the next loop's shape test
;; reads them, and a rejected rotation must leave the rotations already banked
;; in place. Without the rounds a function got at most ONE rotated loop per
;; PIPELINE iteration -- two in total at `optimize-function-max-iterations` --
;; so sibling loops raced for the rotated shape and the passes below,
;; `bce_version` above all, locked the losers into their top-tested form.
;; `live-out-into!` in benchmarks/liveness_scan is the measured case: its zero
;; fill and its inner word loop both want the rotation and only one of them
;; could have it. Fuel-bounded by the block count; an accepted rotation retires
;; its header's top test, so no loop is rotated twice.
(define (opt-rotate-ssa-rounds
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]
  [remaining : i64]) : OptFunctionCtxResult
  (if (<= remaining 0)
    (OptFunctionCtxResult.Result func context)
    (match (opt-rotate-ssa-loops
      func
      context
      (opt-cfg-natural-loops-with-context (opt-function-blocks func) context))
      [(OptFunctionCtxMaybe.No) (OptFunctionCtxResult.Result func context)]
      [(OptFunctionCtxMaybe.Some next next-context)
        (opt-rotate-ssa-rounds next next-context (- remaining 1))])))

(define (opt-rotate-ssa-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-verify-gate verified? func context)
        [(ResultCompilerOptimizeVerify.Ok)
          (opt-rotate-ssa-rounds
            func
            context
            (+ 1 (ir.compiler-ir-block-list-count blocks)))]
        [(ResultCompilerOptimizeVerify.Err _)
          (OptFunctionCtxResult.Result func context)])]))

;; --- conservative loop-invariant code motion --------------------------------
;;
;; LICM is verifier-gated. It moves non-trapping scalar `BinOp`/`UnOp`
;; definitions from natural loops with a single safe preheader. Memory LICM adds
;; a conservative load slice: invariant address GEPs and plain loads may move
;; only when the whole loop has no alias-fact-clearing memory/call/unknown
;; effect. A candidate's value operands must be defined outside the loop or by
;; an earlier instruction already selected for the same hoist. Stores, calls,
;; allocations, bounds checks, phis, vector memory ops, and trapping arithmetic
;; are left in place.
(defenum OptLicmInstrsResult
  (Result
    ir.CompilerIrInstrList
    ir.CompilerIrInstrList
    opt_i64_i64_map.Map
    bool))

(defenum OptLicmBlocksResult
  (Result
    ir.CompilerIrBlockList
    ir.CompilerIrInstrList
    opt_i64_i64_map.Map
    bool))

;; Result of applying LICM to a block list: the rewritten blocks plus whether
;; any loop actually hoisted. When nothing changed the caller can skip the
;; rewritten-CFG context rebuild and post-pass verify -- the input context
;; stays valid for the unchanged function.
(defstruct OptLicmStoreSummary
  (call-or-unknown? bool)
  (header-or-unknown-store? bool)
  (element-only-store? bool)
  ;; A DIRECT call the call-memory fixpoint proved writes only element storage
  ;; (opt-direct-call-element-clean?). It is a memory writer, so it is not
  ;; `clean?`, and it is a call, so it keeps the call BOUNDARY the hoist/allocate
  ;; interlock prices (opt-licm-store-summary-call-boundary?) -- but it provably
  ;; cannot change a descriptor header word, so it does NOT close the
  ;; header-load proofs the way `call-or-unknown?` does. Keeping it in its own
  ;; field rather than reusing `element-only-store?` is what separates those two
  ;; verdicts: an in-function element store is not a call boundary and must not
  ;; start being priced as one.
  (element-only-call? bool))

(defenum OptLicmPtrKind
  (Unknown)
  (HeaderSlot i64)
  (DataSlot i64)
  (DataBuffer i64)
  (DataElement i64)
  ;; A fixed-offset word of the object a global cell designates, reached by a
  ;; literal-offset Gep off that global's `Global` operand. The payload is the
  ;; global's symbol id. This is the same class of word as a descriptor header
  ;; slot -- element storage is disjoint from it -- so the header-load proofs
  ;; accept it, while a store through it stays a header-or-unknown store.
  (GlobalSlot i64))

(defenum OptLicmPtrEnv
  (Nil)
  (Cons i64 OptLicmPtrKind (Box OptLicmPtrEnv)))

(defenum OptLicmRoot
  (NoRoot)
  (Fresh i64)
  (Exclusive i64)
  (Shared i64))

(defenum OptMaybeLicmRoot
  (No)
  (Some OptLicmRoot))

(defstruct OptLicmRootEnv
  (map opt_i64_i64_map.Map))

(import (vector.vector OptLicmRoot core) as opt_licm_store_root_vec)

(defstruct OptLicmStoreRootList
  (items opt_licm_store_root_vec.Vec))

(defstruct OptLicmStoreState
  (summary OptLicmStoreSummary)
  ;; `summary` excludes proven-rooted stores so a distinct checked root can use
  ;; the stronger disjointness proof. Preserve the excluded stores separately;
  ;; composing the two summaries once per loop retains the old LICM decision
  ;; for unrooted loads without merging every ordinary effect twice.
  (rooted-summary OptLicmStoreSummary)
  (ptrs OptLicmPtrEnv)
  (roots OptLicmRootEnv)
  (store-roots OptLicmStoreRootList)
  (any-call? bool)
  ;; Did anything in the body possibly write a GLOBAL CELL? This is the exact
  ;; question opt-licm-globals-clean? asks, tracked on its own rather than read
  ;; off the store summaries, because those answer a different one. A summary
  ;; that is `call-or-unknown?` because a direct callee writes through the
  ;; objects its parameters name says nothing about global storage, and the
  ;; call-memory fixpoint often proves that callee touches none
  ;; (opt-direct-call-global-clean?). Every other contributor sets this flag
  ;; exactly when it sets `call-or-unknown?` or `header-or-unknown-store?`, so
  ;; the only decisions that move are the ones a per-callee summary newly
  ;; proves.
  (global-write? bool)
  ;; Did the body contain a direct call that keeps globals clean ONLY because
  ;; the callee is proven to write no memory at all? That class is priced
  ;; separately from the rest -- a loop whose only call is memory-clean has
  ;; every load, address and descriptor word in it already hoistable, so its
  ;; preheader is the one that is already full -- and this flag is what tells
  ;; the two apart at the loop site. `global-write?` is left alone by such a
  ;; call, so the OLDER verdict is recovered exactly as
  ;; `(and (not global-write?) (not mem-clean-call?))` and nothing outside the
  ;; newly priced class moves. See
  ;; opt-licm-direct-call-keeps-globals-clean?.
  (mem-clean-call? bool))

(define (opt-licm-root-env-with-capacity [capacity : i64]) : OptLicmRootEnv
  (OptLicmRootEnv (opt_i64_i64_map.with-capacity capacity)))

(define (opt-licm-root-encode [root : OptLicmRoot]) : i64
  (match root
    [(OptLicmRoot.NoRoot) -1]
    [(OptLicmRoot.Fresh id) (+ (* id 3) 0)]
    [(OptLicmRoot.Exclusive id) (+ (* id 3) 1)]
    [(OptLicmRoot.Shared id) (+ (* id 3) 2)]))

(define (opt-licm-root-decode [value : i64]) : OptLicmRoot
  (if (< value 0)
    (OptLicmRoot.NoRoot)
    (let
      [id : i64 (/ value 3)]
      [tag : i64 (% value 3)]
      (cond
        [(= tag 0) (OptLicmRoot.Fresh id)]
        [(= tag 1) (OptLicmRoot.Exclusive id)]
        [else (OptLicmRoot.Shared id)]))))

(define (opt-licm-root-eq? [a : OptLicmRoot] [b : OptLicmRoot]) : bool
  (= (opt-licm-root-encode a) (opt-licm-root-encode b)))

(define (opt-licm-root-env-remove!
  [env : (&mut env OptLicmRootEnv)]
  [var : i64]) : unit
  (begin
    (opt_i64_i64_map.remove-ref! (&mut env.map) var)
    unit))

(define (opt-licm-root-env-bind!
  [env : (&mut env OptLicmRootEnv)]
  [var : i64]
  [root : OptLicmRoot]) : unit
  (match root
    [(OptLicmRoot.NoRoot) (opt-licm-root-env-remove! env var)]
    [_
      (opt_i64_i64_map.insert-ref!
        (&mut env.map)
        var
        (opt-licm-root-encode root))]))

(define (opt-licm-root-env-lookup [env : (& env OptLicmRootEnv)] [var : i64]) : OptLicmRoot
  (match (opt_i64_i64_map.get (& env.map) var)
    [(opt_i64_i64_map.LookupFound value) (opt-licm-root-decode value)]
    [(opt_i64_i64_map.LookupMissing) (OptLicmRoot.NoRoot)]))

(define (opt-licm-root-of-value
  [env : (& env OptLicmRootEnv)]
  [value : ir.CompilerIrValue]) : OptLicmRoot
  (match value
    [(ir.CompilerIrValue.Var var) (opt-licm-root-env-lookup env var)]
    [_ (OptLicmRoot.NoRoot)]))

(define (opt-licm-root-env-copy!
  [env : (&mut env OptLicmRootEnv)]
  [dst : i64]
  [src : ir.CompilerIrValue]) : unit
  (let
    [root : OptLicmRoot (opt-licm-root-of-value env src)]
    (opt-licm-root-env-bind! env dst root)))

(define (opt-licm-root-disjoint-store?
  [store-root : OptLicmRoot]
  [load-root : OptLicmRoot]) : bool
  (match store-root
    [(OptLicmRoot.Fresh store-id)
      (match load-root
        [(OptLicmRoot.Fresh load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Exclusive load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Shared load-id) (not (= store-id load-id))]
        [(OptLicmRoot.NoRoot) false])]
    [(OptLicmRoot.Exclusive store-id)
      (match load-root
        [(OptLicmRoot.Fresh load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Exclusive load-id) (not (= store-id load-id))]
        [(OptLicmRoot.Shared load-id) (not (= store-id load-id))]
        [(OptLicmRoot.NoRoot) false])]
    [(OptLicmRoot.Shared _) false]
    [(OptLicmRoot.NoRoot) false]))

(define (opt-licm-store-roots-new) : OptLicmStoreRootList
  (OptLicmStoreRootList (opt_licm_store_root_vec.with-capacity 4)))

(define (opt-licm-store-roots-add
  [stores : OptLicmStoreRootList (:consume)]
  [root : OptLicmRoot]) : OptLicmStoreRootList
  (let
    [items : opt_licm_store_root_vec.Vec stores.items]
    (begin
      (opt_licm_store_root_vec.push (&mut items) root)
      (OptLicmStoreRootList items))))

(define (opt-licm-store-roots-safe?
  [stores : OptLicmStoreRootList]
  [load-root : OptLicmRoot]) : bool
  (let
    [items : opt_licm_store_root_vec.Vec stores.items]
    [slots : (& items (__tl_dyn-array OptLicmRoot))
      (opt_licm_store_root_vec.slots (& items))]
    [index : i64 (- (opt_licm_store_root_vec.len (& items)) 1)]
    [safe? : bool true]
    (begin
      (while (and safe? (>= index 0))
        (begin
          (set!
            safe?
            (opt-licm-root-disjoint-store? (array-ref slots index) load-root))
          (set! index (- index 1))))
      safe?)))

(define (opt-licm-body-map-capacity [body-blocks : ir.CompilerIrBlockList]) : i64
  (+ 1 (ir.compiler-ir-block-list-instruction-count body-blocks)))

(define (opt-licm-collect-defs-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [set : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    set
    (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some var)
        (opt-licm-collect-defs-instr-seq-from
          instrs
          (+ index 1)
          (opt-used-add set var))]
      [(option_i64.None)
        (opt-licm-collect-defs-instr-seq-from instrs (+ index 1) set)])))

(define (opt-licm-collect-defs-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [set : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (opt-licm-collect-defs-instr-seq-from instrs 0 set))

(define (opt-licm-collect-defs-blocks
  [blocks : ir.CompilerIrBlockList]
  [set : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-licm-collect-defs-blocks
            (__tl-box-place rest)
            (opt-licm-collect-defs-instr-seq instrs set))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-collect-defs-blocks (ir.compiler-ir-block-seq-to-list seq) set)]))

;; A `Global` operand is a hidden load of that global's cell -- the backend
;; reads it rip-relative at the use site (`movq sym(%rip), reg`), which is why
;; `GlobalAddr` (`leaq`) is a separate value form. So it is loop-invariant
;; exactly when nothing in the loop body can write that cell, the same question
;; the Load and Gep arms of opt-licm-candidate? already put to the loop's store
;; summaries; `globals-clean?` carries that answer instead of the old blanket
;; refusal. A global cell is written only by `Store` (the rip-relative store
;; form, MemoryWrite -> header-or-unknown-store) or through a pointer derived
;; from `GlobalAddr`, which is never classified DataBuffer/DataElement and so
;; also lands in header-or-unknown-store; a call that may write reaches the
;; summary as call-or-unknown? (indirect/C-ABI/SPMD/unknown-effect direct) or
;; as header-or-unknown-store? (a memory-writing direct call), leaving only
;; calls the P6 dual call-memory facts prove write nothing at all. Element-only
;; stores write element storage, which the memory model keeps disjoint from
;; descriptor header words and equally from named global cells, so they cannot
;; change what a `Global` operand reads.
(define (opt-licm-value-invariant?
  [globals-clean? : bool]
  [loop-defs : opt_i64_i64_map.Map]
  [hoisted : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (or
        (not (opt-used-contains loop-defs var))
        (opt-used-contains hoisted var))]
    [(ir.CompilerIrValue.Global _) globals-clean?]
    [_ true]))

(define (opt-licm-values-invariant?
  [globals-clean? : bool]
  [loop-defs : opt_i64_i64_map.Map]
  [hoisted : opt_i64_i64_map.Map]
  [a : ir.CompilerIrValue]
  [b : ir.CompilerIrValue]) : bool
  (and
    (opt-licm-value-invariant? globals-clean? loop-defs hoisted a)
    (opt-licm-value-invariant? globals-clean? loop-defs hoisted b)))

;; The loop-level precondition for treating a `Global` operand as invariant
;; (see opt-licm-value-invariant?): nothing the body executes can write a global
;; cell.
;;
;; This used to be spelled as two proxies -- `any-call?` plus the composed RAW
;; store summary's header-load-safety -- because no fact answered the actual
;; question. Both proxies over-refuse for the same reason: they answer "can this
;; write MEMORY", and a callee that writes only through the objects its
;; parameters name writes plenty of memory while touching no global storage at
;; all. `global-write?` answers the real question directly, contributed by
;; exactly the terms the two proxies contributed (see the field comment on
;; OptLicmStoreState) except at a direct call the call-memory fixpoint has
;; proven global-clean -- which is the one class of decision this predicate
;; moves.
;;
;; The older reading's register-pressure argument is preserved where it was
;; measured. `any-call?` stays, untouched, on the Gep and Load arms of
;; opt-licm-candidate?, which is where the P6 hoist/allocate interlock priced
;; loop-spanning live ranges that cross a call (cachegrind, one run each on the
;; then-baseline: dropping that term gave back the whole gvn_table win,
;; 1,299,265,156 with it and 1,306,531,147 without against a 1,306,562,712
;; baseline, while buying peephole_lines 7.59M). What a `Global` operand's
;; invariance costs is not a live range that crosses the call -- the promoted
;; cell load lands in the PREHEADER, outside every loop-spanning range that gate
;; is pricing -- so that verdict never applied to this question. The preheader
;; copy is not free either, though: it is one more value live across the loop,
;; which is priced where it is created rather than here
;; (opt-licm-global-promote-live-in-budget).
;;
;; Non-returning trap helpers contribute nothing here for the same reason they
;; contribute no call boundary: the continuing path never resumes after one
;; (opt-licm-store-state-direct-call, opt-direct-call-noreturn?).
(define (opt-licm-globals-clean? [global-write? : bool]) : bool
  (not global-write?))

(define (opt-licm-store-summary-empty) : OptLicmStoreSummary
  (OptLicmStoreSummary false false false false))

(define (opt-licm-store-summary-call-or-unknown) : OptLicmStoreSummary
  (OptLicmStoreSummary true false false false))

(define (opt-licm-store-summary-header-or-unknown-store) : OptLicmStoreSummary
  (OptLicmStoreSummary false true false false))

(define (opt-licm-store-summary-element-only-store) : OptLicmStoreSummary
  (OptLicmStoreSummary false false true false))

(define (opt-licm-store-summary-element-only-call) : OptLicmStoreSummary
  (OptLicmStoreSummary false false false true))

(define (opt-licm-store-summary-merge
  [left : OptLicmStoreSummary]
  [right : OptLicmStoreSummary]) : OptLicmStoreSummary
  (OptLicmStoreSummary
    (or left.call-or-unknown? right.call-or-unknown?)
    (or left.header-or-unknown-store? right.header-or-unknown-store?)
    (or left.element-only-store? right.element-only-store?)
    (or left.element-only-call? right.element-only-call?)))

(define (opt-licm-store-summary-clean? [summary : OptLicmStoreSummary]) : bool
  (and
    (not summary.call-or-unknown?)
    (not summary.header-or-unknown-store?)
    (not summary.element-only-store?)
    (not summary.element-only-call?)))

(define (opt-licm-store-summary-header-load-safe?
  [summary : OptLicmStoreSummary]) : bool
  (and (not summary.call-or-unknown?) (not summary.header-or-unknown-store?)))

;; The CALL boundary the P6/R7 hoist-vs-allocate interlock prices: a
;; loop-spanning live range that has to survive a call costs more in spill
;; staging than the reloads it saves. That is a register-pressure fact about the
;; emitted call, not a memory fact, so an element-only direct call counts here
;; exactly like any other call -- its memory verdict is softer, its calling
;; convention is not.
(define (opt-licm-store-summary-call-boundary? [summary : OptLicmStoreSummary]) : bool
  (or summary.call-or-unknown? summary.element-only-call?))

(define (opt-licm-store-summary-from-effect [effect : ir.CompilerIrEffect]) : OptLicmStoreSummary
  (match effect
    [(ir.CompilerIrEffect.MemoryWrite)
      (opt-licm-store-summary-header-or-unknown-store)]
    [(ir.CompilerIrEffect.CpuProbe) (opt-licm-store-summary-call-or-unknown)]
    [(ir.CompilerIrEffect.Unknown) (opt-licm-store-summary-call-or-unknown)]
    [_ (opt-licm-store-summary-empty)]))

;; The runtime's NON-RETURNING trap helpers: tl_oob_abort (the callee the
;; backend renders as `tl_oob_abort_at` when abort sites are active),
;; tl_div_abort, tl_shift_abort, and the .L_tl_abort prelude label. The IR
;; already carries this classification on the callee identity --
;; compiler-ir-runtime-control-flow-id? IS the recognized set, and giving a
;; direct call the `ControlFlow` effect is the only thing it does -- so every
;; consumer here asks that one predicate instead of re-deriving a name set.
;; Ordinary direct callees classify Unknown; the memory-classified runtime
;; helpers classify MemoryRead/MemoryWrite.
;;
;; SOUNDNESS (why an abort call is not a call for INVARIANCE purposes).
;; Control never returns from these helpers: they are declared `: never` and
;; end the process. Every invariance question the loop passes ask is a question
;; about the CONTINUING path -- "can this instruction, executed once in the
;; preheader, still read what each iteration would have read?", "can anything
;; here write the cell this `Global` operand reads before a later read observes
;; it?". An execution that reaches an abort has no continuing path: no later
;; iteration, no later load, no observation of any cell the helper touched on
;; its way out. So whatever the helper does to memory is unobservable to the
;; code these analyses reason about, exactly like a callee that writes nothing.
;; The abort's own diagnostic is produced from what the helper receives at the
;; call, which this classification does not touch.
;;
;; SCOPE. Invariance only. Nothing here moves, removes, reorders, or re-guards
;; a check or an abort -- checks stay where they are and still trap with the
;; same diagnostic. It does, deliberately, drop these calls from the
;; `any-call?` boundary the P6/R7 hoist-vs-allocate interlock keys on. That
;; gate exists because a loop-spanning live range that crosses a call costs
;; more in spill staging than the reloads it saves; an abort call imposes no
;; such cost, because nothing is live across it -- the continuing path never
;; resumes after it, so the register allocator never has to preserve anything
;; over it. It is a call boundary in the emitted asm and in nothing the
;; interlock is pricing.
(define (opt-direct-call-noreturn? [name : i64]) : bool
  (ir.compiler-ir-runtime-control-flow-id? name))

;; Writes no memory at all -- the fact the store summaries are asking for.
(define (opt-direct-call-memory-clean?
  [direct-call-clean : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (opt-direct-call-clean-has-bit?
    direct-call-clean
    name
    (opt-direct-call-clean-memory-bit)))

;; Writes no GLOBAL storage. Weaker than memory-clean and implied by it, so the
;; test takes either bit. This is what a `Global` operand's invariance needs.
(define (opt-direct-call-global-clean?
  [direct-call-clean : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (opt-direct-call-clean-has-bit?
    direct-call-clean
    name
    (bit-or
      (opt-direct-call-clean-memory-bit)
      (opt-direct-call-clean-global-bit))))

;; Writes ONLY element storage -- the descriptor-safety fact. Strictly weaker
;; than memory-clean and implied by it, so the test takes either bit. This is
;; what a DESCRIPTOR word's invariance needs: the buffer a data slot names is a
;; different allocation from the descriptor that names it, so a callee whose
;; every write lands in element storage cannot change a header word the caller
;; already loaded -- whatever the caller passed it. Unlike the global-clean
;; test, this one needs no call-site argument gate: a `GlobalAddr` argument
;; hands over a CELL's address, and a write through it is not an element write,
;; so such a callee would not carry the bit in the first place (see
;; opt-loop-bce-direct-call-clean-bits, which requires `has-param-writes?`
;; clear).
(define (opt-direct-call-element-clean?
  [direct-call-clean : opt_i64_i64_map.Map]
  [name : i64]) : bool
  (opt-direct-call-clean-has-bit?
    direct-call-clean
    name
    (bit-or
      (opt-direct-call-clean-memory-bit)
      (opt-direct-call-clean-unconditional-global-bit))))

;; Direct callees that DO return. opt-licm-store-state-direct-call filters the
;; non-returning trap helpers out ahead of this, so a ControlFlow effect never
;; reaches the match below and the `_` arm keeps its old meaning: an ordinary
;; direct call of unknown effect.
;;
;; The element-only tier is the middle rung between "writes nothing" and "may
;; write anything". Such a callee gets the same MEMORY verdict an in-function
;; element-only store already gets (opt-licm-store-summary-for-storeptr): not
;; clean, so every root-keyed memory proof still refuses it, but header-load-
;; safe, so a descriptor-header load is not killed by it. Without this the call
;; fell to `call-or-unknown?`, which kills the descriptor class outright -- the
;; reason a `xs.slots` / `slots.len` / `slots.data` chain reloads on every trip
;; of a loop that calls an element-only helper.
;;
;; It gets its own field rather than `element-only-store?` because it is still a
;; CALL: the hoist/allocate interlock reads
;; opt-licm-store-summary-call-boundary? and keeps pricing it as one. Measured,
;; that separation is the whole difference between a win and a loss -- routing
;; the bit through `element-only-store?` instead (so the interlock stopped
;; seeing the call) cost intern_table 602,891,376 -> 611,411,217 (+1.41%) for a
;; gvn_table gain of 0.34M.
(define (opt-licm-store-summary-for-direct-call
  [direct-call-clean : opt_i64_i64_map.Map]
  [name : i64]) : OptLicmStoreSummary
  (if (opt-direct-call-memory-clean? direct-call-clean name)
    (opt-licm-store-summary-empty)
    (if (opt-direct-call-element-clean? direct-call-clean name)
      (opt-licm-store-summary-element-only-call)
      (match (ir.compiler-ir-direct-call-effect-id name)
        [(ir.CompilerIrEffect.MemoryRead) (opt-licm-store-summary-empty)]
        [(ir.CompilerIrEffect.MemoryWrite)
          (opt-licm-store-summary-header-or-unknown-store)]
        [_ (opt-licm-store-summary-call-or-unknown)]))))

(define (opt-licm-ptr-unbind [env : OptLicmPtrEnv] [var : i64]) : OptLicmPtrEnv
  (match env
    [(OptLicmPtrEnv.Nil) (OptLicmPtrEnv.Nil)]
    [(OptLicmPtrEnv.Cons id kind rest)
      (let
        [tail : OptLicmPtrEnv (opt-licm-ptr-unbind (__tl-box-place rest) var)]
        (if (= id var)
          tail
          (OptLicmPtrEnv.Cons id kind (box tail))))]))

(define (opt-licm-ptr-bind
  [env : OptLicmPtrEnv]
  [var : i64]
  [kind : OptLicmPtrKind]) : OptLicmPtrEnv
  (match kind
    [(OptLicmPtrKind.Unknown) (opt-licm-ptr-unbind env var)]
    [_ (OptLicmPtrEnv.Cons var kind (box (opt-licm-ptr-unbind env var)))]))

(define (opt-licm-ptr-lookup [env : OptLicmPtrEnv] [var : i64]) : OptLicmPtrKind
  (match env
    [(OptLicmPtrEnv.Nil) (OptLicmPtrKind.Unknown)]
    [(OptLicmPtrEnv.Cons id kind rest)
      (if (= id var)
        kind
        (opt-licm-ptr-lookup (__tl-box-place rest) var))]))

(define (opt-licm-type-env-bind
  [types : OptSsaVarTypes]
  [var : i64]
  [ty : ast.AstType]) : OptSsaVarTypes
  (opt-ssa-var-types-set types var ty))

(define (opt-licm-type-env-add-param
  [types : OptSsaVarTypes]
  [param : ir.CompilerIrParam]) : OptSsaVarTypes
  (match param
    [(ir.CompilerIrParam.Param _ ty var) (opt-licm-type-env-bind types var ty)]))

(define (opt-licm-type-env-add-params
  [params : ir.CompilerIrParamList]
  [types : OptSsaVarTypes]) : OptSsaVarTypes
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) types]
    [(ir.CompilerIrParamList.Array seq)
      (opt-licm-type-env-add-params
        (ir.compiler-ir-param-seq-to-list seq)
        types)]
    [(ir.CompilerIrParamList.Cons param rest)
      (opt-licm-type-env-add-params
        (__tl-box-place rest)
        (opt-licm-type-env-add-param types param))]))

(define (opt-licm-type-env-add-instr
  [types : OptSsaVarTypes]
  [instr : ir.CompilerIrInstr]) : OptSsaVarTypes
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ ty) (opt-licm-type-env-bind types dst ty)]
    [(ir.CompilerIrInstr.Load dst _ ty) (opt-licm-type-env-bind types dst ty)]
    [(ir.CompilerIrInstr.Call dst _ _ ty) (opt-licm-type-env-bind types dst ty)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ ty)
      (opt-licm-type-env-bind types dst ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ ty)
      (opt-licm-type-env-bind types dst ty)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) types]
          [(ir.CompilerIrSpmdCallResult.Value dst class ty)
            (match class
              [(ir.CompilerIrSpmdValueClass.Uniform)
                (opt-licm-type-env-bind types dst ty)]
              [_ types])]))]
    [(ir.CompilerIrInstr.Phi dst _ ty) (opt-licm-type-env-bind types dst ty)]
    [_ types]))

(define (opt-licm-type-env-add-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [types : OptSsaVarTypes]) : OptSsaVarTypes
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    types
    (opt-licm-type-env-add-instr-seq-from
      instrs
      (+ index 1)
      (opt-licm-type-env-add-instr
        types
        (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-licm-type-env-add-blocks
  [blocks : ir.CompilerIrBlockList]
  [types : OptSsaVarTypes]) : OptSsaVarTypes
  (match blocks
    [(ir.CompilerIrBlockList.Nil) types]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-licm-type-env-add-blocks
            (__tl-box-place rest)
            (opt-licm-type-env-add-instr-seq-from instrs 0 types))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-type-env-add-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        types)]))

(define (opt-licm-type-env-from-function
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptSsaVarTypes
  (opt-licm-type-env-add-blocks
    blocks
    (opt-licm-type-env-add-params params (opt-ssa-var-types-new))))

(define (opt-licm-param-root
  [type-segment-bases : i64]
  [ty : ast.AstType]
  [var : i64]) : OptLicmRoot
  (match ty
    [(ast.AstType.Ref _ _) (OptLicmRoot.Shared var)]
    [(ast.AstType.MutRef _ _) (OptLicmRoot.Exclusive var)]
    [(ast.AstType.Region _ inner)
      (opt-licm-param-root
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner)
        var)]
    [_ (OptLicmRoot.NoRoot)]))

(define (opt-licm-root-env-seed-param!
  [type-segment-bases : i64]
  [env : (&mut env OptLicmRootEnv)]
  [param : ir.CompilerIrParam]) : unit
  (match param
    [(ir.CompilerIrParam.Param _ ty var)
      (opt-licm-root-env-bind!
        env
        var
        (opt-licm-param-root type-segment-bases ty var))]))

(define (opt-licm-root-env-seed-params!
  [type-segment-bases : i64]
  [env : (&mut env OptLicmRootEnv)]
  [params : ir.CompilerIrParamList]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (opt-licm-root-env-seed-params!
        type-segment-bases
        env
        (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons param rest)
      (begin
        (opt-licm-root-env-seed-param! type-segment-bases env param)
        (opt-licm-root-env-seed-params!
          type-segment-bases
          env
          (__tl-box-place rest)))]))

(define (opt-licm-phi-root
  [env : (& env OptLicmRootEnv)]
  [inputs : ir.CompilerIrPhiInputList]
  [found : OptMaybeLicmRoot]) : OptMaybeLicmRoot
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) found]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-licm-phi-root env (ir.compiler-ir-phi-input-seq-to-list seq) found)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [root : OptLicmRoot (opt-licm-root-of-value env value)]
        (match root
          [(OptLicmRoot.NoRoot) (OptMaybeLicmRoot.No)]
          [_
            (match found
              [(OptMaybeLicmRoot.No)
                (opt-licm-phi-root
                  env
                  (__tl-box-place rest)
                  (OptMaybeLicmRoot.Some root))]
              [(OptMaybeLicmRoot.Some previous)
                (if (opt-licm-root-eq? previous root)
                  (opt-licm-phi-root env (__tl-box-place rest) found)
                  (OptMaybeLicmRoot.No))])]))]))

(define (opt-licm-root-env-update-instr!
  [env : (&mut env OptLicmRootEnv)]
  [instr : ir.CompilerIrInstr]) : unit
  (match instr
    [(ir.CompilerIrInstr.Alloc dst _)
      (opt-licm-root-env-bind! env dst (OptLicmRoot.Fresh dst))]
    [(ir.CompilerIrInstr.Gep dst base _ _)
      (opt-licm-root-env-copy! env dst base)]
    [(ir.CompilerIrInstr.Mov dst src _) (opt-licm-root-env-copy! env dst src)]
    [(ir.CompilerIrInstr.Cast dst src _ _)
      (opt-licm-root-env-copy! env dst src)]
    [(ir.CompilerIrInstr.Bitcast dst src _ _)
      (opt-licm-root-env-copy! env dst src)]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (match (opt-licm-phi-root env inputs (OptMaybeLicmRoot.No))
        [(OptMaybeLicmRoot.No) (opt-licm-root-env-remove! env dst)]
        [(OptMaybeLicmRoot.Some root) (opt-licm-root-env-bind! env dst root)])]
    ;; A descriptor-data Load may be rebound by
    ;; opt-licm-provenance-state-instr immediately after this update.
    [(ir.CompilerIrInstr.Load dst _ _) (opt-licm-root-env-remove! env dst)]
    [(ir.CompilerIrInstr.Call dst name _ _)
      (if (ir.compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
        (opt-licm-root-env-bind! env dst (OptLicmRoot.Fresh dst))
        unit)]
    [_ unit]))

(define (opt-licm-array-header-type?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.DynArray _) true]
    [(ast.AstType.String) true]
    [(ast.AstType.Str) true]
    [(ast.AstType.Bytes) true]
    [(ast.AstType.Ref _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [(ast.AstType.MutRef _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [(ast.AstType.Region _ inner)
      (opt-licm-array-header-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [_ false]))

(define (opt-licm-array-header-var?
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [var : i64]) : bool
  (match (opt-ssa-var-types-lookup types var)
    [(OptMaybeAstType.Some ty)
      (opt-licm-array-header-type? type-segment-bases ty)]
    [(OptMaybeAstType.No) false]))

;; #M-E: the data-pointer slot of an array/string descriptor is fat offset 0.
;; A zero literal offset addresses byte 0 regardless of the GEP's scale type,
;; so accept any element type here: the real array lowering emits
;; `Gep arr 0 i64` (lower-array-element-addr-finish) while the string path
;; emits `Gep arr 0 u8` -- the old U8-only match classified array data-slot
;; GEPs as Unknown, which turned element stores into header-or-unknown stores
;; and blocked descriptor-load hoisting.
(define (opt-licm-data-slot? [offset : ir.CompilerIrValue] [_ty : ast.AstType]) : bool
  (match offset
    [(ir.CompilerIrValue.I64 value) (= value 0)]
    [_ false]))

(define (opt-licm-header-slot-gep?
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [base : ir.CompilerIrValue]
  [offset : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (match base
    [(ir.CompilerIrValue.Var base-var)
      (and
        (opt-licm-array-header-var? type-segment-bases types base-var)
        (or
          (opt-bounds-object-length-slot? type-segment-bases offset ty)
          (opt-licm-data-slot? offset ty)))]
    [_ false]))

(define (opt-licm-header-slot-ptr-kind? [kind : OptLicmPtrKind]) : bool
  (match kind
    [(OptLicmPtrKind.HeaderSlot _) true]
    [(OptLicmPtrKind.DataSlot _) true]
    [(OptLicmPtrKind.GlobalSlot _) true]
    [_ false]))

(define (opt-licm-header-slot-source?
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [ptrs : OptLicmPtrEnv]
  [late? : bool]
  [src : ir.CompilerIrValue]) : bool
  (match src
    [(ir.CompilerIrValue.Var ptr-var)
      (or
        ;; GVN canonicalizes a zero-offset descriptor Gep back to the
        ;; descriptor handle itself. Preserve the same header-slot fact for
        ;; that direct `load %array` spelling. Enable this only in the
        ;; post-BCE LICM run so moving the length cannot hide the identity an
        ;; enclosing loop's bounds-check elimination still needs.
        (and
          late?
          (opt-licm-array-header-var? type-segment-bases types ptr-var))
        (opt-licm-header-slot-ptr-kind? (opt-licm-ptr-lookup ptrs ptr-var)))]
    [_ false]))

(define (opt-licm-gep-kind
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [ptrs : OptLicmPtrEnv]
  [base : ir.CompilerIrValue]
  [offset : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptLicmPtrKind
  (match base
    [(ir.CompilerIrValue.Var base-var)
      (let
        [base-kind : OptLicmPtrKind (opt-licm-ptr-lookup ptrs base-var)]
        (match base-kind
          [(OptLicmPtrKind.DataBuffer object)
            (OptLicmPtrKind.DataElement object)]
          [(OptLicmPtrKind.DataElement object)
            ;; Address adjustment within a loaded data buffer stays in that
            ;; buffer. Lowering commonly emits one Gep for the scaled slot
            ;; address and another for an inline field within the slot.
            (OptLicmPtrKind.DataElement object)]
          [_
            (if (opt-licm-array-header-var? type-segment-bases types base-var)
              (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
                (OptLicmPtrKind.HeaderSlot base-var)
                (if (opt-licm-data-slot? offset ty)
                  (OptLicmPtrKind.DataSlot base-var)
                  (OptLicmPtrKind.Unknown)))
              (OptLicmPtrKind.Unknown))]))]
    ;; `Gep <global operand>, <literal>` addresses a fixed word of the object
    ;; that global's cell designates -- the descriptor handle a `Vec`/array
    ;; global holds, or the handle's own header words. A variable offset is
    ;; element indexing and stays Unknown.
    [(ir.CompilerIrValue.Global name)
      (match offset
        [(ir.CompilerIrValue.I64 _) (OptLicmPtrKind.GlobalSlot name)]
        [_ (OptLicmPtrKind.Unknown)])]
    [_ (OptLicmPtrKind.Unknown)]))

(define (opt-licm-store-state-with-provenance
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]) : OptLicmStoreState
  (OptLicmStoreState
    (opt-licm-store-summary-empty)
    (opt-licm-store-summary-empty)
    ptrs
    roots
    (opt-licm-store-roots-new)
    false
    false
    false))

;; The part of a store summary that can reach a global cell: an unknown call and
;; an unknown-or-header store both can, an element-only store cannot (its
;; pointer is a descriptor's data, never a cell -- the same argument the older
;; opt-licm-store-summary-header-load-safe? made).
(define (opt-licm-store-summary-global-write? [summary : OptLicmStoreSummary]) : bool
  (or summary.call-or-unknown? summary.header-or-unknown-store?))

(define (opt-licm-store-state-add-summary-keeping-globals
  [state : OptLicmStoreState]
  [summary : OptLicmStoreSummary]) : OptLicmStoreState
  (OptLicmStoreState
    (opt-licm-store-summary-merge state.summary summary)
    state.rooted-summary
    state.ptrs
    state.roots
    state.store-roots
    state.any-call?
    state.global-write?
    state.mem-clean-call?))

(define (opt-licm-store-state-add-summary
  [state : OptLicmStoreState]
  [summary : OptLicmStoreSummary]) : OptLicmStoreState
  (OptLicmStoreState
    (opt-licm-store-summary-merge state.summary summary)
    state.rooted-summary
    state.ptrs
    state.roots
    state.store-roots
    state.any-call?
    (or state.global-write? (opt-licm-store-summary-global-write? summary))
    state.mem-clean-call?))

(define (opt-licm-store-state-bind-ptr
  [state : OptLicmStoreState]
  [var : i64]
  [kind : OptLicmPtrKind]) : OptLicmStoreState
  (OptLicmStoreState
    state.summary
    state.rooted-summary
    (opt-licm-ptr-bind state.ptrs var kind)
    state.roots
    state.store-roots
    state.any-call?
    state.global-write?
    state.mem-clean-call?))

(define (opt-licm-store-state-bind-root
  [state : OptLicmStoreState (:consume)]
  [var : i64]
  [root : OptLicmRoot]) : OptLicmStoreState
  (begin
    (opt-licm-root-env-bind! (&mut state.roots) var root)
    state))

(define (opt-licm-store-state-add-rooted-store
  [state : OptLicmStoreState]
  [root : OptLicmRoot]
  [summary : OptLicmStoreSummary]) : OptLicmStoreState
  (OptLicmStoreState
    state.summary
    (opt-licm-store-summary-merge state.rooted-summary summary)
    state.ptrs
    state.roots
    (opt-licm-store-roots-add state.store-roots root)
    state.any-call?
    (or state.global-write? (opt-licm-store-summary-global-write? summary))
    state.mem-clean-call?))

(define (opt-licm-store-state-mark-call [state : OptLicmStoreState]) : OptLicmStoreState
  (OptLicmStoreState
    state.summary
    state.rooted-summary
    state.ptrs
    state.roots
    state.store-roots
    true
    state.global-write?
    state.mem-clean-call?))

(define (opt-licm-store-state-mark-global-write [state : OptLicmStoreState]) : OptLicmStoreState
  (OptLicmStoreState
    state.summary
    state.rooted-summary
    state.ptrs
    state.roots
    state.store-roots
    state.any-call?
    true
    state.mem-clean-call?))

(define (opt-licm-store-state-mark-mem-clean-call [state : OptLicmStoreState]) : OptLicmStoreState
  (OptLicmStoreState
    state.summary
    state.rooted-summary
    state.ptrs
    state.roots
    state.store-roots
    state.any-call?
    state.global-write?
    true))

;; Fold a DIRECT call (`Call` or `TailCall`) into the body state: the call
;; boundary plus the callee's store facts. A non-returning trap helper
;; contributes NEITHER -- see opt-direct-call-noreturn? for the full argument.
;; It is not a call boundary for `any-call?`, and it adds no store summary, so
;; a loop whose only call is a bounds/divide/shift trap reads as call-free to
;; every invariance question the loop passes ask.
;;
;; The store summary and the global-cell flag part company here, and this is the
;; only place they do. A callee that writes through the objects its parameters
;; name is `call-or-unknown?` to every memory question -- it can invalidate a
;; load of any of those objects -- while the call-memory fixpoint proves it has
;; no direct global write. That weaker proof is enough only when the whole
;; program contains no `GlobalAddr`: a cell address can otherwise arrive through
;; an SSA copy, Phi, caller parameter, or returned reference, so inspecting just
;; the call's immediate operands is not a sound alias test. The program-wide
;; address-taken set closes every such path. A summary whose writes are all to
;; descriptor ELEMENT storage needs no such condition because that storage is
;; disjoint from every global cell. Everything else about the call --
;; the `any-call?` boundary the register-pressure interlock prices, the store
;; summary the memory proofs read -- is unchanged.
;;
;; A MEMORY-clean callee -- the stronger fact, and the one this predicate used
;; to REFUSE with an explicit `(not (memory-clean? name))` clause -- is admitted
;; here, but only to the loop-scope cell PROMOTION and only under a live-in
;; budget. The refusal was never a soundness claim; it was an unpaid trade, and
;; the two halves of that trade turn out to be separable.
;;
;; WHAT THE OLD CLAUSE COST AND BOUGHT. Dropping it outright (one cachegrind run
;; each) gives peephole_lines 667,587,443 -> 647,836,877 (-2.96%) and takes
;; gvn_table 1,165,315,557 -> 1,174,025,601 (+0.75%), intern_table 611,002,492
;; -> 614,441,836 (+0.56%), cfg_domloops 768,935,005 -> 769,279,945 (+0.04%).
;;
;; THE TRADE SPLITS IN TWO. `globals-clean?` drives two unrelated things: the
;; INVARIANCE question opt-licm-candidate? asks of a `Global` operand, and the
;; loop-scope cell promotion (opt-licm-global-promote). Measured separately on
;; this corpus:
;;
;;   relaxed invariance only:  peephole -10.9M, gvn +8.7M, intern +3.4M
;;   relaxed promotion only:   peephole -19.7M, gvn  0.0M, intern +3.4M
;;
;; The whole peephole prize is the PROMOTION's; the whole gvn_table loss is the
;; INVARIANCE relaxation's. So invariance keeps the old refusal (see
;; `globals-clean-strict?` at the loop site) and only promotion is relaxed.
;;
;; WHY INVARIANCE LOSES. Relaxing it opens a whole hoist CHAIN rooted at the
;; cell read -- the cell load, the descriptor it designates, that descriptor's
;; length and data words -- and every link is a new loop-spanning value.
;; _tl_bench_gvn_table_lookup is the shape: a hash-chain walk over two array
;; globals, two links each, whose preheader grows from 2 callee-saved pushes to
;; 6. The loop saves 2-3 instructions per iteration and pays 8 for the extra
;; push/pop pairs on every CALL, and the chain it walks is one or two nodes
;; long. The promotion cannot do this: it rewrites `@g` operands in place and
;; moves no dependent load, so it adds exactly one loop-spanning value per cell.
;;
;; WHY THE PROMOTION STILL NEEDS A BUDGET. That one value per cell still has to
;; live across the whole loop, and in a body that already enters with more live
;; values than the register file can hold it does not get a register: it lands
;; in a frame slot, the preheader pays a load AND a spill store on every loop
;; ENTRY, each use trades a rip-relative load for an equal-length frame load,
;; and the frame grows. That is the entire intern_table regression, in one loop
;; -- it_intern_slice's probe loop, frame 264 -> 280 bytes, promoted
;; `it_state_capacity` homed at 192(%rsp), +2 instructions and +2 frame
;; accesses. opt-licm-global-promote-live-in-budget is what refuses it.
(define (opt-licm-direct-call-keeps-globals-clean?
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [name : i64]) : bool
  (and
    (opt-direct-call-global-clean? direct-call-clean name)
    (or
      (opt-direct-call-clean-has-bit?
        direct-call-clean
        name
        (opt-direct-call-clean-unconditional-global-bit))
      (= (opt_i64_i64_map.len (& global-cells.addr-taken)) 0))))

(define (opt-licm-store-state-direct-call
  [state : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [name : i64]) : OptLicmStoreState
  (if (opt-direct-call-noreturn? name)
    state
    (let
      [called : OptLicmStoreState (opt-licm-store-state-mark-call state)]
      [summary : OptLicmStoreSummary
        (opt-licm-store-summary-for-direct-call direct-call-clean name)]
      (if (opt-licm-direct-call-keeps-globals-clean?
        direct-call-clean
        global-cells
        name)
        (opt-licm-store-state-add-summary-keeping-globals
          (if (opt-direct-call-memory-clean? direct-call-clean name)
            (opt-licm-store-state-mark-mem-clean-call called)
            called)
          summary)
        ;; Unproven: the flag is set here rather than left to the summary,
        ;; because a memory-clean callee contributes the EMPTY summary and would
        ;; otherwise sail through. `any-call?` used to be what closed that case.
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-global-write called)
          summary)))))

(define (opt-licm-store-state-invalidate-ptr-def
  [state : OptLicmStoreState]
  [var : i64]) : OptLicmStoreState
  (OptLicmStoreState
    state.summary
    state.rooted-summary
    (opt-licm-ptr-unbind state.ptrs var)
    state.roots
    state.store-roots
    state.any-call?
    state.global-write?
    state.mem-clean-call?))

(define (opt-licm-store-state-invalidate-ptr-instr
  [state : OptLicmStoreState]
  [instr : ir.CompilerIrInstr]) : OptLicmStoreState
  (match (opt-instr-def-var instr)
    [(option_i64.Some var) (opt-licm-store-state-invalidate-ptr-def state var)]
    [(option_i64.None) state]))

(define (opt-licm-store-summary-for-storeptr
  [ptrs : OptLicmPtrEnv]
  [ptr : ir.CompilerIrValue]) : OptLicmStoreSummary
  (match ptr
    [(ir.CompilerIrValue.Var ptr-var)
      (match (opt-licm-ptr-lookup ptrs ptr-var)
        [(OptLicmPtrKind.DataBuffer _)
          (opt-licm-store-summary-element-only-store)]
        [(OptLicmPtrKind.DataElement _)
          (opt-licm-store-summary-element-only-store)]
        [_ (opt-licm-store-summary-header-or-unknown-store)])]
    [_ (opt-licm-store-summary-header-or-unknown-store)]))

(define (opt-licm-provenance-state-instr
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [state : OptLicmStoreState]
  [instr : ir.CompilerIrInstr]) : OptLicmStoreState
  (let
    [invalid : OptLicmStoreState
      (opt-licm-store-state-invalidate-ptr-instr state instr)]
    [_roots : unit (opt-licm-root-env-update-instr! (&mut invalid.roots) instr)]
    (match instr
      [(ir.CompilerIrInstr.Mov dst src _)
        (match src
          [(ir.CompilerIrValue.Var src-var)
            (opt-licm-store-state-bind-ptr
              invalid
              dst
              (opt-licm-ptr-lookup invalid.ptrs src-var))]
          [_ invalid])]
      [(ir.CompilerIrInstr.Gep dst base offset ty)
        (opt-licm-store-state-bind-ptr
          invalid
          dst
          (opt-licm-gep-kind
            type-segment-bases
            types
            invalid.ptrs
            base
            offset
            ty))]
      [(ir.CompilerIrInstr.Load dst src _)
        (match src
          [(ir.CompilerIrValue.Var ptr-var)
            (match (opt-licm-ptr-lookup invalid.ptrs ptr-var)
              [(OptLicmPtrKind.DataSlot object)
                (opt-licm-store-state-bind-root
                  (opt-licm-store-state-bind-ptr
                    invalid
                    dst
                    (OptLicmPtrKind.DataBuffer object))
                  dst
                  (opt-licm-root-env-lookup invalid.roots object))]
              [_
                (if (opt-licm-array-header-var?
                  type-segment-bases
                  types
                  ptr-var)
                  (opt-licm-store-state-bind-root
                    (opt-licm-store-state-bind-ptr
                      invalid
                      dst
                      (OptLicmPtrKind.DataBuffer ptr-var))
                    dst
                    (opt-licm-root-env-lookup invalid.roots ptr-var))
                  invalid)])]
          [_ invalid])]
      [_ invalid])))

(define (opt-licm-store-state-instr
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [state : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [track-provenance? : bool]
  [instr : ir.CompilerIrInstr]) : OptLicmStoreState
  (let
    [provenance : OptLicmStoreState
      (if track-provenance?
        (opt-licm-provenance-state-instr type-segment-bases types state instr)
        state)]
    (match instr
      [(ir.CompilerIrInstr.Call _ name _ _)
        (opt-licm-store-state-direct-call
          provenance
          direct-call-clean
          global-cells
          name)]
      [(ir.CompilerIrInstr.CallIndirect _ _ _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(ir.CompilerIrInstr.CallIndirectC _ _ _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(ir.CompilerIrInstr.SpmdCall payload-box)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(ir.CompilerIrInstr.TailCall name _ _)
        (opt-licm-store-state-direct-call
          provenance
          direct-call-clean
          global-cells
          name)]
      [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
        (opt-licm-store-state-add-summary
          (opt-licm-store-state-mark-call provenance)
          (opt-licm-store-summary-call-or-unknown))]
      [(ir.CompilerIrInstr.StorePtr ptr _ _)
        (let
          [root : OptLicmRoot (opt-licm-root-of-value provenance.roots ptr)]
          [legacy-summary : OptLicmStoreSummary
            (opt-licm-store-summary-for-storeptr provenance.ptrs ptr)]
          (match root
            [(OptLicmRoot.Fresh _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [(OptLicmRoot.Exclusive _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [_ (opt-licm-store-state-add-summary provenance legacy-summary)]))]
      ;; Vector stores use the same base-pointer provenance as StorePtr. Treat
      ;; them as element writes so descriptor data/length loads can move out of
      ;; an enclosing repetition loop while remaining blocked by an aliasing
      ;; store to that descriptor.
      [(ir.CompilerIrInstr.VectorStore payload-box)
        (let
          [base : ir.CompilerIrValue
            (__tl-project-field (__tl-box-place payload-box) base)]
          [root : OptLicmRoot (opt-licm-root-of-value provenance.roots base)]
          [legacy-summary : OptLicmStoreSummary
            (opt-licm-store-summary-for-storeptr provenance.ptrs base)]
          (match root
            [(OptLicmRoot.Fresh _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [(OptLicmRoot.Exclusive _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [_ (opt-licm-store-state-add-summary provenance legacy-summary)]))]
      [(ir.CompilerIrInstr.PredicatedStore payload-box)
        (let
          [base : ir.CompilerIrValue
            (__tl-project-field (__tl-box-place payload-box) base)]
          [root : OptLicmRoot (opt-licm-root-of-value provenance.roots base)]
          [legacy-summary : OptLicmStoreSummary
            (opt-licm-store-summary-for-storeptr provenance.ptrs base)]
          (match root
            [(OptLicmRoot.Fresh _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [(OptLicmRoot.Exclusive _)
              (opt-licm-store-state-add-rooted-store
                provenance
                root
                legacy-summary)]
            [_ (opt-licm-store-state-add-summary provenance legacy-summary)]))]
      [(ir.CompilerIrInstr.CopyBytes _ _ _)
        (opt-licm-store-state-add-summary
          provenance
          (opt-licm-store-summary-header-or-unknown-store))]
      ;; A named global-cell write is the one write whose target is a SYMBOL
      ;; rather than a pointer, so it can be classified by name instead of by
      ;; may-alias. A cell holds a descriptor HANDLE (or a scalar); the two
      ;; header words a handle points at live in the object, never in the cell,
      ;; so `Store G` cannot invalidate a descriptor data/length load -- the
      ;; same allocation-layer argument the load table's granular kill makes
      ;; (see opt-load-entry-survives-global-cell-store?). It therefore
      ;; contributes the element-only class, which leaves
      ;; opt-licm-store-summary-header-load-safe? true and the descriptor-header
      ;; hoist available, while the global-write flag is raised EXPLICITLY so
      ;; `Global` operand promotion still refuses: that pass reasons about cell
      ;; CONTENTS, which is exactly what this instruction changes.
      [(ir.CompilerIrInstr.Store _ _ _)
        (opt-licm-store-state-add-summary-keeping-globals
          (opt-licm-store-state-mark-global-write provenance)
          (opt-licm-store-summary-element-only-store))]
      [_
        (opt-licm-store-state-add-summary
          provenance
          (opt-licm-store-summary-from-effect
            (ir.compiler-ir-instr-effect instr)))])))

(define (opt-licm-store-state-instr-seq-from
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [track-provenance? : bool]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    state
    (opt-licm-store-state-instr-seq-from
      type-segment-bases
      types
      instrs
      (+ index 1)
      direct-call-clean
      global-cells
      track-provenance?
      (opt-licm-store-state-instr
        type-segment-bases
        types
        state
        direct-call-clean
        global-cells
        track-provenance?
        (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-licm-store-state-instr-seq
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [track-provenance? : bool]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (opt-licm-store-state-instr-seq-from
    type-segment-bases
    types
    instrs
    0
    direct-call-clean
    global-cells
    track-provenance?
    state))

(define (opt-licm-store-state-blocks
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [track-provenance? : bool]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (match blocks
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-licm-store-state-blocks
            type-segment-bases
            types
            (__tl-box-place rest)
            direct-call-clean
            global-cells
            track-provenance?
            (opt-licm-store-state-instr-seq
              type-segment-bases
              types
              instrs
              direct-call-clean
              global-cells
              track-provenance?
              state))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-store-state-blocks
        type-segment-bases
        types
        (ir.compiler-ir-block-seq-to-list seq)
        direct-call-clean
        global-cells
        track-provenance?
        state)]))

(define (opt-licm-provenance-state-instr-seq-from
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    state
    (opt-licm-provenance-state-instr-seq-from
      type-segment-bases
      types
      instrs
      (+ index 1)
      (opt-licm-provenance-state-instr
        type-segment-bases
        types
        state
        (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-licm-provenance-state-blocks
  [type-segment-bases : i64]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [state : OptLicmStoreState]) : OptLicmStoreState
  (match blocks
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-licm-provenance-state-blocks
            type-segment-bases
            types
            (__tl-box-place rest)
            (opt-licm-provenance-state-instr-seq-from
              type-segment-bases
              types
              instrs
              0
              state))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-provenance-state-blocks
        type-segment-bases
        types
        (ir.compiler-ir-block-seq-to-list seq)
        state)]))

;; Collect canonical checked-reference/fresh-allocation roots for the whole
;; verified SSA function. A second pass resolves same-root Phi joins whose
;; backedge or later-listed predecessor was not known on the first pass; an
;; unresolved/mixed join remains unrooted and therefore conservative.
(define (opt-licm-provenance-state-from-function
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]) : OptLicmStoreState
  (let
    ;; Rooted pointer values are sparse even in functions with large SSA
    ;; frames. Starting this map at the full frame size retained hundreds of
    ;; megabytes across compiler optimization; let the generated hashmap grow
    ;; only when a function actually carries many checked/fresh roots.
    [roots : OptLicmRootEnv (opt-licm-root-env-with-capacity 17)]
    [_params : unit
      (opt-licm-root-env-seed-params! type-segment-bases (&mut roots) params)]
    [initial : OptLicmStoreState
      (opt-licm-store-state-with-provenance (OptLicmPtrEnv.Nil) roots)]
    [first : OptLicmStoreState
      (opt-licm-provenance-state-blocks type-segment-bases types blocks initial)]
    (opt-licm-provenance-state-blocks type-segment-bases types blocks first)))

(define (opt-licm-store-summary-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [summary : OptLicmStoreSummary]) : OptLicmStoreSummary
  (let
    [state : OptLicmStoreState
      (opt-licm-store-state-blocks
        type-segment-bases
        (opt-ssa-var-types-new)
        blocks
        (opt_i64_i64_map.with-capacity 1)
        (opt-global-cell-summary-empty)
        true
        (OptLicmStoreState
          summary
          (opt-licm-store-summary-empty)
          (OptLicmPtrEnv.Nil)
          (opt-licm-root-env-with-capacity 17)
          (opt-licm-store-roots-new)
          false
          false
          false))]
    (opt-licm-store-summary-merge state.summary state.rooted-summary)))

(define (opt-licm-memory-safe?
  [root-summary : OptLicmStoreSummary]
  [legacy-summary : OptLicmStoreSummary]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [load-root : OptLicmRoot]
  [legacy-special-safe? : bool]) : bool
  (match load-root
    [(OptLicmRoot.NoRoot)
      (or (opt-licm-store-summary-clean? legacy-summary) legacy-special-safe?)]
    [_
      (and
        ;; A call in the body used to close this path outright. That is what a
        ;; call whose effects are unknown demands, but a DIRECT call already
        ;; proven memory-clean contributes `opt-licm-store-summary-empty` (see
        ;; opt-licm-store-summary-for-direct-call), so it can write neither the
        ;; loaded root nor any other object: nothing it does can invalidate a
        ;; load the summaries already certify. Recognizing that is the same
        ;; refinement the Gep arm of opt-licm-candidate? already applies, moved
        ;; here so the Load arm shares it. `any-call?` still closes the path for
        ;; indirect, C-ABI and SPMD calls, which set call-or-unknown? in both
        ;; summaries and therefore fail this disjunct -- as does an element-only
        ;; direct call, whose softer memory verdict buys it nothing here: this
        ;; disjunct is the register-pressure boundary, not a memory proof.
        (or
          (not any-call?)
          (and
            (not (opt-licm-store-summary-call-boundary? root-summary))
            (not (opt-licm-store-summary-call-boundary? legacy-summary))))
        (or
          ;; Root identity is a coarse object-level fact. Preserve the older,
          ;; more precise descriptor-header proof when stores touch only data
          ;; elements of that same object.
          legacy-special-safe?
          (and
            (opt-licm-store-summary-clean? root-summary)
            (opt-licm-store-roots-safe? store-roots load-root))))]))

(define (opt-licm-vector-memory-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorStore _) true]
    [(ir.CompilerIrInstr.PredicatedLoad _) true]
    [(ir.CompilerIrInstr.PredicatedStore _) true]
    [_ false]))

(define (opt-licm-vector-memory-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-licm-vector-memory-instr?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-licm-vector-memory-instrs? instrs (+ index 1)))))

(define (opt-licm-vector-memory-blocks? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-licm-vector-memory-instrs? instrs 0)
            (opt-licm-vector-memory-blocks? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-vector-memory-blocks? (ir.compiler-ir-block-seq-to-list seq))]))

;; LICM modes: 0 is the ordinary pre-BCE pass, 1 is the scalar post-LFTR pass,
;; and 2 is the post-LFTR pass for a loop with vector memory operations.
(define (opt-licm-mode-late? [mode : i64]) : bool
  (> mode 0))

(define (opt-licm-mode-vector? [mode : i64]) : bool
  (= mode 2))

;; `descriptor-header-hoist?` licenses the descriptor-header exception to the
;; return-shaped side-exit suppression (see opt-licm-apply-loop): it is true
;; exactly when this is a late (post-BCE) run AND the loop body's raw store
;; summary is header-load-safe -- no call with an unknown or memory-writing
;; effect and no header-or-unknown store anywhere in the body (element-only
;; stores through a descriptor's loaded data pointer remain, but those write
;; element storage, which the memory model keeps disjoint from descriptor
;; header words). Under that condition a `Load` whose address is a descriptor
;; header slot -- the data-pointer slot or the length slot of a loop-invariant
;; array/string handle -- reads the same value on every iteration, so moving
;; it to the preheader is sound: nothing in the body can write the slot, and
;; reading the header of a live descriptor is always safe (a dangling handle
;; is already UB; the bce guard hoist and the unsuppressed loops already
;; speculate header loads the same way). The exception is late-only for the
;; established reason: before BCE, moving a descriptor length can hide the
;; shared bound identity bounds-check elimination still needs.
(define (opt-licm-candidate?
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [hoisted : opt_i64_i64_map.Map]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [licm-mode : i64]
  [descriptor-header-hoist? : bool]
  ;; Whether a `Global` operand -- a hidden rip-relative load of that global's
  ;; cell -- reads the same value on every iteration of this loop. See
  ;; opt-licm-value-invariant? and opt-licm-globals-clean?.
  [globals-clean? : bool]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _)
      (and
        (opt-licm-mode-late? licm-mode)
        (opt-licm-value-invariant? globals-clean? loop-defs hoisted src)
        ;; In scalar loops, do not lengthen an arbitrary outside value's live
        ;; range merely to move its copy (the quicksort copy-c-string
        ;; regression). Literal seeds still unlock folding/motion. Vector loops
        ;; also keep copies: splitting their data-pointer live ranges prevents
        ;; the backend from reloading each pointer for every unrolled access.
        (match src
          [(ir.CompilerIrValue.Var _) (opt-licm-mode-vector? licm-mode)]
          [_ true]))]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (and
        (opt-licm-mode-late? licm-mode)
        (opt-licm-value-invariant? globals-clean? loop-defs hoisted src)
        (match src
          [(ir.CompilerIrValue.Var var)
            (or
              (opt-licm-mode-vector? licm-mode)
              (opt-used-contains hoisted var))]
          [_ true]))]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (and
        (opt-licm-mode-late? licm-mode)
        (opt-licm-value-invariant? globals-clean? loop-defs hoisted src)
        (match src
          [(ir.CompilerIrValue.Var var)
            (or
              (opt-licm-mode-vector? licm-mode)
              (opt-used-contains hoisted var))]
          [_ true]))]
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (not (opt-binop-traps? op))
        (opt-licm-values-invariant? globals-clean? loop-defs hoisted lhs rhs))]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-licm-value-invariant? globals-clean? loop-defs hoisted src)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (and
        (opt-gvn-stable-var? sources dst)
        ;; Keep an address calculation out of an unknown-call-spanning live
        ;; range. The backend otherwise has to preserve it across the call,
        ;; which can spill the descriptor base used by every loop iteration.
        ;; A direct call proven memory-clean retains the established LICM
        ;; behavior and cannot introduce that borrowed-root regression. An
        ;; element-only direct call does NOT qualify: it still emits a call, so
        ;; the address still has to survive one, and admitting it here is a
        ;; measured LOSS -- intern_table 602,891,376 -> 611,411,217 (+1.41%)
        ;; against gvn_table -0.34M and liveness_scan -0.09M, with every other
        ;; row unmoved (one cachegrind run each). The memory fact the element
        ;; bit carries is real; the register pressure it would buy is not worth
        ;; it at an address-formation site.
        (or
          (not any-call?)
          (and
            (not (opt-licm-store-summary-call-boundary? store-summary))
            (not (opt-licm-store-summary-call-boundary? legacy-store-summary))))
        ;; Gep computes an address from SSA values; it does not read through
        ;; that address. A hidden mutable-global read among the operands is
        ;; admitted only when opt-licm-globals-clean? proves the body cannot
        ;; write any global cell, so intervening stores cannot invalidate this
        ;; pure address calculation. Before BCE, retain the older memory
        ;; gate: moving a descriptor-length address too early can hide the
        ;; shared bound identity BCE needs. The post-LFTR run can use purity
        ;; after BCE and unrolling have consumed that fact.
        (opt-licm-values-invariant?
          globals-clean?
          loop-defs
          hoisted
          base
          offset)
        (or
          (opt-licm-mode-late? licm-mode)
          (opt-licm-memory-safe?
            store-summary
            legacy-store-summary
            store-roots
            any-call?
            (opt-licm-root-of-value roots base)
            (and
              (opt-licm-store-summary-header-load-safe? legacy-store-summary)
              (opt-licm-header-slot-gep?
                type-segment-bases
                types
                base
                offset
                ty)))))]
    [(ir.CompilerIrInstr.Load dst src _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources src)
        (opt-licm-value-invariant? globals-clean? loop-defs hoisted src)
        (or
          (opt-licm-memory-safe?
            store-summary
            legacy-store-summary
            store-roots
            any-call?
            (opt-licm-root-of-value roots src)
            (and
              (opt-licm-store-summary-header-load-safe? legacy-store-summary)
              (opt-licm-header-slot-source?
                type-segment-bases
                types
                ptrs
                (opt-licm-mode-late? licm-mode)
                src)))
          ;; Descriptor-header exception: when the body provably cannot write
          ;; a descriptor header (see the define-site comment), a header-slot
          ;; load of a loop-invariant descriptor handle moves out even though
          ;; the return-shaped side-exit poison closed the general path.
          (and
            descriptor-header-hoist?
            (opt-licm-header-slot-source?
              type-segment-bases
              types
              ptrs
              true
              src))))]
    [_ false]))

(define (opt-licm-add-hoisted-def
  [hoisted : opt_i64_i64_map.Map (:consume)]
  [instr : ir.CompilerIrInstr]) : opt_i64_i64_map.Map
  (match (opt-instr-def-var instr)
    [(option_i64.Some var) (opt-used-add hoisted var)]
    [(option_i64.None) hoisted]))

(define (opt-licm-filter-instr-seq-from
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [licm-mode : i64]
  [descriptor-header-hoist? : bool]
  [globals-clean? : bool]
  [hoisted : opt_i64_i64_map.Map (:consume)]) : OptLicmInstrsResult
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptLicmInstrsResult.Result
      (ir.CompilerIrInstrList.Nil)
      (ir.CompilerIrInstrList.Nil)
      hoisted
      false)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (opt-licm-candidate?
        type-segment-bases
        loop-defs
        hoisted
        sources
        types
        store-summary
        legacy-store-summary
        ptrs
        roots
        store-roots
        any-call?
        licm-mode
        descriptor-header-hoist?
        globals-clean?
        instr)
        (match (opt-licm-filter-instr-seq-from
          type-segment-bases
          loop-defs
          instrs
          (+ index 1)
          sources
          types
          store-summary
          legacy-store-summary
          ptrs
          roots
          store-roots
          any-call?
          licm-mode
          descriptor-header-hoist?
          globals-clean?
          (opt-licm-add-hoisted-def hoisted instr))
          [(OptLicmInstrsResult.Result kept moved next-hoisted _)
            (OptLicmInstrsResult.Result
              kept
              (ir.compiler-ir-instr-cons instr moved)
              next-hoisted
              true)])
        (match (opt-licm-filter-instr-seq-from
          type-segment-bases
          loop-defs
          instrs
          (+ index 1)
          sources
          types
          store-summary
          legacy-store-summary
          ptrs
          roots
          store-roots
          any-call?
          licm-mode
          descriptor-header-hoist?
          globals-clean?
          hoisted)
          [(OptLicmInstrsResult.Result kept moved next-hoisted changed)
            (OptLicmInstrsResult.Result
              (ir.compiler-ir-instr-cons instr kept)
              moved
              next-hoisted
              changed)])))))

(define (opt-licm-filter-instr-seq
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [licm-mode : i64]
  [descriptor-header-hoist? : bool]
  [globals-clean? : bool]
  [hoisted : opt_i64_i64_map.Map (:consume)]) : OptLicmInstrsResult
  (opt-licm-filter-instr-seq-from
    type-segment-bases
    loop-defs
    instrs
    0
    sources
    types
    store-summary
    legacy-store-summary
    ptrs
    roots
    store-roots
    any-call?
    licm-mode
    descriptor-header-hoist?
    globals-clean?
    hoisted))

(define (opt-licm-filter-body-blocks
  [type-segment-bases : i64]
  [loop-defs : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [store-summary : OptLicmStoreSummary]
  [legacy-store-summary : OptLicmStoreSummary]
  [ptrs : OptLicmPtrEnv]
  [roots : OptLicmRootEnv]
  [store-roots : OptLicmStoreRootList]
  [any-call? : bool]
  [licm-mode : i64]
  [descriptor-header-hoist? : bool]
  [globals-clean? : bool]
  [hoisted : opt_i64_i64_map.Map (:consume)]) : OptLicmBlocksResult
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptLicmBlocksResult.Result
        (ir.CompilerIrBlockList.Nil)
        (ir.CompilerIrInstrList.Nil)
        hoisted
        false)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (match (opt-licm-filter-instr-seq
            type-segment-bases
            loop-defs
            instrs
            sources
            types
            store-summary
            legacy-store-summary
            ptrs
            roots
            store-roots
            any-call?
            licm-mode
            descriptor-header-hoist?
            globals-clean?
            hoisted)
            [(OptLicmInstrsResult.Result kept moved next-hoisted block-changed)
              (match (opt-licm-filter-body-blocks
                type-segment-bases
                loop-defs
                (__tl-box-place rest)
                sources
                types
                store-summary
                legacy-store-summary
                ptrs
                roots
                store-roots
                any-call?
                licm-mode
                descriptor-header-hoist?
                globals-clean?
                next-hoisted)
                [(OptLicmBlocksResult.Result
                    rest-blocks
                    rest-moved
                    final-hoisted
                    rest-changed)
                  (OptLicmBlocksResult.Result
                    (ir.compiler-ir-block-cons
                      (ir.compiler-ir-block label kept)
                      rest-blocks)
                    (opt-aggregate-instr-list-append moved rest-moved)
                    final-hoisted
                    (or block-changed rest-changed))])])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-filter-body-blocks
        type-segment-bases
        loop-defs
        (ir.compiler-ir-block-seq-to-list seq)
        sources
        types
        store-summary
        legacy-store-summary
        ptrs
        roots
        store-roots
        any-call?
        licm-mode
        descriptor-header-hoist?
        globals-clean?
        hoisted)]))

(define (opt-licm-replace-body-blocks
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) blocks]
    [(ir.CompilerIrBlockList.Cons replacement replacement-rest)
      (match blocks
        [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
        [(ir.CompilerIrBlockList.Cons block rest)
          (match block
            [(ir.CompilerIrBlock.Block label _)
              (match replacement
                [(ir.CompilerIrBlock.Block replacement-label _)
                  (if (= label replacement-label)
                    (ir.compiler-ir-block-cons
                      replacement
                      (opt-licm-replace-body-blocks
                        (__tl-box-place rest)
                        (__tl-box-place replacement-rest)))
                    (ir.compiler-ir-block-cons
                      block
                      (opt-licm-replace-body-blocks
                        (__tl-box-place rest)
                        body-blocks)))])])]
        [(ir.CompilerIrBlockList.Array seq)
          (opt-licm-replace-body-blocks
            (ir.compiler-ir-block-seq-to-list seq)
            body-blocks)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-replace-body-blocks
        blocks
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-insert-before-terminator
  [hoisted : ir.CompilerIrInstrList]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match hoisted
    [(ir.CompilerIrInstrList.Nil) instrs]
    [_
      (match instrs
        [(ir.CompilerIrInstrList.Nil) hoisted]
        [(ir.CompilerIrInstrList.Cons instr rest)
          (if (opt-cfg-terminator-instr? instr)
            (opt-aggregate-instr-list-append hoisted instrs)
            (ir.compiler-ir-instr-cons
              instr
              (opt-licm-insert-before-terminator hoisted (__tl-box-place rest))))])]))

(define (opt-instr-builder-append-list!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [instrs : ir.CompilerIrInstrList]) : unit
  (match instrs
    [(ir.CompilerIrInstrList.Nil) unit]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (begin
        (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
        (opt-instr-builder-append-list! (&mut builder) (__tl-box-place rest)))]))

(define (opt-licm-first-terminator-index
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    count
    (if (opt-cfg-terminator-instr? (ir.compiler-ir-instr-seq-ref instrs index))
      index
      (opt-licm-first-terminator-index instrs (+ index 1) count))))

(define (opt-licm-insert-before-terminator-seq
  [hoisted : ir.CompilerIrInstrList]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (match hoisted
    [(ir.CompilerIrInstrList.Nil) instrs]
    [_
      (let
        [original-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [inserted-count : i64 (ir.compiler-ir-instr-list-count hoisted)]
        [terminator-index : i64
          (opt-licm-first-terminator-index instrs 0 original-count)]
        [builder : ir.CompilerIrInstrBuilder
          (ir.compiler-ir-instr-builder-with-capacity
            (+ original-count inserted-count))]
        (begin
          (ir.compiler-ir-instr-builder-append-seq-range!
            (&mut builder)
            instrs
            0
            terminator-index)
          (opt-instr-builder-append-list! (&mut builder) hoisted)
          (ir.compiler-ir-instr-builder-append-seq-range!
            (&mut builder)
            instrs
            terminator-index
            original-count)
          (ir.compiler-ir-instr-builder-to-seq builder)))]))

(define (opt-licm-insert-preheader-blocks
  [preheader : i64]
  [hoisted : ir.CompilerIrInstrList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (= label preheader)
              (ir.CompilerIrBlock.Block
                label
                (opt-licm-insert-before-terminator-seq hoisted instrs))
              block)
            (opt-licm-insert-preheader-blocks
              preheader
              hoisted
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-insert-preheader-blocks
        preheader
        hoisted
        (ir.compiler-ir-block-seq-to-list seq))]))

;; M-G (B1): duplicate-hoist dedup. The filter hoists EVERY invariant load/gep
;; individually, so a loop whose body loads the same descriptor slot at N sites
;; (one gep+load pair per inlined bounds check, kept distinct in-body because
;; element stores conservatively clear the block-local load-CSE table) lands N
;; IDENTICAL gep+load pairs in the preheader -- N live registers carrying one
;; value through the loop (measured: qs_partition hoists the data-slot load 5x
;; and the len-slot load 3x -> 3 spilled vars + per-iteration spill/scavenge
;; traffic in a zero-call loop). Build a substitution env mapping every
;; duplicate's dst to the FIRST hoisted def of the same (operand-substituted)
;; shape, then rewrite all uses in the preheader instructions and the loop
;; body. The duplicate defs are KEPT (their dsts become dead-or-preheader-local,
;; zero loop-carried pressure), so any use the substituter conservatively skips
;; (phi inputs, AddrOf raw vars) still reads a defined var -- partial
;; substitution is always sound. Dsts are single-def (opt-gvn-stable-var? gates
;; candidacy), so a body use can only see the preheader def.
(defenum OptLicmDup
  (OptLicmDupNone)
  (OptLicmDupVar i64))

;; First selected instruction computing the same value as `instr` (whose
;; operands are already substituted through the env-so-far): loads must match
;; on source value + type, geps on base + offset + element type.
(define (opt-licm-dup-of
  [type-segment-bases : i64]
  [selected : ir.CompilerIrInstrList]
  [instr : ir.CompilerIrInstr]) : OptLicmDup
  (match selected
    [(ir.CompilerIrInstrList.Nil) (OptLicmDupNone)]
    [(ir.CompilerIrInstrList.Cons prev rest)
      (match prev
        [(ir.CompilerIrInstr.Load pdst psrc pty)
          (match instr
            [(ir.CompilerIrInstr.Load _ src ty)
              (if (and
                (opt-value-eq psrc src)
                (opt-type-eq type-segment-bases pty ty))
                (OptLicmDupVar pdst)
                (opt-licm-dup-of type-segment-bases (__tl-box-place rest) instr))]
            [_ (opt-licm-dup-of type-segment-bases (__tl-box-place rest) instr)])]
        [(ir.CompilerIrInstr.Gep pdst pbase poffset pty)
          (match instr
            [(ir.CompilerIrInstr.Gep _ base offset ty)
              (if (and
                (opt-value-eq pbase base)
                (opt-value-eq poffset offset)
                (opt-type-eq type-segment-bases pty ty))
                (OptLicmDupVar pdst)
                (opt-licm-dup-of type-segment-bases (__tl-box-place rest) instr))]
            [_ (opt-licm-dup-of type-segment-bases (__tl-box-place rest) instr)])]
        [_ (opt-licm-dup-of type-segment-bases (__tl-box-place rest) instr)])]))

;; Walk the hoisted list in program order, accumulating dup-dst -> canonical
;; var bindings. Each instruction is operand-substituted through the env built
;; so far BEFORE comparison, so a load through a duplicate gep matches the
;; canonical load (its source resolves to the canonical gep dst).
(define (opt-licm-dedup-env
  [type-segment-bases : i64]
  [moved : ir.CompilerIrInstrList]
  [selected : ir.CompilerIrInstrList]
  [env : OptCopyEnv]) : OptCopyEnv
  (match moved
    [(ir.CompilerIrInstrList.Nil) env]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (let
        [subst : ir.CompilerIrInstr (opt-copy-subst-instr env instr)]
        (match (opt-licm-dup-of type-segment-bases selected subst)
          [(OptLicmDupVar canon)
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (opt-licm-dedup-env
                  type-segment-bases
                  (__tl-box-place rest)
                  selected
                  (OptCopyEnv.Cons dst (ir.CompilerIrValue.Var canon) (box env)))]
              [(option_i64.None)
                (opt-licm-dedup-env
                  type-segment-bases
                  (__tl-box-place rest)
                  selected
                  env)])]
          [(OptLicmDupNone)
            (opt-licm-dedup-env
              type-segment-bases
              (__tl-box-place rest)
              (ir.compiler-ir-instr-cons subst selected)
              env)]))]))

(define (opt-licm-subst-instr-list
  [env : OptCopyEnv]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (ir.compiler-ir-instr-cons
        (opt-copy-subst-instr env instr)
        (opt-licm-subst-instr-list env (__tl-box-place rest)))]))

(define (opt-licm-subst-instr-seq-from
  [env : OptCopyEnv]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (if (< index 0)
    acc
    (opt-licm-subst-instr-seq-from
      env
      instrs
      (- index 1)
      (ir.compiler-ir-instr-cons
        (opt-copy-subst-instr env (ir.compiler-ir-instr-seq-ref instrs index))
        acc))))

(define (opt-licm-subst-instr-seq
  [env : OptCopyEnv]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrList
  (opt-licm-subst-instr-seq-from
    env
    instrs
    (- (ir.compiler-ir-instr-seq-count instrs) 1)
    ir.CompilerIrInstrList.Nil))

(define (opt-licm-subst-body-blocks
  [env : OptCopyEnv]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.compiler-ir-block label (opt-licm-subst-instr-seq env instrs))
            (opt-licm-subst-body-blocks env (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-subst-body-blocks env (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-switch-case-outside?
  [body : OptLabelSet]
  [cases : ir.CompilerIrSwitchCaseList]) : bool
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil) false]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ label)
          (if (not (opt-label-contains body label))
            true
            (opt-licm-switch-case-outside? body (__tl-box-place rest)))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-licm-switch-case-outside?
        body
        (ir.compiler-ir-switch-case-seq-to-list seq))]))

;; Pure register staging that a return path may perform without counting as
;; "more work": scalar copies/arithmetic and the group packing a multi-word
;; return needs. A direct call whose effect is an aborting ControlFlow
;; runtime (tl_oob_abort and friends) is also allowed -- that exit terminates
;; the process. Loads, stores, geps, bounds checks, and real calls make the
;; exit a break into further work instead.
(define (opt-licm-return-staging-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Phi _ _ _) true]
    [(ir.CompilerIrInstr.Pack _ _ _) true]
    [(ir.CompilerIrInstr.Word _ _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    ;; A found/insert exit does bounded memory work (compute the entry address,
    ;; read/write the slot) before returning. That still makes the loop a
    ;; short-trip SEARCH -- it returns as soon as the slot is located -- so
    ;; hoisting a loop-invariant load into it does not pay and (under high
    ;; register pressure) strands the hoisted value's live range across the
    ;; probe loop. Allow the memory ops on the way OUT; a path that instead
    ;; loops back into more iterations never reaches a Return within the walk
    ;; fuel, so it still classifies as break-into-work.
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.Store _ _ _) true]
    [(ir.CompilerIrInstr.Call _ name _ _)
      (ir.compiler-ir-runtime-control-flow-id? name)]
    [(ir.CompilerIrInstr.Jump _) true]
    ;; a Branch is only ever a terminator; the walk itself validates both
    ;; of its arms.
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Return _) true]
    [_ false]))

(define (opt-licm-return-staging-block?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-licm-return-staging-instr?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-licm-return-staging-block? instrs (+ index 1)))))

;; A RETURN-SHAPED exit target reaches a Return through at most `fuel`
;; staging-only blocks (chained by unconditional Jumps).
(define (opt-licm-return-shaped-target?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [fuel : i64]) : bool
  (if (<= fuel 0)
    false
    (match (opt-cfg-find-block blocks label)
      [(OptMaybeBlock.No) false]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
              (if (= count 0)
                false
                (if (not (opt-licm-return-staging-block? instrs 0))
                  false
                  (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                    [(ir.CompilerIrInstr.Return _) true]
                    [(ir.CompilerIrInstr.Jump target)
                      (opt-licm-return-shaped-target? blocks target (- fuel 1))]
                    ;; a staging-only diamond on the way out (the probe's
                    ;; first-tombstone select) stays return-shaped when both
                    ;; arms are.
                    [(ir.CompilerIrInstr.Branch _ then-label else-label)
                      (and
                        (opt-licm-return-shaped-target?
                          blocks
                          then-label
                          (- fuel 1))
                        (opt-licm-return-shaped-target?
                          blocks
                          else-label
                          (- fuel 1)))]
                    [_ false]))))])])))

(define (opt-licm-branch-exit-return-shaped?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLabelSet]
  [target : i64]) : bool
  (if (opt-label-contains body target)
    true
    (opt-licm-return-shaped-target? blocks target 8)))

;; Tri-state side-exit classification: 0 = no side exits, 1 = every side exit
;; is return-shaped, 2 = at least one side exit breaks into further work.
(define (opt-licm-instr-side-exit-kind
  [blocks : ir.CompilerIrBlockList]
  [body : OptLabelSet]
  [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Jump target)
      (if (opt-label-contains body target)
        0
        (if (opt-licm-return-shaped-target? blocks target 8)
          1
          2))]
    [(ir.CompilerIrInstr.Branch _ then-label else-label)
      (if (and
        (opt-label-contains body then-label)
        (opt-label-contains body else-label))
        0
        (if (and
          (opt-licm-branch-exit-return-shaped? blocks body then-label)
          (opt-licm-branch-exit-return-shaped? blocks body else-label))
          1
          2))]
    [(ir.CompilerIrInstr.TotalEnumBranch _ then-label else-label)
      (if (and
        (opt-label-contains body then-label)
        (opt-label-contains body else-label))
        0
        (if (and
          (opt-licm-branch-exit-return-shaped? blocks body then-label)
          (opt-licm-branch-exit-return-shaped? blocks body else-label))
          1
          2))]
    [(ir.CompilerIrInstr.Switch _ _ cases default-label)
      (if (or
        (not (opt-label-contains body default-label))
        (opt-licm-switch-case-outside? body cases))
        (if (and
          (opt-licm-branch-exit-return-shaped? blocks body default-label)
          (opt-licm-switch-cases-return-shaped? blocks body cases))
          1
          2)
        0)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ cases default-label _)
      (if (or
        (not (opt-label-contains body default-label))
        (opt-licm-switch-case-outside? body cases))
        (if (and
          (opt-licm-branch-exit-return-shaped? blocks body default-label)
          (opt-licm-switch-cases-return-shaped? blocks body cases))
          1
          2)
        0)]
    [_ 0]))

(define (opt-licm-switch-cases-return-shaped?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLabelSet]
  [cases : ir.CompilerIrSwitchCaseList]) : bool
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil) true]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ label)
          (and
            (opt-licm-branch-exit-return-shaped? blocks body label)
            (opt-licm-switch-cases-return-shaped?
              blocks
              body
              (__tl-box-place rest)))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-licm-switch-cases-return-shaped?
        blocks
        body
        (ir.compiler-ir-switch-case-seq-to-list seq))]))

;; Suppression kind for the whole loop: max over the non-header body blocks'
;; terminator classifications.
(define (opt-licm-loop-side-exit-kind
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [latch : i64]
  [body : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]) : i64
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [here : i64
          (match block
            [(ir.CompilerIrBlock.Block label instrs)
              ;; the header's AND the latch's loop-exit branches are the
              ;; normal counted exits (a rotated loop tests at its latch);
              ;; only OTHER blocks' exits mark the early-return probe shape.
              (if (or
                (= label header)
                (= label latch)
                (= (ir.compiler-ir-instr-seq-count instrs) 0))
                0
                (opt-licm-instr-side-exit-kind
                  blocks
                  body
                  (ir.compiler-ir-instr-seq-ref
                    instrs
                    (- (ir.compiler-ir-instr-seq-count instrs) 1))))])]
        (if (= here 2)
          2
          (let
            [rest-kind : i64
              (opt-licm-loop-side-exit-kind
                blocks
                header
                latch
                body
                (__tl-box-place rest))]
            (if (> rest-kind here)
              rest-kind
              here))))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-loop-side-exit-kind
        blocks
        header
        latch
        body
        (ir.compiler-ir-block-seq-to-list seq))]))

;; --- loop-scope global-cell operand promotion --------------------------------
;;
;; A `CompilerIrValue.Global g` OPERAND is a hidden rip-relative load of g's
;; cell (see opt-licm-value-invariant?), re-executed on every iteration. LICM
;; itself cannot move it: motion relocates whole INSTRUCTIONS, and there is no
;; standalone load to relocate -- `globals-clean?` only lets an instruction
;; whose OTHER operands are invariant leave the loop, which a `mul %varying,
;; @g` or `lt %counter, @g` never is. The function-scope global_cell pass does
;; materialize the load, but it refuses any function containing a returning
;; call (a callee could `set!` the cell, so a function-ENTRY load would be
;; stale) and any function that stores the cell itself, which is exactly why
;; the hot loops that carry these operands are the ones it declines.
;;
;; A LOOP is the smaller scope where the same fact holds far more often. When
;; `opt-licm-globals-clean?` holds, the body contains no call that may write
;; and no header-or-unknown store, so nothing executing inside the loop can
;; change ANY cell. Loading the cell once into a fresh var in the loop's
;; PREHEADER and rewriting the body's `@g` operands to that var is then
;; value-identical: the preheader load runs on every loop ENTRY, so a `set!`
;; made elsewhere in the same function -- before the loop, or between two
;; entries of it -- is observed exactly as the per-use loads observed it. That
;; is the difference from the function-scope pass, whose entry load would go
;; stale, and it is why this promotion is loop-scoped rather than a relaxation
;; of that pass's condition.
;;
;; The preheader load is speculation-free even for a zero-trip loop: a global
;; cell is statically allocated and always exists, so the load reads valid
;; memory and its value is simply discarded. This argument does NOT extend to
;; loads THROUGH pointers, where a zero-trip loop can leave the pointer
;; unallocated -- LICM keeps its memory gates for those.
;;
;; The gate is the loop-wide `globals-promote-clean?`, which is the same
;; `globals-clean?` the Load and Gep arms of opt-licm-candidate? ask plus the
;; memory-clean call tier those arms still refuse, admitted under a live-in
;; budget (opt-licm-global-promote-live-in-budget). A body that writes any cell
;; promotes nothing either way. Only single-word cells qualify, for the reason the
;; function-scope pass gives (opt-global-cell-word-type?): the Mov's declared
;; type drives the backend's load width, so a wider cell would silently load
;; only its first word. Declared types come from the program-wide
;; OptGlobalCellSummary, which is built at level 2 only; below that the summary
;; is empty and promotion is a no-op, matching the function-scope pass's scope.
;;
;; The promoted var survives to the backend as a real load plus Var operands:
;; copy propagation and GVN both refuse `Global` sources outright
;; (opt-copy-safe-source?, opt-gvn-value-stable?), so nothing folds the cell
;; read back into its uses. Nested loops converge upward instead of
;; oscillating: an inner preheader's `Mov %v, @g` is itself a body instruction
;; of the enclosing loop, so a clean outer loop promotes it one level further
;; out and the inner body, now free of `Global` operands, promotes nothing on
;; the next round.
(defstruct OptLicmGlobalPromotion
  (blocks ir.CompilerIrBlockList)
  (loads ir.CompilerIrInstrList)
  (changed? bool))

;; Live-in budget for the memory-clean call tier's promotions (see
;; opt-licm-direct-call-keeps-globals-clean? for why that tier alone is
;; priced). A promoted cell copy is one value that must stay live across the
;; whole loop, so it competes for the loop's steady-state register budget, and
;; the loop's LIVE-IN count -- values entering from outside, which is
;; opt-unroll-mb-live-in-count, the multiblock unroller's own pressure proxy
;; reused verbatim -- is how loaded that budget already is. Loop-local defs are
;; excluded there for the reason that proxy gives: they die inside the body and
;; do not consume steady-state headroom.
;;
;; WHY SIX. Every loop this tier prices contains a returning direct call --
;; that is what the tier IS -- so a value live across the loop is live across a
;; call, and the only registers that survive one are the callee-saved GP file:
;; five on the fixed Linux ABI this backend plans against
;; (compiler-abi-callee-saved-gp-register-count) plus %rbp when it is not pinned
;; as a frame pointer, which the backend does allocate (the rbp_sixth_csr
;; shape). Six is therefore the most values this loop can carry across its call
;; without touching the frame, and a promoted copy that does not fit there is
;; not a saved load -- it is a frame slot, which costs a preheader store on
;; every loop ENTRY and makes each use a frame load instead of a rip-relative
;; one, for no instruction saved. It is also, and for the same reason on the
;; same proxy, the multiblock unroller's own live-in constant.
;;
;; PINNED TWO-SIDED, one cachegrind run per budget. Both neighbours are loops
;; this tier newly admits and both have only return-shaped side exits, so no
;; cheaper structural class separates them -- refusing the whole return-shaped
;; class was measured and it takes the win with the loss (intern_table returns
;; to baseline and peephole_lines keeps 0.1M of its 19.7M).
;;
;;   ADMITTED: every loop whose promotion is worth anything on this corpus sits
;;     at live-in 4 or below -- peephole_lines' line scanner
;;     (_tl_bench_pl_first_rsp_read, where the promoted `pl_text`/`pl_len`
;;     copies keep registers and a long text scan drops a rip-relative cell load
;;     at eight distinct use sites) and cfg_domloops' loop. Budgets 4, 6, 8, 10
;;     and 12 all measure identically: peephole_lines 647,839,245 (-2.96%),
;;     cfg_domloops 769,279,945 (+0.04%), gvn_table and intern_table exactly at
;;     baseline.
;;   REFUSED, nearest: live-in 13 -- intern_table's probe loop
;;     (it_intern_slice), whose promoted `it_state_capacity` copy spills to
;;     192(%rsp) and grows the frame 264 -> 280 bytes while the loop itself runs
;;     one or two probes. Raising the budget to 13 restores exactly that
;;     regression and nothing else: intern_table 611,002,492 -> 614,441,836
;;     (+0.56%), every other row unmoved.
;;
;; So the whole measured corpus lies outside [5, 12] and six sits inside that
;; gap on the side the register file argues for.
(define (opt-licm-global-promote-live-in-budget) : i64
  6)

;; Allocate one fresh var per promotable cell referenced by the body. Unlike
;; the function-scope plan (opt-global-cell-plan-build) this filters on neither
;; the program's address-taken set nor a store set: `globals-clean?` has
;; already proven the body performs no store, no store through any pointer, and
;; no call that may write, which covers every way a cell could be reached --
;; including through a pointer derived from `GlobalAddr`, which the store
;; summaries never classify as element-only.
(define (opt-licm-global-promote-plan
  [cells : OptGlobalCellSummary]
  [refs : OptI64List]
  [frame-cell : (__tl_dyn-array i64)]
  [plan : opt_i64_i64_map.Map (:consume)]
  [count : i64]) : OptGlobalCellPlan
  (match refs
    [(OptI64List.Nil) (OptGlobalCellPlan plan count)]
    [(OptI64List.Cons name rest)
      (match (opt-global-cell-type-lookup cells name)
        [(OptMaybeAstType.No)
          (opt-licm-global-promote-plan
            cells
            (__tl-box-place rest)
            frame-cell
            plan
            count)]
        [(OptMaybeAstType.Some ty)
          (if (opt-global-cell-word-type? ty)
            (let
              [fresh : i64 (array-ref frame-cell 0)]
              [next : opt_i64_i64_map.Map plan]
              (begin
                (set! (array-ref frame-cell 0) (+ fresh 1))
                (opt_i64_i64_map.insert-ref! (&mut next) name fresh)
                (opt-licm-global-promote-plan
                  cells
                  (__tl-box-place rest)
                  frame-cell
                  next
                  (+ count 1))))
            (opt-licm-global-promote-plan
              cells
              (__tl-box-place rest)
              frame-cell
              plan
              count))])]))

;; Emit the preheader cell loads in the same ref-list order the plan allocated
;; their fresh vars.
(define (opt-licm-global-promote-loads
  [plan : opt_i64_i64_map.Map]
  [cells : OptGlobalCellSummary]
  [refs : OptI64List]) : ir.CompilerIrInstrList
  (match refs
    [(OptI64List.Nil) (ir.CompilerIrInstrList.Nil)]
    [(OptI64List.Cons name rest)
      (match (opt_i64_i64_map.get (& plan) name)
        [(opt_i64_i64_map.LookupMissing)
          (opt-licm-global-promote-loads plan cells (__tl-box-place rest))]
        [(opt_i64_i64_map.LookupFound fresh)
          (match (opt-global-cell-type-lookup cells name)
            [(OptMaybeAstType.No)
              (opt-licm-global-promote-loads plan cells (__tl-box-place rest))]
            [(OptMaybeAstType.Some ty)
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Mov
                  fresh
                  (ir.CompilerIrValue.Global name)
                  ty)
                (opt-licm-global-promote-loads plan cells (__tl-box-place rest)))])])]))

;; Promote every `Global` operand of a globals-clean loop body to a preheader
;; load. `blocks` are the loop's body blocks AFTER the ordinary hoist filter
;; has removed the instructions it moves, so a promotion never rewrites an
;; operand that is about to leave the loop anyway.
(define (opt-licm-global-promote
  [cells : OptGlobalCellSummary]
  [frame-cell : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : OptLicmGlobalPromotion
  (if (= cells.word-cell 0)
    (OptLicmGlobalPromotion blocks (ir.CompilerIrInstrList.Nil) false)
    (let
      [scan : OptGlobalCellScan
        (opt-global-cell-scan-blocks (opt-global-cell-scan-new) blocks false)]
      [refs : OptI64List scan.ref-list]
      (match refs
        [(OptI64List.Nil)
          (OptLicmGlobalPromotion blocks (ir.CompilerIrInstrList.Nil) false)]
        [_
          (let
            [planned : OptGlobalCellPlan
              (opt-licm-global-promote-plan
                cells
                refs
                frame-cell
                (opt_i64_i64_map.with-capacity 8)
                0)]
            (if (= planned.count 0)
              (OptLicmGlobalPromotion blocks (ir.CompilerIrInstrList.Nil) false)
              (OptLicmGlobalPromotion
                (opt-global-cell-rewrite-nonentry-blocks planned.map blocks)
                (opt-licm-global-promote-loads planned.map cells refs)
                true)))]))))

;; Preheader instruction list: the hoisted instructions followed by the
;; promotion's cell loads. No promotion means the hoisted list is handed back
;; unchanged rather than copied, keeping the no-promotion path allocation- and
;; byte-identical.
(define (opt-licm-preheader-instrs
  [hoisted : ir.CompilerIrInstrList]
  [loads : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match loads
    [(ir.CompilerIrInstrList.Nil) hoisted]
    [_ (opt-aggregate-instr-list-append hoisted loads)]))

(define (opt-licm-apply-loop
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [provenance : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [frame-cell : (__tl_dyn-array i64)]
  [late? : bool]
  [blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]) : OptBlockListPassResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some preheader)
      (let
        [body-blocks : ir.CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        [map-capacity : i64 (opt-licm-body-map-capacity body-blocks)]
        [loop-defs : opt_i64_i64_map.Map
          (opt-licm-collect-defs-blocks
            body-blocks
            (opt_i64_i64_map.with-capacity map-capacity))]
        [store-state : OptLicmStoreState
          (opt-licm-store-state-blocks
            type-segment-bases
            types
            body-blocks
            direct-call-clean
            global-cells
            false
            (opt-licm-store-state-with-provenance
              provenance.ptrs
              provenance.roots))]
        [raw-summary : OptLicmStoreSummary store-state.summary]
        [raw-rooted-summary : OptLicmStoreSummary store-state.rooted-summary]
        [raw-legacy-summary : OptLicmStoreSummary
          (opt-licm-store-summary-merge raw-summary raw-rooted-summary)]
        [side-exit-kind : i64
          (opt-licm-loop-side-exit-kind
            blocks
            (opt-natural-loop-header loop)
            (opt-natural-loop-latch loop)
            (opt-natural-loop-body loop)
            body-blocks)]
        ;; Measured (cachegrind, three rounds): hoisting invariant loads out
        ;; of PROBE-SHAPED loops -- every side exit an early RETURN, trips
        ;; averaging one or two iterations -- is pure register pressure: the
        ;; extra live-across-loop values push other values into spill staging
        ;; on the return paths (hashmap_get +1.2%, hashmap_insert +0.6%,
        ;; self_compile +0.74%). Suppressing ALL side-exit loops overshot the
        ;; other way: break-into-work side exits mark long-trip kernels
        ;; (spmd_zip +50%, opt_quicksort +1.0% under the broad gate). So the
        ;; load/gep hoist is suppressed exactly when every side exit is
        ;; return-shaped (reaches Return through staging-only blocks; an
        ;; aborting runtime call also qualifies), by folding a header-store
        ;; poison into the summary. Pure BinOp/UnOp hoisting is unaffected.
        ;; The poison is a profitability gate, not a soundness one, so one
        ;; load class is excepted from it: descriptor header loads (the
        ;; data-pointer or length slot of a loop-invariant array/string
        ;; handle) still move out of a suppressed loop when the RAW body
        ;; summary is header-load-safe -- no call that may write and no
        ;; header-or-unknown store, element stores excepted because they
        ;; cannot touch header words (see opt-licm-candidate?). Their
        ;; descriptor-address Geps already ride the late-mode exemption, so
        ;; the loaded value replaces the address's loop-spanning live range
        ;; instead of adding a new one. The flag stays false pre-BCE (late?
        ;; is false there): moving a descriptor length that early can hide
        ;; the shared bound identity bounds-check elimination needs.
        [descriptor-header-hoist? : bool
          (and
            late?
            (opt-licm-store-summary-header-load-safe? raw-legacy-summary))]
        [store-summary : OptLicmStoreSummary
          (if (= side-exit-kind 1)
            (opt-licm-store-summary-merge
              raw-summary
              (opt-licm-store-summary-header-or-unknown-store))
            raw-summary)]
        [legacy-store-summary : OptLicmStoreSummary
          (if (= side-exit-kind 1)
            (opt-licm-store-summary-merge
              raw-legacy-summary
              (opt-licm-store-summary-header-or-unknown-store))
            raw-legacy-summary)]
        [ptrs : OptLicmPtrEnv store-state.ptrs]
        [roots : OptLicmRootEnv store-state.roots]
        [store-roots : OptLicmStoreRootList store-state.store-roots]
        [any-call? : bool store-state.any-call?]
        ;; Global-cell invariance is a memory fact about the RAW body summary,
        ;; so it reads through the return-shaped side-exit poison above the
        ;; same way `descriptor-header-hoist?` does: the poison suppresses a
        ;; profitability class, and the global-rooted chain it would otherwise
        ;; close is the one whose per-iteration cost (a rip-relative cell load
        ;; plus the descriptor words re-derived from it) the preheader copy
        ;; removes outright rather than merely relocating.
        ;; The memory-clean direct-call tier reaches the PROMOTION only, and
        ;; only under a live-in budget; the INVARIANCE question keeps the older
        ;; refusal. See opt-licm-direct-call-keeps-globals-clean? for the split
        ;; and opt-licm-global-promote-live-in-budget for the budget. A loop
        ;; that was already globals-clean without that tier takes the strict
        ;; flag on both sides, so it is byte-identical to before.
        [globals-clean-relaxed? : bool
          (opt-licm-globals-clean? store-state.global-write?)]
        [globals-clean-strict? : bool
          (and globals-clean-relaxed? (not store-state.mem-clean-call?))]
        [globals-clean? : bool globals-clean-strict?]
        [globals-promote-clean? : bool
          (and
            globals-clean-relaxed?
            (or
              globals-clean-strict?
              (<=
                (opt-unroll-mb-live-in-count body-blocks)
                (opt-licm-global-promote-live-in-budget))))]
        (match (opt-licm-filter-body-blocks
          type-segment-bases
          loop-defs
          body-blocks
          sources
          types
          store-summary
          legacy-store-summary
          ptrs
          roots
          store-roots
          any-call?
          (if late?
            (if (opt-licm-vector-memory-blocks? body-blocks)
              2
              1)
            0)
          descriptor-header-hoist?
          globals-clean?
          (opt_i64_i64_map.with-capacity map-capacity))
          [(OptLicmBlocksResult.Result filtered-body hoisted _ changed)
            ;; Loop-scope global operand promotion runs on what the hoist
            ;; filter LEFT in the loop, so it never rewrites an operand of an
            ;; instruction that is leaving anyway, and the filter's own
            ;; decisions still read the untouched body (nothing promotes when
            ;; the gate is closed, which keeps this byte-identical there).
            (let
              [promotion : OptLicmGlobalPromotion
                (if globals-promote-clean?
                  (opt-licm-global-promote
                    global-cells
                    frame-cell
                    filtered-body)
                  (OptLicmGlobalPromotion
                    filtered-body
                    (ir.CompilerIrInstrList.Nil)
                    false))]
              [promoted-body : ir.CompilerIrBlockList promotion.blocks]
              [preheader-loads : ir.CompilerIrInstrList promotion.loads]
              (if (or changed promotion.changed?)
                ;; M-G (B1): fold duplicate hoisted loads/geps onto their first
                ;; occurrence (see opt-licm-dedup-env). An empty env means no
                ;; duplicates -- skip the rewrite, byte-identical to pre-B1.
                (let
                  [dedup-env : OptCopyEnv
                    (opt-licm-dedup-env
                      type-segment-bases
                      hoisted
                      (ir.CompilerIrInstrList.Nil)
                      (OptCopyEnv.Nil))]
                  (match dedup-env
                    [(OptCopyEnv.Nil)
                      (OptBlockListPassResult.Result
                        (opt-licm-insert-preheader-blocks
                          preheader
                          (opt-licm-preheader-instrs hoisted preheader-loads)
                          (opt-licm-replace-body-blocks blocks promoted-body))
                        true)]
                    [_
                      (OptBlockListPassResult.Result
                        (opt-licm-insert-preheader-blocks
                          preheader
                          (opt-licm-preheader-instrs
                            (opt-licm-subst-instr-list dedup-env hoisted)
                            preheader-loads)
                          (opt-licm-replace-body-blocks
                            blocks
                            (opt-licm-subst-body-blocks dedup-env promoted-body)))
                        true)]))
                (OptBlockListPassResult.Result blocks false)))]))]
    [(OptLoopPreheader.No) (OptBlockListPassResult.Result blocks false)]))

(define (opt-licm-apply-loops
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [provenance : OptLicmStoreState]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [frame-cell : (__tl_dyn-array i64)]
  [late? : bool]
  [loops : OptNaturalLoopList]
  [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-licm-apply-loop
        type-segment-bases
        sources
        types
        provenance
        direct-call-clean
        global-cells
        frame-cell
        late?
        blocks
        loop)
        [(OptBlockListPassResult.Result loop-blocks loop-changed)
          (match (opt-licm-apply-loops
            type-segment-bases
            sources
            types
            provenance
            direct-call-clean
            global-cells
            frame-cell
            late?
            (__tl-box-place rest)
            loop-blocks)
            [(OptBlockListPassResult.Result rest-blocks rest-changed)
              (OptBlockListPassResult.Result
                rest-blocks
                (or loop-changed rest-changed))])])]))

(define (opt-licm-function-with-context-result-and-direct-call-clean
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [direct-call-clean : opt_i64_i64_map.Map]
  [global-cells : OptGlobalCellSummary]
  [late? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [sources : opt_i64_i64_map.Map
              (opt-gvn-sources-blocks
                blocks
                (opt-gvn-sources-params
                  params
                  (opt_i64_i64_map.with-capacity 64)))]
            [types : OptSsaVarTypes
              (opt-licm-type-env-from-function params blocks)]
            [loops : OptNaturalLoopList
              (opt-cfg-natural-loops-with-context blocks context)]
            (match loops
              [(OptNaturalLoopList.Nil)
                (OptFunctionCtxResult.Result func context)]
              [_
                (let
                  [provenance : OptLicmStoreState
                    (opt-licm-provenance-state-from-function
                      type-segment-bases
                      params
                      types
                      blocks)]
                  ;; Loop-scope global promotion mints fresh vars, so the pass
                  ;; carries the frame counter in a cell and writes the final
                  ;; value back into the rewritten function.
                  [frame-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
                  [_seed-frame : unit (set! (array-ref frame-cell 0) frame)]
                  (match (opt-licm-apply-loops
                    type-segment-bases
                    sources
                    types
                    provenance
                    direct-call-clean
                    global-cells
                    frame-cell
                    late?
                    loops
                    blocks)
                    [(OptBlockListPassResult.Result
                        hoisted-blocks
                        licm-changed?)
                      (if (not licm-changed?)
                        ;; Nothing hoisted: the input context still describes the
                        ;; unchanged CFG, so skip the context rebuild and the
                        ;; post-pass verify entirely.
                        (OptFunctionCtxResult.Result func context)
                        (let
                          [hoisted : ir.CompilerIrFunction
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              (array-ref frame-cell 0)
                              hoisted-blocks)]
                          ;; LICM may hoist into a synthesized preheader edge, so build
                          ;; one fresh context for the rewritten CFG, reuse it for the
                          ;; post-pass verify, and hand it back for the next pass.
                          [hoisted-context : OptCfgContext
                            (opt-cfg-context-build hoisted-blocks)]
                          (match (opt-verify-function-with-context
                            hoisted
                            hoisted-context)
                            [(ResultCompilerOptimizeVerify.Ok)
                              (OptFunctionCtxResult.Result
                                hoisted
                                hoisted-context)]
                            [(ResultCompilerOptimizeVerify.Err _)
                              (OptFunctionCtxResult.Result func context)])))]))]))])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-licm-function-with-direct-call-clean
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [direct-call-clean : opt_i64_i64_map.Map]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-licm-function-with-context-result-and-direct-call-clean
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        direct-call-clean
        (opt-global-cell-summary-empty)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

(define (opt-licm-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-licm-function-with-context-result-and-direct-call-clean
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        (opt_i64_i64_map.with-capacity 1)
        (opt-global-cell-summary-empty)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; Test-only driver: LICM with the program's global-cell facts supplied, so a
;; test can exercise loop-scope global operand promotion (which needs declared
;; cell types) without building a whole program pipeline.
(define (opt-licm-function-with-global-cells
  [type-segment-bases : i64]
  [global-cells : OptGlobalCellSummary]
  [late? : bool]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-licm-function-with-context-result-and-direct-call-clean
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        (opt_i64_i64_map.with-capacity 1)
        global-cells
        late?
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- invariant nested-loop entry unswitch ------------------------------------
;;
;; Inlining and compiler-generated foreach lowering can put an inner loop's
;; entry guard inside an enclosing repetition loop. Ordinary LICM moves the
;; guard operands but cannot move the Branch terminator, so the same invariant
;; decision is still made on every outer iteration. Specialize the enclosing
;; loop once on that decision:
;;
;;   guarded outer preheader -> true original outer body
;;                           -> false clone of outer body
;;
;; Keeping the original as the true path preserves the hot nested loop's SSA
;; identities and register allocation. CFG cleanup removes the nested-loop
;; blocks from the false clone, leaving only its cold bypass skeleton. The
;; chosen branch becomes a Jump in each version. Both branch targets must remain
;; inside the outer loop, and one must enter a nested natural loop. The outer
;; header may not have an exit edge: that proves its preheader is already behind
;; the outer zero-trip guard, so unswitching does no work when the outer loop
;; executes zero times. The transform is deliberately bounded and accepts only
;; the scalar instruction subset its cloner handles.
;;
;; `chain-labels` is the rest of the invariant DISPATCH the selected branch
;; opens: the blocks reached along its taken edge that hold nothing but one
;; more invariant Branch. See opt-licm-unswitch-chain-from for why they can be
;; resolved together and what the conjunction buys.
(defstruct OptLicmUnswitchShape
  (header i64)
  (preheader i64)
  (body-labels OptLabelSet)
  (body-blocks ir.CompilerIrBlockList)
  (branch-label i64)
  (branch-index i64)
  (cond ir.CompilerIrValue)
  (true-label i64)
  (false-label i64)
  (chain-labels OptLabelSet))

(defenum OptMaybeLicmUnswitchShape
  (No)
  (Some OptLicmUnswitchShape))

;; The conjunction the preheader tests, and the And instructions that build it.
(defenum OptLicmUnswitchFused
  (Fused ir.CompilerIrInstrList ir.CompilerIrValue))

(define (opt-licm-unswitch-suffix) : String
  "__licm_false")

(define (opt-licm-unswitch-clone-label
  [body-labels : OptLabelSet]
  [label : i64]) : i64
  (if (opt-label-contains body-labels label)
    (ir.compiler-ir-label
      (str_cat.str-cat
        (ir.compiler-ir-label-text label)
        (opt-licm-unswitch-suffix)))
    label))

(define (opt-licm-unswitch-labels-contained?
  [labels : OptLabelSet]
  [container : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (opt-label-contains container (opt-label-ref labels 0))
        (opt-licm-unswitch-labels-contained? (opt-label-tail labels) container))]))

(define (opt-licm-unswitch-target-enters-nested-loop?
  [loops : OptNaturalLoopList]
  [outer-header : i64]
  [outer-body : OptLabelSet]
  [target : i64]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) false]
    [(OptNaturalLoopList.Cons loop rest)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [enters? : bool
          (and
            (not (= header outer-header))
            (opt-label-contains outer-body header)
            (or
              (= target header)
              (match (opt-natural-loop-preheader loop)
                [(OptLoopPreheader.Some preheader) (= target preheader)]
                [(OptLoopPreheader.No) false])))]
        (or
          enters?
          (opt-licm-unswitch-target-enters-nested-loop?
            (__tl-box-place rest)
            outer-header
            outer-body
            target)))]))

(define (opt-licm-unswitch-instr-supported? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.Phi _ _ _) true]
    [(ir.CompilerIrInstr.Jump _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Switch _ _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
    [_ false]))

(define (opt-licm-unswitch-instrs-supported?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-licm-unswitch-instr-supported?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-licm-unswitch-instrs-supported? instrs (+ index 1)))))

(define (opt-licm-unswitch-blocks-supported? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (not (opt-cfg-instr-seq-can-fallthrough? instrs))
            (opt-licm-unswitch-instrs-supported? instrs 0)
            (opt-licm-unswitch-blocks-supported? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-unswitch-blocks-supported?
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-unswitch-labels-fresh?
  [blocks : ir.CompilerIrBlockList]
  [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (not
          (opt-cfg-block-exists?
            blocks
            (opt-licm-unswitch-clone-label labels (opt-label-ref labels 0))))
        (opt-licm-unswitch-labels-fresh? blocks (opt-label-tail labels)))]))

(define (opt-licm-unswitch-preheader-jumps-to?
  [blocks : ir.CompilerIrBlockList]
  [preheader : i64]
  [header : i64]) : bool
  (match (opt-cfg-find-block blocks preheader)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (and
              (> count 0)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump target) (= target header)]
                [_ false])))])]))

;; --- the invariant dispatch chain ------------------------------------------
;;
;; One unswitched branch buys one branch. The shape this pass exists for
;; routinely has FOUR, because the guard an inlined loop carries into an
;; enclosing repetition loop is not one test: a rotated loop contributes its
;; zero-trip guard, the bounds-check versioner contributes its fast/slow
;; dispatch, and the unroller contributes a two-term group guard that the late
;; short-circuit fuser (opt-bool-branch-chain) has already split into two real
;; edges. LICM hoists all four CONDITIONS to the preheader and none of the four
;; BRANCHES, so the enclosing loop re-decides an invariant dispatch every trip.
;; benchmarks/string_scan is the measured case: eight instructions per outer
;; iteration, 4.1% of the whole row, and unswitching any single one of them
;; leaves the other six.
;;
;; So the shape is the whole chain. Walk the blocks that hold NOTHING BUT one
;; more terminator -- a Jump to pass through, a Branch on a loop-invariant
;; condition to collect -- and stop at the first block with any real work in it.
;; Requiring the block to be exactly one instruction is what makes the walk safe
;; to state as a conjunction: a collected block computes nothing, so the only
;; question it asks is its own condition, and the answer is the same on every
;; trip.
;;
;; TWO walks, because the selected branch sits in the MIDDLE of its dispatch.
;; The candidate scan takes the first branch whose arm enters a nested loop, and
;; the tests above that one -- an inlined loop's own zero-trip guard, most of the
;; time -- reach only the loop's exit block on their false arm, so they are never
;; selected and are not on the selected branch's taken path either. Walking down
;; from the header's single successor collects them; walking on from the selected
;; branch's taken label collects the rest; the second walk starts from the first
;; one's result, so a chain that spans the selected branch is gathered once.
;;
;; The preheader then tests the AND of every collected condition. On the true
;; side each collected Branch becomes a Jump to its taken label -- the
;; conjunction says every conjunct holds, so that edge is the one taken on every
;; trip -- and the version is dispatch-free. On the false side the clone keeps
;; the chain intact, because `not (c1 and ... and ck)` says nothing about any
;; individual conjunct. That is also why the single-branch case keeps resolving
;; its clone to the false label: with one conjunct, and only with one, the
;; negation IS a verdict, and refusing to use it would grow every site this
;; pass already admits.
(define (opt-licm-unswitch-chain-fuel) : i64
  8)

;; The walk stops at a nested loop's header, so the chain is the dispatch that
;; SELECTS a loop and never the control of one. A nested loop's own exit test
;; can be invariant in the enclosing loop -- the header of an inner `while (c)`
;; on an outer-invariant `c` is exactly that -- and resolving it would be sound
;; (the conjunction says `c` holds, and the original spins on `c` too) but it is
;; not what this pass is for and it takes the shape past the one the block
;; ceiling above was measured on.
(define (opt-licm-unswitch-nested-loop-header?
  [loops : OptNaturalLoopList]
  [outer-header : i64]
  [label : i64]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) false]
    [(OptNaturalLoopList.Cons loop rest)
      (or
        (let
          [nested : i64 (opt-natural-loop-header loop)]
          (and (not (= nested outer-header)) (= nested label)))
        (opt-licm-unswitch-nested-loop-header?
          (__tl-box-place rest)
          outer-header
          label))]))

;; The taken edge of a pure invariant dispatch block, or -1 when `label` is not
;; one: the clauses are the candidate test of opt-licm-unswitch-find-instrs
;; plus "this block holds the branch and nothing else".
(define (opt-licm-unswitch-dispatch-taken
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [loop-defs : opt_i64_i64_map.Map]
  [label : i64]) : i64
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) (- 0 1)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 1)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Branch cond true-label false-label)
                (if (and
                  (opt-label-contains body-labels true-label)
                  (opt-label-contains body-labels false-label)
                  (match cond
                    [(ir.CompilerIrValue.Var var)
                      (not (opt-used-contains loop-defs var))]
                    [_ false]))
                  true-label
                  (- 0 1))]
              [_ (- 0 1)])
            (- 0 1))])]))

;; The condition of a block already accepted by the walk above.
(define (opt-licm-unswitch-dispatch-cond
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : ir.CompilerIrValue
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) (ir.CompilerIrValue.Bool true)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 1)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Branch cond _ _) cond]
              [_ (ir.CompilerIrValue.Bool true)])
            (ir.CompilerIrValue.Bool true))])]))

(define (opt-licm-unswitch-chain-from
  [blocks : ir.CompilerIrBlockList]
  [loops : OptNaturalLoopList]
  [body-labels : OptLabelSet]
  [loop-defs : opt_i64_i64_map.Map]
  [header : i64]
  [latch : i64]
  [origin : i64]
  [label : i64]
  [acc : OptLabelSet]
  [fuel : i64]) : OptLabelSet
  (if (or
    (<= fuel 0)
    (= label header)
    (= label latch)
    (= label origin)
    (not (opt-label-contains body-labels label))
    (opt-label-contains acc label)
    (opt-licm-unswitch-nested-loop-header? loops header label))
    acc
    (match (opt-cfg-find-block blocks label)
      [(OptMaybeBlock.No) acc]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (if (= (ir.compiler-ir-instr-seq-count instrs) 1)
              (match (ir.compiler-ir-instr-seq-ref instrs 0)
                [(ir.CompilerIrInstr.Jump target)
                  (opt-licm-unswitch-chain-from
                    blocks
                    loops
                    body-labels
                    loop-defs
                    header
                    latch
                    origin
                    target
                    acc
                    (- fuel 1))]
                [(ir.CompilerIrInstr.Branch _ _ _)
                  (let
                    [taken : i64
                      (opt-licm-unswitch-dispatch-taken
                        blocks
                        body-labels
                        loop-defs
                        label)]
                    (if (< taken 0)
                      acc
                      (opt-licm-unswitch-chain-from
                        blocks
                        loops
                        body-labels
                        loop-defs
                        header
                        latch
                        origin
                        taken
                        (opt-label-add acc label)
                        (- fuel 1))))]
                [_ acc])
              acc)])])))

;; `cond AND c1 AND ... AND ck`, built in the preheader from ids past the
;; caller's frame. The conjuncts are materialized booleans the loop does not
;; define, so evaluating all of them eagerly is not just cheap but unobservable.
(define (opt-licm-unswitch-fuse-conds
  [blocks : ir.CompilerIrBlockList]
  [labels : OptLabelSet]
  [index : i64]
  [cond : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]) : OptLicmUnswitchFused
  (if (>= index (opt-label-count labels))
    (OptLicmUnswitchFused.Fused ir.CompilerIrInstrList.Nil cond)
    (let
      [next : ir.CompilerIrValue
        (opt-licm-unswitch-dispatch-cond blocks (opt-label-ref labels index))]
      [fresh : i64 (array-ref cell 0)]
      [_bump : unit (set! (array-ref cell 0) (+ fresh 1))]
      (match (opt-licm-unswitch-fuse-conds
        blocks
        labels
        (+ index 1)
        (ir.CompilerIrValue.Var fresh)
        cell)
        [(OptLicmUnswitchFused.Fused instrs result)
          (OptLicmUnswitchFused.Fused
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                fresh
                (ir.CompilerIrBinOp.And)
                cond
                next
                (ast.AstType.Bool))
              instrs)
            result)]))))

(define (opt-licm-unswitch-find-instrs
  [loops : OptNaturalLoopList]
  [header : i64]
  [body-labels : OptLabelSet]
  [loop-defs : opt_i64_i64_map.Map]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptMaybeLicmUnswitchShape
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptMaybeLicmUnswitchShape.No)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Branch cond true-label false-label)
        (let
          [candidate? : bool
            (and
              (opt-label-contains body-labels true-label)
              (opt-label-contains body-labels false-label)
              (or
                (opt-licm-unswitch-target-enters-nested-loop?
                  loops
                  header
                  body-labels
                  true-label)
                (opt-licm-unswitch-target-enters-nested-loop?
                  loops
                  header
                  body-labels
                  false-label))
              (match cond
                [(ir.CompilerIrValue.Var var)
                  (not (opt-used-contains loop-defs var))]
                [_ false]))]
          (if candidate?
            ;; The caller fills the loop-wide fields after this local scan.
            (OptMaybeLicmUnswitchShape.Some
              (OptLicmUnswitchShape
                header
                (- 0 1)
                body-labels
                ir.CompilerIrBlockList.Nil
                label
                index
                cond
                true-label
                false-label
                (OptLabelSet.Nil)))
            (opt-licm-unswitch-find-instrs
              loops
              header
              body-labels
              loop-defs
              label
              instrs
              (+ index 1))))]
      [_
        (opt-licm-unswitch-find-instrs
          loops
          header
          body-labels
          loop-defs
          label
          instrs
          (+ index 1))])))

(define (opt-licm-unswitch-find-blocks
  [loops : OptNaturalLoopList]
  [header : i64]
  [latch : i64]
  [body-labels : OptLabelSet]
  [loop-defs : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : OptMaybeLicmUnswitchShape
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptMaybeLicmUnswitchShape.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (or (= label header) (= label latch))
            (opt-licm-unswitch-find-blocks
              loops
              header
              latch
              body-labels
              loop-defs
              (__tl-box-place rest))
            (match (opt-licm-unswitch-find-instrs
              loops
              header
              body-labels
              loop-defs
              label
              instrs
              0)
              [(OptMaybeLicmUnswitchShape.Some shape)
                (OptMaybeLicmUnswitchShape.Some shape)]
              [(OptMaybeLicmUnswitchShape.No)
                (opt-licm-unswitch-find-blocks
                  loops
                  header
                  latch
                  body-labels
                  loop-defs
                  (__tl-box-place rest))]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-unswitch-find-blocks
        loops
        header
        latch
        body-labels
        loop-defs
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-licm-unswitch-loop-shape
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [loops : OptNaturalLoopList]
  [loop : OptNaturalLoop]) : OptMaybeLicmUnswitchShape
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.No) (OptMaybeLicmUnswitchShape.No)]
    [(OptLoopPreheader.Some preheader)
      (let
        [header : i64 (opt-natural-loop-header loop)]
        [latch : i64 (opt-natural-loop-latch loop)]
        [body-labels : OptLabelSet (opt-natural-loop-body loop)]
        [body-blocks : ir.CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        [successors : OptLabelSet
          (opt-pred-map-successors context.pred-map header)]
        [loop-defs : opt_i64_i64_map.Map
          (opt-licm-collect-defs-blocks
            body-blocks
            (opt_i64_i64_map.with-capacity
              (opt-licm-body-map-capacity body-blocks)))]
        (if (or
          (< (opt-label-count body-labels) 3)
          (> (opt-label-count body-labels) 16)
          (> (ir.compiler-ir-block-list-instruction-count body-blocks) 192)
          ;; There was a clause here refusing any body carrying a `__bce_`
          ;; label -- "do not clone an already BCE-versioned nested loop", on
          ;; the argument that duplicating both versions would inflate
          ;; function-wide live-range weights enough to spill a hot scalar SPMD
          ;; loop. It is gone, and the two-sided measurement is why.
          ;;
          ;; REFUSE SIDE, re-measured on this tree with the clause dropped and
          ;; nothing else changed: not one of the twenty-two instruction rows
          ;; moves against it. Every spmd row -- map, mask, reduce, short_tail,
          ;; zip, the exact family the clause names -- is identical to the
          ;; digit, as are cfg_domloops, gvn_table, intern_table, lex_source,
          ;; peephole_lines, opt_quicksort, opt_bytecode_vm, opt_crc32,
          ;; arith_loop, borrowed_disjoint_store and all four hashmap rows.
          ;;
          ;; ADMIT SIDE: string_scan -75,000,004 (5,050,000,293 ->
          ;; 4,975,000,289) from the clause alone, array_sum -18,000,
          ;; liveness_scan -23,940.
          ;;
          ;; What the clause was really refusing is the shape this pass was
          ;; built for. A versioned nested loop is precisely a loop whose entry
          ;; guard is a dispatch, and once the whole dispatch is resolved
          ;; together (see the chain above) the rewrite is not a duplication of
          ;; both versions at all: the kept side keeps the fast version and
          ;; nothing else, the clone keeps the rest, and CFG cleanup deletes
          ;; what each side cannot reach.
          (not (opt-licm-unswitch-labels-contained? successors body-labels))
          (not (opt-licm-unswitch-preheader-jumps-to? blocks preheader header))
          (not (opt-licm-unswitch-labels-fresh? blocks body-labels))
          (not (opt-licm-unswitch-blocks-supported? body-blocks)))
          (OptMaybeLicmUnswitchShape.No)
          (match (opt-licm-unswitch-find-blocks
            loops
            header
            latch
            body-labels
            loop-defs
            body-blocks)
            [(OptMaybeLicmUnswitchShape.No) (OptMaybeLicmUnswitchShape.No)]
            [(OptMaybeLicmUnswitchShape.Some candidate)
              (OptMaybeLicmUnswitchShape.Some
                (OptLicmUnswitchShape
                  header
                  preheader
                  body-labels
                  body-blocks
                  candidate.branch-label
                  candidate.branch-index
                  candidate.cond
                  candidate.true-label
                  candidate.false-label
                  (opt-licm-unswitch-chain-from
                    blocks
                    loops
                    body-labels
                    loop-defs
                    header
                    latch
                    candidate.branch-label
                    candidate.true-label
                    (if (= (opt-label-count successors) 1)
                      (opt-licm-unswitch-chain-from
                        blocks
                        loops
                        body-labels
                        loop-defs
                        header
                        latch
                        candidate.branch-label
                        (opt-label-ref successors 0)
                        (OptLabelSet.Nil)
                        (opt-licm-unswitch-chain-fuel))
                      (OptLabelSet.Nil))
                    (opt-licm-unswitch-chain-fuel))))])))]))

(define (opt-licm-unswitch-switch-cases
  [cases : ir.CompilerIrSwitchCaseList]
  [body-labels : OptLabelSet]) : ir.CompilerIrSwitchCaseList
  (match (ir.compiler-ir-switch-case-list-force-cons cases)
    [(ir.CompilerIrSwitchCaseList.Nil) ir.CompilerIrSwitchCaseList.Nil]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-licm-unswitch-switch-cases
        (ir.compiler-ir-switch-case-seq-to-list seq)
        body-labels)]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case tag label)
          (ir.compiler-ir-switch-case-cons-linked
            tag
            (opt-licm-unswitch-clone-label body-labels label)
            (opt-licm-unswitch-switch-cases (__tl-box-place rest) body-labels))])]))

(define (opt-licm-unswitch-clone-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-licm-unswitch-clone-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        remap
        body-labels)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-unroll-subst-value remap value)
        (opt-licm-unswitch-clone-label body-labels label)
        (opt-licm-unswitch-clone-phi-inputs
          (__tl-box-place rest)
          remap
          body-labels))]))

(define (opt-licm-unswitch-clone-instr
  [instr : ir.CompilerIrInstr]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-unroll-subst-value remap index)
        (opt-unroll-subst-value remap length)
        (if (opt-label-contains body-labels ok-label)
          (opt-licm-unswitch-clone-label body-labels ok-label)
          (if (opt-label-contains all-labels ok-label)
            ok-label
            (ir.compiler-ir-label
              (str_cat.str-cat
                (ir.compiler-ir-label-text ok-label)
                (opt-licm-unswitch-suffix))))))]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        (opt-bce-mb-remap-dst remap dst)
        (opt-licm-unswitch-clone-phi-inputs inputs remap body-labels)
        ty)]
    [(ir.CompilerIrInstr.Jump target)
      (ir.CompilerIrInstr.Jump
        (opt-licm-unswitch-clone-label body-labels target))]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (ir.CompilerIrInstr.Branch
        (opt-unroll-subst-value remap cond)
        (opt-licm-unswitch-clone-label body-labels true-label)
        (opt-licm-unswitch-clone-label body-labels false-label))]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (ir.CompilerIrInstr.TotalEnumBranch
        (opt-unroll-subst-value remap cond)
        (opt-licm-unswitch-clone-label body-labels true-label)
        (opt-licm-unswitch-clone-label body-labels false-label))]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        (opt-unroll-subst-value remap index)
        base
        (opt-licm-unswitch-switch-cases cases body-labels)
        (opt-licm-unswitch-clone-label body-labels default-label))]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (opt-unroll-subst-value remap index)
        base
        (opt-licm-unswitch-switch-cases cases body-labels)
        (opt-licm-unswitch-clone-label body-labels default-label)
        (opt-licm-unswitch-clone-label body-labels trap-label))]
    [_ instr]))

(define (opt-licm-unswitch-clone-instrs
  [shape : OptLicmUnswitchShape]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [all-labels : OptLabelSet]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    ir.CompilerIrInstrList.Nil
    (ir.compiler-ir-instr-cons
      ;; A negated conjunction is only a verdict on ONE conjunct, so the clone
      ;; resolves its branch exactly when the chain is empty.
      (if (and
        (= label shape.branch-label)
        (= index shape.branch-index)
        (= (opt-label-count shape.chain-labels) 0))
        (ir.CompilerIrInstr.Jump
          (opt-licm-unswitch-clone-label shape.body-labels shape.false-label))
        (opt-licm-unswitch-clone-instr
          (ir.compiler-ir-instr-seq-ref instrs index)
          remap
          shape.body-labels
          all-labels))
      (opt-licm-unswitch-clone-instrs
        shape
        label
        instrs
        (+ index 1)
        remap
        all-labels))))

(define (opt-licm-unswitch-clone-blocks
  [shape : OptLicmUnswitchShape]
  [blocks : ir.CompilerIrBlockList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [all-labels : OptLabelSet]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.compiler-ir-block
              (opt-licm-unswitch-clone-label shape.body-labels label)
              (opt-licm-unswitch-clone-instrs
                shape
                label
                instrs
                0
                remap
                all-labels))
            (opt-licm-unswitch-clone-blocks
              shape
              (__tl-box-place rest)
              remap
              all-labels))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-unswitch-clone-blocks
        shape
        (ir.compiler-ir-block-seq-to-list seq)
        remap
        all-labels)]))

(define (opt-licm-unswitch-clone-param-moves!
  [params : ir.CompilerIrParamList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]) : ir.CompilerIrInstrList
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) ir.CompilerIrInstrList.Nil]
    [(ir.CompilerIrParamList.Array seq)
      (opt-licm-unswitch-clone-param-moves!
        (ir.compiler-ir-param-seq-to-list seq)
        remap
        cell)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ ty var)
          (let
            [fresh : i64 (array-ref cell 0)]
            (begin
              (set! (array-ref cell 0) (+ fresh 1))
              (set! (array-ref remap var) (ir.CompilerIrValue.Var fresh))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Mov fresh (ir.CompilerIrValue.Var var) ty)
                (opt-licm-unswitch-clone-param-moves!
                  (__tl-box-place rest)
                  remap
                  cell))))])]))

(define (opt-licm-unswitch-instrs-onto
  [prefix : ir.CompilerIrInstrList]
  [tail : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match prefix
    [(ir.CompilerIrInstrList.Nil) tail]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (ir.compiler-ir-instr-cons
        instr
        (opt-licm-unswitch-instrs-onto (__tl-box-place rest) tail))]))

(define (opt-licm-unswitch-original-instrs
  [shape : OptLicmUnswitchShape]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    ir.CompilerIrInstrList.Nil
    (ir.compiler-ir-instr-cons
      (if (and (= label shape.branch-label) (= index shape.branch-index))
        (ir.CompilerIrInstr.Jump shape.true-label)
        ;; Every collected conjunct holds on this side, so each chain block's
        ;; Branch is the Jump it always takes here.
        (if (opt-label-contains shape.chain-labels label)
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Branch _ true-label _)
              (ir.CompilerIrInstr.Jump true-label)]
            [_ (ir.compiler-ir-instr-seq-ref instrs index)])
          (ir.compiler-ir-instr-seq-ref instrs index)))
      (opt-licm-unswitch-original-instrs shape label instrs (+ index 1)))))

(define (opt-licm-unswitch-preheader-instrs
  [shape : OptLicmUnswitchShape]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [fuse-instrs : ir.CompilerIrInstrList]
  [fused-cond : ir.CompilerIrValue]
  [clone-param-moves : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (>= index count)
      ir.CompilerIrInstrList.Nil
      (if (= index (- count 1))
        (opt-licm-unswitch-instrs-onto
          fuse-instrs
          (opt-licm-unswitch-instrs-onto
            clone-param-moves
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Branch
                fused-cond
                shape.header
                (opt-licm-unswitch-clone-label shape.body-labels shape.header))
              ir.CompilerIrInstrList.Nil)))
        (ir.compiler-ir-instr-cons
          (ir.compiler-ir-instr-seq-ref instrs index)
          (opt-licm-unswitch-preheader-instrs
            shape
            instrs
            (+ index 1)
            fuse-instrs
            fused-cond
            clone-param-moves))))))

(define (opt-licm-unswitch-extend-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [body-labels : OptLabelSet]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-licm-unswitch-extend-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        body-labels
        remap)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : ir.CompilerIrPhiInputList
          (opt-licm-unswitch-extend-phi-inputs
            (__tl-box-place rest)
            body-labels
            remap)]
        (if (opt-label-contains body-labels label)
          (ir.compiler-ir-phi-input-cons
            value
            label
            (ir.compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap value)
              (opt-licm-unswitch-clone-label body-labels label)
              tail))
          (ir.compiler-ir-phi-input-cons value label tail)))]))

(define (opt-licm-unswitch-extend-exit-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [body-labels : OptLabelSet]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    ir.CompilerIrInstrList.Nil
    (ir.compiler-ir-instr-cons
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Phi dst inputs ty)
          (ir.CompilerIrInstr.Phi
            dst
            (opt-licm-unswitch-extend-phi-inputs inputs body-labels remap)
            ty)]
        [_ (ir.compiler-ir-instr-seq-ref instrs index)])
      (opt-licm-unswitch-extend-exit-instrs
        instrs
        (+ index 1)
        body-labels
        remap))))

(define (opt-licm-unswitch-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [shape : OptLicmUnswitchShape]
  [cloned : ir.CompilerIrBlockList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [fuse-instrs : ir.CompilerIrInstrList]
  [fused-cond : ir.CompilerIrValue]
  [clone-param-moves : ir.CompilerIrInstrList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-licm-unswitch-rewrite-blocks
                (__tl-box-place rest)
                shape
                cloned
                remap
                fuse-instrs
                fused-cond
                clone-param-moves)]
            (cond
              [(= label shape.preheader)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-licm-unswitch-preheader-instrs
                      shape
                      instrs
                      0
                      fuse-instrs
                      fused-cond
                      clone-param-moves))
                  tail)]
              [(= label shape.header)
                (opt-bce-mb-blocks-cons-onto
                  cloned
                  (ir.compiler-ir-block-cons
                    (ir.compiler-ir-block
                      label
                      (opt-licm-unswitch-original-instrs shape label instrs 0))
                    tail))]
              [(opt-label-contains shape.body-labels label)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-licm-unswitch-original-instrs shape label instrs 0))
                  tail)]
              [else
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-licm-unswitch-extend-exit-instrs
                      instrs
                      0
                      shape.body-labels
                      remap))
                  tail)]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-licm-unswitch-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        shape
        cloned
        remap
        fuse-instrs
        fused-cond
        clone-param-moves)]))

(define (opt-licm-unswitch-apply
  [blocks : ir.CompilerIrBlockList]
  [shape : OptLicmUnswitchShape]
  [params : ir.CompilerIrParamList]
  [frame : i64]) : OptUnrollResult
  (let
    [outside : opt_i64_i64_map.Map
      (opt-bce-mb-outside-uses
        (opt_i64_i64_map.with-capacity 64)
        blocks
        shape.body-labels)]
    (if (opt-bce-mb-defs-escape? shape.body-blocks outside)
      (OptUnrollResult.Result blocks frame false)
      (let
        [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
        [_cell : unit (set! (array-ref cell 0) frame)]
        ;; Allocated before the clone's ids: the conjunction lives in the
        ;; preheader and is never cloned or remapped.
        [fused : OptLicmUnswitchFused
          (opt-licm-unswitch-fuse-conds
            blocks
            shape.chain-labels
            0
            shape.cond
            cell)]
        [remap : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [_fill : unit (opt-unroll-remap-fill remap 0)]
        [clone-param-moves : ir.CompilerIrInstrList
          (opt-licm-unswitch-clone-param-moves! params remap cell)]
        [_alloc : unit (opt-bce-mb-alloc-defs! shape.body-blocks remap cell)]
        [all-labels : OptLabelSet
          (opt-bce-mb-all-labels-from blocks (OptLabelSet.Nil))]
        [cloned : ir.CompilerIrBlockList
          (opt-licm-unswitch-clone-blocks
            shape
            shape.body-blocks
            remap
            all-labels)]
        (match fused
          [(OptLicmUnswitchFused.Fused fuse-instrs fused-cond)
            (OptUnrollResult.Result
              (opt-licm-unswitch-rewrite-blocks
                blocks
                shape
                cloned
                remap
                fuse-instrs
                fused-cond
                clone-param-moves)
              (array-ref cell 0)
              true)])))))

(define (opt-licm-unswitch-loops
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [all-loops : OptNaturalLoopList]
  [remaining : OptNaturalLoopList]
  [params : ir.CompilerIrParamList]
  [frame : i64]) : OptUnrollResult
  (match remaining
    [(OptNaturalLoopList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-licm-unswitch-loop-shape blocks context all-loops loop)
        [(OptMaybeLicmUnswitchShape.Some shape)
          (match (opt-licm-unswitch-apply blocks shape params frame)
            [(OptUnrollResult.Result next next-frame changed)
              (if changed
                (OptUnrollResult.Result next next-frame true)
                (opt-licm-unswitch-loops
                  blocks
                  context
                  all-loops
                  (__tl-box-place rest)
                  params
                  frame))])]
        [(OptMaybeLicmUnswitchShape.No)
          (opt-licm-unswitch-loops
            blocks
            context
            all-loops
            (__tl-box-place rest)
            params
            frame)])]))

(define (opt-licm-unswitch-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [loops : OptNaturalLoopList
              (opt-cfg-natural-loops-with-context blocks context)]
            (match (opt-licm-unswitch-loops
              blocks
              context
              loops
              loops
              params
              frame)
              [(OptUnrollResult.Result next next-frame changed)
                (if (not changed)
                  (OptFunctionCtxResult.Result func context)
                  (let
                    [simplified : ir.CompilerIrBlockList
                      (opt-cfg-simplify-blocks next)]
                    [rewritten : ir.CompilerIrFunction
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        next-frame
                        simplified)]
                    [next-context : OptCfgContext
                      (opt-cfg-context-build simplified)]
                    (match (opt-verify-function-with-context
                      rewritten
                      next-context)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionCtxResult.Result rewritten next-context)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionCtxResult.Result func context)])))]))])]))

;; Run specialization only after the opt2 fixpoint. Besides avoiding repeated
;; cloning, this preserves the deliberately split false-path parameter copies:
;; an intervening copy-propagation pass would merge them back into the hot
;; values, inflate those live-range weights, and make the backend spill the
;; outer accumulator. A final DCE removes computations made dead in the cold
;; bypass clone without rewriting those copies.
(define (opt-licm-unswitch-final
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-licm-unswitch-function-with-context-result
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _)
          (if (opt-function-eq type-segment-bases func next)
            func
            (match next
              [(ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  frame
                  next-blocks)
                (let
                  [used : (__tl_dyn-array i64)
                    (opt-collect-blocks-uses-array frame next-blocks)]
                  [dced : ir.CompilerIrBlockList
                    (match (opt-dce-block-list-array-pass used next-blocks)
                      [(OptBlockListPassResult.Result result _) result])]
                  [candidate : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      frame
                      dced)]
                  (match (opt-verify-function candidate)
                    [(ResultCompilerOptimizeVerify.Ok) candidate]
                    [(ResultCompilerOptimizeVerify.Err _) func]))]))])]))

;; --- simple induction-derived cleanup --------------------------------------
;;
;; This first induction slice recognizes canonical `i64` loop-carried phis:
;; `i = phi(preheader_seed, latch_next)` where `latch_next` is `i +/- const`,
;; chasing the copy chains SSA renaming leaves between the add and the phi.
;; It then strength-reduces repeated derived offset/address families per loop by
;; adding matching derived phis: plain `mul i, k` products, and `gep` addresses
;; whose per-iteration byte stride does NOT fold into the x86 addressing mode
;; (a folded address is free at each use, so an address IV there only adds a
;; latch add and a loop-live range). Ordinary stores do not invalidate the
;; affine SSA recurrence; allocation, vector/predicated memory, syscall,
;; target-probe, copy-bytes, calls, and tail-call shapes stay fail-closed (a
;; derived phi is loop-live, so across a call it would spill more than the
;; per-iteration mul/gep it replaces). Bounds checks are left in place. The
;; function verifier gates the final rewritten function.
(defenum OptInductionPhiInputs
  (No)
  (Some ir.CompilerIrValue i64))

(defenum OptInductionFact
  (Fact i64 ir.CompilerIrValue i64 i64 ast.AstType))

(defenum OptMaybeInductionFact
  (No)
  (Some OptInductionFact))

(defenum OptInductionDerived
  (Mul i64 i64 ast.AstType)
  (Gep ir.CompilerIrValue i64 ast.AstType)
  ;; A `gep base, (mul phi, scale)` address (the offset var's def is a plain
  ;; scaled recurrence, not an affine phi+const): base, scale, element type.
  ;; The derived phi is the ADDRESS itself, stepping step*scale elements per
  ;; iteration, which folds the fetch into the load's addressing mode.
  (GepScaled ir.CompilerIrValue i64 ast.AstType))

(defenum OptInductionDerivedList
  (Nil)
  (Cons OptInductionDerived (Box OptInductionDerivedList)))

(defenum OptMaybeInductionDerived
  (No)
  (Some OptInductionDerived))

(defenum OptInductionApplyResult
  (Result ir.CompilerIrBlockList i64 bool))

(define (opt-induction-fact-start [fact : OptInductionFact]) : ir.CompilerIrValue
  (match fact
    [(OptInductionFact.Fact _ start _ _ _) start]))

(define (opt-induction-fact-step [fact : OptInductionFact]) : i64
  (match fact
    [(OptInductionFact.Fact _ _ _ step _) step]))

(define (opt-induction-i64-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [_ false]))

(define (opt-induction-nonzero-step [step : i64]) : option_i64.Option
  (if (= step 0)
    (option_i64.None)
    (option_i64.Some step)))

(define (opt-induction-phi-input-pair
  [a-value : ir.CompilerIrValue]
  [a-label : i64]
  [b-value : ir.CompilerIrValue]
  [b-label : i64]
  [preheader : i64]
  [latch : i64]) : OptInductionPhiInputs
  (if (and (= a-label preheader) (= b-label latch))
    (match b-value
      [(ir.CompilerIrValue.Var back) (OptInductionPhiInputs.Some a-value back)]
      [_ (OptInductionPhiInputs.No)])
    (if (and (= b-label preheader) (= a-label latch))
      (match a-value
        [(ir.CompilerIrValue.Var back)
          (OptInductionPhiInputs.Some b-value back)]
        [_ (OptInductionPhiInputs.No)])
      (OptInductionPhiInputs.No))))

(define (opt-induction-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [preheader : i64]
  [latch : i64]) : OptInductionPhiInputs
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Cons a-value a-label rest)
      (match (__tl-box-place rest)
        [(ir.CompilerIrPhiInputList.Cons b-value b-label rest2)
          (match (__tl-box-place rest2)
            [(ir.CompilerIrPhiInputList.Nil)
              (opt-induction-phi-input-pair
                a-value
                a-label
                b-value
                b-label
                preheader
                latch)]
            [_ (OptInductionPhiInputs.No)])]
        [_ (OptInductionPhiInputs.No)])]
    [_ (OptInductionPhiInputs.No)]))

(define (opt-induction-step-from-add
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(ir.CompilerIrValue.I64 step) (opt-induction-nonzero-step step)]
          [_ (option_i64.None)])
        (option_i64.None))]
    [(ir.CompilerIrValue.I64 step)
      (match rhs
        [(ir.CompilerIrValue.Var var)
          (if (= var phi-var)
            (opt-induction-nonzero-step step)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-induction-step-from-sub
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(ir.CompilerIrValue.I64 step)
            (opt-induction-nonzero-step (- 0 step))]
          [_ (option_i64.None)])
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-step-from-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match op
    [(ir.CompilerIrBinOp.Add) (opt-induction-step-from-add lhs rhs phi-var)]
    [(ir.CompilerIrBinOp.Sub) (opt-induction-step-from-sub lhs rhs phi-var)]
    [_ (option_i64.None)]))

(define (opt-induction-update-step-instr
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [phi-var : i64]
  [next-var : i64]
  [ty : ast.AstType]) : option_i64.Option
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs instr-ty)
      (if (and
        (= dst next-var)
        (opt-type-eq type-segment-bases instr-ty ty)
        (opt-induction-i64-type? ty))
        (opt-induction-step-from-binop op lhs rhs phi-var)
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-find-update-instr-seq-from
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-var : i64]
  [next-var : i64]
  [ty : ast.AstType]) : option_i64.Option
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (option_i64.None)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst next-var)
            (opt-induction-update-step-instr
              type-segment-bases
              instr
              phi-var
              next-var
              ty)
            (opt-induction-find-update-instr-seq-from
              type-segment-bases
              instrs
              (+ index 1)
              phi-var
              next-var
              ty))]
        [(option_i64.None)
          (opt-induction-find-update-instr-seq-from
            type-segment-bases
            instrs
            (+ index 1)
            phi-var
            next-var
            ty)]))))

(define (opt-induction-find-update-instr-seq
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-var : i64]
  [next-var : i64]
  [ty : ast.AstType]) : option_i64.Option
  (opt-induction-find-update-instr-seq-from
    type-segment-bases
    instrs
    0
    phi-var
    next-var
    ty))

(define (opt-induction-find-update-blocks
  [type-segment-bases : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [next-var : i64]
  [ty : ast.AstType]) : option_i64.Option
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) (option_i64.None)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-induction-find-update-instr-seq
            type-segment-bases
            instrs
            phi-var
            next-var
            ty)
            [(option_i64.Some step) (option_i64.Some step)]
            [(option_i64.None)
              (opt-induction-find-update-blocks
                type-segment-bases
                (__tl-box-place rest)
                phi-var
                next-var
                ty)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-find-update-blocks
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        phi-var
        next-var
        ty)]))

;; Find the var a Mov copies from -- the SSA renaming hop between the latch's
;; recurrence value and the arithmetic that computes it.
(define (opt-induction-mov-source-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : option_i64.Option
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (option_i64.None)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Mov dst src _)
        (if (= dst var)
          (match src
            [(ir.CompilerIrValue.Var src-var) (option_i64.Some src-var)]
            [_ (option_i64.None)])
          (opt-induction-mov-source-instr-seq-from instrs (+ index 1) var))]
      [_ (opt-induction-mov-source-instr-seq-from instrs (+ index 1) var)])))

(define (opt-induction-mov-source-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : option_i64.Option
  (opt-induction-mov-source-instr-seq-from instrs 0 var))

(define (opt-induction-mov-source-blocks
  [body-blocks : ir.CompilerIrBlockList]
  [var : i64]) : option_i64.Option
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) (option_i64.None)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-induction-mov-source-instr-seq instrs var)
            [(option_i64.Some src) (option_i64.Some src)]
            [(option_i64.None)
              (opt-induction-mov-source-blocks (__tl-box-place rest) var)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-mov-source-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        var)]))

;; Chase up to 4 copy hops (the cap guards against mov cycles in non-SSA
;; fallbacks): `next = mov t; t = add i, k` resolves to the add's var.
(define (opt-induction-mov-chain-var
  [body-blocks : ir.CompilerIrBlockList]
  [var : i64]
  [depth : i64]) : option_i64.Option
  (if (>= depth 4)
    (option_i64.None)
    (match (opt-induction-mov-source-blocks body-blocks var)
      [(option_i64.Some src)
        (match (opt-induction-mov-chain-var body-blocks src (+ depth 1))
          [(option_i64.Some resolved) (option_i64.Some resolved)]
          [(option_i64.None) (option_i64.Some src)])]
      [(option_i64.None) (option_i64.None)])))

(define (opt-induction-fact-from-phi
  [type-segment-bases : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instr : ir.CompilerIrInstr]) : OptMaybeInductionFact
  (match instr
    [(ir.CompilerIrInstr.Phi phi-var inputs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-phi-inputs
          inputs
          preheader
          (opt-natural-loop-latch loop))
          [(OptInductionPhiInputs.Some start next-var)
            (match (opt-induction-find-update-blocks
              type-segment-bases
              body-blocks
              phi-var
              next-var
              ty)
              [(option_i64.Some step)
                (OptMaybeInductionFact.Some
                  (OptInductionFact.Fact phi-var start next-var step ty))]
              [(option_i64.None)
                ;; SSA renaming often routes the latch recurrence through a
                ;; copy chain; chase it to the arithmetic before giving up.
                (match (opt-induction-mov-chain-var body-blocks next-var 0)
                  [(option_i64.Some resolved)
                    (match (opt-induction-find-update-blocks
                      type-segment-bases
                      body-blocks
                      phi-var
                      resolved
                      ty)
                      [(option_i64.Some step)
                        (OptMaybeInductionFact.Some
                          (OptInductionFact.Fact phi-var start next-var step ty))]
                      [(option_i64.None) (OptMaybeInductionFact.No)])]
                  [(option_i64.None) (OptMaybeInductionFact.No)])])]
          [(OptInductionPhiInputs.No) (OptMaybeInductionFact.No)])
        (OptMaybeInductionFact.No))]
    [_ (OptMaybeInductionFact.No)]))

(define (opt-induction-find-fact-instr-seq-from
  [type-segment-bases : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptMaybeInductionFact
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptMaybeInductionFact.No)
    (match (opt-induction-fact-from-phi
      type-segment-bases
      body-blocks
      loop
      preheader
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInductionFact.Some fact) (OptMaybeInductionFact.Some fact)]
      [(OptMaybeInductionFact.No)
        (opt-induction-find-fact-instr-seq-from
          type-segment-bases
          body-blocks
          loop
          preheader
          instrs
          (+ index 1))])))

(define (opt-induction-find-fact-instr-seq
  [type-segment-bases : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instrs : ir.CompilerIrInstrSeq]) : OptMaybeInductionFact
  (opt-induction-find-fact-instr-seq-from
    type-segment-bases
    body-blocks
    loop
    preheader
    instrs
    0))

(define (opt-induction-find-fact
  [type-segment-bases : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]) : OptMaybeInductionFact
  (match (opt-cfg-find-block body-blocks (opt-natural-loop-header loop))
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-induction-find-fact-instr-seq
            type-segment-bases
            body-blocks
            loop
            preheader
            instrs)])]
    [(OptMaybeBlock.No) (OptMaybeInductionFact.No)]))

(define (opt-induction-blocker-instr-seq-at?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (match (& (array-ref instrs.slots index))
    [(ir.CompilerIrInstr.Alloc _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [(ir.CompilerIrInstr.VectorStore _) true]
    [(ir.CompilerIrInstr.PredicatedStore _) true]
    [(ir.CompilerIrInstr.CpuId _ _ _ _) true]
    [(ir.CompilerIrInstr.Xgetbv _ _) true]
    [(ir.CompilerIrInstr.Syscall _ _) true]
    [(ir.CompilerIrInstr.SpmdCall _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    ;; A derived phi is loop-live: across a call it must ride in a
    ;; callee-saved register or spill slot, and that traffic costs more than
    ;; the per-iteration mul/gep the IV replaces. Loops with calls keep their
    ;; plain recurrences.
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [_ false]))

(define (opt-induction-blocker-instr-seq-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-induction-blocker-instr-seq-at? instrs index)
      (opt-induction-blocker-instr-seq-from? instrs (+ index 1)))))

(define (opt-induction-blocker-instr-seq? [instrs : ir.CompilerIrInstrSeq]) : bool
  (opt-induction-blocker-instr-seq-from? instrs 0))

(define (opt-induction-loop-blocked? [body-blocks : ir.CompilerIrBlockList]) : bool
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-induction-blocker-instr-seq? instrs)
            true
            (opt-induction-loop-blocked? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-loop-blocked? (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-small-const? [value : i64]) : bool
  (and (>= value (- 0 1000000)) (<= value 1000000)))

(define (opt-induction-scale-ok? [step : i64] [scale : i64]) : bool
  (and
    (not (= scale 0))
    (not (= scale 1))
    (opt-induction-small-const? step)
    (opt-induction-small-const? scale)))

(define (opt-induction-offset-ok? [offset : i64]) : bool
  (opt-induction-small-const? offset))

(define (opt-induction-affine-offset-from-add
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(ir.CompilerIrValue.I64 offset)
            (if (opt-induction-offset-ok? offset)
              (option_i64.Some offset)
              (option_i64.None))]
          [_ (option_i64.None)])
        (option_i64.None))]
    [(ir.CompilerIrValue.I64 offset)
      (match rhs
        [(ir.CompilerIrValue.Var var)
          (if (and (= var phi-var) (opt-induction-offset-ok? offset))
            (option_i64.Some offset)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-induction-affine-offset-from-sub
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(ir.CompilerIrValue.I64 offset)
            (if (opt-induction-offset-ok? offset)
              (let
                [negated : i64 (- 0 offset)]
                (if (opt-induction-offset-ok? negated)
                  (option_i64.Some negated)
                  (option_i64.None)))
              (option_i64.None))]
          [_ (option_i64.None)])
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-affine-offset-from-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match op
    [(ir.CompilerIrBinOp.Add)
      (opt-induction-affine-offset-from-add lhs rhs phi-var)]
    [(ir.CompilerIrBinOp.Sub)
      (opt-induction-affine-offset-from-sub lhs rhs phi-var)]
    [_ (option_i64.None)]))

(define (opt-induction-affine-offset-env-instr
  [env : opt_i64_i64_map.Map (:consume)]
  [phi-var : i64]
  [instr : ir.CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-affine-offset-from-binop op lhs rhs phi-var)
          [(option_i64.Some offset)
            (let
              [out : opt_i64_i64_map.Map env]
              (begin
                (opt_i64_i64_map.insert-ref! (&mut out) dst offset)
                out))]
          [(option_i64.None) env])
        env)]
    [_ env]))

(define (opt-induction-affine-offset-env-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-var : i64]
  [env : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    env
    (opt-induction-affine-offset-env-instr-seq-from
      instrs
      (+ index 1)
      phi-var
      (opt-induction-affine-offset-env-instr
        env
        phi-var
        (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-induction-affine-offset-env-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [phi-var : i64]
  [env : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (opt-induction-affine-offset-env-instr-seq-from instrs 0 phi-var env))

(define (opt-induction-affine-offset-env-blocks
  [body-blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [env : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) env]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-induction-affine-offset-env-blocks
            (__tl-box-place rest)
            phi-var
            (opt-induction-affine-offset-env-instr-seq instrs phi-var env))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-affine-offset-env-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        phi-var
        env)]))

(define (opt-induction-affine-offset-env
  [body-blocks : ir.CompilerIrBlockList]
  [fact : OptInductionFact]) : opt_i64_i64_map.Map
  (match fact
    [(OptInductionFact.Fact phi-var _ _ _ _)
      (opt-induction-affine-offset-env-blocks
        body-blocks
        phi-var
        (opt_i64_i64_map.with-capacity (opt-licm-body-map-capacity body-blocks)))]))

(define (opt-induction-value-offset
  [offsets : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (= var phi-var)
        (option_i64.Some 0)
        (match (opt_i64_i64_map.get (& offsets) var)
          [(opt_i64_i64_map.LookupFound offset) (option_i64.Some offset)]
          [(opt_i64_i64_map.LookupMissing) (option_i64.None)]))]
    [_ (option_i64.None)]))

(define (opt-induction-mul-derived
  [offsets : opt_i64_i64_map.Map]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]
  [step : i64]
  [ty : ast.AstType]) : OptMaybeInductionDerived
  (match (opt-induction-value-offset offsets lhs phi-var)
    [(option_i64.Some offset)
      (match rhs
        [(ir.CompilerIrValue.I64 scale)
          (if (opt-induction-scale-ok? step scale)
            (OptMaybeInductionDerived.Some
              (OptInductionDerived.Mul scale offset ty))
            (OptMaybeInductionDerived.No))]
        [_ (OptMaybeInductionDerived.No)])]
    [(option_i64.None)
      (match lhs
        [(ir.CompilerIrValue.I64 scale)
          (match (opt-induction-value-offset offsets rhs phi-var)
            [(option_i64.Some offset)
              (if (opt-induction-scale-ok? step scale)
                (OptMaybeInductionDerived.Some
                  (OptInductionDerived.Mul scale offset ty))
                (OptMaybeInductionDerived.No))]
            [(option_i64.None) (OptMaybeInductionDerived.No)])]
        [_ (OptMaybeInductionDerived.No)])]))

;; Induction runs without a hoisted set, so GEP-base loop-invariance is
;; `opt-licm-value-invariant?` with an empty `hoisted` map: a var is invariant
;; iff it is not defined inside the loop body. Evaluating it directly avoids
;; allocating an empty sentinel map per GEP candidate.
(define (opt-induction-value-base-invariant?
  [loop-defs : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var) (not (opt-used-contains loop-defs var))]
    [_ true]))

;; The scale of a `mul phi, scale-lit` (either operand order), if it is one.
(define (opt-induction-mul-scale-of
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [phi-var : i64]) : option_i64.Option
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (if (= var phi-var)
        (match rhs
          [(ir.CompilerIrValue.I64 scale) (option_i64.Some scale)]
          [_ (option_i64.None)])
        (option_i64.None))]
    [(ir.CompilerIrValue.I64 scale)
      (match rhs
        [(ir.CompilerIrValue.Var var)
          (if (= var phi-var)
            (option_i64.Some scale)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

;; Vars used as a gep's var offset (invariant base only, mirroring the
;; derived-collection rule).
(define (opt-induction-gep-offset-vars-instr-seq-from
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [vars : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    vars
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Gep _ base offset _)
        (match offset
          [(ir.CompilerIrValue.Var offset-var)
            (if (opt-induction-value-base-invariant? loop-defs base)
              (opt-induction-gep-offset-vars-instr-seq-from
                loop-defs
                instrs
                (+ index 1)
                (opt-used-add vars offset-var))
              (opt-induction-gep-offset-vars-instr-seq-from
                loop-defs
                instrs
                (+ index 1)
                vars))]
          [_
            (opt-induction-gep-offset-vars-instr-seq-from
              loop-defs
              instrs
              (+ index 1)
              vars)])]
      [_
        (opt-induction-gep-offset-vars-instr-seq-from
          loop-defs
          instrs
          (+ index 1)
          vars)])))

(define (opt-induction-gep-offset-vars-blocks-from
  [loop-defs : opt_i64_i64_map.Map]
  [body-blocks : ir.CompilerIrBlockList]
  [vars : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) vars]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-induction-gep-offset-vars-blocks-from
            loop-defs
            (__tl-box-place rest)
            (opt-induction-gep-offset-vars-instr-seq-from
              loop-defs
              instrs
              0
              vars))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-gep-offset-vars-blocks-from
        loop-defs
        (ir.compiler-ir-block-seq-to-list seq)
        vars)]))

(define (opt-induction-gep-offset-vars-blocks
  [loop-defs : opt_i64_i64_map.Map]
  [body-blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (opt-induction-gep-offset-vars-blocks-from
    loop-defs
    body-blocks
    (opt_i64_i64_map.with-capacity 17)))

;; The scaled-offset env: vars defined as `mul phi, scale` that actually feed
;; a gep offset. Such muls are covered by the GepScaled derived (the address
;; itself becomes the induction value), so the plain Mul derived skips them.
(define (opt-induction-scaled-env-instr-seq-from
  [phi-var : i64]
  [step : i64]
  [feeders : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [env : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    env
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
        (match op
          [(ir.CompilerIrBinOp.Mul)
            (if (and
              (opt-induction-i64-type? ty)
              (opt-used-contains feeders dst))
              (match (opt-induction-mul-scale-of lhs rhs phi-var)
                [(option_i64.Some scale)
                  (if (opt-induction-scale-ok? step scale)
                    (let
                      [out : opt_i64_i64_map.Map env]
                      (begin
                        (opt_i64_i64_map.insert-ref! (&mut out) dst scale)
                        (opt-induction-scaled-env-instr-seq-from
                          phi-var
                          step
                          feeders
                          instrs
                          (+ index 1)
                          out)))
                    (opt-induction-scaled-env-instr-seq-from
                      phi-var
                      step
                      feeders
                      instrs
                      (+ index 1)
                      env))]
                [(option_i64.None)
                  (opt-induction-scaled-env-instr-seq-from
                    phi-var
                    step
                    feeders
                    instrs
                    (+ index 1)
                    env)])
              (opt-induction-scaled-env-instr-seq-from
                phi-var
                step
                feeders
                instrs
                (+ index 1)
                env))]
          [_
            (opt-induction-scaled-env-instr-seq-from
              phi-var
              step
              feeders
              instrs
              (+ index 1)
              env)])]
      [_
        (opt-induction-scaled-env-instr-seq-from
          phi-var
          step
          feeders
          instrs
          (+ index 1)
          env)])))

(define (opt-induction-scaled-env-list-from
  [phi-var : i64]
  [step : i64]
  [feeders : opt_i64_i64_map.Map]
  [body-blocks : ir.CompilerIrBlockList]
  [env : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) env]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-induction-scaled-env-list-from
            phi-var
            step
            feeders
            (__tl-box-place rest)
            (opt-induction-scaled-env-instr-seq-from
              phi-var
              step
              feeders
              instrs
              0
              env))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-scaled-env-list-from
        phi-var
        step
        feeders
        (ir.compiler-ir-block-seq-to-list seq)
        env)]))

(define (opt-induction-scaled-env-blocks
  [fact : OptInductionFact]
  [loop-defs : opt_i64_i64_map.Map]
  [body-blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match fact
    [(OptInductionFact.Fact phi-var _ _ step _)
      (let
        [feeders : opt_i64_i64_map.Map
          (opt-induction-gep-offset-vars-blocks loop-defs body-blocks)]
        (match body-blocks
          [(ir.CompilerIrBlockList.Nil) (opt_i64_i64_map.with-capacity 17)]
          [(ir.CompilerIrBlockList.Cons _ _)
            (opt-induction-scaled-env-list-from
              phi-var
              step
              feeders
              body-blocks
              (opt_i64_i64_map.with-capacity 17))]
          [(ir.CompilerIrBlockList.Array seq)
            (opt-induction-scaled-env-list-from
              phi-var
              step
              feeders
              (ir.compiler-ir-block-seq-to-list seq)
              (opt_i64_i64_map.with-capacity 17))]))]))

;; A stride the x86 addressing mode folds (1/2/4/8) makes the address free at
;; each use; a pointer IV there only adds a latch add and a loop-live range.
;; Fire the address deriveds only when the per-iteration byte stride does not
;; fold (16-byte enum elements, 24-byte entries, ...).
(define (opt-induction-gep-stride-pays?
  [type-segment-bases : i64]
  [scale : i64]
  [ty : ast.AstType]) : bool
  (let
    [stride : i64 (* scale (opt-load-loc-type-size type-segment-bases ty))]
    (and (> stride 2) (not (= stride 4)) (not (= stride 8)))))

(define (opt-induction-find-derived-instr
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : OptMaybeInductionDerived
  (match fact
    [(OptInductionFact.Fact phi-var _ _ step _)
      (match instr
        [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
          (match op
            [(ir.CompilerIrBinOp.Mul)
              (if (and
                (opt-induction-i64-type? ty)
                (not (opt-used-contains scaled dst)))
                (opt-induction-mul-derived offsets lhs rhs phi-var step ty)
                (OptMaybeInductionDerived.No))]
            [_ (OptMaybeInductionDerived.No)])]
        [(ir.CompilerIrInstr.Gep _ base offset ty)
          (match (opt-induction-value-offset offsets offset phi-var)
            [(option_i64.Some derived-offset)
              (if (and
                (opt-induction-gep-stride-pays? type-segment-bases 1 ty)
                (opt-induction-value-base-invariant? loop-defs base))
                (OptMaybeInductionDerived.Some
                  (OptInductionDerived.Gep base derived-offset ty))
                (OptMaybeInductionDerived.No))]
            [(option_i64.None)
              (match offset
                [(ir.CompilerIrValue.Var offset-var)
                  (match (opt_i64_i64_map.get (& scaled) offset-var)
                    [(opt_i64_i64_map.LookupFound scale)
                      (if (and
                        (opt-induction-gep-stride-pays?
                          type-segment-bases
                          scale
                          ty)
                        (opt-induction-value-base-invariant? loop-defs base))
                        (OptMaybeInductionDerived.Some
                          (OptInductionDerived.GepScaled base scale ty))
                        (OptMaybeInductionDerived.No))]
                    [(opt_i64_i64_map.LookupMissing)
                      (OptMaybeInductionDerived.No)])]
                [_ (OptMaybeInductionDerived.No)])])]
        [_ (OptMaybeInductionDerived.No)])]))

(define (opt-induction-derived-eq?
  [type-segment-bases : i64]
  [left : OptInductionDerived]
  [right : OptInductionDerived]) : bool
  (match left
    [(OptInductionDerived.Mul left-scale left-offset left-ty)
      (match right
        [(OptInductionDerived.Mul right-scale right-offset right-ty)
          (and
            (= left-scale right-scale)
            (= left-offset right-offset)
            (opt-type-eq type-segment-bases left-ty right-ty))]
        [_ false])]
    [(OptInductionDerived.Gep left-base left-offset left-ty)
      (match right
        [(OptInductionDerived.Gep right-base right-offset right-ty)
          (and
            (opt-value-eq left-base right-base)
            (= left-offset right-offset)
            (opt-type-eq type-segment-bases left-ty right-ty))]
        [_ false])]
    [(OptInductionDerived.GepScaled left-base left-scale left-ty)
      (match right
        [(OptInductionDerived.GepScaled right-base right-scale right-ty)
          (and
            (opt-value-eq left-base right-base)
            (= left-scale right-scale)
            (opt-type-eq type-segment-bases left-ty right-ty))]
        [_ false])]))

(define (opt-induction-derived-list-contains?
  [type-segment-bases : i64]
  [deriveds : OptInductionDerivedList]
  [derived : OptInductionDerived]) : bool
  (match deriveds
    [(OptInductionDerivedList.Nil) false]
    [(OptInductionDerivedList.Cons head rest)
      (if (opt-induction-derived-eq? type-segment-bases head derived)
        true
        (opt-induction-derived-list-contains?
          type-segment-bases
          (__tl-box-place rest)
          derived))]))

(define (opt-induction-derived-list-append
  [deriveds : OptInductionDerivedList]
  [derived : OptInductionDerived]) : OptInductionDerivedList
  (match deriveds
    [(OptInductionDerivedList.Nil)
      (OptInductionDerivedList.Cons derived (box (OptInductionDerivedList.Nil)))]
    [(OptInductionDerivedList.Cons head rest)
      (OptInductionDerivedList.Cons
        head
        (box (opt-induction-derived-list-append (__tl-box-place rest) derived)))]))

(define (opt-induction-derived-list-append-unique
  [type-segment-bases : i64]
  [deriveds : OptInductionDerivedList]
  [derived : OptInductionDerived]) : OptInductionDerivedList
  (if (opt-induction-derived-list-contains? type-segment-bases deriveds derived)
    deriveds
    (opt-induction-derived-list-append deriveds derived)))

(define (opt-induction-derived-list-count [deriveds : OptInductionDerivedList]) : i64
  (match deriveds
    [(OptInductionDerivedList.Nil) 0]
    [(OptInductionDerivedList.Cons _ rest)
      (+ 1 (opt-induction-derived-list-count (__tl-box-place rest)))]))

(define (opt-induction-derived-list-slot-count
  [deriveds : OptInductionDerivedList]) : i64
  (match deriveds
    [(OptInductionDerivedList.Nil) 0]
    [(OptInductionDerivedList.Cons derived rest)
      (+
        (opt-induction-derived-slot-count derived)
        (opt-induction-derived-list-slot-count (__tl-box-place rest)))]))

(define (opt-induction-collect-derived-instr-seq-from
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [deriveds : OptInductionDerivedList]) : OptInductionDerivedList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    deriveds
    (match (opt-induction-find-derived-instr
      type-segment-bases
      fact
      offsets
      scaled
      loop-defs
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInductionDerived.Some derived)
        (opt-induction-collect-derived-instr-seq-from
          type-segment-bases
          fact
          offsets
          scaled
          loop-defs
          instrs
          (+ index 1)
          (opt-induction-derived-list-append-unique
            type-segment-bases
            deriveds
            derived))]
      [(OptMaybeInductionDerived.No)
        (opt-induction-collect-derived-instr-seq-from
          type-segment-bases
          fact
          offsets
          scaled
          loop-defs
          instrs
          (+ index 1)
          deriveds)])))

(define (opt-induction-collect-derived-instr-seq
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [deriveds : OptInductionDerivedList]) : OptInductionDerivedList
  (opt-induction-collect-derived-instr-seq-from
    type-segment-bases
    fact
    offsets
    scaled
    loop-defs
    instrs
    0
    deriveds))

(define (opt-induction-remat-address-dst
  [instr : ir.CompilerIrInstr]
  [mul-dst : i64]) : option_i64.Option
  (match instr
    [(ir.CompilerIrInstr.BinOp dst (ir.CompilerIrBinOp.Add) lhs rhs _)
      (if (or (opt-value-is-var? lhs mul-dst) (opt-value-is-var? rhs mul-dst))
        (option_i64.Some dst)
        (option_i64.None))]
    [(ir.CompilerIrInstr.Gep dst _ offset _)
      (if (opt-value-is-var? offset mul-dst)
        (option_i64.Some dst)
        (option_i64.None))]
    [_ (option_i64.None)]))

(define (opt-induction-remat-arm-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 3) (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp mul-dst (ir.CompilerIrBinOp.Mul) _ _ _)
        (match (opt-induction-remat-address-dst
          (ir.compiler-ir-instr-seq-ref instrs (+ index 1))
          mul-dst)
          [(option_i64.Some address-dst)
            (match (ir.compiler-ir-instr-seq-ref instrs (+ index 2))
              [(ir.CompilerIrInstr.Gep gep-dst base _ _)
                (and
                  (opt-value-is-var? base address-dst)
                  (match (ir.compiler-ir-instr-seq-ref instrs (+ index 3))
                    [(ir.CompilerIrInstr.Load _ src _)
                      (opt-value-is-var? src gep-dst)]
                    [_ false]))]
              [_ false])]
          [(option_i64.None) false])]
      [_ (opt-induction-remat-arm-seq? instrs (+ index 1))])))

(define (opt-induction-switch-predecessor?
  [blocks : ir.CompilerIrBlockList]
  [target : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (and
              (> count 0)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Switch _ _ _ _) true]
                [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
                [_ false])
              (opt-label-contains
                (opt-cfg-instr-successors
                  (OptLabelSet.Nil)
                  (ir.compiler-ir-instr-seq-ref instrs (- count 1)))
                target))
              true
              (opt-induction-switch-predecessor? (__tl-box-place rest) target)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-switch-predecessor?
        (ir.compiler-ir-block-seq-to-list seq)
        target)]))

(define (opt-induction-switch-arm?
  [_index : OptCfgIndex]
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [arm-instrs : ir.CompilerIrInstrSeq]) : bool
  (and
    (opt-induction-remat-arm-seq? arm-instrs 0)
    (opt-induction-switch-predecessor? blocks label)))

(define (opt-induction-collect-derived-blocks
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [loop-defs : opt_i64_i64_map.Map]
  [all-body-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [deriveds : OptInductionDerivedList]) : OptInductionDerivedList
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) deriveds]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-induction-collect-derived-blocks
            type-segment-bases
            index
            fact
            offsets
            scaled
            loop-defs
            all-body-blocks
            (__tl-box-place rest)
            (if (opt-induction-switch-arm? index all-body-blocks label instrs)
              deriveds
              (opt-induction-collect-derived-instr-seq
                type-segment-bases
                fact
                offsets
                scaled
                loop-defs
                instrs
                deriveds)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-collect-derived-blocks
        type-segment-bases
        index
        fact
        offsets
        scaled
        loop-defs
        all-body-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        deriveds)]))

(define (opt-induction-derived-matches?
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [instr : ir.CompilerIrInstr]) : bool
  (match fact
    [(OptInductionFact.Fact phi-var _ _ step _)
      (match derived
        [(OptInductionDerived.Mul scale offset ty)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs instr-ty)
              (match op
                [(ir.CompilerIrBinOp.Mul)
                  (and
                    (opt-type-eq type-segment-bases instr-ty ty)
                    (match (opt-induction-mul-derived
                      offsets
                      lhs
                      rhs
                      phi-var
                      step
                      ty)
                      [(OptMaybeInductionDerived.Some found)
                        (opt-induction-derived-eq?
                          type-segment-bases
                          found
                          derived)]
                      [(OptMaybeInductionDerived.No) false]))]
                [_ false])]
            [_ false])]
        [(OptInductionDerived.Gep base derived-offset ty)
          (match instr
            [(ir.CompilerIrInstr.Gep _ instr-base instr-offset instr-ty)
              (and
                (opt-type-eq type-segment-bases instr-ty ty)
                (opt-value-eq instr-base base)
                (match (opt-induction-value-offset offsets instr-offset phi-var)
                  [(option_i64.Some found-offset)
                    (= found-offset derived-offset)]
                  [(option_i64.None) false]))]
            [_ false])]
        [(OptInductionDerived.GepScaled base scale ty)
          (match instr
            [(ir.CompilerIrInstr.Gep _ instr-base instr-offset instr-ty)
              (and
                (opt-type-eq type-segment-bases instr-ty ty)
                (opt-value-eq instr-base base)
                (match instr-offset
                  [(ir.CompilerIrValue.Var offset-var)
                    (match (opt_i64_i64_map.get (& scaled) offset-var)
                      [(opt_i64_i64_map.LookupFound found-scale)
                        (= found-scale scale)]
                      [(opt_i64_i64_map.LookupMissing) false])]
                  [_ false]))]
            [_ false])])]))

;; The rewrite mov must carry the PHI's type: for address deriveds that is
;; the word type, never the element type -- a `mov %ptr : u8` lets the
;; backend truncate the 64-bit pointer (spill/reload sizing), which used to
;; crash byte-buffer loops as soon as the mov-chase let the pass fire there.
(define (opt-induction-rewrite-instr
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (if (opt-induction-derived-matches?
    type-segment-bases
    fact
    offsets
    scaled
    derived
    instr)
    (match (opt-instr-def-var instr)
      [(option_i64.Some dst)
        (ir.CompilerIrInstr.Mov
          dst
          (ir.CompilerIrValue.Var derived-phi)
          (opt-induction-derived-phi-type derived))]
      [(option_i64.None) instr])
    instr))

(define (opt-induction-rewrite-instr-seq
  [type-segment-bases : i64]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-induction-rewrite-instr
              type-segment-bases
              fact
              offsets
              scaled
              derived
              derived-phi
              (ir.compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-induction-rewrite-blocks
  [type-segment-bases : i64]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [all-blocks : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (and
              (opt-loop-body-label-member? body index label)
              (not (opt-induction-switch-arm? index all-blocks label instrs)))
              (ir.CompilerIrBlock.Block
                label
                (opt-induction-rewrite-instr-seq
                  type-segment-bases
                  fact
                  offsets
                  scaled
                  derived
                  derived-phi
                  instrs))
              block)
            (opt-induction-rewrite-blocks
              type-segment-bases
              body
              index
              fact
              offsets
              scaled
              derived
              derived-phi
              all-blocks
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-rewrite-blocks
        type-segment-bases
        body
        index
        fact
        offsets
        scaled
        derived
        derived-phi
        all-blocks
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-rewrite-derived-list-blocks
  [type-segment-bases : i64]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [fact : OptInductionFact]
  [offsets : opt_i64_i64_map.Map]
  [scaled : opt_i64_i64_map.Map]
  [deriveds : OptInductionDerivedList]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match deriveds
    [(OptInductionDerivedList.Nil) blocks]
    [(OptInductionDerivedList.Cons derived rest)
      (opt-induction-rewrite-derived-list-blocks
        type-segment-bases
        body
        index
        fact
        offsets
        scaled
        (__tl-box-place rest)
        (+ frame (opt-induction-derived-slot-count derived))
        (opt-induction-rewrite-blocks
          type-segment-bases
          body
          index
          fact
          offsets
          scaled
          derived
          (opt-induction-derived-phi-var derived frame)
          blocks
          blocks))]))

;; GepScaled has no affine offset; it reports a nonzero value so it takes the
;; 4-slot layout (mul tmp, seed, phi, next) its two-instruction seed needs.
(define (opt-induction-derived-offset [derived : OptInductionDerived]) : i64
  (match derived
    [(OptInductionDerived.Mul _ offset _) offset]
    [(OptInductionDerived.Gep _ offset _) offset]
    [(OptInductionDerived.GepScaled _ _ _) 1]))

(define (opt-induction-derived-slot-count [derived : OptInductionDerived]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    3
    4))

(define (opt-induction-derived-seed-var
  [derived : OptInductionDerived]
  [frame : i64]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    frame
    (+ frame 1)))

(define (opt-induction-derived-phi-var
  [derived : OptInductionDerived]
  [frame : i64]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    (+ frame 1)
    (+ frame 2)))

(define (opt-induction-derived-next-var
  [derived : OptInductionDerived]
  [frame : i64]) : i64
  (if (= (opt-induction-derived-offset derived) 0)
    (+ frame 2)
    (+ frame 3)))

(define (opt-induction-offset-seed-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [offset-var : i64]) : ir.CompilerIrInstr
  (match fact
    [(OptInductionFact.Fact _ start _ _ ty)
      (match derived
        [(OptInductionDerived.GepScaled _ scale _)
          ;; The scaled seed's element offset is start*scale, not start+offset.
          (ir.CompilerIrInstr.BinOp
            offset-var
            (ir.CompilerIrBinOp.Mul)
            start
            (ir.CompilerIrValue.I64 scale)
            ty)]
        [_
          (ir.CompilerIrInstr.BinOp
            offset-var
            (ir.CompilerIrBinOp.Add)
            start
            (ir.CompilerIrValue.I64 (opt-induction-derived-offset derived))
            ty)])]))

(define (opt-induction-final-seed-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [seed-var : i64]) : ir.CompilerIrInstr
  (match derived
    [(OptInductionDerived.Mul scale offset ty)
      (ir.CompilerIrInstr.BinOp
        seed-var
        (ir.CompilerIrBinOp.Mul)
        (if (= offset 0)
          (opt-induction-fact-start fact)
          (ir.CompilerIrValue.Var (- seed-var 1)))
        (ir.CompilerIrValue.I64 scale)
        ty)]
    [(OptInductionDerived.Gep base offset ty)
      (ir.CompilerIrInstr.Gep
        seed-var
        base
        (if (= offset 0)
          (opt-induction-fact-start fact)
          (ir.CompilerIrValue.Var (- seed-var 1)))
        ty)]
    [(OptInductionDerived.GepScaled base _ ty)
      (ir.CompilerIrInstr.Gep
        seed-var
        base
        (ir.CompilerIrValue.Var (- seed-var 1))
        ty)]))

(define (opt-induction-next-instr
  [fact : OptInductionFact]
  [derived : OptInductionDerived]
  [derived-phi : i64]
  [next-var : i64]) : ir.CompilerIrInstr
  (match derived
    [(OptInductionDerived.Mul scale _ ty)
      (ir.CompilerIrInstr.BinOp
        next-var
        (ir.CompilerIrBinOp.Add)
        (ir.CompilerIrValue.Var derived-phi)
        (ir.CompilerIrValue.I64 (* (opt-induction-fact-step fact) scale))
        ty)]
    [(OptInductionDerived.Gep _ _ ty)
      (ir.CompilerIrInstr.Gep
        next-var
        (ir.CompilerIrValue.Var derived-phi)
        (ir.CompilerIrValue.I64 (opt-induction-fact-step fact))
        ty)]
    [(OptInductionDerived.GepScaled _ scale ty)
      (ir.CompilerIrInstr.Gep
        next-var
        (ir.CompilerIrValue.Var derived-phi)
        (ir.CompilerIrValue.I64 (* (opt-induction-fact-step fact) scale))
        ty)]))

;; A Gep-derived induction value is an ADDRESS: its phi must be word-typed.
;; The backend sizes spilled phi copies by the PHI's type, so an
;; element-typed pointer phi over a sub-word array (a byte buffer's moving
;; pointer) would reload only the low element-width bits of the pointer on
;; the back edge. Mul-derived values keep their (i64-gated) scalar type.
(define (opt-induction-derived-phi-type [derived : OptInductionDerived]) : ast.AstType
  (match derived
    [(OptInductionDerived.Mul _ _ ty) ty]
    [(OptInductionDerived.Gep _ _ _) (ast.AstType.I64)]
    [(OptInductionDerived.GepScaled _ _ _) (ast.AstType.I64)]))

(define (opt-induction-phi-instr
  [derived : OptInductionDerived]
  [preheader : i64]
  [latch : i64]
  [seed-var : i64]
  [derived-phi : i64]
  [next-var : i64]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Phi
    derived-phi
    (ir.compiler-ir-phi-input-cons
      (ir.CompilerIrValue.Var seed-var)
      preheader
      (ir.compiler-ir-phi-input-cons
        (ir.CompilerIrValue.Var next-var)
        latch
        (ir.CompilerIrPhiInputList.Nil)))
    (opt-induction-derived-phi-type derived)))

(defstruct OptInductionSupportInstrs
  (seed-instrs ir.CompilerIrInstrSeq)
  (phi-instrs ir.CompilerIrInstrSeq)
  (next-instrs ir.CompilerIrInstrSeq))

;; Build the three support streams in one derived-value walk. The former shape
;; built and appended three cons chains, then immediately counted and copied
;; them into the destination block builders. refs #5726
(define (opt-induction-push-support-instrs!
  [fact : OptInductionFact]
  [deriveds : OptInductionDerivedList]
  [preheader : i64]
  [latch : i64]
  [frame : i64]
  [seed-builder : (&mut seed-builder ir.CompilerIrInstrBuilder)]
  [phi-builder : (&mut phi-builder ir.CompilerIrInstrBuilder)]
  [next-builder : (&mut next-builder ir.CompilerIrInstrBuilder)]) : unit
  (match deriveds
    [(OptInductionDerivedList.Nil) unit]
    [(OptInductionDerivedList.Cons derived rest)
      (let
        [seed-var : i64 (opt-induction-derived-seed-var derived frame)]
        (begin
          (if (= (opt-induction-derived-offset derived) 0)
            unit
            (ir.compiler-ir-instr-builder-push!
              (&mut seed-builder)
              (opt-induction-offset-seed-instr fact derived frame)))
          (ir.compiler-ir-instr-builder-push!
            (&mut seed-builder)
            (opt-induction-final-seed-instr fact derived seed-var))
          (ir.compiler-ir-instr-builder-push!
            (&mut phi-builder)
            (opt-induction-phi-instr
              derived
              preheader
              latch
              seed-var
              (opt-induction-derived-phi-var derived frame)
              (opt-induction-derived-next-var derived frame)))
          (ir.compiler-ir-instr-builder-push!
            (&mut next-builder)
            (opt-induction-next-instr
              fact
              derived
              (opt-induction-derived-phi-var derived frame)
              (opt-induction-derived-next-var derived frame)))
          (opt-induction-push-support-instrs!
            fact
            (__tl-box-place rest)
            preheader
            latch
            (+ frame (opt-induction-derived-slot-count derived))
            (&mut seed-builder)
            (&mut phi-builder)
            (&mut next-builder))))]))

(define (opt-induction-support-instrs
  [fact : OptInductionFact]
  [deriveds : OptInductionDerivedList]
  [preheader : i64]
  [latch : i64]
  [frame : i64]
  [derived-count : i64]
  [derived-slot-count : i64]) : OptInductionSupportInstrs
  (let
    [seed-builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity
        (- derived-slot-count (* 2 derived-count)))]
    [phi-builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity derived-count)]
    [next-builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity derived-count)]
    (begin
      (opt-induction-push-support-instrs!
        fact
        deriveds
        preheader
        latch
        frame
        (&mut seed-builder)
        (&mut phi-builder)
        (&mut next-builder))
      (OptInductionSupportInstrs
        (ir.compiler-ir-instr-builder-to-seq seed-builder)
        (ir.compiler-ir-instr-builder-to-seq phi-builder)
        (ir.compiler-ir-instr-builder-to-seq next-builder)))))

(define (opt-induction-insert-support-blocks
  [header : i64]
  [preheader : i64]
  [latch : i64]
  [seed-instrs : ir.CompilerIrInstrSeq]
  [phi-instrs : ir.CompilerIrInstrSeq]
  [next-instrs : ir.CompilerIrInstrSeq]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [is-header : bool (= label header)]
            [is-preheader : bool (= label preheader)]
            [is-latch : bool (= label latch)]
            (if (not (or is-header is-preheader is-latch))
              (ir.compiler-ir-block-cons
                block
                (opt-induction-insert-support-blocks
                  header
                  preheader
                  latch
                  seed-instrs
                  phi-instrs
                  next-instrs
                  (__tl-box-place rest)))
              (let
                [original-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
                [terminator-index : i64
                  (opt-licm-first-terminator-index instrs 0 original-count)]
                [phi-count : i64
                  (if is-header
                    (ir.compiler-ir-instr-seq-count phi-instrs)
                    0)]
                [seed-count : i64
                  (if is-preheader
                    (ir.compiler-ir-instr-seq-count seed-instrs)
                    0)]
                [next-count : i64
                  (if is-latch
                    (ir.compiler-ir-instr-seq-count next-instrs)
                    0)]
                [builder : ir.CompilerIrInstrBuilder
                  (ir.compiler-ir-instr-builder-with-capacity
                    (+ original-count (+ phi-count (+ seed-count next-count))))]
                (begin
                  (if is-header
                    (ir.compiler-ir-instr-builder-append-seq-range!
                      (&mut builder)
                      phi-instrs
                      0
                      phi-count)
                    unit)
                  (ir.compiler-ir-instr-builder-append-seq-range!
                    (&mut builder)
                    instrs
                    0
                    terminator-index)
                  (if is-preheader
                    (ir.compiler-ir-instr-builder-append-seq-range!
                      (&mut builder)
                      seed-instrs
                      0
                      seed-count)
                    unit)
                  (if is-latch
                    (ir.compiler-ir-instr-builder-append-seq-range!
                      (&mut builder)
                      next-instrs
                      0
                      next-count)
                    unit)
                  (ir.compiler-ir-instr-builder-append-seq-range!
                    (&mut builder)
                    instrs
                    terminator-index
                    original-count)
                  (ir.compiler-ir-block-cons
                    (ir.CompilerIrBlock.Block
                      label
                      (ir.compiler-ir-instr-builder-to-seq builder))
                    (opt-induction-insert-support-blocks
                      header
                      preheader
                      latch
                      seed-instrs
                      phi-instrs
                      next-instrs
                      (__tl-box-place rest)))))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-induction-insert-support-blocks
        header
        preheader
        latch
        seed-instrs
        phi-instrs
        next-instrs
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-induction-apply-loop
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptInductionApplyResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.Some preheader)
      (let
        [body : OptLoopBody (opt-natural-loop-body-info loop)]
        [body-blocks : ir.CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        (if (opt-induction-loop-blocked? body-blocks)
          (OptInductionApplyResult.Result blocks frame false)
          (match (opt-induction-find-fact
            type-segment-bases
            body-blocks
            loop
            preheader)
            [(OptMaybeInductionFact.Some fact)
              (let
                [loop-defs : opt_i64_i64_map.Map
                  (opt-licm-collect-defs-blocks
                    body-blocks
                    (opt_i64_i64_map.with-capacity
                      (opt-licm-body-map-capacity body-blocks)))]
                [offsets : opt_i64_i64_map.Map
                  (opt-induction-affine-offset-env body-blocks fact)]
                [scaled : opt_i64_i64_map.Map
                  (opt-induction-scaled-env-blocks fact loop-defs body-blocks)]
                [deriveds : OptInductionDerivedList
                  (opt-induction-collect-derived-blocks
                    type-segment-bases
                    index
                    fact
                    offsets
                    scaled
                    loop-defs
                    blocks
                    body-blocks
                    (OptInductionDerivedList.Nil))]
                [derived-count : i64
                  (opt-induction-derived-list-count deriveds)]
                [derived-slot-count : i64
                  (opt-induction-derived-list-slot-count deriveds)]
                (if (= derived-count 0)
                  (OptInductionApplyResult.Result blocks frame false)
                  (let
                    [rewritten : ir.CompilerIrBlockList
                      (opt-induction-rewrite-derived-list-blocks
                        type-segment-bases
                        body
                        index
                        fact
                        offsets
                        scaled
                        deriveds
                        frame
                        blocks)]
                    [support : OptInductionSupportInstrs
                      (opt-induction-support-instrs
                        fact
                        deriveds
                        preheader
                        (opt-natural-loop-latch loop)
                        frame
                        derived-count
                        derived-slot-count)]
                    (OptInductionApplyResult.Result
                      (opt-induction-insert-support-blocks
                        (opt-natural-loop-header loop)
                        preheader
                        (opt-natural-loop-latch loop)
                        support.seed-instrs
                        support.phi-instrs
                        support.next-instrs
                        rewritten)
                      (+ frame derived-slot-count)
                      true))))]
            [(OptMaybeInductionFact.No)
              (OptInductionApplyResult.Result blocks frame false)])))]
    [(OptLoopPreheader.No) (OptInductionApplyResult.Result blocks frame false)]))

(define (opt-induction-apply-loops
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [changed : bool]) : OptInductionApplyResult
  (match loops
    [(OptNaturalLoopList.Nil)
      (OptInductionApplyResult.Result blocks frame changed)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-induction-apply-loop
        type-segment-bases
        index
        blocks
        frame
        loop)
        [(OptInductionApplyResult.Result next-blocks next-frame loop-changed)
          (opt-induction-apply-loops
            type-segment-bases
            index
            (__tl-box-place rest)
            next-blocks
            next-frame
            (or changed loop-changed))])]))

(define (opt-induction-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-induction-apply-loops
            type-segment-bases
            context.index
            (opt-cfg-natural-loops-with-context blocks context)
            blocks
            frame
            false)
            [(OptInductionApplyResult.Result next-blocks next-frame changed)
              (if changed
                (let
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  ;; Induction cleanup can rewrite latch/exit edges, so build one
                  ;; fresh context for the rewritten CFG, reuse it for the
                  ;; post-pass verify, and hand it back for the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)]))
                (OptFunctionCtxResult.Result func context))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-induction-function-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-induction-function-with-context-result
    type-segment-bases
    context
    false
    func)
    [(OptFunctionCtxResult.Result next _) next]))

(define (opt-induction-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-induction-function-with-context
        type-segment-bases
        (opt-cfg-context-build blocks)
        func)]))

;; --- dead phi elimination (dead_phi) -----------------------------------------
;;
;; The pipeline's DCE is use-count driven: an instruction dies once nothing names
;; its result. That retires dead CHAINS and never a dead CYCLE, and SSA
;; construction hands the optimizer one dead cycle per mutable local whose last
;; assignment sits in a conditional arm inside a loop -- the arm's value reaches
;; the `if` merge's phi, the merge phi reaches the enclosing loop header's phi,
;; and the header phi feeds the merge phi back round the latch. Nothing else
;; reads either, yet each holds the other's use count at one forever.
;;
;; Those pairs generate no code and still cost real optimization. A phi input is
;; a use sited at the block that carries the edge, so a cycle that captures a
;; value defined in an INNER loop pins that value as read outside it, and both
;; loop passes below refuse exactly that: `bce_version`'s escape test
;; (`opt-bce-mb-defs-escape?`) and `flag_exit`'s C8. A guarded compare loop under
;; an `if` -- `benchmarks/intern_table`'s probe, and the position every inlined
;; callee loop lands in -- therefore loses bounds-check versioning to a phi pair
;; that lowers to nothing at all.
;;
;; The sweep is the half of DCE that use counts cannot express: a var is live
;; when a NON-phi instruction names it, a phi's inputs become live only once the
;; phi's own result is, and the marking runs to a fixpoint. Phis left unmarked
;; are dropped -- exactly the phi-only sub-graphs, cycles included. Nothing else
;; is touched: with their phi readers gone the values those cycles carried are
;; ordinary dead chains, which the pipeline DCE already retires.
;;
;; Removing phis leaves labels and edges alone, so the incoming OptCfgContext
;; stays valid and is handed straight back.
(define (opt-dead-phi-round-max) : i64
  12)

(define (opt-dead-phi-instr-phi? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Phi _ _ _) true]
    [_ false]))

;; --- prescan ------------------------------------------------------------------
(define (opt-dead-phi-instrs-have-phi?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-dead-phi-instr-phi? (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-dead-phi-instrs-have-phi? instrs (+ index 1)))))

(define (opt-dead-phi-seq-have-phi?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (if (match (ir.compiler-ir-block-seq-ref blocks index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (opt-dead-phi-instrs-have-phi? instrs 0)])
      true
      (opt-dead-phi-seq-have-phi? blocks (+ index 1)))))

(define (opt-dead-phi-blocks-have-phi? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-instrs-have-phi? instrs 0)])
        true
        (opt-dead-phi-blocks-have-phi? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq) (opt-dead-phi-seq-have-phi? seq 0)]))

;; --- seed: every operand a non-phi instruction names ---------------------------
(define (opt-dead-phi-mark-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [live : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (begin
        (if (opt-dead-phi-instr-phi? instr)
          unit
          (opt-collect-instr-uses-array live instr))
        (opt-dead-phi-mark-instrs! instrs (+ index 1) live)))))

(define (opt-dead-phi-mark-seq!
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]
  [live : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    unit
    (begin
      (match (ir.compiler-ir-block-seq-ref blocks index)
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-mark-instrs! instrs 0 live)])
      (opt-dead-phi-mark-seq! blocks (+ index 1) live))))

(define (opt-dead-phi-mark-blocks!
  [blocks : ir.CompilerIrBlockList]
  [live : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-dead-phi-mark-instrs! instrs 0 live)])
        (opt-dead-phi-mark-blocks! (__tl-box-place rest) live))]
    [(ir.CompilerIrBlockList.Array seq) (opt-dead-phi-mark-seq! seq 0 live)]))

;; --- propagate: a live phi makes its own inputs live --------------------------
(define (opt-dead-phi-expand-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [live : (__tl_dyn-array i64)]
  [done : (__tl_dyn-array i64)]
  [changed : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Phi dst inputs _)
          (if (and
            (>= dst 0)
            (< dst (array-length live))
            (> (array-ref live dst) 0)
            (= (array-ref done dst) 0))
            (begin
              (set! (array-ref done dst) 1)
              (opt-collect-phi-uses-array live inputs)
              (set! (array-ref changed 0) 1))
            unit)]
        [_ unit])
      (opt-dead-phi-expand-instrs! instrs (+ index 1) live done changed))))

(define (opt-dead-phi-expand-seq!
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]
  [live : (__tl_dyn-array i64)]
  [done : (__tl_dyn-array i64)]
  [changed : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    unit
    (begin
      (match (ir.compiler-ir-block-seq-ref blocks index)
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-expand-instrs! instrs 0 live done changed)])
      (opt-dead-phi-expand-seq! blocks (+ index 1) live done changed))))

(define (opt-dead-phi-expand-blocks!
  [blocks : ir.CompilerIrBlockList]
  [live : (__tl_dyn-array i64)]
  [done : (__tl_dyn-array i64)]
  [changed : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-dead-phi-expand-instrs! instrs 0 live done changed)])
        (opt-dead-phi-expand-blocks! (__tl-box-place rest) live done changed))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-dead-phi-expand-seq! seq 0 live done changed)]))

;; One sweep per round, and a round only repeats when it marked a phi that had
;; not been expanded before. `true` means the marking settled; a function whose
;; phi web is deeper than the round cap keeps every phi it has, because a
;; half-propagated marking would call a live phi dead.
(define (opt-dead-phi-expand-rounds!
  [blocks : ir.CompilerIrBlockList]
  [live : (__tl_dyn-array i64)]
  [done : (__tl_dyn-array i64)]
  [remaining : i64]) : bool
  (if (<= remaining 0)
    false
    (let
      [changed : (__tl_dyn-array i64) (array.make-array i64 1)]
      [_run : unit (opt-dead-phi-expand-blocks! blocks live done changed)]
      (if (= (array-ref changed 0) 1)
        (opt-dead-phi-expand-rounds! blocks live done (- remaining 1))
        true))))

;; --- sweep --------------------------------------------------------------------
(define (opt-dead-phi-instr-dead?
  [instr : ir.CompilerIrInstr]
  [live : (__tl_dyn-array i64)]) : bool
  (match instr
    [(ir.CompilerIrInstr.Phi dst _ _)
      (and (>= dst 0) (< dst (array-length live)) (= (array-ref live dst) 0))]
    [_ false]))

(define (opt-dead-phi-instrs-any-dead?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [live : (__tl_dyn-array i64)]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-dead-phi-instr-dead?
      (ir.compiler-ir-instr-seq-ref instrs index)
      live)
      true
      (opt-dead-phi-instrs-any-dead? instrs (+ index 1) live))))

(define (opt-dead-phi-seq-any-dead?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]
  [live : (__tl_dyn-array i64)]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (if (match (ir.compiler-ir-block-seq-ref blocks index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (opt-dead-phi-instrs-any-dead? instrs 0 live)])
      true
      (opt-dead-phi-seq-any-dead? blocks (+ index 1) live))))

(define (opt-dead-phi-any-dead?
  [blocks : ir.CompilerIrBlockList]
  [live : (__tl_dyn-array i64)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-instrs-any-dead? instrs 0 live)])
        true
        (opt-dead-phi-any-dead? (__tl-box-place rest) live))]
    [(ir.CompilerIrBlockList.Array seq) (opt-dead-phi-seq-any-dead? seq 0 live)]))

(define (opt-dead-phi-keep-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [live : (__tl_dyn-array i64)]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs read)]
          (begin
            (when
              (not (opt-dead-phi-instr-dead? instr live))
              (begin
                (set! (array-ref slots write) instr)
                (set! write (+ write 1))))
            (set! read (+ read 1)))))
      (ir.CompilerIrInstrSeq slots write))))

(define (opt-dead-phi-rewrite-block-seq
  [blocks : ir.CompilerIrBlockSeq]
  [live : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [slots : (__tl_dyn-array ir.CompilerIrBlock)
      (array.make-array ir.CompilerIrBlock count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (match (ir.compiler-ir-block-seq-ref blocks index)
              [(ir.CompilerIrBlock.Block label instrs)
                (ir.CompilerIrBlock.Block
                  label
                  (opt-dead-phi-keep-instrs instrs live))]))
          (set! index (+ index 1))))
      (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count)))))

(define (opt-dead-phi-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [live : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (ir.CompilerIrBlock.Block
              label
              (opt-dead-phi-keep-instrs instrs live))])
        (opt-dead-phi-rewrite-blocks (__tl-box-place rest) live))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-dead-phi-rewrite-block-seq seq live)]))

;; --- driver -------------------------------------------------------------------
;;
;; Placed after scratch-reset and before the loop cluster: the cycles this
;; retires are lowering artifacts that every round rebuilds nothing of, and the
;; loop passes must see their loop-defined inputs without dead outside readers.
;; DCE at the tail of the same round retires chains the removed phis were the
;; last readers of.
(define (opt-dead-phi-blocks [blocks : ir.CompilerIrBlockList] [frame : i64]) : ir.CompilerIrBlockList
  (if (not (opt-dead-phi-blocks-have-phi? blocks))
    blocks
    (let
      [live : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [done : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [_mark : unit (opt-dead-phi-mark-blocks! blocks live)]
      [settled? : bool
        (opt-dead-phi-expand-rounds! blocks live done (opt-dead-phi-round-max))]
      (if (or (not settled?) (not (opt-dead-phi-any-dead? blocks live)))
        blocks
        (opt-dead-phi-rewrite-blocks blocks live)))))

;; Standalone driver for tests and ad-hoc runs.
(define (opt-dead-phi-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (ir.CompilerIrFunction.Function
        name
        params
        ret-ty
        frame
        (opt-dead-phi-blocks blocks frame))]))

;; --- monotone-flag loop-exit conversion (flag_exit) ---------------------------
;;
;; `(while (and (< i n) ok) ... (set! ok false) ...)` carries `ok` around the
;; back edge and re-tests it at the top of every iteration, so the loop pays a
;; `test`/`jcc` per iteration for a flag that is only ever CLEARED. C compiles
;; the same source to a direct branch out of the loop at the mismatch site --
;; `benchmarks/intern_table`'s `it-slice-eq?` byte compare spends two of its ten
;; instructions per byte on the re-test and its C twin spends none.
;;
;; The flag is monotone: it starts at a constant K in the preheader and the only
;; value the body can give it is the opposite constant C, which makes the gate
;; branch leave the loop. Redirecting each clear edge straight to the gate's
;; exit arm therefore preserves meaning and makes the header's flag test
;; vacuous: nothing can leave the flag at C while continuing, so the gate always
;; continues and becomes an unconditional jump. The flag phis then have no
;; readers left and the pipeline's SCCP/DCE retire them.
;;
;; Exit phis and the phi-web budget. An earlier phi-block-collapse experiment on
;; this tree regressed 10% by duplicating phi copies, so any rewrite near a loop
;; exit has to pay for its edges. This one adds none. The clear edges adopt the
;; gate's own exit arm rather than the shared exit block, so no block gains a
;; predecessor it did not already have from the gate: the exit block's
;; predecessor count is IDENTICAL before and after (4 -> 4 on `it-slice-eq?`)
;; and only the values on those edges change. And every changed value becomes a
;; literal -- an exit phi input reached through the gate arm becomes C, one
;; reached through any other edge out of the loop becomes K. Since
;; `compiler-reg-phi-touched-add-inputs!` (src/compiler_regalloc.tl) marks only
;; `Value.Var` inputs, replacing Var inputs with literals strictly shrinks the
;; phi-touched set and the live-out-input exclusion riding on it, so phi-web
;; coalescing can only improve.
;;
;; Placed between `induction` and `bce_version`. Conversion only shrinks what
;; the versioner has to fit: the clearing arm leaves the loop, so a converted
;; body loses a block and everything in it (seven labels to six on
;; `it-slice-eq?`, and the dropped instructions come straight off the
;; versioner's `opt-bce-mb-instr-max` growth budget), and the top-tested
;; shape the versioner
;; matches survives untouched -- the header still ends `Branch c, body, exit`
;; with the body target inside the loop. In practice a lowered `while` spends
;; pipeline iteration 1 with its flag still live at a non-phi reader (C4), so
;; versioning usually happens first and this pass converts both clones on
;; iteration 2; the ordering is what keeps the two cases from fighting.
;;
;; Conditions, all required:
;;   C1 monotone seed: a header phi `f = phi [K, preheader], [v, latch]` with
;;      exactly one input from outside the loop carrying a bool literal K and
;;      exactly one from inside it carrying `v`. C is the opposite literal.
;;   C2 monotone closure: descending from `v` through phis and Movs defined in
;;      the loop, every leaf is `f` itself or the literal C, and at least one is
;;      C. A leaf of K would re-establish the continuing value and is rejected;
;;      so is a Mov of C, whose clear happens mid-block with no edge to redirect.
;;   C3 gate: some block G in the loop ends `Branch g, T, X` with g in the
;;      closure, T inside the loop, X outside it, and C selecting X.
;;   C4 uses: the flag and every closure var are read only by the closure, by
;;      the gate branch, and by phis outside the loop keyed on one of the loop's
;;      exit blocks. Anything else could observe the value this rewrite retires,
;;      and a phi keyed on a NON-exit block has no reachable exit to fold to.
;;   C5 dominance: G dominates the latch, so every path from a clear edge to the
;;      back edge passes the gate and none can slip round again. G must also
;;      dominate every clear predecessor, so everything the gate's exit arm can
;;      read is equally available on the redirected edge.
;;   C6 transparency: every block on a path from a clear-edge target to G
;;      carries only pure instructions, and G itself holds nothing but phis and
;;      its branch. Those are what the redirect skips.
;;   C7 exit shape: X's only predecessor is G and X has no phis, so the clear
;;      edges can adopt it without adding a predecessor anywhere; every phi
;;      outside the loop that reads a closure var on one edge out of the loop
;;      reads one on all of them; and where a cleared path could ALSO have left
;;      the loop by a different exit -- the last iteration reaching the counter
;;      test with the flag already down -- that alternate exit and X must both be
;;      jump-only into one common merge block whose phis agree across them,
;;      since otherwise swapping which exit a cleared path takes is observable.
;;   C8 escapes: no value defined in the loop may be read outside it except the
;;      closure vars, because the redirect skips the rest of the cleared
;;      iteration. `rotate_ssa` has already collapsed exit phis into movs, so a
;;      scan loop that returns its counter is rejected right here.
;; Each clear predecessor must also end in a Jump (no edge split at rewrite
;; time) and leave its clear target with at least one surviving predecessor;
;; every clear edge is redirected or the whole loop is left alone.
;;
;; The rewrite is: retarget each clear edge's Jump to X; drop those predecessors
;; from the phis they fed; replace the gate branch with `Jump T`; fold the
;; closure inputs of phis outside the loop to C on X's edge and to K on every
;; other exit edge; and pin the closure's own definitions to K, which is what
;; every remaining path into them now carries.
;;
;; C4 and C8 count EFFECTIVE uses (`opt-gep-offset-effective-uses`). At this
;; slot the dead Casts that removed BoundsChecks strand are still in the IR --
;; the pipeline DCE is far below -- and counting them would reject loops whose
;; only outside reader is already retired.
(defenum OptFlagExitEdge
  ;; the clearing predecessor, then the phi block its edge flows into.
  (Edge i64 i64))

(defenum OptFlagExitEdgeList
  (Nil)
  ;; Physical append is logical Cons/prepend. Consumers read from the live end
  ;; so the old newest-first traversal order is unchanged.
  (Dense (__tl_dyn-array OptFlagExitEdge) i64))

(define (opt-flag-exit-edge-ref [edges : OptFlagExitEdgeList] [index : i64]) : OptFlagExitEdge
  (match edges
    [(OptFlagExitEdgeList.Nil) (OptFlagExitEdge.Edge -1 -1)]
    [(OptFlagExitEdgeList.Dense items len)
      (array-ref items (- (- len 1) index))]))

(define (opt-flag-exit-edge-tail [edges : OptFlagExitEdgeList]) : OptFlagExitEdgeList
  (match edges
    [(OptFlagExitEdgeList.Nil) (OptFlagExitEdgeList.Nil)]
    [(OptFlagExitEdgeList.Dense items len)
      (if (<= len 1)
        (OptFlagExitEdgeList.Nil)
        (OptFlagExitEdgeList.Dense items (- len 1)))]))

(define (opt-flag-exit-edge-cons
  [pred : i64]
  [target : i64]
  [edges : OptFlagExitEdgeList]) : OptFlagExitEdgeList
  (let
    [edge : OptFlagExitEdge (OptFlagExitEdge.Edge pred target)]
    (match edges
      [(OptFlagExitEdgeList.Nil)
        (let
          [items : (__tl_dyn-array OptFlagExitEdge)
            (array.make-array OptFlagExitEdge 4)]
          (begin
            (set! (array-ref items 0) edge)
            (OptFlagExitEdgeList.Dense items 1)))]
      [(OptFlagExitEdgeList.Dense items len)
        (if (< len (array-length items))
          (begin
            (set! (array-ref items len) edge)
            (OptFlagExitEdgeList.Dense items (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptFlagExitEdge)
              (array.make-array OptFlagExitEdge (opt-dense-next-capacity len))]
            [index : i64 0]
            (begin
              (while (< index len)
                (begin
                  (set! (array-ref bigger index) (array-ref items index))
                  (set! index (+ index 1))))
              (set! (array-ref bigger len) edge)
              (OptFlagExitEdgeList.Dense bigger (+ len 1)))))])))

(cfg
  test
  (test
    optimizer-flag-exit-edge-dense-storage-grows
    (let
      [edges : OptFlagExitEdgeList (OptFlagExitEdgeList.Nil)]
      [index : i64 0]
      (begin
        (while (< index 9)
          (begin
            (set! edges (opt-flag-exit-edge-cons index (+ index 100) edges))
            (set! index (+ index 1))))
        (match edges
          [(OptFlagExitEdgeList.Nil)
            (test.assert-true false "flag-exit edge storage is non-empty")]
          [(OptFlagExitEdgeList.Dense items len)
            (begin
              (test.assert-i64-eq
                len
                9
                "flag-exit edge storage grows past four")
              (test.assert-true
                (>= (array-length items) 9)
                "flag-exit edge storage expands capacity"))])
        (match (opt-flag-exit-edge-ref edges 0)
          [(OptFlagExitEdge.Edge pred target)
            (begin
              (test.assert-i64-eq
                pred
                8
                "flag-exit newest predecessor stays first")
              (test.assert-i64-eq
                target
                108
                "flag-exit newest target stays first"))])
        (match (opt-flag-exit-edge-ref edges 8)
          [(OptFlagExitEdge.Edge pred target)
            (begin
              (test.assert-i64-eq
                pred
                0
                "flag-exit oldest predecessor stays last")
              (test.assert-i64-eq
                target
                100
                "flag-exit oldest target stays last"))])))))

(defenum OptFlagExitMaybeInstr
  (No)
  (Some ir.CompilerIrInstr))

;; gate label, the arm inside the loop, the arm outside it.
(defenum OptFlagExitGate
  (No)
  (Some i64 i64 i64))

(defenum OptFlagExitMaybeLabel
  (No)
  (Some i64))

;; the continuing literal K, then the latch value the closure walk starts from.
(defenum OptFlagExitSeed
  (No)
  (Some bool i64))

(defstruct OptFlagExitPlan
  (gate i64)
  (continue-label i64)
  (exit-label i64)
  (keep bool)
  (closure (__tl_dyn-array i64))
  (clear-preds OptLabelSet)
  (clear-targets OptLabelSet)
  (exits OptLabelSet))

(defenum OptFlagExitMaybePlan
  (No)
  (Some OptFlagExitPlan))

(define (opt-flag-exit-bool-value [flag : bool]) : ir.CompilerIrValue
  (if flag
    (ir.CompilerIrValue.Bool true)
    (ir.CompilerIrValue.Bool false)))

(define (opt-flag-exit-value-is-bool?
  [value : ir.CompilerIrValue]
  [want : bool]) : bool
  (match value
    [(ir.CompilerIrValue.Bool literal)
      (if want
        literal
        (not literal))]
    [_ false]))

(define (opt-flag-exit-closure-var?
  [value : ir.CompilerIrValue]
  [closure : (__tl_dyn-array i64)]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (and
        (>= var 0)
        (< var (array-length closure))
        (= (array-ref closure var) 1))]
    [_ false]))

;; --- prescan -----------------------------------------------------------------
;;
;; Runs on every function on every pipeline iteration, so it stays one
;; allocation-free instruction walk: without a phi carrying a bool literal there
;; is no monotone seed anywhere in the function.
(define (opt-flag-exit-phi-inputs-have-bool?
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-phi-inputs-have-bool?
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (or
        (match value
          [(ir.CompilerIrValue.Bool _) true]
          [_ false])
        (opt-flag-exit-phi-inputs-have-bool? (__tl-box-place rest)))]))

(define (opt-flag-exit-instrs-have-candidate?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Phi _ inputs _)
          (opt-flag-exit-phi-inputs-have-bool? inputs)]
        [_ false])
      (opt-flag-exit-instrs-have-candidate? instrs (+ index 1)))))

(define (opt-flag-exit-block-seq-has-candidate?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (or
      (match (ir.compiler-ir-block-seq-ref blocks index)
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-instrs-have-candidate? instrs 0)])
      (opt-flag-exit-block-seq-has-candidate? blocks (+ index 1)))))

(define (opt-flag-exit-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (or
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-flag-exit-instrs-have-candidate? instrs 0)])
        (opt-flag-exit-blocks-have-candidate? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-block-seq-has-candidate? seq 0)]))

;; --- definition sites ---------------------------------------------------------
(define (opt-flag-exit-def-labels-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [label : i64]
  [def-label : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
        [(option_i64.Some dst)
          (if (and (>= dst 0) (< dst (array-length def-label)))
            (begin
              (set! (array-ref def-label dst) label)
              unit)
            unit)]
        [(option_i64.None) unit])
      (opt-flag-exit-def-labels-instrs! instrs (+ index 1) label def-label))))

(define (opt-flag-exit-def-labels-seq!
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]
  [def-label : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    unit
    (begin
      (match (ir.compiler-ir-block-seq-ref blocks index)
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-flag-exit-def-labels-instrs! instrs 0 label def-label)])
      (opt-flag-exit-def-labels-seq! blocks (+ index 1) def-label))))

(define (opt-flag-exit-def-labels!
  [blocks : ir.CompilerIrBlockList]
  [def-label : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (opt-flag-exit-def-labels-instrs! instrs 0 label def-label)])
        (opt-flag-exit-def-labels! (__tl-box-place rest) def-label))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-def-labels-seq! seq 0 def-label)]))

(define (opt-flag-exit-instr-at-scan
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : OptFlagExitMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptFlagExitMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some found)
          (if (= found dst)
            (OptFlagExitMaybeInstr.Some instr)
            (opt-flag-exit-instr-at-scan instrs (+ index 1) dst))]
        [(option_i64.None) (opt-flag-exit-instr-at-scan instrs (+ index 1) dst)]))))

(define (opt-flag-exit-instr-at
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [dst : i64]) : OptFlagExitMaybeInstr
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) (OptFlagExitMaybeInstr.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-instr-at-scan instrs 0 dst)])]))

;; --- C2: the monotone closure ------------------------------------------------
;;
;; Descend the phi/Mov web that feeds the header flag from the latch. Every leaf
;; must be the flag itself or the clearing literal; a clear leaf records the edge
;; that carries it. `bad` latches any other shape.
(define (opt-flag-exit-walk-inputs
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [def-label : (__tl_dyn-array i64)]
  [flag : i64]
  [clear-const : bool]
  [at-label : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [closure : (__tl_dyn-array i64)]
  [bad : (__tl_dyn-array i64)]
  [acc : OptFlagExitEdgeList]) : OptFlagExitEdgeList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) acc]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-walk-inputs
        blocks
        body
        index
        def-label
        flag
        clear-const
        at-label
        (ir.compiler-ir-phi-input-seq-to-list seq)
        closure
        bad
        acc)]
    [(ir.CompilerIrPhiInputList.Cons value input-label rest)
      (opt-flag-exit-walk-inputs
        blocks
        body
        index
        def-label
        flag
        clear-const
        at-label
        (__tl-box-place rest)
        closure
        bad
        (if (opt-flag-exit-value-is-bool? value clear-const)
          (opt-flag-exit-edge-cons input-label at-label acc)
          (match value
            [(ir.CompilerIrValue.Var var)
              (opt-flag-exit-walk
                blocks
                body
                index
                def-label
                flag
                clear-const
                var
                closure
                bad
                acc)]
            [_
              (begin
                (set! (array-ref bad 0) 1)
                acc)])))]))

(define (opt-flag-exit-walk
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [def-label : (__tl_dyn-array i64)]
  [flag : i64]
  [clear-const : bool]
  [var : i64]
  [closure : (__tl_dyn-array i64)]
  [bad : (__tl_dyn-array i64)]
  [acc : OptFlagExitEdgeList]) : OptFlagExitEdgeList
  (cond
    [(= var flag) acc]
    [(or (< var 0) (>= var (array-length closure)))
      (begin
        (set! (array-ref bad 0) 1)
        acc)]
    [(= (array-ref closure var) 1) acc]
    [else
      (let
        [label : i64 (array-ref def-label var)]
        (if (or
          (< label 0)
          (not (opt-loop-body-label-member? body index label)))
          (begin
            (set! (array-ref bad 0) 1)
            acc)
          (match (opt-flag-exit-instr-at blocks label var)
            [(OptFlagExitMaybeInstr.No)
              (begin
                (set! (array-ref bad 0) 1)
                acc)]
            [(OptFlagExitMaybeInstr.Some instr)
              (begin
                (set! (array-ref closure var) 1)
                (match instr
                  [(ir.CompilerIrInstr.Phi _ inputs _)
                    (opt-flag-exit-walk-inputs
                      blocks
                      body
                      index
                      def-label
                      flag
                      clear-const
                      label
                      inputs
                      closure
                      bad
                      acc)]
                  [(ir.CompilerIrInstr.Mov _ src _)
                    (match src
                      [(ir.CompilerIrValue.Var source)
                        (opt-flag-exit-walk
                          blocks
                          body
                          index
                          def-label
                          flag
                          clear-const
                          source
                          closure
                          bad
                          acc)]
                      [_
                        (begin
                          (set! (array-ref bad 0) 1)
                          acc)])]
                  [_
                    (begin
                      (set! (array-ref bad 0) 1)
                      acc)]))])))]))

(define (opt-flag-exit-edges-empty? [edges : OptFlagExitEdgeList]) : bool
  (match edges
    [(OptFlagExitEdgeList.Nil) true]
    [(OptFlagExitEdgeList.Dense _ _) false]))

(define (opt-flag-exit-edge-preds
  [edges : OptFlagExitEdgeList]
  [acc : OptLabelSet]) : OptLabelSet
  (match edges
    [(OptFlagExitEdgeList.Nil) acc]
    [(OptFlagExitEdgeList.Dense _ _)
      (match (opt-flag-exit-edge-ref edges 0)
        [(OptFlagExitEdge.Edge pred _)
          (opt-flag-exit-edge-preds
            (opt-flag-exit-edge-tail edges)
            (opt-label-add acc pred))])]))

(define (opt-flag-exit-edge-targets
  [edges : OptFlagExitEdgeList]
  [acc : OptLabelSet]) : OptLabelSet
  (match edges
    [(OptFlagExitEdgeList.Nil) acc]
    [(OptFlagExitEdgeList.Dense _ _)
      (match (opt-flag-exit-edge-ref edges 0)
        [(OptFlagExitEdge.Edge _ target)
          (opt-flag-exit-edge-targets
            (opt-flag-exit-edge-tail edges)
            (opt-label-add acc target))])]))

;; --- C3: the gate -------------------------------------------------------------
(define (opt-flag-exit-block-gate
  [instrs : ir.CompilerIrInstrSeq]
  [label : i64]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [closure : (__tl_dyn-array i64)]
  [clear-const : bool]) : OptFlagExitGate
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (= count 0)
      (OptFlagExitGate.No)
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Branch condition true-label false-label)
          (if (not (opt-flag-exit-closure-var? condition closure))
            (OptFlagExitGate.No)
            (let
              [exit-label : i64
                (if clear-const
                  true-label
                  false-label)]
              [continue-label : i64
                (if clear-const
                  false-label
                  true-label)]
              (if (and
                (opt-loop-body-label-member? body index continue-label)
                (not (opt-loop-body-label-member? body index exit-label)))
                (OptFlagExitGate.Some label continue-label exit-label)
                (OptFlagExitGate.No))))]
        [_ (OptFlagExitGate.No)]))))

(define (opt-flag-exit-find-gate
  [body-blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [closure : (__tl_dyn-array i64)]
  [clear-const : bool]) : OptFlagExitGate
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) (OptFlagExitGate.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [here : OptFlagExitGate
          (match block
            [(ir.CompilerIrBlock.Block label instrs)
              (opt-flag-exit-block-gate
                instrs
                label
                body
                index
                closure
                clear-const)])]
        (match here
          [(OptFlagExitGate.Some gate continue-label exit-label)
            (OptFlagExitGate.Some gate continue-label exit-label)]
          [(OptFlagExitGate.No)
            (opt-flag-exit-find-gate
              (__tl-box-place rest)
              body
              index
              closure
              clear-const)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-find-gate
        (ir.compiler-ir-block-seq-to-list seq)
        body
        index
        closure
        clear-const)]))

;; --- C6: the skipped path -----------------------------------------------------
(define (opt-flag-exit-pure-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Phi _ _ _) true]
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ op _ _ _)
      (match op
        [(ir.CompilerIrBinOp.Div) false]
        [(ir.CompilerIrBinOp.Mod) false]
        [_ true])]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.AddrOf _ _) true]
    [_ false]))

(define (opt-flag-exit-block-pure?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (>= index count)
      true
      (let
        [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
        (if (and (= index (- count 1)) (opt-cfg-terminator-instr? instr))
          true
          (if (opt-flag-exit-pure-instr? instr)
            (opt-flag-exit-block-pure? instrs (+ index 1))
            false))))))

;; G may hold phis and its branch and nothing else: the redirect jumps past it.
(define (opt-flag-exit-gate-block-clean?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (- (ir.compiler-ir-instr-seq-count instrs) 1))
    true
    (if (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ _) true]
      [_ false])
      (opt-flag-exit-gate-block-clean? instrs (+ index 1))
      false)))

;; Blocks the redirect skips: everything reachable inside the loop from a clear
;; edge's target, stopping at the gate. Loop exits met on the way are recorded in
;; `alt` -- those are the exits a cleared path could have taken instead of X.
(define (opt-flag-exit-mark-path!
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [gate : i64]
  [label : i64]
  [seen : (__tl_dyn-array i64)]
  [alt : (__tl_dyn-array i64)]) : unit
  (if (= label gate)
    unit
    (match (opt-cfg-index-id index label)
      [(option_i64.None) unit]
      [(option_i64.Some id)
        (if (or (< id 0) (>= id (array-length seen)))
          unit
          (if (opt-loop-body-contains-id? body id)
            (if (= (array-ref seen id) 1)
              unit
              (begin
                (set! (array-ref seen id) 1)
                (opt-flag-exit-mark-path-successors!
                  body
                  index
                  pred-map
                  gate
                  (opt-pred-map-successors pred-map label)
                  seen
                  alt)))
            (begin
              (set! (array-ref alt id) 1)
              unit)))])))

(define (opt-flag-exit-mark-path-successors!
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [gate : i64]
  [successors : OptLabelSet]
  [seen : (__tl_dyn-array i64)]
  [alt : (__tl_dyn-array i64)]) : unit
  (match successors
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (begin
        (opt-flag-exit-mark-path!
          body
          index
          pred-map
          gate
          (opt-label-ref successors 0)
          seen
          alt)
        (opt-flag-exit-mark-path-successors!
          body
          index
          pred-map
          gate
          (opt-label-tail successors)
          seen
          alt))]))

(define (opt-flag-exit-mark-clears!
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [gate : i64]
  [edges : OptFlagExitEdgeList]
  [seen : (__tl_dyn-array i64)]
  [alt : (__tl_dyn-array i64)]) : unit
  (match edges
    [(OptFlagExitEdgeList.Nil) unit]
    [(OptFlagExitEdgeList.Dense _ _)
      (match (opt-flag-exit-edge-ref edges 0)
        [(OptFlagExitEdge.Edge _ target)
          (begin
            (opt-flag-exit-mark-path! body index pred-map gate target seen alt)
            (opt-flag-exit-mark-clears!
              body
              index
              pred-map
              gate
              (opt-flag-exit-edge-tail edges)
              seen
              alt))])]))

(define (opt-flag-exit-marked-pure?
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [seen : (__tl_dyn-array i64)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (and
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (match (opt-cfg-index-id index label)
              [(option_i64.None) true]
              [(option_i64.Some id)
                (if (and
                  (>= id 0)
                  (< id (array-length seen))
                  (= (array-ref seen id) 1))
                  (opt-flag-exit-block-pure? instrs 0)
                  true)])])
        (opt-flag-exit-marked-pure? (__tl-box-place rest) index seen))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-marked-pure?
        (ir.compiler-ir-block-seq-to-list seq)
        index
        seen)]))

;; The alternate exits, minus X itself.
(define (opt-flag-exit-alt-labels
  [index : OptCfgIndex]
  [alt : (__tl_dyn-array i64)]
  [id : i64]
  [exit-label : i64]
  [acc : OptLabelSet]) : OptLabelSet
  (if (>= id (array-length alt))
    acc
    (opt-flag-exit-alt-labels
      index
      alt
      (+ id 1)
      exit-label
      (let
        [label : i64 (opt-cfg-index-label index id)]
        (if (and (= (array-ref alt id) 1) (not (= label exit-label)))
          (opt-label-add acc label)
          acc)))))

;; --- exits and the merge block -------------------------------------------------
(define (opt-flag-exit-outside-successors
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [successors : OptLabelSet]
  [acc : OptLabelSet]) : OptLabelSet
  (match successors
    [(OptLabelSet.Nil) acc]
    [(OptLabelSet.Dense _ _)
      (opt-flag-exit-outside-successors
        body
        index
        (opt-label-tail successors)
        (let
          [label : i64 (opt-label-ref successors 0)]
          (if (opt-loop-body-label-member? body index label)
            acc
            (opt-label-add acc label))))]))

(define (opt-flag-exit-exit-labels-from
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [labels : OptLabelSet]
  [acc : OptLabelSet]) : OptLabelSet
  (match labels
    [(OptLabelSet.Nil) acc]
    [(OptLabelSet.Dense _ _)
      (opt-flag-exit-exit-labels-from
        body
        index
        pred-map
        (opt-label-tail labels)
        (opt-flag-exit-outside-successors
          body
          index
          (opt-pred-map-successors pred-map (opt-label-ref labels 0))
          acc))]))

;; A block whose whole body is one Jump: the only shape an alternate exit and X
;; may take, so that swapping between them is invisible past the merge.
(define (opt-flag-exit-jump-only-target
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : OptFlagExitMaybeLabel
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) (OptFlagExitMaybeLabel.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (not (= (ir.compiler-ir-instr-seq-count instrs) 1))
            (OptFlagExitMaybeLabel.No)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Jump target)
                (OptFlagExitMaybeLabel.Some target)]
              [_ (OptFlagExitMaybeLabel.No)]))])]))

(define (opt-flag-exit-all-jump-only-to?
  [blocks : ir.CompilerIrBlockList]
  [labels : OptLabelSet]
  [merge : i64]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (match (opt-flag-exit-jump-only-target blocks (opt-label-ref labels 0))
          [(OptFlagExitMaybeLabel.No) false]
          [(OptFlagExitMaybeLabel.Some target) (= target merge)])
        (opt-flag-exit-all-jump-only-to? blocks (opt-label-tail labels) merge))]))

(define (opt-flag-exit-first-keyed-value
  [inputs : ir.CompilerIrPhiInputList]
  [keys : OptLabelSet]) : ir.CompilerIrMaybeValue
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-first-keyed-value
        (ir.compiler-ir-phi-input-seq-to-list seq)
        keys)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains keys label)
        (ir.CompilerIrMaybeValue.Some value)
        (opt-flag-exit-first-keyed-value (__tl-box-place rest) keys))]))

(define (opt-flag-exit-keyed-any-closure?
  [inputs : ir.CompilerIrPhiInputList]
  [keys : OptLabelSet]
  [closure : (__tl_dyn-array i64)]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-keyed-any-closure?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        keys
        closure)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (or
        (and
          (opt-label-contains keys label)
          (opt-flag-exit-closure-var? value closure))
        (opt-flag-exit-keyed-any-closure? (__tl-box-place rest) keys closure))]))

(define (opt-flag-exit-keyed-all-closure?
  [inputs : ir.CompilerIrPhiInputList]
  [keys : OptLabelSet]
  [closure : (__tl_dyn-array i64)]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-keyed-all-closure?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        keys
        closure)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (and
        (or
          (not (opt-label-contains keys label))
          (opt-flag-exit-closure-var? value closure))
        (opt-flag-exit-keyed-all-closure? (__tl-box-place rest) keys closure))]))

(define (opt-flag-exit-keyed-all-eq?
  [inputs : ir.CompilerIrPhiInputList]
  [keys : OptLabelSet]
  [want : ir.CompilerIrValue]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-keyed-all-eq?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        keys
        want)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (and
        (or (not (opt-label-contains keys label)) (opt-value-eq value want))
        (opt-flag-exit-keyed-all-eq? (__tl-box-place rest) keys want))]))

;; Every phi of the merge block must give the same answer whichever of the
;; interchangeable exits a cleared path arrives on: either a closure var on all
;; of them (rewritten to the same literal below) or one identical value.
(define (opt-flag-exit-merge-phis-agree?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [keys : OptLabelSet]
  [closure : (__tl_dyn-array i64)]) : bool
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    true
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (and
          (or
            (opt-flag-exit-keyed-all-closure? inputs keys closure)
            (match (opt-flag-exit-first-keyed-value inputs keys)
              [(ir.CompilerIrMaybeValue.No) true]
              [(ir.CompilerIrMaybeValue.Some first)
                (opt-flag-exit-keyed-all-eq? inputs keys first)]))
          (opt-flag-exit-merge-phis-agree? instrs (+ pos 1) keys closure))]
      [_ true])))

(define (opt-flag-exit-merge-ok?
  [blocks : ir.CompilerIrBlockList]
  [keys : OptLabelSet]
  [merge : i64]
  [closure : (__tl_dyn-array i64)]) : bool
  (match (opt-cfg-find-block blocks merge)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-merge-phis-agree? instrs 0 keys closure)])]))

;; C7's separation clause. The rewrite folds a closure phi input keyed on X to
;; the cleared literal C and one keyed on ANY OTHER exit to the continuing
;; literal K, so the exits have to name arrivals a single path cannot both make.
;; They do not when one exit block FALLS INTO another: a loop that tests the flag
;; before the counter -- `(while (if ok (< i n) false) ...)`, the shape
;; `opt-symbol-leaf-matches-from?` lowers to -- puts the gate's exit arm on the
;; way to the counter's exit block, so a cleared path traverses the counter
;; exit's edge and every phi input keyed there would be folded to K. The walk
;; stops at loop blocks: re-entering the loop re-seeds the flag from the
;; preheader, which is exactly the enclosing-loop shape the pass exists for.
(define (opt-flag-exit-exit-walk?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [exits : OptLabelSet]
  [label : i64]
  [seen : (__tl_dyn-array i64)]) : bool
  (match (opt-cfg-index-id index label)
    [(option_i64.None) false]
    [(option_i64.Some id)
      (if (or (< id 0) (>= id (array-length seen)) (= (array-ref seen id) 1))
        false
        (begin
          (set! (array-ref seen id) 1)
          (cond
            [(opt-label-contains exits label) true]
            [(opt-loop-body-contains-id? body id) false]
            [else
              (opt-flag-exit-exit-walk-successors?
                blocks
                body
                index
                pred-map
                exits
                (opt-pred-map-successors pred-map label)
                seen)])))]))

(define (opt-flag-exit-exit-walk-successors?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [exits : OptLabelSet]
  [labels : OptLabelSet]
  [seen : (__tl_dyn-array i64)]) : bool
  (match labels
    [(OptLabelSet.Nil) false]
    [(OptLabelSet.Dense _ _)
      (or
        (opt-flag-exit-exit-walk?
          blocks
          body
          index
          pred-map
          exits
          (opt-label-ref labels 0)
          seen)
        (opt-flag-exit-exit-walk-successors?
          blocks
          body
          index
          pred-map
          exits
          (opt-label-tail labels)
          seen))]))

(define (opt-flag-exit-exits-separate-from?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [pred-map : OptPredMap]
  [exits : OptLabelSet]
  [labels : OptLabelSet]
  [count : i64]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (not
          (opt-flag-exit-exit-walk-successors?
            blocks
            body
            index
            pred-map
            exits
            (opt-pred-map-successors pred-map (opt-label-ref labels 0))
            (array.make-array i64 count)))
        (opt-flag-exit-exits-separate-from?
          blocks
          body
          index
          pred-map
          exits
          (opt-label-tail labels)
          count))]))

(define (opt-flag-exit-exits-separate?
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [body : OptLoopBody]
  [exits : OptLabelSet]) : bool
  (let
    [index : OptCfgIndex context.index]
    (opt-flag-exit-exits-separate-from?
      blocks
      body
      index
      context.pred-map
      exits
      exits
      (opt-cfg-index-block-count index))))

;; C7's alternate-exit clause. With no alternate exit, a cleared path always left
;; through X already and there is nothing to reconcile.
(define (opt-flag-exit-alt-exits-ok?
  [blocks : ir.CompilerIrBlockList]
  [alt-labels : OptLabelSet]
  [exit-label : i64]
  [closure : (__tl_dyn-array i64)]) : bool
  (match alt-labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (match (opt-flag-exit-jump-only-target blocks exit-label)
        [(OptFlagExitMaybeLabel.No) false]
        [(OptFlagExitMaybeLabel.Some merge)
          (and
            (opt-flag-exit-all-jump-only-to? blocks alt-labels merge)
            (opt-flag-exit-merge-ok?
              blocks
              (opt-label-add alt-labels exit-label)
              merge
              closure))])]))

;; --- C4/C7b: where the closure may be read ------------------------------------
(define (opt-flag-exit-note-keyed-uses!
  [inputs : ir.CompilerIrPhiInputList]
  [keys : OptLabelSet]
  [allowed : (__tl_dyn-array i64)]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-note-keyed-uses!
        (ir.compiler-ir-phi-input-seq-to-list seq)
        keys
        allowed)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (begin
        (if (opt-label-contains keys label)
          (opt-collect-value-uses-array allowed value)
          unit)
        (opt-flag-exit-note-keyed-uses! (__tl-box-place rest) keys allowed))]))

(define (opt-flag-exit-defines-closure?
  [instr : ir.CompilerIrInstr]
  [closure : (__tl_dyn-array i64)]) : bool
  (match (opt-instr-def-var instr)
    [(option_i64.Some dst)
      (and
        (>= dst 0)
        (< dst (array-length closure))
        (= (array-ref closure dst) 1))]
    [(option_i64.None) false]))

(define (opt-flag-exit-allowed-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [in-body? : bool]
  [gate? : bool]
  [exits : OptLabelSet]
  [closure : (__tl_dyn-array i64)]
  [allowed : (__tl_dyn-array i64)]) : unit
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (begin
        (cond
          ;; the closure's own phis and copies
          [(opt-flag-exit-defines-closure? instr closure)
            (opt-collect-instr-uses-array allowed instr)]
          ;; the gate branch
          [(and
              gate?
              (match instr
                [(ir.CompilerIrInstr.Branch _ _ _) true]
                [_ false]))
            (opt-collect-instr-uses-array allowed instr)]
          [in-body? unit]
          ;; a phi outside the loop, on an edge out of the loop
          [else
            (match instr
              [(ir.CompilerIrInstr.Phi _ inputs _)
                (opt-flag-exit-note-keyed-uses! inputs exits allowed)]
              [_ unit])])
        (opt-flag-exit-allowed-instrs!
          instrs
          (+ pos 1)
          in-body?
          gate?
          exits
          closure
          allowed)))))

(define (opt-flag-exit-allowed-blocks!
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [gate : i64]
  [exits : OptLabelSet]
  [closure : (__tl_dyn-array i64)]
  [allowed : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (opt-flag-exit-allowed-instrs!
              instrs
              0
              (opt-loop-body-label-member? body index label)
              (= label gate)
              exits
              closure
              allowed)])
        (opt-flag-exit-allowed-blocks!
          (__tl-box-place rest)
          body
          index
          gate
          exits
          closure
          allowed))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-allowed-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        body
        index
        gate
        exits
        closure
        allowed)]))

;; --- C8: nothing else escapes the loop ----------------------------------------
(define (opt-flag-exit-body-uses-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [defined : (__tl_dyn-array i64)]
  [inside : (__tl_dyn-array i64)]) : unit
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (begin
        (opt-collect-instr-uses-array inside instr)
        (match (opt-instr-def-var instr)
          [(option_i64.Some dst)
            (if (and (>= dst 0) (< dst (array-length defined)))
              (begin
                (set! (array-ref defined dst) 1)
                unit)
              unit)]
          [(option_i64.None) unit])
        (opt-flag-exit-body-uses-instrs! instrs (+ pos 1) defined inside)))))

(define (opt-flag-exit-body-uses!
  [body-blocks : ir.CompilerIrBlockList]
  [defined : (__tl_dyn-array i64)]
  [inside : (__tl_dyn-array i64)]) : unit
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-flag-exit-body-uses-instrs! instrs 0 defined inside)])
        (opt-flag-exit-body-uses! (__tl-box-place rest) defined inside))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-body-uses!
        (ir.compiler-ir-block-seq-to-list seq)
        defined
        inside)]))

;; C8 exempts the closure itself: C4 above already accounts for every read of it.
(define (opt-flag-exit-clear-closure!
  [defined : (__tl_dyn-array i64)]
  [closure : (__tl_dyn-array i64)]) : unit
  (let
    [var : i64 0]
    (begin
      (while (< var (array-length defined))
        (begin
          (if (= (array-ref closure var) 1)
            (begin
              (set! (array-ref defined var) 0)
              unit)
            unit)
          (set! var (+ var 1))))
      unit)))

;; `uses` already has the DCE-retired chains subtracted, so a stale reader cannot
;; make a settled value look like an escape.
(define (opt-flag-exit-covered?
  [uses : (__tl_dyn-array i64)]
  [allowed : (__tl_dyn-array i64)]
  [select : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (>= var (array-length select))
    true
    (if (and
      (= (array-ref select var) 1)
      (> (array-ref uses var) (array-ref allowed var)))
      false
      (opt-flag-exit-covered? uses allowed select (+ var 1)))))

;; --- clear-edge shape ---------------------------------------------------------
(define (opt-flag-exit-block-jumps-to?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump found) (= found target)]
                [_ false])))])]))

(define (opt-flag-exit-block-starts-with-phi?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]))

(define (opt-flag-exit-gate-clean-at?
  [blocks : ir.CompilerIrBlockList]
  [gate : i64]) : bool
  (match (opt-cfg-find-block blocks gate)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-gate-block-clean? instrs 0)])]))

;; Each clear predecessor sits inside the loop, ends in a plain Jump into the phi
;; block (so the redirect splits no edge), and is dominated by the gate (so
;; everything the gate's exit arm can read is live on the redirected edge too).
(define (opt-flag-exit-clear-edges-ok?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [gate : i64]
  [edges : OptFlagExitEdgeList]) : bool
  (match edges
    [(OptFlagExitEdgeList.Nil) true]
    [(OptFlagExitEdgeList.Dense _ _)
      (match (opt-flag-exit-edge-ref edges 0)
        [(OptFlagExitEdge.Edge pred target)
          (and
            (opt-loop-body-label-member? body index pred)
            (opt-flag-exit-block-jumps-to? blocks pred target)
            (opt-dom-dominates? doms gate pred)
            (opt-flag-exit-clear-edges-ok?
              blocks
              body
              index
              doms
              gate
              (opt-flag-exit-edge-tail edges)))])]))

(define (opt-flag-exit-preds-survive?
  [pred-map : OptPredMap]
  [clear-preds : OptLabelSet]
  [targets : OptLabelSet]) : bool
  (match targets
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (let
          [preds : OptLabelSet
            (opt-pred-map-lookup pred-map (opt-label-ref targets 0))]
          (>
            (opt-label-count preds)
            (opt-label-count (opt-label-intersection preds clear-preds))))
        (opt-flag-exit-preds-survive?
          pred-map
          clear-preds
          (opt-label-tail targets)))]))

;; --- C7b over the whole function ----------------------------------------------
(define (opt-flag-exit-block-phis-uniform?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [exits : OptLabelSet]
  [closure : (__tl_dyn-array i64)]) : bool
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (match (ir.compiler-ir-instr-seq-ref instrs pos)
        [(ir.CompilerIrInstr.Phi _ inputs _)
          (or
            (not (opt-flag-exit-keyed-any-closure? inputs exits closure))
            (opt-flag-exit-keyed-all-closure? inputs exits closure))]
        [_ true])
      (opt-flag-exit-block-phis-uniform? instrs (+ pos 1) exits closure))))

(define (opt-flag-exit-outside-phis-uniform?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [exits : OptLabelSet]
  [closure : (__tl_dyn-array i64)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (and
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (if (opt-loop-body-label-member? body index label)
              true
              (opt-flag-exit-block-phis-uniform? instrs 0 exits closure))])
        (opt-flag-exit-outside-phis-uniform?
          (__tl-box-place rest)
          body
          index
          exits
          closure))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-outside-phis-uniform?
        (ir.compiler-ir-block-seq-to-list seq)
        body
        index
        exits
        closure)]))

;; --- rewrite ------------------------------------------------------------------
(define (opt-flag-exit-drop-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [preds : OptLabelSet]) : ir.CompilerIrPhiInputList
  (match preds
    [(OptLabelSet.Nil) inputs]
    [(OptLabelSet.Dense _ _)
      (opt-flag-exit-drop-inputs
        (opt-thread-phi-inputs-drop inputs (opt-label-ref preds 0))
        (opt-label-tail preds))]))

(define (opt-flag-exit-literalize-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [plan : OptFlagExitPlan]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-literalize-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        plan)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (if (and
          (opt-label-contains plan.exits label)
          (opt-flag-exit-closure-var? value plan.closure))
          (opt-flag-exit-bool-value
            (if (= label plan.exit-label)
              (not plan.keep)
              plan.keep))
          value)
        label
        (opt-flag-exit-literalize-inputs (__tl-box-place rest) plan))]))

;; Step 5. Once the clear edges are gone, every remaining path into a closure
;; definition carries K, so pin each one to that literal. The phis are left in
;; place (a Mov among them would break the block's phi prefix) with all their
;; inputs constant, which breaks the flag's phi <-> phi CYCLE: the pipeline DCE
;; retires dead chains, not cycles, so without this the retired flag would still
;; cost its `mov $K` and a loop-live register.
(define (opt-flag-exit-const-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [keep : bool]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-const-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        keep)]
    [(ir.CompilerIrPhiInputList.Cons _ label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-flag-exit-bool-value keep)
        label
        (opt-flag-exit-const-inputs (__tl-box-place rest) keep))]))

(define (opt-flag-exit-closure-dst? [dst : i64] [plan : OptFlagExitPlan]) : bool
  (let
    [closure : (__tl_dyn-array i64) plan.closure]
    (and
      (>= dst 0)
      (< dst (array-length closure))
      (= (array-ref closure dst) 1))))

(define (opt-flag-exit-rewrite-instr
  [instr : ir.CompilerIrInstr]
  [in-body? : bool]
  [clear-target? : bool]
  [clear-pred? : bool]
  [gate? : bool]
  [last? : bool]
  [plan : OptFlagExitPlan]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (cond
        ;; a flag definition: pinned to the continuing constant
        [(opt-flag-exit-closure-dst? dst plan)
          (ir.CompilerIrInstr.Phi
            dst
            (opt-flag-exit-const-inputs
              (if clear-target?
                (opt-flag-exit-drop-inputs inputs plan.clear-preds)
                inputs)
              plan.keep)
            ty)]
        ;; a phi the redirected edge no longer reaches
        [clear-target?
          (ir.CompilerIrInstr.Phi
            dst
            (opt-flag-exit-drop-inputs inputs plan.clear-preds)
            ty)]
        [in-body? instr]
        ;; a phi outside the loop: closure inputs become the exit's literal
        [else
          (ir.CompilerIrInstr.Phi
            dst
            (opt-flag-exit-literalize-inputs inputs plan)
            ty)])]
    [(ir.CompilerIrInstr.Mov dst _ ty)
      (if (opt-flag-exit-closure-dst? dst plan)
        (ir.CompilerIrInstr.Mov dst (opt-flag-exit-bool-value plan.keep) ty)
        instr)]
    [_
      (cond
        [(not last?) instr]
        [clear-pred? (ir.CompilerIrInstr.Jump plan.exit-label)]
        [gate? (ir.CompilerIrInstr.Jump plan.continue-label)]
        [else instr])]))

(define (opt-flag-exit-rewrite-instrs-from
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [in-body? : bool]
  [clear-target? : bool]
  [clear-pred? : bool]
  [gate? : bool]
  [plan : OptFlagExitPlan]) : ir.CompilerIrInstrList
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (>= pos count)
      (ir.CompilerIrInstrList.Nil)
      (ir.compiler-ir-instr-cons
        (opt-flag-exit-rewrite-instr
          (ir.compiler-ir-instr-seq-ref instrs pos)
          in-body?
          clear-target?
          clear-pred?
          gate?
          (= pos (- count 1))
          plan)
        (opt-flag-exit-rewrite-instrs-from
          instrs
          (+ pos 1)
          in-body?
          clear-target?
          clear-pred?
          gate?
          plan)))))

(define (opt-flag-exit-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [plan : OptFlagExitPlan]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (ir.compiler-ir-block
              label
              (opt-flag-exit-rewrite-instrs-from
                instrs
                0
                (opt-loop-body-label-member? body index label)
                (opt-label-contains plan.clear-targets label)
                (opt-label-contains plan.clear-preds label)
                (= label plan.gate)
                plan))])
        (opt-flag-exit-rewrite-blocks (__tl-box-place rest) body index plan))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        body
        index
        plan)]))

;; --- per-candidate plan -------------------------------------------------------
;; C5, C6 and C7 in one place: everything that only needs the CFG and the block
;; shapes, checked before the two use-accounting sweeps below pay for themselves.
(define (opt-flag-exit-structure-ok?
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [body : OptLoopBody]
  [latch : i64]
  [gate : i64]
  [exit-label : i64]
  [clears : OptFlagExitEdgeList]
  [clear-preds : OptLabelSet]
  [clear-targets : OptLabelSet]
  [alt-labels : OptLabelSet]
  [exits : OptLabelSet]
  [seen : (__tl_dyn-array i64)]
  [closure : (__tl_dyn-array i64)]) : bool
  (let
    [index : OptCfgIndex context.index]
    [pred-map : OptPredMap context.pred-map]
    [doms : OptDomInfo context.doms]
    (and
      (opt-dom-dominates? doms gate latch)
      (opt-flag-exit-clear-edges-ok? blocks body index doms gate clears)
      (opt-flag-exit-preds-survive? pred-map clear-preds clear-targets)
      (opt-flag-exit-marked-pure? blocks index seen)
      (opt-flag-exit-gate-clean-at? blocks gate)
      (= (opt-label-count (opt-pred-map-lookup pred-map exit-label)) 1)
      (not (opt-flag-exit-block-starts-with-phi? blocks exit-label))
      (opt-flag-exit-exits-separate? blocks context body exits)
      (opt-flag-exit-outside-phis-uniform? blocks body index exits closure)
      (opt-flag-exit-alt-exits-ok? blocks alt-labels exit-label closure))))

;; C4 and C8: the two effective-use sweeps.
(define (opt-flag-exit-uses-ok?
  [blocks : ir.CompilerIrBlockList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [gate : i64]
  [exits : OptLabelSet]
  [closure : (__tl_dyn-array i64)]) : bool
  (let
    [allowed : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [defined : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [inside : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [_allow : unit
      (opt-flag-exit-allowed-blocks!
        blocks
        body
        index
        gate
        exits
        closure
        allowed)]
    [_inside : unit
      (opt-flag-exit-body-uses! (opt-loop-body-blocks body) defined inside)]
    [_exempt : unit (opt-flag-exit-clear-closure! defined closure)]
    (and
      (opt-flag-exit-covered? uses allowed closure 0)
      (opt-flag-exit-covered? uses inside defined 0))))

(define (opt-flag-exit-plan-gated
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [body : OptLoopBody]
  [latch : i64]
  [keep : bool]
  [closure : (__tl_dyn-array i64)]
  [clears : OptFlagExitEdgeList]
  [gate : i64]
  [continue-label : i64]
  [exit-label : i64]) : OptFlagExitMaybePlan
  (let
    [index : OptCfgIndex context.index]
    [pred-map : OptPredMap context.pred-map]
    [count : i64 (opt-cfg-index-block-count index)]
    [seen : (__tl_dyn-array i64) (array.make-array i64 count)]
    [alt : (__tl_dyn-array i64) (array.make-array i64 count)]
    [_mark : unit
      (opt-flag-exit-mark-clears! body index pred-map gate clears seen alt)]
    [alt-labels : OptLabelSet
      (opt-flag-exit-alt-labels index alt 0 exit-label (OptLabelSet.Nil))]
    [clear-preds : OptLabelSet
      (opt-flag-exit-edge-preds clears (OptLabelSet.Nil))]
    [clear-targets : OptLabelSet
      (opt-flag-exit-edge-targets clears (OptLabelSet.Nil))]
    [exits : OptLabelSet
      (opt-flag-exit-exit-labels-from
        body
        index
        pred-map
        (opt-loop-body-labels body)
        (OptLabelSet.Nil))]
    (if (and
      (opt-flag-exit-structure-ok?
        blocks
        context
        body
        latch
        gate
        exit-label
        clears
        clear-preds
        clear-targets
        alt-labels
        exits
        seen
        closure)
      (opt-flag-exit-uses-ok? blocks body index frame uses gate exits closure))
      (OptFlagExitMaybePlan.Some
        (OptFlagExitPlan
          gate
          continue-label
          exit-label
          keep
          closure
          clear-preds
          clear-targets
          exits))
      (OptFlagExitMaybePlan.No))))

(define (opt-flag-exit-plan-candidate
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [def-label : (__tl_dyn-array i64)]
  [loop : OptNaturalLoop]
  [flag : i64]
  [keep : bool]
  [seed : i64]) : OptFlagExitMaybePlan
  (let
    [index : OptCfgIndex context.index]
    [body : OptLoopBody (opt-natural-loop-body-info loop)]
    [closure : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [bad : (__tl_dyn-array i64) (array.make-array i64 1)]
    [clears : OptFlagExitEdgeList
      (opt-flag-exit-walk
        blocks
        body
        index
        def-label
        flag
        (not keep)
        seed
        closure
        bad
        (OptFlagExitEdgeList.Nil))]
    (if (or (= (array-ref bad 0) 1) (opt-flag-exit-edges-empty? clears))
      (OptFlagExitMaybePlan.No)
      (begin
        (set! (array-ref closure flag) 1)
        (match (opt-flag-exit-find-gate
          (opt-loop-body-blocks body)
          body
          index
          closure
          (not keep))
          [(OptFlagExitGate.No) (OptFlagExitMaybePlan.No)]
          [(OptFlagExitGate.Some gate continue-label exit-label)
            (opt-flag-exit-plan-gated
              blocks
              context
              frame
              uses
              body
              (opt-natural-loop-latch loop)
              keep
              closure
              clears
              gate
              continue-label
              exit-label)])))))

;; --- per-loop scan ------------------------------------------------------------
;; C1: exactly one input from outside the loop carrying a bool literal, exactly
;; one from inside it carrying a var.
(define (opt-flag-exit-seed-scan
  [inputs : ir.CompilerIrPhiInputList]
  [body : OptLoopBody]
  [index : OptCfgIndex]
  [outside : i64]
  [inside : i64]
  [keep : bool]
  [seed : i64]) : OptFlagExitSeed
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil)
      (if (and (= outside 1) (= inside 1))
        (OptFlagExitSeed.Some keep seed)
        (OptFlagExitSeed.No))]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-flag-exit-seed-scan
        (ir.compiler-ir-phi-input-seq-to-list seq)
        body
        index
        outside
        inside
        keep
        seed)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-loop-body-label-member? body index label)
        (match value
          [(ir.CompilerIrValue.Var var)
            (opt-flag-exit-seed-scan
              (__tl-box-place rest)
              body
              index
              outside
              (+ inside 1)
              keep
              var)]
          [_ (OptFlagExitSeed.No)])
        (match value
          [(ir.CompilerIrValue.Bool literal)
            (opt-flag-exit-seed-scan
              (__tl-box-place rest)
              body
              index
              (+ outside 1)
              inside
              literal
              seed)]
          [_ (OptFlagExitSeed.No)]))]))

(define (opt-flag-exit-scan-header
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [def-label : (__tl_dyn-array i64)]
  [loop : OptNaturalLoop]
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]) : OptFlagExitMaybePlan
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    (OptFlagExitMaybePlan.No)
    (let
      [here : OptFlagExitMaybePlan
        (match (ir.compiler-ir-instr-seq-ref instrs pos)
          [(ir.CompilerIrInstr.Phi dst inputs _)
            (match (opt-flag-exit-seed-scan
              inputs
              (opt-natural-loop-body-info loop)
              context.index
              0
              0
              false
              (- 0 1))
              [(OptFlagExitSeed.No) (OptFlagExitMaybePlan.No)]
              [(OptFlagExitSeed.Some keep seed)
                (opt-flag-exit-plan-candidate
                  blocks
                  context
                  frame
                  uses
                  def-label
                  loop
                  dst
                  keep
                  seed)])]
          [_ (OptFlagExitMaybePlan.No)])]
      (match here
        [(OptFlagExitMaybePlan.Some plan) (OptFlagExitMaybePlan.Some plan)]
        [(OptFlagExitMaybePlan.No)
          (opt-flag-exit-scan-header
            blocks
            context
            frame
            uses
            def-label
            loop
            instrs
            (+ pos 1))]))))

(define (opt-flag-exit-plan-loop
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [def-label : (__tl_dyn-array i64)]
  [loop : OptNaturalLoop]) : OptFlagExitMaybePlan
  (match (opt-cfg-find-block blocks (opt-natural-loop-header loop))
    [(OptMaybeBlock.No) (OptFlagExitMaybePlan.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-scan-header
            blocks
            context
            frame
            uses
            def-label
            loop
            instrs
            0)])]))

(define (opt-flag-exit-convert-loops
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [def-label : (__tl_dyn-array i64)]
  [loops : OptNaturalLoopList]) : OptBlockListPassResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-flag-exit-plan-loop blocks context frame uses def-label loop)
        [(OptFlagExitMaybePlan.Some plan)
          (OptBlockListPassResult.Result
            (opt-flag-exit-rewrite-blocks
              blocks
              (opt-natural-loop-body-info loop)
              context.index
              plan)
            true)]
        [(OptFlagExitMaybePlan.No)
          (opt-flag-exit-convert-loops
            blocks
            context
            frame
            uses
            def-label
            (__tl-box-place rest))])]))

;; --- driver -------------------------------------------------------------------
(define (opt-flag-exit-blocks-once-with-context
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]) : OptBlockListPassResult
  (if (not (opt-flag-exit-blocks-have-candidate? blocks))
    (OptBlockListPassResult.Result blocks false)
    (let
      [loops : OptNaturalLoopList
        (opt-cfg-natural-loops-with-context blocks context)]
      (match loops
        [(OptNaturalLoopList.Nil) (OptBlockListPassResult.Result blocks false)]
        [(OptNaturalLoopList.Cons _ _)
          (let
            [uses : (__tl_dyn-array i64)
              (opt-gep-offset-effective-uses blocks frame)]
            [def-label : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [_fill : unit (opt-cfg-fill-i64! def-label frame (- 0 1))]
            [_defs : unit (opt-flag-exit-def-labels! blocks def-label)]
            (opt-flag-exit-convert-loops
              blocks
              context
              frame
              uses
              def-label
              loops))]))))

;; One conversion per round, then a fresh context: the rewrite changes the CFG,
;; so the loop set and the dominance facts have to be rebuilt before the next
;; loop is considered. Fuel-bounded by the block count.
(define (opt-flag-exit-blocks-fixed-result
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [remaining : i64]
  [any-changed : bool]
  [first-round? : bool]) : OptBlockListPassResult
  (if (<= remaining 0)
    (OptBlockListPassResult.Result blocks any-changed)
    (match (if first-round?
      (opt-flag-exit-blocks-once-with-context blocks context frame)
      (opt-flag-exit-blocks-once-with-context
        blocks
        (opt-cfg-context-build blocks)
        frame))
      [(OptBlockListPassResult.Result next changed)
        (if changed
          (opt-flag-exit-blocks-fixed-result
            next
            context
            frame
            (- remaining 1)
            true
            false)
          (OptBlockListPassResult.Result next any-changed))])))

;; `context` must be valid for `func`'s blocks (its entry verify reuses it). The
;; rewrite changes the CFG, so a converted function gets a fresh context; a
;; verifier rejection falls back to the byte-identical input.
(define (opt-flag-exit-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-flag-exit-blocks-fixed-result
            blocks
            context
            frame
            (+ 1 (ir.compiler-ir-block-list-count blocks))
            false
            true)
            [(OptBlockListPassResult.Result next-blocks changed)
              (if (not changed)
                (OptFunctionCtxResult.Result func context)
                (let
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      frame
                      next-blocks)]
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)])))])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

;; Standalone driver for tests and ad-hoc runs: builds its own CFG context and
;; keeps the defensive entry verify.
(define (opt-flag-exit-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-flag-exit-function-with-context-result
    (opt-cfg-context-build (opt-function-blocks func))
    false
    func)
    [(OptFunctionCtxResult.Result next _) next]))

;; --- linear-function test replacement (LFTR) -------------------------------
;;
;; The induction slice above strength-reduces a loop's derived addresses into
;; pointer phis. That regularly leaves the original i64 counter phi with
;; nothing left to do but feed its own latch increment and the loop's exit
;; compare, and that residue still costs an `add` plus a loop-live register on
;; every iteration.
;;
;; LFTR retires such a counter. When the counter phi's uses across the WHOLE
;; function are exactly its `+ 1` latch increment, the copy hop that carries
;; the increment back into the phi, the exit compare, and instructions that are
;; already dead, the exit test is rewritten onto a derived pointer phi of the
;; same loop and the counter's phi/increment/copy are deleted outright.
;;
;; The residue is a phi <-> add <-> mov CYCLE. The pipeline's use-count DCE
;; sweep retires dead chains, not cycles, so this pass deletes the retired
;; instructions itself instead of leaving them for a cleanup that never comes.
;;
;; Shape (both latch compare forms are handled):
;;
;;   preheader: p0 = <pointer seed>        end = gep p0, (bound - seed) * K
;;   header:    i  = phi [seed, ph], [i2, latch]
;;              p  = phi [p0, ph],   [p2, latch]
;;   latch:     i2 = i + 1                 (deleted, with i and the copy)
;;              p2 = gep p, K
;;              c  = lt i,  bound  ->      c = lt p,  end        (form A)
;;              c  = lt i2, bound  ->      c = lt p2, end        (form B)
;;
;; Correctness. Both phis take their preheader value on the same edge and are
;; advanced unconditionally on the same latch edge, the counter by exactly + 1
;; and the pointer by exactly K elements, so at every header entry
;; `p = p0 + (i - seed) * K` elements. That map is strictly increasing, so
;; `i < bound` <=> `p < p0 + (bound - seed) * K` as long as the right-hand
;; address does not wrap.
;;
;; No-wrap: eligibility requires the counter to carry NO bounds check. A bounds
;; check reads the counter and is neither the increment nor the compare, so its
;; presence rejects the loop. Every indexed access built from this counter was
;; therefore already proven in range, which bounds the exit test's `bound` by
;; the element count of the SAME allocation the pointer walks, and
;; `p0 + (bound - seed) * K` is then at most one past that allocation's last
;; element. Addresses stay below 2^47 on both supported targets, so the
;; rewritten compare keeps the original signed i64 predicate and remains
;; order-equivalent to the index compare it replaces.
;;
;; Pipeline position: after bce_version and unroll. Both key their own rewrites
;; on the counter phi -- the per-edge bounds proofs read the counter's seed and
;; step, and the counted-loop unroll shape matches on the counter's phi/next
;; pair -- so retiring it before them would silently remove their input.
;; Running here leaves both untouched and hands the retired form to
;; affine-fold/GVN and the backend.
(defenum OptLftrMaybeInstr
  (No)
  (Some ir.CompilerIrInstr))

;; Counter phi var, `i + 1` destination var, the phi's latch-input var (equal
;; to the increment when SSA renaming left no copy hop), constant seed.
(defenum OptLftrCounter
  (Counter i64 i64 i64 i64))

(defenum OptLftrMaybeCounter
  (No)
  (Some OptLftrCounter))

;; Pointer phi var, its preheader seed var, the latch `gep phi, K` destination
;; var, the gep's element type, the element step K, and that gep's index inside
;; the latch block (form B needs the step to precede the compare).
(defenum OptLftrPointer
  (Pointer i64 i64 i64 ast.AstType i64 i64))

(defenum OptLftrMaybePointer
  (No)
  (Some OptLftrPointer))

;; Compare destination, operand type, compare op, bound value, and whether the
;; compare reads the increment (form B) instead of the phi (form A).
(defenum OptLftrTest
  (Test i64 ast.AstType ir.CompilerIrBinOp ir.CompilerIrValue bool))

(defenum OptLftrMaybeTestSite
  (No)
  ;; test, the block label holding it, its index inside that block
  (Some OptLftrTest i64 i64))

;; Kill count, kill vars, rewritten compare destination, rewritten compare,
;; preheader label, preheader instructions, new frame.
(defenum OptLftrPlan
  (Plan
    i64
    (__tl_dyn-array i64)
    i64
    ir.CompilerIrInstr
    i64
    ir.CompilerIrInstrList
    i64))

(defenum OptLftrMaybePlan
  (No)
  (Some OptLftrPlan))

(defenum OptLftrApplyResult
  (Result ir.CompilerIrBlockList i64 bool))

;; Retiring the counter deletes its phi, its increment, its copy hop, and any
;; already-dead readers. Three fixed slots plus a small dead-reader budget keeps
;; the census bounded; a loop with more dead readers than this is left alone.
(define (opt-lftr-kill-cap) : i64
  8)

(define (opt-lftr-kill-fixed) : i64
  3)

(define (opt-lftr-plan-frame [plan : OptLftrPlan]) : i64
  (match plan
    [(OptLftrPlan.Plan _ _ _ _ _ _ frame) frame]))

(define (opt-lftr-def-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptLftrMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptLftrMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst var)
            (OptLftrMaybeInstr.Some instr)
            (opt-lftr-def-instr-seq-from instrs (+ index 1) var))]
        [(option_i64.None) (opt-lftr-def-instr-seq-from instrs (+ index 1) var)]))))

(define (opt-lftr-def-instr-blocks
  [blocks : ir.CompilerIrBlockList]
  [var : i64]) : OptLftrMaybeInstr
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptLftrMaybeInstr.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-lftr-def-instr-seq-from instrs 0 var)
            [(OptLftrMaybeInstr.Some instr) (OptLftrMaybeInstr.Some instr)]
            [(OptLftrMaybeInstr.No)
              (opt-lftr-def-instr-blocks (__tl-box-place rest) var)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-lftr-def-instr-blocks (ir.compiler-ir-block-seq-to-list seq) var)]))

;; The index of `var`'s definition inside one block, or -1 when it is not
;; defined there.
(define (opt-lftr-def-index-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some dst)
        (if (= dst var)
          index
          (opt-lftr-def-index-seq-from instrs (+ index 1) var))]
      [(option_i64.None) (opt-lftr-def-index-seq-from instrs (+ index 1) var)])))

(define (opt-lftr-value-is-var? [value : ir.CompilerIrValue] [var : i64]) : bool
  (match value
    [(ir.CompilerIrValue.Var id) (= id var)]
    [_ false]))

;; `i + 1` in either operand order.
(define (opt-lftr-unit-increment? [instr : ir.CompilerIrInstr] [phi-var : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (and
        (opt-induction-i64-type? ty)
        (match op
          [(ir.CompilerIrBinOp.Add) true]
          [_ false])
        (if (opt-lftr-value-is-var? lhs phi-var)
          (match rhs
            [(ir.CompilerIrValue.I64 step) (= step 1)]
            [_ false])
          (and
            (opt-lftr-value-is-var? rhs phi-var)
            (match lhs
              [(ir.CompilerIrValue.I64 step) (= step 1)]
              [_ false]))))]
    [_ false]))

;; The source var of `dst = mov src`, or -1.
(define (opt-lftr-mov-source [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Mov _ src ty)
      (if (opt-induction-i64-type? ty)
        (match src
          [(ir.CompilerIrValue.Var var) var]
          [_ (- 0 1)])
        (- 0 1))]
    [_ (- 0 1)]))

;; The phi's latch input is either the increment itself or a single copy hop
;; away from it. Deeper chains are rejected: the retirement deletes every
;; instruction it names, so the named set has to be closed.
(define (opt-lftr-counter-resolve
  [body-blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [seed : i64]
  [back : i64]) : OptLftrMaybeCounter
  (match (opt-lftr-def-instr-blocks body-blocks back)
    [(OptLftrMaybeInstr.No) (OptLftrMaybeCounter.No)]
    [(OptLftrMaybeInstr.Some instr)
      (if (opt-lftr-unit-increment? instr phi-var)
        (OptLftrMaybeCounter.Some
          (OptLftrCounter.Counter phi-var back back seed))
        (let
          [source : i64 (opt-lftr-mov-source instr)]
          (if (< source 0)
            (OptLftrMaybeCounter.No)
            (match (opt-lftr-def-instr-blocks body-blocks source)
              [(OptLftrMaybeInstr.No) (OptLftrMaybeCounter.No)]
              [(OptLftrMaybeInstr.Some source-instr)
                (if (opt-lftr-unit-increment? source-instr phi-var)
                  (OptLftrMaybeCounter.Some
                    (OptLftrCounter.Counter phi-var source back seed))
                  (OptLftrMaybeCounter.No))]))))]))

(define (opt-lftr-counter-from-phi
  [body-blocks : ir.CompilerIrBlockList]
  [preheader : i64]
  [latch : i64]
  [instr : ir.CompilerIrInstr]) : OptLftrMaybeCounter
  (match instr
    [(ir.CompilerIrInstr.Phi phi-var inputs ty)
      (if (opt-induction-i64-type? ty)
        (match (opt-induction-phi-inputs inputs preheader latch)
          [(OptInductionPhiInputs.Some start back)
            (match start
              [(ir.CompilerIrValue.I64 seed)
                (if (opt-induction-small-const? seed)
                  (opt-lftr-counter-resolve body-blocks phi-var seed back)
                  (OptLftrMaybeCounter.No))]
              [_ (OptLftrMaybeCounter.No)])]
          [(OptInductionPhiInputs.No) (OptLftrMaybeCounter.No)])
        (OptLftrMaybeCounter.No))]
    [_ (OptLftrMaybeCounter.No)]))

(define (opt-lftr-find-counter-seq-from
  [body-blocks : ir.CompilerIrBlockList]
  [preheader : i64]
  [latch : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptLftrMaybeCounter
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptLftrMaybeCounter.No)
    (match (opt-lftr-counter-from-phi
      body-blocks
      preheader
      latch
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptLftrMaybeCounter.Some counter) (OptLftrMaybeCounter.Some counter)]
      [(OptLftrMaybeCounter.No)
        (opt-lftr-find-counter-seq-from
          body-blocks
          preheader
          latch
          instrs
          (+ index 1))])))

;; A pointer induction phi of the same loop: seeded from the preheader and
;; advanced by a constant, strictly positive element step in the latch.
(define (opt-lftr-pointer-from-phi
  [type-segment-bases : i64]
  [latch-instrs : ir.CompilerIrInstrSeq]
  [preheader : i64]
  [latch : i64]
  [counter-phi : i64]
  [instr : ir.CompilerIrInstr]) : OptLftrMaybePointer
  (match instr
    [(ir.CompilerIrInstr.Phi phi-var inputs ty)
      (if (and (not (= phi-var counter-phi)) (opt-induction-i64-type? ty))
        (match (opt-induction-phi-inputs inputs preheader latch)
          [(OptInductionPhiInputs.Some start next-var)
            (match start
              [(ir.CompilerIrValue.Var seed-var)
                (let
                  [step-index : i64
                    (opt-lftr-def-index-seq-from latch-instrs 0 next-var)]
                  (if (< step-index 0)
                    (OptLftrMaybePointer.No)
                    (match (ir.compiler-ir-instr-seq-ref
                      latch-instrs
                      step-index)
                      [(ir.CompilerIrInstr.Gep _ base offset gep-ty)
                        (if (opt-lftr-value-is-var? base phi-var)
                          (match offset
                            [(ir.CompilerIrValue.I64 step)
                              (if (and
                                (> step 0)
                                (opt-induction-small-const? step)
                                (>
                                  (opt-load-loc-type-size
                                    type-segment-bases
                                    gep-ty)
                                  0))
                                (OptLftrMaybePointer.Some
                                  (OptLftrPointer.Pointer
                                    phi-var
                                    seed-var
                                    next-var
                                    gep-ty
                                    step
                                    step-index))
                                (OptLftrMaybePointer.No))]
                            [_ (OptLftrMaybePointer.No)])
                          (OptLftrMaybePointer.No))]
                      [_ (OptLftrMaybePointer.No)])))]
              [_ (OptLftrMaybePointer.No)])]
          [(OptInductionPhiInputs.No) (OptLftrMaybePointer.No)])
        (OptLftrMaybePointer.No))]
    [_ (OptLftrMaybePointer.No)]))

(define (opt-lftr-find-pointer-seq-from
  [type-segment-bases : i64]
  [latch-instrs : ir.CompilerIrInstrSeq]
  [preheader : i64]
  [latch : i64]
  [counter-phi : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptLftrMaybePointer
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptLftrMaybePointer.No)
    (match (opt-lftr-pointer-from-phi
      type-segment-bases
      latch-instrs
      preheader
      latch
      counter-phi
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptLftrMaybePointer.Some pointer) (OptLftrMaybePointer.Some pointer)]
      [(OptLftrMaybePointer.No)
        (opt-lftr-find-pointer-seq-from
          type-segment-bases
          latch-instrs
          preheader
          latch
          counter-phi
          instrs
          (+ index 1))])))

;; Only the two ordering predicates that a strictly increasing index-to-address
;; map preserves in both directions are admitted here.
(define (opt-lftr-order-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Lt) true]
    [(ir.CompilerIrBinOp.Le) true]
    [_ false]))

;; The bound is re-used as an operand of the preheader's end-address
;; arithmetic, so only the scalar forms that arithmetic accepts qualify.
(define (opt-lftr-bound-value? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Var _) true]
    [_ false]))

(define (opt-lftr-test-from-instr
  [loop-defs : opt_i64_i64_map.Map]
  [phi-var : i64]
  [next-var : i64]
  [instr : ir.CompilerIrInstr]) : OptLftrMaybeTestSite
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (and
        (opt-induction-i64-type? ty)
        (opt-lftr-order-op? op)
        (opt-lftr-bound-value? rhs)
        (opt-induction-value-base-invariant? loop-defs rhs))
        (if (opt-lftr-value-is-var? lhs phi-var)
          (OptLftrMaybeTestSite.Some (OptLftrTest.Test dst ty op rhs false) 0 0)
          (if (opt-lftr-value-is-var? lhs next-var)
            (OptLftrMaybeTestSite.Some
              (OptLftrTest.Test dst ty op rhs true)
              0
              0)
            (OptLftrMaybeTestSite.No)))
        (OptLftrMaybeTestSite.No))]
    [_ (OptLftrMaybeTestSite.No)]))

(define (opt-lftr-find-test-seq-from
  [loop-defs : opt_i64_i64_map.Map]
  [phi-var : i64]
  [next-var : i64]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptLftrMaybeTestSite
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptLftrMaybeTestSite.No)
    (match (opt-lftr-test-from-instr
      loop-defs
      phi-var
      next-var
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptLftrMaybeTestSite.Some test _ _)
        (OptLftrMaybeTestSite.Some test label index)]
      [(OptLftrMaybeTestSite.No)
        (opt-lftr-find-test-seq-from
          loop-defs
          phi-var
          next-var
          label
          instrs
          (+ index 1))])))

(define (opt-lftr-find-test-blocks
  [loop-defs : opt_i64_i64_map.Map]
  [phi-var : i64]
  [next-var : i64]
  [blocks : ir.CompilerIrBlockList]) : OptLftrMaybeTestSite
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptLftrMaybeTestSite.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (match (opt-lftr-find-test-seq-from
            loop-defs
            phi-var
            next-var
            label
            instrs
            0)
            [(OptLftrMaybeTestSite.Some test site-label site-index)
              (OptLftrMaybeTestSite.Some test site-label site-index)]
            [(OptLftrMaybeTestSite.No)
              (opt-lftr-find-test-blocks
                loop-defs
                phi-var
                next-var
                (__tl-box-place rest))])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-lftr-find-test-blocks
        loop-defs
        phi-var
        next-var
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Pure, destination-only instructions whose result is unused: the census may
;; treat these as non-uses because the retirement deletes them too.
(define (opt-lftr-dead-removable?
  [uses : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) (not (opt-used-array-contains uses dst))]
    [(ir.CompilerIrInstr.Cast dst _ _ _)
      (not (opt-used-array-contains uses dst))]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _)
      (not (opt-used-array-contains uses dst))]
    [(ir.CompilerIrInstr.Gep dst _ _ _)
      (not (opt-used-array-contains uses dst))]
    [(ir.CompilerIrInstr.BinOp dst op _ _ _)
      (and (not (opt-binop-traps? op)) (not (opt-used-array-contains uses dst)))]
    [(ir.CompilerIrInstr.UnOp dst _ _ _)
      (not (opt-used-array-contains uses dst))]
    [_ false]))

(define (opt-lftr-in-kills-from?
  [kills : (__tl_dyn-array i64)]
  [count : i64]
  [index : i64]
  [var : i64]) : bool
  (if (>= index count)
    false
    (if (= (array-ref kills index) var)
      true
      (opt-lftr-in-kills-from? kills count (+ index 1) var))))

(define (opt-lftr-in-kills? [plan : OptLftrPlan] [var : i64]) : bool
  (match plan
    [(OptLftrPlan.Plan count kills _ _ _ _ _)
      (opt-lftr-in-kills-from? kills count 0 var)]))

;; The scratch array accumulates per-instruction use counts monotonically, so a
;; strict increase on any of the three retiring vars identifies the instruction
;; as a reader without a per-instruction map allocation.
(define (opt-lftr-reads-kill?
  [scratch : (__tl_dyn-array i64)]
  [kills : (__tl_dyn-array i64)]
  [before-phi : i64]
  [before-next : i64]
  [before-back : i64]) : bool
  (or
    (> (array-ref scratch (array-ref kills 0)) before-phi)
    (> (array-ref scratch (array-ref kills 1)) before-next)
    (> (array-ref scratch (array-ref kills 2)) before-back)))

(define (opt-lftr-census-instr
  [uses : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [kills : (__tl_dyn-array i64)]
  [count : (__tl_dyn-array i64)]
  [compare-dst : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (let
    [before-phi : i64 (array-ref scratch (array-ref kills 0))]
    [before-next : i64 (array-ref scratch (array-ref kills 1))]
    [before-back : i64 (array-ref scratch (array-ref kills 2))]
    [_collect : unit (opt-collect-instr-uses-array scratch instr)]
    (if (not
      (opt-lftr-reads-kill? scratch kills before-phi before-next before-back))
      true
      (match (opt-instr-def-var instr)
        [(option_i64.None) false]
        [(option_i64.Some dst)
          (cond
            [(opt-lftr-in-kills-from? kills (opt-lftr-kill-fixed) 0 dst) true]
            [(= dst compare-dst) true]
            [(and
                (opt-lftr-dead-removable? uses instr)
                (< (array-ref count 0) (opt-lftr-kill-cap)))
              (begin
                (set! (array-ref kills (array-ref count 0)) dst)
                (set! (array-ref count 0) (+ (array-ref count 0) 1))
                true)]
            [else false])]))))

(define (opt-lftr-census-seq-from
  [uses : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [kills : (__tl_dyn-array i64)]
  [count : (__tl_dyn-array i64)]
  [compare-dst : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-lftr-census-instr
        uses
        scratch
        kills
        count
        compare-dst
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-lftr-census-seq-from
        uses
        scratch
        kills
        count
        compare-dst
        instrs
        (+ index 1)))))

(define (opt-lftr-census-blocks
  [uses : (__tl_dyn-array i64)]
  [scratch : (__tl_dyn-array i64)]
  [kills : (__tl_dyn-array i64)]
  [count : (__tl_dyn-array i64)]
  [compare-dst : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-lftr-census-seq-from
              uses
              scratch
              kills
              count
              compare-dst
              instrs
              0)
            (opt-lftr-census-blocks
              uses
              scratch
              kills
              count
              compare-dst
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-lftr-census-blocks
        uses
        scratch
        kills
        count
        compare-dst
        (ir.compiler-ir-block-seq-to-list seq))]))

;; `end = p0 + (bound - seed) * K` elements. A literal bound folds to a single
;; gep; a variable bound pays the subtract only for a nonzero seed and the
;; multiply only for a multi-element step.
(define (opt-lftr-end-instrs
  [pointer : OptLftrPointer]
  [seed : i64]
  [bound : ir.CompilerIrValue]
  [frame : i64]) : ir.CompilerIrInstrList
  (match pointer
    [(OptLftrPointer.Pointer _ seed-var _ gep-ty step _)
      (let
        [sub-var : i64 frame]
        [mul-var : i64 (+ frame 1)]
        [end-var : i64 (+ frame 2)]
        (match bound
          [(ir.CompilerIrValue.I64 limit)
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Gep
                end-var
                (ir.CompilerIrValue.Var seed-var)
                (ir.CompilerIrValue.I64 (* (- limit seed) step))
                gep-ty)
              (ir.CompilerIrInstrList.Nil))]
          [_
            (let
              [offset-instrs : ir.CompilerIrInstrList
                (if (= seed 0)
                  (ir.CompilerIrInstrList.Nil)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      sub-var
                      (ir.CompilerIrBinOp.Sub)
                      bound
                      (ir.CompilerIrValue.I64 seed)
                      (ast.AstType.I64))
                    (ir.CompilerIrInstrList.Nil)))]
              [offset-value : ir.CompilerIrValue
                (if (= seed 0)
                  bound
                  (ir.CompilerIrValue.Var sub-var))]
              [scaled-instrs : ir.CompilerIrInstrList
                (if (= step 1)
                  offset-instrs
                  (opt-aggregate-instr-list-append
                    offset-instrs
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BinOp
                        mul-var
                        (ir.CompilerIrBinOp.Mul)
                        offset-value
                        (ir.CompilerIrValue.I64 step)
                        (ast.AstType.I64))
                      (ir.CompilerIrInstrList.Nil))))]
              [scaled-value : ir.CompilerIrValue
                (if (= step 1)
                  offset-value
                  (ir.CompilerIrValue.Var mul-var))]
              (opt-aggregate-instr-list-append
                scaled-instrs
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Gep
                    end-var
                    (ir.CompilerIrValue.Var seed-var)
                    scaled-value
                    gep-ty)
                  (ir.CompilerIrInstrList.Nil))))]))]))

;; A literal bound is materialised as one folded gep displacement, so keep the
;; folded product inside the pass's ordinary small-constant window.
(define (opt-lftr-literal-bound-ok?
  [seed : i64]
  [step : i64]
  [bound : ir.CompilerIrValue]) : bool
  (match bound
    [(ir.CompilerIrValue.I64 limit)
      (and
        (opt-induction-small-const? limit)
        (opt-induction-small-const? (* (- limit seed) step)))]
    [_ true]))

;; The census indexes its use arrays by the retiring vars directly, so a var id
;; outside the function's frame would read past them. Frames are authoritative
;; for well-formed IR; this keeps a malformed one fail-closed instead of
;; trapping.
(define (opt-lftr-frame-var? [frame : i64] [var : i64]) : bool
  (and (>= var 0) (< var frame)))

(define (opt-lftr-build-plan
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [preheader : i64]
  [counter : OptLftrCounter]
  [pointer : OptLftrPointer]
  [test : OptLftrTest]) : OptLftrMaybePlan
  (match counter
    [(OptLftrCounter.Counter phi-var next-var back-var seed)
      (match pointer
        [(OptLftrPointer.Pointer pointer-phi _ pointer-next _ step _)
          (match test
            [(OptLftrTest.Test compare-dst compare-ty op bound reads-next?)
              (if (not
                (and
                  (opt-lftr-literal-bound-ok? seed step bound)
                  (opt-lftr-frame-var? frame phi-var)
                  (opt-lftr-frame-var? frame next-var)
                  (opt-lftr-frame-var? frame back-var)))
                (OptLftrMaybePlan.No)
                (let
                  [kills : (__tl_dyn-array i64)
                    (array.make-array i64 (opt-lftr-kill-cap))]
                  [count : (__tl_dyn-array i64) (array.make-array i64 1)]
                  [uses : (__tl_dyn-array i64)
                    (opt-collect-blocks-uses-array frame blocks)]
                  [scratch : (__tl_dyn-array i64) (opt-used-array-new frame)]
                  [_seed-kills : unit
                    (begin
                      (set! (array-ref kills 0) phi-var)
                      (set! (array-ref kills 1) next-var)
                      (set! (array-ref kills 2) back-var)
                      (set! (array-ref count 0) (opt-lftr-kill-fixed)))]
                  (if (not
                    (opt-lftr-census-blocks
                      uses
                      scratch
                      kills
                      count
                      compare-dst
                      blocks))
                    (OptLftrMaybePlan.No)
                    (OptLftrMaybePlan.Some
                      (OptLftrPlan.Plan
                        (array-ref count 0)
                        kills
                        compare-dst
                        (ir.CompilerIrInstr.BinOp
                          compare-dst
                          op
                          (ir.CompilerIrValue.Var
                            (if reads-next?
                              pointer-next
                              pointer-phi))
                          (ir.CompilerIrValue.Var (+ frame 2))
                          compare-ty)
                        preheader
                        (opt-lftr-end-instrs pointer seed bound frame)
                        (+ frame 3))))))])])]))

;; Form B compares the incremented counter, so the pointer's advanced value has
;; to be the one the compare reads: it must be defined in the same latch block,
;; ahead of the compare. Form A reads the header phi, which dominates the whole
;; body.
(define (opt-lftr-test-site-ok?
  [pointer : OptLftrPointer]
  [test : OptLftrTest]
  [latch : i64]
  [site-label : i64]
  [site-index : i64]) : bool
  (match test
    [(OptLftrTest.Test _ _ _ _ reads-next?)
      (if (not reads-next?)
        true
        (match pointer
          [(OptLftrPointer.Pointer _ _ _ _ _ step-index)
            (and (= site-label latch) (< step-index site-index))]))]))

(define (opt-lftr-plan
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]
  [preheader : i64]) : OptLftrMaybePlan
  (let
    [header : i64 (opt-natural-loop-header loop)]
    [latch : i64 (opt-natural-loop-latch loop)]
    (match (opt-cfg-find-block body-blocks header)
      [(OptMaybeBlock.No) (OptLftrMaybePlan.No)]
      [(OptMaybeBlock.Some header-block)
        (match (opt-cfg-find-block body-blocks latch)
          [(OptMaybeBlock.No) (OptLftrMaybePlan.No)]
          [(OptMaybeBlock.Some latch-block)
            (match header-block
              [(ir.CompilerIrBlock.Block _ header-instrs)
                (match latch-block
                  [(ir.CompilerIrBlock.Block _ latch-instrs)
                    (match (opt-lftr-find-counter-seq-from
                      body-blocks
                      preheader
                      latch
                      header-instrs
                      0)
                      [(OptLftrMaybeCounter.No) (OptLftrMaybePlan.No)]
                      [(OptLftrMaybeCounter.Some counter)
                        (match counter
                          [(OptLftrCounter.Counter phi-var next-var _ _)
                            (match (opt-lftr-find-pointer-seq-from
                              type-segment-bases
                              latch-instrs
                              preheader
                              latch
                              phi-var
                              header-instrs
                              0)
                              [(OptLftrMaybePointer.No) (OptLftrMaybePlan.No)]
                              [(OptLftrMaybePointer.Some pointer)
                                (match (opt-lftr-find-test-blocks
                                  (opt-licm-collect-defs-blocks
                                    body-blocks
                                    (opt_i64_i64_map.with-capacity
                                      (opt-licm-body-map-capacity body-blocks)))
                                  phi-var
                                  next-var
                                  body-blocks)
                                  [(OptLftrMaybeTestSite.No)
                                    (OptLftrMaybePlan.No)]
                                  [(OptLftrMaybeTestSite.Some
                                      test
                                      site-label
                                      site-index)
                                    (if (opt-lftr-test-site-ok?
                                      pointer
                                      test
                                      latch
                                      site-label
                                      site-index)
                                      (opt-lftr-build-plan
                                        blocks
                                        frame
                                        preheader
                                        counter
                                        pointer
                                        test)
                                      (OptLftrMaybePlan.No))])])])])])])])])))

(define (opt-lftr-rewrite-instr
  [plan : OptLftrPlan]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match plan
    [(OptLftrPlan.Plan _ _ compare-dst compare _ _ _)
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst compare-dst)
            compare
            instr)]
        [(option_i64.None) instr])]))

(define (opt-lftr-rewrite-instr-seq-from
  [plan : OptLftrPlan]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      [rest : ir.CompilerIrInstrList
        (opt-lftr-rewrite-instr-seq-from plan instrs (+ index 1))]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (opt-lftr-in-kills? plan dst)
            rest
            (ir.compiler-ir-instr-cons (opt-lftr-rewrite-instr plan instr) rest))]
        [(option_i64.None) (ir.compiler-ir-instr-cons instr rest)]))))

(define (opt-lftr-rewrite-blocks
  [plan : OptLftrPlan]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (match plan
            [(OptLftrPlan.Plan _ _ _ _ preheader end-instrs _)
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block
                  label
                  (if (= label preheader)
                    (opt-licm-insert-before-terminator
                      end-instrs
                      (opt-lftr-rewrite-instr-seq-from plan instrs 0))
                    (opt-lftr-rewrite-instr-seq-from plan instrs 0)))
                (opt-lftr-rewrite-blocks plan (__tl-box-place rest)))])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-lftr-rewrite-blocks plan (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-lftr-apply-loop
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptLftrApplyResult
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.No) (OptLftrApplyResult.Result blocks frame false)]
    [(OptLoopPreheader.Some preheader)
      (let
        [body-blocks : ir.CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        ;; Same fail-closed body gate the induction slice uses: the retirement
        ;; keeps a loop-live `end` where the counter used to be, so the loops
        ;; whose recurrences that pass declines are declined here too.
        (if (opt-induction-loop-blocked? body-blocks)
          (OptLftrApplyResult.Result blocks frame false)
          (match (opt-lftr-plan
            type-segment-bases
            blocks
            body-blocks
            frame
            loop
            preheader)
            [(OptLftrMaybePlan.No)
              (OptLftrApplyResult.Result blocks frame false)]
            [(OptLftrMaybePlan.Some plan)
              (OptLftrApplyResult.Result
                (opt-lftr-rewrite-blocks plan blocks)
                (opt-lftr-plan-frame plan)
                true)])))]))

(define (opt-lftr-apply-loops
  [type-segment-bases : i64]
  [loops : OptNaturalLoopList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [changed : bool]) : OptLftrApplyResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptLftrApplyResult.Result blocks frame changed)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-lftr-apply-loop type-segment-bases blocks frame loop)
        [(OptLftrApplyResult.Result next-blocks next-frame loop-changed)
          (opt-lftr-apply-loops
            type-segment-bases
            (__tl-box-place rest)
            next-blocks
            next-frame
            (or changed loop-changed))])]))

(define (opt-lftr-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-lftr-apply-loops
            type-segment-bases
            (opt-cfg-natural-loops-with-context blocks context)
            blocks
            frame
            false)
            [(OptLftrApplyResult.Result next-blocks next-frame changed)
              (if (not changed)
                (OptFunctionCtxResult.Result func context)
                (let
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      next-frame
                      next-blocks)]
                  ;; The rewrite only edits instructions, but the deleted phi
                  ;; changes the header's phi prefix, so build one fresh context
                  ;; for the rewritten blocks, reuse it for the post-pass
                  ;; verify, and hand it to the next pass.
                  [next-context : OptCfgContext
                    (opt-cfg-context-build next-blocks)]
                  (match (opt-verify-function-with-context next next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionCtxResult.Result next next-context)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionCtxResult.Result func context)])))])])]))

(define (opt-lftr-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-lftr-function-with-context-result
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; Branch folding can leave both source blocks reachable while removing only
;; one source-to-phi edge. Filter against the destination's actual reachable
;; predecessor set, not global reachability alone, so neither stale edges from
;; reachable blocks nor edges from unreachable blocks survive CFG cleanup.
(define (opt-cfg-filter-phi-inputs
  [index : OptCfgIndex]
  [block-id : i64]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-cfg-filter-phi-inputs
        index
        block-id
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-cfg-index-reachable-predecessor? index block-id label)
        (ir.compiler-ir-phi-input-cons
          value
          label
          (opt-cfg-filter-phi-inputs index block-id (__tl-box-place rest)))
        (opt-cfg-filter-phi-inputs index block-id (__tl-box-place rest)))]))

(define (opt-phi-input-count [inputs : ir.CompilerIrPhiInputList]) : i64
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) 0]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-phi-input-count (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons _ _ rest)
      (+ 1 (opt-phi-input-count (__tl-box-place rest)))]))

(define (opt-phi-single-value [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrMaybeValue
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-phi-single-value (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (match (ir.compiler-ir-phi-input-list-force-cons (__tl-box-place rest))
        [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrMaybeValue.Some value)]
        [(ir.CompilerIrPhiInputList.Array seq)
          (if (= seq.len 0)
            (ir.CompilerIrMaybeValue.Some value)
            (ir.CompilerIrMaybeValue.No))]
        [_ (ir.CompilerIrMaybeValue.No)])]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-cfg-clean-instr
  [index : OptCfgIndex]
  [block-id : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (let
        [kept : ir.CompilerIrPhiInputList
          (opt-cfg-filter-phi-inputs index block-id inputs)]
        (if (= (opt-phi-input-count kept) 1)
          (match (opt-phi-single-value kept)
            [(ir.CompilerIrMaybeValue.Some value)
              (if (opt-value-is-var? value dst)
                (ir.CompilerIrInstr.Phi dst kept ty)
                (ir.CompilerIrInstr.Mov dst value ty))]
            [(ir.CompilerIrMaybeValue.No) (ir.CompilerIrInstr.Phi dst kept ty)])
          (ir.CompilerIrInstr.Phi dst kept ty)))]
    [_ instr]))

;; 1:1 rewrite -> dense output sequence (see opt-global-copy-instr-seq). refs #5726
(define (opt-cfg-clean-instr-seq
  [index : OptCfgIndex]
  [block-label : i64]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [block-id : i64
      (match (opt-cfg-index-id index block-label)
        [(option_i64.Some id) id]
        [(option_i64.None) (- 0 1)])]
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [pos : i64 0]
    (begin
      (while (< pos count)
        (begin
          (set!
            (array-ref out pos)
            (opt-cfg-clean-instr index block-id (array-ref slots pos)))
          (set! pos (+ pos 1))))
      (ir.CompilerIrInstrSeq out count))))

(define (opt-cfg-clean-block [index : OptCfgIndex] [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (opt-cfg-clean-instr-seq index label instrs))]))

(define (opt-cfg-filter-clean-blocks
  [index : OptCfgIndex]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (opt-cfg-index-reachable? index label)
            (ir.compiler-ir-block-cons
              (opt-cfg-clean-block index block)
              (opt-cfg-filter-clean-blocks index (__tl-box-place rest)))
            (opt-cfg-filter-clean-blocks index (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-cfg-filter-clean-blocks index (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-cfg-simplify-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [folded : ir.CompilerIrBlockList (opt-cfg-fold-branches-blocks blocks)]
    [index : OptCfgIndex (opt-cfg-index-build folded)]
    (opt-cfg-filter-clean-blocks index folded)))

(define (opt-cfg-clean-instr-seq-rewrite!
  [index : OptCfgIndex]
  [block-label : i64]
  [used : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [block-id : i64
      (match (opt-cfg-index-id index block-label)
        [(option_i64.Some id) id]
        [(option_i64.None) (- 0 1)])]
    [pos : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (while (< pos count)
      (let
        [cleaned : ir.CompilerIrInstr
          (opt-cfg-clean-instr
            index
            block-id
            (ir.compiler-ir-instr-seq-ref instrs pos))]
        (begin
          (ir.compiler-ir-instr-seq-set! instrs pos cleaned)
          (opt-collect-instr-uses-array used cleaned)
          (set! pos (+ pos 1)))))))

(define (opt-cfg-filter-clean-block-seq-rewrite!
  [index : OptCfgIndex]
  [used : (__tl_dyn-array i64)]
  [blocks : (&mut blocks ir.CompilerIrBlockSeq)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrBlock) blocks.slots]
    [reachable : (__tl_dyn-array bool) index.reachable]
    [count : i64 blocks.len]
    [read : i64 0]
    [write : i64 0]
    (begin
      (while (< read count)
        (begin
          (if (array-ref reachable read)
            (let
              [block : ir.CompilerIrBlock (clone (array-ref slots read))]
              (begin
                (match block
                  [(ir.CompilerIrBlock.Block label instrs)
                    (opt-cfg-clean-instr-seq-rewrite! index label used instrs)])
                ;; `block` is a private aggregate clone. Write it back even when
                ;; compaction keeps the same slot so phi cleanup is observable.
                (set! (array-ref slots write) block)
                (set! write (+ write 1))))
            unit)
          (set! read (+ read 1))))
      (set! blocks.len write))))

;; Level 1 owns its post-fold block/instruction arrays in the per-function
;; scratch arena. Keep that representation through CFG cleanup: fold branches
;; and phis in place, compact unreachable blocks in the outer sequence, and let
;; the final DCE+escape traversal clone only the live result.
(define (opt-cfg-simplify-blocks-in-place
  [blocks : ir.CompilerIrBlockList]
  [used : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (let
    [folded : ir.CompilerIrBlockList (ir.compiler-ir-block-list-compact blocks)]
    (begin
      (opt-cfg-fold-branches-blocks-rewrite! folded)
      (let
        [index : OptCfgIndex (opt-cfg-index-build folded)]
        (begin
          (match folded
            [(ir.CompilerIrBlockList.Array seq)
              (begin
                (opt-cfg-filter-clean-block-seq-rewrite! index used (&mut seq))
                ;; The pattern binding is a private aggregate value. Rebuild the
                ;; outer enum so the compacted sequence length is retained.
                (set! folded (ir.CompilerIrBlockList.Array seq)))]
            [_ unit])
          folded)))))

(define (opt-cfg-simplify-blocks-with-context-result
  [input : OptBlockCtxResult]) : OptBlockCtxResult
  (match input
    [(OptBlockCtxResult.Result blocks context context-valid)
      (if (and
        context-valid
        (not (opt-cfg-blocks-have-foldable-branch? blocks))
        (opt-cfg-context-all-blocks-reachable? context))
        (OptBlockCtxResult.Result
          (opt-cfg-filter-clean-blocks context.index blocks)
          context
          true)
        (let
          [simplified : ir.CompilerIrBlockList (opt-cfg-simplify-blocks blocks)]
          (OptBlockCtxResult.Result
            simplified
            (opt-cfg-context-build simplified)
            true)))]))

;; A short-circuit boolean lowered as `(if c1 c2 false)` has this late SSA
;; shape after inlining and scalar cleanup:
;;
;;   left:  %cmp = compare ...; jump merge
;;   right: jump merge
;;   merge: %cond = phi [%cmp, left], [false, right]; branch %cond, yes, no
;;
;; Materializing both comparison and phi booleans makes the backend emit
;; setcc/movzbq/test. Redirect the two predecessor jumps to the final branch
;; targets instead. The variable arm is accepted only when its value is the
;; immediately preceding pure scalar comparison; calls, loads, and other
;; potentially effectful condition producers stay untouched. A match whose arms
;; all return literal booleans produces the simpler `%cond = phi [true/false,
;; pred]` form. Thread every such predecessor directly to the selected final
;; target, expanding any successor-phi input from the merge block over the
;; redirected predecessors. Both forms require the phi result to have no use
;; beyond the branch; blocks with any other instruction (including another phi)
;; stay untouched.
(defenum OptBoolBranchDef
  (No)
  (Some ir.CompilerIrInstr i64))

(defenum OptBoolBranchConjBuild
  (No)
  (Some ir.CompilerIrInstrList))

(defenum OptBoolBranchChainRewrite
  (No)
  (Some ir.CompilerIrBlockList i64))

(defenum OptBoolBranchChainResult
  (Result ir.CompilerIrBlockList i64 bool))

(defenum OptBoolBranchPhiInputs
  (No)
  (Two ir.CompilerIrValue i64 ir.CompilerIrValue i64))

(defenum OptBoolBranchConstantInputs
  (No)
  (Some OptLabelSet OptLabelSet i64))

(defenum OptBoolBranchPredRewrite
  (No)
  (Some ir.CompilerIrInstrSeq i64 ir.CompilerIrInstr bool))

;; Where the branch that consumes a merge phi actually lives: the block holding
;; it, the variable it tests, and its two successors. The block is the phi's own
;; block in the shape the fuser was written for, and some later block reached
;; through pure fallthrough in the shape `opt-bool-branch-resolve-branch-site`
;; recovers.
(defenum OptBoolBranchBranchSite
  (No)
  (Some i64 i64 i64 i64))

(define (opt-bool-branch-compare-op? [op : ir.CompilerIrBinOp]) : bool
  (ir.compiler-ir-binop-compare? op))

(define (opt-bool-branch-use-count [uses : (__tl_dyn-array i64)] [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length uses)))
    0
    (array-ref uses var)))

;; A materialized boolean And tree feeding one Branch is the same late
;; opportunity as the phi threading below, but it needs real short-circuit CFG
;; edges rather than predecessor retargeting:
;;
;;   %a = compare ...
;;   %b = compare ...
;;   %ab = and %a, %b
;;   branch %ab, yes, no
;;
;; becomes `compare; branch` in the source block followed by one fresh block per
;; remaining conjunct. And results must have no uses outside the condition DAG.
;; A comparison leaf may also feed another branch (BCE guards commonly share
;; the loop-entry compare after GVN); clone that pure compare into the chain so
;; both uses become single-use compare/branch pairs. Repeated leaves are emitted
;; once, folding the compiler-generated `x && y && y` guard shape as part of the
;; rewrite. Or is deliberately not admitted in this first cut.
(define (opt-bool-branch-defs-fill-instrs!
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (begin
        (match instr
          [(ir.CompilerIrInstr.BinOp dst _ _ _ _)
            (if (and (>= dst 0) (< dst (array-length defs)))
              (set! (array-ref defs dst) (OptBoolBranchDef.Some instr label))
              unit)]
          [_ unit])
        (opt-bool-branch-defs-fill-instrs! defs label instrs (+ index 1))))))

(define (opt-bool-branch-defs-fill-blocks!
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (opt-bool-branch-defs-fill-instrs! defs label instrs 0)])
        (opt-bool-branch-defs-fill-blocks! defs (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-defs-fill-blocks!
        defs
        (ir.compiler-ir-block-seq-to-list seq))]))

;; `OptBoolBranchDef.No` is the fieldless tag-0 variant, so its representation is
;; all-zero bytes and `make-array` already produces it for every slot -- see
;; `lower-make-array-zero-fill-enum-supported?`, which admits exactly the enums
;; whose first variant carries no fields. Every `(Array E)` in this file built
;; by `make-array` for such an `E` therefore starts out uniformly tag-0, and a
;; pass that writes that same variant over the whole array is a pure repeat of
;; the allocation's own fill.
(define (opt-bool-branch-defs [frame : i64] [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array
    OptBoolBranchDef)
  (let
    [defs : (__tl_dyn-array OptBoolBranchDef)
      (array.make-array OptBoolBranchDef frame)]
    (begin
      (opt-bool-branch-defs-fill-blocks! defs blocks)
      defs)))

(define (opt-bool-branch-def
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [var : i64]) : OptBoolBranchDef
  (if (and (>= var 0) (< var (array-length defs)))
    (array-ref defs var)
    (OptBoolBranchDef.No)))

(define (opt-bool-branch-chain-note-ref!
  [refs : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length refs)))
    false
    (begin
      (set! (array-ref refs var) (+ (array-ref refs var) 1))
      true)))

(define (opt-bool-branch-chain-collect-value!
  [type-segment-bases : i64]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [refs : (__tl_dyn-array i64)]
  [visited : (__tl_dyn-array bool)]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (and
        (opt-bool-branch-chain-note-ref! refs var)
        (if (array-ref visited var)
          true
          (begin
            (set! (array-ref visited var) true)
            (match (opt-bool-branch-def defs var)
              [(OptBoolBranchDef.No) false]
              [(OptBoolBranchDef.Some instr _)
                (match instr
                  [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
                    (if (not (= dst var))
                      false
                      (match op
                        [(ir.CompilerIrBinOp.And)
                          (and
                            (opt-type-eq
                              type-segment-bases
                              ty
                              (ast.AstType.Bool))
                            (opt-bool-branch-chain-collect-value!
                              type-segment-bases
                              defs
                              refs
                              visited
                              lhs)
                            (opt-bool-branch-chain-collect-value!
                              type-segment-bases
                              defs
                              refs
                              visited
                              rhs))]
                        [(ir.CompilerIrBinOp.Eq) true]
                        [(ir.CompilerIrBinOp.Ne) true]
                        [(ir.CompilerIrBinOp.Lt) true]
                        [(ir.CompilerIrBinOp.Le) true]
                        [(ir.CompilerIrBinOp.Gt) true]
                        [(ir.CompilerIrBinOp.Ge) true]
                        [_ false]))]
                  [_ false])]))))]
    [_ false]))

(define (opt-bool-branch-chain-uses-ok-from?
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [uses : (__tl_dyn-array i64)]
  [refs : (__tl_dyn-array i64)]
  [visited : (__tl_dyn-array bool)]
  [index : i64]) : bool
  (if (>= index (array-length visited))
    true
    (if (not (array-ref visited index))
      (opt-bool-branch-chain-uses-ok-from? defs uses refs visited (+ index 1))
      (match (opt-bool-branch-def defs index)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ op _ _ _)
              (and
                (match op
                  [(ir.CompilerIrBinOp.And)
                    (=
                      (opt-bool-branch-use-count uses index)
                      (array-ref refs index))]
                  [_
                    (>=
                      (opt-bool-branch-use-count uses index)
                      (array-ref refs index))])
                (opt-bool-branch-chain-uses-ok-from?
                  defs
                  uses
                  refs
                  visited
                  (+ index 1)))]
            [_ false])]))))

(define (opt-bool-branch-chain-flatten-value
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [uses : (__tl_dyn-array i64)]
  [refs : (__tl_dyn-array i64)]
  [expanded : (__tl_dyn-array bool)]
  [emitted : (__tl_dyn-array bool)]
  [remove : (__tl_dyn-array bool)]
  [source-label : i64]
  [cell : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : OptBoolBranchConjBuild
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) (OptBoolBranchConjBuild.No)]
        [(OptBoolBranchDef.Some instr def-label)
          (match instr
            [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
              (match op
                [(ir.CompilerIrBinOp.And)
                  (if (array-ref expanded var)
                    (OptBoolBranchConjBuild.Some (ir.CompilerIrInstrList.Nil))
                    (begin
                      (set! (array-ref expanded var) true)
                      (if (= def-label source-label)
                        (set! (array-ref remove dst) true)
                        unit)
                      (match (opt-bool-branch-chain-flatten-value
                        defs
                        uses
                        refs
                        expanded
                        emitted
                        remove
                        source-label
                        cell
                        lhs)
                        [(OptBoolBranchConjBuild.No)
                          (OptBoolBranchConjBuild.No)]
                        [(OptBoolBranchConjBuild.Some left)
                          (match (opt-bool-branch-chain-flatten-value
                            defs
                            uses
                            refs
                            expanded
                            emitted
                            remove
                            source-label
                            cell
                            rhs)
                            [(OptBoolBranchConjBuild.No)
                              (OptBoolBranchConjBuild.No)]
                            [(OptBoolBranchConjBuild.Some right)
                              (OptBoolBranchConjBuild.Some
                                (opt-aggregate-instr-list-append left right))])])))]
                [_
                  (if (array-ref emitted var)
                    (OptBoolBranchConjBuild.Some (ir.CompilerIrInstrList.Nil))
                    (let
                      [move? : bool
                        (and
                          (= def-label source-label)
                          (=
                            (opt-bool-branch-use-count uses var)
                            (array-ref refs var)))]
                      [next-dst : i64
                        (if move?
                          dst
                          (let
                            [fresh : i64 (array-ref cell 0)]
                            (begin
                              (set! (array-ref cell 0) (+ fresh 1))
                              fresh)))]
                      (begin
                        (set! (array-ref emitted var) true)
                        (if move?
                          (set! (array-ref remove dst) true)
                          unit)
                        (OptBoolBranchConjBuild.Some
                          (ir.compiler-ir-instr-cons
                            (ir.CompilerIrInstr.BinOp next-dst op lhs rhs ty)
                            (ir.CompilerIrInstrList.Nil))))))])]
            [_ (OptBoolBranchConjBuild.No)])])]
    [_ (OptBoolBranchConjBuild.No)]))

(define (opt-bool-branch-chain-conj-count [conjs : ir.CompilerIrInstrList]) : i64
  (match conjs
    [(ir.CompilerIrInstrList.Nil) 0]
    [(ir.CompilerIrInstrList.Cons _ rest)
      (+ 1 (opt-bool-branch-chain-conj-count (__tl-box-place rest)))]))

(define (opt-bool-branch-chain-label-candidate
  [source-label : i64]
  [suffix : i64]) : i64
  (ir.compiler-ir-label
    (str_cat.str-cat
      (ir.compiler-ir-label-text source-label)
      "__bool_and."
      (string.int->string suffix))))

(define (opt-bool-branch-chain-labels
  [blocks : ir.CompilerIrBlockList]
  [source-label : i64]
  [remaining : i64]
  [suffix : i64]
  [made : OptLabelSet]) : OptLabelSet
  (if (<= remaining 0)
    (OptLabelSet.Nil)
    (let
      [candidate : i64
        (opt-bool-branch-chain-label-candidate source-label suffix)]
      (if (or
        (opt-cfg-block-exists? blocks candidate)
        (opt-label-contains made candidate))
        (opt-bool-branch-chain-labels
          blocks
          source-label
          remaining
          (+ suffix 1)
          made)
        (opt-label-cons
          candidate
          (opt-bool-branch-chain-labels
            blocks
            source-label
            (- remaining 1)
            (+ suffix 1)
            (opt-label-add made candidate)))))))

(define (opt-bool-branch-chain-label-set
  [labels : OptLabelSet]
  [set : OptLabelSet]) : OptLabelSet
  (match labels
    [(OptLabelSet.Nil) set]
    [(OptLabelSet.Dense _ _)
      (opt-bool-branch-chain-label-set
        (opt-label-tail labels)
        (opt-label-add set (opt-label-ref labels 0)))]))

(define (opt-bool-branch-chain-last-label
  [labels : OptLabelSet]
  [fallback : i64]) : i64
  (let
    [count : i64 (opt-label-count labels)]
    (if (= count 0)
      fallback
      (opt-label-ref labels (- count 1)))))

(define (opt-bool-branch-chain-first-label
  [labels : OptLabelSet]
  [fallback : i64]) : i64
  (match labels
    [(OptLabelSet.Nil) fallback]
    [(OptLabelSet.Dense _ _) (opt-label-ref labels 0)]))

(define (opt-bool-branch-chain-prefix
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remove : (__tl_dyn-array bool)]) : ir.CompilerIrInstrList
  (if (>= index last)
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      [tail : ir.CompilerIrInstrList
        (opt-bool-branch-chain-prefix instrs (+ index 1) last remove)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (and
            (>= dst 0)
            (< dst (array-length remove))
            (array-ref remove dst))
            tail
            (ir.compiler-ir-instr-cons instr tail))]
        [(option_i64.None) (ir.compiler-ir-instr-cons instr tail)]))))

(define (opt-bool-branch-chain-conj-var [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [_ (- 0 1)]))

(define (opt-bool-branch-chain-fresh-blocks
  [conjs : ir.CompilerIrInstrList]
  [labels : OptLabelSet]
  [true-label : i64]
  [false-label : i64]) : ir.CompilerIrBlockList
  (match conjs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrInstrList.Cons conj conj-rest)
      (match labels
        [(OptLabelSet.Nil) (ir.CompilerIrBlockList.Nil)]
        [(OptLabelSet.Dense _ _)
          (let
            [label : i64 (opt-label-ref labels 0)]
            [label-rest : OptLabelSet (opt-label-tail labels)]
            [next-label : i64
              (opt-bool-branch-chain-first-label label-rest true-label)]
            (ir.compiler-ir-block-cons
              (ir.compiler-ir-block
                label
                (ir.compiler-ir-instr-cons
                  conj
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.Branch
                      (ir.CompilerIrValue.Var
                        (opt-bool-branch-chain-conj-var conj))
                      next-label
                      false-label)
                    (ir.CompilerIrInstrList.Nil))))
              (opt-bool-branch-chain-fresh-blocks
                (__tl-box-place conj-rest)
                label-rest
                true-label
                false-label)))])]))

(define (opt-bool-branch-chain-prepend-blocks
  [prefix : ir.CompilerIrBlockList]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match prefix
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        block
        (opt-bool-branch-chain-prepend-blocks (__tl-box-place rest) tail))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-prepend-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-bool-branch-chain-replace-block
  [blocks : ir.CompilerIrBlockList]
  [source-label : i64]
  [source : ir.CompilerIrBlock]
  [fresh : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (= label source-label)
            (ir.compiler-ir-block-cons
              source
              (opt-bool-branch-chain-prepend-blocks fresh (__tl-box-place rest)))
            (ir.compiler-ir-block-cons
              block
              (opt-bool-branch-chain-replace-block
                (__tl-box-place rest)
                source-label
                source
                fresh)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-replace-block
        (ir.compiler-ir-block-seq-to-list seq)
        source-label
        source
        fresh)]))

(define (opt-bool-branch-chain-phi-inputs-have-none-except?
  [inputs : ir.CompilerIrPhiInputList]
  [labels : OptLabelSet]
  [old-label : i64]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (if (= label old-label)
            true
            (not (opt-bool-branch-phi-input-has-label? inputs label)))
          (opt-bool-branch-chain-phi-inputs-have-none-except?
            inputs
            (opt-label-tail labels)
            old-label)))]))

(define (opt-bool-branch-chain-target-phis-repairable-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [old-label : i64]
  [new-preds : OptLabelSet]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (and
          (opt-bool-branch-phi-input-has-label? inputs old-label)
          (opt-bool-branch-chain-phi-inputs-have-none-except?
            inputs
            new-preds
            old-label)
          (opt-bool-branch-chain-target-phis-repairable-from?
            instrs
            (+ index 1)
            old-label
            new-preds))]
      [_ true])))

(define (opt-bool-branch-chain-target-phis-repairable?
  [blocks : ir.CompilerIrBlockList]
  [target-label : i64]
  [old-label : i64]
  [new-preds : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks target-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-chain-target-phis-repairable-from?
            instrs
            0
            old-label
            new-preds)])]))

(define (opt-bool-branch-chain-try-block
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : OptBoolBranchChainRewrite
  (match block
    [(ir.CompilerIrBlock.Block source-label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          (OptBoolBranchChainRewrite.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch
                (ir.CompilerIrValue.Var root)
                true-label
                false-label)
              (if (or (= source-label true-label) (= source-label false-label))
                (OptBoolBranchChainRewrite.No)
                (match (opt-bool-branch-def defs root)
                  [(OptBoolBranchDef.No) (OptBoolBranchChainRewrite.No)]
                  [(OptBoolBranchDef.Some root-instr _)
                    (match root-instr
                      [(ir.CompilerIrInstr.BinOp _ root-op _ _ _)
                        (let
                          [and-root? : bool
                            (match root-op
                              [(ir.CompilerIrBinOp.And) true]
                              [_ false])]
                          (if (not and-root?)
                            (OptBoolBranchChainRewrite.No)
                            (let
                              [refs : (__tl_dyn-array i64)
                                (opt-used-array-new frame)]
                              [visited : (__tl_dyn-array bool)
                                (array.make-array bool frame)]
                              [collected? : bool
                                (opt-bool-branch-chain-collect-value!
                                  type-segment-bases
                                  defs
                                  refs
                                  visited
                                  (ir.CompilerIrValue.Var root))]
                              (if (or
                                (not collected?)
                                (not
                                  (opt-bool-branch-chain-uses-ok-from?
                                    defs
                                    uses
                                    refs
                                    visited
                                    0)))
                                (OptBoolBranchChainRewrite.No)
                                (let
                                  [expanded : (__tl_dyn-array bool)
                                    (array.make-array bool frame)]
                                  [emitted : (__tl_dyn-array bool)
                                    (array.make-array bool frame)]
                                  [remove : (__tl_dyn-array bool)
                                    (array.make-array bool frame)]
                                  [cell : (__tl_dyn-array i64)
                                    (array.make-array i64 1)]
                                  [_cell : unit (set! (array-ref cell 0) frame)]
                                  [built : OptBoolBranchConjBuild
                                    (opt-bool-branch-chain-flatten-value
                                      defs
                                      uses
                                      refs
                                      expanded
                                      emitted
                                      remove
                                      source-label
                                      cell
                                      (ir.CompilerIrValue.Var root))]
                                  (match built
                                    [(OptBoolBranchConjBuild.No)
                                      (OptBoolBranchChainRewrite.No)]
                                    [(OptBoolBranchConjBuild.Some conjs)
                                      (match conjs
                                        [(ir.CompilerIrInstrList.Nil)
                                          (OptBoolBranchChainRewrite.No)]
                                        [(ir.CompilerIrInstrList.Cons
                                            first
                                            rest)
                                          (let
                                            [labels : OptLabelSet
                                              (opt-bool-branch-chain-labels
                                                blocks
                                                source-label
                                                (-
                                                  (opt-bool-branch-chain-conj-count
                                                    conjs)
                                                  1)
                                                0
                                                (OptLabelSet.Nil))]
                                            [false-preds : OptLabelSet
                                              (opt-bool-branch-chain-label-set
                                                labels
                                                (opt-label-add
                                                  (OptLabelSet.Nil)
                                                  source-label))]
                                            [true-preds : OptLabelSet
                                              (opt-label-add
                                                (OptLabelSet.Nil)
                                                (opt-bool-branch-chain-last-label
                                                  labels
                                                  source-label))]
                                            [same-target? : bool
                                              (= true-label false-label)]
                                            [all-preds : OptLabelSet
                                              (if same-target?
                                                false-preds
                                                (OptLabelSet.Nil))]
                                            (if (if same-target?
                                              (not
                                                (opt-bool-branch-chain-target-phis-repairable?
                                                  blocks
                                                  true-label
                                                  source-label
                                                  all-preds))
                                              (or
                                                (not
                                                  (opt-bool-branch-chain-target-phis-repairable?
                                                    blocks
                                                    true-label
                                                    source-label
                                                    true-preds))
                                                (not
                                                  (opt-bool-branch-chain-target-phis-repairable?
                                                    blocks
                                                    false-label
                                                    source-label
                                                    false-preds))))
                                              (OptBoolBranchChainRewrite.No)
                                              (let
                                                [source-prefix : ir.CompilerIrInstrList
                                                  (opt-bool-branch-chain-prefix
                                                    instrs
                                                    0
                                                    (- count 1)
                                                    remove)]
                                                [source : ir.CompilerIrBlock
                                                  (ir.compiler-ir-block
                                                    source-label
                                                    (opt-aggregate-instr-list-append
                                                      source-prefix
                                                      (ir.compiler-ir-instr-cons
                                                        first
                                                        (ir.compiler-ir-instr-cons
                                                          (ir.CompilerIrInstr.Branch
                                                            (ir.CompilerIrValue.Var
                                                              (opt-bool-branch-chain-conj-var
                                                                first))
                                                            (opt-bool-branch-chain-first-label
                                                              labels
                                                              true-label)
                                                            false-label)
                                                          (ir.CompilerIrInstrList.Nil)))))]
                                                [fresh : ir.CompilerIrBlockList
                                                  (opt-bool-branch-chain-fresh-blocks
                                                    (__tl-box-place rest)
                                                    labels
                                                    true-label
                                                    false-label)]
                                                (begin
                                                  (if same-target?
                                                    (opt-bool-branch-repair-target-phis!
                                                      blocks
                                                      true-label
                                                      source-label
                                                      all-preds)
                                                    (begin
                                                      (opt-bool-branch-repair-target-phis!
                                                        blocks
                                                        true-label
                                                        source-label
                                                        true-preds)
                                                      (opt-bool-branch-repair-target-phis!
                                                        blocks
                                                        false-label
                                                        source-label
                                                        false-preds)))
                                                  (OptBoolBranchChainRewrite.Some
                                                    (opt-bool-branch-chain-replace-block
                                                      blocks
                                                      source-label
                                                      source
                                                      fresh)
                                                    (array-ref cell 0))))))])]))))))]
                      [_ (OptBoolBranchChainRewrite.No)])]))]
            [_ (OptBoolBranchChainRewrite.No)])))]))

(define (opt-bool-branch-chain-first-list
  [type-segment-bases : i64]
  [all-blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : OptBoolBranchChainRewrite
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBoolBranchChainRewrite.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-bool-branch-chain-try-block
        type-segment-bases
        all-blocks
        frame
        defs
        uses
        block)
        [(OptBoolBranchChainRewrite.Some next next-frame)
          (OptBoolBranchChainRewrite.Some next next-frame)]
        [(OptBoolBranchChainRewrite.No)
          (opt-bool-branch-chain-first-list
            type-segment-bases
            all-blocks
            frame
            defs
            uses
            (__tl-box-place rest))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-first-list
        type-segment-bases
        all-blocks
        frame
        defs
        uses
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-chain-blocks-raw
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBoolBranchChainResult
  (if (<= remaining 0)
    (OptBoolBranchChainResult.Result blocks frame false)
    (let
      [defs : (__tl_dyn-array OptBoolBranchDef)
        (opt-bool-branch-defs frame blocks)]
      [uses : (__tl_dyn-array i64) (opt-collect-blocks-uses-array frame blocks)]
      (match (opt-bool-branch-chain-first-list
        type-segment-bases
        blocks
        frame
        defs
        uses
        blocks)
        [(OptBoolBranchChainRewrite.No)
          (OptBoolBranchChainResult.Result blocks frame false)]
        [(OptBoolBranchChainRewrite.Some next next-frame)
          (match (opt-bool-branch-chain-blocks-raw
            type-segment-bases
            next
            next-frame
            (- remaining 1))
            [(OptBoolBranchChainResult.Result final final-frame _)
              (OptBoolBranchChainResult.Result final final-frame true)])]))))

(define (opt-bool-branch-phi-inputs [inputs : ir.CompilerIrPhiInputList]) : OptBoolBranchPhiInputs
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Cons first first-label first-rest)
      (match (ir.compiler-ir-phi-input-list-force-cons
        (__tl-box-place first-rest))
        [(ir.CompilerIrPhiInputList.Cons second second-label second-rest)
          (match (ir.compiler-ir-phi-input-list-force-cons
            (__tl-box-place second-rest))
            [(ir.CompilerIrPhiInputList.Nil)
              (OptBoolBranchPhiInputs.Two first first-label second second-label)]
            [_ (OptBoolBranchPhiInputs.No)])]
        [_ (OptBoolBranchPhiInputs.No)])]
    [_ (OptBoolBranchPhiInputs.No)]))

(define (opt-bool-branch-constant-inputs-acc
  [inputs : ir.CompilerIrPhiInputList]
  [true-preds : OptLabelSet]
  [false-preds : OptLabelSet]
  [count : i64]) : OptBoolBranchConstantInputs
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil)
      (OptBoolBranchConstantInputs.Some true-preds false-preds count)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bool-branch-constant-inputs-acc
        (ir.compiler-ir-phi-input-seq-to-list seq)
        true-preds
        false-preds
        count)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (or
        (opt-label-contains true-preds label)
        (opt-label-contains false-preds label))
        (OptBoolBranchConstantInputs.No)
        (match value
          [(ir.CompilerIrValue.Bool known)
            (opt-bool-branch-constant-inputs-acc
              (__tl-box-place rest)
              (if known
                (opt-label-add true-preds label)
                true-preds)
              (if known
                false-preds
                (opt-label-add false-preds label))
              (+ count 1))]
          [_ (OptBoolBranchConstantInputs.No)]))]))

(define (opt-bool-branch-constant-inputs [inputs : ir.CompilerIrPhiInputList]) : OptBoolBranchConstantInputs
  (opt-bool-branch-constant-inputs-acc
    inputs
    (OptLabelSet.Nil)
    (OptLabelSet.Nil)
    0))

(define (opt-bool-branch-label-union [from : OptLabelSet] [into : OptLabelSet]) : OptLabelSet
  (match from
    [(OptLabelSet.Nil) into]
    [(OptLabelSet.Dense _ _)
      (opt-bool-branch-label-union
        (opt-label-tail from)
        (opt-label-add into (opt-label-ref from 0)))]))

(define (opt-bool-branch-pred-constant-rewriteable?
  [blocks : ir.CompilerIrBlockList]
  [merge-label : i64]
  [pred-label : i64]) : bool
  (match (opt-cfg-find-block blocks pred-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (and
              (> count 0)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump target) (= target merge-label)]
                [_ false])))])]))

(define (opt-bool-branch-preds-constant-rewriteable?
  [blocks : ir.CompilerIrBlockList]
  [merge-label : i64]
  [preds : OptLabelSet]) : bool
  (match preds
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [pred-label : i64 (opt-label-ref preds 0)]
        (and
          (opt-bool-branch-pred-constant-rewriteable?
            blocks
            merge-label
            pred-label)
          (opt-bool-branch-preds-constant-rewriteable?
            blocks
            merge-label
            (opt-label-tail preds))))]))

(define (opt-bool-branch-phi-input-has-label?
  [inputs : ir.CompilerIrPhiInputList]
  [needle : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bool-branch-phi-input-has-label?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        needle)]
    [(ir.CompilerIrPhiInputList.Cons _ label rest)
      (if (= label needle)
        true
        (opt-bool-branch-phi-input-has-label? (__tl-box-place rest) needle))]))

(define (opt-bool-branch-phi-inputs-have-none?
  [inputs : ir.CompilerIrPhiInputList]
  [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (not (opt-bool-branch-phi-input-has-label? inputs label))
          (opt-bool-branch-phi-inputs-have-none? inputs (opt-label-tail labels))))]))

(define (opt-bool-branch-target-phis-repairable-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (and
          (opt-bool-branch-phi-input-has-label? inputs merge-label)
          (opt-bool-branch-phi-inputs-have-none? inputs new-preds)
          (opt-bool-branch-target-phis-repairable-from?
            instrs
            (+ index 1)
            merge-label
            new-preds))]
      [_ true])))

(define (opt-bool-branch-target-phis-repairable?
  [blocks : ir.CompilerIrBlockList]
  [target-label : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : bool
  (match (opt-cfg-find-block blocks target-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-target-phis-repairable-from?
            instrs
            0
            merge-label
            new-preds)])]))

(define (opt-bool-branch-prepend-phi-inputs
  [value : ir.CompilerIrValue]
  [preds : OptLabelSet]
  [tail : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match preds
    [(OptLabelSet.Nil) tail]
    [(OptLabelSet.Dense _ _)
      (ir.compiler-ir-phi-input-cons
        value
        (opt-label-ref preds 0)
        (opt-bool-branch-prepend-phi-inputs value (opt-label-tail preds) tail))]))

(define (opt-bool-branch-repair-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bool-branch-repair-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        merge-label
        new-preds)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : ir.CompilerIrPhiInputList
          (opt-bool-branch-repair-phi-inputs
            (__tl-box-place rest)
            merge-label
            new-preds)]
        (if (= label merge-label)
          (opt-bool-branch-prepend-phi-inputs value new-preds tail)
          (ir.compiler-ir-phi-input-cons value label tail)))]))

(define (opt-bool-branch-repair-target-phis-from!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : unit
  (if (< index (ir.compiler-ir-instr-seq-count instrs))
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst inputs ty)
        (begin
          (ir.compiler-ir-instr-seq-set!
            instrs
            index
            (ir.CompilerIrInstr.Phi
              dst
              (opt-bool-branch-repair-phi-inputs inputs merge-label new-preds)
              ty))
          (opt-bool-branch-repair-target-phis-from!
            instrs
            (+ index 1)
            merge-label
            new-preds))]
      [_ unit])
    unit))

(define (opt-bool-branch-repair-target-phis!
  [blocks : ir.CompilerIrBlockList]
  [target-label : i64]
  [merge-label : i64]
  [new-preds : OptLabelSet]) : unit
  (match (opt-cfg-find-block blocks target-label)
    [(OptMaybeBlock.No) unit]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-repair-target-phis-from!
            instrs
            0
            merge-label
            new-preds)])]))

(define (opt-bool-branch-apply-constant-pred-rewrites!
  [blocks : ir.CompilerIrBlockList]
  [preds : OptLabelSet]
  [target-label : i64]) : unit
  (match preds
    [(OptLabelSet.Nil) unit]
    [(OptLabelSet.Dense _ _)
      (let
        [pred-label : i64 (opt-label-ref preds 0)]
        (begin
          (match (opt-cfg-find-block blocks pred-label)
            [(OptMaybeBlock.No) unit]
            [(OptMaybeBlock.Some block)
              (match block
                [(ir.CompilerIrBlock.Block _ instrs)
                  (let
                    [last : i64 (- (ir.compiler-ir-instr-seq-count instrs) 1)]
                    (ir.compiler-ir-instr-seq-set!
                      instrs
                      last
                      (ir.CompilerIrInstr.Jump target-label)))])])
          (opt-bool-branch-apply-constant-pred-rewrites!
            blocks
            (opt-label-tail preds)
            target-label)))]))

;; `merge-label` is the block holding the phi, whose predecessors are the edges
;; being retargeted; `branch-label` is the block holding the branch, whose label
;; is the one the successors' phis record for this edge. They are the same block
;; unless the site was reached through a fallthrough chain.
(define (opt-bool-branch-fuse-constant-phi!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [branch-label : i64]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [ty : ast.AstType]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]) : bool
  (if (or
    (not (= dst cond-var))
    (not (= (opt-bool-branch-use-count uses dst) 1))
    (not (opt-type-eq type-segment-bases ty (ast.AstType.Bool)))
    (= merge-label true-label)
    (= merge-label false-label))
    false
    (match (opt-bool-branch-constant-inputs inputs)
      [(OptBoolBranchConstantInputs.No) false]
      [(OptBoolBranchConstantInputs.Some true-preds false-preds input-count)
        (let
          [preds : OptLabelSet (opt-cfg-index-predecessors index merge-label)]
          [same-target? : bool (= true-label false-label)]
          [all-preds : OptLabelSet
            (opt-bool-branch-label-union true-preds false-preds)]
          (if (or
            (<= input-count 0)
            (not (= input-count (opt-label-count preds)))
            (not (opt-label-set-eq? all-preds preds))
            (not
              (opt-bool-branch-preds-constant-rewriteable?
                blocks
                merge-label
                true-preds))
            (not
              (opt-bool-branch-preds-constant-rewriteable?
                blocks
                merge-label
                false-preds))
            (if same-target?
              (not
                (opt-bool-branch-target-phis-repairable?
                  blocks
                  true-label
                  branch-label
                  all-preds))
              (or
                (not
                  (opt-bool-branch-target-phis-repairable?
                    blocks
                    true-label
                    branch-label
                    true-preds))
                (not
                  (opt-bool-branch-target-phis-repairable?
                    blocks
                    false-label
                    branch-label
                    false-preds)))))
            false
            (begin
              (opt-bool-branch-apply-constant-pred-rewrites!
                blocks
                true-preds
                true-label)
              (opt-bool-branch-apply-constant-pred-rewrites!
                blocks
                false-preds
                false-label)
              (if same-target?
                (opt-bool-branch-repair-target-phis!
                  blocks
                  true-label
                  branch-label
                  all-preds)
                (begin
                  (opt-bool-branch-repair-target-phis!
                    blocks
                    true-label
                    branch-label
                    true-preds)
                  (opt-bool-branch-repair-target-phis!
                    blocks
                    false-label
                    branch-label
                    false-preds)))
              true)))])))

(define (opt-bool-branch-target-has-phi?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]
    [(OptMaybeBlock.No) true]))

(define (opt-bool-branch-pred-rewrite
  [blocks : ir.CompilerIrBlockList]
  [merge-label : i64]
  [value : ir.CompilerIrValue]
  [pred-label : i64]
  [true-label : i64]
  [false-label : i64]) : OptBoolBranchPredRewrite
  (match (opt-cfg-find-block blocks pred-label)
    [(OptMaybeBlock.No) (OptBoolBranchPredRewrite.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              (OptBoolBranchPredRewrite.No)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump target)
                  (if (not (= target merge-label))
                    (OptBoolBranchPredRewrite.No)
                    (match value
                      [(ir.CompilerIrValue.Bool known)
                        (OptBoolBranchPredRewrite.Some
                          instrs
                          (- count 1)
                          (ir.CompilerIrInstr.Jump
                            (if known
                              true-label
                              false-label))
                          false)]
                      [(ir.CompilerIrValue.Var cond-var)
                        (if (< count 2)
                          (OptBoolBranchPredRewrite.No)
                          (match (ir.compiler-ir-instr-seq-ref
                            instrs
                            (- count 2))
                            [(ir.CompilerIrInstr.BinOp dst op _ _ ty)
                              (if (and
                                (= dst cond-var)
                                (opt-bool-branch-compare-op? op))
                                (OptBoolBranchPredRewrite.Some
                                  instrs
                                  (- count 1)
                                  (ir.CompilerIrInstr.Branch
                                    value
                                    true-label
                                    false-label)
                                  true)
                                (OptBoolBranchPredRewrite.No))]
                            [_ (OptBoolBranchPredRewrite.No)]))]
                      [_ (OptBoolBranchPredRewrite.No)]))]
                [_ (OptBoolBranchPredRewrite.No)])))])]))

(define (opt-bool-branch-apply-rewrites!
  [first : OptBoolBranchPredRewrite]
  [second : OptBoolBranchPredRewrite]) : bool
  (match first
    [(OptBoolBranchPredRewrite.No) false]
    [(OptBoolBranchPredRewrite.Some
        first-instrs
        first-pos
        first-term
        first-compare)
      (match second
        [(OptBoolBranchPredRewrite.No) false]
        [(OptBoolBranchPredRewrite.Some
            second-instrs
            second-pos
            second-term
            second-compare)
          (if (not (or first-compare second-compare))
            false
            (begin
              (ir.compiler-ir-instr-seq-set! first-instrs first-pos first-term)
              (ir.compiler-ir-instr-seq-set!
                second-instrs
                second-pos
                second-term)
              true))])]))

(define (opt-bool-branch-fuse-compare-phi!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [ty : ast.AstType]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]) : bool
  (if (or
    (not (= dst cond-var))
    (not (= (opt-bool-branch-use-count uses dst) 1))
    (not (opt-type-eq type-segment-bases ty (ast.AstType.Bool)))
    (= merge-label true-label)
    (= merge-label false-label)
    (opt-bool-branch-target-has-phi? blocks true-label)
    (opt-bool-branch-target-has-phi? blocks false-label))
    false
    (match (opt-bool-branch-phi-inputs inputs)
      [(OptBoolBranchPhiInputs.No) false]
      [(OptBoolBranchPhiInputs.Two first first-label second second-label)
        (let
          [preds : OptLabelSet (opt-cfg-index-predecessors index merge-label)]
          (if (or
            (= first-label second-label)
            (not (= (opt-label-count preds) 2))
            (not (opt-label-contains preds first-label))
            (not (opt-label-contains preds second-label)))
            false
            (opt-bool-branch-apply-rewrites!
              (opt-bool-branch-pred-rewrite
                blocks
                merge-label
                first
                first-label
                true-label
                false-label)
              (opt-bool-branch-pred-rewrite
                blocks
                merge-label
                second
                second-label
                true-label
                false-label))))])))

(define (opt-bool-branch-fuse-phi!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [branch-label : i64]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [ty : ast.AstType]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]) : bool
  (if (opt-bool-branch-fuse-constant-phi!
    type-segment-bases
    blocks
    index
    uses
    merge-label
    branch-label
    dst
    inputs
    ty
    cond-var
    true-label
    false-label)
    true
    (opt-bool-branch-fuse-compare-phi!
      type-segment-bases
      blocks
      index
      uses
      merge-label
      dst
      inputs
      ty
      cond-var
      true-label
      false-label)))

;; A merge phi and the branch that consumes it do not have to share a block. The
;; front end routinely emits the boolean merge and the `if` it feeds as two
;; blocks -- the phi block falls through into a merge block that holds nothing
;; but the branch -- and longer runs of fallthrough appear where nested merges
;; land on the same join. In the emitted assembly that reads as two labels in a
;; row followed by `test %r,%r; jcc`, with the phi's constants materialized by
;; the predecessors: exactly the sequence this pass exists to delete, rejected
;; only because the branch sat one block further on.
;;
;; Those sites are the same rewrite. What the fuser needs is the branch's
;; condition and successors, and that the whole run from the phi block to the
;; branch block dies when the phi block's predecessors are retargeted. The walk
;; below only continues through a block that is a pure fallthrough owned by the
;; run: exactly one instruction, an unconditional jump, and exactly one
;; predecessor, which can only be the block that got us here. A block reached
;; from anywhere else, a block carrying real instructions, and the function
;; entry (reachable with no edge at all) each stop the walk, because each would
;; leave a reader of the phi's result alive after the phi block is gone.
;;
;; This widens the match only. No block on the chain is collapsed, merged, or
;; removed here -- the run is left for the normal unreachable-block cleanup --
;; so the fallthrough block structure that later passes and the backend depend
;; on is not disturbed.
(define (opt-bool-branch-resolve-branch-site
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [merge-label : i64]
  [label : i64]
  [fuel : i64]) : OptBoolBranchBranchSite
  (if (or
    (<= fuel 0)
    (= label merge-label)
    (= label (opt-cfg-entry-label blocks))
    (not (= (opt-label-count (opt-cfg-index-predecessors index label)) 1)))
    (OptBoolBranchBranchSite.No)
    (match (opt-cfg-find-block blocks label)
      [(OptMaybeBlock.No) (OptBoolBranchBranchSite.No)]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (if (not (= (ir.compiler-ir-instr-seq-count instrs) 1))
              (OptBoolBranchBranchSite.No)
              (match (ir.compiler-ir-instr-seq-ref instrs 0)
                [(ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var cond-var)
                    true-label
                    false-label)
                  (OptBoolBranchBranchSite.Some
                    label
                    cond-var
                    true-label
                    false-label)]
                [(ir.CompilerIrInstr.Jump next)
                  (opt-bool-branch-resolve-branch-site
                    blocks
                    index
                    merge-label
                    next
                    (- fuel 1))]
                [_ (OptBoolBranchBranchSite.No)]))])])))

(define (opt-bool-branch-branch-site
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [merge-label : i64]
  [instrs : ir.CompilerIrInstrSeq]) : OptBoolBranchBranchSite
  (match (ir.compiler-ir-instr-seq-ref instrs 1)
    [(ir.CompilerIrInstr.Branch
        (ir.CompilerIrValue.Var cond-var)
        true-label
        false-label)
      (OptBoolBranchBranchSite.Some merge-label cond-var true-label false-label)]
    [(ir.CompilerIrInstr.Jump next)
      (opt-bool-branch-resolve-branch-site blocks index merge-label next 8)]
    [_ (OptBoolBranchBranchSite.No)]))

(define (opt-bool-branch-fuse-block!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block merge-label instrs)
      (if (not (= (ir.compiler-ir-instr-seq-count instrs) 2))
        false
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (match (opt-bool-branch-branch-site blocks index merge-label instrs)
              [(OptBoolBranchBranchSite.No) false]
              [(OptBoolBranchBranchSite.Some
                  branch-label
                  cond-var
                  true-label
                  false-label)
                (opt-bool-branch-fuse-phi!
                  type-segment-bases
                  blocks
                  index
                  uses
                  merge-label
                  branch-label
                  dst
                  inputs
                  ty
                  cond-var
                  true-label
                  false-label)])]
          [_ false]))]))

(define (opt-bool-branch-fuse-first-list!
  [type-segment-bases : i64]
  [all-blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-fuse-block!
        type-segment-bases
        all-blocks
        index
        uses
        block)
        true
        (opt-bool-branch-fuse-first-list!
          type-segment-bases
          all-blocks
          index
          uses
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [pos : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (begin
          (while (< pos count)
            (if (opt-bool-branch-fuse-block!
              type-segment-bases
              all-blocks
              index
              uses
              (ir.compiler-ir-block-seq-ref seq pos))
              (return true)
              (set! pos (+ pos 1))))
          false))]))

;; The bool-branch fuser mutates its working copy, so it clones the block
;; contents first. The clone used to go seq -> cons list -> seq: it built a
;; 112 B node per instruction and then `compiler-ir-block` re-counted the spine
;; and copied it back into an array, purely to reproduce the array it started
;; from. It is a straight row copy. refs #5726
(define (opt-bool-branch-clone-instr-seq [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set! (array-ref out index) (array-ref slots index))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

(define (opt-bool-branch-clone-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-bool-branch-clone-instr-seq instrs))
            (opt-bool-branch-clone-blocks (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-clone-blocks (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-bool-branch-fuse-blocks-raw
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBlockListPassResult
  (if (<= remaining 0)
    (OptBlockListPassResult.Result blocks false)
    (let
      [index : OptCfgIndex (opt-cfg-index-build blocks)]
      [uses : (__tl_dyn-array i64) (opt-collect-blocks-uses-array frame blocks)]
      (if (opt-bool-branch-fuse-first-list!
        type-segment-bases
        blocks
        index
        uses
        blocks)
        (match (opt-bool-branch-fuse-blocks-raw
          type-segment-bases
          (opt-cfg-simplify-blocks blocks)
          frame
          (- remaining 1))
          [(OptBlockListPassResult.Result next _)
            (OptBlockListPassResult.Result next true)])
        (OptBlockListPassResult.Result blocks false)))))

(define (opt-bool-branch-fuse-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBlockListPassResult
  (opt-bool-branch-fuse-blocks-raw
    type-segment-bases
    (opt-bool-branch-clone-blocks blocks)
    frame
    remaining))

;; `[bool phi, branch on that phi]` -- the shape the fuser was originally
;; written for, and the only one decidable from a single block.
(define (opt-bool-branch-block-direct-candidate?
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (and
        (= (ir.compiler-ir-instr-seq-count instrs) 2)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Phi dst _ ty)
            (and
              (opt-type-eq type-segment-bases ty (ast.AstType.Bool))
              (match (ir.compiler-ir-instr-seq-ref instrs 1)
                [(ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var cond-var)
                    _
                    _)
                  (= dst cond-var)]
                [_ false]))]
          [_ false]))]))

;; `[bool phi, jump L]` -- a fallthrough chain can start here, and L is the one
;; block worth looking at for it. `label-none` when the block is not that shape.
(define (opt-bool-branch-block-chain-start
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (if (not (= (ir.compiler-ir-instr-seq-count instrs) 2))
        (ir.compiler-ir-label-none)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Phi _ _ ty)
            (if (not (opt-type-eq type-segment-bases ty (ast.AstType.Bool)))
              (ir.compiler-ir-label-none)
              (match (ir.compiler-ir-instr-seq-ref instrs 1)
                [(ir.CompilerIrInstr.Jump target) target]
                [_ (ir.compiler-ir-label-none)]))]
          [_ (ir.compiler-ir-label-none)]))]))

(define (opt-bool-branch-gate-collect-start
  [type-segment-bases : i64]
  [starts : OptLabelSet]
  [block : ir.CompilerIrBlock]) : OptLabelSet
  (let
    [start : i64 (opt-bool-branch-block-chain-start type-segment-bases block)]
    (if (ir.compiler-ir-label-some? start)
      (opt-label-add starts start)
      starts)))

;; Pass one's answer: either a block already carries phi and branch together, or
;; these are the jump targets a chain could start from.
(defenum OptBoolBranchGateScan
  (Direct)
  (Starts OptLabelSet))

(define (opt-bool-branch-gate-scan
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [starts : OptLabelSet]) : OptBoolBranchGateScan
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBoolBranchGateScan.Starts starts)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-block-direct-candidate? type-segment-bases block)
        (OptBoolBranchGateScan.Direct)
        (opt-bool-branch-gate-scan
          type-segment-bases
          (__tl-box-place rest)
          (opt-bool-branch-gate-collect-start type-segment-bases starts block)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [pos : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [found : OptLabelSet starts]
        (begin
          (while (< pos count)
            (let
              [block : ir.CompilerIrBlock
                (ir.compiler-ir-block-seq-ref seq pos)]
              (if (opt-bool-branch-block-direct-candidate?
                type-segment-bases
                block)
                (return (OptBoolBranchGateScan.Direct))
                (begin
                  (set!
                    found
                    (opt-bool-branch-gate-collect-start
                      type-segment-bases
                      found
                      block))
                  (set! pos (+ pos 1))))))
          (OptBoolBranchGateScan.Starts found)))]))

;; A chain can only continue into a block that is nothing but an unconditional
;; jump or nothing but a branch, so one of the collected starts has to name such
;; a block. `starts` holds one or two labels in the functions that reach here at
;; all, which is why it is walked linearly instead of indexed.
(define (opt-bool-branch-gate-step-block?
  [starts : OptLabelSet]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (and
        (= (ir.compiler-ir-instr-seq-count instrs) 1)
        (opt-label-contains starts label)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Jump _) true]
          [(ir.CompilerIrInstr.Branch (ir.CompilerIrValue.Var _) _ _) true]
          [_ false]))]))

(define (opt-bool-branch-gate-starts-open?
  [blocks : ir.CompilerIrBlockList]
  [starts : OptLabelSet]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-gate-step-block? starts block)
        true
        (opt-bool-branch-gate-starts-open? (__tl-box-place rest) starts))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [pos : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (begin
          (while (< pos count)
            (if (opt-bool-branch-gate-step-block?
              starts
              (ir.compiler-ir-block-seq-ref seq pos))
              (return true)
              (set! pos (+ pos 1))))
          false))]))

;; Cheap admission test for the whole pass, run over every block of every
;; function. Resolving a fallthrough chain needs `opt-cfg-find-block`, and one
;; linear block search per candidate would make the gate quadratic -- the exact
;; cost the `and`-chain gate below was rewritten to remove. So the gate is two
;; sequential passes over the same dense block array and no lookups at all:
;;
;;   1. A block that already carries the phi and the branch together answers yes
;;      outright. Otherwise collect the jump targets of the `[bool phi, jump]`
;;      blocks -- the only places a chain can begin. That set is empty in almost
;;      every function, and the walk stops there without allocating.
;;   2. A chain can only continue into a single-jump or single-branch block, so
;;      answer yes only when a collected target names one.
;;
;; Everything past that first hop -- the predecessor counts, the branch's
;; condition, the phi's inputs -- belongs to `opt-bool-branch-branch-site` and
;; the fusers, which by then have the CFG index this gate deliberately does not
;; build. Admitting a function the matcher then declines is only wasted work,
;; never a wrong answer; rejecting one it would have fused would be a miss, so
;; both passes stay strictly weaker than what the matcher checks.
(define (opt-bool-branch-blocks-have-candidate?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match (opt-bool-branch-gate-scan type-segment-bases blocks (OptLabelSet.Nil))
    [(OptBoolBranchGateScan.Direct) true]
    [(OptBoolBranchGateScan.Starts starts)
      (and
        (> (opt-label-count starts) 0)
        (opt-bool-branch-gate-starts-open? blocks starts))]))

(define (opt-bool-branch-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  ;; The block pass mutates instruction sequences, so it always works on a deep
  ;; block/instruction clone. A failed post-pass verify can therefore return the
  ;; byte-for-byte input function instead of retaining a partial edge rewrite.
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not
        (opt-bool-branch-blocks-have-candidate? type-segment-bases blocks))
        (OptFunctionPassResult.Result func false)
        (match (opt-verify-gate verified? func context)
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionPassResult.Result func false)]
          [(ResultCompilerOptimizeVerify.Ok)
            (match (opt-bool-branch-fuse-blocks
              type-segment-bases
              blocks
              frame
              16)
              [(OptBlockListPassResult.Result next-blocks changed)
                (if changed
                  (let
                    [next : ir.CompilerIrFunction
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        frame
                        next-blocks)]
                    [next-context : OptCfgContext
                      (opt-cfg-context-build next-blocks)]
                    (match (opt-verify-function-with-context next next-context)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)]))
                  (OptFunctionPassResult.Result func false))])]))]))

;; Gate for the bool-branch `and`-chain pass: does any conditional branch test a
;; value that an `and` materialized in this function?
;;
;; Proving that used to be quadratic. For every block ending in `branch %v` the
;; walk re-read every instruction of every block looking for `%v = and ...`, and
;; re-materialized a cons list of the whole block array once per re-read. The
;; answer needs neither: the `and` destinations and the branch conditions are
;; two independent facts, each decidable in one sequential pass over the dense
;; instruction/block arrays that already hold them.
;;
;; Measured over the opt2 self-compile of src/main.tl (59,726 gate calls), which
;; is where the old walk was the profile's worst D1 read-miss density -- 64.2M
;; D1 read misses, one per 20 instructions executed:
;;   - the scanned functions hold 4,990,494 instructions, and the walk performed
;;     86,389,242 instruction visits: every instruction stream was re-read 17.3x
;;     on average (worst single call: 8,757 instructions re-read 179 times =
;;     1,567,503 visits), far past what L1 holds, so nearly every visit missed;
;;   - 11,844,076 cons cells were materialized by the per-re-read
;;     `compiler-ir-block-seq-to-list`, all cold on first touch;
;;   - 59,384 of the 59,726 calls (99.4%) ran that walk over a function with no
;;     `and` instruction at all, where no re-read can ever succeed. The whole
;;     self-compile contains just 546 `and` destinations.
;; So the common answer is settled by one sequential pass with no allocation,
;; and the 0.6% that can still say yes cost two more sequential passes. That
;; leaves 5,037,778 instruction visits (1.009x the stream, 17.2x fewer), 2,494
;; block visits (none of them consed), and 342 mark arrays. Running both walks
;; against each other inside one compiler agreed on all 59,766 gate answers.
(define (opt-bool-branch-chain-instrs-and-dst-max
  [instrs : ir.CompilerIrInstrSeq]
  [best : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [found : i64 best]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.BinOp dst op _ _ _)
              (match op
                [(ir.CompilerIrBinOp.And)
                  (if (> dst found)
                    (set! found dst)
                    unit)]
                [_ unit])]
            [_ unit])
          (set! index (+ index 1))))
      found)))

(define (opt-bool-branch-chain-block-seq-and-dst-max
  [blocks : ir.CompilerIrBlockSeq]
  [best : i64]) : i64
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [index : i64 0]
    [found : i64 best]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks index)
            [(ir.CompilerIrBlock.Block _ instrs)
              (set!
                found
                (opt-bool-branch-chain-instrs-and-dst-max instrs found))])
          (set! index (+ index 1))))
      found)))

;; Highest destination of an `and` BinOp anywhere in the block list, or -1 when
;; the function has none -- which is also the whole gate answer for 99.4% of
;; calls, since a branch condition no `and` defines can never be a chain root.
(define (opt-bool-branch-chain-blocks-and-dst-max
  [blocks : ir.CompilerIrBlockList]
  [best : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) best]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bool-branch-chain-blocks-and-dst-max
            (__tl-box-place rest)
            (opt-bool-branch-chain-instrs-and-dst-max instrs best))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-block-seq-and-dst-max seq best)]))

(define (opt-bool-branch-chain-mark-instrs-ands!
  [marks : (__tl_dyn-array bool)]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.BinOp dst op _ _ _)
              (match op
                [(ir.CompilerIrBinOp.And)
                  (if (>= dst 0)
                    (if (< dst (array-length marks))
                      (set! (array-ref marks dst) true)
                      unit)
                    unit)]
                [_ unit])]
            [_ unit])
          (set! index (+ index 1))))
      unit)))

(define (opt-bool-branch-chain-mark-block-seq-ands!
  [marks : (__tl_dyn-array bool)]
  [blocks : ir.CompilerIrBlockSeq]) : unit
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks index)
            [(ir.CompilerIrBlock.Block _ instrs)
              (opt-bool-branch-chain-mark-instrs-ands! marks instrs)])
          (set! index (+ index 1))))
      unit)))

(define (opt-bool-branch-chain-mark-blocks-ands!
  [marks : (__tl_dyn-array bool)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-bool-branch-chain-mark-instrs-ands! marks instrs)
            (opt-bool-branch-chain-mark-blocks-ands!
              marks
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-mark-block-seq-ands! marks seq)]))

(define (opt-bool-branch-chain-block-branches-marked?
  [marks : (__tl_dyn-array bool)]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (and
          (> count 0)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch (ir.CompilerIrValue.Var cond-var) _ _)
              (and
                (>= cond-var 0)
                (< cond-var (array-length marks))
                (array-ref marks cond-var))]
            [_ false])))]))

(define (opt-bool-branch-chain-block-seq-marked-branch?
  [marks : (__tl_dyn-array bool)]
  [blocks : ir.CompilerIrBlockSeq]) : bool
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (< index count)
        (if (opt-bool-branch-chain-block-branches-marked?
          marks
          (ir.compiler-ir-block-seq-ref blocks index))
          (begin
            (set! found true)
            (set! index count))
          (set! index (+ index 1))))
      found)))

(define (opt-bool-branch-chain-blocks-marked-branch?
  [marks : (__tl_dyn-array bool)]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-bool-branch-chain-block-branches-marked? marks block)
        true
        (opt-bool-branch-chain-blocks-marked-branch?
          marks
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bool-branch-chain-block-seq-marked-branch? marks seq)]))

(define (opt-bool-branch-chain-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [and-max : i64 (opt-bool-branch-chain-blocks-and-dst-max blocks -1)]
    (if (< and-max 0)
      false
      (let
        [marks : (__tl_dyn-array bool) (array.make-array bool (+ and-max 1))]
        (begin
          (opt-bool-branch-chain-mark-blocks-ands! marks blocks)
          (opt-bool-branch-chain-blocks-marked-branch? marks blocks))))))

(define (opt-bool-branch-chain-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not (opt-bool-branch-chain-blocks-have-candidate? blocks))
        (OptFunctionPassResult.Result func false)
        (match (opt-verify-gate verified? func context)
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionPassResult.Result func false)]
          [(ResultCompilerOptimizeVerify.Ok)
            (match (opt-bool-branch-chain-blocks-raw
              type-segment-bases
              (opt-bool-branch-clone-blocks blocks)
              frame
              64)
              [(OptBoolBranchChainResult.Result next-blocks next-frame changed)
                (if changed
                  (let
                    [next : ir.CompilerIrFunction
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        next-frame
                        next-blocks)]
                    [next-context : OptCfgContext
                      (opt-cfg-context-build next-blocks)]
                    (match (opt-verify-function-with-context next next-context)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)]))
                  (OptFunctionPassResult.Result func false))])]))]))

;; --- jump threading over constant branch conditions ------------------------
;;
;; A lowered `and` / `or` / `cond` materializes its result into a boolean and
;; then immediately retests it. After SSA construction the shape is a merge
;; block whose only instructions are one phi and the branch that tests it
;; (route_http's byte-scan guard, verbatim from the opt2 IR dump):
;;
;;   if_then.9:    jump if_merge.11
;;   if_merge.14:  %29 = phi [true, if_then.12], [false, if_else.13] : bool
;;                 jump if_merge.11
;;   if_merge.11:  %30 = phi [true, if_then.9], [%29, if_merge.14] : bool
;;                 branch %30, if_then.15, if_else.16
;;
;; The backend has to give %29/%30 a stack slot, so every iteration executes a
;; constant store, a jump chain, and a compare-against-zero that the incoming
;; edge already decided. Each edge that carries a literal statically picks the
;; branch target, so its predecessor can jump straight there: `if_then.9`
;; threads to `if_then.15`, and the literals inside the forwarding block
;; `if_merge.14` thread `if_then.12` / `if_else.13` past BOTH merges (the
;; depth-2 chain that the jump-to-jump asm shows). C compiles the same source
;; to plain control flow.
;;
;; Nothing is duplicated: the pass only retargets existing edges and repairs
;; phi inputs. A merge that loses every predecessor becomes unreachable and the
;; `opt-cfg-simplify-blocks` cleanup between rounds (and the pipeline's own
;; `cfg` stage right after this pass) deletes it, which retires the boolean
;; store as well; a merge that keeps a predecessor is left with a smaller phi.
;;
;; The rails are deliberately strict for this first version:
;;   - the merge holds phis and its branch and nothing else (no dead Movs, no
;;     compare-against-constant condition -- both are follow-ups);
;;   - the condition is the merge's SINGLE phi and its only use is that branch,
;;     so no value defined in the merge can be live in the threaded successor
;;     and successor-phi repair never has to forward a merge-defined value;
;;   - the forwarding block of a depth-2 chain has the same single-phi shape;
;;   - a successor phi must already carry an input for the merge;
;;   - the merge may not be its own branch target, and an edge is never
;;     retargeted onto the block it already leaves or onto its own origin.
(defenum OptThreadConstBool
  (No)
  (Some bool))

;; cond var, phi slot (0 for the phi form, -1 when the condition is defined
;; outside the merge), true label, false label.
(defenum OptThreadMerge
  (No)
  (Some i64 i64 i64 i64))

(defenum OptThreadForward
  (No)
  (Some ir.CompilerIrPhiInputList))

(define (opt-thread-phi-prefix-count
  [instrs : ir.CompilerIrInstrSeq]
  [slot : i64]) : i64
  (if (>= slot (ir.compiler-ir-instr-seq-count instrs))
    slot
    (match (ir.compiler-ir-instr-seq-ref instrs slot)
      [(ir.CompilerIrInstr.Phi _ _ _)
        (opt-thread-phi-prefix-count instrs (+ slot 1))]
      [_ slot])))

(define (opt-thread-phi-input-value
  [inputs : ir.CompilerIrPhiInputList]
  [label : i64]) : ir.CompilerIrMaybeValue
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-thread-phi-input-value
        (ir.compiler-ir-phi-input-seq-to-list seq)
        label)]
    [(ir.CompilerIrPhiInputList.Cons value input-label rest)
      (if (= input-label label)
        (ir.CompilerIrMaybeValue.Some value)
        (opt-thread-phi-input-value (__tl-box-place rest) label))]))

(define (opt-thread-phi-inputs-drop
  [inputs : ir.CompilerIrPhiInputList]
  [label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-thread-phi-inputs-drop
        (ir.compiler-ir-phi-input-seq-to-list seq)
        label)]
    [(ir.CompilerIrPhiInputList.Cons value input-label rest)
      (if (= input-label label)
        (opt-thread-phi-inputs-drop (__tl-box-place rest) label)
        (ir.compiler-ir-phi-input-cons
          value
          input-label
          (opt-thread-phi-inputs-drop (__tl-box-place rest) label)))]))

;; The use counts are collected once per round and then maintained exactly:
;; the only rewrite that ADDS a use is the successor-phi repair below, and a
;; stale-high count only makes the single-use rails reject.
(define (opt-thread-note-value-use!
  [uses : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : unit
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (and (>= var 0) (< var (array-length uses)))
        (set! (array-ref uses var) (+ (array-ref uses var) 1))
        unit)]
    [_ unit]))

(define (opt-thread-merge-shape
  [type-segment-bases : i64]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [instrs : ir.CompilerIrInstrSeq]) : OptThreadMerge
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (= count 0)
      (OptThreadMerge.No)
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Branch
            (ir.CompilerIrValue.Var cond-var)
            true-label
            false-label)
          (cond
            [(or
                (not (= (opt-thread-phi-prefix-count instrs 0) (- count 1)))
                (= true-label merge-label)
                (= false-label merge-label))
              (OptThreadMerge.No)]
            [(= count 1)
              (OptThreadMerge.Some cond-var (- 0 1) true-label false-label)]
            [(not (= count 2)) (OptThreadMerge.No)]
            [else
              (match (ir.compiler-ir-instr-seq-ref instrs 0)
                [(ir.CompilerIrInstr.Phi dst _ ty)
                  (if (and
                    (= dst cond-var)
                    (opt-type-eq type-segment-bases ty (ast.AstType.Bool))
                    (= (opt-bool-branch-use-count uses cond-var) 1))
                    (OptThreadMerge.Some cond-var 0 true-label false-label)
                    (OptThreadMerge.No))]
                [_ (OptThreadMerge.No)])])]
        [_ (OptThreadMerge.No)]))))

;; A depth-2 chain hop: `forward` must be exactly one bool phi defining `var`
;; plus the jump into the merge, and that phi's only use must be the merge phi
;; input we arrived through.
(define (opt-thread-forward-shape
  [type-segment-bases : i64]
  [uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]
  [merge-label : i64]
  [var : i64]) : OptThreadForward
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (or
        (= label merge-label)
        (not (= (ir.compiler-ir-instr-seq-count instrs) 2)))
        (OptThreadForward.No)
        (match (ir.compiler-ir-instr-seq-ref instrs 1)
          [(ir.CompilerIrInstr.Jump target)
            (if (not (= target merge-label))
              (OptThreadForward.No)
              (match (ir.compiler-ir-instr-seq-ref instrs 0)
                [(ir.CompilerIrInstr.Phi dst inputs ty)
                  (if (and
                    (= dst var)
                    (opt-type-eq type-segment-bases ty (ast.AstType.Bool))
                    (= (opt-bool-branch-use-count uses var) 1))
                    (OptThreadForward.Some inputs)
                    (OptThreadForward.No))]
                [_ (OptThreadForward.No)]))]
          [_ (OptThreadForward.No)]))]))

(define (opt-thread-target-phis-repairable?
  [instrs : ir.CompilerIrInstrSeq]
  [slot : i64]
  [merge-label : i64]) : bool
  (if (>= slot (ir.compiler-ir-instr-seq-count instrs))
    true
    (match (ir.compiler-ir-instr-seq-ref instrs slot)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (and
          (match (opt-thread-phi-input-value inputs merge-label)
            [(ir.CompilerIrMaybeValue.Some _) true]
            [(ir.CompilerIrMaybeValue.No) false])
          (opt-thread-target-phis-repairable? instrs (+ slot 1) merge-label))]
      [_ true])))

;; The threaded edge takes the place of the merge's own edge into `target`, so
;; every target phi gains the value it already forwards for the merge. The
;; single-use rails above guarantee that value is not defined in the merge or
;; in the forwarding block.
(define (opt-thread-repair-target-phis!
  [instrs : ir.CompilerIrInstrSeq]
  [slot : i64]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [origin-label : i64]) : unit
  (if (>= slot (ir.compiler-ir-instr-seq-count instrs))
    unit
    (match (ir.compiler-ir-instr-seq-ref instrs slot)
      [(ir.CompilerIrInstr.Phi dst inputs ty)
        (begin
          (match (opt-thread-phi-input-value inputs merge-label)
            [(ir.CompilerIrMaybeValue.Some value)
              (begin
                (ir.compiler-ir-instr-seq-set!
                  instrs
                  slot
                  (ir.CompilerIrInstr.Phi
                    dst
                    (ir.compiler-ir-phi-input-cons value origin-label inputs)
                    ty))
                (opt-thread-note-value-use! uses value))]
            [(ir.CompilerIrMaybeValue.No) unit])
          (opt-thread-repair-target-phis!
            instrs
            (+ slot 1)
            uses
            merge-label
            origin-label))]
      [_ unit])))

(define (opt-thread-drop-phi-input!
  [instrs : ir.CompilerIrInstrSeq]
  [slot : i64]
  [label : i64]) : unit
  (if (or (< slot 0) (>= slot (ir.compiler-ir-instr-seq-count instrs)))
    unit
    (match (ir.compiler-ir-instr-seq-ref instrs slot)
      [(ir.CompilerIrInstr.Phi dst inputs ty)
        (ir.compiler-ir-instr-seq-set!
          instrs
          slot
          (ir.CompilerIrInstr.Phi
            dst
            (opt-thread-phi-inputs-drop inputs label)
            ty))]
      [_ unit])))

(define (opt-thread-jump-target [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (= count 0)
      (ir.compiler-ir-label-none)
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Jump target) target]
        [_ (ir.compiler-ir-label-none)]))))

;; Retarget `origin`'s unconditional jump (currently landing on `via`) straight
;; onto `target`, taking over the merge's `merge -> target` edge. `drop-instrs`
;; / `drop-slot` name the phi that loses `origin` as an input: the merge phi for
;; a direct edge, the forwarding phi for a depth-2 chain, and slot -1 when the
;; merge has no phi at all.
(define (opt-thread-apply-edge!
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [origin-label : i64]
  [via-label : i64]
  [merge-label : i64]
  [target-label : i64]
  [drop-instrs : ir.CompilerIrInstrSeq]
  [drop-slot : i64]) : bool
  (if (or
    (= target-label merge-label)
    (= target-label via-label)
    (= target-label origin-label)
    (= origin-label via-label)
    (= origin-label merge-label))
    false
    (match (opt-cfg-index-find-block index origin-label)
      [(OptMaybeBlock.No) false]
      [(OptMaybeBlock.Some origin-block)
        (match origin-block
          [(ir.CompilerIrBlock.Block _ origin-instrs)
            (if (not (= (opt-thread-jump-target origin-instrs) via-label))
              false
              (match (opt-cfg-index-find-block index target-label)
                [(OptMaybeBlock.No) false]
                [(OptMaybeBlock.Some target-block)
                  (match target-block
                    [(ir.CompilerIrBlock.Block _ target-instrs)
                      (if (not
                        (opt-thread-target-phis-repairable?
                          target-instrs
                          0
                          merge-label))
                        false
                        (begin
                          (ir.compiler-ir-instr-seq-set!
                            origin-instrs
                            (- (ir.compiler-ir-instr-seq-count origin-instrs) 1)
                            (ir.CompilerIrInstr.Jump target-label))
                          (opt-thread-drop-phi-input!
                            drop-instrs
                            drop-slot
                            origin-label)
                          (opt-thread-repair-target-phis!
                            target-instrs
                            0
                            uses
                            merge-label
                            origin-label)
                          true))])]))])])))

(define (opt-thread-scan-forward-inputs!
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [forward-label : i64]
  [forward-instrs : ir.CompilerIrInstrSeq]
  [true-label : i64]
  [false-label : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [changed : bool]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) changed]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-thread-scan-forward-inputs!
        index
        uses
        merge-label
        forward-label
        forward-instrs
        true-label
        false-label
        (ir.compiler-ir-phi-input-seq-to-list seq)
        changed)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [step : bool
          (match value
            [(ir.CompilerIrValue.Bool known)
              (opt-thread-apply-edge!
                index
                uses
                label
                forward-label
                merge-label
                (if known
                  true-label
                  false-label)
                forward-instrs
                0)]
            [_ false])]
        (opt-thread-scan-forward-inputs!
          index
          uses
          merge-label
          forward-label
          forward-instrs
          true-label
          false-label
          (__tl-box-place rest)
          (or changed step)))]))

(define (opt-thread-scan-merge-inputs!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [merge-instrs : ir.CompilerIrInstrSeq]
  [true-label : i64]
  [false-label : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [changed : bool]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) changed]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-thread-scan-merge-inputs!
        type-segment-bases
        index
        uses
        merge-label
        merge-instrs
        true-label
        false-label
        (ir.compiler-ir-phi-input-seq-to-list seq)
        changed)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [step : bool
          (match value
            [(ir.CompilerIrValue.Bool known)
              (opt-thread-apply-edge!
                index
                uses
                label
                merge-label
                merge-label
                (if known
                  true-label
                  false-label)
                merge-instrs
                0)]
            [(ir.CompilerIrValue.Var var)
              (match (opt-cfg-index-find-block index label)
                [(OptMaybeBlock.No) false]
                [(OptMaybeBlock.Some forward-block)
                  (match (opt-thread-forward-shape
                    type-segment-bases
                    uses
                    forward-block
                    merge-label
                    var)
                    [(OptThreadForward.No) false]
                    [(OptThreadForward.Some forward-inputs)
                      (match forward-block
                        [(ir.CompilerIrBlock.Block _ forward-instrs)
                          (opt-thread-scan-forward-inputs!
                            index
                            uses
                            merge-label
                            label
                            forward-instrs
                            true-label
                            false-label
                            forward-inputs
                            false)])])])]
            [_ false])]
        (opt-thread-scan-merge-inputs!
          type-segment-bases
          index
          uses
          merge-label
          merge-instrs
          true-label
          false-label
          (__tl-box-place rest)
          (or changed step)))]))

;; Last definition of `var` in the block body (its terminator excluded). Any
;; other defining instruction cancels an earlier constant Mov, so the walk keeps
;; only the final one.
(define (opt-thread-last-const-mov
  [instrs : ir.CompilerIrInstrSeq]
  [slot : i64]
  [var : i64]
  [found : OptThreadConstBool]) : OptThreadConstBool
  (if (>= slot (- (ir.compiler-ir-instr-seq-count instrs) 1))
    found
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs slot)]
      (opt-thread-last-const-mov
        instrs
        (+ slot 1)
        var
        (match (opt-instr-def-var instr)
          [(option_i64.Some dst)
            (if (= dst var)
              (match instr
                [(ir.CompilerIrInstr.Mov _ (ir.CompilerIrValue.Bool known) _)
                  (OptThreadConstBool.Some known)]
                [_ (OptThreadConstBool.No)])
              found)]
          [(option_i64.None) found])))))

(define (opt-thread-scan-mov-preds!
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [merge-label : i64]
  [cond-var : i64]
  [true-label : i64]
  [false-label : i64]
  [preds : OptLabelSet]
  [changed : bool]) : bool
  (match preds
    [(OptLabelSet.Nil) changed]
    [(OptLabelSet.Dense _ _)
      (let
        [pred-label : i64 (opt-label-ref preds 0)]
        [step : bool
          (match (opt-cfg-index-find-block index pred-label)
            [(OptMaybeBlock.No) false]
            [(OptMaybeBlock.Some pred-block)
              (match pred-block
                [(ir.CompilerIrBlock.Block _ pred-instrs)
                  (match (opt-thread-last-const-mov
                    pred-instrs
                    0
                    cond-var
                    (OptThreadConstBool.No))
                    [(OptThreadConstBool.No) false]
                    [(OptThreadConstBool.Some known)
                      (opt-thread-apply-edge!
                        index
                        uses
                        pred-label
                        merge-label
                        merge-label
                        (if known
                          true-label
                          false-label)
                        pred-instrs
                        (- 0 1))])])])]
        (opt-thread-scan-mov-preds!
          index
          uses
          merge-label
          cond-var
          true-label
          false-label
          (opt-label-tail preds)
          (or changed step)))]))

(define (opt-thread-try-block!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block merge-label instrs)
      (match (opt-thread-merge-shape type-segment-bases uses merge-label instrs)
        [(OptThreadMerge.No) false]
        [(OptThreadMerge.Some cond-var phi-slot true-label false-label)
          (if (< phi-slot 0)
            (opt-thread-scan-mov-preds!
              index
              uses
              merge-label
              cond-var
              true-label
              false-label
              (opt-cfg-index-predecessors index merge-label)
              false)
            (match (ir.compiler-ir-instr-seq-ref instrs phi-slot)
              [(ir.CompilerIrInstr.Phi _ inputs _)
                (opt-thread-scan-merge-inputs!
                  type-segment-bases
                  index
                  uses
                  merge-label
                  instrs
                  true-label
                  false-label
                  inputs
                  false)]
              [_ false]))])]))

(define (opt-thread-scan-blocks!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [changed : bool]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) changed]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-thread-scan-blocks!
        type-segment-bases
        index
        uses
        (__tl-box-place rest)
        (or changed (opt-thread-try-block! type-segment-bases index uses block)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [slot : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [any : bool changed]
        (begin
          (while (< slot count)
            (begin
              (when
                (opt-thread-try-block!
                  type-segment-bases
                  index
                  uses
                  (ir.compiler-ir-block-seq-ref seq slot))
                (set! any true))
              (set! slot (+ slot 1))))
          any))]))

(define (opt-thread-const-branch-round!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : bool
  (let
    [index : OptCfgIndex (opt-cfg-index-build blocks)]
    [uses : (__tl_dyn-array i64) (opt-collect-blocks-uses-array frame blocks)]
    (opt-thread-scan-blocks! type-segment-bases index uses blocks false)))

;; One round threads every edge it can prove, so the fixpoint only has to
;; re-run for the opportunities the previous round's cleanup exposed: a depth-2
;; chain resolves inside a single round, and each further round peels one more
;; level off a merge chain. A long `cond` ladder in the compiler's own sources
;; builds exactly such a chain, and an instrumented build showed a 16-round cap
;; truncating five of them while 64 converges everywhere (nine benchmarks and
;; src/main.tl at opt2, all with rounds to spare). The cap therefore only
;; bounds the loop; it is not reached in practice.
(define (opt-thread-const-branch-fuel) : i64
  64)

(define (opt-thread-const-branch-blocks-raw
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBlockListPassResult
  (if (<= remaining 0)
    (OptBlockListPassResult.Result blocks false)
    (if (opt-thread-const-branch-round! type-segment-bases blocks frame)
      (match (opt-thread-const-branch-blocks-raw
        type-segment-bases
        (opt-cfg-simplify-blocks blocks)
        frame
        (- remaining 1))
        [(OptBlockListPassResult.Result next _)
          (OptBlockListPassResult.Result next true)])
      (OptBlockListPassResult.Result blocks false))))

(define (opt-thread-const-branch-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [remaining : i64]) : OptBlockListPassResult
  (opt-thread-const-branch-blocks-raw
    type-segment-bases
    (opt-bool-branch-clone-blocks blocks)
    frame
    remaining))

(define (opt-thread-phi-block-candidate?
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (and
        (= (ir.compiler-ir-instr-seq-count instrs) 2)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Phi dst _ ty)
            (and
              (opt-type-eq type-segment-bases ty (ast.AstType.Bool))
              (match (ir.compiler-ir-instr-seq-ref instrs 1)
                [(ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var cond-var)
                    _
                    _)
                  (= dst cond-var)]
                [_ false]))]
          [_ false]))]))

(define (opt-thread-branch-only-block? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (and
        (= (ir.compiler-ir-instr-seq-count instrs) 1)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Branch (ir.CompilerIrValue.Var _) _ _) true]
          [_ false]))]))

(define (opt-thread-instrs-have-const-bool-mov?
  [instrs : ir.CompilerIrInstrSeq]
  [slot : i64]) : bool
  (if (>= slot (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs slot)
      [(ir.CompilerIrInstr.Mov _ (ir.CompilerIrValue.Bool _) _) true]
      [_ (opt-thread-instrs-have-const-bool-mov? instrs (+ slot 1))])))

;; Two cheap linear scans keep the CFG index, the use census, and the entry
;; verify off every function that has nothing to thread. The Mov form only
;; survives in functions SSA construction declined, so it is admitted only when
;; both a branch-only merge and a constant boolean Mov actually exist.
(define (opt-thread-blocks-have-candidate-from?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [want-phi : bool]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (if want-phi
        (opt-thread-phi-block-candidate? type-segment-bases block)
        (opt-thread-branch-only-block? block))
        true
        (opt-thread-blocks-have-candidate-from?
          type-segment-bases
          (__tl-box-place rest)
          want-phi))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [slot : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (begin
          (while (< slot count)
            (let
              [block : ir.CompilerIrBlock
                (ir.compiler-ir-block-seq-ref seq slot)]
              (if (if want-phi
                (opt-thread-phi-block-candidate? type-segment-bases block)
                (opt-thread-branch-only-block? block))
                (return true)
                (set! slot (+ slot 1)))))
          false))]))

(define (opt-thread-blocks-have-const-bool-mov?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-thread-instrs-have-const-bool-mov? instrs 0)
            (opt-thread-blocks-have-const-bool-mov? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [slot : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (begin
          (while (< slot count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq slot)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (when
                    (opt-thread-instrs-have-const-bool-mov? instrs 0)
                    (return true))])
              (set! slot (+ slot 1))))
          false))]))

(define (opt-thread-const-branch-blocks-have-candidate?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (or
    (opt-thread-blocks-have-candidate-from? type-segment-bases blocks true)
    (and
      (opt-thread-blocks-have-candidate-from? type-segment-bases blocks false)
      (opt-thread-blocks-have-const-bool-mov? blocks))))

(define (opt-thread-const-branch-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  ;; The rewrite mutates instruction sequences, so it always works on a deep
  ;; block/instruction clone and a rejected post-pass verify hands back the
  ;; byte-for-byte input function rather than a partial edge rewrite.
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not
        (opt-thread-const-branch-blocks-have-candidate?
          type-segment-bases
          blocks))
        (OptFunctionPassResult.Result func false)
        (match (opt-verify-gate verified? func context)
          [(ResultCompilerOptimizeVerify.Err _)
            (OptFunctionPassResult.Result func false)]
          [(ResultCompilerOptimizeVerify.Ok)
            (match (opt-thread-const-branch-blocks
              type-segment-bases
              blocks
              frame
              (opt-thread-const-branch-fuel))
              [(OptBlockListPassResult.Result next-blocks changed)
                (if changed
                  (let
                    [next : ir.CompilerIrFunction
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        frame
                        next-blocks)]
                    [next-context : OptCfgContext
                      (opt-cfg-context-build next-blocks)]
                    (match (opt-verify-function-with-context next next-context)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)]))
                  (OptFunctionPassResult.Result func false))])]))]))

;; --- forwarding-block straightening ----------------------------------------
;;
;; `if` / `cond` / `while` lowering gives every arm its own block, so an arm
;; that does no work of its own still reaches the join through a block that is
;; nothing but `jump join`. Nothing removed them. `opt-cfg-simplify-blocks`
;; folds constant branches and drops unreachable blocks, but it never redirects
;; a live predecessor, and `opt-thread-apply-edge!` above only fires once a
;; merge's branch condition is already known constant. They are lowering
;; artifacts, not something a late pass reintroduces -- they are present in the
;; `--opt-level 0` dump -- and they survive to the backend, where each one costs
;; a taken `jmp` every time it executes: 4.48M of them in gvn_table's
;; `gvn-facts-slot` probe loop and 15.23M in intern_table's `it-slice-eq?` byte
;; loop, in both cases on the hottest path in the benchmark. The backend already
;; elides a `jmp` to the next block and already inverts a branch to fall through,
;; so removing the block is the whole fix; no emitter change is involved.
;;
;; The rails are narrow on purpose. A block forwards only when it is EXACTLY one
;; `Jump`, which rules out phis and side effects in a single test, and a
;; destination is accepted only when its phis already carry an input for the last
;; forwarding block on the chain. That input is the value the new predecessor
;; inherits, and `opt-thread-repair-target-phis!` installs it under the new
;; predecessor's label.
;;
;; The rewrite that must be refused is the diamond whose two arms are both
;; trampolines onto the same join: threading both would give the join two inputs
;; under one predecessor label, and they generally disagree -- in `it-slice-eq?`
;; they are the incoming `%72` and a literal `false`. Each terminator therefore
;; carries the set of labels its earlier edges have already been pointed at, and
;; a repeat is left alone. The first arm threads, the second keeps its block, and
;; the loop still loses its `jmp`.
;;
;; `TotalEnumBranch` / `TotalEnumSwitch` are deliberately not rewritten: the
;; latter's `trap-label` is provenance rather than a CFG edge, so leaving both
;; shapes alone keeps this pass out of that invariant entirely.
;; The block a chain of `jump`-only blocks finally lands on, plus the last
;; forwarding block on the way -- the label whose phi input the new predecessor
;; takes over.
(defenum OptCfgStraightenChain
  (No)
  (Some i64 i64))

(define (opt-cfg-straighten-block-forward [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (if (not (= (ir.compiler-ir-instr-seq-count instrs) 1))
        (ir.compiler-ir-label-none)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Jump target) target]
          [_ (ir.compiler-ir-label-none)]))]))

;; A forwarding block whose target is the block right after it in the list costs
;; nothing: the backend already elides that `jmp` and falls through
;; (`compiler-backend-jump-target-is-fallthrough?`). Removing it therefore wins
;; no instruction, and it can lose several. Two backend features want exactly
;; that shape -- a jump-only block sitting immediately before the code it
;; guards. `opt-loop-preheaders` emits one per loop, and M-F loop-hoisted
;; backend constants (compiler_backend.tl:17419) only fire for a loop "whose
;; single out-of-loop predecessor P lies before the loop and ends in an
;; unconditional Jump to the header". Straightening arith_loop's
;; `while_body.1__preheader` away cost the two hoisted `movabsq` a register home
;; and put them back inside the 16x-unrolled body: +40% on that benchmark, and
;; +36.8% each on opt_arithmetic_loops and opt_function_calls. Skipping
;; already-fallthrough blocks preserves every preheader and keeps every arm
;; trampoline, because an arm's join never sits directly behind it.
;;
;; Block ids are assigned in list order by `opt-cfg-index-fill-labels!`, so
;; id + 1 is the lexically next block.
(define (opt-cfg-straighten-falls-through?
  [index : OptCfgIndex]
  [label : i64]
  [target : i64]) : bool
  (match (opt-cfg-index-id index label)
    [(option_i64.None) false]
    [(option_i64.Some id) (= (opt-cfg-index-label index (+ id 1)) target)]))

;; The entry block stays reachable as block 0 no matter what happens to its
;; predecessors, so straightening through it would strand it rather than remove
;; it. Leave it out of the forwarding set.
(define (opt-cfg-straighten-label-forward
  [index : OptCfgIndex]
  [entry-label : i64]
  [label : i64]) : i64
  (if (= label entry-label)
    (ir.compiler-ir-label-none)
    (match (opt-cfg-index-find-block index label)
      [(OptMaybeBlock.No) (ir.compiler-ir-label-none)]
      [(OptMaybeBlock.Some block)
        (let
          [target : i64 (opt-cfg-straighten-block-forward block)]
          (if (opt-cfg-straighten-falls-through? index label target)
            (ir.compiler-ir-label-none)
            target))])))

;; Bounded by the block count, so a ring of trampolines -- unreachable in
;; practice but representable -- reports no chain instead of spinning.
(define (opt-cfg-straighten-resolve
  [index : OptCfgIndex]
  [entry-label : i64]
  [label : i64]
  [via : i64]
  [fuel : i64]) : OptCfgStraightenChain
  (if (<= fuel 0)
    (OptCfgStraightenChain.No)
    (let
      [next : i64 (opt-cfg-straighten-label-forward index entry-label label)]
      (if (= next (ir.compiler-ir-label-none))
        (if (= via (ir.compiler-ir-label-none))
          (OptCfgStraightenChain.No)
          (OptCfgStraightenChain.Some label via))
        (opt-cfg-straighten-resolve index entry-label next label (- fuel 1))))))

(define (opt-cfg-straighten-cases-contain?
  [cases : ir.CompilerIrSwitchCaseList]
  [label : i64]) : bool
  (match (ir.compiler-ir-switch-case-list-force-cons cases)
    [(ir.CompilerIrSwitchCaseList.Nil) false]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ case-label)
          (if (= case-label label)
            true
            (opt-cfg-straighten-cases-contain? (__tl-box-place rest) label))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-cfg-straighten-cases-contain?
        (ir.compiler-ir-switch-case-seq-to-list seq)
        label)]))

(define (opt-cfg-straighten-instr-contains?
  [instr : ir.CompilerIrInstr]
  [label : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump target) (= target label)]
    [(ir.CompilerIrInstr.Branch _ true-label false-label)
      (or (= true-label label) (= false-label label))]
    [(ir.CompilerIrInstr.Switch _ _ cases default-label)
      (or
        (= default-label label)
        (opt-cfg-straighten-cases-contain? cases label))]
    [_ false]))

;; A one-slot cell. The edge rewriter sits several calls inside a switch-case
;; walk, and a flag is cheaper to thread down than a second return value.
(define (opt-cfg-straighten-mark! [flag : (__tl_dyn-array i64)]) : unit
  (set! (array-ref flag 0) 1))

;; Retarget one successor edge, or hand back the label unchanged. `original` is
;; the terminator as it stood before this block was touched, and `accepted`
;; holds the labels its earlier edges have already been pointed at; a
;; destination named by either would make this block a duplicate predecessor of
;; that destination, which a phi input list cannot express.
(define (opt-cfg-straighten-edge
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [entry-label : i64]
  [pred-label : i64]
  [original : ir.CompilerIrInstr]
  [accepted : OptLabelSet]
  [flag : (__tl_dyn-array i64)]
  [successor : i64]
  [fuel : i64]) : i64
  (match (opt-cfg-straighten-resolve
    index
    entry-label
    successor
    (ir.compiler-ir-label-none)
    fuel)
    [(OptCfgStraightenChain.No) successor]
    [(OptCfgStraightenChain.Some target via)
      (if (or
        (= target successor)
        (= target pred-label)
        (opt-label-contains accepted target)
        (opt-cfg-straighten-instr-contains? original target))
        successor
        (match (opt-cfg-index-find-block index target)
          [(OptMaybeBlock.No) successor]
          [(OptMaybeBlock.Some target-block)
            (match target-block
              [(ir.CompilerIrBlock.Block _ target-instrs)
                (if (not
                  (opt-thread-target-phis-repairable? target-instrs 0 via))
                  successor
                  (begin
                    (opt-thread-repair-target-phis!
                      target-instrs
                      0
                      uses
                      via
                      pred-label)
                    (opt-cfg-straighten-mark! flag)
                    target))])]))]))

;; The default edge is decided first so the case walk can see it in `accepted`.
(define (opt-cfg-straighten-switch
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [entry-label : i64]
  [pred-label : i64]
  [original : ir.CompilerIrInstr]
  [flag : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]
  [base : i64]
  [cases : ir.CompilerIrSwitchCaseList]
  [default-label : i64]
  [fuel : i64]) : ir.CompilerIrInstr
  (let
    [accepted : OptLabelSet (OptLabelSet.Nil)]
    [next-default : i64
      (opt-cfg-straighten-edge
        index
        uses
        entry-label
        pred-label
        original
        accepted
        flag
        default-label
        fuel)]
    [seq : ir.CompilerIrSwitchCaseSeq
      (ir.compiler-ir-switch-case-seq-from-list cases)]
    [slots : (__tl_dyn-array ir.CompilerIrSwitchCase) seq.slots]
    [count : i64 seq.len]
    [out : (__tl_dyn-array ir.CompilerIrSwitchCase)
      (array.make-array ir.CompilerIrSwitchCase count)]
    [pos : i64 0]
    (begin
      (unless
        (= next-default default-label)
        (set! accepted (opt-label-add accepted next-default)))
      (while (< pos count)
        (begin
          (match (array-ref slots pos)
            [(ir.CompilerIrSwitchCase.Case tag case-label)
              (let
                [next-label : i64
                  (opt-cfg-straighten-edge
                    index
                    uses
                    entry-label
                    pred-label
                    original
                    accepted
                    flag
                    case-label
                    fuel)]
                (begin
                  (unless
                    (= next-label case-label)
                    (set! accepted (opt-label-add accepted next-label)))
                  (set!
                    (array-ref out pos)
                    (ir.CompilerIrSwitchCase.Case tag next-label))))])
          (set! pos (+ pos 1))))
      (ir.CompilerIrInstr.Switch
        value
        base
        (ir.CompilerIrSwitchCaseList.Array
          (ir.CompilerIrSwitchCaseSeq out count))
        next-default))))

(define (opt-cfg-straighten-terminator
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [entry-label : i64]
  [pred-label : i64]
  [flag : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]
  [fuel : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Jump target)
      (ir.CompilerIrInstr.Jump
        (opt-cfg-straighten-edge
          index
          uses
          entry-label
          pred-label
          instr
          (OptLabelSet.Nil)
          flag
          target
          fuel))]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (let
        [next-true : i64
          (opt-cfg-straighten-edge
            index
            uses
            entry-label
            pred-label
            instr
            (OptLabelSet.Nil)
            flag
            true-label
            fuel)]
        [accepted : OptLabelSet
          (if (= next-true true-label)
            (OptLabelSet.Nil)
            (opt-label-add (OptLabelSet.Nil) next-true))]
        [next-false : i64
          (opt-cfg-straighten-edge
            index
            uses
            entry-label
            pred-label
            instr
            accepted
            flag
            false-label
            fuel)]
        (ir.CompilerIrInstr.Branch cond next-true next-false))]
    [(ir.CompilerIrInstr.Switch value base cases default-label)
      (opt-cfg-straighten-switch
        index
        uses
        entry-label
        pred-label
        instr
        flag
        value
        base
        cases
        default-label
        fuel)]
    [_ instr]))

;; The working list is a clone, so writing the terminator back unconditionally
;; costs nothing and keeps the change report in one place: `flag`.
(define (opt-cfg-straighten-block!
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [entry-label : i64]
  [flag : (__tl_dyn-array i64)]
  [fuel : i64]
  [block : ir.CompilerIrBlock]) : unit
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (= count 0)
          unit
          (let
            [slot : i64 (- count 1)]
            (ir.compiler-ir-instr-seq-set!
              instrs
              slot
              (opt-cfg-straighten-terminator
                index
                uses
                entry-label
                label
                flag
                (ir.compiler-ir-instr-seq-ref instrs slot)
                fuel)))))]))

(define (opt-cfg-straighten-round!
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [entry-label : i64]
  [flag : (__tl_dyn-array i64)]
  [fuel : i64]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (opt-cfg-straighten-block! index uses entry-label flag fuel block)
        (opt-cfg-straighten-round!
          index
          uses
          entry-label
          flag
          fuel
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [slot : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< slot count)
          (begin
            (opt-cfg-straighten-block!
              index
              uses
              entry-label
              flag
              fuel
              (ir.compiler-ir-block-seq-ref seq slot))
            (set! slot (+ slot 1)))))]))

;; Also serves as "the label of the block after this one" when applied to a
;; list tail.
(define (opt-cfg-straighten-head-label [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.compiler-ir-label-none)]
    [(ir.CompilerIrBlockList.Cons block _)
      (match block
        [(ir.CompilerIrBlock.Block label _) label])]
    [(ir.CompilerIrBlockList.Array seq)
      (if (= (ir.compiler-ir-block-seq-count seq) 0)
        (ir.compiler-ir-label-none)
        (match (ir.compiler-ir-block-seq-ref seq 0)
          [(ir.CompilerIrBlock.Block label _) label]))]))

(define (opt-cfg-straighten-candidate-block?
  [block : ir.CompilerIrBlock]
  [next-label : i64]) : bool
  (let
    [target : i64 (opt-cfg-straighten-block-forward block)]
    (and
      (not (= target (ir.compiler-ir-label-none)))
      (not (= target next-label)))))

;; One cheap linear scan keeps the clone, the CFG index and the use census off
;; every function with nothing to straighten. It applies the same lexical-next
;; test the rewrite does, so a function whose only trampolines are loop
;; preheaders -- the common shape -- costs one walk and nothing else.
(define (opt-cfg-straighten-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-cfg-straighten-candidate-block?
        block
        (opt-cfg-straighten-head-label (__tl-box-place rest)))
        true
        (opt-cfg-straighten-blocks-have-candidate? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [slot : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (begin
          (while (< slot count)
            (if (opt-cfg-straighten-candidate-block?
              (ir.compiler-ir-block-seq-ref seq slot)
              (if (< (+ slot 1) count)
                (match (ir.compiler-ir-block-seq-ref seq (+ slot 1))
                  [(ir.CompilerIrBlock.Block label _) label])
                (ir.compiler-ir-label-none)))
              (return true)
              (set! slot (+ slot 1))))
          false))]))

;; The rewrite mutates instruction sequences, so it works on a deep clone and
;; hands back the untouched input list when it changes nothing. `blocks` may
;; still be aliased by the pipeline head. The trailing `opt-cfg-simplify-blocks`
;; is what actually deletes the blocks this pass orphaned, and what drops the
;; phi inputs they leave behind: `opt-cfg-filter-clean-blocks` filters every phi
;; against the destination's REACHABLE predecessor set, so an input from a
;; forwarding block that still has a predecessor of its own correctly survives.
(define (opt-cfg-straighten-forwarding-blocks
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : OptBlockListPassResult
  (if (not (opt-cfg-straighten-blocks-have-candidate? blocks))
    (OptBlockListPassResult.Result blocks false)
    (let
      [work : ir.CompilerIrBlockList (opt-bool-branch-clone-blocks blocks)]
      [index : OptCfgIndex (opt-cfg-index-build work)]
      (if (not (opt-cfg-index-labels-unique? index))
        (OptBlockListPassResult.Result blocks false)
        (let
          [uses : (__tl_dyn-array i64)
            (opt-collect-blocks-uses-array frame work)]
          [flag : (__tl_dyn-array i64) (array.make-array i64 1)]
          [entry-label : i64 (opt-cfg-straighten-head-label work)]
          [fuel : i64 (+ (ir.compiler-ir-block-list-count work) 1)]
          (begin
            (set! (array-ref flag 0) 0)
            (opt-cfg-straighten-round! index uses entry-label flag fuel work)
            (if (= (array-ref flag 0) 0)
              (OptBlockListPassResult.Result blocks false)
              (OptBlockListPassResult.Result
                (opt-cfg-simplify-blocks work)
                true))))))))

(define (opt-cfg-straighten-final-pass
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-cfg-straighten-forwarding-blocks blocks frame)
        [(OptBlockListPassResult.Result next-blocks changed)
          (if (not changed)
            (OptFunctionPassResult.Result
              (compiler-opt-debug-observe-function
                type-segment-bases
                "cfg_straighten"
                func)
              false)
            (let
              [candidate : ir.CompilerIrFunction
                (ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  frame
                  next-blocks)]
              (match (opt-verify-function candidate)
                [(ResultCompilerOptimizeVerify.Ok)
                  (OptFunctionPassResult.Result
                    (compiler-opt-debug-observe-function
                      type-segment-bases
                      "cfg_straighten"
                      candidate)
                    true)]
                [(ResultCompilerOptimizeVerify.Err _)
                  (OptFunctionPassResult.Result
                    (compiler-opt-debug-observe-function
                      type-segment-bases
                      "cfg_straighten"
                      func)
                    false)])))])]))

;; --- sparse conditional constant propagation -------------------------------
;;
;; SCCP v1 runs after the local scalar simplifier. It keeps a small scalar
;; lattice for SSA vars and CFG-id-backed executable block flags. Unknown values
;; are not rewritten; overdefined values keep the original instruction; proven
;; constants rewrite value uses and scalar-producing instructions. The evaluator
;; deliberately reuses the local folding helpers above so divide/modulo/shift
;; trap preservation stays identical.
(defenum OptSccpValue
  (Unknown)
  (Const ir.CompilerIrValue ast.AstType)
  (Overdefined))

;; The SCCP lattice was a persistent assoc list
;; (OptSccpEnvCons id value rest) where opt-sccp-env-set rebuilt the WHOLE list on
;; every bind (via opt-sccp-env-remove) -> O(V) alloc per bind, O(V^2) per analysis
;; sweep, x fixpoint sweeps x all functions (~42s / ~12GB of the -O2 optimize
;; phase). The lattice is a single monotonically-rising map threaded linearly
;; through analysis (never branched), so it is now a mutable array indexed by var
;; id: O(1) lookup/set, no rebuild. Var ids are dense within a function; the array
;; is sized to cover every bound var (params + every instruction dst that
;; opt-sccp-process-instr binds). Out-of-range lookups return Unknown (the same
;; default the list gave for an unbound var), so the analysis result -- and the
;; folded output -- is byte-identical.
(defenum OptSccpEnv
  (Env i64 (__tl_dyn-array OptSccpValue)))

(define (opt-sccp-env-fill-unknown!
  [slots : (__tl_dyn-array OptSccpValue)]
  [n : i64]
  [i : i64]) : unit
  (if (>= i n)
    unit
    (begin
      (set! (array-ref slots i) (OptSccpValue.Unknown))
      (opt-sccp-env-fill-unknown! slots n (+ i 1)))))

(define (opt-sccp-env-make [cap : i64]) : OptSccpEnv
  (let
    [n : i64
      (if (< cap 1)
        1
        cap)]
    [slots : (__tl_dyn-array OptSccpValue) (array.make-array OptSccpValue n)]
    (begin
      (opt-sccp-env-fill-unknown! slots n 0)
      (OptSccpEnv.Env n slots))))

;; Destination var bound by `opt-sccp-process-instr`, or -1 for instructions that
;; bind nothing. MUST mirror the binding arms of opt-sccp-process-instr so the
;; environment array is sized to cover every var the analysis can bind.
(define (opt-sccp-instr-dst [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) dst]
    [(ir.CompilerIrInstr.Cast dst _ _ _) dst]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) dst]
    [(ir.CompilerIrInstr.Phi dst _ _) dst]
    [(ir.CompilerIrInstr.Alloc dst _) dst]
    [(ir.CompilerIrInstr.AddrOf dst _) dst]
    [(ir.CompilerIrInstr.Gep dst _ _ _) dst]
    [(ir.CompilerIrInstr.Load dst _ _) dst]
    [(ir.CompilerIrInstr.EntryArgc dst) dst]
    [(ir.CompilerIrInstr.EntryArgv dst) dst]
    [(ir.CompilerIrInstr.EntryEnvp dst) dst]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) dst]
    [(ir.CompilerIrInstr.Xgetbv dst _) dst]
    [(ir.CompilerIrInstr.Syscall dst _) dst]
    [(ir.CompilerIrInstr.LaneId dst _ _) dst]
    [(ir.CompilerIrInstr.Splat dst _ _ _) dst]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.MaskNot dst _ _) dst]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _) dst]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) dst]
    [(ir.CompilerIrInstr.Call dst _ _ _) dst]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _) dst]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _) dst]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) (- 0 1)]
          [(ir.CompilerIrSpmdCallResult.Value dst _ _) dst]))]
    ;; Pack/Word dsts must be counted so opt-sccp-env-make sizes the lattice
    ;; array over them; opt-sccp-env-set silently drops out-of-range writes,
    ;; which would defeat the Overdefined binding in opt-sccp-process-instr.
    [(ir.CompilerIrInstr.Pack dst _ _) dst]
    [(ir.CompilerIrInstr.Word dst _ _ _) dst]
    [_ (- 0 1)]))

(define (opt-sccp-max-var-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (let
      [dst : i64
        (opt-sccp-instr-dst (ir.compiler-ir-instr-seq-ref instrs index))]
      (opt-sccp-max-var-instr-seq
        instrs
        (+ index 1)
        (if (> dst acc)
          dst
          acc)))))

(define (opt-sccp-max-var-blocks [blocks : ir.CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-sccp-max-var-blocks
            (__tl-box-place rest)
            (opt-sccp-max-var-instr-seq instrs 0 acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-sccp-max-var-blocks (ir.compiler-ir-block-seq-to-list seq) acc)]))

(define (opt-sccp-max-var-params [params : ir.CompilerIrParamList] [acc : i64]) : i64
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) acc]
    [(ir.CompilerIrParamList.Array seq)
      (opt-sccp-max-var-params (ir.compiler-ir-param-seq-to-list seq) acc)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ id)
          (opt-sccp-max-var-params
            (__tl-box-place rest)
            (if (> id acc)
              id
              acc))])]))

(defenum OptSccpState
  ;; The type segment-bases scalar belongs to this analysis instance. Carrying
  ;; it in the already-threaded state keeps SCCP isolated without adding a
  ;; redundant argument to every per-instruction lattice bind.
  (State OptCfgIndex (__tl_dyn-array bool) OptSccpEnv bool i64))

(define (opt-sccp-value-eq
  [type-segment-bases : i64]
  [a : OptSccpValue]
  [b : OptSccpValue]) : bool
  (match a
    [(OptSccpValue.Unknown)
      (match b
        [(OptSccpValue.Unknown) true]
        [_ false])]
    [(OptSccpValue.Overdefined)
      (match b
        [(OptSccpValue.Overdefined) true]
        [_ false])]
    [(OptSccpValue.Const av aty)
      (match b
        [(OptSccpValue.Const bv bty)
          (and (opt-value-eq av bv) (opt-type-eq type-segment-bases aty bty))]
        [_ false])]))

(define (opt-sccp-join
  [type-segment-bases : i64]
  [old : OptSccpValue]
  [new : OptSccpValue]) : OptSccpValue
  (match old
    [(OptSccpValue.Unknown) new]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]
    [(OptSccpValue.Const old-value old-ty)
      (match new
        [(OptSccpValue.Unknown) old]
        [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]
        [(OptSccpValue.Const new-value new-ty)
          (if (and
            (opt-value-eq old-value new-value)
            (opt-type-eq type-segment-bases old-ty new-ty))
            old
            (OptSccpValue.Overdefined))])]))

(define (opt-sccp-env-lookup [env : OptSccpEnv] [var : i64]) : OptSccpValue
  (match env
    [(OptSccpEnv.Env cap slots)
      (if (if (>= var 0)
        (< var cap)
        false)
        (array-ref slots var)
        (OptSccpValue.Unknown))]))

;; Whether any lattice slot still holds a Const at analysis end.
;; opt-sccp-rewrite-value substitutes only OptSccpValue.Const hits, so when
;; this is false the whole rewrite is the identity and the caller can skip
;; rebuilding every block. Read once at analysis end: equivalent to tracking
;; an any-const flag through the opt-sccp-env-set bind sites, but exact
;; rather than conservative -- a Const later joined to Overdefined does not
;; keep the rewrite alive.
(define (opt-sccp-env-any-const? [env : OptSccpEnv] [index : i64]) : bool
  (match env
    [(OptSccpEnv.Env cap slots)
      (if (>= index cap)
        false
        (match (array-ref slots index)
          [(OptSccpValue.Const _ _) true]
          [_ (opt-sccp-env-any-const? env (+ index 1))]))]))

;; Mutates the shared lattice array in place and returns the same env. The
;; environment is threaded linearly through the monotone analysis, so in-place
;; update is observationally identical to the old persistent cons/remove.
(define (opt-sccp-env-set [env : OptSccpEnv] [var : i64] [value : OptSccpValue]) : OptSccpEnv
  (match env
    [(OptSccpEnv.Env cap slots)
      (begin
        (if (if (>= var 0)
          (< var cap)
          false)
          (set! (array-ref slots var) value)
          unit)
        env)]))

(define (opt-sccp-state-bind
  [state : OptSccpState]
  [var : i64]
  [value : OptSccpValue]) : OptSccpState
  (match state
    [(OptSccpState.State cfg-index executable env changed type-segment-bases)
      (let
        [old : OptSccpValue (opt-sccp-env-lookup env var)]
        [merged : OptSccpValue (opt-sccp-join type-segment-bases old value)]
        (if (opt-sccp-value-eq type-segment-bases old merged)
          state
          (OptSccpState.State
            cfg-index
            executable
            (opt-sccp-env-set env var merged)
            true
            type-segment-bases)))]))

(define (opt-sccp-state-mark-executable [state : OptSccpState] [label : i64]) : OptSccpState
  (match state
    [(OptSccpState.State cfg-index executable env changed type-segment-bases)
      (match (opt-cfg-index-id cfg-index label)
        [(option_i64.Some id)
          (if (and (>= id 0) (< id (array-length executable)))
            (if (array-ref executable id)
              state
              (begin
                (set! (array-ref executable id) true)
                (OptSccpState.State
                  cfg-index
                  executable
                  env
                  true
                  type-segment-bases)))
            state)]
        [(option_i64.None) state])]))

(define (opt-sccp-state-reset-changed [state : OptSccpState]) : OptSccpState
  (match state
    [(OptSccpState.State cfg-index executable env _ type-segment-bases)
      (OptSccpState.State cfg-index executable env false type-segment-bases)]))

(define (opt-sccp-immediate [value : ir.CompilerIrValue] [ty : ast.AstType]) : OptSccpValue
  (match (opt-normalize-const value (opt-default-immediate-type value ty))
    [(OptKnownConst.SomeConst folded folded-ty)
      (OptSccpValue.Const folded folded-ty)]
    [(OptKnownConst.NoConst) (OptSccpValue.Overdefined)]))

(define (opt-sccp-value
  [state : OptSccpState]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptSccpValue
  (match state
    [(OptSccpState.State _ _ env _ _)
      (match value
        [(ir.CompilerIrValue.Var id) (opt-sccp-env-lookup env id)]
        [_ (opt-sccp-immediate value ty)])]))

(define (opt-sccp-fold-cast-value
  [src : OptSccpValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : OptSccpValue
  (match src
    [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]
    [(OptSccpValue.Const value ty)
      (match (opt-fold-cast (OptKnownConst.SomeConst value ty) from-ty to-ty)
        [(ir.CompilerIrMaybeValue.Some folded)
          (OptSccpValue.Const folded to-ty)]
        [(ir.CompilerIrMaybeValue.No) (OptSccpValue.Overdefined)])]))

(define (opt-sccp-fold-binop-value
  [type-segment-bases : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptSccpValue]
  [rhs : OptSccpValue]
  [ty : ast.AstType]) : OptSccpValue
  (match lhs
    [(OptSccpValue.Const lhs-value lhs-ty)
      (match rhs
        [(OptSccpValue.Const rhs-value rhs-ty)
          (match (opt-fold-binop
            type-segment-bases
            op
            (OptKnownConst.SomeConst lhs-value lhs-ty)
            (OptKnownConst.SomeConst rhs-value rhs-ty)
            ty)
            [(ir.CompilerIrMaybeValue.Some folded)
              (OptSccpValue.Const folded ty)]
            [(ir.CompilerIrMaybeValue.No) (OptSccpValue.Overdefined)])]
        [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
        [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)])]
    [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]))

(define (opt-sccp-fold-unop-value
  [op : ir.CompilerIrUnOp]
  [src : OptSccpValue]
  [ty : ast.AstType]) : OptSccpValue
  (match src
    [(OptSccpValue.Const value value-ty)
      (match (opt-fold-unop op (OptKnownConst.SomeConst value value-ty) ty)
        [(ir.CompilerIrMaybeValue.Some folded) (OptSccpValue.Const folded ty)]
        [(ir.CompilerIrMaybeValue.No) (OptSccpValue.Overdefined)])]
    [(OptSccpValue.Unknown) (OptSccpValue.Unknown)]
    [(OptSccpValue.Overdefined) (OptSccpValue.Overdefined)]))

(define (opt-sccp-phi-input-value
  [state : OptSccpState]
  [value : ir.CompilerIrValue]
  [pred : i64]
  [ty : ast.AstType]) : OptSccpValue
  (match state
    [(OptSccpState.State cfg-index executable _ _ _)
      (match (opt-cfg-index-id cfg-index pred)
        [(option_i64.Some pred-id)
          (if (and
            (>= pred-id 0)
            (< pred-id (array-length executable))
            (array-ref executable pred-id))
            (opt-sccp-value state value ty)
            (OptSccpValue.Unknown))]
        [(option_i64.None) (OptSccpValue.Unknown)])]))

(define (opt-sccp-phi-value
  [type-segment-bases : i64]
  [state : OptSccpState]
  [inputs : ir.CompilerIrPhiInputList]
  [ty : ast.AstType]) : OptSccpValue
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (OptSccpValue.Unknown)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-sccp-phi-value
        type-segment-bases
        state
        (ir.compiler-ir-phi-input-seq-to-list seq)
        ty)]
    [(ir.CompilerIrPhiInputList.Cons value pred rest)
      (opt-sccp-join
        type-segment-bases
        (opt-sccp-phi-input-value state value pred ty)
        (opt-sccp-phi-value type-segment-bases state (__tl-box-place rest) ty))]))

(define (opt-sccp-mark-branch-targets
  [state : OptSccpState]
  [cond : ir.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : OptSccpState
  (match (opt-sccp-value state cond (ast.AstType.Bool))
    [(OptSccpValue.Const value _)
      (match value
        [(ir.CompilerIrValue.Bool known)
          (if known
            (opt-sccp-state-mark-executable state true-label)
            (opt-sccp-state-mark-executable state false-label))]
        [_
          (opt-sccp-state-mark-executable
            (opt-sccp-state-mark-executable state true-label)
            false-label)])]
    [(OptSccpValue.Overdefined)
      (opt-sccp-state-mark-executable
        (opt-sccp-state-mark-executable state true-label)
        false-label)]
    [(OptSccpValue.Unknown) state]))

(define (opt-sccp-mark-switch-targets
  [state : OptSccpState]
  [cases : ir.CompilerIrSwitchCaseList]) : OptSccpState
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil) state]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case _ label)
          (opt-sccp-mark-switch-targets
            (opt-sccp-state-mark-executable state label)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-sccp-mark-switch-targets
        state
        (ir.compiler-ir-switch-case-seq-to-list seq))]))

(define (opt-sccp-process-instr
  [type-segment-bases : i64]
  [state : OptSccpState]
  [instr : ir.CompilerIrInstr]) : OptSccpState
  (match instr
    [(ir.CompilerIrInstr.Mov dst value ty)
      (opt-sccp-state-bind state dst (opt-sccp-value state value ty))]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-cast-value
          (opt-sccp-value state src from-ty)
          from-ty
          to-ty))]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-binop-value
          type-segment-bases
          op
          (opt-sccp-value state lhs ty)
          (opt-sccp-value state rhs (ir.compiler-ir-binop-rhs-type op ty))
          ty))]
    [(ir.CompilerIrInstr.UnOp dst op value ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-fold-unop-value op (opt-sccp-value state value ty) ty))]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (opt-sccp-state-bind
        state
        dst
        (opt-sccp-phi-value type-segment-bases state inputs ty))]
    [(ir.CompilerIrInstr.Jump label)
      (opt-sccp-state-mark-executable state label)]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (opt-sccp-mark-branch-targets state cond true-label false-label)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (opt-sccp-mark-branch-targets state cond true-label false-label)]
    [(ir.CompilerIrInstr.Alloc dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.AddrOf dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Gep dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Load dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.EntryArgv dst)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.EntryEnvp dst)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.CpuId dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Xgetbv dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Syscall dst _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.LaneId dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Splat dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-sccp-state-bind state dst (OptSccpValue.Overdefined)))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Call dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) state]
          [(ir.CompilerIrSpmdCallResult.Value dst _ _)
            (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]))]
    ;; Register-group dsts: bind Overdefined like loads/calls. Falling
    ;; into the wildcard left them OptSccpValue.Unknown forever, so a branch on a
    ;; Word-extracted enum tag marked NO successor executable and SCCP folded
    ;; match arms away at -O2 (stale-constant miscompile).
    [(ir.CompilerIrInstr.Pack dst _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Word dst _ _ _)
      (opt-sccp-state-bind state dst (OptSccpValue.Overdefined))]
    [(ir.CompilerIrInstr.Switch _ _ cases default-label)
      (opt-sccp-mark-switch-targets
        (opt-sccp-state-mark-executable state default-label)
        cases)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ cases default-label _)
      (opt-sccp-mark-switch-targets
        (opt-sccp-state-mark-executable state default-label)
        cases)]
    [_ state]))

(define (opt-sccp-process-instr-seq-from
  [type-segment-bases : i64]
  [state : OptSccpState]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptSccpState
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    state
    (opt-sccp-process-instr-seq-from
      type-segment-bases
      (opt-sccp-process-instr
        type-segment-bases
        state
        (ir.compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (opt-sccp-process-instr-seq
  [type-segment-bases : i64]
  [state : OptSccpState]
  [instrs : ir.CompilerIrInstrSeq]) : OptSccpState
  (opt-sccp-process-instr-seq-from type-segment-bases state instrs 0))

(define (opt-sccp-process-block
  [type-segment-bases : i64]
  [state : OptSccpState]
  [block : ir.CompilerIrBlock]
  [block-id : i64]) : OptSccpState
  (match state
    [(OptSccpState.State _ executable _ _ _)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (and
            (>= block-id 0)
            (< block-id (array-length executable))
            (array-ref executable block-id))
            (opt-sccp-process-instr-seq type-segment-bases state instrs)
            state)])]))

(define (opt-sccp-process-blocks-from
  [type-segment-bases : i64]
  [state : OptSccpState]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : OptSccpState
  (match blocks
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-sccp-process-blocks-from
        type-segment-bases
        (opt-sccp-process-block type-segment-bases state block block-id)
        (__tl-box-place rest)
        (+ block-id 1))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-sccp-process-blocks-from
        type-segment-bases
        state
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-sccp-env-from-params
  [params : ir.CompilerIrParamList]
  [env : OptSccpEnv]) : OptSccpEnv
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) env]
    [(ir.CompilerIrParamList.Array seq)
      (opt-sccp-env-from-params (ir.compiler-ir-param-seq-to-list seq) env)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ id)
          (opt-sccp-env-from-params
            (__tl-box-place rest)
            (opt-sccp-env-set env id (OptSccpValue.Overdefined)))])]))

(define (opt-sccp-initial-state
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptSccpState
  (let
    [max-var : i64
      (opt-sccp-max-var-params params (opt-sccp-max-var-blocks blocks (- 0 1)))]
    [executable-count : i64 (opt-cfg-index-block-count context.index)]
    [executable-flags : (__tl_dyn-array bool)
      (array.make-array bool executable-count)]
    [_entry : unit
      (match (opt-cfg-index-id context.index context.entry-label)
        [(option_i64.Some entry-id)
          (if (and (>= entry-id 0) (< entry-id executable-count))
            (set! (array-ref executable-flags entry-id) true)
            unit)]
        [(option_i64.None) unit])]
    (OptSccpState.State
      context.index
      executable-flags
      (opt-sccp-env-from-params params (opt-sccp-env-make (+ max-var 1)))
      true
      type-segment-bases)))

;; Frame-sized variant: var ids are dense below the function's frame field
;; (the lowerer's next-var counter, the same invariant regalloc relies on),
;; so frame is an exact-or-larger upper bound for the walked max-var.
;; opt-sccp-env-set silently drops out-of-range writes and out-of-range
;; lookups return Unknown either way, so sizing by frame is
;; behavior-identical to sizing by the whole-function max-var walks.
(define (opt-sccp-initial-state-with-frame
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [frame : i64]) : OptSccpState
  (let
    [executable-count : i64 (opt-cfg-index-block-count context.index)]
    [executable-flags : (__tl_dyn-array bool)
      (array.make-array bool executable-count)]
    [_entry : unit
      (match (opt-cfg-index-id context.index context.entry-label)
        [(option_i64.Some entry-id)
          (if (and (>= entry-id 0) (< entry-id executable-count))
            (set! (array-ref executable-flags entry-id) true)
            unit)]
        [(option_i64.None) unit])]
    (OptSccpState.State
      context.index
      executable-flags
      (opt-sccp-env-from-params params (opt-sccp-env-make frame))
      true
      type-segment-bases)))

(define (opt-sccp-analyze-fixed
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [state : OptSccpState]
  [remaining : i64]) : OptSccpState
  (if (<= remaining 0)
    state
    (let
      [next : OptSccpState
        (opt-sccp-process-blocks-from
          type-segment-bases
          (opt-sccp-state-reset-changed state)
          blocks
          0)]
      (match next
        [(OptSccpState.State _ _ _ changed _)
          (if changed
            (opt-sccp-analyze-fixed
              type-segment-bases
              blocks
              next
              (- remaining 1))
            next)]))))

(define (opt-sccp-analyze
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptSccpState
  (opt-sccp-analyze-fixed
    type-segment-bases
    blocks
    (opt-sccp-initial-state type-segment-bases context params blocks)
    (+
      (+ (ir.compiler-ir-block-list-count blocks) 8)
      (* 2 (ir.compiler-ir-block-list-instruction-count blocks)))))

(define (opt-sccp-analyze-with-frame
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : OptSccpState
  (opt-sccp-analyze-fixed
    type-segment-bases
    blocks
    (opt-sccp-initial-state-with-frame type-segment-bases context params frame)
    (+
      (+ (ir.compiler-ir-block-list-count blocks) 8)
      (* 2 (ir.compiler-ir-block-list-instruction-count blocks)))))

(define (opt-sccp-rewrite-value [env : OptSccpEnv] [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (opt-sccp-env-lookup env id)
        [(OptSccpValue.Const folded _) folded]
        [_ value])]
    [_ value]))

(define (opt-sccp-instr-changes-successors?
  [env : OptSccpEnv]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Branch cond _ _)
      (match (opt-sccp-rewrite-value env cond)
        [(ir.CompilerIrValue.Bool _) true]
        [_ false])]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (match (opt-sccp-rewrite-value env cond)
        [(ir.CompilerIrValue.Bool _) true]
        [_ false])]
    [_ false]))

(define (opt-sccp-instr-seq-changes-successors?
  [env : OptSccpEnv]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-sccp-instr-changes-successors?
      env
      (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-sccp-instr-seq-changes-successors? env instrs (+ index 1)))))

(define (opt-sccp-block-changes-successors?
  [env : OptSccpEnv]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-sccp-instr-seq-changes-successors? env instrs 0)]))

(define (opt-sccp-blocks-change-successors?
  [env : OptSccpEnv]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-sccp-block-changes-successors? env block)
        true
        (opt-sccp-blocks-change-successors? env (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-sccp-blocks-change-successors?
        env
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-sccp-rewrite-maybe-value
  [env : OptSccpEnv]
  [value : ir.CompilerIrMaybeValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrMaybeValue.No) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrMaybeValue.Some inner)
      (ir.CompilerIrMaybeValue.Some (opt-sccp-rewrite-value env inner))]))

(define (opt-sccp-rewrite-call-args-array
  [env : OptSccpEnv]
  [src : (__tl_dyn-array ir.CompilerIrValue)]
  [dst : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-sccp-rewrite-value env (array-ref src index)))
      (opt-sccp-rewrite-call-args-array env src dst (+ index 1)))))

(define (opt-sccp-rewrite-call-args
  [env : OptSccpEnv]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrCallArgs.Nil)]
    [(ir.CompilerIrCallArgs.One value)
      (ir.CompilerIrCallArgs.One (opt-sccp-rewrite-value env value))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (opt-sccp-rewrite-value env a)
        (opt-sccp-rewrite-value env b))]
    [(ir.CompilerIrCallArgs.Array values)
      (let
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue (array-length values))]
        (begin
          (opt-sccp-rewrite-call-args-array env values out 0)
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-sccp-rewrite-spmd-call-arg
  [env : OptSccpEnv]
  [arg : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArg
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class value ty)
      (ir.CompilerIrSpmdCallArg.Arg class (opt-sccp-rewrite-value env value) ty)]))

(define (opt-sccp-rewrite-spmd-call-args-array
  [env : OptSccpEnv]
  [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [dst : (__tl_dyn-array ir.CompilerIrSpmdCallArg)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref dst index)
        (opt-sccp-rewrite-spmd-call-arg env (array-ref src index)))
      (opt-sccp-rewrite-spmd-call-args-array env src dst (+ index 1)))))

(define (opt-sccp-rewrite-spmd-call-args
  [env : OptSccpEnv]
  [args : ir.CompilerIrSpmdCallArgList]) : ir.CompilerIrSpmdCallArgList
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) ir.CompilerIrSpmdCallArgList.Nil]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (ir.CompilerIrSpmdCallArgList.Cons
        (opt-sccp-rewrite-spmd-call-arg env arg)
        (box (opt-sccp-rewrite-spmd-call-args env (__tl-box-place rest))))]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 seq.len]
        [src : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        [out : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
          (array.make-array ir.CompilerIrSpmdCallArg count)]
        (begin
          (opt-sccp-rewrite-spmd-call-args-array env src out 0)
          (ir.CompilerIrSpmdCallArgList.Array
            (ir.CompilerIrSpmdCallArgSeq out count))))]))

(define (opt-sccp-rewrite-phi-inputs
  [env : OptSccpEnv]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-sccp-rewrite-phi-inputs
        env
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-sccp-rewrite-value env value)
        label
        (opt-sccp-rewrite-phi-inputs env (__tl-box-place rest)))]))

(define (opt-sccp-rewrite-scalar-def
  [env : OptSccpEnv]
  [dst : i64]
  [ty : ast.AstType]
  [fallback : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match (opt-sccp-env-lookup env dst)
    [(OptSccpValue.Const value _) (ir.CompilerIrInstr.Mov dst value ty)]
    [_ fallback]))

(define (opt-sccp-rewrite-instr [env : OptSccpEnv] [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst value ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (ir.CompilerIrInstr.Mov dst (opt-sccp-rewrite-value env value) ty))]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        dst
        (opt-sccp-rewrite-value env base)
        (opt-sccp-rewrite-value env offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load dst (opt-sccp-rewrite-value env src) ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-sccp-rewrite-value env ptr)
        (opt-sccp-rewrite-value env value)
        ty)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (ir.CompilerIrInstr.CopyBytes
        (opt-sccp-rewrite-value env dst)
        (opt-sccp-rewrite-value env src)
        size)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        to-ty
        (ir.CompilerIrInstr.Cast
          dst
          (opt-sccp-rewrite-value env src)
          from-ty
          to-ty))]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        dst
        (opt-sccp-rewrite-value env src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        (ir.compiler-ir-binop-result-type op ty)
        (ir.CompilerIrInstr.BinOp
          dst
          op
          (opt-sccp-rewrite-value env lhs)
          (opt-sccp-rewrite-value env rhs)
          ty))]
    [(ir.CompilerIrInstr.UnOp dst op value ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (ir.CompilerIrInstr.UnOp dst op (opt-sccp-rewrite-value env value) ty))]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat dst (opt-sccp-rewrite-value env value) lanes ty)]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (ir.CompilerIrInstr.Call
        dst
        name
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirect dst callee args ty)
      (ir.CompilerIrInstr.CallIndirect
        dst
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst callee args ty)
      (ir.CompilerIrInstr.CallIndirectC
        dst
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-cabi-store-result
          (opt-sccp-rewrite-value env base)
          name
          (opt-sccp-rewrite-call-args env args)
          slots))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-indirect-cabi-store-result
          (opt-sccp-rewrite-value env base)
          (opt-sccp-rewrite-value env callee)
          (opt-sccp-rewrite-call-args env args)
          slots))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (ir.ir-instr-spmd-call
          callee
          backend
          lanes
          (opt-sccp-rewrite-value env active-mask)
          (opt-sccp-rewrite-spmd-call-args env args)
          result))]
    [(ir.CompilerIrInstr.TailCall name args ty)
      (ir.CompilerIrInstr.TailCall
        name
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.Store name value ty)
      (ir.CompilerIrInstr.Store name (opt-sccp-rewrite-value env value) ty)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-sccp-rewrite-value env index)
        (opt-sccp-rewrite-value env length)
        ok-label)]
    [(ir.CompilerIrInstr.EntryArgc _) instr]
    [(ir.CompilerIrInstr.EntryArgv _) instr]
    [(ir.CompilerIrInstr.EntryEnvp _) instr]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (ir.CompilerIrInstr.CpuId
        dst
        (opt-sccp-rewrite-value env leaf)
        (opt-sccp-rewrite-value env subleaf)
        reg-index)]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (ir.CompilerIrInstr.Xgetbv dst (opt-sccp-rewrite-value env index))]
    [(ir.CompilerIrInstr.Syscall dst args)
      (ir.CompilerIrInstr.Syscall dst (opt-sccp-rewrite-call-args env args))]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (let
        [rewritten-cond : ir.CompilerIrValue (opt-sccp-rewrite-value env cond)]
        (match rewritten-cond
          [(ir.CompilerIrValue.Bool known)
            (if known
              (ir.CompilerIrInstr.Jump true-label)
              (ir.CompilerIrInstr.Jump false-label))]
          [_ (ir.CompilerIrInstr.Branch rewritten-cond true-label false-label)]))]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (let
        [rewritten-cond : ir.CompilerIrValue (opt-sccp-rewrite-value env cond)]
        (match rewritten-cond
          [(ir.CompilerIrValue.Bool known)
            (if known
              (ir.CompilerIrInstr.Jump true-label)
              (ir.CompilerIrInstr.Jump false-label))]
          [_
            (ir.CompilerIrInstr.TotalEnumBranch
              rewritten-cond
              true-label
              false-label)]))]
    [(ir.CompilerIrInstr.Return value)
      (ir.CompilerIrInstr.Return (opt-sccp-rewrite-maybe-value env value))]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (opt-sccp-rewrite-scalar-def
        env
        dst
        ty
        (ir.CompilerIrInstr.Phi dst (opt-sccp-rewrite-phi-inputs env inputs) ty))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-bin-op
          dst
          op
          (opt-sccp-rewrite-value env lhs)
          (opt-sccp-rewrite-value env rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-prefix
          dst
          op
          (opt-sccp-rewrite-value env src)
          (opt-sccp-rewrite-value env carry)
          lanes
          ty))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [lane-offset
          (__tl-project-field (__tl-box-place payload-box) lane-offset)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-gather-load
          dst
          (opt-sccp-rewrite-value env base)
          (opt-sccp-rewrite-value env index-base)
          (opt-sccp-rewrite-value env index)
          lane-offset
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (ir.CompilerIrInstr.VectorReduce
        dst
        op
        (opt-sccp-rewrite-value env src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-compare
          dst
          op
          (opt-sccp-rewrite-value env lhs)
          (opt-sccp-rewrite-value env rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-sccp-rewrite-value env lhs)
        (opt-sccp-rewrite-value env rhs)
        lanes)]
    [(ir.CompilerIrInstr.MaskNot dst src lanes)
      (ir.CompilerIrInstr.MaskNot dst (opt-sccp-rewrite-value env src) lanes)]
    [(ir.CompilerIrInstr.MaskReduce dst op src lanes)
      (ir.CompilerIrInstr.MaskReduce
        dst
        op
        (opt-sccp-rewrite-value env src)
        lanes)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [true-value (__tl-project-field (__tl-box-place payload-box) on-true)]
        [false-value (__tl-project-field (__tl-box-place payload-box) on-false)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-select
          dst
          (opt-sccp-rewrite-value env mask)
          (opt-sccp-rewrite-value env true-value)
          (opt-sccp-rewrite-value env false-value)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorLoad dst base index lanes ty)
      (ir.CompilerIrInstr.VectorLoad
        dst
        (opt-sccp-rewrite-value env base)
        (opt-sccp-rewrite-value env index)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-store
          (opt-sccp-rewrite-value env base)
          (opt-sccp-rewrite-value env index)
          (opt-sccp-rewrite-value env value)
          lanes
          ty))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-predicated-store
          (opt-sccp-rewrite-value env base)
          (opt-sccp-rewrite-value env index)
          (opt-sccp-rewrite-value env value)
          (opt-sccp-rewrite-value env mask)
          lanes
          ty))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-predicated-load
          dst
          (opt-sccp-rewrite-value env base)
          (opt-sccp-rewrite-value env index)
          (opt-sccp-rewrite-value env mask)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-shuffle
          dst
          (opt-sccp-rewrite-value env source)
          (opt-sccp-rewrite-value env selector-low)
          (opt-sccp-rewrite-maybe-value env selector-high)
          (opt-sccp-rewrite-value env active-lanes)
          lanes
          ty))]
    [(ir.CompilerIrInstr.TailMask dst index length lanes)
      (ir.CompilerIrInstr.TailMask
        dst
        (opt-sccp-rewrite-value env index)
        (opt-sccp-rewrite-value env length)
        lanes)]
    [(ir.CompilerIrInstr.Alloc _ _) instr]
    [(ir.CompilerIrInstr.AddrOf _ _) instr]
    [(ir.CompilerIrInstr.LaneId _ _ _) instr]
    [(ir.CompilerIrInstr.Jump _) instr]
    ;; Register-group ops carry no SCCP-constant operands to fold.
    [(ir.CompilerIrInstr.Pack _ _ _) instr]
    [(ir.CompilerIrInstr.Word _ _ _ _) instr]
    [(ir.CompilerIrInstr.TailCallIndirect callee args ty)
      (ir.CompilerIrInstr.TailCallIndirect
        (opt-sccp-rewrite-value env callee)
        (opt-sccp-rewrite-call-args env args)
        ty)]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        (opt-sccp-rewrite-value env index)
        base
        cases
        default-label)]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (opt-sccp-rewrite-value env index)
        base
        cases
        default-label
        trap-label)]))

;; Constant propagation can decide a bounds check outright. Only the in-range
;; case is dropped: an out-of-range literal keeps its check so the trap still
;; fires at the same program point.
(define (opt-sccp-bounds-check-in-range? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (match index
        [(ir.CompilerIrValue.I64 idx)
          (match length
            [(ir.CompilerIrValue.I64 len)
              (and (>= idx 0) (>= len 0) (< idx len))]
            [_ false])]
        [_ false])]
    [_ false]))

;; Retain-only rewrite (1:1 substitution, minus the bounds checks SCCP proved
;; in range), so the output length is not known up front: build it with the
;; capacity-managed dense builder seeded at the input length, not a cons
;; accumulator. `opt-sccp-rewrite-instr` is a pure function of `env` and the
;; instruction, so walking forward instead of the old backward-cons produces
;; the identical sequence. Output is fresh; `instrs` is untouched. refs #5726
(define (opt-sccp-rewrite-instr-seq
  [env : OptSccpEnv]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [rewritten : ir.CompilerIrInstr
            (opt-sccp-rewrite-instr
              env
              (ir.compiler-ir-instr-seq-ref instrs index))]
          (begin
            (if (opt-sccp-bounds-check-in-range? rewritten)
              unit
              (ir.compiler-ir-instr-builder-push! (&mut builder) rewritten))
            (set! index (+ index 1)))))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-sccp-rewrite-block [env : OptSccpEnv] [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block label (opt-sccp-rewrite-instr-seq env instrs))]))

(define (opt-sccp-rewrite-blocks
  [env : OptSccpEnv]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-sccp-rewrite-block env block)
        (opt-sccp-rewrite-blocks env (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-sccp-rewrite-blocks env (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-sccp-blocks
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (match (opt-sccp-analyze type-segment-bases context params blocks)
      [(OptSccpState.State _ _ env _ _)
        (if (opt-sccp-env-any-const? env 0)
          (opt-cfg-simplify-blocks (opt-sccp-rewrite-blocks env blocks))
          ;; No constants bound anywhere: the rewrite is the identity, so
          ;; the simplify sees the input blocks either way.
          (opt-cfg-simplify-blocks blocks))])))

(define (opt-sccp-blocks-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptBlockCtxResult
  (match (opt-sccp-analyze type-segment-bases context params blocks)
    [(OptSccpState.State _ _ env _ _)
      (if (opt-sccp-env-any-const? env 0)
        (opt-cfg-simplify-blocks-with-context-result
          (OptBlockCtxResult.Result
            (opt-sccp-rewrite-blocks env blocks)
            context
            (not (opt-sccp-blocks-change-successors? env blocks))))
        ;; No constants: the rewrite is the identity and no branch condition
        ;; can have folded to a literal, so the context is valid as-is.
        (opt-cfg-simplify-blocks-with-context-result
          (OptBlockCtxResult.Result blocks context true)))]))

;; Pipeline entry point that skips the nested cfg-simplify when it can: the
;; pipeline's own cfg pass canonicalizes further down (literal branches folded,
;; unreachable blocks filtered, phis cleaned -- a second application is a
;; no-op), so simplifying here duplicated that stage.
;; opt-sccp-blocks-with-context-result keeps the nested simplify
;; unconditionally for the sccp self-test, which pins it. The context stays
;; valid for the rewrite output exactly when no branch condition folded to a
;; literal (opt-sccp-blocks-change-successors?). The lattice env is sized by
;; the function frame (dense var ids), skipping the max-var walks.
;;
;; When a branch condition *does* fold, the skip cannot be taken. Rewriting
;; `branch <const>, a, b` to `jump a` deletes the edge to `b`, but the phis in
;; `b` still carry an input recorded under this block's label, so the raw
;; rewrite hands on a function that fails `optimizer verify: phi predecessor
;; mismatch`. That was harmless while the cfg pass was the next thing to run,
;; and is not any more: the bool-branch fuser and the jump threader both sit
;; between sccp and cfg and both verify-gate their input, so one folded branch
;; anywhere in a function silently switched both passes off for the whole
;; function -- which is how the merge chains `(when (and a b c) ...)` lowers to
;; kept their `mov $1; jmp; test; je` all the way to the assembler.
;; Canonicalizing here costs one extra simplify on exactly the functions whose
;; CFG changed, and hands every pass downstream IR that verifies.
(define (opt-sccp-blocks-with-context-result-raw
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : OptBlockCtxResult
  (match (opt-sccp-analyze-with-frame
    type-segment-bases
    context
    params
    blocks
    frame)
    [(OptSccpState.State _ _ env _ _)
      (if (opt-sccp-env-any-const? env 0)
        (let
          [successors-changed? : bool
            (opt-sccp-blocks-change-successors? env blocks)]
          [rewritten : ir.CompilerIrBlockList
            (opt-sccp-rewrite-blocks env blocks)]
          (OptBlockCtxResult.Result
            (if successors-changed?
              (opt-cfg-simplify-blocks rewritten)
              rewritten)
            context
            (not successors-changed?)))
        ;; No constants: the rewrite is the identity and the context is
        ;; valid as-is (no branch condition can have folded to a literal).
        (OptBlockCtxResult.Result blocks context true))]))

;; Non-heavy pipeline entry point: identical to opt-sccp-blocks (nested
;; cfg-simplify included) but sizes the lattice env by the function frame
;; instead of walking the whole function for max-var.
(define (opt-sccp-blocks-with-frame
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : ir.CompilerIrBlockList
  (let
    [context : OptCfgContext (opt-cfg-context-build blocks)]
    (match (opt-sccp-analyze-with-frame
      type-segment-bases
      context
      params
      blocks
      frame)
      [(OptSccpState.State _ _ env _ _)
        (if (opt-sccp-env-any-const? env 0)
          (opt-cfg-simplify-blocks (opt-sccp-rewrite-blocks env blocks))
          (opt-cfg-simplify-blocks blocks))])))

(defenum OptSwitchIndexTag
  (No)
  (Some i64 i64))

(defenum OptSwitchCompare
  (No)
  (Some i64 i64 i64 i64 i64 bool))

(defenum OptSwitchCandidate
  (Candidate i64 i64 i64 i64 i64 bool))

(defenum OptSwitchCandidateList
  (Nil)
  (Dense (__tl_dyn-array OptSwitchCandidate) i64))

(define (opt-switch-candidate-ref
  [items : OptSwitchCandidateList]
  [index : i64]) : OptSwitchCandidate
  (match items
    [(OptSwitchCandidateList.Nil)
      (OptSwitchCandidate.Candidate -1 -1 -1 -1 -1 false)]
    [(OptSwitchCandidateList.Dense slots len)
      (array-ref slots (- (- len 1) index))]))

(define (opt-switch-candidate-tail [items : OptSwitchCandidateList]) : OptSwitchCandidateList
  (match items
    [(OptSwitchCandidateList.Nil) (OptSwitchCandidateList.Nil)]
    [(OptSwitchCandidateList.Dense slots len)
      (if (<= len 1)
        (OptSwitchCandidateList.Nil)
        (OptSwitchCandidateList.Dense slots (- len 1)))]))

(define (opt-switch-candidate-cons
  [label : i64]
  [tag : i64]
  [eq-var : i64]
  [arm-label : i64]
  [next-label : i64]
  [total-enum? : bool]
  [items : OptSwitchCandidateList]) : OptSwitchCandidateList
  (let
    [candidate : OptSwitchCandidate
      (OptSwitchCandidate.Candidate
        label
        tag
        eq-var
        arm-label
        next-label
        total-enum?)]
    (match items
      [(OptSwitchCandidateList.Nil)
        (let
          [slots : (__tl_dyn-array OptSwitchCandidate)
            (array.make-array OptSwitchCandidate 4)]
          (begin
            (set! (array-ref slots 0) candidate)
            (OptSwitchCandidateList.Dense slots 1)))]
      [(OptSwitchCandidateList.Dense slots len)
        (if (< len (array-length slots))
          (begin
            (set! (array-ref slots len) candidate)
            (OptSwitchCandidateList.Dense slots (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptSwitchCandidate)
              (array.make-array
                OptSwitchCandidate
                (opt-dense-next-capacity len))]
            [index : i64 0]
            (begin
              (while (< index len)
                (begin
                  (set! (array-ref bigger index) (array-ref slots index))
                  (set! index (+ index 1))))
              (set! (array-ref bigger len) candidate)
              (OptSwitchCandidateList.Dense bigger (+ len 1)))))])))

(defenum OptSwitchMaybeLabel
  (NoLabel)
  (SomeLabel i64))

;; The trailing i64 is the chain head's prefix instruction count: a head block
;; whose compare+branch merely TRAIL other instructions (e.g. a dispatch fetch)
;; keeps those instructions ahead of the emitted Switch. Zero is the classic
;; pure compare+branch head.
(defenum OptMaybeSwitchChain
  (No)
  (Some i64 i64 i64 i64 OptSwitchCandidateList i64))

(defenum OptSwitchRewriteResult
  (Result ir.CompilerIrBlockList OptLabelSet bool))

(define (opt-switch-use-count [uses : (__tl_dyn-array i64)] [var : i64]) : i64
  (if (< var 0)
    0
    (if (>= var (array-length uses))
      0
      (array-ref uses var))))

(define (opt-switch-index-tag-from-values
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptSwitchIndexTag
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (match rhs
        [(ir.CompilerIrValue.I64 tag) (OptSwitchIndexTag.Some var tag)]
        [_ (OptSwitchIndexTag.No)])]
    [(ir.CompilerIrValue.I64 tag)
      (match rhs
        [(ir.CompilerIrValue.Var var) (OptSwitchIndexTag.Some var tag)]
        [_ (OptSwitchIndexTag.No)])]
    [_ (OptSwitchIndexTag.No)]))

(define (opt-switch-parse-compare-block
  [block : ir.CompilerIrBlock]
  [uses : (__tl_dyn-array i64)]) : OptSwitchCompare
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (if (= (ir.compiler-ir-instr-seq-count instrs) 2)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.BinOp eq-var op lhs rhs _)
            (if (opt-binop-eq op ir.CompilerIrBinOp.Eq)
              (match (opt-switch-index-tag-from-values lhs rhs)
                [(OptSwitchIndexTag.Some index-var tag)
                  (match (opt-switch-branch
                    (ir.compiler-ir-instr-seq-ref instrs 1))
                    [(OptSwitchBranch.Some
                        (ir.CompilerIrValue.Var cond-var)
                        arm-label
                        next-label
                        total-enum?)
                      (if (and
                        (= cond-var eq-var)
                        (= (opt-switch-use-count uses eq-var) 1))
                        (OptSwitchCompare.Some
                          index-var
                          tag
                          eq-var
                          arm-label
                          next-label
                          total-enum?)
                        (OptSwitchCompare.No))]
                    [_ (OptSwitchCompare.No)])]
                [(OptSwitchIndexTag.No) (OptSwitchCompare.No)])
              (OptSwitchCompare.No))]
          [_ (OptSwitchCompare.No)])
        (OptSwitchCompare.No))]))

;; Head-block-only variant: the dispatch compare may TRAIL a non-empty prefix
;; of instructions that execute unconditionally before the branch (a bytecode
;; fetch, a length load, ...). Two head forms are recognized:
;;   * `Eq index, tag` + `Branch(eq, arm, next)` -- the general compare;
;;   * `Branch(index, next, arm)` -- a bare zero-test, which is how an
;;     `Eq index, 0` compare surfaces after earlier branch folding: the false
;;     edge is the tag-0 arm, the true edge continues the chain.
;; The chain rewrite keeps the prefix ahead of the Switch, so semantics are
;; unchanged; the same Eq/use-count checks apply to the compare form. A bare
;; zero-test head only completes a chain when the middle blocks compare the
;; SAME var against further literals, which confirms it is a dispatch index.
;; Middle blocks must stay pure compare+branch because they are consumed
;; wholesale by the rewrite. The trailing i64 in Some is the head prefix
;; instruction count kept ahead of the Switch.
(defenum OptSwitchCompareTail
  (No)
  (Some i64 i64 i64 i64 i64 i64 bool))

(defenum OptSwitchBranch
  (No)
  (Some ir.CompilerIrValue i64 i64 bool))

(define (opt-switch-branch [instr : ir.CompilerIrInstr]) : OptSwitchBranch
  (match instr
    [(ir.CompilerIrInstr.Branch cond yes no)
      (OptSwitchBranch.Some cond yes no false)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond yes no)
      (OptSwitchBranch.Some cond yes no true)]
    [_ (OptSwitchBranch.No)]))

(define (opt-switch-parse-compare-block-tail
  [block : ir.CompilerIrBlock]
  [uses : (__tl_dyn-array i64)]) : OptSwitchCompareTail
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (= count 0)
          (OptSwitchCompareTail.No)
          (match (opt-switch-branch
            (ir.compiler-ir-instr-seq-ref instrs (- count 1)))
            [(OptSwitchBranch.Some
                (ir.CompilerIrValue.Var cond-var)
                true-label
                false-label
                total-enum?)
              (if (>= count 2)
                (match (ir.compiler-ir-instr-seq-ref instrs (- count 2))
                  [(ir.CompilerIrInstr.BinOp eq-var op lhs rhs _)
                    (if (and
                      (opt-binop-eq op ir.CompilerIrBinOp.Eq)
                      (= cond-var eq-var)
                      (= (opt-switch-use-count uses eq-var) 1))
                      (match (opt-switch-index-tag-from-values lhs rhs)
                        [(OptSwitchIndexTag.Some index-var tag)
                          (OptSwitchCompareTail.Some
                            index-var
                            tag
                            eq-var
                            true-label
                            false-label
                            (- count 2)
                            total-enum?)]
                        [(OptSwitchIndexTag.No) (OptSwitchCompareTail.No)])
                      (OptSwitchCompareTail.No))]
                  [_
                    (OptSwitchCompareTail.Some
                      cond-var
                      0
                      (- 0 1)
                      false-label
                      true-label
                      (- count 1)
                      total-enum?)])
                (OptSwitchCompareTail.Some
                  cond-var
                  0
                  (- 0 1)
                  false-label
                  true-label
                  0
                  total-enum?))]
            [_ (OptSwitchCompareTail.No)])))]))

;; Chain-head prefix copy facts: a `Mov dst, src` in the head block's prefix
;; means dst and src hold the same value from that point to the dispatch.
;; Block-local copy propagation rewrites same-block compare operands to a
;; copy's source, so the head compare and the middle-block compares may name
;; different vars for the one dispatch value; resolving every candidate var
;; through these facts unifies them onto one logical index var. A pair is
;; dropped as soon as its src is redefined (the copy no longer tracks it),
;; and a redefined dst simply shadows its earlier pair (newest-first lookup).
(defenum OptSwitchCopyEnv
  (Nil)
  (Cons i64 i64 (Box OptSwitchCopyEnv)))

(define (opt-switch-copy-env-resolve [env : OptSwitchCopyEnv] [var : i64]) : i64
  (match env
    [(OptSwitchCopyEnv.Nil) var]
    [(OptSwitchCopyEnv.Cons dst src rest)
      (if (= dst var)
        src
        (opt-switch-copy-env-resolve (__tl-box-place rest) var))]))

(define (opt-switch-copy-env-drop-src [env : OptSwitchCopyEnv] [var : i64]) : OptSwitchCopyEnv
  (match env
    [(OptSwitchCopyEnv.Nil) env]
    [(OptSwitchCopyEnv.Cons dst src rest)
      (if (= src var)
        (opt-switch-copy-env-drop-src (__tl-box-place rest) var)
        (OptSwitchCopyEnv.Cons
          dst
          src
          (box (opt-switch-copy-env-drop-src (__tl-box-place rest) var))))]))

;; Fold one prefix instruction into the copy facts: any definition of var D
;; invalidates pairs whose src is D; a `Mov dst, src` then records dst as a
;; fresh copy of src.
(define (opt-switch-copy-env-note
  [env : OptSwitchCopyEnv]
  [instr : ir.CompilerIrInstr]) : OptSwitchCopyEnv
  (match (opt-instr-def-var instr)
    [(option_i64.Some dst)
      (match instr
        [(ir.CompilerIrInstr.Mov _ (ir.CompilerIrValue.Var src) _)
          (OptSwitchCopyEnv.Cons
            dst
            src
            (box (opt-switch-copy-env-drop-src env dst)))]
        [_ (opt-switch-copy-env-drop-src env dst)])]
    [(option_i64.None) env]))

(define (opt-switch-prefix-copies-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [env : OptSwitchCopyEnv]) : OptSwitchCopyEnv
  (if (>= index last)
    env
    (opt-switch-prefix-copies-from
      instrs
      (+ index 1)
      last
      (opt-switch-copy-env-note env (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-switch-candidate-empty? [items : OptSwitchCandidateList]) : bool
  (match items
    [(OptSwitchCandidateList.Nil) true]
    [_ false]))

(define (opt-switch-candidate-count [items : OptSwitchCandidateList]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) 0]
    [(OptSwitchCandidateList.Dense _ len) len]))

(define (opt-switch-candidates-total-enum-prefix-count-from
  [items : OptSwitchCandidateList]
  [count : i64]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) count]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ _ _ _ _ total-enum?)
          (if total-enum?
            (opt-switch-candidates-total-enum-prefix-count-from
              (opt-switch-candidate-tail items)
              (+ count 1))
            count)])]))

(define (opt-switch-candidates-total-enum? [items : OptSwitchCandidateList]) : bool
  ;; Lowering proves only the final four-comparison suffix. Candidate storage
  ;; exposes the collected chain in reverse, so that suffix is the logical
  ;; prefix here. Earlier ordinary comparisons are allowed after it so a
  ;; complete six-or-more-variant chain can form one total switch. An earlier
  ;; chunk of a long chain has no proved prefix and therefore keeps its range
  ;; check and continuation default.
  (>= (opt-switch-candidates-total-enum-prefix-count-from items 0) 4))

(define (opt-switch-candidate-has-tag?
  [items : OptSwitchCandidateList]
  [tag : i64]) : bool
  (match items
    [(OptSwitchCandidateList.Nil) false]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ item-tag _ _ _ _)
          (if (= item-tag tag)
            true
            (opt-switch-candidate-has-tag?
              (opt-switch-candidate-tail items)
              tag))])]))

(define (opt-switch-candidate-has-label?
  [items : OptSwitchCandidateList]
  [label : i64]) : bool
  (match items
    [(OptSwitchCandidateList.Nil) false]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate item-label _ _ _ _ _)
          (if (= item-label label)
            true
            (opt-switch-candidate-has-label?
              (opt-switch-candidate-tail items)
              label))])]))

(define (opt-switch-candidate-min-from
  [items : OptSwitchCandidateList]
  [current : i64]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) current]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _ _)
          (opt-switch-candidate-min-from
            (opt-switch-candidate-tail items)
            (if (< tag current)
              tag
              current))])]))

(define (opt-switch-candidate-max-from
  [items : OptSwitchCandidateList]
  [current : i64]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) current]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _ _)
          (opt-switch-candidate-max-from
            (opt-switch-candidate-tail items)
            (if (> tag current)
              tag
              current))])]))

(define (opt-switch-candidate-min [items : OptSwitchCandidateList]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) 0]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _ _)
          (opt-switch-candidate-min-from (opt-switch-candidate-tail items) tag)])]))

(define (opt-switch-candidate-max [items : OptSwitchCandidateList]) : i64
  (match items
    [(OptSwitchCandidateList.Nil) 0]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ tag _ _ _ _)
          (opt-switch-candidate-max-from (opt-switch-candidate-tail items) tag)])]))

(define (opt-switch-candidate-label-for-tag
  [items : OptSwitchCandidateList]
  [tag : i64]) : OptSwitchMaybeLabel
  (match items
    [(OptSwitchCandidateList.Nil) (OptSwitchMaybeLabel.NoLabel)]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate _ item-tag _ arm-label _ _)
          (if (= item-tag tag)
            (OptSwitchMaybeLabel.SomeLabel arm-label)
            (opt-switch-candidate-label-for-tag
              (opt-switch-candidate-tail items)
              tag))])]))

;; A tag inside [min-tag, max-tag] that the chain never compares (a HOLE) takes
;; the chain's fall-through edge, exactly like an out-of-range tag: the chain
;; means "if index = t_i goto arm_i, in order, else goto default", and the head
;; is the only entry, so any tag the chain does not name reaches the default.
;; Duplicate tags are rejected during collection, so the arm order carries no
;; extra information. Filling a hole with `default-label` therefore preserves
;; semantics and keeps the case list contiguous, which is the backend's
;; requirement for a jump table.
(define (opt-switch-build-cases-desc
  [items : OptSwitchCandidateList]
  [tag : i64]
  [min-tag : i64]
  [default-label : i64]
  [acc : ir.CompilerIrSwitchCaseList]) : ir.CompilerIrSwitchCaseList
  (if (< tag min-tag)
    acc
    (opt-switch-build-cases-desc
      items
      (- tag 1)
      min-tag
      default-label
      (ir.compiler-ir-switch-case-cons-linked
        tag
        (match (opt-switch-candidate-label-for-tag items tag)
          [(OptSwitchMaybeLabel.SomeLabel label) label]
          [(OptSwitchMaybeLabel.NoLabel) default-label])
        acc))))

(define (opt-switch-build-cases
  [items : OptSwitchCandidateList]
  [min-tag : i64]
  [max-tag : i64]
  [default-label : i64]) : ir.CompilerIrSwitchCaseList
  (ir.compiler-ir-switch-case-list-compact
    (opt-switch-build-cases-desc
      items
      max-tag
      min-tag
      default-label
      ir.CompilerIrSwitchCaseList.Nil)))

(define (opt-switch-total-enum-trap-block [label : i64] [dst : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.Call
        dst
        cbi.compiler-builtin-id-tl-oob-abort
        (ir.CompilerIrCallArgs.Nil)
        (ast.AstType.Unit))
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.Jump label)
        ir.CompilerIrInstrList.Nil))))

;; The final case and trap are intentionally materialized only after the
;; complete per-function optimization fixpoint and the final scratch-reset
;; pass. Mid-pipeline passes carry a pending TotalEnumSwitch: cases 0..N-2,
;; the last exhaustive arm as the default, and no trap label yet.
(defenum OptLateTotalSwitchCases
  (No)
  (Some ir.CompilerIrSwitchCaseList i64))

(defenum OptLateTotalSwitchBlock
  (Unchanged ir.CompilerIrBlock)
  (Rewritten ir.CompilerIrBlock ir.CompilerIrBlock))

(defenum OptLateTotalSwitchBlocks
  (Result ir.CompilerIrBlockList ir.CompilerIrBlockList))

(define (opt-late-total-switch-cases-from
  [cases : ir.CompilerIrSwitchCaseList]
  [expected : i64]
  [final-label : i64]) : OptLateTotalSwitchCases
  (match cases
    [(ir.CompilerIrSwitchCaseList.Nil)
      (OptLateTotalSwitchCases.Some
        (ir.compiler-ir-switch-case-cons-linked
          expected
          final-label
          ir.CompilerIrSwitchCaseList.Nil)
        0)]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case tag label)
          (if (= tag expected)
            (match (opt-late-total-switch-cases-from
              (__tl-box-place rest)
              (+ expected 1)
              final-label)
              [(OptLateTotalSwitchCases.No) (OptLateTotalSwitchCases.No)]
              [(OptLateTotalSwitchCases.Some tail count)
                (OptLateTotalSwitchCases.Some
                  (ir.compiler-ir-switch-case-cons-linked tag label tail)
                  (+ count 1))])
            (OptLateTotalSwitchCases.No))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-late-total-switch-cases-from
        (ir.compiler-ir-switch-case-seq-to-list seq)
        expected
        final-label)]))

(define (opt-late-total-switch-mark-params!
  [occupied : (__tl_dyn-array i64)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (set! (array-ref occupied index) 1)
      (opt-late-total-switch-mark-params! occupied (+ index 1) count))))

(define (opt-late-total-switch-reserve-var!
  [occupied : (__tl_dyn-array i64)]
  [frame-cell : (__tl_dyn-array i64)]
  [index : i64]) : i64
  (if (>= index (array-length occupied))
    (let
      [fresh : i64 (array-ref frame-cell 0)]
      (begin
        (set! (array-ref frame-cell 0) (+ fresh 1))
        fresh))
    (if (= (array-ref occupied index) 0)
      (begin
        (set! (array-ref occupied index) 1)
        index)
      (opt-late-total-switch-reserve-var! occupied frame-cell (+ index 1)))))

(define (opt-late-total-switch-block
  [block : ir.CompilerIrBlock]
  [occupied : (__tl_dyn-array i64)]
  [frame-cell : (__tl_dyn-array i64)]) : OptLateTotalSwitchBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          (OptLateTotalSwitchBlock.Unchanged block)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.TotalEnumSwitch
                index
                base
                cases
                default-label
                existing-trap-label)
              (if (and
                (= base 0)
                (= existing-trap-label (ir.compiler-ir-label-none)))
                (match (opt-late-total-switch-cases-from cases 0 default-label)
                  [(OptLateTotalSwitchCases.No)
                    (OptLateTotalSwitchBlock.Unchanged block)]
                  [(OptLateTotalSwitchCases.Some total-cases case-count)
                    ;; Four comparisons is switch formation's existing gate.
                    ;; Rechecking it here prevents malformed or foreign
                    ;; provenance from authorizing a small Switch shape.
                    (if (< case-count 4)
                      (OptLateTotalSwitchBlock.Unchanged block)
                      (let
                        [trap-label : i64
                          (ir.compiler-ir-label
                            (str_cat.str-cat
                              "match_total_trap__"
                              (ir.compiler-ir-label-text label)))]
                        ;; Switch formation removes at least four compare
                        ;; destinations but deliberately leaves the frame
                        ;; numbering stable. Reuse one such unmentioned slot so
                        ;; the cold abort result cannot perturb register/frame
                        ;; allocation; grow only as a defensive fallback.
                        [trap-var : i64
                          (opt-late-total-switch-reserve-var!
                            occupied
                            frame-cell
                            0)]
                        (OptLateTotalSwitchBlock.Rewritten
                          (ir.compiler-ir-block
                            label
                            (opt-switch-head-instrs
                              instrs
                              0
                              (- count 1)
                              (ir.CompilerIrInstr.TotalEnumSwitch
                                index
                                base
                                (ir.compiler-ir-switch-case-list-compact
                                  total-cases)
                                trap-label
                                trap-label)))
                          (opt-switch-total-enum-trap-block trap-label trap-var))))])
                (OptLateTotalSwitchBlock.Unchanged block))]
            [_ (OptLateTotalSwitchBlock.Unchanged block)])))]))

(define (opt-late-total-switch-blocks
  [blocks : ir.CompilerIrBlockList]
  [occupied : (__tl_dyn-array i64)]
  [frame-cell : (__tl_dyn-array i64)]) : OptLateTotalSwitchBlocks
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptLateTotalSwitchBlocks.Result
        ir.CompilerIrBlockList.Nil
        ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-late-total-switch-block block occupied frame-cell)
        [(OptLateTotalSwitchBlock.Unchanged unchanged)
          (match (opt-late-total-switch-blocks
            (__tl-box-place rest)
            occupied
            frame-cell)
            [(OptLateTotalSwitchBlocks.Result tail traps)
              (OptLateTotalSwitchBlocks.Result
                (ir.compiler-ir-block-cons unchanged tail)
                traps)])]
        [(OptLateTotalSwitchBlock.Rewritten rewritten trap)
          (match (opt-late-total-switch-blocks
            (__tl-box-place rest)
            occupied
            frame-cell)
            [(OptLateTotalSwitchBlocks.Result tail traps)
              (OptLateTotalSwitchBlocks.Result
                (ir.compiler-ir-block-cons rewritten tail)
                (ir.compiler-ir-block-cons trap traps))])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-late-total-switch-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        occupied
        frame-cell)]))

(define (opt-late-total-switch-append-blocks
  [blocks : ir.CompilerIrBlockList]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        block
        (opt-late-total-switch-append-blocks (__tl-box-place rest) tail))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-late-total-switch-append-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        tail)]))

;; A late per-function rewrite paired with whether it changed anything. `false`
;; means the pass left the function's IR alone, so a fused traversal may keep
;; the caller's input instead of materializing the pass output.
(defenum OptLateRewriteResult
  (Result ir.CompilerIrFunction bool))

(define (opt-late-total-switch-function-rewrite
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptLateRewriteResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [frame-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
        [_frame : unit (set! (array-ref frame-cell 0) frame)]
        [occupied : (__tl_dyn-array i64)
          (opt-collect-blocks-uses-array frame blocks)]
        [_defs : unit (opt-successor-sink-fill-all-defs! frame blocks occupied)]
        [_params : unit
          (opt-late-total-switch-mark-params!
            occupied
            0
            (ir.compiler-ir-param-list-count params))]
        [blocks-result : OptLateTotalSwitchBlocks
          (opt-late-total-switch-blocks blocks occupied frame-cell)]
        ;; One trap block is appended per rewritten switch, so an empty trap
        ;; list is exactly "no switch in this function was rewritten".
        [trap-count : i64
          (match blocks-result
            [(OptLateTotalSwitchBlocks.Result _ trap-blocks)
              (ir.compiler-ir-block-list-count trap-blocks)])]
        [next-blocks : ir.CompilerIrBlockList
          (match blocks-result
            [(OptLateTotalSwitchBlocks.Result main-blocks trap-blocks)
              (ir.compiler-ir-block-list-compact
                (opt-late-total-switch-append-blocks main-blocks trap-blocks))])]
        [rewritten : ir.CompilerIrFunction
          (ir.CompilerIrFunction.Function
            name
            params
            ret-ty
            (array-ref frame-cell 0)
            next-blocks)]
        (OptLateRewriteResult.Result
          (compiler-opt-debug-observe-function
            type-segment-bases
            "total_switch"
            rewritten)
          (> trap-count 0)))]))

(define (opt-late-total-switch-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-late-total-switch-function-rewrite type-segment-bases func)
    [(OptLateRewriteResult.Result rewritten _) rewritten]))

(define (opt-switch-block-starts-with-phi? [index : OptCfgIndex] [label : i64]) : bool
  (match (opt-cfg-index-find-block index label)
    [(OptMaybeBlock.No) true]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]))

(define (opt-switch-targets-safe-from?
  [index : OptCfgIndex]
  [all-items : OptSwitchCandidateList]
  [items : OptSwitchCandidateList]
  [default-label : i64]) : bool
  (if (or
    (opt-switch-candidate-has-label? all-items default-label)
    (opt-switch-block-starts-with-phi? index default-label))
    false
    (match items
      [(OptSwitchCandidateList.Nil) true]
      [(OptSwitchCandidateList.Dense _ _)
        (match (opt-switch-candidate-ref items 0)
          [(OptSwitchCandidate.Candidate _ _ _ arm-label _ _)
            (and
              (not (opt-switch-candidate-has-label? all-items arm-label))
              (not (opt-switch-block-starts-with-phi? index arm-label))
              (opt-switch-targets-safe-from?
                index
                all-items
                (opt-switch-candidate-tail items)
                default-label))])])))

(define (opt-switch-targets-safe?
  [index : OptCfgIndex]
  [items : OptSwitchCandidateList]
  [default-label : i64]) : bool
  (opt-switch-targets-safe-from? index items items default-label))

(define (opt-switch-single-pred-from?
  [index : OptCfgIndex]
  [label : i64]
  [pred : i64]) : bool
  (let
    [preds : OptLabelSet (opt-cfg-index-predecessors index label)]
    (and (= (opt-label-count preds) 1) (opt-label-contains preds pred))))

;; Table-formation density floor, as a percentage of the [min, max] span that
;; the chain's own tags must occupy. A gap tag costs one 8-byte table slot and
;; saves nothing, so a chain that is mostly gaps would trade instructions for
;; rodata and D-cache footprint; a compared tag replaces roughly (chain
;; position) compares with one indexed jump. 50% is the standard floor and, on
;; the self-compile, admits the wide AST/IR walkers (65 of 76 `AstExpr` tags,
;; 64 of 67, ...) that an exact-density rule rejected over a handful of gaps.
(define (opt-switch-density-percent) : i64
  50)

;; That floor prices every chain alike, and it should not. What a table REMOVES
;; scales with the chain's LENGTH -- a value no arm accepts walks all of it, two
;; instructions per compare -- while what a table wastes scales with its SPAN.
;; The span a chain can afford is therefore proportional to the compares it
;; removes, so a long chain affords a sparser table than a short one, and one
;; percentage set for the short case refuses exactly the dispatches worth
;; tabling most. Chains of at least `opt-switch-long-chain-count` compares get
;; the lower floor; shorter ones keep the 50% floor above.
;;
;; Pinned two-sided on the corpus. Admitted at the low floor: the lexer's byte
;; dispatch -- 13 tags (9, 10, 13, 32, 34, 39, 40, 41, 44, 59, 91, 93, 96) over
;; a span of 88, 14.7% -- which as a chain walks 26 instructions for every byte
;; that starts a symbol, and which clang tables here too, over that same 88-slot
;; range. Refused, in rising density: an 8-compare chain spanning more than 66
;; slots (below 12%); peephole_lines' 6-tag classifier over a span of 36
;; (16.7%) and its two 4-tag chains over spans of 22 (18.2%) -- short enough to
;; keep the 50% floor, and measured: admitting them costs that row +0.23%,
;; because a sparse early chain preempts a denser later one in the same
;; function; and the 4-tag span-21 chain (19%) the pass self-test pins.
(define (opt-switch-long-chain-count) : i64
  8)

(define (opt-switch-long-chain-density-percent) : i64
  12)

(define (opt-switch-density-percent-for [count : i64]) : i64
  (if (>= count (opt-switch-long-chain-count))
    (opt-switch-long-chain-density-percent)
    (opt-switch-density-percent)))

;; Hard ceiling on the emitted table's entry count. The density floor already
;; bounds the span by a small multiple of the compare count, so this only fires
;; for chains that are pathological in absolute size; it keeps a single match
;; from emitting an unbounded rodata table (and bounds
;; `opt-switch-build-cases-desc` recursion) regardless of the source program.
(define (opt-switch-max-table-entries) : i64
  1024)

(define (opt-switch-span-admissible? [count : i64] [span : i64]) : bool
  (and
    (<= span (opt-switch-max-table-entries))
    (<= (* span (opt-switch-density-percent-for count)) (* count 100))))

(define (opt-switch-finalize-chain
  [index : OptCfgIndex]
  [index-var : i64]
  [items : OptSwitchCandidateList]
  [default-label : i64]
  [head-prefix : i64]) : OptMaybeSwitchChain
  (if (or (= index-var (- 0 1)) (opt-switch-candidate-empty? items))
    (OptMaybeSwitchChain.No)
    (let
      [count : i64 (opt-switch-candidate-count items)]
      [min-tag : i64 (opt-switch-candidate-min items)]
      [max-tag : i64 (opt-switch-candidate-max items)]
      (if (and
        (>= count 4)
        (opt-switch-span-admissible? count (+ (- max-tag min-tag) 1))
        (opt-switch-targets-safe? index items default-label))
        (OptMaybeSwitchChain.Some
          index-var
          min-tag
          max-tag
          default-label
          items
          head-prefix)
        (OptMaybeSwitchChain.No)))))

(define (opt-switch-collect-parsed
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [label : i64]
  [index-var : i64]
  [prev-label : i64]
  [seen : OptLabelSet]
  [items : OptSwitchCandidateList]
  [candidate-index : i64]
  [tag : i64]
  [eq-var : i64]
  [arm-label : i64]
  [next-label : i64]
  [total-enum? : bool]
  [head-prefix : i64]
  [copies : OptSwitchCopyEnv]) : OptMaybeSwitchChain
  ;; Candidate vars read through the head prefix's copy Movs: block-local copy
  ;; propagation rewrites same-block compare operands to a copy's source, so
  ;; the head and middle compares may name different vars for one value.
  (let
    [resolved-index : i64 (opt-switch-copy-env-resolve copies candidate-index)]
    (if (and (!= index-var (- 0 1)) (!= resolved-index index-var))
      (opt-switch-finalize-chain index index-var items label head-prefix)
      (let
        [first? : bool (= index-var (- 0 1))]
        [chain-index : i64
          (if first?
            resolved-index
            index-var)]
        ;; This block cannot JOIN the chain -- it re-tests a tag the table
        ;; already routes, or the rewrite cannot delete it because something
        ;; other than the compare we walked in on reaches it. Stop the chain
        ;; here and keep what it collected: the block stays put and becomes the
        ;; switch's default, which re-tests exactly as it does today. Refusing
        ;; the whole chain instead would throw away every compare already
        ;; folded, and does not even refuse consistently -- whether a chain
        ;; runs into such a block depends on how far it reaches, so a longer
        ;; reach could lose a table a shorter one formed.
        (if (or
          (opt-switch-candidate-has-tag? items tag)
          (and
            (not first?)
            (not (opt-switch-single-pred-from? index label prev-label))))
          (opt-switch-finalize-chain index index-var items label head-prefix)
          (opt-switch-collect-chain
            blocks
            index
            uses
            next-label
            chain-index
            label
            (opt-label-add seen label)
            (opt-switch-candidate-cons
              label
              tag
              eq-var
              (opt-switch-thread-arm index arm-label)
              next-label
              total-enum?
              items)
            head-prefix
            copies))))))

;; `jump L` and nothing else, or `compiler-ir-label-none` for any other block.
;; A dispatch chain often runs THROUGH such a block: an inlined classifier
;; (`(or (= c 32) (= c 9) ...)`) ends its last false edge on an empty join
;; block that the CFG passes leave in place, and the rest of the `cond` chain
;; -- the same scrutinee against further literals -- continues past it. Read as
;; a chain break, that one empty block splits one dispatch into two adjacent
;; tables, and the second table's range check is then paid on top of the
;; first's for every value the first does not hold; continuing across it fuses
;; them into one indexed jump.
(define (opt-switch-block-sole-jump [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (if (= (ir.compiler-ir-instr-seq-count instrs) 1)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Jump target) target]
          [_ (ir.compiler-ir-label-none)])
        (ir.compiler-ir-label-none))]))

;; A compare's true edge often lands on an empty block that only forwards to
;; the real arm -- the `cond` arms of an inlined classifier all join that way.
;; A table entry can name the join target directly, so follow the forwarding
;; before the arm is recorded and spend one indexed jump instead of an indexed
;; jump plus a `jmp`. Unlike the generic CFG straightener this may point SEVERAL
;; entries at one target: a switch names its destinations positionally, so a
;; repeated destination is expressible -- but only where no phi has to name its
;; predecessor edge, hence the phi guard on each hop. The fuel bounds a cycle
;; of forwarding blocks.
(define (opt-switch-thread-arm-fuel) : i64
  8)

(define (opt-switch-thread-arm-from
  [index : OptCfgIndex]
  [label : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    label
    (match (opt-cfg-index-find-block index label)
      [(OptMaybeBlock.No) label]
      [(OptMaybeBlock.Some block)
        (let
          [target : i64 (opt-switch-block-sole-jump block)]
          (if (or
            (= target (ir.compiler-ir-label-none))
            (opt-switch-block-starts-with-phi? index target))
            label
            (opt-switch-thread-arm-from index target (- fuel 1))))])))

(define (opt-switch-thread-arm [index : OptCfgIndex] [label : i64]) : i64
  (opt-switch-thread-arm-from index label (opt-switch-thread-arm-fuel)))

(define (opt-switch-collect-chain
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [label : i64]
  [index-var : i64]
  [prev-label : i64]
  [seen : OptLabelSet]
  [items : OptSwitchCandidateList]
  [head-prefix : i64]
  [copies : OptSwitchCopyEnv]) : OptMaybeSwitchChain
  (if (opt-label-contains seen label)
    (OptMaybeSwitchChain.No)
    (match (opt-cfg-index-find-block index label)
      [(OptMaybeBlock.No)
        (opt-switch-finalize-chain index index-var items label head-prefix)]
      [(OptMaybeBlock.Some block)
        (match (opt-switch-parse-compare-block block uses)
          [(OptSwitchCompare.No)
            ;; A chain may still START here: the head block's compare+branch
            ;; may trail an unconditional prefix (fetch/addressing work) that
            ;; the rewrite preserves ahead of the Switch.
            (if (= index-var (- 0 1))
              (match (opt-switch-parse-compare-block-tail block uses)
                [(OptSwitchCompareTail.No)
                  (opt-switch-finalize-chain index index-var items label 0)]
                [(OptSwitchCompareTail.Some
                    candidate-index
                    tag
                    eq-var
                    arm-label
                    next-label
                    prefix
                    total-enum?)
                  (match block
                    [(ir.CompilerIrBlock.Block _ head-instrs)
                      (opt-switch-collect-parsed
                        blocks
                        index
                        uses
                        label
                        index-var
                        prev-label
                        seen
                        items
                        candidate-index
                        tag
                        eq-var
                        arm-label
                        next-label
                        total-enum?
                        prefix
                        (opt-switch-prefix-copies-from
                          head-instrs
                          0
                          prefix
                          (OptSwitchCopyEnv.Nil)))])])
              ;; Chain in progress: step across one empty forwarding block if
              ;; the edge we arrived on is its only one. The rewrite deletes
              ;; every block the chain walks, so a second predecessor would be
              ;; left jumping into deleted code; a sole predecessor makes the
              ;; block unreachable once the head becomes a Switch, and the
              ;; reachable-order rebuild drops it.
              ;;
              ;; Reaching further can only be tried, never assumed: the longer
              ;; chain may be the one that fails -- its wider span may miss the
              ;; density floor, or the block it ends on may be a phi join no
              ;; default edge can name -- while the chain that stops here would
              ;; have formed a table. So keep the short chain as the fallback.
              (let
                [hop : i64 (opt-switch-block-sole-jump block)]
                (if (and
                  (!= hop (ir.compiler-ir-label-none))
                  (opt-switch-single-pred-from? index label prev-label))
                  (let
                    [hopped : OptMaybeSwitchChain
                      (opt-switch-collect-chain
                        blocks
                        index
                        uses
                        hop
                        index-var
                        label
                        (opt-label-add seen label)
                        items
                        head-prefix
                        copies)]
                    (match hopped
                      [(OptMaybeSwitchChain.No)
                        (opt-switch-finalize-chain
                          index
                          index-var
                          items
                          label
                          head-prefix)]
                      [_ hopped]))
                  (opt-switch-finalize-chain
                    index
                    index-var
                    items
                    label
                    head-prefix))))]
          [(OptSwitchCompare.Some
              candidate-index
              tag
              eq-var
              arm-label
              next-label
              total-enum?)
            (opt-switch-collect-parsed
              blocks
              index
              uses
              label
              index-var
              prev-label
              seen
              items
              candidate-index
              tag
              eq-var
              arm-label
              next-label
              total-enum?
              head-prefix
              copies)])])))

(define (opt-switch-skip-candidate-labels
  [items : OptSwitchCandidateList]
  [first-label : i64]
  [skip : OptLabelSet]) : OptLabelSet
  (match items
    [(OptSwitchCandidateList.Nil) skip]
    [(OptSwitchCandidateList.Dense _ _)
      (match (opt-switch-candidate-ref items 0)
        [(OptSwitchCandidate.Candidate label _ _ _ _ _)
          (opt-switch-skip-candidate-labels
            (opt-switch-candidate-tail items)
            first-label
            (if (= label first-label)
              skip
              (opt-label-add skip label)))])]))

;; Rebuilt head block body: the kept unconditional prefix instructions
;; (usually none) followed by the Switch terminator.
(define (opt-switch-head-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [prefix : i64]
  [terminator : ir.CompilerIrInstr]) : ir.CompilerIrInstrList
  (if (>= index prefix)
    (ir.compiler-ir-instr-cons terminator (ir.CompilerIrInstrList.Nil))
    (ir.compiler-ir-instr-cons
      (ir.compiler-ir-instr-seq-ref instrs index)
      (opt-switch-head-instrs instrs (+ index 1) prefix terminator))))

(define (opt-switch-rewrite-block
  [block : ir.CompilerIrBlock]
  [chain : OptMaybeSwitchChain]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (match chain
        [(OptMaybeSwitchChain.Some
            index-var
            min-tag
            max-tag
            default-label
            items
            head-prefix)
          (ir.compiler-ir-block
            label
            (opt-switch-head-instrs
              instrs
              0
              head-prefix
              ;; The total-enum proof says the chain's fall-through IS the last
              ;; variant's arm, so the range check and the default edge can be
              ;; dropped. A gap-filled table routes uncompared tags to that same
              ;; fall-through, which is only sound while the default is a real
              ;; default; a gapped chain therefore keeps the ordinary Switch
              ;; with its range check even when the proof is present.
              (if (and
                (opt-switch-candidates-total-enum? items)
                (= (+ (- max-tag min-tag) 1) (opt-switch-candidate-count items)))
                (ir.CompilerIrInstr.TotalEnumSwitch
                  (ir.CompilerIrValue.Var index-var)
                  min-tag
                  (opt-switch-build-cases items min-tag max-tag default-label)
                  default-label
                  (ir.compiler-ir-label-none))
                (ir.CompilerIrInstr.Switch
                  (ir.CompilerIrValue.Var index-var)
                  min-tag
                  (opt-switch-build-cases items min-tag max-tag default-label)
                  default-label))))]
        [(OptMaybeSwitchChain.No) block])]))

(define (opt-switch-rewrite-blocks-from
  [remaining : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [skip : OptLabelSet]) : OptSwitchRewriteResult
  (match remaining
    [(ir.CompilerIrBlockList.Nil)
      (OptSwitchRewriteResult.Result (ir.CompilerIrBlockList.Nil) skip false)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (opt-label-contains skip label)
            (match (opt-switch-rewrite-blocks-from
              (__tl-box-place rest)
              all-blocks
              index
              uses
              skip)
              [(OptSwitchRewriteResult.Result tail next-skip _)
                (OptSwitchRewriteResult.Result tail next-skip true)])
            (match (opt-switch-collect-chain
              all-blocks
              index
              uses
              label
              (- 0 1)
              (ir.compiler-ir-label-none)
              (OptLabelSet.Nil)
              (OptSwitchCandidateList.Nil)
              0
              (OptSwitchCopyEnv.Nil))
              [(OptMaybeSwitchChain.Some
                  index-var
                  min-tag
                  max-tag
                  default-label
                  items
                  head-prefix)
                (let
                  [next-skip : OptLabelSet
                    (opt-switch-skip-candidate-labels items label skip)]
                  (match (opt-switch-rewrite-blocks-from
                    (__tl-box-place rest)
                    all-blocks
                    index
                    uses
                    next-skip)
                    [(OptSwitchRewriteResult.Result tail final-skip _)
                      (OptSwitchRewriteResult.Result
                        (ir.compiler-ir-block-cons
                          (opt-switch-rewrite-block
                            block
                            (OptMaybeSwitchChain.Some
                              index-var
                              min-tag
                              max-tag
                              default-label
                              items
                              head-prefix))
                          tail)
                        final-skip
                        true)]))]
              [(OptMaybeSwitchChain.No)
                (match (opt-switch-rewrite-blocks-from
                  (__tl-box-place rest)
                  all-blocks
                  index
                  uses
                  skip)
                  [(OptSwitchRewriteResult.Result tail final-skip changed)
                    (OptSwitchRewriteResult.Result
                      (ir.compiler-ir-block-cons block tail)
                      final-skip
                      changed)])]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-switch-rewrite-blocks-from
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        index
        uses
        skip)]))

;; A switch chain can only start from a two-instruction compare-and-branch
;; block. Most functions have none, so scan for that shape before paying for
;; the use-count array, the CFG index, and the full rewrite walk.
(define (opt-switch-block-is-compare-shaped? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (if (= (ir.compiler-ir-instr-seq-count instrs) 2)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.BinOp eq-var op lhs rhs _)
            (if (opt-binop-eq op ir.CompilerIrBinOp.Eq)
              (match (opt-switch-index-tag-from-values lhs rhs)
                [(OptSwitchIndexTag.Some _ _)
                  (match (opt-switch-branch
                    (ir.compiler-ir-instr-seq-ref instrs 1))
                    [(OptSwitchBranch.Some
                        (ir.CompilerIrValue.Var cond-var)
                        _
                        _
                        _)
                      (= cond-var eq-var)]
                    [_ false])]
                [(OptSwitchIndexTag.No) false])
              false)]
          [_ false])
        false)]))

(define (opt-switch-blocks-have-compare? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-switch-block-is-compare-shaped? block)
        true
        (opt-switch-blocks-have-compare? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-switch-block-seq-has-compare? seq 0)]))

(define (opt-switch-block-seq-has-compare?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (if (opt-switch-block-is-compare-shaped?
      (ir.compiler-ir-block-seq-ref blocks index))
      true
      (opt-switch-block-seq-has-compare? blocks (+ index 1)))))

(define (opt-switch-form-function-pass [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not (opt-switch-blocks-have-compare? blocks))
        (OptFunctionPassResult.Result func false)
        (let
          [uses : (__tl_dyn-array i64)
            (opt-collect-blocks-uses-array frame blocks)]
          [index : OptCfgIndex (opt-cfg-index-build blocks)]
          [rewrite : OptSwitchRewriteResult
            (opt-switch-rewrite-blocks-from
              blocks
              blocks
              index
              uses
              (OptLabelSet.Nil))]
          (match rewrite
            [(OptSwitchRewriteResult.Result rewritten _ changed)
              (if changed
                (let
                  [reachable : ir.CompilerIrBlockList
                    (opt-cfg-reachable-block-order rewritten)]
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      frame
                      reachable)]
                  (match (opt-verify-function next)
                    [(ResultCompilerOptimizeVerify.Ok)
                      (OptFunctionPassResult.Result next true)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      (OptFunctionPassResult.Result func false)]))
                (OptFunctionPassResult.Result func false))])))]))

(define (opt-switch-form-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-switch-form-function-pass func)
    [(OptFunctionPassResult.Result next changed)
      (if changed
        next
        func)]))

;; --- classifier compare chain -> one bitmask test (bit_test) -----------------
;;
;; A `cond`/`or` chain that classifies one value against integer constants --
;; `(or (= c 32) (= c 9) ...)`, `(and (>= c 48) (<= c 57))` or-ed with further
;; ranges -- lowers to one conditional branch per test, walked in source order
;; for every input the chain sees. When all those true edges reach one block
;; `T`, every false edge continues the chain to a final `F`, and the matched
;; constants fit a 64-wide window `[base, base + width]`, the whole chain is
;; exactly a bit test:
;;
;;     d = v - base                       ;; wrapping, read unsigned
;;     if d >u width -> F
;;     if ((mask >>u d) & 1) != 0 -> T else F
;;
;; two branches instead of one per link, and no per-link compare. This is the
;; bit-test cluster a C compiler forms from the same source.
;;
;; The rewrite only replaces the chain head's terminator: the remaining link
;; blocks are no longer reachable through it and drop out with the reachability
;; filter, so a link some other edge still enters keeps working unchanged and no
;; phi predecessor moves. Link blocks must therefore be pure -- their own
;; compare plus their branch, nothing else -- and every link must test the same
;; var, which is what makes dropping the path they describe sound. Windows wider
;; than 64, chains shorter than the profitability floor, mixed test values and
;; side-effecting links are refused rather than split.
;; Two branches plus a subtract, a range compare, a shift and a mask test cost
;; about as much as three tests taken in sequence, and a refused chain costs
;; nothing, so the floor sits where the average walk of the chain being replaced
;; is clearly longer than that. Equality-only chains of three or four links --
;; `(or (= c 32) (= c 9) (= c 10) (= c 13))` -- are left alone on purpose: their
;; first test already answers most inputs.
(define (opt-bit-test-min-links) : i64
  6)

(define (opt-bit-test-max-links) : i64
  32)

(define (opt-bit-test-max-plans) : i64
  8)

;; Vars one conversion introduces: mask, offset, window guard, shift, bit test,
;; masked offset.
(define (opt-bit-test-plan-vars) : i64
  6)

(define (opt-bit-test-window-width) : i64
  64)

;; Forwarding blocks between a link and its target are lowering artifacts a
;; later straightening pass removes; resolving through a bounded run of them
;; here lets the chain be recognized before that runs. The bound also
;; terminates on a jump-only cycle.
(define (opt-bit-test-max-hops) : i64
  8)

;; Constants far from zero are refused up front so every `bound + 1`, `hi - lo`
;; and `lo - base` below stays exact in i64.
(define (opt-bit-test-bound-limit) : i64
  1099511627776)

(define (opt-bit-test-bound-ok? [bound : i64]) : bool
  (and
    (>= bound (- 0 (opt-bit-test-bound-limit)))
    (<= bound (opt-bit-test-bound-limit))))

;; 0 = not a constant compare, 1 = Eq, 2 = Lt, 3 = Le, 4 = Gt, 5 = Ge.
(define (opt-bit-test-compare-kind [op : ir.CompilerIrBinOp]) : i64
  (match op
    [(ir.CompilerIrBinOp.Eq) 1]
    [(ir.CompilerIrBinOp.Lt) 2]
    [(ir.CompilerIrBinOp.Le) 3]
    [(ir.CompilerIrBinOp.Gt) 4]
    [(ir.CompilerIrBinOp.Ge) 5]
    [_ 0]))

;; `k OP v` reads as `v OP' k`.
(define (opt-bit-test-swap-kind [kind : i64]) : i64
  (cond [(= kind 2) 4] [(= kind 3) 5] [(= kind 4) 2] [(= kind 5) 3] [else kind]))

(define (opt-bit-test-lower-kind? [kind : i64]) : bool
  (or (= kind 4) (= kind 5)))

(define (opt-bit-test-upper-kind? [kind : i64]) : bool
  (or (= kind 2) (= kind 3)))

;; Signedness travels with the compare's operand type, and only the signed
;; 64-bit form is admitted: the emitted window guard reads `v - base` as
;; unsigned, which is the same membership test only when the chain's compares
;; and that subtraction see the same 64-bit operand width.
(define (opt-bit-test-i64-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [_ false]))

;; Normalized `v OP k` facts for every constant compare in the function, indexed
;; by destination var. A chain link may branch on a compare defined in a
;; dominating block -- value numbering unifies a test the surrounding code
;; already made -- so the facts are collected function-wide instead of being
;; read out of the link block.
(defstruct OptBitTestCompareFacts
  (kinds (__tl_dyn-array i64))
  (values (__tl_dyn-array i64))
  (bounds (__tl_dyn-array i64)))

(define (opt-bit-test-facts-new [frame : i64]) : OptBitTestCompareFacts
  (let
    [size : i64
      (if (> frame 0)
        frame
        0)]
    (OptBitTestCompareFacts
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size))))

(define (opt-bit-test-fact-kind [facts : OptBitTestCompareFacts] [var : i64]) : i64
  (let
    [kinds : (__tl_dyn-array i64) facts.kinds]
    (if (and (>= var 0) (< var (array-length kinds)))
      (array-ref kinds var)
      0)))

(define (opt-bit-test-fact-value [facts : OptBitTestCompareFacts] [var : i64]) : i64
  (let
    [values : (__tl_dyn-array i64) facts.values]
    (if (and (>= var 0) (< var (array-length values)))
      (array-ref values var)
      (- 0 1))))

(define (opt-bit-test-fact-bound [facts : OptBitTestCompareFacts] [var : i64]) : i64
  (let
    [bounds : (__tl_dyn-array i64) facts.bounds]
    (if (and (>= var 0) (< var (array-length bounds)))
      (array-ref bounds var)
      0)))

(define (opt-bit-test-facts-record!
  [facts : OptBitTestCompareFacts]
  [dst : i64]
  [kind : i64]
  [value-var : i64]
  [bound : i64]) : unit
  (let
    [kinds : (__tl_dyn-array i64) facts.kinds]
    (if (and
      (>= dst 0)
      (< dst (array-length kinds))
      (opt-bit-test-bound-ok? bound))
      (begin
        (set! (array-ref kinds dst) kind)
        (set! (array-ref facts.values dst) value-var)
        (set! (array-ref facts.bounds dst) bound))
      unit)))

(define (opt-bit-test-facts-scan-instr!
  [facts : OptBitTestCompareFacts]
  [instr : ir.CompilerIrInstr]) : unit
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (let
        [kind : i64 (opt-bit-test-compare-kind op)]
        (if (and (> kind 0) (opt-bit-test-i64-type? ty))
          (match lhs
            [(ir.CompilerIrValue.Var value-var)
              (match rhs
                [(ir.CompilerIrValue.I64 bound)
                  (opt-bit-test-facts-record! facts dst kind value-var bound)]
                [_ unit])]
            [(ir.CompilerIrValue.I64 bound)
              (match rhs
                [(ir.CompilerIrValue.Var value-var)
                  (opt-bit-test-facts-record!
                    facts
                    dst
                    (opt-bit-test-swap-kind kind)
                    value-var
                    bound)]
                [_ unit])]
            [_ unit])
          unit))]
    [_ unit]))

(define (opt-bit-test-facts-scan-seq!
  [facts : OptBitTestCompareFacts]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [index : i64 0]
    (while (< index count)
      (begin
        (opt-bit-test-facts-scan-instr!
          facts
          (ir.compiler-ir-instr-seq-ref instrs index))
        (set! index (+ index 1))))))

(define (opt-bit-test-facts-scan-blocks!
  [facts : OptBitTestCompareFacts]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-bit-test-facts-scan-seq! facts instrs)
            (opt-bit-test-facts-scan-blocks! facts (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bit-test-facts-scan-blocks!
        facts
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-bit-test-facts-build
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : OptBitTestCompareFacts
  (let
    [facts : OptBitTestCompareFacts (opt-bit-test-facts-new frame)]
    (begin
      (opt-bit-test-facts-scan-blocks! facts blocks)
      facts)))

;; A link block holds nothing but its branch, optionally preceded by the compare
;; that defines the branch condition. Anything else would be dropped along with
;; the path the rewrite replaces.
(define (opt-bit-test-block-pure-link?
  [instrs : ir.CompilerIrInstrSeq]
  [count : i64]
  [cond-var : i64]) : bool
  (if (= count 1)
    true
    (if (= count 2)
      (match (ir.compiler-ir-instr-seq-ref instrs 0)
        [(ir.CompilerIrInstr.BinOp dst _ _ _ _) (= dst cond-var)]
        [_ false])
      false)))

(defenum OptBitTestBranch
  (No)
  ;; condition var, true label, false label, pure link block?
  (Some i64 i64 i64 bool))

(define (opt-bit-test-block-branch [block : ir.CompilerIrBlock]) : OptBitTestBranch
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (= count 0)
          (OptBitTestBranch.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond yes no)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (OptBitTestBranch.Some
                    cond-var
                    yes
                    no
                    (opt-bit-test-block-pure-link? instrs count cond-var))]
                [_ (OptBitTestBranch.No)])]
            [_ (OptBitTestBranch.No)])))]))

;; A converted chain must land on blocks whose phis do not name the link labels
;; the rewrite stops entering. Requiring the branch targets to be phi-free is
;; the cheap sufficient form of that: link blocks only ever branch to the shared
;; true target, the next link, or a forwarding block on the way to either.
(define (opt-bit-test-block-phi-free? [index : OptCfgIndex] [label : i64]) : bool
  (match (opt-cfg-index-find-block index label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 0)
            true
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ _ _) false]
              [_ true]))])]))

;; Forwarding is followed only while the block behind it does not open with a
;; phi: a phi reads its input by predecessor label, so the last forwarding block
;; ahead of a merge is where an edge has to keep landing.
(define (opt-bit-test-resolve-label
  [index : OptCfgIndex]
  [label : i64]
  [hops : i64]) : i64
  (if (<= hops 0)
    label
    (match (opt-cfg-index-find-block index label)
      [(OptMaybeBlock.No) label]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (if (= (ir.compiler-ir-instr-seq-count instrs) 1)
              (match (ir.compiler-ir-instr-seq-ref instrs 0)
                [(ir.CompilerIrInstr.Jump next)
                  (if (opt-bit-test-block-phi-free? index next)
                    (opt-bit-test-resolve-label index next (- hops 1))
                    label)]
                [_ label])
              label)])])))

(define (opt-bit-test-ones [width : i64]) : i64
  (if (>= width 64)
    (- 0 1)
    (- (shl 1 width) 1)))

(defenum OptBitTestMaybeLink
  (No)
  ;; lo, hi, bit mask relative to lo, true target, next target
  (Some i64 i64 i64 i64 i64))

;; `(and (>= v lo) (<= v hi))` lowers to a lower-bound block whose true edge is
;; the upper-bound block and whose false edge is the chain's continuation; the
;; upper-bound block shares that continuation. Either bound may come first.
(define (opt-bit-test-parse-range-link
  [index : OptCfgIndex]
  [facts : OptBitTestCompareFacts]
  [value-var : i64]
  [kind : i64]
  [bound : i64]
  [inner-label : i64]
  [next : i64]) : OptBitTestMaybeLink
  (match (opt-cfg-index-find-block index inner-label)
    [(OptMaybeBlock.No) (OptBitTestMaybeLink.No)]
    [(OptMaybeBlock.Some block)
      (match (opt-bit-test-block-branch block)
        [(OptBitTestBranch.No) (OptBitTestMaybeLink.No)]
        [(OptBitTestBranch.Some inner-cond inner-yes inner-no inner-pure?)
          (let
            [inner-kind : i64 (opt-bit-test-fact-kind facts inner-cond)]
            [inner-var : i64 (opt-bit-test-fact-value facts inner-cond)]
            [inner-bound : i64 (opt-bit-test-fact-bound facts inner-cond)]
            [inner-next : i64
              (opt-bit-test-resolve-label
                index
                inner-no
                (opt-bit-test-max-hops))]
            [paired? : bool
              (and
                inner-pure?
                (> inner-kind 0)
                (= inner-var value-var)
                (= inner-next next)
                (or
                  (and
                    (opt-bit-test-lower-kind? kind)
                    (opt-bit-test-upper-kind? inner-kind))
                  (and
                    (opt-bit-test-upper-kind? kind)
                    (opt-bit-test-lower-kind? inner-kind))))]
            [lo : i64
              (if (opt-bit-test-lower-kind? kind)
                (if (= kind 4)
                  (+ bound 1)
                  bound)
                (if (= inner-kind 4)
                  (+ inner-bound 1)
                  inner-bound))]
            [hi : i64
              (if (opt-bit-test-upper-kind? kind)
                (if (= kind 2)
                  (- bound 1)
                  bound)
                (if (= inner-kind 2)
                  (- inner-bound 1)
                  inner-bound))]
            (if (and
              paired?
              (<= lo hi)
              (< (- hi lo) (opt-bit-test-window-width)))
              (OptBitTestMaybeLink.Some
                lo
                hi
                (opt-bit-test-ones (+ (- hi lo) 1))
                (opt-bit-test-resolve-label
                  index
                  inner-yes
                  (opt-bit-test-max-hops))
                next)
              (OptBitTestMaybeLink.No)))])]))

(define (opt-bit-test-parse-link
  [index : OptCfgIndex]
  [facts : OptBitTestCompareFacts]
  [value-var : i64]
  [label : i64]
  [head? : bool]) : OptBitTestMaybeLink
  (match (opt-cfg-index-find-block index label)
    [(OptMaybeBlock.No) (OptBitTestMaybeLink.No)]
    [(OptMaybeBlock.Some block)
      (match (opt-bit-test-block-branch block)
        [(OptBitTestBranch.No) (OptBitTestMaybeLink.No)]
        [(OptBitTestBranch.Some cond-var yes no pure?)
          (let
            [kind : i64 (opt-bit-test-fact-kind facts cond-var)]
            [fact-var : i64 (opt-bit-test-fact-value facts cond-var)]
            [bound : i64 (opt-bit-test-fact-bound facts cond-var)]
            [true-label : i64
              (opt-bit-test-resolve-label index yes (opt-bit-test-max-hops))]
            [next : i64
              (opt-bit-test-resolve-label index no (opt-bit-test-max-hops))]
            (if (or
              (and (not head?) (not pure?))
              (= kind 0)
              (!= fact-var value-var))
              (OptBitTestMaybeLink.No)
              (if (= kind 1)
                (OptBitTestMaybeLink.Some bound bound 1 true-label next)
                (opt-bit-test-parse-range-link
                  index
                  facts
                  value-var
                  kind
                  bound
                  true-label
                  next))))])]))

;; Collected links of one chain, oldest first. Allocated once per function and
;; refilled for each candidate head.
(defstruct OptBitTestChain
  (los (__tl_dyn-array i64))
  (his (__tl_dyn-array i64))
  (masks (__tl_dyn-array i64))
  (labels (__tl_dyn-array i64))
  (nexts (__tl_dyn-array i64)))

(define (opt-bit-test-chain-new) : OptBitTestChain
  (let
    [size : i64 (opt-bit-test-max-links)]
    (OptBitTestChain
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size))))

(define (opt-bit-test-chain-visited?
  [chain : OptBitTestChain]
  [count : i64]
  [label : i64]) : bool
  (let
    [labels : (__tl_dyn-array i64) chain.labels]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (< index count)
        (if (= (array-ref labels index) label)
          (begin
            (set! found true)
            (set! index count))
          (set! index (+ index 1))))
      found)))

(defenum OptBitTestMaybeChain
  (No)
  ;; link count, shared true target
  (Some i64 i64))

(define (opt-bit-test-collect-chain
  [index : OptCfgIndex]
  [facts : OptBitTestCompareFacts]
  [chain : OptBitTestChain]
  [value-var : i64]
  [head-label : i64]) : OptBitTestMaybeChain
  (let
    [los : (__tl_dyn-array i64) chain.los]
    [his : (__tl_dyn-array i64) chain.his]
    [masks : (__tl_dyn-array i64) chain.masks]
    [labels : (__tl_dyn-array i64) chain.labels]
    [nexts : (__tl_dyn-array i64) chain.nexts]
    [limit : i64 (opt-bit-test-max-links)]
    [count : i64 0]
    [label : i64 head-label]
    [true-label : i64 (- 0 1)]
    [walking? : bool true]
    (begin
      (while (and walking? (< count limit))
        (match (opt-bit-test-parse-link index facts value-var label (= count 0))
          [(OptBitTestMaybeLink.No) (set! walking? false)]
          [(OptBitTestMaybeLink.Some lo hi mask link-true link-next)
            (if (and (> count 0) (!= link-true true-label))
              (set! walking? false)
              (begin
                (set! true-label link-true)
                (set! (array-ref los count) lo)
                (set! (array-ref his count) hi)
                (set! (array-ref masks count) mask)
                (set! (array-ref labels count) label)
                (set! (array-ref nexts count) link-next)
                (set! count (+ count 1))
                (if (opt-bit-test-chain-visited? chain count link-next)
                  (set! walking? false)
                  (set! label link-next))))]))
      (if (= count 0)
        (OptBitTestMaybeChain.No)
        (OptBitTestMaybeChain.Some count true-label)))))

;; Longest run of links starting at `start` whose constants share a 64-wide
;; window. Used both for the run the rewrite would take (`start` 0) and for the
;; best run anywhere in the chain: converting only when the leading run IS the
;; best run keeps the choice independent of which block the scan happened to
;; enter the chain from, because a better run further down is reached later as
;; its own head.
(define (opt-bit-test-run-length
  [chain : OptBitTestChain]
  [count : i64]
  [start : i64]) : i64
  (let
    [los : (__tl_dyn-array i64) chain.los]
    [his : (__tl_dyn-array i64) chain.his]
    [low : i64 (array-ref los start)]
    [high : i64 (array-ref his start)]
    [index : i64 start]
    [length : i64 0]
    [running? : bool true]
    (begin
      (while (and running? (< index count))
        (let
          [next-low : i64
            (if (< (array-ref los index) low)
              (array-ref los index)
              low)]
          [next-high : i64
            (if (> (array-ref his index) high)
              (array-ref his index)
              high)]
          (if (>= (- next-high next-low) (opt-bit-test-window-width))
            (set! running? false)
            (begin
              (set! low next-low)
              (set! high next-high)
              (set! length (+ length 1))
              (set! index (+ index 1))))))
      length)))

(define (opt-bit-test-best-run-length [chain : OptBitTestChain] [count : i64]) : i64
  (let
    [start : i64 0]
    [best : i64 0]
    (begin
      (while (< start count)
        (let
          [length : i64 (opt-bit-test-run-length chain count start)]
          (begin
            (if (> length best)
              (set! best length)
              unit)
            (set! start (+ start 1)))))
      best)))

(define (opt-bit-test-run-base [chain : OptBitTestChain] [length : i64]) : i64
  (let
    [los : (__tl_dyn-array i64) chain.los]
    [index : i64 1]
    [base : i64 (array-ref los 0)]
    (begin
      (while (< index length)
        (begin
          (if (< (array-ref los index) base)
            (set! base (array-ref los index))
            unit)
          (set! index (+ index 1))))
      base)))

(define (opt-bit-test-run-top [chain : OptBitTestChain] [length : i64]) : i64
  (let
    [his : (__tl_dyn-array i64) chain.his]
    [index : i64 1]
    [top : i64 (array-ref his 0)]
    (begin
      (while (< index length)
        (begin
          (if (> (array-ref his index) top)
            (set! top (array-ref his index))
            unit)
          (set! index (+ index 1))))
      top)))

(define (opt-bit-test-run-mask
  [chain : OptBitTestChain]
  [length : i64]
  [base : i64]) : i64
  (let
    [los : (__tl_dyn-array i64) chain.los]
    [masks : (__tl_dyn-array i64) chain.masks]
    [index : i64 0]
    [mask : i64 0]
    (begin
      (while (< index length)
        (begin
          (set!
            mask
            (bit-or
              mask
              (shl (array-ref masks index) (- (array-ref los index) base))))
          (set! index (+ index 1))))
      mask)))

;; Accepted conversions, keyed by chain-head label.
(defstruct OptBitTestPlans
  (heads (__tl_dyn-array i64))
  (values (__tl_dyn-array i64))
  (bases (__tl_dyn-array i64))
  (widths (__tl_dyn-array i64))
  (masks (__tl_dyn-array i64))
  (trues (__tl_dyn-array i64))
  (falses (__tl_dyn-array i64))
  (used (__tl_dyn-array i64)))

(define (opt-bit-test-plans-new) : OptBitTestPlans
  (let
    [size : i64 (opt-bit-test-max-plans)]
    (OptBitTestPlans
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 size)
      (array.make-array i64 1))))

(define (opt-bit-test-plans-count [plans : OptBitTestPlans]) : i64
  (array-ref plans.used 0))

(define (opt-bit-test-plans-add!
  [plans : OptBitTestPlans]
  [head : i64]
  [value-var : i64]
  [base : i64]
  [width : i64]
  [mask : i64]
  [true-label : i64]
  [false-label : i64]) : unit
  (let
    [slot : i64 (opt-bit-test-plans-count plans)]
    (if (< slot (opt-bit-test-max-plans))
      (begin
        (set! (array-ref plans.heads slot) head)
        (set! (array-ref plans.values slot) value-var)
        (set! (array-ref plans.bases slot) base)
        (set! (array-ref plans.widths slot) width)
        (set! (array-ref plans.masks slot) mask)
        (set! (array-ref plans.trues slot) true-label)
        (set! (array-ref plans.falses slot) false-label)
        (set! (array-ref plans.used 0) (+ slot 1)))
      unit)))

(define (opt-bit-test-plans-slot [plans : OptBitTestPlans] [head : i64]) : i64
  (let
    [heads : (__tl_dyn-array i64) plans.heads]
    [limit : i64 (opt-bit-test-plans-count plans)]
    [index : i64 0]
    [found : i64 (- 0 1)]
    (begin
      (while (< index limit)
        (if (= (array-ref heads index) head)
          (begin
            (set! found index)
            (set! index limit))
          (set! index (+ index 1))))
      found)))

;; The head's own tested value: read out of the compare its branch consumes.
(define (opt-bit-test-head-value-var
  [facts : OptBitTestCompareFacts]
  [block : ir.CompilerIrBlock]) : i64
  (match (opt-bit-test-block-branch block)
    [(OptBitTestBranch.No) (- 0 1)]
    [(OptBitTestBranch.Some cond-var _ _ _)
      (if (= (opt-bit-test-fact-kind facts cond-var) 0)
        (- 0 1)
        (opt-bit-test-fact-value facts cond-var))]))

(define (opt-bit-test-skip-links
  [chain : OptBitTestChain]
  [length : i64]
  [skip : OptLabelSet]) : OptLabelSet
  (let
    [labels : (__tl_dyn-array i64) chain.labels]
    [index : i64 0]
    [next : OptLabelSet skip]
    (begin
      (while (< index length)
        (begin
          (set! next (opt-label-add next (array-ref labels index)))
          (set! index (+ index 1))))
      next)))

(define (opt-bit-test-plan-head!
  [index : OptCfgIndex]
  [facts : OptBitTestCompareFacts]
  [chain : OptBitTestChain]
  [plans : OptBitTestPlans]
  [skip : OptLabelSet]
  [block : ir.CompilerIrBlock]) : OptLabelSet
  (match block
    [(ir.CompilerIrBlock.Block head-label _)
      (if (opt-label-contains skip head-label)
        skip
        (let
          [value-var : i64 (opt-bit-test-head-value-var facts block)]
          (if (< value-var 0)
            skip
            (match (opt-bit-test-collect-chain
              index
              facts
              chain
              value-var
              head-label)
              [(OptBitTestMaybeChain.No) skip]
              [(OptBitTestMaybeChain.Some count true-label)
                (let
                  [length : i64 (opt-bit-test-run-length chain count 0)]
                  [best : i64 (opt-bit-test-best-run-length chain count)]
                  [false-label : i64 (array-ref chain.nexts (- length 1))]
                  (if (and
                    (>= length (opt-bit-test-min-links))
                    (= length best)
                    (!= true-label false-label)
                    (opt-bit-test-block-phi-free? index true-label)
                    (opt-bit-test-block-phi-free? index false-label))
                    (let
                      [base : i64 (opt-bit-test-run-base chain length)]
                      [top : i64 (opt-bit-test-run-top chain length)]
                      (begin
                        (opt-bit-test-plans-add!
                          plans
                          head-label
                          value-var
                          base
                          (- top base)
                          (opt-bit-test-run-mask chain length base)
                          true-label
                          false-label)
                        (opt-bit-test-skip-links chain length skip)))
                    skip))]))))]))

(define (opt-bit-test-plan-blocks!
  [index : OptCfgIndex]
  [facts : OptBitTestCompareFacts]
  [chain : OptBitTestChain]
  [plans : OptBitTestPlans]
  [blocks : ir.CompilerIrBlockList]
  [skip : OptLabelSet]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bit-test-plan-blocks!
        index
        facts
        chain
        plans
        (__tl-box-place rest)
        (opt-bit-test-plan-head! index facts chain plans skip block))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bit-test-plan-blocks!
        index
        facts
        chain
        plans
        (ir.compiler-ir-block-seq-to-list seq)
        skip)]))

(define (opt-bit-test-candidate-label [head : i64] [suffix : i64]) : i64
  (ir.compiler-ir-label
    (if (= suffix 0)
      (str_cat.str-cat (ir.compiler-ir-label-text head) "__bit_test")
      (str_cat.str-cat
        (ir.compiler-ir-label-text head)
        "__bit_test"
        (string.int->string suffix)))))

(define (opt-bit-test-fresh-label
  [blocks : ir.CompilerIrBlockList]
  [head : i64]
  [suffix : i64]) : i64
  (let
    [candidate : i64 (opt-bit-test-candidate-label head suffix)]
    (if (opt-cfg-block-exists? blocks candidate)
      (opt-bit-test-fresh-label blocks head (+ suffix 1))
      candidate)))

;; The head's instructions ahead of its branch, oldest first. Everything the
;; head already computed stays: it ran unconditionally before the rewrite and
;; still does. Its own compare becomes dead and DCE retires it.
(define (opt-bit-test-head-prefix
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [tail : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (if (< index 0)
    tail
    (opt-bit-test-head-prefix
      instrs
      (- index 1)
      (ir.compiler-ir-instr-cons
        (ir.compiler-ir-instr-seq-ref instrs index)
        tail))))

;; The mask is materialized in the HEAD block rather than folded into the shift
;; operand: as its own loop-invariant value it is hoisted out of the loop and,
;; more importantly, the allocator sees it and the offset live at the same point
;; and gives them two registers, which is what lets the backend lower the test
;; as a bare `bt` instead of scavenging a scratch around a real shift.
(define (opt-bit-test-rewrite-head
  [block : ir.CompilerIrBlock]
  [value-var : i64]
  [base : i64]
  [width : i64]
  [mask : i64]
  [false-label : i64]
  [mask-label : i64]
  [mask-var : i64]
  [offset-var : i64]
  [guard-var : i64]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.compiler-ir-block
        label
        (opt-bit-test-head-prefix
          instrs
          (- (ir.compiler-ir-instr-seq-count instrs) 2)
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Mov
              mask-var
              (ir.CompilerIrValue.I64 mask)
              (ast.AstType.U64))
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                offset-var
                (ir.CompilerIrBinOp.Sub)
                (ir.CompilerIrValue.Var value-var)
                (ir.CompilerIrValue.I64 base)
                (ast.AstType.U64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  guard-var
                  (ir.CompilerIrBinOp.Le)
                  (ir.CompilerIrValue.Var offset-var)
                  (ir.CompilerIrValue.I64 width)
                  (ast.AstType.U64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var guard-var)
                    mask-label
                    false-label)
                  ir.CompilerIrInstrList.Nil))))))]))

;; The shift count is spelled `offset & 63` rather than bare `offset`. The two
;; are the same value on every edge that reaches this block -- the head block's
;; window guard admits it only when `offset <=u width` and a plan's width is at
;; most 63 (opt-bit-test-run-length, opt-bit-test-window-width) -- so the mask
;; changes nothing the chain computes. What it changes is what the BACKEND can
;; prove: a count masked to 6 bits cannot be an out-of-range shift, so the
;; shift-count guard in front of the `bt` (cmp $64/jb, two instructions on the
;; hot path) is provably dead and the lowering drops it, folding the mask into
;; `bt`'s own modulo-64 reading of its offset
;; (compiler-backend-bit-test-masked-count-match). Written as ordinary IR
;; rather than as a side-channel fact, so the same relief reaches a hand-written
;; `(!= (bit-and (shr MASK (bit-and d 63)) 1) 0)` and so every pass between here
;; and emission keeps reading a total, self-describing instruction.
(define (opt-bit-test-mask-block
  [mask-label : i64]
  [true-label : i64]
  [false-label : i64]
  [mask-var : i64]
  [offset-var : i64]
  [shift-var : i64]
  [test-var : i64]
  [masked-var : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    mask-label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.BinOp
        masked-var
        (ir.CompilerIrBinOp.BitAnd)
        (ir.CompilerIrValue.Var offset-var)
        (ir.CompilerIrValue.I64 (- (opt-bit-test-window-width) 1))
        (ast.AstType.U64))
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.BinOp
          shift-var
          (ir.CompilerIrBinOp.Shr (ast.AstType.U64))
          (ir.CompilerIrValue.Var mask-var)
          (ir.CompilerIrValue.Var masked-var)
          (ast.AstType.U64))
        (ir.compiler-ir-instr-cons
          (ir.CompilerIrInstr.BinOp
            test-var
            (ir.CompilerIrBinOp.BitTestNe)
            (ir.CompilerIrValue.Var shift-var)
            (ir.CompilerIrValue.I64 1)
            (ast.AstType.U64))
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Branch
              (ir.CompilerIrValue.Var test-var)
              true-label
              false-label)
            ir.CompilerIrInstrList.Nil))))))

(define (opt-bit-test-rewrite-blocks
  [remaining : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [plans : OptBitTestPlans]
  [frame : i64]) : ir.CompilerIrBlockList
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            [slot : i64 (opt-bit-test-plans-slot plans label)]
            [tail : ir.CompilerIrBlockList
              (opt-bit-test-rewrite-blocks
                (__tl-box-place rest)
                all-blocks
                plans
                frame)]
            (if (< slot 0)
              (ir.compiler-ir-block-cons block tail)
              (let
                [mask-label : i64 (opt-bit-test-fresh-label all-blocks label 0)]
                [first-var : i64 (+ frame (* slot (opt-bit-test-plan-vars)))]
                (ir.compiler-ir-block-cons
                  (opt-bit-test-rewrite-head
                    block
                    (array-ref plans.values slot)
                    (array-ref plans.bases slot)
                    (array-ref plans.widths slot)
                    (array-ref plans.masks slot)
                    (array-ref plans.falses slot)
                    mask-label
                    first-var
                    (+ first-var 1)
                    (+ first-var 2))
                  (ir.compiler-ir-block-cons
                    (opt-bit-test-mask-block
                      mask-label
                      (array-ref plans.trues slot)
                      (array-ref plans.falses slot)
                      first-var
                      (+ first-var 1)
                      (+ first-var 3)
                      (+ first-var 4)
                      (+ first-var 5))
                    tail)))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bit-test-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        plans
        frame)]))

(define (opt-bit-test-values-var-and-literal?
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : bool
  (match lhs
    [(ir.CompilerIrValue.Var _)
      (match rhs
        [(ir.CompilerIrValue.I64 _) true]
        [_ false])]
    [(ir.CompilerIrValue.I64 _)
      (match rhs
        [(ir.CompilerIrValue.Var _) true]
        [_ false])]
    [_ false]))

;; Cheap pre-scan: a chain link is a two-instruction block whose compare tests a
;; var against an i64 literal and whose branch reads that compare. A function
;; without at least the profitability floor's worth of them cannot hold a
;; convertible chain.
(define (opt-bit-test-block-is-link-shaped? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (if (= (ir.compiler-ir-instr-seq-count instrs) 2)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
            (and
              (> (opt-bit-test-compare-kind op) 0)
              (opt-bit-test-i64-type? ty)
              (opt-bit-test-values-var-and-literal? lhs rhs)
              (match (ir.compiler-ir-instr-seq-ref instrs 1)
                [(ir.CompilerIrInstr.Branch cond _ _)
                  (match cond
                    [(ir.CompilerIrValue.Var cond-var) (= cond-var dst)]
                    [_ false])]
                [_ false]))]
          [_ false])
        false)]))

(define (opt-bit-test-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]
  [seen : i64]) : bool
  (if (>= seen (opt-bit-test-min-links))
    true
    (match blocks
      [(ir.CompilerIrBlockList.Nil) false]
      [(ir.CompilerIrBlockList.Cons block rest)
        (opt-bit-test-blocks-have-candidate?
          (__tl-box-place rest)
          (if (opt-bit-test-block-is-link-shaped? block)
            (+ seen 1)
            seen))]
      [(ir.CompilerIrBlockList.Array seq)
        (opt-bit-test-blocks-have-candidate?
          (ir.compiler-ir-block-seq-to-list seq)
          seen)])))

(define (opt-bit-test-function-pass [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not (opt-bit-test-blocks-have-candidate? blocks 0))
        (OptFunctionPassResult.Result func false)
        (let
          [facts : OptBitTestCompareFacts
            (opt-bit-test-facts-build frame blocks)]
          [index : OptCfgIndex (opt-cfg-index-build blocks)]
          [chain : OptBitTestChain (opt-bit-test-chain-new)]
          [plans : OptBitTestPlans (opt-bit-test-plans-new)]
          [_planned : unit
            (opt-bit-test-plan-blocks!
              index
              facts
              chain
              plans
              blocks
              (OptLabelSet.Nil))]
          [planned : i64 (opt-bit-test-plans-count plans)]
          (if (= planned 0)
            (OptFunctionPassResult.Result func false)
            (let
              [next : ir.CompilerIrFunction
                (ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  (+ frame (* planned (opt-bit-test-plan-vars)))
                  (opt-cfg-reachable-block-order
                    (opt-bit-test-rewrite-blocks blocks blocks plans frame)))]
              (match (opt-verify-function next)
                [(ResultCompilerOptimizeVerify.Ok)
                  (OptFunctionPassResult.Result next true)]
                [(ResultCompilerOptimizeVerify.Err _)
                  (OptFunctionPassResult.Result func false)])))))]))

(define (opt-bit-test-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-bit-test-function-pass func)
    [(OptFunctionPassResult.Result next changed)
      (if changed
        next
        func)]))

(define (optimize-function-max-iterations) : i64
  2)

;; --- cross-block global value numbering -------------------------------------
;;
;; Block-local CSE (`opt-cse-instr`) and copy propagation already collapse
;; redundant pure scalar expressions within a single basic block. This pass
;; lifts that to dominated blocks: a pure `BinOp`/`UnOp`, or an identical CPU
;; feature probe, is replaced by a `Mov` from an equal expression computed in a
;; strictly dominating block, after which the existing copy propagation/DCE
;; remove the dead intermediate. The IR is
;; non-SSA, so a value computed in a dominating block is only reusable at a use
;; if neither the result nor any operand can be reassigned between the two
;; points. The conservative-but-sound v1 condition is "exactly one value source"
;; per var: the value-source count = number of definitions plus one if the var
;; is a function parameter. A var with exactly one source has a single,
;; unchanging value throughout the function, so dominance alone authorizes the
;; reuse. Vars with two or more sources (a reassigned local, or a parameter that
;; is later overwritten) are excluded. Only `BinOp`/`UnOp` and CPU probes over
;; single-source operands and a single-source result are numbered; loads,
;; stores, allocations, calls, and other effectful or many-sourced instructions
;; are left untouched.
;; Phi inputs belong to predecessor edges and are never rewritten. Sibling
;; expressions never global-CSE because a join block is not strictly dominated by
;; either arm.
;; GVN value-source multiset: maps each def-site var id to how many times it is
;; defined (parameter seed + instruction destinations). A var is reusable across
;; dominance only when its count is exactly 1. Backed by opt_i64_i64_map.Map for O(1)
;; membership; previously a linked list scanned O(n) per query inside the
;; per-instruction build and rewrite loops (O(n^2) per GVN pass).
;; The expression table itself is scoped by dominator-tree traversal: each block
;; rewrites against facts inherited from strict dominators, then pushes its own
;; original recordable expressions while visiting children and restores those
;; bucket heads on return. That makes the nearest dominating expression the
;; first same-key bucket entry, without a dominance scan during lookup.
(defenum OptGvnEntry
  (Entry OptExprKey i64 i64))

(defenum OptGvnBucket
  (Nil)
  (Cons OptGvnEntry (Box OptGvnBucket)))

(defstruct OptGvnMap
  (buckets (__tl_dyn-array OptGvnBucket)))

(defstruct OptGvnScopeChanges
  (buckets opt_dense_i64_vec.Vec))

(defenum OptGvnBlockResult
  (NoBlock)
  (SomeBlock ir.CompilerIrBlock))

(define (opt-gvn-scope-changes-new) : OptGvnScopeChanges
  (OptGvnScopeChanges (opt_dense_i64_vec.new)))

(define (opt-gvn-scope-changes-count [changes : OptGvnScopeChanges]) : i64
  (opt_dense_i64_vec.len (& changes.buckets)))

(define (opt-gvn-scope-changes-push
  [changes : OptGvnScopeChanges (:consume)]
  [bucket : i64]) : OptGvnScopeChanges
  (let
    [buckets : opt_dense_i64_vec.Vec changes.buckets]
    (begin
      (opt_dense_i64_vec.push (&mut buckets) bucket)
      (OptGvnScopeChanges buckets))))

;; Number of times `var` appears as a definition site (instruction destination
;; or seeded parameter) in the collected value-source list.
(define (opt-gvn-count [sources : opt_i64_i64_map.Map] [var : i64]) : i64
  (opt_i64_i64_map.get-value-or (& sources) var 0))

;; Record one more definition of `var` in the value-source multiset.
(define (opt-gvn-defs-add
  [sources : opt_i64_i64_map.Map (:consume)]
  [var : i64]) : opt_i64_i64_map.Map
  (let
    [next-count : i64 (+ 1 (opt-gvn-count sources var))]
    [out : opt_i64_i64_map.Map sources]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) var next-count)
      out)))

;; A var is reusable across dominance only when it has exactly one value source.
(define (opt-gvn-stable-var? [sources : opt_i64_i64_map.Map] [var : i64]) : bool
  (= (opt-gvn-count sources var) 1))

;; Operand values that hold a single unchanging value: literals and single-source
;; vars. Globals, global addresses, function references, and float/string
;; literals are excluded to match the existing copy-propagation conservatism.
(define (opt-gvn-value-stable?
  [sources : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var id) (opt-gvn-stable-var? sources id)]
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.Unit) true]
    [(ir.CompilerIrValue.F64 _) false]
    [(ir.CompilerIrValue.String _) false]
    [(ir.CompilerIrValue.Bytes _) false]
    [(ir.CompilerIrValue.Global _) false]
    [(ir.CompilerIrValue.GlobalAddr _) false]
    [(ir.CompilerIrValue.Function _) false]
    [(ir.CompilerIrValue.RuntimeGlobal _) false]))

;; The destination var of a defining instruction, or -1 for instructions that do
;; not define a var. Mirrors the instruction set handled by `opt-cse-instr`.
(define (opt-gvn-instr-dst [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) dst]
    [(ir.CompilerIrInstr.Alloc dst _) dst]
    [(ir.CompilerIrInstr.AddrOf dst _) dst]
    [(ir.CompilerIrInstr.Gep dst _ _ _) dst]
    [(ir.CompilerIrInstr.Load dst _ _) dst]
    [(ir.CompilerIrInstr.Cast dst _ _ _) dst]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) dst]
    [(ir.CompilerIrInstr.LaneId dst _ _) dst]
    [(ir.CompilerIrInstr.Splat dst _ _ _) dst]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.MaskNot dst _ _) dst]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _) dst]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        dst)]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) dst]
    [(ir.CompilerIrInstr.EntryArgc dst) dst]
    [(ir.CompilerIrInstr.EntryArgv dst) dst]
    [(ir.CompilerIrInstr.EntryEnvp dst) dst]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) dst]
    [(ir.CompilerIrInstr.Xgetbv dst _) dst]
    [(ir.CompilerIrInstr.Syscall dst _) dst]
    [(ir.CompilerIrInstr.Call dst _ _ _) dst]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _) dst]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _) dst]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) (- 0 1)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) (- 0 1)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) (- 0 1)]
          [(ir.CompilerIrSpmdCallResult.Value dst _ _) dst]))]
    [(ir.CompilerIrInstr.Phi dst _ _) dst]
    [(ir.CompilerIrInstr.StorePtr _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.VectorStore _) (- 0 1)]
    [(ir.CompilerIrInstr.PredicatedStore _) (- 0 1)]
    [(ir.CompilerIrInstr.TailCall _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.Store _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.Jump _) (- 0 1)]
    [(ir.CompilerIrInstr.Branch _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.Return _) (- 0 1)]
    ;; Register-group ops define their dst.
    [(ir.CompilerIrInstr.Pack dst _ _) dst]
    [(ir.CompilerIrInstr.Word dst _ _ _) dst]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.Switch _ _ _ _) (- 0 1)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) (- 0 1)]))

(define (opt-gvn-sources-params
  [params : ir.CompilerIrParamList]
  [acc : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) acc]
    [(ir.CompilerIrParamList.Array seq)
      (opt-gvn-sources-params (ir.compiler-ir-param-seq-to-list seq) acc)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ id)
          (opt-gvn-sources-params
            (__tl-box-place rest)
            (opt-gvn-defs-add acc id))])]))

(define (opt-gvn-sources-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index count)
    acc
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [next : opt_i64_i64_map.Map
        (if (opt-gvn-record-candidate? instr)
          (opt-gvn-defs-add acc (- 0 1))
          acc)]
      (opt-gvn-sources-instr-seq-from
        slots
        (+ index 1)
        count
        (if (= dst (- 0 1))
          next
          (opt-gvn-defs-add next dst))))))

(define (opt-gvn-sources-blocks
  [blocks : ir.CompilerIrBlockList]
  [acc : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-gvn-sources-blocks
            (__tl-box-place rest)
            (opt-gvn-sources-instr-seq-from
              instrs.slots
              0
              (ir.compiler-ir-instr-seq-count instrs)
              acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gvn-sources-blocks (ir.compiler-ir-block-seq-to-list seq) acc)]))

;; Candidate count shares the map's -1 no-destination sentinel. Var ids are
;; non-negative, so stability queries never observe this reserved entry.
(define (opt-gvn-record-candidate? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.CpuId _ _ _ _) true]
    [(ir.CompilerIrInstr.Xgetbv _ _) true]
    [_ false]))

(define (opt-gvn-block-id [doms : OptDomInfo] [label : i64]) : i64
  (match (opt-cfg-index-id doms.index label)
    [(option_i64.Some id) id]
    [(option_i64.None) (- 0 1)]))

(define (opt-gvn-recordable-instr?
  [instr : ir.CompilerIrInstr]
  [sources : opt_i64_i64_map.Map]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp dst _ l r _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources l)
        (opt-gvn-value-stable? sources r))]
    [(ir.CompilerIrInstr.UnOp dst _ v _)
      (and (opt-gvn-stable-var? sources dst) (opt-gvn-value-stable? sources v))]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf _)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources leaf)
        (opt-gvn-value-stable? sources subleaf))]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-value-stable? sources index))]
    [_ false]))

(define (opt-gvn-bucket-capacity [count : i64]) : i64
  (opt-global-fact-bucket-capacity count))

(define (opt-gvn-map-empty [record-count : i64]) : OptGvnMap
  (OptGvnMap
    (array.make-array OptGvnBucket (opt-gvn-bucket-capacity record-count))))

(define (opt-gvn-bucket-index
  [type-segment-bases : i64]
  [buckets : (__tl_dyn-array OptGvnBucket)]
  [key : OptExprKey]) : i64
  (bit-and
    (opt-expr-key-hash type-segment-bases key)
    (- (array-length buckets) 1)))

(define (opt-gvn-table-push!
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [entry : OptGvnEntry]
  [changes : OptGvnScopeChanges (:consume)]) : OptGvnScopeChanges
  (match entry
    [(OptGvnEntry.Entry key _ _)
      (let
        [buckets : (__tl_dyn-array OptGvnBucket) table.buckets]
        [bucket : i64 (opt-gvn-bucket-index type-segment-bases buckets key)]
        [old-head : OptGvnBucket (array-ref buckets bucket)]
        [result : OptGvnScopeChanges
          (opt-gvn-scope-changes-push changes bucket)]
        (begin
          (set!
            (array-ref buckets bucket)
            (OptGvnBucket.Cons entry (box old-head)))
          result))]))

(define (opt-gvn-table-insert!
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [entry : OptGvnEntry]) : unit
  (begin
    (opt-gvn-table-push!
      type-segment-bases
      table
      entry
      (opt-gvn-scope-changes-new))
    unit))

;; Every logged push prepends exactly one bucket entry. Child scopes restore
;; before their parent, so replaying bucket ids in reverse insertion order can
;; peel those heads directly; retaining a boxed copy of every old head is
;; redundant and made the rollback log itself a cons chain.
(define (opt-gvn-table-restore!
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges]) : unit
  (let
    [logged : opt_dense_i64_vec.Vec changes.buckets]
    [slots : (& logged (__tl_dyn-array i64))
      (opt_dense_i64_vec.slots (& logged))]
    [buckets : (__tl_dyn-array OptGvnBucket) table.buckets]
    [index : i64 (- (opt_dense_i64_vec.len (& logged)) 1)]
    (while (>= index 0)
      (let
        [bucket : i64 (array-ref slots index)]
        (begin
          (match (array-ref buckets bucket)
            [(OptGvnBucket.Nil) unit]
            [(OptGvnBucket.Cons _ rest)
              (set! (array-ref buckets bucket) (__tl-box-place rest))])
          (set! index (- index 1)))))))

;; Record a `BinOp`/`UnOp`/CPU probe whose result and operands are all
;; single-source as an available value keyed by its expression and tagged with
;; its defining block.
(define (opt-gvn-record
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [def-block-id : i64]
  [sources : opt_i64_i64_map.Map]
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges (:consume)]) : OptGvnScopeChanges
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op l r ty)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry (OptExprKey.BinKey op l r ty) dst def-block-id)
          changes)
        changes)]
    [(ir.CompilerIrInstr.UnOp dst op v ty)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry (OptExprKey.UnKey op v ty) dst def-block-id)
          changes)
        changes)]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry
            (OptExprKey.CpuIdKey leaf subleaf reg-index)
            dst
            def-block-id)
          changes)
        changes)]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (if (opt-gvn-recordable-instr? instr sources)
        (opt-gvn-table-push!
          type-segment-bases
          table
          (OptGvnEntry.Entry (OptExprKey.XgetbvKey index) dst def-block-id)
          changes)
        changes)]
    [_ changes]))

(define (opt-gvn-record-scope-instr-seq-from
  [type-segment-bases : i64]
  [sources : opt_i64_i64_map.Map]
  [def-block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [table : OptGvnMap]
  [changes : OptGvnScopeChanges (:consume)]) : OptGvnScopeChanges
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    changes
    (opt-gvn-record-scope-instr-seq-from
      type-segment-bases
      sources
      def-block-id
      instrs
      (+ index 1)
      table
      (opt-gvn-record
        type-segment-bases
        (ir.compiler-ir-instr-seq-ref instrs index)
        def-block-id
        sources
        table
        changes))))

;; Find the nearest scoped result var for `key`, or -1 if none qualifies.
;; Dominance is represented by the current table scope; the bucket walk only
;; handles hash collisions and older same-key ancestors.
(define (opt-gvn-lookup-bucket
  [type-segment-bases : i64]
  [bucket : OptGvnBucket]
  [key : OptExprKey]) : i64
  (match bucket
    [(OptGvnBucket.Nil) (- 0 1)]
    [(OptGvnBucket.Cons entry rest)
      (match entry
        [(OptGvnEntry.Entry ekey evar def-block-id)
          (if (and
            (>= def-block-id 0)
            (opt-expr-key-eq type-segment-bases ekey key))
            evar
            (opt-gvn-lookup-bucket type-segment-bases (__tl-box-place rest) key))])]))

(define (opt-gvn-lookup
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [key : OptExprKey]) : i64
  (let
    [buckets : (__tl_dyn-array OptGvnBucket) table.buckets]
    (opt-gvn-lookup-bucket
      type-segment-bases
      (array-ref buckets (opt-gvn-bucket-index type-segment-bases buckets key))
      key)))

;; Rewriting an instruction allocates only when the rewrite fires: scanning a
;; sequence for changes is allocation-free, so unchanged blocks keep their
;; original instruction arrays instead of paying for a cons-list rebuild and
;; an Array->List->Array representation round trip per GVN call.
(defenum OptMaybeInstr
  (No)
  (Some ir.CompilerIrInstr))

(define (opt-gvn-rewrite-instr-maybe
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : OptMaybeInstr
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op l r ty)
      (if (and
        (opt-gvn-value-stable? sources l)
        (opt-gvn-value-stable? sources r))
        (let
          [earlier : i64
            (opt-gvn-lookup
              type-segment-bases
              table
              (OptExprKey.BinKey op l r ty))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (ir.CompilerIrInstr.Mov
                dst
                (ir.CompilerIrValue.Var earlier)
                (ir.compiler-ir-binop-result-type op ty)))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [(ir.CompilerIrInstr.UnOp dst op v ty)
      (if (opt-gvn-value-stable? sources v)
        (let
          [earlier : i64
            (opt-gvn-lookup type-segment-bases table (OptExprKey.UnKey op v ty))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (ir.CompilerIrInstr.Mov dst (ir.CompilerIrValue.Var earlier) ty))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (if (and
        (opt-gvn-value-stable? sources leaf)
        (opt-gvn-value-stable? sources subleaf))
        (let
          [earlier : i64
            (opt-gvn-lookup
              type-segment-bases
              table
              (OptExprKey.CpuIdKey leaf subleaf reg-index))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (ir.CompilerIrInstr.Mov
                dst
                (ir.CompilerIrValue.Var earlier)
                (ast.AstType.I64)))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (if (opt-gvn-value-stable? sources index)
        (let
          [earlier : i64
            (opt-gvn-lookup
              type-segment-bases
              table
              (OptExprKey.XgetbvKey index))]
          (if (and (not (= earlier (- 0 1))) (not (= earlier dst)))
            (OptMaybeInstr.Some
              (ir.CompilerIrInstr.Mov
                dst
                (ir.CompilerIrValue.Var earlier)
                (ast.AstType.I64)))
            (OptMaybeInstr.No)))
        (OptMaybeInstr.No))]
    [_ (OptMaybeInstr.No)]))

(define (opt-gvn-seq-rewrite-changed?
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (< index 0)
    false
    (match (opt-gvn-rewrite-instr-maybe
      type-segment-bases
      table
      sources
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInstr.Some _) true]
      [(OptMaybeInstr.No)
        (opt-gvn-seq-rewrite-changed?
          type-segment-bases
          table
          sources
          instrs
          (- index 1))])))

(define (opt-gvn-rewrite-instr-seq-from
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [out : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (if (< index 0)
    out
    (opt-gvn-rewrite-instr-seq-from
      type-segment-bases
      table
      sources
      instrs
      (- index 1)
      (ir.compiler-ir-instr-cons
        (match (opt-gvn-rewrite-instr-maybe
          type-segment-bases
          table
          sources
          (ir.compiler-ir-instr-seq-ref instrs index))
          [(OptMaybeInstr.Some rewritten) rewritten]
          [(OptMaybeInstr.No) (ir.compiler-ir-instr-seq-ref instrs index)])
        out))))

(define (opt-gvn-rewrite-instr-seq
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrList
  (opt-gvn-rewrite-instr-seq-from
    type-segment-bases
    table
    sources
    instrs
    (- (ir.compiler-ir-instr-seq-count instrs) 1)
    ir.CompilerIrInstrList.Nil))

(define (opt-gvn-rewrite-block
  [type-segment-bases : i64]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [block : ir.CompilerIrBlock]) : OptBlockPassResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (opt-gvn-seq-rewrite-changed?
        type-segment-bases
        table
        sources
        instrs
        (- (ir.compiler-ir-instr-seq-count instrs) 1))
        (OptBlockPassResult.Result
          (ir.compiler-ir-block
            label
            (opt-gvn-rewrite-instr-seq type-segment-bases table sources instrs))
          true)
        (OptBlockPassResult.Result block false))]))

(define (opt-gvn-dom-children [doms : OptDomInfo]) : OptCfgCsr
  (let
    [index : OptCfgIndex doms.index]
    [count : i64 (opt-cfg-index-block-count index)]
    [child-rows : (__tl_dyn-array OptI64List)
      (array.make-array OptI64List count)]
    (begin
      (opt-dom-child-rows-fill! index doms.idom child-rows)
      (opt-cfg-csr-build child-rows count))))

(define (opt-gvn-materialize-blocks
  [doms : OptDomInfo]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            [block-id : i64 (opt-gvn-block-id doms label)]
            [material : ir.CompilerIrBlock
              (if (and (>= block-id 0) (< block-id (array-length out)))
                (match (array-ref out block-id)
                  [(OptGvnBlockResult.SomeBlock rewritten) rewritten]
                  [(OptGvnBlockResult.NoBlock) block])
                block)]
            (ir.compiler-ir-block-cons
              material
              (opt-gvn-materialize-blocks doms out (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gvn-materialize-blocks
        doms
        out
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-gvn-rewrite-id
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [id : i64]) : i64
  (let
    [index : OptCfgIndex context.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and (>= id 0) (< id count))
      (match (opt-cfg-index-block index id)
        [(OptMaybeBlock.No) 0]
        [(OptMaybeBlock.Some block)
          (match block
            [(ir.CompilerIrBlock.Block label instrs)
              (match (if (or
                (opt-induction-switch-arm? index blocks label instrs)
                (opt-bool-branch-chain-check-block? label instrs))
                (OptBlockPassResult.Result block false)
                (opt-gvn-rewrite-block type-segment-bases table sources block))
                [(OptBlockPassResult.Result rewritten block-changed)
                  (begin
                    (if block-changed
                      (set!
                        (array-ref out id)
                        (OptGvnBlockResult.SomeBlock rewritten))
                      unit)
                    (let
                      [changes : OptGvnScopeChanges
                        (opt-gvn-record-scope-instr-seq-from
                          type-segment-bases
                          sources
                          id
                          instrs
                          0
                          table
                          (opt-gvn-scope-changes-new))]
                      [children-changed : i64
                        (opt-gvn-rewrite-children
                          type-segment-bases
                          context
                          children
                          table
                          sources
                          blocks
                          out
                          id)]
                      (begin
                        (opt-gvn-table-restore! table changes)
                        (if (or block-changed (= children-changed 1))
                          1
                          0))))])])])
      0)))

(define (opt-gvn-rewrite-children
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [parent-id : i64]) : i64
  (let
    [offsets : (__tl_dyn-array i64) children.offsets]
    [edges : (__tl_dyn-array i64) children.edges]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    [changed : i64 0]
    (begin
      (while (< edge end)
        (begin
          (if (=
            (opt-gvn-rewrite-id
              type-segment-bases
              context
              children
              table
              sources
              blocks
              out
              (array-ref edges edge))
            1)
            (set! changed 1)
            unit)
          (set! edge (+ edge 1))))
      changed)))

(define (opt-gvn-rewrite-dom
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [table : OptGvnMap]
  [sources : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [doms : OptDomInfo context.doms]
    [index : OptCfgIndex context.index]
    [count : i64 (opt-cfg-index-block-count index)]
    [children : OptCfgCsr (opt-gvn-dom-children doms)]
    [out : (__tl_dyn-array OptGvnBlockResult)
      (array.make-array OptGvnBlockResult count)]
    (begin
      (opt-cfg-index-refresh-blocks! index blocks)
      (let
        [changed : i64
          (match (opt-cfg-index-id index context.entry-label)
            [(option_i64.Some entry-id)
              (if (and (>= entry-id 0) (array-ref index.reachable entry-id))
                (opt-gvn-rewrite-id
                  type-segment-bases
                  context
                  children
                  table
                  sources
                  blocks
                  out
                  entry-id)
                0)]
            [(option_i64.None) 0])]
        (if (= changed 0)
          blocks
          (opt-gvn-materialize-blocks doms out blocks))))))

;; Replace dominated repeated pure scalar expressions with a copy from the first
;; dominating value; existing copy propagation and DCE remove the dead copies.
(define (opt-gvn-blocks-with-context-and-call-memory
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [call-memory : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [sources : opt_i64_i64_map.Map
      (opt-gvn-sources-blocks
        blocks
        (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 64)))]
    [table : OptGvnMap (opt-gvn-map-empty (opt-gvn-count sources (- 0 1)))]
    [gvn : ir.CompilerIrBlockList
      (opt-gvn-rewrite-dom type-segment-bases context table sources blocks)]
    [hs : OptLoadHeaderSet
      (opt-load-header-set-from-function type-segment-bases params gvn)]
    (opt-load-gvn-blocks-with-context
      profile-state
      type-segment-bases
      context
      sources
      hs
      params
      call-memory
      gvn)))

(define (opt-gvn-blocks
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-gvn-blocks-with-context-and-call-memory
    (profile_state.compiler-profile-state-metrics
      (profile_state.compiler-profile-state-new))
    type-segment-bases
    (opt-cfg-context-build blocks)
    params
    (opt_i64_i64_map.with-capacity 1)
    blocks))

;; --- dominated redundant bounds-check elimination ----------------------------
;;
;; The block-local pass (#930) drops duplicate checks within one basic block,
;; but consecutive accesses to the same index usually sit in different blocks
;; (each check's not-taken abort path splits the flow), so read-then-write
;; pairs like a swap re-check the same `(index, length)` several times per
;; iteration. This pass walks the dominator tree carrying `(index, length)`
;; facts: a BoundsCheck whose exact pair was already checked at a DOMINATING
;; point is removable -- the dominating check either aborted or proved the pair
;; in range, and BoundsCheck is a mid-block trap-or-continue, so reaching any
;; dominated point means every check in the dominating prefix passed. A fact is
;; recorded only when both values are literals or single-source vars
;; (opt-gvn-value-stable?), so recorded pairs can never be redefined and no
;; invalidation is needed: stores and calls cannot change an SSA var's value.
;; PRECONDITION: the caller must have verified the function (defs dominate
;; uses). In a fallback non-SSA function a textually-single-def var inside a
;; loop takes a new value each iteration and loop-carried uses precede the
;; redefinition, so "one def instruction" does not imply "one value" there.
;; Runs right after GVN/load-GVN so identical index casts and length loads
;; have been unified into shared vars first. Facts flow down the dominator
;; tree as an immutable list, so sibling subtrees are isolated by construction.
(defenum OptBoundsDomWalk
  (Walk ir.CompilerIrInstrSeq OptBoundsFacts OptDomCmpFacts))

;; GVN rewrites a dominated duplicate expression (e.g. the per-access
;; `Cast(i -> U64)` index) into `Mov dst2 = dst1`, and block-local copy
;; propagation cannot forward that copy into a check in a later block (its env
;; resets per block). Canonicalize check operands through a function-wide
;; copy map restricted to single-source vars on both sides: such a Mov is its
;; dst's unique definition and its source never changes, so dst and source
;; denote the same runtime value everywhere and comparing canonical values is
;; exact. The chase is bounded defensively; chains are Mov-of-Mov artifacts
;; and stay short.
;; A 64-bit integer-to-integer cast is a bit-preserving reinterpret (the #930
;; argument): the unsigned bounds comparison is identical on either side, so
;; the canonical value for dedup purposes is the pre-cast source.
(define (opt-bounds-dom-reinterpret-cast?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (and
    (opt-integer-type? from-ty)
    (opt-integer-type? to-ty)
    (= (opt-int-width from-ty) 64)
    (= (opt-int-width to-ty) 64)))

(define (opt-bounds-dom-copies-add-instr!
  [sources : opt_i64_i64_map.Map]
  [copies : (&mut copies opt_i64_i64_map.Map)]
  [instr : ir.CompilerIrInstr]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst (ir.CompilerIrValue.Var src) _)
      (if (and
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-stable-var? sources src))
        (opt_i64_i64_map.insert-ref! copies dst src)
        unit)]
    [(ir.CompilerIrInstr.Cast dst (ir.CompilerIrValue.Var src) from-ty to-ty)
      (if (and
        (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
        (opt-gvn-stable-var? sources dst)
        (opt-gvn-stable-var? sources src))
        (opt_i64_i64_map.insert-ref! copies dst src)
        unit)]
    [_ unit]))

(define (opt-bounds-dom-copies-add-blocks
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map (:consume)]
  [blocks : ir.CompilerIrBlockList]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) copies]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [i : i64 0]
            [acc : opt_i64_i64_map.Map copies]
            (begin
              (while (< i count)
                (begin
                  (opt-bounds-dom-copies-add-instr!
                    sources
                    (&mut acc)
                    (ir.compiler-ir-instr-seq-ref instrs i))
                  (set! i (+ i 1))))
              (opt-bounds-dom-copies-add-blocks
                sources
                acc
                (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bounds-dom-copies-add-blocks
        sources
        copies
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-bounds-dom-resolve
  [copies : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var id)
      (let
        [cur : i64 id]
        [hops : i64 0]
        (begin
          (while (< hops 8)
            (match (opt_i64_i64_map.get (& copies) cur)
              [(opt_i64_i64_map.LookupFound next)
                (begin
                  (set! cur next)
                  (set! hops (+ hops 1)))]
              [(opt_i64_i64_map.LookupMissing) (set! hops 8)]))
          (if (= cur id)
            value
            (ir.CompilerIrValue.Var cur))))]
    [_ value]))

;; --- dominating comparison facts --------------------------------------------
;;
;; A conditional branch decides its condition for the whole subtree dominated by
;; the edge it takes, so a later comparison of the same operands is a
;; compile-time constant. Both spellings count: `gt b a` canonicalizes to
;; `lt a b`, and `le a b` is the negation of `lt b a`. Restricted to integer
;; comparisons -- float negation is not a total order under NaN -- and to edge
;; targets whose only entry is that edge, so the fact really does hold
;; everywhere below.
;; The trailing block id is the dominator-tree node the fact became valid at: the
;; edge target for a branch fact, the check's own block for a passed
;; `bounds_check`. Every consumer below it is dominated by that block, so the
;; plain lookups ignore the field; only a consumer asking whether the fact also
;; holds at some OTHER block (the counter induction's latch) reads it.
(defenum OptDomCmpFact
  (Fact
    ir.CompilerIrBinOp
    ir.CompilerIrValue
    ir.CompilerIrValue
    ast.AstType
    bool
    i64))

(defenum OptDomCmpFacts
  (Nil)
  (Cons OptDomCmpFact (Box OptDomCmpFacts)))

(defenum OptDomCmpLookup
  (No)
  (Some bool))

(define (opt-dom-cmp-foldable-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Eq) true]
    [(ir.CompilerIrBinOp.Ne) true]
    [(ir.CompilerIrBinOp.Lt) true]
    [(ir.CompilerIrBinOp.Le) true]
    [(ir.CompilerIrBinOp.Gt) true]
    [(ir.CompilerIrBinOp.Ge) true]
    [_ false]))

;; `gt`/`ge` are `lt`/`le` with the operands read the other way round.
(define (opt-dom-cmp-swapped? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Gt) true]
    [(ir.CompilerIrBinOp.Ge) true]
    [_ false]))

(define (opt-dom-cmp-canon-op [op : ir.CompilerIrBinOp]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Gt) (ir.CompilerIrBinOp.Lt)]
    [(ir.CompilerIrBinOp.Ge) (ir.CompilerIrBinOp.Le)]
    [_ op]))

(define (opt-dom-cmp-canon-lhs
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : ir.CompilerIrValue
  (if (opt-dom-cmp-swapped? op)
    rhs
    lhs))

(define (opt-dom-cmp-canon-rhs
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : ir.CompilerIrValue
  (if (opt-dom-cmp-swapped? op)
    lhs
    rhs))

;; --- implication: what a dominating fact decides about a dominated compare ---
;;
;; A dominating fact and the compare below it need not be spelled the same way
;; to be the same question. `(> i 0)` on an edge decides `(>= i 0)` below it;
;; `(< i 3)` decides `(< i 5)`; a passed `bounds_check` decides the defensive
;; `(<= i len)` an accessor re-tests. Matching on "same operator, same operands,
;; or the exact negation" saw only a slice of that, so the rest survived as
;; provably-constant per-iteration work.
;;
;; Integer comparison is a TOTAL ORDER, so for an ordered operand pair `(x, y)`
;; exactly one of `x < y`, `x = y`, `x > y` holds. Every comparison is therefore
;; just a SET of admissible relations, encoded as a 3-bit mask (bit 0 `<`, bit 1
;; `=`, bit 2 `>`), and a decided fact narrows the set the dominated point may
;; be in:
;;
;;   fact `x < y` true  -> {<}          fact `x < y` false -> {=, >}
;;   fact `x <= y` true -> {<, =}       fact `x <= y` false -> {>}
;;   fact `x = y` true  -> {=}          fact `x = y` false -> {<, >}
;;
;; With `K` the narrowed set and `Q` the relations that make the query true,
;; `K subset-of Q` proves the query TRUE and `K disjoint-from Q` proves it
;; FALSE. Nothing else is decided. This subsumes the identical-compare and
;; exact-negation cases it replaces (`Q = K` and `Q = complement K`), reading
;; the fact with the operands the other way round is one mask swap, and no
;; arithmetic is involved, so signedness and wrapping cannot enter.
;;
;; RULE (a) EXTENDED TO A WEAKER LITERAL. When the fact and the query compare
;; the SAME var against DIFFERENT literals -- `i < 3` dominating `i < 5` -- the
;; relations transfer through the order of the two literals, in the type's own
;; comparison (unsigned types compare unsigned, so an unsigned literal pair is
;; ordered unsigned). For `fk < qk`: `v < fk` and `v = fk` both give `v < qk`,
;; while `v > fk` only pins `v >= qk` when `qk` is `fk`'s immediate successor,
;; and otherwise gives nothing. The mirrored case reads the same way. The only
;; arithmetic is that successor test, which refuses at the type's maximum, so
;; it never wraps. Types must match exactly (the fact carries its own), which
;; is what keeps one type's order from being read in another's.
;;
;; Facts are recorded only for integer comparisons (see the edge fact below),
;; so float NaN -- where trichotomy fails -- never reaches this.
;;
;; Every mask below is over the ORDERED pair `(lhs, rhs)`: 1 is `<`, 2 is `=`,
;; 4 is `>`, so 3 is `<=`, 6 is `>=`, 5 is `!=` and 7 is "anything".
;;
;; The relations that make `lhs op rhs` true.
(define (opt-dom-cmp-op-mask [op : ir.CompilerIrBinOp]) : i64
  (match op
    [(ir.CompilerIrBinOp.Lt) 1]
    [(ir.CompilerIrBinOp.Le) 3]
    [(ir.CompilerIrBinOp.Gt) 4]
    [(ir.CompilerIrBinOp.Ge) 6]
    [(ir.CompilerIrBinOp.Eq) 2]
    [(ir.CompilerIrBinOp.Ne) 5]
    [_ 0]))

;; The relations a DECIDED comparison leaves possible.
(define (opt-dom-cmp-fact-mask [op : ir.CompilerIrBinOp] [value : bool]) : i64
  (let
    [mask : i64 (opt-dom-cmp-op-mask op)]
    (if (= mask 0)
      0
      (if value
        mask
        (bit-xor mask 7)))))

;; The same set read with the operands the other way round.
(define (opt-dom-cmp-mask-swap [mask : i64]) : i64
  (bit-or
    (bit-and mask 2)
    (bit-or
      (if (= (bit-and mask 1) 0)
        0
        4)
      (if (= (bit-and mask 4) 0)
        0
        1))))

;; `known` is what the fact leaves possible, `query` what makes the compare
;; true. An empty `known` means the facts in scope are contradictory, which only
;; happens on unreachable code; it decides nothing here.
(define (opt-dom-cmp-mask-verdict [known : i64] [query : i64]) : OptDomCmpLookup
  (if (= known 0)
    (OptDomCmpLookup.No)
    (let
      [hit : i64 (bit-and known query)]
      (cond
        [(= hit known) (OptDomCmpLookup.Some true)]
        [(= hit 0) (OptDomCmpLookup.Some false)]
        [else (OptDomCmpLookup.No)]))))

;; A comparison of one var against one literal: the var's id, the literal, and
;; whether the var was the left operand.
(defenum OptDomCmpVarLit
  (No)
  (Some i64 i64 bool))

(define (opt-dom-cmp-var-lit
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptDomCmpVarLit
  (match lhs
    [(ir.CompilerIrValue.Var var)
      (match rhs
        [(ir.CompilerIrValue.I64 literal)
          (OptDomCmpVarLit.Some var literal true)]
        [_ (OptDomCmpVarLit.No)])]
    [(ir.CompilerIrValue.I64 literal)
      (match rhs
        [(ir.CompilerIrValue.Var var) (OptDomCmpVarLit.Some var literal false)]
        [_ (OptDomCmpVarLit.No)])]
    [_ (OptDomCmpVarLit.No)]))

(define (opt-dom-cmp-type-max [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 9223372036854775807]
    [(ast.AstType.I32) 2147483647]
    [(ast.AstType.I16) 32767]
    [(ast.AstType.I8) 127]
    [(ast.AstType.U64) (- 0 1)]
    [(ast.AstType.U32) 4294967295]
    [(ast.AstType.U16) 65535]
    [(ast.AstType.U8) 255]
    [_ 0]))

;; Is `b` the immediate successor of `a` in this type's order? Refused at the
;; maximum, where there is no successor and `a + 1` would wrap.
(define (opt-dom-cmp-adjacent? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (and (not (= a (opt-dom-cmp-type-max ty))) (= (+ a 1) b)))

;; The relations `v` may have to `qk`, given the relations it may have to `fk`.
;; Both masks are read with the VAR on the left.
(define (opt-dom-cmp-shift-mask
  [known : i64]
  [fk : i64]
  [qk : i64]
  [ty : ast.AstType]) : i64
  (cond
    [(= fk qk) known]
    [(opt-typed-lt? fk qk ty)
      (bit-or
        (if (= (bit-and known 3) 0)
          0
          1)
        (if (= (bit-and known 4) 0)
          0
          (if (opt-dom-cmp-adjacent? fk qk ty)
            6
            7)))]
    [else
      (bit-or
        (if (= (bit-and known 6) 0)
          0
          4)
        (if (= (bit-and known 1) 0)
          0
          (if (opt-dom-cmp-adjacent? qk fk ty)
            3
            7)))]))

;; Same var, different literals. `query` is the query's mask read on ITS pair;
;; both masks are rotated so the var sits on the left before they meet.
(define (opt-dom-cmp-literal-verdict
  [fact-op : ir.CompilerIrBinOp]
  [fact-value : bool]
  [fact-lhs : ir.CompilerIrValue]
  [fact-rhs : ir.CompilerIrValue]
  [query : i64]
  [query-var-lit : OptDomCmpVarLit]
  [ty : ast.AstType]) : OptDomCmpLookup
  (match query-var-lit
    [(OptDomCmpVarLit.No) (OptDomCmpLookup.No)]
    [(OptDomCmpVarLit.Some var literal var-left?)
      (match (if (opt-integer-type? ty)
        (opt-dom-cmp-var-lit fact-lhs fact-rhs)
        (OptDomCmpVarLit.No))
        [(OptDomCmpVarLit.No) (OptDomCmpLookup.No)]
        [(OptDomCmpVarLit.Some fact-var fact-literal fact-var-left?)
          (if (not (= var fact-var))
            (OptDomCmpLookup.No)
            (let
              [known : i64
                (let
                  [mask : i64 (opt-dom-cmp-fact-mask fact-op fact-value)]
                  (if fact-var-left?
                    mask
                    (opt-dom-cmp-mask-swap mask)))]
              (opt-dom-cmp-mask-verdict
                (opt-dom-cmp-shift-mask
                  known
                  (opt-normalize-int-to-i64 fact-literal ty)
                  (opt-normalize-int-to-i64 literal ty)
                  ty)
                (if var-left?
                  query
                  (opt-dom-cmp-mask-swap query)))))])]))

;; One fact's verdict on the query. Operand identity is tried first in both
;; orders -- that is the whole cost for a query with no literal operand, since
;; `query-var-lit` is then `No` and the literal rule bails on its first match.
(define (opt-dom-cmp-fact-verdict
  [type-segment-bases : i64]
  [fact : OptDomCmpFact]
  [query : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [query-var-lit : OptDomCmpVarLit]
  [ty : ast.AstType]) : OptDomCmpLookup
  (match fact
    [(OptDomCmpFact.Fact fact-op fact-lhs fact-rhs fact-ty fact-value _)
      (if (not (opt-type-eq type-segment-bases ty fact-ty))
        (OptDomCmpLookup.No)
        (cond
          [(and (opt-value-eq lhs fact-lhs) (opt-value-eq rhs fact-rhs))
            (opt-dom-cmp-mask-verdict
              (opt-dom-cmp-fact-mask fact-op fact-value)
              query)]
          [(and (opt-value-eq lhs fact-rhs) (opt-value-eq rhs fact-lhs))
            (opt-dom-cmp-mask-verdict
              (opt-dom-cmp-mask-swap (opt-dom-cmp-fact-mask fact-op fact-value))
              query)]
          [else
            (opt-dom-cmp-literal-verdict
              fact-op
              fact-value
              fact-lhs
              fact-rhs
              query
              query-var-lit
              ty)]))]))

(define (opt-dom-cmp-lookup-mask
  [type-segment-bases : i64]
  [facts : OptDomCmpFacts]
  [query : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [query-var-lit : OptDomCmpVarLit]
  [ty : ast.AstType]) : OptDomCmpLookup
  (match facts
    [(OptDomCmpFacts.Nil) (OptDomCmpLookup.No)]
    [(OptDomCmpFacts.Cons fact rest)
      (match (opt-dom-cmp-fact-verdict
        type-segment-bases
        fact
        query
        lhs
        rhs
        query-var-lit
        ty)
        [(OptDomCmpLookup.Some decided) (OptDomCmpLookup.Some decided)]
        [(OptDomCmpLookup.No)
          (opt-dom-cmp-lookup-mask
            type-segment-bases
            (deref rest)
            query
            lhs
            rhs
            query-var-lit
            ty)])]))

(define (opt-dom-cmp-lookup
  [type-segment-bases : i64]
  [facts : OptDomCmpFacts]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDomCmpLookup
  (let
    [query : i64 (opt-dom-cmp-op-mask op)]
    (if (= query 0)
      (OptDomCmpLookup.No)
      (opt-dom-cmp-lookup-mask
        type-segment-bases
        facts
        query
        lhs
        rhs
        (opt-dom-cmp-var-lit lhs rhs)
        ty))))

;; --- one transitive step ------------------------------------------------------
;;
;; Two facts in scope can pin a compare neither of them mentions: a loop's
;; header proves `i < n` for its whole body, an entry guard proves `n <= len`
;; for the whole loop, and the accessor's own `i < len` inside the body is then
;; decided without either fact naming both operands. Chaining exactly ONE
;; intermediate closes that shape, which is the one the versioned loops leave
;; behind; a longer chain would be a range analysis and is refused.
;;
;; `a <= m` and `m <= c` give `a <= c`, strict as soon as either step is, which
;; is the entire rule -- the order is transitive and no arithmetic is involved,
;; so signedness and wrapping are again out of the picture. Both steps must
;; carry the query's type (the direct lookup's requirement, for the same
;; reason), and the search runs only after the direct lookup returned nothing:
;; the head scan is one pass that usually matches no fact at all, and only a
;; match pays for the tail scan.
(defenum OptDomCmpBelow
  (No)
  (Some ir.CompilerIrValue bool))

;; Read one fact as `a < upper` (strict) or `a <= upper`. Anything weaker --
;; a fact that leaves `a` possibly above `upper` -- carries no step.
(define (opt-dom-cmp-below-of-mask [mask : i64] [other : ir.CompilerIrValue]) : OptDomCmpBelow
  (cond
    [(= mask 1) (OptDomCmpBelow.Some other true)]
    [(= mask 3) (OptDomCmpBelow.Some other false)]
    [else (OptDomCmpBelow.No)]))

(define (opt-dom-cmp-fact-below
  [type-segment-bases : i64]
  [fact : OptDomCmpFact]
  [a : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDomCmpBelow
  (match fact
    [(OptDomCmpFact.Fact fact-op fact-lhs fact-rhs fact-ty fact-value _)
      (if (not (opt-type-eq type-segment-bases ty fact-ty))
        (OptDomCmpBelow.No)
        (cond
          [(opt-value-eq fact-lhs a)
            (opt-dom-cmp-below-of-mask
              (opt-dom-cmp-fact-mask fact-op fact-value)
              fact-rhs)]
          [(opt-value-eq fact-rhs a)
            (opt-dom-cmp-below-of-mask
              (opt-dom-cmp-mask-swap (opt-dom-cmp-fact-mask fact-op fact-value))
              fact-lhs)]
          [else (OptDomCmpBelow.No)]))]))

;; The second step: some fact putting `mid` at or below exactly `c`.
(define (opt-dom-cmp-chain-tail
  [type-segment-bases : i64]
  [facts : OptDomCmpFacts]
  [mid : ir.CompilerIrValue]
  [c : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDomCmpBelow
  (match facts
    [(OptDomCmpFacts.Nil) (OptDomCmpBelow.No)]
    [(OptDomCmpFacts.Cons fact rest)
      (match (opt-dom-cmp-fact-below type-segment-bases fact mid ty)
        [(OptDomCmpBelow.Some upper strict?)
          (if (opt-value-eq upper c)
            (OptDomCmpBelow.Some upper strict?)
            (opt-dom-cmp-chain-tail type-segment-bases (deref rest) mid c ty))]
        [(OptDomCmpBelow.No)
          (opt-dom-cmp-chain-tail type-segment-bases (deref rest) mid c ty)])]))

(define (opt-dom-cmp-chain-scan
  [type-segment-bases : i64]
  [all-facts : OptDomCmpFacts]
  [facts : OptDomCmpFacts]
  [query : i64]
  [a : ir.CompilerIrValue]
  [c : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDomCmpLookup
  (match facts
    [(OptDomCmpFacts.Nil) (OptDomCmpLookup.No)]
    [(OptDomCmpFacts.Cons fact rest)
      (match (match (opt-dom-cmp-fact-below type-segment-bases fact a ty)
        [(OptDomCmpBelow.No) (OptDomCmpLookup.No)]
        [(OptDomCmpBelow.Some mid head-strict?)
          ;; A step onto `a` or straight onto `c` is not a chain: the direct
          ;; lookup already saw the latter and the former proves nothing.
          (if (or (opt-value-eq mid a) (opt-value-eq mid c))
            (OptDomCmpLookup.No)
            (match (opt-dom-cmp-chain-tail
              type-segment-bases
              all-facts
              mid
              c
              ty)
              [(OptDomCmpBelow.No) (OptDomCmpLookup.No)]
              [(OptDomCmpBelow.Some _ tail-strict?)
                (opt-dom-cmp-mask-verdict
                  (if (or head-strict? tail-strict?)
                    1
                    3)
                  query)]))])
        [(OptDomCmpLookup.Some decided) (OptDomCmpLookup.Some decided)]
        [(OptDomCmpLookup.No)
          (opt-dom-cmp-chain-scan
            type-segment-bases
            all-facts
            (deref rest)
            query
            a
            c
            ty)])]))

(define (opt-dom-cmp-lookup-chained
  [type-segment-bases : i64]
  [facts : OptDomCmpFacts]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDomCmpLookup
  (match (opt-dom-cmp-lookup type-segment-bases facts op lhs rhs ty)
    [(OptDomCmpLookup.Some decided) (OptDomCmpLookup.Some decided)]
    [(OptDomCmpLookup.No)
      (let
        [query : i64 (opt-dom-cmp-op-mask op)]
        (if (= query 0)
          (OptDomCmpLookup.No)
          (opt-dom-cmp-chain-scan
            type-segment-bases
            facts
            facts
            query
            lhs
            rhs
            ty)))]))

;; The fact an edge into `taken?` establishes, given the branch condition's
;; defining comparison. Operands are resolved through the same copy map the
;; bounds facts use so both sides speak one spelling.
(define (opt-dom-cmp-edge-fact
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [sources : opt_i64_i64_map.Map]
  [cond : ir.CompilerIrValue]
  [taken? : bool]
  [block : i64]
  [facts : OptDomCmpFacts]) : OptDomCmpFacts
  (match cond
    [(ir.CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) facts]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
              (let
                [clhs : ir.CompilerIrValue
                  (opt-bounds-dom-resolve
                    copies
                    (opt-dom-cmp-canon-lhs op lhs rhs))]
                [crhs : ir.CompilerIrValue
                  (opt-bounds-dom-resolve
                    copies
                    (opt-dom-cmp-canon-rhs op lhs rhs))]
                (if (and
                  (opt-dom-cmp-foldable-op? op)
                  (opt-integer-type? ty)
                  (opt-gvn-value-stable? sources clhs)
                  (opt-gvn-value-stable? sources crhs))
                  (OptDomCmpFacts.Cons
                    (OptDomCmpFact.Fact
                      (opt-dom-cmp-canon-op op)
                      clhs
                      crhs
                      ty
                      taken?
                      block)
                    (box facts))
                  facts))]
            [_ facts])])]
    [_ facts]))

;; Phi definitions by destination, kept in a table of its own so the bool-branch
;; `defs` table stays BinOp-only and the passes reading it are untouched.
(define (opt-bounds-dom-phi-defs-fill-instrs!
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (begin
        (match instr
          [(ir.CompilerIrInstr.Phi dst _ _)
            (if (and (>= dst 0) (< dst (array-length defs)))
              (set! (array-ref defs dst) (OptBoolBranchDef.Some instr label))
              unit)]
          [(ir.CompilerIrInstr.Cast dst _ _ _)
            (if (and (>= dst 0) (< dst (array-length defs)))
              (set! (array-ref defs dst) (OptBoolBranchDef.Some instr label))
              unit)]
          [_ unit])
        (opt-bounds-dom-phi-defs-fill-instrs! defs label instrs (+ index 1))))))

(define (opt-bounds-dom-phi-defs-fill-blocks!
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (opt-bounds-dom-phi-defs-fill-instrs! defs label instrs 0)])
        (opt-bounds-dom-phi-defs-fill-blocks! defs (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bounds-dom-phi-defs-fill-blocks!
        defs
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-bounds-dom-phi-defs
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array OptBoolBranchDef)
  (let
    [defs : (__tl_dyn-array OptBoolBranchDef)
      (array.make-array OptBoolBranchDef frame)]
    (begin
      (opt-bounds-dom-phi-defs-fill-blocks! defs blocks)
      defs)))

;; See through a same-width signed/unsigned reinterpretation. `bounds_check` is
;; lowered as an unsigned compare and its operands arrive as `i64 -> u64` casts,
;; so without this the mask shape is hidden behind a cast on both sides. Only the
;; 64-bit pair is unwrapped: the bit pattern is identical, so nothing about the
;; value's range changes. A widening or narrowing cast is left alone.
(define (opt-bounds-dom-int-cast-transparent?
  [type-segment-bases : i64]
  [from : ast.AstType]
  [to : ast.AstType]) : bool
  (or
    (and
      (opt-type-eq type-segment-bases from (ast.AstType.I64))
      (opt-type-eq type-segment-bases to (ast.AstType.U64)))
    (and
      (opt-type-eq type-segment-bases from (ast.AstType.U64))
      (opt-type-eq type-segment-bases to (ast.AstType.I64)))))

(define (opt-bounds-dom-strip-int-cast
  [type-segment-bases : i64]
  [extra-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (opt-bool-branch-def extra-defs var)
        [(OptBoolBranchDef.No) value]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(ir.CompilerIrInstr.Cast _ source from to)
              (if (opt-bounds-dom-int-cast-transparent?
                type-segment-bases
                from
                to)
                (opt-bounds-dom-resolve copies source)
                value)]
            [_ value])])]
    [_ value]))

;; Is `value` the mask `len - 1` for this exact length value?
(define (opt-bounds-dom-len-minus-one?
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
              (and
                (opt-integer-type? ty)
                (opt-value-eq (opt-bounds-dom-resolve copies lhs) len)
                (or
                  (and
                    (opt-binop-eq op (ir.CompilerIrBinOp.Sub))
                    (match rhs
                      [(ir.CompilerIrValue.I64 one) (= one 1)]
                      [_ false]))
                  (and
                    (opt-binop-eq op (ir.CompilerIrBinOp.Add))
                    (match rhs
                      [(ir.CompilerIrValue.I64 minus-one) (= minus-one (- 0 1))]
                      [_ false]))))]
            [_ false])])]
    [_ false]))

;; Do the facts in scope prove `len >= 1`? A dominating `len >= 1` or `len < 1`
;; edge answers it, and so does a length that is already a positive literal.
(define (opt-bounds-dom-len-positive?
  [type-segment-bases : i64]
  [cmp-facts : OptDomCmpFacts]
  [len : ir.CompilerIrValue]) : bool
  (or
    (match len
      [(ir.CompilerIrValue.I64 count) (>= count 1)]
      [_ false])
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (ir.CompilerIrBinOp.Lt)
      len
      (ir.CompilerIrValue.I64 1)
      (ast.AstType.I64))
      [(OptDomCmpLookup.Some value) (not value)]
      [(OptDomCmpLookup.No) false])
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (ir.CompilerIrBinOp.Le)
      (ir.CompilerIrValue.I64 1)
      len
      (ast.AstType.I64))
      [(OptDomCmpLookup.Some value) value]
      [(OptDomCmpLookup.No) false])
    ;; `(<= len 0)` guarding an empty-table early return is the other common way
    ;; this gets written, and it decides positivity on its false edge.
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (ir.CompilerIrBinOp.Le)
      len
      (ir.CompilerIrValue.I64 0)
      (ast.AstType.I64))
      [(OptDomCmpLookup.Some value) (not value)]
      [(OptDomCmpLookup.No) false])
    (match (opt-dom-cmp-lookup
      type-segment-bases
      cmp-facts
      (ir.CompilerIrBinOp.Lt)
      (ir.CompilerIrValue.I64 0)
      len
      (ast.AstType.I64))
      [(OptDomCmpLookup.Some value) value]
      [(OptDomCmpLookup.No) false])))

;; --- loop-carried counter in range -------------------------------------------
;;
;; A rotated loop puts its per-iteration test at the LATCH, after the body, so no
;; single comparison dominating the body proves `i < n`. The invariant is still
;; there, just spread across the incoming edges: the preheader enters with the
;; seed and the trip-count test, the latch enters having just tested the stepped
;; value. Proving it therefore means discharging each phi input on its own edge:
;;
;;   i = phi [0, preheader], [i + 1, latch]
;;     preheader edge: a dominating fact gives `0 < n`
;;     latch edge:     the latch's own branch tested `i + 1 < n` and took the
;;                     edge into this block on the true side
;;
;; With `i >= 0` implied by a nonnegative seed and positive steps, the unsigned
;; `bounds_check` is then dead.
;; Terminator branch per block id, so a phi input's source label can be resolved
;; back to the test that guarded its edge.
(define (opt-bounds-dom-terms-fill!
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [index : OptCfgIndex]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (let
              [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
              (if (< count 1)
                unit
                (match (opt-cfg-index-id index label)
                  [(option_i64.None) unit]
                  [(option_i64.Some id)
                    (if (and (>= id 0) (< id (array-length terms)))
                      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                        [(ir.CompilerIrInstr.Branch cond true-label false-label)
                          (set!
                            (array-ref terms id)
                            (OptBoolBranchDef.Some
                              (ir.CompilerIrInstr.Branch
                                cond
                                true-label
                                false-label)
                              label))]
                        [_ unit])
                      unit)])))])
        (opt-bounds-dom-terms-fill! terms index (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bounds-dom-terms-fill!
        terms
        index
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-bounds-dom-terms
  [index : OptCfgIndex]
  [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array OptBoolBranchDef)
  (let
    [count : i64 (opt-cfg-index-block-count index)]
    [terms : (__tl_dyn-array OptBoolBranchDef)
      (array.make-array OptBoolBranchDef count)]
    (begin
      (opt-bounds-dom-terms-fill! terms index blocks)
      terms)))

;; Does the branch ending `from-label` test exactly `stepped < len` and enter
;; `to-label` on the side that makes the test true? Both edges landing on
;; `to-label` proves nothing, so that is rejected.
(define (opt-bounds-dom-edge-tests-lt?
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [from-label : i64]
  [to-label : i64]
  [stepped : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]) : bool
  (match (opt-cfg-index-id index from-label)
    [(option_i64.None) false]
    [(option_i64.Some id)
      (if (or (< id 0) (>= id (array-length terms)))
        false
        (match (array-ref terms id)
          [(OptBoolBranchDef.No) false]
          [(OptBoolBranchDef.Some instr _)
            (match instr
              [(ir.CompilerIrInstr.Branch cond true-label false-label)
                (and
                  (= true-label to-label)
                  (not (= false-label to-label))
                  (match cond
                    [(ir.CompilerIrValue.Var var)
                      (match (opt-bool-branch-def defs var)
                        [(OptBoolBranchDef.No) false]
                        [(OptBoolBranchDef.Some cond-instr _)
                          (match cond-instr
                            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                              (and
                                (opt-binop-eq op (ir.CompilerIrBinOp.Lt))
                                (opt-integer-type? ty)
                                (opt-value-eq
                                  (opt-bounds-dom-resolve copies lhs)
                                  stepped)
                                (opt-value-eq
                                  (opt-bounds-dom-resolve copies rhs)
                                  len))]
                            [_ false])])]
                    [_ false]))]
              [_ false])]))]))

;; One phi input, discharged on its own edge: a literal seed needs `seed < len`,
;; either from a dominating fact or from the same literal bound directly.
;; Anything else must be `self + k` for a positive literal k whose edge was
;; guarded by `self + k < len`.
(define (opt-bounds-dom-counter-input-ok?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [block-label : i64]
  [self : i64]
  [len : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [from-label : i64]) : bool
  (match value
    [(ir.CompilerIrValue.I64 seed)
      (and
        (>= seed 0)
        (match (opt-dom-cmp-lookup
          type-segment-bases
          cmp-facts
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.I64 seed)
          len
          (ast.AstType.I64))
          [(OptDomCmpLookup.Some decided) decided]
          [(OptDomCmpLookup.No)
            (match len
              [(ir.CompilerIrValue.I64 bound) (< seed bound)]
              [_ false])]))]
    [(ir.CompilerIrValue.Var var)
      (and
        (match (opt-bool-branch-def defs var)
          [(OptBoolBranchDef.No) false]
          [(OptBoolBranchDef.Some instr _)
            (match instr
              [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                (and
                  (opt-binop-eq op (ir.CompilerIrBinOp.Add))
                  (opt-integer-type? ty)
                  (match (opt-bounds-dom-resolve copies lhs)
                    [(ir.CompilerIrValue.Var base) (= base self)]
                    [_ false])
                  (match rhs
                    [(ir.CompilerIrValue.I64 step) (> step 0)]
                    [_ false]))]
              [_ false])])
        (opt-bounds-dom-edge-tests-lt?
          index
          terms
          defs
          copies
          from-label
          block-label
          value
          len))]
    [_ false]))

(define (opt-bounds-dom-counter-inputs-ok?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [block-label : i64]
  [self : i64]
  [len : ir.CompilerIrValue]
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Cons value from-label rest)
      (and
        (opt-bounds-dom-counter-input-ok?
          type-segment-bases
          index
          terms
          defs
          copies
          cmp-facts
          block-label
          self
          len
          (opt-bounds-dom-resolve copies value)
          from-label)
        (match (__tl-box-place rest)
          [(ir.CompilerIrPhiInputList.Nil) true]
          [_
            (opt-bounds-dom-counter-inputs-ok?
              type-segment-bases
              index
              terms
              defs
              copies
              cmp-facts
              block-label
              self
              len
              (__tl-box-place rest))]))]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bounds-dom-counter-inputs-ok?
        type-segment-bases
        index
        terms
        defs
        copies
        cmp-facts
        block-label
        self
        len
        (ir.compiler-ir-phi-input-seq-to-list seq))]))

(define (opt-bounds-dom-counter-in-range?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [block-label : i64]
  [idx : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]) : bool
  (match idx
    [(ir.CompilerIrValue.Var var)
      (match (opt-bool-branch-def phi-defs var)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(ir.CompilerIrInstr.Phi dst inputs ty)
              (and
                (opt-integer-type? ty)
                (opt-bounds-dom-counter-inputs-ok?
                  type-segment-bases
                  index
                  terms
                  defs
                  copies
                  cmp-facts
                  block-label
                  dst
                  len
                  inputs))]
            [_ false])])]
    [_ false]))

;; --- index guarded by a dominating signed comparison -------------------------
;;
;; The rotated shape above has to discharge `< len` on each phi edge because no
;; single dominating comparison covers the body. The far more common shape here
;; is the other way round: the test sits in a block that DOMINATES the access --
;; an unrotated loop header (`while (< i n)`, guard first, body second, possibly
;; split across several blocks by a compound guard like `(and (not found) (< i
;; n))`), or an explicit `(if (< i (array-length a)) (array-ref a i) ...)` around
;; a single access. The walk already carries that edge fact down the dominator
;; tree, so `idx < len` is known in the SIGNED domain when the check is reached.
;; The half that is missing is the other conjunct of the unsigned
;; `bounds_check`: `idx >= 0`. A nonnegative literal, a zero-extending cast and
;; an explicit dominating `>= 0` guard all supply it directly (see
;; `opt-bounds-dom-nonneg?` below); the loop counter is the case that needs work.
;;
;; For a counter phi that half is an induction, and the induction needs an
;; explicit no-overflow argument, because TypeLisp integer `+` WRAPS (SPEC 5.4):
;; an index wrapped negative fails the unsigned check and must still trap.
;;
;;   base: a literal seed >= 0 is nonnegative outright.
;;   step: an input `phi + 1` arriving from block L, discharged by a fact
;;         `phi < Y` that is already known to hold AT L.
;;
;; Every fact carries the dominator node it became valid at, so "holds at L" is
;; one dominance test. That is what closes the step case. Write F for the fact's
;; block and H for the phi's own block: H dominates F (F's guard reads the phi,
;; and the pass is verifier-gated so defs dominate uses), so some entry->H path
;; avoids F; splicing an H->L path that avoided F onto it would give an entry->L
;; path without F and contradict F dominating L. Hence EVERY H->L path runs F.
;; Take the last execution of H before a traversal of L->H: F ran after it, with
;; THIS iteration's phi value, and F only carries the fact for edges it is
;; entered by (see the entered-only-via rule on the fact's own edge). So
;; `phi < Y` for the current phi, Y is an i64 and therefore <= i64 MAX, and the
;; stepped value `phi + 1 <= Y <= i64 MAX` cannot wrap. With `phi >= 0` from the
;; induction hypothesis it is >= 1. A step other than 1 is rejected:
;; `phi + k <= Y - 1 + k` is not bounded by an i64.
;;
;; The bounding fact need not be the one that proves the range: a loop whose
;; header tests `i < n` and whose checked access sits behind a further `if`
;; inside the body gets its range from the inner guard and its no-wrap bound
;; from the header guard, which is the shape that dominates this codebase.
(define (opt-bounds-dom-counter-upper-bounded?
  [type-segment-bases : i64]
  [doms : OptDomInfo]
  [facts : OptDomCmpFacts]
  [self : ir.CompilerIrValue]
  [latch-id : i64]) : bool
  (match facts
    [(OptDomCmpFacts.Nil) false]
    [(OptDomCmpFacts.Cons fact rest)
      (match fact
        [(OptDomCmpFact.Fact fact-op fact-lhs _ fact-ty fact-value fact-block)
          (if (and
            ;; Strictly `self < Y`. A `le self Y` is NOT enough: `self <= i64
            ;; MAX` still allows the step to wrap.
            fact-value
            (opt-binop-eq fact-op (ir.CompilerIrBinOp.Lt))
            (opt-value-eq fact-lhs self)
            (opt-type-eq type-segment-bases fact-ty (ast.AstType.I64))
            (opt-dom-info-dominates-id? doms fact-block latch-id))
            true
            (opt-bounds-dom-counter-upper-bounded?
              type-segment-bases
              doms
              (__tl-box-place rest)
              self
              latch-id))])]))

;; One value reaching the counter phi, on the edge it arrives by. `self` (the
;; loop-carried value unchanged on this path) and a nonnegative literal are
;; nonnegative outright. `self + 1` needs the no-wrap bound at that edge. A
;; further phi is the shape a body-level `if` leaves behind -- `(if hit (set!
;; found true) (set! i (+ i 1)))` merges `i` and `i + 1` before the latch -- and
;; is discharged input by input on ITS edges, under `fuel` so the recursion is
;; bounded regardless of how the phis are wired.
(define (opt-bounds-dom-nonneg-counter-input-ok?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [self : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [from-label : i64]
  [fuel : i64]) : bool
  (if (opt-value-eq value self)
    true
    (match value
      [(ir.CompilerIrValue.I64 seed) (>= seed 0)]
      [(ir.CompilerIrValue.Var var)
        (or
          (and
            (match (opt-bool-branch-def defs var)
              [(OptBoolBranchDef.No) false]
              [(OptBoolBranchDef.Some instr _)
                (match instr
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                    (and
                      (opt-binop-eq op (ir.CompilerIrBinOp.Add))
                      (opt-integer-type? ty)
                      (match rhs
                        [(ir.CompilerIrValue.I64 step) (= step 1)]
                        [_ false])
                      (opt-value-eq (opt-bounds-dom-resolve copies lhs) self))]
                  [_ false])])
            (match (opt-cfg-index-id index from-label)
              [(option_i64.None) false]
              [(option_i64.Some from-id)
                (opt-bounds-dom-counter-upper-bounded?
                  type-segment-bases
                  doms
                  cmp-facts
                  self
                  from-id)]))
          (and
            (> fuel 0)
            (match (opt-bool-branch-def phi-defs var)
              [(OptBoolBranchDef.No) false]
              [(OptBoolBranchDef.Some instr _)
                (match instr
                  [(ir.CompilerIrInstr.Phi _ inputs ty)
                    (and
                      (opt-integer-type? ty)
                      (opt-bounds-dom-nonneg-counter-inputs-ok?
                        type-segment-bases
                        index
                        doms
                        defs
                        phi-defs
                        copies
                        cmp-facts
                        self
                        inputs
                        (- fuel 1)))]
                  [_ false])])))]
      [_ false])))

(define (opt-bounds-dom-nonneg-counter-inputs-ok?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [self : ir.CompilerIrValue]
  [inputs : ir.CompilerIrPhiInputList]
  [fuel : i64]) : bool
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Cons value from-label rest)
      (and
        (opt-bounds-dom-nonneg-counter-input-ok?
          type-segment-bases
          index
          doms
          defs
          phi-defs
          copies
          cmp-facts
          self
          (opt-bounds-dom-resolve copies value)
          from-label
          fuel)
        (match (__tl-box-place rest)
          [(ir.CompilerIrPhiInputList.Nil) true]
          [_
            (opt-bounds-dom-nonneg-counter-inputs-ok?
              type-segment-bases
              index
              doms
              defs
              phi-defs
              copies
              cmp-facts
              self
              (__tl-box-place rest)
              fuel)]))]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bounds-dom-nonneg-counter-inputs-ok?
        type-segment-bases
        index
        doms
        defs
        phi-defs
        copies
        cmp-facts
        self
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fuel)]))

;; `idx >= 0` (counter induction) plus a dominating signed `idx < len` decides
;; the unsigned check: both operands are then nonnegative i64s, where unsigned
;; and signed order agree. The phi lookup is one array read and runs first, so
;; the ordinary non-counter check pays only that.
;; A WIDENING cast out of an unsigned type is a zero-extension, so its result
;; occupies at most the source width and cannot reach the destination's sign
;; bit. The equal-width case is a reinterpret and proves nothing.
(define (opt-bounds-dom-zero-extend? [from : ast.AstType] [to : ast.AstType]) : bool
  (and
    (opt-unsigned-integer-type? from)
    (opt-integer-type? to)
    (< (opt-int-width from) (opt-int-width to))))

;; Is `value` provably nonnegative when the check is reached?
(define (opt-bounds-dom-nonneg?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 literal) (>= literal 0)]
    [(ir.CompilerIrValue.Var var)
      (or
        (match (opt-bool-branch-def phi-defs var)
          [(OptBoolBranchDef.No) false]
          [(OptBoolBranchDef.Some instr _)
            (match instr
              [(ir.CompilerIrInstr.Cast _ _ from to)
                (opt-bounds-dom-zero-extend? from to)]
              [(ir.CompilerIrInstr.Phi _ inputs ty)
                (and
                  (opt-integer-type? ty)
                  (opt-bounds-dom-nonneg-counter-inputs-ok?
                    type-segment-bases
                    index
                    doms
                    defs
                    phi-defs
                    copies
                    cmp-facts
                    value
                    inputs
                    2))]
              [_ false])])
        ;; An explicit dominating `(>= i 0)` / `(< i 0)` guard, in either
        ;; spelling. Two fact-list scans, so this runs last.
        (match (opt-dom-cmp-lookup
          type-segment-bases
          cmp-facts
          (ir.CompilerIrBinOp.Le)
          (ir.CompilerIrValue.I64 0)
          value
          (ast.AstType.I64))
          [(OptDomCmpLookup.Some decided) decided]
          [(OptDomCmpLookup.No) false])
        (match (opt-dom-cmp-lookup
          type-segment-bases
          cmp-facts
          (ir.CompilerIrBinOp.Lt)
          value
          (ir.CompilerIrValue.I64 0)
          (ast.AstType.I64))
          [(OptDomCmpLookup.Some decided) (not decided)]
          [(OptDomCmpLookup.No) false]))]
    [_ false]))

;; A dominating SIGNED `idx < len` plus `idx >= 0` decides the unsigned check:
;; both operands are then nonnegative i64s, where unsigned and signed order
;; agree. The signed fact is looked up first -- it is the rarer half, and a
;; check with no dominating comparison at all pays only that scan.
;;
;; A dominating check on the SAME index supplies the nonnegative half directly
;; (see `opt-bounds-index-checked?`), whatever length it used. That is what
;; retires a check an equal-or-stronger dominating check subsumes: the
;; dominating `idx < len1` fact decides `idx < len2` whenever the two lengths
;; are ordered (identical values, or literals the implication rule compares),
;; and the passed check itself decides the rest. The scan runs before the
;; induction reasoning because it is a short walk over the pairs already in
;; hand.
(define (opt-bounds-dom-guarded-in-range?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [doms : OptDomInfo]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [raw-idx : ir.CompilerIrValue]
  [idx : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]) : bool
  (and
    (match (opt-dom-cmp-lookup-chained
      type-segment-bases
      cmp-facts
      (ir.CompilerIrBinOp.Lt)
      idx
      len
      (ast.AstType.I64))
      [(OptDomCmpLookup.Some decided) decided]
      [(OptDomCmpLookup.No) false])
    (or
      (opt-bounds-index-checked? facts raw-idx)
      (opt-bounds-index-checked? facts idx)
      (opt-bounds-dom-nonneg?
        type-segment-bases
        index
        doms
        defs
        phi-defs
        copies
        cmp-facts
        idx))))

;; `bit-and X m` lands in [0, m] for every nonnegative m: bit-and only clears
;; bits, so the result cannot exceed m, and a nonnegative m has a clear sign bit
;; so the result cannot go negative. With `m = len - 1` that puts the index in
;; [0, len) and the check is dead. No power-of-two assumption is involved.
;;
;; `len >= 1` is load-bearing, not a formality: at `len = 0` the mask is -1,
;; `X & -1 = X` is unbounded, and the check must stay to trap. Hence the guard
;; fact requirement -- masking alone proves nothing about an empty array.
(define (opt-bounds-dom-masked-value?
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : ir.CompilerIrValue]
  [idx : ir.CompilerIrValue]) : bool
  (match idx
    [(ir.CompilerIrValue.Var var)
      (match (opt-bool-branch-def defs var)
        [(OptBoolBranchDef.No) false]
        [(OptBoolBranchDef.Some instr _)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
              (and
                (opt-binop-eq op (ir.CompilerIrBinOp.BitAnd))
                (opt-integer-type? ty)
                (or
                  (opt-bounds-dom-len-minus-one?
                    defs
                    copies
                    len
                    (opt-bounds-dom-resolve copies rhs))
                  (opt-bounds-dom-len-minus-one?
                    defs
                    copies
                    len
                    (opt-bounds-dom-resolve copies lhs))))]
            [_ false])])]
    [_ false]))

;; Every input of the phi masked against this same length. A loop-carried probe
;; cursor is exactly this shape: the preheader seeds `hash & mask` and the latch
;; feeds `(cursor + 1) & mask`, so the phi is bounded even though neither the
;; seed nor the step is loop-invariant. Phi inputs are only ever tested as plain
;; masked values, so a phi of a phi answers false rather than recursing.
;; Masked directly, or a phi every input of which is masked against this same
;; length. `depth` bounds the phi recursion: a loop-carried cursor is commonly a
;; phi whose input is another phi (one per exit path of the match), and phis can
;; reference each other cyclically, so the depth counter is what guarantees
;; termination rather than any structural property of the graph.
(define (opt-bounds-dom-masked-or-phi?
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [depth : i64]) : bool
  (or
    (opt-bounds-dom-masked-value? defs copies len value)
    (and
      (> depth 0)
      (match value
        [(ir.CompilerIrValue.Var var)
          (match (opt-bool-branch-def phi-defs var)
            [(OptBoolBranchDef.No) false]
            [(OptBoolBranchDef.Some instr _)
              (match instr
                [(ir.CompilerIrInstr.Phi _ inputs ty)
                  (and
                    (opt-integer-type? ty)
                    (opt-bounds-dom-phi-inputs-masked?
                      defs
                      phi-defs
                      copies
                      len
                      inputs
                      (- depth 1)))]
                [_ false])])]
        [_ false]))))

(define (opt-bounds-dom-phi-inputs-masked?
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [len : ir.CompilerIrValue]
  [inputs : ir.CompilerIrPhiInputList]
  [depth : i64]) : bool
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (and
        (opt-bounds-dom-masked-or-phi?
          defs
          phi-defs
          copies
          len
          (opt-bounds-dom-resolve copies value)
          depth)
        (match (__tl-box-place rest)
          [(ir.CompilerIrPhiInputList.Nil) true]
          [_
            (opt-bounds-dom-phi-inputs-masked?
              defs
              phi-defs
              copies
              len
              (__tl-box-place rest)
              depth)]))]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bounds-dom-phi-inputs-masked?
        defs
        phi-defs
        copies
        len
        (ir.compiler-ir-phi-input-seq-to-list seq)
        depth)]))

(define (opt-bounds-dom-mask-in-range?
  [type-segment-bases : i64]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [raw-idx : ir.CompilerIrValue]
  [raw-len : ir.CompilerIrValue]) : bool
  (let
    [idx : ir.CompilerIrValue
      (opt-bounds-dom-strip-int-cast type-segment-bases phi-defs copies raw-idx)]
    [len : ir.CompilerIrValue
      (opt-bounds-dom-strip-int-cast type-segment-bases phi-defs copies raw-len)]
    (and
      (opt-bounds-dom-len-positive? type-segment-bases cmp-facts len)
      (opt-bounds-dom-masked-or-phi? defs phi-defs copies len idx 4))))

(define (opt-bounds-dom-instrs-from
  [type-segment-bases : i64]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [cfg-index : OptCfgIndex]
  [doms : OptDomInfo]
  [block-label : i64]
  [block-id : i64]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptBoundsDomWalk
  ;; Retain-only walk (drops bounds checks a dominating check/comparison already
  ;; proved, folds decided comparisons), so the output length is not known up
  ;; front: it goes into the capacity-managed dense builder seeded at the input
  ;; length. This used to be a tail-consing recursion -- recurse first, cons the
  ;; head onto the returned tail -- which built the whole block as a 112 B-per-
  ;; instruction spine that `compiler-ir-block` then re-counted and re-copied.
  ;; The facts/cmp-facts threading was already strictly forward (each step hands
  ;; the NEXT step its updated facts and the head is emitted with the facts that
  ;; were current when it was read), so the loop below threads them the same way
  ;; and pushes in the same order. Output is fresh; `instrs` is untouched.
  ;; refs #5726
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity
        (if (< index count)
          (- count index)
          1))]
    [cur-facts : OptBoundsFacts facts]
    [cur-cmp-facts : OptDomCmpFacts cmp-facts]
    [pos : i64 index]
    (begin
      (while (< pos count)
        (let
          [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
          (begin
            (match instr
              [(ir.CompilerIrInstr.BoundsCheck idx len _)
                (let
                  [cidx : ir.CompilerIrValue
                    (opt-bounds-dom-resolve copies idx)]
                  [clen : ir.CompilerIrValue
                    (opt-bounds-dom-resolve copies len)]
                  ;; Both range predicates below reason about the pre-cast i64
                  ;; spelling the guard comparisons use, so strip once here.
                  [sidx : ir.CompilerIrValue
                    (opt-bounds-dom-strip-int-cast
                      type-segment-bases
                      phi-defs
                      copies
                      cidx)]
                  [slen : ir.CompilerIrValue
                    (opt-bounds-dom-strip-int-cast
                      type-segment-bases
                      phi-defs
                      copies
                      clen)]
                  (if (or
                    (opt-bounds-contains cur-facts cidx clen)
                    (opt-bounds-dom-mask-in-range?
                      type-segment-bases
                      defs
                      phi-defs
                      copies
                      cur-cmp-facts
                      cidx
                      clen)
                    (opt-bounds-dom-counter-in-range?
                      type-segment-bases
                      cfg-index
                      terms
                      defs
                      phi-defs
                      copies
                      cur-cmp-facts
                      block-label
                      sidx
                      slen)
                    (opt-bounds-dom-guarded-in-range?
                      type-segment-bases
                      cfg-index
                      doms
                      defs
                      phi-defs
                      copies
                      cur-cmp-facts
                      cur-facts
                      cidx
                      sidx
                      slen))
                    unit
                    (let
                      [stable? : bool
                        (and
                          (opt-gvn-value-stable? sources cidx)
                          (opt-gvn-value-stable? sources clen))]
                      (begin
                        (ir.compiler-ir-instr-builder-push!
                          (&mut builder)
                          instr)
                        ;; A passed bounds check is an unsigned `idx < len`
                        ;; whose length operand is a runtime container length,
                        ;; so len is always < 2^63: the continuation also
                        ;; proves 0 <= idx < len in the SIGNED domain. Record
                        ;; both lt spellings so the dominating-comparison fold
                        ;; kills a later redundant signed test (`le idx len`,
                        ;; `gt len idx`, ...) -- e.g. a loop-versioning guard
                        ;; condition that repeats what a dominating access
                        ;; already checked.
                        (if stable?
                          (begin
                            (set!
                              cur-cmp-facts
                              (OptDomCmpFacts.Cons
                                (OptDomCmpFact.Fact
                                  (ir.CompilerIrBinOp.Lt)
                                  cidx
                                  clen
                                  (ast.AstType.I64)
                                  true
                                  block-id)
                                (box
                                  (OptDomCmpFacts.Cons
                                    (OptDomCmpFact.Fact
                                      (ir.CompilerIrBinOp.Lt)
                                      clen
                                      cidx
                                      (ast.AstType.I64)
                                      false
                                      block-id)
                                    (box cur-cmp-facts)))))
                            (set!
                              cur-facts
                              (opt-bounds-add cur-facts cidx clen)))
                          unit)))))]
              [_
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (opt-bounds-dom-fold-compare
                    type-segment-bases
                    doms
                    cfg-index
                    terms
                    defs
                    phi-defs
                    sources
                    block-id
                    cur-cmp-facts
                    copies
                    instr))])
            (set! pos (+ pos 1)))))
      (OptBoundsDomWalk.Walk
        (ir.compiler-ir-instr-builder-to-seq builder)
        cur-facts
        cur-cmp-facts))))

;; --- a compare every joining edge already decided ----------------------------
;;
;; The facts above flow DOWN the dominator tree, so a compare over a JOIN's phis
;; sees nothing: no single edge into a join dominates it. Yet every edge may
;; decide the same question of the values it carries, and then so is the phi's.
;; A rotated loop leaves exactly that shape -- rotation copies the entry test
;; into the latch, so both the preheader edge and the backedge prove the header's
;; own guard -- and a top-tested loop nested directly under it (an inlined
;; `while` whose first index is the enclosing test's operand) recomputes it once
;; per outer trip:
;;
;;   header:  lo = phi [lo0, preheader], [lo1, latch]
;;            hi = phi [hi0, preheader], [hi1, latch]
;;   body:    t  = lt lo, hi                    ; <- decided, both ways
;;   latch:   c  = lt lo1, hi1
;;            branch c, header, exit            ; proves it of the latch inputs
;;   (preheader is entered only from `branch (lt lo0, hi0), preheader, ...`,
;;    which proves it of the preheader inputs)
;;
;; RULE. `op(a, b)` is decided when at least one operand is a Phi of one block H
;; that dominates the compare, every operand that is a Phi of H is replaced on
;; each edge by that edge's own phi input, and EVERY reachable predecessor edge
;; of H decides the substituted compare the SAME way. An operand that is not a
;; phi of H is carried unchanged: it is then only ever matched by SSA identity
;; against an operand of the deciding branch, which is a use at that branch and
;; so denotes the same runtime value there.
;;
;; The per-edge verdict is read through exactly the implication masks a
;; dominating fact is read through (opt-dom-cmp-edge-fact + opt-dom-cmp-lookup),
;; so no arithmetic, no range join, and no new spelling rule enters -- only the
;; place the fact is read from is new. The substituted operands must be
;; GVN-stable, the same condition the edge facts themselves already carry.
;;
;; WHY A PHI INPUT MAY USE ITS OWN EDGE'S FACT. The phi selects that input only
;; when control arrived along that edge, and arriving along it is precisely what
;; the branch selecting it decided. Nothing is required of H's OTHER edges for
;; one input, which is what separates this from the dominator walk; agreement
;; across all of them is what makes the phi itself decided.
;;
;; AN EDGE WHOSE PREDECESSOR DOES NOT BRANCH inherits the fact of its own sole
;; entry edge: a block whose every other reachable predecessor sits inside its
;; own dominator subtree is entered only through that edge (control reaching a
;; backedge already passed through the block, hence through that edge), and an
;; SSA fact once established stays true. That is the same argument
;; opt-bounds-dom-child-entered-only-via? makes for the downward walk. The hop
;; is bounded by a small fuel; the shapes it closes are one or two hops -- a
;; rotation landing pad, a short-circuit and-chain block.
(define (opt-dom-phi-carried-fuel) : i64
  4)

;; A value's defining Phi: its input list and the block it lives in.
(defenum OptDomPhiCarrier
  (No)
  (Some ir.CompilerIrPhiInputList i64))

(defenum OptDomPhiHome
  (No)
  (Some i64))

(defenum OptDomPhiInput
  (No)
  (Some ir.CompilerIrValue))

(define (opt-bounds-dom-phi-carrier
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : OptDomPhiCarrier
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (not (opt-gvn-stable-var? sources var))
        (OptDomPhiCarrier.No)
        (match (opt-bool-branch-def phi-defs var)
          [(OptBoolBranchDef.No) (OptDomPhiCarrier.No)]
          [(OptBoolBranchDef.Some instr label)
            (match instr
              [(ir.CompilerIrInstr.Phi dst inputs _)
                (if (= dst var)
                  (OptDomPhiCarrier.Some inputs label)
                  (OptDomPhiCarrier.No))]
              [_ (OptDomPhiCarrier.No)])]))]
    [_ (OptDomPhiCarrier.No)]))

;; The block whose edges are asked. Two phi operands must share it -- only then
;; does one edge select both inputs -- and at least one operand must be a phi,
;; or the ordinary dominating lookup already covered the query.
(define (opt-bounds-dom-phi-home
  [carrier-lhs : OptDomPhiCarrier]
  [carrier-rhs : OptDomPhiCarrier]) : OptDomPhiHome
  (match carrier-lhs
    [(OptDomPhiCarrier.Some _ left-label)
      (match carrier-rhs
        [(OptDomPhiCarrier.Some _ right-label)
          (if (= left-label right-label)
            (OptDomPhiHome.Some left-label)
            (OptDomPhiHome.No))]
        [(OptDomPhiCarrier.No) (OptDomPhiHome.Some left-label)])]
    [(OptDomPhiCarrier.No)
      (match carrier-rhs
        [(OptDomPhiCarrier.Some _ right-label) (OptDomPhiHome.Some right-label)]
        [(OptDomPhiCarrier.No) (OptDomPhiHome.No)])]))

;; The single input this phi carries on `label`. Two inputs on one label mean
;; the edge does not name one value, so the walk refuses.
(define (opt-bounds-dom-phi-input-for
  [inputs : ir.CompilerIrPhiInputList]
  [label : i64]
  [found : OptDomPhiInput]) : OptDomPhiInput
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) found]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bounds-dom-phi-input-for
        (ir.compiler-ir-phi-input-seq-to-list seq)
        label
        found)]
    [(ir.CompilerIrPhiInputList.Cons value input-label rest)
      (if (= input-label label)
        (match found
          [(OptDomPhiInput.Some _) (OptDomPhiInput.No)]
          [(OptDomPhiInput.No)
            (opt-bounds-dom-phi-input-for
              (__tl-box-place rest)
              label
              (OptDomPhiInput.Some value))])
        (opt-bounds-dom-phi-input-for (__tl-box-place rest) label found))]))

(define (opt-bounds-dom-phi-edge-operand
  [carrier : OptDomPhiCarrier]
  [value : ir.CompilerIrValue]
  [pred-label : i64]) : OptDomPhiInput
  (match carrier
    [(OptDomPhiCarrier.No) (OptDomPhiInput.Some value)]
    [(OptDomPhiCarrier.Some inputs _)
      (opt-bounds-dom-phi-input-for inputs pred-label (OptDomPhiInput.No))]))

;; The one reachable predecessor of `id` that is not a backedge from inside
;; `id`'s own dominator subtree, or -1 when there is not exactly one. Every
;; other reachable predecessor being such a backedge is what makes this edge the
;; only way in.
(define (opt-bounds-dom-sole-entry-pred
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [id : i64]) : i64
  (let
    [preds : OptCfgCsr index.preds]
    [offsets : (__tl_dyn-array i64) preds.offsets]
    [edges : (__tl_dyn-array i64) preds.edges]
    (if (or (< id 0) (>= (+ id 1) (array-length offsets)))
      (- 0 1)
      (let
        [edge : i64 (array-ref offsets id)]
        [end : i64 (array-ref offsets (+ id 1))]
        [only : i64 (- 0 1)]
        [ok : bool true]
        (begin
          (while (< edge end)
            (begin
              (let
                [pred : i64 (array-ref edges edge)]
                (cond
                  [(or
                      (not (array-ref index.reachable pred))
                      (opt-dom-info-dominates-id? info id pred))
                    unit]
                  [(< only 0) (set! only pred)]
                  [(= only pred) unit]
                  [else (set! ok false)]))
              (set! edge (+ edge 1))))
          (if ok
            only
            (- 0 1)))))))

;; What the edge `pred-id -> to-label` proves about `op(lhs, rhs)`.
(define (opt-bounds-dom-edge-cmp-verdict
  [type-segment-bases : i64]
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [pred-id : i64]
  [to-label : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]
  [fuel : i64]) : OptDomCmpLookup
  (if (or (<= fuel 0) (< pred-id 0) (>= pred-id (array-length terms)))
    (OptDomCmpLookup.No)
    (let
      [direct : OptDomCmpLookup
        (match (array-ref terms pred-id)
          [(OptBoolBranchDef.No) (OptDomCmpLookup.No)]
          [(OptBoolBranchDef.Some instr _)
            (match instr
              [(ir.CompilerIrInstr.Branch cond true-label false-label)
                ;; A branch whose edges share one label decides nothing.
                (if (or
                  (= true-label false-label)
                  (and
                    (not (= true-label to-label))
                    (not (= false-label to-label))))
                  (OptDomCmpLookup.No)
                  (opt-dom-cmp-lookup
                    type-segment-bases
                    (opt-dom-cmp-edge-fact
                      defs
                      copies
                      sources
                      cond
                      (= true-label to-label)
                      pred-id
                      (OptDomCmpFacts.Nil))
                    op
                    lhs
                    rhs
                    ty))]
              [_ (OptDomCmpLookup.No)])])]
      (match direct
        [(OptDomCmpLookup.Some decided) (OptDomCmpLookup.Some decided)]
        [(OptDomCmpLookup.No)
          (let
            [up : i64 (opt-bounds-dom-sole-entry-pred info index pred-id)]
            (if (< up 0)
              (OptDomCmpLookup.No)
              (opt-bounds-dom-edge-cmp-verdict
                type-segment-bases
                info
                index
                terms
                defs
                sources
                copies
                up
                (array-ref index.labels pred-id)
                op
                lhs
                rhs
                ty
                (- fuel 1))))]))))

;; Every reachable edge into `header-id`, each asked about its own phi inputs.
;; Verdict codes: 0 none seen yet, 1 true, 2 false.
(define (opt-bounds-dom-phi-carried-scan
  [type-segment-bases : i64]
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [carrier-lhs : OptDomPhiCarrier]
  [carrier-rhs : OptDomPhiCarrier]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [op : ir.CompilerIrBinOp]
  [ty : ast.AstType]
  [header-id : i64]) : OptDomCmpLookup
  (let
    [preds : OptCfgCsr index.preds]
    [offsets : (__tl_dyn-array i64) preds.offsets]
    [edges : (__tl_dyn-array i64) preds.edges]
    (if (or (< header-id 0) (>= (+ header-id 1) (array-length offsets)))
      (OptDomCmpLookup.No)
      (let
        [header-label : i64 (array-ref index.labels header-id)]
        [edge : i64 (array-ref offsets header-id)]
        [end : i64 (array-ref offsets (+ header-id 1))]
        [verdict : i64 0]
        [ok : bool true]
        (begin
          (while (and ok (< edge end))
            (begin
              (let
                [pred : i64 (array-ref edges edge)]
                (if (not (array-ref index.reachable pred))
                  unit
                  (let
                    [pred-label : i64 (array-ref index.labels pred)]
                    [edge-lhs : OptDomPhiInput
                      (opt-bounds-dom-phi-edge-operand
                        carrier-lhs
                        lhs
                        pred-label)]
                    [edge-rhs : OptDomPhiInput
                      (opt-bounds-dom-phi-edge-operand
                        carrier-rhs
                        rhs
                        pred-label)]
                    (match edge-lhs
                      [(OptDomPhiInput.No) (set! ok false)]
                      [(OptDomPhiInput.Some raw-lhs)
                        (match edge-rhs
                          [(OptDomPhiInput.No) (set! ok false)]
                          [(OptDomPhiInput.Some raw-rhs)
                            (let
                              [clhs : ir.CompilerIrValue
                                (opt-bounds-dom-resolve copies raw-lhs)]
                              [crhs : ir.CompilerIrValue
                                (opt-bounds-dom-resolve copies raw-rhs)]
                              (if (not
                                (and
                                  (opt-gvn-value-stable? sources clhs)
                                  (opt-gvn-value-stable? sources crhs)))
                                (set! ok false)
                                (match (opt-bounds-dom-edge-cmp-verdict
                                  type-segment-bases
                                  info
                                  index
                                  terms
                                  defs
                                  sources
                                  copies
                                  pred
                                  header-label
                                  op
                                  clhs
                                  crhs
                                  ty
                                  (opt-dom-phi-carried-fuel))
                                  [(OptDomCmpLookup.No) (set! ok false)]
                                  [(OptDomCmpLookup.Some decided)
                                    (let
                                      [code : i64
                                        (if decided
                                          1
                                          2)]
                                      (if (= verdict 0)
                                        (set! verdict code)
                                        (if (= verdict code)
                                          unit
                                          (set! ok false))))])))])]))))
              (set! edge (+ edge 1))))
          (if (and ok (> verdict 0))
            (OptDomCmpLookup.Some (= verdict 1))
            (OptDomCmpLookup.No)))))))

(define (opt-bounds-dom-phi-carried-verdict
  [type-segment-bases : i64]
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [block-id : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDomCmpLookup
  (let
    [carrier-lhs : OptDomPhiCarrier
      (opt-bounds-dom-phi-carrier phi-defs sources lhs)]
    [carrier-rhs : OptDomPhiCarrier
      (opt-bounds-dom-phi-carrier phi-defs sources rhs)]
    (match (opt-bounds-dom-phi-home carrier-lhs carrier-rhs)
      [(OptDomPhiHome.No) (OptDomCmpLookup.No)]
      [(OptDomPhiHome.Some header-label)
        (match (opt-cfg-index-id index header-label)
          [(option_i64.None) (OptDomCmpLookup.No)]
          [(option_i64.Some header-id)
            ;; SSA already guarantees the phi's block dominates every use; the
            ;; test keeps the pass's documented non-SSA fallback honest.
            (if (not
              (and
                (>= header-id 0)
                (< header-id (opt-cfg-index-block-count index))
                (array-ref index.reachable header-id)
                (opt-dom-info-dominates-id? info header-id block-id)))
              (OptDomCmpLookup.No)
              (opt-bounds-dom-phi-carried-scan
                type-segment-bases
                info
                index
                terms
                defs
                sources
                copies
                carrier-lhs
                carrier-rhs
                lhs
                rhs
                op
                ty
                header-id))])])))

;; Replace a comparison a dominating branch already decided with its constant.
;; The move keeps the destination and bool type, so every consumer -- branch,
;; select, phi input -- sees an ordinary constant and the later fold/cfg passes
;; collapse the control flow.
(define (opt-bounds-dom-fold-compare
  [type-segment-bases : i64]
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [block-id : i64]
  [cmp-facts : OptDomCmpFacts]
  [copies : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (and (opt-dom-cmp-foldable-op? op) (opt-integer-type? ty))
        (let
          [canon-op : ir.CompilerIrBinOp (opt-dom-cmp-canon-op op)]
          [canon-lhs : ir.CompilerIrValue
            (opt-bounds-dom-resolve copies (opt-dom-cmp-canon-lhs op lhs rhs))]
          [canon-rhs : ir.CompilerIrValue
            (opt-bounds-dom-resolve copies (opt-dom-cmp-canon-rhs op lhs rhs))]
          (match (match (opt-dom-cmp-lookup-chained
            type-segment-bases
            cmp-facts
            canon-op
            canon-lhs
            canon-rhs
            ty)
            [(OptDomCmpLookup.Some value) (OptDomCmpLookup.Some value)]
            [(OptDomCmpLookup.No)
              (opt-bounds-dom-phi-carried-verdict
                type-segment-bases
                info
                index
                terms
                defs
                phi-defs
                sources
                copies
                block-id
                canon-op
                canon-lhs
                canon-rhs
                ty)])
            [(OptDomCmpLookup.No) instr]
            [(OptDomCmpLookup.Some value)
              (ir.CompilerIrInstr.Mov
                dst
                (ir.CompilerIrValue.Bool value)
                (ast.AstType.Bool))]))
        instr)]
    [_ instr]))

(define (opt-bounds-dom-rewrite-id
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [blocks : ir.CompilerIrBlockList]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [id : i64]) : unit
  (let
    [index : OptCfgIndex context.index]
    [count : i64 (opt-cfg-index-block-count index)]
    (if (and (>= id 0) (< id count))
      (let
        [label : i64 (array-ref index.labels id)]
        (match (opt-cfg-index-block index id)
          [(OptMaybeBlock.No) unit]
          [(OptMaybeBlock.Some block)
            (match block
              [(ir.CompilerIrBlock.Block _ instrs)
                (match (opt-bounds-dom-instrs-from
                  type-segment-bases
                  defs
                  phi-defs
                  terms
                  index
                  context.doms
                  label
                  id
                  cmp-facts
                  facts
                  sources
                  copies
                  instrs
                  0)
                  [(OptBoundsDomWalk.Walk rewritten out-facts out-cmp-facts)
                    (begin
                      (set!
                        (array-ref out id)
                        (OptGvnBlockResult.SomeBlock
                          (ir.CompilerIrBlock.Block label rewritten)))
                      (opt-bounds-dom-rewrite-children
                        type-segment-bases
                        context
                        children
                        defs
                        phi-defs
                        terms
                        sources
                        copies
                        out-cmp-facts
                        out-facts
                        blocks
                        out
                        id
                        instrs))])])]))
      unit)))

;; The number of predecessors a block has, straight off the CFG index rows.
;; Is `child-id` entered ONLY through the edge from `parent-id`? Every other
;; reachable predecessor must sit inside the child's own dominator subtree, which
;; makes it a backedge: control only got there by passing through the child, and
;; therefore through the parent's edge, already. Unreachable predecessors carry no
;; path at all. A loop header satisfies this -- its preds are the guard block and
;; its own latch -- which is what lets a loop-invariant guard fact reach the body.
(define (opt-bounds-dom-child-entered-only-via?
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [parent-id : i64]
  [child-id : i64]) : bool
  (let
    [preds : OptCfgCsr index.preds]
    [offsets : (__tl_dyn-array i64) preds.offsets]
    [edges : (__tl_dyn-array i64) preds.edges]
    (if (or (< child-id 0) (>= (+ child-id 1) (array-length offsets)))
      false
      (let
        [edge : i64 (array-ref offsets child-id)]
        [end : i64 (array-ref offsets (+ child-id 1))]
        [only : bool true]
        (begin
          (while (< edge end)
            (begin
              (let
                [pred : i64 (array-ref edges edge)]
                (if (or
                  (= pred parent-id)
                  (not (array-ref index.reachable pred))
                  (opt-dom-info-dominates-id? info child-id pred))
                  unit
                  (set! only false)))
              (set! edge (+ edge 1))))
          only)))))

;; Facts to carry into one dominator child: the parent's branch decides its
;; condition for a target the branch is the ONLY way into. A target reachable
;; without taking this edge keeps the parent's facts unchanged.
(define (opt-bounds-dom-child-cmp-facts
  [info : OptDomInfo]
  [index : OptCfgIndex]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [parent-instrs : ir.CompilerIrInstrSeq]
  [parent-id : i64]
  [child-id : i64]) : OptDomCmpFacts
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count parent-instrs)]
    (if (or
      (< count 1)
      (not
        (opt-bounds-dom-child-entered-only-via? info index parent-id child-id)))
      cmp-facts
      (match (ir.compiler-ir-instr-seq-ref parent-instrs (- count 1))
        [(ir.CompilerIrInstr.Branch cond true-label false-label)
          (let
            [child-label : i64 (array-ref index.labels child-id)]
            (cond
              ;; A branch whose edges share one label decides nothing about it.
              [(= true-label false-label) cmp-facts]
              [(= child-label true-label)
                (opt-dom-cmp-edge-fact
                  defs
                  copies
                  sources
                  cond
                  true
                  child-id
                  cmp-facts)]
              [(= child-label false-label)
                (opt-dom-cmp-edge-fact
                  defs
                  copies
                  sources
                  cond
                  false
                  child-id
                  cmp-facts)]
              [else cmp-facts]))]
        [_ cmp-facts]))))

(define (opt-bounds-dom-rewrite-children
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [children : OptCfgCsr]
  [defs : (__tl_dyn-array OptBoolBranchDef)]
  [phi-defs : (__tl_dyn-array OptBoolBranchDef)]
  [terms : (__tl_dyn-array OptBoolBranchDef)]
  [sources : opt_i64_i64_map.Map]
  [copies : opt_i64_i64_map.Map]
  [cmp-facts : OptDomCmpFacts]
  [facts : OptBoundsFacts]
  [blocks : ir.CompilerIrBlockList]
  [out : (__tl_dyn-array OptGvnBlockResult)]
  [parent-id : i64]
  [parent-instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [index : OptCfgIndex context.index]
    [offsets : (__tl_dyn-array i64) children.offsets]
    [edges : (__tl_dyn-array i64) children.edges]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    (begin
      (while (< edge end)
        (begin
          (let
            [child-id : i64 (array-ref edges edge)]
            (opt-bounds-dom-rewrite-id
              type-segment-bases
              context
              children
              defs
              phi-defs
              terms
              sources
              copies
              (opt-bounds-dom-child-cmp-facts
                context.doms
                index
                defs
                sources
                copies
                cmp-facts
                parent-instrs
                parent-id
                child-id)
              facts
              blocks
              out
              child-id))
          (set! edge (+ edge 1))))
      unit)))

(define (opt-bounds-dom-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [sources : opt_i64_i64_map.Map
      (opt-gvn-sources-blocks
        blocks
        (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 64)))]
    [copies : opt_i64_i64_map.Map
      (opt-bounds-dom-copies-add-blocks
        sources
        (opt_i64_i64_map.with-capacity 64)
        blocks)]
    [doms : OptDomInfo context.doms]
    [index : OptCfgIndex context.index]
    [count : i64 (opt-cfg-index-block-count index)]
    [children : OptCfgCsr (opt-gvn-dom-children doms)]
    [defs : (__tl_dyn-array OptBoolBranchDef)
      (opt-bool-branch-defs frame blocks)]
    [phi-defs : (__tl_dyn-array OptBoolBranchDef)
      (opt-bounds-dom-phi-defs frame blocks)]
    [terms : (__tl_dyn-array OptBoolBranchDef)
      (opt-bounds-dom-terms index blocks)]
    [out : (__tl_dyn-array OptGvnBlockResult)
      (array.make-array OptGvnBlockResult count)]
    (begin
      (opt-cfg-index-refresh-blocks! index blocks)
      (match (opt-cfg-index-id index context.entry-label)
        [(option_i64.Some entry-id)
          (if (and (>= entry-id 0) (array-ref index.reachable entry-id))
            (opt-bounds-dom-rewrite-id
              type-segment-bases
              context
              children
              defs
              phi-defs
              terms
              sources
              copies
              (OptDomCmpFacts.Nil)
              (OptBoundsFacts.Nil)
              blocks
              out
              entry-id)
            unit)]
        [(option_i64.None) unit])
      (opt-gvn-materialize-blocks doms out blocks))))

;; --- proven-safe div/rem guard elision --------------------------------------
;;
;; This pass marks integer div/rem as non-trapping only from facts established by
;; explicit dominating CFG edge checks. It deliberately ignores casts and joins:
;; a fact reaches a successor only when that successor has exactly one reachable
;; predecessor, so facts are never accidentally unioned across paths.
(defenum OptDivRemFactKind
  (NonZero)
  (NotNegOne)
  (NotSignedMin))

(defenum OptDivRemFact
  (Fact i64 ast.AstType OptDivRemFactKind))

(defenum OptDivRemFacts
  (Nil)
  (Cons OptDivRemFact (Box OptDivRemFacts)))

(defenum OptDivRemCmp
  (NoCmp)
  (Cmp ir.CompilerIrBinOp ir.CompilerIrValue ir.CompilerIrValue ast.AstType i64))

(defenum OptDivRemBlockResult
  (NoBlock)
  (SomeBlock ir.CompilerIrBlock))

(defenum OptDivRemInstrRewrite
  (Rewrite OptDivRemFacts ir.CompilerIrInstrSeq))

(defenum OptDivRemBlockRewrite
  (Rewrite ir.CompilerIrBlock OptDivRemFacts))

(define (opt-divrem-fact-kind-eq?
  [a : OptDivRemFactKind]
  [b : OptDivRemFactKind]) : bool
  (match a
    [(OptDivRemFactKind.NonZero)
      (match b
        [(OptDivRemFactKind.NonZero) true]
        [_ false])]
    [(OptDivRemFactKind.NotNegOne)
      (match b
        [(OptDivRemFactKind.NotNegOne) true]
        [_ false])]
    [(OptDivRemFactKind.NotSignedMin)
      (match b
        [(OptDivRemFactKind.NotSignedMin) true]
        [_ false])]))

(define (opt-divrem-facts-contains-kind?
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [kind : OptDivRemFactKind]) : bool
  (match facts
    [(OptDivRemFacts.Nil) false]
    [(OptDivRemFacts.Cons fact rest)
      (match fact
        [(OptDivRemFact.Fact fact-var fact-ty fact-kind)
          (if (and
            (= fact-var var)
            (opt-type-eq type-segment-bases fact-ty ty)
            (opt-divrem-fact-kind-eq? fact-kind kind))
            true
            (opt-divrem-facts-contains-kind?
              type-segment-bases
              (__tl-box-place rest)
              var
              ty
              kind))])]))

(define (opt-divrem-facts-add-kind
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [kind : OptDivRemFactKind]) : OptDivRemFacts
  (if (opt-divrem-facts-contains-kind? type-segment-bases facts var ty kind)
    facts
    (OptDivRemFacts.Cons (OptDivRemFact.Fact var ty kind) (box facts))))

(define (opt-divrem-facts-remove-var [facts : OptDivRemFacts] [var : i64]) : OptDivRemFacts
  (match facts
    [(OptDivRemFacts.Nil) (OptDivRemFacts.Nil)]
    [(OptDivRemFacts.Cons fact rest)
      (match fact
        [(OptDivRemFact.Fact fact-var _ _)
          (let
            [rest2 : OptDivRemFacts
              (opt-divrem-facts-remove-var (__tl-box-place rest) var)]
            (if (= fact-var var)
              rest2
              (OptDivRemFacts.Cons fact (box rest2))))])]))

(define (opt-divrem-add-nonzero
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind
    type-segment-bases
    facts
    var
    ty
    (OptDivRemFactKind.NonZero)))

(define (opt-divrem-add-not-neg-one
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind
    type-segment-bases
    facts
    var
    ty
    (OptDivRemFactKind.NotNegOne)))

(define (opt-divrem-add-not-signed-min
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]) : OptDivRemFacts
  (opt-divrem-facts-add-kind
    type-segment-bases
    facts
    var
    ty
    (OptDivRemFactKind.NotSignedMin)))

(define (opt-divrem-add-exact-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (!= value 0)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (!= value (- 0 1)))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (!= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-not-eq-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (= value 0)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-gt-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (opt-typed-ge? value 0 ty)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (>= value (- 0 1)))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (>= value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-ge-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (opt-typed-gt? value 0 ty)
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    [not-neg-one : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (>= value 0))
        (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
        nonzero)]
    (if (and (opt-signed-integer-type? ty) (> value (opt-signed-min ty)))
      (opt-divrem-add-not-signed-min type-segment-bases not-neg-one var ty)
      not-neg-one)))

(define (opt-divrem-add-lt-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (<= value 0))
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    (if (and (opt-signed-integer-type? ty) (<= value (- 0 1)))
      (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
      nonzero)))

(define (opt-divrem-add-le-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [value : i64]) : OptDivRemFacts
  (let
    [nonzero : OptDivRemFacts
      (if (and (opt-signed-integer-type? ty) (< value 0))
        (opt-divrem-add-nonzero type-segment-bases facts var ty)
        facts)]
    (if (and (opt-signed-integer-type? ty) (<= value (- 0 2)))
      (opt-divrem-add-not-neg-one type-segment-bases nonzero var ty)
      nonzero)))

(define (opt-divrem-add-compare-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [var : i64]
  [ty : ast.AstType]
  [op : ir.CompilerIrBinOp]
  [value : i64]) : OptDivRemFacts
  (if (not (opt-integer-type? ty))
    facts
    (match op
      [(ir.CompilerIrBinOp.Eq)
        (opt-divrem-add-exact-facts type-segment-bases facts var ty value)]
      [(ir.CompilerIrBinOp.Ne)
        (opt-divrem-add-not-eq-facts type-segment-bases facts var ty value)]
      [(ir.CompilerIrBinOp.Gt)
        (opt-divrem-add-gt-facts type-segment-bases facts var ty value)]
      [(ir.CompilerIrBinOp.Ge)
        (opt-divrem-add-ge-facts type-segment-bases facts var ty value)]
      [(ir.CompilerIrBinOp.Lt)
        (opt-divrem-add-lt-facts type-segment-bases facts var ty value)]
      [(ir.CompilerIrBinOp.Le)
        (opt-divrem-add-le-facts type-segment-bases facts var ty value)]
      [_ facts])))

(define (opt-divrem-invert-compare [op : ir.CompilerIrBinOp]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Eq) (ir.CompilerIrBinOp.Ne)]
    [(ir.CompilerIrBinOp.Ne) (ir.CompilerIrBinOp.Eq)]
    [(ir.CompilerIrBinOp.Lt) (ir.CompilerIrBinOp.Ge)]
    [(ir.CompilerIrBinOp.Le) (ir.CompilerIrBinOp.Gt)]
    [(ir.CompilerIrBinOp.Gt) (ir.CompilerIrBinOp.Le)]
    [(ir.CompilerIrBinOp.Ge) (ir.CompilerIrBinOp.Lt)]
    [_ op]))

(define (opt-divrem-flip-compare [op : ir.CompilerIrBinOp]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Lt) (ir.CompilerIrBinOp.Gt)]
    [(ir.CompilerIrBinOp.Le) (ir.CompilerIrBinOp.Ge)]
    [(ir.CompilerIrBinOp.Gt) (ir.CompilerIrBinOp.Lt)]
    [(ir.CompilerIrBinOp.Ge) (ir.CompilerIrBinOp.Le)]
    [_ op]))

(define (opt-divrem-edge-compare-op
  [op : ir.CompilerIrBinOp]
  [truthy-edge? : bool]) : ir.CompilerIrBinOp
  (if truthy-edge?
    op
    (opt-divrem-invert-compare op)))

(define (opt-divrem-compare-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Eq) true]
    [(ir.CompilerIrBinOp.Ne) true]
    [(ir.CompilerIrBinOp.Lt) true]
    [(ir.CompilerIrBinOp.Le) true]
    [(ir.CompilerIrBinOp.Gt) true]
    [(ir.CompilerIrBinOp.Ge) true]
    [_ false]))

(define (opt-divrem-value-type
  [types : OptSsaVarTypes]
  [value : ir.CompilerIrValue]
  [fallback : ast.AstType]) : ast.AstType
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (opt-ssa-var-types-lookup types var)
        [(OptMaybeAstType.Some ty) ty]
        [(OptMaybeAstType.No) fallback])]
    [_ fallback]))

(define (opt-divrem-add-edge-facts-from-cmp
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [cmp-index : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptDivRemFacts
  (let
    [operand-ty : ast.AstType
      (match lhs
        [(ir.CompilerIrValue.Var _) (opt-divrem-value-type types lhs ty)]
        [_ (opt-divrem-value-type types rhs ty)])]
    (match lhs
      [(ir.CompilerIrValue.Var var)
        (if (opt-divrem-var-defined-at-or-after? instrs cmp-index var)
          facts
          (match (opt-normalize-scalar-to-i64 rhs operand-ty)
            [(option_i64.Some value)
              (opt-divrem-add-compare-facts
                type-segment-bases
                facts
                var
                operand-ty
                op
                value)]
            [(option_i64.None) facts]))]
      [_
        (match rhs
          [(ir.CompilerIrValue.Var var)
            (if (opt-divrem-var-defined-at-or-after? instrs cmp-index var)
              facts
              (match (opt-normalize-scalar-to-i64 lhs operand-ty)
                [(option_i64.Some value)
                  (opt-divrem-add-compare-facts
                    type-segment-bases
                    facts
                    var
                    operand-ty
                    (opt-divrem-flip-compare op)
                    value)]
                [(option_i64.None) facts]))]
          [_ facts])])))

(define (opt-divrem-edge-facts
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [cond : ir.CompilerIrValue]
  [truthy-edge? : bool]) : OptDivRemFacts
  (match cond
    [(ir.CompilerIrValue.Var cond-var)
      (match (opt-divrem-find-cmp-def instrs cond-var)
        [(OptDivRemCmp.Cmp op lhs rhs ty cmp-index)
          (opt-divrem-add-edge-facts-from-cmp
            type-segment-bases
            facts
            types
            instrs
            cmp-index
            (opt-divrem-edge-compare-op op truthy-edge?)
            lhs
            rhs
            ty)]
        [(OptDivRemCmp.NoCmp) facts])]
    [_ facts]))

(define (opt-divrem-find-cmp-def-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [cond-var : i64]) : OptDivRemCmp
  (if (< index 0)
    (OptDivRemCmp.NoCmp)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
        (if (and (= dst cond-var) (opt-divrem-compare-op? op))
          (OptDivRemCmp.Cmp op lhs rhs ty index)
          (opt-divrem-find-cmp-def-from instrs (- index 1) cond-var))]
      [_ (opt-divrem-find-cmp-def-from instrs (- index 1) cond-var)])))

(define (opt-divrem-find-cmp-def
  [instrs : ir.CompilerIrInstrSeq]
  [cond-var : i64]) : OptDivRemCmp
  (opt-divrem-find-cmp-def-from
    instrs
    (- (ir.compiler-ir-instr-seq-count instrs) 1)
    cond-var))

(define (opt-divrem-instr-def-var [instr : ir.CompilerIrInstr]) : option_i64.Option
  (match instr
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _) (option_i64.Some dst)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _) (option_i64.Some dst)]
    [_ (opt-instr-def-var instr)]))

(define (opt-divrem-instr-defines-var? [instr : ir.CompilerIrInstr] [var : i64]) : bool
  (match (opt-divrem-instr-def-var instr)
    [(option_i64.Some dst) (= dst var)]
    [(option_i64.None) false]))

(define (opt-divrem-var-defined-at-or-after-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [var : i64]) : bool
  (if (>= index count)
    false
    (if (opt-divrem-instr-defines-var?
      (ir.compiler-ir-instr-seq-ref instrs index)
      var)
      true
      (opt-divrem-var-defined-at-or-after-from? instrs (+ index 1) count var))))

(define (opt-divrem-var-defined-at-or-after?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (opt-divrem-var-defined-at-or-after-from?
    instrs
    index
    (ir.compiler-ir-instr-seq-count instrs)
    var))

(define (opt-divrem-literal-proves-kind?
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [kind : OptDivRemFactKind]) : bool
  (match (opt-normalize-scalar-to-i64 value ty)
    [(option_i64.Some n)
      (match kind
        [(OptDivRemFactKind.NonZero) (!= n 0)]
        [(OptDivRemFactKind.NotNegOne)
          (if (opt-signed-integer-type? ty)
            (!= n (- 0 1))
            true)]
        [(OptDivRemFactKind.NotSignedMin)
          (if (opt-signed-integer-type? ty)
            (!= n (opt-signed-min ty))
            true)])]
    [(option_i64.None) false]))

(define (opt-divrem-value-proves-kind?
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [kind : OptDivRemFactKind]) : bool
  (if (opt-divrem-literal-proves-kind? value ty kind)
    true
    (match value
      [(ir.CompilerIrValue.Var var)
        (opt-divrem-facts-contains-kind? type-segment-bases facts var ty kind)]
      [_ false])))

(define (opt-divrem-proven-safe?
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (if (not (opt-integer-type? ty))
    false
    (if (opt-unsigned-integer-type? ty)
      (opt-divrem-value-proves-kind?
        type-segment-bases
        facts
        rhs
        ty
        (OptDivRemFactKind.NonZero))
      (and
        (opt-divrem-value-proves-kind?
          type-segment-bases
          facts
          rhs
          ty
          (OptDivRemFactKind.NonZero))
        (or
          (opt-divrem-value-proves-kind?
            type-segment-bases
            facts
            rhs
            ty
            (OptDivRemFactKind.NotNegOne))
          (opt-divrem-value-proves-kind?
            type-segment-bases
            facts
            lhs
            ty
            (OptDivRemFactKind.NotSignedMin)))))))

(define (opt-divrem-rewrite-op
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Div)
      (if (opt-divrem-proven-safe? type-segment-bases facts lhs rhs ty)
        (ir.CompilerIrBinOp.SafeDiv)
        op)]
    [(ir.CompilerIrBinOp.Mod)
      (if (opt-divrem-proven-safe? type-segment-bases facts lhs rhs ty)
        (ir.CompilerIrBinOp.SafeMod)
        op)]
    [_ op]))

(define (opt-divrem-rewrite-instr
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        dst
        (opt-divrem-rewrite-op type-segment-bases facts op lhs rhs ty)
        lhs
        rhs
        ty)]
    [_ instr]))

(define (opt-divrem-facts-after-instr
  [facts : OptDivRemFacts]
  [instr : ir.CompilerIrInstr]) : OptDivRemFacts
  (match (opt-divrem-instr-def-var instr)
    [(option_i64.Some dst) (opt-divrem-facts-remove-var facts dst)]
    [(option_i64.None) facts]))

;; 1:1 rewrite with forward-threaded facts. The old form accumulated a reversed
;; cons list and reversed it back at the end; the fact threading is unchanged,
;; the output just lands in a right-sized dense array. Output is fresh;
;; `instrs` is untouched. refs #5726
(define (opt-divrem-rewrite-instr-seq
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [instrs : ir.CompilerIrInstrSeq]) : OptDivRemInstrRewrite
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [current : OptDivRemFacts facts]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [rewritten : ir.CompilerIrInstr
            (opt-divrem-rewrite-instr
              type-segment-bases
              current
              (ir.compiler-ir-instr-seq-ref instrs index))]
          (begin
            (set! (array-ref out index) rewritten)
            (set! current (opt-divrem-facts-after-instr current rewritten))
            (set! index (+ index 1)))))
      (OptDivRemInstrRewrite.Rewrite current (ir.CompilerIrInstrSeq out count)))))

(define (opt-divrem-rewrite-block
  [type-segment-bases : i64]
  [facts : OptDivRemFacts]
  [block : ir.CompilerIrBlock]) : OptDivRemBlockRewrite
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (match (opt-divrem-rewrite-instr-seq type-segment-bases facts instrs)
        [(OptDivRemInstrRewrite.Rewrite final-facts rewritten)
          (OptDivRemBlockRewrite.Rewrite
            (ir.CompilerIrBlock.Block label rewritten)
            final-facts)])]))

(define (opt-divrem-reachable-pred-count [index : OptCfgIndex] [id : i64]) : i64
  (if (and (>= id 0) (< id (opt-cfg-index-block-count index)))
    (let
      [preds : OptCfgCsr index.preds]
      [edge : i64 (array-ref preds.offsets id)]
      [end : i64 (array-ref preds.offsets (+ id 1))]
      [count : i64 0]
      (begin
        (while (< edge end)
          (let
            [pred : i64 (array-ref preds.edges edge)]
            (begin
              (if (array-ref index.reachable pred)
                (set! count (+ count 1))
                unit)
              (set! edge (+ edge 1)))))
        count))
    0))

(define (opt-divrem-set-successor-facts!
  [index : OptCfgIndex]
  [facts-by-id : (__tl_dyn-array OptDivRemFacts)]
  [label : i64]
  [facts : OptDivRemFacts]) : unit
  (match (opt-cfg-index-id index label)
    [(option_i64.Some id)
      (if (and
        (array-ref index.reachable id)
        (= (opt-divrem-reachable-pred-count index id) 1))
        (set! (array-ref facts-by-id id) facts)
        unit)]
    [(option_i64.None) unit]))

(define (opt-divrem-propagate-terminator!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [facts-by-id : (__tl_dyn-array OptDivRemFacts)]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [terminator : ir.CompilerIrInstr]) : unit
  (match terminator
    [(ir.CompilerIrInstr.Jump label)
      (opt-divrem-set-successor-facts! index facts-by-id label facts)]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (begin
        (opt-divrem-set-successor-facts!
          index
          facts-by-id
          true-label
          (opt-divrem-edge-facts
            type-segment-bases
            facts
            types
            instrs
            cond
            true))
        (opt-divrem-set-successor-facts!
          index
          facts-by-id
          false-label
          (opt-divrem-edge-facts
            type-segment-bases
            facts
            types
            instrs
            cond
            false)))]
    [_ unit]))

(define (opt-divrem-propagate-block!
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [facts-by-id : (__tl_dyn-array OptDivRemFacts)]
  [facts : OptDivRemFacts]
  [types : OptSsaVarTypes]
  [block : ir.CompilerIrBlock]) : unit
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (> count 0)
          (opt-divrem-propagate-terminator!
            type-segment-bases
            index
            facts-by-id
            facts
            types
            instrs
            (ir.compiler-ir-instr-seq-ref instrs (- count 1)))
          unit))]))

(define (opt-divrem-process-rpo!
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [blocks : ir.CompilerIrBlockList]
  [types : OptSsaVarTypes]
  [facts-by-id : (__tl_dyn-array OptDivRemFacts)]
  [out : (__tl_dyn-array OptDivRemBlockResult)]
  [slot : i64]) : unit
  (let
    [index : OptCfgIndex context.index]
    (if (>= slot index.reach-count)
      unit
      (let
        [id : i64 (opt-cfg-index-rpo-id index slot)]
        [facts : OptDivRemFacts (array-ref facts-by-id id)]
        (begin
          (match (opt-cfg-index-block index id)
            [(OptMaybeBlock.Some block)
              (let
                [rewrite : OptDivRemBlockRewrite
                  (opt-divrem-rewrite-block type-segment-bases facts block)]
                (match rewrite
                  [(OptDivRemBlockRewrite.Rewrite rewritten final-facts)
                    (begin
                      (set!
                        (array-ref out id)
                        (OptDivRemBlockResult.SomeBlock rewritten))
                      (opt-divrem-propagate-block!
                        type-segment-bases
                        index
                        facts-by-id
                        final-facts
                        types
                        rewritten))]))]
            [(OptMaybeBlock.No) unit])
          (opt-divrem-process-rpo!
            type-segment-bases
            context
            blocks
            types
            facts-by-id
            out
            (+ slot 1)))))))

(define (opt-divrem-materialize-blocks
  [context : OptCfgContext]
  [out : (__tl_dyn-array OptDivRemBlockResult)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            [material : ir.CompilerIrBlock
              (match (opt-cfg-index-id context.index label)
                [(option_i64.Some id)
                  (if (and (>= id 0) (< id (array-length out)))
                    (match (array-ref out id)
                      [(OptDivRemBlockResult.SomeBlock rewritten) rewritten]
                      [(OptDivRemBlockResult.NoBlock) block])
                    block)]
                [(option_i64.None) block])]
            (ir.compiler-ir-block-cons
              material
              (opt-divrem-materialize-blocks context out (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-divrem-materialize-blocks
        context
        out
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Cheap any-Div/Mod pre-scan for the divrem-safety pass (allocation-free: no
;; facts, no copies, returns at the first hit). The pass can only rewrite
;; CompilerIrBinOp.Div / CompilerIrBinOp.Mod ops -- opt-divrem-rewrite-op is
;; identity for every other op -- so a function containing neither op is
;; returned unchanged, exactly the content the full pass materializes for it
;; (no block rewrite can fire), without building the SSA facts, the per-block
;; fact/result arrays, or the per-block rewrite copies.
(define (opt-divrem-instr-has-divmod? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op _ _ _)
      (match op
        [(ir.CompilerIrBinOp.Div) true]
        [(ir.CompilerIrBinOp.Mod) true]
        [_ false])]
    [_ false]))

(define (opt-divrem-instr-seq-has-divmod?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-divrem-instr-has-divmod?
      (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-divrem-instr-seq-has-divmod? instrs (+ index 1)))))

(define (opt-divrem-block-seq-has-divmod?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (match (ir.compiler-ir-block-seq-ref blocks index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (if (opt-divrem-instr-seq-has-divmod? instrs 0)
          true
          (opt-divrem-block-seq-has-divmod? blocks (+ index 1)))])))

(define (opt-divrem-blocks-have-divmod? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-divrem-instr-seq-has-divmod? instrs 0)
            true
            (opt-divrem-blocks-have-divmod? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-divrem-block-seq-has-divmod? seq 0)]))

(define (opt-divrem-safety-blocks-with-context
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (not (opt-divrem-blocks-have-divmod? blocks))
    ;; No Div/Mod op anywhere: every rewrite is identity, so the pass output
    ;; equals the input; skip the SSA facts build and the per-block copies.
    blocks
    (let
      [index : OptCfgIndex context.index]
      [count : i64 (opt-cfg-index-block-count index)]
      [ssa-facts : OptSsaFacts
        (opt-ssa-facts-from-function type-segment-bases params blocks)]
      [types : OptSsaVarTypes
        (match ssa-facts
          [(OptSsaFacts.Facts _ _ fact-types) fact-types])]
      [facts : (__tl_dyn-array OptDivRemFacts)
        (array.make-array OptDivRemFacts count)]
      [out : (__tl_dyn-array OptDivRemBlockResult)
        (array.make-array OptDivRemBlockResult count)]
      (begin
        (opt-cfg-index-refresh-blocks! index blocks)
        (opt-divrem-process-rpo!
          type-segment-bases
          context
          blocks
          types
          facts
          out
          0)
        (opt-divrem-materialize-blocks context out blocks)))))

(define (opt-divrem-safety-blocks
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-divrem-safety-blocks-with-context
    type-segment-bases
    (opt-cfg-context-build blocks)
    params
    blocks))

;; --- guarded loop bounds-check elimination ---------------------------------
;;
;; The block-local bounds pass can only remove a repeated check in the same
;; block. This function pass handles the lowered dynamic-array loop shape:
;; a dominating fat-handle length store, a while header guarding `i < n`, and a
;; body bounds check against the same array length. It also handles the lowered
;; String shape where a header `string-length` load and a body `string-ref`
;; length load read the same handle. It runs before stack promotion so the
;; direct fat-handle stores/loads are still visible; later DCE removes the
;; now-dead length load/cast scaffolding.
(defenum OptLoopBceExpr
  (Unknown)
  (Value ir.CompilerIrValue)
  (Argc)
  (Bin ir.CompilerIrBinOp (Box OptLoopBceExpr) (Box OptLoopBceExpr) ast.AstType))

(defenum OptLoopBceExprEnv
  (Nil)
  (Cons i64 OptLoopBceExpr (Box OptLoopBceExprEnv)))

(defenum OptLoopBceAliasEnv
  (Nil)
  (Cons i64 i64 (Box OptLoopBceAliasEnv)))

(defenum OptLoopBcePtrKind
  (Unknown)
  (LengthSlot i64)
  (DataSlot i64)
  (DataBuffer i64)
  (DataElement i64))

(defenum OptLoopBcePtrEnv
  (Nil)
  (Cons i64 OptLoopBcePtrKind (Box OptLoopBcePtrEnv)))

(defenum OptLoopBceLengthEnv
  (Nil)
  (Cons i64 OptLoopBceExpr (Box OptLoopBceLengthEnv)))

(defenum OptLoopBceCmpEnv
  (Nil)
  (Cons
    i64
    ir.CompilerIrBinOp
    OptLoopBceExpr
    OptLoopBceExpr
    ast.AstType
    (Box OptLoopBceCmpEnv)))

(defenum OptLoopBceGuard
  (Guard i64 OptLoopBceExpr OptLoopBceExpr))

(defenum OptLoopBceGuardEnv
  (Nil)
  (Dense (__tl_dyn-array OptLoopBceGuard) i64))

(define (opt-loop-bce-guard-ref [env : OptLoopBceGuardEnv] [index : i64]) : OptLoopBceGuard
  (match env
    [(OptLoopBceGuardEnv.Nil)
      (OptLoopBceGuard.Guard
        -1
        (OptLoopBceExpr.Unknown)
        (OptLoopBceExpr.Unknown))]
    [(OptLoopBceGuardEnv.Dense items len) (array-ref items (- (- len 1) index))]))

(define (opt-loop-bce-guard-tail [env : OptLoopBceGuardEnv]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense items len)
      (if (<= len 1)
        (OptLoopBceGuardEnv.Nil)
        (OptLoopBceGuardEnv.Dense items (- len 1)))]))

(define (opt-loop-bce-guard-cons
  [label : i64]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]
  [env : OptLoopBceGuardEnv]) : OptLoopBceGuardEnv
  (let
    [guard : OptLoopBceGuard (OptLoopBceGuard.Guard label index length)]
    (match env
      [(OptLoopBceGuardEnv.Nil)
        (let
          [items : (__tl_dyn-array OptLoopBceGuard)
            (array.make-array OptLoopBceGuard 4)]
          (begin
            (set! (array-ref items 0) guard)
            (OptLoopBceGuardEnv.Dense items 1)))]
      [(OptLoopBceGuardEnv.Dense items len)
        (if (< len (array-length items))
          (begin
            (set! (array-ref items len) guard)
            (OptLoopBceGuardEnv.Dense items (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptLoopBceGuard)
              (array.make-array OptLoopBceGuard (opt-dense-next-capacity len))]
            [slot : i64 0]
            (begin
              (while (< slot len)
                (begin
                  (set! (array-ref bigger slot) (array-ref items slot))
                  (set! slot (+ slot 1))))
              (set! (array-ref bigger len) guard)
              (OptLoopBceGuardEnv.Dense bigger (+ len 1)))))])))

(defenum OptRangeFact
  (Nonnegative i64 OptLoopBceExpr)
  (LessThan i64 OptLoopBceExpr OptLoopBceExpr)
  (LessThanOrEq i64 OptLoopBceExpr OptLoopBceExpr))

(defenum OptRangeFacts
  (Nil)
  (Cons OptRangeFact (Box OptRangeFacts)))

;; Program facts for function-scope global-cell invariance (the "global_cell"
;; pass): which globals can have their cell loaded once at a function's entry
;; and have every in-function use rewritten to that SSA var. `addr-taken`
;; holds every global whose `CompilerIrValue.GlobalAddr` appears anywhere in the
;; program (a store_ptr/syscall/callee could write the cell through such a
;; pointer); `type-index`/`types` map a global's symbol id to its declared
;; AstType so the entry load's Mov carries the exact cell type; `word-cell` is
;; the count of globals that pass both the not-address-taken and the
;; single-word-cell filters (a cheap per-function skip when zero). Built once
;; per program at level 2; empty (and the pass a no-op) elsewhere.
(defstruct OptGlobalCellSummary
  (addr-taken opt_i64_i64_map.Map)
  (type-index opt_i64_i64_map.Map)
  (types (__tl_dyn-array ast.AstType))
  (word-cell i64))

(define (opt-global-cell-summary-empty) : OptGlobalCellSummary
  (OptGlobalCellSummary
    (opt_i64_i64_map.with-capacity 1)
    (opt_i64_i64_map.with-capacity 1)
    (array.make-array ast.AstType 0)
    0))

(defstruct OptLoopBceSummaries
  (enabled bool)
  ;; Compile-profile ownership follows the already per-program summary bundle.
  ;; The disabled state is a one-word sentinel and allocates no summary storage.
  (profile-state profile_state.CompilerProfileState)
  (length-clean opt_i64_i64_map.Map)
  ;; Direct user calls proven not to perform memory writes. LICM consumes this
  ;; to keep descriptor header fields live across read-only helper calls without
  ;; treating arbitrary calls as safe.
  (direct-call-clean opt_i64_i64_map.Map)
  ;; Direct-call memory effects for load GVN. Each packed value records writes
  ;; through checked-reference parameter indices plus global/unknown flags.
  ;; Absence means unresolved (including recursive cycles) and remains a full
  ;; memory barrier.
  (call-memory opt_i64_i64_map.Map)
  (argc-return opt_i64_i64_map.Map)
  ;; Whole-program table of never-written literal-i64 globals, mapping
  ;; global name -> constant value. Carried alongside the BCE summaries (rather
  ;; than threaded as a separate parameter) because both are built once per
  ;; program and consumed in the same per-function level-2 pass. Empty unless
  ;; the program qualifies for summary construction.
  (const-divisors opt_i64_i64_map.Map)
  ;; Whole-program global-cell invariance facts (see OptGlobalCellSummary);
  ;; consumed by the global_cell pass in the level-2 fixpoint pipeline.
  (global-cell OptGlobalCellSummary))

(defstruct OptLoopBceState
  (exprs OptLoopBceExprEnv)
  (aliases OptLoopBceAliasEnv)
  (ptrs OptLoopBcePtrEnv)
  (lengths OptLoopBceLengthEnv)
  (cmps OptLoopBceCmpEnv)
  (guards OptLoopBceGuardEnv)
  (ranges OptRangeFacts))

(defenum OptLoopBceRewrite
  (Rewrite OptLoopBceState ir.CompilerIrInstrList))

(defenum OptLoopBceBlockRewrite
  (Rewrite OptLoopBceState ir.CompilerIrBlock))

(defenum OptLoopBceMaybeLabel
  (NoLabel)
  (SomeLabel i64))

(defenum OptLoopBceMaybeVar
  (NoVar)
  (SomeVar i64))

(defenum OptLoopBceIndexDef
  (NoDef)
  (Zero)
  (Increment)
  (Other))

(defenum OptLoopBceHeaderEdges
  (Edges bool bool bool))

(defenum OptLoopBceBlockResult
  (NoBlock)
  (SomeBlock ir.CompilerIrBlock))

(define (opt-loop-bce-empty-summaries) : OptLoopBceSummaries
  (OptLoopBceSummaries
    false
    (profile_state.compiler-profile-state-new)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt_i64_i64_map.with-capacity 8)
    (opt-global-cell-summary-empty)))

(define (opt-loop-bce-summary-length-clean?
  [summaries : OptLoopBceSummaries]
  [name : i64]) : bool
  (opt_i64_i64_map.contains?
    (& summaries.length-clean)
    (ir.compiler-ir-symbol-id name)))

(define (opt-loop-bce-summary-argc-return?
  [summaries : OptLoopBceSummaries]
  [name : i64]) : bool
  (opt_i64_i64_map.contains?
    (& summaries.argc-return)
    (ir.compiler-ir-symbol-id name)))

(define (opt-loop-bce-commutative-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Add) true]
    [(ir.CompilerIrBinOp.Mul) true]
    [(ir.CompilerIrBinOp.And) true]
    [(ir.CompilerIrBinOp.Or) true]
    [(ir.CompilerIrBinOp.BitAnd) true]
    [(ir.CompilerIrBinOp.BitOr) true]
    [(ir.CompilerIrBinOp.BitXor) true]
    [_ false]))

(define (opt-loop-bce-expr-eq
  [type-segment-bases : i64]
  [a : OptLoopBceExpr]
  [b : OptLoopBceExpr]) : bool
  (match a
    [(OptLoopBceExpr.Unknown) false]
    [(OptLoopBceExpr.Value av)
      (match b
        [(OptLoopBceExpr.Value bv) (opt-value-eq av bv)]
        [_ false])]
    [(OptLoopBceExpr.Argc)
      (match b
        [(OptLoopBceExpr.Argc) true]
        [_ false])]
    [(OptLoopBceExpr.Bin aop al ar aty)
      (match b
        [(OptLoopBceExpr.Bin bop bl br bty)
          (and
            (opt-binop-eq aop bop)
            (opt-type-eq type-segment-bases aty bty)
            (or
              (and
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (__tl-box-place al)
                  (__tl-box-place bl))
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (__tl-box-place ar)
                  (__tl-box-place br)))
              (and
                (opt-loop-bce-commutative-op? aop)
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (__tl-box-place al)
                  (__tl-box-place br))
                (opt-loop-bce-expr-eq
                  type-segment-bases
                  (__tl-box-place ar)
                  (__tl-box-place bl)))))]
        [_ false])]))

(define (opt-range-nonnegative-contains?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [expr : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.Nonnegative fact-label fact-expr)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-expr expr))
            true
            (opt-range-nonnegative-contains?
              type-segment-bases
              (__tl-box-place rest)
              label
              expr))]
        [_
          (opt-range-nonnegative-contains?
            type-segment-bases
            (__tl-box-place rest)
            label
            expr)])]))

(define (opt-range-less-than-contains?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.LessThan fact-label fact-lhs fact-rhs)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-lhs lhs)
            (opt-loop-bce-expr-eq type-segment-bases fact-rhs rhs))
            true
            (opt-range-less-than-contains?
              type-segment-bases
              (__tl-box-place rest)
              label
              lhs
              rhs))]
        [_
          (opt-range-less-than-contains?
            type-segment-bases
            (__tl-box-place rest)
            label
            lhs
            rhs)])]))

(define (opt-range-less-than-or-eq-contains?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match facts
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.LessThanOrEq fact-label fact-lhs fact-rhs)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-lhs lhs)
            (opt-loop-bce-expr-eq type-segment-bases fact-rhs rhs))
            true
            (opt-range-less-than-or-eq-contains?
              type-segment-bases
              (__tl-box-place rest)
              label
              lhs
              rhs))]
        [_
          (opt-range-less-than-or-eq-contains?
            type-segment-bases
            (__tl-box-place rest)
            label
            lhs
            rhs)])]))

(define (opt-range-proves-less-than-or-eq?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (or
    (opt-loop-bce-expr-eq type-segment-bases lhs rhs)
    (opt-range-less-than-contains? type-segment-bases facts label lhs rhs)
    (opt-range-less-than-or-eq-contains? type-segment-bases facts label lhs rhs)))

(define (opt-range-proves-less-than-through-one-bound-from?
  [type-segment-bases : i64]
  [all-facts : OptRangeFacts]
  [scan : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (match scan
    [(OptRangeFacts.Nil) false]
    [(OptRangeFacts.Cons fact rest)
      (match fact
        [(OptRangeFact.LessThan fact-label fact-lhs fact-mid)
          (if (and
            (= fact-label label)
            (opt-loop-bce-expr-eq type-segment-bases fact-lhs lhs)
            (opt-range-proves-less-than-or-eq?
              type-segment-bases
              all-facts
              label
              fact-mid
              rhs))
            true
            (opt-range-proves-less-than-through-one-bound-from?
              type-segment-bases
              all-facts
              (__tl-box-place rest)
              label
              lhs
              rhs))]
        [_
          (opt-range-proves-less-than-through-one-bound-from?
            type-segment-bases
            all-facts
            (__tl-box-place rest)
            label
            lhs
            rhs)])]))

(define (opt-range-proves-less-than-through-one-bound?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (opt-range-proves-less-than-through-one-bound-from?
    type-segment-bases
    facts
    facts
    label
    lhs
    rhs))

(define (opt-range-proves-less-than?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : bool
  (or
    (opt-range-less-than-contains? type-segment-bases facts label lhs rhs)
    (opt-range-proves-less-than-through-one-bound?
      type-segment-bases
      facts
      label
      lhs
      rhs)))

(define (opt-range-proves-nonnegative?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [expr : OptLoopBceExpr]) : bool
  (opt-range-nonnegative-contains? type-segment-bases facts label expr))

(define (opt-range-facts-add-nonnegative
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [expr : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-nonnegative-contains? type-segment-bases facts label expr)
    facts
    (OptRangeFacts.Cons (OptRangeFact.Nonnegative label expr) (box facts))))

(define (opt-range-facts-add-less-than
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-less-than-contains? type-segment-bases facts label lhs rhs)
    facts
    (OptRangeFacts.Cons (OptRangeFact.LessThan label lhs rhs) (box facts))))

(define (opt-range-facts-add-less-than-or-eq
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (if (opt-range-less-than-or-eq-contains?
    type-segment-bases
    facts
    label
    lhs
    rhs)
    facts
    (OptRangeFacts.Cons (OptRangeFact.LessThanOrEq label lhs rhs) (box facts))))

(define (opt-range-facts-propagate-label-from
  [type-segment-bases : i64]
  [source : OptRangeFacts]
  [out : OptRangeFacts]
  [parent-label : i64]
  [child-label : i64]) : OptRangeFacts
  (if (= parent-label child-label)
    out
    (match source
      [(OptRangeFacts.Nil) out]
      [(OptRangeFacts.Cons fact rest)
        (let
          [next : OptRangeFacts
            (match fact
              [(OptRangeFact.Nonnegative label expr)
                (if (= label parent-label)
                  (opt-range-facts-add-nonnegative
                    type-segment-bases
                    out
                    child-label
                    expr)
                  out)]
              [(OptRangeFact.LessThan label lhs rhs)
                (if (= label parent-label)
                  (opt-range-facts-add-less-than
                    type-segment-bases
                    out
                    child-label
                    lhs
                    rhs)
                  out)]
              [(OptRangeFact.LessThanOrEq label lhs rhs)
                (if (= label parent-label)
                  (opt-range-facts-add-less-than-or-eq
                    type-segment-bases
                    out
                    child-label
                    lhs
                    rhs)
                  out)])]
          (opt-range-facts-propagate-label-from
            type-segment-bases
            (__tl-box-place rest)
            next
            parent-label
            child-label))])))

(define (opt-range-facts-propagate-label
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [parent-label : i64]
  [child-label : i64]) : OptRangeFacts
  (opt-range-facts-propagate-label-from
    type-segment-bases
    facts
    facts
    parent-label
    child-label))

(define (opt-range-expr-stable?
  [sources : opt_i64_i64_map.Map]
  [expr : OptLoopBceExpr]) : bool
  (match expr
    [(OptLoopBceExpr.Unknown) false]
    [(OptLoopBceExpr.Argc) true]
    [(OptLoopBceExpr.Value value) (opt-gvn-value-stable? sources value)]
    [(OptLoopBceExpr.Bin op lhs rhs _)
      (and
        (not (opt-binop-traps? op))
        (opt-range-expr-stable? sources (__tl-box-place lhs))
        (opt-range-expr-stable? sources (__tl-box-place rhs)))]))

(define (opt-range-expr-type
  [types : OptSsaVarTypes]
  [expr : OptLoopBceExpr]
  [fallback : ast.AstType]) : ast.AstType
  (match expr
    [(OptLoopBceExpr.Value value) (opt-divrem-value-type types value fallback)]
    [(OptLoopBceExpr.Argc) (ast.AstType.I64)]
    [(OptLoopBceExpr.Bin _ _ _ ty) ty]
    [(OptLoopBceExpr.Unknown) fallback]))

(define (opt-range-compare-operand-type
  [types : OptSsaVarTypes]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [fallback : ast.AstType]) : ast.AstType
  (let
    [lhs-ty : ast.AstType (opt-range-expr-type types lhs fallback)]
    (if (opt-integer-type? lhs-ty)
      lhs-ty
      (opt-range-expr-type types rhs fallback))))

(define (opt-range-compare-value-type
  [types : OptSsaVarTypes]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [fallback : ast.AstType]) : ast.AstType
  (match lhs
    [(ir.CompilerIrValue.Var _) (opt-divrem-value-type types lhs fallback)]
    [_ (opt-divrem-value-type types rhs fallback)]))

(define (opt-range-expr-i64 [expr : OptLoopBceExpr] [ty : ast.AstType]) : option_i64.Option
  (match expr
    [(OptLoopBceExpr.Value value) (opt-normalize-scalar-to-i64 value ty)]
    [_ (option_i64.None)]))

(define (opt-range-upper-minus-offset-expr
  [upper : OptLoopBceExpr]
  [offset : i64]
  [ty : ast.AstType]) : OptLoopBceExpr
  (match (opt-range-expr-i64 upper ty)
    [(option_i64.Some value)
      (if (>= value 0)
        (OptLoopBceExpr.Value (ir.CompilerIrValue.I64 (- value offset)))
        (OptLoopBceExpr.Bin
          (ir.CompilerIrBinOp.Sub)
          (box upper)
          (box (OptLoopBceExpr.Value (ir.CompilerIrValue.I64 offset)))
          ty))]
    [(option_i64.None)
      (OptLoopBceExpr.Bin
        (ir.CompilerIrBinOp.Sub)
        (box upper)
        (box (OptLoopBceExpr.Value (ir.CompilerIrValue.I64 offset)))
        ty)]))

(define (opt-range-proves-additive-index-parts-in-range?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [base : OptLoopBceExpr]
  [offset-expr : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [ty : ast.AstType]
  [upper-known-nonnegative : bool]) : bool
  (match (opt-range-expr-i64 offset-expr ty)
    [(option_i64.Some offset)
      ;; `base < upper - k` only proves `(base + k) < upper` when the trusted
      ;; upper length prevents `upper - k` from wrapping upward.
      (and
        (> offset 0)
        upper-known-nonnegative
        (opt-range-proves-nonnegative? type-segment-bases facts label base)
        (opt-range-proves-less-than?
          type-segment-bases
          facts
          label
          base
          (opt-range-upper-minus-offset-expr upper offset ty)))]
    [(option_i64.None) false]))

(define (opt-range-proves-additive-index-in-range?
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [label : i64]
  [index : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [upper-known-nonnegative : bool]) : bool
  (match index
    [(OptLoopBceExpr.Bin op lhs rhs ty)
      (if (and
        (opt-binop-eq op (ir.CompilerIrBinOp.Add))
        (opt-signed-integer-type? ty))
        (or
          (opt-range-proves-additive-index-parts-in-range?
            type-segment-bases
            facts
            label
            (__tl-box-place lhs)
            (__tl-box-place rhs)
            upper
            ty
            upper-known-nonnegative)
          (opt-range-proves-additive-index-parts-in-range?
            type-segment-bases
            facts
            label
            (__tl-box-place rhs)
            (__tl-box-place lhs)
            upper
            ty
            upper-known-nonnegative))
        false)]
    [_ false]))

(define (opt-range-add-nonnegative-from-compare
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [label : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : ast.AstType]) : OptRangeFacts
  (if (not (opt-integer-type? ty))
    facts
    (let
      [from-lhs : OptRangeFacts
        (if (opt-range-expr-stable? sources lhs)
          (match (opt-range-expr-i64 rhs ty)
            [(option_i64.Some value)
              (match op
                [(ir.CompilerIrBinOp.Ge)
                  (if (= value 0)
                    (opt-range-facts-add-nonnegative
                      type-segment-bases
                      facts
                      label
                      lhs)
                    facts)]
                [(ir.CompilerIrBinOp.Gt)
                  (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
                    (opt-range-facts-add-nonnegative
                      type-segment-bases
                      facts
                      label
                      lhs)
                    facts)]
                [_ facts])]
            [(option_i64.None) facts])
          facts)]
      (if (opt-range-expr-stable? sources rhs)
        (match (opt-range-expr-i64 lhs ty)
          [(option_i64.Some value)
            (match op
              [(ir.CompilerIrBinOp.Le)
                (if (= value 0)
                  (opt-range-facts-add-nonnegative
                    type-segment-bases
                    from-lhs
                    label
                    rhs)
                  from-lhs)]
              [(ir.CompilerIrBinOp.Lt)
                (if (and (opt-signed-integer-type? ty) (= value (- 0 1)))
                  (opt-range-facts-add-nonnegative
                    type-segment-bases
                    from-lhs
                    label
                    rhs)
                  from-lhs)]
              [_ from-lhs])]
          [(option_i64.None) from-lhs])
        from-lhs))))

(define (opt-range-add-less-than-from-compare
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [label : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(ir.CompilerIrBinOp.Lt)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than type-segment-bases facts label lhs rhs)
        facts)]
    [(ir.CompilerIrBinOp.Gt)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than type-segment-bases facts label rhs lhs)
        facts)]
    [_ facts]))

(define (opt-range-add-less-than-or-eq-from-compare
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [label : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(ir.CompilerIrBinOp.Le)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than-or-eq
          type-segment-bases
          facts
          label
          lhs
          rhs)
        facts)]
    [(ir.CompilerIrBinOp.Ge)
      (if (and
        (opt-range-expr-stable? sources lhs)
        (opt-range-expr-stable? sources rhs))
        (opt-range-facts-add-less-than-or-eq
          type-segment-bases
          facts
          label
          rhs
          lhs)
        facts)]
    [_ facts]))

(define (opt-range-add-edge-facts
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [label : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [fallback-ty : ast.AstType]) : OptRangeFacts
  (let
    [operand-ty : ast.AstType
      (opt-range-compare-operand-type types lhs rhs fallback-ty)]
    [less : OptRangeFacts
      (opt-range-add-less-than-from-compare
        type-segment-bases
        facts
        sources
        label
        op
        lhs
        rhs)]
    [less-or-eq : OptRangeFacts
      (opt-range-add-less-than-or-eq-from-compare
        type-segment-bases
        less
        sources
        label
        op
        lhs
        rhs)]
    [nonnegative : OptRangeFacts
      (opt-range-add-nonnegative-from-compare
        type-segment-bases
        less-or-eq
        sources
        label
        op
        lhs
        rhs
        operand-ty)]
    (if (and
      (opt-unsigned-integer-type? operand-ty)
      (match op
        [(ir.CompilerIrBinOp.Lt) true]
        [(ir.CompilerIrBinOp.Gt) true]
        [_ false]))
      (match op
        [(ir.CompilerIrBinOp.Lt)
          (if (opt-range-expr-stable? sources lhs)
            (opt-range-facts-add-nonnegative
              type-segment-bases
              nonnegative
              label
              lhs)
            nonnegative)]
        [(ir.CompilerIrBinOp.Gt)
          (if (opt-range-expr-stable? sources rhs)
            (opt-range-facts-add-nonnegative
              type-segment-bases
              nonnegative
              label
              rhs)
            nonnegative)]
        [_ nonnegative])
      nonnegative)))

(define (opt-loop-bce-expr-unbind [env : OptLoopBceExprEnv] [var : i64]) : OptLoopBceExprEnv
  (match env
    [(OptLoopBceExprEnv.Nil) (OptLoopBceExprEnv.Nil)]
    [(OptLoopBceExprEnv.Cons id expr rest)
      (let
        [tail : OptLoopBceExprEnv
          (opt-loop-bce-expr-unbind (__tl-box-place rest) var)]
        (if (= id var)
          tail
          (OptLoopBceExprEnv.Cons id expr (box tail))))]))

(define (opt-loop-bce-expr-bind
  [env : OptLoopBceExprEnv]
  [var : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceExprEnv
  (match expr
    [(OptLoopBceExpr.Unknown) (opt-loop-bce-expr-unbind env var)]
    [_
      (OptLoopBceExprEnv.Cons var expr (box (opt-loop-bce-expr-unbind env var)))]))

(define (opt-loop-bce-expr-lookup [env : OptLoopBceExprEnv] [var : i64]) : OptLoopBceExpr
  (match env
    [(OptLoopBceExprEnv.Nil) (OptLoopBceExpr.Unknown)]
    [(OptLoopBceExprEnv.Cons id expr rest)
      (if (= id var)
        expr
        (opt-loop-bce-expr-lookup (__tl-box-place rest) var))]))

(define (opt-loop-bce-alias-unbind [env : OptLoopBceAliasEnv] [var : i64]) : OptLoopBceAliasEnv
  (match env
    [(OptLoopBceAliasEnv.Nil) (OptLoopBceAliasEnv.Nil)]
    [(OptLoopBceAliasEnv.Cons id root rest)
      (let
        [tail : OptLoopBceAliasEnv
          (opt-loop-bce-alias-unbind (__tl-box-place rest) var)]
        (if (= id var)
          tail
          (OptLoopBceAliasEnv.Cons id root (box tail))))]))

(define (opt-loop-bce-alias-bind
  [env : OptLoopBceAliasEnv]
  [var : i64]
  [root : i64]) : OptLoopBceAliasEnv
  (OptLoopBceAliasEnv.Cons var root (box (opt-loop-bce-alias-unbind env var))))

(define (opt-loop-bce-alias-resolve-depth
  [env : OptLoopBceAliasEnv]
  [var : i64]
  [depth : i64]) : i64
  (if (> depth 32)
    var
    (match env
      [(OptLoopBceAliasEnv.Nil) var]
      [(OptLoopBceAliasEnv.Cons id root rest)
        (if (= id var)
          (if (= root var)
            root
            (opt-loop-bce-alias-resolve-depth env root (+ depth 1)))
          (opt-loop-bce-alias-resolve-depth (__tl-box-place rest) var depth))])))

(define (opt-loop-bce-alias-resolve [env : OptLoopBceAliasEnv] [var : i64]) : i64
  (opt-loop-bce-alias-resolve-depth env var 0))

(define (opt-loop-bce-ptr-unbind [env : OptLoopBcePtrEnv] [var : i64]) : OptLoopBcePtrEnv
  (match env
    [(OptLoopBcePtrEnv.Nil) (OptLoopBcePtrEnv.Nil)]
    [(OptLoopBcePtrEnv.Cons id kind rest)
      (let
        [tail : OptLoopBcePtrEnv
          (opt-loop-bce-ptr-unbind (__tl-box-place rest) var)]
        (if (= id var)
          tail
          (OptLoopBcePtrEnv.Cons id kind (box tail))))]))

(define (opt-loop-bce-ptr-bind
  [env : OptLoopBcePtrEnv]
  [var : i64]
  [kind : OptLoopBcePtrKind]) : OptLoopBcePtrEnv
  (match kind
    [(OptLoopBcePtrKind.Unknown) (opt-loop-bce-ptr-unbind env var)]
    [_ (OptLoopBcePtrEnv.Cons var kind (box (opt-loop-bce-ptr-unbind env var)))]))

(define (opt-loop-bce-ptr-lookup [env : OptLoopBcePtrEnv] [var : i64]) : OptLoopBcePtrKind
  (match env
    [(OptLoopBcePtrEnv.Nil) (OptLoopBcePtrKind.Unknown)]
    [(OptLoopBcePtrEnv.Cons id kind rest)
      (if (= id var)
        kind
        (opt-loop-bce-ptr-lookup (__tl-box-place rest) var))]))

(define (opt-loop-bce-length-unbind [env : OptLoopBceLengthEnv] [object : i64]) : OptLoopBceLengthEnv
  (match env
    [(OptLoopBceLengthEnv.Nil) (OptLoopBceLengthEnv.Nil)]
    [(OptLoopBceLengthEnv.Cons id expr rest)
      (let
        [tail : OptLoopBceLengthEnv
          (opt-loop-bce-length-unbind (__tl-box-place rest) object)]
        (if (= id object)
          tail
          (OptLoopBceLengthEnv.Cons id expr (box tail))))]))

(define (opt-loop-bce-length-bind
  [env : OptLoopBceLengthEnv]
  [object : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceLengthEnv
  (match expr
    [(OptLoopBceExpr.Unknown) (opt-loop-bce-length-unbind env object)]
    [_
      (OptLoopBceLengthEnv.Cons
        object
        expr
        (box (opt-loop-bce-length-unbind env object)))]))

(define (opt-loop-bce-length-lookup [env : OptLoopBceLengthEnv] [object : i64]) : OptLoopBceExpr
  (match env
    [(OptLoopBceLengthEnv.Nil) (OptLoopBceExpr.Unknown)]
    [(OptLoopBceLengthEnv.Cons id expr rest)
      (if (= id object)
        expr
        (opt-loop-bce-length-lookup (__tl-box-place rest) object))]))

(define (opt-loop-bce-cmp-unbind [env : OptLoopBceCmpEnv] [var : i64]) : OptLoopBceCmpEnv
  (match env
    [(OptLoopBceCmpEnv.Nil) (OptLoopBceCmpEnv.Nil)]
    [(OptLoopBceCmpEnv.Cons id op lhs rhs ty rest)
      (let
        [tail : OptLoopBceCmpEnv
          (opt-loop-bce-cmp-unbind (__tl-box-place rest) var)]
        (if (= id var)
          tail
          (OptLoopBceCmpEnv.Cons id op lhs rhs ty (box tail))))]))

(define (opt-loop-bce-cmp-bind
  [env : OptLoopBceCmpEnv]
  [var : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : ast.AstType]) : OptLoopBceCmpEnv
  (OptLoopBceCmpEnv.Cons
    var
    op
    lhs
    rhs
    ty
    (box (opt-loop-bce-cmp-unbind env var))))

(define (opt-loop-bce-cmp-lookup [env : OptLoopBceCmpEnv] [var : i64]) : OptLoopBceCmpEnv
  (match env
    [(OptLoopBceCmpEnv.Nil) (OptLoopBceCmpEnv.Nil)]
    [(OptLoopBceCmpEnv.Cons id op lhs rhs ty rest)
      (if (= id var)
        (OptLoopBceCmpEnv.Cons id op lhs rhs ty (box OptLoopBceCmpEnv.Nil))
        (opt-loop-bce-cmp-lookup (__tl-box-place rest) var))]))

(define (opt-loop-bce-guard-unbind [env : OptLoopBceGuardEnv] [label : i64]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense _ _)
      (match (opt-loop-bce-guard-ref env 0)
        [(OptLoopBceGuard.Guard id index length)
          (let
            [tail : OptLoopBceGuardEnv
              (opt-loop-bce-guard-unbind (opt-loop-bce-guard-tail env) label)]
            (if (= id label)
              tail
              (opt-loop-bce-guard-cons id index length tail)))])]))

(define (opt-loop-bce-guard-bind
  [env : OptLoopBceGuardEnv]
  [label : i64]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]) : OptLoopBceGuardEnv
  (opt-loop-bce-guard-cons
    label
    index
    length
    (opt-loop-bce-guard-unbind env label)))

(define (opt-loop-bce-guard-lookup [env : OptLoopBceGuardEnv] [label : i64]) : OptLoopBceGuardEnv
  (match env
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense _ _)
      (match (opt-loop-bce-guard-ref env 0)
        [(OptLoopBceGuard.Guard id index length)
          (if (= id label)
            (opt-loop-bce-guard-cons id index length (OptLoopBceGuardEnv.Nil))
            (opt-loop-bce-guard-lookup (opt-loop-bce-guard-tail env) label))])]))

(define (opt-loop-bce-value-expr
  [sources : opt_i64_i64_map.Map]
  [env : OptLoopBceExprEnv]
  [value : ir.CompilerIrValue]) : OptLoopBceExpr
  (match value
    [(ir.CompilerIrValue.Var id)
      (if (opt-gvn-stable-var? sources id)
        (let
          [found : OptLoopBceExpr (opt-loop-bce-expr-lookup env id)]
          (match found
            [(OptLoopBceExpr.Unknown) (OptLoopBceExpr.Value value)]
            [_ found]))
        (OptLoopBceExpr.Value value))]
    [_ (OptLoopBceExpr.Value value)]))

(define (opt-loop-bce-same-width-int-cast?
  [type-segment-bases : i64]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (or
    (and
      (opt-type-eq type-segment-bases from-ty (ast.AstType.I64))
      (opt-type-eq type-segment-bases to-ty (ast.AstType.U64)))
    (and
      (opt-type-eq type-segment-bases from-ty (ast.AstType.U64))
      (opt-type-eq type-segment-bases to-ty (ast.AstType.I64)))
    (opt-type-eq type-segment-bases from-ty to-ty)))

(define (opt-loop-bce-data-slot? [offset : ir.CompilerIrValue]) : bool
  (match offset
    [(ir.CompilerIrValue.I64 value) (= value 0)]
    [_ false]))

(define (opt-loop-bce-expr-uses-var? [expr : OptLoopBceExpr] [var : i64]) : bool
  (match expr
    [(OptLoopBceExpr.Unknown) false]
    [(OptLoopBceExpr.Argc) false]
    [(OptLoopBceExpr.Value value) (opt-value-is-var? value var)]
    [(OptLoopBceExpr.Bin _ lhs rhs _)
      (or
        (opt-loop-bce-expr-uses-var? (__tl-box-place lhs) var)
        (opt-loop-bce-expr-uses-var? (__tl-box-place rhs) var))]))

(define (opt-loop-bce-guard-invalidate-var
  [guards : OptLoopBceGuardEnv]
  [var : i64]) : OptLoopBceGuardEnv
  (match guards
    [(OptLoopBceGuardEnv.Nil) (OptLoopBceGuardEnv.Nil)]
    [(OptLoopBceGuardEnv.Dense _ _)
      (match (opt-loop-bce-guard-ref guards 0)
        [(OptLoopBceGuard.Guard label index length)
          (let
            [tail : OptLoopBceGuardEnv
              (opt-loop-bce-guard-invalidate-var
                (opt-loop-bce-guard-tail guards)
                var)]
            (if (or
              (opt-loop-bce-expr-uses-var? index var)
              (opt-loop-bce-expr-uses-var? length var))
              tail
              (opt-loop-bce-guard-cons label index length tail)))])]))

(define (opt-range-fact-uses-var? [fact : OptRangeFact] [var : i64]) : bool
  (match fact
    [(OptRangeFact.Nonnegative _ expr) (opt-loop-bce-expr-uses-var? expr var)]
    [(OptRangeFact.LessThan _ lhs rhs)
      (or
        (opt-loop-bce-expr-uses-var? lhs var)
        (opt-loop-bce-expr-uses-var? rhs var))]
    [(OptRangeFact.LessThanOrEq _ lhs rhs)
      (or
        (opt-loop-bce-expr-uses-var? lhs var)
        (opt-loop-bce-expr-uses-var? rhs var))]))

(define (opt-range-facts-invalidate-var [facts : OptRangeFacts] [var : i64]) : OptRangeFacts
  (match facts
    [(OptRangeFacts.Nil) (OptRangeFacts.Nil)]
    [(OptRangeFacts.Cons fact rest)
      (let
        [tail : OptRangeFacts
          (opt-range-facts-invalidate-var (__tl-box-place rest) var)]
        (if (opt-range-fact-uses-var? fact var)
          tail
          (OptRangeFacts.Cons fact (box tail))))]))

(define (opt-loop-bce-state-invalidate-def
  [state : OptLoopBceState]
  [var : i64]) : OptLoopBceState
  (OptLoopBceState
    (opt-loop-bce-expr-unbind state.exprs var)
    (opt-loop-bce-alias-unbind state.aliases var)
    (opt-loop-bce-ptr-unbind state.ptrs var)
    (opt-loop-bce-length-unbind state.lengths var)
    (opt-loop-bce-cmp-unbind state.cmps var)
    (opt-loop-bce-guard-invalidate-var state.guards var)
    (opt-range-facts-invalidate-var state.ranges var)))

(define (opt-loop-bce-state-clear-lengths [state : OptLoopBceState]) : OptLoopBceState
  (OptLoopBceState
    state.exprs
    state.aliases
    state.ptrs
    (OptLoopBceLengthEnv.Nil)
    state.cmps
    state.guards
    state.ranges))

(define (opt-loop-bce-state-bind-expr
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    (if (opt-gvn-stable-var? sources dst)
      (OptLoopBceState
        (opt-loop-bce-expr-bind invalid.exprs dst expr)
        invalid.aliases
        invalid.ptrs
        invalid.lengths
        invalid.cmps
        invalid.guards
        invalid.ranges)
      invalid)))

(define (opt-loop-bce-state-bind-alias
  [state : OptLoopBceState]
  [dst : i64]
  [root : i64]) : OptLoopBceState
  (OptLoopBceState
    state.exprs
    (opt-loop-bce-alias-bind state.aliases dst root)
    state.ptrs
    state.lengths
    state.cmps
    state.guards
    state.ranges))

(define (opt-loop-bce-state-bind-ptr
  [state : OptLoopBceState]
  [dst : i64]
  [kind : OptLoopBcePtrKind]) : OptLoopBceState
  (OptLoopBceState
    state.exprs
    state.aliases
    (opt-loop-bce-ptr-bind state.ptrs dst kind)
    state.lengths
    state.cmps
    state.guards
    state.ranges))

(define (opt-loop-bce-state-bind-length
  [state : OptLoopBceState]
  [object : i64]
  [expr : OptLoopBceExpr]) : OptLoopBceState
  (OptLoopBceState
    state.exprs
    state.aliases
    state.ptrs
    (opt-loop-bce-length-bind state.lengths object expr)
    state.cmps
    state.guards
    state.ranges))

(define (opt-loop-bce-state-bind-cmp
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]
  [ty : ast.AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    (if (opt-gvn-stable-var? sources dst)
      (OptLoopBceState
        invalid.exprs
        invalid.aliases
        invalid.ptrs
        invalid.lengths
        (opt-loop-bce-cmp-bind invalid.cmps dst op lhs rhs ty)
        invalid.guards
        invalid.ranges)
      invalid)))

(define (opt-loop-bce-state-bind-guard
  [state : OptLoopBceState]
  [label : i64]
  [index : OptLoopBceExpr]
  [length : OptLoopBceExpr]) : OptLoopBceState
  (OptLoopBceState
    state.exprs
    state.aliases
    state.ptrs
    state.lengths
    state.cmps
    (opt-loop-bce-guard-bind state.guards label index length)
    state.ranges))

(define (opt-loop-bce-state-bind-ranges
  [state : OptLoopBceState]
  [ranges : OptRangeFacts]) : OptLoopBceState
  (OptLoopBceState
    state.exprs
    state.aliases
    state.ptrs
    state.lengths
    state.cmps
    state.guards
    ranges))

(define (opt-loop-bce-expr-var [expr : OptLoopBceExpr]) : OptLoopBceMaybeVar
  (match expr
    [(OptLoopBceExpr.Value value)
      (match value
        [(ir.CompilerIrValue.Var var) (OptLoopBceMaybeVar.SomeVar var)]
        [_ (OptLoopBceMaybeVar.NoVar)])]
    [_ (OptLoopBceMaybeVar.NoVar)]))

(define (opt-loop-bce-label-set-other-than [labels : OptLabelSet] [skip : i64]) : OptLoopBceMaybeLabel
  (match labels
    [(OptLabelSet.Nil) (OptLoopBceMaybeLabel.NoLabel)]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (if (= label skip)
          (opt-loop-bce-label-set-other-than (opt-label-tail labels) skip)
          (match (opt-loop-bce-label-set-other-than
            (opt-label-tail labels)
            skip)
            [(OptLoopBceMaybeLabel.NoLabel)
              (OptLoopBceMaybeLabel.SomeLabel label)]
            [(OptLoopBceMaybeLabel.SomeLabel _) (OptLoopBceMaybeLabel.NoLabel)])))]))

(define (opt-loop-bce-defines-var? [instr : ir.CompilerIrInstr] [var : i64]) : bool
  (= (opt-gvn-instr-dst instr) var))

(define (opt-loop-bce-index-init-step
  [current : OptLoopBceIndexDef]
  [instr : ir.CompilerIrInstr]
  [index-var : i64]) : OptLoopBceIndexDef
  (if (opt-loop-bce-defines-var? instr index-var)
    (match instr
      [(ir.CompilerIrInstr.Mov dst src _)
        (if (= dst index-var)
          (match src
            [(ir.CompilerIrValue.I64 value)
              (if (= value 0)
                (OptLoopBceIndexDef.Zero)
                (OptLoopBceIndexDef.Other))]
            [_ (OptLoopBceIndexDef.Other)])
          (OptLoopBceIndexDef.Other))]
      [_ (OptLoopBceIndexDef.Other)])
    current))

(define (opt-loop-bce-index-init-instrs
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [index-var : i64]
  [current : OptLoopBceIndexDef]) : OptLoopBceIndexDef
  (if (>= index count)
    current
    (opt-loop-bce-index-init-instrs
      slots
      (+ index 1)
      count
      index-var
      (opt-loop-bce-index-init-step current (array-ref slots index) index-var))))

(define (opt-loop-bce-block-last-def-zero?
  [block : ir.CompilerIrBlock]
  [index-var : i64]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (match (opt-loop-bce-index-init-instrs
        instrs.slots
        0
        instrs.len
        index-var
        (OptLoopBceIndexDef.NoDef))
        [(OptLoopBceIndexDef.Zero) true]
        [_ false])]))

(define (opt-loop-bce-plus-one-add?
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [dst : i64]
  [index-var : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp out op lhs rhs ty)
      (and
        (= out dst)
        (opt-binop-eq op (ir.CompilerIrBinOp.Add))
        (opt-type-eq type-segment-bases ty (ast.AstType.I64))
        (or
          (and
            (opt-value-eq lhs (ir.CompilerIrValue.Var index-var))
            (opt-value-eq rhs (ir.CompilerIrValue.I64 1)))
          (and
            (opt-value-eq lhs (ir.CompilerIrValue.I64 1))
            (opt-value-eq rhs (ir.CompilerIrValue.Var index-var)))))]
    [_ false]))

(define (opt-loop-bce-i64-list-remove [items : OptI64List] [value : i64]) : OptI64List
  (match items
    [(OptI64List.Nil) (OptI64List.Nil)]
    [(OptI64List.Cons head rest)
      (let
        [tail : OptI64List
          (opt-loop-bce-i64-list-remove (__tl-box-place rest) value)]
        (if (= head value)
          tail
          (OptI64List.Cons head (box tail))))]))

(define (opt-loop-bce-index-increment-step
  [type-segment-bases : i64]
  [current : OptLoopBceIndexDef]
  [plus-one : OptI64List]
  [instr : ir.CompilerIrInstr]
  [index-var : i64]) : OptLoopBceIndexDef
  (if (opt-loop-bce-defines-var? instr index-var)
    (match instr
      [(ir.CompilerIrInstr.Mov dst src _)
        (if (= dst index-var)
          (match src
            [(ir.CompilerIrValue.Var tmp)
              (if (opt-i64-list-contains? plus-one tmp)
                (OptLoopBceIndexDef.Increment)
                (OptLoopBceIndexDef.Other))]
            [_ (OptLoopBceIndexDef.Other)])
          (OptLoopBceIndexDef.Other))]
      [(ir.CompilerIrInstr.BinOp dst _ _ _ _)
        (if (and
          (= dst index-var)
          (opt-loop-bce-plus-one-add? type-segment-bases instr dst index-var))
          (OptLoopBceIndexDef.Increment)
          (OptLoopBceIndexDef.Other))]
      [_ (OptLoopBceIndexDef.Other)])
    current))

(define (opt-loop-bce-plus-one-update
  [type-segment-bases : i64]
  [plus-one : OptI64List]
  [instr : ir.CompilerIrInstr]
  [index-var : i64]) : OptI64List
  (let
    [dst : i64 (opt-gvn-instr-dst instr)]
    [removed : OptI64List
      (if (= dst (- 0 1))
        plus-one
        (opt-loop-bce-i64-list-remove plus-one dst))]
    (if (and
      (not (= dst (- 0 1)))
      (opt-loop-bce-plus-one-add? type-segment-bases instr dst index-var))
      (opt-i64-list-add removed dst)
      removed)))

(define (opt-loop-bce-index-increment-instrs
  [type-segment-bases : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [index-var : i64]
  [current : OptLoopBceIndexDef]
  [plus-one : OptI64List]) : OptLoopBceIndexDef
  (if (>= index count)
    current
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [next : OptLoopBceIndexDef
        (opt-loop-bce-index-increment-step
          type-segment-bases
          current
          plus-one
          instr
          index-var)]
      [next-plus : OptI64List
        (opt-loop-bce-plus-one-update
          type-segment-bases
          plus-one
          instr
          index-var)]
      (opt-loop-bce-index-increment-instrs
        type-segment-bases
        slots
        (+ index 1)
        count
        index-var
        next
        next-plus))))

(define (opt-loop-bce-block-last-def-increment?
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]
  [index-var : i64]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (match (opt-loop-bce-index-increment-instrs
        type-segment-bases
        instrs.slots
        0
        instrs.len
        index-var
        (OptLoopBceIndexDef.NoDef)
        (OptI64List.Nil))
        [(OptLoopBceIndexDef.Increment) true]
        [_ false])]))

(define (opt-loop-bce-block-jumps-to?
  [block : ir.CompilerIrBlock]
  [target : i64]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 instrs.len]
        (if (= count 0)
          false
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Jump label) (= label target)]
            [_ false])))]))

(define (opt-loop-bce-header-edge-shape
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [preds : OptLabelSet]
  [header-label : i64]
  [index-var : i64]
  [seen-init : bool]
  [seen-latch : bool]) : OptLoopBceHeaderEdges
  (match preds
    [(OptLabelSet.Nil) (OptLoopBceHeaderEdges.Edges true seen-init seen-latch)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (match (opt-cfg-find-block blocks pred)
          [(OptMaybeBlock.Some block)
            (let
              [init? : bool (opt-loop-bce-block-last-def-zero? block index-var)]
              [latch? : bool
                (and
                  (opt-loop-bce-block-last-def-increment?
                    type-segment-bases
                    block
                    index-var)
                  (opt-loop-bce-block-jumps-to? block header-label))]
              (if (or init? latch?)
                (opt-loop-bce-header-edge-shape
                  type-segment-bases
                  blocks
                  (opt-label-tail preds)
                  header-label
                  index-var
                  (or seen-init init?)
                  (or seen-latch latch?))
                (OptLoopBceHeaderEdges.Edges false seen-init seen-latch)))]
          [(OptMaybeBlock.No)
            (OptLoopBceHeaderEdges.Edges false seen-init seen-latch)]))]))

(define (opt-loop-bce-guard-nonnegative?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [header-label : i64]
  [body-label : i64]
  [index-expr : OptLoopBceExpr]) : bool
  (match (opt-loop-bce-expr-var index-expr)
    [(OptLoopBceMaybeVar.NoVar) false]
    [(OptLoopBceMaybeVar.SomeVar index-var)
      (let
        [body-preds : OptLabelSet (opt-cfg-index-predecessors index body-label)]
        [header-preds : OptLabelSet
          (opt-cfg-index-predecessors index header-label)]
        (if (and
          (= (opt-label-count body-preds) 1)
          (opt-label-contains body-preds header-label)
          (= (opt-label-count header-preds) 2))
          (if (opt-label-contains header-preds body-label)
            (match (opt-loop-bce-label-set-other-than header-preds body-label)
              [(OptLoopBceMaybeLabel.SomeLabel preheader-label)
                (match (opt-cfg-find-block blocks preheader-label)
                  [(OptMaybeBlock.Some preheader)
                    (match (opt-cfg-find-block blocks body-label)
                      [(OptMaybeBlock.Some body)
                        (and
                          (opt-loop-bce-block-last-def-zero?
                            preheader
                            index-var)
                          (opt-loop-bce-block-last-def-increment?
                            type-segment-bases
                            body
                            index-var)
                          (opt-loop-bce-block-jumps-to? body header-label))]
                      [(OptMaybeBlock.No) false])]
                  [(OptMaybeBlock.No) false])]
              [(OptLoopBceMaybeLabel.NoLabel) false])
            (match (opt-loop-bce-header-edge-shape
              type-segment-bases
              blocks
              header-preds
              header-label
              index-var
              false
              false)
              [(OptLoopBceHeaderEdges.Edges ok seen-init seen-latch)
                (and ok seen-init seen-latch)]))
          false))]))

(define (opt-loop-bce-induction-start-nonnegative?
  [start : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (match (opt-normalize-scalar-to-i64 start ty)
    [(option_i64.Some value) (>= value 0)]
    [(option_i64.None) false]))

(define (opt-loop-bce-induction-step-safe?
  [step : i64]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]
  [ty : ast.AstType]) : bool
  (if (<= step 0)
    false
    (if (and (= step 1) (not upper-inclusive))
      true
      (match (opt-range-expr-i64 upper ty)
        [(option_i64.Some value)
          (if upper-inclusive
            (<= value (- 9223372036854775807 step))
            (<= value (+ (- 9223372036854775807 step) 1)))]
        [(option_i64.None) false]))))

(define (opt-loop-bce-induction-fact-safe?
  [fact : OptInductionFact]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]) : bool
  (match fact
    [(OptInductionFact.Fact _ start _ step ty)
      (and
        (opt-induction-i64-type? ty)
        (opt-loop-bce-induction-start-nonnegative? start ty)
        (opt-loop-bce-induction-step-safe? step upper upper-inclusive ty))]))

(define (opt-loop-bce-induction-fact-for-var-instr-seq-from
  [type-segment-bases : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptMaybeInductionFact
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptMaybeInductionFact.No)
    (match (opt-induction-fact-from-phi
      type-segment-bases
      body-blocks
      loop
      preheader
      (ir.compiler-ir-instr-seq-ref instrs index))
      [(OptMaybeInductionFact.Some fact)
        (match fact
          [(OptInductionFact.Fact phi-var _ _ _ _)
            (if (= phi-var var)
              (OptMaybeInductionFact.Some fact)
              (opt-loop-bce-induction-fact-for-var-instr-seq-from
                type-segment-bases
                body-blocks
                loop
                preheader
                instrs
                (+ index 1)
                var))])]
      [(OptMaybeInductionFact.No)
        (opt-loop-bce-induction-fact-for-var-instr-seq-from
          type-segment-bases
          body-blocks
          loop
          preheader
          instrs
          (+ index 1)
          var)])))

(define (opt-loop-bce-induction-fact-for-var
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [loop : OptNaturalLoop]
  [preheader : i64]
  [var : i64]) : OptMaybeInductionFact
  (let
    [body-blocks : ir.CompilerIrBlockList
      (opt-natural-loop-current-body-blocks loop blocks)]
    (match (opt-cfg-find-block body-blocks (opt-natural-loop-header loop))
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-loop-bce-induction-fact-for-var-instr-seq-from
              type-segment-bases
              body-blocks
              loop
              preheader
              instrs
              0
              var)])]
      [(OptMaybeBlock.No) (OptMaybeInductionFact.No)])))

(define (opt-loop-bce-canonical-iv-loop
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [header-label : i64]
  [body-label : i64]) : OptMaybeNaturalLoop
  (match loops
    [(OptNaturalLoopList.Nil) (OptMaybeNaturalLoop.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (if (and
        (= (opt-natural-loop-header loop) header-label)
        (opt-label-contains (opt-natural-loop-body loop) body-label)
        (opt-dom-dominates? doms header-label body-label))
        (OptMaybeNaturalLoop.Some loop)
        (opt-loop-bce-canonical-iv-loop
          doms
          (__tl-box-place rest)
          header-label
          body-label))]))

(define (opt-loop-bce-canonical-iv-proof?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [sources : opt_i64_i64_map.Map]
  [header-label : i64]
  [body-label : i64]
  [iv : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]) : bool
  (and
    (opt-range-expr-stable? sources iv)
    (opt-range-expr-stable? sources upper)
    (match (opt-loop-bce-expr-var iv)
      [(OptLoopBceMaybeVar.NoVar) false]
      [(OptLoopBceMaybeVar.SomeVar iv-var)
        (match (opt-loop-bce-canonical-iv-loop
          doms
          loops
          header-label
          body-label)
          [(OptMaybeNaturalLoop.Some loop)
            (match (opt-natural-loop-preheader loop)
              [(OptLoopPreheader.Some preheader)
                (match (opt-loop-bce-induction-fact-for-var
                  type-segment-bases
                  blocks
                  loop
                  preheader
                  iv-var)
                  [(OptMaybeInductionFact.Some fact)
                    (opt-loop-bce-induction-fact-safe?
                      fact
                      upper
                      upper-inclusive)]
                  [(OptMaybeInductionFact.No) false])]
              [(OptLoopPreheader.No) false])]
          [(OptMaybeNaturalLoop.No) false])])))

(define (opt-loop-bce-add-canonical-iv-facts-for-bound
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [sources : opt_i64_i64_map.Map]
  [header-label : i64]
  [body-label : i64]
  [iv : OptLoopBceExpr]
  [upper : OptLoopBceExpr]
  [upper-inclusive : bool]) : OptRangeFacts
  (if (opt-loop-bce-canonical-iv-proof?
    type-segment-bases
    blocks
    doms
    loops
    sources
    header-label
    body-label
    iv
    upper
    upper-inclusive)
    (opt-range-facts-add-nonnegative
      type-segment-bases
      (if upper-inclusive
        (opt-range-facts-add-less-than-or-eq
          type-segment-bases
          facts
          body-label
          iv
          upper)
        (opt-range-facts-add-less-than
          type-segment-bases
          facts
          body-label
          iv
          upper))
      body-label
      iv)
    facts))

(define (opt-loop-bce-add-canonical-iv-facts
  [type-segment-bases : i64]
  [facts : OptRangeFacts]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [loops : OptNaturalLoopList]
  [sources : opt_i64_i64_map.Map]
  [header-label : i64]
  [body-label : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptLoopBceExpr]
  [rhs : OptLoopBceExpr]) : OptRangeFacts
  (match op
    [(ir.CompilerIrBinOp.Lt)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        lhs
        rhs
        false)]
    [(ir.CompilerIrBinOp.Gt)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        rhs
        lhs
        false)]
    [(ir.CompilerIrBinOp.Le)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        lhs
        rhs
        true)]
    [(ir.CompilerIrBinOp.Ge)
      (opt-loop-bce-add-canonical-iv-facts-for-bound
        type-segment-bases
        facts
        blocks
        doms
        loops
        sources
        header-label
        body-label
        rhs
        lhs
        true)]
    [_ facts]))

(define (opt-loop-bce-branch-state
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [cond : ir.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : OptLoopBceState
  (match cond
    [(ir.CompilerIrValue.Var cond-var)
      (match (opt-loop-bce-cmp-lookup state.cmps cond-var)
        [(OptLoopBceCmpEnv.Cons _ op lhs rhs ty _)
          (let
            [marker : OptLoopBceExpr
              (OptLoopBceExpr.Value (ir.CompilerIrValue.I64 (- 0 1)))]
            [operand-ty : ast.AstType
              (opt-range-compare-operand-type types lhs rhs ty)]
            [true-ranges : OptRangeFacts
              (opt-range-add-edge-facts
                type-segment-bases
                state.ranges
                sources
                types
                true-label
                op
                lhs
                rhs
                ty)]
            [false-ranges : OptRangeFacts
              (opt-range-add-edge-facts
                type-segment-bases
                true-ranges
                sources
                types
                false-label
                (opt-divrem-invert-compare op)
                lhs
                rhs
                ty)]
            [canonical-ranges : OptRangeFacts
              (opt-loop-bce-add-canonical-iv-facts
                type-segment-bases
                false-ranges
                blocks
                doms
                loops
                sources
                block-label
                true-label
                op
                lhs
                rhs)]
            [range-state : OptLoopBceState
              (opt-loop-bce-state-bind-ranges state canonical-ranges)]
            [range-nonnegative : bool
              (or
                (opt-range-nonnegative-contains?
                  type-segment-bases
                  range-state.ranges
                  block-label
                  lhs)
                (let
                  [guard : OptLoopBceGuardEnv
                    (opt-loop-bce-guard-lookup state.guards block-label)]
                  (match guard
                    [(OptLoopBceGuardEnv.Nil) false]
                    [(OptLoopBceGuardEnv.Dense _ _)
                      (match (opt-loop-bce-guard-ref guard 0)
                        [(OptLoopBceGuard.Guard _ found found-marker)
                          (and
                            (opt-loop-bce-expr-eq type-segment-bases found lhs)
                            (opt-loop-bce-expr-eq
                              type-segment-bases
                              found-marker
                              marker))])])))]
            [loop-nonnegative : bool
              (opt-loop-bce-guard-nonnegative?
                type-segment-bases
                blocks
                index
                block-label
                true-label
                lhs)]
            (match op
              [(ir.CompilerIrBinOp.Ge)
                (match (opt-range-expr-i64 rhs operand-ty)
                  [(option_i64.Some value)
                    (if (= value 0)
                      (opt-loop-bce-state-bind-guard
                        range-state
                        true-label
                        lhs
                        marker)
                      range-state)]
                  [(option_i64.None) range-state])]
              [(ir.CompilerIrBinOp.Gt)
                (match (opt-range-expr-i64 rhs operand-ty)
                  [(option_i64.Some value)
                    (if (and
                      (opt-signed-integer-type? operand-ty)
                      (= value (- 0 1)))
                      (opt-loop-bce-state-bind-guard
                        range-state
                        true-label
                        lhs
                        marker)
                      range-state)]
                  [(option_i64.None) range-state])]
              [(ir.CompilerIrBinOp.Lt)
                (let
                  [lt-range-state : OptLoopBceState
                    (if loop-nonnegative
                      (opt-loop-bce-state-bind-ranges
                        range-state
                        (opt-range-facts-add-less-than
                          type-segment-bases
                          (opt-range-facts-add-nonnegative
                            type-segment-bases
                            range-state.ranges
                            true-label
                            lhs)
                          true-label
                          lhs
                          rhs))
                      range-state)]
                  (if (or range-nonnegative loop-nonnegative)
                    (opt-loop-bce-state-bind-guard
                      lt-range-state
                      true-label
                      lhs
                      rhs)
                    lt-range-state))]
              [_ range-state]))]
        [(OptLoopBceCmpEnv.Nil) state])]
    [_ state]))

(define (opt-loop-bce-update-gep
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [base : ir.CompilerIrValue]
  [offset : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [aliases : OptLoopBceAliasEnv invalid.aliases]
    [ptrs : OptLoopBcePtrEnv invalid.ptrs]
    [base-kind : OptLoopBcePtrKind
      (match base
        [(ir.CompilerIrValue.Var base-var)
          (opt-loop-bce-ptr-lookup ptrs base-var)]
        [_ (OptLoopBcePtrKind.Unknown)])]
    (match base
      [(ir.CompilerIrValue.Var base-var)
        (let
          [object : i64 (opt-loop-bce-alias-resolve aliases base-var)]
          [kind : OptLoopBcePtrKind
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (OptLoopBcePtrKind.LengthSlot object)
              (if (opt-loop-bce-data-slot? offset)
                (OptLoopBcePtrKind.DataSlot object)
                (match base-kind
                  [(OptLoopBcePtrKind.DataBuffer buffer-object)
                    (OptLoopBcePtrKind.DataElement buffer-object)]
                  [_ (OptLoopBcePtrKind.Unknown)])))]
          (opt-loop-bce-state-bind-ptr
            (opt-loop-bce-state-bind-expr
              invalid
              sources
              dst
              (OptLoopBceExpr.Unknown))
            dst
            kind))]
      [_ invalid])))

(define (opt-loop-bce-update-load
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [ptr-kind : OptLoopBcePtrKind
      (match src
        [(ir.CompilerIrValue.Var ptr-var)
          (opt-loop-bce-ptr-lookup invalid.ptrs ptr-var)]
        [_ (OptLoopBcePtrKind.Unknown)])]
    (match ptr-kind
      [(OptLoopBcePtrKind.LengthSlot object)
        (let
          [known : OptLoopBceExpr
            (opt-loop-bce-length-lookup invalid.lengths object)]
          (match known
            [(OptLoopBceExpr.Unknown)
              (if (opt-gvn-stable-var? sources dst)
                (let
                  [loaded : OptLoopBceExpr
                    (OptLoopBceExpr.Value (ir.CompilerIrValue.Var dst))]
                  (opt-loop-bce-state-bind-length
                    (opt-loop-bce-state-bind-expr invalid sources dst loaded)
                    object
                    loaded))
                invalid)]
            [_ (opt-loop-bce-state-bind-expr invalid sources dst known)]))]
      [(OptLoopBcePtrKind.DataSlot object)
        (opt-loop-bce-state-bind-ptr
          (opt-loop-bce-state-bind-expr
            invalid
            sources
            dst
            (OptLoopBceExpr.Unknown))
          dst
          (OptLoopBcePtrKind.DataBuffer object))]
      [_
        (match src
          [(ir.CompilerIrValue.Global _)
            (if (opt-type-eq type-segment-bases ty (ast.AstType.I64))
              (opt-loop-bce-state-bind-expr
                invalid
                sources
                dst
                (OptLoopBceExpr.Value src))
              invalid)]
          [_ invalid])])))

(define (opt-loop-bce-update-storeptr
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : OptLoopBceState
  (let
    [kind : OptLoopBcePtrKind
      (match ptr
        [(ir.CompilerIrValue.Var ptr-var)
          (opt-loop-bce-ptr-lookup state.ptrs ptr-var)]
        [_ (OptLoopBcePtrKind.Unknown)])]
    (match kind
      [(OptLoopBcePtrKind.LengthSlot object)
        (opt-loop-bce-state-bind-length
          state
          object
          (opt-loop-bce-value-expr sources state.exprs value))]
      [(OptLoopBcePtrKind.DataSlot _) state]
      [(OptLoopBcePtrKind.DataBuffer _) state]
      [(OptLoopBcePtrKind.DataElement _) state]
      [(OptLoopBcePtrKind.Unknown) (opt-loop-bce-state-clear-lengths state)])))

(define (opt-loop-bce-update-call
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [dst : i64]
  [name : i64]
  [args : ir.CompilerIrCallArgs]) : OptLoopBceState
  (let
    [invalid : OptLoopBceState (opt-loop-bce-state-invalidate-def state dst)]
    [memory : OptLoopBceState
      (if (opt-loop-bce-summary-length-clean? summaries name)
        invalid
        (opt-loop-bce-state-clear-lengths invalid))]
    (if (and
      (= (ir.compiler-ir-call-args-count args) 0)
      (opt-loop-bce-summary-argc-return? summaries name))
      (opt-loop-bce-state-bind-expr memory sources dst (OptLoopBceExpr.Argc))
      memory)))

(define (opt-loop-bce-update-instr
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [instr : ir.CompilerIrInstr]) : OptLoopBceState
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (let
        [expr-state : OptLoopBceState
          (opt-loop-bce-state-bind-expr
            state
            sources
            dst
            (opt-loop-bce-value-expr sources state.exprs src))]
        (match src
          [(ir.CompilerIrValue.Var src-var)
            (opt-loop-bce-state-bind-alias
              expr-state
              dst
              (opt-loop-bce-alias-resolve state.aliases src-var))]
          [_ expr-state]))]
    [(ir.CompilerIrInstr.Alloc dst _)
      (opt-loop-bce-state-bind-alias
        (opt-loop-bce-state-invalidate-def state dst)
        dst
        dst)]
    [(ir.CompilerIrInstr.AddrOf dst _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (opt-loop-bce-update-gep
        type-segment-bases
        state
        sources
        dst
        base
        offset
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (opt-loop-bce-update-load type-segment-bases state sources dst src ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-loop-bce-state-bind-expr
        state
        sources
        dst
        (if (opt-loop-bce-same-width-int-cast? type-segment-bases from-ty to-ty)
          (opt-loop-bce-value-expr sources state.exprs src)
          (OptLoopBceExpr.Unknown)))]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (opt-divrem-compare-op? op)
        (let
          [operand-ty : ast.AstType
            (opt-range-compare-value-type types lhs rhs ty)]
          (opt-loop-bce-state-bind-cmp
            state
            sources
            dst
            op
            (opt-loop-bce-value-expr sources state.exprs lhs)
            (opt-loop-bce-value-expr sources state.exprs rhs)
            operand-ty))
        (opt-loop-bce-state-bind-expr
          state
          sources
          dst
          (OptLoopBceExpr.Bin
            op
            (box (opt-loop-bce-value-expr sources state.exprs lhs))
            (box (opt-loop-bce-value-expr sources state.exprs rhs))
            ty)))]
    [(ir.CompilerIrInstr.UnOp dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.LaneId dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-loop-bce-state-clear-lengths
          (opt-loop-bce-state-invalidate-def state dst)))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (opt-loop-bce-state-bind-expr state sources dst (OptLoopBceExpr.Argc))]
    [(ir.CompilerIrInstr.EntryArgv dst)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.EntryEnvp dst)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Xgetbv dst _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Syscall dst _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.Call dst name args _)
      (opt-loop-bce-update-call state summaries sources dst name args)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-loop-bce-state-clear-lengths
        (opt-loop-bce-state-invalidate-def state dst))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit)
            (opt-loop-bce-state-clear-lengths state)]
          [(ir.CompilerIrSpmdCallResult.Value dst _ _)
            (opt-loop-bce-state-clear-lengths
              (opt-loop-bce-state-invalidate-def state dst))]))]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (opt-loop-bce-update-storeptr state sources ptr value)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) state]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.Store _ _ _) state]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (opt-loop-bce-branch-state
        type-segment-bases
        state
        sources
        types
        blocks
        doms
        index
        loops
        block-label
        cond
        true-label
        false-label)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (opt-loop-bce-branch-state
        type-segment-bases
        state
        sources
        types
        blocks
        doms
        index
        loops
        block-label
        cond
        true-label
        false-label)]
    [(ir.CompilerIrInstr.Phi dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Pack dst _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.Word dst _ _ _)
      (opt-loop-bce-state-invalidate-def state dst)]
    [(ir.CompilerIrInstr.TailCall _ _ _)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
      (opt-loop-bce-state-clear-lengths state)]
    [(ir.CompilerIrInstr.Jump _) state]
    [(ir.CompilerIrInstr.Return _) state]
    [(ir.CompilerIrInstr.Switch _ _ _ _) state]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) state]))

(define (opt-loop-bce-length-expr-known?
  [type-segment-bases : i64]
  [lengths : OptLoopBceLengthEnv]
  [expr : OptLoopBceExpr]) : bool
  (match lengths
    [(OptLoopBceLengthEnv.Nil) false]
    [(OptLoopBceLengthEnv.Cons _ found rest)
      (if (opt-loop-bce-expr-eq type-segment-bases found expr)
        true
        (opt-loop-bce-length-expr-known?
          type-segment-bases
          (__tl-box-place rest)
          expr))]))

(define (opt-loop-bce-range-can-remove?
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [block-label : i64]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : bool
  (let
    [index-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources state.exprs index)]
    [length-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources state.exprs length)]
    [ranges : OptRangeFacts state.ranges]
    [length-known-nonnegative : bool
      (opt-loop-bce-length-expr-known?
        type-segment-bases
        state.lengths
        length-expr)]
    (or
      (and
        (opt-range-proves-nonnegative?
          type-segment-bases
          ranges
          block-label
          index-expr)
        (opt-range-proves-less-than?
          type-segment-bases
          ranges
          block-label
          index-expr
          length-expr))
      (opt-range-proves-additive-index-in-range?
        type-segment-bases
        ranges
        block-label
        index-expr
        length-expr
        length-known-nonnegative))))

(define (opt-loop-bce-can-remove?
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [sources : opt_i64_i64_map.Map]
  [block-label : i64]
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : bool
  (let
    [length-expr : OptLoopBceExpr
      (opt-loop-bce-value-expr sources state.exprs length)]
    (or
      (opt-loop-bce-range-can-remove?
        type-segment-bases
        state
        sources
        block-label
        index
        length)
      (and
        (opt-loop-bce-length-expr-known?
          type-segment-bases
          state.lengths
          length-expr)
        (let
          [guard : OptLoopBceGuardEnv
            (opt-loop-bce-guard-lookup state.guards block-label)]
          (match guard
            [(OptLoopBceGuardEnv.Nil) false]
            [(OptLoopBceGuardEnv.Dense _ _)
              (match (opt-loop-bce-guard-ref guard 0)
                [(OptLoopBceGuard.Guard _ guard-index guard-length)
                  (and
                    (opt-loop-bce-expr-eq
                      type-segment-bases
                      guard-index
                      (opt-loop-bce-value-expr sources state.exprs index))
                    (opt-loop-bce-expr-eq
                      type-segment-bases
                      guard-length
                      length-expr))])]))))))

(define (opt-loop-bce-rewrite-instr-seq-from
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [count : i64]) : OptLoopBceRewrite
  (if (>= pos count)
    (OptLoopBceRewrite.Rewrite state ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      [drop? : bool
        (match instr
          [(ir.CompilerIrInstr.BoundsCheck idx len _)
            (opt-loop-bce-can-remove?
              type-segment-bases
              state
              sources
              block-label
              idx
              len)]
          [_ false])]
      (if drop?
        (opt-loop-bce-rewrite-instr-seq-from
          type-segment-bases
          state
          summaries
          sources
          types
          blocks
          doms
          index
          loops
          block-label
          instrs
          (+ pos 1)
          count)
        (let
          [next-state : OptLoopBceState
            (opt-loop-bce-update-instr
              type-segment-bases
              state
              summaries
              sources
              types
              blocks
              doms
              index
              loops
              block-label
              instr)]
          (match (opt-loop-bce-rewrite-instr-seq-from
            type-segment-bases
            next-state
            summaries
            sources
            types
            blocks
            doms
            index
            loops
            block-label
            instrs
            (+ pos 1)
            count)
            [(OptLoopBceRewrite.Rewrite out-state out-rest)
              (OptLoopBceRewrite.Rewrite
                out-state
                (ir.compiler-ir-instr-cons instr out-rest))]))))))

(define (opt-loop-bce-rewrite-instr-seq
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block-label : i64]
  [instrs : ir.CompilerIrInstrSeq]) : OptLoopBceRewrite
  (opt-loop-bce-rewrite-instr-seq-from
    type-segment-bases
    state
    summaries
    sources
    types
    blocks
    doms
    index
    loops
    block-label
    instrs
    0
    (ir.compiler-ir-instr-seq-count instrs)))

(define (opt-loop-bce-rewrite-block
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [block : ir.CompilerIrBlock]) : OptLoopBceBlockRewrite
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (match (opt-loop-bce-rewrite-instr-seq
        type-segment-bases
        state
        summaries
        sources
        types
        blocks
        doms
        index
        loops
        label
        instrs)
        [(OptLoopBceRewrite.Rewrite out-state out-instrs)
          (OptLoopBceBlockRewrite.Rewrite
            out-state
            (ir.compiler-ir-block label out-instrs))])]))

(define (opt-loop-bce-length-store-shape-instrs
  [type-segment-bases : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [ptrs : OptI64List]) : bool
  (if (>= index count)
    false
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [removed : OptI64List
        (if (= dst (- 0 1))
          ptrs
          (opt-loop-bce-i64-list-remove ptrs dst))]
      [next-ptrs : OptI64List
        (match instr
          [(ir.CompilerIrInstr.Gep gep-dst _ offset ty)
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (opt-i64-list-add removed gep-dst)
              removed)]
          [_ removed])]
      (match instr
        [(ir.CompilerIrInstr.StorePtr ptr _ _)
          (match ptr
            [(ir.CompilerIrValue.Var ptr-var)
              (if (opt-i64-list-contains? ptrs ptr-var)
                true
                (opt-loop-bce-length-store-shape-instrs
                  type-segment-bases
                  slots
                  (+ index 1)
                  count
                  next-ptrs))]
            [_
              (opt-loop-bce-length-store-shape-instrs
                type-segment-bases
                slots
                (+ index 1)
                count
                next-ptrs)])]
        [_
          (opt-loop-bce-length-store-shape-instrs
            type-segment-bases
            slots
            (+ index 1)
            count
            next-ptrs)]))))

(define (opt-loop-bce-length-store-shape-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [ptrs : OptI64List]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-length-store-shape-instrs
            type-segment-bases
            instrs.slots
            0
            instrs.len
            ptrs)
            true
            (opt-loop-bce-length-store-shape-blocks
              type-segment-bases
              (__tl-box-place rest)
              ptrs))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-length-store-shape-blocks
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        ptrs)]))

(define (opt-loop-bce-length-load-shape-instrs
  [type-segment-bases : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [ptrs : OptI64List]) : bool
  (if (>= index count)
    false
    (let
      [instr : ir.CompilerIrInstr (array-ref slots index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      [removed : OptI64List
        (if (= dst (- 0 1))
          ptrs
          (opt-loop-bce-i64-list-remove ptrs dst))]
      [next-ptrs : OptI64List
        (match instr
          [(ir.CompilerIrInstr.Gep gep-dst _ offset ty)
            (if (opt-bounds-object-length-slot? type-segment-bases offset ty)
              (opt-i64-list-add removed gep-dst)
              removed)]
          [_ removed])]
      (match instr
        [(ir.CompilerIrInstr.Load _ ptr _)
          (match ptr
            [(ir.CompilerIrValue.Var ptr-var)
              (if (opt-i64-list-contains? ptrs ptr-var)
                true
                (opt-loop-bce-length-load-shape-instrs
                  type-segment-bases
                  slots
                  (+ index 1)
                  count
                  next-ptrs))]
            [_
              (opt-loop-bce-length-load-shape-instrs
                type-segment-bases
                slots
                (+ index 1)
                count
                next-ptrs)])]
        [_
          (opt-loop-bce-length-load-shape-instrs
            type-segment-bases
            slots
            (+ index 1)
            count
            next-ptrs)]))))

(define (opt-loop-bce-length-load-shape-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [ptrs : OptI64List]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-length-load-shape-instrs
            type-segment-bases
            instrs.slots
            0
            instrs.len
            ptrs)
            true
            (opt-loop-bce-length-load-shape-blocks
              type-segment-bases
              (__tl-box-place rest)
              ptrs))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-length-load-shape-blocks
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        ptrs)]))

(define (opt-loop-bce-string-byte-shape-instrs
  [type-segment-bases : i64]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(ir.CompilerIrInstr.Gep _ _ _ ty)
        (if (opt-type-eq type-segment-bases ty (ast.AstType.Char))
          true
          (opt-loop-bce-string-byte-shape-instrs
            type-segment-bases
            slots
            (+ index 1)
            count))]
      [_
        (opt-loop-bce-string-byte-shape-instrs
          type-segment-bases
          slots
          (+ index 1)
          count)])))

(define (opt-loop-bce-string-byte-shape-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-string-byte-shape-instrs
            type-segment-bases
            instrs.slots
            0
            instrs.len)
            true
            (opt-loop-bce-string-byte-shape-blocks
              type-segment-bases
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-string-byte-shape-blocks
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-argc-call-shape-instrs
  [summaries : OptLoopBceSummaries]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(ir.CompilerIrInstr.Call _ name args _)
        (if (and
          (= (ir.compiler-ir-call-args-count args) 0)
          (opt-loop-bce-summary-argc-return? summaries name))
          true
          (opt-loop-bce-argc-call-shape-instrs
            summaries
            slots
            (+ index 1)
            count))]
      [_
        (opt-loop-bce-argc-call-shape-instrs summaries slots (+ index 1) count)])))

(define (opt-loop-bce-argc-call-shape-blocks
  [summaries : OptLoopBceSummaries]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-argc-call-shape-instrs
            summaries
            instrs.slots
            0
            instrs.len)
            true
            (opt-loop-bce-argc-call-shape-blocks
              summaries
              (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-argc-call-shape-blocks
        summaries
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-compare-shape-instrs
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    false
    (match (array-ref slots index)
      [(ir.CompilerIrInstr.BinOp _ op _ _ ty)
        (if (match op
          [(ir.CompilerIrBinOp.Lt) true]
          [(ir.CompilerIrBinOp.Gt) true]
          [_ false])
          true
          (opt-loop-bce-compare-shape-instrs slots (+ index 1) count))]
      [_ (opt-loop-bce-compare-shape-instrs slots (+ index 1) count)])))

(define (opt-loop-bce-compare-shape-blocks [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-loop-bce-compare-shape-instrs instrs.slots 0 instrs.len)
            true
            (opt-loop-bce-compare-shape-blocks (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-compare-shape-blocks (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-bounds-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-bounds-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(ir.CompilerIrInstr.BoundsCheck _ _ _) 1]
          [_ 0])))))

(define (opt-count-bounds-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-bounds-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-bounds-blocks [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-bounds-instr-seq instrs)
            (opt-count-bounds-blocks (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-count-bounds-blocks (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-loop-bce-eligible-blocks?
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [blocks : ir.CompilerIrBlockList]) : bool
  (and
    (<= (ir.compiler-ir-block-list-count blocks) 64)
    (> (opt-count-bounds-blocks blocks) 0)
    (or
      (and
        (opt-loop-bce-argc-call-shape-blocks summaries blocks)
        (opt-loop-bce-length-store-shape-blocks
          type-segment-bases
          blocks
          (OptI64List.Nil)))
      (and
        (opt-loop-bce-length-load-shape-blocks
          type-segment-bases
          blocks
          (OptI64List.Nil))
        (opt-loop-bce-string-byte-shape-blocks type-segment-bases blocks))
      (and
        (<= (ir.compiler-ir-block-list-count blocks) 8)
        (opt-loop-bce-compare-shape-blocks blocks)))))

(define (opt-loop-bce-initial-state) : OptLoopBceState
  (OptLoopBceState
    (OptLoopBceExprEnv.Nil)
    (OptLoopBceAliasEnv.Nil)
    (OptLoopBcePtrEnv.Nil)
    (OptLoopBceLengthEnv.Nil)
    (OptLoopBceCmpEnv.Nil)
    (OptLoopBceGuardEnv.Nil)
    (OptRangeFacts.Nil)))

(define (opt-loop-bce-materialize-blocks
  [out : (__tl_dyn-array OptLoopBceBlockResult)]
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [material : ir.CompilerIrBlock
          (if (< block-id (array-length out))
            (match (array-ref out block-id)
              [(OptLoopBceBlockResult.SomeBlock rewritten) rewritten]
              [(OptLoopBceBlockResult.NoBlock) block])
            block)]
        (ir.compiler-ir-block-cons
          material
          (opt-loop-bce-materialize-blocks
            out
            (__tl-box-place rest)
            (+ block-id 1))))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-loop-bce-materialize-blocks
        out
        (ir.compiler-ir-block-seq-to-list seq)
        block-id)]))

(define (opt-loop-bce-rewrite-id
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [cfg-index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [children : OptCfgCsr]
  [out : (__tl_dyn-array OptLoopBceBlockResult)]
  [id : i64]
  [state : OptLoopBceState]) : unit
  (let
    [count : i64 (opt-cfg-index-block-count cfg-index)]
    (if (and (>= id 0) (< id count))
      (match (opt-cfg-index-block cfg-index id)
        [(OptMaybeBlock.No) unit]
        [(OptMaybeBlock.Some block)
          (match (opt-loop-bce-rewrite-block
            type-segment-bases
            state
            summaries
            sources
            types
            blocks
            doms
            cfg-index
            loops
            block)
            [(OptLoopBceBlockRewrite.Rewrite next-state rewritten)
              (begin
                (set!
                  (array-ref out id)
                  (OptLoopBceBlockResult.SomeBlock rewritten))
                (opt-loop-bce-rewrite-children
                  type-segment-bases
                  summaries
                  sources
                  types
                  blocks
                  doms
                  cfg-index
                  loops
                  children
                  out
                  id
                  next-state))])])
      unit)))

(define (opt-loop-bce-rewrite-children
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [sources : opt_i64_i64_map.Map]
  [types : OptSsaVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [doms : OptDomInfo]
  [cfg-index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [children : OptCfgCsr]
  [out : (__tl_dyn-array OptLoopBceBlockResult)]
  [parent-id : i64]
  [state : OptLoopBceState]) : unit
  (let
    [offsets : (__tl_dyn-array i64) children.offsets]
    [edges : (__tl_dyn-array i64) children.edges]
    [labels : (__tl_dyn-array i64) cfg-index.labels]
    [parent-label : i64 (array-ref labels parent-id)]
    [edge : i64 (array-ref offsets parent-id)]
    [end : i64 (array-ref offsets (+ parent-id 1))]
    (begin
      (while (< edge end)
        (let
          [child-id : i64 (array-ref edges edge)]
          [child-label : i64 (array-ref labels child-id)]
          [child-state : OptLoopBceState
            (opt-loop-bce-state-propagate-guard
              type-segment-bases
              state
              parent-label
              child-label)]
          (begin
            (opt-loop-bce-rewrite-id
              type-segment-bases
              summaries
              sources
              types
              blocks
              doms
              cfg-index
              loops
              children
              out
              child-id
              child-state)
            (set! edge (+ edge 1)))))
      unit)))

(define (opt-loop-bce-blocks
  [type-segment-bases : i64]
  [summaries : OptLoopBceSummaries]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (or
    (not summaries.enabled)
    (not (opt-loop-bce-eligible-blocks? type-segment-bases summaries blocks)))
    blocks
    (let
      [context : OptCfgContext (opt-cfg-context-build blocks)]
      [doms : OptDomInfo context.doms]
      [cfg-index : OptCfgIndex context.index]
      [count : i64 (opt-cfg-index-block-count cfg-index)]
      [children : OptCfgCsr (opt-gvn-dom-children doms)]
      [loops : OptNaturalLoopList
        (opt-cfg-natural-loops-with-context blocks context)]
      [out : (__tl_dyn-array OptLoopBceBlockResult)
        (array.make-array OptLoopBceBlockResult count)]
      [sources : opt_i64_i64_map.Map
        (opt-gvn-sources-blocks
          blocks
          (opt-gvn-sources-params params (opt_i64_i64_map.with-capacity 64)))]
      [ssa-facts : OptSsaFacts
        (opt-ssa-facts-from-function type-segment-bases params blocks)]
      [types : OptSsaVarTypes
        (match ssa-facts
          [(OptSsaFacts.Facts _ _ fact-types) fact-types])]
      (begin
        (match (opt-cfg-index-id cfg-index context.entry-label)
          [(option_i64.Some entry-id)
            (if (and (>= entry-id 0) (array-ref cfg-index.reachable entry-id))
              (opt-loop-bce-rewrite-id
                type-segment-bases
                summaries
                sources
                types
                blocks
                doms
                cfg-index
                loops
                children
                out
                entry-id
                (opt-loop-bce-initial-state))
              unit)]
          [(option_i64.None) unit])
        (opt-loop-bce-materialize-blocks out blocks 0)))))

(define (opt-loop-bce-state-propagate-guard
  [type-segment-bases : i64]
  [state : OptLoopBceState]
  [parent-label : i64]
  [child-label : i64]) : OptLoopBceState
  (let
    [range-state : OptLoopBceState
      (opt-loop-bce-state-bind-ranges
        state
        (opt-range-facts-propagate-label
          type-segment-bases
          state.ranges
          parent-label
          child-label))]
    [child-guard : OptLoopBceGuardEnv
      (opt-loop-bce-guard-lookup range-state.guards child-label)]
    (match child-guard
      [(OptLoopBceGuardEnv.Dense _ _) range-state]
      [(OptLoopBceGuardEnv.Nil)
        (let
          [parent-guard : OptLoopBceGuardEnv
            (opt-loop-bce-guard-lookup range-state.guards parent-label)]
          (match parent-guard
            [(OptLoopBceGuardEnv.Nil) range-state]
            [(OptLoopBceGuardEnv.Dense _ _)
              (match (opt-loop-bce-guard-ref parent-guard 0)
                [(OptLoopBceGuard.Guard _ index length)
                  (opt-loop-bce-state-bind-guard
                    range-state
                    child-label
                    index
                    length)])]))])))

;; --- affine chain folding (codegen phase 6) ----------------------------------
;;
;; Collapse chained affine 64-bit integer arithmetic. With wrapping semantics
;; (SPEC: i64/u64 `+`/`-`/`*` wrap modulo 2^64),
;;   (x*C1 + K1)*C2 + K2  ==  x*(C1*C2) + (K1*C2 + K2)
;; so the x16 unroller's chained `acc = acc*A + K` copies fold back into ONE
;; mul+add per group, and chained counter increments `((i+1)+1)+1` fold into
;; parallel `i+2`/`i+3` offsets off the group counter. The pass is one forward
;; walk per block over the freshly rebuilt post-fold instruction sequence,
;; mutating it in place:
;;  * every var defined by `Add/Sub (Var x) (I64 k)` or `Mul (Var x) (I64 c)`
;;    (either operand order for Add/Mul) at 64-bit integer type gets an affine
;;    record; records are bound fully resolved (add-of-add and mul-of-mul are
;;    rewritten at bind time), so lookups never chase chains.
;;  * add-of-add and mul-of-mul rewrite only the CURRENT instruction and keep
;;    its value bit-identical, so they need no use-count gate.
;;  * add-of-mul-of-add is the recurrence composition: for
;;    `v = Mul(x, C2); dst = Add(v, K2)` with `x = Add(u, K1)`, rewrite v IN
;;    PLACE (at its recorded index) to `Mul(u', C')` and dst to
;;    `Add(v, K1*C2 + K2)`, where (u', C') resolves u through a mul record.
;;    Rewriting v changes v's VALUE (from (u+K1)*C2 to u*C2), so this arm is
;;    gated on uses(v) == 1 -- the current Add is that single use, and the
;;    gate also guarantees no OTHER record was derived from v.
;;  * The use counts are collected once per function and then kept EXACT:
;;    every rewrite that retargets an operand from one var to another also
;;    moves that use in the count array, so a later single-use consult never
;;    sees a stale count.
;;  * Records are invalidated when their key or base var is redefined
;;    (pre-SSA multi-def safety); a record whose base would be its own key
;;    (`i = i + 1`) is never bound. The env resets past a small cap so
;;    pathological blocks stay linear.
;; Runs only in the opt2 fixpoint pipeline (after fold, before loop BCE); the
;; intermediates orphaned by the rewrites are dropped by the pipeline's DCE.
(defenum OptAffineRec
  (No)
  ;; var == base + k
  (AddC i64 i64)
  ;; var == base * c, defined at instruction index idx of the current block
  (MulC i64 i64 i64))

(defenum OptAffineEnv
  (Nil)
  (Cons i64 OptAffineRec (Box OptAffineEnv)))

(defenum OptAffineStep
  (Result OptAffineEnv i64))

(defenum OptAffineOperands
  (No)
  (Some i64 i64))

;; Raised from 64 so a fully-folded x16 unrolled body (~64 affine records)
;; composes into a single mul+add group instead of splitting mid-chain.
(define (opt-affine-env-cap) : i64
  512)

(define (opt-affine-64bit-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [_ false]))

;; Split a commutative (Var, I64) operand pair in either order.
(define (opt-affine-var-const
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptAffineOperands
  (match lhs
    [(ir.CompilerIrValue.Var v)
      (match rhs
        [(ir.CompilerIrValue.I64 k) (OptAffineOperands.Some v k)]
        [_ (OptAffineOperands.No)])]
    [(ir.CompilerIrValue.I64 k)
      (match rhs
        [(ir.CompilerIrValue.Var v) (OptAffineOperands.Some v k)]
        [_ (OptAffineOperands.No)])]
    [_ (OptAffineOperands.No)]))

(define (opt-affine-env-lookup [env : OptAffineEnv] [var : i64]) : OptAffineRec
  (match env
    [(OptAffineEnv.Nil) (OptAffineRec.No)]
    [(OptAffineEnv.Cons key rec rest)
      (if (= key var)
        rec
        (opt-affine-env-lookup (__tl-box-place rest) var))]))

(define (opt-affine-rec-mentions? [rec : OptAffineRec] [var : i64]) : bool
  (match rec
    [(OptAffineRec.No) true]
    [(OptAffineRec.AddC base _) (= base var)]
    [(OptAffineRec.MulC base _ _) (= base var)]))

;; Drop every record keyed by `var` or derived from it (its base): both
;; describe the var's PREVIOUS value once it is redefined.
(define (opt-affine-env-purge [env : OptAffineEnv] [var : i64]) : OptAffineEnv
  (match env
    [(OptAffineEnv.Nil) (OptAffineEnv.Nil)]
    [(OptAffineEnv.Cons key rec rest)
      (let
        [tail : OptAffineEnv (opt-affine-env-purge (__tl-box-place rest) var)]
        (if (or (= key var) (opt-affine-rec-mentions? rec var))
          tail
          (OptAffineEnv.Cons key rec (box tail))))]))

;; Bind after the dst's def: purge stale records first, skip self-referential
;; records, and reset the env past the cap so blocks stay linear.
(define (opt-affine-env-bind-def
  [env : OptAffineEnv]
  [binds : i64]
  [dst : i64]
  [rec : OptAffineRec]) : OptAffineStep
  (let
    [purged : OptAffineEnv (opt-affine-env-purge env dst)]
    (match rec
      [(OptAffineRec.No) (OptAffineStep.Result purged binds)]
      [_
        (if (opt-affine-rec-mentions? rec dst)
          (OptAffineStep.Result purged binds)
          (if (>= binds (opt-affine-env-cap))
            (OptAffineStep.Result (OptAffineEnv.Nil) 0)
            (OptAffineStep.Result
              (OptAffineEnv.Cons dst rec (box purged))
              (+ binds 1))))])))

(define (opt-affine-use-count [uses : (__tl_dyn-array i64)] [var : i64]) : i64
  (if (and (>= var 0) (< var (array-length uses)))
    (array-ref uses var)
    0))

;; Rewrites retarget one operand from `from` to `to`; keeping the counts exact
;; is what makes the single-use gate sound against earlier rewrites.
(define (opt-affine-use-retarget!
  [uses : (__tl_dyn-array i64)]
  [from : i64]
  [to : i64]) : unit
  (begin
    (if (and (>= from 0) (< from (array-length uses)))
      (set! (array-ref uses from) (- (array-ref uses from) 1))
      unit)
    (if (and (>= to 0) (< to (array-length uses)))
      (set! (array-ref uses to) (+ (array-ref uses to) 1))
      unit)))

;; The 64-bit element type of the (recorded, hence 64-bit BinOp) instruction
;; at `index`; I64 is only a defensive fallback.
(define (opt-affine-instr-ty [instrs : ir.CompilerIrInstrSeq] [index : i64]) : ast.AstType
  (match (ir.compiler-ir-instr-seq-ref instrs index)
    [(ir.CompilerIrInstr.BinOp _ _ _ _ ty) ty]
    [_ (ast.AstType.I64)]))

;; `dst = src + k` (Add, or Sub with k already negated; `emit-add?` keeps a
;; no-rewrite Sub in Sub form while its record is still additive).
(define (opt-affine-add-step
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]
  [dst : i64]
  [src : i64]
  [k : i64]
  [ty : ast.AstType]) : OptAffineStep
  (match (opt-affine-env-lookup env src)
    [(OptAffineRec.AddC base k1)
      ;; add-of-add: dst == base + (k1 + k), bit-identical.
      (begin
        (ir.compiler-ir-instr-seq-set!
          instrs
          index
          (ir.CompilerIrInstr.BinOp
            dst
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var base)
            (ir.CompilerIrValue.I64 (+ k1 k))
            ty))
        (opt-affine-use-retarget! uses src base)
        (opt-affine-env-bind-def
          env
          binds
          dst
          (OptAffineRec.AddC base (+ k1 k))))]
    [(OptAffineRec.MulC mbase c vidx)
      ;; add-of-mul-of-add: the recurrence composition (see the pass comment).
      (match (opt-affine-env-lookup env mbase)
        [(OptAffineRec.AddC u k1)
          (if (= (opt-affine-use-count uses src) 1)
            (let
              ;; Resolve u through a mul record so the rewritten mul's base
              ;; stays fully resolved (mul-of-mul composes here).
              [vty : ast.AstType (opt-affine-instr-ty instrs vidx)]
              [ubase : i64
                (match (opt-affine-env-lookup env u)
                  [(OptAffineRec.MulC t _ _) t]
                  [_ u])]
              [uc : i64
                (match (opt-affine-env-lookup env u)
                  [(OptAffineRec.MulC _ c0 _) (* c0 c)]
                  [_ c])]
              (begin
                (ir.compiler-ir-instr-seq-set!
                  instrs
                  vidx
                  (ir.CompilerIrInstr.BinOp
                    src
                    (ir.CompilerIrBinOp.Mul)
                    (ir.CompilerIrValue.Var ubase)
                    (ir.CompilerIrValue.I64 uc)
                    vty))
                (opt-affine-use-retarget! uses mbase ubase)
                (ir.compiler-ir-instr-seq-set!
                  instrs
                  index
                  (ir.CompilerIrInstr.BinOp
                    dst
                    (ir.CompilerIrBinOp.Add)
                    (ir.CompilerIrValue.Var src)
                    (ir.CompilerIrValue.I64 (+ (* k1 c) k))
                    ty))
                (match (opt-affine-env-bind-def
                  env
                  binds
                  src
                  (OptAffineRec.MulC ubase uc vidx))
                  [(OptAffineStep.Result env-v binds-v)
                    (opt-affine-env-bind-def
                      env-v
                      binds-v
                      dst
                      (OptAffineRec.AddC src (+ (* k1 c) k)))])))
            (opt-affine-env-bind-def env binds dst (OptAffineRec.AddC src k)))]
        [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.AddC src k))])]
    [(OptAffineRec.No)
      (opt-affine-env-bind-def env binds dst (OptAffineRec.AddC src k))]))

;; `dst = src * c`.
(define (opt-affine-mul-step
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]
  [dst : i64]
  [src : i64]
  [c : i64]
  [ty : ast.AstType]) : OptAffineStep
  (match (opt-affine-env-lookup env src)
    [(OptAffineRec.MulC base c1 _)
      ;; mul-of-mul: dst == base * (c1 * c), bit-identical.
      (begin
        (ir.compiler-ir-instr-seq-set!
          instrs
          index
          (ir.CompilerIrInstr.BinOp
            dst
            (ir.CompilerIrBinOp.Mul)
            (ir.CompilerIrValue.Var base)
            (ir.CompilerIrValue.I64 (* c1 c))
            ty))
        (opt-affine-use-retarget! uses src base)
        (opt-affine-env-bind-def
          env
          binds
          dst
          (OptAffineRec.MulC base (* c1 c) index)))]
    [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.MulC src c index))]))

(define (opt-affine-instr-step
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]) : OptAffineStep
  (let
    [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
    (match instr
      [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
        (if (opt-affine-64bit-type? ty)
          (match op
            [(ir.CompilerIrBinOp.Add)
              (match (opt-affine-var-const lhs rhs)
                [(OptAffineOperands.Some src k)
                  (opt-affine-add-step instrs uses index env binds dst src k ty)]
                [(OptAffineOperands.No)
                  (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
            [(ir.CompilerIrBinOp.Sub)
              ;; Only `Var - I64` is additive; the negation wraps like the op.
              (match lhs
                [(ir.CompilerIrValue.Var src)
                  (match rhs
                    [(ir.CompilerIrValue.I64 k)
                      (opt-affine-add-step
                        instrs
                        uses
                        index
                        env
                        binds
                        dst
                        src
                        (- 0 k)
                        ty)]
                    [_
                      (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
                [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
            [(ir.CompilerIrBinOp.Mul)
              (match (opt-affine-var-const lhs rhs)
                [(OptAffineOperands.Some src c)
                  (opt-affine-mul-step instrs uses index env binds dst src c ty)]
                [(OptAffineOperands.No)
                  (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])]
            [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])
          (opt-affine-env-bind-def env binds dst (OptAffineRec.No)))]
      [(ir.CompilerIrInstr.Mov dst src ty)
        ;; A register copy is a zero-offset affine link: tracking it (resolved
        ;; through the source's own additive record, exactly like an add binds)
        ;; keeps chains foldable even when the unroller's loop-carried
        ;; writeback Movs survive into the body. Record-only -- the Mov
        ;; instruction itself is never rewritten.
        (if (opt-affine-64bit-type? ty)
          (match src
            [(ir.CompilerIrValue.Var v)
              (match (opt-affine-env-lookup env v)
                [(OptAffineRec.AddC base k1)
                  (opt-affine-env-bind-def
                    env
                    binds
                    dst
                    (OptAffineRec.AddC base k1))]
                [_
                  (opt-affine-env-bind-def
                    env
                    binds
                    dst
                    (OptAffineRec.AddC v 0))])]
            [_ (opt-affine-env-bind-def env binds dst (OptAffineRec.No))])
          (opt-affine-env-bind-def env binds dst (OptAffineRec.No)))]
      [_
        (let
          [dst : i64 (opt-gvn-instr-dst instr)]
          (if (< dst 0)
            (OptAffineStep.Result env binds)
            (opt-affine-env-bind-def env binds dst (OptAffineRec.No))))])))

(define (opt-affine-fold-step!
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [index : i64]
  [env : OptAffineEnv]
  [binds : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (match (opt-affine-instr-step instrs uses index env binds)
      [(OptAffineStep.Result next-env next-binds)
        (opt-affine-fold-step! instrs uses (+ index 1) next-env next-binds)])))

;; Cheap prescan: the pass only pays for blocks with at least two foldable
;; affine candidates (the minimum for any chain).
(define (opt-affine-instr-candidate? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (if (opt-affine-64bit-type? ty)
        (match op
          [(ir.CompilerIrBinOp.Add)
            (match (opt-affine-var-const lhs rhs)
              [(OptAffineOperands.Some _ _) true]
              [(OptAffineOperands.No) false])]
          [(ir.CompilerIrBinOp.Sub)
            (match (opt-affine-var-const lhs rhs)
              [(OptAffineOperands.Some _ _) true]
              [(OptAffineOperands.No) false])]
          [(ir.CompilerIrBinOp.Mul)
            (match (opt-affine-var-const lhs rhs)
              [(OptAffineOperands.Some _ _) true]
              [(OptAffineOperands.No) false])]
          [_ false])
        false)]
    [_ false]))

(define (opt-affine-instr-seq-candidate?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]) : bool
  (opt-affine-instr-candidate? (array-ref slots index)))

(define (opt-affine-seq-candidate-from?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [seen : i64]) : bool
  (if (>= index count)
    false
    (if (opt-affine-instr-seq-candidate? slots index)
      (if (>= (+ seen 1) 2)
        true
        (opt-affine-seq-candidate-from? slots (+ index 1) count (+ seen 1)))
      (opt-affine-seq-candidate-from? slots (+ index 1) count seen))))

(define (opt-affine-block-candidate? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-affine-seq-candidate-from?
        instrs.slots
        0
        (ir.compiler-ir-instr-seq-count instrs)
        0)]))

(define (opt-affine-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-affine-block-candidate? block)
        true
        (opt-affine-blocks-have-candidate? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-affine-blocks-have-candidate? (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-affine-fold-blocks-walk!
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (if (opt-affine-seq-candidate-from?
              instrs.slots
              0
              (ir.compiler-ir-instr-seq-count instrs)
              0)
              (opt-affine-fold-step! instrs uses 0 (OptAffineEnv.Nil) 0)
              unit)])
        (opt-affine-fold-blocks-walk! uses (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-affine-fold-blocks-walk! uses (ir.compiler-ir-block-seq-to-list seq))]))

;; Entry: rewrites the (freshly fold-rebuilt, exclusively owned) blocks in
;; place and returns them; a function with no two-candidate block is untouched.
(define (opt-affine-fold-blocks [frame : i64] [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (opt-affine-blocks-have-candidate? blocks)
    (begin
      (opt-affine-fold-blocks-walk!
        (opt-collect-blocks-uses-array frame blocks)
        blocks)
      blocks)
    blocks))

(define (opt-fold-strength-cse-instr-seq-rewrite!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [index : i64 0]
    [store-count : i64 0]
    [fold-state : OptConstEnv (OptConstEnv.Nil)]
    [strength-state : OptConstEnv (OptConstEnv.Nil)]
    [cse-state : OptExprTable (OptExprTable.Nil)]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (match (opt-fold-instr
          type-segment-bases
          fold-state
          (ir.compiler-ir-instr-seq-ref instrs index))
          [(OptInstrResult.Result next-fold folded)
            (match (opt-strength-instr strength-state folded)
              [(OptInstrResult.Result next-strength strengthened)
                (match (opt-cse-instr type-segment-bases cse-state strengthened)
                  [(OptCseResult.Result next-cse rewritten)
                    (begin
                      (match rewritten
                        [(ir.CompilerIrInstr.StorePtr _ _ _)
                          (if (< store-count 128)
                            (set! store-count (+ store-count 1))
                            unit)]
                        [_ unit])
                      (ir.compiler-ir-instr-seq-set! instrs index rewritten)
                      (set! fold-state next-fold)
                      (set! strength-state next-strength)
                      (set! cse-state next-cse)
                      (set! index (+ index 1)))])])]))
      store-count)))

(define (opt-load-copy-instr-seq-rewrite!
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [state : OptLoadCseState]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [index : i64 0]
    [sources : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 1)]
    [call-memory : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 1)]
    [load-state : OptLoadCseState state]
    [copy-state : OptCopyEnv (OptCopyEnv.Nil)]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (match (opt-load-cse-dispatch
        type-segment-bases
        hs
        false
        sources
        call-memory
        load-state
        (ir.compiler-ir-instr-seq-ref instrs index))
        [(OptLoadCseResult.Result next-load loaded)
          (match (opt-copy-instr copy-state loaded)
            [(OptCopyResult.Result next-copy rewritten)
              (begin
                (ir.compiler-ir-instr-seq-set! instrs index rewritten)
                (set! load-state next-load)
                (set! copy-state next-copy)
                (set! index (+ index 1)))])]))))

;; --- fold pre-scan -------------------------------------------------------------
;;
;; Conservative "can any fold stage fire?" scan for one block. The fold pipeline
;; clones the block and runs four in-place stages (fold/strength/cse, dead
;; store, load-CSE + copy propagation, bounds-check elimination). When the scan
;; proves no stage can rewrite any instruction, the caller returns the input
;; block unchanged, skipping the clone and every stage walk. The scan is
;; EXACTLY conservative: it only reports "no fire" when firing is impossible,
;; so the fast path is behavior-identical to the full pipeline.
;;
;; Fire rules, derived from the stage sources:
;;   * fold/strength need a constant seed: a literal-valued Mov whose dst is
;;     read later (its env binding can only fire at a use site), an
;;     all-literal BinOp/UnOp (fold), a strength-identity op with an exact
;;     identity literal (x+0, x*1, bool identities), a literal-source or
;;     narrowing Cast, or a MaskBinOp with equal operands. With no seed the
;;     const env stays empty forever, so nothing resolves.
;;   * CSE needs two same-key BinOp/UnOp/CpuId/Xgetbv instructions; ignoring
;;     invalidation only over-reports (safe).
;;   * dead store runs only at >=2 StorePtr (its own gate).
;;   * load-CSE rewrites only Load, and the table starts empty, so it needs a
;;     Load plus at least one other producer (Load/StorePtr/CopyBytes).
;;   * copy propagation needs a binding (var-var/Unit Mov, Pack, or
;;     MaskBinOp with equal operands) whose dst is used by a later instruction;
;;     the backward used-later scan tracks every rewritable use (phi inputs
;;     and AddrOf sources are never rewritten, so they are not tracked).
;;   * bounds-check elimination drops a BoundsCheck only when an earlier
;;     BoundsCheck recorded the matching fact, so it needs >=2 BoundsChecks.
(define (opt-scan-literal? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.F64 _) true]
    [_ false]))

;; Exact strength-identity test: these operand/op shapes always rewrite
;; (x+0, x-0, x|0, x^0, x*0, x*1, and any Bool literal with And/Or). Anything
;; else (x+5, x*3, ...) never does, so it must not count as a seed. Matches
;; opt-strength-int-binop / opt-strength-bool-binop on literal operands; a var
;; operand can only resolve through the const env, which needs a seed first.
(define (opt-scan-i64-literal? [value : ir.CompilerIrValue] [n : i64]) : bool
  (match value
    [(ir.CompilerIrValue.I64 m) (= m n)]
    [_ false]))

(define (opt-scan-bool-literal? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Bool _) true]
    [_ false]))

(define (opt-scan-strength-identity?
  [op : ir.CompilerIrBinOp]
  [l : ir.CompilerIrValue]
  [r : ir.CompilerIrValue]) : bool
  (match op
    [(ir.CompilerIrBinOp.Add)
      (or (opt-scan-i64-literal? l 0) (opt-scan-i64-literal? r 0))]
    [(ir.CompilerIrBinOp.Sub) (opt-scan-i64-literal? r 0)]
    [(ir.CompilerIrBinOp.Mul)
      (if (opt-scan-i64-literal? l 0)
        true
        (if (opt-scan-i64-literal? l 1)
          true
          (or (opt-scan-i64-literal? r 0) (opt-scan-i64-literal? r 1))))]
    [(ir.CompilerIrBinOp.BitOr)
      (or (opt-scan-i64-literal? l 0) (opt-scan-i64-literal? r 0))]
    [(ir.CompilerIrBinOp.BitXor)
      (or (opt-scan-i64-literal? l 0) (opt-scan-i64-literal? r 0))]
    [(ir.CompilerIrBinOp.And)
      (or (opt-scan-bool-literal? l) (opt-scan-bool-literal? r))]
    [(ir.CompilerIrBinOp.Or)
      (or (opt-scan-bool-literal? l) (opt-scan-bool-literal? r))]
    [_ false]))

;; One-instruction constant-seed test for the fold/strength stages. A
;; literal-valued Mov only seeds when its dst is read later: the env binding it
;; creates can only fire at a use site, and the Mov's own normalized rewrite is
;; structurally identical. `used-later` holds uses strictly after this
;; instruction at the call site (a backward scan), which covers every position
;; fold/strength resolve (Mov/Cast/BinOp/UnOp operands; phi inputs and AddrOf
;; are never rewritten, so they are not tracked).
(define (opt-scan-fsc-seed?
  [used-later : (__tl_dyn-array i64)]
  [generation : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (and
        (opt-scan-literal? src)
        (opt-scan-stamped? used-later generation dst))]
    [(ir.CompilerIrInstr.BinOp _ op l r _)
      (if (and (opt-scan-literal? l) (opt-scan-literal? r))
        true
        (opt-scan-strength-identity? op l r))]
    [(ir.CompilerIrInstr.UnOp _ _ v _) (opt-scan-literal? v)]
    [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
      (or (opt-scan-literal? src) (opt-int-cast-as-mov? from-ty to-ty))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _) (opt-value-eq lhs rhs)]
    [_ false]))

;; Key equality between two CSE-able instructions, ignoring the result type
;; (over-reporting duplicates is safe: it only forgoes the skip).
(define (opt-scan-cse-key-eq [a : ir.CompilerIrInstr] [b : ir.CompilerIrInstr]) : bool
  (match a
    [(ir.CompilerIrInstr.BinOp _ aop al ar _)
      (match b
        [(ir.CompilerIrInstr.BinOp _ bop bl br _)
          (and (opt-binop-eq aop bop) (opt-value-eq al bl) (opt-value-eq ar br))]
        [_ false])]
    [(ir.CompilerIrInstr.UnOp _ aop av _)
      (match b
        [(ir.CompilerIrInstr.UnOp _ bop bv _)
          (and (opt-unop-eq aop bop) (opt-value-eq av bv))]
        [_ false])]
    [(ir.CompilerIrInstr.CpuId _ aleaf asub areg)
      (match b
        [(ir.CompilerIrInstr.CpuId _ bleaf bsub breg)
          (and
            (opt-value-eq aleaf bleaf)
            (opt-value-eq asub bsub)
            (= areg breg))]
        [_ false])]
    [(ir.CompilerIrInstr.Xgetbv _ aindex)
      (match b
        [(ir.CompilerIrInstr.Xgetbv _ bindex) (opt-value-eq aindex bindex)]
        [_ false])]
    [_ false]))

;; Nested-loop duplicate scan over the first `limit` instructions; block sizes
;; are capped by the caller, so this stays cheap.
(define (opt-scan-cse-dup-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [outer : i64]
  [limit : i64]) : bool
  (if (>= outer limit)
    false
    (let
      [instr : ir.CompilerIrInstr (array-ref slots outer)]
      [dup : bool
        (match instr
          [(ir.CompilerIrInstr.BinOp _ _ _ _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [(ir.CompilerIrInstr.UnOp _ _ _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [(ir.CompilerIrInstr.CpuId _ _ _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [(ir.CompilerIrInstr.Xgetbv _ _)
            (opt-scan-cse-dup-inner slots instr (+ outer 1) limit)]
          [_ false])]
      (if dup
        true
        (opt-scan-cse-dup-from slots (+ outer 1) limit)))))

(define (opt-scan-cse-dup-inner
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [instr : ir.CompilerIrInstr]
  [inner : i64]
  [limit : i64]) : bool
  (if (>= inner limit)
    false
    (if (opt-scan-cse-key-eq instr (array-ref slots inner))
      true
      (opt-scan-cse-dup-inner slots instr (+ inner 1) limit))))

;; Generation-stamped used-later set: `opt-scan-stamp` marks a var used at the
;; current block's generation, `opt-scan-stamped?` tests membership. Out-of-range
;; vars (negative pseudo-vars, or anything past the frame) are simply untracked;
;; they can never be a copy binding's dst, so skipping them stays conservative.
(define (opt-scan-stamp
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (set! (array-ref items var) generation))))

(define (opt-scan-stamped?
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length items))
      false
      (= (array-ref items var) generation))))

(define (opt-scan-note-value-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [value : ir.CompilerIrValue]) : unit
  (match value
    [(ir.CompilerIrValue.Var id) (opt-scan-stamp items generation id)]
    [_ unit]))

(define (opt-scan-note-value-list-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [values : ir.CompilerIrValueList]) : unit
  (match values
    [(ir.CompilerIrValueList.Nil) unit]
    [(ir.CompilerIrValueList.Array seq)
      (opt-scan-note-value-seq-uses items generation seq 0)]
    [(ir.CompilerIrValueList.Cons value rest)
      (begin
        (opt-scan-note-value-uses items generation value)
        (opt-scan-note-value-list-uses items generation (__tl-box-place rest)))]))

(define (opt-scan-note-value-seq-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [seq : ir.CompilerIrValueSeq]
  [index : i64]) : unit
  (if (>= index seq.len)
    unit
    (begin
      (opt-scan-note-value-uses items generation (array-ref seq.slots index))
      (opt-scan-note-value-seq-uses items generation seq (+ index 1)))))

(define (opt-scan-note-call-args-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [args : ir.CompilerIrCallArgs]) : unit
  (match args
    [(ir.CompilerIrCallArgs.Nil) unit]
    [(ir.CompilerIrCallArgs.One value)
      (opt-scan-note-value-uses items generation value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (begin
        (opt-scan-note-value-uses items generation a)
        (opt-scan-note-value-uses items generation b))]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-scan-note-value-array-uses items generation values 0)]))

(define (opt-scan-note-value-array-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (opt-scan-note-value-uses items generation (array-ref values index))
      (opt-scan-note-value-array-uses items generation values (+ index 1)))))

(define (opt-scan-note-spmd-call-args-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [args : ir.CompilerIrSpmdCallArgList]) : unit
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) unit]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (opt-scan-note-value-uses items generation value)
            (opt-scan-note-spmd-call-args-uses
              items
              generation
              (__tl-box-place rest)))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (opt-scan-note-spmd-call-arg-seq-uses items generation seq 0)]))

(define (opt-scan-note-spmd-call-arg-seq-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [seq : ir.CompilerIrSpmdCallArgSeq]
  [index : i64]) : unit
  (if (>= index seq.len)
    unit
    (match (array-ref seq.slots index)
      [(ir.CompilerIrSpmdCallArg.Arg _ value _)
        (begin
          (opt-scan-note-value-uses items generation value)
          (opt-scan-note-spmd-call-arg-seq-uses
            items
            generation
            seq
            (+ index 1)))])))

;; Mark every var the instruction mentions in a position fold/strength can
;; resolve or copy propagation can rewrite; phi inputs and AddrOf sources are
;; never rewritten, so those arms intentionally note nothing.
(define (opt-scan-note-instr-uses
  [items : (__tl_dyn-array i64)]
  [generation : i64]
  [instr : ir.CompilerIrInstr]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.BinOp _ _ l r _)
      (begin
        (opt-scan-note-value-uses items generation l)
        (opt-scan-note-value-uses items generation r))]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.Call _ _ args _)
      (opt-scan-note-call-args-uses items generation args)]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (begin
        (opt-scan-note-value-uses items generation func)
        (opt-scan-note-call-args-uses items generation args))]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (begin
        (opt-scan-note-value-uses items generation func)
        (opt-scan-note-call-args-uses items generation args))]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (opt-scan-note-value-uses items generation base)
          (opt-scan-note-call-args-uses items generation args)))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (opt-scan-note-value-uses items generation base)
          (opt-scan-note-value-uses items generation func)
          (opt-scan-note-call-args-uses items generation args)))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (opt-scan-note-value-uses items generation active-mask)
          (opt-scan-note-spmd-call-args-uses items generation args)))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (opt-scan-note-call-args-uses items generation args)]
    [(ir.CompilerIrInstr.Store _ value _)
      (opt-scan-note-value-uses items generation value)]
    ;; AddrOf carries a raw storage slot, not a value operand: neither
    ;; fold/strength resolution nor copy substitution ever rewrites it, so it
    ;; is not a rewritable use (same for phi inputs below).
    [(ir.CompilerIrInstr.AddrOf _ _) unit]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (begin
        (opt-scan-note-value-uses items generation base)
        (opt-scan-note-value-uses items generation offset))]
    [(ir.CompilerIrInstr.Load _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (begin
        (opt-scan-note-value-uses items generation ptr)
        (opt-scan-note-value-uses items generation value))]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (begin
        (opt-scan-note-value-uses items generation dst)
        (opt-scan-note-value-uses items generation src))]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (begin
        (opt-scan-note-value-uses items generation index)
        (opt-scan-note-value-uses items generation length))]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (opt-scan-note-value-uses items generation value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (opt-scan-note-value-uses items generation lhs)
          (opt-scan-note-value-uses items generation rhs)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (begin
          (opt-scan-note-value-uses items generation src)
          (opt-scan-note-value-uses items generation carry)))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (opt-scan-note-value-uses items generation lhs)
          (opt-scan-note-value-uses items generation rhs)))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (opt-scan-note-value-uses items generation lhs)
        (opt-scan-note-value-uses items generation rhs))]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (begin
          (opt-scan-note-value-uses items generation mask)
          (opt-scan-note-value-uses items generation on-true)
          (opt-scan-note-value-uses items generation on-false)))]
    [(ir.CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (opt-scan-note-value-uses items generation base)
        (opt-scan-note-value-uses items generation index))]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (begin
          (opt-scan-note-value-uses items generation base)
          (opt-scan-note-value-uses items generation index)
          (opt-scan-note-value-uses items generation value)))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (begin
          (opt-scan-note-value-uses items generation base)
          (opt-scan-note-value-uses items generation index)
          (opt-scan-note-value-uses items generation value)
          (opt-scan-note-value-uses items generation mask)))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (begin
          (opt-scan-note-value-uses items generation base)
          (opt-scan-note-value-uses items generation index)
          (opt-scan-note-value-uses items generation mask)))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (begin
          (opt-scan-note-value-uses items generation base)
          (opt-scan-note-value-uses items generation index-base)
          (opt-scan-note-value-uses items generation index)))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (begin
          (opt-scan-note-value-uses items generation source)
          (opt-scan-note-value-uses items generation selector-low)
          (match selector-high
            [(ir.CompilerIrMaybeValue.Some value)
              (opt-scan-note-value-uses items generation value)]
            [(ir.CompilerIrMaybeValue.No) unit])
          (opt-scan-note-value-uses items generation active-lanes)))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (begin
        (opt-scan-note-value-uses items generation index)
        (opt-scan-note-value-uses items generation length))]
    [(ir.CompilerIrInstr.EntryArgc _) unit]
    [(ir.CompilerIrInstr.EntryArgv _) unit]
    [(ir.CompilerIrInstr.EntryEnvp _) unit]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (opt-scan-note-value-uses items generation leaf)
        (opt-scan-note-value-uses items generation subleaf))]
    [(ir.CompilerIrInstr.Xgetbv _ index)
      (opt-scan-note-value-uses items generation index)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (opt-scan-note-call-args-uses items generation args)]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-scan-note-value-uses items generation cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-scan-note-value-uses items generation cond)]
    [(ir.CompilerIrInstr.Return maybe)
      (match maybe
        [(ir.CompilerIrMaybeValue.Some value)
          (opt-scan-note-value-uses items generation value)]
        [(ir.CompilerIrMaybeValue.No) unit])]
    [(ir.CompilerIrInstr.Phi _ _ _) unit]
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-scan-note-value-list-uses items generation words)]
    [(ir.CompilerIrInstr.Word _ src _ _)
      (opt-scan-note-value-uses items generation src)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (begin
        (opt-scan-note-value-uses items generation func)
        (opt-scan-note-call-args-uses items generation args))]
    [(ir.CompilerIrInstr.Switch index _ _ _)
      (opt-scan-note-value-uses items generation index)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (opt-scan-note-value-uses items generation index)]
    [_ unit]))

;; Blocks longer than this always take the full path (rare, and usually full
;; of real work); the cap also bounds the duplicate-key nested loop.
(define (opt-scan-block-limit) : i64
  128)

;; Bitmask result: 0 means every fold stage is provably a no-op for the block.
;;   1 = block too long to scan cheaply      2 = fold/strength seed present
;;   4 = duplicate CSE key                   8 = >=2 StorePtr (dead store gate)
;;  16 = load-CSE producer pair             32 = copy binding with a later use
;;  64 = >=2 BoundsCheck
(define (opt-block-fold-scan
  [used-later : (__tl_dyn-array i64)]
  [generation : i64]
  [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    (if (> count (opt-scan-block-limit))
      1
      (let
        [index : i64 (- count 1)]
        [stores : i64 0]
        [loads : i64 0]
        [producers : i64 0]
        [bchecks : i64 0]
        [mask : i64 0]
        (begin
          (while (>= index 0)
            (let
              [instr : ir.CompilerIrInstr (array-ref slots index)]
              (begin
                ;; Copy-propagation fires at the USE site, so test the binding
                ;; dst against uses strictly after it before noting this
                ;; instruction's own uses.
                (match instr
                  [(ir.CompilerIrInstr.Mov dst src _)
                    (match src
                      [(ir.CompilerIrValue.Var sv)
                        (if (and
                          (not (= sv dst))
                          (opt-scan-stamped? used-later generation dst))
                          (set! mask (bit-or mask 32))
                          unit)]
                      [(ir.CompilerIrValue.Unit)
                        (if (opt-scan-stamped? used-later generation dst)
                          (set! mask (bit-or mask 32))
                          unit)]
                      [_ unit])]
                  [(ir.CompilerIrInstr.Pack dst _ _)
                    (if (opt-scan-stamped? used-later generation dst)
                      (set! mask (bit-or mask 32))
                      unit)]
                  [_ unit])
                (match instr
                  [(ir.CompilerIrInstr.StorePtr _ _ _)
                    (begin
                      (set! stores (+ stores 1))
                      (set! producers (+ producers 1)))]
                  [(ir.CompilerIrInstr.Load _ _ _)
                    (begin
                      (set! loads (+ loads 1))
                      (set! producers (+ producers 1)))]
                  [(ir.CompilerIrInstr.CopyBytes _ _ _)
                    (set! producers (+ producers 1))]
                  [_ unit])
                (match instr
                  [(ir.CompilerIrInstr.BoundsCheck _ _ _)
                    (set! bchecks (+ bchecks 1))]
                  [_ unit])
                (if (opt-scan-fsc-seed? used-later generation instr)
                  (set! mask (bit-or mask 2))
                  unit)
                (opt-scan-note-instr-uses used-later generation instr)
                (set! index (- index 1)))))
          (if (>= stores 2)
            (set! mask (bit-or mask 8))
            unit)
          (if (and (>= loads 1) (>= producers 2))
            (set! mask (bit-or mask 16))
            unit)
          (if (>= bchecks 2)
            (set! mask (bit-or mask 64))
            unit)
          (if (opt-scan-cse-dup-from slots 0 count)
            (set! mask (bit-or mask 4))
            unit)
          mask)))))

;; Monotonic scan generation source: bumped once per scanned block, never
;; reset, so stale stamps left in a freshly bump-allocated (uninitialized)
;; scan array can never alias the live generation. Garbage bytes that happen
;; to equal the live generation would only over-report "maybe" (the safe
;; direction), never skip a firing block.
(define opt-fold-scan-tag : i64
  0)

;; True when the pre-scan proves no fold stage can fire for this block, so the
;; fold pipeline (clone + four stage walks) can be skipped and the input block
;; returned unchanged. A length-zero work array disables scanning (cold entry
;; points have no frame), forcing the full path.
(define (opt-block-scan-skippable?
  [scan-work : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : bool
  (if (= (array-length scan-work) 0)
    false
    (match block
      [(ir.CompilerIrBlock.Block _ instrs)
        (begin
          (set! opt-fold-scan-tag (+ opt-fold-scan-tag 1))
          (= (opt-block-fold-scan scan-work opt-fold-scan-tag instrs) 0))])))

(define (optimize-block-hs-full
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [dead-kinds : OptLoadPtrKinds]
  [load-kinds : OptLoadPtrKinds]
  [load-facts : OptAliasFacts]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [work : ir.CompilerIrInstrSeq
          (ir.compiler-ir-clone-instr-seq pools instrs)]
        [store-capacity : i64 0]
        ;; Fold scalar constants, reduce algebraic identities, eliminate repeated
        ;; pure expressions, propagate the resulting copies, then remove duplicate
        ;; proven bounds checks; function-level DCE drops dead copies. Independent
        ;; per-stage states preserve the old scheduling while the forward
        ;; one-in/one-out stages share two in-place traversals of the cloned block
        ;; sequence; bounds-check elimination then compacts that sequence in place.
        ;; Fold runs ONCE: it is a single forward pass that binds every folded
        ;; result into its env, so over the block it already reaches a fixpoint --
        ;; a second `opt-fold-instrs` over the result only re-walked and rebuilt
        ;; the list without changing it (byte-identical output, ~0.9% of
        ;; self-compile).
        (begin
          (set!
            store-capacity
            (opt-fold-strength-cse-instr-seq-rewrite! type-segment-bases work))
          (set!
            work
            (opt-dead-store-instr-seq-known-with-kinds
              profile-state
              type-segment-bases
              hs
              store-capacity
              dead-kinds
              work))
          (opt-load-copy-instr-seq-rewrite!
            type-segment-bases
            hs
            (opt-load-cse-empty-state-for-size-with-kinds
              profile-state
              (ir.compiler-ir-instr-seq-count work)
              load-kinds
              load-facts)
            work)
          (opt-bounds-instr-seq-rewrite! type-segment-bases (&mut work))
          (ir.CompilerIrBlock.Block label work)))]))

(define (optimize-block-hs-with-kinds
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [dead-kinds : OptLoadPtrKinds]
  [load-kinds : OptLoadPtrKinds]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (if (opt-block-scan-skippable? scan-work block)
    block
    (optimize-block-hs-full
      profile-state
      pools
      type-segment-bases
      hs
      dead-kinds
      load-kinds
      (optimize-block-entry-facts block entry-label seed-facts)
      block)))

(define (optimize-block-hs
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [scan-work : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (if (opt-block-scan-skippable? scan-work block)
    block
    (optimize-block-hs-full
      profile-state
      pools
      type-segment-bases
      hs
      (opt-load-kinds-empty)
      (opt-load-kinds-empty)
      (opt-alias-empty)
      block)))

(define (optimize-block
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (optimize-block-hs
    (profile_state.compiler-profile-state-metrics
      (profile_state.compiler-profile-state-new))
    pools
    type-segment-bases
    (opt-load-header-set-empty)
    (array.make-array i64 0)
    block))

(define (optimize-block-entry-facts
  [block : ir.CompilerIrBlock]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]) : OptAliasFacts
  (match block
    [(ir.CompilerIrBlock.Block label _)
      (if (= label entry-label)
        seed-facts
        (opt-alias-empty))]))

(define (optimize-block-seq-hs
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockSeq]) : ir.CompilerIrBlockList
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [slots : (__tl_dyn-array ir.CompilerIrBlock)
      (array.make-array ir.CompilerIrBlock count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [block : ir.CompilerIrBlock
            (ir.compiler-ir-block-seq-ref blocks index)]
          (begin
            (set!
              (array-ref slots index)
              (optimize-block-hs-with-kinds
                profile-state
                pools
                type-segment-bases
                hs
                (opt-load-kinds-empty)
                (opt-load-kinds-empty)
                entry-label
                seed-facts
                scan-work
                block))
            (set! index (+ index 1)))))
      (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count)))))

;; Both block containers share ONE dense workspace per pass, so the walker takes
;; the workspace and the generation its first block should use instead of
;; allocating either. Block `i` of a walk that starts at `base` consumes the
;; generation pair `(base + 2i, base + 2i + 1)`; `base` starts at 1 because a
;; freshly allocated stamp array reads as generation 0.
(define (opt-load-kinds-dense-block-generation [base : i64] [index : i64]) : i64
  (+ base (* index 2)))

(define (optimize-block-seq-hs-dense-from
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (__tl_dyn-array i64)]
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [blocks : ir.CompilerIrBlockSeq]) : ir.CompilerIrBlockList
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [slots : (__tl_dyn-array ir.CompilerIrBlock)
      (array.make-array ir.CompilerIrBlock count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [block-generation : i64
            (opt-load-kinds-dense-block-generation generation index)]
          [block : ir.CompilerIrBlock
            (ir.compiler-ir-block-seq-ref blocks index)]
          (begin
            (set!
              (array-ref slots index)
              (optimize-block-hs-with-kinds
                profile-state
                pools
                type-segment-bases
                hs
                (opt-load-kinds-dense-state
                  work
                  block-generation
                  opt-load-cse-kinds-cap-floor)
                (opt-load-kinds-dense-state
                  work
                  (+ block-generation 1)
                  opt-load-cse-kinds-cap-floor)
                entry-label
                seed-facts
                scan-work
                block))
            (set! index (+ index 1)))))
      (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count)))))

;; Cons-list arm of the same walk. It exists because the block-local pipeline is
;; still reached with a cons list far more often than with an `.Array` (in an
;; opt2 self-compile the `.Array` arm was never taken at all, so the dense
;; workspace this shares was dead code); the two arms otherwise run identical
;; per-block work.
(define (optimize-block-list-hs-dense
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (__tl_dyn-array i64)]
  [work : OptLoadKindsDenseWork]
  [generation : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (optimize-block-hs-with-kinds
          profile-state
          pools
          type-segment-bases
          hs
          (opt-load-kinds-dense-state
            work
            generation
            opt-load-cse-kinds-cap-floor)
          (opt-load-kinds-dense-state
            work
            (+ generation 1)
            opt-load-cse-kinds-cap-floor)
          entry-label
          seed-facts
          scan-work
          block)
        (optimize-block-list-hs-dense
          profile-state
          pools
          type-segment-bases
          hs
          entry-label
          seed-facts
          scan-work
          work
          (+ generation 2)
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (optimize-block-seq-hs-dense-from
        profile-state
        pools
        type-segment-bases
        hs
        entry-label
        seed-facts
        scan-work
        work
        generation
        seq)]))

(define (optimize-block-list-hs
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [hs : OptLoadHeaderSet]
  [entry-label : i64]
  [seed-facts : OptAliasFacts]
  [scan-work : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (optimize-block-hs-with-kinds
          profile-state
          pools
          type-segment-bases
          hs
          (opt-load-kinds-empty)
          (opt-load-kinds-empty)
          entry-label
          seed-facts
          scan-work
          block)
        (optimize-block-list-hs
          profile-state
          pools
          type-segment-bases
          hs
          entry-label
          seed-facts
          scan-work
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (optimize-block-seq-hs
        profile-state
        pools
        type-segment-bases
        hs
        entry-label
        seed-facts
        scan-work
        seq)]))

(define (optimize-block-list-has-work?
  [scan-work : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-block-scan-skippable? scan-work block)
        (optimize-block-list-has-work? scan-work (__tl-box-place rest))
        true)]
    ;; Read-only, early-exit: scan the sequence directly (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [found : bool false]
        [i : i64 0]
        (begin
          (while (and (not found) (< i count))
            (begin
              (if (opt-block-scan-skippable?
                scan-work
                (ir.compiler-ir-block-seq-ref seq i))
                unit
                (set! found true))
              (set! i (+ i 1))))
          found))]))

;; GAP4: the header-typed handle set feeds gep classification; build it from
;; the whole function so the block-local pass sees params and cross-block defs.
;; The scan work array is one uninitialized frame-sized scratch per call:
;; generation stamps reset it per block in O(1), and stale bytes can only ever
;; over-report "maybe" (safe), never skip a firing block.
(define (optimize-block-list-for-function-pass
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [frame : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  (let
    [scan-work : (__tl_dyn-array i64) (array.make-array i64 frame)]
    (if (not (optimize-block-list-has-work? scan-work blocks))
      (OptBlockListPassResult.Result blocks false)
      (let
        [hs : OptLoadHeaderSet
          (opt-load-header-set-from-function-with-size
            type-segment-bases
            params
            blocks
            frame)]
        [entry-label : i64 (opt-cfg-entry-label blocks)]
        [seed-facts : OptAliasFacts
          (opt-alias-seed-params type-segment-bases params)]
        ;; One frame-sized dense workspace per pass, for either block container.
        ;; The cons arm used to build two sparse `OptLoadPtrKinds` per block --
        ;; four 32-slot hash tables, 3 KiB of zero fill, allocated even for the
        ;; blocks `opt-block-scan-skippable?` then skipped.
        [work : OptLoadKindsDenseWork
          (opt-load-kinds-dense-work-with-size frame)]
        [next : ir.CompilerIrBlockList
          (match blocks
            [(ir.CompilerIrBlockList.Array seq)
              (optimize-block-seq-hs-dense-from
                profile-state
                pools
                type-segment-bases
                hs
                entry-label
                seed-facts
                scan-work
                work
                1
                seq)]
            [_
              (optimize-block-list-hs-dense
                profile-state
                pools
                type-segment-bases
                hs
                entry-label
                seed-facts
                scan-work
                work
                1
                blocks)])]
        [changed : bool
          (not (opt-block-list-eq type-segment-bases blocks next))]
        (OptBlockListPassResult.Result
          (if changed
            next
            blocks)
          changed)))))

(define (optimize-block-list-for-function
  [profile-state : profile_state.CompilerProfileMetrics]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [frame : i64]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (optimize-block-list-for-function-pass
    profile-state
    pools
    type-segment-bases
    frame
    params
    blocks)
    [(OptBlockListPassResult.Result next _) next]))

(define (optimize-block-list
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (optimize-block-list-hs
    (profile_state.compiler-profile-state-metrics
      (profile_state.compiler-profile-state-new))
    pools
    type-segment-bases
    (opt-load-header-set-empty)
    (ir.compiler-ir-label "entry")
    (opt-alias-empty)
    (array.make-array i64 0)
    blocks))

;; Whole-function transforms keep a pathological-CFG work cap. Loop transforms
;; do not use this value: every loop pass applies its own natural-loop-local
;; admission checks.
(define (opt-heavy-pass-block-limit) : i64
  1026)

;; The inliner uses a separate crossing guard. Raising it with the heavy-pass
;; limit regresses the measured self-compile path, so keep the old boundary
;; until the inliner has a cost model that pays for larger callers directly.
(define (opt-inline-heavy-gate-block-limit) : i64
  1024)

;; --- self-tail-recursion -> loop (tail-rec-loop) ---------------------------
;;
;; A call to the CURRENT function in tail position (its result flows straight
;; into a `return`) is lowered as an `CompilerIrInstr.TailCall` whose callee name equals
;; the function name. The backend emits a real `call` for it, which
;; grows the stack frame on every recursive step. This pass rewrites each such
;; self-tail-call into a back-edge to the function entry block, turning the
;; recursion into an in-place loop:
;;
;;   * evaluate every call argument into a fresh temp slot (so a parameter that
;;     is read by a *later* argument still sees its old value),
;;   * copy each temp into the matching parameter slot,
;;   * jump to the entry block.
;;
;; Reassigning a parameter slot via `CompilerIrInstr.Mov` is exactly what a
;; source-level `(set! param ...)` lowers to. Every successful conversion also
;; adds an explicit entry preheader: initial parameter definitions belong to
;; that predecessor, while the rewritten tail calls become ordinary backedges
;; to the old entry. The following SSA construction can therefore insert typed
;; loop phis instead of rejecting duplicate parameter definitions. Re-running
;; the old entry block per iteration remains precisely the tail-recursion
;; semantics (a real recursive call re-executes the entire body).
(define (opt-tailrec-param-count [params : ir.CompilerIrParamList]) : i64
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) 0]
    [(ir.CompilerIrParamList.Array seq)
      (opt-tailrec-param-count (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons _ rest)
      (+ 1 (opt-tailrec-param-count (__tl-box-place rest)))]))

(define (opt-tailrec-array-values-to-list
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : ir.CompilerIrValueList
  (if (>= index (array-length values))
    ir.CompilerIrValueList.Nil
    (ir.compiler-ir-value-cons
      (array-ref values index)
      (opt-tailrec-array-values-to-list values (+ index 1)))))

(define (opt-tailrec-args-to-list [args : ir.CompilerIrCallArgs]) : ir.CompilerIrValueList
  (match args
    [(ir.CompilerIrCallArgs.Nil) ir.CompilerIrValueList.Nil]
    [(ir.CompilerIrCallArgs.One a)
      (ir.compiler-ir-value-cons a ir.CompilerIrValueList.Nil)]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.compiler-ir-value-cons
        a
        (ir.compiler-ir-value-cons b ir.CompilerIrValueList.Nil))]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-tailrec-array-values-to-list values 0)]))

;; An unchanged tail argument needs no write back to its parameter slot. A
;; non-scalar identity is the structural trigger: when a caller containing an
;; already-SSA inner region is converted to a loop, non-scalars remain outside
;; scalar SSA and such a write would be a permanent duplicate definition. Once
;; that exact hybrid call-site shape is proven, the rewrite also omits its
;; unchanged scalar arguments. The predicate is paired by parameter and
;; argument at this call site; it is independent of enclosing function size and
;; layout.
(define (opt-tailrec-hybrid-identity-args?
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrValueList]) : bool
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) false]
    [(ir.CompilerIrParamList.Array seq)
      (opt-tailrec-hybrid-identity-args?
        (ir.compiler-ir-param-seq-to-list seq)
        args)]
    [(ir.CompilerIrParamList.Cons param prest)
      (match args
        [(ir.CompilerIrValueList.Nil) false]
        [(ir.CompilerIrValueList.Array seq)
          (opt-tailrec-hybrid-identity-args?
            params
            (ir.compiler-ir-value-seq-to-list seq))]
        [(ir.CompilerIrValueList.Cons arg arest)
          (match param
            [(ir.CompilerIrParam.Param _ ty var-id)
              (if (and
                (not (opt-ssa-scalar-type? ty))
                (match arg
                  [(ir.CompilerIrValue.Var source) (= source var-id)]
                  [_ false]))
                true
                (opt-tailrec-hybrid-identity-args?
                  (__tl-box-place prest)
                  (__tl-box-place arest)))])])]))

(define (opt-tailrec-instrs-have-hybrid-identity-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [fname : i64]
  [n : i64]
  [params : ir.CompilerIrParamList]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.TailCall name args _)
        (if (and
          (ir.compiler-ir-symbol-eq? name fname)
          (= (ir.compiler-ir-call-args-count args) n)
          (opt-tailrec-hybrid-identity-args?
            params
            (opt-tailrec-args-to-list args)))
          true
          (opt-tailrec-instrs-have-hybrid-identity-from?
            instrs
            (+ index 1)
            fname
            n
            params))]
      [_
        (opt-tailrec-instrs-have-hybrid-identity-from?
          instrs
          (+ index 1)
          fname
          n
          params)])))

(define (opt-tailrec-blocks-have-hybrid-identity?
  [blocks : ir.CompilerIrBlockList]
  [fname : i64]
  [n : i64]
  [params : ir.CompilerIrParamList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-tailrec-instrs-have-hybrid-identity-from?
            instrs
            0
            fname
            n
            params)
            true
            (opt-tailrec-blocks-have-hybrid-identity?
              (__tl-box-place rest)
              fname
              n
              params))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-tailrec-blocks-have-hybrid-identity?
        (ir.compiler-ir-block-seq-to-list seq)
        fname
        n
        params)]))

;; Copy each parameter's staged temp back into the parameter slot. Run after
;; all staging moves so the temps already hold the new argument values. The
;; tail-recursion rewrite used to prepend these moves to a linked instruction
;; tail; push them into the dense output in program order instead. refs #5726
(define (opt-tailrec-push-assign-movs!
  [params : ir.CompilerIrParamList]
  [base : i64]
  [index : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (opt-tailrec-push-assign-movs!
        (ir.compiler-ir-param-seq-to-list seq)
        base
        index
        (&mut builder))]
    [(ir.CompilerIrParamList.Cons param prest)
      (match param
        [(ir.CompilerIrParam.Param _ ty var-id)
          (begin
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Mov
                var-id
                (ir.CompilerIrValue.Var (+ base index))
                ty))
            (opt-tailrec-push-assign-movs!
              (__tl-box-place prest)
              base
              (+ index 1)
              (&mut builder)))])]))

(define (opt-tailrec-push-assign-movs-hybrid!
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrValueList]
  [base : i64]
  [index : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (opt-tailrec-push-assign-movs-hybrid!
        (ir.compiler-ir-param-seq-to-list seq)
        args
        base
        index
        (&mut builder))]
    [(ir.CompilerIrParamList.Cons param prest)
      (match args
        [(ir.CompilerIrValueList.Nil) unit]
        [(ir.CompilerIrValueList.Array seq)
          (opt-tailrec-push-assign-movs-hybrid!
            params
            (ir.compiler-ir-value-seq-to-list seq)
            base
            index
            (&mut builder))]
        [(ir.CompilerIrValueList.Cons arg arest)
          (match param
            [(ir.CompilerIrParam.Param _ ty var-id)
              (begin
                (if (match arg
                  [(ir.CompilerIrValue.Var source) (= source var-id)]
                  [_ false])
                  unit
                  (ir.compiler-ir-instr-builder-push!
                    (&mut builder)
                    (ir.CompilerIrInstr.Mov
                      var-id
                      (ir.CompilerIrValue.Var (+ base index))
                      ty)))
                (opt-tailrec-push-assign-movs-hybrid!
                  (__tl-box-place prest)
                  (__tl-box-place arest)
                  base
                  (+ index 1)
                  (&mut builder)))])])]))

;; Evaluate each argument into a fresh temp slot (`base + i`) before any
;; parameter slot is overwritten, so argument aliasing on the parameters is
;; preserved.
(define (opt-tailrec-push-stage-movs!
  [params : ir.CompilerIrParamList]
  [args : ir.CompilerIrValueList]
  [base : i64]
  [index : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (opt-tailrec-push-stage-movs!
        (ir.compiler-ir-param-seq-to-list seq)
        args
        base
        index
        (&mut builder))]
    [(ir.CompilerIrParamList.Cons param prest)
      (match args
        [(ir.CompilerIrValueList.Nil) unit]
        [(ir.CompilerIrValueList.Array seq)
          (opt-tailrec-push-stage-movs!
            params
            (ir.compiler-ir-value-seq-to-list seq)
            base
            index
            (&mut builder))]
        [(ir.CompilerIrValueList.Cons arg arest)
          (match param
            [(ir.CompilerIrParam.Param _ ty _)
              (begin
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Mov (+ base index) arg ty))
                (opt-tailrec-push-stage-movs!
                  (__tl-box-place prest)
                  (__tl-box-place arest)
                  base
                  (+ index 1)
                  (&mut builder)))])])]))

(define (opt-tailrec-self-call?
  [instr : ir.CompilerIrInstr]
  [fname : i64]
  [n : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.TailCall name args _)
      (and
        (ir.compiler-ir-symbol-eq? name fname)
        (= (ir.compiler-ir-call-args-count args) n))]
    [_ false]))

(define (opt-tailrec-rewrite-instr-seq-from!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [fname : i64]
  [params : ir.CompilerIrParamList]
  [n : i64]
  [base : i64]
  [hybrid? : bool]
  [entry-label : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (opt-tailrec-self-call? instr fname n)
        (match instr
          [(ir.CompilerIrInstr.TailCall _ args _)
            (let
              [arg-list : ir.CompilerIrValueList
                (opt-tailrec-args-to-list args)]
              (begin
                (opt-tailrec-push-stage-movs!
                  params
                  arg-list
                  base
                  0
                  (&mut builder))
                (if hybrid?
                  (opt-tailrec-push-assign-movs-hybrid!
                    params
                    arg-list
                    base
                    0
                    (&mut builder))
                  (opt-tailrec-push-assign-movs! params base 0 (&mut builder)))
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Jump entry-label))))]
          [_ unit])
        (begin
          (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
          (opt-tailrec-rewrite-instr-seq-from!
            (&mut builder)
            instrs
            (+ index 1)
            fname
            params
            n
            base
            hybrid?
            entry-label))))))

(define (opt-tailrec-rewrite-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [fname : i64]
  [params : ir.CompilerIrParamList]
  [n : i64]
  [base : i64]
  [hybrid? : bool]
  [entry-label : i64]) : ir.CompilerIrInstrSeq
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity
        (ir.compiler-ir-instr-seq-count instrs))]
    (begin
      (opt-tailrec-rewrite-instr-seq-from!
        (&mut builder)
        instrs
        0
        fname
        params
        n
        base
        hybrid?
        entry-label)
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-tailrec-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [fname : i64]
  [params : ir.CompilerIrParamList]
  [n : i64]
  [base : i64]
  [hybrid? : bool]
  [entry-label : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-tailrec-rewrite-instr-seq
                instrs
                fname
                params
                n
                base
                hybrid?
                entry-label))
            (opt-tailrec-rewrite-blocks
              (__tl-box-place rest)
              fname
              params
              n
              base
              hybrid?
              entry-label))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-tailrec-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        fname
        params
        n
        base
        hybrid?
        entry-label)]))

(define (opt-tailrec-instr-seq-has-convertible-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [fname : i64]
  [n : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (match (& (array-ref instrs.slots index))
      [(ir.CompilerIrInstr.TailCall _ _ _)
        (opt-tailrec-self-call?
          (ir.compiler-ir-instr-seq-ref instrs index)
          fname
          n)]
      [_ false])
      true
      (opt-tailrec-instr-seq-has-convertible-from? instrs (+ index 1) fname n))))

(define (opt-tailrec-instr-seq-has-convertible?
  [instrs : ir.CompilerIrInstrSeq]
  [fname : i64]
  [n : i64]) : bool
  (opt-tailrec-instr-seq-has-convertible-from? instrs 0 fname n))

(define (opt-tailrec-blocks-have-convertible?
  [blocks : ir.CompilerIrBlockList]
  [fname : i64]
  [n : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-tailrec-instr-seq-has-convertible? instrs fname n)
            true
            (opt-tailrec-blocks-have-convertible? (__tl-box-place rest) fname n))])]
    ;; Read-only, early-exit: scan the sequence directly (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [found : bool false]
        [i : i64 0]
        (begin
          (while (and (not found) (< i count))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (if (opt-tailrec-instr-seq-has-convertible? instrs fname n)
                    (set! found true)
                    unit)])
              (set! i (+ i 1))))
          found))]))

(define (opt-tailrec-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret vars blocks)
      (let
        [n : i64 (opt-tailrec-param-count params)]
        (if (and
          (opt-tailrec-blocks-have-convertible? blocks name n)
          (opt-ssa-explicit-entry-available? blocks))
          (let
            [hybrid? : bool
              (and
                (opt-ssa-blocks-have-phi? blocks)
                (opt-tailrec-blocks-have-hybrid-identity? blocks name n params))]
            [rewritten : ir.CompilerIrBlockList
              (opt-tailrec-rewrite-blocks
                blocks
                name
                params
                n
                vars
                hybrid?
                (opt-cfg-entry-label blocks))]
            (ir.CompilerIrFunction.Function
              name
              params
              ret
              (+ vars n)
              (opt-ssa-explicit-entry-blocks rewritten)))
          func))]))

;; --- canonical counted-loop unrolling (x16 straight-line / x2 diamond) -------
;;
;; Recognizes a single-block do-while loop B of the canonical rotated shape
;;
;;   B: phis...; body...; inext = iphi + 1; c = inext < bound; Branch c B EXIT
;;
;; with exactly the two CFG predecessors {P, B} (trusted from the verified phi
;; input labels) and a loop-invariant `bound`, then versions the loop: P is
;; retargeted to a fresh guard block G that either enters a fresh unrolled body
;; U (sixteen clones of B's straight-line body chained through the loop-carried
;; phis) or falls back to B, which stays in place as the remainder loop so
;; EXIT's phis keep their single B input. The guard computes
;;
;;   ngroup = bound - 16;  gok = (ngroup <= bound) and (seed < ngroup)
;;
;; and U keeps looping while its post-group counter stays below ngroup. The
;; guard uses bound - 16 (not bound - 15): B is a do-while, so handing control
;; back with the counter equal to `bound` would run one extra iteration;
;; `iu < bound - 16` guarantees the sixteen unrolled iterations AND at least
;; one remainder iteration stay below `bound`. The `ngroup <= bound` check
;; rejects a wrapped bound - 16, sending degenerate bounds straight to the
;; original loop. All counter arithmetic stays in the counter's own integer
;; type. The x16 group depth lets the affine pass fold long constant-step
;; chains (LCG-style `acc = acc*A + K`) into one composed mul+add per group,
;; which is what closes the arith_loop/array_sum instruction gap to clang.
;; A loop-carried phi other than the counter: dst, init value (from the outside
;; pred), back-edge value (from B), phi type.
(defenum OptUnrollPhi
  (Phi i64 ir.CompilerIrValue ir.CompilerIrValue ast.AstType))

(defenum OptUnrollPhiList
  (Nil)
  (Cons OptUnrollPhi (Box OptUnrollPhiList)))

;; init value (from the outside pred), back-edge value, outside pred label.
(defenum OptUnrollPhiSplit
  (No)
  (Split ir.CompilerIrValue ir.CompilerIrValue i64))

(defenum OptUnrollMaybePhis
  (No)
  (Some OptUnrollPhiList))

(defstruct OptUnrollShape
  (loop-label i64)
  (pred-label i64)
  (phi-count i64)
  (cond-index i64)
  (cond-var i64)
  (iphi i64)
  (iphi-ty ast.AstType)
  (seed ir.CompilerIrValue)
  (inext i64)
  (ity ast.AstType)
  (bound ir.CompilerIrValue)
  (others OptUnrollPhiList))

(defenum OptUnrollMaybeShape
  (No)
  (Some OptUnrollShape))

;; SIMD values deliberately stay in mutable (non-SSA) form, so the SPMD
;; lowerer's rotated gang loop has no Phi prefix:
;;
;;   B: vector body...; i = inext; inext = i + lanes;
;;      c = inext <= bound; Branch c B EXIT
;;
;; The dedicated shape below versions that exact form, including canonical
;; ordinary vector stores. Transient results are freshened while a destination
;; that reads itself remains mutable, so each copy consumes the preceding
;; copy's recurrence state. The original B remains the remainder loop.
(defstruct OptUnrollSimdMemory
  (base ir.CompilerIrValue)
  (ty ast.AstType))

(import (vector.vector OptUnrollSimdMemory core) as opt_unroll_simd_memory_vec)

(defstruct OptUnrollSimdMemoryList
  (items opt_unroll_simd_memory_vec.Vec))

(defstruct OptUnrollSimdShape
  (pred-label i64)
  (tail-label i64)
  (cond-index i64)
  (index-var i64)
  (next-var i64)
  (step i64)
  (ity ast.AstType)
  (bound ir.CompilerIrValue)
  (cmp-op ir.CompilerIrBinOp)
  (memory-bases OptUnrollSimdMemoryList)
  (memory-count i64))

(defenum OptUnrollSimdMaybeShape
  (No)
  (Some OptUnrollSimdShape))

(defenum OptUnrollSimdMemoryShape
  (Fail)
  ;; Unique base/type pairs, pair count, load count, store count.
  (Some OptUnrollSimdMemoryList i64 i64 i64))

(defenum OptUnrollResult
  (Result ir.CompilerIrBlockList i64 bool))

(define (opt-unroll-phi-prefix-count
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    index
    (if (ir.compiler-ir-instr-seq-phi? instrs index)
      (opt-unroll-phi-prefix-count instrs (+ index 1))
      index)))

(define (opt-unroll-no-phi-from? [instrs : ir.CompilerIrInstrSeq] [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (if (ir.compiler-ir-instr-seq-phi? instrs index)
      false
      (opt-unroll-no-phi-from? instrs (+ index 1)))))

;; Clonable straight-line body instruction kinds. Anything else (calls, allocs,
;; vector stores, name stores, nested terminators) rejects the loop.
(define (opt-unroll-body-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    ;; Store-free SIMD gang bodies have the same long-trip compute/load shape
    ;; as scalar reductions and scans. Keep vector stores and predicated memory
    ;; operations excluded alongside scalar StorePtr.
    [(ir.CompilerIrInstr.LaneId _ _ _) true]
    [(ir.CompilerIrInstr.Splat _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorBinOp _) true]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorCompare _) true]
    [(ir.CompilerIrInstr.MaskBinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.Select _) true]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    ;; StorePtr deliberately EXCLUDED: store-bearing counted loops are
    ;; dominated by fills and short-trip container writes (hashmap grow/insert
    ;; regressed 1-2%, self-compile +1.4% when they unrolled -- the entry
    ;; guard plus 4x body is a net loss below ~8 iterations, and trip counts
    ;; are unknowable statically). Pure compute/load loops (arithmetic
    ;; recurrences, sums, reductions, scans) are the long-trip shapes where
    ;; x4 pays: arith_loop -30%, array_sum -33%, spmd_reduce -36%.
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [_ false]))

(define (opt-unroll-body-instr-seq-ok?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]) : bool
  (opt-unroll-body-instr-ok? (array-ref slots index)))

(define (opt-unroll-body-ok?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-body-instr-seq-ok? slots index)
      (opt-unroll-body-ok? slots (+ index 1) last))))

(define (opt-unroll-block-defs
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index count)
    acc
    (let
      [dst : i64 (ir.compiler-ir-instr-array-loop-dst-or slots index (- 0 1))]
      (opt-unroll-block-defs
        slots
        (+ index 1)
        count
        (if (< dst 0)
          acc
          (opt-used-add acc dst))))))

(define (opt-unroll-def-index
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [last : i64]
  [var : i64]) : i64
  (if (>= index last)
    (- 0 1)
    (if (= (ir.compiler-ir-instr-array-loop-dst-or slots index (- 0 1)) var)
      index
      (opt-unroll-def-index slots (+ index 1) last var))))

(define (opt-unroll-uses-before
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index last)
    acc
    (opt-unroll-uses-before
      instrs
      (+ index 1)
      last
      (opt-collect-instr-uses acc (ir.compiler-ir-instr-seq-ref instrs index)))))

;; Resolve a var through same-block Mov copies (the loop-carried writeback
;; often survives as `mov vK = vNext` feeding the phi). SSA single-defs keep
;; the chain acyclic; the fuel bounds it defensively anyway.
(define (opt-unroll-resolve-copy
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (let
      [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
      [def-index : i64 (opt-unroll-def-index slots phi-count last var)]
      (if (< def-index 0)
        var
        (match (array-ref slots def-index)
          [(ir.CompilerIrInstr.Mov _ src _)
            (match src
              [(ir.CompilerIrValue.Var src-id)
                (opt-unroll-resolve-copy
                  instrs
                  phi-count
                  last
                  src-id
                  (- fuel 1))]
              [_ var])]
          [_ var])))))

(define (opt-unroll-split-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [loop-label : i64]) : OptUnrollPhiSplit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Cons first-value first-label rest-box)
      (match (__tl-box-place rest-box)
        [(ir.CompilerIrPhiInputList.Cons second-value second-label tail-box)
          (match (__tl-box-place tail-box)
            [(ir.CompilerIrPhiInputList.Nil)
              (if (= first-label loop-label)
                (if (= second-label loop-label)
                  (OptUnrollPhiSplit.No)
                  (OptUnrollPhiSplit.Split
                    second-value
                    first-value
                    second-label))
                (if (= second-label loop-label)
                  (OptUnrollPhiSplit.Split first-value second-value first-label)
                  (OptUnrollPhiSplit.No)))]
            [_ (OptUnrollPhiSplit.No)])]
        [_ (OptUnrollPhiSplit.No)])]
    [_ (OptUnrollPhiSplit.No)]))

(define (opt-unroll-collect-other-phis
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]) : OptUnrollMaybePhis
  (if (>= index phi-count)
    (OptUnrollMaybePhis.Some (OptUnrollPhiList.Nil))
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst inputs ty)
        (if (= dst iphi)
          (opt-unroll-collect-other-phis
            instrs
            (+ index 1)
            phi-count
            loop-label
            pred-label
            iphi)
          (match (opt-unroll-split-phi-inputs inputs loop-label)
            [(OptUnrollPhiSplit.Split init back split-pred)
              (if (= split-pred pred-label)
                (match (opt-unroll-collect-other-phis
                  instrs
                  (+ index 1)
                  phi-count
                  loop-label
                  pred-label
                  iphi)
                  [(OptUnrollMaybePhis.Some rest)
                    (OptUnrollMaybePhis.Some
                      (OptUnrollPhiList.Cons
                        (OptUnrollPhi.Phi dst init back ty)
                        (box rest)))]
                  [(OptUnrollMaybePhis.No) (OptUnrollMaybePhis.No)])
                (OptUnrollMaybePhis.No))]
            [(OptUnrollPhiSplit.No) (OptUnrollMaybePhis.No)]))]
      [_ (OptUnrollMaybePhis.No)])))

(define (opt-unroll-invariant-bound?
  [defs : opt_i64_i64_map.Map]
  [bound : ir.CompilerIrValue]) : bool
  (match bound
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Var id) (not (opt-used-contains defs id))]
    [_ false]))

;; P's terminator must be a Jump/Branch (or a fallthrough into B, which the
;; guard insertion right before B preserves); retargeting a Switch is not
;; supported.
(define (opt-unroll-pred-retargetable?
  [blocks : ir.CompilerIrBlockList]
  [pred-label : i64]) : bool
  (match (opt-cfg-find-block blocks pred-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              true
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Switch _ _ _ _) false]
                [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) false]
                [_ true])))])]))

;; The counter phi's back-edge input must carry the incremented counter,
;; possibly through same-block Mov copies.
(define (opt-unroll-back-resolves-to?
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [back : ir.CompilerIrValue]
  [inext : i64]) : bool
  (match back
    [(ir.CompilerIrValue.Var id)
      (= (opt-unroll-resolve-copy instrs phi-count last id 16) inext)]
    [_ false]))

(define (opt-unroll-shape-finish
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [cond-index : i64]
  [cond-var : i64]
  [iphi : i64]
  [iphi-ty : ast.AstType]
  [seed : ir.CompilerIrValue]
  [inext : i64]
  [ity : ast.AstType]
  [bound : ir.CompilerIrValue]
  [pred-label : i64]) : OptUnrollMaybeShape
  (if (or
    (opt-cfg-block-exists?
      blocks
      (ir.compiler-ir-label
        (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_guard")))
    (opt-cfg-block-exists?
      blocks
      (ir.compiler-ir-label
        (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_body")))
    (not (opt-unroll-pred-retargetable? blocks pred-label)))
    (OptUnrollMaybeShape.No)
    (match (opt-unroll-collect-other-phis
      instrs
      0
      phi-count
      label
      pred-label
      iphi)
      [(OptUnrollMaybePhis.Some others)
        (OptUnrollMaybeShape.Some
          (OptUnrollShape
            label
            pred-label
            phi-count
            cond-index
            cond-var
            iphi
            iphi-ty
            seed
            inext
            ity
            bound
            others))]
      [(OptUnrollMaybePhis.No) (OptUnrollMaybeShape.No)])))

(define (opt-unroll-shape-phi
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-index : i64]
  [cond-var : i64]
  [inext : i64]
  [ity : ast.AstType]
  [bound : ir.CompilerIrValue]
  [iphi : i64]) : OptUnrollMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [iphi-index : i64 (opt-unroll-def-index slots 0 phi-count iphi)]
    (if (< iphi-index 0)
      (OptUnrollMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs iphi-index)
        [(ir.CompilerIrInstr.Phi _ inputs iphi-ty)
          (match (opt-unroll-split-phi-inputs inputs label)
            [(OptUnrollPhiSplit.Split seed back pred-label)
              (if (and
                (not (= pred-label label))
                (opt-unroll-back-resolves-to? instrs phi-count last back inext))
                (opt-unroll-shape-finish
                  blocks
                  label
                  instrs
                  phi-count
                  cond-index
                  cond-var
                  iphi
                  iphi-ty
                  seed
                  inext
                  ity
                  bound
                  pred-label)
                (OptUnrollMaybeShape.No))]
            [(OptUnrollPhiSplit.No) (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-unroll-shape-step
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [cond-index : i64]
  [inext : i64]
  [bound : ir.CompilerIrValue]) : OptUnrollMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
    (if (< inext-index 0)
      (OptUnrollMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs inext-index)
        [(ir.CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-op
            [(ir.CompilerIrBinOp.Add)
              (match add-lhs
                [(ir.CompilerIrValue.Var add-src)
                  (match add-rhs
                    [(ir.CompilerIrValue.I64 step)
                      (if (and (= step 1) (opt-integer-type? ity))
                        (opt-unroll-shape-phi
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-index
                          cond-var
                          inext
                          ity
                          bound
                          (opt-unroll-resolve-copy
                            instrs
                            phi-count
                            last
                            add-src
                            16))
                        (OptUnrollMaybeShape.No))]
                    [_ (OptUnrollMaybeShape.No)])]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-unroll-shape-counter
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]) : OptUnrollMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [cond-index : i64 (opt-unroll-def-index slots phi-count last cond-var)]
    (if (< cond-index 0)
      (OptUnrollMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs cond-index)
        [(ir.CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(ir.CompilerIrBinOp.Lt)
              (match cmp-lhs
                [(ir.CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound?
                    (opt-unroll-block-defs
                      slots
                      0
                      (+ last 1)
                      (opt_i64_i64_map.with-capacity 32))
                    cmp-rhs)
                    (opt-unroll-shape-step
                      blocks
                      label
                      instrs
                      phi-count
                      last
                      cond-var
                      cond-index
                      (opt-unroll-resolve-copy instrs phi-count last cmp-src 16)
                      cmp-rhs)
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

;; Fill-like store loops: StorePtr admitted only when the body has no Load
;; at all, so the x4 clones hold scalar state only (no load->store chains,
;; no container-pointer pressure). Probe/rehash loops have loads and stay
;; excluded by the main whitelist; fills (zeroing, byte stores, recurrence
;; stores) have none.
(define (opt-unroll-body-fill-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Load _ _ _) false]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [_ (opt-unroll-body-instr-ok? instr)]))

(define (opt-unroll-body-fill-ok?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-body-fill-instr-ok? (array-ref slots index))
      (opt-unroll-body-fill-ok? slots (+ index 1) last))))

;; The third body class: a SCALAR counted loop that BOTH loads and stores.
;; Neither whitelist above admits one -- opt-unroll-body-instr-ok? excludes
;; StorePtr and the fill exception excludes Load -- so the merge/copy/update
;; shape `dst[i] = f(dst[i], src[i])` has never been unrolled at any factor.
;;
;; BoundsCheck is REFUSED here even though the store-free whitelist admits it,
;; and that refusal is what confines this class to a versioner fast clone
;; without naming one. A copy duplicates every check in the body, so a checked
;; merge loop would pay twice the check code to save 1.5 of its 3 overhead
;; instructions -- but the measured damage was worse than that trade, because
;; unrolling a still-checked body PRE-EMPTS the versioner. On spmd_map's
;; `foreach_body.13` the checked merge loop unrolled on the pipeline iteration
;; before versioning, so the hot path became a CHECKED unrolled body with a
;; second versioned-and-unrolled nest hanging off its remainder: spmd_map
;; +14.3% and spmd_short_tail +14.4%. Requiring a check-free body is the
;; IR-level spelling of "the fast clone only" -- `__bce_fast` is exactly the
;; check-free form, and it is where the saving is.
;;
;; A body holding ANY vector instruction is likewise not this class. The
;; store-free SIMD admission above and the gang unroller below
;; (opt-unroll-simd-*) own that family: the gang loop's counter steps by the
;; lane count, its memory bases are grouped by opt-unroll-simd-memory-*, and
;; its recurrences are cloned mutably. A scalar StorePtr is the only thing
;; keeping a gang body out of the whitelist above, so without this the class
;; would be a back door onto the scalar rewrite for exactly those bodies.
(define (opt-unroll-body-load-store-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) false]
    [_
      (and
        (not (opt-unroll-simd-vector-instr? instr))
        (opt-unroll-body-instr-ok? instr))]))

(define (opt-unroll-body-load-store-ok?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-body-load-store-instr-ok? (array-ref slots index))
      (opt-unroll-body-load-store-ok? slots (+ index 1) last))))

;; A counted self-loop pays the SAME three instructions per trip whatever its
;; body does -- the counter add, the bound compare and the latch branch -- so
;; unrolling by K leaves 3/K of that and recovers 3 - 3/K. K=16 recovers 2.81
;; of the 3; K=2 recovers 1.50, half the total, for ONE extra body copy.
(define (opt-unroll-group-copies) : i64
  16)

;; Why the load-and-store class gets K=2 rather than the K above. The refusal
;; recorded on opt-unroll-body-instr-ok? is not about unrolling stores as such;
;; it is about the SIXTEEN-copy clone of a body that keeps a container pointer
;; and a loaded value live across every store, on loops whose trip counts are
;; unknowable statically and were measured short (hashmap grow/insert -1..2%,
;; self-compile +1.4%). Both terms of that cost are per EXTRA copy: at K=2 the
;; clone doubles instead of sixteen-folding, each copy's loaded value still
;; dies at its own store one copy later, and the entry guard (which admits only
;; `seed < bound - K`) breaks even at ~4 trips instead of ~19. Loads without
;; stores and stores without loads keep K=16: their measured shapes are the
;; long-trip reductions and fills the larger factor was tuned for.
(define (opt-unroll-load-store-group-copies) : i64
  2)

;; Body copies the rewrite emits, or 0 for a body no class admits. The shape
;; scan refuses a 0 and the rewrite sizes both its copy loop and its guard's
;; `bound - K` from the same answer, so admission and factor can never diverge.
(define (opt-unroll-body-copies
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [last : i64]) : i64
  (if (or
    (opt-unroll-body-ok? slots index last)
    (opt-unroll-body-fill-ok? slots index last))
    (opt-unroll-group-copies)
    (if (opt-unroll-body-load-store-ok? slots index last)
      (opt-unroll-load-store-group-copies)
      0)))

(define (opt-unroll-shape-scan
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [count : i64]
  [cond-var : i64]) : OptUnrollMaybeShape
  (let
    [last : i64 (- count 1)]
    [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
    (if (or
      (< phi-count 1)
      (< (- last phi-count) 2)
      (> (- last phi-count) 16)
      (not (opt-unroll-no-phi-from? instrs phi-count))
      (< (opt-unroll-body-copies instrs.slots phi-count last) 2)
      ;; the c-def is dropped from the clones, so the final branch must be c's
      ;; only use inside B.
      (opt-used-contains
        (opt-unroll-uses-before
          instrs
          0
          last
          (opt_i64_i64_map.with-capacity 64))
        cond-var))
      (OptUnrollMaybeShape.No)
      (opt-unroll-shape-counter blocks label instrs phi-count last cond-var))))

(define (opt-unroll-block-shape
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [block : ir.CompilerIrBlock]) : OptUnrollMaybeShape
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          (OptUnrollMaybeShape.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label label)
                    (not (= else-label label))
                    (not (= label entry-label))
                    ;; A versioned loop's original body is the cold checked
                    ;; fallback. Spending this invocation's sole unroll slot
                    ;; on it both bloats cold code and can strand a later hot
                    ;; `__bce_fast` clone at the optimizer iteration cap.
                    (not
                      (opt-cfg-block-exists?
                        blocks
                        (ir.compiler-ir-label
                          (str_cat.str-cat
                            (ir.compiler-ir-label-text label)
                            "__bce_fast")))))
                    (opt-unroll-shape-scan blocks label instrs count cond-var)
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])))]))

;; --- rewrite -----------------------------------------------------------------
(define (opt-unroll-alloc-var [cell : (__tl_dyn-array i64)]) : i64
  (let
    [next : i64 (array-ref cell 0)]
    (begin
      (set! (array-ref cell 0) (+ next 1))
      next)))

(define (opt-unroll-remap-fill
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length remap))
    unit
    (begin
      (set! (array-ref remap index) (ir.CompilerIrValue.Var (- 0 1)))
      (opt-unroll-remap-fill remap (+ index 1)))))

(define (opt-unroll-remap-set
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [var : i64]
  [value : ir.CompilerIrValue]) : unit
  (if (and (>= var 0) (< var (array-length remap)))
    (set! (array-ref remap var) value)
    unit))

(define (opt-unroll-subst-value
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var id)
      (if (and (>= id 0) (< id (array-length remap)))
        (let
          [mapped : ir.CompilerIrValue (array-ref remap id)]
          (match mapped
            [(ir.CompilerIrValue.Var mapped-id)
              (if (< mapped-id 0)
                value
                mapped)]
            [_ mapped]))
        value)]
    [_ value]))

(define (opt-unroll-clone-dst
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [dst : i64]) : i64
  (let
    [fresh : i64 (opt-unroll-alloc-var cell)]
    (begin
      (opt-unroll-remap-set remap dst (ir.CompilerIrValue.Var fresh))
      fresh)))

(define (opt-unroll-copy-suffix [copy : i64]) : String
  (str_cat.str-cat "__u" (string.int->string copy)))

;; Clone one whitelisted body instruction: substitute uses through the remap
;; first, then allocate a fresh dst and record it. Only the kinds accepted by
;; `opt-unroll-body-instr-ok?` reach this.
(define (opt-unroll-clone-instr
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [copy : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (let
        [new-src : ir.CompilerIrValue (opt-unroll-subst-value remap src)]
        (ir.CompilerIrInstr.Mov
          (opt-unroll-clone-dst remap cell dst)
          new-src
          ty))]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (let
        [new-src : ir.CompilerIrValue (opt-unroll-subst-value remap src)]
        (ir.CompilerIrInstr.Cast
          (opt-unroll-clone-dst remap cell dst)
          new-src
          from-ty
          to-ty))]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (let
        [new-src : ir.CompilerIrValue (opt-unroll-subst-value remap src)]
        (ir.CompilerIrInstr.Bitcast
          (opt-unroll-clone-dst remap cell dst)
          new-src
          from-ty
          to-ty))]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (let
        [new-lhs : ir.CompilerIrValue (opt-unroll-subst-value remap lhs)]
        [new-rhs : ir.CompilerIrValue (opt-unroll-subst-value remap rhs)]
        (ir.CompilerIrInstr.BinOp
          (opt-unroll-clone-dst remap cell dst)
          op
          new-lhs
          new-rhs
          ty))]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (let
        [new-src : ir.CompilerIrValue (opt-unroll-subst-value remap src)]
        (ir.CompilerIrInstr.UnOp
          (opt-unroll-clone-dst remap cell dst)
          op
          new-src
          ty))]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (let
        [new-base : ir.CompilerIrValue (opt-unroll-subst-value remap base)]
        [new-offset : ir.CompilerIrValue (opt-unroll-subst-value remap offset)]
        (ir.CompilerIrInstr.Gep
          (opt-unroll-clone-dst remap cell dst)
          new-base
          new-offset
          ty))]
    [(ir.CompilerIrInstr.Load dst src ty)
      (let
        [new-src : ir.CompilerIrValue (opt-unroll-subst-value remap src)]
        (ir.CompilerIrInstr.Load
          (opt-unroll-clone-dst remap cell dst)
          new-src
          ty))]
    [(ir.CompilerIrInstr.LaneId dst lanes ty)
      (ir.CompilerIrInstr.LaneId (opt-unroll-clone-dst remap cell dst) lanes ty)]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat
        (opt-unroll-clone-dst remap cell dst)
        (opt-unroll-subst-value remap value)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-bin-op
          (opt-unroll-clone-dst remap cell dst)
          op
          (opt-unroll-subst-value remap lhs)
          (opt-unroll-subst-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (ir.CompilerIrInstr.VectorReduce
        (opt-unroll-clone-dst remap cell dst)
        op
        (opt-unroll-subst-value remap src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-compare
          (opt-unroll-clone-dst remap cell dst)
          op
          (opt-unroll-subst-value remap lhs)
          (opt-unroll-subst-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        (opt-unroll-clone-dst remap cell dst)
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        lanes)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-select
          (opt-unroll-clone-dst remap cell dst)
          (opt-unroll-subst-value remap mask)
          (opt-unroll-subst-value remap on-true)
          (opt-unroll-subst-value remap on-false)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorLoad dst base index lanes ty)
      (ir.CompilerIrInstr.VectorLoad
        (opt-unroll-clone-dst remap cell dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap index)
        lanes
        ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      ;; BoundsCheck ok-labels are function-unique local labels; suffix each
      ;; copy so the clones stay unique.
      (ir.CompilerIrInstr.BoundsCheck
        (opt-unroll-subst-value remap index)
        (opt-unroll-subst-value remap length)
        (ir.compiler-ir-label
          (str_cat.str-cat
            (ir.compiler-ir-label-text ok-label)
            (opt-unroll-copy-suffix copy))))]
    [_ instr]))

(define (opt-unroll-phi-list-count [phis : OptUnrollPhiList]) : i64
  (match phis
    [(OptUnrollPhiList.Nil) 0]
    [(OptUnrollPhiList.Cons _ rest)
      (+ 1 (opt-unroll-phi-list-count (__tl-box-place rest)))]))

(define (opt-unroll-alloc-ku-ids
  [ku-ids : (__tl_dyn-array i64)]
  [index : i64]
  [count : i64]
  [cell : (__tl_dyn-array i64)]) : unit
  (if (>= index count)
    unit
    (begin
      (set! (array-ref ku-ids index) (opt-unroll-alloc-var cell))
      (opt-unroll-alloc-ku-ids ku-ids (+ index 1) count cell))))

(define (opt-unroll-ku-values
  [ku-ids : (__tl_dyn-array i64)]
  [index : i64]
  [count : i64]) : ir.CompilerIrValueList
  (if (>= index count)
    (ir.CompilerIrValueList.Nil)
    (ir.compiler-ir-value-cons
      (ir.CompilerIrValue.Var (array-ref ku-ids index))
      (opt-unroll-ku-values ku-ids (+ index 1) count))))

;; Back-edge values of the loop-carried phis under the current remap state
;; (the values the NEXT copy's phi vars should read). Computed for every phi
;; before any phi var is re-seeded so phi-to-phi back edges (value rotations)
;; read the previous copy's state.
(define (opt-unroll-phi-chain-values
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [others : OptUnrollPhiList]) : ir.CompilerIrValueList
  (match others
    [(OptUnrollPhiList.Nil) (ir.CompilerIrValueList.Nil)]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi _ _ back _)
          (ir.compiler-ir-value-cons
            (opt-unroll-subst-value remap back)
            (opt-unroll-phi-chain-values remap (__tl-box-place rest)))])]))

(define (opt-unroll-write-phi-seeds
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [others : OptUnrollPhiList]
  [values : ir.CompilerIrValueList]) : unit
  (match others
    [(OptUnrollPhiList.Nil) unit]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi dst _ _ _)
          (match values
            [(ir.CompilerIrValueList.Cons value value-rest)
              (begin
                (opt-unroll-remap-set remap dst value)
                (opt-unroll-write-phi-seeds
                  remap
                  (__tl-box-place rest)
                  (__tl-box-place value-rest)))]
            [(ir.CompilerIrValueList.Array seq)
              (opt-unroll-write-phi-seeds
                remap
                others
                (ir.compiler-ir-value-seq-to-list seq))]
            [(ir.CompilerIrValueList.Nil) unit])])]))

;; One clone of B's body (the non-phi instructions minus the c-def and the
;; final branch), in original order. The let forces the clone (and its remap
;; side effects) before the recursive tail.
(define (opt-unroll-copy-body
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [skip : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [copy : i64]) : ir.CompilerIrInstrList
  (if (>= index last)
    (ir.CompilerIrInstrList.Nil)
    (if (= index skip)
      (opt-unroll-copy-body instrs (+ index 1) last skip remap cell copy)
      (let
        [cloned : ir.CompilerIrInstr
          (opt-unroll-clone-instr
            remap
            cell
            copy
            (ir.compiler-ir-instr-seq-ref instrs index))]
        (ir.compiler-ir-instr-cons
          cloned
          (opt-unroll-copy-body instrs (+ index 1) last skip remap cell copy))))))

(define (opt-unroll-copies
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [skip : i64]
  [iphi : i64]
  [inext : i64]
  [others : OptUnrollPhiList]
  [ku-ids : (__tl_dyn-array i64)]
  [other-count : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [iu : i64]
  [copies : i64]
  [copy : i64]) : ir.CompilerIrInstrList
  (if (>= copy copies)
    (ir.CompilerIrInstrList.Nil)
    (let
      ;; Copy 0 reads the fresh U phis; later copies read the previous copy's
      ;; remapped back-edge values. All seeds are computed before any is
      ;; written so phi-to-phi back edges see the pre-copy state.
      [counter-seed : ir.CompilerIrValue
        (if (= copy 0)
          (ir.CompilerIrValue.Var iu)
          (opt-unroll-subst-value remap (ir.CompilerIrValue.Var inext)))]
      [other-seeds : ir.CompilerIrValueList
        (if (= copy 0)
          (opt-unroll-ku-values ku-ids 0 other-count)
          (opt-unroll-phi-chain-values remap others))]
      [_seed-counter : unit (opt-unroll-remap-set remap iphi counter-seed)]
      [_seed-others : unit
        (opt-unroll-write-phi-seeds remap others other-seeds)]
      [body : ir.CompilerIrInstrList
        (opt-unroll-copy-body instrs phi-count last skip remap cell copy)]
      (opt-aggregate-instr-list-append
        body
        (opt-unroll-copies
          instrs
          phi-count
          last
          skip
          iphi
          inext
          others
          ku-ids
          other-count
          remap
          cell
          iu
          copies
          (+ copy 1))))))

(define (opt-unroll-unrolled-phis
  [others : OptUnrollPhiList]
  [ku-ids : (__tl_dyn-array i64)]
  [index : i64]
  [chains : ir.CompilerIrValueList]
  [guard-label : i64]
  [unrolled-label : i64]
  [tail : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match others
    [(OptUnrollPhiList.Nil) tail]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi _ init _ ty)
          (match chains
            [(ir.CompilerIrValueList.Cons chain chain-rest)
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Phi
                  (array-ref ku-ids index)
                  (ir.compiler-ir-phi-input-cons
                    init
                    guard-label
                    (ir.compiler-ir-phi-input-cons
                      chain
                      unrolled-label
                      (ir.CompilerIrPhiInputList.Nil)))
                  ty)
                (opt-unroll-unrolled-phis
                  (__tl-box-place rest)
                  ku-ids
                  (+ index 1)
                  (__tl-box-place chain-rest)
                  guard-label
                  unrolled-label
                  tail))]
            [(ir.CompilerIrValueList.Array seq)
              (opt-unroll-unrolled-phis
                others
                ku-ids
                index
                (ir.compiler-ir-value-seq-to-list seq)
                guard-label
                unrolled-label
                tail)]
            [(ir.CompilerIrValueList.Nil) tail])])]))

;; B stays in place as the remainder loop: each phi keeps its back-edge input,
;; its outside input is relabeled from P to the guard, and a third input from
;; the unrolled body is appended. Everything else is unchanged.
(define (opt-unroll-tail-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [loop-label : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [inext : i64]
  [inext3 : ir.CompilerIrValue]
  [others : OptUnrollPhiList]
  [chains : ir.CompilerIrValueList]
  [guard-label : i64]
  [unrolled-label : i64]) : ir.CompilerIrInstrList
  (if (>= index count)
    (ir.CompilerIrInstrList.Nil)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst _ ty)
        (if (= dst iphi)
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Phi
              dst
              (ir.compiler-ir-phi-input-cons
                seed
                guard-label
                (ir.compiler-ir-phi-input-cons
                  (ir.CompilerIrValue.Var inext)
                  loop-label
                  (ir.compiler-ir-phi-input-cons
                    inext3
                    unrolled-label
                    (ir.CompilerIrPhiInputList.Nil))))
              ty)
            (opt-unroll-tail-instrs
              instrs
              (+ index 1)
              count
              loop-label
              iphi
              seed
              inext
              inext3
              others
              chains
              guard-label
              unrolled-label))
          (match others
            [(OptUnrollPhiList.Cons phi other-rest)
              (match phi
                [(OptUnrollPhi.Phi _ init back _)
                  (match chains
                    [(ir.CompilerIrValueList.Cons chain chain-rest)
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.Phi
                          dst
                          (ir.compiler-ir-phi-input-cons
                            init
                            guard-label
                            (ir.compiler-ir-phi-input-cons
                              back
                              loop-label
                              (ir.compiler-ir-phi-input-cons
                                chain
                                unrolled-label
                                (ir.CompilerIrPhiInputList.Nil))))
                          ty)
                        (opt-unroll-tail-instrs
                          instrs
                          (+ index 1)
                          count
                          loop-label
                          iphi
                          seed
                          inext
                          inext3
                          (__tl-box-place other-rest)
                          (__tl-box-place chain-rest)
                          guard-label
                          unrolled-label))]
                    [(ir.CompilerIrValueList.Array seq)
                      (opt-unroll-tail-instrs
                        instrs
                        index
                        count
                        loop-label
                        iphi
                        seed
                        inext
                        inext3
                        others
                        (ir.compiler-ir-value-seq-to-list seq)
                        guard-label
                        unrolled-label)]
                    [(ir.CompilerIrValueList.Nil) (ir.CompilerIrInstrList.Nil)])])]
            [(OptUnrollPhiList.Nil) (ir.CompilerIrInstrList.Nil)]))]
      [_
        (ir.compiler-ir-instr-cons
          (ir.compiler-ir-instr-seq-ref instrs index)
          (opt-unroll-tail-instrs
            instrs
            (+ index 1)
            count
            loop-label
            iphi
            seed
            inext
            inext3
            others
            chains
            guard-label
            unrolled-label))])))

(define (opt-unroll-retarget-instr
  [instr : ir.CompilerIrInstr]
  [from-label : i64]
  [to-label : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Jump target)
      (if (= target from-label)
        (ir.CompilerIrInstr.Jump to-label)
        instr)]
    [(ir.CompilerIrInstr.Branch cond then-label else-label)
      (if (or (= then-label from-label) (= else-label from-label))
        (ir.CompilerIrInstr.Branch
          cond
          (if (= then-label from-label)
            to-label
            then-label)
          (if (= else-label from-label)
            to-label
            else-label))
        instr)]
    [_ instr]))

(define (opt-unroll-retarget-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [from-label : i64]
  [to-label : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (ir.compiler-ir-instr-cons
      (opt-unroll-retarget-instr
        (ir.compiler-ir-instr-seq-ref instrs index)
        from-label
        to-label)
      (opt-unroll-retarget-instrs instrs (+ index 1) from-label to-label))))

;; Replace B with guard + unrolled + tail (in place, so a fallthrough pred
;; keeps reaching the loop via the guard) and retarget P's jump/branch edges
;; from B to the guard.
(define (opt-unroll-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [pred-label : i64]
  [loop-label : i64]
  [guard-block : ir.CompilerIrBlock]
  [unrolled-block : ir.CompilerIrBlock]
  [tail-block : ir.CompilerIrBlock]
  [guard-label : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (= label loop-label)
            (ir.compiler-ir-block-cons
              guard-block
              (ir.compiler-ir-block-cons
                unrolled-block
                (ir.compiler-ir-block-cons
                  tail-block
                  (opt-unroll-rewrite-blocks
                    (__tl-box-place rest)
                    pred-label
                    loop-label
                    guard-block
                    unrolled-block
                    tail-block
                    guard-label))))
            (ir.compiler-ir-block-cons
              (if (= label pred-label)
                (ir.compiler-ir-block
                  label
                  (opt-unroll-retarget-instrs instrs 0 loop-label guard-label))
                block)
              (opt-unroll-rewrite-blocks
                (__tl-box-place rest)
                pred-label
                loop-label
                guard-block
                unrolled-block
                tail-block
                guard-label)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        pred-label
        loop-label
        guard-block
        unrolled-block
        tail-block
        guard-label)]))

(define (opt-unroll-apply
  [blocks : ir.CompilerIrBlockList]
  [block : ir.CompilerIrBlock]
  [shape : OptUnrollShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [last : i64 (- count 1)]
        [phi-count : i64 shape.phi-count]
        [cond-index : i64 shape.cond-index]
        [iphi : i64 shape.iphi]
        [iphi-ty : ast.AstType shape.iphi-ty]
        [seed : ir.CompilerIrValue shape.seed]
        [inext : i64 shape.inext]
        [ity : ast.AstType shape.ity]
        [bound : ir.CompilerIrValue shape.bound]
        [others : OptUnrollPhiList shape.others]
        [pred-label : i64 shape.pred-label]
        [guard-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_guard"))]
        [unrolled-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_body"))]
        [remap : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [_fill : unit (opt-unroll-remap-fill remap 0)]
        [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
        [_cell : unit (set! (array-ref cell 0) frame)]
        [iu : i64 (opt-unroll-alloc-var cell)]
        [other-count : i64 (opt-unroll-phi-list-count others)]
        [ku-ids : (__tl_dyn-array i64)
          (array.make-array
            i64
            (if (< other-count 1)
              1
              other-count))]
        [_ku : unit (opt-unroll-alloc-ku-ids ku-ids 0 other-count cell)]
        ;; One answer sizes the clone and the guard: the shape scan admitted
        ;; this body only because the same call returned at least two.
        [copy-count : i64 (opt-unroll-body-copies instrs.slots phi-count last)]
        [copies : ir.CompilerIrInstrList
          (opt-unroll-copies
            instrs
            phi-count
            last
            cond-index
            iphi
            inext
            others
            ku-ids
            other-count
            remap
            cell
            iu
            copy-count
            0)]
        ;; End-of-last-copy state: the counter and chain values the next group
        ;; iteration (and the remainder loop's phis) receive.
        [inext3 : ir.CompilerIrValue
          (opt-unroll-subst-value remap (ir.CompilerIrValue.Var inext))]
        [chains : ir.CompilerIrValueList
          (opt-unroll-phi-chain-values remap others)]
        [ngroup : i64 (opt-unroll-alloc-var cell)]
        [gwrap : i64 (opt-unroll-alloc-var cell)]
        [gfirst : i64 (opt-unroll-alloc-var cell)]
        [gok : i64 (opt-unroll-alloc-var cell)]
        [gu : i64 (opt-unroll-alloc-var cell)]
        [guard-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            guard-label
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                ngroup
                (ir.CompilerIrBinOp.Sub)
                bound
                (ir.CompilerIrValue.I64 copy-count)
                ity)
              (ir.compiler-ir-instr-cons
                ;; false iff bound - copy-count wrapped past bound.
                (ir.CompilerIrInstr.BinOp
                  gwrap
                  (ir.CompilerIrBinOp.Le)
                  (ir.CompilerIrValue.Var ngroup)
                  bound
                  ity)
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    gfirst
                    (ir.CompilerIrBinOp.Lt)
                    seed
                    (ir.CompilerIrValue.Var ngroup)
                    ity)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      gok
                      (ir.CompilerIrBinOp.And)
                      (ir.CompilerIrValue.Var gwrap)
                      (ir.CompilerIrValue.Var gfirst)
                      (ast.AstType.Bool))
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Branch
                        (ir.CompilerIrValue.Var gok)
                        unrolled-label
                        label)
                      (ir.CompilerIrInstrList.Nil)))))))]
        [unrolled-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            unrolled-label
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Phi
                iu
                (ir.compiler-ir-phi-input-cons
                  seed
                  guard-label
                  (ir.compiler-ir-phi-input-cons
                    inext3
                    unrolled-label
                    (ir.CompilerIrPhiInputList.Nil)))
                iphi-ty)
              (opt-unroll-unrolled-phis
                others
                ku-ids
                0
                chains
                guard-label
                unrolled-label
                (opt-aggregate-instr-list-append
                  copies
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      gu
                      (ir.CompilerIrBinOp.Lt)
                      inext3
                      (ir.CompilerIrValue.Var ngroup)
                      ity)
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Branch
                        (ir.CompilerIrValue.Var gu)
                        unrolled-label
                        label)
                      (ir.CompilerIrInstrList.Nil)))))))]
        [tail-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            label
            (opt-unroll-tail-instrs
              instrs
              0
              count
              label
              iphi
              seed
              inext
              inext3
              others
              chains
              guard-label
              unrolled-label))]
        (OptUnrollResult.Result
          (opt-unroll-rewrite-blocks
            blocks
            pred-label
            label
            guard-block
            unrolled-block
            tail-block
            guard-label)
          (array-ref cell 0)
          true))]))

;; --- constant fill -> tl_mem_fill8 (fill_call) --------------------------------
;;
;; A counted loop whose whole body is `base[i] = K` for a literal K becomes one
;; `tl_mem_fill8(&base[seed], bound - seed, K)` call. The runtime helper is a
;; `rep stosq`, which the deterministic instruction-count gate charges ONE
;; instruction per slot; the x16 unroller this pass pre-empts charges 19 per 16
;; slots in its body PLUS an 11-instruction version guard PLUS 4 per slot in the
;; sub-16 remainder, and the corpus's fills average ~20 slots, so the remainder
;; and the guard -- not the steady state -- are what this recovers.
;;
;; WHY IT IS SOUND TO DROP THE BOUNDS CHECKS: this pass rewrites ONLY the
;; `__bce_fast` clone the versioner produced, and only when the clone's single
;; non-self predecessor is that loop's own `__bce_guard`. That guard is built by
;; `opt-bce-version-guard-finish`, which for every counter-bearing loop emits
;;   seed >= 0   AND   seed < bound   AND   the per-check bound conditions
;; into the guard before branching to the fast clone -- see its comment: the
;; do-while's FIRST body iteration runs before any compare, so without
;; `seed < bound` "a loop entered with seed >= bound would run one unchecked
;; fast iteration at an index the slow path would have aborted on". So on the
;; only edge that reaches the clone: seed is non-negative, the trip count is
;; exactly `bound - seed` (>= 1, counter step is 1), and every index in
;; [seed, bound) was already proven in bounds -- which is precisely why the
;; clone carries no BoundsCheck. The call therefore writes exactly the slots the
;; loop wrote and, like the loop, cannot abort. The CHECKED original is left
;; untouched, so a program that would abort mid-fill still takes that path and
;; still aborts at the same element.
;;
;; The rewrite keeps the block: it drops the self-edge phi inputs, keeps the
;; address Gep (whose index is now the phi's seed value), replaces the store
;; with the call, redefines the counter's `next` as `bound` (its exit value),
;; and ends with a Jump. Instructions that merely copy `next` or the loop
;; compare therefore keep computing their exit values, which is why those are
;; the only in-block definitions allowed to escape the block.
(defstruct OptFillCallSite
  (store-index i64)
  (gep-index i64)
  (base ir.CompilerIrValue)
  (value i64)
  (ty ast.AstType))

(defenum OptFillCallMaybeSite
  (No)
  (Some OptFillCallSite))

;; The loop facts this rewrite needs. Deliberately NOT `OptUnrollShape`: the
;; unroller's recognizer describes the same family of counted self-loops but
;; carries preconditions that exist for ITS rewrite and reject the shape the
;; versioner actually emits.
;;   * `opt-unroll-shape-scan` requires the compare's only in-block use to be
;;     the terminator, because the unroller DROPS the compare from its clones.
;;     A freshly versioned clone still carries the loop's bool phi, whose
;;     back-edge input is that very compare, so the gate fires. This rewrite
;;     KEEPS the compare -- redefining `inext` as `bound` leaves it computing
;;     the loop's exit value -- so the gate does not apply here.
;;   * `opt-unroll-pred-retargetable?` exists because the unroller splices a
;;     guard block in front of the loop. This rewrite never retargets a
;;     predecessor; it edits the block in place.
;;   * the `__unroll_guard` / `__unroll_body` existence checks are the
;;     unroller's own idempotence latch.
;; Waiting for a later pipeline round to clean the copies away (which would let
;; the unroller's recognizer accept) is not an option either: by then the
;; unroller is racing this pass for the same block, and it runs in the same
;; iteration immediately after.
(defstruct OptFillCallShape
  (pred-label i64)
  (exit-label i64)
  (phi-count i64)
  (iphi i64)
  (inext i64)
  (cond-var i64)
  (ity ast.AstType)
  (bound ir.CompilerIrValue))

(defenum OptFillCallMaybeShape
  (No)
  (Some OptFillCallShape))

;; A rotated counted self-loop: `B: phis...; body...; branch c B EXIT`.
(define (opt-fill-call-shape [entry-label : i64] [block : ir.CompilerIrBlock]) : OptFillCallMaybeShape
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        ;; counter phi + gep + store + add + compare + branch
        (if (or (< count 6) (= label entry-label))
          (OptFillCallMaybeShape.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label label)
                    (not (= else-label label))
                    (opt-fill-call-fast-clone-label? label))
                    (opt-fill-call-shape-scan
                      label
                      instrs
                      count
                      cond-var
                      else-label)
                    (OptFillCallMaybeShape.No))]
                [_ (OptFillCallMaybeShape.No)])]
            [_ (OptFillCallMaybeShape.No)])))]))

;; Only the versioner's fast clones are candidates, and testing that BEFORE the
;; counter/bound analysis is what keeps this stage off every other rotated
;; self-loop. It matters most at opt1, where the versioner does not run at all:
;; without this gate the pass paid a defs scan and a map allocation per loop for
;; a rewrite that can never fire (measured +0.021% on the opt1 self-compile).
(define (opt-fill-call-fast-clone-label? [label : i64]) : bool
  (let
    [text : String (ir.compiler-ir-label-text label)]
    [suffix : String "__bce_fast"]
    [n : i64 (string.string-length (& text))]
    [m : i64 (string.string-length (& suffix))]
    (and (> n m) (string.eq (string.substring (& text) (- n m) m) suffix))))

(define (opt-fill-call-shape-scan
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [count : i64]
  [cond-var : i64]
  [exit-label : i64]) : OptFillCallMaybeShape
  (let
    [last : i64 (- count 1)]
    [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
    ;; The body cap is a compile-time bound on the quadratic gep lookup, not a
    ;; correctness condition; a versioned fill body is 4 to 8 instructions.
    (if (or
      (< phi-count 1)
      (< (- last phi-count) 4)
      (> (- last phi-count) 16)
      (not (opt-unroll-no-phi-from? instrs phi-count)))
      (OptFillCallMaybeShape.No)
      (opt-fill-call-shape-cond label instrs phi-count last cond-var exit-label))))

;; `c = <counter-ish> < <bound>` with a loop-invariant bound. The bound becomes
;; the fill's end index, so a block-local bound would make the count wrong.
(define (opt-fill-call-shape-cond
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [exit-label : i64]) : OptFillCallMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [cond-index : i64 (opt-unroll-def-index slots phi-count last cond-var)]
    (if (< cond-index 0)
      (OptFillCallMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs cond-index)
        [(ir.CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(ir.CompilerIrBinOp.Lt)
              (match cmp-lhs
                ;; the compare's lhs is often a COPY of the counter's next
                ;; value rather than the value itself.
                [(ir.CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound?
                    (opt-unroll-block-defs
                      slots
                      0
                      (+ last 1)
                      (opt_i64_i64_map.with-capacity 32))
                    cmp-rhs)
                    (opt-fill-call-shape-step
                      label
                      instrs
                      phi-count
                      last
                      cond-var
                      exit-label
                      (opt-unroll-resolve-copy instrs phi-count last cmp-src 16)
                      cmp-rhs)
                    (OptFillCallMaybeShape.No))]
                [_ (OptFillCallMaybeShape.No)])]
            [_ (OptFillCallMaybeShape.No)])]
        [_ (OptFillCallMaybeShape.No)]))))

;; `inext = iphi + 1`. Step 1 is what makes the visited index set exactly
;; [seed, bound) -- the contiguous run `rep stosq` writes.
(define (opt-fill-call-shape-step
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [exit-label : i64]
  [inext : i64]
  [bound : ir.CompilerIrValue]) : OptFillCallMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
    (if (< inext-index 0)
      (OptFillCallMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs inext-index)
        [(ir.CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-op
            [(ir.CompilerIrBinOp.Add)
              (match add-lhs
                [(ir.CompilerIrValue.Var add-src)
                  (match add-rhs
                    [(ir.CompilerIrValue.I64 step)
                      (if (and (= step 1) (opt-integer-type? ity))
                        (opt-fill-call-shape-phi
                          label
                          instrs
                          phi-count
                          last
                          cond-var
                          exit-label
                          (opt-unroll-resolve-copy
                            instrs
                            phi-count
                            last
                            add-src
                            16)
                          inext
                          ity
                          bound)
                        (OptFillCallMaybeShape.No))]
                    [_ (OptFillCallMaybeShape.No)])]
                [_ (OptFillCallMaybeShape.No)])]
            [_ (OptFillCallMaybeShape.No)])]
        [_ (OptFillCallMaybeShape.No)]))))

;; The counter phi: exactly two inputs, the back edge carrying `inext` and the
;; single other edge seeding LITERAL 0.
;;
;; Seed 0 is required rather than merely handled. It is what makes the count
;; `bound - 0 = bound`, and a rotated `while (< i bound)` whose counter starts
;; at 0 can only be entered when `0 < bound` held -- the rotation guard tests
;; exactly that expression -- so the trip count is >= 1 independently of the
;; version guard's own `seed < bound` condition. Both facts point the same way;
;; requiring the literal keeps the second one available.
(define (opt-fill-call-shape-phi
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [exit-label : i64]
  [iphi : i64]
  [inext : i64]
  [ity : ast.AstType]
  [bound : ir.CompilerIrValue]) : OptFillCallMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [iphi-index : i64 (opt-unroll-def-index slots 0 phi-count iphi)]
    (if (< iphi-index 0)
      (OptFillCallMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs iphi-index)
        [(ir.CompilerIrInstr.Phi _ inputs _)
          (match (opt-unroll-split-phi-inputs inputs label)
            [(OptUnrollPhiSplit.Split seed back pred-label)
              (if (and
                (not (= pred-label label))
                (opt-fill-call-zero-seed? seed)
                (opt-unroll-back-resolves-to? instrs phi-count last back inext)
                (opt-fill-call-other-phis-ok?
                  instrs
                  0
                  phi-count
                  label
                  pred-label
                  iphi))
                (OptFillCallMaybeShape.Some
                  (OptFillCallShape
                    pred-label
                    exit-label
                    phi-count
                    iphi
                    inext
                    cond-var
                    ity
                    bound))
                (OptFillCallMaybeShape.No))]
            [(OptUnrollPhiSplit.No) (OptFillCallMaybeShape.No)])]
        [_ (OptFillCallMaybeShape.No)]))))

(define (opt-fill-call-zero-seed? [seed : ir.CompilerIrValue]) : bool
  (match seed
    [(ir.CompilerIrValue.I64 k) (= k 0)]
    [_ false]))

;; Every other phi -- the versioner leaves a bool phi carrying the loop compare
;; behind -- must split over the SAME two edges. A phi naming a third
;; predecessor would mean the block has an entry that does not come through the
;; version guard, and the seed/bound facts would not hold on it.
(define (opt-fill-call-other-phis-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [label : i64]
  [pred-label : i64]
  [iphi : i64]) : bool
  (if (>= index phi-count)
    true
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst inputs _)
        (if (= dst iphi)
          (opt-fill-call-other-phis-ok?
            instrs
            (+ index 1)
            phi-count
            label
            pred-label
            iphi)
          (match (opt-unroll-split-phi-inputs inputs label)
            [(OptUnrollPhiSplit.Split _ _ split-pred)
              (and
                (= split-pred pred-label)
                (opt-fill-call-other-phis-ok?
                  instrs
                  (+ index 1)
                  phi-count
                  label
                  pred-label
                  iphi))]
            [(OptUnrollPhiSplit.No) false]))]
      [_ false])))

;; `rep stosq` writes 8-byte slots, so only pointer-width integer element types
;; qualify. Narrower fills would need a different helper and wider ones do not
;; exist; f64 is excluded because its literal would not be an integer operand.
(define (opt-fill-call-slot-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [_ false]))

(define (opt-fill-call-versioned-prefix [loop-label : i64]) : String
  (let
    [text : String (ir.compiler-ir-label-text loop-label)]
    [suffix : String "__bce_fast"]
    [n : i64 (string.string-length (& text))]
    [m : i64 (string.string-length (& suffix))]
    (if (or
      (<= n m)
      (not (string.eq (string.substring (& text) (- n m) m) suffix)))
      ""
      (string.substring (& text) 0 (- n m)))))

;; The clone's entry facts come from `<prefix>__bce_guard`, but that guard is not
;; always the IMMEDIATE predecessor: the versioner emits its `and` chain as
;; `<prefix>__bce_guard__bool_and.N` once a later pipeline round splits it, and
;; the unroller inserts `<prefix>__bce_fast__preheader`. Every one of those is a
;; versioner-generated forwarding block in the SAME `<prefix>__bce_` namespace
;; and none of them redefines the counter or the bound, so requiring the
;; predecessor to live in that namespace -- and the guard block itself to exist
;; -- still pins the clone to exactly one entry, the guard's true edge. A change
;; to the versioner's naming makes this stop matching, which is the safe
;; direction.
(define (opt-fill-call-pred-in-version-namespace?
  [blocks : ir.CompilerIrBlockList]
  [prefix : String]
  [pred-label : i64]) : bool
  (let
    [pred : String (ir.compiler-ir-label-text pred-label)]
    [want : String (str_cat.str-cat prefix "__bce_")]
    [n : i64 (string.string-length (& pred))]
    [m : i64 (string.string-length (& want))]
    (and
      (> (string.string-length (& prefix)) 0)
      (>= n m)
      (string.eq (string.substring (& pred) 0 m) want)
      (opt-cfg-block-exists?
        blocks
        (ir.compiler-ir-label (str_cat.str-cat prefix "__bce_guard"))))))

;; The body must be exactly: one `store_ptr <gep(base, iphi)>, K`, plus copies
;; and the counter arithmetic. Any Load, BoundsCheck, second store, call or
;; other instruction rejects -- the first two because they would mean the clone
;; is not the check-free fill this pass reasons about.
(define (opt-fill-call-scan-body
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [iphi : i64]
  [found : OptFillCallMaybeSite]) : OptFillCallMaybeSite
  (if (>= index last)
    found
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.StorePtr ptr value ty)
        (match found
          [(OptFillCallMaybeSite.Some _) (OptFillCallMaybeSite.No)]
          [(OptFillCallMaybeSite.No)
            (match ptr
              [(ir.CompilerIrValue.Var ptr-var)
                (match value
                  [(ir.CompilerIrValue.I64 k)
                    (if (not (opt-fill-call-slot-type? ty))
                      (OptFillCallMaybeSite.No)
                      (match (opt-fill-call-gep-of instrs 0 last ptr-var iphi)
                        [(OptFillCallMaybeSite.No) (OptFillCallMaybeSite.No)]
                        [(OptFillCallMaybeSite.Some site)
                          (opt-fill-call-scan-body
                            instrs
                            (+ index 1)
                            last
                            iphi
                            (OptFillCallMaybeSite.Some
                              (OptFillCallSite
                                index
                                site.gep-index
                                site.base
                                k
                                ty)))]))]
                  [_ (OptFillCallMaybeSite.No)])]
              [_ (OptFillCallMaybeSite.No)])])]
      [(ir.CompilerIrInstr.Mov _ _ _)
        (opt-fill-call-scan-body instrs (+ index 1) last iphi found)]
      [(ir.CompilerIrInstr.Gep _ _ _ _)
        (opt-fill-call-scan-body instrs (+ index 1) last iphi found)]
      [(ir.CompilerIrInstr.BinOp _ op _ _ _)
        (if (opt-fill-call-binop-ok? op)
          (opt-fill-call-scan-body instrs (+ index 1) last iphi found)
          (OptFillCallMaybeSite.No))]
      [_ (OptFillCallMaybeSite.No)])))

;; The body runs ONCE after the rewrite instead of once per slot, so an
;; operation that can fault must not appear in it: a division whose divisor
;; only reaches zero on a later index would fault in the loop and not in the
;; call. Every other BinOp is total.
(define (opt-fill-call-binop-ok? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Div) false]
    [(ir.CompilerIrBinOp.Mod) false]
    [(ir.CompilerIrBinOp.SafeDiv) false]
    [(ir.CompilerIrBinOp.SafeMod) false]
    [_ true]))

;; Locate `ptr-var`'s defining `gep base, iphi` and check the base is
;; loop-invariant (defined outside the block).
(define (opt-fill-call-gep-of
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [ptr-var : i64]
  [iphi : i64]) : OptFillCallMaybeSite
  (if (>= index last)
    (OptFillCallMaybeSite.No)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Gep dst base offset _)
        (if (not (= dst ptr-var))
          (opt-fill-call-gep-of instrs (+ index 1) last ptr-var iphi)
          (match offset
            [(ir.CompilerIrValue.Var offset-var)
              (if (and
                (= offset-var iphi)
                (not
                  (opt-used-contains
                    (opt-unroll-block-defs
                      instrs.slots
                      0
                      last
                      (opt_i64_i64_map.with-capacity 32))
                    (opt-fill-call-value-var base))))
                (OptFillCallMaybeSite.Some
                  (OptFillCallSite index index base 0 (ast.AstType.I64)))
                (OptFillCallMaybeSite.No))]
            [_ (OptFillCallMaybeSite.No)]))]
      [_ (opt-fill-call-gep-of instrs (+ index 1) last ptr-var iphi)])))

;; -1 for a non-Var value: never a block-local definition, so always invariant.
(define (opt-fill-call-value-var [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var id) id]
    [_ (- 0 1)]))

;; Only `inext` (whose exit value the rewrite materialises as `bound`) and the
;; loop compare (which keeps computing `bound < bound` = false) may be observed
;; from outside the block; every other in-block definition would change value.
(define (opt-fill-call-escape-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [last : i64]
  [outside : opt_i64_i64_map.Map]
  [inext : i64]
  [cond-var : i64]) : bool
  (if (>= index last)
    true
    (let
      [dst : i64
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Phi d _ _) d]
          [(ir.CompilerIrInstr.Mov d _ _) d]
          [(ir.CompilerIrInstr.Gep d _ _ _) d]
          [(ir.CompilerIrInstr.BinOp d _ _ _ _) d]
          [_ (- 0 1)])]
      (if (and
        (>= dst 0)
        (opt-used-contains outside dst)
        (not (= dst cond-var))
        (not (= (opt-unroll-resolve-copy instrs phi-count last dst 16) inext)))
        false
        (opt-fill-call-escape-ok?
          instrs
          (+ index 1)
          phi-count
          last
          outside
          inext
          cond-var)))))

(define (opt-fill-call-outside-uses
  [blocks : ir.CompilerIrBlockList]
  [skip-label : i64]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-fill-call-outside-uses
            (__tl-box-place rest)
            skip-label
            (if (= label skip-label)
              set
              (opt-collect-instr-seq-uses set instrs)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-fill-call-outside-uses
        (ir.compiler-ir-block-seq-to-list seq)
        skip-label
        set)]))

;; Rebuild one phi without its self-edge input.
(define (opt-fill-call-phi-drop-self
  [inputs : ir.CompilerIrPhiInputList]
  [self-label : i64]) : ir.CompilerIrPhiInputList
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (= label self-label)
        (opt-fill-call-phi-drop-self (__tl-box-place rest) self-label)
        (ir.compiler-ir-phi-input-cons-linked
          value
          label
          (opt-fill-call-phi-drop-self (__tl-box-place rest) self-label)))]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-fill-call-phi-drop-self
        (ir.compiler-ir-phi-input-seq-to-list seq)
        self-label)]))

(define (opt-fill-call-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-mem-fill8))

(define (opt-fill-call-alloc-var [cell : (__tl_dyn-array i64)]) : i64
  (let
    [next : i64 (array-ref cell 0)]
    (begin
      (set! (array-ref cell 0) (+ next 1))
      next)))

(define (opt-fill-call-emit-body!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [last : i64]
  [shape : OptFillCallShape]
  [site : OptFillCallSite]
  [frame-cell : (__tl_dyn-array i64)]) : unit
  (if (>= index last)
    unit
    (begin
      (if (= index site.store-index)
        ;; The store becomes the fill call. The slot count is `bound - seed`
        ;; and the recognizer pinned the seed to literal 0, so it is exactly
        ;; `bound` -- no subtract is emitted.
        (let
          [call-var : i64 (opt-fill-call-alloc-var frame-cell)]
          [ptr : ir.CompilerIrValue
            (match (ir.compiler-ir-instr-seq-ref instrs site.store-index)
              [(ir.CompilerIrInstr.StorePtr p _ _) p]
              [_ (ir.CompilerIrValue.I64 0)])]
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Call
              call-var
              (opt-fill-call-symbol)
              (ir.compiler-ir-call-args-array
                (ir.compiler-ir-value-cons
                  ptr
                  (ir.compiler-ir-value-cons
                    shape.bound
                    (ir.compiler-ir-value-cons
                      (ir.CompilerIrValue.I64 site.value)
                      ir.CompilerIrValueList.Nil))))
              (ast.AstType.Unit))))
        ;; the counter's `next` is redefined as its exit value, `bound`
        (if (opt-fill-call-defines-inext? instrs index shape.inext)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Mov shape.inext shape.bound shape.ity))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.compiler-ir-instr-seq-ref instrs index))))
      (opt-fill-call-emit-body!
        (&mut builder)
        instrs
        (+ index 1)
        phi-count
        last
        shape
        site
        frame-cell))))

(define (opt-fill-call-defines-inext?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [inext : i64]) : bool
  (match (ir.compiler-ir-instr-seq-ref instrs index)
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) (= dst inext)]
    [_ false]))

(define (opt-fill-call-emit-phis!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [self-label : i64]) : unit
  (if (>= index phi-count)
    unit
    (begin
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Phi dst inputs ty)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Phi
              dst
              (ir.compiler-ir-phi-input-list-compact
                (opt-fill-call-phi-drop-self inputs self-label))
              ty))]
        [_
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.compiler-ir-instr-seq-ref instrs index))])
      (opt-fill-call-emit-phis!
        (&mut builder)
        instrs
        (+ index 1)
        phi-count
        self-label))))

(define (opt-fill-call-rewrite-block
  [block : ir.CompilerIrBlock]
  [shape : OptFillCallShape]
  [site : OptFillCallSite]
  [frame-cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [phi-count : i64 shape.phi-count]
        [builder : ir.CompilerIrInstrBuilder
          (ir.compiler-ir-instr-builder-with-capacity (+ count 2))]
        (begin
          (opt-fill-call-emit-phis! (&mut builder) instrs 0 phi-count label)
          (opt-fill-call-emit-body!
            (&mut builder)
            instrs
            phi-count
            phi-count
            (- count 1)
            shape
            site
            frame-cell)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Jump shape.exit-label))
          (ir.CompilerIrBlock.Block
            label
            (ir.compiler-ir-instr-builder-to-seq builder))))]))

(defenum OptFillCallMaybeShapeSite
  (No)
  (Some OptFillCallShape OptFillCallSite))

;; `outside` is only built once the cheap structural checks have passed, so the
;; whole-function use scan is paid per CANDIDATE block, not per block.
(define (opt-fill-call-block-match
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [block : ir.CompilerIrBlock]) : OptFillCallMaybeShapeSite
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (match (opt-fill-call-shape entry-label block)
        [(OptFillCallMaybeShape.No) (OptFillCallMaybeShapeSite.No)]
        [(OptFillCallMaybeShape.Some shape)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [last : i64 (- count 1)]
            [prefix : String (opt-fill-call-versioned-prefix label)]
            (if (not
              (opt-fill-call-pred-in-version-namespace?
                blocks
                prefix
                shape.pred-label))
              (OptFillCallMaybeShapeSite.No)
              (match (opt-fill-call-scan-body
                instrs
                shape.phi-count
                last
                shape.iphi
                (OptFillCallMaybeSite.No))
                [(OptFillCallMaybeSite.No) (OptFillCallMaybeShapeSite.No)]
                [(OptFillCallMaybeSite.Some site)
                  (if (opt-fill-call-escape-ok?
                    instrs
                    0
                    shape.phi-count
                    last
                    (opt-fill-call-outside-uses
                      blocks
                      label
                      (opt_i64_i64_map.with-capacity 64))
                    shape.inext
                    shape.cond-var)
                    (OptFillCallMaybeShapeSite.Some shape site)
                    (OptFillCallMaybeShapeSite.No))])))])]))

(define (opt-fill-call-rewrite-blocks
  [all-blocks : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [changed-cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (match (opt-fill-call-block-match all-blocks entry-label block)
          [(OptFillCallMaybeShapeSite.No) block]
          [(OptFillCallMaybeShapeSite.Some shape site)
            (begin
              (set! (array-ref changed-cell 0) 1)
              (opt-fill-call-rewrite-block block shape site frame-cell))])
        (opt-fill-call-rewrite-blocks
          all-blocks
          (__tl-box-place rest)
          entry-label
          frame-cell
          changed-cell))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-fill-call-rewrite-blocks
        all-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        entry-label
        frame-cell
        changed-cell)]))

(define (opt-fill-call-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [frame-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
            [changed-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
            [_seed : unit (set! (array-ref frame-cell 0) frame)]
            [_seed2 : unit (set! (array-ref changed-cell 0) 0)]
            [rewritten : ir.CompilerIrBlockList
              (opt-fill-call-rewrite-blocks
                blocks
                blocks
                (opt-cfg-entry-label blocks)
                frame-cell
                changed-cell)]
            (if (= (array-ref changed-cell 0) 0)
              (OptFunctionCtxResult.Result func context)
              (let
                [next : ir.CompilerIrFunction
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret-ty
                    (array-ref frame-cell 0)
                    rewritten)]
                [next-context : OptCfgContext
                  (opt-cfg-context-build (opt-function-blocks next))]
                (match (opt-verify-function-with-context next next-context)
                  [(ResultCompilerOptimizeVerify.Ok)
                    (OptFunctionCtxResult.Result next next-context)]
                  [(ResultCompilerOptimizeVerify.Err _)
                    (OptFunctionCtxResult.Result func context)]))))])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

;; Standalone driver for tests and ad-hoc runs.
(define (opt-fill-call-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-fill-call-function-with-context-result
    (opt-cfg-context-build (opt-function-blocks func))
    false
    func)
    [(OptFunctionCtxResult.Result out _) out]))

;; --- byte copy -> tl_mem_copy_fwd (copy_call) ---------------------------------
;;
;; A counted loop whose whole body is `dst[i] = src[i]` on ONE-BYTE elements
;; becomes one `tl_mem_copy_fwd(&dst[i0], &src[i0], bound)` call. This is the
;; STORE-side companion to the byte-compose load fold: where that one widens a
;; shift/or tree of narrow LOADS into a single wide load, this one widens a
;; whole loop of narrow STORES -- the corpus copies behind `byte_buf.to-string`
;; and every hand-written `string -> byte vector` loop -- into the runtime's
;; word-at-a-time copy. The element-wise loop costs 3.5 instructions per byte
;; after the x2 unroller has had it (two loads, two stores, an add, a compare
;; and a branch per two bytes); the helper's `rep movsq` is charged one
;; instruction per EIGHT bytes by the deterministic instruction-count gate, and
;; the unroller never sees the loop at all because this pass runs ahead of it,
;; next to fill_call.
;;
;; WHY THE HELPER AND NOT `tl_memcpy`: `tl_memcpy` is memmove -- it copies
;; BACKWARD when the destination overlaps and sits above the source -- and a
;; wide forward copy is likewise not this loop. A forward byte loop over
;; `src < dst < src + n` PROPAGATES: it re-reads bytes it has just written, and
;; neither memmove nor a word-at-a-time forward copy reproduces that.
;; `tl_mem_copy_fwd` is written to BE the loop for every argument triple (see
;; its header in compiler_backend_runtime_linux.tl): it takes the wide path only
;; when `dst <= src` or the ranges are disjoint -- the two cases where reading
;; ahead of the write cannot matter -- and is a plain `rep movsb`, forward and
;; byte-granular, otherwise. That TOTAL equivalence is what lets this pass fire
;; without proving anything about aliasing, which no analysis here could do:
;; both pointers are opaque loads in every real instance.
;;
;; WHY IT IS SOUND TO DROP THE BOUNDS CHECKS: the call touches EXACTLY the byte
;; addresses the loop touched, in the same order, with the same values, so it
;; adds no fault site of its own -- a strictly stronger position than fill_call,
;; which has to argue about the slots it writes. What this pass still needs from
;; the versioner is the TRIP COUNT, and it takes it the same way fill_call does:
;; by rewriting ONLY a `__bce_fast` clone whose single non-self predecessor is
;; in that loop's own `__bce_guard` namespace. The body of a rotated do-while
;; runs ONCE before any compare, so a loop entered with `seed >= bound` copies
;; one byte that the call (which writes nothing for a non-positive count) would
;; not; the guard's `seed < bound` is what rules that out. The CHECKED original
;; is left untouched, so a program that would abort mid-copy still takes that
;; path and still aborts at the same element.
;;
;; ONE-BYTE ELEMENTS ONLY. The count handed to the helper is the loop's `bound`
;; read as a BYTE count, which is only the element count when the element is a
;; byte. It is also the soundness line for overlap: an eight-byte element loop
;; copies each element atomically, which a byte-granular forward copy does not
;; reproduce when the overlap is not a multiple of eight.
;;
;; The rewrite keeps the block and every other instruction in it, exactly as
;; fill_call does: it drops the self-edge phi inputs (so the body computes its
;; FIRST-iteration values, which is what makes the kept address geps spell the
;; two range starts), replaces the store with the call, redefines the counter's
;; `next` as its exit value `bound`, and ends with a Jump. The load stays; it
;; reads one in-range byte once and DCE takes it when it is dead.
(defstruct OptCopyCallSite
  (store-index i64)
  (dst-ptr ir.CompilerIrValue)
  (src-ptr ir.CompilerIrValue))

(defenum OptCopyCallMaybeSite
  (No)
  (Some OptCopyCallSite))

;; Element width one. `rep movsb`'s granularity, and the width at which a
;; forward byte copy and the source loop agree under every overlap.
(define (opt-copy-call-byte-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.U8) true]
    [(ast.AstType.I8) true]
    [_ false]))

;; The body must be exactly one `store_ptr <gep(base, i)>, <load <gep(base, i)>>`
;; on byte elements, plus copies, address arithmetic and the counter's own
;; arithmetic. A BoundsCheck, a second store, a call or anything else rejects --
;; the check because it would mean the clone is not the check-free copy this
;; pass reasons about.
(define (opt-copy-call-scan-body
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [iphi : i64]
  [found : OptCopyCallMaybeSite]) : OptCopyCallMaybeSite
  (if (>= index last)
    found
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.StorePtr ptr value ty)
        (match found
          [(OptCopyCallMaybeSite.Some _) (OptCopyCallMaybeSite.No)]
          [(OptCopyCallMaybeSite.No)
            (match ptr
              [(ir.CompilerIrValue.Var ptr-var)
                (match value
                  [(ir.CompilerIrValue.Var value-var)
                    (if (not
                      (and
                        (opt-copy-call-byte-type? ty)
                        (opt-copy-call-gep-tracks? instrs 0 last ptr-var iphi)))
                      (OptCopyCallMaybeSite.No)
                      (match (opt-copy-call-load-ptr instrs 0 index value-var)
                        [(ir.CompilerIrValue.Var src-var)
                          (if (opt-copy-call-gep-tracks?
                            instrs
                            0
                            last
                            src-var
                            iphi)
                            (opt-copy-call-scan-body
                              instrs
                              (+ index 1)
                              last
                              iphi
                              (OptCopyCallMaybeSite.Some
                                (OptCopyCallSite
                                  index
                                  ptr
                                  (ir.CompilerIrValue.Var src-var))))
                            (OptCopyCallMaybeSite.No))]
                        [_ (OptCopyCallMaybeSite.No)]))]
                  [_ (OptCopyCallMaybeSite.No)])]
              [_ (OptCopyCallMaybeSite.No)])])]
      [(ir.CompilerIrInstr.Load _ _ ty)
        (if (opt-copy-call-byte-type? ty)
          (opt-copy-call-scan-body instrs (+ index 1) last iphi found)
          (OptCopyCallMaybeSite.No))]
      [(ir.CompilerIrInstr.Mov _ _ _)
        (opt-copy-call-scan-body instrs (+ index 1) last iphi found)]
      [(ir.CompilerIrInstr.Gep _ _ _ _)
        (opt-copy-call-scan-body instrs (+ index 1) last iphi found)]
      [(ir.CompilerIrInstr.BinOp _ op _ _ _)
        (if (opt-fill-call-binop-ok? op)
          (opt-copy-call-scan-body instrs (+ index 1) last iphi found)
          (OptCopyCallMaybeSite.No))]
      [_ (OptCopyCallMaybeSite.No)])))

;; The pointer operand of the byte Load that defines `value-var`, searched only
;; BEFORE the store so the read is the one the store consumes. A non-Var result
;; (including "not found") rejects at the call site.
(define (opt-copy-call-load-ptr
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [store-index : i64]
  [value-var : i64]) : ir.CompilerIrValue
  (if (>= index store-index)
    (ir.CompilerIrValue.I64 0)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Load dst ptr ty)
        (if (and (= dst value-var) (opt-copy-call-byte-type? ty))
          ptr
          (opt-copy-call-load-ptr instrs (+ index 1) store-index value-var))]
      [_ (opt-copy-call-load-ptr instrs (+ index 1) store-index value-var)])))

;; `ptr-var` must be `gep base, <index>` with a ONE-BYTE element, a
;; loop-invariant base, and an index that advances exactly with the counter:
;; the counter itself, or `invariant + counter` in either operand order. That is
;; what makes address(i) = address(0) + i, hence what makes one contiguous copy
;; of `bound` bytes from address(0) the loop.
(define (opt-copy-call-gep-tracks?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [ptr-var : i64]
  [iphi : i64]) : bool
  (if (>= index last)
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Gep dst base offset elem-ty)
        (if (not (= dst ptr-var))
          (opt-copy-call-gep-tracks? instrs (+ index 1) last ptr-var iphi)
          (let
            [defs : opt_i64_i64_map.Map
              (opt-unroll-block-defs
                instrs.slots
                0
                last
                (opt_i64_i64_map.with-capacity 32))]
            (and
              (opt-copy-call-byte-type? elem-ty)
              (not (opt-used-contains defs (opt-fill-call-value-var base)))
              (opt-copy-call-index-tracks? instrs 0 last offset iphi defs))))]
      [_ (opt-copy-call-gep-tracks? instrs (+ index 1) last ptr-var iphi)])))

(define (opt-copy-call-index-tracks?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [offset : ir.CompilerIrValue]
  [iphi : i64]
  [defs : opt_i64_i64_map.Map]) : bool
  (match offset
    [(ir.CompilerIrValue.Var offset-var)
      (if (= offset-var iphi)
        true
        (opt-copy-call-offset-add? instrs index last offset-var iphi defs))]
    [_ false]))

;; `offset-var = add invariant, counter` (either operand order), defined in this
;; block. A step other than the counter, or an addend the block itself defines,
;; rejects.
(define (opt-copy-call-offset-add?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [offset-var : i64]
  [iphi : i64]
  [defs : opt_i64_i64_map.Map]) : bool
  (if (>= index last)
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
        (if (not (= dst offset-var))
          (opt-copy-call-offset-add?
            instrs
            (+ index 1)
            last
            offset-var
            iphi
            defs)
          (match op
            [(ir.CompilerIrBinOp.Add)
              (or
                (opt-copy-call-add-pair? lhs rhs iphi defs)
                (opt-copy-call-add-pair? rhs lhs iphi defs))]
            [_ false]))]
      [_
        (opt-copy-call-offset-add? instrs (+ index 1) last offset-var iphi defs)])))

;; `counter` on one side, a value the block does not define on the other.
(define (opt-copy-call-add-pair?
  [counter-side : ir.CompilerIrValue]
  [other-side : ir.CompilerIrValue]
  [iphi : i64]
  [defs : opt_i64_i64_map.Map]) : bool
  (match counter-side
    [(ir.CompilerIrValue.Var v)
      (and
        (= v iphi)
        (not (opt-used-contains defs (opt-fill-call-value-var other-side))))]
    [_ false]))

;; Same rule as `opt-fill-call-escape-ok?` -- only `inext` (materialised as
;; `bound`) and the loop compare (which keeps computing `bound < bound` = false)
;; may be observed from outside the block -- but it must ALSO cover Load, which
;; this pass's body scan admits and fill_call's never sees. The kept load runs
;; once at the seed index, so its result is the FIRST iteration's byte where the
;; loop left the LAST one; an outside use (directly, or through an exit phi
;; naming it) would read the wrong byte, so it rejects.
(define (opt-copy-call-escape-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [last : i64]
  [outside : opt_i64_i64_map.Map]
  [inext : i64]
  [cond-var : i64]) : bool
  (if (>= index last)
    true
    (let
      [dst : i64
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Phi d _ _) d]
          [(ir.CompilerIrInstr.Mov d _ _) d]
          [(ir.CompilerIrInstr.Gep d _ _ _) d]
          [(ir.CompilerIrInstr.Load d _ _) d]
          [(ir.CompilerIrInstr.BinOp d _ _ _ _) d]
          [_ (- 0 1)])]
      (if (and
        (>= dst 0)
        (opt-used-contains outside dst)
        (not (= dst cond-var))
        (not (= (opt-unroll-resolve-copy instrs phi-count last dst 16) inext)))
        false
        (opt-copy-call-escape-ok?
          instrs
          (+ index 1)
          phi-count
          last
          outside
          inext
          cond-var)))))

(define (opt-copy-call-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-mem-copy-fwd))

(define (opt-copy-call-emit-body!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [last : i64]
  [shape : OptFillCallShape]
  [site : OptCopyCallSite]
  [frame-cell : (__tl_dyn-array i64)]) : unit
  (if (>= index last)
    unit
    (begin
      (if (= index site.store-index)
        ;; The store becomes the copy call. The byte count is `bound - seed`
        ;; and the recognizer pinned the seed to literal 0, so it is exactly
        ;; `bound` -- no subtract is emitted.
        (let
          [call-var : i64 (opt-fill-call-alloc-var frame-cell)]
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Call
              call-var
              (opt-copy-call-symbol)
              (ir.compiler-ir-call-args-array
                (ir.compiler-ir-value-cons
                  site.dst-ptr
                  (ir.compiler-ir-value-cons
                    site.src-ptr
                    (ir.compiler-ir-value-cons
                      shape.bound
                      ir.CompilerIrValueList.Nil))))
              (ast.AstType.Unit))))
        ;; the counter's `next` is redefined as its exit value, `bound`
        (if (opt-fill-call-defines-inext? instrs index shape.inext)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Mov shape.inext shape.bound shape.ity))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.compiler-ir-instr-seq-ref instrs index))))
      (opt-copy-call-emit-body!
        (&mut builder)
        instrs
        (+ index 1)
        phi-count
        last
        shape
        site
        frame-cell))))

(define (opt-copy-call-rewrite-block
  [block : ir.CompilerIrBlock]
  [shape : OptFillCallShape]
  [site : OptCopyCallSite]
  [frame-cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [phi-count : i64 shape.phi-count]
        [builder : ir.CompilerIrInstrBuilder
          (ir.compiler-ir-instr-builder-with-capacity (+ count 2))]
        (begin
          (opt-fill-call-emit-phis! (&mut builder) instrs 0 phi-count label)
          (opt-copy-call-emit-body!
            (&mut builder)
            instrs
            phi-count
            phi-count
            (- count 1)
            shape
            site
            frame-cell)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Jump shape.exit-label))
          (ir.CompilerIrBlock.Block
            label
            (ir.compiler-ir-instr-builder-to-seq builder))))]))

(defenum OptCopyCallMaybeShapeSite
  (No)
  (Some OptFillCallShape OptCopyCallSite))

;; The counted-loop recognizer is fill_call's -- seed 0, step 1, invariant
;; bound, `__bce_fast` clone entered only from its own `__bce_guard` namespace --
;; because both rewrites need exactly those facts and sharing it means they
;; cannot drift apart. Only the BODY recognizer differs.
(define (opt-copy-call-block-match
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [block : ir.CompilerIrBlock]) : OptCopyCallMaybeShapeSite
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (match (opt-fill-call-shape entry-label block)
        [(OptFillCallMaybeShape.No) (OptCopyCallMaybeShapeSite.No)]
        [(OptFillCallMaybeShape.Some shape)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [last : i64 (- count 1)]
            [prefix : String (opt-fill-call-versioned-prefix label)]
            (if (not
              (opt-fill-call-pred-in-version-namespace?
                blocks
                prefix
                shape.pred-label))
              (OptCopyCallMaybeShapeSite.No)
              (match (opt-copy-call-scan-body
                instrs
                shape.phi-count
                last
                shape.iphi
                (OptCopyCallMaybeSite.No))
                [(OptCopyCallMaybeSite.No) (OptCopyCallMaybeShapeSite.No)]
                [(OptCopyCallMaybeSite.Some site)
                  (if (opt-copy-call-escape-ok?
                    instrs
                    0
                    shape.phi-count
                    last
                    (opt-fill-call-outside-uses
                      blocks
                      label
                      (opt_i64_i64_map.with-capacity 64))
                    shape.inext
                    shape.cond-var)
                    (OptCopyCallMaybeShapeSite.Some shape site)
                    (OptCopyCallMaybeShapeSite.No))])))])]))

(define (opt-copy-call-rewrite-blocks
  [all-blocks : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [changed-cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (match (opt-copy-call-block-match all-blocks entry-label block)
          [(OptCopyCallMaybeShapeSite.No) block]
          [(OptCopyCallMaybeShapeSite.Some shape site)
            (begin
              (set! (array-ref changed-cell 0) 1)
              (opt-copy-call-rewrite-block block shape site frame-cell))])
        (opt-copy-call-rewrite-blocks
          all-blocks
          (__tl-box-place rest)
          entry-label
          frame-cell
          changed-cell))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-copy-call-rewrite-blocks
        all-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        entry-label
        frame-cell
        changed-cell)]))

(define (opt-copy-call-function-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [frame-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
            [changed-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
            [_seed : unit (set! (array-ref frame-cell 0) frame)]
            [_seed2 : unit (set! (array-ref changed-cell 0) 0)]
            [rewritten : ir.CompilerIrBlockList
              (opt-copy-call-rewrite-blocks
                blocks
                blocks
                (opt-cfg-entry-label blocks)
                frame-cell
                changed-cell)]
            (if (= (array-ref changed-cell 0) 0)
              (OptFunctionCtxResult.Result func context)
              (let
                [next : ir.CompilerIrFunction
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret-ty
                    (array-ref frame-cell 0)
                    rewritten)]
                [next-context : OptCfgContext
                  (opt-cfg-context-build (opt-function-blocks next))]
                (match (opt-verify-function-with-context next next-context)
                  [(ResultCompilerOptimizeVerify.Ok)
                    (OptFunctionCtxResult.Result next next-context)]
                  [(ResultCompilerOptimizeVerify.Err _)
                    (OptFunctionCtxResult.Result func context)]))))])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

;; Standalone driver for tests and ad-hoc runs.
(define (opt-copy-call-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-copy-call-function-with-context-result
    (opt-cfg-context-build (opt-function-blocks func))
    false
    func)
    [(OptFunctionCtxResult.Result out _) out]))

;; --- constant-trip full unrolling ---------------------------------------------
;;
;; A rotated single-block self-loop whose counter phi has a LITERAL seed, a
;; LITERAL step (add/sub by a literal), and a LITERAL bound reached by an
;; ordered compare runs an exact, statically computable number of times
;; whenever its header is entered: the branch sits at the end of the block, so
;; entering the loop implies at least one trip, and every trip's continue
;; decision is a pure function of the simulated counter. Such a loop is
;; replaced by its `trips` straight-line body copies -- no remainder loop --
;; plus, when the body's BoundsChecks form derivable counter-affine groups,
;; a pre-body guard replacing the grouped checks (the "consolidated
;; bounds-check guard" section below; the plain form described here is the
;; fallback when no group derives). Unlike the x16 arm this is exact rather
;; than a profitability bet: the trip count is invariant, so the copies are
;; precisely the iterations the loop would have run.
;;
;; Soundness:
;; - The trip count is simulated with the counter's own integer type
;;   (wrapping add/sub normalized per trip) and the compare's own type, so
;;   wraparound and signed/unsigned comparisons decide exactly what the
;;   literal loop would decide. A loop that does not settle within the
;;   16-trip cap is rejected, never guessed.
;; - The last copy keeps the original destinations and BoundsCheck labels, so
;;   uses of body values outside the loop (the rotated do-while exit reads the
;;   last trip's defs) resolve unchanged. The deleted defs (the phis and the
;;   loop-closing compare) must have no uses outside the loop block; exit-phi
;;   inputs name body defs, which survive.
;; - Body cloning reuses the x16 arm's whitelist (no calls, no allocations, no
;;   stores, no nested terminators), so every copy is pure straight-line code
;;   and earlier copies' BoundsCheck continuation labels are suffixed unique.
;; - Caps: trips <= 16 and body-instructions x trips <= 128 bound growth.
(defenum OptUnrollConstMaybeStep
  (No)
  ;; literal step (signed), dst of the add/sub that carries the counter.
  (Some i64 i64))

(defenum OptUnrollConstMaybeCond
  (No)
  ;; literal bound, ordered predicate (already operand-order normalized),
  ;; whether the compare reads the post-step value, compare type, cond def index.
  (Some i64 ir.CompilerIrBinOp bool ast.AstType i64))

(defstruct OptUnrollConstShape
  (exit-label i64)
  (phi-count i64)
  (cond-index i64)
  (iphi i64)
  (seed i64)
  (step i64)
  (trips i64)
  (ity ast.AstType)
  (others OptUnrollPhiList)
  (pred-label i64))

(defenum OptUnrollConstMaybeShape
  (No)
  (Some OptUnrollConstShape))

(define (opt-unroll-const-scalar-ty-tag [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 1]
    [(ast.AstType.I32) 2]
    [(ast.AstType.I16) 3]
    [(ast.AstType.I8) 4]
    [(ast.AstType.U64) 5]
    [(ast.AstType.U32) 6]
    [(ast.AstType.U16) 7]
    [(ast.AstType.U8) 8]
    [_ 0]))

(define (opt-unroll-const-compare
  [op : ir.CompilerIrBinOp]
  [a : i64]
  [b : i64]
  [ty : ast.AstType]) : bool
  (match op
    [(ir.CompilerIrBinOp.Lt) (opt-typed-lt? a b ty)]
    [(ir.CompilerIrBinOp.Le) (opt-typed-le? a b ty)]
    [(ir.CompilerIrBinOp.Gt) (opt-typed-gt? a b ty)]
    [(ir.CompilerIrBinOp.Ge) (opt-typed-ge? a b ty)]
    [_ false]))

;; Exact trip count for a literal counter loop, or -1 when the loop does not
;; settle within the 16-trip cap. `on-next?` selects whether the continue
;; compare reads the post-step value (the `ge %next, 0` shape) or the phi
;; itself. `c` and the compare operands are normalized to their instruction
;; types, matching the wrapping arithmetic and width of the emitted code.
(define (opt-unroll-const-trips
  [c : i64]
  [step : i64]
  [bound : i64]
  [op : ir.CompilerIrBinOp]
  [ity : ast.AstType]
  [cty : ast.AstType]
  [on-next? : bool]
  [n : i64]) : i64
  (if (> n 16)
    (- 0 1)
    (let
      [next : i64 (opt-normalize-int-to-i64 (+ c step) ity)]
      [v : i64
        (opt-normalize-int-to-i64
          (if on-next?
            next
            c)
          cty)]
      (if (opt-unroll-const-compare
        op
        v
        (opt-normalize-int-to-i64 bound cty)
        cty)
        (opt-unroll-const-trips next step bound op ity cty on-next? (+ n 1))
        n))))

;; The literal half of `lhs + rhs` when the other half resolves (through
;; same-block Mov copies) to the counter phi.
(define (opt-unroll-const-addend
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : option_i64.Option
  (match lhs
    [(ir.CompilerIrValue.Var x)
      (match rhs
        [(ir.CompilerIrValue.I64 k)
          (if (= (opt-unroll-resolve-copy instrs phi-count last x 16) iphi)
            (option_i64.Some k)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [(ir.CompilerIrValue.I64 k)
      (match rhs
        [(ir.CompilerIrValue.Var x)
          (if (= (opt-unroll-resolve-copy instrs phi-count last x 16) iphi)
            (option_i64.Some k)
            (option_i64.None))]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

;; The counter phi's back-edge must carry `counter +/- literal`; the add/sub
;; type must be the phi's own scalar type so the simulation's normalization is
;; exact (a narrower add would truncate the value the phi receives).
(define (opt-unroll-const-step-shape
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [iphi-tag : i64]
  [back : ir.CompilerIrValue]) : OptUnrollConstMaybeStep
  (match back
    [(ir.CompilerIrValue.Var back-id)
      (let
        [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
        [inext : i64 (opt-unroll-resolve-copy instrs phi-count last back-id 16)]
        [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
        (if (< inext-index 0)
          (OptUnrollConstMaybeStep.No)
          (match (ir.compiler-ir-instr-seq-ref instrs inext-index)
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs sty)
              (if (!= (opt-unroll-const-scalar-ty-tag sty) iphi-tag)
                (OptUnrollConstMaybeStep.No)
                (match op
                  [(ir.CompilerIrBinOp.Add)
                    (match (opt-unroll-const-addend
                      instrs
                      phi-count
                      last
                      iphi
                      lhs
                      rhs)
                      [(option_i64.Some k)
                        (OptUnrollConstMaybeStep.Some k inext)]
                      [(option_i64.None) (OptUnrollConstMaybeStep.No)])]
                  [(ir.CompilerIrBinOp.Sub)
                    (match lhs
                      [(ir.CompilerIrValue.Var x)
                        (match rhs
                          [(ir.CompilerIrValue.I64 k)
                            (if (=
                              (opt-unroll-resolve-copy
                                instrs
                                phi-count
                                last
                                x
                                16)
                              iphi)
                              (OptUnrollConstMaybeStep.Some (- 0 k) inext)
                              (OptUnrollConstMaybeStep.No))]
                          [_ (OptUnrollConstMaybeStep.No)])]
                      [_ (OptUnrollConstMaybeStep.No)])]
                  [_ (OptUnrollConstMaybeStep.No)]))]
            [_ (OptUnrollConstMaybeStep.No)])))]
    [_ (OptUnrollConstMaybeStep.No)]))

(define (opt-unroll-const-swap-compare [op : ir.CompilerIrBinOp]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Lt) (ir.CompilerIrBinOp.Gt)]
    [(ir.CompilerIrBinOp.Gt) (ir.CompilerIrBinOp.Lt)]
    [(ir.CompilerIrBinOp.Le) (ir.CompilerIrBinOp.Ge)]
    [(ir.CompilerIrBinOp.Ge) (ir.CompilerIrBinOp.Le)]
    [_ op]))

;; The loop-closing compare must be `counter <op> literal` (either operand
;; order, counter read before or after the step) with an ordered predicate.
(define (opt-unroll-const-cond-finish
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [inext : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [cty : ast.AstType]
  [cond-index : i64]) : OptUnrollConstMaybeCond
  (match lhs
    [(ir.CompilerIrValue.Var lv)
      (match rhs
        [(ir.CompilerIrValue.I64 bound)
          (let
            [resolved : i64
              (opt-unroll-resolve-copy instrs phi-count last lv 16)]
            (cond
              [(= resolved inext)
                (OptUnrollConstMaybeCond.Some bound op true cty cond-index)]
              [(= resolved iphi)
                (OptUnrollConstMaybeCond.Some bound op false cty cond-index)]
              [else (OptUnrollConstMaybeCond.No)]))]
        [_ (OptUnrollConstMaybeCond.No)])]
    [(ir.CompilerIrValue.I64 bound)
      (match rhs
        [(ir.CompilerIrValue.Var rv)
          (let
            [resolved : i64
              (opt-unroll-resolve-copy instrs phi-count last rv 16)]
            [swapped : ir.CompilerIrBinOp (opt-unroll-const-swap-compare op)]
            (cond
              [(= resolved inext)
                (OptUnrollConstMaybeCond.Some bound swapped true cty cond-index)]
              [(= resolved iphi)
                (OptUnrollConstMaybeCond.Some
                  bound
                  swapped
                  false
                  cty
                  cond-index)]
              [else (OptUnrollConstMaybeCond.No)]))]
        [_ (OptUnrollConstMaybeCond.No)])]
    [_ (OptUnrollConstMaybeCond.No)]))

(define (opt-unroll-const-cond-shape
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [iphi : i64]
  [inext : i64]) : OptUnrollConstMaybeCond
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [cond-index : i64 (opt-unroll-def-index slots phi-count last cond-var)]
    (if (< cond-index 0)
      (OptUnrollConstMaybeCond.No)
      (match (ir.compiler-ir-instr-seq-ref instrs cond-index)
        [(ir.CompilerIrInstr.BinOp _ op lhs rhs cty)
          (if (not (opt-integer-type? cty))
            (OptUnrollConstMaybeCond.No)
            (match op
              [(ir.CompilerIrBinOp.Lt)
                (opt-unroll-const-cond-finish
                  instrs
                  phi-count
                  last
                  iphi
                  inext
                  op
                  lhs
                  rhs
                  cty
                  cond-index)]
              [(ir.CompilerIrBinOp.Le)
                (opt-unroll-const-cond-finish
                  instrs
                  phi-count
                  last
                  iphi
                  inext
                  op
                  lhs
                  rhs
                  cty
                  cond-index)]
              [(ir.CompilerIrBinOp.Gt)
                (opt-unroll-const-cond-finish
                  instrs
                  phi-count
                  last
                  iphi
                  inext
                  op
                  lhs
                  rhs
                  cty
                  cond-index)]
              [(ir.CompilerIrBinOp.Ge)
                (opt-unroll-const-cond-finish
                  instrs
                  phi-count
                  last
                  iphi
                  inext
                  op
                  lhs
                  rhs
                  cty
                  cond-index)]
              [_ (OptUnrollConstMaybeCond.No)]))]
        [_ (OptUnrollConstMaybeCond.No)]))))

(define (opt-unroll-const-outside-uses-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-const-outside-uses-instrs
      instrs
      (+ index 1)
      (opt-collect-instr-uses acc (ir.compiler-ir-instr-seq-ref instrs index)))))

(define (opt-unroll-const-outside-uses
  [blocks : ir.CompilerIrBlockList]
  [loop-label : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-unroll-const-outside-uses
            (__tl-box-place rest)
            loop-label
            (if (= label loop-label)
              acc
              (opt-unroll-const-outside-uses-instrs instrs 0 acc)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-const-outside-uses
        (ir.compiler-ir-block-seq-to-list seq)
        loop-label
        acc)]))

(define (opt-unroll-const-phi-dsts-outside-free?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [outside : opt_i64_i64_map.Map]) : bool
  (if (>= index phi-count)
    true
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst _ _)
        (if (opt-used-contains outside dst)
          false
          (opt-unroll-const-phi-dsts-outside-free?
            instrs
            (+ index 1)
            phi-count
            outside))]
      [_ false])))

;; The rewrite deletes the phis and the loop-closing compare, so none of those
;; defs may be read outside the loop block (body defs survive in the last copy
;; and need no check).
(define (opt-unroll-const-exit-uses-free?
  [blocks : ir.CompilerIrBlockList]
  [loop-label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [cond-var : i64]) : bool
  (let
    [outside : opt_i64_i64_map.Map
      (opt-unroll-const-outside-uses
        blocks
        loop-label
        (opt_i64_i64_map.with-capacity 64))]
    (and
      (not (opt-used-contains outside cond-var))
      (opt-unroll-const-phi-dsts-outside-free? instrs 0 phi-count outside))))

(define (opt-unroll-const-phi-scan
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [exit-label : i64]
  [index : i64]) : OptUnrollConstMaybeShape
  (if (>= index phi-count)
    (OptUnrollConstMaybeShape.No)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst inputs ity)
        (let
          [iphi-tag : i64 (opt-unroll-const-scalar-ty-tag ity)]
          (if (= iphi-tag 0)
            (opt-unroll-const-phi-scan
              blocks
              label
              instrs
              phi-count
              last
              cond-var
              exit-label
              (+ index 1))
            (match (opt-unroll-split-phi-inputs inputs label)
              [(OptUnrollPhiSplit.Split init back pred-label)
                (match init
                  [(ir.CompilerIrValue.I64 seed)
                    (match (opt-unroll-const-step-shape
                      instrs
                      phi-count
                      last
                      dst
                      iphi-tag
                      back)
                      [(OptUnrollConstMaybeStep.No)
                        (opt-unroll-const-phi-scan
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-var
                          exit-label
                          (+ index 1))]
                      [(OptUnrollConstMaybeStep.Some step inext)
                        (match (opt-unroll-const-cond-shape
                          instrs
                          phi-count
                          last
                          cond-var
                          dst
                          inext)
                          [(OptUnrollConstMaybeCond.No)
                            (opt-unroll-const-phi-scan
                              blocks
                              label
                              instrs
                              phi-count
                              last
                              cond-var
                              exit-label
                              (+ index 1))]
                          [(OptUnrollConstMaybeCond.Some
                              bound
                              op
                              on-next?
                              cty
                              cond-index)
                            (let
                              [trips : i64
                                (opt-unroll-const-trips
                                  (opt-normalize-int-to-i64 seed ity)
                                  step
                                  bound
                                  op
                                  ity
                                  cty
                                  on-next?
                                  1)]
                              (if (or
                                (< trips 1)
                                (> (* (- last phi-count) trips) 128))
                                (opt-unroll-const-phi-scan
                                  blocks
                                  label
                                  instrs
                                  phi-count
                                  last
                                  cond-var
                                  exit-label
                                  (+ index 1))
                                (match (opt-unroll-collect-other-phis
                                  instrs
                                  0
                                  phi-count
                                  label
                                  pred-label
                                  dst)
                                  [(OptUnrollMaybePhis.Some others)
                                    (if (opt-unroll-const-exit-uses-free?
                                      blocks
                                      label
                                      instrs
                                      phi-count
                                      cond-var)
                                      (OptUnrollConstMaybeShape.Some
                                        (OptUnrollConstShape
                                          exit-label
                                          phi-count
                                          cond-index
                                          dst
                                          (opt-normalize-int-to-i64 seed ity)
                                          step
                                          trips
                                          ity
                                          others
                                          pred-label))
                                      (opt-unroll-const-phi-scan
                                        blocks
                                        label
                                        instrs
                                        phi-count
                                        last
                                        cond-var
                                        exit-label
                                        (+ index 1)))]
                                  [(OptUnrollMaybePhis.No)
                                    (opt-unroll-const-phi-scan
                                      blocks
                                      label
                                      instrs
                                      phi-count
                                      last
                                      cond-var
                                      exit-label
                                      (+ index 1))])))])])]
                  [_
                    (opt-unroll-const-phi-scan
                      blocks
                      label
                      instrs
                      phi-count
                      last
                      cond-var
                      exit-label
                      (+ index 1))])]
              [(OptUnrollPhiSplit.No)
                (opt-unroll-const-phi-scan
                  blocks
                  label
                  instrs
                  phi-count
                  last
                  cond-var
                  exit-label
                  (+ index 1))])))]
      [_
        (opt-unroll-const-phi-scan
          blocks
          label
          instrs
          phi-count
          last
          cond-var
          exit-label
          (+ index 1))])))

(define (opt-unroll-const-block-shape
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [block : ir.CompilerIrBlock]) : OptUnrollConstMaybeShape
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          (OptUnrollConstMaybeShape.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (let
                    [last : i64 (- count 1)]
                    [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
                    (if (or
                      (!= then-label label)
                      (= else-label label)
                      (= label entry-label)
                      (< phi-count 1)
                      (< (- last phi-count) 2)
                      (not (opt-unroll-no-phi-from? instrs phi-count))
                      (not (opt-unroll-body-ok? instrs.slots phi-count last))
                      ;; the cond def is dropped from the copies, so the final
                      ;; branch must be its only use inside the block.
                      (opt-used-contains
                        (opt-unroll-uses-before
                          instrs
                          0
                          last
                          (opt_i64_i64_map.with-capacity 64))
                        cond-var)
                      ;; A versioned loop's original body is the cold checked
                      ;; fallback; growing it is cold-path bloat (same reason
                      ;; as the x16 arm).
                      (opt-cfg-block-exists?
                        blocks
                        (ir.compiler-ir-label
                          (str_cat.str-cat
                            (ir.compiler-ir-label-text label)
                            "__bce_fast"))))
                      (OptUnrollConstMaybeShape.No)
                      (opt-unroll-const-phi-scan
                        blocks
                        label
                        instrs
                        phi-count
                        last
                        cond-var
                        else-label
                        0)))]
                [_ (OptUnrollConstMaybeShape.No)])]
            [_ (OptUnrollConstMaybeShape.No)])))]))

;; Final-copy clone: substitute uses through the remap but keep the original
;; destinations and BoundsCheck continuation labels, so the loop's outside
;; uses (the rotated exit reads the last trip's defs) resolve unchanged.
(define (opt-unroll-const-keep-clone-instr
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov dst (opt-unroll-subst-value remap src) ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        dst
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        dst
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        dst
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp dst op (opt-unroll-subst-value remap src) ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        dst
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load dst (opt-unroll-subst-value remap src) ty)]
    [(ir.CompilerIrInstr.LaneId dst lanes ty)
      (ir.CompilerIrInstr.LaneId dst lanes ty)]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat
        dst
        (opt-unroll-subst-value remap value)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-bin-op
          dst
          op
          (opt-unroll-subst-value remap lhs)
          (opt-unroll-subst-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (ir.CompilerIrInstr.VectorReduce
        dst
        op
        (opt-unroll-subst-value remap src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-compare
          dst
          op
          (opt-unroll-subst-value remap lhs)
          (opt-unroll-subst-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        lanes)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-select
          dst
          (opt-unroll-subst-value remap mask)
          (opt-unroll-subst-value remap on-true)
          (opt-unroll-subst-value remap on-false)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorLoad dst base index lanes ty)
      (ir.CompilerIrInstr.VectorLoad
        dst
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap index)
        lanes
        ty)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-unroll-subst-value remap index)
        (opt-unroll-subst-value remap length)
        ok-label)]
    [_ instr]))

;; Before the last copy is cloned, its destinations must map to THEMSELVES:
;; the remap still holds the previous copy's fresh vars, but the final copy IS
;; the original body (its defs feed the exit), so a use of a body-defined var
;; resolves to the original var while the phi seeds (counter literal, chained
;; back values) keep their mappings. Phi destinations are prefix defs, outside
;; this range, so the reseed never touches them.
(define (opt-unroll-const-instr-dst-or
  [instr : ir.CompilerIrInstr]
  [fallback : i64]) : i64
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) dst]
    [(ir.CompilerIrInstr.Cast dst _ _ _) dst]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) dst]
    [(ir.CompilerIrInstr.Gep dst _ _ _) dst]
    [(ir.CompilerIrInstr.Load dst _ _) dst]
    [(ir.CompilerIrInstr.LaneId dst _ _) dst]
    [(ir.CompilerIrInstr.Splat dst _ _ _) dst]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (__tl-project-field (__tl-box-place payload-box) dst)]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (__tl-project-field (__tl-box-place payload-box) dst)]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _) dst]
    [(ir.CompilerIrInstr.Select payload-box)
      (__tl-project-field (__tl-box-place payload-box) dst)]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _) dst]
    [_ fallback]))

(define (opt-unroll-const-reseed-body-defs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : unit
  (if (>= index last)
    unit
    (let
      [dst : i64
        (opt-unroll-const-instr-dst-or
          (ir.compiler-ir-instr-seq-ref instrs index)
          (- 0 1))]
      (begin
        (if (>= dst 0)
          (opt-unroll-remap-set remap dst (ir.CompilerIrValue.Var dst))
          unit)
        (opt-unroll-const-reseed-body-defs instrs (+ index 1) last remap)))))

(define (opt-unroll-const-copy-body
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [skip : i64]
  [skips : (& skips opt_dense_i64_vec.Vec)]
  [full-rename? : bool]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [copy : i64]
  [trips : i64]) : ir.CompilerIrInstrList
  (if (>= index last)
    (ir.CompilerIrInstrList.Nil)
    (if (or
      (= index skip)
      (opt-unroll-const-guard-skips-contains? skips index 0))
      (opt-unroll-const-copy-body
        instrs
        (+ index 1)
        last
        skip
        skips
        full-rename?
        remap
        cell
        copy
        trips)
      (let
        [cloned : ir.CompilerIrInstr
          (if (and (= copy (- trips 1)) (not full-rename?))
            (opt-unroll-const-keep-clone-instr
              remap
              (ir.compiler-ir-instr-seq-ref instrs index))
            (opt-unroll-clone-instr
              remap
              cell
              copy
              (ir.compiler-ir-instr-seq-ref instrs index)))]
        (ir.compiler-ir-instr-cons
          cloned
          (opt-unroll-const-copy-body
            instrs
            (+ index 1)
            last
            skip
            skips
            full-rename?
            remap
            cell
            copy
            trips))))))

(define (opt-unroll-const-init-values [others : OptUnrollPhiList]) : ir.CompilerIrValueList
  (match others
    [(OptUnrollPhiList.Nil) (ir.CompilerIrValueList.Nil)]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi _ init _ _)
          (ir.compiler-ir-value-cons
            init
            (opt-unroll-const-init-values (__tl-box-place rest)))])]))

;; One body copy per simulated trip. The counter phi reads the literal counter
;; value of its trip; every other phi reads its init value on copy 0 and the
;; previous copy's remapped back-edge value afterwards (all seeds computed
;; before any is written, so phi-to-phi back edges see the pre-copy state).
(define (opt-unroll-const-copies
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-index : i64]
  [iphi : i64]
  [counter : i64]
  [step : i64]
  [ity : ast.AstType]
  [others : OptUnrollPhiList]
  [skips : (& skips opt_dense_i64_vec.Vec)]
  [full-rename? : bool]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [copy : i64]
  [trips : i64]) : ir.CompilerIrInstrList
  (if (>= copy trips)
    (ir.CompilerIrInstrList.Nil)
    (let
      [other-seeds : ir.CompilerIrValueList
        (if (= copy 0)
          (opt-unroll-const-init-values others)
          (opt-unroll-phi-chain-values remap others))]
      [_seed-counter : unit
        (opt-unroll-remap-set remap iphi (ir.CompilerIrValue.I64 counter))]
      [_seed-others : unit
        (opt-unroll-write-phi-seeds remap others other-seeds)]
      [_reseed : unit
        (if (and (= copy (- trips 1)) (not full-rename?))
          (opt-unroll-const-reseed-body-defs instrs phi-count last remap)
          unit)]
      [body : ir.CompilerIrInstrList
        (opt-unroll-const-copy-body
          instrs
          phi-count
          last
          cond-index
          skips
          full-rename?
          remap
          cell
          copy
          trips)]
      (opt-aggregate-instr-list-append
        body
        (opt-unroll-const-copies
          instrs
          phi-count
          last
          cond-index
          iphi
          (opt-normalize-int-to-i64 (+ counter step) ity)
          step
          ity
          others
          skips
          full-rename?
          remap
          cell
          (+ copy 1)
          trips)))))

(define (opt-unroll-const-replace-block
  [blocks : ir.CompilerIrBlockList]
  [loop-label : i64]
  [new-block : ir.CompilerIrBlock]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (ir.compiler-ir-block-cons
            (if (= label loop-label)
              new-block
              block)
            (opt-unroll-const-replace-block
              (__tl-box-place rest)
              loop-label
              new-block))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-const-replace-block
        (ir.compiler-ir-block-seq-to-list seq)
        loop-label
        new-block)]))

;; --- constant-trip unroll: consolidated bounds-check guard --------------------
;;
;; When the exact arm above unrolls a loop whose body carries BoundsCheck
;; instructions on indices affine in the loop counter, every trip copy keeps
;; its own check. For checks of the family `base + scale*counter + offset`
;; (Add/Sub/Mul-by-literal i64 chains; Mov copies and i64<->u64 reinterpret
;; casts transparent) with a loop-invariant base and a loop-invariant length,
;; the per-trip probes are ONE contiguous index family: trip j reads
;; `base + k_j` with k_j = scale*c_j + offset, and the simulated counter
;; literals c_j make every k_j known exactly (overflowing k arithmetic, an
;; underivable index, or a body-defined base/length makes the check
;; ungroupable instead). The arm then emits, on the loop's entry edge:
;;
;;   GUARD (one block): per distinct (base, length) group with k-range
;;     [kmin..kmax] and span S = kmax - kmin:
;;       gmin = base + kmin    (wrapping i64 add of the same base value,
;;       t    = length - gmin   matching the body's own wrapping ops)
;;       c1   = (u64)gmin < (u64)length
;;       c2   = (u64)t > (u64)S     (omitted when S = 0: it restates c1)
;;     gok  = the and of all group conditions; Branch gok FAST SLOW
;;   FAST: the trip copies with the grouped checks REMOVED. Checks that do
;;     not belong to a derivable group stay in the copies exactly as today
;;     (the guard never speaks for them). All copy destinations are fresh,
;;     so the slow loop below is the sole definition site of the original
;;     body vars.
;;   SLOW: the original loop, untouched apart from its phis' entry-edge
;;     inputs now naming the guard block, with all original checks and
;;     messages.
;;
;; Exactness: the guard passes IFF every point of the whole interval
;; [gmin, gmin + S] (mod 2^64) would pass the original u64 check, and the
;; grouped probes are a subset of that interval:
;;   * wrap(base + k_j) = wrap(gmin + (k_j - kmin)) with 0 <= k_j - kmin <= S
;;     (k_j, kmin, and kmax are exact i64 arithmetic, so S = kmax - kmin >= 0
;;     and the emitted i64 literal S reads as the same u64 span);
;;   * c1 && c2  =>  (u64)gmin < len, so t = len - gmin cannot wrap and c2
;;     gives len - gmin > S; every interval point then satisfies
;;     (u64)(gmin + d) = (u64)gmin + d <= (u64)gmin + S < len with no wrap in
;;     between. This direction needs NO assumption on length: a wrapped
;;     (negative-i64) base or length lands at huge u64 values and fails c1,
;;     or satisfies c1 only when the whole interval is in range.
;; So a passing guard implies no grouped check can abort, and the fast path
;; differs from the original only in checks that provably pass. A failing
;; guard runs the original loop, so every original check executes in
;; original order with its original abort message. Ungrouped checks left in
;; the fast copies abort exactly where they aborted originally: a passing
;; guard excludes aborts from earlier grouped checks, so the first aborting
;; check and its message are unchanged.
;;
;; The guard runs where the original first check would run (the entry edge),
;; is pure wrapping arithmetic (no traps, no side effects), and its
;; base/length uses dominate it: both are loop-invariant values whose defs
;; dominate the loop header, and the header's single outside edge is the one
;; being split. Body values used after the loop merge through fresh phis
;; prepended to the exit block (fast edge reads the last copy's renamed def,
;; slow edge reads the original); the loop block dominates every such use in
;; the input, and both new paths reach the exit only through the exit block,
;; so the phi block dominates every rewritten use. The `__bce_guard` /
;; `__bce_fast` labels make the rewritten loop ineligible to the const-trip,
;; x16, and bce_version scans on later pipeline rounds (their shared
;; freshness rule), so the slow loop is never re-versioned. Consolidation is
;; an economics call: the guard costs a handful of instructions per entry
;; while each removed check saves its compare per call, so the arm requires
;; trips >= 4, a phi-free exit block (the fast path adds a new exit
;; predecessor, and pre-existing phis would need fast-edge inputs this arm
;; does not synthesize), subst-rewritable exit instructions, and no
;; non-exit-block use of a body def.
;; Overflow-checked literal arithmetic for the recovery below: the
;; coefficients must stay mathematical (a wrapped scale or offset could
;; disguise an index expression the guard's interval argument does not
;; cover), so an overflow rejects the derivation.
(defenum OptUceKSum
  (No)
  (Some i64))

(define (opt-unroll-const-guard-k-add [a : i64] [b : i64]) : OptUceKSum
  (let
    [minimum : i64 (- (- 0 9223372036854775807) 1)]
    (if (or
      (and (> b 0) (> a (- 9223372036854775807 b)))
      (and (< b 0) (< a (- minimum b))))
      (OptUceKSum.No)
      (OptUceKSum.Some (+ a b)))))

(define (opt-unroll-const-guard-k-sub [a : i64] [b : i64]) : OptUceKSum
  (if (= b (- (- 0 9223372036854775807) 1))
    ;; a - INT_MIN = a + 2^63 is representable exactly when a < 0, and the
    ;; wrapping subtraction computes it.
    (if (< a 0)
      (OptUceKSum.Some (- a b))
      (OptUceKSum.No))
    (opt-unroll-const-guard-k-add a (- 0 b))))

(define (opt-unroll-const-guard-k-mul [a : i64] [b : i64]) : OptUceKSum
  (let
    [minimum : i64 (- (- 0 9223372036854775807) 1)]
    (cond
      [(= a 0) (OptUceKSum.Some 0)]
      [(= b 0) (OptUceKSum.Some 0)]
      [(= a 1) (OptUceKSum.Some b)]
      [(= b 1) (OptUceKSum.Some a)]
      [(= a minimum) (OptUceKSum.No)]
      [(= b minimum) (OptUceKSum.No)]
      [(= a (- 0 1)) (OptUceKSum.Some (- 0 b))]
      [(= b (- 0 1)) (OptUceKSum.Some (- 0 a))]
      [else
        (let
          [r : i64 (* a b)]
          (if (= (/ r a) b)
            (OptUceKSum.Some r)
            (OptUceKSum.No)))])))

;; Affine recovery result: invariant base var (-1 when the expression is a
;; pure counter/literal form), counter scale, literal offset.
(defenum OptUceAffine
  (No)
  (Some i64 i64 i64))

(define (opt-unroll-const-guard-reinterpret-cast?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (match from-ty
    [(ast.AstType.I64)
      (match to-ty
        [(ast.AstType.U64) true]
        [_ false])]
    [(ast.AstType.U64)
      (match to-ty
        [(ast.AstType.I64) true]
        [_ false])]
    [_ false]))

;; Two resolved subexpressions each contribute at most one base var; the sum
;; keeps the single base and rejects a second one (`2*base + counter` is not
;; a form the guard can rebuild). -2 reports the conflict.
(define (opt-unroll-const-guard-base-merge [left : i64] [right : i64]) : i64
  (if (< left 0)
    right
    (if (< right 0)
      left
      (- 0 2))))

(define (opt-unroll-const-guard-affine-binop
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [fuel : i64]) : OptUceAffine
  (match (opt-unroll-const-guard-affine instrs phi-count last iphi lhs fuel)
    [(OptUceAffine.No) (OptUceAffine.No)]
    [(OptUceAffine.Some base-l scale-l offset-l)
      (match (opt-unroll-const-guard-affine instrs phi-count last iphi rhs fuel)
        [(OptUceAffine.No) (OptUceAffine.No)]
        [(OptUceAffine.Some base-r scale-r offset-r)
          (match op
            [(ir.CompilerIrBinOp.Add)
              (let
                [base : i64 (opt-unroll-const-guard-base-merge base-l base-r)]
                (if (< base (- 0 1))
                  (OptUceAffine.No)
                  (match (opt-unroll-const-guard-k-add scale-l scale-r)
                    [(OptUceKSum.No) (OptUceAffine.No)]
                    [(OptUceKSum.Some scale)
                      (match (opt-unroll-const-guard-k-add offset-l offset-r)
                        [(OptUceKSum.No) (OptUceAffine.No)]
                        [(OptUceKSum.Some offset)
                          (OptUceAffine.Some base scale offset)])])))]
            [(ir.CompilerIrBinOp.Sub)
              (if (>= base-r 0)
                (OptUceAffine.No)
                (match (opt-unroll-const-guard-k-sub scale-l scale-r)
                  [(OptUceKSum.No) (OptUceAffine.No)]
                  [(OptUceKSum.Some scale)
                    (match (opt-unroll-const-guard-k-sub offset-l offset-r)
                      [(OptUceKSum.No) (OptUceAffine.No)]
                      [(OptUceKSum.Some offset)
                        (OptUceAffine.Some base-l scale offset)])]))]
            [(ir.CompilerIrBinOp.Mul)
              (cond
                [(and (< base-l 0) (= scale-l 0))
                  (if (< base-r 0)
                    (match (opt-unroll-const-guard-k-mul scale-r offset-l)
                      [(OptUceKSum.No) (OptUceAffine.No)]
                      [(OptUceKSum.Some scale)
                        (match (opt-unroll-const-guard-k-mul offset-r offset-l)
                          [(OptUceKSum.No) (OptUceAffine.No)]
                          [(OptUceKSum.Some offset)
                            (OptUceAffine.Some (- 0 1) scale offset)])])
                    (OptUceAffine.No))]
                [(and (< base-r 0) (= scale-r 0))
                  (if (< base-l 0)
                    (match (opt-unroll-const-guard-k-mul scale-l offset-r)
                      [(OptUceKSum.No) (OptUceAffine.No)]
                      [(OptUceKSum.Some scale)
                        (match (opt-unroll-const-guard-k-mul offset-l offset-r)
                          [(OptUceKSum.No) (OptUceAffine.No)]
                          [(OptUceKSum.Some offset)
                            (OptUceAffine.Some (- 0 1) scale offset)])])
                    (OptUceAffine.No))]
                [else (OptUceAffine.No)])]
            [_ (OptUceAffine.No)])])]))

;; Decompose a check index into `base + scale*counter + offset`. Counter
;; reads resolve to the counter phi (through same-block Mov copies); any
;; other var with no definition in the loop block is a loop-invariant base;
;; anything else (a phi, a load, a non-i64 op, a non-Add/Sub/Mul op)
;; rejects.
(define (opt-unroll-const-guard-affine
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : OptUceAffine
  (if (<= fuel 0)
    (OptUceAffine.No)
    (match value
      [(ir.CompilerIrValue.I64 k) (OptUceAffine.Some (- 0 1) 0 k)]
      [(ir.CompilerIrValue.Var raw)
        (let
          [id : i64 (opt-unroll-resolve-copy instrs phi-count last raw 16)]
          (if (= id iphi)
            (OptUceAffine.Some (- 0 1) 1 0)
            (let
              [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
              [def-index : i64 (opt-unroll-def-index slots 0 last id)]
              (if (< def-index 0)
                (OptUceAffine.Some id 0 0)
                (match (array-ref slots def-index)
                  [(ir.CompilerIrInstr.Mov _ src _)
                    (match src
                      [(ir.CompilerIrValue.I64 k)
                        (OptUceAffine.Some (- 0 1) 0 k)]
                      [_ (OptUceAffine.No)])]
                  [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
                    (if (opt-unroll-const-guard-reinterpret-cast? from-ty to-ty)
                      (opt-unroll-const-guard-affine
                        instrs
                        phi-count
                        last
                        iphi
                        src
                        (- fuel 1))
                      (OptUceAffine.No))]
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                    (match ty
                      [(ast.AstType.I64)
                        (opt-unroll-const-guard-affine-binop
                          instrs
                          phi-count
                          last
                          iphi
                          op
                          lhs
                          rhs
                          (- fuel 1))]
                      [_ (OptUceAffine.No)])]
                  [_ (OptUceAffine.No)])))))]
      [_ (OptUceAffine.No)])))

;; The check's length operand resolved through Mov copies and reinterpret
;; casts to its root value: an i64 literal, or an invariant var (no
;; definition in the loop block). Anything body-defined rejects.
(define (opt-unroll-const-guard-length-root
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : ir.CompilerIrMaybeValue
  (if (<= fuel 0)
    (ir.CompilerIrMaybeValue.No)
    (match value
      [(ir.CompilerIrValue.I64 _) (ir.CompilerIrMaybeValue.Some value)]
      [(ir.CompilerIrValue.Var raw)
        (let
          [id : i64 (opt-unroll-resolve-copy instrs phi-count last raw 16)]
          [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
          [def-index : i64 (opt-unroll-def-index slots 0 last id)]
          (if (< def-index 0)
            (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var id))
            (match (array-ref slots def-index)
              [(ir.CompilerIrInstr.Mov _ src _)
                (match src
                  [(ir.CompilerIrValue.I64 _)
                    (ir.CompilerIrMaybeValue.Some src)]
                  [_ (ir.CompilerIrMaybeValue.No)])]
              [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
                (if (opt-unroll-const-guard-reinterpret-cast? from-ty to-ty)
                  (opt-unroll-const-guard-length-root
                    instrs
                    phi-count
                    last
                    src
                    (- fuel 1))
                  (ir.CompilerIrMaybeValue.No))]
              [_ (ir.CompilerIrMaybeValue.No)])))]
      [_ (ir.CompilerIrMaybeValue.No)])))

;; Exact min and max of scale*c_j + offset over the simulated counters, or
;; No when the literal arithmetic overflows (a wrapped k would break the
;; interval argument).
(defenum OptUceRange
  (No)
  (Some i64 i64))

(define (opt-unroll-const-guard-range
  [counters : (__tl_dyn-array i64)]
  [trips : i64]
  [scale : i64]
  [offset : i64]
  [index : i64]
  [kmin : i64]
  [kmax : i64]) : OptUceRange
  (if (>= index trips)
    (OptUceRange.Some kmin kmax)
    (match (opt-unroll-const-guard-k-mul scale (array-ref counters index))
      [(OptUceKSum.No) (OptUceRange.No)]
      [(OptUceKSum.Some scaled)
        (match (opt-unroll-const-guard-k-add scaled offset)
          [(OptUceKSum.No) (OptUceRange.No)]
          [(OptUceKSum.Some k)
            (opt-unroll-const-guard-range
              counters
              trips
              scale
              offset
              (+ index 1)
              (if (< k kmin)
                k
                kmin)
              (if (> k kmax)
                k
                kmax))])])))

(define (opt-unroll-const-guard-range-start
  [counters : (__tl_dyn-array i64)]
  [trips : i64]
  [scale : i64]
  [offset : i64]) : OptUceRange
  (match (opt-unroll-const-guard-k-mul scale (array-ref counters 0))
    [(OptUceKSum.No) (OptUceRange.No)]
    [(OptUceKSum.Some scaled)
      (match (opt-unroll-const-guard-k-add scaled offset)
        [(OptUceKSum.No) (OptUceRange.No)]
        [(OptUceKSum.Some k)
          (opt-unroll-const-guard-range counters trips scale offset 1 k k)])]))

;; The per-trip counter literals, simulated with the same wrapping
;; normalize-add the trip simulation and the copy substitution use.
(define (opt-unroll-const-guard-counters
  [counters : (__tl_dyn-array i64)]
  [index : i64]
  [trips : i64]
  [step : i64]
  [ity : ast.AstType]) : unit
  (if (>= index trips)
    unit
    (begin
      (set!
        (array-ref counters index)
        (opt-normalize-int-to-i64 (+ (array-ref counters (- index 1)) step) ity))
      (opt-unroll-const-guard-counters counters (+ index 1) trips step ity))))

(defstruct OptUceGroup
  (base i64)
  (length ir.CompilerIrValue)
  (kmin i64)
  (kmax i64))

(import (vector.vector OptUceGroup core) as opt_uce_group_vec)

(define (opt-unroll-const-guard-value-eq?
  [a : ir.CompilerIrValue]
  [b : ir.CompilerIrValue]) : bool
  (match a
    [(ir.CompilerIrValue.Var av)
      (match b
        [(ir.CompilerIrValue.Var bv) (= av bv)]
        [_ false])]
    [(ir.CompilerIrValue.I64 ak)
      (match b
        [(ir.CompilerIrValue.I64 bk) (= ak bk)]
        [_ false])]
    [_ false]))

;; Fold one derived check into the group list: same (base, length) groups
;; merge their k-ranges (each group's interval argument is independent of
;; the others, so a second group with the same key would also be sound);
;; otherwise append a new group.
(define (opt-unroll-const-guard-merge-into
  [groups : (&mut groups opt_uce_group_vec.Vec)]
  [base : i64]
  [length : ir.CompilerIrValue]
  [kmin : i64]
  [kmax : i64]
  [index : i64]) : unit
  (if (>= index (opt_uce_group_vec.len groups))
    (opt_uce_group_vec.push groups (OptUceGroup base length kmin kmax))
    (let
      [g : OptUceGroup (array-ref (opt_uce_group_vec.slots groups) index)]
      (if (and
        (= g.base base)
        (opt-unroll-const-guard-value-eq? g.length length))
        (opt_uce_group_vec.set
          groups
          index
          (OptUceGroup
            base
            length
            (if (< kmin g.kmin)
              kmin
              g.kmin)
            (if (> kmax g.kmax)
              kmax
              g.kmax)))
        (opt-unroll-const-guard-merge-into
          groups
          base
          length
          kmin
          kmax
          (+ index 1))))))

(define (opt-unroll-const-guard-skips-contains?
  [skips : (& skips opt_dense_i64_vec.Vec)]
  [index : i64]
  [at : i64]) : bool
  (if (>= at (opt_dense_i64_vec.len skips))
    false
    (if (= (array-ref (opt_dense_i64_vec.slots skips) at) index)
      true
      (opt-unroll-const-guard-skips-contains? skips index (+ at 1)))))

;; Derivation walk over the body: derived checks fold their (base, length)
;; group into `groups` and their body index into `skips` (dropped from the
;; fast copies); the returned count is the grouped total (zero means nothing
;; consolidates and the arm unrolls as today).
(define (opt-unroll-const-guard-scan
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [counters : (__tl_dyn-array i64)]
  [trips : i64]
  [index : i64]
  [groups : (&mut groups opt_uce_group_vec.Vec)]
  [skips : (&mut skips opt_dense_i64_vec.Vec)]
  [groupable : i64]) : i64
  (if (>= index last)
    groupable
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BoundsCheck check-index check-length _)
        (match (opt-unroll-const-guard-length-root
          instrs
          phi-count
          last
          check-length
          16)
          [(ir.CompilerIrMaybeValue.No)
            (opt-unroll-const-guard-scan
              instrs
              phi-count
              last
              iphi
              counters
              trips
              (+ index 1)
              groups
              skips
              groupable)]
          [(ir.CompilerIrMaybeValue.Some length-root)
            (match (opt-unroll-const-guard-affine
              instrs
              phi-count
              last
              iphi
              check-index
              16)
              [(OptUceAffine.No)
                (opt-unroll-const-guard-scan
                  instrs
                  phi-count
                  last
                  iphi
                  counters
                  trips
                  (+ index 1)
                  groups
                  skips
                  groupable)]
              [(OptUceAffine.Some base scale offset)
                (match (opt-unroll-const-guard-range-start
                  counters
                  trips
                  scale
                  offset)
                  [(OptUceRange.No)
                    (opt-unroll-const-guard-scan
                      instrs
                      phi-count
                      last
                      iphi
                      counters
                      trips
                      (+ index 1)
                      groups
                      skips
                      groupable)]
                  [(OptUceRange.Some kmin kmax)
                    (begin
                      (opt-unroll-const-guard-merge-into
                        groups
                        base
                        length-root
                        kmin
                        kmax
                        0)
                      (opt_dense_i64_vec.push skips index)
                      (opt-unroll-const-guard-scan
                        instrs
                        phi-count
                        last
                        iphi
                        counters
                        trips
                        (+ index 1)
                        groups
                        skips
                        (+ groupable 1)))])])])]
      [_
        (opt-unroll-const-guard-scan
          instrs
          phi-count
          last
          iphi
          counters
          trips
          (+ index 1)
          groups
          skips
          groupable)])))

;; Outside-used body defs merge at the exit through fresh phis; the records
;; carry (def dst, phi type). Def kinds outside the scalar set below have no
;; unambiguous phi type and reject the guarded form.
(defenum OptUceExitRec
  (Rec i64 ast.AstType))

(defenum OptUceExitRecs
  (Nil)
  (Dense (__tl_dyn-array OptUceExitRec) i64))

(define (opt-uce-exit-rec-ref [recs : OptUceExitRecs] [index : i64]) : OptUceExitRec
  (match recs
    [(OptUceExitRecs.Nil) (OptUceExitRec.Rec -1 (ast.AstType.I64))]
    [(OptUceExitRecs.Dense items len) (array-ref items (- (- len 1) index))]))

(define (opt-uce-exit-rec-tail [recs : OptUceExitRecs]) : OptUceExitRecs
  (match recs
    [(OptUceExitRecs.Nil) (OptUceExitRecs.Nil)]
    [(OptUceExitRecs.Dense items len)
      (if (<= len 1)
        (OptUceExitRecs.Nil)
        (OptUceExitRecs.Dense items (- len 1)))]))

(define (opt-uce-exit-rec-cons
  [dst : i64]
  [ty : ast.AstType]
  [recs : OptUceExitRecs]) : OptUceExitRecs
  (let
    [rec : OptUceExitRec (OptUceExitRec.Rec dst ty)]
    (match recs
      [(OptUceExitRecs.Nil)
        (let
          [items : (__tl_dyn-array OptUceExitRec)
            (array.make-array OptUceExitRec 4)]
          (begin
            (set! (array-ref items 0) rec)
            (OptUceExitRecs.Dense items 1)))]
      [(OptUceExitRecs.Dense items len)
        (if (< len (array-length items))
          (begin
            (set! (array-ref items len) rec)
            (OptUceExitRecs.Dense items (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptUceExitRec)
              (array.make-array OptUceExitRec (opt-dense-next-capacity len))]
            [index : i64 0]
            (begin
              (while (< index len)
                (begin
                  (set! (array-ref bigger index) (array-ref items index))
                  (set! index (+ index 1))))
              (set! (array-ref bigger len) rec)
              (OptUceExitRecs.Dense bigger (+ len 1)))))])))

(cfg
  test
  (test
    optimizer-uce-exit-record-dense-storage-grows
    (let
      [recs : OptUceExitRecs (OptUceExitRecs.Nil)]
      [index : i64 0]
      (begin
        (while (< index 9)
          (begin
            (set! recs (opt-uce-exit-rec-cons index (ast.AstType.I64) recs))
            (set! index (+ index 1))))
        (match recs
          [(OptUceExitRecs.Nil)
            (test.assert-true false "UCE exit record storage is non-empty")]
          [(OptUceExitRecs.Dense items len)
            (begin
              (test.assert-i64-eq
                len
                9
                "UCE exit record storage grows past four")
              (test.assert-true
                (>= (array-length items) 9)
                "UCE exit record storage expands capacity"))])
        (match (opt-uce-exit-rec-ref recs 0)
          [(OptUceExitRec.Rec dst ty)
            (begin
              (test.assert-i64-eq dst 8 "UCE newest exit record stays first")
              (match ty
                [(ast.AstType.I64) unit]
                [_
                  (test.assert-true false "UCE exit record preserves its type")]))])
        (match (opt-uce-exit-rec-ref recs 8)
          [(OptUceExitRec.Rec dst _)
            (test.assert-i64-eq dst 0 "UCE oldest exit record stays last")])))))

(defenum OptUceDefTy
  (No)
  (Some ast.AstType))

(define (opt-unroll-const-guard-def-ty [instr : ir.CompilerIrInstr]) : OptUceDefTy
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ ty) (OptUceDefTy.Some ty)]
    [(ir.CompilerIrInstr.Cast _ _ _ to-ty) (OptUceDefTy.Some to-ty)]
    [(ir.CompilerIrInstr.Bitcast _ _ _ to-ty) (OptUceDefTy.Some to-ty)]
    [(ir.CompilerIrInstr.BinOp _ op _ _ ty)
      (OptUceDefTy.Some (ir.compiler-ir-binop-result-type op ty))]
    [(ir.CompilerIrInstr.UnOp _ _ _ ty) (OptUceDefTy.Some ty)]
    [(ir.CompilerIrInstr.Gep _ _ _ ty) (OptUceDefTy.Some ty)]
    [(ir.CompilerIrInstr.Load _ _ ty) (OptUceDefTy.Some ty)]
    [_ (OptUceDefTy.No)]))

;; Uses of a body def are permitted only in the exit block: every other
;; block (the loop apart) must be clean. Uses in blocks the exit does not
;; dominate could not be rewired to the merge phi.
(define (opt-unroll-const-guard-foreign-uses
  [blocks : ir.CompilerIrBlockList]
  [loop-label : i64]
  [exit-label : i64]
  [acc : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-unroll-const-guard-foreign-uses
            (__tl-box-place rest)
            loop-label
            exit-label
            (if (or (= label loop-label) (= label exit-label))
              acc
              (opt-unroll-const-outside-uses-instrs instrs 0 acc)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-const-guard-foreign-uses
        (ir.compiler-ir-block-seq-to-list seq)
        loop-label
        exit-label
        acc)]))

(define (opt-unroll-const-guard-defs-disjoint?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [uses : opt_i64_i64_map.Map]) : bool
  (if (>= index last)
    true
    (let
      [dst : i64
        (opt-unroll-const-instr-dst-or
          (ir.compiler-ir-instr-seq-ref instrs index)
          (- 0 1))]
      (if (and (>= dst 0) (opt-used-contains uses dst))
        false
        (opt-unroll-const-guard-defs-disjoint? instrs (+ index 1) last uses)))))

(defenum OptUceExitRecsMaybe
  (No)
  (Some OptUceExitRecs))

(define (opt-unroll-const-guard-exit-recs
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [exit-uses : opt_i64_i64_map.Map]
  [index : i64]
  [acc : OptUceExitRecs]) : OptUceExitRecsMaybe
  (if (>= index last)
    (OptUceExitRecsMaybe.Some acc)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      [dst : i64 (opt-unroll-const-instr-dst-or instr (- 0 1))]
      (if (and (>= dst 0) (opt-used-contains exit-uses dst))
        (match (opt-unroll-const-guard-def-ty instr)
          [(OptUceDefTy.No) (OptUceExitRecsMaybe.No)]
          [(OptUceDefTy.Some ty)
            (opt-unroll-const-guard-exit-recs
              instrs
              phi-count
              last
              exit-uses
              (+ index 1)
              (opt-uce-exit-rec-cons dst ty acc))])
        (opt-unroll-const-guard-exit-recs
          instrs
          phi-count
          last
          exit-uses
          (+ index 1)
          acc)))))

;; The exit block gets a new predecessor (the fast path), so it must have no
;; phis of its own, and every one of its instructions must be rewritable by
;; opt-copy-subst-instr for the merge-phi use rewrite (vector payloads,
;; masks, slot addressing, and entry values are not).
(define (opt-unroll-const-guard-exit-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.VectorBinOp _) false]
    [(ir.CompilerIrInstr.VectorPrefix _) false]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) false]
    [(ir.CompilerIrInstr.VectorCompare _) false]
    [(ir.CompilerIrInstr.Select _) false]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) false]
    [(ir.CompilerIrInstr.VectorStore _) false]
    [(ir.CompilerIrInstr.PredicatedStore _) false]
    [(ir.CompilerIrInstr.PredicatedLoad _) false]
    [(ir.CompilerIrInstr.GatherLoad _) false]
    [(ir.CompilerIrInstr.VectorShuffle _) false]
    [(ir.CompilerIrInstr.TailMask _ _ _ _) false]
    [(ir.CompilerIrInstr.AddrOf _ _) false]
    [(ir.CompilerIrInstr.Alloc _ _) false]
    [(ir.CompilerIrInstr.LaneId _ _ _) false]
    [(ir.CompilerIrInstr.MaskBinOp _ _ _ _ _) false]
    [(ir.CompilerIrInstr.MaskNot _ _ _) false]
    [(ir.CompilerIrInstr.MaskReduce _ _ _ _) false]
    [(ir.CompilerIrInstr.SpmdCall _) false]
    [(ir.CompilerIrInstr.EntryArgc _) false]
    [(ir.CompilerIrInstr.EntryArgv _) false]
    [(ir.CompilerIrInstr.EntryEnvp _) false]
    [_ true]))

(define (opt-unroll-const-guard-exit-instrs-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (opt-unroll-const-guard-exit-instr-ok?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-unroll-const-guard-exit-instrs-ok? instrs (+ index 1)))))

(define (opt-unroll-const-guard-exit-ok?
  [blocks : ir.CompilerIrBlockList]
  [exit-label : i64]) : bool
  (match (opt-cfg-find-block blocks exit-label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-unroll-no-phi-from? instrs 0)
            (opt-unroll-const-guard-exit-instrs-ok? instrs 0))])]))

;; The consolidation plan: merged guard groups, the grouped checks' body
;; indices, and the exit merge records. No means the arm unrolls exactly as
;; today (no guard, copies keep the original destinations).
(defenum OptUcePlan
  (No)
  (Some opt_uce_group_vec.Vec opt_dense_i64_vec.Vec OptUceExitRecs))

(define (opt-unroll-const-guard-plan
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [last : i64]
  [shape : OptUnrollConstShape]) : OptUcePlan
  (let
    [trips : i64 shape.trips]
    [ity : ast.AstType shape.ity]
    [exit-label : i64 shape.exit-label]
    (if (or
      (< trips 4)
      (not
        (match ity
          [(ast.AstType.I64) true]
          [_ false]))
      (not (opt-unroll-pred-retargetable? blocks shape.pred-label))
      (opt-cfg-block-exists?
        blocks
        (ir.compiler-ir-label
          (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_guard")))
      (not (opt-unroll-const-guard-exit-ok? blocks exit-label)))
      (OptUcePlan.No)
      (let
        [counters : (__tl_dyn-array i64) (array.make-array i64 trips)]
        [_c0 : unit (set! (array-ref counters 0) shape.seed)]
        [_fill : unit
          (opt-unroll-const-guard-counters counters 1 trips shape.step ity)]
        [groups : opt_uce_group_vec.Vec (opt_uce_group_vec.with-capacity 4)]
        [skips : opt_dense_i64_vec.Vec (opt_dense_i64_vec.with-capacity 4)]
        [groupable : i64
          (opt-unroll-const-guard-scan
            instrs
            shape.phi-count
            last
            shape.iphi
            counters
            trips
            shape.phi-count
            (&mut groups)
            (&mut skips)
            0)]
        (if (= groupable 0)
          (OptUcePlan.No)
          (match (opt-cfg-find-block blocks exit-label)
            [(OptMaybeBlock.No) (OptUcePlan.No)]
            [(OptMaybeBlock.Some exit-block)
              (match exit-block
                [(ir.CompilerIrBlock.Block _ exit-instrs)
                  (let
                    [exit-uses : opt_i64_i64_map.Map
                      (opt-unroll-const-outside-uses-instrs
                        exit-instrs
                        0
                        (opt_i64_i64_map.with-capacity 64))]
                    [foreign-uses : opt_i64_i64_map.Map
                      (opt-unroll-const-guard-foreign-uses
                        blocks
                        label
                        exit-label
                        (opt_i64_i64_map.with-capacity 64))]
                    (if (not
                      (opt-unroll-const-guard-defs-disjoint?
                        instrs
                        shape.phi-count
                        last
                        foreign-uses))
                      (OptUcePlan.No)
                      (match (opt-unroll-const-guard-exit-recs
                        instrs
                        shape.phi-count
                        last
                        exit-uses
                        shape.phi-count
                        (OptUceExitRecs.Nil))
                        [(OptUceExitRecsMaybe.No) (OptUcePlan.No)]
                        [(OptUceExitRecsMaybe.Some recs)
                          (OptUcePlan.Some groups skips recs)])))])]))))))

;; Guard emission result: the instructions in evaluation order and the var
;; holding the and of all group conditions.
(defstruct OptUceEmit
  (instrs ir.CompilerIrInstrList)
  (cond-var i64))

(define (opt-unroll-const-guard-emit
  [groups : (& groups opt_uce_group_vec.Vec)]
  [index : i64]
  [cell : (__tl_dyn-array i64)]
  [cond-var : i64]
  [acc : ir.CompilerIrInstrList]) : OptUceEmit
  (if (>= index (opt_uce_group_vec.len groups))
    (OptUceEmit acc cond-var)
    (let
      [g : OptUceGroup (array-ref (opt_uce_group_vec.slots groups) index)]
      [base : i64 g.base]
      [length : ir.CompilerIrValue g.length]
      [kmin : i64 g.kmin]
      [span : i64 (- g.kmax kmin)]
      [gmin : i64
        (if (>= base 0)
          (opt-unroll-alloc-var cell)
          (- 0 1))]
      [min-value : ir.CompilerIrValue
        (if (>= base 0)
          (ir.CompilerIrValue.Var gmin)
          (ir.CompilerIrValue.I64 kmin))]
      [min-instrs : ir.CompilerIrInstrList
        (if (>= base 0)
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.BinOp
              gmin
              (ir.CompilerIrBinOp.Add)
              (ir.CompilerIrValue.Var base)
              (ir.CompilerIrValue.I64 kmin)
              (ast.AstType.I64))
            (ir.CompilerIrInstrList.Nil))
          (ir.CompilerIrInstrList.Nil))]
      [c1 : i64 (opt-unroll-alloc-var cell)]
      [t : i64
        (if (= span 0)
          (- 0 1)
          (opt-unroll-alloc-var cell))]
      [c2 : i64
        (if (= span 0)
          (- 0 1)
          (opt-unroll-alloc-var cell))]
      [gand : i64
        (if (= span 0)
          (- 0 1)
          (opt-unroll-alloc-var cell))]
      [group-cond : i64
        (if (= span 0)
          c1
          gand)]
      [group-instrs : ir.CompilerIrInstrList
        (opt-aggregate-instr-list-append
          min-instrs
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.BinOp
              c1
              (ir.CompilerIrBinOp.Lt)
              min-value
              length
              (ast.AstType.U64))
            (if (= span 0)
              (ir.CompilerIrInstrList.Nil)
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  t
                  (ir.CompilerIrBinOp.Sub)
                  length
                  min-value
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    c2
                    (ir.CompilerIrBinOp.Gt)
                    (ir.CompilerIrValue.Var t)
                    (ir.CompilerIrValue.I64 span)
                    (ast.AstType.U64))
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      gand
                      (ir.CompilerIrBinOp.And)
                      (ir.CompilerIrValue.Var c1)
                      (ir.CompilerIrValue.Var c2)
                      (ast.AstType.Bool))
                    (ir.CompilerIrInstrList.Nil)))))))]
      (if (< cond-var 0)
        (opt-unroll-const-guard-emit
          groups
          (+ index 1)
          cell
          group-cond
          (opt-aggregate-instr-list-append acc group-instrs))
        (let
          [combined : i64 (opt-unroll-alloc-var cell)]
          (opt-unroll-const-guard-emit
            groups
            (+ index 1)
            cell
            combined
            (opt-aggregate-instr-list-append
              acc
              (opt-aggregate-instr-list-append
                group-instrs
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    combined
                    (ir.CompilerIrBinOp.And)
                    (ir.CompilerIrValue.Var cond-var)
                    (ir.CompilerIrValue.Var group-cond)
                    (ast.AstType.Bool))
                  (ir.CompilerIrInstrList.Nil))))))))))

;; The slow loop keeps the original body verbatim; only the phis' entry-edge
;; input labels move from the original predecessor to the guard block.
;; The slow loop keeps the original body verbatim; only the phis' entry-edge
;; input labels move from the original predecessor to the guard block.
(define (opt-unroll-const-guard-relabel-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [from-label : i64]
  [to-label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-unroll-const-guard-relabel-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        from-label
        to-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        value
        (if (= label from-label)
          to-label
          label)
        (opt-unroll-const-guard-relabel-inputs
          (__tl-box-place rest)
          from-label
          to-label))]))

(define (opt-unroll-const-guard-relabel-phis
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [from-label : i64]
  [to-label : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.Phi dst inputs ty)
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Phi
              dst
              (opt-unroll-const-guard-relabel-inputs inputs from-label to-label)
              ty)
            (opt-unroll-const-guard-relabel-phis
              instrs
              (+ index 1)
              from-label
              to-label))]
        [_
          (ir.compiler-ir-instr-cons
            instr
            (opt-unroll-const-guard-relabel-phis
              instrs
              (+ index 1)
              from-label
              to-label))]))))

;; Exit merge phis: one per outside-used body def, reading the last fast
;; copy's renamed def on the fast edge and the original def on the slow
;; edge, plus the destination remap for the exit-block use rewrite.
(defenum OptUceExitBuild
  (Result ir.CompilerIrInstrList OptCopyEnv))

(define (opt-unroll-const-guard-exit-phis
  [recs : OptUceExitRecs]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [loop-label : i64]
  [fast-label : i64]
  [cell : (__tl_dyn-array i64)]
  [acc : ir.CompilerIrInstrList]
  [env : OptCopyEnv]) : OptUceExitBuild
  (match recs
    [(OptUceExitRecs.Nil) (OptUceExitBuild.Result acc env)]
    [(OptUceExitRecs.Dense _ _)
      (match (opt-uce-exit-rec-ref recs 0)
        [(OptUceExitRec.Rec dst ty)
          (let
            [merged : i64 (opt-unroll-alloc-var cell)]
            [fast-value : ir.CompilerIrValue
              (opt-unroll-subst-value remap (ir.CompilerIrValue.Var dst))]
            (opt-unroll-const-guard-exit-phis
              (opt-uce-exit-rec-tail recs)
              remap
              loop-label
              fast-label
              cell
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Phi
                  merged
                  (ir.compiler-ir-phi-input-cons
                    fast-value
                    fast-label
                    (ir.compiler-ir-phi-input-cons
                      (ir.CompilerIrValue.Var dst)
                      loop-label
                      (ir.CompilerIrPhiInputList.Nil)))
                  ty)
                acc)
              (OptCopyEnv.Cons dst (ir.CompilerIrValue.Var merged) (box env))))])]))

(define (opt-unroll-const-guard-subst-seq
  [env : OptCopyEnv]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-const-guard-subst-seq
      env
      instrs
      (+ index 1)
      (ir.compiler-ir-instr-cons
        (opt-rotate-ssa-subst-instr
          env
          (ir.compiler-ir-instr-seq-ref instrs index))
        acc))))

(define (opt-unroll-const-guard-rewrite-exit
  [blocks : ir.CompilerIrBlockList]
  [exit-label : i64]
  [phis : ir.CompilerIrInstrList]
  [env : OptCopyEnv]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (= label exit-label)
              (ir.compiler-ir-block
                label
                (opt-aggregate-instr-list-append
                  phis
                  (opt-unroll-const-guard-subst-seq
                    env
                    instrs
                    0
                    (ir.CompilerIrInstrList.Nil))))
              block)
            (opt-unroll-const-guard-rewrite-exit
              (__tl-box-place rest)
              exit-label
              phis
              env))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-const-guard-rewrite-exit
        (ir.compiler-ir-block-seq-to-list seq)
        exit-label
        phis
        env)]))

;; The loop block keeps its label and its predecessor edges; only its contents
;; become the straight-line trip copies ending in a jump to the old exit.
(define (opt-unroll-const-apply
  [blocks : ir.CompilerIrBlockList]
  [block : ir.CompilerIrBlock]
  [shape : OptUnrollConstShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [last : i64 (- count 1)]
        [remap : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [_fill : unit (opt-unroll-remap-fill remap 0)]
        [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
        [_cell : unit (set! (array-ref cell 0) frame)]
        (match (opt-unroll-const-guard-plan blocks label instrs last shape)
          [(OptUcePlan.Some groups skips exit-recs)
            (let
              [pred-label : i64 shape.pred-label]
              [guard-label : i64
                (ir.compiler-ir-label
                  (str_cat.str-cat
                    (ir.compiler-ir-label-text label)
                    "__bce_guard"))]
              [fast-label : i64
                (ir.compiler-ir-label
                  (str_cat.str-cat
                    (ir.compiler-ir-label-text label)
                    "__bce_fast"))]
              [copies : ir.CompilerIrInstrList
                (opt-unroll-const-copies
                  instrs
                  shape.phi-count
                  last
                  shape.cond-index
                  shape.iphi
                  shape.seed
                  shape.step
                  shape.ity
                  shape.others
                  (& skips)
                  true
                  remap
                  cell
                  0
                  shape.trips)]
              [emitted : OptUceEmit
                (opt-unroll-const-guard-emit
                  (& groups)
                  0
                  cell
                  (- 0 1)
                  (ir.CompilerIrInstrList.Nil))]
              [exit-label : i64 shape.exit-label]
              [exit-build : OptUceExitBuild
                (opt-unroll-const-guard-exit-phis
                  exit-recs
                  remap
                  label
                  fast-label
                  cell
                  (ir.CompilerIrInstrList.Nil)
                  (OptCopyEnv.Nil))]
              [guard-block : ir.CompilerIrBlock
                (ir.compiler-ir-block
                  guard-label
                  (opt-aggregate-instr-list-append
                    emitted.instrs
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Branch
                        (ir.CompilerIrValue.Var emitted.cond-var)
                        fast-label
                        label)
                      (ir.CompilerIrInstrList.Nil))))]
              [fast-block : ir.CompilerIrBlock
                (ir.compiler-ir-block
                  fast-label
                  (opt-aggregate-instr-list-append
                    copies
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Jump exit-label)
                      (ir.CompilerIrInstrList.Nil))))]
              [slow-block : ir.CompilerIrBlock
                (ir.compiler-ir-block
                  label
                  (opt-unroll-const-guard-relabel-phis
                    instrs
                    0
                    pred-label
                    guard-label))]
              (match exit-build
                [(OptUceExitBuild.Result exit-phis exit-env)
                  (OptUnrollResult.Result
                    (opt-unroll-const-guard-rewrite-exit
                      (opt-unroll-rewrite-blocks
                        blocks
                        pred-label
                        label
                        guard-block
                        fast-block
                        slow-block
                        guard-label)
                      exit-label
                      exit-phis
                      exit-env)
                    (array-ref cell 0)
                    true)]))]
          [(OptUcePlan.No)
            (let
              [empty-skips : opt_dense_i64_vec.Vec (opt_dense_i64_vec.new)]
              [copies : ir.CompilerIrInstrList
                (opt-unroll-const-copies
                  instrs
                  shape.phi-count
                  last
                  shape.cond-index
                  shape.iphi
                  shape.seed
                  shape.step
                  shape.ity
                  shape.others
                  (& empty-skips)
                  false
                  remap
                  cell
                  0
                  shape.trips)]
              [new-block : ir.CompilerIrBlock
                (ir.compiler-ir-block
                  label
                  (opt-aggregate-instr-list-append
                    copies
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Jump shape.exit-label)
                      (ir.CompilerIrInstrList.Nil))))]
              (OptUnrollResult.Result
                (opt-unroll-const-replace-block blocks label new-block)
                (array-ref cell 0)
                true))]))]))

;; The mutable SIMD path additionally admits an ordinary canonical VectorStore.
;; The generic SSA cloner remains store-free. BoundsCheck is excluded because
;; repeating one would duplicate its function-unique continuation label;
;; predicated memory, scalar stores, gathers, and calls remain excluded too.
(define (opt-unroll-simd-body-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) false]
    [(ir.CompilerIrInstr.VectorStore _) true]
    [_ (opt-unroll-body-instr-ok? instr)]))

(define (opt-unroll-simd-vector-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.LaneId _ _ _) true]
    [(ir.CompilerIrInstr.Splat _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorBinOp _) true]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorCompare _) true]
    [(ir.CompilerIrInstr.MaskBinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.Select _) true]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorStore _) true]
    [_ false]))

(define (opt-unroll-simd-body-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-unroll-simd-body-instr-ok?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-unroll-simd-body-ok? instrs (+ index 1) last))))

(define (opt-unroll-simd-body-has-vector?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    false
    (or
      (opt-unroll-simd-vector-instr?
        (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-unroll-simd-body-has-vector? instrs (+ index 1) last))))

;; A self-loop candidate must have exactly one predecessor besides itself.
(define (opt-unroll-simd-outside-pred [preds : OptLabelSet] [loop-label : i64]) : OptLoopPreheader
  (if (= (opt-label-count preds) 2)
    (let
      [first : i64 (opt-label-ref preds 0)]
      [second : i64 (opt-label-ref preds 1)]
      (cond
        [(and (= first loop-label) (!= second loop-label))
          (OptLoopPreheader.Some second)]
        [(and (= second loop-label) (!= first loop-label))
          (OptLoopPreheader.Some first)]
        [else (OptLoopPreheader.No)]))
    (OptLoopPreheader.No)))

;; Direct gang unrolling advances the scalar index once per group. Every
;; VectorLoad and VectorStore must therefore read the canonical counter and use
;; one vector-width step; no other body instruction may consume that counter.
;; Record every invariant base/type pair so the unrolled group can compute one
;; Gep(base, group-index) per array, then use literal lane-group offsets from it.
(define (opt-unroll-simd-memory-new) : OptUnrollSimdMemoryList
  (OptUnrollSimdMemoryList (opt_unroll_simd_memory_vec.with-capacity 4)))

(define (opt-unroll-simd-memory-count [memory-bases : OptUnrollSimdMemoryList]) : i64
  (opt_unroll_simd_memory_vec.len (& memory-bases.items)))

;; Appends replace list prepends, so logical index zero remains the newest
;; base/type pair and preserves the old Cons traversal order.
(define (opt-unroll-simd-memory-at
  [memory-bases : OptUnrollSimdMemoryList]
  [index : i64]) : OptUnrollSimdMemory
  (let
    [items : opt_unroll_simd_memory_vec.Vec memory-bases.items]
    (array-ref
      (opt_unroll_simd_memory_vec.slots (& items))
      (- (- (opt_unroll_simd_memory_vec.len (& items)) index) 1))))

(define (opt-unroll-simd-memory-contains?
  [type-segment-bases : i64]
  [memory-bases : OptUnrollSimdMemoryList]
  [base : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (let
    [count : i64 (opt-unroll-simd-memory-count memory-bases)]
    [index : i64 0]
    [found? : bool false]
    (begin
      (while (and (not found?) (< index count))
        (let
          [item : OptUnrollSimdMemory
            (opt-unroll-simd-memory-at memory-bases index)]
          (begin
            (set!
              found?
              (and
                (opt-value-eq item.base base)
                (opt-type-eq type-segment-bases item.ty ty)))
            (set! index (+ index 1)))))
      found?)))

(define (opt-unroll-simd-memory-add
  [type-segment-bases : i64]
  [memory-bases : OptUnrollSimdMemoryList (:consume)]
  [base : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptUnrollSimdMemoryList
  (if (opt-unroll-simd-memory-contains? type-segment-bases memory-bases base ty)
    memory-bases
    (let
      [items : opt_unroll_simd_memory_vec.Vec memory-bases.items]
      (begin
        (opt_unroll_simd_memory_vec.push
          (&mut items)
          (OptUnrollSimdMemory base ty))
        (OptUnrollSimdMemoryList items)))))

(define (opt-unroll-simd-memory-shape
  [type-segment-bases : i64]
  [defs : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [index-var : i64]
  [step : i64]
  [state : OptUnrollSimdMemoryShape]) : OptUnrollSimdMemoryShape
  (if (>= index last)
    state
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.VectorLoad _ base load-index lanes ty)
          (match load-index
            [(ir.CompilerIrValue.Var load-index-var)
              (if (and
                (= load-index-var index-var)
                (= lanes step)
                (opt-unroll-invariant-bound? defs base))
                (match state
                  [(OptUnrollSimdMemoryShape.Some
                      memory-bases
                      memory-count
                      load-count
                      store-count)
                    (let
                      [known? : bool
                        (opt-unroll-simd-memory-contains?
                          type-segment-bases
                          memory-bases
                          base
                          ty)]
                      (opt-unroll-simd-memory-shape
                        type-segment-bases
                        defs
                        instrs
                        (+ index 1)
                        last
                        index-var
                        step
                        (OptUnrollSimdMemoryShape.Some
                          (opt-unroll-simd-memory-add
                            type-segment-bases
                            memory-bases
                            base
                            ty)
                          (if known?
                            memory-count
                            (+ memory-count 1))
                          (+ load-count 1)
                          store-count)))]
                  [(OptUnrollSimdMemoryShape.Fail)
                    (OptUnrollSimdMemoryShape.Fail)])
                (OptUnrollSimdMemoryShape.Fail))]
            [_ (OptUnrollSimdMemoryShape.Fail)])]
        [(ir.CompilerIrInstr.VectorStore payload-box)
          (let
            [base : ir.CompilerIrValue
              (__tl-project-field (__tl-box-place payload-box) base)]
            [store-index : ir.CompilerIrValue
              (__tl-project-field (__tl-box-place payload-box) index)]
            [lanes : i64
              (__tl-project-field (__tl-box-place payload-box) lanes)]
            [ty : ast.AstType
              (__tl-project-field (__tl-box-place payload-box) ty)]
            (match store-index
              [(ir.CompilerIrValue.Var store-index-var)
                (if (and
                  (= store-index-var index-var)
                  (= lanes step)
                  (opt-unroll-invariant-bound? defs base))
                  (match state
                    [(OptUnrollSimdMemoryShape.Some
                        memory-bases
                        memory-count
                        load-count
                        store-count)
                      (let
                        [known? : bool
                          (opt-unroll-simd-memory-contains?
                            type-segment-bases
                            memory-bases
                            base
                            ty)]
                        (opt-unroll-simd-memory-shape
                          type-segment-bases
                          defs
                          instrs
                          (+ index 1)
                          last
                          index-var
                          step
                          (OptUnrollSimdMemoryShape.Some
                            (opt-unroll-simd-memory-add
                              type-segment-bases
                              memory-bases
                              base
                              ty)
                            (if known?
                              memory-count
                              (+ memory-count 1))
                            load-count
                            (+ store-count 1))))]
                    [(OptUnrollSimdMemoryShape.Fail)
                      (OptUnrollSimdMemoryShape.Fail)])
                  (OptUnrollSimdMemoryShape.Fail))]
              [_ (OptUnrollSimdMemoryShape.Fail)]))]
        [_
          (if (opt-used-contains
            (opt-collect-instr-uses (opt_i64_i64_map.with-capacity 8) instr)
            index-var)
            (OptUnrollSimdMemoryShape.Fail)
            (opt-unroll-simd-memory-shape
              type-segment-bases
              defs
              instrs
              (+ index 1)
              last
              index-var
              step
              state))]))))

(define (opt-unroll-simd-shape-finish
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [cond-index : i64]
  [tail-label : i64]
  [cmp-op : ir.CompilerIrBinOp]
  [cmp-lhs : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]) : OptUnrollSimdMaybeShape
  (match cmp-lhs
    [(ir.CompilerIrValue.Var next-var)
      (if (< cond-index 2)
        (OptUnrollSimdMaybeShape.No)
        (match (ir.compiler-ir-instr-seq-ref instrs (- cond-index 1))
          [(ir.CompilerIrInstr.BinOp inc-dst inc-op inc-lhs inc-rhs ity)
            (match inc-op
              [(ir.CompilerIrBinOp.Add)
                (match inc-lhs
                  [(ir.CompilerIrValue.Var index-var)
                    (match inc-rhs
                      [(ir.CompilerIrValue.I64 step)
                        (match (ir.compiler-ir-instr-seq-ref
                          instrs
                          (- cond-index 2))
                          [(ir.CompilerIrInstr.Mov move-dst move-src move-ty)
                            (match move-src
                              [(ir.CompilerIrValue.Var move-next)
                                (let
                                  [defs : opt_i64_i64_map.Map
                                    (opt-unroll-block-defs
                                      instrs.slots
                                      0
                                      (ir.compiler-ir-instr-seq-count instrs)
                                      (opt_i64_i64_map.with-capacity 32))]
                                  (if (and
                                    (= inc-dst next-var)
                                    (= move-dst index-var)
                                    (= move-next next-var)
                                    (> step 0)
                                    (<= step 1024)
                                    (match ity
                                      [(ast.AstType.I64) true]
                                      [_ false])
                                    (match move-ty
                                      [(ast.AstType.I64) true]
                                      [_ false])
                                    (!= label entry-label)
                                    (opt-unroll-invariant-bound? defs bound)
                                    (opt-unroll-simd-body-ok?
                                      instrs
                                      0
                                      cond-index)
                                    (opt-unroll-simd-body-has-vector?
                                      instrs
                                      0
                                      cond-index)
                                    (not
                                      (opt-cfg-block-exists?
                                        blocks
                                        (ir.compiler-ir-label
                                          (str_cat.str-cat
                                            (ir.compiler-ir-label-text label)
                                            "__unroll_guard"))))
                                    (not
                                      (opt-cfg-block-exists?
                                        blocks
                                        (ir.compiler-ir-label
                                          (str_cat.str-cat
                                            (ir.compiler-ir-label-text label)
                                            "__unroll_body"))))
                                    (not
                                      (opt-cfg-block-exists?
                                        blocks
                                        (ir.compiler-ir-label
                                          (str_cat.str-cat
                                            (ir.compiler-ir-label-text label)
                                            "__unroll_exit")))))
                                    (match (opt-unroll-simd-outside-pred
                                      (opt-cfg-predecessors blocks label)
                                      label)
                                      [(OptLoopPreheader.Some pred-label)
                                        (if (opt-unroll-pred-retargetable?
                                          blocks
                                          pred-label)
                                          (match (opt-unroll-simd-memory-shape
                                            type-segment-bases
                                            defs
                                            instrs
                                            0
                                            (- cond-index 2)
                                            index-var
                                            step
                                            (OptUnrollSimdMemoryShape.Some
                                              (opt-unroll-simd-memory-new)
                                              0
                                              0
                                              0))
                                            [(OptUnrollSimdMemoryShape.Some
                                                memory-bases
                                                memory-count
                                                load-count
                                                store-count)
                                              ;; Preserve the old single-base
                                              ;; store-free scope. Store-bearing
                                              ;; maps may use any number of
                                              ;; invariant bases, but a pure
                                              ;; fill is deliberately excluded.
                                              (if (and
                                                (> load-count 0)
                                                (or
                                                  (> store-count 0)
                                                  (= memory-count 1)))
                                                (OptUnrollSimdMaybeShape.Some
                                                  (OptUnrollSimdShape
                                                    pred-label
                                                    tail-label
                                                    cond-index
                                                    index-var
                                                    next-var
                                                    step
                                                    ity
                                                    bound
                                                    cmp-op
                                                    memory-bases
                                                    memory-count))
                                                (OptUnrollSimdMaybeShape.No))]
                                            [_ (OptUnrollSimdMaybeShape.No)])
                                          (OptUnrollSimdMaybeShape.No))]
                                      [(OptLoopPreheader.No)
                                        (OptUnrollSimdMaybeShape.No)])
                                    (OptUnrollSimdMaybeShape.No)))]
                              [_ (OptUnrollSimdMaybeShape.No)])]
                          [_ (OptUnrollSimdMaybeShape.No)])]
                      [_ (OptUnrollSimdMaybeShape.No)])]
                  [_ (OptUnrollSimdMaybeShape.No)])]
              [_ (OptUnrollSimdMaybeShape.No)])]
          [_ (OptUnrollSimdMaybeShape.No)]))]
    [_ (OptUnrollSimdMaybeShape.No)]))

(define (opt-unroll-simd-block-shape
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [block : ir.CompilerIrBlock]) : OptUnrollSimdMaybeShape
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 7)
          (OptUnrollSimdMaybeShape.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond true-label false-label)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (if (and (= true-label label) (!= false-label label))
                    (let
                      [cond-index : i64 (- count 2)]
                      (match (ir.compiler-ir-instr-seq-ref instrs cond-index)
                        [(ir.CompilerIrInstr.BinOp
                            cond-dst
                            cmp-op
                            cmp-lhs
                            bound
                            _)
                          (if (and
                            (= cond-dst cond-var)
                            (match cmp-op
                              [(ir.CompilerIrBinOp.Lt) true]
                              [(ir.CompilerIrBinOp.Le) true]
                              [_ false]))
                            (opt-unroll-simd-shape-finish
                              type-segment-bases
                              blocks
                              entry-label
                              label
                              instrs
                              cond-index
                              false-label
                              cmp-op
                              cmp-lhs
                              bound)
                            (OptUnrollSimdMaybeShape.No))]
                        [_ (OptUnrollSimdMaybeShape.No)]))
                    (OptUnrollSimdMaybeShape.No))]
                [_ (OptUnrollSimdMaybeShape.No)])]
            [_ (OptUnrollSimdMaybeShape.No)])))]))

;; A loop-carried vector recurrence cannot become an ordinary scalar Phi (the
;; Phi IR has no lane count), so keep only a vector destination that reads
;; itself mutable. Every transient vector/scalar destination is freshened: this
;; restores single-use VectorLoad facts for backend memory-operand folding and
;; gives register allocation non-overlapping scalar counter intervals.
(define (opt-unroll-simd-recurrent-vector-dst [instr : ir.CompilerIrInstr]) : option_i64.Option
  (if (opt-unroll-simd-vector-instr? instr)
    (match (opt-instr-def-var instr)
      [(option_i64.Some dst)
        (if (opt-used-contains
          (opt-collect-instr-uses (opt_i64_i64_map.with-capacity 8) instr)
          dst)
          (option_i64.Some dst)
          (option_i64.None))]
      [(option_i64.None) (option_i64.None)])
    (option_i64.None)))

(define (opt-unroll-simd-clone-recurrence
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.LaneId dst lanes ty)
      (ir.CompilerIrInstr.LaneId dst lanes ty)]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat
        dst
        (opt-unroll-subst-value remap value)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-bin-op
          dst
          op
          (opt-unroll-subst-value remap lhs)
          (opt-unroll-subst-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (ir.CompilerIrInstr.VectorReduce
        dst
        op
        (opt-unroll-subst-value remap src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-compare
          dst
          op
          (opt-unroll-subst-value remap lhs)
          (opt-unroll-subst-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        dst
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        lanes)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-select
          dst
          (opt-unroll-subst-value remap mask)
          (opt-unroll-subst-value remap on-true)
          (opt-unroll-subst-value remap on-false)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorLoad dst base index lanes ty)
      (ir.CompilerIrInstr.VectorLoad
        dst
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap index)
        lanes
        ty)]
    [_ instr]))

(define (opt-unroll-simd-memory-index
  [type-segment-bases : i64]
  [memory-bases : OptUnrollSimdMemoryList]
  [base : ir.CompilerIrValue]
  [ty : ast.AstType]
  [index : i64]) : i64
  ;; Shape validation guarantees that every cloned memory instruction is in
  ;; this table. Returning -1 makes any violated internal invariant fail
  ;; loudly at array access instead of silently changing an address.
  (let
    [count : i64 (opt-unroll-simd-memory-count memory-bases)]
    [scan : i64 index]
    [found : i64 (- 0 1)]
    (begin
      (while (and (< found 0) (< scan count))
        (let
          [item : OptUnrollSimdMemory
            (opt-unroll-simd-memory-at memory-bases scan)]
          (begin
            (if (and
              (opt-value-eq item.base base)
              (opt-type-eq type-segment-bases item.ty ty))
              (set! found scan)
              unit)
            (set! scan (+ scan 1)))))
      found)))

(define (opt-unroll-simd-clone-instr
  [type-segment-bases : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [memory-bases : OptUnrollSimdMemoryList]
  [group-bases : (__tl_dyn-array i64)]
  [step : i64]
  [copy : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match (opt-unroll-simd-recurrent-vector-dst instr)
    [(option_i64.Some dst)
      (begin
        ;; The source occurrence denotes the mutable value written by the
        ;; preceding gang, not a transient clone from an earlier instruction.
        (opt-unroll-remap-set remap dst (ir.CompilerIrValue.Var dst))
        (opt-unroll-simd-clone-recurrence remap instr))]
    [(option_i64.None)
      (match instr
        [(ir.CompilerIrInstr.VectorLoad dst base _ lanes ty)
          (ir.CompilerIrInstr.VectorLoad
            (opt-unroll-clone-dst remap cell dst)
            (ir.CompilerIrValue.Var
              (array-ref
                group-bases
                (opt-unroll-simd-memory-index
                  type-segment-bases
                  memory-bases
                  base
                  ty
                  0)))
            (ir.CompilerIrValue.I64 (* copy step))
            lanes
            ty)]
        [(ir.CompilerIrInstr.VectorStore payload-box)
          (let
            [base : ir.CompilerIrValue
              (__tl-project-field (__tl-box-place payload-box) base)]
            [value : ir.CompilerIrValue
              (__tl-project-field (__tl-box-place payload-box) value)]
            [lanes : i64
              (__tl-project-field (__tl-box-place payload-box) lanes)]
            [ty : ast.AstType
              (__tl-project-field (__tl-box-place payload-box) ty)]
            (ir.ir-instr-vector-store
              (ir.CompilerIrValue.Var
                (array-ref
                  group-bases
                  (opt-unroll-simd-memory-index
                    type-segment-bases
                    memory-bases
                    base
                    ty
                    0)))
              (ir.CompilerIrValue.I64 (* copy step))
              (opt-unroll-subst-value remap value)
              lanes
              ty))]
        [_ (opt-unroll-clone-instr remap cell copy instr)])]))

;; Emit sixteen sequential remapped copies.
(define (opt-unroll-simd-copies
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [memory-bases : OptUnrollSimdMemoryList]
  [group-bases : (__tl_dyn-array i64)]
  [step : i64]
  [copy : i64]) : ir.CompilerIrInstrList
  (if (>= copy 16)
    (ir.CompilerIrInstrList.Nil)
    (if (>= index last)
      (opt-unroll-simd-copies
        type-segment-bases
        instrs
        0
        last
        remap
        cell
        memory-bases
        group-bases
        step
        (+ copy 1))
      (let
        [cloned : ir.CompilerIrInstr
          (opt-unroll-simd-clone-instr
            type-segment-bases
            remap
            cell
            memory-bases
            group-bases
            step
            copy
            (ir.compiler-ir-instr-seq-ref instrs index))]
        (ir.compiler-ir-instr-cons
          cloned
          (opt-unroll-simd-copies
            type-segment-bases
            instrs
            (+ index 1)
            last
            remap
            cell
            memory-bases
            group-bases
            step
            copy))))))

(define (opt-unroll-simd-group-vars!
  [cell : (__tl_dyn-array i64)]
  [group-bases : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array.length group-bases))
    unit
    (begin
      (set! (array-ref group-bases index) (opt-unroll-alloc-var cell))
      (opt-unroll-simd-group-vars! cell group-bases (+ index 1)))))

(define (opt-unroll-simd-group-geps
  [memory-bases : OptUnrollSimdMemoryList]
  [group-bases : (__tl_dyn-array i64)]
  [index : i64]
  [group-index : i64]) : ir.CompilerIrInstrList
  (if (>= index (opt-unroll-simd-memory-count memory-bases))
    (ir.CompilerIrInstrList.Nil)
    (let
      [item : OptUnrollSimdMemory
        (opt-unroll-simd-memory-at memory-bases index)]
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.Gep
          (array-ref group-bases index)
          item.base
          (ir.CompilerIrValue.Var group-index)
          item.ty)
        (opt-unroll-simd-group-geps
          memory-bases
          group-bases
          (+ index 1)
          group-index)))))

(define (opt-unroll-simd-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [pred-label : i64]
  [loop-label : i64]
  [guard-block : ir.CompilerIrBlock]
  [unrolled-block : ir.CompilerIrBlock]
  [exit-block : ir.CompilerIrBlock]
  [original-block : ir.CompilerIrBlock]
  [guard-label : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (= label loop-label)
            (ir.compiler-ir-block-cons
              guard-block
              (ir.compiler-ir-block-cons
                unrolled-block
                (ir.compiler-ir-block-cons
                  exit-block
                  (ir.compiler-ir-block-cons
                    original-block
                    (opt-unroll-simd-rewrite-blocks
                      (__tl-box-place rest)
                      pred-label
                      loop-label
                      guard-block
                      unrolled-block
                      exit-block
                      original-block
                      guard-label)))))
            (ir.compiler-ir-block-cons
              (if (= label pred-label)
                (ir.compiler-ir-block
                  label
                  (opt-unroll-retarget-instrs instrs 0 loop-label guard-label))
                block)
              (opt-unroll-simd-rewrite-blocks
                (__tl-box-place rest)
                pred-label
                loop-label
                guard-block
                unrolled-block
                exit-block
                original-block
                guard-label)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-simd-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        pred-label
        loop-label
        guard-block
        unrolled-block
        exit-block
        original-block
        guard-label)]))

(define (opt-unroll-simd-apply
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [block : ir.CompilerIrBlock]
  [shape : OptUnrollSimdShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [cond-index : i64 shape.cond-index]
        [index-var : i64 shape.index-var]
        [step : i64 shape.step]
        [ity : ast.AstType shape.ity]
        [bound : ir.CompilerIrValue shape.bound]
        [cmp-op : ir.CompilerIrBinOp shape.cmp-op]
        [pred-label : i64 shape.pred-label]
        [tail-label : i64 shape.tail-label]
        [guard-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_guard"))]
        [unrolled-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_body"))]
        [exit-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__unroll_exit"))]
        [memory-bases : OptUnrollSimdMemoryList shape.memory-bases]
        [memory-count : i64 shape.memory-count]
        [remap : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [_fill : unit (opt-unroll-remap-fill remap 0)]
        [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
        [_cell : unit (set! (array-ref cell 0) frame)]
        [iu : i64 (opt-unroll-alloc-var cell)]
        [group-bases : (__tl_dyn-array i64) (array.make-array i64 memory-count)]
        [_group-bases : unit (opt-unroll-simd-group-vars! cell group-bases 0)]
        [copies : ir.CompilerIrInstrList
          (opt-unroll-simd-copies
            type-segment-bases
            instrs
            0
            (- cond-index 2)
            remap
            cell
            memory-bases
            group-bases
            step
            0)]
        [end-index : i64 (opt-unroll-alloc-var cell)]
        [end-next : i64 (opt-unroll-alloc-var cell)]
        [remainder-ok : i64 (opt-unroll-alloc-var cell)]
        [ngroup : i64 (opt-unroll-alloc-var cell)]
        [gwrap : i64 (opt-unroll-alloc-var cell)]
        [gfirst : i64 (opt-unroll-alloc-var cell)]
        [gok : i64 (opt-unroll-alloc-var cell)]
        [gu : i64 (opt-unroll-alloc-var cell)]
        [guard-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            guard-label
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                ngroup
                (ir.CompilerIrBinOp.Sub)
                bound
                (ir.CompilerIrValue.I64 (* step 16))
                ity)
              (ir.compiler-ir-instr-cons
                ;; Reject a wrapped bound - 16*step.
                (ir.CompilerIrInstr.BinOp
                  gwrap
                  (ir.CompilerIrBinOp.Le)
                  (ir.CompilerIrValue.Var ngroup)
                  bound
                  ity)
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    gfirst
                    cmp-op
                    (ir.CompilerIrValue.Var index-var)
                    (ir.CompilerIrValue.Var ngroup)
                    ity)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      gok
                      (ir.CompilerIrBinOp.And)
                      (ir.CompilerIrValue.Var gwrap)
                      (ir.CompilerIrValue.Var gfirst)
                      (ast.AstType.Bool))
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Branch
                        (ir.CompilerIrValue.Var gok)
                        unrolled-label
                        label)
                      (ir.CompilerIrInstrList.Nil)))))))]
        [unrolled-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            unrolled-label
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Phi
                iu
                (ir.compiler-ir-phi-input-cons
                  (ir.CompilerIrValue.Var index-var)
                  guard-label
                  (ir.compiler-ir-phi-input-cons
                    (ir.CompilerIrValue.Var end-index)
                    unrolled-label
                    (ir.CompilerIrPhiInputList.Nil)))
                ity)
              (opt-aggregate-instr-list-append
                (opt-unroll-simd-group-geps memory-bases group-bases 0 iu)
                (opt-aggregate-instr-list-append
                  copies
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      end-index
                      (ir.CompilerIrBinOp.Add)
                      (ir.CompilerIrValue.Var iu)
                      (ir.CompilerIrValue.I64 (* step 16))
                      ity)
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BinOp
                        end-next
                        (ir.CompilerIrBinOp.Add)
                        (ir.CompilerIrValue.Var end-index)
                        (ir.CompilerIrValue.I64 step)
                        ity)
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.BinOp
                          gu
                          cmp-op
                          (ir.CompilerIrValue.Var end-index)
                          (ir.CompilerIrValue.Var ngroup)
                          ity)
                        (ir.compiler-ir-instr-cons
                          (ir.CompilerIrInstr.Branch
                            (ir.CompilerIrValue.Var gu)
                            unrolled-label
                            exit-label)
                          (ir.CompilerIrInstrList.Nil)))))))))]
        [exit-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            exit-label
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Mov
                index-var
                (ir.CompilerIrValue.Var end-index)
                ity)
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Mov
                  shape.next-var
                  (ir.CompilerIrValue.Var end-next)
                  ity)
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    remainder-ok
                    cmp-op
                    (ir.CompilerIrValue.Var end-next)
                    bound
                    ity)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.Branch
                      (ir.CompilerIrValue.Var remainder-ok)
                      label
                      tail-label)
                    (ir.CompilerIrInstrList.Nil))))))]
        (OptUnrollResult.Result
          (opt-unroll-simd-rewrite-blocks
            blocks
            pred-label
            label
            guard-block
            unrolled-block
            exit-block
            block
            guard-label)
          (array-ref cell 0)
          true))]))

;; Per-invocation application budget shared by the loop passes (the unroller
;; and the single-block and multi-block bce_version drivers). A pass's driver
;; repeats its scan and applies to each eligible loop in scan order while its
;; budget lasts, verifying every application on its own. 2 pipeline iterations
;; x 4 = up to 8 applications per pass per function (2 today): enough to pick
;; up the hot loops the single-slot scheduler displaced in measured workloads
;; (the first eligible loop absorbed the whole invocation, leaving later loops
;; to the next pipeline iteration or stranded at the iteration cap), while
;; bounding code growth and the extra verify/context-rebuild cost.
(define (opt-loop-apply-budget) : i64
  4)

;; One scan applies at most one unroll; the driver repeats the scan while the
;; invocation's budget (opt-loop-apply-budget) lasts, and the pipeline fixpoint
;; picks up further loops on later iterations, bounding growth. The exact
;; constant-trip arm is tried first: when it applies it strictly dominates the
;; guarded x16 rewrite (no guard, no remainder loop).
(define (opt-unroll-blocks-scan
  [blocks : ir.CompilerIrBlockList]
  [remaining : ir.CompilerIrBlockList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-unroll-const-block-shape blocks entry-label block)
        [(OptUnrollConstMaybeShape.Some const-shape)
          (opt-unroll-const-apply blocks block const-shape frame)]
        [(OptUnrollConstMaybeShape.No)
          (match (opt-unroll-block-shape blocks entry-label block)
            [(OptUnrollMaybeShape.Some shape)
              (opt-unroll-apply blocks block shape frame)]
            [(OptUnrollMaybeShape.No)
              (opt-unroll-blocks-scan
                blocks
                (__tl-box-place rest)
                entry-label
                frame)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-blocks-scan
        blocks
        (ir.compiler-ir-block-seq-to-list seq)
        entry-label
        frame)]))

(define (opt-unroll-simd-instrs-have-store?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.VectorStore _) true]
      [_ (opt-unroll-simd-instrs-have-store? instrs (+ index 1))])))

(define (opt-unroll-simd-blocks-scan
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [remaining : ir.CompilerIrBlockList]
  [entry-label : i64]
  [frame : i64]
  [require-store? : bool]) : OptUnrollResult
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-unroll-simd-block-shape
        type-segment-bases
        blocks
        entry-label
        block)
        [(OptUnrollSimdMaybeShape.Some shape)
          (match block
            [(ir.CompilerIrBlock.Block _ instrs)
              (if (or
                (not require-store?)
                (opt-unroll-simd-instrs-have-store? instrs 0))
                (opt-unroll-simd-apply
                  type-segment-bases
                  blocks
                  block
                  shape
                  frame)
                (opt-unroll-simd-blocks-scan
                  type-segment-bases
                  blocks
                  (__tl-box-place rest)
                  entry-label
                  frame
                  require-store?))])]
        [(OptUnrollSimdMaybeShape.No)
          (opt-unroll-simd-blocks-scan
            type-segment-bases
            blocks
            (__tl-box-place rest)
            entry-label
            frame
            require-store?)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-simd-blocks-scan
        type-segment-bases
        blocks
        (ir.compiler-ir-block-seq-to-list seq)
        entry-label
        frame
        require-store?)]))

;; Cheap shape prescan: a candidate self-loop either starts with a Phi (the
;; canonical SSA form) or contains a mutable SIMD instruction (the SPMD gang
;; form), and ends with a conditional Branch whose true arm targets the block
;; itself. Most functions have neither, so skip the entry verify when no block
;; can possibly match.
(define (opt-unroll-block-candidate? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          false
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch _ true-label _)
              (and
                (= true-label label)
                (or
                  (ir.compiler-ir-instr-seq-phi? instrs 0)
                  (opt-unroll-simd-body-has-vector? instrs 0 (- count 1))))]
            [_ false])))]))

(define (opt-unroll-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-unroll-block-candidate? block)
        true
        (opt-unroll-blocks-have-candidate? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-blocks-have-candidate? (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-unroll-simd-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : ir.CompilerIrFunction]
  [require-store? : bool]) : OptFunctionCtxResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-unroll-simd-blocks-scan
        type-segment-bases
        blocks
        blocks
        (opt-cfg-entry-label blocks)
        frame
        require-store?)
        [(OptUnrollResult.Result next-blocks next-frame changed)
          (if changed
            (let
              [next : ir.CompilerIrFunction
                (ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  next-frame
                  next-blocks)]
              [next-context : OptCfgContext (opt-cfg-context-build next-blocks)]
              ;; Mutable SIMD IR is intentionally outside scalar SSA. Its
              ;; verifier contract is therefore the final/backend structural
              ;; contract; the exact local shape checks above establish the
              ;; dataflow used by the rewrite.
              (match (opt-verify-final-function next)
                [(ResultCompilerOptimizeVerify.Ok)
                  (OptFunctionCtxResult.Result next next-context)]
                [(ResultCompilerOptimizeVerify.Err _)
                  (OptFunctionCtxResult.Result func context)]))
            (OptFunctionCtxResult.Result func context))])]))

(define (opt-unroll-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
  (match func
    [(ir.CompilerIrFunction.Function _ params _ frame prescan-blocks)
      (if (or
        (opt-unroll-blocks-have-candidate? prescan-blocks)
        (opt-unroll-mb-blocks-have-candidate? prescan-blocks))
        (if verified?
          (opt-unroll-function-verified-with-context-result context true func)
          (match (opt-verify-function-with-context func context)
            [(ResultCompilerOptimizeVerify.Ok)
              (opt-unroll-function-verified-with-context-result
                context
                true
                func)]
            [(ResultCompilerOptimizeVerify.Err _)
              ;; SPMD vector state is deliberately mutable, so these functions
              ;; fail only the scalar single-definition contract. Admit just
              ;; the exact SIMD shape through the backend IR contract.
              (if (and
                (not (opt-verify-single-defs? params frame prescan-blocks))
                (opt-verify-ok? (opt-verify-final-function func)))
                (opt-unroll-simd-function-with-context-result
                  type-segment-bases
                  context
                  func
                  false)
                (OptFunctionCtxResult.Result func context))]))
        (OptFunctionCtxResult.Result func context))]))

;; Budgeted multi-application: each round scans for the first eligible loop,
;; rewrites it, rebuilds the function around the rewrite, and verifies that
;; rewrite on its own. A verified application spends one budget and the next
;; round runs on the new function; a verifier rejection stops the pass and
;; returns the last verified state, so a failed loop rolls back whole and
;; never consumes the run (the single-slot fallback, applied per loop). The
;; generated `__unroll_guard`/`__unroll_body` labels and the body-size cap
;; make a rewritten loop ineligible to its own shape scan, so later rounds
;; never re-process it.
(define (opt-unroll-function-budget-result
  [context : OptCfgContext]
  [func : ir.CompilerIrFunction]
  [budget : i64]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s current blocks.
  (if (<= budget 0)
    (OptFunctionCtxResult.Result func context)
    (match func
      [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
        (match (opt-unroll-blocks-scan
          blocks
          blocks
          (opt-cfg-entry-label blocks)
          frame)
          [(OptUnrollResult.Result next-blocks next-frame changed)
            (if changed
              (let
                [next : ir.CompilerIrFunction
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret-ty
                    next-frame
                    next-blocks)]
                ;; Unrolling rewrites the CFG, so build one fresh context for
                ;; the new blocks, reuse it for this round's verify, and hand
                ;; it to the next round.
                [next-context : OptCfgContext
                  (opt-cfg-context-build next-blocks)]
                (match (opt-verify-function-with-context next next-context)
                  [(ResultCompilerOptimizeVerify.Ok)
                    (opt-unroll-function-budget-result
                      next-context
                      next
                      (- budget 1))]
                  [(ResultCompilerOptimizeVerify.Err _)
                    (OptFunctionCtxResult.Result func context)]))
              ;; The original unroller's prescan and shape scanner only admit
              ;; a self-loop whose header is also its latch. A versioned
              ;; conditional body instead has a separate merge latch, so try
              ;; the conservative x2 diamond path over the natural-loop
              ;; records when the straight-line scan misses. That path keeps
              ;; its single slot per invocation.
              (let
                [loops : OptNaturalLoopList
                  (opt-cfg-natural-loops-with-context blocks context)]
                (match (opt-unroll-mb-loops-scan
                  blocks
                  loops
                  loops
                  (opt-cfg-entry-label blocks)
                  frame)
                  [(OptUnrollResult.Result mb-blocks mb-frame mb-changed)
                    (if mb-changed
                      (let
                        [mb-next : ir.CompilerIrFunction
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            mb-frame
                            mb-blocks)]
                        [mb-context : OptCfgContext
                          (opt-cfg-context-build mb-blocks)]
                        (match (opt-verify-function-with-context
                          mb-next
                          mb-context)
                          [(ResultCompilerOptimizeVerify.Ok)
                            (OptFunctionCtxResult.Result mb-next mb-context)]
                          [(ResultCompilerOptimizeVerify.Err _)
                            (OptFunctionCtxResult.Result func context)]))
                      (OptFunctionCtxResult.Result func context))])))])])))

(define (opt-unroll-function-verified-with-context-result
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (opt-unroll-function-budget-result context func (opt-loop-apply-budget))]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-unroll-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-unroll-function-with-context-result
        type-segment-bases
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- byte-compose -> wide-load combining (load_combine) ------------------------
;;
;; After the constant-trip unroller, an 8-byte little-endian compose appears as
;; straight-line IR: per step a BoundsCheck, a u8 Gep, a u8 Load, a zero-extend
;; Cast, a `shl acc, 8` (or `mul acc, 256`), and a `bit_or` (or an `add` of a
;; single byte). When eight zero-extended byte loads sit at CONSECUTIVE literal
;; offsets from one resolved base and the shift/or tree places each byte at
;; shift 8*(offset - min), the compose is exactly one little-endian i64 load at
;; base+min on x86_64. This pass rewrites the chain ROOT -- the outermost
;; or/add -- into that one wide Load in place and DELETES the chain elements
;; itself: the pipeline DCE treats every shift as potentially trapping
;; (`opt-binop-traps?`), so the dead shl/or spine would otherwise pin the byte
;; loads and casts in the emitted code. Deletion is exact here: every element
;; is proven single-use function-wide, every shl carries a literal count that
;; is a multiple of 8 BELOW the i64 width (k in {8..56} -- a literal count of
;; 64 or more, e.g. `shl 0, 64` on a neutral seed, is rejected because the
;; shift itself can trap at runtime), every mul is restricted to the literal
;; 256, and the remaining element kinds (Mov, Cast, BitOr, Add, byte Load)
;; cannot trap, so every deleted instruction is provably non-trapping. The
;; address temps (geps, base+literal adds) are not elements, so the checks'
;; inputs stay.
;; The pass rewrites instructions only (no CFG or frame change) and is
;; idempotent: the root is no longer an or/add afterwards, so a second run is
;; a no-op.
;;
;; Soundness:
;; - BoundsCheck instructions are never touched, removed, or reordered. The
;;   wide load takes the root's position, which follows every chain element
;;   (SSA def-before-use within the block), hence follows every byte's check:
;;   a check that would abort still aborts before the wide load executes, and
;;   when all checks pass the eight bytes are in bounds, so the wide load
;;   cannot fault where the byte loads would not have.
;; - The wide load reads the union of the chain's bytes at the root position,
;;   so a memory write between the first byte load and the root could change a
;;   byte's value: any store/call/syscall between the earliest chain load and
;;   the root rejects the chain.
;; - Value-chain elements (loads, casts, shifts, ors, compose movs) must be
;;   single-use function-wide: they are deleted by this pass, and an outside
;;   user would otherwise keep a byte load alive next to the wide load (still
;;   sound, but rejected to keep the rewrite strictly shrinking).
;; - Address temps (the Gep and the base+literal add) are exempt from the
;;   single-use rule: the checks share them, they are pure, and the
;;   min-offset Gep is reused as the wide load's address.
;; - v1 folds 8-byte chains whose root type is i64/u64 only; shorter chains
;;   would need a narrow load plus a widening cast (an extra instruction slot)
;;   and are rejected.
(define (opt-load-combine-root-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.BitOr) true]
    [(ir.CompilerIrBinOp.Add) true]
    [_ false]))

(define (opt-load-combine-wide-ty? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [_ false]))

;; Instructions that may write memory the byte loads could read. Calls and
;; syscalls are included conservatively; pure arithmetic, loads, checks, and
;; address formation are not barriers.
(define (opt-load-combine-may-write? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.Store _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.SpmdCall _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(ir.CompilerIrInstr.Syscall _ _) true]
    [(ir.CompilerIrInstr.VectorStore _) true]
    [(ir.CompilerIrInstr.PredicatedStore _) true]
    [_ false]))

(define (opt-load-combine-scan-candidate?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [roots? : bool]
  [bytes? : bool]) : bool
  (if (and roots? bytes?)
    true
    (if (>= index count)
      false
      (opt-load-combine-scan-candidate?
        slots
        (+ index 1)
        count
        (or
          roots?
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.BinOp _ op _ _ ty)
              (and
                (opt-load-combine-root-op? op)
                (opt-load-combine-wide-ty? ty))]
            [_ false]))
        (or
          bytes?
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.Load _ _ ty)
              (match ty
                [(ast.AstType.U8) true]
                [_ false])]
            [_ false]))))))

(define (opt-load-combine-block-candidate? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-load-combine-scan-candidate?
        instrs.slots
        0
        (ir.compiler-ir-instr-seq-count instrs)
        false
        false)]))

(define (opt-load-combine-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-load-combine-block-candidate? block)
        true
        (opt-load-combine-blocks-have-candidate? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-combine-blocks-have-candidate?
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Single-block def index: var -> instruction index (SSA single-def makes the
;; mapping unique).
(define (opt-load-combine-defs-fill
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [defs : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index count)
    defs
    (let
      [dst : i64 (ir.compiler-ir-instr-array-loop-dst-or slots index (- 0 1))]
      [next : opt_i64_i64_map.Map defs]
      (begin
        (if (>= dst 0)
          (opt_i64_i64_map.insert-ref! (&mut next) dst index)
          unit)
        (opt-load-combine-defs-fill slots (+ index 1) count next)))))

;; Chain analysis state, one scratch array per function pass, slots:
;;   0 byte count, 1 resolved gep base var (-1 unset), 2 offset-add lhs var
;;   (-1 for a plain literal offset), 3 earliest byte-load position,
;;   4 bitmask of recorded shift indices (literal offsets may be negative, so
;;   an empty slot cannot be told from one holding a negative offset),
;;   5 chain element count, 8..15 source byte offset per shift index,
;;   16..23 gep var per shift index, 24..87 chain element instruction indices
;;   (deleted on a successful fold; 64 slots, an 8-byte chain needs ~40).
(define (opt-load-combine-state-reset
  [state : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length state))
    unit
    (begin
      (set! (array-ref state index) (- 0 1))
      (opt-load-combine-state-reset state (+ index 1)))))

;; A chain element must be used exactly once function-wide (by the next chain
;; link); anything else rejects the fold.
(define (opt-load-combine-single-use? [uses : (__tl_dyn-array i64)] [var : i64]) : bool
  (and (>= var 0) (< var (array-length uses)) (= (array-ref uses var) 1)))

;; Record one chain element instruction for deletion; the count cap only
;; bounds the scratch (a deep but ultimately rejected chain never overflows
;; it, it just stops early).
(define (opt-load-combine-record-element
  [state : (__tl_dyn-array i64)]
  [index : i64]) : bool
  (let
    [n : i64 (array-ref state 5)]
    (if (>= n 64)
      false
      (begin
        (set! (array-ref state (+ 24 n)) index)
        (set! (array-ref state 5) (+ n 1))
        true))))

;; Resolve a var through same-block Mov copies (fuel-bounded), used for both
;; the compose accumulator chain and the gep base/offset temps.
(define (opt-load-combine-resolve
  [instrs : ir.CompilerIrInstrSeq]
  [defs : opt_i64_i64_map.Map]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (let
      [index : i64 (opt_i64_i64_map.get-value-or (& defs) var (- 0 1))]
      (if (< index 0)
        var
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Mov _ src _)
            (match src
              [(ir.CompilerIrValue.Var src-id)
                (opt-load-combine-resolve instrs defs src-id (- fuel 1))]
              [_ var])]
          [_ var])))))

;; Record one byte leaf: `cast (load (gep base, off : u8) : u8) : i64/u64` at
;; shift index `shift`. Fills the state's offset/gep slots and the shared base
;; key; rejects anything off the exact shape.
(define (opt-load-combine-record-leaf
  [instrs : ir.CompilerIrInstrSeq]
  [defs : opt_i64_i64_map.Map]
  [uses : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [gep-var : i64]
  [load-var : i64]
  [load-pos : i64]
  [shift : i64]) : bool
  (if (or
    (< shift 0)
    (> shift 7)
    (not (opt-load-combine-single-use? uses load-var))
    ;; one byte per shift index
    (!= (bit-and (array-ref state 4) (shl 1 shift)) 0)
    (not (opt-load-combine-record-element state load-pos)))
    false
    (let
      [gep-index : i64 (opt_i64_i64_map.get-value-or (& defs) gep-var (- 0 1))]
      (if (< gep-index 0)
        false
        (match (ir.compiler-ir-instr-seq-ref instrs gep-index)
          [(ir.CompilerIrInstr.Gep _ base offset gep-ty)
            (match gep-ty
              [(ast.AstType.U8)
                (match base
                  [(ir.CompilerIrValue.Var base-id)
                    (let
                      [resolved-base : i64
                        (opt-load-combine-resolve instrs defs base-id 16)]
                      (match offset
                        [(ir.CompilerIrValue.I64 k)
                          (opt-load-combine-leaf-slot
                            state
                            resolved-base
                            (- 0 1)
                            k
                            gep-var
                            load-pos
                            shift)]
                        [(ir.CompilerIrValue.Var off-id)
                          (let
                            [resolved-off : i64
                              (opt-load-combine-resolve instrs defs off-id 16)]
                            [off-index : i64
                              (opt_i64_i64_map.get-value-or
                                (& defs)
                                resolved-off
                                (- 0 1))]
                            (if (< off-index 0)
                              false
                              (match (ir.compiler-ir-instr-seq-ref
                                instrs
                                off-index)
                                [(ir.CompilerIrInstr.BinOp
                                    _
                                    add-op
                                    add-lhs
                                    add-rhs
                                    _)
                                  (match add-op
                                    [(ir.CompilerIrBinOp.Add)
                                      (match add-lhs
                                        [(ir.CompilerIrValue.Var x)
                                          (match add-rhs
                                            [(ir.CompilerIrValue.I64 k)
                                              (opt-load-combine-leaf-slot
                                                state
                                                resolved-base
                                                (opt-load-combine-resolve
                                                  instrs
                                                  defs
                                                  x
                                                  16)
                                                k
                                                gep-var
                                                load-pos
                                                shift)]
                                            [_ false])]
                                        [(ir.CompilerIrValue.I64 k)
                                          (match add-rhs
                                            [(ir.CompilerIrValue.Var x)
                                              (opt-load-combine-leaf-slot
                                                state
                                                resolved-base
                                                (opt-load-combine-resolve
                                                  instrs
                                                  defs
                                                  x
                                                  16)
                                                k
                                                gep-var
                                                load-pos
                                                shift)]
                                            [_ false])]
                                        [_ false])]
                                    [_ false])]
                                [_ false])))]
                        [_ false]))]
                  [_ false])]
              [_ false])]
          [_ false])))))

;; Shared tail of leaf recording: check/update the base key, then store the
;; byte's offset/gep/position.
(define (opt-load-combine-leaf-slot
  [state : (__tl_dyn-array i64)]
  [base-a : i64]
  [base-b : i64]
  [offset : i64]
  [gep-var : i64]
  [load-pos : i64]
  [shift : i64]) : bool
  (let
    [known-a : i64 (array-ref state 1)]
    [known-b : i64 (array-ref state 2)]
    (if (if (< known-a 0)
      (begin
        (set! (array-ref state 1) base-a)
        (set! (array-ref state 2) base-b)
        true)
      (and (= known-a base-a) (= known-b base-b)))
      (begin
        (set! (array-ref state 4) (bit-or (array-ref state 4) (shl 1 shift)))
        (set! (array-ref state (+ 8 shift)) offset)
        (set! (array-ref state (+ 16 shift)) gep-var)
        (set! (array-ref state 0) (+ (array-ref state 0) 1))
        (if (or (< (array-ref state 3) 0) (< load-pos (array-ref state 3)))
          (set! (array-ref state 3) load-pos)
          unit)
        true)
      false)))

;; Analyze `value` as a byte-compose subexpression whose bytes all sit at
;; `shift`..`shift+7` byte positions. Mutates the state; returns false on any
;; off-shape construct. The literal 0 is the neutral seed (shl/or of it
;; contributes no bytes).
(define (opt-load-combine-analyze
  [instrs : ir.CompilerIrInstrSeq]
  [defs : opt_i64_i64_map.Map]
  [uses : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]
  [shift : i64]
  [fuel : i64]) : bool
  (if (<= fuel 0)
    false
    (match value
      [(ir.CompilerIrValue.I64 k) (= k 0)]
      [(ir.CompilerIrValue.Var id)
        (let
          [index : i64 (opt_i64_i64_map.get-value-or (& defs) id (- 0 1))]
          (if (< index 0)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs index)
              [(ir.CompilerIrInstr.Mov dst src _)
                (if (and
                  (opt-load-combine-single-use? uses dst)
                  (opt-load-combine-record-element state index))
                  (opt-load-combine-analyze
                    instrs
                    defs
                    uses
                    state
                    src
                    shift
                    (- fuel 1))
                  false)]
              [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
                (if (not
                  (and
                    (opt-load-combine-wide-ty? ty)
                    (opt-load-combine-single-use? uses dst)
                    (opt-load-combine-record-element state index)))
                  false
                  (match op
                    [(ir.CompilerIrBinOp.BitOr)
                      (and
                        (opt-load-combine-analyze
                          instrs
                          defs
                          uses
                          state
                          lhs
                          shift
                          (- fuel 1))
                        (opt-load-combine-analyze
                          instrs
                          defs
                          uses
                          state
                          rhs
                          shift
                          (- fuel 1)))]
                    [(ir.CompilerIrBinOp.Add)
                      ;; `add` composes like `or` only when one side is itself a
                      ;; single zero-extended byte load of the chain.
                      (if (opt-load-combine-leaf? instrs defs lhs)
                        (and
                          (opt-load-combine-analyze
                            instrs
                            defs
                            uses
                            state
                            lhs
                            shift
                            (- fuel 1))
                          (opt-load-combine-analyze
                            instrs
                            defs
                            uses
                            state
                            rhs
                            shift
                            (- fuel 1)))
                        (if (opt-load-combine-leaf? instrs defs rhs)
                          (and
                            (opt-load-combine-analyze
                              instrs
                              defs
                              uses
                              state
                              lhs
                              shift
                              (- fuel 1))
                            (opt-load-combine-analyze
                              instrs
                              defs
                              uses
                              state
                              rhs
                              shift
                              (- fuel 1)))
                          false))]
                    [(ir.CompilerIrBinOp.Shl _)
                      ;; The count must be a multiple of 8 below the i64 width:
                      ;; k in {8..56}. k >= 64 (e.g. `shl 0, 64` on a neutral
                      ;; seed, which otherwise analyzes fine at shift 8) would
                      ;; make the recorded element deletable even though the
                      ;; shift itself can trap at runtime -- rejecting here
                      ;; keeps every deleted instruction provably non-trapping.
                      (match rhs
                        [(ir.CompilerIrValue.I64 k)
                          (if (and
                            (> k 0)
                            (< k 64)
                            (= (% k 8) 0)
                            (<= (+ shift (/ k 8)) 8))
                            (opt-load-combine-analyze
                              instrs
                              defs
                              uses
                              state
                              lhs
                              (+ shift (/ k 8))
                              (- fuel 1))
                            false)]
                        [_ false])]
                    [(ir.CompilerIrBinOp.Mul)
                      (match rhs
                        [(ir.CompilerIrValue.I64 k)
                          (if (= k 256)
                            (opt-load-combine-analyze
                              instrs
                              defs
                              uses
                              state
                              lhs
                              (+ shift 1)
                              (- fuel 1))
                            false)]
                        [_
                          (match lhs
                            [(ir.CompilerIrValue.I64 k)
                              (if (= k 256)
                                (opt-load-combine-analyze
                                  instrs
                                  defs
                                  uses
                                  state
                                  rhs
                                  (+ shift 1)
                                  (- fuel 1))
                                false)]
                            [_ false])])]
                    [_ false]))]
              [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
                (if (not
                  (and
                    (match from-ty
                      [(ast.AstType.U8) true]
                      [_ false])
                    (opt-load-combine-wide-ty? to-ty)
                    (opt-load-combine-single-use? uses dst)
                    (opt-load-combine-record-element state index)))
                  false
                  (match src
                    [(ir.CompilerIrValue.Var load-var)
                      (let
                        [load-index : i64
                          (opt_i64_i64_map.get-value-or
                            (& defs)
                            load-var
                            (- 0 1))]
                        (if (< load-index 0)
                          false
                          (match (ir.compiler-ir-instr-seq-ref
                            instrs
                            load-index)
                            [(ir.CompilerIrInstr.Load _ load-src load-ty)
                              (match load-ty
                                [(ast.AstType.U8)
                                  (match load-src
                                    [(ir.CompilerIrValue.Var gep-var)
                                      (opt-load-combine-record-leaf
                                        instrs
                                        defs
                                        uses
                                        state
                                        gep-var
                                        load-var
                                        load-index
                                        shift)]
                                    [_ false])]
                                [_ false])]
                            [_ false])))]
                    [_ false]))]
              [_ false])))]
      [_ false])))

;; Is `value` a zero-extended byte load of the chain shape (without recording)?
(define (opt-load-combine-leaf?
  [instrs : ir.CompilerIrInstrSeq]
  [defs : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var id)
      (let
        [index : i64 (opt_i64_i64_map.get-value-or (& defs) id (- 0 1))]
        (if (< index 0)
          false
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
              (and
                (match from-ty
                  [(ast.AstType.U8) true]
                  [_ false])
                (opt-load-combine-wide-ty? to-ty)
                (match src
                  [(ir.CompilerIrValue.Var load-var)
                    (let
                      [load-index : i64
                        (opt_i64_i64_map.get-value-or (& defs) load-var (- 0 1))]
                      (if (< load-index 0)
                        false
                        (match (ir.compiler-ir-instr-seq-ref instrs load-index)
                          [(ir.CompilerIrInstr.Load _ _ load-ty)
                            (match load-ty
                              [(ast.AstType.U8) true]
                              [_ false])]
                          [_ false])))]
                  [_ false]))]
            [_ false])))]
    [_ false]))

;; No may-write instruction between the earliest chain byte load and the root:
;; the wide load reads every byte at the root's position.
(define (opt-load-combine-barrier-free?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [root-index : i64]) : bool
  (if (>= index root-index)
    true
    (if (opt-load-combine-may-write?
      (ir.compiler-ir-instr-seq-ref instrs index))
      false
      (opt-load-combine-barrier-free? instrs (+ index 1) root-index))))

;; The recorded bytes must be exactly b0..b7 with the byte at shift i read
;; from offset min+i (an exact little-endian compose: no gaps, no overlaps, no
;; reordering). Returns the gep var of the minimum-offset byte (the wide
;; load's address) or -1.
(define (opt-load-combine-exact-le-gep [state : (__tl_dyn-array i64)]) : i64
  (if (!= (array-ref state 0) 8)
    (- 0 1)
    (opt-load-combine-exact-le-gep-check state 1 (array-ref state 8))))

(define (opt-load-combine-exact-le-gep-check
  [state : (__tl_dyn-array i64)]
  [index : i64]
  [min-offset : i64]) : i64
  (if (>= index 8)
    (array-ref state 16)
    (if (= (array-ref state (+ 8 index)) (+ min-offset index))
      (opt-load-combine-exact-le-gep-check state (+ index 1) min-offset)
      (- 0 1))))

;; Try one root instruction; returns the wide-load gep var or -1.
(define (opt-load-combine-try-root
  [instrs : ir.CompilerIrInstrSeq]
  [defs : opt_i64_i64_map.Map]
  [uses : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [root-index : i64]
  [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (if (not
        (and (opt-load-combine-root-op? op) (opt-load-combine-wide-ty? ty)))
        (- 0 1)
        (begin
          (opt-load-combine-state-reset state 0)
          (set! (array-ref state 0) 0)
          (set! (array-ref state 4) 0)
          (set! (array-ref state 5) 0)
          (if (and
            (opt-load-combine-analyze instrs defs uses state lhs 0 128)
            (opt-load-combine-analyze instrs defs uses state rhs 0 128)
            (>= (array-ref state 3) 0)
            (opt-load-combine-barrier-free?
              instrs
              (+ (array-ref state 3) 1)
              root-index))
            (opt-load-combine-exact-le-gep state)
            (- 0 1))))]
    [_ (- 0 1)]))

(define (opt-load-combine-mark-deletes
  [deletes : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-ref state 5))
    unit
    (begin
      (set! (array-ref deletes (array-ref state (+ 24 index))) 1)
      (opt-load-combine-mark-deletes deletes state (+ index 1)))))

(define (opt-load-combine-block-rewrite-roots
  [instrs : ir.CompilerIrInstrSeq]
  [defs : opt_i64_i64_map.Map]
  [uses : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [rewrites : (__tl_dyn-array i64)]
  [deletes : (__tl_dyn-array i64)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    0
    (let
      [found : i64
        (opt-load-combine-try-root
          instrs
          defs
          uses
          state
          index
          (ir.compiler-ir-instr-seq-ref instrs index))]
      (begin
        (if (>= found 0)
          (begin
            (set! (array-ref rewrites index) found)
            (opt-load-combine-mark-deletes deletes state 0))
          unit)
        (+
          (if (>= found 0)
            1
            0)
          (opt-load-combine-block-rewrite-roots
            instrs
            defs
            uses
            state
            rewrites
            deletes
            (+ index 1)
            count))))))

(define (opt-load-combine-rebuild-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [rewrites : (__tl_dyn-array i64)]
  [deletes : (__tl_dyn-array i64)]
  [index : i64]
  [count : i64]) : ir.CompilerIrInstrList
  (if (>= index count)
    (ir.CompilerIrInstrList.Nil)
    (if (= (array-ref deletes index) 1)
      (opt-load-combine-rebuild-instrs
        instrs
        rewrites
        deletes
        (+ index 1)
        count)
      (let
        [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
        (ir.compiler-ir-instr-cons
          (if (>= (array-ref rewrites index) 0)
            (match instr
              [(ir.CompilerIrInstr.BinOp dst _ _ _ ty)
                (ir.CompilerIrInstr.Load
                  dst
                  (ir.CompilerIrValue.Var (array-ref rewrites index))
                  ty)]
              [_ instr])
            instr)
          (opt-load-combine-rebuild-instrs
            instrs
            rewrites
            deletes
            (+ index 1)
            count))))))

;; One block: candidate prescan, def index, root scan, then a rebuild only
;; when at least one root folded.
(define (opt-load-combine-block
  [uses : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (not (opt-load-combine-block-candidate? block))
        block
        (let
          [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
          [defs : opt_i64_i64_map.Map
            (opt-load-combine-defs-fill
              instrs.slots
              0
              count
              (opt_i64_i64_map.with-capacity 64))]
          [rewrites : (__tl_dyn-array i64) (array.make-array i64 count)]
          [deletes : (__tl_dyn-array i64) (array.make-array i64 count)]
          [_fill : unit
            (let
              [i : i64 0]
              (while (< i count)
                (begin
                  (set! (array-ref rewrites i) (- 0 1))
                  (set! (array-ref deletes i) 0)
                  (set! i (+ i 1)))))]
          [folded : i64
            (opt-load-combine-block-rewrite-roots
              instrs
              defs
              uses
              state
              rewrites
              deletes
              0
              count)]
          (if (> folded 0)
            (ir.compiler-ir-block
              label
              (opt-load-combine-rebuild-instrs instrs rewrites deletes 0 count))
            block)))]))

(define (opt-load-combine-blocks-walk
  [uses : (__tl_dyn-array i64)]
  [state : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-load-combine-block uses state block)
        (opt-load-combine-blocks-walk uses state (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-load-combine-blocks-walk
        uses
        state
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Entry: a function with no candidate block (an i64/u64 or/add next to a u8
;; load) is returned untouched, so the common case pays one instruction scan.
(define (opt-load-combine-blocks
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (opt-load-combine-blocks-have-candidate? blocks)
    (opt-load-combine-blocks-walk
      (opt-collect-blocks-uses-array frame blocks)
      (array.make-array i64 88)
      blocks)
    blocks))

;; --- bounds-check loop versioning (codegen phase 7) ---------------------------
;;
;; A canonical counted self-loop pays cmp+jb per BoundsCheck per iteration even
;; though the whole trip range is decidable up front: for a check
;; `BoundsCheck(idx, len)` with loop-invariant `len`,
;;   * idx == the counter phi      -> every trip index lies in [seed, bound),
;;     so `seed >= 0 && bound <= len` (signed) proves every check passes;
;;   * idx == BitAnd(_, M), M >= 0 -> the index lies in [0, M], so `M < len`;
;;   * idx == scale*counter+k (literal coefficients, scale > 0), or the same
;;     PLUS a loop-invariant VARIABLE base B when scale > 1 (either Add
;;     operand order), or idx == B + dphi + k with dphi a derived induction
;;     phi (invariant init, literal step > 1) -> a wrap-safe quotient guard
;;     over the trip range; the variable-base forms synthesize the derived
;;     seed in the guard (see opt-bce-version-var-base-scaled-guard and
;;     opt-bce-version-var-base-derived-guard);
;;   * idx == B + counter + k with B a loop-invariant VARIABLE base (SCALE 1,
;;     either Add operand order) -> the no-division scale-1 specialization
;;     `B_eff >= 0 && bound-1 <= len-1-B_eff` (opt-bce-version-var-base-guard,
;;     shared with the multi-block pass), admitted ONLY when at least TWO of
;;     the loop's checks are eliminable. That gate is guard economics, not
;;     soundness. One guard per loop ENTRY buys `2 * checks` instructions per
;;     TRIP, and a measured scale-1 guard is ~12 instructions for one array
;;     and ~17 for two, so break-even sits near 8 trips at one removed check
;;     and 4 at two. Measured on intern_table: it-hash-words' tail loop is
;;     one check at 3.5 trips/entry (a 7M-instruction LOSS -- it stays out
;;     under the gate), while it-intern-slice's miss-copy loop is two checks
;;     at 21 trips/entry (+2.8M) and stdlib's byte-buf slot copy is two
;;     checks at a whole-buffer trip count (+5.9M). Requiring two eliminable
;;     checks is the cheapest static proxy that separates them: it doubles
;;     the per-trip return while the guard grows by well under 2x. The
;;     multi-block pass admits scale 1 unconditionally because its clone
;;     already amortizes a whole multi-block body per entry;
;;   * idx loop-invariant          -> `idx >= 0 && idx < len`.
;; The loop is VERSIONED on the conjunction: a fresh guard block on the entry
;; edge branches to a check-free fast clone when every condition holds and to
;; the original checked loop otherwise. Semantics are exact: the fast clone
;; runs only when no check could abort, the slow path is the unmodified
;; original, and a conservatively-false guard (e.g. a negative length's signed
;; compare) merely keeps the slow path, so nothing relies on lengths being
;; non-negative. Store-bearing bodies are ADMITTED (unlike the unroller):
;; under a true guard the clone is instruction-for-instruction the original.
;;
;; The counter may step by ANY positive literal (`i += 8` for a word-strided
;; loader), not just +1. Every derivation above reasons about the SET of
;; executed-trip counter values, which for any positive step is a subset of
;; [seed, bound-1] -- strictly increasing visits that pass the signed
;; `counter < bound` latch test -- so each guard is step-independent AS LONG
;; AS the counter cannot wrap past i64 MAX. A wrapped counter would go
;; negative, satisfy the signed latch test again, and execute trips the range
;; argument never covered. Step 1 cannot wrap (`last <= bound-1` gives
;; `last+1 <= bound <= MAX`); a larger step can (`last + step` reaches
;; `bound-1+step`). The guard therefore gains one more condition whenever a
;; counter-bearing derivation fired and the step is greater than 1
;; (opt-bce-version-guard-finish):
;;
;;   wrap(bound + step - 1) >= bound     (signed)
;;
;; which decides exactly `bound <= i64-MAX - step + 1` (see the finisher for
;; the two-case argument) in one add plus one compare, with no 64-bit
;; immediate to materialize. With it, `last + step <= bound-1+step <= MAX` is
;; representable, the counter strictly increases without wrapping, the loop
;; terminates exactly when the mathematical counter reaches `bound`, and every
;; executed trip's counter lies in [seed, bound-1] -- precisely what the
;; derivations assume. A bound that violates it merely deselects the fast path
;; (a literal bound that can never satisfy it rejects the versioning outright,
;; like a literal negative seed).
;;
;; A check whose condition cannot be derived no longer rejects the loop: with
;; at least one derived check the loop PARTIALLY versions, and each
;; underivable check STAYS (remapped) in the fast clone, preserving the slow
;; path's exact abort semantics for its index. The guard then constrains only
;; the removed checks; kept checks still execute (and may still abort) on the
;; fast path. A kept check was underivable when its clone was built, so the
;; fast clone cannot re-version on a later pipeline round.
;;
;; Exit wiring exploits the post-rotation invariant: the loop block does not
;; dominate its exit when the exit has another predecessor, so loop defs reach
;; outside code only as exit-phi inputs on the loop edge -- each such input
;; gains a parallel input from the fast clone. Any remaining direct outside
;; use of a loop def (the never-rotated single-pred-exit case) rejects.
;;
;; The pass runs between induction and unroll so the fast clone -- now a pure
;; whitelisted body -- unrolls in the SAME pipeline iteration. Rejections:
;; non-canonical counters, multi-block loops, a loop with NO derivable check,
;; and pre-existing version labels (idempotence). Verifier-gated
;; with fallback like unroll.
(defenum OptBceVersionGuardAcc
  (No)
  (Some ir.CompilerIrInstrList ir.CompilerIrValueList bool))

(defenum OptBceVersionGuardResult
  (No)
  (Some ir.CompilerIrInstrSeq ir.CompilerIrValue))

;; Underivable checks kept in the fast clone, identified by instruction index:
;; guard derivation and cloning walk the same block instruction sequence in
;; the same order, so the index is a stable identity between the two.
(defstruct OptBceVersionKeep
  (present (__tl_dyn-array bool))
  (count i64))

(define (opt-bce-version-keep-new [index-bound : i64]) : OptBceVersionKeep
  (OptBceVersionKeep (array.make-array bool index-bound) 0))

(define (opt-bce-version-keep-add [keep : OptBceVersionKeep] [index : i64]) : OptBceVersionKeep
  (if (and
    (>= index 0)
    (< index (array-length keep.present))
    (not (array-ref keep.present index)))
    (begin
      (set! (array-ref keep.present index) true)
      (OptBceVersionKeep keep.present (+ keep.count 1)))
    keep))

(define (opt-bce-version-keep-contains?
  [keep : OptBceVersionKeep]
  [index : i64]) : bool
  (and
    (>= index 0)
    (< index (array-length keep.present))
    (array-ref keep.present index)))

(cfg
  test
  (test
    optimizer-bce-version-keep-indexed-membership
    (let
      [keep : OptBceVersionKeep (opt-bce-version-keep-new 9)]
      (begin
        (set! keep (opt-bce-version-keep-add keep 0))
        (set! keep (opt-bce-version-keep-add keep 8))
        ;; Re-adding an index is set insertion, not another stored element.
        (set! keep (opt-bce-version-keep-add keep 8))
        (test.assert-true
          (opt-bce-version-keep-contains? keep 0)
          "BCE keep set preserves its first instruction index")
        (test.assert-true
          (opt-bce-version-keep-contains? keep 8)
          "BCE keep set reaches the observed instruction bound")
        (test.assert-true
          (not (opt-bce-version-keep-contains? keep 4))
          "BCE keep set leaves absent indexes clear")
        (test.assert-true
          (not (opt-bce-version-keep-contains? keep 9))
          "BCE keep set rejects indexes outside its bound")
        (test.assert-i64-eq
          keep.count
          2
          "BCE keep set ignores duplicate insertion")))))

;; Derivation fold state: the guard accumulator (conditions for REMOVED
;; checks), the kept-check set, and how many checks derived -- partial
;; versioning requires at least one derivable check to make cloning pay.
(defstruct OptBceVersionDerive
  (guard OptBceVersionGuardAcc)
  (keep OptBceVersionKeep)
  (derived i64))

;; guard-conds output: the guard instructions + value plus the kept-check set
;; the clone must preserve (remapped) instead of dropping.
(defenum OptBceVersionGuardOut
  (No)
  (Some ir.CompilerIrInstrSeq ir.CompilerIrValue OptBceVersionKeep))

(define (opt-bce-version-body-max) : i64
  48)

;; Clonable body kinds: everything the unroll cloner can remap, INCLUDING
;; StorePtr (fills and container writes version fine) and BoundsCheck (the
;; checks being removed from the clone).
(define (opt-bce-version-body-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [_ false]))

(define (opt-bce-version-body-instr-seq-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (opt-bce-version-body-instr-ok? (ir.compiler-ir-instr-seq-ref instrs index)))

(define (opt-bce-version-body-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-bce-version-body-instr-seq-ok? instrs index)
      (opt-bce-version-body-ok? instrs (+ index 1) last))))

(define (opt-bce-version-check-count
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [acc : i64]) : i64
  (if (>= index last)
    acc
    (opt-bce-version-check-count
      instrs
      (+ index 1)
      last
      (if (ir.compiler-ir-instr-seq-bounds-check? instrs index)
        (+ acc 1)
        acc))))

(define (opt-bce-version-alloc-var [cell : (__tl_dyn-array i64)]) : i64
  (let
    [next : i64 (array-ref cell 0)]
    (begin
      (set! (array-ref cell 0) (+ next 1))
      next)))

;; One derived guard condition instruction; conds accumulate as (instr, value)
;; so the And chain can be assembled afterwards.
;; One guard conjunct with an explicit operand type. Every conjunct the
;; trip-range derivations build is a SIGNED i64 comparison (that is the type
;; their range arguments are stated in); the cross-array fusion needs an
;; UNSIGNED one, because the fact a BoundsCheck leaves behind is the unsigned
;; `index <u length` its lowering tests. The guard-fact folding below only
;; reuses signed-i64 conjuncts (`opt-bce-fold-collect`), so an unsigned one
;; decides only the check it was emitted for.
(define (opt-bce-version-cond-typed
  [cell : (__tl_dyn-array i64)]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some instrs values counter-seen)
      (let
        [dst : i64 (opt-bce-version-alloc-var cell)]
        (OptBceVersionGuardAcc.Some
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
            instrs)
          (ir.compiler-ir-value-cons (ir.CompilerIrValue.Var dst) values)
          counter-seen))]))

(define (opt-bce-version-cond
  [cell : (__tl_dyn-array i64)]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (opt-bce-version-cond-typed cell op lhs rhs (ast.AstType.I64) acc))

(define (opt-bce-version-cond-counter-seen [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some instrs values _)
      (OptBceVersionGuardAcc.Some instrs values true)]))

;; Resolve through same-block Mov copies AND 64-bit int reinterpret casts:
;; lowered index/length operands routinely arrive as `(cast x : u64)`-shaped
;; bit-preserving reinterprets (the #930 argument bounds-dom also relies on).
(define (opt-bce-version-resolve
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (let
      [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
      [def-index : i64 (opt-unroll-def-index slots phi-count last var)]
      (if (< def-index 0)
        var
        (match (array-ref slots def-index)
          [(ir.CompilerIrInstr.Mov _ src _)
            (match src
              [(ir.CompilerIrValue.Var src-id)
                (opt-bce-version-resolve
                  instrs
                  phi-count
                  last
                  src-id
                  (- fuel 1))]
              [_ var])]
          [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
            (if (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
              (match src
                [(ir.CompilerIrValue.Var src-id)
                  (opt-bce-version-resolve
                    instrs
                    phi-count
                    last
                    src-id
                    (- fuel 1))]
                [_ var])
              var)]
          [_ var])))))

;; A loop-local index written as `scale * counter + offset`. The coefficients
;; are mathematical signed i64 values, not merely their wrapping bit patterns:
;; every fold below rejects coefficient overflow so the range guard may reason
;; about a monotone positive-scale expression.
(defenum OptBceCounterAffine
  (No)
  (Some i64 i64))

;; A canonical derived induction phi: its preheader value and its positive
;; constant increment per primary-counter trip.
(defenum OptBceDerivedInduction
  (No)
  (Some ir.CompilerIrValue i64))

(define (opt-bce-counter-affine-add [value : OptBceCounterAffine] [delta : i64]) : OptBceCounterAffine
  (match value
    [(OptBceCounterAffine.No) (OptBceCounterAffine.No)]
    [(OptBceCounterAffine.Some scale offset)
      (let
        [minimum : i64 (- (- 0 9223372036854775807) 1)]
        (if (or
          (and (> delta 0) (> offset (- 9223372036854775807 delta)))
          (and (< delta 0) (< offset (- minimum delta))))
          (OptBceCounterAffine.No)
          (OptBceCounterAffine.Some scale (+ offset delta))))]))

(define (opt-bce-counter-affine-mul
  [value : OptBceCounterAffine]
  [factor : i64]) : OptBceCounterAffine
  (match value
    [(OptBceCounterAffine.No) (OptBceCounterAffine.No)]
    [(OptBceCounterAffine.Some scale offset)
      (let
        [minimum : i64 (- (- 0 9223372036854775807) 1)]
        (if (or
          (<= factor 0)
          (> scale (/ 9223372036854775807 factor))
          (if (>= offset 0)
            (> offset (/ 9223372036854775807 factor))
            (< offset (/ minimum factor))))
          (OptBceCounterAffine.No)
          (OptBceCounterAffine.Some (* scale factor) (* offset factor))))]))

;; Same-block affine recovery for the canonical self-loop. Copy/reinterpret
;; chains are resolved first; Add/Sub/Mul may then contribute one literal
;; coefficient at a time.
(define (opt-bce-version-counter-affine
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : OptBceCounterAffine
  (match value
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-version-resolve instrs phi-count last raw 16)]
        (if (= id iphi)
          (OptBceCounterAffine.Some 1 0)
          (if (<= fuel 0)
            (OptBceCounterAffine.No)
            (let
              [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
              [def-index : i64 (opt-unroll-def-index slots phi-count last id)]
              (if (< def-index 0)
                (OptBceCounterAffine.No)
                (match (array-ref slots def-index)
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                    (if (opt-affine-64bit-type? ty)
                      (match op
                        [(ir.CompilerIrBinOp.Add)
                          (match (opt-affine-var-const lhs rhs)
                            [(OptAffineOperands.Some src k)
                              (opt-bce-counter-affine-add
                                (opt-bce-version-counter-affine
                                  instrs
                                  phi-count
                                  last
                                  iphi
                                  (ir.CompilerIrValue.Var src)
                                  (- fuel 1))
                                k)]
                            [(OptAffineOperands.No) (OptBceCounterAffine.No)])]
                        [(ir.CompilerIrBinOp.Sub)
                          (match lhs
                            [(ir.CompilerIrValue.Var src)
                              (match rhs
                                [(ir.CompilerIrValue.I64 k)
                                  (if (= k (- (- 0 9223372036854775807) 1))
                                    (OptBceCounterAffine.No)
                                    (opt-bce-counter-affine-add
                                      (opt-bce-version-counter-affine
                                        instrs
                                        phi-count
                                        last
                                        iphi
                                        (ir.CompilerIrValue.Var src)
                                        (- fuel 1))
                                      (- 0 k)))]
                                [_ (OptBceCounterAffine.No)])]
                            [_ (OptBceCounterAffine.No)])]
                        [(ir.CompilerIrBinOp.Mul)
                          (match (opt-affine-var-const lhs rhs)
                            [(OptAffineOperands.Some src k)
                              (opt-bce-counter-affine-mul
                                (opt-bce-version-counter-affine
                                  instrs
                                  phi-count
                                  last
                                  iphi
                                  (ir.CompilerIrValue.Var src)
                                  (- fuel 1))
                                k)]
                            [(OptAffineOperands.No) (OptBceCounterAffine.No)])]
                        [_ (OptBceCounterAffine.No)])
                      (OptBceCounterAffine.No))]
                  [_ (OptBceCounterAffine.No)]))))))]
    [_ (OptBceCounterAffine.No)]))

;; The invariant value an operand resolves to (a literal, or a var defined
;; outside the loop -- possibly behind in-loop copies/reinterprets), if any.
;; The guard must reference the RESOLVED value: it is the one whose definition
;; dominates the loop entry edge.
(define (opt-bce-version-invariant-operand
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrValue.I64 k)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.I64 k))]
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-version-resolve instrs phi-count last raw 16)]
        (if (opt-used-contains defs id)
          (ir.CompilerIrMaybeValue.No)
          (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var id))))]
    [_ (ir.CompilerIrMaybeValue.No)]))

;; Recover a same-block derived induction phi
;;
;;   derived = phi(preheader_start, derived + positive_step)
;;
;; Copy/reinterpret chains on the back value and add source are harmless.
;; The initializer must remain loop-invariant because the versioning guard
;; evaluates it before entering the cloned loop.
(define (opt-bce-version-derived-induction
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [phi-var : i64]
  [inputs : ir.CompilerIrPhiInputList]) : OptBceDerivedInduction
  (match (opt-unroll-split-phi-inputs inputs loop-label)
    [(OptUnrollPhiSplit.No) (OptBceDerivedInduction.No)]
    [(OptUnrollPhiSplit.Split init back init-label)
      (if (not (= init-label pred-label))
        (OptBceDerivedInduction.No)
        (match (opt-bce-version-invariant-operand
          instrs
          phi-count
          last
          defs
          init)
          [(ir.CompilerIrMaybeValue.No) (OptBceDerivedInduction.No)]
          [(ir.CompilerIrMaybeValue.Some invariant-init)
            (match back
              [(ir.CompilerIrValue.Var back-raw)
                (let
                  [back-var : i64
                    (opt-bce-version-resolve instrs phi-count last back-raw 16)]
                  [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
                  [back-index : i64
                    (opt-unroll-def-index slots phi-count last back-var)]
                  (if (< back-index 0)
                    (OptBceDerivedInduction.No)
                    (match (array-ref slots back-index)
                      [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                        (match ty
                          [(ast.AstType.I64)
                            (match op
                              [(ir.CompilerIrBinOp.Add)
                                (match (opt-affine-var-const lhs rhs)
                                  [(OptAffineOperands.Some src step)
                                    (if (and
                                      (> step 0)
                                      (=
                                        (opt-bce-version-resolve
                                          instrs
                                          phi-count
                                          last
                                          src
                                          16)
                                        phi-var))
                                      (OptBceDerivedInduction.Some
                                        invariant-init
                                        step)
                                      (OptBceDerivedInduction.No))]
                                  [(OptAffineOperands.No)
                                    (OptBceDerivedInduction.No)])]
                              [_ (OptBceDerivedInduction.No)])]
                          [_ (OptBceDerivedInduction.No)])]
                      [_ (OptBceDerivedInduction.No)])))]
              [_ (OptBceDerivedInduction.No)])]))]))

;; Prove `scale * i + offset` is in range for every
;; `i in [seed, bound)`, with positive `scale`.
;;
;; A direct `scale * (bound - 1) + offset < length` instruction would itself
;; wrap, and a wrapped negative maximum could make an unsound signed compare
;; succeed. Instead compute the equivalent upper threshold
;;
;;   bound - 1 <= (length - 1 - offset) / scale
;;
;; after separately proving that the numerator is representable and
;; non-negative. Negative offsets also raise the minimum admitted seed.
;; Arithmetic on guard-false paths may wrap (the language defines it), but the
;; conjunction can be true only where the mathematical quotient is exact.
(define (opt-bce-version-affine-guard
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]
  [scale : i64]
  [offset : i64]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (or (<= scale 0) (= offset (- (- 0 9223372036854775807) 1)))
    (OptBceVersionGuardAcc.No)
    (if (and (= scale 1) (= offset 0))
      (opt-bce-version-cond-counter-seen
        (opt-bce-version-cond cell (ir.CompilerIrBinOp.Le) bound length acc))
      (match acc
        [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
        [(OptBceVersionGuardAcc.Some instrs values counter-seen)
          (let
            [last-counter : i64 (opt-bce-version-alloc-var cell)]
            [length-minus-one : i64 (opt-bce-version-alloc-var cell)]
            [adjusted-capacity : i64 (opt-bce-version-alloc-var cell)]
            [maximum-counter : i64 (opt-bce-version-alloc-var cell)]
            [with-arithmetic : OptBceVersionGuardAcc
              (OptBceVersionGuardAcc.Some
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    maximum-counter
                    (ir.CompilerIrBinOp.Div)
                    (ir.CompilerIrValue.Var adjusted-capacity)
                    (ir.CompilerIrValue.I64 scale)
                    (ast.AstType.I64))
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      adjusted-capacity
                      (ir.CompilerIrBinOp.Sub)
                      (ir.CompilerIrValue.Var length-minus-one)
                      (ir.CompilerIrValue.I64 offset)
                      (ast.AstType.I64))
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BinOp
                        length-minus-one
                        (ir.CompilerIrBinOp.Sub)
                        length
                        (ir.CompilerIrValue.I64 1)
                        (ast.AstType.I64))
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.BinOp
                          last-counter
                          (ir.CompilerIrBinOp.Sub)
                          bound
                          (ir.CompilerIrValue.I64 1)
                          (ast.AstType.I64))
                        instrs))))
                values
                counter-seen)]
            [upper : OptBceVersionGuardAcc
              (opt-bce-version-cond
                cell
                (ir.CompilerIrBinOp.Le)
                (ir.CompilerIrValue.Var last-counter)
                (ir.CompilerIrValue.Var maximum-counter)
                with-arithmetic)]
            [capacity-safe : OptBceVersionGuardAcc
              (if (>= offset 0)
                ;; length > offset makes `length - 1 - offset`
                ;; representable and non-negative.
                (opt-bce-version-cond
                  cell
                  (ir.CompilerIrBinOp.Gt)
                  length
                  (ir.CompilerIrValue.I64 offset)
                  upper)
                (let
                  ;; For offset=-d, cap <= MAX-d+1 prevents positive
                  ;; overflow in `cap - 1 + d`; cap > 0 supplies its lower
                  ;; bound.
                  [maximum-length : i64 (+ (+ 9223372036854775807 offset) 1)]
                  (opt-bce-version-cond
                    cell
                    (ir.CompilerIrBinOp.Gt)
                    length
                    (ir.CompilerIrValue.I64 0)
                    (opt-bce-version-cond
                      cell
                      (ir.CompilerIrBinOp.Le)
                      length
                      (ir.CompilerIrValue.I64 maximum-length)
                      upper))))]
            [minimum-safe : OptBceVersionGuardAcc
              (if (>= offset 0)
                capacity-safe
                (let
                  [magnitude : i64 (- 0 offset)]
                  [minimum-seed : i64
                    (+
                      (/ magnitude scale)
                      (if (= (% magnitude scale) 0)
                        0
                        1))]
                  (opt-bce-version-cond
                    cell
                    (ir.CompilerIrBinOp.Ge)
                    seed
                    (ir.CompilerIrValue.I64 minimum-seed)
                    capacity-safe)))]
            (opt-bce-version-cond-counter-seen minimum-safe))]))))

;; Prove a positive-step derived induction phi stays in range. If the primary
;; loop executes, its trip number ranges over
;;
;;   0 .. (bound - seed - 1)
;;
;; and the derived index is `derived-seed + trip * step`. Constructing that
;; maximum directly could wrap. Instead prove
;;
;;   bound - seed - 1 <= (length - 1 - derived-seed) / step
;;
;; after separately proving `derived-seed >= 0` and
;; `length > derived-seed`. Together with the once-only primary
;; `seed >= 0 && seed < bound` conditions, every arithmetic operation is
;; representable on the accepted path.
(define (opt-bce-version-derived-guard
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [derived-seed : ir.CompilerIrValue]
  [step : i64]
  [length : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (<= step 0)
    (OptBceVersionGuardAcc.No)
    (match acc
      [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
      [(OptBceVersionGuardAcc.Some instrs values counter-seen)
        (let
          [trip-span : i64 (opt-bce-version-alloc-var cell)]
          [last-trip : i64 (opt-bce-version-alloc-var cell)]
          [length-minus-one : i64 (opt-bce-version-alloc-var cell)]
          [room : i64 (opt-bce-version-alloc-var cell)]
          [maximum-trip : i64 (opt-bce-version-alloc-var cell)]
          [with-arithmetic : OptBceVersionGuardAcc
            (OptBceVersionGuardAcc.Some
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  maximum-trip
                  (ir.CompilerIrBinOp.Div)
                  (ir.CompilerIrValue.Var room)
                  (ir.CompilerIrValue.I64 step)
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    room
                    (ir.CompilerIrBinOp.Sub)
                    (ir.CompilerIrValue.Var length-minus-one)
                    derived-seed
                    (ast.AstType.I64))
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      length-minus-one
                      (ir.CompilerIrBinOp.Sub)
                      length
                      (ir.CompilerIrValue.I64 1)
                      (ast.AstType.I64))
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BinOp
                        last-trip
                        (ir.CompilerIrBinOp.Sub)
                        (ir.CompilerIrValue.Var trip-span)
                        (ir.CompilerIrValue.I64 1)
                        (ast.AstType.I64))
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.BinOp
                          trip-span
                          (ir.CompilerIrBinOp.Sub)
                          bound
                          seed
                          (ast.AstType.I64))
                        instrs)))))
              values
              counter-seen)]
          [upper : OptBceVersionGuardAcc
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Le)
              (ir.CompilerIrValue.Var last-trip)
              (ir.CompilerIrValue.Var maximum-trip)
              with-arithmetic)]
          [capacity-safe : OptBceVersionGuardAcc
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Gt)
              length
              derived-seed
              upper)]
          [minimum-safe : OptBceVersionGuardAcc
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Ge)
              derived-seed
              (ir.CompilerIrValue.I64 0)
              capacity-safe)]
          (opt-bce-version-cond-counter-seen minimum-safe))])))

;; --- strided variable-base indices ----------------------------------------------
;;
;; A check index of the form `B + T + k` with a loop-invariant VARIABLE base B
;; (either Add operand order, literal k peeled off either level) and T a
;; strided trip expression:
;;
;;   * T = scale*counter + k2 with a literal scale > 1 -- induction lowering
;;     has not (or not yet) strength-reduced the multiply. Scale 1 stays out
;;     of this pass: one guard per loop entry cannot pay for one removed
;;     check per trip on pico-trip loops (the measured intern_table
;;     regression), so the literal scale-1 counter forms keep their existing
;;     handling and variable-base scale-1 forms reject;
;;   * T = dphi + k2 with dphi a derived induction phi (invariant init d0,
;;     literal step > 1) -- the shape induction lowering leaves behind for
;;     `B + scale*counter + k` once the multiply becomes the phi's step.
;;     Step 1 stays out for the same reason as scale 1: it degenerates to
;;     one removed check per trip per entry guard (the measured pico-trip
;;     loser class), and the primary counter is itself a step-1 phi, so an
;;     ungated step-1 form would smuggle `base + counter` back in.
;;
;; Overflow-checked literal accumulation for the offset peeling below: the
;; coefficients must stay mathematical (a wrapped offset could disguise an
;; unbounded index expression), so an overflow rejects the whole recovery.
(defenum OptBceVersionKSum
  (No)
  (Some i64))

(define (opt-bce-version-k-add [a : i64] [b : i64]) : OptBceVersionKSum
  (let
    [minimum : i64 (- (- 0 9223372036854775807) 1)]
    (if (or
      (and (> b 0) (> a (- 9223372036854775807 b)))
      (and (< b 0) (< a (- minimum b))))
      (OptBceVersionKSum.No)
      (OptBceVersionKSum.Some (+ a b)))))

;; A strided trip expression under the variable base: `scale*counter + k`
;; with literal scale > 1, or a derived induction phi (invariant init d0,
;; literal step > 0) plus peeled literal k.
(defenum OptBceVarBaseStrided
  (No)
  (Scaled i64 i64)
  (Derived ir.CompilerIrValue i64 i64))

;; The peel result: the remaining core variable and the accumulated literal.
(defenum OptBceVersionStridedCore
  (No)
  (Some i64 i64))

;; Peel literal Add/Sub addends off an index expression, returning the
;; remaining core variable and the accumulated literal. Peeling stops at the
;; first definition that is not a literal addend link (a var+var Add, a phi,
;; a load, ...); a non-variable expression rejects.
(define (opt-bce-version-strided-peel
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [value : ir.CompilerIrValue]
  [k : i64]
  [fuel : i64]) : OptBceVersionStridedCore
  (match value
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-version-resolve instrs phi-count last raw 16)]
        [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
        [def-index : i64 (opt-unroll-def-index slots 0 last id)]
        (if (or (<= fuel 0) (< def-index 0))
          (OptBceVersionStridedCore.Some id k)
          (match (array-ref slots def-index)
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
              (if (not (opt-affine-64bit-type? ty))
                (OptBceVersionStridedCore.Some id k)
                (match op
                  [(ir.CompilerIrBinOp.Add)
                    (match (opt-affine-var-const lhs rhs)
                      [(OptAffineOperands.Some src c)
                        (match (opt-bce-version-k-add k c)
                          [(OptBceVersionKSum.No) (OptBceVersionStridedCore.No)]
                          [(OptBceVersionKSum.Some next)
                            (opt-bce-version-strided-peel
                              instrs
                              phi-count
                              last
                              (ir.CompilerIrValue.Var src)
                              next
                              (- fuel 1))])]
                      [(OptAffineOperands.No)
                        (OptBceVersionStridedCore.Some id k)])]
                  [(ir.CompilerIrBinOp.Sub)
                    (match lhs
                      [(ir.CompilerIrValue.Var src)
                        (match rhs
                          [(ir.CompilerIrValue.I64 c)
                            (if (= c (- (- 0 9223372036854775807) 1))
                              (OptBceVersionStridedCore.Some id k)
                              (match (opt-bce-version-k-add k (- 0 c))
                                [(OptBceVersionKSum.No)
                                  (OptBceVersionStridedCore.No)]
                                [(OptBceVersionKSum.Some next)
                                  (opt-bce-version-strided-peel
                                    instrs
                                    phi-count
                                    last
                                    (ir.CompilerIrValue.Var src)
                                    next
                                    (- fuel 1))]))]
                          [_ (OptBceVersionStridedCore.Some id k)])]
                      [_ (OptBceVersionStridedCore.Some id k)])]
                  [_ (OptBceVersionStridedCore.Some id k)]))]
            [_ (OptBceVersionStridedCore.Some id k)])))]
    [_ (OptBceVersionStridedCore.No)]))

;; The strided side as a derived induction phi (possibly under peeled literal
;; addends): opt-bce-version-derived-induction pins the invariant init and
;; the positive literal step.
(define (opt-bce-version-strided-derived
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : OptBceVarBaseStrided
  (match (opt-bce-version-strided-peel instrs phi-count last value 0 fuel)
    [(OptBceVersionStridedCore.No) (OptBceVarBaseStrided.No)]
    [(OptBceVersionStridedCore.Some core total)
      (let
        [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
        [def-index : i64 (opt-unroll-def-index slots 0 last core)]
        (if (< def-index 0)
          (OptBceVarBaseStrided.No)
          (match (array-ref slots def-index)
            [(ir.CompilerIrInstr.Phi _ inputs pty)
              (match pty
                [(ast.AstType.I64)
                  (match (opt-bce-version-derived-induction
                    instrs
                    phi-count
                    last
                    defs
                    loop-label
                    pred-label
                    core
                    inputs)
                    [(OptBceDerivedInduction.No) (OptBceVarBaseStrided.No)]
                    [(OptBceDerivedInduction.Some d0 step)
                      (if (> step 1)
                        (OptBceVarBaseStrided.Derived d0 step total)
                        (OptBceVarBaseStrided.No))])]
                [_ (OptBceVarBaseStrided.No)])]
            [_ (OptBceVarBaseStrided.No)])))]))

;; One Add side as the strided part: the literal-coefficient recovery first
;; (it sees through Add/Sub/Mul chains over the counter), then the
;; derived-induction form for the strength-reduced shape. Scale 1 (the plain
;; `base + counter`) is recovered here and routed by the caller to the
;; no-division scale-1 guard under the profitability gate; scale 0 and
;; negative scales still reject.
(define (opt-bce-version-strided-side
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : OptBceVarBaseStrided
  (match (opt-bce-version-counter-affine instrs phi-count last iphi value fuel)
    [(OptBceCounterAffine.No)
      (opt-bce-version-strided-derived
        instrs
        phi-count
        last
        defs
        loop-label
        pred-label
        value
        fuel)]
    [(OptBceCounterAffine.Some scale k)
      (if (>= scale 1)
        (OptBceVarBaseStrided.Scaled scale k)
        (OptBceVarBaseStrided.No))]))

;; The synthesized derived seed: an invariant base value, an optional second
;; invariant value, a literal offset, and the guard instruction stream the
;; emitted adds landed on.
(defstruct OptBceSynthSeed
  (value ir.CompilerIrValue)
  (instrs ir.CompilerIrInstrList))

;; Fold the literal pieces and emit the adds for `base + extra + offset` into
;; the guard stream. Every fold and every emitted Add wraps exactly like the
;; body's own arithmetic: the language defines i64 arithmetic to wrap, so the
;; synthesized seed equals `base + extra + offset` modulo 2^64 no matter how
;; the pieces associate -- the same value the body's index computation
;; produces, and the value the derived-induction guard's conditions judge
;; (see opt-bce-version-var-base-scaled-guard for the full argument).
(define (opt-bce-version-guard-seed-sum
  [cell : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrList]
  [base : ir.CompilerIrValue]
  [extra : ir.CompilerIrMaybeValue]
  [offset : i64]) : OptBceSynthSeed
  (let
    [off1 : i64
      (match base
        [(ir.CompilerIrValue.I64 b) (+ offset b)]
        [_ offset])]
    [base-term : ir.CompilerIrMaybeValue
      (match base
        [(ir.CompilerIrValue.I64 _) (ir.CompilerIrMaybeValue.No)]
        [_ (ir.CompilerIrMaybeValue.Some base)])]
    [off2 : i64
      (match extra
        [(ir.CompilerIrMaybeValue.No) off1]
        [(ir.CompilerIrMaybeValue.Some ev)
          (match ev
            [(ir.CompilerIrValue.I64 e) (+ off1 e)]
            [_ off1])])]
    [extra-term : ir.CompilerIrMaybeValue
      (match extra
        [(ir.CompilerIrMaybeValue.No) (ir.CompilerIrMaybeValue.No)]
        [(ir.CompilerIrMaybeValue.Some ev)
          (match ev
            [(ir.CompilerIrValue.I64 _) (ir.CompilerIrMaybeValue.No)]
            [_ (ir.CompilerIrMaybeValue.Some ev)])])]
    (match base-term
      [(ir.CompilerIrMaybeValue.No)
        (match extra-term
          [(ir.CompilerIrMaybeValue.No)
            (OptBceSynthSeed (ir.CompilerIrValue.I64 off2) instrs)]
          [(ir.CompilerIrMaybeValue.Some v)
            (if (= off2 0)
              (OptBceSynthSeed v instrs)
              (let
                [d : i64 (opt-bce-version-alloc-var cell)]
                (OptBceSynthSeed
                  (ir.CompilerIrValue.Var d)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      d
                      (ir.CompilerIrBinOp.Add)
                      v
                      (ir.CompilerIrValue.I64 off2)
                      (ast.AstType.I64))
                    instrs))))])]
      [(ir.CompilerIrMaybeValue.Some u)
        (match extra-term
          [(ir.CompilerIrMaybeValue.No)
            (if (= off2 0)
              (OptBceSynthSeed u instrs)
              (let
                [d : i64 (opt-bce-version-alloc-var cell)]
                (OptBceSynthSeed
                  (ir.CompilerIrValue.Var d)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      d
                      (ir.CompilerIrBinOp.Add)
                      u
                      (ir.CompilerIrValue.I64 off2)
                      (ast.AstType.I64))
                    instrs))))]
          [(ir.CompilerIrMaybeValue.Some v)
            (let
              [d1 : i64 (opt-bce-version-alloc-var cell)]
              [with-sum : ir.CompilerIrInstrList
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    d1
                    (ir.CompilerIrBinOp.Add)
                    u
                    v
                    (ast.AstType.I64))
                  instrs)]
              (if (= off2 0)
                (OptBceSynthSeed (ir.CompilerIrValue.Var d1) with-sum)
                (let
                  [d2 : i64 (opt-bce-version-alloc-var cell)]
                  (OptBceSynthSeed
                    (ir.CompilerIrValue.Var d2)
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BinOp
                        d2
                        (ir.CompilerIrBinOp.Add)
                        (ir.CompilerIrValue.Var d1)
                        (ir.CompilerIrValue.I64 off2)
                        (ast.AstType.I64))
                      with-sum)))))])])))

;; Prove `base + scale*counter + offset` stays in [0, length) for every
;; counter in [seed, bound), with `base` loop-invariant and `scale` a literal
;; greater than 1. With trip = counter - seed the index is
;;
;;   derived-seed + trip * scale    where    derived-seed = base + scale*seed + offset
;;
;; so the positive-step derived-induction guard (step = scale) applies once
;; the guard stream synthesizes derived-seed -- one mul by the literal scale
;; when the seed is not a literal, plus the adds opt-bce-version-guard-seed-sum
;; needs. The synthesis arithmetic wraps exactly like the body's own: the
;; language defines i64 arithmetic to wrap, and the body computes its index
;; as wrap(base + wrap(scale*counter) + offset), which two's-complement
;; arithmetic rewrites as wrap(derived-seed + scale*trip) -- the SAME wrapped
;; value the guard's conditions inspect. Where those conditions hold they pin
;; derived-seed + scale*trip into [0, length) inside [0, 2^63), where
;; wrapping is the identity, so every executed trip's index equals the
;; mathematical in-range value and the removed check would have passed;
;; anywhere they fail the checked slow path runs. A wrapped synthesis
;; intermediate therefore needs no special rejection: it can only produce a
;; derived-seed the guard then judges on its own terms (a wrapped-negative
;; one fails `derived-seed >= 0`; a wrapped-positive one still makes every
;; index coincide with the body's own wrapped computation). The INT64_MIN
;; offset rejection is shared caution with the literal affine guard, not a
;; soundness requirement of this construction.
;;
;; Scale 1 does NOT come here: both callers route it to
;; opt-bce-version-var-base-guard, whose scale-1 specialization needs no
;; mul and no division. The `scale <= 1` rejection below therefore stays as
;; a defensive gate rather than becoming reachable policy.
(define (opt-bce-version-var-base-scaled-guard
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [base : ir.CompilerIrValue]
  [scale : i64]
  [offset : i64]
  [length : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (or (<= scale 1) (= offset (- (- 0 9223372036854775807) 1)))
    (OptBceVersionGuardAcc.No)
    (match acc
      [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
      [(OptBceVersionGuardAcc.Some instrs values counter-seen)
        (match seed
          [(ir.CompilerIrValue.I64 sk)
            ;; The literal seed folds the product into the offset; the fold
            ;; wraps like the runtime mul would.
            (let
              [synth : OptBceSynthSeed
                (opt-bce-version-guard-seed-sum
                  cell
                  instrs
                  base
                  (ir.CompilerIrMaybeValue.No)
                  (+ offset (* scale sk)))]
              (opt-bce-version-derived-guard
                seed
                bound
                synth.value
                scale
                length
                cell
                (OptBceVersionGuardAcc.Some synth.instrs values counter-seen)))]
          [_
            (let
              [product : i64 (opt-bce-version-alloc-var cell)]
              [synth : OptBceSynthSeed
                (opt-bce-version-guard-seed-sum
                  cell
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      product
                      (ir.CompilerIrBinOp.Mul)
                      seed
                      (ir.CompilerIrValue.I64 scale)
                      (ast.AstType.I64))
                    instrs)
                  base
                  (ir.CompilerIrMaybeValue.Some
                    (ir.CompilerIrValue.Var product))
                  offset)]
              (opt-bce-version-derived-guard
                seed
                bound
                synth.value
                scale
                length
                cell
                (OptBceVersionGuardAcc.Some synth.instrs values counter-seen)))])])))

;; Prove `base + dphi + offset` stays in [0, length) for every counter in
;; [seed, bound), with `base` loop-invariant and dphi a derived induction phi
;; (invariant init d0, literal step > 1 -- step 1 is the pico-trip
;; guard-economics class and the primary counter's own step, so it stays
;; out). With trip = counter - seed the phi is d0 + step*trip and the index
;; is
;;
;;   derived-seed + trip * step    where    derived-seed = base + d0 + offset
;;
;; -- the derived-induction guard again, with the seed synthesized from
;; invariant pieces (adds only; the multiply already lives on the phi's
;; step). The wrap argument of opt-bce-version-var-base-scaled-guard applies
;; unchanged: the body's wrapped index is wrap(derived-seed + step*trip) and
;; the guard's conditions pin that value into the range where wrapping is
;; the identity.
(define (opt-bce-version-var-base-derived-guard
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [base : ir.CompilerIrValue]
  [d0 : ir.CompilerIrValue]
  [step : i64]
  [offset : i64]
  [length : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (or (<= step 1) (= offset (- (- 0 9223372036854775807) 1)))
    (OptBceVersionGuardAcc.No)
    (match acc
      [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
      [(OptBceVersionGuardAcc.Some instrs values counter-seen)
        (let
          [synth : OptBceSynthSeed
            (opt-bce-version-guard-seed-sum
              cell
              instrs
              base
              (ir.CompilerIrMaybeValue.Some d0)
              offset)]
          (opt-bce-version-derived-guard
            seed
            bound
            synth.value
            step
            length
            cell
            (OptBceVersionGuardAcc.Some synth.instrs values counter-seen)))])))

;; Prove `base + counter + offset` stays in [0, length) for every counter in
;; [seed, bound), with `base` loop-invariant. This is the existing literal
;; affine guard with scale 1 and the variable `base + offset` folded in for
;; the literal offset; the division is exact at scale 1 and needs no
;; instruction. The conditions are
;;
;;   cond A: base_eff >= 0                    (base_eff = base + offset)
;;   cond B: bound - 1 <= length - 1 - base_eff
;;
;; alongside the once-only primary `seed >= 0 && seed < bound`. Every emitted
;; instruction wraps like the body's own arithmetic, and the conjunction can
;; be true only where every index is representable and in range: with cond A
;; and seed >= 0 the minimum index is non-negative, and cond B -- computed as
;; `sub bound 1; sub length 1; sub ... base_eff; signed Le` -- bounds the
;; maximum. `length - 1 - base_eff` is representable on every path where it
;; matters: for length in [0, 2^63) and base_eff >= 0 its minimum is -2^63,
;; and a wrapped-negative RHS (only possible for lengths at or above 2^63,
;; where the wrap adds back exactly 2^64) leaves cond B equivalent to
;; `base_eff + bound - 1 <= length_u64 - 1`, so even those lengths stay
;; sound. A base_eff that overflowed negative fails cond A and keeps the
;; checked slow path, like every conservatively-false guard here.
(define (opt-bce-version-var-base-guard
  [_seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [length : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some instrs values counter-seen)
      (let
        [eff-var : i64
          (if (= offset 0)
            (- 0 1)
            (opt-bce-version-alloc-var cell))]
        [eff : ir.CompilerIrValue
          (if (= offset 0)
            base
            (ir.CompilerIrValue.Var eff-var))]
        [eff-instrs : ir.CompilerIrInstrList
          (if (= offset 0)
            instrs
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                eff-var
                (ir.CompilerIrBinOp.Add)
                base
                (ir.CompilerIrValue.I64 offset)
                (ast.AstType.I64))
              instrs))]
        [last-counter : i64 (opt-bce-version-alloc-var cell)]
        [length-minus-one : i64 (opt-bce-version-alloc-var cell)]
        [room : i64 (opt-bce-version-alloc-var cell)]
        [with-arithmetic : OptBceVersionGuardAcc
          (OptBceVersionGuardAcc.Some
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                room
                (ir.CompilerIrBinOp.Sub)
                (ir.CompilerIrValue.Var length-minus-one)
                eff
                (ast.AstType.I64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  length-minus-one
                  (ir.CompilerIrBinOp.Sub)
                  length
                  (ir.CompilerIrValue.I64 1)
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    last-counter
                    (ir.CompilerIrBinOp.Sub)
                    bound
                    (ir.CompilerIrValue.I64 1)
                    (ast.AstType.I64))
                  eff-instrs)))
            values
            counter-seen)]
        (opt-bce-version-cond-counter-seen
          (opt-bce-version-cond
            cell
            (ir.CompilerIrBinOp.Le)
            (ir.CompilerIrValue.Var last-counter)
            (ir.CompilerIrValue.Var room)
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Ge)
              eff
              (ir.CompilerIrValue.I64 0)
              with-arithmetic))))]))

;; --- scale-1 fan subsumption ---------------------------------------------------
;;
;; A strided-access loop (the it-hash-words word loader is the running
;; example) carries a whole FAN of `B + counter + k` checks against one
;; length, with consecutive literal offsets k0..k7. Deriving each check's
;; scale-1 guard independently costs two conditions per check; the and-chain
;; over ~18 values lowers to ~160 instructions per loop ENTRY, which swamps
;; the ~27/trip the fast clone saves when the loop averages a few trips per
;; entry (measured: intern_table +9.3%). But the family's conditions are
;; monotone in k: with cond A at the SMALLEST offset (`wrap(B + kmin) >= 0`,
;; the no-underflow side), cond A at the LARGEST offset (`wrap(B + kmax) >=
;; 0`, the no-wrap side), and cond B at the largest offset
;; (`bound-1 <= len-1 - wrap(B + kmax)`), EVERY intermediate offset is
;; covered too. Derivation therefore only RECORDS the (base, length, k)
;; triple in this table and emits nothing; the flush at guard assembly emits
;; the extremal conditions -- one var-base-guard for a single-point range,
;; that guard plus the extra minimum cond A for a real range -- three
;; conditions for the whole fan regardless of its size.
;;
;; Soundness (range argument, mirroring the var-base-guard documentation).
;; The loop-level conditions give seed >= 0, seed < bound and, for a counter
;; step > 1, the no-wrap cap, so every executed trip's counter lies in
;; [0, bound-1]. Offsets are capped at +-2^60 on admission, so the recorded
;; range is narrower than 2^62 and the mathematical interval
;; [B + kmin, B + kmax] can straddle at most one signedness boundary, and
;; each straddle is caught: crossing 0 upward makes cond A at kmin fail,
;; crossing +2^63 upward makes cond A at kmax fail, and an interval lying
;; wholly below -2^63 (whose wrap-shifted effs are again monotone) is the
;; +2^64 translation of the representable case. When all three conditions
;; hold, every intermediate k and every trip c therefore has
;; `index = wrap(B + c + k)` confined to [eff_min, eff_max + bound - 1] with
;; no signedness discontinuity, cond B pins the top below the (unsigned)
;; length exactly as the one-check guard does, and the removed check would
;; have passed. A wrapped-false condition merely deselects the fast path,
;; like every conservatively-false guard here.
;;
;; Storage is a DENSE scoped record, allocated per guard assembly and dropped
;; with it -- no linked chain, no per-check allocation. Entry i keeps its
;; base at keys[2i] and its length at keys[2i+1]; slots[0] is the live entry
;; count and entry i's offset range sits at slots[1+2i] (kmin) and
;; slots[2+2i] (kmax). A loop presenting more distinct (base, length) pairs
;; than the fixed capacity keeps the plain per-check guard for the overflow,
;; so the table never grows.
(defstruct OptBceVersionFan
  (keys (__tl_dyn-array ir.CompilerIrValue))
  (slots (__tl_dyn-array i64)))

;; Distinct (base, length) pairs one loop's guard may subsume. Real fans hold
;; ONE pair (a word loader's eight offsets against one buffer); the slack is
;; for loops mixing a couple of arrays.
(define (opt-bce-version-fan-max) : i64
  8)

(define (opt-bce-version-fan-new) : OptBceVersionFan
  (let
    [slots : (__tl_dyn-array i64)
      (array.make-array i64 (+ (* (opt-bce-version-fan-max) 2) 1))]
    (begin
      (set! (array-ref slots 0) 0)
      (OptBceVersionFan
        (array.make-array ir.CompilerIrValue (* (opt-bce-version-fan-max) 2))
        slots))))

;; Fan keys compare by resolved identity: same var, or same literal. Any other
;; value kind never matches (not even itself), so such a check simply takes
;; the plain per-check guard.
(define (opt-bce-version-fan-value-eq?
  [a : ir.CompilerIrValue]
  [b : ir.CompilerIrValue]) : bool
  (match a
    [(ir.CompilerIrValue.Var av)
      (match b
        [(ir.CompilerIrValue.Var bv) (= av bv)]
        [_ false])]
    [(ir.CompilerIrValue.I64 ak)
      (match b
        [(ir.CompilerIrValue.I64 bk) (= ak bk)]
        [_ false])]
    [_ false]))

;; Slot of the (base, length) entry, or -1 when the table has none yet.
(define (opt-bce-version-fan-find
  [fan : OptBceVersionFan]
  [base : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]
  [index : i64]) : i64
  (if (>= index (array-ref fan.slots 0))
    (- 0 1)
    (let
      [keys : (__tl_dyn-array ir.CompilerIrValue) fan.keys]
      (if (and
        (opt-bce-version-fan-value-eq? (array-ref keys (* index 2)) base)
        (opt-bce-version-fan-value-eq?
          (array-ref keys (+ (* index 2) 1))
          length))
        index
        (opt-bce-version-fan-find fan base length (+ index 1))))))

;; The offset cap from the header's soundness argument. Bounding BOTH ends by
;; 2^60 keeps the recorded width under 2^62 -- a wider range could straddle
;; two signedness boundaries, which the extremal conditions do not all catch
;; -- and, unlike a direct `kmax - kmin` width test, cannot itself overflow.
(define (opt-bce-version-fan-offset-cap) : i64
  1152921504606846976)

(define (opt-bce-version-fan-range-ok? [kmin : i64] [kmax : i64]) : bool
  (and
    (>= kmin (- 0 (opt-bce-version-fan-offset-cap)))
    (<= kmax (opt-bce-version-fan-offset-cap))))

;; The extra minimum-side cond A for a real range: exactly the eff
;; computation and `eff >= 0` compare the one-check guard emits, here for
;; the smallest offset only.
(define (opt-bce-version-fan-min-cond
  [base : ir.CompilerIrValue]
  [offset : i64]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some instrs values counter-seen)
      (let
        [eff-var : i64
          (if (= offset 0)
            (- 0 1)
            (opt-bce-version-alloc-var cell))]
        [eff : ir.CompilerIrValue
          (if (= offset 0)
            base
            (ir.CompilerIrValue.Var eff-var))]
        [eff-instrs : ir.CompilerIrInstrList
          (if (= offset 0)
            instrs
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                eff-var
                (ir.CompilerIrBinOp.Add)
                base
                (ir.CompilerIrValue.I64 offset)
                (ast.AstType.I64))
              instrs))]
        (opt-bce-version-cond
          cell
          (ir.CompilerIrBinOp.Ge)
          eff
          (ir.CompilerIrValue.I64 0)
          (OptBceVersionGuardAcc.Some eff-instrs values counter-seen)))]))

;; Emit the recorded extremal conditions for one fan entry: the full
;; var-base-guard at the largest offset, plus the minimum-side cond A when
;; the range is real.
(define (opt-bce-version-fan-entry-flush
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [base : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]
  [kmin : i64]
  [kmax : i64]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (= kmin kmax)
    (opt-bce-version-var-base-guard seed bound base kmax length cell acc)
    (opt-bce-version-var-base-guard
      seed
      bound
      base
      kmax
      length
      cell
      (opt-bce-version-fan-min-cond base kmin cell acc))))

;; Walk the dense table once at guard assembly.
(define (opt-bce-version-fan-flush
  [fan : OptBceVersionFan]
  [index : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (if (>= index (array-ref fan.slots 0))
    acc
    (let
      [keys : (__tl_dyn-array ir.CompilerIrValue) fan.keys]
      [slots : (__tl_dyn-array i64) fan.slots]
      (opt-bce-version-fan-flush
        fan
        (+ index 1)
        seed
        bound
        cell
        (opt-bce-version-fan-entry-flush
          seed
          bound
          (array-ref keys (* index 2))
          (array-ref keys (+ (* index 2) 1))
          (array-ref slots (+ (* index 2) 1))
          (array-ref slots (+ (* index 2) 2))
          cell
          acc)))))

;; One fan member's derivation: widen the (base, length) entry's offset range
;; (creating it on first sight), emit NOTHING but the counter-bearing guard
;; requirement every counter-involving derivation marks, and let the flush
;; emit the extremal conditions. A range that would exceed the soundness cap,
;; or a table with no room for a new pair, falls back to the plain per-check
;; guard -- exactly the code emitted before the fan existed.
(define (opt-bce-version-fan-admit
  [fan : OptBceVersionFan]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [length : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionGuardAcc.Some _ _ _)
      (let
        [slots : (__tl_dyn-array i64) fan.slots]
        [at : i64 (opt-bce-version-fan-find fan base length 0)]
        [old-min : i64
          (if (< at 0)
            offset
            (array-ref slots (+ (* at 2) 1)))]
        [old-max : i64
          (if (< at 0)
            offset
            (array-ref slots (+ (* at 2) 2)))]
        [kmin : i64
          (if (< offset old-min)
            offset
            old-min)]
        [kmax : i64
          (if (> offset old-max)
            offset
            old-max)]
        (if (or
          (not (opt-bce-version-fan-range-ok? kmin kmax))
          (and (< at 0) (>= (array-ref slots 0) (opt-bce-version-fan-max))))
          (opt-bce-version-var-base-guard
            seed
            bound
            base
            offset
            length
            cell
            acc)
          (let
            [entry : i64
              (if (< at 0)
                (array-ref slots 0)
                at)]
            [_fresh : unit
              (if (< at 0)
                (let
                  [keys : (__tl_dyn-array ir.CompilerIrValue) fan.keys]
                  (begin
                    (set! (array-ref keys (* entry 2)) base)
                    (set! (array-ref keys (+ (* entry 2) 1)) length)
                    (set! (array-ref slots 0) (+ entry 1))))
                unit)]
            [_kmin : unit (set! (array-ref slots (+ (* entry 2) 1)) kmin)]
            [_kmax : unit (set! (array-ref slots (+ (* entry 2) 2)) kmax)]
            (opt-bce-version-cond-counter-seen acc))))]))

;; One Add side as the strided part, the other as the invariant base. Exactly
;; one side may involve the counter: an in-loop base fails the
;; invariant-operand check.
;;
;; `allow-scale1` carries the loop-level profitability verdict for the plain
;; `base + counter + k` form (see opt-bce-version-guard-conds): when it is
;; false a scale-1 recovery reports No and the check simply stays in the
;; fast clone, exactly as before this form was admitted. Scale > 1 ignores
;; the flag -- its economics were settled when it landed.
(define (opt-bce-version-var-base-side-strided
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [k0 : i64]
  [affine-side : ir.CompilerIrValue]
  [base-side : ir.CompilerIrValue]
  [length-value : ir.CompilerIrValue]
  [allow-scale1 : bool]
  [fan : OptBceVersionFan]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match (opt-bce-version-strided-side
    instrs
    phi-count
    last
    defs
    loop-label
    pred-label
    iphi
    affine-side
    16)
    [(OptBceVarBaseStrided.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVarBaseStrided.Scaled scale k2)
      (if (and (= scale 1) (not allow-scale1))
        (OptBceVersionGuardAcc.No)
        (match (opt-bce-version-k-add k0 k2)
          [(OptBceVersionKSum.No) (OptBceVersionGuardAcc.No)]
          [(OptBceVersionKSum.Some offset)
            (match (opt-bce-version-invariant-operand
              instrs
              phi-count
              last
              defs
              base-side)
              [(ir.CompilerIrMaybeValue.No) (OptBceVersionGuardAcc.No)]
              [(ir.CompilerIrMaybeValue.Some base)
                (if (= scale 1)
                  ;; No mul, no division, and no per-check conditions: the
                  ;; fan table records the (base, length, offset) triple and
                  ;; the guard's flush emits the extremal conditions.
                  (opt-bce-version-fan-admit
                    fan
                    seed
                    bound
                    base
                    offset
                    length-value
                    cell
                    acc)
                  (opt-bce-version-var-base-scaled-guard
                    seed
                    bound
                    base
                    scale
                    offset
                    length-value
                    cell
                    acc))])]))]
    [(OptBceVarBaseStrided.Derived d0 step k2)
      (match (opt-bce-version-k-add k0 k2)
        [(OptBceVersionKSum.No) (OptBceVersionGuardAcc.No)]
        [(OptBceVersionKSum.Some offset)
          (match (opt-bce-version-invariant-operand
            instrs
            phi-count
            last
            defs
            base-side)
            [(ir.CompilerIrMaybeValue.No) (OptBceVersionGuardAcc.No)]
            [(ir.CompilerIrMaybeValue.Some base)
              (opt-bce-version-var-base-derived-guard
                seed
                bound
                base
                d0
                step
                offset
                length-value
                cell
                acc)])])]))

;; The full variable-base retry for a rejected literal-affine index: peel
;; literal addends, then split the remaining var+var Add into an invariant
;; base and a strided trip expression (either operand order).
(define (opt-bce-version-var-base-strided
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [index-value : ir.CompilerIrValue]
  [length-value : ir.CompilerIrValue]
  [allow-scale1 : bool]
  [fan : OptBceVersionFan]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match (opt-bce-version-strided-peel instrs phi-count last index-value 0 8)
    [(OptBceVersionStridedCore.No) (OptBceVersionGuardAcc.No)]
    [(OptBceVersionStridedCore.Some core k0)
      (let
        [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
        [def-index : i64 (opt-unroll-def-index slots 0 last core)]
        (if (< def-index 0)
          (OptBceVersionGuardAcc.No)
          (match (array-ref slots def-index)
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
              (if (not (opt-affine-64bit-type? ty))
                (OptBceVersionGuardAcc.No)
                (match op
                  [(ir.CompilerIrBinOp.Add)
                    (let
                      [attempt : OptBceVersionGuardAcc
                        (opt-bce-version-var-base-side-strided
                          instrs
                          phi-count
                          last
                          defs
                          loop-label
                          pred-label
                          iphi
                          seed
                          bound
                          cell
                          k0
                          lhs
                          rhs
                          length-value
                          allow-scale1
                          fan
                          acc)]
                      ;; The retry reuses the same fan table: a fan record is
                      ;; only ever written on a path that returns Some, so a
                      ;; failed first attempt left the table untouched.
                      (match attempt
                        [(OptBceVersionGuardAcc.No)
                          (opt-bce-version-var-base-side-strided
                            instrs
                            phi-count
                            last
                            defs
                            loop-label
                            pred-label
                            iphi
                            seed
                            bound
                            cell
                            k0
                            rhs
                            lhs
                            length-value
                            allow-scale1
                            fan
                            acc)]
                        [_ attempt]))]
                  [_ (OptBceVersionGuardAcc.No)]))]
            [_ (OptBceVersionGuardAcc.No)])))]))

;; Derive the sufficient invariant condition for one check's index operand.
(define (opt-bce-version-derive-index
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [index-value : ir.CompilerIrValue]
  [length-value : ir.CompilerIrValue]
  [allow-scale1 : bool]
  [fan : OptBceVersionFan]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match index-value
    [(ir.CompilerIrValue.I64 k)
      (if (>= k 0)
        (opt-bce-version-cond
          cell
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.I64 k)
          length-value
          acc)
        (OptBceVersionGuardAcc.No))]
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-version-resolve instrs phi-count last raw 16)]
        (if (= id iphi)
          ;; counter: [seed, bound) subset of [0, len) iff seed >= 0 (emitted
          ;; once, below) and bound <= len.
          (opt-bce-version-cond-counter-seen
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Le)
              bound
              length-value
              acc))
          (if (not (opt-used-contains defs id))
            ;; loop-invariant index: exactly its own range check, hoisted.
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Lt)
              (ir.CompilerIrValue.Var id)
              length-value
              (opt-bce-version-cond
                cell
                (ir.CompilerIrBinOp.Ge)
                (ir.CompilerIrValue.Var id)
                (ir.CompilerIrValue.I64 0)
                acc))
            (let
              [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
              ;; Derived induction variables live in the Phi prefix; ordinary
              ;; affine expressions live in the body. Search both regions.
              [def-index : i64 (opt-unroll-def-index slots 0 last id)]
              (if (< def-index 0)
                (OptBceVersionGuardAcc.No)
                (match (array-ref slots def-index)
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
                    (match op
                      [(ir.CompilerIrBinOp.BitAnd)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some _ m)
                            (if (>= m 0)
                              ;; masked index: in [0, m] whatever the source.
                              (opt-bce-version-cond
                                cell
                                (ir.CompilerIrBinOp.Lt)
                                (ir.CompilerIrValue.I64 m)
                                length-value
                                acc)
                              (OptBceVersionGuardAcc.No))]
                          [(OptAffineOperands.No) (OptBceVersionGuardAcc.No)])]
                      [_
                        (match (opt-bce-version-counter-affine
                          instrs
                          phi-count
                          last
                          iphi
                          (ir.CompilerIrValue.Var id)
                          16)
                          [(OptBceCounterAffine.No)
                            ;; A var+var Add defeats the literal-coefficient
                            ;; recovery: retry as `base + strided + k` with a
                            ;; loop-invariant variable base.
                            (opt-bce-version-var-base-strided
                              instrs
                              phi-count
                              last
                              defs
                              loop-label
                              pred-label
                              iphi
                              seed
                              bound
                              cell
                              (ir.CompilerIrValue.Var id)
                              length-value
                              allow-scale1
                              fan
                              acc)]
                          [(OptBceCounterAffine.Some scale offset)
                            (opt-bce-version-affine-guard
                              seed
                              bound
                              length-value
                              scale
                              offset
                              cell
                              acc)])])]
                  [(ir.CompilerIrInstr.Phi _ inputs pty)
                    (match pty
                      [(ast.AstType.I64)
                        (match (opt-bce-version-derived-induction
                          instrs
                          phi-count
                          last
                          defs
                          loop-label
                          pred-label
                          id
                          inputs)
                          [(OptBceDerivedInduction.No)
                            (OptBceVersionGuardAcc.No)]
                          [(OptBceDerivedInduction.Some derived-seed step)
                            (opt-bce-version-derived-guard
                              seed
                              bound
                              derived-seed
                              step
                              length-value
                              cell
                              acc)])]
                      [_ (OptBceVersionGuardAcc.No)])]
                  [_ (OptBceVersionGuardAcc.No)]))))))]
    [_ (OptBceVersionGuardAcc.No)]))

;; Fold the per-check derivations over the loop body. A check whose length
;; is not invariant or whose index does not derive is KEPT (remapped) in the
;; fast clone instead of rejecting the whole loop -- the guard constrains
;; only the removed checks, and the kept check preserves the slow path's
;; exact abort semantics for its index. A failed derivation reverts to the
;; state's guard, so no half-built condition survives; a scale-1 fan member
;; instead records its (base, length, offset) triple in `fan`, whose extremal
;; conditions the guard assembly flushes once (opt-bce-version-fan-flush).
(define (opt-bce-version-derive-checks
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [allow-scale1 : bool]
  [fan : OptBceVersionFan]
  [state : OptBceVersionDerive]) : OptBceVersionDerive
  (if (>= index last)
    state
    (opt-bce-version-derive-checks
      instrs
      (+ index 1)
      phi-count
      last
      defs
      loop-label
      pred-label
      iphi
      seed
      bound
      cell
      allow-scale1
      fan
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.BoundsCheck index-value length-value _)
          (match (opt-bce-version-invariant-operand
            instrs
            phi-count
            last
            defs
            length-value)
            [(ir.CompilerIrMaybeValue.Some length-invariant)
              (let
                [derived-guard : OptBceVersionGuardAcc
                  (opt-bce-version-derive-index
                    instrs
                    phi-count
                    last
                    defs
                    loop-label
                    pred-label
                    iphi
                    seed
                    bound
                    cell
                    index-value
                    length-invariant
                    allow-scale1
                    fan
                    state.guard)]
                (match derived-guard
                  [(OptBceVersionGuardAcc.No)
                    (OptBceVersionDerive
                      state.guard
                      (opt-bce-version-keep-add state.keep index)
                      state.derived)]
                  [(OptBceVersionGuardAcc.Some _ _ _)
                    (OptBceVersionDerive
                      derived-guard
                      state.keep
                      (+ state.derived 1))]))]
            [(ir.CompilerIrMaybeValue.No)
              (OptBceVersionDerive
                state.guard
                (opt-bce-version-keep-add state.keep index)
                state.derived)])]
        [_ state]))))

(define (opt-bce-version-append-reverse-instr-list!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [instrs : ir.CompilerIrInstrList]) : unit
  (match instrs
    [(ir.CompilerIrInstrList.Nil) unit]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (begin
        (opt-bce-version-append-reverse-instr-list!
          builder
          (__tl-box-place rest))
        (ir.compiler-ir-instr-builder-push! builder instr))]))

(define (opt-bce-version-and-chain-array
  [cell : (__tl_dyn-array i64)]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [current : ir.CompilerIrValue]
  [values : ir.CompilerIrValueSeq]
  [index : i64]) : ir.CompilerIrValue
  (if (>= index values.len)
    current
    (let
      [dst : i64 (opt-bce-version-alloc-var cell)]
      (begin
        (ir.compiler-ir-instr-builder-push!
          builder
          (ir.CompilerIrInstr.BinOp
            dst
            (ir.CompilerIrBinOp.And)
            current
            (array-ref values.slots index)
            (ast.AstType.Bool)))
        (opt-bce-version-and-chain-array
          cell
          builder
          (ir.CompilerIrValue.Var dst)
          values
          (+ index 1))))))

(define (opt-bce-version-and-chain
  [cell : (__tl_dyn-array i64)]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [first : ir.CompilerIrValue]
  [rest : ir.CompilerIrValueList]) : ir.CompilerIrValue
  (match rest
    [(ir.CompilerIrValueList.Nil) first]
    [(ir.CompilerIrValueList.Cons value tail)
      (let
        [dst : i64 (opt-bce-version-alloc-var cell)]
        (begin
          (ir.compiler-ir-instr-builder-push!
            builder
            (ir.CompilerIrInstr.BinOp
              dst
              (ir.CompilerIrBinOp.And)
              first
              value
              (ast.AstType.Bool)))
          (opt-bce-version-and-chain
            cell
            builder
            (ir.CompilerIrValue.Var dst)
            (__tl-box-place tail))))]
    [(ir.CompilerIrValueList.Array seq)
      (opt-bce-version-and-chain-array cell builder first seq 0)]))

(define (opt-bce-version-build-guard
  [cell : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrList]
  [values : ir.CompilerIrValueList]) : OptBceVersionGuardResult
  (let
    [value-count : i64 (ir.compiler-ir-value-list-count values)]
    (if (= value-count 0)
      (OptBceVersionGuardResult.No)
      (let
        [builder : ir.CompilerIrInstrBuilder
          (ir.compiler-ir-instr-builder-with-capacity
            (+
              (ir.compiler-ir-instr-list-count instrs)
              (if (> value-count 1)
                (- value-count 1)
                0)))]
        (begin
          (opt-bce-version-append-reverse-instr-list! (&mut builder) instrs)
          (match values
            [(ir.CompilerIrValueList.Nil) (OptBceVersionGuardResult.No)]
            [(ir.CompilerIrValueList.Cons first rest)
              (let
                [guard-value : ir.CompilerIrValue
                  (opt-bce-version-and-chain
                    cell
                    (&mut builder)
                    first
                    (__tl-box-place rest))]
                (OptBceVersionGuardResult.Some
                  (ir.compiler-ir-instr-builder-to-seq builder)
                  guard-value))]
            [(ir.CompilerIrValueList.Array seq)
              (let
                [guard-value : ir.CompilerIrValue
                  (opt-bce-version-and-chain-array
                    cell
                    (&mut builder)
                    (array-ref seq.slots 0)
                    seq
                    1)]
                (OptBceVersionGuardResult.Some
                  (ir.compiler-ir-instr-builder-to-seq builder)
                  guard-value))]))))))

;; Assemble the guard from the derived per-check conditions: the once-only
;; `seed < bound` and `seed >= 0` when any counter-cased check needs them (a
;; literal non-negative seed skips the latter; a literal negative seed
;; rejects -- the guard could never pass), then the And chain over every
;; condition value.
;;
;; `step` is the counter's positive literal increment. For a step greater
;; than 1 the counter's last visited value `bound - 1` does not by itself
;; keep the final increment representable: `bound - 1 + step` can exceed i64
;; MAX, and a wrapped (negative) counter would pass the signed latch compare
;; and run trips the [seed, bound-1] range argument never covered. Emit one
;; more once-only condition in that case (and only when a counter-bearing
;; derivation fired, like the seed compares):
;;
;;   wrap(bound + step - 1) >= bound      (signed Ge on a wrapping Add)
;;
;; It decides exactly `bound <= MAX - step + 1`. Write d = step - 1, so
;; 1 <= d <= MAX-1. If `bound <= MAX - d` the sum neither overflows (it is at
;; most MAX) nor underflows (d is positive), so the compare sees
;; `bound + d > bound` and holds. Otherwise `bound + d > MAX`, and since
;; `bound + d <= 2*MAX - 1 < 2^64` the wrap lands in [-2^63, -2] while
;; `bound > MAX - d >= 1` is positive, so the compare fails. Preferring the
;; add to a direct `bound <= MAX - step + 1` keeps the cap out of the
;; instruction stream: the literal needs no 64-bit immediate materialization,
;; the add folds into one lea, and the decision is bit-identical.
;;
;; The condition makes `last + step <= bound - 1 + step <= MAX`, so the
;; counter cannot wrap: it strictly increases to `bound` and the loop
;; terminates, with every executed trip's counter in [seed, bound-1] -- the
;; exact assumption every counter-involving derivation (this pass's and the
;; multi-block pass's, which shares this finisher) makes. Step 1 needs
;; nothing: `last + 1 <= bound <= MAX` already. A literal bound folds the
;; check at compile time against the cap itself (no wrapping arithmetic in
;; the compiler): a satisfying one emits no instruction, a violating one
;; rejects -- the fast path could never be selected.
(define (opt-bce-version-guard-finish
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [step : i64]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardResult
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceVersionGuardResult.No)]
    [(OptBceVersionGuardAcc.Some cond-instrs cond-values counter-seen)
      (let
        ;; The canonical self-loop is do-while shaped: the FIRST body
        ;; iteration (index = seed) runs before any compare, so the counter
        ;; range argument also needs `seed < bound` in the guard -- without
        ;; it a loop entered with seed >= bound would run one unchecked fast
        ;; iteration at an index the slow path would have aborted on.
        ;; Rotated loops satisfy it dynamically (their preheader guard
        ;; proved a first iteration), so the compare never deselects the
        ;; fast path there.
        [entered : OptBceVersionGuardAcc
          (if counter-seen
            (match seed
              [(ir.CompilerIrValue.I64 sk)
                (match bound
                  [(ir.CompilerIrValue.I64 bk)
                    (if (< sk bk)
                      (OptBceVersionGuardAcc.Some cond-instrs cond-values true)
                      (OptBceVersionGuardAcc.No))]
                  [_
                    (opt-bce-version-cond
                      cell
                      (ir.CompilerIrBinOp.Lt)
                      seed
                      bound
                      (OptBceVersionGuardAcc.Some cond-instrs cond-values true))])]
              [_
                (opt-bce-version-cond
                  cell
                  (ir.CompilerIrBinOp.Lt)
                  seed
                  bound
                  (OptBceVersionGuardAcc.Some cond-instrs cond-values true))])
            (OptBceVersionGuardAcc.Some cond-instrs cond-values false))]
        [seeded : OptBceVersionGuardAcc
          (if counter-seen
            (match entered
              [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
              [(OptBceVersionGuardAcc.Some e-instrs e-values _)
                (match seed
                  [(ir.CompilerIrValue.I64 k)
                    (if (>= k 0)
                      (OptBceVersionGuardAcc.Some e-instrs e-values true)
                      (OptBceVersionGuardAcc.No))]
                  [(ir.CompilerIrValue.Var _)
                    (opt-bce-version-cond
                      cell
                      (ir.CompilerIrBinOp.Ge)
                      seed
                      (ir.CompilerIrValue.I64 0)
                      (OptBceVersionGuardAcc.Some e-instrs e-values true))]
                  [_ (OptBceVersionGuardAcc.No)])])
            entered)]
        [unwrapped : OptBceVersionGuardAcc
          (if (and counter-seen (> step 1))
            (match seeded
              [(OptBceVersionGuardAcc.No) (OptBceVersionGuardAcc.No)]
              [(OptBceVersionGuardAcc.Some s-instrs s-values _)
                (match bound
                  [(ir.CompilerIrValue.I64 bk)
                    ;; Representable for every literal step in [2, MAX].
                    (if (<= bk (+ (- 9223372036854775807 step) 1))
                      (OptBceVersionGuardAcc.Some s-instrs s-values true)
                      (OptBceVersionGuardAcc.No))]
                  [_
                    (let
                      [probe : i64 (opt-bce-version-alloc-var cell)]
                      (opt-bce-version-cond
                        cell
                        (ir.CompilerIrBinOp.Ge)
                        (ir.CompilerIrValue.Var probe)
                        bound
                        (OptBceVersionGuardAcc.Some
                          (ir.compiler-ir-instr-cons
                            (ir.CompilerIrInstr.BinOp
                              probe
                              (ir.CompilerIrBinOp.Add)
                              bound
                              (ir.CompilerIrValue.I64 (- step 1))
                              (ast.AstType.I64))
                            s-instrs)
                          s-values
                          true)))])])
            seeded)]
        (match unwrapped
          [(OptBceVersionGuardAcc.No) (OptBceVersionGuardResult.No)]
          [(OptBceVersionGuardAcc.Some all-instrs all-values _)
            (opt-bce-version-build-guard cell all-instrs all-values)]))]))

;; Append the terminating branch to a freshly built dense guard block.
(define (opt-bce-version-guard-block
  [label : i64]
  [guard-instrs : ir.CompilerIrInstrSeq]
  [guard-value : ir.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]) : ir.CompilerIrBlock
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count guard-instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity (+ count 1))]
    (begin
      (ir.compiler-ir-instr-builder-append-seq-range!
        (&mut builder)
        guard-instrs
        0
        count)
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Branch guard-value true-label false-label))
      (ir.CompilerIrBlock.Block
        label
        (ir.compiler-ir-instr-builder-to-seq builder)))))

;; The empty derivation state every scan starts from.
(define (opt-bce-version-derive-start [index-bound : i64]) : OptBceVersionDerive
  (OptBceVersionDerive
    (OptBceVersionGuardAcc.Some
      (ir.CompilerIrInstrList.Nil)
      (ir.CompilerIrValueList.Nil)
      false)
    (opt-bce-version-keep-new index-bound)
    0))

;; Assemble the single-block guard: derive the per-check conditions, then
;; finish them (seed compares + And chain).
;;
;; The scale-1 variable-base form is admitted only when the loop ends up with
;; at least TWO eliminable checks (the guard-economics gate documented at the
;; head of this pass). Deciding that needs the derived count, which is what
;; the scan produces, so the scan runs twice: once on a THROWAWAY var counter
;; to take the census, then for real with the verdict. The trial's condition
;; instructions are discarded with its counter, so the emitted guard is
;; exactly what a single scan under the chosen verdict would build, and a
;; rejected verdict reproduces the pre-gate behaviour instruction for
;; instruction.
(define (opt-bce-version-guard-conds
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [defs : opt_i64_i64_map.Map]
  [loop-label : i64]
  [pred-label : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [step : i64]
  [cell : (__tl_dyn-array i64)]) : OptBceVersionGuardOut
  (let
    [census-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [_census-seed : unit (set! (array-ref census-cell 0) (array-ref cell 0))]
    ;; The census gets its own fan table for the same reason it gets its own
    ;; var counter: its records are discarded with its conditions.
    [census : OptBceVersionDerive
      (opt-bce-version-derive-checks
        instrs
        phi-count
        phi-count
        last
        defs
        loop-label
        pred-label
        iphi
        seed
        bound
        census-cell
        true
        (opt-bce-version-fan-new)
        (opt-bce-version-derive-start last))]
    [allow-scale1 : bool (>= census.derived 2)]
    [fan : OptBceVersionFan (opt-bce-version-fan-new)]
    [state : OptBceVersionDerive
      (opt-bce-version-derive-checks
        instrs
        phi-count
        phi-count
        last
        defs
        loop-label
        pred-label
        iphi
        seed
        bound
        cell
        allow-scale1
        fan
        (opt-bce-version-derive-start last))]
    ;; Partial versioning still needs at least one REMOVED check to pay for
    ;; the clone; with none, the loop is left untouched.
    (if (= state.derived 0)
      (OptBceVersionGuardOut.No)
      (match (opt-bce-version-guard-finish
        seed
        bound
        step
        cell
        ;; The fan's extremal conditions join the accumulator only here, once
        ;; per loop, instead of twice per fan member.
        (opt-bce-version-fan-flush fan 0 seed bound cell state.guard))
        [(OptBceVersionGuardResult.No) (OptBceVersionGuardOut.No)]
        [(OptBceVersionGuardResult.Some guard-instrs guard-value)
          (OptBceVersionGuardOut.Some guard-instrs guard-value state.keep)]))))

;; The counter's positive literal step, re-derived from the back-edge add the
;; shape scan already verified: `inext = iphi + literal` in this block. 0 on
;; any mismatch -- impossible after opt-bce-version-shape-step admitted the
;; loop, and rejected by the caller before any guard is built, so a stale
;; shape can never sneak a step-1 assumption past the no-wrap condition.
(define (opt-bce-version-shape-step-value
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [iphi : i64]
  [inext : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
    (if (< inext-index 0)
      0
      (match (ir.compiler-ir-instr-seq-ref instrs inext-index)
        [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
          (match op
            [(ir.CompilerIrBinOp.Add)
              (match lhs
                [(ir.CompilerIrValue.Var src)
                  (match rhs
                    [(ir.CompilerIrValue.I64 step)
                      (if (and
                        (> step 0)
                        (=
                          (opt-bce-version-resolve instrs phi-count last src 16)
                          iphi))
                        step
                        0)]
                    [_ 0])]
                [_ 0])]
            [_ 0])]
        [_ 0]))))

;; --- shape scan ---------------------------------------------------------------
(define (opt-bce-version-shape-phi
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-index : i64]
  [cond-var : i64]
  [inext : i64]
  [ity : ast.AstType]
  [bound : ir.CompilerIrValue]
  [iphi : i64]) : OptUnrollMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [iphi-index : i64 (opt-unroll-def-index slots 0 phi-count iphi)]
    (if (< iphi-index 0)
      (OptUnrollMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs iphi-index)
        [(ir.CompilerIrInstr.Phi _ inputs iphi-ty)
          (match (opt-unroll-split-phi-inputs inputs label)
            [(OptUnrollPhiSplit.Split seed back pred-label)
              (if (and
                (not (= pred-label label))
                (opt-unroll-back-resolves-to? instrs phi-count last back inext)
                (not
                  (opt-cfg-block-exists?
                    blocks
                    (ir.compiler-ir-label
                      (str_cat.str-cat
                        (ir.compiler-ir-label-text label)
                        "__bce_guard"))))
                (not
                  (opt-cfg-block-exists?
                    blocks
                    (ir.compiler-ir-label
                      (str_cat.str-cat
                        (ir.compiler-ir-label-text label)
                        "__bce_fast"))))
                (opt-unroll-pred-retargetable? blocks pred-label))
                (match (opt-unroll-collect-other-phis
                  instrs
                  0
                  phi-count
                  label
                  pred-label
                  iphi)
                  [(OptUnrollMaybePhis.Some others)
                    (OptUnrollMaybeShape.Some
                      (OptUnrollShape
                        label
                        pred-label
                        phi-count
                        cond-index
                        cond-var
                        iphi
                        iphi-ty
                        seed
                        inext
                        ity
                        bound
                        others))]
                  [(OptUnrollMaybePhis.No) (OptUnrollMaybeShape.No)])
                (OptUnrollMaybeShape.No))]
            [(OptUnrollPhiSplit.No) (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-bce-version-shape-step
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [cond-index : i64]
  [inext : i64]
  [bound : ir.CompilerIrValue]) : OptUnrollMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [inext-index : i64 (opt-unroll-def-index slots phi-count last inext)]
    (if (< inext-index 0)
      (OptUnrollMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs inext-index)
        [(ir.CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-op
            [(ir.CompilerIrBinOp.Add)
              (match add-lhs
                [(ir.CompilerIrValue.Var add-src)
                  (match add-rhs
                    [(ir.CompilerIrValue.I64 step)
                      (if (and
                        ;; Any positive literal step: every derivation reasons
                        ;; about the set of executed-trip counter values (a
                        ;; subset of [seed, bound-1] for any positive step),
                        ;; and the guard's no-wrap condition
                        ;; (opt-bce-version-guard-finish) covers steps > 1.
                        (> step 0)
                        ;; I64 only: the guard reasons in SIGNED 64-bit
                        ;; arithmetic, so narrow (wrapping) and unsigned
                        ;; counters are out of scope.
                        (match ity
                          [(ast.AstType.I64) true]
                          [_ false]))
                        (opt-bce-version-shape-phi
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-index
                          cond-var
                          inext
                          ity
                          bound
                          (opt-unroll-resolve-copy
                            instrs
                            phi-count
                            last
                            add-src
                            16))
                        (OptUnrollMaybeShape.No))]
                    [_ (OptUnrollMaybeShape.No)])]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-bce-version-shape-counter
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [last : i64]
  [cond-var : i64]
  [defs : opt_i64_i64_map.Map]) : OptUnrollMaybeShape
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [cond-index : i64 (opt-unroll-def-index slots phi-count last cond-var)]
    (if (< cond-index 0)
      (OptUnrollMaybeShape.No)
      (match (ir.compiler-ir-instr-seq-ref instrs cond-index)
        [(ir.CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(ir.CompilerIrBinOp.Lt)
              (match cmp-lhs
                [(ir.CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound? defs cmp-rhs)
                    (opt-bce-version-shape-step
                      blocks
                      label
                      instrs
                      phi-count
                      last
                      cond-var
                      cond-index
                      (opt-unroll-resolve-copy instrs phi-count last cmp-src 16)
                      cmp-rhs)
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])]
        [_ (OptUnrollMaybeShape.No)]))))

(define (opt-bce-version-block-shape
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [block : ir.CompilerIrBlock]) : OptUnrollMaybeShape
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          (OptUnrollMaybeShape.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label label)
                    (not (= else-label label))
                    (not (= label entry-label)))
                    (let
                      [last : i64 (- count 1)]
                      [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
                      (if (or
                        (< phi-count 1)
                        (< (- last phi-count) 2)
                        (> (- last phi-count) (opt-bce-version-body-max))
                        (not (opt-unroll-no-phi-from? instrs phi-count))
                        (not (opt-bce-version-body-ok? instrs phi-count last))
                        (<
                          (opt-bce-version-check-count instrs phi-count last 0)
                          1))
                        (OptUnrollMaybeShape.No)
                        (opt-bce-version-shape-counter
                          blocks
                          label
                          instrs
                          phi-count
                          last
                          cond-var
                          (opt-unroll-block-defs
                            instrs.slots
                            0
                            (+ last 1)
                            (opt_i64_i64_map.with-capacity 32)))))
                    (OptUnrollMaybeShape.No))]
                [_ (OptUnrollMaybeShape.No)])]
            [_ (OptUnrollMaybeShape.No)])))]))

;; --- rewrite -------------------------------------------------------------------
;; Uses of loop defs anywhere outside the loop block, except as the loop-edge
;; inputs of the exit block's phis (those get the parallel fast input).
(define (opt-bce-version-outside-phi-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [inputs : ir.CompilerIrPhiInputList]
  [loop-label : i64]) : opt_i64_i64_map.Map
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) set]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-version-outside-phi-uses
        set
        (ir.compiler-ir-phi-input-seq-to-list seq)
        loop-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (opt-bce-version-outside-phi-uses
        (if (= label loop-label)
          set
          (opt-collect-value-uses set value))
        (__tl-box-place rest)
        loop-label)]))

(define (opt-bce-version-outside-uses-seq
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [loop-label : i64]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    set
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (opt-bce-version-outside-uses-seq
        (match instr
          [(ir.CompilerIrInstr.Phi _ inputs _)
            (opt-bce-version-outside-phi-uses set inputs loop-label)]
          [_ (opt-collect-instr-uses set instr)])
        instrs
        (+ index 1)
        loop-label))))

(define (opt-bce-version-outside-uses
  [set : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [loop-label : i64]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-version-outside-uses
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (if (= label loop-label)
              set
              (opt-bce-version-outside-uses-seq set instrs 0 loop-label))])
        (__tl-box-place rest)
        loop-label)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-version-outside-uses
        set
        (ir.compiler-ir-block-seq-to-list seq)
        loop-label)]))

(define (opt-bce-version-defs-escape?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [outside : opt_i64_i64_map.Map]) : bool
  (if (>= index count)
    false
    (let
      [dst : i64 (ir.compiler-ir-instr-array-loop-dst-or slots index (- 0 1))]
      (if (and (>= dst 0) (opt-used-contains outside dst))
        true
        (opt-bce-version-defs-escape? slots (+ index 1) count outside)))))

;; The fast clone's leading phis: the counter and every loop-carried value,
;; seeded from the guard and chained through the clone's remapped back edges.
(define (opt-bce-version-fast-phis
  [others : OptUnrollPhiList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [guard-label : i64]
  [fast-label : i64]
  [tail : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match others
    [(OptUnrollPhiList.Nil) tail]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi dst init back ty)
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Phi
              (match (opt-unroll-subst-value remap (ir.CompilerIrValue.Var dst))
                [(ir.CompilerIrValue.Var fresh-id) fresh-id]
                [_ dst])
              (ir.compiler-ir-phi-input-cons
                init
                guard-label
                (ir.compiler-ir-phi-input-cons
                  (opt-unroll-subst-value remap back)
                  fast-label
                  (ir.CompilerIrPhiInputList.Nil)))
              ty)
            (opt-bce-version-fast-phis
              (__tl-box-place rest)
              remap
              guard-label
              fast-label
              tail))])]))

;; Clone the loop body for the fast path, dropping the checks the guard
;; covers and KEEPING (remapped) each underivable check in the keep set:
;; a kept check still executes -- and may still abort -- on the fast path,
;; exactly as on the slow path.
(define (opt-bce-version-clone-body
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [keep : OptBceVersionKeep]) : ir.CompilerIrInstrList
  (if (>= index last)
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.BoundsCheck _ _ _)
          (if (opt-bce-version-keep-contains? keep index)
            (ir.compiler-ir-instr-cons
              (opt-unroll-clone-instr remap cell 0 instr)
              (opt-bce-version-clone-body
                instrs
                (+ index 1)
                last
                remap
                cell
                keep))
            (opt-bce-version-clone-body instrs (+ index 1) last remap cell keep))]
        [_
          (let
            [cloned : ir.CompilerIrInstr
              (opt-unroll-clone-instr remap cell 0 instr)]
            (ir.compiler-ir-instr-cons
              cloned
              (opt-bce-version-clone-body
                instrs
                (+ index 1)
                last
                remap
                cell
                keep)))]))))

;; Relabel the loop phis' outside-pred inputs to the guard block.
(define (opt-relabel-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [pred-label : i64]
  [guard-label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-relabel-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        pred-label
        guard-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        value
        (if (= label pred-label)
          guard-label
          label)
        (opt-relabel-phi-inputs (__tl-box-place rest) pred-label guard-label))]))

(define (opt-relabel-phi-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [pred-label : i64]
  [guard-label : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (ir.compiler-ir-instr-cons
        (match instr
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (ir.CompilerIrInstr.Phi
              dst
              (opt-relabel-phi-inputs inputs pred-label guard-label)
              ty)]
          [_ instr])
        (opt-relabel-phi-instrs instrs (+ index 1) pred-label guard-label)))))

;; Extend the exit block's phis: every input carried on the loop edge gains a
;; parallel input carrying the fast clone's remapped value.
(define (opt-bce-version-extend-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [loop-label : i64]
  [fast-label : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-version-extend-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        loop-label
        fast-label
        remap)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : ir.CompilerIrPhiInputList
          (opt-bce-version-extend-phi-inputs
            (__tl-box-place rest)
            loop-label
            fast-label
            remap)]
        (if (= label loop-label)
          (ir.compiler-ir-phi-input-cons
            value
            label
            (ir.compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap value)
              fast-label
              tail))
          (ir.compiler-ir-phi-input-cons value label tail)))]))

(define (opt-bce-version-extend-exit-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [loop-label : i64]
  [fast-label : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (ir.compiler-ir-instr-cons
        (match instr
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (ir.CompilerIrInstr.Phi
              dst
              (opt-bce-version-extend-phi-inputs
                inputs
                loop-label
                fast-label
                remap)
              ty)]
          [_ instr])
        (opt-bce-version-extend-exit-instrs
          instrs
          (+ index 1)
          loop-label
          fast-label
          remap)))))

(define (opt-bce-version-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [pred-label : i64]
  [loop-label : i64]
  [exit-label : i64]
  [fast-label : i64]
  [guard-label : i64]
  [guard-block : ir.CompilerIrBlock]
  [fast-block : ir.CompilerIrBlock]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-bce-version-rewrite-blocks
                (__tl-box-place rest)
                pred-label
                loop-label
                exit-label
                fast-label
                guard-label
                guard-block
                fast-block
                remap)]
            (if (= label loop-label)
              (ir.compiler-ir-block-cons
                guard-block
                (ir.compiler-ir-block-cons
                  fast-block
                  (ir.compiler-ir-block-cons
                    (ir.compiler-ir-block
                      label
                      (opt-relabel-phi-instrs instrs 0 pred-label guard-label))
                    tail)))
              (ir.compiler-ir-block-cons
                (cond
                  [(= label pred-label)
                    (ir.compiler-ir-block
                      label
                      (opt-unroll-retarget-instrs
                        instrs
                        0
                        loop-label
                        guard-label))]
                  [(= label exit-label)
                    (ir.compiler-ir-block
                      label
                      (opt-bce-version-extend-exit-instrs
                        instrs
                        0
                        loop-label
                        fast-label
                        remap))]
                  [else block])
                tail)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-version-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        pred-label
        loop-label
        exit-label
        fast-label
        guard-label
        guard-block
        fast-block
        remap)]))

(define (opt-bce-version-apply
  [blocks : ir.CompilerIrBlockList]
  [block : ir.CompilerIrBlock]
  [shape : OptUnrollShape]
  [frame : i64]) : OptUnrollResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [last : i64 (- count 1)]
        [phi-count : i64 shape.phi-count]
        [iphi : i64 shape.iphi]
        [iphi-ty : ast.AstType shape.iphi-ty]
        [seed : ir.CompilerIrValue shape.seed]
        [inext : i64 shape.inext]
        [bound : ir.CompilerIrValue shape.bound]
        [others : OptUnrollPhiList shape.others]
        [pred-label : i64 shape.pred-label]
        [cond-var : i64 shape.cond-var]
        [exit-label : i64
          (match (ir.compiler-ir-instr-seq-ref instrs last)
            [(ir.CompilerIrInstr.Branch _ _ else-label) else-label]
            [_ label])]
        [guard-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_guard"))]
        [fast-label : i64
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_fast"))]
        [defs : opt_i64_i64_map.Map
          (opt-unroll-block-defs
            instrs.slots
            0
            (ir.compiler-ir-instr-seq-count instrs)
            (opt_i64_i64_map.with-capacity 32))]
        [outside : opt_i64_i64_map.Map
          (opt-bce-version-outside-uses
            (opt_i64_i64_map.with-capacity 64)
            blocks
            label)]
        ;; The guard's no-wrap condition needs the exact literal step; the
        ;; shape scan verified this add but did not record it.
        [step : i64
          (opt-bce-version-shape-step-value instrs phi-count last iphi inext)]
        (if (or
          (= exit-label label)
          (= exit-label pred-label)
          (<= step 0)
          (opt-bce-version-defs-escape?
            instrs.slots
            0
            (ir.compiler-ir-instr-seq-count instrs)
            outside))
          (OptUnrollResult.Result blocks frame false)
          (let
            [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
            [_cell : unit (set! (array-ref cell 0) frame)]
            (match (opt-bce-version-guard-conds
              instrs
              phi-count
              last
              defs
              label
              pred-label
              iphi
              seed
              bound
              step
              cell)
              [(OptBceVersionGuardOut.No)
                (OptUnrollResult.Result blocks frame false)]
              [(OptBceVersionGuardOut.Some guard-instrs guard-value keep)
                (let
                  [remap : (__tl_dyn-array ir.CompilerIrValue)
                    (array.make-array ir.CompilerIrValue frame)]
                  [_fill : unit (opt-unroll-remap-fill remap 0)]
                  ;; Fresh phi destinations first so the cloned body reads the
                  ;; clone's loop-carried values.
                  [_iphi : i64 (opt-unroll-clone-dst remap cell iphi)]
                  [_others : unit
                    (opt-bce-version-alloc-other-phis remap cell others)]
                  [body : ir.CompilerIrInstrList
                    (opt-bce-version-clone-body
                      instrs
                      phi-count
                      last
                      remap
                      cell
                      keep)]
                  [fast-block : ir.CompilerIrBlock
                    (ir.compiler-ir-block
                      fast-label
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.Phi
                          (match (opt-unroll-subst-value
                            remap
                            (ir.CompilerIrValue.Var iphi))
                            [(ir.CompilerIrValue.Var fresh-id) fresh-id]
                            [_ iphi])
                          (ir.compiler-ir-phi-input-cons
                            seed
                            guard-label
                            (ir.compiler-ir-phi-input-cons
                              (opt-unroll-subst-value
                                remap
                                (ir.CompilerIrValue.Var inext))
                              fast-label
                              (ir.CompilerIrPhiInputList.Nil)))
                          iphi-ty)
                        (opt-bce-version-fast-phis
                          others
                          remap
                          guard-label
                          fast-label
                          (opt-aggregate-instr-list-append
                            body
                            (ir.compiler-ir-instr-cons
                              (ir.CompilerIrInstr.Branch
                                (opt-unroll-subst-value
                                  remap
                                  (ir.CompilerIrValue.Var cond-var))
                                fast-label
                                exit-label)
                              (ir.CompilerIrInstrList.Nil))))))]
                  [guard-block : ir.CompilerIrBlock
                    (opt-bce-version-guard-block
                      guard-label
                      guard-instrs
                      guard-value
                      fast-label
                      label)]
                  (OptUnrollResult.Result
                    (opt-bce-version-rewrite-blocks
                      blocks
                      pred-label
                      label
                      exit-label
                      fast-label
                      guard-label
                      guard-block
                      fast-block
                      remap)
                    (array-ref cell 0)
                    true))]))))]))

(define (opt-bce-version-alloc-other-phis
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [others : OptUnrollPhiList]) : unit
  (match others
    [(OptUnrollPhiList.Nil) unit]
    [(OptUnrollPhiList.Cons phi rest)
      (match phi
        [(OptUnrollPhi.Phi dst _ _ _)
          (begin
            (opt-unroll-clone-dst remap cell dst)
            (opt-bce-version-alloc-other-phis remap cell (__tl-box-place rest)))])]))

;; A scan's outcome, plus WHICH loop it applied to: the header (single-block
;; loop label / multi-block loop header) the rewrite belongs to, or
;; `ir.compiler-ir-label-none` when nothing applied. The driver needs that
;; label to retire exactly the loop whose rewrite its post-application verify
;; refused, instead of giving up on the whole function.
(defenum OptBceVersionScan
  (Scan ir.CompilerIrBlockList i64 bool i64))

;; One scan applies at most one versioning; the driver repeats the scan while
;; the invocation's budget (opt-loop-apply-budget) lasts, like the unroller.
;; `rejected` holds the loops this invocation already retired (their rewrite
;; failed verification); the scan skips them and offers the next candidate.
(define (opt-bce-version-blocks-scan
  [blocks : ir.CompilerIrBlockList]
  [remaining : ir.CompilerIrBlockList]
  [entry-label : i64]
  [rejected : OptLabelSet]
  [frame : i64]) : OptBceVersionScan
  (match remaining
    [(ir.CompilerIrBlockList.Nil)
      (OptBceVersionScan.Scan blocks frame false (ir.compiler-ir-label-none))]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-bce-version-block-shape blocks entry-label block)
        [(OptUnrollMaybeShape.Some shape)
          (if (opt-label-contains rejected shape.loop-label)
            (opt-bce-version-blocks-scan
              blocks
              (__tl-box-place rest)
              entry-label
              rejected
              frame)
            (match (opt-bce-version-apply blocks block shape frame)
              [(OptUnrollResult.Result next-blocks next-frame changed)
                (if changed
                  (OptBceVersionScan.Scan
                    next-blocks
                    next-frame
                    true
                    shape.loop-label)
                  (opt-bce-version-blocks-scan
                    blocks
                    (__tl-box-place rest)
                    entry-label
                    rejected
                    frame))]))]
        [(OptUnrollMaybeShape.No)
          (opt-bce-version-blocks-scan
            blocks
            (__tl-box-place rest)
            entry-label
            rejected
            frame)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-version-blocks-scan
        blocks
        (ir.compiler-ir-block-seq-to-list seq)
        entry-label
        rejected
        frame)]))

;; Cheap prescan: a candidate is a self-loop block that starts with a Phi,
;; ends with a self-branch, and contains a BoundsCheck.
(define (opt-bce-version-block-candidate? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 4)
          false
          (match (ir.compiler-ir-instr-seq-ref instrs 0)
            [(ir.CompilerIrInstr.Phi _ _ _)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch _ true-label _)
                  (and
                    (= true-label label)
                    (>= (opt-bce-version-check-count instrs 0 (- count 1) 0) 1))]
                [_ false])]
            [_ false])))]))

(define (opt-bce-version-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-bce-version-block-candidate? block)
        true
        (opt-bce-version-blocks-have-candidate? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-version-blocks-have-candidate?
        (ir.compiler-ir-block-seq-to-list seq))]))

;; --- multi-block bounds-check loop versioning ----------------------------------
;;
;; The single-block pass above only sees do-while self-loops. A counted loop
;; whose body spans several blocks (an if/else inside a scan -- the quicksort
;; partition loop is the running example) pays the same per-iteration cmp+jb
;; on every BoundsCheck even though the same up-front reasoning applies: a
;; counter phi stepping by a positive literal per latch crossing (+1 scans,
;; +8 word-strided loaders) with an invariant
;; bound, plus a second "bounded" header phi sharing the counter's seed whose
;; back-edge value stays within {sphi, sphi+1} through any merge, keeps every
;; provable index inside [0, len) for the whole trip range whenever
;;   seed >= 0 && seed < bound && bound <= len.
;; The bounded phi's +1-per-crossing growth never outpaces the counter's own
;; (positive) step, so `sphi <= scan` holds for any admitted counter step.
;; Like the single-block pass, every derivation reasons about the SET of
;; executed-trip counter values -- a subset of [seed, bound-1] for any
;; positive step -- so the per-check guards are step-independent, and the
;; shared guard finisher (opt-bce-version-guard-finish) adds the one no-wrap
;; condition `wrap(bound + step - 1) >= bound` when the step is greater than
;; 1: without it a counter wrapping past i64 MAX would pass the signed latch
;; compare again and run trips the range argument never covered.
;; This pass recognizes such a loop from its natural-loop back edge (header
;; dominating latch, a single dedicated preheader whose only successor is the
;; header, a clone that fits the growth budget -- <= (opt-bce-mb-instr-max)
;; non-phi instructions across the loop, with (opt-bce-mb-block-max) only a
;; bookkeeping safety bound -- clonable whitelist instructions
;; only, Jump/Branch/Switch or intra-loop fallthrough terminators only) and versions
;; like the single-block pass: a guard block on the preheader edge branches
;; to a fast clone of the whole loop when the guard conjunction holds and to
;; the original checked loop otherwise. PARTIAL elimination: every BoundsCheck
;; whose condition derives is dropped from the clone; a check that does not
;; derive (a dynamic stack index, a second array, ...) is simply KEPT there --
;; remapped like every other cloned instruction -- instead of rejecting the
;; whole loop, and the guard constrains only the removed checks. Cloning
;; requires at least one derivable check; the kept checks preserve the exact
;; abort semantics of the slow path.
;;
;; Derivations (a check matching none of these stays in the clone):
;;   * index resolves to the counter phi       -> `bound <= len`
;;   * index resolves to a bounded header phi  -> covered by the counter's
;;     conditions (same resolved seed; back-edge value is sphi or sphi+1
;;     through any phi merge, so seed <= sphi <= scan < bound <= len); emits
;;     `bound <= len` and forces the counter seed compares
;;   * index == BitAnd(_, M), M >= 0 literal   -> `M < len`
;;   * index == counter+offset+base (either operand order, literal offset,
;;     scale exactly 1, loop-invariant VARIABLE base) -> the wrap-safe
;;     scale-1 quotient guard with the base folded in for the literal
;;     offset: `base_eff >= 0 && bound-1 <= length-1-base_eff`; the division
;;     is exact at scale 1 and needs no instruction, and a wrapped base only
;;     ever deselects the fast path
;;   * index loop-invariant                    -> `index >= 0 && index < len`
;; A latch-merge-phi index (sphi+1 selected at the merge) is deliberately NOT
;; accepted: it can reach `bound` itself, which `bound <= len` does not
;; exclude from failing. Likewise `sphi + 1` used directly.
;;
;; A check's length must be loop-invariant. When it is not, a length that
;; resolves to `Load (Gep base, length-slot)` of an array/string descriptor
;; handle (the same classification LICM uses for descriptor hoisting) is
;; still provably trip-invariant whenever NO loop block may write memory
;; (the load_combine may-write classification: no stores, no calls): nothing
;; can change the loaded value mid-loop. The guard then references a hoisted
;; gep+load pair emitted into the guard block itself -- one pair per distinct
;; (base, offset) -- reading a live descriptor's length slot is always safe,
;; so the extra load on a zero-trip path is sound.
;;
;; The counted shape is either the do-while form above or a TOP-TESTED loop:
;; latch `Jump header` with the counter compare `iphi < bound` ending an
;; exiting `Branch c continue exit` on the loop's ENTRY GUARD CHAIN -- the
;; header, or any block reached from it by single in-loop successors, so a
;; second exiting branch ahead of the compare (`(while (if done false (< i n))
;; ...)`) is admitted rather than refused. Every body execution has then
;; already passed the compare, so the same [seed, bound) trip-range argument
;; stays sound; early exits only shrink the executed range. The chain blocks
;; themselves run one time more than the body does, so THEIR checks are kept
;; in the clone (see `opt-bce-mb-chain-walk`).
;;
;; Exit wiring generalizes the single-block scheme: loop defs may reach
;; outside code as exit-phi inputs on loop edges (each such input gains a
;; parallel input from the corresponding fast clone's edge). A DIRECT outside
;; use (a return operand, an arithmetic use) is also admitted when every
;; predecessor of the using block is a loop block or a single-edge
;; forwarding stub (an outside block that only Jumps to the user, check-free,
;; clonable, all of whose own predecessors are loop blocks): the use is
;; rewritten to a freshly materialized phi carrying the def on every
;; predecessor edge, the stubs join the clone group so fast arrivals get
;; fast twins of the stubs and the phi gains the parallel fast-edge inputs,
;; and the slow blocks stay instruction-for-instruction the original. Any
;; other outside use (a block with a non-loop non-stub predecessor, a phi
;; input on a non-loop edge) rejects.
;; Fallthrough is positional: loop blocks may only fall
;; through to other loop blocks, the fast clone group preserves the loop's
;; block order so intra-loop fallthroughs clone correctly, and the guard
;; sits immediately before the slow header so a fallthrough preheader lands
;; on it.
;;
;; LOOP NESTS. A candidate body holding another loop's header is admitted:
;; the natural loop's block set already IS the nest, the clone group copies it
;; whole (an inner header phi's inputs name inner-loop labels, which remap to
;; their fast twins exactly like every other intra-loop edge), and every
;; derivation reasons only about THIS loop's counter and its invariants -- an
;; inner counter is defined inside the body, so it is neither the counter phi
;; nor loop-invariant and can never be folded into the guard. An inner header
;; phi cannot pose as this loop's bounded phi either: the recovery demands a
;; two-input phi split as (this preheader, this latch), which an inner header
;; never has. What a nest changes is economics, not soundness, and that is
;; handled outside the shape scan: the nest budgets
;; (opt-bce-mb-nest-instr-max / -nest-block-max) cap the duplicated region,
;; and the scan offers flat loops before nests so an inner loop that can
;; version on its own always gets the slot first.
(defenum OptBceMbMaybeInstr
  (No)
  (Some ir.CompilerIrInstr))

(defenum OptBceMbMaybeSeed
  (No)
  (Some ir.CompilerIrValue))

;; cond-var, exit-label of a latch branch.
(defenum OptBceMbMaybeLatch
  (No)
  (Some i64 i64))

;; iphi, seed, inext, bound, step (the counter's literal step; the guard's
;; no-wrap condition needs it for increments greater than 1).
;;
;; A POSITIVE step is the ascending loop: `seed` is the counter's inclusive
;; first value and `bound` the exclusive limit its `<` compare tests.
;;
;; A NEGATIVE step is the descending loop, and the two roles swap. `seed` is
;; still the counter's first value -- now the range's TOP -- and `bound` is the
;; INCLUSIVE bottom the loop's `>=` compare tests. See
;; opt-bce-mb-counter-range for the one place that difference is interpreted;
;; every derivation downstream of it reads an ascending [first, limit) pair and
;; never asks which way the counter walked.
(defenum OptBceMbMaybeCounter
  (No)
  (Some i64 ir.CompilerIrValue i64 ir.CompilerIrValue i64))

(defstruct OptBceMbShape
  (header i64)
  (latch i64)
  (preheader i64)
  (body-labels OptLabelSet)
  (body-blocks ir.CompilerIrBlockList)
  (iphi i64)
  (seed ir.CompilerIrValue)
  (bound ir.CompilerIrValue)
  ;; The counter's literal step (for the guard's no-wrap condition), NEGATIVE
  ;; for a descending counter -- which is also what makes `seed` the range's
  ;; top and `bound` its bottom. opt-bce-mb-counter-range is the one reader
  ;; that interprets the sign.
  (step i64)
  ;; Loop blocks the counter compare does NOT dominate, so no trip-range
  ;; derivation covers their checks (see the entry guard chain below). Empty
  ;; for the do-while form, whose latch compare covers the whole body.
  (uncovered OptLabelSet)
  ;; Blocks of the natural loops nested INSIDE this candidate. Empty for a
  ;; flat loop. A check removed from one of these runs per INNER iteration,
  ;; which is what pays for a REGION-sized clone (see the region budget).
  (inner OptLabelSet)
  ;; This candidate was admitted on the REGION budget -- an outermost nest
  ;; bigger than an ordinary nest may be -- so the derivation must show an
  ;; inner-loop check among the ones it removes before the clone is emitted.
  (region? bool))

(defenum OptBceMbMaybeShape
  (No)
  (Some OptBceMbShape))

;; Growth budget for the clone, measured the way the clone actually grows:
;; in INSTRUCTIONS. Block count is the wrong metric here. A `when (and a b c)`
;; body lowers to a fan of one-armed forwarders and merges -- `mov false` +
;; `jump`, or a bare `jump` -- so a counting loop whose real work is ~30
;; instructions can span thirteen blocks. Under a block cap those loops were
;; rejected while the single-block pass happily versions a 48-instruction
;; body, which is backwards: the and-chain loop clones LESS code. The cap
;; counts every non-phi instruction across the loop's blocks (terminators
;; included -- an empty forwarder still costs its jump) and phis are excluded
;; for the same reason the single-block pass's `opt-bce-version-body-max`
;; excludes them: a phi is register-transfer bookkeeping the backend
;; coalesces, not per-iteration work the clone duplicates.
(define (opt-bce-mb-instr-max) : i64
  96)

;; Safety bound on the loop's block count. NOT the growth metric (the
;; instruction budget above is): this only keeps the per-loop bookkeeping --
;; label sets, remap maps, the repeated whole-loop def scans, the exit-wiring
;; walks -- inside the sizes those structures are tuned for.
(define (opt-bce-mb-block-max) : i64
  24)

;; A loop NEST (the candidate body contains another loop's header) clones the
;; same way -- the inner loop is just more blocks in the group -- but its
;; economics differ: the removed checks are at most one per OUTER iteration
;; while the duplicated region contains a whole inner loop whose trip count is
;; unbounded. Both budgets below already measure the whole nest (`body-blocks`
;; is every block of the natural loop, nested ones included); these are the
;; same gate with the tighter constant a nest gets, so a big nest is refused
;; on SIZE, never on shape.
(define (opt-bce-mb-nest-instr-max) : i64
  64)

(define (opt-bce-mb-nest-block-max) : i64
  16)

;; A REGION is a nest whose preheader lies outside every loop of the function:
;; its guard runs once per CALL, not once per enclosing iteration, so the
;; guard's cost is amortized over the whole nest however many times the nest's
;; own loops spin. That is the one shape where duplicating a big nest can pay,
;; and only when the derivation actually removes a check from an INNER loop
;; (`opt-bce-mb-derived-in-inner?`) -- an outer-body-only removal is the
;; one-per-outer-iteration economics the ordinary nest budget is sized for.
;; Both conditions are required; either alone falls back to the nest budget.
(define (opt-bce-mb-region-instr-max) : i64
  128)

(define (opt-bce-mb-region-block-max) : i64
  32)

;; DERIVED CHECKS a call-carrying clone must remove, per duplicated call site.
;;
;; The instruction budgets above are the clone's whole price for a call-FREE
;; body, and they are the right price there: the clone is an alternative path,
;; so nothing it holds is ever executed in addition to the original -- the cost
;; is code, and instructions are what code is measured in. A CALL breaks that
;; equivalence in exactly the way #6307's retirement measured for the inliner's
;; static bands: an instruction count cannot see that a call site makes every
;; value live across it the register allocator's problem, and duplicating the
;; site duplicates that pressure inside one function, where the allocator prices
;; the union. The bands keep their call-free clauses for that reason; this pass
;; cannot -- refusing calls outright is what kept whole measured regions
;; unversioned -- so it charges for them instead.
;;
;; The charge is stated in the only currency the versioner earns: DERIVED
;; CHECKS, the checks the guard proves and the clone therefore drops. A
;; call-free body needs one (cloning to remove nothing is pure loss, which is
;; the `derived = 0` rejection this generalizes). A call-carrying body needs
;; this many per call site, so a shape pays for its duplicated pressure with
;; removals that repay every iteration rather than with a promise.
;;
;; THREE, and the corpus pins it from both sides rather than taste doing so.
;;
;; Above: it is strictly more than the incidental loop that happens to hold a
;; call and derives one or two checks. Those are the shapes the retired
;; call-free clause was accidentally right about -- a clone bought with two
;; removals, paying a call boundary's worth of duplicated pressure for them --
;; and three keeps every one of them out.
;;
;; Below: three is the LARGEST value that still admits the measured region this
;; whole capability exists for, cfg_domloops' `cfg-natural-loops` -- a
;; region-sized descending nest holding two direct calls (its loop-body and
;; loop-preheader walkers) and deriving six checks, one of them inside the inner
;; loop where its removal repeats per inner iteration. Six over two calls is
;; exactly three.
;;
;; And it separates: the same benchmark's nearest neighbour is an ascending
;; two-call scan deriving FOUR, two per call, which stays refused. So the
;; constant is not a threshold that happens to let everything through -- one
;; measured shape of this class passes it and the adjacent one does not.
;;
;; Read as a ratio it says a duplicated call must be bought by three checks that
;; are removed from every iteration, against a call boundary the inliner prices
;; at 6 + one move per parameter (opt-inline-checked-boundary-cost) -- paid once
;; in code, where the removals repay per trip.
(define (opt-bce-mb-call-clone-checks-per-call) : i64
  3)

;; The derived-check floor for a body holding `calls` duplicated call sites.
;; `calls = 0` gives the pass's original floor of one.
(define (opt-bce-mb-call-clone-min-derived [calls : i64]) : i64
  (if (< calls 1)
    1
    (* calls (opt-bce-mb-call-clone-checks-per-call))))

;; The one call form this pass's fast clone duplicates: a DIRECT `Call`.
;;
;; The clone re-emits the instruction verbatim with its dst rebased and its
;; arguments substituted, which is well defined only when the callee is named
;; by a symbol and the argument list is an ordinary value list. The indirect
;; forms (`CallIndirect`, `CallIndirectC`) carry a computed callee, the two
;; C-ABI store-result forms and `SpmdCall` carry boxed payloads with their own
;; result and span shapes, and `Syscall` is a raw ABI escape -- all stay out.
;; `TailCall` cannot appear in a clonable block at all: the block rule below
;; admits only Jump/Branch/Switch or a fallthrough as the last instruction, and
;; a tail call is neither.
(define (opt-bce-mb-direct-call? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [_ false]))

;; The var this instruction defines FOR THIS PASS, or `fallback`.
;;
;; `ir.compiler-ir-instr-loop-dst-or` is shared with the unroller, whose body
;; whitelist has no call in it, and it deliberately answers `fallback` for the
;; whole call family. The multiblock clone does duplicate a direct call
;; (opt-bce-mb-body-instr-ok?), so every def-keyed structure of this pass has to
;; see that call's dst. Without it the clone would re-define the ORIGINAL var:
;; the fresh-id pass would skip the dst (an SSA violation), the loop-def set
;; would report the result loop-INVARIANT to opt-bce-mb-invariant-operand and to
;; opt-bce-fold-invariant-operand (unsound -- a per-iteration value would be
;; treated as a guard-provable constant), and the escape / exit-wiring scans
;; would miss an outside use of it (the fast clone's remapped def would never
;; reach that use). The shared accessor keeps its meaning for the unroller;
;; every call site of it INSIDE this pass goes through here instead.
;;
;; A `Call` always carries a freshly allocated dst, even where the callee
;; returns Unit (see lower-oob-abort, which allocates one for a trap helper), so
;; rebasing it is always well-formed and never aliases another def.
(define (opt-bce-mb-instr-dst-or [instr : ir.CompilerIrInstr] [fallback : i64]) : i64
  (match instr
    [(ir.CompilerIrInstr.Call dst _ _ _) dst]
    [_ (ir.compiler-ir-instr-loop-dst-or instr fallback)]))

(define (opt-bce-mb-instr-seq-dst-or
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [fallback : i64]) : i64
  (opt-bce-mb-instr-dst-or (ir.compiler-ir-instr-seq-ref instrs index) fallback))

;; The (SSA single-def) instruction defining var anywhere in the loop.
(define (opt-bce-mb-find-def-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptBceMbMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptBceMbMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (= (opt-bce-mb-instr-dst-or instr (- 0 1)) var)
        (OptBceMbMaybeInstr.Some instr)
        (opt-bce-mb-find-def-instrs instrs (+ index 1) var)))))

(define (opt-bce-mb-find-def [blocks : ir.CompilerIrBlockList] [var : i64]) : OptBceMbMaybeInstr
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBceMbMaybeInstr.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-bce-mb-find-def-instrs instrs 0 var)
            [(OptBceMbMaybeInstr.Some instr) (OptBceMbMaybeInstr.Some instr)]
            [(OptBceMbMaybeInstr.No)
              (opt-bce-mb-find-def (__tl-box-place rest) var)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-def (ir.compiler-ir-block-seq-to-list seq) var)]))

;; Resolve through Mov copies and 64-bit int reinterpret casts anywhere in
;; the loop (the multi-block analogue of `opt-bce-version-resolve`).
(define (opt-bce-mb-resolve
  [blocks : ir.CompilerIrBlockList]
  [var : i64]
  [fuel : i64]) : i64
  (if (<= fuel 0)
    var
    (match (opt-bce-mb-find-def blocks var)
      [(OptBceMbMaybeInstr.No) var]
      [(OptBceMbMaybeInstr.Some instr)
        (match instr
          [(ir.CompilerIrInstr.Mov _ src _)
            (match src
              [(ir.CompilerIrValue.Var src-id)
                (opt-bce-mb-resolve blocks src-id (- fuel 1))]
              [_ var])]
          [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
            (if (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
              (match src
                [(ir.CompilerIrValue.Var src-id)
                  (opt-bce-mb-resolve blocks src-id (- fuel 1))]
                [_ var])
              var)]
          [_ var])])))

;; Multi-block counterpart of `opt-bce-version-counter-affine`.
(define (opt-bce-mb-counter-affine
  [body-blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : OptBceCounterAffine
  (match value
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (if (= id iphi)
          (OptBceCounterAffine.Some 1 0)
          (if (<= fuel 0)
            (OptBceCounterAffine.No)
            (match (opt-bce-mb-find-def body-blocks id)
              [(OptBceMbMaybeInstr.No) (OptBceCounterAffine.No)]
              [(OptBceMbMaybeInstr.Some instr)
                (match instr
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                    (if (opt-affine-64bit-type? ty)
                      (match op
                        [(ir.CompilerIrBinOp.Add)
                          (match (opt-affine-var-const lhs rhs)
                            [(OptAffineOperands.Some src k)
                              (opt-bce-counter-affine-add
                                (opt-bce-mb-counter-affine
                                  body-blocks
                                  iphi
                                  (ir.CompilerIrValue.Var src)
                                  (- fuel 1))
                                k)]
                            [(OptAffineOperands.No) (OptBceCounterAffine.No)])]
                        [(ir.CompilerIrBinOp.Sub)
                          (match lhs
                            [(ir.CompilerIrValue.Var src)
                              (match rhs
                                [(ir.CompilerIrValue.I64 k)
                                  (if (= k (- (- 0 9223372036854775807) 1))
                                    (OptBceCounterAffine.No)
                                    (opt-bce-counter-affine-add
                                      (opt-bce-mb-counter-affine
                                        body-blocks
                                        iphi
                                        (ir.CompilerIrValue.Var src)
                                        (- fuel 1))
                                      (- 0 k)))]
                                [_ (OptBceCounterAffine.No)])]
                            [_ (OptBceCounterAffine.No)])]
                        [(ir.CompilerIrBinOp.Mul)
                          (match (opt-affine-var-const lhs rhs)
                            [(OptAffineOperands.Some src k)
                              (opt-bce-counter-affine-mul
                                (opt-bce-mb-counter-affine
                                  body-blocks
                                  iphi
                                  (ir.CompilerIrValue.Var src)
                                  (- fuel 1))
                                k)]
                            [(OptAffineOperands.No) (OptBceCounterAffine.No)])]
                        [_ (OptBceCounterAffine.No)])
                      (OptBceCounterAffine.No))]
                  [_ (OptBceCounterAffine.No)])]))))]
    [_ (OptBceCounterAffine.No)]))

;; The unroller's `opt-unroll-block-defs` on this pass's def accessor: a direct
;; call's result is a loop def like any other, and everything asking "does the
;; loop define this?" -- invariance above all -- has to be told so.
(define (opt-bce-mb-block-defs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [acc : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index count)
    acc
    (let
      [dst : i64 (opt-bce-mb-instr-seq-dst-or instrs index (- 0 1))]
      (opt-bce-mb-block-defs
        instrs
        (+ index 1)
        count
        (if (< dst 0)
          acc
          (opt-used-add acc dst))))))

(define (opt-bce-mb-collect-defs
  [blocks : ir.CompilerIrBlockList]
  [acc : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-collect-defs
        (__tl-box-place rest)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-bce-mb-block-defs
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs)
              acc)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-collect-defs (ir.compiler-ir-block-seq-to-list seq) acc)]))

;; --- shape scan ---------------------------------------------------------------
;; The latch must end `Branch c header exit` with the exit outside the loop.
(define (opt-bce-mb-latch-branch
  [block : ir.CompilerIrBlock]
  [header : i64]
  [body-labels : OptLabelSet]) : OptBceMbMaybeLatch
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 1)
          (OptBceMbMaybeLatch.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch cond then-label else-label)
              (match cond
                [(ir.CompilerIrValue.Var cond-var)
                  (if (and
                    (= then-label header)
                    (not (opt-label-contains body-labels else-label)))
                    (OptBceMbMaybeLatch.Some cond-var else-label)
                    (OptBceMbMaybeLatch.No))]
                [_ (OptBceMbMaybeLatch.No)])]
            [_ (OptBceMbMaybeLatch.No)])))]))

;; --- top-tested loops: the ENTRY GUARD CHAIN ----------------------------------
;;
;; Top-tested alternative to the do-while latch branch: the latch ends
;; `Jump header` and the counter compare `iphi < bound` ends an EXITING branch
;; somewhere on the loop's entry path. The compare used to be required at the
;; header itself, which refused every loop whose entry test short-circuits
;; through more than one branch -- `(while (if done false (< i n)) ...)` (and
;; every `and`-guarded condition whose counter compare is not the FIRST
;; conjunct) lowers to a header that branches on the flag and a second block
;; that branches on the counter, so the counter compare is one block down and
;; the header's own branch is a second exiting branch. Nothing about that shape
;; is unsound: an early exit only shortens the trip.
;;
;; So the scan walks the chain instead. Starting at the header it follows the
;; block's single IN-LOOP successor -- a `Jump` inside the loop, or a `Branch`
;; with exactly one target in the loop (the other leaves it) -- and stops at
;; the first such branch whose condition recovers the counter with its
;; CONTINUING edge as the true arm. `Branch`es with both targets inside the
;; loop end the walk: a real diamond gives the header two ways into the body
;; and the argument below needs one.
;;
;; WHAT THE COMPARE COVERS. Let C be the compare block and A its in-loop
;; successor. Every chain block has exactly one in-loop successor, the next
;; chain block, and every edge from outside a natural loop enters at its header
;; (an outside block with an edge to an inner loop block would itself reach the
;; latch without the header, i.e. be a loop block). So any path from the header
;; into a loop block D OUTSIDE the chain runs header -> ... -> C -> A -> ... ->
;; D: C strictly dominates D, and since `iphi` is a header phi and holds one
;; value per iteration, `iphi < bound` holds at D in the SAME iteration. The
;; [seed, bound) trip-range argument -- which is all the derivations use -- is
;; therefore sound for every check outside the chain.
;;
;; It is NOT sound for a check IN the chain, the header's included: those
;; blocks run one more time than the body does, with `iphi` at the first value
;; that fails the compare. Their checks stay in the fast clone (see the shape's
;; `uncovered` set, which the derivation turns into unconditional `keep`
;; entries) exactly like an underivable index, so the clone keeps their abort
;; sites. Whether the chain is the header alone (the shape this pass always
;; accepted) or a flag test plus a compare makes no difference to that rule.
(defenum OptBceMbMaybeChain
  (No)
  ;; the recovered counter, and the chain labels (header through the compare
  ;; block) whose own checks the compare does not cover
  (Some OptBceMbMaybeCounter OptLabelSet))

;; One step of the walk. `chain` is the guard blocks visited so far; revisiting
;; one (a cycle among single-successor guards) refuses, which keeps the chain
;; simple and the dominance argument above literal.
(define (opt-bce-mb-chain-walk
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [body-labels : OptLabelSet]
  [latch : i64]
  [preheader : i64]
  [label : i64]
  [fuel : i64]
  [chain : OptLabelSet]) : OptBceMbMaybeChain
  (if (or (<= fuel 0) (opt-label-contains chain label))
    (OptBceMbMaybeChain.No)
    (match (opt-cfg-find-block blocks label)
      [(OptMaybeBlock.No) (OptBceMbMaybeChain.No)]
      [(OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
              [next-chain : OptLabelSet (opt-label-add chain label)]
              (if (< count 1)
                (OptBceMbMaybeChain.No)
                (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                  [(ir.CompilerIrInstr.Jump target)
                    (if (opt-label-contains body-labels target)
                      (opt-bce-mb-chain-walk
                        blocks
                        body-blocks
                        defs
                        body-labels
                        latch
                        preheader
                        target
                        (- fuel 1)
                        next-chain)
                      (OptBceMbMaybeChain.No))]
                  [(ir.CompilerIrInstr.Branch cond then-label else-label)
                    (opt-bce-mb-chain-branch
                      blocks
                      body-blocks
                      defs
                      body-labels
                      latch
                      preheader
                      cond
                      then-label
                      else-label
                      (- fuel 1)
                      next-chain)]
                  [_ (OptBceMbMaybeChain.No)])))])])))

;; The branch step: take this block as the compare when exactly its TRUE arm
;; continues the loop and the condition recovers the counter; otherwise keep
;; walking whichever single arm stays inside.
(define (opt-bce-mb-chain-branch
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [body-labels : OptLabelSet]
  [latch : i64]
  [preheader : i64]
  [cond : ir.CompilerIrValue]
  [then-label : i64]
  [else-label : i64]
  [fuel : i64]
  [chain : OptLabelSet]) : OptBceMbMaybeChain
  (let
    [then-in? : bool (opt-label-contains body-labels then-label)]
    [else-in? : bool (opt-label-contains body-labels else-label)]
    (cond
      [(and then-in? (not else-in?))
        (match cond
          [(ir.CompilerIrValue.Var cond-var)
            (match (opt-bce-mb-counter-top
              body-blocks
              defs
              latch
              preheader
              cond-var)
              [(OptBceMbMaybeCounter.Some iphi seed inext bound step)
                ;; the compare's continuing successor must lead OUT of the
                ;; chain, or it does not start the covered region
                (if (opt-label-contains chain then-label)
                  (OptBceMbMaybeChain.No)
                  (OptBceMbMaybeChain.Some
                    (OptBceMbMaybeCounter.Some iphi seed inext bound step)
                    chain))]
              [(OptBceMbMaybeCounter.No)
                (opt-bce-mb-chain-walk
                  blocks
                  body-blocks
                  defs
                  body-labels
                  latch
                  preheader
                  then-label
                  fuel
                  chain)])]
          [_
            (opt-bce-mb-chain-walk
              blocks
              body-blocks
              defs
              body-labels
              latch
              preheader
              then-label
              fuel
              chain)])]
      ;; an exiting branch whose FALSE arm continues cannot be the `iphi <
      ;; bound` test (the recovery reads the true arm as the continuing one),
      ;; so it is just another guard on the way in
      [(and else-in? (not then-in?))
        (opt-bce-mb-chain-walk
          blocks
          body-blocks
          defs
          body-labels
          latch
          preheader
          else-label
          fuel
          chain)]
      [else (OptBceMbMaybeChain.No)])))

;; The latch of the top-tested family closes the back edge and nothing else:
;; `Jump header`, or a `Branch` whose only in-loop target is the header (a
;; bottom-tested SECOND exit, which -- like every other early exit -- only
;; shortens the trip and leaves the counter compare's coverage argument
;; untouched).
(define (opt-bce-mb-top-test-latch-ok?
  [latch-block : ir.CompilerIrBlock]
  [header : i64]
  [body-labels : OptLabelSet]) : bool
  (match latch-block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 1)
          false
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Jump target) (= target header)]
            [(ir.CompilerIrInstr.Branch _ then-label else-label)
              (or
                (and
                  (= then-label header)
                  (not (opt-label-contains body-labels else-label)))
                (and
                  (= else-label header)
                  (not (opt-label-contains body-labels then-label))))]
            [_ false])))]))

;; Top-tested entry: the latch closes the back edge, then the chain walk above
;; recovers the counter and the blocks its compare does not cover.
(define (opt-bce-mb-top-test-chain
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch-block : ir.CompilerIrBlock]
  [header : i64]
  [latch : i64]
  [preheader : i64]
  [body-labels : OptLabelSet]) : OptBceMbMaybeChain
  (if (not (opt-bce-mb-top-test-latch-ok? latch-block header body-labels))
    (OptBceMbMaybeChain.No)
    (opt-bce-mb-chain-walk
      blocks
      body-blocks
      defs
      body-labels
      latch
      preheader
      header
      (opt-label-count body-labels)
      (OptLabelSet.Nil))))

;; The counter phi: a header phi (only header phis carry latch-edge inputs)
;; of type i64 fed (seed from the preheader, inext from the latch).
(define (opt-bce-mb-counter-phi
  [body-blocks : ir.CompilerIrBlockList]
  [latch : i64]
  [preheader : i64]
  [inext : i64]
  [iphi : i64]) : OptBceMbMaybeSeed
  (match (opt-bce-mb-find-def body-blocks iphi)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeSeed.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.Phi _ inputs pty)
          (match pty
            [(ast.AstType.I64)
              (match (opt-unroll-split-phi-inputs inputs latch)
                [(OptUnrollPhiSplit.Split seed back pred-label)
                  (if (and
                    (= pred-label preheader)
                    (match back
                      [(ir.CompilerIrValue.Var back-id)
                        (= (opt-bce-mb-resolve body-blocks back-id 16) inext)]
                      [_ false]))
                    (OptBceMbMaybeSeed.Some seed)
                    (OptBceMbMaybeSeed.No))]
                [(OptUnrollPhiSplit.No) (OptBceMbMaybeSeed.No)])]
            [_ (OptBceMbMaybeSeed.No)])]
        [_ (OptBceMbMaybeSeed.No)])]))

;; The literal step of the instruction defining `inext`, or 0 for a shape that
;; is not a counter increment at all. Any literal step of either sign: the
;; derivations reason about the SET of executed-trip counter values, which a
;; descending counter has just as much as an ascending one, and the shared
;; guard finisher adds the no-wrap condition where the magnitude needs it.
;; I64 only, because the guard reasons in SIGNED 64-bit arithmetic.
;;
;; A decrement reaches this in either spelling -- `Sub iphi, k` as written, or
;; a folded `Add iphi, -k` -- so both are recovered. `Sub` by i64 MIN is
;; refused: its negation is not representable.
(define (opt-bce-mb-counter-literal-step
  [op : ir.CompilerIrBinOp]
  [rhs : ir.CompilerIrValue]
  [ity : ast.AstType]) : i64
  (match ity
    [(ast.AstType.I64)
      (match rhs
        [(ir.CompilerIrValue.I64 k)
          (match op
            [(ir.CompilerIrBinOp.Add) k]
            [(ir.CompilerIrBinOp.Sub)
              (if (= k (- (- 0 9223372036854775807) 1))
                0
                (- 0 k))]
            [_ 0])]
        [_ 0])]
    [_ 0]))

(define (opt-bce-mb-counter-step-inext
  [body-blocks : ir.CompilerIrBlockList]
  [latch : i64]
  [preheader : i64]
  [inext : i64]
  [bound : ir.CompilerIrValue]
  [descending? : bool]) : OptBceMbMaybeCounter
  (match (opt-bce-mb-find-def body-blocks inext)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
          (match add-lhs
            [(ir.CompilerIrValue.Var add-src)
              (let
                [step : i64
                  (opt-bce-mb-counter-literal-step add-op add-rhs ity)]
                ;; The step's sign must be the one the latch compare's
                ;; direction assumes: a counter walking AWAY from the limit it
                ;; is tested against has no bounded trip range at all.
                (if (if descending?
                  (< step 0)
                  (> step 0))
                  (let
                    [iphi : i64 (opt-bce-mb-resolve body-blocks add-src 16)]
                    (match (opt-bce-mb-counter-phi
                      body-blocks
                      latch
                      preheader
                      inext
                      iphi)
                      [(OptBceMbMaybeSeed.No) (OptBceMbMaybeCounter.No)]
                      [(OptBceMbMaybeSeed.Some seed)
                        (OptBceMbMaybeCounter.Some iphi seed inext bound step)]))
                  (OptBceMbMaybeCounter.No)))]
            [_ (OptBceMbMaybeCounter.No)])]
        [_ (OptBceMbMaybeCounter.No)])]))

;; Which way does this latch compare let the counter walk?
;;
;; `Lt` is the ascending do-while test the pass has always taken: `bound` is
;; the EXCLUSIVE top of the counter's range. `Ge` is its descending mirror:
;; `bound` is the INCLUSIVE bottom, the value the last executed trip may still
;; hold. Both put the counter's whole executed range in one closed interval,
;; which is all opt-bce-mb-counter-range needs.
;;
;; The two remaining orders are deliberately absent, for the same reason on
;; each side: they move the limit by one, and that one has to be MATERIALIZED
;; before any condition can name it. `Le` (inclusive top) has never been
;; admitted ascending; `Gt` (exclusive bottom) is its descending twin and is
;; refused here. Either would need the guard to compute a shifted limit and to
;; carry the wrap argument for it -- a separate question from the counter's
;; direction, and one no measured loop has asked for.
(defenum OptBceMbCounterDirection
  (No)
  (Ascending)
  (Descending))

(define (opt-bce-mb-counter-direction [op : ir.CompilerIrBinOp]) : OptBceMbCounterDirection
  (match op
    [(ir.CompilerIrBinOp.Lt) (OptBceMbCounterDirection.Ascending)]
    [(ir.CompilerIrBinOp.Ge) (OptBceMbCounterDirection.Descending)]
    [_ (OptBceMbCounterDirection.No)]))

(define (opt-bce-mb-counter-step-compare
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [cmp-lhs : ir.CompilerIrValue]
  [cmp-rhs : ir.CompilerIrValue]
  [descending? : bool]) : OptBceMbMaybeCounter
  (match cmp-lhs
    [(ir.CompilerIrValue.Var cmp-src)
      (if (opt-unroll-invariant-bound? defs cmp-rhs)
        (opt-bce-mb-counter-step-inext
          body-blocks
          latch
          preheader
          (opt-bce-mb-resolve body-blocks cmp-src 16)
          cmp-rhs
          descending?)
        (OptBceMbMaybeCounter.No))]
    [_ (OptBceMbMaybeCounter.No)]))

;; The latch compare `c = inext < bound` with `inext = iphi + step` (i64, any
;; positive literal step) and an invariant bound -- or its descending mirror
;; `c = inext >= bound` with a negative literal step.
(define (opt-bce-mb-counter-step
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [cond-var : i64]) : OptBceMbMaybeCounter
  (match (opt-bce-mb-find-def body-blocks cond-var)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match (opt-bce-mb-counter-direction cmp-op)
            [(OptBceMbCounterDirection.No) (OptBceMbMaybeCounter.No)]
            [(OptBceMbCounterDirection.Ascending)
              (opt-bce-mb-counter-step-compare
                body-blocks
                defs
                latch
                preheader
                cmp-lhs
                cmp-rhs
                false)]
            [(OptBceMbCounterDirection.Descending)
              (opt-bce-mb-counter-step-compare
                body-blocks
                defs
                latch
                preheader
                cmp-lhs
                cmp-rhs
                true)])]
        [_ (OptBceMbMaybeCounter.No)])]))

;; The top-tested counter's step: the phi's latch back-edge value resolves to
;; `iphi + step` (i64, any positive literal step).
(define (opt-bce-mb-counter-top-step
  [body-blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [back-raw : i64]
  [bound : ir.CompilerIrValue]) : OptBceMbMaybeCounter
  (let
    [inext : i64 (opt-bce-mb-resolve body-blocks back-raw 16)]
    (match (opt-bce-mb-find-def body-blocks inext)
      [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
      [(OptBceMbMaybeInstr.Some instr)
        (match instr
          [(ir.CompilerIrInstr.BinOp _ add-op add-lhs add-rhs ity)
            (match add-op
              [(ir.CompilerIrBinOp.Add)
                (match add-lhs
                  [(ir.CompilerIrValue.Var add-src)
                    (match add-rhs
                      [(ir.CompilerIrValue.I64 step)
                        (if (and
                          (> step 0)
                          (match ity
                            [(ast.AstType.I64) true]
                            [_ false])
                          (= (opt-bce-mb-resolve body-blocks add-src 16) iphi))
                          (OptBceMbMaybeCounter.Some iphi seed inext bound step)
                          (OptBceMbMaybeCounter.No))]
                      [_ (OptBceMbMaybeCounter.No)])]
                  [_ (OptBceMbMaybeCounter.No)])]
              [_ (OptBceMbMaybeCounter.No)])]
          [_ (OptBceMbMaybeCounter.No)])])))

;; The top-tested counter phi: an i64 header phi fed (seed from the
;; preheader, positive literal step from the latch).
(define (opt-bce-mb-counter-top-phi
  [body-blocks : ir.CompilerIrBlockList]
  [latch : i64]
  [preheader : i64]
  [cmp-src : i64]
  [bound : ir.CompilerIrValue]) : OptBceMbMaybeCounter
  (let
    [iphi : i64 (opt-bce-mb-resolve body-blocks cmp-src 16)]
    (match (opt-bce-mb-find-def body-blocks iphi)
      [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
      [(OptBceMbMaybeInstr.Some instr)
        (match instr
          [(ir.CompilerIrInstr.Phi _ inputs pty)
            (match pty
              [(ast.AstType.I64)
                (match (opt-unroll-split-phi-inputs inputs latch)
                  [(OptUnrollPhiSplit.Split seed back pred-label)
                    (if (not (= pred-label preheader))
                      (OptBceMbMaybeCounter.No)
                      (match back
                        [(ir.CompilerIrValue.Var back-raw)
                          (opt-bce-mb-counter-top-step
                            body-blocks
                            iphi
                            seed
                            back-raw
                            bound)]
                        [_ (OptBceMbMaybeCounter.No)]))]
                  [(OptUnrollPhiSplit.No) (OptBceMbMaybeCounter.No)])]
              [_ (OptBceMbMaybeCounter.No)])]
          [_ (OptBceMbMaybeCounter.No)])])))

;; The header compare `c = iphi < bound` of a top-tested loop: the counter phi
;; itself against an invariant bound.
(define (opt-bce-mb-counter-top
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [cond-var : i64]) : OptBceMbMaybeCounter
  (match (opt-bce-mb-find-def body-blocks cond-var)
    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeCounter.No)]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.BinOp _ cmp-op cmp-lhs cmp-rhs _)
          (match cmp-op
            [(ir.CompilerIrBinOp.Lt)
              (match cmp-lhs
                [(ir.CompilerIrValue.Var cmp-src)
                  (if (opt-unroll-invariant-bound? defs cmp-rhs)
                    (opt-bce-mb-counter-top-phi
                      body-blocks
                      latch
                      preheader
                      cmp-src
                      cmp-rhs)
                    (OptBceMbMaybeCounter.No))]
                [_ (OptBceMbMaybeCounter.No)])]
            [_ (OptBceMbMaybeCounter.No)])]
        [_ (OptBceMbMaybeCounter.No)])]))

;; Every header phi must split as (preheader, latch): the header then has
;; exactly the two expected predecessors.
(define (opt-bce-mb-header-phis-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [latch : i64]
  [preheader : i64]) : bool
  (if (>= index phi-count)
    true
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (match (opt-unroll-split-phi-inputs inputs latch)
          [(OptUnrollPhiSplit.Split _ _ pred-label)
            (if (= pred-label preheader)
              (opt-bce-mb-header-phis-ok?
                instrs
                (+ index 1)
                phi-count
                latch
                preheader)
              false)]
          [(OptUnrollPhiSplit.No) false])]
      [_ false])))

;; The MULTIBLOCK clone's body whitelist: everything the single-block versioner
;; clones, plus a direct call.
;;
;; The single-block pass keeps its own list untouched. It clones ONE block whose
;; whole point is a straight-line arithmetic kernel, and admitting a call there
;; would buy nothing the multiblock scan does not already reach.
;;
;; Nothing about a call is special to the CLONE itself -- it is copied with its
;; dst rebased and its arguments substituted like every other instruction, and
;; the fast clone is an ALTERNATIVE path, so no executed call is added to any
;; run. What a call is special for is PRICING, which
;; opt-bce-mb-call-clone-min-derived states, and DESCRIPTOR INVARIANCE, which
;; opt-bce-mb-stable-instr? states. Both are downstream of this predicate.
(define (opt-bce-mb-body-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (or (opt-bce-version-body-instr-ok? instr) (opt-bce-mb-direct-call? instr)))

(define (opt-bce-mb-body-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : bool
  (if (>= index last)
    true
    (and
      (opt-bce-mb-body-instr-ok? (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-bce-mb-body-ok? instrs (+ index 1) last))))

;; One loop block's BoundsCheck count, or -1 when the block is not clonable:
;; phis only as a prefix, whitelist body instructions, and either a
;; Jump/Branch/Switch terminator or a plain fallthrough (the fallthrough TARGET is
;; validated separately against the block list).
(define (opt-bce-mb-block-checks [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
        (if (not (opt-unroll-no-phi-from? instrs phi-count))
          (- 0 1)
          (if (opt-cfg-instr-seq-can-fallthrough? instrs)
            (if (and
              (<= (- count phi-count) (opt-bce-version-body-max))
              (opt-bce-mb-body-ok? instrs phi-count count))
              (opt-bce-version-check-count instrs phi-count count 0)
              (- 0 1))
            (let
              [last : i64 (- count 1)]
              (if (and
                (<= (- last phi-count) (opt-bce-version-body-max))
                (match (ir.compiler-ir-instr-seq-ref instrs last)
                  [(ir.CompilerIrInstr.Jump _) true]
                  [(ir.CompilerIrInstr.Branch _ _ _) true]
                  [(ir.CompilerIrInstr.Switch _ _ _ _) true]
                  [_ false])
                (opt-bce-mb-body-ok? instrs phi-count last))
                (opt-bce-version-check-count instrs phi-count last 0)
                (- 0 1))))))]))

;; Direct call sites across the loop: what the fast clone duplicates and what
;; opt-bce-mb-call-clone-min-derived prices. Only the blocks the shape scan
;; already admitted reach this, so every call it counts is a direct one.
(define (opt-bce-mb-block-calls
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-bce-mb-block-calls
      instrs
      (+ index 1)
      (if (opt-bce-mb-direct-call? (ir.compiler-ir-instr-seq-ref instrs index))
        (+ acc 1)
        acc))))

(define (opt-bce-mb-body-calls [blocks : ir.CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-body-calls
            (__tl-box-place rest)
            (opt-bce-mb-block-calls instrs 0 acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-body-calls (ir.compiler-ir-block-seq-to-list seq) acc)]))

;; Total BoundsCheck count across the loop, or -1 when any block is not
;; clonable (the caller treats < 1 as a rejection).
(define (opt-bce-mb-body-checks [blocks : ir.CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [checks : i64 (opt-bce-mb-block-checks block)]
        (if (< checks 0)
          (- 0 1)
          (opt-bce-mb-body-checks (__tl-box-place rest) (+ acc checks))))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-body-checks (ir.compiler-ir-block-seq-to-list seq) acc)]))

;; Non-phi instructions across the loop: exactly what the fast clone
;; duplicates, and the quantity (opt-bce-mb-instr-max) budgets. Cheap enough
;; to run ahead of the string-building admission checks, so it doubles as an
;; early rejection for the loops that would never fit.
(define (opt-bce-mb-body-instrs [blocks : ir.CompilerIrBlockList] [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-body-instrs
            (__tl-box-place rest)
            (+
              acc
              (-
                (ir.compiler-ir-instr-seq-count instrs)
                (opt-unroll-phi-prefix-count instrs 0))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-body-instrs (ir.compiler-ir-block-seq-to-list seq) acc)]))

;; Exhaustive enum dispatches carry an explicit TotalEnumSwitch proof until the
;; dedicated late rewrite. Cloning one of these high-fanout
;; interpreter loops duplicates every arm, pushes the combined CFG over the
;; backend's compact allocation shape, and loses far more than BCE removes.
;; Ordinary Switch loops remain clonable (and are covered by the fixture).
(define (opt-bce-mb-body-has-total-enum-switch?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (or
              (and
                (> count 0)
                (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                  [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
                  [_ false]))
              (opt-bce-mb-body-has-total-enum-switch? (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-body-has-total-enum-switch?
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Fallthrough is positional: a loop block without a terminator may only
;; fall into another loop block (the fast clone group preserves loop order,
;; so intra-loop fallthroughs clone correctly).
(define (opt-bce-mb-fallthroughs-ok?
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (and
            (opt-label-contains body-labels label)
            (opt-cfg-instr-seq-can-fallthrough? instrs)
            (not
              (opt-label-contains
                body-labels
                (opt-cfg-entry-label (__tl-box-place rest)))))
            false
            (opt-bce-mb-fallthroughs-ok? (__tl-box-place rest) body-labels))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-fallthroughs-ok?
        (ir.compiler-ir-block-seq-to-list seq)
        body-labels)]))

;; Idempotence: no fast-clone label may already exist.
(define (opt-bce-mb-fast-labels-fresh?
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]) : bool
  (match body-labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref body-labels 0)]
        (if (opt-cfg-block-exists?
          blocks
          (ir.compiler-ir-label
            (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_fast")))
          false
          (opt-bce-mb-fast-labels-fresh? blocks (opt-label-tail body-labels))))]))

(define (opt-bce-mb-loop-shape-finish
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [latch : i64]
  [pred : i64]
  [body-labels : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]
  [inner : OptLabelSet]
  [region? : bool]
  [uncovered : OptLabelSet]
  [counter : OptBceMbMaybeCounter]) : OptBceMbMaybeShape
  (match counter
    [(OptBceMbMaybeCounter.No) (OptBceMbMaybeShape.No)]
    [(OptBceMbMaybeCounter.Some iphi seed _ bound step)
      (match (opt-cfg-find-block blocks header)
        [(OptMaybeBlock.No) (OptBceMbMaybeShape.No)]
        [(OptMaybeBlock.Some header-block)
          (match header-block
            [(ir.CompilerIrBlock.Block _ header-instrs)
              (if (and
                (opt-bce-mb-header-phis-ok?
                  header-instrs
                  0
                  (opt-unroll-phi-prefix-count header-instrs 0)
                  latch
                  pred)
                (>= (opt-bce-mb-body-checks body-blocks 0) 1))
                (OptBceMbMaybeShape.Some
                  (OptBceMbShape
                    header
                    latch
                    pred
                    body-labels
                    body-blocks
                    iphi
                    seed
                    bound
                    step
                    uncovered
                    inner
                    region?))
                (OptBceMbMaybeShape.No))])])]))

;; Does another natural loop's header sit inside this candidate's body? A
;; nest is admitted (the clone is just more blocks -- see the nest note on
;; `opt-bce-mb-nest-instr-max`), but the scan offers FLAT loops first and
;; nests only when none of them versioned, so an inner loop that can version
;; on its own always wins the slot: its checks run per INNER iteration, and
;; versioning it first is what kept array_sum's hot inner scan versioned
;; while the outer round loop stayed alone.
(define (opt-bce-mb-has-nested-loop?
  [loops : OptNaturalLoopList]
  [header : i64]
  [body-labels : OptLabelSet]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) false]
    [(OptNaturalLoopList.Cons loop rest)
      (match loop
        [(OptNaturalLoop.Loop other-header _ _ _)
          (if (and
            (not (= other-header header))
            (opt-label-contains body-labels other-header))
            true
            (opt-bce-mb-has-nested-loop?
              (__tl-box-place rest)
              header
              body-labels))])]))

;; The blocks of every natural loop nested inside this candidate.
(define (opt-bce-mb-inner-labels
  [loops : OptNaturalLoopList]
  [header : i64]
  [body-labels : OptLabelSet]
  [acc : OptLabelSet]) : OptLabelSet
  (match loops
    [(OptNaturalLoopList.Nil) acc]
    [(OptNaturalLoopList.Cons loop rest)
      (match loop
        [(OptNaturalLoop.Loop other-header _ other-body _)
          (opt-bce-mb-inner-labels
            (__tl-box-place rest)
            header
            body-labels
            (if (and
              (not (= other-header header))
              (opt-label-contains body-labels other-header))
              (opt-bce-mb-labels-union other-body.labels acc)
              acc))])]))

;; Is this candidate preheader outside every natural loop of the function?
;; Only then does its guard run once per CALL rather than once per enclosing
;; iteration, which is what makes the region budget bigger clone pay.
(define (opt-bce-mb-preheader-outside-loops?
  [loops : OptNaturalLoopList]
  [pred : i64]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) true]
    [(OptNaturalLoopList.Cons loop rest)
      (match loop
        [(OptNaturalLoop.Loop _ _ other-body _)
          (if (opt-label-contains other-body.labels pred)
            false
            (opt-bce-mb-preheader-outside-loops? (__tl-box-place rest) pred))])]))

(define (opt-bce-mb-loop-shape-with-preheader
  [blocks : ir.CompilerIrBlockList]
  [loops : OptNaturalLoopList]
  [nested? : bool]
  [header : i64]
  [latch : i64]
  [body : OptLoopBody]
  [pred : i64]) : OptBceMbMaybeShape
  (let
    [body-labels : OptLabelSet body.labels]
    [body-blocks : ir.CompilerIrBlockList body.blocks]
    [inner : OptLabelSet
      (if nested?
        (opt-bce-mb-inner-labels loops header body-labels (OptLabelSet.Nil))
        (OptLabelSet.Nil))]
    [region? : bool
      (and nested? (opt-bce-mb-preheader-outside-loops? loops pred))]
    [block-max : i64
      (if region?
        (opt-bce-mb-region-block-max)
        (if nested?
          (opt-bce-mb-nest-block-max)
          (opt-bce-mb-block-max)))]
    [instr-max : i64
      (if region?
        (opt-bce-mb-region-instr-max)
        (if nested?
          (opt-bce-mb-nest-instr-max)
          (opt-bce-mb-instr-max)))]
    (if (or
      (< (opt-label-count body-labels) 2)
      (> (opt-label-count body-labels) block-max)
      (> (opt-bce-mb-body-instrs body-blocks 0) instr-max)
      (opt-cfg-block-exists?
        blocks
        (ir.compiler-ir-label
          (str_cat.str-cat (ir.compiler-ir-label-text header) "__bce_guard")))
      (opt-bce-mb-body-has-total-enum-switch? body-blocks)
      (not (opt-bce-mb-fast-labels-fresh? blocks body-labels))
      (not (opt-bce-mb-fallthroughs-ok? blocks body-labels)))
      (OptBceMbMaybeShape.No)
      (match (opt-cfg-find-block blocks latch)
        [(OptMaybeBlock.No) (OptBceMbMaybeShape.No)]
        [(OptMaybeBlock.Some latch-block)
          (let
            [defs : opt_i64_i64_map.Map
              (opt-bce-mb-collect-defs
                body-blocks
                (opt_i64_i64_map.with-capacity 64))]
            (match (opt-bce-mb-latch-branch latch-block header body-labels)
              [(OptBceMbMaybeLatch.No)
                (opt-bce-mb-loop-shape-top
                  blocks
                  body-blocks
                  defs
                  latch-block
                  header
                  latch
                  pred
                  body-labels
                  inner
                  region?)]
              [(OptBceMbMaybeLatch.Some cond-var _)
                (match (opt-bce-mb-loop-shape-finish
                  blocks
                  header
                  latch
                  pred
                  body-labels
                  body-blocks
                  inner
                  region?
                  ;; the latch compare covers the whole body: it bounds the
                  ;; NEXT iteration's counter and the guard bounds the first
                  (OptLabelSet.Nil)
                  (opt-bce-mb-counter-step body-blocks defs latch pred cond-var))
                  [(OptBceMbMaybeShape.Some shape)
                    (OptBceMbMaybeShape.Some shape)]
                  ;; a latch branch that closes the back edge but does NOT
                  ;; carry the counter compare (a bottom-tested flag test) is
                  ;; still a top-tested loop for the chain walk
                  [(OptBceMbMaybeShape.No)
                    (opt-bce-mb-loop-shape-top
                      blocks
                      body-blocks
                      defs
                      latch-block
                      header
                      latch
                      pred
                      body-labels
                      inner
                      region?)])]))]))))

(define (opt-bce-mb-loop-shape-top
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch-block : ir.CompilerIrBlock]
  [header : i64]
  [latch : i64]
  [pred : i64]
  [body-labels : OptLabelSet]
  [inner : OptLabelSet]
  [region? : bool]) : OptBceMbMaybeShape
  (match (opt-bce-mb-top-test-chain
    blocks
    body-blocks
    defs
    latch-block
    header
    latch
    pred
    body-labels)
    [(OptBceMbMaybeChain.No) (OptBceMbMaybeShape.No)]
    [(OptBceMbMaybeChain.Some counter chain)
      (opt-bce-mb-loop-shape-finish
        blocks
        header
        latch
        pred
        body-labels
        body-blocks
        inner
        region?
        chain
        counter)]))

;; `nested?` selects the scan phase: false offers only loops whose body holds
;; no other loop header, true only the nests. Every loop belongs to exactly
;; one phase, and the driver runs the flat phase first (see
;; `opt-bce-mb-loops-scan-phased`).
(define (opt-bce-mb-loop-shape
  [blocks : ir.CompilerIrBlockList]
  [loops : OptNaturalLoopList]
  [entry-label : i64]
  [nested? : bool]
  [loop : OptNaturalLoop]) : OptBceMbMaybeShape
  (match loop
    [(OptNaturalLoop.Loop header latch body preheader)
      (match preheader
        [(OptLoopPreheader.No) (OptBceMbMaybeShape.No)]
        [(OptLoopPreheader.Some pred)
          (let
            [nest? : bool
              (opt-bce-mb-has-nested-loop? loops header body.labels)]
            (if (or
              ;; single-block self-loops belong to the dedicated pass above
              (= header latch)
              (= header entry-label)
              (if nested?
                (not nest?)
                nest?))
              (OptBceMbMaybeShape.No)
              (opt-bce-mb-loop-shape-with-preheader
                blocks
                loops
                nested?
                header
                latch
                body
                pred)))])]))

;; --- outside uses --------------------------------------------------------------
;; Uses of loop defs anywhere outside the loop, except as the loop-edge
;; inputs of exit blocks' phis (those gain a parallel fast-edge input).
(define (opt-bce-mb-outside-phi-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [inputs : ir.CompilerIrPhiInputList]
  [body-labels : OptLabelSet]) : opt_i64_i64_map.Map
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) set]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-outside-phi-uses
        set
        (ir.compiler-ir-phi-input-seq-to-list seq)
        body-labels)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (opt-bce-mb-outside-phi-uses
        (if (opt-label-contains body-labels label)
          set
          (opt-collect-value-uses set value))
        (__tl-box-place rest)
        body-labels)]))

(define (opt-bce-mb-outside-uses-seq
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [body-labels : OptLabelSet]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    set
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (opt-bce-mb-outside-uses-seq
        (match instr
          [(ir.CompilerIrInstr.Phi _ inputs _)
            (opt-bce-mb-outside-phi-uses set inputs body-labels)]
          [_ (opt-collect-instr-uses set instr)])
        instrs
        (+ index 1)
        body-labels))))

(define (opt-bce-mb-outside-uses
  [set : opt_i64_i64_map.Map]
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-outside-uses
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (if (opt-label-contains body-labels label)
              set
              (opt-bce-mb-outside-uses-seq set instrs 0 body-labels))])
        (__tl-box-place rest)
        body-labels)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-outside-uses
        set
        (ir.compiler-ir-block-seq-to-list seq)
        body-labels)]))

(define (opt-bce-mb-defs-escape-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [outside : opt_i64_i64_map.Map]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (let
      [dst : i64 (opt-bce-mb-instr-seq-dst-or instrs index (- 0 1))]
      (if (and (>= dst 0) (opt-used-contains outside dst))
        true
        (opt-bce-mb-defs-escape-instrs? instrs (+ index 1) outside)))))

(define (opt-bce-mb-defs-escape?
  [blocks : ir.CompilerIrBlockList]
  [outside : opt_i64_i64_map.Map]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-bce-mb-defs-escape-instrs? instrs 0 outside)
            true
            (opt-bce-mb-defs-escape? (__tl-box-place rest) outside))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-defs-escape? (ir.compiler-ir-block-seq-to-list seq) outside)]))

;; --- exit wiring for direct outside uses -------------------------------------
;; A loop def used by a non-phi instruction outside the loop (a return
;; operand, an arithmetic use) normally rejects versioning: the fast clone's
;; remapped def would never reach that use. It becomes wireable when every
;; predecessor of the using block is a loop block or a single-edge forwarding
;; stub (an outside block that only Jumps to the user, check-free, clonable,
;; all of whose own predecessors are loop blocks). Then the use is rewritten
;; to a freshly materialized phi that carries the def on every predecessor
;; edge -- valid because the original verified use implies the def dominates
;; every such edge -- and the stubs join the clone group: the fast clone gets
;; fast twins of the stubs, the materialized phi gains the parallel fast-edge
;; inputs through the ordinary extension, and the slow blocks stay
;; instruction-for-instruction the original. Blocks with a non-loop non-stub
;; predecessor, unreachable users, phi inputs on non-loop edges, and defs
;; without a simple result type keep the original rejection.
(defstruct OptBceMbVarList
  (items opt_dense_i64_vec.Vec))

(define (opt-bce-mb-var-list-new) : OptBceMbVarList
  (OptBceMbVarList (opt_dense_i64_vec.with-capacity 4)))

(define (opt-bce-mb-var-list-count [vars : OptBceMbVarList]) : i64
  (opt_dense_i64_vec.len (& vars.items)))

(define (opt-bce-mb-var-list-empty? [vars : OptBceMbVarList]) : bool
  (= (opt-bce-mb-var-list-count vars) 0))

;; Physical pushes preserve the old Cons/prepend operation. Logical readers
;; therefore walk from the live end toward zero (newest first).
(define (opt-bce-mb-var-list-prepend
  [vars : OptBceMbVarList (:consume)]
  [var : i64]) : OptBceMbVarList
  (let
    [items : opt_dense_i64_vec.Vec vars.items]
    (begin
      (opt_dense_i64_vec.push (&mut items) var)
      (OptBceMbVarList items))))

(define (opt-bce-mb-var-list-ref [vars : OptBceMbVarList] [index : i64]) : i64
  (let
    [items : opt_dense_i64_vec.Vec vars.items]
    (array-ref
      (opt_dense_i64_vec.slots (& items))
      (- (- (opt_dense_i64_vec.len (& items)) index) 1))))

(define (opt-bce-mb-var-list-physical-ref
  [vars : OptBceMbVarList]
  [index : i64]) : i64
  (let
    [items : opt_dense_i64_vec.Vec vars.items]
    (array-ref (opt_dense_i64_vec.slots (& items)) index)))

(defenum OptBceMbWireBlock
  (No)
  ;; no direct loop-def use: the block stays as it is
  (Same)
  ;; rewired block, the stub labels its predecessors needed
  (Some ir.CompilerIrBlock OptLabelSet))

(defenum OptBceMbWiring
  (No)
  ;; rewired function, every stub label joined into the clone group
  (Some ir.CompilerIrBlockList OptLabelSet))

(defenum OptBceMbMaybeLabels
  (No)
  (Some OptLabelSet))

(defenum OptBceMbMaybeWirePhis
  (No)
  (Some OptCopyEnv ir.CompilerIrInstrList))

;; Uses of any var by the non-phi instructions of one block (phi inputs are
;; edge-scoped and handled by the ordinary extension).
(define (opt-bce-mb-nonphi-uses-seq
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    set
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (opt-bce-mb-nonphi-uses-seq
        (match instr
          [(ir.CompilerIrInstr.Phi _ _ _) set]
          [_ (opt-collect-instr-uses set instr)])
        instrs
        (+ index 1)))))

;; Defs of these blocks that appear in the use set, in walk order.
(define (opt-bce-mb-wire-vars-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [uses : opt_i64_i64_map.Map]
  [acc : OptBceMbVarList]) : OptBceMbVarList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (let
      [dst : i64 (opt-bce-mb-instr-seq-dst-or instrs index (- 0 1))]
      (opt-bce-mb-wire-vars-instrs
        instrs
        (+ index 1)
        uses
        (if (and (>= dst 0) (opt-used-contains uses dst))
          (opt-bce-mb-var-list-prepend acc dst)
          acc)))))

(define (opt-bce-mb-wire-vars-blocks
  [blocks : ir.CompilerIrBlockList]
  [uses : opt_i64_i64_map.Map]
  [acc : OptBceMbVarList]) : OptBceMbVarList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-wire-vars-blocks
            (__tl-box-place rest)
            uses
            (opt-bce-mb-wire-vars-instrs instrs 0 uses acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-wire-vars-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        uses
        acc)]))

(define (opt-bce-mb-var-list-append
  [first : OptBceMbVarList]
  [second : OptBceMbVarList (:consume)]) : OptBceMbVarList
  (let
    [items : opt_dense_i64_vec.Vec second.items]
    [count : i64 (opt-bce-mb-var-list-count first)]
    [index : i64 0]
    (begin
      ;; Logical append(first, second) is physical second followed by first.
      ;; Grow the reusable second backing store once instead of copying a full
      ;; array per element.
      (while (< index count)
        (begin
          (opt_dense_i64_vec.push
            (&mut items)
            (opt-bce-mb-var-list-physical-ref first index))
          (set! index (+ index 1))))
      (OptBceMbVarList items))))

(cfg
  test
  (test
    optimizer-bce-mb-var-list-dense-storage-grows
    (let
      [first : OptBceMbVarList (opt-bce-mb-var-list-new)]
      [second : OptBceMbVarList (opt-bce-mb-var-list-new)]
      (begin
        (set! first (opt-bce-mb-var-list-prepend first 0))
        (set! first (opt-bce-mb-var-list-prepend first 1))
        (set! first (opt-bce-mb-var-list-prepend first 2))
        (set! first (opt-bce-mb-var-list-prepend first 3))
        (set! first (opt-bce-mb-var-list-prepend first 4))
        (set! first (opt-bce-mb-var-list-prepend first 5))
        (set! first (opt-bce-mb-var-list-prepend first 6))
        (set! first (opt-bce-mb-var-list-prepend first 7))
        (set! first (opt-bce-mb-var-list-prepend first 8))
        (set! second (opt-bce-mb-var-list-prepend second 100))
        (set! second (opt-bce-mb-var-list-prepend second 101))
        (let
          [joined : OptBceMbVarList (opt-bce-mb-var-list-append first second)]
          (begin
            (test.assert-i64-eq
              (opt-bce-mb-var-list-count joined)
              11
              "BCE variable storage grows and concatenates all entries")
            (test.assert-i64-eq
              (opt-bce-mb-var-list-ref joined 0)
              8
              "BCE variable concatenation keeps the first newest entry")
            (test.assert-i64-eq
              (opt-bce-mb-var-list-ref joined 8)
              0
              "BCE variable concatenation keeps the first oldest entry")
            (test.assert-i64-eq
              (opt-bce-mb-var-list-ref joined 9)
              101
              "BCE variable concatenation begins the second sequence in order")
            (test.assert-i64-eq
              (opt-bce-mb-var-list-ref joined 10)
              100
              "BCE variable concatenation keeps the second oldest entry")
            (let
              [duplicate : OptBceMbVarList
                (opt-bce-mb-var-list-prepend joined 8)]
              (begin
                (test.assert-i64-eq
                  (opt-bce-mb-var-list-count duplicate)
                  12
                  "BCE variable storage preserves duplicates")
                (test.assert-i64-eq
                  (opt-bce-mb-var-list-ref duplicate 1)
                  8
                  "BCE variable duplicate leaves prior order intact")))))))))

(define (opt-bce-mb-labels-all-in? [labels : OptLabelSet] [set : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (if (opt-label-contains set (opt-label-ref labels 0))
        (opt-bce-mb-labels-all-in? (opt-label-tail labels) set)
        false)]))

;; The SHAPE half of a forwarding stub: an outside block whose only successor is
;; the using block (an explicit Jump), check-free, clonable by the same
;; whitelist the loop blocks pass, and whose fast twin label is fresh. Split out
;; because the exit-join admission below reuses the shape with a different
;; predecessor rule.
(define (opt-bce-mb-stub-shape-ok?
  [blocks : ir.CompilerIrBlockList]
  [stub : i64]
  [user : i64]) : bool
  (match (opt-cfg-find-block blocks stub)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
            (if (or
              (< count 1)
              (not (opt-unroll-no-phi-from? instrs phi-count))
              (opt-cfg-instr-seq-can-fallthrough? instrs)
              (> (- (- count 1) phi-count) (opt-bce-version-body-max))
              (not (opt-bce-version-body-ok? instrs phi-count (- count 1)))
              (not
                (=
                  (opt-bce-version-check-count instrs phi-count (- count 1) 0)
                  0))
              (opt-cfg-block-exists?
                blocks
                (ir.compiler-ir-label
                  (str_cat.str-cat
                    (ir.compiler-ir-label-text stub)
                    "__bce_fast"))))
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump target) (= target user)]
                [_ false])))])]))

;; A forwarding-stub predecessor: the shape above, every one of whose own
;; predecessors is a loop block.
(define (opt-bce-mb-stub-ok?
  [pred-map : OptPredMap]
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [stub : i64]
  [user : i64]) : bool
  (and
    (opt-bce-mb-stub-shape-ok? blocks stub user)
    (opt-bce-mb-labels-all-in? (opt-pred-map-lookup pred-map stub) body-labels)))

;; Classify every predecessor of the using block: loop blocks wire directly,
;; anything else must be a forwarding stub. Returns the stub labels found.
(define (opt-bce-mb-wire-preds
  [pred-map : OptPredMap]
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [preds : OptLabelSet]
  [user : i64]
  [stubs : OptLabelSet]) : OptBceMbMaybeLabels
  (match preds
    [(OptLabelSet.Nil) (OptBceMbMaybeLabels.Some stubs)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (if (opt-label-contains body-labels pred)
          (opt-bce-mb-wire-preds
            pred-map
            blocks
            body-labels
            (opt-label-tail preds)
            user
            stubs)
          (if (opt-bce-mb-stub-ok? pred-map blocks body-labels pred user)
            (opt-bce-mb-wire-preds
              pred-map
              blocks
              body-labels
              (opt-label-tail preds)
              user
              (opt-label-add stubs pred))
            (OptBceMbMaybeLabels.No))))]))

;; The result type of a loop/stub def, needed for the materialized phi. Only
;; the simple typed def kinds are supported; anything else leaves the use
;; unwireable.
(define (opt-bce-mb-def-type [instr : ir.CompilerIrInstr]) : OptMaybeAstType
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ ty) (OptMaybeAstType.Some ty)]
    [(ir.CompilerIrInstr.Cast _ _ _ to-ty) (OptMaybeAstType.Some to-ty)]
    [(ir.CompilerIrInstr.Bitcast _ _ _ to-ty) (OptMaybeAstType.Some to-ty)]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ ty) (OptMaybeAstType.Some ty)]
    [(ir.CompilerIrInstr.UnOp _ _ _ ty) (OptMaybeAstType.Some ty)]
    [(ir.CompilerIrInstr.Gep _ _ _ ty) (OptMaybeAstType.Some ty)]
    [(ir.CompilerIrInstr.Load _ _ ty) (OptMaybeAstType.Some ty)]
    [(ir.CompilerIrInstr.Phi _ _ ty) (OptMaybeAstType.Some ty)]
    ;; A direct call's result type is its own carried type, and the clone
    ;; duplicates the call (opt-bce-mb-body-instr-ok?), so a call result used
    ;; outside the loop is exit-wireable exactly like a load's.
    [(ir.CompilerIrInstr.Call _ _ _ ty) (OptMaybeAstType.Some ty)]
    [_ (OptMaybeAstType.No)]))

;; One input per predecessor edge, all carrying the same loop def.
(define (opt-bce-mb-wire-phi-inputs
  [preds : OptLabelSet]
  [value : ir.CompilerIrValue]) : ir.CompilerIrPhiInputList
  (match preds
    [(OptLabelSet.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(OptLabelSet.Dense _ _)
      (ir.compiler-ir-phi-input-cons
        value
        (opt-label-ref preds 0)
        (opt-bce-mb-wire-phi-inputs (opt-label-tail preds) value))]))

;; Every input of this phi is `var` on a distinct predecessor edge: the merge
;; the wiring is about to build already exists (the far-use repair below
;; materializes one), so reuse it instead of adding a second copy.
(define (opt-bce-mb-merge-phi-inputs?
  [inputs : ir.CompilerIrPhiInputList]
  [var : i64]
  [preds : OptLabelSet]
  [seen : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (= seen (opt-label-count preds))]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-merge-phi-inputs?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        var
        preds
        seen)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (and
        (match value
          [(ir.CompilerIrValue.Var id) (= id var)]
          [_ false])
        (opt-label-contains preds label)
        (opt-bce-mb-merge-phi-inputs?
          (__tl-box-place rest)
          var
          preds
          (+ seen 1)))]))

;; The var of such a phi in this block, or -1.
(define (opt-bce-mb-existing-merge-phi
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]
  [preds : OptLabelSet]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    -1
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst inputs _)
        (if (opt-bce-mb-merge-phi-inputs? inputs var preds 0)
          dst
          (opt-bce-mb-existing-merge-phi instrs (+ index 1) var preds))]
      [_ -1])))

;; Materialize one exit phi per wireable var and the copy env rewriting its
;; non-phi uses to the phi's var.
(define (opt-bce-mb-wire-phis-from
  [vars : OptBceMbVarList]
  [index : i64]
  [all-blocks : ir.CompilerIrBlockList]
  [preds : OptLabelSet]
  [instrs : ir.CompilerIrInstrSeq]
  [cell : (__tl_dyn-array i64)]
  [env : OptCopyEnv]
  [phis : ir.CompilerIrInstrList]) : OptBceMbMaybeWirePhis
  (if (>= index (opt-bce-mb-var-list-count vars))
    (OptBceMbMaybeWirePhis.Some env phis)
    (let
      [var : i64 (opt-bce-mb-var-list-ref vars index)]
      [existing : i64 (opt-bce-mb-existing-merge-phi instrs 0 var preds)]
      (if (>= existing 0)
        (opt-bce-mb-wire-phis-from
          vars
          (+ index 1)
          all-blocks
          preds
          instrs
          cell
          (OptCopyEnv.Cons var (ir.CompilerIrValue.Var existing) (box env))
          phis)
        (match (opt-bce-mb-find-def all-blocks var)
          [(OptBceMbMaybeInstr.No) (OptBceMbMaybeWirePhis.No)]
          [(OptBceMbMaybeInstr.Some instr)
            (match (opt-bce-mb-def-type instr)
              [(OptMaybeAstType.No) (OptBceMbMaybeWirePhis.No)]
              [(OptMaybeAstType.Some ty)
                (let
                  [pv : i64 (opt-bce-version-alloc-var cell)]
                  (opt-bce-mb-wire-phis-from
                    vars
                    (+ index 1)
                    all-blocks
                    preds
                    instrs
                    cell
                    (OptCopyEnv.Cons var (ir.CompilerIrValue.Var pv) (box env))
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.Phi
                        pv
                        (opt-bce-mb-wire-phi-inputs
                          preds
                          (ir.CompilerIrValue.Var var))
                        ty)
                      phis)))])])))))

(define (opt-bce-mb-wire-phis
  [vars : OptBceMbVarList]
  [all-blocks : ir.CompilerIrBlockList]
  [preds : OptLabelSet]
  [instrs : ir.CompilerIrInstrSeq]
  [cell : (__tl_dyn-array i64)]
  [env : OptCopyEnv]
  [phis : ir.CompilerIrInstrList]) : OptBceMbMaybeWirePhis
  (opt-bce-mb-wire-phis-from vars 0 all-blocks preds instrs cell env phis))

;; The rewired block's instructions: the existing phi prefix, then the
;; materialized phis, then every original instruction with its non-phi uses
;; rewritten through the copy env (phi instructions are left untouched).
(define (opt-bce-mb-wire-block-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [phi-count : i64]
  [new-phis : ir.CompilerIrInstrList]
  [env : OptCopyEnv]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [tail : ir.CompilerIrInstrList
        (opt-bce-mb-wire-block-instrs instrs (+ index 1) phi-count new-phis env)]
      (if (= index phi-count)
        (opt-aggregate-instr-list-append
          new-phis
          (ir.compiler-ir-instr-cons
            (opt-copy-subst-instr
              env
              (ir.compiler-ir-instr-seq-ref instrs index))
            tail))
        (ir.compiler-ir-instr-cons
          (opt-copy-subst-instr env (ir.compiler-ir-instr-seq-ref instrs index))
          tail)))))

;; Stub defs that appear in the use set (a stub's own computation feeding the
;; user, e.g. a materialized exit value): wired like loop defs.
(define (opt-bce-mb-wire-vars-stubs
  [blocks : ir.CompilerIrBlockList]
  [stub-labels : OptLabelSet]
  [uses : opt_i64_i64_map.Map]
  [acc : OptBceMbVarList]) : OptBceMbVarList
  (match stub-labels
    [(OptLabelSet.Nil) acc]
    [(OptLabelSet.Dense _ _)
      (match (opt-cfg-find-block blocks (opt-label-ref stub-labels 0))
        [(OptMaybeBlock.No)
          (opt-bce-mb-wire-vars-stubs
            blocks
            (opt-label-tail stub-labels)
            uses
            acc)]
        [(OptMaybeBlock.Some block)
          (match block
            [(ir.CompilerIrBlock.Block _ instrs)
              (opt-bce-mb-wire-vars-stubs
                blocks
                (opt-label-tail stub-labels)
                uses
                (opt-bce-mb-wire-vars-instrs instrs 0 uses acc))])])]))

;; Wire one outside block: when its non-phi instructions use loop (or stub)
;; defs, materialize the exit phis and rewrite the uses.
(define (opt-bce-mb-wire-block
  [pred-map : OptPredMap]
  [all-blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [uses : opt_i64_i64_map.Map]
  [cell : (__tl_dyn-array i64)]) : OptBceMbWireBlock
  (let
    [loop-vars : OptBceMbVarList
      (opt-bce-mb-wire-vars-blocks body-blocks uses (opt-bce-mb-var-list-new))]
    (if (opt-bce-mb-var-list-empty? loop-vars)
      (OptBceMbWireBlock.Same)
      (let
        [preds : OptLabelSet (opt-pred-map-lookup pred-map label)]
        (if (= (opt-label-count preds) 0)
          (OptBceMbWireBlock.No)
          (match (opt-bce-mb-wire-preds
            pred-map
            all-blocks
            body-labels
            preds
            label
            (OptLabelSet.Nil))
            [(OptBceMbMaybeLabels.No) (OptBceMbWireBlock.No)]
            [(OptBceMbMaybeLabels.Some stub-labels)
              (let
                [stub-vars : OptBceMbVarList
                  (opt-bce-mb-wire-vars-stubs
                    all-blocks
                    stub-labels
                    uses
                    (opt-bce-mb-var-list-new))]
                (match (opt-bce-mb-wire-phis
                  (opt-bce-mb-var-list-append loop-vars stub-vars)
                  all-blocks
                  preds
                  instrs
                  cell
                  (OptCopyEnv.Nil)
                  (ir.CompilerIrInstrList.Nil))
                  [(OptBceMbMaybeWirePhis.No) (OptBceMbWireBlock.No)]
                  [(OptBceMbMaybeWirePhis.Some env new-phis)
                    (OptBceMbWireBlock.Some
                      (ir.compiler-ir-block
                        label
                        (opt-bce-mb-wire-block-instrs
                          instrs
                          0
                          (opt-unroll-phi-prefix-count instrs 0)
                          new-phis
                          env))
                      stub-labels)]))]))))))

;; Rewire every outside block with direct loop-def uses, or fail the whole
;; attempt (the caller then keeps the original function).
(define (opt-bce-mb-wire-exits
  [pred-map : OptPredMap]
  [blocks : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]
  [cell : (__tl_dyn-array i64)]
  [stubs : OptLabelSet]) : OptBceMbWiring
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (OptBceMbWiring.Some (ir.CompilerIrBlockList.Nil) stubs)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-wire-exits
        pred-map
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        body-labels
        body-blocks
        cell
        stubs)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (opt-label-contains body-labels label)
            (match (opt-bce-mb-wire-exits
              pred-map
              (__tl-box-place rest)
              all-blocks
              body-labels
              body-blocks
              cell
              stubs)
              [(OptBceMbWiring.No) (OptBceMbWiring.No)]
              [(OptBceMbWiring.Some wired-tail wired-stubs)
                (OptBceMbWiring.Some
                  (ir.compiler-ir-block-cons block wired-tail)
                  wired-stubs)])
            (let
              [uses : opt_i64_i64_map.Map
                (opt-bce-mb-nonphi-uses-seq
                  (opt_i64_i64_map.with-capacity 8)
                  instrs
                  0)]
              (match (opt-bce-mb-wire-block
                pred-map
                all-blocks
                body-labels
                body-blocks
                label
                instrs
                uses
                cell)
                [(OptBceMbWireBlock.No) (OptBceMbWiring.No)]
                [(OptBceMbWireBlock.Same)
                  (match (opt-bce-mb-wire-exits
                    pred-map
                    (__tl-box-place rest)
                    all-blocks
                    body-labels
                    body-blocks
                    cell
                    stubs)
                    [(OptBceMbWiring.No) (OptBceMbWiring.No)]
                    [(OptBceMbWiring.Some wired-tail wired-stubs)
                      (OptBceMbWiring.Some
                        (ir.compiler-ir-block-cons block wired-tail)
                        wired-stubs)])]
                [(OptBceMbWireBlock.Some wired-block block-stubs)
                  (match (opt-bce-mb-wire-exits
                    pred-map
                    (__tl-box-place rest)
                    all-blocks
                    body-labels
                    body-blocks
                    cell
                    (opt-bce-mb-labels-union block-stubs stubs))
                    [(OptBceMbWiring.No) (OptBceMbWiring.No)]
                    [(OptBceMbWiring.Some wired-tail wired-stubs)
                      (OptBceMbWiring.Some
                        (ir.compiler-ir-block-cons wired-block wired-tail)
                        wired-stubs)])])))])]))

;; --- exit-stub phi escapes ----------------------------------------------------
;;
;; The escape test counts a loop def read by a phi OUTSIDE the loop as an escape
;; whenever the input's edge is not a clone-group edge. On a STANDALONE callee
;; the loop's own exit block is the reader, its inputs sit on loop edges, and
;; the ordinary exit-phi extension carries them to the fast clone. INLINING
;; breaks exactly that and nothing else: the absorbed body's exit joins into the
;; site's `cont` merge, so the callee's own exit block becomes a jump-only
;; FORWARDER between the loop and the phi that reads the loop's result, and the
;; input is keyed on the forwarder. The measured case is `it-slice-eq?`'s byte
;; compare, which versions to a check-free clone standing alone and refuses the
;; instant it is absorbed into `it-intern-slice` -- same loop, same counter, same
;; invariant bound, same two derivable checks. The refusal was POSITIONAL.
;;
;; What absorption adds, and only absorption, is an EXIT JOIN: the callee's exit
;; arms fan into the callee's own exit block, which then forwards into the
;; site's continuation. So the block the phi input is keyed on is a join of the
;; loop's exits and is reached by NO loop edge of its own. That is the exact
;; admission here, and it is narrow on purpose. A block keyed directly off a
;; loop edge is the ordinary exit-phi case the extension already handles; a
;; block with BOTH a loop edge and a forwarder edge is one CFG simplification
;; away from it, and taking it costs the rotated version the pass builds a
;; pipeline round later from the same loop -- measured on lex_source's
;; `ls-tokenize` newline scan, where admitting that shape versions the
;; pre-rotation top-tested form and gives up the rotated clone's register
;; assignment for +0.118%.
;;
;; Every level is the forwarding stub the direct-use wiring already defines: an
;; outside block that only Jumps to its user, check-free, phi-free, clonable by
;; the loop's own whitelist, with a fresh fast-twin label. Pulling the join and
;; its arms into the clone group makes the phi's edge a clone edge, and the
;; ordinary extension then gives that phi a parallel input carrying the fast
;; clone's remapped value on the join's fast twin. No new construction, no block
;; gains a predecessor the loop did not already reach, and the slow blocks stay
;; instruction-for-instruction the original -- the guard and clone rules are the
;; unchanged ones.
;;
;; Every phi input on a non-group edge is accounted for: an input whose value is
;; not a group def cannot carry an escape and is left alone (the `false` arm of
;; the absorbed `(if (= name-length len) ... false)` is exactly that), and an
;; input whose value IS a group def must sit on an admissible join or the whole
;; attempt keeps the original rejection. The escape test then reruns over the
;; widened group, so a def escaping any OTHER way still refuses.
(define (opt-bce-mb-value-group-def?
  [value : ir.CompilerIrValue]
  [defs : opt_i64_i64_map.Map]) : bool
  (match value
    [(ir.CompilerIrValue.Var id) (opt-used-contains defs id)]
    [_ false]))

;; Every predecessor of the join is a forwarding stub out of the clone group --
;; never a group block itself. Returns the arms to pull in with the join.
(define (opt-bce-mb-exit-join-arms
  [pred-map : OptPredMap]
  [all-blocks : ir.CompilerIrBlockList]
  [clone-labels : OptLabelSet]
  [preds : OptLabelSet]
  [join : i64]
  [arms : OptLabelSet]) : OptBceMbMaybeLabels
  (match preds
    [(OptLabelSet.Nil) (OptBceMbMaybeLabels.Some arms)]
    [(OptLabelSet.Dense _ _)
      (let
        [pred : i64 (opt-label-ref preds 0)]
        (if (or
          (opt-label-contains clone-labels pred)
          (not (opt-bce-mb-stub-ok? pred-map all-blocks clone-labels pred join)))
          (OptBceMbMaybeLabels.No)
          (opt-bce-mb-exit-join-arms
            pred-map
            all-blocks
            clone-labels
            (opt-label-tail preds)
            join
            (opt-label-add arms pred))))]))

;; The join block itself plus its arms, or No.
(define (opt-bce-mb-exit-join-labels
  [pred-map : OptPredMap]
  [all-blocks : ir.CompilerIrBlockList]
  [clone-labels : OptLabelSet]
  [join : i64]
  [user : i64]
  [stubs : OptLabelSet]) : OptBceMbMaybeLabels
  (if (not (opt-bce-mb-stub-shape-ok? all-blocks join user))
    (OptBceMbMaybeLabels.No)
    (let
      [preds : OptLabelSet (opt-pred-map-lookup pred-map join)]
      (if (< (opt-label-count preds) 1)
        (OptBceMbMaybeLabels.No)
        (match (opt-bce-mb-exit-join-arms
          pred-map
          all-blocks
          clone-labels
          preds
          join
          (OptLabelSet.Nil))
          [(OptBceMbMaybeLabels.No) (OptBceMbMaybeLabels.No)]
          [(OptBceMbMaybeLabels.Some arms)
            (OptBceMbMaybeLabels.Some
              (opt-bce-mb-labels-union arms (opt-label-add stubs join)))])))))

(define (opt-bce-mb-phi-stub-inputs
  [pred-map : OptPredMap]
  [all-blocks : ir.CompilerIrBlockList]
  [clone-labels : OptLabelSet]
  [defs : opt_i64_i64_map.Map]
  [user : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [stubs : OptLabelSet]) : OptBceMbMaybeLabels
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (OptBceMbMaybeLabels.Some stubs)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-phi-stub-inputs
        pred-map
        all-blocks
        clone-labels
        defs
        user
        (ir.compiler-ir-phi-input-seq-to-list seq)
        stubs)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (or
        (opt-label-contains clone-labels label)
        (not (opt-bce-mb-value-group-def? value defs)))
        (opt-bce-mb-phi-stub-inputs
          pred-map
          all-blocks
          clone-labels
          defs
          user
          (__tl-box-place rest)
          stubs)
        (match (opt-bce-mb-exit-join-labels
          pred-map
          all-blocks
          clone-labels
          label
          user
          stubs)
          [(OptBceMbMaybeLabels.No) (OptBceMbMaybeLabels.No)]
          [(OptBceMbMaybeLabels.Some next)
            (opt-bce-mb-phi-stub-inputs
              pred-map
              all-blocks
              clone-labels
              defs
              user
              (__tl-box-place rest)
              next)]))]))

(define (opt-bce-mb-phi-stub-labels-seq
  [pred-map : OptPredMap]
  [all-blocks : ir.CompilerIrBlockList]
  [clone-labels : OptLabelSet]
  [defs : opt_i64_i64_map.Map]
  [user : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [stubs : OptLabelSet]) : OptBceMbMaybeLabels
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptBceMbMaybeLabels.Some stubs)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (match (opt-bce-mb-phi-stub-inputs
          pred-map
          all-blocks
          clone-labels
          defs
          user
          inputs
          stubs)
          [(OptBceMbMaybeLabels.No) (OptBceMbMaybeLabels.No)]
          [(OptBceMbMaybeLabels.Some next)
            (opt-bce-mb-phi-stub-labels-seq
              pred-map
              all-blocks
              clone-labels
              defs
              user
              instrs
              (+ index 1)
              next)])]
      [_
        (opt-bce-mb-phi-stub-labels-seq
          pred-map
          all-blocks
          clone-labels
          defs
          user
          instrs
          (+ index 1)
          stubs)])))

;; Every forwarding stub the outside phis need pulled into the clone group, or
;; No when one of those edges is not an admissible stub.
(define (opt-bce-mb-phi-stub-labels
  [pred-map : OptPredMap]
  [blocks : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [clone-labels : OptLabelSet]
  [defs : opt_i64_i64_map.Map]
  [stubs : OptLabelSet]) : OptBceMbMaybeLabels
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBceMbMaybeLabels.Some stubs)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-phi-stub-labels
        pred-map
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        clone-labels
        defs
        stubs)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (opt-label-contains clone-labels label)
            (opt-bce-mb-phi-stub-labels
              pred-map
              (__tl-box-place rest)
              all-blocks
              clone-labels
              defs
              stubs)
            (match (opt-bce-mb-phi-stub-labels-seq
              pred-map
              all-blocks
              clone-labels
              defs
              label
              instrs
              0
              stubs)
              [(OptBceMbMaybeLabels.No) (OptBceMbMaybeLabels.No)]
              [(OptBceMbMaybeLabels.Some next)
                (opt-bce-mb-phi-stub-labels
                  pred-map
                  (__tl-box-place rest)
                  all-blocks
                  clone-labels
                  defs
                  next)]))])]))

;; --- far exit uses ------------------------------------------------------------
;;
;; The wiring above rewrites a direct outside use only in a block whose every
;; predecessor is a loop block or a forwarding stub. A loop value that survives
;; PAST the exit join -- `(while (and (< i n) (not changed)) ...)` whose
;; `changed` is tested at the exit AND returned many blocks later, which is
;; `liveness_storage/recompute!` -- has a second use in a block the loop does
;; not reach directly, and that use alone refused the whole loop.
;;
;; It does not have to. Call W the block the exit join wires (its own direct
;; use is what pulls the stubs into the clone group and materializes the phi
;; that merges the slow and fast exit values) and B a block with a far use. When
;; W DOMINATES B, every execution reaching B has passed W, so the value W's
;; merge carries is exactly the value B's use wants: materialize one more phi in
;; W over its predecessor edges -- extended with the fast-edge inputs by the
;; ordinary exit-phi extension, since the stubs join the clone group -- and
;; rewrite B's use to it.
;;
;; The conditions, all required and all checked on the ORIGINAL function:
;;   * exactly ONE wireable outside block W (several independent wire points
;;     plus far uses would need a phi placement this pass does not compute);
;;   * W dominates every far block;
;;   * every var a far block reads is one W itself reads, which is what makes
;;     the def dominate W's predecessor edges (the original verified use in W
;;     already implies it) -- a var live only at the far block gets no such
;;     guarantee and refuses.
;; Anything else keeps the original rejection.
(defstruct OptBceMbFarPlan
  ;; the single wireable outside block: -1 none seen, -2 more than one
  (wire i64)
  (wire-vars OptBceMbVarList)
  (far-labels OptLabelSet)
  (far-vars OptBceMbVarList))

(define (opt-bce-mb-var-list-contains? [vars : OptBceMbVarList] [var : i64]) : bool
  (opt-bce-mb-var-list-contains-from? vars var 0))

(define (opt-bce-mb-var-list-contains-from?
  [vars : OptBceMbVarList]
  [var : i64]
  [index : i64]) : bool
  (if (>= index (opt-bce-mb-var-list-count vars))
    false
    (or
      (= (opt-bce-mb-var-list-ref vars index) var)
      (opt-bce-mb-var-list-contains-from? vars var (+ index 1)))))

(define (opt-bce-mb-var-list-union
  [vars : OptBceMbVarList]
  [acc : OptBceMbVarList]) : OptBceMbVarList
  (opt-bce-mb-var-list-union-from vars 0 acc))

(define (opt-bce-mb-var-list-union-from
  [vars : OptBceMbVarList]
  [index : i64]
  [acc : OptBceMbVarList]) : OptBceMbVarList
  (if (>= index (opt-bce-mb-var-list-count vars))
    acc
    (let
      [item : i64 (opt-bce-mb-var-list-ref vars index)]
      (opt-bce-mb-var-list-union-from
        vars
        (+ index 1)
        (if (opt-bce-mb-var-list-contains? acc item)
          acc
          (opt-bce-mb-var-list-prepend acc item))))))

(define (opt-bce-mb-var-list-subset?
  [vars : OptBceMbVarList]
  [outer : OptBceMbVarList]) : bool
  (opt-bce-mb-var-list-subset-from? vars outer 0))

(define (opt-bce-mb-var-list-subset-from?
  [vars : OptBceMbVarList]
  [outer : OptBceMbVarList]
  [index : i64]) : bool
  (or
    (>= index (opt-bce-mb-var-list-count vars))
    (and
      (opt-bce-mb-var-list-contains? outer (opt-bce-mb-var-list-ref vars index))
      (opt-bce-mb-var-list-subset-from? vars outer (+ index 1)))))

;; Classify every outside block with a direct loop-def use as the wire point or
;; as a far block.
(define (opt-bce-mb-far-scan
  [pred-map : OptPredMap]
  [blocks : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]
  [plan : OptBceMbFarPlan]) : OptBceMbFarPlan
  (match blocks
    [(ir.CompilerIrBlockList.Nil) plan]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-far-scan
        pred-map
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        body-labels
        body-blocks
        plan)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-far-scan
        pred-map
        (__tl-box-place rest)
        all-blocks
        body-labels
        body-blocks
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (if (opt-label-contains body-labels label)
              plan
              (let
                [vars : OptBceMbVarList
                  (opt-bce-mb-wire-vars-blocks
                    body-blocks
                    (opt-bce-mb-nonphi-uses-seq
                      (opt_i64_i64_map.with-capacity 8)
                      instrs
                      0)
                    (opt-bce-mb-var-list-new))]
                (if (opt-bce-mb-var-list-empty? vars)
                  plan
                  (match (opt-bce-mb-wire-preds
                    pred-map
                    all-blocks
                    body-labels
                    (opt-pred-map-lookup pred-map label)
                    label
                    (OptLabelSet.Nil))
                    [(OptBceMbMaybeLabels.Some _)
                      (OptBceMbFarPlan
                        (if (= plan.wire -1)
                          label
                          -2)
                        (if (= plan.wire -1)
                          vars
                          plan.wire-vars)
                        plan.far-labels
                        plan.far-vars)]
                    [(OptBceMbMaybeLabels.No)
                      (OptBceMbFarPlan
                        plan.wire
                        plan.wire-vars
                        (opt-label-add plan.far-labels label)
                        (opt-bce-mb-var-list-union vars plan.far-vars))]))))]))]))

(define (opt-bce-mb-far-labels-dominated?
  [doms : OptDomInfo]
  [wire : i64]
  [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (and
        (opt-dom-dominates? doms wire (opt-label-ref labels 0))
        (opt-bce-mb-far-labels-dominated? doms wire (opt-label-tail labels)))]))

(define (opt-bce-mb-far-plan-ok? [doms : OptDomInfo] [plan : OptBceMbFarPlan]) : bool
  (and
    (>= plan.wire 0)
    (opt-bce-mb-far-labels-dominated? doms plan.wire plan.far-labels)
    (opt-bce-mb-var-list-subset? plan.far-vars plan.wire-vars)))

;; One merge phi per far var, materialized in the wire point over its
;; predecessor edges, plus the env that rewrites the far uses to them.
(define (opt-bce-mb-far-phis
  [vars : OptBceMbVarList]
  [all-blocks : ir.CompilerIrBlockList]
  [preds : OptLabelSet]
  [instrs : ir.CompilerIrInstrSeq]
  [cell : (__tl_dyn-array i64)]
  [env : OptCopyEnv]
  [phis : ir.CompilerIrInstrList]) : OptBceMbMaybeWirePhis
  (opt-bce-mb-wire-phis vars all-blocks preds instrs cell env phis))

(define (opt-bce-mb-far-rewrite
  [blocks : ir.CompilerIrBlockList]
  [wire : i64]
  [far-labels : OptLabelSet]
  [phis : ir.CompilerIrInstrList]
  [env : OptCopyEnv]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-far-rewrite
        (ir.compiler-ir-block-seq-to-list seq)
        wire
        far-labels
        phis
        env)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (cond
              [(= label wire)
                ;; the merge phis join the block's phi prefix; the wire point's
                ;; OWN uses stay on the original value, so the ordinary wiring
                ;; still sees it as a using block and still pulls its stub
                ;; predecessors into the clone group
                (ir.compiler-ir-block
                  label
                  (opt-bce-mb-wire-block-instrs
                    instrs
                    0
                    (opt-unroll-phi-prefix-count instrs 0)
                    phis
                    (OptCopyEnv.Nil)))]
              [(opt-label-contains far-labels label)
                (ir.compiler-ir-block
                  label
                  (opt-bce-mb-wire-block-instrs
                    instrs
                    0
                    (opt-unroll-phi-prefix-count instrs 0)
                    (ir.CompilerIrInstrList.Nil)
                    env))]
              [else block])
            (opt-bce-mb-far-rewrite
              (__tl-box-place rest)
              wire
              far-labels
              phis
              env))])]))

(defenum OptBceMbFarResult
  ;; a far use this pass cannot repair
  (No)
  ;; nothing to repair: the ordinary wiring handles the function as it is
  (Same)
  (Some ir.CompilerIrBlockList))

(define (opt-bce-mb-far-repair
  [pred-map : OptPredMap]
  [doms : OptDomInfo]
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]
  [cell : (__tl_dyn-array i64)]) : OptBceMbFarResult
  (let
    [plan : OptBceMbFarPlan
      (opt-bce-mb-far-scan
        pred-map
        blocks
        blocks
        body-labels
        body-blocks
        (OptBceMbFarPlan
          -1
          (opt-bce-mb-var-list-new)
          (OptLabelSet.Nil)
          (opt-bce-mb-var-list-new)))]
    (if (= (opt-label-count plan.far-labels) 0)
      (OptBceMbFarResult.Same)
      (if (not (opt-bce-mb-far-plan-ok? doms plan))
        (OptBceMbFarResult.No)
        (match (opt-bce-mb-far-phis
          plan.far-vars
          blocks
          (opt-pred-map-lookup pred-map plan.wire)
          (opt-bce-mb-find-block-seq blocks plan.wire)
          cell
          (OptCopyEnv.Nil)
          (ir.CompilerIrInstrList.Nil))
          [(OptBceMbMaybeWirePhis.No) (OptBceMbFarResult.No)]
          [(OptBceMbMaybeWirePhis.Some env phis)
            (OptBceMbFarResult.Some
              (opt-bce-mb-far-rewrite blocks plan.wire plan.far-labels phis env))])))))

;; The stub blocks in layout order (they join the fast clone group).
(define (opt-bce-mb-stub-blocks-from
  [blocks : ir.CompilerIrBlockList]
  [stub-labels : OptLabelSet]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-bce-mb-stub-blocks-from (__tl-box-place rest) stub-labels)]
            (if (opt-label-contains stub-labels label)
              (ir.compiler-ir-block-cons block tail)
              tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-stub-blocks-from
        (ir.compiler-ir-block-seq-to-list seq)
        stub-labels)]))

(define (opt-bce-mb-labels-union [labels : OptLabelSet] [acc : OptLabelSet]) : OptLabelSet
  (match labels
    [(OptLabelSet.Nil) acc]
    [(OptLabelSet.Dense _ _)
      (opt-bce-mb-labels-union
        (opt-label-tail labels)
        (opt-label-add acc (opt-label-ref labels 0)))]))

(define (opt-bce-mb-blocks-append
  [first : ir.CompilerIrBlockList]
  [second : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match first
    [(ir.CompilerIrBlockList.Nil) second]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        block
        (opt-bce-mb-blocks-append (__tl-box-place rest) second))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-blocks-append (ir.compiler-ir-block-seq-to-list seq) second)]))

;; --- guard condition derivation ------------------------------------------------
;; Seed equality for the bounded header phi: both seeds are preheader-edge
;; values defined outside the loop, but separate initializers give them
;; distinct var ids (`store : i64 lo` / `scan : i64 lo` lower to two Movs).
;; Compare them up to function-wide Mov/reinterpret-cast resolution so both
;; reduce to the same runtime value.
(define (opt-bce-mb-seeds-match?
  [all-blocks : ir.CompilerIrBlockList]
  [seed : ir.CompilerIrValue]
  [init : ir.CompilerIrValue]) : bool
  (match seed
    [(ir.CompilerIrValue.Var seed-id)
      (match init
        [(ir.CompilerIrValue.Var init-id)
          (=
            (opt-bce-mb-resolve all-blocks seed-id 16)
            (opt-bce-mb-resolve all-blocks init-id 16))]
        [_ false])]
    [(ir.CompilerIrValue.I64 sk)
      (match init
        [(ir.CompilerIrValue.I64 ik) (= sk ik)]
        [_ false])]
    [_ false]))

;; The invariant value an operand resolves to across the whole loop (a
;; literal, or a var defined outside every loop block).
(define (opt-bce-mb-invariant-operand
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrValue.I64 k)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.I64 k))]
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (if (opt-used-contains defs id)
          (ir.CompilerIrMaybeValue.No)
          (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var id))))]
    [_ (ir.CompilerIrMaybeValue.No)]))

;; The bounded header phi's back-edge value: sphi itself, sphi + 1, or a
;; merge phi whose inputs are each sphi / sphi+1 -- per latch crossing the
;; phi grows by at most the counter's step and never shrinks, so it stays
;; within [seed, scan] for every executed iteration.
(define (opt-bce-mb-bounded-value?
  [body-blocks : ir.CompilerIrBlockList]
  [sphi : i64]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : bool
  (match value
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (cond
          [(= id sphi) true]
          [(<= fuel 0) false]
          [else
            (match (opt-bce-mb-find-def body-blocks id)
              [(OptBceMbMaybeInstr.No) false]
              [(OptBceMbMaybeInstr.Some instr)
                (match instr
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                    (match op
                      [(ir.CompilerIrBinOp.Add)
                        (match rhs
                          [(ir.CompilerIrValue.I64 step)
                            (and
                              (= step 1)
                              (match ty
                                [(ast.AstType.I64) true]
                                [_ false])
                              (match lhs
                                [(ir.CompilerIrValue.Var add-src)
                                  (=
                                    (opt-bce-mb-resolve body-blocks add-src 16)
                                    sphi)]
                                [_ false]))]
                          [_ false])]
                      [_ false])]
                  [(ir.CompilerIrInstr.Phi _ inputs _)
                    (opt-bce-mb-bounded-inputs?
                      body-blocks
                      sphi
                      inputs
                      (- fuel 1))]
                  [_ false])])]))]
    [_ false]))

(define (opt-bce-mb-bounded-inputs?
  [body-blocks : ir.CompilerIrBlockList]
  [sphi : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [fuel : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-bounded-inputs?
        body-blocks
        sphi
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fuel)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (if (opt-bce-mb-bounded-value? body-blocks sphi value fuel)
        (opt-bce-mb-bounded-inputs? body-blocks sphi (__tl-box-place rest) fuel)
        false)]))

;; Multi-block recovery of the same canonical positive-step derived phi used
;; by single-block versioning. Its initializer comes from the loop preheader;
;; its back value may be defined in any loop block.
(define (opt-bce-mb-derived-induction
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [phi-var : i64]
  [inputs : ir.CompilerIrPhiInputList]) : OptBceDerivedInduction
  (match (opt-unroll-split-phi-inputs inputs latch)
    [(OptUnrollPhiSplit.No) (OptBceDerivedInduction.No)]
    [(OptUnrollPhiSplit.Split init back pred-label)
      (if (not (= pred-label preheader))
        (OptBceDerivedInduction.No)
        (match (opt-bce-mb-invariant-operand body-blocks defs init)
          [(ir.CompilerIrMaybeValue.No) (OptBceDerivedInduction.No)]
          [(ir.CompilerIrMaybeValue.Some invariant-init)
            (match back
              [(ir.CompilerIrValue.Var back-raw)
                (let
                  [back-var : i64 (opt-bce-mb-resolve body-blocks back-raw 16)]
                  (match (opt-bce-mb-find-def body-blocks back-var)
                    [(OptBceMbMaybeInstr.No) (OptBceDerivedInduction.No)]
                    [(OptBceMbMaybeInstr.Some instr)
                      (match instr
                        [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                          (match ty
                            [(ast.AstType.I64)
                              (match op
                                [(ir.CompilerIrBinOp.Add)
                                  (match (opt-affine-var-const lhs rhs)
                                    [(OptAffineOperands.Some src step)
                                      (if (and
                                        (> step 0)
                                        (=
                                          (opt-bce-mb-resolve
                                            body-blocks
                                            src
                                            16)
                                          phi-var))
                                        (OptBceDerivedInduction.Some
                                          invariant-init
                                          step)
                                        (OptBceDerivedInduction.No))]
                                    [(OptAffineOperands.No)
                                      (OptBceDerivedInduction.No)])]
                                [_ (OptBceDerivedInduction.No)])]
                            [_ (OptBceDerivedInduction.No)])]
                        [_ (OptBceDerivedInduction.No)])]))]
              [_ (OptBceDerivedInduction.No)])]))]))

;; Derive the sufficient invariant condition for one check's index operand.
;; Underivable checks kept in the fast clone, identified by (block label,
;; instruction index) -- both walks visit `shape body-blocks` in order, so the
;; pair is a stable identity between guard derivation and cloning.
(defenum OptBceMbKeepEntry
  (Entry i64 i64))

(defenum OptBceMbKeep
  (Nil)
  (Dense (__tl_dyn-array OptBceMbKeepEntry) i64))

(define (opt-bce-mb-keep-ref [keep : OptBceMbKeep] [index : i64]) : OptBceMbKeepEntry
  (match keep
    [(OptBceMbKeep.Nil) (OptBceMbKeepEntry.Entry -1 -1)]
    [(OptBceMbKeep.Dense items len) (array-ref items (- (- len 1) index))]))

(define (opt-bce-mb-keep-tail [keep : OptBceMbKeep]) : OptBceMbKeep
  (match keep
    [(OptBceMbKeep.Nil) (OptBceMbKeep.Nil)]
    [(OptBceMbKeep.Dense items len)
      (if (<= len 1)
        (OptBceMbKeep.Nil)
        (OptBceMbKeep.Dense items (- len 1)))]))

(define (opt-bce-mb-keep-cons [label : i64] [index : i64] [keep : OptBceMbKeep]) : OptBceMbKeep
  (let
    [entry : OptBceMbKeepEntry (OptBceMbKeepEntry.Entry label index)]
    (match keep
      [(OptBceMbKeep.Nil)
        (let
          [items : (__tl_dyn-array OptBceMbKeepEntry)
            (array.make-array OptBceMbKeepEntry 4)]
          (begin
            (set! (array-ref items 0) entry)
            (OptBceMbKeep.Dense items 1)))]
      [(OptBceMbKeep.Dense items len)
        (if (< len (array-length items))
          (begin
            (set! (array-ref items len) entry)
            (OptBceMbKeep.Dense items (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptBceMbKeepEntry)
              (array.make-array OptBceMbKeepEntry (opt-dense-next-capacity len))]
            [slot : i64 0]
            (begin
              (while (< slot len)
                (begin
                  (set! (array-ref bigger slot) (array-ref items slot))
                  (set! slot (+ slot 1))))
              (set! (array-ref bigger len) entry)
              (OptBceMbKeep.Dense bigger (+ len 1)))))])))

(define (opt-bce-mb-keep-contains?
  [keep : OptBceMbKeep]
  [label : i64]
  [index : i64]) : bool
  (match keep
    [(OptBceMbKeep.Nil) false]
    [(OptBceMbKeep.Dense _ _)
      (match (opt-bce-mb-keep-ref keep 0)
        [(OptBceMbKeepEntry.Entry item-label item-index)
          (if (and (= item-index index) (= item-label label))
            true
            (opt-bce-mb-keep-contains? (opt-bce-mb-keep-tail keep) label index))])]))

;; An index expression represented as either a literal or `base + offset`.
;; Opaque SSA definitions are valid bases: this recognizes both an explicit
;; `second = first - 1` chain and two expressions such as `sp - 1` / `sp - 2`
;; derived independently from the same base.
(defenum OptBceMbAffine
  (No)
  (Const i64)
  (Base i64 i64))

(define (opt-bce-mb-affine-add [value : OptBceMbAffine] [offset : i64]) : OptBceMbAffine
  (match value
    [(OptBceMbAffine.No) (OptBceMbAffine.No)]
    [(OptBceMbAffine.Const k) (OptBceMbAffine.Const (+ k offset))]
    [(OptBceMbAffine.Base base k) (OptBceMbAffine.Base base (+ k offset))]))

(define (opt-bce-mb-affine-value
  [body-blocks : ir.CompilerIrBlockList]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : OptBceMbAffine
  (match value
    [(ir.CompilerIrValue.I64 k) (OptBceMbAffine.Const k)]
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (if (<= fuel 0)
          (OptBceMbAffine.Base id 0)
          (match (opt-bce-mb-find-def body-blocks id)
            [(OptBceMbMaybeInstr.No) (OptBceMbAffine.Base id 0)]
            [(OptBceMbMaybeInstr.Some instr)
              (match instr
                [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                  (if (opt-affine-64bit-type? ty)
                    (match op
                      [(ir.CompilerIrBinOp.Add)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some src k)
                            (opt-bce-mb-affine-add
                              (opt-bce-mb-affine-value
                                body-blocks
                                (ir.CompilerIrValue.Var src)
                                (- fuel 1))
                              k)]
                          [(OptAffineOperands.No) (OptBceMbAffine.Base id 0)])]
                      [(ir.CompilerIrBinOp.Sub)
                        (match lhs
                          [(ir.CompilerIrValue.Var src)
                            (match rhs
                              [(ir.CompilerIrValue.I64 k)
                                (opt-bce-mb-affine-add
                                  (opt-bce-mb-affine-value
                                    body-blocks
                                    (ir.CompilerIrValue.Var src)
                                    (- fuel 1))
                                  (- 0 k))]
                              [_ (OptBceMbAffine.Base id 0)])]
                          [_ (OptBceMbAffine.Base id 0)])]
                      [_ (OptBceMbAffine.Base id 0)])
                    (OptBceMbAffine.Base id 0))]
                [_ (OptBceMbAffine.Base id 0)])])))]
    [_ (OptBceMbAffine.No)]))

(defenum OptBceMbAffinePair
  (No)
  (Some bool))

(define (opt-bce-mb-affine-pair
  [body-blocks : ir.CompilerIrBlockList]
  [first : ir.CompilerIrValue]
  [second : ir.CompilerIrValue]) : OptBceMbAffinePair
  (match (opt-bce-mb-affine-value body-blocks first 16)
    [(OptBceMbAffine.No) (OptBceMbAffinePair.No)]
    [(OptBceMbAffine.Const first-k)
      (match (opt-bce-mb-affine-value body-blocks second 16)
        [(OptBceMbAffine.Const second-k)
          (if (= (- second-k first-k) 1)
            (OptBceMbAffinePair.Some true)
            (if (= (- first-k second-k) 1)
              (OptBceMbAffinePair.Some false)
              (OptBceMbAffinePair.No)))]
        [_ (OptBceMbAffinePair.No)])]
    [(OptBceMbAffine.Base first-base first-k)
      (match (opt-bce-mb-affine-value body-blocks second 16)
        [(OptBceMbAffine.Base second-base second-k)
          (if (= first-base second-base)
            (if (= (- second-k first-k) 1)
              (OptBceMbAffinePair.Some true)
              (if (= (- first-k second-k) 1)
                (OptBceMbAffinePair.Some false)
                (OptBceMbAffinePair.No)))
            (OptBceMbAffinePair.No))]
        [_ (OptBceMbAffinePair.No)])]))

(defenum OptBceMbPairCandidate
  (No)
  (Some i64 bool ir.CompilerIrValue))

(define (opt-bce-mb-pair-barrier? [instr : ir.CompilerIrInstr]) : bool
  (or
    (ir.compiler-ir-effect-has-side-effect? (ir.compiler-ir-instr-effect instr))
    ;; SafeDiv/SafeMod and checked scalar shifts can abort even though their
    ;; value-producing effect class is Pure.
    (match instr
      [(ir.CompilerIrInstr.BinOp _ op _ _ _) (opt-binop-traps? op)]
      [_ false])))

;; Find the next check in this block. Reads and pure SSA calculations may sit
;; between a pair; a store, call, aborting operation, or control effect closes
;; the window. An intervening incompatible BoundsCheck also closes it because
;; that check is itself an observable trap point.
(define (opt-bce-mb-pair-next
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [first-index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]) : OptBceMbPairCandidate
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptBceMbPairCandidate.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.BoundsCheck next-index next-length _)
          (match (opt-bce-mb-invariant-operand body-blocks defs next-length)
            [(ir.CompilerIrMaybeValue.Some next-length-invariant)
              (if (opt-value-eq length next-length-invariant)
                (match (opt-bce-mb-affine-pair
                  body-blocks
                  first-index
                  next-index)
                  [(OptBceMbAffinePair.Some first-smaller)
                    (OptBceMbPairCandidate.Some index first-smaller next-index)]
                  [(OptBceMbAffinePair.No) (OptBceMbPairCandidate.No)])
                (OptBceMbPairCandidate.No))]
            [(ir.CompilerIrMaybeValue.No) (OptBceMbPairCandidate.No)])]
        [_
          (if (opt-bce-mb-pair-barrier? instr)
            (OptBceMbPairCandidate.No)
            (opt-bce-mb-pair-next
              instrs
              (+ index 1)
              body-blocks
              defs
              first-index
              length))]))))

;; --- late paired bounds checks -----------------------------------------------
;;
;; This rewrite deliberately runs only from the post-fixpoint program tail,
;; after scratch reset and immediately before late total-switch materialization.
;; At that point the exhaustive dispatch loop has its final CFG shape. Pairing
;; edits those blocks in place: it never invokes BCE, versions a loop, or clones
;; a block.
(defenum OptLateBoundsPairEntry
  (Entry i64 i64 i64 bool ir.CompilerIrValue))

(defenum OptLateBoundsPairPlan
  (Nil)
  (Dense (__tl_dyn-array OptLateBoundsPairEntry) i64))

(define (opt-late-bounds-pair-plan-ref
  [plans : OptLateBoundsPairPlan]
  [index : i64]) : OptLateBoundsPairEntry
  (match plans
    [(OptLateBoundsPairPlan.Nil)
      (OptLateBoundsPairEntry.Entry -1 -1 -1 false (ir.CompilerIrValue.I64 0))]
    [(OptLateBoundsPairPlan.Dense items len)
      (array-ref items (- (- len 1) index))]))

(define (opt-late-bounds-pair-plan-tail [plans : OptLateBoundsPairPlan]) : OptLateBoundsPairPlan
  (match plans
    [(OptLateBoundsPairPlan.Nil) (OptLateBoundsPairPlan.Nil)]
    [(OptLateBoundsPairPlan.Dense items len)
      (if (<= len 1)
        (OptLateBoundsPairPlan.Nil)
        (OptLateBoundsPairPlan.Dense items (- len 1)))]))

(define (opt-late-bounds-pair-plan-cons
  [label : i64]
  [first : i64]
  [second : i64]
  [first-smaller : bool]
  [second-value : ir.CompilerIrValue]
  [plans : OptLateBoundsPairPlan]) : OptLateBoundsPairPlan
  (let
    [entry : OptLateBoundsPairEntry
      (OptLateBoundsPairEntry.Entry
        label
        first
        second
        first-smaller
        second-value)]
    (match plans
      [(OptLateBoundsPairPlan.Nil)
        (let
          [items : (__tl_dyn-array OptLateBoundsPairEntry)
            (array.make-array OptLateBoundsPairEntry 4)]
          (begin
            (set! (array-ref items 0) entry)
            (OptLateBoundsPairPlan.Dense items 1)))]
      [(OptLateBoundsPairPlan.Dense items len)
        (if (< len (array-length items))
          (begin
            (set! (array-ref items len) entry)
            (OptLateBoundsPairPlan.Dense items (+ len 1)))
          (let
            [bigger : (__tl_dyn-array OptLateBoundsPairEntry)
              (array.make-array
                OptLateBoundsPairEntry
                (opt-dense-next-capacity len))]
            [slot : i64 0]
            (begin
              (while (< slot len)
                (begin
                  (set! (array-ref bigger slot) (array-ref items slot))
                  (set! slot (+ slot 1))))
              (set! (array-ref bigger len) entry)
              (OptLateBoundsPairPlan.Dense bigger (+ len 1)))))])))

(defenum OptLateBoundsPairAt
  (No)
  (First bool ir.CompilerIrValue)
  (Second))

(defstruct OptLateBoundsPairCollect
  (length ir.CompilerIrMaybeValue)
  (plans OptLateBoundsPairPlan)
  (count i64))

(defenum OptLateBoundsPairResult
  (No)
  (Some ir.CompilerIrBlockList i64))

(defenum OptLateBoundsPairPreheader
  (No)
  (Some ir.CompilerIrBlock))

(defenum OptLateBoundsPairSubst
  (Nil)
  (Cons i64 i64 i64 (Box OptLateBoundsPairSubst)))

;; Defs the walk deletes outright rather than renaming. The substituted second
;; chain keeps a replacement value, so its readers survive under a new name; a
;; reinterpret cast that fed only the replaced first check has no reader left at
;; all once the synthesized subtraction reads the cast's source instead.
(defstruct OptLateBoundsPairDrop
  (items opt_dense_i64_vec.Vec))

(define (opt-late-bounds-pair-drops-new) : OptLateBoundsPairDrop
  (OptLateBoundsPairDrop (opt_dense_i64_vec.with-capacity 4)))

(define (opt-late-bounds-pair-drops-add
  [drops : OptLateBoundsPairDrop (:consume)]
  [var : i64]) : OptLateBoundsPairDrop
  (let
    [items : opt_dense_i64_vec.Vec drops.items]
    (begin
      (opt_dense_i64_vec.push (&mut items) var)
      (OptLateBoundsPairDrop items))))

(define (opt-late-bounds-pair-selected-length?
  [selected : ir.CompilerIrMaybeValue]
  [length : ir.CompilerIrValue]) : bool
  (match selected
    [(ir.CompilerIrMaybeValue.No) true]
    [(ir.CompilerIrMaybeValue.Some found) (opt-value-eq found length)]))

(define (opt-late-bounds-pair-collect-block
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [state : OptLateBoundsPairCollect]) : OptLateBoundsPairCollect
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    state
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BoundsCheck first-index length _)
        (match (opt-bce-mb-invariant-operand body-blocks defs length)
          [(ir.CompilerIrMaybeValue.No)
            (opt-late-bounds-pair-collect-block
              label
              instrs
              (+ index 1)
              body-blocks
              defs
              state)]
          [(ir.CompilerIrMaybeValue.Some invariant-length)
            (if (not
              (opt-late-bounds-pair-selected-length?
                state.length
                invariant-length))
              (opt-late-bounds-pair-collect-block
                label
                instrs
                (+ index 1)
                body-blocks
                defs
                state)
              (match (opt-bce-mb-pair-next
                instrs
                (+ index 1)
                body-blocks
                defs
                first-index
                invariant-length)
                [(OptBceMbPairCandidate.No)
                  (opt-late-bounds-pair-collect-block
                    label
                    instrs
                    (+ index 1)
                    body-blocks
                    defs
                    state)]
                [(OptBceMbPairCandidate.Some second first-smaller second-value)
                  (opt-late-bounds-pair-collect-block
                    label
                    instrs
                    (+ second 1)
                    body-blocks
                    defs
                    (OptLateBoundsPairCollect
                      (ir.CompilerIrMaybeValue.Some invariant-length)
                      (opt-late-bounds-pair-plan-cons
                        label
                        index
                        second
                        first-smaller
                        second-value
                        state.plans)
                      (+ state.count 1)))]))])]
      [_
        (opt-late-bounds-pair-collect-block
          label
          instrs
          (+ index 1)
          body-blocks
          defs
          state)])))

(define (opt-late-bounds-pair-collect-blocks
  [remaining : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [state : OptLateBoundsPairCollect]) : OptLateBoundsPairCollect
  (match remaining
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-late-bounds-pair-collect-blocks
            (__tl-box-place rest)
            body-blocks
            defs
            (opt-late-bounds-pair-collect-block
              label
              instrs
              0
              body-blocks
              defs
              state))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-late-bounds-pair-collect-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        body-blocks
        defs
        state)]))

(define (opt-late-bounds-pair-at
  [plans : OptLateBoundsPairPlan]
  [label : i64]
  [index : i64]) : OptLateBoundsPairAt
  (match plans
    [(OptLateBoundsPairPlan.Nil) (OptLateBoundsPairAt.No)]
    [(OptLateBoundsPairPlan.Dense _ _)
      (match (opt-late-bounds-pair-plan-ref plans 0)
        [(OptLateBoundsPairEntry.Entry
            item-label
            first
            second
            first-smaller
            second-value)
          (if (and (= item-label label) (= index first))
            (OptLateBoundsPairAt.First first-smaller second-value)
            (if (and (= item-label label) (= index second))
              (OptLateBoundsPairAt.Second)
              (opt-late-bounds-pair-at
                (opt-late-bounds-pair-plan-tail plans)
                label
                index)))])]))

(define (opt-late-bounds-pair-subst-env [substs : OptLateBoundsPairSubst]) : OptCopyEnv
  (match substs
    [(OptLateBoundsPairSubst.Nil) (OptCopyEnv.Nil)]
    [(OptLateBoundsPairSubst.Cons raw resolved replacement rest)
      (let
        [tail : OptCopyEnv
          (opt-late-bounds-pair-subst-env (__tl-box-place rest))]
        (if (= raw resolved)
          (OptCopyEnv.Cons raw (ir.CompilerIrValue.Var replacement) (box tail))
          (OptCopyEnv.Cons
            raw
            (ir.CompilerIrValue.Var replacement)
            (box
              (OptCopyEnv.Cons
                resolved
                (ir.CompilerIrValue.Var replacement)
                (box tail))))))]))

(define (opt-late-bounds-pair-subst-def?
  [substs : OptLateBoundsPairSubst]
  [dst : i64]) : bool
  (match substs
    [(OptLateBoundsPairSubst.Nil) false]
    [(OptLateBoundsPairSubst.Cons raw resolved _ rest)
      (or
        (= dst raw)
        (= dst resolved)
        (opt-late-bounds-pair-subst-def? (__tl-box-place rest) dst))]))

(define (opt-late-bounds-pair-drop? [drops : OptLateBoundsPairDrop] [dst : i64]) : bool
  (let
    [items : opt_dense_i64_vec.Vec drops.items]
    [slots : (& items (__tl_dyn-array i64)) (opt_dense_i64_vec.slots (& items))]
    [index : i64 (- (opt_dense_i64_vec.len (& items)) 1)]
    [found? : bool false]
    (begin
      (while (and (not found?) (>= index 0))
        (begin
          (set! found? (= dst (array-ref slots index)))
          (set! index (- index 1))))
      found?)))

;; The first check's index operand is often a width-64 reinterpret cast of the
;; real counter. i64 and u64 share their representation, so the pair-min
;; subtraction may read the cast's source and let the backend fold `src - 1`
;; into one lea instead of staging the copy the cast lowers to. Bounded like the
;; other resolve helpers; any pending substitution applies at every step.
(define (opt-late-bounds-pair-cast-src
  [body-blocks : ir.CompilerIrBlockList]
  [env : OptCopyEnv]
  [value : ir.CompilerIrValue]
  [fuel : i64]) : ir.CompilerIrValue
  (if (<= fuel 0)
    value
    (match value
      [(ir.CompilerIrValue.Var var)
        (match (opt-bce-mb-find-def body-blocks var)
          [(OptBceMbMaybeInstr.No) value]
          [(OptBceMbMaybeInstr.Some instr)
            (match instr
              [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
                (if (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
                  (match src
                    [(ir.CompilerIrValue.Var _)
                      (opt-late-bounds-pair-cast-src
                        body-blocks
                        env
                        (opt-copy-resolve env src)
                        (- fuel 1))]
                    [_ value])
                  value)]
              [_ value])])]
      [_ value])))

;; Emit a single check at the first trap point. When the later operand is the
;; smaller one, materialize `first - 1` there, substitute it for the later
;; affine def chain, and drop that dead chain in the same walk. The combined
;; check therefore does not add per-iteration index arithmetic.
(define (opt-late-bounds-pair-rewrite-instrs
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [body-blocks : ir.CompilerIrBlockList]
  [plans : OptLateBoundsPairPlan]
  [short-length : ir.CompilerIrValue]
  [substs : OptLateBoundsPairSubst]
  [drops : OptLateBoundsPairDrop]
  [cell : (__tl_dyn-array i64)]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      [env : OptCopyEnv (opt-late-bounds-pair-subst-env substs)]
      (match (opt-late-bounds-pair-at plans label index)
        [(OptLateBoundsPairAt.Second)
          (opt-late-bounds-pair-rewrite-instrs
            label
            instrs
            (+ index 1)
            body-blocks
            plans
            short-length
            substs
            drops
            cell)]
        [(OptLateBoundsPairAt.First first-smaller second-value)
          (match instr
            [(ir.CompilerIrInstr.BoundsCheck first-index _ ok-label)
              (if first-smaller
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BoundsCheck
                    (opt-copy-resolve env first-index)
                    short-length
                    ok-label)
                  (opt-late-bounds-pair-rewrite-instrs
                    label
                    instrs
                    (+ index 1)
                    body-blocks
                    plans
                    short-length
                    substs
                    drops
                    cell))
                (match second-value
                  [(ir.CompilerIrValue.Var raw)
                    (let
                      [smaller : i64 (opt-bce-version-alloc-var cell)]
                      [resolved : i64 (opt-bce-mb-resolve body-blocks raw 16)]
                      [next-substs : OptLateBoundsPairSubst
                        (OptLateBoundsPairSubst.Cons
                          raw
                          resolved
                          smaller
                          (box substs))]
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.BinOp
                          smaller
                          (ir.CompilerIrBinOp.Sub)
                          (opt-late-bounds-pair-cast-src
                            body-blocks
                            env
                            (opt-copy-resolve env first-index)
                            4)
                          (ir.CompilerIrValue.I64 1)
                          (ast.AstType.I64))
                        (ir.compiler-ir-instr-cons
                          (ir.CompilerIrInstr.BoundsCheck
                            (ir.CompilerIrValue.Var smaller)
                            short-length
                            ok-label)
                          (opt-late-bounds-pair-rewrite-instrs
                            label
                            instrs
                            (+ index 1)
                            body-blocks
                            plans
                            short-length
                            next-substs
                            drops
                            cell))))]
                  [_
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BoundsCheck
                        second-value
                        short-length
                        ok-label)
                      (opt-late-bounds-pair-rewrite-instrs
                        label
                        instrs
                        (+ index 1)
                        body-blocks
                        plans
                        short-length
                        substs
                        drops
                        cell))]))]
            [_
              (ir.compiler-ir-instr-cons
                instr
                (opt-late-bounds-pair-rewrite-instrs
                  label
                  instrs
                  (+ index 1)
                  body-blocks
                  plans
                  short-length
                  substs
                  drops
                  cell))])]
        [(OptLateBoundsPairAt.No)
          (let
            [dst : i64 (ir.compiler-ir-instr-loop-dst-or instr (- 0 1))]
            (if (and
              (>= dst 0)
              (or
                (opt-late-bounds-pair-subst-def? substs dst)
                (opt-late-bounds-pair-drop? drops dst)))
              (opt-late-bounds-pair-rewrite-instrs
                label
                instrs
                (+ index 1)
                body-blocks
                plans
                short-length
                substs
                drops
                cell)
              (ir.compiler-ir-instr-cons
                (opt-copy-subst-instr env instr)
                (opt-late-bounds-pair-rewrite-instrs
                  label
                  instrs
                  (+ index 1)
                  body-blocks
                  plans
                  short-length
                  substs
                  drops
                  cell))))]))))

;; `len - zext(len >= 1)` is `len - 1` on the guarded path and zero when
;; len==0. Feeding that saturated short length to the replacement check is a
;; branch-free encoding of the raw `len >= 1` conjunct: no u64 index is below
;; zero, so the len==0 case still aborts. This lets the late pass establish the
;; fact once in the existing preheader without a slow-loop clone.
(define (opt-late-bounds-pair-preheader-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]
  [length : ir.CompilerIrValue]
  [nonempty : i64]
  [nonempty-i64 : i64]
  [short-length : i64]) : ir.CompilerIrInstrList
  (if (>= index last)
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.BinOp
        nonempty
        (ir.CompilerIrBinOp.Ge)
        length
        (ir.CompilerIrValue.I64 1)
        (ast.AstType.Bool))
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.Cast
          nonempty-i64
          (ir.CompilerIrValue.Var nonempty)
          (ast.AstType.Bool)
          (ast.AstType.I64))
        (ir.compiler-ir-instr-cons
          (ir.CompilerIrInstr.BinOp
            short-length
            (ir.CompilerIrBinOp.Sub)
            length
            (ir.CompilerIrValue.Var nonempty-i64)
            (ast.AstType.I64))
          (ir.compiler-ir-instr-cons
            (ir.compiler-ir-instr-seq-ref instrs last)
            (ir.CompilerIrInstrList.Nil)))))
    (ir.compiler-ir-instr-cons
      (ir.compiler-ir-instr-seq-ref instrs index)
      (opt-late-bounds-pair-preheader-instrs
        instrs
        (+ index 1)
        last
        length
        nonempty
        nonempty-i64
        short-length))))

(define (opt-late-bounds-pair-preheader
  [block : ir.CompilerIrBlock]
  [header : i64]
  [length : ir.CompilerIrValue]
  [nonempty : i64]
  [nonempty-i64 : i64]
  [short-length : i64]) : OptLateBoundsPairPreheader
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 1)
          (OptLateBoundsPairPreheader.No)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Jump target)
              (if (= target header)
                (OptLateBoundsPairPreheader.Some
                  (ir.compiler-ir-block
                    label
                    (opt-late-bounds-pair-preheader-instrs
                      instrs
                      0
                      (- count 1)
                      length
                      nonempty
                      nonempty-i64
                      short-length)))
                (OptLateBoundsPairPreheader.No))]
            [_ (OptLateBoundsPairPreheader.No)])))]))

(define (opt-late-bounds-pair-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [preheader-label : i64]
  [rewritten-preheader : ir.CompilerIrBlock]
  [plans : OptLateBoundsPairPlan]
  [short-length : ir.CompilerIrValue]
  [drops : OptLateBoundsPairDrop]
  [cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (if (= label preheader-label)
              rewritten-preheader
              (ir.compiler-ir-block
                label
                (opt-late-bounds-pair-rewrite-instrs
                  label
                  instrs
                  0
                  body-blocks
                  plans
                  short-length
                  (OptLateBoundsPairSubst.Nil)
                  drops
                  cell)))
            (opt-late-bounds-pair-rewrite-blocks
              (__tl-box-place rest)
              body-blocks
              preheader-label
              rewritten-preheader
              plans
              short-length
              drops
              cell))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-late-bounds-pair-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        body-blocks
        preheader-label
        rewritten-preheader
        plans
        short-length
        drops
        cell)]))

(define (opt-late-bounds-pair-use-count
  [uses : (__tl_dyn-array i64)]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length uses)))
    (- 0 1)
    (array-ref uses var)))

(define (opt-late-bounds-pair-reinterpret-def?
  [body-blocks : ir.CompilerIrBlockList]
  [var : i64]) : bool
  (match (opt-bce-mb-find-def body-blocks var)
    [(OptBceMbMaybeInstr.No) false]
    [(OptBceMbMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
          (and
            (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
            (match src
              [(ir.CompilerIrValue.Var _) true]
              [_ false]))]
        [_ false])]))

(define (opt-late-bounds-pair-check-index
  [body-blocks : ir.CompilerIrBlockList]
  [label : i64]
  [index : i64]) : ir.CompilerIrMaybeValue
  (match (opt-cfg-find-block body-blocks label)
    [(OptMaybeBlock.No) (ir.CompilerIrMaybeValue.No)]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (or
            (< index 0)
            (>= index (ir.compiler-ir-instr-seq-count instrs)))
            (ir.CompilerIrMaybeValue.No)
            (match (ir.compiler-ir-instr-seq-ref instrs index)
              [(ir.CompilerIrInstr.BoundsCheck first-index _ _)
                (ir.CompilerIrMaybeValue.Some first-index)]
              [_ (ir.CompilerIrMaybeValue.No)]))])]))

;; Nothing re-runs DCE after this pass, so a cast left with no reader still
;; lowers to a register copy. Collect the casts the rewrite strands: only the
;; `first-smaller = false` plans replace their first check, and only a cast
;; whose whole-function use census is exactly that one check is provably dead
;; afterwards. Any other reader keeps the def -- the subtraction still reads
;; through the cast, it just does not get to delete it.
(define (opt-late-bounds-pair-dead-cast-add
  [body-blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [label : i64]
  [first : i64]
  [first-smaller : bool]
  [acc : OptLateBoundsPairDrop (:consume)]) : OptLateBoundsPairDrop
  (if first-smaller
    acc
    (match (opt-late-bounds-pair-check-index body-blocks label first)
      [(ir.CompilerIrMaybeValue.No) acc]
      [(ir.CompilerIrMaybeValue.Some first-index)
        (match first-index
          [(ir.CompilerIrValue.Var var)
            (if (and
              (opt-late-bounds-pair-reinterpret-def? body-blocks var)
              (= (opt-late-bounds-pair-use-count uses var) 1))
              (opt-late-bounds-pair-drops-add acc var)
              acc)]
          [_ acc])])))

(define (opt-late-bounds-pair-dead-casts
  [body-blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [plans : OptLateBoundsPairPlan]
  [acc : OptLateBoundsPairDrop (:consume)]) : OptLateBoundsPairDrop
  (match plans
    [(OptLateBoundsPairPlan.Nil) acc]
    [(OptLateBoundsPairPlan.Dense _ _)
      (match (opt-late-bounds-pair-plan-ref plans 0)
        [(OptLateBoundsPairEntry.Entry label first _ first-smaller _)
          (opt-late-bounds-pair-dead-casts
            body-blocks
            uses
            (opt-late-bounds-pair-plan-tail plans)
            (opt-late-bounds-pair-dead-cast-add
              body-blocks
              uses
              label
              first
              first-smaller
              acc))])]))

(define (opt-late-bounds-pair-try-loop
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loop : OptNaturalLoop]) : OptLateBoundsPairResult
  (let
    [body-blocks : ir.CompilerIrBlockList (opt-natural-loop-body-blocks loop)]
    ;; Keep the late rewrite as narrow as the total-switch lesson: ordinary
    ;; loops retain byte-identical output, while the marked exhaustive dispatch
    ;; is handled just before its totality rewrite.
    (if (not (opt-bce-mb-body-has-total-enum-switch? body-blocks))
      (OptLateBoundsPairResult.No)
      (match (opt-natural-loop-preheader loop)
        [(OptLoopPreheader.No) (OptLateBoundsPairResult.No)]
        [(OptLoopPreheader.Some preheader-label)
          (let
            [defs : opt_i64_i64_map.Map
              (opt-bce-mb-collect-defs
                body-blocks
                (opt_i64_i64_map.with-capacity 64))]
            [collected : OptLateBoundsPairCollect
              (opt-late-bounds-pair-collect-blocks
                body-blocks
                body-blocks
                defs
                (OptLateBoundsPairCollect
                  (ir.CompilerIrMaybeValue.No)
                  (OptLateBoundsPairPlan.Nil)
                  0))]
            (if (= collected.count 0)
              (OptLateBoundsPairResult.No)
              (match collected.length
                [(ir.CompilerIrMaybeValue.No) (OptLateBoundsPairResult.No)]
                [(ir.CompilerIrMaybeValue.Some length)
                  (match (opt-cfg-find-block blocks preheader-label)
                    [(OptMaybeBlock.No) (OptLateBoundsPairResult.No)]
                    [(OptMaybeBlock.Some preheader)
                      (let
                        [drops : OptLateBoundsPairDrop
                          (opt-late-bounds-pair-dead-casts
                            body-blocks
                            (opt-collect-blocks-uses-array frame blocks)
                            collected.plans
                            (opt-late-bounds-pair-drops-new))]
                        (match (opt-late-bounds-pair-const-short-length length)
                          [(ir.CompilerIrMaybeValue.Some const-short-length)
                            (let
                              [cell : (__tl_dyn-array i64)
                                (array.make-array i64 1)]
                              [_cell : unit (set! (array-ref cell 0) frame)]
                              (OptLateBoundsPairResult.Some
                                (opt-late-bounds-pair-rewrite-blocks
                                  blocks
                                  body-blocks
                                  preheader-label
                                  preheader
                                  collected.plans
                                  const-short-length
                                  drops
                                  cell)
                                (array-ref cell 0)))]
                          [(ir.CompilerIrMaybeValue.No)
                            (let
                              [cell : (__tl_dyn-array i64)
                                (array.make-array i64 1)]
                              [_cell : unit (set! (array-ref cell 0) frame)]
                              [nonempty : i64 (opt-bce-version-alloc-var cell)]
                              [nonempty-i64 : i64
                                (opt-bce-version-alloc-var cell)]
                              [short-length : i64
                                (opt-bce-version-alloc-var cell)]
                              (match (opt-late-bounds-pair-preheader
                                preheader
                                (opt-natural-loop-header loop)
                                length
                                nonempty
                                nonempty-i64
                                short-length)
                                [(OptLateBoundsPairPreheader.No)
                                  (OptLateBoundsPairResult.No)]
                                [(OptLateBoundsPairPreheader.Some
                                    rewritten-preheader)
                                  (OptLateBoundsPairResult.Some
                                    (opt-late-bounds-pair-rewrite-blocks
                                      blocks
                                      body-blocks
                                      preheader-label
                                      rewritten-preheader
                                      collected.plans
                                      (ir.CompilerIrValue.Var short-length)
                                      drops
                                      cell)
                                    (array-ref cell 0))]))]))])])))]))))

;; A literal length needs no preheader arithmetic: `length - (length >= 1)` is a
;; compile-time constant, so the paired check takes it as an immediate and the
;; preheader keeps its original instruction sequence.
(define (opt-late-bounds-pair-const-short-length [length : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match length
    [(ir.CompilerIrValue.I64 count)
      (ir.CompilerIrMaybeValue.Some
        (ir.CompilerIrValue.I64
          (if (>= count 1)
            (- count 1)
            count)))]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-late-bounds-pair-scan-loops
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [loops : OptNaturalLoopList]) : OptLateBoundsPairResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptLateBoundsPairResult.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-late-bounds-pair-try-loop blocks frame loop)
        [(OptLateBoundsPairResult.Some next-blocks next-frame)
          (OptLateBoundsPairResult.Some next-blocks next-frame)]
        [(OptLateBoundsPairResult.No)
          (opt-late-bounds-pair-scan-loops blocks frame (__tl-box-place rest))])]))

(define (opt-late-bounds-pair-function-rewrite
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptLateRewriteResult
  ;; Late pass outside the verified fixpoint: scan first, and only when a
  ;; rewrite candidate exists pay for verification. Rejection keeps the input.
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (match (opt-late-bounds-pair-scan-loops
        blocks
        frame
        (opt-cfg-natural-loops blocks))
        [(OptLateBoundsPairResult.No) (OptLateRewriteResult.Result func false)]
        [(OptLateBoundsPairResult.Some next-blocks next-frame)
          (let
            [candidate : ir.CompilerIrFunction
              (ir.CompilerIrFunction.Function
                name
                params
                ret-ty
                next-frame
                (ir.compiler-ir-block-list-compact next-blocks))]
            ;; The rewrite extends the versioning guard's branch chain, so
            ;; the pre-rewrite CFG context does not describe the candidate;
            ;; verify against a fresh view and keep the input on rejection.
            (match (opt-verify-function candidate)
              [(ResultCompilerOptimizeVerify.Ok)
                (OptLateRewriteResult.Result
                  (compiler-opt-debug-observe-function
                    type-segment-bases
                    "paired_bounds"
                    candidate)
                  true)]
              [(ResultCompilerOptimizeVerify.Err _)
                (OptLateRewriteResult.Result func false)]))])]))

(define (opt-late-bounds-pair-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-late-bounds-pair-function-rewrite type-segment-bases func)
    [(OptLateRewriteResult.Result rewritten _) rewritten]))

;; Length-relation conjuncts the cross-array fusion derivation has already put
;; in the guard, so a second fused check over the same pair of arrays reuses
;; the conjunct instead of adding a duplicate compare. Physical pushes replace
;; the old Cons/prepend operation; logical readers walk newest-first.
(defstruct OptBceMbFusedPair
  (lhs ir.CompilerIrValue)
  (rhs ir.CompilerIrValue))

(import (vector.vector OptBceMbFusedPair core) as opt_bce_mb_fused_vec)

(defstruct OptBceMbFused
  (items opt_bce_mb_fused_vec.Vec))

(define (opt-bce-mb-fused-new) : OptBceMbFused
  (OptBceMbFused (opt_bce_mb_fused_vec.with-capacity 4)))

(define (opt-bce-mb-fused-count [fused : OptBceMbFused]) : i64
  (opt_bce_mb_fused_vec.len (& fused.items)))

(define (opt-bce-mb-fused-ref [fused : OptBceMbFused] [index : i64]) : OptBceMbFusedPair
  (let
    [items : opt_bce_mb_fused_vec.Vec fused.items]
    (array-ref
      (opt_bce_mb_fused_vec.slots (& items))
      (- (- (opt_bce_mb_fused_vec.len (& items)) index) 1))))

;; Derivation fold state: the guard accumulator (conditions for REMOVED
;; checks), the kept-check set, how many checks derived -- partial
;; versioning requires at least one derivable check to make cloning pay --
;; the descriptor-length hoists already emitted into the guard, and the
;; fusion length-relation conjuncts already emitted.
(defstruct OptBceMbDerive
  (guard OptBceVersionGuardAcc)
  (keep OptBceMbKeep)
  (derived i64)
  (hoists OptBceMbHoists)
  (fused OptBceMbFused))

;; guard-conds output: the guard instructions + value, the kept-check set the
;; clone must preserve (remapped) instead of dropping, and the facts the guard
;; proves for every block of the fast clone (see the compare-folding section).
(defenum OptBceMbGuardOut
  (No)
  (Some ir.CompilerIrInstrSeq ir.CompilerIrValue OptBceMbKeep OptBceFoldFacts))

;; A multi-block index of the form `base + scale*counter + offset` (either
;; operand order): one Add operand recovers counter-affine with a positive
;; literal scale and a literal offset, the other resolves to a loop-invariant
;; value -- the `text[start + i]` byte-loop idiom (scale 1) and its strided
;; CSR/word cousins (scale > 1). The invariant base rides along because the
;; guard must reference the RESOLVED definition that dominates the loop entry
;; edge.
(defenum OptBceCounterAffineBase
  (No)
  ;; literal scale, literal offset, invariant base value
  (Some i64 i64 ir.CompilerIrValue))

;; One Add side as the counter-affine part, the other as the invariant base.
;; Exactly one side may involve the counter: an in-loop base fails the
;; invariant-operand check. Scale 1 keeps the division-free
;; opt-bce-version-var-base-guard; larger scales route to the synthesized
;; derived-seed guard at the dispatch site.
(define (opt-bce-mb-var-base-side
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [iphi : i64]
  [affine-side : ir.CompilerIrValue]
  [base-side : ir.CompilerIrValue]) : OptBceCounterAffineBase
  (match (opt-bce-mb-counter-affine body-blocks iphi affine-side 16)
    [(OptBceCounterAffine.No) (OptBceCounterAffineBase.No)]
    [(OptBceCounterAffine.Some scale offset)
      (if (< scale 1)
        (OptBceCounterAffineBase.No)
        (match (opt-bce-mb-invariant-operand body-blocks defs base-side)
          [(ir.CompilerIrMaybeValue.No) (OptBceCounterAffineBase.No)]
          [(ir.CompilerIrMaybeValue.Some base)
            (OptBceCounterAffineBase.Some scale offset base)]))]))

;; Try either operand order: `counter... + base` and `base + counter...`.
(define (opt-bce-mb-var-base-add
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [iphi : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptBceCounterAffineBase
  (match (opt-bce-mb-var-base-side body-blocks defs iphi lhs rhs)
    [(OptBceCounterAffineBase.Some scale offset base)
      (OptBceCounterAffineBase.Some scale offset base)]
    [(OptBceCounterAffineBase.No)
      (opt-bce-mb-var-base-side body-blocks defs iphi rhs lhs)]))

;; Multi-block counterpart of opt-bce-version-strided-peel: peel literal
;; Add/Sub addends off an index expression across the loop's blocks,
;; returning the remaining core variable and the accumulated literal.
;; Peeling stops at the first definition that is not a literal addend link
;; (a var+var Add, a phi, a load, ...); a non-variable expression rejects.
;; The word-loader fan `((start + i) + k)` is the shape this exists for:
;; without the peel only the k = 0 fan member's index derives.
(define (opt-bce-mb-strided-peel
  [body-blocks : ir.CompilerIrBlockList]
  [value : ir.CompilerIrValue]
  [k : i64]
  [fuel : i64]) : OptBceVersionStridedCore
  (match value
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (if (<= fuel 0)
          (OptBceVersionStridedCore.Some id k)
          (match (opt-bce-mb-find-def body-blocks id)
            [(OptBceMbMaybeInstr.No) (OptBceVersionStridedCore.Some id k)]
            [(OptBceMbMaybeInstr.Some instr)
              (match instr
                [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                  (if (not (opt-affine-64bit-type? ty))
                    (OptBceVersionStridedCore.Some id k)
                    (match op
                      [(ir.CompilerIrBinOp.Add)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some src c)
                            (match (opt-bce-version-k-add k c)
                              [(OptBceVersionKSum.No)
                                (OptBceVersionStridedCore.No)]
                              [(OptBceVersionKSum.Some next)
                                (opt-bce-mb-strided-peel
                                  body-blocks
                                  (ir.CompilerIrValue.Var src)
                                  next
                                  (- fuel 1))])]
                          [(OptAffineOperands.No)
                            (OptBceVersionStridedCore.Some id k)])]
                      [(ir.CompilerIrBinOp.Sub)
                        (match lhs
                          [(ir.CompilerIrValue.Var src)
                            (match rhs
                              [(ir.CompilerIrValue.I64 c)
                                (if (= c (- (- 0 9223372036854775807) 1))
                                  (OptBceVersionStridedCore.Some id k)
                                  (match (opt-bce-version-k-add k (- 0 c))
                                    [(OptBceVersionKSum.No)
                                      (OptBceVersionStridedCore.No)]
                                    [(OptBceVersionKSum.Some next)
                                      (opt-bce-mb-strided-peel
                                        body-blocks
                                        (ir.CompilerIrValue.Var src)
                                        next
                                        (- fuel 1))]))]
                              [_ (OptBceVersionStridedCore.Some id k)])]
                          [_ (OptBceVersionStridedCore.Some id k)])]
                      [_ (OptBceVersionStridedCore.Some id k)]))]
                [_ (OptBceVersionStridedCore.Some id k)])])))]
    [_ (OptBceVersionStridedCore.No)]))

;; Descriptor-length recognition context: the type-pool segment bases, the
;; per-function descriptor-handle set they classify (the load-GVN/LICM header
;; classification), and the per-callee `direct-call-clean` bit map the loop-BCE
;; summaries built. (No) disables the descriptor-length path entirely -- test
;; entries without type-pool access take it, and recognition then stays off
;; exactly as before.
(defenum OptBceMbDescriptor
  (No)
  (Some i64 OptLoadHeaderSet opt_i64_i64_map.Map))

;; Hoisted descriptor loads emitted into the guard, shared across checks.
;; `kind` distinguishes the two things a key names:
;;
;;   VAR   (opt-bce-mb-hoist-kind-var)   key = the descriptor handle's var
;;   ROOT  (opt-bce-mb-hoist-kind-root)  key = a module global's symbol id
;;
;; A VAR entry is one hoisted `gep base, offset` + `load` pair reading a word
;; out of a handle the loop did not define. A ROOT entry is the pair that
;; RECOVERS such a handle out of a module global's cell, for the chains a loop
;; reloads per iteration (`gep @g, k` / `load`). Both are keyed by
;; (kind, key, offset) so a repeated chain is emitted into the guard once.
(defenum OptBceMbHoists
  (Nil)
  (Cons i64 i64 i64 i64 (Box OptBceMbHoists)))

(define (opt-bce-mb-hoist-kind-var) : i64
  0)

(define (opt-bce-mb-hoist-kind-root) : i64
  1)

(define (opt-bce-mb-hoists-lookup
  [hoists : OptBceMbHoists]
  [kind : i64]
  [key : i64]
  [offset : i64]) : i64
  (match hoists
    [(OptBceMbHoists.Nil) (- 0 1)]
    [(OptBceMbHoists.Cons item-kind item-key item-offset load-var rest)
      (if (and (= item-kind kind) (= item-key key) (= item-offset offset))
        load-var
        (opt-bce-mb-hoists-lookup (__tl-box-place rest) kind key offset))]))

;; Can any instruction of these loop blocks change a DESCRIPTOR word -- a
;; descriptor header slot, or the global cell a handle lives in -- that a load
;; outside the loop has already read? That is the one question the guard's
;; hoisted length loads ask of the body.
;;
;; The old answer was the load_combine "writes memory at all" classification --
;; stores, calls, syscalls, vector/predicated stores -- which is sound but
;; answers a strictly bigger question, so a single cold call anywhere in the
;; body refused every descriptor length in it. A DIRECT call has a per-callee
;; answer to the REAL question, in the `direct-call-clean` bits the loop-BCE
;; summaries already build:
;;
;;   memory-clean (bit 0)   writes nothing at all, so nothing of any class
;;   element-only (bit 2)   every write it makes lands in the element storage a
;;                          descriptor's data slot names -- a different
;;                          allocation from the descriptor that names it, and
;;                          never a symbol's own global cell (see
;;                          opt-call-memory-element-bit for the layering
;;                          argument, and opt-loop-bce-direct-call-clean-bits
;;                          for why the bit needs `has-param-writes?` clear)
;;
;; Either bit makes the call unable to move a descriptor word, whatever the
;; caller passed it: neither verdict depends on the argument list, so no
;; GlobalAddr-style call-site gate is needed here. Everything else -- an
;; unresolved or memory-writing direct callee, any indirect/C-ABI/SPMD call,
;; every store, every vector write -- keeps the old blanket refusal. So this can
;; only ADMIT loops the write-free test already refused; it can never admit a
;; body the write-free test accepted and this one would not.
;;
;; This is an INVARIANCE fact only. It licenses reading a descriptor word once
;; in the guard instead of once per iteration; it moves no store, no call, and
;; no check.
(define (opt-bce-mb-call-descriptor-stable?
  [descriptor : OptBceMbDescriptor]
  [name : i64]) : bool
  (match descriptor
    [(OptBceMbDescriptor.No) false]
    [(OptBceMbDescriptor.Some _ _ direct-call-clean)
      (opt-direct-call-clean-has-bit?
        direct-call-clean
        name
        (bit-or
          (opt-direct-call-clean-memory-bit)
          (opt-direct-call-clean-unconditional-global-bit)))]))

(define (opt-bce-mb-stable-instr?
  [descriptor : OptBceMbDescriptor]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ name _ _)
      (opt-bce-mb-call-descriptor-stable? descriptor name)]
    [(ir.CompilerIrInstr.TailCall name _ _)
      (opt-bce-mb-call-descriptor-stable? descriptor name)]
    [_ (not (opt-load-combine-may-write? instr))]))

(define (opt-bce-mb-stable-instrs?
  [descriptor : OptBceMbDescriptor]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (if (opt-bce-mb-stable-instr?
      descriptor
      (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-bce-mb-stable-instrs? descriptor instrs (+ index 1))
      false)))

(define (opt-bce-mb-stable-blocks?
  [descriptor : OptBceMbDescriptor]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-bce-mb-stable-instrs? descriptor instrs 0)
            (opt-bce-mb-stable-blocks? descriptor (__tl-box-place rest))
            false)])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-stable-blocks?
        descriptor
        (ir.compiler-ir-block-seq-to-list seq))]))

;; The descriptor-length derivation result: the length value the guard
;; references (a hoisted load), the updated hoist set, and the guard
;; accumulator with the hoisted gep+load pair consed on.
(defenum OptBceMbMaybeLength
  (No)
  (Some ir.CompilerIrValue OptBceMbHoists OptBceVersionGuardAcc))

;; Where the guard gets the descriptor HANDLE a length load reads through: the
;; base var itself, or a hoisted recovery of it.
(defenum OptBceMbMaybeBase
  (No)
  (Some i64 OptBceMbHoists OptBceVersionGuardAcc))

;; The handle a length load's `Gep` is rooted at, made available in the guard.
;;
;; The easy case is a base the loop does NOT define: the guard block dominates
;; the loop, so the var is already in scope there and nothing is emitted.
;;
;; The case this exists for is the one a workspace of module globals produces on
;; every iteration:
;;
;;     %h  = gep @g, k      ;; the cell's address
;;     %d  = load %h        ;; the descriptor handle living in that cell
;;     %o  = gep %d, 1
;;     %n  = load %o        ;; the length
;;
;; `%d` is a loop def, so the old test refused the whole chain and every check
;; against `%n` stayed. But the loop defines `%d` only because it RELOADS it:
;; the value is the global cell's content, and opt-bce-mb-stable-blocks? has
;; already proved that nothing the loop executes can write a global cell (or a
;; descriptor word). So the guard may recover the handle itself, once, with the
;; same two instructions, and every iteration's `%d` equals it.
;;
;; SAFETY OF THE HOISTED RECOVERY. `gep @g, k` is a symbol address, and the load
;; through it reads the global's own storage -- always mapped, whatever path
;; through the loop would have been taken. The handle it yields is then a live
;; descriptor for the same reason the second load's is: the type says so, and a
;; dangling handle is already UB. This is the argument the LICM `Global` operand
;; promotion makes for reading a cell in the preheader; the versioner makes it
;; in the guard, which the fast clone alone is entered from.
;;
;; Only a GLOBAL-rooted chain is recovered. A base the loop computes any other
;; way (an element read, an arithmetic address) is refused exactly as before:
;; the recovery has to be a re-execution of instructions whose result cannot
;; depend on where in the loop they run, and a symbol address plus a cell read
;; that no body instruction can write is the one such chain.
(define (opt-bce-mb-descriptor-base
  [defs : opt_i64_i64_map.Map]
  [all-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [base-id : i64]
  [hoists : OptBceMbHoists]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceMbMaybeBase
  (if (not (opt-used-contains defs base-id))
    (OptBceMbMaybeBase.Some base-id hoists acc)
    (match (opt-bce-mb-find-def all-blocks base-id)
      [(OptBceMbMaybeInstr.No) (OptBceMbMaybeBase.No)]
      [(OptBceMbMaybeInstr.Some base-instr)
        (match base-instr
          [(ir.CompilerIrInstr.Load _ handle-src handle-ty)
            (match handle-src
              [(ir.CompilerIrValue.Var handle-raw)
                (match (opt-bce-mb-find-def
                  all-blocks
                  (opt-bce-mb-resolve body-blocks handle-raw 16))
                  [(OptBceMbMaybeInstr.No) (OptBceMbMaybeBase.No)]
                  [(OptBceMbMaybeInstr.Some cell-instr)
                    (match cell-instr
                      [(ir.CompilerIrInstr.Gep _ cell-base cell-off cell-ty)
                        (match cell-base
                          [(ir.CompilerIrValue.Global sym)
                            (match cell-off
                              [(ir.CompilerIrValue.I64 off)
                                (opt-bce-mb-descriptor-root-hoist
                                  (ir.compiler-ir-symbol-id sym)
                                  cell-base
                                  cell-off
                                  off
                                  cell-ty
                                  handle-ty
                                  hoists
                                  cell
                                  acc)]
                              [_ (OptBceMbMaybeBase.No)])]
                          [_ (OptBceMbMaybeBase.No)])]
                      [_ (OptBceMbMaybeBase.No)])])]
              [_ (OptBceMbMaybeBase.No)])]
          [_ (OptBceMbMaybeBase.No)])])))

;; Emit (or reuse) the guard's `gep @g, k` + `load` pair recovering one
;; global-held descriptor handle.
(define (opt-bce-mb-descriptor-root-hoist
  [sym-id : i64]
  [cell-base : ir.CompilerIrValue]
  [cell-off : ir.CompilerIrValue]
  [off : i64]
  [cell-ty : ast.AstType]
  [handle-ty : ast.AstType]
  [hoists : OptBceMbHoists]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceMbMaybeBase
  (let
    [shared : i64
      (opt-bce-mb-hoists-lookup hoists (opt-bce-mb-hoist-kind-root) sym-id off)]
    (if (>= shared 0)
      (OptBceMbMaybeBase.Some shared hoists acc)
      (match acc
        [(OptBceVersionGuardAcc.No) (OptBceMbMaybeBase.No)]
        [(OptBceVersionGuardAcc.Some instrs values counter-seen)
          (let
            [gep-var : i64 (opt-bce-version-alloc-var cell)]
            [load-var : i64 (opt-bce-version-alloc-var cell)]
            (OptBceMbMaybeBase.Some
              load-var
              (OptBceMbHoists.Cons
                (opt-bce-mb-hoist-kind-root)
                sym-id
                off
                load-var
                (box hoists))
              (OptBceVersionGuardAcc.Some
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Load
                    load-var
                    (ir.CompilerIrValue.Var gep-var)
                    handle-ty)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.Gep gep-var cell-base cell-off cell-ty)
                    instrs))
                values
                counter-seen)))]))))

;; A non-invariant check length may still be a descriptor length-slot load:
;; it resolves to `Load (Gep base, length-slot)` where base is an array/string
;; descriptor handle the guard can name (see opt-bce-mb-descriptor-base). When
;; no loop block can change a descriptor word the loaded value cannot change
;; mid-loop, so the guard may reference ONE hoisted gep+load pair per distinct
;; (base, offset), emitted into the guard block: reading a live descriptor's
;; length slot is always safe (a dangling handle is already UB), and the hoisted
;; value equals every in-iteration load. The pair is consed onto the accumulator
;; BEFORE the conditions that consume it so the final reversal emits it first --
;; and after any root recovery the base needed, which is consed first for the
;; same reason.
(define (opt-bce-mb-descriptor-length
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [all-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [length-value : ir.CompilerIrValue]
  [hoists : OptBceMbHoists]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceMbMaybeLength
  (if (not stable?)
    (OptBceMbMaybeLength.No)
    (match acc
      [(OptBceVersionGuardAcc.No) (OptBceMbMaybeLength.No)]
      [(OptBceVersionGuardAcc.Some _ _ _)
        (match descriptor
          [(OptBceMbDescriptor.No) (OptBceMbMaybeLength.No)]
          [(OptBceMbDescriptor.Some type-segment-bases header-set _)
            (match length-value
              [(ir.CompilerIrValue.Var raw)
                (let
                  [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
                  (match (opt-bce-mb-find-def all-blocks id)
                    [(OptBceMbMaybeInstr.No) (OptBceMbMaybeLength.No)]
                    [(OptBceMbMaybeInstr.Some instr)
                      (match instr
                        [(ir.CompilerIrInstr.Load _ src load-ty)
                          (match load-ty
                            [(ast.AstType.I64)
                              (match src
                                [(ir.CompilerIrValue.Var src-raw)
                                  (let
                                    [src-id : i64
                                      (opt-bce-mb-resolve
                                        body-blocks
                                        src-raw
                                        16)]
                                    (match (opt-bce-mb-find-def
                                      all-blocks
                                      src-id)
                                      [(OptBceMbMaybeInstr.No)
                                        (OptBceMbMaybeLength.No)]
                                      [(OptBceMbMaybeInstr.Some gep-instr)
                                        (match gep-instr
                                          [(ir.CompilerIrInstr.Gep
                                              _
                                              base
                                              offset
                                              gep-ty)
                                            (match base
                                              [(ir.CompilerIrValue.Var base-raw)
                                                (match offset
                                                  [(ir.CompilerIrValue.I64 off)
                                                    (let
                                                      [base-id : i64
                                                        (opt-bce-mb-resolve
                                                          body-blocks
                                                          base-raw
                                                          16)]
                                                      (if (or
                                                        (not
                                                          (opt-load-header-var?
                                                            header-set
                                                            base-id))
                                                        (not
                                                          (opt-bounds-object-length-slot?
                                                            type-segment-bases
                                                            offset
                                                            gep-ty)))
                                                        (OptBceMbMaybeLength.No)
                                                        (match (opt-bce-mb-descriptor-base
                                                          defs
                                                          all-blocks
                                                          body-blocks
                                                          base-id
                                                          hoists
                                                          cell
                                                          acc)
                                                          [(OptBceMbMaybeBase.No)
                                                            (OptBceMbMaybeLength.No)]
                                                          [(OptBceMbMaybeBase.Some
                                                              guard-base
                                                              base-hoists
                                                              base-acc)
                                                            (let
                                                              [shared : i64
                                                                (opt-bce-mb-hoists-lookup
                                                                  base-hoists
                                                                  (opt-bce-mb-hoist-kind-var)
                                                                  guard-base
                                                                  off)]
                                                              (if (>= shared 0)
                                                                (OptBceMbMaybeLength.Some
                                                                  (ir.CompilerIrValue.Var
                                                                    shared)
                                                                  base-hoists
                                                                  base-acc)
                                                                (opt-bce-mb-descriptor-hoist
                                                                  guard-base
                                                                  offset
                                                                  gep-ty
                                                                  load-ty
                                                                  base-hoists
                                                                  cell
                                                                  base-acc)))])))]
                                                  [_ (OptBceMbMaybeLength.No)])]
                                              [_ (OptBceMbMaybeLength.No)])]
                                          [_ (OptBceMbMaybeLength.No)])]))]
                                [_ (OptBceMbMaybeLength.No)])]
                            [_ (OptBceMbMaybeLength.No)])]
                        [_ (OptBceMbMaybeLength.No)])]))]
              [_ (OptBceMbMaybeLength.No)])])])))

;; Emit the hoisted gep+load pair for a (base, offset) pair seen for the
;; first time.
(define (opt-bce-mb-descriptor-hoist
  [base-id : i64]
  [offset : ir.CompilerIrValue]
  [gep-ty : ast.AstType]
  [load-ty : ast.AstType]
  [hoists : OptBceMbHoists]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceMbMaybeLength
  (match acc
    [(OptBceVersionGuardAcc.No) (OptBceMbMaybeLength.No)]
    [(OptBceVersionGuardAcc.Some instrs values counter-seen)
      (let
        [gep-var : i64 (opt-bce-version-alloc-var cell)]
        [load-var : i64 (opt-bce-version-alloc-var cell)]
        (match offset
          [(ir.CompilerIrValue.I64 off)
            (OptBceMbMaybeLength.Some
              (ir.CompilerIrValue.Var load-var)
              (OptBceMbHoists.Cons
                (opt-bce-mb-hoist-kind-var)
                base-id
                off
                load-var
                (box hoists))
              (OptBceVersionGuardAcc.Some
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Load
                    load-var
                    (ir.CompilerIrValue.Var gep-var)
                    load-ty)
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.Gep
                      gep-var
                      (ir.CompilerIrValue.Var base-id)
                      offset
                      gep-ty)
                    instrs))
                values
                counter-seen))]
          [_ (OptBceMbMaybeLength.No)]))]))

(define (opt-bce-mb-derive-index
  [all-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [index-value : ir.CompilerIrValue]
  [length-value : ir.CompilerIrValue]
  [fan : OptBceVersionFan]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (match index-value
    [(ir.CompilerIrValue.I64 k)
      (if (>= k 0)
        (opt-bce-version-cond
          cell
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.I64 k)
          length-value
          acc)
        (OptBceVersionGuardAcc.No))]
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (cond
          [(= id iphi)
            ;; counter: [seed, bound) subset of [0, len) iff seed >= 0
            ;; (emitted once at the end) and bound <= len.
            (opt-bce-version-cond-counter-seen
              (opt-bce-version-cond
                cell
                (ir.CompilerIrBinOp.Le)
                bound
                length-value
                acc))]
          [(not (opt-used-contains defs id))
            ;; loop-invariant index: exactly its own range check, hoisted.
            (opt-bce-version-cond
              cell
              (ir.CompilerIrBinOp.Lt)
              (ir.CompilerIrValue.Var id)
              length-value
              (opt-bce-version-cond
                cell
                (ir.CompilerIrBinOp.Ge)
                (ir.CompilerIrValue.Var id)
                (ir.CompilerIrValue.I64 0)
                acc))]
          [else
            (match (opt-bce-mb-find-def body-blocks id)
              [(OptBceMbMaybeInstr.No) (OptBceVersionGuardAcc.No)]
              [(OptBceMbMaybeInstr.Some instr)
                (match instr
                  [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
                    (match op
                      [(ir.CompilerIrBinOp.BitAnd)
                        (match (opt-affine-var-const lhs rhs)
                          [(OptAffineOperands.Some _ m)
                            (if (>= m 0)
                              ;; masked index: in [0, m] whatever the source.
                              (opt-bce-version-cond
                                cell
                                (ir.CompilerIrBinOp.Lt)
                                (ir.CompilerIrValue.I64 m)
                                length-value
                                acc)
                              (OptBceVersionGuardAcc.No))]
                          [(OptAffineOperands.No) (OptBceVersionGuardAcc.No)])]
                      [_
                        (match (opt-bce-mb-counter-affine
                          body-blocks
                          iphi
                          (ir.CompilerIrValue.Var id)
                          16)
                          [(OptBceCounterAffine.No)
                            ;; A var+var Add (possibly under peeled literal
                            ;; addends) defeats the literal-coefficient
                            ;; recovery: retry as `base + strided + k` with a
                            ;; loop-invariant variable base.
                            (match (opt-bce-mb-strided-peel
                              body-blocks
                              (ir.CompilerIrValue.Var id)
                              0
                              8)
                              [(OptBceVersionStridedCore.No)
                                (OptBceVersionGuardAcc.No)]
                              [(OptBceVersionStridedCore.Some core k0)
                                (match (opt-bce-mb-find-def body-blocks core)
                                  [(OptBceMbMaybeInstr.No)
                                    (OptBceVersionGuardAcc.No)]
                                  [(OptBceMbMaybeInstr.Some core-instr)
                                    (match core-instr
                                      [(ir.CompilerIrInstr.BinOp
                                          _
                                          core-op
                                          core-lhs
                                          core-rhs
                                          core-ty)
                                        (if (not
                                          (opt-affine-64bit-type? core-ty))
                                          (OptBceVersionGuardAcc.No)
                                          (match core-op
                                            [(ir.CompilerIrBinOp.Add)
                                              (match (opt-bce-mb-var-base-add
                                                body-blocks
                                                defs
                                                iphi
                                                core-lhs
                                                core-rhs)
                                                [(OptBceCounterAffineBase.No)
                                                  (OptBceVersionGuardAcc.No)]
                                                [(OptBceCounterAffineBase.Some
                                                    scale
                                                    k2
                                                    base)
                                                  (match (opt-bce-version-k-add
                                                    k0
                                                    k2)
                                                    [(OptBceVersionKSum.No)
                                                      (OptBceVersionGuardAcc.No)]
                                                    [(OptBceVersionKSum.Some
                                                        offset)
                                                      (if (= scale 1)
                                                        ;; Fan member: record
                                                        ;; (base, length, k);
                                                        ;; the flush emits the
                                                        ;; extremal conditions.
                                                        (opt-bce-version-fan-admit
                                                          fan
                                                          seed
                                                          bound
                                                          base
                                                          offset
                                                          length-value
                                                          cell
                                                          acc)
                                                        ;; Strided variable
                                                        ;; base: the guard
                                                        ;; synthesizes the
                                                        ;; derived seed and
                                                        ;; reuses the
                                                        ;; positive-step
                                                        ;; quotient.
                                                        (opt-bce-version-var-base-scaled-guard
                                                          seed
                                                          bound
                                                          base
                                                          scale
                                                          offset
                                                          length-value
                                                          cell
                                                          acc))])])]
                                            [_ (OptBceVersionGuardAcc.No)]))]
                                      [_ (OptBceVersionGuardAcc.No)])])])]
                          [(OptBceCounterAffine.Some scale offset)
                            (opt-bce-version-affine-guard
                              seed
                              bound
                              length-value
                              scale
                              offset
                              cell
                              acc)])])]
                  [(ir.CompilerIrInstr.Phi _ inputs pty)
                    ;; Bounded header phi (only header phis carry latch-edge
                    ;; inputs): same seed as the counter, back-edge value
                    ;; within {sphi, sphi+1} through any merge. The counter's
                    ;; conditions then cover its whole range.
                    (match pty
                      [(ast.AstType.I64)
                        (match (opt-unroll-split-phi-inputs inputs latch)
                          [(OptUnrollPhiSplit.Split init back pred-label)
                            (if (and
                              (= pred-label preheader)
                              (opt-bce-mb-seeds-match? all-blocks seed init)
                              (opt-bce-mb-bounded-value? body-blocks id back 8))
                              (opt-bce-version-cond-counter-seen
                                (opt-bce-version-cond
                                  cell
                                  (ir.CompilerIrBinOp.Le)
                                  bound
                                  length-value
                                  acc))
                              (match (opt-bce-mb-derived-induction
                                body-blocks
                                defs
                                latch
                                preheader
                                id
                                inputs)
                                [(OptBceDerivedInduction.No)
                                  (OptBceVersionGuardAcc.No)]
                                [(OptBceDerivedInduction.Some derived-seed step)
                                  (opt-bce-version-derived-guard
                                    seed
                                    bound
                                    derived-seed
                                    step
                                    length-value
                                    cell
                                    acc)]))]
                          [(OptUnrollPhiSplit.No) (OptBceVersionGuardAcc.No)])]
                      [_ (OptBceVersionGuardAcc.No)])]
                  [_ (OptBceVersionGuardAcc.No)])])]))]
    [_ (OptBceVersionGuardAcc.No)]))

;; --- cross-array check-domain fusion -----------------------------------------
;;
;; Every derivation above reasons about ONE array: it recovers the index from
;; the loop's counter and asks the guard for a relation between the trip range
;; and THAT array's length. A loop nest that walks several arrays through the
;; same opaque index -- `id = rpo[slot]` used against `pred_off`, then against
;; `idom`; `pred = pred_edge[e]` used against `reachable`, then against `idom`
;; -- derives none of them: the index is a LOADED VALUE, not an affine function
;; of any counter, and no amount of trip-range reasoning bounds it.
;;
;; It does not have to be bounded from the counter. The FIRST check on such an
;; index is a trap-or-continue: every point it dominates is reached only when
;; `0 <=u index <u anchor_length` held. That is a fact about the index, and it
;; transfers to a SECOND array whenever the guard has taken the one invariant
;; comparison relating the two lengths. So for a check K = `bounds_check i, Lk`
;; the pass looks for an anchor J = `bounds_check i, Lj` in the same loop that
;; DOMINATES K (an earlier instruction of K's own block, or a block that
;; dominates K's), and removes K from the fast clone under
;;
;;     Lj <=u Lk
;;
;; which the guard evaluates once at loop entry. UNSIGNED, the order a
;; BoundsCheck itself tests, so the transfer is exact and needs no companion
;; sign condition: `i <u Lj <=u Lk` is the removed check's condition. The index
;; operands are compared after the same Mov/reinterpret-cast resolution the
;; other derivations use, so the anchor and the removed check are checks of the
;; SAME runtime value; a bit-preserving 64-bit cast leaves the unsigned compare
;; alone.
;;
;; WHY THE ANCHOR'S FACT REACHES THE CLONE. The clone is an edge-for-edge copy
;; of the loop's blocks entered only at the cloned header, so dominance among
;; loop blocks survives cloning: every path to K's twin runs through J's twin.
;; There, either J was KEPT (it aborts unless the fact holds) or J was itself
;; derived (the guard proves the fact). Both give the fact, and the anchor
;; relation is a STRICT order -- earlier instruction, or strictly dominating
;; block -- so two checks can never anchor on each other and lose it. A block
;; the guard-fact folding drops from the clone takes every block it dominates
;; with it, K's twin included.
;;
;; WHAT THE ANCHOR DOES NOT NEED TO BE. Nothing here cares whether the covered
;; arrays are read or WRITTEN: the removed check may be the one guarding a
;; store (`idom[id] := candidate` is the running example, and its check is the
;; largest single consumer in the running benchmark), and the value stored is
;; irrelevant to it -- a store's bounds check constrains the INDEX. Nor does a
;; later read of that array inherit anything: it carries its own anchor. So the
;; "closed set of values" the region has to track is just the set of index
;; values a retained check has already proven in range, and dominance is what
;; propagates it.
;;
;; TRAP PARITY. The slow region is the original instruction for instruction, so
;; a guard-failing or unversioned run aborts exactly where it did. On the fast
;; path the removed check provably cannot trap, and no earlier trap is skipped:
;; the anchor stays ahead of it in the same order.
(define (opt-bce-mb-fused-contains?
  [fused : OptBceMbFused]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : bool
  (opt-bce-mb-fused-contains-from? fused lhs rhs 0))

(define (opt-bce-mb-fused-contains-from?
  [fused : OptBceMbFused]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [index : i64]) : bool
  (if (>= index (opt-bce-mb-fused-count fused))
    false
    (match (opt-bce-mb-fused-ref fused index)
      [(OptBceMbFusedPair item-lhs item-rhs)
        (if (and (opt-value-eq item-lhs lhs) (opt-value-eq item-rhs rhs))
          true
          (opt-bce-mb-fused-contains-from? fused lhs rhs (+ index 1)))])))

(define (opt-bce-mb-fused-prepend
  [fused : OptBceMbFused (:consume)]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptBceMbFused
  (let
    [items : opt_bce_mb_fused_vec.Vec fused.items]
    (begin
      (opt_bce_mb_fused_vec.push (&mut items) (OptBceMbFusedPair lhs rhs))
      (OptBceMbFused items))))

(define (opt-bce-mb-fused-insert
  [fused : OptBceMbFused (:consume)]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptBceMbFused
  (if (opt-bce-mb-fused-contains? fused lhs rhs)
    fused
    (opt-bce-mb-fused-prepend fused lhs rhs)))

(cfg
  test
  (define (opt-bce-mb-fused-test-fill
    [fused : OptBceMbFused (:consume)]
    [index : i64]
    [count : i64]) : OptBceMbFused
    (if (>= index count)
      fused
      (opt-bce-mb-fused-test-fill
        (opt-bce-mb-fused-insert
          fused
          (ir.CompilerIrValue.Var index)
          (ir.CompilerIrValue.I64 (+ index 100)))
        (+ index 1)
        count))))

(cfg
  test
  (test
    optimizer-bce-mb-fused-dense-storage-grows
    (let
      [single : OptBceMbFused
        (opt-bce-mb-fused-insert
          (opt-bce-mb-fused-new)
          (ir.CompilerIrValue.Var 40)
          (ir.CompilerIrValue.I64 140))]
      [fused : OptBceMbFused
        (opt-bce-mb-fused-test-fill (opt-bce-mb-fused-new) 0 9)]
      (begin
        (test.assert-i64-eq
          (opt-bce-mb-fused-count (opt-bce-mb-fused-new))
          0
          "BCE fused-pair storage starts empty")
        (test.assert-i64-eq
          (opt-bce-mb-fused-count single)
          1
          "BCE fused-pair storage preserves a singleton")
        (test.assert-true
          (opt-bce-mb-fused-contains?
            single
            (ir.CompilerIrValue.Var 40)
            (ir.CompilerIrValue.I64 140))
          "BCE fused-pair singleton has exact membership")
        ;; Pair membership is a set: reinsertion must not grow the container.
        (set!
          fused
          (opt-bce-mb-fused-insert
            fused
            (ir.CompilerIrValue.Var 8)
            (ir.CompilerIrValue.I64 108)))
        (test.assert-i64-eq
          (opt-bce-mb-fused-count fused)
          9
          "BCE fused-pair storage grows once per distinct relation")
        (test.assert-true
          (opt-bce-mb-fused-contains?
            fused
            (ir.CompilerIrValue.Var 0)
            (ir.CompilerIrValue.I64 100))
          "BCE fused-pair storage retains its oldest relation")
        (test.assert-true
          (opt-bce-mb-fused-contains?
            fused
            (ir.CompilerIrValue.Var 8)
            (ir.CompilerIrValue.I64 108))
          "BCE fused-pair storage retains its newest relation after growth")
        (test.assert-true
          (not
            (opt-bce-mb-fused-contains?
              fused
              (ir.CompilerIrValue.Var 8)
              (ir.CompilerIrValue.I64 109)))
          "BCE fused-pair membership distinguishes the rhs")
        (match (opt-bce-mb-fused-ref fused 0)
          [(OptBceMbFusedPair lhs rhs)
            (begin
              (test.assert-true
                (opt-value-eq lhs (ir.CompilerIrValue.Var 8))
                "BCE fused-pair traversal remains newest-first")
              (test.assert-true
                (opt-value-eq rhs (ir.CompilerIrValue.I64 108))
                "BCE fused-pair traversal preserves the paired rhs"))])))))

;; The one conjunct a fused check needs: `anchor_length <=u target_length`.
;; UNSIGNED, exactly matching the order a BoundsCheck tests, so it needs no
;; companion sign condition: `index <u anchor <=u target` is the removed
;; check.
(define (opt-bce-mb-fuse-cond
  [cell : (__tl_dyn-array i64)]
  [anchor-length : ir.CompilerIrValue]
  [length-value : ir.CompilerIrValue]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (opt-bce-version-cond-typed
    cell
    (ir.CompilerIrBinOp.Le)
    anchor-length
    length-value
    (ast.AstType.U64)
    acc))

;; A dominating check of the SAME index value whose length is loop-invariant
;; and different from this check's: the anchor whose fact fusion transfers.
;; `use-block` / `use-pos` identify the check being derived; `opt-global-fact-
;; available?` is the same "an earlier instruction of my block, or a block that
;; dominates mine" test the global copy facts use.
(define (opt-bce-mb-fuse-anchor-instrs
  [doms : OptDomInfo]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [block-id : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [use-block-id : i64]
  [use-pos : i64]
  [index-id : i64]
  [length-value : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrMaybeValue.No)
    (let
      [found : ir.CompilerIrMaybeValue
        (match (ir.compiler-ir-instr-seq-ref instrs pos)
          [(ir.CompilerIrInstr.BoundsCheck other-index other-length _)
            (if (or
              (< block-id 0)
              (not
                (opt-global-fact-available?
                  block-id
                  pos
                  use-block-id
                  use-pos
                  doms)))
              (ir.CompilerIrMaybeValue.No)
              (match other-index
                [(ir.CompilerIrValue.Var other-raw)
                  (if (not
                    (= (opt-bce-mb-resolve body-blocks other-raw 16) index-id))
                    (ir.CompilerIrMaybeValue.No)
                    (match (opt-bce-mb-invariant-operand
                      body-blocks
                      defs
                      other-length)
                      [(ir.CompilerIrMaybeValue.No)
                        (ir.CompilerIrMaybeValue.No)]
                      [(ir.CompilerIrMaybeValue.Some anchor-length)
                        (if (opt-value-eq anchor-length length-value)
                          (ir.CompilerIrMaybeValue.No)
                          (ir.CompilerIrMaybeValue.Some anchor-length))]))]
                [_ (ir.CompilerIrMaybeValue.No)]))]
          [_ (ir.CompilerIrMaybeValue.No)])]
      (match found
        [(ir.CompilerIrMaybeValue.Some anchor-length)
          (ir.CompilerIrMaybeValue.Some anchor-length)]
        [(ir.CompilerIrMaybeValue.No)
          (opt-bce-mb-fuse-anchor-instrs
            doms
            body-blocks
            defs
            block-id
            instrs
            (+ pos 1)
            use-block-id
            use-pos
            index-id
            length-value)]))))

(define (opt-bce-mb-fuse-anchor
  [doms : OptDomInfo]
  [body-blocks : ir.CompilerIrBlockList]
  [remaining : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [use-block-id : i64]
  [use-pos : i64]
  [index-id : i64]
  [length-value : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (match (opt-bce-mb-fuse-anchor-instrs
            doms
            body-blocks
            defs
            (opt-global-block-id doms label)
            instrs
            0
            use-block-id
            use-pos
            index-id
            length-value)
            [(ir.CompilerIrMaybeValue.Some anchor-length)
              (ir.CompilerIrMaybeValue.Some anchor-length)]
            [(ir.CompilerIrMaybeValue.No)
              (opt-bce-mb-fuse-anchor
                doms
                body-blocks
                (__tl-box-place rest)
                defs
                use-block-id
                use-pos
                index-id
                length-value)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-fuse-anchor
        doms
        body-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        defs
        use-block-id
        use-pos
        index-id
        length-value)]))

;; The fusion fallback for a check no single-array derivation reached: on a
;; dominating anchor the guard gains `Lj <=u Lk` (once per array pair, however
;; many checks fuse across it) and the check is dropped from the clone;
;; otherwise it is kept, exactly like any underivable index.
(define (opt-bce-mb-derive-fused
  [doms : OptDomInfo]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [cell : (__tl_dyn-array i64)]
  [label : i64]
  [index : i64]
  [index-value : ir.CompilerIrValue]
  [length-invariant : ir.CompilerIrValue]
  [state : OptBceMbDerive]) : OptBceMbDerive
  (let
    [kept : OptBceMbDerive
      (OptBceMbDerive
        state.guard
        (opt-bce-mb-keep-cons label index state.keep)
        state.derived
        state.hoists
        state.fused)]
    (match index-value
      [(ir.CompilerIrValue.Var raw)
        (let
          [index-id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
          [use-block-id : i64 (opt-global-block-id doms label)]
          (match (if (< use-block-id 0)
            (ir.CompilerIrMaybeValue.No)
            (opt-bce-mb-fuse-anchor
              doms
              body-blocks
              body-blocks
              defs
              use-block-id
              index
              index-id
              length-invariant))
            [(ir.CompilerIrMaybeValue.No) kept]
            [(ir.CompilerIrMaybeValue.Some anchor-length)
              (let
                [related? : bool
                  (opt-bce-mb-fused-contains?
                    state.fused
                    anchor-length
                    length-invariant)]
                [with-relation : OptBceVersionGuardAcc
                  (if related?
                    state.guard
                    (opt-bce-mb-fuse-cond
                      cell
                      anchor-length
                      length-invariant
                      state.guard))]
                (match with-relation
                  [(OptBceVersionGuardAcc.No) kept]
                  [(OptBceVersionGuardAcc.Some _ _ _)
                    (OptBceMbDerive
                      with-relation
                      state.keep
                      (+ state.derived 1)
                      state.hoists
                      (if related?
                        state.fused
                        (opt-bce-mb-fused-prepend
                          state.fused
                          anchor-length
                          length-invariant)))]))]))]
      [_ kept])))

;; Derive one check against a proven-invariant length value: on success the
;; guard gains the conditions and the derived count ticks; on failure the
;; check falls back to cross-array fusion and, failing that too, joins the kept
;; set instead. A failure reverts to the state's guard
;; AND hoist set, so a descriptor hoist emitted for a check that then fails
;; derivation is dropped along with its (unused) guard instructions.
(define (opt-bce-mb-derive-check
  [doms : OptDomInfo]
  [all-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [label : i64]
  [index : i64]
  [index-value : ir.CompilerIrValue]
  [length-invariant : ir.CompilerIrValue]
  [success-hoists : OptBceMbHoists]
  [fan : OptBceVersionFan]
  [acc : OptBceVersionGuardAcc]
  [state : OptBceMbDerive]) : OptBceMbDerive
  (let
    [derived-guard : OptBceVersionGuardAcc
      (opt-bce-mb-derive-index
        all-blocks
        body-blocks
        defs
        latch
        preheader
        iphi
        seed
        bound
        cell
        index-value
        length-invariant
        fan
        acc)]
    (match derived-guard
      [(OptBceVersionGuardAcc.No)
        ;; No single-array derivation: try the cross-array fusion fallback,
        ;; which keeps the check when it finds no dominating anchor either.
        (opt-bce-mb-derive-fused
          doms
          body-blocks
          defs
          cell
          label
          index
          index-value
          length-invariant
          state)]
      [(OptBceVersionGuardAcc.Some _ _ _)
        (OptBceMbDerive
          derived-guard
          state.keep
          (+ state.derived 1)
          success-hoists
          state.fused)])))

(define (opt-bce-mb-derive-block
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [all-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [fan : OptBceVersionFan]
  [state : OptBceMbDerive]) : OptBceMbDerive
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    state
    (opt-bce-mb-derive-block
      doms
      descriptor
      stable?
      label
      instrs
      (+ index 1)
      all-blocks
      body-blocks
      defs
      latch
      preheader
      iphi
      seed
      bound
      cell
      fan
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.BoundsCheck index-value length-value _)
          (match (opt-bce-mb-invariant-operand body-blocks defs length-value)
            [(ir.CompilerIrMaybeValue.Some length-invariant)
              (opt-bce-mb-derive-check
                doms
                all-blocks
                body-blocks
                defs
                latch
                preheader
                iphi
                seed
                bound
                cell
                label
                index
                index-value
                length-invariant
                state.hoists
                fan
                state.guard
                state)]
            [(ir.CompilerIrMaybeValue.No)
              (match (opt-bce-mb-descriptor-length
                descriptor
                stable?
                all-blocks
                body-blocks
                defs
                length-value
                state.hoists
                cell
                state.guard)
                [(OptBceMbMaybeLength.No)
                  (OptBceMbDerive
                    state.guard
                    (opt-bce-mb-keep-cons label index state.keep)
                    state.derived
                    state.hoists
                    state.fused)]
                [(OptBceMbMaybeLength.Some
                    hoisted-length
                    hoisted-hoists
                    hoisted-guard)
                  (opt-bce-mb-derive-check
                    doms
                    all-blocks
                    body-blocks
                    defs
                    latch
                    preheader
                    iphi
                    seed
                    bound
                    cell
                    label
                    index
                    index-value
                    hoisted-length
                    hoisted-hoists
                    fan
                    hoisted-guard
                    state)])])]
        [_ state]))))

;; An UNCOVERED block's checks: the counter compare does not dominate them
;; (see the entry guard chain), so no trip-range derivation applies and every
;; one of them stays -- remapped -- in the fast clone, exactly like an
;; underivable index. The abort sites the slow path has are the abort sites the
;; clone has.
(define (opt-bce-mb-keep-block-checks
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [keep : OptBceMbKeep]) : OptBceMbKeep
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    keep
    (opt-bce-mb-keep-block-checks
      label
      instrs
      (+ index 1)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.BoundsCheck _ _ _)
          (opt-bce-mb-keep-cons label index keep)]
        [_ keep]))))

(define (opt-bce-mb-derive-blocks
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [remaining : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [body-blocks : ir.CompilerIrBlockList]
  [defs : opt_i64_i64_map.Map]
  [latch : i64]
  [preheader : i64]
  [iphi : i64]
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [cell : (__tl_dyn-array i64)]
  [fan : OptBceVersionFan]
  [uncovered : OptLabelSet]
  [state : OptBceMbDerive]) : OptBceMbDerive
  (match remaining
    [(ir.CompilerIrBlockList.Nil) state]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-bce-mb-derive-blocks
            doms
            descriptor
            stable?
            (__tl-box-place rest)
            all-blocks
            body-blocks
            defs
            latch
            preheader
            iphi
            seed
            bound
            cell
            fan
            uncovered
            (if (opt-label-contains uncovered label)
              (OptBceMbDerive
                state.guard
                (opt-bce-mb-keep-block-checks label instrs 0 state.keep)
                state.derived
                state.hoists
                state.fused)
              (opt-bce-mb-derive-block
                doms
                descriptor
                stable?
                label
                instrs
                0
                all-blocks
                body-blocks
                defs
                latch
                preheader
                iphi
                seed
                bound
                cell
                fan
                state)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-derive-blocks
        doms
        descriptor
        stable?
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        body-blocks
        defs
        latch
        preheader
        iphi
        seed
        bound
        cell
        fan
        uncovered
        state)]))

;; --- region profitability ------------------------------------------------------
;;
;; A REGION clone (a nest admitted on the enlarged budget) is worth its size
;; only when the derivation removes a check that runs per INNER iteration. The
;; ordinary nest budget assumes the opposite -- at most one removal per OUTER
;; iteration against a duplicated inner loop of unbounded trip count -- and
;; that assumption is exactly what the cross-array fusion breaks: its anchors
;; and its removals sit in the innermost blocks of a walk. So the region gate
;; runs AFTER derivation, on the kept set: a check of an inner-loop block that
;; is not kept is a check the clone removed from an inner loop.
(define (opt-bce-mb-derived-in-inner-instrs?
  [keep : OptBceMbKeep]
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BoundsCheck _ _ _)
        (not (opt-bce-mb-keep-contains? keep label index))]
      [_ false])
      true
      (opt-bce-mb-derived-in-inner-instrs? keep label instrs (+ index 1)))))

(define (opt-bce-mb-derived-in-inner?
  [remaining : ir.CompilerIrBlockList]
  [inner : OptLabelSet]
  [keep : OptBceMbKeep]) : bool
  (match remaining
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (and
            (opt-label-contains inner label)
            (opt-bce-mb-derived-in-inner-instrs? keep label instrs 0))
            true
            (opt-bce-mb-derived-in-inner? (__tl-box-place rest) inner keep))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-derived-in-inner?
        (ir.compiler-ir-block-seq-to-list seq)
        inner
        keep)]))

;; --- invariant upper bounds hoisted into the guard ---------------------------
;;
;; The entry guard chain proves `counter < bound` for the whole body of a
;; top-tested loop -- that is the header test itself, and it dominates every
;; body block. A body test of the counter against a LOOP-INVARIANT upper bound
;; (the defensive `(< i len)` an inlined accessor re-tests every iteration) is
;; then decided as soon as `bound <= len` is known, and `bound <= len` is ONE
;; invariant comparison the guard can take once at loop entry. Emitting it
;; leaves the per-iteration test provably true on the fast path: `bounds_dom`
;; sees the header's `counter < bound` and the guard's `bound <= len` as two
;; dominating branch facts on a later pipeline round and its one transitive
;; step retires the compare, which takes the whole diamond around the access
;; with it.
;;
;; The conjunct is a runtime test like every other guard conjunct, so nothing
;; about the slow path changes: a loop whose body really does test a SMALLER
;; invariant bound fails it and runs unversioned, which is the same per-
;; iteration decision it was making anyway. Only compares that are a BRANCH
;; CONDITION inside the loop are hoisted for -- those are the ones whose
;; folding removes control flow -- and only a bounded number of distinct
;; bounds, so the guard stays a handful of compares whatever the body does.
;; A literal bound is left alone: `bound <= k` for a small literal is the
;; shape that deselects the fast path, and the fold rules already decide a
;; counter against a literal from its own range.
;;
;; The conjunct only pays where `counter < bound` is a DOMINATING BRANCH FACT,
;; which is the top-tested form and only there. Its entry guard chain is the
;; shape's `uncovered` set -- the header through the counter compare, the
;; blocks that compare does not cover -- so a non-empty `uncovered` identifies
;; the form and its members are the blocks to skip: the counter compare does
;; not dominate itself, and the chain runs one extra time with the counter at
;; the value that failed. In the do-while form `uncovered` is empty, the
;; counter compare sits at the latch and dominates nothing above it, and the
;; trip range is a fact only the versioning pass's own derivations carry, so
;; nothing is hoisted there.
(import (vector.vector ir.CompilerIrValue core) as opt_bce_mb_upper_vec)

(defstruct OptBceMbUppers
  (items opt_bce_mb_upper_vec.Vec))

(define (opt-bce-mb-uppers-new) : OptBceMbUppers
  ;; The production bound is two. Starting at one makes the second distinct
  ;; upper exercise the same capacity growth path as larger dense families.
  (OptBceMbUppers (opt_bce_mb_upper_vec.with-capacity 1)))

(define (opt-bce-mb-upper-max) : i64
  2)

(define (opt-bce-mb-uppers-count [uppers : OptBceMbUppers]) : i64
  (opt_bce_mb_upper_vec.len (& uppers.items)))

(define (opt-bce-mb-uppers-ref [uppers : OptBceMbUppers] [index : i64]) : ir.CompilerIrValue
  (let
    [items : opt_bce_mb_upper_vec.Vec uppers.items]
    (array-ref
      (opt_bce_mb_upper_vec.slots (& items))
      (- (- (opt_bce_mb_upper_vec.len (& items)) index) 1))))

(define (opt-bce-mb-uppers-contains?
  [uppers : OptBceMbUppers]
  [value : ir.CompilerIrValue]) : bool
  (opt-bce-mb-uppers-contains-from? uppers value 0))

(define (opt-bce-mb-uppers-contains-from?
  [uppers : OptBceMbUppers]
  [value : ir.CompilerIrValue]
  [index : i64]) : bool
  (if (>= index (opt-bce-mb-uppers-count uppers))
    false
    (if (opt-value-eq (opt-bce-mb-uppers-ref uppers index) value)
      true
      (opt-bce-mb-uppers-contains-from? uppers value (+ index 1)))))

(define (opt-bce-mb-uppers-insert
  [uppers : OptBceMbUppers (:consume)]
  [value : ir.CompilerIrValue]) : OptBceMbUppers
  (if (or
    (>= (opt-bce-mb-uppers-count uppers) (opt-bce-mb-upper-max))
    (opt-bce-mb-uppers-contains? uppers value))
    uppers
    (let
      [items : opt_bce_mb_upper_vec.Vec uppers.items]
      (begin
        (opt_bce_mb_upper_vec.push (&mut items) value)
        (OptBceMbUppers items)))))

(cfg
  test
  (test
    optimizer-bce-mb-upper-dense-storage-grows
    (let
      [uppers : OptBceMbUppers (opt-bce-mb-uppers-new)]
      (begin
        (test.assert-i64-eq
          (opt-bce-mb-uppers-count uppers)
          0
          "BCE upper storage starts empty")
        (set!
          uppers
          (opt-bce-mb-uppers-insert uppers (ir.CompilerIrValue.Var 10)))
        (test.assert-i64-eq
          (opt-bce-mb-uppers-count uppers)
          1
          "BCE upper storage preserves a singleton")
        (test.assert-true
          (opt-value-eq
            (opt-bce-mb-uppers-ref uppers 0)
            (ir.CompilerIrValue.Var 10))
          "BCE upper singleton keeps its logical order")
        (set!
          uppers
          (opt-bce-mb-uppers-insert uppers (ir.CompilerIrValue.Var 11)))
        ;; Duplicate insertion and a third distinct bound are both rejected.
        (set!
          uppers
          (opt-bce-mb-uppers-insert uppers (ir.CompilerIrValue.Var 11)))
        (set!
          uppers
          (opt-bce-mb-uppers-insert uppers (ir.CompilerIrValue.Var 12)))
        (test.assert-i64-eq
          (opt-bce-mb-uppers-count uppers)
          2
          "BCE upper storage grows to its distinct-bound limit")
        (test.assert-true
          (opt-bce-mb-uppers-contains? uppers (ir.CompilerIrValue.Var 10))
          "BCE upper storage retains its oldest bound")
        (test.assert-true
          (opt-bce-mb-uppers-contains? uppers (ir.CompilerIrValue.Var 11))
          "BCE upper storage retains its newest bound")
        (test.assert-true
          (not (opt-bce-mb-uppers-contains? uppers (ir.CompilerIrValue.Var 12)))
          "BCE upper storage rejects a third distinct bound")
        (test.assert-true
          (opt-value-eq
            (opt-bce-mb-uppers-ref uppers 0)
            (ir.CompilerIrValue.Var 11))
          "BCE upper traversal remains newest-first")))))

;; The invariant `X` a branch condition tests the counter's UPPER side against,
;; in either spelling (`counter < X`, `X > counter`). `Le` counts too: the
;; range gives `counter <= bound - 1 < bound <= X`, which decides it as well.
(define (opt-bce-mb-upper-of-cond
  [body-blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [bound : ir.CompilerIrValue]
  [cond : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match cond
    [(ir.CompilerIrValue.Var raw)
      (match (opt-bce-mb-find-def
        body-blocks
        (opt-bce-mb-resolve body-blocks raw 16))
        [(OptBceMbMaybeInstr.No) (ir.CompilerIrMaybeValue.No)]
        [(OptBceMbMaybeInstr.Some instr)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
              (if (not (opt-bce-fold-i64-type? ty))
                (ir.CompilerIrMaybeValue.No)
                (cond
                  [(and
                      (or
                        (opt-binop-eq op (ir.CompilerIrBinOp.Lt))
                        (opt-binop-eq op (ir.CompilerIrBinOp.Le)))
                      (opt-bce-fold-counter-operand? body-blocks iphi lhs))
                    (opt-bce-mb-upper-candidate body-blocks bound rhs)]
                  [(and
                      (or
                        (opt-binop-eq op (ir.CompilerIrBinOp.Gt))
                        (opt-binop-eq op (ir.CompilerIrBinOp.Ge)))
                      (opt-bce-fold-counter-operand? body-blocks iphi rhs))
                    (opt-bce-mb-upper-candidate body-blocks bound lhs)]
                  [else (ir.CompilerIrMaybeValue.No)]))]
            [_ (ir.CompilerIrMaybeValue.No)])])]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-bce-mb-upper-candidate
  [body-blocks : ir.CompilerIrBlockList]
  [bound : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match (opt-bce-fold-invariant-operand body-blocks value)
    [(ir.CompilerIrMaybeValue.No) (ir.CompilerIrMaybeValue.No)]
    [(ir.CompilerIrMaybeValue.Some canon)
      (match canon
        ;; the header's own test needs no conjunct, and a literal is refused
        [(ir.CompilerIrValue.Var _)
          (if (opt-value-eq canon bound)
            (ir.CompilerIrMaybeValue.No)
            (ir.CompilerIrMaybeValue.Some canon))]
        [_ (ir.CompilerIrMaybeValue.No)])]))

(define (opt-bce-mb-upper-scan-instrs
  [body-blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [bound : ir.CompilerIrValue]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [uppers : OptBceMbUppers]) : OptBceMbUppers
  (if (or
    (>= index (ir.compiler-ir-instr-seq-count instrs))
    (>= (opt-bce-mb-uppers-count uppers) (opt-bce-mb-upper-max)))
    uppers
    (opt-bce-mb-upper-scan-instrs
      body-blocks
      iphi
      bound
      instrs
      (+ index 1)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Branch cond _ _)
          (match (opt-bce-mb-upper-of-cond body-blocks iphi bound cond)
            [(ir.CompilerIrMaybeValue.No) uppers]
            [(ir.CompilerIrMaybeValue.Some upper)
              (opt-bce-mb-uppers-insert uppers upper)])]
        [_ uppers]))))

(define (opt-bce-mb-upper-scan
  [body-blocks : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [bound : ir.CompilerIrValue]
  [uncovered : OptLabelSet]
  [uppers : OptBceMbUppers]) : OptBceMbUppers
  (match blocks
    [(ir.CompilerIrBlockList.Nil) uppers]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (opt-bce-mb-upper-scan
            body-blocks
            (deref rest)
            iphi
            bound
            uncovered
            (if (opt-label-contains uncovered label)
              uppers
              (opt-bce-mb-upper-scan-instrs
                body-blocks
                iphi
                bound
                instrs
                0
                uppers)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-upper-scan
        body-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        iphi
        bound
        uncovered
        uppers)]))

;; Nothing is hoisted for a loop whose counter compare dominates no body block.
(define (opt-bce-mb-uppers-for-shape [shape : OptBceMbShape]) : OptBceMbUppers
  (match shape.uncovered
    [(OptLabelSet.Nil) (opt-bce-mb-uppers-new)]
    [(OptLabelSet.Dense _ _)
      (opt-bce-mb-upper-scan
        shape.body-blocks
        shape.body-blocks
        shape.iphi
        shape.bound
        shape.uncovered
        (opt-bce-mb-uppers-new))]))

(define (opt-bce-mb-upper-conds
  [cell : (__tl_dyn-array i64)]
  [bound : ir.CompilerIrValue]
  [uppers : OptBceMbUppers]
  [acc : OptBceVersionGuardAcc]) : OptBceVersionGuardAcc
  (opt-bce-mb-upper-conds-from cell bound uppers acc 0))

(define (opt-bce-mb-upper-conds-from
  [cell : (__tl_dyn-array i64)]
  [bound : ir.CompilerIrValue]
  [uppers : OptBceMbUppers]
  [acc : OptBceVersionGuardAcc]
  [index : i64]) : OptBceVersionGuardAcc
  (if (>= index (opt-bce-mb-uppers-count uppers))
    acc
    (opt-bce-mb-upper-conds-from
      cell
      bound
      uppers
      (opt-bce-version-cond
        cell
        (ir.CompilerIrBinOp.Le)
        bound
        (opt-bce-mb-uppers-ref uppers index)
        acc)
      (+ index 1))))

;; The counter's executed range, always as the ASCENDING pair every derivation
;; downstream reads: an inclusive first value, an exclusive limit, and a
;; positive step. Plus the guard accumulator, because a descending loop's limit
;; sometimes has to be computed.
(defenum OptBceMbRange
  (No)
  (Some ir.CompilerIrValue ir.CompilerIrValue i64 OptBceVersionGuardAcc))

;; MIRRORING A DESCENDING COUNTER.
;;
;; Ascending is already the pair: the shape's `seed` is the first value, its
;; `bound` the exclusive limit the latch's `<` tests, and the executed set is
;; [seed, bound-1] -- exactly what every derivation in this file assumes.
;;
;; Descending walks the same kind of interval the other way. The shape's `seed`
;; is the TOP (the do-while body runs on it before any compare) and its `bound`
;; is the inclusive BOTTOM the latch's `>=` tests, so the executed set is
;;
;;     { seed, seed-s, seed-2s, ... } INTERSECT [bound, seed]
;;
;; which is contained in the closed interval [bound, seed] -- i.e. in the
;; half-open [bound, seed+1). That interval is what this returns: first =
;; `bound`, limit = `seed + 1`, step = 1. The step is deliberately reported as
;; 1 rather than the magnitude: the reported range is a dense SUPERSET of the
;; executed values, and every derivation this feeds asks "does P hold for every
;; value in [first, limit)". Proving P of the superset proves it of the subset,
;; for every rule, with no per-rule sign reasoning at all -- which is why
;; nothing below this function knows the counter's direction.
;;
;; Trip-count rules stay sound for the same reason, and it needs checking once
;; rather than per rule: a rule that bounds a DERIVED value by the number of
;; latch crossings (the derived-induction guard, the bounded-phi rule) reads the
;; trip span off the reported range as `limit - first` = `seed + 1 - bound`,
;; while the descending loop's real trip count is
;; `floor((seed - bound) / s) + 1`, which is at most that for every s >= 1. An
;; over-reported trip span only ever makes the guard demand more.
;;
;; THE GUARD'S OWN CONDITIONS. `opt-bce-version-guard-finish` emits
;; `first < limit` and `first >= 0` for a counter-cased derivation, which here
;; read `bound <= seed` and `bound >= 0`. The first is what excludes the
;; do-while's one unchecked trip: a loop entered with `seed < bound` runs its
;; body once at `seed`, outside the interval, and that conjunct fails so the
;; fast clone is never selected. The second gives every executed value the
;; `>= 0` half of its range. Both mirror the ascending finisher exactly.
;;
;; WRAPPING. `seed + 1` is computed in the guard and can wrap only at
;; `seed = i64 MAX`, where it lands on i64 MIN and `bound < MIN` is
;; unsatisfiable -- the guard fails and the slow loop runs, so the wrap is
;; self-defeating rather than unsound. A literal seed is folded here and the
;; MAX case refused outright. The counter's own decrement cannot wrap either:
;; the guard's `bound >= 0` puts every body value at or above 0, so
;; `value - s` stays at or above `-s`.
(define (opt-bce-mb-counter-range
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [step : i64]
  [cell : (__tl_dyn-array i64)]
  [acc : OptBceVersionGuardAcc]) : OptBceMbRange
  (if (> step 0)
    (OptBceMbRange.Some seed bound step acc)
    (match acc
      [(OptBceVersionGuardAcc.No) (OptBceMbRange.No)]
      [(OptBceVersionGuardAcc.Some instrs values counter-seen)
        (match seed
          [(ir.CompilerIrValue.I64 top)
            (if (= top 9223372036854775807)
              (OptBceMbRange.No)
              (OptBceMbRange.Some
                bound
                (ir.CompilerIrValue.I64 (+ top 1))
                1
                acc))]
          [(ir.CompilerIrValue.Var _)
            (let
              [limit : i64 (opt-bce-version-alloc-var cell)]
              (OptBceMbRange.Some
                bound
                (ir.CompilerIrValue.Var limit)
                1
                (OptBceVersionGuardAcc.Some
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      limit
                      (ir.CompilerIrBinOp.Add)
                      seed
                      (ir.CompilerIrValue.I64 1)
                      (ast.AstType.I64))
                    instrs)
                  values
                  counter-seen)))]
          [_ (OptBceMbRange.No)])])))

;; `doms` is the dominator info of the function the shape was scanned in. The
;; only queries made of it are between two LOOP BODY labels, and neither the
;; far-use repair nor the exit wiring adds, removes, or re-targets a loop
;; block -- both rewrite instructions of blocks OUTSIDE the loop -- so it stays
;; exact for those queries on the repaired/wired blocks this runs against.
;;
;; `uncovered` is empty for every descending shape: only the bottom-tested
;; latch scan recovers a negative step (opt-bce-mb-counter-step), and that path
;; passes the empty set because its compare covers the whole body. So the
;; entry-guard-chain uppers below never see a mirrored range.
(define (opt-bce-mb-guard-conds
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [all-blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [defs : opt_i64_i64_map.Map]
  [cell : (__tl_dyn-array i64)]) : OptBceMbGuardOut
  (match (opt-bce-mb-counter-range
    shape.seed
    shape.bound
    shape.step
    cell
    (OptBceVersionGuardAcc.Some
      (ir.CompilerIrInstrList.Nil)
      (ir.CompilerIrValueList.Nil)
      false))
    [(OptBceMbRange.No) (OptBceMbGuardOut.No)]
    [(OptBceMbRange.Some first limit step seeded)
      (opt-bce-mb-guard-conds-ranged
        doms
        descriptor
        stable?
        all-blocks
        shape
        defs
        cell
        first
        limit
        step
        seeded)]))

(define (opt-bce-mb-guard-conds-ranged
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [all-blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [defs : opt_i64_i64_map.Map]
  [cell : (__tl_dyn-array i64)]
  [first : ir.CompilerIrValue]
  [limit : ir.CompilerIrValue]
  [step : i64]
  [seeded : OptBceVersionGuardAcc]) : OptBceMbGuardOut
  (let
    [fan : OptBceVersionFan (opt-bce-version-fan-new)]
    [dr : OptBceMbDerive
      (opt-bce-mb-derive-blocks
        doms
        descriptor
        stable?
        shape.body-blocks
        all-blocks
        shape.body-blocks
        defs
        shape.latch
        shape.preheader
        shape.iphi
        first
        limit
        cell
        fan
        shape.uncovered
        (OptBceMbDerive
          seeded
          (OptBceMbKeep.Nil)
          0
          (OptBceMbHoists.Nil)
          (opt-bce-mb-fused-new)))]
    (if (or
      ;; No removable check: cloning the loop would only duplicate it. A body
      ;; that duplicates CALL SITES owes more than one -- see
      ;; opt-bce-mb-call-clone-min-derived for the currency and the constant.
      ;; The call census runs only here, after the derivation, so a shape the
      ;; derivation was going to refuse anyway never pays for the walk.
      (<
        dr.derived
        (opt-bce-mb-call-clone-min-derived
          (opt-bce-mb-body-calls shape.body-blocks 0)))
      ;; A region-sized clone additionally needs one of them inside an inner
      ;; loop, where the removal repeats per inner iteration.
      (and
        shape.region?
        (>
          (opt-bce-mb-body-instrs shape.body-blocks 0)
          (opt-bce-mb-nest-instr-max))
        (not
          (opt-bce-mb-derived-in-inner? shape.body-blocks shape.inner dr.keep))))
      (OptBceMbGuardOut.No)
      (match (opt-bce-version-guard-finish
        first
        limit
        step
        cell
        ;; The fan's extremal conditions join the accumulator only here,
        ;; once per loop, instead of twice per fan member.
        (opt-bce-version-fan-flush
          fan
          0
          first
          limit
          cell
          (opt-bce-mb-upper-conds
            cell
            limit
            (opt-bce-mb-uppers-for-shape shape)
            dr.guard)))
        [(OptBceVersionGuardResult.No) (OptBceMbGuardOut.No)]
        [(OptBceVersionGuardResult.Some guard-instrs guard-value)
          (OptBceMbGuardOut.Some
            guard-instrs
            guard-value
            dr.keep
            (OptBceFoldFacts
              (opt-bce-fold-collect
                guard-instrs
                guard-value
                (opt-bce-fold-conjunct-fuel)
                (opt-bce-fold-cond-list-new))
              all-blocks
              shape.body-blocks
              shape.iphi
              (opt-bce-version-guard-counter-seen? dr.guard)))]))))

;; --- guard-dominated compare folding --------------------------------------------
;;
;; The guard decides more than the BoundsChecks it removes. Its conjunction is
;; a set of facts that hold at EVERY point of the fast clone -- the guard block
;; is the clone's only entry, so it dominates every cloned block by
;; construction and no dominance analysis is needed. Ordinary compares the
;; guard already decides (the defensive `>= 0` an inlined accessor re-tests
;; every iteration, an invariant range test recomputed inside the body) then
;; survive in the fast clone as provably-constant per-iteration work. This
;; folds their branches: the conditional becomes an unconditional jump to the
;; arm the fact selects, and the round-end DCE fixpoint retires the compare and
;; any arm that lost its last predecessor.
;;
;; Exactly two implication rules, both EXACT -- no range analysis, no interval
;; join, no transitive chaining. Anything else refuses.
;;
;; R1 RANGE FLOOR. `counter <op> k` with a literal `k`, on the loop's OWN
;; counter phi, in signed i64. The counter's lower bound is the guard's:
;; `opt-bce-version-guard-finish` emits `first >= 0` (or proves it of a literal
;; first value) whenever a counter-cased derivation fired, which is exactly the
;; `counter-seen` flag recorded below. Every executed trip's counter lies in the
;; range opt-bce-mb-counter-range reported, [first, limit): the ascending loop
;; reaches that by strictly increasing from `first` under the no-wrap argument
;; the finisher documents (step 1 gives `last + 1 <= bound <= MAX` from the
;; latch's `< bound`; a larger step gets the explicit
;; `wrap(bound + step - 1) >= bound` conjunct), the descending loop by strictly
;; decreasing TOWARD `first`, which its latch's `>= first` is what tests. The
;; rule reads only the range's FLOOR, so it is the same rule either way. Hence
;; `counter >= first >= 0` at every point of the clone, and:
;;   counter >= k  /  counter > k   are TRUE  for k <= 0 / k < 0
;;   counter <  k  /  counter <= k  are FALSE for k <= 0 / k < 0
;; with the mirrored operand order (`k < counter` ...) normalized first. The
;; counter phi ITSELF is what the rule is about; the rule never looks at a
;; value derived from it, and it can never fold the latch/header test, whose
;; other operand is the invariant bound (a literal bound only reaches the
;; k <= 0 cases on a guard conjunction that is already unsatisfiable, since it
;; also demands `first >= 0 && first < limit`). A descending latch tests
;; `counter - s >= first`, whose other operand is that same `first`; a literal
;; one lands in the same unsatisfiable corner.
;;
;; R2 INVARIANT RECOMPUTATION. A compare in the loop whose BOTH operands are
;; loop-invariant (literal, or a var no loop block defines, after resolving
;; through in-loop copies/reinterprets) and which reproduces a guard conjunct
;; EXACTLY -- same operator, same operand values, same signed i64 operand type
;; the guard's conditions are built with -- is TRUE on the fast path. Operand
;; identity is SSA identity after the same resolution the derivation used, so
;; the recomputation and the conjunct are the same comparison of the same two
;; runtime values. Guard-local temporaries are freshly allocated ids that
;; appear in no original block, so a loop compare can never match a conjunct
;; over them.
;;
;; The single-block pass shares the guard finisher but needs no folding hook:
;; its clonable whitelist has no Branch, so its fast clone's only conditional
;; is the latch test itself.
;;
;; EDGE HYGIENE. Folding deletes one CFG edge. A phi in the dropped successor
;; that names this block would keep an input on an edge that no longer exists,
;; and the unreachable-block sweep only trims inputs from predecessors that
;; became unreachable, not from ones that merely stopped branching there. So a
;; fold is refused whenever the dropped successor -- in the loop or an exit
;; block outside it -- carries a phi input labelled with the folding block.
(defstruct OptBceFoldCond
  (op ir.CompilerIrBinOp)
  (lhs ir.CompilerIrValue)
  (rhs ir.CompilerIrValue))

(import (vector.vector OptBceFoldCond core) as opt_bce_fold_cond_vec)

(defstruct OptBceFoldCondList
  (items opt_bce_fold_cond_vec.Vec))

(define (opt-bce-fold-cond-list-new) : OptBceFoldCondList
  (OptBceFoldCondList (opt_bce_fold_cond_vec.with-capacity 4)))

(define (opt-bce-fold-cond-list-count [conds : OptBceFoldCondList]) : i64
  (opt_bce_fold_cond_vec.len (& conds.items)))

(define (opt-bce-fold-cond-list-prepend
  [conds : OptBceFoldCondList (:consume)]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptBceFoldCondList
  (let
    [items : opt_bce_fold_cond_vec.Vec conds.items]
    (begin
      (opt_bce_fold_cond_vec.push (&mut items) (OptBceFoldCond op lhs rhs))
      (OptBceFoldCondList items))))

(define (opt-bce-fold-cond-list-ref [conds : OptBceFoldCondList] [index : i64]) : OptBceFoldCond
  (let
    [items : opt_bce_fold_cond_vec.Vec conds.items]
    (array-ref
      (opt_bce_fold_cond_vec.slots (& items))
      (- (- (opt_bce_fold_cond_vec.len (& items)) index) 1))))

(cfg
  test
  (test
    optimizer-bce-fold-condition-dense-storage-grows
    (let
      [conds : OptBceFoldCondList (opt-bce-fold-cond-list-new)]
      (begin
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 0)
            (ir.CompilerIrValue.I64 10)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 1)
            (ir.CompilerIrValue.I64 11)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.I64 12)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 3)
            (ir.CompilerIrValue.I64 13)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 4)
            (ir.CompilerIrValue.I64 14)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 5)
            (ir.CompilerIrValue.I64 15)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 6)
            (ir.CompilerIrValue.I64 16)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 7)
            (ir.CompilerIrValue.I64 17)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 8)
            (ir.CompilerIrValue.I64 18)))
        (set!
          conds
          (opt-bce-fold-cond-list-prepend
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 8)
            (ir.CompilerIrValue.I64 18)))
        (test.assert-i64-eq
          (opt-bce-fold-cond-list-count conds)
          10
          "BCE fold condition storage grows and preserves duplicates")
        (test.assert-true
          (opt-bce-fold-cond-holds?
            conds
            (ir.CompilerIrBinOp.Eq)
            (ir.CompilerIrValue.Var 8)
            (ir.CompilerIrValue.I64 18))
          "BCE fold condition exact membership survives growth")
        (test.assert-true
          (not
            (opt-bce-fold-cond-holds?
              conds
              (ir.CompilerIrBinOp.Eq)
              (ir.CompilerIrValue.Var 8)
              (ir.CompilerIrValue.I64 19)))
          "BCE fold condition membership rejects a distinct rhs")
        (match (opt-bce-fold-cond-list-ref conds 1)
          [(OptBceFoldCond op lhs rhs)
            (begin
              (test.assert-true
                (opt-binop-eq op (ir.CompilerIrBinOp.Eq))
                "BCE fold condition operator is preserved")
              (test.assert-true
                (opt-value-eq lhs (ir.CompilerIrValue.Var 8))
                "BCE fold condition newest prior lhs is preserved")
              (test.assert-true
                (opt-value-eq rhs (ir.CompilerIrValue.I64 18))
                "BCE fold condition newest prior rhs is preserved"))])))))

;; What the guard establishes for the whole fast clone: its conjunct compares,
;; the blocks the fold inspects (every block for successor phis, the clone
;; group for definitions), and the counter's proven lower bound.
(defstruct OptBceFoldFacts
  (conds OptBceFoldCondList)
  (blocks ir.CompilerIrBlockList)
  (body-blocks ir.CompilerIrBlockList)
  (iphi i64)
  (counter-nonneg? bool))

(defenum OptBceFoldVerdict
  (Unknown)
  (True)
  (False))

;; Conjunct-walk depth. The And chain is one node per emitted condition and a
;; loop derives a handful; this only bounds a malformed chain.
(define (opt-bce-fold-conjunct-fuel) : i64
  64)

(define (opt-bce-version-guard-counter-seen? [acc : OptBceVersionGuardAcc]) : bool
  (match acc
    [(OptBceVersionGuardAcc.No) false]
    [(OptBceVersionGuardAcc.Some _ _ counter-seen) counter-seen]))

;; The comparisons the fold reasons about. BitTest* forms are deliberately out:
;; the guard never emits one, and R1 is about ordered i64 compares.
(define (opt-bce-fold-cond-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Eq) true]
    [(ir.CompilerIrBinOp.Ne) true]
    [(ir.CompilerIrBinOp.Lt) true]
    [(ir.CompilerIrBinOp.Le) true]
    [(ir.CompilerIrBinOp.Gt) true]
    [(ir.CompilerIrBinOp.Ge) true]
    [_ false]))

(define (opt-bce-fold-i64-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [_ false]))

(define (opt-bce-fold-guard-def
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptBceMbMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptBceMbMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (= (ir.compiler-ir-instr-loop-dst-or instr (- 0 1)) var)
        (OptBceMbMaybeInstr.Some instr)
        (opt-bce-fold-guard-def instrs (+ index 1) var)))))

;; Decompose the guard value into the conditions the fast edge proves. The
;; guard block branches on it, and it is built as an `And` tree over the
;; per-check condition values (opt-bce-version-and-chain), so every leaf of
;; that tree is non-zero on the taken fast edge. Only comparison leaves are
;; recorded; a leaf defined outside the guard block contributes nothing.
(define (opt-bce-fold-collect
  [instrs : ir.CompilerIrInstrSeq]
  [value : ir.CompilerIrValue]
  [fuel : i64]
  [acc : OptBceFoldCondList]) : OptBceFoldCondList
  (if (<= fuel 0)
    acc
    (match value
      [(ir.CompilerIrValue.Var var)
        (match (opt-bce-fold-guard-def instrs 0 var)
          [(OptBceMbMaybeInstr.No) acc]
          [(OptBceMbMaybeInstr.Some instr)
            (match instr
              [(ir.CompilerIrInstr.BinOp _ op lhs rhs cond-ty)
                (match op
                  [(ir.CompilerIrBinOp.And)
                    (opt-bce-fold-collect
                      instrs
                      rhs
                      (- fuel 1)
                      (opt-bce-fold-collect instrs lhs (- fuel 1) acc))]
                  [_
                    ;; Only SIGNED i64 conjuncts become facts: the folding
                    ;; rules below compare a loop compare against a conjunct by
                    ;; operator and operands alone, and an unsigned conjunct
                    ;; decides no signed comparison of the same two values.
                    (if (and
                      (opt-bce-fold-cond-op? op)
                      (opt-bce-fold-i64-type? cond-ty))
                      (opt-bce-fold-cond-list-prepend acc op lhs rhs)
                      acc)])]
              [_ acc])])]
      [_ acc])))

(define (opt-bce-fold-cond-holds?
  [conds : OptBceFoldCondList]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : bool
  (opt-bce-fold-cond-holds-from? conds op lhs rhs 0))

(define (opt-bce-fold-cond-holds-from?
  [conds : OptBceFoldCondList]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [index : i64]) : bool
  (if (>= index (opt-bce-fold-cond-list-count conds))
    false
    (match (opt-bce-fold-cond-list-ref conds index)
      [(OptBceFoldCond cond-op cond-lhs cond-rhs)
        (or
          (and
            (opt-binop-eq cond-op op)
            (opt-value-eq cond-lhs lhs)
            (opt-value-eq cond-rhs rhs))
          (opt-bce-fold-cond-holds-from? conds op lhs rhs (+ index 1)))])))

;; `counter <op> k` normalized with the counter on the left, given only
;; `counter >= 0`.
(define (opt-bce-fold-counter-verdict [op : ir.CompilerIrBinOp] [k : i64]) : OptBceFoldVerdict
  (match op
    [(ir.CompilerIrBinOp.Ge)
      (if (<= k 0)
        (OptBceFoldVerdict.True)
        (OptBceFoldVerdict.Unknown))]
    [(ir.CompilerIrBinOp.Gt)
      (if (< k 0)
        (OptBceFoldVerdict.True)
        (OptBceFoldVerdict.Unknown))]
    [(ir.CompilerIrBinOp.Lt)
      (if (<= k 0)
        (OptBceFoldVerdict.False)
        (OptBceFoldVerdict.Unknown))]
    [(ir.CompilerIrBinOp.Le)
      (if (< k 0)
        (OptBceFoldVerdict.False)
        (OptBceFoldVerdict.Unknown))]
    [_ (OptBceFoldVerdict.Unknown)]))

;; `k <op> counter` reads as `counter <mirror(op)> k`.
(define (opt-bce-fold-mirror-op [op : ir.CompilerIrBinOp]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Lt) (ir.CompilerIrBinOp.Gt)]
    [(ir.CompilerIrBinOp.Le) (ir.CompilerIrBinOp.Ge)]
    [(ir.CompilerIrBinOp.Gt) (ir.CompilerIrBinOp.Lt)]
    [(ir.CompilerIrBinOp.Ge) (ir.CompilerIrBinOp.Le)]
    [_ op]))

(define (opt-bce-fold-counter-operand?
  [body-blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var raw)
      (= (opt-bce-mb-resolve body-blocks raw 16) iphi)]
    [_ false]))

;; A compare operand's canonical spelling for R2: a literal, or a var that no
;; loop block defines once in-loop copies are resolved away. Anything the loop
;; itself computes is not invariant and never matches a guard conjunct.
(define (opt-bce-fold-invariant-operand
  [body-blocks : ir.CompilerIrBlockList]
  [value : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrValue.I64 k)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.I64 k))]
    [(ir.CompilerIrValue.Var raw)
      (let
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (match (opt-bce-mb-find-def body-blocks id)
          [(OptBceMbMaybeInstr.Some _) (ir.CompilerIrMaybeValue.No)]
          [(OptBceMbMaybeInstr.No)
            (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var id))]))]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-bce-fold-invariant-verdict
  [facts : OptBceFoldFacts]
  [body-blocks : ir.CompilerIrBlockList]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : OptBceFoldVerdict
  (match (opt-bce-fold-invariant-operand body-blocks lhs)
    [(ir.CompilerIrMaybeValue.No) (OptBceFoldVerdict.Unknown)]
    [(ir.CompilerIrMaybeValue.Some canon-lhs)
      (match (opt-bce-fold-invariant-operand body-blocks rhs)
        [(ir.CompilerIrMaybeValue.No) (OptBceFoldVerdict.Unknown)]
        [(ir.CompilerIrMaybeValue.Some canon-rhs)
          (if (opt-bce-fold-cond-holds? facts.conds op canon-lhs canon-rhs)
            (OptBceFoldVerdict.True)
            (OptBceFoldVerdict.Unknown))])]))

;; The verdict for one comparison evaluated anywhere in the fast clone.
(define (opt-bce-fold-compare-verdict
  [facts : OptBceFoldFacts]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptBceFoldVerdict
  (if (not (and (opt-bce-fold-cond-op? op) (opt-bce-fold-i64-type? ty)))
    (OptBceFoldVerdict.Unknown)
    (let
      [body-blocks : ir.CompilerIrBlockList facts.body-blocks]
      [iphi : i64 facts.iphi]
      [monotone? : bool (and facts.counter-nonneg? (>= iphi 0))]
      (cond
        [(and monotone? (opt-bce-fold-counter-operand? body-blocks iphi lhs))
          (match rhs
            [(ir.CompilerIrValue.I64 k) (opt-bce-fold-counter-verdict op k)]
            [_ (OptBceFoldVerdict.Unknown)])]
        [(and monotone? (opt-bce-fold-counter-operand? body-blocks iphi rhs))
          (match lhs
            [(ir.CompilerIrValue.I64 k)
              (opt-bce-fold-counter-verdict (opt-bce-fold-mirror-op op) k)]
            [_ (OptBceFoldVerdict.Unknown)])]
        [else (opt-bce-fold-invariant-verdict facts body-blocks op lhs rhs)]))))

(define (opt-bce-fold-phi-from-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [label : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (if (opt-bce-fold-phi-input-from? inputs label)
          true
          (opt-bce-fold-phi-from-instrs? instrs (+ index 1) label))]
      [_ (opt-bce-fold-phi-from-instrs? instrs (+ index 1) label)])))

(define (opt-bce-fold-phi-input-from?
  [inputs : ir.CompilerIrPhiInputList]
  [label : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-fold-phi-input-from?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        label)]
    [(ir.CompilerIrPhiInputList.Cons _ input-label rest)
      (if (= input-label label)
        true
        (opt-bce-fold-phi-input-from? (__tl-box-place rest) label))]))

;; May the edge `label -> dropped` disappear? Only when nothing in `dropped`
;; selects a value on it. A successor that cannot be found rejects.
(define (opt-bce-fold-drop-edge-ok?
  [facts : OptBceFoldFacts]
  [label : i64]
  [dropped : i64]) : bool
  (match (opt-cfg-find-block facts.blocks dropped)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (not (opt-bce-fold-phi-from-instrs? instrs 0 label))])]))

;; The verdict for one cloned conditional branch, edge hygiene included.
(define (opt-bce-fold-branch-verdict
  [facts : OptBceFoldFacts]
  [label : i64]
  [cond : ir.CompilerIrValue]
  [then-label : i64]
  [else-label : i64]) : OptBceFoldVerdict
  (match cond
    [(ir.CompilerIrValue.Var raw)
      (let
        [body-blocks : ir.CompilerIrBlockList facts.body-blocks]
        [id : i64 (opt-bce-mb-resolve body-blocks raw 16)]
        (match (opt-bce-mb-find-def body-blocks id)
          [(OptBceMbMaybeInstr.No) (OptBceFoldVerdict.Unknown)]
          [(OptBceMbMaybeInstr.Some instr)
            (match instr
              [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
                (match (opt-bce-fold-compare-verdict facts op lhs rhs ty)
                  [(OptBceFoldVerdict.Unknown) (OptBceFoldVerdict.Unknown)]
                  [(OptBceFoldVerdict.True)
                    (if (opt-bce-fold-drop-edge-ok? facts label else-label)
                      (OptBceFoldVerdict.True)
                      (OptBceFoldVerdict.Unknown))]
                  [(OptBceFoldVerdict.False)
                    (if (opt-bce-fold-drop-edge-ok? facts label then-label)
                      (OptBceFoldVerdict.False)
                      (OptBceFoldVerdict.Unknown))])]
              [_ (OptBceFoldVerdict.Unknown)])]))]
    [_ (OptBceFoldVerdict.Unknown)]))

;; --- fast-clone emission --------------------------------------------------------
(define (opt-bce-mb-fast-label [body-labels : OptLabelSet] [label : i64]) : i64
  (if (opt-label-contains body-labels label)
    (ir.compiler-ir-label
      (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_fast"))
    label))

;; Pass A: allocate a fresh id for every def in the loop BEFORE any clone
;; substitutes (loop-carried references cross blocks in both directions).
(define (opt-bce-mb-alloc-defs-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (let
      [dst : i64 (opt-bce-mb-instr-seq-dst-or instrs index (- 0 1))]
      (begin
        (if (>= dst 0)
          (begin
            (opt-unroll-clone-dst remap cell dst)
            unit)
          unit)
        (opt-bce-mb-alloc-defs-instrs! instrs (+ index 1) remap cell)))))

(define (opt-bce-mb-alloc-defs!
  [blocks : ir.CompilerIrBlockList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-bce-mb-alloc-defs-instrs! instrs 0 remap cell)
            (opt-bce-mb-alloc-defs! (__tl-box-place rest) remap cell))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-alloc-defs! (ir.compiler-ir-block-seq-to-list seq) remap cell)]))

(define (opt-bce-mb-remap-dst
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [dst : i64]) : i64
  (match (opt-unroll-subst-value remap (ir.CompilerIrValue.Var dst))
    [(ir.CompilerIrValue.Var fresh) fresh]
    [_ dst]))

;; Substitute a call's arguments through the clone's dense id REMAP.
;;
;; `opt-copy-subst-call-args` does the same shape of work but resolves through
;; an `OptCopyEnv` association list, which this pass does not build: the clone's
;; renaming lives in the remap array the fresh-id pass filled, and is read with
;; `opt-unroll-subst-value` everywhere else in this cloner. An `Array` argument
;; list is copied into a fresh array rather than mutated, because the original
;; instruction stays live in the SLOW loop and shares that storage.
(define (opt-bce-mb-subst-call-args-array
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [src : (__tl_dyn-array ir.CompilerIrValue)]
  [out : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length src))
    unit
    (begin
      (set!
        (array-ref out index)
        (opt-unroll-subst-value remap (array-ref src index)))
      (opt-bce-mb-subst-call-args-array remap src out (+ index 1)))))

(define (opt-bce-mb-subst-call-args
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) (ir.CompilerIrCallArgs.Nil)]
    [(ir.CompilerIrCallArgs.One value)
      (ir.CompilerIrCallArgs.One (opt-unroll-subst-value remap value))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (opt-unroll-subst-value remap a)
        (opt-unroll-subst-value remap b))]
    [(ir.CompilerIrCallArgs.Array values)
      (let
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue (array-length values))]
        (begin
          (opt-bce-mb-subst-call-args-array remap values out 0)
          (ir.CompilerIrCallArgs.Array out)))]))

(define (opt-bce-mb-clone-switch-cases-acc
  [cases : ir.CompilerIrSwitchCaseList]
  [body-labels : OptLabelSet]
  [acc : ir.CompilerIrSwitchCaseList]) : ir.CompilerIrSwitchCaseList
  (match (ir.compiler-ir-switch-case-list-force-cons cases)
    [(ir.CompilerIrSwitchCaseList.Nil) acc]
    [(ir.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(ir.CompilerIrSwitchCase.Case tag label)
          (opt-bce-mb-clone-switch-cases-acc
            (__tl-box-place rest)
            body-labels
            (ir.compiler-ir-switch-case-cons-linked
              tag
              (opt-bce-mb-fast-label body-labels label)
              acc))])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-bce-mb-clone-switch-cases-acc
        (ir.compiler-ir-switch-case-seq-to-list seq)
        body-labels
        acc)]))

(define (opt-bce-mb-clone-switch-cases
  [cases : ir.CompilerIrSwitchCaseList]
  [body-labels : OptLabelSet]) : ir.CompilerIrSwitchCaseList
  (ir.compiler-ir-switch-case-list-compact-reversed
    (opt-bce-mb-clone-switch-cases-acc
      cases
      body-labels
      ir.CompilerIrSwitchCaseList.Nil)))

(define (opt-bce-mb-clone-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-clone-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        remap
        body-labels
        preheader
        guard-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-unroll-subst-value remap value)
        ;; only header phis carry a preheader input: it now comes from the
        ;; guard; every other loop-edge input comes from the fast clone.
        (if (= label preheader)
          guard-label
          (opt-bce-mb-fast-label body-labels label))
        (opt-bce-mb-clone-phi-inputs
          (__tl-box-place rest)
          remap
          body-labels
          preheader
          guard-label))]))

(define (opt-bce-mb-clone-instr
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]
  [facts : OptBceFoldFacts]
  [label : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap lhs)
        (opt-unroll-subst-value remap rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    ;; A direct call: the callee name is a symbol and stays as it is, the
    ;; arguments substitute through the remap, and the dst rebases like any
    ;; other def -- the fresh-id pass allocated one for it, because
    ;; opt-bce-mb-instr-dst-or reports it. Only `Call` reaches here; every other
    ;; call form is outside opt-bce-mb-body-instr-ok?.
    [(ir.CompilerIrInstr.Call dst name args ty)
      (ir.CompilerIrInstr.Call
        (opt-bce-mb-remap-dst remap dst)
        name
        (opt-bce-mb-subst-call-args remap args)
        ty)]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        (opt-bce-mb-remap-dst remap dst)
        (opt-bce-mb-clone-phi-inputs
          inputs
          remap
          body-labels
          preheader
          guard-label)
        ty)]
    [(ir.CompilerIrInstr.Jump target)
      (ir.CompilerIrInstr.Jump (opt-bce-mb-fast-label body-labels target))]
    ;; A branch the guard already decides becomes the jump it always takes;
    ;; DCE retires the compare and any arm that lost its last predecessor.
    [(ir.CompilerIrInstr.Branch cond then-label else-label)
      (match (opt-bce-fold-branch-verdict
        facts
        label
        cond
        then-label
        else-label)
        [(OptBceFoldVerdict.True)
          (ir.CompilerIrInstr.Jump
            (opt-bce-mb-fast-label body-labels then-label))]
        [(OptBceFoldVerdict.False)
          (ir.CompilerIrInstr.Jump
            (opt-bce-mb-fast-label body-labels else-label))]
        [(OptBceFoldVerdict.Unknown)
          (ir.CompilerIrInstr.Branch
            (opt-unroll-subst-value remap cond)
            (opt-bce-mb-fast-label body-labels then-label)
            (opt-bce-mb-fast-label body-labels else-label))])]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        (opt-unroll-subst-value remap index)
        base
        (opt-bce-mb-clone-switch-cases cases body-labels)
        (opt-bce-mb-fast-label body-labels default-label))]
    ;; A kept (underivable) check: remap operands and the ok edge. An ok-label
    ;; naming a real loop block remaps to its fast clone; one naming a real
    ;; block OUTSIDE the loop stays shared; anything else is a synthetic
    ;; mid-block continuation label the backend re-emits at the check site, so
    ;; it must be uniquified per clone or the slow and fast blocks define it
    ;; twice.
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (opt-unroll-subst-value remap index)
        (opt-unroll-subst-value remap length)
        (if (opt-label-contains body-labels ok-label)
          (opt-bce-mb-fast-label body-labels ok-label)
          (if (opt-label-contains all-labels ok-label)
            ok-label
            (ir.compiler-ir-label
              (str_cat.str-cat
                (ir.compiler-ir-label-text ok-label)
                "__bce_fast")))))]
    ;; unreachable: the shape scan whitelisted every loop instruction
    [_ instr]))

;; Every block label in the function: a kept check's ok-label that names a
;; real block outside the loop must NOT be renamed, while a synthetic
;; mid-block continuation label (no such block exists) MUST be uniquified.
(define (opt-bce-mb-all-labels-from
  [blocks : ir.CompilerIrBlockList]
  [acc : OptLabelSet]) : OptLabelSet
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (opt-bce-mb-all-labels-from
            (__tl-box-place rest)
            (opt-label-add acc label))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-all-labels-from (ir.compiler-ir-block-seq-to-list seq) acc)]))

;; Pass B: clone a loop's instructions, dropping every BoundsCheck the guard
;; proved non-failing and remapping the kept underivable ones (partial
;; versioning: the fast clone is not necessarily check-free).
(define (opt-bce-mb-clone-instrs
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]
  [facts : OptBceFoldFacts]
  [keep : OptBceMbKeep]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.BoundsCheck _ _ _)
          (if (opt-bce-mb-keep-contains? keep label index)
            (ir.compiler-ir-instr-cons
              (opt-bce-mb-clone-instr
                remap
                body-labels
                all-labels
                preheader
                guard-label
                facts
                label
                instr)
              (opt-bce-mb-clone-instrs
                label
                instrs
                (+ index 1)
                remap
                body-labels
                all-labels
                preheader
                guard-label
                facts
                keep))
            (opt-bce-mb-clone-instrs
              label
              instrs
              (+ index 1)
              remap
              body-labels
              all-labels
              preheader
              guard-label
              facts
              keep))]
        [_
          (ir.compiler-ir-instr-cons
            (opt-bce-mb-clone-instr
              remap
              body-labels
              all-labels
              preheader
              guard-label
              facts
              label
              instr)
            (opt-bce-mb-clone-instrs
              label
              instrs
              (+ index 1)
              remap
              body-labels
              all-labels
              preheader
              guard-label
              facts
              keep))]))))

(define (opt-bce-mb-clone-blocks
  [blocks : ir.CompilerIrBlockList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [all-labels : OptLabelSet]
  [preheader : i64]
  [guard-label : i64]
  [facts : OptBceFoldFacts]
  [keep : OptBceMbKeep]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.compiler-ir-block
              (ir.compiler-ir-label
                (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_fast"))
              (opt-bce-mb-clone-instrs
                label
                instrs
                0
                remap
                body-labels
                all-labels
                preheader
                guard-label
                facts
                keep))
            (opt-bce-mb-clone-blocks
              (__tl-box-place rest)
              remap
              body-labels
              all-labels
              preheader
              guard-label
              facts
              keep))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-clone-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        remap
        body-labels
        all-labels
        preheader
        guard-label
        facts
        keep)]))

;; --- rewrite --------------------------------------------------------------------
;; Extend outside phis: every input carried on a loop edge gains a parallel
;; input carrying the fast clone's remapped value on the fast edge.
(define (opt-bce-mb-extend-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [body-labels : OptLabelSet]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-extend-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        body-labels
        remap)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : ir.CompilerIrPhiInputList
          (opt-bce-mb-extend-phi-inputs (__tl-box-place rest) body-labels remap)]
        (if (opt-label-contains body-labels label)
          (ir.compiler-ir-phi-input-cons
            value
            label
            (ir.compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap value)
              (ir.compiler-ir-label
                (str_cat.str-cat (ir.compiler-ir-label-text label) "__bce_fast"))
              tail))
          (ir.compiler-ir-phi-input-cons value label tail)))]))

(define (opt-bce-mb-extend-exit-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [body-labels : OptLabelSet]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (ir.compiler-ir-instr-cons
        (match instr
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (ir.CompilerIrInstr.Phi
              dst
              (opt-bce-mb-extend-phi-inputs inputs body-labels remap)
              ty)]
          [_ instr])
        (opt-bce-mb-extend-exit-instrs instrs (+ index 1) body-labels remap)))))

(define (opt-bce-mb-blocks-cons-onto
  [fast-blocks : ir.CompilerIrBlockList]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match fast-blocks
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        block
        (opt-bce-mb-blocks-cons-onto (__tl-box-place rest) tail))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-blocks-cons-onto (ir.compiler-ir-block-seq-to-list seq) tail)]))

(define (opt-bce-mb-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [guard-block : ir.CompilerIrBlock]
  [fast-blocks : ir.CompilerIrBlockList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-bce-mb-rewrite-blocks
                (__tl-box-place rest)
                shape
                guard-block
                fast-blocks
                remap)]
            (cond
              [(= label shape.header)
                ;; guard + fast group immediately before the slow header: a
                ;; fallthrough preheader lands on the guard, and the fast
                ;; group preserves loop order for intra-loop fallthroughs.
                (ir.compiler-ir-block-cons
                  guard-block
                  (opt-bce-mb-blocks-cons-onto
                    fast-blocks
                    (ir.compiler-ir-block-cons
                      (ir.compiler-ir-block
                        label
                        (opt-relabel-phi-instrs
                          instrs
                          0
                          shape.preheader
                          (ir.compiler-ir-label
                            (str_cat.str-cat
                              (ir.compiler-ir-label-text shape.header)
                              "__bce_guard"))))
                      tail)))]
              [(= label shape.preheader)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-unroll-retarget-instrs
                      instrs
                      0
                      shape.header
                      (ir.compiler-ir-label
                        (str_cat.str-cat
                          (ir.compiler-ir-label-text shape.header)
                          "__bce_guard"))))
                  tail)]
              [(opt-label-contains shape.body-labels label)
                (ir.compiler-ir-block-cons block tail)]
              [else
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-bce-mb-extend-exit-instrs
                      instrs
                      0
                      shape.body-labels
                      remap))
                  tail)]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        shape
        guard-block
        fast-blocks
        remap)]))

;; --- fast-exit check specialization -------------------------------------------
;;
;; A versioned loop's exit block is shared: the edge that skips the loop, the
;; slow checked loop, and the fast check-free clone all arrive there, so a
;; BoundsCheck in it must stay for the arrivals that prove nothing (the skip
;; edge's value is entirely unchecked). On the fast arrivals the exit value
;; of a bounded header phi is provably in range: it stays within
;; [seed, scan] on every executed iteration, the +1 counter exits exactly at
;; its bound, a strict BoundsCheck(bound, len) dominating the preheader gives
;; bound < len, and the guard's seed >= 0 condition gives value >= 0. When
;; every fast-latch input of the checked phi is such a bounded value, give
;; the fast arrivals their own copy of the exit block without the check;
;; every other arrival keeps the original checked block.
;; Fast-clone labels of the shape's body labels.
(define (opt-bce-mb-fast-labels-from [labels : OptLabelSet] [acc : OptLabelSet]) : OptLabelSet
  (match labels
    [(OptLabelSet.Nil) acc]
    [(OptLabelSet.Dense _ _)
      (opt-bce-mb-fast-labels-from
        (opt-label-tail labels)
        (opt-label-add
          acc
          (ir.compiler-ir-label
            (str_cat.str-cat
              (ir.compiler-ir-label-text (opt-label-ref labels 0))
              "__bce_fast"))))]))

;; Is `var` defined by a Phi instruction in this block's instruction seq?
(define (opt-bce-mb-block-phi-var?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst _ _)
        (if (= dst var)
          true
          (opt-bce-mb-block-phi-var? instrs (+ index 1) var))]
      [_ (opt-bce-mb-block-phi-var? instrs (+ index 1) var)])))

;; Is `var` the dst of a Cast in this block whose source is a phi defined here?
;; The phi var feeding `var`, when `var` is a phi of this block or a cast of
;; one; -1 otherwise.
(define (opt-bce-mb-phi-src-of [instrs : ir.CompilerIrInstrSeq] [var : i64]) : i64
  (if (opt-bce-mb-block-phi-var? instrs 0 var)
    var
    (let
      [walk : i64 0]
      [found : i64 -1]
      (begin
        (while (< walk (ir.compiler-ir-instr-seq-count instrs))
          (begin
            (match (ir.compiler-ir-instr-seq-ref instrs walk)
              [(ir.CompilerIrInstr.Cast dst src _ _)
                (match src
                  [(ir.CompilerIrValue.Var v)
                    (if (and (= dst var) (opt-bce-mb-block-phi-var? instrs 0 v))
                      (set! found v)
                      unit)]
                  [_ unit])]
              [_ unit])
            (set! walk (+ walk 1))))
        found))))

(defenum OptBceMbExitCheck
  (No)
  (Some i64 i64 ir.CompilerIrValue))

;; The first BoundsCheck in this block whose index is a phi defined here (or
;; a cast of one): (check position, phi var, length).
(define (opt-bce-mb-find-exit-check
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : OptBceMbExitCheck
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptBceMbExitCheck.No)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BoundsCheck idx len _)
        (match idx
          [(ir.CompilerIrValue.Var v)
            (let
              [phi-var : i64 (opt-bce-mb-phi-src-of instrs v)]
              (if (>= phi-var 0)
                (OptBceMbExitCheck.Some index phi-var len)
                (opt-bce-mb-find-exit-check instrs (+ index 1))))]
          [_ (opt-bce-mb-find-exit-check instrs (+ index 1))])]
      [_ (opt-bce-mb-find-exit-check instrs (+ index 1))])))

;; Canonical spelling of a value for cross-block comparison: vars resolved
;; through the block list's single-def Mov chains, and through same-width
;; int-to-int casts (a bit-preserving reinterpret, as in the bounds_dom
;; canonicalization).
(define (opt-bce-mb-canon-value
  [blocks : ir.CompilerIrBlockList]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var v)
      (let
        [resolved : i64 (opt-bce-mb-resolve blocks v 16)]
        (match (opt-bce-mb-find-def blocks resolved)
          [(OptBceMbMaybeInstr.No) (ir.CompilerIrValue.Var resolved)]
          [(OptBceMbMaybeInstr.Some instr)
            (match instr
              [(ir.CompilerIrInstr.Cast _ src from-ty to-ty)
                (if (and
                  (opt-bounds-dom-reinterpret-cast? from-ty to-ty)
                  (match src
                    [(ir.CompilerIrValue.Var _) true]
                    [_ false]))
                  (opt-bce-mb-canon-value blocks src)
                  (ir.CompilerIrValue.Var resolved))]
              [_ (ir.CompilerIrValue.Var resolved)])]))]
    [_ value]))

;; The bounded header phi of the loop: a header phi, not the counter, whose
;; loop-entry input (from the preheader, or from the guard after the rewrite
;; has spliced it in) is the counter's seed. -1 when none matches.
(define (opt-bce-mb-find-bounded-phi-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [blocks : ir.CompilerIrBlockList]
  [preheader : i64]
  [guard-label : i64]
  [cseed : ir.CompilerIrValue]
  [iphi : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    -1
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst inputs _)
        (if (and
          (not (= dst iphi))
          (let
            [walk : ir.CompilerIrPhiInputList inputs]
            [hit : bool false]
            (while (not hit)
              (match (ir.compiler-ir-phi-input-list-force-cons walk)
                [(ir.CompilerIrPhiInputList.Nil) (set! hit true)]
                [(ir.CompilerIrPhiInputList.Array seq)
                  (begin
                    (set! walk (ir.compiler-ir-phi-input-seq-to-list seq))
                    unit)]
                [(ir.CompilerIrPhiInputList.Cons value label rest)
                  (if (and
                    (or (= label preheader) (= label guard-label))
                    (opt-value-eq (opt-bce-mb-canon-value blocks value) cseed))
                    (set! hit true)
                    (set! walk (__tl-box-place rest)))]))
            hit))
          dst
          (opt-bce-mb-find-bounded-phi-instrs
            instrs
            (+ index 1)
            blocks
            preheader
            guard-label
            cseed
            iphi))]
      [_
        (opt-bce-mb-find-bounded-phi-instrs
          instrs
          (+ index 1)
          blocks
          preheader
          guard-label
          cseed
          iphi)])))

(define (opt-bce-mb-find-bounded-phi
  [body-blocks : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [preheader : i64]
  [guard-label : i64]
  [cseed : ir.CompilerIrValue]
  [iphi : i64]) : i64
  (match body-blocks
    [(ir.CompilerIrBlockList.Nil) -1]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (= label header)
            (opt-bce-mb-find-bounded-phi-instrs
              instrs
              0
              blocks
              preheader
              guard-label
              cseed
              iphi)
            (opt-bce-mb-find-bounded-phi
              (__tl-box-place rest)
              blocks
              header
              preheader
              guard-label
              cseed
              iphi))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-bounded-phi
        (ir.compiler-ir-block-seq-to-list seq)
        blocks
        header
        preheader
        guard-label
        cseed
        iphi)]))

;; Every fast-latch input of the phi is a bounded value in the fast clone
;; (stays within [seed, scan] each executed iteration). Counts fast and
;; non-fast inputs; the split needs at least one of each.
(define (opt-bce-mb-exit-phi-inputs-scan
  [inputs : ir.CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [fast-blocks : ir.CompilerIrBlockList]
  [fast-bounded : i64]
  [fast-seen : i64]
  [other-seen : i64]
  [provable : bool]) : i64
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil)
      (if (and provable (> fast-seen 0) (> other-seen 0))
        1
        0)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-exit-phi-inputs-scan
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        fast-blocks
        fast-bounded
        fast-seen
        other-seen
        provable)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-exit-phi-inputs-scan
          (__tl-box-place rest)
          fast-labels
          fast-blocks
          fast-bounded
          (+ fast-seen 1)
          other-seen
          (and
            provable
            (>= fast-bounded 0)
            (opt-bce-mb-bounded-value? fast-blocks fast-bounded value 16)))
        (opt-bce-mb-exit-phi-inputs-scan
          (__tl-box-place rest)
          fast-labels
          fast-blocks
          fast-bounded
          fast-seen
          (+ other-seen 1)
          provable))]))

;; The phi inputs that belong to the fast latch edges (kept in the copy).
(define (opt-bce-mb-exit-seed-nonnegative?
  [guard-instrs : ir.CompilerIrInstrSeq]
  [blocks : ir.CompilerIrBlockList]
  [seed : ir.CompilerIrValue]
  [iphi : i64]) : bool
  (match seed
    [(ir.CompilerIrValue.I64 value) (>= value 0)]
    [_
      (let
        [cseed : ir.CompilerIrValue (opt-bce-mb-canon-value blocks seed)]
        [index : i64 0]
        [count : i64 (ir.compiler-ir-instr-seq-count guard-instrs)]
        [found : bool false]
        (begin
          (while (and (< index count) (not found))
            (begin
              (match (ir.compiler-ir-instr-seq-ref guard-instrs index)
                [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
                  (if (and
                    (or
                      (opt-binop-eq op (ir.CompilerIrBinOp.Ge))
                      (opt-binop-eq op (ir.CompilerIrBinOp.Gt)))
                    (let
                      [clhs : ir.CompilerIrValue
                        (opt-bce-mb-canon-value blocks lhs)]
                      (or
                        (opt-value-eq clhs cseed)
                        (opt-value-eq clhs (ir.CompilerIrValue.Var iphi))))
                    (match rhs
                      [(ir.CompilerIrValue.I64 v)
                        (if (opt-binop-eq op (ir.CompilerIrBinOp.Ge))
                          (>= v 0)
                          (>= v -1))]
                      [_ false]))
                    (set! found true)
                    unit)]
                [_ unit])
              (set! index (+ index 1))))
          found))]))

;; Does any instruction in this block's terminator mention `label`?
(define (opt-bce-mb-block-targets?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [label : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Branch _ true-label false-label)
        (or
          (= true-label label)
          (= false-label label)
          (opt-bce-mb-block-targets? instrs (+ index 1) label))]
      [(ir.CompilerIrInstr.Jump target)
        (or
          (= target label)
          (opt-bce-mb-block-targets? instrs (+ index 1) label))]
      [_ (opt-bce-mb-block-targets? instrs (+ index 1) label)])))

;; Labels of blocks whose terminator mentions `label`.
(define (opt-bce-mb-preds-from
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [acc : OptLabelSet]) : OptLabelSet
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label instrs)
          (if (opt-bce-mb-block-targets? instrs 0 label)
            (opt-bce-mb-preds-from
              (__tl-box-place rest)
              label
              (opt-label-add acc block-label))
            (opt-bce-mb-preds-from (__tl-box-place rest) label acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-preds-from (ir.compiler-ir-block-seq-to-list seq) label acc)]))

;; A strict BoundsCheck(bound, len) in this block?
(define (opt-bce-mb-block-has-strict-check?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [blocks : ir.CompilerIrBlockList]
  [bound : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BoundsCheck idx ilen _)
        (if (and
          (opt-value-eq
            (opt-bce-mb-canon-value blocks idx)
            (opt-bce-mb-canon-value blocks bound))
          (opt-value-eq
            (opt-bce-mb-canon-value blocks ilen)
            (opt-bce-mb-canon-value blocks len)))
          true
          (opt-bce-mb-block-has-strict-check?
            instrs
            (+ index 1)
            blocks
            bound
            len))]
      [_
        (opt-bce-mb-block-has-strict-check? instrs (+ index 1) blocks bound len)])))

;; Walk the single-predecessor chain backward from `label`; a block on the
;; chain dominates it. True when a strict BoundsCheck(bound, len) appears.
(define (opt-bce-mb-strict-check-chain?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [bound : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [fuel : i64]) : bool
  (if (<= fuel 0)
    false
    (let
      [instrs : ir.CompilerIrInstrSeq (opt-bce-mb-find-block-seq blocks label)]
      (if (ir.compiler-ir-instr-seq-empty? instrs)
        false
        (if (opt-bce-mb-block-has-strict-check? instrs 0 blocks bound len)
          true
          (let
            [preds : OptLabelSet
              (opt-bce-mb-preds-from blocks label (OptLabelSet.Nil))]
            (if (= (opt-label-count preds) 1)
              (opt-bce-mb-strict-check-chain?
                blocks
                (opt-label-ref preds 0)
                bound
                len
                (- fuel 1))
              false)))))))

;; Retarget every fast-clone block's terminators from the shared exit to the
;; new fast exit.
(define (opt-bce-mb-block-phi-inputs
  [instrs : ir.CompilerIrInstrSeq]
  [phi-var : i64]) : ir.CompilerIrPhiInputList
  (let
    [walk : i64 0]
    [found : ir.CompilerIrPhiInputList (ir.CompilerIrPhiInputList.Nil)]
    (begin
      (while (< walk (ir.compiler-ir-instr-seq-count instrs))
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs walk)
            [(ir.CompilerIrInstr.Phi dst inputs _)
              (if (= dst phi-var)
                (set! found inputs)
                unit)]
            [_ unit])
          (set! walk (+ walk 1))))
      found)))

(define (opt-bce-mb-find-block-seq
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : ir.CompilerIrInstrSeq
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.compiler-ir-instr-seq-empty)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label instrs)
          (if (= block-label label)
            instrs
            (opt-bce-mb-find-block-seq (__tl-box-place rest) label))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-block-seq (ir.compiler-ir-block-seq-to-list seq) label)]))

;; Top-level drive: find the first outside block whose checked exit phi is
;; provably in range on every fast arrival and split it. `blocks` is the
;; walk tail; `all-blocks` is the full rewritten function for
;; canonicalization, predecessor scans, and the strict-check chain.
(defenum OptBceMbExitSplit
  (No)
  (Some i64 i64 i64 ir.CompilerIrValue OptLabelSet))

;; Find the first outside block whose checked exit phi is provably in range
;; on every fast arrival. `blocks` is the walk tail; `all-blocks` is the
;; full rewritten function for canonicalization, predecessor scans, and the
;; strict-check chain.
(define (opt-bce-mb-find-exit-split
  [blocks : ir.CompilerIrBlockList]
  [all-blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [fast-blocks : ir.CompilerIrBlockList]
  [fast-bounded : i64]
  [guard-instrs : ir.CompilerIrInstrSeq]) : OptBceMbExitSplit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBceMbExitSplit.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [body-labels : OptLabelSet shape.body-labels]
            (if (or
              (opt-label-contains body-labels label)
              (= label shape.header)
              (= label shape.preheader)
              (=
                label
                (ir.compiler-ir-label
                  (str_cat.str-cat
                    (ir.compiler-ir-label-text shape.header)
                    "__bce_guard")))
              (opt-label-contains
                (opt-bce-mb-fast-labels-from body-labels (OptLabelSet.Nil))
                label))
              (opt-bce-mb-find-exit-split
                (__tl-box-place rest)
                all-blocks
                shape
                fast-blocks
                fast-bounded
                guard-instrs)
              (match (opt-bce-mb-find-exit-check instrs 0)
                [(OptBceMbExitCheck.No)
                  (opt-bce-mb-find-exit-split
                    (__tl-box-place rest)
                    all-blocks
                    shape
                    fast-blocks
                    fast-bounded
                    guard-instrs)]
                [(OptBceMbExitCheck.Some check-pos phi-var len)
                  (let
                    [fast-labels : OptLabelSet
                      (opt-bce-mb-fast-labels-from
                        body-labels
                        (OptLabelSet.Nil))]
                    [inputs : ir.CompilerIrPhiInputList
                      (opt-bce-mb-block-phi-inputs instrs phi-var)]
                    (if (and
                      (=
                        (opt-bce-mb-exit-phi-inputs-scan
                          inputs
                          fast-labels
                          fast-blocks
                          fast-bounded
                          0
                          0
                          true)
                        1)
                      (opt-bce-mb-exit-seed-nonnegative?
                        guard-instrs
                        all-blocks
                        shape.seed
                        shape.iphi)
                      (opt-bce-mb-strict-check-chain?
                        all-blocks
                        shape.preheader
                        shape.bound
                        len
                        16))
                      (OptBceMbExitSplit.Some
                        label
                        check-pos
                        phi-var
                        len
                        fast-labels)
                      (opt-bce-mb-find-exit-split
                        (__tl-box-place rest)
                        all-blocks
                        shape
                        fast-blocks
                        fast-bounded
                        guard-instrs)))])))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-find-exit-split
        (ir.compiler-ir-block-seq-to-list seq)
        all-blocks
        shape
        fast-blocks
        fast-bounded
        guard-instrs)]))

;; Split the first qualifying exit block over the whole rewritten function.
;; Walk the block list and rewrite the exit block via the sink; the
;; caller-provided check blocks land immediately before it.
(define (opt-bce-mb-sink-exit-block-list
  [blocks : ir.CompilerIrBlockList]
  [exit-label : i64]
  [check-pos : i64]
  [phi-var : i64]
  [fast-labels : OptLabelSet]
  [check-blocks : ir.CompilerIrBlockList]
  [gen : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (= label exit-label)
            (opt-bce-mb-blocks-cons-onto
              check-blocks
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block
                  label
                  (opt-bce-mb-sink-exit-instrs
                    instrs
                    0
                    check-pos
                    phi-var
                    fast-labels
                    exit-label
                    gen))
                (__tl-box-place rest)))
            (ir.compiler-ir-block-cons
              block
              (opt-bce-mb-sink-exit-block-list
                (__tl-box-place rest)
                exit-label
                check-pos
                phi-var
                fast-labels
                check-blocks
                gen)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-sink-exit-block-list
        (ir.compiler-ir-block-seq-to-list seq)
        exit-label
        check-pos
        phi-var
        fast-labels
        check-blocks
        gen)]))

;; The exit block's instructions minus the check (and its now-unused
;; cast): every other instruction is preserved as-is.
(define (opt-bce-mb-sink-exit-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [check-pos : i64]
  [phi-var : i64]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [gen : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (if (= index check-pos)
      (opt-bce-mb-sink-exit-instrs
        instrs
        (+ index 1)
        check-pos
        phi-var
        fast-labels
        exit-label
        gen)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Phi dst inputs ty)
          (if (= dst phi-var)
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Phi
                dst
                (opt-bce-mb-sink-phi-relabel-inputs
                  inputs
                  fast-labels
                  exit-label
                  gen)
                ty)
              (opt-bce-mb-sink-exit-instrs
                instrs
                (+ index 1)
                check-pos
                phi-var
                fast-labels
                exit-label
                gen))
            (ir.compiler-ir-instr-cons
              (ir.compiler-ir-instr-seq-ref instrs index)
              (opt-bce-mb-sink-exit-instrs
                instrs
                (+ index 1)
                check-pos
                phi-var
                fast-labels
                exit-label
                gen)))]
        [(ir.CompilerIrInstr.Cast dst src _ _)
          (match src
            [(ir.CompilerIrValue.Var v)
              (if (= v phi-var)
                (opt-bce-mb-sink-exit-instrs
                  instrs
                  (+ index 1)
                  check-pos
                  phi-var
                  fast-labels
                  exit-label
                  gen)
                (ir.compiler-ir-instr-cons
                  (ir.compiler-ir-instr-seq-ref instrs index)
                  (opt-bce-mb-sink-exit-instrs
                    instrs
                    (+ index 1)
                    check-pos
                    phi-var
                    fast-labels
                    exit-label
                    gen)))]
            [_
              (ir.compiler-ir-instr-cons
                (ir.compiler-ir-instr-seq-ref instrs index)
                (opt-bce-mb-sink-exit-instrs
                  instrs
                  (+ index 1)
                  check-pos
                  phi-var
                  fast-labels
                  exit-label
                  gen))])]
        [_
          (ir.compiler-ir-instr-cons
            (ir.compiler-ir-instr-seq-ref instrs index)
            (opt-bce-mb-sink-exit-instrs
              instrs
              (+ index 1)
              check-pos
              phi-var
              fast-labels
              exit-label
              gen))]))))

;; The name of the check block the sink puts on the `exit-label <- pred-label`
;; edge. Generation 0 is the historical spelling; the concatenation is not
;; injective (a label text may itself contain the separator), so a split whose
;; generation-0 names would land on an existing block moves to the next
;; generation instead of emitting a duplicate assembly label.
(define (opt-bce-mb-sink-check-label
  [exit-label : i64]
  [pred-label : i64]
  [gen : i64]) : i64
  (ir.compiler-ir-label
    (if (= gen 0)
      (str_cat.str-cat
        (ir.compiler-ir-label-text exit-label)
        "__xchk_"
        (ir.compiler-ir-label-text pred-label))
      (str_cat.str-cat
        (ir.compiler-ir-label-text exit-label)
        "__xchk"
        (string.int->string gen)
        "_"
        (ir.compiler-ir-label-text pred-label)))))

;; The in-range continuation the check block branches to.
(define (opt-bce-mb-sink-check-ok-label [check-label : i64]) : i64
  (ir.compiler-ir-label
    (str_cat.str-cat (ir.compiler-ir-label-text check-label) ".0")))

;; Does this generation name every check block (and its ok continuation) after
;; a block that does not already exist in the function?
(define (opt-bce-mb-sink-gen-free?
  [blocks : ir.CompilerIrBlockList]
  [inputs : ir.CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [gen : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-gen-free?
        blocks
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label
        gen)]
    [(ir.CompilerIrPhiInputList.Cons _ label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-sink-gen-free?
          blocks
          (__tl-box-place rest)
          fast-labels
          exit-label
          gen)
        (let
          [check-label : i64 (opt-bce-mb-sink-check-label exit-label label gen)]
          (if (or
            (opt-cfg-block-exists? blocks check-label)
            (opt-cfg-block-exists?
              blocks
              (opt-bce-mb-sink-check-ok-label check-label)))
            false
            (opt-bce-mb-sink-gen-free?
              blocks
              (__tl-box-place rest)
              fast-labels
              exit-label
              gen))))]))

;; The lowest generation whose whole name set is free. Generation 0 answers on
;; every shape the corpus produces today, so this costs one clean scan.
(define (opt-bce-mb-sink-fresh-gen
  [blocks : ir.CompilerIrBlockList]
  [inputs : ir.CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [gen : i64]) : i64
  (if (opt-bce-mb-sink-gen-free? blocks inputs fast-labels exit-label gen)
    gen
    (opt-bce-mb-sink-fresh-gen blocks inputs fast-labels exit-label (+ gen 1))))

;; Rewrite the exit phi's moved inputs to name their new check-block edges.
(define (opt-bce-mb-sink-phi-relabel-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [gen : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-phi-relabel-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label
        gen)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        value
        (if (opt-label-contains fast-labels label)
          label
          (opt-bce-mb-sink-check-label exit-label label gen))
        (opt-bce-mb-sink-phi-relabel-inputs
          (__tl-box-place rest)
          fast-labels
          exit-label
          gen))]))

;; Retarget the terminators that land on the exit to the input's new check
;; block, walking every non-fast predecessor.
(define (opt-bce-mb-sink-retarget-all
  [blocks : ir.CompilerIrBlockList]
  [inputs : ir.CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [gen : i64]) : ir.CompilerIrBlockList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) blocks]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-retarget-all
        blocks
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label
        gen)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-sink-retarget-all
          blocks
          (__tl-box-place rest)
          fast-labels
          exit-label
          gen)
        (opt-bce-mb-sink-retarget-all
          (opt-bce-mb-sink-retarget-preds
            blocks
            exit-label
            (opt-bce-mb-sink-check-label exit-label label gen)
            label)
          (__tl-box-place rest)
          fast-labels
          exit-label
          gen))]))

;; The predecessor-block rewrite for the sink: retarget every terminator
;; that lands on `from-label` to `to-label`, but only in the block named
;; `pred-label`.
(define (opt-bce-mb-sink-retarget-preds
  [blocks : ir.CompilerIrBlockList]
  [from-label : i64]
  [to-label : i64]
  [pred-label : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (if (= label pred-label)
            (ir.compiler-ir-block-cons
              (ir.compiler-ir-block
                label
                (opt-unroll-retarget-instrs instrs 0 from-label to-label))
              (opt-bce-mb-sink-retarget-preds
                (__tl-box-place rest)
                from-label
                to-label
                pred-label))
            (ir.compiler-ir-block-cons
              block
              (opt-bce-mb-sink-retarget-preds
                (__tl-box-place rest)
                from-label
                to-label
                pred-label)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-sink-retarget-preds
        (ir.compiler-ir-block-seq-to-list seq)
        from-label
        to-label
        pred-label)]))

;; Build the tiny check blocks for the non-fast phi inputs and retarget the
;; predecessor edges. Each input gets: cast input to u64, check, jump exit.
;; `emitted` carries the names already built for this split: one predecessor
;; may hold two edges into the exit (a branch with both arms on it), and both
;; phi inputs then relabel to the same check block, which must be emitted once.
(define (opt-bce-mb-sink-check-blocks-from
  [inputs : ir.CompilerIrPhiInputList]
  [fast-labels : OptLabelSet]
  [exit-label : i64]
  [len : ir.CompilerIrValue]
  [blocks : ir.CompilerIrBlockList]
  [cell : (__tl_dyn-array i64)]
  [gen : i64]
  [emitted : OptLabelSet]) : ir.CompilerIrBlockList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) blocks]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-bce-mb-sink-check-blocks-from
        (ir.compiler-ir-phi-input-seq-to-list seq)
        fast-labels
        exit-label
        len
        blocks
        cell
        gen
        emitted)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-label-contains fast-labels label)
        (opt-bce-mb-sink-check-blocks-from
          (__tl-box-place rest)
          fast-labels
          exit-label
          len
          blocks
          cell
          gen
          emitted)
        (let
          [check-label : i64 (opt-bce-mb-sink-check-label exit-label label gen)]
          (if (opt-label-contains emitted check-label)
            (opt-bce-mb-sink-check-blocks-from
              (__tl-box-place rest)
              fast-labels
              exit-label
              len
              blocks
              cell
              gen
              emitted)
            (let
              [cast-var : i64 (opt-bce-version-alloc-var cell)]
              [ok-label : i64 (opt-bce-mb-sink-check-ok-label check-label)]
              [seen : OptLabelSet (opt-label-cons check-label emitted)]
              (ir.compiler-ir-block-cons
                (ir.compiler-ir-block
                  check-label
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.Cast
                      cast-var
                      value
                      (ast.AstType.I64)
                      (ast.AstType.U64))
                    (ir.compiler-ir-instr-cons
                      (ir.CompilerIrInstr.BoundsCheck
                        (ir.CompilerIrValue.Var cast-var)
                        len
                        ok-label)
                      (ir.compiler-ir-instr-cons
                        (ir.CompilerIrInstr.Jump exit-label)
                        (ir.CompilerIrInstrList.Nil)))))
                (opt-bce-mb-sink-check-blocks-from
                  (__tl-box-place rest)
                  fast-labels
                  exit-label
                  len
                  blocks
                  cell
                  gen
                  seen))))))]))

;; Sink the check out of a qualifying exit block: the fast arrivals are
;; provably in range, so the check moves to fresh per-input check blocks on
;; the non-fast edges only. The check blocks' length operand must dominate
;; them, so it is the canonical (entry-defined) spelling, not the exit
;; block's local cast.
(define (opt-bce-mb-split-exit-checks
  [blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [fast-blocks : ir.CompilerIrBlockList]
  [fast-bounded : i64]
  [guard-instrs : ir.CompilerIrInstrSeq]
  [cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match (opt-bce-mb-find-exit-split
    blocks
    blocks
    shape
    fast-blocks
    fast-bounded
    guard-instrs)
    [(OptBceMbExitSplit.No) blocks]
    [(OptBceMbExitSplit.Some label check-pos phi-var len fast-labels)
      (let
        [inputs : ir.CompilerIrPhiInputList
          (opt-bce-mb-block-phi-inputs
            (opt-bce-mb-find-block-seq blocks label)
            phi-var)]
        [clen : ir.CompilerIrValue (opt-bce-mb-canon-value blocks len)]
        ;; One generation for the whole split: the phi relabel, the predecessor
        ;; retarget, and the check blocks themselves must all agree on the name.
        [gen : i64
          (opt-bce-mb-sink-fresh-gen blocks inputs fast-labels label 0)]
        ;; The check blocks land immediately before the exit block: behind
        ;; every predecessor edge, never before the function entry.
        [sunk : ir.CompilerIrBlockList
          (opt-bce-mb-sink-exit-block-list
            blocks
            label
            check-pos
            phi-var
            fast-labels
            (opt-bce-mb-sink-check-blocks-from
              inputs
              fast-labels
              label
              clen
              (ir.CompilerIrBlockList.Nil)
              cell
              gen
              (OptLabelSet.Nil))
            gen)]
        [step : ir.CompilerIrBlockList
          (opt-bce-mb-sink-retarget-all sunk inputs fast-labels label gen)]
        step)]))

;; Guard derivation + fast-clone emission + rewrite over a fully wired
;; function: `blocks` has every outside use of a clone-group def in
;; phi-on-edge form, and `shape` carries the clone group (the natural loop
;; plus any forwarding stubs) as its body.
(define (opt-bce-mb-apply-wired
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [defs : opt_i64_i64_map.Map]
  [cell : (__tl_dyn-array i64)]
  [frame : i64]) : OptUnrollResult
  (let
    [body-labels : OptLabelSet shape.body-labels]
    [body-blocks : ir.CompilerIrBlockList shape.body-blocks]
    (match (opt-bce-mb-guard-conds
      doms
      descriptor
      stable?
      blocks
      shape
      defs
      cell)
      [(OptBceMbGuardOut.No) (OptUnrollResult.Result blocks frame false)]
      [(OptBceMbGuardOut.Some guard-instrs guard-value keep facts)
        (let
          [remap : (__tl_dyn-array ir.CompilerIrValue)
            (array.make-array ir.CompilerIrValue frame)]
          [_fill : unit (opt-unroll-remap-fill remap 0)]
          [_alloc : unit (opt-bce-mb-alloc-defs! body-blocks remap cell)]
          [guard-label : i64
            (ir.compiler-ir-label
              (str_cat.str-cat
                (ir.compiler-ir-label-text shape.header)
                "__bce_guard"))]
          [fast-blocks : ir.CompilerIrBlockList
            (opt-bce-mb-clone-blocks
              body-blocks
              remap
              body-labels
              (opt-bce-mb-all-labels-from blocks (OptLabelSet.Nil))
              shape.preheader
              guard-label
              facts
              keep)]
          [guard-block : ir.CompilerIrBlock
            (opt-bce-version-guard-block
              guard-label
              guard-instrs
              guard-value
              (ir.compiler-ir-label
                (str_cat.str-cat
                  (ir.compiler-ir-label-text shape.header)
                  "__bce_fast"))
              shape.header)]
          (OptUnrollResult.Result
            (let
              [rewritten-blocks : ir.CompilerIrBlockList
                (opt-bce-mb-rewrite-blocks
                  blocks
                  shape
                  guard-block
                  fast-blocks
                  remap)]
              ;; The exit-check sink keys on a phi that TRACKS the counter --
              ;; same seed, growing by at most the counter's step per latch
              ;; crossing (opt-bce-mb-bounded-value?). That relation is written
              ;; for an ascending counter and says nothing about a descending
              ;; one, whose seed is the range's top; a descending shape skips
              ;; the sink rather than reinterpret it.
              [bounded : i64
                (if (< shape.step 0)
                  -1
                  (opt-bce-mb-find-bounded-phi
                    shape.body-blocks
                    rewritten-blocks
                    shape.header
                    shape.preheader
                    (ir.compiler-ir-label
                      (str_cat.str-cat
                        (ir.compiler-ir-label-text shape.header)
                        "__bce_guard"))
                    (opt-bce-mb-canon-value blocks shape.seed)
                    shape.iphi))]
              (opt-bce-mb-split-exit-checks
                rewritten-blocks
                shape
                fast-blocks
                (if (< bounded 0)
                  -1
                  (match (array-ref remap bounded)
                    [(ir.CompilerIrValue.Var fast-bounded-id) fast-bounded-id]
                    [_ -1]))
                guard-instrs
                cell))
            (array-ref cell 0)
            true))])))

;; Apply with a settled clone group: the loop's own blocks plus every stub the
;; wiring or the exit-phi widening pulled in. The escape test has already been
;; answered for this exact group by the caller.
(define (opt-bce-mb-apply-group
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [stable? : bool]
  [wired-blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [clone-labels : OptLabelSet]
  [clone-blocks : ir.CompilerIrBlockList]
  [cell : (__tl_dyn-array i64)]
  [frame : i64]) : OptUnrollResult
  (opt-bce-mb-apply-wired
    doms
    descriptor
    stable?
    wired-blocks
    (OptBceMbShape
      shape.header
      shape.latch
      shape.preheader
      clone-labels
      clone-blocks
      shape.iphi
      shape.seed
      shape.bound
      shape.step
      shape.uncovered
      shape.inner
      shape.region?)
    (opt-bce-mb-collect-defs clone-blocks (opt_i64_i64_map.with-capacity 64))
    cell
    frame))

;; `blocks` is the function as the far-use repair left it; `original` is what
;; the caller keeps when the attempt fails, so a repair that the wiring then
;; refuses costs nothing.
(define (opt-bce-mb-apply-repaired
  [doms : OptDomInfo]
  [descriptor : OptBceMbDescriptor]
  [pred-map : OptPredMap]
  [original : ir.CompilerIrBlockList]
  [blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [cell : (__tl_dyn-array i64)]
  [frame : i64]) : OptUnrollResult
  (let
    [body-labels : OptLabelSet shape.body-labels]
    [body-blocks : ir.CompilerIrBlockList shape.body-blocks]
    [defs : opt_i64_i64_map.Map
      (opt-bce-mb-collect-defs body-blocks (opt_i64_i64_map.with-capacity 64))]
    [outside : opt_i64_i64_map.Map
      (opt-bce-mb-outside-uses
        (opt_i64_i64_map.with-capacity 64)
        blocks
        body-labels)]
    (if (not (opt-bce-mb-defs-escape? body-blocks outside))
      ;; No direct outside use: the original exit-phi-only scheme, unchanged.
      (opt-bce-mb-apply-wired
        doms
        descriptor
        (opt-bce-mb-stable-blocks? descriptor body-blocks)
        blocks
        shape
        defs
        cell
        frame)
      (match (opt-bce-mb-wire-exits
        pred-map
        blocks
        blocks
        body-labels
        body-blocks
        cell
        (OptLabelSet.Nil))
        [(OptBceMbWiring.No) (OptUnrollResult.Result original frame false)]
        [(OptBceMbWiring.Some wired-blocks stub-labels)
          (let
            [stub-blocks : ir.CompilerIrBlockList
              (opt-bce-mb-stub-blocks-from wired-blocks stub-labels)]
            [clone-labels : OptLabelSet
              (opt-bce-mb-labels-union stub-labels body-labels)]
            [clone-blocks : ir.CompilerIrBlockList
              (opt-bce-mb-blocks-append body-blocks stub-blocks)]
            [clone-defs : opt_i64_i64_map.Map
              (opt-bce-mb-collect-defs
                clone-blocks
                (opt_i64_i64_map.with-capacity 64))]
            [clone-outside : opt_i64_i64_map.Map
              (opt-bce-mb-outside-uses
                (opt_i64_i64_map.with-capacity 64)
                wired-blocks
                clone-labels)]
            (if (not (opt-bce-mb-defs-escape? clone-blocks clone-outside))
              (opt-bce-mb-apply-group
                doms
                descriptor
                (opt-bce-mb-stable-blocks? descriptor body-blocks)
                wired-blocks
                shape
                clone-labels
                clone-blocks
                cell
                frame)
              ;; What is left may be nothing but a phi keyed on a jump-only
              ;; exit forwarder -- the shape inlining leaves behind. Widen the
              ;; clone group by those stubs and rerun the escape test over it;
              ;; a def escaping any other way still keeps the rejection.
              (match (opt-bce-mb-phi-stub-labels
                pred-map
                wired-blocks
                wired-blocks
                clone-labels
                clone-defs
                (OptLabelSet.Nil))
                [(OptBceMbMaybeLabels.No)
                  (OptUnrollResult.Result original frame false)]
                [(OptBceMbMaybeLabels.Some phi-stubs)
                  (if (= (opt-label-count phi-stubs) 0)
                    (OptUnrollResult.Result original frame false)
                    (let
                      [wide-labels : OptLabelSet
                        (opt-bce-mb-labels-union phi-stubs clone-labels)]
                      [wide-blocks : ir.CompilerIrBlockList
                        (opt-bce-mb-blocks-append
                          clone-blocks
                          (opt-bce-mb-stub-blocks-from wired-blocks phi-stubs))]
                      [wide-outside : opt_i64_i64_map.Map
                        (opt-bce-mb-outside-uses
                          (opt_i64_i64_map.with-capacity 64)
                          wired-blocks
                          wide-labels)]
                      (if (opt-bce-mb-defs-escape? wide-blocks wide-outside)
                        (OptUnrollResult.Result original frame false)
                        (opt-bce-mb-apply-group
                          doms
                          descriptor
                          (opt-bce-mb-stable-blocks? descriptor body-blocks)
                          wired-blocks
                          shape
                          wide-labels
                          wide-blocks
                          cell
                          frame))))])))]))))

(define (opt-bce-mb-apply
  [descriptor : OptBceMbDescriptor]
  [pred-map : OptPredMap]
  [doms : OptDomInfo]
  [blocks : ir.CompilerIrBlockList]
  [shape : OptBceMbShape]
  [frame : i64]) : OptUnrollResult
  (let
    [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [_cell : unit (set! (array-ref cell 0) frame)]
    (match (opt-bce-mb-far-repair
      pred-map
      doms
      blocks
      shape.body-labels
      shape.body-blocks
      cell)
      [(OptBceMbFarResult.No) (OptUnrollResult.Result blocks frame false)]
      [(OptBceMbFarResult.Same)
        (opt-bce-mb-apply-repaired
          doms
          descriptor
          pred-map
          blocks
          blocks
          shape
          cell
          frame)]
      [(OptBceMbFarResult.Some repaired)
        (opt-bce-mb-apply-repaired
          doms
          descriptor
          pred-map
          blocks
          repaired
          shape
          cell
          frame)])))

;; One scan applies at most one multi-block versioning; the driver repeats the
;; scan while its invocation budget (opt-loop-apply-budget) lasts, like the
;; single-block pass. `rejected` retires the loops whose rewrite this
;; invocation's verify already refused, keyed by header label.
(define (opt-bce-mb-loops-scan
  [descriptor : OptBceMbDescriptor]
  [pred-map : OptPredMap]
  [doms : OptDomInfo]
  [blocks : ir.CompilerIrBlockList]
  [all-loops : OptNaturalLoopList]
  [loops : OptNaturalLoopList]
  [entry-label : i64]
  [nested? : bool]
  [rejected : OptLabelSet]
  [frame : i64]) : OptBceVersionScan
  (match loops
    [(OptNaturalLoopList.Nil)
      (OptBceVersionScan.Scan blocks frame false (ir.compiler-ir-label-none))]
    [(OptNaturalLoopList.Cons loop rest)
      (if (opt-label-contains rejected (opt-natural-loop-header loop))
        (opt-bce-mb-loops-scan
          descriptor
          pred-map
          doms
          blocks
          all-loops
          (__tl-box-place rest)
          entry-label
          nested?
          rejected
          frame)
        (match (opt-bce-mb-loop-shape blocks all-loops entry-label nested? loop)
          [(OptBceMbMaybeShape.Some shape)
            (match (opt-bce-mb-apply
              descriptor
              pred-map
              doms
              blocks
              shape
              frame)
              [(OptUnrollResult.Result next-blocks next-frame changed)
                (if changed
                  (OptBceVersionScan.Scan
                    next-blocks
                    next-frame
                    true
                    shape.header)
                  (opt-bce-mb-loops-scan
                    descriptor
                    pred-map
                    doms
                    blocks
                    all-loops
                    (__tl-box-place rest)
                    entry-label
                    nested?
                    rejected
                    frame))])]
          [(OptBceMbMaybeShape.No)
            (opt-bce-mb-loops-scan
              descriptor
              pred-map
              doms
              blocks
              all-loops
              (__tl-box-place rest)
              entry-label
              nested?
              rejected
              frame)]))]))

;; Flat loops first, loop NESTS second. Both phases version the same way (the
;; clone group is the natural loop's whole block set, so an inner loop simply
;; clones along with everything else), but the order is what keeps the nest
;; admission from taking work away from the inner loops: an inner loop that
;; versions on its own removes checks per INNER iteration, strictly more than
;; the outer loop's one-per-outer-iteration, and its `__bce_fast` blocks then
;; make the enclosing nest ineligible anyway (cloning the outer body would
;; have to re-create labels that now exist). So a nest is offered only when no
;; flat loop in the function took the slot this round.
(define (opt-bce-mb-loops-scan-phased
  [descriptor : OptBceMbDescriptor]
  [pred-map : OptPredMap]
  [doms : OptDomInfo]
  [blocks : ir.CompilerIrBlockList]
  [all-loops : OptNaturalLoopList]
  [entry-label : i64]
  [rejected : OptLabelSet]
  [frame : i64]) : OptBceVersionScan
  (match (opt-bce-mb-loops-scan
    descriptor
    pred-map
    doms
    blocks
    all-loops
    all-loops
    entry-label
    false
    rejected
    frame)
    [(OptBceVersionScan.Scan flat-blocks flat-frame flat-changed flat-applied)
      (if flat-changed
        (OptBceVersionScan.Scan flat-blocks flat-frame true flat-applied)
        (opt-bce-mb-loops-scan
          descriptor
          pred-map
          doms
          blocks
          all-loops
          all-loops
          entry-label
          true
          rejected
          frame))]))

;; --- prescan ---------------------------------------------------------------------
(define (opt-bce-mb-blocks-have-check? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (>=
            (opt-bce-version-check-count
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs)
              0)
            1)
            true
            (opt-bce-mb-blocks-have-check? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-blocks-have-check? (ir.compiler-ir-block-seq-to-list seq))]))

;; Cheap prescan only checks facts that are invariant under block layout. The
;; full candidate scan below uses dominance-based natural loops.
(define (opt-bce-mb-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (and (opt-bce-mb-blocks-have-check? blocks) (opt-ssa-blocks-have-phi? blocks)))

;; The budgeted driver's post-application verdict. `reject-probe` is
;; `ir.compiler-ir-label-none` on every production path and no real label
;; equals it, so this is exactly `opt-verify-function-with-context` there. The
;; optimizer tests pass one loop's label to force that loop's application to
;; be refused: both versioners emit rewrites that are correct by construction
;; (every generated label is proved fresh before the shape is admitted, every
;; guard operand is proved loop-invariant, and the only new edges are the
;; guard's and the clone's, whose exit phis the rewrite extends), so the
;; rejection path has no reachable trigger to exercise it with.
(define (opt-bce-version-apply-verdict
  [reject-probe : i64]
  [applied : i64]
  [func : ir.CompilerIrFunction]
  [context : OptCfgContext]) : ResultCompilerOptimizeVerify
  (if (= reject-probe applied)
    (ResultCompilerOptimizeVerify.Err
      "optimizer verify: forced versioning rejection")
    (opt-verify-function-with-context func context)))

;; Budgeted multi-application, like the unroller: the single-block scan runs
;; first each round and spends from its own budget; when it finds nothing, the
;; multi-block scan runs over the natural-loop records with its own budget.
;; Every application rebuilds the function around the rewrite and is verified
;; on its own; a verifier rejection keeps the last verified state and retires
;; THAT ONE LOOP for the rest of the invocation (`rejected`, keyed by loop
;; label / loop header), then rescans. A loop the verifier refuses costs the
;; function's remaining loops nothing -- which is what merged bodies need,
;; where one bad loop used to suppress every later one -- and, since a
;; rejected application consumes no budget, the run still gets its full quota
;; of accepted rewrites. Each rejection adds a label the scans then skip, so
;; the retry sequence is bounded by the block count. The generated
;; `__bce_guard` / `__bce_fast` labels make a versioned loop ineligible to
;; both scans, so later rounds never re-process it.
(define (opt-bce-version-function-budget-result
  [type-segment-bases : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [context : OptCfgContext]
  [func : ir.CompilerIrFunction]
  [single-budget : i64]
  [mb-budget : i64]
  [rejected : OptLabelSet]
  [reject-probe : i64]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s current blocks.
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (> single-budget 0)
        (match (opt-bce-version-blocks-scan
          blocks
          blocks
          (opt-cfg-entry-label blocks)
          rejected
          frame)
          [(OptBceVersionScan.Scan next-blocks next-frame changed applied)
            (if changed
              (let
                [next : ir.CompilerIrFunction
                  (ir.CompilerIrFunction.Function
                    name
                    params
                    ret-ty
                    next-frame
                    next-blocks)]
                [next-context : OptCfgContext
                  (opt-cfg-context-build next-blocks)]
                (match (opt-bce-version-apply-verdict
                  reject-probe
                  applied
                  next
                  next-context)
                  [(ResultCompilerOptimizeVerify.Ok)
                    (opt-bce-version-function-budget-result
                      type-segment-bases
                      direct-call-clean
                      next-context
                      next
                      (- single-budget 1)
                      mb-budget
                      rejected
                      reject-probe)]
                  [(ResultCompilerOptimizeVerify.Err _)
                    ;; Last verified state, minus this one loop: the scan
                    ;; skips `applied` from here on and offers the next
                    ;; candidate against the same budget.
                    (opt-bce-version-function-budget-result
                      type-segment-bases
                      direct-call-clean
                      context
                      func
                      single-budget
                      mb-budget
                      (opt-label-add rejected applied)
                      reject-probe)]))
              ;; no single-block self-loop matched: try multi-block counted
              ;; loops over the natural-loop back edges.
              (opt-bce-mb-function-budget-result
                type-segment-bases
                direct-call-clean
                context
                func
                single-budget
                mb-budget
                rejected
                reject-probe))])
        (opt-bce-mb-function-budget-result
          type-segment-bases
          direct-call-clean
          context
          func
          single-budget
          mb-budget
          rejected
          reject-probe))]))

(define (opt-bce-mb-function-budget-result
  [type-segment-bases : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [context : OptCfgContext]
  [func : ir.CompilerIrFunction]
  [single-budget : i64]
  [mb-budget : i64]
  [rejected : OptLabelSet]
  [reject-probe : i64]) : OptFunctionCtxResult
  (if (<= mb-budget 0)
    (OptFunctionCtxResult.Result func context)
    (match func
      [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
        (let
          [loops : OptNaturalLoopList
            (opt-cfg-natural-loops-with-context blocks context)]
          ;; A negative bases value disables descriptor-length recognition (no
          ;; type-pool access); a real one classifies the function's
          ;; descriptor handles for it.
          [descriptor : OptBceMbDescriptor
            (if (< type-segment-bases 0)
              (OptBceMbDescriptor.No)
              (OptBceMbDescriptor.Some
                type-segment-bases
                (opt-load-header-set-from-function
                  type-segment-bases
                  params
                  blocks)
                direct-call-clean))]
          (match (opt-bce-mb-loops-scan-phased
            descriptor
            context.pred-map
            context.doms
            blocks
            loops
            (opt-cfg-entry-label blocks)
            rejected
            frame)
            [(OptBceVersionScan.Scan mb-blocks mb-frame mb-changed mb-applied)
              (if mb-changed
                (let
                  [next : ir.CompilerIrFunction
                    (ir.CompilerIrFunction.Function
                      name
                      params
                      ret-ty
                      mb-frame
                      mb-blocks)]
                  [next-context : OptCfgContext
                    (opt-cfg-context-build mb-blocks)]
                  (match (opt-bce-version-apply-verdict
                    reject-probe
                    mb-applied
                    next
                    next-context)
                    [(ResultCompilerOptimizeVerify.Ok)
                      ;; The next round retries the single-block scan first,
                      ;; like the next pipeline iteration would.
                      (opt-bce-version-function-budget-result
                        type-segment-bases
                        direct-call-clean
                        next-context
                        next
                        single-budget
                        (- mb-budget 1)
                        rejected
                        reject-probe)]
                    [(ResultCompilerOptimizeVerify.Err _)
                      ;; Retire this loop and rescan the rest. The single-block
                      ;; scan already came up empty for this `rejected` set and
                      ;; a retired multi-block header cannot unlock it, so the
                      ;; retry stays in the multi-block phase.
                      (opt-bce-mb-function-budget-result
                        type-segment-bases
                        direct-call-clean
                        context
                        func
                        single-budget
                        mb-budget
                        (opt-label-add rejected mb-applied)
                        reject-probe)]))
                (OptFunctionCtxResult.Result func context))]))])))

(define (opt-bce-version-function-verified-with-context-result
  [type-segment-bases : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (opt-bce-version-function-budget-result
        type-segment-bases
        direct-call-clean
        context
        func
        (opt-loop-apply-budget)
        (opt-loop-apply-budget)
        (OptLabelSet.Nil)
        (ir.compiler-ir-label-none))]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

(define (opt-bce-version-function-with-context-result
  [type-segment-bases : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; `context` must be valid for `func`'s blocks (the entry verify reuses it).
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ prescan-blocks)
      (if (or
        (opt-bce-version-blocks-have-candidate? prescan-blocks)
        (opt-bce-mb-blocks-have-candidate? prescan-blocks))
        (opt-bce-version-function-verified-with-context-result
          type-segment-bases
          direct-call-clean
          context
          verified?
          func)
        (OptFunctionCtxResult.Result func context))]))

;; Type-pool-free entry: descriptor-length recognition stays off (-1), so
;; multi-block versioning behaves exactly as before for invariant lengths.
(define (opt-bce-version-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-bce-version-function-with-context-result
        (- 0 1)
        (opt_i64_i64_map.with-capacity 1)
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; Test-only driver: `opt-bce-version-function` with ONE loop's application
;; forced to fail verification (see `opt-bce-version-apply-verdict`). `probe`
;; names the loop to refuse; `ir.compiler-ir-label-none` refuses nothing and
;; reproduces `opt-bce-version-function` exactly. This is what lets the
;; optimizer tests observe that a refused loop retires alone and the
;; function's remaining loops still version.
(define (opt-bce-version-function-reject-probe
  [func : ir.CompilerIrFunction]
  [probe : i64]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [context : OptCfgContext (opt-cfg-context-build blocks)]
        (match (opt-verify-function-with-context func context)
          [(ResultCompilerOptimizeVerify.Ok)
            (match (opt-bce-version-function-budget-result
              (- 0 1)
              (opt_i64_i64_map.with-capacity 1)
              context
              func
              (opt-loop-apply-budget)
              (opt-loop-apply-budget)
              (OptLabelSet.Nil)
              probe)
              [(OptFunctionCtxResult.Result next _) next])]
          [(ResultCompilerOptimizeVerify.Err _) func]))]))

;; Test entry with type-pool access: descriptor-length recognition is live.
;; No callee is proven clean, so a call in the loop body refuses every
;; descriptor length exactly as the write-free test did.
(define (opt-bce-version-function-with-types
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (opt-bce-version-function-with-types-and-calls
    type-segment-bases
    (opt_i64_i64_map.with-capacity 1)
    func))

;; Test entry with type-pool access AND per-callee clean bits: the descriptor
;; chains of a loop whose only calls are proven descriptor-stable stay derivable
;; (opt-bce-mb-stable-blocks?).
(define (opt-bce-version-function-with-types-and-calls
  [type-segment-bases : i64]
  [direct-call-clean : opt_i64_i64_map.Map]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (opt-bce-version-function-with-context-result
        type-segment-bases
        direct-call-clean
        (opt-cfg-context-build blocks)
        false
        func)
        [(OptFunctionCtxResult.Result next _) next])]))

;; --- x2 unrolling for versioned conditional diamonds ---------------------------
;;
;; The straight-line unroller above deliberately starts with a self-loop
;; prescan. A versioned partition loop has a four-block natural-loop body
;; instead:
;;
;;   H(phi i, phi state): body; Branch then else
;;   then/else: ...; Jump L
;;   L: merged state; inext = i + 1; c = inext < bound; Branch c H exit
;;
;; Its separate merge latch is the first gate that rejected quicksort's
;; `__bce_fast` clone; its store-bearing swap arm would also fail the
;; straight-line instruction whitelist. This path is intentionally narrower
;; than the multi-block BCE cloner: exactly one check-free four-block diamond,
;; at most two header phis, no calls or fallthroughs, <= 32 IR instructions,
;; <= 6 invariant live-ins, step +1, and an invariant bound. Requiring the
;; `__bce_fast` provenance keeps the original checked loop as the fallback and
;; preserves the guard's in-range proof without reintroducing BoundsChecks.
;;
;; G tests the parity of (bound - seed). For an odd trip count the original
;; fast body is peeled once; for an even count G enters copy 0 directly. Copy 0
;; falls through the diamond to copy 1 without an exit test, and copy 1 uses
;; the original remapped exit test to loop by two. Thus the steady-state pair
;; pays one increment/compare/branch while every memory operation remains in
;; the already-proven check-free fast region.
(defstruct OptUnrollMbShape
  (header i64)
  (latch i64)
  (preheader i64)
  (exit-label i64)
  (body-labels OptLabelSet)
  (body-blocks ir.CompilerIrBlockList)
  (iphi i64)
  (seed ir.CompilerIrValue)
  (inext i64)
  (cond-var i64)
  (bound ir.CompilerIrValue))

(defenum OptUnrollMbMaybeShape
  (No)
  (Some OptUnrollMbShape))

(define (opt-unroll-mb-copy-suffix [copy : i64]) : String
  (if (= copy 0)
    "__unroll2_0"
    "__unroll2_1"))

(define (opt-unroll-mb-label
  [body-labels : OptLabelSet]
  [label : i64]
  [copy : i64]) : i64
  (if (opt-label-contains body-labels label)
    (ir.compiler-ir-label
      (str_cat.str-cat
        (ir.compiler-ir-label-text label)
        (opt-unroll-mb-copy-suffix copy)))
    label))

(define (opt-unroll-mb-guard-label [header : i64]) : i64
  (ir.compiler-ir-label
    (str_cat.str-cat (ir.compiler-ir-label-text header) "__unroll2_guard")))

(define (opt-unroll-mb-block-terminator-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [_ false]))

(define (opt-unroll-mb-body-instr-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [_ false]))

(define (opt-unroll-mb-body-instr-status [instr : ir.CompilerIrInstr]) : i64
  (if (not (opt-unroll-mb-body-instr-ok? instr))
    -1
    (match instr
      [(ir.CompilerIrInstr.StorePtr _ _ _) 1]
      [_ 0])))

;; Returns -1 for an unsafe body, 0 for a safe read-only body, and 1 for a
;; safe body containing a store.
(define (opt-unroll-mb-body-instrs-status
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : i64
  (if (>= index last)
    0
    (let
      [current : i64
        (opt-unroll-mb-body-instr-status
          (ir.compiler-ir-instr-seq-ref instrs index))]
      (if (< current 0)
        -1
        (let
          [rest : i64
            (opt-unroll-mb-body-instrs-status instrs (+ index 1) last)]
          (if (< rest 0)
            -1
            (if (or (= current 1) (= rest 1))
              1
              0)))))))

(define (opt-unroll-mb-block-status [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
        (if (and
          (> count phi-count)
          (opt-unroll-no-phi-from? instrs phi-count)
          (opt-unroll-mb-block-terminator-ok?
            (ir.compiler-ir-instr-seq-ref instrs (- count 1))))
          (opt-unroll-mb-body-instrs-status instrs phi-count (- count 1))
          -1))]))

(define (opt-unroll-mb-body-status [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [current : i64 (opt-unroll-mb-block-status block)]
        (if (< current 0)
          -1
          (let
            [tail : i64 (opt-unroll-mb-body-status (__tl-box-place rest))]
            (if (< tail 0)
              -1
              (if (or (= current 1) (= tail 1))
                1
                0)))))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-body-status (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-unroll-mb-all-fast-labels? [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        [marker : String "__bce_fast"]
        [text : String (ir.compiler-ir-label-text label)]
        (and
          (string.contains (& text) (& marker))
          (opt-unroll-mb-all-fast-labels? (opt-label-tail labels))))]))

(define (opt-unroll-mb-labels-fresh?
  [blocks : ir.CompilerIrBlockList]
  [labels : OptLabelSet]) : bool
  (match labels
    [(OptLabelSet.Nil) true]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (and
          (not
            (opt-cfg-block-exists?
              blocks
              (ir.compiler-ir-label
                (str_cat.str-cat
                  (ir.compiler-ir-label-text label)
                  (opt-unroll-mb-copy-suffix 0)))))
          (not
            (opt-cfg-block-exists?
              blocks
              (ir.compiler-ir-label
                (str_cat.str-cat
                  (ir.compiler-ir-label-text label)
                  (opt-unroll-mb-copy-suffix 1)))))
          (opt-unroll-mb-labels-fresh? blocks (opt-label-tail labels))))]))

(define (opt-unroll-mb-block-jumps-to?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (opt-cfg-find-block blocks label)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (and
              (> count 0)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump actual) (= actual target)]
                [_ false])))])]))

;; The only admitted control shape is H -> {then, else} -> L -> {H, exit}.
(define (opt-unroll-mb-diamond?
  [blocks : ir.CompilerIrBlockList]
  [body-labels : OptLabelSet]
  [header : i64]
  [latch : i64]) : bool
  (match (opt-cfg-find-block blocks header)
    [(OptMaybeBlock.No) false]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch _ then-label else-label)
                  (and
                    (not (= then-label else-label))
                    (not (= then-label header))
                    (not (= else-label header))
                    (not (= then-label latch))
                    (not (= else-label latch))
                    (opt-label-contains body-labels then-label)
                    (opt-label-contains body-labels else-label)
                    (opt-unroll-mb-block-jumps-to? blocks then-label latch)
                    (opt-unroll-mb-block-jumps-to? blocks else-label latch))]
                [_ false])))])]))

(define (opt-unroll-mb-collect-uses
  [blocks : ir.CompilerIrBlockList]
  [set : opt_i64_i64_map.Map]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-mb-collect-uses
            (__tl-box-place rest)
            (opt-collect-instr-seq-uses set instrs))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-collect-uses (ir.compiler-ir-block-seq-to-list seq) set)]))

(define (opt-unroll-mb-remove-defs-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [uses : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    uses
    (let
      [out : opt_i64_i64_map.Map uses]
      [dst : i64 (ir.compiler-ir-instr-seq-loop-dst-or instrs index (- 0 1))]
      (begin
        (if (>= dst 0)
          (begin
            (opt_i64_i64_map.remove-ref! (&mut out) dst)
            unit)
          unit)
        (opt-unroll-mb-remove-defs-instrs instrs (+ index 1) out)))))

(define (opt-unroll-mb-remove-defs
  [blocks : ir.CompilerIrBlockList]
  [uses : opt_i64_i64_map.Map (:consume)]) : opt_i64_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) uses]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-mb-remove-defs
            (__tl-box-place rest)
            (opt-unroll-mb-remove-defs-instrs instrs 0 uses))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-remove-defs (ir.compiler-ir-block-seq-to-list seq) uses)]))

;; This is a deliberately small register-pressure proxy: loop definitions do
;; not count, because each copy's temporaries die before the next copy starts;
;; only values kept live into both copies consume steady-state headroom.
(define (opt-unroll-mb-live-in-count [blocks : ir.CompilerIrBlockList]) : i64
  (let
    [uses : opt_i64_i64_map.Map
      (opt-unroll-mb-collect-uses blocks (opt_i64_i64_map.with-capacity 32))]
    [live-ins : opt_i64_i64_map.Map (opt-unroll-mb-remove-defs blocks uses)]
    (opt_i64_i64_map.len (& live-ins))))

(define (opt-unroll-mb-direct-var? [value : ir.CompilerIrValue] [var : i64]) : bool
  (match value
    [(ir.CompilerIrValue.Var id) (= id var)]
    [_ false]))

;; Copy 1 eliminates its counter phi: each indexed Gep gets a same-block
;; `i + 1` address-only offset (the backend's displacement fold deletes it),
;; and the sole carried counter update becomes `i + 2`. Reject any other
;; direct use instead of materializing `i + 1` in the steady-state loop.
(define (opt-unroll-mb-counter-uses-ok-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [iphi : i64]
  [inext : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      [uses : opt_i64_i64_map.Map
        (opt-collect-instr-uses (opt_i64_i64_map.with-capacity 4) instr)]
      (and
        (if (not (opt-used-contains uses iphi))
          true
          (match instr
            ;; Header phis define the carried value; their incoming edges do
            ;; not execute as body uses.
            [(ir.CompilerIrInstr.Phi _ _ _) true]
            [(ir.CompilerIrInstr.Gep _ _ offset _)
              (opt-unroll-mb-direct-var? offset iphi)]
            [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
              (and
                (= dst inext)
                (match op
                  [(ir.CompilerIrBinOp.Add) true]
                  [_ false])
                (opt-unroll-mb-direct-var? lhs iphi)
                (match rhs
                  [(ir.CompilerIrValue.I64 step) (= step 1)]
                  [_ false]))]
            [_ false]))
        (opt-unroll-mb-counter-uses-ok-instrs? instrs (+ index 1) iphi inext)))))

(define (opt-unroll-mb-counter-uses-ok?
  [blocks : ir.CompilerIrBlockList]
  [iphi : i64]
  [inext : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) true]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (and
            (opt-unroll-mb-counter-uses-ok-instrs? instrs 0 iphi inext)
            (opt-unroll-mb-counter-uses-ok? (__tl-box-place rest) iphi inext))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-counter-uses-ok?
        (ir.compiler-ir-block-seq-to-list seq)
        iphi
        inext)]))

(define (opt-unroll-mb-shape-finish
  [blocks : ir.CompilerIrBlockList]
  [header : i64]
  [latch : i64]
  [preheader : i64]
  [body-labels : OptLabelSet]
  [body-blocks : ir.CompilerIrBlockList]
  [counter : OptBceMbMaybeCounter]
  [cond-var : i64]
  [exit-label : i64]) : OptUnrollMbMaybeShape
  (match counter
    [(OptBceMbMaybeCounter.No) (OptUnrollMbMaybeShape.No)]
    [(OptBceMbMaybeCounter.Some iphi seed inext bound step)
      (match (opt-cfg-find-block blocks header)
        [(OptMaybeBlock.No) (OptUnrollMbMaybeShape.No)]
        [(OptMaybeBlock.Some block)
          (match block
            [(ir.CompilerIrBlock.Block _ instrs)
              (let
                [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
                (if (and
                  ;; The shared recognizer also admits literal steps > 1 (for
                  ;; bce_version's guarded versioning); the 2x unroller's own
                  ;; shape arithmetic stays step-1 only, so those keep their
                  ;; old refusal here.
                  (= step 1)
                  (>= phi-count 1)
                  (<= phi-count 2)
                  (opt-bce-mb-header-phis-ok?
                    instrs
                    0
                    phi-count
                    latch
                    preheader)
                  (opt-unroll-mb-diamond? blocks body-labels header latch)
                  ;; The 2x path pays an odd-trip guard and duplicates four
                  ;; blocks. Keep it for the store-bearing swap/update shape
                  ;; that benefits measurably; read-only reductions/searches
                  ;; are better left to the ordinary scalar loop pipeline.
                  (= (opt-unroll-mb-body-status body-blocks) 1)
                  (<=
                    (ir.compiler-ir-block-list-instruction-count body-blocks)
                    32)
                  (<= (opt-unroll-mb-live-in-count body-blocks) 6)
                  (opt-unroll-mb-counter-uses-ok? body-blocks iphi inext)
                  (opt-unroll-mb-all-fast-labels? body-labels)
                  (not
                    (opt-cfg-block-exists?
                      blocks
                      (opt-unroll-mb-guard-label header)))
                  (opt-unroll-mb-labels-fresh? blocks body-labels)
                  (opt-unroll-pred-retargetable? blocks preheader))
                  (OptUnrollMbMaybeShape.Some
                    (OptUnrollMbShape
                      header
                      latch
                      preheader
                      exit-label
                      body-labels
                      body-blocks
                      iphi
                      seed
                      inext
                      cond-var
                      bound))
                  (OptUnrollMbMaybeShape.No)))])])]))

(define (opt-unroll-mb-loop-shape
  [blocks : ir.CompilerIrBlockList]
  [entry-label : i64]
  [loop : OptNaturalLoop]) : OptUnrollMbMaybeShape
  (match loop
    [(OptNaturalLoop.Loop header latch body preheader)
      (match preheader
        [(OptLoopPreheader.No) (OptUnrollMbMaybeShape.No)]
        [(OptLoopPreheader.Some pred)
          (let
            [body-labels : OptLabelSet body.labels]
            [body-blocks : ir.CompilerIrBlockList body.blocks]
            (if (or
              (= header entry-label)
              (not (= (opt-label-count body-labels) 4)))
              (OptUnrollMbMaybeShape.No)
              (match (opt-cfg-find-block blocks latch)
                [(OptMaybeBlock.No) (OptUnrollMbMaybeShape.No)]
                [(OptMaybeBlock.Some latch-block)
                  (match (opt-bce-mb-latch-branch
                    latch-block
                    header
                    body-labels)
                    [(OptBceMbMaybeLatch.No) (OptUnrollMbMaybeShape.No)]
                    [(OptBceMbMaybeLatch.Some cond-var exit-label)
                      (let
                        [defs : opt_i64_i64_map.Map
                          (opt-bce-mb-collect-defs
                            body-blocks
                            (opt_i64_i64_map.with-capacity 64))]
                        (opt-unroll-mb-shape-finish
                          blocks
                          header
                          latch
                          pred
                          body-labels
                          body-blocks
                          (opt-bce-mb-counter-step
                            body-blocks
                            defs
                            latch
                            pred
                            cond-var)
                          cond-var
                          exit-label))])])))])]))

;; Map ordinary intra-loop phi edges for one copy. Header phis are handled
;; separately because copy 0 has three entry sources and copy 1 has one.
(define (opt-unroll-mb-clone-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [copy : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-unroll-mb-clone-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        remap
        body-labels
        copy)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (opt-unroll-subst-value remap value)
        (opt-unroll-mb-label body-labels label copy)
        (opt-unroll-mb-clone-phi-inputs
          (__tl-box-place rest)
          remap
          body-labels
          copy))]))

(define (opt-unroll-mb-clone-header-phi
  [instr : ir.CompilerIrInstr]
  [shape : OptUnrollMbShape]
  [remap0 : (__tl_dyn-array ir.CompilerIrValue)]
  [remap1 : (__tl_dyn-array ir.CompilerIrValue)]
  [copy : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (match (opt-unroll-split-phi-inputs inputs shape.latch)
        [(OptUnrollPhiSplit.No) instr]
        [(OptUnrollPhiSplit.Split init back _)
          (if (= copy 0)
            (ir.CompilerIrInstr.Phi
              (opt-bce-mb-remap-dst remap0 dst)
              (ir.compiler-ir-phi-input-cons
                init
                (opt-unroll-mb-guard-label shape.header)
                (ir.compiler-ir-phi-input-cons
                  back
                  shape.latch
                  (ir.compiler-ir-phi-input-cons
                    (opt-unroll-subst-value remap1 back)
                    (opt-unroll-mb-label shape.body-labels shape.latch 1)
                    (ir.CompilerIrPhiInputList.Nil))))
              ty)
            (ir.CompilerIrInstr.Phi
              (opt-bce-mb-remap-dst remap1 dst)
              (ir.compiler-ir-phi-input-cons
                (opt-unroll-subst-value remap0 back)
                (opt-unroll-mb-label shape.body-labels shape.latch 0)
                (ir.CompilerIrPhiInputList.Nil))
              ty))])]
    [_ instr]))

(define (opt-unroll-mb-clone-instr
  [instr : ir.CompilerIrInstr]
  [remap : (__tl_dyn-array ir.CompilerIrValue)]
  [body-labels : OptLabelSet]
  [shape : OptUnrollMbShape]
  [copy : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap lhs)
        (if (and (= copy 1) (= dst shape.inext))
          (ir.CompilerIrValue.I64 2)
          (opt-unroll-subst-value remap rhs))
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        (opt-bce-mb-remap-dst remap dst)
        op
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap base)
        (opt-unroll-subst-value remap offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-subst-value remap src)
        ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (opt-unroll-subst-value remap ptr)
        (opt-unroll-subst-value remap value)
        ty)]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        (opt-bce-mb-remap-dst remap dst)
        (opt-unroll-mb-clone-phi-inputs inputs remap body-labels copy)
        ty)]
    [(ir.CompilerIrInstr.Jump target)
      (ir.CompilerIrInstr.Jump (opt-unroll-mb-label body-labels target copy))]
    [(ir.CompilerIrInstr.Branch cond then-label else-label)
      (ir.CompilerIrInstr.Branch
        (opt-unroll-subst-value remap cond)
        (opt-unroll-mb-label body-labels then-label copy)
        (opt-unroll-mb-label body-labels else-label copy))]
    [_ instr]))

(define (opt-unroll-mb-copy0-counter-tail?
  [instr : ir.CompilerIrInstr]
  [shape : OptUnrollMbShape]) : bool
  (let
    [dst : i64 (ir.compiler-ir-instr-loop-dst-or instr (- 0 1))]
    (and
      (>= dst 0)
      (or
        (= dst shape.cond-var)
        (= (opt-bce-mb-resolve shape.body-blocks dst 16) shape.inext)))))

(define (opt-unroll-mb-clone-instrs
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [shape : OptUnrollMbShape]
  [remap0 : (__tl_dyn-array ir.CompilerIrValue)]
  [remap1 : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [copy : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (if (or
      (and
        (= copy 1)
        (= label shape.header)
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Phi dst _ _) (= dst shape.iphi)]
          [_ false]))
      ;; Copy 0 never tests or carries its intermediate counter. Dropping the
      ;; whole add/copy/compare chain prevents GVN from reusing its dominating
      ;; `i + 1` in copy 1, where the offset must remain address-only.
      (and
        (= copy 0)
        (= label shape.latch)
        (opt-unroll-mb-copy0-counter-tail?
          (ir.compiler-ir-instr-seq-ref instrs index)
          shape)))
      (opt-unroll-mb-clone-instrs
        label
        instrs
        (+ index 1)
        shape
        remap0
        remap1
        cell
        copy)
      (let
        [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
        [last? : bool (= index (- (ir.compiler-ir-instr-seq-count instrs) 1))]
        [remap : (__tl_dyn-array ir.CompilerIrValue)
          (if (= copy 0)
            remap0
            remap1)]
        [cloned : ir.CompilerIrInstr
          (if (and last? (= label shape.latch))
            (match instr
              [(ir.CompilerIrInstr.Branch cond _ _)
                (if (= copy 0)
                  (ir.CompilerIrInstr.Jump
                    (opt-unroll-mb-label shape.body-labels shape.header 1))
                  (ir.CompilerIrInstr.Branch
                    (opt-unroll-subst-value remap1 cond)
                    (opt-unroll-mb-label shape.body-labels shape.header 0)
                    shape.exit-label))]
              [_ instr])
            (if (and
              (= label shape.header)
              (match instr
                [(ir.CompilerIrInstr.Phi _ _ _) true]
                [_ false]))
              (opt-unroll-mb-clone-header-phi instr shape remap0 remap1 copy)
              (opt-unroll-mb-clone-instr
                instr
                remap
                shape.body-labels
                shape
                copy)))]
        [tail : ir.CompilerIrInstrList
          (opt-unroll-mb-clone-instrs
            label
            instrs
            (+ index 1)
            shape
            remap0
            remap1
            cell
            copy)]
        (if (= copy 1)
          (match instr
            [(ir.CompilerIrInstr.Gep _ base offset _ty)
              (if (opt-unroll-mb-direct-var? offset shape.iphi)
                (let
                  [shifted : i64 (opt-unroll-alloc-var cell)]
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.BinOp
                      shifted
                      (ir.CompilerIrBinOp.Add)
                      (opt-unroll-subst-value
                        remap0
                        (ir.CompilerIrValue.Var shape.iphi))
                      (ir.CompilerIrValue.I64 1)
                      (ast.AstType.I64))
                    (match cloned
                      [(ir.CompilerIrInstr.Gep dst _ _mapped-offset mapped-ty)
                        (ir.compiler-ir-instr-cons
                          (ir.CompilerIrInstr.Gep
                            dst
                            (opt-unroll-subst-value remap1 base)
                            (ir.CompilerIrValue.Var shifted)
                            mapped-ty)
                          tail)]
                      [_ (ir.compiler-ir-instr-cons cloned tail)])))
                (ir.compiler-ir-instr-cons cloned tail))]
            [_ (ir.compiler-ir-instr-cons cloned tail)])
          (ir.compiler-ir-instr-cons cloned tail))))))

(define (opt-unroll-mb-clone-blocks
  [blocks : ir.CompilerIrBlockList]
  [shape : OptUnrollMbShape]
  [remap0 : (__tl_dyn-array ir.CompilerIrValue)]
  [remap1 : (__tl_dyn-array ir.CompilerIrValue)]
  [cell : (__tl_dyn-array i64)]
  [copy : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.compiler-ir-block
              (opt-unroll-mb-label shape.body-labels label copy)
              (opt-unroll-mb-clone-instrs
                label
                instrs
                0
                shape
                remap0
                remap1
                cell
                copy))
            (opt-unroll-mb-clone-blocks
              (__tl-box-place rest)
              shape
              remap0
              remap1
              cell
              copy))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-clone-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        shape
        remap0
        remap1
        cell
        copy)]))

;; The original fast body is now only the odd-trip peel, so each header phi
;; keeps its outside seed (relabeled to G) and drops its old latch input.
(define (opt-unroll-mb-peel-header-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [latch : i64]
  [guard-label : i64]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (ir.compiler-ir-instr-cons
        (match instr
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (match (opt-unroll-split-phi-inputs inputs latch)
              [(OptUnrollPhiSplit.Split init _ _)
                (ir.CompilerIrInstr.Phi
                  dst
                  (ir.compiler-ir-phi-input-cons
                    init
                    guard-label
                    (ir.CompilerIrPhiInputList.Nil))
                  ty)]
              [(OptUnrollPhiSplit.No) instr])]
          [_ instr])
        (opt-unroll-mb-peel-header-instrs instrs (+ index 1) latch guard-label)))))

(define (opt-unroll-mb-extend-exit-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [latch : i64]
  [clone-latch : i64]
  [remap1 : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-unroll-mb-extend-exit-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        latch
        clone-latch
        remap1)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : ir.CompilerIrPhiInputList
          (opt-unroll-mb-extend-exit-phi-inputs
            (__tl-box-place rest)
            latch
            clone-latch
            remap1)]
        (if (= label latch)
          (ir.compiler-ir-phi-input-cons
            value
            label
            (ir.compiler-ir-phi-input-cons
              (opt-unroll-subst-value remap1 value)
              clone-latch
              tail))
          (ir.compiler-ir-phi-input-cons value label tail)))]))

(define (opt-unroll-mb-extend-exit-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [latch : i64]
  [clone-latch : i64]
  [remap1 : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrInstrList
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (ir.compiler-ir-instr-cons
        (match instr
          [(ir.CompilerIrInstr.Phi dst inputs ty)
            (ir.CompilerIrInstr.Phi
              dst
              (opt-unroll-mb-extend-exit-phi-inputs
                inputs
                latch
                clone-latch
                remap1)
              ty)]
          [_ instr])
        (opt-unroll-mb-extend-exit-instrs
          instrs
          (+ index 1)
          latch
          clone-latch
          remap1)))))

(define (opt-unroll-mb-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [shape : OptUnrollMbShape]
  [guard-block : ir.CompilerIrBlock]
  [copy0 : ir.CompilerIrBlockList]
  [copy1 : ir.CompilerIrBlockList]
  [remap1 : (__tl_dyn-array ir.CompilerIrValue)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-unroll-mb-rewrite-blocks
                (__tl-box-place rest)
                shape
                guard-block
                copy0
                copy1
                remap1)]
            (cond
              [(= label shape.header)
                (ir.compiler-ir-block-cons
                  guard-block
                  (opt-bce-mb-blocks-cons-onto
                    copy0
                    (opt-bce-mb-blocks-cons-onto
                      copy1
                      (ir.compiler-ir-block-cons
                        (ir.compiler-ir-block
                          label
                          (opt-unroll-mb-peel-header-instrs
                            instrs
                            0
                            shape.latch
                            (opt-unroll-mb-guard-label shape.header)))
                        tail))))]
              [(= label shape.preheader)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-unroll-retarget-instrs
                      instrs
                      0
                      shape.header
                      (opt-unroll-mb-guard-label shape.header)))
                  tail)]
              [(= label shape.latch)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-unroll-retarget-instrs
                      instrs
                      0
                      shape.header
                      (opt-unroll-mb-label shape.body-labels shape.header 0)))
                  tail)]
              [(opt-label-contains shape.body-labels label)
                (ir.compiler-ir-block-cons block tail)]
              [else
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-unroll-mb-extend-exit-instrs
                      instrs
                      0
                      shape.latch
                      (opt-unroll-mb-label shape.body-labels shape.latch 1)
                      remap1))
                  tail)]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        shape
        guard-block
        copy0
        copy1
        remap1)]))

(define (opt-unroll-mb-apply
  [blocks : ir.CompilerIrBlockList]
  [shape : OptUnrollMbShape]
  [frame : i64]) : OptUnrollResult
  (let
    [body-blocks : ir.CompilerIrBlockList shape.body-blocks]
    [body-labels : OptLabelSet shape.body-labels]
    [outside : opt_i64_i64_map.Map
      (opt-bce-mb-outside-uses
        (opt_i64_i64_map.with-capacity 64)
        blocks
        body-labels)]
    (if (opt-bce-mb-defs-escape? body-blocks outside)
      (OptUnrollResult.Result blocks frame false)
      (let
        [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
        [_cell : unit (set! (array-ref cell 0) frame)]
        [remap0 : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [remap1 : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [_fill0 : unit (opt-unroll-remap-fill remap0 0)]
        [_fill1 : unit (opt-unroll-remap-fill remap1 0)]
        [_alloc0 : unit (opt-bce-mb-alloc-defs! body-blocks remap0 cell)]
        [_alloc1 : unit (opt-bce-mb-alloc-defs! body-blocks remap1 cell)]
        [_counter1 : unit
          (opt-unroll-remap-set
            remap1
            shape.iphi
            (opt-unroll-subst-value remap0 (ir.CompilerIrValue.Var shape.iphi)))]
        [span : i64 (opt-unroll-alloc-var cell)]
        [odd : i64 (opt-unroll-alloc-var cell)]
        [is-odd : i64 (opt-unroll-alloc-var cell)]
        [guard-label : i64 (opt-unroll-mb-guard-label shape.header)]
        [guard-block : ir.CompilerIrBlock
          (ir.compiler-ir-block
            guard-label
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                span
                (ir.CompilerIrBinOp.Sub)
                shape.bound
                shape.seed
                (ast.AstType.I64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  odd
                  (ir.CompilerIrBinOp.BitAnd)
                  (ir.CompilerIrValue.Var span)
                  (ir.CompilerIrValue.I64 1)
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.BinOp
                    is-odd
                    (ir.CompilerIrBinOp.Ne)
                    (ir.CompilerIrValue.Var odd)
                    (ir.CompilerIrValue.I64 0)
                    (ast.AstType.I64))
                  (ir.compiler-ir-instr-cons
                    (ir.CompilerIrInstr.Branch
                      (ir.CompilerIrValue.Var is-odd)
                      shape.header
                      (opt-unroll-mb-label body-labels shape.header 0))
                    (ir.CompilerIrInstrList.Nil))))))]
        [copy0 : ir.CompilerIrBlockList
          (opt-unroll-mb-clone-blocks body-blocks shape remap0 remap1 cell 0)]
        [copy1 : ir.CompilerIrBlockList
          (opt-unroll-mb-clone-blocks body-blocks shape remap0 remap1 cell 1)]
        (OptUnrollResult.Result
          (opt-unroll-mb-rewrite-blocks
            blocks
            shape
            guard-block
            copy0
            copy1
            remap1)
          (array-ref cell 0)
          true)))))

(define (opt-unroll-mb-loops-scan
  [blocks : ir.CompilerIrBlockList]
  [_all-loops : OptNaturalLoopList]
  [loops : OptNaturalLoopList]
  [entry-label : i64]
  [frame : i64]) : OptUnrollResult
  (match loops
    [(OptNaturalLoopList.Nil) (OptUnrollResult.Result blocks frame false)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-unroll-mb-loop-shape blocks entry-label loop)
        [(OptUnrollMbMaybeShape.Some shape)
          (match (opt-unroll-mb-apply blocks shape frame)
            [(OptUnrollResult.Result next-blocks next-frame changed)
              (if changed
                (OptUnrollResult.Result next-blocks next-frame true)
                (opt-unroll-mb-loops-scan
                  blocks
                  _all-loops
                  (__tl-box-place rest)
                  entry-label
                  frame))])]
        [(OptUnrollMbMaybeShape.No)
          (opt-unroll-mb-loops-scan
            blocks
            _all-loops
            (__tl-box-place rest)
            entry-label
            frame)])]))

(define (opt-unroll-mb-blocks-have-fast-phi? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [marker : String "__bce_fast"]
            [text : String (ir.compiler-ir-label-text label)]
            (if (and
              (string.contains (& text) (& marker))
              (> (ir.compiler-ir-instr-seq-count instrs) 0)
              (ir.compiler-ir-instr-seq-phi? instrs 0))
              true
              (opt-unroll-mb-blocks-have-fast-phi? (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-unroll-mb-blocks-have-fast-phi?
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Cheap companion to the original self-loop-only prescan. The full
;; dominance-based natural-loop and diamond checks remain behind this gate.
(define (opt-unroll-mb-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-unroll-mb-blocks-have-fast-phi? blocks))

;; --- invariant-offset Gep splitting (gep_offset) -----------------------------
;;
;; A loop body that reads `base[invariant + counter]` lowers to a THREE-term
;; address: `A = Add I, V` inside the loop, then `Gep base, A`. The x86 SIB mode
;; is `disp(base, index, scale)` -- one register base plus one register index --
;; so the third term costs a `lea` per access per iteration.
;; `benchmarks/intern_table`'s `it-slice-eq?` byte compare pays that twice per
;; byte; the C twin hoists `p = names + name_start` once and loads `(p,i,1)`.
;;
;; Gep is exactly associative in its index -- `Gep b, (I + V) : t` and
;; `Gep (Gep b, I : t), V : t` both address `b + (I + V) * sizeof t` -- so the
;; fix is to split the address rather than to build an induction variable:
;; compute the derived base `T = Gep b, I : t` once in the loop preheader and
;; leave `Gep T, V : t` in the body. The Add then has no uses left and the
;; pipeline DCE retires it.
;;
;; Why not the induction pass. `opt-induction-affine-offset-from-add` only
;; recognizes `phi + literal`, so a `var + var` index is invisible to it, and
;; `opt-induction-gep-stride-pays?` deliberately refuses SIB strides because a
;; pointer INDUCTION VARIABLE at those strides buys nothing: it adds a latch add
;; and a loop-live range for an address the SIB mode forms for free. A derived
;; BASE is not an induction variable -- no phi, no latch step, one preheader
;; instruction -- so that veto does not reach it.
;;
;; Why this late. Two orderings pin the pass. Before `bce_version` the same Add
;; also feeds the body's BoundsCheck, so splitting the Gep would leave the Add
;; live and cost an instruction instead of saving one; only the fast clone has
;; the single-use Add this pass needs. And before `post_lftr_licm` a versioned
;; clone still loads its array's data pointer INSIDE the body -- that LICM run
;; is what lifts the load into the preheader -- so the base is not yet loop
;; invariant and the address does not read as base-plus-invariant at all. The
;; slot immediately after `post_lftr_licm` is the first point where both hold.
;;
;; Register pressure. With k distinct bases sharing one invariant addend the
;; loop trades `{I, b_1..b_k}` for `{T_1..T_k}`: one fewer live value when the
;; addend dies with the Adds, level when it does not. It is only additive when
;; a base outlives the Geps rewritten here, so a base with any other in-loop use
;; disqualifies the whole Add. The addend gate is the same rule from the other
;; side: a surviving addend is admitted only when k >= 2, where the removed Add
;; still pays for the one extra live value.
;;
;; The pressure gates read use counts collected over the PROVISIONALLY accepted
;; Adds. Rejecting one Add can leave those counts high for another Add sharing a
;; base, which only makes the heuristic slightly optimistic in that shape;
;; correctness never depends on them.
;;
;; A bce fast clone is entered straight from its guard chain, so its header has
;; no dedicated preheader (`opt-natural-loop-safe-preheader-block?` wants a sole
;; successor). Loops that carry a candidate get one synthesized first, reusing
;; `opt-loop-preheaders-synthesize-loop` a loop at a time so that only the loops
;; this pass actually rewrites pay for a block.
;; preheader-label, derived dst, base, invariant index, element type.
(defenum OptGepOffsetDerived
  (Derived i64 i64 ir.CompilerIrValue ir.CompilerIrValue ast.AstType))

(defenum OptGepOffsetDerivedList
  (Nil)
  (Dense (__tl_dyn-array OptGepOffsetDerived) i64))

(define (opt-gep-offset-derived-ref
  [derived : OptGepOffsetDerivedList]
  [index : i64]) : OptGepOffsetDerived
  (match derived
    [(OptGepOffsetDerivedList.Nil)
      (OptGepOffsetDerived.Derived
        -1
        -1
        (ir.CompilerIrValue.I64 0)
        (ir.CompilerIrValue.I64 0)
        (ast.AstType.I64))]
    [(OptGepOffsetDerivedList.Dense items len)
      (array-ref items (- (- len 1) index))]))

(define (opt-gep-offset-derived-tail [derived : OptGepOffsetDerivedList]) : OptGepOffsetDerivedList
  (match derived
    [(OptGepOffsetDerivedList.Nil) (OptGepOffsetDerivedList.Nil)]
    [(OptGepOffsetDerivedList.Dense items len)
      (if (<= len 1)
        (OptGepOffsetDerivedList.Nil)
        (OptGepOffsetDerivedList.Dense items (- len 1)))]))

(define (opt-gep-offset-derived-cons
  [record : OptGepOffsetDerived]
  [derived : OptGepOffsetDerivedList]) : OptGepOffsetDerivedList
  (match derived
    [(OptGepOffsetDerivedList.Nil)
      (let
        [items : (__tl_dyn-array OptGepOffsetDerived)
          (array.make-array OptGepOffsetDerived 4)]
        (begin
          (set! (array-ref items 0) record)
          (OptGepOffsetDerivedList.Dense items 1)))]
    [(OptGepOffsetDerivedList.Dense items len)
      (if (< len (array-length items))
        (begin
          (set! (array-ref items len) record)
          (OptGepOffsetDerivedList.Dense items (+ len 1)))
        (let
          [bigger : (__tl_dyn-array OptGepOffsetDerived)
            (array.make-array OptGepOffsetDerived (opt-dense-next-capacity len))]
          [index : i64 0]
          (begin
            (while (< index len)
              (begin
                (set! (array-ref bigger index) (array-ref items index))
                (set! index (+ index 1))))
            (set! (array-ref bigger len) record)
            (OptGepOffsetDerivedList.Dense bigger (+ len 1)))))]))

(cfg
  test
  (test
    optimizer-gep-derived-dense-storage-grows
    (let
      [derived : OptGepOffsetDerivedList (OptGepOffsetDerivedList.Nil)]
      [index : i64 0]
      (begin
        (while (< index 9)
          (begin
            (set!
              derived
              (opt-gep-offset-derived-cons
                (OptGepOffsetDerived.Derived
                  index
                  (+ index 10)
                  (ir.CompilerIrValue.Var (+ index 20))
                  (ir.CompilerIrValue.Var (+ index 30))
                  (ast.AstType.I64))
                derived))
            (set! index (+ index 1))))
        (match derived
          [(OptGepOffsetDerivedList.Nil)
            (test.assert-true false "GEP derived storage is non-empty")]
          [(OptGepOffsetDerivedList.Dense items len)
            (begin
              (test.assert-i64-eq len 9 "GEP derived storage grows past four")
              (test.assert-true
                (>= (array-length items) 9)
                "GEP derived storage expands capacity"))])
        (match (opt-gep-offset-derived-ref derived 0)
          [(OptGepOffsetDerived.Derived label dst base offset ty)
            (begin
              (test.assert-i64-eq
                label
                8
                "GEP newest derived record stays first")
              (test.assert-i64-eq dst 18 "GEP derived destination is preserved")
              (match base
                [(ir.CompilerIrValue.Var var)
                  (test.assert-i64-eq var 28 "GEP derived base is preserved")]
                [_ (test.assert-true false "GEP derived base stays a var")])
              (match offset
                [(ir.CompilerIrValue.Var var)
                  (test.assert-i64-eq var 38 "GEP derived offset is preserved")]
                [_ (test.assert-true false "GEP derived offset stays a var")])
              (match ty
                [(ast.AstType.I64) unit]
                [_ (test.assert-true false "GEP derived type is preserved")]))])
        (match (opt-gep-offset-derived-ref derived 8)
          [(OptGepOffsetDerived.Derived label _ _ _ _)
            (test.assert-i64-eq label 0 "GEP oldest derived record stays last")])))))

;; The invariant addend and the loop-variant addend of an admissible Add.
(defenum OptGepOffsetSplit
  (No)
  (Some i64 i64))

(defenum OptGepOffsetPreheaderResult
  (Result ir.CompilerIrBlockList OptCfgContext bool))

(defenum OptGepOffsetPlanResult
  (Result ir.CompilerIrBlockList i64 bool))

(define (opt-gep-offset-fill! [items : (__tl_dyn-array i64)] [value : i64]) : unit
  (let
    [count : i64 (array-length items)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (set! (array-ref items cursor) value)
        (set! cursor (+ cursor 1))))))

;; An element scale the SIB byte can encode. A wider stride keeps a multiply in
;; the loop either way, so splitting its address buys nothing.
(define (opt-gep-offset-sib-scale?
  [type-segment-bases : i64]
  [elem-ty : ast.AstType]) : bool
  (let
    [scale : i64 (opt-scratch-alloc-type-size type-segment-bases elem-ty)]
    (or (= scale 1) (= scale 2) (= scale 4) (= scale 8))))

;; var -> id of the block that defines it; -1 for parameters and unknowns. The
;; ids are block-list positions, which is what `opt-loop-body-contains-id?`
;; indexes.
(define (opt-gep-offset-defs-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [block-id : i64]
  [def-block : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs cursor))
          [(option_i64.Some dst)
            (if (and (>= dst 0) (< dst (array-length def-block)))
              (set! (array-ref def-block dst) block-id)
              unit)]
          [(option_i64.None) unit])
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-defs-blocks!
  [blocks : ir.CompilerIrBlockList]
  [block-id : i64]
  [def-block : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-defs-instrs! instrs block-id def-block)
            (opt-gep-offset-defs-blocks!
              (__tl-box-place rest)
              (+ block-id 1)
              def-block))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-defs-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        block-id
        def-block)]))

;; Whole-function census keyed by the var a Gep uses as its variable INDEX:
;; how many Geps index on it, whether any of them disqualifies it (non-variable
;; base or non-SIB scale), the first base named, and whether a later Gep named a
;; different one. None of this depends on a loop, so it is collected once.
(define (opt-gep-offset-census-instrs!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [base0 : (__tl_dyn-array i64)]
  [multi-base : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (match (ir.compiler-ir-instr-seq-ref instrs cursor)
          [(ir.CompilerIrInstr.Gep _ base offset elem-ty)
            (match offset
              [(ir.CompilerIrValue.Var idx)
                (if (and (>= idx 0) (< idx (array-length gep-uses)))
                  (begin
                    (set!
                      (array-ref gep-uses idx)
                      (+ (array-ref gep-uses idx) 1))
                    (if (opt-gep-offset-sib-scale? type-segment-bases elem-ty)
                      unit
                      (set! (array-ref poison idx) 1))
                    (match base
                      [(ir.CompilerIrValue.Var b)
                        (if (< (array-ref base0 idx) 0)
                          (set! (array-ref base0 idx) b)
                          (if (= (array-ref base0 idx) b)
                            unit
                            (set! (array-ref multi-base idx) 1)))]
                      [_ (set! (array-ref poison idx) 1)]))
                  unit)]
              [_ unit])]
          [_ unit])
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-census-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [base0 : (__tl_dyn-array i64)]
  [multi-base : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-census-instrs!
              type-segment-bases
              instrs
              gep-uses
              poison
              base0
              multi-base)
            (opt-gep-offset-census-blocks!
              type-segment-bases
              (__tl-box-place rest)
              gep-uses
              poison
              base0
              multi-base))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-census-blocks!
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        gep-uses
        poison
        base0
        multi-base)]))

;; Uses that the pipeline DCE retires before the backend sees them. Removing a
;; BoundsCheck strands a dead `Cast` of the very Add this pass wants to split,
;; and counting that stale use fails the all-uses gate for a value that is
;; genuinely single-use by the time it is lowered. Only pure single-destination
;; kinds are retired, and only once their own result is already unused, so this
;; never claims a live instruction is dead. The per-loop pressure counts stay on
;; the raw numbers: over-counting there only rejects.
(define (opt-gep-offset-strandable? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.AddrOf _ _) true]
    [_ false]))

(define (opt-gep-offset-settle-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [dead-uses : (__tl_dyn-array i64)]
  [dead : (__tl_dyn-array i64)]
  [changed : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs cursor)]
          (if (opt-gep-offset-strandable? instr)
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (if (and
                  (>= dst 0)
                  (< dst (array-length dead))
                  (= (array-ref dead dst) 0)
                  (<= (- (array-ref uses dst) (array-ref dead-uses dst)) 0))
                  (begin
                    (set! (array-ref dead dst) 1)
                    (opt-collect-instr-uses-array dead-uses instr)
                    (set! (array-ref changed 0) 1))
                  unit)]
              [(option_i64.None) unit])
            unit))
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-settle-blocks!
  [blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [dead-uses : (__tl_dyn-array i64)]
  [dead : (__tl_dyn-array i64)]
  [changed : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-settle-instrs! instrs uses dead-uses dead changed)
            (opt-gep-offset-settle-blocks!
              (__tl-box-place rest)
              uses
              dead-uses
              dead
              changed))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-settle-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        uses
        dead-uses
        dead
        changed)]))

(define (opt-gep-offset-settle-rounds!
  [blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [dead-uses : (__tl_dyn-array i64)]
  [dead : (__tl_dyn-array i64)]
  [changed : (__tl_dyn-array i64)]
  [remaining : i64]) : unit
  (if (<= remaining 0)
    unit
    (begin
      (set! (array-ref changed 0) 0)
      (opt-gep-offset-settle-blocks! blocks uses dead-uses dead changed)
      (if (= (array-ref changed 0) 1)
        (opt-gep-offset-settle-rounds!
          blocks
          uses
          dead-uses
          dead
          changed
          (- remaining 1))
        unit))))

;; Whole-function use counts with the DCE-retired chains already subtracted.
(define (opt-gep-offset-effective-uses
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : (__tl_dyn-array i64)
  (let
    [uses : (__tl_dyn-array i64) (opt-collect-blocks-uses-array frame blocks)]
    [dead-uses : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [dead : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [changed : (__tl_dyn-array i64) (array.make-array i64 1)]
    [_settle : unit
      (opt-gep-offset-settle-rounds!
        blocks
        uses
        dead-uses
        dead
        changed
        (+ frame 1))]
    [cursor : i64 0]
    (begin
      (while (< cursor frame)
        (begin
          (set!
            (array-ref uses cursor)
            (- (array-ref uses cursor) (array-ref dead-uses cursor)))
          (set! cursor (+ cursor 1))))
      uses)))

(define (opt-gep-offset-var-in-loop?
  [var : i64]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]) : bool
  (if (or (< var 0) (>= var (array-length def-block)))
    false
    (let
      [id : i64 (array-ref def-block var)]
      (if (< id 0)
        false
        (opt-loop-body-contains-id? body id)))))

;; `Add x, y` with two variable operands, exactly one of which the loop defines.
(define (opt-gep-offset-add-split
  [instr : ir.CompilerIrInstr]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]) : OptGepOffsetSplit
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
      (match op
        [(ir.CompilerIrBinOp.Add)
          (match lhs
            [(ir.CompilerIrValue.Var a)
              (match rhs
                [(ir.CompilerIrValue.Var b)
                  (let
                    [a-in : bool (opt-gep-offset-var-in-loop? a def-block body)]
                    [b-in : bool (opt-gep-offset-var-in-loop? b def-block body)]
                    (if a-in
                      (if b-in
                        (OptGepOffsetSplit.No)
                        (OptGepOffsetSplit.Some b a))
                      (if b-in
                        (OptGepOffsetSplit.Some a b)
                        (OptGepOffsetSplit.No))))]
                [_ (OptGepOffsetSplit.No)])]
            [_ (OptGepOffsetSplit.No)])]
        [_ (OptGepOffsetSplit.No)])]
    [_ (OptGepOffsetSplit.No)]))

;; Every use of the Add anywhere in the function is an eligible Gep index, and
;; there is at least one. A use outside the loop is fine: the derived base
;; dominates the preheader, which dominates every block the Add dominates.
(define (opt-gep-offset-uses-all-geps?
  [dst : i64]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]) : bool
  (and
    (>= dst 0)
    (< dst (array-length uses))
    (= (array-ref poison dst) 0)
    (>= (array-ref uses dst) 1)
    (= (array-ref uses dst) (array-ref gep-uses dst))))

;; The shape test that does not need any per-loop array: used both to decide
;; whether a loop is worth synthesizing a preheader for and to seed the plan.
(define (opt-gep-offset-instr-candidate?
  [instr : ir.CompilerIrInstr]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]) : bool
  (match (opt-gep-offset-add-split instr def-block body)
    [(OptGepOffsetSplit.No) false]
    [(OptGepOffsetSplit.Some _ _)
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (opt-gep-offset-uses-all-geps? dst uses gep-uses poison)]
        [(option_i64.None) false])]))

(define (opt-gep-offset-block-has-candidate?
  [instrs : ir.CompilerIrInstrSeq]
  [cursor : i64]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]) : bool
  (if (>= cursor (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-gep-offset-instr-candidate?
      (ir.compiler-ir-instr-seq-ref instrs cursor)
      uses
      gep-uses
      poison
      def-block
      body)
      true
      (opt-gep-offset-block-has-candidate?
        instrs
        (+ cursor 1)
        uses
        gep-uses
        poison
        def-block
        body))))

(define (opt-gep-offset-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-gep-offset-block-has-candidate?
            instrs
            0
            uses
            gep-uses
            poison
            def-block
            body)
            true
            (opt-gep-offset-blocks-have-candidate?
              (__tl-box-place rest)
              uses
              gep-uses
              poison
              def-block
              body))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-blocks-have-candidate?
        (ir.compiler-ir-block-seq-to-list seq)
        uses
        gep-uses
        poison
        def-block
        body)]))

(define (opt-gep-offset-loop-has-candidate?
  [loop : OptNaturalLoop]
  [blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]) : bool
  (opt-gep-offset-blocks-have-candidate?
    (opt-natural-loop-current-body-blocks loop blocks)
    uses
    gep-uses
    poison
    def-block
    (opt-natural-loop-body-info loop)))

;; The first loop that carries a candidate but has no dedicated preheader.
(define (opt-gep-offset-first-preheaderless
  [loops : OptNaturalLoopList]
  [blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]) : OptMaybeNaturalLoop
  (match loops
    [(OptNaturalLoopList.Nil) (OptMaybeNaturalLoop.No)]
    [(OptNaturalLoopList.Cons loop rest)
      (match (opt-natural-loop-preheader loop)
        [(OptLoopPreheader.Some _)
          (opt-gep-offset-first-preheaderless
            (__tl-box-place rest)
            blocks
            uses
            gep-uses
            poison
            def-block)]
        [(OptLoopPreheader.No)
          (if (opt-gep-offset-loop-has-candidate?
            loop
            blocks
            uses
            gep-uses
            poison
            def-block)
            (OptMaybeNaturalLoop.Some loop)
            (opt-gep-offset-first-preheaderless
              (__tl-box-place rest)
              blocks
              uses
              gep-uses
              poison
              def-block))])]))

;; One synthesis per round: the CFG (and therefore `context`) is stale straight
;; afterwards, exactly as `opt-loop-preheaders-blocks-fixed-result` handles it.
(define (opt-gep-offset-prepare-preheaders
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]
  [remaining : i64]
  [changed : bool]) : OptGepOffsetPreheaderResult
  (if (<= remaining 0)
    (OptGepOffsetPreheaderResult.Result blocks context changed)
    (let
      [uses : (__tl_dyn-array i64) (opt-gep-offset-effective-uses blocks frame)]
      [gep-uses : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [poison : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [base0 : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [multi-base : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [def-block : (__tl_dyn-array i64) (array.make-array i64 frame)]
      [_base0 : unit (opt-gep-offset-fill! base0 (- 0 1))]
      [_defs : unit
        (begin
          (opt-gep-offset-fill! def-block (- 0 1))
          (opt-gep-offset-defs-blocks! blocks 0 def-block))]
      [_census : unit
        (opt-gep-offset-census-blocks!
          type-segment-bases
          blocks
          gep-uses
          poison
          base0
          multi-base)]
      (match (opt-gep-offset-first-preheaderless
        (opt-cfg-natural-loops-with-context blocks context)
        blocks
        uses
        gep-uses
        poison
        def-block)
        [(OptMaybeNaturalLoop.No)
          (OptGepOffsetPreheaderResult.Result blocks context changed)]
        [(OptMaybeNaturalLoop.Some loop)
          (match (opt-loop-preheaders-synthesize-loop blocks context loop)
            [(OptBlockListPassResult.Result next synthesized)
              (if synthesized
                (opt-gep-offset-prepare-preheaders
                  type-segment-bases
                  next
                  (opt-cfg-context-build next)
                  frame
                  (- remaining 1)
                  true)
                (OptGepOffsetPreheaderResult.Result blocks context changed))])]))))

;; --- per-loop plan ------------------------------------------------------------
;; Provisional acceptance: shape plus the all-uses-are-Gep-indices gate.
(define (opt-gep-offset-mark-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]
  [cand-var : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs cursor)]
          (match (opt-gep-offset-add-split instr def-block body)
            [(OptGepOffsetSplit.No) unit]
            [(OptGepOffsetSplit.Some inv variant)
              (match (opt-instr-def-var instr)
                [(option_i64.Some dst)
                  (if (opt-gep-offset-uses-all-geps? dst uses gep-uses poison)
                    (begin
                      (set! (array-ref cand dst) 1)
                      (set! (array-ref cand-inv dst) inv)
                      (set! (array-ref cand-var dst) variant))
                    unit)]
                [(option_i64.None) unit])]))
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-mark-blocks!
  [blocks : ir.CompilerIrBlockList]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]
  [cand-var : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-mark-instrs!
              instrs
              uses
              gep-uses
              poison
              def-block
              body
              cand
              cand-inv
              cand-var)
            (opt-gep-offset-mark-blocks!
              (__tl-box-place rest)
              uses
              gep-uses
              poison
              def-block
              body
              cand
              cand-inv
              cand-var))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-mark-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        uses
        gep-uses
        poison
        def-block
        body
        cand
        cand-inv
        cand-var)]))

;; Correctness filter: the derived base is emitted in the preheader, so every
;; Gep that indexes on a candidate must name a base the loop does not define.
(define (opt-gep-offset-drop-variant-bases-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]
  [cand : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (match (ir.compiler-ir-instr-seq-ref instrs cursor)
          [(ir.CompilerIrInstr.Gep _ base offset _)
            (match offset
              [(ir.CompilerIrValue.Var idx)
                (if (and
                  (>= idx 0)
                  (< idx (array-length cand))
                  (= (array-ref cand idx) 1))
                  (match base
                    [(ir.CompilerIrValue.Var b)
                      (if (opt-gep-offset-var-in-loop? b def-block body)
                        (set! (array-ref cand idx) 0)
                        unit)]
                    [_ (set! (array-ref cand idx) 0)])
                  unit)]
              [_ unit])]
          [_ unit])
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-drop-variant-bases-blocks!
  [blocks : ir.CompilerIrBlockList]
  [def-block : (__tl_dyn-array i64)]
  [body : OptLoopBody]
  [cand : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-drop-variant-bases-instrs!
              instrs
              def-block
              body
              cand)
            (opt-gep-offset-drop-variant-bases-blocks!
              (__tl-box-place rest)
              def-block
              body
              cand))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-drop-variant-bases-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        def-block
        body
        cand)]))

;; In-loop uses that the rewrite removes: a base named by a surviving
;; candidate's Gep, and the invariant operand of a surviving candidate Add.
(define (opt-gep-offset-count-split-uses-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]
  [base-split : (__tl_dyn-array i64)]
  [addend-split : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs cursor)]
          (begin
            (match instr
              [(ir.CompilerIrInstr.Gep _ base offset _)
                (match offset
                  [(ir.CompilerIrValue.Var idx)
                    (if (and
                      (>= idx 0)
                      (< idx (array-length cand))
                      (= (array-ref cand idx) 1))
                      (match base
                        [(ir.CompilerIrValue.Var b)
                          (if (and (>= b 0) (< b (array-length base-split)))
                            (set!
                              (array-ref base-split b)
                              (+ (array-ref base-split b) 1))
                            unit)]
                        [_ unit])
                      unit)]
                  [_ unit])]
              [_ unit])
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (if (and
                  (>= dst 0)
                  (< dst (array-length cand))
                  (= (array-ref cand dst) 1))
                  (let
                    [inv : i64 (array-ref cand-inv dst)]
                    (if (and (>= inv 0) (< inv (array-length addend-split)))
                      (set!
                        (array-ref addend-split inv)
                        (+ (array-ref addend-split inv) 1))
                      unit))
                  unit)]
              [(option_i64.None) unit])))
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-count-split-uses-blocks!
  [blocks : ir.CompilerIrBlockList]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]
  [base-split : (__tl_dyn-array i64)]
  [addend-split : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-count-split-uses-instrs!
              instrs
              cand
              cand-inv
              base-split
              addend-split)
            (opt-gep-offset-count-split-uses-blocks!
              (__tl-box-place rest)
              cand
              cand-inv
              base-split
              addend-split))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-count-split-uses-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        cand
        cand-inv
        base-split
        addend-split)]))

;; Pressure gates. A base that outlives the rewritten Geps would add a live
;; value outright, so it rejects its Add; a surviving addend is admitted only
;; when the Add feeds two or more distinct bases.
(define (opt-gep-offset-apply-pressure-gates-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [loop-uses : (__tl_dyn-array i64)]
  [base-split : (__tl_dyn-array i64)]
  [addend-split : (__tl_dyn-array i64)]
  [multi-base : (__tl_dyn-array i64)]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    (while (< cursor count)
      (begin
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs cursor)]
          (begin
            (match instr
              [(ir.CompilerIrInstr.Gep _ base offset _)
                (match offset
                  [(ir.CompilerIrValue.Var idx)
                    (if (and
                      (>= idx 0)
                      (< idx (array-length cand))
                      (= (array-ref cand idx) 1))
                      (match base
                        [(ir.CompilerIrValue.Var b)
                          (if (and
                            (>= b 0)
                            (< b (array-length loop-uses))
                            (= (array-ref loop-uses b) (array-ref base-split b)))
                            unit
                            (set! (array-ref cand idx) 0))]
                        [_ (set! (array-ref cand idx) 0)])
                      unit)]
                  [_ unit])]
              [_ unit])
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (if (and
                  (>= dst 0)
                  (< dst (array-length cand))
                  (= (array-ref cand dst) 1))
                  (let
                    [inv : i64 (array-ref cand-inv dst)]
                    (if (or
                      (= (array-ref multi-base dst) 1)
                      (and
                        (>= inv 0)
                        (< inv (array-length loop-uses))
                        (=
                          (array-ref loop-uses inv)
                          (array-ref addend-split inv))))
                      unit
                      (set! (array-ref cand dst) 0)))
                  unit)]
              [(option_i64.None) unit])))
        (set! cursor (+ cursor 1))))))

(define (opt-gep-offset-apply-pressure-gates-blocks!
  [blocks : ir.CompilerIrBlockList]
  [loop-uses : (__tl_dyn-array i64)]
  [base-split : (__tl_dyn-array i64)]
  [addend-split : (__tl_dyn-array i64)]
  [multi-base : (__tl_dyn-array i64)]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-offset-apply-pressure-gates-instrs!
              instrs
              loop-uses
              base-split
              addend-split
              multi-base
              cand
              cand-inv)
            (opt-gep-offset-apply-pressure-gates-blocks!
              (__tl-box-place rest)
              loop-uses
              base-split
              addend-split
              multi-base
              cand
              cand-inv))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-apply-pressure-gates-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        loop-uses
        base-split
        addend-split
        multi-base
        cand
        cand-inv)]))

;; Assign one derived base per (base, element type) reached in this loop and
;; record the Geps that adopt it. Geps already claimed by an enclosing loop keep
;; that assignment: a var is rewritten once.
(define (opt-gep-offset-assign-instrs!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [preheader : i64]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]
  [cand-var : (__tl_dyn-array i64)]
  [derived-var : (__tl_dyn-array i64)]
  [derived-inv : (__tl_dyn-array i64)]
  [derived-ty : (__tl_dyn-array ast.AstType)]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]
  [cell : (__tl_dyn-array i64)]
  [acc : OptGepOffsetDerivedList]) : OptGepOffsetDerivedList
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [cursor : i64 0]
    [out : OptGepOffsetDerivedList acc]
    (begin
      (while (< cursor count)
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs cursor)
            [(ir.CompilerIrInstr.Gep dst base offset elem-ty)
              (match offset
                [(ir.CompilerIrValue.Var idx)
                  (if (and
                    (>= idx 0)
                    (< idx (array-length cand))
                    (= (array-ref cand idx) 1)
                    (>= dst 0)
                    (< dst (array-length gep-mark))
                    (= (array-ref gep-mark dst) 0))
                    (match base
                      [(ir.CompilerIrValue.Var b)
                        (let
                          [cached : i64
                            (if (and (>= b 0) (< b (array-length derived-var)))
                              (array-ref derived-var b)
                              (- 0 1))]
                          ;; The cache key is the WHOLE recipe. One array
                          ;; indexed at two different invariant offsets in the
                          ;; same loop needs a derived base each; keying on the
                          ;; base alone would silently retarget the second
                          ;; address to the first one's offset.
                          [reuse? : bool
                            (and
                              (>= cached 0)
                              (=
                                (array-ref derived-inv b)
                                (array-ref cand-inv idx))
                              (opt-type-eq
                                type-segment-bases
                                (array-ref derived-ty b)
                                elem-ty))]
                          [derived : i64
                            (if reuse?
                              cached
                              (opt-bce-version-alloc-var cell))]
                          (begin
                            (if reuse?
                              unit
                              (begin
                                (if (and
                                  (>= b 0)
                                  (< b (array-length derived-var)))
                                  (begin
                                    (set! (array-ref derived-var b) derived)
                                    (set!
                                      (array-ref derived-inv b)
                                      (array-ref cand-inv idx))
                                    (set! (array-ref derived-ty b) elem-ty))
                                  unit)
                                (set!
                                  out
                                  (opt-gep-offset-derived-cons
                                    (OptGepOffsetDerived.Derived
                                      preheader
                                      derived
                                      base
                                      (ir.CompilerIrValue.Var
                                        (array-ref cand-inv idx))
                                      elem-ty)
                                    out))))
                            (set! (array-ref gep-mark dst) 1)
                            (set! (array-ref gep-base dst) derived)
                            (set!
                              (array-ref gep-index dst)
                              (array-ref cand-var idx))))]
                      [_ unit])
                    unit)]
                [_ unit])]
            [_ unit])
          (set! cursor (+ cursor 1))))
      out)))

(define (opt-gep-offset-assign-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [preheader : i64]
  [cand : (__tl_dyn-array i64)]
  [cand-inv : (__tl_dyn-array i64)]
  [cand-var : (__tl_dyn-array i64)]
  [derived-var : (__tl_dyn-array i64)]
  [derived-inv : (__tl_dyn-array i64)]
  [derived-ty : (__tl_dyn-array ast.AstType)]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]
  [cell : (__tl_dyn-array i64)]
  [acc : OptGepOffsetDerivedList]) : OptGepOffsetDerivedList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-gep-offset-assign-blocks!
            type-segment-bases
            (__tl-box-place rest)
            preheader
            cand
            cand-inv
            cand-var
            derived-var
            derived-inv
            derived-ty
            gep-mark
            gep-base
            gep-index
            cell
            (opt-gep-offset-assign-instrs!
              type-segment-bases
              instrs
              preheader
              cand
              cand-inv
              cand-var
              derived-var
              derived-inv
              derived-ty
              gep-mark
              gep-base
              gep-index
              cell
              acc))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-assign-blocks!
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        preheader
        cand
        cand-inv
        cand-var
        derived-var
        derived-inv
        derived-ty
        gep-mark
        gep-base
        gep-index
        cell
        acc)]))

(define (opt-gep-offset-plan-loop
  [type-segment-bases : i64]
  [loop : OptNaturalLoop]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [multi-base : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]
  [cell : (__tl_dyn-array i64)]
  [acc : OptGepOffsetDerivedList]) : OptGepOffsetDerivedList
  (match (opt-natural-loop-preheader loop)
    [(OptLoopPreheader.No) acc]
    [(OptLoopPreheader.Some preheader)
      (let
        [body : OptLoopBody (opt-natural-loop-body-info loop)]
        [body-blocks : ir.CompilerIrBlockList
          (opt-natural-loop-current-body-blocks loop blocks)]
        (if (not
          (opt-gep-offset-blocks-have-candidate?
            body-blocks
            uses
            gep-uses
            poison
            def-block
            body))
          acc
          (let
            [cand : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [cand-inv : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [cand-var : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [base-split : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [addend-split : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [derived-var : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [derived-inv : (__tl_dyn-array i64) (array.make-array i64 frame)]
            [derived-ty : (__tl_dyn-array ast.AstType)
              (array.make-array ast.AstType frame)]
            [loop-uses : (__tl_dyn-array i64)
              (opt-collect-blocks-uses-array frame body-blocks)]
            [_derived : unit (opt-gep-offset-fill! derived-var (- 0 1))]
            [_mark : unit
              (opt-gep-offset-mark-blocks!
                body-blocks
                uses
                gep-uses
                poison
                def-block
                body
                cand
                cand-inv
                cand-var)]
            [_bases : unit
              (opt-gep-offset-drop-variant-bases-blocks!
                blocks
                def-block
                body
                cand)]
            [_counts : unit
              (opt-gep-offset-count-split-uses-blocks!
                body-blocks
                cand
                cand-inv
                base-split
                addend-split)]
            [_gates : unit
              (opt-gep-offset-apply-pressure-gates-blocks!
                body-blocks
                loop-uses
                base-split
                addend-split
                multi-base
                cand
                cand-inv)]
            (opt-gep-offset-assign-blocks!
              type-segment-bases
              blocks
              preheader
              cand
              cand-inv
              cand-var
              derived-var
              derived-inv
              derived-ty
              gep-mark
              gep-base
              gep-index
              cell
              acc))))]))

(define (opt-gep-offset-plan-loops
  [type-segment-bases : i64]
  [loops : OptNaturalLoopList]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [poison : (__tl_dyn-array i64)]
  [multi-base : (__tl_dyn-array i64)]
  [def-block : (__tl_dyn-array i64)]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]
  [cell : (__tl_dyn-array i64)]
  [acc : OptGepOffsetDerivedList]) : OptGepOffsetDerivedList
  (match loops
    [(OptNaturalLoopList.Nil) acc]
    [(OptNaturalLoopList.Cons loop rest)
      (opt-gep-offset-plan-loops
        type-segment-bases
        (__tl-box-place rest)
        blocks
        frame
        uses
        gep-uses
        poison
        multi-base
        def-block
        gep-mark
        gep-base
        gep-index
        cell
        (opt-gep-offset-plan-loop
          type-segment-bases
          loop
          blocks
          frame
          uses
          gep-uses
          poison
          multi-base
          def-block
          gep-mark
          gep-base
          gep-index
          cell
          acc))]))

;; --- rewrite ------------------------------------------------------------------
(define (opt-gep-offset-rewrite-instr
  [instr : ir.CompilerIrInstr]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Gep dst _ _ elem-ty)
      (if (and
        (>= dst 0)
        (< dst (array-length gep-mark))
        (= (array-ref gep-mark dst) 1))
        (ir.CompilerIrInstr.Gep
          dst
          (ir.CompilerIrValue.Var (array-ref gep-base dst))
          (ir.CompilerIrValue.Var (array-ref gep-index dst))
          elem-ty)
        instr)]
    [_ instr]))

(define (opt-gep-offset-rewrite-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [cursor : i64 0]
    (begin
      (while (< cursor count)
        (begin
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (opt-gep-offset-rewrite-instr
              (ir.compiler-ir-instr-seq-ref instrs cursor)
              gep-mark
              gep-base
              gep-index))
          (set! cursor (+ cursor 1))))
      (ir.compiler-ir-instr-builder-to-seq builder))))

;; The derived Geps this label owns, in plan order.
(define (opt-gep-offset-hoisted-for-label
  [derived : OptGepOffsetDerivedList]
  [label : i64]) : ir.CompilerIrInstrList
  (match derived
    [(OptGepOffsetDerivedList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(OptGepOffsetDerivedList.Dense _ _)
      (match (opt-gep-offset-derived-ref derived 0)
        [(OptGepOffsetDerived.Derived record-label dst base index elem-ty)
          (if (= record-label label)
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.Gep dst base index elem-ty)
              (opt-gep-offset-hoisted-for-label
                (opt-gep-offset-derived-tail derived)
                label))
            (opt-gep-offset-hoisted-for-label
              (opt-gep-offset-derived-tail derived)
              label))])]))

(define (opt-gep-offset-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [derived : OptGepOffsetDerivedList]
  [gep-mark : (__tl_dyn-array i64)]
  [gep-base : (__tl_dyn-array i64)]
  [gep-index : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-licm-insert-before-terminator-seq
                (opt-gep-offset-hoisted-for-label derived label)
                (opt-gep-offset-rewrite-instr-seq
                  instrs
                  gep-mark
                  gep-base
                  gep-index)))
            (opt-gep-offset-rewrite-blocks
              (__tl-box-place rest)
              derived
              gep-mark
              gep-base
              gep-index))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-offset-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        derived
        gep-mark
        gep-base
        gep-index)]))

(define (opt-gep-offset-derived-empty? [derived : OptGepOffsetDerivedList]) : bool
  (match derived
    [(OptGepOffsetDerivedList.Nil) true]
    [(OptGepOffsetDerivedList.Dense _ _) false]))

;; --- entry --------------------------------------------------------------------
(define (opt-gep-offset-blocks-result
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]
  [frame : i64]) : OptGepOffsetPlanResult
  (let
    [uses : (__tl_dyn-array i64) (opt-gep-offset-effective-uses blocks frame)]
    [gep-uses : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [poison : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [base0 : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [multi-base : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [def-block : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [gep-mark : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [gep-base : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [gep-index : (__tl_dyn-array i64) (array.make-array i64 frame)]
    [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [_seed : unit (set! (array-ref cell 0) frame)]
    [_base0 : unit (opt-gep-offset-fill! base0 (- 0 1))]
    [_defs : unit
      (begin
        (opt-gep-offset-fill! def-block (- 0 1))
        (opt-gep-offset-defs-blocks! blocks 0 def-block))]
    [_census : unit
      (opt-gep-offset-census-blocks!
        type-segment-bases
        blocks
        gep-uses
        poison
        base0
        multi-base)]
    [derived : OptGepOffsetDerivedList
      (opt-gep-offset-plan-loops
        type-segment-bases
        (opt-cfg-natural-loops-with-context blocks context)
        blocks
        frame
        uses
        gep-uses
        poison
        multi-base
        def-block
        gep-mark
        gep-base
        gep-index
        cell
        (OptGepOffsetDerivedList.Nil))]
    (if (opt-gep-offset-derived-empty? derived)
      (OptGepOffsetPlanResult.Result blocks frame false)
      (OptGepOffsetPlanResult.Result
        (opt-gep-offset-rewrite-blocks
          blocks
          derived
          gep-mark
          gep-base
          gep-index)
        (array-ref cell 0)
        true))))

;; `context` must be valid for `func`'s blocks (its entry verify reuses it).
;; Preheader synthesis is the only step that touches the CFG, so the returned
;; context is rebuilt exactly when it fired.
(define (opt-gep-offset-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [verified? : bool]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  (match (opt-verify-gate verified? func context)
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (match (opt-gep-offset-prepare-preheaders
            type-segment-bases
            blocks
            context
            frame
            (+ 1 (ir.compiler-ir-block-list-count blocks))
            false)
            [(OptGepOffsetPreheaderResult.Result
                staged-blocks
                staged-context
                preheaders-changed?)
              (match (opt-gep-offset-blocks-result
                type-segment-bases
                staged-blocks
                staged-context
                frame)
                [(OptGepOffsetPlanResult.Result next-blocks next-frame changed)
                  (if (not (or changed preheaders-changed?))
                    (OptFunctionCtxResult.Result func context)
                    ;; A preheader synthesized for a loop that then failed a
                    ;; gate would leave a jump-only block behind, so drop the
                    ;; whole staging when nothing split.
                    (if (not changed)
                      (OptFunctionCtxResult.Result func context)
                      (let
                        [next : ir.CompilerIrFunction
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            next-frame
                            next-blocks)]
                        [next-context : OptCfgContext
                          (opt-cfg-context-build next-blocks)]
                        (match (opt-verify-function-with-context
                          next
                          next-context)
                          [(ResultCompilerOptimizeVerify.Ok)
                            (OptFunctionCtxResult.Result next next-context)]
                          [(ResultCompilerOptimizeVerify.Err _)
                            (OptFunctionCtxResult.Result func context)]))))])])])]
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]))

;; Standalone driver for tests and ad-hoc runs: builds its own CFG context and
;; keeps the defensive entry verify.
(define (opt-gep-offset-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-gep-offset-function-with-context-result
    type-segment-bases
    (opt-cfg-context-build (opt-function-blocks func))
    false
    func)
    [(OptFunctionCtxResult.Result next _) next]))

;; --- Gep use-splitting for indexed memory operands --------------------------
;;
;; A Gep result feeding several memory operations (the quicksort swap: `g =
;; Gep a, i; x = Load g; ...; Store g, y`) defeats the backend's single-use
;; Gep+memop fusion, costing a lea per access. When EVERY use of a Gep is a
;; Load/StorePtr address operand and the base/index are single-source (one
;; definition each, so the address is identical at every use the Gep def
;; dominates), clone the Gep per use: each Load/StorePtr gets its own
;; single-use Gep, which the backend then fuses into an indexed memory
;; operand. Non-address uses, non-SIB element scales, and multi-source
;; bases/indices stay untouched. Verifier-gated with fallback like the other
;; whole-function rewrites.
;; One defining instruction per var (instruction destinations only; the
;; caller seeds params): a var with exactly one source has a single,
;; unchanging value wherever its def dominates, so an address derived from it
;; is the same at every use.
(define (opt-gep-split-defs-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [counts : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
        [(option_i64.Some dst)
          (set! (array-ref counts dst) (+ (array-ref counts dst) 1))]
        [(option_i64.None) unit])
      (opt-gep-split-defs-instrs! instrs (+ index 1) counts))))

(define (opt-gep-split-defs-blocks!
  [blocks : ir.CompilerIrBlockList]
  [counts : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-split-defs-instrs! instrs 0 counts)
            (opt-gep-split-defs-blocks! (__tl-box-place rest) counts))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-split-defs-blocks! (ir.compiler-ir-block-seq-to-list seq) counts)]))

(define (opt-gep-split-seed-params!
  [params : ir.CompilerIrParamList]
  [counts : (__tl_dyn-array i64)]) : unit
  (match params
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (begin
            (set! (array-ref counts var) (+ (array-ref counts var) 1))
            (opt-gep-split-seed-params! (__tl-box-place rest) counts))])]
    [(ir.CompilerIrParamList.Array seq)
      (opt-gep-split-seed-params! (ir.compiler-ir-param-seq-to-list seq) counts)]))

;; Memory-address uses only (Load src / StorePtr dst): counted per var so the
;; all-uses-are-addresses test can compare against the total use count. A
;; zero-offset Gep base is also an address-only use: the wrapper is pointer
;; identity, so rewriting it with the wrapped Gep's operands exposes the
;; existing single-Gep memory fusion. chainuses distinguishes that useful
;; single-use case from the multi-use splitting this pass originally owned.
(define (opt-gep-split-memuses-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [memuses : (__tl_dyn-array i64)]
  [chainuses : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Load _ src _)
          (match src
            [(ir.CompilerIrValue.Var v)
              (set! (array-ref memuses v) (+ (array-ref memuses v) 1))]
            [_ unit])]
        [(ir.CompilerIrInstr.StorePtr dst _ _)
          (match dst
            [(ir.CompilerIrValue.Var v)
              (set! (array-ref memuses v) (+ (array-ref memuses v) 1))]
            [_ unit])]
        [(ir.CompilerIrInstr.Gep _ base offset _)
          (match offset
            [(ir.CompilerIrValue.I64 n)
              (if (= n 0)
                (match base
                  [(ir.CompilerIrValue.Var v)
                    (begin
                      (set! (array-ref memuses v) (+ (array-ref memuses v) 1))
                      (set!
                        (array-ref chainuses v)
                        (+ (array-ref chainuses v) 1)))]
                  [_ unit])
                unit)]
            [_ unit])]
        ;; A Mov of the Gep result is replaced by a fresh Gep, so it counts as
        ;; an address use too (its dst's role does not matter: the fresh Gep
        ;; yields the same address value).
        [(ir.CompilerIrInstr.Mov _ src _)
          (match src
            [(ir.CompilerIrValue.Var v)
              (set! (array-ref memuses v) (+ (array-ref memuses v) 1))]
            [_ unit])]
        [_ unit])
      (opt-gep-split-memuses-instrs! instrs (+ index 1) memuses chainuses))))

(define (opt-gep-split-memuses-blocks!
  [blocks : ir.CompilerIrBlockList]
  [memuses : (__tl_dyn-array i64)]
  [chainuses : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-split-memuses-instrs! instrs 0 memuses chainuses)
            (opt-gep-split-memuses-blocks!
              (__tl-box-place rest)
              memuses
              chainuses))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-split-memuses-blocks!
        (ir.compiler-ir-block-seq-to-list seq)
        memuses
        chainuses)]))

;; Record each SIB-scale Gep def's operands for cloning. marks[dst] = 1 means
;; the parallel arrays hold a splittable Gep for dst.
(define (opt-gep-split-geps-instrs!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [marks : (__tl_dyn-array i64)]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (begin
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Gep dst base offset elem-ty)
          (let
            [scale : i64
              (opt-scratch-alloc-type-size type-segment-bases elem-ty)]
            (if (or (= scale 1) (= scale 2) (= scale 4) (= scale 8))
              (begin
                (set! (array-ref bases dst) base)
                (set! (array-ref offsets dst) offset)
                (set! (array-ref tys dst) elem-ty)
                (set! (array-ref marks dst) 1))
              unit))]
        [_ unit])
      (opt-gep-split-geps-instrs!
        type-segment-bases
        instrs
        (+ index 1)
        bases
        offsets
        tys
        marks))))

(define (opt-gep-split-geps-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [marks : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-gep-split-geps-instrs!
              type-segment-bases
              instrs
              0
              bases
              offsets
              tys
              marks)
            (opt-gep-split-geps-blocks!
              type-segment-bases
              (__tl-box-place rest)
              bases
              offsets
              tys
              marks))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-split-geps-blocks!
        type-segment-bases
        (ir.compiler-ir-block-seq-to-list seq)
        bases
        offsets
        tys
        marks)]))

;; A base/index operand is safe to re-evaluate at every use when it is not the
;; Gep's own dst and has exactly one source (a literal is always fine).
(define (opt-gep-split-source-ok?
  [value : ir.CompilerIrValue]
  [self : i64]
  [defs : (__tl_dyn-array i64)]) : bool
  (match value
    [(ir.CompilerIrValue.Var v) (and (!= v self) (= (array-ref defs v) 1))]
    [_ true]))

(define (opt-gep-split-candidate?
  [v : i64]
  [uses : (__tl_dyn-array i64)]
  [memuses : (__tl_dyn-array i64)]
  [chainuses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [marks : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]) : bool
  (and
    (= (array-ref marks v) 1)
    (or (>= (array-ref uses v) 2) (>= (array-ref chainuses v) 1))
    ;; every use is a memory address (Load src / StorePtr dst): the total use
    ;; count equals the address-use count.
    (= (array-ref uses v) (array-ref memuses v))
    (opt-gep-split-source-ok? (array-ref bases v) v defs)
    (opt-gep-split-source-ok? (array-ref offsets v) v defs)))

;; Compute the final candidate set: splittable Geps with >= 2 uses, or one
;; zero-Gep chain use, all of them memory addresses, with single-source
;; base/index. Fills every entry (no early exit) and returns whether any
;; candidate exists.
(define (opt-gep-split-candidates!
  [cands : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [memuses : (__tl_dyn-array i64)]
  [chainuses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [marks : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]
  [v : i64]
  [found : bool]) : bool
  (if (< v 0)
    found
    (opt-gep-split-candidates!
      cands
      uses
      memuses
      chainuses
      defs
      marks
      bases
      offsets
      (- v 1)
      (if (opt-gep-split-candidate?
        v
        uses
        memuses
        chainuses
        defs
        marks
        bases
        offsets)
        (begin
          (set! (array-ref cands v) 1)
          true)
        found))))

;; One fresh single-use Gep immediately before its Load/StorePtr use.
;; Emit the rewrite of one instruction into the output builder. Expand shape:
;; a candidate `Load`/`StorePtr` emits a fresh `Gep` ahead of the memory op, so
;; the output can be longer than the input. Per #5726's migration shape an
;; insert/expand pass takes a capacity-managed dense builder, not a cons
;; accumulator. The fresh-var allocator `cell` is consumed in exactly the order
;; the old recursion consumed it: that code allocated for instruction `i`
;; before recursing on `i + 1`, and this loop pushes for `i` before advancing.
(define (opt-gep-split-push-instr!
  [instr : ir.CompilerIrInstr]
  [cands : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [cell : (__tl_dyn-array i64)]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (match base
        [(ir.CompilerIrValue.Var v)
          (match offset
            [(ir.CompilerIrValue.I64 n)
              (if (and (= n 0) (= (array-ref cands v) 1))
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Gep
                    dst
                    (array-ref bases v)
                    (array-ref offsets v)
                    (array-ref tys v)))
                (ir.compiler-ir-instr-builder-push! (&mut builder) instr))]
            [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])]
        [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])]
    [(ir.CompilerIrInstr.Load dst src ty)
      (match src
        [(ir.CompilerIrValue.Var v)
          (if (= (array-ref cands v) 1)
            (let
              [fresh : i64 (opt-bce-version-alloc-var cell)]
              (begin
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Gep
                    fresh
                    (array-ref bases v)
                    (array-ref offsets v)
                    (array-ref tys v)))
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Load
                    dst
                    (ir.CompilerIrValue.Var fresh)
                    ty))))
            (ir.compiler-ir-instr-builder-push! (&mut builder) instr))]
        [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])]
    [(ir.CompilerIrInstr.StorePtr dst value ty)
      (match dst
        [(ir.CompilerIrValue.Var v)
          (if (= (array-ref cands v) 1)
            (let
              [fresh : i64 (opt-bce-version-alloc-var cell)]
              (begin
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Gep
                    fresh
                    (array-ref bases v)
                    (array-ref offsets v)
                    (array-ref tys v)))
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.StorePtr
                    (ir.CompilerIrValue.Var fresh)
                    value
                    ty))))
            (ir.compiler-ir-instr-builder-push! (&mut builder) instr))]
        [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])]
    [(ir.CompilerIrInstr.Mov dst src mov-ty)
      ;; `dst = Mov gep` becomes `dst = Gep base, offset`: the copy was
      ;; just staging the address, so the fresh single-use Gep feeds the
      ;; backend's indexed fusion directly.
      (match src
        [(ir.CompilerIrValue.Var v)
          (if (= (array-ref cands v) 1)
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Gep
                dst
                (array-ref bases v)
                (array-ref offsets v)
                (array-ref tys v)))
            (ir.compiler-ir-instr-builder-push! (&mut builder) instr))]
        [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])]
    [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)]))

(define (opt-gep-split-rewrite-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [cands : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [cell : (__tl_dyn-array i64)]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (opt-gep-split-push-instr!
            (ir.compiler-ir-instr-seq-ref instrs index)
            cands
            bases
            offsets
            tys
            cell
            (&mut builder))
          (set! index (+ index 1))))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-gep-split-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [cands : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array ir.CompilerIrValue)]
  [offsets : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [cell : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-gep-split-rewrite-instr-seq
                instrs
                cands
                bases
                offsets
                tys
                cell))
            (opt-gep-split-rewrite-blocks
              (__tl-box-place rest)
              cands
              bases
              offsets
              tys
              cell))])]
    ;; The array arm used to materialise a whole block cons chain purely to
    ;; walk it once (refs #5729); it now scans the sequence in place and
    ;; writes a dense output sequence. Same forward order, so `cell` hands out
    ;; the same fresh var ids in the same places.
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq index)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    (array-ref slots index)
                    (ir.CompilerIrBlock.Block
                      label
                      (opt-gep-split-rewrite-instr-seq
                        instrs
                        cands
                        bases
                        offsets
                        tys
                        cell)))])
              (set! index (+ index 1))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count))))]))

(define (opt-gep-split-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (opt-gep-split-function-inner type-segment-bases func))

(define (opt-gep-split-function-inner
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [uses : (__tl_dyn-array i64)
          (opt-collect-blocks-uses-array frame blocks)]
        [memuses : (__tl_dyn-array i64) (array.make-array i64 frame)]
        [chainuses : (__tl_dyn-array i64) (array.make-array i64 frame)]
        [defs : (__tl_dyn-array i64) (array.make-array i64 frame)]
        [bases : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [offsets : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue frame)]
        [tys : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType frame)]
        [marks : (__tl_dyn-array i64) (array.make-array i64 frame)]
        [cands : (__tl_dyn-array i64) (array.make-array i64 frame)]
        [_uses : unit (opt-gep-split-memuses-blocks! blocks memuses chainuses)]
        [_defs : unit
          (begin
            (opt-gep-split-seed-params! params defs)
            (opt-gep-split-defs-blocks! blocks defs))]
        [_geps : unit
          (opt-gep-split-geps-blocks!
            type-segment-bases
            blocks
            bases
            offsets
            tys
            marks)]
        [any? : bool
          (opt-gep-split-candidates!
            cands
            uses
            memuses
            chainuses
            defs
            marks
            bases
            offsets
            (- frame 1)
            false)]
        (if (not any?)
          func
          (let
            [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
            [_cell : unit (set! (array-ref cell 0) frame)]
            [next-blocks : ir.CompilerIrBlockList
              (opt-gep-split-rewrite-blocks blocks cands bases offsets tys cell)]
            [next : ir.CompilerIrFunction
              (ir.CompilerIrFunction.Function
                name
                params
                ret-ty
                (array-ref cell 0)
                next-blocks)]
            (match (opt-verify-function next)
              [(ResultCompilerOptimizeVerify.Ok) next]
              [(ResultCompilerOptimizeVerify.Err _) func]))))]))

;; Sink a compare whose only block-local use is the block's final Branch to
;; the instruction right before that Branch. The backend fuses a
;; compare+branch pair (cmp;jcc) only when they are adjacent, and a
;; loop-closing compare is often separated from its branch by a flag-safe
;; pointer-increment Gep (the counted-fill shape), forcing the
;; setl/movzbq/test/jne materialization instead. The move is pure scheduling:
;; it fires only when no intervening instruction reads the compare's result
;; or redefines its operands.
;;
;; Scan backward from the branch for the cond var's definition. Returns the
;; defining compare's index, or -1 if a use of the cond var or a non-compare
;; definition comes first.
(define (opt-cmp-sink-find-compare
  [instrs : ir.CompilerIrInstrSeq]
  [cond-var : i64]
  [index : i64]) : i64
  (if (< index 0)
    (- 0 1)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
          (if (= dst cond-var)
            (if (opt-bool-branch-compare-op? op)
              index
              (- 0 1))
            (if (or
              (opt-value-is-var? lhs cond-var)
              (opt-value-is-var? rhs cond-var))
              (- 0 1)
              (opt-cmp-sink-find-compare instrs cond-var (- index 1))))]
        [_
          (if (or
            (= (opt-gvn-instr-dst instr) cond-var)
            (opt-cmp-sink-instr-uses-var? instr cond-var))
            (- 0 1)
            (opt-cmp-sink-find-compare instrs cond-var (- index 1)))]))))

;; Conservative operand-position use check for the instructions that can sit
;; between a loop-closing compare and its branch (Mov/Gep/Load/Cast/Bitcast/
;; UnOp/BinOp and other non-terminators). Unknown kinds count as using the var.
(define (opt-cmp-sink-instr-uses-var? [instr : ir.CompilerIrInstr] [var : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (or (opt-value-is-var? base var) (opt-value-is-var? offset var))]
    [(ir.CompilerIrInstr.Load _ src _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.Cast _ src _ _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.UnOp _ _ src _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (or (opt-value-is-var? lhs var) (opt-value-is-var? rhs var))]
    [_ true]))

;; Every instruction strictly between `def-index` and the block's final
;; Branch must leave the compare's operands (and its result) untouched.
(define (opt-cmp-sink-clear?
  [instrs : ir.CompilerIrInstrSeq]
  [def-index : i64]
  [last : i64]
  [cond-var : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : bool
  (if (>= def-index last)
    true
    (let
      [instr : ir.CompilerIrInstr
        (ir.compiler-ir-instr-seq-ref instrs def-index)]
      [dst : i64 (opt-gvn-instr-dst instr)]
      (if (or
        (= dst cond-var)
        (opt-value-is-var? lhs dst)
        (opt-value-is-var? rhs dst))
        false
        (opt-cmp-sink-clear? instrs (+ def-index 1) last cond-var lhs rhs)))))

(define (opt-cmp-sink-move-onto
  [instrs : ir.CompilerIrInstrSeq]
  [def-index : i64]
  [index : i64]
  [out : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (if (< index 0)
    out
    (opt-cmp-sink-move-onto
      instrs
      def-index
      (- index 1)
      (if (= index def-index)
        out
        (ir.compiler-ir-instr-cons
          (ir.compiler-ir-instr-seq-ref instrs index)
          out)))))

(define (opt-cmp-sink-block-pass [block : ir.CompilerIrBlock]) : OptBlockPassResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 3)
          (OptBlockPassResult.Result block false)
          (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
            [(ir.CompilerIrInstr.Branch (ir.CompilerIrValue.Var cond-var) _ _)
              (let
                [def-index : i64
                  (opt-cmp-sink-find-compare instrs cond-var (- count 2))]
                (if (or (< def-index 0) (= def-index (- count 2)))
                  (OptBlockPassResult.Result block false)
                  (match (ir.compiler-ir-instr-seq-ref instrs def-index)
                    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
                      (if (opt-cmp-sink-clear?
                        instrs
                        (+ def-index 1)
                        (- count 1)
                        cond-var
                        lhs
                        rhs)
                        (OptBlockPassResult.Result
                          (ir.compiler-ir-block
                            label
                            (opt-cmp-sink-move-onto
                              instrs
                              def-index
                              (- count 2)
                              (ir.compiler-ir-instr-cons
                                (ir.compiler-ir-instr-seq-ref instrs def-index)
                                (ir.compiler-ir-instr-cons
                                  (ir.compiler-ir-instr-seq-ref
                                    instrs
                                    (- count 1))
                                  ir.CompilerIrInstrList.Nil))))
                          true)
                        (OptBlockPassResult.Result block false))]
                    [_ (OptBlockPassResult.Result block false)])))]
            [_ (OptBlockPassResult.Result block false)])))]))

(define (opt-cmp-sink-blocks-pass [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-cmp-sink-block-pass block)
        [(OptBlockPassResult.Result next-block block-changed)
          (match (opt-cmp-sink-blocks-pass (__tl-box-place rest))
            [(OptBlockListPassResult.Result next-rest rest-changed)
              (if (or block-changed rest-changed)
                (OptBlockListPassResult.Result
                  (ir.compiler-ir-block-cons next-block next-rest)
                  true)
                (OptBlockListPassResult.Result blocks false))])])]
    [(ir.CompilerIrBlockList.Array seq)
      (match (opt-cmp-sink-blocks-pass (ir.compiler-ir-block-seq-to-list seq))
        [(OptBlockListPassResult.Result next changed)
          (if changed
            (OptBlockListPassResult.Result next true)
            (OptBlockListPassResult.Result blocks false))])]))

(define (opt-cmp-sink-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (opt-cmp-sink-blocks-pass blocks)
    [(OptBlockListPassResult.Result next _) next]))

;; --- single-use load sinking -----------------------------------------------
;;
;; Sink a single-use `gep; load` pair down to the slot immediately before its
;; unique consumer in the same block. The backend folds a fused `gep; load`
;; straight into the consuming ALU op's memory operand -- `movq (b,i,8), %t;
;; andq %t, %acc` becomes `andq (b,i,8), %acc`, one instruction and one
;; register shorter -- but every probe in that family reads the instruction at
;; `load index + 1`: the fold requires ADJACENCY, and source evaluation order
;; does not supply it. `(bit-or (ln-ref uses k) (bit-and (ln-ref scratch-out i)
;; (bit-xor (ln-ref defs k) -1)))` -- benchmarks/liveness_scan's flagship loop,
;; 11.8M iterations -- lowers its three element reads first and its three ALU
;; ops after, so the `and`'s load sits four slots back and the `or`'s eight.
;; Only the innermost `xor` is adjacent, and only the `xor` folds; the loop
;; pays ten instructions where eight would do.
;;
;; The move is pure scheduling. It fires when the load's dst and the gep's dst
;; are each single-use across the whole function, the unique use is a BinOp
;; later in the SAME block, nothing between the load and that BinOp writes
;; memory or calls, and nothing between them redefines the gep's base or index
;; (SSA already forbids the last one; the check is belt and braces). Pairs are
;; planned bottom-up and flushed at their consumer in ascending original order,
;; so a chain of loads feeding a chain of ALU ops cascades -- each load lands
;; next to ITS consumer -- while a pair that was already in place, including
;; the `gep; load; gep; load; binop` shape the two-operand fold wants, keeps
;; its exact position and the block is returned untouched.
;;
;; ORDERING SAFETY. Two motions happen here and both are sound:
;;
;;   * A load passes another load. Reads commute; neither has an effect.
;;
;;   * A load moves LATER past a non-memory instruction. The only thing in
;;     that window that can do anything observable is one that ABORTS -- a
;;     BoundsCheck, or a checked divide. Moving a load from before an abort
;;     point to after it means that, on the aborting path, the load no longer
;;     runs. A load has no observable effect and its result is dead on that
;;     path, so the two programs produce identical output and identical exit
;;     status. The unsound direction is the mirror image (a load hoisted ABOVE
;;     its guard can fault); this pass never moves a load earlier, and a
;;     load's own guarding check already dominates it, so that check is never
;;     inside the window. Anything that writes memory -- Store, StorePtr,
;;     CopyBytes, the vector stores -- or that can write memory indirectly --
;;     any call form -- is a hard barrier, as is any shape not on the
;;     crossable list below.
;; Instructions a sunk load may cross: pure value producers plus BoundsCheck,
;; which only aborts (see the ORDERING SAFETY note). Everything else, memory
;; writers and calls included, is a barrier.
(define (opt-load-sink-crossable? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [_ false]))

;; Operand-position use test over exactly the shapes `opt-load-sink-crossable?`
;; admits; anything else is a barrier and never reaches here, so the catch-all
;; answers conservatively.
(define (opt-load-sink-instr-uses-var? [instr : ir.CompilerIrInstr] [var : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (or (opt-value-is-var? base var) (opt-value-is-var? offset var))]
    [(ir.CompilerIrInstr.Load _ src _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (or (opt-value-is-var? lhs var) (opt-value-is-var? rhs var))]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (or (opt-value-is-var? index var) (opt-value-is-var? length var))]
    [(ir.CompilerIrInstr.Mov _ src _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.UnOp _ _ src _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.Cast _ src _ _) (opt-value-is-var? src var)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _) (opt-value-is-var? src var)]
    [_ true]))

(define (opt-load-sink-single-use?
  [use-counts : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length use-counts))
      false
      (= (array-ref use-counts var) 1))))

;; Index of the BinOp that consumes `load-dst`, or -1 when the pair may not
;; sink. `load-dst` is single-use by the caller's test, so the first crossable
;; instruction that reads it IS the unique consumer: either it is a BinOp
;; reading it as an operand (the fold's shape) or the pair stays put.
(define (opt-load-sink-find-consumer
  [instrs : ir.CompilerIrInstrSeq]
  [start : i64]
  [count : i64]
  [load-dst : i64]
  [base : ir.CompilerIrValue]
  [offset : ir.CompilerIrValue]) : i64
  (let
    [index : i64 start]
    [answer : i64 (- 0 1)]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs index)]
          (if (not (opt-load-sink-crossable? instr))
            (set! done true)
            (if (opt-load-sink-instr-uses-var? instr load-dst)
              (begin
                (match instr
                  [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
                    (if (or
                      (opt-value-is-var? lhs load-dst)
                      (opt-value-is-var? rhs load-dst))
                      (set! answer index)
                      unit)]
                  [_ unit])
                (set! done true))
              (let
                [dst : i64 (opt-gvn-instr-dst instr)]
                (if (or
                  (opt-value-is-var? base dst)
                  (opt-value-is-var? offset dst))
                  (set! done true)
                  (set! index (+ index 1))))))))
      answer)))

;; The sink target for the `gep; load` pair ending at `index`, or -1 when the
;; pair does not qualify. Both dsts must be single-use: the gep's because the
;; pair moves as a unit, the load's because the fold consumes the value.
(define (opt-load-sink-pair-target
  [use-counts : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]) : i64
  (match (array-ref slots index)
    [(ir.CompilerIrInstr.Load load-dst (ir.CompilerIrValue.Var gep-dst) _)
      (match (array-ref slots (- index 1))
        [(ir.CompilerIrInstr.Gep gep base offset _)
          (if (and
            (= gep gep-dst)
            (opt-load-sink-single-use? use-counts gep-dst)
            (opt-load-sink-single-use? use-counts load-dst))
            (opt-load-sink-find-consumer
              instrs
              (+ index 1)
              count
              load-dst
              base
              offset)
            (- 0 1))]
        [_ (- 0 1)])]
    [_ (- 0 1)]))

;; Cheap first look: is there a qualifying pair whose consumer is not already
;; the next instruction? Only then does the block pay for the plan arrays. A
;; pair that is merely part of an already-contiguous run still answers yes
;; here; the plan below then reproduces the original order exactly and the
;; block is returned untouched.
(define (opt-load-sink-block-moves?
  [use-counts : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [count : i64]) : bool
  (let
    [index : i64 1]
    [found : bool false]
    (begin
      (while (and (not found) (< index (- count 1)))
        (begin
          (if (>
            (opt-load-sink-pair-target use-counts instrs slots index count)
            (+ index 1))
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (opt-load-sink-reorder
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [order : (__tl_dyn-array i64)]
  [count : i64]) : ir.CompilerIrInstrSeq
  (let
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set! (array-ref out index) (array-ref slots (array-ref order index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

;; `head`/`link` are zero-initialised, so both encodings bias by one to keep
;; zero meaning "absent": `head[target] = first + 1` names the first pair
;; instruction flushed at `target`, and `link[i] = next + 2` names the pair
;; instruction after `i` in that chain (1 = end of chain, 0 = `i` does not
;; move). Planning walks BOTTOM-UP and pushes each pair onto the front of its
;; consumer's chain, so the chain comes out in ascending original order and a
;; run of pairs that already sits against its consumer is reproduced verbatim.
(define (opt-load-sink-block
  [use-counts : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : OptBlockPassResult
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 instrs.len]
        [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
        (if (or
          (< count 4)
          (not (opt-load-sink-block-moves? use-counts instrs slots count)))
          (OptBlockPassResult.Result block false)
          (let
            [head : (__tl_dyn-array i64) (array.make-array i64 count)]
            [link : (__tl_dyn-array i64) (array.make-array i64 count)]
            [order : (__tl_dyn-array i64) (array.make-array i64 count)]
            [index : i64 (- count 2)]
            [write : i64 0]
            [changed : bool false]
            (begin
              (while (>= index 1)
                (begin
                  (let
                    [target : i64
                      (opt-load-sink-pair-target
                        use-counts
                        instrs
                        slots
                        index
                        count)]
                    (if (>= target 0)
                      (begin
                        (set!
                          (array-ref link index)
                          (+ (array-ref head target) 1))
                        (set! (array-ref head target) (+ index 1))
                        (set!
                          (array-ref link (- index 1))
                          (+ (array-ref head target) 1))
                        (set! (array-ref head target) index))
                      unit))
                  (set! index (- index 1))))
              (set! index 0)
              (while (< index count)
                (begin
                  (if (= (array-ref link index) 0)
                    (let
                      [cursor : i64 (- (array-ref head index) 1)]
                      (begin
                        (while (>= cursor 0)
                          (begin
                            (set! (array-ref order write) cursor)
                            (if (!= cursor write)
                              (set! changed true)
                              unit)
                            (set! write (+ write 1))
                            (set! cursor (- (array-ref link cursor) 2))))
                        (set! (array-ref order write) index)
                        (if (!= index write)
                          (set! changed true)
                          unit)
                        (set! write (+ write 1))))
                    unit)
                  (set! index (+ index 1))))
              (if changed
                (OptBlockPassResult.Result
                  (ir.CompilerIrBlock.Block
                    label
                    (opt-load-sink-reorder slots order count))
                  true)
                (OptBlockPassResult.Result block false))))))]))

(define (opt-load-sink-blocks-pass
  [use-counts : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptBlockListPassResult.Result blocks false)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (opt-load-sink-block use-counts block)
        [(OptBlockPassResult.Result next-block block-changed)
          (match (opt-load-sink-blocks-pass use-counts (__tl-box-place rest))
            [(OptBlockListPassResult.Result next-rest rest-changed)
              (if (or block-changed rest-changed)
                (OptBlockListPassResult.Result
                  (ir.compiler-ir-block-cons next-block next-rest)
                  true)
                (OptBlockListPassResult.Result blocks false))])])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 seq.len]
        [source : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
        [out : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [index : i64 0]
        [changed : bool false]
        (begin
          (while (< index count)
            (begin
              (match (opt-load-sink-block use-counts (array-ref source index))
                [(OptBlockPassResult.Result next-block block-changed)
                  (begin
                    (set! (array-ref out index) next-block)
                    (if block-changed
                      (set! changed true)
                      unit))])
              (set! index (+ index 1))))
          (if changed
            (OptBlockListPassResult.Result
              (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq out count))
              true)
            (OptBlockListPassResult.Result blocks false))))]))

;; Structural pre-gate, cheaper than the use-count table the plan needs: a
;; `gep; load` pair whose NEXT instruction is crossable and does not consume
;; the load. Every pair that can actually move satisfies this (its consumer is
;; at least two slots away, so the slot between is in the crossable window and
;; is not the use), so the gate has no false negatives; it merely spares the
;; overwhelming majority of functions the whole-function use tally.
(define (opt-load-sink-block-wants-pass? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 instrs.len]
        [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
        [index : i64 1]
        [found : bool false]
        (begin
          (while (and (not found) (< index (- count 1)))
            (begin
              (match (array-ref slots index)
                [(ir.CompilerIrInstr.Load
                    load-dst
                    (ir.CompilerIrValue.Var gep-dst)
                    _)
                  (match (array-ref slots (- index 1))
                    [(ir.CompilerIrInstr.Gep gep _ _ _)
                      (if (= gep gep-dst)
                        (let
                          [next : ir.CompilerIrInstr
                            (array-ref slots (+ index 1))]
                          (if (and
                            (opt-load-sink-crossable? next)
                            (not (opt-load-sink-instr-uses-var? next load-dst)))
                            (set! found true)
                            unit))
                        unit)]
                    [_ unit])]
                [_ unit])
              (set! index (+ index 1))))
          found))]))

(define (opt-load-sink-blocks-want-pass? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-load-sink-block-wants-pass? block)
        true
        (opt-load-sink-blocks-want-pass? (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
        [index : i64 0]
        [found : bool false]
        (begin
          (while (and (not found) (< index count))
            (begin
              (if (opt-load-sink-block-wants-pass? (array-ref slots index))
                (set! found true)
                unit)
              (set! index (+ index 1))))
          found))]))

(define (opt-load-sink-blocks [frame : i64] [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (not (opt-load-sink-blocks-want-pass? blocks))
    blocks
    (match (opt-load-sink-blocks-pass
      (opt-collect-blocks-uses-array frame blocks)
      blocks)
      [(OptBlockListPassResult.Result next _) next])))

;; --- late compare duplication ----------------------------------------------
;;
;; GVN unifies textually identical comparisons, so one compare can end up
;; feeding several conditional branches. The backend then materialises that
;; boolean instead of fusing it, because its fusion gate is not "single use"
;; but "every use is free": a compare folds into `cmp`/`jcc` only when the
;; condition var's total use count equals its count of branch uses whose
;; IMMEDIATELY PRECEDING instruction is a compare defining that var
;; (`compiler-backend-var-fuse-safe?` over the tally
;; `compiler-backend-fuse-free-branch-var` builds). A branch reading the same
;; boolean from another block is not such a use, so BOTH sites lose fusion and
;; the pair costs `cmp`/`setcc`/`movzbq`/`test`/`jcc` plus `test`/`jcc` -- seven
;; instructions where two fused pairs would spend four.
;;
;; Give each branch its own copy of the compare and every site fuses again.
;; This is the measured cure for three separately recorded regressions of the
;; same family: an inlined accessor's guard merging with its caller's loop test,
;; a bit-test head compare losing single-use status, and a late-rotation guard
;; clone CSE'ing with the versioning guard.
;;
;; Placement is the whole design. The pass must run BELOW every CSE/GVN round
;; or the copies are folded straight back together -- the same interlock that
;; forced loop rotation below `global_gvn`. It therefore sits at the very bottom
;; of the pipeline, next to the `dce` that retires an original whose every
;; reader took a copy.
;;
;; Only compares whose uses are ALL branch conditions duplicate. With any other
;; reader (a stored bool, a phi input, arithmetic on the bool) the boolean is
;; materialised regardless, so a copy merely trades the site's `test` for a
;; `cmp` -- instruction-count neutral, and it lengthens both operand live
;; ranges. Phi inputs are never rewritten: only branch conditions are.
;; The condition var of a conditional branch, or -1. `TotalEnumBranch` is the
;; same shape to the backend (`compiler-ir-instr-scalar-fact` maps it onto
;; `Branch`) and fuses through the same path.
(define (opt-cmp-dup-branch-cond [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Branch cond _ _)
      (match cond
        [(ir.CompilerIrValue.Var v) v]
        [_ (- 0 1)])]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (match cond
        [(ir.CompilerIrValue.Var v) v]
        [_ (- 0 1)])]
    [_ (- 0 1)]))

;; The branch at `index` already owns its compare: the instruction right before
;; it defines the condition with a comparison. This is exactly the adjacency the
;; backend counts as a free branch use, so such a site needs no copy.
(define (opt-cmp-dup-fused-here?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [cond-var : i64]) : bool
  (if (<= index 0)
    false
    (match (ir.compiler-ir-instr-seq-ref instrs (- index 1))
      [(ir.CompilerIrInstr.BinOp dst op _ _ _)
        (and (= dst cond-var) (opt-bool-branch-compare-op? op))]
      [_ false])))

;; Cheap allocation-free prefilter: unless some branch reads a condition it did
;; not just compute, no copy can help and the frame-sized analysis below is pure
;; overhead.
(define (opt-cmp-dup-seq-wants-pass? [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (let
          [v : i64
            (opt-cmp-dup-branch-cond
              (ir.compiler-ir-instr-seq-ref instrs index))]
          (begin
            (if (and (>= v 0) (not (opt-cmp-dup-fused-here? instrs index v)))
              (set! found true)
              unit)
            (set! index (+ index 1)))))
      found)))

(define (opt-cmp-dup-blocks-want-pass? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-cmp-dup-seq-wants-pass? instrs)
            (opt-cmp-dup-blocks-want-pass? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [index : i64 0]
        [found : bool false]
        (begin
          (while (and (< index count) (not found))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq index)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (if (opt-cmp-dup-seq-wants-pass? instrs)
                    (set! found true)
                    unit)])
              (set! index (+ index 1))))
          found))]))

;; One walk fills every array the candidate test reads: definition counts, the
;; comparison recipe behind each var, branch-use counts, and how many of those
;; branch uses are not already fused.
(define (opt-cmp-dup-scan-instrs!
  [instrs : ir.CompilerIrInstrSeq]
  [defs : (__tl_dyn-array i64)]
  [branch-uses : (__tl_dyn-array i64)]
  [loose : (__tl_dyn-array i64)]
  [marks : (__tl_dyn-array i64)]
  [ops : (__tl_dyn-array ir.CompilerIrBinOp)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]) : unit
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [frame : i64 (array-length defs)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs index)]
          [cond-var : i64 (opt-cmp-dup-branch-cond instr)]
          (begin
            (match (opt-instr-def-var instr)
              [(option_i64.Some dst)
                (if (and (>= dst 0) (< dst frame))
                  (set! (array-ref defs dst) (+ (array-ref defs dst) 1))
                  unit)]
              [(option_i64.None) unit])
            (match instr
              [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
                (if (and
                  (>= dst 0)
                  (< dst frame)
                  (opt-bool-branch-compare-op? op)
                  ;; Float compares never fuse in the backend, so a copy of one
                  ;; is pure cost.
                  (not (opt-float-type? ty)))
                  (begin
                    (set! (array-ref marks dst) 1)
                    (set! (array-ref ops dst) op)
                    (set! (array-ref lhss dst) lhs)
                    (set! (array-ref rhss dst) rhs)
                    (set! (array-ref tys dst) ty))
                  unit)]
              [_ unit])
            (if (and (>= cond-var 0) (< cond-var frame))
              (begin
                (set!
                  (array-ref branch-uses cond-var)
                  (+ (array-ref branch-uses cond-var) 1))
                (if (opt-cmp-dup-fused-here? instrs index cond-var)
                  unit
                  (set!
                    (array-ref loose cond-var)
                    (+ (array-ref loose cond-var) 1))))
              unit)
            (set! index (+ index 1)))))
      unit)))

(define (opt-cmp-dup-scan-blocks!
  [blocks : ir.CompilerIrBlockList]
  [defs : (__tl_dyn-array i64)]
  [branch-uses : (__tl_dyn-array i64)]
  [loose : (__tl_dyn-array i64)]
  [marks : (__tl_dyn-array i64)]
  [ops : (__tl_dyn-array ir.CompilerIrBinOp)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-cmp-dup-scan-instrs!
              instrs
              defs
              branch-uses
              loose
              marks
              ops
              lhss
              rhss
              tys)
            (opt-cmp-dup-scan-blocks!
              (__tl-box-place rest)
              defs
              branch-uses
              loose
              marks
              ops
              lhss
              rhss
              tys))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq index)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (opt-cmp-dup-scan-instrs!
                    instrs
                    defs
                    branch-uses
                    loose
                    marks
                    ops
                    lhss
                    rhss
                    tys)])
              (set! index (+ index 1))))
          unit))]))

;; An operand is safe to re-evaluate at the copy when its value is the same
;; there. Literals and code addresses always are; a variable is when it has one
;; single definition (SSA then puts that definition above every use of the
;; boolean, so it also dominates the copy). `Global`/`RuntimeGlobal` are
;; implicit mutable reads, so a second evaluation may see a different value.
(define (opt-cmp-dup-operand-ok?
  [value : ir.CompilerIrValue]
  [self : i64]
  [defs : (__tl_dyn-array i64)]) : bool
  (match value
    [(ir.CompilerIrValue.Global _) false]
    [(ir.CompilerIrValue.RuntimeGlobal _) false]
    [(ir.CompilerIrValue.Var v)
      (and
        (!= v self)
        (>= v 0)
        (< v (array-length defs))
        (= (array-ref defs v) 1))]
    [_ true]))

(define (opt-cmp-dup-candidate?
  [v : i64]
  [uses : (__tl_dyn-array i64)]
  [branch-uses : (__tl_dyn-array i64)]
  [loose : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [marks : (__tl_dyn-array i64)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]) : bool
  (and
    (= (array-ref marks v) 1)
    (= (array-ref defs v) 1)
    (>= (array-ref uses v) 2)
    ;; Every reader is a branch condition: only then does the copy retire the
    ;; boolean materialisation instead of just moving work around.
    (= (array-ref uses v) (array-ref branch-uses v))
    ;; At least one of those readers does not already have its own compare.
    (>= (array-ref loose v) 1)
    (opt-cmp-dup-operand-ok? (array-ref lhss v) v defs)
    (opt-cmp-dup-operand-ok? (array-ref rhss v) v defs)))

;; Reduce `marks` to the final candidate set in place and report whether any
;; survived. Budget whole comparison families, never individual branch sites:
;; a partial family leaves the original multi-use boolean materialized, so its
;; copied sites merely trade `test` for `cmp` while extending operand liveness.
(define (opt-cmp-dup-candidates!
  [uses : (__tl_dyn-array i64)]
  [branch-uses : (__tl_dyn-array i64)]
  [loose : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [marks : (__tl_dyn-array i64)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]
  [copies : i64]) : bool
  (let
    [count : i64 (array-length marks)]
    [index : i64 0]
    [remaining : i64 copies]
    [found : bool false]
    (begin
      (while (< index count)
        (begin
          (if (= (array-ref marks index) 1)
            (if (opt-cmp-dup-candidate?
              index
              uses
              branch-uses
              loose
              defs
              marks
              lhss
              rhss)
              (let
                [needed : i64 (array-ref loose index)]
                (if (<= needed remaining)
                  (begin
                    (set! remaining (- remaining needed))
                    (set! found true))
                  (set! (array-ref marks index) 0)))
              (set! (array-ref marks index) 0))
            unit)
          (set! index (+ index 1))))
      found)))

;; A duplicated compare is one extra instruction, so the cap only exists to
;; bound pathological functions; nothing in the corpus approaches it.
(define (opt-cmp-dup-budget) : i64
  64)

(define (opt-cmp-dup-retarget [instr : ir.CompilerIrInstr] [fresh : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Branch _ yes no)
      (ir.CompilerIrInstr.Branch (ir.CompilerIrValue.Var fresh) yes no)]
    [(ir.CompilerIrInstr.TotalEnumBranch _ yes no)
      (ir.CompilerIrInstr.TotalEnumBranch (ir.CompilerIrValue.Var fresh) yes no)]
    [_ instr]))

;; Emit one input instruction, expanding a branch that needs its own compare
;; into `compare; branch`. Adjacency is what the backend's fusion gate reads, so
;; the copy is pushed immediately ahead of its consumer.
(define (opt-cmp-dup-push-instr!
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [cands : (__tl_dyn-array i64)]
  [ops : (__tl_dyn-array ir.CompilerIrBinOp)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [cell : (__tl_dyn-array i64)]
  [budget : (__tl_dyn-array i64)]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (let
    [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
    [cond-var : i64 (opt-cmp-dup-branch-cond instr)]
    (if (and
      (>= cond-var 0)
      (< cond-var (array-length cands))
      (= (array-ref cands cond-var) 1)
      (> (array-ref budget 0) 0)
      (not (opt-cmp-dup-fused-here? instrs index cond-var)))
      (let
        [fresh : i64 (opt-bce-version-alloc-var cell)]
        (begin
          (set! (array-ref budget 0) (- (array-ref budget 0) 1))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.BinOp
              fresh
              (array-ref ops cond-var)
              (array-ref lhss cond-var)
              (array-ref rhss cond-var)
              (array-ref tys cond-var)))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (opt-cmp-dup-retarget instr fresh))))
      (ir.compiler-ir-instr-builder-push! (&mut builder) instr))))

(define (opt-cmp-dup-rewrite-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [cands : (__tl_dyn-array i64)]
  [ops : (__tl_dyn-array ir.CompilerIrBinOp)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [cell : (__tl_dyn-array i64)]
  [budget : (__tl_dyn-array i64)]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (opt-cmp-dup-push-instr!
            instrs
            index
            cands
            ops
            lhss
            rhss
            tys
            cell
            budget
            (&mut builder))
          (set! index (+ index 1))))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-cmp-dup-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [cands : (__tl_dyn-array i64)]
  [ops : (__tl_dyn-array ir.CompilerIrBinOp)]
  [lhss : (__tl_dyn-array ir.CompilerIrValue)]
  [rhss : (__tl_dyn-array ir.CompilerIrValue)]
  [tys : (__tl_dyn-array ast.AstType)]
  [cell : (__tl_dyn-array i64)]
  [budget : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (opt-cmp-dup-rewrite-instr-seq
                instrs
                cands
                ops
                lhss
                rhss
                tys
                cell
                budget))
            (opt-cmp-dup-rewrite-blocks
              (__tl-box-place rest)
              cands
              ops
              lhss
              rhss
              tys
              cell
              budget))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq index)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    (array-ref slots index)
                    (ir.CompilerIrBlock.Block
                      label
                      (opt-cmp-dup-rewrite-instr-seq
                        instrs
                        cands
                        ops
                        lhss
                        rhss
                        tys
                        cell
                        budget)))])
              (set! index (+ index 1))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count))))]))

(define (opt-cmp-dup-function [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (opt-cmp-dup-function-with-budget func (opt-cmp-dup-budget)))

(define (opt-cmp-dup-function-with-budget
  [func : ir.CompilerIrFunction]
  [copies : i64]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (or (<= copies 0) (not (opt-cmp-dup-blocks-want-pass? blocks)))
        func
        (let
          [uses : (__tl_dyn-array i64)
            (opt-collect-blocks-uses-array frame blocks)]
          [defs : (__tl_dyn-array i64) (array.make-array i64 frame)]
          [branch-uses : (__tl_dyn-array i64) (array.make-array i64 frame)]
          [loose : (__tl_dyn-array i64) (array.make-array i64 frame)]
          [marks : (__tl_dyn-array i64) (array.make-array i64 frame)]
          [ops : (__tl_dyn-array ir.CompilerIrBinOp)
            (array.make-array ir.CompilerIrBinOp frame)]
          [lhss : (__tl_dyn-array ir.CompilerIrValue)
            (array.make-array ir.CompilerIrValue frame)]
          [rhss : (__tl_dyn-array ir.CompilerIrValue)
            (array.make-array ir.CompilerIrValue frame)]
          [tys : (__tl_dyn-array ast.AstType)
            (array.make-array ast.AstType frame)]
          ;; Parameters are definitions too, and the most stable operands a
          ;; copied compare can read; the seeding walk is shared with gep-split.
          [_defs : unit
            (begin
              (opt-gep-split-seed-params! params defs)
              (opt-cmp-dup-scan-blocks!
                blocks
                defs
                branch-uses
                loose
                marks
                ops
                lhss
                rhss
                tys))]
          [any? : bool
            (opt-cmp-dup-candidates!
              uses
              branch-uses
              loose
              defs
              marks
              lhss
              rhss
              copies)]
          (if (not any?)
            func
            (let
              [cell : (__tl_dyn-array i64) (array.make-array i64 1)]
              [_cell : unit (set! (array-ref cell 0) frame)]
              [budget : (__tl_dyn-array i64) (array.make-array i64 1)]
              [_budget : unit (set! (array-ref budget 0) copies)]
              [next-blocks : ir.CompilerIrBlockList
                (opt-cmp-dup-rewrite-blocks
                  blocks
                  marks
                  ops
                  lhss
                  rhss
                  tys
                  cell
                  budget)]
              [next : ir.CompilerIrFunction
                (ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  (array-ref cell 0)
                  next-blocks)]
              (match (opt-verify-function next)
                [(ResultCompilerOptimizeVerify.Ok) next]
                [(ResultCompilerOptimizeVerify.Err _) func])))))]))

;; --- single-predecessor successor sinking ----------------------------------
;;
;; Move a pure definition out of a Branch/Switch block when all of its uses
;; occur in one successor and that successor has no other predecessor. The
;; single-predecessor rule guarantees that the move cannot increase execution
;; count and makes dominance straightforward on verified SSA. Scanning the
;; source block backward lets a moved consumer make its own producers eligible
;; in the same pass (the Load -> Pack chain in enum dispatch is the motivating
;; shape).
(defenum OptSuccessorSinkMove
  ;; `removed` marks original source instructions that move with this bundle.
  ;; `origins[i]` is that source index for a moved instruction and -1 for a
  ;; rematerialized clone. Keeping the distinction makes use accounting ignore
  ;; new clone uses when deciding whether another original producer can move.
  (Move i64 (__tl_dyn-array i64) i64 ir.CompilerIrInstrSeq (__tl_dyn-array i64)))

(defenum OptSuccessorSinkMoves
  (Nil)
  (Cons OptSuccessorSinkMove (Box OptSuccessorSinkMoves)))

(defenum OptSuccessorSinkMaybeLabel
  (No)
  (Some i64))

(defenum OptSuccessorSinkPrepared
  (No)
  (Some ir.CompilerIrInstrSeq (__tl_dyn-array i64) (__tl_dyn-array i64)))

(defenum OptSuccessorSinkMaybeInstr
  (No)
  (Some ir.CompilerIrInstr))

(defenum OptSuccessorSinkMaybeRecipe
  (No)
  (Some ir.CompilerIrInstr ir.CompilerIrValue ast.AstType))

(defenum OptSuccessorSinkMaybeInductionShape
  (No)
  (Some i64 i64))

(defstruct OptSuccessorSinkPrepareContext
  (frame i64)
  (target i64)
  (blocks ir.CompilerIrBlockList)
  (instrs ir.CompilerIrInstrSeq)
  (terminator-index i64)
  (defs (__tl_dyn-array i64))
  (all-defs (__tl_dyn-array i64))
  (source-loop-target bool)
  (total-uses (__tl_dyn-array i64))
  (base-allowed (__tl_dyn-array i64))
  (leaf-uses (__tl_dyn-array i64))
  (terminator-live (__tl_dyn-array i64))
  (loop-phi-leaves (__tl_dyn-array i64))
  (covered-uses (__tl_dyn-array i64))
  (planned (__tl_dyn-array i64))
  (visiting (__tl_dyn-array i64))
  (remap (__tl_dyn-array i64))
  (removed (__tl_dyn-array i64))
  (frame-cell (__tl_dyn-array i64))
  (clone-count (__tl_dyn-array i64)))

(define (opt-successor-sink-binop? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Div) false]
    [(ir.CompilerIrBinOp.Mod) false]
    [(ir.CompilerIrBinOp.SafeDiv) false]
    [(ir.CompilerIrBinOp.SafeMod) false]
    ;; Scalar shifts have language-level abort checks for invalid counts.
    [(ir.CompilerIrBinOp.Shl _) false]
    [(ir.CompilerIrBinOp.Shr _) false]
    [_ true]))

;; `Global`/`RuntimeGlobal` operands are implicit mutable reads, not stable
;; scalar values. The listed instruction forms are pure only when their value
;; operands do not introduce one of those hidden reads.
(define (opt-successor-sink-stable-value? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Global _) false]
    [(ir.CompilerIrValue.RuntimeGlobal _) false]
    [_ true]))

(define (opt-successor-sink-stable-values? [values : ir.CompilerIrValueList]) : bool
  (match values
    [(ir.CompilerIrValueList.Nil) true]
    [(ir.CompilerIrValueList.Array seq)
      (opt-successor-sink-stable-values? (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (and
        (opt-successor-sink-stable-value? value)
        (opt-successor-sink-stable-values? (__tl-box-place rest)))]))

(define (opt-successor-sink-load-barrier? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Store _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.SpmdCall _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(ir.CompilerIrInstr.Syscall _ _) true]
    ;; These are stores as well, even though the first-cut scalar rule does not
    ;; otherwise schedule vector instructions.
    [(ir.CompilerIrInstr.VectorStore _) true]
    [(ir.CompilerIrInstr.PredicatedStore _) true]
    [_ false]))

(define (opt-successor-sink-load-clear-to-terminator?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [terminator-index : i64]) : bool
  (if (>= index terminator-index)
    true
    (if (opt-successor-sink-load-barrier?
      (ir.compiler-ir-instr-seq-ref instrs index))
      false
      (opt-successor-sink-load-clear-to-terminator?
        instrs
        (+ index 1)
        terminator-index))))

(define (opt-successor-sink-candidate?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [terminator-index : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _) (opt-successor-sink-stable-value? src)]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (and
        (opt-successor-sink-stable-value? base)
        (opt-successor-sink-stable-value? offset))]
    [(ir.CompilerIrInstr.Load _ src _)
      (and
        (opt-successor-sink-stable-value? src)
        (opt-successor-sink-load-clear-to-terminator?
          instrs
          (+ index 1)
          terminator-index))]
    [(ir.CompilerIrInstr.Cast _ src _ _) (opt-successor-sink-stable-value? src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-successor-sink-stable-value? src)]
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (opt-successor-sink-binop? op)
        (opt-successor-sink-stable-value? lhs)
        (opt-successor-sink-stable-value? rhs))]
    [(ir.CompilerIrInstr.UnOp _ _ src _) (opt-successor-sink-stable-value? src)]
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-successor-sink-stable-values? words)]
    [(ir.CompilerIrInstr.Word _ src _ _) (opt-successor-sink-stable-value? src)]
    [_ false]))

;; Rematerialization is intentionally narrower than ordinary sinking. Loads
;; and even otherwise-pure Mov/Cast forms may hide mutable or non-local facts;
;; address arithmetic is limited to non-trapping Gep/BinOp producers.
(define (opt-successor-sink-remat-candidate? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (and
        (opt-successor-sink-stable-value? base)
        (opt-successor-sink-stable-value? offset))]
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (opt-successor-sink-binop? op)
        (opt-successor-sink-stable-value? lhs)
        (opt-successor-sink-stable-value? rhs))]
    [_ false]))

(define (opt-successor-sink-subst-value
  [frame : i64]
  [remap : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (and (>= var 0) (< var frame) (> (array-ref remap var) 0))
        (ir.CompilerIrValue.Var (- (array-ref remap var) 1))
        value)]
    [_ value]))

(define (opt-successor-sink-subst-values
  [frame : i64]
  [remap : (__tl_dyn-array i64)]
  [values : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (match values
    [(ir.CompilerIrValueList.Nil) ir.CompilerIrValueList.Nil]
    [(ir.CompilerIrValueList.Array seq)
      (opt-successor-sink-subst-values
        frame
        remap
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (ir.compiler-ir-value-cons
        (opt-successor-sink-subst-value frame remap value)
        (opt-successor-sink-subst-values frame remap (__tl-box-place rest)))]))

(define (opt-successor-sink-subst-instr
  [frame : i64]
  [remap : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (ir.CompilerIrInstr.Mov
        dst
        (opt-successor-sink-subst-value frame remap src)
        ty)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        dst
        (opt-successor-sink-subst-value frame remap base)
        (opt-successor-sink-subst-value frame remap offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        dst
        (opt-successor-sink-subst-value frame remap src)
        ty)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        dst
        (opt-successor-sink-subst-value frame remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        dst
        (opt-successor-sink-subst-value frame remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        dst
        op
        (opt-successor-sink-subst-value frame remap lhs)
        (opt-successor-sink-subst-value frame remap rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op src ty)
      (ir.CompilerIrInstr.UnOp
        dst
        op
        (opt-successor-sink-subst-value frame remap src)
        ty)]
    [(ir.CompilerIrInstr.Pack dst words ty)
      (ir.CompilerIrInstr.Pack
        dst
        (opt-successor-sink-subst-values frame remap words)
        ty)]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (ir.CompilerIrInstr.Word
        dst
        (opt-successor-sink-subst-value frame remap src)
        index
        ty)]
    [_ instr]))

(define (opt-successor-sink-remat-clone
  [fresh : i64]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Gep _ base offset ty)
      (ir.CompilerIrInstr.Gep fresh base offset ty)]
    [(ir.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp fresh op lhs rhs ty)]
    [_ instr]))

(define (opt-successor-sink-find-def-in-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : OptSuccessorSinkMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptSuccessorSinkMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match (opt-instr-def-var instr)
        [(option_i64.Some dst)
          (if (= dst var)
            (OptSuccessorSinkMaybeInstr.Some instr)
            (opt-successor-sink-find-def-in-seq instrs (+ index 1) var))]
        [(option_i64.None)
          (opt-successor-sink-find-def-in-seq instrs (+ index 1) var)]))))

(define (opt-successor-sink-find-def
  [blocks : ir.CompilerIrBlockList]
  [var : i64]) : OptSuccessorSinkMaybeInstr
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (OptSuccessorSinkMaybeInstr.No)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (opt-successor-sink-find-def-in-seq instrs 0 var)
            [(OptSuccessorSinkMaybeInstr.Some instr)
              (OptSuccessorSinkMaybeInstr.Some instr)]
            [(OptSuccessorSinkMaybeInstr.No)
              (opt-successor-sink-find-def (__tl-box-place rest) var)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-successor-sink-find-def (ir.compiler-ir-block-seq-to-list seq) var)]))

(define (opt-successor-sink-value-i64
  [blocks : ir.CompilerIrBlockList]
  [value : ir.CompilerIrValue]) : option_i64.Option
  (match value
    [(ir.CompilerIrValue.I64 n) (option_i64.Some n)]
    [(ir.CompilerIrValue.Var var)
      (match (opt-successor-sink-find-def blocks var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(ir.CompilerIrInstr.Mov _ (ir.CompilerIrValue.I64 n) _)
              (option_i64.Some n)]
            [_ (option_i64.None)])]
        [(OptSuccessorSinkMaybeInstr.No) (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-successor-sink-value-zero?
  [blocks : ir.CompilerIrBlockList]
  [value : ir.CompilerIrValue]) : bool
  (match (opt-successor-sink-value-i64 blocks value)
    [(option_i64.Some n) (= n 0)]
    [(option_i64.None)
      (match value
        [(ir.CompilerIrValue.Var var)
          (match (opt-successor-sink-find-def blocks var)
            [(OptSuccessorSinkMaybeInstr.Some instr)
              (match instr
                [(ir.CompilerIrInstr.BinOp _ (ir.CompilerIrBinOp.Mul) lhs rhs _)
                  (or
                    (opt-successor-sink-value-zero? blocks lhs)
                    (opt-successor-sink-value-zero? blocks rhs))]
                [_ false])]
            [(OptSuccessorSinkMaybeInstr.No) false])]
        [_ false])]))

(define (opt-successor-sink-phi-zero-label
  [blocks : ir.CompilerIrBlockList]
  [inputs : ir.CompilerIrPhiInputList]) : OptSuccessorSinkMaybeLabel
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-zero-label
        blocks
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-successor-sink-value-zero? blocks value)
        (OptSuccessorSinkMaybeLabel.Some label)
        (opt-successor-sink-phi-zero-label blocks (__tl-box-place rest)))]))

(define (opt-successor-sink-phi-unit-step-value?
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var input-var)
      (match (opt-successor-sink-find-def blocks input-var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(ir.CompilerIrInstr.BinOp _ (ir.CompilerIrBinOp.Add) lhs rhs _)
              (or
                (and
                  (opt-value-is-var? lhs phi-var)
                  (match (opt-successor-sink-value-i64 blocks rhs)
                    [(option_i64.Some step) (= step 1)]
                    [(option_i64.None) false]))
                (and
                  (opt-value-is-var? rhs phi-var)
                  (match (opt-successor-sink-value-i64 blocks lhs)
                    [(option_i64.Some step) (= step 1)]
                    [(option_i64.None) false])))]
            [_ false])]
        [(OptSuccessorSinkMaybeInstr.No) false])]
    [_ false]))

(define (opt-successor-sink-phi-unit-step-label
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [inputs : ir.CompilerIrPhiInputList]) : OptSuccessorSinkMaybeLabel
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-unit-step-label
        blocks
        phi-var
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (opt-successor-sink-phi-unit-step-value? blocks phi-var value)
        (OptSuccessorSinkMaybeLabel.Some label)
        (opt-successor-sink-phi-unit-step-label
          blocks
          phi-var
          (__tl-box-place rest)))]))

(define (opt-successor-sink-iv-phi-shape
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [inputs : ir.CompilerIrPhiInputList]) : OptSuccessorSinkMaybeInductionShape
  (if (not (= (ir.compiler-ir-phi-input-list-count inputs) 2))
    (OptSuccessorSinkMaybeInductionShape.No)
    (match (opt-successor-sink-phi-zero-label blocks inputs)
      [(OptSuccessorSinkMaybeLabel.No) (OptSuccessorSinkMaybeInductionShape.No)]
      [(OptSuccessorSinkMaybeLabel.Some seed-label)
        (match (opt-successor-sink-phi-unit-step-label blocks phi-var inputs)
          [(OptSuccessorSinkMaybeLabel.No)
            (OptSuccessorSinkMaybeInductionShape.No)]
          [(OptSuccessorSinkMaybeLabel.Some step-label)
            (if (= seed-label step-label)
              (OptSuccessorSinkMaybeInductionShape.No)
              (OptSuccessorSinkMaybeInductionShape.Some seed-label step-label))])])))

(define (opt-successor-sink-pointer-seed-value?
  [blocks : ir.CompilerIrBlockList]
  [expected-base : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var input-var)
      (match (opt-successor-sink-find-def blocks input-var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(ir.CompilerIrInstr.Gep _ base offset _)
              (and
                (opt-value-eq base expected-base)
                (opt-successor-sink-value-zero? blocks offset))]
            [_ false])]
        [(OptSuccessorSinkMaybeInstr.No) false])]
    [_ false]))

(define (opt-successor-sink-pointer-step-value?
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [scale : i64]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var input-var)
      (match (opt-successor-sink-find-def blocks input-var)
        [(OptSuccessorSinkMaybeInstr.Some instr)
          (match instr
            [(ir.CompilerIrInstr.Gep _ base offset _)
              (and
                (opt-value-is-var? base phi-var)
                (match (opt-successor-sink-value-i64 blocks offset)
                  [(option_i64.Some found) (= found scale)]
                  [(option_i64.None) false]))]
            [_ false])]
        [(OptSuccessorSinkMaybeInstr.No) false])]
    [_ false]))

(define (opt-successor-sink-pointer-edge-label
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [base : ir.CompilerIrValue]
  [scale : i64]
  [want-step : bool]
  [inputs : ir.CompilerIrPhiInputList]) : OptSuccessorSinkMaybeLabel
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-pointer-edge-label
        blocks
        phi-var
        base
        scale
        want-step
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (if (if want-step
        (opt-successor-sink-pointer-step-value? blocks phi-var scale value)
        (opt-successor-sink-pointer-seed-value? blocks base value))
        (OptSuccessorSinkMaybeLabel.Some label)
        (opt-successor-sink-pointer-edge-label
          blocks
          phi-var
          base
          scale
          want-step
          (__tl-box-place rest)))]))

(define (opt-successor-sink-pointer-phi-shape
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [base : ir.CompilerIrValue]
  [scale : i64]
  [inputs : ir.CompilerIrPhiInputList]) : OptSuccessorSinkMaybeInductionShape
  (if (not (= (ir.compiler-ir-phi-input-list-count inputs) 2))
    (OptSuccessorSinkMaybeInductionShape.No)
    (match (opt-successor-sink-pointer-edge-label
      blocks
      phi-var
      base
      scale
      false
      inputs)
      [(OptSuccessorSinkMaybeLabel.No) (OptSuccessorSinkMaybeInductionShape.No)]
      [(OptSuccessorSinkMaybeLabel.Some seed-label)
        (match (opt-successor-sink-pointer-edge-label
          blocks
          phi-var
          base
          scale
          true
          inputs)
          [(OptSuccessorSinkMaybeLabel.No)
            (OptSuccessorSinkMaybeInductionShape.No)]
          [(OptSuccessorSinkMaybeLabel.Some step-label)
            (if (= seed-label step-label)
              (OptSuccessorSinkMaybeInductionShape.No)
              (OptSuccessorSinkMaybeInductionShape.Some seed-label step-label))])])))

(define (opt-successor-sink-phi-update-scale
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [inputs : ir.CompilerIrPhiInputList]) : option_i64.Option
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) (option_i64.None)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-update-scale
        blocks
        phi-var
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [found : option_i64.Option
          (match value
            [(ir.CompilerIrValue.Var input-var)
              (match (opt-successor-sink-find-def blocks input-var)
                [(OptSuccessorSinkMaybeInstr.Some instr)
                  (match instr
                    [(ir.CompilerIrInstr.Gep _ base offset _)
                      (if (opt-value-is-var? base phi-var)
                        (opt-successor-sink-value-i64 blocks offset)
                        (option_i64.None))]
                    [_ (option_i64.None)])]
                [(OptSuccessorSinkMaybeInstr.No) (option_i64.None)])]
            [_ (option_i64.None)])]
        (match found
          [(option_i64.Some scale) (option_i64.Some scale)]
          [(option_i64.None)
            (opt-successor-sink-phi-update-scale
              blocks
              phi-var
              (__tl-box-place rest))]))]))

(define (opt-successor-sink-mul-scale-source
  [blocks : ir.CompilerIrBlockList]
  [defs : (__tl_dyn-array i64)]
  [frame : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [scale : i64]) : bool
  (match lhs
    [(ir.CompilerIrValue.Var iv)
      (and
        (>= iv 0)
        (< iv frame)
        (> (array-ref defs iv) 0)
        (match (opt-successor-sink-value-i64 blocks rhs)
          [(option_i64.Some n) (= n scale)]
          [(option_i64.None) false])
        (match (opt-successor-sink-find-def blocks iv)
          [(OptSuccessorSinkMaybeInstr.Some instr)
            (match instr
              [(ir.CompilerIrInstr.Phi _ inputs _)
                (match (opt-successor-sink-iv-phi-shape blocks iv inputs)
                  [(OptSuccessorSinkMaybeInductionShape.Some _ _) true]
                  [(OptSuccessorSinkMaybeInductionShape.No) false])]
              [_ false])]
          [(OptSuccessorSinkMaybeInstr.No) false]))]
    [_ false]))

(define (opt-successor-sink-mul-scale-var
  [blocks : ir.CompilerIrBlockList]
  [defs : (__tl_dyn-array i64)]
  [frame : i64]
  [scale : i64]
  [instr : ir.CompilerIrInstr]) : option_i64.Option
  (match instr
    [(ir.CompilerIrInstr.BinOp _ (ir.CompilerIrBinOp.Mul) lhs rhs _)
      (match lhs
        [(ir.CompilerIrValue.Var iv)
          (if (opt-successor-sink-mul-scale-source
            blocks
            defs
            frame
            lhs
            rhs
            scale)
            (option_i64.Some iv)
            (match rhs
              [(ir.CompilerIrValue.Var other-iv)
                (if (opt-successor-sink-mul-scale-source
                  blocks
                  defs
                  frame
                  rhs
                  lhs
                  scale)
                  (option_i64.Some other-iv)
                  (option_i64.None))]
              [_ (option_i64.None)]))]
        [_
          (match rhs
            [(ir.CompilerIrValue.Var iv)
              (if (opt-successor-sink-mul-scale-source
                blocks
                defs
                frame
                rhs
                lhs
                scale)
                (option_i64.Some iv)
                (option_i64.None))]
            [_ (option_i64.None)])])]
    [_ (option_i64.None)]))

(define (opt-successor-sink-find-scale-mul
  [blocks : ir.CompilerIrBlockList]
  [instrs : ir.CompilerIrInstrSeq]
  [defs : (__tl_dyn-array i64)]
  [frame : i64]
  [scale : i64]
  [index : i64]) : OptSuccessorSinkMaybeInstr
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (OptSuccessorSinkMaybeInstr.No)
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match instr
        [(ir.CompilerIrInstr.BinOp _ (ir.CompilerIrBinOp.Mul) lhs rhs _)
          (if (or
            (opt-successor-sink-mul-scale-source
              blocks
              defs
              frame
              lhs
              rhs
              scale)
            (opt-successor-sink-mul-scale-source
              blocks
              defs
              frame
              rhs
              lhs
              scale))
            (OptSuccessorSinkMaybeInstr.Some instr)
            (opt-successor-sink-find-scale-mul
              blocks
              instrs
              defs
              frame
              scale
              (+ index 1)))]
        [_
          (opt-successor-sink-find-scale-mul
            blocks
            instrs
            defs
            frame
            scale
            (+ index 1))]))))

(define (opt-successor-sink-phi-init-recipe
  [blocks : ir.CompilerIrBlockList]
  [phi-var : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [mul : ir.CompilerIrInstr]) : OptSuccessorSinkMaybeRecipe
  (match inputs
    [(ir.CompilerIrPhiInputList.Nil) (OptSuccessorSinkMaybeRecipe.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-successor-sink-phi-init-recipe
        blocks
        phi-var
        (ir.compiler-ir-phi-input-seq-to-list seq)
        mul)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (match value
        [(ir.CompilerIrValue.Var input-var)
          (match (opt-successor-sink-find-def blocks input-var)
            [(OptSuccessorSinkMaybeInstr.Some instr)
              (match instr
                [(ir.CompilerIrInstr.Gep _ base offset ty)
                  (if (and
                    (not (opt-value-is-var? base phi-var))
                    (opt-successor-sink-value-zero? blocks offset))
                    (OptSuccessorSinkMaybeRecipe.Some mul base ty)
                    (opt-successor-sink-phi-init-recipe
                      blocks
                      phi-var
                      (__tl-box-place rest)
                      mul))]
                [_
                  (opt-successor-sink-phi-init-recipe
                    blocks
                    phi-var
                    (__tl-box-place rest)
                    mul)])]
            [(OptSuccessorSinkMaybeInstr.No)
              (opt-successor-sink-phi-init-recipe
                blocks
                phi-var
                (__tl-box-place rest)
                mul)])]
        [_
          (opt-successor-sink-phi-init-recipe
            blocks
            phi-var
            (__tl-box-place rest)
            mul)])]))

;; Induction strength reduction has already rewritten the original
;; `gep base, (iv * scale)` to a pointer phi by the time this late pass runs.
;; Recover that exact bounded recipe from the phi recurrence plus the retained
;; block-local Mul, so sinking a payload address never keeps the pointer phi
;; live across a dispatch.
(define (opt-successor-sink-induction-recipe
  [context : OptSuccessorSinkPrepareContext]
  [phi-var : i64]
  [producer : ir.CompilerIrInstr]) : OptSuccessorSinkMaybeRecipe
  (match producer
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (match (opt-successor-sink-phi-update-scale context.blocks phi-var inputs)
        [(option_i64.Some scale)
          (match (opt-successor-sink-find-scale-mul
            context.blocks
            context.instrs
            context.defs
            context.frame
            scale
            0)
            [(OptSuccessorSinkMaybeInstr.Some mul)
              (match (opt-successor-sink-phi-init-recipe
                context.blocks
                phi-var
                inputs
                mul)
                [(OptSuccessorSinkMaybeRecipe.Some _ base ptr-ty)
                  (match (opt-successor-sink-mul-scale-var
                    context.blocks
                    context.defs
                    context.frame
                    scale
                    mul)
                    [(option_i64.Some iv)
                      (match (opt-successor-sink-find-def context.blocks iv)
                        [(OptSuccessorSinkMaybeInstr.Some iv-instr)
                          (match iv-instr
                            [(ir.CompilerIrInstr.Phi _ iv-inputs _)
                              (match (opt-successor-sink-iv-phi-shape
                                context.blocks
                                iv
                                iv-inputs)
                                [(OptSuccessorSinkMaybeInductionShape.Some
                                    iv-seed
                                    iv-step)
                                  (match (opt-successor-sink-pointer-phi-shape
                                    context.blocks
                                    phi-var
                                    base
                                    scale
                                    inputs)
                                    [(OptSuccessorSinkMaybeInductionShape.Some
                                        ptr-seed
                                        ptr-step)
                                      (if (and
                                        (= iv-seed ptr-seed)
                                        (= iv-step ptr-step))
                                        (OptSuccessorSinkMaybeRecipe.Some
                                          mul
                                          base
                                          ptr-ty)
                                        (OptSuccessorSinkMaybeRecipe.No))]
                                    [(OptSuccessorSinkMaybeInductionShape.No)
                                      (OptSuccessorSinkMaybeRecipe.No)])]
                                [(OptSuccessorSinkMaybeInductionShape.No)
                                  (OptSuccessorSinkMaybeRecipe.No)])]
                            [_ (OptSuccessorSinkMaybeRecipe.No)])]
                        [(OptSuccessorSinkMaybeInstr.No)
                          (OptSuccessorSinkMaybeRecipe.No)])]
                    [(option_i64.None) (OptSuccessorSinkMaybeRecipe.No)])]
                [(OptSuccessorSinkMaybeRecipe.No)
                  (OptSuccessorSinkMaybeRecipe.No)])]
            [(OptSuccessorSinkMaybeInstr.No) (OptSuccessorSinkMaybeRecipe.No)])]
        [(option_i64.None) (OptSuccessorSinkMaybeRecipe.No)])]
    [_ (OptSuccessorSinkMaybeRecipe.No)]))

(define (opt-successor-sink-leading-phi-end
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    index
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ _)
        (opt-successor-sink-leading-phi-end instrs (+ index 1))]
      [_ index])))

;; Phi operands are edge uses, so they deliberately are not counted as uses in
;; the successor. The insertion point is immediately after this leading prefix.
(define (opt-successor-sink-collect-successor-uses!
  [cfg : OptCfgIndex]
  [target : i64]
  [uses : (__tl_dyn-array i64)]) : unit
  (match (opt-cfg-index-find-block cfg target)
    [(OptMaybeBlock.No) unit]
    [(OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 (opt-successor-sink-leading-phi-end instrs 0)]
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (while (< index count)
              (begin
                (opt-collect-instr-uses-array
                  uses
                  (ir.compiler-ir-instr-seq-ref instrs index))
                (set! index (+ index 1)))))])]))

(define (opt-successor-sink-collect-moved-uses!
  [moves : OptSuccessorSinkMoves]
  [target : i64]
  [uses : (__tl_dyn-array i64)]) : unit
  (match moves
    [(OptSuccessorSinkMoves.Nil) unit]
    [(OptSuccessorSinkMoves.Cons move rest)
      (begin
        (match move
          [(OptSuccessorSinkMove.Move _ _ move-target instrs origins)
            (if (= move-target target)
              (let
                [index : i64 0]
                [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
                (while (< index count)
                  (begin
                    ;; Clone uses are new and cannot stand in for an original
                    ;; source use in the all-uses-moving test.
                    (if (>= (array-ref origins index) 0)
                      (opt-collect-instr-uses-array
                        uses
                        (ir.compiler-ir-instr-seq-ref instrs index))
                      unit)
                    (set! index (+ index 1)))))
              unit)])
        (opt-successor-sink-collect-moved-uses!
          (__tl-box-place rest)
          target
          uses))]))

(define (opt-successor-sink-single-pred?
  [cfg : OptCfgIndex]
  [source : i64]
  [target : i64]) : bool
  (if (= source target)
    false
    (let
      [preds : OptLabelSet (opt-cfg-index-predecessors cfg target)]
      (and (= (opt-label-count preds) 1) (opt-label-contains preds source)))))

(define (opt-successor-sink-target-all-uses?
  [frame : i64]
  [cfg : OptCfgIndex]
  [total-uses : (__tl_dyn-array i64)]
  [allowed-uses : (__tl_dyn-array i64)]
  [moves : OptSuccessorSinkMoves]
  [source : i64]
  [target : i64]
  [dst : i64]) : bool
  (if (or (< dst 0) (>= dst frame))
    false
    (let
      [total : i64 (array-ref total-uses dst)]
      (if (or
        (<= total 0)
        (not (opt-successor-sink-single-pred? cfg source target)))
        false
        (begin
          (set! (array-ref allowed-uses dst) 0)
          (opt-successor-sink-collect-successor-uses! cfg target allowed-uses)
          (opt-successor-sink-collect-moved-uses! moves target allowed-uses)
          (= (array-ref allowed-uses dst) total))))))

(define (opt-successor-sink-find-target
  [frame : i64]
  [cfg : OptCfgIndex]
  [total-uses : (__tl_dyn-array i64)]
  [allowed-uses : (__tl_dyn-array i64)]
  [moves : OptSuccessorSinkMoves]
  [source : i64]
  [successors : OptLabelSet]
  [dst : i64]) : OptSuccessorSinkMaybeLabel
  (match successors
    [(OptLabelSet.Nil) (OptSuccessorSinkMaybeLabel.No)]
    [(OptLabelSet.Dense _ _)
      (let
        [target : i64 (opt-label-ref successors 0)]
        (if (opt-successor-sink-target-all-uses?
          frame
          cfg
          total-uses
          allowed-uses
          moves
          source
          target
          dst)
          (OptSuccessorSinkMaybeLabel.Some target)
          (opt-successor-sink-find-target
            frame
            cfg
            total-uses
            allowed-uses
            moves
            source
            (opt-label-tail successors)
            dst)))]))

(define (opt-successor-sink-collect-instr-list-uses!
  [instrs : ir.CompilerIrInstrList]
  [uses : (__tl_dyn-array i64)]) : unit
  (match instrs
    [(ir.CompilerIrInstrList.Nil) unit]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (begin
        (opt-collect-instr-uses-array uses instr)
        (opt-successor-sink-collect-instr-list-uses! (__tl-box-place rest) uses))]))

(define (opt-successor-sink-fill-defs!
  [frame : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [defs : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (begin
        (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
          [(option_i64.Some dst)
            (if (and (>= dst 0) (< dst frame))
              (set! (array-ref defs dst) (+ index 1))
              unit)]
          [(option_i64.None) unit])
        (set! index (+ index 1))))))

(define (opt-successor-sink-mark-terminator-live!
  [frame : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [terminator-index : i64]
  [live : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 (- terminator-index 1)]
    (begin
      (opt-collect-instr-uses-array
        live
        (ir.compiler-ir-instr-seq-ref instrs terminator-index))
      (while (>= index 0)
        (begin
          (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
            [(option_i64.Some dst)
              (if (and (>= dst 0) (< dst frame) (> (array-ref live dst) 0))
                (opt-collect-instr-uses-array
                  live
                  (ir.compiler-ir-instr-seq-ref instrs index))
                unit)]
            [(option_i64.None) unit])
          (set! index (- index 1)))))))

(define (opt-successor-sink-fill-all-defs!
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [defs : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-successor-sink-fill-defs! frame instrs defs)])
        (opt-successor-sink-fill-all-defs! frame (__tl-box-place rest) defs))]
    ;; Read-only over the blocks (it writes only the `defs` side array, in the
    ;; same order): scan the sequence directly (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [i : i64 0]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (opt-successor-sink-fill-defs! frame instrs defs)])
            (set! i (+ i 1)))))]))

(define (opt-successor-sink-loop-target?
  [index : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [source : i64]
  [target : i64]) : bool
  (match loops
    [(OptNaturalLoopList.Nil) false]
    [(OptNaturalLoopList.Cons loop rest)
      (if (and
        (= (opt-natural-loop-header loop) source)
        (opt-loop-body-label-member?
          (opt-natural-loop-body-info loop)
          index
          target))
        true
        (opt-successor-sink-loop-target?
          index
          (__tl-box-place rest)
          source
          target))]))

(define (opt-successor-sink-append-prepared!
  [context : OptSuccessorSinkPrepareContext]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [origins : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]
  [origin : i64]) : unit
  (let
    [slot : i64 builder.len]
    (begin
      (set! (array-ref origins slot) origin)
      (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
      (if (>= origin 0)
        (opt-collect-instr-uses-array context.covered-uses instr)
        unit))))

(define (opt-successor-sink-covered-use-count
  [context : OptSuccessorSinkPrepareContext]
  [pending-moves : ir.CompilerIrInstrList]
  [var : i64]) : i64
  (let
    [pending-uses : (__tl_dyn-array i64) (opt-used-array-new context.frame)]
    (begin
      (opt-successor-sink-collect-instr-list-uses! pending-moves pending-uses)
      (+
        (+
          (array-ref context.base-allowed var)
          (array-ref context.covered-uses var))
        (array-ref pending-uses var)))))

(define (opt-successor-sink-prepare-operands-from!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [instr : ir.CompilerIrInstr]
  [uses : (__tl_dyn-array i64)]
  [var : i64]
  [pending-moves : ir.CompilerIrInstrList]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [origins : (__tl_dyn-array i64)]) : bool
  (if (>= var context.frame)
    true
    (if (<= (array-ref uses var) 0)
      (opt-successor-sink-prepare-operands-from!
        type-segment-bases
        context
        instr
        uses
        (+ var 1)
        pending-moves
        (&mut builder)
        origins)
      (and
        (opt-successor-sink-ensure-operand!
          type-segment-bases
          context
          var
          pending-moves
          (&mut builder)
          origins)
        (opt-successor-sink-prepare-operands-from!
          type-segment-bases
          context
          instr
          uses
          (+ var 1)
          pending-moves
          (&mut builder)
          origins)))))

(define (opt-successor-sink-prepare-operands!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [instr : ir.CompilerIrInstr]
  [pending-moves : ir.CompilerIrInstrList]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [origins : (__tl_dyn-array i64)]) : bool
  (let
    [uses : (__tl_dyn-array i64) (opt-used-array-new context.frame)]
    (begin
      (opt-collect-instr-uses-array uses instr)
      (opt-successor-sink-prepare-operands-from!
        type-segment-bases
        context
        instr
        uses
        0
        pending-moves
        (&mut builder)
        origins))))

(define (opt-successor-sink-recipe-base-safe?
  [context : OptSuccessorSinkPrepareContext]
  [base : ir.CompilerIrValue]) : bool
  (match base
    [(ir.CompilerIrValue.Var var)
      (or
        (< var 0)
        (>= var context.frame)
        (<= (array-ref context.defs var) 0)
        (> (array-ref context.planned var) 0)
        (> (array-ref context.base-allowed var) 0))]
    [_ (opt-successor-sink-stable-value? base)]))

(define (opt-successor-sink-try-induction-remat!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [var : i64]
  [producer : ir.CompilerIrInstr]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [origins : (__tl_dyn-array i64)]) : bool
  (match (opt-successor-sink-induction-recipe context var producer)
    [(OptSuccessorSinkMaybeRecipe.No) false]
    [(OptSuccessorSinkMaybeRecipe.Some mul base ptr-ty)
      (if (and
        (<= (+ (array-ref context.clone-count 0) 2) 4)
        (opt-successor-sink-recipe-base-safe? context base)
        ;; Integer Add is byte-identical to Gep only for byte elements. This
        ;; form lets the backend select one LEA for base+scaled-index while the
        ;; following constant Gep remains a load displacement.
        (= (opt-load-loc-type-size type-segment-bases ptr-ty) 1))
        (let
          [fresh-mul : i64 (opt-bce-version-alloc-var context.frame-cell)]
          [rewritten-mul : ir.CompilerIrInstr
            (opt-successor-sink-subst-instr context.frame context.remap mul)]
          [fresh-gep : i64 (opt-bce-version-alloc-var context.frame-cell)]
          (begin
            (set!
              (array-ref context.clone-count 0)
              (+ (array-ref context.clone-count 0) 2))
            (opt-successor-sink-append-prepared!
              context
              (&mut builder)
              origins
              (opt-successor-sink-remat-clone fresh-mul rewritten-mul)
              (- 0 1))
            (opt-successor-sink-append-prepared!
              context
              (&mut builder)
              origins
              (ir.CompilerIrInstr.BinOp
                fresh-gep
                (ir.CompilerIrBinOp.Add)
                (opt-successor-sink-subst-value
                  context.frame
                  context.remap
                  base)
                (ir.CompilerIrValue.Var fresh-mul)
                (ast.AstType.I64))
              (- 0 1))
            (set! (array-ref context.remap var) (+ fresh-gep 1))
            (set! (array-ref context.planned var) 1)
            true))
        false)]))

;; Make one source-block operand available in the target without lengthening
;; its live range. A producer whose original uses all move may move as usual.
;; Otherwise only Gep/BinOp can be cloned, recursively, with a four-clone cap.
(define (opt-successor-sink-ensure-operand!
  [type-segment-bases : i64]
  [context : OptSuccessorSinkPrepareContext]
  [var : i64]
  [pending-moves : ir.CompilerIrInstrList]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [origins : (__tl_dyn-array i64)]) : bool
  (if (or
    (> (array-ref context.planned var) 0)
    (> (array-ref context.base-allowed var) 0)
    (> (array-ref context.leaf-uses var) 0)
    ;; The backward slice of the source terminator is already live at the
    ;; dispatch. Reusing one of its address producers in the selected arm
    ;; cannot extend that producer's live range, and avoids pointlessly
    ;; cloning `base + iv*scale` for a payload beside the tag load.
    (and
      context.source-loop-target
      (> (array-ref context.terminator-live var) 0)
      (<= (array-ref context.loop-phi-leaves var) 0)))
    true
    (let
      [def-tag : i64 (array-ref context.defs var)]
      (cond
        [(> (array-ref context.loop-phi-leaves var) 0)
          (let
            [_rematerialized : bool
              (if (> def-tag 0)
                (opt-successor-sink-try-induction-remat!
                  type-segment-bases
                  context
                  var
                  (ir.compiler-ir-instr-seq-ref context.instrs (- def-tag 1))
                  (&mut builder)
                  origins)
                false)]
            ;; A loop phi is already live around the natural loop. If the
            ;; specialized pointer recipe cannot prove a synchronized unit-step
            ;; IV, retaining the phi as the moved instruction's leaf is safe.
            true)]
        [(<= def-tag 0)
          ;; A value with no function definition is a parameter. An external value
          ;; used by a loop header is already live around the natural loop, so it
          ;; remains a safe leaf in a header successor. Target/terminator uses and
          ;; Phi leaves returned above cover the other permitted live cases.
          (or
            (<= (array-ref context.all-defs var) 0)
            context.source-loop-target
            (> (array-ref context.terminator-live var) 0))]
        [(> (array-ref context.visiting var) 0) false]
        [else
          (let
            [index : i64 (- def-tag 1)]
            [producer : ir.CompilerIrInstr
              (ir.compiler-ir-instr-seq-ref context.instrs index)]
            [all-move? : bool
              (=
                (array-ref context.total-uses var)
                (opt-successor-sink-covered-use-count context pending-moves var))]
            [can-move? : bool
              (and
                all-move?
                (opt-successor-sink-candidate?
                  context.instrs
                  index
                  context.terminator-index
                  producer))]
            (begin
              (set! (array-ref context.visiting var) 1)
              (cond
                [can-move?
                  (let
                    [next-pending : ir.CompilerIrInstrList
                      (ir.compiler-ir-instr-cons producer pending-moves)]
                    [ok : bool
                      (opt-successor-sink-prepare-operands!
                        type-segment-bases
                        context
                        producer
                        next-pending
                        (&mut builder)
                        origins)]
                    (begin
                      (if ok
                        (begin
                          (opt-successor-sink-append-prepared!
                            context
                            (&mut builder)
                            origins
                            (opt-successor-sink-subst-instr
                              context.frame
                              context.remap
                              producer)
                            index)
                          (set! (array-ref context.removed index) 1)
                          (set! (array-ref context.planned var) 1))
                        unit)
                      (set! (array-ref context.visiting var) 0)
                      ok))]
                [(and
                    (opt-successor-sink-remat-candidate? producer)
                    (< (array-ref context.clone-count 0) 4))
                  (begin
                    ;; Reserve the chain slot before descending so a fifth
                    ;; in-progress clone cannot pass a count that has not yet
                    ;; been committed while recursion unwinds.
                    (set!
                      (array-ref context.clone-count 0)
                      (+ (array-ref context.clone-count 0) 1))
                    (let
                      ;; The original producer remains in the source. Do not
                      ;; put it in `pending-moves`: its operand uses remain
                      ;; there and force transitive rematerialization as needed.
                      [ok : bool
                        (opt-successor-sink-prepare-operands!
                          type-segment-bases
                          context
                          producer
                          pending-moves
                          (&mut builder)
                          origins)]
                      (if ok
                        (let
                          [fresh : i64
                            (opt-bce-version-alloc-var context.frame-cell)]
                          [rewritten : ir.CompilerIrInstr
                            (opt-successor-sink-subst-instr
                              context.frame
                              context.remap
                              producer)]
                          (begin
                            (set! (array-ref context.remap var) (+ fresh 1))
                            (opt-successor-sink-append-prepared!
                              context
                              (&mut builder)
                              origins
                              (opt-successor-sink-remat-clone fresh rewritten)
                              (- 0 1))
                            (set! (array-ref context.planned var) 1)
                            (set! (array-ref context.visiting var) 0)
                            true))
                        (begin
                          (set!
                            (array-ref context.clone-count 0)
                            (- (array-ref context.clone-count 0) 1))
                          (set! (array-ref context.visiting var) 0)
                          false))))]
                [else
                  (begin
                    (set! (array-ref context.visiting var) 0)
                    false)])))]))))

(define (opt-successor-sink-prepare-root
  [type-segment-bases : i64]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [cfg : OptCfgIndex]
  [all-defs : (__tl_dyn-array i64)]
  [source-loop-target : bool]
  [total-uses : (__tl_dyn-array i64)]
  [loop-phi-leaves : (__tl_dyn-array i64)]
  [moves : OptSuccessorSinkMoves]
  [target : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [terminator-index : i64]
  [index : i64]
  [instr : ir.CompilerIrInstr]
  [frame-cell : (__tl_dyn-array i64)]) : OptSuccessorSinkPrepared
  (let
    [frame-before : i64 (array-ref frame-cell 0)]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [defs : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [base-allowed : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [leaf-uses : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [terminator-live : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [covered-uses : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [planned : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [visiting : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [remap : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [removed : (__tl_dyn-array i64) (opt-used-array-new count)]
    [clone-count : (__tl_dyn-array i64) (opt-used-array-new 1)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity (+ count 4))]
    [origins : (__tl_dyn-array i64) (array.make-array i64 (+ count 4))]
    (begin
      (opt-successor-sink-fill-defs! frame instrs defs)
      (opt-successor-sink-collect-successor-uses! cfg target base-allowed)
      (opt-successor-sink-collect-moved-uses! moves target base-allowed)
      (opt-collect-instr-uses-array
        leaf-uses
        (ir.compiler-ir-instr-seq-ref instrs terminator-index))
      (opt-successor-sink-mark-terminator-live!
        frame
        instrs
        terminator-index
        terminator-live)
      (let
        [context : OptSuccessorSinkPrepareContext
          (OptSuccessorSinkPrepareContext
            frame
            target
            blocks
            instrs
            terminator-index
            defs
            all-defs
            source-loop-target
            total-uses
            base-allowed
            leaf-uses
            terminator-live
            loop-phi-leaves
            covered-uses
            planned
            visiting
            remap
            removed
            frame-cell
            clone-count)]
        [pending : ir.CompilerIrInstrList
          (ir.compiler-ir-instr-cons instr ir.CompilerIrInstrList.Nil)]
        [ok : bool
          (opt-successor-sink-prepare-operands!
            type-segment-bases
            context
            instr
            pending
            (&mut builder)
            origins)]
        (if ok
          (begin
            (opt-successor-sink-append-prepared!
              context
              (&mut builder)
              origins
              (opt-successor-sink-subst-instr frame remap instr)
              index)
            (set! (array-ref removed index) 1)
            (OptSuccessorSinkPrepared.Some
              (ir.compiler-ir-instr-builder-to-seq builder)
              removed
              origins))
          (begin
            (set! (array-ref frame-cell 0) frame-before)
            (OptSuccessorSinkPrepared.No)))))))

(define (opt-successor-sink-plan-block
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [cfg : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [all-defs : (__tl_dyn-array i64)]
  [total-uses : (__tl_dyn-array i64)]
  [loop-phi-leaves : (__tl_dyn-array i64)]
  [allowed-uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]
  [tail : OptSuccessorSinkMoves]) : OptSuccessorSinkMoves
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 2)
          tail
          (let
            [terminator-index : i64 (- count 1)]
            [terminator : ir.CompilerIrInstr
              (ir.compiler-ir-instr-seq-ref instrs terminator-index)]
            [successors : OptLabelSet
              (match terminator
                [(ir.CompilerIrInstr.Branch _ _ _)
                  (opt-cfg-index-successors cfg label)]
                [(ir.CompilerIrInstr.TotalEnumBranch _ _ _)
                  (opt-cfg-index-successors cfg label)]
                [(ir.CompilerIrInstr.Switch _ _ _ _)
                  (opt-cfg-index-successors cfg label)]
                [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _)
                  (opt-cfg-index-successors cfg label)]
                [_ (OptLabelSet.Nil)])]
            [moves : OptSuccessorSinkMoves tail]
            [index : i64 (- terminator-index 1)]
            (begin
              (while (>= index 0)
                (let
                  [instr : ir.CompilerIrInstr
                    (ir.compiler-ir-instr-seq-ref instrs index)]
                  (begin
                    (if (and
                      (not (opt-successor-sink-source-index? moves label index))
                      (opt-successor-sink-candidate?
                        instrs
                        index
                        terminator-index
                        instr))
                      (match (opt-instr-def-var instr)
                        [(option_i64.Some dst)
                          (match (opt-successor-sink-find-target
                            frame
                            cfg
                            total-uses
                            allowed-uses
                            moves
                            label
                            successors
                            dst)
                            [(OptSuccessorSinkMaybeLabel.Some target)
                              (match (opt-successor-sink-prepare-root
                                type-segment-bases
                                frame
                                blocks
                                cfg
                                all-defs
                                (opt-successor-sink-loop-target?
                                  cfg
                                  loops
                                  label
                                  target)
                                total-uses
                                loop-phi-leaves
                                moves
                                target
                                instrs
                                terminator-index
                                index
                                instr
                                frame-cell)
                                [(OptSuccessorSinkPrepared.Some
                                    prepared
                                    removed
                                    origins)
                                  (set!
                                    moves
                                    (OptSuccessorSinkMoves.Cons
                                      (OptSuccessorSinkMove.Move
                                        label
                                        removed
                                        target
                                        prepared
                                        origins)
                                      (box moves)))]
                                [(OptSuccessorSinkPrepared.No) unit])]
                            [(OptSuccessorSinkMaybeLabel.No) unit])]
                        [(option_i64.None) unit])
                      unit)
                    (set! index (- index 1)))))
              moves))))]))

(define (opt-successor-sink-plan-blocks
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [cfg : OptCfgIndex]
  [loops : OptNaturalLoopList]
  [all-defs : (__tl_dyn-array i64)]
  [total-uses : (__tl_dyn-array i64)]
  [loop-phi-leaves : (__tl_dyn-array i64)]
  [allowed-uses : (__tl_dyn-array i64)]
  [remaining : ir.CompilerIrBlockList]
  [tail : OptSuccessorSinkMoves]) : OptSuccessorSinkMoves
  (match remaining
    [(ir.CompilerIrBlockList.Nil) tail]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-successor-sink-plan-blocks
        type-segment-bases
        frame
        frame-cell
        blocks
        cfg
        loops
        all-defs
        total-uses
        loop-phi-leaves
        allowed-uses
        (__tl-box-place rest)
        (opt-successor-sink-plan-block
          type-segment-bases
          frame
          frame-cell
          blocks
          cfg
          loops
          all-defs
          total-uses
          loop-phi-leaves
          allowed-uses
          block
          tail))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-successor-sink-plan-blocks
        type-segment-bases
        frame
        frame-cell
        blocks
        cfg
        loops
        all-defs
        total-uses
        loop-phi-leaves
        allowed-uses
        (ir.compiler-ir-block-seq-to-list seq)
        tail)]))

(define (opt-successor-sink-source-index?
  [moves : OptSuccessorSinkMoves]
  [source : i64]
  [index : i64]) : bool
  (match moves
    [(OptSuccessorSinkMoves.Nil) false]
    [(OptSuccessorSinkMoves.Cons move rest)
      (match move
        [(OptSuccessorSinkMove.Move move-source removed _ _ _)
          (if (and
            (= move-source source)
            (>= index 0)
            (< index (array-length removed))
            (> (array-ref removed index) 0))
            true
            (opt-successor-sink-source-index?
              (__tl-box-place rest)
              source
              index))])]))

(define (opt-successor-sink-push-target-moves!
  [moves : OptSuccessorSinkMoves]
  [target : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match moves
    [(OptSuccessorSinkMoves.Nil) unit]
    [(OptSuccessorSinkMoves.Cons move rest)
      (begin
        (match move
          [(OptSuccessorSinkMove.Move _ _ move-target instrs _)
            (if (= move-target target)
              (let
                [index : i64 0]
                [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
                (while (< index count)
                  (begin
                    (ir.compiler-ir-instr-builder-push!
                      (&mut builder)
                      (ir.compiler-ir-instr-seq-ref instrs index))
                    (set! index (+ index 1)))))
              unit)])
        (opt-successor-sink-push-target-moves!
          (__tl-box-place rest)
          target
          (&mut builder)))]))

(define (opt-successor-sink-rewrite-block
  [moves : OptSuccessorSinkMoves]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [phi-end : i64 (opt-successor-sink-leading-phi-end instrs 0)]
        [builder : ir.CompilerIrInstrBuilder
          (ir.compiler-ir-instr-builder-with-capacity count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (if (= index phi-end)
                (opt-successor-sink-push-target-moves!
                  moves
                  label
                  (&mut builder))
                unit)
              (if (not (opt-successor-sink-source-index? moves label index))
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.compiler-ir-instr-seq-ref instrs index))
                unit)
              (set! index (+ index 1))))
          (if (= phi-end count)
            (opt-successor-sink-push-target-moves! moves label (&mut builder))
            unit)
          (ir.CompilerIrBlock.Block
            label
            (ir.compiler-ir-instr-builder-to-seq builder))))]))

(define (opt-successor-sink-rewrite-blocks
  [moves : OptSuccessorSinkMoves]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-successor-sink-rewrite-block moves block)
        (opt-successor-sink-rewrite-blocks moves (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-successor-sink-rewrite-blocks
        moves
        (ir.compiler-ir-block-seq-to-list seq))]))

;; Global Word-of-Pack forwarding can make a Pack dead immediately before this
;; pass. Remove only those dead Packs here: leaving one in place makes its stale
;; operand use block the payload sink, while running general DCE here would also
;; erase the dead BinOp address recipes needed for rematerialization.
(define (opt-successor-sink-strip-dead-packs-block
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [builder : ir.CompilerIrInstrBuilder
          (ir.compiler-ir-instr-builder-with-capacity count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (let
              [instr : ir.CompilerIrInstr
                (ir.compiler-ir-instr-seq-ref instrs index)]
              (begin
                (match instr
                  [(ir.CompilerIrInstr.Pack dst _ _)
                    (if (and
                      (>= dst 0)
                      (< dst frame)
                      (<= (array-ref uses dst) 0))
                      unit
                      (ir.compiler-ir-instr-builder-push! (&mut builder) instr))]
                  [_ (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])
                (set! index (+ index 1)))))
          (ir.CompilerIrBlock.Block
            label
            (ir.compiler-ir-instr-builder-to-seq builder))))]))

;; The same dead-Pack test `opt-successor-sink-strip-dead-packs-block` applies,
;; asked as a question instead of answered by rebuilding. The strip rebuilds
;; every block of every function on every run of this pass to delete a Pack
;; that is almost never there (1.1K of 57.8K opt2 self-compile runs plan any
;; move at all), and the rebuilt list -- structurally identical to its input in
;; the no-strip case -- then forces a fresh CFG context build and a second full
;; SSA verify downstream. Asking first keeps the input list itself as the
;; answer, which is what the whole no-strip path needs: same blocks, so the
;; caller's context stays valid and its entry verify's verdict still binds.
(define (opt-successor-sink-instrs-have-dead-pack?
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Pack dst _ _)
        (if (and (>= dst 0) (< dst frame) (<= (array-ref uses dst) 0))
          true
          (opt-successor-sink-instrs-have-dead-pack?
            frame
            uses
            instrs
            (+ index 1)))]
      [_
        (opt-successor-sink-instrs-have-dead-pack?
          frame
          uses
          instrs
          (+ index 1))])))

(define (opt-successor-sink-block-seq-has-dead-pack?
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (if (match (ir.compiler-ir-block-seq-ref blocks index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (opt-successor-sink-instrs-have-dead-pack? frame uses instrs 0)])
      true
      (opt-successor-sink-block-seq-has-dead-pack?
        frame
        uses
        blocks
        (+ index 1)))))

(define (opt-successor-sink-blocks-have-dead-pack?
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-successor-sink-instrs-have-dead-pack? frame uses instrs 0)])
        true
        (opt-successor-sink-blocks-have-dead-pack?
          frame
          uses
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-successor-sink-block-seq-has-dead-pack? frame uses seq 0)]))

(define (opt-successor-sink-strip-dead-packs
  [frame : i64]
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-successor-sink-strip-dead-packs-block frame uses block)
        (opt-successor-sink-strip-dead-packs frame uses (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-successor-sink-strip-dead-packs
        frame
        uses
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-successor-sink-mark-leading-phis!
  [frame : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [leaves : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    unit
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi dst _ _)
        (begin
          (if (and (>= dst 0) (< dst frame))
            (set! (array-ref leaves dst) 1)
            unit)
          (opt-successor-sink-mark-leading-phis!
            frame
            instrs
            leaves
            (+ index 1)))]
      [_ unit])))

(define (opt-successor-sink-mark-phis!
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [leaves : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-successor-sink-mark-leading-phis! frame instrs leaves 0)])
        (opt-successor-sink-mark-phis! frame (__tl-box-place rest) leaves))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-successor-sink-mark-phis!
        frame
        (ir.compiler-ir-block-seq-to-list seq)
        leaves)]))

;; `blocks-result` plus the one extra fact its caller needs: whether the block
;; list it hands back is the very list it was given. `unchanged` is true only
;; when nothing was stripped AND no move was planned, which makes the result
;; blocks, the result context and the caller's `func` all identical to the
;; inputs -- enough for the caller to reuse the entry verify's verdict.
(defenum OptSuccessorSinkBlocksResult
  (Result ir.CompilerIrBlockList OptCfgContext bool bool))

;; `context` must be valid for `blocks`. When no dead Pack is present the strip
;; is the identity, so `ready` IS `blocks` and that same context is already the
;; context this pass would have rebuilt for it.
(define (opt-successor-sink-blocks-result-with-context
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [context : OptCfgContext]) : OptSuccessorSinkBlocksResult
  (let
    [initial-uses : (__tl_dyn-array i64)
      (opt-collect-blocks-uses-array frame blocks)]
    [stripped : bool
      (opt-successor-sink-blocks-have-dead-pack? frame initial-uses blocks)]
    [ready : ir.CompilerIrBlockList
      (if stripped
        (opt-successor-sink-strip-dead-packs frame initial-uses blocks)
        blocks)]
    ;; The natural-loop scan needs the pred-map/reachable/dominator view of the
    ;; SAME block list this pass already indexes, and `opt-cfg-natural-loops`
    ;; builds a whole context (index included) internally. Build the context
    ;; once and take its index instead of indexing `ready` twice -- and when
    ;; the strip was the identity, the caller's context already is that build.
    [cfg-context : OptCfgContext
      (if stripped
        (opt-cfg-context-build ready)
        context)]
    [cfg : OptCfgIndex cfg-context.index]
    [loops : OptNaturalLoopList
      (opt-cfg-natural-loops-with-context ready cfg-context)]
    [all-defs : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [_all-defs : unit (opt-successor-sink-fill-all-defs! frame ready all-defs)]
    ;; `initial-uses` counted uses over `blocks` and is dead once the strip
    ;; decision is made, so it already is the count over `ready` whenever the
    ;; strip did not run.
    [total-uses : (__tl_dyn-array i64)
      (if stripped
        (opt-collect-blocks-uses-array frame ready)
        initial-uses)]
    [loop-phi-leaves : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [_loop-phi-leaves : unit
      (opt-successor-sink-mark-phis! frame ready loop-phi-leaves)]
    [allowed-uses : (__tl_dyn-array i64) (opt-used-array-new frame)]
    [moves : OptSuccessorSinkMoves
      (opt-successor-sink-plan-blocks
        type-segment-bases
        frame
        frame-cell
        ready
        cfg
        loops
        all-defs
        total-uses
        loop-phi-leaves
        allowed-uses
        ready
        (OptSuccessorSinkMoves.Nil))]
    ;; The no-move path returns `ready` verbatim, and `cfg-context` was built
    ;; for exactly that block list, so report it as valid for the result. This
    ;; pass runs on every function every iteration but only plans moves for a
    ;; few hundred of them, so the reuse covers the overwhelming majority of
    ;; runs and saves the caller a whole CFG context build.
    (match moves
      [(OptSuccessorSinkMoves.Nil)
        (OptSuccessorSinkBlocksResult.Result
          ready
          cfg-context
          true
          (not stripped))]
      [_
        (OptSuccessorSinkBlocksResult.Result
          (opt-successor-sink-rewrite-blocks moves ready)
          cfg-context
          false
          false)])))

(define (opt-successor-sink-blocks-result
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : OptBlockCtxResult
  (match (opt-successor-sink-blocks-result-with-context
    type-segment-bases
    frame
    frame-cell
    blocks
    (opt-cfg-context-build blocks))
    [(OptSuccessorSinkBlocksResult.Result out ctx reusable _)
      (OptBlockCtxResult.Result out ctx reusable)]))

(define (opt-successor-sink-blocks
  [type-segment-bases : i64]
  [frame : i64]
  [frame-cell : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (opt-successor-sink-blocks-result
    type-segment-bases
    frame
    frame-cell
    blocks)
    [(OptBlockCtxResult.Result out _ _) out]))

;; Public pass boundary used by self-tests and by the opt2 pipeline. Both the
;; entry and rewritten functions are verified so this scheduling rule never runs
;; on mutable-var IR and rejects any unexpected dominance regression.
;;
;; `context` must be valid for `func`'s blocks: the entry verify runs against it
;; instead of building an identical one, and both rejection paths report it
;; unchanged. The returned context is valid for the returned function's blocks,
;; which spares the caller the rebuild it used to do right after this returned.
(define (opt-successor-sink-function-with-context-result
  [type-segment-bases : i64]
  [context : OptCfgContext]
  [func : ir.CompilerIrFunction]) : OptFunctionCtxResult
  ;; The check itself is still a full verify: this pass is NOT covered by the
  ;; `loop-cluster-verified?` invariant and skipping it crashes the self-compile.
  (match (opt-verify-function-with-context func context)
    [(ResultCompilerOptimizeVerify.Err _)
      (OptFunctionCtxResult.Result func context)]
    [(ResultCompilerOptimizeVerify.Ok)
      (match func
        [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          (let
            [frame-cell : (__tl_dyn-array i64) (opt-used-array-new 1)]
            [_frame-init : unit (set! (array-ref frame-cell 0) frame)]
            [sink-result : OptSuccessorSinkBlocksResult
              (opt-successor-sink-blocks-result-with-context
                type-segment-bases
                frame
                frame-cell
                blocks
                context)]
            [next-blocks : ir.CompilerIrBlockList
              (match sink-result
                [(OptSuccessorSinkBlocksResult.Result b _ _ _) b])]
            [next : ir.CompilerIrFunction
              (ir.CompilerIrFunction.Function
                name
                params
                ret-ty
                (array-ref frame-cell 0)
                next-blocks)]
            [next-context : OptCfgContext
              (match sink-result
                [(OptSuccessorSinkBlocksResult.Result _ ctx reusable _)
                  (if reusable
                    ctx
                    (opt-cfg-context-build next-blocks))])]
            ;; Nothing stripped, nothing moved and no new vreg means `next` is
            ;; the same name/params/return type/frame/block list as `func` and
            ;; `next-context` is the very context just verified against, so the
            ;; entry verify above already decided this exit verify: it is the
            ;; same pure query on the same values and can only answer Ok. Half
            ;; of every SSA verify in the opt2 self-compile is this one.
            (if (match sink-result
              [(OptSuccessorSinkBlocksResult.Result _ _ _ unchanged)
                (and unchanged (= (array-ref frame-cell 0) frame))])
              (OptFunctionCtxResult.Result next next-context)
              (match (opt-verify-function-with-context next next-context)
                [(ResultCompilerOptimizeVerify.Ok)
                  (OptFunctionCtxResult.Result next next-context)]
                [(ResultCompilerOptimizeVerify.Err _)
                  (OptFunctionCtxResult.Result func context)])))])]))

(define (opt-successor-sink-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-successor-sink-function-with-context-result
    type-segment-bases
    (opt-cfg-context-build (opt-function-blocks func))
    func)
    [(OptFunctionCtxResult.Result f _) f]))

;; ---------------------------------------------------------------------------
(defstruct OptIfConvertBlockFact
  (label i64)
  (instrs ir.CompilerIrInstrSeq)
  (count i64)
  (first ir.CompilerIrInstrScalarFact)
  (before-last ir.CompilerIrInstrScalarFact)
  (last ir.CompilerIrInstrScalarFact))

(define (opt-if-convert-block-fact [block : ir.CompilerIrBlock]) : OptIfConvertBlockFact
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (OptIfConvertBlockFact
          label
          instrs
          count
          (if (> count 0)
            (ir.compiler-ir-instr-scalar-fact
              (ir.compiler-ir-instr-seq-ref instrs 0))
            (ir.CompilerIrInstrScalarFact.Other))
          (if (> count 1)
            (ir.compiler-ir-instr-scalar-fact
              (ir.compiler-ir-instr-seq-ref instrs (- count 2)))
            (ir.CompilerIrInstrScalarFact.Other))
          (if (> count 0)
            (ir.compiler-ir-instr-scalar-fact
              (ir.compiler-ir-instr-seq-ref instrs (- count 1)))
            (ir.CompilerIrInstrScalarFact.Other))))]))

(define (opt-if-convert-facts [blocks : ir.CompilerIrBlockSeq]) : (__tl_dyn-array
    OptIfConvertBlockFact)
  (let
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [facts : (__tl_dyn-array OptIfConvertBlockFact)
      (make-array OptIfConvertBlockFact count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref facts index)
            (opt-if-convert-block-fact
              (ir.compiler-ir-block-seq-ref blocks index)))
          (set! index (+ index 1))))
      facts)))

(define (opt-if-convert-arm? [fact : OptIfConvertBlockFact] [merge : i64]) : bool
  (and
    (= fact.count 1)
    (match fact.last
      [(ir.CompilerIrInstrScalarFact.Jump target) (= target merge)]
      [_ false])))

(define (opt-if-convert-live-values?
  [first : ir.CompilerIrValue]
  [second : ir.CompilerIrValue]) : bool
  (match first
    [(ir.CompilerIrValue.Var _)
      (match second
        [(ir.CompilerIrValue.Var _) true]
        [_ false])]
    [_ false]))

(define (opt-if-convert-try!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockSeq]
  [facts : (__tl_dyn-array OptIfConvertBlockFact)]
  [id : i64]) : bool
  (if (>= (+ id 3) (array-length facts))
    false
    (let
      [source : OptIfConvertBlockFact (array-ref facts id)]
      [a : OptIfConvertBlockFact (array-ref facts (+ id 1))]
      [b : OptIfConvertBlockFact (array-ref facts (+ id 2))]
      [merge : OptIfConvertBlockFact (array-ref facts (+ id 3))]
      [source-label : i64 source.label]
      [a-label : i64 a.label]
      [b-label : i64 b.label]
      [merge-label : i64 merge.label]
      [source-instrs : ir.CompilerIrInstrSeq source.instrs]
      [merge-instrs : ir.CompilerIrInstrSeq merge.instrs]
      (begin
        (when
          (or
            (< source.count 2)
            (< merge.count 1)
            (match source.first
              [(ir.CompilerIrInstrScalarFact.Phi _ _ _) false]
              [_ true])
            (not (opt-if-convert-arm? a merge-label))
            (not (opt-if-convert-arm? b merge-label)))
          (return false))
        (match source.last
          [(ir.CompilerIrInstrScalarFact.Branch condition yes no)
            (if (not
              (or
                (and (= a-label yes) (= b-label no))
                (and (= a-label no) (= b-label yes))))
              false
              (match condition
                [(ir.CompilerIrValue.Var condition-var)
                  (match source.before-last
                    [(ir.CompilerIrInstrScalarFact.BinOp condition-dst op _ _ _)
                      (if (not
                        (and
                          (= condition-dst condition-var)
                          (ir.compiler-ir-binop-compare? op)))
                        false
                        (match merge.first
                          [(ir.CompilerIrInstrScalarFact.Phi dst inputs ty)
                            (if (or
                              (not
                                (or
                                  (opt-integer-type? ty)
                                  (opt-type-eq
                                    type-segment-bases
                                    ty
                                    (ast.AstType.Bool))))
                              (match merge.last
                                [(ir.CompilerIrInstrScalarFact.Branch next _ _)
                                  (opt-value-eq (clone condition) next)]
                                [_ false]))
                              false
                              (match (opt-bool-branch-phi-inputs inputs)
                                [(OptBoolBranchPhiInputs.No) false]
                                [(OptBoolBranchPhiInputs.Two
                                    first
                                    first-label
                                    second
                                    second-label)
                                  (if (or
                                    (not
                                      (or
                                        (and
                                          (= first-label yes)
                                          (= second-label no))
                                        (and
                                          (= first-label no)
                                          (= second-label yes))))
                                    (not
                                      (opt-if-convert-live-values? first second)))
                                    false
                                    (let
                                      [source-builder : ir.CompilerIrInstrBuilder
                                        (ir.compiler-ir-instr-builder-with-capacity
                                          (+ source.count 1))]
                                      [merge-builder : ir.CompilerIrInstrBuilder
                                        (ir.compiler-ir-instr-builder-with-capacity
                                          (- merge.count 1))]
                                      (begin
                                        (ir.compiler-ir-instr-builder-append-seq-range!
                                          (&mut source-builder)
                                          source-instrs
                                          0
                                          (- source.count 1))
                                        (ir.compiler-ir-instr-builder-push!
                                          (&mut source-builder)
                                          (ir.ir-instr-select
                                            dst
                                            condition
                                            (if (= first-label yes)
                                              first
                                              second)
                                            (if (= first-label yes)
                                              second
                                              first)
                                            0
                                            ty))
                                        (ir.compiler-ir-instr-builder-push!
                                          (&mut source-builder)
                                          (ir.CompilerIrInstr.Jump merge-label))
                                        (ir.compiler-ir-instr-builder-append-seq-range!
                                          (&mut merge-builder)
                                          merge-instrs
                                          1
                                          merge.count)
                                        (set!
                                          (array-ref blocks.slots id)
                                          (ir.CompilerIrBlock.Block
                                            source-label
                                            (ir.compiler-ir-instr-builder-to-seq
                                              source-builder)))
                                        (set!
                                          (array-ref blocks.slots (+ id 3))
                                          (ir.CompilerIrBlock.Block
                                            merge-label
                                            (ir.compiler-ir-instr-builder-to-seq
                                              merge-builder)))
                                        (set!
                                          (array-ref facts (+ id 3))
                                          (opt-if-convert-block-fact
                                            (array-ref blocks.slots (+ id 3))))
                                        true)))]))]
                          [_ false]))]
                    [_ false])]
                [_ false]))]
          [_ false])))))

(define (opt-if-convert-function-pass
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame original)
      (let
        [blocks : ir.CompilerIrBlockList
          (ir.compiler-ir-block-list-compact
            (opt-bool-branch-clone-blocks original))]
        (match blocks
          [(ir.CompilerIrBlockList.Array seq)
            (let
              [facts : (__tl_dyn-array OptIfConvertBlockFact)
                (opt-if-convert-facts seq)]
              [read : i64 0]
              [changed : bool false]
              (begin
                (while (< read (array-length facts))
                  (begin
                    (if (opt-if-convert-try! type-segment-bases seq facts read)
                      (set! changed true)
                      unit)
                    (set! read (+ read 1))))
                (if (not changed)
                  (OptFunctionPassResult.Result func false)
                  (let
                    [next : ir.CompilerIrFunction
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        frame
                        (opt-cfg-simplify-blocks blocks))]
                    (match (opt-verify-function next)
                      [(ResultCompilerOptimizeVerify.Ok)
                        (OptFunctionPassResult.Result next true)]
                      [(ResultCompilerOptimizeVerify.Err _)
                        (OptFunctionPassResult.Result func false)])))))]
          [_ (OptFunctionPassResult.Result func false)]))]))

(define (opt-if-convert-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-if-convert-function-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next _) next]))

;; --- G1a: constructor destination forwarding (SRET<-tmp) --------------------
;;
;; Lowering builds a nested constructor into a fresh frame temp and then copies
;; the finished aggregate into its real destination:
;;
;;     %t   = alloc T                 ; fresh frame storage (>= 1 slot)
;;     %p   = addr_of %t
;;     %g   = gep %p, K : u8          ; one per field
;;     store_ptr %g, v : ty
;;     ...
;;     %d   = gep %B, J : u8          ; the real destination (sret slot, field)
;;     call tl_memcpy(%d, %p, S)      ; or `copy_bytes %d, %p, S`
;;
;; The whole-aggregate copy disappears when the field stores are retargeted at
;; `%B + J + K` directly. That is a REORDERING: every retargeted store now
;; writes the destination BEFORE the instructions that used to sit between it
;; and the copy.
;;
;; SOUNDNESS. Issue #5971 gives internal memory-class by-value parameters a
;; private callee-entry snapshot, so their body-visible storage cannot alias the
;; hidden sret slot even though the ABI transports the incoming value by
;; pointer. That property is deliberately narrower than general `noalias`:
;; explicit references, dereferences, fields, indexes, and arbitrary destination
;; places may still alias storage read inside this rewrite window. A
;; lowering-level version of this transform miscompiled the compiler (it broke
;; `tc-name-id-list-add`) before the necessary proof was explicit. The guard
;; below remains the conservative local alias proof:
;;
;;   (1) `%t` is a FRESH FRAME ALLOCATION whose address never escapes: the
;;       ALLOC var `%t` is used exactly once in the whole function (by the
;;       matched `addr_of`, so no second pointer to the same storage exists),
;;       every use of `%p` is one of the retargeted geps or the copy's source
;;       operand, and every retargeted gep var is used only by its own store --
;;       all three via EXACT function-wide use counts. Nothing else can observe
;;       `T`, so deleting `T` is invisible.
;;   (2) The window -- from the FIRST retargeted store to the copy -- contains
;;       ONLY instructions that cannot observe or disturb the destination
;;       bytes: side-effect-free (`Pure`) instructions, frame `Alloc`s (which
;;       emit no code), the retargeted geps/stores themselves, and stores
;;       through a constant offset off the SAME base as the destination whose
;;       byte range is provably disjoint from `[J, J + S)` (two constant offsets
;;       off one pointer cannot overlap). Any load, call, or store through an
;;       unrelated pointer aborts the match -- precisely the class that cannot
;;       be discharged from local IR use counts alone.
;;   (3) The destination base var `%B` is not redefined between the destination
;;       address computation (or the temp's `addr_of`, whichever is earlier) and
;;       the copy, so the address the retargeted geps compute is the address the
;;       copy would have written.
;;   (4) Every retargeted store lies inside `[0, S)`, so no store escapes the
;;       byte range the copy used to define.
;;
;; Blocks are straight-line, so nothing inside the window can trap or branch out
;; between the first retargeted store and the deleted copy (a trapping check is
;; its own block, and calls are rejected by (2)); the destination is therefore
;; written on exactly the paths that used to run the copy.
;;
;; Bytes of `[J, J + S)` that no store covers keep the destination's previous
;; contents instead of receiving the temp's uninitialised stack bytes. Both are
;; values no defined program can observe (they are padding of a freshly reserved
;; frame slot), and the bootstrap fixpoint / deterministic-asm gates cover the
;; claim end to end.
;;
;; The rewrite itself is minimal: rebase the field geps and delete the copy.
;; `addr_of` and the `alloc` run then have no uses left and the pipeline DCE
;; retires them, which also releases the frame slots.
(defenum OptCtorFwdCopy
  (NoCopy)
  ;; destination address value, source var, byte size, call result var (-1 for
  ;; `CopyBytes`, which defines nothing).
  (Copy ir.CompilerIrValue i64 i64 i64))

;; Destination base var, its constant byte offset, and the index of the address
;; computation inside the block (-1 when the address enters the block already
;; computed).
(defenum OptCtorFwdDest
  (NoDest)
  (Dest i64 i64 i64))

;; Byte width a `StorePtr` of this value type writes. This number is
;; load-bearing twice (the `offset + width <= size` coverage check and the
;; same-base disjointness check), so it MUST NOT under-report.
;;
;; The invariant that makes it exact is a BACKEND one, not a lowering one:
;; `compiler-backend-emit-store-ptr` routes every `StorePtr` through
;; `compiler-backend-emit-store-value-to-address`, which emits exactly ONE
;; register store -- `compiler-backend-emit-store-reg-to-memory` picks
;; `movq`/`movl`/`movw`/`movb` purely from `compiler-backend-type-size ty`
;; (8/4/2/1 and nothing else; `compiler_backend.tl`, the `type-size` /
;; `emit-store-reg-to-memory` pair), and the float path emits one xmm store of
;; the same width. A `StorePtr` therefore writes at most 8 bytes, whatever the
;; type, and the arms below reproduce `compiler-backend-type-size` exactly for
;; every type they accept -- including the ones that look wide at the source
;; level (`String`, `Str`, `Bytes`, `DynArray`, `Array`, `Func`, `Tuple`, and
;; register-resident `Struct`/`Enum`), all of which the backend stores as a
;; single 8-byte word.
;;
;; Every remaining type FAILS CLOSED with -1 and aborts the match, which is
;; strictly more conservative than the backend: that covers the zero-width
;; types (`Unit`/`Never`/`Expr`/`ExprList`), the type variables
;; (`Var`/`VarArgs`), and the two arms the backend resolves by recursing through
;; the type-segment table (`Region`/`Consume`), which this pass does not thread.
;; If `compiler-backend-type-size` ever grows an arm wider than 8, this function
;; must reject that type here.
(define (opt-ctor-fwd-store-byte-size [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.Char) 1]
    [(ast.AstType.Ptr _) 8]
    [(ast.AstType.MutPtr _) 8]
    [(ast.AstType.Ref _ _) 8]
    [(ast.AstType.MutRef _ _) 8]
    [(ast.AstType.Box _) 8]
    [(ast.AstType.String) 8]
    [(ast.AstType.Str) 8]
    [(ast.AstType.Bytes) 8]
    [(ast.AstType.DynArray _) 8]
    [(ast.AstType.Slice _) 0]
    [(ast.AstType.Array _ _) 8]
    [(ast.AstType.Func _ _) 8]
    [(ast.AstType.Tuple _) 8]
    [(ast.AstType.Enum _) 8]
    [(ast.AstType.EnumArgs _ _) 8]
    [(ast.AstType.Struct _) 8]
    [(ast.AstType.StructArgs _ _) 8]
    [_ -1]))

(define (opt-ctor-fwd-memcpy-symbol? [symbol : i64]) : bool
  (string.eq (ir.compiler-ir-symbol-text symbol) "tl_memcpy"))

;; A whole-aggregate copy out of an IR var: `CopyBytes` (the 16..112 B inline
;; band) or the `tl_memcpy` runtime call lowering emits above that band.
(define (opt-ctor-fwd-match-copy [instr : ir.CompilerIrInstr]) : OptCtorFwdCopy
  (match instr
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (match src
        [(ir.CompilerIrValue.Var src-var)
          (if (> size 0)
            (OptCtorFwdCopy.Copy dst src-var size -1)
            (OptCtorFwdCopy.NoCopy))]
        [_ (OptCtorFwdCopy.NoCopy)])]
    [(ir.CompilerIrInstr.Call call-dst name args _)
      (match args
        [(ir.CompilerIrCallArgs.Array values)
          (if (= (array-length values) 3)
            (match (array-ref values 2)
              [(ir.CompilerIrValue.I64 size)
                (match (array-ref values 1)
                  [(ir.CompilerIrValue.Var src-var)
                    (if (and (> size 0) (opt-ctor-fwd-memcpy-symbol? name))
                      (OptCtorFwdCopy.Copy
                        (array-ref values 0)
                        src-var
                        size
                        call-dst)
                      (OptCtorFwdCopy.NoCopy))]
                  [_ (OptCtorFwdCopy.NoCopy)])]
              [_ (OptCtorFwdCopy.NoCopy)])
            (OptCtorFwdCopy.NoCopy))]
        [_ (OptCtorFwdCopy.NoCopy)])]
    [_ (OptCtorFwdCopy.NoCopy)]))

;; Cheap per-block admission: a block can only hold the pattern when it has both
;; a frame `addr_of` and a whole-aggregate copy out of a var. Everything else
;; (the exact use census, which allocates) is gated behind this.
(define (opt-ctor-fwd-block-candidate? [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [saw-addr : bool false]
    [saw-copy : bool false]
    [i : i64 0]
    (begin
      (while (and (< i count) (not (and saw-addr saw-copy)))
        (let
          [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs i)]
          (begin
            (match instr
              [(ir.CompilerIrInstr.AddrOf _ _) (set! saw-addr true)]
              [_
                (match (opt-ctor-fwd-match-copy instr)
                  [(OptCtorFwdCopy.Copy _ _ _ _) (set! saw-copy true)]
                  [(OptCtorFwdCopy.NoCopy) unit])])
            (set! i (+ i 1)))))
      (and saw-addr saw-copy))))

(define (opt-ctor-fwd-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (opt-ctor-fwd-block-candidate? instrs)
            true
            (opt-ctor-fwd-blocks-have-candidate? (__tl-box-place rest)))])]
    ;; Read-only, early-exit: scan the sequence directly (refs #5729).
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [found : bool false]
        [i : i64 0]
        (begin
          (while (and (not found) (< i count))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (if (opt-ctor-fwd-block-candidate? instrs)
                    (set! found true)
                    unit)])
              (set! i (+ i 1))))
          found))]))

;; Index of the `addr_of` that defines `var`, searching back from `from`.
;; Returns -1 when the search hits another definition of `var` first or leaves
;; the block.
(define (opt-ctor-fwd-find-addr-of
  [instrs : ir.CompilerIrInstrSeq]
  [from : i64]
  [var : i64]) : i64
  (let
    [i : i64 from]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (>= i 0))
        (let
          [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs i)]
          (begin
            (match instr
              [(ir.CompilerIrInstr.AddrOf dst _)
                (if (= dst var)
                  (begin
                    (set! found i)
                    (set! done true))
                  unit)]
              [_
                (match (opt-instr-def-var instr)
                  [(option_i64.Some d)
                    (if (= d var)
                      (set! done true)
                      unit)]
                  [(option_i64.None) unit])])
            (set! i (- i 1)))))
      found)))

;; Index of the last definition of `var` in `[0, from]`, or -1 when `var` enters
;; the block already defined.
(define (opt-ctor-fwd-find-def
  [instrs : ir.CompilerIrInstrSeq]
  [from : i64]
  [var : i64]) : i64
  (let
    [i : i64 from]
    [found : i64 -1]
    (begin
      (while (>= i 0)
        (begin
          (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs i))
            [(option_i64.Some d)
              (if (= d var)
                (begin
                  (set! found i)
                  (set! i 0))
                unit)]
            [(option_i64.None) unit])
          (set! i (- i 1))))
      found)))

(define (opt-ctor-fwd-defined-in-range?
  [instrs : ir.CompilerIrInstrSeq]
  [lo : i64]
  [hi : i64]
  [var : i64]) : bool
  (let
    [i : i64 lo]
    [found : bool false]
    (begin
      (while (and (not found) (<= i hi))
        (begin
          (match (opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs i))
            [(option_i64.Some d)
              (if (= d var)
                (set! found true)
                unit)]
            [(option_i64.None) unit])
          (set! i (+ i 1))))
      found)))

;; Byte offset of a `gep <base>, K : u8` instruction, or -1 when the instruction
;; is not one.
(define (opt-ctor-fwd-gep-offset [instr : ir.CompilerIrInstr] [base : i64]) : i64
  (match instr
    [(ir.CompilerIrInstr.Gep _ source offset elem-ty)
      (match elem-ty
        [(ast.AstType.U8)
          (match source
            [(ir.CompilerIrValue.Var source-var)
              (if (= source-var base)
                (match offset
                  [(ir.CompilerIrValue.I64 k)
                    (if (>= k 0)
                      k
                      -1)]
                  [_ -1])
                -1)]
            [_ -1])]
        [_ -1])]
    [_ -1]))

(define (opt-ctor-fwd-gep-dst [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.Gep dst _ _ _) dst]
    [_ -1]))

;; The frame slot var an `addr_of` reads, i.e. the storage the temp pointer
;; names. `opt-collect-instr-uses-array` counts this operand
;; (`AddrOf _ src -> opt-used-array-add items src`), so its exact function-wide
;; use count answers "is there a SECOND pointer to this storage?".
(define (opt-ctor-fwd-addr-of-slot [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(ir.CompilerIrInstr.AddrOf _ src) src]
    [_ -1]))

;; Constant byte offset of `var` off `base` when `var` is a `gep base, K : u8`
;; defined in `[lo, hi]`; -1 otherwise.
(define (opt-ctor-fwd-same-base-offset
  [instrs : ir.CompilerIrInstrSeq]
  [lo : i64]
  [hi : i64]
  [base : i64]
  [var : i64]) : i64
  (let
    [index : i64 (opt-ctor-fwd-find-def instrs hi var)]
    (if (or (< index lo) (< index 0))
      -1
      (opt-ctor-fwd-gep-offset (ir.compiler-ir-instr-seq-ref instrs index) base))))

(define (opt-ctor-fwd-ranges-disjoint?
  [a-start : i64]
  [a-size : i64]
  [b-start : i64]
  [b-size : i64]) : bool
  (or (<= (+ a-start a-size) b-start) (<= (+ b-start b-size) a-start)))

;; True for the instructions the window may contain besides the retargeted
;; geps/stores: anything without a memory effect, plus frame `Alloc` (a slot
;; reservation the backend emits no code for), plus a store through a constant
;; offset off the destination base whose bytes provably miss the destination
;; range.
(define (opt-ctor-fwd-window-instr-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [lo : i64]
  [index : i64]
  [dest-base : i64]
  [dest-off : i64]
  [dest-size : i64]) : bool
  (let
    [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
    (match instr
      [(ir.CompilerIrInstr.Alloc _ _) true]
      [(ir.CompilerIrInstr.StorePtr ptr _ ty)
        (match ptr
          [(ir.CompilerIrValue.Var ptr-var)
            (let
              [width : i64 (opt-ctor-fwd-store-byte-size ty)]
              [offset : i64
                (opt-ctor-fwd-same-base-offset
                  instrs
                  lo
                  (- index 1)
                  dest-base
                  ptr-var)]
              (and
                (> width 0)
                (>= offset 0)
                (opt-ctor-fwd-ranges-disjoint? offset width dest-off dest-size)))]
          [_ false])]
      [_
        (match (ir.compiler-ir-instr-effect instr)
          [(ir.CompilerIrEffect.Pure) true]
          [_ false])])))

;; Exact use count of `var` across the whole function; -1 when the var is out of
;; range, which makes every test below fail closed.
(define (opt-ctor-fwd-use-count [uses : (__tl_dyn-array i64)] [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length uses)))
    -1
    (array-ref uses var)))

;; Index of the `StorePtr` whose address is exactly `var`, searched in
;; `(from, limit)`; -1 when there is none.
(define (opt-ctor-fwd-find-store
  [instrs : ir.CompilerIrInstrSeq]
  [from : i64]
  [limit : i64]
  [var : i64]) : i64
  (let
    [i : i64 (+ from 1)]
    [found : i64 -1]
    (begin
      (while (and (< found 0) (< i limit))
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs i)
            [(ir.CompilerIrInstr.StorePtr ptr _ _)
              (match ptr
                [(ir.CompilerIrValue.Var ptr-var)
                  (if (= ptr-var var)
                    (set! found i)
                    unit)]
                [_ unit])]
            [_ unit])
          (set! i (+ i 1))))
      found)))

;; Resolve the copy destination address into `(base var, byte offset, address
;; instruction index)`.
(define (opt-ctor-fwd-resolve-dest
  [instrs : ir.CompilerIrInstrSeq]
  [copy-index : i64]
  [dest-value : ir.CompilerIrValue]) : OptCtorFwdDest
  (match dest-value
    [(ir.CompilerIrValue.Var dest-var)
      (let
        [def-index : i64
          (opt-ctor-fwd-find-def instrs (- copy-index 1) dest-var)]
        [gep-offset : i64
          (if (< def-index 0)
            -1
            (match (ir.compiler-ir-instr-seq-ref instrs def-index)
              [(ir.CompilerIrInstr.Gep _ source offset elem-ty)
                (match elem-ty
                  [(ast.AstType.U8)
                    (match source
                      [(ir.CompilerIrValue.Var _)
                        (match offset
                          [(ir.CompilerIrValue.I64 k) k]
                          [_ -1])]
                      [_ -1])]
                  [_ -1])]
              [_ -1]))]
        (if (>= gep-offset 0)
          (match (ir.compiler-ir-instr-seq-ref instrs def-index)
            [(ir.CompilerIrInstr.Gep _ source _ _)
              (match source
                [(ir.CompilerIrValue.Var source-var)
                  (OptCtorFwdDest.Dest source-var gep-offset def-index)]
                [_ (OptCtorFwdDest.NoDest)])]
            [_ (OptCtorFwdDest.NoDest)])
          (OptCtorFwdDest.Dest dest-var 0 def-index)))]
    [_ (OptCtorFwdDest.NoDest)]))

;; Validate one gep off the temp. Returns the index of its store, `copy-index`
;; when the gep has no uses at all, or -1 when the gep disqualifies the site.
(define (opt-ctor-fwd-gep-store-index
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [copy-index : i64]
  [temp : i64]
  [size : i64]
  [gep-index : i64]) : i64
  (let
    [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs gep-index)]
    [offset : i64 (opt-ctor-fwd-gep-offset instr temp)]
    [gep-dst : i64 (opt-ctor-fwd-gep-dst instr)]
    [gep-uses : i64 (opt-ctor-fwd-use-count uses gep-dst)]
    (cond
      [(< offset 0) -1]
      [(>= offset size) -1]
      [(< gep-uses 0) -1]
      [(= gep-uses 0) copy-index]
      [(> gep-uses 1) -1]
      [else
        (let
          [store-index : i64
            (opt-ctor-fwd-find-store instrs gep-index copy-index gep-dst)]
          (if (< store-index 0)
            -1
            (let
              [width : i64
                (match (ir.compiler-ir-instr-seq-ref instrs store-index)
                  [(ir.CompilerIrInstr.StorePtr _ _ ty)
                    (opt-ctor-fwd-store-byte-size ty)]
                  [_ -1])]
              (if (or (<= width 0) (> (+ offset width) size))
                -1
                store-index))))])))

;; Walk every gep off the temp inside the window. Returns the index of the
;; earliest retargeted store, or -1 when the site is disqualified (clauses 1
;; and 4).
(define (opt-ctor-fwd-scan-geps
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [copy-index : i64]
  [addr-index : i64]
  [temp : i64]
  [size : i64]) : i64
  (let
    [ok : bool true]
    [gep-count : i64 0]
    [first-store : i64 copy-index]
    [i : i64 (+ addr-index 1)]
    (begin
      (while (and ok (< i copy-index))
        (begin
          (if (>=
            (opt-ctor-fwd-gep-offset
              (ir.compiler-ir-instr-seq-ref instrs i)
              temp)
            0)
            (let
              [store-index : i64
                (opt-ctor-fwd-gep-store-index
                  instrs
                  uses
                  copy-index
                  temp
                  size
                  i)]
              (begin
                (set! gep-count (+ gep-count 1))
                (if (< store-index 0)
                  (set! ok false)
                  (if (< store-index first-store)
                    (set! first-store store-index)
                    unit))))
            unit)
          (set! i (+ i 1))))
      (if (= gep-count 0)
        (set! ok false)
        unit)
      (if (not (= (opt-ctor-fwd-use-count uses temp) (+ gep-count 1)))
        (set! ok false)
        unit)
      (if ok
        first-store
        -1))))

(define (opt-ctor-fwd-store-into-temp?
  [instrs : ir.CompilerIrInstrSeq]
  [addr-index : i64]
  [index : i64]
  [temp : i64]) : bool
  (match (ir.compiler-ir-instr-seq-ref instrs index)
    [(ir.CompilerIrInstr.StorePtr ptr _ _)
      (match ptr
        [(ir.CompilerIrValue.Var ptr-var)
          (>=
            (opt-ctor-fwd-same-base-offset
              instrs
              addr-index
              (- index 1)
              temp
              ptr-var)
            0)]
        [_ false])]
    [_ false]))

;; Clause (2): every instruction from the first retargeted store to the copy is
;; harmless with respect to the destination bytes.
(define (opt-ctor-fwd-window-ok?
  [instrs : ir.CompilerIrInstrSeq]
  [addr-index : i64]
  [first-store : i64]
  [copy-index : i64]
  [temp : i64]
  [dest-base : i64]
  [dest-off : i64]
  [size : i64]) : bool
  (let
    [ok : bool true]
    [i : i64 first-store]
    (begin
      (while (and ok (< i copy-index))
        (begin
          (unless
            (or
              (>=
                (opt-ctor-fwd-gep-offset
                  (ir.compiler-ir-instr-seq-ref instrs i)
                  temp)
                0)
              (opt-ctor-fwd-store-into-temp? instrs addr-index i temp)
              (opt-ctor-fwd-window-instr-ok?
                instrs
                addr-index
                i
                dest-base
                dest-off
                size))
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

;; Record the rewrite: rebase each field gep onto the destination base and drop
;; the copy.
(define (opt-ctor-fwd-commit
  [instrs : ir.CompilerIrInstrSeq]
  [plan : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array i64)]
  [addr-index : i64]
  [copy-index : i64]
  [temp : i64]
  [dest-base : i64]
  [dest-off : i64]) : unit
  (let
    [i : i64 (+ addr-index 1)]
    (begin
      (while (< i copy-index)
        (let
          [offset : i64
            (opt-ctor-fwd-gep-offset
              (ir.compiler-ir-instr-seq-ref instrs i)
              temp)]
          (begin
            (if (>= offset 0)
              (begin
                (set! (array-ref plan i) (+ dest-off offset))
                (set! (array-ref bases i) dest-base))
              unit)
            (set! i (+ i 1)))))
      (set! (array-ref plan copy-index) -2))))

(define (opt-ctor-fwd-try-site
  [instrs : ir.CompilerIrInstrSeq]
  [uses : (__tl_dyn-array i64)]
  [copy-index : i64]
  [dest-value : ir.CompilerIrValue]
  [temp : i64]
  [size : i64]
  [result-var : i64]
  [plan : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array i64)]) : bool
  (if (and
    (>= result-var 0)
    (not (= (opt-ctor-fwd-use-count uses result-var) 0)))
    false
    (let
      [addr-index : i64
        (opt-ctor-fwd-find-addr-of instrs (- copy-index 1) temp)]
      ;; Clause (1), second-pointer half: the frame slot the matched `addr_of`
      ;; reads must have exactly ONE use in the whole function -- that
      ;; `addr_of`. A second `addr_of` of the same slot would hand out an
      ;; independent pointer to `T`, and writes through it would be silently
      ;; dropped when the copy is deleted (the "uncovered bytes are only
      ;; padding" argument assumes `T` holds nothing but our own stores).
      [slot : i64
        (if (< addr-index 0)
          -1
          (opt-ctor-fwd-addr-of-slot
            (ir.compiler-ir-instr-seq-ref instrs addr-index)))]
      (if (or
        (< addr-index 0)
        (< slot 0)
        (not (= (opt-ctor-fwd-use-count uses slot) 1)))
        false
        (match (opt-ctor-fwd-resolve-dest instrs copy-index dest-value)
          [(OptCtorFwdDest.NoDest) false]
          [(OptCtorFwdDest.Dest dest-base dest-off dest-def)
            (let
              [guard-lo : i64
                (if (and (>= dest-def 0) (< dest-def addr-index))
                  dest-def
                  addr-index)]
              (if (or
                (= dest-base temp)
                (opt-ctor-fwd-defined-in-range?
                  instrs
                  guard-lo
                  copy-index
                  dest-base))
                false
                (let
                  [first-store : i64
                    (opt-ctor-fwd-scan-geps
                      instrs
                      uses
                      copy-index
                      addr-index
                      temp
                      size)]
                  (if (or (< first-store 0) (>= first-store copy-index))
                    false
                    (if (opt-ctor-fwd-window-ok?
                      instrs
                      addr-index
                      first-store
                      copy-index
                      temp
                      dest-base
                      dest-off
                      size)
                      (begin
                        (opt-ctor-fwd-commit
                          instrs
                          plan
                          bases
                          addr-index
                          copy-index
                          temp
                          dest-base
                          dest-off)
                        true)
                      false)))))])))))

;; Dense forward rebuild of a planned block: plan action -2 drops the instr,
;; an action >= 0 replaces it with the forwarded `gep base, action : u8`, and
;; anything else keeps the instr -- the same output the old backward cons walk
;; produced, in the same program order, without a cons spine or the re-counting
;; `compiler-ir-block` wrapper. refs #5726
(define (opt-ctor-fwd-rewrite-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [plan : (__tl_dyn-array i64)]
  [bases : (__tl_dyn-array i64)]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (let
          [action : i64 (array-ref plan index)]
          [instr : ir.CompilerIrInstr
            (ir.compiler-ir-instr-seq-ref instrs index)]
          (begin
            (cond
              [(= action -2) unit]
              [(>= action 0)
                (ir.compiler-ir-instr-builder-push!
                  (&mut builder)
                  (ir.CompilerIrInstr.Gep
                    (opt-ctor-fwd-gep-dst instr)
                    (ir.CompilerIrValue.Var (array-ref bases index))
                    (ir.CompilerIrValue.I64 action)
                    (ast.AstType.U8)))]
              [else (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])
            (set! index (+ index 1)))))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-ctor-fwd-block
  [uses : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (not (opt-ctor-fwd-block-candidate? instrs))
        block
        (let
          [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
          [plan : (__tl_dyn-array i64) (array.make-array i64 count)]
          [bases : (__tl_dyn-array i64) (array.make-array i64 count)]
          [changed : bool false]
          [i : i64 0]
          (begin
            (while (< i count)
              (begin
                (set! (array-ref plan i) -1)
                (set! (array-ref bases i) 0)
                (set! i (+ i 1))))
            (set! i 0)
            (while (< i count)
              (begin
                (match (opt-ctor-fwd-match-copy
                  (ir.compiler-ir-instr-seq-ref instrs i))
                  [(OptCtorFwdCopy.Copy dest-value temp size result-var)
                    (if (opt-ctor-fwd-try-site
                      instrs
                      uses
                      i
                      dest-value
                      temp
                      size
                      result-var
                      plan
                      bases)
                      (set! changed true)
                      unit)]
                  [(OptCtorFwdCopy.NoCopy) unit])
                (set! i (+ i 1))))
            (if changed
              (ir.CompilerIrBlock.Block
                label
                (opt-ctor-fwd-rewrite-instr-seq instrs plan bases))
              block))))]))

(define (opt-ctor-fwd-blocks
  [uses : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-ctor-fwd-block uses block)
        (opt-ctor-fwd-blocks uses (__tl-box-place rest)))]
    ;; Dense driver: scan the block sequence in place and write a dense output
    ;; sequence (refs #5726). opt-ctor-fwd-block returns the ORIGINAL block by
    ;; reference for blocks it does not rewrite, so unchanged blocks are never
    ;; re-sequenced.
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (set!
                (array-ref slots index)
                (opt-ctor-fwd-block
                  uses
                  (ir.compiler-ir-block-seq-ref seq index)))
              (set! index (+ index 1))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count))))]))

(define (opt-ctor-fwd-function-blocks
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (not (opt-ctor-fwd-blocks-have-candidate? blocks))
    blocks
    (opt-ctor-fwd-blocks (opt-collect-blocks-uses-array frame blocks) blocks)))

;; --- unsigned loop-bound narrowing -------------------------------------------
;;
;; A scanner loop whose index advances by a DIFFERENT amount on each path --
;; `while (i < n) { c = buf[i]; ...; i = <token end> }` -- carries a bounds
;; check the whole loop-versioning family cannot reach. Every derivation there
;; needs the counter's progression (a literal step, a trip count), and this
;; index has none: its back-edge value is a phi of token ends, several of them
;; call results. The dominating-comparison fold cannot reach it either. The
;; check is `i <u len`; the loop test gives `i <s n`; nothing relates `n` to
;; `len`, and nothing proves `i >= 0` for an index that is REASSIGNED rather
;; than incremented.
;;
;; The observation that discharges it needs neither fact separately. For any
;; `i`, with `n >= 0` and `len >= 0`,
;;
;;     i <u min(n, len)   <=>   (i <s n) AND (i <u len)
;;
;; -- the unsigned compare against the SMALLER bound decides the loop test and
;; the bounds check at once. (=>) `min(n, len)` is a nonnegative i64, so
;; `i <u min` forces `0 <= i < min`, which is below both bounds, and a
;; nonnegative `i` compares the same way signed and unsigned. (<=) `i <u len`
;; with a container length `len < 2^63` forces `0 <= i < len`; with `i <s n`
;; and `i >= 0` that puts `i` below `min` as an unsigned value too.
;;
;; So the loop test is retargeted at `m = min(n, len)` in the UNSIGNED domain
;; and the header's check is deleted. The two tests the original ran per
;; iteration -- one signed loop compare, one unsigned bounds compare -- become
;; one unsigned compare. `m` is computed once, in the preheader.
;;
;; TRAP PARITY carries the transformation. The rewritten test EXITS on exactly
;; the inputs where the original entered the body and aborted: the values with
;; `i <s n` and NOT `i <u len`. So the loop's new exit edge re-tests `i <s n`
;; and, on its true side, runs the SAME `bounds_check i, len` the header used
;; to run -- same operands, same abort label, and provably failing, since the
;; equivalence above says a value arriving there with `i <s n` cannot satisfy
;; `i <u len`. Nothing observable ran between the header's entry and its check
;; (the check is required to be the FIRST instruction after the phi prefix), so
;; the abort moves from one iteration boundary to the other with no intervening
;; effect. The preheader edge is handled the same way and more simply: the loop
;; is entered only where `seed <s n` already holds, so the header's first check
;; is unconditional there and moves verbatim into the preheader.
;;
;; What the shape must supply:
;;
;;   * a two-predecessor header: a preheader that JUMPS to it, and a latch that
;;     BRANCHES to it on the true side of `back <s n`;
;;   * the checked index is a header phi seeded by a NONNEGATIVE LITERAL from
;;     the preheader and carrying `back` from the latch. The phi's value is
;;     never inspected, only its two incoming edges -- which is what admits an
;;     index no induction analysis can describe;
;;   * `n` invariant, and the preheader entered only through a dominating
;;     `seed <s n`. That is what makes `n > seed >= 0` where `m` is built, so
;;     `min(n, len)` needs no clamp -- an unclamped negative `m` would read as
;;     a huge unsigned bound and let the loop run on;
;;   * `len` a container length-slot load (or a nonnegative literal), which is
;;     where the `len >= 0` half of the equivalence comes from;
;;   * the latch compare read ONLY by the latch branch, so retyping it in place
;;     cannot change another reader's meaning.
;;
;; One site per function per run. The pipeline's second iteration picks up a
;; second loop, and the rewrite is not self-applicable: the header it leaves
;; behind has no check, and the join block it introduces is entered from its
;; preheader on a branch's FALSE side (and checks a literal), so neither can be
;; mistaken for a fresh candidate.
(defstruct OptUboundSite
  (header i64)
  (latch i64)
  (pre i64)
  (exit i64)
  ;; The phi's preheader input: a nonnegative literal, re-checked in the
  ;; preheader against `len` exactly as the header did.
  (seed i64)
  (len ir.CompilerIrValue)
  (bound ir.CompilerIrValue)
  (back i64)
  (cmp i64)
  ;; Abort label of the deleted header check, reused by the exit-edge check so
  ;; the trap keeps its site identity.
  (ok i64))

(defenum OptUboundMaybeSite
  (No)
  (Some OptUboundSite))

(defenum OptUboundMaybePair
  (No)
  (Some i64 i64))

;; The checked phi's two edges: the nonnegative literal seed and the latch var.
(defenum OptUboundMaybeEdges
  (No)
  (Some i64 i64))

;; `bounds_check iphi, len` with its abort label.
(defenum OptUboundMaybeCheck
  (No)
  (Some i64 ir.CompilerIrValue i64))

;; The latch's compare var, its left operand, the bound, and the exit label.
(defenum OptUboundMaybeLatch
  (No)
  (Some i64 i64 ir.CompilerIrValue i64))

;; Predecessors of `id`, exactly two, in CFG edge order.
(define (opt-ubound-pred-pair [index : OptCfgIndex] [id : i64]) : OptUboundMaybePair
  (let
    [preds : OptCfgCsr index.preds]
    [offsets : (__tl_dyn-array i64) preds.offsets]
    [edges : (__tl_dyn-array i64) preds.edges]
    (if (or (< id 0) (>= (+ id 1) (array-length offsets)))
      (OptUboundMaybePair.No)
      (let
        [start : i64 (array-ref offsets id)]
        [end : i64 (array-ref offsets (+ id 1))]
        (if (= (- end start) 2)
          (OptUboundMaybePair.Some
            (array-ref edges start)
            (array-ref edges (+ start 1)))
          (OptUboundMaybePair.No))))))

;; The single predecessor of `id`, or -1.
(define (opt-ubound-sole-pred [index : OptCfgIndex] [id : i64]) : i64
  (let
    [preds : OptCfgCsr index.preds]
    [offsets : (__tl_dyn-array i64) preds.offsets]
    [edges : (__tl_dyn-array i64) preds.edges]
    (if (or (< id 0) (>= (+ id 1) (array-length offsets)))
      (- 0 1)
      (let
        [start : i64 (array-ref offsets id)]
        [end : i64 (array-ref offsets (+ id 1))]
        (if (= (- end start) 1)
          (array-ref edges start)
          (- 0 1))))))

(define (opt-ubound-block-instrs [block : ir.CompilerIrBlock]) : ir.CompilerIrInstrSeq
  (match block
    [(ir.CompilerIrBlock.Block _ instrs) instrs]))

;; A length operand whose value is provably nonnegative: a nonnegative literal,
;; or a load out of a container's length slot. The second is the shape the
;; lowering emits for every array/vector/string length, and it is where the
;; `len >= 0` half of the equivalence comes from.
(define (opt-ubound-len-nonneg?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [len : ir.CompilerIrValue]) : bool
  (match len
    [(ir.CompilerIrValue.I64 literal) (>= literal 0)]
    [(ir.CompilerIrValue.Var var)
      (match (opt-bce-mb-find-def blocks var)
        [(OptBceMbMaybeInstr.No) false]
        [(OptBceMbMaybeInstr.Some instr)
          (match instr
            [(ir.CompilerIrInstr.Load _ source _)
              (match source
                [(ir.CompilerIrValue.Var slot)
                  (match (opt-bce-mb-find-def blocks slot)
                    [(OptBceMbMaybeInstr.No) false]
                    [(OptBceMbMaybeInstr.Some slot-instr)
                      (match slot-instr
                        [(ir.CompilerIrInstr.Gep _ _ offset ty)
                          (opt-bounds-object-length-slot?
                            type-segment-bases
                            offset
                            ty)]
                        [_ false])])]
                [_ false])]
            [_ false])])]
    [_ false]))

;; The header's own contribution: `bounds_check iphi, len` as the FIRST
;; instruction after the phi prefix (nothing observable may precede the abort
;; the exit edge inherits), with the index a var defined by a phi in that
;; prefix.
(define (opt-ubound-header-check
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]) : OptUboundMaybeCheck
  (if (>= phi-count (ir.compiler-ir-instr-seq-count instrs))
    (OptUboundMaybeCheck.No)
    (match (ir.compiler-ir-instr-seq-ref instrs phi-count)
      [(ir.CompilerIrInstr.BoundsCheck idx len ok)
        (match idx
          [(ir.CompilerIrValue.Var iphi) (OptUboundMaybeCheck.Some iphi len ok)]
          [_ (OptUboundMaybeCheck.No)])]
      [_ (OptUboundMaybeCheck.No)])))

(define (opt-ubound-phi-edge-values
  [seed : ir.CompilerIrValue]
  [back : ir.CompilerIrValue]) : OptUboundMaybeEdges
  (match seed
    [(ir.CompilerIrValue.I64 literal)
      (if (< literal 0)
        (OptUboundMaybeEdges.No)
        (match back
          [(ir.CompilerIrValue.Var var) (OptUboundMaybeEdges.Some literal var)]
          [_ (OptUboundMaybeEdges.No)]))]
    [_ (OptUboundMaybeEdges.No)]))

;; Exactly two inputs, one per loop edge, in either written order.
(define (opt-ubound-phi-edges
  [inputs : ir.CompilerIrPhiInputList]
  [pre-label : i64]
  [latch-label : i64]) : OptUboundMaybeEdges
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (OptUboundMaybeEdges.No)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-ubound-phi-edges
        (ir.compiler-ir-phi-input-seq-to-list seq)
        pre-label
        latch-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (match (ir.compiler-ir-phi-input-list-force-cons (__tl-box-place rest))
        [(ir.CompilerIrPhiInputList.Cons value2 label2 rest2)
          (match (ir.compiler-ir-phi-input-list-force-cons
            (__tl-box-place rest2))
            [(ir.CompilerIrPhiInputList.Nil)
              (if (and (= label pre-label) (= label2 latch-label))
                (opt-ubound-phi-edge-values value value2)
                (if (and (= label2 pre-label) (= label latch-label))
                  (opt-ubound-phi-edge-values value2 value)
                  (OptUboundMaybeEdges.No)))]
            [_ (OptUboundMaybeEdges.No)])]
        [_ (OptUboundMaybeEdges.No)])]))

;; Find the phi defining `var` inside the prefix and return its two edges.
(define (opt-ubound-header-edges
  [instrs : ir.CompilerIrInstrSeq]
  [phi-count : i64]
  [pos : i64]
  [var : i64]
  [pre-label : i64]
  [latch-label : i64]) : OptUboundMaybeEdges
  (if (>= pos phi-count)
    (OptUboundMaybeEdges.No)
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.Phi dst inputs ty)
        (if (and (= dst var) (opt-integer-type? ty))
          (opt-ubound-phi-edges inputs pre-label latch-label)
          (opt-ubound-header-edges
            instrs
            phi-count
            (+ pos 1)
            var
            pre-label
            latch-label))]
      [_
        (opt-ubound-header-edges
          instrs
          phi-count
          (+ pos 1)
          var
          pre-label
          latch-label)])))

;; The latch: `cmp = lt back, bound : i64` immediately ahead of
;; `branch cmp, header, exit`.
(define (opt-ubound-latch-shape
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [header-label : i64]) : OptUboundMaybeLatch
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (< count 2)
      (OptUboundMaybeLatch.No)
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Branch cond true-label false-label)
          (if (or
            (not (= true-label header-label))
            (= false-label header-label))
            (OptUboundMaybeLatch.No)
            (match cond
              [(ir.CompilerIrValue.Var cond-var)
                (match (ir.compiler-ir-instr-seq-ref instrs (- count 2))
                  [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
                    (if (and
                      (= dst cond-var)
                      (opt-binop-eq op (ir.CompilerIrBinOp.Lt))
                      (opt-type-eq type-segment-bases ty (ast.AstType.I64)))
                      (match lhs
                        [(ir.CompilerIrValue.Var back)
                          (OptUboundMaybeLatch.Some
                            cond-var
                            back
                            rhs
                            false-label)]
                        [_ (OptUboundMaybeLatch.No)])
                      (OptUboundMaybeLatch.No))]
                  [_ (OptUboundMaybeLatch.No)])]
              [_ (OptUboundMaybeLatch.No)]))]
        [_ (OptUboundMaybeLatch.No)]))))

(define (opt-ubound-pre-terminator?
  [instrs : ir.CompilerIrInstrSeq]
  [header-label : i64]) : bool
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (if (< count 1)
      false
      (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
        [(ir.CompilerIrInstr.Jump target) (= target header-label)]
        [_ false]))))

;; Is the preheader entered only through a dominating `seed <s bound`? Its sole
;; predecessor must branch to it on the true side of exactly that compare. That
;; is what puts `bound > seed >= 0` in force where `m` is built.
(define (opt-ubound-entry-guard?
  [type-segment-bases : i64]
  [index : OptCfgIndex]
  [pre-id : i64]
  [pre-label : i64]
  [seed : i64]
  [bound : ir.CompilerIrValue]) : bool
  (let
    [entry-id : i64 (opt-ubound-sole-pred index pre-id)]
    (if (< entry-id 0)
      false
      (match (opt-cfg-index-block index entry-id)
        [(OptMaybeBlock.No) false]
        [(OptMaybeBlock.Some block)
          (let
            [instrs : ir.CompilerIrInstrSeq (opt-ubound-block-instrs block)]
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 2)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch cond true-label false-label)
                  (and
                    (= true-label pre-label)
                    (not (= false-label pre-label))
                    (match cond
                      [(ir.CompilerIrValue.Var cond-var)
                        (match (ir.compiler-ir-instr-seq-ref instrs (- count 2))
                          [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
                            (and
                              (= dst cond-var)
                              (opt-binop-eq op (ir.CompilerIrBinOp.Lt))
                              (opt-type-eq
                                type-segment-bases
                                ty
                                (ast.AstType.I64))
                              (opt-value-eq lhs (ir.CompilerIrValue.I64 seed))
                              (opt-value-eq rhs bound))]
                          [_ false])]
                      [_ false]))]
                [_ false])))]))))

;; Is `label` already a block label, or already the abort site of some bounds
;; check? Both render into the same per-function assembly label namespace.
(define (opt-ubound-label-taken-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [label : i64]) : bool
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.BoundsCheck _ _ ok)
        (if (= ok label)
          true
          (opt-ubound-label-taken-seq? instrs (+ pos 1) label))]
      [_ (opt-ubound-label-taken-seq? instrs (+ pos 1) label)])))

(define (opt-ubound-label-taken?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label instrs)
          (or
            (= block-label label)
            (opt-ubound-label-taken-seq? instrs 0 label)
            (opt-ubound-label-taken? (__tl-box-place rest) label))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ubound-label-taken? (ir.compiler-ir-block-seq-to-list seq) label)]))

(define (opt-ubound-candidate-label
  [head : i64]
  [suffix : String]
  [attempt : i64]) : i64
  (ir.compiler-ir-label
    (if (= attempt 0)
      (str_cat.str-cat (ir.compiler-ir-label-text head) suffix)
      (str_cat.str-cat
        (ir.compiler-ir-label-text head)
        suffix
        (string.int->string attempt)))))

(define (opt-ubound-fresh-label
  [blocks : ir.CompilerIrBlockList]
  [head : i64]
  [suffix : String]
  [attempt : i64]) : i64
  (let
    [candidate : i64 (opt-ubound-candidate-label head suffix attempt)]
    (if (opt-ubound-label-taken? blocks candidate)
      (opt-ubound-fresh-label blocks head suffix (+ attempt 1))
      candidate)))

;; --- recognition -------------------------------------------------------------
(define (opt-ubound-site-finish
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [header-label : i64]
  [pre-id : i64]
  [pre-label : i64]
  [latch-label : i64]
  [seed : i64]
  [back : i64]
  [len : ir.CompilerIrValue]
  [ok : i64]
  [latch-instrs : ir.CompilerIrInstrSeq]) : OptUboundMaybeSite
  (match (opt-ubound-latch-shape type-segment-bases latch-instrs header-label)
    [(OptUboundMaybeLatch.No) (OptUboundMaybeSite.No)]
    [(OptUboundMaybeLatch.Some cmp latch-back bound exit-label)
      (if (and
        (= latch-back back)
        (not (= exit-label pre-label))
        (not (= exit-label latch-label))
        (= (opt-bool-branch-use-count uses cmp) 1)
        (opt-ubound-len-nonneg? type-segment-bases blocks len)
        (opt-ubound-entry-guard?
          type-segment-bases
          index
          pre-id
          pre-label
          seed
          bound))
        (OptUboundMaybeSite.Some
          (OptUboundSite
            header-label
            latch-label
            pre-label
            exit-label
            seed
            len
            bound
            back
            cmp
            ok))
        (OptUboundMaybeSite.No))]))

(define (opt-ubound-site-with-preds
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [header-id : i64]
  [pre-id : i64]
  [latch-id : i64]) : OptUboundMaybeSite
  (let
    [header-label : i64 (opt-cfg-index-label index header-id)]
    [pre-label : i64 (opt-cfg-index-label index pre-id)]
    [latch-label : i64 (opt-cfg-index-label index latch-id)]
    (if (or (= pre-id latch-id) (= header-id pre-id) (= header-id latch-id))
      (OptUboundMaybeSite.No)
      (match (opt-cfg-index-block index header-id)
        [(OptMaybeBlock.No) (OptUboundMaybeSite.No)]
        [(OptMaybeBlock.Some header-block)
          (let
            [header-instrs : ir.CompilerIrInstrSeq
              (opt-ubound-block-instrs header-block)]
            [phi-count : i64 (opt-unroll-phi-prefix-count header-instrs 0)]
            (match (opt-ubound-header-check header-instrs phi-count)
              [(OptUboundMaybeCheck.No) (OptUboundMaybeSite.No)]
              [(OptUboundMaybeCheck.Some iphi len ok)
                (match (opt-ubound-header-edges
                  header-instrs
                  phi-count
                  0
                  iphi
                  pre-label
                  latch-label)
                  [(OptUboundMaybeEdges.No) (OptUboundMaybeSite.No)]
                  [(OptUboundMaybeEdges.Some seed back)
                    (match (opt-cfg-index-block index pre-id)
                      [(OptMaybeBlock.No) (OptUboundMaybeSite.No)]
                      [(OptMaybeBlock.Some pre-block)
                        (if (not
                          (opt-ubound-pre-terminator?
                            (opt-ubound-block-instrs pre-block)
                            header-label))
                          (OptUboundMaybeSite.No)
                          (match (opt-cfg-index-block index latch-id)
                            [(OptMaybeBlock.No) (OptUboundMaybeSite.No)]
                            [(OptMaybeBlock.Some latch-block)
                              (opt-ubound-site-finish
                                type-segment-bases
                                blocks
                                index
                                uses
                                header-label
                                pre-id
                                pre-label
                                latch-label
                                seed
                                back
                                len
                                ok
                                (opt-ubound-block-instrs latch-block))]))])])]))]))))

(define (opt-ubound-site-at
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [header-id : i64]) : OptUboundMaybeSite
  (match (opt-ubound-pred-pair index header-id)
    [(OptUboundMaybePair.No) (OptUboundMaybeSite.No)]
    [(OptUboundMaybePair.Some a b)
      (match (opt-ubound-site-with-preds
        type-segment-bases
        blocks
        index
        uses
        header-id
        a
        b)
        [(OptUboundMaybeSite.Some site) (OptUboundMaybeSite.Some site)]
        [(OptUboundMaybeSite.No)
          (opt-ubound-site-with-preds
            type-segment-bases
            blocks
            index
            uses
            header-id
            b
            a)])]))

(define (opt-ubound-find-site
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [index : OptCfgIndex]
  [uses : (__tl_dyn-array i64)]
  [id : i64]) : OptUboundMaybeSite
  (if (>= id (opt-cfg-index-block-count index))
    (OptUboundMaybeSite.No)
    (match (opt-ubound-site-at type-segment-bases blocks index uses id)
      [(OptUboundMaybeSite.Some site) (OptUboundMaybeSite.Some site)]
      [(OptUboundMaybeSite.No)
        (opt-ubound-find-site type-segment-bases blocks index uses (+ id 1))])))

;; --- rewrite -----------------------------------------------------------------
(define (opt-ubound-instr-prefix
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [tail : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (if (< index 0)
    tail
    (opt-ubound-instr-prefix
      instrs
      (- index 1)
      (ir.compiler-ir-instr-cons
        (ir.compiler-ir-instr-seq-ref instrs index)
        tail))))

;; Move a phi's incoming edge (the header's preheader edge now arrives from the
;; join block).
(define (opt-ubound-relabel-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [from-label : i64]
  [to-label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-ubound-relabel-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        from-label
        to-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        value
        (if (= label from-label)
          to-label
          label)
        (opt-ubound-relabel-inputs (__tl-box-place rest) from-label to-label))]))

;; Split a phi's latch edge into the two blocks that now sit on it. The value
;; is the same on both: the trap block is dominated by the check block, which
;; is dominated by the latch, so everything the old edge carried is still in
;; scope.
(define (opt-ubound-split-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [from-label : i64]
  [chk-label : i64]
  [trap-label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) (ir.CompilerIrPhiInputList.Nil)]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-ubound-split-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        from-label
        chk-label
        trap-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (let
        [tail : ir.CompilerIrPhiInputList
          (opt-ubound-split-inputs
            (__tl-box-place rest)
            from-label
            chk-label
            trap-label)]
        (if (= label from-label)
          (ir.compiler-ir-phi-input-cons
            value
            chk-label
            (ir.compiler-ir-phi-input-cons value trap-label tail))
          (ir.compiler-ir-phi-input-cons value label tail)))]))

;; Rebuild a block's instructions with its phi edges remapped and, for the
;; header, its bounds check (at `drop-at`) removed.
(define (opt-ubound-map-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [split? : bool]
  [from-label : i64]
  [first-label : i64]
  [second-label : i64]
  [drop-at : i64]) : ir.CompilerIrInstrList
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrInstrList.Nil)
    (let
      [tail : ir.CompilerIrInstrList
        (opt-ubound-map-instrs
          instrs
          (+ pos 1)
          split?
          from-label
          first-label
          second-label
          drop-at)]
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (if (= pos drop-at)
        tail
        (ir.compiler-ir-instr-cons
          (match instr
            [(ir.CompilerIrInstr.Phi dst inputs ty)
              (ir.CompilerIrInstr.Phi
                dst
                (if split?
                  (opt-ubound-split-inputs
                    inputs
                    from-label
                    first-label
                    second-label)
                  (opt-ubound-relabel-inputs inputs from-label first-label))
                ty)]
            [_ instr])
          tail)))))

;; The preheader keeps everything it computed and gains the smaller-bound
;; compare in place of its jump.
(define (opt-ubound-pre-block
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [bound : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [cmin-var : i64]
  [lo-label : i64]
  [join-label : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    label
    (opt-ubound-instr-prefix
      instrs
      (- (ir.compiler-ir-instr-seq-count instrs) 2)
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.BinOp
          cmin-var
          (ir.CompilerIrBinOp.Lt)
          bound
          len
          (ast.AstType.I64))
        (ir.compiler-ir-instr-cons
          (ir.CompilerIrInstr.Branch
            (ir.CompilerIrValue.Var cmin-var)
            lo-label
            join-label)
          (ir.CompilerIrInstrList.Nil))))))

(define (opt-ubound-lo-block [lo-label : i64] [join-label : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    lo-label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.Jump join-label)
      (ir.CompilerIrInstrList.Nil))))

;; `m = min(bound, len)`, then the header's first check moved verbatim onto the
;; preheader edge, where the entry guard has already made it unconditional.
(define (opt-ubound-join-block
  [join-label : i64]
  [pre-label : i64]
  [lo-label : i64]
  [header-label : i64]
  [bound : ir.CompilerIrValue]
  [len : ir.CompilerIrValue]
  [seed : i64]
  [m-var : i64]
  [seed-ok : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    join-label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.Phi
        m-var
        (ir.compiler-ir-phi-input-cons
          bound
          lo-label
          (ir.compiler-ir-phi-input-cons
            len
            pre-label
            (ir.CompilerIrPhiInputList.Nil)))
        (ast.AstType.I64))
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.BoundsCheck
          (ir.CompilerIrValue.I64 seed)
          len
          seed-ok)
        (ir.compiler-ir-instr-cons
          (ir.CompilerIrInstr.Jump header-label)
          (ir.CompilerIrInstrList.Nil))))))

;; The latch compare is retyped in place: same destination, same left operand,
;; the narrowed bound on the right, and the UNSIGNED domain.
(define (opt-ubound-latch-block
  [label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [cmp : i64]
  [back : i64]
  [m-var : i64]
  [header-label : i64]
  [chk-label : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    label
    (opt-ubound-instr-prefix
      instrs
      (- (ir.compiler-ir-instr-seq-count instrs) 3)
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.BinOp
          cmp
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.Var back)
          (ir.CompilerIrValue.Var m-var)
          (ast.AstType.U64))
        (ir.compiler-ir-instr-cons
          (ir.CompilerIrInstr.Branch
            (ir.CompilerIrValue.Var cmp)
            header-label
            chk-label)
          (ir.CompilerIrInstrList.Nil))))))

;; The exit edge re-tests the signed loop condition: true there means the
;; original would have entered the body, and its check would have failed.
(define (opt-ubound-chk-block
  [chk-label : i64]
  [back : i64]
  [bound : ir.CompilerIrValue]
  [cs-var : i64]
  [trap-label : i64]
  [exit-label : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    chk-label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.BinOp
        cs-var
        (ir.CompilerIrBinOp.Lt)
        (ir.CompilerIrValue.Var back)
        bound
        (ast.AstType.I64))
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.Branch
          (ir.CompilerIrValue.Var cs-var)
          trap-label
          exit-label)
        (ir.CompilerIrInstrList.Nil)))))

(define (opt-ubound-trap-block
  [trap-label : i64]
  [back : i64]
  [len : ir.CompilerIrValue]
  [ok : i64]
  [exit-label : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    trap-label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.BoundsCheck (ir.CompilerIrValue.Var back) len ok)
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.Jump exit-label)
        (ir.CompilerIrInstrList.Nil)))))

(define (opt-ubound-rewrite-blocks
  [remaining : ir.CompilerIrBlockList]
  [site : OptUboundSite]
  [phi-count : i64]
  [lo-label : i64]
  [join-label : i64]
  [chk-label : i64]
  [trap-label : i64]
  [seed-ok : i64]
  [cmin-var : i64]
  [m-var : i64]
  [cs-var : i64]) : ir.CompilerIrBlockList
  (match remaining
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ubound-rewrite-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        site
        phi-count
        lo-label
        join-label
        chk-label
        trap-label
        seed-ok
        cmin-var
        m-var
        cs-var)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [tail : ir.CompilerIrBlockList
              (opt-ubound-rewrite-blocks
                (__tl-box-place rest)
                site
                phi-count
                lo-label
                join-label
                chk-label
                trap-label
                seed-ok
                cmin-var
                m-var
                cs-var)]
            (cond
              [(= label site.pre)
                (ir.compiler-ir-block-cons
                  (opt-ubound-pre-block
                    label
                    instrs
                    site.bound
                    site.len
                    cmin-var
                    lo-label
                    join-label)
                  (ir.compiler-ir-block-cons
                    (opt-ubound-lo-block lo-label join-label)
                    (ir.compiler-ir-block-cons
                      (opt-ubound-join-block
                        join-label
                        site.pre
                        lo-label
                        site.header
                        site.bound
                        site.len
                        site.seed
                        m-var
                        seed-ok)
                      tail)))]
              [(= label site.header)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-ubound-map-instrs
                      instrs
                      0
                      false
                      site.pre
                      join-label
                      join-label
                      phi-count))
                  tail)]
              [(= label site.latch)
                (ir.compiler-ir-block-cons
                  (opt-ubound-latch-block
                    label
                    instrs
                    site.cmp
                    site.back
                    m-var
                    site.header
                    chk-label)
                  (ir.compiler-ir-block-cons
                    (opt-ubound-chk-block
                      chk-label
                      site.back
                      site.bound
                      cs-var
                      trap-label
                      site.exit)
                    (ir.compiler-ir-block-cons
                      (opt-ubound-trap-block
                        trap-label
                        site.back
                        site.len
                        site.ok
                        site.exit)
                      tail)))]
              [(= label site.exit)
                (ir.compiler-ir-block-cons
                  (ir.compiler-ir-block
                    label
                    (opt-ubound-map-instrs
                      instrs
                      0
                      true
                      site.latch
                      chk-label
                      trap-label
                      (- 0 1)))
                  tail)]
              [else (ir.compiler-ir-block-cons block tail)]))])]))

;; New vars: the smaller-bound compare, the narrowed bound, the exit re-test.
(define (opt-ubound-plan-vars) : i64
  3)

(define (opt-ubound-header-candidate? [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [phi-count : i64 (opt-unroll-phi-prefix-count instrs 0)]
    (and
      (> phi-count 0)
      (match (opt-ubound-header-check instrs phi-count)
        [(OptUboundMaybeCheck.No) false]
        [(OptUboundMaybeCheck.Some _ _ _) true]))))

(define (opt-ubound-blocks-have-candidate? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (opt-ubound-header-candidate? instrs)
            (opt-ubound-blocks-have-candidate? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ubound-blocks-have-candidate? (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-ubound-apply
  [name : i64]
  [params : ir.CompilerIrParamList]
  [ret-ty : ast.AstType]
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [site : OptUboundSite]
  [phi-count : i64]) : OptFunctionPassResult
  (let
    [lo-label : i64 (opt-ubound-fresh-label blocks site.pre "__ubound_lo" 0)]
    [join-label : i64
      (opt-ubound-fresh-label blocks site.pre "__ubound_join" 0)]
    [chk-label : i64
      (opt-ubound-fresh-label blocks site.latch "__ubound_exit" 0)]
    [trap-label : i64
      (opt-ubound-fresh-label blocks site.latch "__ubound_trap" 0)]
    [seed-ok : i64 (opt-ubound-fresh-label blocks site.pre "__ubound_ok" 0)]
    [next : ir.CompilerIrFunction
      (ir.CompilerIrFunction.Function
        name
        params
        ret-ty
        (+ frame (opt-ubound-plan-vars))
        (opt-cfg-reachable-block-order
          (opt-ubound-rewrite-blocks
            blocks
            site
            phi-count
            lo-label
            join-label
            chk-label
            trap-label
            seed-ok
            frame
            (+ frame 1)
            (+ frame 2))))]
    (match (opt-verify-function next)
      [(ResultCompilerOptimizeVerify.Ok)
        (OptFunctionPassResult.Result next true)]
      [(ResultCompilerOptimizeVerify.Err _)
        (OptFunctionPassResult.Result
          (ir.CompilerIrFunction.Function name params ret-ty frame blocks)
          false)])))

(define (opt-ubound-function-pass
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (not (opt-ubound-blocks-have-candidate? blocks))
        (OptFunctionPassResult.Result func false)
        (let
          [index : OptCfgIndex (opt-cfg-index-build blocks)]
          [uses : (__tl_dyn-array i64)
            (opt-collect-blocks-uses-array frame blocks)]
          (match (opt-ubound-find-site type-segment-bases blocks index uses 0)
            [(OptUboundMaybeSite.No) (OptFunctionPassResult.Result func false)]
            [(OptUboundMaybeSite.Some site)
              (match (opt-cfg-find-block blocks site.header)
                [(OptMaybeBlock.No) (OptFunctionPassResult.Result func false)]
                [(OptMaybeBlock.Some header-block)
                  (opt-ubound-apply
                    name
                    params
                    ret-ty
                    frame
                    blocks
                    site
                    (opt-unroll-phi-prefix-count
                      (opt-ubound-block-instrs header-block)
                      0))])])))]))

(define (optimize-function-once-with-summaries
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [summaries : OptLoopBceSummaries]) : ir.CompilerIrFunction
  (let
    [load-cse-profile : profile_state.CompilerProfileMetrics
      (profile_state.compiler-profile-state-metrics summaries.profile-state)]
    [_t-tailrec : i64 (cfg compile-profile (profile.now-ms) 0)]
    [tailrec : ir.CompilerIrFunction
      (compiler-opt-debug-observe-function
        type-segment-bases
        "tailrec"
        (opt-tailrec-function func))]
    (match tailrec
      [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
        ;; Fold first so SCCP can reuse local facts, then simplify the reachable
        ;; CFG and eliminate dead pure assignments.
        (let
          [_p-tailrec : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                summaries.profile-state
                "tailrec"
                name
                _t-tailrec)
              unit)]
          ;; Substitute proven constant-global operands up front so the local
          ;; folds below see literals: a mask global otherwise keeps its `and`
          ;; alive into the loop cluster, pushing an otherwise-unrollable body
          ;; past the unroll size gate (the opt_crc32 shape). Use positions
          ;; are covered wholesale (BinOp/UnOp/Cast/Bitcast/Mov plus Store and
          ;; StorePtr values and BoundsCheck operands -- see
          ;; opt-const-divisor-rewrite-instr), so a literal global bound also
          ;; constant-enables induction, bce_version, and unrolling below, and
          ;; a descriptor-stored length global forwards as the SAME literal the
          ;; compares see (mixed symbolic/literal state would defeat the
          ;; ctor_fwd equality eliminations). The map is shared with the later
          ;; divisor-targeted rewrite and empty in the common case, which
          ;; makes this a length check per function.
          [const-global-blocks : ir.CompilerIrBlockList
            (opt-const-divisor-rewrite-summary-blocks summaries blocks)]
          [_t-fold : i64 (cfg compile-profile (profile.now-ms) 0)]
          [fold-result : OptBlockListPassResult
            (optimize-block-list-for-function-pass
              load-cse-profile
              pools
              type-segment-bases
              frame
              params
              const-global-blocks)]
          [folded : ir.CompilerIrBlockList
            (compiler-opt-debug-observe-blocks
              type-segment-bases
              "fold"
              name
              params
              ret-ty
              frame
              (match fold-result
                [(OptBlockListPassResult.Result next _) next]))]
          [fold-changed : bool
            (match fold-result
              [(OptBlockListPassResult.Result _ changed) changed])]
          [_p-fold : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                summaries.profile-state
                "fold"
                name
                _t-fold)
              unit)]
          [_t-affine : i64 (cfg compile-profile (profile.now-ms) 0)]
          [affine-candidate? : bool (opt-affine-blocks-have-candidate? folded)]
          [affine-input : ir.CompilerIrBlockList
            (if (and affine-candidate? (not fold-changed))
              (ir.compiler-ir-clone-block-list pools folded)
              folded)]
          [affine : ir.CompilerIrBlockList
            (compiler-opt-debug-observe-blocks
              type-segment-bases
              "affine"
              name
              params
              ret-ty
              frame
              (if affine-candidate?
                (opt-affine-fold-blocks frame affine-input)
                folded))]
          [_p-affine : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                summaries.profile-state
                "affine"
                name
                _t-affine)
              unit)]
          [loop-bce : ir.CompilerIrBlockList
            (if summaries.enabled
              (opt-loop-bce-blocks type-segment-bases summaries params affine)
              affine)]
          [_t-ctor-fwd : i64 (cfg compile-profile (profile.now-ms) 0)]
          [ctor-fwd : ir.CompilerIrBlockList
            (compiler-opt-debug-observe-blocks
              type-segment-bases
              "ctor_fwd"
              name
              params
              ret-ty
              frame
              (opt-ctor-fwd-function-blocks frame loop-bce))]
          [_p-ctor-fwd : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                summaries.profile-state
                "ctor_fwd"
                name
                _t-ctor-fwd)
              unit)]
          [_t-promote : i64 (cfg compile-profile (profile.now-ms) 0)]
          [promoted : ir.CompilerIrFunction
            (compiler-opt-debug-observe-function
              type-segment-bases
              "stack_promote"
              (opt-aggregate-stack-promote-function
                type-segment-bases
                (ir.CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  frame
                  ctor-fwd)))]
          [_p-promote : unit
            (cfg
              compile-profile
              (compiler-opt-profile-pass-finish
                summaries.profile-state
                "stack_promote"
                name
                _t-promote)
              unit)]
          (match promoted
            [(ir.CompilerIrFunction.Function
                _
                _
                _
                promoted-frame
                promoted-blocks)
              ;; Aggregate field-load SROA runs on the post-promotion
              ;; blocks/frame (it leaves the frame unchanged), so the slots stay
              ;; consistent with the later global-GVN pass below.
              (let
                [_t-sroa : i64 (cfg compile-profile (profile.now-ms) 0)]
                [sroa : ir.CompilerIrFunction
                  (compiler-opt-debug-observe-function
                    type-segment-bases
                    "sroa"
                    (opt-aggregate-sroa-function
                      type-segment-bases
                      (ir.CompilerIrFunction.Function
                        name
                        params
                        ret-ty
                        promoted-frame
                        promoted-blocks)))]
                [_p-sroa : unit
                  (cfg
                    compile-profile
                    (compiler-opt-profile-pass-finish
                      summaries.profile-state
                      "sroa"
                      name
                      _t-sroa)
                    unit)]
                (match sroa
                  [(ir.CompilerIrFunction.Function _ _ _ _ sroa-blocks)
                    (let
                      [run-heavy? : bool
                        (<=
                          (ir.compiler-ir-block-list-count sroa-blocks)
                          (opt-heavy-pass-block-limit))]
                      ;; Dominator and natural-loop analyses use the integer CFG
                      ;; index. Their admission decisions are loop-local, so an
                      ;; unrelated block elsewhere in the enclosing function
                      ;; must not turn the loop pipeline off.
                      [_t-rotation : i64
                        (cfg compile-profile (profile.now-ms) 0)]
                      [rotation-result : OptBlockCtxResult
                        (opt-loop-rotation-function-result
                          pools
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            promoted-frame
                            sroa-blocks))]
                      ;; Literal-edge normalization is speculative: keep it
                      ;; only if the exact mutable SIMD rewrite succeeds.
                      [simd-rotation-result : OptBlockCtxResult
                        (opt-loop-rotation-normalized-function-result
                          pools
                          (ir.CompilerIrFunction.Function
                            name
                            params
                            ret-ty
                            promoted-frame
                            sroa-blocks))]
                      [simd-rotated : ir.CompilerIrFunction
                        (ir.CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          promoted-frame
                          (match simd-rotation-result
                            [(OptBlockCtxResult.Result b _ _) b]))]
                      [simd-rotation-context : OptCfgContext
                        (match simd-rotation-result
                          [(OptBlockCtxResult.Result _ ctx _) ctx])]
                      [simd-rotation-context-valid? : bool
                        (match simd-rotation-result
                          [(OptBlockCtxResult.Result _ _ valid) valid])]
                      ;; Rotation exposes the mutable SPMD body before scalar
                      ;; SSA would split its gang counter into phis. Run the
                      ;; dedicated exact-shape unroller here; its later pipeline
                      ;; position remains as a fallback for functions whose SSA
                      ;; construction is intentionally rejected.
                      [simd-result : OptFunctionCtxResult
                        (if simd-rotation-context-valid?
                          (opt-unroll-simd-function-with-context-result
                            type-segment-bases
                            simd-rotation-context
                            simd-rotated
                            true)
                          (OptFunctionCtxResult.Result
                            simd-rotated
                            simd-rotation-context))]
                      ;; A successful SIMD rewrite always allocates fresh
                      ;; destinations; rotation itself leaves the frame alone.
                      [simd-applied? : bool
                        (match simd-result
                          [(OptFunctionCtxResult.Result simd-func _)
                            (match simd-func
                              [(ir.CompilerIrFunction.Function _ _ _ f _)
                                (> f promoted-frame)])])]
                      [rotated : ir.CompilerIrFunction
                        (compiler-opt-debug-observe-function
                          type-segment-bases
                          "rotation"
                          (if simd-applied?
                            (match simd-result
                              [(OptFunctionCtxResult.Result f _) f])
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              promoted-frame
                              (match rotation-result
                                [(OptBlockCtxResult.Result b _ _) b]))))]
                      [rotation-context : OptCfgContext
                        (if simd-applied?
                          (match simd-result
                            [(OptFunctionCtxResult.Result _ ctx) ctx])
                          (match rotation-result
                            [(OptBlockCtxResult.Result _ ctx _) ctx]))]
                      [rotation-context-valid? : bool
                        (if simd-applied?
