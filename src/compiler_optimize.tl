(define (opt-induction-offset-index-gep-blocks
  [step : i64]
  [op : CompilerIrBinOp]
  [offset : i64]) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
