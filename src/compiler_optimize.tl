(define (opt-gvn-single-load-store-forward-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Alloc 0 (AstType.I64))
        (compiler-ir-instr-cons
