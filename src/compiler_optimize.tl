    [word : CompilerIrInstr (IrInstrWord 3 (IrValueVar 2) 0 (AstTyI64))]
    [tail : CompilerIrInstr
      (IrInstrTailCallIndirect
        (IrValueFunction "tail_target")
        (IrCallArgsNil)
        (AstTyI64))]
    [instrs : CompilerIrInstrList
