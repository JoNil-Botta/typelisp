                          type-segment-bases
                          "bounds_dom"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (if (opt-verify-ok?
                            (opt-verify-function-with-context ssa ssa-context))
                            (opt-bounds-dom-blocks-with-context
                              type-segment-bases
                              ssa-context
                              params
                              ssa-frame
                              gvn)
                            gvn))]
                      [_p-bounds-dom : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "bounds_dom"
                            name
                            _t-bounds-dom)
                          unit)]
                      [_t-sccp : i64 (cfg compile-profile (profile.now-ms) 0)]
                      [sccp-result : OptBlockCtxResult
                        (opt-sccp-blocks-with-context-result-raw
                          type-segment-bases
                          ssa-context
                          params
                          bounds-dom
                          ssa-frame)]
                      [sccp : ir.CompilerIrBlockList
                        (compiler-opt-debug-observe-blocks
                          type-segment-bases
                          "sccp"
                          name
                          params
                          ret-ty
                          ssa-frame
                          (match sccp-result
