                              type-segment-bases
                              ssa-context
                              params
                              summaries.call-memory
                              ssa-blocks)
                            ssa-blocks))]
                      [_p-gvn : unit
                        (cfg
                          compile-profile
                          (compiler-opt-profile-pass-finish
                            summaries.profile-state
                            "gvn"
                            name
                            _t-gvn)
                          unit)]
                      ;; Dominated bounds-check dedup rides the same context:
