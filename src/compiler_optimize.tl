          compiler-opt-load-cse-profile-field-key-drops-metric)))))

(cfg
  test
  (test
    compiler-opt-load-cse-profile-job-isolation
    (let
      [left : profile_state.CompilerProfileState
        (profile_state.compiler-profile-state-new)]
      [right : profile_state.CompilerProfileState
        (profile_state.compiler-profile-state-new)]
      [left-metrics : profile_state.CompilerProfileMetrics
        (profile_state.compiler-profile-state-metrics left)]
      [right-metrics : profile_state.CompilerProfileMetrics
        (profile_state.compiler-profile-state-metrics right)]
      (begin
        (compiler-opt-load-cse-profile-reset left)
        (compiler-opt-load-cse-profile-reset right)
        (compiler-opt-load-cse-profile-note-table-size left-metrics 4)
        (compiler-opt-load-cse-profile-note-table-size right-metrics 19)
        (compiler-opt-load-cse-profile-note-table-size left-metrics 7)
        (compiler-opt-load-cse-profile-note-kinds-size left-metrics 6)
        (compiler-opt-load-cse-profile-note-table-cap left-metrics 31)
        (compiler-opt-load-cse-profile-note-kinds-cap left-metrics 29)
        (compiler-opt-load-cse-profile-note-table-cap-hit left-metrics)
        (compiler-opt-load-cse-profile-note-kinds-cap-hit left-metrics)
        (compiler-opt-load-cse-profile-note-field-key-drop left-metrics)
        (compiler-opt-load-cse-profile-reset right)
        (compiler-opt-load-cse-profile-note-field-key-drop right-metrics)
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-max-table-size-metric)
          7
          "left job keeps its table maximum across a right reset")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-max-kinds-size-metric)
          6
          "left job keeps its kinds maximum")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-max-table-cap-metric)
          31
          "left job keeps its table cap")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-max-kinds-cap-metric)
          29
          "left job keeps its kinds cap")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-table-cap-hits-metric)
          1
          "left job keeps its table cap hit count")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-kinds-cap-hits-metric)
          1
          "left job keeps its kinds cap hit count")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            left
            compiler-opt-load-cse-profile-field-key-drops-metric)
          1
          "left job keeps its field-key drop count")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            right
            compiler-opt-load-cse-profile-max-table-size-metric)
          0
          "right reset clears only the right maximum")
        (test.assert-i64-eq
          (profile_state.compiler-profile-state-metric-value
            right
            compiler-opt-load-cse-profile-field-key-drops-metric)
          1
          "right job restarts its own drop count")))))

(cfg
  compile-profile
  (define (compiler-opt-profile-start
    [state : profile_state.CompilerProfileState]) : unit
    (begin
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-opt-profile-start-ms-metric
        (profile.now-ms))
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-opt-profile-start-total-metric
        (profile.alloc-total))
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-opt-profile-start-live-metric
        (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-opt-profile-finish
    [state : profile_state.CompilerProfileState]
    [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (-
          (profile.alloc-peak)
          (profile_state.compiler-profile-state-metric-value
            state
            compiler-opt-profile-start-live-metric))]
      (io.print-error
        (str_cat.str-cat
          "compile-profile|optimize."
          phase
          (compiler-opt-profile-field
            (-
              end-ms
              (profile_state.compiler-profile-state-metric-value
                state
                compiler-opt-profile-start-ms-metric)))
          (compiler-opt-profile-field
            (-
              end-total
              (profile_state.compiler-profile-state-metric-value
                state
                compiler-opt-profile-start-total-metric)))
          (compiler-opt-profile-field
            (-
              end-live
              (profile_state.compiler-profile-state-metric-value
                state
                compiler-opt-profile-start-live-metric)))
          (compiler-opt-profile-field peak-delta)
          "\n")))))

(cfg
  compile-profile
  (define (compiler-opt-profile-detail-start
    [state : profile_state.CompilerProfileState]) : unit
    (profile_state.compiler-profile-state-metric-set!
      state
      compiler-opt-profile-detail-start-ms-metric
      (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-opt-profile-detail-finish
    [state : profile_state.CompilerProfileState]
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (-
          (profile.now-ms)
          (profile_state.compiler-profile-state-metric-value
            state
            compiler-opt-profile-detail-start-ms-metric))]
      (cfg
        compile-profile-summary
        (if (string.eq phase "function")
          (begin
            (cps.compiler-profile-summary-note!
              state
              cps.compiler-profile-summary-optimizer-function
              name
              elapsed)
            (cps.compiler-profile-summary-note-module!
              state
              cps.compiler-profile-summary-optimizer-module
              name
              elapsed))
          unit)
        (if (>= elapsed 1)
          (io.print-error
            (str_cat.str-cat
              "compile-profile-detail|optimize."
              phase
              "|"
              (string.int->string elapsed)
              "|"
              name
              "\n"))
          unit)))))

(cfg
  compile-profile
  (define (compiler-opt-profile-pass-finish
    [state : profile_state.CompilerProfileState]
    [pass : String]
    [name : i64]
    [start-ms : i64]) : unit
    (let
      [elapsed : i64 (- (profile.now-ms) start-ms)]
      (cfg
        compile-profile-summary
        (cps.compiler-profile-summary-note!
          state
          cps.compiler-profile-summary-optimizer-pass
          pass
          elapsed)
        (if (>= elapsed 1)
          (io.print-error
            (str_cat.str-cat
              "compile-profile-detail|optimize.pass."
              pass
              "|"
              (string.int->string elapsed)
              "|"
              (ir.compiler-ir-symbol-text name)
              "\n"))
          unit)))))

(cfg
  compile-profile
  (define (compiler-opt-profile-escape-finish
    [phase : String]
    [level : i64]
    [name : String]
    [start-ms : i64]) : unit
    (let
      [elapsed : i64 (- (profile.now-ms) start-ms)]
      (cfg
        compile-profile-summary
        unit
        (io.print-error
          (str_cat.str-cat
            "compile-profile-detail|optimize.escape."
            phase
            "|"
            (string.int->string elapsed)
            "|"
            (string.int->string level)
            "|"
            name
            "\n"))))))

(cfg
  compile-profile
  (define (compiler-opt-profile-function-name [func : ir.CompilerIrFunction]) : String
    (match func
      [(ir.CompilerIrFunction.Function name _ _ _ _)
        (ir.compiler-ir-symbol-text name)])))

(define (compiler-optimize-default-level) : i64
  compiler-optimize-level-default)

(define (compiler-optimize-level-valid? [level : i64]) : bool
  (and (>= level 0) (<= level 2)))

(define (compiler-optimize-parse-level [value : String]) : ResultCompilerOptimizeLevel
  (if (= (string.string-length value) 1)
    (let
      [c : char (string.string-ref value 0)]
      (if (or (= c '0') (= c '1') (= c '2'))
        (ResultCompilerOptimizeLevel.Ok (string.>int value))
        (ResultCompilerOptimizeLevel.Err)))
    (ResultCompilerOptimizeLevel.Err)))

;; --- block-local constant environment: IR var id -> known typed scalar -------
(defenum OptMaybeBool
  (No)
  (Some bool))

(defenum OptKnownConst
  (NoConst)
  (SomeConst ir.CompilerIrValue ast.AstType))

;; The const env is threaded linearly through a single block's fold/strength
;; passes (each block starts fresh at `OptConstEnv.Nil`); it is never forked or
;; reused across blocks. So bind/unbind only ever extend the most recent env.
;; We exploit that: the newest entry for a var always shadows older ones, so
;; `bind` and `unbind` just PREPEND (O(1)) instead of rebuilding the whole list
;; to remove the prior entry (the old O(n)-per-instruction copy made folding a
;; single large block O(n^2) in both time and allocation -- e.g. a function that
;; is one giant `str-cat` lowers to a long `string-append` call chain, and each
;; call's `opt-invalidate-def` rebuilt the entire env). `OptConstEnv.Shadow` records
;; "this var is no longer a known constant" so lookup stops at it.
(defenum OptConstEnv
  (Nil)
  (Cons i64 ir.CompilerIrValue ast.AstType (Box OptConstEnv))
  (Shadow i64 (Box OptConstEnv)))

(define (opt-const-unbind [env : OptConstEnv] [var : i64]) : OptConstEnv
  (OptConstEnv.Shadow var (box env)))

(define (opt-const-bind
  [env : OptConstEnv]
  [var : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptConstEnv
  (OptConstEnv.Cons var value ty (box env)))

(define (opt-const-lookup [env : OptConstEnv] [var : i64]) : OptKnownConst
  (match env
    [(OptConstEnv.Nil) (OptKnownConst.NoConst)]
    [(OptConstEnv.Cons id value ty rest)
      (if (= id var)
        (OptKnownConst.SomeConst value ty)
        (opt-const-lookup (__tl-box-place rest) var))]
    [(OptConstEnv.Shadow id rest)
      (if (= id var)
        (OptKnownConst.NoConst)
        (opt-const-lookup (__tl-box-place rest) var))]))

(define (opt-integer-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [_ false]))

(define (opt-signed-integer-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [_ false]))

(define (opt-unsigned-integer-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [_ false]))

(define (opt-int-or-char-type? [ty : ast.AstType]) : bool
  (if (opt-integer-type? ty)
    true
    (match ty
      [(ast.AstType.Char) true]
      [_ false])))

(define (opt-bool-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Bool) true]
    [_ false]))

(define (opt-float-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [_ false]))

(define (opt-int-width [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 64]
    [(ast.AstType.U64) 64]
    [(ast.AstType.I32) 32]
    [(ast.AstType.U32) 32]
    [(ast.AstType.I16) 16]
    [(ast.AstType.U16) 16]
    [(ast.AstType.I8) 8]
    [(ast.AstType.U8) 8]
    [(ast.AstType.Char) 8]
    [_ 0]))

(define (opt-int-sign-class [ty : ast.AstType]) : i64
  (if (opt-signed-integer-type? ty)
    1
    (if (or
      (opt-unsigned-integer-type? ty)
      (match ty
        [(ast.AstType.Char) true]
        [_ false]))
      2
      0)))

(define (opt-int-cast-as-mov? [from-ty : ast.AstType] [to-ty : ast.AstType]) : bool
  (if (and (opt-int-or-char-type? from-ty) (opt-int-or-char-type? to-ty))
    (let
      [from-width : i64 (opt-int-width from-ty)]
      [to-width : i64 (opt-int-width to-ty)]
      ;; Keep same-width signedness changes as casts; they preserve operator
      ;; type context for cases like `(shr (cast x : u64) ...)`.
      (or
        (< to-width from-width)
        (and
          (= to-width from-width)
          (= (opt-int-sign-class from-ty) (opt-int-sign-class to-ty)))))
    false))

(define (opt-value-to-i64 [value : ir.CompilerIrValue]) : option_i64.Option
  (match value
    [(ir.CompilerIrValue.I64 n) (option_i64.Some n)]
    [(ir.CompilerIrValue.Char c) (option_i64.Some (cast c : i64))]
    [_ (option_i64.None)]))

(define (opt-value-to-bool [value : ir.CompilerIrValue]) : OptMaybeBool
  (match value
    [(ir.CompilerIrValue.Bool b) (OptMaybeBool.Some b)]
    [_ (OptMaybeBool.No)]))

(define (opt-float-round-for-type [value : f64] [ty : ast.AstType]) : f64
  (match ty
    [(ast.AstType.F32) (cfloat.compiler-float-round-f32-as-f64 value)]
    [_ value]))

(define (opt-value-to-f64 [value : ir.CompilerIrValue] [ty : ast.AstType]) : cfloat.CompilerFloatMaybeF64
  (match value
    [(ir.CompilerIrValue.F64 bits)
      (let
        [decoded : f64
          (match ty
            [(ast.AstType.F32) (cfloat.compiler-float-f32-bits-to-f64 bits)]
            [_ (cfloat.compiler-float-f64-from-bits bits)])]
        (if (cfloat.compiler-float-f64-finite? decoded)
          (CompilerFloatSomeF64 decoded)
          (CompilerFloatNoF64)))]
    [_ (CompilerFloatNoF64)]))

(define (opt-f64-to-ir-value [value : f64] [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (let
    [rounded : f64 (opt-float-round-for-type value ty)]
    (if (cfloat.compiler-float-f64-finite? rounded)
      (ir.CompilerIrMaybeValue.Some
        (ir.CompilerIrValue.F64
          (match ty
            [(ast.AstType.F32)
              (cast (cfloat.compiler-float-f32-bits-from-f64 rounded) : u64)]
            [_ (cfloat.compiler-float-f64-bits rounded)])))
      (ir.CompilerIrMaybeValue.No))))

(define (opt-normalize-int-to-i64 [value : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (cast (cast value : i64) : i64)]
    [(ast.AstType.I32) (cast (cast value : i32) : i64)]
    [(ast.AstType.I16) (cast (cast value : i16) : i64)]
    [(ast.AstType.I8) (cast (cast value : i8) : i64)]
    [(ast.AstType.U64) (cast (cast value : u64) : i64)]
    [(ast.AstType.U32) (cast (cast value : u32) : i64)]
    [(ast.AstType.U16) (cast (cast value : u16) : i64)]
    [(ast.AstType.U8) (cast (cast value : u8) : i64)]
    [(ast.AstType.Char) (cast (cast value : char) : i64)]
    [_ value]))

(define (opt-normalize-const [value : ir.CompilerIrValue] [ty : ast.AstType]) : OptKnownConst
  (if (opt-integer-type? ty)
    (match (opt-value-to-i64 value)
      [(option_i64.Some n)
        (OptKnownConst.SomeConst
          (ir.CompilerIrValue.I64 (opt-normalize-int-to-i64 n ty))
          ty)]
      [(option_i64.None) (OptKnownConst.NoConst)])
    (match ty
      [(ast.AstType.Char)
        (match (opt-value-to-i64 value)
          [(option_i64.Some n)
            (OptKnownConst.SomeConst
              (ir.CompilerIrValue.Char (cast n : char))
              (ast.AstType.Char))]
          [(option_i64.None) (OptKnownConst.NoConst)])]
      [(ast.AstType.Bool)
        (match (opt-value-to-bool value)
          [(OptMaybeBool.Some b)
            (OptKnownConst.SomeConst
              (ir.CompilerIrValue.Bool b)
              (ast.AstType.Bool))]
          [(OptMaybeBool.No) (OptKnownConst.NoConst)])]
      [(ast.AstType.F64)
        (match value
          [(ir.CompilerIrValue.F64 _)
            (OptKnownConst.SomeConst value (ast.AstType.F64))]
          [_ (OptKnownConst.NoConst)])]
      [(ast.AstType.F32)
        (match value
          [(ir.CompilerIrValue.F64 _)
            (OptKnownConst.SomeConst value (ast.AstType.F32))]
          [_ (OptKnownConst.NoConst)])]
      [_ (OptKnownConst.NoConst)])))

(define (opt-const-value? [value : ir.CompilerIrValue] [ty : ast.AstType]) : bool
  (match (opt-normalize-const value ty)
    [(OptKnownConst.SomeConst _ _) true]
    [(OptKnownConst.NoConst) false]))

(define (opt-default-immediate-type
  [value : ir.CompilerIrValue]
  [fallback : ast.AstType]) : ast.AstType
  (match value
    [(ir.CompilerIrValue.I64 _)
      (if (opt-int-or-char-type? fallback)
        fallback
        (ast.AstType.I64))]
    [(ir.CompilerIrValue.Char _) (ast.AstType.Char)]
    [(ir.CompilerIrValue.Bool _) (ast.AstType.Bool)]
    [(ir.CompilerIrValue.F64 _)
      (if (opt-float-type? fallback)
        fallback
        (ast.AstType.F64))]
    [(ir.CompilerIrValue.Unit) (ast.AstType.Unit)]
    [_ fallback]))

(define (opt-resolve-known
  [env : OptConstEnv]
  [value : ir.CompilerIrValue]
  [fallback-ty : ast.AstType]) : OptKnownConst
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (opt-const-lookup env id)
        [(OptKnownConst.SomeConst v ty) (OptKnownConst.SomeConst v ty)]
        [(OptKnownConst.NoConst) (OptKnownConst.NoConst)])]
    [_
      (opt-normalize-const value (opt-default-immediate-type value fallback-ty))]))

(define (opt-resolve-value [env : OptConstEnv] [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (opt-const-lookup env id)
        [(OptKnownConst.SomeConst v _) v]
        [(OptKnownConst.NoConst) value])]
    [_ value]))

;; --- folding rules -----------------------------------------------------------
(define (opt-normalize-scalar-to-i64
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : option_i64.Option
  (if (opt-int-or-char-type? ty)
    (match (opt-value-to-i64 value)
      [(option_i64.Some n) (option_i64.Some (opt-normalize-int-to-i64 n ty))]
      [(option_i64.None) (option_i64.None)])
    (option_i64.None)))

(define (opt-binop-operand-type
  [type-segment-bases : i64]
  [op : ir.CompilerIrBinOp]
  [lhs-ty : ast.AstType]
  [rhs-ty : ast.AstType]
  [result-ty : ast.AstType]) : ast.AstType
  (match op
    [(ir.CompilerIrBinOp.Eq)
      (if (opt-type-eq type-segment-bases lhs-ty (ast.AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (ast.AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (ast.AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(ir.CompilerIrBinOp.Ne)
      (if (opt-type-eq type-segment-bases lhs-ty (ast.AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (ast.AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (ast.AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(ir.CompilerIrBinOp.Lt)
      (if (opt-type-eq type-segment-bases lhs-ty (ast.AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (ast.AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (ast.AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(ir.CompilerIrBinOp.Le)
      (if (opt-type-eq type-segment-bases lhs-ty (ast.AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (ast.AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (ast.AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(ir.CompilerIrBinOp.Gt)
      (if (opt-type-eq type-segment-bases lhs-ty (ast.AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (ast.AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (ast.AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(ir.CompilerIrBinOp.Ge)
      (if (opt-type-eq type-segment-bases lhs-ty (ast.AstType.I64))
        rhs-ty
        (if (and
          (opt-type-eq type-segment-bases lhs-ty (ast.AstType.F64))
          (opt-type-eq type-segment-bases rhs-ty (ast.AstType.F32)))
          rhs-ty
          lhs-ty))]
    [(ir.CompilerIrBinOp.BitAnd) lhs-ty]
    [(ir.CompilerIrBinOp.BitOr) lhs-ty]
    [(ir.CompilerIrBinOp.BitXor) lhs-ty]
    [(ir.CompilerIrBinOp.Shl _) lhs-ty]
    [(ir.CompilerIrBinOp.Shr _) lhs-ty]
    [_ result-ty]))

(define (opt-signed-min [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (- (- 0 9223372036854775807) 1)]
    [(ast.AstType.I32) (- 0 2147483648)]
    [(ast.AstType.I16) (- 0 32768)]
    [(ast.AstType.I8) (- 0 128)]
    [_ 0]))

(define (opt-divmod-valid? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (if (= b 0)
    false
    (if (opt-signed-integer-type? ty)
      (not (and (= a (opt-signed-min ty)) (= b (- 0 1))))
      true)))

(define (opt-fold-div-value [a : i64] [b : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (cast (/ (cast a : i64) (cast b : i64)) : i64)]
    [(ast.AstType.I32) (cast (/ (cast a : i32) (cast b : i32)) : i64)]
    [(ast.AstType.I16) (cast (/ (cast a : i16) (cast b : i16)) : i64)]
    [(ast.AstType.I8) (cast (/ (cast a : i8) (cast b : i8)) : i64)]
    [(ast.AstType.U64) (cast (/ (cast a : u64) (cast b : u64)) : i64)]
    [(ast.AstType.U32) (cast (/ (cast a : u32) (cast b : u32)) : i64)]
    [(ast.AstType.U16) (cast (/ (cast a : u16) (cast b : u16)) : i64)]
    [(ast.AstType.U8) (cast (/ (cast a : u8) (cast b : u8)) : i64)]
    [_ 0]))

(define (opt-fold-mod-value [a : i64] [b : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (cast (% (cast a : i64) (cast b : i64)) : i64)]
    [(ast.AstType.I32) (cast (% (cast a : i32) (cast b : i32)) : i64)]
    [(ast.AstType.I16) (cast (% (cast a : i16) (cast b : i16)) : i64)]
    [(ast.AstType.I8) (cast (% (cast a : i8) (cast b : i8)) : i64)]
    [(ast.AstType.U64) (cast (% (cast a : u64) (cast b : u64)) : i64)]
    [(ast.AstType.U32) (cast (% (cast a : u32) (cast b : u32)) : i64)]
    [(ast.AstType.U16) (cast (% (cast a : u16) (cast b : u16)) : i64)]
    [(ast.AstType.U8) (cast (% (cast a : u8) (cast b : u8)) : i64)]
    [_ 0]))

(define (opt-unsigned-lt? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.U64) (< (cast a : u64) (cast b : u64))]
    [_ (< a b)]))

(define (opt-typed-lt? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (if (opt-unsigned-integer-type? ty)
    (opt-unsigned-lt? a b ty)
    (< a b)))

(define (opt-typed-le? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (or (= a b) (opt-typed-lt? a b ty)))

(define (opt-typed-gt? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (opt-typed-lt? b a ty))

(define (opt-typed-ge? [a : i64] [b : i64] [ty : ast.AstType]) : bool
  (or (= a b) (opt-typed-lt? b a ty)))

(define (opt-fold-compare
  [op : ir.CompilerIrBinOp]
  [a : i64]
  [b : i64]
  [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match op
    [(ir.CompilerIrBinOp.Eq)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (= a b)))]
    [(ir.CompilerIrBinOp.Ne)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (!= a b)))]
    [(ir.CompilerIrBinOp.Lt)
      (ir.CompilerIrMaybeValue.Some
        (ir.CompilerIrValue.Bool (opt-typed-lt? a b ty)))]
    [(ir.CompilerIrBinOp.Le)
      (ir.CompilerIrMaybeValue.Some
        (ir.CompilerIrValue.Bool (opt-typed-le? a b ty)))]
    [(ir.CompilerIrBinOp.Gt)
      (ir.CompilerIrMaybeValue.Some
        (ir.CompilerIrValue.Bool (opt-typed-gt? a b ty)))]
    [(ir.CompilerIrBinOp.Ge)
      (ir.CompilerIrMaybeValue.Some
        (ir.CompilerIrValue.Bool (opt-typed-ge? a b ty)))]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-shift-count-valid?
  [count : i64]
  [count-ty : ast.AstType]
  [width : i64]) : bool
  (if (not (opt-integer-type? count-ty))
    false
    (if (opt-signed-integer-type? count-ty)
      (and (>= count 0) (< count width))
      (match count-ty
        [(ast.AstType.U64) (< (cast count : u64) (cast width : u64))]
        [_ (< count width)]))))

(define (opt-fold-shl-value [a : i64] [count : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (cast (shl (cast a : i64) (cast count : i64)) : i64)]
    [(ast.AstType.I32) (cast (shl (cast a : i32) (cast count : i32)) : i64)]
    [(ast.AstType.I16) (cast (shl (cast a : i16) (cast count : i16)) : i64)]
    [(ast.AstType.I8) (cast (shl (cast a : i8) (cast count : i8)) : i64)]
    [(ast.AstType.U64) (cast (shl (cast a : u64) (cast count : u64)) : i64)]
    [(ast.AstType.U32) (cast (shl (cast a : u32) (cast count : u32)) : i64)]
    [(ast.AstType.U16) (cast (shl (cast a : u16) (cast count : u16)) : i64)]
    [(ast.AstType.U8) (cast (shl (cast a : u8) (cast count : u8)) : i64)]
    [_ 0]))

(define (opt-fold-shr-value [a : i64] [count : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (cast (shr (cast a : i64) (cast count : i64)) : i64)]
    [(ast.AstType.I32) (cast (shr (cast a : i32) (cast count : i32)) : i64)]
    [(ast.AstType.I16) (cast (shr (cast a : i16) (cast count : i16)) : i64)]
    [(ast.AstType.I8) (cast (shr (cast a : i8) (cast count : i8)) : i64)]
    [(ast.AstType.U64) (cast (shr (cast a : u64) (cast count : u64)) : i64)]
    [(ast.AstType.U32) (cast (shr (cast a : u32) (cast count : u32)) : i64)]
    [(ast.AstType.U16) (cast (shr (cast a : u16) (cast count : u16)) : i64)]
    [(ast.AstType.U8) (cast (shr (cast a : u8) (cast count : u8)) : i64)]
    [_ 0]))

(define (opt-fold-shift
  [op : ir.CompilerIrBinOp]
  [a : i64]
  [rhs : ir.CompilerIrValue]
  [rhs-ty : ast.AstType]
  [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match (opt-normalize-scalar-to-i64 rhs rhs-ty)
    [(option_i64.Some count)
      (if (opt-shift-count-valid? count rhs-ty (opt-int-width ty))
        (match op
          [(ir.CompilerIrBinOp.Shl _)
            (ir.CompilerIrMaybeValue.Some
              (ir.CompilerIrValue.I64
                (opt-normalize-int-to-i64 (opt-fold-shl-value a count ty) ty)))]
          [(ir.CompilerIrBinOp.Shr _)
            (ir.CompilerIrMaybeValue.Some
              (ir.CompilerIrValue.I64
                (opt-normalize-int-to-i64 (opt-fold-shr-value a count ty) ty)))]
          [_ (ir.CompilerIrMaybeValue.No)])
        (ir.CompilerIrMaybeValue.No))]
    [(option_i64.None) (ir.CompilerIrMaybeValue.No)]))

(define (opt-fold-int-char-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [operand-ty : ast.AstType]
  [rhs-ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match (opt-normalize-scalar-to-i64 lhs operand-ty)
    [(option_i64.Some a)
      (match op
        [(ir.CompilerIrBinOp.Shl _) (opt-fold-shift op a rhs rhs-ty operand-ty)]
        [(ir.CompilerIrBinOp.Shr _) (opt-fold-shift op a rhs rhs-ty operand-ty)]
        [_
          (match (opt-normalize-scalar-to-i64 rhs operand-ty)
            [(option_i64.Some b)
              (match op
                [(ir.CompilerIrBinOp.Add)
                  (if (opt-integer-type? operand-ty)
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (+ a b) operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.Sub)
                  (if (opt-integer-type? operand-ty)
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (- a b) operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.Mul)
                  (if (opt-integer-type? operand-ty)
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (* a b) operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.Div)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-fold-div-value a b operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.Mod)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-fold-mod-value a b operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.SafeDiv)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-fold-div-value a b operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.SafeMod)
                  (if (and
                    (opt-integer-type? operand-ty)
                    (opt-divmod-valid? a b operand-ty))
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-fold-mod-value a b operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.BitAnd)
                  (if (opt-integer-type? operand-ty)
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (bit-and a b) operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.BitOr)
                  (if (opt-integer-type? operand-ty)
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (bit-or a b) operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.BitXor)
                  (if (opt-integer-type? operand-ty)
                    (ir.CompilerIrMaybeValue.Some
                      (ir.CompilerIrValue.I64
                        (opt-normalize-int-to-i64 (bit-xor a b) operand-ty)))
                    (ir.CompilerIrMaybeValue.No))]
                [(ir.CompilerIrBinOp.Eq) (opt-fold-compare op a b operand-ty)]
                [(ir.CompilerIrBinOp.Ne) (opt-fold-compare op a b operand-ty)]
                [(ir.CompilerIrBinOp.Lt) (opt-fold-compare op a b operand-ty)]
                [(ir.CompilerIrBinOp.Le) (opt-fold-compare op a b operand-ty)]
                [(ir.CompilerIrBinOp.Gt) (opt-fold-compare op a b operand-ty)]
                [(ir.CompilerIrBinOp.Ge) (opt-fold-compare op a b operand-ty)]
                [(ir.CompilerIrBinOp.BitTestEq)
                  (ir.CompilerIrMaybeValue.Some
                    (ir.CompilerIrValue.Bool (= (bit-and a b) 0)))]
                [(ir.CompilerIrBinOp.BitTestNe)
                  (ir.CompilerIrMaybeValue.Some
                    (ir.CompilerIrValue.Bool (!= (bit-and a b) 0)))]
                [_ (ir.CompilerIrMaybeValue.No)])]
            [(option_i64.None) (ir.CompilerIrMaybeValue.No)])])]
    [(option_i64.None) (ir.CompilerIrMaybeValue.No)]))

(define (opt-fold-bool
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match (opt-value-to-bool lhs)
    [(OptMaybeBool.Some a)
      (match (opt-value-to-bool rhs)
        [(OptMaybeBool.Some b)
          (match op
            [(ir.CompilerIrBinOp.And)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (and a b)))]
            [(ir.CompilerIrBinOp.Or)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (or a b)))]
            [(ir.CompilerIrBinOp.Eq)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (= a b)))]
            [(ir.CompilerIrBinOp.Ne)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (!= a b)))]
            [_ (ir.CompilerIrMaybeValue.No)])]
        [(OptMaybeBool.No) (ir.CompilerIrMaybeValue.No)])]
    [(OptMaybeBool.No) (ir.CompilerIrMaybeValue.No)]))

(define (opt-fold-float-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [operand-ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match (opt-value-to-f64 lhs operand-ty)
    [(CompilerFloatSomeF64 a)
      (match (opt-value-to-f64 rhs operand-ty)
        [(CompilerFloatSomeF64 b)
          (match op
            [(ir.CompilerIrBinOp.Add) (opt-f64-to-ir-value (+ a b) operand-ty)]
            [(ir.CompilerIrBinOp.Sub) (opt-f64-to-ir-value (- a b) operand-ty)]
            [(ir.CompilerIrBinOp.Mul) (opt-f64-to-ir-value (* a b) operand-ty)]
            [(ir.CompilerIrBinOp.Div)
              (if (= b 0.0)
                (ir.CompilerIrMaybeValue.No)
                (opt-f64-to-ir-value (/ a b) operand-ty))]
            [(ir.CompilerIrBinOp.SafeDiv)
              (if (= b 0.0)
                (ir.CompilerIrMaybeValue.No)
                (opt-f64-to-ir-value (/ a b) operand-ty))]
            [(ir.CompilerIrBinOp.Eq)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (= a b)))]
            [(ir.CompilerIrBinOp.Ne)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (!= a b)))]
            [(ir.CompilerIrBinOp.Lt)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (< a b)))]
            [(ir.CompilerIrBinOp.Le)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (<= a b)))]
            [(ir.CompilerIrBinOp.Gt)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (> a b)))]
            [(ir.CompilerIrBinOp.Ge)
              (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (>= a b)))]
            [_ (ir.CompilerIrMaybeValue.No)])]
        [(CompilerFloatNoF64) (ir.CompilerIrMaybeValue.No)])]
    [(CompilerFloatNoF64) (ir.CompilerIrMaybeValue.No)]))

(define (opt-finite-cast-input [src : OptKnownConst] [from-ty : ast.AstType]) : cfloat.CompilerFiniteCastInput
  (match src
    [(OptKnownConst.SomeConst value _)
      (match value
        [(ir.CompilerIrValue.I64 n) (CompilerFiniteCastInputI64 n)]
        [(ir.CompilerIrValue.Char c) (CompilerFiniteCastInputChar c)]
        [(ir.CompilerIrValue.F64 bits)
          (match from-ty
            [(ast.AstType.F32)
              (CompilerFiniteCastInputF32
                (cfloat.compiler-float-f32-bits-to-f64 bits))]
            [_
              (CompilerFiniteCastInputF64
                (cfloat.compiler-float-f64-from-bits bits))])]
        [_ (CompilerFiniteCastNoInput)])]
    [(OptKnownConst.NoConst) (CompilerFiniteCastNoInput)]))

(define (opt-finite-cast-result-to-ir
  [result : cfloat.CompilerFiniteCastResult]) : ir.CompilerIrMaybeValue
  (match result
    [(CompilerFiniteCastResultI64 n)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.I64 n))]
    [(CompilerFiniteCastResultChar c)
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Char c))]
    [(CompilerFiniteCastResultF64 n) (opt-f64-to-ir-value n (ast.AstType.F64))]
    [(CompilerFiniteCastResultF32 n) (opt-f64-to-ir-value n (ast.AstType.F32))]
    [(CompilerFiniteCastNoResult) (ir.CompilerIrMaybeValue.No)]))

(define (opt-fold-cast
  [src : OptKnownConst]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (let
    [input : cfloat.CompilerFiniteCastInput (opt-finite-cast-input src from-ty)]
    (match input
      [(CompilerFiniteCastNoInput) (ir.CompilerIrMaybeValue.No)]
      [_
        (opt-finite-cast-result-to-ir
          (cfloat.compiler-finite-cast-fold input from-ty to-ty))])))

(define (opt-fold-binop
  [type-segment-bases : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : OptKnownConst]
  [rhs : OptKnownConst]
  [result-ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match lhs
    [(OptKnownConst.SomeConst lhs-value lhs-ty)
      (match rhs
        [(OptKnownConst.SomeConst rhs-value rhs-ty)
          (let
            [operand-ty : ast.AstType
              (opt-binop-operand-type
                type-segment-bases
                op
                lhs-ty
                rhs-ty
                result-ty)]
            (cond
              [(opt-bool-type? operand-ty)
                (opt-fold-bool op lhs-value rhs-value)]
              [(opt-int-or-char-type? operand-ty)
                (opt-fold-int-char-binop
                  op
                  lhs-value
                  rhs-value
                  operand-ty
                  rhs-ty)]
              [(opt-float-type? operand-ty)
                (opt-fold-float-binop op lhs-value rhs-value operand-ty)]
              [else (ir.CompilerIrMaybeValue.No)]))]
        [(OptKnownConst.NoConst) (ir.CompilerIrMaybeValue.No)])]
    [(OptKnownConst.NoConst) (ir.CompilerIrMaybeValue.No)]))

(define (opt-fold-unop
  [op : ir.CompilerIrUnOp]
  [src : OptKnownConst]
  [result-ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (match src
    [(OptKnownConst.SomeConst value _)
      (match op
        [(ir.CompilerIrUnOp.Neg)
          (if (opt-integer-type? result-ty)
            (match (opt-normalize-scalar-to-i64 value result-ty)
              [(option_i64.Some a)
                (ir.CompilerIrMaybeValue.Some
                  (ir.CompilerIrValue.I64
                    (opt-normalize-int-to-i64 (- 0 a) result-ty)))]
              [(option_i64.None) (ir.CompilerIrMaybeValue.No)])
            (if (opt-float-type? result-ty)
              (match (opt-value-to-f64 value result-ty)
                [(CompilerFloatSomeF64 a)
                  (opt-f64-to-ir-value (- 0.0 a) result-ty)]
                [(CompilerFloatNoF64) (ir.CompilerIrMaybeValue.No)])
              (ir.CompilerIrMaybeValue.No)))]
        [(ir.CompilerIrUnOp.Not)
          (if (opt-bool-type? result-ty)
            (match (opt-value-to-bool value)
              [(OptMaybeBool.Some a)
                (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool (not a)))]
              [(OptMaybeBool.No) (ir.CompilerIrMaybeValue.No)])
            (ir.CompilerIrMaybeValue.No))]
        [(ir.CompilerIrUnOp.BitNot)
          (if (opt-integer-type? result-ty)
            (match (opt-normalize-scalar-to-i64 value result-ty)
              [(option_i64.Some a)
                (ir.CompilerIrMaybeValue.Some
                  (ir.CompilerIrValue.I64
                    (opt-normalize-int-to-i64 (bit-not a) result-ty)))]
              [(option_i64.None) (ir.CompilerIrMaybeValue.No)])
            (ir.CompilerIrMaybeValue.No))]
        ;; Do not fold sqrt through the compiler host. Runtime SSE2 is the
        ;; specified rounding/NaN implementation and must stay visible in IR.
        [(ir.CompilerIrUnOp.Sqrt) (ir.CompilerIrMaybeValue.No)])]
    [(OptKnownConst.NoConst) (ir.CompilerIrMaybeValue.No)]))

;; --- strength reduction / algebraic identities ------------------------------
;;
;; Rewrite only identities that are valid for all values of the instruction's
;; type. Division, modulo, and shifts intentionally have no identities here, so
;; potentially trapping/edge-sensitive operations stay in the IR.
(define (opt-i64-zero? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 n) (= n 0)]
    [_ false]))

(define (opt-i64-one? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 n) (= n 1)]
    [_ false]))

(define (opt-bool-true? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Bool b) b]
    [_ false]))

(define (opt-bool-false? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Bool b) (not b)]
    [_ false]))

(define (opt-strength-int-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [resolved-lhs : ir.CompilerIrValue]
  [resolved-rhs : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match op
    [(ir.CompilerIrBinOp.Add)
      (if (opt-i64-zero? resolved-rhs)
        (ir.CompilerIrMaybeValue.Some lhs)
        (if (opt-i64-zero? resolved-lhs)
          (ir.CompilerIrMaybeValue.Some rhs)
          (ir.CompilerIrMaybeValue.No)))]
    [(ir.CompilerIrBinOp.Sub)
      (if (opt-i64-zero? resolved-rhs)
        (ir.CompilerIrMaybeValue.Some lhs)
        (ir.CompilerIrMaybeValue.No))]
    [(ir.CompilerIrBinOp.Mul)
      (cond
        [(or (opt-i64-zero? resolved-lhs) (opt-i64-zero? resolved-rhs))
          (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.I64 0))]
        [(opt-i64-one? resolved-rhs) (ir.CompilerIrMaybeValue.Some lhs)]
        [(opt-i64-one? resolved-lhs) (ir.CompilerIrMaybeValue.Some rhs)]
        [else (ir.CompilerIrMaybeValue.No)])]
    [(ir.CompilerIrBinOp.BitOr)
      (if (opt-i64-zero? resolved-rhs)
        (ir.CompilerIrMaybeValue.Some lhs)
        (if (opt-i64-zero? resolved-lhs)
          (ir.CompilerIrMaybeValue.Some rhs)
          (ir.CompilerIrMaybeValue.No)))]
    [(ir.CompilerIrBinOp.BitXor)
      (if (opt-i64-zero? resolved-rhs)
        (ir.CompilerIrMaybeValue.Some lhs)
        (if (opt-i64-zero? resolved-lhs)
          (ir.CompilerIrMaybeValue.Some rhs)
          (ir.CompilerIrMaybeValue.No)))]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-strength-bool-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [resolved-lhs : ir.CompilerIrValue]
  [resolved-rhs : ir.CompilerIrValue]) : ir.CompilerIrMaybeValue
  (match op
    [(ir.CompilerIrBinOp.And)
      (cond
        [(or (opt-bool-false? resolved-lhs) (opt-bool-false? resolved-rhs))
          (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool false))]
        [(opt-bool-true? resolved-rhs) (ir.CompilerIrMaybeValue.Some lhs)]
        [(opt-bool-true? resolved-lhs) (ir.CompilerIrMaybeValue.Some rhs)]
        [else (ir.CompilerIrMaybeValue.No)])]
    [(ir.CompilerIrBinOp.Or)
      (cond
        [(or (opt-bool-true? resolved-lhs) (opt-bool-true? resolved-rhs))
          (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Bool true))]
        [(opt-bool-false? resolved-rhs) (ir.CompilerIrMaybeValue.Some lhs)]
        [(opt-bool-false? resolved-lhs) (ir.CompilerIrMaybeValue.Some rhs)]
        [else (ir.CompilerIrMaybeValue.No)])]
    [_ (ir.CompilerIrMaybeValue.No)]))

(define (opt-strength-binop
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [resolved-lhs : ir.CompilerIrValue]
  [resolved-rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : ir.CompilerIrMaybeValue
  (if (opt-integer-type? ty)
    (opt-strength-int-binop op lhs rhs resolved-lhs resolved-rhs)
    (if (opt-bool-type? ty)
      (opt-strength-bool-binop op lhs rhs resolved-lhs resolved-rhs)
      (ir.CompilerIrMaybeValue.No))))

;; --- instruction / block / function / program traversal ----------------------
(defenum OptInstrResult
  (Result OptConstEnv ir.CompilerIrInstr))

(define (opt-invalidate-def
  [env : OptConstEnv]
  [dst : i64]
  [instr : ir.CompilerIrInstr]) : OptInstrResult
  (OptInstrResult.Result (opt-const-unbind env dst) instr))

(define (opt-invalidate-addr-of
  [env : OptConstEnv]
  [dst : i64]
  [src : i64]
  [instr : ir.CompilerIrInstr]) : OptInstrResult
  (OptInstrResult.Result
    (opt-const-unbind (opt-const-unbind env dst) src)
    instr))

(define (opt-invalidate-spmd-result
  [env : OptConstEnv]
  [result : ir.CompilerIrSpmdCallResult]
  [instr : ir.CompilerIrInstr]) : OptInstrResult
  (match result
    [(ir.CompilerIrSpmdCallResult.Unit) (OptInstrResult.Result env instr)]
    [(ir.CompilerIrSpmdCallResult.Value dst _ _)
      (opt-invalidate-def env dst instr)]))

(define (opt-fold-mask-binop-op
  [op : ir.CompilerIrMaskBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : ir.CompilerIrMaskBinOp
  (if (opt-value-eq lhs rhs)
    (ir.CompilerIrMaskBinOp.And)
    op))

(define (opt-fold-instr
  [type-segment-bases : i64]
  [env : OptConstEnv]
  [instr : ir.CompilerIrInstr]) : OptInstrResult
  (match instr
    [(ir.CompilerIrInstr.Mov dst value ty)
      (match (opt-resolve-known env value ty)
        [(OptKnownConst.SomeConst folded _)
          (OptInstrResult.Result
            (opt-const-bind env dst folded ty)
            (ir.CompilerIrInstr.Mov dst folded ty))]
        [(OptKnownConst.NoConst)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(ir.CompilerIrInstr.Alloc dst ty) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.AddrOf dst src)
      (opt-invalidate-addr-of env dst src instr)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Load dst src ty) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (match (opt-fold-cast (opt-resolve-known env src from-ty) from-ty to-ty)
        [(ir.CompilerIrMaybeValue.Some folded)
          (OptInstrResult.Result
            (opt-const-bind env dst folded to-ty)
            (ir.CompilerIrInstr.Mov dst folded to-ty))]
        [(ir.CompilerIrMaybeValue.No)
          (OptInstrResult.Result
            (opt-const-unbind env dst)
            (if (opt-int-cast-as-mov? from-ty to-ty)
              (ir.CompilerIrInstr.Mov dst src to-ty)
              instr))])]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.BinOp dst op l r ty)
      (let
        [result-ty : ast.AstType (ir.compiler-ir-binop-result-type op ty)]
        [rhs-operand-ty : ast.AstType (ir.compiler-ir-binop-rhs-type op ty)]
        (match (opt-fold-binop
          type-segment-bases
          op
          (opt-resolve-known env l ty)
          (opt-resolve-known env r rhs-operand-ty)
          ty)
          [(ir.CompilerIrMaybeValue.Some folded)
            (OptInstrResult.Result
              (opt-const-bind env dst folded result-ty)
              (ir.CompilerIrInstr.Mov dst folded result-ty))]
          [(ir.CompilerIrMaybeValue.No)
            (OptInstrResult.Result (opt-const-unbind env dst) instr)]))]
    [(ir.CompilerIrInstr.UnOp dst op v ty)
      (match (opt-fold-unop op (opt-resolve-known env v ty) ty)
        [(ir.CompilerIrMaybeValue.Some folded)
          (OptInstrResult.Result
            (opt-const-bind env dst folded ty)
            (ir.CompilerIrInstr.Mov dst folded ty))]
        [(ir.CompilerIrMaybeValue.No)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(ir.CompilerIrInstr.LaneId dst _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (OptInstrResult.Result
        (opt-const-unbind env dst)
        (ir.CompilerIrInstr.MaskBinOp
          dst
          (opt-fold-mask-binop-op op lhs rhs)
          lhs
          rhs
          lanes))]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.EntryArgc dst) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.EntryArgv dst) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.EntryEnvp dst) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Xgetbv dst _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Syscall dst _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (opt-invalidate-spmd-result env result instr))]
    [(ir.CompilerIrInstr.StorePtr _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(ir.CompilerIrInstr.TailCall _ _ _) (OptInstrResult.Result env instr)]
    [(ir.CompilerIrInstr.Phi dst inputs ty) (opt-invalidate-def env dst instr)]
    [_ (OptInstrResult.Result env instr)]))

(define (opt-fold-instrs
  [type-segment-bases : i64]
  [env : OptConstEnv]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match (opt-fold-instr type-segment-bases env instr)
        [(OptInstrResult.Result new-env new-instr)
          (ir.compiler-ir-instr-cons
            new-instr
            (opt-fold-instrs type-segment-bases new-env (__tl-box-place rest)))])]))

(define (opt-strength-instr [env : OptConstEnv] [instr : ir.CompilerIrInstr]) : OptInstrResult
  (match instr
    [(ir.CompilerIrInstr.Mov dst value ty)
      (match (opt-resolve-known env value ty)
        [(OptKnownConst.SomeConst folded _)
          (OptInstrResult.Result
            (opt-const-bind env dst folded ty)
            (ir.CompilerIrInstr.Mov dst folded ty))]
        [(OptKnownConst.NoConst)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(ir.CompilerIrInstr.Alloc dst ty) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.AddrOf dst src)
      (opt-invalidate-addr-of env dst src instr)]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Load dst src ty) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.BinOp dst op l r ty)
      (match (opt-strength-binop
        op
        l
        r
        (opt-resolve-value env l)
        (opt-resolve-value env r)
        ty)
        [(ir.CompilerIrMaybeValue.Some replacement)
          (if (opt-const-value? replacement ty)
            (OptInstrResult.Result
              (opt-const-bind env dst replacement ty)
              (ir.CompilerIrInstr.Mov dst replacement ty))
            (OptInstrResult.Result
              (opt-const-unbind env dst)
              (ir.CompilerIrInstr.Mov dst replacement ty)))]
        [(ir.CompilerIrMaybeValue.No)
          (OptInstrResult.Result (opt-const-unbind env dst) instr)])]
    [(ir.CompilerIrInstr.UnOp dst op v ty) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.LaneId dst _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (OptInstrResult.Result
        (opt-const-unbind env dst)
        (ir.CompilerIrInstr.MaskBinOp
          dst
          (opt-fold-mask-binop-op op lhs rhs)
          lhs
          rhs
          lanes))]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-invalidate-def env dst instr))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.EntryArgc dst) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.EntryArgv dst) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.EntryEnvp dst) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Xgetbv dst _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Syscall dst _) (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-invalidate-def env dst instr)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (opt-invalidate-spmd-result env result instr))]
    [(ir.CompilerIrInstr.StorePtr _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(ir.CompilerIrInstr.CopyBytes _ _ _)
      (OptInstrResult.Result OptConstEnv.Nil instr)]
    [(ir.CompilerIrInstr.TailCall _ _ _) (OptInstrResult.Result env instr)]
    [(ir.CompilerIrInstr.Phi dst inputs ty) (opt-invalidate-def env dst instr)]
    [_ (OptInstrResult.Result env instr)]))

(define (opt-strength-instrs
  [env : OptConstEnv]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (match (opt-strength-instr env instr)
        [(OptInstrResult.Result new-env new-instr)
          (ir.compiler-ir-instr-cons
            new-instr
            (opt-strength-instrs new-env (__tl-box-place rest)))])]))

;; --- dead-code elimination ---------------------------------------------------
;;
;; Conservative DCE matching the Rust optimizer's first slice: collect every IR
;; var id referenced as an operand anywhere in the function, then drop pure
;; temporary-producing instructions (`Mov`/`BinOp`/`UnOp`/`Phi`) whose result is
;; never used. Calls, stores, jumps, branches, and returns are kept regardless
;; (they have side effects or drive control flow). The used set is gathered over
;; the *whole reachable function* after CFG simplification, so a var used in
;; another remaining block is never dropped. DCE itself does not decide
;; reachability.
;; Used-var set: var ids referenced somewhere in the function. Backed by
;; opt_i64_i64_map.Map (stored value 1 = present) for O(1) membership; previously a linked
;; list with O(n) contains and O(n^2) dedup'd inserts.
(define (opt-used-contains [set : opt_i64_i64_map.Map] [var : i64]) : bool
  (opt_i64_i64_map.contains? (& set) var))

(define (opt-used-add [set : opt_i64_i64_map.Map (:consume)] [var : i64]) : opt_i64_i64_map.Map
  (let
    [out : opt_i64_i64_map.Map set]
    (begin
      (opt_i64_i64_map.insert-ref! (&mut out) var 1)
      out)))

(define (opt-collect-value-uses
  [set : opt_i64_i64_map.Map]
  [value : ir.CompilerIrValue]) : opt_i64_i64_map.Map
  (match value
    [(ir.CompilerIrValue.Var id) (opt-used-add set id)]
    [_ set]))

(define (opt-collect-value-list-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [values : ir.CompilerIrValueList]) : opt_i64_i64_map.Map
  (match values
    [(ir.CompilerIrValueList.Nil) set]
    [(ir.CompilerIrValueList.Array seq)
      (opt-collect-value-list-uses set (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (opt-collect-value-list-uses
        (opt-collect-value-uses set value)
        (__tl-box-place rest))]))

(define (opt-collect-call-args-array-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : opt_i64_i64_map.Map
  (if (>= index (array-length values))
    set
    (opt-collect-call-args-array-uses
      (opt-collect-value-uses set (array-ref values index))
      values
      (+ index 1))))

(define (opt-collect-call-args-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [args : ir.CompilerIrCallArgs]) : opt_i64_i64_map.Map
  (match args
    [(ir.CompilerIrCallArgs.Nil) set]
    [(ir.CompilerIrCallArgs.One value) (opt-collect-value-uses set value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (opt-collect-value-uses (opt-collect-value-uses set a) b)]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-collect-call-args-array-uses set values 0)]))

(define (opt-collect-spmd-call-args-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [args : ir.CompilerIrSpmdCallArgList]) : opt_i64_i64_map.Map
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) set]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (opt-collect-spmd-call-args-uses
            (opt-collect-value-uses set value)
            (__tl-box-place rest))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : opt_i64_i64_map.Map set]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (opt-collect-value-uses out value))])
              (set! i (+ i 1))))
          out))]))

(define (opt-collect-phi-uses
  [set : opt_i64_i64_map.Map (:consume)]
  [inputs : ir.CompilerIrPhiInputList]) : opt_i64_i64_map.Map
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) set]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-collect-phi-uses set (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (opt-collect-phi-uses
        (opt-collect-value-uses set value)
        (__tl-box-place rest))]))

(define (opt-collect-instr-uses
  [set : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : opt_i64_i64_map.Map
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.BinOp _ _ l r _)
      (opt-collect-value-uses (opt-collect-value-uses set l) r)]
    [(ir.CompilerIrInstr.UnOp _ _ src _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.Call _ _ args _) (opt-collect-call-args-uses set args)]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-collect-call-args-uses (opt-collect-value-uses set base) args))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-collect-call-args-uses
          (opt-collect-value-uses (opt-collect-value-uses set base) func)
          args))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (opt-collect-spmd-call-args-uses
          (opt-collect-value-uses set active-mask)
          args))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (opt-collect-call-args-uses set args)]
    [(ir.CompilerIrInstr.Store _ value _) (opt-collect-value-uses set value)]
    ;; Pointer/memory ops carry operand uses too; missing any of these would let
    ;; DCE wrongly drop a definition that feeds an address/load/store/cast.
    [(ir.CompilerIrInstr.AddrOf _ src) (opt-used-add set src)]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (opt-collect-value-uses (opt-collect-value-uses set base) offset)]
    [(ir.CompilerIrInstr.Load _ src _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (opt-collect-value-uses (opt-collect-value-uses set ptr) value)]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (opt-collect-value-uses (opt-collect-value-uses set dst) src)]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (opt-collect-value-uses (opt-collect-value-uses set index) length)]
    [(ir.CompilerIrInstr.Cast _ src _ _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.Splat _ value _ _) (opt-collect-value-uses set value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (opt-collect-value-uses (opt-collect-value-uses set src) carry))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (opt-collect-value-uses (opt-collect-value-uses set lhs) rhs)]
    [(ir.CompilerIrInstr.MaskNot _ src _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (opt-collect-value-uses
          (opt-collect-value-uses (opt-collect-value-uses set mask) on-true)
          on-false))]
    [(ir.CompilerIrInstr.VectorLoad _ base index _ _)
      (opt-collect-value-uses (opt-collect-value-uses set base) index)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (opt-collect-value-uses
          (opt-collect-value-uses (opt-collect-value-uses set base) index)
          value))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-collect-value-uses
          (opt-collect-value-uses
            (opt-collect-value-uses (opt-collect-value-uses set base) index)
            value)
          mask))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (opt-collect-value-uses
          (opt-collect-value-uses (opt-collect-value-uses set base) index)
          mask))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (opt-collect-value-uses
          (opt-collect-value-uses (opt-collect-value-uses set base) index-base)
          index))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (opt-collect-value-uses
          (match selector-high
            [(ir.CompilerIrMaybeValue.Some value)
              (opt-collect-value-uses
                (opt-collect-value-uses
                  (opt-collect-value-uses set source)
                  selector-low)
                value)]
            [(ir.CompilerIrMaybeValue.No)
              (opt-collect-value-uses
                (opt-collect-value-uses set source)
                selector-low)])
          active-lanes))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (opt-collect-value-uses (opt-collect-value-uses set index) length)]
    [(ir.CompilerIrInstr.EntryArgc _) set]
    [(ir.CompilerIrInstr.EntryArgv _) set]
    [(ir.CompilerIrInstr.EntryEnvp _) set]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (opt-collect-value-uses (opt-collect-value-uses set leaf) subleaf)]
    [(ir.CompilerIrInstr.Xgetbv _ index) (opt-collect-value-uses set index)]
    [(ir.CompilerIrInstr.Syscall _ args) (opt-collect-call-args-uses set args)]
    [(ir.CompilerIrInstr.Branch cond _ _) (opt-collect-value-uses set cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-collect-value-uses set cond)]
    [(ir.CompilerIrInstr.Return maybe)
      (match maybe
        [(ir.CompilerIrMaybeValue.Some value)
          (opt-collect-value-uses set value)]
        [(ir.CompilerIrMaybeValue.No) set])]
    [(ir.CompilerIrInstr.Phi _ inputs _) (opt-collect-phi-uses set inputs)]
    ;; Register-group ops use their operands -- Pack uses each word value,
    ;; Word uses the source group. Omitting these would let DCE drop a definition
    ;; that feeds a Pack/Word.
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-collect-value-list-uses set words)]
    [(ir.CompilerIrInstr.Word _ src _ _) (opt-collect-value-uses set src)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (opt-collect-call-args-uses (opt-collect-value-uses set func) args)]
    [(ir.CompilerIrInstr.Switch index _ _ _) (opt-collect-value-uses set index)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (opt-collect-value-uses set index)]
    ;; `CompilerIrInstr.Alloc` has no operand uses; `CompilerIrInstr.Jump` has none either.
    [_ set]))

(define (opt-collect-instrs-uses
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrList]) : opt_i64_i64_map.Map
  (match instrs
    [(ir.CompilerIrInstrList.Nil) set]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (opt-collect-instrs-uses
        (opt-collect-instr-uses set instr)
        (__tl-box-place rest))]))

(define (opt-collect-instr-seq-uses-from
  [set : opt_i64_i64_map.Map]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]) : opt_i64_i64_map.Map
  (if (>= index count)
    set
    (opt-collect-instr-seq-uses-from
      (opt-collect-instr-uses set (array-ref slots index))
      slots
      (+ index 1)
      count)))

(define (opt-collect-instr-seq-uses
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]) : opt_i64_i64_map.Map
  (opt-collect-instr-seq-uses-from set instrs.slots 0 instrs.len))

;; Division, modulo, and shift can trap at runtime (zero divisor, signed
;; MIN / -1, shift count out of range), so a BinOp using one of those operators
;; is NOT pure: dropping it as dead would elide the trap the safe-code contract
;; requires. These ops must stay in the IR even when their result is unused.
(define (opt-binop-traps? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Div) true]
    [(ir.CompilerIrBinOp.Mod) true]
    [(ir.CompilerIrBinOp.Shl _) true]
    [(ir.CompilerIrBinOp.Shr _) true]
    [_ false]))

(define (opt-instr-alloc-dst? [instr : ir.CompilerIrInstr] [dst : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Alloc other _) (= other dst)]
    [_ false]))

(define (opt-next-adjacent-alloc? [next : ir.CompilerIrInstrList] [dst : i64]) : bool
  (match next
    [(ir.CompilerIrInstrList.Cons instr _)
      (opt-instr-alloc-dst? instr (+ dst 1))]
    [_ false]))

(define (opt-array-prev-adjacent-alloc?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [dst : i64]) : bool
  (if (<= index 0)
    false
    (opt-instr-alloc-dst? (array-ref slots (- index 1)) (- dst 1))))

(define (opt-array-next-adjacent-alloc?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [count : i64]
  [index : i64]
  [dst : i64]) : bool
  (if (>= (+ index 1) count)
    false
    (opt-instr-alloc-dst? (array-ref slots (+ index 1)) (+ dst 1))))

;; A pure temporary-producing instruction is dead when its result var is unused.
;; Calls (side-effecting) and control-flow instructions are never dead here.
;;
;; Address creation (`CompilerIrInstr.AddrOf`), address arithmetic (`CompilerIrInstr.Gep`), value
;; conversions (`CompilerIrInstr.Cast`), and non-volatile reads (`CompilerIrInstr.Load`) are pure
;; or read-only
;; (`compiler-ir-instr-effect` classes `CompilerIrEffect.Pure` / `CompilerIrEffect.MemoryRead`): a
;; dead address calculation/read never writes state and only ever feeds its
;; result var, so when that var is unused the whole computation is dead. These
;; arms let DCE clear the dead length-load / addr-of / gep / cast chain that
;; `opt-loop-bce-blocks` leaves behind once it proves an array index in range,
;; which otherwise survives every later pass because these producers were
;; excluded here.
(define (opt-instr-dead?
  [set : opt_i64_i64_map.Map]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.AddrOf dst _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Gep dst _ _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Cast dst _ _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Load dst _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.BinOp dst op _ _ _)
      (and (not (opt-binop-traps? op)) (not (opt-used-contains set dst)))]
    [(ir.CompilerIrInstr.UnOp dst _ _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Phi dst _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.LaneId dst _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Splat dst _ _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-contains set dst)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-contains set dst)))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-contains set dst)))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.MaskNot dst _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-contains set dst)))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Pack dst _ _) (not (opt-used-contains set dst))]
    [(ir.CompilerIrInstr.Word dst _ _ _) (not (opt-used-contains set dst))]
    [_ false]))

(define (opt-dce-instrs-from
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrList]
  [prev-alloc-dst : i64]) : ir.CompilerIrInstrList
  (match instrs
    [(ir.CompilerIrInstrList.Nil) (ir.CompilerIrInstrList.Nil)]
    [(ir.CompilerIrInstrList.Cons instr rest)
      (let
        [rest-list : ir.CompilerIrInstrList (__tl-box-place rest)]
        (if (opt-instr-dead? set instr)
          (opt-dce-instrs-from set rest-list -2)
          (match instr
            [(ir.CompilerIrInstr.Alloc dst _)
              (if (and
                (not (opt-used-contains set dst))
                (not
                  (or
                    (= prev-alloc-dst (- dst 1))
                    (opt-next-adjacent-alloc? rest-list dst))))
                (opt-dce-instrs-from set rest-list dst)
                (ir.compiler-ir-instr-cons
                  instr
                  (opt-dce-instrs-from set rest-list dst)))]
            [_
              (ir.compiler-ir-instr-cons
                instr
                (opt-dce-instrs-from set rest-list -2))])))]))

(define (opt-dce-instrs
  [set : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (opt-dce-instrs-from set instrs -2))

;; `make-array` already returns zeroed memory, so a fresh use-count array needs
;; no initialising pass. The `opt-used-array-fill` helper existed only to run
;; that pass and had no other caller, so it goes with it.
(define (opt-used-array-new [count : i64]) : (__tl_dyn-array i64)
  (array.make-array i64 count))

;; Use counts (not booleans): `add` bumps the count, `contains` reports any live
;; use, and `dec` drops a single use when DCE deletes an instruction. Counting
;; lets one backward DCE sweep retire a whole dead chain -- deleting the cast
;; that fed a removed bounds check decrements its operand load, which then reads
;; as dead when the sweep reaches it, and so on down the gep.
(define (opt-used-array-add [items : (__tl_dyn-array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (begin
        (set! (array-ref items var) (+ (array-ref items var) 1))
        unit))))

(define (opt-used-array-dec [items : (__tl_dyn-array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length items))
      unit
      (let
        [current : i64 (array-ref items var)]
        (if (> current 0)
          (begin
            (set! (array-ref items var) (- current 1))
            unit)
          unit)))))

(define (opt-used-array-contains [items : (__tl_dyn-array i64)] [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length items))
      false
      (> (array-ref items var) 0))))

(define (opt-collect-value-uses-array
  [items : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : unit
  (match value
    [(ir.CompilerIrValue.Var id) (opt-used-array-add items id)]
    [_ unit]))

(define (opt-collect-value-list-uses-array
  [items : (__tl_dyn-array i64)]
  [values : ir.CompilerIrValueList]) : unit
  (match values
    [(ir.CompilerIrValueList.Nil) unit]
    [(ir.CompilerIrValueList.Array seq)
      (opt-collect-value-list-uses-array
        items
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (begin
        (opt-collect-value-uses-array items value)
        (opt-collect-value-list-uses-array items (__tl-box-place rest)))]))

(define (opt-collect-call-args-array-uses-array
  [items : (__tl_dyn-array i64)]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (opt-collect-value-uses-array items (array-ref values index))
      (opt-collect-call-args-array-uses-array items values (+ index 1)))))

(define (opt-collect-call-args-uses-array
  [items : (__tl_dyn-array i64)]
  [args : ir.CompilerIrCallArgs]) : unit
  (match args
    [(ir.CompilerIrCallArgs.Nil) unit]
    [(ir.CompilerIrCallArgs.One value)
      (opt-collect-value-uses-array items value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (begin
        (opt-collect-value-uses-array items a)
        (opt-collect-value-uses-array items b))]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-collect-call-args-array-uses-array items values 0)]))

(define (opt-collect-spmd-call-args-uses-array
  [items : (__tl_dyn-array i64)]
  [args : ir.CompilerIrSpmdCallArgList]) : unit
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) unit]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (opt-collect-value-uses-array items value)
            (opt-collect-spmd-call-args-uses-array items (__tl-box-place rest)))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (while (< i count)
          (begin
            (match (array-ref slots i)
              [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                (opt-collect-value-uses-array items value)])
            (set! i (+ i 1)))))]))

(define (opt-collect-phi-uses-array
  [items : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-collect-phi-uses-array
        items
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (opt-collect-value-uses-array items value)
        (opt-collect-phi-uses-array items (__tl-box-place rest)))]))

;; Same tag-chain economics as `opt-instr-def-var` (see the note there): this
;; `match` lowers to a linear compare chain, so arm position is cost. In an
;; opt2 self-compile this primitive runs ~34M times and the declaration order
;; put `Alloc` -- the single most frequent shape, and non-using, so it fell
;; through to the catch-all -- at the end of a 50-comparison walk, pushing the
;; average query to 29.3 comparisons. Arms are ordered by measured dynamic
;; frequency (4.2 comparisons average on the same compile), with explicit
;; no-use arms for the hot non-using shapes (Alloc,
;; Jump, LaneId) that previously reached the same answer through the catch-all.
;; Variant patterns over one enum are disjoint, so reordering cannot change
;; which arm matches.
(define (opt-collect-instr-uses-array
  [items : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : unit
  (match instr
    [(ir.CompilerIrInstr.Alloc _ _) unit]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (begin
        (opt-collect-value-uses-array items base)
        (opt-collect-value-uses-array items offset))]
    [(ir.CompilerIrInstr.Mov _ src _) (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.Call _ _ args _)
      (opt-collect-call-args-uses-array items args)]
    [(ir.CompilerIrInstr.Load _ src _) (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (begin
        (opt-collect-value-uses-array items ptr)
        (opt-collect-value-uses-array items value))]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-collect-value-uses-array items cond)]
    [(ir.CompilerIrInstr.BinOp _ _ l r _)
      (begin
        (opt-collect-value-uses-array items l)
        (opt-collect-value-uses-array items r))]
    [(ir.CompilerIrInstr.Return maybe)
      (match maybe
        [(ir.CompilerIrMaybeValue.Some value)
          (opt-collect-value-uses-array items value)]
        [(ir.CompilerIrMaybeValue.No) unit])]
    [(ir.CompilerIrInstr.AddrOf _ src) (opt-used-array-add items src)]
    [(ir.CompilerIrInstr.Jump _) unit]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (begin
        (opt-collect-value-uses-array items dst)
        (opt-collect-value-uses-array items src))]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-collect-phi-uses-array items inputs)]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (begin
        (opt-collect-value-uses-array items index)
        (opt-collect-value-uses-array items length))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (opt-collect-call-args-uses-array items args)]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-collect-value-uses-array items src)]
    ;; Register-group ops use their operands (Pack: each word; Word: src).
    [(ir.CompilerIrInstr.Word _ src _ _)
      (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-collect-value-list-uses-array items words)]
    [(ir.CompilerIrInstr.Store _ value _)
      (opt-collect-value-uses-array items value)]
    [(ir.CompilerIrInstr.Switch index _ _ _)
      (opt-collect-value-uses-array items index)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (opt-collect-value-uses-array items index)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-collect-value-uses-array items cond)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.LaneId _ _ _) unit]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (opt-collect-value-uses-array items value)]
    [(ir.CompilerIrInstr.CallIndirect _ func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(ir.CompilerIrInstr.CallIndirectC _ func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (opt-collect-value-uses-array items base)
          (opt-collect-call-args-uses-array items args)))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (opt-collect-value-uses-array items base)
          (opt-collect-value-uses-array items func)
          (opt-collect-call-args-uses-array items args)))]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (begin
        (opt-collect-value-uses-array items func)
        (opt-collect-call-args-uses-array items args))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (opt-collect-value-uses-array items active-mask)
          (opt-collect-spmd-call-args-uses-array items args)))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (begin
          (opt-collect-value-uses-array items mask)
          (opt-collect-value-uses-array items on-true)
          (opt-collect-value-uses-array items on-false)))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (opt-collect-value-uses-array items lhs)
          (opt-collect-value-uses-array items rhs)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (begin
          (opt-collect-value-uses-array items src)
          (opt-collect-value-uses-array items carry)))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (opt-collect-value-uses-array items lhs)
          (opt-collect-value-uses-array items rhs)))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (opt-collect-value-uses-array items lhs)
        (opt-collect-value-uses-array items rhs))]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-collect-value-uses-array items src)]
    [(ir.CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (opt-collect-value-uses-array items base)
        (opt-collect-value-uses-array items index))]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (begin
          (opt-collect-value-uses-array items base)
          (opt-collect-value-uses-array items index)
          (opt-collect-value-uses-array items value)))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (begin
          (opt-collect-value-uses-array items base)
          (opt-collect-value-uses-array items index)
          (opt-collect-value-uses-array items value)
          (opt-collect-value-uses-array items mask)))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (begin
          (opt-collect-value-uses-array items base)
          (opt-collect-value-uses-array items index)
          (opt-collect-value-uses-array items mask)))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (begin
          (opt-collect-value-uses-array items base)
          (opt-collect-value-uses-array items index-base)
          (opt-collect-value-uses-array items index)))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (begin
          (opt-collect-value-uses-array items source)
          (opt-collect-value-uses-array items selector-low)
          (match selector-high
            [(ir.CompilerIrMaybeValue.Some value)
              (opt-collect-value-uses-array items value)]
            [(ir.CompilerIrMaybeValue.No) unit])
          (opt-collect-value-uses-array items active-lanes)))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (begin
        (opt-collect-value-uses-array items index)
        (opt-collect-value-uses-array items length))]
    [(ir.CompilerIrInstr.EntryArgc _) unit]
    [(ir.CompilerIrInstr.EntryArgv _) unit]
    [(ir.CompilerIrInstr.EntryEnvp _) unit]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (opt-collect-value-uses-array items leaf)
        (opt-collect-value-uses-array items subleaf))]
    [(ir.CompilerIrInstr.Xgetbv _ index)
      (opt-collect-value-uses-array items index)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (opt-collect-call-args-uses-array items args)]
    [_ unit]))

;; Decrement the operand use counts an instruction contributed. Called when DCE
;; deletes that instruction so a single backward sweep can retire the rest of a
;; now-dead chain. Only the pure/group producers DCE can delete need arms here;
;; anything else leaves the counts untouched (conservative -- it just keeps an
;; instruction).
(define (opt-uncount-value-uses-array
  [items : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : unit
  (match value
    [(ir.CompilerIrValue.Var id) (opt-used-array-dec items id)]
    [_ unit]))

(define (opt-uncount-value-list-uses-array
  [items : (__tl_dyn-array i64)]
  [values : ir.CompilerIrValueList]) : unit
  (match values
    [(ir.CompilerIrValueList.Nil) unit]
    [(ir.CompilerIrValueList.Array seq)
      (opt-uncount-value-list-uses-array
        items
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons value rest)
      (begin
        (opt-uncount-value-uses-array items value)
        (opt-uncount-value-list-uses-array items (__tl-box-place rest)))]))

(define (opt-uncount-phi-uses-array
  [items : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-uncount-phi-uses-array
        items
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (opt-uncount-value-uses-array items value)
        (opt-uncount-phi-uses-array items (__tl-box-place rest)))]))

(define (opt-uncount-instr-uses-array
  [items : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _) (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.AddrOf _ src) (opt-used-array-dec items src)]
    [(ir.CompilerIrInstr.Gep _ base offset _)
      (begin
        (opt-uncount-value-uses-array items base)
        (opt-uncount-value-uses-array items offset))]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.Load _ src _) (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (opt-uncount-value-uses-array items lhs)
        (opt-uncount-value-uses-array items rhs))]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-uncount-phi-uses-array items inputs)]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (opt-uncount-value-uses-array items value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (opt-uncount-value-uses-array items lhs)
          (opt-uncount-value-uses-array items rhs)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (begin
          (opt-uncount-value-uses-array items src)
          (opt-uncount-value-uses-array items carry)))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (opt-uncount-value-uses-array items lhs)
          (opt-uncount-value-uses-array items rhs)))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (opt-uncount-value-uses-array items lhs)
        (opt-uncount-value-uses-array items rhs))]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-uncount-value-uses-array items src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (begin
          (opt-uncount-value-uses-array items mask)
          (opt-uncount-value-uses-array items on-true)
          (opt-uncount-value-uses-array items on-false)))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (begin
        (opt-uncount-value-uses-array items index)
        (opt-uncount-value-uses-array items length))]
    [(ir.CompilerIrInstr.Pack _ words _)
      (opt-uncount-value-list-uses-array items words)]
    [(ir.CompilerIrInstr.Word _ src _ _)
      (opt-uncount-value-uses-array items src)]
    [_ unit]))

(define (opt-collect-instr-seq-uses-array
  [items : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (opt-collect-instr-uses-array items (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (opt-collect-block-seq-uses-array-into
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    (while (< index count)
      (begin
        (match (ir.compiler-ir-block-seq-ref blocks index)
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-collect-instr-seq-uses-array items instrs)])
        (set! index (+ index 1))))))

(define (opt-collect-blocks-uses-array-into
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (opt-collect-instr-seq-uses-array items instrs)
            (opt-collect-blocks-uses-array-into items (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-collect-block-seq-uses-array-into items seq)]))

(define (opt-collect-blocks-uses-array
  [vars : i64]
  [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array i64)
  (let
    [items : (__tl_dyn-array i64) (opt-used-array-new vars)]
    (begin
      (opt-collect-blocks-uses-array-into items blocks)
      items)))

;; Comparisons whose negation is another comparison on the same operands. Used
;; to turn `not (cmp a b)` into the inverted compare instead of a `xorq $1` over
;; the materialised boolean. Float operands are rejected by the caller: NaN
;; makes `not (a < b)` and `a >= b` differ.
(define (opt-invertible-compare-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Eq) true]
    [(ir.CompilerIrBinOp.Ne) true]
    [(ir.CompilerIrBinOp.Lt) true]
    [(ir.CompilerIrBinOp.Le) true]
    [(ir.CompilerIrBinOp.Gt) true]
    [(ir.CompilerIrBinOp.Ge) true]
    [(ir.CompilerIrBinOp.BitTestEq) true]
    [(ir.CompilerIrBinOp.BitTestNe) true]
    [_ false]))

(define (opt-invert-compare-op [op : ir.CompilerIrBinOp]) : ir.CompilerIrBinOp
  (match op
    [(ir.CompilerIrBinOp.Eq) (ir.CompilerIrBinOp.Ne)]
    [(ir.CompilerIrBinOp.Ne) (ir.CompilerIrBinOp.Eq)]
    [(ir.CompilerIrBinOp.Lt) (ir.CompilerIrBinOp.Ge)]
    [(ir.CompilerIrBinOp.Le) (ir.CompilerIrBinOp.Gt)]
    [(ir.CompilerIrBinOp.Gt) (ir.CompilerIrBinOp.Le)]
    [(ir.CompilerIrBinOp.Ge) (ir.CompilerIrBinOp.Lt)]
    [(ir.CompilerIrBinOp.BitTestEq) (ir.CompilerIrBinOp.BitTestNe)]
    [(ir.CompilerIrBinOp.BitTestNe) (ir.CompilerIrBinOp.BitTestEq)]
    [_ op]))

;; Passed as `mirror` by callers that have no second use-count array to keep in
;; step. Zero length is the "no mirror" signal, so the rewrite paths below skip
;; the mirrored bookkeeping with one length test and no allocation.
(define opt-dce-no-mirror : (__tl_dyn-array (__tl_dyn-array i64))
  (make-array (array.make-array i64 0)))

;; The zero-length mirror sentinel is immutable in practice: every update is
;; guarded by its length. Preserve the allocation-free shared sentinel behind
;; one explicit internal boundary.
(define (opt-dce-no-mirror-shared-view) : (__tl_dyn-array i64)
  (unsafe
    (ptr-read
      (ptr-cast (array-data opt-dce-no-mirror) : (Ptr (__tl_dyn-array i64))))))

;; Apply to `mirror` the same use-count edit a rewrite just applied to the
;; array the walk is reading. See `opt-dce-block-list-array-pass`: the dry run
;; reads a throwaway COPY of the counts, but the rewrites it performs mutate the
;; real IR, so the REAL counts have to retire the same use or the following
;; sweep keeps an instruction that is now dead.
(define (opt-mirror-rewrite!
  [mirror : (__tl_dyn-array i64)]
  [retired : i64]
  [next : ir.CompilerIrInstr]) : unit
  (if (> (array-length mirror) 0)
    (begin
      (opt-used-array-dec mirror retired)
      (opt-collect-instr-uses-array mirror next))
    unit))

;; Mirror of `opt-instr-dead?` for the array-backed use set the pipeline DCE
;; runs on. The pure/read-only addr-of/gep/cast/load arms drop the dead
;; length-load/address chain that `opt-loop-bce-blocks` strands once a bounds
;; check is proven redundant.
(define (opt-instr-dead-array?
  [items : (__tl_dyn-array i64)]
  [mirror : (__tl_dyn-array i64)]
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [count : i64]
  [index : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Alloc dst _)
      (and
        (not (opt-used-array-contains items dst))
        (not
          (or
            (opt-array-prev-adjacent-alloc? slots index dst)
            (opt-array-next-adjacent-alloc? slots count index dst))))]
    [(ir.CompilerIrInstr.Mov dst _ _) (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.AddrOf dst _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.Gep dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.Cast dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.Load dst _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (begin
        ;; This DCE walk already owns the function-wide use counts and visits
        ;; every instruction once. Rewrite an adjacent, single-use mask here
        ;; so compare admission adds no second instruction scan or dispatch.
        (if (and (> index 0) (opt-used-array-contains items dst))
          (match lhs
            [(ir.CompilerIrValue.Var and-var)
              (match rhs
                ;; Two admission shapes share this rewrite.
                ;;
                ;; Against ZERO -- `(x & m) == 0` is "none of the selected bits
                ;; is set" for any mask, so Eq/Le become BitTestEq and Ne/Gt
                ;; become BitTestNe. Le/Gt additionally require a small
                ;; non-negative literal mask so the ordered reading of the
                ;; `and` result cannot disagree with the bit test.
                ;;
                ;; Against the MASK ITSELF -- when `m` has exactly one bit set,
                ;; `x & m` is either 0 or m and nothing else, so `(x & m) == m`
                ;; is exactly "that bit is set" and `(x & m) != m` is exactly
                ;; "that bit is clear". The mapping therefore INVERTS relative
                ;; to the zero case: Eq becomes BitTestNe (bit set means ZF
                ;; clear) and Ne becomes BitTestEq. Refusals are load-bearing:
                ;; a multi-bit mask asks a different question (`(x & 3) == 3`
                ;; wants BOTH bits, which one `test` cannot answer), Le/Gt
                ;; against the mask is a constant fold rather than a bit test,
                ;; and the `> 0` guard drops the i64 spelling of `1 << 63`,
                ;; whose payload is stored negative.
                [(ir.CompilerIrValue.I64 cmp-const)
                  (let
                    [zero? : bool (= cmp-const 0)]
                    [mask-bit? : bool
                      (and
                        (> cmp-const 0)
                        (= (bit-and cmp-const (- cmp-const 1)) 0))]
                    (if (or zero? mask-bit?)
                      (let
                        [tag : i64 (opt-binop-tag op)]
                        [safe : bool
                          (if zero?
                            (or (= tag 7) (= tag 8) (= tag 10) (= tag 11))
                            (or (= tag 7) (= tag 8)))]
                        (if (and safe (= (array-ref items and-var) 1))
                          (match (ir.compiler-ir-instr-scalar-fact
                            (array-ref slots (- index 1)))
                            [(ir.CompilerIrInstrScalarFact.BinOp
                                actual
                                (ir.CompilerIrBinOp.BitAnd)
                                value
                                mask
                                _)
                              (if (and
                                (= actual and-var)
                                (if zero?
                                  (or
                                    (not (or (= tag 10) (= tag 11)))
                                    (match mask
                                      [(ir.CompilerIrValue.I64 n)
                                        (and (>= n 0) (<= n 127))]
                                      [_ false]))
                                  ;; The comparison constant only names the bit
                                  ;; this `and` isolated when both literals are
                                  ;; the same single bit.
                                  (match mask
                                    [(ir.CompilerIrValue.I64 n) (= n cmp-const)]
                                    [_ false])))
                                (let
                                  [test-eq? : bool
                                    (if zero?
                                      (or (= tag 7) (= tag 10))
                                      (= tag 8))]
                                  [next : ir.CompilerIrInstr
                                    (ir.CompilerIrInstr.BinOp
                                      dst
                                      (if test-eq?
                                        (ir.CompilerIrBinOp.BitTestEq)
                                        (ir.CompilerIrBinOp.BitTestNe))
                                      value
                                      mask
                                      ty)]
                                  (begin
                                    (set! (array-ref slots index) next)
                                    (opt-used-array-dec items and-var)
                                    (opt-collect-instr-uses-array items next)
                                    (opt-mirror-rewrite! mirror and-var next)))
                                unit)]
                            [_ unit])
                          unit))
                      unit))]
                [_ unit])]
            [_ unit])
          unit)
        (and
          (not (opt-binop-traps? op))
          (not (opt-used-array-contains items dst))))]
    [(ir.CompilerIrInstr.UnOp dst op src _)
      (begin
        ;; `not` over an adjacent single-use comparison is the comparison with
        ;; the inverted predicate. Emitting it as a negation costs the backend a
        ;; `setcc`+`movzbq` for the compare and then a `xorq $1` (plus a second
        ;; `movzbq`) to flip it; inverting the predicate here spends one `setcc`.
        ;; Shares the adjacency/single-use shape -- and the mirrored use-count
        ;; bookkeeping -- with the bit-test rewrite above.
        (if (and (> index 0) (opt-used-array-contains items dst))
          (match op
            [(ir.CompilerIrUnOp.Not)
              (match src
                [(ir.CompilerIrValue.Var cmp-var)
                  (if (= (array-ref items cmp-var) 1)
                    (match (ir.compiler-ir-instr-scalar-fact
                      (array-ref slots (- index 1)))
                      [(ir.CompilerIrInstrScalarFact.BinOp
                          actual
                          cmp-op
                          cmp-lhs
                          cmp-rhs
                          cmp-ty)
                        (if (and
                          (= actual cmp-var)
                          (opt-invertible-compare-op? cmp-op)
                          ;; NaN breaks the identity for ordered float
                          ;; compares (`not (a < b)` is not `a >= b`), so
                          ;; float operands never invert here.
                          (not (opt-float-type? cmp-ty)))
                          (let
                            [next : ir.CompilerIrInstr
                              (ir.CompilerIrInstr.BinOp
                                dst
                                (opt-invert-compare-op cmp-op)
                                cmp-lhs
                                cmp-rhs
                                cmp-ty)]
                            (begin
                              (set! (array-ref slots index) next)
                              (opt-used-array-dec items cmp-var)
                              (opt-collect-instr-uses-array items next)
                              (opt-mirror-rewrite! mirror cmp-var next)))
                          unit)]
                      [_ unit])
                    unit)]
                [_ unit])]
            [_ unit])
          unit)
        (not (opt-used-array-contains items dst)))]
    [(ir.CompilerIrInstr.Phi dst _ _) (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.LaneId dst _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.Splat dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-array-contains items dst)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-array-contains items dst)))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-array-contains items dst)))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (not (opt-used-array-contains items dst)))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (not (opt-used-array-contains items dst))]
    ;; Register-group ops are pure producers like the scalar temps above: a
    ;; Pack whose group is never read (every Word extraction folded away) is
    ;; dead, and so is a Word nobody reads. Mirrors `opt-instr-dead?`.
    [(ir.CompilerIrInstr.Pack dst _ _)
      (not (opt-used-array-contains items dst))]
    [(ir.CompilerIrInstr.Word dst _ _ _)
      (not (opt-used-array-contains items dst))]
    [_ false]))

;; Retain-only sweep into a fresh dense sequence. The BACKWARD walk is load
;; bearing and is preserved exactly: deleting an instruction drops the uses it
;; made (opt-uncount-instr-uses-array), which is what lets an earlier
;; instruction become dead in the same sweep. Survivors are therefore written
;; from the END of the output array and the live suffix is slid down to index 0
;; afterwards -- the same two-phase shape opt-dce-instr-seq-array-escape already
;; uses, minus the escape clone. Output is fresh; `instrs` is untouched (this is
;; the opt2 path, where the fixpoint driver still needs its input intact --
;; opt-dce-instr-seq-array-in-place! remains the opt1 form). refs #5726
(define (opt-dce-instr-seq-array
  [items : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out-slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 (- count 1)]
    [write : i64 (- count 1)]
    [live-count : i64 0]
    [src : i64 0]
    [dst : i64 0]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : ir.CompilerIrInstr (array-ref slots index)]
            (if (opt-instr-dead-array?
              items
              (opt-dce-no-mirror-shared-view)
              slots
              count
              index
              instr)
              (opt-uncount-instr-uses-array items instr)
              (begin
                (set! (array-ref out-slots write) (array-ref slots index))
                (set! write (- write 1)))))
          (set! index (- index 1))))
      (set! live-count (- count (+ write 1)))
      (set! src (+ write 1))
      (set! dst 0)
      (while (< dst live-count)
        (begin
          (if (not (= dst src))
            (set! (array-ref out-slots dst) (array-ref out-slots src))
            unit)
          (set! dst (+ dst 1))
          (set! src (+ src 1))))
      (ir.CompilerIrInstrSeq out-slots live-count))))

(define (opt-dce-instr-seq-array-in-place!
  [items : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq (:consume)]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 (- count 1)]
    [write : i64 (- count 1)]
    [live-count : i64 0]
    [src : i64 0]
    [dst : i64 0]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : ir.CompilerIrInstr (array-ref slots index)]
            (if (opt-instr-dead-array?
              items
              (opt-dce-no-mirror-shared-view)
              slots
              count
              index
              instr)
              ;; Deleting this instruction drops the uses it made, so a value it
              ;; was the last reader of becomes dead for an earlier sweep step.
              (opt-uncount-instr-uses-array items instr)
              (begin
                (if (not (= write index))
                  (set! (array-ref slots write) instr)
                  unit)
                (set! write (- write 1)))))
          (set! index (- index 1))))
      (set! live-count (- count (+ write 1)))
      (set! src (+ write 1))
      (set! dst 0)
      (while (< dst live-count)
        (begin
          (if (not (= dst src))
            (set! (array-ref slots dst) (array-ref slots src))
            unit)
          (set! dst (+ dst 1))
          (set! src (+ src 1))))
      (set! instrs.len live-count)
      instrs)))

(define (opt-dce-block-array
  [items : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block label (opt-dce-instr-seq-array items instrs))]))

(define (opt-dce-block-array-in-place
  [items : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (opt-dce-instr-seq-array-in-place! items instrs))]))

(define (opt-dce-block-list-array
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-dce-block-array items block)
        (opt-dce-block-list-array items (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-dce-block-list-array items (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-dce-copy-used-from!
  [source : (__tl_dyn-array i64)]
  [out : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length source))
    unit
    (begin
      (set! (array-ref out index) (array-ref source index))
      (opt-dce-copy-used-from! source out (+ index 1)))))

(define (opt-dce-copy-used [source : (__tl_dyn-array i64)]) : (__tl_dyn-array
    i64)
  (let
    [out : (__tl_dyn-array i64) (array.make-array i64 (array-length source))]
    (begin
      (opt-dce-copy-used-from! source out 0)
      out)))

;; Exact dry run of the backward DCE walk. It mutates only the copied use-count
;; array, including cascading decrements, and allocates no replacement IR.
(define (opt-dce-instr-seq-array-has-dead!
  [items : (__tl_dyn-array i64)]
  [mirror : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 (- count 1)]
    [changed : bool false]
    (begin
      (while (>= index 0)
        (let
          [instr : ir.CompilerIrInstr (array-ref slots index)]
          (begin
            (if (opt-instr-dead-array? items mirror slots count index instr)
              (begin
                (set! changed true)
                (opt-uncount-instr-uses-array items instr))
              unit)
            (set! index (- index 1)))))
      changed)))

(define (opt-dce-blocks-array-have-dead!
  [items : (__tl_dyn-array i64)]
  [mirror : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [block-changed : bool
              (opt-dce-instr-seq-array-has-dead! items mirror instrs)]
            (or
              block-changed
              (opt-dce-blocks-array-have-dead!
                items
                mirror
                (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-dce-blocks-array-have-dead!
        items
        mirror
        (ir.compiler-ir-block-seq-to-list seq))]))

;; The dry run walks against a COPY of the use counts so the real sweep still
;; sees its own starting state. That copy is only sound for decisions the dry
;; run merely OBSERVES: `opt-instr-dead-array?` also REWRITES (`eq (bit_and a b)
;; 0` into `bit_test_*`, `not (cmp a b)` into the inverted compare) in place,
;; and each rewrite retires an operand's last use. Applied to the copy alone
;; that leaves `items` claiming the operand is still read, so the real sweep
;; keeps an instruction that is now dead -- which is what emitted the `and` next
;; to the `test` that recomputes it, and the `xorq $1` after a `setcc`. `items`
;; is therefore passed as the dry run's MIRROR: the rewrites retire the use in
;; both arrays, so the real sweep starts from counts that match the rewritten
;; IR. Re-deriving the counts from the rewritten blocks instead is equally
;; correct but costs a zeroed allocation plus a third full walk on every pass
;; that folded; mirroring is O(1) per rewrite and allocates nothing.
(define (opt-dce-block-list-array-pass
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : OptBlockListPassResult
  (if (opt-dce-blocks-array-have-dead! (opt-dce-copy-used items) items blocks)
    (OptBlockListPassResult.Result (opt-dce-block-list-array items blocks) true)
    (OptBlockListPassResult.Result blocks false)))

;; A backward instruction sweep only cascades within one block. When a dead
;; user sits in a later block than its definition, forward block order removes
;; the user after the definition's block has already been visited. Recollect
;; uses and sweep until nothing changes so the final optimizer round does not
;; strand one link of a cross-block dead chain per block.
(define (opt-dce-block-list-array-fixpoint
  [frame : i64]
  [blocks : ir.CompilerIrBlockList]
  [fuel : i64]) : ir.CompilerIrBlockList
  (match (opt-dce-block-list-array-pass
    (opt-collect-blocks-uses-array frame blocks)
    blocks)
    [(OptBlockListPassResult.Result next changed?)
      (if (and changed? (> fuel 1))
        (opt-dce-block-list-array-fixpoint frame next (- fuel 1))
        next)]))

(define (opt-dce-block-seq-array-in-place!
  [items : (__tl_dyn-array i64)]
  [seq : ir.CompilerIrBlockSeq]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
    [count : i64 seq.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (opt-dce-block-array-in-place items (array-ref slots index)))
          (set! index (+ index 1))))
      unit)))

(define (opt-dce-block-list-array-in-place
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-dce-block-array-in-place items block)
        (opt-dce-block-list-array-in-place items (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (begin
        (opt-dce-block-seq-array-in-place! items seq)
        blocks)]))

(define (opt-dce-instr-seq-array-escape
  [pools : ast.AstNodePoolContext]
  [items : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [src-slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out-slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 (- count 1)]
    [write : i64 (- count 1)]
    [live-count : i64 0]
    [src : i64 0]
    [dst : i64 0]
    (begin
      (while (>= index 0)
        (begin
          (let
            [instr : ir.CompilerIrInstr (array-ref src-slots index)]
            (if (opt-instr-dead-array?
              items
              (opt-dce-no-mirror-shared-view)
              src-slots
              count
              index
              instr)
              ;; Deleting this instruction drops the uses it made, so a value it
              ;; was the last reader of becomes dead for an earlier sweep step.
              (opt-uncount-instr-uses-array items instr)
              (begin
                (set!
                  (array-ref out-slots write)
                  (ir.compiler-ir-clone-instr pools instr))
                (set! write (- write 1)))))
          (set! index (- index 1))))
      (set! live-count (- count (+ write 1)))
      (set! src (+ write 1))
      (set! dst 0)
      (while (< dst live-count)
        (begin
          (if (not (= dst src))
            (set! (array-ref out-slots dst) (array-ref out-slots src))
            unit)
          (set! dst (+ dst 1))
          (set! src (+ src 1))))
      (ir.CompilerIrInstrSeq out-slots live-count))))

(define (opt-dce-block-array-escape
  [pools : ast.AstNodePoolContext]
  [items : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        (clone label)
        (opt-dce-instr-seq-array-escape pools items instrs))]))

(define (opt-dce-block-list-array-escape-fill
  [pools : ast.AstNodePoolContext]
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [slots : (__tl_dyn-array ir.CompilerIrBlock)]
  [index : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) index]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (set!
          (array-ref slots index)
          (opt-dce-block-array-escape pools items block))
        (opt-dce-block-list-array-escape-fill
          pools
          items
          (__tl-box-place rest)
          slots
          (+ index 1)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [src-slots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
        [count : i64 seq.len]
        [offset : i64 0]
        (begin
          (while (< offset count)
            (begin
              (set!
                (array-ref slots (+ index offset))
                (opt-dce-block-array-escape
                  pools
                  items
                  (array-ref src-slots offset)))
              (set! offset (+ offset 1))))
          (+ index count)))]))

(define (opt-dce-block-list-array-escape
  [pools : ast.AstNodePoolContext]
  [items : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [count : i64 (ir.compiler-ir-block-list-count blocks)]
    [slots : (__tl_dyn-array ir.CompilerIrBlock)
      (array.make-array ir.CompilerIrBlock count)]
    [written : i64
      (opt-dce-block-list-array-escape-fill pools items blocks slots 0)]
    (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots written))))

;; --- aggregate allocation candidate analysis --------------------------------
;;
;; This is intentionally analysis-only. It recognizes heap aggregate allocations
;; that stay local to a function and records the constant-offset derived pointers
;; plus load/store accesses that a later scalar-replacement slice can consume.
(define (opt-aggregate-fixed-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Tuple _) true]
    [(ast.AstType.Array _ _) true]
    [_ false]))

(define (opt-aggregate-tl-alloc-size [args : ir.CompilerIrCallArgs]) : option_i64.Option
  (match args
    [(ir.CompilerIrCallArgs.One value)
      (match value
        [(ir.CompilerIrValue.I64 size) (option_i64.Some size)]
        [_ (option_i64.None)])]
    [_ (option_i64.None)]))

(define (opt-aggregate-direct-alloc [instr : ir.CompilerIrInstr]) : OptMaybeAggregateAlloc
  (match instr
    [(ir.CompilerIrInstr.Call dst name args ty)
      (if (and
        (ir.compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc)
        (opt-aggregate-fixed-type? ty))
        (match (opt-aggregate-tl-alloc-size args)
          [(option_i64.Some size)
            (if (> size 0)
              (OptMaybeAggregateAlloc.Some dst ty size)
              (OptMaybeAggregateAlloc.No))]
          [(option_i64.None) (OptMaybeAggregateAlloc.No)])
        (OptMaybeAggregateAlloc.No))]
    [_ (OptMaybeAggregateAlloc.No)]))

(define (opt-aggregate-pointer-list-lookup-from
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [var : i64]
  [index : i64]) : option_i64.Option
  (if (< index 0)
    (option_i64.None)
    (match (opt_aggregate_pointer_vec.get
      (& ptrs)
      index
      (OptAggregatePointer.Pointer 0 0))
      [(OptAggregatePointer.Pointer ptr-var offset)
        (if (= ptr-var var)
          (option_i64.Some offset)
          (opt-aggregate-pointer-list-lookup-from ptrs var (- index 1)))])))

(define (opt-aggregate-pointer-list-lookup
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [var : i64]) : option_i64.Option
  (opt-aggregate-pointer-list-lookup-from
    ptrs
    var
    (- (opt_aggregate_pointer_vec.len (& ptrs)) 1)))

(define (opt-aggregate-value-offset
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [value : ir.CompilerIrValue]) : option_i64.Option
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (= var base)
        (option_i64.Some 0)
        (opt-aggregate-pointer-list-lookup ptrs var))]
    [_ (option_i64.None)]))

(define (opt-aggregate-value-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [value : ir.CompilerIrValue]) : bool
  (match (opt-aggregate-value-offset base ptrs value)
    [(option_i64.Some _) true]
    [(option_i64.None) false]))

(define (opt-aggregate-call-args-array-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length values))
    false
    (or
      (opt-aggregate-value-has-pointer? base ptrs (array-ref values index))
      (opt-aggregate-call-args-array-has-pointer? base ptrs values (+ index 1)))))

(define (opt-aggregate-call-args-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [args : ir.CompilerIrCallArgs]) : bool
  (match args
    [(ir.CompilerIrCallArgs.Nil) false]
    [(ir.CompilerIrCallArgs.One value)
      (opt-aggregate-value-has-pointer? base ptrs value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (or
        (opt-aggregate-value-has-pointer? base ptrs a)
        (opt-aggregate-value-has-pointer? base ptrs b))]
    [(ir.CompilerIrCallArgs.Array values)
      (opt-aggregate-call-args-array-has-pointer? base ptrs values 0)]))

(define (opt-aggregate-spmd-call-args-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [args : ir.CompilerIrSpmdCallArgList]) : bool
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) false]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(ir.CompilerIrSpmdCallArg.Arg _ value _)
          (or
            (opt-aggregate-value-has-pointer? base ptrs value)
            (opt-aggregate-spmd-call-args-has-pointer?
              base
              ptrs
              (__tl-box-place rest)))])]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [found : bool false]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        (begin
          (while (and (< i count) (not found))
            (begin
              (match (array-ref slots i)
                [(ir.CompilerIrSpmdCallArg.Arg _ value _)
                  (if (opt-aggregate-value-has-pointer? base ptrs value)
                    (set! found true)
                    unit)])
              (set! i (+ i 1))))
          found))]))

(define (opt-aggregate-maybe-value-has-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [maybe : ir.CompilerIrMaybeValue]) : bool
  (match maybe
    [(ir.CompilerIrMaybeValue.No) false]
    [(ir.CompilerIrMaybeValue.Some value)
      (opt-aggregate-value-has-pointer? base ptrs value)]))

(define (opt-aggregate-phi-inputs-have-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-aggregate-phi-inputs-have-pointer?
        base
        ptrs
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (or
        (opt-aggregate-value-has-pointer? base ptrs value)
        (opt-aggregate-phi-inputs-have-pointer? base ptrs (__tl-box-place rest)))]))

(define (opt-aggregate-raw-var-is-pointer?
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]
  [var : i64]) : bool
  (or
    (= var base)
    (match (opt-aggregate-pointer-list-lookup ptrs var)
      [(option_i64.Some _) true]
      [(option_i64.None) false])))

(define (opt-aggregate-instr-has-pointer?
  [instr : ir.CompilerIrInstr]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.AddrOf _ src)
      (opt-aggregate-raw-var-is-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.Gep _ src offset _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs src)
        (opt-aggregate-value-has-pointer? base ptrs offset))]
    [(ir.CompilerIrInstr.Load _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs ptr)
        (opt-aggregate-value-has-pointer? base ptrs value))]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs dst)
        (opt-aggregate-value-has-pointer? base ptrs src))]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs index)
        (opt-aggregate-value-has-pointer? base ptrs length))]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs lhs)
        (opt-aggregate-value-has-pointer? base ptrs rhs))]
    [(ir.CompilerIrInstr.UnOp _ _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.Splat _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs lhs)
          (opt-aggregate-value-has-pointer? base ptrs rhs)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs src)
          (opt-aggregate-value-has-pointer? base ptrs carry)))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs lhs)
          (opt-aggregate-value-has-pointer? base ptrs rhs)))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs lhs)
        (opt-aggregate-value-has-pointer? base ptrs rhs))]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs mask)
          (opt-aggregate-value-has-pointer? base ptrs on-true)
          (opt-aggregate-value-has-pointer? base ptrs on-false)))]
    [(ir.CompilerIrInstr.VectorLoad _ vector-base index _ _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs vector-base)
        (opt-aggregate-value-has-pointer? base ptrs index))]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [vector-base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs vector-base)
          (opt-aggregate-value-has-pointer? base ptrs index)
          (opt-aggregate-value-has-pointer? base ptrs value)))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [store-base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs store-base)
          (opt-aggregate-value-has-pointer? base ptrs index)
          (opt-aggregate-value-has-pointer? base ptrs value)
          (opt-aggregate-value-has-pointer? base ptrs mask)))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [load-base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs load-base)
          (opt-aggregate-value-has-pointer? base ptrs index)
          (opt-aggregate-value-has-pointer? base ptrs mask)))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [load-base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs load-base)
          (opt-aggregate-value-has-pointer? base ptrs index-base)
          (opt-aggregate-value-has-pointer? base ptrs index)))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs source)
          (opt-aggregate-value-has-pointer? base ptrs selector-low)
          (match selector-high
            [(ir.CompilerIrMaybeValue.Some value)
              (opt-aggregate-value-has-pointer? base ptrs value)]
            [(ir.CompilerIrMaybeValue.No) false])
          (opt-aggregate-value-has-pointer? base ptrs active-lanes)))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs index)
        (opt-aggregate-value-has-pointer? base ptrs length))]
    [(ir.CompilerIrInstr.EntryArgc _) false]
    [(ir.CompilerIrInstr.EntryArgv _) false]
    [(ir.CompilerIrInstr.EntryEnvp _) false]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs leaf)
        (opt-aggregate-value-has-pointer? base ptrs subleaf))]
    [(ir.CompilerIrInstr.Xgetbv _ index)
      (opt-aggregate-value-has-pointer? base ptrs index)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(ir.CompilerIrInstr.Call _ _ args _)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [store-base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs store-base)
          (opt-aggregate-call-args-has-pointer? base ptrs args)))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [store-base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs store-base)
          (opt-aggregate-value-has-pointer? base ptrs func)
          (opt-aggregate-call-args-has-pointer? base ptrs args)))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (or
          (opt-aggregate-value-has-pointer? base ptrs active-mask)
          (opt-aggregate-spmd-call-args-has-pointer? base ptrs args)))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (opt-aggregate-call-args-has-pointer? base ptrs args)]
    [(ir.CompilerIrInstr.Store _ value _)
      (opt-aggregate-value-has-pointer? base ptrs value)]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (opt-aggregate-value-has-pointer? base ptrs cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (opt-aggregate-value-has-pointer? base ptrs cond)]
    [(ir.CompilerIrInstr.Switch index _ _ _)
      (opt-aggregate-value-has-pointer? base ptrs index)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (opt-aggregate-value-has-pointer? base ptrs index)]
    [(ir.CompilerIrInstr.Return maybe)
      (opt-aggregate-maybe-value-has-pointer? base ptrs maybe)]
    [(ir.CompilerIrInstr.Phi _ inputs _)
      (opt-aggregate-phi-inputs-have-pointer? base ptrs inputs)]
    [(ir.CompilerIrInstr.TailCallIndirect func args _)
      (or
        (opt-aggregate-value-has-pointer? base ptrs func)
        (opt-aggregate-call-args-has-pointer? base ptrs args))]
    [_ false]))

(define (opt-aggregate-instrs-touch-candidate?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (opt-aggregate-instr-has-pointer?
        (ir.compiler-ir-instr-seq-ref instrs index)
        base
        ptrs)
      (opt-aggregate-instrs-touch-candidate? instrs (+ index 1) base ptrs))))

(define (opt-aggregate-instr-known-safe?
  [instr : ir.CompilerIrInstr]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call dst name _ _)
      (and
        (= dst base)
        (ir.compiler-ir-symbol-eq? name cbi.compiler-builtin-id-tl-alloc))]
    [(ir.CompilerIrInstr.Gep _ src offset _)
      (match (opt-aggregate-value-offset base ptrs src)
        [(option_i64.Some _)
          (match offset
            [(ir.CompilerIrValue.I64 _) true]
            [_ false])]
        [(option_i64.None) false])]
    [(ir.CompilerIrInstr.Load _ src _)
      (opt-aggregate-value-has-pointer? base ptrs src)]
    [(ir.CompilerIrInstr.StorePtr ptr value _)
      (and
        (opt-aggregate-value-has-pointer? base ptrs ptr)
        (not (opt-aggregate-value-has-pointer? base ptrs value)))]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) false]
    [_ false]))

(define (opt-aggregate-instr-crosses-unknown-effect?
  [instr : ir.CompilerIrInstr]
  [base : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec]) : bool
  (if (opt-aggregate-instr-known-safe? instr base ptrs)
    false
    (ir.compiler-ir-effect-invalidates-cse? (ir.compiler-ir-instr-effect instr))))

(define (opt-aggregate-scan-instrs
  [type-segment-bases : i64]
  [base : i64]
  [ty : ast.AstType]
  [size : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [ptrs : opt_aggregate_pointer_vec.Vec (:consume)]
  [accesses : opt_aggregate_access_vec.Vec (:consume)]
  [seen-alloc : bool]) : OptAggregateScanResult
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (if seen-alloc
      (OptAggregateScanResult.Ok ptrs accesses)
      (OptAggregateScanResult.Reject))
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (if (not seen-alloc)
        (match (opt-aggregate-direct-alloc instr)
          [(OptMaybeAggregateAlloc.Some dst alloc-ty alloc-size)
            (if (and
              (= dst base)
              (= alloc-size size)
              (opt-type-eq type-segment-bases alloc-ty ty))
              (opt-aggregate-scan-instrs
                type-segment-bases
                base
                ty
                size
                instrs
                (+ index 1)
                ptrs
                accesses
                true)
              (opt-aggregate-scan-instrs
                type-segment-bases
                base
                ty
                size
                instrs
                (+ index 1)
                ptrs
                accesses
                false))]
          [(OptMaybeAggregateAlloc.No)
            (opt-aggregate-scan-instrs
              type-segment-bases
              base
              ty
              size
              instrs
              (+ index 1)
              ptrs
              accesses
              false)])
        (match instr
          [(ir.CompilerIrInstr.Gep dst src offset _)
            (match (opt-aggregate-value-offset base ptrs src)
              [(option_i64.Some base-offset)
                (match offset
                  [(ir.CompilerIrValue.I64 field-offset)
                    (begin
                      (opt_aggregate_pointer_vec.push
                        (&mut ptrs)
                        (OptAggregatePointer.Pointer
                          dst
                          (+ base-offset field-offset)))
                      (opt-aggregate-scan-instrs
                        type-segment-bases
                        base
                        ty
                        size
                        instrs
                        (+ index 1)
                        ptrs
                        accesses
                        true))]
                  [_ (OptAggregateScanResult.Reject)])]
              [(option_i64.None)
                (if (opt-aggregate-value-has-pointer? base ptrs offset)
                  (OptAggregateScanResult.Reject)
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    instrs
                    (+ index 1)
                    ptrs
                    accesses
                    true))])]
          [(ir.CompilerIrInstr.Load dst src load-ty)
            (match (opt-aggregate-value-offset base ptrs src)
              [(option_i64.Some offset)
                (begin
                  (opt_aggregate_access_vec.push
                    (&mut accesses)
                    (OptAggregateAccess.Load dst offset load-ty))
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    instrs
                    (+ index 1)
                    ptrs
                    accesses
                    true))]
              [(option_i64.None)
                (if (opt-aggregate-instrs-touch-candidate?
                  instrs
                  (+ index 1)
                  base
                  ptrs)
                  (OptAggregateScanResult.Reject)
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    instrs
                    (+ index 1)
                    ptrs
                    accesses
                    true))])]
          [(ir.CompilerIrInstr.StorePtr ptr value store-ty)
            (match (opt-aggregate-value-offset base ptrs ptr)
              [(option_i64.Some offset)
                (if (opt-aggregate-value-has-pointer? base ptrs value)
                  (OptAggregateScanResult.Reject)
                  (begin
                    (opt_aggregate_access_vec.push
                      (&mut accesses)
                      (OptAggregateAccess.Store offset store-ty))
                    (opt-aggregate-scan-instrs
                      type-segment-bases
                      base
                      ty
                      size
                      instrs
                      (+ index 1)
                      ptrs
                      accesses
                      true)))]
              [(option_i64.None)
                (if (or
                  (opt-aggregate-value-has-pointer? base ptrs value)
                  (and
                    (ir.compiler-ir-effect-invalidates-cse?
                      (ir.compiler-ir-instr-effect instr))
                    (opt-aggregate-instrs-touch-candidate?
                      instrs
                      (+ index 1)
                      base
                      ptrs)))
                  (OptAggregateScanResult.Reject)
                  (opt-aggregate-scan-instrs
                    type-segment-bases
                    base
                    ty
                    size
                    instrs
                    (+ index 1)
                    ptrs
                    accesses
                    true))])]
          [_
            (if (opt-aggregate-instr-has-pointer? instr base ptrs)
              (OptAggregateScanResult.Reject)
              (if (and
                (opt-aggregate-instr-crosses-unknown-effect? instr base ptrs)
                (opt-aggregate-instrs-touch-candidate?
                  instrs
                  (+ index 1)
                  base
                  ptrs))
                (OptAggregateScanResult.Reject)
                (opt-aggregate-scan-instrs
                  type-segment-bases
                  base
                  ty
                  size
                  instrs
                  (+ index 1)
                  ptrs
                  accesses
                  true)))])))))

(define (opt-aggregate-classify-one
  [type-segment-bases : i64]
  [base : i64]
  [ty : ast.AstType]
  [size : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [start : i64]) : OptAggregateScanResult
  (opt-aggregate-scan-instrs
    type-segment-bases
    base
    ty
    size
    instrs
    start
    (opt_aggregate_pointer_vec.with-capacity
      opt-aggregate-list-initial-capacity)
    (opt_aggregate_access_vec.with-capacity opt-aggregate-list-initial-capacity)
    false))

(define (opt-aggregate-candidates-from-instrs
  [type-segment-bases : i64]
  [scan : ir.CompilerIrInstrSeq]
  [candidates : opt_aggregate_candidate_vec.Vec (:consume)]) : opt_aggregate_candidate_vec.Vec
  (let
    [index : i64 0]
    (opt-aggregate-candidates-from-instrs-at
      type-segment-bases
      scan
      index
      candidates)))

(define (opt-aggregate-candidates-from-instrs-at
  [type-segment-bases : i64]
  [scan : ir.CompilerIrInstrSeq]
  [index : i64]
  [candidates : opt_aggregate_candidate_vec.Vec (:consume)]) : opt_aggregate_candidate_vec.Vec
  (if (>= index (ir.compiler-ir-instr-seq-count scan))
    candidates
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref scan index)]
      (match (opt-aggregate-direct-alloc instr)
        [(OptMaybeAggregateAlloc.Some base ty size)
          (match (opt-aggregate-classify-one
            type-segment-bases
            base
            ty
            size
            scan
            index)
            [(OptAggregateScanResult.Ok ptrs accesses)
              (begin
                (opt_aggregate_candidate_vec.push
                  (&mut candidates)
                  (OptAggregateAllocCandidate.Candidate
                    base
                    ty
                    size
                    ptrs
                    accesses))
                (opt-aggregate-candidates-from-instrs-at
                  type-segment-bases
                  scan
                  (+ index 1)
                  candidates))]
            [(OptAggregateScanResult.Reject)
              (opt-aggregate-candidates-from-instrs-at
                type-segment-bases
                scan
                (+ index 1)
                candidates)])]
        [(OptMaybeAggregateAlloc.No)
          (opt-aggregate-candidates-from-instrs-at
            type-segment-bases
            scan
            (+ index 1)
            candidates)]))))

(define (opt-aggregate-instr-list-append
  [left : ir.CompilerIrInstrList]
  [right : ir.CompilerIrInstrList]) : ir.CompilerIrInstrList
  (match left
    [(ir.CompilerIrInstrList.Nil) right]
    [(ir.CompilerIrInstrList.Cons head rest)
      (ir.compiler-ir-instr-cons
        head
        (opt-aggregate-instr-list-append (__tl-box-place rest) right))]))

(define (opt-aggregate-append-blocks!
  [blocks : ir.CompilerIrBlockList]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (ir.compiler-ir-instr-builder-append-seq-range!
              builder
              instrs
              0
              (ir.compiler-ir-instr-seq-count instrs))])
        (opt-aggregate-append-blocks! (__tl-box-place rest) builder))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< index count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq index)
              [(ir.CompilerIrBlock.Block _ instrs)
                (ir.compiler-ir-instr-builder-append-seq-range!
                  builder
                  instrs
                  0
                  (ir.compiler-ir-instr-seq-count instrs))])
            (set! index (+ index 1)))))]))

(define (opt-aggregate-flatten-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrInstrSeq
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity
        (ir.compiler-ir-block-list-instruction-count blocks))]
    (begin
      (opt-aggregate-append-blocks! blocks (&mut builder))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-aggregate-allocation-candidates-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : opt_aggregate_candidate_vec.Vec
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (opt-aggregate-candidates-from-instrs
        type-segment-bases
        (opt-aggregate-flatten-blocks blocks)
        (opt_aggregate_candidate_vec.with-capacity
          opt-aggregate-list-initial-capacity))]))

(define (opt-aggregate-candidate-list-append
  [left : opt_aggregate_candidate_vec.Vec (:consume)]
  [right : opt_aggregate_candidate_vec.Vec]) : opt_aggregate_candidate_vec.Vec
  (let
    [right-count : i64 (opt_aggregate_candidate_vec.len (& right))]
    [i : i64 0]
    (begin
      (while (< i right-count)
        (begin
          (opt_aggregate_candidate_vec.push
            (&mut left)
            (array-ref (opt_aggregate_candidate_vec.slots (& right)) i))
          (set! i (+ i 1))))
      left)))

(define (opt-aggregate-allocation-candidates-functions
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionList]) : opt_aggregate_candidate_vec.Vec
  (match functions
    [(ir.CompilerIrFunctionList.Nil)
      (opt_aggregate_candidate_vec.with-capacity 0)]
    [(ir.CompilerIrFunctionList.Cons func rest)
      (opt-aggregate-candidate-list-append
        (opt-aggregate-allocation-candidates-function type-segment-bases func)
        (opt-aggregate-allocation-candidates-functions
          type-segment-bases
          (__tl-box-place rest)))]
    [(ir.CompilerIrFunctionList.Array seq)
      (opt-aggregate-allocation-candidates-functions
        type-segment-bases
        (ir.compiler-ir-function-seq-to-list seq))]))

(define (opt-aggregate-allocation-candidates
  [type-segment-bases : i64]
  [program : ir.CompilerIrProgram]) : opt_aggregate_candidate_vec.Vec
  (match program
    [(ir.CompilerIrProgram.Program _ functions _)
      (opt-aggregate-allocation-candidates-functions
        type-segment-bases
        functions)]))

(define (opt-aggregate-candidate-list-count
  [candidates : opt_aggregate_candidate_vec.Vec]) : i64
  (opt_aggregate_candidate_vec.len (& candidates)))

(define (opt-aggregate-pointer-list-count
  [ptrs : opt_aggregate_pointer_vec.Vec]) : i64
  (opt_aggregate_pointer_vec.len (& ptrs)))

(define (opt-aggregate-access-list-load-count-from
  [accesses : opt_aggregate_access_vec.Vec]
  [index : i64]) : i64
  (if (>= index (opt_aggregate_access_vec.len (& accesses)))
    0
    (+
      (match (opt_aggregate_access_vec.get
        (& accesses)
        index
        (OptAggregateAccess.Store 0 (ast.AstType.Unit)))
        [(OptAggregateAccess.Load _ _ _) 1]
        [_ 0])
      (opt-aggregate-access-list-load-count-from accesses (+ index 1)))))

(define (opt-aggregate-access-list-load-count
  [accesses : opt_aggregate_access_vec.Vec]) : i64
  (opt-aggregate-access-list-load-count-from accesses 0))

(define (opt-aggregate-access-list-store-count-from
  [accesses : opt_aggregate_access_vec.Vec]
  [index : i64]) : i64
  (if (>= index (opt_aggregate_access_vec.len (& accesses)))
    0
    (+
      (match (opt_aggregate_access_vec.get
        (& accesses)
        index
        (OptAggregateAccess.Store 0 (ast.AstType.Unit)))
        [(OptAggregateAccess.Store _ _) 1]
        [_ 0])
      (opt-aggregate-access-list-store-count-from accesses (+ index 1)))))

(define (opt-aggregate-access-list-store-count
  [accesses : opt_aggregate_access_vec.Vec]) : i64
  (opt-aggregate-access-list-store-count-from accesses 0))

;; --- aggregate stack promotion ----------------------------------------------
;;
;; Reuse the non-escaping aggregate classifier, but keep this first promotion
;; slice conservative: only fixed handle-shaped structs/enums/tuples are moved
;; onto local frame storage. Dynamic arrays and array payloads stay heap-backed.
;;
;; The backend frame model exposes 8-byte slots. To preserve positive byte
;; offsets from the aggregate base, the address points at the lowest-addressed
;; reserved slot; offset +8 then walks back toward earlier reserved slots.
(define (opt-aggregate-stack-promote-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Tuple _) true]
    [_ false]))

(define (opt-aggregate-stack-promote-instr-candidate?
  [instr : ir.CompilerIrInstr]) : bool
  (match (opt-aggregate-direct-alloc instr)
    [(OptMaybeAggregateAlloc.Some _ ty _)
      (opt-aggregate-stack-promote-type? ty)]
    [(OptMaybeAggregateAlloc.No) false]))

(define (opt-aggregate-stack-promote-instr-seq-candidate-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (opt-aggregate-stack-promote-instr-candidate?
      (ir.compiler-ir-instr-seq-ref instrs index))
      true
      (opt-aggregate-stack-promote-instr-seq-candidate-from? instrs (+ index 1)))))

(define (opt-aggregate-stack-promote-block-candidate?
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (opt-aggregate-stack-promote-instr-seq-candidate-from? instrs 0)]))

(define (opt-aggregate-stack-promote-block-seq-candidate-from?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (if (opt-aggregate-stack-promote-block-candidate?
      (ir.compiler-ir-block-seq-ref blocks index))
      true
      (opt-aggregate-stack-promote-block-seq-candidate-from? blocks (+ index 1)))))

(define (opt-aggregate-stack-promote-blocks-have-candidate?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (opt-aggregate-stack-promote-block-candidate? block)
        true
        (opt-aggregate-stack-promote-blocks-have-candidate?
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-aggregate-stack-promote-block-seq-candidate-from? seq 0)]))

(define (opt-aggregate-stack-slot-count [size : i64]) : i64
  (if (< size 1)
    1
    (/ (+ size 7) 8)))

(define (opt-aggregate-promote-build
  [candidates : opt_aggregate_candidate_vec.Vec]
  [next-frame : i64]) : OptAggregatePromoteBuild
  (let
    [candidate-slots : (&
      candidates
      (__tl_dyn-array OptAggregateAllocCandidate))
      (opt_aggregate_candidate_vec.slots (& candidates))]
    [candidate-count : i64 (opt_aggregate_candidate_vec.len (& candidates))]
    [promote-slots : opt_aggregate_promote_slot_vec.Vec
      (opt_aggregate_promote_slot_vec.with-capacity
        opt-aggregate-list-initial-capacity)]
    [frame : i64 next-frame]
    [index : i64 0]
    (begin
      (while (< index candidate-count)
        (begin
          (match (array-ref candidate-slots index)
            [(OptAggregateAllocCandidate.Candidate base ty size _ _)
              (if (opt-aggregate-stack-promote-type? ty)
                (let
                  [slot-count : i64 (opt-aggregate-stack-slot-count size)]
                  [storage : i64 (+ frame (- slot-count 1))]
                  (begin
                    (opt_aggregate_promote_slot_vec.push
                      (&mut promote-slots)
                      (OptAggregatePromoteSlot.Slot base storage))
                    (set! frame (+ frame slot-count))))
                unit)])
          (set! index (+ index 1))))
      (OptAggregatePromoteBuild.Build promote-slots frame))))

(define (opt-aggregate-promote-lookup-from
  [slot-list : opt_aggregate_promote_slot_vec.Vec]
  [base : i64]
  [index : i64]) : option_i64.Option
  (if (>= index (opt_aggregate_promote_slot_vec.len (& slot-list)))
    (option_i64.None)
    (match (opt_aggregate_promote_slot_vec.get
      (& slot-list)
      index
      (OptAggregatePromoteSlot.Slot 0 0))
      [(OptAggregatePromoteSlot.Slot found storage)
        (if (= found base)
          (option_i64.Some storage)
          (opt-aggregate-promote-lookup-from slot-list base (+ index 1)))])))

(define (opt-aggregate-promote-lookup
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [base : i64]) : option_i64.Option
  (opt-aggregate-promote-lookup-from slots base 0))

;; Dense forward rebuild of one block under the slot plan: a promotable direct
;; alloc becomes one consecutive `alloc` per reserved frame slot (ending at
;; `storage`), followed by `addr_of base storage`. This is the same contiguous
;; reservation shape emitted by lowering; every other instr is kept. Blocks
;; without a stack-promotable alloc, or whose allocs all escaped the slot plan,
;; keep the ORIGINAL block value by reference. refs #5726
(define (opt-aggregate-promote-alloc-run!
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]
  [storage : i64]
  [ty : ast.AstType]
  [size : i64]) : unit
  (let
    [slot-count : i64 (opt-aggregate-stack-slot-count size)]
    [slot : i64 (+ (- storage slot-count) 1)]
    (while (<= slot storage)
      (begin
        (ir.compiler-ir-instr-builder-push!
          builder
          (ir.CompilerIrInstr.Alloc slot ty))
        (set! slot (+ slot 1))))))

(define (opt-aggregate-promote-block
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (not (opt-aggregate-stack-promote-block-candidate? block))
        block
        (let
          [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
          [builder : ir.CompilerIrInstrBuilder
            (ir.compiler-ir-instr-builder-with-capacity count)]
          [changed : bool false]
          [index : i64 0]
          (begin
            (while (< index count)
              (let
                [instr : ir.CompilerIrInstr
                  (ir.compiler-ir-instr-seq-ref instrs index)]
                (begin
                  (match (opt-aggregate-direct-alloc instr)
                    [(OptMaybeAggregateAlloc.Some base ty size)
                      (match (opt-aggregate-promote-lookup slots base)
                        [(option_i64.Some storage)
                          (begin
                            (opt-aggregate-promote-alloc-run!
                              (&mut builder)
                              storage
                              ty
                              size)
                            (ir.compiler-ir-instr-builder-push!
                              (&mut builder)
                              (ir.CompilerIrInstr.AddrOf base storage))
                            (set! changed true))]
                        [(option_i64.None)
                          (ir.compiler-ir-instr-builder-push!
                            (&mut builder)
                            instr)])]
                    [(OptMaybeAggregateAlloc.No)
                      (ir.compiler-ir-instr-builder-push! (&mut builder) instr)])
                  (set! index (+ index 1)))))
            (if changed
              (ir.CompilerIrBlock.Block
                label
                (ir.compiler-ir-instr-builder-to-seq builder))
              block))))]))

(define (opt-aggregate-promote-blocks
  [slots : opt_aggregate_promote_slot_vec.Vec]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-aggregate-promote-block slots block)
        (opt-aggregate-promote-blocks slots (__tl-box-place rest)))]
    ;; Dense driver: scan the block sequence in place and write a dense output
    ;; sequence (refs #5726). opt-aggregate-promote-block keeps blocks it does
    ;; not rewrite by reference, so unchanged blocks are never re-sequenced.
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (set!
                (array-ref out index)
                (opt-aggregate-promote-block
                  slots
                  (ir.compiler-ir-block-seq-ref seq index)))
              (set! index (+ index 1))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq out count))))]))

(define (opt-aggregate-stack-promote-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (if (opt-aggregate-stack-promote-blocks-have-candidate? blocks)
        (match (opt-aggregate-promote-build
          (opt-aggregate-allocation-candidates-function type-segment-bases func)
          frame)
          [(OptAggregatePromoteBuild.Build slots promoted-frame)
            (if (= (opt_aggregate_promote_slot_vec.len (& slots)) 0)
              func
              (ir.CompilerIrFunction.Function
                name
                params
                ret-ty
                promoted-frame
                (opt-aggregate-promote-blocks slots blocks)))])
        func)]))

;; --- aggregate field-load scalar replacement (SROA) --------------------------
;; Replaces loads of fields from non-escaping aggregate allocations with the
;; scalar value last stored to that field. Runs after stack promotion so it
;; handles aggregates that promotion left in memory.
(define (opt-aggregate-scalar-replace-type? [ty : ast.AstType]) : bool
  (if (opt-int-or-char-type? ty)
    true
    (match ty
      [(ast.AstType.Bool) true]
      [(ast.AstType.Unit) true]
      [_ false])))

(define (opt-aggregate-candidate-location
  [candidate : OptAggregateAllocCandidate]
  [value : ir.CompilerIrValue]) : OptAggregateLocation
  (match candidate
    [(OptAggregateAllocCandidate.Candidate base _ _ ptrs _)
      (match (opt-aggregate-value-offset base ptrs value)
        [(option_i64.Some offset) (OptAggregateLocation.Some base offset)]
        [(option_i64.None) (OptAggregateLocation.No)])]))

(define (opt-aggregate-location-for-value-from
  [candidates : opt_aggregate_candidate_vec.Vec]
  [value : ir.CompilerIrValue]
  [index : i64]) : OptAggregateLocation
  (if (>= index (opt_aggregate_candidate_vec.len (& candidates)))
    (OptAggregateLocation.No)
    (match (opt-aggregate-candidate-location
      (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) index)
      value)
      [(OptAggregateLocation.Some base offset)
        (OptAggregateLocation.Some base offset)]
      [(OptAggregateLocation.No)
        (opt-aggregate-location-for-value-from candidates value (+ index 1))])))

(define (opt-aggregate-location-for-value
  [candidates : opt_aggregate_candidate_vec.Vec]
  [value : ir.CompilerIrValue]) : OptAggregateLocation
  (opt-aggregate-location-for-value-from candidates value 0))

(define (opt-aggregate-value-is-candidate-pointer?
  [candidates : opt_aggregate_candidate_vec.Vec]
  [value : ir.CompilerIrValue]) : bool
  (match (opt-aggregate-location-for-value candidates value)
    [(OptAggregateLocation.Some _ _) true]
    [(OptAggregateLocation.No) false]))

(define (opt-aggregate-field-facts-unbind
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateFieldFacts.Nil)]
    [(OptAggregateFieldFacts.Cons fact-base fact-offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-unbind (__tl-box-place rest) base offset)]
        (if (and (= fact-base base) (= fact-offset offset))
          rest2
          (OptAggregateFieldFacts.Cons
            fact-base
            fact-offset
            value
            ty
            (box rest2))))]))

(define (opt-aggregate-field-facts-unbind-base
  [facts : OptAggregateFieldFacts]
  [base : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateFieldFacts.Nil)]
    [(OptAggregateFieldFacts.Cons fact-base fact-offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-unbind-base (__tl-box-place rest) base)]
        (if (= fact-base base)
          rest2
          (OptAggregateFieldFacts.Cons
            fact-base
            fact-offset
            value
            ty
            (box rest2))))]))

(define (opt-aggregate-field-facts-bind
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : OptAggregateFieldFacts
  (OptAggregateFieldFacts.Cons
    base
    offset
    value
    ty
    (box (opt-aggregate-field-facts-unbind facts base offset))))

(define (opt-aggregate-field-facts-lookup
  [type-segment-bases : i64]
  [facts : OptAggregateFieldFacts]
  [base : i64]
  [offset : i64]
  [ty : ast.AstType]) : OptAggregateStoredValue
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateStoredValue.No)]
    [(OptAggregateFieldFacts.Cons fact-base fact-offset value fact-ty rest)
      (if (and
        (= fact-base base)
        (= fact-offset offset)
        (opt-type-eq type-segment-bases fact-ty ty))
        (OptAggregateStoredValue.Some value fact-ty)
        (opt-aggregate-field-facts-lookup
          type-segment-bases
          (__tl-box-place rest)
          base
          offset
          ty))]))

(define (opt-aggregate-field-facts-invalidate-var
  [facts : OptAggregateFieldFacts]
  [var : i64]) : OptAggregateFieldFacts
  (match facts
    [(OptAggregateFieldFacts.Nil) (OptAggregateFieldFacts.Nil)]
    [(OptAggregateFieldFacts.Cons base offset value ty rest)
      (let
        [rest2 : OptAggregateFieldFacts
          (opt-aggregate-field-facts-invalidate-var (__tl-box-place rest) var)]
        (if (or (= base var) (opt-value-is-var? value var))
          rest2
          (OptAggregateFieldFacts.Cons base offset value ty (box rest2))))]))

(define (opt-aggregate-sroa-invalidate-def
  [facts : OptAggregateFieldFacts]
  [instr : ir.CompilerIrInstr]) : OptAggregateFieldFacts
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Alloc dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.AddrOf dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Gep dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Load dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Cast dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.BinOp dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.UnOp dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.LaneId dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (opt-aggregate-field-facts-invalidate-var facts dst))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.EntryArgv dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.EntryEnvp dst)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.CpuId dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Xgetbv dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Syscall dst _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Call dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [(ir.CompilerIrInstr.Phi dst _ _)
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    [_ facts]))

(define (opt-aggregate-sroa-store
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [ptr : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]
  [instr : ir.CompilerIrInstr]) : OptAggregateSroaResult
  (match (opt-aggregate-location-for-value candidates ptr)
    [(OptAggregateLocation.Some base offset)
      (if (and
        (opt-aggregate-scalar-replace-type? ty)
        (opt-copy-safe-source? value)
        (not (opt-aggregate-value-is-candidate-pointer? candidates value)))
        (OptAggregateSroaResult.Result
          (opt-aggregate-field-facts-bind facts base offset value ty)
          instr)
        (OptAggregateSroaResult.Result
          (opt-aggregate-field-facts-unbind-base facts base)
          instr))]
    [(OptAggregateLocation.No)
      (OptAggregateSroaResult.Result (OptAggregateFieldFacts.Nil) instr)]))

(define (opt-aggregate-sroa-load
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [ty : ast.AstType]
  [instr : ir.CompilerIrInstr]) : OptAggregateSroaResult
  (let
    [next-facts : OptAggregateFieldFacts
      (opt-aggregate-field-facts-invalidate-var facts dst)]
    (match (opt-aggregate-location-for-value candidates src)
      [(OptAggregateLocation.Some base offset)
        (match (opt-aggregate-field-facts-lookup
          type-segment-bases
          facts
          base
          offset
          ty)
          [(OptAggregateStoredValue.Some value _)
            (OptAggregateSroaResult.Result
              next-facts
              (ir.CompilerIrInstr.Mov dst value ty))]
          [(OptAggregateStoredValue.No)
            (OptAggregateSroaResult.Result next-facts instr)])]
      [(OptAggregateLocation.No)
        (OptAggregateSroaResult.Result next-facts instr)])))

(define (opt-aggregate-sroa-instr
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [facts : OptAggregateFieldFacts]
  [instr : ir.CompilerIrInstr]) : OptAggregateSroaResult
  (match instr
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (opt-aggregate-sroa-store candidates facts ptr value ty instr)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (opt-aggregate-sroa-load
        type-segment-bases
        candidates
        facts
        dst
        src
        ty
        instr)]
    [_
      (let
        [def-facts : OptAggregateFieldFacts
          (opt-aggregate-sroa-invalidate-def facts instr)]
        (if (ir.compiler-ir-effect-invalidates-cse?
          (ir.compiler-ir-instr-effect instr))
          (OptAggregateSroaResult.Result (OptAggregateFieldFacts.Nil) instr)
          (OptAggregateSroaResult.Result def-facts instr)))]))

(define (opt-aggregate-sroa-instr-seq
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    [facts : OptAggregateFieldFacts (OptAggregateFieldFacts.Nil)]
    (begin
      (while (< index count)
        (match (opt-aggregate-sroa-instr
          type-segment-bases
          candidates
          facts
          (ir.compiler-ir-instr-seq-ref instrs index))
          [(OptAggregateSroaResult.Result next-facts next-instr)
            (begin
              (set! (array-ref slots index) next-instr)
              (set! facts next-facts)
              (set! index (+ index 1)))]))
      (ir.CompilerIrInstrSeq slots count))))

(define (opt-aggregate-sroa-block
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (opt-aggregate-sroa-instr-seq type-segment-bases candidates instrs))]))

(define (opt-aggregate-sroa-blocks
  [type-segment-bases : i64]
  [candidates : opt_aggregate_candidate_vec.Vec]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (ir.compiler-ir-block-cons
        (opt-aggregate-sroa-block type-segment-bases candidates block)
        (opt-aggregate-sroa-blocks
          type-segment-bases
          candidates
          (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-aggregate-sroa-blocks
        type-segment-bases
        candidates
        (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-aggregate-sroa-function-pass
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : OptFunctionPassResult
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty frame blocks)
      (let
        [candidates : opt_aggregate_candidate_vec.Vec
          (opt-aggregate-allocation-candidates-function type-segment-bases func)]
        (if (= (opt_aggregate_candidate_vec.len (& candidates)) 0)
          (OptFunctionPassResult.Result func false)
          (OptFunctionPassResult.Result
            (ir.CompilerIrFunction.Function
              name
              params
              ret-ty
              frame
              (opt-aggregate-sroa-blocks type-segment-bases candidates blocks))
            true)))]))

(define (opt-aggregate-sroa-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt-aggregate-sroa-function-pass type-segment-bases func)
    [(OptFunctionPassResult.Result next _) next]))

;; --- block-local common subexpression elimination ---------------------------
;;
;; Within a single basic block, track an available-expression table mapping a
;; pure scalar `BinOp`/`UnOp` expression (operator + operand values) or a
;; repeatable CPU feature probe to the var that first computed it. A later
;; identical expression is rewritten to an `CompilerIrInstr.Mov` from that earlier var.
;; Scope is intentionally block-local and only covers pure scalar arithmetic
;; plus process-stable `cpuid`/`xgetbv` results; memory ops are not CSE'd.
;;
;; Invalidation keeps this correct even though the IR is not strictly SSA: when
;; an instruction (re)defines a var, every table entry whose key references that
;; var as an operand, or whose result is that var, is dropped. Calls, stores
;; (`Store`/`StorePtr`), and all control-flow boundaries clear the whole table
;; (conservative, matching the spec). Commutative operands are NOT canonicalized
;; in this slice.
(defenum OptExprKey
  (BinKey ir.CompilerIrBinOp ir.CompilerIrValue ir.CompilerIrValue ast.AstType)
  (UnKey ir.CompilerIrUnOp ir.CompilerIrValue ast.AstType)
  (CpuIdKey ir.CompilerIrValue ir.CompilerIrValue i64)
  (XgetbvKey ir.CompilerIrValue))

(defenum OptExprTable
  (Nil)
  (Cons OptExprKey i64 (Box OptExprTable)))

(define (opt-binop-tag [op : ir.CompilerIrBinOp]) : i64
  (match op
    [(ir.CompilerIrBinOp.Add) 0]
    [(ir.CompilerIrBinOp.Sub) 1]
    [(ir.CompilerIrBinOp.Mul) 2]
    [(ir.CompilerIrBinOp.Div) 3]
    [(ir.CompilerIrBinOp.Mod) 4]
    [(ir.CompilerIrBinOp.SafeDiv) 5]
    [(ir.CompilerIrBinOp.SafeMod) 6]
    [(ir.CompilerIrBinOp.Eq) 7]
    [(ir.CompilerIrBinOp.Ne) 8]
    [(ir.CompilerIrBinOp.Lt) 9]
    [(ir.CompilerIrBinOp.Le) 10]
    [(ir.CompilerIrBinOp.Gt) 11]
    [(ir.CompilerIrBinOp.Ge) 12]
    [(ir.CompilerIrBinOp.And) 13]
    [(ir.CompilerIrBinOp.Or) 14]
    [(ir.CompilerIrBinOp.BitAnd) 15]
    [(ir.CompilerIrBinOp.BitOr) 16]
    [(ir.CompilerIrBinOp.BitXor) 17]
    [(ir.CompilerIrBinOp.Shl rhs-ty)
      (+ 100 (* 2 (opt-shift-count-type-tag rhs-ty)))]
    [(ir.CompilerIrBinOp.Shr rhs-ty)
      (+ 101 (* 2 (opt-shift-count-type-tag rhs-ty)))]
    [(ir.CompilerIrBinOp.BitTestEq) 20]
    [(ir.CompilerIrBinOp.BitTestNe) 21]))

;; Primitive count-type tags keep CSE/GVN from merging shifts whose trap
;; diagnostics differ by signedness or width.  Shift RHS types are guaranteed
;; integer by type checking; retain a deterministic fallback for malformed
;; hand-authored IR fixtures.
(define (opt-shift-count-type-tag [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I8) 0]
    [(ast.AstType.U8) 1]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 3]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 5]
    [(ast.AstType.I64) 6]
    [(ast.AstType.U64) 7]
    [_ 8]))

(define (opt-binop-eq [a : ir.CompilerIrBinOp] [b : ir.CompilerIrBinOp]) : bool
  (= (opt-binop-tag a) (opt-binop-tag b)))

(define (opt-unop-tag [op : ir.CompilerIrUnOp]) : i64
  (match op
    [(ir.CompilerIrUnOp.Neg) 0]
    [(ir.CompilerIrUnOp.Not) 1]
    [(ir.CompilerIrUnOp.BitNot) 2]
    [(ir.CompilerIrUnOp.Sqrt) 3]))

(define (opt-unop-eq [a : ir.CompilerIrUnOp] [b : ir.CompilerIrUnOp]) : bool
  (= (opt-unop-tag a) (opt-unop-tag b)))

(define (opt-mask-binop-tag [op : ir.CompilerIrMaskBinOp]) : i64
  (match op
    [(ir.CompilerIrMaskBinOp.And) 0]
    [(ir.CompilerIrMaskBinOp.Or) 1]))

(define (opt-mask-binop-eq
  [a : ir.CompilerIrMaskBinOp]
  [b : ir.CompilerIrMaskBinOp]) : bool
  (= (opt-mask-binop-tag a) (opt-mask-binop-tag b)))

(define (opt-vector-reduce-tag [op : ir.CompilerIrVectorReduceOp]) : i64
  (match op
    [(ir.CompilerIrVectorReduceOp.Sum) 0]
    [(ir.CompilerIrVectorReduceOp.Min) 1]
    [(ir.CompilerIrVectorReduceOp.Max) 2]))

(define (opt-vector-reduce-eq
  [a : ir.CompilerIrVectorReduceOp]
  [b : ir.CompilerIrVectorReduceOp]) : bool
  (= (opt-vector-reduce-tag a) (opt-vector-reduce-tag b)))

(define (opt-vector-prefix-op-tag [op : ir.CompilerIrVectorPrefixOp]) : i64
  (match op
    [(ir.CompilerIrVectorPrefixOp.Sum) 0]
    [(ir.CompilerIrVectorPrefixOp.Min) 1]
    [(ir.CompilerIrVectorPrefixOp.Max) 2]
    [(ir.CompilerIrVectorPrefixOp.All) 3]
    [(ir.CompilerIrVectorPrefixOp.Any) 4]))

(define (opt-vector-prefix-op-eq?
  [a : ir.CompilerIrVectorPrefixOp]
  [b : ir.CompilerIrVectorPrefixOp]) : bool
  (= (opt-vector-prefix-op-tag a) (opt-vector-prefix-op-tag b)))

(define (opt-mask-reduce-tag [op : ir.CompilerIrMaskReduceOp]) : i64
  (match op
    [(ir.CompilerIrMaskReduceOp.All) 0]
    [(ir.CompilerIrMaskReduceOp.Any) 1]))

(define (opt-mask-reduce-eq
  [a : ir.CompilerIrMaskReduceOp]
  [b : ir.CompilerIrMaskReduceOp]) : bool
  (= (opt-mask-reduce-tag a) (opt-mask-reduce-tag b)))

(define (opt-value-eq [a : ir.CompilerIrValue] [b : ir.CompilerIrValue]) : bool
  (match a
    [(ir.CompilerIrValue.Var ia)
      (match b
        [(ir.CompilerIrValue.Var ib) (= ia ib)]
        [_ false])]
    [(ir.CompilerIrValue.Global ga)
      (match b
        [(ir.CompilerIrValue.Global gb) (ir.compiler-ir-symbol-eq? ga gb)]
        [_ false])]
    [(ir.CompilerIrValue.GlobalAddr ga)
      (match b
        [(ir.CompilerIrValue.GlobalAddr gb) (ir.compiler-ir-symbol-eq? ga gb)]
        [_ false])]
    [(ir.CompilerIrValue.Function fa)
      (match b
        [(ir.CompilerIrValue.Function fb) (ir.compiler-ir-symbol-eq? fa fb)]
        [_ false])]
    [(ir.CompilerIrValue.I64 na)
      (match b
        [(ir.CompilerIrValue.I64 nb) (= na nb)]
        [_ false])]
    [(ir.CompilerIrValue.F64 fa)
      (match b
        [(ir.CompilerIrValue.F64 fb) (= fa fb)]
        [_ false])]
    [(ir.CompilerIrValue.Bool ba)
      (match b
        [(ir.CompilerIrValue.Bool bb)
          (if ba
            bb
            (not bb))]
        [_ false])]
    [(ir.CompilerIrValue.Char ca)
      (match b
        [(ir.CompilerIrValue.Char cb) (= ca cb)]
        [_ false])]
    [(ir.CompilerIrValue.String sa)
      (match b
        [(ir.CompilerIrValue.String sb) (string.eq sa sb)]
        [_ false])]
    [(ir.CompilerIrValue.Bytes sa)
      (match b
        [(ir.CompilerIrValue.Bytes sb) (string.eq sa sb)]
        [_ false])]
    [(ir.CompilerIrValue.RuntimeGlobal ia)
      (match b
        [(ir.CompilerIrValue.RuntimeGlobal ib)
          (ir.compiler-ir-symbol-eq? ia ib)]
        [_ false])]
    [(ir.CompilerIrValue.Unit)
      (match b
        [(ir.CompilerIrValue.Unit) true]
        [_ false])]))

(define (opt-type-list-eq-at
  [type-segment-bases : i64]
  [a : (& a ast.AstTypeList)]
  [b : (& b ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len a))
    true
    (and
      (opt-type-eq
        type-segment-bases
        (ast.ast-type-segment-bases-get
          type-segment-bases
          (ast.ast-type-list-get a index (ast.ast-type-id-fallback)))
        (ast.ast-type-segment-bases-get
          type-segment-bases
          (ast.ast-type-list-get b index (ast.ast-type-id-fallback))))
      (opt-type-list-eq-at type-segment-bases a b (+ index 1)))))

(define (opt-type-list-eq
  [type-segment-bases : i64]
  [a : ast.AstTypeList]
  [b : ast.AstTypeList]) : bool
  (and
    (= (ast.ast-type-list-len (& a)) (ast.ast-type-list-len (& b)))
    (opt-type-list-eq-at type-segment-bases (& a) (& b) 0)))

(define (opt-lifetime-list-eq-at
  [a : (& a ast.AstLifetimeList)]
  [b : (& b ast.AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-lifetime-list-len a))
    true
    (and
      (=
        (ast.ast-lifetime-list-get a index (ast.ast-lifetime-fallback))
        (ast.ast-lifetime-list-get b index (ast.ast-lifetime-fallback)))
      (opt-lifetime-list-eq-at a b (+ index 1)))))

(define (opt-lifetime-list-eq
  [a : ast.AstLifetimeList]
  [b : ast.AstLifetimeList]) : bool
  (and
    (= (ast.ast-lifetime-list-len (& a)) (ast.ast-lifetime-list-len (& b)))
    (opt-lifetime-list-eq-at (& a) (& b) 0)))

(define (opt-type-eq
  [type-segment-bases : i64]
  [a : ast.AstType]
  [b : ast.AstType]) : bool
  (match a
    [(ast.AstType.I64)
      (match b
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstType.I32)
      (match b
        [(ast.AstType.I32) true]
        [_ false])]
    [(ast.AstType.I16)
      (match b
        [(ast.AstType.I16) true]
        [_ false])]
    [(ast.AstType.I8)
      (match b
        [(ast.AstType.I8) true]
        [_ false])]
    [(ast.AstType.U64)
      (match b
        [(ast.AstType.U64) true]
        [_ false])]
    [(ast.AstType.U32)
      (match b
        [(ast.AstType.U32) true]
        [_ false])]
    [(ast.AstType.U16)
      (match b
        [(ast.AstType.U16) true]
        [_ false])]
    [(ast.AstType.U8)
      (match b
        [(ast.AstType.U8) true]
        [_ false])]
    [(ast.AstType.F64)
      (match b
        [(ast.AstType.F64) true]
        [_ false])]
    [(ast.AstType.F32)
      (match b
        [(ast.AstType.F32) true]
        [_ false])]
    [(ast.AstType.Bool)
      (match b
        [(ast.AstType.Bool) true]
        [_ false])]
    [(ast.AstType.Char)
      (match b
        [(ast.AstType.Char) true]
        [_ false])]
    [(ast.AstType.String)
      (match b
        [(ast.AstType.String) true]
        [_ false])]
    [(ast.AstType.Str)
      (match b
        [(ast.AstType.Str) true]
        [_ false])]
    [(ast.AstType.Bytes)
      (match b
        [(ast.AstType.Bytes) true]
        [_ false])]
    [(ast.AstType.Unit)
      (match b
        [(ast.AstType.Unit) true]
        [_ false])]
    [(ast.AstType.Never)
      (match b
        [(ast.AstType.Never) true]
        [_ false])]
    [(ast.AstType.Expr)
      (match b
        [(ast.AstType.Expr) true]
        [_ false])]
    [(ast.AstType.ExprList)
      (match b
        [(ast.AstType.ExprList) true]
        [_ false])]
    [(ast.AstType.Func a-params a-ret)
      (match b
        [(ast.AstType.Func b-params b-ret)
          (and
            (opt-type-list-eq
              type-segment-bases
              (__tl-box-place a-params)
              (__tl-box-place b-params))
            (opt-type-eq
              type-segment-bases
              (ast.ast-type-segment-bases-get type-segment-bases a-ret)
              (ast.ast-type-segment-bases-get type-segment-bases b-ret)))]
        [_ false])]
    [(ast.AstType.Tuple a-items)
      (match b
        [(ast.AstType.Tuple b-items)
          (opt-type-list-eq
            type-segment-bases
            (__tl-box-place a-items)
            (__tl-box-place b-items))]
        [_ false])]
    [(ast.AstType.Array a-item a-len)
      (match b
        [(ast.AstType.Array b-item b-len)
          (and
            (= a-len b-len)
            (opt-type-eq
              type-segment-bases
              (ast.ast-type-segment-bases-get type-segment-bases a-item)
              (ast.ast-type-segment-bases-get type-segment-bases b-item)))]
        [_ false])]
    [(ast.AstType.DynArray a-item)
      (match b
        [(ast.AstType.DynArray b-item)
          (opt-type-eq
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases a-item)
            (ast.ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(ast.AstType.Slice a-item)
      (match b
        [(ast.AstType.Slice b-item)
          (opt-type-eq
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases a-item)
            (ast.ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(ast.AstType.Box a-item)
      (match b
        [(ast.AstType.Box b-item)
          (opt-type-eq
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases a-item)
            (ast.ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(ast.AstType.Ptr a-item)
      (match b
        [(ast.AstType.Ptr b-item)
          (opt-type-eq
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases a-item)
            (ast.ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(ast.AstType.MutPtr a-item)
      (match b
        [(ast.AstType.MutPtr b-item)
          (opt-type-eq
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases a-item)
            (ast.ast-type-segment-bases-get type-segment-bases b-item))]
        [_ false])]
    [(ast.AstType.Ref a-region a-inner)
      (match b
        [(ast.AstType.Ref b-region b-inner)
          (and
            (= a-region b-region)
            (opt-type-eq
              type-segment-bases
              (ast.ast-type-segment-bases-get type-segment-bases a-inner)
              (ast.ast-type-segment-bases-get type-segment-bases b-inner)))]
        [_ false])]
    [(ast.AstType.MutRef a-region a-inner)
      (match b
        [(ast.AstType.MutRef b-region b-inner)
          (and
            (= a-region b-region)
            (opt-type-eq
              type-segment-bases
              (ast.ast-type-segment-bases-get type-segment-bases a-inner)
              (ast.ast-type-segment-bases-get type-segment-bases b-inner)))]
        [_ false])]
    [(ast.AstType.Region a-region a-inner)
      (match b
        [(ast.AstType.Region b-region b-inner)
          (and
            (= a-region b-region)
            (opt-type-eq
              type-segment-bases
              (ast.ast-type-segment-bases-get type-segment-bases a-inner)
              (ast.ast-type-segment-bases-get type-segment-bases b-inner)))]
        [_ false])]
    [(ast.AstType.Enum a-name)
      (match b
        [(ast.AstType.Enum b-name) (= a-name b-name)]
        [_ false])]
    [(ast.AstType.EnumArgs a-name a-lifetimes)
      (match b
        [(ast.AstType.EnumArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq
              (__tl-box-place a-lifetimes)
              (__tl-box-place b-lifetimes)))]
        [_ false])]
    [(ast.AstType.Struct a-name)
      (match b
        [(ast.AstType.Struct b-name) (= a-name b-name)]
        [_ false])]
    [(ast.AstType.StructArgs a-name a-lifetimes)
      (match b
        [(ast.AstType.StructArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq
              (__tl-box-place a-lifetimes)
              (__tl-box-place b-lifetimes)))]
        [_ false])]
    [(ast.AstType.Var a-name)
      (match b
        [(ast.AstType.Var b-name) (= a-name b-name)]
        [_ false])]
    [(ast.AstType.VarArgs a-name a-lifetimes)
      (match b
        [(ast.AstType.VarArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (opt-lifetime-list-eq
              (__tl-box-place a-lifetimes)
              (__tl-box-place b-lifetimes)))]
        [_ false])]
    [(ast.AstType.Consume a-inner)
      (match b
        [(ast.AstType.Consume b-inner)
          (opt-type-eq
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases a-inner)
            (ast.ast-type-segment-bases-get type-segment-bases b-inner))]
        [_ false])]))

(define (opt-symbol-hash [symbol : i64]) : i64
  (let
    [name-id : i64 (ir.compiler-ir-symbol-id symbol)]
    (if (>= name-id 0)
      (hash.i64 name-id)
      (let
        [text : String (ir.compiler-ir-symbol-text symbol)]
        (hash.string-key (& text))))))

(define (opt-value-hash [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var id) (hash.combine 1 (hash.i64 id))]
    [(ir.CompilerIrValue.Global name) (hash.combine 2 (opt-symbol-hash name))]
    [(ir.CompilerIrValue.GlobalAddr name)
      (hash.combine 3 (opt-symbol-hash name))]
    [(ir.CompilerIrValue.Function name) (hash.combine 4 (opt-symbol-hash name))]
    [(ir.CompilerIrValue.I64 value) (hash.combine 5 (hash.i64 value))]
    [(ir.CompilerIrValue.F64 value)
      (hash.combine 6 (hash.i64 (cast value : i64)))]
    [(ir.CompilerIrValue.Bool value) (hash.combine 7 (hash.bool value))]
    [(ir.CompilerIrValue.Char value) (hash.combine 8 (hash.char value))]
    [(ir.CompilerIrValue.String value)
      (hash.combine 9 (hash.string-key (& value)))]
    [(ir.CompilerIrValue.Bytes value)
      (hash.combine 11 (hash.string-key (& value)))]
    [(ir.CompilerIrValue.RuntimeGlobal init)
      (hash.combine 12 (opt-symbol-hash init))]
    [(ir.CompilerIrValue.Unit) (hash.i64 10)]))

(define (opt-expr-key-hash [type-segment-bases : i64] [key : OptExprKey]) : i64
  (match key
    [(OptExprKey.BinKey op lhs rhs ty)
      (hash.combine
        1
        (hash.combine
          (opt-type-hash type-segment-bases ty)
          (hash.combine
            (hash.i64 (opt-binop-tag op))
            (hash.combine (opt-value-hash lhs) (opt-value-hash rhs)))))]
    [(OptExprKey.UnKey op value ty)
      (hash.combine
        2
        (hash.combine
          (opt-type-hash type-segment-bases ty)
          (hash.combine (hash.i64 (opt-unop-tag op)) (opt-value-hash value))))]
    [(OptExprKey.CpuIdKey leaf subleaf reg-index)
      (hash.combine
        3
        (hash.combine
          (hash.i64 reg-index)
          (hash.combine (opt-value-hash leaf) (opt-value-hash subleaf))))]
    [(OptExprKey.XgetbvKey index) (hash.combine 4 (opt-value-hash index))]))

(define (opt-type-list-hash-at
  [type-segment-bases : i64]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-type-list-len types))
    (hash.i64 0)
    (hash.combine
      1
      (hash.combine
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get
            type-segment-bases
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
        (opt-type-list-hash-at type-segment-bases types (+ index 1))))))

(define (opt-type-list-hash
  [type-segment-bases : i64]
  [types : ast.AstTypeList]) : i64
  (opt-type-list-hash-at type-segment-bases (& types) 0))

(define (opt-lifetime-list-hash-at
  [lifetimes : (& lifetimes ast.AstLifetimeList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-lifetime-list-len lifetimes))
    (hash.i64 0)
    (let
      [head : i64
        (ast.ast-lifetime-list-get lifetimes index (ast.ast-lifetime-fallback))]
      (hash.combine
        1
        (hash.combine
          (hash.i64 head)
          (opt-lifetime-list-hash-at lifetimes (+ index 1)))))))

(define (opt-lifetime-list-hash [lifetimes : ast.AstLifetimeList]) : i64
  (opt-lifetime-list-hash-at (& lifetimes) 0))

(define (opt-type-hash [type-segment-bases : i64] [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) (hash.i64 1)]
    [(ast.AstType.I32) (hash.i64 2)]
    [(ast.AstType.I16) (hash.i64 3)]
    [(ast.AstType.I8) (hash.i64 4)]
    [(ast.AstType.U64) (hash.i64 5)]
    [(ast.AstType.U32) (hash.i64 6)]
    [(ast.AstType.U16) (hash.i64 7)]
    [(ast.AstType.U8) (hash.i64 8)]
    [(ast.AstType.F64) (hash.i64 9)]
    [(ast.AstType.F32) (hash.i64 10)]
    [(ast.AstType.Bool) (hash.i64 11)]
    [(ast.AstType.Char) (hash.i64 12)]
    [(ast.AstType.String) (hash.i64 13)]
    [(ast.AstType.Str) (hash.i64 14)]
    [(ast.AstType.Bytes) (hash.i64 35)]
    [(ast.AstType.Unit) (hash.i64 15)]
    [(ast.AstType.Never) (hash.i64 16)]
    [(ast.AstType.Expr) (hash.i64 17)]
    [(ast.AstType.ExprList) (hash.i64 18)]
    [(ast.AstType.Func params ret)
      (hash.combine
        19
        (hash.combine
          (opt-type-list-hash type-segment-bases (__tl-box-place params))
          (opt-type-hash
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases ret))))]
    [(ast.AstType.Tuple items)
      (hash.combine
        20
        (opt-type-list-hash type-segment-bases (__tl-box-place items)))]
    [(ast.AstType.Array item len)
      (hash.combine
        21
        (hash.combine
          (opt-type-hash
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases item))
          (hash.i64 len)))]
    [(ast.AstType.DynArray item)
      (hash.combine
        22
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get type-segment-bases item)))]
    [(ast.AstType.Slice item)
      (hash.combine
        37
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get type-segment-bases item)))]
    [(ast.AstType.Box item)
      (hash.combine
        23
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get type-segment-bases item)))]
    [(ast.AstType.Ptr item)
      (hash.combine
        24
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get type-segment-bases item)))]
    [(ast.AstType.MutPtr item)
      (hash.combine
        25
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get type-segment-bases item)))]
    [(ast.AstType.Ref region inner)
      (hash.combine
        26
        (hash.combine
          (hash.i64 region)
          (opt-type-hash
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases inner))))]
    [(ast.AstType.MutRef region inner)
      (hash.combine
        27
        (hash.combine
          (hash.i64 region)
          (opt-type-hash
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases inner))))]
    [(ast.AstType.Region region inner)
      (hash.combine
        28
        (hash.combine
          (hash.i64 region)
          (opt-type-hash
            type-segment-bases
            (ast.ast-type-segment-bases-get type-segment-bases inner))))]
    [(ast.AstType.Enum name) (hash.combine 29 (hash.i64 name))]
    [(ast.AstType.EnumArgs name lifetimes)
      (hash.combine
        30
        (hash.combine
          (hash.i64 name)
          (opt-lifetime-list-hash (__tl-box-place lifetimes))))]
    [(ast.AstType.Struct name) (hash.combine 31 (hash.i64 name))]
    [(ast.AstType.StructArgs name lifetimes)
      (hash.combine
        32
        (hash.combine
          (hash.i64 name)
          (opt-lifetime-list-hash (__tl-box-place lifetimes))))]
    [(ast.AstType.Var name) (hash.combine 33 (hash.i64 name))]
    [(ast.AstType.VarArgs name lifetimes)
      (hash.combine
        34
        (hash.combine
          (hash.i64 name)
          (opt-lifetime-list-hash (__tl-box-place lifetimes))))]
    [(ast.AstType.Consume inner)
      (hash.combine
        36
        (opt-type-hash
          type-segment-bases
          (ast.ast-type-segment-bases-get type-segment-bases inner)))]))

(define (opt-maybe-value-eq
  [a : ir.CompilerIrMaybeValue]
  [b : ir.CompilerIrMaybeValue]) : bool
  (match a
    [(ir.CompilerIrMaybeValue.No)
      (match b
        [(ir.CompilerIrMaybeValue.No) true]
        [_ false])]
    [(ir.CompilerIrMaybeValue.Some av)
      (match b
        [(ir.CompilerIrMaybeValue.Some bv) (opt-value-eq av bv)]
        [_ false])]))

(define (opt-value-list-eq
  [a : ir.CompilerIrValueList]
  [b : ir.CompilerIrValueList]) : bool
  (match a
    [(ir.CompilerIrValueList.Nil)
      (match b
        [(ir.CompilerIrValueList.Nil) true]
        [(ir.CompilerIrValueList.Array seq)
          (opt-value-list-eq a (ir.compiler-ir-value-seq-to-list seq))]
        [_ false])]
    [(ir.CompilerIrValueList.Array seq)
      (opt-value-list-eq (ir.compiler-ir-value-seq-to-list seq) b)]
    [(ir.CompilerIrValueList.Cons ah at)
      (match b
        [(ir.CompilerIrValueList.Array seq)
          (opt-value-list-eq a (ir.compiler-ir-value-seq-to-list seq))]
        [(ir.CompilerIrValueList.Cons bh bt)
          (and
            (opt-value-eq ah bh)
            (opt-value-list-eq (__tl-box-place at) (__tl-box-place bt)))]
        [_ false])]))

(define (opt-call-args-array-eq
  [a : (__tl_dyn-array ir.CompilerIrValue)]
  [b : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length a))
    true
    (and
      (opt-value-eq (array-ref a index) (array-ref b index))
      (opt-call-args-array-eq a b (+ index 1)))))

(define (opt-call-args-eq
  [a : ir.CompilerIrCallArgs]
  [b : ir.CompilerIrCallArgs]) : bool
  (match a
    [(ir.CompilerIrCallArgs.Nil)
      (match b
        [(ir.CompilerIrCallArgs.Nil) true]
        [_ false])]
    [(ir.CompilerIrCallArgs.One av)
      (match b
        [(ir.CompilerIrCallArgs.One bv) (opt-value-eq av bv)]
        [_ false])]
    [(ir.CompilerIrCallArgs.Two aa ab)
      (match b
        [(ir.CompilerIrCallArgs.Two ba bb)
          (and (opt-value-eq aa ba) (opt-value-eq ab bb))]
        [_ false])]
    [(ir.CompilerIrCallArgs.Array av)
      (match b
        [(ir.CompilerIrCallArgs.Array bv)
          (and
            (= (array-length av) (array-length bv))
            (opt-call-args-array-eq av bv 0))]
        [_ false])]))

(define (opt-phi-input-eq
  [av : ir.CompilerIrValue]
  [alabel : i64]
  [bv : ir.CompilerIrValue]
  [blabel : i64]) : bool
  (and (= alabel blabel) (opt-value-eq av bv)))

(define (opt-phi-input-list-eq
  [a : ir.CompilerIrPhiInputList]
  [b : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons a)
    [(ir.CompilerIrPhiInputList.Nil)
      (match (ir.compiler-ir-phi-input-list-force-cons b)
        [(ir.CompilerIrPhiInputList.Nil) true]
        [(ir.CompilerIrPhiInputList.Array seq)
          (opt-phi-input-list-eq
            ir.CompilerIrPhiInputList.Nil
            (ir.compiler-ir-phi-input-seq-to-list seq))]
        [_ false])]
    [(ir.CompilerIrPhiInputList.Array seq)
      (opt-phi-input-list-eq (ir.compiler-ir-phi-input-seq-to-list seq) b)]
    [(ir.CompilerIrPhiInputList.Cons av alabel at)
      (match (ir.compiler-ir-phi-input-list-force-cons b)
        [(ir.CompilerIrPhiInputList.Cons bv blabel bt)
          (and
            (opt-phi-input-eq av alabel bv blabel)
            (opt-phi-input-list-eq (__tl-box-place at) (__tl-box-place bt)))]
        [(ir.CompilerIrPhiInputList.Array seq)
          (opt-phi-input-list-eq
            (ir.compiler-ir-phi-input-cons-linked av alabel (__tl-box-place at))
            (ir.compiler-ir-phi-input-seq-to-list seq))]
        [_ false])]))

(define (opt-switch-case-eq
  [a : ir.CompilerIrSwitchCase]
  [b : ir.CompilerIrSwitchCase]) : bool
  (match a
    [(ir.CompilerIrSwitchCase.Case at alabel)
      (match b
        [(ir.CompilerIrSwitchCase.Case bt blabel)
          (and (= at bt) (= alabel blabel))])]))

(define (opt-switch-case-list-eq
  [a : ir.CompilerIrSwitchCaseList]
  [b : ir.CompilerIrSwitchCaseList]) : bool
  (match (ir.compiler-ir-switch-case-list-force-cons a)
    [(ir.CompilerIrSwitchCaseList.Nil)
      (match (ir.compiler-ir-switch-case-list-force-cons b)
        [(ir.CompilerIrSwitchCaseList.Nil) true]
        [(ir.CompilerIrSwitchCaseList.Array seq) (= seq.len 0)]
        [_ false])]
    [(ir.CompilerIrSwitchCaseList.Cons acase at)
      (match (ir.compiler-ir-switch-case-list-force-cons b)
        [(ir.CompilerIrSwitchCaseList.Cons bcase bt)
          (and
            (opt-switch-case-eq acase bcase)
            (opt-switch-case-list-eq (__tl-box-place at) (__tl-box-place bt)))]
        [(ir.CompilerIrSwitchCaseList.Array seq)
          (match acase
            [(ir.CompilerIrSwitchCase.Case tag label)
              (opt-switch-case-list-eq
                (ir.compiler-ir-switch-case-cons-linked
                  tag
                  label
                  (__tl-box-place at))
                (ir.compiler-ir-switch-case-seq-to-list seq))])]
        [_ false])]
    [(ir.CompilerIrSwitchCaseList.Array seq)
      (opt-switch-case-list-eq (ir.compiler-ir-switch-case-seq-to-list seq) b)]))

(define (opt-c-abi-return-slot-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrCAbiReturnSlot]
  [b : ir.CompilerIrCAbiReturnSlot]) : bool
  (match a
    [(ir.CompilerIrCAbiReturnSlot.Slot aty aoffset)
      (match b
        [(ir.CompilerIrCAbiReturnSlot.Slot bty boffset)
          (and (= aoffset boffset) (opt-type-eq type-segment-bases aty bty))])]))

(define (opt-c-abi-return-slot-seq-eq-from
  [type-segment-bases : i64]
  [a : (__tl_dyn-array ir.CompilerIrCAbiReturnSlot)]
  [b : (__tl_dyn-array ir.CompilerIrCAbiReturnSlot)]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    true
    (and
      (opt-c-abi-return-slot-eq
        type-segment-bases
        (array-ref a index)
        (array-ref b index))
      (opt-c-abi-return-slot-seq-eq-from
        type-segment-bases
        a
        b
        (+ index 1)
        count))))

(define (opt-c-abi-return-slot-seq-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrCAbiReturnSlotSeq]
  [b : ir.CompilerIrCAbiReturnSlotSeq]) : bool
  (let
    [count : i64 a.len]
    (and
      (= count b.len)
      (opt-c-abi-return-slot-seq-eq-from
        type-segment-bases
        a.slots
        b.slots
        0
        count))))

(define (opt-instr-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrInstr]
  [b : ir.CompilerIrInstr]) : bool
  (match a
    [(ir.CompilerIrInstr.Mov ad av aty)
      (match b
        [(ir.CompilerIrInstr.Mov bd bv bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.Alloc ad aty)
      (match b
        [(ir.CompilerIrInstr.Alloc bd bty)
          (and (= ad bd) (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.AddrOf ad av)
      (match b
        [(ir.CompilerIrInstr.AddrOf bd bv) (and (= ad bd) (= av bv))]
        [_ false])]
    [(ir.CompilerIrInstr.Gep ad abase aoffset aty)
      (match b
        [(ir.CompilerIrInstr.Gep bd bbase boffset bty)
          (and
            (= ad bd)
            (opt-value-eq abase bbase)
            (opt-value-eq aoffset boffset)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.Load ad av aty)
      (match b
        [(ir.CompilerIrInstr.Load bd bv bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.StorePtr aptr av aty)
      (match b
        [(ir.CompilerIrInstr.StorePtr bptr bv bty)
          (and
            (opt-value-eq aptr bptr)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.CopyBytes adst asrc asize)
      (match b
        [(ir.CompilerIrInstr.CopyBytes bdst bsrc bsize)
          (and
            (= asize bsize)
            (opt-value-eq adst bdst)
            (opt-value-eq asrc bsrc))]
        [_ false])]
    [(ir.CompilerIrInstr.Cast ad av afrom ato)
      (match b
        [(ir.CompilerIrInstr.Cast bd bv bfrom bto)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases afrom bfrom)
            (opt-type-eq type-segment-bases ato bto))]
        [_ false])]
    [(ir.CompilerIrInstr.Bitcast ad av afrom ato)
      (match b
        [(ir.CompilerIrInstr.Bitcast bd bv bfrom bto)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases afrom bfrom)
            (opt-type-eq type-segment-bases ato bto))]
        [_ false])]
    [(ir.CompilerIrInstr.BinOp ad aop al ar aty)
      (match b
        [(ir.CompilerIrInstr.BinOp bd bop bl br bty)
          (and
            (= ad bd)
            (opt-binop-eq aop bop)
            (opt-value-eq al bl)
            (opt-value-eq ar br)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.UnOp ad aop av aty)
      (match b
        [(ir.CompilerIrInstr.UnOp bd bop bv bty)
          (and
            (= ad bd)
            (opt-unop-eq aop bop)
            (opt-value-eq av bv)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.LaneId ad alanes aty)
      (match b
        [(ir.CompilerIrInstr.LaneId bd blanes bty)
          (and
            (= ad bd)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.Splat ad av alanes aty)
      (match b
        [(ir.CompilerIrInstr.Splat bd bv blanes bty)
          (and
            (= ad bd)
            (opt-value-eq av bv)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [ad (__tl-project-field (__tl-box-place payload-box) dst)]
        [aop (__tl-project-field (__tl-box-place payload-box) op)]
        [al (__tl-project-field (__tl-box-place payload-box) lhs)]
        [ar (__tl-project-field (__tl-box-place payload-box) rhs)]
        [alanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [aty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match b
          [(ir.CompilerIrInstr.VectorBinOp other-payload-box)
            (let
              [bd (__tl-project-field (__tl-box-place other-payload-box) dst)]
              [bop (__tl-project-field (__tl-box-place other-payload-box) op)]
              [bl (__tl-project-field (__tl-box-place other-payload-box) lhs)]
              [br (__tl-project-field (__tl-box-place other-payload-box) rhs)]
              [blanes
                (__tl-project-field (__tl-box-place other-payload-box) lanes)]
              [bty (__tl-project-field (__tl-box-place other-payload-box) ty)]
              (and
                (= ad bd)
                (opt-binop-eq aop bop)
                (opt-value-eq al bl)
                (opt-value-eq ar br)
                (= alanes blanes)
                (opt-type-eq type-segment-bases aty bty)))]
          [_ false]))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [ad (__tl-project-field (__tl-box-place payload-box) dst)]
        [aop (__tl-project-field (__tl-box-place payload-box) op)]
        [as (__tl-project-field (__tl-box-place payload-box) src)]
        [ac (__tl-project-field (__tl-box-place payload-box) carry)]
        [alanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [aty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match b
          [(ir.CompilerIrInstr.VectorPrefix other-payload-box)
            (let
              [bd (__tl-project-field (__tl-box-place other-payload-box) dst)]
              [bop (__tl-project-field (__tl-box-place other-payload-box) op)]
              [bs (__tl-project-field (__tl-box-place other-payload-box) src)]
              [bc (__tl-project-field (__tl-box-place other-payload-box) carry)]
              [blanes
                (__tl-project-field (__tl-box-place other-payload-box) lanes)]
              [bty (__tl-project-field (__tl-box-place other-payload-box) ty)]
              (and
                (= ad bd)
                (opt-vector-prefix-op-eq? aop bop)
                (opt-value-eq as bs)
                (opt-value-eq ac bc)
                (= alanes blanes)
                (opt-type-eq type-segment-bases aty bty)))]
          [_ false]))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [ad (__tl-project-field (__tl-box-place payload-box) dst)]
        [abase (__tl-project-field (__tl-box-place payload-box) base)]
        [aindex-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [aindex (__tl-project-field (__tl-box-place payload-box) index)]
        [alane-offset
          (__tl-project-field (__tl-box-place payload-box) lane-offset)]
        [alanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [aty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match b
          [(ir.CompilerIrInstr.GatherLoad other-payload-box)
            (let
              [bd (__tl-project-field (__tl-box-place other-payload-box) dst)]
              [bbase
                (__tl-project-field (__tl-box-place other-payload-box) base)]
              [bindex-base
                (__tl-project-field
                  (__tl-box-place other-payload-box)
                  index-base)]
              [bindex
                (__tl-project-field (__tl-box-place other-payload-box) index)]
              [blane-offset
                (__tl-project-field
                  (__tl-box-place other-payload-box)
                  lane-offset)]
              [blanes
                (__tl-project-field (__tl-box-place other-payload-box) lanes)]
              [bty (__tl-project-field (__tl-box-place other-payload-box) ty)]
              (and
                (= ad bd)
                (opt-value-eq abase bbase)
                (opt-value-eq aindex-base bindex-base)
                (opt-value-eq aindex bindex)
                (if alane-offset
                  blane-offset
                  (not blane-offset))
                (= alanes blanes)
                (opt-type-eq type-segment-bases aty bty)))]
          [_ false]))]
    [(ir.CompilerIrInstr.VectorReduce ad aop av alanes aty)
      (match b
        [(ir.CompilerIrInstr.VectorReduce bd bop bv blanes bty)
          (and
            (= ad bd)
            (opt-vector-reduce-eq aop bop)
            (opt-value-eq av bv)
            (= alanes blanes)
            (opt-type-eq type-segment-bases aty bty))]
        [_ false])]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [ad (__tl-project-field (__tl-box-place payload-box) dst)]
        [aop (__tl-project-field (__tl-box-place payload-box) op)]
        [al (__tl-project-field (__tl-box-place payload-box) lhs)]
        [ar (__tl-project-field (__tl-box-place payload-box) rhs)]
        [alanes (__tl-project-field (__tl-box-place payload-box) lanes)]
