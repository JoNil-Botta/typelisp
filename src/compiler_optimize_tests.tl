          (& cycle-bail)
          (ir.compiler-ir-symbol-id cycle-a))
        214]
      [(opt_i64_i64_map.contains?
          (& cycle-bail)
          (ir.compiler-ir-symbol-id cycle-b))
        215]
      [(not
          (opt-call-memory-summary-is?
            cycle-rounds
            cycle-a
            cycle-element-summary))
