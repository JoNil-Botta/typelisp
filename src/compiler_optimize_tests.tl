        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        8
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Gep
        9
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ir_types.CompilerIrValue.I64 8)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 9)
        (compiler_ir_types.CompilerIrValue.I64 103)
        (compiler_ast_types.AstType.I64)))
    8))

(define (opt-licm-element-load-element-store-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (compiler_ir_types.CompilerIrInstr.Gep
        7
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.Load
        8
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.Gep
        9
        (compiler_ir_types.CompilerIrValue.Var 8)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        10
        (compiler_ir_types.CompilerIrValue.Var 9)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 9)
        (compiler_ir_types.CompilerIrValue.I64 100)
        (compiler_ast_types.AstType.I64)))
    10))

;; R7: a `Global` operand is a hidden rip-relative load of that global's cell,
;; so the descriptor chain rooted at one is loop-invariant exactly when the body
;; cannot write the cell. `tail` selects what else the body does: 0 nothing,
;; 1 a `Store` back into the same global, 2 a call whose effects are unknown,
;; 3 a call to the NON-RETURNING oob-abort helper -- which must read exactly
;; like 0, because nothing it could do is observable on the continuing path.
(define (opt-licm-global-cell-load-blocks
  [symbols : OptLicmTestSymbols]
  [cell : i64]
  [tail : i64]) : compiler_ir_types.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (cond
        [(= tail 1)
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (compiler_ir_types.CompilerIrInstr.Store
              cell
              (compiler_ir_types.CompilerIrValue.I64 104)
              (compiler_ast_types.AstType.I64)))]
        [(= tail 2)
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (compiler_ir_types.CompilerIrInstr.Call
              12
              symbols.touch
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.I64)))]
        [(= tail 3)
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (compiler_ir_types.CompilerIrInstr.Call
              12
              cbi.compiler-builtin-id-tl-oob-abort
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.Unit)))]
        [else (opt-licm-loop-finish-instrs)])
      (compiler_ir_types.CompilerIrInstr.Gep
        7
        (compiler_ir_types.CompilerIrValue.Global cell)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.Load
        8
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ast_types.AstType.I64)))
    8))

(define (opt-licm-direct-call-clean-test-functions
  [symbols : OptLicmTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-test-function-symbol
      symbols.probe
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Call
          90
          symbols.probe
          (compiler_ir_types.CompilerIrCallArgs.Nil)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 90)))))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function-symbol
        symbols.writer
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 0)))))
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-test-function-symbol
          symbols.leaf
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 7)))))
        (compiler_ir_types.compiler-ir-function-seq-empty)))))

(cfg
  test
  (define (opt-licm-checked-root-params
    [read-ty : compiler_ast_types.AstType]
    [write-ty : compiler_ast_types.AstType]
    [other-ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrParamList
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "cond"
        (compiler_ast_types.AstType.Bool)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param "read" read-ty 1)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param "write" write-ty 2)
          (compiler_ir_types.compiler-ir-param-cons
            (compiler_ir_types.CompilerIrParam.Param
              "raw"
              (compiler_ast_types.AstType.U64)
              3)
            (compiler_ir_types.compiler-ir-param-cons
              (compiler_ir_types.CompilerIrParam.Param "other" other-ty 4)
              (compiler_ir_types.CompilerIrParamList.Nil))))))))

(cfg
  test
  (define (opt-licm-checked-root-function
    [read-ty : compiler_ast_types.AstType]
    [write-ty : compiler_ast_types.AstType]
    [other-ty : compiler_ast_types.AstType]
    [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "licm_checked_root")
      (opt-licm-checked-root-params read-ty write-ty other-ty)
      (compiler_ast_types.AstType.I64)
      32
      blocks)))

(cfg
  test
  (define (opt-licm-checked-root-barrier [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
    (cond
      [(= mode 1)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CopyBytes
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 3)
            8))]
      [(= mode 2)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            11
            (opt-test-symbol "touch")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.I64)))]
      ;; An indirect call through the raw parameter. There is no callee name to
      ;; resolve, so no clean map can describe it: the LICM store summaries take
      ;; `call-or-unknown?` unconditionally here.
      [(= mode 3)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CallIndirect
            11
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.I64)))]
      [else (compiler_ir_types.compiler-ir-instr-seq-empty)])))

