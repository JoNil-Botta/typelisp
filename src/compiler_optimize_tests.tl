;; The caller's call to the multiblock call-carrying callee, and the callee's
;; own call, as span keys.
(define (opt-inline-nonleaf-caller-call [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    0
    symbols.inline-nonleaf
    compiler_ir_types.CompilerIrCallArgs.Nil
    (compiler_ast_types.AstType.I64)))

(define (opt-inline-nonleaf-inner-call [helper-name : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    0
    helper-name
    compiler_ir_types.CompilerIrCallArgs.Nil
    (compiler_ast_types.AstType.I64)))

;; The SPANS variant of the multiblock clone, carrying a call.
;;
;; opt-inline-clone-multiblock-blocks-with-spans is a second copy of the clone
;; walk, so the fact that the plain walk clones a call correctly says nothing
;; about this one. The callee's call is rebased into the caller's frame -- the
;; callee's `Call 0` becomes the caller's `Call 1`, because the caller already
;; owns var 0 -- and the span the cloned call carries has to follow it to that
;; new key, or the merged caller reports the CALL SITE's line for an
;; instruction that came from the callee.
(define (compiler-optimize-spans-inline-multiblock-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr-located
        (compiler_ir_types.compiler-source-spans-insert-instr-located
          (opt-spans-base)
          (opt-test-span-symbol "inline_nonleaf")
          (opt-inline-nonleaf-inner-call symbols.external-helper)
          703
          (opt-test-span 73 11))
        (opt-test-span-symbol "main")
        (opt-inline-nonleaf-caller-call symbols)
        803
        (opt-test-span 83 17))]
    [cloned-call : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        1
        symbols.external-helper
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ast_types.AstType.I64))]
    [previous-debug : bool (compiler_ir_types.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (compiler_ir_types.compiler-debug-info-set-enabled! true)
        (match (compiler_optimize.opt-inline-program-functions-with-spans
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-inline-nonleaf-functions symbols)
          2
          spans)
          [(compiler_optimize.OptInlineSpanProgram.Program
              optimized
              optimized-spans)
            (match (compiler_optimize.opt-function-seq-find
              (compiler_optimize.compiler-opt-global-shared-view optimized)
              "main")
              [(compiler_optimize.OptMaybeFunction.Some main)
                (let
                  [blocks : compiler_ir_types.CompilerIrBlockList
                    (compiler_optimize.opt-function-blocks main)]
                  (and
                    (=
                      (opt-count-direct-call-name-blocks
                        (compiler_ir_types.compiler-ir-global-shared-view
                          blocks)
                        "inline_nonleaf")
                      0)
                    (=
                      (opt-count-direct-call-name-blocks
                        (compiler_ir_types.compiler-ir-global-shared-view
                          blocks)
                        "external_helper")
                      1)
                    (compiler_optimize.opt-inline-structure-ok?
                      (compiler_ir_types.compiler-ir-global-shared-view blocks))
                    (opt-inline-mb2-main-verified?
                      (compiler_optimize.compiler-opt-global-shared-view
                        optimized)
                      "main")
                    ;; the callee's own line, under the caller's key
                    (opt-span-lookup-ok?
                      (compiler_optimize.compiler-opt-global-shared-view
                        optimized-spans)
                      (opt-test-symbol "main")
                      (compiler_optimize.compiler-opt-global-shared-view
                        cloned-call)
                      73
                      11)
                    (opt-location-lookup-ok?
                      (compiler_optimize.compiler-opt-global-shared-view
                        optimized-spans)
                      (opt-test-symbol "main")
                      cloned-call
                      703
                      73
                      11)))]
              [(compiler_optimize.OptMaybeFunction.No) false])]))]
    (begin
      (compiler_ir_types.compiler-debug-info-set-enabled! previous-debug)
      ok)))

;; ...and the same clone with the call being an ABORT, which is what trap
;; parity rests on.
;;
;; With debug info off -- the configuration every corpus binary and the
;; self-compile are built in -- opt-remap-spans-instr-key builds a key only for
;; instructions that can abort at runtime, and `stdlib.io/panic` is one of them.
;; So this is the one span in a cloned call-carrying body that survives a
;; release build, and it is the span the abort message prints. If the clone
;; dropped it or left it under the callee's key, an abort inside an inlined
;; callee would report the caller's line instead of the callee's, and trap
;; output would stop matching the un-inlined build byte for byte.
(define (opt-inline-panic-symbol) : i64
  (opt-test-symbol "stdlib/io.tl::stdlib.io/panic"))

(define (compiler-optimize-inline-clone-abort-span-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [panic-name : i64 (opt-inline-panic-symbol)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr
        (compiler_ir_types.compiler-source-spans-insert-instr
          (opt-spans-base)
          (opt-test-span-symbol "inline_nonleaf")
          (opt-inline-nonleaf-inner-call panic-name)
          (opt-test-span 61 9))
        (opt-test-span-symbol "main")
        (opt-inline-nonleaf-caller-call symbols)
        (opt-test-span 62 3))]
    [cloned-call : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        1
        panic-name
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ast_types.AstType.I64))]
    [previous-debug : bool (compiler_ir_types.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (compiler_ir_types.compiler-debug-info-set-enabled! false)
        (match (compiler_optimize.opt-inline-program-functions-with-spans
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-inline-nonleaf-functions-named symbols panic-name)
          2
          spans)
          [(compiler_optimize.OptInlineSpanProgram.Program
              optimized
              optimized-spans)
            (match (compiler_optimize.opt-function-seq-find
              (compiler_optimize.compiler-opt-global-shared-view optimized)
              "main")
              [(compiler_optimize.OptMaybeFunction.Some main)
                (let
                  [blocks : compiler_ir_types.CompilerIrBlockList
                    (compiler_optimize.opt-function-blocks main)]
                  (and
                    (=
                      (opt-count-direct-call-name-blocks
                        (compiler_ir_types.compiler-ir-global-shared-view
                          blocks)
                        "inline_nonleaf")
                      0)
                    (compiler_optimize.opt-inline-structure-ok?
                      (compiler_ir_types.compiler-ir-global-shared-view blocks))
                    (opt-inline-mb2-main-verified?
                      (compiler_optimize.compiler-opt-global-shared-view
                        optimized)
                      "main")
                    ;; the abort still points at the callee's line
                    (opt-span-lookup-ok?
                      (compiler_optimize.compiler-opt-global-shared-view
                        optimized-spans)
                      (opt-test-symbol "main")
                      cloned-call
                      61
                      9)))]
              [(compiler_optimize.OptMaybeFunction.No) false])]))]
    (begin
      (compiler_ir_types.compiler-debug-info-set-enabled! previous-debug)
      ok)))

;; --- a chain whose SECOND import carries a call ----------------------------
;;
;; main -> mid -> leaf, with the CALL in the leaf. SCC order processes callees
;; before callers, so `leaf` is cloned into `mid` first and `mid` -- which now
;; holds a cloned call, cloned blocks and a cloned continuation phi -- is cloned
;; into `main` second. That second clone is the one that re-clones an already
;; cloned call: it has to rebase the call a second time, prefix the labels a
;; second time, and leave `main` with exactly one call, to the leaf's own
;; helper. Both callees have a single reference, so the chain is absorbed
;; bottom-up in one pass.
(define (opt-inline-chain-mid [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-loop
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "mid_call")
            (compiler_ir_types.compiler-ir-label "mid_ret"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "mid_call")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Call
              0
              symbols.inline-nonleaf
              compiler_ir_types.CompilerIrCallArgs.Nil
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 0)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "mid_ret")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 9)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-chain-main [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            symbols.inline-loop
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (compiler-optimize-inline-chain-second-import-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-chain-main symbols)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-chain-mid symbols)
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-inline-nonleaf-callee symbols)
              (compiler_ir_types.compiler-ir-function-seq-empty))))
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_loop")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "external_helper")
              1)
            (compiler_optimize.opt-inline-structure-ok?
              (compiler_ir_types.compiler-ir-global-shared-view blocks))
            (opt-inline-mb2-main-verified?
              (compiler_optimize.compiler-opt-global-shared-view optimized)
              "main")))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (compiler-optimize-inline-multiblock-nonleaf-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-nonleaf-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks
              (compiler_optimize.compiler-opt-global-shared-view main))]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-phi-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; The tail-call twin of opt-inline-nonleaf-callee-named: the same three-block
;; body, except the arm that called the helper and returned its result is the
;; fused form the lowerer actually emits for `(helper)` in tail position -- a
;; single `TailCall`. Nothing else about the callee changes, so anything this
;; body does that the plain nonleaf body does not is the tail-call admission.
(define (opt-inline-tail-call-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "call")
            (compiler_ir_types.compiler-ir-label "ret"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "call")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.TailCall
              symbols.external-helper
              compiler_ir_types.CompilerIrCallArgs.Nil
              (compiler_ast_types.AstType.I64))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "ret")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 3)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

;; The nearest refused neighbour: identical body, except the tail call goes
;; through a computed callee. The admission stops at the direct form, so this
;; callee's whole body stays out of its single call site.
;;
;; The target is LOADED, not spelled. `TailCallIndirect (Value.Function f)` is
;; not a computed target at all by the time the inliner sees it:
;; opt-devirt-known-function-instr rewrites exactly that pattern into a direct
;; `TailCall f` before the pass runs, and this fixture written that way inlined
;; -- correctly, and for the direct admission rather than the indirect one it
;; was meant to pin. A load from a global is a target devirtualization cannot
;; see through, which is what makes the refusal this test claims the reason the
;; site survives.
(define (opt-inline-tail-call-indirect-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "call")
            (compiler_ir_types.compiler-ir-label "ret"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "call")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Load
              0
              (compiler_ir_types.CompilerIrValue.Global symbols.external-helper)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.TailCallIndirect
              (compiler_ir_types.CompilerIrValue.Var 0)
              compiler_ir_types.CompilerIrCallArgs.Nil
              (compiler_ast_types.AstType.I64))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "ret")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 3)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-tail-call-functions [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-nonleaf-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-tail-call-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-tail-call-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-nonleaf-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-tail-call-indirect-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

;; A body whose exit arm is a direct tail call inlines, and the merged caller
;; carries the CONVERTED shape: the callee is gone, its tail call is an
;; ordinary direct call to the helper, no tail call survives anywhere in the
;; caller, and the converted call's result reaches the site through the same
;; single continuation phi every multiblock inline builds.
(define (compiler-optimize-inline-multiblock-tail-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-call-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_optimize.compiler-opt-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_optimize.compiler-opt-global-shared-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-tail-call-blocks
                (compiler_optimize.compiler-opt-global-shared-view blocks))
              0)
            (=
              (opt-count-phi-blocks
                (compiler_optimize.compiler-opt-global-shared-view blocks))
              1)
            (compiler_optimize.opt-inline-structure-ok?
              (compiler_optimize.compiler-opt-global-shared-view blocks))))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; The same program with an INDIRECT tail call: the call site keeps its call.
(define (compiler-optimize-inline-multiblock-tail-call-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-call-indirect-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_optimize.compiler-opt-global-shared-view blocks)
                "inline_nonleaf")
              1)
            (compiler_optimize.opt-inline-structure-ok?
              (compiler_optimize.compiler-opt-global-shared-view blocks))))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; Idempotence: re-running the inliner over its own output leaves the merged
;; caller alone. The converted call is a plain call to a callee the pass has
;; no body for, so there is nothing left to absorb and no second conversion.
(define (compiler-optimize-inline-multiblock-tail-call-idempotent-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [once : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-call-functions symbols)
        2)]
    [twice : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view once)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view once)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some once-main)
        (match (compiler_optimize.opt-function-seq-find
          (compiler_optimize.compiler-opt-global-shared-view twice)
          "main")
          [(compiler_optimize.OptMaybeFunction.Some twice-main)
            (let
              [once-blocks : compiler_ir_types.CompilerIrBlockList
                (compiler_optimize.opt-function-blocks once-main)]
              [twice-blocks : compiler_ir_types.CompilerIrBlockList
                (compiler_optimize.opt-function-blocks twice-main)]
              (and
                (=
                  (compiler_ir_types.compiler-ir-block-list-count
                    (compiler_optimize.compiler-opt-global-shared-view
                      once-blocks))
                  (compiler_ir_types.compiler-ir-block-list-count
                    (compiler_optimize.compiler-opt-global-shared-view
                      twice-blocks)))
                (=
                  (opt-count-direct-call-name-blocks
                    (compiler_optimize.compiler-opt-global-shared-view
                      twice-blocks)
                    "external_helper")
                  1)
                (=
                  (opt-count-tail-call-blocks
                    (compiler_optimize.compiler-opt-global-shared-view
                      twice-blocks))
                  0)
                (=
                  (opt-count-phi-blocks
                    (compiler_optimize.compiler-opt-global-shared-view
                      once-blocks))
                  (opt-count-phi-blocks
                    (compiler_optimize.compiler-opt-global-shared-view
                      twice-blocks)))
                (compiler_optimize.opt-inline-structure-ok?
                  (compiler_optimize.compiler-opt-global-shared-view
                    twice-blocks))))]
          [(compiler_optimize.OptMaybeFunction.No) false])]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; --- one-block callee whose only terminator is a direct tail call -----------
;;
;; The forwarder / defaulted-argument wrapper: `(define (f v) (g v 7))`. The
;; lowerer fuses the body's single call into the return, so the whole function
;; is one block ending in a `TailCall` and carries no `Return` at all. Until
;; opt-inline-body-terminator-ok? admitted that exit, the shape was refused by
;; every band -- the single-block path wanted a `Return` terminator and the
;; multiblock path wants more than one block -- so the wrapper's frame,
;; argument moves, call and jump were paid at every site.
(define (opt-inline-single-block-tail-call-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.TailCall
            symbols.external-helper
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.Var 0))
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The nearest refused neighbour, on the same terms as the multiblock pair
;; above: the target is LOADED, so devirtualization cannot spell it and the
;; census cannot price the site. The body stays out of its call site.
(define (opt-inline-single-block-tail-call-indirect-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Load
            0
            (compiler_ir_types.CompilerIrValue.Global symbols.external-helper)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.TailCallIndirect
            (compiler_ir_types.CompilerIrValue.Var 0)
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; A one-block body whose tail call names the callee itself: the self-recursion
;; the tail-recursion-to-loop pass owns, and which it only sees because the
;; inliner leaves it alone. `opt-tailrec-function` runs per function AFTER the
;; whole-program inline stage (optimize-function-once-with-summaries), so the
;; inliner is what must refuse it, and it does -- by name in
;; opt-inline-callee-ok? and by SCC in opt-inline-lookup-inlinable.
(define (opt-inline-single-block-self-tail-call-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.TailCall
            symbols.inline-nonleaf
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; Mutual recursion through the tail call: the callee's one block tail-calls
;; the CALLER. Inlining it would put a self-call inside `main` and would make
;; the census's reference accounting for `main` wrong; the shared SCC is what
;; refuses it.
(define (opt-inline-single-block-tail-call-to-caller-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.TailCall
            symbols.main
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-single-block-tail-call-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-nonleaf-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-single-block-tail-call-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-single-block-tail-call-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-nonleaf-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-single-block-tail-call-indirect-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-single-block-self-tail-call-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-nonleaf-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-single-block-self-tail-call-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-single-block-tail-call-to-caller-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-nonleaf-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-single-block-tail-call-to-caller-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

;; The wrapper inlines, and what lands at the site is the TAIL TARGET's call:
;; `%0 = call external_helper(7)`, in the caller's one block, with no tail call
;; and no continuation block or phi anywhere -- the single-block expansion adds
;; neither, which is what makes this cheaper than routing the same body through
;; the multiblock clone.
(define (compiler-optimize-inline-single-block-tail-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-tail-call-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (opt-count-phi-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (compiler_ir_types.compiler-ir-block-list-count
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; Level 1 runs the call-free tiny-leaf pass only, and a body that ends in a
;; tail call is not call-free. The site keeps its call in the cheap build.
(define (compiler-optimize-inline-single-block-tail-call-level1-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-functions symbols)
        1)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "external_helper")
              0)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; The indirect twin keeps its call.
(define (compiler-optimize-inline-single-block-tail-call-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-indirect-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; Self-recursion and mutual recursion through the tail call both keep their
;; call sites, and the recursive callee keeps its own body for the
;; tail-recursion pass to find.
(define (compiler-optimize-inline-single-block-self-tail-call-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-self-tail-call-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (match (compiler_optimize.opt-function-seq-find
          optimized
          "inline_nonleaf")
          [(compiler_optimize.OptMaybeFunction.Some callee)
            (let
              [blocks : compiler_ir_types.CompilerIrBlockList
                (compiler_optimize.opt-function-blocks main)]
              [callee-blocks : compiler_ir_types.CompilerIrBlockList
                (compiler_optimize.opt-function-blocks callee)]
              (and
                (=
                  (opt-count-direct-call-name-blocks
                    (compiler_ir_types.compiler-ir-global-shared-view blocks)
                    "inline_nonleaf")
                  1)
                (=
                  (opt-count-tail-call-blocks
                    (compiler_ir_types.compiler-ir-global-shared-view blocks))
                  0)
                (= (opt-count-tail-call-blocks callee-blocks) 1)
                (compiler_optimize.opt-inline-structure-ok? blocks)))]
          [(compiler_optimize.OptMaybeFunction.No) false])]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (compiler-optimize-inline-single-block-tail-call-to-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-to-caller-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-tail-call-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; --- direct tail-call SITES -------------------------------------------------
;;
;; The site class the inliner could not see. `(define (main) (f))` lowers to one
;; block holding a single `TailCall f`: no destination, no continuation, and --
;; until opt-inline-try grew its TailCall arm -- no inline site either, so a
;; caller that does nothing but forward paid `f`'s whole call boundary. The
;; rewrite is the simpler of the two site classes: the callee's exit becomes the
;; caller's exit, so a `Return` exit lands as the caller's `Return` and a
;; `TailCall h` exit is forwarded as a `TailCall h`, never as a call.
(define (opt-inline-tail-site-caller [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    0
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.TailCall
            symbols.inline-nonleaf
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The indirect twin of the site: the target is LOADED, so nothing names a
;; callee and the census cannot price it. It must survive the pass untouched.
(define (opt-inline-tail-site-indirect-caller
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Load
            0
            (compiler_ir_types.CompilerIrValue.Global symbols.inline-nonleaf)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.TailCallIndirect
            (compiler_ir_types.CompilerIrValue.Var 0)
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The ordinary `Return`-exit callee, seen from a tail site.
(define (opt-inline-tail-site-return-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; A self-tail-recursive callee: one block, one `Mov`, and a tail call to
;; ITSELF. Its own tail call is now a site the walk visits, and it is the site
;; that must stay refused -- expanding it would copy the body into itself and
;; the next round would do it again. opt-inline-callee-ok? refuses it by name
;; and opt-inline-lookup-inlinable refuses it by SCC; opt-tailrec, which runs
;; after this whole stage, is what turns it into a loop.
(define (opt-inline-self-tail-recursive-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.TailCall
            symbols.inline-nonleaf
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The mutual-recursion pair's other half: it tail-calls the CALLER back. The
;; two functions share an SCC, so neither site may be taken -- taking either one
;; would put a copy of one body inside the other and leave the cycle intact.
(define (opt-inline-tail-site-mutual-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-nonleaf
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.TailCall
            symbols.main
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-tail-site-return-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-tail-site-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-tail-site-return-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-tail-site-tail-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-tail-site-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-single-block-tail-call-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-tail-site-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-tail-site-indirect-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-tail-site-return-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-tail-site-self-recursive-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-tail-site-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-self-tail-recursive-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-tail-site-mutual-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-tail-site-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-tail-site-mutual-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

;; (a) A `Return`-exit callee at a tail site: the body lands in the caller's one
;; block and the callee's `Return` IS the caller's `Return`. No call and no tail
;; call survive, and no block or phi is added.
(define (compiler-optimize-inline-tail-site-return-exit-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-return-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-tail-call-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (opt-count-tail-call-indirect-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (opt-count-return-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (=
              (opt-count-instrs-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              2)
            (=
              (opt-count-phi-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (compiler_ir_types.compiler-ir-block-list-count
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; (b) A `TailCall`-exit callee at a tail site: the exit is FORWARDED. The
;; caller ends in a tail call to the inner target, not in a call plus a return,
;; so the chain's stack usage is what it was.
(define (compiler-optimize-inline-tail-site-tail-exit-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-tail-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "external_helper")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-tail-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-tail-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-tail-call-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (=
              (opt-count-return-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (opt-count-instrs-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              2)
            (=
              (opt-count-phi-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (compiler_ir_types.compiler-ir-block-list-count
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; (c) A `TailCallIndirect` site is not a site.
(define (compiler-optimize-inline-tail-site-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-indirect-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-tail-call-indirect-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (=
              (opt-count-tail-call-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-instrs-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              2)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; (d) The self-recursive tail site stays put. The callee keeps its two
;; instructions and its one tail call to itself: had the site been taken, the
;; body would hold a second copy of the `Mov` and the whole-program walk would
;; be free to do it again.
(define (compiler-optimize-inline-tail-site-self-recursion-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-self-recursive-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "inline_nonleaf")
      [(compiler_optimize.OptMaybeFunction.Some callee)
        (let
          [callee-blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks callee)]
          (and
            (=
              (opt-count-tail-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view callee-blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-instrs-blocks
                (compiler_ir_types.compiler-ir-global-shared-view callee-blocks))
              2)
            (=
              (compiler_ir_types.compiler-ir-block-list-count
                (compiler_ir_types.compiler-ir-global-shared-view callee-blocks))
              1)
            (compiler_optimize.opt-inline-structure-ok? callee-blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; (e) The mutual-recursion pair: neither half moves, because the SCC test
;; refuses a callee that can reach its caller back.
(define (compiler-optimize-inline-tail-site-mutual-recursion-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-mutual-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (match (compiler_optimize.opt-function-seq-find
          optimized
          "inline_nonleaf")
          [(compiler_optimize.OptMaybeFunction.Some callee)
            (let
              [blocks : compiler_ir_types.CompilerIrBlockList
                (compiler_optimize.opt-function-blocks main)]
              [callee-blocks : compiler_ir_types.CompilerIrBlockList
                (compiler_optimize.opt-function-blocks callee)]
              (and
                (=
                  (opt-count-tail-call-name-blocks
                    (compiler_ir_types.compiler-ir-global-shared-view blocks)
                    "inline_nonleaf")
                  1)
                (=
                  (opt-count-instrs-blocks
                    (compiler_ir_types.compiler-ir-global-shared-view blocks))
                  1)
                (=
                  (opt-count-tail-call-name-blocks
                    (compiler_ir_types.compiler-ir-global-shared-view
                      callee-blocks)
                    "main")
                  1)
                (=
                  (opt-count-instrs-blocks
                    (compiler_ir_types.compiler-ir-global-shared-view
                      callee-blocks))
                  2)
                (compiler_optimize.opt-inline-structure-ok? blocks)))]
          [(compiler_optimize.OptMaybeFunction.No) false])]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; (f) Level 1 runs the call-free tiny-leaf pass, which fires on `Call` sites
;; only. The tail site is untouched in the cheap build.
(define (compiler-optimize-inline-tail-site-level1-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-return-functions symbols)
        1)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-tail-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-instrs-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              1)
            (=
              (opt-count-return-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks))
              0)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (opt-inline-repeated-nonleaf-predicate-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-tiny-nonleaf-predicate
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.Bool)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "call")
            (compiler_ir_types.compiler-ir-label "ret"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "call")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Call
              1
              symbols.external-predicate
              compiler_ir_types.CompilerIrCallArgs.Nil
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "ret")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Bool false)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-repeated-nonleaf-predicate-caller
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.Bool)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            symbols.inline-tiny-nonleaf-predicate
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "second")
            (compiler_ir_types.compiler-ir-label "done"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "second")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Call
              1
              symbols.inline-tiny-nonleaf-predicate
              compiler_ir_types.CompilerIrCallArgs.Nil
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "done")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Bool false)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-repeated-nonleaf-predicate-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-repeated-nonleaf-predicate-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-repeated-nonleaf-predicate-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (compiler-optimize-inline-repeated-nonleaf-predicate-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-nonleaf-predicate-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find
      (compiler_optimize.compiler-opt-global-shared-view optimized)
      "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks
              (compiler_optimize.compiler-opt-global-shared-view main))]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (compiler_ir_types.compiler-ir-global-shared-view blocks)
                "inline_tiny_nonleaf_predicate")
              2)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (compiler-optimize-inline-census-direct-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-frame-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build
        (compiler_optimize.compiler-opt-global-shared-view functions))]
    [census : compiler_optimize.OptInlineCensus
      (compiler_optimize.opt-inline-census-build
        (compiler_optimize.compiler-opt-global-shared-view index)
        functions)]
    (and
      (=
        (compiler_optimize.opt-inline-census-refcount
          (compiler_optimize.compiler-opt-global-shared-view index)
          (compiler_optimize.compiler-opt-global-shared-view census)
          symbols.inline-add)
        1)
      (not
        (compiler_optimize.opt-inline-census-address-taken?
          (compiler_optimize.compiler-opt-global-shared-view index)
          (compiler_optimize.compiler-opt-global-shared-view census)
          symbols.inline-add))
      (compiler_optimize.opt-inline-census-absorbable?
        index
        census
        symbols.main
        symbols.inline-add))))

(define (compiler-optimize-inline-census-address-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-known-indirect-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build
        (compiler_optimize.compiler-opt-global-shared-view functions))]
    [census : compiler_optimize.OptInlineCensus
      (compiler_optimize.opt-inline-census-build
        (compiler_optimize.compiler-opt-global-shared-view index)
        functions)]
    (and
      (compiler_optimize.opt-inline-census-address-taken?
        (compiler_optimize.compiler-opt-global-shared-view index)
        (compiler_optimize.compiler-opt-global-shared-view census)
        symbols.inline-add)
      (not
        (compiler_optimize.opt-inline-census-absorbable?
          index
          census
          symbols.main
          symbols.inline-add)))))

(define (compiler-optimize-inline-cost-model-ok?) : bool
  (and
    (compiler_optimize.opt-inline-bounds-leaf-return-type?
      (compiler_ast_types.AstType.I64))
    (compiler_optimize.opt-inline-bounds-leaf-return-type?
      (compiler_ast_types.AstType.Bool))
    (compiler_optimize.opt-inline-bounds-leaf-return-type?
      (compiler_ast_types.AstType.Unit))
    (not
      (compiler_optimize.opt-inline-bounds-leaf-return-type?
        (compiler_ast_types.AstType.String)))
    (compiler_optimize.opt-inline-value-constant?
      (compiler_ir_types.CompilerIrValue.I64 7))
    (not
      (compiler_optimize.opt-inline-value-constant?
        (compiler_ir_types.CompilerIrValue.Var 7)))
    (=
      (compiler_optimize.opt-inline-args-const-count
        (compiler_ir_types.CompilerIrCallArgs.Two
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ir_types.CompilerIrValue.Var 2)))
      1)
    (compiler_optimize.opt-inline-cost-inline? 8 0 0 false 64 0)
    (not (compiler_optimize.opt-inline-cost-inline? 10 3 0 false 10 0))
    (compiler_optimize.opt-inline-cost-inline? 10 3 0 true 10 0)
    (not
      (compiler_optimize.opt-inline-cost-inline?
        1
        1
        0
        true
        (compiler_optimize.opt-inline-heavy-gate-block-limit)
        0))
    (not (compiler_optimize.opt-inline-cost-inline? 1 1 0 true 80 32))
    (compiler_optimize.opt-inline-cost-inline? 8 1 8 false 10 0)
    (not (compiler_optimize.opt-inline-bounds-inline-ok? true false 1 2))
    (compiler_optimize.opt-inline-bounds-inline-ok? true false 2 2)
    (compiler_optimize.opt-inline-bounds-inline-ok? true true 0 2)
    (compiler_optimize.opt-inline-bounds-inline-ok? false false 0 2)))

(define (compiler-optimize-inline-multiblock-return-gate-ok?) : bool
  (let
    [direct-params : compiler_ir_types.CompilerIrParamSeq
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "value"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-seq-empty))]
    [enum-ty : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Enum (opt-test-symbol "InlineReturnEnum"))]
    [sret-params : compiler_ir_types.CompilerIrParamSeq
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "__sret"
          (compiler_ast_types.ast-ty-mut-ptr
            (compiler_optimize.compiler-opt-global-shared-view enum-ty))
          0)
        (compiler_optimize.compiler-opt-global-shared-view direct-params))]
    (and
      (not
        (compiler_optimize.opt-inline-multiblock-return-type-ok?
          (compiler_optimize.compiler-opt-global-shared-view direct-params)
          (compiler_optimize.compiler-opt-global-shared-view enum-ty)))
      (compiler_optimize.opt-inline-multiblock-return-type-ok?
        (compiler_optimize.compiler-opt-global-shared-view direct-params)
        (compiler_ast_types.AstType.I64))
      (compiler_optimize.opt-inline-multiblock-return-type-ok?
        direct-params
        (compiler_ast_types.AstType.Unit))
      (compiler_optimize.opt-inline-multiblock-return-type-ok?
        sret-params
        enum-ty))))

(define (opt-inline-dense-input-shape-ok?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : bool
  (and
    (=
      (compiler_ir_types.compiler-ir-instr-seq-count
        (compiler_ir_types.compiler-ir-global-shared-view instrs))
      3)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      0)
      [(compiler_ir_types.CompilerIrInstr.Mov
          first-dst
          (compiler_ir_types.CompilerIrValue.I64 first-value)
          _)
        (and (= first-dst 10) (= first-value 7))]
      [_ false])
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      1)
      [(compiler_ir_types.CompilerIrInstr.BinOp
          second-dst
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var second-left)
          (compiler_ir_types.CompilerIrValue.I64 second-right)
          _)
        (and (= second-dst 11) (= second-left 10) (= second-right 5))]
      [_ false])
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 2)
      [(compiler_ir_types.CompilerIrInstr.Mov
          final-dst
          (compiler_ir_types.CompilerIrValue.Var final-source)
          _)
        (and (= final-dst 99) (= final-source 11))]
      [_ false])))

(define (compiler-optimize-inline-dense-input-ok?) : bool
  (let
    [callee-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          1
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 1))))]
    [block : compiler_ir_types.CompilerIrBlock
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "dense_inline")
        (compiler_ir_types.compiler-ir-global-shared-view callee-instrs))]
    [cons-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-global-shared-view block)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [array-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-list-compact
        (compiler_ir_types.compiler-ir-global-shared-view cons-blocks))]
    [cons-seq : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-inline-single-block-instrs
        (compiler_ir_types.compiler-ir-global-shared-view cons-blocks))]
    [array-seq : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-inline-single-block-instrs array-blocks)]
    [expanded-cons : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-inline-expand-instrs
        (compiler_ir_types.compiler-ir-global-shared-view cons-seq)
        99
        (compiler_ast_types.AstType.I64)
        compiler_ir_types.CompilerIrCallArgs.Nil
        0
        10
        "dense")]
    [expanded-array : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-inline-expand-instrs
        (compiler_ir_types.compiler-ir-global-shared-view array-seq)
        99
        (compiler_ast_types.AstType.I64)
        compiler_ir_types.CompilerIrCallArgs.Nil
        0
        10
        "dense")]
    [empty-block : compiler_ir_types.CompilerIrBlock
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "dense_empty")
        (compiler_ir_types.compiler-ir-instr-seq-empty))]
    [empty-seq : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-inline-single-block-instrs
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-global-shared-view empty-block)
          compiler_ir_types.CompilerIrBlockList.Nil))]
    [multi-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-global-shared-view block)
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-global-shared-view empty-block)
          compiler_ir_types.CompilerIrBlockList.Nil))]
    [multi-array-seq : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-inline-single-block-instrs
        (compiler_ir_types.compiler-ir-block-list-compact multi-blocks))]
    [no-bounds : compiler_ir_types.CompilerIrInstrSeq callee-instrs]
    [with-bounds : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "dense_bounds.ok"))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.No)))]
    (and
      (= (compiler_ir_types.compiler-ir-instr-seq-count cons-seq) 3)
      (= (compiler_ir_types.compiler-ir-instr-seq-count array-seq) 3)
      (opt-inline-dense-input-shape-ok? expanded-cons)
      (opt-inline-dense-input-shape-ok? expanded-array)
      (= (compiler_ir_types.compiler-ir-instr-seq-count empty-seq) 0)
      (= (compiler_ir_types.compiler-ir-instr-seq-count multi-array-seq) 0)
      (not (compiler_optimize.opt-inline-instr-seq-has-bounds-check? no-bounds))
      (compiler_optimize.opt-inline-instr-seq-has-bounds-check? with-bounds)
      (not
        (compiler_optimize.opt-inline-instr-seq-has-bounds-check?
          (compiler_ir_types.compiler-ir-instr-seq-empty))))))

;; #6219: a SysV MEMORY-class aggregate parameter is pointer-shaped in IR, but
;; the backend's call emission gives it a private byte copy.  Keep that call
;; boundary through every inliner admission path and distinguish IR-owned
;; transport names from source-owned spelling collisions.
(define (opt-inline-private-memory-test-params
  [value-ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "__sret"
      (compiler_ast_types.AstType.U64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param "value" value-ty 1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-inline-private-memory-test-body) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "private_memory.entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 99)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.CopyBytes
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          24)
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 0)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

(define (opt-inline-private-memory-test-callee
  [name : i64]
  [value-ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    (opt-inline-private-memory-test-params value-ty)
    (compiler_ast_types.AstType.U64)
    2
    (opt-inline-private-memory-test-body)))

(define (opt-inline-private-memory-test-caller
  [caller-name : i64]
  [callee-name : i64]
  [value-ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    caller-name
    (opt-inline-private-memory-test-params value-ty)
    (compiler_ast_types.AstType.Unit)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "private_memory.caller")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            2
            callee-name
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.U64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.No))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-private-memory-test-functions
  [caller-name : i64]
  [callee-name : i64]
  [value-ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-private-memory-test-caller
      caller-name
      callee-name
      (compiler_ir_types.compiler-ir-global-shared-view value-ty))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-private-memory-test-callee callee-name value-ty)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (compiler-optimize-inline-private-memory-boundary-ok?) : bool
  (let
    [private-text : String "__tl_internal_abi_mem_s24__array_i64_3"]
    [group-text : String "__tl_internal_abi_group_m0__inline_control"]
    [private-id : i64
      (opt-test-symbol
        (compiler_optimize.compiler-opt-global-shared-view private-text))]
    [source-id : i64 (ci.intern private-text)]
    [group-id : i64 (opt-test-symbol group-text)]
    [private-ty : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Struct private-id)]
    [private-args-ty : compiler_ast_types.AstType
      (compiler_ast_types.ast-ty-struct-args
        private-id
        (compiler_ast_types.ast-lifetime-list-new))]
    [source-ty : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Struct source-id)]
    [group-ty : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Struct group-id)]
    [private-callee-name : i64 (opt-test-symbol "inline_private_memory")]
    [private-caller-name : i64 (opt-test-symbol "private_memory_main")]
    [source-callee-name : i64 (opt-test-symbol "inline_source_collision")]
    [source-caller-name : i64 (opt-test-symbol "source_collision_main")]
    [private-params : compiler_ir_types.CompilerIrParamSeq
      (opt-inline-private-memory-test-params
        (compiler_optimize.compiler-opt-global-shared-view private-ty))]
    [source-params : compiler_ir_types.CompilerIrParamSeq
      (opt-inline-private-memory-test-params
        (compiler_optimize.compiler-opt-global-shared-view source-ty))]
    [private-callee : compiler_ir_types.CompilerIrFunction
      (opt-inline-private-memory-test-callee
        private-callee-name
        (compiler_optimize.compiler-opt-global-shared-view private-ty))]
    [source-callee : compiler_ir_types.CompilerIrFunction
      (opt-inline-private-memory-test-callee
        source-callee-name
        (compiler_optimize.compiler-opt-global-shared-view source-ty))]
    [private-level1 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-private-memory-test-functions
          private-caller-name
          private-callee-name
          (compiler_optimize.compiler-opt-global-shared-view private-ty))
        1)]
    [private-level2 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-private-memory-test-functions
          private-caller-name
          private-callee-name
          (compiler_optimize.compiler-opt-global-shared-view private-ty))
        2)]
    [source-level1 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-private-memory-test-functions
          source-caller-name
          source-callee-name
          (compiler_optimize.compiler-opt-global-shared-view source-ty))
        1)]
    (match (compiler_optimize.opt-function-seq-find
      private-level1
      "private_memory_main")
      [(compiler_optimize.OptMaybeFunction.Some private-main-level1)
        (match (compiler_optimize.opt-function-seq-find
          private-level2
          "private_memory_main")
          [(compiler_optimize.OptMaybeFunction.Some private-main-level2)
            (match (compiler_optimize.opt-function-seq-find
              source-level1
              "source_collision_main")
              [(compiler_optimize.OptMaybeFunction.Some source-main-level1)
                (let
                  [private-level1-blocks : compiler_ir_types.CompilerIrBlockList
                    (compiler_optimize.opt-function-blocks
                      (compiler_optimize.compiler-opt-global-shared-view
                        private-main-level1))]
                  [private-level2-blocks : compiler_ir_types.CompilerIrBlockList
                    (compiler_optimize.opt-function-blocks
                      (compiler_optimize.compiler-opt-global-shared-view
                        private-main-level2))]
                  [source-level1-blocks : compiler_ir_types.CompilerIrBlockList
                    (compiler_optimize.opt-function-blocks
                      (compiler_optimize.compiler-opt-global-shared-view
                        source-main-level1))]
                  (and
                    (compiler_ir_types.compiler-ir-symbol-owned? private-id)
                    (not
                      (compiler_ir_types.compiler-ir-symbol-owned? source-id))
                    (compiler_ir_types.compiler-ir-symbol-owned? group-id)
                    (compiler_optimize.opt-inline-private-memory-transport-type?
                      private-ty)
                    (compiler_optimize.opt-inline-private-memory-transport-type?
                      private-args-ty)
                    (not
                      (compiler_optimize.opt-inline-private-memory-transport-type?
                        source-ty))
                    (not
                      (compiler_optimize.opt-inline-private-memory-transport-type?
                        group-ty))
                    (compiler_optimize.opt-inline-params-have-private-memory?
                      (compiler_optimize.compiler-opt-global-shared-view
                        private-params))
                    (not
                      (compiler_optimize.opt-inline-callee-ok?
                        private-callee
                        private-caller-name))
                    (not
                      (compiler_optimize.opt-inline-multiblock-callee-body-ok?
                        private-params
                        (compiler_ast_types.AstType.U64)
                        2
                        (opt-inline-private-memory-test-body)))
                    (compiler_optimize.opt-inline-callee-ok?
                      source-callee
                      source-caller-name)
                    (not
                      (compiler_optimize.opt-inline-params-have-private-memory?
                        source-params))
                    (=
                      (opt-count-direct-call-name-blocks
                        private-level1-blocks
                        "inline_private_memory")
                      1)
                    (=
                      (opt-count-direct-call-name-blocks
                        private-level2-blocks
                        "inline_private_memory")
                      1)
                    (=
                      (opt-count-direct-call-name-blocks
                        source-level1-blocks
                        "inline_source_collision")
                      0)))]
              [(compiler_optimize.OptMaybeFunction.No) false])]
          [(compiler_optimize.OptMaybeFunction.No) false])]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (compiler-optimize-inline-self-test) : i64
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-frame-functions symbols)
        2)]
    [devirt-direct : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-devirt-known-function-function
        (opt-inline-known-indirect-caller symbols))]
    [devirt-dynamic : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-devirt-known-function-function
        (opt-devirt-dynamic-caller))]
    [devirt-local-alias : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-devirt-known-function-function
        (opt-devirt-local-alias-caller false))]
    [devirt-duplicate-alias : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-devirt-known-function-function
        (opt-devirt-local-alias-caller true))]
    [devirt-inlined : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-known-indirect-functions symbols)
        2)]
    [devirt-reach : compiler_ir_types.CompilerIrFunctionSeq
      (opt-program-functions
