      (compiler_ast_types.AstType.I64)
      opt-bce-fold-test-frame
      (opt-bce-fold-test-blocks variant))))

(define (opt-bce-fold-test-versioned [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (opt-bce-fold-test-versioned-function variant)))

;; -1 when the block is missing or does not end in a Jump; otherwise the
;; jump's target label.
(define (opt-bce-fold-test-jump-target
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) -1]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              -1
              (match (compiler_ir_types.compiler-ir-instr-seq-ref
                instrs
                (- count 1))
                [(compiler_ir_types.CompilerIrInstr.Jump target) target]
                [_ -1])))])]))

(define (opt-bce-fold-test-branch-terminated?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (compiler_ir_types.compiler-ir-instr-seq-ref
                instrs
                (- count 1))
                [(compiler_ir_types.CompilerIrInstr.Branch _ _ _) true]
                [_ false])))])]))

(define (opt-bce-fold-test-has-block?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some _) true]))

(define (opt-bce-fold-test-fast-label [text : String]) : i64
  (compiler_ir_types.compiler-ir-label (str_cat.str-cat text "__bce_fast")))

(define (compiler-optimize-bce-version-fold-self-test) : i64
  (let
    [monotone : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 0)]
    [monotone-false : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 1)]
    [invariant : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 5)]
    [derived-floor : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 8)]
    [retired : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-bce-fold-test-versioned 0))]
    [fast-body : i64 (opt-bce-fold-test-fast-label "body")]
    [fast-then : i64 (opt-bce-fold-test-fast-label "then")]
    [fast-else : i64 (opt-bce-fold-test-fast-label "else")]
    (cond
      ;; the fixture versions at all, and the fold keeps it verifiable.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-bce-fold-test-versioned-function 0))))
        1]
      [(not (opt-bce-fold-test-has-block? monotone fast-body)) 2]
      ;; R1: `counter >= 0` becomes the jump it always took ...
      [(not (= (opt-bce-fold-test-jump-target monotone fast-body) fast-then)) 3]
      ;; ... while the slow loop keeps its branch.
      [(not
          (opt-bce-fold-test-branch-terminated?
            monotone
            (compiler_ir_types.compiler-ir-label "body")))
        4]
      ;; R1 the other way: `counter < 0` is decided FALSE.
      [(not
          (= (opt-bce-fold-test-jump-target monotone-false fast-body) fast-else))
        5]
      ;; R2: the guard's own `bound <= length` conjunct, recomputed in the loop.
      [(not (= (opt-bce-fold-test-jump-target invariant fast-body) fast-then))
        6]
      ;; R3: the exact index of a removed check carries its signed floor.
      [(not
          (= (opt-bce-fold-test-jump-target derived-floor fast-body) fast-then))
        7]
      ;; the arm that lost its last predecessor retires.
      [(opt-bce-fold-test-has-block? retired fast-else) 8]
      [(not (opt-bce-fold-test-has-block? retired fast-then)) 9]
      [(not
          (opt-bce-fold-test-has-block?
            retired
            (compiler_ir_types.compiler-ir-label "else")))
        10]
      [else 42])))

;; Every refusal keeps the versioned fast clone's conditional branch.
(define (compiler-optimize-bce-version-fold-refusal-self-test) : i64
  (let
    [fast-body : i64 (opt-bce-fold-test-fast-label "body")]
    [nonliteral : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 2)]
    [in-loop : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 3)]
    [range-needed : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 4)]
    [wrong-op : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 6)]
    [else-phi : compiler_ir_types.CompilerIrBlockList
      (opt-bce-fold-test-versioned 7)]
    (cond
      ;; a second induction phi whose step is not a literal is not the
      ;; counter the guard bounded.
      [(not (opt-bce-fold-test-has-block? nonliteral fast-body)) 1]
      [(not (opt-bce-fold-test-branch-terminated? nonliteral fast-body)) 2]
      ;; a value the loop itself writes is neither counter nor invariant.
      [(not (opt-bce-fold-test-branch-terminated? in-loop fast-body)) 3]
      ;; `counter >= 1` needs a seed bound the guard never proved.
      [(not (opt-bce-fold-test-branch-terminated? range-needed fast-body)) 4]
      ;; `bound < length` is not the recorded `bound <= length`.
      [(not (opt-bce-fold-test-branch-terminated? wrong-op fast-body)) 5]
      ;; the dropped arm still selects a value on the edge.
      [(not (opt-bce-fold-test-branch-terminated? else-phi fast-body)) 6]
      [else 42])))

;; --- loop-nest fixture --------------------------------------------------------
;;
;; A counted OUTER loop (do-while latch "merge", counter %3, bounded phi %4)
;; whose body branches into a whole inner loop before merging back. `mode`
;; picks the inner loop's relationship to the outer one:
;;   0  the inner header is entered straight from the outer header, so the
;;      inner loop has no dedicated preheader and can never version on its
;;      own -- the ln-set-count shape, and the one where the outer NEST
;;      versions
;;   1  an "inner_pre" forwarder gives the inner loop its own preheader, so
;;      the inner loop versions first and the outer nest is left alone
;;   2  a Call in the inner body: the clonable whitelist applies across the
;;      whole nest, so nothing versions
;; `pad` adds dead movs to the inner body -- the knob that drives the NEST
;; instruction budget without moving the block count. Vars: 0-2 params, 3-10
;; the outer loop, 11-13 the inner loop, 14 the mode-2 call, pad movs from 15.
;; Where the outer header branches to reach the inner loop.
(define (opt-bce-mb-test-nest-inner-entry [mode : i64]) : i64
  (if (= mode 1)
    (compiler_ir_types.compiler-ir-label "inner_pre")
    (compiler_ir_types.compiler-ir-label "inner_header")))

;; The inner header's entering predecessor, the label its phi carries.
(define (opt-bce-mb-test-nest-inner-pred [mode : i64]) : i64
  (if (= mode 1)
    (compiler_ir_types.compiler-ir-label "inner_pre")
    (compiler_ir_types.compiler-ir-label "body")))

(define (opt-bce-mb-test-nest-header-block [mode : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        3
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 8)
            (compiler_ir_types.compiler-ir-label "merge")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Phi
        4
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.compiler-ir-label "merge")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "mb_nest_ok0"))
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 4)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.compiler-ir-label "then")
        (opt-bce-mb-test-nest-inner-entry mode)))))

(define (opt-bce-mb-test-nest-then-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "then")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "mb_nest_ok1"))
      (compiler_ir_types.CompilerIrInstr.BinOp
        6
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "merge")))))

(define (opt-bce-mb-test-nest-inner-header-block [mode : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "inner_header")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        11
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (opt-bce-mb-test-nest-inner-pred mode)
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 13)
            (compiler_ir_types.compiler-ir-label "inner_body")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        12
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 11)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 12)
        (compiler_ir_types.compiler-ir-label "inner_body")
        (compiler_ir_types.compiler-ir-label "merge")))))

;; The inner body: an inner-counter check (which the OUTER loop's guard can
;; never derive -- %11 is neither the outer counter nor loop-invariant), the
;; mode-2 call, and the pad movs.
(define (opt-bce-mb-test-nest-inner-body-block [mode : i64] [pad : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "inner_body")
    (opt-test-instrs-with-tail
      (let
        [tail : compiler_ir_types.CompilerIrInstrSeq
          (opt-bce-mb-test-pad-instrs
            pad
            15
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                13
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 11)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "inner_header"))))]
        (if (= mode 2)
          (opt-test-instrs-with-tail
            tail
            (compiler_ir_types.CompilerIrInstr.Call
              14
              (opt-test-symbol "mb_nest_callee")
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.I64)))
          tail))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 11)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "mb_nest_inner_ok")))))

(define (opt-bce-mb-test-nest-merge-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "merge")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        7
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.compiler-ir-label "inner_header")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        8
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        9
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 8)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 9)
        (compiler_ir_types.compiler-ir-label "body")
        (compiler_ir_types.compiler-ir-label "exit")))))

(define (opt-bce-mb-test-nest-exit-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "exit")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        10
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 7)
          (compiler_ir_types.compiler-ir-label "merge")
          (compiler_ir_types.CompilerIrPhiInputList.Nil))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var 10))))))

(define (opt-bce-mb-test-nest-tail-blocks [mode : i64] [pad : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-bce-mb-test-nest-inner-header-block mode)
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-mb-test-nest-inner-body-block mode pad)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-bce-mb-test-nest-merge-block)
        (compiler_ir_types.compiler-ir-block-cons
          (opt-bce-mb-test-nest-exit-block)
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-bce-mb-test-nest-blocks [mode : i64] [pad : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-bce-mb-test-jump-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-label "body"))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-mb-test-nest-header-block mode)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-bce-mb-test-nest-then-block)
        (if (= mode 1)
          (compiler_ir_types.compiler-ir-block-cons
            (opt-bce-mb-test-jump-block
              (compiler_ir_types.compiler-ir-label "inner_pre")
              (compiler_ir_types.compiler-ir-label "inner_header"))
            (opt-bce-mb-test-nest-tail-blocks mode pad))
          (opt-bce-mb-test-nest-tail-blocks mode pad))))))

(define (opt-bce-mb-test-nest-function [mode : i64] [pad : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb_nest_fixture")
    (opt-bce-version-test-params)
    (compiler_ast_types.AstType.I64)
    (+ 15 pad)
    (opt-bce-mb-test-nest-blocks mode pad)))

(define (opt-bce-mb-test-nest-versioned [mode : i64] [pad : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-bce-version-function
    (opt-bce-mb-test-nest-function mode pad)))

;; The nest admission (M2). The outer loop of a nest versions like any other
;; counted loop -- the inner loop is simply more blocks in the clone group --
;; with the guard derived only from the OUTER loop's own counter facts, the
;; nest instruction budget (not the loop's shape) deciding how big a nest may
;; clone, and the flat-first scan order keeping an independently versionable
;; inner loop ahead of its enclosing nest.
(define (compiler-optimize-bce-version-mb-nest-self-test) : i64
  (let
    [nested : compiler_ir_types.CompilerIrFunction
      (opt-bce-mb-test-nest-versioned 0 0)]
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks nested)]
    ;; 54 cloned instructions: a big nest, still inside the nest budget.
    [big : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-bce-mb-test-nest-versioned 0 40))]
    ;; 69 cloned instructions across FIVE blocks: over the nest budget of 64
    ;; and under the flat loop's 96, so the nest budget -- and nothing else --
    ;; rejects it.
    [too-big : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-bce-mb-test-nest-versioned 0 55))]
    ;; The inner loop gets its own preheader and versions first.
    [inner-first : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-bce-mb-test-nest-versioned 1 0))]
    ;; A Call in the inner body: the clonable whitelist reaches through the
    ;; nest, so neither loop versions.
    [with-call : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-bce-mb-test-nest-versioned 2 0))]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function nested)))
        1]
      ;; entry + guard + five fast clones + five slow blocks + exit
      [(not (= (compiler_ir_types.compiler-ir-block-list-count out) 13)) 2]
      [(match (compiler_optimize.opt-cfg-find-block
          out
          (compiler_ir_types.compiler-ir-label "body__bce_guard"))
          [(compiler_optimize.OptMaybeBlock.No) true]
          [(compiler_optimize.OptMaybeBlock.Some _) false])
        3]
      ;; the WHOLE nest cloned: the inner loop's blocks came along.
      [(not
          (opt-block-list-has-label?
            out
            (compiler_ir_types.compiler-ir-label "inner_header__bce_fast")))
        4]
      [(not
          (opt-block-list-has-label?
            out
            (compiler_ir_types.compiler-ir-label "inner_body__bce_fast")))
        5]
      ;; the outer loop's own checks -- the counter and the bounded phi --
      ;; are gone from the fast clone ...
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        6]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            0))
        7]
      ;; ... while the INNER loop's own check, whose index is the inner
      ;; counter, is not covered by the outer guard and stays in the clone.
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "inner_body__bce_fast"))
            1))
        8]
      ;; the slow nest is untouched.
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        9]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "inner_body"))
            1))
        10]
      ;; the exit phi gained the parallel fast-edge input.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              out
              (compiler_ir_types.compiler-ir-label "exit"))
            2))
        11]
      ;; size, not shape: 40 pad movs still fit ...
      [(not (= (compiler_ir_types.compiler-ir-block-list-count big) 13)) 12]
      ;; ... 55 do not, and the rejection leaves the function untouched.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count too-big) 7)) 13]
      [(opt-block-list-has-label?
          too-big
          (compiler_ir_types.compiler-ir-label "body__bce_guard"))
        14]
      ;; Flat before nested: the inner loop versions and the outer nest, whose
      ;; clone would have to re-create `inner_header__bce_fast`, does not.
      [(not
          (opt-block-list-has-label?
            inner-first
            (compiler_ir_types.compiler-ir-label "inner_header__bce_guard")))
        15]
      [(opt-block-list-has-label?
          inner-first
          (compiler_ir_types.compiler-ir-label "body__bce_guard"))
        16]
      ;; original eight blocks + the inner guard + two inner fast clones
      [(not (= (compiler_ir_types.compiler-ir-block-list-count inner-first) 11))
        17]
      ;; the unclonable call rejects the whole nest.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count with-call) 7))
        18]
      [else 42])))

;; One versioning-shaped self-loop, parameterized so the rejection fixture can
;; hold two independent ones: counter phi, accumulator phi, one derivable
;; BoundsCheck on the counter, literal step 1, invariant bound. This is the
;; `opt-bce-version-test-blocks` variant-1 body, minus the variant switches.
(define (opt-bce-version-reject-test-loop-block
  [label : i64]
  [pred-label : i64]
  [exit-label : i64]
  [counter : i64]
  [acc : i64]
  [sum : i64]
  [next : i64]
  [cond-var : i64]
  [seed : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    label
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        counter
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          pred-label
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var next)
            label
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Phi
        acc
        (compiler_ir_types.compiler-ir-phi-input-cons
          seed
          pred-label
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var sum)
            label
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        sum
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var acc)
        (compiler_ir_types.CompilerIrValue.Var counter)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var counter)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "bce_version_ok"))
      (compiler_ir_types.CompilerIrInstr.BinOp
        next
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var counter)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        cond-var
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var next)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var cond-var)
        label
        exit-label))))

;; entry -> reject_loop_a -> reject_mid -> reject_loop_b -> reject_done: two
;; independent self-loops, each versionable on its own, chained through a
;; merge block that carries the first loop's accumulator into the second.
(define (opt-bce-version-reject-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "reject_loop_a"))))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-version-reject-test-loop-block
        (compiler_ir_types.compiler-ir-label "reject_loop_a")
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-label "reject_mid")
        3
        4
        5
        6
        7
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "reject_mid")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              8
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "reject_loop_a")
                (compiler_ir_types.CompilerIrPhiInputList.Nil))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "reject_loop_b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (opt-bce-version-reject-test-loop-block
            (compiler_ir_types.compiler-ir-label "reject_loop_b")
            (compiler_ir_types.compiler-ir-label "reject_mid")
            (compiler_ir_types.compiler-ir-label "reject_done")
            9
            10
            11
            12
            13
            (compiler_ir_types.CompilerIrValue.Var 8))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "reject_done")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Phi
                  14
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 11)
                    (compiler_ir_types.compiler-ir-label "reject_loop_b")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil))
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 14)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-bce-version-reject-test-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_reject_fixture")
    (opt-bce-version-test-params)
    (compiler_ast_types.AstType.I64)
    15
    (opt-bce-version-reject-test-blocks)))

;; A verifier rejection retires ONE loop, not the function.
;;
;; Both versioners rebuild the function around each rewrite and verify it on
;; its own. A refusal used to return the last verified state AND stop, which
;; cost every remaining loop in the function its versioning -- exactly the
;; wrong trade in a big merged body. It now retires the refused loop for the
;; rest of the invocation and rescans, spending no budget on the refusal.
;;
;; Every rewrite these passes emit is verified by construction (generated
;; labels are proved fresh before a shape is admitted, guard operands are
;; proved loop-invariant, and the only new edges are the guard's and the
;; clone's, whose exit phis the rewrite extends), so the refusal is forced
;; here through `opt-bce-version-function-reject-probe`, which names one loop
;; whose application the driver must refuse.
(define (compiler-optimize-bce-version-reject-skip-self-test) : i64
  (let
    [none : i64 (compiler_ir_types.compiler-ir-label-none)]
    [loop-a : i64 (compiler_ir_types.compiler-ir-label "reject_loop_a")]
    [loop-b : i64 (compiler_ir_types.compiler-ir-label "reject_loop_b")]
    [fast-a : i64
      (compiler_ir_types.compiler-ir-label "reject_loop_a__bce_fast")]
    [fast-b : i64
      (compiler_ir_types.compiler-ir-label "reject_loop_b__bce_fast")]
    ;; No probe: the driver behaves exactly as the production entry does.
    [both : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function-reject-probe
        (opt-bce-version-reject-test-function)
        none)]
    [both-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks both)]
    [plain-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function
          (opt-bce-version-reject-test-function)))]
    ;; The FIRST loop's application is refused: the second must still version.
    [skip-a : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function-reject-probe
        (opt-bce-version-reject-test-function)
        loop-a)]
    [skip-a-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks skip-a)]
    ;; ... and symmetrically for the second loop.
    [skip-b : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function-reject-probe
        (opt-bce-version-reject-test-function)
        loop-b)]
    [skip-b-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks skip-b)]
    ;; The multi-block arm, on the nest fixture whose inner loop versions
    ;; first: refusing the inner loop must hand the slot to the outer nest,
    ;; which is versionable exactly because the inner one did not take it.
    [nest-inner : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function-reject-probe
          (opt-bce-mb-test-nest-function 1 0)
          none))]
    [nest-skip : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function-reject-probe
        (opt-bce-mb-test-nest-function 1 0)
        (compiler_ir_types.compiler-ir-label "inner_header"))]
    [nest-skip-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks nest-skip)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function both)))
        1]
      ;; entry + two guards + two fast clones + two slow loops + mid + done
      [(not (= (compiler_ir_types.compiler-ir-block-list-count both-out) 9)) 2]
      [(not (opt-block-list-has-label? both-out fast-a)) 3]
      [(not (opt-block-list-has-label? both-out fast-b)) 4]
      ;; an unprobed run is the production entry, block for block
      [(not (= (compiler_ir_types.compiler-ir-block-list-count plain-out) 9)) 5]
      [(not (opt-block-list-has-label? plain-out fast-a)) 6]
      [(not (opt-block-list-has-label? plain-out fast-b)) 7]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function skip-a)))
        8]
      ;; the refused loop is untouched ...
      [(opt-block-list-has-label? skip-a-out fast-a) 9]
      [(not (= (opt-bce-version-test-block-checks skip-a-out loop-a) 1)) 10]
      ;; ... and the OTHER loop still versioned: the whole point.
      [(not (opt-block-list-has-label? skip-a-out fast-b)) 11]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count skip-a-out) 7))
        12]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function skip-b)))
        13]
      [(opt-block-list-has-label? skip-b-out fast-b) 14]
      [(not (opt-block-list-has-label? skip-b-out fast-a)) 15]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count skip-b-out) 7))
        16]
      ;; unprobed multi-block control: the inner loop takes the slot.
      [(not
          (opt-block-list-has-label?
            nest-inner
            (compiler_ir_types.compiler-ir-label "inner_header__bce_guard")))
        17]
      [(opt-block-list-has-label?
          nest-inner
          (compiler_ir_types.compiler-ir-label "body__bce_guard"))
        18]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function nest-skip)))
        19]
      [(opt-block-list-has-label?
          nest-skip-out
          (compiler_ir_types.compiler-ir-label "inner_header__bce_guard"))
        20]
      ;; the refused inner loop did not cost the enclosing nest its versioning
      [(not
          (opt-block-list-has-label?
            nest-skip-out
            (compiler_ir_types.compiler-ir-label "body__bce_guard")))
        21]
      [(not
          (opt-block-list-has-label?
            nest-skip-out
            (compiler_ir_types.compiler-ir-label "inner_header__bce_fast")))
        22]
      [else 42])))

;; Partial versioning: the swap check's loaded index does not derive, but the
;; body's counter check does -- the loop versions, the fast clone drops only
;; the counter check and KEEPS the swap check (remapped).
(define (compiler-optimize-bce-version-mb-partial-self-test) : i64
  (let
    [versioned : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 1)))]
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks versioned)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function versioned)))
        1]
      ;; entry + guard + four fast clones + four slow blocks + exit
      [(not (= (compiler_ir_types.compiler-ir-block-list-count out) 11)) 2]
      ;; the derivable counter check is gone from the fast header...
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        3]
      ;; ... while the underivable swap check STAYS in the fast clone ...
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            1))
        4]
      ;; ... and the slow loop keeps both of its checks.
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        6]
      ;; the exit phi gained the parallel fast-edge input.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              out
              (compiler_ir_types.compiler-ir-label "exit"))
            2))
        7]
      [else 42])))

;; --- P5a self-tests: shifted limits, offset indices, guard minimization ------
;;
;; One top-tested counted loop, with the checks in a body block the counter
;; compare DOMINATES (a check in the compare's own block runs one time more than
;; the body and is deliberately kept -- the shape's `uncovered` set):
;;
;;   entry [-> pre] -> body (counter phi, compare) -> work (checks) [-> pads]
;;     -> latch (i += 1) -> body;  the compare's false arm leaves to exit
;;
;; Variants, one capability each:
;;   0  `i < n`, one check on `i`                the unshifted control
;;   1  `i + 6 <= n`, one check on `i`           an INCLUSIVE, OFFSET-counter
;;                                               compare: the limit is `n - 5`,
;;                                               materialized in the guard, and
;;                                               the shift's own no-wrap pair
;;   2  `i < n`, checks on `i` and `i + 2`       counter + K, stated by the
;;                                               literal-base fan as ONE Sub for
;;                                               the whole family
;;   3  `i < n`, `i` and a LOADED index          partial versioning: the loaded
;;                                               check stays in the fast clone
;;   4  variant 0 behind a rotation guard        the guard drops the
;;      (`entry: 0 < n` -> `pre` -> body)        `seed < bound` conjunct a
;;                                               dominating branch decided
;;   5  variant 0 plus 26 forwarder blocks       29 loop blocks: over the old
;;                                               block cap, inside the
;;                                               instruction budget
(define opt-bce-p5a-test-frame : i64
  16)

(define (opt-bce-p5a-test-pads [variant : i64]) : i64
  (if (= variant 5)
    26
    0))

(define (opt-bce-p5a-test-preheader [variant : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (if (= variant 4)
      "pre"
      "entry")))

(define (opt-bce-p5a-test-pad-label [index : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat "p5a_pad" (string.int->string index))))

(define (opt-bce-p5a-test-work-target [variant : i64]) : i64
  (if (> (opt-bce-p5a-test-pads variant) 0)
    (opt-bce-p5a-test-pad-label 0)
    (compiler_ir_types.compiler-ir-label "latch")))

(define (opt-bce-p5a-test-pad-blocks
  [index : i64]
  [count : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index count)
    tail
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-mb-test-jump-block
        (opt-bce-p5a-test-pad-label index)
        (if (>= (+ index 1) count)
          (compiler_ir_types.compiler-ir-label "latch")
          (opt-bce-p5a-test-pad-label (+ index 1))))
      (opt-bce-p5a-test-pad-blocks (+ index 1) count tail))))

(define (opt-bce-p5a-test-entry-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "entry")
    (if (= variant 4)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          11
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrValue.Var 0)
          ;; the OPERAND type, which is what the lowering emits for a compare
          ;; and what the dominating-fact reader requires
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.compiler-ir-label "pre")
          (compiler_ir_types.compiler-ir-label "exit")))
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "body"))))))

(define (opt-bce-p5a-test-body-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (if (= variant 1)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 6)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Le)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.compiler-ir-label "work")
            (compiler_ir_types.compiler-ir-label "exit")))
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.compiler-ir-label "work")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.CompilerIrInstr.Phi
        3
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (opt-bce-p5a-test-preheader variant)
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64)))))

(define (opt-bce-p5a-test-work-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "work")
    (opt-test-instrs-with-tail
      (cond
        [(= variant 2)
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              6
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.I64 2)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "p5a_ok1"))
            (compiler_ir_types.CompilerIrInstr.Jump
              (opt-bce-p5a-test-work-target variant)))]
        [(= variant 3)
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Gep
              9
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Load
              8
              (compiler_ir_types.CompilerIrValue.Var 9)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 8)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "p5a_ok1"))
            (compiler_ir_types.CompilerIrInstr.Jump
              (opt-bce-p5a-test-work-target variant)))]
        [else
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (opt-bce-p5a-test-work-target variant)))])
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "p5a_ok0")))))

(define (opt-bce-p5a-test-latch-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "latch")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.BinOp
        7
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "body")))))

(define (opt-bce-p5a-test-exit-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "exit")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.I64 0))))))

(define (opt-bce-p5a-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-bce-p5a-test-entry-block variant)
    (if (= variant 4)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-bce-mb-test-jump-block
          (compiler_ir_types.compiler-ir-label "pre")
          (compiler_ir_types.compiler-ir-label "body"))
        (opt-bce-p5a-test-loop-blocks variant))
      (opt-bce-p5a-test-loop-blocks variant))))

(define (opt-bce-p5a-test-loop-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-bce-p5a-test-body-block variant)
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-p5a-test-work-block variant)
      (opt-bce-p5a-test-pad-blocks
        0
        (opt-bce-p5a-test-pads variant)
        (compiler_ir_types.compiler-ir-block-cons
          (opt-bce-p5a-test-latch-block)
          (compiler_ir_types.compiler-ir-block-cons
            (opt-bce-p5a-test-exit-block)
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-bce-p5a-test-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_p5a_fixture")
    (opt-bce-version-test-params)
    (compiler_ast_types.AstType.I64)
    opt-bce-p5a-test-frame
    (opt-bce-p5a-test-blocks variant)))

(define (opt-bce-p5a-test-versioned [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-bce-version-function
    (opt-bce-p5a-test-function variant)))

(define (compiler-optimize-bce-version-p5a-self-test) : i64
  (let
    [guard-label : i64 (compiler_ir_types.compiler-ir-label "body__bce_guard")]
    [fast-work : i64 (compiler_ir_types.compiler-ir-label "work__bce_fast")]
    [plain : compiler_ir_types.CompilerIrFunction
      (opt-bce-p5a-test-versioned 0)]
    [plain-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks plain)]
    [shifted : compiler_ir_types.CompilerIrFunction
      (opt-bce-p5a-test-versioned 1)]
    [shifted-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks shifted)]
    [offset : compiler_ir_types.CompilerIrFunction
      (opt-bce-p5a-test-versioned 2)]
    [offset-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks offset)]
    [partial : compiler_ir_types.CompilerIrFunction
      (opt-bce-p5a-test-versioned 3)]
    [partial-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks partial)]
    [rotated : compiler_ir_types.CompilerIrFunction
      (opt-bce-p5a-test-versioned 4)]
    [rotated-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks rotated)]
    [wide : compiler_ir_types.CompilerIrFunction (opt-bce-p5a-test-versioned 5)]
    [wide-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks wide)]
    (cond
      ;; the unshifted control versions check-free, and its guard states the
      ;; once-only `seed < bound` (one Lt) and `bound <= len` (one Le).
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function plain)))
        1]
      [(not (opt-block-list-has-label? plain-out guard-label)) 2]
      [(not (= (opt-bce-version-test-block-checks plain-out fast-work) 0)) 3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              plain-out
              (compiler_ir_types.compiler-ir-label "work"))
            1))
        4]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              plain-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Lt))
            1))
        5]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              plain-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Le))
            1))
        6]
      ;; INCLUSIVE + OFFSET compare: `i + 6 <= n` is the counter range
      ;; [0, n - 5), so the guard materializes `n + -5` and states the shift
      ;; did not wrap (`limit <= bound`, a second Le).
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function shifted)))
        7]
      [(not (opt-block-list-has-label? shifted-out guard-label)) 8]
      [(not (= (opt-bce-version-test-block-checks shifted-out fast-work) 0)) 9]
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            shifted-out
            guard-label
            (compiler_ir_types.CompilerIrBinOp.Add)
            (- 0 5)))
        10]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              shifted-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Le))
            2))
        11]
      ;; counter + K: both checks derive, and the literal-base fan states the
      ;; family as ONE Sub (`len - 2`) with ONE Le, exactly what the bare
      ;; counter alone costs above.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function offset)))
        12]
      [(not (= (opt-bce-version-test-block-checks offset-out fast-work) 0)) 13]
      [(not
          (=
            (opt-bce-version-test-block-checks
              offset-out
              (compiler_ir_types.compiler-ir-label "work"))
            2))
        14]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              offset-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Sub))
            1))
        15]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              offset-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Le))
            1))
        16]
      ;; PARTIAL: the counter check leaves the clone, the loaded index stays.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function partial)))
        17]
      [(not (= (opt-bce-version-test-block-checks partial-out fast-work) 1)) 18]
      [(not
          (=
            (opt-bce-version-test-block-checks
              partial-out
              (compiler_ir_types.compiler-ir-label "work"))
            2))
        19]
      ;; GUARD MINIMIZATION: the rotation guard already decided `0 < n` on the
      ;; only edge into the preheader, so the conjunct is not re-emitted -- no
      ;; Lt at all, and `bound <= len` alone selects the clone.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function rotated)))
        20]
      [(not (opt-block-list-has-label? rotated-out guard-label)) 21]
      [(not (= (opt-bce-version-test-block-checks rotated-out fast-work) 0)) 22]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              rotated-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Lt))
            0))
        23]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              rotated-out
              guard-label
              (compiler_ir_types.CompilerIrBinOp.Le))
            1))
        24]
      ;; BLOCK COUNT: 29 loop blocks -- over the cap this pass used to carry,
      ;; inside the instruction budget that is now the only growth metric.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function wide)))
        25]
      [(not (opt-block-list-has-label? wide-out guard-label)) 26]
      [(not (= (opt-bce-version-test-block-checks wide-out fast-work) 0)) 27]
      [(not
          (opt-block-list-has-label?
            wide-out
            (compiler_ir_types.compiler-ir-label "p5a_pad25__bce_fast")))
        28]
      [else 42])))

(test
  bce-version-p5a-shifted-and-minimized
  (test.assert-i64-eq
    (compiler-optimize-bce-version-p5a-self-test)
    42
    "shifted-limit compares, counter+K indices, partial keeps, a minimized guard and a 29-block loop all version"))

;; --- P5a: the unroller's trip-remainder refusal ------------------------------
;;
;; `it-hash-words`' byte tail in miniature. A merge feeds the loop's seed, and
;; both of its inputs arrive on edges that decided `value >= n - 7`, so the whole
;; trip count is at most 7 -- less than the factor the rewrite would clone for,
;; whose guard (`seed < n - K`) can therefore never be true. `bounded?` false is
;; the control: the same shape with one input arriving on a plain Jump, which
;; proves nothing and must still unroll.
;;
;;   entry (0 >= n-7 on the join edge) -> join <- other (v >= n-7, or a Jump)
;;   join -> body (self-loop: i/acc phis, acc += i, i += 1, i' < n) -> exit
(define (opt-unroll-p5a-remainder-blocks [bounded? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          8
          (compiler_ir_types.CompilerIrBinOp.Sub)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          9
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrValue.Var 8)
          ;; the OPERAND type, as the lowering emits for a compare
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 9)
          (compiler_ir_types.compiler-ir-label "other")
          (compiler_ir_types.compiler-ir-label "join"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "other")
        (opt-test-instrs-with-tail
          (if bounded?
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                11
                (compiler_ir_types.CompilerIrBinOp.Lt)
                (compiler_ir_types.CompilerIrValue.Var 10)
                (compiler_ir_types.CompilerIrValue.Var 8)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 11)
                (compiler_ir_types.compiler-ir-label "exit")
                (compiler_ir_types.compiler-ir-label "join")))
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.CompilerIrInstr.Mov
            10
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.I64))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "join")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              2
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.I64 0)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 10)
                  (compiler_ir_types.compiler-ir-label "other")
                  (compiler_ir_types.CompilerIrPhiInputList.Nil)))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BinOp
              12
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 12)
              (compiler_ir_types.compiler-ir-label "body")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                3
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.compiler-ir-label "join")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 6)
                    (compiler_ir_types.compiler-ir-label "body")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.I64 0)
                  (compiler_ir_types.compiler-ir-label "join")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.compiler-ir-label "body")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.BinOp
                5
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.BinOp
                6
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.BinOp
                7
                (compiler_ir_types.CompilerIrBinOp.Lt)
                (compiler_ir_types.CompilerIrValue.Var 6)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 7)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 0)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-unroll-p5a-remainder-function [bounded? : bool]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "unroll_p5a_remainder_fixture")
    (opt-unroll-test-params)
    (compiler_ast_types.AstType.I64)
    16
    (opt-unroll-p5a-remainder-blocks bounded?)))

(define (compiler-optimize-unroll-p5a-remainder-self-test) : i64
  (let
    [guard-label : i64
      (compiler_ir_types.compiler-ir-label "body__unroll_guard")]
    [bounded : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-p5a-remainder-function true))]
    [bounded-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks bounded)]
    [control : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-p5a-remainder-function false))]
    [control-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks control)]
    (cond
      ;; a trip count of at most 7 leaves the loop alone: five blocks, no guard.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function bounded)))
        1]
      [(opt-block-list-has-label? bounded-out guard-label) 2]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count bounded-out) 5))
        3]
      ;; the control proves nothing about its second input and unrolls.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function control)))
        4]
      [(not (opt-block-list-has-label? control-out guard-label)) 5]
      [(not (> (compiler_ir_types.compiler-ir-block-list-count control-out) 5))
        6]
      [else 42])))

(test
  unroll-p5a-dead-remainder-clone
  (test.assert-i64-eq
    (compiler-optimize-unroll-p5a-remainder-self-test)
    42
    "a loop whose whole trip count is a literal remainder is not unrolled"))

;; --- Gep use-splitting self-tests --------------------------------------------
;; Invariant-offset Gep splitting. One counted loop reading `a[start + i]`,
;; with the variant selector perturbing exactly one gate at a time:
;;   0  the plain shape: the Add is single-use and both operands are clean
;;   1  a non-Gep consumer of the Add (the all-uses gate rejects)
;;   2  a second in-loop use of the invariant addend with one base (the
;;      pressure gate rejects: the addend would stay live for no saving)
;;   3  the Gep base is defined inside the loop (no preheader home for the
;;      derived base, so the correctness filter rejects)
;;   4  two bases share the Add AND the addend has a second in-loop use: k >= 2
;;      pays for the surviving addend, so this one splits
;;   5  the plain shape reached through a branching guard, so the header has no
;;      dedicated preheader and one has to be synthesized first
;;   6  ONE base indexed at two different invariant offsets: each needs its own
;;      derived base, and sharing one across the offsets would retarget the
;;      second address
;;   7  a DEAD Cast of the Add, the chain a removed BoundsCheck strands: the
;;      pipeline DCE retires it, so it must not count against the all-uses gate
;; Variants 1 and 2 keep their perturbation LIVE (a store consumes it);
;; otherwise the dead-use settling would retire it and the gate would not be
;; exercised at all.
(define (opt-gep-offset-test-tail) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      15
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "loop"))))

;; The perturbation each variant injects after the load.
(define (opt-gep-offset-test-consume [value : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-gep-offset-test-tail)
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 13)
      (compiler_ir_types.CompilerIrValue.Var value)
      (compiler_ast_types.AstType.I64))))

(define (opt-gep-offset-test-extras [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (cond
    [(= variant 7)
      ;; the dead cast a removed BoundsCheck leaves behind
      (opt-test-instrs-with-tail
        (opt-gep-offset-test-tail)
        (compiler_ir_types.CompilerIrInstr.Cast
          16
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64)))]
    [(= variant 1)
      ;; a plain arithmetic consumer of the Add: not an address use
      (opt-test-instrs-with-tail
        (opt-gep-offset-test-consume 16)
        (compiler_ir_types.CompilerIrInstr.BinOp
          16
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64)))]
    [(or (= variant 2) (= variant 4))
      ;; a second in-loop reader of the invariant addend
      (opt-test-instrs-with-tail
        (opt-gep-offset-test-consume 17)
        (compiler_ir_types.CompilerIrInstr.BinOp
          17
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64)))]
    [else (opt-gep-offset-test-tail)]))

;; Variant 6 adds a second Add/Gep on the SAME base at a different invariant
;; offset: the derived-base cache has to key on the offset as well as the base.
(define (opt-gep-offset-test-second-offset [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 6)
    (opt-test-instrs-with-tail
      (opt-gep-offset-test-extras variant)
      (compiler_ir_types.CompilerIrInstr.BinOp
        21
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 10)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Gep
        22
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 21)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        23
        (compiler_ir_types.CompilerIrValue.Var 22)
        (compiler_ast_types.AstType.I64)))
    (opt-gep-offset-test-extras variant)))

;; Variant 4 adds a second Gep on a different base, sharing the same Add.
(define (opt-gep-offset-test-second-base [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 4)
    (opt-test-instrs-with-tail
      (opt-gep-offset-test-extras variant)
      (compiler_ir_types.CompilerIrInstr.Gep
        19
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.CompilerIrValue.Var 12)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        20
        (compiler_ir_types.CompilerIrValue.Var 19)
        (compiler_ast_types.AstType.I64)))
    (opt-gep-offset-test-second-offset variant)))

(define (opt-gep-offset-test-body-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [base : compiler_ir_types.CompilerIrValue
      (if (= variant 3)
        (compiler_ir_types.CompilerIrValue.Var 18)
        (compiler_ir_types.CompilerIrValue.Var 0))]
    [core : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (opt-gep-offset-test-second-base variant)
        (compiler_ir_types.CompilerIrInstr.BinOp
          12
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Gep
          13
          base
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          14
          (compiler_ir_types.CompilerIrValue.Var 13)
          (compiler_ast_types.AstType.I64)))]
    (if (= variant 3)
      ;; the base itself becomes loop variant
      (opt-test-instrs-with-tail
        core
        (compiler_ir_types.CompilerIrInstr.BinOp
          18
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ast_types.AstType.I64)))
      core)))

(define (opt-gep-offset-test-loop-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      10
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 15)
          (compiler_ir_types.compiler-ir-label "body")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      11
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 11)
      (compiler_ir_types.compiler-ir-label "body")
      (compiler_ir_types.compiler-ir-label "exit"))))

;; Variant 5 enters the loop from a two-successor guard, which is exactly the
;; bce fast-clone shape: `opt-natural-loop-safe-preheader-block?` rejects it, so
;; the pass has to synthesize a preheader before it can hoist anything.
(define (opt-gep-offset-test-entry-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 5)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ir_types.compiler-ir-label "loop")
        (compiler_ir_types.compiler-ir-label "exit")))
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "loop")))))

(define (opt-gep-offset-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-gep-offset-test-entry-instrs variant))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-gep-offset-test-loop-instrs))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-gep-offset-test-body-instrs variant))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-gep-offset-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "base-a"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "base-b"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "n"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "start"
            (compiler_ast_types.AstType.I64)
            3)
          (compiler_ir_types.compiler-ir-param-cons
            (compiler_ir_types.CompilerIrParam.Param
              "start2"
              (compiler_ast_types.AstType.I64)
              4)
            (compiler_ir_types.CompilerIrParamList.Nil)))))))

(define (opt-gep-offset-test-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "gep_offset")
    (opt-gep-offset-test-params)
    (compiler_ast_types.AstType.I64)
    24
    (opt-gep-offset-test-blocks variant)))

(define (opt-gep-offset-test-run [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-gep-offset-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-gep-offset-test-function variant)))

(define (opt-gep-offset-test-gep-count-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (opt-gep-offset-test-gep-count-from
      instrs
      (+ index 1)
      (+
        acc
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          [(compiler_ir_types.CompilerIrInstr.Gep _ _ _ _) 1]
          [_ 0])))))

;; Geps in the block that carries `label`; -1 when there is no such block.
(define (opt-gep-offset-test-geps-in
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-gep-offset-test-gep-count-from instrs 0 0)])]))

;; The body Gep must now index on the loop counter itself, not on the Add.
(define (opt-gep-offset-test-body-index-is-counter?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "body"))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-gep-offset-test-body-index-scan instrs 0 false)])]))

(define (opt-gep-offset-test-body-index-scan
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [seen : bool]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    seen
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Gep _ _ offset _)
        (if (compiler_optimize.opt-value-eq
          offset
          (compiler_ir_types.CompilerIrValue.Var 10))
          (opt-gep-offset-test-body-index-scan instrs (+ index 1) true)
          false)]
      [_ (opt-gep-offset-test-body-index-scan instrs (+ index 1) seen)])))

(define (opt-gep-offset-test-nth-gep-offset
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [skip : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Gep _ _ offset _)
        (if (= skip 0)
          offset
          (opt-gep-offset-test-nth-gep-offset instrs (+ index 1) (- skip 1)))]
      [_ (opt-gep-offset-test-nth-gep-offset instrs (+ index 1) skip)])))

;; Two derived bases for one array must carry the two different offsets; a
;; cache keyed on the base alone would emit the same offset twice.
(define (opt-gep-offset-test-derived-offsets-distinct?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (not
            (compiler_optimize.opt-value-eq
              (opt-gep-offset-test-nth-gep-offset instrs 0 0)
              (opt-gep-offset-test-nth-gep-offset instrs 0 1)))])]))

(define (opt-gep-offset-test-unchanged? [variant : i64]) : bool
  (compiler_optimize.opt-block-list-eq
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-function-blocks (opt-gep-offset-test-run variant))
    (opt-gep-offset-test-blocks variant)))

(define (compiler-optimize-gep-offset-self-test) : i64
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [split : compiler_ir_types.CompilerIrFunction (opt-gep-offset-test-run 0)]
    [split-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks split)]
    [twice : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-gep-offset-function bases split)]
    [shared : compiler_ir_types.CompilerIrFunction (opt-gep-offset-test-run 4)]
    [shared-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks shared)]
    [synthesized : compiler_ir_types.CompilerIrFunction
      (opt-gep-offset-test-run 5)]
    [synthesized-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks synthesized)]
    [two-offsets : compiler_ir_types.CompilerIrFunction
      (opt-gep-offset-test-run 6)]
    [two-offset-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks two-offsets)]
    [stranded : compiler_ir_types.CompilerIrFunction
      (opt-gep-offset-test-run 7)]
    [stranded-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks stranded)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function split)))
        1]
      ;; the derived base lands in the existing preheader (the entry block),
      ;; and the body keeps its one Gep
      [(not
          (=
            (opt-gep-offset-test-geps-in
              split-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            1))
        2]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              split-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        3]
      [(not (opt-gep-offset-test-body-index-is-counter? split-blocks)) 4]
      ;; one fresh var for the one derived base
      [(not (= (compiler_optimize.opt-function-frame split) 25)) 5]
      ;; a non-address consumer of the Add rejects the whole Add
      [(not (opt-gep-offset-test-unchanged? 1)) 6]
      ;; the addend would survive the rewrite and only one base pays for it
      [(not (opt-gep-offset-test-unchanged? 2)) 7]
      ;; the Gep base is loop variant: no preheader home for the derived base
      [(not (opt-gep-offset-test-unchanged? 3)) 8]
      ;; two bases DO pay for a surviving addend: one derived base each
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function shared)))
        9]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              shared-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        10]
      [(not (= (compiler_optimize.opt-function-frame shared) 26)) 11]
      ;; a guard with two successors is not a preheader, so one is synthesized
      ;; ahead of the header and the derived base lands there
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function synthesized)))
        12]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count synthesized-blocks)
            5))
        13]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              synthesized-blocks
              (compiler_ir_types.compiler-ir-label "loop__preheader"))
            1))
        14]
      ;; idempotence: the next pipeline iteration finds no Add left to split
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function twice)))
        15]
      [(not
          (compiler_optimize.opt-block-list-eq
            bases
            split-blocks
            (compiler_optimize.opt-function-blocks twice)))
        16]
      ;; one array at two invariant offsets: a derived base each, carrying the
      ;; two different offsets
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function two-offsets)))
        17]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              two-offset-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        18]
      [(not
          (opt-gep-offset-test-derived-offsets-distinct?
            two-offset-blocks
            (compiler_ir_types.compiler-ir-label "entry")))
        19]
      [(not (= (compiler_optimize.opt-function-frame two-offsets) 26)) 20]
      ;; a dead Cast of the Add is retired by the pipeline DCE, so it must not
      ;; hold the split back
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function stranded)))
        21]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              stranded-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            1))
        22]
      [(not (opt-gep-offset-test-body-index-is-counter? stranded-blocks)) 23]
      [else 42])))

(test
  gep-offset-invariant-split
  (test.assert-i64-eq
    (compiler-optimize-gep-offset-self-test)
    42
    "invariant-offset Gep splitting hoists one derived base per (base, type), gates on all-uses and register pressure, synthesizes a missing preheader, and is idempotent"))

;; --- invariant-offset Gep splitting: the nested / unrolled shapes ------------
;; `liveness_storage/recompute!`'s inner scan, which is how every 2-D walk in
;; the corpus indexes: an OUTER loop derives the row base in its landing block
;; and the INNER loop reads `data[row + i]`, entered from a two-successor guard
;; so its header has no dedicated preheader. The variant selector perturbs one
;; gate at a time:
;;   0  one access, and the addend is defined in the ENCLOSING loop -- invariant
;;      for the loop being processed wherever it is defined, so this splits
;;   1  TWO accesses on ONE base sharing that addend (the unroll clone shape)
;;      while the addend ALSO feeds an in-loop non-address use: k >= 2 accesses
;;      pay for the surviving addend, and both Geps adopt the SAME derived base
;;   2  the same surviving addend with only ONE access: k = 1 does not pay for
;;      it, so the pressure gate rejects
;;   3  the Gep base is LOADED in the outer loop's landing block: a load outside
;;      the inner loop is still invariant for it, so this splits
(define (opt-gep-nested-test-latch-tail) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (compiler_ir_types.CompilerIrInstr.BinOp
      30
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.BinOp
        31
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 30)
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ast_types.AstType.Bool))
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 31)
          (compiler_ir_types.compiler-ir-label "inner")
          (compiler_ir_types.compiler-ir-label "latch"))
        (compiler_ir_types.compiler-ir-instr-seq-empty)))))

;; A non-address in-loop reader of the invariant addend, kept live by a store so
;; the dead-use settling cannot retire it: the addend outlives the rewrite, which
;; is exactly what the k >= 2 gate judges.
(define (opt-gep-nested-test-addend-use [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (or (= variant 1) (= variant 2))
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.BinOp
        28
        (compiler_ir_types.CompilerIrBinOp.Mul)
        (compiler_ir_types.CompilerIrValue.Var 13)
        (compiler_ir_types.CompilerIrValue.I64 3)
        (compiler_ast_types.AstType.I64))
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 22)
          (compiler_ir_types.CompilerIrValue.Var 28)
          (compiler_ast_types.AstType.I64))
        (opt-gep-nested-test-latch-tail)))
    (opt-gep-nested-test-latch-tail)))

;; Variant 1's second access: the unroll clone's `data[row + i + 1]`, a second
;; Add on the same base and the same addend at the next counter offset.
(define (opt-gep-nested-test-second-access
  [variant : i64]
  [base : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 1)
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.BinOp
        25
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 20)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.BinOp
          24
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 13)
          (compiler_ir_types.CompilerIrValue.Var 25)
          (compiler_ast_types.AstType.I64))
        (opt-test-instr-seq-prepend
          (compiler_ir_types.CompilerIrInstr.Gep
            26
            base
            (compiler_ir_types.CompilerIrValue.Var 24)
            (compiler_ast_types.AstType.I64))
          (opt-test-instr-seq-prepend
            (compiler_ir_types.CompilerIrInstr.Load
              27
              (compiler_ir_types.CompilerIrValue.Var 26)
              (compiler_ast_types.AstType.I64))
            (opt-gep-nested-test-addend-use variant)))))
    (opt-gep-nested-test-addend-use variant)))

(define (opt-gep-nested-test-inner-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [base : compiler_ir_types.CompilerIrValue
      (if (= variant 3)
        (compiler_ir_types.CompilerIrValue.Var 15)
        (compiler_ir_types.CompilerIrValue.Var 1))]
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.Phi
        20
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "iguard")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 30)
            (compiler_ir_types.compiler-ir-label "inner")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.BinOp
          21
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 13)
          (compiler_ir_types.CompilerIrValue.Var 20)
          (compiler_ast_types.AstType.I64))
        (opt-test-instr-seq-prepend
          (compiler_ir_types.CompilerIrInstr.Gep
            22
            base
            (compiler_ir_types.CompilerIrValue.Var 21)
            (compiler_ast_types.AstType.I64))
          (opt-test-instr-seq-prepend
            (compiler_ir_types.CompilerIrInstr.Load
              23
              (compiler_ir_types.CompilerIrValue.Var 22)
              (compiler_ast_types.AstType.I64))
            (opt-gep-nested-test-second-access variant base)))))))

;; The outer loop's landing block: the row base the inner loop indexes from, and
;; the descriptor load that variant 3 uses as the Gep base.
(define (opt-gep-nested-test-land-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (compiler_ir_types.CompilerIrInstr.BinOp
      12
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.BinOp
        13
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 12)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ast_types.AstType.I64))
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.Gep
          14
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (opt-test-instr-seq-prepend
          (compiler_ir_types.CompilerIrInstr.Load
            15
            (compiler_ir_types.CompilerIrValue.Var 14)
            (compiler_ast_types.AstType.I64))
          (opt-test-instr-seq-prepend
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "iguard"))
            (compiler_ir_types.compiler-ir-instr-seq-empty)))))))

(define (opt-gep-nested-test-outer-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (compiler_ir_types.CompilerIrInstr.Phi
      10
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 40)
          (compiler_ir_types.compiler-ir-label "latch")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.BinOp
        11
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 10)
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ast_types.AstType.Bool))
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.compiler-ir-label "land")
          (compiler_ir_types.compiler-ir-label "exit"))
        (compiler_ir_types.compiler-ir-instr-seq-empty)))))

(define (opt-gep-nested-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "outer"))
        (compiler_ir_types.compiler-ir-instr-seq-empty)))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "outer")
        (opt-gep-nested-test-outer-instrs))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "land")
          (opt-gep-nested-test-land-instrs))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "iguard")
            (opt-test-instr-seq-prepend
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 11)
                (compiler_ir_types.compiler-ir-label "inner")
                (compiler_ir_types.compiler-ir-label "latch"))
              (compiler_ir_types.compiler-ir-instr-seq-empty)))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "inner")
              (opt-gep-nested-test-inner-instrs variant))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "latch")
                (opt-test-instr-seq-prepend
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    40
                    (compiler_ir_types.CompilerIrBinOp.Add)
                    (compiler_ir_types.CompilerIrValue.Var 10)
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ast_types.AstType.I64))
                  (opt-test-instr-seq-prepend
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "outer"))
                    (compiler_ir_types.compiler-ir-instr-seq-empty))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "exit")
                  (opt-test-instr-seq-prepend
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.I64 0)))
                    (compiler_ir_types.compiler-ir-instr-seq-empty)))
                (compiler_ir_types.CompilerIrBlockList.Nil)))))))))

(define (opt-gep-nested-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "descriptor"
      (compiler_ast_types.AstType.I64)
