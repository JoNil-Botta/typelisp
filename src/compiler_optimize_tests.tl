(define (opt-cs-test-n7) : ir.CompilerIrFunction
  (opt-cs-test-run
    "function @cs_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %1 = mov 0 : i64
       %10 = lt 0, %0 : i64
       branch %10, pre, extra
     pre:
       %2 = mov 0 : i64
       %3 = mov %0 : i64
       jump head
     head:
       %4 = lt %2, %3 : i64
       branch %4, body, exit
     body:
       %5 = mov %2 : i64
       %6 = add %2, 1 : i64
       %2 = mov %6 : i64
       %7 = add %1, %5 : i64
       %1 = mov %7 : i64
       jump head
     extra:
       jump body
     exit:
       return %1
     }"))

(define (opt-cs-test-n8) : ir.CompilerIrFunction
  (opt-cs-test-run
    "function @cs_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %1 = mov 0 : i64
       jump pre
     pre:
       %2 = mov 0 : i64
       %3 = mov %0 : i64
       jump head
     head:
       %4 = lt %2, %3 : i64
       branch %4, body, exit
     body:
       %5 = mov %2 : i64
       %6 = add %2, %0 : i64
       %2 = mov %6 : i64
       %7 = add %1, %5 : i64
       %1 = mov %7 : i64
       jump head
     exit:
