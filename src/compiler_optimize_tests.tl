(define (compiler-optimize-loop-rotation-self-test) : i64
  (let
    [raw : compiler_ir_types.CompilerIrBlockList
      (opt-loop-rotation-top-test-blocks false)]
    [rotated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-loop-rotation-blocks
        (compiler_ast_types.ast-node-pool-reader-context-current)
        raw)]
    [constant-edge-rotated : compiler_ir_types.CompilerIrBlockList
      (match (compiler_optimize.opt-loop-rotation-normalized-function-result
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (opt-cfg-test-function (opt-loop-rotation-top-test-blocks true)))
        [(compiler_optimize.OptBlockCtxResult.Result blocks _ _) blocks])]
    [false-body-rotated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-loop-rotation-blocks
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (opt-loop-rotation-false-body-blocks))]
    [ssa : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-cfg-test-function rotated))]
    [ssa-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks ssa)]
    [optimized : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-cfg-test-function raw))]
    [optimized-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks optimized)]
    [no-preheader : compiler_ir_types.CompilerIrBlockList
      (opt-natural-loop-no-preheader-blocks)]
    [multi-backedge : compiler_ir_types.CompilerIrBlockList
      (opt-natural-loop-multi-backedge-blocks)]
    [with-phi : compiler_ir_types.CompilerIrBlockList (opt-ssa-loop-blocks)]
    (cond
      [(not (= (compiler_ir_types.compiler-ir-block-list-count rotated) 3)) 1]
      [(opt-block-list-has-label?
          rotated
          (compiler_ir_types.compiler-ir-label "loop"))
        2]
      [(not
          (opt-loop-rotation-successors?
            rotated
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit")))
        3]
      [(not
          (opt-loop-rotation-successors?
            rotated
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit")))
        4]
      [(not
          (=
            (opt-count-jump-to-blocks
              rotated
              (compiler_ir_types.compiler-ir-label "loop"))
            0))
        5]
      [(not (= (opt-count-branches-blocks rotated) 2)) 6]
      [(opt-block-list-has-label?
          false-body-rotated
          (compiler_ir_types.compiler-ir-label "loop"))
        7]
      [(not
          (opt-loop-rotation-successors?
            false-body-rotated
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit")))
        8]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function ssa)))
        9]
      [(not (> (opt-count-phi-blocks ssa-blocks) 0)) 10]
      [(opt-block-list-has-label?
          optimized-blocks
          (compiler_ir_types.compiler-ir-label "loop"))
        11]
      [(not
          (compiler_optimize.opt-cfg-successor-targets-known? optimized-blocks))
        12]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-loop-rotation-blocks
              (compiler_ast_types.ast-node-pool-reader-context-current)
              no-preheader)
            no-preheader))
        13]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-loop-rotation-blocks
              (compiler_ast_types.ast-node-pool-reader-context-current)
              multi-backedge)
            multi-backedge))
        14]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-loop-rotation-blocks
              (compiler_ast_types.ast-node-pool-reader-context-current)
              with-phi)
            with-phi))
        15]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              constant-edge-rotated)
            3))
        16]
      [(opt-block-list-has-label?
          constant-edge-rotated
          (compiler_ir_types.compiler-ir-label "loop"))
        17]
      [(not
          (opt-loop-rotation-successors?
            constant-edge-rotated
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit")))
        18]
      [else 42])))

;; Nested-loop SSA fixture: the inner-loop counter/accumulator phis at the
;; OUTER header have no definition on the function-entry path. Before the
;; dead-path zero-input fix in opt-ssa-phi-inputs, materialization named the
;; ORIGINAL var on those inputs, the use-before-definition verify rejected the
;; result, and SSA construction silently fell back -- disabling every SSA-gated
;; pass (GVN, load-GVN, preheaders, LICM, induction, loop-BCE) for any function
;; containing a nested loop. The fixture mirrors a lowered nested array-sum:
;; handle-field geps/loads in the inner body must hoist once SSA succeeds.
(define (opt-ssa-nested-loop-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "rounds"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "arr"
          (compiler_ast_types.AstType.DynArray 0)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

(define (opt-ssa-nested-loop-inner-body) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      10
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      11
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      12
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      13
      (compiler_ir_types.CompilerIrValue.Var 12)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      14
      (compiler_ir_types.CompilerIrValue.Var 13)
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      15
      (compiler_ir_types.CompilerIrValue.Var 14)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      16
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.Var 15)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      19
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 16)
      (compiler_ir_types.CompilerIrValue.Var 11)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      3
      (compiler_ir_types.CompilerIrValue.Var 19)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      17
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      5
      (compiler_ir_types.CompilerIrValue.Var 17)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "inner_head"))))

(define (opt-ssa-nested-loop-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "ssa_nested_loop")
    (opt-ssa-nested-loop-params)
    (compiler_ast_types.AstType.I64)
    32
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            4
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "outer_head"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "outer_head")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              6
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.compiler-ir-label "outer_body")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "outer_body")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Mov
                5
                (compiler_ir_types.CompilerIrValue.I64 0)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "inner_head"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "inner_head")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.BinOp
                  7
                  (compiler_ir_types.CompilerIrBinOp.Lt)
                  (compiler_ir_types.CompilerIrValue.Var 5)
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ast_types.AstType.Bool))
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 7)
                  (compiler_ir_types.compiler-ir-label "inner_body")
                  (compiler_ir_types.compiler-ir-label "outer_latch"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "inner_body")
                (opt-ssa-nested-loop-inner-body))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "outer_latch")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.BinOp
                      18
                      (compiler_ir_types.CompilerIrBinOp.Add)
                      (compiler_ir_types.CompilerIrValue.Var 4)
                      (compiler_ir_types.CompilerIrValue.I64 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Mov
                      4
                      (compiler_ir_types.CompilerIrValue.Var 18)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "outer_head"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "exit")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 3)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; Fixture for the post-SSA rotation pass: `entry` is the single-successor
;; preheader, `header` carries one loop phi plus a pure guard and the loop
;; branch, `body` increments the phi, `latch` jumps back unconditionally, and
;; `exit` returns the phi (exercising the exit-phi path). With `side-exit`
;; the body branches straight to `exit`, which must reject the rotation.
(define (opt-rotate-ssa-test-blocks [side-exit : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            1
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "latch")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs-with-tail
            (if side-exit
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Bool true)
                  (compiler_ir_types.compiler-ir-label "latch")
                  (compiler_ir_types.compiler-ir-label "exit")))
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "latch"))))
            (compiler_ir_types.CompilerIrInstr.BinOp
              2
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "latch")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 1)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-rotate-ssa-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "rotate_ssa")
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.I64)
    4
    blocks))

(define (opt-rotate-ssa-test-run [side-exit : bool]) : compiler_ir_types.CompilerIrFunction
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rotate-ssa-test-blocks side-exit)]
    (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (opt-rotate-ssa-test-function blocks))
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

(define (opt-rotate-ssa-test-starts-with-phi?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (<= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]))

(define (opt-rotate-ssa-test-single-jump-to?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 1)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Jump jump-target)
                (= jump-target target)]
              [_ false])
            false)])]))

;; Two sibling counted loops, both rotatable. One rotation per invocation used
;; to mean the second one waited for the next PIPELINE iteration -- and the cap
;; is two, so a third loop never got one at all, while `bce_version` locked
;; whichever loops lost the race into their top-tested form. The rounds inside
;; the pass settle every loop before anything downstream reads the function.
(define (opt-rotate-ssa-test-counted-loop
  [header : String]
  [land : String]
  [body : String]
  [latch : String]
  [exit-label : String]
  [phi : i64]
  [step : i64]
  [cond-var : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label header)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Phi
          phi
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ir_types.compiler-ir-label land)
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var step)
              (compiler_ir_types.compiler-ir-label latch)
              (compiler_ir_types.CompilerIrPhiInputList.Nil)))
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          cond-var
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var phi)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var cond-var)
          (compiler_ir_types.compiler-ir-label body)
          (compiler_ir_types.compiler-ir-label exit-label))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label body)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            step
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var phi)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label latch))))
      (compiler_ir_types.compiler-ir-block-cons
        (opt-dead-phi-test-jump-block latch header)
        tail))))

(define (opt-rotate-ssa-test-siblings) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-dead-phi-test-jump-block "entry" "h1")
    (opt-rotate-ssa-test-counted-loop
      "h1"
      "entry"
      "b1"
      "l1"
      "mid"
      1
      2
      3
      (compiler_ir_types.compiler-ir-block-cons
        (opt-dead-phi-test-jump-block "mid" "h2")
        (opt-rotate-ssa-test-counted-loop
          "h2"
          "mid"
          "b2"
          "l2"
          "exit"
          4
          5
          6
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 4)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-rotate-ssa-test-siblings-run) : compiler_ir_types.CompilerIrFunction
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rotate-ssa-test-siblings)]
    (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (compiler_ir_types.CompilerIrFunction.Function
        (opt-test-symbol "rotate_ssa_siblings")
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "n"
            (compiler_ast_types.AstType.I64)
            0)
          (compiler_ir_types.CompilerIrParamList.Nil))
        (compiler_ast_types.AstType.I64)
        7
        blocks))
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

;; The `it-slice-eq?` class, in the shape `flag_exit` leaves behind: a
;; single-test header, and a body that can leave the loop through its OWN exit
;; block -- never through the header's exit arm, which is the break shape
;; `opt-rotate-ssa-body-avoids-exit?` still refuses. Both exits meet again in
;; `done`.
;;
;; With `live-out` the counter is also read past the loop, on BOTH exit edges.
;; The classified placement serves each edge from the block that dominates it:
;; the `exit` edge takes the fresh exit phi, and the `escape` edge keeps the
;; counter itself, because after rotation the BODY block holds the moved phi
;; and dominates the body's own exit. Both variants therefore rotate; the
;; blanket single-exit refusal this used to hit is gone.
(define (opt-rotate-ssa-test-second-exit-blocks [live-out : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-flag-exit-test-jump-block "entry" "header")
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            1
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "latch")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              4
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 7)
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.compiler-ir-label "cont")
              (compiler_ir_types.compiler-ir-label "escape"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "cont")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                2
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "latch" "header")
            (compiler_ir_types.compiler-ir-block-cons
              (opt-flag-exit-test-jump-block "escape" "done")
              (compiler_ir_types.compiler-ir-block-cons
                (opt-flag-exit-test-jump-block "exit" "done")
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "done")
                    (if live-out
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Phi
                          5
                          (compiler_ir_types.compiler-ir-phi-input-cons
                            (compiler_ir_types.CompilerIrValue.Var 1)
                            (compiler_ir_types.compiler-ir-label "exit")
                            (compiler_ir_types.compiler-ir-phi-input-cons
                              (compiler_ir_types.CompilerIrValue.Var 1)
                              (compiler_ir_types.compiler-ir-label "escape")
                              (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                          (compiler_ast_types.AstType.I64))
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.Var 5))))
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.I64 0))))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

(define (opt-rotate-ssa-test-second-exit-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "rotate_ssa_second_exit")
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.I64)
    6
    blocks))

(define (opt-rotate-ssa-test-second-exit-run [live-out : bool]) : compiler_ir_types.CompilerIrFunction
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rotate-ssa-test-second-exit-blocks live-out)]
    (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (opt-rotate-ssa-test-second-exit-function blocks))
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

;; A rotated loop tests its own exit condition on the back edge, so its latch
;; ends in a Branch; a top-tested one jumps back unconditionally.
(define (opt-rotate-ssa-test-ends-with-branch?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              false
              (match (compiler_ir_types.compiler-ir-instr-seq-ref
                instrs
                (- count 1))
                [(compiler_ir_types.CompilerIrInstr.Branch _ _ _) true]
                [_ false])))])]))

(define (opt-rotate-ssa-test-latches-branch?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [loops : compiler_optimize.OptNaturalLoopList]) : bool
  (match loops
    [(compiler_optimize.OptNaturalLoopList.Nil) true]
    [(compiler_optimize.OptNaturalLoopList.Cons loop rest)
      (and
        (opt-rotate-ssa-test-ends-with-branch?
          blocks
          (compiler_optimize.opt-natural-loop-latch loop))
        (opt-rotate-ssa-test-latches-branch? blocks (__tl-box-place rest)))]))

;; `it-slice-eq?` as SSA construction hands it to the loop passes: the counter
;; and the monotone flag ride the header together, the gate re-tests the flag,
;; the mismatch arm clears it, and the flag is read past the loop on BOTH exit
;; edges. That last reader is what refuses the rotation up top -- the exit phi
;; would have to reach `escape`, which the header's exit block does not
;; dominate. `flag_exit` retires exactly that reader (it folds both edges to
;; literals) and leaves the loop rotatable, but it runs six passes BELOW the
;; rotation stage and needs a pipeline iteration of its own to fire, so the
;; rotatable shape only exists after the last upstream chance to rotate it.
(define (opt-rotate-ssa-test-flag-loop-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-flag-exit-test-jump-block "entry" "header")
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            1
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "latch")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Phi
            3
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Bool true)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.compiler-ir-label "latch")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.compiler-ir-label "gate")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "gate")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.compiler-ir-label "cont")
              (compiler_ir_types.compiler-ir-label "escape"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "cont")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                6
                (compiler_ir_types.CompilerIrBinOp.Lt)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.CompilerIrValue.I64 7)
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 6)
                (compiler_ir_types.compiler-ir-label "match")
                (compiler_ir_types.compiler-ir-label "mismatch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "match" "latch")
            (compiler_ir_types.compiler-ir-block-cons
              (opt-flag-exit-test-jump-block "mismatch" "latch")
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "latch")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      4
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "mismatch")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.Var 3)
                          (compiler_ir_types.compiler-ir-label "match")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                      (compiler_ast_types.AstType.Bool))
                    (compiler_ir_types.CompilerIrInstr.BinOp
                      2
                      (compiler_ir_types.CompilerIrBinOp.Add)
                      (compiler_ir_types.CompilerIrValue.Var 1)
                      (compiler_ir_types.CompilerIrValue.I64 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "header"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (opt-flag-exit-test-jump-block "escape" "done")
                  (compiler_ir_types.compiler-ir-block-cons
                    (opt-flag-exit-test-jump-block "exit" "done")
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "done")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Phi
                            7
                            (compiler_ir_types.compiler-ir-phi-input-cons
                              (compiler_ir_types.CompilerIrValue.Var 3)
                              (compiler_ir_types.compiler-ir-label "exit")
                              (compiler_ir_types.compiler-ir-phi-input-cons
                                (compiler_ir_types.CompilerIrValue.Var 3)
                                (compiler_ir_types.compiler-ir-label "escape")
                                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                            (compiler_ast_types.AstType.Bool))
                          (compiler_ir_types.CompilerIrInstr.Return
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              (compiler_ir_types.CompilerIrValue.Var 7)))))
                      (compiler_ir_types.CompilerIrBlockList.Nil))))))))))))

(define (opt-rotate-ssa-test-flag-loop-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "rotate_ssa_flag_loop")
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.Bool)
    10
    (opt-rotate-ssa-test-flag-loop-blocks)))

;; One rotation pass over the flag loop, with nothing below it in the pipeline.
;; This has to leave the loop ALONE: the flag is flag_exit's monotone seed with
;; flag_exit's own gate (a branch on the flag itself, leaving the loop), and
;; that pass -- six slots below -- converts the shape into a direct exit and
;; deletes the second exit outright, leaving a single-exit loop the rotation
;; then takes in the ordinary way with the flag test gone from the trip.
;; Rotating first moves the flag phi out of the header, C1 stops matching, and
;; the conversion never fires again: measured at +35,506,866 Ir on
;; benchmarks/intern_table.
(define (opt-rotate-ssa-test-flag-loop-run) : compiler_ir_types.CompilerIrFunction
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rotate-ssa-test-flag-loop-blocks)]
    (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (opt-rotate-ssa-test-flag-loop-function))
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

;; End to end: whatever order the loop passes settle in, no loop of this class
;; may reach the backend jumping back unconditionally to a header that re-tests
;; its own counter. Note this fixture is clean enough that `flag_exit` converts
;; it on pipeline iteration 1, so the rotation stage ABOVE it can still win the
;; race here -- the assertion is the invariant, not the round that establishes
;; it. What forced the second round is the extra iteration a genuinely lowered
;; `while` spends before the conversion fires; `benchmarks/intern_table`'s
;; `it-slice-eq?` is the measured case and stayed top-tested without it.
(define (opt-rotate-ssa-test-pipeline-bottom-tested?) : bool
  (let
    [optimized : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-rotate-ssa-test-flag-loop-function))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks optimized)]
    [loops : compiler_optimize.OptNaturalLoopList
      (compiler_optimize.opt-cfg-natural-loops blocks)]
    (and
      (> (compiler_optimize.opt-natural-loop-list-count loops) 0)
      (opt-rotate-ssa-test-latches-branch? blocks loops))))

;; The exit phi has to carry the zero-trip value on the preheader edge and the
;; last iteration's value on the latch edge -- the whole point of minting it.
(define (opt-rotate-ssa-test-exit-phi-inputs-ok?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "exit"))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (<= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (and
                  (= (opt-rotate-ssa-test-phi-input-value inputs "entry") 0)
                  (= (opt-rotate-ssa-test-phi-input-value inputs "latch") 2))]
              [_ false]))])]))

;; The value a named block's leading phi carries on a named edge, using the
;; same encoding as `opt-rotate-ssa-test-phi-input-value`. This is what pins
;; LCSSA placement: one join phi, two edges, two different sources.
(define (opt-rotate-ssa-test-block-phi-input-value
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [edge : String]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No) (- 0 2)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (<= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            (- 0 2)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (opt-rotate-ssa-test-phi-input-value inputs edge)]
              [_ (- 0 2)]))])]))

;; 0 for the literal `0` the preheader edge carries, the var id for a Var input,
;; -1 when the edge is missing or carries anything else.
(define (opt-rotate-ssa-test-phi-input-value
  [inputs : compiler_ir_types.CompilerIrPhiInputList]
  [label : String]) : i64
  (match (compiler_ir_types.compiler-ir-phi-input-list-force-cons inputs)
    [(compiler_ir_types.CompilerIrPhiInputList.Nil) (- 0 1)]
    [(compiler_ir_types.CompilerIrPhiInputList.Array seq)
      (opt-rotate-ssa-test-phi-input-value
        (compiler_ir_types.compiler-ir-phi-input-seq-to-list seq)
        label)]
    [(compiler_ir_types.CompilerIrPhiInputList.Cons value input-label rest)
      (if (= input-label (compiler_ir_types.compiler-ir-label label))
        (match value
          [(compiler_ir_types.CompilerIrValue.Var var) var]
          [(compiler_ir_types.CompilerIrValue.I64 literal) literal]
          [_ (- 0 1)])
        (opt-rotate-ssa-test-phi-input-value (__tl-box-place rest) label))]))

;; `bce_version`'s output shape: a guard picks between two clones of one counted
;; loop and BOTH clones leave through the SAME exit block. The exit block's
;; predecessor set is then {fast header, slow header}, and the rotation refused
;; both halves -- including the fast half, the one that actually runs -- because
;; it demanded the exit block be the header's private successor. That demand
;; exists only to keep the fresh exit phis well formed; with no loop-carried
;; value read past the loop there are no exit phis, nothing is prepended to the
;; exit block, and the rotation merely swaps the header's edge into it for the
;; preheader's and the latch's. `recompute!`'s writeback loop in
;; benchmarks/liveness_scan is the measured case.
;;
;; With `merge-phi` the shared block merges both counters, which is both an
;; outside reader (exit phis are needed) and a pre-existing phi in the exit
;; block -- refused, unchanged, on either count.
(define (opt-rotate-ssa-test-shared-exit-blocks [merge-phi : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ir_types.compiler-ir-label "g1")
          (compiler_ir_types.compiler-ir-label "g2"))))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-flag-exit-test-jump-block "g1" "h1")
      (opt-rotate-ssa-test-counted-loop
        "h1"
        "g1"
        "b1"
        "l1"
        "shared"
        1
        2
        3
        (compiler_ir_types.compiler-ir-block-cons
          (opt-flag-exit-test-jump-block "g2" "h2")
          (opt-rotate-ssa-test-counted-loop
            "h2"
            "g2"
            "b2"
            "l2"
            "shared"
            4
            5
            6
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "shared")
                (if merge-phi
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      7
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Var 1)
                        (compiler_ir_types.compiler-ir-label "h1")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.Var 4)
                          (compiler_ir_types.compiler-ir-label "h2")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 7))))
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.I64 0))))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-rotate-ssa-test-shared-exit-run [merge-phi : bool]) : compiler_ir_types.CompilerIrFunction
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rotate-ssa-test-shared-exit-blocks merge-phi)]
    (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (compiler_ir_types.CompilerIrFunction.Function
        (opt-test-symbol "rotate_ssa_shared_exit")
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "n"
            (compiler_ast_types.AstType.I64)
            0)
          (compiler_ir_types.CompilerIrParamList.Nil))
        (compiler_ast_types.AstType.I64)
        11
        blocks))
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

;; Scan discipline: a REFUSED loop must not retire the rounds. The leading loop
;; here is the one shape the classified placement still refuses -- it leaves
;; the loop through a body block, and its counter is read past both exits by a
;; NON-PHI instruction at the join where the two exit paths meet. Neither the
;; exit block nor the body block dominates that join, so neither the fresh exit
;; phi nor the moved phi reaches the read, and serving it would need a phi at
;; the join whose other inputs this rewrite does not own. (A phi INPUT at the
;; same join is placeable, and that is the live-out fixture above; only a
;; non-phi read is not.) The plain counted loop that follows it in the loop
;; list is rotatable and has nothing to do with it. The refusal used to be delivered by the post-rotation
;; verify, which sat ABOVE the scan and ended the whole rounds loop, so the
;; trailing loop was never examined by that stage -- nor by the next one, which
;; re-scans the same list and stops at the same place. That is how
;; benchmarks/liveness_scan's writeback loop stayed top-tested through both
;; rotation stages.
(define (opt-rotate-ssa-test-scan-past-refusal-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-flag-exit-test-jump-block "entry" "header")
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            1
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "latch")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              4
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 7)
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.compiler-ir-label "cont")
              (compiler_ir_types.compiler-ir-label "escape"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "cont")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                2
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "latch" "header")
            (compiler_ir_types.compiler-ir-block-cons
              (opt-flag-exit-test-jump-block "escape" "done")
              (compiler_ir_types.compiler-ir-block-cons
                (opt-flag-exit-test-jump-block "exit" "done")
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "done")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.BinOp
                        5
                        (compiler_ir_types.CompilerIrBinOp.Add)
                        (compiler_ir_types.CompilerIrValue.Var 1)
                        (compiler_ir_types.CompilerIrValue.I64 0)
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "h2"))))
                  (opt-rotate-ssa-test-counted-loop
                    "h2"
                    "done"
                    "b2"
                    "l2"
                    "tail"
                    6
                    7
                    8
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "tail")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Return
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              (compiler_ir_types.CompilerIrValue.Var 5)))))
                      (compiler_ir_types.CompilerIrBlockList.Nil))))))))))))

(define (opt-rotate-ssa-test-scan-past-refusal-run) : compiler_ir_types.CompilerIrFunction
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rotate-ssa-test-scan-past-refusal-blocks)]
    (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (compiler_ir_types.CompilerIrFunction.Function
        (opt-test-symbol "rotate_ssa_scan_past_refusal")
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "n"
            (compiler_ast_types.AstType.I64)
            0)
          (compiler_ir_types.CompilerIrParamList.Nil))
        (compiler_ast_types.AstType.I64)
        9
        blocks))
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

;; Fixpoint discipline: the rotated latch ends in the cloned guard branch, not a
;; jump, so `opt-loop-rotation-edge-compatible?` refuses it and a second run
;; changes nothing.
(define (opt-rotate-ssa-test-rerun
  [once : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunction
  (match (compiler_optimize.opt-rotate-ssa-function-with-context-result
    (compiler_optimize.opt-cfg-context-build
      (compiler_optimize.opt-function-blocks once))
    false
    once)
    [(compiler_optimize.OptFunctionCtxResult.Result next _) next]))

(define (compiler-optimize-rotate-ssa-self-test) : i64
  (let
    [rotated : compiler_ir_types.CompilerIrFunction
      (opt-rotate-ssa-test-run false)]
    [rotated-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks rotated)]
    [side-exit : compiler_ir_types.CompilerIrFunction
      (opt-rotate-ssa-test-run true)]
    [side-exit-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks side-exit)]
    [second-exit-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-rotate-ssa-test-second-exit-run false))]
    [second-exit-live-out-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-rotate-ssa-test-second-exit-run true))]
    [shared-exit-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-rotate-ssa-test-shared-exit-run false))]
    [scan-past-refusal-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-rotate-ssa-test-scan-past-refusal-run))]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function rotated)))
        1]
      [(opt-block-list-has-label?
          rotated-blocks
          (compiler_ir_types.compiler-ir-label "header"))
        2]
      [(not
          (= (compiler_ir_types.compiler-ir-block-list-count rotated-blocks) 5))
        3]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            rotated-blocks
            (compiler_ir_types.compiler-ir-label "exit")))
        4]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            rotated-blocks
            (compiler_ir_types.compiler-ir-label "body")))
        5]
      [(not
          (opt-rotate-ssa-test-single-jump-to?
            rotated-blocks
            (compiler_ir_types.compiler-ir-label "header__rotate_land")
            (compiler_ir_types.compiler-ir-label "body")))
        6]
      [(not (> (compiler_optimize.opt-function-frame rotated) 4)) 7]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            side-exit-blocks
            (opt-rotate-ssa-test-blocks true)))
        8]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count side-exit-blocks)
            5))
        9]
      [(not
          (opt-block-list-has-label?
            side-exit-blocks
            (compiler_ir_types.compiler-ir-label "header")))
        10]
      ;; both sibling loops rotate inside ONE invocation
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-rotate-ssa-test-siblings-run))))
        11]
      [(not
          (opt-block-list-has-label?
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-siblings-run))
            (compiler_ir_types.compiler-ir-label "h1__rotate_land")))
        12]
      [(not
          (opt-block-list-has-label?
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-siblings-run))
            (compiler_ir_types.compiler-ir-label "h2__rotate_land")))
        13]
      [(opt-block-list-has-label?
          (compiler_optimize.opt-function-blocks
            (opt-rotate-ssa-test-siblings-run))
          (compiler_ir_types.compiler-ir-label "h1"))
        14]
      [(opt-block-list-has-label?
          (compiler_optimize.opt-function-blocks
            (opt-rotate-ssa-test-siblings-run))
          (compiler_ir_types.compiler-ir-label "h2"))
        15]
      ;; the `it-slice-eq?` class: a body that leaves the loop by its own exit
      ;; block rotates, and the rotated latch carries the test
      [(opt-block-list-has-label?
          second-exit-blocks
          (compiler_ir_types.compiler-ir-label "header"))
        16]
      [(not
          (opt-block-list-has-label?
            second-exit-blocks
            (compiler_ir_types.compiler-ir-label "header__rotate_land")))
        17]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            second-exit-blocks
            (compiler_ir_types.compiler-ir-label "body")))
        18]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            second-exit-blocks
            (compiler_ir_types.compiler-ir-label "latch")))
        19]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            second-exit-blocks
            (compiler_ir_types.compiler-ir-label "entry")))
        20]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-rotate-ssa-test-second-exit-run false))))
        21]
      ;; ... and STILL rotates once a loop-carried value is read past BOTH
      ;; exits, because the two edges are served from different definitions:
      ;; the join phi's `exit` input takes the fresh exit phi (var 8: the fixture's frame is 6 and
      ;; the two cloned guards take 6 and 7) and its `escape` input keeps the moved
      ;; phi (var 1), which the body block dominates after rotation.
      [(opt-block-list-has-label?
          second-exit-live-out-blocks
          (compiler_ir_types.compiler-ir-label "header"))
        22]
      [(not
          (opt-block-list-has-label?
            second-exit-live-out-blocks
            (compiler_ir_types.compiler-ir-label "header__rotate_land")))
        46]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-rotate-ssa-test-second-exit-run true))))
        47]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            second-exit-live-out-blocks
            (compiler_ir_types.compiler-ir-label "exit")))
        48]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            second-exit-live-out-blocks
            (compiler_ir_types.compiler-ir-label "latch")))
        49]
      [(not
          (=
            (opt-rotate-ssa-test-block-phi-input-value
              second-exit-live-out-blocks
              "done"
              "exit")
            8))
        50]
      [(not
          (=
            (opt-rotate-ssa-test-block-phi-input-value
              second-exit-live-out-blocks
              "done"
              "escape")
            1))
        51]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-second-exit-run true)))
            second-exit-live-out-blocks))
        52]
      ;; the flag class is DEFERRED to flag_exit, not rotated here
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-flag-loop-run))
            (opt-rotate-ssa-test-flag-loop-blocks)))
        53]
      ;; the exit phi merges the preheader's zero-trip value and the latch's
      [(not (opt-rotate-ssa-test-exit-phi-inputs-ok? rotated-blocks)) 23]
      ;; rotating a rotated loop is a no-op, in both fixtures
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-rerun rotated))
            rotated-blocks))
        24]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-second-exit-run false)))
            second-exit-blocks))
        25]
      ;; and the whole pipeline settles the class bottom-tested
      [(not (opt-rotate-ssa-test-pipeline-bottom-tested?)) 26]
      ;; `bce_version`'s two clones share one exit block; with nothing read past
      ;; the loop BOTH rotate
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-rotate-ssa-test-shared-exit-run false))))
        27]
      [(not
          (opt-block-list-has-label?
            shared-exit-blocks
            (compiler_ir_types.compiler-ir-label "h1__rotate_land")))
        28]
      [(not
          (opt-block-list-has-label?
            shared-exit-blocks
            (compiler_ir_types.compiler-ir-label "h2__rotate_land")))
        29]
      [(opt-block-list-has-label?
          shared-exit-blocks
          (compiler_ir_types.compiler-ir-label "h1"))
        30]
      [(opt-block-list-has-label?
          shared-exit-blocks
          (compiler_ir_types.compiler-ir-label "h2"))
        31]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            shared-exit-blocks
            (compiler_ir_types.compiler-ir-label "l1")))
        32]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            shared-exit-blocks
            (compiler_ir_types.compiler-ir-label "l2")))
        33]
      ;; ... and the shared exit block keeps its own predecessors: no phi is
      ;; prepended there, so it needs none of them
      [(opt-rotate-ssa-test-starts-with-phi?
          shared-exit-blocks
          (compiler_ir_types.compiler-ir-label "shared"))
        34]
      ;; once the shared block merges both counters it is both an outside
      ;; reader and a pre-existing exit phi: refused, unchanged
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-shared-exit-run true))
            (opt-rotate-ssa-test-shared-exit-blocks true)))
        35]
      ;; rotating the shared-exit pair twice is a no-op
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-shared-exit-run false)))
            shared-exit-blocks))
        36]
      ;; a refused loop does not retire the scan: the leading multi-exit
      ;; live-out loop stays put and the counted loop behind it still rotates
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-rotate-ssa-test-scan-past-refusal-run))))
        37]
      [(not
          (opt-block-list-has-label?
            scan-past-refusal-blocks
            (compiler_ir_types.compiler-ir-label "header")))
        38]
      [(opt-block-list-has-label?
          scan-past-refusal-blocks
          (compiler_ir_types.compiler-ir-label "header__rotate_land"))
        39]
      [(not
          (opt-rotate-ssa-test-single-jump-to?
            scan-past-refusal-blocks
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.compiler-ir-label "header")))
        40]
      [(not
          (opt-block-list-has-label?
            scan-past-refusal-blocks
            (compiler_ir_types.compiler-ir-label "h2__rotate_land")))
        41]
      [(opt-block-list-has-label?
          scan-past-refusal-blocks
          (compiler_ir_types.compiler-ir-label "h2"))
        43]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            scan-past-refusal-blocks
            (compiler_ir_types.compiler-ir-label "l2")))
        44]
      [(not
          (compiler_optimize.opt-block-list-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-scan-past-refusal-run)))
            scan-past-refusal-blocks))
        45]
      [else 42])))

(define (opt-label-set-persistent-branch-self-test) : bool
  (let
    [base-label : i64 (compiler_ir_types.compiler-ir-label "label-set-base")]
    [left-label : i64 (compiler_ir_types.compiler-ir-label "label-set-left")]
    [right-label : i64 (compiler_ir_types.compiler-ir-label "label-set-right")]
    [tail-label : i64 (compiler_ir_types.compiler-ir-label "label-set-tail")]
    [base : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-label-add
        (compiler_optimize.OptLabelSet.Nil)
        base-label)]
    [left : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-label-add base left-label)]
    [right : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-label-add base right-label)]
    [left-tail : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-label-tail left)]
    [tail-extended : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-label-add left-tail tail-label)]
    (and
      (= (compiler_optimize.opt-label-count base) 1)
      (compiler_optimize.opt-label-contains base base-label)
      (not (compiler_optimize.opt-label-contains base left-label))
      (not (compiler_optimize.opt-label-contains base right-label))
      (= (compiler_optimize.opt-label-count left) 2)
      (compiler_optimize.opt-label-contains left left-label)
      (not (compiler_optimize.opt-label-contains left right-label))
      (not (compiler_optimize.opt-label-contains left tail-label))
      (= (compiler_optimize.opt-label-count right) 2)
      (compiler_optimize.opt-label-contains right right-label)
      (not (compiler_optimize.opt-label-contains right left-label))
      (= (compiler_optimize.opt-label-count tail-extended) 2)
      (compiler_optimize.opt-label-contains tail-extended base-label)
      (compiler_optimize.opt-label-contains tail-extended tail-label)
      (not (compiler_optimize.opt-label-contains tail-extended left-label)))))

(define (compiler-optimize-ssa-self-test) : i64
  (let
    [diamond-blocks : compiler_ir_types.CompilerIrBlockList
      (opt-ssa-diamond-blocks)]
    [diamond-index : compiler_optimize.OptCfgIndex
      (compiler_optimize.opt-cfg-index-build diamond-blocks)]
    [diamond-doms : compiler_optimize.OptDomInfo
      (compiler_optimize.opt-cfg-dominators diamond-blocks)]
    [then-frontier : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-cfg-dominance-frontier
        diamond-blocks
        (compiler_ir_types.compiler-ir-label "then"))]
    [else-frontier : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-cfg-dominance-frontier
        diamond-blocks
        (compiler_ir_types.compiler-ir-label "else"))]
    [loop-blocks : compiler_ir_types.CompilerIrBlockList (opt-ssa-loop-blocks)]
    [loop-index : compiler_optimize.OptCfgIndex
      (compiler_optimize.opt-cfg-index-build loop-blocks)]
    [loop-doms : compiler_optimize.OptDomInfo
      (compiler_optimize.opt-cfg-dominators loop-blocks)]
    [loop-frontier : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-cfg-dominance-frontier
        loop-blocks
        (compiler_ir_types.compiler-ir-label "loop"))]
    [unreachable-index : compiler_optimize.OptCfgIndex
      (compiler_optimize.opt-cfg-index-build (opt-ssa-unreachable-blocks))]
    [unreachable-order : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-reachable-block-order
        (opt-ssa-unreachable-blocks))]
    [constructed-diamond : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-diamond-function))]
    [constructed-diamond-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks constructed-diamond)]
    [constructed-loop : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-loop-function))]
    [constructed-loop-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks constructed-loop)]
    [constructed-param : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-mutated-param-function))]
    [constructed-param-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks constructed-param)]
    [address-taken : compiler_ir_types.CompilerIrFunction
      (opt-ssa-construct-address-taken-function)]
    [address-taken-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        address-taken)]
    [existing-phi : compiler_ir_types.CompilerIrFunction
      (opt-cfg-test-function (opt-cfg-phi-blocks))]
    [existing-phi-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        existing-phi)]
    [pipeline-loop : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function-once
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-loop-function))]
    [pipeline-loop-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks pipeline-loop)]
    [entry-backedge : compiler_ir_types.CompilerIrFunction
      (opt-ssa-entry-backedge-function)]
    [entry-backedge-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        entry-backedge)]
    [entry-backedge-preheader-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-entry-backedge-preheader-function))]
    [constructed-nested : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-nested-loop-function))]
    [constructed-nested-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks constructed-nested)]
    [pipeline-nested : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function-once
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-nested-loop-function))]
    [pipeline-nested-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks pipeline-nested)]
    (cond
      [(not
          (=
            (compiler_optimize.opt-label-count
              (compiler_optimize.opt-cfg-predecessors
                diamond-blocks
                (compiler_ir_types.compiler-ir-label "join")))
            2))
        1]
      [(not (= (compiler_optimize.opt-cfg-index-block-count diamond-index) 4))
        2]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function (opt-ssa-diamond-function))))
        3]
      [(not
          (compiler_optimize.opt-label-set-eq?
            (compiler_optimize.opt-cfg-index-predecessors
              diamond-index
              (compiler_ir_types.compiler-ir-label "join"))
            (compiler_optimize.opt-cfg-predecessors-scan
              diamond-blocks
              (compiler_ir_types.compiler-ir-label "join"))))
        4]
      [(not
          (compiler_optimize.opt-label-set-eq?
            (compiler_optimize.opt-cfg-index-successors
              diamond-index
              (compiler_ir_types.compiler-ir-label "entry"))
            (compiler_optimize.opt-cfg-blocks-successors-scan
              diamond-blocks
              (compiler_ir_types.compiler-ir-label "entry"))))
        5]
      [(not (= unreachable-index.reach-count 1)) 6]
      [(not
          (compiler_optimize.opt-cfg-index-reachable?
            unreachable-index
            (compiler_ir_types.compiler-ir-label "entry")))
        7]
      [(compiler_optimize.opt-cfg-index-reachable?
          unreachable-index
          (compiler_ir_types.compiler-ir-label "dead"))
        8]
      [(not
          (=
            (compiler_optimize.opt-cfg-index-rpo-label unreachable-index 0)
            (compiler_ir_types.compiler-ir-label "entry")))
        9]
      [(not
          (=
            (compiler_optimize.opt-cfg-index-rpo-label loop-index 0)
            (compiler_ir_types.compiler-ir-label "entry")))
        10]
      [(not
          (compiler_optimize.opt-dom-dominates?
            diamond-doms
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-label "join")))
        11]
      [(compiler_optimize.opt-dom-dominates?
          diamond-doms
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "join"))
        12]
      [(not
          (compiler_optimize.opt-label-contains
            then-frontier
            (compiler_ir_types.compiler-ir-label "join")))
        13]
      [(not
          (compiler_optimize.opt-label-contains
            else-frontier
            (compiler_ir_types.compiler-ir-label "join")))
        14]
      [(not
          (compiler_optimize.opt-dom-dominates?
            loop-doms
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.compiler-ir-label "body")))
        15]
      [(not
          (compiler_optimize.opt-label-contains
            loop-frontier
            (compiler_ir_types.compiler-ir-label "loop")))
        16]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count unreachable-order)
            1))
        17]
      [(not
          (opt-block-list-has-label?
            unreachable-order
            (compiler_ir_types.compiler-ir-label "entry")))
        18]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function (opt-ssa-loop-function))))
        19]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-unreachable-function))))
        20]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-duplicate-label-function))
            "optimizer verify: duplicate block label"))
        21]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-unknown-successor-function))
            "optimizer verify: unknown successor label"))
        22]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function (opt-ssa-bad-phi-function))
            "optimizer verify: phi predecessor mismatch"))
        23]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-duplicate-def-function))
            "optimizer verify: duplicate var definition"))
        24]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-use-before-def-function))
            "optimizer verify: use before definition"))
        25]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-runtime-global-operand-function))
            "optimizer verify: runtime-global marker used as an instruction value"))
        63]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-dominance-fail-function))
            "optimizer verify: use is not dominated by definition"))
        26]
      [(not
          (=
            (compiler_optimize.opt-cfg-index-rpo-num
              loop-index
              (compiler_optimize.opt-cfg-index-rpo-id loop-index 0))
            0))
        27]
      [(not (opt-label-set-persistent-branch-self-test)) 60]
      [(not (compiler_optimize.opt-cfg-dominators-match-legacy? diamond-blocks))
        28]
      [(not (compiler_optimize.opt-cfg-dominators-match-legacy? loop-blocks))
        29]
      [(not
          (compiler_optimize.opt-cfg-dominators-match-legacy?
            (opt-ssa-unreachable-blocks)))
        30]
      [(not
          (compiler_optimize.opt-cfg-dominators-match-legacy?
            (opt-natural-loop-irreducible-blocks)))
        31]
      [(not (compiler_optimize.opt-cfg-dominators-match-bitset? diamond-blocks))
        32]
      [(not (compiler_optimize.opt-cfg-dominators-match-bitset? loop-blocks))
        33]
      [(not
          (compiler_optimize.opt-cfg-dominators-match-bitset?
            (opt-ssa-unreachable-blocks)))
        34]
      [(not
          (compiler_optimize.opt-cfg-dominators-match-bitset?
            (opt-natural-loop-irreducible-blocks)))
        35]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function constructed-diamond)))
        36]
      [(not (= (opt-count-phi-blocks constructed-diamond-blocks) 1)) 37]
      [(not (= (opt-count-mov-dst-blocks constructed-diamond-blocks 1) 0)) 38]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function constructed-loop)))
        39]
      [(not (= (opt-count-phi-blocks constructed-loop-blocks) 1)) 40]
      [(not (= (opt-count-mov-dst-blocks constructed-loop-blocks 1) 0)) 41]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function constructed-param)))
        46]
      [(not (= (opt-count-phi-blocks constructed-param-blocks) 1)) 47]
      [(not (= (opt-count-mov-dst-blocks constructed-param-blocks 0) 0)) 48]
      [(not
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            address-taken
            address-taken-out))
        49]
      [(not
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            existing-phi
            existing-phi-out))
        50]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function pipeline-loop)))
        51]
      [(not (= (opt-count-mov-dst-blocks pipeline-loop-blocks 1) 0)) 52]
      [(not
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            entry-backedge
            entry-backedge-out))
        53]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function entry-backedge-preheader-out)))
        61]
      [(not
          (=
            (opt-count-phi-blocks
              (compiler_optimize.opt-function-blocks
                entry-backedge-preheader-out))
            1))
        62]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function constructed-nested)))
        54]
      [(not (> (opt-count-phi-blocks constructed-nested-blocks) 0)) 55]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function pipeline-nested)))
        56]
      [(not
          (=
            (opt-count-load-label-blocks
              pipeline-nested-blocks
              (compiler_ir_types.compiler-ir-label "inner_body"))
            1))
        57]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-out-of-range-def-function -1 1))
            "optimizer verify: duplicate var definition"))
        58]
      [(not
          (compiler_optimize.opt-verify-error-ok?
            (compiler_optimize.opt-verify-function
              (opt-ssa-out-of-range-def-function 1 1))
            "optimizer verify: duplicate var definition"))
        59]
      [else 42])))

;; Returns 42 only when a phi whose surviving inputs all name one value folds to
;; a `Mov` of that value, a self-reference on the back edge does not block it,
;; disagreeing inputs keep the phi, and a chain of such phis collapses whole in
;; a single cleanup sweep and a single pipeline run.
(define (compiler-optimize-uniform-phi-self-test) : i64
  (let
    [bool-uniform : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-diamond-blocks
          (compiler_ir_types.CompilerIrValue.Bool false)
          (compiler_ir_types.CompilerIrValue.Bool false)
          (compiler_ast_types.AstType.Bool)))]
    [i64-uniform : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-diamond-blocks
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64)))]
    [i64-mixed : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-diamond-blocks
          (compiler_ir_types.CompilerIrValue.I64 10)
          (compiler_ir_types.CompilerIrValue.I64 20)
          (compiler_ast_types.AstType.I64)))]
    [bool-mixed : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-diamond-blocks
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.CompilerIrValue.Bool false)
          (compiler_ast_types.AstType.Bool)))]
    [self-uniform : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-loop-blocks (compiler_ir_types.CompilerIrValue.Var 1)))]
    [self-mixed : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-loop-blocks (compiler_ir_types.CompilerIrValue.I64 6)))]
    [chain-cleanup : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks (opt-uniform-phi-chain-blocks))]
    [mixed-join : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (opt-uniform-phi-mixed-join-blocks))]
    [mixed-join-block : compiler_ir_types.CompilerIrBlock
      (opt-uniform-phi-block-of
        mixed-join
        (compiler_ir_types.compiler-ir-label "join"))]
    [chain-pipeline : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-uniform-phi-chain-function))]
    [chain-pipeline-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks chain-pipeline)]
    [late-probe : compiler_optimize.OptLateRewriteResult
      (compiler_optimize.opt-late-uniform-phi-function-rewrite
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "uniform-phi-late")
          (opt-sccp-cond-params)
          (compiler_ast_types.AstType.Bool)
          16
          (opt-uniform-phi-diamond-blocks
            (compiler_ir_types.CompilerIrValue.Bool false)
            (compiler_ir_types.CompilerIrValue.Bool false)
            (compiler_ast_types.AstType.Bool))))]
    [flag-loop-probe : compiler_optimize.OptLateRewriteResult
      (compiler_optimize.opt-late-uniform-phi-function-rewrite
        (opt-uniform-phi-flag-loop-function))]
    [flag-loop-changed : bool
      (match flag-loop-probe
        [(compiler_optimize.OptLateRewriteResult.Result _ changed) changed])]
    [flag-loop-blocks : compiler_ir_types.CompilerIrBlockList
      (match flag-loop-probe
        [(compiler_optimize.OptLateRewriteResult.Result func _)
          (compiler_optimize.opt-function-blocks func)])]
    [late-changed : bool
      (match late-probe
        [(compiler_optimize.OptLateRewriteResult.Result _ changed) changed])]
    [late-blocks : compiler_ir_types.CompilerIrBlockList
      (match late-probe
        [(compiler_optimize.OptLateRewriteResult.Result func _)
          (compiler_optimize.opt-function-blocks func)])]
    (cond
      ;; (a) both arms the same literal, bool and i64.
      [(not (= (opt-count-phi-blocks bool-uniform) 0)) 1]
      [(not
          (opt-uniform-phi-folded?
            bool-uniform
            1
            (compiler_ir_types.CompilerIrValue.Bool false)))
        2]
      [(not (= (opt-count-phi-blocks i64-uniform) 0)) 3]
      [(not
          (opt-uniform-phi-folded?
            i64-uniform
            1
            (compiler_ir_types.CompilerIrValue.I64 7)))
        4]
      ;; (c) two different constants: the phi stays, and no `Mov` replaces it.
      [(not (= (opt-count-phi-blocks i64-mixed) 1)) 5]
      [(not (= (opt-count-mov-dst-blocks i64-mixed 1) 0)) 6]
      [(not (= (opt-count-phi-blocks bool-mixed) 1)) 7]
      [(not (= (opt-count-mov-dst-blocks bool-mixed 1) 0)) 8]
      ;; (b) a self-reference is skipped, so the entry constant carries.
      [(not (= (opt-count-phi-blocks self-uniform) 0)) 9]
      [(not
          (opt-uniform-phi-folded?
            self-uniform
            1
            (compiler_ir_types.CompilerIrValue.I64 5)))
        10]
      [(not (= (opt-count-phi-blocks self-mixed) 1)) 11]
      [(not (= (opt-count-mov-dst-blocks self-mixed 1) 0)) 12]
      ;; (d) both links of a chain go in one sweep, and the pipeline leaves the
      ;; function with no phi at all.
      [(not (= (opt-count-phi-blocks chain-cleanup) 0)) 13]
      [(not
          (opt-uniform-phi-folded?
            chain-cleanup
            2
            (compiler_ir_types.CompilerIrValue.Var 1)))
        14]
      [(not
          (opt-uniform-phi-folded?
            chain-cleanup
            3
            (compiler_ir_types.CompilerIrValue.Var 2)))
        15]
      [(not (= (opt-count-phi-blocks chain-pipeline-blocks) 0)) 16]
      ;; The settled loop shape: the pinned flag phi goes, and so does every
      ;; literal mov whose only readers are phi inputs. The one literal an
      ;; ordinary instruction also reads stays.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-uniform-phi-flag-loop-function))))
        33]
      [(not flag-loop-changed) 34]
      [(not (= (opt-count-phi-blocks flag-loop-blocks) 3)) 35]
      [(not (= (opt-count-mov-dst-blocks flag-loop-blocks 8) 0)) 36]
      [(not (= (opt-count-mov-dst-blocks flag-loop-blocks 3) 0)) 37]
      [(not (= (opt-count-mov-dst-blocks flag-loop-blocks 1) 0)) 38]
      [(not (= (opt-count-mov-dst-blocks flag-loop-blocks 4) 1)) 39]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (match flag-loop-probe
                [(compiler_optimize.OptLateRewriteResult.Result func _) func]))))
        40]
      [(not late-changed) 30]
      [(not (= (opt-count-phi-blocks late-blocks) 0)) 31]
      [(not (= (opt-count-mov-dst-blocks late-blocks 1) 0)) 32]
      ;; One phi of a block folds and the other does not: the survivor stays at
      ;; the head of the block so the backend still finds the whole phi prefix,
      ;; and the fold's `Mov` follows it.
      [(not (= (opt-block-instr-count mixed-join-block) 4)) 18]
      [(not
          (opt-uniform-phi-instr-phi-dst?
            (opt-block-instr-at mixed-join-block 0)
            2))
        19]
      [(not
          (opt-uniform-phi-instr-mov-dst?
            (opt-block-instr-at mixed-join-block 1)
            1
            (compiler_ir_types.CompilerIrValue.I64 7)))
        20]
      [(not (= (opt-count-phi-blocks mixed-join) 1)) 21]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function chain-pipeline)))
        17]
      [else 42])))

