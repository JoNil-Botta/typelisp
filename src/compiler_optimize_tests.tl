(define (opt-dead-store-run-with-array-param
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (compiler_optimize.opt-dead-store-instr-seq
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-load-header-set-from-function
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "xs"
          (compiler_ast_types.AstType.DynArray 0)
          0)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "ys"
            (compiler_ast_types.AstType.DynArray 0)
            1)
          (compiler_ir_types.CompilerIrParamList.Nil)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        (compiler_ir_types.CompilerIrBlockList.Nil)))
    instrs))

(define (opt-count-mov-dst-i64-src-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [src : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Mov mov-dst mov-src _)
          (if (= mov-dst dst)
            (match mov-src
              [(compiler_ir_types.CompilerIrValue.I64 value)
                (if (= value src)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-mov-dst-i64-src-from instrs (+ index 1) dst src))))

(define (opt-count-mov-dst-i64-src
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [src : i64]) : i64
  (opt-count-mov-dst-i64-src-from instrs 0 dst src))

(define (opt-count-mov-dst-var-src-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [src : i64]
  [ty : compiler_ast_types.AstType]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Mov mov-dst mov-src mov-ty)
          (if (and
            (= mov-dst dst)
            (compiler_optimize.opt-type-eq
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              mov-ty
              ty))
            (match mov-src
              [(compiler_ir_types.CompilerIrValue.Var value)
                (if (= value src)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-mov-dst-var-src-from instrs (+ index 1) dst src ty))))

(define (opt-count-mov-dst-var-src
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [src : i64]
  [ty : compiler_ast_types.AstType]) : i64
  (opt-count-mov-dst-var-src-from instrs 0 dst src ty))

(define (opt-count-mov-dst-bool-src-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [src : bool]) : i64
