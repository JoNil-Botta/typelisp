          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 7)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

;; Full-pipeline integration fixture: `while (i < n) { acc = acc*5 + 3; i++ }`
;; in SSA form. After optimize-function the x16 unroller versions the loop and
;; the affine pass must collapse the sixteen chained pairs so the unrolled body
;; multiplies by 5^16 = 152587890625 exactly once.
(define (opt-affine-lcg-loop-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "body"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "body")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            2
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Phi
            3
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 7)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            6
            (compiler_ir_types.CompilerIrBinOp.Mul)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            7
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.CompilerIrValue.I64 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            8
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 8)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 7)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-affine-test-seq-count-mul
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (opt-affine-test-seq-count-mul
      instrs
      (+ index 1)
      (+
        acc
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          [(compiler_ir_types.CompilerIrInstr.BinOp _ op _ _ _)
            (match op
              [(compiler_ir_types.CompilerIrBinOp.Mul) 1]
              [_ 0])]
          [_ 0])))))

(define (opt-affine-test-seq-has-mul-by?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [want : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp _ op _ rhs _)
        (match op
          [(compiler_ir_types.CompilerIrBinOp.Mul)
            (match rhs
              [(compiler_ir_types.CompilerIrValue.I64 k)
                (if (= k want)
                  true
                  (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want))]
              [_ (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want)])]
          [_ (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want)])]
      [_ (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want)])))

;; The same recurrence as lowering emits it: a top-tested pre-SSA while loop
;; with Mov writebacks, entering the pipeline before SSA/rotation/unroll.
(define (opt-affine-lcg-while-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              4
              (compiler_ir_types.CompilerIrBinOp.Mul)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 5)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.I64 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Mov
              1
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BinOp
              6
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Mov
              2
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "header"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                7
                (compiler_ir_types.CompilerIrBinOp.BitAnd)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.CompilerIrValue.I64 255)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 7)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-affine-pipeline-check
  [optimized : compiler_ir_types.CompilerIrFunction]
  [fail-missing : i64]
  [fail-mul : i64]
  [fail-count : i64]) : i64
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks optimized)]
    (match (compiler_optimize.opt-cfg-find-block
      blocks
      (compiler_ir_types.compiler-ir-label "body__unroll_body"))
      [(compiler_optimize.OptMaybeBlock.No) fail-missing]
      [(compiler_optimize.OptMaybeBlock.Some block)
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
            (cond
              ;; the sixteen chained *5 collapse into one *152587890625 ...
              [(not (opt-affine-test-seq-has-mul-by? instrs 0 152587890625))
                fail-mul]
              ;; ... and DCE drops the orphaned intermediate pairs.
              [(> (opt-affine-test-seq-count-mul instrs 0 0) 1) fail-count]
              [else 42])])])))

(define (compiler-optimize-affine-pipeline-self-test) : i64
  (let
    [ssa-result : i64
      (opt-affine-pipeline-check
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_ir_types.CompilerIrFunction.Function
            (opt-test-symbol "affine_loop_fixture")
            (opt-unroll-test-params)
            (compiler_ast_types.AstType.I64)
            9
            (opt-affine-lcg-loop-blocks)))
        1
        2
        3)]
    [while-result : i64
      (opt-affine-pipeline-check
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_ir_types.CompilerIrFunction.Function
            (opt-test-symbol "affine_while_fixture")
            (opt-unroll-test-params)
            (compiler_ast_types.AstType.I64)
            8
            (opt-affine-lcg-while-blocks)))
        4
        5
        6)]
    (if (= ssa-result 42)
      while-result
      ssa-result)))

(define (compiler-optimize-affine-self-test) : i64
  (let
    [lcg : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-affine-fold-blocks 16 (opt-affine-lcg-test-blocks))]
    [lcg-block : compiler_ir_types.CompilerIrBlock
      (opt-affine-test-first-block lcg)]
    [counter : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-affine-fold-blocks
        16
        (opt-affine-counter-test-blocks))]
    [counter-block : compiler_ir_types.CompilerIrBlock
      (opt-affine-test-first-block counter)]
    [two-use : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-affine-fold-blocks
        16
        (opt-affine-two-use-test-blocks))]
    [two-use-block : compiler_ir_types.CompilerIrBlock
      (opt-affine-test-first-block two-use)]
    (cond
      ;; ((x*5+3)*5+3)*5+3 == x*125 + 93: the second pair reads x*25 + 18 ...
      [(not (opt-affine-test-binop-shape? lcg-block 2 4 true 0 25)) 1]
      [(not (opt-affine-test-binop-shape? lcg-block 3 5 false 4 18)) 2]
      ;; ... and the last pair reads x*125 + 93.
      [(not (opt-affine-test-binop-shape? lcg-block 4 6 true 0 125)) 3]
      [(not (opt-affine-test-binop-shape? lcg-block 5 7 false 6 93)) 4]
      ;; (x+1)+1 rebases to x+2; the Sub then folds to x-3 (emitted as Add).
      [(not (opt-affine-test-binop-shape? counter-block 1 2 false 0 2)) 5]
      [(not (opt-affine-test-binop-shape? counter-block 2 3 false 0 (- 0 3))) 6]
      ;; two-use mul: v4 = (x+3)*5 must stay untouched ...
      [(not (opt-affine-test-binop-shape? two-use-block 1 4 true 2 5)) 7]
      ;; ... and both adds keep reading it.
      [(not (opt-affine-test-binop-shape? two-use-block 2 5 false 4 7)) 8]
      [(not (opt-affine-test-binop-shape? two-use-block 3 6 false 4 9)) 9]
      [else 42])))

