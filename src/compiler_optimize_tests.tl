(cfg
  test
  (define (opt-licm-checked-root-barrier [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
    (cond
      [(= mode 1)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CopyBytes
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 3)
            8))]
      [(= mode 2)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            11
            (opt-test-symbol "touch")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.I64)))]
      ;; An indirect call through the raw parameter. There is no callee name to
      ;; resolve, so no clean map can describe it: the LICM store summaries take
      ;; `call-or-unknown?` unconditionally here.
      [(= mode 3)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CallIndirect
            11
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.I64)))]
      [else (compiler_ir_types.compiler-ir-instr-seq-empty)])))

