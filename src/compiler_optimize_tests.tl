        20]
      [(not (opt-natural-loop-maybe-no-preheader? no-preheader)) 21]
      [(not (= (opt.opt-natural-loop-list-count multi-loops) 2)) 22]
      [(not
          (=
            (opt-natural-loop-maybe-body-count
              (opt.compiler-opt-global-shared-view multi-left))
