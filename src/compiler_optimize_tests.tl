              (compiler_ir_types.CompilerIrInstr.Phi
                3
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.I64 11)
                  (compiler_ir_types.compiler-ir-label "left")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.I64 22)
                    (compiler_ir_types.compiler-ir-label "right")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Bool true)
                  (compiler_ir_types.compiler-ir-label "left")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Bool false)
                    (compiler_ir_types.compiler-ir-label "right")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.compiler-ir-label "yes")
                (compiler_ir_types.compiler-ir-label "no"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "yes")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 3)))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "no")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 3)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

;; A bool merge whose consuming branch sits past the merge block: `merge` holds
;; the phi and falls through to `gap`, `gap` falls through to `branch-site`, and
;; only `branch-site` tests the phi. That is what the front end emits whenever a
;; boolean merge and the `if` reading it land on separate joins, and the fuser
;; has to look through the run to see the same rewrite. Modes:
;;   0 -- `gap` is a pure fallthrough owned by the merge: fusible.
;;   1 -- `gap` carries a real instruction, so the run cannot simply die.
;;   2 -- `side` also reaches `gap`, so the run is not the merge's to retarget.
(define (opt-bool-branch-merge-chain-gap-instrs [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [tail : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "branch-site")))]
    (if (= mode 1)
      (opt-test-instrs-with-tail
        tail
        (compiler_ir_types.CompilerIrInstr.Mov
          7
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64)))
      tail)))

(define (opt-bool-branch-merge-chain-tail [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "true-left")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "merge"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "false-middle")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "true-right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "merge"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "merge")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Bool true)
                  (compiler_ir_types.compiler-ir-label "true-left")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Bool false)
                    (compiler_ir_types.compiler-ir-label "false-middle")
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "true-right")
                      (compiler_ir_types.CompilerIrPhiInputList.Nil))))
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "gap"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "gap")
              (opt-bool-branch-merge-chain-gap-instrs mode))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "branch-site")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "yes")
                    (compiler_ir_types.compiler-ir-label "no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      5
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 11)
                        (compiler_ir_types.compiler-ir-label "branch-site")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 5)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        6
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.I64 22)
                          (compiler_ir_types.compiler-ir-label "branch-site")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 6)))))
                  (if (= mode 2)
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "side")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Jump
                            (compiler_ir_types.compiler-ir-label "gap"))))
                      (compiler_ir_types.CompilerIrBlockList.Nil))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

(define (opt-bool-branch-merge-chain-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (if (= mode 2)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "spread")
            (compiler_ir_types.compiler-ir-label "choose"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "spread")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "true-left")
              (compiler_ir_types.compiler-ir-label "side"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "choose")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.compiler-ir-label "false-middle")
                (compiler_ir_types.compiler-ir-label "true-right"))))
          (opt-bool-branch-merge-chain-tail mode))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "true-left")
            (compiler_ir_types.compiler-ir-label "choose"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "choose")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "false-middle")
              (compiler_ir_types.compiler-ir-label "true-right"))))
        (opt-bool-branch-merge-chain-tail mode)))))

(define (opt-bool-branch-constant-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bool-branch-constant")
    (opt-bool-branch-two-cond-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

;; The chain shape of `opt-bool-branch-merge-chain-blocks 0` reached through a
;; block whose branch sccp folds. `entry` tests a var sccp proves `true`, so the
;; edge `entry -> join` dies and `join`'s phi keeps an input for a label that is
;; no longer one of its predecessors. Every pass that verify-gates its input --
;; the bool-branch fuser included -- then declines the WHOLE function, and the
;; fusible chain further down survives untouched. The pipeline's sccp entry
;; point has to hand on blocks that verify for this fixture to fuse.
(define (opt-sccp-folded-edge-chain-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          10
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ir_types.compiler-ir-label "pick")
          (compiler_ir_types.compiler-ir-label "join"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "pick")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "true-left")
            (compiler_ir_types.compiler-ir-label "choose"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "choose")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "false-middle")
              (compiler_ir_types.compiler-ir-label "true-right"))))
        (opt-sccp-folded-edge-chain-tail)))))

(define (opt-sccp-folded-edge-chain-tail) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "true-left")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "merge"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "false-middle")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "true-right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "merge"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "merge")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Bool true)
                  (compiler_ir_types.compiler-ir-label "true-left")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Bool false)
                    (compiler_ir_types.compiler-ir-label "false-middle")
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "true-right")
                      (compiler_ir_types.CompilerIrPhiInputList.Nil))))
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "gap"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "gap")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "branch-site"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "branch-site")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "yes")
                    (compiler_ir_types.compiler-ir-label "no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      5
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 11)
                        (compiler_ir_types.compiler-ir-label "branch-site")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "join"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        6
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.I64 22)
                          (compiler_ir_types.compiler-ir-label "branch-site")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "join"))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "join")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Phi
                          7
                          (compiler_ir_types.compiler-ir-phi-input-cons
                            (compiler_ir_types.CompilerIrValue.I64 0)
                            (compiler_ir_types.compiler-ir-label "entry")
                            (compiler_ir_types.compiler-ir-phi-input-cons
                              (compiler_ir_types.CompilerIrValue.Var 5)
                              (compiler_ir_types.compiler-ir-label "yes")
                              (compiler_ir_types.compiler-ir-phi-input-cons
                                (compiler_ir_types.CompilerIrValue.Var 6)
                                (compiler_ir_types.compiler-ir-label "no")
                                (compiler_ir_types.CompilerIrPhiInputList.Nil))))
                          (compiler_ast_types.AstType.I64))
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.Var 7)))))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

(define (opt-bool-branch-first-phi-has-label?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks block-label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (and
            (> (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (compiler_optimize.opt-bool-branch-phi-input-has-label?
                  inputs
                  pred-label)]
              [_ false]))])]))

(define (opt-bool-branch-chain-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "a"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "b"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "c"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

;; mode 0: a three-comparison And tree; mode 1: its first And result also
;; escapes to a Mov and must block the rewrite; mode 2: an Or-mixed tree, which
;; is outside the first-cut transform.
(define (opt-bool-branch-chain-test-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [first-op : compiler_ir_types.CompilerIrBinOp
      (if (= mode 2)
        (compiler_ir_types.CompilerIrBinOp.Or)
        (compiler_ir_types.CompilerIrBinOp.And))]
    [after-first : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (if (= mode 1)
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              8
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.Bool)))
          (compiler_ir_types.compiler-ir-instr-seq-empty))
        (compiler_ir_types.CompilerIrInstr.BinOp
          6
          first-op
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ast_types.AstType.Bool)))]
    [entry-tail : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-licm-unswitch-instrs-onto
        after-first
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            7
            (compiler_ir_types.CompilerIrBinOp.And)
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no"))))]
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs-with-tail
          entry-tail
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Ge)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Le)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "yes")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              9
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.I64 11)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.CompilerIrPhiInputList.Nil))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 9)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "no")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                10
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.I64 22)
                  (compiler_ir_types.compiler-ir-label "entry")
                  (compiler_ir_types.CompilerIrPhiInputList.Nil))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 10)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-bool-branch-chain-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bool-branch-chain")
    (opt-bool-branch-chain-test-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-bool-branch-chain-test-run [mode : i64]) : compiler_optimize.OptFunctionPassResult
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-bool-branch-chain-test-blocks mode)]
    [func : compiler_ir_types.CompilerIrFunction
      (opt-bool-branch-chain-test-function blocks)]
    (compiler_optimize.opt-bool-branch-chain-function-with-context-result
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      func)))

(define (opt-bool-branch-chain-compare-branch-block?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (and
            (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.BinOp dst op _ _ _)
                (and
                  (compiler_optimize.opt-bool-branch-compare-op? op)
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 1)
                    [(compiler_ir_types.CompilerIrInstr.Branch
                        (compiler_ir_types.CompilerIrValue.Var cond)
                        _
                        _)
                      (= dst cond)]
                    [_ false]))]
              [_ false]))])]))

;; --- constant-branch jump threading fixtures --------------------------------
;;
;; The shape below is the lowered `(or c1 c2)` loop guard, copied from the opt2
;; IR dump of route_http's byte-scan loop: an inner diamond materializes a
;; boolean into a phi, a forwarding block carries it to the outer merge, and the
;; outer merge retests it. Both merge phis are pure control flow, so every
;; incoming edge already decides the branch.
;;
;; The fixtures drive the whole opt2 function pipeline (`optimize-function`)
;; rather than the pass entry point, so a tree carrying only these tests still
;; compiles and reports the new codes.
(define (opt-thread-three-cond-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "outer"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "left"
        (compiler_ast_types.AstType.Bool)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "right"
          (compiler_ast_types.AstType.Bool)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

;; `blocked` inserts an effectful call between the merge phi and its branch, so
;; the merge no longer consists of phis and the branch alone.
(define (opt-thread-chain-blocks [blocked : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tc-then")
          (compiler_ir_types.compiler-ir-label "tc-else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tc-then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "tc-merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tc-else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tc-inner-then")
              (compiler_ir_types.compiler-ir-label "tc-inner-else"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tc-inner-then")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tc-inner-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tc-inner-else")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tc-inner-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tc-inner-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    3
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tc-inner-then")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "tc-inner-else")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "tc-merge"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tc-merge")
                  (opt-test-instrs-with-tail
                    (if blocked
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Call
                          5
                          (opt-test-symbol "thread-probe")
                          (compiler_ir_types.CompilerIrCallArgs.Nil)
                          (compiler_ast_types.AstType.I64))
                        (compiler_ir_types.CompilerIrInstr.Branch
                          (compiler_ir_types.CompilerIrValue.Var 4)
                          (compiler_ir_types.compiler-ir-label "tc-yes")
                          (compiler_ir_types.compiler-ir-label "tc-no")))
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Branch
                          (compiler_ir_types.CompilerIrValue.Var 4)
                          (compiler_ir_types.compiler-ir-label "tc-yes")
                          (compiler_ir_types.compiler-ir-label "tc-no"))))
                    (compiler_ir_types.CompilerIrInstr.Phi
                      4
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Bool true)
                        (compiler_ir_types.compiler-ir-label "tc-then")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.Var 3)
                          (compiler_ir_types.compiler-ir-label "tc-inner-merge")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                      (compiler_ast_types.AstType.Bool))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tc-yes")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.I64 1)))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "tc-no")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.I64 0)))))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

;; Same chain, but both decided targets are reached from a second path as well,
;; so `ts-yes` carries a real multi-input phi over the threaded merge edge.
(define (opt-thread-successor-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "ts-alt")
          (compiler_ir_types.compiler-ir-label "ts-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "ts-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "ts-yes"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "ts-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "ts-then")
              (compiler_ir_types.compiler-ir-label "ts-else"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "ts-then")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "ts-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "ts-else")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.compiler-ir-label "ts-inner-then")
                  (compiler_ir_types.compiler-ir-label "ts-inner-else"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "ts-inner-then")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "ts-inner-merge"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "ts-inner-else")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "ts-inner-merge"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "ts-inner-merge")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        4
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.Bool true)
                          (compiler_ir_types.compiler-ir-label "ts-inner-then")
                          (compiler_ir_types.compiler-ir-phi-input-cons
                            (compiler_ir_types.CompilerIrValue.Bool false)
                            (compiler_ir_types.compiler-ir-label
                              "ts-inner-else")
                            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                        (compiler_ast_types.AstType.Bool))
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "ts-merge"))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "ts-merge")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Phi
                          5
                          (compiler_ir_types.compiler-ir-phi-input-cons
                            (compiler_ir_types.CompilerIrValue.Bool true)
                            (compiler_ir_types.compiler-ir-label "ts-then")
                            (compiler_ir_types.compiler-ir-phi-input-cons
                              (compiler_ir_types.CompilerIrValue.Var 4)
                              (compiler_ir_types.compiler-ir-label
                                "ts-inner-merge")
                              (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                          (compiler_ast_types.AstType.Bool))
                        (compiler_ir_types.CompilerIrInstr.Branch
                          (compiler_ir_types.CompilerIrValue.Var 5)
                          (compiler_ir_types.compiler-ir-label "ts-yes")
                          (compiler_ir_types.compiler-ir-label "ts-no"))))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "ts-yes")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Phi
                            6
                            (compiler_ir_types.compiler-ir-phi-input-cons
                              (compiler_ir_types.CompilerIrValue.I64 10)
                              (compiler_ir_types.compiler-ir-label "ts-merge")
                              (compiler_ir_types.compiler-ir-phi-input-cons
                                (compiler_ir_types.CompilerIrValue.I64 20)
                                (compiler_ir_types.compiler-ir-label "ts-alt")
                                (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                            (compiler_ast_types.AstType.I64))
                          (compiler_ir_types.CompilerIrInstr.Return
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              (compiler_ir_types.CompilerIrValue.Var 6)))))
                      (compiler_ir_types.compiler-ir-block-cons
                        (compiler_ir_types.CompilerIrBlock.Block
                          (compiler_ir_types.compiler-ir-label "ts-no")
                          (opt-test-instrs
                            (compiler_ir_types.CompilerIrInstr.Return
                              (compiler_ir_types.CompilerIrMaybeValue.Some
                                (compiler_ir_types.CompilerIrValue.I64 30)))))
                        (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))))

(define (opt-thread-test-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol name)
    (opt-thread-three-cond-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-thread-optimized
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.optimize-function
    (compiler_ast_types.ast-node-pool-reader-context-current)
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-thread-test-function name blocks)))

;; --- widened jump-threading fixtures ----------------------------------------
;;
;; These drive `opt-thread-const-branch-blocks` directly rather than the whole
;; opt2 pipeline, so what they assert is the pass's own rewrite: which edges it
;; redirects, which value each redirected predecessor takes over, and which
;; shapes it still refuses.
(define (opt-thread-pass-result
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fuel : i64]) : compiler_optimize.OptBlockListPassResult
  (compiler_optimize.opt-thread-const-branch-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    blocks
    16
    fuel))

(define (opt-thread-pass-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fuel : i64]) : compiler_ir_types.CompilerIrBlockList
  (match (opt-thread-pass-result blocks fuel)
    [(compiler_optimize.OptBlockListPassResult.Result next _) next]))

(define (opt-thread-pass-changed?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fuel : i64]) : bool
  (match (opt-thread-pass-result blocks fuel)
    [(compiler_optimize.OptBlockListPassResult.Result _ changed) changed]))

(define (opt-thread-pass-verified?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (compiler_optimize.opt-verify-ok?
    (compiler_optimize.opt-verify-function
      (opt-thread-test-function "thread-pass" blocks))))

(define (opt-thread-first-phi-input
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]) : compiler_ir_types.CompilerIrMaybeValue
  (match (compiler_optimize.opt-cfg-find-block blocks block-label)
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.CompilerIrMaybeValue.No)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            (compiler_ir_types.CompilerIrMaybeValue.No)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (compiler_optimize.opt-thread-phi-input-value inputs pred-label)]
              [_ (compiler_ir_types.CompilerIrMaybeValue.No)]))])]))

(define (opt-thread-first-phi-input-i64?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]
  [want : i64]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(compiler_ir_types.CompilerIrMaybeValue.No) false]
    [(compiler_ir_types.CompilerIrMaybeValue.Some value)
      (match value
        [(compiler_ir_types.CompilerIrValue.I64 got) (= got want)]
        [_ false])]))

(define (opt-thread-first-phi-input-bool?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]
  [want : bool]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(compiler_ir_types.CompilerIrMaybeValue.No) false]
    [(compiler_ir_types.CompilerIrMaybeValue.Some value)
      (match value
        [(compiler_ir_types.CompilerIrValue.Bool got)
          (if want
            got
            (not got))]
        [_ false])]))

(define (opt-thread-first-phi-has-input?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(compiler_ir_types.CompilerIrMaybeValue.No) false]
    [(compiler_ir_types.CompilerIrMaybeValue.Some _) true]))

;; D1 -- three phis ahead of the branch. Only `%6` decides it; `%4` and `%5`
;; are read solely across the merge's own out-edges, so each redirected
;; predecessor takes over the value its own input carried and the merge's phis
;; lose that input. `tp-alt` keeps both destinations multi-entry so the repaired
;; phis survive the round's cleanup.
(define (opt-thread-multi-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tp-alt")
          (compiler_ir_types.compiler-ir-label "tp-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tp-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "tp-yes")
            (compiler_ir_types.compiler-ir-label "tp-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tp-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tp-a")
              (compiler_ir_types.compiler-ir-label "tp-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tp-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tp-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tp-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tp-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tp-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "tp-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "tp-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.I64 11)
                      (compiler_ir_types.compiler-ir-label "tp-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 21)
                        (compiler_ir_types.compiler-ir-label "tp-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    6
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tp-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "tp-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 6)
                    (compiler_ir_types.compiler-ir-label "tp-yes")
                    (compiler_ir_types.compiler-ir-label "tp-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tp-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      7
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Var 4)
                        (compiler_ir_types.compiler-ir-label "tp-merge")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "tp-alt")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 7)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tp-no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        8
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.Var 5)
                          (compiler_ir_types.compiler-ir-label "tp-merge")
                          (compiler_ir_types.compiler-ir-phi-input-cons
                            (compiler_ir_types.CompilerIrValue.I64 31)
                            (compiler_ir_types.compiler-ir-label "tp-alt")
                            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 8)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; D1 rail -- `%4` is read by an ordinary instruction in a successor, not by a
;; phi on the merge edge. Threading a predecessor past the merge would reach
;; that read without passing the definition, so the whole block is refused.
(define (opt-thread-live-out-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tv-alt")
          (compiler_ir_types.compiler-ir-label "tv-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tv-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "tv-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tv-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tv-a")
              (compiler_ir_types.compiler-ir-label "tv-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tv-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tv-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tv-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tv-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tv-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "tv-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "tv-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tv-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "tv-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.compiler-ir-label "tv-yes")
                    (compiler_ir_types.compiler-ir-label "tv-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tv-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.BinOp
                      6
                      (compiler_ir_types.CompilerIrBinOp.Add)
                      (compiler_ir_types.CompilerIrValue.Var 4)
                      (compiler_ir_types.CompilerIrValue.I64 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 6)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tv-no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.I64 40)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; D1 -- only `tx-a` decides the branch. `tx-b` carries a parameter, so its
;; edge stays exactly where it is and the merge survives holding it.
(define (opt-thread-mixed-edge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tx-alt")
          (compiler_ir_types.compiler-ir-label "tx-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tx-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "tx-yes")
            (compiler_ir_types.compiler-ir-label "tx-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tx-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tx-a")
              (compiler_ir_types.compiler-ir-label "tx-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tx-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tx-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tx-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tx-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tx-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "tx-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "tx-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tx-a")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Var 2)
                        (compiler_ir_types.compiler-ir-label "tx-b")
                        (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.compiler-ir-label "tx-yes")
                    (compiler_ir_types.compiler-ir-label "tx-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tx-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      6
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Var 4)
                        (compiler_ir_types.compiler-ir-label "tx-merge")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "tx-alt")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
