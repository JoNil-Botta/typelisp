(define (opt-block-list-has-label?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label _)
          (if (= block-label label)
            true
            (opt-block-list-has-label?
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              label))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-block-list-has-label?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-block-list-label-at?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [index : i64]
  [label : i64]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (if (= index 0)
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block block-label _)
            (= block-label label)])
        (opt-block-list-label-at?
          (compiler_ir_types.compiler-ir-box-shared-view rest)
          (- index 1)
          label))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-block-list-label-at?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        index
        label)]))

(define (opt-count-branches-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-branches-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Branch _ _ _) 1]
          [_ 0])))))

(define (opt-count-branches-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-branches-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-branches-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-branches-instr-seq instrs)
            (opt-count-branches-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-branches-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-jump-to-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [target : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-jump-to-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      target
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Jump label)
            (if (= label target)
              1
              0)]
          [_ 0])))))

(define (opt-count-jump-to-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [target : i64]) : i64
  (opt-count-jump-to-instr-seq-from instrs.slots 0 instrs.len target 0))

(define (opt-count-jump-to-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [target : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-jump-to-instr-seq instrs target)
            (opt-count-jump-to-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              target))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-jump-to-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        target)]))

(define (opt-count-tail-call-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-tail-call-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.TailCall _ _ _) 1]
          [_ 0])))))

(define (opt-count-tail-call-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-tail-call-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-tail-call-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-tail-call-instr-seq instrs)
            (opt-count-tail-call-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-tail-call-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-tail-call-name-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [name : String]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-tail-call-name-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (compiler_ir_types.compiler-ir-global-shared-view name)
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.TailCall target _ _)
            (if (string.eq
              (compiler_ir_types.compiler-ir-symbol-text target)
              name)
              1
              0)]
          [_ 0])))))

(define (opt-count-tail-call-name-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [name : String]) : i64
  (opt-count-tail-call-name-instr-seq-from instrs.slots 0 instrs.len name 0))

(define (opt-count-tail-call-name-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : String]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-tail-call-name-instr-seq
              instrs
              (compiler_ir_types.compiler-ir-global-shared-view name))
            (opt-count-tail-call-name-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              name))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-tail-call-name-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        name)]))

(define (opt-count-tail-call-indirect-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-tail-call-indirect-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.TailCallIndirect _ _ _) 1]
          [_ 0])))))

(define (opt-count-tail-call-indirect-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-tail-call-indirect-instr-seq-from
              instrs.slots
              0
              instrs.len
              0)
            (opt-count-tail-call-indirect-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-tail-call-indirect-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-return-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-return-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Return _) 1]
          [_ 0])))))

(define (opt-count-return-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-return-instr-seq-from instrs.slots 0 instrs.len 0)
            (opt-count-return-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-return-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

;; Total instructions across a function's blocks. A refusal test that only
;; counts terminators cannot tell "left alone" from "expanded into a copy of
;; itself", which is precisely the failure a self-recursive tail site would
;; produce, so the refusal tests count the body too.
(define (opt-count-instrs-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (compiler_ir_types.compiler-ir-instr-seq-count instrs)
            (opt-count-instrs-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-instrs-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-tailrec-test-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "a"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "b"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-tailrec-test-function) : compiler_ir_types.CompilerIrFunction
  (let
    [name : i64 (opt-test-symbol "tail_swap")]
    [builder : compiler_ir_types.CompilerIrInstrBuilder
      (compiler_ir_types.compiler-ir-instr-builder-with-capacity 2)]
    (begin
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.TailCall
          name
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0))
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 0))))
      (compiler_ir_types.CompilerIrFunction.Function
        name
        (opt-tailrec-test-params)
        (compiler_ast_types.AstType.I64)
        2
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-builder-to-seq builder))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-tailrec-expected-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [builder : compiler_ir_types.CompilerIrInstrBuilder
      (compiler_ir_types.compiler-ir-instr-builder-with-capacity 5)]
    (begin
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.compiler-ir-instr-builder-push!
        (&mut builder)
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "entry")))
      (compiler_ir_types.compiler-ir-instr-builder-to-seq builder))))

(define (opt-tailrec-entry-instrs
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrInstrSeq
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "entry"))
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.compiler-ir-instr-seq-empty)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs) instrs])]))

(define (opt-tailrec-entry-collision-function) : compiler_ir_types.CompilerIrFunction
  (match (opt-tailrec-test-function)
    [(compiler_ir_types.CompilerIrFunction.Function
        name
        params
        ret
        frame
        blocks)
      (compiler_ir_types.CompilerIrFunction.Function
        name
        params
        ret
        frame
        (compiler_optimize.opt-inline-block-append
          blocks
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "entry__ssa_entry")
              (compiler_ir_types.compiler-ir-instr-seq1
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 0)))))
            (compiler_ir_types.CompilerIrBlockList.Nil))))]))

(define (compiler-optimize-tailrec-self-test) : i64
  (let
    [rewritten : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-tailrec-function (opt-tailrec-test-function))]
    [once : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function-once
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-tailrec-test-function))]
    [rewritten-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view rewritten))]
    [once-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view once))]
    [rewritten-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-tailrec-entry-instrs
        (compiler_optimize.compiler-opt-global-shared-view rewritten-blocks))]
    [collision : compiler_ir_types.CompilerIrFunction
      (opt-tailrec-entry-collision-function)]
    [collision-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-tailrec-function
        (compiler_optimize.compiler-opt-global-shared-view collision))]
    (cond
      [(not
          (=
            (compiler_optimize.opt-function-frame
              (compiler_optimize.compiler-opt-global-shared-view rewritten))
            4))
        1]
      [(not
          (compiler_optimize.opt-instr-seq-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            rewritten-instrs
            (opt-tailrec-expected-instrs)))
        2]
      [(not
          (=
            (opt-count-tail-call-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                rewritten-blocks))
            0))
        3]
      [(not
          (opt-rotate-ssa-test-single-jump-to?
            (compiler_optimize.compiler-opt-global-shared-view rewritten-blocks)
            (compiler_ir_types.compiler-ir-label "entry__ssa_entry")
            (compiler_ir_types.compiler-ir-label "entry")))
        7]
      [(not
          (=
            (opt-count-jump-to-blocks
              rewritten-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        4]
      [(not
          (=
            (opt-count-tail-call-blocks
              (compiler_optimize.compiler-opt-global-shared-view once-blocks))
            0))
        5]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view once))))
        8]
      [(not
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view once-blocks)
            (compiler_ir_types.compiler-ir-label "entry__ssa_entry")))
        9]
      [(not
          (=
            (opt-count-jump-to-blocks
              once-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        6]
      [(not
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            collision
            collision-out))
        10]
      [else 42])))

(define (opt-count-phi-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-phi-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Phi _ _ _) 1]
          [_ 0])))))

(define (opt-count-phi-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-phi-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-phi-blocks [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-phi-instr-seq instrs)
            (opt-count-phi-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-phi-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-phi-types-match-instr-seq-from?
  [type-segment-bases : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [ty : compiler_ast_types.AstType]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    true
    (and
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Phi _ _ phi-ty)
          (compiler_optimize.opt-type-eq
            type-segment-bases
            phi-ty
            (compiler_ast_types.ast-global-shared-view ty))]
        [_ true])
      (opt-phi-types-match-instr-seq-from?
        type-segment-bases
        instrs
        (+ index 1)
        (compiler_ast_types.ast-global-shared-view ty)))))

(define (opt-phi-types-match-blocks?
  [type-segment-bases : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [ty : compiler_ast_types.AstType]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) true]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (and
            (opt-phi-types-match-instr-seq-from?
              type-segment-bases
              instrs
              0
              (compiler_ast_types.ast-global-shared-view ty))
            (opt-phi-types-match-blocks?
              type-segment-bases
              (compiler_ir_types.compiler-ir-block-list-box-shared-view rest)
              (compiler_ast_types.ast-global-shared-view ty)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-phi-types-match-blocks?
        type-segment-bases
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        (compiler_ast_types.ast-global-shared-view ty))]))

(define (opt-count-mov-dst-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mov-dst-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      dst
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Mov mov-dst _ _)
            (if (= mov-dst dst)
              1
              0)]
          [_ 0])))))

(define (opt-count-mov-dst-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-count-mov-dst-instr-seq-from instrs.slots 0 instrs.len dst 0))

(define (opt-count-mov-dst-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-mov-dst-instr-seq instrs dst)
            (opt-count-mov-dst-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              dst))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-mov-dst-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-count-arith-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-arith-instr-seq instrs)
            (opt-count-arith-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-arith-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-arith-label-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
          (if (= block-label label)
            (opt-count-arith-instr-seq instrs)
            (opt-count-arith-label-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              label))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-arith-label-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-count-mul-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mul-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.BinOp _ op _ _ _)
            (match op
              [(compiler_ir_types.CompilerIrBinOp.Mul) 1]
              [_ 0])]
          [_ 0])))))

(define (opt-count-mul-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-mul-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-mul-label-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
          (if (= block-label label)
            (opt-count-mul-instr-seq instrs)
            (opt-count-mul-label-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              label))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-mul-label-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-blocks-mov-dst-i64-value
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [value : i64 (opt-mov-dst-i64-value-instr-seq instrs dst fallback)]
            (if (= value fallback)
              (opt-blocks-mov-dst-i64-value
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst
                fallback)
              value))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-blocks-mov-dst-i64-value
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        fallback)]))

(define (opt-count-cast-blocks [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-cast-instr-seq instrs)
            (opt-count-cast-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-cast-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-gep-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-gep-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Gep _ _ _ _) 1]
          [_ 0])))))

(define (opt-count-gep-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-gep-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-gep-blocks [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-gep-instr-seq instrs)
            (opt-count-gep-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-gep-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-gep-label-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
          (if (= block-label label)
            (opt-count-gep-instr-seq instrs)
            (opt-count-gep-label-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              label))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-gep-label-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-count-word-instrs-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Word _ _ _ _) 1]
        [_ 0])
      (opt-count-word-instrs-from instrs (+ index 1)))))

(define (opt-count-word-instrs [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-word-instrs-from instrs 0))

(define (opt-count-load-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-load-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Load _ _ _) 1]
          [_ 0])))))

(define (opt-count-load-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-load-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-load-blocks [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-load-instr-seq instrs)
            (opt-count-load-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-load-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-load-label-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
          (if (= block-label label)
            (opt-count-load-instr-seq instrs)
            (opt-count-load-label-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              label))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-load-label-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-blocks-binop-lhs-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [value : i64 (opt-copy-binop-lhs-var-instr-seq instrs dst)]
            (if (= value (- 0 1))
              (opt-blocks-binop-lhs-var
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst
                fallback)
              value))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-blocks-binop-lhs-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        fallback)]))

(define (opt-blocks-mov-src-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [value : i64 (opt-mov-src-var-instr-seq instrs dst fallback)]
            (if (= value fallback)
              (opt-blocks-mov-src-var
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst
                fallback)
              value))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-blocks-mov-src-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        fallback)]))

(define (opt-mov-src-var-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(compiler_ir_types.CompilerIrInstr.Mov
          mov-dst
          (compiler_ir_types.CompilerIrValue.Var src)
          _)
        (if (= mov-dst dst)
          src
          (opt-mov-src-var-instr-seq-from slots (+ index 1) count dst fallback))]
      [_ (opt-mov-src-var-instr-seq-from slots (+ index 1) count dst fallback)])))

(define (opt-mov-src-var-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-src-var-instr-seq-from instrs.slots 0 instrs.len dst fallback))

;; The var a `return` reads, or `fallback` when no block returns a var. Used to
;; pin which value a substituted use ends up reading.
(define (opt-return-var-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var var)))
        var]
      [_ (opt-return-var-instr-seq-from slots (+ index 1) count fallback)])))

(define (opt-return-i64-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.I64 value)))
        value]
      [_ (opt-return-i64-instr-seq-from slots (+ index 1) count fallback)])))

(define (opt-blocks-return-i64
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [value : i64
              (opt-return-i64-instr-seq-from instrs.slots 0 instrs.len fallback)]
            (if (= value fallback)
              (opt-blocks-return-i64
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                fallback)
              value))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-blocks-return-i64
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        fallback)]))

(define (opt-blocks-return-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [value : i64
              (opt-return-var-instr-seq-from instrs.slots 0 instrs.len fallback)]
            (if (= value fallback)
              (opt-blocks-return-var
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                fallback)
              value))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-blocks-return-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        fallback)]))

(define (opt-cfg-test-function [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
