      [(not (= (opt-count-mov-dst-instr-seq slice-call-barrier 6) 0)) 231]
      [(not (= (opt-count-word-instrs group-word-store) 2)) 232]
      [(not (= (opt-count-mov-dst-instr-seq group-word-store 2) 0)) 233]
      [(not (= (opt-count-word-instrs slice-address-store) 2)) 234]
      [(not (= (opt-count-mov-dst-instr-seq slice-address-store 4) 0)) 235]
      [else 44])))

;; --- constant-trip full unroll + byte-compose load combining fixtures -----------
;;
;; The intern-table word-load shape: a rotated single-block loop whose counter
;; phi has a literal seed/step/bound. The descending form (`ge %next, 0`, sub
;; step) matches no other unroll arm, so any rewrite is the const-trip arm's;
;; the ascending form (`lt %phi, literal`) races the guarded x16 arm and shows
;; the exact arm winning (no guard block, no remainder loop).
(define (opt-lc-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "base"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "at"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

;; entry -> body (self-loop: word/b phis, byte compose, b' = b-1, b' >= bound)
;; -> exit (returns the last trip's word). Seed and bound are arguments so one
;; builder covers the 8-trip, 21-trip, and non-literal-bound variants.
(define (opt-lc-word-test-body
  [seed : compiler_ir_types.CompilerIrValue]
  [bound : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      30
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "lc_entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 36)
          (compiler_ir_types.compiler-ir-label "lc_body")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Phi
      28
      (compiler_ir_types.compiler-ir-phi-input-cons
        seed
        (compiler_ir_types.compiler-ir-label "lc_entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 37)
          (compiler_ir_types.compiler-ir-label "lc_body")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      9
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrValue.Var 30)
      (compiler_ir_types.CompilerIrValue.I64 8)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      10
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 28)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.compiler-ir-label "lc_bounds"))
    (compiler_ir_types.CompilerIrInstr.Gep
      18
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      19
      (compiler_ir_types.CompilerIrValue.Var 18)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Cast
      20
      (compiler_ir_types.CompilerIrValue.Var 19)
      (compiler_ast_types.AstType.U8)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      21
      (compiler_ir_types.CompilerIrBinOp.BitOr)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      36
      (compiler_ir_types.CompilerIrValue.Var 21)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      23
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.Var 28)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      37
      (compiler_ir_types.CompilerIrValue.Var 23)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      39
      (compiler_ir_types.CompilerIrBinOp.Ge)
      (compiler_ir_types.CompilerIrValue.Var 23)
      bound
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 39)
      (compiler_ir_types.compiler-ir-label "lc_body")
      (compiler_ir_types.compiler-ir-label "lc_exit"))))

(define (opt-lc-word-test-blocks
  [seed : compiler_ir_types.CompilerIrValue]
  [bound : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "lc_entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "lc_body"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "lc_body")
        (opt-lc-word-test-body seed bound))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "lc_exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 21)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-lc-word-test-function
  [seed : compiler_ir_types.CompilerIrValue]
  [bound : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "lc_word_fixture")
    (opt-lc-test-params)
    (compiler_ast_types.AstType.I64)
    40
    (opt-lc-word-test-blocks seed bound)))

;; Ascending accumulator loop: i/acc phis, acc += i, i += 1, i < bound (the
;; compare reads the phi, not the post-step value). bound 4 => 5 trips; the
;; guarded x16 arm also matches this shape, so the result proves the exact arm
;; is preferred (3 blocks, no __unroll_guard).
(define (opt-lc-asc-test-body [bound : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      30
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "lc_entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 36)
          (compiler_ir_types.compiler-ir-label "lc_body")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Phi
      28
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "lc_entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 37)
          (compiler_ir_types.compiler-ir-label "lc_body")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      9
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 30)
      (compiler_ir_types.CompilerIrValue.Var 28)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      23
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 28)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      36
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      37
      (compiler_ir_types.CompilerIrValue.Var 23)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      39
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 28)
      (compiler_ir_types.CompilerIrValue.I64 bound)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 39)
      (compiler_ir_types.compiler-ir-label "lc_body")
      (compiler_ir_types.compiler-ir-label "lc_exit"))))

(define (opt-lc-asc-test-function [bound : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "lc_asc_fixture")
    (opt-lc-test-params)
    (compiler_ast_types.AstType.I64)
    40
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "lc_entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
