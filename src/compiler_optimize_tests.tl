            (opt.opt-direct-call-clean-memory-bit)))
        84]
      ;; Descriptor-header loads and the callee's memory class, post-BCE.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function header-element-call-func)))
        210]
      [(not
          (=
            (opt-count-load-label-blocks
              (opt.compiler-opt-global-shared-view header-element-call)
              (ir.compiler-ir-label "entry"))
            1))
        211]
      [(not
          (=
            (opt-count-load-label-blocks
              header-element-call
              (ir.compiler-ir-label "loop"))
            0))
        212]
      [(not
          (opt.opt-verify-ok? (opt.opt-verify-function header-global-call-func)))
        213]
      [(not
          (=
            (opt-count-load-label-blocks
              (opt.compiler-opt-global-shared-view header-global-call)
              (ir.compiler-ir-label "loop"))
            1))
        214]
      [(not
          (=
            (opt-count-load-label-blocks
              header-global-call
              (ir.compiler-ir-label "entry"))
            0))
        215]
      [(not
          (opt.opt-verify-ok? (opt.opt-verify-function header-opaque-call-func)))
        216]
      [(not
          (=
            (opt-count-load-label-blocks
              header-opaque-call
              (ir.compiler-ir-label "loop"))
            1))
        217]
      [else 42])))

;; --- P16: fixed-field loads through a FRAME OBJECT ---------------------------
;;
;; The shape: a function allocates an object (`alloc` + `addr_of`), hands the
;; address to a helper that returns it back, and then reads a fixed field of it
;; in a loop that also writes ELEMENTS of a different object. That is every
;; `Vec` local of the interner benchmark -- map-ids, map-hashes, names,
;; name-off, name-len, state -- and before P16 the first link of the chain was
;; refused: a `Vec` handle is not a descriptor handle, so opt-licm-gep-kind had
;; nothing to say about `gep <handle>, 0` and the load through it was an
;; ordinary rooted load in a loop that writes memory.
;;
;; What makes the load invariant is PROVENANCE, not type. The object is an
;; `Alloc` of this frame, so it is not the element storage of any array, so an
;; element store -- through a descriptor's loaded data pointer -- and an
;; element-only callee provably cannot write it. Type alone would be unsound
;; here: a `(__tl_dyn-array Struct)` stores its elements inline, so a
;; struct-typed pointer may address element storage, and the last negative
;; below is exactly that pointer.
(define (opt-licm-ls-gep
  [dst : i64]
  [base : i64]
  [offset : i64]
  [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Gep
    dst
    (ir.CompilerIrValue.Var base)
    (ir.CompilerIrValue.I64 offset)
    ty))

(define (opt-licm-ls-load [dst : i64] [ptr : i64] [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Load dst (ir.CompilerIrValue.Var ptr) ty))

;; `%9 = gep %array, 0 ; %10 = load %9 ; %11 = gep %10, %i ; store %11` -- a
;; write into the ARRAY parameter's separately allocated element storage, which
;; every frame object is disjoint from.
(define (opt-licm-ls-element-store-instrs [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-licm-ls-gep 9 1 0 (ast.AstType.U8))
    (opt-test-instr-seq-prepend
      (opt-licm-ls-load 10 9 (ast.AstType.U64))
      (opt-test-instr-seq-prepend
        (irt.instr "%11 = gep %10, %4 : i64")
        (opt-test-instr-seq-prepend (irt.instr "store_ptr %11, 100 : i64") rest)))))

(define (opt-licm-ls-blocks
  [entry-instrs : ir.CompilerIrInstrSeq]
  [body : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") entry-instrs)
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instr-seq-prepend
          (irt.instr "%4 = phi [%3, entry], [%5, body] : i64")
          body))
      (irt.blocks
        "body:
           jump loop
         exit:
           return %8"))))

(define (opt-licm-ls-local-object-type) : ast.AstType
  (ast.AstType.Struct (ci.intern "LicmLocalObject")))

;; `%3 = mov 0 ; %20 = alloc T ; %21 = addr_of %20 ; jump loop`
(define (opt-licm-ls-alloc-entry) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%3 = mov 0 : i64
     %20 = alloc LicmLocalObject
     %21 = addr_of %20
     jump loop"))

;; The same, plus the sret-shaped call whose result IS `%21`.
(define (opt-licm-ls-alloc-call-entry [symbols : OptLicmTestSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (ir.CompilerIrInstr.Mov 3 (ir.CompilerIrValue.I64 0) (ast.AstType.I64))
    (opt-test-instr-seq-prepend
      (ir.CompilerIrInstr.Alloc 20 (opt-licm-ls-local-object-type))
      (opt-test-instr-seq-prepend
        (ir.CompilerIrInstr.AddrOf 21 20)
        (opt-test-instr-seq-prepend
          (ir.CompilerIrInstr.Call
            22
            symbols.ret-arg
            (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var 21))
            (opt-licm-ls-local-object-type))
          (irt.instrs "jump loop"))))))

(define (opt-licm-ls-plain-entry) : ir.CompilerIrInstrSeq
  (irt.instrs "%3 = mov 0 : i64
     jump loop"))

(define (opt-licm-ls-finish-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%5 = add %4, 1 : i64
     branch %0, body, exit"))

;; Read a fixed field of `handle`, then write an element of the array
;; parameter. `tail` carries whatever else the case puts in the loop.
(define (opt-licm-ls-field-read-body
  [handle : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-licm-ls-gep 7 handle 0 (ast.AstType.U8))
    (opt-test-instr-seq-prepend
      (opt-licm-ls-load 8 7 (ast.AstType.U64))
      (opt-licm-ls-element-store-instrs tail))))

;; A write through the SAME frame object, at a different offset. It closes the
;; proof for every fixed word of that object. FRAME-STORE: it no longer closes
;; the proof for the other descriptor words in the loop -- the array
;; parameter's data slot is a different allocation, and its load moves out
;; while the frame word's stays.
(define (opt-licm-ls-same-object-store-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-licm-ls-gep 13 21 8 (ast.AstType.U8))
    (opt-test-instr-seq-prepend
      (irt.instr "store_ptr %13, 7 : i64")
      (opt-licm-ls-finish-instrs))))

(define (opt-licm-ls-call-instrs [symbols : OptLicmTestSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (ir.CompilerIrInstr.Call
      12
      symbols.touch
      (ir.CompilerIrCallArgs.Nil)
      (ast.AstType.I64))
    (opt-licm-ls-finish-instrs)))

;; The pointer P16 must still refuse: a fixed word of a STRUCT ELEMENT, reached
;; by indexing the array parameter's data buffer. Its type is the same struct
;; type the frame object has; only its provenance differs, and an element store
;; in this same loop can write it.
(define (opt-licm-ls-element-handle-body) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-licm-ls-gep 9 1 0 (ast.AstType.U8))
    (opt-test-instr-seq-prepend
      (opt-licm-ls-load 10 9 (ast.AstType.U64))
      (opt-test-instr-seq-prepend
        (opt-licm-ls-gep 14 10 0 (ast.AstType.I64))
        (opt-test-instr-seq-prepend
          (opt-licm-ls-gep 7 14 8 (ast.AstType.U8))
          (opt-test-instr-seq-prepend
            (opt-licm-ls-load 8 7 (ast.AstType.U64))
            (opt-test-instr-seq-prepend
              (irt.instr "%11 = gep %10, %4 : i64")
              (opt-test-instr-seq-prepend
                (irt.instr "store_ptr %11, 100 : i64")
                (opt-licm-ls-finish-instrs)))))))))

;; A VARIABLE offset off a frame object leaves the fixed-word class: indexing
;; can land on any word of the object -- an inline array field's element, say --
;; so the word a later literal Gep names is no longer decided by the addresses
;; alone. The read below is loop-INVARIANT (its offset is a parameter) and the
;; loop still only writes elements, so nothing but the offset's shape keeps it
;; in place.
(define (opt-licm-ls-variable-offset-body) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (irt.instr "%15 = gep %21, %2 : i64")
    (opt-test-instr-seq-prepend
      (opt-licm-ls-gep 7 15 0 (ast.AstType.U8))
      (opt-test-instr-seq-prepend
        (opt-licm-ls-load 8 7 (ast.AstType.U64))
        (opt-licm-ls-element-store-instrs (opt-licm-ls-finish-instrs))))))

(define (opt-licm-ls-optimized
  [blocks : ir.CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]
  [return-alias : opt_i64_i64_map.Map]) : ir.CompilerIrFunction
  (let
    [func : ir.CompilerIrFunction
      (ir.CompilerIrFunction.Function
        (opt-test-symbol "licm_local")
        (opt-licm-array-params)
        (ast.AstType.I64)
        32
        (ir.compiler-ir-global-shared-view blocks)
        ir.CompilerIrFunctionAbi.Ordinary)]
    (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt.opt-cfg-context-build blocks)
      false
      direct-call-clean
      return-alias
      (opt.opt-global-cell-summary-empty)
      true
      func)
      [(opt.OptFunctionCtxResult.Result next _) next])))

(define (opt-licm-ls-return-alias-map [symbols : OptLicmTestSymbols]) : opt_i64_i64_map.Map
  (let
    [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 4)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut map)
        (ir.compiler-ir-symbol-id symbols.ret-arg)
        1)
      map)))

;; `touch` proven to write ONLY element storage: the middle memory tier.
(define (opt-licm-ls-element-clean-map [symbols : OptLicmTestSymbols]) : opt_i64_i64_map.Map
  (opt-licm-touch-clean-map
    symbols
    (+
      (opt.opt-direct-call-clean-global-bit)
      (opt.opt-direct-call-clean-unconditional-global-bit))))

;; --- the return-alias table's own question -----------------------------------
;;
;; "Does this callee hand one of its own parameters straight back?" The answer
;; has to come from the callee's IR, not from the calling convention, so these
;; fixtures pin what counts and what does not.
(define (opt-licm-ls-alias-params) : ir.CompilerIrParamSeq
  (irt.params "a=%0:u64, b=%1:u64"))

(define (opt-licm-ls-alias-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_alias")
    (opt-licm-ls-alias-params)
    (ast.AstType.U64)
    8
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-licm-ls-alias-single-block [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs)
    (ir.CompilerIrBlockList.Nil)))

(define (opt-licm-ls-alias-return-instrs [var : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (ir.CompilerIrInstr.Return
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var var)))
    (ir.compiler-ir-instr-seq-empty)))

;; Two returning paths, each handing back the parameter named by its argument.
(define (opt-licm-ls-alias-two-return-blocks [left : i64] [right : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %5 = eq %0, 0 : bool
         branch %5, left, right")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "left")
        (opt-licm-ls-alias-return-instrs left))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "right")
          (opt-licm-ls-alias-return-instrs right))
        (ir.CompilerIrBlockList.Nil)))))

(define (opt-licm-ls-alias-index [blocks : ir.CompilerIrBlockList]) : i64
  (opt.opt-licm-return-alias-function-index (opt-licm-ls-alias-function blocks)))

(define (compiler-optimize-licm-local-slot-self-test) : i64
  (let
    [symbols : OptLicmTestSymbols (opt-licm-test-symbols)]
    [empty-map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 1)]
    [element-clean : opt_i64_i64_map.Map
      (opt-licm-ls-element-clean-map symbols)]
    [alias-map : opt_i64_i64_map.Map (opt-licm-ls-return-alias-map symbols)]
    ;; Positive: the field read leaves a loop whose only write is an element
    ;; store through a DIFFERENT object.
    [plain-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-entry)
          (opt-licm-ls-field-read-body 21 (opt-licm-ls-finish-instrs)))
        (opt.compiler-opt-global-shared-view empty-map)
        (opt.compiler-opt-global-shared-view alias-map))]
    [plain : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view plain-func))]
    ;; Positive: the same loop plus a direct callee proven to write only
    ;; element storage. Its writes cannot reach a frame object either.
    [element-call-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-entry)
          (opt-licm-ls-field-read-body 21 (opt-licm-ls-call-instrs symbols)))
        element-clean
        (opt.compiler-opt-global-shared-view alias-map))]
    [element-call : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view element-call-func))]
    ;; Negative: the same blocks with the callee's memory class unproven.
    [opaque-call-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-entry)
          (opt-licm-ls-field-read-body 21 (opt-licm-ls-call-instrs symbols)))
        (opt.compiler-opt-global-shared-view empty-map)
        (opt.compiler-opt-global-shared-view alias-map))]
    [opaque-call : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view opaque-call-func))]
    ;; Negative for the frame word: the loop writes the SAME frame object at
    ;; another offset. The array parameter's data-slot load in the same body
    ;; still moves (FRAME-STORE).
    [same-object-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-entry)
          (opt-licm-ls-field-read-body
            21
            (opt-licm-ls-same-object-store-instrs)))
        (opt.compiler-opt-global-shared-view empty-map)
        (opt.compiler-opt-global-shared-view alias-map))]
    [same-object : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view same-object-func))]
    ;; Positive: the handle arrives back out of a call the table proves returns
    ;; its argument. This is the interner's `%d = call f(.., %sret)` shape.
    [alias-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-call-entry symbols)
          (opt-licm-ls-field-read-body 22 (opt-licm-ls-finish-instrs)))
        (opt.compiler-opt-global-shared-view empty-map)
        (opt.compiler-opt-global-shared-view alias-map))]
    [alias-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view alias-func))]
    ;; Negative control for it: without the table the call result carries no
    ;; provenance and the field read stays put.
    [no-alias-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-call-entry symbols)
          (opt-licm-ls-field-read-body 22 (opt-licm-ls-finish-instrs)))
        (opt.compiler-opt-global-shared-view empty-map)
        (opt.compiler-opt-global-shared-view empty-map))]
    [no-alias : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view no-alias-func))]
    ;; Negative: the same fixed-offset read through a handle that points INTO
    ;; element storage. Same static type, different provenance, and the loop's
    ;; own element store can write it.
    [element-handle-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-plain-entry)
          (opt-licm-ls-element-handle-body))
        (opt.compiler-opt-global-shared-view empty-map)
        (opt.compiler-opt-global-shared-view alias-map))]
    [element-handle : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view element-handle-func))]
    ;; Negative: a variable offset off the frame object, then a literal one.
    [variable-offset-func : ir.CompilerIrFunction
      (opt-licm-ls-optimized
        (opt-licm-ls-blocks
          (opt-licm-ls-alloc-entry)
          (opt-licm-ls-variable-offset-body))
        empty-map
        alias-map)]
    [variable-offset : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view variable-offset-func))]
    (cond
      ;; The return-alias question, first.
      [(not
          (=
            (opt-licm-ls-alias-index
              (opt-licm-ls-alias-single-block
                (opt-licm-ls-alias-return-instrs 1)))
            1))
        300]
      [(not
          (=
            (opt-licm-ls-alias-index
              (irt.blocks
                "entry:
                   %5 = add %0, %1 : u64
                   return %5"))
            -1))
        301]
      ;; A unit return describes no value.
      [(not
          (=
            (opt-licm-ls-alias-index
              (irt.blocks "entry:
                   return"))
            -1))
        302]
      ;; A tail call's result belongs to the tail callee, not to this
      ;; function's parameter list.
      [(not
          (=
            (opt-licm-ls-alias-index
              (opt-licm-ls-alias-single-block
                (opt-test-instr-seq-prepend
                  (ir.CompilerIrInstr.TailCall
                    symbols.touch
                    (ir.CompilerIrCallArgs.Nil)
                    (ast.AstType.U64))
                  (ir.compiler-ir-instr-seq-empty))))
            -1))
        303]
      ;; Every returning path must agree.
      [(not
          (=
            (opt-licm-ls-alias-index (opt-licm-ls-alias-two-return-blocks 0 0))
            0))
        304]
      [(not
          (=
            (opt-licm-ls-alias-index (opt-licm-ls-alias-two-return-blocks 0 1))
            -1))
        305]
      ;; The frame-object proof.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function plain-func))) 310]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view plain)
              (ir.compiler-ir-label "entry"))
            2))
        311]
      [(not
          (=
            (opt-count-load-label-blocks plain (ir.compiler-ir-label "loop"))
            0))
        312]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function element-call-func)))
        313]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view element-call)
              (ir.compiler-ir-label "entry"))
            2))
        314]
      [(not
          (=
            (opt-count-load-label-blocks
              element-call
              (ir.compiler-ir-label "loop"))
            0))
        315]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function opaque-call-func)))
        316]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view opaque-call)
              (ir.compiler-ir-label "entry"))
            0))
        317]
      [(not
          (=
            (opt-count-load-label-blocks
              opaque-call
              (ir.compiler-ir-label "loop"))
            2))
        318]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function same-object-func)))
        319]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view same-object)
              (ir.compiler-ir-label "entry"))
            1))
        320]
      [(not
          (=
            (opt-count-load-label-blocks
              same-object
              (ir.compiler-ir-label "loop"))
            1))
        321]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function alias-func))) 322]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view alias-blocks)
              (ir.compiler-ir-label "entry"))
            2))
        323]
      [(not
          (=
            (opt-count-load-label-blocks
              alias-blocks
              (ir.compiler-ir-label "loop"))
            0))
        324]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function no-alias-func))) 325]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view no-alias)
              (ir.compiler-ir-label "entry"))
            1))
        326]
      [(not
          (=
            (opt-count-load-label-blocks no-alias (ir.compiler-ir-label "loop"))
            1))
        327]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function element-handle-func)))
        328]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view element-handle)
              (ir.compiler-ir-label "entry"))
            1))
        329]
      [(not
          (=
            (opt-count-load-label-blocks
              element-handle
              (ir.compiler-ir-label "loop"))
            1))
        330]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function variable-offset-func)))
        331]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-global-shared-view variable-offset)
              (ir.compiler-ir-label "entry"))
            1))
        332]
      [(not
          (=
            (opt-count-load-label-blocks
              variable-offset
              (ir.compiler-ir-label "loop"))
            1))
        333]
      [else 42])))

(define (opt-licm-unswitch-test-params) : ir.CompilerIrParamSeq
  (irt.params "outer-cond=%0:bool, entry-cond=%1:bool"))

;; The positive form is already rotated: the outer loop header has no exit
;; edge, and `entry` supplies the zero-trip guard. The negative form puts that
;; exit edge back on the header to pin the zero-trip-preservation gate.
(define (opt-licm-unswitch-test-blocks [rotated? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (if rotated?
          (irt.instr "branch %0, outer-pre, exit")
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "outer-pre")))))
    (ir.compiler-ir-block-cons
      (irt.block "outer-pre:
           jump outer")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "outer")
          (opt-test-instrs
            (if rotated?
              (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "inner-entry"))
              (irt.instr "branch %0, inner-entry, exit"))))
        (irt.blocks
          "inner-entry:
             branch %1, inner-pre, inner-exit
           inner-pre:
             jump inner
           inner:
             branch %0, inner-body, inner-exit
           inner-body:
             jump inner
           inner-exit:
             jump outer-latch
           outer-latch:
             branch %0, outer, exit
           exit:
             return 0")))))

(define (opt-licm-unswitch-test-function [rotated? : bool]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_unswitch")
    (opt-licm-unswitch-test-params)
    (ast.AstType.I64)
    2
    (opt-licm-unswitch-test-blocks rotated?)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-licm-unswitch-test-run [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (opt.opt-licm-unswitch-final
    (ast.ast-node-pool-reader-type-segment-bases)
    true
    func))

;; The same final pass as the frozen priced pipeline runs it.
(define (opt-licm-unswitch-test-run-priced [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (opt.opt-licm-unswitch-final
    (ast.ast-node-pool-reader-type-segment-bases)
    false
    func))

(define (opt-licm-unswitch-one-successor?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (let
    [successors : opt.OptLabelSet
      (let
        [index (opt.opt-cfg-index-build blocks)]
        (opt.opt-cfg-index-successors index label))]
    (and
      (=
        (opt.opt-label-count (opt.compiler-opt-global-shared-view successors))
        1)
      (opt.opt-label-contains successors target))))

(define (compiler-optimize-licm-unswitch-self-test) : i64
  (let
    [positive : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-licm-unswitch-test-function true))]
    [positive-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view positive))]
    [repeat : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run
        (opt.compiler-opt-global-shared-view positive))]
    [repeat-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view repeat))]
    [negative : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-licm-unswitch-test-function false))]
    [negative-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view negative))]
    [outer : i64 (ir.compiler-ir-label "outer")]
    [outer-clone : i64 (ir.compiler-ir-label "outer__licm_false")]
    [inner-entry : i64 (ir.compiler-ir-label "inner-entry")]
    [inner-entry-clone : i64 (ir.compiler-ir-label "inner-entry__licm_false")]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function positive))) 1]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view positive-blocks)
            outer-clone))
        2]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "inner")))
        3]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view positive-blocks)
          (ir.compiler-ir-label "inner__licm_false"))
        4]
      ;; The outer zero-trip edge still bypasses the one-time specialization.
      [(not
          (opt-loop-rotation-successors?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "entry")
            (ir.compiler-ir-label "outer-pre")
            (ir.compiler-ir-label "exit")))
        5]
      [(not
          (opt-loop-rotation-successors?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "outer-pre")
            outer-clone
            outer))
        6]
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view positive-blocks)
            inner-entry
            (ir.compiler-ir-label "inner-pre")))
        7]
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view positive-blocks)
            inner-entry-clone
            (ir.compiler-ir-label "inner-exit__licm_false")))
        8]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function repeat))) 9]
      [(not
          (=
            (ir.compiler-ir-block-list-count positive-blocks)
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view repeat-blocks))))
        10]
      [(opt-block-list-has-label?
          repeat-blocks
          (ir.compiler-ir-label "outer__licm_false__licm_false"))
        11]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function negative))) 12]
      [(opt-block-list-has-label? negative-blocks outer-clone) 13]
      [else 42])))

;; --- LU-1: any invariant branch the body tests twice --------------------------
;;
;; A rotated loop with no nested loop: `a` and `b` both branch on the invariant
;; `sel`. With `twice?` both test it and the loop unswitches -- the original
;; side folds both to their true arms, the clone both to their false arms; with
;; one test the dispatch would cost more than a trip saves and the loop is left
;; alone. Inside the inliner's priced prefix the rail stays off.
(define (opt-lu1-test-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, sel=%1:bool"))

(define (opt-lu1-test-branch [var : i64] [on-true : String] [on-false : String]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Branch
    (ir.CompilerIrValue.Var var)
    (ir.compiler-ir-label on-true)
    (ir.compiler-ir-label on-false)))

(define (opt-lu1-test-blocks [twice? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         branch %0, pre, exit")
    (ir.compiler-ir-block-cons
      (opt-pcf-block "pre" (opt-test-instrs (opt-pcf-jump "head")))
      (ir.compiler-ir-block-cons
        (opt-pcf-block "head" (opt-test-instrs (opt-pcf-jump "a")))
        (ir.compiler-ir-block-cons
          (irt.block "a:
               branch %1, a_t, a_f")
          (ir.compiler-ir-block-cons
            (opt-pcf-block "a_t" (opt-test-instrs (opt-pcf-jump "b")))
            (ir.compiler-ir-block-cons
              (opt-pcf-block "a_f" (opt-test-instrs (opt-pcf-jump "b")))
              (ir.compiler-ir-block-cons
                (opt-pcf-block
                  "b"
                  (if twice?
                    (opt-test-instrs (opt-lu1-test-branch 1 "b_t" "b_f"))
                    (opt-test-instrs (opt-pcf-jump "b_t"))))
                (irt.blocks
                  "b_t:
                     jump latch
                   b_f:
                     jump latch
                   latch:
                     branch %0, head, exit
                   exit:
                     return 0")))))))))

(define (opt-lu1-test-function [twice? : bool]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_unswitch_general")
    (opt-lu1-test-params)
    (ast.AstType.I64)
    2
    (opt-lu1-test-blocks twice?)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (compiler-optimize-licm-unswitch-general-self-test) : i64
  (let
    [positive : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-lu1-test-function true))]
    [positive-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view positive))]
    [once : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-lu1-test-function false))]
    [once-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks once)]
    [priced : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run-priced (opt-lu1-test-function true))]
    [priced-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks priced)]
    [head-clone : i64 (ir.compiler-ir-label "head__licm_false")]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function positive))) 1]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view positive-blocks)
            head-clone))
        2]
      ;; the dispatch: `pre` branches between the two copies
      [(not
          (opt-loop-rotation-successors?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "pre")
            (ir.compiler-ir-label "head")
            head-clone))
        3]
      ;; both tests fold on the original side ...
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "a")
            (ir.compiler-ir-label "a_t")))
        4]
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "b")
            (ir.compiler-ir-label "b_t")))
        5]
      ;; ... and in the clone
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "a__licm_false")
            (ir.compiler-ir-label "a_f__licm_false")))
        6]
      [(not
          (opt-licm-unswitch-one-successor?
            positive-blocks
            (ir.compiler-ir-label "b__licm_false")
            (ir.compiler-ir-label "b_f__licm_false")))
        7]
      ;; one test: left alone
      [(opt-block-list-has-label? once-blocks head-clone) 8]
      ;; inside the priced prefix: left alone
      [(opt-block-list-has-label? priced-blocks head-clone) 9]
      [else 42])))

;; --- PH-1: a big loop's guard chain hoisted as one predicate -----------------
;;
;; A rotated loop whose body is 76 blocks -- past the 64-block clone cap -- so
;; the unswitch takes the predicate path. `g1` tests `lt lo, hi` computed in
;; the body (admitted only on this path), `g2` chains `le lo, hi` behind it,
;; `fast` re-tests `g1`'s condition; all three fail to `slow`, which reaches
;; the latch through 70 jump stubs (the bulk). The hoist puts the conjunction
;; in `pre`, branches `g1` on it, and folds `g2` and `fast` to their jumps; no
;; block is cloned. Inside the priced prefix, and for the same shape under the
;; clone cap (10 stubs), the loop is left alone: the body-computed condition
;; is not invariant there.
(define (opt-ph1-test-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, lo=%1:i64, hi=%2:i64"))

(define (opt-ph1-stub-name [index : i64]) : String
  (str_cat.str-cat "t" (string.int->string index)))

;; t<index> .. t<count-1>, each jumping to the next, the last to `latch`.
(define (opt-ph1-test-stubs
  [index : i64]
  [count : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (>= index count)
    tail
    (ir.compiler-ir-block-cons
      (opt-pcf-block
        (opt-ph1-stub-name index)
        (opt-test-instrs
          (opt-pcf-jump
            (if (= index (- count 1))
              "latch"
              (opt-ph1-stub-name (+ index 1))))))
      (opt-ph1-test-stubs (+ index 1) count tail))))

(define (opt-ph1-test-blocks [stubs : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         branch %0, pre, exit")
    (ir.compiler-ir-block-cons
      (opt-pcf-block "pre" (opt-test-instrs (opt-pcf-jump "head")))
      (ir.compiler-ir-block-cons
        (opt-pcf-block "head" (opt-test-instrs (opt-pcf-jump "g1")))
        (ir.compiler-ir-block-cons
          (irt.block
            "g1:
               %3 = lt %1, %2 : i64
               branch %3, g2, slow")
          (ir.compiler-ir-block-cons
            (irt.block
              "g2:
                 %4 = le %1, %2 : i64
                 branch %4, fast, slow")
            (ir.compiler-ir-block-cons
              (irt.block "fast:
                   branch %3, latch, slow")
              (ir.compiler-ir-block-cons
                (opt-pcf-block "slow" (opt-test-instrs (opt-pcf-jump "t0")))
                (opt-ph1-test-stubs
                  0
                  stubs
                  (irt.blocks
                    "latch:
                       branch %0, head, exit
                     exit:
                       return 0"))))))))))

(define (opt-ph1-test-function [stubs : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_predicate_hoist")
    (opt-ph1-test-params)
    (ast.AstType.I64)
    5
    (opt-ph1-test-blocks stubs)
    ir.CompilerIrFunctionAbi.Ordinary))

;; The var the block's last instruction branches on, or -1.
(define (opt-ph1-branch-cond-var
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (let
    [block : ir.CompilerIrBlock (opt-pcf-block-of blocks label)]
    [count : i64
      (opt-block-instr-count (opt.compiler-opt-global-shared-view block))]
    (if (<= count 0)
      (- 0 1)
      (match (opt-block-instr-at block (- count 1))
        [(ir.CompilerIrInstr.Branch (ir.CompilerIrValue.Var var) _ _) var]
        [_ (- 0 1)]))))

(define (compiler-optimize-licm-predicate-hoist-self-test) : i64
  (let
    [positive : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-ph1-test-function 70))]
    [positive-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view positive))]
    [small : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-ph1-test-function 10))]
    [small-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks small)]
    [priced : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run-priced (opt-ph1-test-function 70))]
    [priced-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks priced)]
    [head-clone : i64 (ir.compiler-ir-label "head__licm_false")]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function positive))) 1]
      ;; no clone
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view positive-blocks)
          head-clone)
        2]
      ;; the two materialized compares and their conjunction, before the jump
      [(not
          (=
            (opt-pcf-count
              (opt.compiler-opt-global-shared-view positive-blocks)
              "pre")
            4))
        3]
      ;; g1 branches on the predicate (a fresh var) ...
      [(<
          (opt-ph1-branch-cond-var
            (opt.compiler-opt-global-shared-view positive-blocks)
            "g1")
          5)
        4]
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view positive-blocks)
            (ir.compiler-ir-label "g2")
            (ir.compiler-ir-label "fast")))
        5]
      ;; ... and g2 and the re-test fold to the edges they always took
      [(not
          (opt-pcf-jumps-to?
            (opt.compiler-opt-global-shared-view positive-blocks)
            "g2"
            "fast"))
        6]
      [(not (opt-pcf-jumps-to? positive-blocks "fast" "latch")) 7]
      ;; under the clone cap the body-computed condition is no candidate
      [(not
          (=
            (opt-pcf-count
              (opt.compiler-opt-global-shared-view small-blocks)
              "pre")
            1))
        8]
      [(opt-block-list-has-label? small-blocks head-clone) 9]
      ;; the priced prefix leaves the loop alone
      [(not (= (opt-pcf-count priced-blocks "pre") 1)) 10]
      [else 42])))

;; --- the invariant dispatch chain -------------------------------------------
;;
;; `dispatch-a` and `dispatch-b` are the two-test dispatch an inlined, versioned
;; loop leaves inside its enclosing repetition loop. Only `dispatch-b` is ever
;; SELECTED (it is the one whose arm enters the nested loop), so the chain walk
;; is what has to reach `dispatch-a`, and the ceiling on the walk is what has to
;; stop it at `inner`.
;;
;; The `invariant-a?` twin is the nearest refused neighbour: identical down to
;; `dispatch-a` testing a value the outer loop DEFINES, which is the one clause
;; that keeps a block out of the chain. It must still unswitch -- on
;; `dispatch-b` alone, resolving its clone against the negation exactly as the
;; single-branch tier always did.
(define (opt-licm-unswitch-chain-test-params) : ir.CompilerIrParamSeq
  (irt.params "outer-cond=%0:bool, cond-a=%1:bool, cond-b=%2:bool"))

(define (opt-licm-unswitch-chain-header-instrs [invariant-a? : bool]) : ir.CompilerIrInstrSeq
  (if invariant-a?
    (irt.instrs "jump dispatch-a")
    ;; The refused twin: `dispatch-a` now tests a value defined in the loop.
    (irt.instrs "%3 = mov %1 : bool
       jump dispatch-a")))

(define (opt-licm-unswitch-chain-test-blocks [invariant-a? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         branch %0, outer-pre, exit")
    (ir.compiler-ir-block-cons
      (irt.block "outer-pre:
           jump outer")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "outer")
          (opt-licm-unswitch-chain-header-instrs invariant-a?))
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "dispatch-a")
            (opt-test-instrs
              (ir.CompilerIrInstr.Branch
                (if invariant-a?
                  (ir.CompilerIrValue.Var 1)
                  (ir.CompilerIrValue.Var 3))
                (ir.compiler-ir-label "dispatch-b")
                (ir.compiler-ir-label "inner-exit"))))
          (irt.blocks
            "dispatch-b:
               branch %2, inner-pre, inner-exit
             inner-pre:
               jump inner
             inner:
               branch %0, inner-body, inner-exit
             inner-body:
               jump inner
             inner-exit:
               jump outer-latch
             outer-latch:
               branch %0, outer, exit
             exit:
               return 0"))))))

(define (opt-licm-unswitch-chain-test-function [invariant-a? : bool]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_unswitch_chain")
    (opt-licm-unswitch-chain-test-params)
    (ast.AstType.I64)
    4
    (opt-licm-unswitch-chain-test-blocks invariant-a?)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-licm-unswitch-successor-count
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (opt.opt-label-count
    (let
      [index (opt.opt-cfg-index-build blocks)]
      (opt.opt-cfg-index-successors index label))))

(define (compiler-optimize-licm-unswitch-chain-self-test) : i64
  (let
    [chained : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-licm-unswitch-chain-test-function true))]
    [chained-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view chained))]
    [repeat : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt.compiler-opt-global-shared-view chained))]
    [repeat-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view repeat))]
    [single : ir.CompilerIrFunction
      (opt-licm-unswitch-test-run (opt-licm-unswitch-chain-test-function false))]
    [single-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view single))]
    [dispatch-a : i64 (ir.compiler-ir-label "dispatch-a")]
    [dispatch-a-clone : i64 (ir.compiler-ir-label "dispatch-a__licm_false")]
    [dispatch-b : i64 (ir.compiler-ir-label "dispatch-b")]
    [dispatch-b-clone : i64 (ir.compiler-ir-label "dispatch-b__licm_false")]
    [outer-clone : i64 (ir.compiler-ir-label "outer__licm_false")]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chained))) 1]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view chained-blocks)
            outer-clone))
        2]
      ;; The kept side resolves the WHOLE dispatch: both tests are gone.
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view chained-blocks)
            dispatch-a
            dispatch-b))
        3]
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view chained-blocks)
            dispatch-b
            (ir.compiler-ir-label "inner-pre")))
        4]
      ;; ...and the clone keeps both, because a negated conjunction convicts no
      ;; single conjunct.
      [(not
          (=
            (opt-licm-unswitch-successor-count
              (opt.compiler-opt-global-shared-view chained-blocks)
              dispatch-a-clone)
            2))
        5]
      [(not
          (=
            (opt-licm-unswitch-successor-count
              (opt.compiler-opt-global-shared-view chained-blocks)
              dispatch-b-clone)
            2))
        6]
      ;; The nested loop's own test is not dispatch and stays a branch.
      [(not
          (=
            (opt-licm-unswitch-successor-count
              (opt.compiler-opt-global-shared-view chained-blocks)
              (ir.compiler-ir-label "inner"))
            2))
        7]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function repeat))) 8]
      [(not
          (=
            (ir.compiler-ir-block-list-count chained-blocks)
            (ir.compiler-ir-block-list-count
              (opt.compiler-opt-global-shared-view repeat-blocks))))
        9]
      [(opt-block-list-has-label?
          repeat-blocks
          (ir.compiler-ir-label "outer__licm_false__licm_false"))
        10]
      ;; The refused neighbour still unswitches, on the selected branch alone.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function single))) 11]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view single-blocks)
            outer-clone))
        12]
      [(not
          (=
            (opt-licm-unswitch-successor-count
              (opt.compiler-opt-global-shared-view single-blocks)
              dispatch-a)
            2))
        13]
      [(not
          (opt-licm-unswitch-one-successor?
            (opt.compiler-opt-global-shared-view single-blocks)
            dispatch-b
            (ir.compiler-ir-label "inner-pre")))
        14]
      [(not
          (opt-licm-unswitch-one-successor?
            single-blocks
            dispatch-b-clone
            (ir.compiler-ir-label "inner-exit__licm_false")))
        15]
      [else 42])))

(define (opt-induction-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, seed=%1:i64, ptr=%2:i64"))

(define (opt-induction-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "induction")
    (opt-induction-params)
    (ast.AstType.I64)
    32
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-induction-optimized-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt.opt-induction-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-induction-test-function blocks)))

(define (opt-induction-offset-blocks [step : i64] [scale : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump loop")
    (ir.compiler-ir-block-cons
      (irt.block
        "loop:
           %3 = phi [%1, entry], [%5, body] : i64
           branch %0, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs
            (ir.CompilerIrInstr.BinOp
              4
              (ir.CompilerIrBinOp.Mul)
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 scale)
              (ast.AstType.I64))
            (irt.instr "%6 = add %4, 7 : i64")
            (ir.CompilerIrInstr.BinOp
              5
              (ir.CompilerIrBinOp.Add)
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 step)
              (ast.AstType.I64))
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
        (irt.blocks "exit:
             return %3")))))

(define (opt-induction-gep-blocks [step : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump loop")
    (ir.compiler-ir-block-cons
      (irt.block
        "loop:
           %3 = phi [%1, entry], [%5, body] : i64
           branch %0, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs
            (irt.instr "%4 = gep %2, %3 : u8")
            (irt.instr "%6 = load %4 : u8")
            (ir.CompilerIrInstr.BinOp
              5
              (ir.CompilerIrBinOp.Add)
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 step)
              (ast.AstType.I64))
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
        (irt.blocks "exit:
             return %3")))))

(define (opt-induction-offset-index-mul-blocks
  [step : i64]
  [op : ir.CompilerIrBinOp]
  [offset : i64]
  [scale : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump loop")
    (ir.compiler-ir-block-cons
      (irt.block
        "loop:
           %3 = phi [%1, entry], [%5, body] : i64
           branch %0, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs
            (ir.CompilerIrInstr.BinOp
              4
              op
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 offset)
              (ast.AstType.I64))
            (ir.CompilerIrInstr.BinOp
              6
              (ir.CompilerIrBinOp.Mul)
              (ir.CompilerIrValue.Var 4)
              (ir.CompilerIrValue.I64 scale)
              (ast.AstType.I64))
            (irt.instr "%7 = add %6, 7 : i64")
            (ir.CompilerIrInstr.BinOp
              5
              (ir.CompilerIrBinOp.Add)
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 step)
              (ast.AstType.I64))
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
        (irt.blocks "exit:
             return %3")))))

(define (opt-induction-offset-index-gep-blocks
  [step : i64]
  [op : ir.CompilerIrBinOp]
  [offset : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump loop")
    (ir.compiler-ir-block-cons
      (irt.block
        "loop:
           %3 = phi [%1, entry], [%5, body] : i64
           branch %0, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs
            (ir.CompilerIrInstr.BinOp
              4
              op
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 offset)
              (ast.AstType.I64))
            (irt.instr "%6 = gep %2, %4 : u8")
            (irt.instr "%7 = load %6 : u8")
            (ir.CompilerIrInstr.BinOp
              5
              (ir.CompilerIrBinOp.Add)
              (ir.CompilerIrValue.Var 3)
              (ir.CompilerIrValue.I64 step)
              (ast.AstType.I64))
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
        (irt.blocks "exit:
             return %3")))))

(define (opt-induction-multi-offset-blocks [duplicate : bool]) : ir.CompilerIrBlockList
  (let
    [second-scale : i64
      (if duplicate
        4
        8)]
    (ir.compiler-ir-block-cons
      (irt.block "entry:
           jump loop")
      (ir.compiler-ir-block-cons
        (irt.block
          "loop:
             %3 = phi [%1, entry], [%5, body] : i64
             branch %0, body, exit")
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "body")
            (opt-test-instrs
              (irt.instr "%4 = mul %3, 4 : i64")
              (irt.instr "%6 = add %4, 7 : i64")
              (ir.CompilerIrInstr.BinOp
                7
                (ir.CompilerIrBinOp.Mul)
                (ir.CompilerIrValue.Var 3)
                (ir.CompilerIrValue.I64 second-scale)
                (ast.AstType.I64))
              (irt.instr "%8 = add %7, 11 : i64")
              (irt.instr "%5 = add %3, 1 : i64")
              (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
          (irt.blocks "exit:
               return %3"))))))

(define (opt-induction-multi-gep-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %3 = phi [%1, entry], [%5, body] : i64
       branch %0, body, exit
     body:
       %4 = gep %2, %3 : u8
       %6 = load %4 : u8
       %7 = gep @other_base, %3 : i64
       %8 = load %7 : i64
       %5 = add %3, 1 : i64
       jump loop
     exit:
       return %3"))

(define (opt-induction-unsupported-step-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %3 = phi [%1, entry], [%5, body] : i64
       branch %0, body, exit
     body:
       %4 = mul %3, 4 : i64
       %6 = add %4, 7 : i64
       %5 = mul %3, 2 : i64
       jump loop
     exit:
       return %3"))

(define (opt-induction-call-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %3 = phi [%1, entry], [%5, body] : i64
       branch %0, body, exit
     body:
       %4 = mul %3, 4 : i64
       %7 = call tl_noop() : i64
       %6 = add %4, 7 : i64
       %5 = add %3, 1 : i64
       jump loop
     exit:
       return %3"))

;; A loop whose latch recurrence reaches the phi through a copy (`%7 = mov %5`)
;; with a `gep data, (mul i, 16)` fetch: the copy chain is chased to find the
;; fact, and the non-folding 16-byte stride gets a scaled address IV.
(define (opt-induction-mov-latch-scaled-gep-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %3 = phi [%1, entry], [%7, body] : i64
       branch %0, body, exit
     body:
       %4 = mul %3, 16 : i64
       %6 = gep %2, %4 : u8
       %8 = load %6 : u8
       %5 = add %3, 1 : i64
       %7 = mov %5 : i64
       jump loop
     exit:
       return %3"))

(define (opt-induction-store-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %3 = phi [%1, entry], [%5, body] : i64
       branch %0, body, exit
     body:
       %4 = mul %3, 4 : i64
       store @sink, %4 : i64
       %5 = add %3, 1 : i64
       jump loop
     exit:
       return %3"))

(define (opt-induction-loop-local-base-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %3 = phi [%1, entry], [%5, body] : i64
       branch %0, body, exit
     body:
       %7 = mov 100 : u64
       %4 = gep %7, %3 : u8
       %6 = load %4 : u8
       %5 = add %3, 1 : i64
       jump loop
     exit:
       return %3"))

(define (opt-induction-no-preheader-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, pre-one, pre-two
     pre-one:
       jump loop
     pre-two:
       jump loop
     loop:
       %3 = phi [%1, pre-one], [%1, pre-two], [%5, body] : i64
       branch %0, body, exit
     body:
       %4 = mul %3, 4 : i64
       %6 = add %4, 7 : i64
       %5 = add %3, 1 : i64
       jump loop
     exit:
       return %3"))

;; IND-BASE. `%4 = add %2, (mul %3, scale)` -- the strided index off an
;; invariant base -- read by a gep; with `invariant?` false the base is
;; defined inside the loop (a `mov` of the counter) and nothing may derive.
(define (opt-induction-add-inv-blocks [scale : i64] [invariant? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump loop")
    (ir.compiler-ir-block-cons
      (irt.block
        "loop:
           %3 = phi [%1, entry], [%5, body] : i64
           branch %0, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs
            (ir.CompilerIrInstr.Mov
              9
              (if invariant?
                (ir.CompilerIrValue.Var 2)
                (ir.CompilerIrValue.Var 3))
              (ast.AstType.I64))
            ;; scale 1 adds the counter itself (a `mul i, 1` never survives
            ;; the folder); the product var is then an unread `mov`
            (if (= scale 1)
              (irt.instr "%7 = mov %3 : i64")
              (ir.CompilerIrInstr.BinOp
                7
                (ir.CompilerIrBinOp.Mul)
                (ir.CompilerIrValue.Var 3)
                (ir.CompilerIrValue.I64 scale)
                (ast.AstType.I64)))
            (ir.CompilerIrInstr.BinOp
              4
              (ir.CompilerIrBinOp.Add)
              (if invariant?
                (ir.CompilerIrValue.Var 2)
                (ir.CompilerIrValue.Var 9))
              (if (= scale 1)
                (ir.CompilerIrValue.Var 3)
                (ir.CompilerIrValue.Var 7))
              (ast.AstType.I64))
            (irt.instr "%8 = gep %2, %4 : i64")
            (irt.instr "%6 = load %8 : i64")
            (irt.instr "%5 = add %3, 1 : i64")
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
        (irt.blocks "exit:
             return %3")))))

;; IND-BASE: the sum becomes a `mov` off a derived phi (two phis: the counter
;; and the sum -- the product yields to the sum rather than deriving its own).
;; The plain `c + i` sum is refused (a loop-live phi for one add), and with
;; the base defined inside the loop the add stays while the product still
;; derives its own phi as before.
(define (compiler-optimize-induction-add-inv-self-test) : i64
  (let
    [scaled-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-add-inv-blocks 3 true))]
    [scaled : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view scaled-func))]
    [unit-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-add-inv-blocks 1 true))]
    [unit-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view unit-func))]
    [local-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-add-inv-blocks 3 false))]
    [local-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks local-func)]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function scaled-func))) 1]
      [(not
          (=
            (opt-count-phi-blocks (ir.compiler-ir-global-shared-view scaled))
            2))
        2]
      [(= (opt-blocks-mov-src-var scaled 4 (- 0 1)) (- 0 1)) 3]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function unit-func))) 4]
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view unit-blocks))
            1))
        5]
      [(not (= (opt-blocks-mov-src-var unit-blocks 4 (- 0 1)) (- 0 1))) 6]
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view local-blocks))
            2))
        7]
      [(not (= (opt-blocks-mov-src-var local-blocks 4 (- 0 1)) (- 0 1))) 8]
      [else 42])))

(define (compiler-optimize-induction-self-test) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-induction-offset-blocks 1 4)]
    [func : ir.CompilerIrFunction (opt-induction-optimized-function blocks)]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view func))]
    [nonunit-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-offset-blocks 3 4))]
    [nonunit : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view nonunit-func))]
    [negative-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-offset-blocks (- 0 2) 4))]
    [negative : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view negative-func))]
    [gep-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-gep-blocks 1))]
    [gep : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view gep-func))]
    [unsupported-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-unsupported-step-blocks))]
    [unsupported : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view unsupported-func))]
    [call-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-call-blocks))]
    [call-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view call-func))]
    [store-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-store-blocks))]
    [store-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view store-func))]
    [local-base-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-loop-local-base-blocks))]
    [local-base : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view local-base-func))]
    [no-preheader-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-no-preheader-blocks))]
    [no-preheader : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view no-preheader-func))]
    [multi-offset-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-multi-offset-blocks false))]
    [multi-offset : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view multi-offset-func))]
    [duplicate-offset-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-multi-offset-blocks true))]
    [duplicate-offset : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view duplicate-offset-func))]
    [multi-gep-func : ir.CompilerIrFunction
      (opt-induction-optimized-function (opt-induction-multi-gep-blocks))]
    [multi-gep : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view multi-gep-func))]
    [offset-add-mul-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-offset-index-mul-blocks 2 (ir.CompilerIrBinOp.Add) 3 4))]
    [offset-add-mul : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view offset-add-mul-func))]
    [offset-sub-mul-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-offset-index-mul-blocks 2 (ir.CompilerIrBinOp.Sub) 1 4))]
    [offset-sub-mul : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view offset-sub-mul-func))]
    [offset-gep-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-offset-index-gep-blocks 2 (ir.CompilerIrBinOp.Add) 2))]
    [offset-gep : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view offset-gep-func))]
    [unsupported-offset-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-offset-index-mul-blocks
          2
          (ir.CompilerIrBinOp.Add)
          1000001
          4))]
    [unsupported-offset : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view unsupported-offset-func))]
    [mov-scaled-func : ir.CompilerIrFunction
      (opt-induction-optimized-function
        (opt-induction-mov-latch-scaled-gep-blocks))]
    [mov-scaled : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view mov-scaled-func))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function func))) 1]
      [(not
          (= (opt-count-phi-blocks (ir.compiler-ir-global-shared-view out)) 2))
        2]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-global-shared-view out)
              4
              (- 0 1))
            33))
        3]
      [(not
          (= (opt-count-mul-label-blocks out (ir.compiler-ir-label "body")) 0))
        4]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function nonunit-func))) 5]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view nonunit)
              4
              (- 0 1))
            33))
        6]
      [(not
          (=
            (opt-count-mul-label-blocks nonunit (ir.compiler-ir-label "body"))
            0))
        7]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function negative-func))) 8]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view negative)
              4
              (- 0 1))
            33))
        9]
      [(not
          (=
            (opt-count-mul-label-blocks negative (ir.compiler-ir-label "body"))
            0))
        10]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function gep-func))) 11]
      ;; A scale-1 gep folds into the x86 addressing mode, so an address IV
      ;; only costs a latch add: the affine Gep derived no longer fires.
      [(not
          (=
            (opt-count-gep-label-blocks
              (opt.compiler-opt-global-shared-view gep)
              (ir.compiler-ir-label "body"))
            1))
        12]
      [(not (= (opt-blocks-mov-src-var gep 4 (- 0 1)) (- 0 1))) 13]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function unsupported-func))) 14]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view unsupported)
              4
              (- 0 1))
            (- 0 1)))
        15]
      [(not
          (=
            (opt-count-mul-label-blocks
              unsupported
              (ir.compiler-ir-label "body"))
            2))
        16]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function call-func))) 17]
      ;; A loop with a call keeps its plain recurrence: a derived phi would be
      ;; loop-live across the call and spill more than the mul costs.
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view call-blocks)
              4
              (- 0 1))
            (- 0 1)))
        18]
      [(not
          (=
            (opt-count-mul-label-blocks
              (opt.compiler-opt-global-shared-view call-blocks)
              (ir.compiler-ir-label "body"))
            1))
        19]
      [(not (= (opt-count-direct-call-name-blocks call-blocks "tl_noop") 1)) 20]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function store-func))) 21]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view store-blocks)
              4
              (- 0 1))
            33))
        22]
      [(not
          (=
            (opt-count-mul-label-blocks
              store-blocks
              (ir.compiler-ir-label "body"))
            0))
        23]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function local-base-func))) 24]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view local-base)
              4
              (- 0 1))
            (- 0 1)))
        25]
      [(not
          (=
            (opt-count-gep-label-blocks
              local-base
              (ir.compiler-ir-label "body"))
            1))
        26]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function no-preheader-func)))
        27]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view no-preheader))
            1))
        28]
      [(not
          (=
            (opt-count-mul-label-blocks
              no-preheader
              (ir.compiler-ir-label "body"))
            1))
        29]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view multi-offset-func))))
        30]
      [(not (= (opt.opt-function-frame multi-offset-func) 38)) 31]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view multi-offset))
            3))
        32]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view multi-offset)
              4
              (- 0 1))
            33))
        33]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view multi-offset)
              7
              (- 0 1))
            36))
        34]
      [(not
          (=
            (opt-count-mul-label-blocks
              multi-offset
              (ir.compiler-ir-label "body"))
            0))
        35]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view duplicate-offset-func))))
        36]
      [(not (= (opt.opt-function-frame duplicate-offset-func) 35)) 37]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view duplicate-offset))
            2))
        38]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view duplicate-offset)
              4
              (- 0 1))
            33))
        39]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view duplicate-offset)
              7
              (- 0 1))
            33))
        40]
      [(not
          (=
            (opt-count-mul-label-blocks
              duplicate-offset
              (ir.compiler-ir-label "body"))
            0))
        41]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view multi-gep-func))))
        42]
      ;; Both geps fold (u8 and i64 elements), so no address IVs fire.
      [(not (= (opt.opt-function-frame multi-gep-func) 32)) 43]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view multi-gep))
            1))
        44]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view multi-gep)
              4
              (- 0 1))
            (- 0 1)))
        45]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view multi-gep)
              7
              (- 0 1))
            (- 0 1)))
        46]
      [(not
          (=
            (opt-count-gep-label-blocks multi-gep (ir.compiler-ir-label "body"))
            2))
        47]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view offset-add-mul-func))))
        48]
      [(not (= (opt.opt-function-frame offset-add-mul-func) 36)) 49]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view offset-add-mul))
            2))
        50]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view offset-add-mul)
              6
              (- 0 1))
            34))
        51]
      [(not
          (=
            (opt-count-mul-label-blocks
              offset-add-mul
              (ir.compiler-ir-label "body"))
            0))
        52]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view offset-sub-mul-func))))
        53]
      [(not (= (opt.opt-function-frame offset-sub-mul-func) 36)) 54]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view offset-sub-mul))
            2))
        55]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view offset-sub-mul)
              6
              (- 0 1))
            34))
        56]
      [(not
          (=
            (opt-count-mul-label-blocks
              offset-sub-mul
              (ir.compiler-ir-label "body"))
            0))
        57]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view offset-gep-func))))
        58]
      ;; The affine u8 gep folds, so no address IV fires.
      [(not (= (opt.opt-function-frame offset-gep-func) 32)) 59]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view offset-gep))
            1))
        60]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view offset-gep)
              6
              (- 0 1))
            (- 0 1)))
        61]
      [(not
          (=
            (opt-count-gep-label-blocks
              offset-gep
              (ir.compiler-ir-label "body"))
            1))
        62]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view unsupported-offset-func))))
        63]
      [(not (= (opt.opt-function-frame unsupported-offset-func) 32)) 64]
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view unsupported-offset)
              6
              (- 0 1))
            (- 0 1)))
        65]
      [(not
          (=
            (opt-count-mul-label-blocks
              unsupported-offset
              (ir.compiler-ir-label "body"))
            1))
        66]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view mov-scaled-func))))
        67]
      [(not (= (opt.opt-function-frame mov-scaled-func) 36)) 68]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view mov-scaled))
            2))
        69]
      ;; The copy-chased fact plus the 16-byte stride produce a scaled
      ;; address IV at var 34; the fetch gep rewrites to a copy of it.
      [(not
          (=
            (opt-blocks-mov-src-var
              (opt.compiler-opt-global-shared-view mov-scaled)
              6
              (- 0 1))
            34))
        70]
      [(not
          (=
            (opt-count-mul-label-blocks
              (opt.compiler-opt-global-shared-view mov-scaled)
              (ir.compiler-ir-label "body"))
            1))
        71]
      [(not
          (=
            (opt-count-gep-label-blocks
              mov-scaled
              (ir.compiler-ir-label "body"))
            1))
        72]
      [else 42])))

;; --- linear-function test replacement fixtures ------------------------------
;;
;; entry (preheader: pointer seed) -> loop (header: pointer phi, counter phi,
;; a load off the pointer) -> body (latch: `i + 1`, its copy, the pointer's
;; constant-stride gep, the exit compare) -> exit. In the eligible modes the
;; counter's only readers are its own increment and that compare, so the test
;; moves onto the pointer phi and the counter retires.
(define (opt-lftr-optimized-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt.opt-lftr-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-induction-test-function blocks)))

(define (opt-lftr-entry-block) : ir.CompilerIrBlock
  (irt.block "entry:
       %4 = gep %2, 0 : u8
       jump loop"))

(define (opt-lftr-header-block) : ir.CompilerIrBlock
  (irt.block
    "loop:
       %9 = phi [%4, entry], [%8, body] : i64
       %3 = phi [0, entry], [%7, body] : i64
       %10 = load %9 : u8
       jump body"))

(define (opt-lftr-body-block
  [prefix : ir.CompilerIrInstrSeq]
  [stride : ir.CompilerIrValue]
  [extra : ir.CompilerIrInstrSeq]
  [compare-lhs : ir.CompilerIrValue]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt.opt-licm-unswitch-instrs-onto
      prefix
      (opt-test-instrs-with-tail
        (opt.opt-licm-unswitch-instrs-onto
          extra
          (opt-test-instrs
            (ir.CompilerIrInstr.BinOp
              11
              (ir.CompilerIrBinOp.Lt)
              compare-lhs
              (ir.CompilerIrValue.Var 1)
              (ast.AstType.I64))
            (irt.instr "branch %11, loop, exit")))
        (irt.instr "%6 = add %3, 1 : i64")
        (ir.CompilerIrInstr.Mov 7 (ir.CompilerIrValue.Var 6) (ast.AstType.I64))
        (ir.CompilerIrInstr.Gep
          8
          (ir.CompilerIrValue.Var 9)
          stride
          (ast.AstType.U8))))))

(define (opt-lftr-exit-block [result : ir.CompilerIrValue]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "exit")
    (opt-test-instrs
      (ir.CompilerIrInstr.Return (ir.CompilerIrMaybeValue.Some result)))))

(define (opt-lftr-blocks
  [prefix : ir.CompilerIrInstrSeq]
  [stride : ir.CompilerIrValue]
  [extra : ir.CompilerIrInstrSeq]
  [compare-lhs : ir.CompilerIrValue]
  [result : ir.CompilerIrValue]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-lftr-entry-block)
    (ir.compiler-ir-block-cons
      (opt-lftr-header-block)
      (ir.compiler-ir-block-cons
        (opt-lftr-body-block prefix stride extra compare-lhs)
        (ir.compiler-ir-block-cons
          (opt-lftr-exit-block result)
          (ir.CompilerIrBlockList.Nil))))))

;; `cmp i + 1, n`: the rotated latch form the bytecode dispatch loop uses.
(define (opt-lftr-next-form-blocks) : ir.CompilerIrBlockList
  (opt-lftr-blocks
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.I64 16)
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.Var 6)
    (ir.CompilerIrValue.Var 9)))

;; `cmp i, n`: the unrotated latch form.
(define (opt-lftr-phi-form-blocks) : ir.CompilerIrBlockList
  (opt-lftr-blocks
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.I64 16)
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.Var 3)
    (ir.CompilerIrValue.Var 9)))

;; A unit stride keeps the preheader bound to a single gep (no multiply).
(define (opt-lftr-unit-stride-blocks) : ir.CompilerIrBlockList
  (opt-lftr-blocks
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.I64 1)
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.Var 6)
    (ir.CompilerIrValue.Var 9)))

;; A live reader other than the increment and the compare: not retirable.
(define (opt-lftr-extra-use-blocks) : ir.CompilerIrBlockList
  (opt-lftr-blocks
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.I64 16)
    (irt.instrs "%13 = mul %3, 5 : i64")
    (ir.CompilerIrValue.Var 6)
    (ir.CompilerIrValue.Var 13)))

;; The pointer phi advances by a loop-varying amount, so no order-equivalent
;; end address exists: not retirable.
(define (opt-lftr-var-stride-blocks) : ir.CompilerIrBlockList
  (opt-lftr-blocks
    (irt.instrs "%12 = mov %1 : i64")
    (ir.CompilerIrValue.Var 12)
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.Var 6)
    (ir.CompilerIrValue.Var 9)))

;; A surviving bounds check reads the counter, so the trip count is NOT yet
;; known to be inside the walked allocation: the no-wrap precondition for the
;; preheader end address fails and the loop is left alone.
(define (opt-lftr-bounds-check-blocks) : ir.CompilerIrBlockList
  (opt-lftr-blocks
    (irt.instrs "bounds_check %3, %1 message \"bounds_ok.0\"")
    (ir.CompilerIrValue.I64 16)
    (ir.compiler-ir-instr-seq-empty)
    (ir.CompilerIrValue.Var 6)
    (ir.CompilerIrValue.Var 9)))

(define (opt-lftr-def-count-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (opt.opt-instr-def-var (ir.compiler-ir-instr-seq-ref instrs index))
        [(option_i64.Some dst)
          (if (= dst var)
            1
            0)]
        [(option_i64.None) 0])
      (opt-lftr-def-count-seq instrs (+ index 1) var))))

(define (opt-lftr-def-count-blocks
  [blocks : ir.CompilerIrBlockList]
  [var : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (+
            (opt-lftr-def-count-seq instrs 0 var)
            (opt-lftr-def-count-blocks (deref rest) var))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-lftr-def-count-blocks (ir.compiler-ir-block-seq-to-list seq) var)]))

;; The var operand of the BinOp defining `dst`: side 0 = lhs, 1 = rhs. -1 when
;; there is no such def or the operand is not a var.
(define (opt-lftr-binop-operand-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [side : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp binop-dst _ lhs rhs _)
        (if (= binop-dst dst)
          (match (if (= side 0)
            lhs
            rhs)
            [(ir.CompilerIrValue.Var var) var]
            [_ (- 0 1)])
          (opt-lftr-binop-operand-seq instrs (+ index 1) dst side))]
      [_ (opt-lftr-binop-operand-seq instrs (+ index 1) dst side)])))

(define (opt-lftr-binop-operand-blocks
  [blocks : ir.CompilerIrBlockList]
  [dst : i64]
  [side : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (- 0 1)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64 (opt-lftr-binop-operand-seq instrs 0 dst side)]
            (if (>= found 0)
              found
              (opt-lftr-binop-operand-blocks (deref rest) dst side)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-lftr-binop-operand-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        dst
        side)]))

;; LFTR-SUM. The partner is an i64 SUM phi, `%9 = phi [%4, entry], [%8, body]`
;; with `%4 = add %2, 5` in the entry and `%8 = add %9, 3` on the latch (the
;; IND-BASE strided index), the counter seeds from `counter-seed` (a literal,
;; or a var: %2), the latch compares `compare-lhs` (the increment %6, or its
;; copy hop %7) against %1, and `checked?` puts a bounds check on the sum.
(define (opt-lftr-sum-blocks
  [counter-seed : ir.CompilerIrValue]
  [compare-lhs : ir.CompilerIrValue]
  [checked? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         %4 = add %2, 5 : i64
         jump loop")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instrs
          (irt.instr "%9 = phi [%4, entry], [%8, body] : i64")
          (ir.CompilerIrInstr.Phi
            3
            (ir.compiler-ir-phi-input-seq-prepend
              counter-seed
              (ir.compiler-ir-label "entry")
              (ir.compiler-ir-phi-input-seq-prepend
                (ir.CompilerIrValue.Var 7)
                (ir.compiler-ir-label "body")
                (ir.compiler-ir-phi-input-seq-empty)))
            (ast.AstType.I64))
          (irt.instr "%10 = gep %2, %9 : i64")
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "body"))))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt.opt-licm-unswitch-instrs-onto
            (if checked?
              (irt.instrs "bounds_check %9, %1 message \"bounds_ok.0\"")
              (ir.compiler-ir-instr-seq-empty))
            (opt-test-instrs
              (irt.instr "%6 = add %3, 1 : i64")
              (irt.instr "%7 = mov %6 : i64")
              (irt.instr "%8 = add %9, 3 : i64")
              (ir.CompilerIrInstr.BinOp
                11
                (ir.CompilerIrBinOp.Lt)
                compare-lhs
                (ir.CompilerIrValue.Var 1)
                (ast.AstType.I64))
              (irt.instr "branch %11, loop, exit"))))
        (irt.blocks "exit:
             return %9")))))

;; LFTR-SUM: the counter retires onto the sum phi's advanced value -- with a
;; literal seed and the increment in the compare, and with a VAR seed and the
;; increment's copy hop in the compare; a bounds check reading the sum keeps
;; the loop as it is.
(define (compiler-optimize-lftr-sum-self-test) : i64
  (let
    [lit-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function
        (opt-lftr-sum-blocks
          (ir.CompilerIrValue.I64 0)
          (ir.CompilerIrValue.Var 6)
          false))]
    [lit-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view lit-func))]
    [var-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function
        (opt-lftr-sum-blocks
          (ir.CompilerIrValue.Var 2)
          (ir.CompilerIrValue.Var 7)
          false))]
    [var-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view var-func))]
    [checked-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function
        (opt-lftr-sum-blocks
          (ir.CompilerIrValue.I64 0)
          (ir.CompilerIrValue.Var 6)
          true))]
    [checked-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks checked-func)]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function lit-func))) 1]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view lit-blocks))
            1))
        2]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view lit-blocks)
              3)
            0))
        3]
      ;; the compare reads the sum's advanced value against the preheader end
      [(not
          (=
            (opt-lftr-binop-operand-blocks
              (opt.compiler-opt-global-shared-view lit-blocks)
              11
              0)
            8))
        4]
      [(not (= (opt-lftr-binop-operand-blocks lit-blocks 11 1) 34)) 5]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function var-func))) 6]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view var-blocks))
            1))
        7]
      [(not (= (opt-lftr-binop-operand-blocks var-blocks 11 0) 8)) 8]
      [(not (= (opt-count-phi-blocks checked-blocks) 2)) 9]
      [else 42])))

(define (compiler-optimize-lftr-self-test) : i64
  (let
    [next-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function (opt-lftr-next-form-blocks))]
    [next-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view next-func))]
    [phi-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function (opt-lftr-phi-form-blocks))]
    [phi-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view phi-func))]
    [unit-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function (opt-lftr-unit-stride-blocks))]
    [unit-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view unit-func))]
    [extra-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function (opt-lftr-extra-use-blocks))]
    [extra-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view extra-func))]
    [var-stride-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function (opt-lftr-var-stride-blocks))]
    [var-stride-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view var-stride-func))]
    [bounds-func : ir.CompilerIrFunction
      (opt-lftr-optimized-function (opt-lftr-bounds-check-blocks))]
    [bounds-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view bounds-func))]
    (cond
      ;; `cmp i + 1, n` retires onto the pointer's advanced value.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view next-func))))
        1]
      [(not (= (opt.opt-function-frame next-func) 35)) 2]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view next-blocks))
            1))
        3]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view next-blocks)
              3)
            0))
        4]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view next-blocks)
              6)
            0))
        5]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view next-blocks)
              7)
            0))
        6]
      [(not
          (=
            (opt-lftr-binop-operand-blocks
              (opt.compiler-opt-global-shared-view next-blocks)
              11
              0)
            8))
        7]
      [(not
          (=
            (opt-lftr-binop-operand-blocks
              (opt.compiler-opt-global-shared-view next-blocks)
              11
              1)
            34))
        8]
      ;; end = seed + n * 16, so a multiply plus the gep land in the preheader.
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view next-blocks)
              33)
            1))
        9]
      [(not (= (opt-lftr-def-count-blocks next-blocks 34) 1)) 10]
      ;; `cmp i, n` retires onto the pointer phi itself.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view phi-func))))
        11]
      [(not (= (opt.opt-function-frame phi-func) 35)) 12]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view phi-blocks))
            1))
        13]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view phi-blocks)
              3)
            0))
        14]
      [(not
          (=
            (opt-lftr-binop-operand-blocks
              (opt.compiler-opt-global-shared-view phi-blocks)
              11
              0)
            9))
        15]
      [(not (= (opt-lftr-binop-operand-blocks phi-blocks 11 1) 34)) 16]
      ;; A unit element step needs no scaling multiply.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function unit-func))) 17]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view unit-blocks))
            1))
        18]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view unit-blocks)
              33)
            0))
        19]
      [(not (= (opt-lftr-def-count-blocks unit-blocks 34) 1)) 20]
      ;; A second live reader of the counter blocks the retirement.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view extra-func))))
        21]
      [(not (= (opt.opt-function-frame extra-func) 32)) 22]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view extra-blocks))
            2))
        23]
      [(not
          (=
            (opt-lftr-def-count-blocks
              (opt.compiler-opt-global-shared-view extra-blocks)
              3)
            1))
        24]
      [(not (= (opt-lftr-binop-operand-blocks extra-blocks 11 0) 6)) 25]
      ;; A loop-varying pointer step blocks it too.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view var-stride-func))))
        26]
      [(not (= (opt.opt-function-frame var-stride-func) 32)) 27]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view var-stride-blocks))
            2))
        28]
      [(not (= (opt-lftr-def-count-blocks var-stride-blocks 3) 1)) 29]
      ;; And so does a bounds check still reading the counter.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view bounds-func))))
        30]
      [(not (= (opt.opt-function-frame bounds-func) 32)) 31]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view bounds-blocks))
            2))
        32]
      [(not (= (opt-lftr-def-count-blocks bounds-blocks 3) 1)) 33]
      [else 42])))

(define (opt-unroll-test-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64"))

;; entry -> body (self-loop: i/acc phis, acc += i, i += step, i' < n) -> exit.
;; step 1 is the canonical counted shape; any other step must be rejected.
(define (opt-unroll-test-blocks [step : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (irt.instr "%2 = phi [0, entry], [%5, body] : i64")
          (irt.instr "%3 = phi [0, entry], [%4, body] : i64")
          (irt.instr "%4 = add %3, %2 : i64")
          (ir.CompilerIrInstr.BinOp
            5
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.I64 step)
            (ast.AstType.I64))
          (irt.instr "%6 = lt %5, %0 : bool")
          (irt.instr "branch %6, body, exit")))
      (irt.blocks "exit:
           return %3"))))

;; A canonical counted loop whose store-free body READS one element per trip:
;; `acc = acc + base[i]`. This is the streaming shape the unroll cascade is
;; restricted to -- the hash/scan/reduction family -- and the only fixture here
;; whose body satisfies both halves of `opt-unroll-cascade-body-ok?` (admitted
;; by the store-free whitelist AND containing a Load).
(define (opt-unroll-cascade-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump body
     body:
       %2 = phi [0, entry], [%5, body] : i64
       %3 = phi [0, entry], [%8, body] : i64
       %7 = gep %1, %2 : i64
       %4 = load %7 : i64
       %8 = add %3, %4 : i64
       %5 = add %2, 1 : i64
       %6 = lt %5, %0 : bool
       branch %6, body, exit
     exit:
       return %3"))

(define (opt-unroll-cascade-test-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_cascade_fixture")
    (opt-unroll-vector-test-params)
    (ast.AstType.I64)
    9
    (opt-unroll-cascade-test-blocks)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-unroll-vector-test-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64, base=%1:i64"))

;; A canonical counted reduction whose store-free body covers every SIMD form
;; admitted by the straight-line unroller. Dependencies deliberately chain
;; through the vector forms so clone remapping must be correct.
(define (opt-unroll-vector-test-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (irt.instr "%2 = phi [0, entry], [%13, body] : i64")
          (irt.instr "%3 = phi [0, entry], [%12, body] : i64")
          (ir.CompilerIrInstr.LaneId 4 4 (ast.AstType.I64))
          (irt.instr "%5 = splat %2 lanes 4 : i64")
          (irt.instr "%6 = vector_load %1, %2 lanes 4 : i64")
          (ir.ir-instr-vector-bin-op
            7
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var 6)
            (ir.CompilerIrValue.Var 4)
            4
            (ast.AstType.I64))
          (ir.ir-instr-vector-compare
            8
            (ir.CompilerIrBinOp.Lt)
            (ir.CompilerIrValue.Var 7)
            (ir.CompilerIrValue.Var 5)
            4
            (ast.AstType.I64))
          (irt.instr "%9 = mask_and %8, %8 lanes 4")
          (ir.ir-instr-select
            10
            (ir.CompilerIrValue.Var 9)
            (ir.CompilerIrValue.Var 7)
            (ir.CompilerIrValue.Var 6)
            4
            (ast.AstType.I64))
          (irt.instr "%11 = vector_reduce_sum %10 lanes 4 : i64")
          (irt.instr "%12 = add %3, %11 : i64")
          (irt.instr "%13 = add %2, 1 : i64")
          (irt.instr "%14 = lt %13, %0 : bool")
          (irt.instr "branch %14, body, exit")))
      (irt.blocks "exit:
           return %3"))))

;; The SPMD lowerer keeps vectors mutable instead of placing them in SSA phis.
;; After loop rotation its gang loop is one self-loop block with the next
;; vector index already computed on entry, then a `mov/add/le` latch.
(define (opt-unroll-mutable-vector-test-blocks [loop-local-base? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %2 = mov 0 : i64
         %3 = splat 0 lanes 4 : i64
         %4 = add %2, 4 : i64
         %5 = le %4, %0 : i64
         branch %5, body, exit")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (irt.instr "%9 = mov %1 : i64")
          (ir.CompilerIrInstr.VectorLoad
            6
            (if loop-local-base?
              (ir.CompilerIrValue.Var 9)
              (ir.CompilerIrValue.Var 1))
            (ir.CompilerIrValue.Var 2)
            4
            (ast.AstType.I64))
          (ir.ir-instr-vector-bin-op
            7
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var 6)
            (ir.CompilerIrValue.Var 3)
            4
            (ast.AstType.I64))
          (ir.ir-instr-vector-bin-op
            3
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var 3)
            (ir.CompilerIrValue.Var 7)
            4
            (ast.AstType.I64))
          (irt.instr "%2 = mov %4 : i64")
          (irt.instr "%4 = add %2, 4 : i64")
          (irt.instr "%5 = le %4, %0 : i64")
          (irt.instr "branch %5, body, exit")))
      (irt.blocks
        "exit:
           %8 = vector_reduce_sum %3 lanes 4 : i64
           return %8"))))

(define (opt-unroll-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_fixture")
    (opt-unroll-test-params)
    (ast.AstType.I64)
    7
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-unroll-vector-test-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_vector_fixture")
    (opt-unroll-vector-test-params)
    (ast.AstType.I64)
    15
    (opt-unroll-vector-test-blocks)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-unroll-mutable-vector-test-function [loop-local-base? : bool]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_mutable_vector_fixture")
    (opt-unroll-vector-test-params)
    (ast.AstType.I64)
    10
    (opt-unroll-mutable-vector-test-blocks loop-local-base?)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-unroll-mutable-map-test-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64, left=%1:i64, right=%2:i64, out=%3:i64"))

;; Mutable rotated map gang:
;;   load left[i], load right[i], add, store out[i], i += 4.
;; mode 1 aliases all three exact IR bases, mode 2 makes the output base
;; loop-local, and mode 3 gives the store a noncanonical index.
(define (opt-unroll-mutable-map-test-blocks [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %4 = mov 0 : i64
         %5 = add %4, 4 : i64
         %6 = le %5, %0 : i64
         branch %6, body, exit")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (irt.instr "%10 = mov %3 : i64")
          (irt.instr "%7 = vector_load %1, %4 lanes 4 : i64")
          (ir.CompilerIrInstr.VectorLoad
            8
            (if (= mode 1)
              (ir.CompilerIrValue.Var 1)
              (ir.CompilerIrValue.Var 2))
            (ir.CompilerIrValue.Var 4)
            4
            (ast.AstType.I64))
          (ir.ir-instr-vector-bin-op
            9
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var 7)
            (ir.CompilerIrValue.Var 8)
            4
            (ast.AstType.I64))
          (ir.ir-instr-vector-store
            (cond
              [(= mode 1) (ir.CompilerIrValue.Var 1)]
              [(= mode 2) (ir.CompilerIrValue.Var 10)]
              [else (ir.CompilerIrValue.Var 3)])
            (if (= mode 3)
              (ir.CompilerIrValue.Var 5)
              (ir.CompilerIrValue.Var 4))
            (ir.CompilerIrValue.Var 9)
            4
            (ast.AstType.I64))
          (irt.instr "%4 = mov %5 : i64")
          (irt.instr "%5 = add %4, 4 : i64")
          (irt.instr "%6 = le %5, %0 : i64")
          (irt.instr "branch %6, body, exit")))
      (irt.blocks "exit:
           return 0"))))

(define (opt-unroll-mutable-map-test-function [mode : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_mutable_map_fixture")
    (opt-unroll-mutable-map-test-params)
    (ast.AstType.I64)
    11
    (opt-unroll-mutable-map-test-blocks mode)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-unroll-test-count-add-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-count-add-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.BinOp _ op _ _ _)
            (match op
              [(ir.CompilerIrBinOp.Add) 1]
              [_ 0])]
          [_ 0])))))

(define (opt-unroll-test-count-vector-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-count-vector-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.LaneId _ _ _) 1]
          [(ir.CompilerIrInstr.Splat _ _ _ _) 1]
          [(ir.CompilerIrInstr.VectorBinOp _) 1]
          [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) 1]
          [(ir.CompilerIrInstr.VectorCompare _) 1]
          [(ir.CompilerIrInstr.MaskBinOp _ _ _ _ _) 1]
          [(ir.CompilerIrInstr.Select _) 1]
          [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) 1]
          [(ir.CompilerIrInstr.VectorStore _) 1]
          [_ 0])))))

(define (opt-unroll-test-count-store-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-count-store-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.VectorStore _) 1]
          [_ 0])))))

(define (opt-unroll-test-count-gep-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-count-gep-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Gep _ _ _ _) 1]
          [_ 0])))))

(define (opt-unroll-test-count-in-block
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [stores? : bool]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if stores?
            (opt-unroll-test-count-store-instr-seq instrs 0 0)
            (opt-unroll-test-count-gep-instr-seq instrs 0 0))])]))

(define (opt-unroll-test-count-vector-in-block
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-test-count-vector-instr-seq instrs 0 0)])]))

(define (opt-unroll-test-count-add-in-block
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-test-count-add-instr-seq instrs 0 0)])]))

(define (opt-unroll-load-store-test-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64, dst=%1:i64, src=%2:i64"))

;; The merge shape neither older whitelist admits: a counted self-loop that
;; both loads and stores (`dst[i] = dst[i] | src[i]`).
;;   mode 0  the admitted merge loop
;;   mode 1  the nearest refusal: the same loop plus one CopyBytes, a memory
;;           operation outside every body whitelist
;;   mode 2  the fill twin (`dst[i] = 0`): stores, no load, so it keeps the
;;           sixteen-copy factor and pins the other side of the table
;;   mode 3  the same merge loop with a BoundsCheck: still checked, so it is
;;           not a versioner fast clone and stays refused
(define (opt-unroll-load-store-test-head
  [mode : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (= mode 3)
    (opt-test-instrs-with-tail
      tail
      (irt.instr "bounds_check %3, %0 message \"body__bounds_ok.0\""))
    tail))

(define (opt-unroll-load-store-test-body [mode : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-unroll-load-store-test-head
      mode
      (opt-test-instrs-with-tail
        (if (= mode 2)
          (opt-test-instrs-with-tail
            (opt-unroll-load-store-test-latch)
            (irt.instr "store_ptr %4, 0 : i64"))
          (opt-test-instrs-with-tail
            (if (= mode 1)
              (opt-test-instrs-with-tail
                (opt-unroll-load-store-test-latch)
                (irt.instr "copy_bytes %4, %6, 8"))
              (opt-unroll-load-store-test-latch))
            (irt.instr "%5 = load %4 : i64")
            (irt.instr "%6 = gep %2, %3 : i64")
            (irt.instr "%7 = load %6 : i64")
            (irt.instr "%8 = or %5, %7 : i64")
            (irt.instr "store_ptr %4, %8 : i64")))
        (irt.instr "%4 = gep %1, %3 : i64")))
    (irt.instr "%3 = phi [0, entry], [%9, body] : i64")))

(define (opt-unroll-load-store-test-latch) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%9 = add %3, 1 : i64
     %10 = lt %9, %0 : bool
     branch %10, body, exit"))

(define (opt-unroll-load-store-test-blocks [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-unroll-load-store-test-body mode))
      (irt.blocks "exit:
           return %0"))))

(define (opt-unroll-load-store-test-function [mode : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_load_store_fixture")
    (opt-unroll-load-store-test-params)
    (ast.AstType.I64)
    11
    (opt-unroll-load-store-test-blocks mode)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-unroll-test-count-store-ptr-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-count-store-ptr-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.StorePtr _ _ _) 1]
          [_ 0])))))

(define (opt-unroll-test-count-load-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-count-load-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Load _ _ _) 1]
          [_ 0])))))

(define (opt-unroll-test-count-store-ptr-in-block
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-test-count-store-ptr-instr-seq instrs 0 0)])]))

(define (opt-unroll-test-count-load-in-block
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-test-count-load-instr-seq instrs 0 0)])]))

;; The load-AND-store body class and its own copy factor.
(define (compiler-optimize-unroll-load-store-self-test) : i64
  (let
    [merge-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 0))]
    [merge : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view merge-func))]
    ;; Second pass over the already-rewritten function: the generated labels
    ;; and the dropped self-edge make the result ineligible to its own scan.
    [idempotent-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.compiler-opt-global-shared-view merge-func))]
    [idempotent : ir.CompilerIrBlockList
      (opt.opt-function-blocks idempotent-func)]
    [refused-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 1))]
    [refused : ir.CompilerIrBlockList (opt.opt-function-blocks refused-func)]
    [fill-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 2))]
    [fill : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view fill-func))]
    [checked-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 3))]
    [checked : ir.CompilerIrBlockList (opt.opt-function-blocks checked-func)]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function merge-func))) 1]
      ;; entry, guard, unrolled body, remainder loop, exit.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view merge))
            5))
        2]
      ;; TWO copies, not sixteen: the load-and-store factor.
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              (ir.compiler-ir-global-shared-view merge)
              (ir.compiler-ir-label "body__unroll_body"))
            2))
        3]
      [(not
          (=
            (opt-unroll-test-count-load-in-block
              (ir.compiler-ir-global-shared-view merge)
              (ir.compiler-ir-label "body__unroll_body"))
            4))
        4]
      ;; The original block stays in place as the remainder loop, one copy
      ;; wide, so an odd trip count still executes every index exactly once.
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              merge
              (ir.compiler-ir-label "body"))
            1))
        5]
      ;; Idempotent: a second pass finds nothing left to rewrite.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view idempotent))
            5))
        6]
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              idempotent
              (ir.compiler-ir-label "body__unroll_body"))
            2))
        7]
      ;; Nearest refusal: one memory operation outside every body whitelist.
      [(not (= (ir.compiler-ir-block-list-count refused) 3)) 8]
      [(opt.opt-unroll-body-load-store-instr-ok?
          (irt.instr "copy_bytes %4, %6, 8"))
        9]
      ;; The other boundary of the class: a vector instruction keeps its body
      ;; on the store-free SIMD admission and the gang unroller, never here,
      ;; even though the scalar whitelist admits it store-free.
      [(opt.opt-unroll-body-load-store-instr-ok?
          (irt.instr "%5 = vector_load %1, %3 lanes 4 : i64"))
        15]
      [(not
          (opt.opt-unroll-body-instr-ok?
            (irt.instr "%5 = vector_load %1, %3 lanes 4 : i64")))
        16]
      ;; The other side of the factor table: a store-only body keeps sixteen.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function fill-func))) 10]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view fill))
            5))
        11]
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              fill
              (ir.compiler-ir-label "body__unroll_body"))
            16))
        12]
      [(not (= (opt.opt-unroll-group-copies) 16)) 13]
      [(not (= (opt.opt-unroll-load-store-group-copies) 2)) 14]
      ;; A still-checked merge body is not a fast clone: unrolling it would
      ;; duplicate the check AND pre-empt the versioner that removes it.
      [(not (= (ir.compiler-ir-block-list-count checked) 3)) 17]
      [(opt.opt-unroll-body-load-store-instr-ok?
          (irt.instr "bounds_check %3, %0 message \"body__bounds_ok.0\""))
        18]
      ;; ... while the store-free class still admits exactly that check.
      [(not
          (opt.opt-unroll-body-instr-ok?
            (irt.instr "bounds_check %3, %0 message \"body__bounds_ok.0\"")))
        19]
      [else 42])))

;; --- UNR-2: the descending shift ---------------------------------------------
;;
;; `dst[i + 3] = dst[i]` walked DOWNWARD, latched by `i - 1 >= floor`: the
;; shape `benchmarks/regalloc_greedy`'s `rg-union-insert-segment!` runs and the
;; one every ordered insert in this compiler's own tables runs. Params are the
;; load-and-store fixture's: 0 = the floor, 1 = the base, 2 = the seed (the top
;; of the range the counter walks down from).
;;
;; The copy OVERLAPS by construction -- it writes a slot three below the one a
;; later iteration reads -- so what the positive case asserts is the group's
;; instruction ORDER, not only its instruction counts: a clone that hoisted a
;; copy's store above a later copy's load would compute a different table.
;;
;;   mode 0  the admitted descending shift (`i - 1`, `>= floor`)
;;   mode 1  the step-TWO twin (`i - 2`). The guard `seed >= floor + K` states
;;           that the K-th counter value from `seed` is exactly `seed - K`,
;;           which only a unit step makes true, so this must be refused.
;;   mode 2  the loop-VARIANT floor: the latch compares against the value the
;;           body just loaded, which the block itself defines, so `floor + K`
;;           is not a preheader-computable quantity at all.
(define (opt-unroll-descending-test-body [mode : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%3 = phi [%2, entry], [%9, body] : i64")
    (irt.instr "%4 = gep %1, %3 : i64")
    (ir.CompilerIrInstr.Load 5 (ir.CompilerIrValue.Var 4) (ast.AstType.I64))
    (irt.instr "%6 = add %3, 3 : i64")
    (irt.instr "%7 = gep %1, %6 : i64")
    (irt.instr "store_ptr %7, %5 : i64")
    (ir.CompilerIrInstr.BinOp
      9
      (ir.CompilerIrBinOp.Sub)
      (ir.CompilerIrValue.Var 3)
      (ir.CompilerIrValue.I64
        (if (= mode 1)
          2
          1))
      (ast.AstType.I64))
    (ir.CompilerIrInstr.BinOp
      10
      (ir.CompilerIrBinOp.Ge)
      (ir.CompilerIrValue.Var 9)
      (if (= mode 2)
        (ir.CompilerIrValue.Var 5)
        (ir.CompilerIrValue.Var 0))
      (ast.AstType.Bool))
    (irt.instr "branch %10, body, exit")))

(define (opt-unroll-descending-test-blocks [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-unroll-descending-test-body mode))
      (irt.blocks "exit:
           return %0"))))

(define (opt-unroll-descending-test-function [mode : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_descending_fixture")
    (opt-unroll-load-store-test-params)
    (ast.AstType.I64)
    11
    (opt-unroll-descending-test-blocks mode)
    ir.CompilerIrFunctionAbi.Ordinary))

;; The block's memory operations as one number, most significant first: a Load
;; shifts in a 1 and a StorePtr a 0, everything else is skipped. Two copies of
;; a load-then-store body read 1,0,1,0 -- decimal 10 -- and any reordering of
;; the four (a store hoisted above a later copy's load, say) is a different
;; number. It is the ORDER, not the counts, that the overlapping shift needs.
(define (opt-unroll-test-memory-order-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-unroll-test-memory-order-instr-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Load _ _ _) (+ (* acc 2) 1)]
        [(ir.CompilerIrInstr.StorePtr _ _ _) (* acc 2)]
        [_ acc]))))

(define (opt-unroll-test-memory-order-in-block
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-unroll-test-memory-order-instr-seq instrs 0 0)])]))

(define (compiler-optimize-unroll-descending-self-test) : i64
  (let
    [down-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-descending-test-function 0))]
    [down : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view down-func))]
    [step-two-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-descending-test-function 1))]
    [step-two : ir.CompilerIrBlockList (opt.opt-function-blocks step-two-func)]
    [variant-floor-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-descending-test-function 2))]
    [variant-floor : ir.CompilerIrBlockList
      (opt.opt-function-blocks variant-floor-func)]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function down-func))) 1]
      ;; entry, guard, unrolled body, remainder loop, exit -- the remainder
      ;; loop is kept exactly as it is for the ascending form.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view down))
            5))
        2]
      ;; The load-and-store class factor, unchanged for the descending
      ;; direction: two copies, each with its own load and its own store.
      [(not
          (=
            (opt-unroll-test-count-load-in-block
              (ir.compiler-ir-global-shared-view down)
              (ir.compiler-ir-label "body__unroll_body"))
            2))
        3]
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              (ir.compiler-ir-global-shared-view down)
              (ir.compiler-ir-label "body__unroll_body"))
            2))
        4]
      ;; PROGRAM ORDER inside the group: load, store, load, store. The copies
      ;; are emitted one after another in the block's own instruction order, so
      ;; a store can never precede the load of a copy that came before it.
      [(not
          (=
            (opt-unroll-test-memory-order-in-block
              (ir.compiler-ir-global-shared-view down)
              (ir.compiler-ir-label "body__unroll_body"))
            10))
        5]
      ;; The mirrored guard: `ngroup = floor + K` is an ADD where the ascending
      ;; guard subtracts, and it is the only add the guard block holds.
      [(not
          (=
            (opt-unroll-test-count-add-in-block
              down
              (ir.compiler-ir-label "body__unroll_guard"))
            1))
        6]
      ;; A step of two is not a counted shape at any direction: blocks stay
      ;; untouched.
      [(not (= (ir.compiler-ir-block-list-count step-two) 3)) 7]
      ;; Neither is a floor the loop body itself defines.
      [(not (= (ir.compiler-ir-block-list-count variant-floor) 3)) 8]
      [else 42])))

(define (compiler-optimize-unroll-self-test) : i64
  (let
    [func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-test-function (opt-unroll-test-blocks 1)))]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view func))]
    [nonunit-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-test-function (opt-unroll-test-blocks 2)))]
    [nonunit : ir.CompilerIrBlockList (opt.opt-function-blocks nonunit-func)]
    [vector-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-vector-test-function))]
    [vector-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view vector-func))]
    [mutable-vector-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-vector-test-function false))]
    [mutable-vector-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view mutable-vector-func))]
    [store-required-input : ir.CompilerIrFunction
      (opt-unroll-mutable-vector-test-function false)]
    [store-required-func : ir.CompilerIrFunction
      (match (opt.opt-unroll-simd-function-with-context-result
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-cfg-context-build
          (opt.opt-function-blocks
            (opt.compiler-opt-global-shared-view store-required-input)))
        store-required-input
        true)
        [(opt.OptFunctionCtxResult.Result result _) result])]
    [local-base-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-vector-test-function true))]
    [local-base-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view local-base-func))]
    [map-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 0))]
    [map-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view map-func))]
    [alias-map-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 1))]
    [alias-map-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view alias-map-func))]
    [local-store-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 2))]
    [local-store-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view local-store-func))]
    [bad-store-index-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 3))]
    [bad-store-index-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view bad-store-index-func))]
    [pipeline-map-func : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 0))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function func))) 1]
      ;; entry, guard, unrolled body, sum exit, remainder loop, exit.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            6))
        2]
      ;; thirty-two acc adds + thirty-two counter adds.
      [(<
          (opt-unroll-test-count-add-in-block
            out
            (ir.compiler-ir-label "body__unroll_body"))
          64)
        3]
      ;; a non-unit counter step is not canonical: blocks stay untouched.
      [(not (= (ir.compiler-ir-block-list-count nonunit) 3)) 4]
      ;; Bounds-check labels must remain unique at the sixteen-copy factor.
      [(not (string.eq (opt.opt-unroll-copy-suffix 15) "__u15")) 5]
      [(string.eq
          (opt.opt-unroll-copy-suffix 3)
          (opt.opt-unroll-copy-suffix 15))
        6]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function vector-func))) 7]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view vector-out))
            5))
        8]
      ;; Eight admitted SIMD instructions across all sixteen body copies.
      [(not
          (=
            (opt-unroll-test-count-vector-in-block
              vector-out
              (ir.compiler-ir-label "body__unroll_body"))
            128))
        9]
      ;; Store-bearing SIMD loops remain outside this unroller.
      [(opt.opt-unroll-body-instr-ok?
          (ir.ir-instr-vector-store
            (ir.CompilerIrValue.Var 1)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.Var 10)
            4
            (ast.AstType.I64)))
        10]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-final-function mutable-vector-func)))
        11]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view mutable-vector-out))
            6))
        12]
      ;; Three vector instructions across all sixteen mutable body copies.
      [(not
          (=
            (opt-unroll-test-count-vector-in-block
              mutable-vector-out
              (ir.compiler-ir-label "body__unroll_body"))
            48))
        13]
      ;; A base defined inside the loop cannot feed the shared pre-body Gep.
      [(not
          (opt.opt-verify-ok? (opt.opt-verify-final-function local-base-func)))
        14]
      [(not (= (ir.compiler-ir-block-list-count local-base-out) 3)) 15]
      ;; A store-bearing three-base map gets sixteen sequential gang copies.
      [(not (opt.opt-verify-ok? (opt.opt-verify-final-function map-func))) 16]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view map-out))
            6))
        17]
      [(not
          (=
            (opt-unroll-test-count-vector-in-block
              (opt.compiler-opt-global-shared-view map-out)
              (ir.compiler-ir-label "body__unroll_body"))
            64))
        18]
      [(not
          (=
            (opt-unroll-test-count-in-block
              (opt.compiler-opt-global-shared-view map-out)
              (ir.compiler-ir-label "body__unroll_body")
              true)
            16))
        19]
      [(not
          (=
            (opt-unroll-test-count-in-block
              map-out
              (ir.compiler-ir-label "body__unroll_body")
              false)
            3))
        20]
      ;; Exact duplicate bases deduplicate their group Gep. Runtime aliases
      ;; between distinct parameters are still safe because copies stay ordered.
      [(not (opt.opt-verify-ok? (opt.opt-verify-final-function alias-map-func)))
        21]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view alias-map-out))
            6))
        22]
      [(not
          (=
            (opt-unroll-test-count-in-block
              (opt.compiler-opt-global-shared-view alias-map-out)
              (ir.compiler-ir-label "body__unroll_body")
              true)
            16))
        23]
      [(not
          (=
            (opt-unroll-test-count-in-block
              alias-map-out
              (ir.compiler-ir-label "body__unroll_body")
              false)
            1))
        24]
      ;; Loop-local bases and noncanonical store indices remain rejected.
      [(not
          (opt.opt-verify-ok? (opt.opt-verify-final-function local-store-func)))
        25]
      [(not (= (ir.compiler-ir-block-list-count local-store-out) 3)) 26]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-final-function bad-store-index-func)))
        27]
      [(not (= (ir.compiler-ir-block-list-count bad-store-index-out) 3)) 28]
      [(not
          (opt.opt-unroll-simd-body-instr-ok?
            (ir.ir-instr-vector-store
              (ir.CompilerIrValue.Var 1)
              (ir.CompilerIrValue.Var 4)
              (ir.CompilerIrValue.Var 9)
              4
              (ast.AstType.I64))))
        29]
      [(opt.opt-unroll-simd-body-instr-ok?
          (ir.ir-instr-predicated-store
            (ir.CompilerIrValue.Var 1)
            (ir.CompilerIrValue.Var 4)
            (ir.CompilerIrValue.Var 9)
            (ir.CompilerIrValue.Var 6)
            4
            (ast.AstType.I64)))
        30]
      [(opt.opt-unroll-simd-body-instr-ok? (irt.instr "store_ptr %1, %9 : i64"))
        31]
      ;; The main pipeline must run this mutable-only path before register-value
      ;; SSA.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-final-function
              (opt.compiler-opt-global-shared-view pipeline-map-func))))
        32]
      ;; Later CFG cleanup may merge the generated label, but it never shrinks
      ;; the virtual-register frame allocated by the sixteen-copy rewrite.
      [(not (> (opt.opt-function-frame pipeline-map-func) 11)) 33]
      ;; The speculative pre-SSA path is store-bearing only. Store-free
      ;; reductions retain their established later-pipeline handling.
      [(not (= (opt.opt-function-frame store-required-func) 10)) 34]
      [(opt.opt-unroll-simd-body-instr-ok?
          (ir.ir-instr-predicated-load
            8
            (ir.CompilerIrValue.Var 1)
            (ir.CompilerIrValue.Var 4)
            (ir.CompilerIrValue.Bool true)
            4
            (ast.AstType.I64)))
        35]
      [else 42])))

;; --- bounds-check loop versioning self-test ------------------------------------
(define (opt-bce-version-test-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64, len=%1:i64, base=%2:i64"))

;; entry -> loop (i phi, acc phi, bounds check, acc += i, i += 1) -> exit
;; (acc merged through an exit phi). Variant 0 checks the unrelated ADD result
;; and is underivable; 1 checks i directly; 2 checks i*3; 3 checks i-2; 4
;; checks i*(-3), whose decreasing/wrapping range must remain underivable; and
;; 5 checks a strength-reduced derived phi that starts at 1 and steps by 3.
;; Variants 6-13 cover the strided variable-base forms: 6 checks base+2*i
;; (Mul form) and 7 does the same with a StorePtr body; 8 checks base+dphi
;; and 9 checks (base+dphi)+1, where dphi is a derived phi stepping by 2
;; (the shape induction lowering leaves for base+2*i); 10 adds a second,
;; underivable data check that must STAY in the fast clone (partial
;; versioning); 11 gives the strided offset INT64_MIN (rejects), 12 scales by
;; -2 (rejects), 13 scales by 0 (rejects), 14 checks base+i directly, and 15
;; gives the base an in-loop definition (rejects) -- the non-invariant-base
;; form can never prove invariance, while 14's LONE scale-1 check clears the
;; re-costed guard-economics gate (one eliminable check). Variant 16 is 14's
;; two-check twin: base+i AND base+i+1, which version through the same
;; no-division scale-1 guard. Variants 17-25 stride the counter by 8 (the
;; word-loader shape): 17 is 16's twin and versions (the guard gains the step-k
;; no-wrap condition `wrap(bound + step - 1) >= bound`), 18 is 14's lone-check
;; twin and versions under the re-costed gate, 19 checks the step-8 counter
;; directly (the plain counter case, `bound <= len`), 20 keeps the step-8
;; stride but compares against an in-loop definition -- a non-loop-invariant
;; bound still refuses -- and 21 is a THREE-member scale-1 fan (base+i, +1, +2)
;; whose guard must cost exactly what 17's two-member fan costs. Variants
;; 22-23 are the step refusals (a zero step and a non-literal one), and
;; 24-25 are the no-wrap condition's literal-bound boundary: 24's bound of
;; 100 satisfies the cap at compile time and emits no condition, while 25's
;; i64-MAX bound can never satisfy it and rejects the versioning outright.
;; Variants 26-33 cover the guard algebra and the decreasing index forms:
;; 26 checks `base - i` (the reversed-copy shape) and versions through the
;; MIRRORED conditions with no division at all; 27 gives that form's strided
;; side an i64-MIN offset, whose negation is not representable, and rejects;
;; 28 is a bare derived phi read at TWO offsets with no variable base, which
;; collapses to one derived family; 29 is a scale-2 variable-base fan with
;; kmin < 0 (`base+2i-1` and `base+2i+1`), which collapses to one quotient
;; and one extra minimum compare; 30 checks the counter against a length that
;; IS the loop bound, so the family's `bound <= len` conjunct is reflexive and
;; must not be emitted; 31 makes both the bound and the length the same
;; literal, so EVERY conjunct folds and the guard states a literal `true`;
;; 32-33 are the once-only pair, whose two signed compares merge into one
;; unsigned `seed <u bound` exactly when the bound is a container length --
;; 32 loads its bound from a length slot, 33 takes the same shape's bound from
;; a plain parameter and keeps both compares. Variants 34-35 are the word-loader
;; extremal family `base+i` and `base+i+7` on a step-8 counter: 34 checks
;; against a container length, whose guard implies the counter's no-wrap cap;
;; 35 uses an arbitrary signed length and must keep the explicit cap. 36 is
;; 34's single-point twin -- one `base + i` check against the same container
;; length -- which still takes the normal form because nothing else checks that
;; base; 37 adds a SECOND single-point family over the SAME base against a
;; second container length, which shares the signed `base >= 0` and therefore
;; keeps the signed chain.
(define (opt-bce-version-test-check-tail [variant : i64]) : ir.CompilerIrInstrSeq
  (let
    [check-length : ir.CompilerIrValue
      (if (or (= variant 34) (= variant 36) (= variant 37))
        (ir.CompilerIrValue.Var 15)
        (ir.CompilerIrValue.Var 1))]
    [after-check : ir.CompilerIrInstrSeq
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp
          6
          (ir.CompilerIrBinOp.Add)
          (ir.CompilerIrValue.Var 3)
          ;; Variants 17+ stride the counter by 8 (the word-loader shape);
          ;; 22 steps by 0 and 23 by a non-literal, both of which the shape
          ;; scan must refuse.
          (cond
            [(= variant 23) (ir.CompilerIrValue.Var 0)]
            [(= variant 22) (ir.CompilerIrValue.I64 0)]
            [(or
                (and (>= variant 17) (<= variant 25))
                (= variant 34)
                (= variant 35))
              (ir.CompilerIrValue.I64 8)]
            [else (ir.CompilerIrValue.I64 1)])
          (ast.AstType.I64))
        (ir.CompilerIrInstr.BinOp
          7
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.Var 6)
          ;; Variant 20 compares against an in-loop definition: the bound is
          ;; not loop-invariant and the shape scan must refuse. Variants
          ;; 24-25 use a LITERAL bound, which folds the no-wrap condition at
          ;; compile time (24 satisfies the cap, 25 cannot).
          (cond
            [(= variant 20) (ir.CompilerIrValue.Var 5)]
            [(or (= variant 24) (= variant 31)) (ir.CompilerIrValue.I64 100)]
            [(= variant 25) (ir.CompilerIrValue.I64 9223372036854775807)]
            ;; 32's bound is the length-slot load the entry block makes.
            [(= variant 32) (ir.CompilerIrValue.Var 15)]
            [else (ir.CompilerIrValue.Var 0)])
          (ast.AstType.Bool))
        (irt.instr "branch %7, loop, done"))]
    [check : ir.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (cond
          ;; 7 stores through the checked index.
          [(= variant 7)
            (opt-test-instrs-with-tail
              after-check
              (irt.instr "store_ptr %2, %9 : i64"))]
          ;; 10's second check is data-shaped (a product of two in-loop
          ;; values): underivable, so it must stay in the fast clone.
          [(= variant 10)
            (opt-test-instrs-with-tail
              after-check
              (ir.CompilerIrInstr.BoundsCheck
                (ir.CompilerIrValue.Var 15)
                check-length
                (ir.compiler-ir-label "bce_version_ok_data")))]
          ;; 16's second check is `base + i + 1`: a SECOND eliminable
          ;; scale-1 variable-base index, which is what clears the gate.
          ;; 17 is 16's step-8 twin.
          [(or (= variant 16) (= variant 17))
            (opt-test-instrs-with-tail
              after-check
              (ir.CompilerIrInstr.BoundsCheck
                (ir.CompilerIrValue.Var 11)
                check-length
                (ir.compiler-ir-label "bce_version_ok_second")))]
          ;; 28's second check reads the SAME derived phi two slots along, and
          ;; 29's reads the scale-2 family's upper offset: both are members of
          ;; one family and cost the extremal conditions only.
          [(or (= variant 28) (= variant 29))
            (opt-test-instrs-with-tail
              after-check
              (ir.CompilerIrInstr.BoundsCheck
                (ir.CompilerIrValue.Var 12)
                check-length
                (ir.compiler-ir-label "bce_version_ok_second")))]
          ;; 21's three-member fan (base+i, +1, +2 on a step-8 counter):
          ;; the subsumed middle check needs no condition of its own.
          [(= variant 21)
            (opt-test-instrs-with-tail
              after-check
              (irt.instr
                "bounds_check %11, %1 message \"bce_version_ok_second\"")
              (ir.CompilerIrInstr.BoundsCheck
                (ir.CompilerIrValue.Var 12)
                check-length
                (ir.compiler-ir-label "bce_version_ok_third")))]
          ;; 37's second check is the SAME index against a SECOND container
          ;; length: two single-point families over one base, which share their
          ;; `base >= 0` conjunct and therefore keep the signed chain.
          [(= variant 37)
            (opt-test-instrs-with-tail
              after-check
              (irt.instr
                "bounds_check %9, %13 message \"bce_version_ok_second\""))]
          ;; 34-35 model the endpoints of the eight-byte loader fan. Only the
          ;; length provenance differs: 34's entry loads a container length,
          ;; while 35 keeps the ordinary unconstrained parameter.
          [(or (= variant 34) (= variant 35))
            (opt-test-instrs-with-tail
              after-check
              (ir.CompilerIrInstr.BoundsCheck
                (ir.CompilerIrValue.Var 11)
                check-length
                (ir.compiler-ir-label "bce_version_ok_7")))]
          [else after-check])
        (ir.CompilerIrInstr.BoundsCheck
          (cond
            [(= variant 0) (ir.CompilerIrValue.Var 5)]
            ;; 19-20 and 22-25 check the counter itself; 21 is a fan and
            ;; takes the variable-base index like 16-18. 30-33 check the
            ;; counter too: what they vary is the LENGTH and the bound.
            [(or
                (= variant 1)
                (and (>= variant 19) (<= variant 25) (not (= variant 21)))
                (and (>= variant 30) (<= variant 33)))
              (ir.CompilerIrValue.Var 3)]
            [else (ir.CompilerIrValue.Var 9)])
          (cond
            ;; 30's length IS the loop bound, so the family's `bound <= len`
            ;; conjunct compares a value with itself.
            [(= variant 30) (ir.CompilerIrValue.Var 0)]
            ;; 31 makes it the same literal the bound is.
            [(= variant 31) (ir.CompilerIrValue.I64 100)]
            [else check-length])
          (ir.compiler-ir-label "bce_version_ok")))]
    (cond
      [(= variant 2)
        (opt-test-instrs-with-tail check (irt.instr "%9 = mul %3, 3 : i64"))]
      [(= variant 3)
        (opt-test-instrs-with-tail check (irt.instr "%9 = sub %3, 2 : i64"))]
      [(= variant 4)
        (opt-test-instrs-with-tail check (irt.instr "%9 = mul %3, -3 : i64"))]
      [(= variant 5)
        (opt-test-instrs-with-tail check (irt.instr "%10 = add %9, 3 : i64"))]
      [(or (= variant 6) (= variant 7))
        (opt-test-instrs-with-tail
          check
          (irt.instr "%11 = mul %3, 2 : i64")
          (irt.instr "%9 = add %2, %11 : i64"))]
      [(= variant 8)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%13 = add %12, 2 : i64")
          (irt.instr "%9 = add %2, %12 : i64"))]
      [(= variant 9)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%13 = add %12, 2 : i64")
          (irt.instr "%14 = add %2, %12 : i64")
          (irt.instr "%9 = add %14, 1 : i64"))]
      [(= variant 10)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%11 = mul %3, 2 : i64")
          (irt.instr "%9 = add %2, %11 : i64")
          (irt.instr "%15 = mul %9, %9 : i64"))]
      [(= variant 11)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%11 = mul %3, 2 : i64")
          (irt.instr "%16 = add %11, -9223372036854775808 : i64")
          (irt.instr "%9 = add %2, %16 : i64"))]
      [(= variant 15)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%11 = mul %3, 2 : i64")
          (irt.instr "%16 = mul %3, %3 : i64")
          (irt.instr "%9 = add %16, %11 : i64"))]
      [(= variant 14)
        (opt-test-instrs-with-tail check (irt.instr "%9 = add %2, %3 : i64"))]
      ;; 17 is 16's step-8 twin: the same two eliminable scale-1
      ;; variable-base checks on a counter striding by 8, which version
      ;; through the no-division guard plus the step-k no-wrap condition.
      [(or (= variant 16) (= variant 17))
        (opt-test-instrs-with-tail
          check
          (irt.instr "%9 = add %2, %3 : i64")
          (irt.instr "%11 = add %9, 1 : i64"))]
      ;; 18 is 14's step-8 twin: a LONE scale-1 variable-base check on a
      ;; step-8 counter still fails the two-eliminable-check economics gate.
      [(= variant 18)
        (opt-test-instrs-with-tail check (irt.instr "%9 = add %2, %3 : i64"))]
      ;; 21's three-member scale-1 variable-base fan on a step-8 counter:
      ;; base+i, base+i+1, base+i+2. The whole fan versions through ONE
      ;; extremal condition set (min-side cond A at k=0, max-side cond A
      ;; and cond B at k=2) instead of two conditions per member, so its
      ;; guard must cost exactly what 17's two-member fan costs.
      [(= variant 21)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%9 = add %2, %3 : i64")
          (irt.instr "%11 = add %9, 1 : i64")
          (irt.instr "%12 = add %9, 2 : i64"))]
      ;; The eight-byte fan's endpoints prove a step-8 counter's cap.
      [(or (= variant 34) (= variant 35))
        (opt-test-instrs-with-tail
          check
          (irt.instr "%9 = add %2, %3 : i64")
          (irt.instr "%11 = add %9, 7 : i64"))]
      [(or (= variant 12) (= variant 13))
        (opt-test-instrs-with-tail
          check
          (ir.CompilerIrInstr.BinOp
            11
            (ir.CompilerIrBinOp.Mul)
            (ir.CompilerIrValue.Var 3)
            (ir.CompilerIrValue.I64
              (if (= variant 12)
                -2
                0))
            (ast.AstType.I64))
          (irt.instr "%9 = add %2, %11 : i64"))]
      ;; 26: `base - i`, the reversed-copy index, at unit magnitude.
      [(= variant 26)
        (opt-test-instrs-with-tail check (irt.instr "%9 = sub %2, %3 : i64"))]
      ;; 27: the same shape with an i64-MIN literal on the strided side, whose
      ;; negation the descending recovery has no representable value for.
      [(= variant 27)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%11 = mul %3, 2 : i64")
          (irt.instr "%16 = add %11, -9223372036854775808 : i64")
          (irt.instr "%9 = sub %2, %16 : i64"))]
      ;; 28: a bare derived phi (init 0, step 2) read at offsets 0 and 2, with
      ;; no variable base anywhere -- the shape a strided token walker leaves.
      [(= variant 28)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%13 = add %12, 2 : i64")
          (irt.instr "%9 = add %12, 2 : i64"))]
      ;; 29: `base + 2*i - 1` and `base + 2*i + 1`, a scale-2 family whose
      ;; offset range straddles zero.
      [(= variant 29)
        (opt-test-instrs-with-tail
          check
          (irt.instr "%11 = mul %3, 2 : i64")
          (irt.instr "%10 = add %2, %11 : i64")
          (irt.instr "%9 = sub %10, 1 : i64")
          (irt.instr "%12 = add %10, 1 : i64"))]
      ;; 36 is 34's SINGLE-POINT twin: one `base + i` check against the same
      ;; container length, with no offset range. It is the shape the range
      ;; normal form deliberately declines, so it must keep the signed chain
      ;; even though its length carries the same non-negativity witness 34's
      ;; does.
      [(or (= variant 36) (= variant 37))
        (opt-test-instrs-with-tail check (irt.instr "%9 = add %2, %3 : i64"))]
      [else check])))

(define (opt-bce-version-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      ;; Variants 32-33 seed the counter from a PARAMETER rather than a
      ;; literal, so the once-only `seed >= 0 && seed < bound` pair is really
      ;; emitted, and 32 additionally derives its bound from a container's
      ;; length slot -- the provenance that makes the pair mergeable into one
      ;; unsigned compare.
      (cond
        [(or (= variant 32) (= variant 33))
          (irt.instrs
            "%14 = gep %2, 1 : i64
             %15 = load %14 : i64
             jump loop")]
        [(or (= variant 34) (= variant 36))
          (irt.instrs
            "%14 = gep %2, 1 : i64
             %15 = load %14 : i64
             jump loop")]
        ;; 37 loads TWO container lengths, so its two single-point families
        ;; check one base against two different lengths.
        [(= variant 37)
          (irt.instrs
            "%14 = gep %2, 1 : i64
             %15 = load %14 : i64
             %12 = gep %0, 1 : i64
             %13 = load %12 : i64
             jump loop")]
        [else (irt.instrs "jump loop")]))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instrs-with-tail
          (cond
            [(= variant 5)
              (opt-test-instrs-with-tail
                (opt-bce-version-test-check-tail variant)
                (irt.instr "%9 = phi [1, entry], [%10, loop] : i64")
                (irt.instr "%5 = add %4, %3 : i64"))]
            [(or (= variant 8) (= variant 9) (= variant 28))
              (opt-test-instrs-with-tail
                (opt-bce-version-test-check-tail variant)
                (irt.instr "%12 = phi [0, entry], [%13, loop] : i64")
                (irt.instr "%5 = add %4, %3 : i64"))]
            [else
              (opt-test-instrs-with-tail
                (opt-bce-version-test-check-tail variant)
                (irt.instr "%5 = add %4, %3 : i64"))])
          (ir.CompilerIrInstr.Phi
            3
            (ir.compiler-ir-phi-input-seq-prepend
              (if (or (= variant 32) (= variant 33))
                (ir.CompilerIrValue.Var 2)
                (ir.CompilerIrValue.I64
                  (if (= variant 3)
                    2
                    0)))
              (ir.compiler-ir-label "entry")
              (ir.compiler-ir-phi-input-seq-prepend
                (ir.CompilerIrValue.Var 6)
                (ir.compiler-ir-label "loop")
                (ir.compiler-ir-phi-input-seq-empty)))
            (ast.AstType.I64))
          (irt.instr "%4 = phi [0, entry], [%5, loop] : i64")))
      (irt.blocks
        "done:
           %8 = phi [%5, loop] : i64
           return %8"))))

(define (opt-bce-version-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    17
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

;; Replace the ordinary exit Phi with the reduction shape produced by scalar
;; SPMD lowering: the loop's accumulator is consumed directly in its sole exit
;; block. Versioning must materialize the merge needed by the parallel fast
;; edge instead of rejecting that otherwise-safe loop.
(define (opt-bce-version-test-direct-exit-blocks
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.CompilerIrBlockList.Nil)]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-version-test-direct-exit-blocks
        (ir.compiler-ir-block-seq-to-list seq))]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match (ir.compiler-ir-global-shared-view block)
        [(ir.CompilerIrBlock.Block label _)
          (ir.compiler-ir-block-cons
            (if (= label (ir.compiler-ir-label "done"))
              (ir.CompilerIrBlock.Block label (irt.instrs "return %5"))
              block)
            (opt-bce-version-test-direct-exit-blocks (deref rest)))])]))

(define (opt-bce-version-test-block-checks
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt.opt-bce-version-check-count
            (ir.compiler-ir-global-shared-view instrs)
            0
            (ir.compiler-ir-instr-seq-count instrs)
            0)])]))

(define (opt-bce-version-test-exit-phi-inputs
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (ir.compiler-ir-instr-seq-ref instrs 0)
            [(ir.CompilerIrInstr.Phi _ inputs _)
              (opt.opt-phi-input-count inputs)]
            [_ (- 0 1)])])]))

;; Does the named block hold a BinOp with the given opcode AND the given i64
;; literal operand? Guard-shape evidence: the step-k no-wrap condition adds
;; `step - 1` to the bound before comparing it back against the bound, so a
;; step-8 loop's guard carries an Add against 7 and a step-1 loop's does not.
(define (opt-bce-version-test-binop-op-lit-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [op : ir.CompilerIrBinOp]
  [literal : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp _ instr-op lhs rhs _)
        (if (and
          (opt.opt-binop-eq instr-op (ir.compiler-ir-global-shared-view op))
          (or
            (match lhs
              [(ir.CompilerIrValue.I64 k) (= k literal)]
              [_ false])
            (match rhs
              [(ir.CompilerIrValue.I64 k) (= k literal)]
              [_ false])))
          true
          (opt-bce-version-test-binop-op-lit-from?
            instrs
            (+ index 1)
            op
            literal))]
      [_
        (opt-bce-version-test-binop-op-lit-from? instrs (+ index 1) op literal)])))

(define (opt-bce-version-test-block-binop-op-lit?
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]
  [op : ir.CompilerIrBinOp]
  [literal : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-version-test-binop-op-lit-from? instrs 0 op literal)])]))

;; Count the BinOps with the given opcode in one block: guard-shape evidence
;; for the fan subsumption (a k-member (base, length) fan needs exactly the
;; extremal compares, not two per member).
(define (opt-bce-version-test-block-binop-count-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [op : ir.CompilerIrBinOp]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-bce-version-test-block-binop-count-from
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (ir.compiler-ir-global-shared-view op)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.BinOp _ instr-op _ _ _)
          (if (opt.opt-binop-eq instr-op op)
            (+ acc 1)
            acc)]
        [_ acc]))))

(define (opt-bce-version-test-block-binop-count
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]
  [op : ir.CompilerIrBinOp]) : i64
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-version-test-block-binop-count-from instrs 0 op 0)])]))

;; The same count restricted to one operand type: a guard conjunct's SIGNEDNESS
;; is what the merged once-only compare and the unsigned trip quotient are
;; about, and it is invisible to the opcode alone.
(define (opt-bce-version-test-block-binop-typed-count-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [op : ir.CompilerIrBinOp]
  [ty : ast.AstType]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-bce-version-test-block-binop-typed-count-from
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (ir.compiler-ir-global-shared-view op)
      (ir.compiler-ir-global-shared-view ty)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.BinOp _ instr-op _ _ instr-ty)
          (if (and
            (opt.opt-binop-eq instr-op op)
            (opt.opt-type-eq (- 0 1) instr-ty ty))
            (+ acc 1)
            acc)]
        [_ acc]))))

(define (opt-bce-version-test-block-binop-typed-count
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]
  [op : ir.CompilerIrBinOp]
  [ty : ast.AstType]) : i64
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-version-test-block-binop-typed-count-from instrs 0 op ty 0)])]))

;; --- masked index with a loop-invariant mask ---------------------------------
;;
;; Five shapes over the shared `(n, len, base)` params, where `base` plays the
;; MASK. Two drive the single-block pass, three the multi-block one; all go
;; through `opt-bce-version-function`, so what they state is the pass verdict
;; (guard block present, fast clone check-free) rather than an internal.
;;
;;   0 single-block self-loop indexing `(i * 7) & mask` -- the m3 micro shape.
;;     One unsigned conjunct, `mask <u len`, and a check-free clone.
;;   1 the same loop with BOTH bit-and operands defined in the loop: no
;;     invariant mask, so nothing derives and the loop stays alone.
;;   2 a two-block probe loop with NO canonical counter (its exit test is an
;;     equality, its latch a plain jump) whose cursor is a header phi seeded
;;     with `n & mask` and stepped with `(cursor + 1) & mask`. The counter-free
;;     shape admits it; the seed tightens to the same mask, so ONE conjunct
;;     covers the phi and the clone is check-free.
;;   3 the same probe with a loop-VARIANT mask on the latch input: no bound, no
;;     versioning.
;;   4 the same probe seeded with the bare `n` instead of `n & mask`: two
;;     conjuncts for one removed check, which the counter-free economics gate
;;     refuses.
(define (opt-bce-mask-test-binop
  [dst : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.BinOp dst op lhs rhs ty))

(define (opt-bce-mask-test-i64
  [dst : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : ir.CompilerIrInstr
  (opt-bce-mask-test-binop dst op lhs rhs (ast.AstType.I64)))

;; loop: i = phi(0, i + 1); scaled = i * 7; [variant 1: variant-mask = i + 5];
;; masked = scaled & mask; check masked; latch test i + 1 < n.
(define (opt-bce-mask-single-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump loop")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instr-seq-prepend
          (irt.instr "%3 = phi [0, entry], [%6, loop] : i64")
          (opt-test-instr-seq-prepend
            (irt.instr "%4 = mul %3, 7 : i64")
            (opt-test-instr-seq-prepend
              (irt.instr "%8 = add %3, 5 : i64")
              (opt-test-instr-seq-prepend
                (opt-bce-mask-test-i64
                  5
                  (ir.CompilerIrBinOp.BitAnd)
                  (ir.CompilerIrValue.Var 4)
                  (if (= variant 1)
                    (ir.CompilerIrValue.Var 8)
                    (ir.CompilerIrValue.Var 2)))
                (irt.instrs
                  "bounds_check %5, %1 message \"mask_single_ok\"
                   %6 = add %3, 1 : i64
                   %7 = lt %6, %0 : bool
                   branch %7, loop, exit"))))))
      (irt.blocks
        "exit:
           %10 = phi [%3, loop] : i64
           return %10"))))

;; entry (seed) -> header (cursor phi, check, equality exit test) -> latch
;; (cursor + 1 masked, jump header) -> exit.
(define (opt-bce-mask-probe-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         %4 = bit_and %0, %2 : i64
         jump header")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "header")
        (opt-test-instr-seq-prepend
          (ir.CompilerIrInstr.Phi
            5
            (ir.compiler-ir-phi-input-seq-prepend
              ;; variant 4 seeds with the bare `n`, so the phi carries TWO
              ;; distinct bounds for one removed check.
              (if (= variant 4)
                (ir.CompilerIrValue.Var 0)
                (ir.CompilerIrValue.Var 4))
              (ir.compiler-ir-label "entry")
              (ir.compiler-ir-phi-input-seq-prepend
                (ir.CompilerIrValue.Var 7)
                (ir.compiler-ir-label "latch")
                (ir.compiler-ir-phi-input-seq-empty)))
            (ast.AstType.I64))
          (irt.instrs
            "bounds_check %5, %1 message \"mask_probe_ok\"
             %9 = eq %5, 7 : i64
             branch %9, latch, exit")))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "latch")
          (opt-test-instr-seq-prepend
            (irt.instr "%6 = add %5, 1 : i64")
            (opt-test-instr-seq-prepend
              (irt.instr "%8 = add %5, 3 : i64")
              (opt-test-instr-seq-prepend
                (opt-bce-mask-test-i64
                  7
                  (ir.CompilerIrBinOp.BitAnd)
                  (ir.CompilerIrValue.Var 6)
                  ;; variant 3 masks with an in-loop value: no invariant mask.
                  (if (= variant 3)
                    (ir.CompilerIrValue.Var 8)
                    (ir.CompilerIrValue.Var 2)))
                (irt.instrs "jump header")))))
        (irt.blocks
          "exit:
             %10 = phi [%5, header] : i64
             return %10")))))

(define (opt-bce-mask-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_mask_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    24
    (if (<= variant 1)
      (opt-bce-mask-single-blocks variant)
      (opt-bce-mask-probe-blocks variant))
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mask-rewrite [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks
    (opt.opt-bce-version-function (opt-bce-mask-test-function variant))))

(define (opt-bce-mask-block-checks
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) -1]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt.opt-bce-version-check-count
            (ir.compiler-ir-global-shared-view instrs)
            0
            (ir.compiler-ir-instr-seq-count instrs)
            0)])]))

(define (opt-bce-mask-has-block?
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some _) true]))

;; Exactly one unsigned `mask <u len` conjunct in the guard block, and no other
;; comparison: the whole point of reading the bound unsigned is that it needs no
;; companion sign condition.
(define (opt-bce-mask-guard-conjuncts
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) -1]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt.opt-bce-mb-guard-compare-count instrs 0 0)])]))

(define (compiler-optimize-bce-mask-self-test) : i64
  (cond
    ;; single-block, invariant variable mask: versioned, clone check-free, and
    ;; the guard states one unsigned conjunct
    [(not (opt-bce-mask-has-block? (opt-bce-mask-rewrite 0) "loop__bce_guard"))
      1]
    [(not
        (=
          (opt-bce-mask-block-checks (opt-bce-mask-rewrite 0) "loop__bce_fast")
          0))
      2]
    [(not
        (=
          (opt-bce-mask-guard-conjuncts
            (opt-bce-mask-rewrite 0)
            "loop__bce_guard")
          1))
      3]
    ;; both operands defined in the loop: no invariant mask, no versioning
    [(opt-bce-mask-has-block? (opt-bce-mask-rewrite 1) "loop__bce_guard") 4]
    ;; the counter-free probe loop
    [(not
        (opt-bce-mask-has-block? (opt-bce-mask-rewrite 2) "header__bce_guard"))
      5]
    [(not
        (=
          (opt-bce-mask-block-checks
            (opt-bce-mask-rewrite 2)
            "header__bce_fast")
          0))
      6]
    [(not
        (=
          (opt-bce-mask-guard-conjuncts
            (opt-bce-mask-rewrite 2)
            "header__bce_guard")
          1))
      7]
    ;; loop-variant mask
    [(opt-bce-mask-has-block? (opt-bce-mask-rewrite 3) "header__bce_guard") 8]
    ;; two conjuncts for one removed check: the economics gate refuses
    [(opt-bce-mask-has-block? (opt-bce-mask-rewrite 4) "header__bce_guard") 9]
    [else 42]))

(test
  bce-version-invariant-variable-mask
  (test.assert-i64-eq
    (compiler-optimize-bce-mask-self-test)
    42
    "a masked index with a loop-invariant VARIABLE mask versions off one unsigned conjunct in both the single-block and the counter-free multi-block pass, leaving a check-free clone, while a loop-variant mask derives nothing and a two-conjunct guard for one removed check is refused on economics"))

(define (compiler-optimize-bce-version-self-test) : i64
  (let
    [versioned : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 1)))]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view versioned))]
    [unchanged : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 0)))]
    [unchanged-out : ir.CompilerIrBlockList (opt.opt-function-blocks unchanged)]
    [scaled : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 2)))]
    [scaled-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view scaled))]
    [offset : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 3)))]
    [offset-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view offset))]
    [negative-scale-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 4))))]
    [derived : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 5)))]
    [derived-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view derived))]
    [slow-unroll-shape : opt.OptUnrollMaybeShape
      (match (opt.opt-cfg-find-block
        (ir.compiler-ir-global-shared-view out)
        (ir.compiler-ir-label "loop"))
        [(opt.OptMaybeBlock.No) (opt.OptUnrollMaybeShape.No)]
        [(opt.OptMaybeBlock.Some slow-block)
          (opt.opt-unroll-block-shape
            (ir.compiler-ir-global-shared-view out)
            (ir.compiler-ir-label "entry")
            slow-block)])]
    [step8-counter : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 19)))]
    [step8-counter-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view step8-counter))]
    [noninv-bound-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 20))))]
    [zero-step-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 22))))]
    [var-step-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 23))))]
    [lit-bound : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 24)))]
    [lit-bound-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view lit-bound))]
    [max-bound-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 25))))]
    [direct-exit : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function
          (opt-bce-version-test-direct-exit-blocks
            (opt-bce-version-test-blocks 1))))]
    [direct-exit-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view direct-exit))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function versioned))) 1]
      ;; entry, guard, fast, slow loop, exit.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            5))
        2]
      ;; the fast clone dropped its check; the slow loop keeps it.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "loop"))
            1))
        4]
      ;; the exit phi gained the parallel fast-edge input.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              out
              (ir.compiler-ir-label "done"))
            2))
        5]
      ;; a non-derivable index rejects: blocks stay untouched.
      [(not (= (ir.compiler-ir-block-list-count unchanged-out) 3)) 6]
      ;; Positive scaled induction versions through the overflow-safe
      ;; quotient guard and drops the fast-path check.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function scaled))) 7]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view scaled-out))
            5))
        8]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view scaled-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        9]
      [(not
          (= (opt-count-binop-op-blocks scaled-out (ir.CompilerIrBinOp.Div)) 1))
        10]
      ;; The offset family (scale 1, offset -2) takes the scale-1 range guard:
      ;; `bound <= length - kmax` plus the raised minimum seed `seed >= 2`, with
      ;; no division anywhere in the guard (the fixture starts at 2 for i-2).
      [(not (opt.opt-verify-ok? (opt.opt-verify-function offset))) 11]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view offset-out))
            5))
        12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view offset-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        13]
      [(not
          (= (opt-count-binop-op-blocks offset-out (ir.CompilerIrBinOp.Div)) 0))
        14]
      ;; A decreasing affine expression is MIRRORED rather than refused: its
      ;; maximum index sits at the seed and its minimum at the last trip, so the
      ;; guard states `origin >= 0`, `len > origin` and `last-trip <= origin/|scale|`
      ;; (opt-bce-version-mirror-guard). Here the whole family is literal --
      ;; base 0, seed 0 -- so the origin is 0, its quotient folds, and the two
      ;; surviving conjuncts need no division at all.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view negative-scale-out))
            5))
        15]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view negative-scale-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        150]
      [(not
          (=
            (opt-count-binop-op-blocks
              negative-scale-out
              (ir.CompilerIrBinOp.Div))
            0))
        151]
      ;; Induction lowering's canonical derived phi is covered by the
      ;; trip-count quotient guard as well.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function derived))) 16]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view derived-out))
            5))
        17]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view derived-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        18]
      [(not
          (= (opt-count-binop-op-blocks derived-out (ir.CompilerIrBinOp.Div)) 1))
        19]
      ;; Keep the checked fallback compact and preserve the unroller's single
      ;; scheduling slot for hot versioned clones.
      [(match slow-unroll-shape
          [(opt.OptUnrollMaybeShape.No) false]
          [(opt.OptUnrollMaybeShape.Some _) true])
        20]
      ;; A counter striding by a positive literal other than 1 versions too
      ;; (variant 19 checks the step-8 counter directly): the counter case's
      ;; `bound <= len` reasoning is step-independent once the guard rules
      ;; out a wrapping final increment, so the guard must carry the no-wrap
      ;; add of `step - 1` onto the bound.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function step8-counter))) 21]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view step8-counter-out))
            5))
        22]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view step8-counter-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        23]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view step8-counter-out)
              (ir.compiler-ir-label "loop"))
            1))
        24]
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            step8-counter-out
            (ir.compiler-ir-label "loop__bce_guard")
            (ir.CompilerIrBinOp.Add)
            7))
        25]
      ;; A non-loop-invariant bound still refuses (variant 20): three blocks,
      ;; check intact.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view noninv-bound-out))
            3))
        26]
      [(not
          (=
            (opt-bce-version-test-block-checks
              noninv-bound-out
              (ir.compiler-ir-label "loop"))
            1))
        27]
      ;; A ZERO step (variant 22) and a NON-LITERAL step (variant 23) are
      ;; outside the admitted shape: the counter's trip range is not
      ;; [seed, bound-1] for either, so both leave the function untouched.
      [(not (= (ir.compiler-ir-block-list-count zero-step-out) 3)) 28]
      [(not (= (ir.compiler-ir-block-list-count var-step-out) 3)) 29]
      ;; A LITERAL bound folds the no-wrap condition at compile time. 100 is
      ;; far under `i64-MAX - step + 1`, so variant 24 versions with NO
      ;; no-wrap instruction in its guard...
      [(not (opt.opt-verify-ok? (opt.opt-verify-function lit-bound))) 30]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view lit-bound-out))
            5))
        31]
      [(opt-bce-version-test-block-binop-op-lit?
          lit-bound-out
          (ir.compiler-ir-label "loop__bce_guard")
          (ir.CompilerIrBinOp.Add)
          7)
        32]
      ;; ... while an i64-MAX bound can never satisfy the cap, so variant 25
      ;; rejects the versioning outright rather than emitting a guard that
      ;; always fails.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view max-bound-out))
            3))
        33]
      [(not
          (=
            (opt-bce-version-test-block-checks
              max-bound-out
              (ir.compiler-ir-label "loop"))
            1))
        34]
      ;; A direct accumulator use in the sole exit is wired through a fresh
      ;; two-input Phi so the check-free clone remains valid.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function direct-exit))) 35]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view direct-exit-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        36]
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              direct-exit-out
              (ir.compiler-ir-label "done"))
            2))
        37]
      [else 42])))

;; Full-pipeline integration: a lowered while loop with a checked array read
;; must version (rotation in iteration 1, versioning + unrolling of the fast
;; clone in iteration 2), leaving every fast-derived block check-free.
(define (opt-bce-version-while-blocks [scaled : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %3 = mov 0 : i64
         %4 = mov 0 : i64
         jump header")
    (ir.compiler-ir-block-cons
      (irt.block
        "header:
           %5 = lt %4, %0 : bool
           branch %5, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs
            (if scaled
              (irt.instr "%10 = mul %4, 3 : i64")
              (irt.instr "%10 = mov 0 : i64"))
            (ir.CompilerIrInstr.BoundsCheck
              (ir.CompilerIrValue.Var
                (if scaled
                  10
                  4))
              (ir.CompilerIrValue.Var 1)
              (ir.compiler-ir-label "bce_while_ok"))
            (ir.CompilerIrInstr.Gep
              6
              (ir.CompilerIrValue.Var 2)
              (ir.CompilerIrValue.Var
                (if scaled
                  10
                  4))
              (ast.AstType.I64))
            (irt.instr "%7 = load %6 : i64")
            (irt.instr "%8 = add %3, %7 : i64")
            (irt.instr "%3 = mov %8 : i64")
            (irt.instr "%9 = add %4, 1 : i64")
            (irt.instr "%4 = mov %9 : i64")
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header"))))
        (irt.blocks "exit:
             return %3")))))

(define (opt-bce-version-test-prefix-from?
  [label : String]
  [prefix : String]
  [index : i64]) : bool
  (if (>= index (string.string-length prefix))
    true
    (if (=
      (cast (string.string-ref label index) : i64)
      (cast (string.string-ref prefix index) : i64))
      (opt-bce-version-test-prefix-from? label prefix (+ index 1))
      false)))

(define (opt-bce-version-test-has-prefix? [label : i64] [prefix : String]) : bool
  (let
    [text : String (ir.compiler-ir-label-text label)]
    (and
      (>= (string.string-length text) (string.string-length prefix))
      (opt-bce-version-test-prefix-from? text prefix 0))))

(define (opt-bce-version-test-prefix-checks
  [blocks : ir.CompilerIrBlockList]
  [prefix : String]
  [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-version-test-prefix-checks
        (deref rest)
        (opt.compiler-opt-global-shared-view prefix)
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (if (opt-bce-version-test-has-prefix? label prefix)
              (+
                acc
                (opt.opt-bce-version-check-count
                  (ir.compiler-ir-global-shared-view instrs)
                  0
                  (ir.compiler-ir-instr-seq-count instrs)
                  0))
              acc)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-version-test-prefix-checks
        (ir.compiler-ir-block-seq-to-list seq)
        prefix
        acc)]))

(define (compiler-optimize-bce-version-pipeline-self-test) : i64
  (let
    [optimized : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "bce_version_while_fixture")
          (opt-bce-version-test-params)
          (ast.AstType.I64)
          11
          (opt-bce-version-while-blocks false)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view optimized))]
    [scaled : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "bce_version_scaled_while_fixture")
          (opt-bce-version-test-params)
          (ast.AstType.I64)
          11
          (opt-bce-version-while-blocks true)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [scaled-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view scaled))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function optimized))) 1]
      ;; the fast clone exists ...
      [(match (opt.opt-cfg-find-block
          (opt.compiler-opt-global-shared-view blocks)
          (ir.compiler-ir-label "body__bce_fast"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        2]
      ;; ... every fast-derived block (clone + its unroll copies) is
      ;; check-free ...
      [(not
          (=
            (opt-bce-version-test-prefix-checks
              (ir.compiler-ir-global-shared-view blocks)
              "body__bce_fast"
              0)
            0))
        3]
      ;; ... and the slow original keeps its per-iteration check.
      [(<
          (opt-bce-version-test-block-checks
            blocks
            (ir.compiler-ir-label "body"))
          1)
        4]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function scaled))) 5]
      [(match (opt.opt-cfg-find-block
          (opt.compiler-opt-global-shared-view scaled-blocks)
          (ir.compiler-ir-label "body__bce_fast"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        6]
      [(not
          (=
            (opt-bce-version-test-prefix-checks
              scaled-blocks
              "body__bce_fast"
              0)
            0))
        7]
      [else 42])))

;; --- strided variable-base bce-version self-tests ---------------------------------
;;
;; The `tokens[edge-base + 2*edge]` CSR idiom: the check index is an Add of a
;; loop-invariant VARIABLE base and a strided trip expression -- either a
;; literal-scale multiply of the counter (Mul form) or a derived induction
;; phi carrying the stride as its step (the form induction lowering leaves
;; behind). The guard synthesizes the derived seed and reuses the
;; positive-step quotient guard. Fixture variant 6 loads through base+2*i, 7
;; stores through it, 8 loads through base+dphi, 9 through (base+dphi)+1, 10
;; adds an underivable data check that must stay in the fast clone, and
;; 11-13 are the rejections (offset INT64_MIN, scale -2, scale 0).
(define (opt-bce-sb-test-block-stores-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-bce-sb-test-block-stores-from
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.StorePtr _ _ _) (+ acc 1)]
        [_ acc]))))

(define (opt-bce-sb-test-block-stores
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-sb-test-block-stores-from instrs 0 0)])]))

(define (compiler-optimize-bce-version-strided-self-test) : i64
  (let
    [mul-load : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 6)))]
    [mul-load-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view mul-load))]
    [mul-store : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 7)))]
    [mul-store-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view mul-store))]
    [dphi : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 8)))]
    [dphi-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view dphi))]
    [dphi-off : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 9)))]
    [dphi-off-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view dphi-off))]
    [partial : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 10)))]
    [partial-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view partial))]
    [kmin-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 11))))]
    [neg-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 12))))]
    [zero-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 13))))]
    [base-counter-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 14))))]
    [in-loop-base-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 15))))]
    [two-scale1 : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 16)))]
    [two-scale1-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view two-scale1))]
    [step8-scale1 : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 17)))]
    [step8-scale1-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view step8-scale1))]
    [step8-lone-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 18))))]
    [fan3 : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 21)))]
    [fan3-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view fan3))]
    [wide-step8 : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 34)))]
    [wide-step8-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view wide-step8))]
    [wide-step8-signed : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 35)))]
    [wide-step8-signed-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view wide-step8-signed))]
    [guard-label : i64 (ir.compiler-ir-label "loop__bce_guard")]
    (cond
      ;; scale-2 Mul-form variable-base load: versions through the
      ;; synthesized derived-seed quotient guard (one division by the step).
      [(not (opt.opt-verify-ok? (opt.opt-verify-function mul-load))) 1]
      ;; entry, guard, fast, slow loop, exit.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view mul-load-out))
            5))
        2]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view mul-load-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view mul-load-out)
              (ir.compiler-ir-label "loop"))
            1))
        4]
      [(not
          (=
            (opt-count-binop-op-blocks mul-load-out (ir.CompilerIrBinOp.Div))
            1))
        5]
      ;; the store form versions identically and keeps its (remapped) store.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function mul-store))) 6]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view mul-store-out))
            5))
        7]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view mul-store-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        8]
      [(not
          (=
            (opt-bce-sb-test-block-stores
              (ir.compiler-ir-global-shared-view mul-store-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            1))
        9]
      [(not
          (=
            (opt-bce-sb-test-block-stores
              mul-store-out
              (ir.compiler-ir-label "loop"))
            1))
        10]
      ;; the derived-phi form (induction lowering's shape) versions too.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function dphi))) 11]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view dphi-out))
            5))
        12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view dphi-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        13]
      [(not (= (opt-count-binop-op-blocks dphi-out (ir.CompilerIrBinOp.Div)) 1))
        14]
      ;; ... including a literal offset peeled above the base add.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function dphi-off))) 15]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view dphi-off-out))
            5))
        16]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view dphi-off-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        17]
      [(not
          (=
            (opt-count-binop-op-blocks dphi-off-out (ir.CompilerIrBinOp.Div))
            1))
        18]
      ;; partial versioning: the strided check leaves the fast clone, the
      ;; underivable data check STAYS (remapped); the slow loop keeps both.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function partial))) 19]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view partial-out))
            5))
        20]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view partial-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            1))
        21]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view partial-out)
              (ir.compiler-ir-label "loop"))
            2))
        22]
      [(not
          (= (opt-count-binop-op-blocks partial-out (ir.CompilerIrBinOp.Div)) 1))
        23]
      ;; an INT64_MIN strided offset rejects (nothing derives: untouched).
      [(not (= (ir.compiler-ir-block-list-count kmin-out) 3)) 24]
      ;; A NEGATIVE scale is mirrored: `base - 2*i` versions through the
      ;; decreasing guard, whose three conditions run from the origin down
      ;; instead of from the derived seed up, with ONE unsigned quotient.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view neg-out))
            5))
        25]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view neg-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        250]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view neg-out)
              (ir.compiler-ir-label "loop"))
            1))
        251]
      [(not
          (=
            (opt-bce-version-test-block-binop-typed-count
              neg-out
              guard-label
              (ir.CompilerIrBinOp.Div)
              (ast.AstType.U64))
            1))
        252]
      ;; A zero scale does not involve the counter at all and still rejects.
      [(not (= (ir.compiler-ir-block-list-count zero-out) 3)) 26]
      ;; a LONE scale-1 variable-base check clears the RE-COSTED
      ;; guard-economics gate (one eliminable check; see the re-cost note at
      ;; opt-bce-version-guard-conds, where the guard this buys came down to
      ;; ~7 instructions): entry, guard, fast, slow loop, exit, with a
      ;; check-free clone, the check kept in the slow loop, and no division.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view base-counter-out))
            5))
        27]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view base-counter-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        28]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view base-counter-out)
              (ir.compiler-ir-label "loop"))
            1))
        54]
      [(not
          (=
            (opt-count-binop-op-blocks
              base-counter-out
              (ir.CompilerIrBinOp.Div))
            0))
        55]
      ;; an in-loop base definition cannot prove invariance: untouched.
      [(not (= (ir.compiler-ir-block-list-count in-loop-base-out) 3)) 29]
      ;; TWO eliminable scale-1 variable-base checks clear the gate and
      ;; version through the no-division guard: entry, guard, fast, slow
      ;; loop, exit; the clone is check-free, the slow loop keeps both, and
      ;; no Div is emitted (the scale-1 specialization needs none, unlike
      ;; the scale > 1 quotient guard asserted above).
      [(not (opt.opt-verify-ok? (opt.opt-verify-function two-scale1))) 30]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view two-scale1-out))
            5))
        31]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view two-scale1-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        32]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view two-scale1-out)
              (ir.compiler-ir-label "loop"))
            2))
        33]
      [(not
          (=
            (opt-count-binop-op-blocks two-scale1-out (ir.CompilerIrBinOp.Div))
            0))
        34]
      ;; The step-8 twin versions identically -- the scale-1 guard's
      ;; `bound - 1` reasoning is step-independent once the no-wrap
      ;; condition rules out a wrapping final increment: check-free fast
      ;; clone, both checks kept in the slow loop, no division, and the
      ;; guard carries the no-wrap add of `step - 1` onto the bound.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function step8-scale1))) 35]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view step8-scale1-out))
            5))
        36]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view step8-scale1-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        37]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view step8-scale1-out)
              (ir.compiler-ir-label "loop"))
            2))
        38]
      [(not
          (=
            (opt-count-binop-op-blocks
              (ir.compiler-ir-global-shared-view step8-scale1-out)
              (ir.CompilerIrBinOp.Div))
            0))
        39]
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            (ir.compiler-ir-global-shared-view step8-scale1-out)
            guard-label
            (ir.CompilerIrBinOp.Add)
            7))
        40]
      ;; ... and so does its lone-check twin, under the re-costed gate: the
      ;; step-8 stride's clone is check-free too, with the slow loop keeping
      ;; the one check.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view step8-lone-out))
            5))
        41]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view step8-lone-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        53]
      [(not
          (=
            (opt-bce-version-test-block-checks
              step8-lone-out
              (ir.compiler-ir-label "loop"))
            1))
        56]
      ;; The THREE-member step-8 fan (variant 21) versions the same way, and
      ;; its guard carries only the extremal conditions: three `>=` (min-side
      ;; cond A, max-side cond A, the no-wrap compare), one `<=` (max-side
      ;; cond B) and one `<` (the seed < bound entry condition). Before fan
      ;; subsumption each member paid two conditions of its own.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function fan3))) 43]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view fan3-out))
            5))
        44]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view fan3-out)
              (ir.compiler-ir-label "loop__bce_fast"))
            0))
        45]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view fan3-out)
              (ir.compiler-ir-label "loop"))
            3))
        46]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view fan3-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))
            3))
        47]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view fan3-out)
              guard-label
              (ir.CompilerIrBinOp.Le))
            1))
        48]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view fan3-out)
              guard-label
              (ir.CompilerIrBinOp.Lt))
            1))
        49]
      ;; Subsumption, stated as the property that matters: the THREE-member
      ;; fan's guard costs exactly what the TWO-member fan's does. A
      ;; per-check guard would have paid two more conditions for the extra
      ;; member.
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view fan3-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view step8-scale1-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))))
        50]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view fan3-out)
              guard-label
              (ir.CompilerIrBinOp.Le))
            (opt-bce-version-test-block-binop-count
              step8-scale1-out
              guard-label
              (ir.CompilerIrBinOp.Le))))
        51]
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            fan3-out
            guard-label
            (ir.CompilerIrBinOp.Add)
            7))
        52]
      ;; A complete 0..7 family against a real container length already caps
      ;; the step-8 counter through its extremal range conditions, so its guard
      ;; does not re-test `bound + 7 >= bound`.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function wide-step8))) 57]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              wide-step8-out
              guard-label
              (ir.CompilerIrBinOp.Add))
            1))
        58]
      ;; The same offset span against an arbitrary signed length cannot make
      ;; that implication: retain the explicit no-wrap add/compare.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function wide-step8-signed)))
        59]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              wide-step8-signed-out
              guard-label
              (ir.CompilerIrBinOp.Add))
            2))
        60]
      [else 42])))

(test
  bce-version-strided-var-base-ir
  (test.assert-i64-eq
    (compiler-optimize-bce-version-strided-self-test)
    42
    "strided variable-base indices version through the synthesized derived-seed guard"))

;; --- guard algebra and decreasing index forms -------------------------------------
;;
;; What the guard COSTS, stated on the emitted block rather than on an internal:
;; the trip quotient's signedness (an unsigned one lowers to a single shift,
;; the signed one to five instructions), the extremal collapse of a scaled or
;; derived family, the conjuncts a compile-time decision must not emit at all,
;; and the once-only pair's merge into one unsigned compare.
(define (compiler-optimize-bce-version-guard-algebra-self-test) : i64
  (let
    [guard-label : i64 (ir.compiler-ir-label "loop__bce_guard")]
    [fast-label : i64 (ir.compiler-ir-label "loop__bce_fast")]
    [slow-label : i64 (ir.compiler-ir-label "loop")]
    [descending : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 26)))]
    [descending-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view descending))]
    [descending-wrap-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 27))))]
    [dphi-fan : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 28)))]
    [dphi-fan-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view dphi-fan))]
    [scaled-fan : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 29)))]
    [scaled-fan-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view scaled-fan))]
    [reflexive-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 30))))]
    [all-folded : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 31)))]
    [all-folded-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view all-folded))]
    [merged : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-version-test-function (opt-bce-version-test-blocks 32)))]
    [merged-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view merged))]
    [unmerged-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-version-test-function (opt-bce-version-test-blocks 33))))]
    (cond
      ;; --- decreasing index: `base - i` ---------------------------------------
      ;; The mirrored range needs NO division at a unit magnitude, and states
      ;; the three conditions the increasing guard states, read downward.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function descending))) 1]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view descending-out))
            5))
        2]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view descending-out)
              fast-label)
            0))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view descending-out)
              slow-label)
            1))
        4]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view descending-out)
              guard-label
              (ir.CompilerIrBinOp.Div))
            0))
        5]
      ;; origin >= 0, length > origin, last-trip <= origin.
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view descending-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))
            1))
        6]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view descending-out)
              guard-label
              (ir.CompilerIrBinOp.Gt))
            1))
        7]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              descending-out
              guard-label
              (ir.CompilerIrBinOp.Le))
            1))
        8]
      ;; The strided side's i64-MIN offset has no representable negation, so
      ;; the descending recovery refuses rather than wrapping into a range it
      ;; cannot state: the loop is left untouched.
      [(not (= (ir.compiler-ir-block-list-count descending-wrap-out) 3)) 9]
      ;; --- bare derived phi read at two offsets --------------------------------
      [(not (opt.opt-verify-ok? (opt.opt-verify-function dphi-fan))) 10]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view dphi-fan-out))
            5))
        11]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view dphi-fan-out)
              fast-label)
            0))
        12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view dphi-fan-out)
              slow-label)
            2))
        13]
      ;; ONE quotient for the whole family, not one per member.
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              dphi-fan-out
              guard-label
              (ir.CompilerIrBinOp.Div))
            1))
        14]
      ;; --- scale-2 family with a negative minimum offset -----------------------
      [(not (opt.opt-verify-ok? (opt.opt-verify-function scaled-fan))) 15]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view scaled-fan-out))
            5))
        16]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view scaled-fan-out)
              fast-label)
            0))
        17]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view scaled-fan-out)
              slow-label)
            2))
        18]
      ;; One quotient, and it is UNSIGNED: a power-of-two scale then lowers to
      ;; a single logical shift instead of the signed sequence's five
      ;; instructions (`mov; sar $63; and; add; sar`).
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view scaled-fan-out)
              guard-label
              (ir.CompilerIrBinOp.Div))
            1))
        19]
      [(not
          (=
            (opt-bce-version-test-block-binop-typed-count
              (ir.compiler-ir-global-shared-view scaled-fan-out)
              guard-label
              (ir.CompilerIrBinOp.Div)
              (ast.AstType.U64))
            1))
        20]
      ;; The extremal pair: cond A at BOTH ends, cond B and the quotient at the
      ;; maximum only -- four conjuncts for two members instead of six.
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view scaled-fan-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))
            2))
        21]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view scaled-fan-out)
              guard-label
              (ir.CompilerIrBinOp.Gt))
            1))
        22]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              scaled-fan-out
              guard-label
              (ir.CompilerIrBinOp.Le))
            1))
        23]
      ;; --- conjuncts a compile-time decision must not emit ---------------------
      ;; `bound <= len` where the length IS the bound: reflexive, so no compare
      ;; at all, and no identity add anywhere in the guard.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view reflexive-out))
            5))
        24]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view reflexive-out)
              fast-label)
            0))
        25]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view reflexive-out)
              guard-label
              (ir.CompilerIrBinOp.Le))
            0))
        26]
      [(opt-bce-version-test-block-binop-op-lit?
          reflexive-out
          guard-label
          (ir.CompilerIrBinOp.Add)
          0)
        27]
      ;; Every conjunct decided at compile time: the guard states a literal
      ;; `true` rather than refusing the versioning.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function all-folded))) 28]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view all-folded-out))
            5))
        29]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view all-folded-out)
              fast-label)
            0))
        30]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view all-folded-out)
              guard-label
              (ir.CompilerIrBinOp.Le))
            0))
        31]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view all-folded-out)
              guard-label
              (ir.CompilerIrBinOp.Lt))
            0))
        32]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              all-folded-out
              guard-label
              (ir.CompilerIrBinOp.Ge))
            0))
        33]
      ;; --- the once-only pair ---------------------------------------------------
      ;; A bound loaded from a container's LENGTH SLOT is provably
      ;; non-negative, which is exactly the fact that makes
      ;; `seed >= 0 && seed < bound` one unsigned compare.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function merged))) 34]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view merged-out))
            5))
        35]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view merged-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))
            0))
        36]
      [(not
          (=
            (opt-bce-version-test-block-binop-typed-count
              merged-out
              guard-label
              (ir.CompilerIrBinOp.Lt)
              (ast.AstType.U64))
            1))
        37]
      ;; The same loop with the bound taken from a plain parameter keeps both
      ;; signed compares: nothing there decides the bound's sign.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view unmerged-out))
            5))
        38]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view unmerged-out)
              guard-label
              (ir.CompilerIrBinOp.Ge))
            1))
        39]
      [(not
          (=
            (opt-bce-version-test-block-binop-typed-count
              (ir.compiler-ir-global-shared-view unmerged-out)
              guard-label
              (ir.CompilerIrBinOp.Lt)
              (ast.AstType.I64))
            1))
        40]
      [(not
          (=
            (opt-bce-version-test-block-binop-typed-count
              unmerged-out
              guard-label
              (ir.CompilerIrBinOp.Lt)
              (ast.AstType.U64))
            0))
        41]
      [else 42])))

(test
  bce-version-guard-algebra
  (test.assert-i64-eq
    (compiler-optimize-bce-version-guard-algebra-self-test)
    42
    "the versioning guard emits an unsigned trip quotient, collapses scaled and derived families to their extremal conditions, drops conjuncts it can decide at compile time, merges the once-only pair against a container length, and mirrors a decreasing index instead of refusing it"))

;; --- multi-block bce-version self-tests -------------------------------------------
;;
;; The quicksort-partition shape: a counted scan loop (body) whose body splits
;; into a swap path (then: store++) and a skip path (else) before merging back
;; into the incrementing latch (merge). `variant` mutates one detail each: 1
;; makes the swap check's index underivable (loaded from memory) -- which
;; PARTIALLY versions now (the counter check still derives, the swap check
;; stays in the fast clone) -- 2 puts a call in the swap block, 3 makes the
;; counter step +2 -- the call must leave the function untouched (its two
;; derived checks do not pay for a duplicated call site, see
;; opt-bce-mb-call-clone-min-derived; the call-carrying shape that DOES pay is
;; the opt-bce-mbcall fixture below), while the larger positive literal step
;; versions like step 1 (the guard gains the step-k no-wrap condition). Variant
;; 4 gives the header a switch terminator so cloning exercises every switch
;; edge, including the compiler trap default. Variant 5 uses explicit pending
;; total-enum provenance and must remain unversioned by the profitability gate.
;; Variants 6-9 cover late pairing; 10 lets the smaller affine value escape
;; through a phi so the paired rewrite must fail verification and roll back.
;; Variants 11-12 route the first check's index through a reinterpret cast.
;; Variant 13 uses a scaled header index (`i*3`) without the switch/pair modes.
;;
;; Frame size shared by every variant: vars 0-14 are spelled out below, so the
;; passes allocate their replacement values from 15 up.
(define opt-bce-mb-test-frame : i64
  15)

;; Variant thresholds. Every variant from 4 up terminates the header with a
;; switch, from 5 up gives that switch explicit total-enum provenance, from 6
;; up gives "then" the adjacent affine check pair, and from 11 up feeds the
;; first of those checks through a reinterpret cast.
(define (opt-bce-mb-test-switch-variant? [variant : i64]) : bool
  (and (>= variant 4) (<= variant 12)))

(define (opt-bce-mb-test-total-enum-variant? [variant : i64]) : bool
  (and (>= variant 5) (<= variant 12)))

(define (opt-bce-mb-test-pair-variant? [variant : i64]) : bool
  (and (>= variant 6) (<= variant 12)))

(define (opt-bce-mb-test-cast-variant? [variant : i64]) : bool
  (and (>= variant 11) (<= variant 12)))

;; Variants 14-15 turn the same fixture around: the counter seeds at the
;; invariant top (`Var 0`) and the latch walks it DOWN to an inclusive literal
;; floor of 0. 14 decrements, so the step's sign matches the `>=` latch and the
;; loop versions off the mirrored range; 15 keeps the increment, so the counter
;; walks AWAY from the limit it is tested against and no trip range exists.
;;
;; Variant 19 borrows 15's counter-free shape on purpose -- see the index-form
;; variants documented at `opt-bce-mb-test-header-block`.
(define (opt-bce-mb-test-descending-variant? [variant : i64]) : bool
  (or (and (>= variant 14) (<= variant 15)) (= variant 19)))

;; --- index-form variants (16-18) ----------------------------------------------
;;
;; 16 checks `base - i` with an invariant VARIABLE base, the reversed-copy shape
;;    (`postorder[post - 1 - i]`): the index's core is a var+var Sub, so the
;;    literal-coefficient recovery refuses it and the strided retry has to split
;;    it into an invariant base and a counter side whose coefficients are
;;    flipped.
;; 17 checks `3 - i` with a LITERAL base: the coefficient recovery does resolve
;;    it, to scale -1, which the quotient guard cannot state and the mirrored
;;    conditions can.
;; 18 checks a LOOP-INVARIANT index -- the walk-loop shape whose comparand is
;;    fixed for the whole loop (`rpo_num[b]`) -- from a counted loop, where the
;;    rule states the ONE unsigned conjunct the removed check itself performs.
;; 19 is 18's counter-free twin, on 15's shape (no trip range exists). It must
;;    NOT version: the removals sit on a conditional arm and fire only on the
;;    iterations that reach it, while the conjuncts are paid on every entry --
;;    the same reason the cross-array fusion stays counted-shape-only. Measured
;;    on lex_source's `ls-scan-symbol-end`, whose three hoisted `buf[start+k]`
;;    checks bought a three-conjunct entry guard: +8,804,144 (+1.84%).
(define (opt-bce-mb-test-var-base-descending-variant? [variant : i64]) : bool
  (= variant 16))

(define (opt-bce-mb-test-literal-descending-variant? [variant : i64]) : bool
  (= variant 17))

(define (opt-bce-mb-test-invariant-index-variant? [variant : i64]) : bool
  (or (= variant 18) (= variant 19)))

(define (opt-bce-mb-test-header-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs
      (ir.CompilerIrInstr.Phi
        3
        (ir.compiler-ir-phi-input-seq-prepend
          (if (opt-bce-mb-test-descending-variant? variant)
            (ir.CompilerIrValue.Var 0)
            (ir.CompilerIrValue.I64 0))
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 8)
            (ir.compiler-ir-label "merge")
            (ir.compiler-ir-phi-input-seq-empty)))
        (ast.AstType.I64))
      (irt.instr "%4 = phi [0, entry], [%7, merge] : i64")
      (cond
        [(= variant 13) (irt.instr "%14 = mul %3, 3 : i64")]
        [(opt-bce-mb-test-var-base-descending-variant? variant)
          (irt.instr "%14 = sub %2, %3 : i64")]
        [else (irt.instr "%14 = mov 0 : i64")])
      (ir.CompilerIrInstr.BoundsCheck
        (ir.CompilerIrValue.Var
          (if (or
            (= variant 13)
            (opt-bce-mb-test-var-base-descending-variant? variant))
            14
            3))
        (ir.CompilerIrValue.Var 1)
        (ir.compiler-ir-label "mb_ok0"))
      (irt.instr "%5 = lt %3, 4 : bool")
      (if (opt-bce-mb-test-switch-variant? variant)
        (if (opt-bce-mb-test-total-enum-variant? variant)
          (ir.CompilerIrInstr.TotalEnumSwitch
            (ir.CompilerIrValue.Var 5)
            0
            (ir.compiler-ir-switch-case-seq2
              (ir.CompilerIrSwitchCase.Case 0 (ir.compiler-ir-label "else"))
              (ir.CompilerIrSwitchCase.Case 1 (ir.compiler-ir-label "then")))
            (ir.compiler-ir-label "match_total_enum_default")
            (ir.compiler-ir-label-none))
          (irt.instr
            "switch %5 base 0 [0:else, 1:then] default match_total_trap"))
        (irt.instr "branch %5, then, else")))))

;; The bytecode-VM shape: the first check reads a width-64 reinterpret cast of
;; the affine value rather than the value itself. Variant 11 gives that cast no
;; other reader, so the paired rewrite strands it and must delete the def;
;; variant 12 adds a second reader, which keeps the def alive even though the
;; synthesized min index still reads the cast's source.
(define (opt-bce-mb-test-cast-then-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "then")
    (opt-test-instrs-with-tail
      (if (= variant 12)
        (irt.instrs "store_ptr %2, %11 : u64
           jump merge")
        (irt.instrs "jump merge"))
      (irt.instr "%6 = sub %4, 1 : i64")
      (irt.instr "%11 = cast %6 : i64 to u64")
      (irt.instr "bounds_check %11, %1 message \"mb_pair_ok0\"")
      (irt.instr "%13 = sub %4, 2 : i64")
      (irt.instr "bounds_check %13, %1 message \"mb_pair_ok1\""))))

;; `3 - i` off a LITERAL base: the coefficient recovery reports scale -1, which
;; the quotient guard refuses and the mirrored conditions state.
(define (opt-bce-mb-test-literal-descending-then-block) : ir.CompilerIrBlock
  (irt.block
    "then:
       %11 = mul %3, -1 : i64
       %6 = add %11, 3 : i64
       bounds_check %6, %1 message \"mb_ok1\"
       jump merge"))

;; A LOOP-INVARIANT index: the walk loop's fixed comparand, on a conditional
;; arm. Counted (18) it versions under one unsigned conjunct; counter-free (19)
;; the same shape must stay refused.
(define (opt-bce-mb-test-invariant-index-then-block) : ir.CompilerIrBlock
  (irt.block
    "then:
       bounds_check %2, %1 message \"mb_ok1\"
       %11 = mov 0 : i64
       %6 = add %4, 1 : i64
       jump merge"))

(define (opt-bce-mb-test-then-block [variant : i64]) : ir.CompilerIrBlock
  (cond
    [(opt-bce-mb-test-cast-variant? variant)
      (opt-bce-mb-test-cast-then-block variant)]
    [(opt-bce-mb-test-literal-descending-variant? variant)
      (opt-bce-mb-test-literal-descending-then-block)]
    [(opt-bce-mb-test-invariant-index-variant? variant)
      (opt-bce-mb-test-invariant-index-then-block)]
    [else (opt-bce-mb-test-plain-then-block variant)]))

(define (opt-bce-mb-test-plain-then-block [variant : i64]) : ir.CompilerIrBlock
  (if (opt-bce-mb-test-pair-variant? variant)
    ;; Adjacent affine checks on phi-1 / phi-2. Variant 6 is the positive
    ;; total-enum-dispatch case; 7 inserts a store between the checks and 8
    ;; gives the second check a different invariant length.
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "then")
      (opt-test-instrs
        (irt.instr "%6 = sub %4, 1 : i64")
        (irt.instr "bounds_check %6, %1 message \"mb_pair_ok0\"")
        (if (= variant 7)
          (irt.instr "store_ptr %2, %6 : i64")
          (irt.instr "%11 = mov %6 : i64"))
        (irt.instr "%13 = sub %4, 2 : i64")
        (ir.CompilerIrInstr.BoundsCheck
          (ir.CompilerIrValue.Var 13)
          (if (= variant 8)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.Var 1))
          (ir.compiler-ir-label "mb_pair_ok1"))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "merge"))))
    (if (= variant 1)
      ;; The underivable-but-clean partial case: check an index LOADED from
      ;; memory (data-dependent; `store+1` derives since bounded-phi+K
      ;; derivation landed), defined before the check. The counter check in
      ;; "body" still derives, so the loop partially versions and this check
      ;; STAYS in the fast clone.
      (irt.block
        "then:
           %6 = load %2 : i64
           bounds_check %6, %1 message \"mb_ok1\"
           %11 = mov 0 : i64
           jump merge")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "then")
        (opt-test-instrs
          (irt.instr "bounds_check %4, %1 message \"mb_ok1\"")
          (if (= variant 2)
            (irt.instr "%11 = call mb_callee() : i64")
            (irt.instr "%11 = mov 0 : i64"))
          (irt.instr "%6 = add %4, 1 : i64")
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "merge")))))))

(define (opt-bce-mb-test-else-block) : ir.CompilerIrBlock
  (irt.block "else:
       jump merge"))

(define (opt-bce-mb-test-merge-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "merge")
    (opt-test-instrs
      (ir.CompilerIrInstr.Phi
        7
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.Var
            (if (= variant 10)
              13
              6))
          (ir.compiler-ir-label "then")
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 4)
            (ir.compiler-ir-label "else")
            (ir.compiler-ir-phi-input-seq-empty)))
        (ast.AstType.I64))
      (ir.CompilerIrInstr.BinOp
        8
        (if (= variant 14)
          (ir.CompilerIrBinOp.Sub)
          (ir.CompilerIrBinOp.Add))
        (ir.CompilerIrValue.Var 3)
        (ir.CompilerIrValue.I64
          (if (= variant 3)
            2
            1))
        (ast.AstType.I64))
      (ir.CompilerIrInstr.BinOp
        9
        (if (opt-bce-mb-test-descending-variant? variant)
          (ir.CompilerIrBinOp.Ge)
          (ir.CompilerIrBinOp.Lt))
        (ir.CompilerIrValue.Var 8)
        (if (opt-bce-mb-test-descending-variant? variant)
          (ir.CompilerIrValue.I64 0)
          (ir.CompilerIrValue.Var 0))
        (ast.AstType.Bool))
      (irt.instr "branch %9, body, exit"))))

(define (opt-bce-mb-test-exit-block) : ir.CompilerIrBlock
  (irt.block "exit:
       %10 = phi [%7, merge] : i64
       return %10"))

(define (opt-bce-mb-test-total-trap-block [variant : i64]) : ir.CompilerIrBlock
  (let
    ;; Every marked Switch default must name a real final-arm block. The shared
    ;; verifier now checks Switch successors before SSA dominance/use facts.
    [label : i64
      (if (opt-bce-mb-test-total-enum-variant? variant)
        (ir.compiler-ir-label "match_total_enum_default")
        (ir.compiler-ir-label "match_total_trap"))]
    (ir.CompilerIrBlock.Block
      label
      (opt-test-instrs
        (ir.CompilerIrInstr.Call
          12
          cbi.compiler-builtin-id-tl-oob-abort
          (ir.CompilerIrCallArgs.Nil)
          (ast.AstType.Unit))
        (ir.CompilerIrInstr.Jump label)))))

(define (opt-bce-mb-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (if (= variant 9)
          ;; A valid single-predecessor loop preheader whose final terminator
          ;; cannot be extended in place by the late pass: the no-fact case.
          (irt.instr "switch 0 base 0 [] default body")
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "body")))))
    (ir.compiler-ir-block-cons
      (opt-bce-mb-test-header-block variant)
      (ir.compiler-ir-block-cons
        (opt-bce-mb-test-then-block variant)
        (ir.compiler-ir-block-cons
          (opt-bce-mb-test-else-block)
          (ir.compiler-ir-block-cons
            (opt-bce-mb-test-merge-block variant)
            (ir.compiler-ir-block-cons
              (opt-bce-mb-test-exit-block)
              (if (opt-bce-mb-test-switch-variant? variant)
                (ir.compiler-ir-block-cons
                  (opt-bce-mb-test-total-trap-block variant)
                  ir.CompilerIrBlockList.Nil)
                ir.CompilerIrBlockList.Nil))))))))

(define (opt-bce-mb-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    opt-bce-mb-test-frame
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mb-test-jump-block [label : i64] [target : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    label
    (opt-test-instrs (ir.CompilerIrInstr.Jump target))))

;; `pad` dead movs ahead of a forwarder's jump: the knob that sizes the chain
;; fixture against the versioner's INSTRUCTION budget without changing its
;; block count. Each mov takes its own var, counting up from `var`.
(define (opt-bce-mb-test-pad-instrs
  [pad : i64]
  [var : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (<= pad 0)
    tail
    (opt-test-instrs-with-tail
      (opt-bce-mb-test-pad-instrs (- pad 1) (+ var 1) tail)
      (ir.CompilerIrInstr.Mov var (ir.CompilerIrValue.I64 0) (ast.AstType.I64)))))

(define (opt-bce-mb-test-chain-block
  [label : i64]
  [target : i64]
  [pad : i64]
  [var : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    label
    (opt-bce-mb-test-pad-instrs
      pad
      var
      (opt-test-instrs (ir.CompilerIrInstr.Jump target)))))

;; Nine loop blocks -- ONE OVER the old eight-block cap -- reached through
;; seven forwarders, the shape an `(and a b c)` body lowers to. `pad` sets
;; each forwarder's instruction count, so the same fixture drives both sides
;; of the instruction budget: pad 1 costs 19 cloned instructions and must
;; version (block count is not the growth metric), pad 22 costs 166 and must
;; not (that IS the growth metric, 160).
(define (opt-bce-mb-test-chain-blocks [pad : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (irt.block
        "body:
           %3 = phi [0, entry], [%8, latch] : i64
           bounds_check %3, %1 message \"mb_chain_ok\"
           jump b1")
      (ir.compiler-ir-block-cons
        (opt-bce-mb-test-chain-block
          (ir.compiler-ir-label "b1")
          (ir.compiler-ir-label "b2")
          pad
          (+ 10 (* 0 pad)))
        (ir.compiler-ir-block-cons
          (opt-bce-mb-test-chain-block
            (ir.compiler-ir-label "b2")
            (ir.compiler-ir-label "b3")
            pad
            (+ 10 (* 1 pad)))
          (ir.compiler-ir-block-cons
            (opt-bce-mb-test-chain-block
              (ir.compiler-ir-label "b3")
              (ir.compiler-ir-label "b4")
              pad
              (+ 10 (* 2 pad)))
            (ir.compiler-ir-block-cons
              (opt-bce-mb-test-chain-block
                (ir.compiler-ir-label "b4")
                (ir.compiler-ir-label "b5")
                pad
                (+ 10 (* 3 pad)))
              (ir.compiler-ir-block-cons
                (opt-bce-mb-test-chain-block
                  (ir.compiler-ir-label "b5")
                  (ir.compiler-ir-label "b6")
                  pad
                  (+ 10 (* 4 pad)))
                (ir.compiler-ir-block-cons
                  (opt-bce-mb-test-chain-block
                    (ir.compiler-ir-label "b6")
                    (ir.compiler-ir-label "b7")
                    pad
                    (+ 10 (* 5 pad)))
                  (ir.compiler-ir-block-cons
                    (opt-bce-mb-test-chain-block
                      (ir.compiler-ir-label "b7")
                      (ir.compiler-ir-label "latch")
                      pad
                      (+ 10 (* 6 pad)))
                    (irt.blocks
                      "latch:
                         %8 = add %3, 1 : i64
                         %9 = lt %8, %0 : bool
                         branch %9, body, exit
                       exit:
                         return 0")))))))))))

;; Frame leaves room for the pad movs (vars 10 up); everything else the chain
;; uses lives below 10.
(define (opt-bce-mb-test-chain-function [pad : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb_chain_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    (+ 10 (* 7 pad))
    (opt-bce-mb-test-chain-blocks pad)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (compiler-optimize-bce-version-mb-self-test) : i64
  (let
    [versioned : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 0)))]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view versioned))]
    [scaled : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 13)))]
    [scaled-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view scaled))]
    [chain : ir.CompilerIrFunction
      (opt.opt-bce-version-function (opt-bce-mb-test-chain-function 1))]
    [chain-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view chain))]
    [step-two : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 3)))]
    [step-two-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view step-two))]
    [down : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 14)))]
    [down-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view down))]
    ;; Re-running the pass on its own output must find nothing: the fast
    ;; labels now exist, which is what opt-bce-mb-fast-labels-fresh? refuses on.
    [down-again-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt.compiler-opt-global-shared-view down)))]
    [wrong-way-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-mb-test-function (opt-bce-mb-test-blocks 15))))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function versioned))) 1]
      ;; entry + guard + four fast clones + four slow blocks + exit
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            11))
        2]
      ;; the fast region dropped every check ...
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        4]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "merge__bce_fast"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        5]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "body__bce_guard"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        6]
      ;; ... while the slow loop keeps both of its checks.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body"))
            1))
        7]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then"))
            1))
        8]
      ;; the exit phi gained the parallel fast-edge input.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "exit"))
            2))
        9]
      ;; The same affine recovery works when the index definition and latch
      ;; live in different blocks.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function scaled))) 10]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view scaled-out))
            11))
        11]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view scaled-out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view scaled-out)
              (ir.compiler-ir-label "body"))
            1))
        13]
      [(not
          (= (opt-count-binop-op-blocks scaled-out (ir.CompilerIrBinOp.Div)) 1))
        14]
      ;; NINE loop blocks -- over the old eight-block cap -- but only 19
      ;; cloned instructions, so the growth budget admits it and the counted
      ;; check versions. This is the and-chain counting-loop shape: block
      ;; count says "too big", instruction count says "cheaper than a
      ;; single-block body".
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chain))) 15]
      ;; entry + guard + nine fast clones + nine slow blocks + exit
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view chain-out))
            21))
        16]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view chain-out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        17]
      [(match (opt.opt-cfg-find-block
          (opt.compiler-opt-global-shared-view chain-out)
          (ir.compiler-ir-label "body__bce_guard"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        18]
      [(match (opt.opt-cfg-find-block
          (opt.compiler-opt-global-shared-view chain-out)
          (ir.compiler-ir-label "b7__bce_fast"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        19]
      ;; the slow loop is untouched and keeps its check.
      [(not
          (=
            (opt-bce-version-test-block-checks
              chain-out
              (ir.compiler-ir-label "body"))
            1))
        20]
      ;; Variant 3 strides the counter by +2: admitted now that any positive
      ;; literal step versions (the executed-trip counter values are a subset
      ;; of [seed, bound-1] for any positive step), with the guard's no-wrap
      ;; condition covering the larger increment. Both checks drop from the
      ;; fast region.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function step-two))) 21]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view step-two-out))
            11))
        22]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view step-two-out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        23]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view step-two-out)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        24]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view step-two-out)
              (ir.compiler-ir-label "body"))
            1))
        25]
      ;; The guard carries the no-wrap add of `step - 1` onto the bound.
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            step-two-out
            (ir.compiler-ir-label "body__bce_guard")
            (ir.CompilerIrBinOp.Add)
            1))
        26]
      ;; Variant 14 counts DOWN from the invariant top to an inclusive floor
      ;; of 0. The mirrored range is [0, seed+1), so the fixture versions
      ;; exactly as its ascending twin does: same block count, both checks out
      ;; of the fast region, both kept in the slow one.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function down))) 27]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view down-out))
            11))
        28]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view down-out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        29]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view down-out)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        30]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view down-out)
              (ir.compiler-ir-label "body"))
            1))
        31]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view down-out)
              (ir.compiler-ir-label "then"))
            1))
        32]
      ;; The guard exists and materializes the mirrored limit `seed + 1`; the
      ;; ascending fixture's guard has no such add (its limit is the bound as
      ;; written), so this conjunct is the mirror's signature.
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view down-out)
          (ir.compiler-ir-label "body__bce_guard"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        33]
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            down-out
            (ir.compiler-ir-label "body__bce_guard")
            (ir.CompilerIrBinOp.Add)
            1))
        34]
      [(opt-bce-version-test-block-binop-op-lit?
          out
          (ir.compiler-ir-label "body__bce_guard")
          (ir.CompilerIrBinOp.Add)
          1)
        35]
      ;; Idempotent: a second pass over the versioned function changes nothing.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view down-again-out))
            11))
        36]
      [(match (opt.opt-cfg-find-block
          down-again-out
          (ir.compiler-ir-label "body__bce_fast__bce_fast"))
          [(opt.OptMaybeBlock.No) false]
          [(opt.OptMaybeBlock.Some _) true])
        37]
      ;; Variant 15 keeps the increment under the `>=` latch: the counter walks
      ;; away from the limit it is tested against, so no range is recovered and
      ;; the function is left alone.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view wrong-way-out))
            6))
        38]
      [(match (opt.opt-cfg-find-block
          wrong-way-out
          (ir.compiler-ir-label "body__bce_guard"))
          [(opt.OptMaybeBlock.No) false]
          [(opt.OptMaybeBlock.Some _) true])
        39]
      [else 42])))

(define (opt-bce-mb-test-cloned-switch-cases-ok?
  [cases : ir.CompilerIrSwitchCaseSeq]) : bool
  (and
    (= cases.len 2)
    (match (ir.compiler-ir-switch-case-seq-ref cases 0)
      [(ir.CompilerIrSwitchCase.Case tag label)
        (and (= tag 0) (= label (ir.compiler-ir-label "else__bce_fast")))])
    (match (ir.compiler-ir-switch-case-seq-ref cases 1)
      [(ir.CompilerIrSwitchCase.Case tag label)
        (and (= tag 1) (= label (ir.compiler-ir-label "then__bce_fast")))])))

(define (opt-bce-mb-test-cloned-switch-ok? [blocks : ir.CompilerIrBlockList]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label "body__bce_fast"))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Switch index base cases default-label)
                  (and
                    (= base 0)
                    (match index
                      [(ir.CompilerIrValue.Var id) (not (= id 5))]
                      [_ false])
                    (opt-bce-mb-test-cloned-switch-cases-ok? cases)
                    ;; The no-return trap is outside the natural loop and stays
                    ;; shared; all in-loop case targets are remapped above.
                    (= default-label (ir.compiler-ir-label "match_total_trap")))]
                [_ false])))])]))

(define (compiler-optimize-bce-version-mb-switch-self-test) : i64
  (let
    [versioned : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 4)))]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view versioned))]
    [marked : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 5)))]
    [marked-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view marked))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function versioned))) 1]
      ;; Original seven blocks + guard + four fast loop blocks.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            12))
        2]
      [(not
          (opt-bce-mb-test-cloned-switch-ok?
            (ir.compiler-ir-global-shared-view out)))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        4]
      ;; A lowering-proven exhaustive enum dispatch is totalized after BCE;
      ;; cloning its high-fanout loop here would collapse vm_run allocation.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function marked))) 5]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view marked-out))
            7))
        6]
      [(opt-block-list-has-label?
          marked-out
          (ir.compiler-ir-label "body__bce_fast"))
        7]
      [else 42])))

;; --- second-exit (entry guard chain) fixture -----------------------------------
;;
;; The counter compare is NOT the header's own branch: the header tests a
;; monotone flag first and only its continuing arm reaches the block that
;; compares the counter. This is what `(while (if done false (< i n)) ...)`
;; lowers to, and what `liveness_storage/recompute!` spends its scan on. Both
;; branches leave the loop, so the shape is the pass's "second exiting branch"
;; case.
;;
;;   entry -> header(counter phi, flag phi; branch flag -> flagexit, gate)
;;            gate(c = i < n; branch c -> body, gateexit)
;;            body(bounds_check i, len; jump merge)
;;            merge(i+1; jump header)
;;   flagexit/gateexit -> exit, which READS the flag directly.
;;
;; Variants:
;;   0 the shape above;
;;   1 adds a FAR direct use of the flag in a block the exit dominates;
;;   2 makes that far use read the COUNTER instead -- a header phi the exit
;;     block itself does not read; a header phi dominates every loop block and
;;     so every predecessor edge of the wire point, and wires (BCE-WIRE);
;;   3 puts a bounds check in `gate`, on the guard chain: the compare does not
;;     cover it, so the clone must KEEP it;
;;   4 pulls `flagexit` into the loop, so the header branch is an ordinary
;;     diamond with two in-loop successors and the chain walk stops;
;;   5 gives the LATCH a second exit as well (`branch f, lexit, header`);
;;   6 makes the far use read a header def that is NOT a phi (`i + n`), which
;;     the wire point does not read either: only header phis are admitted
;;     without a read at the wire point, so the far repair refuses;
;;   7 reads the flag through a PHI INPUT: `farjoin` merges it on the edge from
;;     `fara`, an outside block the exit dominates (BCE-FARPHI);
;;   8 the same phi input, on the edge from the exit block itself;
;;   9 the same phi input from `fara`, but `flagexit` jumps to `fara` too, so
;;     the exit does not dominate the input's source and the loop refuses.
(define opt-bce-mb2-test-frame : i64
  20)

(define (opt-bce-mb2-test-far-variant? [variant : i64]) : bool
  (or
    (= variant 1)
    (= variant 2)
    (= variant 6)
    (opt-bce-mb2-test-phi-variant? variant)))

;; The variants whose far join reads the flag through a phi input.
(define (opt-bce-mb2-test-phi-variant? [variant : i64]) : bool
  (or (= variant 7) (= variant 8) (= variant 9)))

(define (opt-bce-mb2-test-entry-block) : ir.CompilerIrBlock
  (irt.block "entry:
       jump header"))

(define (opt-bce-mb2-test-header-tail [variant : i64]) : ir.CompilerIrInstrSeq
  (let
    [branch : ir.CompilerIrInstrSeq (irt.instrs "branch %4, flagexit, gate")]
    (if (= variant 6)
      ;; a header def that is not a phi: `i + n`
      (opt-test-instrs-with-tail branch (irt.instr "%10 = add %3, %0 : i64"))
      branch)))

(define (opt-bce-mb2-test-header-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "header")
    (opt-test-instrs-with-tail
      (opt-bce-mb2-test-header-tail variant)
      (irt.instr "%3 = phi [0, entry], [%8, merge] : i64")
      (irt.instr "%4 = phi [false, entry], [%9, merge] : bool"))))

(define (opt-bce-mb2-test-flagexit-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "flagexit")
    (opt-test-instrs
      (ir.CompilerIrInstr.Jump
        (cond
          ;; back inside the loop: the header branch is now a diamond
          [(= variant 4) (ir.compiler-ir-label "merge")]
          ;; past the exit block: the exit no longer dominates `fara`
          [(= variant 9) (ir.compiler-ir-label "fara")]
          [else (ir.compiler-ir-label "exit")])))))

(define (opt-bce-mb2-test-gate-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "gate")
    (let
      [tail : ir.CompilerIrInstrSeq
        (irt.instrs
          "%5 = lt %3, %0 : bool
           branch %5, body, gateexit")]
      (if (= variant 3)
        (opt-test-instrs-with-tail
          tail
          (irt.instr "bounds_check %3, %1 message \"mb2_gate_ok\""))
        tail))))

(define (opt-bce-mb2-test-gateexit-block) : ir.CompilerIrBlock
  (irt.block "gateexit:
       jump exit"))

(define (opt-bce-mb2-test-body-block) : ir.CompilerIrBlock
  (irt.block
    "body:
       bounds_check %3, %1 message \"mb2_ok0\"
       %6 = mov %3 : i64
       jump merge"))

(define (opt-bce-mb2-test-merge-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "merge")
    (opt-test-instrs
      (irt.instr "%8 = add %3, 1 : i64")
      (irt.instr "%9 = mov true : bool")
      (if (= variant 5)
        (irt.instr "branch %9, lexit, header")
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header"))))))

(define (opt-bce-mb2-test-exit-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "exit")
    (opt-test-instrs
      (ir.CompilerIrInstr.Branch
        (ir.CompilerIrValue.Var 4)
        (cond
          [(= variant 8) (ir.compiler-ir-label "farjoin")]
          [(opt-bce-mb2-test-far-variant? variant)
            (ir.compiler-ir-label "fara")]
          [else (ir.compiler-ir-label "ret1")])
        (if (opt-bce-mb2-test-far-variant? variant)
          (ir.compiler-ir-label "farb")
          (ir.compiler-ir-label "ret0"))))))

(define (opt-bce-mb2-test-farjoin-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "farjoin")
    (cond
      ;; reads the flag through a phi input on an outside edge
      [(opt-bce-mb2-test-phi-variant? variant)
        (opt-test-instrs
          (ir.CompilerIrInstr.Phi
            14
            (ir.compiler-ir-phi-input-seq-prepend
              (ir.CompilerIrValue.Var 4)
              (if (= variant 8)
                (ir.compiler-ir-label "exit")
                (ir.compiler-ir-label "fara"))
              (ir.compiler-ir-phi-input-seq-prepend
                (ir.CompilerIrValue.Bool false)
                (ir.compiler-ir-label "farb")
                (ir.compiler-ir-phi-input-seq-empty)))
            (ast.AstType.Bool))
          (irt.instr "branch %14, ret1, ret0"))]
      ;; reads a var the wire point does not read: the COUNTER (a header phi)
      ;; or the header's non-phi `i + n`
      [(or (= variant 2) (= variant 6))
        (opt-test-instrs
          (ir.CompilerIrInstr.BinOp
            13
            (ir.CompilerIrBinOp.Lt)
            (ir.CompilerIrValue.Var
              (if (= variant 2)
                3
                10))
            (ir.CompilerIrValue.Var 0)
            (ast.AstType.Bool))
          (irt.instr "branch %13, ret1, ret0"))]
      [else (irt.instrs "branch %4, ret1, ret0")])))

(define (opt-bce-mb2-test-return-block [label : String] [value : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label label)
    (opt-test-instrs
      (ir.CompilerIrInstr.Return
        (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.I64 value))))))

(define (opt-bce-mb2-test-tail-blocks [variant : i64]) : ir.CompilerIrBlockList
  (let
    [returns : ir.CompilerIrBlockList
      (ir.compiler-ir-block-cons
        (opt-bce-mb2-test-return-block "ret1" 1)
        (ir.compiler-ir-block-cons
          (opt-bce-mb2-test-return-block "ret0" 0)
          (if (= variant 5)
            (irt.blocks "lexit:
                 return 2")
            ir.CompilerIrBlockList.Nil)))]
    (if (opt-bce-mb2-test-far-variant? variant)
      (let
        [joined : ir.CompilerIrBlockList
          (ir.compiler-ir-block-cons
            (irt.block "farb:
                 jump farjoin")
            (ir.compiler-ir-block-cons
              (opt-bce-mb2-test-farjoin-block variant)
              returns))]
        ;; the exit reaches the join directly in variant 8: no `fara`
        (if (= variant 8)
          joined
          (ir.compiler-ir-block-cons
            (irt.block "fara:
                 jump farjoin")
            joined)))
      returns)))

(define (opt-bce-mb2-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-bce-mb2-test-entry-block)
    (ir.compiler-ir-block-cons
      (opt-bce-mb2-test-header-block variant)
      (ir.compiler-ir-block-cons
        (opt-bce-mb2-test-flagexit-block variant)
        (ir.compiler-ir-block-cons
          (opt-bce-mb2-test-gate-block variant)
          (ir.compiler-ir-block-cons
            (opt-bce-mb2-test-gateexit-block)
            (ir.compiler-ir-block-cons
              (opt-bce-mb2-test-body-block)
              (ir.compiler-ir-block-cons
                (opt-bce-mb2-test-merge-block variant)
                (ir.compiler-ir-block-cons
                  (opt-bce-mb2-test-exit-block variant)
                  (opt-bce-mb2-test-tail-blocks variant))))))))))

(define (opt-bce-mb2-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb2_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    opt-bce-mb2-test-frame
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mb2-test-versioned-fn [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function
    (opt-bce-mb2-test-function (opt-bce-mb2-test-blocks variant))))

(define (opt-bce-mb2-test-versioned [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks (opt-bce-mb2-test-versioned-fn variant)))

;; The versioner grows the frame, so the verify must see the function it
;; returned, not a rebuild around the fixture's original frame.
(define (opt-bce-mb2-test-verify-ok? [variant : i64]) : bool
  (opt.opt-verify-ok?
    (opt.opt-verify-function (opt-bce-mb2-test-versioned-fn variant))))

(define (opt-bce-mb2-test-versioned? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-block-list-has-label? blocks (ir.compiler-ir-label "header__bce_fast")))

;; Phis in one block.
(define (opt-bce-mb2-test-block-phis
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt.opt-unroll-phi-prefix-count instrs 0)])]))

;; The var a block's terminating Branch tests, or -1.
(define (opt-bce-mb2-test-branch-var
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              (- 0 1)
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch cond _ _)
                  (match cond
                    [(ir.CompilerIrValue.Var id) id]
                    [_ (- 0 1)])]
                [_ (- 0 1)])))])]))

;; The left operand var of the first BinOp in a block, or -1.
(define (opt-bce-mb2-test-binop-lhs-var-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp _ _ lhs _ _)
        (match lhs
          [(ir.CompilerIrValue.Var id) id]
          [_ (- 0 1)])]
      [_ (opt-bce-mb2-test-binop-lhs-var-from instrs (+ index 1))])))

(define (opt-bce-mb2-test-binop-lhs-var
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb2-test-binop-lhs-var-from instrs 0)])]))

;; The var a block's first phi reads on the edge from `pred`, or -1.
(define (opt-bce-mb2-test-phi-input-var-from
  [inputs : ir.CompilerIrPhiInputSeq]
  [index : i64]
  [pred : i64]) : i64
  (if (>= index inputs.len)
    (- 0 1)
    (let
      [input : ir.CompilerIrPhiInput
        (ir.compiler-ir-phi-input-seq-ref
          (ir.compiler-ir-global-shared-view inputs)
          index)]
      (if (= input.label pred)
        (match input.value
          [(ir.CompilerIrValue.Var id) id]
          [_ (- 0 1)])
        (opt-bce-mb2-test-phi-input-var-from inputs (+ index 1) pred)))))

(define (opt-bce-mb2-test-phi-input-var
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [pred : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (< (ir.compiler-ir-instr-seq-count instrs) 1)
            (- 0 1)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ inputs _)
                (opt-bce-mb2-test-phi-input-var-from inputs 0 pred)]
              [_ (- 0 1)]))])]))

;; A loop whose entry test short-circuits through a SECOND exiting branch
;; versions: the guard chain walk finds the counter compare one block below the
;; header, the whole loop plus its two exit stubs clone, and the exit block's
;; direct read of the flag becomes one merge phi carrying the slow value on the
;; slow edges and the clone's value on the fast ones.
(define (compiler-optimize-bce-version-mb-second-exit-self-test) : i64
  (let
    [plain : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 0)]
    [far : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 1)]
    [counter : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 2)]
    (cond
      [(not (opt-bce-mb2-test-verify-ok? 0)) 1]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view plain)))
        2]
      ;; every loop block and both exit stubs cloned
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view plain)
            (ir.compiler-ir-label "gate__bce_fast")))
        3]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view plain)
            (ir.compiler-ir-label "flagexit__bce_fast")))
        4]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view plain)
            (ir.compiler-ir-label "gateexit__bce_fast")))
        5]
      ;; the guard block sits on the preheader edge
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view plain)
            (ir.compiler-ir-label "header__bce_guard")))
        6]
      ;; the body check is gone from the clone and kept in the original
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view plain)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        7]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view plain)
              (ir.compiler-ir-label "body"))
            1))
        8]
      ;; the flag's direct outside read is wired through exactly one merge phi
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              (opt.compiler-opt-global-shared-view plain)
              (ir.compiler-ir-label "exit"))
            1))
        9]
      [(<
          (opt-bce-mb2-test-branch-var plain (ir.compiler-ir-label "exit"))
          opt-bce-mb2-test-frame)
        10]
      ;; a FAR use in a block the exit dominates reuses that same merge phi
      [(not (opt-bce-mb2-test-verify-ok? 1)) 11]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view far)))
        12]
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              (opt.compiler-opt-global-shared-view far)
              (ir.compiler-ir-label "exit"))
            1))
        13]
      [(not
          (=
            (opt-bce-mb2-test-branch-var
              (opt.compiler-opt-global-shared-view far)
              (ir.compiler-ir-label "farjoin"))
            (opt-bce-mb2-test-branch-var far (ir.compiler-ir-label "exit"))))
        14]
      ;; BCE-WIRE: a far use of a HEADER PHI the wire point does not read wires
      ;; too -- the phi dominates every loop block, so every predecessor edge
      ;; of the wire point carries it -- through a second merge phi there
      [(not (opt-bce-mb2-test-verify-ok? 2)) 15]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view counter)))
        16]
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              (opt.compiler-opt-global-shared-view counter)
              (ir.compiler-ir-label "exit"))
            2))
        17]
      [(<
          (opt-bce-mb2-test-binop-lhs-var
            counter
            (ir.compiler-ir-label "farjoin"))
          opt-bce-mb2-test-frame)
        18]
      [else 42])))

;; The boundaries of the same admission.
(define (compiler-optimize-bce-version-mb-second-exit-refusal-self-test) : i64
  (let
    [far-other : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 6)]
    [chain-check : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 3)]
    [diamond : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 4)]
    [latch-exit : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 5)]
    (cond
      ;; a far use of a var the wire point itself does not read has no proof
      ;; that the def dominates the wire point's predecessor edges -- unless it
      ;; is a header phi (the positive test); a non-phi header def is refused
      [(not (opt-bce-mb2-test-verify-ok? 6)) 1]
      [(opt-bce-mb2-test-versioned? far-other) 2]
      ;; a check ON the guard chain runs one time more than the body does, so
      ;; the compare does not cover it and the clone KEEPS it
      [(not (opt-bce-mb2-test-verify-ok? 3)) 3]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view chain-check)))
        4]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view chain-check)
              (ir.compiler-ir-label "gate__bce_fast"))
            1))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              chain-check
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        6]
      ;; two in-loop successors ahead of the compare is an ordinary diamond,
      ;; not a guard chain: the walk stops and the loop is refused
      [(not (opt-bce-mb2-test-verify-ok? 4)) 7]
      [(opt-bce-mb2-test-versioned? diamond) 8]
      ;; the latch may carry a second exit of its own
      [(not (opt-bce-mb2-test-verify-ok? 5)) 9]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view latch-exit)))
        10]
      [(not
          (=
            (opt-bce-version-test-block-checks
              latch-exit
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        11]
      [else 42])))

;; BCE-FARPHI: a loop def read by a PHI INPUT on an edge out of an outside
;; block is a far use at the end of that block. Where the wire point dominates
;; the block, the input reads the merge phi the wire point materializes -- the
;; same phi the exit's own direct read wires through -- and the loop versions.
;; The wire point may be that block itself. A source the wire point does not
;; dominate keeps the escape refusal.
(define (compiler-optimize-bce-version-mb-far-phi-input-self-test) : i64
  (let
    [dominated : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 7)]
    [at-wire : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 8)]
    [undominated : ir.CompilerIrBlockList (opt-bce-mb2-test-versioned 9)]
    (cond
      [(not (opt-bce-mb2-test-verify-ok? 7)) 1]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view dominated)))
        2]
      ;; one merge phi serves the exit's direct read and the far phi input
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              (opt.compiler-opt-global-shared-view dominated)
              (ir.compiler-ir-label "exit"))
            1))
        3]
      [(<
          (opt-bce-mb2-test-phi-input-var
            (opt.compiler-opt-global-shared-view dominated)
            (ir.compiler-ir-label "farjoin")
            (ir.compiler-ir-label "fara"))
          opt-bce-mb2-test-frame)
        4]
      [(not
          (=
            (opt-bce-mb2-test-phi-input-var
              (opt.compiler-opt-global-shared-view dominated)
              (ir.compiler-ir-label "farjoin")
              (ir.compiler-ir-label "fara"))
            (opt-bce-mb2-test-branch-var
              dominated
              (ir.compiler-ir-label "exit"))))
        5]
      ;; the input's source may be the wire point itself
      [(not (opt-bce-mb2-test-verify-ok? 8)) 6]
      [(not
          (opt-bce-mb2-test-versioned?
            (opt.compiler-opt-global-shared-view at-wire)))
        7]
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              (opt.compiler-opt-global-shared-view at-wire)
              (ir.compiler-ir-label "exit"))
            1))
        8]
      [(not
          (=
            (opt-bce-mb2-test-phi-input-var
              (opt.compiler-opt-global-shared-view at-wire)
              (ir.compiler-ir-label "farjoin")
              (ir.compiler-ir-label "exit"))
            (opt-bce-mb2-test-branch-var at-wire (ir.compiler-ir-label "exit"))))
        9]
      ;; a source the wire point does not dominate: refused
      [(not (opt-bce-mb2-test-verify-ok? 9)) 10]
      [(opt-bce-mb2-test-versioned? undominated) 11]
      [else 42])))

;; --- pure direct-call dedupe (CSE-CALL) ---------------------------------------
;;
;; Two calls to a summarized write-free callee with the same argument, the
;; second reached from the first along fully visited blocks with no memory
;; write between, collapse into one call and a copy. Layout:
;;
;;   entry: %2 = pure(x); %3 = mov x; jump b1
;;   b1:    %4 = pure(%3)        <- copy of %2 (argument through the Mov)
;;          %5 = impure(x)       <- a call that may write: the table is dropped
;;          %6 = pure(x); jump b2
;;   b2:    %7 = pure(x)         <- copy of %6 (single predecessor b1)
;;          store_ptr y, x       <- a store drops the table
;;          %8 = pure(x); %9 = x < y; branch %9, b3, b4
;;   b3:    %10 = pure(x)        <- copy of %8
;;   b4:    %11 = pure(y)        <- a different argument: kept
;;   b5:    %12 = pure(x)        <- both paths retain %8: copy of %8
;;          unitpure(x) twice    <- unit-typed: never a candidate
(define opt-pcd-test-frame : i64
  32)

(define (opt-pcd-test-pure) : i64
  (opt-test-symbol "pcd_pure"))

(define (opt-pcd-test-unit-pure) : i64
  (opt-test-symbol "pcd_unit_pure"))

(define (opt-pcd-test-impure) : i64
  (opt-test-symbol "pcd_impure"))

(define (opt-pcd-test-call [dst : i64] [callee : i64] [arg : i64]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Call
    dst
    callee
    (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var arg))
    (ast.AstType.I64)))

(define (opt-pcd-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = call pcd_pure(%0) : i64
       %3 = mov %0 : i64
       jump b1
     b1:
       %4 = call pcd_pure(%3) : i64
       %5 = call pcd_impure(%0) : i64
       %6 = call pcd_pure(%0) : i64
       jump b2
     b2:
       %7 = call pcd_pure(%0) : i64
       store_ptr %1, %0 : i64
       %8 = call pcd_pure(%0) : i64
       %9 = lt %0, %1 : bool
       branch %9, b3, b4
     b3:
       %10 = call pcd_pure(%0) : i64
       jump b5
     b4:
       %11 = call pcd_pure(%1) : i64
       jump b5
     b5:
       %12 = call pcd_pure(%0) : i64
       %13 = call pcd_unit_pure(%0) : unit
       %14 = call pcd_unit_pure(%0) : unit
       return %12"))

(define (opt-pcd-test-params) : ir.CompilerIrParamSeq
  (irt.params "x=%0:i64, y=%1:i64"))

(define (opt-pcd-test-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "pcd_fixture")
    (opt-pcd-test-params)
    (ast.AstType.I64)
    opt-pcd-test-frame
    (opt-pcd-test-blocks)
    ir.CompilerIrFunctionAbi.Ordinary))

;; The call-memory rows: `pure` and `unitpure` write nothing; `impure` stores a
;; global. With `pure-writes?` the pure callee is given a global store too.
(define (opt-pcd-test-map [pure-writes? : bool]) : opt_i64_i64_map.Map
  (let
    [out : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-pcd-test-pure)
        (if pure-writes?
          (opt.opt-call-memory-summary-add-global 0)
          0))
      (opt_i64_i64_map.insert-ref! (&mut out) (opt-pcd-test-unit-pure) 0)
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-pcd-test-impure)
        (opt.opt-call-memory-summary-add-global 0))
      out)))

(define (opt-pcd-test-run [pure-writes? : bool]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks
    (let
      [call-memory (opt-pcd-test-map pure-writes?)]
      (opt.opt-pure-call-dedupe-function call-memory (opt-pcd-test-function)))))

;; Pre-SSA shapes, which the inline stage hands the pass:
;;
;;   entry: %2 = pure(x); %3 = mov x; %3 = mov y       <- %3 redefined
;;          %4 = pure(%3)                              <- kept: %3 is not one value
;;          %5 = pure(x); %5 = mov y                   <- result redefined: kept,
;;                                                        not recorded, table intact
;;          %6 = pure(x)                               <- copy of %2
;;          %7 = agg(x); %8 = agg(x)                   <- kept: a struct result
;;          return %6
(define (opt-pcd-test-agg) : i64
  (opt-test-symbol "pcd_agg"))

(define (opt-pcd-test-agg-call [dst : i64] [arg : i64]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Call
    dst
    (opt-pcd-test-agg)
    (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var arg))
    (ast.AstType.Struct 7)))

(define (opt-pcd-test-redef-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-pcd-test-call 2 (opt-pcd-test-pure) 0)
        (ir.CompilerIrInstr.Mov 3 (ir.CompilerIrValue.Var 0) (ast.AstType.I64))
        (ir.CompilerIrInstr.Mov 3 (ir.CompilerIrValue.Var 1) (ast.AstType.I64))
        (opt-pcd-test-call 4 (opt-pcd-test-pure) 3)
        (opt-pcd-test-call 5 (opt-pcd-test-pure) 0)
        (ir.CompilerIrInstr.Mov 5 (ir.CompilerIrValue.Var 1) (ast.AstType.I64))
        (opt-pcd-test-call 6 (opt-pcd-test-pure) 0)
        (opt-pcd-test-agg-call 7 0)
        (opt-pcd-test-agg-call 8 0)
        (irt.instr "return %6")))
    ir.CompilerIrBlockList.Nil))

(define (opt-pcd-test-redef-run) : ir.CompilerIrBlockList
  (let
    [map : opt_i64_i64_map.Map (opt-pcd-test-map false)]
    [_agg : unit (opt_i64_i64_map.insert-ref! (&mut map) (opt-pcd-test-agg) 0)]
    (opt.opt-function-blocks
      (opt.opt-pure-call-dedupe-function
        map
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "pcd_redef_fixture")
          (opt-pcd-test-params)
          (ast.AstType.I64)
          opt-pcd-test-frame
          (opt-pcd-test-redef-blocks)
          ir.CompilerIrFunctionAbi.Ordinary)))))

;; Is instruction `index` of block `label` `Mov dst, %src`?
(define (opt-pcd-test-mov-at?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [index : i64]
  [dst : i64]
  [src : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Mov d s _)
              (and
                (= d dst)
                (match s
                  [(ir.CompilerIrValue.Var v) (= v src)]
                  [_ false]))]
            [_ false])])]))

;; Refusal must retain the call itself, regardless of which wrong result a
;; broken join might choose to substitute.
(define (opt-pcd-test-call-at?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [index : i64]
  [dst : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Call d _ _ _) (= d dst)]
            [_ false])])]))

;; Direct calls to `callee` in one block.
(define (opt-pcd-test-calls-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [callee : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Call _ name _ _)
          (if (ir.compiler-ir-symbol-eq? name callee)
            1
            0)]
        [_ 0])
      (opt-pcd-test-calls-from instrs (+ index 1) callee))))

(define (opt-pcd-test-calls [blocks : ir.CompilerIrBlockList] [callee : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-pcd-test-calls (ir.compiler-ir-block-seq-to-list seq) callee)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (+
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (opt-pcd-test-calls-from instrs 0 callee)])
        (opt-pcd-test-calls (deref rest) callee))]))

(define (compiler-optimize-pure-call-dedupe-self-test) : i64
  (let
    [out : ir.CompilerIrBlockList (opt-pcd-test-run false)]
    [same : ir.CompilerIrBlockList (opt-pcd-test-run true)]
    [redef : ir.CompilerIrBlockList (opt-pcd-test-redef-run)]
    (cond
      ;; the copy-argument duplicate, the post-impure duplicate in the single-
      ;; predecessor successor, and the one in the branch arm are copies
      [(not
          (opt-pcd-test-mov-at?
            (ir.compiler-ir-global-shared-view out)
            (ir.compiler-ir-label "b1")
            0
            4
            2))
        1]
      [(not
          (opt-pcd-test-mov-at?
            (ir.compiler-ir-global-shared-view out)
            (ir.compiler-ir-label "b2")
            0
            7
            6))
        2]
      [(not
          (opt-pcd-test-mov-at?
            (ir.compiler-ir-global-shared-view out)
            (ir.compiler-ir-label "b3")
            0
            10
            8))
        3]
      ;; the first, the one after the impure call, the one after the store,
      ;; and the other-argument one stay: four of eight; the join reuses %8
      [(not
          (=
            (opt-pcd-test-calls
              (ir.compiler-ir-global-shared-view out)
              (opt-pcd-test-pure))
            4))
        4]
      ;; unit-typed calls are never candidates
      [(not
          (=
            (opt-pcd-test-calls
              (ir.compiler-ir-global-shared-view out)
              (opt-pcd-test-unit-pure))
            2))
        5]
      ;; the impure call is untouched
      [(not
          (=
            (opt-pcd-test-calls
              (ir.compiler-ir-global-shared-view out)
              (opt-pcd-test-impure))
            1))
        6]
      ;; a callee that writes a global is no candidate: every call stays
      [(not (= (opt-pcd-test-calls same (opt-pcd-test-pure)) 8)) 7]
      ;; pre-SSA: a redefined argument var and a redefined result var keep
      ;; their calls (%4, %5) without disturbing the table, so %6 copies %2;
      ;; an aggregate result keeps both calls
      [(not
          (=
            (opt-pcd-test-calls
              (ir.compiler-ir-global-shared-view redef)
              (opt-pcd-test-pure))
            3))
        8]
      [(not
          (opt-pcd-test-mov-at?
            (ir.compiler-ir-global-shared-view redef)
            (ir.compiler-ir-label "entry")
            6
            6
            2))
        9]
      [(not (= (opt-pcd-test-calls redef (opt-pcd-test-agg)) 2)) 10]
      [(not (opt-pcd-test-mov-at? out (ir.compiler-ir-label "b5") 0 12 8)) 11]
      [else 42])))

;; Join variants use the same call/branch fixture above. A write or unknown
;; call on just one arm invalidates the shared result. Re-executing pure(x)
;; after that write produces a different result definition, so it cannot be
;; merged with the other arm's earlier call. A predecessor laid out after the
;; join, including a back edge, is deliberately unknown to this one-pass walk.
(define (opt-pcd-join-test-block [block : ir.CompilerIrBlock] [variant : i64]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (if (not (= label (ir.compiler-ir-label "b3")))
        (if (and (>= variant 6) (= label (ir.compiler-ir-label "b2")))
          (let
            [changed : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
            (begin
              (ir.compiler-ir-instr-seq-set!
                (ir.compiler-ir-global-shared-view changed)
                2
                (irt.instr "%8 = mov 0 : i64"))
              (ir.CompilerIrBlock.Block label changed)))
          (if (and (= variant 7) (= label (ir.compiler-ir-label "b4")))
            (ir.CompilerIrBlock.Block
              label
              (irt.instrs
                "%11 = call pcd_pure(%0) : i64
                 jump b5"))
            (ir.CompilerIrBlock.Block label instrs)))
        (let
          [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
          [builder : ir.CompilerIrInstrBuilder
            (ir.compiler-ir-instr-builder-with-capacity 5)]
          (begin
            (ir.compiler-ir-instr-builder-append-seq-range!
              (&mut builder)
              instrs
              0
              (- count 1))
            (when
              (or (= variant 1) (= variant 3))
              (ir.compiler-ir-instr-builder-push!
                (&mut builder)
                (irt.instr "store_ptr %1, %0 : i64")))
            (when
              (= variant 2)
              (ir.compiler-ir-instr-builder-push!
                (&mut builder)
                (opt-pcd-test-call 17 (opt-pcd-test-impure) 0)))
            (when
              (= variant 3)
              (ir.compiler-ir-instr-builder-push!
                (&mut builder)
                (opt-pcd-test-call 17 (opt-pcd-test-pure) 0)))
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Jump
                (ir.compiler-ir-label
                  (if (= variant 5)
                    "b2"
                    "b5"))))
            (ir.CompilerIrBlock.Block
              label
              (ir.compiler-ir-instr-builder-to-seq builder)))))]))

(define (opt-pcd-join-test-run [variant : i64]) : ir.CompilerIrBlockList
  (let
    [index : opt.OptCfgIndex (opt.opt-cfg-index-build (opt-pcd-test-blocks))]
    [builder : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity 6)]
    [cursor : i64 0]
    (begin
      (while (< cursor 6)
        (let
          [at : i64
            (if (and (= variant 4) (>= cursor 4))
              (- 9 cursor)
              cursor)]
          (begin
            (ir.compiler-ir-block-builder-push!
              (&mut builder)
              (opt-pcd-join-test-block
                (opt.compiler-opt-global-array-element-shared-view
                  index.blocks
                  at)
                variant))
            (set! cursor (+ cursor 1)))))
      (opt.opt-function-blocks
        (let
          [call-memory (opt-pcd-test-map false)]
          (opt.opt-pure-call-dedupe-function
            call-memory
            (ir.CompilerIrFunction.Function
              (opt-test-symbol "pcd_join_fixture")
              (opt-pcd-test-params)
              (ast.AstType.I64)
              opt-pcd-test-frame
              (ir.compiler-ir-block-builder-to-list builder)
              ir.CompilerIrFunctionAbi.Ordinary)))))))

(cfg
  test
  (test
    pure-call-join-requires-the-same-result-on-every-path
    (let
      [variant : i64 0]
      (while (< variant 8)
        (let
          [out : ir.CompilerIrBlockList (opt-pcd-join-test-run variant)]
          (begin
            (if (= variant 0)
              (test.assert-true
                (opt-pcd-test-mov-at? out (ir.compiler-ir-label "b5") 0 12 8)
                "the write-free, fully visited diamond retains the result")
              (test.assert-true
                (opt-pcd-test-call-at?
                  out
                  (ir.compiler-ir-label
                    (if (= variant 5)
                      "b2"
                      "b5"))
                  0
                  (if (= variant 5)
                    7
                    12))
                "a refused join must retain the original call"))
            (set! variant (+ variant 1))))))))

(define (opt-pcd-join-test-table [start : i64] [count : i64]) : opt.OptPureCallTable
  (let
    [table : opt.OptPureCallTable (opt.OptPureCallTable.Nil)]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set!
            table
            (opt.OptPureCallTable.Cons
              (opt.OptPureCallEntry
                (opt-pcd-test-pure)
                (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var 0))
                (+ start i))
              (box table)))
          (set! i (+ i 1))))
      table)))

(test
  pure-call-join-work-bound
  (let
    [table : opt.OptPureCallTable
      (opt.opt-pure-call-table-intersect
        (opt-pcd-join-test-table 0 70)
        (opt-pcd-join-test-table 0 70))]
    [expected : i64 69]
    [done : bool false]
    (begin
      (while (not done)
        (match table
          [(opt.OptPureCallTable.Nil) (set! done true)]
          [(opt.OptPureCallTable.Cons entry rest)
            (begin
              (test.assert-i64-eq
                entry.dst
                expected
                "the bounded intersection preserves available-result order")
              (set! expected (- expected 1))
              (set! table (deref rest)))]))
      (test.assert-i64-eq expected 5 "only the most recent 64 entries survive")
      (test.assert-true
        (opt.opt-pure-call-sites-empty?
          (opt.opt-pure-call-table-intersect
            (opt-pcd-join-test-table 0 1)
            (opt-pcd-join-test-table 0 70)))
        "the other predecessor's membership walk also stops at its bound")
      (test.assert-true
        (opt.opt-pure-call-sites-empty?
          (opt.opt-pure-call-table-intersect
            (opt-pcd-join-test-table 0 70)
            (opt-pcd-join-test-table 0 1)))
        "the left walk cannot reach a result beyond its bound")
      (test.assert-true
        (not
          (opt.opt-pure-call-sites-empty?
            (opt.opt-pure-call-table-intersect
              (opt-pcd-join-test-table 6 1)
              (opt-pcd-join-test-table 0 70))))
        "the last admitted membership position still survives"))))

;; --- merged-body exit-join versioning -----------------------------------------
;;
;; The shape INLINING leaves behind, and the reason a loop that versions
;; standalone refused once absorbed. Standalone, the loop's exit arms fan into
;; the callee's own exit block and THAT block reads the loop's result, which the
;; direct-use wiring handles (the `mb2` fixture above). Absorbed, the callee's
;; exit block becomes a jump-only forwarder into the SITE's continuation, and
;; the continuation's phi reads the result on the forwarder's edge -- so the
;; escape test saw a loop def read on a non-loop edge and refused the whole
;; loop, with nothing about the loop itself having changed. `it-slice-eq?`
;; absorbed into `it-intern-slice` is the measured case.
;;
;; Layout (variant 0): `entry` branches to the loop's dedicated preheader or to
;; `calt`, the absorbed callee's early-out arm; the loop's two exits `gexit`
;; (flag) and `hexit` (counter compare) fan into `cjoin`, the callee's exit
;; block; `cjoin` and `calt` both jump to `cont`, whose phi merges the flag with
;; the early-out's literal.
;;
;; Variants:
;;   0 the merged body: `cjoin` is a pure join of the loop's exits and versions;
;;   1 the header exits STRAIGHT to `cjoin`, so a loop edge reaches the join --
;;     the ordinary exit shape, deliberately not admitted here;
;;   2 `cjoin` carries a BoundsCheck, so it is not clonable as a forwarder;
;;   3 the flag arm `gexit` carries a BoundsCheck, so one of the join's
;;     predecessors is not clonable as a forwarder.
(define opt-bce-mb3-test-frame : i64
  24)

(define (opt-bce-mb3-test-entry-block) : ir.CompilerIrBlock
  (irt.block "entry:
       %10 = lt 0, %0 : bool
       branch %10, pre, calt"))

(define (opt-bce-mb3-test-header-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "header")
    (opt-test-instrs
      (irt.instr "%3 = phi [0, pre], [%8, merge] : i64")
      (irt.instr "%4 = phi [true, pre], [%9, merge] : bool")
      (irt.instr "%5 = lt %3, %0 : bool")
      (ir.CompilerIrInstr.Branch
        (ir.CompilerIrValue.Var 5)
        (ir.compiler-ir-label "gate")
        (if (= variant 1)
          ;; a LOOP edge straight into the join
          (ir.compiler-ir-label "cjoin")
          (ir.compiler-ir-label "hexit"))))))

(define (opt-bce-mb3-test-gexit-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "gexit")
    (let
      [tail : ir.CompilerIrInstrSeq (irt.instrs "jump cjoin")]
      (if (= variant 3)
        (irt.instrs
          "bounds_check %2, %1 message \"mb3_gexit_ok\"
           jump cjoin")
        tail))))

(define (opt-bce-mb3-test-gate-block) : ir.CompilerIrBlock
  (irt.block "gate:
       branch %4, body, gexit"))

(define (opt-bce-mb3-test-body-block) : ir.CompilerIrBlock
  (irt.block
    "body:
       bounds_check %3, %1 message \"mb3_ok0\"
       %6 = mov %3 : i64
       jump merge"))

(define (opt-bce-mb3-test-merge-block) : ir.CompilerIrBlock
  (irt.block
    "merge:
       %8 = add %3, 1 : i64
       %9 = mov true : bool
       jump header"))

(define (opt-bce-mb3-test-join-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "cjoin")
    (let
      [tail : ir.CompilerIrInstrSeq (irt.instrs "jump cont")]
      (if (= variant 2)
        (irt.instrs
          "bounds_check %2, %1 message \"mb3_join_ok\"
           jump cont")
        tail))))

(define (opt-bce-mb3-test-cont-block) : ir.CompilerIrBlock
  (irt.block
    "cont:
       %11 = phi [%4, cjoin], [false, calt] : bool
       branch %11, ret1, ret0"))

(define (opt-bce-mb3-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-bce-mb3-test-entry-block)
    (ir.compiler-ir-block-cons
      (irt.block "pre:
           jump header")
      (ir.compiler-ir-block-cons
        (opt-bce-mb3-test-header-block variant)
        (ir.compiler-ir-block-cons
          (opt-bce-mb3-test-gate-block)
          (ir.compiler-ir-block-cons
            (opt-bce-mb3-test-body-block)
            (ir.compiler-ir-block-cons
              (opt-bce-mb3-test-merge-block)
              (ir.compiler-ir-block-cons
                (opt-bce-mb3-test-gexit-block variant)
                (opt-bce-mb3-test-tail-blocks variant)))))))))

(define (opt-bce-mb3-test-tail-blocks [variant : i64]) : ir.CompilerIrBlockList
  (let
    [rest : ir.CompilerIrBlockList
      (ir.compiler-ir-block-cons
        (opt-bce-mb3-test-join-block variant)
        (ir.compiler-ir-block-cons
          (irt.block "calt:
               jump cont")
          (ir.compiler-ir-block-cons
            (opt-bce-mb3-test-cont-block)
            (irt.blocks
              "ret1:
                 return 1
               ret0:
                 return 0"))))]
    (if (= variant 1)
      rest
      (ir.compiler-ir-block-cons
        (irt.block "hexit:
             jump cjoin")
        rest))))

(define (opt-bce-mb3-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb3_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    opt-bce-mb3-test-frame
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mb3-test-versioned-fn [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function
    (opt-bce-mb3-test-function (opt-bce-mb3-test-blocks variant))))

(define (opt-bce-mb3-test-versioned [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks (opt-bce-mb3-test-versioned-fn variant)))

(define (opt-bce-mb3-test-verify-ok? [variant : i64]) : bool
  (opt.opt-verify-ok?
    (opt.opt-verify-function (opt-bce-mb3-test-versioned-fn variant))))

(define (opt-bce-mb3-test-versioned? [variant : i64]) : bool
  (opt-block-list-has-label?
    (opt-bce-mb3-test-versioned variant)
    (ir.compiler-ir-label "header__bce_fast")))

;; Running the versioner on its own output must change nothing: the generated
;; fast labels are what make the loop ineligible to both scans.
(define (opt-bce-mb3-test-refixed-blocks [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks
    (opt.opt-bce-version-function (opt-bce-mb3-test-versioned-fn variant))))

(define (compiler-optimize-bce-version-mb-merged-body-self-test) : i64
  (let
    [merged : ir.CompilerIrBlockList (opt-bce-mb3-test-versioned 0)]
    (cond
      [(not (opt-bce-mb3-test-verify-ok? 0)) 1]
      [(not (opt-bce-mb3-test-versioned? 0)) 2]
      ;; the guard sits on the preheader edge and the whole loop clones
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged)
            (ir.compiler-ir-label "header__bce_guard")))
        3]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged)
            (ir.compiler-ir-label "gate__bce_fast")))
        4]
      ;; both exit arms AND the callee's exit join joined the clone group
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged)
            (ir.compiler-ir-label "gexit__bce_fast")))
        5]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged)
            (ir.compiler-ir-label "hexit__bce_fast")))
        6]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged)
            (ir.compiler-ir-label "cjoin__bce_fast")))
        7]
      ;; check-free clone, checked original
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view merged)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        8]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view merged)
              (ir.compiler-ir-label "body"))
            1))
        9]
      ;; the continuation's phi gained exactly one parallel fast-edge input
      ;; (cjoin, calt, cjoin__bce_fast) and stayed a single phi
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              (opt.compiler-opt-global-shared-view merged)
              (ir.compiler-ir-label "cont"))
            1))
        10]
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              (opt.compiler-opt-global-shared-view merged)
              (ir.compiler-ir-label "cont"))
            3))
        11]
      ;; idempotent: a second run is a no-op
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (opt-bce-mb3-test-refixed-blocks 0))
            (ir.compiler-ir-block-list-count merged)))
        12]
      [else 42])))

;; The boundaries of the exit-join admission.
(define (compiler-optimize-bce-version-mb-merged-body-refusal-self-test) : i64
  (cond
    ;; a loop edge into the join is the ordinary exit shape, not an absorbed
    ;; continuation: not admitted here
    [(not (opt-bce-mb3-test-verify-ok? 1)) 1]
    [(opt-bce-mb3-test-versioned? 1) 2]
    ;; a join carrying a check is not clonable as a forwarder
    [(not (opt-bce-mb3-test-verify-ok? 2)) 3]
    [(opt-bce-mb3-test-versioned? 2) 4]
    ;; a join predecessor that is not clonable as a forwarder refuses
    [(not (opt-bce-mb3-test-verify-ok? 3)) 5]
    [(opt-bce-mb3-test-versioned? 3) 6]
    [else 42]))

;; --- cross-array check-domain fusion ------------------------------------------
;;
;; A counted multi-block loop walking THREE arrays through one opaque index.
;; `body` (the header) loads `v = mem[i]` under the counter check and branches
;; on the safe-accessor sentinel `v >= 0`. Its true arm `anchor` checks
;; `v < lenA`; the dominated arm `then` uses the same `v` against `lenB` and
;; `lenC`. Only the anchor bounds `v` -- it is a loaded value, so no trip-range
;; derivation reaches it -- and the two dominated checks derive from it under
;; the guard conjuncts `lenA <=u lenB` and `lenA <=u lenC`, which is exactly the
;; fusion rule. The fused checks must NOT feed the guard-dominated floor folder:
;; their proof relies on the earlier sentinel and using them to delete it would
;; be circular.
;;
;; Variants:
;;   0 the arm READS through the covered index;
;;   1 the arm indexes an ESCAPING value instead -- a second load nothing has
;;     bounded -- so its checks have no anchor and must be kept;
;;   2 the arm STORES through the covered index (the covered-store case: a
;;     store's check constrains its INDEX, so it fuses exactly like a read).
;;
;; Vars: 0-4 params (n, lenA, lenB, lenC, mem), 5 the counter phi, 6-7 and 10
;; the header, 11-16 the arm, 17-18 the latch.
(define opt-bce-fuse-test-frame : i64
  20)

(define (opt-bce-fuse-test-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64, lena=%1:i64, lenb=%2:i64, lenc=%3:i64, mem=%4:u64"))

(define (opt-bce-fuse-test-body-block) : ir.CompilerIrBlock
  (irt.block
    "body:
       %5 = phi [0, entry], [%17, latch] : i64
       bounds_check %5, %1 message \"fuse_ok0\"
       %6 = gep %4, %5 : i64
       %7 = load %6 : i64
       %10 = ge %7, 0 : i64
       branch %10, anchor, latch"))

(define (opt-bce-fuse-test-anchor-block) : ir.CompilerIrBlock
  (irt.block
    "anchor:
       bounds_check %7, %1 message \"fuse_ok1\"
       jump then"))

;; The index each arm check uses. Variant 1 gives them two different ESCAPING
;; loads -- values no check has bounded and no anchor dominates -- so neither
;; may be admitted; every other variant uses the covered `v`.
(define (opt-bce-fuse-test-arm-index [variant : i64]) : i64
  (if (= variant 1)
    12
    7))

(define (opt-bce-fuse-test-arm-index2 [variant : i64]) : i64
  (if (= variant 1)
    14
    7))

(define (opt-bce-fuse-test-then-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "then")
    (opt-test-instrs
      (irt.instr "%11 = gep %4, %5 : i64")
      (ir.CompilerIrInstr.Load 12 (ir.CompilerIrValue.Var 11) (ast.AstType.I64))
      (ir.CompilerIrInstr.BoundsCheck
        (ir.CompilerIrValue.Var (opt-bce-fuse-test-arm-index variant))
        (ir.CompilerIrValue.Var 2)
        (ir.compiler-ir-label "fuse_ok2"))
      (ir.CompilerIrInstr.Gep
        13
        (ir.CompilerIrValue.Var 4)
        (ir.CompilerIrValue.Var (opt-bce-fuse-test-arm-index variant))
        (ast.AstType.I64))
      (ir.CompilerIrInstr.Load 14 (ir.CompilerIrValue.Var 13) (ast.AstType.I64))
      (ir.CompilerIrInstr.BoundsCheck
        (ir.CompilerIrValue.Var (opt-bce-fuse-test-arm-index2 variant))
        (ir.CompilerIrValue.Var 3)
        (ir.compiler-ir-label "fuse_ok3"))
      (ir.CompilerIrInstr.Gep
        15
        (ir.CompilerIrValue.Var 4)
        (ir.CompilerIrValue.Var (opt-bce-fuse-test-arm-index2 variant))
        (ast.AstType.I64))
      (if (= variant 2)
        (irt.instr "store_ptr %15, %14 : i64")
        (irt.instr "%16 = load %15 : i64"))
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))))

(define (opt-bce-fuse-test-latch-block) : ir.CompilerIrBlock
  (irt.block
    "latch:
       %17 = add %5, 1 : i64
       %18 = lt %17, %0 : bool
       branch %18, body, exit"))

(define (opt-bce-fuse-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (opt-bce-fuse-test-body-block)
      (ir.compiler-ir-block-cons
        (opt-bce-fuse-test-anchor-block)
        (ir.compiler-ir-block-cons
          (opt-bce-fuse-test-then-block variant)
          (ir.compiler-ir-block-cons
            (opt-bce-fuse-test-latch-block)
            (irt.blocks "exit:
                 return %0")))))))

(define (opt-bce-fuse-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_fuse_fixture")
    (opt-bce-fuse-test-params)
    (ast.AstType.I64)
    opt-bce-fuse-test-frame
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-fuse-test-versioned [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function
    (opt-bce-fuse-test-function (opt-bce-fuse-test-blocks variant))))

(define (opt-bce-fuse-test-has-block?
  [blocks : ir.CompilerIrBlockList]
  [name : String]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label name))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some _) true]))

(define (opt-bce-fuse-test-verify-ok? [func : ir.CompilerIrFunction]) : bool
  (opt.opt-verify-ok? (opt.opt-verify-function func)))

(define (opt-bce-fuse-test-branch-terminated?
  [blocks : ir.CompilerIrBlockList]
  [name : String]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label name))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch _ _ _) true]
                [_ false])))])]))

;; (a) three arrays, ONE region guard, a fast clone whose only surviving check
;;     is the anchor the other two derive from, and whose loaded-index sentinel
;;     remains conditional;
;; (b) the covered STORE reaches the same shape;
;; (c) an escaping index refuses fusion and keeps both dominated checks;
;; (d) the slow region is byte-for-byte the original, so a guard-failing or
;;     zero-trip run still reaches every check at its own abort site;
;; (f) re-running the pass on the rewrite changes nothing.
(define (compiler-optimize-bce-fuse-self-test) : i64
  (let
    [read-only-fn : ir.CompilerIrFunction (opt-bce-fuse-test-versioned 0)]
    [read-only : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view read-only-fn))]
    [escaping-fn : ir.CompilerIrFunction (opt-bce-fuse-test-versioned 1)]
    [escaping : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view escaping-fn))]
    [stored-fn : ir.CompilerIrFunction (opt-bce-fuse-test-versioned 2)]
    [stored : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view stored-fn))]
    [again-fn : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt.compiler-opt-global-shared-view read-only-fn))]
    [again : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view again-fn))]
    (cond
      [(not (opt-bce-fuse-test-verify-ok? read-only-fn)) 1]
      ;; (a) one guard for the whole region, on the loop entry edge
      [(not
          (opt-bce-fuse-test-has-block?
            (opt.compiler-opt-global-shared-view read-only)
            "body__bce_guard"))
        2]
      [(opt-bce-fuse-test-has-block?
          (opt.compiler-opt-global-shared-view read-only)
          "then__bce_guard")
        3]
      [(opt-bce-fuse-test-has-block?
          (opt.compiler-opt-global-shared-view read-only)
          "latch__bce_guard")
        4]
      ;; the counter check derives from the trip range and the two dominated
      ;; checks derive from the anchor, which itself stays: nothing bounds an
      ;; opaque load
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view read-only)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view read-only)
              (ir.compiler-ir-label "anchor__bce_fast"))
            1))
        6]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view read-only)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        7]
      ;; The fused checks rely on this sentinel before the anchor. It cannot be
      ;; folded from their later, path-conditional proof.
      [(not
          (opt-bce-fuse-test-branch-terminated?
            (opt.compiler-opt-global-shared-view read-only)
            "body__bce_fast"))
        8]
      ;; (d) the slow region keeps every check at its original site
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view read-only)
              (ir.compiler-ir-label "body"))
            1))
        9]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view read-only)
              (ir.compiler-ir-label "anchor"))
            1))
        10]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view read-only)
              (ir.compiler-ir-label "then"))
            2))
        11]
      ;; (b) the covered store derives exactly like the covered read
      [(not (opt-bce-fuse-test-verify-ok? stored-fn)) 12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view stored)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        13]
      [(not
          (=
            (opt-bce-version-test-block-checks
              stored
              (ir.compiler-ir-label "then"))
            2))
        14]
      ;; (c) an escaping index has no anchor: both dominated checks stay in the
      ;; clone, exactly as any underivable index does
      [(not (opt-bce-fuse-test-verify-ok? escaping-fn)) 15]
      [(not
          (=
            (opt-bce-version-test-block-checks
              escaping
              (ir.compiler-ir-label "then__bce_fast"))
            2))
        16]
      ;; (f) idempotence: a converted region is not offered a second time
      [(not (opt-bce-fuse-test-verify-ok? again-fn)) 17]
      [(not
          (=
            (ir.compiler-ir-block-list-count again)
            (ir.compiler-ir-block-list-count read-only)))
        18]
      [else 42])))

;; Two rejections that leave the function byte-for-byte alone: a call-carrying
;; body whose two derived checks are below the per-call floor, and a clone that
;; overruns the instruction budget.
(define (compiler-optimize-bce-version-mb-negative-self-test) : i64
  (let
    [with-call : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function
          (opt-bce-mb-test-function (opt-bce-mb-test-blocks 2))))]
    ;; The same nine-block chain the positive fixture versions, with each
    ;; forwarder padded to twenty-three instructions: 166 cloned instructions
    ;; against a budget of 160, so the growth cap -- and nothing else --
    ;; rejects it.
    [too-big : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function (opt-bce-mb-test-chain-function 22)))]
    (cond
      ;; every rejection leaves the function untouched.
      [(not (= (ir.compiler-ir-block-list-count with-call) 6)) 1]
      [(not (= (ir.compiler-ir-block-list-count too-big) 11)) 2]
      [else 42])))

;; --- guard-dominated compare folding fixture ----------------------------------
;;
;; The pl-line-end shape reduced to its essentials: a counted do-while loop
;; (counter %3 seeded from the invariant param %2, step +1, latch `%8 < %0`)
;; whose ONE derivable check `bounds_check %3, %1` makes the guard prove
;; `%2 >= 0 && %2 < %0 && %0 <= %1`, and whose header then branches on a
;; comparison the guard already decides. `variant` picks that comparison:
;;   0  `%3 >= 0`      folds TRUE  (monotone induction: counter >= seed >= 0)
;;   1  `%3 < 0`       folds FALSE (same fact, other side)
;;   2  `%12 >= 0`     REFUSED: %12 is a second induction phi whose step is
;;                     the non-literal %1, so it is not the counter the guard
;;                     bounded -- the pass never proved it monotone
;;   3  `%6 >= 0` with `%6 = sub %3, 5` REFUSED: a value the loop itself
;;                     writes is neither the counter phi nor invariant
;;   4  `%3 >= 1`      REFUSED: true of every executed trip only via range
;;                     reasoning the rules deliberately do not do; the guard
;;                     proves the seed `>= 0`, not `>= 1`
;;   5  `%0 <= %1`     folds TRUE  (invariant recomputation: the guard's own
;;                     `bound <= length` conjunct, same operator and operands)
;;   6  `%0 < %1`      REFUSED: `<` is not the recorded `<=`, and deriving it
;;                     would need reasoning past exact conjunct identity
;;   7  `%3 >= 0` with a phi in the "else" arm fed from the header REFUSED:
;;                     folding would delete an edge a phi still selects on
;;   8  `%6 >= 0` with `%6 = add %3, 1` and `bounds_check %6, %1` folds TRUE:
;;                     the removed check's exact index has a proven floor
;; Vars: 0-2 params, 3 counter phi, 5 header condition, 6 the variant-3
;; in-loop value, 8 the step, 9 the latch compare, 10 the exit phi, 11 the
;; variant-7 else phi, 12-13 the variant-2 non-literal-step phi.
(define opt-bce-fold-test-frame : i64
  16)

(define (opt-bce-fold-test-nonliteral-variant? [variant : i64]) : bool
  (= variant 2))

(define (opt-bce-fold-test-else-phi-variant? [variant : i64]) : bool
  (= variant 7))

(define (opt-bce-fold-test-derived-check-variant? [variant : i64]) : bool
  (= variant 8))

;; The comparison the header branches on.
(define (opt-bce-fold-test-cond-instr [variant : i64]) : ir.CompilerIrInstr
  (cond
    [(= variant 1) (irt.instr "%5 = lt %3, 0 : i64")]
    [(= variant 2) (irt.instr "%5 = ge %12, 0 : i64")]
    [(or (= variant 3) (opt-bce-fold-test-derived-check-variant? variant))
      (irt.instr "%5 = ge %6, 0 : i64")]
    [(= variant 4) (irt.instr "%5 = ge %3, 1 : i64")]
    [(= variant 5) (irt.instr "%5 = le %0, %1 : i64")]
    [(= variant 6) (irt.instr "%5 = lt %0, %1 : i64")]
    [else (irt.instr "%5 = ge %3, 0 : i64")]))

;; Header: counter phi, the optional second (non-literal-step) phi, the check,
;; the variant-3 in-loop value, the condition, the branch.
(define (opt-bce-fold-test-header-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (opt-bce-fold-test-header-tail variant)
      (irt.instr "%3 = phi [%2, entry], [%8, merge] : i64"))))

(define (opt-bce-fold-test-header-tail [variant : i64]) : ir.CompilerIrInstrSeq
  (let
    [core : ir.CompilerIrInstrSeq
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp
          6
          (if (opt-bce-fold-test-derived-check-variant? variant)
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrBinOp.Sub))
          (ir.CompilerIrValue.Var 3)
          (ir.CompilerIrValue.I64
            (if (opt-bce-fold-test-derived-check-variant? variant)
              1
              5))
          (ast.AstType.I64))
        (ir.CompilerIrInstr.BoundsCheck
          (ir.CompilerIrValue.Var
            (if (opt-bce-fold-test-derived-check-variant? variant)
              6
              3))
          (ir.CompilerIrValue.Var 1)
          (ir.compiler-ir-label "fold_ok0"))
        (opt-bce-fold-test-cond-instr variant)
        (irt.instr "branch %5, then, else"))]
    (if (opt-bce-fold-test-nonliteral-variant? variant)
      (opt-test-instrs-with-tail
        core
        (irt.instr "%12 = phi [%2, entry], [%13, merge] : i64"))
      core)))

(define (opt-bce-fold-test-then-block) : ir.CompilerIrBlock
  (irt.block "then:
       jump merge"))

(define (opt-bce-fold-test-else-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "else")
    (let
      [tail : ir.CompilerIrInstrSeq (irt.instrs "jump merge")]
      (if (opt-bce-fold-test-else-phi-variant? variant)
        (irt.instrs "%11 = phi [%3, body] : i64
           jump merge")
        tail))))

(define (opt-bce-fold-test-merge-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "merge")
    (let
      [tail : ir.CompilerIrInstrSeq
        (irt.instrs
          "%8 = add %3, 1 : i64
           %9 = lt %8, %0 : bool
           branch %9, body, exit")]
      (if (opt-bce-fold-test-nonliteral-variant? variant)
        (opt-test-instrs-with-tail tail (irt.instr "%13 = add %12, %1 : i64"))
        tail))))

(define (opt-bce-fold-test-exit-block) : ir.CompilerIrBlock
  (irt.block "exit:
       %10 = phi [%3, merge] : i64
       return %10"))

(define (opt-bce-fold-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (opt-bce-fold-test-header-block variant)
      (ir.compiler-ir-block-cons
        (opt-bce-fold-test-then-block)
        (ir.compiler-ir-block-cons
          (opt-bce-fold-test-else-block variant)
          (ir.compiler-ir-block-cons
            (opt-bce-fold-test-merge-block variant)
            (ir.compiler-ir-block-cons
              (opt-bce-fold-test-exit-block)
              ir.CompilerIrBlockList.Nil)))))))

(define (opt-bce-fold-test-versioned-function [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function
    (ir.CompilerIrFunction.Function
      (opt-test-symbol "bce_version_fold_fixture")
      (opt-bce-version-test-params)
      (ast.AstType.I64)
      opt-bce-fold-test-frame
      (opt-bce-fold-test-blocks variant)
      ir.CompilerIrFunctionAbi.Ordinary)))

(define (opt-bce-fold-test-versioned [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks (opt-bce-fold-test-versioned-function variant)))

;; -1 when the block is missing or does not end in a Jump; otherwise the
;; jump's target label.
(define (opt-bce-fold-test-jump-target
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) -1]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              -1
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Jump target) target]
                [_ -1])))])]))

(define (opt-bce-fold-test-branch-terminated?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch _ _ _) true]
                [_ false])))])]))

(define (opt-bce-fold-test-has-block?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some _) true]))

(define (opt-bce-fold-test-fast-label [text : String]) : i64
  (ir.compiler-ir-label (str_cat.str-cat text "__bce_fast")))

(define (compiler-optimize-bce-version-fold-self-test) : i64
  (let
    [monotone : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 0)]
    [monotone-false : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 1)]
    [invariant : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 5)]
    [derived-floor : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 8)]
    [retired : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks (opt-bce-fold-test-versioned 0))]
    [fast-body : i64 (opt-bce-fold-test-fast-label "body")]
    [fast-then : i64 (opt-bce-fold-test-fast-label "then")]
    [fast-else : i64 (opt-bce-fold-test-fast-label "else")]
    (cond
      ;; the fixture versions at all, and the fold keeps it verifiable.
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-bce-fold-test-versioned-function 0))))
        1]
      [(not
          (opt-bce-fold-test-has-block?
            (opt.compiler-opt-global-shared-view monotone)
            fast-body))
        2]
      ;; R1: `counter >= 0` becomes the jump it always took ...
      [(not
          (=
            (opt-bce-fold-test-jump-target
              (opt.compiler-opt-global-shared-view monotone)
              fast-body)
            fast-then))
        3]
      ;; ... while the slow loop keeps its branch.
      [(not
          (opt-bce-fold-test-branch-terminated?
            monotone
            (ir.compiler-ir-label "body")))
        4]
      ;; R1 the other way: `counter < 0` is decided FALSE.
      [(not
          (= (opt-bce-fold-test-jump-target monotone-false fast-body) fast-else))
        5]
      ;; R2: the guard's own `bound <= length` conjunct, recomputed in the loop.
      [(not (= (opt-bce-fold-test-jump-target invariant fast-body) fast-then))
        6]
      ;; R3: the exact index of a removed check carries its signed floor.
      [(not
          (= (opt-bce-fold-test-jump-target derived-floor fast-body) fast-then))
        7]
      ;; the arm that lost its last predecessor retires.
      [(opt-bce-fold-test-has-block?
          (opt.compiler-opt-global-shared-view retired)
          fast-else)
        8]
      [(not
          (opt-bce-fold-test-has-block?
            (opt.compiler-opt-global-shared-view retired)
            fast-then))
        9]
      [(not
          (opt-bce-fold-test-has-block? retired (ir.compiler-ir-label "else")))
        10]
      [else 42])))

;; Every refusal keeps the versioned fast clone's conditional branch.
(define (compiler-optimize-bce-version-fold-refusal-self-test) : i64
  (let
    [fast-body : i64 (opt-bce-fold-test-fast-label "body")]
    [nonliteral : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 2)]
    [in-loop : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 3)]
    [range-needed : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 4)]
    [wrong-op : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 6)]
    [else-phi : ir.CompilerIrBlockList (opt-bce-fold-test-versioned 7)]
    (cond
      ;; a second induction phi whose step is not a literal is not the
      ;; counter the guard bounded.
      [(not
          (opt-bce-fold-test-has-block?
            (opt.compiler-opt-global-shared-view nonliteral)
            fast-body))
        1]
      [(not (opt-bce-fold-test-branch-terminated? nonliteral fast-body)) 2]
      ;; a value the loop itself writes is neither counter nor invariant.
      [(not (opt-bce-fold-test-branch-terminated? in-loop fast-body)) 3]
      ;; `counter >= 1` needs a seed bound the guard never proved.
      [(not (opt-bce-fold-test-branch-terminated? range-needed fast-body)) 4]
      ;; `bound < length` is not the recorded `bound <= length`.
      [(not (opt-bce-fold-test-branch-terminated? wrong-op fast-body)) 5]
      ;; the dropped arm still selects a value on the edge.
      [(not (opt-bce-fold-test-branch-terminated? else-phi fast-body)) 6]
      [else 42])))

;; --- loop-nest fixture --------------------------------------------------------
;;
;; A counted OUTER loop (do-while latch "merge", counter %3, bounded phi %4)
;; whose body branches into a whole inner loop before merging back. `mode`
;; picks the inner loop's relationship to the outer one:
;;   0  the inner header is entered straight from the outer header, so the
;;      inner loop has no dedicated preheader and can never version on its
;;      own -- the ln-set-count shape, and the one where the outer NEST
;;      versions
;;   1  an "inner_pre" forwarder gives the inner loop its own preheader, so
;;      the inner loop versions first and the outer nest is left alone
;;   2  a Call in the inner body: the clonable whitelist applies across the
;;      whole nest, so nothing versions
;; `pad` adds dead movs to the inner body -- the knob that drives the NEST
;; instruction budget without moving the block count. Vars: 0-2 params, 3-10
;; the outer loop, 11-13 the inner loop, 14 the mode-2 call, pad movs from 15.
;; Where the outer header branches to reach the inner loop.
(define (opt-bce-mb-test-nest-inner-entry [mode : i64]) : i64
  (if (= mode 1)
    (ir.compiler-ir-label "inner_pre")
    (ir.compiler-ir-label "inner_header")))

;; The inner header's entering predecessor, the label its phi carries.
(define (opt-bce-mb-test-nest-inner-pred [mode : i64]) : i64
  (if (= mode 1)
    (ir.compiler-ir-label "inner_pre")
    (ir.compiler-ir-label "body")))

(define (opt-bce-mb-test-nest-header-block [mode : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs
      (irt.instr "%3 = phi [0, entry], [%8, merge] : i64")
      (irt.instr "%4 = phi [0, entry], [%7, merge] : i64")
      (irt.instr "bounds_check %3, %1 message \"mb_nest_ok0\"")
      (irt.instr "%5 = lt %3, 4 : bool")
      (ir.CompilerIrInstr.Branch
        (ir.CompilerIrValue.Var 5)
        (ir.compiler-ir-label "then")
        (opt-bce-mb-test-nest-inner-entry mode)))))

(define (opt-bce-mb-test-nest-then-block) : ir.CompilerIrBlock
  (irt.block
    "then:
       bounds_check %4, %1 message \"mb_nest_ok1\"
       %6 = add %4, 1 : i64
       jump merge"))

(define (opt-bce-mb-test-nest-inner-header-block [mode : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "inner_header")
    (opt-test-instrs
      (ir.CompilerIrInstr.Phi
        11
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.I64 0)
          (opt-bce-mb-test-nest-inner-pred mode)
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 13)
            (ir.compiler-ir-label "inner_body")
            (ir.compiler-ir-phi-input-seq-empty)))
        (ast.AstType.I64))
      (irt.instr "%12 = lt %11, %0 : bool")
      (irt.instr "branch %12, inner_body, merge"))))

;; The inner body: an inner-counter check (which the OUTER loop's guard can
;; never derive -- %11 is neither the outer counter nor loop-invariant), the
;; mode-2 call, and the pad movs.
(define (opt-bce-mb-test-nest-inner-body-block [mode : i64] [pad : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "inner_body")
    (opt-test-instrs-with-tail
      (let
        [tail : ir.CompilerIrInstrSeq
          (opt-bce-mb-test-pad-instrs
            pad
            15
            (irt.instrs
              "%13 = add %11, 1 : i64
               jump inner_header"))]
        (if (= mode 2)
          (opt-test-instrs-with-tail
            tail
            (irt.instr "%14 = call mb_nest_callee() : i64"))
          tail))
      (irt.instr "bounds_check %11, %1 message \"mb_nest_inner_ok\""))))

(define (opt-bce-mb-test-nest-merge-block) : ir.CompilerIrBlock
  (irt.block
    "merge:
       %7 = phi [%6, then], [%4, inner_header] : i64
       %8 = add %3, 1 : i64
       %9 = lt %8, %0 : bool
       branch %9, body, exit"))

(define (opt-bce-mb-test-nest-exit-block) : ir.CompilerIrBlock
  (irt.block "exit:
       %10 = phi [%7, merge] : i64
       return %10"))

(define (opt-bce-mb-test-nest-tail-blocks [mode : i64] [pad : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-bce-mb-test-nest-inner-header-block mode)
    (ir.compiler-ir-block-cons
      (opt-bce-mb-test-nest-inner-body-block mode pad)
      (ir.compiler-ir-block-cons
        (opt-bce-mb-test-nest-merge-block)
        (ir.compiler-ir-block-cons
          (opt-bce-mb-test-nest-exit-block)
          (ir.CompilerIrBlockList.Nil))))))

(define (opt-bce-mb-test-nest-blocks [mode : i64] [pad : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (opt-bce-mb-test-nest-header-block mode)
      (ir.compiler-ir-block-cons
        (opt-bce-mb-test-nest-then-block)
        (if (= mode 1)
          (ir.compiler-ir-block-cons
            (irt.block "inner_pre:
                 jump inner_header")
            (opt-bce-mb-test-nest-tail-blocks mode pad))
          (opt-bce-mb-test-nest-tail-blocks mode pad))))))

(define (opt-bce-mb-test-nest-function [mode : i64] [pad : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb_nest_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    (+ 15 pad)
    (opt-bce-mb-test-nest-blocks mode pad)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mb-test-nest-versioned [mode : i64] [pad : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function (opt-bce-mb-test-nest-function mode pad)))

;; The nest admission (M2). The outer loop of a nest versions like any other
;; counted loop -- the inner loop is simply more blocks in the clone group --
;; with the guard derived only from the OUTER loop's own counter facts, the
;; nest instruction budget (not the loop's shape) deciding how big a nest may
;; clone, and the flat-first scan order keeping an independently versionable
;; inner loop ahead of its enclosing nest.
(define (compiler-optimize-bce-version-mb-nest-self-test) : i64
  (let
    [nested : ir.CompilerIrFunction (opt-bce-mb-test-nest-versioned 0 0)]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view nested))]
    ;; 54 cloned instructions: a big nest, still inside the nest budget.
    [big : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-bce-mb-test-nest-versioned 0 40))]
    ;; 69 cloned instructions across FIVE blocks: over the nest budget of 64
    ;; and under the flat loop's 96, so the nest budget -- and nothing else --
    ;; rejects it.
    [too-big : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-bce-mb-test-nest-versioned 0 55))]
    ;; The inner loop gets its own preheader and versions first.
    [inner-first : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-bce-mb-test-nest-versioned 1 0))]
    ;; A Call in the inner body: the clonable whitelist reaches through the
    ;; nest, so neither loop versions.
    [with-call : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-bce-mb-test-nest-versioned 2 0))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function nested))) 1]
      ;; entry + guard + five fast clones + five slow blocks + exit
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            13))
        2]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "body__bce_guard"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        3]
      ;; the WHOLE nest cloned: the inner loop's blocks came along.
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view out)
            (ir.compiler-ir-label "inner_header__bce_fast")))
        4]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view out)
            (ir.compiler-ir-label "inner_body__bce_fast")))
        5]
      ;; the outer loop's own checks -- the counter and the bounded phi --
      ;; are gone from the fast clone ...
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        6]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        7]
      ;; ... while the INNER loop's own check, whose index is the inner
      ;; counter, is not covered by the outer guard and stays in the clone.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "inner_body__bce_fast"))
            1))
        8]
      ;; the slow nest is untouched.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body"))
            1))
        9]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "inner_body"))
            1))
        10]
      ;; the exit phi gained the parallel fast-edge input.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              out
              (ir.compiler-ir-label "exit"))
            2))
        11]
      ;; size, not shape: 40 pad movs still fit ...
      [(not (= (ir.compiler-ir-block-list-count big) 13)) 12]
      ;; ... 55 do not, and the rejection leaves the function untouched.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view too-big))
            7))
        13]
      [(opt-block-list-has-label?
          too-big
          (ir.compiler-ir-label "body__bce_guard"))
        14]
      ;; Flat before nested: the inner loop versions and the outer nest, whose
      ;; clone would have to re-create `inner_header__bce_fast`, does not.
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view inner-first)
            (ir.compiler-ir-label "inner_header__bce_guard")))
        15]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view inner-first)
          (ir.compiler-ir-label "body__bce_guard"))
        16]
      ;; original eight blocks + the inner guard + two inner fast clones
      [(not (= (ir.compiler-ir-block-list-count inner-first) 11)) 17]
      ;; the unclonable call rejects the whole nest.
      [(not (= (ir.compiler-ir-block-list-count with-call) 7)) 18]
      [else 42])))

;; entry -> reject_loop_a -> reject_mid -> reject_loop_b -> reject_done: two
;; independent self-loops, each versionable on its own, chained through a
;; merge block that carries the first loop's accumulator into the second.
(define (opt-bce-version-reject-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump reject_loop_a
     reject_loop_a:
       %3 = phi [0, entry], [%6, reject_loop_a] : i64
       %4 = phi [0, entry], [%5, reject_loop_a] : i64
       %5 = add %4, %3 : i64
       bounds_check %3, %1 message \"bce_version_ok\"
       %6 = add %3, 1 : i64
       %7 = lt %6, %0 : bool
       branch %7, reject_loop_a, reject_mid
     reject_mid:
       %8 = phi [%5, reject_loop_a] : i64
       jump reject_loop_b
     reject_loop_b:
       %9 = phi [0, reject_mid], [%12, reject_loop_b] : i64
       %10 = phi [%8, reject_mid], [%11, reject_loop_b] : i64
       %11 = add %10, %9 : i64
       bounds_check %9, %1 message \"bce_version_ok\"
       %12 = add %9, 1 : i64
       %13 = lt %12, %0 : bool
       branch %13, reject_loop_b, reject_done
     reject_done:
       %14 = phi [%11, reject_loop_b] : i64
       return %14"))

(define (opt-bce-version-reject-test-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_reject_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    15
    (opt-bce-version-reject-test-blocks)
    ir.CompilerIrFunctionAbi.Ordinary))

;; A verifier rejection retires ONE loop, not the function.
;;
;; Both versioners rebuild the function around each rewrite and verify it on
;; its own. A refusal used to return the last verified state AND stop, which
;; cost every remaining loop in the function its versioning -- exactly the
;; wrong trade in a big merged body. It now retires the refused loop for the
;; rest of the invocation and rescans, spending no budget on the refusal.
;;
;; Every rewrite these passes emit is verified by construction (generated
;; labels are proved fresh before a shape is admitted, guard operands are
;; proved loop-invariant, and the only new edges are the guard's and the
;; clone's, whose exit phis the rewrite extends), so the refusal is forced
;; here through `opt-bce-version-function-reject-probe`, which names one loop
;; whose application the driver must refuse.
(define (compiler-optimize-bce-version-reject-skip-self-test) : i64
  (let
    [none : i64 (ir.compiler-ir-label-none)]
    [loop-a : i64 (ir.compiler-ir-label "reject_loop_a")]
    [loop-b : i64 (ir.compiler-ir-label "reject_loop_b")]
    [fast-a : i64 (ir.compiler-ir-label "reject_loop_a__bce_fast")]
    [fast-b : i64 (ir.compiler-ir-label "reject_loop_b__bce_fast")]
    ;; No probe: the driver behaves exactly as the production entry does.
    [both : ir.CompilerIrFunction
      (opt.opt-bce-version-function-reject-probe
        (opt-bce-version-reject-test-function)
        none)]
    [both-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view both))]
    [plain-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function (opt-bce-version-reject-test-function)))]
    ;; The FIRST loop's application is refused: the second must still version.
    [skip-a : ir.CompilerIrFunction
      (opt.opt-bce-version-function-reject-probe
        (opt-bce-version-reject-test-function)
        loop-a)]
    [skip-a-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view skip-a))]
    ;; ... and symmetrically for the second loop.
    [skip-b : ir.CompilerIrFunction
      (opt.opt-bce-version-function-reject-probe
        (opt-bce-version-reject-test-function)
        loop-b)]
    [skip-b-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view skip-b))]
    ;; The multi-block arm, on the nest fixture whose inner loop versions
    ;; first: refusing the inner loop must hand the slot to the outer nest,
    ;; which is versionable exactly because the inner one did not take it.
    [nest-inner : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function-reject-probe
          (opt-bce-mb-test-nest-function 1 0)
          none))]
    [nest-skip : ir.CompilerIrFunction
      (opt.opt-bce-version-function-reject-probe
        (opt-bce-mb-test-nest-function 1 0)
        (ir.compiler-ir-label "inner_header"))]
    [nest-skip-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view nest-skip))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function both))) 1]
      ;; entry + two guards + two fast clones + two slow loops + mid + done
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view both-out))
            9))
        2]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view both-out)
            fast-a))
        3]
      [(not (opt-block-list-has-label? both-out fast-b)) 4]
      ;; an unprobed run is the production entry, block for block
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view plain-out))
            9))
        5]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view plain-out)
            fast-a))
        6]
      [(not (opt-block-list-has-label? plain-out fast-b)) 7]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function skip-a))) 8]
      ;; the refused loop is untouched ...
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view skip-a-out)
          fast-a)
        9]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (opt.compiler-opt-global-shared-view skip-a-out)
              loop-a)
            1))
        10]
      ;; ... and the OTHER loop still versioned: the whole point.
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view skip-a-out)
            fast-b))
        11]
      [(not (= (ir.compiler-ir-block-list-count skip-a-out) 7)) 12]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function skip-b))) 13]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view skip-b-out)
          fast-b)
        14]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view skip-b-out)
            fast-a))
        15]
      [(not (= (ir.compiler-ir-block-list-count skip-b-out) 7)) 16]
      ;; unprobed multi-block control: the inner loop takes the slot.
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view nest-inner)
            (ir.compiler-ir-label "inner_header__bce_guard")))
        17]
      [(opt-block-list-has-label?
          nest-inner
          (ir.compiler-ir-label "body__bce_guard"))
        18]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function nest-skip))) 19]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view nest-skip-out)
          (ir.compiler-ir-label "inner_header__bce_guard"))
        20]
      ;; the refused inner loop did not cost the enclosing nest its versioning
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view nest-skip-out)
            (ir.compiler-ir-label "body__bce_guard")))
        21]
      [(not
          (opt-block-list-has-label?
            nest-skip-out
            (ir.compiler-ir-label "inner_header__bce_fast")))
        22]
      [else 42])))

;; Partial versioning: the swap check's loaded index does not derive, but the
;; body's counter check does -- the loop versions, the fast clone drops only
;; the counter check and KEEPS the swap check (remapped).
(define (compiler-optimize-bce-version-mb-partial-self-test) : i64
  (let
    [versioned : ir.CompilerIrFunction
      (opt.opt-bce-version-function
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 1)))]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view versioned))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function versioned))) 1]
      ;; entry + guard + four fast clones + four slow blocks + exit
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            11))
        2]
      ;; the derivable counter check is gone from the fast header...
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        3]
      ;; ... while the underivable swap check STAYS in the fast clone ...
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then__bce_fast"))
            1))
        4]
      ;; ... and the slow loop keeps both of its checks.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body"))
            1))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then"))
            1))
        6]
      ;; the exit phi gained the parallel fast-edge input.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              out
              (ir.compiler-ir-label "exit"))
            2))
        7]
      [else 42])))

;; --- P5a self-tests: shifted limits, offset indices, guard minimization ------
;;
;; One top-tested counted loop, with the checks in a body block the counter
;; compare DOMINATES (a check in the compare's own block runs one time more than
;; the body and is deliberately kept -- the shape's `uncovered` set):
;;
;;   entry [-> pre] -> body (counter phi, compare) -> work (checks) [-> pads]
;;     -> latch (i += 1) -> body;  the compare's false arm leaves to exit
;;
;; Variants, one capability each:
;;   0  `i < n`, one check on `i`                the unshifted control
;;   1  `i + 6 <= n`, one check on `i`           an INCLUSIVE, OFFSET-counter
;;                                               compare: the limit is `n - 5`,
;;                                               materialized in the guard, and
;;                                               the shift's own no-wrap pair
;;   2  `i < n`, checks on `i` and `i + 2`       counter + K, stated by the
;;                                               literal-base fan as ONE Sub for
;;                                               the whole family
;;   3  `i < n`, `i` and a LOADED index          partial versioning: the loaded
;;                                               check stays in the fast clone
;;   4  variant 0 behind a rotation guard        the guard drops the
;;      (`entry: 0 < n` -> `pre` -> body)        `seed < bound` conjunct a
;;                                               dominating branch decided
;;   5  variant 0 plus 26 forwarder blocks       29 loop blocks: over the old
;;                                               block cap, inside the
;;                                               instruction budget
(define opt-bce-p5a-test-frame : i64
  16)

(define (opt-bce-p5a-test-pads [variant : i64]) : i64
  (if (= variant 5)
    26
    0))

(define (opt-bce-p5a-test-preheader [variant : i64]) : i64
  (ir.compiler-ir-label
    (if (= variant 4)
      "pre"
      "entry")))

(define (opt-bce-p5a-test-pad-label [index : i64]) : i64
  (ir.compiler-ir-label (str_cat.str-cat "p5a_pad" (string.int->string index))))

(define (opt-bce-p5a-test-work-target [variant : i64]) : i64
  (if (> (opt-bce-p5a-test-pads variant) 0)
    (opt-bce-p5a-test-pad-label 0)
    (ir.compiler-ir-label "latch")))

(define (opt-bce-p5a-test-pad-blocks
  [index : i64]
  [count : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (if (>= index count)
    tail
    (ir.compiler-ir-block-cons
      (opt-bce-mb-test-jump-block
        (opt-bce-p5a-test-pad-label index)
        (if (>= (+ index 1) count)
          (ir.compiler-ir-label "latch")
          (opt-bce-p5a-test-pad-label (+ index 1))))
      (opt-bce-p5a-test-pad-blocks (+ index 1) count tail))))

(define (opt-bce-p5a-test-entry-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "entry")
    (if (= variant 4)
      (irt.instrs "%11 = lt 0, %0 : i64
         branch %11, pre, exit")
      (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "body"))))))

(define (opt-bce-p5a-test-body-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (if (= variant 1)
        (irt.instrs
          "%4 = add %3, 6 : i64
           %5 = le %4, %0 : bool
           branch %5, work, exit")
        (irt.instrs "%5 = lt %3, %0 : bool
           branch %5, work, exit"))
      (ir.CompilerIrInstr.Phi
        3
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.I64 0)
          (opt-bce-p5a-test-preheader variant)
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 7)
            (ir.compiler-ir-label "latch")
            (ir.compiler-ir-phi-input-seq-empty)))
        (ast.AstType.I64)))))

(define (opt-bce-p5a-test-work-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "work")
    (opt-test-instrs-with-tail
      (cond
        [(= variant 2)
          (opt-test-instrs
            (irt.instr "%6 = add %3, 2 : i64")
            (irt.instr "bounds_check %6, %1 message \"p5a_ok1\"")
            (ir.CompilerIrInstr.Jump (opt-bce-p5a-test-work-target variant)))]
        [(= variant 3)
          (opt-test-instrs
            (irt.instr "%9 = gep %2, %3 : i64")
            (irt.instr "%8 = load %9 : i64")
            (irt.instr "bounds_check %8, %1 message \"p5a_ok1\"")
            (ir.CompilerIrInstr.Jump (opt-bce-p5a-test-work-target variant)))]
        [else
          (opt-test-instrs
            (ir.CompilerIrInstr.Jump (opt-bce-p5a-test-work-target variant)))])
      (irt.instr "bounds_check %3, %1 message \"p5a_ok0\""))))

(define (opt-bce-p5a-test-latch-block) : ir.CompilerIrBlock
  (irt.block "latch:
       %7 = add %3, 1 : i64
       jump body"))

(define (opt-bce-p5a-test-exit-block) : ir.CompilerIrBlock
  (irt.block "exit:
       return 0"))

(define (opt-bce-p5a-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-bce-p5a-test-entry-block variant)
    (if (= variant 4)
      (ir.compiler-ir-block-cons
        (irt.block "pre:
             jump body")
        (opt-bce-p5a-test-loop-blocks variant))
      (opt-bce-p5a-test-loop-blocks variant))))

(define (opt-bce-p5a-test-loop-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-bce-p5a-test-body-block variant)
    (ir.compiler-ir-block-cons
      (opt-bce-p5a-test-work-block variant)
      (opt-bce-p5a-test-pad-blocks
        0
        (opt-bce-p5a-test-pads variant)
        (ir.compiler-ir-block-cons
          (opt-bce-p5a-test-latch-block)
          (ir.compiler-ir-block-cons
            (opt-bce-p5a-test-exit-block)
            (ir.CompilerIrBlockList.Nil)))))))

(define (opt-bce-p5a-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_p5a_fixture")
    (opt-bce-version-test-params)
    (ast.AstType.I64)
    opt-bce-p5a-test-frame
    (opt-bce-p5a-test-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-p5a-test-versioned [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function (opt-bce-p5a-test-function variant)))

(define (compiler-optimize-bce-version-p5a-self-test) : i64
  (let
    [guard-label : i64 (ir.compiler-ir-label "body__bce_guard")]
    [fast-work : i64 (ir.compiler-ir-label "work__bce_fast")]
    [plain : ir.CompilerIrFunction (opt-bce-p5a-test-versioned 0)]
    [plain-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view plain))]
    [shifted : ir.CompilerIrFunction (opt-bce-p5a-test-versioned 1)]
    [shifted-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view shifted))]
    [offset : ir.CompilerIrFunction (opt-bce-p5a-test-versioned 2)]
    [offset-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view offset))]
    [partial : ir.CompilerIrFunction (opt-bce-p5a-test-versioned 3)]
    [partial-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view partial))]
    [rotated : ir.CompilerIrFunction (opt-bce-p5a-test-versioned 4)]
    [rotated-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view rotated))]
    [wide : ir.CompilerIrFunction (opt-bce-p5a-test-versioned 5)]
    [wide-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view wide))]
    (cond
      ;; the unshifted control versions check-free, and its guard states the
      ;; once-only `seed < bound` (one Lt) and `bound <= len` (one Le).
      [(not (opt.opt-verify-ok? (opt.opt-verify-function plain))) 1]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view plain-out)
            guard-label))
        2]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view plain-out)
              fast-work)
            0))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view plain-out)
              (ir.compiler-ir-label "work"))
            1))
        4]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view plain-out)
              guard-label
              (ir.CompilerIrBinOp.Lt))
            1))
        5]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              plain-out
              guard-label
              (ir.CompilerIrBinOp.Le))
            1))
        6]
      ;; INCLUSIVE + OFFSET compare: `i + 6 <= n` is the counter range
      ;; [0, n - 5), so the guard materializes `n + -5` and states the shift
      ;; did not wrap (`limit <= bound`, a second Le).
      [(not (opt.opt-verify-ok? (opt.opt-verify-function shifted))) 7]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view shifted-out)
            guard-label))
        8]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view shifted-out)
              fast-work)
            0))
        9]
      [(not
          (opt-bce-version-test-block-binop-op-lit?
            (ir.compiler-ir-global-shared-view shifted-out)
            guard-label
            (ir.CompilerIrBinOp.Add)
            (- 0 5)))
        10]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              shifted-out
              guard-label
              (ir.CompilerIrBinOp.Le))
            2))
        11]
      ;; counter + K: both checks derive, and the literal-base fan states the
      ;; family as ONE Sub (`len - 2`) with ONE Le, exactly what the bare
      ;; counter alone costs above.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function offset))) 12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view offset-out)
              fast-work)
            0))
        13]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view offset-out)
              (ir.compiler-ir-label "work"))
            2))
        14]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view offset-out)
              guard-label
              (ir.CompilerIrBinOp.Sub))
            1))
        15]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              offset-out
              guard-label
              (ir.CompilerIrBinOp.Le))
            1))
        16]
      ;; PARTIAL: the counter check leaves the clone, the loaded index stays.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function partial))) 17]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view partial-out)
              fast-work)
            1))
        18]
      [(not
          (=
            (opt-bce-version-test-block-checks
              partial-out
              (ir.compiler-ir-label "work"))
            2))
        19]
      ;; GUARD MINIMIZATION: the rotation guard already decided `0 < n` on the
      ;; only edge into the preheader, so the conjunct is not re-emitted -- no
      ;; Lt at all, and `bound <= len` alone selects the clone.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function rotated))) 20]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view rotated-out)
            guard-label))
        21]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view rotated-out)
              fast-work)
            0))
        22]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              (ir.compiler-ir-global-shared-view rotated-out)
              guard-label
              (ir.CompilerIrBinOp.Lt))
            0))
        23]
      [(not
          (=
            (opt-bce-version-test-block-binop-count
              rotated-out
              guard-label
              (ir.CompilerIrBinOp.Le))
            1))
        24]
      ;; BLOCK COUNT: 29 loop blocks -- over the cap this pass used to carry,
      ;; inside the instruction budget that is now the only growth metric.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function wide))) 25]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view wide-out)
            guard-label))
        26]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view wide-out)
              fast-work)
            0))
        27]
      [(not
          (opt-block-list-has-label?
            wide-out
            (ir.compiler-ir-label "p5a_pad25__bce_fast")))
        28]
      [else 42])))

(test
  bce-version-p5a-shifted-and-minimized
  (test.assert-i64-eq
    (compiler-optimize-bce-version-p5a-self-test)
    42
    "shifted-limit compares, counter+K indices, partial keeps, a minimized guard and a 29-block loop all version"))

;; --- P5a: the unroller's trip-remainder refusal ------------------------------
;;
;; `it-hash-words`' byte tail in miniature. A merge feeds the loop's seed, and
;; both of its inputs arrive on edges that decided `value >= n - 7`, so the whole
;; trip count is at most 7 -- less than the factor the rewrite would clone for,
;; whose guard (`seed < n - K`) can therefore never be true. `bounded?` false is
;; the control: the same shape with one input arriving on a plain Jump, which
;; proves nothing and must still unroll.
;;
;;   entry (0 >= n-7 on the join edge) -> join <- other (v >= n-7, or a Jump)
;;   join -> body (self-loop: i/acc phis, acc += i, i += 1, i' < n) -> exit
(define (opt-unroll-p5a-remainder-blocks [bounded? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %8 = sub %0, 7 : i64
         %9 = lt 0, %8 : i64
         branch %9, other, join")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "other")
        (opt-test-instrs-with-tail
          (if bounded?
            (irt.instrs
              "%11 = lt %10, %8 : i64
               branch %11, exit, join")
            (irt.instrs "jump join"))
          (irt.instr "%10 = mov %0 : i64")))
      (irt.blocks
        "join:
           %2 = phi [0, entry], [%10, other] : i64
           %12 = lt %2, %0 : bool
           branch %12, body, exit
         body:
           %3 = phi [%2, join], [%6, body] : i64
           %4 = phi [0, join], [%5, body] : i64
           %5 = add %4, %3 : i64
           %6 = add %3, 1 : i64
           %7 = lt %6, %0 : bool
           branch %7, body, exit
         exit:
           return 0"))))

(define (opt-unroll-p5a-remainder-function [bounded? : bool]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "unroll_p5a_remainder_fixture")
    (opt-unroll-test-params)
    (ast.AstType.I64)
    16
    (opt-unroll-p5a-remainder-blocks bounded?)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (compiler-optimize-unroll-p5a-remainder-self-test) : i64
  (let
    [guard-label : i64 (ir.compiler-ir-label "body__unroll_guard")]
    [bounded : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-p5a-remainder-function true))]
    [bounded-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view bounded))]
    [control : ir.CompilerIrFunction
      (opt.opt-unroll-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-p5a-remainder-function false))]
    [control-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view control))]
    (cond
      ;; a trip count of at most 7 leaves the loop alone: five blocks, no guard.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function bounded))) 1]
      [(opt-block-list-has-label?
          (ir.compiler-ir-global-shared-view bounded-out)
          guard-label)
        2]
      [(not (= (ir.compiler-ir-block-list-count bounded-out) 5)) 3]
      ;; the control proves nothing about its second input and unrolls.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function control))) 4]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view control-out)
            guard-label))
        5]
      [(not (> (ir.compiler-ir-block-list-count control-out) 5)) 6]
      [else 42])))

(test
  unroll-p5a-dead-remainder-clone
  (test.assert-i64-eq
    (compiler-optimize-unroll-p5a-remainder-self-test)
    42
    "a loop whose whole trip count is a literal remainder is not unrolled"))

;; --- Gep use-splitting self-tests --------------------------------------------
;; Invariant-offset Gep splitting. One counted loop reading `a[start + i]`,
;; with the variant selector perturbing exactly one gate at a time:
;;   0  the plain shape: the Add is single-use and both operands are clean
;;   1  a non-Gep consumer of the Add (the all-uses gate rejects)
;;   2  a second in-loop use of the invariant addend with one base (the
;;      pressure gate rejects: the addend would stay live for no saving)
;;   3  the Gep base is defined inside the loop (no preheader home for the
;;      derived base, so the correctness filter rejects)
;;   4  two bases share the Add AND the addend has a second in-loop use: k >= 2
;;      pays for the surviving addend, so this one splits
;;   5  the plain shape reached through a branching guard, so the header has no
;;      dedicated preheader and one has to be synthesized first
;;   6  ONE base indexed at two different invariant offsets: each needs its own
;;      derived base, and sharing one across the offsets would retarget the
;;      second address
;;   7  a DEAD Cast of the Add, the chain a removed BoundsCheck strands: the
;;      pipeline DCE retires it, so it must not count against the all-uses gate
;; Variants 1 and 2 keep their perturbation LIVE (a store consumes it);
;; otherwise the dead-use settling would retire it and the gate would not be
;; exercised at all.
(define (opt-gep-offset-test-tail) : ir.CompilerIrInstrSeq
  (irt.instrs "%15 = add %10, 1 : i64
     jump loop"))

(define (opt-gep-offset-test-extras [variant : i64]) : ir.CompilerIrInstrSeq
  (cond
    [(= variant 7)
      ;; the dead cast a removed BoundsCheck leaves behind
      (opt-test-instrs-with-tail
        (opt-gep-offset-test-tail)
        (irt.instr "%16 = cast %12 : i64 to u64"))]
    [(= variant 1)
      ;; a plain arithmetic consumer of the Add: not an address use
      (irt.instrs
        "%16 = mul %12, 7 : i64
         store_ptr %13, %16 : i64
         %15 = add %10, 1 : i64
         jump loop")]
    [(or (= variant 2) (= variant 4))
      ;; a second in-loop reader of the invariant addend
      (irt.instrs
        "%17 = mul %3, 3 : i64
         store_ptr %13, %17 : i64
         %15 = add %10, 1 : i64
         jump loop")]
    [else (opt-gep-offset-test-tail)]))

;; Variant 6 adds a second Add/Gep on the SAME base at a different invariant
;; offset: the derived-base cache has to key on the offset as well as the base.
(define (opt-gep-offset-test-second-offset [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 6)
    (opt-test-instrs-with-tail
      (opt-gep-offset-test-extras variant)
      (irt.instr "%21 = add %4, %10 : i64")
      (irt.instr "%22 = gep %0, %21 : i64")
      (ir.CompilerIrInstr.Load 23 (ir.CompilerIrValue.Var 22) (ast.AstType.I64)))
    (opt-gep-offset-test-extras variant)))

;; Variant 4 adds a second Gep on a different base, sharing the same Add.
(define (opt-gep-offset-test-second-base [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 4)
    (opt-test-instrs-with-tail
      (opt-gep-offset-test-extras variant)
      (irt.instr "%19 = gep %1, %12 : i64")
      (ir.CompilerIrInstr.Load 20 (ir.CompilerIrValue.Var 19) (ast.AstType.I64)))
    (opt-gep-offset-test-second-offset variant)))

(define (opt-gep-offset-test-body-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (let
    [base : ir.CompilerIrValue
      (if (= variant 3)
        (ir.CompilerIrValue.Var 18)
        (ir.CompilerIrValue.Var 0))]
    [core : ir.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (opt-gep-offset-test-second-base variant)
        (irt.instr "%12 = add %3, %10 : i64")
        (ir.CompilerIrInstr.Gep
          13
          base
          (ir.CompilerIrValue.Var 12)
          (ast.AstType.I64))
        (irt.instr "%14 = load %13 : i64"))]
    (if (= variant 3)
      ;; the base itself becomes loop variant
      (opt-test-instrs-with-tail core (irt.instr "%18 = mul %0, %10 : i64"))
      core)))

(define (opt-gep-offset-test-loop-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = phi [0, entry], [%15, body] : i64
     %11 = lt %10, %2 : bool
     branch %11, body, exit"))

;; Variant 5 enters the loop from a two-successor guard, which is exactly the
;; bce fast-clone shape: `opt-natural-loop-safe-preheader-block?` rejects it, so
;; the pass has to synthesize a preheader before it can hoist anything.
(define (opt-gep-offset-test-entry-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 5)
    (irt.instrs "branch %2, loop, exit")
    (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop")))))

(define (opt-gep-offset-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-gep-offset-test-entry-instrs variant))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-gep-offset-test-loop-instrs))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-gep-offset-test-body-instrs variant))
        (irt.blocks "exit:
             return 0")))))

(define (opt-gep-offset-test-params) : ir.CompilerIrParamSeq
  (irt.params
    "base-a=%0:i64, base-b=%1:i64, n=%2:i64, start=%3:i64, start2=%4:i64"))

(define (opt-gep-offset-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "gep_offset")
    (opt-gep-offset-test-params)
    (ast.AstType.I64)
    24
    (opt-gep-offset-test-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-gep-offset-test-run [variant : i64]) : ir.CompilerIrFunction
  (opt-gep-offset-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-gep-offset-test-function variant)))

(define (opt-gep-offset-test-gep-count-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-gep-offset-test-gep-count-from
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Gep _ _ _ _) 1]
          [_ 0])))))

;; Geps in the block that carries `label`; -1 when there is no such block.
(define (opt-gep-offset-test-geps-in
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-gep-offset-test-gep-count-from instrs 0 0)])]))

;; The body Gep must now index on the loop counter itself, not on the Add.
(define (opt-gep-offset-test-body-index-is-counter?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label "body"))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-gep-offset-test-body-index-scan instrs 0 false)])]))

(define (opt-gep-offset-test-body-index-scan
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [seen : bool]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    seen
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Gep _ _ offset _)
        (if (opt.opt-value-eq offset (ir.CompilerIrValue.Var 10))
          (opt-gep-offset-test-body-index-scan instrs (+ index 1) true)
          false)]
      [_ (opt-gep-offset-test-body-index-scan instrs (+ index 1) seen)])))

(define (opt-gep-offset-test-nth-gep-offset
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [skip : i64]) : ir.CompilerIrValue
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrValue.I64 (- 0 1))
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Gep _ _ offset _)
        (if (= skip 0)
          offset
          (opt-gep-offset-test-nth-gep-offset instrs (+ index 1) (- skip 1)))]
      [_ (opt-gep-offset-test-nth-gep-offset instrs (+ index 1) skip)])))

;; Two derived bases for one array must carry the two different offsets; a
;; cache keyed on the base alone would emit the same offset twice.
(define (opt-gep-offset-test-derived-offsets-distinct?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (not
            (opt.opt-value-eq
              (opt-gep-offset-test-nth-gep-offset
                (ir.compiler-ir-global-shared-view instrs)
                0
                0)
              (opt-gep-offset-test-nth-gep-offset instrs 0 1)))])]))

(define (opt-gep-offset-test-unchanged? [variant : i64]) : bool
  (opt.opt-block-list-eq
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt.opt-function-blocks (opt-gep-offset-test-run variant))
    (opt-gep-offset-test-blocks variant)))

(define (compiler-optimize-gep-offset-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [split : ir.CompilerIrFunction (opt-gep-offset-test-run 0)]
    [split-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view split))]
    [twice : ir.CompilerIrFunction
      (opt-gep-offset-function
        bases
        (opt.compiler-opt-global-shared-view split))]
    [shared : ir.CompilerIrFunction (opt-gep-offset-test-run 4)]
    [shared-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view shared))]
    [synthesized : ir.CompilerIrFunction (opt-gep-offset-test-run 5)]
    [synthesized-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view synthesized))]
    [two-offsets : ir.CompilerIrFunction (opt-gep-offset-test-run 6)]
    [two-offset-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view two-offsets))]
    [stranded : ir.CompilerIrFunction (opt-gep-offset-test-run 7)]
    [stranded-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view stranded))]
    (cond
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view split))))
        1]
      ;; the derived base lands in the existing preheader (the entry block),
      ;; and the body keeps its one Gep
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view split-blocks)
              (ir.compiler-ir-label "entry"))
            1))
        2]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view split-blocks)
              (ir.compiler-ir-label "body"))
            1))
        3]
      [(not
          (opt-gep-offset-test-body-index-is-counter?
            (ir.compiler-ir-global-shared-view split-blocks)))
        4]
      ;; one fresh var for the one derived base
      [(not (= (opt.opt-function-frame split) 25)) 5]
      ;; a non-address consumer of the Add rejects the whole Add
      [(not (opt-gep-offset-test-unchanged? 1)) 6]
      ;; the addend would survive the rewrite and only one base pays for it
      [(not (opt-gep-offset-test-unchanged? 2)) 7]
      ;; the Gep base is loop variant: no preheader home for the derived base
      [(not (opt-gep-offset-test-unchanged? 3)) 8]
      ;; two bases DO pay for a surviving addend: one derived base each
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view shared))))
        9]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              shared-blocks
              (ir.compiler-ir-label "entry"))
            2))
        10]
      [(not (= (opt.opt-function-frame shared) 26)) 11]
      ;; a guard with two successors is not a preheader, so one is synthesized
      ;; ahead of the header and the derived base lands there
      [(not (opt.opt-verify-ok? (opt.opt-verify-function synthesized))) 12]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view synthesized-blocks))
            5))
        13]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              synthesized-blocks
              (ir.compiler-ir-label "loop__preheader"))
            1))
        14]
      ;; idempotence: the next pipeline iteration finds no Add left to split
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view twice))))
        15]
      [(not
          (opt.opt-block-list-eq
            bases
            split-blocks
            (opt.opt-function-blocks twice)))
        16]
      ;; one array at two invariant offsets: a derived base each, carrying the
      ;; two different offsets
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view two-offsets))))
        17]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view two-offset-blocks)
              (ir.compiler-ir-label "entry"))
            2))
        18]
      [(not
          (opt-gep-offset-test-derived-offsets-distinct?
            two-offset-blocks
            (ir.compiler-ir-label "entry")))
        19]
      [(not (= (opt.opt-function-frame two-offsets) 26)) 20]
      ;; a dead Cast of the Add is retired by the pipeline DCE, so it must not
      ;; hold the split back
      [(not (opt.opt-verify-ok? (opt.opt-verify-function stranded))) 21]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view stranded-blocks)
              (ir.compiler-ir-label "entry"))
            1))
        22]
      [(not (opt-gep-offset-test-body-index-is-counter? stranded-blocks)) 23]
      [else 42])))

(test
  gep-offset-invariant-split
  (test.assert-i64-eq
    (compiler-optimize-gep-offset-self-test)
    42
    "invariant-offset Gep splitting hoists one derived base per (base, type), gates on all-uses and register pressure, synthesizes a missing preheader, and is idempotent"))

;; --- invariant-offset Gep splitting: the nested / unrolled shapes ------------
;; `liveness_storage/recompute!`'s inner scan, which is how every 2-D walk in
;; the corpus indexes: an OUTER loop derives the row base in its landing block
;; and the INNER loop reads `data[row + i]`, entered from a two-successor guard
;; so its header has no dedicated preheader. The variant selector perturbs one
;; gate at a time:
;;   0  one access, and the addend is defined in the ENCLOSING loop -- invariant
;;      for the loop being processed wherever it is defined, so this splits
;;   1  TWO accesses on ONE base sharing that addend (the unroll clone shape)
;;      while the addend ALSO feeds an in-loop non-address use: k >= 2 accesses
;;      pay for the surviving addend, and both Geps adopt the SAME derived base
;;   2  the same surviving addend with only ONE access: k = 1 does not pay for
;;      it, so the pressure gate rejects
;;   3  the Gep base is LOADED in the outer loop's landing block: a load outside
;;      the inner loop is still invariant for it, so this splits
(define (opt-gep-nested-test-latch-tail) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%30 = add %20, 1 : i64
     %31 = lt %30, %2 : bool
     branch %31, inner, latch"))

;; A non-address in-loop reader of the invariant addend, kept live by a store so
;; the dead-use settling cannot retire it: the addend outlives the rewrite, which
;; is exactly what the k >= 2 gate judges.
(define (opt-gep-nested-test-addend-use [variant : i64]) : ir.CompilerIrInstrSeq
  (if (or (= variant 1) (= variant 2))
    (opt-test-instr-seq-prepend
      (irt.instr "%28 = mul %13, 3 : i64")
      (opt-test-instr-seq-prepend
        (irt.instr "store_ptr %22, %28 : i64")
        (opt-gep-nested-test-latch-tail)))
    (opt-gep-nested-test-latch-tail)))

;; Variant 1's second access: the unroll clone's `data[row + i + 1]`, a second
;; Add on the same base and the same addend at the next counter offset.
(define (opt-gep-nested-test-second-access
  [variant : i64]
  [base : ir.CompilerIrValue]) : ir.CompilerIrInstrSeq
  (if (= variant 1)
    (opt-test-instr-seq-prepend
      (irt.instr "%25 = add %20, 1 : i64")
      (opt-test-instr-seq-prepend
        (irt.instr "%24 = add %13, %25 : i64")
        (opt-test-instr-seq-prepend
          (ir.CompilerIrInstr.Gep
            26
            base
            (ir.CompilerIrValue.Var 24)
            (ast.AstType.I64))
          (opt-test-instr-seq-prepend
            (irt.instr "%27 = load %26 : i64")
            (opt-gep-nested-test-addend-use variant)))))
    (opt-gep-nested-test-addend-use variant)))

(define (opt-gep-nested-test-inner-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (let
    [base : ir.CompilerIrValue
      (if (= variant 3)
        (ir.CompilerIrValue.Var 15)
        (ir.CompilerIrValue.Var 1))]
    (opt-test-instr-seq-prepend
      (irt.instr "%20 = phi [0, iguard], [%30, inner] : i64")
      (opt-test-instr-seq-prepend
        (irt.instr "%21 = add %13, %20 : i64")
        (opt-test-instr-seq-prepend
          (ir.CompilerIrInstr.Gep
            22
            (ir.compiler-ir-global-shared-view base)
            (ir.CompilerIrValue.Var 21)
            (ast.AstType.I64))
          (opt-test-instr-seq-prepend
            (irt.instr "%23 = load %22 : i64")
            (opt-gep-nested-test-second-access variant base)))))))

;; The outer loop's landing block: the row base the inner loop indexes from, and
;; the descriptor load that variant 3 uses as the Gep base.
(define (opt-gep-nested-test-land-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%12 = mul %10, %2 : i64
     %13 = add %12, %3 : i64
     %14 = gep %0, 0 : i64
     %15 = load %14 : i64
     jump iguard"))

(define (opt-gep-nested-test-outer-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = phi [0, entry], [%40, latch] : i64
     %11 = lt %10, %2 : bool
     branch %11, land, exit"))

(define (opt-gep-nested-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump outer")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "outer")
        (opt-gep-nested-test-outer-instrs))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "land")
          (opt-gep-nested-test-land-instrs))
        (ir.compiler-ir-block-cons
          (irt.block "iguard:
               branch %11, inner, latch")
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "inner")
              (opt-gep-nested-test-inner-instrs variant))
            (irt.blocks
              "latch:
                 %40 = add %10, 1 : i64
                 jump outer
               exit:
                 return 0")))))))

(define (opt-gep-nested-test-params) : ir.CompilerIrParamSeq
  (irt.params "descriptor=%0:i64, data=%1:i64, words=%2:i64, word-base=%3:i64"))

(define (opt-gep-nested-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "gep_offset_nested")
    (opt-gep-nested-test-params)
    (ast.AstType.I64)
    48
    (opt-gep-nested-test-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-gep-nested-test-run [variant : i64]) : ir.CompilerIrFunction
  (opt-gep-offset-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-gep-nested-test-function variant)))

(define (opt-gep-nested-test-nth-gep-base
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [skip : i64]) : ir.CompilerIrValue
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (ir.CompilerIrValue.I64 (- 0 1))
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Gep _ base _ _)
        (if (= skip 0)
          base
          (opt-gep-nested-test-nth-gep-base instrs (+ index 1) (- skip 1)))]
      [_ (opt-gep-nested-test-nth-gep-base instrs (+ index 1) skip)])))

;; The offset / base operand of the nth Gep in the block that carries `label`.
(define (opt-gep-nested-test-gep-offset-in
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [nth : i64]) : ir.CompilerIrValue
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (ir.CompilerIrValue.I64 (- 0 1))]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-gep-offset-test-nth-gep-offset instrs 0 nth)])]))

(define (opt-gep-nested-test-gep-base-in
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [nth : i64]) : ir.CompilerIrValue
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (ir.CompilerIrValue.I64 (- 0 1))]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-gep-nested-test-nth-gep-base instrs 0 nth)])]))

(define (opt-gep-nested-test-unchanged? [variant : i64]) : bool
  (opt.opt-block-list-eq
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt.opt-function-blocks (opt-gep-nested-test-run variant))
    (opt-gep-nested-test-blocks variant)))

(define (compiler-optimize-gep-offset-nested-self-test) : i64
  (let
    [inner-label : i64 (ir.compiler-ir-label "inner")]
    [pre-label : i64 (ir.compiler-ir-label "inner__preheader")]
    [outer-addend : ir.CompilerIrFunction (opt-gep-nested-test-run 0)]
    [outer-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view outer-addend))]
    [family : ir.CompilerIrFunction (opt-gep-nested-test-run 1)]
    [family-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view family))]
    [landing : ir.CompilerIrFunction (opt-gep-nested-test-run 3)]
    [landing-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view landing))]
    (cond
      ;; an addend defined in the ENCLOSING loop is invariant for this one, and
      ;; the two-successor guard gets a synthesized preheader for the split
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view outer-addend))))
        1]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view outer-blocks))
            8))
        2]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view outer-blocks)
              pre-label)
            1))
        3]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in
              (ir.compiler-ir-global-shared-view outer-blocks)
              pre-label
              0)
            (ir.CompilerIrValue.Var 13)))
        4]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view outer-blocks)
              inner-label)
            1))
        5]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in outer-blocks inner-label 0)
            (ir.CompilerIrValue.Var 20)))
        6]
      [(not (= (opt.opt-function-frame outer-addend) 49)) 7]
      ;; two accesses sharing one base and one addend are one family: k >= 2
      ;; pays for the surviving addend and ONE derived base serves both
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view family))))
        8]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view family-blocks)
              pre-label)
            1))
        9]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view family-blocks)
              inner-label)
            2))
        10]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in
              (ir.compiler-ir-global-shared-view family-blocks)
              inner-label
              0)
            (ir.CompilerIrValue.Var 20)))
        11]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in
              (ir.compiler-ir-global-shared-view family-blocks)
              inner-label
              1)
            (ir.CompilerIrValue.Var 25)))
        12]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-base-in
              (ir.compiler-ir-global-shared-view family-blocks)
              inner-label
              0)
            (opt-gep-nested-test-gep-base-in family-blocks inner-label 1)))
        13]
      [(not (= (opt.opt-function-frame family) 49)) 14]
      ;; one access does NOT pay for a surviving addend
      [(not (opt-gep-nested-test-unchanged? 2)) 15]
      ;; a base LOADED in the outer loop's landing block is invariant here
      [(not (opt.opt-verify-ok? (opt.opt-verify-function landing))) 16]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view landing-blocks)
              pre-label)
            1))
        17]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-base-in
              (ir.compiler-ir-global-shared-view landing-blocks)
              pre-label
              0)
            (ir.CompilerIrValue.Var 15)))
        18]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in landing-blocks inner-label 0)
            (ir.CompilerIrValue.Var 20)))
        19]
      [else 42])))

(test
  gep-offset-nested-invariant-addend
  (test.assert-i64-eq
    (compiler-optimize-gep-offset-nested-self-test)
    42
    "an outer-loop-defined addend, a family of Adds sharing one base and one addend, and a base loaded in the landing block all split; one access does not pay for a surviving addend"))

;; --- invariant-offset Gep splitting: a refused preheader is not fatal --------
;; Two candidate loops. `rem` comes first in block order and its header phi takes
;; DIFFERENT values from its two outside predecessors, so
;; `opt-loop-preheaders-header-reason` cannot fold them into one preheader
;; and synthesis refuses -- the shape every unrolled loop's REMAINDER header has
;; (the unroll guard supplies 0, the unroll body supplies the counter). `loopb`
;; behind it is an ordinary preheaderless candidate. Ending the synthesis round
;; at `rem` left `loopb` without a preheader and the pass rewrote nothing.
(define (opt-gep-starved-test-rem-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = phi [0, apre1], [%2, apre2], [%13, rem] : i64
     %11 = add %3, %10 : i64
     %12 = gep %0, %11 : i64
     %14 = load %12 : i64
     %13 = add %10, 1 : i64
     %15 = lt %13, %2 : bool
     branch %15, rem, bguard"))

(define (opt-gep-starved-test-loopb-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%20 = phi [0, bguard], [%23, loopb] : i64
     %21 = add %3, %20 : i64
     %22 = gep %1, %21 : i64
     %24 = load %22 : i64
     %23 = add %20, 1 : i64
     %25 = lt %23, %2 : bool
     branch %25, loopb, exit"))

(define (opt-gep-starved-test-jump-to-rem) : ir.CompilerIrInstrSeq
  (irt.instrs "jump rem"))

(define (opt-gep-starved-test-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %6 = lt 0, %2 : bool
         branch %6, apre1, apre2")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "apre1")
        (opt-gep-starved-test-jump-to-rem))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "apre2")
          (opt-gep-starved-test-jump-to-rem))
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "rem")
            (opt-gep-starved-test-rem-instrs))
          (ir.compiler-ir-block-cons
            (irt.block "bguard:
                 branch %6, loopb, exit")
            (ir.compiler-ir-block-cons
              (ir.CompilerIrBlock.Block
                (ir.compiler-ir-label "loopb")
                (opt-gep-starved-test-loopb-instrs))
              (irt.blocks "exit:
                   return 0"))))))))

(define (opt-gep-starved-test-run) : ir.CompilerIrFunction
  (opt-gep-offset-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (ir.CompilerIrFunction.Function
      (opt-test-symbol "gep_offset_starved")
      (opt-gep-nested-test-params)
      (ast.AstType.I64)
      32
      (opt-gep-starved-test-blocks)
      ir.CompilerIrFunctionAbi.Ordinary)))

(define (compiler-optimize-gep-offset-starved-self-test) : i64
  (let
    [split : ir.CompilerIrFunction (opt-gep-starved-test-run)]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view split))]
    [pre-label : i64 (ir.compiler-ir-label "loopb__preheader")]
    [loopb-label : i64 (ir.compiler-ir-label "loopb")]
    [rem-label : i64 (ir.compiler-ir-label "rem")]
    (cond
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view split))))
        1]
      ;; the second loop got its preheader even though the first refused one
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view blocks))
            8))
        2]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view blocks)
              pre-label)
            1))
        3]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in
              (ir.compiler-ir-global-shared-view blocks)
              pre-label
              0)
            (ir.CompilerIrValue.Var 3)))
        4]
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view blocks)
              loopb-label)
            1))
        5]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in
              (ir.compiler-ir-global-shared-view blocks)
              loopb-label
              0)
            (ir.CompilerIrValue.Var 20)))
        6]
      ;; the refused loop is left exactly as it was
      [(not
          (=
            (opt-gep-offset-test-geps-in
              (ir.compiler-ir-global-shared-view blocks)
              rem-label)
            1))
        7]
      [(not
          (opt.opt-value-eq
            (opt-gep-nested-test-gep-offset-in blocks rem-label 0)
            (ir.CompilerIrValue.Var 11)))
        8]
      [(not (= (opt.opt-function-frame split) 33)) 9]
      [else 42])))

(test
  gep-offset-refused-preheader-not-fatal
  (test.assert-i64-eq
    (compiler-optimize-gep-offset-starved-self-test)
    42
    "a loop whose preheader cannot be synthesized only skips itself: later candidate loops still get theirs and split"))

;; --- monotone-flag loop-exit conversion self-tests ----------------------------
;; One `(while (and (< i n) ok) ... (set! ok false))` loop in the shape
;; `it-slice-eq?` reaches the pass with, with the variant selector perturbing
;; exactly one condition at a time:
;;   0  the plain shape: the flag only ever clears, gates the loop, and dies at
;;      the exit phi -- this converts, and is the enabled control every negative
;;      variant below is one edit away from
;;   1  the gate reads `not flag` instead of the flag -- how
;;      `(while (and (< i n) (not done)) ...)` lowers, and the shape
;;      it-map-insert-from and gvn_table's probe loops have -- so C3 takes the
;;      arms the other way round and converts, and the `not` goes with the
;;      branch it fed
;;   2  the loop counter is read after the loop (ls-scan-symbol-end's shape:
;;      a scan returning its counter) from a position the gate's exit arm does
;;      NOT dominate, so C8 rejects
;;   3  the flag itself is returned rather than reaching an exit phi
;;      (pl-ranges-eq?'s shape): the gate's arm collapses onto the return block
;;      and C8 mints the exit phi that carries the answer
;;   4  a call sits on the path the redirect would skip (pl-run-chunk's shape),
;;      so C6 rejects
;;   5  the gate's exit arm has a second predecessor (gd-dijkstra's shape), so
;;      C7 rejects
;;   6  `(set! ok true)` from a false seed, resolved through an intermediate phi
;;      and a Mov: K = false, C = true, and the gate's arms are swapped
;;   7  the gate's exit arm jumps INTO the counter-exhausted exit instead of the
;;      shared merge -- the shape a loop that tests the flag BEFORE the counter
;;      lowers to (`opt-symbol-leaf-matches-from?`) -- so C7's separation clause
;;      rejects
;;   8  the gate reads `eq flag, true`, C3's other helper shape, which selects
;;      the arms exactly as the bare flag does and converts
;; Variants 2-5 and 7 each keep every other condition satisfied, so a variant
;; that stopped rejecting would convert rather than silently pass.
(define (opt-flag-exit-test-entry-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))

(define (opt-flag-exit-test-seed [variant : i64]) : ir.CompilerIrValue
  (if (= variant 6)
    (ir.CompilerIrValue.Bool false)
    (ir.CompilerIrValue.Bool true)))

(define (opt-flag-exit-test-loop-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%10 = phi [0, entry], [%14, latch] : i64")
    (ir.CompilerIrInstr.Phi
      11
      (ir.compiler-ir-phi-input-seq-prepend
        (opt-flag-exit-test-seed variant)
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.Var 13)
          (ir.compiler-ir-label "latch")
          (ir.compiler-ir-phi-input-seq-empty)))
      (ast.AstType.Bool))
    (irt.instr "%12 = lt %10, %1 : bool")
    (irt.instr "branch %12, gate, done_full")))

;; Variant 1 routes the flag through a `not` on the way to the branch, which
;; swaps which arm the cleared flag selects; variant 8 routes it through
;; `eq flag, true`, which does not.
(define (opt-flag-exit-test-gate-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (cond
    [(= variant 1)
      (irt.instrs "%18 = not %11 : bool
         branch %18, done_early, body")]
    [(= variant 8)
      (irt.instrs
        "%18 = eq %11, true : bool
         branch %18, body, done_early")]
    [else
      (opt-test-instrs
        (if (= variant 6)
          (irt.instr "branch %11, done_early, body")
          (irt.instr "branch %11, body, done_early")))]))

(define (opt-flag-exit-test-body-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%15 = gep %0, %10 : i64
     %16 = load %15 : i64
     %17 = eq %16, %2 : bool
     branch %17, match, mismatch"))

;; Variant 4 puts a call on the block the redirect would jump past.
(define (opt-flag-exit-test-latch-tail [variant : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (if (= variant 4)
      (opt-test-instrs
        (ir.CompilerIrInstr.Call
          19
          cbi.compiler-builtin-id-tl-abort-label
          (ir.CompilerIrCallArgs.Nil)
          (ast.AstType.Unit))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop")))
      (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
    (irt.instr "%14 = add %10, 1 : i64")))

;; Variant 6 clears to `true` and resolves the flag through an extra phi and a
;; Mov, which is the transitive leg of the closure walk.
(define (opt-flag-exit-test-latch-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 6)
    (opt-test-instrs-with-tail
      (opt-flag-exit-test-latch-tail variant)
      (irt.instr "%18 = phi [true, mismatch], [%11, match] : bool")
      (ir.CompilerIrInstr.Mov 13 (ir.CompilerIrValue.Var 18) (ast.AstType.Bool)))
    (opt-test-instrs-with-tail
      (opt-flag-exit-test-latch-tail variant)
      (irt.instr "%13 = phi [false, mismatch], [%11, match] : bool"))))

;; Variant 5 sends the counter-exhausted exit through the gate's arm instead of
;; straight to the merge, so that arm acquires a second predecessor.
(define (opt-flag-exit-test-done-full-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Jump
      (if (= variant 5)
        (ir.compiler-ir-label "done_early")
        (ir.compiler-ir-label "exit")))))

(define (opt-flag-exit-test-exit-phi [variant : i64]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Phi
    20
    (if (= variant 7)
      (ir.compiler-ir-phi-input-seq-prepend
        (ir.CompilerIrValue.Var 11)
        (ir.compiler-ir-label "done_full")
        (ir.compiler-ir-phi-input-seq-empty))
      (ir.compiler-ir-phi-input-seq-prepend
        (ir.CompilerIrValue.Var 11)
        (ir.compiler-ir-label "done_early")
        (if (= variant 5)
          (ir.compiler-ir-phi-input-seq-empty)
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 11)
            (ir.compiler-ir-label "done_full")
            (ir.compiler-ir-phi-input-seq-empty)))))
    (ast.AstType.Bool)))

;; Variant 2 reads the loop counter after the loop; variant 3 returns the flag
;; itself instead of letting the exit phi carry it out.
(define (opt-flag-exit-test-exit-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 3)
    (irt.instrs "return %11")
    (opt-test-instrs-with-tail
      (if (= variant 2)
        (irt.instrs
          "%21 = lt %10, %1 : bool
           %22 = and %20, %21 : bool
           return %22")
        (irt.instrs "return %20"))
      (opt-flag-exit-test-exit-phi variant))))

(define (opt-flag-exit-test-jump-block [label : String] [target : String]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label label)
    (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label target)))))

(define (opt-flag-exit-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-flag-exit-test-entry-instrs))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-flag-exit-test-loop-instrs variant))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "gate")
          (opt-flag-exit-test-gate-instrs variant))
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "body")
            (opt-flag-exit-test-body-instrs))
          (ir.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "match" "latch")
            (ir.compiler-ir-block-cons
              (opt-flag-exit-test-jump-block "mismatch" "latch")
              (ir.compiler-ir-block-cons
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "latch")
                  (opt-flag-exit-test-latch-instrs variant))
                (ir.compiler-ir-block-cons
                  (opt-flag-exit-test-jump-block
                    "done_early"
                    (if (= variant 7)
                      "done_full"
                      "exit"))
                  (ir.compiler-ir-block-cons
                    (ir.CompilerIrBlock.Block
                      (ir.compiler-ir-label "done_full")
                      (opt-flag-exit-test-done-full-instrs variant))
                    (ir.compiler-ir-block-cons
                      (ir.CompilerIrBlock.Block
                        (ir.compiler-ir-label "exit")
                        (opt-flag-exit-test-exit-instrs variant))
                      (ir.CompilerIrBlockList.Nil))))))))))))

(define (opt-flag-exit-test-params) : ir.CompilerIrParamSeq
  (irt.params "base=%0:i64, n=%1:i64, want=%2:i64"))

(define (opt-flag-exit-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "flag_exit")
    (opt-flag-exit-test-params)
    (ast.AstType.Bool)
    23
    (opt-flag-exit-test-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-flag-exit-test-run [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-flag-exit-function (opt-flag-exit-test-function variant)))

;; --- shape probes -------------------------------------------------------------
(define (opt-flag-exit-test-last-instr
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : opt.OptFlagExitMaybeInstr
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (opt.OptFlagExitMaybeInstr.No)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              (opt.OptFlagExitMaybeInstr.No)
              (opt.OptFlagExitMaybeInstr.Some
                (ir.compiler-ir-instr-seq-ref instrs (- count 1)))))])]))

;; The label a block's terminating Jump targets; -1 when it does not end in one.
(define (opt-flag-exit-test-jump-target
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt-flag-exit-test-last-instr blocks label)
    [(opt.OptFlagExitMaybeInstr.No) (- 0 1)]
    [(opt.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.Jump target) target]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-jumps-to?
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [target : String]) : bool
  (=
    (opt-flag-exit-test-jump-target blocks label)
    (ir.compiler-ir-label target)))

(define (opt-flag-exit-test-phi-in-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : ir.CompilerIrPhiInputSeq
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    (ir.compiler-ir-phi-input-seq-empty)
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.Phi found inputs _)
        (if (= found dst)
          inputs
          (opt-flag-exit-test-phi-in-instrs instrs (+ pos 1) dst))]
      [_ (opt-flag-exit-test-phi-in-instrs instrs (+ pos 1) dst)])))

(define (opt-flag-exit-test-phi-inputs
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : ir.CompilerIrPhiInputSeq
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (ir.compiler-ir-phi-input-seq-empty)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-test-phi-in-instrs instrs 0 dst)])]))

;; 1 when the phi input on `pred` is the literal `true`, 0 when it is `false`,
;; -1 for anything else (including a missing input).
(define (opt-flag-exit-test-phi-bool
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]
  [pred : String]) : i64
  (match (opt.opt-thread-phi-input-value
    (opt-flag-exit-test-phi-inputs blocks label dst)
    (ir.compiler-ir-label pred))
    [(ir.CompilerIrMaybeValue.No) (- 0 1)]
    [(ir.CompilerIrMaybeValue.Some value)
      (match value
        [(ir.CompilerIrValue.Bool literal)
          (if literal
            1
            0)]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-phi-input-count
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : i64
  (ir.compiler-ir-phi-input-seq-count
    (opt-flag-exit-test-phi-inputs blocks label dst)))

;; 1 when the block's first instruction is `dst = mov <literal>`, 0 otherwise.
(define (opt-flag-exit-test-mov-bool
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-test-mov-scan instrs 0 dst)])]))

(define (opt-flag-exit-test-mov-scan
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : i64
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.Mov found src _)
        (if (= found dst)
          (match src
            [(ir.CompilerIrValue.Bool literal)
              (if literal
                1
                0)]
            [_ (- 0 1)])
          (opt-flag-exit-test-mov-scan instrs (+ pos 1) dst))]
      [_ (opt-flag-exit-test-mov-scan instrs (+ pos 1) dst)])))

;; Predecessors of `label`, counted straight off the terminators so the probe
;; does not depend on the pass's own CFG machinery.
(define (opt-flag-exit-test-targets-label?
  [instr : ir.CompilerIrInstr]
  [label : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump target) (= target label)]
    [(ir.CompilerIrInstr.Branch _ true-label false-label)
      (or (= true-label label) (= false-label label))]
    [_ false]))

(define (opt-flag-exit-test-pred-count
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (opt-flag-exit-test-pred-count-from blocks (ir.compiler-ir-label label)))

(define (opt-flag-exit-test-pred-count-from
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (+
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
              (if (= count 0)
                0
                (if (opt-flag-exit-test-targets-label?
                  (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                  label)
                  1
                  0)))])
        (opt-flag-exit-test-pred-count-from (deref rest) label))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-flag-exit-test-pred-count-from
        (ir.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-flag-exit-test-instr-count
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (ir.compiler-ir-instr-seq-count instrs)])]))

(define (opt-flag-exit-test-unchanged? [variant : i64]) : bool
  (opt.opt-block-list-eq
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt.opt-function-blocks (opt-flag-exit-test-run variant))
    (opt-flag-exit-test-blocks variant)))

;; The negative control for every rejecting variant: the pass's own entry verify
;; also returns the input untouched, so a fixture that the verifier rejected
;; would "pass" its rejection assertion for the wrong reason.
(define (opt-flag-exit-test-input-verifies? [variant : i64]) : bool
  (opt.opt-verify-ok?
    (opt.opt-verify-function (opt-flag-exit-test-function variant))))

(define (opt-flag-exit-test-rejects? [variant : i64]) : bool
  (and
    (opt-flag-exit-test-input-verifies? variant)
    (opt-flag-exit-test-unchanged? variant)))

(define (compiler-optimize-flag-exit-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [converted : ir.CompilerIrFunction (opt-flag-exit-test-run 0)]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view converted))]
    [twice : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-flag-exit-function
          (opt.compiler-opt-global-shared-view converted)))]
    [set-true : ir.CompilerIrFunction (opt-flag-exit-test-run 6)]
    [set-true-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view set-true))]
    [negated : ir.CompilerIrFunction (opt-flag-exit-test-run 1)]
    [negated-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view negated))]
    [compared : ir.CompilerIrFunction (opt-flag-exit-test-run 8)]
    [compared-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view compared))]
    [returned : ir.CompilerIrFunction (opt-flag-exit-test-run 3)]
    [returned-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view returned))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function converted))) 1]
      ;; the gate stopped testing the flag
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view blocks)
            "gate"
            "body"))
        2]
      ;; and the clear site leaves the loop directly
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view blocks)
            "mismatch"
            "done_early"))
        3]
      ;; the clear edge is gone from the latch phi
      [(not
          (=
            (opt-flag-exit-test-phi-input-count
              (ir.compiler-ir-global-shared-view blocks)
              "latch"
              13)
            1))
        4]
      ;; the exit phi carries the answer as literals: cleared on the gate's arm,
      ;; still set on the counter-exhausted arm
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "exit"
              20
              "done_early")
            0))
        5]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "exit"
              20
              "done_full")
            1))
        6]
      ;; no exit gained a predecessor
      [(not
          (=
            (opt-flag-exit-test-pred-count
              (ir.compiler-ir-global-shared-view blocks)
              "exit")
            (opt-flag-exit-test-pred-count (opt-flag-exit-test-blocks 0) "exit")))
        7]
      [(not
          (=
            (opt-flag-exit-test-pred-count
              (ir.compiler-ir-global-shared-view blocks)
              "done_early")
            1))
        8]
      ;; the flag's own definitions are pinned to the continuing constant, so
      ;; the phi <-> phi cycle is broken and DCE can retire them
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "loop"
              11
              "entry")
            1))
        9]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "loop"
              11
              "latch")
            1))
        10]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "latch"
              13
              "match")
            1))
        11]
      ;; idempotence: the next pipeline iteration finds nothing left to convert
      [(not (opt.opt-block-list-eq bases blocks twice)) 12]
      ;; C3: a `not` between the flag and the branch swaps the arms and the
      ;; helper goes with the branch it fed -- the gate block is left with its
      ;; jump alone
      [(not (opt.opt-verify-ok? (opt.opt-verify-function negated))) 26]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view negated-blocks)
            "gate"
            "body"))
        13]
      [(not
          (=
            (opt-flag-exit-test-instr-count
              (ir.compiler-ir-global-shared-view negated-blocks)
              "gate")
            1))
        27]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view negated-blocks)
            "mismatch"
            "done_early"))
        28]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view negated-blocks)
              "exit"
              20
              "done_early")
            0))
        29]
      [(not
          (=
            (opt-flag-exit-test-phi-bool negated-blocks "exit" 20 "done_full")
            1))
        30]
      ;; C3: `eq flag, true` keeps the arms as the bare flag has them
      [(not (opt.opt-verify-ok? (opt.opt-verify-function compared))) 31]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view compared-blocks)
            "gate"
            "body"))
        32]
      [(not
          (=
            (opt-flag-exit-test-instr-count
              (ir.compiler-ir-global-shared-view compared-blocks)
              "gate")
            1))
        33]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view compared-blocks)
            "mismatch"
            "done_early"))
        34]
      [(not
          (=
            (opt-flag-exit-test-phi-bool compared-blocks "exit" 20 "done_early")
            0))
        35]
      ;; C8: the loop counter is read after the loop
      [(not (opt-flag-exit-test-rejects? 2)) 14]
      ;; C8: the flag itself is returned, so the exit phi minted at the
      ;; collapsed arm carries it -- cleared on the redirected edge, still set
      ;; on the counter-exhausted one
      [(not (opt.opt-verify-ok? (opt.opt-verify-function returned))) 15]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view returned-blocks)
            "gate"
            "body"))
        36]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view returned-blocks)
            "mismatch"
            "exit"))
        37]
      [(not
          (=
            (opt-flag-exit-test-instr-count
              (ir.compiler-ir-global-shared-view returned-blocks)
              "done_early")
            (- 0 1)))
        38]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view returned-blocks)
              "exit"
              23
              "mismatch")
            0))
        39]
      [(not
          (=
            (opt-flag-exit-test-phi-var returned-blocks "exit" 23 "done_full")
            11))
        40]
      ;; C6: a call sits on the path the redirect skips
      [(not (opt-flag-exit-test-rejects? 4)) 16]
      ;; C7: the gate's exit arm has a second predecessor
      [(not (opt-flag-exit-test-rejects? 5)) 17]
      ;; C7: the gate's exit arm falls INTO the counter-exhausted exit, so a
      ;; cleared path traverses that exit's edge and the fold would call it
      ;; continuing
      [(not (opt-flag-exit-test-rejects? 7)) 25]
      ;; a false seed cleared to `true` through a phi and a Mov converts the
      ;; same way, with the gate's arms the other way round
      [(not (opt.opt-verify-ok? (opt.opt-verify-function set-true))) 18]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view set-true-blocks)
            "gate"
            "body"))
        19]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view set-true-blocks)
            "mismatch"
            "done_early"))
        20]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view set-true-blocks)
              "exit"
              20
              "done_early")
            1))
        21]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view set-true-blocks)
              "exit"
              20
              "done_full")
            0))
        22]
      [(not
          (=
            (opt-flag-exit-test-mov-bool
              (ir.compiler-ir-global-shared-view set-true-blocks)
              "latch"
              13)
            0))
        23]
      [(not
          (= (opt-flag-exit-test-phi-bool set-true-blocks "latch" 18 "match") 0))
        24]
      [else 42])))

(test
  flag-exit-monotone-loop-exit
  (test.assert-i64-eq
    (compiler-optimize-flag-exit-self-test)
    42
    "a loop-carried bool that only clears becomes a direct exit jump at the clear site, adds no exit predecessor, and rejects every shape that could observe the retired flag"))

;; --- flag values a dominating branch decided ----------------------------------
;; entry tests the flag %0 and only `outer` is below its true edge, so %0 is
;; true in `outer` and everything it dominates. bounds_dom's rewrite
;; (branches only):
;;   * `body`'s re-test of %0 becomes `branch true`;
;;   * the loop header's seed is left for flag_exit, so it stays %0;
;;   * `join` is not a loop header, so its %0 input stays %0 even though the
;;     fact holds in `left` -- a flag's in-loop web is flag_exit's to read;
;;   * entry's own test, above the fact, stays %0.
;; flag_exit's seed trial for `head`:
;;   * the header's SEED input (from `outer`, a forward edge) becomes true;
;;   * the header's back-edge input, `body`'s branch and `join` are untouched.
(define (opt-flag-facts-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, outer, done
     outer:
       jump head
     head:
       %2 = phi [%0, outer], [%3, join] : bool
       branch %2, body, done
     body:
       branch %0, check, done
     check:
       branch %1, left, right
     left:
       jump join
     right:
       jump join
     join:
       %3 = phi [%0, left], [false, right] : bool
       jump head
     done:
       return false"))

(define (opt-flag-facts-test-params) : ir.CompilerIrParamSeq
  (irt.params "flag=%0:bool, more=%1:bool"))

;; The value a block's first phi carries in from `pred`, or Unit.
(define (opt-flag-facts-test-phi-input
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [pred : String]) : ir.CompilerIrValue
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) ir.CompilerIrValue.Unit]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (ir.compiler-ir-instr-seq-ref instrs 0)
            [(ir.CompilerIrInstr.Phi _ inputs _)
              (let
                [n : i64
                  (ir.compiler-ir-phi-input-seq-count
                    (ir.compiler-ir-global-shared-view inputs))]
                [pred-label : i64 (ir.compiler-ir-label pred)]
                [k : i64 0]
                [found : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                (begin
                  (while (< k n)
                    (let
                      [input : ir.CompilerIrPhiInput
                        (ir.compiler-ir-phi-input-seq-ref
                          (ir.compiler-ir-global-shared-view inputs)
                          k)]
                      (begin
                        (if (= input.label pred-label)
                          (set! found input.value)
                          unit)
                        (set! k (+ k 1)))))
                  found))]
            [_ ir.CompilerIrValue.Unit])])]))

;; The condition of the Branch ending a block, or Unit.
(define (opt-flag-facts-test-branch-cond
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : ir.CompilerIrValue
  (match (opt-flag-exit-test-last-instr blocks label)
    [(opt.OptFlagExitMaybeInstr.No) ir.CompilerIrValue.Unit]
    [(opt.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.Branch cond _ _) cond]
        [_ ir.CompilerIrValue.Unit])]))

(define (compiler-optimize-flag-facts-self-test) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-flag-facts-test-blocks)]
    [context : opt.OptCfgContext
      (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks))]
    [sources : opt.OptValueSources
      (opt.opt-gvn-sources-blocks
        (ir.compiler-ir-global-shared-view blocks)
        (opt.opt-gvn-sources-params
          (opt-flag-facts-test-params)
          (opt.opt-value-sources-new)))]
    ;; bounds_dom's half: dominated re-tests only.
    [branches : ir.CompilerIrBlockList
      (opt.opt-flag-facts-rewrite-blocks
        (opt.compiler-opt-global-shared-view context.index)
        context.doms
        (opt.compiler-opt-global-shared-view sources)
        (ir.compiler-ir-global-shared-view blocks))]
    ;; flag_exit's half: one header's forward seed.
    [seeded : ir.CompilerIrBlockList
      (match (opt.opt-flag-facts-rewrite-seeds
        context.index
        context.doms
        sources
        (ir.compiler-ir-label "head")
        blocks)
        [(opt.OptFlagSeeded.Some out) out]
        [(opt.OptFlagSeeded.No) ir.CompilerIrBlockList.Nil])]
    (cond
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-branch-cond
              (ir.compiler-ir-global-shared-view branches)
              "body")
            (ir.CompilerIrValue.Bool true)))
        1]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-phi-input
              (ir.compiler-ir-global-shared-view branches)
              "head"
              "outer")
            (ir.CompilerIrValue.Var 0)))
        2]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-phi-input
              (ir.compiler-ir-global-shared-view branches)
              "join"
              "left")
            (ir.CompilerIrValue.Var 0)))
        3]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-branch-cond branches "entry")
            (ir.CompilerIrValue.Var 0)))
        4]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-phi-input
              (ir.compiler-ir-global-shared-view seeded)
              "head"
              "outer")
            (ir.CompilerIrValue.Bool true)))
        5]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-phi-input
              (ir.compiler-ir-global-shared-view seeded)
              "head"
              "join")
            (ir.CompilerIrValue.Var 3)))
        6]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-branch-cond
              (ir.compiler-ir-global-shared-view seeded)
              "body")
            (ir.CompilerIrValue.Var 0)))
        7]
      [(not
          (opt.opt-value-eq
            (opt-flag-facts-test-phi-input seeded "join" "left")
            (ir.CompilerIrValue.Var 0)))
        8]
      [else 42])))

(test
  flag-facts-loop-seed-and-dominated-branch
  (test.assert-i64-eq
    (compiler-optimize-flag-facts-self-test)
    42
    "a flag its own dominating test decided is a literal in a dominated re-test (bounds_dom) and, when flag_exit asks, in that loop header's forward seed -- and nowhere else"))

;; Entry has an implicit incoming edge that is not a CFG predecessor. Neither
;; a self-edge nor a separate latch can decide its condition on the first call.
(define (opt-flag-facts-entry-cycle-test
  [separate-latch : bool]
  [backedge-true : bool]) : i64
  (let
    [entry : i64 (ir.compiler-ir-label "entry")]
    [latch : i64 (ir.compiler-ir-label "latch")]
    [done : i64 (ir.compiler-ir-label "done")]
    [target : i64
      (if separate-latch
        latch
        entry)]
    [tail : ir.CompilerIrBlockList (irt.blocks "done:
           return 42")]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          entry
          (opt-test-instrs
            (ir.CompilerIrInstr.Branch
              (ir.CompilerIrValue.Var 0)
              (if backedge-true
                target
                done)
              (if backedge-true
                done
                target))))
        (if separate-latch
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              latch
              (opt-test-instrs
                (ir.CompilerIrInstr.Branch
                  (ir.CompilerIrValue.Var 0)
                  (if backedge-true
                    entry
                    done)
                  (if backedge-true
                    done
                    entry))))
            tail)
          tail))]
    [func : ir.CompilerIrFunction
      (ir.CompilerIrFunction.Function
        (ir.compiler-ir-test-symbol "flag_entry_cycle")
        (opt-flag-facts-test-params)
        (ast.AstType.I64)
        2
        (ir.compiler-ir-global-shared-view blocks)
        (ir.CompilerIrFunctionAbi.Ordinary))]
    [valid : bool (opt.opt-verify-ok? (opt.opt-verify-function func))]
    [context : opt.OptCfgContext
      (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks))]
    [out : ir.CompilerIrBlockList
      (opt.opt-flag-facts-rewrite-blocks
        context.index
        context.doms
        (opt.opt-gvn-sources-blocks
          (ir.compiler-ir-global-shared-view blocks)
          (opt.opt-gvn-sources-params
            (opt-flag-facts-test-params)
            (opt.opt-value-sources-new)))
        blocks)]
    (if (and
      valid
      (opt.opt-value-eq
        (opt-flag-facts-test-branch-cond out "entry")
        (ir.CompilerIrValue.Var 0)))
      42
      1)))

(test
  flag-facts-entry-backedge
  (begin
    (test.assert-i64-eq
      (opt-flag-facts-entry-cycle-test false true)
      42
      "a true self-edge cannot decide the entry flag")
    (test.assert-i64-eq
      (opt-flag-facts-entry-cycle-test false false)
      42
      "a false self-edge cannot decide the entry flag")
    (test.assert-i64-eq
      (opt-flag-facts-entry-cycle-test true true)
      42
      "a true latch edge cannot decide the entry flag")
    (test.assert-i64-eq
      (opt-flag-facts-entry-cycle-test true false)
      42
      "a false latch edge cannot decide the entry flag")))

;; --- generalized monotone-flag conversion self-tests --------------------------
;; The merged shape the inliner produces and the probe loops intern_table and
;; gvn_table are built from: the counter test leaves the loop through the SAME
;; block the gate's exit arm is, that block carries phis, and the loop's
;; accumulator is read after it. The variant selector perturbs one thing at a
;; time:
;;   0  the plain generalized shape -- X has phis and a second (in-loop)
;;      predecessor, and a header phi is read from X -- so C7 fills X's phi on
;;      the redirected edge and C8 mints an exit phi for the accumulator
;;   1  the clear edge leaves its predecessor on one arm of a Branch rather than
;;      on a Jump, so only that arm is retargeted
;;   2  X reads the loop COUNTER instead of the accumulator, and the counter's
;;      value at the gate is an `add` the redirect would skip, so C8 rejects
;;   3  X's phi reads a header phi whose latch input is an `add` rather than a
;;      phi or a Mov, so the value the redirected edge would have to name does
;;      not exist and C7 rejects
;;   4  an empty block sits between the gate and X, which is how a lowered
;;      `while` reaches this pass; the arm collapses through it onto X and the
;;      spacer goes with the branch that reached it
;;   5  the same spacer, but carrying the lowered `and`'s dead answer ahead of
;;      its jump -- which is what the arm actually holds in pipeline ROUND 1,
;;      the DCE that retires it sitting a whole round below this pass -- so the
;;      arm still collapses through it and the loop converts a round earlier
;;   6  a spacer that does work: a store ahead of the jump, which the redirect
;;      would skip, so C7 refuses and the loop is left alone
(define (opt-flag-exit-gen-clear-pred [variant : i64]) : String
  (if (= variant 1)
    "body"
    "mismatch"))

(define (opt-flag-exit-gen-entry-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))

(define (opt-flag-exit-gen-loop-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = phi [0, entry], [%14, latch] : i64
     %11 = phi [true, entry], [%13, latch] : bool
     %19 = phi [0, entry], [%23, latch] : i64
     %12 = lt %10, %1 : bool
     branch %12, gate, out"))

;; Variants 4-6 put a block between the gate's exit arm and X.
(define (opt-flag-exit-gen-spaced? [variant : i64]) : bool
  (and (>= variant 4) (<= variant 6)))

;; Variants 5 and 6 need a var and a frame slot the mint does not also want.
(define (opt-flag-exit-gen-frame [variant : i64]) : i64
  (if (>= variant 5)
    33
    32))

(define (opt-flag-exit-gen-arm [variant : i64]) : String
  (if (opt-flag-exit-gen-spaced? variant)
    "spacer"
    "out"))

(define (opt-flag-exit-gen-out-pred [variant : i64]) : String
  (if (opt-flag-exit-gen-spaced? variant)
    "spacer"
    "gate"))

;; Variant 4's spacer is empty. Variant 5's carries the dead answer a lowered
;; `(and c f)` materialises on the arm the `and` is false on: pure, and read by
;; nothing, so deleting it with the block changes no value and no effect --
;; which is what lets the collapse look through it in the round the pipeline
;; DCE has not reached it yet. Variant 6's carries a store instead: real work on
;; the edge the redirect jumps past.
(define (opt-flag-exit-gen-spacer-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (cond
    [(= variant 5) (irt.instrs "%32 = mov false : bool
         jump out")]
    [(= variant 6) (irt.instrs "store_ptr %0, %1 : i64
         jump out")]
    [else
      (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "out")))]))

(define (opt-flag-exit-gen-gate-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Branch
      (ir.CompilerIrValue.Var 11)
      (ir.compiler-ir-label "body")
      (ir.compiler-ir-label (opt-flag-exit-gen-arm variant)))))

;; Variant 1 clears on the false arm of the body's own Branch, so the clear
;; predecessor has a second successor the redirect must leave alone.
(define (opt-flag-exit-gen-body-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%15 = gep %0, %10 : i64")
    (ir.CompilerIrInstr.Load 16 (ir.CompilerIrValue.Var 15) (ast.AstType.I64))
    (irt.instr "%17 = eq %16, %2 : bool")
    (ir.CompilerIrInstr.Branch
      (ir.CompilerIrValue.Var 17)
      (ir.compiler-ir-label "match")
      (ir.compiler-ir-label
        (if (= variant 1)
          "latch"
          "mismatch")))))

;; Variant 3 carries the accumulator round the back edge through an `add`
;; instead of a phi, so the redirected edge has no name for its next value.
(define (opt-flag-exit-gen-latch-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Phi
      13
      (ir.compiler-ir-phi-input-seq-prepend
        (ir.CompilerIrValue.Bool false)
        (ir.compiler-ir-label (opt-flag-exit-gen-clear-pred variant))
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.Var 11)
          (ir.compiler-ir-label "match")
          (ir.compiler-ir-phi-input-seq-empty)))
      (ast.AstType.Bool))
    (if (= variant 3)
      (irt.instr "%23 = add %19, 1 : i64")
      (ir.CompilerIrInstr.Phi
        23
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.Var 16)
          (ir.compiler-ir-label (opt-flag-exit-gen-clear-pred variant))
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 19)
            (ir.compiler-ir-label "match")
            (ir.compiler-ir-phi-input-seq-empty)))
        (ast.AstType.I64)))
    (irt.instr "%14 = add %10, 1 : i64")
    (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))

;; Variant 3 puts a loop value the redirect cannot name straight into X's phi;
;; every other variant lets the flag reach it and reads the accumulator (the
;; counter, for variant 2) from X's own block.
(define (opt-flag-exit-gen-out-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 3)
    (irt.instrs
      "%20 = phi [%19, gate], [%19, loop] : i64
       %25 = lt %20, %1 : bool
       return %25")
    (opt-test-instrs
      (ir.CompilerIrInstr.Phi
        20
        (ir.compiler-ir-phi-input-seq-prepend
          (ir.CompilerIrValue.Var 11)
          (ir.compiler-ir-label (opt-flag-exit-gen-out-pred variant))
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.Var 11)
            (ir.compiler-ir-label "loop")
            (ir.compiler-ir-phi-input-seq-empty)))
        (ast.AstType.Bool))
      (ir.CompilerIrInstr.BinOp
        24
        (ir.CompilerIrBinOp.Add)
        (if (= variant 2)
          (ir.CompilerIrValue.Var 10)
          (ir.CompilerIrValue.Var 19))
        (ir.CompilerIrValue.I64 0)
        (ast.AstType.I64))
      (irt.instr "%25 = lt %24, %1 : bool")
      (irt.instr "%26 = and %20, %25 : bool")
      (irt.instr "return %26"))))

(define (opt-flag-exit-gen-tail-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "latch")
      (opt-flag-exit-gen-latch-instrs variant))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "out")
        (opt-flag-exit-gen-out-instrs variant))
      (if (opt-flag-exit-gen-spaced? variant)
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "spacer")
            (opt-flag-exit-gen-spacer-instrs variant))
          (ir.CompilerIrBlockList.Nil))
        (ir.CompilerIrBlockList.Nil)))))

(define (opt-flag-exit-gen-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-flag-exit-gen-entry-instrs))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-flag-exit-gen-loop-instrs))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "gate")
          (opt-flag-exit-gen-gate-instrs variant))
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "body")
            (opt-flag-exit-gen-body-instrs variant))
          (ir.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "match" "latch")
            (if (= variant 1)
              (opt-flag-exit-gen-tail-blocks variant)
              (ir.compiler-ir-block-cons
                (opt-flag-exit-test-jump-block "mismatch" "latch")
                (opt-flag-exit-gen-tail-blocks variant)))))))))

(define (opt-flag-exit-gen-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "flag_exit_general")
    (opt-flag-exit-test-params)
    (ast.AstType.Bool)
    (opt-flag-exit-gen-frame variant)
    (opt-flag-exit-gen-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-flag-exit-gen-run [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-flag-exit-function (opt-flag-exit-gen-function variant)))

(define (opt-flag-exit-gen-rejects? [variant : i64]) : bool
  (and
    (opt.opt-verify-ok?
      (opt.opt-verify-function (opt-flag-exit-gen-function variant)))
    (opt.opt-block-list-eq
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt.opt-function-blocks (opt-flag-exit-gen-run variant))
      (opt-flag-exit-gen-blocks variant))))

;; The var a phi's input on `pred` names, or -1 when the input is missing or is
;; not a var.
(define (opt-flag-exit-test-phi-var
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]
  [pred : String]) : i64
  (match (opt.opt-thread-phi-input-value
    (opt-flag-exit-test-phi-inputs blocks label dst)
    (ir.compiler-ir-label pred))
    [(ir.CompilerIrMaybeValue.No) (- 0 1)]
    [(ir.CompilerIrMaybeValue.Some value)
      (match value
        [(ir.CompilerIrValue.Var var) var]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-binop-lhs-scan
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : i64
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(ir.CompilerIrInstr.BinOp found _ lhs _ _)
        (if (= found dst)
          (match lhs
            [(ir.CompilerIrValue.Var var) var]
            [_ (- 0 1)])
          (opt-flag-exit-test-binop-lhs-scan instrs (+ pos 1) dst))]
      [_ (opt-flag-exit-test-binop-lhs-scan instrs (+ pos 1) dst)])))

(define (opt-flag-exit-test-binop-lhs
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-test-binop-lhs-scan instrs 0 dst)])]))

;; The label a block's terminating Branch takes on its false arm, or -1 when it
;; does not end in one.
(define (opt-flag-exit-test-branch-false
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt-flag-exit-test-last-instr blocks label)
    [(opt.OptFlagExitMaybeInstr.No) (- 0 1)]
    [(opt.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.Branch _ _ false-label) false-label]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-branch-true
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt-flag-exit-test-last-instr blocks label)
    [(opt.OptFlagExitMaybeInstr.No) (- 0 1)]
    [(opt.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(ir.CompilerIrInstr.Branch _ true-label _) true-label]
        [_ (- 0 1)])]))

(define (compiler-optimize-flag-exit-general-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [converted : ir.CompilerIrFunction (opt-flag-exit-gen-run 0)]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view converted))]
    [twice : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-flag-exit-function
          (opt.compiler-opt-global-shared-view converted)))]
    [armed : ir.CompilerIrFunction (opt-flag-exit-gen-run 1)]
    [armed-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view armed))]
    [spaced : ir.CompilerIrFunction (opt-flag-exit-gen-run 4)]
    [spaced-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view spaced))]
    [dead-spaced : ir.CompilerIrFunction (opt-flag-exit-gen-run 5)]
    [dead-spaced-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view dead-spaced))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function converted))) 1]
      ;; the gate stopped testing the flag and the clear site leaves directly,
      ;; even though X carries phis and keeps its counter-exit predecessor
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view blocks)
            "gate"
            "body"))
        2]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view blocks)
            "mismatch"
            "out"))
        3]
      [(not
          (=
            (opt-flag-exit-test-pred-count
              (ir.compiler-ir-global-shared-view blocks)
              "out")
            2))
        4]
      ;; X's phi swapped its gate input for the redirected edge's literal and
      ;; kept the counter exit's
      [(not
          (=
            (opt-flag-exit-test-phi-input-count
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              20)
            2))
        5]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              20
              "mismatch")
            0))
        6]
      [(not
          (=
            (opt-flag-exit-test-phi-var
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              20
              "loop")
            11))
        7]
      ;; the accumulator got an exit phi: itself on the surviving edge, and the
      ;; value the skipped run would have carried on the redirected one
      [(not
          (=
            (opt-flag-exit-test-phi-input-count
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              32)
            2))
        8]
      [(not
          (=
            (opt-flag-exit-test-phi-var
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              32
              "loop")
            19))
        9]
      [(not
          (=
            (opt-flag-exit-test-phi-var
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              32
              "mismatch")
            16))
        10]
      ;; and the read under X went to it
      [(not
          (=
            (opt-flag-exit-test-binop-lhs
              (ir.compiler-ir-global-shared-view blocks)
              "out"
              24)
            32))
        11]
      ;; the clear edge is gone from both latch phis
      [(not
          (=
            (opt-flag-exit-test-phi-input-count
              (ir.compiler-ir-global-shared-view blocks)
              "latch"
              13)
            1))
        12]
      [(not
          (=
            (opt-flag-exit-test-phi-input-count
              (ir.compiler-ir-global-shared-view blocks)
              "latch"
              23)
            1))
        13]
      ;; the flag's own definitions are pinned to the continuing constant
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "loop"
              11
              "entry")
            1))
        14]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view blocks)
              "loop"
              11
              "latch")
            1))
        15]
      ;; idempotence
      [(not (opt.opt-block-list-eq bases blocks twice)) 16]
      ;; a clear edge on one arm of a Branch: that arm alone is retargeted
      [(not (opt.opt-verify-ok? (opt.opt-verify-function armed))) 17]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view armed-blocks)
            "gate"
            "body"))
        18]
      [(not
          (=
            (opt-flag-exit-test-branch-false
              (ir.compiler-ir-global-shared-view armed-blocks)
              "body")
            (ir.compiler-ir-label "out")))
        19]
      [(not
          (=
            (opt-flag-exit-test-branch-true
              (ir.compiler-ir-global-shared-view armed-blocks)
              "body")
            (ir.compiler-ir-label "match")))
        20]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view armed-blocks)
              "out"
              20
              "body")
            0))
        21]
      [(not (= (opt-flag-exit-test-phi-var armed-blocks "out" 32 "body") 16))
        22]
      ;; an empty block between the gate and X: the arm collapses through it,
      ;; the redirect lands on X itself, and the spacer is deleted
      [(not (opt.opt-verify-ok? (opt.opt-verify-function spaced))) 23]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view spaced-blocks)
            "gate"
            "body"))
        24]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view spaced-blocks)
            "mismatch"
            "out"))
        25]
      [(not
          (=
            (opt-flag-exit-test-instr-count
              (ir.compiler-ir-global-shared-view spaced-blocks)
              "spacer")
            (- 0 1)))
        26]
      [(not
          (=
            (opt-flag-exit-test-phi-input-count
              (ir.compiler-ir-global-shared-view spaced-blocks)
              "out"
              20)
            2))
        27]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view spaced-blocks)
              "out"
              20
              "mismatch")
            0))
        28]
      [(not
          (=
            (opt-flag-exit-test-phi-var
              (ir.compiler-ir-global-shared-view spaced-blocks)
              "out"
              32
              "mismatch")
            16))
        29]
      [(not (= (opt-flag-exit-test-binop-lhs spaced-blocks "out" 24) 32)) 30]
      ;; the ROUND 1 shape: the arm holds the lowered `and`'s dead answer ahead
      ;; of its jump, and the collapse looks through it -- the conversion
      ;; happens in the round `licm`, `gvn` and `bce_version` can still use it,
      ;; rather than waiting for the round's tail DCE to make the arm bare
      [(not (opt.opt-verify-ok? (opt.opt-verify-function dead-spaced))) 33]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view dead-spaced-blocks)
            "gate"
            "body"))
        34]
      [(not
          (opt-flag-exit-test-jumps-to?
            (ir.compiler-ir-global-shared-view dead-spaced-blocks)
            "mismatch"
            "out"))
        35]
      [(not
          (=
            (opt-flag-exit-test-instr-count
              (ir.compiler-ir-global-shared-view dead-spaced-blocks)
              "spacer")
            (- 0 1)))
        36]
      [(not
          (=
            (opt-flag-exit-test-phi-bool
              (ir.compiler-ir-global-shared-view dead-spaced-blocks)
              "out"
              20
              "mismatch")
            0))
        37]
      [(not
          (=
            (opt-flag-exit-test-phi-var
              (ir.compiler-ir-global-shared-view dead-spaced-blocks)
              "out"
              33
              "mismatch")
            16))
        38]
      [(not (= (opt-flag-exit-test-binop-lhs dead-spaced-blocks "out" 24) 33))
        39]
      ;; C7: a spacer that does WORK is not one -- a store on the arm is an
      ;; effect the redirect would jump past, so the loop is left alone
      [(not (opt-flag-exit-gen-rejects? 6)) 40]
      ;; C8: the counter's value at the gate is an `add` the redirect skips
      [(not (opt-flag-exit-gen-rejects? 2)) 31]
      ;; C7: X's phi names a loop value whose next value is an `add`, not a phi
      [(not (opt-flag-exit-gen-rejects? 3)) 32]
      [else 42])))

(test
  flag-exit-generalized-loop-exit
  (test.assert-i64-eq
    (compiler-optimize-flag-exit-general-self-test)
    42
    "a gate whose exit arm carries phis and a second predecessor converts, the redirected edge carries the value the skipped run would have delivered, a Branch clear edge moves only its own arm, a spacer holding only dead pure code still collapses, and a value the run cannot name still refuses"))

;; --- dead phi elimination self-tests ------------------------------------------
;; The fixture is the shape SSA construction produces for a mutable local whose
;; last assignment sits in a conditional arm inside a loop, which is the shape
;; every guarded compare loop reaches the loop passes in: the `if` merge's phi
;; (%12) captures a value defined INSIDE the inner loop on the taken edge and
;; the enclosing header's phi (%11) on the skipped one, and the header phi reads
;; the merge phi straight back. Nothing else reads either, so the pair is dead
;; -- and use-count DCE can never say so, because each keeps the other's count
;; at one. While it lives, %20 counts as read outside the inner loop, which is
;; what `flag_exit`'s C8 and `bce_version`'s `opt-bce-mb-defs-escape?` refuse.
;;   0  the plain dead cycle: both phis go, the live counter stays
;;   1  a non-phi reader (the return) makes the cycle live: nothing goes
;;   2  the only reader is another PHI that is itself live, so liveness has to
;;      propagate through it: nothing goes
(define (opt-dead-phi-test-done-instrs [variant : i64]) : ir.CompilerIrInstrSeq
  (if (= variant 2)
    (irt.instrs "%18 = phi [%11, outer] : i64
       return %18")
    (opt-test-instrs
      (ir.CompilerIrInstr.Return
        (ir.CompilerIrMaybeValue.Some
          (if (= variant 1)
            (ir.CompilerIrValue.Var 11)
            (ir.CompilerIrValue.Var 10)))))))

(define (opt-dead-phi-test-outer-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = phi [0, entry], [%14, merge] : i64
     %11 = phi [0, entry], [%12, merge] : i64
     %15 = lt %10, %0 : bool
     branch %15, guard, done"))

(define (opt-dead-phi-test-inner-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%20 = phi [0, inner_pre], [%21, inner] : i64
     %21 = add %20, 1 : i64
     %22 = lt %21, %1 : bool
     branch %22, inner, inner_exit"))

(define (opt-dead-phi-test-merge-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%12 = phi [%20, inner_exit], [%11, skip] : i64
     %14 = add %10, 1 : i64
     jump outer"))

(define (opt-dead-phi-test-jump-block [label : String] [target : String]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label label)
    (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label target)))))

(define (opt-dead-phi-test-guard-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%16 = lt %10, %1 : bool
     branch %16, inner_pre, skip"))

(define (opt-dead-phi-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-dead-phi-test-jump-block "entry" "outer")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "outer")
        (opt-dead-phi-test-outer-instrs))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "guard")
          (opt-dead-phi-test-guard-instrs))
        (ir.compiler-ir-block-cons
          (opt-dead-phi-test-jump-block "inner_pre" "inner")
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "inner")
              (opt-dead-phi-test-inner-instrs))
            (ir.compiler-ir-block-cons
              (opt-dead-phi-test-jump-block "inner_exit" "merge")
              (ir.compiler-ir-block-cons
                (opt-dead-phi-test-jump-block "skip" "merge")
                (ir.compiler-ir-block-cons
                  (ir.CompilerIrBlock.Block
                    (ir.compiler-ir-label "merge")
                    (opt-dead-phi-test-merge-instrs))
                  (ir.compiler-ir-block-cons
                    (ir.CompilerIrBlock.Block
                      (ir.compiler-ir-label "done")
                      (opt-dead-phi-test-done-instrs variant))
                    (ir.CompilerIrBlockList.Nil)))))))))))

(define (opt-dead-phi-test-wrap [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "dead_phi")
    (irt.params "n=%0:i64, m=%1:i64")
    (ast.AstType.I64)
    23
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-dead-phi-test-function [variant : i64]) : ir.CompilerIrFunction
  (opt-dead-phi-test-wrap (opt-dead-phi-test-blocks variant)))

(define (opt-dead-phi-test-run [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks
    (opt.opt-dead-phi-function (opt-dead-phi-test-function variant))))

(define (opt-dead-phi-test-phi-count-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-dead-phi-test-phi-count-instrs
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Phi _ _ _) 1]
          [_ 0])))))

(define (opt-dead-phi-test-phi-count
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-test-phi-count-instrs instrs 0 0)])]))

(define (opt-dead-phi-test-defines-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi found _ _) (= found dst)]
      [_ false])
      true
      (opt-dead-phi-test-defines-instrs? instrs (+ index 1) dst))))

(define (opt-dead-phi-test-defines?
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-test-defines-instrs? instrs 0 dst)])]))

(define (opt-dead-phi-test-unchanged? [variant : i64]) : bool
  (opt.opt-block-list-eq
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-dead-phi-test-run variant)
    (opt-dead-phi-test-blocks variant)))

(define (compiler-optimize-dead-phi-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [swept : ir.CompilerIrBlockList (opt-dead-phi-test-run 0)]
    [twice : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-dead-phi-function
          (opt-dead-phi-test-wrap (ir.compiler-ir-global-shared-view swept))))]
    [dense-swept : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-dead-phi-function
          (ir.compiler-ir-function-compact-blocks
            (opt-dead-phi-test-function 0))))]
    (cond
      ;; the fixture the negative variants rely on is well formed to start with
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-dead-phi-test-function 0))))
        1]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt-dead-phi-test-wrap (ir.compiler-ir-global-shared-view swept)))))
        2]
      ;; both members of the cycle are gone
      [(opt-dead-phi-test-defines?
          (ir.compiler-ir-global-shared-view swept)
          "outer"
          11)
        3]
      [(opt-dead-phi-test-defines?
          (ir.compiler-ir-global-shared-view swept)
          "merge"
          12)
        4]
      ;; the live counter phi and the inner loop's own phi are untouched
      [(not
          (opt-dead-phi-test-defines?
            (ir.compiler-ir-global-shared-view swept)
            "outer"
            10))
        5]
      [(not
          (opt-dead-phi-test-defines?
            (ir.compiler-ir-global-shared-view swept)
            "inner"
            20))
        6]
      ;; and with the cycle gone the inner counter has no reader outside the
      ;; inner loop at all, which is the fact both loop passes read
      [(not
          (=
            (opt-dead-phi-test-phi-count
              (ir.compiler-ir-global-shared-view swept)
              "merge")
            0))
        7]
      [(not
          (=
            (opt-dead-phi-test-phi-count
              (ir.compiler-ir-global-shared-view swept)
              "outer")
            1))
        8]
      ;; idempotent: a second sweep finds nothing
      [(not
          (opt.opt-block-list-eq
            bases
            (ir.compiler-ir-global-shared-view swept)
            twice))
        9]
      ;; a non-phi reader keeps the whole cycle
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-dead-phi-test-function 1))))
        10]
      [(not (opt-dead-phi-test-unchanged? 1)) 11]
      ;; so does a reader that is itself a live phi: liveness has to propagate
      ;; through the phi web, not stop at the first phi
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-dead-phi-test-function 2))))
        12]
      [(not (opt-dead-phi-test-unchanged? 2)) 13]
      ;; Current production IR is dense. The sweep must retain that container
      ;; shape instead of rebuilding the recursive compatibility lists.
      [(not
          (match (ir.compiler-ir-global-shared-view dense-swept)
            [(ir.CompilerIrBlockList.Array _) true]
            [_ false]))
        14]
      [(not (opt.opt-block-list-eq bases swept dense-swept)) 15]
      [else 42])))

(test
  dead-phi-cycle-elimination
  (test.assert-i64-eq
    (compiler-optimize-dead-phi-self-test)
    42
    "a phi web whose only readers are phis is retired, cycles included, while a non-phi reader or a live phi reader anywhere in the web keeps all of it"))

(define (opt-gep-split-test-gep-count-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-gep-split-test-gep-count-from
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.Gep _ _ _ _) 1]
          [_ 0])))))

(define (opt-gep-split-test-gep-count [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (+
            (opt-gep-split-test-gep-count-from instrs 0 0)
            (opt-gep-split-test-gep-count (deref rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-gep-split-test-gep-count (ir.compiler-ir-block-seq-to-list seq))]))

;; One shared Gep feeding a Load and a StorePtr (the quicksort swap shape);
;; `other-use` adds a BinOp consumer, which must leave the Gep untouched.
(define (opt-gep-split-test-shared-blocks [other-use : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (irt.instr "%3 = gep %1, %0 : i64")
        (ir.CompilerIrInstr.Load 4 (ir.CompilerIrValue.Var 3) (ast.AstType.I64))
        (if other-use
          (irt.instr "%5 = add %3, 1 : i64")
          (irt.instr "%5 = mov 0 : i64"))
        (irt.instr "store_ptr %3, %0 : i64")
        (irt.instr "return %4")))
    (ir.CompilerIrBlockList.Nil)))

;; Lowering can wrap a field/index address in `Gep address, 0 : u8` before a
;; memory operation. The wrapper must inherit the inner Gep recipe so the dead
;; inner definition can be removed and the backend sees one fusible Gep.
(define (opt-gep-split-test-chain-blocks
  [offset : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [other-use : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Gep 3 (ir.CompilerIrValue.Var 2) offset elem-ty)
        (irt.instr "%4 = gep %3, 0 : u8")
        (irt.instr "store_ptr %4, %1 : i64")
        (if other-use
          (irt.instr "%5 = add %3, 1 : i64")
          (irt.instr "%5 = mov 0 : i64"))
        (irt.instr "return %1")))
    (ir.CompilerIrBlockList.Nil)))

(define (opt-gep-split-test-chain-function
  [offset : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [other-use : bool]) : ir.CompilerIrFunction
  (opt.opt-gep-split-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (ir.CompilerIrFunction.Function
      (opt-test-symbol "gep_split_chain")
      (opt-bce-version-test-params)
      (ast.AstType.I64)
      6
      (opt-gep-split-test-chain-blocks offset elem-ty other-use)
      ir.CompilerIrFunctionAbi.Ordinary)))

(define (opt-gep-split-test-chain-shape?
  [func : ir.CompilerIrFunction]
  [expected-base : ir.CompilerIrValue]
  [expected-offset : ir.CompilerIrValue]
  [expected-ty : ast.AstType]) : bool
  (match (opt.opt-function-blocks func)
    [(ir.CompilerIrBlockList.Cons block _)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (> (ir.compiler-ir-instr-seq-count instrs) 1)
            (match (ir.compiler-ir-instr-seq-ref instrs 1)
              [(ir.CompilerIrInstr.Gep dst base offset elem-ty)
                (and
                  (= dst 4)
                  (opt.opt-value-eq base expected-base)
                  (opt.opt-value-eq offset expected-offset)
                  (opt.opt-type-eq
                    (ast.ast-node-pool-reader-type-segment-bases)
                    elem-ty
                    expected-ty))]
              [_ false])
            false)])]
    [_ false]))

(define (compiler-optimize-gep-split-self-test) : i64
  (let
    [split : ir.CompilerIrFunction
      (opt.opt-gep-split-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "gep_split_shared")
          (opt-bce-version-test-params)
          (ast.AstType.I64)
          8
          (opt-gep-split-test-shared-blocks false)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [split-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view split))]
    [untouched : ir.CompilerIrFunction
      (opt.opt-gep-split-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "gep_split_other_use")
          (opt-bce-version-test-params)
          (ast.AstType.I64)
          8
          (opt-gep-split-test-shared-blocks true)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [chain-zero : ir.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (ir.CompilerIrValue.I64 0)
        (ast.AstType.U8)
        false)]
    [chain-disp : ir.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (ir.CompilerIrValue.I64 8)
        (ast.AstType.U8)
        false)]
    [chain-index : ir.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (ir.CompilerIrValue.Var 0)
        (ast.AstType.I64)
        false)]
    [chain-other-use : ir.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (ir.CompilerIrValue.I64 8)
        (ast.AstType.U8)
        true)]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function split))) 1]
      ;; the shared Gep is cloned per use (Load + StorePtr get one fresh
      ;; single-use Gep each); the dead original is left for the pipeline's
      ;; DCE, so the block holds 2 fresh + 1 dead = 3 Geps.
      [(not (= (opt-gep-split-test-gep-count split-blocks) 3)) 2]
      ;; a Gep with a non-address consumer (the BinOp) is not split.
      [(not
          (=
            (opt-gep-split-test-gep-count
              (opt.opt-function-blocks
                (opt.compiler-opt-global-shared-view untouched)))
            1))
        3]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function untouched))) 4]
      [(not
          (opt-gep-split-test-chain-shape?
            (opt.compiler-opt-global-shared-view chain-zero)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.I64 0)
            (ast.AstType.U8)))
        5]
      [(not
          (opt-gep-split-test-chain-shape?
            (opt.compiler-opt-global-shared-view chain-disp)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.I64 8)
            (ast.AstType.U8)))
        6]
      [(not
          (opt-gep-split-test-chain-shape?
            (opt.compiler-opt-global-shared-view chain-index)
            (ir.CompilerIrValue.Var 2)
            (ir.CompilerIrValue.Var 0)
            (ast.AstType.I64)))
        7]
      ;; A non-memory use of the inner address rejects the collapse; the outer
      ;; Gep still reads var 3 and therefore remains materialized by the backend.
      [(not
          (opt-gep-split-test-chain-shape?
            (opt.compiler-opt-global-shared-view chain-other-use)
            (ir.CompilerIrValue.Var 3)
            (ir.CompilerIrValue.I64 0)
            (ast.AstType.U8)))
        8]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chain-zero))) 9]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chain-disp))) 10]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chain-index))) 11]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chain-other-use))) 12]
      [else 42])))

;; --- multi-block versioning pipeline self-test --------------------------------------
;; Full-pipeline integration: a lowered while loop whose body splits into a
;; store++ path and a skip path (the quicksort partition shape) must rotate
;; into a multi-block counted loop, version, and leave every fast-derived
;; block check-free while the slow original keeps its per-iteration checks.
(define (opt-bce-mb-pipeline-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov 0 : i64
       %4 = mov 0 : i64
       jump header
     header:
       %5 = lt %3, %0 : bool
       branch %5, body, exit
     body:
       bounds_check %3, %1 message \"mbp_ok0\"
       store_ptr %2, %4 : i64
       %6 = lt %4, 4 : bool
       branch %6, then, else
     then:
       bounds_check %4, %1 message \"mbp_ok1\"
       %7 = add %4, 1 : i64
       %4 = mov %7 : i64
       jump merge
     else:
       jump merge
     merge:
       %8 = add %3, 1 : i64
       %3 = mov %8 : i64
       jump header
     exit:
       return %4"))

(define (opt-bce-mb-test-matches-at?
  [label : String]
  [needle : String]
  [off : i64]
  [index : i64]) : bool
  (if (>= index (string.string-length needle))
    true
    (if (=
      (cast (string.string-ref label (+ off index)) : i64)
      (cast (string.string-ref needle index) : i64))
      (opt-bce-mb-test-matches-at? label needle off (+ index 1))
      false)))

(define (opt-bce-mb-test-label-contains-from?
  [label : String]
  [needle : String]
  [off : i64]) : bool
  (if (> (+ off (string.string-length needle)) (string.string-length label))
    false
    (if (opt-bce-mb-test-matches-at?
      (opt.compiler-opt-global-shared-view label)
      (opt.compiler-opt-global-shared-view needle)
      off
      0)
      true
      (opt-bce-mb-test-label-contains-from? label needle (+ off 1)))))

(define (opt-bce-mb-test-label-contains? [label : i64] [needle : String]) : bool
  (opt-bce-mb-test-label-contains-from?
    (ir.compiler-ir-label-text label)
    needle
    0))

;; Count blocks whose label contains needle.
(define (opt-bce-mb-test-matching-blocks
  [blocks : ir.CompilerIrBlockList]
  [needle : String]
  [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-test-matching-blocks
        (deref rest)
        (opt.compiler-opt-global-shared-view needle)
        (match block
          [(ir.CompilerIrBlock.Block label _)
            (if (opt-bce-mb-test-label-contains? label needle)
              (+ acc 1)
              acc)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-test-matching-blocks
        (ir.compiler-ir-block-seq-to-list seq)
        needle
        acc)]))

;; Total BoundsChecks in blocks whose label contains needle.
(define (opt-bce-mb-test-matching-checks
  [blocks : ir.CompilerIrBlockList]
  [needle : String]
  [acc : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) acc]
    [(ir.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-test-matching-checks
        (deref rest)
        (opt.compiler-opt-global-shared-view needle)
        (match block
          [(ir.CompilerIrBlock.Block label instrs)
            (if (opt-bce-mb-test-label-contains? label needle)
              (+
                acc
                (opt.opt-bce-version-check-count
                  (ir.compiler-ir-global-shared-view instrs)
                  0
                  (ir.compiler-ir-instr-seq-count instrs)
                  0))
              acc)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-bce-mb-test-matching-checks
        (ir.compiler-ir-block-seq-to-list seq)
        needle
        acc)]))

(define (compiler-optimize-bce-version-mb-pipeline-self-test) : i64
  (let
    [optimized : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "bce_version_mb_while_fixture")
          (opt-bce-version-test-params)
          (ast.AstType.I64)
          9
          (opt-bce-mb-pipeline-blocks)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view optimized))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function optimized))) 1]
      ;; the fast region exists ...
      [(<
          (opt-bce-mb-test-matching-blocks
            (ir.compiler-ir-global-shared-view blocks)
            "__bce_fast"
            0)
          2)
        2]
      ;; ... every fast-derived block is check-free ...
      [(not
          (=
            (opt-bce-mb-test-matching-checks
              (ir.compiler-ir-global-shared-view blocks)
              "__bce_fast"
              0)
            0))
        3]
      ;; ... and the slow original keeps its per-iteration checks ("" is a
      ;; prefix of every label, so this counts checks function-wide).
      [(< (opt-bce-version-test-prefix-checks blocks "" 0) 2) 4]
      [else 42])))

;; --- multi-block eq-loop bce-version self-tests --------------------------------
;;
;; The byte-compare loop shape (intern_table's it-slice-eq?): a top-tested
;; counted loop (the counter compare ends the header, the latch jumps back)
;; with a second header phi carrying the running flag, two variable-base
;; checked loads whose lengths are per-iteration descriptor loads, and a
;; direct outside use of the flag in an exit block reached through two
;; single-edge forwarding stubs. Variant 1 versions: the guard hoists one
;; gep+load per descriptor length, both checks leave the fast clone, the
;; stubs gain fast twins, and the materialized exit phi carries the fast-edge
;; inputs. Variant 2 gives the check index an in-loop base (that check stays
;; underivable; the second still derives, so the loop partially versions), 3
;; scales the counter by two (the scale-N variable-base guard covers it: the
;; check derives through a synthesized derived seed, so the loop versions
;; check-free), and 4 stores into the loop body (the descriptor-length hoist
;; needs a write-free loop, so no check derives and the function is
;; untouched).
(define (opt-bce-mb-eq-test-params) : ir.CompilerIrParamSeq
  (irt.params
    "arr=%0:(__tl_dyn-array i64), arr2=%1:(__tl_dyn-array i64), len=%2:i64, start=%3:i64, start2=%4:i64"))

(define (opt-bce-mb-eq-test-header-block) : ir.CompilerIrBlock
  (irt.block
    "header:
       %5 = phi [0, entry], [%13, latch] : i64
       %6 = phi [true, entry], [%14, latch] : bool
       %7 = lt %5, %2 : bool
       branch %7, flagtest, exita"))

;; The two var-base checked byte loads over descriptor lengths. Variant 2
;; moves the base into the loop (`(i*i) + i`), 3 scales the counter
;; (`start + 2*i`), and 4 stores into the body.
(define (opt-bce-mb-eq-test-body-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs
      (cond
        [(= variant 2) (irt.instr "%30 = mul %5, %5 : i64")]
        [(= variant 3) (irt.instr "%30 = mul %5, 2 : i64")]
        [else (irt.instr "%30 = mov 0 : i64")])
      (ir.CompilerIrInstr.BinOp
        8
        (ir.CompilerIrBinOp.Add)
        (if (= variant 2)
          (ir.CompilerIrValue.Var 30)
          (ir.CompilerIrValue.Var 3))
        (if (= variant 3)
          (ir.CompilerIrValue.Var 30)
          (ir.CompilerIrValue.Var 5))
        (ast.AstType.I64))
      (irt.instr "%9 = cast %8 : i64 to u64")
      (irt.instr "%10 = gep %0, 1 : i64")
      (ir.CompilerIrInstr.Load 11 (ir.CompilerIrValue.Var 10) (ast.AstType.I64))
      (irt.instr "%12 = cast %11 : i64 to u64")
      (irt.instr "bounds_check %9, %12 message \"mbe_ok0\"")
      (irt.instr "%15 = add %4, %5 : i64")
      (irt.instr "%16 = cast %15 : i64 to u64")
      (irt.instr "%17 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 18 (ir.CompilerIrValue.Var 17) (ast.AstType.I64))
      (irt.instr "%19 = cast %18 : i64 to u64")
      (irt.instr "bounds_check %16, %19 message \"mbe_ok1\"")
      (irt.instr "%20 = gep %0, 0 : i64")
      (ir.CompilerIrInstr.Load 21 (ir.CompilerIrValue.Var 20) (ast.AstType.U64))
      (irt.instr "%22 = gep %21, %8 : u8")
      (ir.CompilerIrInstr.Load 23 (ir.CompilerIrValue.Var 22) (ast.AstType.U8))
      (if (= variant 4)
        (irt.instr "store_ptr %21, %23 : u8")
        (ir.CompilerIrInstr.Mov 29 (ir.CompilerIrValue.Var 23) (ast.AstType.U8)))
      (irt.instr "%24 = gep %1, 0 : i64")
      (ir.CompilerIrInstr.Load 25 (ir.CompilerIrValue.Var 24) (ast.AstType.U64))
      (irt.instr "%26 = gep %25, %15 : u8")
      (ir.CompilerIrInstr.Load 27 (ir.CompilerIrValue.Var 26) (ast.AstType.U8))
      (irt.instr "%28 = eq %23, %27 : u8")
      (irt.instr "branch %28, then, else"))))

(define (opt-bce-mb-eq-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump header")
    (ir.compiler-ir-block-cons
      (opt-bce-mb-eq-test-header-block)
      (ir.compiler-ir-block-cons
        (irt.block "flagtest:
             branch %6, body, exitb")
        (ir.compiler-ir-block-cons
          (opt-bce-mb-eq-test-body-block variant)
          (irt.blocks
            "then:
               jump latch
             else:
               jump latch
             latch:
               %14 = phi [%6, then], [false, else] : bool
               %13 = add %5, 1 : i64
               jump header
             exita:
               jump exit
             exitb:
               jump exit
             exit:
               return %6"))))))

(define (opt-bce-mb-eq-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb_eq_fixture")
    (opt-bce-mb-eq-test-params)
    (ast.AstType.Bool)
    31
    (opt-bce-mb-eq-test-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mb-eq-test-no-fast? [blocks : ir.CompilerIrBlockList]) : bool
  (match (opt.opt-cfg-find-block
    blocks
    (ir.compiler-ir-label "header__bce_fast"))
    [(opt.OptMaybeBlock.No) true]
    [(opt.OptMaybeBlock.Some _) false]))

(define (compiler-optimize-bce-version-mb-eq-self-test) : i64
  (let
    [versioned : ir.CompilerIrFunction
      (opt.opt-bce-version-function-with-types
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-eq-test-function 1))]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view versioned))]
    [in-loop-base-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function-with-types
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mb-eq-test-function 2)))]
    [scaled-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function-with-types
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mb-eq-test-function 3)))]
    [stored-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function-with-types
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mb-eq-test-function 4)))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function versioned))) 1]
      ;; ten originals + guard + six fast loop blocks + two stub twins.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            19))
        2]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "header__bce_guard"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        3]
      ;; both checks left the fast clone body; the slow body keeps both.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        4]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body"))
            2))
        5]
      ;; the forwarding stubs gained fast twins.
      [(opt-bce-mb-eq-test-no-fast? (ir.compiler-ir-global-shared-view out)) 6]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "exita__bce_fast"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        7]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "exitb__bce_fast"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        8]
      ;; the materialized exit phi carries both slow and both fast edges.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "exit"))
            4))
        9]
      ;; the scale-1 quotient is exact: the guard needs no division.
      [(not (= (opt-count-binop-op-blocks out (ir.CompilerIrBinOp.Div)) 0)) 10]
      ;; an in-loop base cannot prove invariance: that check stays, but the
      ;; second check still derives, so the loop PARTIALLY versions.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view in-loop-base-out))
            19))
        11]
      [(not
          (=
            (opt-bce-version-test-block-checks
              in-loop-base-out
              (ir.compiler-ir-label "body__bce_fast"))
            1))
        12]
      ;; scale-2 with a variable base now DERIVES through the scale-N
      ;; variable-base guard (a synthesized derived seed with step 2), so the
      ;; loop versions check-free instead of keeping the strided check.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view scaled-out))
            19))
        13]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view scaled-out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        14]
      ;; a store in the body blocks the descriptor-length hoist: no
      ;; derivable check, so the loop is left untouched.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view stored-out))
            10))
        15]
      [(not (opt-bce-mb-eq-test-no-fast? stored-out)) 16]
      ;; the scale-2 variable-base check pays one quotient division.
      [(not
          (= (opt-count-binop-op-blocks scaled-out (ir.CompilerIrBinOp.Div)) 1))
        17]
      [else 42])))

;; Runtime boundary behavior of the versioned eq loop: windows ending exactly
;; at the array end still pass the guard, and every window compares the same
;; with or without versioning.
(define (opt-bce-mb-eq-runtime-make [n : i64] [seed : i64]) : (__tl_dyn-array
    u8)
  (let
    [out : (__tl_dyn-array u8) (__tl_make-array u8 n)]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref out i) (cast (+ seed i) : u8))
          (set! i (+ i 1))))
      out)))

(define (opt-bce-mb-eq-runtime-slice-eq?
  [a : (& a (__tl_dyn-array u8))]
  [a-start : i64]
  [b : (& b (__tl_dyn-array u8))]
  [b-start : i64]
  [len : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (while (and (< i len) ok)
        (begin
          (if (= (array-ref a (+ a-start i)) (array-ref b (+ b-start i)))
            unit
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

(test
  bce-version-mb-eq-loop-ir
  (test.assert-i64-eq
    (compiler-optimize-bce-version-mb-eq-self-test)
    42
    "top-tested eq loop with var-base descriptor-length checks versions check-free"))

(test
  bce-version-mb-eq-loop-runtime-boundary
  (let
    [buf : (__tl_dyn-array u8) (opt-bce-mb-eq-runtime-make 16 0)]
    [other : (__tl_dyn-array u8) (opt-bce-mb-eq-runtime-make 16 0)]
    (begin
      (set! (array-ref other 15) 255)
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 8 buf 8 8)
        true
        "equal window ending exactly at the array end")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 0 other 0 8)
        true
        "equal window from a zero base")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 8 other 8 8)
        false
        "last byte differs at the array end")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 8 other 8 7)
        true
        "shared prefix compares equal")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 0 buf 1 8)
        false
        "offset windows differ")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 15 buf 15 1)
        true
        "single byte at the last slot")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 4 buf 4 0)
        true
        "empty window"))))

;; --- call-carrying multiblock clone fixture -----------------------------------
;;
;; A counted do-while nest whose body holds a DIRECT CALL and three descriptor-
;; length checks. Two of the lengths hang off parameter handles the loop never
;; defines; the third hangs off a handle the loop RELOADS out of a module
;; global's cell every iteration, which is the chain
;; opt-bce-mb-descriptor-base has to rebuild in the guard.
;;
;; `variant` moves exactly one thing:
;;   0  the call's callee is element-clean (bit 2)     -- VERSIONS
;;   1  no call at all (a Mov in its place)            -- VERSIONS (the twin)
;;   2  the callee writes through its parameters       -- REFUSED: bit 1 alone
;;      (global-clean but NOT descriptor-safe)            cannot rule out a
;;                                                        write to the caller's
;;                                                        own descriptor
;;   3  the call is INDIRECT                           -- REFUSED: the clone
;;                                                        whitelist has no
;;                                                        indirect call in it,
;;                                                        so the shape scan
;;                                                        rejects the block
;;   4  element-clean callee, but the two parameter    -- REFUSED: one derived
;;      checks are given an in-loop length so only        check against a
;;      the global-rooted check derives                   duplicated call site
;;   5  the callee is unresolved (absent from the      -- REFUSED: no bit
;;      clean map)
;;   6  the callee is memory-clean (bit 0)             -- VERSIONS (the other
;;                                                        admitting bit)
(define (opt-bce-mbcall-test-global) : i64
  (opt-test-symbol "mbcall_workspace"))

(define (opt-bce-mbcall-test-callee [variant : i64]) : i64
  (cond
    [(= variant 2) (opt-test-symbol "mbcall_param_callee")]
    [(= variant 5) (opt-test-symbol "mbcall_unresolved_callee")]
    [(= variant 6) (opt-test-symbol "mbcall_memory_callee")]
    [else (opt-test-symbol "mbcall_clean_callee")]))

;; The per-callee bits the loop-BCE summaries would have built for this
;; fixture's callees, spelled through the same producer production uses
;; (opt-loop-bce-direct-call-clean-bits) so the test cannot drift from it:
;;
;;   clean   summary = element bit only            -> global + element (2|4)
;;   memory  summary = 0                           -> memory + global  (1|2)
;;   param   summary = one parameter-write bit     -> global alone     (2)
;;   unresolved                                    -> absent
(define (opt-bce-mbcall-test-clean-map) : opt_i64_i64_map.Map
  (let
    [out : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-test-symbol "mbcall_clean_callee")
        (opt.opt-loop-bce-direct-call-clean-bits
          (opt.opt-call-memory-summary-add-element 0)))
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-test-symbol "mbcall_memory_callee")
        (opt.opt-loop-bce-direct-call-clean-bits 0))
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-test-symbol "mbcall_param_callee")
        (opt.opt-loop-bce-direct-call-clean-bits 1))
      out)))

(define (opt-bce-mbcall-test-params) : ir.CompilerIrParamSeq
  (irt.params
    "arr=%0:(__tl_dyn-array i64), arr2=%1:(__tl_dyn-array i64), len=%2:i64"))

;; One `gep handle, 1` + `load` + `cast` + `bounds_check` group.
(define (opt-bce-mbcall-test-check
  [handle : ir.CompilerIrValue]
  [gep-var : i64]
  [load-var : i64]
  [cast-var : i64]
  [length : ir.CompilerIrValue]
  [ok-label : i64]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    rest
    (ir.CompilerIrInstr.Gep
      gep-var
      handle
      (ir.CompilerIrValue.I64 1)
      (ast.AstType.I64))
    (ir.CompilerIrInstr.Load
      load-var
      (ir.CompilerIrValue.Var gep-var)
      (ast.AstType.I64))
    (ir.CompilerIrInstr.Cast
      cast-var
      (ir.CompilerIrValue.Var load-var)
      (ast.AstType.I64)
      (ast.AstType.U64))
    (ir.CompilerIrInstr.BoundsCheck (ir.CompilerIrValue.Var 7) length ok-label)))

(define (opt-bce-mbcall-test-body-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (opt-bce-mbcall-test-check
        (ir.CompilerIrValue.Var 0)
        4
        5
        6
        ;; Variant 4 replaces the proven length with the counter itself: the
        ;; check stays, but nothing about it derives.
        (if (= variant 4)
          (ir.CompilerIrValue.Var 7)
          (ir.CompilerIrValue.Var 6))
        (ir.compiler-ir-label "mbcall_ok0")
        (opt-bce-mbcall-test-check
          (ir.CompilerIrValue.Var 1)
          8
          9
          10
          (if (= variant 4)
            (ir.CompilerIrValue.Var 7)
            (ir.CompilerIrValue.Var 10))
          (ir.compiler-ir-label "mbcall_ok1")
          (irt.instrs
            "%11 = lt %3, %2 : bool
             branch %11, then, else")))
      (irt.instr "%3 = phi [0, entry], [%30, merge] : i64")
      (irt.instr "%7 = cast %3 : i64 to u64"))))

;; The call itself, plus the global-rooted descriptor chain the guard has to
;; rebuild: `gep @g, 0` / `load` recovers a handle the loop defines, so the old
;; "base must not be a loop def" test refused the whole chain.
(define (opt-bce-mbcall-test-then-block [variant : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "then")
    (opt-test-instrs-with-tail
      (opt-bce-mbcall-test-check
        (ir.CompilerIrValue.Var 14)
        15
        16
        17
        (ir.CompilerIrValue.Var 17)
        (ir.compiler-ir-label "mbcall_ok2")
        (opt-test-instrs
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "merge"))))
      (cond
        [(= variant 1) (irt.instr "%12 = mov 0 : i64")]
        [(= variant 3) (irt.instr "%12 = call* %2(%2) : i64")]
        [else
          (ir.CompilerIrInstr.Call
            12
            (opt-bce-mbcall-test-callee variant)
            (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var 2))
            (ast.AstType.I64))])
      (irt.instr "%13 = gep @mbcall_workspace, 0 : i64")
      (irt.instr "%14 = load %13 : (__tl_dyn-array i64)"))))

(define (opt-bce-mbcall-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump body")
    (ir.compiler-ir-block-cons
      (opt-bce-mbcall-test-body-block variant)
      (ir.compiler-ir-block-cons
        (opt-bce-mbcall-test-then-block variant)
        (irt.blocks
          "else:
             jump merge
           merge:
             %30 = add %3, 1 : i64
             %31 = lt %30, %2 : bool
             branch %31, body, exit
           exit:
             return 0")))))

(define (opt-bce-mbcall-test-function [variant : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mbcall_fixture")
    (opt-bce-mbcall-test-params)
    (ast.AstType.I64)
    40
    (opt-bce-mbcall-test-blocks variant)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-bce-mbcall-test-run [variant : i64]) : ir.CompilerIrFunction
  (opt.opt-bce-version-function-with-types-and-calls
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-bce-mbcall-test-clean-map)
    (opt-bce-mbcall-test-function variant)))

(define (opt-bce-mbcall-test-out [variant : i64]) : ir.CompilerIrBlockList
  (opt.opt-function-blocks (opt-bce-mbcall-test-run variant)))

;; The `Call` dsts of one block, newest-first, as a count of how many of them
;; are >= `floor`. The clone's call must define a FRESH var (the fresh-id pass
;; allocates from the frame size up), never the original's.
(define (opt-bce-mbcall-test-call-dsts-above
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [floor : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 0]
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [seen : i64 0]
            (begin
              (while (< index count)
                (begin
                  (match (ir.compiler-ir-instr-seq-ref instrs index)
                    [(ir.CompilerIrInstr.Call dst _ _ _)
                      (if (>= dst floor)
                        (set! seen (+ seen 1))
                        unit)]
                    [_ unit])
                  (set! index (+ index 1))))
              seen))])]))

;; How many `Call` instructions one block holds.
(define (opt-bce-mbcall-test-block-calls
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 0]
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [seen : i64 0]
            (begin
              (while (< index count)
                (begin
                  (match (ir.compiler-ir-instr-seq-ref instrs index)
                    [(ir.CompilerIrInstr.Call _ _ _ _) (set! seen (+ seen 1))]
                    [_ unit])
                  (set! index (+ index 1))))
              seen))])]))

(define (opt-bce-mbcall-test-unversioned? [variant : i64]) : bool
  (let
    [out : ir.CompilerIrBlockList (opt-bce-mbcall-test-out variant)]
    (and
      (=
        (ir.compiler-ir-block-list-count
          (ir.compiler-ir-global-shared-view out))
        6)
      (match (opt.opt-cfg-find-block
        out
        (ir.compiler-ir-label "body__bce_fast"))
        [(opt.OptMaybeBlock.No) true]
        [(opt.OptMaybeBlock.Some _) false]))))

(define (compiler-optimize-bce-version-mbcall-self-test) : i64
  (let
    [versioned : ir.CompilerIrFunction (opt-bce-mbcall-test-run 0)]
    [out : ir.CompilerIrBlockList
      (opt.opt-function-blocks (ir.compiler-ir-global-shared-view versioned))]
    [twin-out : ir.CompilerIrBlockList (opt-bce-mbcall-test-out 1)]
    [memory-out : ir.CompilerIrBlockList (opt-bce-mbcall-test-out 6)]
    ;; Idempotence: the fast labels now exist, which
    ;; opt-bce-mb-fast-labels-fresh? refuses on, so a second pass is a no-op.
    [again-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.opt-bce-version-function-with-types-and-calls
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mbcall-test-clean-map)
          (ir.compiler-ir-global-shared-view versioned)))]
    (cond
      ;; (4) SSA validity of the cloned call: the pass's own verifier is what
      ;; gates every application, and a clone that re-defined the original
      ;; call's dst would fail it here.
      [(not (opt.opt-verify-ok? (opt.opt-verify-function versioned))) 1]
      ;; six originals + guard + five fast clones (body/then/else/merge and the
      ;; entry stub is not cloned) -- entry and exit stay shared.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view out))
            11))
        2]
      [(match (opt.opt-cfg-find-block
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "body__bce_guard"))
          [(opt.OptMaybeBlock.No) true]
          [(opt.OptMaybeBlock.Some _) false])
        3]
      ;; (1) all three checks left the fast clone; the slow loop keeps all
      ;; three.
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body__bce_fast"))
            0))
        4]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "body"))
            2))
        6]
      [(not
          (=
            (opt-bce-version-test-block-checks
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then"))
            1))
        7]
      ;; The call is DUPLICATED, not moved: one in each copy.
      [(not
          (=
            (opt-bce-mbcall-test-block-calls
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then"))
            1))
        8]
      [(not
          (=
            (opt-bce-mbcall-test-block-calls
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then__bce_fast"))
            1))
        9]
      ;; ... and the clone's call defines a FRESH var: every id the fresh-id
      ;; pass mints is at or above the fixture's frame size of 40, while the
      ;; original's dst is 12.
      [(not
          (=
            (opt-bce-mbcall-test-call-dsts-above
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then__bce_fast")
              40)
            1))
        10]
      [(not
          (=
            (opt-bce-mbcall-test-call-dsts-above
              (ir.compiler-ir-global-shared-view out)
              (ir.compiler-ir-label "then")
              40)
            0))
        11]
      ;; The guard REBUILDS the global-rooted descriptor chain: it holds a
      ;; `gep @mbcall_workspace, 0`, which no other guard the pass emits does.
      [(not
          (opt-bce-mbcall-test-guard-has-global?
            out
            (ir.compiler-ir-label "body__bce_guard")))
        12]
      ;; (7) idempotent.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view again-out))
            11))
        13]
      [(match (opt.opt-cfg-find-block
          again-out
          (ir.compiler-ir-label "body__bce_fast__bce_fast"))
          [(opt.OptMaybeBlock.No) false]
          [(opt.OptMaybeBlock.Some _) true])
        14]
      ;; The call-free twin versions identically -- the call is priced, not
      ;; structurally special.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view twin-out))
            11))
        15]
      [(not
          (=
            (opt-bce-version-test-block-checks
              twin-out
              (ir.compiler-ir-label "then__bce_fast"))
            0))
        16]
      ;; A MEMORY-clean callee is the other bit that admits the chain.
      [(not (= (ir.compiler-ir-block-list-count memory-out) 11)) 17]
      ;; (2) A callee that could write a descriptor through a parameter is
      ;; global-clean but NOT descriptor-safe: the chain stops deriving and the
      ;; loop is refused outright.
      [(not (opt-bce-mbcall-test-unversioned? 2)) 18]
      ;; (3) An INDIRECT call is outside the clone whitelist.
      [(not (opt-bce-mbcall-test-unversioned? 3)) 19]
      ;; (6) One derived check does not pay for a duplicated call site.
      [(not (opt-bce-mbcall-test-unversioned? 4)) 20]
      ;; An unresolved callee earns no bit at all.
      [(not (opt-bce-mbcall-test-unversioned? 5)) 21]
      ;; (5) The summary bit itself: element-only earns bit 2, element PLUS a
      ;; parameter write does not -- that callee's write may be the caller's
      ;; own descriptor.
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits
                (opt.opt-call-memory-summary-add-element 0))
              (opt.opt-direct-call-clean-unconditional-global-bit))
            (opt.opt-direct-call-clean-unconditional-global-bit)))
        22]
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits
                (opt.opt-call-memory-summary-add-element 1))
              (opt.opt-direct-call-clean-unconditional-global-bit))
            0))
        23]
      ;; ... while that same summary keeps bit 1, so nothing the global-operand
      ;; readers already proved is lost.
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits
                (opt.opt-call-memory-summary-add-element 1))
              (opt.opt-direct-call-clean-global-bit))
            (opt.opt-direct-call-clean-global-bit)))
        24]
      ;; ... and a global-writing callee earns neither global bit -- only the
      ;; header bit (SUM-6): its writes land in named cells and elements, which
      ;; cannot move a descriptor word.
      [(not
          (=
            (opt.opt-loop-bce-direct-call-clean-bits
              (opt.opt-call-memory-summary-add-global
                (opt.opt-call-memory-summary-add-element 0)))
            (opt.opt-direct-call-clean-header-bit)))
        25]
      ;; SUM-6: the header bit. Cells and elements only -- with or without a
      ;; named cell write -- earn it; an unknown write or a parameter write
      ;; does not. A cell-writing callee earns it WITHOUT the global bits.
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits
                (opt.opt-call-memory-summary-add-global
                  (opt.opt-call-memory-summary-add-element 0)))
              (bit-or
                (opt.opt-direct-call-clean-header-bit)
                (bit-or
                  (opt.opt-direct-call-clean-global-bit)
                  (opt.opt-direct-call-clean-unconditional-global-bit))))
            (opt.opt-direct-call-clean-header-bit)))
        26]
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits
                (opt.opt-call-memory-summary-add-element 0))
              (opt.opt-direct-call-clean-header-bit))
            (opt.opt-direct-call-clean-header-bit)))
        27]
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits
                (opt.opt-call-memory-summary-add-unknown 0))
              (opt.opt-direct-call-clean-header-bit))
            0))
        28]
      [(not
          (=
            (bit-and
              (opt.opt-loop-bce-direct-call-clean-bits 1)
              (opt.opt-direct-call-clean-header-bit))
            0))
        29]
      [else 42])))

;; Does this guard block rebuild a module global's descriptor chain?
(define (opt-bce-mbcall-test-guard-has-global?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 0]
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [seen : bool false]
            (begin
              (while (< index count)
                (begin
                  (match (ir.compiler-ir-instr-seq-ref instrs index)
                    [(ir.CompilerIrInstr.Gep _ base _ _)
                      (match base
                        [(ir.CompilerIrValue.Global sym)
                          (if (= sym (opt-bce-mbcall-test-global))
                            (set! seen true)
                            unit)]
                        [_ unit])]
                    [_ unit])
                  (set! index (+ index 1))))
              seen))])]))

(test
  bce-version-mbcall-clone
  (test.assert-i64-eq
    (compiler-optimize-bce-version-mbcall-self-test)
    42
    "a call-carrying counted loop versions when its callee cannot move a descriptor word"))

;; --- strided variable-base runtime boundary tests ---------------------------------
;;
;; Strided windows with a variable base: `base + scale*i + k` exactly at the
;; array end still passes the synthesized derived-seed guard, and every
;; in-bounds window computes the same result with or without versioning. A
;; window one past the end fails the guard and aborts on the checked slow
;; path; the inline harness has no way to assert aborts, so only correct
;; results are asserted here.
(define (opt-bce-sb-runtime-make [n : i64] [step : i64]) : (__tl_dyn-array i64)
  (let
    [out : (__tl_dyn-array i64) (__tl_make-array i64 n)]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref out i) (* i step))
          (set! i (+ i 1))))
      out)))

(define (opt-bce-sb-runtime-sum2
  [text : (& text (__tl_dyn-array i64))]
  [base : i64]
  [count : i64]) : i64
  (let
    [i : i64 0]
    [acc : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! acc (+ acc (array-ref text (+ base (* i 2)))))
          (set! acc (+ acc (array-ref text (+ (+ base (* i 2)) 1))))
          (set! i (+ i 1))))
      acc)))

(define (opt-bce-sb-runtime-sum8
  [text : (& text (__tl_dyn-array i64))]
  [base : i64]
  [count : i64]) : i64
  (let
    [i : i64 0]
    [acc : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! acc (+ acc (array-ref text (+ base (* i 8)))))
          (set! i (+ i 1))))
      acc)))

(define (opt-bce-sb-runtime-fill2
  [out : (&mut out (__tl_dyn-array i64))]
  [base : i64]
  [count : i64]
  [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref out (+ base (* i 2))) value)
          (set! i (+ i 1))))
      unit)))

(define (opt-bce-sb-runtime-fill8
  [out : (&mut out (__tl_dyn-array i64))]
  [base : i64]
  [count : i64]
  [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref out (+ base (* i 8))) value)
          (set! i (+ i 1))))
      unit)))

;; The CSR counting-fill shape: a strided variable-base token read (derivable)
;; feeding a data-indexed fill read+write (kept in the fast clone).
(define (opt-bce-sb-runtime-hist2
  [tokens : (__tl_dyn-array i64)]
  [fill : (&mut fill (__tl_dyn-array i64))]
  [base : i64]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (let
          [src : i64 (array-ref tokens (+ base (* i 2)))]
          (begin
            (set! (array-ref fill src) (+ (array-ref fill src) 1))
            (set! i (+ i 1)))))
      unit)))

(test
  bce-version-strided-runtime-load2-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 16 3)]
    (begin
      ;; base + 2*(count-1) + 1 == 15: the pair window ends exactly at the
      ;; array end, so the guard accepts at equality.
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 4 6)
        342
        "scale-2 pair window ending exactly at the array end")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 0 8)
        360
        "scale-2 whole array from a zero base")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 14 1)
        87
        "scale-2 single pair at the last slots")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 4 0)
        0
        "scale-2 empty window"))))

(test
  bce-version-strided-runtime-load8-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 25 1)]
    (begin
      ;; base + 8*(count-1) == 24: the stride lands exactly on the last slot.
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 0 4)
        48
        "scale-8 window landing exactly on the last slot")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 1 3)
        27
        "scale-8 interior window")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 24 1)
        24
        "scale-8 single read at the last slot")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 3 0)
        0
        "scale-8 empty window"))))

(test
  bce-version-strided-runtime-store2-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 16 1)]
    (begin
      ;; base + 2*(count-1) == 14: the last store lands at the stride boundary.
      (opt-bce-sb-runtime-fill2 (&mut buf) 4 6 7)
      (test.assert-i64-eq
        (array-ref buf 14)
        7
        "scale-2 store at the stride boundary")
      (test.assert-i64-eq
        (array-ref buf 15)
        15
        "slot past the stride untouched")
      (test.assert-i64-eq
        (array-ref buf 2)
        2
        "slot before the window untouched")
      (opt-bce-sb-runtime-fill2 (&mut buf) 0 8 9)
      (test.assert-i64-eq (array-ref buf 0) 9 "scale-2 store from a zero base")
      (test.assert-i64-eq
        (array-ref buf 14)
        9
        "scale-2 boundary store from a zero base"))))

(test
  bce-version-strided-runtime-store8-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 25 1)]
    (begin
      ;; base + 8*(count-1) == 24: the last store lands exactly on the last slot.
      (opt-bce-sb-runtime-fill8 (&mut buf) 0 4 7)
      (test.assert-i64-eq (array-ref buf 24) 7 "scale-8 store on the last slot")
      (test.assert-i64-eq
        (array-ref buf 23)
        23
        "slot beside the stride untouched")
      (test.assert-i64-eq (array-ref buf 8) 7 "scale-8 interior stride slot")
      (opt-bce-sb-runtime-fill8 (&mut buf) 1 3 9)
      (test.assert-i64-eq
        (array-ref buf 17)
        9
        "scale-8 store from a nonzero base")
      (test.assert-i64-eq
        (array-ref buf 18)
        18
        "slot past the nonzero stride untouched"))))

(test
  bce-version-strided-runtime-partial-hist
  (let
    [tokens : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 16 0)]
    [fill : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 8 0)]
    (begin
      (set! (array-ref tokens 0) 7)
      (set! (array-ref tokens 2) 3)
      (set! (array-ref tokens 4) 7)
      (set! (array-ref tokens 6) 1)
      (set! (array-ref tokens 8) 3)
      (set! (array-ref tokens 10) 7)
      (set! (array-ref tokens 12) 2)
      (set! (array-ref tokens 14) 5)
      ;; base + 2*(count-1) == 14: the last token read is in bounds; the
      ;; fill checks ride along in the fast clone.
      (opt-bce-sb-runtime-hist2 tokens (&mut fill) 0 8)
      (test.assert-i64-eq
        (array-ref fill 7)
        3
        "histogram slot 7 counted three hits")
      (test.assert-i64-eq
        (array-ref fill 3)
        2
        "histogram slot 3 counted two hits")
      (test.assert-i64-eq
        (array-ref fill 1)
        1
        "histogram slot 1 counted one hit")
      (test.assert-i64-eq
        (array-ref fill 2)
        1
        "histogram slot 2 counted one hit")
      (test.assert-i64-eq
        (array-ref fill 5)
        1
        "histogram slot 5 counted one hit")
      (test.assert-i64-eq (array-ref fill 0) 0 "histogram slot 0 stayed empty"))))

(define (opt-unroll-mb-read-only-test-body) : ir.CompilerIrBlockList
  (irt.blocks "read_only:
       %9 = load %2 : i64
       jump read_only_exit"))

;; Build the exact CFG fragment produced by the production multiblock clone at
;; an absorbed call site, then leave a self tail call in its continuation. The
;; optimizer turns that tail call into an entry backedge. This combines the two
;; shapes that exposed the regression: a cloned, bounds-carrying inner loop and
;; an enclosing caller loop whose header is the function entry.
(define (opt-merged-loop-test-params) : ir.CompilerIrParamSeq
  (irt.params
    "n=%0:i64, len=%1:i64, base=%2:(__tl_dyn-array i64), rounds=%3:i64"))

(define (opt-merged-loop-test-callee-args) : ir.CompilerIrCallArgs
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (begin
      (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
      (set! (array-ref args 1) (ir.CompilerIrValue.Var 1))
      (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
      (ir.CompilerIrCallArgs.Array args))))

(define (opt-merged-loop-test-callee-blocks) : ir.CompilerIrBlockList
  (opt.opt-function-blocks
    (opt.opt-ssa-construct-function
      (ast.ast-node-pool-reader-type-segment-bases)
      (ir.CompilerIrFunction.Function
        (opt-test-symbol "merged_loop_callee")
        (opt-bce-version-test-params)
        (ast.AstType.I64)
        9
        (opt-bce-mb-pipeline-blocks)
        ir.CompilerIrFunctionAbi.Ordinary))))

(define (opt-merged-loop-test-function) : ir.CompilerIrFunction
  (let
    [name : i64 (opt-test-symbol "merged_loop_caller")]
    [prefix : String "inl.absorbed.0"]
    [cont : i64 (ir.compiler-ir-label "inl.absorbed.0.cont")]
    (match (opt.opt-inline-clone-multiblock-blocks-with-spans
      (opt-merged-loop-test-callee-blocks)
      prefix
      cont
      ;; The tail-call result slot base production would hand this clone:
      ;; base 5 + (callee frame 9 - 3 params). This callee carries no tail
      ;; call, so no block reads it.
      11
      ;; A call SITE, so the clone's exits converge on `cont` as before; the
      ;; site return type is unread on that path.
      false
      (ast.AstType.I64)
      (opt-merged-loop-test-callee-args)
      3
      5
      (ir.compiler-source-spans-empty)
      (ir.compiler-source-spans-empty)
      0
      (opt-test-inline-no-span-call)
      0)
      [(opt.OptInlineMultiSpanClone.Clone cloned return-inputs _)
        (let
          [entry-blocks : ir.CompilerIrBlockList
            (irt.blocks
              "entry:
                 %4 = gt %3, 0 : bool
                 branch %4, call_site, caller_exit
               call_site:
                 jump inl.absorbed.0.entry")]
          [tail-blocks : ir.CompilerIrBlockList
            (ir.compiler-ir-block-cons
              (ir.CompilerIrBlock.Block
                cont
                (opt-test-instrs
                  (opt.opt-inline-cont-result-instr
                    100
                    return-inputs
                    (ast.AstType.I64))
                  (irt.instr "%101 = sub %3, 1 : i64")
                  (irt.instr
                    "tailcall merged_loop_caller(%0, %1, %2, %101) : i64")))
              (irt.blocks "caller_exit:
                   return 0"))]
          (ir.CompilerIrFunction.Function
            name
            (opt-merged-loop-test-params)
            (ast.AstType.I64)
            102
            (opt.opt-inline-block-append
              entry-blocks
              (opt.opt-inline-block-append cloned tail-blocks))
            ir.CompilerIrFunctionAbi.Ordinary))])))

;; The unroller's multi-block companion must pick up the check-free versioned
;; diamond on a later optimizer iteration (after its dedicated preheader has
;; been synthesized), peel the odd iteration, and emit exactly two body copies.
(define (compiler-optimize-unroll-mb-self-test) : i64
  (let
    [optimized : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "unroll_mb_while_fixture")
          (opt-bce-version-test-params)
          (ast.AstType.I64)
          9
          (opt-bce-mb-pipeline-blocks)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view optimized))]
    ;; The caller's self tail call is rewritten into its loop before the
    ;; pipeline, as the program-wide tailrec stage does ahead of the inliner.
    [merged : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-tailrec-function (opt-merged-loop-test-function)))]
    [merged-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view merged))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function optimized))) 1]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-global-shared-view blocks)
            (ir.compiler-ir-label "body__bce_fast__unroll2_guard")))
        2]
      ;; Arm-local swap/update work is deliberately not if-converted: both
      ;; four-block unrolled diamonds remain intact.
      [(not
          (=
            (opt-bce-mb-test-matching-blocks
              (ir.compiler-ir-global-shared-view blocks)
              "__unroll2_0"
              0)
            4))
        3]
      [(not
          (=
            (opt-bce-mb-test-matching-blocks
              (ir.compiler-ir-global-shared-view blocks)
              "__unroll2_1"
              0)
            4))
        4]
      ;; The original fast peel and both pair copies remain check-free; the
      ;; slow original still carries both aborting checks.
      [(not
          (=
            (opt-bce-mb-test-matching-checks
              (ir.compiler-ir-global-shared-view blocks)
              "__unroll2"
              0)
            0))
        5]
      [(not
          (=
            (opt-bce-mb-test-matching-checks
              (ir.compiler-ir-global-shared-view blocks)
              "__bce_fast"
              0)
            0))
        6]
      [(< (opt-bce-version-test-prefix-checks blocks "" 0) 2) 7]
      ;; The profitability gate rejects read-only diamonds; StorePtr is
      ;; admitted only on this proven-fast path, while calls and checks
      ;; themselves remain outside the cloning whitelist.
      [(not
          (=
            (opt.opt-unroll-mb-body-status (opt-unroll-mb-read-only-test-body))
            0))
        8]
      [(not
          (opt.opt-unroll-mb-body-instr-ok?
            (irt.instr "store_ptr %0, %1 : i64")))
        9]
      [(opt.opt-unroll-mb-body-instr-ok?
          (irt.instr "%0 = call unroll_mb_callee() : i64"))
        10]
      [(opt.opt-unroll-mb-body-instr-ok?
          (irt.instr "bounds_check %0, %1 message \"unroll_mb_check\""))
        11]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function merged))) 12]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged-blocks)
            (ir.compiler-ir-label "entry__ssa_entry")))
        13]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view merged-blocks)
            (ir.compiler-ir-label
              "inl.absorbed.0.body__bce_fast__unroll2_guard")))
        14]
      [(not
          (=
            (opt-bce-mb-test-matching-blocks
              (opt.compiler-opt-global-shared-view merged-blocks)
              "__unroll2_0"
              0)
            4))
        15]
      [(not
          (=
            (opt-bce-mb-test-matching-blocks
              (opt.compiler-opt-global-shared-view merged-blocks)
              "__unroll2_1"
              0)
            4))
        16]
      [(not
          (= (opt-bce-mb-test-matching-checks merged-blocks "__bce_fast" 0) 0))
        17]
      [else 42])))

;; --- pre-existing-phi SSA construction self-test --------------------------------
;; A value-if join lowers to a Phi while `set!` locals stay multi-def Movs, so
;; the function reaches SSA construction with BOTH pre-existing phis and rename
;; candidates. Construction must rename the phi's inputs per edge; a phi whose
;; DST is itself multi-def must reject (function left non-SSA).
(define (opt-ssa-preexisting-test-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool"))

(define (opt-ssa-preexisting-test-blocks [dup-phi-dst : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 2 (ir.CompilerIrValue.I64 5) (ast.AstType.I64))
        (ir.CompilerIrInstr.Mov
          (if dup-phi-dst
            4
            5)
          (ir.CompilerIrValue.I64 1)
          (ast.AstType.I64))
        (irt.instr "branch %0, then, else")))
    (irt.blocks
      "then:
         %3 = mov 7 : i64
         jump join
       else:
         %3 = mov 11 : i64
         jump join
       join:
         %4 = phi [%3, then], [%3, else] : i64
         %2 = mov 9 : i64
         %6 = add %4, %2 : i64
         return %6")))

(define (opt-ssa-preexisting-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_preexisting_phi")
    (opt-ssa-preexisting-test-params)
    (ast.AstType.I64)
    7
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-ssa-preexisting-test-first-phi-inputs
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : ir.CompilerIrValueSeq
  (if (>= index count)
    (ir.compiler-ir-value-seq-empty)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ inputs _)
        (let
          [phi-inputs-at-54784-9 : ir.CompilerIrPhiInputSeq inputs]
          (if (<= phi-inputs-at-54784-9.len 0)
            (ir.compiler-ir-value-seq-empty)
            (let
              [phi-input-at-54784-9 : ir.CompilerIrPhiInput
                (ir.compiler-ir-phi-input-seq-ref
                  (ir.compiler-ir-global-shared-view phi-inputs-at-54784-9)
                  0)]
              [a : ir.CompilerIrValue phi-input-at-54784-9.value]
              [rest : ir.CompilerIrPhiInputSeq
                (ir.CompilerIrPhiInputSeq
                  phi-inputs-at-54784-9.slots
                  (+ phi-inputs-at-54784-9.start 1)
                  (- phi-inputs-at-54784-9.len 1))]
              [phi-inputs-at-54786-13 : ir.CompilerIrPhiInputSeq rest]
              (if (<= phi-inputs-at-54786-13.len 0)
                (ir.compiler-ir-value-seq-empty)
                (let
                  [phi-input-at-54786-13 : ir.CompilerIrPhiInput
                    (ir.compiler-ir-phi-input-seq-ref phi-inputs-at-54786-13 0)]
                  [b : ir.CompilerIrValue phi-input-at-54786-13.value]
                  (ir.compiler-ir-value-seq2 a b))))))]
      [_ (opt-ssa-preexisting-test-first-phi-inputs instrs (+ index 1) count)])))

;; The join block's first phi's two inputs; Nil when missing.
(define (opt-ssa-preexisting-test-phi-inputs [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrValueSeq
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label "join"))
    [(opt.OptMaybeBlock.No) (ir.compiler-ir-value-seq-empty)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-ssa-preexisting-test-first-phi-inputs
            (ir.compiler-ir-global-shared-view instrs)
            0
            (ir.compiler-ir-instr-seq-count instrs))])]))

(define (compiler-optimize-ssa-preexisting-phi-self-test) : i64
  (let
    [constructed : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-preexisting-test-function
          (opt-ssa-preexisting-test-blocks false)))]
    [rejected : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-preexisting-test-function
          (opt-ssa-preexisting-test-blocks true)))]
    (cond
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view constructed))))
        1]
      ;; the pre-existing join phi reads the then/else VERSIONS of var 3: two
      ;; Var inputs that differ from each other (unrewritten would be 3 == 3).
      [(let
          [values : ir.CompilerIrValueSeq
            (opt-ssa-preexisting-test-phi-inputs
              (opt.opt-function-blocks constructed))]
          (if (= values.len 2)
            (match (ir.compiler-ir-value-seq-ref
              (ir.compiler-ir-global-shared-view values)
              0)
              [(ir.CompilerIrValue.Var av)
                (match (ir.compiler-ir-value-seq-ref values 1)
                  [(ir.CompilerIrValue.Var bv) (= av bv)]
                  [_ true])]
              [_ true])
            true))
        2]
      ;; a multi-def phi DST rejects: the function stays non-SSA.
      [(opt.opt-verify-ok? (opt.opt-verify-function rejected)) 3]
      [else 42])))

;; --- multi-exit loop LICM self-test ---------------------------------------------
;; A probe-shaped search loop (guarded header, bounds check, early-return side
;; exit) must still hoist its loop-invariant ptr/len loads; adding an in-loop
;; store must block the hoist.
(define (opt-licm-multi-exit-test-params) : ir.CompilerIrParamSeq
  (irt.params "map=%0:i64, key=%1:i64, limit=%2:i64"))

(define (opt-licm-multi-exit-header-block) : ir.CompilerIrBlock
  (irt.block
    "header:
       %3 = phi [0, entry], [%10, next] : i64
       %4 = phi [0, entry], [%11, next] : i64
       %5 = lt %4, %2 : bool
       branch %5, body, exit"))

(define (opt-licm-multi-exit-body-tail [mode : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%12 = gep %9, %3 : i64")
    (ir.CompilerIrInstr.Load 13 (ir.CompilerIrValue.Var 12) (ast.AstType.I64))
    (irt.instr "%14 = eq %13, %1 : bool")
    (if (= mode 0)
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "next"))
      (irt.instr "branch %14, found, next"))))

(define (opt-licm-multi-exit-body-block [mode : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (opt-licm-multi-exit-body-tail mode)
      (irt.instr "%6 = gep %0, 1 : i64")
      (ir.CompilerIrInstr.Load 7 (ir.CompilerIrValue.Var 6) (ast.AstType.I64))
      (irt.instr "bounds_check %3, %7 message \"licm_multi_exit_ok\"")
      (irt.instr "%8 = gep %0, 0 : i64")
      (ir.CompilerIrInstr.Load 9 (ir.CompilerIrValue.Var 8) (ast.AstType.I64)))))

(define (opt-licm-multi-exit-next-block [with-store : bool]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "next")
    (opt-test-instrs-with-tail
      (if with-store
        (irt.instrs "store_ptr %12, 0 : i64
           jump header")
        (irt.instrs "jump header"))
      (irt.instr "%10 = add %3, 1 : i64")
      (irt.instr "%11 = add %4, 1 : i64"))))

(define (opt-licm-multi-exit-found-block [mode : i64]) : ir.CompilerIrBlock
  (if (= mode 1)
    ;; return-shaped side exit: a found handler locates the slot (bounded
    ;; memory work) and returns -- still a short-trip SEARCH, so the invariant
    ;; load hoist is suppressed (the put! shape: gep/load/store then return).
    (irt.block
      "found:
         %16 = load %12 : i64
         store_ptr %12, %16 : i64
         return %16")
    ;; break-shaped side exit: the continuation calls out to unbounded work,
    ;; marking a long-trip kernel -- the hoist stays.
    (irt.block
      "found:
         %16 = call licm_multi_exit_callee() : i64
         return %16")))

(define (opt-licm-multi-exit-tail-blocks [mode : i64]) : ir.CompilerIrBlockList
  (let
    [exit-block : ir.CompilerIrBlock (irt.block "exit:
           return 0")]
    (if (= mode 0)
      (ir.compiler-ir-block-cons exit-block (ir.CompilerIrBlockList.Nil))
      (ir.compiler-ir-block-cons
        (opt-licm-multi-exit-found-block mode)
        (ir.compiler-ir-block-cons exit-block (ir.CompilerIrBlockList.Nil))))))

(define (opt-licm-multi-exit-test-blocks [mode : i64] [with-store : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump header")
    (ir.compiler-ir-block-cons
      (opt-licm-multi-exit-header-block)
      (ir.compiler-ir-block-cons
        (opt-licm-multi-exit-body-block mode)
        (ir.compiler-ir-block-cons
          (opt-licm-multi-exit-next-block with-store)
          (opt-licm-multi-exit-tail-blocks mode))))))

(define (opt-licm-multi-exit-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_multi_exit")
    (opt-licm-multi-exit-test-params)
    (ast.AstType.I64)
    17
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-licm-multi-exit-count-loads-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-licm-multi-exit-count-loads-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      count
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Load _ _ _) (+ acc 1)]
        [_ acc]))))

(define (opt-licm-multi-exit-count-loads
  [blocks : ir.CompilerIrBlockList]
  [label-want : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label-want)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (opt-licm-multi-exit-count-loads-seq
            (ir.compiler-ir-global-shared-view instrs)
            0
            (ir.compiler-ir-instr-seq-count instrs)
            0)])]))

(define (compiler-optimize-licm-multi-exit-self-test) : i64
  (let
    [single : ir.CompilerIrFunction
      (opt.opt-licm-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 0 false)))]
    [single-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view single))]
    [ret-exit : ir.CompilerIrFunction
      (opt.opt-licm-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 1 false)))]
    [ret-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks ret-exit)]
    [brk-exit : ir.CompilerIrFunction
      (opt.opt-licm-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 2 false)))]
    [brk-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks brk-exit)]
    [stored : ir.CompilerIrFunction
      (opt.opt-licm-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 0 true)))]
    [stored-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks stored)]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function single))) 1]
      ;; single-exit search loop: the invariant ptr/len loads hoist; only the
      ;; varying element load stays in the body.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              (opt.compiler-opt-global-shared-view single-blocks)
              (ir.compiler-ir-label "body"))
            1))
        2]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              single-blocks
              (ir.compiler-ir-label "entry"))
            2))
        3]
      ;; a RETURN-SHAPED side exit (early-return probe that does bounded
      ;; gep/load/store work then returns -- the put! shape) suppresses the
      ;; load hoist: short trips make it pure register pressure (see the
      ;; measured note at opt-licm-apply-loop).
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              ret-blocks
              (ir.compiler-ir-label "body"))
            3))
        4]
      ;; a BREAK-shaped side exit (continuation calls out to unbounded work)
      ;; marks a long-trip kernel: the hoist stays.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              (opt.compiler-opt-global-shared-view brk-blocks)
              (ir.compiler-ir-label "body"))
            1))
        5]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              brk-blocks
              (ir.compiler-ir-label "entry"))
            2))
        6]
      ;; an in-loop store blocks the hoist entirely.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              stored-blocks
              (ir.compiler-ir-label "body"))
            3))
        7]
      [else 42])))

;; --- #7992: element-load dereferenceability ----------------------------------
;;
;; A loop reads `array[k]` in an arm it may not take, behind the arm's own
;; bounds check. LICM may move that read to the preheader only where
;; `k <u array.len` is PROVEN there; every mode below changes what the entry
;; proves and nothing else.
;;
;;   entry:  len = array.len ; data = array.data ; olen = other.len
;;           data2 = mov data ; <proof> ; jump pre (or branch)
;;   pre:    jump loop                     (the preheader)
;;   loop:   i = phi ; sum = phi ; branch cond, arm, latch
;;   arm:    bounds_check k, len ; v = load (gep data, k) ; sum' = sum + v
;;   latch:  sum'' = phi ; i' = i + 1 ; branch i' < 10, loop, exit
;;
;; Modes:
;;   0  nothing outside the loop proves the bound
;;   1  `bounds_check k, len` in the entry
;;   2  the entry branches `lt k, len : u64` to `pre`, `pre`'s only predecessor
;;   3  the same branch compared SIGNED, which bounds nothing below
;;   4  `bounds_check k, olen`: another array's length
;;   5  mode 2's branch, but `pre` is also reached from `alt`
;;   6  the read is `data[3]`, and the entry checks the literal 5
;;   7  the read is `data[3]`, and the entry checks only the literal 2
;;   8  mode 1, with the read through `data2`, a copy of the data pointer
;;   9  the arm reads `array.len`, a header word: no bound is needed
;;  10  the arm reads byte `text[k]`, and the entry checks `k` against
;;      `text.len`
;;  11  mode 10, but the read is a whole word at that byte index: the bound
;;      covers one byte, not eight
;;  12  the arm reads `array`'s data re-strided as bytes, `data[k] : u8`: the
;;      bound counts i64 elements, not the stride the address uses
(define (opt-licm-bound-params) : ir.CompilerIrParamSeq
  (irt.params
    "cond=%0:bool, array=%1:(__tl_dyn-array i64), k=%2:i64, other=%3:(__tl_dyn-array i64), text=%23:String"))

(define (opt-licm-bound-entry [mode : i64]) : ir.CompilerIrInstrSeq
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 12)]
    (begin
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%4 = gep %1, 1 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Load 5 (ir.CompilerIrValue.Var 4) (ast.AstType.I64)))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%6 = gep %1, 0 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Load 7 (ir.CompilerIrValue.Var 6) (ast.AstType.U64)))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%8 = gep %3, 1 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Load 9 (ir.CompilerIrValue.Var 8) (ast.AstType.I64)))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Mov 10 (ir.CompilerIrValue.Var 7) (ast.AstType.U64)))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%24 = gep %23, 1 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%25 = load %24 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%26 = gep %23, 0 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%27 = load %26 : u64"))
      (cond
        [(or (= mode 1) (= mode 8) (= mode 12))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (irt.instr "bounds_check %2, %5 message \"entry_ok\""))]
        [(= mode 4)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (irt.instr "bounds_check %2, %9 message \"entry_ok\""))]
        [(or (= mode 10) (= mode 11))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (irt.instr "bounds_check %2, %25 message \"entry_ok\""))]
        [(or (= mode 6) (= mode 7))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.BoundsCheck
              (ir.CompilerIrValue.I64
                (if (= mode 6)
                  5
                  2))
              (ir.CompilerIrValue.Var 5)
              (ir.compiler-ir-label "entry_ok")))]
        [else unit])
      (if (or (= mode 2) (= mode 3) (= mode 5))
        (begin
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.BinOp
              11
              (ir.CompilerIrBinOp.Lt)
              (ir.CompilerIrValue.Var 2)
              (ir.CompilerIrValue.Var 5)
              (if (= mode 3)
                (ast.AstType.I64)
                (ast.AstType.U64))))
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Branch
              (ir.CompilerIrValue.Var 11)
              (ir.compiler-ir-label "pre")
              (ir.compiler-ir-label
                (if (= mode 5)
                  "alt"
                  "exit")))))
        (ir.compiler-ir-instr-builder-push!
          (&mut builder)
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "pre"))))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-licm-bound-arm [mode : i64]) : ir.CompilerIrInstrSeq
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 6)]
    [index : ir.CompilerIrValue
      (if (or (= mode 6) (= mode 7))
        (ir.CompilerIrValue.I64 3)
        (ir.CompilerIrValue.Var 2))]
    (begin
      (cond
        [(= mode 9)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (irt.instr "%14 = gep %1, 1 : i64"))]
        [(>= mode 10)
          (begin
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.BoundsCheck
                (ir.CompilerIrValue.Var 2)
                (ir.CompilerIrValue.Var
                  (if (= mode 12)
                    5
                    25))
                (ir.compiler-ir-label "arm_ok")))
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Gep
                14
                (ir.CompilerIrValue.Var
                  (if (= mode 12)
                    7
                    27))
                (ir.CompilerIrValue.Var 2)
                (ast.AstType.U8))))]
        [else
          (begin
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.BoundsCheck
                (ir.compiler-ir-global-shared-view index)
                (ir.CompilerIrValue.Var 5)
                (ir.compiler-ir-label "arm_ok")))
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Gep
                14
                (ir.CompilerIrValue.Var
                  (if (= mode 8)
                    10
                    7))
                index
                (ast.AstType.I64))))])
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Load
          15
          (ir.CompilerIrValue.Var 14)
          (if (or (= mode 10) (= mode 12))
            (ast.AstType.U8)
            (ast.AstType.I64))))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (irt.instr "%18 = add %13, %15 : i64"))
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))
      (ir.compiler-ir-instr-builder-to-seq builder))))

(define (opt-licm-bound-loop-blocks [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "loop:
         %12 = phi [0, pre], [%16, latch] : i64
         %13 = phi [0, pre], [%17, latch] : i64
         branch %0, arm, latch")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "arm")
        (opt-licm-bound-arm mode))
      (irt.blocks
        "latch:
           %17 = phi [%18, arm], [%13, loop] : i64
           %16 = add %12, 1 : i64
           %19 = lt %16, 10 : i64
           branch %19, loop, exit
         exit:
           return 0"))))

(define (opt-licm-bound-blocks [mode : i64]) : ir.CompilerIrBlockList
  (let
    [pre-and-loop : ir.CompilerIrBlockList
      (ir.compiler-ir-block-cons
        (irt.block "pre:
             jump loop")
        (opt-licm-bound-loop-blocks mode))]
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-licm-bound-entry mode))
      (if (= mode 5)
        (ir.compiler-ir-block-cons
          (irt.block "alt:
               jump pre")
          pre-and-loop)
        pre-and-loop))))

(define (opt-licm-bound-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_bound")
    (opt-licm-bound-params)
    (ast.AstType.I64)
    32
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

;; The loads left in `pre` (the preheader) and in `arm` after one LICM run,
;; packed as `pre * 10 + arm`: 10 is a hoisted read, 1 one that stayed.
(define (opt-licm-bound-run [mode : i64] [late? : bool]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-licm-bound-blocks mode)]
    [func : ir.CompilerIrFunction
      (opt-licm-bound-function (ir.compiler-ir-global-shared-view blocks))]
    [result : ir.CompilerIrFunction
      (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-cfg-context-build blocks)
        false
        (opt_i64_i64_map.with-capacity 1)
        (opt_i64_i64_map.with-capacity 1)
        (opt.opt-global-cell-summary-empty)
        late?
        func)
        [(opt.OptFunctionCtxResult.Result next _) next])]
    [out : ir.CompilerIrBlockList (opt.opt-function-blocks result)]
    (+
      (*
        (opt-licm-multi-exit-count-loads
          (ir.compiler-ir-global-shared-view out)
          (ir.compiler-ir-label "pre"))
        10)
      (opt-licm-multi-exit-count-loads out (ir.compiler-ir-label "arm")))))

(define (compiler-optimize-licm-element-bound-self-test) : i64
  (let
    [hoisted : i64 10]
    [kept : i64 1]
    (cond
      [(not (= (opt-licm-bound-run 0 false) kept)) 1]
      [(not (= (opt-licm-bound-run 1 false) hoisted)) 2]
      [(not (= (opt-licm-bound-run 2 false) hoisted)) 3]
      [(not (= (opt-licm-bound-run 3 false) kept)) 4]
      [(not (= (opt-licm-bound-run 4 false) kept)) 5]
      [(not (= (opt-licm-bound-run 5 false) kept)) 6]
      [(not (= (opt-licm-bound-run 6 false) hoisted)) 7]
      [(not (= (opt-licm-bound-run 7 false) kept)) 8]
      [(not (= (opt-licm-bound-run 8 false) hoisted)) 9]
      [(not (= (opt-licm-bound-run 9 false) hoisted)) 10]
      [(not (= (opt-licm-bound-run 10 false) hoisted)) 13]
      [(not (= (opt-licm-bound-run 11 false) kept)) 14]
      [(not (= (opt-licm-bound-run 12 false) kept)) 15]
      ;; The post-BCE run takes the same rule: the versioner's guard is the
      ;; proof a fast copy's read carries there.
      [(not (= (opt-licm-bound-run 0 true) kept)) 11]
      [(not (= (opt-licm-bound-run 2 true) hoisted)) 12]
      [else 42])))

;; --- descriptor-header hoist past the return-shaped suppression ---------------
;;
;; The probe-shaped side-exit suppression (opt-licm-apply-loop) is a
;; profitability gate: descriptor header loads (data-pointer and length slots
;; of a loop-invariant array handle) are excepted from it in the late licm
;; when the loop body cannot write a descriptor header. This shape mirrors
;; opt-licm-multi-exit-test-blocks but with an array-typed parameter: a
;; guarded counted loop whose body bounds-checks against the descriptor
;; length, reads an element through the descriptor data pointer, and exits
;; early through a RETURN-shaped side exit. Poison variants: 0 = clean body,
;; 1 = unknown call in the latch, 2 = store through an unknown pointer,
;; 3 = store through the loaded element pointer (an element-only store, which
;; must NOT block the header hoist).
(define (opt-licm-dh-test-params) : ir.CompilerIrParamSeq
  (irt.params "array=%0:(__tl_dyn-array i64), key=%1:i64, limit=%2:i64"))

(define (opt-licm-dh-header-block [variant-base? : bool]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "header")
    (opt-test-instrs
      (irt.instr "%3 = phi [0, entry], [%10, next] : i64")
      (if variant-base?
        (irt.instr "%16 = phi [%0, entry], [%0, next] : (__tl_dyn-array i64)")
        (ir.CompilerIrInstr.Mov 16 (ir.CompilerIrValue.I64 0) (ast.AstType.I64)))
      (irt.instr "%5 = lt %3, %2 : bool")
      (irt.instr "branch %5, body, exit"))))

(define (opt-licm-dh-body-block [variant-base? : bool]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "body")
    (opt-test-instrs
      (irt.instr "%6 = gep %0, 1 : i64")
      (ir.CompilerIrInstr.Load 7 (ir.CompilerIrValue.Var 6) (ast.AstType.I64))
      (irt.instr "bounds_check %3, %7 message \"licm_dh_ok\"")
      (ir.CompilerIrInstr.Gep
        8
        (ir.CompilerIrValue.Var
          (if variant-base?
            16
            0))
        (ir.CompilerIrValue.I64 0)
        (ast.AstType.I64))
      (ir.CompilerIrInstr.Load 9 (ir.CompilerIrValue.Var 8) (ast.AstType.I64))
      (irt.instr "%12 = gep %9, %3 : i64")
      (ir.CompilerIrInstr.Load 13 (ir.CompilerIrValue.Var 12) (ast.AstType.I64))
      (irt.instr "%14 = eq %13, %1 : bool")
      (irt.instr "branch %14, found, next"))))

(define (opt-licm-dh-next-block [poison : i64]) : ir.CompilerIrBlock
  (ir.CompilerIrBlock.Block
    (ir.compiler-ir-label "next")
    (opt-test-instrs
      (irt.instr "%10 = add %3, 1 : i64")
      (cond
        [(= poison 1) (irt.instr "%15 = call licm_dh_callee() : i64")]
        [(= poison 2) (irt.instr "store_ptr %2, %13 : i64")]
        [(= poison 3) (irt.instr "store_ptr %12, %13 : i64")]
        [else (irt.instr "%15 = mov 0 : i64")])
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header")))))

(define (opt-licm-dh-test-blocks [poison : i64] [variant-base? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump header")
    (ir.compiler-ir-block-cons
      (opt-licm-dh-header-block variant-base?)
      (ir.compiler-ir-block-cons
        (opt-licm-dh-body-block variant-base?)
        (ir.compiler-ir-block-cons
          (opt-licm-dh-next-block poison)
          (irt.blocks
            "found:
               return %13
             exit:
               return 0"))))))

(define (opt-licm-dh-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_dh")
    (opt-licm-dh-test-params)
    (ast.AstType.I64)
    17
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-licm-dh-late-optimized-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (let
    [func : ir.CompilerIrFunction
      (opt-licm-dh-test-function (ir.compiler-ir-global-shared-view blocks))]
    (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt.opt-cfg-context-build blocks)
      false
      (opt_i64_i64_map.with-capacity 1)
      (opt_i64_i64_map.with-capacity 1)
      (opt.opt-global-cell-summary-empty)
      true
      func)
      [(opt.OptFunctionCtxResult.Result next _) next])))

(define (compiler-optimize-licm-dh-self-test) : i64
  (let
    [early : ir.CompilerIrFunction
      (opt.opt-licm-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-licm-dh-test-function (opt-licm-dh-test-blocks 0 false)))]
    [early-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks early)]
    [clean : ir.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 0 false))]
    [clean-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view clean))]
    [called : ir.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 1 false))]
    [called-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks called)]
    [stored : ir.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 2 false))]
    [stored-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks stored)]
    [elem : ir.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 3 false))]
    [elem-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view elem))]
    [varbase : ir.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 0 true))]
    [varbase-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view varbase))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function clean))) 1]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function elem))) 2]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function varbase))) 3]
      ;; late licm, clean body: both descriptor header loads (length AND
      ;; data-pointer) leave the return-shaped-exit loop; only the varying
      ;; element load stays.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              (ir.compiler-ir-global-shared-view clean-blocks)
              (ir.compiler-ir-label "body"))
            1))
        4]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              clean-blocks
              (ir.compiler-ir-label "entry"))
            2))
        5]
      ;; the PRE-BCE licm keeps the suppression: moving descriptor facts that
      ;; early can hide the bound identity bce still needs.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              early-blocks
              (ir.compiler-ir-label "body"))
            3))
        6]
      ;; an unknown call in the body blocks the exception.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              called-blocks
              (ir.compiler-ir-label "body"))
            3))
        7]
      ;; a store through an unknown pointer (a header-or-unknown store) blocks
      ;; the exception.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              stored-blocks
              (ir.compiler-ir-label "body"))
            3))
        8]
      ;; an element-only store through the loaded data pointer does NOT block
      ;; it: element storage is disjoint from descriptor header words.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              (ir.compiler-ir-global-shared-view elem-blocks)
              (ir.compiler-ir-label "body"))
            1))
        9]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              elem-blocks
              (ir.compiler-ir-label "entry"))
            2))
        10]
      ;; a loop-variant descriptor base keeps its data-pointer load in the
      ;; body (the invariant length load still hoists).
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              (ir.compiler-ir-global-shared-view varbase-blocks)
              (ir.compiler-ir-label "body"))
            2))
        11]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              varbase-blocks
              (ir.compiler-ir-label "entry"))
            1))
        12]
      [else 42])))

(test
  licm-descriptor-header-hoist
  (test.assert-i64-eq
    (compiler-optimize-licm-dh-self-test)
    42
    "late licm hoists descriptor header loads from a header-write-free loop past the return-shaped suppression"))

;; Runtime witnesses for the hoisted data-pointer semantics: reads through the
;; descriptor must return the right values, and an element store in the loop
;; must be observed by the element reads (only the header load moves; element
;; loads stay in the body -- the IR-level poison-3 case stores through the
;; loaded element pointer, an alias of the hoisted header's data pointer).
(define (opt-licm-dh-runtime-sum
  [arr : (& arr (__tl_dyn-array i64))]
  [n : i64]
  [stop : i64]) : i64
  (let
    [i : i64 0]
    [ok : bool true]
    [acc : i64 0]
    (begin
      (while (and (< i n) ok)
        (begin
          (set! acc (+ acc (array-ref arr i)))
          (if (= (array-ref arr i) stop)
            (set! ok false)
            unit)
          (set! i (+ i 1))))
      acc)))

;; Store at i, accumulate the mirror slot n-1-i: the middle iteration reads a
;; slot stored by an earlier iteration, so the stores must be observed through
;; whatever pointer the loads use.
(define (opt-licm-dh-runtime-alias-store
  [arr : (&mut arr (__tl_dyn-array i64))]
  [n : i64]) : i64
  (let
    [i : i64 0]
    [ok : bool true]
    [acc : i64 0]
    (begin
      (while (and (< i n) ok)
        (begin
          (set! (array-ref arr i) (+ (array-ref arr i) 1))
          (set! acc (+ acc (array-ref arr (- (- n 1) i))))
          (if (< (array-ref arr (- (- n 1) i)) 0)
            (set! ok false)
            unit)
          (set! i (+ i 1))))
      acc)))

(test
  licm-descriptor-header-runtime
  (let
    [arr : (__tl_dyn-array i64) (__tl_make-array i64 8)]
    [work : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    (begin
      (set! (array-ref arr 0) 3)
      (set! (array-ref arr 1) 1)
      (set! (array-ref arr 2) 4)
      (set! (array-ref arr 3) 1)
      (set! (array-ref arr 4) 5)
      (set! (array-ref arr 5) 9)
      (set! (array-ref arr 6) 2)
      (set! (array-ref arr 7) 6)
      (test.assert-i64-eq
        (opt-licm-dh-runtime-sum arr 8 100)
        31
        "flag-exit loop over the descriptor data pointer sums every element")
      (test.assert-i64-eq
        (opt-licm-dh-runtime-sum arr 8 4)
        8
        "the early flag exit keeps the partial sum")
      (set! (array-ref work 1) 1)
      (set! (array-ref work 2) 2)
      (set! (array-ref work 3) 3)
      (set! (array-ref work 4) 4)
      (test.assert-i64-eq
        (opt-licm-dh-runtime-alias-store (&mut work) 5)
        13
        "element reads observe the loop's earlier element stores")
      (test.assert-i64-eq
        (array-ref work 3)
        4
        "each element store landed exactly once"))))

;; Compiler-internal global-shared-view deliberately creates a shallow handle
;; alias. The original and returned handles can therefore supply overlapping
;; `&` and `&mut` parameters even though their SSA parameter vars differ. LICM
;; must not use those different vars as noalias evidence. These are executable
;; witnesses for both a direct object-slot load and a nested owning-descriptor
;; load chain.
(defstruct OptLicmShallowDirectHolder
  (value i64))

(define (opt-licm-shallow-alias-direct
  [items : (__tl_dyn-array OptLicmShallowDirectHolder)]) : (__tl_dyn-array
    OptLicmShallowDirectHolder)
  items)

(define (opt-licm-shallow-overwrite-and-read
  [view : (& OptLicmShallowDirectHolder)]
  [items : (&mut (__tl_dyn-array OptLicmShallowDirectHolder))]) : i64
  (let
    [i : i64 0]
    [sum : i64 0]
    (begin
      (while (< i 2)
        (begin
          (set! (array-ref items 0) (OptLicmShallowDirectHolder (+ i 10)))
          (set! sum (+ sum view.value))
          (set! i (+ i 1))))
      sum)))

(define (opt-licm-shallow-direct-result) : i64
  (let
    [items : (__tl_dyn-array OptLicmShallowDirectHolder)
      (__tl_make-array OptLicmShallowDirectHolder 1)]
    (begin
      (set! (array-ref items 0) (OptLicmShallowDirectHolder 1))
      (let
        [alias : (__tl_dyn-array OptLicmShallowDirectHolder)
          (opt-licm-shallow-alias-direct
            (ir.compiler-ir-global-shared-view items))]
        (opt-licm-shallow-overwrite-and-read
          (& (array-ref items 0))
          (&mut alias))))))

(defstruct OptLicmShallowNestedHolder
  (items (__tl_dyn-array i64)))

(define (opt-licm-shallow-alias-nested
  [items : (__tl_dyn-array OptLicmShallowNestedHolder)]) : (__tl_dyn-array
    OptLicmShallowNestedHolder)
  items)

(define (opt-licm-shallow-replace-and-read-inner
  [view : (& OptLicmShallowNestedHolder)]
  [holders : (&mut (__tl_dyn-array OptLicmShallowNestedHolder))]
  [replacement : (__tl_dyn-array i64)]) : i64
  (let
    [i : i64 0]
    [result : i64 0]
    (begin
      (while (< i 1)
        (begin
          (set!
            (array-ref holders 0)
            (OptLicmShallowNestedHolder
              (ir.compiler-ir-global-shared-view replacement)))
          (set! result (array-ref view.items 0))
          (set! i (+ i 1))))
      result)))

(define (opt-licm-shallow-nested-result) : i64
  (let
    [old-items : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [new-items : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [holders : (__tl_dyn-array OptLicmShallowNestedHolder)
      (__tl_make-array OptLicmShallowNestedHolder 1)]
    (begin
      (set! (array-ref old-items 0) 10)
      (set! (array-ref new-items 0) 20)
      (set! (array-ref holders 0) (OptLicmShallowNestedHolder old-items))
      (let
        [alias : (__tl_dyn-array OptLicmShallowNestedHolder)
          (opt-licm-shallow-alias-nested
            (ir.compiler-ir-global-shared-view holders))]
        (opt-licm-shallow-replace-and-read-inner
          (& (array-ref holders 0))
          (&mut alias)
          new-items)))))

(test
  licm-explicit-shallow-view-alias
  (begin
    (test.assert-i64-eq
      (opt-licm-shallow-direct-result)
      21
      "direct explicit shallow aliases observe each store")
    (test.assert-i64-eq
      (opt-licm-shallow-nested-result)
      20
      "nested explicit shallow aliases observe replacement")))

;; --- ALIAS-3: the typed-word rule --------------------------------------------
;;
;; The shape the memory-root census is made of, in the smallest program that
;; has it. One loop, one write, and a descriptor chain reached through a
;; checked-reference PARAMETER rather than through an allocation of this
;; function or through a global cell:
;;
;;   %6  = gep %2, 0 : u8                     a fixed word of the object `out`
;;   %7  = load %6 : (__tl_dyn-array i64)     the descriptor handle it holds
;;   %8  = gep %7, 0 : i64                    that descriptor's data slot
;;   %9  = load %8 : u64                      the element buffer
;;   %10 = gep %9, %4 : i64                   one element of it
;;   store_ptr %10, 100 : i64                 the loop's only write
;;
;; `%6` is NOT a header-slot address: `%2` is a `(&mut ...)` parameter, not a
;; descriptor handle, not an `Alloc` of this function and not a global, so
;; every existing disjointness proof declines it and `%7` used to stay in the
;; loop with the whole chain behind it. What moves it is the ONLY fact that
;; holds here without an aliasing rule: the store writes an `i64` word and `%7`
;; reads a descriptor-handle word, and a store of one alias class cannot write
;; a word of another.
;;
;; The negatives are the boundary of exactly that claim. The first is the one
;; the packet's parameter-root rule would have moved and this one must not: a
;; SAME-CLASS load off the same parameter (`out.len`, an i64, against an i64
;; element store) is refused, because separating those two words needs the
;; objects to be disjoint and this language does not make two borrows disjoint
;; (see opt-licm-root-disjoint-store?). It is also the control that proves the
;; positive comes from the class rule and not from some header-slot path: if
;; `%6` were classified as a descriptor word, this load would move too.
(define (opt-ec-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (ir.CompilerIrParam.Param "cond" (ast.AstType.Bool) 0)
    (ir.compiler-ir-param-seq-prepend
      (ir.CompilerIrParam.Param "text" (ast.AstType.Ref 0 0) 1)
      (ir.compiler-ir-param-seq-prepend
        (ir.CompilerIrParam.Param "out" (ast.AstType.MutRef 0 0) 2)
        (ir.compiler-ir-param-seq-prepend
          (ir.CompilerIrParam.Param "raw" (ast.AstType.U64) 20)
          (ir.compiler-ir-param-seq-empty))))))

(define (opt-ec-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "licm_element_class")
    (opt-ec-params)
    (ast.AstType.I64)
    64
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

;; The PRE-BCE run, with no global table and no clean-callee map: the plain
;; memory gate, so the only thing that can move the candidate is the clause
;; under test.
(define (opt-ec-licm-early [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [func : ir.CompilerIrFunction
      (opt-ec-test-function (ir.compiler-ir-global-shared-view blocks))]
    (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt.opt-cfg-context-build blocks)
      false
      (opt_i64_i64_map.with-capacity 1)
      (opt_i64_i64_map.with-capacity 1)
      (opt.opt-global-cell-summary-empty)
      false
      func)
      [(opt.OptFunctionCtxResult.Result next _) (opt.opt-function-blocks next)])))

;; The loop this packet's clause is tested on. The two address GEPs sit in the
;; PREHEADER already, so nothing but the memory verdict on the LOADS is under
;; test -- an address of an unrooted class has its own gate (the P6/R7
;; interlock and the pre-BCE operand rule) and would otherwise decide the
;; outcome before the clause is reached.
;;
;;   entry:  %3  = mov 0
;;           %6  = gep %2, <head-offset> : u8   a fixed word of `*out`
;;           %11 = gep %2, 0 : u8               its `slots` word
;;   loop:   %4  = phi [%3, entry] [%5, body]
;;           %7  = load %6 : <load-ty>          THE CANDIDATE
;;           %12 = load %11 : (__tl_dyn-array i64)
;;           %8  = gep %12, 0 : i64             the descriptor's data slot
;;           %9  = load %8 : u64                the element buffer
;;           %10 = gep %9, %4 : i64             one element of it
;;           <write>
;;           %5  = add %4, 1 ; branch %0, body, exit
;;
;; `%6` and `%11` are fixed words of the object a `(&mut ...)` PARAMETER
;; designates: not a descriptor handle, not an `Alloc` of this function, not a
;; global cell, so every existing disjointness proof declines them.
(define (opt-ec-loop-blocks-general
  [head-offset : i64]
  [load-ty : ast.AstType]
  ;; One instruction in front of the write: the indirect call for that
  ;; negative, and an inert `mov` everywhere else so the two shapes differ by
  ;; nothing but that instruction.
  [pre : ir.CompilerIrInstr]
  [write : ir.CompilerIrInstr]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (ir.CompilerIrValue.I64 0) (ast.AstType.I64))
        (ir.CompilerIrInstr.Gep
          6
          (ir.CompilerIrValue.Var 2)
          (ir.CompilerIrValue.I64 head-offset)
          (ast.AstType.U8))
        (irt.instr "%11 = gep %2, 0 : u8")
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instrs-with-tail
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (ir.CompilerIrInstr.Load 7 (ir.CompilerIrValue.Var 6) load-ty)
            (irt.instr "%12 = load %11 : (__tl_dyn-array i64)")
            (irt.instr "%8 = gep %12, 0 : i64")
            (irt.instr "%9 = load %8 : u64")
            (irt.instr "%10 = gep %9, %4 : i64")
            pre
            write)
          (irt.instr "%4 = phi [%3, entry], [%5, body] : i64")))
      (irt.blocks
        "body:
           jump loop
         exit:
           return %5"))))

(define (opt-ec-loop-blocks
  [head-offset : i64]
  [load-ty : ast.AstType]
  [write : ir.CompilerIrInstr]) : ir.CompilerIrBlockList
  (opt-ec-loop-blocks-general
    head-offset
    load-ty
    (ir.CompilerIrInstr.Mov 14 (ir.CompilerIrValue.I64 0) (ast.AstType.I64))
    write))

;; The same loop with an INDIRECT call in front of the write: it may land on
;; any function of the program, so it writes words no static type bounds.
(define (opt-ec-loop-blocks-with-call
  [load-ty : ast.AstType]
  [write : ir.CompilerIrInstr]) : ir.CompilerIrBlockList
  (opt-ec-loop-blocks-general
    0
    load-ty
    (irt.instr "%13 = call* %20() : i64")
    write))

;; One scalar element store of class i64: the write the whole rule is about.
(define (opt-ec-element-store-i64) : ir.CompilerIrInstr
  (irt.instr "store_ptr %10, 100 : i64"))

;; The same element store writing a DESCRIPTOR HANDLE -- the candidate's own
;; class -- which the rule must refuse.
(define (opt-ec-element-store-handle) : ir.CompilerIrInstr
  (irt.instr "store_ptr %10, %12 : (__tl_dyn-array i64)"))

;; A store through the `raw` parameter: a pointer whose provenance the walk
;; cannot place, so it is a header-or-unknown store and no class bounds it.
(define (opt-ec-raw-store) : ir.CompilerIrInstr
  (irt.instr "store_ptr %20, 100 : i64"))

;; A write to a GLOBAL CELL. The cell may hold the very object the parameter
;; borrows, and `(set! g v)` copies a whole aggregate over it, so it names no
;; class at all.
(define (opt-ec-cell-store [global : i64]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Store
    global
    (ir.CompilerIrValue.Var 12)
    (ast.AstType.DynArray 0)))

;; Is the load that defines `var` in the block labelled `label`? The load
;; COUNTS the older fixtures use cannot separate this packet's verdict from the
;; descriptor-header one -- the chain carries loads of three different classes
;; and each moves for its own reason -- so the assertions below name the one
;; load whose verdict is under test.
(define (opt-ec-seq-loads-var?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.Load dst _ _) (= dst var)]
        [_ false])
      (opt-ec-seq-loads-var? instrs (+ index 1) var))))

(define (opt-ec-block-loads-var?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [var : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block block-label instrs)
          (or
            (and (= block-label label) (opt-ec-seq-loads-var? instrs 0 var))
            (opt-ec-block-loads-var? (deref rest) label var))])]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-ec-block-loads-var? (ir.compiler-ir-block-seq-to-list seq) label var)]))

(define (opt-ec-hoisted? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-ec-block-loads-var? blocks (ir.compiler-ir-label "entry") 7))

(define (opt-ec-kept? [blocks : ir.CompilerIrBlockList]) : bool
  (opt-ec-block-loads-var? blocks (ir.compiler-ir-label "loop") 7))

(define (compiler-optimize-licm-element-class-self-test) : i64
  (let
    ;; positive: a descriptor-handle word off `out`, against an i64 element
    ;; store. Different classes, so the load and the two links behind it leave.
    [moved : ir.CompilerIrBlockList
      (opt-ec-licm-early
        (opt-ec-loop-blocks
          0
          (ast.AstType.DynArray 0)
          (opt-ec-element-store-i64)))]
    ;; negative 1 -- the packet's rule, refused: a SAME-CLASS i64 word off the
    ;; same parameter (`out.len`) against the same i64 element store.
    [same-class : ir.CompilerIrBlockList
      (opt-ec-licm-early
        (opt-ec-loop-blocks 8 (ast.AstType.I64) (opt-ec-element-store-i64)))]
    ;; negative 2: the store writes the candidate's OWN class.
    [same-word : ir.CompilerIrBlockList
      (opt-ec-licm-early
        (opt-ec-loop-blocks
          0
          (ast.AstType.DynArray 0)
          (opt-ec-element-store-handle)))]
    ;; negative 3: a store through a pointer of unknown provenance.
    [raw : ir.CompilerIrBlockList
      (opt-ec-licm-early
        (opt-ec-loop-blocks 0 (ast.AstType.DynArray 0) (opt-ec-raw-store)))]
    ;; negative 4: an indirect call in the loop.
    [indirect : ir.CompilerIrBlockList
      (opt-ec-licm-early
        (opt-ec-loop-blocks-with-call
          (ast.AstType.DynArray 0)
          (opt-ec-element-store-i64)))]
    ;; negative 5: a write to a global cell that may hold this very object.
    [cell : ir.CompilerIrBlockList
      (opt-ec-licm-early
        (opt-ec-loop-blocks
          0
          (ast.AstType.DynArray 0)
          (opt-ec-cell-store (opt-test-symbol "ec_cell"))))]
    (cond
      ;; the candidate moved to the preheader...
      [(not (opt-ec-hoisted? (ir.compiler-ir-global-shared-view moved))) 1]
      ;; ...and is gone from the body
      [(opt-ec-kept? (ir.compiler-ir-global-shared-view moved)) 2]
      ;; and the data slot and the buffer behind it came out with it: three
      ;; loads in the preheader, none left in the loop
      [(not
          (=
            (opt-fz-preheader-loads (ir.compiler-ir-global-shared-view moved))
            3))
        3]
      [(not (= (opt-fz-body-loads moved) 0)) 4]
      ;; every negative keeps the candidate in the loop
      [(opt-ec-hoisted? (ir.compiler-ir-global-shared-view same-class)) 5]
      [(not (opt-ec-kept? same-class)) 6]
      [(opt-ec-hoisted? (ir.compiler-ir-global-shared-view same-word)) 7]
      [(not (opt-ec-kept? same-word)) 8]
      [(opt-ec-hoisted? (ir.compiler-ir-global-shared-view raw)) 9]
      [(not (opt-ec-kept? (ir.compiler-ir-global-shared-view raw))) 10]
      [(opt-ec-hoisted? (ir.compiler-ir-global-shared-view indirect)) 11]
      [(opt-ec-hoisted? (ir.compiler-ir-global-shared-view cell)) 12]
      ;; and a refused candidate takes the whole chain down with it: nothing
      ;; behind it reaches the preheader either
      [(not (= (opt-fz-preheader-loads raw) 0)) 13]
      [(not (= (opt-fz-preheader-loads indirect) 0)) 14]
      [(not (= (opt-fz-preheader-loads cell) 0)) 15]
      [else 42])))

(test
  licm-element-class-typed-word
  (test.assert-i64-eq
    (compiler-optimize-licm-element-class-self-test)
    42
    "a load of a descriptor-handle word off a `(&mut ...)` parameter leaves a loop whose only write is an i64 element store, and the descriptor's data slot and buffer leave with it; a same-class i64 word off that same parameter, an element store of the candidate's own class, a store through a pointer of unknown provenance, an indirect call in the loop, and a whole-cell global write each keep the chain inside"))

(test
  licm-root-disjointness
  (begin
    (test.assert-true
      (opt.opt-licm-root-disjoint-store?
        (opt.OptLicmRoot.Fresh 1)
        (opt.OptLicmRoot.Fresh 2))
      "different fresh allocations are disjoint")
    (test.assert-true
      (opt.opt-licm-root-disjoint-store?
        (opt.OptLicmRoot.Exclusive 1)
        (opt.OptLicmRoot.Fresh 2))
      "a fresh allocation is disjoint from caller storage")
    (test.assert-false
      (opt.opt-licm-root-disjoint-store?
        (opt.OptLicmRoot.Exclusive 1)
        (opt.OptLicmRoot.Exclusive 2))
      "different mutable reference parameters are not disjoint evidence")
    (test.assert-false
      (opt.opt-licm-root-disjoint-store?
        (opt.OptLicmRoot.Exclusive 1)
        (opt.OptLicmRoot.Shared 2))
      "shared and mutable reference parameters are not disjoint evidence")))

;; --- affine chain folding self-test -------------------------------------------
;; Emulates the x4 unroller's output: an LCG chain `((x*5+3)*5+3)*5+3` must
;; collapse so the last pair reads `x*125` and `+93`, and a counter chain
;; `((x+1)+1)-? ` must rebase every link onto x. Negative: a two-use mul stays.
(define (opt-affine-test-binop-shape?
  [block : ir.CompilerIrBlock]
  [index : i64]
  [want-dst : i64]
  [want-mul : bool]
  [want-src : i64]
  [want-const : i64]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
          (and
            (= dst want-dst)
            (match op
              [(ir.CompilerIrBinOp.Mul) want-mul]
              [(ir.CompilerIrBinOp.Add) (not want-mul)]
              [_ false])
            (match lhs
              [(ir.CompilerIrValue.Var v) (= v want-src)]
              [_ false])
            (match rhs
              [(ir.CompilerIrValue.I64 k) (= k want-const)]
              [_ false]))]
        [_ false])]))

(define (opt-affine-test-first-block [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlock
  (match blocks
    [(ir.CompilerIrBlockList.Cons block _) block]
    [_
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "missing")
        (ir.compiler-ir-instr-seq-empty))]))

(define (opt-affine-lcg-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mul %0, 5 : i64
       %3 = add %2, 3 : i64
       %4 = mul %3, 5 : i64
       %5 = add %4, 3 : i64
       %6 = mul %5, 5 : i64
       %7 = add %6, 3 : i64
       return %7"))

(define (opt-affine-counter-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = add %0, 1 : i64
       %2 = add %1, 1 : i64
       %3 = sub %2, 5 : i64
       return %3"))

;; Var 4 (the mul) feeds TWO adds, so the value-changing pair rewrite must not
;; fire: the mul and both adds stay exactly as written.
(define (opt-affine-two-use-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = add %0, 3 : i64
       %4 = mul %2, 5 : i64
       %5 = add %4, 7 : i64
       %6 = add %4, 9 : i64
       %7 = add %5, %6 : i64
       return %7"))

;; Full-pipeline integration fixture: `while (i < n) { acc = acc*5 + 3; i++ }`
;; in SSA form. After opt-test-optimize-function the x16 unroller versions the
;; loop and the affine pass must collapse the sixteen chained pairs so the
;; unrolled body multiplies by 5^16 = 152587890625 exactly once.
(define (opt-affine-lcg-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump body
     body:
       %2 = phi [0, entry], [%5, body] : i64
       %3 = phi [1, entry], [%7, body] : i64
       %6 = mul %3, 5 : i64
       %7 = add %6, 3 : i64
       %5 = add %2, 1 : i64
       %8 = lt %5, %0 : bool
       branch %8, body, exit
     exit:
       return %7"))

(define (opt-affine-test-seq-count-mul
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-affine-test-seq-count-mul
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(ir.CompilerIrInstr.BinOp _ op _ _ _)
            (match op
              [(ir.CompilerIrBinOp.Mul) 1]
              [_ 0])]
          [_ 0])))))

(define (opt-affine-test-seq-has-mul-by?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [want : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp _ op _ rhs _)
        (match op
          [(ir.CompilerIrBinOp.Mul)
            (match rhs
              [(ir.CompilerIrValue.I64 k)
                (if (= k want)
                  true
                  (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want))]
              [_ (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want)])]
          [_ (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want)])]
      [_ (opt-affine-test-seq-has-mul-by? instrs (+ index 1) want)])))

;; The same recurrence as lowering emits it: a top-tested pre-SSA while loop
;; with Mov writebacks, entering the pipeline before SSA/rotation/unroll.
(define (opt-affine-lcg-while-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 1 : i64
       %2 = mov 0 : i64
       jump header
     header:
       %3 = lt %2, %0 : bool
       branch %3, body, exit
     body:
       %4 = mul %1, 5 : i64
       %5 = add %4, 3 : i64
       %1 = mov %5 : i64
       %6 = add %2, 1 : i64
       %2 = mov %6 : i64
       jump header
     exit:
       %7 = bit_and %1, 255 : i64
       return %7"))

(define (opt-affine-pipeline-check
  [optimized : ir.CompilerIrFunction]
  [fail-missing : i64]
  [fail-mul : i64]
  [fail-count : i64]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks optimized)]
    (match (opt.opt-cfg-find-block
      blocks
      (ir.compiler-ir-label "body__unroll_body"))
      [(opt.OptMaybeBlock.No) fail-missing]
      [(opt.OptMaybeBlock.Some block)
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (cond
              ;; the sixteen chained *5 collapse into one *152587890625 ...
              [(not
                  (opt-affine-test-seq-has-mul-by?
                    (opt.compiler-opt-global-shared-view instrs)
                    0
                    152587890625))
                fail-mul]
              ;; ... and DCE drops the orphaned intermediate pairs.
              [(> (opt-affine-test-seq-count-mul instrs 0 0) 1) fail-count]
              [else 42])])])))

(define (compiler-optimize-affine-pipeline-self-test) : i64
  (let
    [ssa-result : i64
      (opt-affine-pipeline-check
        (opt-test-optimize-function
          (ast.ast-node-pool-reader-context-current)
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.CompilerIrFunction.Function
            (opt-test-symbol "affine_loop_fixture")
            (opt-unroll-test-params)
            (ast.AstType.I64)
            9
            (opt-affine-lcg-loop-blocks)
            ir.CompilerIrFunctionAbi.Ordinary))
        1
        2
        3)]
    [while-result : i64
      (opt-affine-pipeline-check
        (opt-test-optimize-function
          (ast.ast-node-pool-reader-context-current)
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.CompilerIrFunction.Function
            (opt-test-symbol "affine_while_fixture")
            (opt-unroll-test-params)
            (ast.AstType.I64)
            8
            (opt-affine-lcg-while-blocks)
            ir.CompilerIrFunctionAbi.Ordinary))
        4
        5
        6)]
    (if (= ssa-result 42)
      while-result
      ssa-result)))

;; A deliberately simple reference model scans every possible local key. It
;; shares no dense indices, compaction, or storage with the production table.
(define (opt-affine-test-record-eq?
  [left : opt.OptAffineRec]
  [right : opt.OptAffineRec]) : bool
  (match left
    [(opt.OptAffineRec.No)
      (match right
        [(opt.OptAffineRec.No) true]
        [_ false])]
    [(opt.OptAffineRec.AddC base value)
      (match right
        [(opt.OptAffineRec.AddC other-base other-value)
          (and (= base other-base) (= value other-value))]
        [_ false])]
    [(opt.OptAffineRec.MulC base value index)
      (match right
        [(opt.OptAffineRec.MulC other-base other-value other-index)
          (and (= base other-base) (= value other-value) (= index other-index))]
        [_ false])]))

(define (opt-affine-test-record-base? [rec : opt.OptAffineRec] [var : i64]) : bool
  (match rec
    [(opt.OptAffineRec.No) false]
    [(opt.OptAffineRec.AddC base _) (= base var)]
    [(opt.OptAffineRec.MulC base _ _) (= base var)]))

(define (compiler-optimize-affine-env-reference-self-test) : i64
  (let
    [frame : i64 33]
    [env : opt.OptAffineEnv
      (opt.opt-affine-env-new frame (__tl_make-array bool frame))]
    [expected : (__tl_dyn-array opt.OptAffineRec)
      (__tl_make-array opt.OptAffineRec frame)]
    [binds : i64 0]
    [expected-binds : i64 0]
    [seed : i64 5731]
    [step : i64 0]
    [index : i64 0]
    (begin
      (while (< step 4096)
        (begin
          (set! seed (bit-and (+ (* seed 1103515245) 12345) 2147483647))
          (let
            [dst : i64 (% seed frame)]
            [base : i64 (% (shr seed 7) frame)]
            [rec : opt.OptAffineRec
              (cond
                [(= (bit-and seed 7) 0) (opt.OptAffineRec.No)]
                [(= (bit-and seed 1) 0)
                  (opt.OptAffineRec.AddC base (- seed 1073741824))]
                [else (opt.OptAffineRec.MulC base (- seed 1073741824) step)])]
            (begin
              (match (opt.opt-affine-env-bind-def
                (opt.compiler-opt-global-shared-view env)
                binds
                dst
                rec)
                [(opt.OptAffineStep.Result next count)
                  (begin
                    (set! env next)
                    (set! binds count))])
              (set! index 0)
              (while (< index frame)
                (begin
                  (when
                    (or
                      (= index dst)
                      (opt-affine-test-record-base?
                        (array-ref expected index)
                        dst))
                    (set! (array-ref expected index) (opt.OptAffineRec.No)))
                  (set! index (+ index 1))))
              (match rec
                [(opt.OptAffineRec.No) unit]
                [_
                  (when
                    (not (opt-affine-test-record-base? rec dst))
                    (if (>= expected-binds 512)
                      (begin
                        (set! index 0)
                        (while (< index frame)
                          (begin
                            (set!
                              (array-ref expected index)
                              (opt.OptAffineRec.No))
                            (set! index (+ index 1))))
                        (set! expected-binds 0))
                      (begin
                        (set! (array-ref expected dst) rec)
                        (set! expected-binds (+ expected-binds 1)))))])
              (when (!= binds expected-binds) (return 1))
              (set! index 0)
              (while (< index frame)
                (begin
                  (when
                    (not
                      (opt-affine-test-record-eq?
                        (opt.opt-affine-env-lookup
                          (opt.compiler-opt-global-shared-view env)
                          index)
                        (array-ref expected index)))
                    (return 2))
                  (set! index (+ index 1))))))
          ;; A new block must see no facts from its predecessor. The backing
          ;; arrays can be reused, but neither live records nor count survive.
          (when
            (= (% step 997) 996)
            (begin
              (set! env (opt.opt-affine-env-clear env))
              (set! binds 0)
              (set! expected-binds 0)
              (set! index 0)
              (while (< index frame)
                (begin
                  (set! (array-ref expected index) (opt.OptAffineRec.No))
                  (set! index (+ index 1))))))
          (set! step (+ step 1))))
      42)))

(define (compiler-optimize-affine-env-boundary-self-test) : i64
  (let
    [env : opt.OptAffineEnv
      (opt.opt-affine-env-new 1100 (__tl_make-array bool 1100))]
    [other : opt.OptAffineEnv
      (opt.opt-affine-env-new 4 (__tl_make-array bool 4))]
    [empty : opt.OptAffineEnv (init)]
    [binds : i64 0]
    [index : i64 1]
    (begin
      (when
        (not
          (opt-affine-test-record-eq?
            (opt.opt-affine-env-lookup (opt.opt-affine-env-clear empty) 0)
            (opt.OptAffineRec.No)))
        (return 9))
      (while (<= index 512)
        (begin
          (match (opt.opt-affine-env-bind-def
            (opt.compiler-opt-global-shared-view env)
            binds
            index
            (opt.OptAffineRec.AddC 0 index))
            [(opt.OptAffineStep.Result next count)
              (begin
                (set! env next)
                (set! binds count))])
          (set! index (+ index 1))))
      (when (!= binds 512) (return 1))
      (set! index 1)
      (while (<= index 512)
        (begin
          (when
            (not
              (opt-affine-test-record-eq?
                (opt.opt-affine-env-lookup
                  (opt.compiler-opt-global-shared-view env)
                  index)
                (opt.OptAffineRec.AddC 0 index)))
            (return 2))
          (set! index (+ index 1))))
      ;; Purging a live key and declining a self-reference do not refund the
      ;; cumulative bind budget. The next successful attempt clears everything
      ;; and is itself omitted, exactly as the former cons table did.
      (match (opt.opt-affine-env-bind-def
        (opt.compiler-opt-global-shared-view env)
        binds
        256
        (opt.OptAffineRec.No))
        [(opt.OptAffineStep.Result next count)
          (begin
            (set! env next)
            (set! binds count))])
      (match (opt.opt-affine-env-bind-def
        (opt.compiler-opt-global-shared-view env)
        binds
        900
        (opt.OptAffineRec.AddC 900 1))
        [(opt.OptAffineStep.Result next count)
          (begin
            (set! env next)
            (set! binds count))])
      (when (!= binds 512) (return 3))
      (match (opt.opt-affine-env-bind-def
        (opt.compiler-opt-global-shared-view env)
        binds
        513
        (opt.OptAffineRec.AddC 0 513))
        [(opt.OptAffineStep.Result next count)
          (begin
            (set! env next)
            (set! binds count))])
      (when (!= binds 0) (return 4))
      (set! index 0)
      (while (< index 1100)
        (begin
          (when
            (not
              (opt-affine-test-record-eq?
                (opt.opt-affine-env-lookup
                  (opt.compiler-opt-global-shared-view env)
                  index)
                (opt.OptAffineRec.No)))
            (return 5))
          (set! index (+ index 1))))
      (match (opt.opt-affine-env-bind-def
        (opt.compiler-opt-global-shared-view env)
        binds
        1099
        (opt.OptAffineRec.MulC 1098 -7 23))
        [(opt.OptAffineStep.Result next count)
          (begin
            (set! env next)
            (set! binds count))])
      (when
        (or
          (!= binds 1)
          (not
            (opt-affine-test-record-eq?
              (opt.opt-affine-env-lookup
                (opt.compiler-opt-global-shared-view env)
                1099)
              (opt.OptAffineRec.MulC 1098 -7 23))))
        (return 6))
      (when
        (or
          (not
            (opt-affine-test-record-eq?
              (opt.opt-affine-env-lookup
                (opt.compiler-opt-global-shared-view env)
                -1)
              (opt.OptAffineRec.No)))
          (not
            (opt-affine-test-record-eq?
              (opt.opt-affine-env-lookup
                (opt.compiler-opt-global-shared-view env)
                9223372036854775807)
              (opt.OptAffineRec.No))))
        (return 7))
      (match (opt.opt-affine-env-bind-def
        (opt.compiler-opt-global-shared-view other)
        0
        1
        (opt.OptAffineRec.AddC 0 99))
        [(opt.OptAffineStep.Result next _) (set! other next)])
      (set! env (opt.opt-affine-env-clear env))
      (if (and
        (opt-affine-test-record-eq?
          (opt.opt-affine-env-lookup env 1099)
          (opt.OptAffineRec.No))
        (opt-affine-test-record-eq?
          (opt.opt-affine-env-lookup other 1)
          (opt.OptAffineRec.AddC 0 99)))
        42
        8))))

(test
  affine-env-reference
  (test.assert-true
    (= (compiler-optimize-affine-env-reference-self-test) 42)
    "dense affine facts match full-domain reference invalidation and cap/reset traces"))

(test
  affine-env-growth-cap-isolation
  (test.assert-true
    (= (compiler-optimize-affine-env-boundary-self-test) 42)
    "growth, exact 512-bind policy, sparse occupancy, missing keys and independent function storage"))

;; Exercise the table through real instruction walks: wrapping constants,
;; pre-SSA base redefinition, and reuse across two candidate blocks. Run both
;; 64-bit signedness variants because records retain the same bit patterns.
(define (opt-affine-storage-integration-check [ty : ast.AstType]) : i64
  (let
    [blocks : ir.CompilerIrBlockList
      (opt.opt-affine-fold-blocks
        10
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "first")
            (opt-test-instrs
              (ir.CompilerIrInstr.BinOp
                1
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var 0)
                (ir.CompilerIrValue.I64 9223372036854775807)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.BinOp
                2
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var 1)
                (ir.CompilerIrValue.I64 1)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.Mov
                0
                (ir.CompilerIrValue.I64 17)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.BinOp
                3
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var 1)
                (ir.CompilerIrValue.I64 2)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.BinOp
                4
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var 3)
                (ir.CompilerIrValue.I64 3)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.BinOp
                7
                (ir.CompilerIrBinOp.Mul)
                (ir.CompilerIrValue.Var 0)
                (ir.CompilerIrValue.I64 -9223372036854775808)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.BinOp
                8
                (ir.CompilerIrBinOp.Mul)
                (ir.CompilerIrValue.Var 7)
                (ir.CompilerIrValue.I64 -1)
                (opt.compiler-opt-global-shared-view ty))
              (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "second"))))
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "second")
              (opt-test-instrs
                (ir.CompilerIrInstr.BinOp
                  5
                  (ir.CompilerIrBinOp.Add)
                  (ir.CompilerIrValue.Var 4)
                  (ir.CompilerIrValue.I64 1)
                  (opt.compiler-opt-global-shared-view ty))
                (ir.CompilerIrInstr.BinOp
                  6
                  (ir.CompilerIrBinOp.Add)
                  (ir.CompilerIrValue.Var 5)
                  (ir.CompilerIrValue.I64 1)
                  ty)
                (irt.instr "return %6")))
            (ir.CompilerIrBlockList.Nil))))]
    [first : ir.CompilerIrBlock
      (opt-affine-test-first-block (opt.compiler-opt-global-shared-view blocks))]
    (begin
      (when
        (not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view first)
            1
            2
            false
            0
            -9223372036854775808))
        (return 1))
      ;; Redefining base 0 must invalidate both earlier add records.
      (when
        (not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view first)
            3
            3
            false
            1
            2))
        (return 2))
      (when
        (not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view first)
            4
            4
            false
            1
            5))
        (return 3))
      (when
        (not
          (opt-affine-test-binop-shape? first 6 8 true 0 -9223372036854775808))
        (return 4))
      (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label "second"))
        [(opt.OptMaybeBlock.No) 5]
        [(opt.OptMaybeBlock.Some second)
          (if (and
            (opt-affine-test-binop-shape?
              (opt.compiler-opt-global-shared-view second)
              0
              5
              false
              4
              1)
            (opt-affine-test-binop-shape? second 1 6 false 4 2))
            42
            6)]))))

(define (compiler-optimize-affine-storage-integration-self-test) : i64
  (let
    [signed-result : i64
      (opt-affine-storage-integration-check (ast.AstType.I64))]
    (if (= signed-result 42)
      (opt-affine-storage-integration-check (ast.AstType.U64))
      signed-result)))

(test
  affine-storage-integration
  (test.assert-true
    (= (compiler-optimize-affine-storage-integration-self-test) 42)
    "signed/unsigned wrapping, base redefinition and candidate-block isolation"))

(define (compiler-optimize-affine-self-test) : i64
  (let
    [lcg : ir.CompilerIrBlockList
      (opt.opt-affine-fold-blocks 16 (opt-affine-lcg-test-blocks))]
    [lcg-block : ir.CompilerIrBlock (opt-affine-test-first-block lcg)]
    [counter : ir.CompilerIrBlockList
      (opt.opt-affine-fold-blocks 16 (opt-affine-counter-test-blocks))]
    [counter-block : ir.CompilerIrBlock (opt-affine-test-first-block counter)]
    [two-use : ir.CompilerIrBlockList
      (opt.opt-affine-fold-blocks 16 (opt-affine-two-use-test-blocks))]
    [two-use-block : ir.CompilerIrBlock (opt-affine-test-first-block two-use)]
    (cond
      ;; ((x*5+3)*5+3)*5+3 == x*125 + 93: the second pair reads x*25 + 18 ...
      [(not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view lcg-block)
            2
            4
            true
            0
            25))
        1]
      [(not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view lcg-block)
            3
            5
            false
            4
            18))
        2]
      ;; ... and the last pair reads x*125 + 93.
      [(not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view lcg-block)
            4
            6
            true
            0
            125))
        3]
      [(not (opt-affine-test-binop-shape? lcg-block 5 7 false 6 93)) 4]
      ;; (x+1)+1 rebases to x+2; the Sub then folds to x-3 (emitted as Add).
      [(not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view counter-block)
            1
            2
            false
            0
            2))
        5]
      [(not (opt-affine-test-binop-shape? counter-block 2 3 false 0 (- 0 3))) 6]
      ;; two-use mul: v4 = (x+3)*5 must stay untouched ...
      [(not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view two-use-block)
            1
            4
            true
            2
            5))
        7]
      ;; ... and both adds keep reading it.
      [(not
          (opt-affine-test-binop-shape?
            (opt.compiler-opt-global-shared-view two-use-block)
            2
            5
            false
            4
            7))
        8]
      [(not (opt-affine-test-binop-shape? two-use-block 3 6 false 4 9)) 9]
      [else 42])))

(define (opt-ssa-unreachable-blocks) : ir.CompilerIrBlockList
  (irt.blocks "entry:
       return 1
     dead:
       return 2"))

(define (opt-ssa-unreachable-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_unreachable")
    (ir.compiler-ir-param-seq-empty)
    (ast.AstType.I64)
    0
    (opt-ssa-unreachable-blocks)
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-ssa-bad-phi-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_bad_phi")
    (opt-ssa-cond-params)
    (ast.AstType.I64)
    16
    (irt.blocks
      "entry:
         branch %0, then, else
       then:
         %1 = mov 10 : i64
         jump join
       else:
         %2 = mov 20 : i64
         jump join
       join:
         %3 = phi [%1, then], [%2, ghost] : i64
         return %3")
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-ssa-duplicate-label-function) : ir.CompilerIrFunction
  (irt.func
    "function @ssa_duplicate_label() -> i64 vars 0 {
     entry:
       return 1
     entry:
       return 2
     }"))

(define (opt-ssa-unknown-successor-function) : ir.CompilerIrFunction
  (irt.func
    "function @ssa_unknown_successor() -> i64 vars 0 {
     entry:
       jump missing
     }"))

(define (opt-ssa-duplicate-def-function) : ir.CompilerIrFunction
  (irt.func
    "function @ssa_duplicate_def() -> i64 vars 2 {
     entry:
       %1 = mov 1 : i64
       %1 = mov 2 : i64
       return %1
     }"))

(define (opt-ssa-out-of-range-def-function [var : i64] [vars : i64]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_out_of_range_def")
    (ir.compiler-ir-param-seq-empty)
    (ast.AstType.I64)
    vars
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov
            var
            (ir.CompilerIrValue.I64 1)
            (ast.AstType.I64))
          (irt.instr "return 1")))
      (ir.CompilerIrBlockList.Nil))
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-ssa-use-before-def-function) : ir.CompilerIrFunction
  (irt.func
    "function @ssa_use_before_def() -> i64 vars 0 {
     entry:
       return %9
     }"))

(define (opt-ssa-runtime-global-operand-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_runtime_global_operand")
    (ir.compiler-ir-param-seq-empty)
    (ast.AstType.I64)
    0
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Return
            (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.RuntimeGlobal 2)))))
      (ir.CompilerIrBlockList.Nil))
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-ssa-dominance-fail-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_dominance_fail")
    (opt-ssa-cond-params)
    (ast.AstType.I64)
    16
    (irt.blocks
      "entry:
         branch %0, then, else
       then:
         %1 = mov 10 : i64
         jump join
       else:
         jump join
       join:
         return %1")
    ir.CompilerIrFunctionAbi.Ordinary))

;; --- BCE-3: preheader synthesis verdicts -------------------------------------
;;
;; The synthesis pass had no tracer, so a loop that reached the versioner with
;; no preheader could not be told apart from a loop this pass refused. These
;; fixtures pin the CLAUSE the tracer names for each of the three shapes the
;; census distinguishes, because the clause code is what a census reads -- an
;; outcome-only test would pass with every reason reported as `other`.
(define (opt-preheader-rotated-guard-blocks) : ir.CompilerIrBlockList
  ;; A rotated loop: its ONE outside predecessor is the zero-trip guard, whose
  ;; terminator is a Branch, so it is not a safe preheader and the pass has to
  ;; split that edge.
  (irt.blocks
    "entry:
       branch true, loop, exit
     loop:
       branch true, body, exit
     body:
       jump loop
     exit:
       return 0"))

(define (opt-preheader-safe-blocks) : ir.CompilerIrBlockList
  ;; The loop already owns a safe preheader: `entry`'s only successor is the
  ;; header, so the pass has nothing to do and must leave the CFG alone.
  (irt.blocks
    "entry:
       jump loop
     loop:
       branch true, body, exit
     body:
       jump loop
     exit:
       return 0"))

;; The outside predecessor set the two-entry fixtures present to the header
;; clause, built by hand so the clause can be asked directly.
(define (opt-preheader-two-entry-outside) : opt.OptLabelSet
  (opt.opt-label-add
    (opt.opt-label-add (opt.OptLabelSet.Nil) (ir.compiler-ir-label "pre-one"))
    (ir.compiler-ir-label "pre-two")))

(define (opt-preheader-instr-total [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (+
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (ir.compiler-ir-instr-seq-count instrs)])
        (opt-preheader-instr-total (deref rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (opt-preheader-instr-total (ir.compiler-ir-block-seq-to-list seq))]))

(define (opt-preheader-loop-has-preheader?
  [blocks : ir.CompilerIrBlockList]
  [header : String]
  [latch : String]) : bool
  (match (opt.opt-natural-loop-find
    (opt.opt-cfg-natural-loops blocks)
    (ir.compiler-ir-label header)
    (ir.compiler-ir-label latch))
    [(opt.OptMaybeNaturalLoop.No) false]
    [(opt.OptMaybeNaturalLoop.Some loop)
      (match (opt.opt-natural-loop-preheader loop)
        [(opt.OptLoopPreheader.No) false]
        [(opt.OptLoopPreheader.Some _) true])]))

(define (compiler-optimize-preheader-synthesis-self-test) : i64
  (let
    ;; (c) The rotated guard: one outside predecessor, terminator a Branch.
    [guard-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks (opt-preheader-rotated-guard-blocks))]
    ;; (b) Two outside predecessors whose header phi values DIFFER.
    [conflict-input : ir.CompilerIrBlockList
      (irt.blocks
        "entry:
           branch true, pre-one, pre-two
         pre-one:
           jump loop
         pre-two:
           jump loop
         loop:
           %0 = phi [1, pre-one], [2, pre-two] : i64
           branch true, body, exit
         body:
           jump loop
         exit:
           return 0")]
    [conflict-reason : i64
      (opt.opt-loop-preheaders-header-reason
        (opt.compiler-opt-global-shared-view conflict-input)
        (ir.compiler-ir-label "loop")
        (opt-preheader-two-entry-outside))]
    [conflict-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks conflict-input)]
    ;; The same shape with the two values EQUAL: the outside edges collapse and
    ;; the pass takes it, which is what makes the clause above about the values
    ;; and not about the predecessor count.
    [agree-input : ir.CompilerIrBlockList
      (irt.blocks
        "entry:
           branch true, pre-one, pre-two
         pre-one:
           jump loop
         pre-two:
           jump loop
         loop:
           %0 = phi [1, pre-one], [1, pre-two] : i64
           branch true, body, exit
         body:
           jump loop
         exit:
           return 0")]
    [agree-reason : i64
      (opt.opt-loop-preheaders-header-reason
        (opt.compiler-opt-global-shared-view agree-input)
        (ir.compiler-ir-label "loop")
        (opt-preheader-two-entry-outside))]
    [agree-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks agree-input)]
    ;; A loop that already owns a safe preheader must come back untouched.
    [safe-input : ir.CompilerIrBlockList (opt-preheader-safe-blocks)]
    [safe-block-count : i64
      (ir.compiler-ir-block-list-count
        (opt.compiler-opt-global-shared-view safe-input))]
    [safe-instr-count : i64
      (opt-preheader-instr-total
        (opt.compiler-opt-global-shared-view safe-input))]
    [safe-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks safe-input)]
    (cond
      ;; The rotated guard's edge is split, and the new block is the loop's
      ;; preheader.
      [(not
          (opt.opt-cfg-block-exists?
            (opt.compiler-opt-global-shared-view guard-blocks)
            (ir.compiler-ir-label "loop__preheader")))
        1]
      [(not (opt-preheader-loop-has-preheader? guard-blocks "loop" "body")) 2]
      ;; The disagreeing header phi is refused, and by THAT clause.
      [(not (= conflict-reason (opt.opt-preheader-reason-header-phi))) 3]
      [(opt.opt-cfg-block-exists?
          (opt.compiler-opt-global-shared-view conflict-blocks)
          (ir.compiler-ir-label "loop__preheader"))
        4]
      [(opt-preheader-loop-has-preheader? conflict-blocks "loop" "body") 5]
      ;; The agreeing header phi is admitted, and by the `ok` clause.
      [(not (= agree-reason (opt.opt-preheader-reason-ok))) 6]
      [(not
          (opt.opt-cfg-block-exists?
            (opt.compiler-opt-global-shared-view agree-blocks)
            (ir.compiler-ir-label "loop__preheader")))
        7]
      [(not (opt-preheader-loop-has-preheader? agree-blocks "loop" "body")) 8]
      ;; The loop that already owns one is left alone: no block added, no
      ;; instruction added, and no synthesized label anywhere.
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (opt.compiler-opt-global-shared-view safe-blocks))
            safe-block-count))
        9]
      [(not
          (=
            (opt-preheader-instr-total
              (opt.compiler-opt-global-shared-view safe-blocks))
            safe-instr-count))
        10]
      [(opt.opt-cfg-block-exists?
          safe-blocks
          (ir.compiler-ir-label "loop__preheader"))
        11]
      [else 42])))

;; --- BCE-3 follow-up: the versioner reports a finished loop as finished ------
;;
;; Versioning a loop removes its preheader (the `__bce_guard` chain the rewrite
;; puts in front of the header is a branch), so every later phase and round
;; re-examines a loop the pass has already handled. The shape scan used to ask
;; about the preheader FIRST, so those re-examinations were reported as
;; `shape:no-preheader` and the census read as though the versioner was starved
;; of preheaders. These fixtures are the two footprints the scan now recognizes
;; before it asks about shape, plus the control that keeps `no-preheader`
;; meaning what it says.
(define (opt-bce-versioned-shape-blocks
  [guard : String]
  [header : String]
  [body : String]) : ir.CompilerIrBlockList
  ;; `guard` is entered from `entry` and branches into the loop, so the loop's
  ;; single outside predecessor has two successors and the loop has NO safe
  ;; preheader -- exactly the CFG a versioned loop is left in. The labels are
  ;; interned once because a String argument moves on first use.
  (let
    [guard-label : i64 (ir.compiler-ir-label guard)]
    [header-label : i64 (ir.compiler-ir-label header)]
    [body-label : i64 (ir.compiler-ir-label body)]
    [exit-label : i64 (ir.compiler-ir-label "exit")]
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs (ir.CompilerIrInstr.Jump guard-label)))
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          guard-label
          (opt-test-instrs
            (ir.CompilerIrInstr.Branch
              (ir.CompilerIrValue.Bool true)
              header-label
              exit-label)))
        (ir.compiler-ir-block-cons
          (ir.CompilerIrBlock.Block
            header-label
            (opt-test-instrs
              (ir.CompilerIrInstr.Branch
                (ir.CompilerIrValue.Bool true)
                body-label
                exit-label)))
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              body-label
              (opt-test-instrs (ir.CompilerIrInstr.Jump header-label)))
            (irt.blocks "exit:
                 return 0")))))))

;; Offer one loop to the multi-block shape scan and hand back the clause it
;; recorded, which is the exact value the `bce-version|` line prints.
(define (opt-bce-shape-clause-for
  [blocks : ir.CompilerIrBlockList]
  [header : String]
  [latch : String]) : i64
  (let
    [loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt.compiler-opt-global-shared-view blocks))]
    (match (opt.opt-natural-loop-find
      (opt.compiler-opt-global-shared-view loops)
      (ir.compiler-ir-label header)
      (ir.compiler-ir-label latch))
      [(opt.OptMaybeNaturalLoop.No) (- 0 1)]
      [(opt.OptMaybeNaturalLoop.Some loop)
        (let
          [_shape : opt.OptBceMbMaybeShape
            (opt.opt-bce-mb-loop-shape
              blocks
              loops
              (ir.compiler-ir-label "entry")
              false
              false
              loop)]
          (opt.opt-bce-trace-reason-code))])))

(define (compiler-optimize-bce-shape-clause-order-self-test) : i64
  (let
    ;; The pass's own fast clone: the header label carries `__bce_fast`.
    [clone-clause : i64
      (opt-bce-shape-clause-for
        (opt-bce-versioned-shape-blocks
          "loop__bce_guard"
          "loop__bce_fast"
          "body__bce_fast")
        "loop__bce_fast"
        "body__bce_fast")]
    ;; A loop this pass versioned: its `<header>__bce_guard` block exists.
    [guarded-clause : i64
      (opt-bce-shape-clause-for
        (opt-bce-versioned-shape-blocks "loop__bce_guard" "loop" "body")
        "loop"
        "body")]
    ;; The control: the same preheaderless CFG with neither footprint still
    ;; reports `no-preheader`, so the reorder did not blanket-suppress it.
    [plain-clause : i64
      (opt-bce-shape-clause-for
        (opt-bce-versioned-shape-blocks "guard" "loop" "body")
        "loop"
        "body")]
    (cond
      [(not (= clone-clause (opt.opt-bce-reason-already-versioned))) 1]
      [(not (= guarded-clause (opt.opt-bce-reason-already-versioned))) 2]
      [(not (= plain-clause (opt.opt-bce-reason-no-preheader))) 3]
      [else 42])))

;; --- BCE-4: the masked index against a capacity ------------------------------
;;
;; `bit-and x m` lands in [0, m], so a check `idx < len` is dead whenever the
;; facts in scope decide `0 <= m < len`. `m = len - 1` states that syntactically
;; and was the only form the rule read; a mask built from a CAPACITY -- `cap - 1`
;; with nothing locally tying `cap` to the array's length word -- states it only
;; through the dominating comparisons, which is what these fixtures pin. The
;; negative is the same CFG with the `m < len` branch removed: masking alone
;; proves nothing about an array the mask is not tied to.
(define (opt-bce-mask-cap-params) : ir.CompilerIrParamSeq
  (irt.params "mask=%0:i64, len=%1:i64, x=%2:i64"))

(define (opt-bce-mask-cap-blocks [below-len? : bool]) : ir.CompilerIrBlockList
  ;; entry: decide `mask < len` (or, in the negative, a comparison that says
  ;; nothing about `len`); nonneg: decide `mask >= 0`; body: the masked access.
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp
          3
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.Var 0)
          (if below-len?
            (ir.CompilerIrValue.Var 1)
            (ir.CompilerIrValue.I64 4096))
          (ast.AstType.I64))
        (irt.instr "branch %3, nonneg, bail")))
    (irt.blocks
      "nonneg:
         %4 = lt %0, 0 : i64
         branch %4, bail, body
       body:
         %5 = bit_and %2, %0 : i64
         bounds_check %5, %1 message \"b_ok\"
         return %5
       bail:
         return 0")))

(define (opt-bce-mask-cap-checks [below-len? : bool]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-bce-mask-cap-blocks below-len?)]
    [after : ir.CompilerIrBlockList
      (opt.opt-bounds-dom-blocks-with-context
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
        (opt-bce-mask-cap-params)
        8
        blocks)]
    (opt.opt-count-bounds-blocks after)))

(define (compiler-optimize-bce-masked-capacity-self-test) : i64
  (cond
    ;; the fixture really carries one check
    [(not (= (opt.opt-count-bounds-blocks (opt-bce-mask-cap-blocks true)) 1)) 1]
    ;; `mask < len` and `mask >= 0` both dominate the access: discharged
    [(not (= (opt-bce-mask-cap-checks true) 0)) 2]
    ;; only `mask < 4096` and `mask >= 0`: the mask is not tied to THIS length,
    ;; so the check stays
    [(not (= (opt-bce-mask-cap-checks false) 1)) 3]
    [else 42]))

;; --- BCE-4: the guard's price on the versioner's trace ------------------------
;;
;; A versioning is priced by the conjuncts its guard states -- each a compare
;; and a branch paid once per loop ENTRY -- and by whether that entry is inside
;; another loop, which is what turns "once per call" into "once per enclosing
;; iteration". Both are reported on the `bce-version|...|version|ok` line, and
;; this pins that they are recorded rather than left at their "no guard was
;; built" defaults.
(define (compiler-optimize-bce-guard-price-self-test) : i64
  (let
    [reason : i64 (opt-vt-reason 0)]
    [conjuncts : i64 (opt.opt-bce-trace-guard-count)]
    [nested? : bool (opt.opt-bce-trace-nested-entry-flag)]
    (cond
      [(not (= reason (opt.opt-bce-reason-ok))) 1]
      ;; a guard was built and priced
      [(< conjuncts 1) 2]
      ;; this fixture's loop is entered from the function entry, not from
      ;; inside another loop
      [nested? 3]
      [else 42])))

(define (compiler-optimize-natural-loop-self-test) : i64
  (let
    [single-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build (opt-ssa-loop-blocks))]
    [single-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-ssa-loop-blocks))]
    [single : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        (opt.compiler-opt-global-shared-view single-loops)
        (ir.compiler-ir-label "loop")
        (ir.compiler-ir-label "body"))]
    [nested-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build (opt-natural-loop-nested-blocks))]
    [nested-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-natural-loop-nested-blocks))]
    [inner : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        (opt.compiler-opt-global-shared-view nested-loops)
        (ir.compiler-ir-label "inner")
        (ir.compiler-ir-label "inner-body"))]
    [outer : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        (opt.compiler-opt-global-shared-view nested-loops)
        (ir.compiler-ir-label "outer")
        (ir.compiler-ir-label "outer-latch"))]
    [diamond-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-ssa-diamond-blocks))]
    [irreducible-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-natural-loop-irreducible-blocks))]
    [no-preheader-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-natural-loop-no-preheader-blocks))]
    [no-preheader : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        (opt.compiler-opt-global-shared-view no-preheader-loops)
        (ir.compiler-ir-label "loop")
        (ir.compiler-ir-label "body"))]
    [multi-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build (opt-natural-loop-multi-backedge-blocks))]
    [multi-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-natural-loop-multi-backedge-blocks))]
    [multi-left : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        (opt.compiler-opt-global-shared-view multi-loops)
        (ir.compiler-ir-label "loop")
        (ir.compiler-ir-label "left"))]
    [multi-right : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        (opt.compiler-opt-global-shared-view multi-loops)
        (ir.compiler-ir-label "loop")
        (ir.compiler-ir-label "right"))]
    [preheadered-single-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks (opt-ssa-loop-blocks))]
    [preheadered-nested-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks (opt-natural-loop-nested-blocks))]
    [preheadered-multi-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks (opt-natural-loop-multi-backedge-blocks))]
    [synth-blocks : ir.CompilerIrBlockList
      (opt.opt-loop-preheaders-blocks (opt-natural-loop-no-preheader-blocks))]
    [synth-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build
        (opt.compiler-opt-global-shared-view synth-blocks))]
    [synth-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops
        (opt.compiler-opt-global-shared-view synth-blocks))]
    [synth-loop : opt.OptMaybeNaturalLoop
      (opt.opt-natural-loop-find
        synth-loops
        (ir.compiler-ir-label "loop")
