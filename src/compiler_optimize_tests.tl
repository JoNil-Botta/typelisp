    (compiler_optimize.opt-aggregate-candidate-list-count
      (compiler_optimize.opt-aggregate-allocation-candidates
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.CompilerIrProgram.Program
          (compiler_ir_types.compiler-ir-global-seq-empty)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (compiler_ir_types.CompilerIrFunction.Function
              (opt-test-symbol "main")
              (compiler_ir_types.compiler-ir-param-seq-empty)
              (compiler_ast_types.AstType.I64)
              4
              (opt-aggregate-phi-flowed-blocks))
            (compiler_ir_types.compiler-ir-function-seq-empty))
          (compiler_ir_types.compiler-ir-extern-seq-empty))))
    0))

(define (opt-aggregate-positive-classified?) : bool
  (let
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-positive-instrs)]
    [instr-count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
    [candidates : opt_aggregate_candidate_vec.Vec
      (compiler_optimize.opt-aggregate-allocation-candidates
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-spans-program instrs))]
    (if (=
      (compiler_optimize.opt-aggregate-candidate-list-count
        (compiler_optimize.compiler-opt-global-shared-view candidates))
      1)
      (match (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) 0)
        [(compiler_optimize.OptAggregateAllocCandidate.Candidate
            base
            ty
            size
            ptrs
            accesses)
          (and
            (= base 1)
            (= size 16)
            (compiler_optimize.opt-type-eq
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              ty
              (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
            (=
              (compiler_optimize.opt-aggregate-pointer-list-count
                (compiler_optimize.compiler-opt-global-shared-view ptrs))
              3)
            (= (opt_aggregate_access_vec.len (& accesses)) 3)
            (=
              (compiler_optimize.opt-aggregate-access-list-store-count
                (compiler_optimize.compiler-opt-global-shared-view accesses))
              2)
            (=
              (compiler_optimize.opt-aggregate-access-list-load-count
                (compiler_optimize.compiler-opt-global-shared-view accesses))
              1)
            (< (opt_aggregate_pointer_vec.capacity (& ptrs)) instr-count)
            (< (opt_aggregate_access_vec.capacity (& accesses)) instr-count))])
      false)))

;; Grow the append-ordered classifier scratch vector past its initial capacity.
;; The optimizer relies on the exact load/store order when it later promotes an
;; aggregate, so test both the interleaving and the metadata preserved by each
;; access entry.
(define (opt-aggregate-access-vector-growth-ok?) : bool
  (let
    [accesses : opt_aggregate_access_vec.Vec
      (opt_aggregate_access_vec.with-capacity 1)]
    (begin
      (opt_aggregate_access_vec.push-ref!
        (&mut accesses)
        (compiler_optimize.OptAggregateAccess.Store
          0
          (compiler_ast_types.AstType.I64)))
      (opt_aggregate_access_vec.push-ref!
        (&mut accesses)
        (compiler_optimize.OptAggregateAccess.Load
          11
          0
          (compiler_ast_types.AstType.I64)))
      (opt_aggregate_access_vec.push-ref!
        (&mut accesses)
        (compiler_optimize.OptAggregateAccess.Store
          8
          (compiler_ast_types.AstType.Bool)))
      (opt_aggregate_access_vec.push-ref!
        (&mut accesses)
        (compiler_optimize.OptAggregateAccess.Load
          12
          8
          (compiler_ast_types.AstType.Bool)))
      (opt_aggregate_access_vec.push-ref!
        (&mut accesses)
        (compiler_optimize.OptAggregateAccess.Store
          16
          (compiler_ast_types.AstType.U64)))
      (and
        (= (opt_aggregate_access_vec.len (& accesses)) 5)
        (>= (opt_aggregate_access_vec.capacity (& accesses)) 5)
        (=
          (compiler_optimize.opt-aggregate-access-list-store-count
            (compiler_optimize.compiler-opt-global-shared-view accesses))
          3)
        (=
          (compiler_optimize.opt-aggregate-access-list-load-count
            (compiler_optimize.compiler-opt-global-shared-view accesses))
          2)
        (match (opt_aggregate_access_vec.get
          (& accesses)
          0
          (compiler_optimize.OptAggregateAccess.Store
            -1
            (compiler_ast_types.AstType.Unit)))
          [(compiler_optimize.OptAggregateAccess.Store offset ty)
            (and
              (= offset 0)
              (compiler_optimize.opt-type-eq
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                ty
                (compiler_ast_types.AstType.I64)))]
          [_ false])
        (match (opt_aggregate_access_vec.get
          (& accesses)
          1
          (compiler_optimize.OptAggregateAccess.Store
            -1
            (compiler_ast_types.AstType.Unit)))
          [(compiler_optimize.OptAggregateAccess.Load dst offset ty)
            (and
              (= dst 11)
              (= offset 0)
              (compiler_optimize.opt-type-eq
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                ty
                (compiler_ast_types.AstType.I64)))]
          [_ false])
        (match (opt_aggregate_access_vec.get
          (& accesses)
          2
          (compiler_optimize.OptAggregateAccess.Store
            -1
            (compiler_ast_types.AstType.Unit)))
          [(compiler_optimize.OptAggregateAccess.Store offset ty)
            (and
              (= offset 8)
              (compiler_optimize.opt-type-eq
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                ty
                (compiler_ast_types.AstType.Bool)))]
          [_ false])
        (match (opt_aggregate_access_vec.get
          (& accesses)
          3
          (compiler_optimize.OptAggregateAccess.Store
            -1
            (compiler_ast_types.AstType.Unit)))
          [(compiler_optimize.OptAggregateAccess.Load dst offset ty)
            (and
              (= dst 12)
              (= offset 8)
              (compiler_optimize.opt-type-eq
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                ty
                (compiler_ast_types.AstType.Bool)))]
          [_ false])
        (match (opt_aggregate_access_vec.get
          (& accesses)
          4
          (compiler_optimize.OptAggregateAccess.Store
            -1
            (compiler_ast_types.AstType.Unit)))
          [(compiler_optimize.OptAggregateAccess.Store offset ty)
            (and
              (= offset 16)
              (compiler_optimize.opt-type-eq
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                ty
                (compiler_ast_types.AstType.U64)))]
          [_ false])))))

;; Exercise the three former hand-written scratch wrappers past their initial
;; capacity. Pointer facts must retain append order and newest-match lookup;
;; candidates and promotion slots must keep the same selection order.
(define (opt-aggregate-core-vector-growth-ok?) : bool
  (let
    [ptrs : opt_aggregate_pointer_vec.Vec
      (opt_aggregate_pointer_vec.with-capacity 1)]
    [candidates : opt_aggregate_candidate_vec.Vec
      (opt_aggregate_candidate_vec.with-capacity 1)]
    [promote-slots : opt_aggregate_promote_slot_vec.Vec
      (opt_aggregate_promote_slot_vec.with-capacity 1)]
    [index : i64 0]
    (begin
      (while (< index 5)
        (begin
          (opt_aggregate_pointer_vec.push-ref!
            (&mut ptrs)
            (compiler_optimize.OptAggregatePointer.Pointer
              (if (or (= index 0) (= index 4))
                10
                (+ 10 index))
              (* index 8)))
          (opt_aggregate_candidate_vec.push-ref!
            (&mut candidates)
            (compiler_optimize.OptAggregateAllocCandidate.Candidate
              index
              (compiler_ast_types.AstType.Unit)
              (+ index 1)
              (opt_aggregate_pointer_vec.new)
              (opt_aggregate_access_vec.new)))
          (opt_aggregate_promote_slot_vec.push-ref!
            (&mut promote-slots)
            (compiler_optimize.OptAggregatePromoteSlot.Slot index (+ 100 index)))
          (set! index (+ index 1))))
      (and
        (= (opt_aggregate_pointer_vec.len (& ptrs)) 5)
        (>= (opt_aggregate_pointer_vec.capacity (& ptrs)) 5)
        (= (opt_aggregate_candidate_vec.len (& candidates)) 5)
        (>= (opt_aggregate_candidate_vec.capacity (& candidates)) 5)
        (= (opt_aggregate_promote_slot_vec.len (& promote-slots)) 5)
        (>= (opt_aggregate_promote_slot_vec.capacity (& promote-slots)) 5)
        (match (opt_aggregate_pointer_vec.get
          (& ptrs)
          0
          (compiler_optimize.OptAggregatePointer.Pointer -1 -1))
          [(compiler_optimize.OptAggregatePointer.Pointer var offset)
            (and (= var 10) (= offset 0))])
        (match (compiler_optimize.opt-aggregate-pointer-list-lookup ptrs 10)
          [(option_i64.Some offset) (= offset 32)]
          [(option_i64.None) false])
        (match (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) 0)
          [(compiler_optimize.OptAggregateAllocCandidate.Candidate
              base
              _
              size
              _
              _)
            (and (= base 0) (= size 1))])
        (match (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) 4)
          [(compiler_optimize.OptAggregateAllocCandidate.Candidate
              base
              _
              size
              _
              _)
            (and (= base 4) (= size 5))])
        (match (compiler_optimize.opt-aggregate-promote-lookup promote-slots 4)
          [(option_i64.Some storage) (= storage 104)]
          [(option_i64.None) false])))))

(define (compiler-optimize-aggregate-candidate-self-test) : i64
  (cond
    [(not (opt-aggregate-positive-classified?)) 1]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-returned-instrs))) 2]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-passed-instrs))) 3]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-global-store-instrs))) 4]
    [(not
        (opt-aggregate-no-candidates?
          (opt-aggregate-store-through-other-instrs)))
      5]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-unknown-offset-instrs)))
      6]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-call-separated-instrs)))
      7]
    [(not (opt-aggregate-phi-flowed-rejected?)) 8]
    [(not
        (opt-aggregate-no-candidates? (opt-aggregate-predicated-memory-instrs)))
      9]
    [(not (opt-aggregate-access-vector-growth-ok?)) 10]
    [(not (opt-aggregate-core-vector-growth-ok?)) 11]
    [(not
        (opt-aggregate-cross-block-candidates-rejected?
          (opt-aggregate-cross-block-load-blocks)))
      12]
    [(not
        (opt-aggregate-cross-block-candidates-rejected?
          (compiler_ir_types.compiler-ir-block-list-compact
            (opt-aggregate-cross-block-load-blocks))))
      13]
    [(not
        (opt-aggregate-cross-block-flatten-order-ok?
          (opt-aggregate-cross-block-load-blocks)))
      14]
    [(not
        (opt-aggregate-cross-block-flatten-order-ok?
          (compiler_ir_types.compiler-ir-block-list-compact
            (opt-aggregate-cross-block-load-blocks))))
      15]
    [else 42]))

(define (opt-aggregate-array-local-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Call
      1
      cbi.compiler-builtin-id-tl-alloc
      (compiler_ir_types.CompilerIrCallArgs.One
        (compiler_ir_types.CompilerIrValue.I64 16))
      (compiler_ast_types.ast-ty-array (compiler_ast_types.AstType.I64) 2))
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.ast-ty-array (compiler_ast_types.AstType.I64) 2))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.ast-ty-array (compiler_ast_types.AstType.I64) 2))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 0)))))

(define (opt-count-tl-alloc-calls-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Call _ name _ _)
          (if (= name cbi.compiler-builtin-id-tl-alloc)
            1
            0)]
        [_ 0])
      (opt-count-tl-alloc-calls-from instrs (+ index 1)))))

(define (opt-count-tl-alloc-calls
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-tl-alloc-calls-from instrs 0))

(define (opt-count-ir-alloc-instrs-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Alloc _ _) 1]
        [_ 0])
      (opt-count-ir-alloc-instrs-from instrs (+ index 1)))))

(define (opt-count-ir-alloc-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-ir-alloc-instrs-from instrs 0))

(define (opt-count-addr-of-instrs-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.AddrOf _ _) 1]
        [_ 0])
      (opt-count-addr-of-instrs-from instrs (+ index 1)))))

(define (opt-count-addr-of-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-addr-of-instrs-from instrs 0))

(define (opt-aggregate-promote-shape-ok?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : bool
  (and
    (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 10)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
      [(compiler_ir_types.CompilerIrInstr.Alloc first-dst first-ty)
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 1)
          [(compiler_ir_types.CompilerIrInstr.Alloc second-dst second-ty)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 2)
              [(compiler_ir_types.CompilerIrInstr.AddrOf base storage)
                (and
                  (= first-dst 4)
                  (= second-dst 5)
                  (= storage 5)
                  (= base 1)
                  (compiler_optimize.opt-type-eq
                    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                    first-ty
                    second-ty))]
              [_ false])]
          [_ false])]
      [_ false])))

(define (opt-aggregate-promote-test-function
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-aggregate-stack-promote-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-spans-function instrs)))

;; Self-test helper: materializes the optimized first block for dense fixture
;; assertions only, outside the production optimizer pipeline.
(define (opt-aggregate-promote-test-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (match (opt-aggregate-promote-test-function instrs)
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler_ir_types.compiler-ir-block-list-force-cons blocks)
        [(compiler_ir_types.CompilerIrBlockList.Cons block _)
          (match block
            [(compiler_ir_types.CompilerIrBlock.Block _ optimized) optimized])]
        [(compiler_ir_types.CompilerIrBlockList.Array _)
          (compiler_ir_types.compiler-ir-instr-seq-empty)]
        [(compiler_ir_types.CompilerIrBlockList.Nil)
          (compiler_ir_types.compiler-ir-instr-seq-empty)])]))

(define (opt-aggregate-promote-test-frame
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (match (opt-aggregate-promote-test-function instrs)
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ frame _) frame]))

(define (compiler-optimize-aggregate-promote-self-test) : i64
  (let
    [positive : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-positive-instrs))]
    [returned : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-returned-instrs))]
    [passed : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-passed-instrs))]
    [stored : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-global-store-instrs))]
    [unknown-offset : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-unknown-offset-instrs))]
    [call-separated : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-call-separated-instrs))]
    [array-local : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-array-local-instrs))]
    [level0 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (opt-spans-program (opt-aggregate-positive-instrs))
        0)]
    [level2 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (opt-spans-program (opt-aggregate-positive-instrs))
        2)]
    (cond
      [(not
          (=
            (opt-count-tl-alloc-calls
              (compiler_optimize.compiler-opt-global-shared-view positive))
            0))
        1]
      [(not
          (=
            (opt-count-ir-alloc-instrs
              (compiler_optimize.compiler-opt-global-shared-view positive))
            2))
        2]
      [(not
          (=
            (opt-count-addr-of-instrs
              (compiler_optimize.compiler-opt-global-shared-view positive))
            1))
        3]
      [(not (opt-aggregate-promote-shape-ok? positive)) 4]
      [(not
          (=
            (opt-aggregate-promote-test-frame (opt-aggregate-positive-instrs))
            6))
        5]
      [(not (= (opt-count-tl-alloc-calls returned) 1)) 6]
      [(not (= (opt-count-tl-alloc-calls passed) 1)) 7]
      [(not (= (opt-count-tl-alloc-calls stored) 1)) 8]
      [(not (= (opt-count-tl-alloc-calls unknown-offset) 1)) 9]
      [(not (= (opt-count-tl-alloc-calls call-separated) 1)) 10]
      [(not (= (opt-count-tl-alloc-calls array-local) 1)) 11]
      [(not (= (opt-count-tl-alloc-calls (opt-program-first-instrs level0)) 1))
        12]
      [(not (= (opt-count-tl-alloc-calls (opt-program-first-instrs level2)) 0))
        13]
      [else 42])))

(define (opt-aggregate-repeated-load-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      5
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 6)))))

(define (opt-aggregate-overwritten-load-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 20)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 4)))))

(define (opt-aggregate-escaped-then-load-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (compiler_ir_types.CompilerIrInstr.Store
      (opt-test-symbol "escaped")
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 4)))))

(define (opt-aggregate-array-typed-load-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.ast-ty-array (compiler_ast_types.AstType.I64) 2))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.ast-ty-array (compiler_ast_types.AstType.I64) 2))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 0)))))

(define (opt-aggregate-branch-load-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-aggregate-test-alloc)
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 10)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Load
            4
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-aggregate-cross-block-load-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-aggregate-test-alloc)
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 10)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "next"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "next")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Load
            4
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-aggregate-cross-block-candidates-rejected?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (let
    [program : compiler_ir_types.CompilerIrProgram
      (compiler_ir_types.CompilerIrProgram.Program
        (compiler_ir_types.compiler-ir-global-seq-empty)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (compiler_ir_types.CompilerIrFunction.Function
            (opt-test-symbol "main")
            (compiler_ir_types.compiler-ir-param-seq-empty)
            (compiler_ast_types.AstType.I64)
            4
            blocks)
          (compiler_ir_types.compiler-ir-function-seq-empty))
        (compiler_ir_types.compiler-ir-extern-seq-empty))]
    [candidates : opt_aggregate_candidate_vec.Vec
      (compiler_optimize.opt-aggregate-allocation-candidates
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        program)]
    (= (compiler_optimize.opt-aggregate-candidate-list-count candidates) 0)))

(define (opt-aggregate-cross-block-flatten-order-ok?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (let
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-aggregate-flatten-blocks blocks)]
    (and
      (=
        (compiler_ir_types.compiler-ir-instr-seq-count
          (compiler_ir_types.compiler-ir-global-shared-view instrs))
        7)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        0)
        [(compiler_ir_types.CompilerIrInstr.Call dst name _ _)
          (and (= dst 1) (= name cbi.compiler-builtin-id-tl-alloc))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        1)
        [(compiler_ir_types.CompilerIrInstr.Gep
            dst
            (compiler_ir_types.CompilerIrValue.Var src)
            (compiler_ir_types.CompilerIrValue.I64 offset)
            _)
          (and (= dst 2) (= src 1) (= offset 0))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        2)
        [(compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var ptr)
            (compiler_ir_types.CompilerIrValue.I64 value)
            _)
          (and (= ptr 2) (= value 10))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        3)
        [(compiler_ir_types.CompilerIrInstr.Jump label)
          (compiler_ir_types.compiler-ir-symbol-eq?
            label
            (compiler_ir_types.compiler-ir-label "next"))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        4)
        [(compiler_ir_types.CompilerIrInstr.Gep
            dst
            (compiler_ir_types.CompilerIrValue.Var src)
            (compiler_ir_types.CompilerIrValue.I64 offset)
            _)
          (and (= dst 3) (= src 1) (= offset 0))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        5)
        [(compiler_ir_types.CompilerIrInstr.Load
            dst
            (compiler_ir_types.CompilerIrValue.Var src)
            _)
          (and (= dst 4) (= src 3))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        6)
        [(compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var value)))
          (= value 4)]
        [_ false]))))

(define (opt-count-load-dst-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-load-dst-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      dst
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Load d _ _)
            (if (= d dst)
              1
              0)]
          [_ 0])))))

(define (opt-count-load-dst-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-count-load-dst-instr-seq-from instrs.slots 0 instrs.len dst 0))

(define (opt-count-load-dst-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-load-dst-instr-seq instrs dst)
            (opt-count-load-dst-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              dst))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-load-dst-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-count-mov-i64-value-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [needle : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-mov-i64-value-instr-seq instrs needle)
            (opt-count-mov-i64-value-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              needle))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-mov-i64-value-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        needle)]))

(define (opt-aggregate-sroa-test-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  ;; Self-test helper: materializes one optimized block for list assertions.
  (match (compiler_optimize.opt-aggregate-sroa-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-spans-function instrs))
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler_ir_types.compiler-ir-block-list-force-cons blocks)
        [(compiler_ir_types.CompilerIrBlockList.Cons block _)
          (match block
            [(compiler_ir_types.CompilerIrBlock.Block _ optimized) optimized])]
        [(compiler_ir_types.CompilerIrBlockList.Array _)
          (compiler_ir_types.compiler-ir-instr-seq-empty)]
        [(compiler_ir_types.CompilerIrBlockList.Nil)
          (compiler_ir_types.compiler-ir-instr-seq-empty)])]))

(define (opt-aggregate-sroa-test-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (match (compiler_optimize.opt-aggregate-sroa-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "main")
      (compiler_ir_types.compiler-ir-param-seq-empty)
      (compiler_ast_types.AstType.I64)
      4
      blocks))
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ optimized)
      optimized]))

(define (compiler-optimize-aggregate-sroa-self-test) : i64
  (let
    [positive-result : compiler_optimize.OptFunctionPassResult
      (compiler_optimize.opt-aggregate-sroa-function-pass
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-spans-function (opt-aggregate-positive-instrs)))]
    [positive-changed : bool
      (match (compiler_optimize.compiler-opt-global-shared-view positive-result)
        [(compiler_optimize.OptFunctionPassResult.Result _ changed) changed])]
    [noop-result : compiler_optimize.OptFunctionPassResult
      (compiler_optimize.opt-aggregate-sroa-function-pass
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-spans-function
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 42))))))]
    [noop-changed : bool
      (match noop-result
        [(compiler_optimize.OptFunctionPassResult.Result _ changed) changed])]
    [positive : compiler_ir_types.CompilerIrInstrSeq
      (match positive-result
        [(compiler_optimize.OptFunctionPassResult.Result func _)
          (opt-function-first-instrs func)])]
    [repeated : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-sroa-test-instrs (opt-aggregate-repeated-load-instrs))]
    [overwritten : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-sroa-test-instrs (opt-aggregate-overwritten-load-instrs))]
    [barrier : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-sroa-test-instrs (opt-aggregate-call-separated-instrs))]
    [escaped : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-sroa-test-instrs (opt-aggregate-escaped-then-load-instrs))]
    [array-typed : compiler_ir_types.CompilerIrInstrSeq
      (opt-aggregate-sroa-test-instrs (opt-aggregate-array-typed-load-instrs))]
    [branched : compiler_ir_types.CompilerIrBlockList
      (opt-aggregate-sroa-test-blocks (opt-aggregate-branch-load-blocks))]
    (cond
      [(not positive-changed) 1]
      [noop-changed 2]
      [(not
          (=
            (opt-count-load-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view positive)
              5)
            0))
        3]
      [(not (= (opt-mov-dst-i64-value-instr-seq positive 5 -1) 10)) 4]
      [(not
          (=
            (opt-count-load-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view repeated)
              4)
            0))
        5]
      [(not
          (=
            (opt-count-load-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view repeated)
              6)
            0))
        6]
      [(not (= (opt-count-mov-i64-value-instr-seq repeated 10) 2)) 7]
      [(not
          (=
            (opt-count-load-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view overwritten)
              4)
            0))
        8]
      [(not
          (=
            (opt-mov-dst-i64-value-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view overwritten)
              4
              -1)
            20))
        9]
      [(not (= (opt-count-mov-i64-value-instr-seq overwritten 10) 0)) 10]
      [(not
          (=
            (opt-count-load-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view barrier)
              4)
            1))
        11]
      [(not (= (opt-count-mov-i64-value-instr-seq barrier 10) 0)) 12]
      [(not
          (=
            (opt-count-load-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view escaped)
              4)
            1))
        13]
      [(not (= (opt-count-mov-i64-value-instr-seq escaped 10) 0)) 14]
      [(not (= (opt-count-load-dst-instr-seq array-typed 4) 1)) 15]
      [(not
          (=
            (opt-count-load-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view branched)
              4)
            1))
        16]
      [(not (= (opt-count-mov-i64-value-blocks branched 10) 0)) 17]
      [else 42])))

(define (opt-count-cast-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-cast-instr-seq-from
      (compiler_optimize.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Cast _ _ _ _) 1]
          [_ 0])))))

(define (opt-count-cast-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-cast-instr-seq-from instrs.slots 0 instrs.len 0))

;; Builds `[Mov v0=20, Mov v1=22, BinOp v2 = v0 + v1]` (one arithmetic instr).
(define (opt-self-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 20)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.I64 22)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

(define (opt-stale-load-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 41)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      0
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      1
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))))

(define (opt-vector-mask-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.I64 4)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Splat
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.LaneId
      3
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.TailMask
      4
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4)
    (compiler_ir_types.ir-instr-vector-bin-op
      5
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-select
      6
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ir_types.CompilerIrValue.Var 2)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-predicated-store
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ir_types.CompilerIrValue.Var 4)
      4
      (compiler_ast_types.AstType.I64))))

(define (opt-vector-cse-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.ir-instr-vector-bin-op
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4
      (compiler_ast_types.AstType.I64))))

(define (opt-vector-reduce-cse-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.VectorReduce
      1
      (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.VectorReduce
      2
      (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))))

(define (opt-vector-reduce-stale-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.VectorReduce
      1
      (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))))

(define (opt-vector-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4
      (compiler_ast_types.AstType.I64))))

(define (opt-mask-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.MaskBinOp
      3
      (compiler_ir_types.CompilerIrMaskBinOp.And)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4)))

(define (opt-mask-reduce-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.MaskReduce
      2
      (compiler_ir_types.CompilerIrMaskReduceOp.Any)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4)))

(define (opt-mask-not-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.MaskNot
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      4)
    (compiler_ir_types.CompilerIrInstr.Mov
      4
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.MaskNot
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      4)))

(define (opt-mask-idempotent-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.MaskBinOp
      2
      (compiler_ir_types.CompilerIrMaskBinOp.Or)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4)
    (compiler_ir_types.CompilerIrInstr.MaskReduce
      3
      (compiler_ir_types.CompilerIrMaskReduceOp.Any)
      (compiler_ir_types.CompilerIrValue.Var 2)
      4)
    (compiler_ir_types.CompilerIrInstr.MaskBinOp
      4
      (compiler_ir_types.CompilerIrMaskBinOp.And)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 1)
      4)
    (compiler_ir_types.CompilerIrInstr.MaskReduce
      5
      (compiler_ir_types.CompilerIrMaskReduceOp.Any)
      (compiler_ir_types.CompilerIrValue.Var 4)
      4)))

(define (opt-count-vector-binop-instrs-from-index
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.VectorBinOp _) 1]
        [_ 0])
      (opt-count-vector-binop-instrs-from-index instrs (+ index 1)))))

(define (opt-count-vector-binop-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-vector-binop-instrs-from-index instrs 0))

(define (opt-count-vector-reduce-instrs-from-index
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.VectorReduce _ _ _ _ _) 1]
        [_ 0])
      (opt-count-vector-reduce-instrs-from-index instrs (+ index 1)))))

(define (opt-count-vector-reduce-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-vector-reduce-instrs-from-index instrs 0))

(define (opt-vector-binop-lhs-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.VectorBinOp payload-box)
        (let
          [d
            (compiler_optimize.compiler-opt-box-field-shared-view
              payload-box
              dst)]
          [lhs
            (compiler_optimize.compiler-opt-box-field-shared-view
              payload-box
              lhs)]
          (if (= d dst)
            (match (compiler_optimize.compiler-opt-global-shared-view lhs)
              [(compiler_ir_types.CompilerIrValue.Var id) id]
              [_ (- 0 1)])
            (opt-vector-binop-lhs-var-from
              (compiler_optimize.compiler-opt-global-shared-view instrs)
              (+ index 1)
              dst)))]
      [_
        (opt-vector-binop-lhs-var-from
          (compiler_optimize.compiler-opt-global-shared-view instrs)
          (+ index 1)
          dst)])))

(define (opt-vector-binop-lhs-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-vector-binop-lhs-var-from instrs 0 dst))

(define (opt-mask-binop-lhs-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.MaskBinOp d _ lhs _ _)
        (if (= d dst)
          (match lhs
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-mask-binop-lhs-var-from instrs (+ index 1) dst))]
      [_ (opt-mask-binop-lhs-var-from instrs (+ index 1) dst)])))

(define (opt-mask-binop-lhs-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-mask-binop-lhs-var-from instrs 0 dst))

(define (opt-mask-reduce-src-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.MaskReduce d _ src _)
        (if (= d dst)
          (match src
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-mask-reduce-src-var-from instrs (+ index 1) dst))]
      [_ (opt-mask-reduce-src-var-from instrs (+ index 1) dst)])))

(define (opt-mask-reduce-src-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-mask-reduce-src-var-from instrs 0 dst))

(define (opt-mask-not-src-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.MaskNot d src _)
        (if (= d dst)
          (match src
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-mask-not-src-var-from instrs (+ index 1) dst))]
      [_ (opt-mask-not-src-var-from instrs (+ index 1) dst)])))

(define (opt-mask-not-src-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-mask-not-src-var-from instrs 0 dst))

(define (compiler-optimize-vector-mask-self-test) : i64
  (let
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-vector-mask-test-instrs)]
    [folded : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (compiler_optimize.compiler-opt-global-shared-view instrs))]
    [dce : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs
        (opt-test-collect-instrs-uses
          (opt_i64_i64_map.with-capacity 64)
          (compiler_optimize.compiler-opt-global-shared-view instrs))
        (compiler_optimize.compiler-opt-global-shared-view instrs))]
    [bounds : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (compiler_optimize.compiler-opt-global-shared-view instrs))]
    [vector-cse : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-vector-cse-instrs))]
    [vector-reduce-cse : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-vector-reduce-cse-instrs))]
    [vector-stale : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-vector-reduce-stale-instrs))]
    [vector-copy : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-vector-copy-instrs))]
    [mask-copy : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-mask-copy-instrs))]
    [mask-reduce-copy : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-mask-reduce-copy-instrs))]
    [mask-not-copy : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-mask-not-copy-instrs))]
    [mask-idempotent-copy : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-test-fold-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_optimize.OptConstEnv.Nil)
          (opt-mask-idempotent-copy-instrs)))]
    [mask-idempotent-dce : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs
        (opt-test-collect-instrs-uses
          (opt_i64_i64_map.with-capacity 64)
          (compiler_optimize.compiler-opt-global-shared-view
            mask-idempotent-copy))
        (compiler_optimize.compiler-opt-global-shared-view mask-idempotent-copy))]
    (cond
      [(not
          (opt-test-instr-seq-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            folded
            instrs))
        1]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count dce) 8)) 2]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count bounds) 8)) 3]
      [(not
          (=
            (opt-count-vector-binop-instrs
              (compiler_optimize.compiler-opt-global-shared-view vector-cse))
            1))
        4]
      [(not
          (=
            (opt-mov-dst-type-tag
              (compiler_optimize.compiler-opt-global-shared-view vector-cse)
              3)
            (compiler_ast_types.ast-type-tag (compiler_ast_types.AstType.I64))))
        5]
      [(not
          (=
            (opt-count-vector-reduce-instrs
              (compiler_optimize.compiler-opt-global-shared-view
                vector-reduce-cse))
            2))
        6]
      [(not
          (=
            (opt-mov-dst-type-tag
              (compiler_optimize.compiler-opt-global-shared-view
                vector-reduce-cse)
              2)
            0))
        7]
      [(not
          (=
            (opt-count-arith-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view vector-stale))
            1))
        8]
      [(not
          (=
            (opt-count-mov-i64-value-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view vector-stale)
              11)
            0))
        9]
      [(not (= (opt-vector-binop-lhs-var vector-copy 3) 0)) 10]
      [(not (= (opt-mask-binop-lhs-var mask-copy 3) 0)) 11]
      [(not (= (opt-mask-reduce-src-var mask-reduce-copy 2) 0)) 12]
      [(not
          (=
            (opt-mask-not-src-var
              (compiler_optimize.compiler-opt-global-shared-view mask-not-copy)
              2)
            0))
        13]
      [(not
          (=
            (opt-mask-binop-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view
                mask-idempotent-copy)
              2)
            0))
        14]
      [(not
          (=
            (opt-mask-binop-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view
                mask-idempotent-copy)
              4)
            0))
        15]
      [(not
          (=
            (opt-mov-dst-type-tag
              (compiler_optimize.compiler-opt-global-shared-view
                mask-idempotent-copy)
              2)
            0))
        16]
      [(not
          (=
            (opt-mask-reduce-src-var
              (compiler_optimize.compiler-opt-global-shared-view
                mask-idempotent-copy)
              3)
            0))
        17]
      [(not (= (opt-mask-reduce-src-var mask-idempotent-copy 5) 0)) 18]
      [(not
          (=
            (compiler_ir_types.compiler-ir-instr-seq-count mask-idempotent-dce)
            0))
        19]
      [(not (= (opt-mask-not-src-var mask-not-copy 5) 4)) 20]
      [else 42])))

;; Returns 42 when folding turns the one arithmetic instruction into a `Mov`
;; literal whose value (20 + 22) is correct, and a later `Load` redefining a
;; formerly-constant var invalidates the stale fact before another arithmetic
;; instruction reads that var.
(define (compiler-optimize-self-test-failure-message
  [name : String]
  [actual : i64]
  [expected : i64]) : String
  (str_cat.str-cat
    "optimizer self-test failed: "
    name
    " (expected "
    (string.int->string expected)
    ", got "
    (string.int->string actual)
    ")"))

(define (compiler-optimize-self-test-require-i64!
  [name : String]
  [actual : i64]
  [expected : i64]) : unit
  (unless
    (= actual expected)
    (io.panic
      (compiler-optimize-self-test-failure-message name actual expected))))

(define (compiler-optimize-self-test-require! [name : String] [ok : bool]) : unit
  (unless ok (io.panic (str_cat.str-cat "optimizer self-test failed: " name))))

(define (compiler-optimize-debug-verifier-self-test) : i64
  (let
    [name : i64 (compiler_ir_types.compiler-ir-test-symbol "debug-invalid")]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [program : compiler_ir_types.CompilerIrProgram
      (compiler_ir_types.CompilerIrProgram.Program
        (compiler_ir_types.compiler-ir-global-seq-empty)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (compiler_ir_types.CompilerIrFunction.Function
            name
            (compiler_ir_types.compiler-ir-param-seq-empty)
            (compiler_ast_types.AstType.I64)
            1
            blocks)
          (compiler_ir_types.compiler-ir-function-seq-empty))
        (compiler_ir_types.compiler-ir-extern-seq-empty))]
    (match (compiler_optimize.opt-verify-program program)
      [(compiler_optimize.ResultCompilerOptimizeVerify.Err message)
        (if (string.eq
          message
          "function @debug-invalid: block entry instruction 0: optimizer verify: use before definition")
          42
          1)]
      [(compiler_optimize.ResultCompilerOptimizeVerify.Ok) 2])))

(define (opt-indirect-call-def-is?
  [instr : compiler_ir_types.CompilerIrInstr]
  [want : i64]) : bool
  (match (compiler_optimize.opt-instr-def-var instr)
    [(option_i64.Some found) (= found want)]
    [(option_i64.None) false]))

(define (opt-indirect-call-nondef? [instr : compiler_ir_types.CompilerIrInstr]) : bool
  (match (compiler_optimize.opt-instr-def-var instr)
    [(option_i64.Some _) false]
    [(option_i64.None) true]))

(define (opt-indirect-call-def-function
  [name : i64]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    (+ dst 1)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          instr
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var dst)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; Value-returning indirect calls define their first payload field. Aggregate
;; C-ABI store-result calls only write through an existing base, and an indirect
;; tail call transfers control, so neither of those forms defines an SSA value.
(define (compiler-optimize-indirect-call-def-self-test) : i64
  (let
    [indirect : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.CallIndirect
        7
        (compiler_ir_types.CompilerIrValue.Function (opt-test-symbol "callee"))
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ast_types.AstType.I64))]
    [indirect-c : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.CallIndirectC
        8
        (compiler_ir_types.CompilerIrValue.Function
          (opt-test-symbol "extern_callee"))
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ast_types.AstType.I64))]
    [direct-store : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.ir-instr-call-cabi-store-result
        (compiler_ir_types.CompilerIrValue.I64 0)
        (opt-test-symbol "aggregate_callee")
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ir_types.CompilerIrCAbiReturnSlotSeq
          (__tl_make-array compiler_ir_types.CompilerIrCAbiReturnSlot 0)
          0))]
    [indirect-store : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.ir-instr-call-indirect-cabi-store-result
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.CompilerIrValue.Function
          (opt-test-symbol "aggregate_indirect_callee"))
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ir_types.CompilerIrCAbiReturnSlotSeq
          (__tl_make-array compiler_ir_types.CompilerIrCAbiReturnSlot 0)
          0))]
    [tail : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.TailCallIndirect
        (compiler_ir_types.CompilerIrValue.Function
          (opt-test-symbol "tail_callee"))
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ast_types.AstType.I64))]
    (cond
      [(not
          (opt-indirect-call-def-is?
            (compiler_optimize.compiler-opt-global-shared-view indirect)
            7))
        1]
      [(not
          (opt-indirect-call-def-is?
            (compiler_optimize.compiler-opt-global-shared-view indirect-c)
            8))
        2]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-indirect-call-def-function
                (opt-test-symbol "indirect_def")
                indirect
                7))))
        3]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-indirect-call-def-function
                (opt-test-symbol "indirect_c_def")
                indirect-c
                8))))
        4]
      [(not (opt-indirect-call-nondef? direct-store)) 5]
      [(not (opt-indirect-call-nondef? indirect-store)) 6]
      [(not (opt-indirect-call-nondef? tail)) 7]
      [else 42])))

(define (opt-loop-bce-argc-summary-test-function [has-entry : bool]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (if has-entry
      0
      1)
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (if has-entry
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
            (compiler_ir_types.CompilerIrInstr.Mov
              1
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1))))
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              0
              (compiler_ir_types.CompilerIrValue.I64 7)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 0))))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-loop-bce-argc-summary-prescan-self-test?) : bool
  (and
    (not
      (compiler_optimize.opt-loop-bce-function-returns-argc?
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-loop-bce-argc-summary-test-function false)))
    (compiler_optimize.opt-loop-bce-function-returns-argc?
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-loop-bce-argc-summary-test-function true))))

(define (compiler-optimize-self-test) : i64
  (let
    [instrs : compiler_ir_types.CompilerIrInstrSeq (opt-self-test-instrs)]
    [optimized : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (compiler_optimize.compiler-opt-global-shared-view instrs))]
    [fold-fire-result : compiler_optimize.OptBlockListPassResult
      (compiler_optimize.optimize-block-list-for-function-pass
        (profile_state.compiler-profile-state-metrics
          (profile_state.compiler-profile-state-new))
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_optimize.compiler-opt-global-shared-view instrs))
          compiler_ir_types.CompilerIrBlockList.Nil))]
    [fold-noop-result : compiler_optimize.OptBlockListPassResult
      (compiler_optimize.optimize-block-list-for-function-pass
        (profile_state.compiler-profile-state-metrics
          (profile_state.compiler-profile-state-new))
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        1
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "entry")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 42)))))
          compiler_ir_types.CompilerIrBlockList.Nil))]
    (begin
      (compiler-optimize-self-test-require!
        "fold pass reports a real rewrite"
        (match fold-fire-result
          [(compiler_optimize.OptBlockListPassResult.Result _ changed) changed]))
      (compiler-optimize-self-test-require!
        "fold pass reports and reuses a no-op"
        (match fold-noop-result
          [(compiler_optimize.OptBlockListPassResult.Result _ changed)
            (not changed)]))
      (compiler-optimize-self-test-require-i64!
        "constant-fold input arithmetic count"
        (opt-count-arith-instr-seq instrs)
        1)
      (compiler-optimize-self-test-require-i64!
        "constant-fold output arithmetic count"
        (opt-count-arith-instr-seq
          (compiler_optimize.compiler-opt-global-shared-view optimized))
        0)
      (compiler-optimize-self-test-require-i64!
        "constant-fold literal sum"
        (opt-sum-mov-i64 optimized)
        84)
      (let
        [stale-instrs : compiler_ir_types.CompilerIrInstrSeq
          (opt-stale-load-test-instrs)]
        [stale-optimized : compiler_ir_types.CompilerIrInstrSeq
          (opt-test-fold-instrs
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.OptConstEnv.Nil)
            stale-instrs)]
        (begin
          (compiler-optimize-self-test-require-i64!
            "stale load invalidates constant fact"
            (opt-count-arith-instr-seq stale-optimized)
            1)
          (compiler-optimize-self-test-require-i64!
            "vector/mask folding and copy propagation"
            (compiler-optimize-vector-mask-self-test)
            42)
          (compiler-optimize-self-test-require-i64!
            "indirect call definition bookkeeping"
            (compiler-optimize-indirect-call-def-self-test)
            42)
          (compiler-optimize-self-test-require!
            "loop-BCE argc summary prescan"
            (opt-loop-bce-argc-summary-prescan-self-test?))
          42)))))

(define (opt-typed-fold-u64-shr-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      20
      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Mov
      21
      (compiler_ir_types.CompilerIrValue.I64 63)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.BinOp
      22
      (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ir_types.CompilerIrValue.Var 21)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      23
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ir_types.CompilerIrValue.I64 256)
      (compiler_ast_types.AstType.U64))))

(define (opt-typed-fold-shift-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-u64-shr-instrs)
    (compiler_ir_types.CompilerIrInstr.Mov
      15
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      16
