          0
          3)
          [(compiler_ir_types.CompilerIrMaybeValue.Some value)
            (match value
              [(compiler_ir_types.CompilerIrValue.I64 found) (not (= found 2))]
              [_ true])]
          [(compiler_ir_types.CompilerIrMaybeValue.No) true])
        28]
      [(match (compiler_optimize.opt-global-expr-lookup
          type-segment-bases
          expr-precedence
          expr-key
          9
          (compiler_optimize.compiler-opt-global-shared-view doms)
          0
          3)
          [(compiler_ir_types.CompilerIrMaybeValue.Some value)
            (match value
              [(compiler_ir_types.CompilerIrValue.Var found) (not (= found 2))]
              [_ true])]
          [(compiler_ir_types.CompilerIrMaybeValue.No) true])
        29]
      [(match (compiler_optimize.opt-global-pack-word-lookup
          pack-precedence
