            38))
        31]
      [(not
          (=
            (opt-count-phi-blocks
              (compiler_optimize.compiler-opt-global-shared-view multi-offset))
            3))
        32]
      [(not
          (=
            (opt-blocks-mov-src-var
              (compiler_optimize.compiler-opt-global-shared-view multi-offset)
