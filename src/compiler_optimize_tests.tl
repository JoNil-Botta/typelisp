                (compiler_ir_types.compiler-ir-label "join")))
            2))
        1]
      [(not
          (=
            (compiler_optimize.opt-cfg-index-block-count
              (compiler_optimize.compiler-opt-global-shared-view diamond-index))
            4))
        2]
