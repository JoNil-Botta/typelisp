        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view sccp-folded-edge-fused-blocks)
            (ir.compiler-ir-label "gap")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view sccp-folded-edge-fused-blocks)
            (ir.compiler-ir-label "branch-site")))
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view sccp-folded-edge-fused-blocks)
            (ir.compiler-ir-label "yes"))
          2)
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view sccp-folded-edge-fused-blocks)
            (ir.compiler-ir-label "no"))
          1))
      (return 85))
    (unless
      (opt.opt-verify-ok?
        (& (opt.opt-verify-function (& sccp-folded-edge-fused-function))))
      (return 86))
    (unless and-chain-changed (return 46))
    (unless
      (= (ir.compiler-ir-block-list-count and-chain-blocks) 5)
      (return 47))
    (unless
      (=
        (opt-count-branches-blocks
          (ir.compiler-ir-block-list-view and-chain-blocks))
        3)
      (return 48))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view and-chain-blocks)
          (And))
        0)
      (return 49))
    (unless
      (and
        (opt-bool-branch-chain-compare-branch-block?
          and-chain-blocks
          (ir.compiler-ir-label "entry"))
        (opt-bool-branch-chain-compare-branch-block?
          and-chain-blocks
          (ir.compiler-ir-label "entry__bool_and.0"))
        (opt-bool-branch-chain-compare-branch-block?
          and-chain-blocks
          (ir.compiler-ir-label "entry__bool_and.1")))
      (return 50))
    (unless
      (and
        (opt-bool-branch-first-phi-has-label?
          and-chain-blocks
          (ir.compiler-ir-label "yes")
          (ir.compiler-ir-label "entry__bool_and.1"))
        (not
          (opt-bool-branch-first-phi-has-label?
            and-chain-blocks
            (ir.compiler-ir-label "yes")
            (ir.compiler-ir-label "entry")))
        (opt-bool-branch-first-phi-has-label?
          and-chain-blocks
          (ir.compiler-ir-label "no")
          (ir.compiler-ir-label "entry"))
        (opt-bool-branch-first-phi-has-label?
          and-chain-blocks
          (ir.compiler-ir-label "no")
          (ir.compiler-ir-label "entry__bool_and.0"))
        (opt-bool-branch-first-phi-has-label?
          and-chain-blocks
          (ir.compiler-ir-label "no")
          (ir.compiler-ir-label "entry__bool_and.1")))
      (return 51))
    (unless
      (opt.opt-verify-ok? (& (opt.opt-verify-function (& and-chain-function))))
      (return 52))
    (unless
      (and
        (not and-chain-reused-changed)
        (let
          [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
          [b
            (opt-bool-branch-chain-test-function
              (opt-bool-branch-chain-test-blocks 1))]
          (opt.opt-function-eq type-segment-bases and-chain-reused-function b)))
      (return 53))
    (unless
      (and
        (not and-chain-or-changed)
        (let
          [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
          [b
            (opt-bool-branch-chain-test-function
              (opt-bool-branch-chain-test-blocks 2))]
          (opt.opt-function-eq type-segment-bases and-chain-or-function b)))
      (return 54))
    ;; The lowered `(or c1 c2)` guard threads both merge levels away: every
    ;; arm branches straight to the decided target, the retest branch and both
    ;; boolean phis are gone, and the merges lose every predecessor.
    (unless
      (and
        (=
          (opt-count-phi-blocks
            (ir.compiler-ir-block-list-view thread-chain-blocks))
          0)
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-chain-blocks)
            (ir.compiler-ir-label "tc-merge"))
          0)
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-chain-blocks)
            (ir.compiler-ir-label "tc-merge")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-chain-blocks)
            (ir.compiler-ir-label "tc-inner-merge")))
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& thread-chain-function)))))
      (return 55))
    ;; Strictness rail: one effectful instruction between the merge phi and
    ;; its branch blocks the whole chain, merges included.
    (unless
      (and
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-blocked-blocks)
          (ir.compiler-ir-label "tc-merge"))
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-blocked-blocks)
          (ir.compiler-ir-label "tc-inner-merge"))
        (>
          (opt-count-phi-blocks
            (ir.compiler-ir-block-list-view thread-blocked-blocks))
          0)
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& thread-blocked-function)))))
      (return 56))
    ;; A threaded edge into a successor that carries a phi keeps the phi's
    ;; predecessor list consistent: the merge input is replaced by one input
    ;; per threaded origin, carrying the value the merge forwarded.
    (unless
      (and
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-successor-blocks)
            (ir.compiler-ir-label "ts-merge")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-successor-blocks)
            (ir.compiler-ir-label "ts-inner-merge")))
        (opt-bool-branch-first-phi-has-label?
          thread-successor-blocks
          (ir.compiler-ir-label "ts-yes")
          (ir.compiler-ir-label "ts-then"))
        (opt-bool-branch-first-phi-has-label?
          thread-successor-blocks
          (ir.compiler-ir-label "ts-yes")
          (ir.compiler-ir-label "ts-inner-then"))
        (opt-bool-branch-first-phi-has-label?
          thread-successor-blocks
          (ir.compiler-ir-label "ts-yes")
          (ir.compiler-ir-label "ts-alt"))
        (not
          (opt-bool-branch-first-phi-has-label?
            thread-successor-blocks
            (ir.compiler-ir-label "ts-yes")
            (ir.compiler-ir-label "ts-merge")))
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& thread-successor-function)))))
      (return 57))
    ;; Straightening, plain: both trampolines go, the `true` arm resolves
    ;; through a two-block chain, and only entry plus the two returns remain.
    (unless
      (and
        straighten-plain-changed
        (= (ir.compiler-ir-block-list-count straighten-plain-blocks) 3)
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-plain-blocks)
            (ir.compiler-ir-label "sf-then")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-plain-blocks)
            (ir.compiler-ir-label "sf-mid")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-plain-blocks)
            (ir.compiler-ir-label "sf-else")))
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& straighten-plain-function)))))
      (return 63))
    ;; Straightening with phi repair: the removed arm's input is replaced by
    ;; one under the threaded origin, carrying the value it forwarded, and the
    ;; arm that does real work keeps its own input.
    (unless
      (and
        straighten-phi-changed
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-phi-blocks)
            (ir.compiler-ir-label "sp-then")))
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view straighten-phi-blocks)
          (ir.compiler-ir-label "sp-else"))
        (=
          (opt-count-phi-blocks
            (ir.compiler-ir-block-list-view straighten-phi-blocks))
          1)
        (opt-bool-branch-first-phi-has-label?
          straighten-phi-blocks
          (ir.compiler-ir-label "sp-join")
          (ir.compiler-ir-label "entry"))
        (opt-bool-branch-first-phi-has-label?
          straighten-phi-blocks
          (ir.compiler-ir-label "sp-join")
          (ir.compiler-ir-label "sp-else"))
        (not
          (opt-bool-branch-first-phi-has-label?
            straighten-phi-blocks
            (ir.compiler-ir-label "sp-join")
            (ir.compiler-ir-label "sp-then")))
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& straighten-phi-function)))))
      (return 64))
    ;; Duplicate-predecessor rail: the first arm threads, the second is
    ;; refused and keeps its block, so `sd-join` still has one phi input per
    ;; predecessor. Threading both would need two `entry` inputs in one phi.
    (unless
      (and
        straighten-duplicate-changed
        (= (ir.compiler-ir-block-list-count straighten-duplicate-blocks) 3)
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-duplicate-blocks)
            (ir.compiler-ir-label "sd-then")))
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view straighten-duplicate-blocks)
          (ir.compiler-ir-label "sd-else"))
        (=
          (opt-count-phi-blocks
            (ir.compiler-ir-block-list-view straighten-duplicate-blocks))
          1)
        (opt-bool-branch-first-phi-has-label?
          straighten-duplicate-blocks
          (ir.compiler-ir-label "sd-join")
          (ir.compiler-ir-label "entry"))
        (opt-bool-branch-first-phi-has-label?
          straighten-duplicate-blocks
          (ir.compiler-ir-label "sd-join")
          (ir.compiler-ir-label "sd-else"))
        (not
          (opt-bool-branch-first-phi-has-label?
            straighten-duplicate-blocks
            (ir.compiler-ir-label "sd-join")
            (ir.compiler-ir-label "sd-then")))
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& straighten-duplicate-function)))))
      (return 65))
    (unless (not straighten-inert-changed) (return 66))
    ;; Already-elided rail: a trampoline directly in front of its own target
    ;; is left alone, so `opt-loop-preheaders` output and the backend's
    ;; loop-constant hoist keep the block shape they require.
    (unless
      (and
        (not straighten-fallthrough-changed)
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view straighten-fallthrough-blocks)
          (ir.compiler-ir-label "sk-pre")))
      (return 67))
    ;; Switch edges: the default and the first case thread to their own
    ;; destinations, the second case is refused because the first already
    ;; claimed that destination, and its block therefore stays.
    (unless
      (and
        straighten-switch-changed
        (= (ir.compiler-ir-block-list-count straighten-switch-blocks) 4)
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-switch-blocks)
            (ir.compiler-ir-label "ss-a")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view straighten-switch-blocks)
            (ir.compiler-ir-label "ss-d")))
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view straighten-switch-blocks)
          (ir.compiler-ir-label "ss-b"))
        (opt.opt-verify-ok?
          (& (opt.opt-verify-function (& straighten-switch-function)))))
      (return 68))
    ;; D1: a merge holding three phis threads on the bool phi's constant
    ;; edges. Each redirected predecessor takes over the value the successor
    ;; phi carried for the merge, resolved through the merge's own phi for
    ;; that edge -- `tp-a` brings `10` into `tp-yes` and `tp-b` brings `21`
    ;; into `tp-no` -- and the merge, having lost both predecessors, is gone.
    (unless
      (and
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-multi-phi-blocks)
            (ir.compiler-ir-label "tp-merge")))
        (opt-thread-first-phi-input-i64?
          thread-multi-phi-blocks
          (ir.compiler-ir-label "tp-yes")
          (ir.compiler-ir-label "tp-a")
          10)
        (opt-thread-first-phi-input-i64?
          thread-multi-phi-blocks
          (ir.compiler-ir-label "tp-no")
          (ir.compiler-ir-label "tp-b")
          21)
        (opt-thread-first-phi-input-i64?
          thread-multi-phi-blocks
          (ir.compiler-ir-label "tp-yes")
          (ir.compiler-ir-label "tp-alt")
          30)
        (not
          (opt-thread-first-phi-has-input?
            thread-multi-phi-blocks
            (ir.compiler-ir-label "tp-yes")
            (ir.compiler-ir-label "tp-merge")))
        (opt-thread-pass-verified? thread-multi-phi-blocks))
      (return 69))
    ;; D1 rail, widened by T2-5: `%4` is read by an ordinary instruction in
    ;; `tv-yes`, which is entered only from the merge and dominates every
    ;; reader, so the merge's definition still reaches them on every path
    ;; INTO `tv-yes` -- as long as no edge is threaded past the merge into
    ;; that side. `tv-a` carries the `true` that would do exactly that and is
    ;; refused; `tv-b` carries `false`, whose side reads nothing the merge
    ;; defines, and threads. The merge survives holding `tv-a`.
    (unless
      (and
        thread-live-out-changed
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-live-out-blocks)
          (ir.compiler-ir-label "tv-merge"))
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-live-out-blocks)
            (ir.compiler-ir-label "tv-merge"))
          1)
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-live-out-blocks)
            (ir.compiler-ir-label "tv-no"))
          2)
        (opt-thread-pass-verified? thread-live-out-blocks))
      (return 70))
    ;; D1: a non-constant edge is untouched. `tx-a` decides the branch and
    ;; threads; `tx-b` carries a parameter, so the merge stays and keeps it.
    (unless
      (and
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-mixed-edge-blocks)
          (ir.compiler-ir-label "tx-merge"))
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-mixed-edge-blocks)
            (ir.compiler-ir-label "tx-merge"))
          1)
        (opt-thread-first-phi-input-i64?
          thread-mixed-edge-blocks
          (ir.compiler-ir-label "tx-yes")
          (ir.compiler-ir-label "tx-a")
          10)
        (opt-thread-first-phi-has-input?
          thread-mixed-edge-blocks
          (ir.compiler-ir-label "tx-yes")
          (ir.compiler-ir-label "tx-merge"))
        (opt-thread-pass-verified? thread-mixed-edge-blocks))
      (return 71))
    ;; D2: the branch reads a comparison over the merge's own `i64` phi.
    ;; `5 >= 0` decides `tq-a` and `-1 >= 0` decides `tq-b`; both are
    ;; redirected, `tq-a` carrying the `5` the successor phi asked for.
    ;; `tq-c` and `tq-d` never decide, so the merge survives holding exactly
    ;; those two.
    (unless
      (and
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-compare-blocks)
          (ir.compiler-ir-label "tq-merge"))
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-compare-blocks)
            (ir.compiler-ir-label "tq-merge"))
          2)
        (opt-thread-first-phi-input-i64?
          thread-compare-blocks
          (ir.compiler-ir-label "tq-yes")
          (ir.compiler-ir-label "tq-a")
          5)
        (opt-thread-first-phi-input-i64?
          thread-compare-blocks
          (ir.compiler-ir-label "tq-no")
          (ir.compiler-ir-label "tq-b")
          41)
        (opt-thread-first-phi-has-input?
          thread-compare-blocks
          (ir.compiler-ir-label "tq-yes")
          (ir.compiler-ir-label "tq-merge"))
        (opt-thread-cmp-verified? thread-compare-blocks))
      (return 72))
    ;; JT-1: the same shape with an equality comparison, `eq %5, 5`. `tq-a`
    ;; carries the `5` that decides it true and `tq-b` the `-1` that decides
    ;; it false, so both are redirected exactly as under `ge`, and the merge
    ;; again survives holding `tq-c` and `tq-d`.
    (unless
      (and
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-compare-eq-blocks)
          (ir.compiler-ir-label "tq-merge"))
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-compare-eq-blocks)
            (ir.compiler-ir-label "tq-merge"))
          2)
        (opt-thread-first-phi-input-i64?
          thread-compare-eq-blocks
          (ir.compiler-ir-label "tq-yes")
          (ir.compiler-ir-label "tq-a")
          5)
        (opt-thread-first-phi-input-i64?
          thread-compare-eq-blocks
          (ir.compiler-ir-label "tq-no")
          (ir.compiler-ir-label "tq-b")
          41)
        (opt-thread-cmp-verified? thread-compare-eq-blocks))
      (return 73))
    ;; D3: the condition phi has a second reader -- `td-yes`'s phi on the
    ;; merge edge. The old single-use gate refused the block outright; the
    ;; live-out rule admits it and the repair hands `td-a` the `true` the
    ;; condition phi carried for that edge.
    (unless
      (and
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-multi-use-blocks)
            (ir.compiler-ir-label "td-merge")))
        (opt-thread-first-phi-input-bool?
          thread-multi-use-blocks
          (ir.compiler-ir-label "td-yes")
          (ir.compiler-ir-label "td-a")
          true)
        (opt-thread-first-phi-input-bool?
          thread-multi-use-blocks
          (ir.compiler-ir-label "td-yes")
          (ir.compiler-ir-label "td-alt")
          false)
        (opt-thread-pass-verified? thread-multi-use-blocks)
        ;; A further round then decides `td-yes` itself on the edge the
        ;; repair rewrote: `td-a` leaves it for `td-y1` directly, while
        ;; `td-alt` keeps its conditional edge and the block stays.
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-multi-use-settled-blocks)
            (ir.compiler-ir-label "td-yes"))
          0)
        (opt-thread-pass-verified? thread-multi-use-settled-blocks))
      (return 74))
    ;; D3: six decided predecessors, `opt-thread-pred-budget` of them per
    ;; round. One round leaves two behind, two rounds finish the block, and
    ;; the production fuel converges.
    (unless
      (and
        (opt-block-list-has-label?
          (ir.compiler-ir-block-list-view thread-wide-one-round-blocks)
          (ir.compiler-ir-label "tk-merge"))
        (=
          (opt-count-jump-to-blocks
            (ir.compiler-ir-block-list-view thread-wide-one-round-blocks)
            (ir.compiler-ir-label "tk-merge"))
          2)
        (opt-thread-pass-verified? thread-wide-one-round-blocks)
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-wide-two-round-blocks)
            (ir.compiler-ir-label "tk-merge")))
        (not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view thread-wide-blocks)
            (ir.compiler-ir-label "tk-merge")))
        (opt-thread-pass-verified? thread-wide-blocks))
      (return 75))
    ;; Fuel: at the production round cap the pass reaches a fixpoint -- a
    ;; second run over its own output finds nothing left to thread, for the
    ;; multi-round wide merge and for both widened shapes.
    (unless
      (and
        (not thread-wide-settled?)
        (not thread-multi-phi-settled?)
        (not thread-compare-settled?))
      (return 76))
    42))

(define (compiler-optimize-fixed-point-self-test) : i64
  (let
    [func : ir.CompilerIrFunction (opt-test-function (opt-fixed-point-instrs))]
    [once : ir.CompilerIrFunction
      (opt.optimize-function-once-with-summaries
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        func
        (opt.opt-program-summaries-empty))]
    [fixed : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        func)]
    [once-instrs : ir.CompilerIrInstrSeq (opt-function-first-instrs once)]
    [fixed-instrs : ir.CompilerIrInstrSeq (opt-function-first-instrs fixed)]
    [optimized-program : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt-test-program (opt-fixed-point-instrs))
        3)]
    [again-program : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt.compiler-opt-global-shared-view optimized-program)
        3)]
    (cond
      [(not (= (ir.compiler-ir-instr-seq-count once-instrs) 4)) 1]
      [(not (= (opt-count-arith-instr-seq once-instrs) 3)) 2]
      [(not (= (ir.compiler-ir-instr-seq-count fixed-instrs) 3)) 3]
      [(not (= (opt-count-arith-instr-seq fixed-instrs) 2)) 4]
      [(not
          (opt-test-program-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            optimized-program
            again-program))
        5]
      [else 42])))

;; --- implicit scratch-region self-tests -------------------------------------
(define (opt-scratch-test-alloc) : ir.CompilerIrInstr
  (Call 1 cbi.compiler-builtin-id-tl-alloc (One (I64 32)) (U64)))

(define (opt-scratch-test-ir-alloc) : ir.CompilerIrInstr
  (Alloc 1 (I64)))

(define (opt-scratch-test-return-zero) : ir.CompilerIrInstr
  (irt.instr "return 0"))

(define (opt-scratch-test-one-block [middle : ir.CompilerIrInstr]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-test-alloc)
    middle
    (opt-scratch-test-return-zero)))

(define (opt-scratch-positive-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-test-alloc)
    (irt.instr "%2 = gep %1, 0 : u64")
    (irt.instr "store_ptr %2, 7 : u64")
    (ir.CompilerIrInstr.Load 3 (Var 2) (U64))
    (opt-scratch-test-return-zero)))

(define (opt-scratch-loop-candidate-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs
        (opt-scratch-test-alloc)
        (irt.instr "branch true, body, exit")))
    (irt.block "body:
             jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs (opt-scratch-test-return-zero)))))

(define (opt-scratch-loop-list-has-candidate?
  [loops : (& loops (Slice opt.OptNaturalLoop))]) : bool
  (match loops
    [(slice) false]
    [(slice loop & rest)
      (or
        (opt-scratch-report-candidate?
          (let
            [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
            [blocks (opt.opt-natural-loop-body-blocks loop)]
            (opt.opt-scratch-scope-report-blocks type-segment-bases blocks))
          1
          32)
        (opt-scratch-loop-list-has-candidate? rest))]))

(define (opt-scratch-reset-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "scratch_reset_test")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    10
    blocks
    Ordinary))

(define (opt-scratch-reset-header-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "branch true, body, exit"))

(define (opt-scratch-reset-body-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-test-ir-alloc)
    (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))

(define (opt-scratch-reset-unknown-alloc) : ir.CompilerIrInstr
  (Call 1 cbi.compiler-builtin-id-tl-alloc (One (Var 0)) (U64)))

(define (opt-scratch-reset-unknown-body-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-reset-unknown-alloc)
    (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))

(define (opt-scratch-reset-blocks-with-body
  [body-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         jump preheader")
    (irt.block "preheader:
           jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-scratch-reset-header-instrs))
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "body") body-instrs)
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs (opt-scratch-test-return-zero)))))

(define (opt-scratch-reset-positive-blocks) : ir.CompilerIrBlockList
  (opt-scratch-reset-blocks-with-body (opt-scratch-reset-body-instrs)))

(define (opt-scratch-reset-level-blocks) : ir.CompilerIrBlockList
  (opt-scratch-reset-blocks-with-body (opt-scratch-reset-unknown-body-instrs)))

(define (opt-scratch-reset-level-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "main")
    (irt.params "n=%0:i64")
    (I64)
    10
    (opt-scratch-reset-level-blocks)
    Ordinary))

(define (opt-scratch-reset-level-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (opt-scratch-reset-level-function))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)))

(define (opt-scratch-reset-call-blocked-blocks) : ir.CompilerIrBlockList
  (opt-scratch-reset-blocks-with-body
    (opt-test-instrs
      (opt-scratch-test-ir-alloc)
      (irt.instr "%2 = call touch() : unit")
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop")))))

(define (opt-scratch-reset-header-alloc-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         jump preheader")
    (irt.block "preheader:
           jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs-with-tail
        (opt-scratch-reset-header-instrs)
        (opt-scratch-test-ir-alloc)))
    (irt.block "body:
               jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs (opt-scratch-test-return-zero)))))

(define (opt-scratch-reset-early-exit-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         jump preheader")
    (irt.block "preheader:
           jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-scratch-reset-header-instrs))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs
        (opt-scratch-test-ir-alloc)
        (irt.instr "branch true, ret, latch")))
    (irt.block "latch:
                 jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "ret")
      (opt-test-instrs (opt-scratch-test-return-zero)))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs (opt-scratch-test-return-zero)))))

(define (opt-scratch-reset-rewrite [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt-scratch-reset-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-scratch-reset-test-function blocks)))

(define (opt-scratch-reset-call-count
  [func : (& func ir.CompilerIrFunction)]
  [name : String]) : i64
  (let
    [blocks (opt.opt-function-blocks func)]
    (opt-count-direct-call-name-blocks
      (ir.compiler-ir-block-list-view blocks)
      name)))

(define (opt-scratch-reset-level-program-call-count
  [level : i64]
  [name : String]) : i64
  (match (opt-test-optimize-program-with-level
    (opt-scratch-reset-level-program)
    level)
    [(Program _ functions _)
      (match (opt-function-seq-find functions "main")
        [(No) (- 0 1)]
        [(Some func) (opt-scratch-reset-call-count func name)])]))

(define (opt-scratch-reset-emitted? [func : (& func ir.CompilerIrFunction)]) : bool
  (and
    (=
      (let
        [func-2 (owned_view.compiler-owned-reference-shared-view func)]
        (opt-scratch-reset-call-count func-2 "tl_region_mark"))
      1)
    (=
      (let
        [func-2 (owned_view.compiler-owned-reference-shared-view func)]
        (opt-scratch-reset-call-count func-2 "tl_region_reset"))
      1)))

(define (opt-scratch-reset-not-emitted? [func : ir.CompilerIrFunction]) : bool
  (and
    (= (opt-scratch-reset-call-count func "tl_region_mark") 0)
    (= (opt-scratch-reset-call-count func "tl_region_reset") 0)))

(define (opt-scratch-reset-runtime-ids-canonical?) : bool
  (match (opt.opt-scratch-reset-mark-instr 10)
    [(Call _ mark-id _ _)
      (match (opt.opt-scratch-reset-reset-instr 11 10)
        [(Call _ reset-id _ _)
          (and
            (= mark-id cbi.compiler-builtin-id-tl-region-mark)
            (= reset-id cbi.compiler-builtin-id-tl-region-reset))]
        [_ false])]
    [_ false]))

(define (compiler-optimize-scratch-region-self-test) : i64
  (cbi.compiler-builtin-initialize-for-parse!)
  (let
    [positive : opt.OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-scratch-positive-instrs))]
    [loop-positive : bool
      (let
        [natural-loops
          (let
            [blocks (opt-scratch-loop-candidate-blocks)]
            (opt.opt-cfg-natural-loops blocks))]
        (opt-scratch-loop-list-has-candidate?
          (opt_natural_loop_vec.view natural-loops)))]
    [call-blocked : opt.OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-scratch-test-one-block
          (Call 9 (opt-test-symbol "touch") (Nil) (Unit))))]
    [extern-blocked : opt.OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-scratch-test-one-block
          (CallIndirectC 9 (Function (opt-test-symbol "ffi_touch")) (Nil) (I64))))]
    [raw-blocked : opt.OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-scratch-test-one-block (AddrOf 2 1)))]
    ;; The scratch analysis records its roots with `opt-alias-mark-unique`, so
    ;; the fixture builds the fact the same way instead of hand-encoding it.
    [store-blocked : opt.OptScratchScopeReport
      (let
        [roots : opt.OptScratchRootList
          (opt.opt-scratch-root-list-add (opt.opt-scratch-root-list-new) 1)]
        (Report
          1
          32
          (let
            [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
            [facts (opt.opt-alias-mark-unique (& (opt.opt-alias-empty)) 1 0)]
            [instr (irt.instr "store_ptr %99, %1 : u64")]
            (opt.opt-scratch-blocker-reason
              type-segment-bases
              (& roots)
              (& facts)
              instr))))]
    [arena-blocked : opt.OptScratchScopeReport
      (opt-scratch-scope-report-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-scratch-test-one-block
          (Call 9 cbi.compiler-builtin-id-tl-region-mark (Nil) (I64))))]
    [return-blocked : opt.OptScratchScopeReport
      (let
        [roots : opt.OptScratchRootList
          (opt.opt-scratch-root-list-add (opt.opt-scratch-root-list-new) 1)]
        (Report
          1
          32
          (let
            [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
            [facts (opt.opt-alias-mark-unique (& (opt.opt-alias-empty)) 1 0)]
            [instr (irt.instr "return %1")]
            (opt.opt-scratch-blocker-reason
              type-segment-bases
              (& roots)
              (& facts)
              instr))))]
    [reset-positive : ir.CompilerIrFunction
      (opt-scratch-reset-rewrite (opt-scratch-reset-positive-blocks))]
    [reset-call-blocked : ir.CompilerIrFunction
      (opt-scratch-reset-rewrite (opt-scratch-reset-call-blocked-blocks))]
    [reset-header-alloc : ir.CompilerIrFunction
      (opt-scratch-reset-rewrite (opt-scratch-reset-header-alloc-blocks))]
    [reset-early-exit : ir.CompilerIrFunction
      (opt-scratch-reset-rewrite (opt-scratch-reset-early-exit-blocks))]
    [reset-pre-ssa : ir.CompilerIrFunction
      (match (opt-scratch-reset-pre-ssa-function-with-context-result
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-scratch-reset-level-function))
        [(Result f _) f])]
    [level0-mark-count : i64
      (opt-scratch-reset-level-program-call-count 0 "tl_region_mark")]
    [level0-reset-count : i64
      (opt-scratch-reset-level-program-call-count 0 "tl_region_reset")]
    [level1-mark-count : i64
      (opt-scratch-reset-level-program-call-count 1 "tl_region_mark")]
    [level1-reset-count : i64
      (opt-scratch-reset-level-program-call-count 1 "tl_region_reset")]
    [level2-mark-count : i64
      (opt-scratch-reset-level-program-call-count 2 "tl_region_mark")]
    [level2-reset-count : i64
      (opt-scratch-reset-level-program-call-count 2 "tl_region_reset")]
    (cond
      [(not (opt-scratch-report-candidate? positive 1 32)) 1]
      [(not loop-positive) 2]
      [(not
          (opt-scratch-report-blocked?
            (ast.ast-node-pool-reader-type-segment-bases)
            call-blocked
            1
            32
            "call"))
        3]
      [(not
          (opt-scratch-report-blocked?
            (ast.ast-node-pool-reader-type-segment-bases)
            extern-blocked
            1
            32
            "extern_call"))
        4]
      [(not
          (opt-scratch-report-blocked?
            (ast.ast-node-pool-reader-type-segment-bases)
            raw-blocked
            1
            32
            "raw_pointer"))
        5]
      [(not
          (opt-scratch-report-blocked?
            (ast.ast-node-pool-reader-type-segment-bases)
            store-blocked
            1
            32
            "store_outer"))
        6]
      [(not
          (opt-scratch-report-blocked?
            (ast.ast-node-pool-reader-type-segment-bases)
            arena-blocked
            1
            32
            "arena_helper"))
        7]
      [(not
          (opt-scratch-report-blocked?
            (ast.ast-node-pool-reader-type-segment-bases)
            return-blocked
            1
            32
            "return_escape"))
        8]
      [(not (opt-scratch-reset-emitted? reset-positive)) 9]
      [(not (= (opt.opt-function-frame reset-positive) 12)) 10]
      [(not (opt-scratch-reset-not-emitted? reset-call-blocked)) 11]
      [(not (opt-scratch-reset-not-emitted? reset-header-alloc)) 12]
      [(not (opt-scratch-reset-not-emitted? reset-early-exit)) 13]
      [(not (opt-scratch-reset-emitted? reset-pre-ssa)) 14]
      [(not (= level0-mark-count 0)) 15]
      [(not (= level0-reset-count 0)) 16]
      [(not (= level1-mark-count 0)) 17]
      [(not (= level1-reset-count 0)) 18]
      [(not (= level2-mark-count 1)) 19]
      [(not (= level2-reset-count 1)) 20]
      [(not (opt-scratch-reset-runtime-ids-canonical?)) 21]
      [else 42])))

;; --- noalias fact model self-test -------------------------------------------
(define (opt-alias-test-unique-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 8 : i64
     %2 = add 1, 2 : i64"))

(define (opt-alias-test-transitive-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 8 : i64
     %2 = gep %1, 8 : i64"))

(define (opt-alias-test-load-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = alloc i64
     %1 = load %0 : i64"))

(define (opt-alias-test-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = alloc i64
     store_ptr %0, 5 : i64"))

(define (opt-alias-test-call-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = alloc i64
     %9 = call tl_noop() : i64"))

(define (opt-alias-test-copy-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = alloc i64
     %1 = mov %0 : i64
     %2 = mov 7 : i64"))

(define (opt-alias-join-facts-a) : opt.OptAliasFacts
  (opt.opt-alias-bind
    (opt.opt-alias-bind
      (opt.opt-alias-bind (opt.opt-alias-empty) 0 (Unique 0))
      1
      (Derived 0))
    2
    (MayAlias)))

(define (opt-alias-join-facts-b) : opt.OptAliasFacts
  (opt.opt-alias-bind
    (opt.opt-alias-bind
      (opt.opt-alias-bind (opt.opt-alias-empty) 0 (Unique 0))
      1
      (MayAlias))
    3
    (Unique 0)))

(define (opt-alias-sample-store) : ir.CompilerIrInstr
  (irt.instr "store_ptr %0, 5 : i64"))

(define (opt-alias-sample-tail-call) : ir.CompilerIrInstr
  (irt.instr "tailcall tl_noop() : i64"))

(define (opt-alias-sample-binop) : ir.CompilerIrInstr
  (irt.instr "%9 = add 1, 2 : i64"))

(define (compiler-optimize-alias-self-test) : i64
  (let
    [unique : opt.OptAliasFacts
      (opt-alias-run (opt.opt-alias-empty) (opt-alias-test-unique-instrs))]
    [transitive : opt.OptAliasFacts
      (opt-alias-run (opt.opt-alias-empty) (opt-alias-test-transitive-instrs))]
    [loaded : opt.OptAliasFacts
      (opt-alias-run (opt.opt-alias-empty) (opt-alias-test-load-instrs))]
    [stored : opt.OptAliasFacts
      (opt-alias-run (opt.opt-alias-empty) (opt-alias-test-store-instrs))]
    [called : opt.OptAliasFacts
      (opt-alias-run (opt.opt-alias-empty) (opt-alias-test-call-instrs))]
    [copied : opt.OptAliasFacts
      (opt-alias-run (opt.opt-alias-empty) (opt-alias-test-copy-instrs))]
    [joined : opt.OptAliasFacts
      (opt.opt-alias-intersect
        (& (opt-alias-join-facts-a))
        (& (opt-alias-join-facts-b)))]
    [invalidated : opt.OptAliasFacts
      (opt-alias-mark-invalidated
        (opt.opt-alias-mark-unique (& (opt.opt-alias-empty)) 0 0)
        0)]
    [seeded : opt.OptAliasFacts
      (opt.opt-alias-seed-params
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-load-cse-mixed-ref-params)))]
    (cond
      [(not (opt-alias-contains? unique 0 (Unique 0))) 1]
      [(not (opt-alias-contains? unique 1 (Derived 0))) 2]
      [(not (opt-alias-absent? unique 2)) 3]
      [(not (= (opt-alias-facts-len unique) 2)) 4]
      [(not (opt-alias-contains? transitive 2 (Derived 0))) 5]
      [(not (opt-alias-contains? loaded 0 (Unique 0))) 6]
      [(not (opt-alias-contains? loaded 1 (MayAlias))) 7]
      [(not (= (opt-alias-facts-len stored) 0)) 8]
      [(not (opt.opt-alias-instr-clears-all? (& (opt-alias-sample-store)))) 9]
      [(not (= (opt-alias-facts-len called) 0)) 10]
      [(not (opt.opt-alias-instr-clears-all? (& (opt-alias-sample-tail-call))))
        11]
      [(not (opt-alias-contains? copied 1 (Derived 0))) 12]
      [(not (opt-alias-contains? copied 2 (MayAlias))) 13]
      [(not (= (opt-alias-facts-len joined) 1)) 14]
      [(not (opt-alias-contains? joined 0 (Unique 0))) 15]
      [(opt-alias-contains? joined 1 (Derived 0)) 16]
      [(opt.opt-alias-instr-clears-all? (& (opt-alias-sample-binop))) 17]
      [(not (opt-alias-contains? invalidated 0 (Invalidated))) 18]
      [(not (opt-alias-contains? seeded 0 (SharedRef))) 19]
      [(not (opt-alias-contains? seeded 1 (ExclusiveRef))) 20]
      ;; Allocation epochs survive the packed encoding, distinguish otherwise
      ;; identical Unique roots, and the retired -1 code stays conservative.
      [(not
          (opt-alias-kind-eq
            (opt.opt-alias-kind-decode (opt.opt-alias-kind-encode (Unique 7)))
            (Unique 7)))
        21]
      [(opt-alias-kind-eq (Unique 0) (Unique 1)) 22]
      [(not (opt-alias-kind-eq (opt.opt-alias-kind-decode -1) (Invalidated)))
        23]
      [else 42])))

(define (opt-load-cse-run [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-load-cse-instrs
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt.opt-load-header-set-empty)
    (opt-load-cse-empty-state-for-size
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (ir.compiler-ir-instr-seq-count instrs))
    instrs))

;; Run with header-typed handle params (vars 0 and 1 are (__tl_dyn-array i64)
;; descriptors) so the descriptor/element granularity rules can be exercised.
(define (opt-load-cse-run-with-array-param [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-load-cse-instrs
    (ast.ast-node-pool-reader-type-segment-bases)
    (let
      [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
      [params
        (irt.params "xs=%0:(__tl_dyn-array i64), ys=%1:(__tl_dyn-array i64)")]
      [blocks
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "entry")
            (opt.compiler-opt-global-shared-view instrs)))]
      (opt.opt-load-header-set-from-function
        type-segment-bases
        (& params)
        blocks))
    (opt-load-cse-empty-state-for-size
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (ir.compiler-ir-instr-seq-count instrs))
    instrs))

(define (opt-load-cse-run-with-params
  [params : ir.CompilerIrParamSeq]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-load-cse-instrs
    (ast.ast-node-pool-reader-type-segment-bases)
    (let
      [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
      [blocks
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "entry")
            (opt.compiler-opt-global-shared-view instrs)))]
      (opt.opt-load-header-set-from-function
        type-segment-bases
        (& params)
        blocks))
    (opt.opt-load-cse-state-with-caps-and-facts
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (opt.opt-load-cse-table-cap-for-size
        (ir.compiler-ir-instr-seq-count instrs))
      (opt.opt-load-cse-kinds-cap-for-size
        (ir.compiler-ir-instr-seq-count instrs))
      (opt.opt-alias-seed-params
        (ast.ast-node-pool-reader-type-segment-bases)
        (& params)))
    instrs))

;; Drive the fused block-local load/copy traversal used by
;; opt-test-optimize-block. This also exercises the native-Slice Word facts that
;; intentionally do not belong to the standalone load-CSE helper above.
(define (opt-load-copy-run-with-params
  [params : ir.CompilerIrParamSeq]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [type-segment-bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (opt.compiler-opt-global-shared-view instrs)))]
    [_addr-taken : unit
      (opt.opt-function-addr-taken-install!
        (opt-test-addr-of-bound (ir.compiler-ir-block-list-view blocks))
        (& blocks))]
    [hs : opt.OptLoadHeaderSet
      (opt.opt-load-header-set-from-function
        type-segment-bases
        (& params)
        blocks)]
    [seq : ir.CompilerIrInstrSeq instrs]
    [words : opt.OptExprTable (opt.opt-expr-table-new)]
    (opt.opt-load-copy-instr-seq-rewrite!
      type-segment-bases
      hs
      (opt.opt-load-cse-state-with-caps-and-facts
        (profile_state.compiler-profile-state-metrics
          (profile_state.compiler-profile-state-new))
        (opt.opt-load-cse-table-cap-for-size
          (ir.compiler-ir-instr-seq-count seq))
        (opt.opt-load-cse-kinds-cap-for-size
          (ir.compiler-ir-instr-seq-count seq))
        (opt.opt-alias-seed-params type-segment-bases (& params)))
      (&mut words)
      (opt.compiler-opt-global-shared-view seq))
    seq))

(define (opt-load-cse-run-with-params-and-call-memory
  [params : ir.CompilerIrParamSeq]
  [call-memory : opt_i64_i64_map.Map]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-load-cse-instrs-from
    (ast.ast-node-pool-reader-type-segment-bases)
    (let
      [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
      [blocks
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "entry")
            (opt.compiler-opt-global-shared-view instrs)))]
      (opt.opt-load-header-set-from-function
        type-segment-bases
        (& params)
        blocks))
    (opt.opt-value-sources-new)
    call-memory
    (opt.opt-load-cse-state-with-caps-and-facts
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (opt.opt-load-cse-table-cap-for-size
        (ir.compiler-ir-instr-seq-count instrs))
      (opt.opt-load-cse-kinds-cap-for-size
        (ir.compiler-ir-instr-seq-count instrs))
      (opt.opt-alias-seed-params
        (ast.ast-node-pool-reader-type-segment-bases)
        (& params)))
    instrs))

(define (opt-load-cse-mixed-ref-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "read" (ast.ast-ty-ref 0 (& (I64))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "write" (ast.ast-ty-mut-ref 0 (& (I64))) 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-load-cse-shared-ref-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "left" (ast.ast-ty-ref 0 (& (I64))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "right" (ast.ast-ty-ref 0 (& (I64))) 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-load-cse-exclusive-ref-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "left" (ast.ast-ty-mut-ref 0 (& (I64))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "right" (ast.ast-ty-mut-ref 0 (& (I64))) 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-load-cse-descriptor-ref-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "xs" (ast.ast-ty-mut-ref 0 (& (ast.ast-ty-dyn-array (& (I64))))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "write" (ast.ast-ty-mut-ref 0 (& (I64))) 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-load-cse-slice-distinct-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "read" (ast.ast-ty-ref 0 (& (ast.ast-ty-slice (& (I64))))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "write" (ast.ast-ty-mut-ref 0 (& (ast.ast-ty-slice (& (I64))))) 1)
      (ir.compiler-ir-param-seq-prepend
        (Param "index" (I64) 20)
        (ir.compiler-ir-param-seq-empty)))))

(define (opt-load-cse-slice-exclusive-param) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "values" (ast.ast-ty-mut-ref 0 (& (ast.ast-ty-slice (& (I64))))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "index" (I64) 20)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-load-cse-group-param) : ir.CompilerIrParamSeq
  (irt.params "descriptor=%0:(__tl_dyn-array i64)"))

(define (opt-dead-store-run-with-array-param [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-dead-store-instr-seq
    (ast.ast-node-pool-reader-type-segment-bases)
    (let
      [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
      [params
        (irt.params "xs=%0:(__tl_dyn-array i64), ys=%1:(__tl_dyn-array i64)")]
      [blocks
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "entry")
            (opt.compiler-opt-global-shared-view instrs)))]
      (opt.opt-load-header-set-from-function
        type-segment-bases
        (& params)
        blocks))
    instrs))

(define (opt-count-mov-dst-i64-src-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [src : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Mov mov-dst mov-src _)
          (if (= mov-dst dst)
            (match mov-src
              [(I64 value)
                (if (= value src)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-mov-dst-i64-src-from instrs (+ index 1) dst src))))

(define (opt-count-mov-dst-i64-src
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [src : i64]) : i64
  (opt-count-mov-dst-i64-src-from instrs 0 dst src))

(define (opt-count-mov-dst-var-src-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [src : i64]
  [ty : ast.AstType]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Mov mov-dst mov-src mov-ty)
          (if (and
            (= mov-dst dst)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              mov-ty
              (& ty)))
            (match mov-src
              [(Var value)
                (if (= value src)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-mov-dst-var-src-from instrs (+ index 1) dst src ty))))

(define (opt-count-mov-dst-var-src
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [src : i64]
  [ty : ast.AstType]) : i64
  (opt-count-mov-dst-var-src-from instrs 0 dst src ty))

(define (opt-count-mov-dst-bool-src-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [src : bool]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Mov mov-dst mov-src mov-ty)
          (if (and
            (= mov-dst dst)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              mov-ty
              (& (Bool))))
            (match mov-src
              [(Bool value)
                (if (= value src)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-mov-dst-bool-src-from instrs (+ index 1) dst src))))

(define (opt-count-mov-dst-bool-src
  [instrs : ir.CompilerIrInstrSeq]
  [dst : i64]
  [src : bool]) : i64
  (opt-count-mov-dst-bool-src-from instrs 0 dst src))

(define (opt-count-storeptr-instrs-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(StorePtr _ _ _) 1]
        [_ 0])
      (opt-count-storeptr-instrs-from instrs (+ index 1)))))

(define (opt-count-storeptr-instrs [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-storeptr-instrs-from instrs 0))

(define (opt-count-storeptr-i64-value-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [want : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(StorePtr _ value ty)
          (if (opt.opt-type-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            ty
            (& (I64)))
            (match value
              [(I64 actual)
                (if (= actual want)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-storeptr-i64-value-from instrs (+ index 1) want))))

(define (opt-count-storeptr-i64-value
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [want : i64]) : i64
  (opt-count-storeptr-i64-value-from instrs 0 want))

(define (opt-dead-store-overwritten-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     store_ptr %2, 1 : i64
     store_ptr %2, 2 : i64"))

(define (opt-dead-store-load-blocked-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     store_ptr %2, 1 : i64
     %3 = load %2 : i64
     store_ptr %2, 2 : i64"))

(define (opt-dead-store-disjoint-field-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     %3 = gep %0, 2 : i64
     store_ptr %2, 1 : i64
     store_ptr %3, 9 : i64
     store_ptr %2, 2 : i64"))

(define (opt-dead-store-call-blocked-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     store_ptr %2, 1 : i64
     %4 = call touch() : i64
     store_ptr %2, 2 : i64"))

(define (compiler-optimize-dead-store-self-test) : i64
  (let
    [overwritten : ir.CompilerIrInstrSeq
      (opt-dead-store-run-with-array-param (opt-dead-store-overwritten-instrs))]
    [load-blocked : ir.CompilerIrInstrSeq
      (opt-dead-store-run-with-array-param (opt-dead-store-load-blocked-instrs))]
    [disjoint-field : ir.CompilerIrInstrSeq
      (opt-dead-store-run-with-array-param
        (opt-dead-store-disjoint-field-instrs))]
    [call-blocked : ir.CompilerIrInstrSeq
      (opt-dead-store-run-with-array-param (opt-dead-store-call-blocked-instrs))]
    [pipeline : ir.CompilerIrBlock
      (opt-test-optimize-block
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (Block
          (ir.compiler-ir-label "entry")
          (opt-dead-store-overwritten-instrs)))]
    [pipeline-instrs : ir.CompilerIrInstrSeq
      (match pipeline
        [(Block _ instrs) instrs])]
    (cond
      [(not (= (opt-count-storeptr-instrs overwritten) 1)) 1]
      [(not (= (opt-count-storeptr-i64-value overwritten 2) 1)) 2]
      [(not (= (opt-count-storeptr-i64-value overwritten 1) 0)) 3]
      [(not (= (opt-count-storeptr-instrs load-blocked) 2)) 4]
      [(not (= (opt-count-load-instr-seq load-blocked) 1)) 5]
      [(not (= (opt-count-storeptr-instrs disjoint-field) 2)) 6]
      [(not (= (opt-count-storeptr-i64-value disjoint-field 9) 1)) 7]
      [(not (= (opt-count-storeptr-i64-value disjoint-field 2) 1)) 8]
      [(not (= (opt-count-storeptr-instrs call-blocked) 2)) 9]
      [(not (= (opt-count-storeptr-instrs pipeline-instrs) 1)) 10]
      [else 42])))

(define (opt-load-cse-positive-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     %4 = add 1, 2 : i64
     %3 = load %1 : i64"))

(define (opt-load-cse-barrier-instrs [barrier : ir.CompilerIrInstr]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Alloc 0 (I64))
    (irt.instr "%1 = gep %0, 0 : i64")
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    barrier
    (ir.CompilerIrInstr.Load 3 (Var 1) (I64))))

(define (opt-load-cse-address-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     %1 = mov 7 : i64
     %3 = load %1 : i64"))

(define (opt-load-cse-result-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     %2 = mov 7 : i64
     %3 = load %1 : i64"))

(define (opt-load-cse-type-mismatch-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     %3 = load %1 : bool"))

(define (opt-load-cse-different-address-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %4 = gep %0, 8 : i64
     %2 = load %1 : i64
     %3 = load %4 : i64"))

(define (opt-load-cse-vector-data-pointer-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = load %0 : u64
     %4 = vector_load %2, %1 lanes 4 : i64
     %3 = load %0 : u64
     %5 = vector_load %3, %1 lanes 4 : i64"))

(define (opt-load-cse-barrier-blocked? [barrier : ir.CompilerIrInstr]) : bool
  (let
    [optimized : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-barrier-instrs barrier))]
    (and
      (= (opt-count-load-instr-seq optimized) 2)
      (= (opt-count-mov-dst-instr-seq optimized 3) 0))))

;; GAP4: store-to-load forwarding -- the load after the store becomes a Mov of
;; the stored literal (and the pre-store entry is provably dropped: the Mov's
;; source is 9, not var 2).
(define (opt-load-cse-store-forward-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     store_ptr %1, 9 : i64
     %3 = load %1 : i64"))

;; Sub-word constant stores forward only after normalizing to the load type.
(define (opt-load-cse-subword-const-forward-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i32
     store_ptr %1, 7 : i32
     %2 = load %1 : i32
     %3 = gep %0, 4 : bool
     store_ptr %3, true : bool
     %4 = load %3 : bool"))

;; A value read by a same-type sub-word load is canonical and can be forwarded.
(define (opt-load-cse-subword-load-forward-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i32
     %2 = load %1 : i32
     store_ptr %1, %2 : i32
     %3 = load %1 : i32"))

;; Arbitrary sub-word vars are still not known canonical and must reload.
(define (opt-load-cse-subword-unknown-var-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i32
     store_ptr %1, %9 : i32
     %2 = load %1 : i32"))

;; GAP4: canonical keys -- two DISTINCT gep temps of the same (base, offset)
;; slot must CSE (the audit's bounds-chain miss shape).
(define (opt-load-cse-canonical-gep-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     %3 = gep %0, 0 : i64
     %4 = load %3 : i64"))

;; GAP4: an ELEMENT store (through the loaded data pointer) must keep
;; descriptor-field entries; the re-load through a FRESH len gep still hits.
;; Var 0 is a header-typed param (opt-load-cse-run-with-array-param).
(define (opt-load-cse-element-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     %3 = load %2 : i64
     %4 = gep %0, 0 : i64
     %5 = load %4 : i64
     %6 = gep %5, 2 : i64
     store_ptr %6, 7 : i64
     %7 = gep %0, 1 : i64
     %8 = load %7 : i64"))

;; GAP4: an element store MUST drop element-load entries (same buffer).
(define (opt-load-cse-element-invalidate-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 0 : i64
     %3 = load %2 : i64
     %4 = gep %3, 1 : i64
     %5 = load %4 : i64
     %6 = gep %3, 2 : i64
     store_ptr %6, 7 : i64
     %7 = load %4 : i64"))

;; GAP4 MUST-INVALIDATE: a descriptor-field store through ANOTHER handle (var
;; 1) may alias var 0's descriptor -- the len re-load must stay a load.
(define (opt-load-cse-other-base-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     %3 = load %2 : i64
     %4 = gep %1, 1 : i64
     store_ptr %4, 5 : i64
     %6 = load %2 : i64"))

;; GAP4: same base, provably disjoint byte ranges (data slot store vs len
;; entry) -- the len entry survives.
(define (opt-load-cse-same-base-disjoint-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     %3 = load %2 : i64
     %4 = gep %0, 0 : i64
     store_ptr %4, 5 : i64
     %6 = load %2 : i64"))

(define (opt-load-cse-copybytes-forward-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i64
     %2 = load %1 : i64
     %3 = gep %0, 1 : i64
     copy_bytes %3, %1, 8
     %4 = gep %0, 1 : i64
     %5 = load %4 : i64"))

(define (opt-load-cse-copybytes-overlap-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = gep %0, 0 : i8
     %2 = load %1 : i64
     %3 = gep %0, 4 : i8
     copy_bytes %3, %1, 8
     %4 = gep %0, 4 : i8
     %5 = load %4 : i64"))

(define (opt-load-cse-disjoint-checked-root-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 0 : i64
     %3 = load %2 : i64
     %4 = gep %1, 0 : i64
     store_ptr %4, 9 : i64
     %5 = load %2 : i64"))

(define (opt-load-cse-same-checked-root-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 0 : i64
     %3 = load %2 : i64
     %4 = gep %0, 0 : i64
     store_ptr %4, 9 : i64
     %5 = load %2 : i64"))

(define (opt-load-cse-fresh-tl-alloc-root-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Call 4 cbi.compiler-builtin-id-tl-alloc (Nil) (U64))
    (ir.CompilerIrInstr.Gep 5 (Var 4) (I64 0) (I64))
    (ir.CompilerIrInstr.Gep 2 (Var 0) (I64 0) (I64))
    (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
    (ir.CompilerIrInstr.StorePtr (Var 5) (I64 9) (I64))
    (ir.CompilerIrInstr.Load 6 (Var 2) (I64))))

;; Fresh-allocation epoch rule: var 0 carries no alias fact, so the cached load
;; of var 2 has a NoRoot key that root-identity disjointness cannot save. It was
;; still cached BEFORE var 4 was allocated, so the store through var 4's storage
;; provably misses it and the re-load forwards.
(define (opt-load-cse-fresh-alloc-epoch-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 0 : i64
     %3 = load %2 : i64
     %4 = alloc i64
     %5 = gep %4, 0 : i64
     store_ptr %5, 9 : i64
     %6 = load %2 : i64"))

;; Same shape with the allocation moved FIRST: the cached load now happens in
;; var 4's epoch, so it may address that very allocation and the store must
;; still drop it. Guards the strict `<` in the epoch comparison.
(define (opt-load-cse-fresh-alloc-epoch-tie-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%4 = alloc i64
     %2 = gep %0, 0 : i64
     %3 = load %2 : i64
     %5 = gep %4, 0 : i64
     store_ptr %5, 9 : i64
     %6 = load %2 : i64"))

(define (opt-load-cse-disjoint-copybytes-root-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 0 : i64
     %3 = load %2 : i64
     %4 = gep %1, 0 : i64
     copy_bytes %4, %99, 8
     %5 = load %2 : i64"))

(define (opt-load-cse-cast-derived-store-root-instrs) : ir.CompilerIrInstrSeq
  (let
    [ref-ty : ast.AstType (ast.ast-ty-mut-ref 0 (& (I64)))]
    (opt-test-instrs
      (irt.instr "%2 = gep %0, 0 : i64")
      (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
      (ir.CompilerIrInstr.Mov
        4
        (Var 1)
        (owned_view.compiler-owned-shared-view ref-ty))
      (ir.CompilerIrInstr.Bitcast 5 (Var 4) ref-ty (U64))
      (irt.instr "%6 = gep %5, 0 : i64")
      (irt.instr "store_ptr %6, 9 : i64")
      (ir.CompilerIrInstr.Load 7 (Var 2) (I64)))))

(define (opt-load-cse-descriptor-data-root-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 0 : u64
     %3 = load %2 : u64
     %4 = gep %3, 0 : i64
     %5 = load %4 : i64
     %6 = gep %1, 0 : i64
     store_ptr %6, 9 : i64
     %7 = load %4 : i64"))

;; A native Slice parameter is a by-value two-word register group. Re-extracting
;; its data/length after a store through another mutable Slice must canonicalize
;; both words.
(define (opt-load-cse-slice-distinct-store-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Word 2 (Var 0) 0 (U64))
    (ir.CompilerIrInstr.Word 3 (Var 0) 1 (U64))
    (ir.CompilerIrInstr.BoundsCheck
      (Var 20)
      (Var 3)
      (opt-test-symbol "slice_bounds"))
    (ir.CompilerIrInstr.Gep 4 (Var 2) (Var 20) (I64))
    (ir.CompilerIrInstr.Load 5 (Var 4) (I64))
    (ir.CompilerIrInstr.Word 6 (Var 1) 0 (U64))
    (ir.CompilerIrInstr.Gep 7 (Var 6) (Var 20) (I64))
    (ir.CompilerIrInstr.StorePtr (Var 7) (I64 99) (I64))
    (ir.CompilerIrInstr.Word 8 (Var 0) 0 (U64))
    (ir.CompilerIrInstr.Word 9 (Var 0) 1 (U64))
    (ir.CompilerIrInstr.BoundsCheck
      (Var 20)
      (Var 9)
      (opt-test-symbol "slice_bounds"))
    (ir.CompilerIrInstr.Gep 10 (Var 8) (Var 20) (I64))
    (ir.CompilerIrInstr.Load 11 (Var 10) (I64))))

;; The same data-root derivation must NOT retain a cached load when a copy may
;; overwrite that source element. CopyBytes is used so store-to-load forwarding
;; cannot hide an incorrect alias verdict.
(define (opt-load-cse-slice-same-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = word %0, 0 : u64
     %3 = gep %2, %20 : i64
     %4 = load %3 : i64
     copy_bytes %3, %99, 8
     %5 = word %0, 0 : u64
     %6 = gep %5, %20 : i64
     %7 = load %6 : i64"))

(define (opt-load-cse-slice-unknown-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = word %0, 0 : u64
     %3 = gep %2, %20 : i64
     %4 = load %3 : i64
     store_ptr %99, 9 : i64
     %5 = word %0, 0 : u64
     %6 = gep %5, %20 : i64
     %7 = load %6 : i64"))

(define (opt-load-cse-slice-call-barrier-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = word %0, 0 : u64
     %3 = word %0, 1 : u64
     %4 = call touch_slice() : i64
     %5 = word %0, 0 : u64
     %6 = word %0, 1 : u64"))

;; Address-taking makes the parameter's own two-word storage mutable, unlike a
;; store through its data pointer. The whole-function marker must refuse reuse.
(define (opt-load-cse-slice-address-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = word %0, 0 : u64
     %3 = addr_of %0
     store_ptr %3, 9 : u64
     %4 = word %0, 0 : u64"))

;; General aggregate Word operations remain store-sensitive; only recognized
;; native Slice parameter groups get the specialized stable-word fact.
(define (opt-load-cse-group-word-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = word %0, 0 : u64
     store_ptr %99, 9 : i64
     %2 = word %0, 0 : u64"))

;; Hashmap slot stores use a scaled data-buffer Gep followed by an unscaled
;; inline-field Gep. The latter must retain element provenance so it preserves
;; cached descriptor-field loads while still invalidating buffer loads.
(define (opt-load-cse-element-gep-chain-store-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = gep %0, 1 : i64
     %3 = load %2 : i64
     %4 = gep %0, 0 : u64
     %5 = load %4 : u64
     %6 = gep %5, %3 : u8
     %7 = gep %6, 8 : u8
     store_ptr %7, 9 : i64
     %8 = gep %0, 1 : i64
     %9 = load %8 : i64"))

;; Canonical GLOBAL-base keys: the descriptor fetch group `gep @g, 1` spends a
;; fresh temp per copy, and a BoundsCheck (effect ControlFlow) sits between the
;; copies. The second load must fold to a Mov of the first.
(define (opt-load-cse-global-canonical-gep-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (GlobalAddr global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (ir.CompilerIrInstr.BoundsCheck
      (I64 0)
      (Var 2)
      (opt-test-symbol "bounds_ok"))
    (ir.CompilerIrInstr.Gep 3 (GlobalAddr global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))))

;; MUST-INVALIDATE: an intervening StorePtr through an unclassified pointer may
;; alias the global's storage, so the re-load stays a load.
(define (opt-load-cse-global-store-barrier-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (GlobalAddr global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (irt.instr "store_ptr %99, 9 : i64")
    (ir.CompilerIrInstr.Gep 3 (GlobalAddr global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))))

;; Chained const offsets sum: `gep (gep @g 1) 1` and the flat `gep @g 2` are one
;; canonical key, so the second load folds.
(define (opt-load-cse-global-gep-chain-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (GlobalAddr global) (I64 1) (I64))
    (irt.instr "%2 = gep %1, 1 : i64")
    (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
    (ir.CompilerIrInstr.Gep 4 (GlobalAddr global) (I64 2) (I64))
    (ir.CompilerIrInstr.Load 5 (Var 4) (I64))))

;; A VARIABLE offset off a global ends the canonical resolution: the gep keeps
;; its own temp's raw identity. A repeat load through the SAME temp still folds
;; (var 3); a load through a gep at a DIFFERENT index var must not (var 6).
(define (opt-load-cse-global-var-offset-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (GlobalAddr global) (Var 0) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (ir.CompilerIrInstr.Load 3 (Var 1) (I64))
    (ir.CompilerIrInstr.Gep 5 (GlobalAddr global) (Var 4) (I64))
    (ir.CompilerIrInstr.Load 6 (Var 5) (I64))))

;; The shape every access to a global array emits: the gep base is the POINTER
;; STORED IN the global (`Global`, a fresh `movq g(%rip)` per copy), not the
;; global's address. Distinct temps of one slot must fold across a BoundsCheck.
(define (opt-load-cse-global-value-base-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (ir.CompilerIrInstr.BoundsCheck
      (I64 0)
      (Var 2)
      (opt-test-symbol "bounds_ok"))
    (ir.CompilerIrInstr.Gep 3 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))))

;; MUST-INVALIDATE, and the reason the value-base map is dropped by every write:
;; a Store to the global replaces the pointer the gep base reads, so the second
;; group addresses a DIFFERENT descriptor and the re-load must stay a load.
(define (opt-load-cse-global-value-base-store-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (ir.CompilerIrInstr.Store global (I64 9) (I64))
    (ir.CompilerIrInstr.Load 5 (Var 1) (I64))
    (ir.CompilerIrInstr.Gep 3 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))))

;; A named-cell write leaves DESCRIPTOR HEADER words alone: the cell holds the
;; handle, the header lives in the object the handle points at. Var 0 is a
;; header-typed param (opt-load-cse-run-with-array-param), so the len re-load
;; folds across the `Store`.
(define (opt-load-cse-global-cell-header-store-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%2 = gep %0, 1 : i64")
    (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
    (ir.CompilerIrInstr.Store global (I64 9) (I64))
    (irt.instr "%4 = gep %0, 1 : i64")
    (ir.CompilerIrInstr.Load 5 (Var 4) (I64))))

;; An ELEMENT store writes data-buffer payload, which no named cell overlaps, so
;; the cell word survives it. Var 0 is a header-typed param whose data pointer
;; roots the element address; the cell entry belongs to an unrelated global.
(define (opt-load-cse-global-cell-element-store-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 2 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
    (irt.instr "%4 = gep %0, 0 : i64")
    (ir.CompilerIrInstr.Load 5 (Var 4) (I64))
    (irt.instr "%6 = gep %5, 2 : i64")
    (irt.instr "store_ptr %6, 7 : i64")
    (ir.CompilerIrInstr.Gep 7 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 8 (Var 7) (I64))))

;; The two spellings are DIFFERENT addresses -- `Global g` is [g]+8, `GlobalAddr
;; g` is &g+8 -- so one offset off one symbol must not fold across them.
(define (opt-load-cse-global-base-form-mismatch-instrs [global : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep 1 (Global global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (ir.CompilerIrInstr.Gep 3 (GlobalAddr global) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))))

(define (opt-load-global-base-test-eq?
  [base : opt.OptMaybeGlobalBase]
  [global : i64]
  [off : i64]
  [value-base? : bool]) : bool
  (match base
    [(Some actual-global actual-off actual-value-base?)
      (and
        (= actual-global global)
        (= actual-off off)
        (=
          (if actual-value-base?
            1
            0)
          (if value-base?
            1
            0)))]
    [(No) false]))

;; Dense global-base state is mutable within a block, but predecessor snapshots
;; must remain isolated across clone/drop/bind and joins must retain only exact
;; agreements.
(define (opt-load-global-bases-self-test?) : bool
  (let
    [seed : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-bind
        (opt.opt-load-global-bases-empty)
        1
        10
        8
        true)]
    [left : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-clone
        (opt.compiler-opt-global-shared-view seed))]
    [left2 : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-bind left 2 20 16 false)]
    [right : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-clone
        (opt.compiler-opt-global-shared-view seed))]
    [right2 : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-bind right 2 20 16 false)]
    [joined : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-intersect
        (opt.compiler-opt-global-shared-view left2)
        (& right2))]
    [different : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-clone
        (opt.compiler-opt-global-shared-view seed))]
    [different2 : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-bind different 2 20 24 false)]
    [narrowed : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-intersect
        (opt.compiler-opt-global-shared-view left2)
        (& different2))]
    [dropped : opt.OptLoadGlobalBases
      (opt.opt-load-global-bases-drop-var left2 1)]
    (and
      ;; Mutating the cloned left branch did not alter the retained seed.
      (= seed.len 1)
      (opt-load-global-base-test-eq?
        (opt.opt-load-global-bases-lookup (& seed) 1)
        10
        8
        true)
      ;; Exact bindings from both branches survive a join.
      (= joined.len 2)
      (opt-load-global-base-test-eq?
        (opt.opt-load-global-bases-lookup (& joined) 2)
        20
        16
        false)
      ;; A conflicting offset is dropped while the common binding remains.
      (= narrowed.len 1)
      (opt-load-global-base-test-eq?
        (opt.opt-load-global-bases-lookup (& narrowed) 1)
        10
        8
        true)
      ;; In-place compaction removes only the selected binding.
      (= dropped.len 1)
      (match (opt.opt-load-global-bases-lookup (& dropped) 1)
        [(No) true]
        [_ false])
      (opt-load-global-base-test-eq?
        (opt.opt-load-global-bases-lookup (& dropped) 2)
        20
        16
        false))))

(define (opt-load-cse-cap-self-test?) : bool
  (let
    [profile-state : profile_state.CompilerProfileMetrics
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))]
    [key0 : opt.OptLoadKey (Raw (Var 0) (I64) false)]
    [key1 : opt.OptLoadKey (Raw (Var 1) (I64) false)]
    [table1 : opt.OptLoadTable
      (opt.opt-load-table-bind
        (opt.compiler-opt-global-shared-view profile-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        1
        (opt.compiler-opt-global-shared-view key0)
        (Var 10)
        0)]
    [table2 : opt.OptLoadTable
      (opt.opt-load-table-bind
        (opt.compiler-opt-global-shared-view profile-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        table1
        1
        (opt.compiler-opt-global-shared-view key1)
        (Var 11)
        0)]
    [table-updated : opt.OptLoadTable
      (opt.opt-load-table-bind
        (opt.compiler-opt-global-shared-view profile-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.compiler-opt-global-shared-view table2)
        1
        (opt.compiler-opt-global-shared-view key0)
        (Var 12)
        0)]
    [kinds1 : opt.OptLoadPtrKinds
      (opt.opt-load-kinds-bind
        (opt.compiler-opt-global-shared-view profile-state)
        (opt.opt-load-kinds-empty-with-cap
          (opt.compiler-opt-global-shared-view profile-state)
          1)
        1
        (OptLoadLocElement))]
    [kinds2 : opt.OptLoadPtrKinds
      (opt.opt-load-kinds-bind
        (opt.compiler-opt-global-shared-view profile-state)
        kinds1
        2
        (OptLoadLocElement))]
    [field-ok : opt.OptLoadLocKind
      (opt.opt-load-loc-field-checked
        (opt.compiler-opt-global-shared-view profile-state)
        (- opt.opt-load-loc-field-base-limit 1)
        (- opt.opt-load-loc-field-offset-limit 1)
        (- opt.opt-load-loc-field-width-limit 1)
        true)]
    [field-bad : opt.OptLoadLocKind
      (opt.opt-load-loc-field-checked
        profile-state
        opt.opt-load-loc-field-base-limit
        0
        8
        false)]
    (and
      (opt-load-global-bases-self-test?)
      (=
        (opt.opt-load-cse-table-cap-for-size 8)
        opt.opt-load-cse-table-cap-floor)
      (=
        (opt.opt-load-cse-kinds-cap-for-size 8)
        opt.opt-load-cse-kinds-cap-floor)
      (=
        (opt.opt-load-cse-table-cap-for-size
          (*
            opt.opt-load-cse-cap-hard-max
            (* opt.opt-load-cse-cap-scale-divisor 2)))
        opt.opt-load-cse-cap-hard-max)
      (= (opt.opt-load-table-len table2) 1)
      (match (opt.opt-load-table-lookup
        (ast.ast-node-pool-reader-type-segment-bases)
        table2
        key1)
        [(No) true]
        [_ false])
      (match (opt.opt-load-table-lookup
        (ast.ast-node-pool-reader-type-segment-bases)
        table-updated
        key0)
        [(Some value)
          (match value
            [(Var id) (= id 12)]
            [_ false])]
        [(No) false])
      (match (opt.opt-load-kinds-lookup (& kinds2) 1)
        [(OptLoadLocElement) true]
        [_ false])
      (match (opt.opt-load-kinds-lookup (& kinds2) 2)
        [(OptLoadLocUnknown) true]
        [_ false])
      (match field-ok
        [(OptLoadLocField base off width header?)
          (and
            (= base (- opt.opt-load-loc-field-base-limit 1))
            (= off (- opt.opt-load-loc-field-offset-limit 1))
            (= width (- opt.opt-load-loc-field-width-limit 1))
            header?)]
        [_ false])
      (match field-bad
        [(OptLoadLocUnknown) true]
        [_ false]))))

(define (opt-call-memory-test-map [name : i64] [summary : i64]) : opt_i64_i64_map.Map
  (let
    [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (opt_i64_i64_map.insert-ref!
      (&mut map)
      (ir.compiler-ir-symbol-id name)
      summary)
    map))

;; Two header-typed descriptor params, so a `gep var0, k` load keys as
;; `Field 0 k*8 I64 header?=true` -- the class an element-only callee provably
;; cannot reach.
(define (opt-load-cse-descriptor-params) : ir.CompilerIrParamSeq
  (irt.params "xs=%0:(__tl_dyn-array i64), ys=%1:(__tl_dyn-array i64)"))

;; Descriptor-field load, a call, then the same descriptor-field load. Only the
;; callee's summary decides whether the second load survives.
(define (opt-load-cse-descriptor-call-instrs [name : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%2 = gep %0, 1 : i64")
    (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
    (ir.CompilerIrInstr.Call 4 name (One (Var 1)) (Unit))
    (irt.instr "%5 = gep %0, 1 : i64")
    (ir.CompilerIrInstr.Load 6 (Var 5) (I64))))

;; The other side of the layer split: an ELEMENT load (through the descriptor's
;; data slot) must NOT survive an element-only callee, because that is exactly
;; the storage such a callee writes.
(define (opt-load-cse-element-call-instrs [name : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%2 = gep %0, 0 : i64")
    (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
    (irt.instr "%4 = gep %3, 2 : i64")
    (ir.CompilerIrInstr.Load 5 (Var 4) (I64))
    (ir.CompilerIrInstr.Call 6 name (One (Var 1)) (Unit))
    (irt.instr "%7 = gep %3, 2 : i64")
    (ir.CompilerIrInstr.Load 8 (Var 7) (I64))))

(define (opt-call-memory-test-call-instrs
  [name : i64]
  [arg : ir.CompilerIrValue]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Load 3 (Var 0) (I64))
    (ir.CompilerIrInstr.Call 4 name (One arg) (Unit))
    (ir.CompilerIrInstr.Load 5 (Var 0) (I64))))

(define (opt-call-memory-test-function
  [name : i64]
  [params : ir.CompilerIrParamSeq]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    name
    params
    (Unit)
    16
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))
    Ordinary))

;; Linked traversal is the independent oracle until #5729 retires that storage.
;; The reversed first dependency needs the existing second root pass; the rest
;; of the chain makes forward order observable rather than merely associative.
(defstruct OptCallBlockScanSnapshot
  (param-root i64)
  (first-pass i64)
  (first-root i64)
  (last-root i64)
  (poison-root i64)
  (needs-roots bool)
  (writes-memory bool)
  (candidate i64))

(define (opt-call-block-scan-same?
  [a : OptCallBlockScanSnapshot]
  [b : OptCallBlockScanSnapshot]) : bool
  (and
    (= a.param-root b.param-root)
    (= a.first-pass b.first-pass)
    (= a.first-root b.first-root)
    (= a.last-root b.last-root)
    (= a.poison-root b.poison-root)
    (= a.needs-roots b.needs-roots)
    (= a.writes-memory b.writes-memory)
    (= a.candidate b.candidate)))

(define (opt-call-block-scan-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "p" (ast.ast-ty-mut-ref 0 (& (I64))) 0)
    (ir.compiler-ir-param-seq-empty)))

(define (opt-call-block-scan-fixture-block
  [index : i64]
  [count : i64]
  [mode : i64]
  [known : i64]
  [unresolved : i64]) : ir.CompilerIrBlock
  (let
    [instrs : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 1)]
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.Mov
        (+ 10 index)
        (Var
          (if (= index 0)
            11
            (if (= index 1)
              0
              (+ 9 index))))
        (I64)))
    (when
      (= (+ index 1) count)
      (match mode
        [1
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (irt.instr "store_ptr %0, 7 : i64"))]
        [2
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (ir.CompilerIrInstr.Call 800 known (One (Var 0)) (Unit)))]
        [3
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (ir.CompilerIrInstr.TailCall unresolved (Nil) (Unit)))]
        [4
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (irt.instr "copy_bytes %0, %0, 8"))]
        [5
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (ir.CompilerIrInstr.Store known (I64 7) (I64)))]
        [6
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (irt.instr "store_owned 7 -> %0 : i64"))]
        [7
          (ir.compiler-ir-instr-builder-push!
            (&mut instrs)
            (irt.instr "%10 = mov 0 : i64"))]
        [_ unit]))
    (Block index (ir.compiler-ir-instr-builder-to-seq instrs))))

(define (opt-call-block-scan-fixture
  [count : i64]
  [mode : i64]
  [known : i64]
  [unresolved : i64]) : ir.CompilerIrBlockSeq
  (let
    [builder : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity 1)]
    [index : i64 0]
    (while (< index count)
      (ir.compiler-ir-block-builder-push!
        (&mut builder)
        (opt-call-block-scan-fixture-block index count mode known unresolved))
      (set! index (+ index 1)))
    ;; Spare capacity is deliberately observable if a scanner ignores len.
    (while (< index (array-length builder.slots))
      (set!
        (array-ref builder.slots index)
        (ir.CompilerIrBlock.Block
          999
          (opt-test-instrs
            (ir.CompilerIrInstr.Mov 0 (I64 0) (I64))
            (ir.CompilerIrInstr.Alloc 999 (I64))
            (ir.CompilerIrInstr.StorePtr (Var 9999) (I64 0) (I64)))))
      (set! index (+ index 1)))
    (ir.CompilerIrBlockSeq builder.slots builder.len)))

(define (opt-call-block-scan-root-code
  [roots : (& roots opt.OptLicmRootEnv)]
  [var : i64]) : i64
  (opt.opt-licm-root-encode (opt.opt-licm-root-env-lookup roots var)))

(define (opt-call-block-scan-snapshot
  [blocks : ir.CompilerIrBlockList]
  [count : i64]
  [known : i64]) : OptCallBlockScanSnapshot
  (let
    [params : ir.CompilerIrParamSeq (opt-call-block-scan-params)]
    [sources : opt.OptValueSources
      (opt.opt-call-memory-sources (& params) blocks)]
    [roots : opt.OptLicmRootEnv
      (opt.opt-licm-root-env-with-capacity 1 (opt_i64_i64_map.with-capacity 1))]
    [summaries : opt_i64_i64_map.Map (opt-call-memory-test-map known 1)]
    [type-segment-bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    (opt.opt-licm-root-env-seed-params!
      type-segment-bases
      (&mut roots)
      (& params))
    (opt.opt-call-memory-root-scan-blocks! sources (&mut roots) blocks)
    (let
      [first : i64 (opt-call-block-scan-root-code (& roots) 10)]
      (opt.opt-call-memory-root-scan-blocks! sources (&mut roots) blocks)
      (OptCallBlockScanSnapshot
        (opt-call-block-scan-root-code (& roots) 0)
        first
        (opt-call-block-scan-root-code (& roots) 10)
        (opt-call-block-scan-root-code (& roots) (+ 9 count))
        (opt-call-block-scan-root-code (& roots) 999)
        (opt.opt-call-memory-blocks-need-roots? summaries blocks)
        (opt.opt-call-memory-blocks-write-memory? blocks)
        (opt.opt-call-memory-candidate-blocks
          type-segment-bases
          8
          summaries
          params
          roots
          (opt_i64_i64_map.with-capacity 1)
          blocks)))))

(define (opt-call-block-scan-case?
  [count : i64]
  [mode : i64]
  [known : i64]
  [unresolved : i64]) : bool
  (let
    [seq : ir.CompilerIrBlockSeq
      (opt-call-block-scan-fixture count mode known unresolved)]
    [expected : OptCallBlockScanSnapshot
      (opt-call-block-scan-snapshot
        (Array (owned_view.compiler-owned-shared-view seq))
        count
        known)]
    [again : OptCallBlockScanSnapshot
      (opt-call-block-scan-snapshot (Array seq) count known)]
    [writes? : bool (and (> count 0) (or (= mode 1) (= mode 4) (= mode 6)))]
    [needs? : bool (or writes? (and (> count 0) (= mode 2)))]
    [summary : i64
      (if (and (> count 0) (= mode 3))
        (bit-or 8 (opt.opt-call-memory-unknown-bit))
        (bit-or
          8
          (if (and (> count 0) (= mode 5))
            (opt.opt-call-memory-global-bit)
            (if needs?
              1
              0))))]
    (and
      (= expected.param-root 1)
      (= expected.first-pass -1)
      (=
        expected.first-root
        (if (and (>= count 2) (not (= mode 7)))
          1
          -1))
      (=
        expected.last-root
        (if (>= count 2)
          1
          -1))
      (= expected.poison-root -1)
      (= expected.needs-roots needs?)
      (= expected.writes-memory writes?)
      (= expected.candidate summary)
      (opt-call-block-scan-same? expected again))))

;; Later writes cannot replace a true predicate, and they still add their bits
;; after a call to a name with no row (an extern: `unknown`).
(define (opt-call-block-scan-tail-block) : ir.CompilerIrBlock
  (Block
    999
    (opt-test-instrs
      (ir.CompilerIrInstr.Store
        (opt-test-symbol "dense_call_memory_tail_global")
        (I64 1)
        (I64)))))

(define (opt-call-block-scan-early-blocks [first : ir.CompilerIrInstr]) : ir.CompilerIrBlockList
  (let
    [builder : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity 1)]
    (ir.compiler-ir-block-builder-push!
      (&mut builder)
      (ir.CompilerIrBlock.Block 0 (opt-test-instrs first)))
    (ir.compiler-ir-block-builder-push!
      (&mut builder)
      (opt-call-block-scan-tail-block))
    (Array (ir.CompilerIrBlockSeq builder.slots builder.len))))

(define (opt-call-block-scan-early-candidate [blocks : ir.CompilerIrBlockList]) : i64
  (let
    [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
    [summaries (opt_i64_i64_map.with-capacity 1)]
    (opt.opt-call-memory-candidate-blocks
      type-segment-bases
      0
      summaries
      (ir.compiler-ir-param-seq-empty)
      (opt.opt-licm-root-env-with-capacity 1 (opt_i64_i64_map.with-capacity 1))
      (opt_i64_i64_map.with-capacity 1)
      blocks)))

(define (opt-call-block-scan-early-exits? [unresolved : i64]) : bool
  (let
    [writes : ir.CompilerIrBlockList
      (opt-call-block-scan-early-blocks (irt.instr "store_ptr %0, 1 : i64"))]
    [call : ir.CompilerIrBlockList
      (opt-call-block-scan-early-blocks (TailCall unresolved (Nil) (Unit)))]
    (and
      (let
        [summaries (opt_i64_i64_map.with-capacity 1)]
        (opt.opt-call-memory-blocks-need-roots? summaries writes))
      (opt.opt-call-memory-blocks-write-memory? writes)
      (=
        (opt-call-block-scan-early-candidate call)
        (bit-or
          (opt.opt-call-memory-unknown-bit)
          (opt.opt-call-memory-global-bit))))))

(define (compiler-optimize-call-memory-dense-scan-self-test) : bool
  (let
    [known : i64 (opt-test-symbol "dense_call_memory_known")]
    [unresolved : i64 (opt-test-symbol "dense_call_memory_unresolved")]
    [count : i64 0]
    (unless (opt-call-block-scan-early-exits? unresolved) (return false))
    (while (<= count 17)
      (let
        [mode : i64 0]
        (while (< mode 8)
          (unless
            (opt-call-block-scan-case? count mode known unresolved)
            (return false))
          (set! mode (+ mode 1)))
        (set! count (+ count 1))))
    (let
      [mode : i64 0]
      (while (< mode 8)
        (unless
          (opt-call-block-scan-case? 65 mode known unresolved)
          (return false))
        (set! mode (+ mode 1)))
      true)))

(test
  call-memory-dense-scan
  (test.assert-true
    (compiler-optimize-call-memory-dense-scan-self-test)
    "dense call-memory traversal preserves both root passes, summary accumulation, classification, order and live prefixes"))

(define (opt-call-memory-test-functions
  [wrapper : i64]
  [leaf : i64]
  [global-writer : i64]
  [raw-writer : i64]
  [indirect-writer : i64]
  [recursive : i64]
  [clean : i64]) : ir.CompilerIrFunctionSeq
  (let
    [params : ir.CompilerIrParamSeq (opt-load-cse-mixed-ref-params)]
    (ir.compiler-ir-function-seq-prepend
      ;; Wrapper precedes its leaf so the leaf-to-caller fixed point needs a
      ;; later round; leaf param 0 is wrapper argument/root 1.
      (&
        (opt-call-memory-test-function
          wrapper
          (opt.compiler-opt-global-shared-view params)
          (opt-test-instrs
            (ir.CompilerIrInstr.Call 3 leaf (Two (Var 1) (Var 0)) (Unit)))))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-call-memory-test-function
              leaf
              (opt.compiler-opt-global-shared-view params)
              (irt.instrs "store_ptr %0, 9 : i64")))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-call-memory-test-function
                  global-writer
                  (opt.compiler-opt-global-shared-view params)
                  (irt.instrs "store @call_memory_global, 9 : i64")))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-call-memory-test-function
                      raw-writer
                      (opt.compiler-opt-global-shared-view params)
                      (irt.instrs "store_ptr %99, 9 : i64")))
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (&
                        (opt-call-memory-test-function
                          indirect-writer
                          (opt.compiler-opt-global-shared-view params)
                          (opt-test-instrs
                            (ir.CompilerIrInstr.CallIndirect
                              3
                              (Function leaf)
                              (Nil)
                              (Unit)))))
                      (&
                        (ir.compiler-ir-function-seq-prepend
                          (&
                            (opt-call-memory-test-function
                              recursive
                              (opt.compiler-opt-global-shared-view params)
                              (opt-test-instrs
                                (ir.CompilerIrInstr.Call
                                  3
                                  recursive
                                  (Two (Var 0) (Var 1))
                                  (Unit)))))
                          (&
                            (ir.compiler-ir-function-seq-prepend
                              (&
                                (opt-call-memory-test-function
                                  clean
                                  params
                                  (ir.compiler-ir-instr-seq-empty)))
                              (& (ir.compiler-ir-function-seq-empty)))))))))))))))))

;; A CYCLE of two mutually recursive writers. Each stores through the element
;; buffer its own descriptor parameter names and hands that same descriptor to
;; the other, so neither member can be resolved before the other -- each
;; waits on the other -- and the cycle's least fixed point is the ELEMENT bit
;; ALONE: no member writes a parameter's own storage, a global cell, or anything
;; unknown.
;;
;; `global?` gives the SECOND member one additional global-cell store. That bit
;; has to survive the ascending iteration and land on BOTH members: the first
;; carries it back off its call. It is what pins the iteration as a real fixed
;; point rather than optimistic-forever -- a seed of 0 that were simply
;; committed would report both members global-clean.
(define (opt-call-memory-cycle-tail [callee : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs (ir.CompilerIrInstr.Call 5 callee (One (Var 0)) (Unit))))

(define (opt-call-memory-cycle-body
  [callee : i64]
  [cell : i64]
  [global? : bool]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (if global?
      (opt-test-instrs-with-tail
        (opt-call-memory-cycle-tail callee)
        (ir.CompilerIrInstr.Store cell (I64 9) (I64)))
      (opt-call-memory-cycle-tail callee))
    (ir.CompilerIrInstr.Load 2 (Var 0) (U64))
    (irt.instr "%3 = gep %2, 4 : u64")
    (irt.instr "store_ptr %3, 7 : u64")))

(define (opt-call-memory-cycle-functions
  [first : i64]
  [second : i64]
  [cell : i64]
  [global? : bool]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-call-memory-test-function
        first
        (opt-load-cse-descriptor-params)
        (opt-call-memory-cycle-body second cell false)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-call-memory-test-function
            second
            (opt-load-cse-descriptor-params)
            (opt-call-memory-cycle-body first cell global?)))
        (& (ir.compiler-ir-function-seq-empty))))))

;; The cycle under a chain of `depth` callers, each handing its descriptor to
;; the one below and the last to the cycle's first member. Every row on the
;; chain is the cycle's element summary however deep it is: the fixpoint solves
;; one call-graph component at a time and has no round budget to run out of.
(define (opt-call-memory-chain-symbol [depth : i64]) : i64
  (opt-test-symbol
    (str_cat.str-cat "call_memory_chain" (string.int->string depth))))

(define (opt-call-memory-chain-functions
  [first : i64]
  [second : i64]
  [cell : i64]
  [depth : i64]) : ir.CompilerIrFunctionSeq
  (if (= depth 0)
    (opt-call-memory-cycle-functions first second cell false)
    (ir.compiler-ir-function-seq-prepend
      (&
        (opt-call-memory-test-function
          (opt-call-memory-chain-symbol depth)
          (opt-load-cse-descriptor-params)
          (opt-call-memory-cycle-tail
            (if (= depth 1)
              first
              (opt-call-memory-chain-symbol (- depth 1))))))
      (& (opt-call-memory-chain-functions first second cell (- depth 1))))))

(define (opt-call-memory-cycle-clean-bits
  [first : i64]
  [second : i64]
  [cell : i64]) : opt_i64_i64_map.Map
  (let
    [functions (opt-call-memory-cycle-functions first second cell false)]
    [call-memory
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-call-memory-cycle-functions first second cell false))
        8)]
    (opt.opt-direct-call-clean-map functions call-memory 8)))

(define (opt-call-memory-summary-is?
  [summaries : (& summaries opt_i64_i64_map.Map)]
  [name : i64]
  [expected : i64]) : bool
  (match (opt_i64_i64_map.get (& summaries) (ir.compiler-ir-symbol-id name))
    [(LookupFound summary) (= summary expected)]
    [(LookupMissing) false]))

(define (opt-call-memory-summary-has?
  [summaries : (& summaries opt_i64_i64_map.Map)]
  [name : i64]
  [flag : i64]) : bool
  (match (opt_i64_i64_map.get (& summaries) (ir.compiler-ir-symbol-id name))
    [(LookupFound summary) (not (= (bit-and summary flag) 0))]
    [(LookupMissing) false]))

;; SUM-3 fixtures: one function that writes an element of a global array
;; through the global's own data slot, and the global table that types the
;; array as a descriptor handle beside a scalar the builder must leave out.
(define (opt-call-memory-global-element-functions [writer : i64] [array : i64]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-call-memory-test-function
        writer
        (ir.compiler-ir-param-seq-empty)
        (opt-test-instrs
          (ir.CompilerIrInstr.Gep 0 (Global array) (I64 0) (U64))
          (ir.CompilerIrInstr.Load 1 (Var 0) (U64))
          (irt.instr "%2 = gep %1, 4 : u64")
          (irt.instr "store_ptr %2, 7 : u64")
          (ir.CompilerIrInstr.Return (No)))))
    (& (ir.compiler-ir-function-seq-empty))))

(define (opt-call-memory-global-element-globals [array : i64] [scalar : i64]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 2)]
    (opt-test-global-builder-push! (&mut builder) array (DynArray 0) (Unit))
    (opt-test-global-builder-push! (&mut builder) scalar (I64) (I64 7))
    (ir.compiler-ir-global-builder-to-seq builder)))

;; CL-1 fixtures. An initializer in the `__tl_make-array` shape: the buffer
;; allocation, the 16-byte descriptor that is the only returned value, its data
;; and length slots stored once each.
(define (opt-cl-test-init-function [name : i64] [length : i64]) : ir.CompilerIrFunction
  (opt-call-memory-test-function
    name
    (ir.compiler-ir-param-seq-empty)
    (opt-test-instrs
      (ir.CompilerIrInstr.Mov 0 (I64 length) (I64))
      (ir.CompilerIrInstr.Call
        5
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 (* length 8)))
        (U64))
      (ir.CompilerIrInstr.Call
        7
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 16))
        (DynArray 0))
      (irt.instr "%8 = gep %7, 0 : u8")
      (irt.instr "store_ptr %8, %5 : u64")
      (irt.instr "%9 = gep %7, 8 : u8")
      (irt.instr "store_ptr %9, %0 : i64")
      (irt.instr "return %7"))))

;; The canonical constructor followed by a call that receives its fresh
;; descriptor. The call may write the length slot, so CL-1 must reject it even
;; though the local instruction stream still contains exactly two stores.
(define (opt-cl-test-init-call-function [name : i64] [callee : i64]) : ir.CompilerIrFunction
  (opt-call-memory-test-function
    name
    (ir.compiler-ir-param-seq-empty)
    (opt-test-instrs
      (ir.CompilerIrInstr.Call
        5
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 128))
        (U64))
      (ir.CompilerIrInstr.Call
        7
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 16))
        (DynArray 0))
      (irt.instr "%8 = gep %7, 0 : u8")
      (irt.instr "store_ptr %8, %5 : u64")
      (irt.instr "%9 = gep %7, 8 : u8")
      (irt.instr "store_ptr %9, 16 : i64")
      (ir.CompilerIrInstr.Call 10 callee (One (Var 7)) (Unit))
      (irt.instr "return %7"))))

;; The data slot points back at the descriptor instead of at the distinct fresh
;; buffer. A later ordinary data-slot load would then expose the length word to
;; mutation without another `Global` occurrence, invalidating CL-1's use-count
;; proof. The initializer recognizer must pin the exact fresh buffer value.
(define (opt-cl-test-init-self-data-function [name : i64]) : ir.CompilerIrFunction
  (opt-call-memory-test-function
    name
    (ir.compiler-ir-param-seq-empty)
    (opt-test-instrs
      (ir.CompilerIrInstr.Call
        5
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 128))
        (U64))
      (ir.CompilerIrInstr.Call
        7
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 16))
        (DynArray 0))
      (ir.CompilerIrInstr.Gep 8 (Var 7) (I64 0) (U8))
      (ir.CompilerIrInstr.StorePtr (Var 8) (Var 7) (U64))
      (ir.CompilerIrInstr.Gep 9 (Var 7) (I64 8) (U8))
      (ir.CompilerIrInstr.StorePtr (Var 9) (I64 16) (I64))
      (ir.CompilerIrInstr.Return (Some (Var 7))))))

(define (opt-cl-test-length-gep [dst : i64] [global : i64]) : ir.CompilerIrInstr
  (Gep dst (Global global) (I64 1) (I64)))

;; One reader: the four globals' lengths read the same way, and then the
;; three refusals -- the second global's cell is stored, the third's handle is
;; handed to a call, the fourth's length slot is written.
(define (opt-cl-test-reader
  [name : i64]
  [array : i64]
  [stored : i64]
  [escaped : i64]
  [header : i64]
  [sink : i64]) : ir.CompilerIrFunction
  (opt-call-memory-test-function
    name
    (ir.compiler-ir-param-seq-empty)
    (opt-test-instrs
      (opt-cl-test-length-gep 0 array)
      (ir.CompilerIrInstr.Load 1 (Var 0) (I64))
      (opt-cl-test-length-gep 2 stored)
      (ir.CompilerIrInstr.Load 3 (Var 2) (I64))
      (ir.CompilerIrInstr.Store stored (Global stored) (DynArray 0))
      (opt-cl-test-length-gep 4 escaped)
      (ir.CompilerIrInstr.Load 5 (Var 4) (I64))
      (ir.CompilerIrInstr.Call
        6
        sink
        (Two (Global escaped) (Global escaped))
        (Unit))
      (ir.CompilerIrInstr.Gep 7 (Global header) (I64 8) (U8))
      (irt.instr "store_ptr %7, 3 : i64")
      (ir.CompilerIrInstr.Return (No)))))

(defstruct OptClTestSymbols
  (array i64)
  (stored i64)
  (escaped i64)
  (header i64)
  (init-array i64)
  (init-stored i64)
  (init-escaped i64)
  (init-header i64)
  (reader i64)
  (sink i64))

(define (opt-cl-test-symbols) : OptClTestSymbols
  (OptClTestSymbols
    (opt-test-symbol "cl_array")
    (opt-test-symbol "cl_stored")
    (opt-test-symbol "cl_escaped")
    (opt-test-symbol "cl_header")
    (opt-test-symbol "__global_init_cl_array")
    (opt-test-symbol "__global_init_cl_stored")
    (opt-test-symbol "__global_init_cl_escaped")
    (opt-test-symbol "__global_init_cl_header")
    (opt-test-symbol "cl_reader")
    (opt-test-symbol "cl_sink")))

(define (opt-cl-test-globals [symbols : OptClTestSymbols]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 4)]
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.array
      (DynArray 0)
      (RuntimeGlobal symbols.init-array))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.stored
      (DynArray 0)
      (RuntimeGlobal symbols.init-stored))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.escaped
      (DynArray 0)
      (RuntimeGlobal symbols.init-escaped))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.header
      (DynArray 0)
      (RuntimeGlobal symbols.init-header))
    (ir.compiler-ir-global-builder-to-seq builder)))

(define (opt-cl-test-functions [symbols : OptClTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-cl-test-init-function symbols.init-array 16))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-cl-test-init-function symbols.init-stored 32))
        (&
          (ir.compiler-ir-function-seq-prepend
            (& (opt-cl-test-init-function symbols.init-escaped 48))
            (&
              (ir.compiler-ir-function-seq-prepend
                (& (opt-cl-test-init-function symbols.init-header 64))
                (&
                  (ir.compiler-ir-function-seq-prepend
                    (&
                      (opt-cl-test-reader
                        symbols.reader
                        symbols.array
                        symbols.stored
                        symbols.escaped
                        symbols.header
                        symbols.sink))
                    (&
                      (ir.compiler-ir-function-seq-prepend
                        (&
                          (opt-call-memory-test-function
                            symbols.sink
                            (opt-load-cse-descriptor-params)
                            (irt.instrs "return")))
                        (& (ir.compiler-ir-function-seq-empty))))))))))))))

(define (compiler-optimize-load-cse-self-test) : i64
  (let
    [positive : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-positive-instrs))]
    [call-touch : i64 (opt-test-symbol "call_memory_touch")]
    [call-write-param : opt_i64_i64_map.Map
      (opt-call-memory-test-map call-touch 1)]
    [call-disjoint : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        (opt.compiler-opt-global-shared-view call-write-param)
        (opt-call-memory-test-call-instrs call-touch (Var 1)))]
    [call-same-root : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        call-write-param
        (opt-call-memory-test-call-instrs call-touch (Var 0)))]
    [call-global : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        (opt-call-memory-test-map call-touch (opt.opt-call-memory-global-bit))
        (opt-call-memory-test-call-instrs call-touch (Var 1)))]
    [call-unknown : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        (opt-call-memory-test-map call-touch (opt.opt-call-memory-unknown-bit))
        (opt-call-memory-test-call-instrs call-touch (Var 1)))]
    ;; An element-only callee keeps the DESCRIPTOR layer alive across the call
    ;; (the header-typed Field entry) but not the ELEMENT layer it writes.
    [call-element-only : opt_i64_i64_map.Map
      (opt-call-memory-test-map call-touch (opt.opt-call-memory-element-bit))]
    [call-descriptor-element : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        (opt.compiler-opt-global-shared-view call-element-only)
        (opt-load-cse-descriptor-call-instrs call-touch))]
    [call-descriptor-unknown : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        (opt-call-memory-test-map call-touch (opt.opt-call-memory-unknown-bit))
        (opt-load-cse-descriptor-call-instrs call-touch))]
    [call-descriptor-global : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        (opt-call-memory-test-map call-touch (opt.opt-call-memory-global-bit))
        (opt-load-cse-descriptor-call-instrs call-touch))]
    [call-element-layer : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        call-element-only
        (opt-load-cse-element-call-instrs call-touch))]
    [summary-wrapper : i64 (opt-test-symbol "call_memory_wrapper")]
    [summary-leaf : i64 (opt-test-symbol "call_memory_leaf")]
    [summary-global : i64 (opt-test-symbol "call_memory_global_writer")]
    [summary-raw : i64 (opt-test-symbol "call_memory_raw_writer")]
    [summary-indirect : i64 (opt-test-symbol "call_memory_indirect_writer")]
    [summary-recursive : i64 (opt-test-symbol "call_memory_recursive")]
    [summary-clean : i64 (opt-test-symbol "call_memory_clean")]
    [call-summaries : opt_i64_i64_map.Map
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt-call-memory-test-functions
            summary-wrapper
            summary-leaf
            summary-global
            summary-raw
            summary-indirect
            summary-recursive
            summary-clean))
        32)]
    [cycle-a : i64 (opt-test-symbol "call_memory_cycle_a")]
    [cycle-b : i64 (opt-test-symbol "call_memory_cycle_b")]
    [cycle-cell : i64 (opt-test-symbol "call_memory_cycle_cell")]
    [cycle-element : opt_i64_i64_map.Map
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-call-memory-cycle-functions cycle-a cycle-b cycle-cell false))
        8)]
    [cycle-global : opt_i64_i64_map.Map
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-call-memory-cycle-functions cycle-a cycle-b cycle-cell true))
        8)]
    [cycle-chain : opt_i64_i64_map.Map
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-call-memory-chain-functions cycle-a cycle-b cycle-cell 6))
        16)]
    [cycle-clean : opt_i64_i64_map.Map
      (opt-call-memory-cycle-clean-bits cycle-a cycle-b cycle-cell)]
    ;; SUM-3: an element store through a descriptor-typed GLOBAL's data slot
    ;; (`gep @g, 0` -> load -> gep -> store_ptr) is an element write, and the
    ;; same store with the global unknown to the builder stays `unknown`.
    [global-element-writer : i64
      (opt-test-symbol "call_memory_global_element_writer")]
    [global-element-array : i64 (opt-test-symbol "call_memory_global_array")]
    [global-element-scalar : i64 (opt-test-symbol "call_memory_global_scalar")]
    [global-element-functions : ir.CompilerIrFunctionSeq
      (opt-call-memory-global-element-functions
        global-element-writer
        global-element-array)]
    [global-element-descriptors : opt_i64_i64_map.Map
      (opt.opt-call-memory-descriptor-globals
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt-call-memory-global-element-globals
            global-element-array
            global-element-scalar))
        (opt_i64_i64_map.with-capacity 8))]
    [global-element-summaries : opt_i64_i64_map.Map
      (let
        [index : opt.OptProgramIndex
          (opt.opt-program-index-build global-element-functions)]
        (opt.opt-call-memory-build-with-descriptor-globals
          (ast.ast-node-pool-reader-type-segment-bases)
          (& global-element-descriptors)
          index
          8))]
    [global-element-blind : opt_i64_i64_map.Map
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& global-element-functions)
        8)]
    ;; CL-1: the compile-time length table over four literal-sized array
    ;; globals, of which only the first is never stored, escaped or
    ;; header-written.
    [cl-symbols : OptClTestSymbols (opt-cl-test-symbols)]
    [cl-lengths : opt.OptConstLengths
      (let
        [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
        [globals (opt-cl-test-globals cl-symbols)]
        [functions (opt-cl-test-functions cl-symbols)]
        [facts : opt.OptProgramFacts (opt.opt-program-facts-build functions)]
        (opt.opt-cl-build type-segment-bases (& globals) functions facts.disq 8))]
    ;; The same program built in a scratch arena and cloned out, as the
    ;; program summaries build it.
    [cl-lengths-scratch : opt.OptConstLengths
      (let
        [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
        [globals (opt-cl-test-globals cl-symbols)]
        [functions (opt-cl-test-functions cl-symbols)]
        [facts : opt.OptProgramFacts (opt.opt-program-facts-build functions)]
        (opt.opt-cl-build-in-scratch
          type-segment-bases
          (& globals)
          functions
          facts.disq
          8))]
    [cl-call-length : i64
      (opt.opt-cl-init-length
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt-cl-test-init-call-function
            (opt-test-symbol "__global_init_cl_called")
            (opt-test-symbol "cl_mutate_descriptor"))))]
    [cl-self-data-length : i64
      (opt.opt-cl-init-length
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt-cl-test-init-self-data-function
            (opt-test-symbol "__global_init_cl_self_data"))))]
    ;; The whole summary of an element-only member of the cycle. Its one write
    ;; is `store_ptr <buffer>, 7 : u64`, so besides the element bit the summary
    ;; carries the ALIAS CLASS that write stores (packet T2-2 / MF-4 ii,
    ;; opt-call-memory-element-class-bit): u64 is class 1. Before that field
    ;; existed the element bit stood alone, which is what these assertions used
    ;; to spell -- the summaries below are compared for EQUALITY, so the class
    ;; has to be part of them.
    [cycle-element-summary : i64
      (opt.opt-call-memory-summary-add-element-class 0 1)]
    ;; GAP4: a store through an UNKNOWN pointer still clears everything.
    [store : bool
      (opt-load-cse-barrier-blocked? (irt.instr "store_ptr %99, 9 : i64"))]
    [store-forward : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-store-forward-instrs))]
    [subword-const-forward : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-subword-const-forward-instrs))]
    [subword-load-forward : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-subword-load-forward-instrs))]
    [subword-unknown-var : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-subword-unknown-var-instrs))]
    [canonical-gep : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-canonical-gep-instrs))]
    [element-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param (opt-load-cse-element-store-instrs))]
    [element-invalidate : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-element-invalidate-instrs))]
    [other-base-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param (opt-load-cse-other-base-store-instrs))]
    [same-base-disjoint : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-same-base-disjoint-instrs))]
    [copybytes-forward : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-copybytes-forward-instrs))]
    [copybytes-overlap : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-copybytes-overlap-instrs))]
    [checked-distinct : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-mixed-ref-params)
        (opt-load-cse-disjoint-checked-root-instrs))]
    [checked-shared-alias : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-shared-ref-params)
        (opt-load-cse-disjoint-checked-root-instrs))]
    [checked-same-root : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-exclusive-ref-params)
        (opt-load-cse-same-checked-root-instrs))]
    [fresh-tl-alloc-root : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-mixed-ref-params)
        (opt-load-cse-fresh-tl-alloc-root-instrs))]
    [fresh-alloc-epoch : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-fresh-alloc-epoch-instrs))]
    [fresh-alloc-epoch-tie : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-fresh-alloc-epoch-tie-instrs))]
    [checked-copybytes : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-mixed-ref-params)
        (opt-load-cse-disjoint-copybytes-root-instrs))]
    [checked-cast-root : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-mixed-ref-params)
        (opt-load-cse-cast-derived-store-root-instrs))]
    [descriptor-data-root : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-descriptor-ref-params)
        (opt-load-cse-descriptor-data-root-instrs))]
    [slice-distinct-store : ir.CompilerIrInstrSeq
      (opt-load-copy-run-with-params
        (opt-load-cse-slice-distinct-params)
        (opt-load-cse-slice-distinct-store-instrs))]
    [slice-same-store : ir.CompilerIrInstrSeq
      (opt-load-copy-run-with-params
        (opt-load-cse-slice-exclusive-param)
        (opt-load-cse-slice-same-store-instrs))]
    [slice-unknown-store : ir.CompilerIrInstrSeq
      (opt-load-copy-run-with-params
        (opt-load-cse-slice-exclusive-param)
        (opt-load-cse-slice-unknown-store-instrs))]
    [slice-call-barrier : ir.CompilerIrInstrSeq
      (opt-load-copy-run-with-params
        (opt-load-cse-slice-exclusive-param)
        (opt-load-cse-slice-call-barrier-instrs))]
    [slice-address-store : ir.CompilerIrInstrSeq
      (opt-load-copy-run-with-params
        (opt-load-cse-slice-exclusive-param)
        (opt-load-cse-slice-address-store-instrs))]
    [group-word-store : ir.CompilerIrInstrSeq
      (opt-load-copy-run-with-params
        (opt-load-cse-group-param)
        (opt-load-cse-group-word-store-instrs))]
    [element-gep-chain-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-element-gep-chain-store-instrs))]
    [global-tokens : i64 (opt-test-symbol "gvn_tokens")]
    [global-canonical-gep : ir.CompilerIrInstrSeq
      (opt-load-cse-run
        (opt-load-cse-global-canonical-gep-instrs global-tokens))]
    [global-store-barrier : ir.CompilerIrInstrSeq
      (opt-load-cse-run
        (opt-load-cse-global-store-barrier-instrs global-tokens))]
    [global-gep-chain : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-global-gep-chain-instrs global-tokens))]
    [global-var-offset : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-global-var-offset-instrs global-tokens))]
    [global-value-base : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-global-value-base-instrs global-tokens))]
    [global-value-base-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run
        (opt-load-cse-global-value-base-store-instrs global-tokens))]
    [global-base-form-mismatch : ir.CompilerIrInstrSeq
      (opt-load-cse-run
        (opt-load-cse-global-base-form-mismatch-instrs global-tokens))]
    [global-cell-other-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run
        (irt.instrs
          "%1 = gep @gvn_tokens, 1 : i64
           %2 = load %1 : i64
           store @gvn_offsets, 9 : i64
           %3 = gep @gvn_tokens, 1 : i64
           %4 = load %3 : i64"))]
    [global-cell-header-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-global-cell-header-store-instrs global-tokens))]
    [global-cell-element-store : ir.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-global-cell-element-store-instrs global-tokens))]
    [global-store : bool
      (opt-load-cse-barrier-blocked? (irt.instr "store @g, 9 : i64"))]
    [vector-store : bool
      (opt-load-cse-barrier-blocked?
        (ir.ir-instr-vector-store (Var 1) (I64 0) (I64 9) 4 (I64)))]
    [pred-store : bool
      (opt-load-cse-barrier-blocked?
        (ir.ir-instr-predicated-store
          (Var 1)
          (I64 0)
          (I64 9)
          (Bool true)
          4
          (I64)))]
    [direct-call : bool
      (opt-load-cse-barrier-blocked? (irt.instr "%9 = call touch() : i64"))]
    [indirect-call : bool
      (opt-load-cse-barrier-blocked? (irt.instr "%9 = call* fn@touch() : i64"))]
    [extern-call : bool
      (opt-load-cse-barrier-blocked?
        (irt.instr "%9 = call_c* fn@ffi_touch() : i64"))]
    [volatile-call : bool
      (opt-load-cse-barrier-blocked?
        (irt.instr "%9 = call tl_volatile_i64_load_ptr(%0) : i64"))]
    [atomic-call : bool
      (opt-load-cse-barrier-blocked?
        (irt.instr "%9 = call tl_atomic_i64_load_ptr(%0) : i64"))]
    [tail-call : bool
      (opt-load-cse-barrier-blocked? (irt.instr "tailcall touch() : i64"))]
    [syscall : bool (opt-load-cse-barrier-blocked? (Syscall 9 (Nil)))]
    [address-redef : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-address-redef-instrs))]
    [result-redef : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-result-redef-instrs))]
    [type-mismatch : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-type-mismatch-instrs))]
    [different-address : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-different-address-instrs))]
    [vector-data-pointer : ir.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-vector-data-pointer-instrs))]
    [pipeline : ir.CompilerIrBlock
      (opt-test-optimize-block
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (Block (ir.compiler-ir-label "entry") (opt-load-cse-positive-instrs)))]
    ;; Self-test inspection of opt-test-optimize-block output, not a hot pass
    ;; path.
    [pipeline-instrs : ir.CompilerIrInstrSeq
      (match pipeline
        [(Block _ instrs) instrs])]
    (cond
      [(not (= (opt-count-load-instr-seq positive) 1)) 1]
      [(not (= (opt-count-mov-dst-instr-seq positive 3) 1)) 2]
      [(not store) 3]
      [(not global-store) 4]
      [(not vector-store) 5]
      [(not pred-store) 6]
      [(not direct-call) 7]
      [(not indirect-call) 8]
      [(not tail-call) 9]
      [(not syscall) 10]
      [(not (= (opt-count-load-instr-seq address-redef) 2)) 11]
      [(not (= (opt-count-mov-dst-instr-seq address-redef 3) 0)) 12]
      [(not (= (opt-count-load-instr-seq result-redef) 2)) 13]
      [(not (= (opt-count-mov-dst-instr-seq result-redef 3) 0)) 14]
      [(not (= (opt-count-load-instr-seq type-mismatch) 2)) 15]
      [(not (= (opt-count-load-instr-seq different-address) 2)) 16]
      [(not (= (opt-count-load-instr-seq vector-data-pointer) 1)) 17]
      [(not (= (opt-count-mov-dst-instr-seq vector-data-pointer 3) 1)) 18]
      [(not (= (opt-count-load-instr-seq pipeline-instrs) 1)) 19]
      [(not (= (opt-count-mov-dst-instr-seq pipeline-instrs 3) 1)) 20]
      ;; GAP4 additions.
      [(not (= (opt-count-load-instr-seq store-forward) 1)) 21]
      [(not (= (opt-count-mov-dst-i64-src store-forward 3 9) 1)) 22]
      [(not (= (opt-count-load-instr-seq canonical-gep) 1)) 23]
      [(not (= (opt-count-mov-dst-instr-seq canonical-gep 4) 1)) 24]
      [(not (= (opt-count-load-instr-seq element-store) 2)) 25]
      [(not (= (opt-count-mov-dst-instr-seq element-store 8) 1)) 26]
      [(not (= (opt-count-load-instr-seq element-invalidate) 3)) 27]
      [(not (= (opt-count-mov-dst-instr-seq element-invalidate 7) 0)) 28]
      [(not (= (opt-count-load-instr-seq other-base-store) 2)) 29]
      [(not (= (opt-count-mov-dst-instr-seq other-base-store 6) 0)) 30]
      [(not (= (opt-count-load-instr-seq same-base-disjoint) 1)) 31]
      [(not (= (opt-count-mov-dst-instr-seq same-base-disjoint 6) 1)) 32]
      [(not (= (opt-count-load-instr-seq subword-const-forward) 0)) 33]
      [(not (= (opt-count-mov-dst-i64-src subword-const-forward 2 7) 1)) 34]
      [(not (= (opt-count-mov-dst-bool-src subword-const-forward 4 true) 1)) 35]
      [(not (= (opt-count-load-instr-seq subword-load-forward) 1)) 36]
      [(not (= (opt-count-mov-dst-var-src subword-load-forward 3 2 (I32)) 1))
        37]
      [(not (= (opt-count-load-instr-seq subword-unknown-var) 1)) 38]
      [(not (= (opt-count-mov-dst-instr-seq subword-unknown-var 2) 0)) 39]
      [(not (= (opt-count-load-instr-seq copybytes-forward) 1)) 40]
      [(not (= (opt-count-mov-dst-var-src copybytes-forward 5 2 (I64)) 1)) 41]
      [(not (= (opt-count-load-instr-seq copybytes-overlap) 2)) 42]
      [(not (= (opt-count-mov-dst-instr-seq copybytes-overlap 5) 0)) 43]
      [(not (opt-load-cse-cap-self-test?)) 45]
      [(not (= (opt-count-load-instr-seq checked-distinct) 2)) 46]
      [(not (= (opt-count-mov-dst-instr-seq checked-distinct 5) 0)) 47]
      [(not (= (opt-count-load-instr-seq checked-shared-alias) 2)) 48]
      [(not (= (opt-count-mov-dst-instr-seq checked-shared-alias 5) 0)) 49]
      [(not (= (opt-count-load-instr-seq checked-same-root) 1)) 50]
      [(not (= (opt-count-mov-dst-i64-src checked-same-root 5 9) 1)) 51]
      [(not (= (opt-count-load-instr-seq fresh-tl-alloc-root) 1)) 52]
      [(not (= (opt-count-mov-dst-var-src fresh-tl-alloc-root 6 3 (I64)) 1)) 53]
      [(not (= (opt-count-load-instr-seq checked-copybytes) 2)) 54]
      [(not (= (opt-count-mov-dst-instr-seq checked-copybytes 5) 0)) 55]
      [(not (= (opt-count-load-instr-seq checked-cast-root) 2)) 56]
      [(not (= (opt-count-mov-dst-instr-seq checked-cast-root 7) 0)) 57]
      [(not (= (opt-count-load-instr-seq descriptor-data-root) 3)) 58]
      [(not (= (opt-count-mov-dst-instr-seq descriptor-data-root 7) 0)) 59]
      [(not (= (opt-count-load-instr-seq call-disjoint) 2)) 60]
      [(not (= (opt-count-mov-dst-instr-seq call-disjoint 5) 0)) 61]
      [(not (= (opt-count-load-instr-seq call-same-root) 2)) 62]
      [(not (= (opt-count-mov-dst-instr-seq call-same-root 5) 0)) 63]
      [(not (= (opt-count-load-instr-seq call-global) 2)) 64]
      [(not (= (opt-count-load-instr-seq call-unknown) 2)) 65]
      ;; Element-only callee: the descriptor-field reload becomes a copy.
      [(not (= (opt-count-load-instr-seq call-descriptor-element) 1)) 200]
      [(not (= (opt-count-mov-dst-var-src call-descriptor-element 6 3 (I64)) 1))
        201]
      ;; Unknown and global-writing callees still clear the descriptor entry.
      [(not (= (opt-count-load-instr-seq call-descriptor-unknown) 2)) 202]
      [(not (= (opt-count-load-instr-seq call-descriptor-global) 2)) 203]
      ;; ...and an element load is exactly what an element-only callee writes.
      [(not (= (opt-count-load-instr-seq call-element-layer) 3)) 204]
      [(not (opt-call-memory-summary-is? call-summaries summary-leaf 1)) 66]
      [(not (opt-call-memory-summary-is? call-summaries summary-wrapper 2)) 67]
      [(not
          (opt-call-memory-summary-has?
            call-summaries
            summary-global
            (opt.opt-call-memory-global-bit)))
        68]
      [(not
          (opt-call-memory-summary-has?
            call-summaries
            summary-raw
            (opt.opt-call-memory-unknown-bit)))
        69]
      [(not
          (opt-call-memory-summary-has?
            call-summaries
            summary-indirect
            (opt.opt-call-memory-unknown-bit)))
        70]
      ;; The fixpoint resolves the self-recursive member. Its body is a single
      ;; self-call, so its least fixed point is the lattice bottom: it writes
      ;; nothing.
      [(not (opt-call-memory-summary-is? call-summaries summary-recursive 0))
        71]
      ;; A two-member CYCLE of element-only writers resolves at the element bit
      ;; alone -- no parameter bit, no global bit, no unknown.
      [(not
          (opt-call-memory-summary-is?
            cycle-element
            cycle-a
            cycle-element-summary))
        210]
      [(not
          (opt-call-memory-summary-is?
            cycle-element
            cycle-b
            cycle-element-summary))
        211]
      ;; ...and one global-cell store inside the cycle reaches BOTH members, so
      ;; the iteration is a fixed point and not an optimistic seed.
      [(not
          (opt-call-memory-summary-is?
            cycle-global
            cycle-a
            (opt.opt-call-memory-summary-add-global cycle-element-summary)))
        212]
      [(not
          (opt-call-memory-summary-is?
            cycle-global
            cycle-b
            (opt.opt-call-memory-summary-add-global cycle-element-summary)))
        213]
      ;; Six callers above the cycle resolve too, the outermost and the one
      ;; right above the cycle alike (a Jacobi iteration over the whole residue
      ;; needs a round per caller level).
      [(not
          (opt-call-memory-summary-is?
            cycle-chain
            (opt-call-memory-chain-symbol 6)
            cycle-element-summary))
        214]
      [(not
          (opt-call-memory-summary-is?
            cycle-chain
            (opt-call-memory-chain-symbol 1)
            cycle-element-summary))
        215]
      [(not
          (opt-call-memory-summary-is?
            cycle-chain
            cycle-a
            cycle-element-summary))
        216]
      ;; The bit the descriptor readers ask for arrives for a RECURSIVE
      ;; element-only callee, which is what routes it into LICM's store summary.
      [(not
          (opt.opt-direct-call-clean-has-bit?
            cycle-clean
            cycle-a
            (opt.opt-direct-call-clean-unconditional-global-bit)))
        217]
      ;; SUM-3: the descriptor table holds the array global and not the
      ;; scalar beside it...
      [(not
          (opt_i64_i64_map.contains?
            (& global-element-descriptors)
            (ir.compiler-ir-symbol-id global-element-array)))
        236]
      [(opt_i64_i64_map.contains?
          (& global-element-descriptors)
          (ir.compiler-ir-symbol-id global-element-scalar))
        237]
      ;; ...so a store through the array's own data slot is an element write of
      ;; its class (u64 -> class 1) and nothing else...
      [(not
          (opt-call-memory-summary-is?
            global-element-summaries
            global-element-writer
            (opt.opt-call-memory-summary-add-element-class 0 1)))
        238]
      ;; ...while the descriptor-global-free builder still answers `unknown`.
      [(not
          (opt-call-memory-summary-has?
            global-element-blind
            global-element-writer
            (opt.opt-call-memory-unknown-bit)))
        239]
      ;; CL-1: the never-touched global's length is its initializer's literal...
      [(not
          (=
            (match (opt_i64_i64_map.get
              (& cl-lengths.lengths)
              (ir.compiler-ir-symbol-id cl-symbols.array))
              [(LookupFound n) n]
              [(LookupMissing) (- 0 1)])
            16))
        240]
      ;; ...and a stored cell, an escaping handle and a written length slot
      ;; each refuse their global...
      [(opt_i64_i64_map.contains?
          (& cl-lengths.lengths)
          (ir.compiler-ir-symbol-id cl-symbols.stored))
        241]
      [(opt_i64_i64_map.contains?
          (& cl-lengths.lengths)
          (ir.compiler-ir-symbol-id cl-symbols.escaped))
        242]
      [(opt_i64_i64_map.contains?
          (& cl-lengths.lengths)
          (ir.compiler-ir-symbol-id cl-symbols.header))
        243]
      ;; ...while every initializer is recorded, whatever its global's verdict.
      [(not
          (opt_i64_i64_map.contains?
            (& cl-lengths.inits)
            (ir.compiler-ir-symbol-id cl-symbols.init-header)))
        244]
      ;; The initializer proof also owns the period before publication: an
      ;; opaque call cannot receive the fresh descriptor, and the data slot
      ;; must contain the distinct buffer allocation rather than the descriptor
      ;; itself.
      ;; ...and the scratch-built tables equal the in-place ones slot for slot.
      [(not
          (and
            (opt-test-i64-map-layout-same?
              (& cl-lengths.lengths)
              (& cl-lengths-scratch.lengths))
            (opt-test-i64-map-layout-same?
              (& cl-lengths.inits)
              (& cl-lengths-scratch.inits))))
        247]
      [(not (= cl-call-length (- 0 1))) 245]
      [(not (= cl-self-data-length (- 0 1))) 246]
      [(not (opt-call-memory-summary-is? call-summaries summary-clean 0)) 72]
      [(not extern-call) 73]
      [(not volatile-call) 74]
      [(not atomic-call) 75]
      [(not (= (opt-count-load-instr-seq element-gep-chain-store) 2)) 76]
      [(not (= (opt-count-mov-dst-var-src element-gep-chain-store 9 3 (I64)) 1))
        77]
      ;; Fresh-allocation epoch ordering: an entry cached before the allocation
      ;; survives a store through it; one cached in the same epoch does not.
      [(not (= (opt-count-load-instr-seq fresh-alloc-epoch) 1)) 78]
      [(not (= (opt-count-mov-dst-var-src fresh-alloc-epoch 6 3 (I64)) 1)) 79]
      [(not (= (opt-count-load-instr-seq fresh-alloc-epoch-tie) 2)) 80]
      [(not (= (opt-count-mov-dst-instr-seq fresh-alloc-epoch-tie 6) 0)) 81]
      ;; Canonical global-base keys: distinct gep temps of one (global, byte
      ;; offset) slot fold across a BoundsCheck; a may-alias store still blocks;
      ;; const-offset gep chains sum into the flat key; a variable offset keeps
      ;; the gep temp's own raw identity in both directions.
      [(not (= (opt-count-load-instr-seq global-canonical-gep) 1)) 82]
      [(not (= (opt-count-mov-dst-var-src global-canonical-gep 4 2 (I64)) 1))
        83]
      [(not (= (opt-count-load-instr-seq global-store-barrier) 2)) 84]
      [(not (= (opt-count-mov-dst-instr-seq global-store-barrier 4) 0)) 85]
      [(not (= (opt-count-load-instr-seq global-gep-chain) 1)) 86]
      [(not (= (opt-count-mov-dst-var-src global-gep-chain 5 3 (I64)) 1)) 87]
      [(not (= (opt-count-load-instr-seq global-var-offset) 2)) 88]
      [(not (= (opt-count-mov-dst-var-src global-var-offset 3 2 (I64)) 1)) 89]
      [(not (= (opt-count-mov-dst-instr-seq global-var-offset 6) 0)) 90]
      ;; The `Global` (value) base form: folds within a write-free run, and the
      ;; fold dies the moment the global slot is written.
      [(not (= (opt-count-load-instr-seq global-value-base) 1)) 91]
      [(not (= (opt-count-mov-dst-var-src global-value-base 4 2 (I64)) 1)) 92]
      [(not (= (opt-count-load-instr-seq global-value-base-store) 3)) 93]
      [(not (= (opt-count-mov-dst-instr-seq global-value-base-store 4) 0)) 94]
      [(not (= (opt-count-mov-dst-instr-seq global-value-base-store 5) 0)) 95]
      [(not (= (opt-count-load-instr-seq global-base-form-mismatch) 2)) 96]
      [(not (= (opt-count-mov-dst-instr-seq global-base-form-mismatch 4) 0)) 97]
      ;; Region-stable descriptor chain roots. A named-cell `Store` kills only
      ;; the cell it names: a write to an unrelated global folds the chain-root
      ;; re-derivation, a descriptor header word survives one outright, and an
      ;; element store (data-buffer payload) leaves every cell word alone. The
      ;; same-cell case stays refused above (global-value-base-store, code 93).
      [(not (= (opt-count-load-instr-seq global-cell-other-store) 1)) 98]
      [(not (= (opt-count-mov-dst-var-src global-cell-other-store 4 2 (I64)) 1))
        99]
      [(not (= (opt-count-load-instr-seq global-cell-header-store) 1)) 100]
      [(not
          (= (opt-count-mov-dst-var-src global-cell-header-store 5 3 (I64)) 1))
        101]
      [(not (= (opt-count-load-instr-seq global-cell-element-store) 2)) 102]
      [(not
          (= (opt-count-mov-dst-var-src global-cell-element-store 8 3 (I64)) 1))
        103]
      ;; Native Slice register-group words remain stable across a store
      ;; through another mutable Slice. The source element is loaded again: two
      ;; checked-reference roots may name one object.
      [(not (= (opt-count-word-instrs slice-distinct-store) 3)) 218]
      [(not (= (opt-count-mov-dst-var-src slice-distinct-store 8 2 (U64)) 1))
        219]
      [(not (= (opt-count-mov-dst-var-src slice-distinct-store 9 3 (U64)) 1))
        220]
      [(not (= (opt-count-load-instr-seq slice-distinct-store) 2)) 221]
      [(not (= (opt-count-mov-dst-instr-seq slice-distinct-store 11) 0)) 222]
      ;; A same-root or unknown write still invalidates the cached element load.
      [(not (= (opt-count-word-instrs slice-same-store) 1)) 223]
      [(not (= (opt-count-load-instr-seq slice-same-store) 2)) 224]
      [(not (= (opt-count-mov-dst-instr-seq slice-same-store 7) 0)) 225]
      [(not (= (opt-count-word-instrs slice-unknown-store) 1)) 226]
      [(not (= (opt-count-load-instr-seq slice-unknown-store) 2)) 227]
      [(not (= (opt-count-mov-dst-instr-seq slice-unknown-store 7) 0)) 228]
      ;; Calls invalidate the stable-word run, and ordinary aggregate Word
      ;; operations never enter it in the first place.
      [(not (= (opt-count-word-instrs slice-call-barrier) 4)) 229]
      [(not (= (opt-count-mov-dst-instr-seq slice-call-barrier 5) 0)) 230]
      [(not (= (opt-count-mov-dst-instr-seq slice-call-barrier 6) 0)) 231]
      [(not (= (opt-count-word-instrs group-word-store) 2)) 232]
      [(not (= (opt-count-mov-dst-instr-seq group-word-store 2) 0)) 233]
      [(not (= (opt-count-word-instrs slice-address-store) 2)) 234]
      [(not (= (opt-count-mov-dst-instr-seq slice-address-store 4) 0)) 235]
      [else 44])))

;; --- constant-trip full unroll + byte-compose load combining fixtures -----------
;;
;; The intern-table word-load shape: a rotated single-block loop whose counter
;; phi has a literal seed/step/bound. The descending form (`ge %next, 0`, sub
;; step) matches no other unroll arm, so any rewrite is the const-trip arm's;
;; the ascending form (`lt %phi, literal`) races the guarded x16 arm and shows
;; the exact arm winning (no guard block, no remainder loop).
(define (opt-lc-test-params) : ir.CompilerIrParamSeq
  (irt.params "base=%0:i64, at=%1:i64, len=%2:i64"))

;; entry -> body (self-loop: word/b phis, byte compose, b' = b-1, b' >= bound)
;; -> exit (returns the last trip's word). Seed and bound are arguments so one
;; builder covers the 8-trip, 21-trip, and non-literal-bound variants.
(define (opt-lc-word-test-body
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%30 = phi [0, lc_entry], [%36, lc_body] : i64")
    (ir.CompilerIrInstr.Phi
      28
      (ir.compiler-ir-phi-input-seq-prepend
        seed
        (ir.compiler-ir-label "lc_entry")
        (&
          (ir.compiler-ir-phi-input-seq-prepend
            (Var 37)
            (ir.compiler-ir-label "lc_body")
            (& (ir.compiler-ir-phi-input-seq-empty)))))
      (I64))
    (irt.instr "%9 = shl %30, 8 : i64")
    (irt.instr "%10 = add %1, %28 : i64")
    (irt.instr "bounds_check %10, %2 message \"lc_bounds\"")
    (irt.instr "%18 = gep %0, %10 : u8")
    (ir.CompilerIrInstr.Load 19 (Var 18) (U8))
    (irt.instr "%20 = cast %19 : u8 to i64")
    (irt.instr "%21 = bit_or %9, %20 : i64")
    (ir.CompilerIrInstr.Mov 36 (Var 21) (I64))
    (irt.instr "%23 = sub %28, 1 : i64")
    (ir.CompilerIrInstr.Mov 37 (Var 23) (I64))
    (ir.CompilerIrInstr.BinOp 39 (Ge) (Var 23) bound (I64))
    (irt.instr "branch %39, lc_body, lc_exit")))

(define (opt-lc-word-test-blocks
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "lc_exit:
           return %21")
    (irt.block "lc_entry:
         jump lc_body")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "lc_body")
      (opt-lc-word-test-body seed bound))))

(define (opt-lc-word-test-function
  [seed : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "lc_word_fixture")
    (opt-lc-test-params)
    (I64)
    40
    (opt-lc-word-test-blocks seed bound)
    Ordinary))

;; Ascending accumulator loop: i/acc phis, acc += i, i += 1, i < bound (the
;; compare reads the phi, not the post-step value). bound 4 => 5 trips; the
;; guarded x16 arm also matches this shape, so the result proves the exact arm
;; is preferred (3 blocks, no __unroll_guard).
(define (opt-lc-asc-test-body [bound : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%30 = phi [0, lc_entry], [%36, lc_body] : i64")
    (irt.instr "%28 = phi [0, lc_entry], [%37, lc_body] : i64")
    (irt.instr "%9 = add %30, %28 : i64")
    (irt.instr "%23 = add %28, 1 : i64")
    (ir.CompilerIrInstr.Mov 36 (Var 9) (I64))
    (ir.CompilerIrInstr.Mov 37 (Var 23) (I64))
    (ir.CompilerIrInstr.BinOp 39 (Lt) (Var 28) (I64 bound) (I64))
    (irt.instr "branch %39, lc_body, lc_exit")))

(define (opt-lc-asc-test-function [bound : i64]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "lc_asc_fixture")
    (opt-lc-test-params)
    (I64)
    40
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "lc_exit:
             return %9")
      (irt.block "lc_entry:
           jump lc_body")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "lc_body")
        (opt-lc-asc-test-body bound)))
    Ordinary))

;; Store-bearing descending counted loop: the const-trip arm shares the x16
;; arm's whitelist, which excludes StorePtr, so this loop must stay rolled.
(define (opt-lc-store-test-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "lc_store_fixture")
    (opt-lc-test-params)
    (I64)
    40
    (irt.blocks
      "lc_entry:
         jump lc_body
       lc_body:
         %30 = phi [0, lc_entry], [%36, lc_body] : i64
         %28 = phi [7, lc_entry], [%37, lc_body] : i64
         %10 = add %1, %28 : i64
         bounds_check %10, %2 message \"lc_store_bounds\"
         %18 = gep %0, %10 : u8
         %38 = cast %30 : i64 to u8
         store_ptr %18, %38 : u8
         %36 = mov %30 : i64
         %23 = sub %28, 1 : i64
         %37 = mov %23 : i64
         %39 = ge %23, 0 : i64
         branch %39, lc_body, lc_exit
       lc_exit:
         return %36")
    Ordinary))

;; Straight-line byte-compose fixtures for load_combine. Eight steps compose
;; zero-extended byte loads off base %0 at (%1 + literal) offsets; step j uses
;; var ids 100+j*10 .. 105+j*10, so the min-offset gep of the foldable shape
;; (mode 0, descending) is 171 and the root is 175.
;;   mode 0: exact little-endian compose -> folds
;;   mode 1: offsets 8,6,5,4,3,2,1,0 (a gap) -> rejected
;;   mode 2: shl by 4 -> rejected
;;   mode 3: u16 element loads -> rejected
;;   mode 4: step-3 cast also used by the final add (multi-use) -> rejected
;;   mode 5: big-endian byte order (offsets ascend in program order) -> rejected
;;   mode 6: a byte store between the loads -> rejected
;;   mode 7: mul-by-256 / add spelling -> folds
;;   mode 8: exact compose siblinged with a trapping `shl 0, 64` at an outer
;;           or (root = or(<compose>, shl(0,64))): the compose's own inner
;;           root still folds (trap-free), but the siblinged outer root is
;;           rejected -- the shl-64 and the outer or survive
;;   mode 9: right-nested per-byte-shift compose whose only 8-byte root is
;;           or(<compose>, shl(0,64)) -> nothing folds, no wide load, the
;;           shl-64 survives
(define (opt-lc-compose-test-instrs
  [mode : i64]
  [j : i64]
  [prev : ir.CompilerIrValue]) : ir.CompilerIrInstrSeq
  (if (>= j 8)
    (cond
      [(= mode 4)
        (opt-test-instrs
          (ir.CompilerIrInstr.BinOp 300 (Add) prev (Var 133) (I64))
          (irt.instr "return %300"))]
      [(= mode 8)
        (opt-test-instrs
          (irt.instr "%310 = shl 0, 64 : i64")
          (ir.CompilerIrInstr.BinOp 311 (BitOr) prev (Var 310) (I64))
          (irt.instr "return %311"))]
      [(= mode 9)
        (opt-test-instrs-with-tail
          (opt-lc-compose-test-nest 7)
          (ir.CompilerIrInstr.BinOp 310 (Shl (I64)) (I64 0) (I64 64) (I64)))]
      [else (opt-test-instrs (ir.CompilerIrInstr.Return (Some prev)))])
    (let
      [k : i64
        (if (= mode 5)
          j
          (- 7 j))]
      [base : i64 (+ 100 (* j 10))]
      [elem-ty : ast.AstType
        (if (= mode 3)
          (U16)
          (U8))]
      [off : i64
        (if (and (= mode 1) (= j 0))
          8
          k)]
      [a : i64 base]
      [g : i64 (+ base 1)]
      [l : i64 (+ base 2)]
      [c : i64 (+ base 3)]
      [s : i64 (+ base 4)]
      [r : i64 (+ base 5)]
      [step-tail : ir.CompilerIrInstrSeq
        (if (= mode 9)
          (opt-lc-compose-test-instrs mode (+ j 1) prev)
          (opt-test-instrs-with-tail
            (opt-lc-compose-test-instrs mode (+ j 1) (Var r))
            (if (= mode 7)
              (ir.CompilerIrInstr.BinOp s (Mul) prev (I64 256) (I64))
              (ir.CompilerIrInstr.BinOp
                s
                (Shl (I64))
                prev
                (I64
                  (if (= mode 2)
                    4
                    8))
                (I64)))
            (if (= mode 7)
              (ir.CompilerIrInstr.BinOp r (Add) (Var s) (Var c) (I64))
              (ir.CompilerIrInstr.BinOp r (BitOr) (Var s) (Var c) (I64)))))]
      (opt-test-instrs-with-tail
        (if (and (= mode 6) (= j 4))
          (opt-test-instrs-with-tail
            step-tail
            (ir.CompilerIrInstr.StorePtr (Var g) (Var c) (U8)))
          step-tail)
        (ir.CompilerIrInstr.BinOp a (Add) (Var 1) (I64 off) (I64))
        (ir.CompilerIrInstr.BoundsCheck
          (Var a)
          (Var 2)
          (ir.compiler-ir-label
            (& (str_cat.str-cat "lc_b" (string.int->string j)))))
        (ir.CompilerIrInstr.Gep
          g
          (Var 0)
          (Var a)
          (owned_view.compiler-owned-shared-view elem-ty))
        (ir.CompilerIrInstr.Load
          l
          (Var g)
          (owned_view.compiler-owned-shared-view elem-ty))
        (ir.CompilerIrInstr.Cast c (Var l) elem-ty (I64))))))

(define (opt-lc-compose-test-blocks [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "lc_main")
      (opt-lc-compose-test-instrs mode 0 (I64 0)))))

;; mode 9's right-nested chain: t_7 = or(<byte at offset 0>, <shl 0, 64>) and
;; t_i = or(shl(<byte at offset 7-i>, 8*(7-i)), t_{i+1}) down to the root t_0,
;; so the ONLY root holding all eight bytes is the one siblinged with the
;; trapping shift.
(define (opt-lc-compose-test-nest [i : i64]) : ir.CompilerIrInstrSeq
  (if (= i 7)
    (opt-test-instrs-with-tail
      (opt-lc-compose-test-nest 6)
      (ir.CompilerIrInstr.BinOp 207 (BitOr) (Var 173) (Var 310) (I64)))
    (if (< i 0)
      (irt.instrs "return %200")
      (opt-test-instrs-with-tail
        (opt-lc-compose-test-nest (- i 1))
        (ir.CompilerIrInstr.BinOp
          (+ 300 i)
          (Shl (I64))
          (Var (+ 103 (* i 10)))
          (I64 (* 8 (- 7 i)))
          (I64))
        (ir.CompilerIrInstr.BinOp
          (+ 200 i)
          (BitOr)
          (Var (+ 300 i))
          (Var (+ 201 i))
          (I64))))))

;; kind: 0 = Load u8, 1 = Load i64, 2 = BoundsCheck, 3 = Phi, 4 = Branch,
;; 5 = BinOp typed u64, 6 = BinOp And, 7 = BinOp Gt.
(define (opt-lc-test-count-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [kind : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-lc-test-count-seq
      instrs
      (+ index 1)
      kind
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(Load _ _ ty)
            (cond
              [(= kind 0)
                (match ty
                  [(U8) 1]
                  [_ 0])]
              [(= kind 1)
                (match ty
                  [(I64) 1]
                  [_ 0])]
              [else 0])]
          [(BinOp _ op _ _ ty)
            (cond
              [(= kind 5)
                (match ty
                  [(U64) 1]
                  [_ 0])]
              [(= kind 6)
                (match op
                  [(And) 1]
                  [_ 0])]
              [(= kind 7)
                (match op
                  [(Gt) 1]
                  [_ 0])]
              [else 0])]
          [(BoundsCheck _ _ _)
            (if (= kind 2)
              1
              0)]
          [(Phi _ _ _)
            (if (= kind 3)
              1
              0)]
          [(Branch _ _ _)
            (if (= kind 4)
              1
              0)]
          [_ 0])))))

(define (opt-lc-test-count-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [kind : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-lc-test-count-seq instrs 0 kind 0)
            (opt-lc-test-count-blocks rest kind))])]))

(define (opt-lc-test-count-in-block
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]
  [kind : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(No) (- 0 1)]
    [(Some block)
      (match block
        [(Block _ instrs) (opt-lc-test-count-seq instrs 0 kind 0)])]))

(define (opt-lc-test-block-instr-count
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(No) (- 0 1)]
    [(Some block)
      (match block
        [(Block _ instrs) (ir.compiler-ir-instr-seq-count instrs)])]))

(define (opt-lc-test-def-dst-count-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-lc-test-def-dst-count-seq
      (ir.compiler-ir-global-shared-view instrs)
      (+ index 1)
      dst
      (+
        acc
        (if (= (ir.compiler-ir-instr-seq-loop-dst-or instrs index (- 0 1)) dst)
          1
          0)))))

(define (opt-lc-test-def-dst-count-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-lc-test-def-dst-count-seq instrs 0 dst 0)
            (opt-lc-test-def-dst-count-blocks rest dst))])]))

(define (opt-lc-test-has-add-lit-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [lit : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BinOp _ op _ rhs _)
        (match op
          [(Add)
            (match rhs
              [(I64 k)
                (if (= k lit)
                  true
                  (opt-lc-test-has-add-lit-seq instrs (+ index 1) lit))]
              [_ (opt-lc-test-has-add-lit-seq instrs (+ index 1) lit)])]
          [_ (opt-lc-test-has-add-lit-seq instrs (+ index 1) lit)])]
      [_ (opt-lc-test-has-add-lit-seq instrs (+ index 1) lit)])))

(define (opt-lc-test-has-add-lit-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [lit : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (if (opt-lc-test-has-add-lit-seq instrs 0 lit)
            true
            (opt-lc-test-has-add-lit-blocks rest lit))])]))

(define (opt-uce-test-has-add-lit-block
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]
  [lit : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(No) false]
    [(Some block)
      (match block
        [(Block _ instrs) (opt-lc-test-has-add-lit-seq instrs 0 lit)])]))

;; Count `gt <lhs>, <lit>` instructions in one block: the guard's span
;; condition spells out as `(u64)(length - gmin) > (u64)S`.
(define (opt-uce-test-count-gt-lit-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [lit : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-uce-test-count-gt-lit-seq
      instrs
      (+ index 1)
      lit
      (+
        acc
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(BinOp _ op _ rhs _)
            (match op
              [(Gt)
                (match rhs
                  [(I64 k)
                    (if (= k lit)
                      1
                      0)]
                  [_ 0])]
              [_ 0])]
          [_ 0])))))

(define (opt-uce-test-count-gt-lit-block
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]
  [lit : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(No) (- 0 1)]
    [(Some block)
      (match block
        [(Block _ instrs) (opt-uce-test-count-gt-lit-seq instrs 0 lit 0)])]))

(define (opt-lc-test-has-shl-lit-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [lit : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BinOp _ op _ rhs _)
        (match op
          [(Shl _)
            (match rhs
              [(I64 k)
                (if (= k lit)
                  true
                  (opt-lc-test-has-shl-lit-seq instrs (+ index 1) lit))]
              [_ (opt-lc-test-has-shl-lit-seq instrs (+ index 1) lit)])]
          [_ (opt-lc-test-has-shl-lit-seq instrs (+ index 1) lit)])]
      [_ (opt-lc-test-has-shl-lit-seq instrs (+ index 1) lit)])))

(define (opt-lc-test-has-shl-lit-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [lit : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (if (opt-lc-test-has-shl-lit-seq instrs 0 lit)
            true
            (opt-lc-test-has-shl-lit-blocks rest lit))])]))

;; Src var of the first i64 load in the function (-1 none, -2 non-var src).
(define (opt-lc-test-wide-load-src-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Load _ src ty)
        (match ty
          [(I64)
            (match src
              [(Var v) v]
              [_ (- 0 2)])]
          [_ (opt-lc-test-wide-load-src-seq instrs (+ index 1))])]
      [_ (opt-lc-test-wide-load-src-seq instrs (+ index 1))])))

(define (opt-lc-test-wide-load-src-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) (- 0 1)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64 (opt-lc-test-wide-load-src-seq instrs 0)]
            (if (>= found 0)
              found
              (opt-lc-test-wide-load-src-blocks rest)))])]))

(define (compiler-optimize-unroll-const-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [word-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        bases
        (& (opt-lc-word-test-function (I64 7) (I64 0))))]
    [word-out : ir.CompilerIrBlockList (opt.opt-function-blocks word-func)]
    [word-body : i64 (ir.compiler-ir-label "lc_body")]
    [word-guard : i64 (ir.compiler-ir-label "lc_body__bce_guard")]
    [word-fast : i64 (ir.compiler-ir-label "lc_body__bce_fast")]
    [word-exit : i64 (ir.compiler-ir-label "lc_exit")]
    [asc-func : ir.CompilerIrFunction
      (opt.opt-unroll-function bases (& (opt-lc-asc-test-function 4)))]
    [asc-out : ir.CompilerIrBlockList (opt.opt-function-blocks asc-func)]
    [long-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        bases
        (& (opt-lc-word-test-function (I64 20) (I64 0))))]
    [long-out : ir.CompilerIrBlockList (opt.opt-function-blocks long-func)]
    [varbound-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        bases
        (& (opt-lc-word-test-function (I64 7) (Var 2))))]
    [varbound-out : ir.CompilerIrBlockList
      (opt.opt-function-blocks varbound-func)]
    [store-func : ir.CompilerIrFunction
      (opt.opt-unroll-function bases (& (opt-lc-store-test-function)))]
    [store-out : ir.CompilerIrBlockList (opt.opt-function-blocks store-func)]
    (cond
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& word-func))))) 1]
      ;; The affine check family consolidates: entry, a one-block guard with
      ;; two conditions, the check-free fast body, the original slow loop,
      ;; and the exit with the last-trip merge phi.
      [(not (= (ir.compiler-ir-block-list-count word-out) 5)) 2]
      [(not (= (opt-lc-test-block-instr-count word-out word-guard) 6)) 3]
      [(not (= (opt-lc-test-count-in-block word-out word-guard 5) 2)) 4]
      [(not (= (opt-lc-test-count-in-block word-out word-guard 6) 1)) 5]
      [(not (= (opt-lc-test-count-in-block word-out word-guard 4) 1)) 6]
      ;; 8 copies x 9 cloned body instructions + the closing jump, no checks.
      [(not (= (opt-lc-test-block-instr-count word-out word-fast) 73)) 7]
      [(not (= (opt-lc-test-count-in-block word-out word-fast 2) 0)) 8]
      [(not (= (opt-lc-test-count-in-block word-out word-fast 3) 0)) 9]
      [(not (= (opt-lc-test-count-in-block word-out word-fast 4) 0)) 10]
      ;; The slow loop is the original body: one check, two phis, the latch.
      [(not (= (opt-lc-test-block-instr-count word-out word-body) 14)) 11]
      [(not (= (opt-lc-test-count-in-block word-out word-body 2) 1)) 12]
      [(not (= (opt-lc-test-count-in-block word-out word-body 3) 2)) 13]
      [(not (= (opt-lc-test-count-in-block word-out word-body 4) 1)) 14]
      ;; One check survives in total; eight byte loads in the fast body plus
      ;; the slow loop's one. The counter reads literals 7..0 in the copies.
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view word-out)
              2)
            1))
        15]
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view word-out)
              0)
            9))
        16]
      [(not
          (opt-lc-test-has-add-lit-blocks
            (ir.compiler-ir-block-list-view word-out)
            7))
        17]
      [(not
          (opt-lc-test-has-add-lit-blocks
            (ir.compiler-ir-block-list-view word-out)
            0))
        18]
      ;; The guard computes the group's kmin off the same base (kmin = 0)
      ;; and tests the span against length - gmin (S = 7).
      [(not (opt-uce-test-has-add-lit-block word-out word-guard 0)) 19]
      [(not (= (opt-uce-test-count-gt-lit-block word-out word-guard 7) 1)) 20]
      ;; The last-trip word reaches the exit through a fresh merge phi, and
      ;; the slow loop is now the sole definition site of the original vars.
      [(not (= (opt-lc-test-count-in-block word-out word-exit 3) 1)) 21]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view word-out)
              28)
            1))
        22]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view word-out)
              30)
            1))
        23]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view word-out)
              21)
            1))
        24]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view word-out)
              36)
            1))
        25]
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& asc-func))))) 26]
      ;; A check-free body still takes the exact unguarded arm: 3 blocks, no
      ;; guard, 5 copies x 4 cloned instructions + the closing jump, and the
      ;; last copy keeps the original destinations for the exit's dataflow.
      [(not (= (ir.compiler-ir-block-list-count asc-out) 3)) 27]
      [(not (= (opt-lc-test-block-instr-count asc-out word-body) 21)) 28]
      [(not (= (opt-lc-test-count-in-block asc-out word-body 3) 0)) 29]
      [(not
          (opt-lc-test-has-add-lit-blocks
            (ir.compiler-ir-block-list-view asc-out)
            4))
        30]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view asc-out)
              9)
            1))
        31]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view asc-out)
              36)
            1))
        32]
      ;; 21 trips exceeds the 16-trip cap: the loop stays rolled.
      [(not (= (ir.compiler-ir-block-list-count long-out) 3)) 33]
      [(not (= (opt-lc-test-block-instr-count long-out word-body) 14)) 34]
      [(not (= (opt-lc-test-count-in-block long-out word-body 4) 1)) 35]
      [(not (= (opt-lc-test-count-in-block long-out word-body 3) 2)) 36]
      ;; A non-literal bound is not statically decidable: rolled as well.
      [(not (= (opt-lc-test-block-instr-count varbound-out word-body) 14)) 37]
      [(not (= (opt-lc-test-count-in-block varbound-out word-body 4) 1)) 38]
      ;; StorePtr bodies are excluded like the x16 arm.
      [(not (= (ir.compiler-ir-block-list-count store-out) 3)) 39]
      [(not (= (opt-lc-test-block-instr-count store-out word-body) 12)) 40]
      [(not (= (opt-lc-test-count-in-block store-out word-body 4) 1)) 41]
      [else 42])))

(define (compiler-optimize-load-combine-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [m0 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 0))]
    [m0-again : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (ir.compiler-ir-global-shared-view m0))]
    [m1 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 1))]
    [m2 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 2))]
    [m3 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 3))]
    [m4 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 4))]
    [m5 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 5))]
    [m6 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 6))]
    [m7 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 7))]
    [m8 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 8))]
    [m9 : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks 400 (opt-lc-compose-test-blocks 9))]
    [word-func : ir.CompilerIrFunction
      (opt.opt-unroll-function
        bases
        (& (opt-lc-word-test-function (I64 7) (I64 0))))]
    [word-combined : ir.CompilerIrBlockList
      (opt.opt-load-combine-blocks
        (opt.opt-function-frame word-func)
        (opt.opt-function-blocks word-func))]
    (cond
      ;; The exact compose folds: one i64 load, the chain elements deleted by
      ;; the pass itself (shifts are trapping per `ir.compiler-ir-binop-may-fault?`, so DCE
      ;; could never retire them), and ALL eight bounds checks retained.
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m0) 1) 1))
        1]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m0) 0) 0))
        2]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m0) 2) 8))
        3]
      ;; The wide load reads the min-offset byte's gep (exact LE order is a
      ;; precondition of the fold firing at all).
      [(not
          (=
            (opt-lc-test-wide-load-src-blocks
              (ir.compiler-ir-block-list-view m0))
            171))
        4]
      ;; 57 instructions before, 26 after: the 8 loads, 8 casts, 7 inner ors,
      ;; and 8 shls of the chain are gone (the root or becomes the wide load);
      ;; the address temps and checks stay.
      [(not
          (=
            (opt-lc-test-block-instr-count m0 (ir.compiler-ir-label "lc_main"))
            26))
        5]
      ;; Idempotent: the root is no longer an or/add, so a second run is a
      ;; no-op.
      [(not (opt.opt-block-list-eq bases m0 m0-again)) 6]
      ;; Rejections: offset gap, wrong shift, non-u8 element, multi-use
      ;; intermediate, big-endian order, intervening store.
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m1) 1) 0))
        7]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m2) 1) 0))
        8]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m3) 1) 0))
        9]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m4) 1) 0))
        10]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m5) 1) 0))
        11]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m6) 1) 0))
        12]
      ;; The mul-by-256 / add spelling folds too.
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m7) 1) 1))
        13]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m7) 0) 0))
        14]
      ;; The guarded unrolled word loop folds end to end on its fast path;
      ;; the wide load reuses the last copy's min-offset gep (the renamed
      ;; var 105), and the slow loop's one byte load and one check remain.
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view word-combined)
              1)
            1))
        15]
      [(not
          (=
            (opt-lc-test-wide-load-src-blocks
              (ir.compiler-ir-block-list-view word-combined))
            105))
        16]
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view word-combined)
              2)
            1))
        17]
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view word-combined)
              0)
            1))
        18]
      ;; A trapping `shl 0, 64` siblinged with an exact compose: the compose's
      ;; own inner root still folds (that rewrite is trap-free), but the
      ;; siblinged outer root is rejected -- the shl-64 and the outer or
      ;; survive (59 - 31 chain elements = 28 instructions).
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m8) 1) 1))
        19]
      [(not
          (opt-lc-test-has-shl-lit-blocks
            (ir.compiler-ir-block-list-view m8)
            64))
        20]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m8) 0) 0))
        21]
      [(not
          (=
            (opt-lc-test-block-instr-count m8 (ir.compiler-ir-label "lc_main"))
            28))
        22]
      ;; When the shl-64-siblinged or is the ONLY 8-byte root (right-nested
      ;; compose), nothing folds at all: no wide load, byte loads stay, the
      ;; trapping shift survives (57 = the unmodified fixture size).
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m9) 1) 0))
        23]
      [(not
          (= (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view m9) 0) 8))
        24]
      [(not
          (opt-lc-test-has-shl-lit-blocks
            (ir.compiler-ir-block-list-view m9)
            64))
        25]
      [(not
          (=
            (opt-lc-test-block-instr-count m9 (ir.compiler-ir-label "lc_main"))
            57))
        26]
      [else 42])))

(define (compiler-optimize-unroll-const-pipeline-self-test) : i64
  (let
    [func : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-lc-word-test-function (I64 7) (I64 0)))]
    [out : ir.CompilerIrBlockList (opt.opt-function-blocks func)]
    (cond
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& func))))) 1]
      ;; The pipeline emits the guarded form: a check-free fast body whose
      ;; compose folds to one wide load, the original slow loop keeping its
      ;; single check, and no second-round re-versioning of either block.
      [(match (opt.opt-cfg-find-block
          out
          (ir.compiler-ir-label "lc_body__bce_fast"))
          [(No) true]
          [(Some _) false])
        2]
      [(not
          (=
            (opt-lc-test-count-in-block
              out
              (ir.compiler-ir-label "lc_body__bce_fast")
              2)
            0))
        3]
      [(not
          (=
            (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view out) 2)
            1))
        4]
      [(not
          (=
            (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view out) 0)
            1))
        5]
      [(not
          (=
            (opt-lc-test-count-blocks (ir.compiler-ir-block-list-view out) 1)
            1))
        6]
      [(match (opt.opt-cfg-find-block
          out
          (ir.compiler-ir-label "lc_body__bce_fast__bce_fast"))
          [(No) false]
          [(Some _) true])
        7]
      [else 42])))

;; --- check-consolidation fixtures ---------------------------------------------
;;
;; The descending word-compose loop with a second per-trip check: mode 0
;; reads the same affine index against a second length (a second derivable
;; group), mode 1 checks the accumulator phi (underivable: it stays in the
;; fast copies), mode 2 replaces the affine check with the phi check (no
;; derivable group at all: the arm unrolls unguarded, exactly as today).
(define (opt-uce-test-params) : ir.CompilerIrParamSeq
  (irt.params "base=%0:i64, at=%1:i64, len=%2:i64, len2=%3:i64"))

(define (opt-uce-dual-test-body [mode : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%30 = phi [0, lc_entry], [%36, lc_body] : i64")
    (irt.instr "%28 = phi [7, lc_entry], [%37, lc_body] : i64")
    (irt.instr "%9 = shl %30, 8 : i64")
    (irt.instr "%10 = add %1, %28 : i64")
    (if (= mode 2)
      (irt.instr "bounds_check %30, %2 message \"lc_bounds\"")
      (irt.instr "bounds_check %10, %2 message \"lc_bounds\""))
    (if (= mode 0)
      (irt.instr "bounds_check %10, %3 message \"lc_bounds2\"")
      (irt.instr "bounds_check %30, %2 message \"lc_bounds2\""))
    (irt.instr "%18 = gep %0, %10 : u8")
    (ir.CompilerIrInstr.Load 19 (Var 18) (U8))
    (irt.instr "%20 = cast %19 : u8 to i64")
    (irt.instr "%21 = bit_or %9, %20 : i64")
    (ir.CompilerIrInstr.Mov 36 (Var 21) (I64))
    (irt.instr "%23 = sub %28, 1 : i64")
    (ir.CompilerIrInstr.Mov 37 (Var 23) (I64))
    (irt.instr "%39 = ge %23, 0 : i64")
    (irt.instr "branch %39, lc_body, lc_exit")))

(define (opt-uce-dual-test-function [mode : i64]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "lc_dual_fixture")
    (opt-uce-test-params)
    (I64)
    40
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "lc_exit:
             return %21")
      (irt.block "lc_entry:
           jump lc_body")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "lc_body")
        (opt-uce-dual-test-body mode)))
    Ordinary))

;; (b) Two derivable groups consolidate into one guard with two conditions
;; per group; a phi-indexed check is underivable and stays in the fast
;; copies, covered by the guard only for the grouped check.
(define (compiler-optimize-unroll-const-guard-groups-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [dual-func : ir.CompilerIrFunction
      (opt.opt-unroll-function bases (& (opt-uce-dual-test-function 0)))]
    [dual-out : ir.CompilerIrBlockList (opt.opt-function-blocks dual-func)]
    [mixed-func : ir.CompilerIrFunction
      (opt.opt-unroll-function bases (& (opt-uce-dual-test-function 1)))]
    [mixed-out : ir.CompilerIrBlockList (opt.opt-function-blocks mixed-func)]
    [guard : i64 (ir.compiler-ir-label "lc_body__bce_guard")]
    [fast : i64 (ir.compiler-ir-label "lc_body__bce_fast")]
    [body : i64 (ir.compiler-ir-label "lc_body")]
    [exit : i64 (ir.compiler-ir-label "lc_exit")]
    (cond
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& dual-func))))) 1]
      ;; Two groups: 2 x (gmin, c1, t, c2, and) + the combining and + branch.
      [(not (= (ir.compiler-ir-block-list-count dual-out) 5)) 2]
      [(not (= (opt-lc-test-block-instr-count dual-out guard) 12)) 3]
      [(not (= (opt-lc-test-count-in-block dual-out guard 5) 4)) 4]
      [(not (= (opt-lc-test-count-in-block dual-out guard 6) 3)) 5]
      [(not (= (opt-lc-test-count-in-block dual-out guard 4) 1)) 6]
      ;; 8 copies x (11 - 2 grouped checks) + the closing jump, no checks.
      [(not (= (opt-lc-test-block-instr-count dual-out fast) 73)) 7]
      [(not (= (opt-lc-test-count-in-block dual-out fast 2) 0)) 8]
      ;; The slow loop keeps both original checks.
      [(not (= (opt-lc-test-block-instr-count dual-out body) 15)) 9]
      [(not (= (opt-lc-test-count-in-block dual-out body 2) 2)) 10]
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view dual-out)
              2)
            2))
        11]
      [(not (= (opt-lc-test-count-in-block dual-out exit 3) 1)) 12]
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& mixed-func)))))
        13]
      ;; Mixed: one group (2 conditions); the phi check stays in the copies.
      [(not (= (opt-lc-test-block-instr-count mixed-out guard) 6)) 14]
      [(not (= (opt-lc-test-count-in-block mixed-out guard 5) 2)) 15]
      [(not (= (opt-lc-test-count-in-block mixed-out guard 6) 1)) 16]
      ;; 8 copies x (11 - 1 grouped check) + the closing jump, 8 kept checks.
      [(not (= (opt-lc-test-block-instr-count mixed-out fast) 81)) 17]
      [(not (= (opt-lc-test-count-in-block mixed-out fast 2) 8)) 18]
      [(not (= (opt-lc-test-count-in-block mixed-out body 2) 2)) 19]
      [(not
          (=
            (opt-lc-test-count-blocks
              (ir.compiler-ir-block-list-view mixed-out)
              2)
            10))
        20]
      [(not (= (opt-lc-test-count-in-block mixed-out exit 3) 1)) 21]
      [else 42])))

;; (c) With no derivable group the arm falls back to today's unguarded
;; unroll: 3 blocks, every check in the single straight-line body.
(define (compiler-optimize-unroll-const-guard-fallback-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [func : ir.CompilerIrFunction
      (opt.opt-unroll-function bases (& (opt-uce-dual-test-function 2)))]
    [out : ir.CompilerIrBlockList (opt.opt-function-blocks func)]
    [body : i64 (ir.compiler-ir-label "lc_body")]
    (cond
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& func))))) 1]
      [(match (opt.opt-cfg-find-block
          out
          (ir.compiler-ir-label "lc_body__bce_guard"))
          [(No) false]
          [(Some _) true])
        2]
      [(not (= (ir.compiler-ir-block-list-count out) 3)) 3]
      ;; 8 copies x 11 cloned body instructions + the closing jump.
      [(not (= (opt-lc-test-block-instr-count out body) 89)) 4]
      [(not (= (opt-lc-test-count-in-block out body 2) 16)) 5]
      [(not (= (opt-lc-test-count-in-block out body 3) 0)) 6]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view out)
              21)
            1))
        7]
      [(not
          (=
            (opt-lc-test-def-dst-count-blocks
              (ir.compiler-ir-block-list-view out)
              36)
            1))
        8]
      [else 42])))

;; (e) The guarded form is inert to a second application (the generated
;; labels make the slow loop ineligible to every loop scan) and to the full
;; pipeline's second iteration.
(define (compiler-optimize-unroll-const-guard-idempotent-self-test) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [once : ir.CompilerIrFunction
      (opt.opt-unroll-function
        bases
        (& (opt-lc-word-test-function (I64 7) (I64 0))))]
    [twice : ir.CompilerIrFunction (opt.opt-unroll-function bases (& once))]
    (cond
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& twice))))) 1]
      [(not
          (let
            [a (opt.opt-function-blocks once)]
            [b (opt.opt-function-blocks twice)]
            (opt.opt-block-list-eq bases a b)))
        2]
      [else 42])))

(test
  unroll-const-guard-groups
  (test.assert-i64-eq
    (compiler-optimize-unroll-const-guard-groups-self-test)
    42
    "multi-group checks consolidate into one guard; underivable checks stay in the fast copies"))

(test
  unroll-const-guard-fallback
  (test.assert-i64-eq
    (compiler-optimize-unroll-const-guard-fallback-self-test)
    42
    "a body with no derivable check group unrolls unguarded, exactly as before"))

(test
  unroll-const-guard-idempotent
  (test.assert-i64-eq
    (compiler-optimize-unroll-const-guard-idempotent-self-test)
    42
    "a second unroll application leaves the guarded form untouched"))

;; Runtime witnesses: the two compose spellings compute the little-endian
;; word of the eight bytes at `at`.
(define (opt-lc-runtime-fill!
  [data : (&mut data (__tl_dyn-array u8))]
  [at : i64]
  [j : i64]) : unit
  (unless
    (>= j 8)
    (set! (array-ref data (+ at j)) (cast (+ j 1) : u8))
    (opt-lc-runtime-fill! data at (+ j 1))))

(define (opt-lc-runtime-word [src : (& src (__tl_dyn-array u8))] [at : i64]) : i64
  (let
    [word : i64 0]
    [b : i64 7]
    (while (>= b 0)
      (set! word (bit-or (shl word 8) (cast (array-ref src (+ at b)) : i64)))
      (set! b (- b 1)))
    word))

(define (opt-lc-runtime-word-muladd [src : (__tl_dyn-array u8)] [at : i64]) : i64
  (let
    [word : i64 0]
    [b : i64 7]
    (while (>= b 0)
      (set! word (+ (* word 256) (cast (array-ref src (+ at b)) : i64)))
      (set! b (- b 1)))
    word))

(test
  unroll-const-trip-full
  (test.assert-i64-eq
    (compiler-optimize-unroll-const-self-test)
    42
    "constant-trip loops fully unroll; over-16-trip, non-literal-bound, and store loops stay rolled"))

(test
  load-combine-byte-compose
  (test.assert-i64-eq
    (compiler-optimize-load-combine-self-test)
    42
    "8-byte little-endian compose folds to one wide load with all bounds checks retained"))

(test
  unroll-const-trip-pipeline
  (test.assert-i64-eq
    (compiler-optimize-unroll-const-pipeline-self-test)
    42
    "the pipeline versions the word loop into a guard, a check-free fast path, and the original slow loop"))

;; Guard-boundary witnesses: base at 0 and base+max exactly at len-1 both
;; take the fast path (the guard passes with no slack on one side). base+max
;; at len fails the guard and takes the slow loop, whose original checks
;; abort identically -- aborts are not assertable in this harness, so the
;; witnesses pin the passing boundaries and the tightest exact fits.
(test
  unroll-const-guard-runtime-boundaries
  (let
    [data : (__tl_dyn-array u8) (__tl_make-array u8 16)]
    [tight : (__tl_dyn-array u8) (__tl_make-array u8 8)]
    (opt-lc-runtime-fill! (&mut data) 0 0)
    (test.assert-i64-eq
      (opt-lc-runtime-word data 0)
      578437695752307201
      "compose at base 0 returns the little-endian word value")
    (opt-lc-runtime-fill! (&mut data) 8 0)
    (test.assert-i64-eq
      (opt-lc-runtime-word data 8)
      578437695752307201
      "compose with base+max exactly at len-1 returns the same word")
    (test.assert-i64-eq
      (opt-lc-runtime-word-muladd data 8)
      578437695752307201
      "the mul/add spelling agrees at the boundary")
    (opt-lc-runtime-fill! (&mut tight) 0 0)
    (test.assert-i64-eq
      (opt-lc-runtime-word tight 0)
      578437695752307201
      "an exact-fit 8-byte array stays on the fast path")))

(test
  load-combine-runtime-word
  (let
    [data : (__tl_dyn-array u8) (__tl_make-array u8 16)]
    (opt-lc-runtime-fill! (&mut data) 3 0)
    (test.assert-i64-eq
      (opt-lc-runtime-word data 3)
      578437695752307201
      "shl/or compose returns the little-endian word value")
    (test.assert-i64-eq
      (opt-lc-runtime-word-muladd data 3)
      578437695752307201
      "mul/add compose returns the little-endian word value")))

;; --- const-global early substitution + global-cell invariance self-tests -----
;; Self-test: the early const-global rewrite now covers every scalar operand
;; position (compare operands feeding branches, Mov sources, UnOp sources,
;; Cast sources), not just BinOp operands, and still leaves globals
;; disqualified by a store or an address-take as hidden loads.
(define (opt-const-global-early-test-unop-src-in-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [count : i64]
  [dst : i64]) : ir.CompilerIrValue
  (if (>= index count)
    (Unit)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(UnOp d _ src _)
        (if (= d dst)
          src
          (opt-const-global-early-test-unop-src-in-seq
            instrs
            (+ index 1)
            count
            dst))]
      [_
        (opt-const-global-early-test-unop-src-in-seq
          instrs
          (+ index 1)
          count
          dst)])))

(define (opt-const-global-early-test-unop-src
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : ir.CompilerIrValue
  (match blocks
    [(slice) (Unit)]
    [(slice block & _)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-const-global-early-test-unop-src-in-seq
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            dst)])]))

(define (opt-const-global-early-test-cast-src-in-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [count : i64]
  [dst : i64]) : ir.CompilerIrValue
  (if (>= index count)
    (Unit)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Cast d src _ _)
        (if (= d dst)
          src
          (opt-const-global-early-test-cast-src-in-seq
            instrs
            (+ index 1)
            count
            dst))]
      [_
        (opt-const-global-early-test-cast-src-in-seq
          instrs
          (+ index 1)
          count
          dst)])))

(define (opt-const-global-early-test-cast-src
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : ir.CompilerIrValue
  (match blocks
    [(slice) (Unit)]
    [(slice block & _)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-const-global-early-test-cast-src-in-seq
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            dst)])]))

(define (opt-const-global-early-test-blocks
  [symbols : OptConstDivisorTestSymbols]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "then:
         return %11
       else:
         return %0")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 11 (Global symbols.konst) (I64))
        (ir.CompilerIrInstr.UnOp 12 (Neg) (Global symbols.konst) (I64))
        (ir.CompilerIrInstr.Cast 13 (Global symbols.konst) (I64) (U64))
        (ir.CompilerIrInstr.Mov 14 (Global symbols.mutable) (I64))
        (ir.CompilerIrInstr.Mov 15 (Global symbols.borrowed) (I64))
        (ir.CompilerIrInstr.Mov 16 (GlobalAddr symbols.borrowed) (U64))
        (ir.CompilerIrInstr.Store symbols.mutable (I64 9) (I64))
        (ir.CompilerIrInstr.BinOp 10 (Lt) (Var 0) (Global symbols.konst) (I64))
        (irt.instr "branch %10, then, else")))))

(define (compiler-optimize-const-global-early-self-test) : i64
  (let
    [symbols : OptConstDivisorTestSymbols (opt-const-divisor-test-symbols)]
    [globals : ir.CompilerIrGlobalSeq (opt-const-divisor-test-globals symbols)]
    [blocks : ir.CompilerIrBlockList
      (opt-const-global-early-test-blocks symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (opt-test-symbol "f")
            (ir.compiler-ir-param-seq-empty)
            (I64)
            17
            (opt.compiler-opt-global-shared-view blocks)
            Ordinary))
        (& (ir.compiler-ir-function-seq-empty)))]
    [table : opt_i64_i64_map.Map (opt-test-const-divisors globals functions)]
    [rewritten : ir.CompilerIrBlockList
      (opt.opt-const-divisor-rewrite-blocks table (& blocks))]
    (cond
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              10)
            1000000007))
        1]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-mov-src
              (ir.compiler-ir-block-list-view rewritten)
              11)
            1000000007))
        2]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-global-early-test-unop-src
              (ir.compiler-ir-block-list-view rewritten)
              12)
            1000000007))
        3]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-global-early-test-cast-src
              (ir.compiler-ir-block-list-view rewritten)
              13)
            1000000007))
        4]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-mov-src
              (ir.compiler-ir-block-list-view rewritten)
              14)
            "mut"))
        5]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-mov-src
              (ir.compiler-ir-block-list-view rewritten)
              15)
            "borrowed"))
        6]
      [else 42])))

;; --- global-cell invariance (global_cell pass) self-tests --------------------
(defstruct OptGcTestSymbols
  (arr i64)
  (k i64)
  (agg i64)
  ;; a second word cell, never read by the reader: what a callee writes when
  ;; the point of the fixture is that it writes some OTHER cell
  (m i64)
  (callee i64)
  (reader i64)
  (other i64)
  (writer i64))

(define (opt-gc-test-symbols) : OptGcTestSymbols
  (OptGcTestSymbols
    (opt-test-symbol "gc_arr")
    (opt-test-symbol "gc_k")
    (opt-test-symbol "gc_agg")
    (opt-test-symbol "gc_m")
    (opt-test-symbol "gc_callee")
    (opt-test-symbol "gc_reader")
    (opt-test-symbol "gc_other")
    (opt-test-symbol "gc_writer")))

(define (opt-gc-test-globals [symbols : OptGcTestSymbols]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 4)]
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.arr
      (DynArray 0)
      (Unit))
    (opt-test-global-builder-push! (&mut builder) symbols.k (I64) (I64 5))
    ;; Non-word-cell globals are never register-hoisted.
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.agg
      (Struct symbols.agg)
      (Unit))
    (opt-test-global-builder-push! (&mut builder) symbols.m (I64) (I64 3))
    (ir.compiler-ir-global-builder-to-seq builder)))

;; `call-mode`: 0 no call, 1 a direct RETURNING call to `gc_callee` (condition
;; (c) then asks P18's table which cells that callee's row writes), 2 a call to
;; the NON-RETURNING oob-abort helper (not a returning call at all -- nothing
;; runs after it, so no callee write can reach a use), 3 an INDIRECT call,
;; which may land on any function of the program and so refuses every cell,
;; 4 the same direct call as 1 in a body that does NOT loop, which is what
;; opt-global-cell-promotion-pays? declines for a call-bearing function.
;; Every mode but 0 and 4 closes `body` into a loop.
(define (opt-gc-test-reader-loops? [call-mode : i64]) : bool
  (and (> call-mode 0) (not (= call-mode 4))))

(define (opt-gc-test-reader-call [symbols : OptGcTestSymbols] [call-mode : i64]) : ir.CompilerIrInstr
  (if (= call-mode 3)
    (irt.instr "%9 = call* %3(%3) : i64")
    (Call
      9
      (if (= call-mode 2)
        cbi.compiler-builtin-id-tl-oob-abort
        symbols.callee)
      (One (Var 3))
      (I64))))

(define (opt-gc-test-reader-tail
  [symbols : OptGcTestSymbols]
  [store-k? : bool]
  [call-mode : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (cond
      [(> call-mode 0)
        (opt-test-instrs
          (opt-gc-test-reader-call symbols call-mode)
          (if (opt-gc-test-reader-loops? call-mode)
            (irt.instr "branch %5, body, exit")
            (irt.instr "return %5")))]
      [store-k?
        (opt-test-instrs
          (ir.CompilerIrInstr.Store symbols.k (Var 5) (I64))
          (irt.instr "return %5"))]
      [else (irt.instrs "return %5")])
    (ir.CompilerIrInstr.Mov 6 (Global symbols.agg) (Struct symbols.agg))
    ;; second @gc_arr reference (var 0 is otherwise unused in this fixture, so
    ;; the frame is unchanged). The hoist trades N per-use loads for one entry
    ;; load, so opt-global-cell-promotion-pays? admits a cell only at N >= 2;
    ;; this fixture is about LEGALITY (store / call / address-taken), and one
    ;; reference would now be refused on profitability before legality was
    ;; ever exercised. The single-reference refusal is fixture H below.
    (ir.CompilerIrInstr.Gep 0 (Global symbols.arr) (I64 0) (I64))))

;; reader fixture: descriptor gep off @gc_arr, a scalar operand @gc_k, a
;; Mov of @gc_k, and a Mov of the non-word-cell @gc_agg.
(define (opt-gc-test-reader-blocks
  [symbols : OptGcTestSymbols]
  [store-k? : bool]
  [call-mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (if (opt-gc-test-reader-loops? call-mode)
      (irt.blocks "exit:
             return %5")
      (ir.compiler-ir-block-list-empty))
    (irt.block "entry:
         jump body")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs-with-tail
        (opt-gc-test-reader-tail symbols store-k? call-mode)
        (ir.CompilerIrInstr.Gep 1 (Global symbols.arr) (I64 1) (I64))
        (irt.instr "%2 = load %1 : i64")
        (ir.CompilerIrInstr.BinOp 3 (Add) (Var 2) (Global symbols.k) (I64))
        (ir.CompilerIrInstr.Mov 4 (Global symbols.k) (I64))
        (irt.instr "%5 = add %3, %4 : i64")))))

(define (opt-gc-test-reader-function
  [symbols : OptGcTestSymbols]
  [store-k? : bool]
  [call-mode : i64]) : ir.CompilerIrFunction
  (Function
    symbols.reader
    (ir.compiler-ir-param-seq-empty)
    (I64)
    (if (> call-mode 0)
      10
      7)
    (opt-gc-test-reader-blocks symbols store-k? call-mode)
    Ordinary))

;; takes the address of gc_arr (disqualifies it program-wide, mechanism (b))
(define (opt-gc-test-other-function [symbols : OptGcTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.other
    (ir.compiler-ir-param-seq-empty)
    (U64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 0 (GlobalAddr symbols.arr) (U64))
          (irt.instr "return %0"))))
    Ordinary))

;; stores gc_k in ANOTHER function (the loader pattern: must NOT disqualify
;; the reader's hoist of gc_k -- the store cannot interleave with a call-free
;; reader activation)
(define (opt-gc-test-writer-function [symbols : OptGcTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.writer
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Store symbols.k (I64 1) (I64))
          (irt.instr "return 0"))))
    Ordinary))

(define (opt-gc-test-functions1 [f : (& f ir.CompilerIrFunction)]) : ir.CompilerIrFunctionSeq
  (let
    [f : ir.CompilerIrFunction
      (owned_view.compiler-owned-reference-shared-view f)]
    (ir.compiler-ir-function-seq-prepend
      (& f)
      (& (ir.compiler-ir-function-seq-empty)))))

(define (opt-gc-test-functions2
  [f : (& f ir.CompilerIrFunction)]
  [g : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (let
    [f : ir.CompilerIrFunction
      (owned_view.compiler-owned-reference-shared-view f)]
    (ir.compiler-ir-function-seq-prepend
      (& f)
      (&
        (ir.compiler-ir-function-seq-prepend
          (& g)
          (& (ir.compiler-ir-function-seq-empty)))))))

(define (opt-gc-test-functions3
  [f : ir.CompilerIrFunction]
  [g : ir.CompilerIrFunction]
  [h : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend (& f) (& (opt-gc-test-functions2 g h))))

(define (opt-gc-test-summaries
  [symbols : OptGcTestSymbols]
  [functions : ir.CompilerIrFunctionSeq]) : opt.OptProgramSummaries
  (opt-test-summaries-with-global-cell
    (opt.opt-program-summaries-empty)
    (opt.opt-global-cell-summary-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (& (opt-gc-test-globals symbols))
      (& functions))))

(define (opt-gc-test-block-at
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [index : i64]) : ir.CompilerIrBlock
  (match (owned_view.compiler-owned-reference-shared-view blocks)
    [(Array seq)
      (if (or (< index 0) (>= index (ir.compiler-ir-block-seq-count seq)))
        (Block
          (ir.compiler-ir-label-none)
          (ir.CompilerIrInstrSeq (__tl_make-array ir.CompilerIrInstr 0) 0))
        (ir.compiler-ir-block-seq-ref seq index))]))

(define (opt-gc-test-instr-at
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-index : i64]
  [instr-index : i64]) : ir.CompilerIrInstr
  (match (opt-gc-test-block-at blocks block-index)
    [(Block _ instrs)
      (if (or
        (< instr-index 0)
        (>= instr-index (ir.compiler-ir-instr-seq-count instrs)))
        (Jump (ir.compiler-ir-label-none))
        (ir.compiler-ir-instr-seq-ref instrs instr-index))]))

(define (opt-gc-test-block-instr-count
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-index : i64]) : i64
  (match (opt-gc-test-block-at blocks block-index)
    [(Block _ instrs) (ir.compiler-ir-instr-seq-count instrs)]))

;; count of Mov/Gep/Load/BinOp instructions still carrying a global operand,
;; in all blocks after the first (the entry block's exempt Movs are skipped)
(define (opt-gc-test-stray-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(or (Mov _ (Global _) _) (Gep _ (Global _) _ _) (Load _ (Global _) _)
         (BinOp _ _ (Global _) _ _) (BinOp _ _ _ (Global _) _))
      true]
    [_ false]))

(define (opt-gc-test-stray-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-gc-test-stray-seq
      instrs
      (+ index 1)
      (if (opt-gc-test-stray-instr? (ir.compiler-ir-instr-seq-ref instrs index))
        (+ acc 1)
        acc))))

(define (opt-gc-test-stray-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [skip-first? : bool]
  [acc : i64]) : i64
  (match blocks
    [(slice) acc]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-gc-test-stray-blocks
            rest
            false
            (if skip-first?
              acc
              (opt-gc-test-stray-seq instrs 0 acc)))])]))

;; The global-cell pass's signature output: an entry `Mov <fresh> @G` that every
;; later use reads instead of the cell. No other pass produces one -- LICM only
;; relocates instructions that already exist -- so counting them separates "the
;; cell was hoisted into a value" from "the cell is still read where it is
;; used".
(define (opt-gc-test-global-mov-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(Mov _ (Global _) _) true]
    [_ false]))

(define (opt-gc-test-global-mov-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-gc-test-global-mov-seq
      instrs
      (+ index 1)
      (if (opt-gc-test-global-mov-instr?
        (ir.compiler-ir-instr-seq-ref instrs index))
        (+ acc 1)
        acc))))

(define (opt-gc-test-global-mov-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [acc : i64]) : i64
  (match blocks
    [(slice) acc]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-gc-test-global-mov-blocks
            rest
            (opt-gc-test-global-mov-seq instrs 0 acc))])]))

(define (opt-gc-test-is-global-named? [v : ir.CompilerIrValue] [name : String]) : bool
  (match v
    [(Global g) (string.eq (ir.compiler-ir-symbol-text g) name)]
    [_ false]))

(define (opt-gc-test-is-var? [v : ir.CompilerIrValue] [id : i64]) : bool
  (match v
    [(Var v2) (= v2 id)]
    [_ false]))

;; checks shared by the plain-hoist and loader-pattern fixtures: gc_k and
;; gc_arr hoisted (fresh vars 7 and 8), uses rewritten, gc_agg left alone
(define (opt-gc-test-plain-hoist-ok? [out : ir.CompilerIrFunction]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (cond
      [(not (= (opt.opt-function-frame out) 9)) 1]
      [(not (= (opt-gc-test-block-instr-count blocks 0) 3)) 2]
      [(match (opt-gc-test-instr-at blocks 0 0)
          [(Mov d src _)
            (not (and (= d 7) (opt-gc-test-is-global-named? src "gc_k")))]
          [_ true])
        3]
      [(match (opt-gc-test-instr-at blocks 0 1)
          [(Mov d src _)
            (not (and (= d 8) (opt-gc-test-is-global-named? src "gc_arr")))]
          [_ true])
        4]
      [(match (opt-gc-test-instr-at blocks 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-var? base 8))]
          [_ true])
        5]
      [(match (opt-gc-test-instr-at blocks 1 2)
          [(BinOp _ _ _ rhs _) (not (opt-gc-test-is-var? rhs 7))]
          [_ true])
        6]
      [(match (opt-gc-test-instr-at blocks 1 3)
          [(Mov _ src _) (not (opt-gc-test-is-var? src 7))]
          [_ true])
        7]
      [(match (opt-gc-test-instr-at blocks 1 5)
          [(Mov _ src _) (not (opt-gc-test-is-global-named? src "gc_agg"))]
          [_ true])
        8]
      [(not
          (=
            (opt-gc-test-stray-blocks
              (ir.compiler-ir-block-list-view blocks)
              true
              0)
            1))
        9]
      [else 42])))

;; Same shape as opt-gc-test-plain-hoist-ok?, for the fixtures that keep a call
;; and still hoist BOTH word cells: the NON-RETURNING oob-abort helper, and a
;; returning callee whose mod-ref row names neither cell. Their frame starts at
;; 10 (the call defines var 9), so the two fresh hoist vars are 10 and 11.
(define (opt-gc-test-call-hoist-ok?
  [out : ir.CompilerIrFunction]
  [callee : i64]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (cond
      [(not (= (opt.opt-function-frame out) 12)) 1]
      [(not (= (opt-gc-test-block-instr-count blocks 0) 3)) 2]
      [(match (opt-gc-test-instr-at blocks 0 0)
          [(Mov d src _)
            (not (and (= d 10) (opt-gc-test-is-global-named? src "gc_k")))]
          [_ true])
        3]
      [(match (opt-gc-test-instr-at blocks 0 1)
          [(Mov d src _)
            (not (and (= d 11) (opt-gc-test-is-global-named? src "gc_arr")))]
          [_ true])
        4]
      [(match (opt-gc-test-instr-at blocks 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-var? base 11))]
          [_ true])
        5]
      [(match (opt-gc-test-instr-at blocks 1 2)
          [(BinOp _ _ _ rhs _) (not (opt-gc-test-is-var? rhs 10))]
          [_ true])
        6]
      ;; the call itself is untouched -- this is a classification, not check,
      ;; trap or call motion
      [(match (opt-gc-test-instr-at blocks 1 7)
          [(Call _ target _ _) (not (= target callee))]
          [_ true])
        7]
      [else 42])))

;; The fixture shape where condition (c) refuses ONE cell: `gc_k` is written by
;; a returning callee and keeps per-use semantics, while `gc_arr` -- which no
;; callee writes -- takes the single entry load (fresh var 10, the frame's
;; first free slot). Everything else is opt-gc-test-call-hoist-ok?.
(define (opt-gc-test-arr-only-hoist-ok? [out : ir.CompilerIrFunction]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (cond
      [(not (= (opt.opt-function-frame out) 11)) 1]
      [(not (= (opt-gc-test-block-instr-count blocks 0) 2)) 2]
      [(match (opt-gc-test-instr-at blocks 0 0)
          [(Mov d src _)
            (not (and (= d 10) (opt-gc-test-is-global-named? src "gc_arr")))]
          [_ true])
        3]
      [(match (opt-gc-test-instr-at blocks 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-var? base 10))]
          [_ true])
        4]
      ;; both `@gc_k` reads still name the cell
      [(match (opt-gc-test-instr-at blocks 1 2)
          [(BinOp _ _ _ rhs _) (not (opt-gc-test-is-global-named? rhs "gc_k"))]
          [_ true])
        5]
      [(match (opt-gc-test-instr-at blocks 1 3)
          [(Mov _ src _) (not (opt-gc-test-is-global-named? src "gc_k"))]
          [_ true])
        6]
      ;; exactly those two, plus the non-word aggregate Mov
      [(not
          (=
            (opt-gc-test-stray-blocks
              (ir.compiler-ir-block-list-view blocks)
              true
              0)
            3))
        7]
      [else 42])))

;; `gc_callee` as the PROGRAM sees it: one `set!` of `target`, then a return.
;; P18's table reads a direct callee's row off its body, so this body is what
;; decides -- per cell -- whether the reader may hoist across the call.
(define (opt-gc-test-callee-function
  [symbols : OptGcTestSymbols]
  [target : i64]) : ir.CompilerIrFunction
  (Function
    symbols.callee
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instr-seq-prepend
          (Store target (I64 1) (I64))
          (irt.instrs "return 0"))))
    Ordinary))

;; `gc_callee` again, storing nothing itself and CALLING `gc_writer` (which
;; stores gc_k). Its row is the TRANSITIVE one the mod-ref fixpoint computes,
;; so the reader must refuse gc_k across it exactly as across a direct writer.
(define (opt-gc-test-callee-caller-function [symbols : OptGcTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.callee
    (ir.compiler-ir-param-seq-empty)
    (I64)
    2
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instr-seq-prepend
          (Call 0 symbols.writer (Nil) (I64))
          (irt.instrs "return 0"))))
    Ordinary))

;; Fixture H: @gc_k is read EXACTLY ONCE, in a non-entry block. The hoist
;; would replace that one conditional load with one unconditional entry load
;; plus a live range spanning the function -- the same load count and a strictly
;; longer range -- so opt-global-cell-promotion-pays? refuses it even though
;; every legality condition (no store, no call, not address-taken, word cell)
;; holds. This is the nearest refused neighbour of fixture A's @gc_k, which is
;; identical except that it is read twice.
(define (opt-gc-test-single-ref-function [symbols : OptGcTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.reader
    (ir.compiler-ir-param-seq-empty)
    (I64)
    2
    (ir.compiler-ir-blocks
      (irt.block "entry:
           jump body")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 0 (Global symbols.k) (I64))
          (irt.instr "return %0"))))
    Ordinary))

;; PRESSURE fixture for opt-global-cell-entry-fits?. Same admitted shape as P2
;; -- a returning callee that writes some other cell, two `@gc_arr` reads in a
;; body that loops -- with `live-ins` values entering the function from outside:
;; vars the accumulator chain reads and no instruction defines, which is what a
;; parameter is to opt-unroll-mb-live-in-count (uses minus defs) and so exactly
;; what it counts. At the budget the cell hoists; one over it the whole function
;; is declined, because the copy would have to live in a frame slot across the
;; call.
;;
;; Vars: 10 the descriptor gep, 11 its load, 12..(11+live-ins) the chain,
;; (12+live-ins) the second `@gc_arr` read, (13+live-ins) the call result, so
;; the frame is (14+live-ins) and the single hoist would take it.
(define (opt-gc-test-pressure-chain
  [acc : i64]
  [next : i64]
  [remaining : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (<= remaining 0)
    tail
    (opt-test-instr-seq-prepend
      (BinOp (+ acc 1) (Add) (Var acc) (Var next) (I64))
      (opt-gc-test-pressure-chain (+ acc 1) (+ next 1) (- remaining 1) tail))))

(define (opt-gc-test-pressure-function
  [symbols : OptGcTestSymbols]
  [live-ins : i64]) : ir.CompilerIrFunction
  (let
    [acc : i64 (+ 11 live-ins)]
    (Function
      symbols.reader
      (ir.compiler-ir-param-seq-empty)
      (I64)
      (+ 14 live-ins)
      (ir.compiler-ir-blocks
        (irt.block "entry:
             jump body")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instr-seq-prepend
            (Gep 10 (Global symbols.arr) (I64 1) (I64))
            (opt-test-instr-seq-prepend
              (irt.instr "%11 = load %10 : i64")
              (opt-gc-test-pressure-chain
                11
                0
                live-ins
                (opt-test-instr-seq-prepend
                  (Gep (+ acc 1) (Global symbols.arr) (I64 0) (U8))
                  (opt-test-instr-seq-prepend
                    (Call (+ acc 2) symbols.callee (One (Var acc)) (I64))
                    (opt-test-instr-seq-prepend
                      (Branch
                        (Var acc)
                        (ir.compiler-ir-label "body")
                        (ir.compiler-ir-label "exit"))
                      (ir.compiler-ir-instr-seq-empty))))))))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "exit")
          (opt-test-instr-seq-prepend
            (Return (Some (Var acc)))
            (ir.compiler-ir-instr-seq-empty))))
      Ordinary)))

(define (opt-gc-test-pressure-run [symbols : OptGcTestSymbols] [live-ins : i64]) : ir.CompilerIrFunction
  (let
    [func : ir.CompilerIrFunction
      (opt-gc-test-pressure-function symbols live-ins)]
    (opt.opt-global-cell-function
      (opt-gc-test-summaries
        symbols
        (opt-gc-test-functions2
          func
          (opt-gc-test-callee-function symbols symbols.m)))
      func)))

;; --- global-cell condition (c): per-call, per-cell mod-ref -------------------
;;
;; v1 refused a function outright as soon as any RETURNING call remained. The
;; condition is now per CELL: a direct callee contributes exactly the cells its
;; P18 mod-ref row says it (transitively) may `set!`, and only a call this walk
;; cannot resolve to a name still refuses everything. Every fixture below is
;; the SAME reader -- fixture A's body plus one returning call -- and differs
;; only in what the program says that call can write.
;;
;;   P1 extern      the callee is no function of this program: no IR body,
;;                  hence no `Store`, and under (b) no pointer that names a
;;                  cell -> both word cells hoist
;;   P2 other cell  the callee sets `gc_m` -> both word cells still hoist
;;   N1 the cell    the callee sets `gc_k` -> gc_k keeps per-use semantics,
;;                  while `gc_arr`, which nothing writes, still hoists
;;   N2 transitive  the callee sets nothing itself and calls `gc_writer`, which
;;                  sets gc_k -> same verdict as N1, read off the fixpoint's row
;;   N3 indirect    a CallIndirect may land anywhere -> nothing hoists, which is
;;                  exactly the v1 rule (fixture C of the test above pins the
;;                  same shape from the other side)
;;   N4 price       P2's program with a reader whose body does NOT loop: legal,
;;                  and declined by opt-global-cell-promotion-pays?, because a
;;                  copy that has to survive the call costs a callee-saved
;;                  register on every activation and the reads it replaces run
;;                  at most once
;;   P3/N5 pressure a looping reader with six values entering from outside
;;                  hoists; with seven, opt-global-cell-entry-fits? declines the
;;                  function, because the copy would be a frame slot rather than
;;                  a callee-saved register. Two-sided on
;;                  opt-licm-global-promote-live-in-budget
;;
;; The negatives are load-bearing: dropping the mod-ref test from
;; opt-global-cell-plan-build makes N1 and N2 hoist `gc_k` across the very call
;; that writes it, and this is the test that fails.
(define (compiler-optimize-global-cell-call-mod-ref-self-test) : i64
  (let
    [symbols : OptGcTestSymbols (opt-gc-test-symbols)]
    [reader : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 1)]
    ;; P1: `gc_callee` is absent from the program's function list
    [out-extern : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt-gc-test-summaries symbols (opt-gc-test-functions1 reader))
        (opt.compiler-opt-global-shared-view reader))]
    ;; P2: it is present, and sets a cell this reader never reads
    [out-other : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt-gc-test-summaries
          symbols
          (opt-gc-test-functions2
            reader
            (opt-gc-test-callee-function symbols symbols.m)))
        (opt.compiler-opt-global-shared-view reader))]
    ;; N1: it sets `gc_k`
    [out-k : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt-gc-test-summaries
          symbols
          (opt-gc-test-functions2
            reader
            (opt-gc-test-callee-function symbols symbols.k)))
        (opt.compiler-opt-global-shared-view reader))]
    ;; N2: it calls something that sets `gc_k`
    [out-trans : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt-gc-test-summaries
          symbols
          (opt-gc-test-functions3
            (opt.compiler-opt-global-shared-view reader)
            (opt-gc-test-callee-caller-function symbols)
            (opt-gc-test-writer-function symbols)))
        reader)]
    ;; N4: legal exactly as P2 is, and declined on price -- the reader does not
    ;; loop, so the copy would have to survive the call in a callee-saved
    ;; register for reads that run at most once per activation
    [flat-reader : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 4)]
    [out-flat : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt-gc-test-summaries
          symbols
          (opt-gc-test-functions2
            flat-reader
            (opt-gc-test-callee-function symbols symbols.m)))
        flat-reader)]
    [blocks-flat : ir.CompilerIrBlockList (opt.opt-function-blocks out-flat)]
    ;; P3/N5: the live-in budget, one on each side of it
    [out-fits : ir.CompilerIrFunction (opt-gc-test-pressure-run symbols 6)]
    [blocks-fits : ir.CompilerIrBlockList (opt.opt-function-blocks out-fits)]
    [out-pressured : ir.CompilerIrFunction (opt-gc-test-pressure-run symbols 7)]
    [blocks-pressured : ir.CompilerIrBlockList
      (opt.opt-function-blocks out-pressured)]
    ;; N3: the call names no callee at all
    [indirect-reader : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 3)]
    [out-indirect : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt-gc-test-summaries symbols (opt-gc-test-functions1 indirect-reader))
        indirect-reader)]
    [blocks-indirect : ir.CompilerIrBlockList
      (opt.opt-function-blocks out-indirect)]
    (cond
      [(not (= (opt-gc-test-call-hoist-ok? out-extern symbols.callee) 42)) 1]
      [(not (= (opt-gc-test-call-hoist-ok? out-other symbols.callee) 42)) 2]
      [(not (= (opt-gc-test-arr-only-hoist-ok? out-k) 42)) 3]
      [(not (= (opt-gc-test-arr-only-hoist-ok? out-trans) 42)) 4]
      ;; N3 is untouched: same frame, no entry load, the global base intact
      [(not (= (opt.opt-function-frame out-indirect) 10)) 5]
      [(not (= (opt-gc-test-block-instr-count blocks-indirect 0) 1)) 6]
      [(match (opt-gc-test-instr-at blocks-indirect 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-global-named? base "gc_arr"))]
          [_ true])
        7]
      ;; N4 is untouched for the same three reasons, on price rather than
      ;; legality
      [(not (= (opt.opt-function-frame out-flat) 10)) 8]
      [(not (= (opt-gc-test-block-instr-count blocks-flat 0) 1)) 9]
      [(match (opt-gc-test-instr-at blocks-flat 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-global-named? base "gc_arr"))]
          [_ true])
        10]
      ;; P3: at the budget the single entry load appears and the loop's first
      ;; `@gc_arr` read becomes the fresh var (frame 20 -> 21)
      [(not (= (opt.opt-function-frame out-fits) 21)) 11]
      [(match (opt-gc-test-instr-at blocks-fits 0 0)
          [(Mov d src _)
            (not (and (= d 20) (opt-gc-test-is-global-named? src "gc_arr")))]
          [_ true])
        12]
      [(match (opt-gc-test-instr-at blocks-fits 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-var? base 20))]
          [_ true])
        13]
      ;; N5: one live-in more and the function is untouched
      [(not (= (opt.opt-function-frame out-pressured) 21)) 14]
      [(not (= (opt-gc-test-block-instr-count blocks-pressured 0) 1)) 15]
      [(match (opt-gc-test-instr-at blocks-pressured 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-global-named? base "gc_arr"))]
          [_ true])
        16]
      [else 42])))

(define (compiler-optimize-global-cell-self-test) : i64
  (let
    [symbols : OptGcTestSymbols (opt-gc-test-symbols)]
    ;; fixture A: plain hoist of gc_k + gc_arr
    [reader-a : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 0)]
    [summaries-a : opt.OptProgramSummaries
      (opt-gc-test-summaries symbols (opt-gc-test-functions1 reader-a))]
    [out-a : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt.compiler-opt-global-shared-view summaries-a)
        reader-a)]
    ;; fixture B: the function stores gc_k itself -> gc_k stays direct (a)
    [reader-b : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols true 0)]
    [summaries-b : opt.OptProgramSummaries
      (opt-gc-test-summaries symbols (opt-gc-test-functions1 reader-b))]
    [out-b : ir.CompilerIrFunction
      (opt.opt-global-cell-function summaries-b reader-b)]
    [blocks-b : ir.CompilerIrBlockList (opt.opt-function-blocks out-b)]
    ;; fixture C: an INDIRECT call may land on any function of the program, so
    ;; it may write any cell and (c) excludes the WHOLE function -- the only
    ;; whole-function refusal left. Which cells a NAMED callee writes is
    ;; compiler-optimize-global-cell-call-mod-ref-self-test.
    [reader-c : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 3)]
    [summaries-c : opt.OptProgramSummaries
      (opt-gc-test-summaries symbols (opt-gc-test-functions1 reader-c))]
    [out-c : ir.CompilerIrFunction
      (opt.opt-global-cell-function summaries-c reader-c)]
    [blocks-c : ir.CompilerIrBlockList (opt.opt-function-blocks out-c)]
    ;; fixture D: gc_arr's address is taken in another function -> gc_arr
    ;; stays direct (b), gc_k still hoists
    [reader-d : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 0)]
    [summaries-d : opt.OptProgramSummaries
      (opt-gc-test-summaries
        symbols
        (opt-gc-test-functions2 reader-d (opt-gc-test-other-function symbols)))]
    [out-d : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt.compiler-opt-global-shared-view summaries-d)
        reader-d)]
    [blocks-d : ir.CompilerIrBlockList (opt.opt-function-blocks out-d)]
    ;; fixture E: gc_k is stored in ANOTHER function (loader pattern) -> the
    ;; call-free reader still hoists gc_k
    [reader-e : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 0)]
    [summaries-e : opt.OptProgramSummaries
      (opt-gc-test-summaries
        symbols
        (opt-gc-test-functions2 reader-e (opt-gc-test-writer-function symbols)))]
    [out-e : ir.CompilerIrFunction
      (opt.opt-global-cell-function summaries-e reader-e)]
    ;; fixture G: the only call is the NON-RETURNING oob-abort helper -> (c)
    ;; admits the function and both word cells hoist, exactly as in A
    [reader-g : ir.CompilerIrFunction
      (opt-gc-test-reader-function symbols false 2)]
    [summaries-g : opt.OptProgramSummaries
      (opt-gc-test-summaries symbols (opt-gc-test-functions1 reader-g))]
    [out-g : ir.CompilerIrFunction
      (opt.opt-global-cell-function summaries-g reader-g)]
    ;; fixture H: a single-reference cell is refused on profitability
    [reader-h : ir.CompilerIrFunction (opt-gc-test-single-ref-function symbols)]
    [summaries-h : opt.OptProgramSummaries
      (opt-gc-test-summaries symbols (opt-gc-test-functions1 reader-h))]
    [out-h : ir.CompilerIrFunction
      (opt.opt-global-cell-function summaries-h reader-h)]
    [blocks-h : ir.CompilerIrBlockList (opt.opt-function-blocks out-h)]
    ;; fixture F: idempotence -- a second run over A's output adds nothing
    [out-f : ir.CompilerIrFunction
      (opt.opt-global-cell-function
        (opt.compiler-opt-global-shared-view summaries-a)
        (opt.compiler-opt-global-shared-view out-a))]
    [blocks-f : ir.CompilerIrBlockList (opt.opt-function-blocks out-f)]
    [cell-a : opt.OptGlobalCellSummary summaries-a.global-cell]
    [cell-d : opt.OptGlobalCellSummary summaries-d.global-cell]
    (cond
      ;; summary-level checks: declared types resolve, the word-cell count
      ;; excludes the aggregate global and (for D) the address-taken array
      [(match (opt.opt-global-cell-type-lookup cell-a symbols.k)
          [(Some (I64)) false]
          [_ true])
        10]
      [(match (opt.opt-global-cell-type-lookup cell-a symbols.arr)
          [(Some (DynArray _)) false]
          [_ true])
        11]
      [(not (= cell-a.word-cell 3)) 12]
      [(not (= cell-d.word-cell 2)) 13]
      [(not (opt_i64_i64_map.contains? (& cell-d.addr-taken) symbols.arr)) 14]
      [(not (= (opt-gc-test-plain-hoist-ok? out-a) 42)) 15]
      ;; fixture B: the function's only `Store gc_k` is the last instruction of
      ;; a returning block, so NO read can observe it -- condition (a) is per
      ;; store, not per function, and B hoists exactly like A. The store itself
      ;; survives (the pass rewrites reads only). The negatives that DO bite
      ;; live in compiler-optimize-global-cell-observable-store-self-test.
      [(not (= (opt-gc-test-plain-hoist-ok? out-b) 42)) 20]
      [(match (opt-gc-test-instr-at blocks-b 1 7)
          [(Store _ _ _) false]
          [_ true])
        27]
      ;; fixture C: untouched (same frame, no hoists, global base intact)
      [(not (= (opt.opt-function-frame out-c) 10)) 30]
      [(not (= (opt-gc-test-block-instr-count blocks-c 0) 1)) 31]
      [(match (opt-gc-test-instr-at blocks-c 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-global-named? base "gc_arr"))]
          [_ true])
        32]
      ;; fixture D: gc_k hoists, gc_arr stays a direct global
      [(not (= (opt.opt-function-frame out-d) 8)) 40]
      [(not (= (opt-gc-test-block-instr-count blocks-d 0) 2)) 41]
      [(match (opt-gc-test-instr-at blocks-d 0 0)
          [(Mov d src _)
            (not (and (= d 7) (opt-gc-test-is-global-named? src "gc_k")))]
          [_ true])
        42]
      [(match (opt-gc-test-instr-at blocks-d 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-global-named? base "gc_arr"))]
          [_ true])
        43]
      [(not
          (=
            (opt-gc-test-stray-blocks
              (ir.compiler-ir-block-list-view blocks-d)
              true
              0)
            3))
        44]
      ;; fixture E: loader pattern hoists exactly like fixture A
      [(not (= (opt-gc-test-plain-hoist-ok? out-e) 42)) 50]
      ;; fixture G: a NON-RETURNING abort call is not a (c) call -- the
      ;; function hoists both word cells and the abort stays where it was
      [(not
          (=
            (opt-gc-test-call-hoist-ok?
              out-g
              cbi.compiler-builtin-id-tl-oob-abort)
            42))
        55]
      ;; fixture F: second run is a no-op
      [(not (= (opt.opt-function-frame out-f) 9)) 60]
      [(not (= (opt-gc-test-block-instr-count blocks-f 0) 3)) 61]
      [(match (opt-gc-test-instr-at blocks-f 0 0)
          [(Mov d src _)
            (not (and (= d 7) (opt-gc-test-is-global-named? src "gc_k")))]
          [_ true])
        62]
      [(match (opt-gc-test-instr-at blocks-f 1 0)
          [(Gep _ base _ _) (not (opt-gc-test-is-var? base 8))]
          [_ true])
        63]
      ;; fixture H: untouched -- no entry load, no fresh var, the single read
      ;; still names the global directly
      [(not (= (opt.opt-function-frame out-h) 2)) 70]
      [(not (= (opt-gc-test-block-instr-count blocks-h 0) 1)) 71]
      [(match (opt-gc-test-instr-at blocks-h 1 0)
          [(Mov d src _)
            (not (and (= d 0) (opt-gc-test-is-global-named? src "gc_k")))]
          [_ true])
        72]
      [else 42])))

;; --- constant fill -> tl_mem_fill8 (fill_call) self-tests ---------------------
;;
;; F1 positive : a `__bce_fast` clone whose whole body is `base[i] = 0`, entered
;;               from its own `__bce_guard`, becomes one tl_mem_fill8 call and a
;;               Jump; the loop, the store and the self edge are all gone.
;; F2 negative : the SAME loop as the CHECKED original (label `while_body.9`,
;;               entered from a preheader, carrying a BoundsCheck) is left
;;               exactly as it was -- that path must keep aborting at the same
;;               element.
;; F3 negative : a fast clone that stores the COUNTER instead of a literal is
;;               not a constant fill and is left alone.
;; F4 negative : a fast clone whose predecessor is some other block, not the
;;               matching `__bce_guard`, loses the seed<bound / seed>=0 facts
;;               the rewrite relies on and is left alone.
;; F5 positive : the shape the versioner ACTUALLY emits on the round that
;;               creates the clone -- a second (bool) loop-carried phi whose
;;               back-edge input is the loop compare itself, dead literal
;;               copies, a copy of the counter, and a compare reading a COPY of
;;               the counter's next value. `opt-unroll-block-shape` REJECTS
;;               this (the compare is not terminator-only), which is why the
;;               recognizer here is self-contained; F5 is what pins that.
;; F6 negative : step 2 instead of 1 -- the visited indices are not the
;;               contiguous run `rep stosq` writes.
;; F7 negative : the compare's bound is defined inside the block, so it is not
;;               the loop's end index and the slot count would be wrong.
;;
;; Each negative was checked load-bearing by mutating the implementation and
;; confirming THIS test is what fails:
;;   * `opt-fill-call-scan-body`'s literal-store arm widened to accept a Var
;;     store value -> code 20 (F3 wrongly rewrites).
;;   * `opt-loop-call-pred-in-version-namespace?` forced true -> code 30 (F4
;;     wrongly rewrites).
;;   * `opt-loop-call-shape-step`'s `(= step 1)` dropped -> code 50 (F6).
;;   * `opt-loop-call-shape-cond`'s `opt-unroll-invariant-bound?` forced true
;;     -> code 60 (F7).
;;   * `opt-loop-call-shape-scan` given the unroller's extra "the compare's only
;;     in-block use is the terminator" gate -> code 41 (F5 stops rewriting)
;;     while F1 still passes: that gate, and nothing else, is what made
;;     `opt-unroll-block-shape` reject the real clone.
(define (opt-fc-test-label [name : String]) : i64
  (ir.compiler-ir-label (& name)))

(define (opt-fc-test-i64) : ast.AstType
  (I64))

(define (opt-fc-test-entry-block [pred : i64]) : ir.CompilerIrBlock
  (Block
    (opt-fc-test-label "fc.entry")
    (opt-test-instrs (ir.CompilerIrInstr.Jump pred))))

(define (opt-fc-test-pred-block [pred : i64] [loop : i64] [exit : i64]) : ir.CompilerIrBlock
  (Block
    pred
    (opt-test-instrs
      (irt.instr "%2 = lt 0, %1 : bool")
      (ir.CompilerIrInstr.Branch (Var 2) loop exit))))

(define (opt-fc-test-loop-tail
  [loop : i64]
  [exit : i64]
  [value : ir.CompilerIrValue]
  [step : i64]
  [bound : ir.CompilerIrValue]
  [local-bound? : bool]) : ir.CompilerIrInstrSeq
  (opt-fc-test-maybe-local-bound
    local-bound?
    (opt-test-instrs
      (irt.instr "%4 = gep %0, %3 : i64")
      (ir.CompilerIrInstr.StorePtr (Var 4) value (opt-fc-test-i64))
      (ir.CompilerIrInstr.BinOp 5 (Add) (Var 3) (I64 step) (opt-fc-test-i64))
      (ir.CompilerIrInstr.BinOp 6 (Lt) (Var 5) bound (Bool))
      (ir.CompilerIrInstr.Branch (Var 6) loop exit))))

;; F7's block-local bound: `%7 = mov %1` inside the loop, compared against
;; instead of the parameter. Emitting a real copy (rather than reusing the
;; counter's own next value) is what makes the fixture NON-vacuous: with the
;; invariance clause removed the rewrite is still valid SSA, so it fires and
;; the assertion -- not the IR verifier -- is what catches it.
(define (opt-fc-test-maybe-local-bound
  [local-bound? : bool]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if local-bound?
    (opt-test-instrs-with-tail
      rest
      (ir.CompilerIrInstr.Mov 7 (Var 1) (opt-fc-test-i64)))
    rest))

(define (opt-fc-test-loop-block
  [loop : i64]
  [pred : i64]
  [exit : i64]
  [value : ir.CompilerIrValue]
  [checked? : bool]
  [step : i64]
  [bound : ir.CompilerIrValue]
  [local-bound? : bool]) : ir.CompilerIrBlock
  (Block
    loop
    (opt-test-instrs-with-tail
      (if checked?
        (opt-test-instrs-with-tail
          (opt-fc-test-loop-tail loop exit value step bound local-bound?)
          (irt.instr "bounds_check %3, %1 message \"fc.bounds\""))
        (opt-fc-test-loop-tail loop exit value step bound local-bound?))
      (ir.CompilerIrInstr.Phi
        3
        (ir.compiler-ir-phi-input-seq-prepend
          (I64 0)
          pred
          (&
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 5)
              loop
              (& (ir.compiler-ir-phi-input-seq-empty)))))
        (opt-fc-test-i64)))))

(define (opt-fc-test-exit-block [exit : i64]) : ir.CompilerIrBlock
  (Block exit (irt.instrs "return 0")))

(define (opt-fc-test-function
  [loop-name : String]
  [pred-name : String]
  [value : ir.CompilerIrValue]
  [checked? : bool]
  [step : i64]
  [bound : ir.CompilerIrValue]
  [local-bound? : bool]
  [frame : i64]) : ir.CompilerIrFunction
  (let
    [loop : i64 (opt-fc-test-label loop-name)]
    [pred : i64 (opt-fc-test-label pred-name)]
    [exit : i64 (opt-fc-test-label "fc.exit")]
    (Function
      (opt-test-symbol "fc_fn")
      (irt.params "base=%0:u64, bound=%1:i64")
      (opt-fc-test-i64)
      frame
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks "fc.exit:
                 return 0")
        (opt-fc-test-entry-block pred)
        (opt-fc-test-pred-block pred loop exit)
        (opt-fc-test-loop-block
          loop
          pred
          exit
          value
          checked?
          step
          bound
          local-bound?))
      Ordinary)))

;; The real post-`bce_version` clone body, instruction for instruction:
;;
;;   %3  = phi [0, pred], [%5, loop] : i64      counter
;;   %8  = phi [%2, pred], [%6, loop] : bool    the versioner's bool phi, whose
;;                                              back-edge input is the compare
;;   %9  = mov 0                                dead literal copy
;;   %10 = mov %3                               dead counter copy
;;   %4  = gep %0, %3
;;   store_ptr %4, 0
;;   %11 = mov 1                                dead literal copy
;;   %5  = add %3, 1
;;   %12 = mov %5                               copy of the next value
;;   %6  = lt %12, %1                           compare reads the COPY
;;   branch %6, loop, exit
(define (opt-fc-test-real-mov
  [dst : i64]
  [src : ir.CompilerIrValue]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    rest
    (ir.CompilerIrInstr.Mov dst src (opt-fc-test-i64))))

(define (opt-fc-test-real-loop-block [loop : i64] [pred : i64] [exit : i64]) : ir.CompilerIrBlock
  (Block
    loop
    (opt-test-instrs-with-tail
      (opt-fc-test-real-mov
        9
        (I64 0)
        (opt-fc-test-real-mov
          10
          (Var 3)
          (opt-test-instrs-with-tail
            (opt-fc-test-real-mov
              11
              (I64 1)
              (opt-test-instrs-with-tail
                (opt-fc-test-real-mov
                  12
                  (Var 5)
                  (opt-test-instrs
                    (irt.instr "%6 = lt %12, %1 : bool")
                    (ir.CompilerIrInstr.Branch (Var 6) loop exit)))
                (irt.instr "%5 = add %3, 1 : i64")))
            (irt.instr "%4 = gep %0, %3 : i64")
            (irt.instr "store_ptr %4, 0 : i64"))))
      (ir.CompilerIrInstr.Phi
        3
        (ir.compiler-ir-phi-input-seq-prepend
          (I64 0)
          pred
          (&
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 5)
              loop
              (& (ir.compiler-ir-phi-input-seq-empty)))))
        (opt-fc-test-i64))
      (ir.CompilerIrInstr.Phi
        8
        (ir.compiler-ir-phi-input-seq-prepend
          (Var 2)
          pred
          (&
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 6)
              loop
              (& (ir.compiler-ir-phi-input-seq-empty)))))
        (Bool)))))

(define (opt-fc-test-real-function) : ir.CompilerIrFunction
  (let
    [loop : i64 (opt-fc-test-label "while_body.7__bce_fast")]
    [pred : i64 (opt-fc-test-label "while_body.7__bce_guard")]
    [exit : i64 (opt-fc-test-label "fc.exit")]
    (Function
      (opt-test-symbol "fc_real_fn")
      (ir.compiler-ir-param-seq-prepend
        (Param "base" (U64) 0)
        (ir.compiler-ir-param-seq-prepend
          (Param "bound" (opt-fc-test-i64) 1)
          (ir.compiler-ir-param-seq-empty)))
      (opt-fc-test-i64)
      13
      (ir.compiler-ir-blocks
        (opt-fc-test-entry-block pred)
        (opt-fc-test-pred-block pred loop exit)
        (opt-fc-test-real-loop-block loop pred exit)
        (opt-fc-test-exit-block exit))
      Ordinary)))

(define (opt-fc-test-loop-instr-count [out : (& out ir.CompilerIrFunction)]) : i64
  (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-block-instr-count blocks 2)))

(define (opt-fc-test-loop-has-call?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(Call _ name _ _) (cbi.compiler-builtin-backend-tl-mem-fill8-id? name)]
    [_ false]))

(define (opt-fc-test-loop-has-store?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(StorePtr _ _ _) true]
    [_ false]))

(define (opt-fc-test-loop-ends-in-jump? [out : (& out ir.CompilerIrFunction)]) : bool
  (match (let
    [blocks
      (let
        [func (owned_view.compiler-owned-reference-shared-view out)]
        (opt.opt-function-blocks func))]
    (opt-gc-test-instr-at
      blocks
      2
      (-
        (let
          [out-2 (owned_view.compiler-owned-reference-shared-view out)]
          (opt-fc-test-loop-instr-count out-2))
        1)))
    [(Jump _) true]
    [_ false]))

(define (opt-fc-test-unchanged?
  [out : (& out ir.CompilerIrFunction)]
  [frame : i64]) : bool
  (and
    (= (opt.opt-function-frame out) frame)
    (not (opt-fc-test-loop-ends-in-jump? out))))

(define (opt-fc-test-loop-store-count
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    0
    (+
      (if (opt-fc-test-loop-has-store? out index)
        1
        0)
      (opt-fc-test-loop-store-count out (+ index 1) count))))

(define (opt-fc-test-plain
  [loop-name : String]
  [pred-name : String]
  [value : ir.CompilerIrValue]
  [checked? : bool]) : ir.CompilerIrFunction
  (opt-fill-call-function
    (opt-fc-test-function loop-name pred-name value checked? 1 (Var 1) false 7)))

(define (compiler-optimize-fill-call-self-test) : i64
  (let
    [f1 : ir.CompilerIrFunction
      (opt-fc-test-plain
        "while_body.1__bce_fast"
        "while_body.1__bce_guard"
        (I64 0)
        false)]
    [f2 : ir.CompilerIrFunction
      (opt-fc-test-plain "while_body.9" "while_body.9__preheader" (I64 0) true)]
    [f3 : ir.CompilerIrFunction
      (opt-fc-test-plain
        "while_body.3__bce_fast"
        "while_body.3__bce_guard"
        (Var 3)
        false)]
    [f4 : ir.CompilerIrFunction
      (opt-fc-test-plain
        "while_body.5__bce_fast"
        "while_body.5__somewhere_else"
        (I64 0)
        false)]
    [f5 : ir.CompilerIrFunction
      (opt-fill-call-function (opt-fc-test-real-function))]
    [f6 : ir.CompilerIrFunction
      (opt-fill-call-function
        (opt-fc-test-function
          "while_body.11__bce_fast"
          "while_body.11__bce_guard"
          (I64 0)
          false
          2
          (Var 1)
          false
          7))]
    [f7 : ir.CompilerIrFunction
      (opt-fill-call-function
        (opt-fc-test-function
          "while_body.13__bce_fast"
          "while_body.13__bce_guard"
          (I64 0)
          false
          1
          (Var 7)
          true
          8))]
    (cond
      ;; F1: phi, gep, call, mov(inext), lt, jump
      [(not (= (opt-fc-test-loop-instr-count f1) 6)) 1]
      [(not (opt-fc-test-loop-has-call? f1 2)) 2]
      [(not (= (opt-fc-test-loop-store-count f1 0 6) 0)) 3]
      [(not (opt-fc-test-loop-ends-in-jump? f1)) 4]
      [(not (= (opt.opt-function-frame f1) 8)) 5]
      [(not (opt-fc-test-unchanged? f2 7)) 10]
      [(not (opt-fc-test-loop-has-store? f2 3)) 11]
      [(not (opt-fc-test-unchanged? f3 7)) 20]
      [(not (opt-fc-test-loop-has-store? f3 2)) 21]
      [(not (opt-fc-test-unchanged? f4 7)) 30]
      [(not (opt-fc-test-loop-has-store? f4 2)) 31]
      ;; F5: 2 phis, mov, mov, gep, call, mov, mov(inext), mov, lt, jump
      [(not (= (opt-fc-test-loop-instr-count f5) 11)) 40]
      [(not (opt-fc-test-loop-has-call? f5 5)) 41]
      [(not (= (opt-fc-test-loop-store-count f5 0 11) 0)) 45]
      [(not (opt-fc-test-loop-ends-in-jump? f5)) 43]
      [(not (= (opt.opt-function-frame f5) 14)) 44]
      [(not (opt-fc-test-unchanged? f6 7)) 50]
      [(not (opt-fc-test-loop-has-store? f6 2)) 51]
      [(not (opt-fc-test-unchanged? f7 8)) 60]
      [(not (opt-fc-test-loop-has-store? f7 3)) 61]
      [else 42])))

;; --- element copy -> tl_mem_copy_fwd / tl_mem_copy8_fwd (copy_call) tests ----
;;
;; The fixture is the shape the versioner emits for `dst[i] = src[i]`: a
;; `__bce_fast` clone entered from its own `__bce_guard`, counter seeded 0,
;; step 1, invariant bound, with a Load feeding a StorePtr through two geps that
;; both index on the counter.
;;
;; C1  positive : the admitted shape becomes one tl_mem_copy_fwd call and a
;;                Jump; the loop, BOTH narrow memory operations' store side and
;;                the self edge are gone. Pins the call's operand order too --
;;                destination first, source second, byte count third -- because
;;                swapping them is a silent wrong-direction copy.
;; C2  negative : the CHECKED original (label `while_body.9`, entered from a
;;                preheader, carrying a BoundsCheck) is left exactly as it was.
;;                This is the trap rail: that path must keep aborting at the
;;                same element, and the call has no bounds check to abort on.
;; C3  positive : i64 elements instead of u8, with a NON-literal bound. Same
;;                rewrite, but to `tl_mem_copy8_fwd` -- the count is in slots,
;;                so the byte helper would copy an eighth of the range, and its
;;                byte-granular propagation is not this loop's anyway.
;; C4  negative : a fast clone whose predecessor is some other block, not the
;;                matching `__bce_guard`, loses the seed<bound fact. Without it
;;                a loop entered with seed >= bound still copies ONE byte (the
;;                body of a rotated do-while runs before any compare) where the
;;                call copies none.
;; C5  negative : step 2 -- the visited indices are not a contiguous byte run.
;; C6  negative : the destination gep is indexed by a loop-INVARIANT var rather
;;                than the counter, so its address does not advance and the
;;                loop is not a copy at all.
;; C7  negative : a second store in the body.
;; C8  negative : a u8 load feeding a u16 store -- the two widths must agree,
;;                and they must both be one byte.
;; C9  negative : the stored value is a literal, not the loaded byte. That is
;;                the FILL shape; fill_call owns it and copy_call must not
;;                claim it.
;; C10 positive : the destination index is `invariant + counter` (the shape
;;                `byte_buf/byte-buf-copy-slots-range-into` actually presents,
;;                where the caller passes a start offset), which still advances
;;                one byte per iteration.
;; C11 idempotence: re-running the pass on C1's output is a no-op -- the block
;;                no longer ends in a self branch, so nothing matches.
;; C12 negative : the exit block RETURNS the loaded byte. The rewrite keeps the
;;                load but runs it once at the seed index, so the escaping value
;;                would become the FIRST byte where the loop leaves the LAST.
;;                fill_call's escape check never sees a Load, which is why this
;;                pass carries its own.
;; C13 negative : i32 elements -- a width with no total forward-copy helper.
;;                Neither `rep movsb` nor `rep movsq` moves i32 elements
;;                atomically, so the classifier answers 0 and the block is
;;                refused before the body scan builds anything.
;; C14 negative : i64 elements with a LITERAL bound of 3, below
;;                `opt-copy-call-word-slot-floor`. No unrolled group runs at
;;                three trips, so the loop is 16 instructions against the
;;                helper's 12 to 17 -- a bet the pass declines.
;; C15 positive : the same loop with a literal bound of 4, the floor itself,
;;                rewrites to `tl_mem_copy8_fwd` (21 instructions against 13 to
;;                18). C14/C15 are the two sides of the floor, one trip apart,
;;                and pin its VALUE rather than merely that literal bounds are
;;                not banned.
;; C16 negative : an i64 store fed by a u8 load. The store fixes the width, and
;;                a load that disagrees means the body does not move eight bytes
;;                per iteration -- the wide-element twin of C8.
;; C17 positive : the counter is bumped BEFORE the body, so both geps are
;;                indexed by its `next` (`%8 = add %4, 1`). The rewrite redefines
;;                `%8` as `bound`, so the geps must read a fresh copy of the
;;                increment instead, the index the FIRST iteration used; left on
;;                `%8` the call would start `bound` elements past it.
;;
;; These negatives were checked load-bearing by mutating the implementation and
;; confirming THIS test is what fails, with the code it reports:
;;   * `opt-copy-call-elem-width` widened to answer 4 for I32 -> code 130 (C13
;;     wrongly rewrites).
;;   * `opt-copy-call-count-ok?` forced true -> code 140 (C14 wrongly rewrites).
;;   * `opt-copy-call-symbol` made to answer the byte helper for every width ->
;;     code 31 (C3's call names the wrong helper) and code 151 (C15).
;;   * `opt-copy-call-index-tracks?` short-circuited to true -> code 60 (C6).
;;   * `opt-copy-call-scan-body`'s second-store arm made to keep the first site
;;     instead of rejecting -> code 70 (C7).
;;   * `opt-copy-call-block-match`'s `width < 1` guard dropped -> codes 80 (C8)
;;     and 130 (C13): with no width there is nothing for the scan's own tests to
;;     disagree with, so every one of them compares 0 against 0 and passes.
;;   * `opt-copy-call-scan-body`'s Load-width arm dropped -> code 160 (C16).
;;   * `opt-copy-call-kept-instr` made to return its instruction unchanged ->
;;     code 172 (C17's source gep still reads `%8`).
;;   * `opt-copy-call-escape-ok?`'s Load arm dropped (i.e. reverting to
;;     `opt-fill-call-escape-ok?`, which never sees a Load) -> code 120 (C12).
;; C12 is why this pass has its own escape check at all. Its fixture carries the
;; value out through an exit phi: an exit block that returned `%6` directly
;; would be invalid SSA here (the loop does not dominate the exit), so the
;; pass's output verification would reject the rewrite for the wrong reason and
;; the fixture would pass against a broken check.
;;
;; C2, C4, C5 and C9 are structural rather than mutation-checked: C2/C4 turn on
;; the label and predecessor gates this pass shares verbatim with fill_call
;; (whose own suite mutation-checks them), C5 on fill_call's `(= step 1)`, and
;; C9 on the store value simply not being a Var, which no minimal mutation
;; expresses.
;;
;; The overlap semantics the two helpers differ on are not expressible against
;; the IR fixture -- they are a property of the emitted runtime code -- so they
;; are pinned end-to-end by tests/integration/copy_call_word.tl, which runs a
;; propagating in-place element shift through the real rewrite and checks the
;; values.
(define (opt-cc-test-label [name : String]) : i64
  (ir.compiler-ir-label (& name)))

(define (opt-cc-test-i64) : ast.AstType
  (I64))

(define (opt-cc-test-entry-block [pred : i64]) : ir.CompilerIrBlock
  (Block
    (opt-cc-test-label "cc.entry")
    (opt-test-instrs (ir.CompilerIrInstr.Jump pred))))

(define (opt-cc-test-pred-block
  [pred : i64]
  [loop : i64]
  [exit : i64]
  [bound : ir.CompilerIrValue]) : ir.CompilerIrBlock
  (Block
    pred
    (opt-test-instrs
      (ir.CompilerIrInstr.BinOp 3 (Lt) (I64 0) bound (Bool))
      (ir.CompilerIrInstr.Branch (Var 3) loop exit))))

;; The loop's bound: the `bound` parameter for the dynamic-trip fixtures, a
;; literal for the two that stand on either side of the word floor.
(define (opt-cc-test-bound-var) : ir.CompilerIrValue
  (Var 1))

;; `escape?` makes the exit block carry the loaded byte out through a phi on the
;; loop edge. The kept load runs once at the seed index, so a rewrite would hand
;; back the FIRST byte where the loop hands back the last one.
;;
;; It has to be a phi rather than a direct `return %6`: the loop block does NOT
;; dominate the exit block (the guard branches to exit as well), so naming the
;; loop's value straight from exit is invalid SSA and the pass's own output
;; verification would reject the rewrite for that reason instead of the escape
;; -- which is exactly how the first version of this fixture managed to pass
;; against a deliberately broken escape check.
(define (opt-cc-test-exit-block
  [exit : i64]
  [pred : i64]
  [loop : i64]
  [escape? : bool]) : ir.CompilerIrBlock
  (Block
    exit
    (if escape?
      (opt-test-instrs
        (ir.CompilerIrInstr.Phi
          12
          (ir.compiler-ir-phi-input-seq-prepend
            (I64 0)
            pred
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (Var 6)
                loop
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          (opt-cc-test-i64))
        (irt.instr "return %12"))
      (irt.instrs "return 0"))))

;; The optional `%10 = add %11, %4` that makes the destination index
;; `invariant + counter` (C10). %11 is a parameter, so it is loop-invariant.
(define (opt-cc-test-offset-add
  [offset-add? : bool]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if offset-add?
    (opt-test-instrs-with-tail rest (irt.instr "%10 = add %11, %4 : i64"))
    rest))

(define (opt-cc-test-second-store
  [second-store? : bool]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if second-store?
    (opt-test-instrs-with-tail rest (irt.instr "store_ptr %5, %6 : u8"))
    rest))

(define (opt-cc-test-loop-block
  [loop : i64]
  [pred : i64]
  [exit : i64]
  [elem-ty : ast.AstType]
  [store-ty : ast.AstType]
  [load-ty : ast.AstType]
  [store-value : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [checked? : bool]
  [step : i64]
  [offset-add? : bool]
  [invariant-index? : bool]
  [second-store? : bool]) : ir.CompilerIrBlock
  (Block
    loop
    (opt-test-instrs-with-tail
      (if checked?
        (opt-test-instrs-with-tail
          (opt-cc-test-loop-tail
            loop
            exit
            elem-ty
            store-ty
            load-ty
            store-value
            bound
            step
            offset-add?
            invariant-index?
            second-store?)
          (irt.instr "bounds_check %4, %1 message \"cc.bounds\""))
        (opt-cc-test-loop-tail
          loop
          exit
          elem-ty
          store-ty
          load-ty
          store-value
          bound
          step
          offset-add?
          invariant-index?
          second-store?))
      (ir.CompilerIrInstr.Phi
        4
        (ir.compiler-ir-phi-input-seq-prepend
          (I64 0)
          pred
          (&
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 8)
              loop
              (& (ir.compiler-ir-phi-input-seq-empty)))))
        (opt-cc-test-i64)))))

(define (opt-cc-test-loop-tail
  [loop : i64]
  [exit : i64]
  [elem-ty : ast.AstType]
  [store-ty : ast.AstType]
  [load-ty : ast.AstType]
  [store-value : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [step : i64]
  [offset-add? : bool]
  [invariant-index? : bool]
  [second-store? : bool]) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-cc-test-offset-add
      offset-add?
      (opt-test-instrs-with-tail
        (opt-cc-test-second-store
          second-store?
          (opt-test-instrs
            (ir.CompilerIrInstr.BinOp
              8
              (Add)
              (Var 4)
              (I64 step)
              (opt-cc-test-i64))
            (ir.CompilerIrInstr.BinOp 9 (Lt) (Var 8) bound (Bool))
            (ir.CompilerIrInstr.Branch (Var 9) loop exit)))
        (ir.CompilerIrInstr.Gep
          7
          (Var 2)
          (if invariant-index?
            (Var 11)
            (if offset-add?
              (Var 10)
              (Var 4)))
          elem-ty)
        (ir.CompilerIrInstr.StorePtr (Var 7) store-value store-ty)))
    (ir.CompilerIrInstr.Gep
      5
      (Var 0)
      (Var 4)
      (owned_view.compiler-owned-shared-view elem-ty))
    (ir.CompilerIrInstr.Load 6 (Var 5) load-ty)))

(define (opt-cc-test-function
  [loop-name : String]
  [pred-name : String]
  [elem-ty : ast.AstType]
  [store-ty : ast.AstType]
  [load-ty : ast.AstType]
  [store-value : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [checked? : bool]
  [step : i64]
  [offset-add? : bool]
  [invariant-index? : bool]
  [second-store? : bool]
  [escape? : bool]) : ir.CompilerIrFunction
  (let
    [loop : i64 (opt-cc-test-label loop-name)]
    [pred : i64 (opt-cc-test-label pred-name)]
    [exit : i64 (opt-cc-test-label "cc.exit")]
    (Function
      (opt-test-symbol "cc_fn")
      (irt.params "src=%0:u64, bound=%1:i64, dst=%2:u64, start=%11:i64")
      (opt-cc-test-i64)
      13
      (ir.compiler-ir-blocks
        (opt-cc-test-entry-block pred)
        (opt-cc-test-pred-block
          pred
          loop
          exit
          (ir.compiler-ir-global-shared-view bound))
        (opt-cc-test-loop-block
          loop
          pred
          exit
          elem-ty
          store-ty
          load-ty
          store-value
          bound
          checked?
          step
          offset-add?
          invariant-index?
          second-store?)
        (opt-cc-test-exit-block exit pred loop escape?))
      Ordinary)))

(define (opt-cc-test-loop-instr-count [out : (& out ir.CompilerIrFunction)]) : i64
  (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-block-instr-count blocks 2)))

;; The call, with its operands pinned: dst gep (%7), src gep (%5), bound (%1).
(define (opt-cc-test-loop-has-call?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(Call _ name args _)
      (and
        (cbi.compiler-builtin-backend-tl-mem-copy-fwd-id? name)
        (opt-cc-test-args-are? args 7 5 1))]
    [_ false]))

;; The eight-byte twin. The helper NAME is the whole of the width decision, so
;; it is checked as tightly as the operand order is: handing a slot count to the
;; byte helper copies an eighth of the range.
(define (opt-cc-test-loop-has-call8?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(Call _ name args _)
      (and
        (cbi.compiler-builtin-backend-tl-mem-copy8-fwd-id? name)
        (opt-cc-test-args-are? args 7 5 1))]
    [_ false]))

;; The literal-bound fixtures' call: same operands, but the count is the
;; literal the loop compared against rather than the `bound` parameter.
(define (opt-cc-test-loop-has-call8-const?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]
  [count : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(Call _ name args _)
      (and
        (cbi.compiler-builtin-backend-tl-mem-copy8-fwd-id? name)
        (opt-cc-test-const-args-are? args 7 5 count))]
    [_ false]))

(define (opt-cc-test-const-args-are?
  [args : ir.CompilerIrCallArgs]
  [dst : i64]
  [src : i64]
  [count : i64]) : bool
  (match args
    [(Array values)
      (and
        (= (array-length values) 3)
        (= (opt-cc-test-arg-var values 0) dst)
        (= (opt-cc-test-arg-var values 1) src)
        (= (opt-cc-test-arg-const values 2) count))]
    [_ false]))

(define (opt-cc-test-arg-const
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : i64
  (match (array-ref values index)
    [(I64 k) k]
    [_ (- 0 1)]))

(define (opt-cc-test-args-are?
  [args : ir.CompilerIrCallArgs]
  [dst : i64]
  [src : i64]
  [count : i64]) : bool
  (match args
    [(Array values)
      (and
        (= (array-length values) 3)
        (= (opt-cc-test-arg-var values 0) dst)
        (= (opt-cc-test-arg-var values 1) src)
        (= (opt-cc-test-arg-var values 2) count))]
    [_ false]))

(define (opt-cc-test-arg-var
  [values : (& values (__tl_dyn-array ir.CompilerIrValue))]
  [index : i64]) : i64
  (match (array-ref values index)
    [(Var id) id]
    [_ (- 0 1)]))

(define (opt-cc-test-loop-has-store?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(StorePtr _ _ _) true]
    [_ false]))

(define (opt-cc-test-loop-store-count
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    0
    (+
      (if (opt-cc-test-loop-has-store? out index)
        1
        0)
      (opt-cc-test-loop-store-count out (+ index 1) count))))

(define (opt-cc-test-loop-ends-in-jump? [out : (& out ir.CompilerIrFunction)]) : bool
  (match (let
    [blocks
      (let
        [func (owned_view.compiler-owned-reference-shared-view out)]
        (opt.opt-function-blocks func))]
    (opt-gc-test-instr-at
      blocks
      2
      (-
        (let
          [out-2 (owned_view.compiler-owned-reference-shared-view out)]
          (opt-cc-test-loop-instr-count out-2))
        1)))
    [(Jump _) true]
    [_ false]))

(define (opt-cc-test-unchanged? [out : (& out ir.CompilerIrFunction)]) : bool
  (and
    (= (opt.opt-function-frame out) 13)
    (not (opt-cc-test-loop-ends-in-jump? out))))

(define (opt-cc-test-byte) : ast.AstType
  (U8))

;; The admitted shape, with one knob turned.
(define (opt-cc-test-run
  [loop-name : String]
  [pred-name : String]
  [elem-ty : ast.AstType]
  [store-ty : ast.AstType]
  [load-ty : ast.AstType]
  [store-value : ir.CompilerIrValue]
  [bound : ir.CompilerIrValue]
  [checked? : bool]
  [step : i64]
  [offset-add? : bool]
  [invariant-index? : bool]
  [second-store? : bool]
  [escape? : bool]) : ir.CompilerIrFunction
  (opt-copy-call-function
    (opt-cc-test-function
      loop-name
      pred-name
      elem-ty
      store-ty
      load-ty
      store-value
      bound
      checked?
      step
      offset-add?
      invariant-index?
      second-store?
      escape?)))

;; The admitted shape at one element width, every other knob at its default.
;; `elem-ty` is the geps' and the load's type as well as the store's, which is
;; what the pass requires of a real copy body.
(define (opt-cc-test-run-width
  [loop-name : String]
  [pred-name : String]
  [elem-ty : ast.AstType]
  [bound : ir.CompilerIrValue]) : ir.CompilerIrFunction
  (opt-cc-test-run
    loop-name
    pred-name
    (owned_view.compiler-owned-shared-view elem-ty)
    (owned_view.compiler-owned-shared-view elem-ty)
    elem-ty
    (opt-cc-test-loaded)
    bound
    false
    1
    false
    false
    false
    false))

(define (opt-cc-test-loaded) : ir.CompilerIrValue
  (Var 6))

;; C17: the bump-first copy loop, `i = i + 1` then `dst[i] = src[i]`.
(define (opt-cc-test-next-index) : ir.CompilerIrFunction
  (opt-copy-call-function
    (irt.func
      "function @cc_fn(src=%0:u64, bound=%1:i64, dst=%2:u64) -> i64 vars 13 {
       cc.entry:
         jump while_body.33__bce_guard
       while_body.33__bce_guard:
         %3 = lt 0, %1 : bool
         branch %3, while_body.33__bce_fast, cc.exit
       while_body.33__bce_fast:
         %4 = phi [0, while_body.33__bce_guard], [%8, while_body.33__bce_fast] : i64
         %8 = add %4, 1 : i64
         %5 = gep %0, %8 : i64
         %6 = load %5 : i64
         %7 = gep %2, %8 : i64
         store_ptr %7, %6 : i64
         %9 = lt %8, %1 : bool
         branch %9, while_body.33__bce_fast, cc.exit
       cc.exit:
         return 0
       }")))

;; The offset var of the loop block's gep at `index`, or -1.
(define (opt-cc-test-gep-offset
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]) : i64
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(Gep _ _ (Var offset) _) offset]
    [_ -1]))

;; Whether the loop block's instruction at `index` is `%dst = add %4, 1`.
(define (opt-cc-test-seed-add?
  [out : (& out ir.CompilerIrFunction)]
  [index : i64]
  [dst : i64]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 2 index))
    [(BinOp d (Add) (Var 4) (I64 1) _) (= d dst)]
    [_ false]))

(define (compiler-optimize-copy-call-self-test) : i64
  (let
    [c1 : ir.CompilerIrFunction
      (opt-cc-test-run-width
        "while_body.1__bce_fast"
        "while_body.1__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-bound-var))]
    [c2 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.9"
        "while_body.9__preheader"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        true
        1
        false
        false
        false
        false)]
    [c3 : ir.CompilerIrFunction
      (opt-cc-test-run-width
        "while_body.3__bce_fast"
        "while_body.3__bce_guard"
        (opt-cc-test-i64)
        (opt-cc-test-bound-var))]
    [c4 : ir.CompilerIrFunction
      (opt-cc-test-run-width
        "while_body.5__bce_fast"
        "while_body.5__somewhere_else"
        (opt-cc-test-byte)
        (opt-cc-test-bound-var))]
    [c5 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.11__bce_fast"
        "while_body.11__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        2
        false
        false
        false
        false)]
    [c6 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.13__bce_fast"
        "while_body.13__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        1
        false
        true
        false
        false)]
    [c7 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.15__bce_fast"
        "while_body.15__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        1
        false
        false
        true
        false)]
    [c8 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.17__bce_fast"
        "while_body.17__bce_guard"
        (opt-cc-test-byte)
        (U16)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        1
        false
        false
        false
        false)]
    [c9 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.19__bce_fast"
        "while_body.19__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (I64 0)
        (opt-cc-test-bound-var)
        false
        1
        false
        false
        false
        false)]
    [c10 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.21__bce_fast"
        "while_body.21__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        1
        true
        false
        false
        false)]
    [c12 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.23__bce_fast"
        "while_body.23__bce_guard"
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        1
        false
        false
        false
        true)]
    [c13 : ir.CompilerIrFunction
      (opt-cc-test-run-width
        "while_body.25__bce_fast"
        "while_body.25__bce_guard"
        (I32)
        (opt-cc-test-bound-var))]
    [c14 : ir.CompilerIrFunction
      (opt-cc-test-run-width
        "while_body.27__bce_fast"
        "while_body.27__bce_guard"
        (opt-cc-test-i64)
        (I64 3))]
    [c15 : ir.CompilerIrFunction
      (opt-cc-test-run-width
        "while_body.29__bce_fast"
        "while_body.29__bce_guard"
        (opt-cc-test-i64)
        (I64 4))]
    [c16 : ir.CompilerIrFunction
      (opt-cc-test-run
        "while_body.31__bce_fast"
        "while_body.31__bce_guard"
        (opt-cc-test-i64)
        (opt-cc-test-i64)
        (opt-cc-test-byte)
        (opt-cc-test-loaded)
        (opt-cc-test-bound-var)
        false
        1
        false
        false
        false
        false)]
    [c17 : ir.CompilerIrFunction (opt-cc-test-next-index)]
    [c11 : ir.CompilerIrFunction
      (opt-copy-call-function (ir.compiler-ir-global-shared-view c1))]
    (cond
      ;; C1: phi, gep(src), load, gep(dst), call, mov(inext), lt, jump
      [(not (= (opt-cc-test-loop-instr-count c1) 8)) 1]
      [(not (opt-cc-test-loop-has-call? c1 4)) 2]
      [(not (= (opt-cc-test-loop-store-count c1 0 8) 0)) 3]
      [(not (opt-cc-test-loop-ends-in-jump? c1)) 4]
      [(not (= (opt.opt-function-frame c1) 14)) 5]
      [(not (opt-cc-test-unchanged? c2)) 20]
      [(not (opt-cc-test-loop-has-store? c2 5)) 21]
      ;; C3: same rewrite as C1, to the EIGHT-BYTE helper.
      [(not (= (opt-cc-test-loop-instr-count c3) 8)) 30]
      [(not (opt-cc-test-loop-has-call8? c3 4)) 31]
      [(not (= (opt-cc-test-loop-store-count c3 0 8) 0)) 32]
      [(not (opt-cc-test-loop-ends-in-jump? c3)) 33]
      [(not (opt-cc-test-unchanged? c4)) 40]
      [(not (opt-cc-test-unchanged? c5)) 50]
      [(not (opt-cc-test-unchanged? c6)) 60]
      [(not (opt-cc-test-unchanged? c7)) 70]
      [(not (opt-cc-test-unchanged? c8)) 80]
      [(not (opt-cc-test-unchanged? c9)) 90]
      ;; C10: phi, gep(src), load, add(offset), gep(dst), call, mov, lt, jump
      [(not (= (opt-cc-test-loop-instr-count c10) 9)) 100]
      [(not (opt-cc-test-loop-has-call? c10 5)) 101]
      [(not (= (opt-cc-test-loop-store-count c10 0 9) 0)) 102]
      ;; C11: idempotent -- the rewritten block is not a self-loop any more.
      [(not (= (opt-cc-test-loop-instr-count c11) 8)) 110]
      [(not (opt-cc-test-loop-has-call? c11 4)) 111]
      [(not (= (opt.opt-function-frame c11) 14)) 112]
      [(not (opt-cc-test-unchanged? c12)) 120]
      [(not (opt-cc-test-loop-has-store? c12 4)) 121]
      [(not (opt-cc-test-unchanged? c13)) 130]
      [(not (opt-cc-test-unchanged? c14)) 140]
      ;; C15: the literal bound at the floor's far side, handed over as the
      ;; slot count itself.
      [(not (= (opt-cc-test-loop-instr-count c15) 8)) 150]
      [(not (opt-cc-test-loop-has-call8-const? c15 4 4)) 151]
      [(not (= (opt-cc-test-loop-store-count c15 0 8) 0)) 152]
      [(not (opt-cc-test-unchanged? c16)) 160]
      ;; C17: phi, add(seed copy), mov(inext), gep(src), load, gep(dst), call,
      ;; lt, jump. The seed copy is %13 and the call %14.
      [(not (= (opt-cc-test-loop-instr-count c17) 9)) 170]
      [(not (opt-cc-test-seed-add? c17 1 13)) 171]
      [(not (= (opt-cc-test-gep-offset c17 3) 13)) 172]
      [(not (= (opt-cc-test-gep-offset c17 5) 13)) 173]
      [(not (opt-cc-test-loop-has-call8? c17 6)) 174]
      [(not (= (opt.opt-function-frame c17) 15)) 175]
      [else 42])))

;; --- latch increment sinking -------------------------------------------------
;;
;; The fixture is the `for` range shape with an `if` body: the header `head`
;; advances `%4 = add %2, 1` before the body, the body branches, and the latch
;; `latch` tests `%4 < n` and closes the loop. Blocks: entry 0, head 1, then 2,
;; latch 3, then exit (and `spin` in L6).
;;
;; L1 positive : the add leaves `head` (5 -> 4 instructions) and becomes the
;;               latch's first non-phi instruction, right before the compare.
;; L2 negative : the body (`then`) reads `%4`, so the add has a use outside the
;;               latch and stays.
;; L3 negative : `%4` reaches the exit through a phi input on an edge from
;;               `then`, not from the latch. It must be defined before `then`.
;; L4 negative : the step is the parameter `%0`, not a literal.
;; L5 negative : the latch's branch tests the sum, not `%4`, so the latch is not
;;               shown to be the loop-closing block of the counter.
;; L6 negative : the latch's other successor `spin` loops back to the latch
;;               without passing the header. The latch can then run more often
;;               than `head`, and the add would run with it.
;; L7 negative : `%4` is defined twice, the second time as `add %2, 5` in
;;               `then` (a shape only a function SSA construction left alone
;;               can have). `then` does not dominate the latch, so moving that
;;               add would change `%4` on the path that skips `then`.
;; L8 negative : the header phi `%2` is redefined in `then`, so `%2` at the
;;               latch is not the `%2` the add read in `head`.
;;
;; The negatives were checked load-bearing by mutating the implementation and
;; confirming THIS test is what fails, with the code it reports:
;;   * the latch-local use count test in `opt-latch-sink-sites` forced true ->
;;     code 20 (L2 moves).
;;   * the `phi-label` test forced true -> code 30 (L3 moves).
;;   * `opt-latch-sink-step?` accepting any right operand -> code 40 (L4 moves).
;;   * `opt-latch-sink-exit-target` ignoring whether the compare reads `%n` ->
;;     code 50 (L5 moves).
;;   * `opt-latch-sink-reaches?` answering false -> code 60 (L6 moves).
;;   * the `def-count` test of `%n` forced true -> code 70 (L7 moves).
;;   * the `def-count` test of the phi forced true -> code 80 (L8 moves).
(define (opt-ls-test-run [text : String]) : ir.CompilerIrFunction
  (opt.opt-latch-sink-function (irt.func text)))

(define (opt-ls-test-l1) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch] : i64
       return %10
     }"))

(define (opt-ls-test-l2) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, %4 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch] : i64
       return %10
     }"))

(define (opt-ls-test-l3) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       %11 = gt %6, 9 : bool
       branch %11, exit, latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch], [%4, then] : i64
       return %10
     }"))

(define (opt-ls-test-l4) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, %0 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch] : i64
       return %10
     }"))

(define (opt-ls-test-l5) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %7, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch] : i64
       return %10
     }"))

(define (opt-ls-test-l6) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 13 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then], [%7, spin] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, spin
     spin:
       %12 = gt %7, 100 : bool
       branch %12, exit, latch
     exit:
       %10 = phi [0, entry], [%7, spin] : i64
       return %10
     }"))

(define (opt-ls-test-l7) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       %4 = add %2, 5 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch] : i64
       return %10
     }"))

(define (opt-ls-test-l8) : ir.CompilerIrFunction
  (opt-ls-test-run
    "function @ls_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %9 = lt 0, %0 : bool
       branch %9, head, exit
     head:
       %2 = phi [0, entry], [%4, latch] : i64
       %3 = phi [0, entry], [%7, latch] : i64
       %4 = add %2, 1 : i64
       %5 = gt %2, 3 : bool
       branch %5, then, latch
     then:
       %6 = add %3, 1 : i64
       %2 = add %3, 9 : i64
       jump latch
     latch:
       %7 = phi [%3, head], [%6, then] : i64
       %8 = lt %4, %0 : bool
       branch %8, head, exit
     exit:
       %10 = phi [0, entry], [%7, latch] : i64
       return %10
     }"))

(define (opt-ls-test-head-count [out : (& out ir.CompilerIrFunction)]) : i64
  (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-block-instr-count blocks 1)))

(define (opt-ls-test-then-count [out : (& out ir.CompilerIrFunction)]) : i64
  (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-block-instr-count blocks 2)))

(define (opt-ls-test-latch-add? [out : (& out ir.CompilerIrFunction)]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 3 1))
    [(BinOp 4 (Add) (Var 2) (I64 1) _) true]
    [_ false]))

(define (opt-ls-test-latch-compare? [out : (& out ir.CompilerIrFunction)]) : bool
  (match (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks 3 2))
    [(BinOp 8 (Lt) (Var 4) _ _) true]
    [_ false]))

(define (compiler-optimize-latch-sink-self-test) : i64
  (let
    [l1 : ir.CompilerIrFunction (opt-ls-test-l1)]
    [l2 : ir.CompilerIrFunction (opt-ls-test-l2)]
    [l3 : ir.CompilerIrFunction (opt-ls-test-l3)]
    [l4 : ir.CompilerIrFunction (opt-ls-test-l4)]
    [l5 : ir.CompilerIrFunction (opt-ls-test-l5)]
    [l6 : ir.CompilerIrFunction (opt-ls-test-l6)]
    [l7 : ir.CompilerIrFunction (opt-ls-test-l7)]
    [l8 : ir.CompilerIrFunction (opt-ls-test-l8)]
    [l1-again : ir.CompilerIrFunction
      (opt.opt-latch-sink-function (ir.compiler-ir-global-shared-view l1))]
    (cond
      ;; L1: head is phi, phi, gt, branch; the latch is phi, add, lt, branch.
      [(not (= (opt-ls-test-head-count l1) 4)) 10]
      [(not (opt-ls-test-latch-add? l1)) 11]
      [(not (opt-ls-test-latch-compare? l1)) 12]
      ;; Idempotent: the moved add is already in the latch.
      [(not (= (opt-ls-test-head-count l1-again) 4)) 13]
      [(not (opt-ls-test-latch-add? l1-again)) 14]
      [(not (= (opt-ls-test-head-count l2) 5)) 20]
      [(not (= (opt-ls-test-head-count l3) 5)) 30]
      [(not (= (opt-ls-test-head-count l4) 5)) 40]
      [(not (= (opt-ls-test-head-count l5) 5)) 50]
      [(not (= (opt-ls-test-head-count l6) 5)) 60]
      ;; L7: neither def of `%4` moves; `then` keeps add, add, jump.
      [(not (= (opt-ls-test-then-count l7) 3)) 70]
      [(not (= (opt-ls-test-head-count l8) 5)) 80]
      [else 42])))

;; --- counter increment sinking -----------------------------------------------
;;
;; The fixtures are pre-SSA functions in the prelude `for` range shape: `pre`
;; (block 1) sets the counter `%2` and the end, `head` (block 2) compares, and
;; `body` (block 3) starts with the copy `%5 = mov %2` and the step
;; `%6 = add %2, 1`, `%2 = mov %6` before the user body. Blocks: entry 0,
;; pre 1, head 2, body 3, then the rest in order.
;;
;; C1 positive : the copy and the step leave `body`, the step closes it before
;;               `jump head`, and the sum reads `%2` for `%5`.
;; C2 positive : a `continue` block `skip` is a second latch; both get the step.
;; C3 positive : no copy; the body reads `%2` in a `gep` before the step, as an
;;               array loop does. The step moves, the `gep` stays.
;; N1 negative : the body reads `%2` after the step.
;; N2 negative : the exit reads `%2`, the counter after the loop.
;; N3 negative : the counter's first definition is in a block that branches
;;               rather than jumping to `head`.
;; N4 negative : the latch closes the loop with a conditional branch.
;; N5 partial  : the body reassigns the copy `%5`; the step moves, the copy
;;               stays.
;; N5' partial : the exit reads the copy `%5`; the step moves, the copy stays.
;; N6 partial  : the body takes the copy's address; the step moves, the copy
;;               stays.
;; N7 negative : `body` has a second predecessor, `extra`.
;; N8 negative : the step is the parameter `%0`, not a literal.
;; N9 negative : `head` has a third predecessor, `side`, that no path through
;;               `body` reaches.
;; S1 positive : the SSA shape: the header phi `%2` is stepped by `%5 = add %2,
;;               1`, `%6 = mov %5` feeding the phi from the latch; the pair
;;               moves before `jump head`.
;; S2 positive : the same with the add feeding the phi directly.
;; S3 negative : the body reads the stepped `%6`.
;;
;; The negatives were checked load-bearing by mutating the implementation and
;; confirming THIS test is what fails, with the code it reports:
;;   * the in-H plus in-B use count test in `opt-counter-sink-admit!` forced
;;     true -> code 41 (N1 moves).
;;   * the `jump head` test in `opt-counter-sink-jump-kind` forced true -> code
;;     60 (N3 moves; N4's conditional latch rests on the same test).
;;   * the copy's single-definition test forced true -> code 80.
;;   * the address-taken test in `opt-counter-sink-local-uses` dropped -> 90.
;;   * the single-predecessor test forced true -> code 100.
;;   * `opt-counter-sink-step` accepting any right operand -> code 110.
;;   * `opt-counter-sink-walk-after?` answering true -> code 82 (N5' drops its
;;     copy; N9 is the same walk for the latches).
;;   * the SSA shape's single-read test of `%n` dropped -> code 150 (S3 moves).
;; The pass over a function, and whether it changed it.
(defenum OptCsTestResult
  (Result ir.CompilerIrFunction bool))

(define (opt-cs-test-apply [func : ir.CompilerIrFunction]) : OptCsTestResult
  (match func
    [(Function name params ret-ty frame blocks function-abi)
      (match (opt.opt-counter-sink-blocks (& params) frame (& blocks))
        [(Result next changed)
          (Result (Function name params ret-ty frame next function-abi) changed)])]))

(define (opt-cs-test-run [text : String]) : ir.CompilerIrFunction
  (match (opt-cs-test-apply (irt.func text))
    [(Result func _) func]))

(define (opt-cs-test-count [out : (& out ir.CompilerIrFunction)] [block : i64]) : i64
  (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-block-instr-count blocks block)))

(define (opt-cs-test-instr
  [out : (& out ir.CompilerIrFunction)]
  [block : i64]
  [index : i64]) : ir.CompilerIrInstr
  (let
    [blocks (opt.opt-function-blocks out)]
    (opt-gc-test-instr-at blocks block index)))

;; Whether `instr` is the step `%6 = add %2, 1`.
(define (opt-cs-test-step? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(BinOp 6 (Add) (Var 2) (I64 1) _) true]
    [_ false]))

;; Whether block `block` ends with the step pair and `jump head`.
(define (opt-cs-test-latch? [out : (& out ir.CompilerIrFunction)] [block : i64]) : bool
  (let
    [count : i64 (opt-cs-test-count out block)]
    (and
      (opt-cs-test-step? (opt-cs-test-instr out block (- count 3)))
      (match (opt-cs-test-instr out block (- count 2))
        [(Mov 2 (Var 6) _) true]
        [_ false])
      (match (opt-cs-test-instr out block (- count 1))
        [(Jump _) true]
        [_ false]))))

(define (opt-cs-test-c1) : ir.CompilerIrFunction
  (opt-cs-test-run
    "function @cs_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %1 = mov 0 : i64
       jump pre
     pre:
       %2 = mov 0 : i64
       %3 = mov %0 : i64
       jump head
     head:
       %4 = lt %2, %3 : i64
       branch %4, body, exit
     body:
       %5 = mov %2 : i64
       %6 = add %2, 1 : i64
       %2 = mov %6 : i64
       %7 = add %1, %5 : i64
       %1 = mov %7 : i64
       jump head
     exit:
       return %1
     }"))

(define (opt-cs-test-c2) : ir.CompilerIrFunction
  (opt-cs-test-run
    "function @cs_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %1 = mov 0 : i64
       jump pre
     pre:
       %2 = mov 0 : i64
       %3 = mov %0 : i64
       jump head
     head:
       %4 = lt %2, %3 : i64
       branch %4, body, exit
     body:
       %5 = mov %2 : i64
       %6 = add %2, 1 : i64
       %2 = mov %6 : i64
       %8 = gt %5, 3 : i64
       branch %8, skip, rest
     skip:
       jump head
     rest:
       %7 = add %1, %5 : i64
       %1 = mov %7 : i64
       jump head
     exit:
       return %1
     }"))

(define (opt-cs-test-c3) : ir.CompilerIrFunction
  (opt-cs-test-run
    "function @cs_fn(p=%0:i64, n=%9:i64) -> i64 vars 12 {
     entry:
       %1 = mov 0 : i64
       jump pre
     pre:
       %2 = mov 0 : i64
       %3 = mov %9 : i64
       jump head
     head:
       %4 = lt %2, %3 : i64
       branch %4, body, exit
     body:
       %5 = gep %0, %2 : i64
       %6 = add %2, 1 : i64
       %2 = mov %6 : i64
       %8 = load %5 : i64
       %7 = add %1, %8 : i64
       %1 = mov %7 : i64
       jump head
     exit:
       return %1
     }"))

