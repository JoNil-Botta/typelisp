                   %9 = phi [%8, join], [%10, body] : i64
                   %11 = gep %7, 0 : i64
                   %12 = load %11 : i64
                   %13 = gep %2, 0 : i64
                   store_ptr %13, 9 : i64
                   %10 = add %9, 1 : i64
                   branch %0, body, exit
                 body:
                   jump loop
                 exit:
                   return %12"))))))))

(cfg
  test
  (define (opt-licm-summary-memory-barrier? [instr : ir.CompilerIrInstr]) : bool
    (not (opt.opt-licm-store-summary-clean? (opt-licm-summary-for-instr instr)))))

;; --- CALLMEM-ROOTS: the sret slot and the callee's own allocas ---------------
;;
;; `sret_callee` stores its result through the hidden `__sret` parameter and
;; fills a temporary it allocated itself. Its call-memory row names a write
;; through parameter 1 and nothing unknown: the slot is the object the caller
;; handed over, and the temporary is the callee's own frame. With the slot
;; renamed -- a raw `u64` the lowering did not spell -- the same store is an
;; unknown write again, and a store through a non-pointer parameter is unknown
;; in every variant.
(define (opt-callmem-roots-params [sret-name : String]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (ir.CompilerIrParam.Param "kind" (ast.AstType.I64) 0)
    (ir.compiler-ir-param-seq-prepend
      (ir.CompilerIrParam.Param sret-name (ast.AstType.U64) 1)
      (ir.compiler-ir-param-seq-empty))))

;; mode 0: the sret store and a store into an alloca of the callee's own;
;; 1: the sret store alone; 2: a store through the non-pointer `kind`.
(define (opt-callmem-roots-body [mode : i64]) : ir.CompilerIrInstrSeq
  (cond
    [(= mode 2) (irt.instrs "store_ptr %0, 1 : i64")]
    [(= mode 1)
      (irt.instrs "%2 = gep %1, 0 : u8
         store_ptr %2, %0 : i64")]
    [else
      (irt.instrs
        "%2 = gep %1, 0 : u8
         store_ptr %2, %0 : i64
         %3 = alloc i64
         %4 = addr_of %3
         store_ptr %4, 5 : i64")]))

;; The callee's call-memory row, or -1 when the builder left it unresolved.
(define (opt-callmem-roots-row [sret-name : String] [mode : i64]) : i64
  (let
    [rows : opt_i64_i64_map.Map
      (opt.opt-call-memory-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq1
          (opt-inline-sret-callee
            (opt-callmem-roots-params sret-name)
            (opt-callmem-roots-body mode)))
        8)]
    (match (opt_i64_i64_map.get
      (& rows)
      (ir.compiler-ir-symbol-id (opt-test-symbol "sret_callee")))
      [(opt_i64_i64_map.LookupFound row) row]
      [(opt_i64_i64_map.LookupMissing) (- 0 1)])))

(define (compiler-optimize-call-memory-frame-roots-self-test) : i64
  (let
    [sret : i64
      (opt-callmem-roots-row (ir.compiler-ir-hidden-sret-param-name) 0)]
    [sret-only : i64
      (opt-callmem-roots-row (ir.compiler-ir-hidden-sret-param-name) 1)]
    [raw : i64 (opt-callmem-roots-row "raw" 1)]
    [source-name : i64 (opt-callmem-roots-row "__sret" 1)]
    [scalar : i64
      (opt-callmem-roots-row (ir.compiler-ir-hidden-sret-param-name) 2)]
    (cond
      [(< sret 0) 1]
      ;; the sret store is a write through parameter 1...
      [(not (opt.opt-call-memory-summary-param-write? sret 1)) 2]
      ;; ...and neither it nor the alloca store is unknown
      [(opt.opt-call-memory-summary-unknown? sret) 3]
      [(opt.opt-call-memory-summary-param-write? sret 0) 4]
      [(< sret-only 0) 5]
      [(opt.opt-call-memory-summary-unknown? sret-only) 6]
      ;; a raw u64 parameter under another name keeps the older reading
      [(< raw 0) 7]
      [(not (opt.opt-call-memory-summary-unknown? raw)) 8]
      ;; A source-spellable `__sret` is still just an ordinary raw u64 param.
      [(< source-name 0) 11]
      [(not (opt.opt-call-memory-summary-unknown? source-name)) 12]
      ;; a store through a non-pointer parameter is unknown whatever the slot
      [(< scalar 0) 9]
      [(not (opt.opt-call-memory-summary-unknown? scalar)) 10]
      [else 42])))

;; --- SRET-SITE: a callee that writes only through a frame object ------------
;;
;; `loop` loads the array parameter's data slot every trip and calls `touch`
;; with one pointer argument. When touch's call-memory row names a write
;; through parameter 0 and nothing unknown, and the argument is the address of
;; an object THIS function allocated, the write lands in the frame and the
;; load hoists. The raw pointer parameter as the argument, a row with an
;; unknown write, or no row at all each keep the load in the loop. Modes 1
;; and 2 replace the call with a store into the frame object (FRAME-STORE):
;; the descriptor load still moves, and a load of the stored word does not.
(define (opt-licm-frame-call-blocks [arg-var : i64] [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %5 = mov 0 : i64
         %12 = alloc i64
         jump loop")
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instrs
          (irt.instr "%6 = phi [%5, entry], [%7, body] : i64")
          (irt.instr "%8 = gep %1, 0 : i64")
          (irt.instr "%9 = load %8 : i64")
          (ir.CompilerIrInstr.AddrOf 13 12)
          ;; mode 0: the call; 1 and 2: a store into the frame object
          ;; instead (FRAME-STORE); 2 also reads that word back below
          (if (= mode 0)
            (ir.CompilerIrInstr.Call
              11
              (opt-test-symbol "touch")
              (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var arg-var))
              (ast.AstType.I64))
            (irt.instr "store_ptr %13, 7 : i64"))
          (if (= mode 2)
            (irt.instr "%14 = load %13 : i64")
            (irt.instr "%14 = mov 1 : i64"))
          (irt.instr "%7 = add %6, %14 : i64")
          (irt.instr "branch %0, body, exit")))
      (irt.blocks
        "body:
           jump loop
         exit:
           return %9"))))

;; touch's call-memory row: a write through parameter 0, with or without an
;; unknown write beside it.
(define (opt-licm-frame-call-map [unknown? : bool]) : opt_i64_i64_map.Map
  (let
    [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 4)]
    [row : i64
      (if unknown?
        (opt.opt-call-memory-summary-add-unknown 1)
        1)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut map)
        (ir.compiler-ir-symbol-id (opt-test-symbol "touch"))
        row)
      map)))

(define (opt-licm-frame-call-run
  [arg-var : i64]
  [mode : i64]
  [call-memory : opt_i64_i64_map.Map]) : ir.CompilerIrFunction
  (opt.opt-licm-function-with-global-cells
    (ast.ast-node-pool-reader-type-segment-bases)
    (let
      [cell : opt.OptGlobalCellSummary (opt.opt-global-cell-summary-empty)]
      (begin
        (set! cell.call-memory call-memory)
        cell))
    true
    (opt-licm-array-test-function (opt-licm-frame-call-blocks arg-var mode))))

(define (opt-licm-frame-call-loop-loads
  [arg-var : i64]
  [mode : i64]
  [call-memory : opt_i64_i64_map.Map]) : i64
  (opt-count-load-label-blocks
    (opt.opt-function-blocks (opt-licm-frame-call-run arg-var mode call-memory))
    (ir.compiler-ir-label "loop")))

(define (compiler-optimize-licm-frame-call-self-test) : i64
  (cond
    ;; the frame object's address: the load leaves the loop
    [(not
        (=
          (opt-licm-frame-call-loop-loads 13 0 (opt-licm-frame-call-map false))
          0))
      1]
    [(not
        (opt.opt-verify-ok?
          (opt.opt-verify-function
            (opt-licm-frame-call-run 13 0 (opt-licm-frame-call-map false)))))
      2]
    ;; the raw pointer parameter: nothing says where that write lands
    [(not
        (=
          (opt-licm-frame-call-loop-loads 2 0 (opt-licm-frame-call-map false))
          1))
      3]
    ;; an unknown write beside the parameter write
    [(not
        (=
          (opt-licm-frame-call-loop-loads 13 0 (opt-licm-frame-call-map true))
          1))
      4]
    ;; no row: the callee is opaque
    [(not
        (=
          (opt-licm-frame-call-loop-loads
            13
            0
            (opt_i64_i64_map.with-capacity 1))
          1))
      5]
    ;; FRAME-STORE: a store into the frame object in place of the call leaves
    ;; the descriptor load free to move...
    [(not
        (=
          (opt-licm-frame-call-loop-loads
            13
            1
            (opt_i64_i64_map.with-capacity 1))
          0))
      6]
    [(not
        (opt.opt-verify-ok?
          (opt.opt-verify-function
            (opt-licm-frame-call-run 13 1 (opt_i64_i64_map.with-capacity 1)))))
      7]
    ;; ...while a load of the stored frame word itself stays put
    [(not
        (=
          (opt-licm-frame-call-loop-loads
            13
            2
            (opt_i64_i64_map.with-capacity 1))
          1))
      8]
    [else 42]))

(cfg
  test
  (define (compiler-optimize-licm-checked-root-self-test) : i64
    (let
      [ref-ty : ast.AstType (ast.ast-ty-ref 0 (ast.AstType.I64))]
      [mut-ref-ty : ast.AstType (ast.ast-ty-mut-ref 0 (ast.AstType.I64))]
      [ref-distinct-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 2 0)))]
      [ref-distinct : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view ref-distinct-func))]
      [mut-distinct-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 2 0)))]
      [mut-distinct : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view mut-distinct-func))]
      [same-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 1 0)))]
      [same : ir.CompilerIrBlockList (opt.opt-function-blocks same-func)]
      [shared-store-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 4 0)))]
      [shared-store : ir.CompilerIrBlockList
        (opt.opt-function-blocks shared-store-func)]
      [raw-store-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 3 0)))]
      [raw-store : ir.CompilerIrBlockList
        (opt.opt-function-blocks raw-store-func)]
      [copybytes-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 2 1)))]
      [copybytes : ir.CompilerIrBlockList
        (opt.opt-function-blocks copybytes-func)]
      [call-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 2 2)))]
      [call-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks call-func)]
      ;; The clean-callee refinement of opt-licm-memory-safe?: the same
      ;; direct-call barrier as `call-blocks`, but with the callee named in the
      ;; direct-call-clean map. `call-blocks` above keeps the absent-summary
      ;; negative (nothing proves `touch` clean, so the load stays put); this
      ;; arm is the positive, and `clean-indirect` shows the map cannot rescue a
      ;; call site with no callee name to look up.
      [clean-touch-map : opt_i64_i64_map.Map
        (let
          [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 4)]
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut map)
              (ir.compiler-ir-symbol-id (opt-test-symbol "touch"))
              1)
            map))]
      [clean-call-func : ir.CompilerIrFunction
        (opt.opt-licm-function-with-direct-call-clean
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 2 2))
          (opt.compiler-opt-global-shared-view clean-touch-map))]
      [clean-call : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view clean-call-func))]
      [clean-indirect-func : ir.CompilerIrFunction
        (opt.opt-licm-function-with-direct-call-clean
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-blocks 1 2 3))
          clean-touch-map)]
      [clean-indirect : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view clean-indirect-func))]
      [fresh-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-fresh-blocks)))]
      [fresh : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view fresh-func))]
      [fresh-header-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-fresh-header-blocks)))]
      [fresh-header : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view fresh-header-func))]
      [join-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt.compiler-opt-global-shared-view mut-ref-ty)
            (opt.compiler-opt-global-shared-view ref-ty)
            (opt-licm-checked-root-join-blocks false)))]
      [join-blocks : ir.CompilerIrBlockList
        (opt.opt-function-blocks
          (opt.compiler-opt-global-shared-view join-func))]
      [mixed-join-func : ir.CompilerIrFunction
        (opt.opt-licm-function
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-licm-checked-root-function
            (opt.compiler-opt-global-shared-view ref-ty)
            mut-ref-ty
            ref-ty
            (opt-licm-checked-root-join-blocks true)))]
      [mixed-join : ir.CompilerIrBlockList
        (opt.opt-function-blocks mixed-join-func)]
      ;; Separate checked-reference parameters are not a no-alias proof while
      ;; explicit shallow views can retain ownership edges between them. Only a
      ;; fresh allocation or an independent pointer-class proof may separate a
      ;; loop load from a store.
      (cond
        [(not (opt.opt-verify-ok? (opt.opt-verify-function ref-distinct-func)))
          1]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view ref-distinct)
                (ir.compiler-ir-label "entry"))
              0))
          2]
        [(not
            (=
              (opt-count-load-label-blocks
                ref-distinct
                (ir.compiler-ir-label "loop"))
              1))
          3]
        [(not (opt.opt-verify-ok? (opt.opt-verify-function mut-distinct-func)))
          4]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view mut-distinct)
                (ir.compiler-ir-label "entry"))
              0))
          5]
        [(not
            (=
              (opt-count-load-label-blocks
                mut-distinct
                (ir.compiler-ir-label "loop"))
              1))
          6]
        [(not
            (=
              (opt-count-load-label-blocks same (ir.compiler-ir-label "loop"))
              1))
          7]
        [(not
            (=
              (opt-count-load-label-blocks
                shared-store
                (ir.compiler-ir-label "loop"))
              1))
          8]
        [(not
            (=
              (opt-count-load-label-blocks
                raw-store
                (ir.compiler-ir-label "loop"))
              1))
          9]
        [(not
            (=
              (opt-count-load-label-blocks
                copybytes
                (ir.compiler-ir-label "loop"))
              1))
          10]
        [(not
            (=
              (opt-count-load-label-blocks
                call-blocks
                (ir.compiler-ir-label "loop"))
              1))
          11]
        [(not (opt.opt-verify-ok? (opt.opt-verify-function fresh-func))) 12]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view fresh)
                (ir.compiler-ir-label "entry"))
              1))
          13]
        [(not
            (=
              (opt-count-load-label-blocks fresh (ir.compiler-ir-label "loop"))
              0))
          14]
        [(not (opt.opt-verify-ok? (opt.opt-verify-function join-func))) 15]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view join-blocks)
                (ir.compiler-ir-label "join"))
              0))
          16]
        [(not
            (=
              (opt-count-load-label-blocks
                join-blocks
                (ir.compiler-ir-label "loop"))
              1))
          17]
        [(not
            (=
              (opt-count-load-label-blocks
                mixed-join
                (ir.compiler-ir-label "loop"))
              1))
          18]
        [(not
            (opt-licm-summary-memory-barrier?
              (irt.instr "store @global, 1 : i64")))
          19]
        [(not
            (opt-licm-summary-memory-barrier?
              (ir.ir-instr-vector-store
                (ir.CompilerIrValue.Var 1)
                (ir.CompilerIrValue.I64 0)
                (ir.CompilerIrValue.I64 1)
                4
                (ast.AstType.I64))))
          20]
        [(not
            (opt-licm-summary-memory-barrier?
              (ir.ir-instr-predicated-store
                (ir.CompilerIrValue.Var 1)
                (ir.CompilerIrValue.I64 0)
                (ir.CompilerIrValue.I64 1)
                (ir.CompilerIrValue.I64 15)
                4
                (ast.AstType.I64))))
          21]
        [(not
            (opt-licm-summary-memory-barrier?
              (ir.CompilerIrInstr.Syscall 90 (ir.CompilerIrCallArgs.Nil))))
          22]
        [(not (opt.opt-verify-ok? (opt.opt-verify-function fresh-header-func)))
          23]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view fresh-header)
                (ir.compiler-ir-label "entry"))
              2))
          24]
        [(not
            (=
              (opt-count-load-label-blocks
                fresh-header
                (ir.compiler-ir-label "loop"))
              0))
          25]
        [(not (opt.opt-verify-ok? (opt.opt-verify-function clean-call-func)))
          26]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view clean-call)
                (ir.compiler-ir-label "entry"))
              0))
          27]
        [(not
            (=
              (opt-count-load-label-blocks
                clean-call
                (ir.compiler-ir-label "loop"))
              1))
          28]
        [(not
            (opt.opt-verify-ok? (opt.opt-verify-function clean-indirect-func)))
          29]
        [(not
            (=
              (opt-count-load-label-blocks
                (opt.compiler-opt-global-shared-view clean-indirect)
                (ir.compiler-ir-label "entry"))
              0))
          30]
        [(not
            (=
              (opt-count-load-label-blocks
                clean-indirect
                (ir.compiler-ir-label "loop"))
              1))
          31]
        [else 42]))))

(define (opt-licm-word-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (ir.CompilerIrParam.Param
      "slice"
      (ast.ast-ty-ref 0 (ast.ast-ty-slice (ast.AstType.I64)))
      0)
    (ir.compiler-ir-param-seq-prepend
      (ir.CompilerIrParam.Param "again" (ast.AstType.Bool) 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-licm-word-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov 0 : i64
       jump loop
     loop:
       %3 = phi [%2, entry], [%4, loop] : i64
       %5 = word %0, 0 : u64
       %6 = word %0, 1 : i64
       bounds_check %3, %6 message \"word_bounds_ok\"
       %7 = gep %5, %3 : i64
       %8 = load %7 : i64
       %4 = add %3, 1 : i64
       branch %1, loop, exit
     exit:
       return %8"))

(define (opt-licm-word-count-at [blocks : ir.CompilerIrBlockList] [label : i64]) : i64
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) (- 0 1)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs) (opt-count-word-instr-seq instrs)])]))

(define (compiler-optimize-licm-word-self-test) : i64
  (let
    [result : ir.CompilerIrFunction
      (opt.opt-licm-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.CompilerIrFunction.Function
          (opt-test-symbol "licm_word")
          (opt-licm-word-params)
          (ast.AstType.I64)
          9
          (opt-licm-word-blocks)
          ir.CompilerIrFunctionAbi.Ordinary))]
    [blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view result))]
    (cond
      [(not (opt.opt-verify-ok? (opt.opt-verify-function result))) 1]
      [(not
          (=
            (opt-licm-word-count-at
              (ir.compiler-ir-global-shared-view blocks)
              (ir.compiler-ir-label "entry"))
            2))
        2]
      [(not (= (opt-licm-word-count-at blocks (ir.compiler-ir-label "loop")) 0))
        3]
      [else 42])))

(define (compiler-optimize-licm-self-test) : i64
  (let
    [symbols : OptLicmTestSymbols (opt-licm-test-symbols)]
    [arith-func : ir.CompilerIrFunction
      (opt-licm-late-optimized-function (opt-licm-arithmetic-blocks))]
    [arith : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view arith-func))]
    [arith-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-licm-arithmetic-blocks))]
    [word-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-licm-word-blocks))]
    [trap-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-trap-blocks))]
    [trap : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view trap-func))]
    [trap-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-licm-trap-blocks))]
    [call-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-call-blocks))]
    [call-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view call-func))]
    [no-preheader-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-no-preheader-blocks))]
    [no-preheader : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view no-preheader-func))]
    [no-preheader-loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt-licm-no-preheader-blocks))]
    [nested-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-nested-blocks))]
    [nested : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view nested-func))]
    [load-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-load-blocks))]
    [load-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view load-func))]
    [load-store-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-load-store-blocks))]
    [load-store : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view load-store-func))]
    [load-call-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-load-call-blocks))]
    [load-call : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view load-call-func))]
    [load-varying-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-load-varying-address-blocks))]
    [load-varying : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view load-varying-func))]
    [header-element-func : ir.CompilerIrFunction
      (opt-licm-array-optimized-function
        (opt-licm-header-load-element-store-blocks))]
    [header-element : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view header-element-func))]
    [header-element-chain-func : ir.CompilerIrFunction
      (opt-licm-array-optimized-function
        (opt-licm-header-load-element-gep-chain-store-blocks))]
    [header-element-chain : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view header-element-chain-func))]
    [header-vector-func : ir.CompilerIrFunction
      (opt-licm-array-late-optimized-function
        (opt-licm-header-load-vector-store-blocks 0))]
    [header-vector : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view header-vector-func))]
    [header-predicated-func : ir.CompilerIrFunction
      (opt-licm-array-late-optimized-function
        (opt-licm-header-load-vector-store-blocks 1))]
    [header-predicated : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view header-predicated-func))]
    [raw-vector-func : ir.CompilerIrFunction
      (opt-licm-array-late-optimized-function
        (opt-licm-header-load-vector-store-blocks 2))]
    [raw-vector : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view raw-vector-func))]
    [header-store-func : ir.CompilerIrFunction
      (opt-licm-array-optimized-function
        (opt-licm-header-load-header-store-blocks))]
    [header-store : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view header-store-func))]
    [copybytes-func : ir.CompilerIrFunction
      (opt-licm-array-optimized-function
        (opt-licm-header-load-copybytes-blocks))]
    [copybytes-blocks : ir.CompilerIrBlockList
