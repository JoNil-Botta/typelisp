(define (opt-gvn-scoped-nearest-dominator-ok?) : bool
  (let
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-scalar-params)
        (opt-gvn-nearest-scope-blocks))]
    (and
      (=
        (opt-blocks-mov-src-var
          (compiler_ir_types.compiler-ir-global-shared-view out)
          4
          (- 0 1))
        3)
      (=
        (opt-blocks-mov-src-var
          (compiler_ir_types.compiler-ir-global-shared-view out)
          5
          (- 0 1))
        4))))

;; The Pack is in `entry`, while its Var-backed Word extraction is in the
;; dominated `use` block. Global forwarding must rewrite the binop operand to
;; parameter v1; the array DCE then removes both the Word copy and the now-dead
;; Pack.
(define (opt-global-pack-word-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Pack
          2
          (compiler_ir_types.compiler-ir-value-seq-prepend
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-value-seq-empty)))
          (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Word
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            1
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-global-pack-word-forwarded-blocks) : compiler_ir_types.CompilerIrBlockList
  (let
    [forwarded : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-global-value-number-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-function
          "global_pack_word"
          (opt-gvn-test-params)
          (compiler_ast_types.AstType.I64)
          (opt-global-pack-word-blocks)))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view forwarded))]
    [uses : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array
        16
        (compiler_optimize.compiler-opt-global-shared-view blocks))]
    (compiler_optimize.opt-dce-block-list-array uses blocks)))

;; --- wide-literal operand suppression ---------------------------------------
;;
;; Pins `opt-global-copy-keep-wide-left`: a constant that no operand can encode
;; as an immediate stays a Var reference at its use, so its defining Mov keeps
;; the hoistable form the bit-test rewrite (and LICM) built.
;;
;; Left operand of the BinOp defining `dst`: its var id while it is still a Var,
;; -1 once copy propagation replaced it with a literal, -2 when no such BinOp
;; survives.
(define (opt-wide-literal-lhs-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>=
    index
    (compiler_ir_types.compiler-ir-instr-seq-count
      (compiler_ir_types.compiler-ir-global-shared-view instrs)))
    (- 0 2)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.BinOp actual _ lhs _ _)
        (if (= actual dst)
          (match lhs
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-wide-literal-lhs-instr-seq instrs (+ index 1) dst))]
      [_ (opt-wide-literal-lhs-instr-seq instrs (+ index 1) dst)])))

(define (opt-wide-literal-lhs-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 2)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64 (opt-wide-literal-lhs-instr-seq instrs 0 dst)]
            (if (= found (- 0 2))
              (opt-wide-literal-lhs-var
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-wide-literal-lhs-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; Right operand of the BinOp defining `dst`, same encoding as the left probe.
(define (opt-wide-literal-rhs-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>=
    index
    (compiler_ir_types.compiler-ir-instr-seq-count
      (compiler_ir_types.compiler-ir-global-shared-view instrs)))
    (- 0 2)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.BinOp actual _ _ rhs _)
        (if (= actual dst)
          (match rhs
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-wide-literal-rhs-instr-seq instrs (+ index 1) dst))]
      [_ (opt-wide-literal-rhs-instr-seq instrs (+ index 1) dst)])))

(define (opt-wide-literal-rhs-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 2)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64 (opt-wide-literal-rhs-instr-seq instrs 0 dst)]
            (if (= found (- 0 2))
              (opt-wide-literal-rhs-var
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-wide-literal-rhs-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; `entry` defines the constant and jumps to the block it dominates, which shifts
;; it by a parameter. This is the bit-test mask shape: the constant is one block
;; up (a preheader, once a loop is around it) and the count is not constant, so
;; the shift can never fold.
(define (opt-wide-literal-cross-block-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Shr
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; Same two blocks with the constant on the RIGHT. The backend's own wide-RHS
;; relief covers this position, so the fold must survive untouched.
(define (opt-wide-literal-cross-block-rhs-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.BitAnd)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The constant and its use in ONE block. Nothing is hoistable here, so the
;; literal must still reach the operand -- the global sweep declines it by
;; position and the block-local copy propagation in the scalar folder does it,
;; which is what the whole-pipeline probe below checks.
(define (opt-wide-literal-same-block-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          4
          (compiler_ir_types.CompilerIrBinOp.Shr
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 4)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

;; The global sweep followed by DCE, so a Mov that survives is one the sweep
;; deliberately kept a use for.
(define (opt-wide-literal-gvn-blocks
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (let
    [propagated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-global-value-number-function
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            name
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            blocks)))]
    [uses : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array
        16
        (compiler_optimize.compiler-opt-global-shared-view propagated))]
    (compiler_optimize.opt-dce-block-list-array uses propagated)))

(define (opt-wide-literal-optimized-blocks
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (compiler_optimize.optimize-function
      (compiler_ast_types.ast-node-pool-reader-context-current)
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-gvn-function
        name
        (opt-gvn-scalar-params)
        (compiler_ast_types.AstType.I64)
        blocks))))

;; A 64-bit window mask of the shape `opt-bit-test-mask-block` builds: well
;; outside imm32, so no operand can encode it.
(define (opt-wide-literal-mask) : i64
  4899916392364504625)

(define (compiler-optimize-wide-literal-operand-self-test) : i64
  (let
    [wide-left : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "wide_left"
        (opt-wide-literal-cross-block-blocks (opt-wide-literal-mask)))]
    [imm32-left : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "imm32_left"
        (opt-wide-literal-cross-block-blocks 1234567))]
    [wide-right : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "wide_right"
        (opt-wide-literal-cross-block-rhs-blocks (opt-wide-literal-mask)))]
    [same-block : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-optimized-blocks
        "wide_same_block"
        (opt-wide-literal-same-block-blocks (opt-wide-literal-mask)))]
    (cond
      ;; The wide constant stays a Var operand and its defining Mov survives,
      ;; which is what leaves the constant hoistable.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view wide-left)
              4)
            3))
        1]
      [(not
          (=
            (opt-count-mov-i64-value-blocks wide-left (opt-wide-literal-mask))
            1))
        2]
      ;; An imm32 constant is an immediate in the same position, so it folds
      ;; exactly as before and its Mov dies.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view imm32-left)
              4)
            (- 0 1)))
        3]
      [(not (= (opt-count-mov-i64-value-blocks imm32-left 1234567) 0)) 4]
      ;; Right operands keep folding at any width.
      [(not (= (opt-wide-literal-rhs-var wide-right 4) (- 0 1))) 5]
      ;; Nothing to hoist inside one block: the pipeline still folds.
      [(not (= (opt-wide-literal-lhs-var same-block 4) (- 0 1))) 6]
      [else 42])))

;; --- load-GVN substitution mode ---------------------------------------------
;;
;; Every fixture below reads the same `ptr` parameter (var 1) twice, so the
;; second read is redundant with the first and opt-load-cse-core-load rewrites
;; it to `Mov 4 <- Var 3`. Only the shape around the reads changes, which is
;; what decides whether substitution mode deletes that copy.
(define (opt-load-subst-read [dst : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Load
    dst
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ast_types.AstType.I64)))

(define (opt-load-subst-double [dst : i64] [src : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    dst
    (compiler_ir_types.CompilerIrBinOp.Add)
    (compiler_ir_types.CompilerIrValue.Var src)
    (compiler_ir_types.CompilerIrValue.Var src)
    (compiler_ast_types.AstType.I64)))

(define (opt-load-subst-jump [label : String]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Jump
    (compiler_ir_types.compiler-ir-label label)))

(define (opt-load-subst-branch [on-true : String] [on-false : String]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Branch
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.compiler-ir-label on-true)
    (compiler_ir_types.compiler-ir-label on-false)))

(define (opt-load-subst-return [var : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Return
    (compiler_ir_types.CompilerIrMaybeValue.Some
      (compiler_ir_types.CompilerIrValue.Var var))))

;; Diamond: the join's read is redundant with the entry's, and its only use is
;; an ordinary operand, so the copy goes and the operand reads the entry load.
(define (opt-load-subst-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-load-subst-read 3)
        (opt-load-subst-branch "then" "else")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs (opt-load-subst-jump "join")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs (opt-load-subst-jump "join")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (opt-load-subst-read 4)
              (opt-load-subst-double 5 4)
              (opt-load-subst-return 5)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Phi-carried: the redundant read's ONLY use is a phi input, whose use position
;; is the incoming edge rather than the phi's block. The substituter refuses phi
;; inputs, so the use survives and the copy stays -- today's Mov form.
(define (opt-load-subst-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-load-subst-read 3)
        (opt-load-subst-branch "then" "else")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs (opt-load-subst-read 4) (opt-load-subst-jump "join")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs (opt-load-subst-jump "join")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                5
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 4)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 3)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (opt-load-subst-return 5)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Loop escape: the dominating read is INSIDE the loop and the redundant read is
;; after it, so substituting would pin the loop's value across every later
;; block. The profitability gate refuses; the copy stays.
(define (opt-load-subst-loop-escape-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs (opt-load-subst-jump "header")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (opt-load-subst-read 3)
          (opt-load-subst-branch "body" "exit")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs (opt-load-subst-jump "header")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (opt-load-subst-read 4)
              (opt-load-subst-double 5 4)
              (opt-load-subst-return 5)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Same loop: both reads live in the same loop body, so substitution extends the
;; value only where it already lives. The gate allows it and the copy goes.
(define (opt-load-subst-loop-inner-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs (opt-load-subst-jump "header")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (opt-load-subst-read 3)
          (opt-load-subst-branch "inner" "exit")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "inner")
          (opt-test-instrs
            (opt-load-subst-read 4)
            (opt-load-subst-double 5 4)
            (opt-load-subst-jump "header")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs (opt-load-subst-return 3)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-load-subst-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-gvn-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-gvn-pointer-cond-params)
    blocks))

;; --- MF-2 join phis and MF-3 bypass-edge load PRE -----------------------------
;;
;; `cond` is var 0 and `arr` var 1, a descriptor handle -- the dereferenceable
;; base MF-3 admits. The scalar-pointer families above reuse
;; opt-gvn-pointer-cond-params, whose `ptr` is a plain i64 and therefore is NOT
;; a hoistable base; both parameter sets are needed to separate the two rules.
(define (opt-load-join-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "arr"
        (compiler_ast_types.AstType.DynArray 0)
        1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-load-join-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-gvn-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-load-join-params)
    blocks))

;; `count` chained `mov` definitions from var `base`, so a loop that uses them
;; all is over the live-in budget.
(define (opt-load-join-pressure-defs
  [acc : (&mut acc compiler_ir_types.CompilerIrInstrBuilder)]
  [base : i64]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler_ir_types.compiler-ir-instr-builder-push!
            acc
            (compiler_ir_types.CompilerIrInstr.Mov
              (+ base index)
              (compiler_ir_types.CompilerIrValue.I64 (+ 7 index))
              (compiler_ast_types.AstType.I64)))
          (set! index (+ index 1))))
      unit)))

;; `count - 1` chained adds reading every var the definitions above bound, so
;; each of them is a live-in of the block that holds this run.
(define (opt-load-join-pressure-uses
  [acc : (&mut acc compiler_ir_types.CompilerIrInstrBuilder)]
  [base : i64]
  [count : i64]
  [dst : i64]) : unit
  (let
    [index : i64 1]
    (begin
      (while (< index count)
        (begin
          (compiler_ir_types.compiler-ir-instr-builder-push!
            acc
            (compiler_ir_types.CompilerIrInstr.BinOp
              (+ dst index)
              (compiler_ir_types.CompilerIrBinOp.Add)
              (if (= index 1)
                (compiler_ir_types.CompilerIrValue.Var base)
                (compiler_ir_types.CompilerIrValue.Var (+ dst (- index 1))))
              (compiler_ir_types.CompilerIrValue.Var (+ base index))
              (compiler_ast_types.AstType.I64)))
          (set! index (+ index 1))))
      unit)))

(define (opt-load-join-pressure-count) : i64
  16)

;; A guard diamond whose two arms load one word into two names: the intersect at
;; `join` drops the key, MF-2 phis the two names instead.
(define (opt-load-join-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Load
              4
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Load
                5
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 5)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; The same diamond, but the join is the preheader of a loop that is already
;; over opt-licm-frozen-chain-live-in-budget live-ins: the phi would be one
;; more, so the budget refuses it.
(define (opt-load-join-budget-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-builder-to-seq
        (let
          [built : compiler_ir_types.CompilerIrInstrBuilder
            (compiler_ir_types.compiler-ir-instr-builder-with-capacity
              (+ (opt-load-join-pressure-count) 1))]
          (begin
            (opt-load-join-pressure-defs
              (&mut built)
              20
              (opt-load-join-pressure-count))
            (compiler_ir_types.compiler-ir-instr-builder-push!
              (&mut built)
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "then")
                (compiler_ir_types.compiler-ir-label "else")))
            built))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Load
              4
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "header")
              (compiler_ir_types.compiler-ir-instr-builder-to-seq
                (let
                  [built : compiler_ir_types.CompilerIrInstrBuilder
                    (compiler_ir_types.compiler-ir-instr-builder-with-capacity
                      (+ (opt-load-join-pressure-count) 2))]
                  (begin
                    (opt-load-join-pressure-uses
                      (&mut built)
                      20
                      (opt-load-join-pressure-count)
                      60)
                    (compiler_ir_types.compiler-ir-instr-builder-push!
                      (&mut built)
                      (compiler_ir_types.CompilerIrInstr.Load
                        6
                        (compiler_ir_types.CompilerIrValue.Var 1)
                        (compiler_ast_types.AstType.I64)))
                    (compiler_ir_types.compiler-ir-instr-builder-push!
                      (&mut built)
                      (compiler_ir_types.CompilerIrInstr.Branch
                        (compiler_ir_types.CompilerIrValue.Var 0)
                        (compiler_ir_types.compiler-ir-label "header")
                        (compiler_ir_types.compiler-ir-label "exit")))
                    built))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 6)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

;; The partially redundant shape MF-3 owns: the descriptor word is loaded only
;; on the guarded arm, so the join loses it and re-derives it. `base?` false
;; bases the arm's gep on a DATA POINTER instead of the handle, which is not
;; dereferenceable on the bypass edge and must be refused.
(define (opt-load-pre-bypass-blocks [handle-base? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Gep
          10
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          11
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "arm")
          (compiler_ir_types.compiler-ir-label "join"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "arm")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Gep
            2
            (compiler_ir_types.CompilerIrValue.Var
              (if handle-base?
                1
                11))
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "join")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Gep
              4
              (compiler_ir_types.CompilerIrValue.Var
                (if handle-base?
                  1
                  11))
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Load
              5
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Gep
              6
              (compiler_ir_types.CompilerIrValue.Var
                (if handle-base?
                  1
                  11))
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Load
              7
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 7)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-load-pre-latch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "latch"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "latch")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "arm")
              (compiler_ir_types.compiler-ir-label "header"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "arm")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Gep
                2
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Load
                3
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Gep
                  4
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Load
                  5
                  (compiler_ir_types.CompilerIrValue.Var 4)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Gep
                  6
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Load
                  7
                  (compiler_ir_types.CompilerIrValue.Var 6)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 7)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

;; The hoist destination is a loop header already at the live-in budget: the
;; hoisted value would be one more value live across a loop that is already
;; paying for as many as the budget allows.
(define (opt-load-pre-pressure-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-builder-to-seq
        (let
          [built : compiler_ir_types.CompilerIrInstrBuilder
            (compiler_ir_types.compiler-ir-instr-builder-with-capacity
              (+ (opt-load-join-pressure-count) 1))]
          (begin
            (opt-load-join-pressure-defs
              (&mut built)
              20
              (opt-load-join-pressure-count))
            (compiler_ir_types.compiler-ir-instr-builder-push!
              (&mut built)
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header")))
            built))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "arm")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "arm")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Gep
              2
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Load
              3
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.compiler-ir-instr-builder-to-seq
              (let
                [built : compiler_ir_types.CompilerIrInstrBuilder
                  (compiler_ir_types.compiler-ir-instr-builder-with-capacity
                    (+ (opt-load-join-pressure-count) 1))]
                (begin
                  (opt-load-join-pressure-uses
                    (&mut built)
                    20
                    (opt-load-join-pressure-count)
                    60)
                  (compiler_ir_types.compiler-ir-instr-builder-push!
                    (&mut built)
                    (compiler_ir_types.CompilerIrInstr.Branch
                      (compiler_ir_types.CompilerIrValue.Var 0)
                      (compiler_ir_types.compiler-ir-label "header")
                      (compiler_ir_types.compiler-ir-label "exit")))
                  built))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Gep
                  4
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Load
                  5
                  (compiler_ir_types.CompilerIrValue.Var 4)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Gep
                  6
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Load
                  7
                  (compiler_ir_types.CompilerIrValue.Var 6)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 7)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (compiler-optimize-load-join-pre-self-test) : i64
  (let
    [diamond : compiler_ir_types.CompilerIrBlockList
      (opt-load-join-run (opt-load-join-diamond-blocks))]
    [budget : compiler_ir_types.CompilerIrBlockList
      (opt-load-join-run (opt-load-join-budget-blocks))]
    [bypass : compiler_ir_types.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-bypass-blocks true))]
    [element : compiler_ir_types.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-bypass-blocks false))]
    [latch : compiler_ir_types.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-latch-blocks))]
    [pressure : compiler_ir_types.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-pressure-blocks))]
    (cond
      ;; MF-2: the two arms' names become one phi in the join, and the join's
      ;; own load reads it instead of repeating the read.
      [(not
          (=
            (opt-count-phi-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond))
            1))
        50]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond))
            2))
        51]
      [(not
          (=
            (opt-count-load-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond)
              (compiler_ir_types.compiler-ir-label "join"))
            0))
        52]
      ;; MF-2 budget: the join is the preheader of a loop already over the
      ;; live-in budget, so no phi is minted at all.
      [(not (= (opt-count-phi-blocks budget) 0)) 53]
      ;; MF-3: the guarded arm's `gep ; load` moves into the guard block, so the
      ;; join reuses it and the function loads the word once.
      [(not
          (=
            (opt-count-load-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view bypass)
              (compiler_ir_types.compiler-ir-label "arm"))
            0))
        54]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view bypass))
            2))
        55]
      ;; MF-3 refuses an element base: a data pointer read out of the descriptor
      ;; is not dereferenceable on the edge the guard was protecting.
      [(not
          (=
            (opt-count-load-label-blocks
              element
              (compiler_ir_types.compiler-ir-label "arm"))
            1))
        56]
      ;; MF-3 refuses a loop latch as the destination.
      [(not
          (=
            (opt-count-load-label-blocks
              latch
              (compiler_ir_types.compiler-ir-label "latch"))
            0))
        57]
      ;; MF-3 refuses a destination in a loop already at the live-in budget.
      [(not
          (=
            (opt-count-load-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view pressure)
              (compiler_ir_types.compiler-ir-label "header"))
            0))
        58]
      [(not
          (=
            (opt-count-load-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view pressure)
              (compiler_ir_types.compiler-ir-label "arm"))
            1))
        59]
      [else 42])))

(define (compiler-optimize-load-gvn-substitution-self-test) : i64
  (let
    [diamond : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-diamond-blocks))]
    [diamond-again : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-run (opt-load-subst-diamond-blocks)))]
    [phi : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-phi-blocks))]
    [loop-escape : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-escape-blocks))]
    [loop-inner : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-inner-blocks))]
    (cond
      ;; Diamond: one load left, no copy, and the operand reads the dominating
      ;; load directly.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond))
            1))
        1]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond)
              4)
            0))
        2]
      [(not (= (opt-blocks-binop-lhs-var diamond 5 (- 0 1)) 3)) 3]
      ;; Idempotent: a second pass over the substituted blocks changes nothing.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond-again))
            1))
        4]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond-again)
              4)
            0))
        5]
      [(not (= (opt-blocks-binop-lhs-var diamond-again 5 (- 0 1)) 3)) 6]
      ;; Phi-carried use: the copy survives as the Mov form, phi input intact.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view phi))
            1))
        7]
      [(not (= (opt-blocks-mov-src-var phi 4 (- 0 1)) 3)) 8]
      ;; Loop escape: rewritten, but left as a copy rather than pinning the
      ;; loop's value across the exit.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view loop-escape))
            1))
        9]
      [(not
          (=
            (opt-blocks-mov-src-var
              (compiler_optimize.compiler-opt-global-shared-view loop-escape)
              4
              (- 0 1))
            3))
        10]
      [(not (= (opt-blocks-binop-lhs-var loop-escape 5 (- 0 1)) 4)) 11]
      ;; Same loop: substituted, exactly like the diamond.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view loop-inner))
            1))
        12]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view loop-inner)
              4)
            0))
        13]
      [(not (= (opt-blocks-binop-lhs-var loop-inner 5 (- 0 1)) 3)) 14]
      ;; The join-phi (MF-2) and bypass-edge load PRE (MF-3) families run from
      ;; here, so they are covered by this suite's one registered entry point.
      [else (compiler-optimize-load-join-pre-self-test)])))

(define (opt-global-simd-copy-select-var-instr-seq-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [read-mask? : bool]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Select payload-box)
        (let
          [actual-dst
            (compiler_optimize.compiler-opt-box-field-shared-view
              payload-box
              dst)]
          [value
            (if read-mask?
              (compiler_optimize.compiler-opt-box-field-shared-view
                payload-box
                mask)
              (compiler_optimize.compiler-opt-box-field-shared-view
                payload-box
                on-true))]
          (if (= actual-dst dst)
            (match value
              [(compiler_ir_types.CompilerIrValue.Var var) var]
              [_ (- 0 1)])
            (opt-global-simd-copy-select-var-instr-seq-from
              instrs
              (+ index 1)
              dst
              read-mask?)))]
      [_
        (opt-global-simd-copy-select-var-instr-seq-from
          instrs
          (+ index 1)
          dst
          read-mask?)])))

(define (opt-global-simd-copy-select-var-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [read-mask? : bool]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 1)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64
              (opt-global-simd-copy-select-var-instr-seq-from
                instrs
                0
                dst
                read-mask?)]
            (if (= found (- 0 1))
              (opt-global-simd-copy-select-var-blocks
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst
                read-mask?)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-global-simd-copy-select-var-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        read-mask?)]))

(define (opt-global-simd-copy-vector-lhs-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 1)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64 (opt-vector-binop-lhs-var instrs dst)]
            (if (= found (- 0 1))
              (opt-global-simd-copy-vector-lhs-blocks
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-global-simd-copy-vector-lhs-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-global-simd-copy-reduce-src-instr-seq-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.VectorReduce actual _ src _ _)
        (if (= actual dst)
          (match src
            [(compiler_ir_types.CompilerIrValue.Var var) var]
            [_ (- 0 1)])
          (opt-global-simd-copy-reduce-src-instr-seq-from
            instrs
            (+ index 1)
            dst))]
      [_
        (opt-global-simd-copy-reduce-src-instr-seq-from instrs (+ index 1) dst)])))

(define (opt-global-simd-copy-reduce-src-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 1)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64
              (opt-global-simd-copy-reduce-src-instr-seq-from instrs 0 dst)]
            (if (= found (- 0 1))
              (opt-global-simd-copy-reduce-src-blocks
                (compiler_ir_types.compiler-ir-box-shared-view rest)
                dst)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-global-simd-copy-reduce-src-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; A vector and mask alias are defined in the entry and consumed in its
;; dominated body. The second Select uses a distinct computed mask, so the
;; copy sweep must forward the aliases without conflating active masks.
(define (opt-global-simd-copy-dominated-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.MaskNot
          3
          (compiler_ir_types.CompilerIrValue.Var 0)
          4)
        (compiler_ir_types.CompilerIrInstr.Mov
          4
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          5
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "body"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "body")
        (opt-test-instrs
          (compiler_ir_types.ir-instr-vector-bin-op
            6
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 2)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-select
            7
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.CompilerIrValue.Var 2)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-select
            8
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.CompilerIrValue.Var 2)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.VectorReduce
            9
            (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
            (compiler_ir_types.CompilerIrValue.Var 8)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 9)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

;; Duplicate definitions model a mutable pre-SSA clone destination. The global
;; pass is SSA-gated, so it must return this input unchanged rather than treating
;; the first copy fact as a function-wide vector identity.
(define (opt-global-simd-copy-redefined-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "clone"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "clone")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.VectorReduce
            4
            (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
            (compiler_ir_types.CompilerIrValue.Var 3)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

;; Each arm has its own vector alias. Edge-aware copy forwarding may simplify
;; the Phi inputs, but it must not substitute either arm's value through the
;; join's Phi destination.
(define (opt-global-simd-copy-join-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              4
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                5
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 3)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.VectorReduce
                6
                (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
                (compiler_ir_types.CompilerIrValue.Var 5)
                4
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 6)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-global-simd-copy-run
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (compiler_optimize.opt-global-value-number-function
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-gvn-function
        name
        (opt-gvn-scalar-params)
        (compiler_ast_types.AstType.I64)
        blocks))))

(define (opt-global-simd-copy-dominated-out) : compiler_ir_types.CompilerIrBlockList
  (let
    [forwarded : compiler_ir_types.CompilerIrBlockList
      (opt-global-simd-copy-run
        "global_simd_copy_dominated"
        (opt-global-simd-copy-dominated-blocks))]
    [uses : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array
        16
        (compiler_optimize.compiler-opt-global-shared-view forwarded))]
    (compiler_optimize.opt-dce-block-list-array uses forwarded)))

(define (compiler-optimize-global-simd-copy-self-test) : i64
  (let
    [dominated : compiler_ir_types.CompilerIrBlockList
      (opt-global-simd-copy-dominated-out)]
    [redefined : compiler_ir_types.CompilerIrBlockList
      (opt-global-simd-copy-run
        "global_simd_copy_redefined"
        (opt-global-simd-copy-redefined-blocks))]
    [join : compiler_ir_types.CompilerIrBlockList
      (opt-global-simd-copy-run
        "global_simd_copy_join"
        (opt-global-simd-copy-join-blocks))]
    (cond
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              4)
            0))
        1]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              5)
            0))
        2]
      [(not
          (=
            (opt-global-simd-copy-vector-lhs-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              6)
            1))
        3]
      [(not
          (=
            (opt-global-simd-copy-select-var-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              7
              true)
            0))
        4]
      [(not
          (=
            (opt-global-simd-copy-select-var-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              7
              false)
            6))
        5]
      ;; The second Select's distinct active mask must remain distinct.
      [(not
          (=
            (opt-global-simd-copy-select-var-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              8
              true)
            3))
        6]
      ;; The verifier rejects the duplicate clone destination, so no copy fact
      ;; crosses its redefinition.
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view redefined)
              3)
            2))
        7]
      [(not (= (opt-global-simd-copy-reduce-src-blocks redefined 4) 3)) 8]
      ;; The join use still reads the Phi result rather than either arm-local
      ;; alias.
      [(not (= (opt-global-simd-copy-reduce-src-blocks join 6) 5)) 9]
      [else 42])))

(test
  global-simd-copy-dominance
  (test.assert-i64-eq
    (compiler-optimize-global-simd-copy-self-test)
    42
    "global SIMD copies propagate only through dominating stable identities and keep masks and joins distinct"))

(define (compiler-optimize-global-value-number-self-test) : i64
  (let
    [dominated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_dominated"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-dominated-diamond-blocks))))]
    [sibling : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_sibling"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-sibling-blocks))))]
    [loop : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_loop"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-phi-loop-blocks))))]
    [load-safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-barrier-blocks))]
    [load-join-safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-join-safe-blocks))]
    [load-store-path : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-store-path-blocks))]
    [single-load-store-forward : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (opt-gvn-single-load-store-forward-blocks))]
    [load-call-path : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-call-path-blocks))]
    [checked-ref-store-path : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-checked-ref-cond-params)
        (opt-gvn-checked-ref-store-path-blocks false))]
    [checked-ref-root-loss : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-checked-ref-cond-params)
        (opt-gvn-checked-ref-store-path-blocks true))]
    [load-address-redef : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-address-redef-blocks))]
    [load-type-mismatch : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-type-mismatch-blocks))]
    [copy : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_copy"
            (opt-gvn-pointer-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-copy-blocks))))]
    [cast : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_cast"
            (opt-gvn-pointer-params)
            (compiler_ast_types.AstType.I32)
            (opt-gvn-cast-blocks))))]
    [gep : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_gep"
            (opt-gvn-pointer-params)
            (compiler_ast_types.AstType.U8)
            (opt-gvn-gep-blocks))))]
    [global-gep : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-global-value-number-function
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_global_gep"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-global-gep-call-blocks))))]
    [pack-word : compiler_ir_types.CompilerIrBlockList
      (opt-global-pack-word-forwarded-blocks)]
    (cond
      [(not
          (=
            (opt-count-arith-blocks
              (compiler_optimize.compiler-opt-global-shared-view dominated))
            1))
        1]
      ;; The branch-local copies feed only phi edges. Edge-aware forwarding
      ;; rewrites both inputs to the dominating value, then DCE removes them.
      [(not
          (=
            (opt-blocks-mov-src-var
              (compiler_optimize.compiler-opt-global-shared-view dominated)
              4
              (- 0 1))
            (- 0 1)))
        2]
      [(not (= (opt-blocks-mov-src-var dominated 5 (- 0 1)) (- 0 1))) 3]
      [(not (= (opt-count-arith-blocks sibling) 2)) 4]
      [(not
          (=
            (opt-count-arith-blocks
              (compiler_optimize.compiler-opt-global-shared-view loop))
            1))
        5]
      [(not (= (opt-blocks-mov-src-var loop 4 (- 0 1)) (- 0 1))) 6]
      ;; The forwarded read's only use is the return value, which substitution
      ;; mode redirects to the dominating load before deleting the copy.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view load-safe))
            1))
        7]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view load-safe)
              4)
            0))
        8]
      [(not (= (opt-blocks-return-var load-safe (- 0 1)) 3)) 43]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view load-join-safe))
            1))
        9]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view load-join-safe)
              4)
            0))
        10]
      [(not (= (opt-blocks-return-var load-join-safe (- 0 1)) 3)) 44]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                load-store-path))
            2))
        11]
      [(not (= (opt-blocks-mov-src-var load-store-path 4 (- 0 1)) (- 0 1))) 12]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view load-call-path))
            2))
        13]
      [(not (= (opt-blocks-mov-src-var load-call-path 4 (- 0 1)) (- 0 1))) 14]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                load-address-redef))
            2))
        15]
      [(not (= (opt-blocks-mov-src-var load-address-redef 4 (- 0 1)) (- 0 1)))
        16]
      [(not (= (opt-count-load-blocks load-type-mismatch) 2)) 17]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view copy)
              4
              (- 0 1))
            1))
        18]
      [(not (= (opt-count-mov-dst-blocks copy 3) 0)) 19]
      [(not
          (=
            (opt-count-cast-blocks
              (compiler_optimize.compiler-opt-global-shared-view cast))
            0))
        20]
      [(not (= (opt-count-mov-dst-blocks cast 4) 0)) 21]
      [(not
          (=
            (opt-count-gep-blocks
              (compiler_optimize.compiler-opt-global-shared-view gep))
            1))
        22]
      [(not (= (opt-count-mov-dst-blocks gep 4) 0)) 23]
      [(not (opt-global-expr-hash-collision-guard-ok?)) 24]
      [(not (opt-gvn-hash-collision-guard-ok?)) 25]
      [(not (opt-gvn-scoped-nearest-dominator-ok?)) 26]
      [(not
          (=
            (opt-count-gep-label-blocks
              global-gep
              (compiler_ir_types.compiler-ir-label "use"))
            1))
        27]
      [(match (compiler_optimize.opt-global-key-for-instr
          (compiler_ir_types.CompilerIrInstr.Gep
            9
            (compiler_ir_types.CompilerIrValue.Global (opt-test-symbol "pool"))
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64)))
          [(compiler_optimize.OptMaybeGlobalExprKey.Some _) true]
          [(compiler_optimize.OptMaybeGlobalExprKey.No) false])
        28]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                checked-ref-store-path))
            1))
        29]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                checked-ref-store-path)
              4)
            0))
        30]
      [(not (= (opt-blocks-return-var checked-ref-store-path (- 0 1)) 3)) 45]
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                checked-ref-root-loss))
            2))
        31]
      [(not
          (= (opt-blocks-mov-src-var checked-ref-root-loss 4 (- 0 1)) (- 0 1)))
        32]
      ;; The forwarded value is a literal, so substitution mode puts the 9 in
      ;; the return operand and drops the copy entirely.
      [(not
          (=
            (opt-count-load-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                single-load-store-forward))
            0))
        33]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                single-load-store-forward)
              3)
            0))
        34]
      [(not (= (opt-blocks-return-i64 single-load-store-forward (- 0 1)) 9)) 46]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view pack-word)
              4
              (- 0 1))
            1))
        35]
      [(not
          (=
            (opt-count-words-blocks
              (compiler_optimize.compiler-opt-global-shared-view pack-word))
            0))
        36]
      [(not (= (opt-count-packs-blocks pack-word) 0)) 37]
      [else (compiler-optimize-global-simd-copy-self-test)])))

;; Regression fixture for the global-GVN stale-global-read miscompile: the
;; entry block computes a Gep off the CURRENT value of mutable global `pool`,
;; one branch calls a function that may replace `pool`, and the join block
;; recomputes the same Gep. Forwarding the entry Gep into the join would read
;; the pre-call array's capacity address (the opt2 self-build bounds abort in
;; `ty-node-push` once the node pool grew).
(define (opt-gvn-global-gep-call-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Gep
          3
          (compiler_ir_types.CompilerIrValue.Global (opt-test-symbol "pool"))
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          4
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "grow")
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "grow")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            5
            (opt-test-symbol "grow_pool")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "use"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "use")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Gep
              6
              (compiler_ir_types.CompilerIrValue.Global
                (opt-test-symbol "pool"))
              (compiler_ir_types.CompilerIrValue.I64 8)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Load
              7
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 7)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-sccp-cross-block-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 20)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "rhs"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "rhs")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            1
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 22)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 1)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-sccp-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              2
              (compiler_ir_types.CompilerIrValue.I64 7)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                3
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 3)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-sccp-constant-branch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 1)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 2)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-sccp-loop-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            1
            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              2
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-sccp-trap-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          1
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 1)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

;; SCCP is the first pass where the lowered constant-index dynamic-array access
;; has both bounds operands available as literals. Pin all three decisions: an
;; in-range literal check disappears, an out-of-range literal check remains a
;; trap, and a data-dependent check is untouched.
(define (opt-sccp-constant-bounds-blocks [index : i64] [length : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 index)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 length)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 0)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-sccp-dynamic-bounds-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "index"
      (compiler_ast_types.AstType.U64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "length"
        (compiler_ast_types.AstType.U64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-sccp-dynamic-bounds-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 0)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

;; Regression guard: a branch conditioned on an IrInstrWord-extracted enum
;; tag. Pack/Word dsts must be bound Overdefined in the SCCP lattice; when they
;; stayed Unknown the branch marked NO successor executable and both arms were
;; folded away as unreachable (the -O2 stale-constant miscompile on matches over
;; 16-byte register-resident enums).
(define (opt-sccp-group-word-branch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Pack
          0
          (compiler_ir_types.compiler-ir-value-seq-prepend
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.I64 5)
              (compiler_ir_types.compiler-ir-value-seq-empty)))
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Word
          1
          (compiler_ir_types.CompilerIrValue.Var 0)
          0
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Eq)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              3
              (compiler_ir_types.CompilerIrValue.I64 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "merge"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "merge")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 3)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (compiler-optimize-sccp-self-test) : i64
  (let
    [cross : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (opt-sccp-cross-block-blocks))]
    [diamond : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-sccp-cond-params)
        (opt-sccp-diamond-blocks))]
    [branch-source : compiler_ir_types.CompilerIrBlockList
      (opt-sccp-constant-branch-blocks)]
    [branch : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (compiler_optimize.compiler-opt-global-shared-view branch-source))]
    [branch-context-result : compiler_optimize.OptBlockCtxResult
      (compiler_optimize.opt-sccp-blocks-with-context-result
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.opt-cfg-context-build
          (compiler_optimize.compiler-opt-global-shared-view branch-source))
        (compiler_ir_types.compiler-ir-param-seq-empty)
        branch-source)]
    [branch-context : compiler_ir_types.CompilerIrBlockList
      (match (compiler_optimize.compiler-opt-global-shared-view
        branch-context-result)
        [(compiler_optimize.OptBlockCtxResult.Result blocks _ _) blocks])]
    [branch-context-valid : bool
      (match branch-context-result
        [(compiler_optimize.OptBlockCtxResult.Result _ _ valid) valid])]
    [loop : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-sccp-loop-params)
        (opt-sccp-loop-blocks))]
    [trap : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (opt-sccp-trap-blocks))]
    [group : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (opt-sccp-group-word-branch-blocks))]
    [in-range-bounds : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (opt-sccp-constant-bounds-blocks 0 64))]
    [out-of-range-bounds : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (opt-sccp-constant-bounds-blocks 64 64))]
    [dynamic-bounds : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-sccp-dynamic-bounds-params)
        (opt-sccp-dynamic-bounds-blocks))]
    (cond
      [(not
          (=
            (opt-count-arith-blocks
              (compiler_optimize.compiler-opt-global-shared-view cross))
            0))
        1]
      [(not (= (opt-blocks-mov-dst-i64-value cross 1 (- 0 999)) 42)) 2]
      [(not
          (=
            (opt-count-phi-blocks
              (compiler_optimize.compiler-opt-global-shared-view diamond))
            0))
        3]
      [(not (= (opt-blocks-mov-dst-i64-value diamond 3 (- 0 999)) 7)) 4]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view branch))
            2))
        5]
      [(opt-block-list-has-label?
          (compiler_optimize.compiler-opt-global-shared-view branch)
          (compiler_ir_types.compiler-ir-label "else"))
        6]
      [(not
          (=
            (opt-count-branches-blocks
              (compiler_optimize.compiler-opt-global-shared-view branch))
            0))
        7]
      [(not
          (=
            (opt-count-jump-to-blocks
              branch
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        8]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view loop))
            4))
        9]
      [(not
          (=
            (opt-count-phi-blocks
              (compiler_optimize.compiler-opt-global-shared-view loop))
            1))
        10]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (compiler_optimize.compiler-opt-global-shared-view loop)
              1)
            0))
        11]
      [(not (= (opt-count-arith-blocks loop) 1)) 12]
      [(not
          (=
            (opt-count-arith-blocks
              (compiler_optimize.compiler-opt-global-shared-view trap))
            1))
        13]
      [(not (= (opt-count-mov-dst-blocks trap 1) 0)) 14]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view group))
            4))
        15]
      [(not
          (=
            (opt-count-branches-blocks
              (compiler_optimize.compiler-opt-global-shared-view group))
            1))
        16]
      [(not
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view group)
            (compiler_ir_types.compiler-ir-label "then")))
        17]
      [(not
          (opt-block-list-has-label?
            group
            (compiler_ir_types.compiler-ir-label "else")))
        18]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view branch-context))
            2))
        19]
      [(not branch-context-valid) 20]
      [(opt-block-list-has-label?
          branch-context
          (compiler_ir_types.compiler-ir-label "else"))
        21]
      [(not (= (compiler_optimize.opt-count-bounds-blocks in-range-bounds) 0))
        22]
      [(not
          (= (compiler_optimize.opt-count-bounds-blocks out-of-range-bounds) 1))
        23]
      [(not (= (compiler_optimize.opt-count-bounds-blocks dynamic-bounds) 1))
        24]
      [else 42])))

;; --- sccp honours the wide-literal left-operand refusal ----------------------
;;
;; sccp substitutes Const lattice values into operands directly, so it can undo
;; `opt-global-copy-keep-wide-left` unless it applies the same rule: a wide
;; (non-imm32) literal is not encodable as a left operand, so folding it there
;; only re-materializes the constant at the use. sccp is where this matters
;; most -- it is the FIRST constant lattice a freshly minted bit-test mask Mov
;; meets (opt-bit-test-mask-block runs after the fixpoint's sccp slot in the
;; iteration that forms the mask, so the late whole-function sccp run sees it
;; before any copy sweep does).
;;
;; The fixtures and the operand probes are the copy-propagation ones above:
;; `opt-wide-literal-cross-block-blocks` is exactly the mask shape -- constant
;; defined in the dominating block, shift count a parameter, so the shift can
;; never fold.
;;
;; Control: the shift count is a constant too, so the BinOp itself is constant
;; and `opt-sccp-rewrite-scalar-def` must still replace the whole instruction
;; with a Mov. `opt-wide-literal-lhs-var` reports -2 when no BinOp defines the
;; dst, i.e. when the fold happened.
(define (opt-sccp-wide-literal-const-count-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          5
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Shr
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-sccp-wide-literal-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-sccp-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-gvn-scalar-params)
    blocks))

(define (compiler-optimize-sccp-wide-literal-operand-self-test) : i64
  (let
    [wide-left : compiler_ir_types.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-wide-literal-cross-block-blocks (opt-wide-literal-mask)))]
    [imm32-left : compiler_ir_types.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-wide-literal-cross-block-blocks 1234567))]
    [wide-right : compiler_ir_types.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-wide-literal-cross-block-rhs-blocks (opt-wide-literal-mask)))]
    [const-count : compiler_ir_types.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-sccp-wide-literal-const-count-blocks (opt-wide-literal-mask)))]
    (cond
      ;; The mask stays a Var operand and its defining Mov survives, which is
      ;; what keeps the materialization hoistable out of the loop.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view wide-left)
              4)
            3))
        1]
      [(not
          (=
            (opt-count-mov-i64-value-blocks
              (compiler_optimize.compiler-opt-global-shared-view wide-left)
              (opt-wide-literal-mask))
            1))
        2]
      ;; An imm32 literal is encodable in that position, so it still folds.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (compiler_optimize.compiler-opt-global-shared-view imm32-left)
              4)
            (- 0 1)))
        3]
      [(not
          (=
            (opt-count-mov-i64-value-blocks
              (compiler_optimize.compiler-opt-global-shared-view imm32-left)
              1234567)
            1))
        4]
      ;; Right operands keep folding at any width.
      [(not (= (opt-wide-literal-rhs-var wide-right 4) (- 0 1))) 5]
      ;; A fully-constant BinOp still collapses to a Mov of the result.
      [(not (= (opt-wide-literal-lhs-var const-count 4) (- 0 2))) 6]
      [else 42])))

(test
  optimize-sccp-wide-literal-left-operand
  (test.assert-i64-eq
    (compiler-optimize-sccp-wide-literal-operand-self-test)
    42
    "sccp refuses to fold a wide literal into a BinOp's left operand and keeps its Mov alive, while imm32 left operands, right operands and fully-constant expressions still fold"))

(define (opt-cfg-constant-if-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 1)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 2)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-cfg-loop-guard-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool false)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-cfg-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              2
              (compiler_ir_types.CompilerIrValue.I64 20)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                3
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 3)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Both entry and header remain reachable after folding entry's true branch,
;; but entry no longer has a direct edge to tail. The stale entry phi arm must
;; be removed based on tail's actual predecessors.
(define (opt-cfg-folded-edge-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "header")
          (compiler_ir_types.compiler-ir-label "tail"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "tail"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tail")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              1
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.I64 10)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.I64 20)
                  (compiler_ir_types.compiler-ir-label "header")
                  (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

;; --- rule (uniform phi): every incoming value names the same value ----------
;;
;; `%1 = phi [c, then], [c, else]` is `%1 = mov c` whatever `c` is (LLVM's
;; `simplifyPHINode`), a self-reference on a back edge does not count against
;; the rule, and a phi whose inputs disagree keeps its phi.
(define (opt-uniform-phi-diamond-blocks
  [left : compiler_ir_types.CompilerIrValue]
  [right : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                1
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  left
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    right
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                ty)
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; `%1 = phi [5, entry], [carried, latch]`: with `carried` the phi itself the
;; loop only ever passes 5 round, so the phi is 5. With any other value the
;; inputs disagree and it stays a phi.
(define (opt-uniform-phi-loop-blocks
  [carried : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            1
            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
              (compiler_ir_types.CompilerIrValue.I64 5)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                carried
                (compiler_ir_types.compiler-ir-label "latch")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "latch")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "header"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Two stacked diamonds over one opaque call result: `%2` is uniform in `%1`
;; and `%3` is uniform in `%2`. Neither is a constant, so sccp cannot reach
;; either; the chain has to collapse on the uniform rule alone, and both links
;; must go in the same sweep.
(define (opt-uniform-phi-chain-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Call
          1
          (opt-test-symbol "opaque")
          (compiler_ir_types.CompilerIrCallArgs.Nil)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                2
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 1)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "then2")
                (compiler_ir_types.compiler-ir-label "else2"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "then2")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join2"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "else2")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "join2"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "join2")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      3
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 2)
                        (compiler_ir_types.compiler-ir-label "then2")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.Var 2)
                          (compiler_ir_types.compiler-ir-label "else2")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 3)))))
                (compiler_ir_types.CompilerIrBlockList.Nil)))))))))

;; A join whose first phi folds and whose second does not. The `Mov` may not
;; land inside the phi prefix: the backend's edge-copy emitter walks a block
;; from instruction 0 and stops at the first non-phi, so a phi left below the
;; mov would silently lose every incoming copy.
(define (opt-uniform-phi-mixed-join-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                1
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.I64 7)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.I64 7)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Phi
                2
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.I64 2)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.BinOp
                3
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 3)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Replica of `gvn-table-invalidate-var`'s settled loop, as the post-prune stage
;; receives it: an i64 cursor phi, a bool flag phi that `flag_exit` already
;; pinned to `false` on both edges, and an exit phi that reads the flag.
;;
;; It also carries the two mov shapes the late rule decides between. `%3` is a
;; literal whose only reader is an exit phi input, so handing the literal over
;; costs nothing and the mov goes. `%4` is a literal read by an ordinary
;; instruction as well, so forwarding it would trade one mov for an immediate
;; at every reader, and it stays.
(define (opt-uniform-phi-flag-loop-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 100)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Mov
          4
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          5
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            6
            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 7)
              (compiler_ir_types.compiler-ir-label "cont")
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Phi
            8
            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
              (compiler_ir_types.CompilerIrValue.Bool false)
              (compiler_ir_types.compiler-ir-label "cont")
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.Bool false)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.BinOp
            9
            (compiler_ir_types.CompilerIrBinOp.Ge)
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 9)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Call
              10
              (opt-test-symbol "opaque")
              (compiler_ir_types.CompilerIrCallArgs.One
                (compiler_ir_types.CompilerIrValue.Var 6))
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 10)
              (compiler_ir_types.compiler-ir-label "hit")
              (compiler_ir_types.compiler-ir-label "cont"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "hit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "cont")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.BinOp
                  7
                  (compiler_ir_types.CompilerIrBinOp.Sub)
                  (compiler_ir_types.CompilerIrValue.Var 6)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    11
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Var 3)
                      (compiler_ir_types.compiler-ir-label "hit")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 8)
                        (compiler_ir_types.compiler-ir-label "header")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    12
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Var 4)
                      (compiler_ir_types.compiler-ir-label "hit")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 5)
                        (compiler_ir_types.compiler-ir-label "header")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Call
                    13
                    (opt-test-symbol "sink")
                    (compiler_ir_types.CompilerIrCallArgs.Two
                      (compiler_ir_types.CompilerIrValue.Var 11)
                      (compiler_ir_types.CompilerIrValue.Var 12))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 13)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-uniform-phi-flag-loop-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "uniform-phi-flag-loop")
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.Bool)
    32
    (opt-uniform-phi-flag-loop-blocks)))

(define (opt-uniform-phi-block-of
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : compiler_ir_types.CompilerIrBlock
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.Some block) block]
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.CompilerIrBlock.Block
        label
        (compiler_ir_types.compiler-ir-instr-seq-empty))]))

(define (opt-uniform-phi-instr-phi-dst?
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Phi phi-dst _ _) (= phi-dst dst)]
    [_ false]))

(define (opt-uniform-phi-instr-mov-dst?
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [want : compiler_ir_types.CompilerIrValue]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Mov mov-dst value _)
      (and (= mov-dst dst) (compiler_optimize.opt-value-eq want value))]
    [_ false]))

(define (opt-uniform-phi-chain-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "uniform-phi-chain")
    (opt-sccp-cond-params)
    (compiler_ast_types.AstType.I64)
    16
    (opt-uniform-phi-chain-blocks)))

(define (opt-uniform-phi-folded-instr-seq?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [want : compiler_ir_types.CompilerIrValue]) : bool
  (if (>=
    index
    (compiler_ir_types.compiler-ir-instr-seq-count
      (compiler_ir_types.compiler-ir-global-shared-view instrs)))
    false
    (if (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.Mov mov-dst value _)
        (and
          (= mov-dst dst)
          (compiler_optimize.opt-value-eq
            (compiler_ir_types.compiler-ir-global-shared-view want)
            value))]
      [_ false])
      true
      (opt-uniform-phi-folded-instr-seq? instrs (+ index 1) dst want))))

(define (opt-uniform-phi-folded?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [want : compiler_ir_types.CompilerIrValue]) : bool
  (match (compiler_ir_types.compiler-ir-global-shared-view blocks)
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (if (match (compiler_ir_types.compiler-ir-global-shared-view block)
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-uniform-phi-folded-instr-seq?
            instrs
            0
            dst
            (compiler_ir_types.compiler-ir-global-shared-view want))])
        true
        (opt-uniform-phi-folded?
          (compiler_ir_types.compiler-ir-box-shared-view rest)
          dst
          want))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-uniform-phi-folded?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        want)]))

(define (opt-cfg-trap-path-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
