;; Returns the lhs var id of the `BinOp` whose destination is `dst`, or -1 if it
;; is absent or its lhs is not a var. Used to inspect copy-propagation rewrites.
(define (opt-copy-binop-lhs-var-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]) : i64
  (if (>= index count)
    (- 0 1)
    (match (array-ref slots index)
      [(BinOp actual _ lhs _ _)
        (if (= actual dst)
          (match lhs
            [(Var id) id]
            [_ (- 0 1)])
          (opt-copy-binop-lhs-var-instr-seq-from slots (+ index 1) count dst))]
      [_ (opt-copy-binop-lhs-var-instr-seq-from slots (+ index 1) count dst)])))

(define (opt-copy-binop-lhs-var-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-copy-binop-lhs-var-instr-seq-from instrs.slots 0 instrs.len dst))

;; `[Mov v1 = v0, BinOp v2 = v1 + 1]`: copy propagation rewrites the binop lhs
;; from v1 to v0.
(define (opt-copy-pos-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%1 = mov %0 : i64
     %2 = add %1, 1 : i64"))

;; `[Mov v1 = v0, Load v0 = *v9, BinOp v2 = v1 + 1]`: redefining the copy source
;; v0 invalidates the v1 -> v0 fact, so the binop lhs stays v1.
(define (opt-copy-src-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov %0 : i64
     %0 = load %9 : i64
     %2 = add %1, 1 : i64"))

;; `[Mov v1 = v0, Load v1 = *v9, BinOp v2 = v1 + 1]`: redefining the copy
;; destination v1 invalidates the fact, so the binop lhs stays v1.
(define (opt-copy-dst-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov %0 : i64
     %1 = load %9 : i64
     %2 = add %1, 1 : i64"))

;; `[BinOp v2 = v0 + v1, BinOp v3 = v0 + v1, BinOp v4 = v3 + 1, Return v4]`: CSE
;; rewrites the second expression to `Mov v3 = v2`; copy propagation then rewrites
;; the v4 lhs from v3 to v2, leaving the `Mov v3` copy dead for DCE to drop (the
;; `Return v4` keeps v4 live so only the copy is removed: 4 instrs -> 3).
(define (opt-copy-cse-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = add %0, %1 : i64
     %3 = add %0, %1 : i64
     %4 = add %3, 1 : i64
     return %4"))

;; `[Mov v1 = 1.5f64, BinOp v2 = v1 + v1]`: an F64 source is not recorded as a
;; copy in this slice, so the binop lhs stays v1 (no unsafe literal propagation).
(define (opt-copy-f64-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Mov 1 (F64 (opt-test-f64-bits "1.5")) (F64))
    (irt.instr "%2 = add %1, %1 : f64")))

(define (opt-copy-phi-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%1 = mov %0 : i64
     %2 = phi [%1, left] : i64"))

(define (opt-copy-pack-word-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = pack [%0, %1] : Pair
     %3 = word %2, 0 : i64
     %4 = word %2, 1 : i64"))

(define (opt-copy-pack-source-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = pack [%0, %1] : Pair
     %0 = load %9 : i64
     %3 = word %2, 0 : i64
     %4 = word %2, 1 : i64"))

(define (opt-copy-pack-dst-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = pack [%0, %1] : Pair
     %2 = load %9 : i64
     %3 = word %2, 0 : i64"))

(define (opt-copy-mov-src-var-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    fallback
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov found src _)
        (if (= found dst)
          (match src
            [(Var id) id]
            [_ fallback])
          (opt-copy-mov-src-var-from instrs (+ index 1) dst fallback))]
      [_ (opt-copy-mov-src-var-from instrs (+ index 1) dst fallback)])))

(define (opt-copy-mov-src-var
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-copy-mov-src-var-from instrs 0 dst fallback))

(define (opt-copy-word-src-var-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    fallback
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Word found src _ _)
        (if (= found dst)
          (match src
            [(Var id) id]
            [_ fallback])
          (opt-copy-word-src-var-from instrs (+ index 1) dst fallback))]
      [_ (opt-copy-word-src-var-from instrs (+ index 1) dst fallback)])))

(define (opt-copy-word-src-var
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-copy-word-src-var-from instrs 0 dst fallback))

(define (opt-phi-first-input-var
  [inputs : ir.CompilerIrPhiInputSeq]
  [fallback : i64]) : i64
  (let
    [phi-inputs-at-10899-3 : ir.CompilerIrPhiInputSeq inputs]
    (if (<= phi-inputs-at-10899-3.len 0)
      fallback
      (let
        [phi-input-at-10899-3 : ir.CompilerIrPhiInput
          (ir.compiler-ir-phi-input-seq-ref phi-inputs-at-10899-3 0)]
        [value : ir.CompilerIrValue phi-input-at-10899-3.value]
        (match value
          [(Var id) id]
          [_ fallback])))))

(define (opt-phi-dst-first-input-var-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    fallback
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Phi found inputs _)
        (if (= found dst)
          (opt-phi-first-input-var inputs fallback)
          (opt-phi-dst-first-input-var-from instrs (+ index 1) dst fallback))]
      [_ (opt-phi-dst-first-input-var-from instrs (+ index 1) dst fallback)])))

(define (opt-phi-dst-first-input-var
  [instrs : ir.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-phi-dst-first-input-var-from instrs 0 dst fallback))

;; Returns 42 when block-local copy propagation: rewrites a var copy into a later
;; use (pos: lhs v1 -> v0); does not propagate after the source (src-redef) or
;; destination (dst-redef) var is redefined; rewrites a CSE-introduced copy so
;; DCE can drop it (cse: lhs v3 -> v2, leaving 3 instrs); does not propagate an
;; unsafe F64 source (f64: lhs stays v1); and leaves phi inputs untouched because
;; they are edge operands rather than block-local value uses.
(define (compiler-optimize-copy-self-test) : i64
  (let
    [pos : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-copy-pos-instrs))]
    [src-redef : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-copy-src-redef-instrs))]
    [dst-redef : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-copy-dst-redef-instrs))]
    [cse : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-test-cse-instrs
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt.opt-expr-table-new)
          (opt-copy-cse-instrs)))]
    [cse-dce : ir.CompilerIrInstrSeq
      (let
        [set
          (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) cse)]
        (opt-test-dce-instrs set cse))]
    [f64 : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-copy-f64-instrs))]
    [phi : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-copy-phi-instrs))]
    [pack-word : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-copy-pack-word-instrs))]
    [pack-source-redef : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-copy-pack-source-redef-instrs))]
    [pack-dst-redef : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-copy-pack-dst-redef-instrs))]
    (cond
      [(not (= (opt-copy-binop-lhs-var-instr-seq pos 2) 0)) 1]
      [(not (= (opt-copy-binop-lhs-var-instr-seq src-redef 2) 1)) 2]
      [(not (= (opt-copy-binop-lhs-var-instr-seq dst-redef 2) 1)) 3]
      [(not (= (opt-copy-binop-lhs-var-instr-seq cse 4) 2)) 4]
      [(not (= (ir.compiler-ir-instr-seq-count cse-dce) 3)) 5]
      [(not (= (opt-copy-binop-lhs-var-instr-seq f64 2) 1)) 6]
      [(not (= (opt-phi-dst-first-input-var phi 2 (- 0 1)) 1)) 7]
      [(not (= (opt-copy-mov-src-var pack-word 3 (- 0 1)) 0)) 8]
      [(not (= (opt-copy-mov-src-var pack-word 4 (- 0 1)) 1)) 9]
      [(not (= (opt-copy-word-src-var pack-source-redef 3 (- 0 1)) 2)) 10]
      [(not (= (opt-copy-mov-src-var pack-source-redef 4 (- 0 1)) 1)) 11]
      [(not (= (opt-copy-word-src-var pack-dst-redef 3 (- 0 1)) 2)) 12]
      [else 42])))

;; Count explicit trapping bounds checks after the dedicated bounds pass.
(define (opt-count-bounds-instrs-from-index
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(BoundsCheck _ _ _) 1]
        [_ 0])
      (opt-count-bounds-instrs-from-index instrs (+ index 1)))))

(define (opt-count-bounds-instrs [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-bounds-instrs-from-index instrs 0))

(define (opt-bounds-duplicate-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "bounds_check %0, %1 message \"bounds_ok.0\"
     bounds_check %0, %1 message \"bounds_ok.1\""))

(define (opt-bounds-different-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "bounds_check %0, %1 message \"bounds_ok.0\"
     bounds_check %1, %0 message \"bounds_ok.1\""))

(define (opt-bounds-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "bounds_check %0, %1 message \"bounds_ok.0\"
     %0 = mov 7 : i64
     bounds_check %0, %1 message \"bounds_ok.1\""))

(define (opt-bounds-call-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "bounds_check %0, %1 message \"bounds_ok.0\"
     %9 = call touch() : unit
     bounds_check %0, %1 message \"bounds_ok.1\""))

(define (opt-bounds-branch-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "bounds_check %0, %1 message \"bounds_ok.0\"
     branch true, ok, fail
     bounds_check %0, %1 message \"bounds_ok.1\""))

(define (opt-bounds-copy-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = mov %0 : i64
     bounds_check %2, %1 message \"bounds_ok.0\"
     bounds_check %0, %1 message \"bounds_ok.1\""))

(define (opt-bounds-dce-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = mov 1 : u64
     %1 = mov 2 : u64
     bounds_check %0, %1 message \"bounds_ok.0\""))

;; Index-cast canonicalization: two accesses to the same logical index
;; (var0) and array (var1) each emit a fresh `Cast(_, I64->U64)` of var0 and a
;; fresh length load; the second bounds check is redundant. Without
;; canonicalization the distinct cast vars (10 vs 14) never match, so this case
;; pins the optimization (count 1).
(define (opt-bounds-index-cast-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = cast %0 : i64 to u64
     %11 = gep %1, 1 : i64
     %12 = load %11 : i64
     %13 = cast %12 : i64 to u64
     bounds_check %10, %13 message \"bounds_ok.0\"
     %14 = cast %0 : i64 to u64
     %15 = gep %1, 1 : i64
     %16 = load %15 : i64
     %17 = cast %16 : i64 to u64
     bounds_check %14, %17 message \"bounds_ok.1\""))

;; Adversarial: redefining the index source (var0) between the two checks must
;; invalidate the canonicalized fact, so the second check is kept (count 2). A
;; `<=`-into-`<` or stale-source bug would wrongly drop it.
(define (opt-bounds-index-cast-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = cast %0 : i64 to u64
     %11 = gep %1, 1 : i64
     %12 = load %11 : i64
     %13 = cast %12 : i64 to u64
     bounds_check %10, %13 message \"bounds_ok.0\"
     %0 = mov 7 : i64
     %14 = cast %0 : i64 to u64
     %15 = gep %1, 1 : i64
     %16 = load %15 : i64
     %17 = cast %16 : i64 to u64
     bounds_check %14, %17 message \"bounds_ok.1\""))

(define (opt-bounds-cross-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       bounds_check %0, %1 message \"bounds_ok.0\"
     next:
       bounds_check %0, %1 message \"bounds_ok.1\""))

;; Dominated bounds-dedup fixture: entry checks (idx,len); the dominated mid /
;; left / exit blocks re-check the same pair (removable), while a different
;; length, a multi-def index, and a sibling block that only sees the multi-def
;; var must all keep their checks.
(define (opt-bounds-dom-test-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, idx=%1:i64, len=%2:i64, len2=%3:i64"))

(define (opt-bounds-dom-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       bounds_check %1, %2 message \"e_ok\"
       jump mid
     mid:
       bounds_check %1, %2 message \"m_ok\"
       bounds_check %1, %3 message \"m2_ok\"
       %5 = mov 1 : i64
       branch %0, left, right
     left:
       bounds_check %1, %2 message \"l_ok\"
       %5 = mov 2 : i64
       bounds_check %5, %2 message \"l2_ok\"
       jump join
     right:
       bounds_check %5, %2 message \"r_ok\"
       jump join
     join:
       bounds_check %1, %2 message \"j_ok\"
       return %1"))

(define (compiler-optimize-bounds-dom-self-test) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-bounds-dom-test-blocks)]
    [before : i64
      (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view blocks))]
    [after-blocks : ir.CompilerIrBlockList
      (opt.opt-bounds-dom-blocks-with-context
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt.opt-cfg-context-build
            (opt.compiler-opt-global-shared-view blocks)))
        (& (opt-bounds-dom-test-params))
        8
        (& blocks))]
    [after : i64
      (opt.opt-count-bounds-blocks
        (ir.compiler-ir-block-list-view after-blocks))]
    (cond
      [(not (= before 7)) 1]
      ;; kept: entry (first), mid's different-length, left's multi-def index,
      ;; right's multi-def index. dropped: mid/left/join duplicates of
      ;; (idx,len). The fixture is intentionally multi-def (the negative
      ;; case), so a full verify does not apply; the pass only deletes
      ;; mid-block instructions, checked structurally below.
      [(not (= after 4)) 2]
      [(not (= (ir.compiler-ir-block-list-count after-blocks) 5)) 3]
      [(not (opt.opt-cfg-successor-targets-known? after-blocks)) 4]
      [else 42])))

;; Native Slice lowering re-extracts the two-word parameter group at every
;; access. The first successful `(index, length)` check must therefore dominate
;; later checks even when their length Words have distinct SSA destinations and
;; an element store lies between them. A different Slice is a different fact;
;; taking the original parameter's storage address disables the specialization.
(define (opt-bounds-dom-slice-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "left" (ast.ast-ty-ref 0 (& (ast.ast-ty-slice (& (I64))))) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "right" (ast.ast-ty-mut-ref 0 (& (ast.ast-ty-slice (& (I64))))) 1)
      (ir.compiler-ir-param-seq-prepend
        (Param "index" (I64) 2)
        (ir.compiler-ir-param-seq-empty)))))

(define (opt-bounds-dom-slice-entry-instrs [address-taken? : bool]) : ir.CompilerIrInstrSeq
  (let
    [tail : ir.CompilerIrInstrSeq
      (irt.instrs
        "%4 = word %0, 1 : i64
         bounds_check %2, %4 message \"slice_entry_ok\"
         jump mid")]
    (if address-taken?
      (opt-test-instrs-with-tail tail (ir.CompilerIrInstr.AddrOf 10 0))
      tail)))

(define (opt-bounds-dom-slice-mid-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%5 = word %0, 0 : u64
     %6 = gep %5, %2 : i64
     store_ptr %6, 9 : i64
     %7 = word %0, 1 : i64
     bounds_check %2, %7 message \"slice_same_ok\"
     %8 = word %1, 1 : i64
     bounds_check %2, %8 message \"slice_other_ok\"
     jump exit"))

(define (opt-bounds-dom-slice-blocks [address-taken? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "exit:
           %9 = word %0, 1 : i64
           bounds_check %2, %9 message \"slice_exit_ok\"
           return %2")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-bounds-dom-slice-entry-instrs address-taken?))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "mid")
      (opt-bounds-dom-slice-mid-instrs))))

(define (opt-bounds-dom-slice-run [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt.opt-bounds-dom-blocks-with-context
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks)))
    (& (opt-bounds-dom-slice-params))
    11
    (& blocks)))

(define (compiler-optimize-bounds-dom-slice-word-self-test) : i64
  (let
    [input : ir.CompilerIrBlockList (opt-bounds-dom-slice-blocks false)]
    [after : ir.CompilerIrBlockList
      (opt-bounds-dom-slice-run (ir.compiler-ir-global-shared-view input))]
    [again : ir.CompilerIrBlockList
      (opt-bounds-dom-slice-run (ir.compiler-ir-global-shared-view after))]
    [escaped-input : ir.CompilerIrBlockList (opt-bounds-dom-slice-blocks true)]
    [escaped-after : ir.CompilerIrBlockList
      (opt-bounds-dom-slice-run escaped-input)]
    (cond
      [(not
          (=
            (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view input))
            4))
        1]
      ;; Kept: the first check for `left`, and the independent `right` check.
      ;; Dropped: both dominated re-extractions of `left`'s stable length.
      [(not
          (=
            (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view after))
            2))
        2]
      [(not
          (=
            (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view again))
            2))
        3]
      ;; AddrOf makes `left`'s register-group storage mutable, so all four
      ;; differently-named lengths remain conservative.
      [(not
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view escaped-after))
            4))
        4]
      [(not (opt.opt-cfg-successor-targets-known? after)) 5]
      [else 42])))

;; An address-taken local is not one value (#8672): `%2`'s address is `%3`, so
;; the store through `%3` redefines `%2` without naming it, and neither `%2` nor
;; its copy `%4` keeps a checked pair or a branch fact across that store. `%7`
;; and its copy `%8` are the same shape on a local whose address is never
;; taken: the second check of that pair is dropped and the inner branch decided.
(define (opt-bounds-dom-addr-taken-params) : ir.CompilerIrParamSeq
  (irt.params "idx=%0:i64, len=%1:i64"))

(define (opt-bounds-dom-addr-taken-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov %0 : i64
       %3 = addr_of %2
       %4 = mov %2 : i64
       bounds_check %4, %1 message \"taken_copy_ok\"
       store_ptr %3, 9 : i64
       bounds_check %2, %1 message \"taken_ok\"
       %7 = mov %0 : i64
       %8 = mov %7 : i64
       bounds_check %8, %1 message \"plain_copy_ok\"
       bounds_check %7, %1 message \"plain_ok\"
       %5 = eq %4, 3 : i64
       branch %5, taken, exit
     taken:
       store_ptr %3, 9 : i64
       %6 = eq %2, 3 : i64
       branch %6, plain, exit
     plain:
       %9 = eq %8, 3 : i64
       branch %9, inner, exit
     inner:
       %10 = eq %7, 3 : i64
       branch %10, done, exit
     done:
       return %2
     exit:
       return %0"))

(define (compiler-optimize-bounds-dom-addr-taken-self-test) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-bounds-dom-addr-taken-blocks)]
    [before : i64
      (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view blocks))]
    [after : ir.CompilerIrBlockList
      (opt.opt-bounds-dom-blocks-with-context
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt.opt-cfg-context-build
            (opt.compiler-opt-global-shared-view blocks)))
        (& (opt-bounds-dom-addr-taken-params))
        12
        (& blocks))]
    (cond
      [(not (= before 4)) 1]
      ;; Kept: both checks of the address-taken pair and the first plain one.
      [(not
          (=
            (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view after))
            3))
        2]
      ;; Only `%10` is decided: `%6` reads `%2` after the store.
      [(not (opt-branch-fold-count-is? (& after) 1 1)) 3]
      [(not (opt-branch-fold-count-is? (& after) 0 0)) 4]
      [(not (opt-branch-fold-block-count-is? (& after) 6)) 5]
      [else 42])))

;; --- unsigned range-check merge ----------------------------------------------
;;
;; `(and (>= i 0) (< i n))` is one unsigned compare when `n` is non-negative.
;; The fixture is the short-circuit diamond the front end emits: a lower-bound
;; block branching into a two-instruction upper-bound block, both false edges on
;; one failure arm. Knobs cover the four lower spellings, both upper operand
;; orders, whether the bound is provably non-negative, an extra consumer of the
;; lower compare, and a split failure arm.
;;
;; Params: idx = %0, len = %1, probe = %2. Fresh casts start at the frame, 16.
(define (opt-range-merge-params) : ir.CompilerIrParamSeq
  (irt.params "idx=%0:i64, len=%1:i64, probe=%2:i64"))

;; 0 `ge i 0`, 1 `gt i -1`, 2 `le 0 i`, 3 `lt -1 i`.
(define (opt-range-merge-low-instr [kind : i64]) : ir.CompilerIrInstr
  (cond
    [(= kind 0) (irt.instr "%3 = ge %0, 0 : i64")]
    [(= kind 1) (irt.instr "%3 = gt %0, -1 : i64")]
    [(= kind 2) (irt.instr "%3 = le 0, %0 : i64")]
    [else (irt.instr "%3 = lt -1, %0 : i64")]))

;; 0 `lt i bound`, 1 `gt bound i`. `bound` is `len` (%1), which the true arm
;; bounds-checks against, or `probe` (%2), which nothing ever checks -- the
;; negative case for the non-negativity gate.
(define (opt-range-merge-high-instr [kind : i64] [bound : i64]) : ir.CompilerIrInstr
  (if (= kind 0)
    (BinOp 4 (Lt) (Var 0) (Var bound) (I64))
    (BinOp 4 (Gt) (Var bound) (Var 0) (I64))))

(define (opt-range-merge-low-instrs
  [low-kind : i64]
  [extra-use? : bool]
  [low-fail : i64]) : ir.CompilerIrInstrSeq
  (if extra-use?
    (opt-test-instrs
      (opt-range-merge-low-instr low-kind)
      (ir.CompilerIrInstr.Mov 10 (Var 3) (Bool))
      (ir.CompilerIrInstr.Branch (Var 3) (ir.compiler-ir-label "high") low-fail))
    (opt-test-instrs
      (opt-range-merge-low-instr low-kind)
      (ir.CompilerIrInstr.Branch (Var 3) (ir.compiler-ir-label "high") low-fail))))

(define (opt-range-merge-blocks
  [low-kind : i64]
  [high-kind : i64]
  [bound : i64]
  [extra-use? : bool]
  [split-arms? : bool]) : ir.CompilerIrBlockList
  (let
    [low-fail : i64
      (ir.compiler-ir-label
        (&
          (if split-arms?
            "fail_low"
            "fail")))]
    [high-fail : i64
      (ir.compiler-ir-label
        (&
          (if split-arms?
            "fail_high"
            "fail")))]
    [tail : ir.CompilerIrBlockList
      (if split-arms?
        (irt.blocks
          "fail_low:
             jump fail
           fail_high:
             jump fail")
        (ir.compiler-ir-block-list-empty))]
    (ir.compiler-ir-blocks-with-tail
      tail
      (irt.block "entry:
           jump low")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "low")
        (opt-range-merge-low-instrs low-kind extra-use? low-fail))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "high")
        (opt-test-instrs
          (opt-range-merge-high-instr high-kind bound)
          (ir.CompilerIrInstr.Branch
            (Var 4)
            (ir.compiler-ir-label "ok")
            high-fail)))
      (irt.block
        "ok:
                 bounds_check %0, %1 message \"ok_ok\"
                 return %0")
      (irt.block "fail:
                   return -1"))))

;; Already-merged shape, hand-written the way the fold leaves it. The
;; `bounds_check` below it is the round-two question: the SIGNED component facts
;; are gone, and only the unsigned reading of the merged guard can discharge it.
(define (opt-range-merge-merged-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %5 = cast %0 : i64 to u64
       %6 = cast %1 : i64 to u64
       %7 = lt %5, %6 : u64
       branch %7, ok, fail
     ok:
       bounds_check %0, %1 message \"ok_ok\"
       return %0
     fail:
       return -1"))

(define (opt-range-merge-run [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (opt.opt-bounds-dom-blocks-with-context-result
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
    (& (opt-range-merge-params))
    16
    (& (opt_i64_i64_map.with-capacity 1))
    (& (opt.opt-len-eq-use-empty))
    (& blocks))
    [(Result result _) result]))

(define (opt-range-merge-run-frame [blocks : ir.CompilerIrBlockList]) : i64
  (match (opt.opt-bounds-dom-blocks-with-context-result
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
    (& (opt-range-merge-params))
    16
    (& (opt_i64_i64_map.with-capacity 1))
    (& (opt.opt-len-eq-use-empty))
    (& blocks))
    [(Result _ frame) frame]))

(define (opt-range-merge-count-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]) : i64
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs pos)
        [(BinOp _ _ _ _ ty)
          (match ty
            [(U64) 1]
            [_ 0])]
        [_ 0])
      (opt-range-merge-count-instrs instrs (+ pos 1)))))

;; How many unsigned-typed comparisons the output holds.
(define (opt-range-merge-count-unsigned
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-range-merge-count-instrs instrs 0)
            (opt-range-merge-count-unsigned rest))])]))

(define (opt-range-merge-true-instrs?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [var : i64]) : bool
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (match (ir.compiler-ir-instr-seq-ref instrs pos)
      [(Mov dst src _)
        (and
          (= dst var)
          (match src
            [(Bool value) value]
            [_ false]))]
      [_ false])
      true
      (opt-range-merge-true-instrs? instrs (+ pos 1) var))))

;; Is `var` defined by `mov true` -- the upper compare the merge discharged?
(define (opt-range-merge-true?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [var : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (or
            (opt-range-merge-true-instrs? instrs 0 var)
            (opt-range-merge-true? rest var))])]))

;; One knob combination merged: exactly one unsigned compare, the upper compare
;; retired to `true`, two fresh cast vars, and the dominated duplicate check the
;; true arm holds still discharged (the component facts are not lost).
(define (opt-range-merge-case-merged?
  [low-kind : i64]
  [high-kind : i64]
  [split-arms? : bool]) : bool
  (let
    [input : ir.CompilerIrBlockList
      (opt-range-merge-blocks low-kind high-kind 1 false split-arms?)]
    [after : ir.CompilerIrBlockList
      (opt-range-merge-run
        (opt-range-merge-blocks low-kind high-kind 1 false split-arms?))]
    [frame : i64
      (opt-range-merge-run-frame
        (opt-range-merge-blocks low-kind high-kind 1 false split-arms?))]
    (and
      (= (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view input)) 1)
      (=
        (opt-range-merge-count-unsigned (ir.compiler-ir-block-list-view after))
        1)
      (opt-range-merge-true? (ir.compiler-ir-block-list-view after) 4)
      (= frame 18)
      ;; The dominated duplicate the true arm holds is still discharged: the
      ;; merge did not cost the walk the component facts.
      (= (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view after)) 0)
      (opt.opt-cfg-successor-targets-known? after))))

(define (opt-range-merge-case-refused?
  [bound : i64]
  [extra-use? : bool]
  [split-arms? : bool]) : bool
  (let
    [after : ir.CompilerIrBlockList
      (opt-range-merge-run
        (opt-range-merge-blocks 0 0 bound extra-use? split-arms?))]
    [frame : i64
      (opt-range-merge-run-frame
        (opt-range-merge-blocks 0 0 bound extra-use? split-arms?))]
    (and
      (=
        (opt-range-merge-count-unsigned (ir.compiler-ir-block-list-view after))
        0)
      (not (opt-range-merge-true? (ir.compiler-ir-block-list-view after) 4))
      (= frame 16))))

(define (compiler-optimize-range-merge-self-test) : i64
  (cond
    ;; (a) `(>= i 0) && (< i n)` with `n` a proven length, both operand orders.
    [(not (opt-range-merge-case-merged? 0 0 false)) 1]
    [(not (opt-range-merge-case-merged? 0 1 false)) 2]
    ;; (b) the `(> i -1)` spelling, and the two reversed lower spellings.
    [(not (opt-range-merge-case-merged? 1 0 false)) 3]
    [(not (opt-range-merge-case-merged? 2 0 false)) 4]
    [(not (opt-range-merge-case-merged? 3 1 false)) 5]
    ;; The two failure arms may be distinct one-`Jump` blocks onto one target.
    [(not (opt-range-merge-case-merged? 0 0 true)) 6]
    ;; (c) `n` NOT provably non-negative -- the bound is `probe`, which nothing
    ;; checks and no fact bounds: no merge.
    [(not (opt-range-merge-case-refused? 2 false false)) 7]
    [(not (opt-range-merge-case-refused? 2 false true)) 8]
    ;; (d) the lower compare has a second consumer, so its value must survive.
    [(not (opt-range-merge-case-refused? 1 true false)) 9]
    ;; (e) the merged spelling still discharges a dominated duplicate check --
    ;; the round-two question, where only the unsigned fact remains.
    [(not
        (=
          (let
            [walked-blocks : ir.CompilerIrBlockList
              (opt-range-merge-merged-blocks)]
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view walked-blocks)))
          1))
      10]
    [(not
        (=
          (let
            [walked-blocks : ir.CompilerIrBlockList
              (opt-range-merge-run (opt-range-merge-merged-blocks))]
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view walked-blocks)))
          0))
      11]
    ;; Idempotent: the merged output is not a candidate for itself.
    [(not
        (=
          (let
            [blocks
              (opt-range-merge-run
                (opt-range-merge-run (opt-range-merge-blocks 0 0 1 false false)))]
            (opt-range-merge-count-unsigned
              (ir.compiler-ir-block-list-view blocks)))
          1))
      12]
    [else 42]))

;; --- whole-program non-negative scalar globals -------------------------------
;;
;; One program, eight `i64` globals, one function whose stores exercise each
;; admitted and each refused shape:
;;
;;   lit      <- 5                    literal, non-negative       ADMITTED
;;   neg      <- -3                   literal, negative           refused
;;   len      <- load (gep @text, 1)  a descriptor length word    ADMITTED
;;   plen     <- load (gep %p, 1)     a header PARAMETER's length ADMITTED
;;   counter  <- add @counter, 1      arithmetic can overflow     refused
;;   masked   <- bit-and %x, 63       mask clears the sign bit    ADMITTED
;;   alias-a  <- @alias-b             mutual dependence, both     ADMITTED
;;   alias-b  <- @alias-a             (the optimistic fixpoint)
;;   tainted  <- @counter             depends on a refused global refused
;;   escaped  <- 0                    address taken               refused
;;   init-neg <- (never stored)       negative initializer        refused
(defstruct OptNonnegTestSymbols
  (lit i64)
  (neg i64)
  (len i64)
  (plen i64)
  (counter i64)
  (masked i64)
  (alias-a i64)
  (alias-b i64)
  (tainted i64)
  (escaped i64)
  (init-neg i64)
  (text i64))

(define (opt-nonneg-test-symbols) : OptNonnegTestSymbols
  (OptNonnegTestSymbols
    (opt-test-symbol "nn_lit")
    (opt-test-symbol "nn_neg")
    (opt-test-symbol "nn_len")
    (opt-test-symbol "nn_plen")
    (opt-test-symbol "nn_counter")
    (opt-test-symbol "nn_masked")
    (opt-test-symbol "nn_alias_a")
    (opt-test-symbol "nn_alias_b")
    (opt-test-symbol "nn_tainted")
    (opt-test-symbol "nn_escaped")
    (opt-test-symbol "nn_init_neg")
    (opt-test-symbol "nn_text")))

(define (opt-nonneg-test-globals [symbols : OptNonnegTestSymbols]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 12)]
    (opt-test-global-builder-push! (&mut builder) symbols.lit (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.neg (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.len (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.plen (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.counter (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.masked (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.alias-a (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.alias-b (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.tainted (I64) (I64 0))
    (opt-test-global-builder-push! (&mut builder) symbols.escaped (I64) (I64 0))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.init-neg
      (I64)
      (I64 (- 0 1)))
    (opt-test-global-builder-push! (&mut builder) symbols.text (String) (Unit))
    (ir.compiler-ir-global-builder-to-seq builder)))

(define (opt-nonneg-test-instrs [symbols : OptNonnegTestSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    ;; lit <- 5
    (ir.CompilerIrInstr.Store symbols.lit (I64 5) (I64))
    ;; neg <- -3
    (ir.CompilerIrInstr.Store symbols.neg (I64 (- 0 3)) (I64))
    ;; len <- (string-length @text): load (gep @text, 1) : i64
    (ir.CompilerIrInstr.Gep 1 (Global symbols.text) (I64 1) (I64))
    (ir.CompilerIrInstr.Load 2 (Var 1) (I64))
    (ir.CompilerIrInstr.Store symbols.len (Var 2) (I64))
    ;; plen <- (array-length p), p the header parameter, through one Mov copy
    (irt.instr "%3 = gep %0, 1 : i64")
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))
    (ir.CompilerIrInstr.Mov 5 (Var 4) (I64))
    (ir.CompilerIrInstr.Store symbols.plen (Var 5) (I64))
    ;; counter <- counter + 1
    (ir.CompilerIrInstr.BinOp 6 (Add) (Global symbols.counter) (I64 1) (I64))
    (ir.CompilerIrInstr.Store symbols.counter (Var 6) (I64))
    ;; masked <- (bit-and opaque 63)
    (irt.instr "%7 = bit_and %4, 63 : i64")
    (ir.CompilerIrInstr.Store symbols.masked (Var 7) (I64))
    ;; alias-a <- @alias-b, alias-b <- @alias-a
    (ir.CompilerIrInstr.Store symbols.alias-a (Global symbols.alias-b) (I64))
    (ir.CompilerIrInstr.Store symbols.alias-b (Global symbols.alias-a) (I64))
    ;; tainted <- @counter
    (ir.CompilerIrInstr.Store symbols.tainted (Global symbols.counter) (I64))
    ;; &escaped
    (ir.CompilerIrInstr.Mov 8 (GlobalAddr symbols.escaped) (U64))
    (irt.instr "return %2")))

(define (opt-nonneg-test-functions [symbols : OptNonnegTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (Function
        (opt-test-symbol "nn_f")
        (irt.params "p=%0:(__tl_dyn-array i64)")
        (I64)
        16
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "entry")
            (opt-nonneg-test-instrs symbols)))
        Ordinary))
    (& (ir.compiler-ir-function-seq-empty))))

(define (compiler-optimize-nonneg-globals-self-test) : i64
  (let
    [symbols : OptNonnegTestSymbols (opt-nonneg-test-symbols)]
    [globals : ir.CompilerIrGlobalSeq (opt-nonneg-test-globals symbols)]
    [functions : ir.CompilerIrFunctionSeq (opt-nonneg-test-functions symbols)]
    [cell : opt.OptGlobalCellSummary
      (opt.opt-global-cell-summary-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& globals)
        (& functions))]
    [table : opt_i64_i64_map.Map cell.nonneg]
    (cond
      ;; ADMITTED
      [(not (opt_i64_i64_map.contains? (& table) symbols.lit)) 1]
      [(not (opt_i64_i64_map.contains? (& table) symbols.len)) 2]
      [(not (opt_i64_i64_map.contains? (& table) symbols.plen)) 3]
      [(not (opt_i64_i64_map.contains? (& table) symbols.masked)) 4]
      ;; the optimistic fixpoint keeps a mutually dependent pair
      [(not (opt_i64_i64_map.contains? (& table) symbols.alias-a)) 5]
      [(not (opt_i64_i64_map.contains? (& table) symbols.alias-b)) 6]
      ;; REFUSED
      [(opt_i64_i64_map.contains? (& table) symbols.neg) 7]
      [(opt_i64_i64_map.contains? (& table) symbols.counter) 8]
      ;; the refusal propagates through the dependence edge
      [(opt_i64_i64_map.contains? (& table) symbols.tainted) 9]
      [(opt_i64_i64_map.contains? (& table) symbols.escaped) 10]
      [(opt_i64_i64_map.contains? (& table) symbols.init-neg) 11]
      ;; a descriptor global is not a scalar i64 candidate at all
      [(opt_i64_i64_map.contains? (& table) symbols.text) 12]
      ;; the table built in its scratch arena and cloned out holds exactly the
      ;; six admitted globals
      [(not (= (opt_i64_i64_map.len (& table)) 6)) 13]
      [else 42])))

;; Two maps with the same length and capacity whose slots hold the same entries
;; at the same indexes: a layout-exact copy.
(define (opt-test-i64-map-layout-same?
  [left : (& left opt_i64_i64_map.Map)]
  [right : (& right opt_i64_i64_map.Map)]) : bool
  (let
    [capacity : i64 (opt_i64_i64_map.capacity left)]
    [same : bool
      (and
        (= (opt_i64_i64_map.len left) (opt_i64_i64_map.len right))
        (= capacity (opt_i64_i64_map.capacity right)))]
    [index : i64 0]
    (while (and same (< index capacity))
      (match (opt_i64_i64_map.entry-at left index)
        [(EntrySome key value)
          (match (opt_i64_i64_map.entry-at right index)
            [(EntrySome other-key other-value)
              (if (and (= key other-key) (= value other-value))
                unit
                (set! same false))]
            [(EntryNone) (set! same false)])]
        [(EntryNone)
          (match (opt_i64_i64_map.entry-at right index)
            [(EntrySome _ _) (set! same false)]
            [(EntryNone) unit])])
      (set! index (+ index 1)))
    same))

;; --- constant-offset runs: widening + ordered subsumption --------------------
;;
;; Six shapes over ONE base (`idx`, param 1) and two lengths (`len`, `len2`),
;; driving `opt-bounds-dom-blocks-with-context` end to end: the reordering
;; peephole and the bracket subsumption are two halves of one rule, so the
;; fixtures state what the pass must leave behind rather than which half acted.
;;
;;   0 increasing run idx, idx+1, idx+2 against `len` -- the `gvn-run-block`
;;     shape. The widest check (and its Add) move to the run's front and the
;;     middle check goes: TWO checks left, an Add first in the block.
;;   1 the same run with a STORE between its first two checks. Reordering a trap
;;     across an observable effect is exactly what the rule forbids, so all
;;     THREE stay.
;;   2 the same run against TWO lengths: no pair of facts brackets anything and
;;     all three stay.
;;   3 decreasing run idx+2, idx+1, idx -- `it-hash-words`' word loader. The
;;     narrowest check moves up beside the widest one: TWO left.
;;   4 a two-member run, idx+1 then idx, with the base's sign unknown: the lower
;;     bracket is missing and nothing is retired.
;;   5 shape 4 behind a dominating `idx >= 0`: the nonneg route supplies the
;;     lower bracket and the second check goes.
(define (opt-bounds-run-check
  [index : ir.CompilerIrValue]
  [length : ir.CompilerIrValue]
  [label : String]) : ir.CompilerIrInstr
  (BoundsCheck index length (ir.compiler-ir-label (& label))))

(define (opt-bounds-run-add [dst : i64] [offset : i64]) : ir.CompilerIrInstr
  (BinOp dst (Add) (Var 1) (I64 offset) (I64)))

(define (opt-bounds-run-return) : ir.CompilerIrInstrSeq
  (irt.instrs "return %1"))

(define (opt-bounds-run-append
  [head : ir.CompilerIrInstrSeq]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-append head tail))

;; `gep len, 0` + `store_ptr`: the observable effect variant 1 puts between the
;; run's checks.
(define (opt-bounds-run-store) : ir.CompilerIrInstrSeq
  (irt.instrs "%6 = gep %2, 0 : i64
     store_ptr %6, %1 : i64"))

(define (opt-bounds-run-length [variant : i64]) : ir.CompilerIrValue
  (if (= variant 2)
    (Var 3)
    (Var 2)))

(define (opt-bounds-run-increasing
  [variant : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (irt.instr "bounds_check %1, %2 message \"run_ok0\"")
    (opt-bounds-run-append
      (if (= variant 1)
        (opt-bounds-run-store)
        (ir.compiler-ir-instr-seq-empty))
      (opt-test-instr-seq-prepend
        (opt-bounds-run-add 4 1)
        (opt-test-instr-seq-prepend
          (opt-bounds-run-check
            (Var 4)
            (opt-bounds-run-length variant)
            "run_ok1")
          (opt-test-instr-seq-prepend
            (opt-bounds-run-add 5 2)
            (opt-test-instr-seq-prepend
              (opt-bounds-run-check
                (Var 5)
                (opt-bounds-run-length variant)
                "run_ok2")
              tail)))))))

(define (opt-bounds-run-decreasing [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-bounds-run-add 5 2)
    (opt-test-instr-seq-prepend
      (irt.instr "bounds_check %5, %2 message \"run_ok2\"")
      (opt-test-instr-seq-prepend
        (opt-bounds-run-add 4 1)
        (opt-test-instr-seq-prepend
          (irt.instr "bounds_check %4, %2 message \"run_ok1\"")
          (opt-test-instr-seq-prepend
            (irt.instr "bounds_check %1, %2 message \"run_ok0\"")
            tail))))))

(define (opt-bounds-run-pair [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-bounds-run-add 4 1)
    (opt-test-instr-seq-prepend
      (irt.instr "bounds_check %4, %2 message \"run_ok1\"")
      (opt-test-instr-seq-prepend
        (irt.instr "bounds_check %1, %2 message \"run_ok0\"")
        tail))))

(define (opt-bounds-run-instrs [variant : i64] [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (cond
    [(<= variant 2) (opt-bounds-run-increasing variant tail)]
    [(= variant 3) (opt-bounds-run-decreasing tail)]
    [else (opt-bounds-run-pair tail)]))

;; Variant 5 puts the run behind a dominating `idx >= 0` edge, which is the only
;; way the offset-0 check of a two-member run can go.
(define (opt-bounds-run-test-blocks [variant : i64]) : ir.CompilerIrBlockList
  (if (= variant 5)
    (ir.compiler-ir-blocks
      (irt.block
        "entry:
           %7 = ge %1, 0 : i64
           branch %7, guarded, exit")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "guarded")
        (opt-bounds-run-instrs variant (irt.instrs "jump exit")))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "exit")
        (opt-bounds-run-return)))
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-bounds-run-instrs variant (opt-bounds-run-return))))))

(define (opt-bounds-run-rewrite [variant : i64]) : ir.CompilerIrBlockList
  (let
    [blocks : ir.CompilerIrBlockList (opt-bounds-run-test-blocks variant)]
    (opt.opt-bounds-dom-blocks-with-context
      (ast.ast-node-pool-reader-type-segment-bases)
      (& (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks)))
      (& (opt-bounds-dom-test-params))
      16
      (& blocks))))

(define (opt-bounds-run-checks [variant : i64]) : i64
  (let
    [walked-blocks : ir.CompilerIrBlockList (opt-bounds-run-rewrite variant)]
    (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view walked-blocks))))

;; Did the widening hoist the run's other bracket ahead of its first check? The
;; Add that computes the widest index is then the block's first instruction.
(define (opt-bounds-run-hoisted-add?
  [blocks : ir.CompilerIrBlockList]
  [label : String]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label (& label)))
    [(No) false]
    [(Some block)
      (match block
        [(Block _ instrs)
          (if (< (ir.compiler-ir-instr-seq-count instrs) 1)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(BinOp _ op _ rhs _)
                (and
                  (opt.opt-binop-eq (& op) (& (Add)))
                  (match rhs
                    [(I64 offset) (= offset 2)]
                    [_ false]))]
              [_ false]))])]))

(define (compiler-optimize-bounds-run-self-test) : i64
  (cond
    ;; the increasing run: two checks left, widest bracket hoisted to the front
    [(not (= (opt-bounds-run-checks 0) 2)) 1]
    [(not (opt-bounds-run-hoisted-add? (opt-bounds-run-rewrite 0) "entry")) 2]
    ;; an observable effect between the checks forbids the reordering
    [(not (= (opt-bounds-run-checks 1) 3)) 3]
    [(opt-bounds-run-hoisted-add? (opt-bounds-run-rewrite 1) "entry") 4]
    ;; two lengths: no bracket pair exists
    [(not (= (opt-bounds-run-checks 2) 3)) 5]
    ;; the decreasing run
    [(not (= (opt-bounds-run-checks 3) 2)) 6]
    ;; two members, unknown sign: the lower bracket is missing
    [(not (= (opt-bounds-run-checks 4) 2)) 7]
    ;; the same pair under a dominating `idx >= 0`
    [(not (= (opt-bounds-run-checks 5) 1)) 8]
    [else 42]))

(test
  bounds-dom-constant-offset-run-widening
  (test.assert-i64-eq
    (compiler-optimize-bounds-run-self-test)
    42
    "a constant-offset run against one length keeps only its two bracketing checks with the widest bracket hoisted to the run's front, while a store between the checks blocks the reordering, two lengths bracket nothing, and an offset below the run needs a dominating nonnegative fact"))

;; #7145: equivalent lengths can have distinct definitions inside the run.
;; Both bracket operands must be available after widening, in either order.
(define (opt-bounds-run-length-chain-blocks [links : i64] [descending : bool]) : ir.CompilerIrBlockList
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 20)]
    [at : i64 0]
    (while (< at 3)
      (let
        [offset : i64
          (if descending
            (- 2 at)
            at)]
        [idx : i64 (+ 4 at)]
        [length : i64 (+ 8 (* at 4))]
        [link : i64 1]
        (ir.compiler-ir-instr-builder-push!
          (&mut builder)
          (opt-bounds-run-add idx offset))
        (ir.compiler-ir-instr-builder-push!
          (&mut builder)
          (ir.CompilerIrInstr.Cast length (Var 2) (I64) (U64)))
        (while (< link links)
          (ir.compiler-ir-instr-builder-push!
            (&mut builder)
            (ir.CompilerIrInstr.Mov
              (+ length link)
              (Var (- (+ length link) 1))
              (U64)))
          (set! link (+ link 1)))
        (ir.compiler-ir-instr-builder-push!
          (&mut builder)
          (opt-bounds-run-check
            (Var idx)
            (Var (- (+ length links) 1))
            (str_cat.str-cat "length_chain_ok" (string.int->string at))))
        (set! at (+ at 1))))
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-bounds-run-append
          (ir.compiler-ir-instr-builder-to-seq builder)
          (opt-bounds-run-return))))))

(define (opt-bounds-run-length-chain-verified?
  [blocks : ir.CompilerIrBlockList]) : bool
  (opt.opt-verify-ok?
    (&
      (opt.opt-verify-function
        (&
          (Function
            (opt-test-symbol "bounds-length-chain")
            (opt-bounds-dom-test-params)
            (I64)
            20
            blocks
            Ordinary))))))

(define (opt-bounds-run-length-chain-ok? [links : i64] [descending : bool]) : bool
  (let
    [blocks : ir.CompilerIrBlockList
      (opt-bounds-run-length-chain-blocks links descending)]
    [input-ok : bool
      (opt-bounds-run-length-chain-verified?
        (ir.compiler-ir-global-shared-view blocks))]
    [next : ir.CompilerIrBlockList
      (opt.opt-bounds-dom-blocks-with-context
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks)))
        (& (opt-bounds-dom-test-params))
        20
        (& blocks))]
    (and
      input-ok
      (opt-bounds-run-length-chain-verified?
        (ir.compiler-ir-global-shared-view next))
      (=
        (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view next))
        (if (> links 2)
          3
          2)))))

(test
  bounds-dom-run-length-dependencies
  (test.assert-true
    (opt-bounds-run-length-chain-ok? 1 false)
    "increasing brackets move their length casts before use")
  (test.assert-true
    (opt-bounds-run-length-chain-ok? 1 true)
    "decreasing brackets move their length casts before use")
  (test.assert-true
    (opt-bounds-run-length-chain-ok? 2 false)
    "length cast/move chains preserve dependency order")
  (test.assert-true
    (opt-bounds-run-length-chain-ok? 2 true)
    "decreasing cast/move chains preserve dependency order")
  (test.assert-true
    (opt-bounds-run-length-chain-ok? 3 false)
    "over-budget length chains refuse widening")
  (test.assert-true
    (opt-bounds-run-length-chain-ok? 3 true)
    "decreasing over-budget length chains refuse widening"))

;; --- stride runs (BDOM-2) ----------------------------------------------------
;;
;; The words of one record, `idx * c + k` for 0 <= k < c, checked in SEPARATE
;; blocks (so the same-block widening above never acts) against a literal
;; length. One passed word decides the others exactly when c is a power of two
;; and c divides the length:
;;
;;   0 c = 4, L = 16, words 2, 3, 0: the first check stays, the other two go.
;;   1 c = 3, L = 15: a wrapped `idx * 3` can be 2^64 - 1, so nothing goes.
;;   2 c = 4, L = 18: 4 does not divide 18, so nothing goes.
;;   3 c = 4 against a length WORD: no literal, nothing goes.
;;   4 c = 4, L = 16, words 2, 5, 0: the +5 word is outside the record and
;;     stays; the +0 word still goes.
(define (opt-bounds-stride-check-block
  [label : String]
  [ok-label : String]
  [dst : i64]
  [offset : i64]
  [length : ir.CompilerIrValue]
  [next : String]) : ir.CompilerIrBlock
  (Block
    (ir.compiler-ir-label (& label))
    (opt-test-instr-seq-prepend
      (BinOp dst (Add) (Var 8) (I64 offset) (I64))
      (opt-test-instr-seq-prepend
        (opt-bounds-run-check (Var dst) length ok-label)
        (opt-test-instr-seq-prepend
          (Jump (ir.compiler-ir-label (& next)))
          (ir.compiler-ir-instr-seq-empty))))))

(define (opt-bounds-stride-test-blocks
  [scale : i64]
  [length : ir.CompilerIrValue]
  [second : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instr-seq-prepend
        (BinOp 8 (Mul) (Var 1) (I64 scale) (I64))
        (irt.instrs "jump w2")))
    (opt-bounds-stride-check-block
      "w2"
      "w2_ok"
      9
      2
      (ir.compiler-ir-global-shared-view length)
      "w3")
    (opt-bounds-stride-check-block
      "w3"
      "w3_ok"
      10
      second
      (ir.compiler-ir-global-shared-view length)
      "w0")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "w0")
      (opt-test-instr-seq-prepend
        (opt-bounds-run-check (Var 8) length "w0_ok")
        (opt-bounds-run-return)))))

(define (opt-bounds-stride-checks
  [scale : i64]
  [length : ir.CompilerIrValue]
  [second : i64]) : i64
  (let
    [blocks : ir.CompilerIrBlockList
      (opt-bounds-stride-test-blocks scale length second)]
    [walked-blocks : ir.CompilerIrBlockList
      (opt.opt-bounds-dom-blocks-with-context
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks)))
        (& (opt-bounds-dom-test-params))
        16
        (& blocks))]
    (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view walked-blocks))))

(define (compiler-optimize-bounds-stride-run-self-test) : i64
  (cond
    [(not (= (opt-bounds-stride-checks 4 (I64 16) 3) 1)) 1]
    [(not (= (opt-bounds-stride-checks 3 (I64 15) 3) 3)) 2]
    [(not (= (opt-bounds-stride-checks 4 (I64 18) 3) 3)) 3]
    [(not (= (opt-bounds-stride-checks 4 (Var 2) 3) 3)) 4]
    [(not (= (opt-bounds-stride-checks 4 (I64 16) 5) 2)) 5]
    [else 42]))

(test
  bounds-stride-run
  (test.assert-i64-eq
    (compiler-optimize-bounds-stride-run-self-test)
    42
    "the words of one record, idx * c + k in separate blocks against a literal length, are decided by the first passed word when c is a power of two dividing the length; a stride of three, a length the stride does not divide, a length word, and a word outside the record keep their checks"))

;; --- rule (a): a dominating fact decides a dominated compare -----------------
;;
;; The probes below drive `opt-dom-cmp-lookup` with a single fact in scope and
;; read its verdict as 0 unknown / 1 true / 2 false, which is exactly the
;; implication algebra without any CFG plumbing around it. The fixture after
;; them covers the two properties the algebra cannot see on its own: a fact is
;; only recorded for an operand the function defines once, and a bounds check an
;; equal-or-stronger dominating check subsumes is deleted.
(define (opt-rule-a-fact
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]
  [value : bool]) : opt.OptDomCmpFacts
  (opt.opt-dom-cmp-facts-cons (Fact op lhs rhs ty value 0) (Nil)))

(define (opt-rule-a-probe
  [fact-op : ir.CompilerIrBinOp]
  [fact-lhs : ir.CompilerIrValue]
  [fact-rhs : ir.CompilerIrValue]
  [fact-ty : ast.AstType]
  [fact-value : bool]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : i64
  (match (opt.opt-dom-cmp-lookup
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-rule-a-fact fact-op fact-lhs fact-rhs fact-ty fact-value))
    (& op)
    lhs
    rhs
    (& ty))
    [(No) 0]
    [(Some decided)
      (if decided
        1
        2)]))

(define (opt-rule-a-var) : ir.CompilerIrValue
  (Var 1))

(define (opt-rule-a-other) : ir.CompilerIrValue
  (Var 2))

(define (opt-rule-a-lit [value : i64]) : ir.CompilerIrValue
  (I64 value))

;; Operator and type shorthands: the qualified constructors are what make a
;; probe list unreadable, and every probe below needs several.
(define (opt-rule-a-lt) : ir.CompilerIrBinOp
  (Lt))

(define (opt-rule-a-le) : ir.CompilerIrBinOp
  (Le))

(define (opt-rule-a-gt) : ir.CompilerIrBinOp
  (Gt))

(define (opt-rule-a-ge) : ir.CompilerIrBinOp
  (Ge))

(define (opt-rule-a-ne) : ir.CompilerIrBinOp
  (Ne))

(define (opt-rule-a-i64) : ast.AstType
  (I64))

;; `v <fact-op> fact-k` decides `v <op> k`, both compares read in `ty`.
(define (opt-rule-a-typed-probe
  [fact-op : ir.CompilerIrBinOp]
  [fact-k : i64]
  [fact-value : bool]
  [op : ir.CompilerIrBinOp]
  [k : i64]
  [ty : ast.AstType]) : i64
  (opt-rule-a-probe
    fact-op
    (opt-rule-a-var)
    (opt-rule-a-lit fact-k)
    (opt.compiler-opt-global-shared-view ty)
    fact-value
    op
    (opt-rule-a-var)
    (opt-rule-a-lit k)
    ty))

(define (opt-rule-a-lit-probe
  [fact-op : ir.CompilerIrBinOp]
  [fact-k : i64]
  [fact-value : bool]
  [op : ir.CompilerIrBinOp]
  [k : i64]) : i64
  (opt-rule-a-typed-probe fact-op fact-k fact-value op k (opt-rule-a-i64)))

;; The first failing case wins: once `previous` is non-zero it is carried
;; through unchanged, so the returned code names the EARLIEST mismatch.
(define (opt-rule-a-step [previous : i64] [code : i64] [got : i64] [want : i64]) : i64
  (if (!= previous 0)
    previous
    (if (= got want)
      0
      code)))

(define (compiler-optimize-dom-cmp-rule-a-self-test) : i64
  (let
    [fail : i64 0]
    ;; (a) the identical compare, and its exact negation, still decide.
    (set!
      fail
      (opt-rule-a-step
        fail
        1
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-lt) 3)
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        2
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 false (opt-rule-a-lt) 3)
        2))
    ;; same operands, weaker operator: `i < 3` gives `i <= 3` and `i != 3`,
    ;; and refutes `i >= 3`.
    (set!
      fail
      (opt-rule-a-step
        fail
        3
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-le) 3)
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        4
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-ne) 3)
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        5
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-ge) 3)
        2))
    ;; `i > 0` decides `i >= 0`; `i >= 0` does NOT decide `i > 0`.
    (set!
      fail
      (opt-rule-a-step
        fail
        6
        (opt-rule-a-lit-probe (opt-rule-a-gt) 0 true (opt-rule-a-ge) 0)
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        7
        (opt-rule-a-lit-probe (opt-rule-a-ge) 0 true (opt-rule-a-gt) 0)
        0))
    ;; (b) a weaker literal: `i < 3` decides `i < 5`, and decides `i <= 2`
    ;; through the immediate-successor step.
    (set!
      fail
      (opt-rule-a-step
        fail
        8
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-lt) 5)
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        9
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-le) 2)
        1))
    ;; `i > 0` decides `i >= 1` (the successor step the other way round).
    (set!
      fail
      (opt-rule-a-step
        fail
        10
        (opt-rule-a-lit-probe (opt-rule-a-gt) 0 true (opt-rule-a-ge) 1)
        1))
    ;; `i >= 3` refutes `i < 2` and decides nothing about `i < 4`.
    (set!
      fail
      (opt-rule-a-step
        fail
        11
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 false (opt-rule-a-lt) 2)
        2))
    (set!
      fail
      (opt-rule-a-step
        fail
        12
        (opt-rule-a-lit-probe (opt-rule-a-lt) 3 false (opt-rule-a-lt) 4)
        0))
    ;; (d) the weaker literal only travels one way: `i < 5` says nothing
    ;; about `i < 3`, and a fact about another var never matches.
    (set!
      fail
      (opt-rule-a-step
        fail
        13
        (opt-rule-a-lit-probe (opt-rule-a-lt) 5 true (opt-rule-a-lt) 3)
        0))
    (set!
      fail
      (opt-rule-a-step
        fail
        14
        (opt-rule-a-probe
          (opt-rule-a-lt)
          (opt-rule-a-var)
          (opt-rule-a-lit 3)
          (opt-rule-a-i64)
          true
          (opt-rule-a-lt)
          (opt-rule-a-other)
          (opt-rule-a-lit 5)
          (opt-rule-a-i64))
        0))
    ;; two non-literal operands still decide through operand identity, in
    ;; either order: `i < n` refutes `n <= i`.
    (set!
      fail
      (opt-rule-a-step
        fail
        15
        (opt-rule-a-probe
          (opt-rule-a-lt)
          (opt-rule-a-var)
          (opt-rule-a-other)
          (opt-rule-a-i64)
          true
          (opt-rule-a-le)
          (opt-rule-a-other)
          (opt-rule-a-var)
          (opt-rule-a-i64))
        2))
    ;; (f) the literals are ordered in the FACT'S OWN type. Unsigned `i < 5`
    ;; decides `i < 0xffffffffffffffff`; the signed reading of the same two
    ;; literals puts `-1` BELOW `5`, where `i < 5` decides nothing.
    (set!
      fail
      (opt-rule-a-step
        fail
        16
        (opt-rule-a-typed-probe
          (opt-rule-a-lt)
          5
          true
          (opt-rule-a-lt)
          (- 0 1)
          (U64))
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        17
        (opt-rule-a-lit-probe (opt-rule-a-lt) 5 true (opt-rule-a-lt) (- 0 1))
        0))
    ;; (f) a fact in one type never decides a compare in another.
    (set!
      fail
      (opt-rule-a-step
        fail
        18
        (opt-rule-a-probe
          (opt-rule-a-lt)
          (opt-rule-a-var)
          (opt-rule-a-lit 3)
          (U64)
          true
          (opt-rule-a-lt)
          (opt-rule-a-var)
          (opt-rule-a-lit 3)
          (opt-rule-a-i64))
        0))
    ;; (f) the successor step refuses at the type's maximum, where `k + 1`
    ;; would wrap; the plain order still decides this one.
    (set!
      fail
      (opt-rule-a-step
        fail
        19
        (opt-rule-a-typed-probe
          (opt-rule-a-gt)
          127
          true
          (opt-rule-a-gt)
          (- 0 128)
          (I8))
        1))
    ;; The transitive step: `i < n` and `n <= len` decide `i < len`, which
    ;; neither fact names both operands of.
    (set!
      fail
      (opt-rule-a-step
        fail
        20
        (opt-rule-a-chain-probe (opt-rule-a-le) (opt-rule-a-lt))
        1))
    (set!
      fail
      (opt-rule-a-step
        fail
        21
        (opt-rule-a-chain-probe (opt-rule-a-le) (opt-rule-a-le))
        1))
    ;; Two non-strict steps give only `i <= len`.
    (set!
      fail
      (opt-rule-a-step
        fail
        22
        (opt-rule-a-chain-probe-op
          (opt-rule-a-le)
          (opt-rule-a-le)
          (opt-rule-a-lt))
        0))
    (set!
      fail
      (opt-rule-a-step
        fail
        23
        (opt-rule-a-chain-probe-op
          (opt-rule-a-le)
          (opt-rule-a-le)
          (opt-rule-a-le))
        1))
    ;; A step in the WRONG direction chains nothing: `n >= len` leaves
    ;; `i < len` open.
    (set!
      fail
      (opt-rule-a-step
        fail
        24
        (opt-rule-a-chain-probe (opt-rule-a-ge) (opt-rule-a-lt))
        0))
    (if (= fail 0)
      42
      fail)))

;; `i <head-op> n` from one fact and `n <mid-op> len` from another, queried as
;; `i <op> len` -- the shape a versioned loop leaves behind, where the header
;; bounds the counter and the entry guard bounds the bound. Var 1 is `i`,
;; var 2 is `n`, var 3 is `len`.
(define (opt-rule-a-chain-probe-op
  [head-op : ir.CompilerIrBinOp]
  [mid-op : ir.CompilerIrBinOp]
  [op : ir.CompilerIrBinOp]) : i64
  (match (opt.opt-dom-cmp-lookup-chained
    (ast.ast-node-pool-reader-type-segment-bases)
    (&
      (opt.opt-dom-cmp-facts-cons
        (Fact
          head-op
          (opt-rule-a-var)
          (opt-rule-a-other)
          (opt-rule-a-i64)
          true
          0)
        (opt-rule-a-chain-tail-facts mid-op)))
    (& op)
    (& (opt-rule-a-var))
    (& (Var 3))
    (& (opt-rule-a-i64)))
    [(No) 0]
    [(Some decided)
      (if decided
        1
        2)]))

(define (opt-rule-a-chain-tail-facts [mid-op : ir.CompilerIrBinOp]) : opt.OptDomCmpFacts
  (opt.opt-dom-cmp-facts-cons
    (Fact mid-op (opt-rule-a-other) (Var 3) (opt-rule-a-i64) true 0)
    (Nil)))

;; `i < n` chained through `n <mid-op> len`, queried as `i <op> len`.
(define (opt-rule-a-chain-probe
  [mid-op : ir.CompilerIrBinOp]
  [op : ir.CompilerIrBinOp]) : i64
  (opt-rule-a-chain-probe-op (opt-rule-a-lt) mid-op op))

;; Rule (a) at CFG scope. `entry` branches on `idx < 3`; the true arm re-tests
;; the weaker `idx < 5` (folded) and checks `(idx, 8)`, which the dominating
;; `(idx, 4)` check subsumes -- 4 <= 8 and the passed check proves the index
;; nonnegative -- while `(idx, 2)` is not subsumed and stays. The false arm's
;; `idx >= 3` decides nothing about `idx < 5`, so that copy survives.
(define (opt-rule-a-cfg-params) : ir.CompilerIrParamSeq
  (irt.params "idx=%0:i64"))

(define (opt-rule-a-cfg-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = lt %0, 3 : i64
       branch %1, hit, miss
     hit:
       %2 = lt %0, 5 : i64
       bounds_check %0, 4 message \"h_ok\"
       bounds_check %0, 8 message \"h2_ok\"
       bounds_check %0, 2 message \"h3_ok\"
       jump join
     miss:
       %3 = lt %0, 5 : i64
       jump join
     join:
       return %0"))

;; (c) The same shape with the compared operand REDEFINED. `n` is written in
;; two places, so it is not a single-source var and the guard's fact about it
;; is never recorded -- the dominated re-test must survive untouched.
(define (opt-rule-a-redef-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 1 : i64
       %2 = lt %1, 3 : i64
       branch %2, hit, join
     hit:
       %1 = mov 9 : i64
       %3 = lt %1, 5 : i64
       jump join
     join:
       return %1"))

(define (opt-rule-a-count-compares-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-rule-a-count-compares-seq
      instrs
      (+ index 1)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(BinOp _ _ _ _ _) (+ acc 1)]
        [_ acc]))))

(define (opt-rule-a-count-compares
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-rule-a-count-compares-seq instrs 0 0)
            (opt-rule-a-count-compares rest))])]))

(define (opt-rule-a-run
  [params : ir.CompilerIrParamSeq]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt.opt-bounds-dom-blocks-with-context
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks)))
    (& params)
    8
    (& blocks)))

(define (compiler-optimize-dom-cmp-rule-a-cfg-self-test) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-rule-a-cfg-blocks)]
    [after-blocks : ir.CompilerIrBlockList
      (opt-rule-a-run
        (opt-rule-a-cfg-params)
        (opt.compiler-opt-global-shared-view blocks))]
    [redef : ir.CompilerIrBlockList (opt-rule-a-redef-blocks)]
    [after-redef : ir.CompilerIrBlockList
      (opt-rule-a-run
        (ir.compiler-ir-param-seq-empty)
        (opt.compiler-opt-global-shared-view redef))]
    (cond
      [(not
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view blocks))
            3))
        1]
      [(not
          (=
            (opt-rule-a-count-compares (ir.compiler-ir-block-list-view blocks))
            3))
        2]
      ;; (e) kept: the dominating `(idx, 4)` check and the unsubsumed
      ;; `(idx, 2)`. dropped: `(idx, 8)`, which `(idx, 4)` subsumes.
      [(not
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view after-blocks))
            2))
        3]
      ;; (b) folded: `idx < 5` on the true arm. kept: the branch's own compare
      ;; and the false arm's copy, which `idx >= 3` does not decide.
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view after-blocks))
            2))
        4]
      [(not (= (ir.compiler-ir-block-list-count after-blocks) 4)) 5]
      [(not (opt.opt-cfg-successor-targets-known? after-blocks)) 6]
      ;; (c) nothing folds when the compared operand is redefined between.
      [(not
          (=
            (opt-rule-a-count-compares (ir.compiler-ir-block-list-view redef))
            2))
        7]
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view after-redef))
            2))
        8]
      [else 42])))

;; --- rule (phi): a compare every joining edge already decided ---------------
;;
;; One rotated-loop fixture in three shapes, driven through the same pass entry
;; the rule-a fixtures use. `mode` selects:
;;
;;   0 ADMITTED. The entry test enters the landing pad on its TRUE edge and the
;;     latch re-tests the same predicate of the values it carries, so both edges
;;     into the header decide `lo < hi` the same way and the header's own copy
;;     folds to a constant. The landing pad is the one-hop shape: it does not
;;     branch itself, so its own sole entry edge is what answers.
;;   1 REFUSED, edges disagree. The only change is that the entry test enters
;;     the landing pad on its FALSE edge: that edge now proves `lo >= hi` while
;;     the latch still proves `lo < hi`, so the two verdicts conflict.
;;   2 REFUSED, one edge decides nothing. The only change is the latch testing
;;     the stepped value against a DIFFERENT bound.
;;
;; vars: 0 lo (param), 1 hi (param), 8 other (param), 2 entry test, 3 header
;; phi, 5 stepped, 6 header test (the fold's target), 7 latch test.
(define (opt-phi-carried-params) : ir.CompilerIrParamSeq
  (irt.params "lo=%0:i64, hi=%1:i64, other=%8:i64"))

(define (opt-phi-carried-blocks [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
               return %1")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (irt.instr "%2 = lt %0, %1 : i64")
        (ir.CompilerIrInstr.Branch
          (Var 2)
          (ir.compiler-ir-label
            (&
              (if (= mode 1)
                "exit"
                "land")))
          (ir.compiler-ir-label
            (&
              (if (= mode 1)
                "land"
                "exit"))))))
    (irt.block "land:
           jump header")
    (irt.block
      "header:
             %3 = phi [%0, land], [%5, latch] : i64
             %6 = lt %3, %1 : i64
             branch %6, latch, exit")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "latch")
      (opt-test-instrs
        (irt.instr "%5 = add %3, 1 : i64")
        (ir.CompilerIrInstr.BinOp
          7
          (Lt)
          (Var 5)
          (Var
            (if (= mode 2)
              8
              1))
          (I64))
        (irt.instr "branch %7, header, exit")))))

(define (opt-phi-carried-run [blocks : (& blocks ir.CompilerIrBlockList)]) : ir.CompilerIrBlockList
  (let
    [blocks : ir.CompilerIrBlockList
      (owned_view.compiler-owned-reference-shared-view blocks)]
    (opt.opt-bounds-dom-blocks-with-context
      (ast.ast-node-pool-reader-type-segment-bases)
      (&
        (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks)))
      (& (opt-phi-carried-params))
      12
      (& blocks))))

(define (compiler-optimize-dom-cmp-phi-carried-self-test) : i64
  (let
    [admitted : ir.CompilerIrBlockList (opt-phi-carried-blocks 0)]
    [after : ir.CompilerIrBlockList (opt-phi-carried-run admitted)]
    ;; IDEMPOTENCE: the rewritten function is a fixed point of the same pass.
    [again : ir.CompilerIrBlockList (opt-phi-carried-run after)]
    [disagree : ir.CompilerIrBlockList (opt-phi-carried-blocks 1)]
    [after-disagree : ir.CompilerIrBlockList (opt-phi-carried-run disagree)]
    [undecided : ir.CompilerIrBlockList (opt-phi-carried-blocks 2)]
    [after-undecided : ir.CompilerIrBlockList (opt-phi-carried-run undecided)]
    (cond
      ;; four BinOps go in: the entry test, the header test, the step, the
      ;; latch test.
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view admitted))
            4))
        1]
      ;; ADMITTED: the header test became a Mov; nothing else moved.
      [(not
          (=
            (opt-rule-a-count-compares (ir.compiler-ir-block-list-view after))
            3))
        2]
      [(not (= (ir.compiler-ir-block-list-count after) 5)) 3]
      [(not (opt.opt-cfg-successor-targets-known? after)) 4]
      [(not
          (=
            (opt-rule-a-count-compares (ir.compiler-ir-block-list-view again))
            3))
        5]
      [(not (= (ir.compiler-ir-block-list-count again) 5)) 6]
      ;; REFUSED (edges disagree): all four survive.
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view disagree))
            4))
        7]
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view after-disagree))
            4))
        8]
      ;; REFUSED (one edge decides nothing): all four survive.
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view undecided))
            4))
        9]
      [(not
          (=
            (opt-rule-a-count-compares
              (ir.compiler-ir-block-list-view after-undecided))
            4))
        10]
      [else 42])))

;; --- rule (branch): a BRANCH a dominating branch already decided ------------
;;
;; GVN unifies the dominated duplicate compare with the dominating one, so the
;; dominated block holds `Mov c2 = c1` plus `branch c2` and no comparison at
;; all: the compare fold has nothing to rewrite and only the branch itself can
;; be decided. `mode` selects the shape (vars: 0 idx, 1 len, 8 other are
;; parameters; 2 the deciding compare, 3 the dominated condition, 4 an opaque
;; test, 5/6/9/10 the u64 casts):
;;
;;   0 the TRUE edge of a dominating branch on the same compare.
;;   1 the FALSE edge of the same branch, which decides the negation.
;;   2 a passed `bounds_check idx,len`, which records `0 <= idx < len`; the
;;     branch sits below it in a block holding no comparison.
;;   3 the compare's operands are `cast i64 -> u64` of the deciding branch's
;;     operands, spelled with FRESH cast destinations, so only the pass's cast
;;     canonicalization makes the two compares the same question.
;;   4 REFUSED: the branch sits at a JOIN the deciding edge does not dominate.
(define (opt-branch-fold-params) : ir.CompilerIrParamSeq
  (irt.params "idx=%0:i64, len=%1:i64, other=%8:i64"))

(define (opt-branch-fold-entry-instrs [mode : i64]) : ir.CompilerIrInstrSeq
  (cond
    [(= mode 2)
      (irt.instrs
        "bounds_check %0, %1 message \"e_ok\"
         %2 = lt %0, %1 : i64
         %4 = ne %8, 0 : i64
         branch %4, hit, miss")]
    [(= mode 3)
      (irt.instrs
        "%5 = cast %0 : i64 to u64
         %6 = cast %1 : i64 to u64
         %2 = lt %5, %6 : u64
         branch %2, hit, miss")]
    [else
      (opt-test-instrs
        (irt.instr "%2 = lt %0, %1 : i64")
        (ir.CompilerIrInstr.Branch
          (Var 2)
          (ir.compiler-ir-label
            (&
              (if (= mode 1)
                "miss"
                "hit")))
          (ir.compiler-ir-label
            (&
              (if (= mode 1)
                "hit"
                "miss")))))]))

(define (opt-branch-fold-hit-instrs [mode : i64]) : ir.CompilerIrInstrSeq
  (cond
    [(= mode 2) (irt.instrs "branch %2, inner, alt")]
    [(= mode 3)
      (irt.instrs
        "%9 = cast %0 : i64 to u64
         %10 = cast %1 : i64 to u64
         %3 = lt %9, %10 : u64
         branch %3, inner, alt")]
    [else (irt.instrs "%3 = mov %2 : bool
         branch %3, inner, alt")]))

(define (opt-branch-fold-tail-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "miss:
       jump join
     inner:
       jump join
     alt:
       jump join
     join:
       return %0"))

(define (opt-branch-fold-blocks [mode : i64]) : ir.CompilerIrBlockList
  (if (= mode 4)
    ;; The deciding branch's two arms meet at `merge`, which the true edge does
    ;; not dominate, so no fact reaches the branch there.
    (irt.blocks
      "entry:
         %2 = lt %0, %1 : i64
         branch %2, hit, miss
       hit:
         jump merge
       miss:
         jump merge
       merge:
         %3 = mov %2 : bool
         branch %3, inner, alt
       inner:
         jump join
       alt:
         jump join
       join:
         return %0")
    (ir.compiler-ir-blocks-with-tail
      (opt-branch-fold-tail-blocks)
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-branch-fold-entry-instrs mode))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "hit")
        (opt-branch-fold-hit-instrs mode)))))

;; A diamond whose dominated branch is decided TRUE and whose dead arm carries
;; one input of the merge phi: the CFG cleanup that runs below this pass must
;; drop exactly that input and the block it came from.
(define (opt-branch-fold-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = lt %0, %1 : i64
       branch %2, hit, miss
     hit:
       %3 = mov %2 : bool
       branch %3, inner, alt
     inner:
       %4 = mov 7 : i64
       jump join
     alt:
       %5 = mov 9 : i64
       jump join
     miss:
       %6 = mov 5 : i64
       jump join
     join:
       %7 = phi [%4, inner], [%5, alt], [%6, miss] : i64
       return %7"))

;; `want` is 1 for a branch decided TRUE and 0 for one decided FALSE.
(define (opt-branch-fold-count-seq
  [instrs : ir.CompilerIrInstrSeq]
  [want : i64]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (let
      [next-acc : i64
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(Branch cond _ _)
            (match cond
              [(Bool known)
                (if known
                  (if (= want 1)
                    (+ acc 1)
                    acc)
                  (if (= want 1)
                    acc
                    (+ acc 1)))]
              [_ acc])]
          [_ acc])]
      (opt-branch-fold-count-seq instrs want (+ index 1) next-acc))))

(define (opt-branch-fold-count
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [want : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-branch-fold-count-seq instrs want 0 0)
            (opt-branch-fold-count rest want))])]))

(define (opt-branch-fold-phi-inputs-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (let
      [next-acc : i64
        (match (ir.compiler-ir-instr-seq-ref instrs index)
          [(Phi _ inputs _) (+ acc (ir.compiler-ir-phi-input-seq-count inputs))]
          [_ acc])]
      (opt-branch-fold-phi-inputs-seq instrs (+ index 1) next-acc))))

(define (opt-branch-fold-phi-inputs
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-branch-fold-phi-inputs-seq instrs 0 0)
            (opt-branch-fold-phi-inputs rest))])]))

(define (opt-branch-fold-run [blocks : (& blocks ir.CompilerIrBlockList)]) : ir.CompilerIrBlockList
  (let
    [blocks : ir.CompilerIrBlockList
      (owned_view.compiler-owned-reference-shared-view blocks)]
    (opt.opt-bounds-dom-blocks-with-context
      (ast.ast-node-pool-reader-type-segment-bases)
      (&
        (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks)))
      (& (opt-branch-fold-params))
      12
      (& blocks))))

(define (opt-branch-fold-count-is?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [want : i64]
  [expected : i64]) : bool
  (=
    (opt-branch-fold-count (ir.compiler-ir-block-list-view blocks) want)
    expected))

(define (opt-branch-fold-block-count-is?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [expected : i64]) : bool
  (= (ir.compiler-ir-block-list-count blocks) expected))

(define (opt-branch-fold-phi-input-count-is?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [expected : i64]) : bool
  (=
    (opt-branch-fold-phi-inputs (ir.compiler-ir-block-list-view blocks))
    expected))

(define (opt-branch-fold-successors-known?
  [blocks : (& blocks ir.CompilerIrBlockList)]) : bool
  (let
    [blocks-2 (owned_view.compiler-owned-reference-shared-view blocks)]
    (opt.opt-cfg-successor-targets-known? blocks-2)))

(define (compiler-optimize-dom-cmp-branch-fold-self-test) : i64
  (let
    [same : ir.CompilerIrBlockList (opt-branch-fold-blocks 0)]
    [after-same : ir.CompilerIrBlockList (opt-branch-fold-run same)]
    ;; IDEMPOTENCE: the rewritten function is a fixed point of the same pass.
    [again : ir.CompilerIrBlockList (opt-branch-fold-run after-same)]
    [negated : ir.CompilerIrBlockList (opt-branch-fold-blocks 1)]
    [after-negated : ir.CompilerIrBlockList (opt-branch-fold-run negated)]
    [checked : ir.CompilerIrBlockList (opt-branch-fold-blocks 2)]
    [after-checked : ir.CompilerIrBlockList (opt-branch-fold-run checked)]
    [casted : ir.CompilerIrBlockList (opt-branch-fold-blocks 3)]
    [after-casted : ir.CompilerIrBlockList (opt-branch-fold-run casted)]
    [joined : ir.CompilerIrBlockList (opt-branch-fold-blocks 4)]
    [after-joined : ir.CompilerIrBlockList (opt-branch-fold-run joined)]
    [diamond : ir.CompilerIrBlockList (opt-branch-fold-phi-blocks)]
    [after-diamond : ir.CompilerIrBlockList (opt-branch-fold-run diamond)]
    [cleaned : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks (& after-diamond))]
    (cond
      ;; (a) the dominating branch's TRUE edge decides the copy the dominated
      ;; block branches on. Nothing else in the function is decided.
      [(not (opt-branch-fold-count-is? (& same) 1 0)) 1]
      [(not (opt-branch-fold-count-is? (& same) 0 0)) 2]
      [(not (opt-branch-fold-count-is? (& after-same) 1 1)) 3]
      [(not (opt-branch-fold-count-is? (& after-same) 0 0)) 4]
      ;; The terminators keep both successor labels, so the block set and the
      ;; CFG this pass hands to sccp are untouched.
      [(not (opt-branch-fold-block-count-is? (& after-same) 6)) 5]
      [(not (opt-branch-fold-successors-known? (& after-same))) 6]
      [(not (opt-branch-fold-count-is? (& again) 1 1)) 7]
      [(not (opt-branch-fold-block-count-is? (& again) 6)) 8]
      ;; (b) the FALSE edge of the same branch decides the negation.
      [(not (opt-branch-fold-count-is? (& after-negated) 0 1)) 9]
      [(not (opt-branch-fold-count-is? (& after-negated) 1 0)) 10]
      ;; (c) a passed bounds check decides `idx < len` for the branch below it,
      ;; in a block that holds no comparison at all.
      [(not (opt-branch-fold-count-is? (& after-checked) 1 1)) 11]
      [(not (opt-branch-fold-count-is? (& after-checked) 0 0)) 12]
      ;; (d) the same question spelled through fresh `cast i64 -> u64`
      ;; destinations on both operands.
      [(not (opt-branch-fold-count-is? (& after-casted) 1 1)) 13]
      [(not (opt-branch-fold-count-is? (& after-casted) 0 0)) 14]
      ;; (e) REFUSED at a join the deciding edge does not dominate.
      [(not (opt-branch-fold-count-is? (& after-joined) 1 0)) 15]
      [(not (opt-branch-fold-count-is? (& after-joined) 0 0)) 16]
      [(not (opt-branch-fold-block-count-is? (& after-joined) 7)) 17]
      ;; (f) the dead arm's phi input, and the arm itself, go away in the CFG
      ;; cleanup that runs below this pass -- not in the pass.
      [(not (opt-branch-fold-phi-input-count-is? (& diamond) 3)) 18]
      [(not (opt-branch-fold-count-is? (& after-diamond) 1 1)) 19]
      [(not (opt-branch-fold-phi-input-count-is? (& after-diamond) 3)) 20]
      [(not (opt-branch-fold-block-count-is? (& after-diamond) 6)) 21]
      [(not (opt-branch-fold-block-count-is? (& cleaned) 5)) 22]
      [(not (opt-branch-fold-phi-input-count-is? (& cleaned) 2)) 23]
      [(not (opt-branch-fold-count-is? (& cleaned) 1 0)) 24]
      [(not (opt-branch-fold-successors-known? (& cleaned))) 25]
      [else 42])))

(define (compiler-optimize-bounds-self-test) : i64
  (let
    [duplicate : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-duplicate-instrs))]
    [different : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-different-instrs))]
    [redef : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-redef-instrs))]
    [call : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-call-instrs))]
    [branch : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-branch-instrs))]
    [copy : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-bounds-copy-instrs)))]
    [dce : ir.CompilerIrInstrSeq
      (let
        [set
          (let
            [set (opt_i64_i64_map.with-capacity 64)]
            [instrs (opt-bounds-dce-instrs)]
            (opt-test-collect-instrs-uses set instrs))]
        [instrs (opt-bounds-dce-instrs)]
        (opt-test-dce-instrs set instrs))]
    [cross : ir.CompilerIrBlockList
      (opt.opt-blocks-build
        (opt-bounds-cross-blocks)
        opt-test-optimize-block-list!
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases))]
    [index-cast : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-index-cast-instrs))]
    [index-cast-redef : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt-bounds-index-cast-redef-instrs))]
    (cond
      [(not (= (opt-count-bounds-instrs duplicate) 1)) 1]
      [(not (= (opt-count-bounds-instrs different) 2)) 2]
      [(not (= (opt-count-bounds-instrs redef) 2)) 3]
      [(not (= (opt-count-bounds-instrs call) 2)) 4]
      [(not (= (opt-count-bounds-instrs branch) 2)) 5]
      [(not (= (opt-count-bounds-instrs copy) 1)) 6]
      [(not (= (ir.compiler-ir-instr-seq-count dce) 3)) 7]
      [(not
          (=
            (opt.opt-count-bounds-blocks (ir.compiler-ir-block-list-view cross))
            2))
        8]
      [(not (= (opt-count-bounds-instrs index-cast) 1)) 9]
      [(not (= (opt-count-bounds-instrs index-cast-redef) 2)) 10]
      [else 42])))

;; Copy propagation can expose a repeated expression only after CSE has already
;; run for that iteration. A second pass then CSEs `v3` to `v2`; copy propagation
;; rewrites `v4`, and DCE drops the now-unused copy.
(define (opt-fixed-point-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov %0 : i64
     %2 = add %0, 1 : i64
     %3 = add %1, 1 : i64
     %4 = add %2, %3 : i64
     return %4"))

(define (opt-test-function-symbol [name : i64] [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    name
    (ir.compiler-ir-param-seq-empty)
    (I64)
    5
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))
    Ordinary))

(define (opt-test-function-named
  [name : String]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (opt-test-function-symbol (opt-test-symbol name) instrs))

(define (opt-test-function [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (opt-test-function-named "fixed" instrs))

(define (opt-test-program [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (opt-test-function instrs))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)))

;; Self-test helper: exposes the first optimized block as a list for existing
;; instruction-count assertions; not used by production passes.
(define (opt-function-first-instrs [func : (& func ir.CompilerIrFunction)]) : ir.CompilerIrInstrSeq
  (match (owned_view.compiler-owned-reference-shared-view func)
    [(Function _ _ _ _ blocks _)
      (match (ir.compiler-ir-block-list-view blocks)
        [(slice block & _)
          (match (owned_view.compiler-owned-reference-shared-view block)
            [(Block _ instrs) instrs])]
        [(slice) (ir.compiler-ir-instr-seq-empty)])]))

(define (opt-program-first-instrs [program : (& program ir.CompilerIrProgram)]) : ir.CompilerIrInstrSeq
  (match (owned_view.compiler-owned-reference-shared-view program)
    [(Program _ funcs _)
      (if (> funcs.len 0)
        (let
          [func (ir.compiler-ir-function-seq-ref funcs 0)]
          (opt-function-first-instrs func))
        (ir.compiler-ir-instr-seq-empty))]))

(define (opt-program-functions [program : (& program ir.CompilerIrProgram)]) : ir.CompilerIrFunctionSeq
  (match (owned_view.compiler-owned-reference-shared-view program)
    [(Program _ funcs _) funcs]))

(define (opt-program-globals [program : ir.CompilerIrProgram]) : ir.CompilerIrGlobalSeq
  (match program
    [(Program globals _ _) globals]))

(define (opt-global-list-defines?
  [globals : (& globals ir.CompilerIrGlobalSeq)]
  [name : String]) : bool
  (let
    [globals : ir.CompilerIrGlobalSeq
      (owned_view.compiler-owned-reference-shared-view globals)]
    (opt-global-seq-defines? globals name 0)))

(define (opt-global-seq-defines?
  [globals : ir.CompilerIrGlobalSeq]
  [name : String]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-global-seq-count globals))
    false
    (match (ir.compiler-ir-global-seq-ref globals index)
      [(Global global-name _ _)
        (if (string.eq (ir.compiler-ir-symbol-text global-name) name)
          true
          (opt-global-seq-defines? globals name (+ index 1)))])))

(define (opt-level-parse-ok? [value : String] [expected : i64]) : bool
  (match (compiler-optimize-parse-level value)
    [(Ok level) (= level expected)]
    [(Err) false]))

(define (opt-level-parse-err? [value : String]) : bool
  (match (compiler-optimize-parse-level value)
    [(Ok _) false]
    [(Err) true]))

(define (compiler-optimize-level-policy-ok?) : bool
  (and
    (= (opt.compiler-optimize-default-level) 1)
    (compiler-optimize-level-valid? 0)
    (compiler-optimize-level-valid? 1)
    (compiler-optimize-level-valid? 2)
    (not (compiler-optimize-level-valid? 3))
    (not (compiler-optimize-level-valid? (- 0 1)))
    (not (compiler-optimize-level-valid? 4))
    (opt-level-parse-ok? "0" 0)
    (opt-level-parse-ok? "1" 1)
    (opt-level-parse-ok? "2" 2)
    (opt-level-parse-err? "3")
    (opt-level-parse-err? "")
    (opt-level-parse-err? "4")
    (opt-level-parse-err? "10")))

;; Whole-program structural equality: globals, functions and externs pairwise.
(define (opt-test-program-eq
  [type-segment-bases : i64]
  [a : ir.CompilerIrProgram]
  [b : ir.CompilerIrProgram]) : bool
  (match a
    [(Program aglobals afunctions aexterns)
      (match b
        [(Program bglobals bfunctions bexterns)
          (and
            (= aglobals.len bglobals.len)
            (= afunctions.len bfunctions.len)
            (= aexterns.len bexterns.len)
            (let
              [index : i64 0]
              [same? : bool true]
              (while (and same? (< index aglobals.len))
                (match (ir.compiler-ir-global-seq-ref aglobals index)
                  [(Global aname aty avalue)
                    (match (ir.compiler-ir-global-seq-ref bglobals index)
                      [(Global bname bty bvalue)
                        (set!
                          same?
                          (and
                            (ir.compiler-ir-symbol-eq? aname bname)
                            (opt.opt-type-eq type-segment-bases aty (& bty))
                            (opt.opt-value-eq (& avalue) (& bvalue))))])])
                (set! index (+ index 1)))
              (set! index 0)
              (while (and same? (< index afunctions.len))
                (set!
                  same?
                  (let
                    [a
                      (opt.compiler-opt-borrowed-array-element-shared-view
                        afunctions.slots
                        index)]
                    [b
                      (opt.compiler-opt-borrowed-array-element-shared-view
                        bfunctions.slots
                        index)]
                    (opt.opt-function-eq type-segment-bases a b)))
                (set! index (+ index 1)))
              (set! index 0)
              (while (and same? (< index aexterns.len))
                (match (ir.compiler-ir-extern-seq-ref aexterns index)
                  [(Extern aid asource aname aty aabi asymbol alinks aprovided)
                    (match (ir.compiler-ir-extern-seq-ref bexterns index)
                      [(Extern
                          bid
                          bsource
                          bname
                          bty
                          babi
                          bsymbol
                          blinks
                          bprovided)
                        (set!
                          same?
                          (and
                            (= aid bid)
                            (= asource bsource)
                            (string.eq aname bname)
                            (opt.opt-type-eq type-segment-bases aty (& bty))
                            (ast.ast-extern-abi-eq? (& aabi) (& babi))
                            (= asymbol bsymbol)
                            (ast.ast-extern-link-input-list-eq?
                              (& alinks)
                              (& blinks))
                            (= aprovided bprovided)))])])
                (set! index (+ index 1)))
              same?))])]))

(define (compiler-optimize-level-program-ok?) : bool
  (let
    [program : ir.CompilerIrProgram (opt-test-program (opt-self-test-instrs))]
    [level0 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt.compiler-opt-global-shared-view program)
        0)]
    [level1 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt.compiler-opt-global-shared-view program)
        1)]
    [level2 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt.compiler-opt-global-shared-view program)
        2)]
    [defaulted : ir.CompilerIrProgram
      (match (opt.optimize-program-with-spans
        (& program)
        (ir.compiler-source-spans-empty))
        [(Program optimized _) optimized])]
    [fixed-program : ir.CompilerIrProgram
      (opt-test-program (opt-fixed-point-instrs))]
    [level1-fixed : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt.compiler-opt-global-shared-view fixed-program)
        1)]
    [level2-fixed : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level fixed-program 2)]
    [level0-instrs : ir.CompilerIrInstrSeq (opt-program-first-instrs level0)]
    [level1-instrs : ir.CompilerIrInstrSeq (opt-program-first-instrs level1)]
    [level2-instrs : ir.CompilerIrInstrSeq (opt-program-first-instrs level2)]
    [level1-fixed-instrs : ir.CompilerIrInstrSeq
      (opt-program-first-instrs level1-fixed)]
    [level2-fixed-instrs : ir.CompilerIrInstrSeq
      (opt-program-first-instrs level2-fixed)]
    (cond
      [(not
          (opt-test-program-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            program
            level0))
        false]
      [(not (= (opt-count-arith-instr-seq level0-instrs) 1)) false]
      [(not (= (ir.compiler-ir-instr-seq-count level1-instrs) 0)) false]
      [(not (= (ir.compiler-ir-instr-seq-count level2-instrs) 0)) false]
      [(not
          (opt-test-program-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            level1
            defaulted))
        false]
      [(not (= (ir.compiler-ir-instr-seq-count level1-fixed-instrs) 4)) false]
      [(not (= (opt-count-arith-instr-seq level1-fixed-instrs) 3)) false]
      [(not (= (ir.compiler-ir-instr-seq-count level2-fixed-instrs) 3)) false]
      [(not (= (opt-count-arith-instr-seq level2-fixed-instrs) 2)) false]
      [else true])))

(define (compiler-optimize-level1-escape-equivalent-one-ok?
  [func : ir.CompilerIrFunction]) : bool
  (let
    [summaries : opt.OptProgramSummaries (opt.opt-program-summaries-empty)]
    [expected : ir.CompilerIrFunction
      (opt.optimize-function-with-level-and-summaries
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (& func)
        1
        (& summaries))]
    [scratch : i64 (arena.tl_arena_make)]
    [escaped : ir.CompilerIrFunction
      (opt.optimize-function-level1-escaping-with-summaries
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (& func)
        scratch
        (& summaries))]
    [ok : bool
      (opt.opt-function-eq
        (ast.ast-node-pool-reader-type-segment-bases)
        expected
        escaped)]
    (unsafe
      (arena.tl_arena_destroy scratch))
    ok))

(define (compiler-optimize-level1-escape-equivalent-ok?) : bool
  (and
    (compiler-optimize-level1-escape-equivalent-one-ok?
      (opt-test-function (irt.instrs "return 0")))
    (compiler-optimize-level1-escape-equivalent-one-ok?
      (opt-test-function (opt-self-test-instrs)))))

(define (compiler-optimize-level-self-test) : i64
  (unless (compiler-optimize-level-policy-ok?) (return 1))
  (unless (compiler-optimize-level-program-ok?) (return 2))
  (unless (compiler-optimize-level1-escape-equivalent-ok?) (return 3))
  42)

(defstruct OptGlobalDceTestSymbols
  (main i64)
  (helper i64)
  (dead i64)
  (callback-target i64)
  (callback i64)
  (used-global i64)
  (stored-global i64)
  (runtime-global i64)
  (dead-global i64))

(define (opt-global-dce-test-symbols) : OptGlobalDceTestSymbols
  (OptGlobalDceTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "helper")
    (opt-test-symbol "dead")
    (opt-test-symbol "callback-target")
    (opt-test-symbol "callback")
    (opt-test-symbol "used-global")
    (opt-test-symbol "stored-global")
    (opt-test-symbol "runtime-global")
    (opt-test-symbol "dead-global")))

(define (opt-global-dce-main-instrs [symbols : OptGlobalDceTestSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Mov 3 (Global symbols.used-global) (I64))
    (ir.CompilerIrInstr.Store symbols.stored-global (I64 99) (I64))
    (ir.CompilerIrInstr.Call 1 symbols.helper (Nil) (I64))
    (irt.instr "%2 = call tl_substring(0, 0, 0) : i64")
    (irt.instr "return %3")))

(define (opt-global-dce-return-instrs [value : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 value)))))

(define (opt-global-dce-large-return-step [idx : i64] [value : i64]) : ir.CompilerIrInstrSeq
  (if (>= idx 9)
    (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 value))))
    (opt-test-instrs-with-tail
      (opt-global-dce-large-return-step (+ idx 1) value)
      (ir.CompilerIrInstr.Mov idx (I64 value) (I64)))))

;; A direct-called fixture callee whose call-free body exceeds the opt1
;; tiny-leaf cap, so the level-1 pruning assertions keep an out-of-line
;; callee to observe instead of watching it get inlined away.
(define (opt-global-dce-large-callee [name : i64] [value : i64]) : ir.CompilerIrFunction
  (Function
    name
    (ir.compiler-ir-param-seq-empty)
    (I64)
    10
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-global-dce-large-return-step 0 value)))
    Ordinary))

(define (opt-global-dce-globals [symbols : OptGlobalDceTestSymbols]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 5)]
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.callback
      (I64)
      (Global symbols.callback-target))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.used-global
      (I64)
      (I64 3))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.stored-global
      (I64)
      (I64 0))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.runtime-global
      (I64)
      (Unit))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.dead-global
      (I64)
      (I64 5))
    (ir.compiler-ir-global-builder-to-seq builder)))

(define (opt-global-dce-program [symbols : OptGlobalDceTestSymbols]) : ir.CompilerIrProgram
  (Program
    (opt-global-dce-globals symbols)
    (ir.compiler-ir-function-seq-prepend
      (&
        (opt-test-function-symbol
          symbols.main
          (opt-global-dce-main-instrs symbols)))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (opt-global-dce-large-callee symbols.helper 7))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-test-function-symbol
                  symbols.dead
                  (opt-global-dce-return-instrs 9)))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-test-function-symbol
                      symbols.callback-target
                      (opt-global-dce-return-instrs 11)))
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (&
                        (opt-test-function-named
                          "C:/repo/stdlib/runtime.tl::substring"
                          (opt-global-dce-return-instrs 13)))
                      (&
                        (ir.compiler-ir-function-seq-prepend
                          (&
                            (opt-test-function-named
                              "C:/repo/stdlib/runtime.tl::int-to-string"
                              (opt-global-dce-return-instrs 17)))
                          (& (ir.compiler-ir-function-seq-empty)))))))))))))
    (ir.compiler-ir-extern-seq-empty)))

(define (opt-global-dce-no-main-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (opt-test-function-named "helper" (opt-global-dce-return-instrs 7)))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (opt-test-function-named "dead" (opt-global-dce-return-instrs 9)))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)))

(define (compiler-optimize-global-dce-ok?) : bool
  (let
    [symbols : OptGlobalDceTestSymbols (opt-global-dce-test-symbols)]
    [program : ir.CompilerIrProgram (opt-global-dce-program symbols)]
    ;; Level 0 keeps every function; level 1 (the cheap optimized build) prunes
    ;; functions unreachable from the roots without inlining the survivors.
    [level0 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt.compiler-opt-global-shared-view program)
        0)]
    [level1 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level program 1)]
    [no-main : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level (opt-global-dce-no-main-program) 1)]
    [level0-functions : ir.CompilerIrFunctionSeq (opt-program-functions level0)]
    [level1-functions : ir.CompilerIrFunctionSeq (opt-program-functions level1)]
    [no-main-functions : ir.CompilerIrFunctionSeq
      (opt-program-functions no-main)]
    [level0-globals : ir.CompilerIrGlobalSeq (opt-program-globals level0)]
    [level1-globals : ir.CompilerIrGlobalSeq (opt-program-globals level1)]
    (and
      (= (ir.compiler-ir-function-seq-count level0-functions) 6)
      (= (ir.compiler-ir-function-seq-count level1-functions) 4)
      (= (ir.compiler-ir-global-seq-count level0-globals) 5)
      (= (ir.compiler-ir-global-seq-count level1-globals) 3)
      (opt.opt-function-seq-defines? level1-functions "main")
      (opt.opt-function-seq-defines? level1-functions "helper")
      (opt.opt-function-seq-defines? level1-functions "callback-target")
      (opt.opt-function-seq-defines?
        level1-functions
        "C:/repo/stdlib/runtime.tl::substring")
      (not
        (opt.opt-function-seq-defines?
          level1-functions
          "C:/repo/stdlib/runtime.tl::int-to-string"))
      (not (opt.opt-function-seq-defines? level1-functions "dead"))
      (opt-global-list-defines? level1-globals "used-global")
      (opt-global-list-defines? level1-globals "stored-global")
      (opt-global-list-defines? level1-globals "runtime-global")
      (not (opt-global-list-defines? level1-globals "dead-global"))
      (not (opt-global-list-defines? level1-globals "callback"))
      (= (ir.compiler-ir-function-seq-count no-main-functions) 2))))

(define (compiler-optimize-global-dce-self-test) : i64
  (if (compiler-optimize-global-dce-ok?)
    42
    1))

(defstruct OptCallgraphTestSymbols
  (main i64)
  (a i64)
  (b i64)
  (c i64)
  (address-taken i64)
  (external i64)
  (rec-even i64)
  (rec-odd i64)
  (lonely i64)
  (self i64)
  (leaf i64))

(define (opt-callgraph-test-symbols) : OptCallgraphTestSymbols
  (OptCallgraphTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "a")
    (opt-test-symbol "b")
    (opt-test-symbol "c")
    (opt-test-symbol "address_taken")
    (opt-test-symbol "external")
    (opt-test-symbol "rec_even")
    (opt-test-symbol "rec_odd")
    (opt-test-symbol "lonely")
    (opt-test-symbol "self")
    (opt-test-symbol "leaf")))

(define (opt-callgraph-test-slot
  [index : (& index opt.OptFunctionIndex)]
  [name : i64]) : i64
  (match (opt.opt-function-index-slot index name)
    [(Some slot) slot]
    [(None) -1]))

(define (opt-callgraph-test-edge?
  [index : (& index opt.OptFunctionIndex)]
  [graph : (& graph opt.OptCallGraph)]
  [caller : i64]
  [callee : i64]) : bool
  (opt.opt-callgraph-has-edge?
    graph
    (opt-callgraph-test-slot index caller)
    (opt-callgraph-test-slot index callee)))

(define (opt-callgraph-test-edge-count
  [index : (& index opt.OptFunctionIndex)]
  [graph : (& graph opt.OptCallGraph)]
  [caller : i64]) : i64
  (let
    [graph : opt.OptCallGraph
      (owned_view.compiler-owned-reference-shared-view graph)]
    (opt-callgraph-callee-count graph (opt-callgraph-test-slot index caller))))

(define (opt-callgraph-main-instrs [symbols : OptCallgraphTestSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Call 0 symbols.a Nil (I64))
    (ir.CompilerIrInstr.Call 1 symbols.external Nil (I64))
    (ir.CompilerIrInstr.CallIndirect 2 (Function symbols.c) Nil (I64))
    (ir.CompilerIrInstr.Mov 3 (Global symbols.address-taken) (I64))
    (ir.CompilerIrInstr.TailCall symbols.b Nil (I64))))

(define (opt-callgraph-call-instrs [name : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Call 0 name Nil (I64))
    (irt.instr "return 0")))

(define (opt-callgraph-tail-instrs [name : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs (ir.CompilerIrInstr.TailCall name Nil (I64))))

(define (opt-callgraph-return-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "return 0"))

(define (opt-callgraph-acyclic-functions [symbols : OptCallgraphTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-test-function-symbol
        symbols.main
        (opt-callgraph-main-instrs symbols)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-test-function-symbol
            symbols.a
            (opt-callgraph-call-instrs symbols.c)))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-test-function-symbol symbols.b (opt-callgraph-return-instrs)))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (opt-test-function-symbol
                    symbols.c
                    (opt-callgraph-tail-instrs symbols.b)))
                (&
                  (ir.compiler-ir-function-seq-prepend
                    (&
                      (opt-test-function-symbol
                        symbols.address-taken
                        (opt-callgraph-return-instrs)))
                    (& (ir.compiler-ir-function-seq-empty))))))))))))

(define (opt-callgraph-rec-even-instrs [symbols : OptCallgraphTestSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Call 0 symbols.rec-odd Nil (I64))
    (ir.CompilerIrInstr.Call 1 symbols.rec-odd Nil (I64))
    (irt.instr "return 0")))

(define (opt-callgraph-recursive-functions [symbols : OptCallgraphTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-test-function-symbol
        symbols.rec-even
        (opt-callgraph-rec-even-instrs symbols)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-test-function-symbol
            symbols.rec-odd
            (opt-callgraph-tail-instrs symbols.rec-even)))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-test-function-symbol
                symbols.lonely
                (opt-callgraph-return-instrs)))
            (& (ir.compiler-ir-function-seq-empty))))))))

(define (compiler-optimize-callgraph-acyclic-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-callgraph-acyclic-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    (cond
      [(not (= graph.count 5)) false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.main) 2))
        false]
      [(not (opt-callgraph-test-edge? index graph symbols.main symbols.a))
        false]
      [(not (opt-callgraph-test-edge? index graph symbols.main symbols.b))
        false]
      [(opt-callgraph-test-edge? index graph symbols.main symbols.c) false]
      [(opt-callgraph-test-edge? index graph symbols.main symbols.address-taken)
        false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.a) 1)) false]
      [(not (opt-callgraph-test-edge? index graph symbols.a symbols.c)) false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.b) 0)) false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.c) 1)) false]
      [(not (opt-callgraph-test-edge? index graph symbols.c symbols.b)) false]
      [(not
          (=
            (opt-callgraph-test-edge-count index graph symbols.address-taken)
            0))
        false]
      [else true])))

(define (compiler-optimize-callgraph-recursive-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-callgraph-recursive-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    (cond
      [(not (= graph.count 3)) false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.rec-even) 1))
        false]
      [(not
          (opt-callgraph-test-edge?
            index
            graph
            symbols.rec-even
            symbols.rec-odd))
        false]
      [(opt-callgraph-test-edge? index graph symbols.rec-even symbols.rec-even)
        false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.rec-odd) 1))
        false]
      [(not
          (opt-callgraph-test-edge?
            index
            graph
            symbols.rec-odd
            symbols.rec-even))
        false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.lonely) 0))
        false]
      [else true])))

(define (opt-scc-result-component
  [result : (& result opt.OptSccResult)]
  [slot : i64]) : i64
  (array-ref result.scc-of slot))

(define (opt-scc-component-size
  [result : (& result opt.OptSccResult)]
  [scc-id : i64]) : i64
  (let
    [scc-of (& result.scc-of)]
    [count : i64 (array-length scc-of)]
    [slot : i64 0]
    [size : i64 0]
    (while (< slot count)
      (if (= (array-ref scc-of slot) scc-id)
        (set! size (+ size 1))
        unit)
      (set! slot (+ slot 1)))
    size))

(define (opt-scc-order-position
  [result : (& result opt.OptSccResult)]
  [scc-id : i64]) : i64
  (let
    [order (& result.order)]
    [count : i64 (array-length order)]
    [index : i64 0]
    [position : i64 (- 0 1)]
    (while (and (< index count) (< position 0))
      (if (= (array-ref order index) scc-id)
        (set! position index)
        unit)
      (set! index (+ index 1)))
    position))

(define (opt-scc-before?
  [result : (& result opt.OptSccResult)]
  [left : i64]
  [right : i64]) : bool
  (let
    [left-pos : i64 (opt-scc-order-position result left)]
    [right-pos : i64 (opt-scc-order-position result right)]
    (and (>= left-pos 0) (>= right-pos 0) (< left-pos right-pos))))

(define (opt-scc-self-recursive-functions [symbols : OptCallgraphTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-test-function-symbol
        symbols.self
        (opt-callgraph-tail-instrs symbols.self)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-test-function-symbol symbols.leaf (opt-callgraph-return-instrs)))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-optimize-scc-self-recursive-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-scc-self-recursive-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    [result : opt.OptSccResult (opt.opt-scc-compute graph)]
    [self-slot : i64 (opt-callgraph-test-slot index symbols.self)]
    [leaf-slot : i64 (opt-callgraph-test-slot index symbols.leaf)]
    [self-scc : i64 (opt-scc-result-component result self-slot)]
    [leaf-scc : i64 (opt-scc-result-component result leaf-slot)]
    (cond
      [(not (opt.opt-callgraph-has-edge? graph self-slot self-slot)) false]
      [(< self-scc 0) false]
      [(< leaf-scc 0) false]
      [(= self-scc leaf-scc) false]
      [(not (= (opt-scc-component-size result self-scc) 1)) false]
      [(not (= (opt-scc-component-size result leaf-scc) 1)) false]
      [else true])))

(define (compiler-optimize-scc-mutual-recursive-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-callgraph-recursive-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    [result : opt.OptSccResult (opt.opt-scc-compute graph)]
    [even-slot : i64 (opt-callgraph-test-slot index symbols.rec-even)]
    [odd-slot : i64 (opt-callgraph-test-slot index symbols.rec-odd)]
    [lonely-slot : i64 (opt-callgraph-test-slot index symbols.lonely)]
    [even-scc : i64 (opt-scc-result-component result even-slot)]
    [odd-scc : i64 (opt-scc-result-component result odd-slot)]
    [lonely-scc : i64 (opt-scc-result-component result lonely-slot)]
    (cond
      [(< even-scc 0) false]
      [(not (= even-scc odd-scc)) false]
      [(= even-scc lonely-scc) false]
      [(not (= (opt-scc-component-size result even-scc) 2)) false]
      [(not (= (opt-scc-component-size result lonely-scc) 1)) false]
      [else true])))

(define (compiler-optimize-scc-reverse-topo-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-callgraph-acyclic-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    [result : opt.OptSccResult (opt.opt-scc-compute graph)]
    [order : (__tl_dyn-array i64) result.order]
    [main-scc : i64
      (opt-scc-result-component
        result
        (opt-callgraph-test-slot index symbols.main))]
    [a-scc : i64
      (opt-scc-result-component
        result
        (opt-callgraph-test-slot index symbols.a))]
    [b-scc : i64
      (opt-scc-result-component
        result
        (opt-callgraph-test-slot index symbols.b))]
    [c-scc : i64
      (opt-scc-result-component
        result
        (opt-callgraph-test-slot index symbols.c))]
    [address-scc : i64
      (opt-scc-result-component
        result
        (opt-callgraph-test-slot index symbols.address-taken))]
    (cond
      [(not (= (array-length order) 5)) false]
      [(not (= (array-ref order 0) b-scc)) false]
      [(not (= (array-ref order 1) c-scc)) false]
      [(not (= (array-ref order 2) a-scc)) false]
      [(not (= (array-ref order 3) main-scc)) false]
      [(not (= (array-ref order 4) address-scc)) false]
      [(not (opt-scc-before? result b-scc c-scc)) false]
      [(not (opt-scc-before? result c-scc a-scc)) false]
      [(not (opt-scc-before? result a-scc main-scc)) false]
      [(not (opt-scc-before? result b-scc main-scc)) false]
      [else true])))

(define (compiler-optimize-scc-self-test) : i64
  (cond
    [(not (compiler-optimize-scc-self-recursive-ok?)) 1]
    [(not (compiler-optimize-scc-mutual-recursive-ok?)) 2]
    [(not (compiler-optimize-scc-reverse-topo-ok?)) 3]
    [else 42]))

;; `main` meets its callees as c, a, c, b (slots 3, 1, 3, 2), so building its row
;; shifts earlier entries right and drops the repeat. The row must read back
;; ascending, and next-child must step through it one callee at a time.
(define (opt-callgraph-unsorted-functions [symbols : OptCallgraphTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-test-function-symbol
        symbols.main
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 symbols.c Nil (I64))
          (ir.CompilerIrInstr.Call 1 symbols.a Nil (I64))
          (ir.CompilerIrInstr.Call 2 symbols.c Nil (I64))
          (ir.CompilerIrInstr.Call 3 symbols.b Nil (I64))
          (irt.instr "return 0"))))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-test-function-symbol symbols.a (opt-callgraph-return-instrs)))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-test-function-symbol symbols.b (opt-callgraph-return-instrs)))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (opt-test-function-symbol
                    symbols.c
                    (opt-callgraph-return-instrs)))
                (& (ir.compiler-ir-function-seq-empty))))))))))

(define (compiler-optimize-callgraph-sorted-rows-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-callgraph-unsorted-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    [main : i64 (opt-callgraph-test-slot (& index) symbols.main)]
    [a : i64 (opt-callgraph-test-slot (& index) symbols.a)]
    [b : i64 (opt-callgraph-test-slot (& index) symbols.b)]
    [c : i64 (opt-callgraph-test-slot (& index) symbols.c)]
    [start : i64 (opt.opt-callgraph-row-start (& graph) main)]
    (cond
      [(not (and (< main a) (< a b) (< b c))) false]
      [(not (= (- (opt.opt-callgraph-row-end (& graph) main) start) 3)) false]
      [(not (= (opt.opt-callgraph-target (& graph) start) a)) false]
      [(not (= (opt.opt-callgraph-target (& graph) (+ start 1)) b)) false]
      [(not (= (opt.opt-callgraph-target (& graph) (+ start 2)) c)) false]
      [(not (= (opt.opt-scc-next-child (& graph) main -1) a)) false]
      [(not (= (opt.opt-scc-next-child (& graph) main a) b)) false]
      [(not (= (opt.opt-scc-next-child (& graph) main b) c)) false]
      [(not (= (opt.opt-scc-next-child (& graph) main c) -1)) false]
      [(not (opt.opt-callgraph-has-edge? (& graph) main b)) false]
      [(opt.opt-callgraph-has-edge? (& graph) main main) false]
      [(opt.opt-callgraph-has-edge? (& graph) a main) false]
      [else true])))

(define (compiler-optimize-callgraph-self-test) : i64
  (cond
    [(not (compiler-optimize-callgraph-acyclic-ok?)) 1]
    [(not (compiler-optimize-callgraph-recursive-ok?)) 2]
    [(not (compiler-optimize-callgraph-sorted-rows-ok?)) 3]
    [else 42]))

(define (opt-inline-frame-params) : ir.CompilerIrParamSeq
  (irt.params "left=%0:i64, right=%1:i64"))

(defstruct OptInlineFrameTestSymbols
  (main i64)
  (inline-add i64)
  (inline-mid i64)
  (inline-group-word i64))

(define (opt-inline-frame-test-symbols) : OptInlineFrameTestSymbols
  (OptInlineFrameTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "inline_add")
    (opt-test-symbol "inline_mid")
    (opt-test-symbol "inline_group_word")))

(define (opt-inline-frame-callee [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-add
    (opt-inline-frame-params)
    (I64)
    3
    (irt.blocks "entry:
         %2 = add %0, %1 : i64
         return %2")
    Ordinary))

(define (opt-inline-frame-caller [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 10 : i64")
          (irt.instr "%1 = mov 32 : i64")
          (ir.CompilerIrInstr.Call
            2
            symbols.inline-add
            (Two (Var 0) (Var 1))
            (I64))
          (irt.instr "return %2"))))
    Ordinary))

(define (opt-inline-frame-functions [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-frame-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-frame-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-known-indirect-caller [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 10 : i64")
          (irt.instr "%1 = mov 32 : i64")
          (ir.CompilerIrInstr.CallIndirect
            2
            (Function symbols.inline-add)
            (Two (Var 0) (Var 1))
            (I64))
          (irt.instr "return %2"))))
    Ordinary))

(define (opt-inline-known-indirect-functions
  [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-known-indirect-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-frame-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-pack-word-callee [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-group-word
    (opt-inline-frame-params)
    (I64)
    4
    (irt.blocks
      "entry:
         %2 = pack [%0, %1] : i64
         %3 = word %2, 1 : i64
         return %3")
    Ordinary))

;; The caller passes its args from vars 1/2 (NOT the callee's param ids 0/1)
;; and uses a spacer var 0, so a missing remap of the inlined Pack/Word
;; operands is observable: the cloned Pack must read vars 1/2 (the call
;; arguments), never the callee-local 0/1 (regression guard against cloning
;; Pack/Word through a catch-all without remapping).
(define (opt-inline-pack-word-caller [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 99 : i64")
          (irt.instr "%1 = mov 20 : i64")
          (irt.instr "%2 = mov 22 : i64")
          (ir.CompilerIrInstr.Call
            3
            symbols.inline-group-word
            (Two (Var 1) (Var 2))
            (I64))
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-pack-word-functions [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-pack-word-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-pack-word-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-level-functions [level : i64]) : ir.CompilerIrFunctionSeq
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    (opt-test-inline-program-functions
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt-inline-frame-functions symbols)
      level)))

(define (opt-inline-self-recursive) : ir.CompilerIrFunction
  (irt.func
    "function @self_inline() -> i64 vars 1 {
     entry:
       %0 = call self_inline() : i64
       return %0
     }"))

(define (opt-inline-large-callee-instrs [idx : i64]) : ir.CompilerIrInstrSeq
  (if (> idx (opt.opt-inline-max-body))
    (opt-test-instrs (ir.CompilerIrInstr.Return (Some (Var idx))))
    (opt-test-instrs-with-tail
      (opt-inline-large-callee-instrs (+ idx 1))
      (ir.CompilerIrInstr.BinOp
        (+ idx 1)
        (Add)
        (if (= idx 0)
          (I64 0)
          (Var idx))
        (I64 1)
        (I64)))))

(defstruct OptInlineBoundsTestSymbols
  (main i64)
  (too-large i64)
  (bounds-inline i64)
  (bounds-leaf-inline i64))

(define (opt-inline-bounds-test-symbols) : OptInlineBoundsTestSymbols
  (OptInlineBoundsTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "too_large_inline")
    (opt-test-symbol "bounds_inline")
    (opt-test-symbol "bounds_leaf_inline")))

(define (opt-inline-large-callee [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.too-large
    (ir.compiler-ir-param-seq-empty)
    (I64)
    (+ (opt.opt-inline-max-body) 2)
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-large-callee-instrs 0)))
    Ordinary))

(define (opt-inline-bounds-callee [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.bounds-inline
    (irt.params "idx=%0:i64, len=%1:i64")
    (I64)
    3
    (irt.blocks
      "entry:
         bounds_check %0, %1 message \"bounds_inline.ok\"
         return %0")
    Ordinary))

(define (opt-inline-call-one [dst : i64] [callee : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Call dst callee Nil (I64))
    (ir.CompilerIrInstr.Return (Some (Var dst)))))

(define (opt-inline-call-large [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-call-one 0 symbols.too-large)))
    Ordinary))

(define (opt-inline-call-bounds [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            2
            symbols.bounds-inline
            (Two (I64 0) (I64 4))
            (I64))
          (irt.instr "return %2"))))
    Ordinary))

(define (opt-inline-call-bounds-twice [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            2
            symbols.bounds-inline
            (Two (I64 0) (I64 4))
            (I64))
          (ir.CompilerIrInstr.Call
            3
            symbols.bounds-inline
            (Two (I64 1) (I64 4))
            (I64))
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-duplicate-bounds-label-function
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    0
    (irt.blocks
      "entry:
         bounds_check 0, 4 message \"dup.ok\"
         bounds_check 1, 4 message \"dup.ok\"
         return 0")
    Ordinary))

(define (opt-inline-large-functions [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-call-large symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-large-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-bounds-functions [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-call-bounds symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-bounds-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-bounds-twice-functions
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-call-bounds-twice symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-bounds-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-bounds-leaf-instrs [index : i64] [limit : i64]) : ir.CompilerIrInstrSeq
  (if (>= index limit)
    (opt-test-instrs (ir.CompilerIrInstr.Return (No)))
    (opt-test-instrs-with-tail
      (opt-inline-bounds-leaf-instrs (+ index 1) limit)
      (if (= index 0)
        (irt.instr "bounds_check %0, %1 message \"bounds_leaf.ok\"")
        (ir.CompilerIrInstr.Mov (+ index 1) (I64 index) (I64))))))

(define (opt-inline-bounds-leaf-callee
  [symbols : OptInlineBoundsTestSymbols]
  [body : i64]) : ir.CompilerIrFunction
  (Function
    symbols.bounds-leaf-inline
    (irt.params "idx=%0:i64, len=%1:i64")
    (Unit)
    (+ body 1)
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-bounds-leaf-instrs 0 body)))
    Ordinary))

(define (opt-inline-call-bounds-leaf [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 1 : i64")
          (irt.instr "%1 = mov 8 : i64")
          (ir.CompilerIrInstr.Call
            2
            symbols.bounds-leaf-inline
            (Two (Var 0) (Var 1))
            (Unit))
          (irt.instr "return 42"))))
    Ordinary))

(define (opt-inline-bounds-leaf-functions
  [symbols : OptInlineBoundsTestSymbols]
  [body : i64]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-call-bounds-leaf symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-bounds-leaf-callee symbols body))
        (& (ir.compiler-ir-function-seq-empty))))))

;; Two ordinary call sites with variable arguments: the callee is neither
;; absorbable (refcount 2) nor all-const-args, so opt-inline-bounds-inline-ok?
;; refuses it and admission has to come from the bounds-leaf path.
(define (opt-inline-call-bounds-leaf-twice
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 1 : i64")
          (irt.instr "%1 = mov 8 : i64")
          (ir.CompilerIrInstr.Call
            2
            symbols.bounds-leaf-inline
            (Two (Var 0) (Var 1))
            (Unit))
          (ir.CompilerIrInstr.Call
            3
            symbols.bounds-leaf-inline
            (Two (Var 1) (Var 0))
            (Unit))
          (irt.instr "return 42"))))
    Ordinary))

(define (opt-inline-bounds-leaf-twice-functions
  [symbols : OptInlineBoundsTestSymbols]
  [body : i64]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-call-bounds-leaf-twice symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-bounds-leaf-callee symbols body))
        (& (ir.compiler-ir-function-seq-empty))))))

;; Small has-bounds callee whose body carries a Call. The bounds-leaf
;; whitelist refuses calls, so this shape must keep its call boundary even
;; though its body is well inside the admitted size band.
(define (opt-inline-bounds-leaf-call-callee) : ir.CompilerIrFunction
  (irt.func
    "function @bounds_leaf_call_inline(idx=%0:i64, len=%1:i64) -> unit vars 4 {
       entry:
         bounds_check %0, %1 message \"bounds_leaf_call.ok\"
         %2 = call opaque_sink(%0) : i64
         return
       }"))

(define (opt-inline-call-bounds-leaf-call-twice
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (irt.blocks
      "entry:
         %0 = mov 1 : i64
         %1 = mov 8 : i64
         %2 = call bounds_leaf_call_inline(%0, %1) : unit
         %3 = call bounds_leaf_call_inline(%1, %0) : unit
         return 42")
    Ordinary))

(define (opt-inline-bounds-leaf-call-functions
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-call-bounds-leaf-call-twice symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-bounds-leaf-call-callee))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-bounds-leaf-char-symbol) : i64
  (opt-test-symbol "bounds_leaf_char_inline"))

(define (opt-inline-bounds-leaf-owned-symbol) : i64
  (opt-test-symbol "bounds_leaf_owned_inline"))

;; One bounds-leaf shape -- single block, bounds-checked, call-free, two body
;; instructions -- instantiated at two return types. Every other property the
;; admission path reads is held fixed, so an outcome difference between the two
;; instantiations isolates opt-inline-bounds-leaf-return-type?.
(define (opt-inline-bounds-leaf-typed-callee
  [name : i64]
  [ret : ast.AstType]
  [value : ir.CompilerIrValue]) : ir.CompilerIrFunction
  (Function
    name
    (irt.params "idx=%0:i64, len=%1:i64")
    (ast.ast-global-shared-view ret)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "bounds_check %0, %1 message \"bounds_leaf_typed.ok\"")
          (ir.CompilerIrInstr.Mov 2 value ret)
          (irt.instr "return %2"))))
    Ordinary))

;; Two ordinary call sites with variable arguments: two references make the
;; callee non-absorbable and no argument is constant, so the generic has-bounds
;; policy refuses it and admission can only come from the bounds-leaf path.
(define (opt-inline-call-bounds-leaf-typed-twice
  [symbols : OptInlineBoundsTestSymbols]
  [callee : i64]
  [ret : ast.AstType]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 1 : i64")
          (irt.instr "%1 = mov 8 : i64")
          (ir.CompilerIrInstr.Call
            2
            callee
            (Two (Var 0) (Var 1))
            (ast.ast-global-shared-view ret))
          (ir.CompilerIrInstr.Call 3 callee (Two (Var 1) (Var 0)) ret)
          (irt.instr "return 42"))))
    Ordinary))

(define (opt-inline-bounds-leaf-char-functions
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-inline-call-bounds-leaf-typed-twice
        symbols
        (opt-inline-bounds-leaf-char-symbol)
        (Char)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-bounds-leaf-typed-callee
            (opt-inline-bounds-leaf-char-symbol)
            (Char)
            (Char 'A')))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-bounds-leaf-owned-functions
  [symbols : OptInlineBoundsTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-inline-call-bounds-leaf-typed-twice
        symbols
        (opt-inline-bounds-leaf-owned-symbol)
        (String)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-bounds-leaf-typed-callee
            (opt-inline-bounds-leaf-owned-symbol)
            (String)
            (String "leaf")))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-band-symbol) : i64
  (opt-test-symbol "band_inline"))

;; A pure arithmetic chain of exactly `limit` body instructions over two
;; parameters, closed by a Return of the last one. Every instruction writes a
;; fresh variable at or above the parameter count, so the body clears
;; opt-inline-body-instr-ok?, and it carries neither a Call nor a BoundsCheck,
;; which keeps the bounds-leaf path and its 1..48 band out of the decision.
;; Admission then turns on opt-inline-max-body and the cost gate alone.
(define (opt-inline-band-instrs [index : i64] [limit : i64]) : ir.CompilerIrInstrSeq
  (if (>= index limit)
    (opt-test-instrs (ir.CompilerIrInstr.Return (Some (Var (+ limit 1)))))
    (opt-test-instrs-with-tail
      (opt-inline-band-instrs (+ index 1) limit)
      (ir.CompilerIrInstr.BinOp
        (+ index 2)
        (Add)
        (if (= index 0)
          (Var 0)
          (Var (+ index 1)))
        (if (= index 0)
          (Var 1)
          (I64 1))
        (I64)))))

(define (opt-inline-band-callee [body : i64]) : ir.CompilerIrFunction
  (Function
    (opt-inline-band-symbol)
    (irt.params "a=%0:i64, b=%1:i64")
    (I64)
    (+ body 2)
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-band-instrs 0 body)))
    Ordinary))

(define (opt-inline-band-args [const-args? : bool] [first : i64] [second : i64]) : ir.CompilerIrCallArgs
  (if const-args?
    (Two (I64 (+ first 3)) (I64 (+ second 5)))
    (Two (Var first) (Var second))))

;; Two ordinary call sites, so the callee is never absorbable and the cost
;; gate's 1000-point absorb bonus never fires. `const-args?` selects the only
;; other term that can move the price: literal arguments give the site two
;; constant arguments and 3 * 2 = 6 points of savings, Mov-materialised
;; variables give it none.
(define (opt-inline-band-caller [const-args? : bool]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "main")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 3 : i64")
          (irt.instr "%1 = mov 5 : i64")
          (ir.CompilerIrInstr.Call
            2
            (opt-inline-band-symbol)
            (opt-inline-band-args const-args? 0 1)
            (I64))
          (ir.CompilerIrInstr.Call
            3
            (opt-inline-band-symbol)
            (opt-inline-band-args const-args? 1 0)
            (I64))
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-band-functions [body : i64] [const-args? : bool]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-band-caller const-args?))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-band-callee body))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-multi-call-caller [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    6
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 10 : i64")
          (irt.instr "%1 = mov 20 : i64")
          (ir.CompilerIrInstr.Call
            2
            symbols.inline-add
            (Two (Var 0) (Var 1))
            (I64))
          (ir.CompilerIrInstr.Call
            3
            symbols.inline-add
            (Two (Var 1) (Var 2))
            (I64))
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-multi-call-functions [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-multi-call-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-frame-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-cascade-mid [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-mid
    (opt-inline-frame-params)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            2
            symbols.inline-add
            (Two (Var 0) (Var 1))
            (I64))
          (irt.instr "return %2"))))
    Ordinary))

(define (opt-inline-cascade-main [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 20 : i64")
          (irt.instr "%1 = mov 22 : i64")
          (ir.CompilerIrInstr.Call
            2
            symbols.inline-mid
            (Two (Var 0) (Var 1))
            (I64))
          (irt.instr "return %2"))))
    Ordinary))

(define (opt-inline-cascade-functions [symbols : OptInlineFrameTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-cascade-main symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-cascade-mid symbols))
        (&
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-frame-callee symbols))
            (& (ir.compiler-ir-function-seq-empty))))))))

(define (opt-inline-mutual-a) : ir.CompilerIrFunction
  (irt.func
    "function @inline_mut_a() -> i64 vars 1 {
     entry:
       %0 = call inline_mut_b() : i64
       return %0
     }"))

(define (opt-inline-mutual-b) : ir.CompilerIrFunction
  (irt.func
    "function @inline_mut_b() -> i64 vars 1 {
     entry:
       %0 = call inline_mut_a() : i64
       return %0
     }"))

(define (opt-inline-mutual-functions) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-mutual-a))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-mutual-b))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-devirt-dynamic-caller) : ir.CompilerIrFunction
  (irt.func
    "function @dynamic() -> i64 vars 3 {
     entry:
       %0 = mov 0 : i64
       %2 = call* %0(1) : i64
       return %2
     }"))

(define (opt-devirt-local-alias-caller [duplicate? : bool]) : ir.CompilerIrFunction
  (let
    [entry-tail : ir.CompilerIrInstrSeq
      (if duplicate?
        (irt.instrs "%0 = mov fn@local_alias_other : i64
           jump call")
        (irt.instrs "jump call"))]
    (Function
      (opt-test-symbol "local_alias_caller")
      (ir.compiler-ir-param-seq-empty)
      (I64)
      2
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks
          "call:
             %1 = call* %0() : i64
             return %1")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (opt-test-instrs-with-tail
            entry-tail
            (irt.instr "%0 = mov fn@local_alias_target : i64"))))
      Ordinary)))

(define (opt-devirt-reach-target) : ir.CompilerIrFunction
  (irt.func
    "function @kept_target() -> i64 vars 1 {
     entry:
       jump exit
     exit:
       return 7
     }"))

(define (opt-devirt-reach-main) : ir.CompilerIrFunction
  (irt.func
    "function @main() -> i64 vars 2 {
     entry:
       %1 = call* fn@kept_target() : i64
       return %1
     }"))

(define (opt-devirt-reach-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (opt-devirt-reach-main))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (opt-devirt-reach-target))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-test-function-named
                  "dead"
                  (opt-global-dce-return-instrs 9)))
              (& (ir.compiler-ir-function-seq-empty)))))))
    (ir.compiler-ir-extern-seq-empty)))

(define (opt-inline-count-binop-dst-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(BinOp d _ _ _ _)
          (if (= d dst)
            1
            0)]
        [_ 0])
      (opt-inline-count-binop-dst-from instrs (+ index 1) dst))))

(define (opt-inline-count-binop-dst
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]) : i64
  (opt-inline-count-binop-dst-from instrs 0 dst))

(define (opt-count-direct-call-name-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [name : String]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-direct-call-name-instr-seq-from
      slots
      (+ index 1)
      count
      (opt.compiler-opt-global-shared-view name)
      (+
        acc
        (match (array-ref slots index)
          [(Call _ call-name _ _)
            (if (string.eq (ir.compiler-ir-symbol-text call-name) name)
              1
              0)]
          [_ 0])))))

(define (opt-count-direct-call-name-instr-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [name : String]) : i64
  (opt-count-direct-call-name-instr-seq-from instrs.slots 0 instrs.len name 0))

(define (opt-count-direct-call-name-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [name : String]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-direct-call-name-instr-seq
              instrs
              (opt.compiler-opt-global-shared-view name))
            (opt-count-direct-call-name-blocks rest name))])]))

(define (opt-count-direct-call-name-function-seq
  [functions : (& functions ir.CompilerIrFunctionSeq)]
  [func-name : String]
  [call-name : String]) : i64
  (let
    [functions : ir.CompilerIrFunctionSeq
      (owned_view.compiler-owned-reference-shared-view functions)]
    (match (opt-function-seq-find functions func-name)
      [(Some func)
        (let
          [blocks (opt.opt-function-blocks func)]
          (opt-count-direct-call-name-blocks
            (ir.compiler-ir-block-list-view blocks)
            call-name))]
      [(No) (- 0 1)])))

(define (opt-count-indirect-call-instrs-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(or (CallIndirect _ _ _ _) (CallIndirectC _ _ _ _)) 1]
        [_ 0])
      (opt-count-indirect-call-instrs-from instrs (+ index 1)))))

(define (opt-count-indirect-call-instrs
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-indirect-call-instrs-from instrs 0))

(define (opt-count-indirect-call-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-indirect-call-instrs instrs)
            (opt-count-indirect-call-blocks rest))])]))

(define (opt-inline-mov-dst-src-from?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [src : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov d (Var s) _)
        (if (and (= d dst) (= s src))
          true
          (opt-inline-mov-dst-src-from? instrs (+ index 1) dst src))]
      [_ (opt-inline-mov-dst-src-from? instrs (+ index 1) dst src)])))

(define (opt-inline-mov-dst-src?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [src : i64]) : bool
  (opt-inline-mov-dst-src-from? instrs 0 dst src))

(define (opt-inline-function-instrs
  [functions : ir.CompilerIrFunctionSeq]
  [name : String]) : ir.CompilerIrInstrSeq
  (match (opt-function-seq-find functions name)
    [(Some func) (opt-function-first-instrs func)]
    [(No) (ir.compiler-ir-instr-seq-empty)]))

(define (opt-inline-function-frame
  [functions : ir.CompilerIrFunctionSeq]
  [name : String]) : i64
  (match (opt-function-seq-find functions name)
    [(Some func) (opt.opt-function-frame func)]
    [(No) (- 0 1)]))

(define (compiler-optimize-inline-level-gate-ok?) : bool
  (let
    [level0 : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs (opt-inline-level-functions 0) "main")]
    [level1 : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs (opt-inline-level-functions 1) "main")]
    [level2 : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs (opt-inline-level-functions 2) "main")]
    (and
      (= (opt-count-direct-call-name-instr-seq level0 "inline_add") 1)
      ;; Level 1 runs the call-free tiny-leaf pass, which admits the
      ;; inline_add fixture; only level 0 leaves the call in place.
      (= (opt-count-direct-call-name-instr-seq level1 "inline_add") 0)
      (= (opt-count-direct-call-name-instr-seq level2 "inline_add") 0))))

(define (compiler-optimize-inline-self-recursive-ok?) : bool
  (let
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-self-recursive))
        (& (ir.compiler-ir-function-seq-empty)))]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        functions
        2)]
    [instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "self_inline")]
    (= (opt-count-direct-call-name-instr-seq instrs "self_inline") 1)))

;; --- INL-11X: a converted leaf absorbs at an in-loop site of a converted caller
;;
;; `conv_leaf` and `conv_walk` are both self tail-recursive, so the program
;; stage's tailrec rewrite converts both before the inliner reads them. The
;; leaf is call-free with one reference and `conv_walk` calls it from what is
;; now its loop body, so INL-11X absorbs it; a second reference from
;; `conv_other` keeps it out of line at every site, and `loop_walk` -- the same
;; in-loop site in a caller that was never converted -- keeps its call too,
;; which is what leaves the never-taken-self-recursion fixtures standing.
(define (opt-inline-conv-params) : ir.CompilerIrParamSeq
  (irt.params "a=%0:i64, b=%1:i64"))

(define (opt-inline-conv-leaf) : ir.CompilerIrFunction
  (let
    [name : i64 (opt-test-symbol "conv_leaf")]
    (Function
      name
      (opt-inline-conv-params)
      (I64)
      5
      (irt.blocks
        "entry:
           %2 = eq %0, 0 : i64
           branch %2, done, body
         done:
           return %1
         body:
           %3 = sub %0, 1 : i64
           %4 = add %1, %3 : i64
           tailcall conv_leaf(%3, %4) : i64
           return %4")
      Ordinary)))

;; `conv_walk(i, acc)`: while i < 8, acc = conv_leaf(i, acc); i = i + 1.
(define (opt-inline-conv-walk) : ir.CompilerIrFunction
  (let
    [name : i64 (opt-test-symbol "conv_walk")]
    (Function
      name
      (opt-inline-conv-params)
      (I64)
      5
      (irt.blocks
        "entry:
           %2 = lt %0, 8 : i64
           branch %2, body, exit
         body:
           %3 = call conv_leaf(%0, %1) : i64
           %4 = add %0, 1 : i64
           tailcall conv_walk(%4, %3) : i64
           return %3
         exit:
           return %1")
      Ordinary)))

;; A second, straight-line reference to the leaf.
(define (opt-inline-conv-other) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "conv_other")
    (opt-inline-conv-params)
    (I64)
    3
    (irt.blocks
      "entry:
         %2 = call conv_leaf(%1, %0) : i64
         return %2")
    Ordinary))

;; `loop_walk(i, acc)`: the same loop as `conv_walk`, spelled as a CFG loop
;; rather than a self tail call, so the caller is not a converted function.
(define (opt-inline-loop-walk) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "loop_walk")
    (opt-inline-conv-params)
    (I64)
    7
    (irt.blocks
      "entry:
         jump header
       header:
         %2 = phi [%0, entry], [%5, body] : i64
         %3 = phi [%1, entry], [%6, body] : i64
         %4 = lt %2, 8 : i64
         branch %4, body, exit
       body:
         %6 = call conv_leaf(%2, %3) : i64
         %5 = add %2, 1 : i64
         jump header
       exit:
         return %3")
    Ordinary))

(define (opt-inline-convwalk-functions) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-conv-leaf))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-loop-walk))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-conv-functions [other? : bool]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-conv-leaf))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-conv-walk))
        (&
          (if other?
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-conv-other))
              (& (ir.compiler-ir-function-seq-empty)))
            (ir.compiler-ir-function-seq-empty)))))))

(define (compiler-optimize-inline-converted-leaf-self-test) : i64
  (let
    [absorbed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-conv-functions false)
        2)]
    [shared : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-conv-functions true)
        2)]
    [looped : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-convwalk-functions)
        2)]
    (cond
      ;; the single-reference leaf is absorbed into the converted caller's loop
      [(not
          (=
            (opt-count-direct-call-name-function-seq
              absorbed
              "conv_walk"
              "conv_leaf")
            0))
        1]
      ;; a second reference keeps the converted leaf behind its call
      [(not
          (=
            (opt-count-direct-call-name-function-seq
              shared
              "conv_walk"
              "conv_leaf")
            1))
        2]
      [(not
          (=
            (opt-count-direct-call-name-function-seq
              shared
              "conv_other"
              "conv_leaf")
            1))
        3]
      ;; an in-loop site of a caller that was never converted keeps its call
      [(not
          (=
            (opt-count-direct-call-name-function-seq
              looped
              "loop_walk"
              "conv_leaf")
            1))
        4]
      [else 42])))

(define (compiler-optimize-inline-large-callee-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-large-functions symbols)
        2)]
    [instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    (= (opt-count-direct-call-name-instr-seq instrs "too_large_inline") 1)))

;; --- two admitted multiblock candidates in one block --------------------------
;;
;; Both land. After a multiblock rewrite the suffix goes back through the same
;; scan, which makes the "never evict a banked inline" invariant the gate
;; comments assert structural; handing the suffix to the single-block walk
;; instead would let whichever admitted candidate came first claim the block and
;; evict every later one.
(define (opt-inline-mb2-branch-blocks
  [body : ir.CompilerIrInstrSeq]
  [value : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         branch %0, then, else")
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "then") body)
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "else")
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 value)))))))

(define (opt-inline-mb2-small-callee [name : i64] [value : i64]) : ir.CompilerIrFunction
  (Function
    name
    (opt-inline-branch-params)
    (I64)
    2
    (opt-inline-mb2-branch-blocks
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 1 (I64 value) (I64))
        (irt.instr "return %1"))
      value)
    Ordinary))

(define (opt-inline-mb2-big-instrs [idx : i64] [limit : i64]) : ir.CompilerIrInstrSeq
  (if (> idx limit)
    (opt-test-instrs (ir.CompilerIrInstr.Return (Some (Var idx))))
    (opt-test-instrs-with-tail
      (opt-inline-mb2-big-instrs (+ idx 1) limit)
      (ir.CompilerIrInstr.BinOp
        (+ idx 1)
        (Add)
        (if (= idx 0)
          (I64 0)
          (Var idx))
        (I64 1)
        (I64)))))

;; Same shape, far past every body budget: the second candidate is refused and
;; the scan has to stop cleanly on the block the first one already rewrote.
(define (opt-inline-mb2-big-limit) : i64
  200)

(define (opt-inline-mb2-big-callee [name : i64]) : ir.CompilerIrFunction
  (Function
    name
    (opt-inline-branch-params)
    (I64)
    (+ (opt-inline-mb2-big-limit) 3)
    (opt-inline-mb2-branch-blocks
      (opt-inline-mb2-big-instrs 0 (opt-inline-mb2-big-limit))
      5)
    Ordinary))

(define (opt-inline-mb2-caller [name : i64] [first : i64] [second : i64]) : ir.CompilerIrFunction
  (Function
    name
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 first (One (Bool true)) (I64))
          (ir.CompilerIrInstr.Call 1 second (One (Bool false)) (I64))
          (irt.instr "%2 = add %0, %1 : i64")
          (irt.instr "return %2"))))
    Ordinary))

(define (opt-inline-mb2-program
  [caller : ir.CompilerIrFunction]
  [first : ir.CompilerIrFunction]
  [second : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    (ir.compiler-ir-function-seq-prepend
      (& caller)
      (&
        (ir.compiler-ir-function-seq-prepend
          (& first)
          (&
            (ir.compiler-ir-function-seq-prepend
              (& second)
              (& (ir.compiler-ir-function-seq-empty)))))))
    2))

(define (opt-inline-mb2-extra-caller [name : i64] [callee : i64]) : ir.CompilerIrFunction
  (Function
    name
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 callee (One (Bool true)) (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-mb2-shared-program
  [caller : ir.CompilerIrFunction]
  [first : ir.CompilerIrFunction]
  [second : ir.CompilerIrFunction]
  [extra1 : ir.CompilerIrFunction]
  [extra2 : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    (ir.compiler-ir-function-seq-prepend
      (& caller)
      (&
        (ir.compiler-ir-function-seq-prepend
          (& first)
          (&
            (ir.compiler-ir-function-seq-prepend
              (& second)
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& extra1)
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (& extra2)
                      (& (ir.compiler-ir-function-seq-empty)))))))))))
    2))

(define (opt-inline-mb2-main-blocks
  [functions : ir.CompilerIrFunctionSeq]
  [name : String]) : ir.CompilerIrBlockList
  (match (opt-function-seq-find functions name)
    [(Some func) (opt.opt-function-blocks func)]
    [(No) (ir.compiler-ir-block-list-empty)]))

(define (opt-inline-mb2-main-verified?
  [functions : (& functions ir.CompilerIrFunctionSeq)]
  [name : String]) : bool
  (let
    [functions : ir.CompilerIrFunctionSeq
      (owned_view.compiler-owned-reference-shared-view functions)]
    (match (opt-function-seq-find functions name)
      [(Some func) (opt.opt-verify-ok? (& (opt.opt-verify-function (& func))))]
      [(No) false])))

(define (compiler-optimize-inline-two-multiblock-self-test) : i64
  (let
    [main-name : i64 (opt-test-symbol "mb2_main")]
    [a-name : i64 (opt-test-symbol "mb2_a")]
    [b-name : i64 (opt-test-symbol "mb2_b")]
    [big-name : i64 (opt-test-symbol "mb2_big")]
    [both : ir.CompilerIrFunctionSeq
      (opt-inline-mb2-program
        (opt-inline-mb2-caller main-name a-name b-name)
        (opt-inline-mb2-small-callee a-name 7)
        (opt-inline-mb2-small-callee b-name 11))]
    [both-blocks : ir.CompilerIrBlockList
      (opt-inline-mb2-main-blocks
        (ir.compiler-ir-global-shared-view both)
        "mb2_main")]
    ;; `mb2_big` is referenced three times, so no site can claim it by
    ;; absorption, and its body is far past what the duplicating clauses buy.
    [fuel : ir.CompilerIrFunctionSeq
      (opt-inline-mb2-shared-program
        (opt-inline-mb2-caller main-name a-name big-name)
        (opt-inline-mb2-small-callee a-name 7)
        (opt-inline-mb2-big-callee big-name)
        (opt-inline-mb2-extra-caller (opt-test-symbol "mb2_extra1") big-name)
        (opt-inline-mb2-extra-caller (opt-test-symbol "mb2_extra2") big-name))]
    [fuel-blocks : ir.CompilerIrBlockList
      (opt-inline-mb2-main-blocks
        (ir.compiler-ir-global-shared-view fuel)
        "mb2_main")]
    (cond
      ;; both admitted candidates land: neither call survives
      [(not
          (=
            (opt-count-direct-call-name-blocks
              (ir.compiler-ir-block-list-view both-blocks)
              "mb2_a")
            0))
        1]
      [(not
          (=
            (opt-count-direct-call-name-blocks
              (ir.compiler-ir-block-list-view both-blocks)
              "mb2_b")
            0))
        2]
      ;; entry + 3 cloned + cont, twice over: the second split carves the
      ;; continuation the first one opened
      [(not (= (ir.compiler-ir-block-list-count both-blocks) 9)) 3]
      [(not (opt-inline-mb2-main-verified? both "mb2_main")) 4]
      ;; the refused second candidate leaves the first one banked
      [(not
          (=
            (opt-count-direct-call-name-blocks
              (ir.compiler-ir-block-list-view fuel-blocks)
              "mb2_a")
            0))
        5]
      [(not
          (=
            (opt-count-direct-call-name-blocks
              (ir.compiler-ir-block-list-view fuel-blocks)
              "mb2_big")
            1))
        6]
      [(not (= (ir.compiler-ir-block-list-count fuel-blocks) 5)) 7]
      [(not (opt-inline-mb2-main-verified? fuel "mb2_main")) 8]
      [else 42])))

(define (compiler-optimize-inline-bounds-callee-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-functions symbols)
        2)]
    [instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    (and
      (= (opt-count-direct-call-name-instr-seq instrs "bounds_inline") 0)
      (= (opt-count-bounds-instrs instrs) 1)
      (> (ir.compiler-ir-instr-seq-count instrs) 0)
      (match (ir.compiler-ir-instr-seq-ref instrs 0)
        [(BoundsCheck (I64 index) (I64 length) label)
          (and
            (= index 0)
            (= length 4)
            (not (not (ir.compiler-ir-label-some? label)))
            (not (= label (ir.compiler-ir-label "bounds_inline.ok"))))]
        [_ false]))))

(define (compiler-optimize-inline-bounds-labels-distinct-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-twice-functions symbols)
        2)]
    [instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    (and
      (= (opt-count-direct-call-name-instr-seq instrs "bounds_inline") 0)
      (= (opt-count-bounds-instrs instrs) 2)
      (> (ir.compiler-ir-instr-seq-count instrs) 2)
      (match (ir.compiler-ir-instr-seq-ref instrs 0)
        [(BoundsCheck (I64 first-index) (I64 first-length) first-label)
          (match (ir.compiler-ir-instr-seq-ref instrs 2)
            [(BoundsCheck (I64 second-index) (I64 second-length) second-label)
              (and
                (= first-index 0)
                (= first-length 4)
                (= second-index 1)
                (= second-length 4)
                (not (not (ir.compiler-ir-label-some? first-label)))
                (not (not (ir.compiler-ir-label-some? second-label)))
                (not (= first-label second-label))
                (not (= first-label (ir.compiler-ir-label "bounds_inline.ok")))
                (not (= second-label (ir.compiler-ir-label "bounds_inline.ok"))))]
            [_ false])]
        [_ false]))))

(define (compiler-optimize-inline-bounds-label-guard-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-twice-functions symbols)
        2)]
    [duplicate : ir.CompilerIrFunction
      (opt-inline-duplicate-bounds-label-function symbols)]
    [fallback : ir.CompilerIrFunction
      (opt-inline-frame-caller (opt-inline-frame-test-symbols))]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (and
          (opt.opt-inline-structure-ok? (& (opt.opt-function-blocks main)))
          (not
            (opt.opt-inline-structure-ok?
              (& (opt.opt-function-blocks duplicate))))
          (let
            [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
            [a (opt-test-inline-revert-or-keep fallback duplicate)]
            (opt.opt-function-eq type-segment-bases a fallback)))]
      [(No) false])))

(define (compiler-optimize-inline-bounds-leaf-body-gate-ok?) : bool
  (let
    [accepted-symbols : OptInlineBoundsTestSymbols
      (opt-inline-bounds-test-symbols)]
    [rejected-symbols : OptInlineBoundsTestSymbols
      (opt-inline-bounds-test-symbols)]
    [accepted : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-functions
          accepted-symbols
          (opt.opt-inline-bounds-leaf-max-body))
        2)]
    [rejected : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-functions
          rejected-symbols
          (+ (opt.opt-inline-bounds-leaf-max-body) 1))
        2)]
    [accepted-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs accepted "main")]
    [rejected-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs rejected "main")]
    (and
      (=
        (opt-count-direct-call-name-instr-seq
          accepted-instrs
          "bounds_leaf_inline")
        0)
      (= (opt-count-bounds-instrs accepted-instrs) 1)
      (=
        (opt-count-direct-call-name-instr-seq
          rejected-instrs
          "bounds_leaf_inline")
        1))))

;; The small end of the bounds-leaf band. Both bodies here are at or below
;; opt-inline-max-body, so the generic single-block path sees them and
;; opt-inline-bounds-inline-ok? refuses them: two call sites make the callee
;; non-absorbable and the arguments are variables, not constants. Admission
;; therefore proves the bounds-leaf path covers 1..opt-inline-max-body. The
;; third program pins the whitelist: a
;; body-carrying Call keeps the call boundary at both sites.
(define (compiler-optimize-inline-small-bounds-leaf-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [minimal : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-twice-functions symbols 1)
        2)]
    [boundary : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-twice-functions
          symbols
          (opt.opt-inline-max-body))
        2)]
    [leaf-call : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-call-functions symbols)
        2)]
    [minimal-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs minimal "main")]
    [boundary-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs boundary "main")]
    [leaf-call-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs leaf-call "main")]
    (and
      (=
        (opt-count-direct-call-name-instr-seq
          minimal-instrs
          "bounds_leaf_inline")
        0)
      (= (opt-count-bounds-instrs minimal-instrs) 2)
      (=
        (opt-count-direct-call-name-instr-seq
          boundary-instrs
          "bounds_leaf_inline")
        0)
      (= (opt-count-bounds-instrs boundary-instrs) 2)
      (=
        (opt-count-direct-call-name-instr-seq
          leaf-call-instrs
          "bounds_leaf_call_inline")
        2)
      (=
        (opt-count-direct-call-name-instr-seq leaf-call-instrs "opaque_sink")
        0)
      (= (opt-count-bounds-instrs leaf-call-instrs) 0))))

;; The bounds-leaf return-type gate. Both programs run the same bounds-leaf body
;; from two ordinary call sites with variable arguments, so admission turns only
;; on the declared return type. `char` is a non-owning scalar that return-to-mov
;; cloning reproduces exactly, so both call boundaries disappear and both bounds
;; checks land in the caller. An owned `String` result keeps its call boundary,
;; because that boundary carries cleanup semantics the expansion does not
;; reproduce; refusal must also leave the callee's bounds check in the callee
;; rather than leak a copy into the caller.
(define (compiler-optimize-inline-bounds-leaf-char-return-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [char-program : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-char-functions symbols)
        2)]
    [owned-program : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-owned-functions symbols)
        2)]
    [char-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs char-program "main")]
    [owned-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs owned-program "main")]
    (and
      (opt.opt-inline-bounds-leaf-return-type? (& (Char)))
      (not (opt.opt-inline-bounds-leaf-return-type? (& (String))))
      (=
        (opt-count-direct-call-name-instr-seq
          char-instrs
          "bounds_leaf_char_inline")
        0)
      (= (opt-count-bounds-instrs char-instrs) 2)
      (=
        (opt-count-direct-call-name-instr-seq
          owned-instrs
          "bounds_leaf_owned_inline")
        2)
      (= (opt-count-bounds-instrs owned-instrs) 0))))

(define (opt-inline-band-residual-calls [body : i64] [const-args? : bool]) : i64
  (let
    [instrs
      (opt-inline-function-instrs
        (opt-test-inline-program-functions
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-inline-band-functions body const-args?)
          2)
        "main")]
    (opt-count-direct-call-name-instr-seq instrs "band_inline")))

;; The opt-inline-max-body boundary, pinned from all four sides. Every program
;; here runs one call-free, bounds-free, single-block pure callee from two
;; ordinary call sites, so the callee is non-absorbable and no other admission
;; path can reach it: what is left is the shape cap and the cost gate, which
;; both read the same instruction count.
;;
;; The single-block path adds no blocks, so the cost gate reduces to
;; net = body - min(body, 3 * const-args) - 6 admitted at net <= 4:
;;   body 10, no constant arguments -- net = 4, admitted. This is the shape the
;;     old cap of 8 refused at every call site even though the cost model had
;;     already priced it as a win.
;;   body 12, two constant arguments per site -- savings min(12, 6) = 6 and
;;     net = 0, admitted right at the cap.
;;   body 12, no constant arguments -- net = 6, refused. Lifting the cap does
;;     not hand the decision to the cap; the price still has to clear.
;;   body 13, two constant arguments per site -- net = 1, which the cost gate
;;     would take. The cap refuses it anyway, which is the whole reason the cap
;;     exists above the priced ceiling of 10: const-savings saturates at the
;;     body size, so past that point the cost formula stops bounding growth.
(define (compiler-optimize-inline-band-boundary-ok?) : bool
  (and
    (= (opt-inline-band-residual-calls 10 false) 0)
    (= (opt-inline-band-residual-calls 12 true) 0)
    (= (opt-inline-band-residual-calls 12 false) 2)
    (= (opt-inline-band-residual-calls 13 true) 2)))

(define (compiler-optimize-inline-multi-call-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-multi-call-functions symbols)
        2)]
    [instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs
        (opt.compiler-opt-global-shared-view optimized)
        "main")]
    [frame : i64 (opt-inline-function-frame optimized "main")]
    (cond
      [(not (= frame 8)) false]
      [(not (= (ir.compiler-ir-instr-seq-count instrs) 7)) false]
      [(not (= (opt-count-direct-call-name-instr-seq instrs "inline_add") 0))
        false]
      [(not (= (opt-inline-count-binop-dst instrs 6) 1)) false]
      [(not (= (opt-inline-count-binop-dst instrs 7) 1)) false]
      [(not (opt-inline-mov-dst-src? instrs 2 6)) false]
      [(not (opt-inline-mov-dst-src? instrs 3 7)) false]
      [else true])))

(define (compiler-optimize-inline-bottom-up-writeback-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-cascade-functions symbols)
        2)]
    [main-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs
        (opt.compiler-opt-global-shared-view optimized)
        "main")]
    [mid-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "inline_mid")]
    (and
      (= (opt-count-direct-call-name-instr-seq main-instrs "inline_mid") 0)
      (= (opt-count-direct-call-name-instr-seq main-instrs "inline_add") 0)
      (= (opt-inline-count-binop-dst main-instrs 4) 1)
      (= (opt-count-direct-call-name-instr-seq mid-instrs "inline_add") 0)
      (= (opt-inline-count-binop-dst mid-instrs 3) 1))))

(define (compiler-optimize-inline-mutual-scc-refusal-ok?) : bool
  (let
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-mutual-functions)
        2)]
    [a-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs
        (opt.compiler-opt-global-shared-view optimized)
        "inline_mut_a")]
    [b-instrs : ir.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "inline_mut_b")]
    (and
      (= (opt-count-direct-call-name-instr-seq a-instrs "inline_mut_b") 1)
      (= (opt-count-direct-call-name-instr-seq a-instrs "inline_mut_a") 0)
      (= (opt-count-direct-call-name-instr-seq b-instrs "inline_mut_a") 1)
      (= (opt-count-direct-call-name-instr-seq b-instrs "inline_mut_b") 0))))

(define (opt-inline-pack-words-are-vars-1-2? [words : ir.CompilerIrValueSeq]) : bool
  (if (= words.len 2)
    (match (ir.compiler-ir-value-seq-ref words 0)
      [(Var av)
        (match (ir.compiler-ir-value-seq-ref words 1)
          [(Var bv) (and (= av 1) (= bv 2))]
          [_ false])]
      [_ false])
    false))

;; True when the inlined body contains a Pack reading the CALLER's argument
;; vars (1/2, remapped from the callee's params 0/1) and a Word whose source
;; is that Pack's (rebased) destination.
(define (opt-inline-pack-word-remap-ok-scan-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [pack-dst : i64]
  [pack-ok : bool]
  [word-ok : bool]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (and pack-ok word-ok)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Pack dst words _)
        (opt-inline-pack-word-remap-ok-scan-from
          instrs
          (+ index 1)
          dst
          (opt-inline-pack-words-are-vars-1-2? words)
          word-ok)]
      [(Word _ src _ _)
        (opt-inline-pack-word-remap-ok-scan-from
          instrs
          (+ index 1)
          pack-dst
          pack-ok
          (match src
            [(Var sv) (= sv pack-dst)]
            [_ false]))]
      [_
        (opt-inline-pack-word-remap-ok-scan-from
          instrs
          (+ index 1)
          pack-dst
          pack-ok
          word-ok)])))

(define (opt-inline-pack-word-remap-ok-scan
  [instrs : ir.CompilerIrInstrSeq]
  [pack-dst : i64]
  [pack-ok : bool]
  [word-ok : bool]) : bool
  (opt-inline-pack-word-remap-ok-scan-from instrs 0 pack-dst pack-ok word-ok))

(define (compiler-optimize-inline-pack-word-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-pack-word-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (and
          (=
            (let
              [instrs (opt-function-first-instrs main)]
              (opt-count-direct-call-name-instr-seq instrs "inline_group_word"))
            0)
          (opt-inline-pack-word-remap-ok-scan
            (opt-function-first-instrs main)
            (- 0 1)
            false
            false))]
      [(No) false])))

(define (opt-inline-branch-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool"))

(define (opt-inline-branch-callee-mov) : ir.CompilerIrInstr
  (Mov 1 (I64 7) (I64)))

(defstruct OptInlineMultiTestSymbols
  (main i64)
  (inline-branch i64)
  (inline-tiny-predicate i64)
  (inline-loop i64)
  (mb-bounds i64)
  (inline-switch i64)
  (inline-switch-costly i64)
  (inline-mut-param-loop i64)
  (inline-nonleaf i64)
  (external-helper i64)
  (inline-tiny-nonleaf-predicate i64)
  (external-predicate i64))

(define (opt-inline-multi-test-symbols) : OptInlineMultiTestSymbols
  (OptInlineMultiTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "inline_branch")
    (opt-test-symbol "inline_tiny_predicate")
    (opt-test-symbol "inline_loop")
    (opt-test-symbol "mb_bounds")
    (opt-test-symbol "inline_switch")
    (opt-test-symbol "inline_switch_costly")
    (opt-test-symbol "inline_mut_param_loop")
    (opt-test-symbol "inline_nonleaf")
    (opt-test-symbol "external_helper")
    (opt-test-symbol "inline_tiny_nonleaf_predicate")
    (opt-test-symbol "external_predicate")))

(define (opt-inline-branch-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-branch
    (opt-inline-branch-params)
    (I64)
    2
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "else:
             return 42")
      (irt.block "entry:
           branch %0, then, else")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "then")
        (opt-test-instrs (opt-inline-branch-callee-mov) (irt.instr "return %1"))))
    Ordinary))

(define (opt-inline-branch-caller-call [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrInstr
  (Call 0 symbols.inline-branch (One (Bool true)) (I64)))

(define (opt-inline-branch-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-branch-caller-call symbols)
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-branch-functions [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-branch-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-branch-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-repeated-predicate-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-tiny-predicate
    (irt.params "value=%0:i64")
    (Bool)
    2
    (irt.blocks
      "entry:
         %1 = lt %0, 10 : bool
         branch %1, yes, no
       yes:
         return true
       no:
         return false")
    Ordinary))

(define (opt-inline-repeated-predicate-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (Bool)
    2
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "done:
             return false")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            0
            symbols.inline-tiny-predicate
            (One (I64 7))
            (Bool))
          (irt.instr "branch %0, second, done")))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "second")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            1
            symbols.inline-tiny-predicate
            (One (I64 12))
            (Bool))
          (irt.instr "return %1"))))
    Ordinary))

(define (opt-inline-repeated-predicate-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-repeated-predicate-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-repeated-predicate-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-optimize-inline-repeated-tiny-predicate-ok?) : bool
  (let
    [level0-symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [level1-symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [level2-symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [level0 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-predicate-functions level0-symbols)
        0)]
    [level1 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-predicate-functions level1-symbols)
        1)]
    [level2 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-predicate-functions level2-symbols)
        2)]
    (match (opt-function-seq-find level2 "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-function-seq
                level0
                "main"
                "inline_tiny_predicate")
              2)
            (=
              (opt-count-direct-call-name-function-seq
                level1
                "main"
                "inline_tiny_predicate")
              2)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_tiny_predicate")
              0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (compiler-optimize-inline-multiblock-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-branch-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_branch")
              0)
            (= (ir.compiler-ir-block-list-count blocks) 5)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
            (= (opt.opt-function-frame main) 2)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (opt-inline-loop-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-loop
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (irt.blocks
      "entry:
         jump loop
       loop:
         branch true, loop, exit
       exit:
         return 1")
    Ordinary))

(define (opt-inline-loop-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 symbols.inline-loop Nil (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-loop-functions [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-loop-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-loop-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-optimize-inline-multiblock-acyclic-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-loop-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_loop")
              0)
            (= (ir.compiler-ir-block-list-count blocks) 5)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; Multiblock bounds-carrying absorbable callee: with BoundsCheck admitted to
;; the multiblock instruction set, a single-call-site helper whose body
;; contains a check must inline (the absorb bonus), with its ok-label
;; freshened by the site prefix so the caller's labels stay unique.
(define (opt-inline-mb-bounds-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.mb-bounds
    (irt.params "idx=%0:i64, len=%1:i64")
    (I64)
    3
    (irt.blocks
      "entry:
         bounds_check %0, %1 message \"mb_ok\"
         branch true, then, else
       then:
         return %0
       else:
         return 0")
    Ordinary))

(define (opt-inline-mb-bounds-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (irt.params "a=%0:i64, b=%1:i64")
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            2
            symbols.mb-bounds
            (Two (Var 0) (Var 1))
            (I64))
          (irt.instr "return %2"))))
    Ordinary))

(define (compiler-optimize-inline-multiblock-bounds-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-mb-bounds-caller symbols))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-mb-bounds-callee symbols))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "mb_bounds")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (opt-inline-switch-params) : ir.CompilerIrParamSeq
  (irt.params "tag=%0:i64, idx=%1:i64, len=%2:i64"))

(define (opt-inline-switch-loop-phi-instr) : ir.CompilerIrInstr
  (irt.instr "%3 = phi [10, zero], [20, one] : i64"))

;; A cyclic bounds-carrying Switch callee remains behind the acyclic gate even
;; when absorbable, unless its exact IR-symbol leaf is the `vm-run`
;; exception.
(define (opt-inline-switch-callee-named [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-switch-params)
    (I64)
    4
    (ir.compiler-ir-blocks
      (irt.block "entry:
           jump loop")
      (irt.block
        "loop:
             bounds_check %1, %2 message \"switch_bounds_ok\"
             switch %0 base 0 [0:zero, 1:one] default loop")
      (irt.block "zero:
               jump join")
      (irt.block "one:
                 jump join")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "join")
        (opt-test-instrs
          (opt-inline-switch-loop-phi-instr)
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-switch-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (opt-inline-switch-callee-named symbols.inline-switch))

;; The acyclic counterpart exercises Switch admission and label remapping. Its
;; join phi makes stale, unprefixed case/default predecessor labels observable.
(define (opt-inline-acyclic-switch-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-switch
    (opt-inline-switch-params)
    (I64)
    4
    (irt.blocks
      "entry:
         bounds_check %1, %2 message \"switch_bounds_ok\"
         switch %0 base 0 [0:zero, 1:one] default other
       zero:
         jump join
       one:
         jump join
       other:
         jump join
       join:
         %3 = phi [10, zero], [20, one], [30, other] : i64
         return %3")
    Ordinary))

(define (opt-inline-switch-caller-call-named [callee-name : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    ;; Swap the first two arguments so the Switch scrutinee and BoundsCheck
    ;; index must both be remapped rather than retaining their callee ids.
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Call 3 callee-name (Array args) (I64))))

(define (opt-inline-switch-caller-named
  [symbols : OptInlineMultiTestSymbols]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (opt-inline-switch-params)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-switch-caller-call-named callee-name)
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-switch-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (opt-inline-switch-caller-named symbols symbols.inline-switch))

(define (opt-inline-cloned-switch-terminator-ok?
  [blocks : (& blocks ir.CompilerIrBlockList)]) : bool
  (match (opt.opt-cfg-find-block
    blocks
    (ir.compiler-ir-label "inl.entry.0.entry"))
    [(No) false]
    [(Some block)
      (match block
        [(Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 2)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(BoundsCheck _ _ ok-label)
                (and
                  (=
                    ok-label
                    (ir.compiler-ir-label "inl.entry.0.switch_bounds_ok"))
                  (match (ir.compiler-ir-instr-seq-ref instrs 1)
                    [(Switch value tag-base cases default-label)
                      (let
                        [case-labels : opt.OptLabelSet
                          (opt.opt-cfg-switch-case-successors Nil (& cases))]
                        (and
                          (match value
                            [(Var id) (= id 1)]
                            [_ false])
                          (= tag-base 0)
                          (= (opt.opt-label-count case-labels) 2)
                          (opt.opt-label-contains
                            case-labels
                            (ir.compiler-ir-label "inl.entry.0.zero"))
                          (opt.opt-label-contains
                            case-labels
                            (ir.compiler-ir-label "inl.entry.0.one"))
                          (=
                            default-label
                            (ir.compiler-ir-label "inl.entry.0.other"))))]
                    [_ false]))]
              [_ false])
            false)])]))

(define (opt-inline-cloned-switch-phi-ok?
  [blocks : (& blocks ir.CompilerIrBlockList)]) : bool
  (match (opt.opt-cfg-find-block
    blocks
    (ir.compiler-ir-label "inl.entry.0.join"))
    [(No) false]
    [(Some block)
      (match block
        [(Block _ instrs)
          (if (> (ir.compiler-ir-instr-seq-count instrs) 0)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(Phi _ inputs _)
                (and
                  (= (ir.compiler-ir-phi-input-seq-count inputs) 3)
                  (opt.opt-inline-phi-input-label?
                    (opt.compiler-opt-global-shared-view inputs)
                    (ir.compiler-ir-label "inl.entry.0.zero"))
                  (opt.opt-inline-phi-input-label?
                    (opt.compiler-opt-global-shared-view inputs)
                    (ir.compiler-ir-label "inl.entry.0.one"))
                  (opt.opt-inline-phi-input-label?
                    inputs
                    (ir.compiler-ir-label "inl.entry.0.other")))]
              [_ false])
            false)])]))

(define (compiler-optimize-inline-multiblock-switch-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-switch-caller symbols))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-acyclic-switch-callee symbols))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt-inline-cloned-switch-terminator-ok? blocks)
            (opt-inline-cloned-switch-phi-ok? blocks)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; The cyclic bounds+switch callee at its single site in a loop-free caller
;; stays behind the acyclic admission gate, but the hot-loop-leaf band takes it
;; from one reference up (see its reference clause), and this shape is exactly
;; what its loop-free site tier is for: the imported loop becomes the caller's
;; only loop, so there is no caller loop whose allocation the second working set
;; could tax. What the assertion pins is that the clone is a CORRECT one -- the
;; boundary is retired, the callee's bounds check comes along rather than being
;; dropped, and the cloned CFG verifies.
(define (compiler-optimize-inline-multiblock-cyclic-bounds-switch-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-switch-caller symbols))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-switch-callee symbols))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (opt-inline-switch-functions-named
  [symbols : OptInlineMultiTestSymbols]
  [callee-name : i64]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-switch-caller-named symbols callee-name))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-switch-callee-named callee-name))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-switch-case-result-ok?
  [functions : ir.CompilerIrFunctionSeq]
  [callee-text : String]
  [expected-calls : i64]
  [expected-bounds : i64]) : bool
  (match (opt-function-seq-find functions "main")
    [(Some main)
      (let
        [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
        (and
          (=
            (opt-count-direct-call-name-blocks
              (ir.compiler-ir-block-list-view blocks)
              callee-text)
            expected-calls)
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view blocks))
            expected-bounds)
          (opt.opt-inline-structure-ok? (& blocks))))]
    [(No) false]))

(define (compiler-optimize-inline-vm-run-bounds-loop-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [vm-text : String "bench.tl::vm-run"]
    [other-text : String "bench.tl::qs-partition"]
    [vm-name : i64
      (opt-test-symbol (opt.compiler-opt-global-shared-view vm-text))]
    [other-name : i64
      (opt-test-symbol (opt.compiler-opt-global-shared-view other-text))]
    [vm-opt2 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-switch-functions-named symbols vm-name)
        2)]
    [other-opt2 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-switch-functions-named symbols other-name)
        2)]
    [vm-opt1 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-switch-functions-named symbols vm-name)
        1)]
    (and
      (opt-inline-switch-case-result-ok?
        vm-opt2
        (opt.compiler-opt-global-shared-view vm-text)
        0
        1)
      ;; `qs-partition` is not a `vm-run` leaf, so the name-matching exception
      ;; above does not admit it. It escapes the acyclic gate on its SHAPE --
      ;; one reference, call-free, cyclic, in a loop-free caller is the
      ;; hot-loop-leaf band's loop-free tier, which needs no name. The exception
      ;; is not dead: it still admits a `vm-run` leaf the band refuses on size
      ;; or on caller shape, which is why it stays.
      (opt-inline-switch-case-result-ok? other-opt2 other-text 0 1)
      ;; opt1 still refuses BOTH: below opt2 the multiblock inliner does not run
      ;; at all, so the widened band cannot reach this shape there.
      (opt-inline-switch-case-result-ok? vm-opt1 vm-text 1 0))))

;; --- loop-bearing bounds callee admission (in-loop site + cascade) ----------
;;
;; The callee under test is the cyclic bounds-carrying Switch leaf above, which
;; the shared gate refuses everywhere except at an in-loop site. Only the
;; CALLER varies across these fixtures, so each test isolates exactly one
;; clause of opt-inline-bounds-loop-absorb-ok?.
;; The site call with `idx-var` in the callee's `idx` position instead of %1.
(define (opt-inline-loop-site-call-idx
  [callee-name : i64]
  [dst : i64]
  [idx-var : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var idx-var))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Call dst callee-name (Array args) (I64))))

(define (opt-inline-loop-site-call [callee-name : i64] [dst : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Call dst callee-name (Array args) (I64))))

;; entry -> header -> {body -> latch -> header, exit}. The call sits in `body`,
;; a member of the natural loop headed by `header`. The back edge leaves from
;; `latch` rather than from `body` so the call block is not a phi predecessor:
;; that suppression of the absorb bonus is a separate rule (#5193), and mixing
;; it in would stop this fixture from testing the site condition it exists to
;; test.
(define (opt-inline-loop-site-caller-blocks
  [callee-name : i64]
  [entry-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "latch:
             jump header
           exit:
             return %4")
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") entry-instrs)
    (irt.block
      "header:
           %4 = phi [%3, entry], [%5, latch] : i64
           branch %0, body, exit")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs
        (opt-inline-loop-site-call callee-name 5)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch"))))))

(define (opt-inline-loop-site-entry-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%3 = mov 0 : i64
     jump header"))

;; Same entry, plus a bounds check the caller already owns. Used to flip the
;; cascade clause without touching anything else.
(define (opt-inline-loop-site-bounds-entry-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-inline-loop-site-entry-instrs)
    (irt.instr "bounds_check %1, %2 message \"caller_bounds_ok\"")))

(define (opt-inline-loop-site-function
  [func-name : i64]
  [callee-name : i64]
  [entry-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (opt-inline-loop-site-caller-blocks callee-name entry-instrs)
    Ordinary))

;; `main` calls the leaf from inside a loop: the boundary is repaid per
;; iteration, so the gate admits it.
(define (compiler-optimize-inline-bounds-loop-in-loop-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-loop-site-function
              symbols.main
              callee-name
              (opt-inline-loop-site-entry-instrs)))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-switch-callee-named callee-name))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; Retiring a boundary which runs once cannot pay for the caller's allocation,
;; but that matters only for a caller with allocation to lose -- and this
;; caller is loop-free, the case the hot-loop-leaf band's third site tier exists
;; for (gvn-facts-slot's five straight-line sites): with no caller loop, the
;; imported loop becomes the only one and there is no allocation to tax. The
;; band's reference clause begins at one reference, so it reaches this site.
(define (compiler-optimize-inline-bounds-loop-cold-site-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-switch-caller-named symbols callee-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-switch-callee-named callee-name))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; `mid` is single-reference and carries no bounds checks, so the cascade
;; clause is live for every leaf it imports. The leaf here CALLS OUT, and that
;; is what keeps the clause the only thing separating the two programs below:
;; the single-site band's clause 2 now takes a narrow leaf at an in-loop site,
;; but only a call-free one, so a call-bearing leaf still reaches this tier and
;; only this tier. The call-free counterpart of exactly this program is
;; compiler-optimize-inline-single-site-narrow-loop-site-absorb-ok?, where the
;; body moves; between them the two fixtures isolate call-freedom.
(define (opt-inline-cascade-program
  [symbols : OptInlineMultiTestSymbols]
  [mid-entry : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunctionSeq
  (let
    [mid-name : i64 symbols.inline-nonleaf]
    [leaf-name : i64 symbols.inline-switch]
    (ir.compiler-ir-function-seq-prepend
      (& (opt-inline-switch-caller-named symbols mid-name))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-loop-site-function mid-name leaf-name mid-entry))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-dup-leaf-calling leaf-name symbols.external-helper))
              (& (ir.compiler-ir-function-seq-empty)))))))))

;; `mid` is single-reference and carries no bounds checks, so it is inlined at
;; its own call site for free. Importing the bounds-carrying loop leaf would
;; hand it its first bounds check and cost it that inline, so the import is
;; refused even though the site is in a loop.
(define (compiler-optimize-inline-bounds-loop-cascade-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [refused : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-cascade-program symbols (opt-inline-loop-site-entry-instrs))
        2)]
    [admitted : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-cascade-program
          symbols
          (opt-inline-loop-site-bounds-entry-instrs))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          refused
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          admitted
          "inline_nonleaf"
          "inline_switch")
        0))))

;; --- duplicating a two-reference leaf into its in-loop sites ----------------
;;
;; The leaf under test is the cyclic bounds-carrying Switch leaf again, built
;; here in two versions that differ in exactly one instruction: whether the
;; `zero` case makes a call. Everything else across these fixtures varies only
;; in the CALLERS, so each test isolates one clause of
;; opt-inline-dup-absorb-ok?.
(define (opt-inline-dup-leaf-named
  [callee-name : i64]
  [vars : i64]
  [zero-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-switch-params)
    (I64)
    vars
    (ir.compiler-ir-blocks
      (irt.block "entry:
           jump loop")
      (irt.block
        "loop:
             bounds_check %1, %2 message \"switch_bounds_ok\"
             switch %0 base 0 [0:zero, 1:one] default loop")
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "zero") zero-instrs)
      (irt.block "one:
                 jump join")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "join")
        (opt-test-instrs
          (opt-inline-switch-loop-phi-instr)
          (irt.instr "return %3"))))
    Ordinary))

(define (opt-inline-dup-leaf-jump-zero-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "join"))))

;; The same case block, plus one call to a helper the program does not define,
;; so nothing can inline it away before the leaf itself is offered.
(define (opt-inline-dup-leaf-call-zero-instrs [helper-name : i64]) : ir.CompilerIrInstrSeq
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 1)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (opt-test-instrs-with-tail
      (opt-inline-dup-leaf-jump-zero-instrs)
      (ir.CompilerIrInstr.Call 4 helper-name (Array args) (I64)))))

(define (opt-inline-dup-leaf-plain [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    4
    (opt-inline-dup-leaf-jump-zero-instrs)))

(define (opt-inline-dup-leaf-calling [callee-name : i64] [helper-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    5
    (opt-inline-dup-leaf-call-zero-instrs helper-name)))

(define (opt-inline-dup-caller-chain
  [names : (__tl_dyn-array i64)]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-inline-dup-caller-chain-from (& names) 0 callee-name tail))

(define (opt-inline-dup-caller-chain-from
  [names : (& names (__tl_dyn-array i64))]
  [at : i64]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (if (>= at (array-length names))
    tail
    (let
      [name : i64 (array-ref names at)]
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-loop-site-function
            name
            callee-name
            (opt-inline-loop-site-entry-instrs)))
        (& (opt-inline-dup-caller-chain-from names (+ at 1) callee-name tail))))))

(define (opt-inline-dup-two-caller-names [symbols : OptInlineMultiTestSymbols]) : (__tl_dyn-array
    i64)
  (let
    [names : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    (set! (array-ref names 0) symbols.main)
    (set! (array-ref names 1) symbols.inline-nonleaf)
    names))

(define (opt-inline-dup-three-caller-names
  [symbols : OptInlineMultiTestSymbols]) : (__tl_dyn-array i64)
  (let
    [first : i64 symbols.inline-loop]
    [second : i64 symbols.main]
    [third : i64 symbols.inline-nonleaf]
    (__tl_make-array first second third)))

(define (opt-inline-dup-optimized
  [callers : (__tl_dyn-array i64)]
  [callee-name : i64]
  [leaf : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-inline-dup-caller-chain
      callers
      callee-name
      (ir.compiler-ir-function-seq-prepend
        (& leaf)
        (& (ir.compiler-ir-function-seq-empty))))
    2))

;; Two in-loop callers duplicate the leaf into both. The three-reference shape
;; is covered by the hot-loop-leaf tests below, and since that band's reference
;; clause begins at one reference it would take this two-reference leaf as
;; well: both bands admit it and the duplicating one, being cheaper, is asked
;; first. What this test pins holds either way -- the leaf reaches both
;; in-loop sites.
(define (compiler-optimize-inline-dup-two-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [two : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-plain callee-name))]
    (and
      (= (opt-count-direct-call-name-function-seq two "main" "inline_switch") 0)
      (=
        (opt-count-direct-call-name-function-seq
          two
          "inline_nonleaf"
          "inline_switch")
        0))))

;; The identical two-reference leaf, at two in-loop sites, one of whose callers
;; is itself a single-reference bounds-free function: that caller would lose its
;; own inline by taking the leaf's bounds check, so the cascade clause refuses
;; the copy THERE and admits it at the other site. One caller taking the body
;; does not commit the other.
;;
;; This is also the CASCADE pin for the hot-loop-leaf band. That band carries
;; its own copy of the cascade clause, and since its reference clause was
;; widened to one reference it now reaches this two-reference leaf too -- so the
;; refused site stays refused only while BOTH bands keep asking. Drop the clause
;; from either one and the assertion below starts finding zero calls.
(define (compiler-optimize-inline-dup-cascade-per-caller-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [mid-name : i64 symbols.inline-nonleaf]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-switch-caller-named symbols mid-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-loop-site-function
                  mid-name
                  callee-name
                  (opt-inline-loop-site-entry-instrs)))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-inline-loop-site-function
                      symbols.inline-loop
                      callee-name
                      (opt-inline-loop-site-entry-instrs)))
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (& (opt-inline-dup-leaf-plain callee-name))
                      (& (ir.compiler-ir-function-seq-empty)))))))))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        0))))

;; The same two-reference leaf with one call in its body stays out of line at
;; both sites. The clone path handles calls -- the measured tier clones
;; call-carrying bodies and this file pins that -- but this band's model prices
;; a body by counting it, and a callee's own calls cost the caller its leaf
;; frame and every value live across them. See opt-inline-blocks-call-free?.
;; --- the measured-plan inline check -----------------------------------------
;;
;; The tier itself (compiler_optimize.tl, opt-inline-checked-*) admits one site
;; per caller from the class every band refuses, rebuilds the caller both ways,
;; prices both plans, and keeps the inline only when the measured plan agrees
;; with what a free inline would predict. These pin the pieces that decide that:
;; the depth model both sides are priced in, the accept window, the program
;; budget that bounds the tier's compile-time cost, and the two structural
;; guarantees -- a caller with no candidate pays nothing, and whichever side of
;; the rollback is kept verifies.
;; A two-block function: an entry that jumps into a self-loop. The loop block
;; carries `loop-instrs` instructions, the entry carries one.
(define (opt-inline-checked-depth-fixture [name : i64] [loop-instrs : i64]) : ir.CompilerIrFunction
  (Function
    name
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (irt.block "entry:
           jump loop")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-inline-checked-depth-loop-instrs loop-instrs)))
    Ordinary))

(define (opt-inline-checked-depth-loop-instrs [remaining : i64]) : ir.CompilerIrInstrSeq
  (if (<= remaining 1)
    (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop")))
    (opt-test-instrs-with-tail
      (opt-inline-checked-depth-loop-instrs (- remaining 1))
      (ir.CompilerIrInstr.Mov 0 (I64 1) (I64)))))

;; The currency both sides of the check are priced in. A block inside one loop
;; weighs opt-inline-census-depth-base; `offset` is the depth the body would
;; land at in its caller, and the ladder SATURATES at
;; opt-inline-census-depth-cap, which is the whole reason the callee is priced
;; through an offset instead of by multiplying two weights.
(define (compiler-optimize-inline-checked-depth-weighting-ok?) : bool
  (let
    [func : ir.CompilerIrFunction
      (opt-inline-checked-depth-fixture (opt-test-symbol "checked_depth") 4)]
    [base : i64 (opt.opt-inline-census-depth-base)]
    [at0 : i64 (opt.opt-inline-checked-weighted-instrs-at func 0)]
    [at1 : i64 (opt.opt-inline-checked-weighted-instrs-at func 1)]
    [at2 : i64 (opt.opt-inline-checked-weighted-instrs-at func 2)]
    [at3 : i64 (opt.opt-inline-checked-weighted-instrs-at func 3)]
    (and
      ;; one entry instruction at depth 0 plus four loop instructions at depth 1
      (= at0 (+ 1 (* base 4)))
      ;; one level down: the entry joins depth 1, the loop reaches depth 2
      (= at1 (+ base (* base (* base 4))))
      ;; and the ladder saturates, so a third level costs nothing more
      (= at2 at3)
      (= at2 (opt.opt-inline-checked-weighted-instrs-at func 9)))))

;; INL-14: a versioned loop prices as ONE loop. The slow copy is the guard's
;; failure path and is priced cold, so the pair costs exactly what either copy
;; costs alone; a clone with no original beside it, or an original with no
;; clone, is an ordinary loop. The guard runs once per entry: below the cap its
;; own depth prices that, and at or past the cap it is charged one rung below
;; the cap rather than at its inner loop's weight (#8455). A guard whose header
;; is not in the body is ordinary code.
(define (compiler-optimize-inline-checked-versioned-loop-weighting-ok?) : bool
  (let
    [base : i64 (opt.opt-inline-census-depth-base)]
    [w1 : i64 (opt.opt-inline-census-depth-weight 1)]
    [w2 : i64 (opt.opt-inline-census-depth-weight 2)]
    [rung : i64
      (opt.opt-inline-census-depth-weight
        (- (opt.opt-inline-census-depth-cap) 1))]
    [pair : i64
      (let
        [func
          (irt.func
            "function @checked_versioned_pair() -> i64 vars 1 {
           entry:
             jump loop__bce_guard
           loop__bce_guard:
             %0 = mov 1 : i64
             branch true, loop__bce_fast, loop
           loop:
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             jump loop
           loop__bce_fast:
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             jump loop__bce_fast
           }")]
        (opt.opt-inline-checked-weighted-instrs-at func 0))]
    [nested : i64
      (let
        [func
          (irt.func
            "function @checked_versioned_nested() -> i64 vars 1 {
           entry:
             jump outer
           outer:
             %0 = mov 1 : i64
             jump mid
           mid:
             jump gone__bce_guard
           gone__bce_guard:
             jump loop__bce_guard
           loop__bce_guard:
             %0 = mov 1 : i64
             branch true, loop__bce_fast, loop
           loop:
             %0 = mov 1 : i64
             branch true, loop, mid_latch
           loop__bce_fast:
             branch true, loop__bce_fast, mid_latch
           mid_latch:
             branch true, mid, outer_latch
           outer_latch:
             branch true, outer, exit
           exit:
             return 0
           }")]
        (opt.opt-inline-checked-weighted-instrs-at func 0))]
    [fast-only : i64
      (let
        [func
          (irt.func
            "function @checked_versioned_fast() -> i64 vars 1 {
           entry:
             jump loop__bce_fast
           loop__bce_fast:
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             jump loop__bce_fast
           }")]
        (opt.opt-inline-checked-weighted-instrs-at func 0))]
    [slow-only : i64
      (let
        [func
          (irt.func
            "function @checked_versioned_slow() -> i64 vars 1 {
           entry:
             jump loop
           loop:
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             %0 = mov 1 : i64
             jump loop
           }")]
        (opt.opt-inline-checked-weighted-instrs-at func 0))]
    (and
      ;; one entry instruction at depth 0 plus four loop instructions at depth 1
      (= fast-only (+ 1 (* base 4)))
      (= slow-only (+ 1 (* base 4)))
      ;; the entry and the two-instruction guard at depth 0, the clone at
      ;; depth 1, and not the original
      (= pair (+ 3 (* base 3)))
      ;; the entry and exit at depth 0; `outer`, `outer_latch` and the
      ;; two-instruction guard at depth 2 charged one rung below the cap;
      ;; `mid`, the headerless guard, the clone and `mid_latch` saturated;
      ;; and not the original
      (= rung w1)
      (= nested (+ 2 (* 5 w1) (* 4 w2))))))

;; The accept window. A free inline saves exactly `boundary`; the tier keeps a
;; site only when the model lands between half of that and two and a half
;; times it -- too little and the inline did not repay, too much and the two
;; sides were not measured in the same currency. The cap is pinned at its edge
;; on both sides (20 against 8 is the `cg-map-probe` into `cg-map-insert-ref!`
;; shape, which sits exactly on it).
;; INL-22: the bytes an sret callee writes through `__sret`, which is what the
;; verdict's boundary adds for the result copy a free inline retires. Read
;; off the widest store the body makes through the parameter: word geps at
;; 0/8/16/24 read 32, a copy_bytes reads its own length, and a callee with no
;; `__sret` parameter reads 0 (and adds nothing to its boundary).
(define (opt-inline-sret-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "kind" (I64) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param (ir.compiler-ir-hidden-sret-param-name) (U64) 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-inline-sret-gep-store [dst : i64] [offset : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Gep dst (Var 1) (I64 offset) (U8))
    (ir.CompilerIrInstr.StorePtr (Var dst) (Var 0) (I64))))

(define (opt-inline-sret-callee
  [params : ir.CompilerIrParamSeq]
  [body : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "sret_callee")
    params
    (Unit)
    8
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instr-seq-append body (irt.instrs "return"))))
    Ordinary))

(define (compiler-optimize-inline-checked-sret-copy-ok?) : bool
  (and
    ;; four words through the parameter: 32 bytes, four words of copy
    (=
      (let
        [callee
          (opt-inline-sret-callee
            (opt-inline-sret-params)
            (opt-test-instr-seq-append
              (opt-inline-sret-gep-store 2 0)
              (opt-test-instr-seq-append
                (opt-inline-sret-gep-store 3 8)
                (opt-test-instr-seq-append
                  (opt-inline-sret-gep-store 4 16)
                  (opt-inline-sret-gep-store 5 24)))))]
        (opt.opt-inline-checked-sret-bytes callee))
      32)
    (=
      (let
        [callee
          (opt-inline-sret-callee
            (opt-inline-sret-params)
            (opt-test-instr-seq-append
              (opt-inline-sret-gep-store 2 0)
              (opt-inline-sret-gep-store 3 24)))]
        (opt.opt-inline-checked-sret-copy-cost callee))
      4)
    ;; a copy into the parameter reads its own length
    (=
      (let
        [callee
          (opt-inline-sret-callee
            (opt-inline-sret-params)
            (irt.instrs "copy_bytes %1, %0, 16"))]
        (opt.opt-inline-checked-sret-bytes callee))
      16)
    ;; a store straight through the parameter is one word
    (=
      (let
        [callee
          (opt-inline-sret-callee
            (opt-inline-sret-params)
            (irt.instrs "store_ptr %1, %0 : i64"))]
        (opt.opt-inline-checked-sret-bytes callee))
      8)
    ;; no sret parameter: nothing to copy, nothing added
    (=
      (let
        [callee
          (opt-inline-sret-callee
            (opt-inline-switch-params)
            (opt-inline-sret-gep-store 2 0))]
        (opt.opt-inline-checked-sret-bytes callee))
      0)))

(define (compiler-optimize-inline-checked-window-ok?) : bool
  (and
    ;; exactly what a free inline predicts
    (opt.opt-inline-checked-window-ok-at? 64 64 0)
    ;; the two edges of the window
    (opt.opt-inline-checked-window-ok-at? 32 64 0)
    (opt.opt-inline-checked-window-ok-at? 160 64 0)
    (opt.opt-inline-checked-window-ok-at? 20 8 0)
    ;; below it: the boundary was retired and the merged body ate the saving
    (not (opt.opt-inline-checked-window-ok-at? 31 64 0))
    (not (opt.opt-inline-checked-window-ok-at? 0 64 0))
    (not (opt.opt-inline-checked-window-ok-at? (- 0 400) 64 0))
    ;; above it: the model claims more than an inline can produce, which is what
    ;; a losing inline looks like here
    (not (opt.opt-inline-checked-window-ok-at? 161 64 0))
    (not (opt.opt-inline-checked-window-ok-at? 21 8 0))
    (not (opt.opt-inline-checked-window-ok-at? 89 9 0))
    (not (opt.opt-inline-checked-window-ok-at? 1193 64 0))
    ;; the boundary itself scales with arity, which is the part of a call
    ;; sequence that does
    (>
      (opt.opt-inline-checked-boundary-cost 14)
      (opt.opt-inline-checked-boundary-cost 2))))

;; The program budget counts VERDICTS, not accepts, because a rejected
;; candidate costs the same work an accepted one does. The level-2 inline
;; driver arms the tier and resets the budget; the test hook disarms it.
(define (compiler-optimize-inline-checked-budget-ok?) : bool
  (opt.opt-inline-checked-set-active! false)
  (opt.opt-inline-checked-program-begin!)
  (if (opt.opt-inline-checked-armed?)
    false
    (begin
      (opt.opt-inline-checked-set-active! true)
      (if (not (opt.opt-inline-checked-armed?))
        (begin
          (opt.opt-inline-checked-set-active! false)
          false)
        (let
          [budget-reset? : bool
            (=
              (opt.opt-inline-checked-budget-current)
              (opt.opt-inline-checked-program-budget))]
          ;; every fixture leaves the tier as it found it: the optimizer
          ;; unit tests share one process, and the band fixtures below
          ;; assert what the BANDS do
          (opt.opt-inline-checked-set-active! false)
          budget-reset?)))))

;; Two structural guarantees on the whole-program pass, asserted on the
;; multiblock fixtures the bands already own:
;;
;;   1. a program whose sites the BANDS admit spends no budget. The tier is
;;      asked only about sites no band takes, so a band-admitted site never
;;      reaches a verdict -- which is both the correctness rule (the cheaper
;;      admitter wins) and the reason the tier costs nothing on ordinary code;
;;   2. whatever the rollback keeps verifies. The accepted side is the walk's
;;      own rewrite and the reverted side is the banked-band-only rewrite, and
;;      both go through the same structural verifier the pass already runs.
(define (compiler-optimize-inline-checked-band-exclusion-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-plain callee-name))]
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (and
      ;; the duplication band takes both sites, so the measured tier is never
      ;; asked and the budget is untouched
      (= spent 0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        0)
      (opt-inline-mb2-main-verified? optimized "main")
      (opt-inline-mb2-main-verified? optimized "inline_nonleaf"))))

;; The tier DECIDES a call-carrying candidate, and whichever side of the
;; rollback it keeps verifies.
;;
;; The static bands refuse a call-carrying body outright -- that is their
;; pricing clause, and compiler-optimize-inline-dup-call-bearing-refusal-ok?
;; pins it -- so this leaf reaches every one of its three in-loop sites with
;; its boundary intact once the bands are done. The tier has no such clause:
;; it rebuilds each caller with the site, re-plans the merged function, and
;; keeps the site only when the measured saving lands in the accept window.
;; This drives that sequence over the three callers and pins BOTH outcomes at
;; once -- the callers whose plan repays keep the body, the caller whose plan
;; does not keeps its call -- which is the property the tier's whole rollback
;; exists to provide and the one that a clause refusing the candidate outright
;; could never exercise.
;;
;; The encoding is `spent`, then the armed call counts, then the banked ones,
;; so a change in any of the three reads directly off the number.
(define (compiler-optimize-inline-checked-call-carrying-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_disarm : unit
      (begin
        (opt.opt-inline-checked-program-begin!)
        (opt.opt-inline-checked-set-active! false))]
    [banked : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    [banked-code : i64
      (+
        (*
          100
          (opt-count-direct-call-name-function-seq
            banked
            "main"
            "inline_switch"))
        (+
          (*
            10
            (opt-count-direct-call-name-function-seq
              banked
              "inline_nonleaf"
              "inline_switch"))
          (opt-count-direct-call-name-function-seq
            banked
            "inline_loop"
            "inline_switch")))]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    [armed-code : i64
      (+
        (*
          100
          (opt-count-direct-call-name-function-seq armed "main" "inline_switch"))
        (+
          (*
            10
            (opt-count-direct-call-name-function-seq
              armed
              "inline_nonleaf"
              "inline_switch"))
          (opt-count-direct-call-name-function-seq
            armed
            "inline_loop"
            "inline_switch")))]
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf")
        (opt-inline-mb2-main-verified? armed "inline_loop"))]
    [_disarm-after : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 1000000 spent) (+ (* 1000 armed-code) banked-code))
      (- 0 1))))

;; spent=3, armed=000 (all three callers kept the body), banked=111 (the bands
;; left every site out of line).
(define (compiler-optimize-inline-checked-call-carrying-ok?) : bool
  (= (compiler-optimize-inline-checked-call-carrying-self-test) 3000111))

;; The same in-loop site, one loop deeper. entry -> outer -> header -> body,
;; with the call in `body`, so the site's depth weight is the census ladder's
;; second rung rather than its first. Nothing else about the site changes: the
;; callee, its arity and its body are the ones the accept fixture uses.
(define (opt-inline-nested-loop-site-blocks [callee-name : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "latch:
               jump header
             exit:
               jump outer_latch
             outer_latch:
               jump outer
             done:
               return %6")
    (irt.block "entry:
         %3 = mov 0 : i64
         jump outer")
    (irt.block
      "outer:
           %6 = phi [%3, entry], [%4, outer_latch] : i64
           branch %1, header, done")
    (irt.block
      "header:
             %4 = phi [%6, outer], [%5, latch] : i64
             branch %0, body, exit")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs
        (opt-inline-loop-site-call callee-name 5)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch"))))))

(define (opt-inline-nested-loop-site-function
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    7
    (opt-inline-nested-loop-site-blocks callee-name)
    Ordinary))

;; Two nested-loop callers of the same call-carrying leaf. Two references keep
;; every band away -- the duplicating, hot-loop-leaf and shared-accessor bands
;; all refuse a call-carrying body, and with no single-reference absorb bonus
;; the ordinary cost model refuses a five-block callee on block weight alone --
;; so both sites reach the measured tier, one loop deeper than the accept
;; fixture's.
(define (compiler-optimize-inline-checked-call-carrying-deep-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-nested-loop-site-function symbols.main callee-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-nested-loop-site-function
                  symbols.inline-nonleaf
                  callee-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-inline-dup-leaf-calling
                      callee-name
                      symbols.external-helper))
                  (& (ir.compiler-ir-function-seq-empty)))))))
        2)]
    [code : i64
      (+
        (*
          10
          (opt-count-direct-call-name-function-seq armed "main" "inline_switch"))
        (opt-count-direct-call-name-function-seq
          armed
          "inline_nonleaf"
          "inline_switch"))]
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf")
        (opt-inline-mb2-main-verified? armed "inline_switch"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 100 spent) code)
      (- 0 1))))

(define (compiler-optimize-inline-checked-call-carrying-deep-ok?) : bool
  (= (compiler-optimize-inline-checked-call-carrying-deep-self-test) 200))

;; --- INL-2: the tail-call SITE class ----------------------------------------
;;
;; A caller whose block ends in `return f(...)` -- the lowerer's fused
;; `TailCall` -- is a site of the same standing as `dst = f(...)`, and the
;; splice at it is the simpler of the two: the spliced body's exits become the
;; CALLER's exits, so there is no continuation block, no result phi, and no
;; destination. What the fixtures below pin is exactly that, in both exit forms
;; a body can carry:
;;
;;   `Return v`     -> the caller's `Return v'`;
;;   `TailCall h`   -> the caller's `TailCall h` -- never a call in tail
;;                     position, because a chain that runs in constant stack
;;                     without the inline must still do so with it.
;;
;; The class belongs to the MEASURED tier alone: no band is asked about a tail
;; site (see opt-inline-multiblock-build-span-site-rewrite-seq for what
;; decides), so the fixtures that pin the splice arm the tier
;; and use a callee every band refuses. opt-inline-tail-exit-leaf is that
;; callee, and it carries one exit of each form.
;; The callee the tail-site fixtures price: the call-carrying cyclic leaf the
;; accept fixtures use, with its `zero` case rewritten from `t = helper(v0)`
;; into `return helper(v0)`. It therefore carries BOTH exit forms -- the tail
;; call in `zero` and the `Return` in `join` -- and nothing else about it
;; changes, so it is refused by every band for exactly the reasons the accept
;; fixtures' leaf is and only a re-plan can price it.
(define (opt-inline-tail-exit-leaf [callee-name : i64] [helper-name : i64]) : ir.CompilerIrFunction
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 1)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (Function
      callee-name
      (opt-inline-switch-params)
      (I64)
      5
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks
          "one:
                   jump join
                 join:
                   %3 = phi [20, one] : i64
                   return %3")
        (irt.block "entry:
               jump loop")
        (irt.block
          "loop:
                 bounds_check %1, %2 message \"switch_bounds_ok\"
                 switch %0 base 0 [0:zero, 1:one] default loop")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "zero")
          (opt-test-instrs
            (ir.CompilerIrInstr.TailCall helper-name (Array args) (I64)))))
      Ordinary)))

;; The nearest refused neighbour, and the reason it is written with a LOAD: an
;; indirect tail call whose target is a spelled function is rewritten into a
;; direct one by opt-devirt-known-function-instr before this pass runs, so a
;; fixture written that way would pin the direct admission. A load from a global
;; is a target devirtualization cannot see through, which is what leaves the
;; refusal this test claims as the reason the site survives.
(define (opt-inline-multiblock-tail-site-indirect-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Load 0 (Global symbols.inline-nonleaf) (I64))
          (irt.instr "tailcall* %0() : i64"))))
    Ordinary))

(define (opt-inline-multiblock-tail-site-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-multiblock-tail-site-indirect-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-tail-call-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

;; The same program with an INDIRECT tail-call site: nothing is spliced.
(define (compiler-optimize-inline-multiblock-tail-site-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-multiblock-tail-site-indirect-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-tail-call-indirect-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (=
              (opt-count-tail-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; --- the measured tier at a tail-call site ----------------------------------
;;
;; The same in-loop site the call-carrying fixtures use, with the call in TAIL
;; position: the loop takes an early exit that forwards to the leaf, which is
;; what `(return (f ...))` inside a `while` lowers to. Two callers share the
;; leaf, so no single-site or duplicating band can claim it and the measured
;; tier is what decides, at the tail-call site class (INL-2).
(define (opt-inline-tail-site-loop-call [callee-name : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (TailCall callee-name (Array args) (I64))))

;; entry -> header -> {body -> {tail_site, latch}, exit}, latch -> header. The
;; tail call sits in `tail_site`, a block that LIES BETWEEN the loop's header
;; and latch in block order and is a member of no natural loop: a tail call
;; ends the function, so the block reaches no back edge.
(define (opt-inline-tail-site-loop-blocks [callee-name : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "latch:
               jump header
             exit:
               return %4")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-inline-loop-site-entry-instrs))
    (irt.block
      "header:
           %4 = phi [%3, entry], [%5, latch] : i64
           branch %0, body, exit")
    (irt.block
      "body:
             %5 = add %4, 1 : i64
             branch %2, tail_site, latch")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "tail_site")
      (opt-test-instrs (opt-inline-tail-site-loop-call callee-name)))))

(define (opt-inline-tail-site-loop-function
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (opt-inline-tail-site-loop-blocks callee-name)
    Ordinary))

;; The encoding is `spent`, then the two callers' surviving references to the
;; leaf -- counted as tail calls AND as calls, so a site "taken" by converting
;; it into an ordinary call in tail position would read differently from one
;; left alone.
;;
;; A tail call ends the function, so the block holding one reaches no back
;; edge and belongs to no natural loop: the depths the census reads (INL-16)
;; put `tail_site` at depth zero, however deep the loop it leaves. That is the
;; dynamic truth -- the site runs at most once per invocation -- and a
;; block-order scan would get it wrong here. Neither
;; caller is called from a loop, so each site's composite frequency is one and
;; the frequency clause refuses both before pricing: no verdict is spent and
;; both tail calls survive. The tail site the tier prices is the one below.
(define (compiler-optimize-inline-checked-tail-site-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-tail-site-loop-function symbols.main callee-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-tail-site-loop-function
                  symbols.inline-nonleaf
                  callee-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-inline-tail-exit-leaf
                      callee-name
                      symbols.external-helper))
                  (& (ir.compiler-ir-function-seq-empty)))))))
        2)]
    [code : i64
      (opt-inline-tail-site-reference-code
        (opt.compiler-opt-global-shared-view armed))]
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf")
        (opt-inline-mb2-main-verified? armed "inline_switch"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 100 spent) code)
      (- 0 1))))

;; `main`'s surviving references to the leaf in the tens, `inline_nonleaf`'s in
;; the units, each counted as tail calls AND as calls.
(define (opt-inline-tail-site-reference-code [armed : ir.CompilerIrFunctionSeq]) : i64
  (+
    (*
      10
      (+
        (opt-count-direct-call-name-function-seq armed "main" "inline_switch")
        (opt-count-tail-call-name-function-seq
          (opt.compiler-opt-global-shared-view armed)
          "main"
          "inline_switch")))
    (+
      (opt-count-direct-call-name-function-seq
        armed
        "inline_nonleaf"
        "inline_switch")
      (opt-count-tail-call-name-function-seq
        armed
        "inline_nonleaf"
        "inline_switch"))))

;; --- the measured tier at a tail site it prices ----------------------------
;;
;; The loop below has ONE exit, the tail site, so that block post-dominates the
;; entry (opt-inline-checked-pos-post); the leaf is opt-inline-switch-callee-
;; named -- cyclic, bounds-carrying, call-free, behind every static band's
;; acyclic gate -- so the relaxed floor can stand down for it. `inline_nonleaf`
;; is called from the driver's loop, which is the caller count its composite
;; frequency reads; `main` carries the same site with no loop calling it, so
;; its frequency is one and the frequency clause refuses it before pricing.
;; Both callers name the leaf, so no single-site or duplicating band can claim
;; it, and the loop's counter is what the tail call forwards, so the loop
;; stays live through every re-plan the verdict runs.
(define (opt-inline-tail-post-site-call [callee-name : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 4))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (TailCall callee-name (Array args) (I64))))

;; entry -> header -> {body -> latch -> header, tail_site}.
(define (opt-inline-tail-post-site-blocks [callee-name : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-inline-loop-site-entry-instrs))
    (irt.block
      "header:
           %4 = phi [%3, entry], [%5, latch] : i64
           branch %0, body, tail_site")
    (irt.block
      "body:
             %5 = add %4, 1 : i64
             jump latch")
    (irt.block "latch:
               jump header")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "tail_site")
      (opt-test-instrs (opt-inline-tail-post-site-call callee-name)))))

(define (opt-inline-tail-post-site-function
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (opt-inline-tail-post-site-blocks callee-name)
    Ordinary))

;; The encoding is `spent` -- both budgets, since the admitted site is a
;; relaxed candidate and spends the relaxations' reserve -- then the two
;; callers' surviving references to the leaf as the loop fixture above counts
;; them.
(define (compiler-optimize-inline-checked-tail-post-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-checked-hot-driver-function
              symbols.inline-loop
              symbols.inline-nonleaf))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-tail-post-site-function symbols.main callee-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-inline-tail-post-site-function
                      symbols.inline-nonleaf
                      callee-name))
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (& (opt-inline-switch-callee-named callee-name))
                      (& (ir.compiler-ir-function-seq-empty)))))))))
        2)]
    [code : i64
      (opt-inline-tail-site-reference-code
        (opt.compiler-opt-global-shared-view armed))]
    [spent : i64
      (+
        (-
          (opt.opt-inline-checked-program-budget)
          (opt.opt-inline-checked-budget-current))
        (-
          (opt.opt-inline-checked-relaxed-program-budget)
          (opt.opt-inline-checked-relaxed-budget-current)))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf")
        (opt-inline-mb2-main-verified? armed "inline_loop")
        (opt-inline-mb2-main-verified? armed "inline_switch"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 100 spent) code)
      (- 0 1))))

;; The linked walk is the independent storage oracle until #5729 retires it.
;; Assert all three counters: duplicate definitions must not stop traversal or
;; discard the last literal, even though specialization then rejects the var.
(defstruct OptInlineLiteralScanSnapshot
  (definitions i64)
  (literal i64)
  (value i64))

(define (opt-inline-literal-scan-snapshot
  [blocks : ir.CompilerIrBlockList]
  [var : i64]) : OptInlineLiteralScanSnapshot
  (let
    [saved-count : i64 (array-ref opt.opt-inline-checked-literal-scan 0)]
    [saved-literal : i64 (array-ref opt.opt-inline-checked-literal-scan 1)]
    [saved-value : i64 (array-ref opt.opt-inline-checked-literal-scan 2)]
    (opt.opt-inline-checked-literal-scan-set! 0 0 0)
    (opt.opt-inline-checked-literal-scan-blocks! (& blocks) var)
    (let
      [result : OptInlineLiteralScanSnapshot
        (OptInlineLiteralScanSnapshot
          (array-ref opt.opt-inline-checked-literal-scan 0)
          (array-ref opt.opt-inline-checked-literal-scan 1)
          (array-ref opt.opt-inline-checked-literal-scan 2))]
      (opt.opt-inline-checked-literal-scan-set!
        saved-count
        saved-literal
        saved-value)
      result)))

(define (opt-inline-literal-scan-same?
  [a : OptInlineLiteralScanSnapshot]
  [b : OptInlineLiteralScanSnapshot]) : bool
  (and
    (= a.definitions b.definitions)
    (= a.literal b.literal)
    (= a.value b.value)))

(define (opt-inline-literal-scan-fixture-block [index : i64]) : ir.CompilerIrBlock
  (let
    [instrs : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 1)]
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.Mov 0 (I64 index) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.Mov 7 (Var 0) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (irt.instr "%9223372036854775790 = add 1, 2 : i64"))
    (ir.compiler-ir-instr-builder-push! (&mut instrs) (irt.instr "return %0"))
    (if (= (% index 2) 1)
      (ir.compiler-ir-instr-builder-push!
        (&mut instrs)
        (irt.instr "%0 = mov %7 : i64"))
      unit)
    (Block index (ir.compiler-ir-instr-builder-to-seq instrs))))

(define (opt-inline-literal-scan-fixture [count : i64]) : ir.CompilerIrBlockSeq
  (let
    [builder : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity 1)]
    [index : i64 0]
    (while (< index count)
      (ir.compiler-ir-block-builder-push!
        (&mut builder)
        (opt-inline-literal-scan-fixture-block index))
      (set! index (+ index 1)))
    ;; Poison spare capacity: a capacity-sized scan must fail even when the
    ;; live sequence is empty. Only builder.len blocks belong to the input.
    (while (< index (array-length builder.slots))
      (set!
        (array-ref builder.slots index)
        (opt-inline-literal-scan-fixture-block (- 0 100)))
      (set! index (+ index 1)))
    (ir.CompilerIrBlockSeq builder.slots builder.len)))

(define (opt-inline-literal-scan-case? [count : i64] [var : i64]) : bool
  (let
    [seq : ir.CompilerIrBlockSeq (opt-inline-literal-scan-fixture count)]
    [expected : OptInlineLiteralScanSnapshot
      (opt-inline-literal-scan-snapshot
        (Array (owned_view.compiler-owned-shared-view seq))
        var)]
    [wanted : OptInlineLiteralScanSnapshot
      (if (= var 0)
        (OptInlineLiteralScanSnapshot
          (+ count (/ count 2))
          (if (> count 0)
            1
            0)
          (if (> count 0)
            (- count 1)
            0))
        (OptInlineLiteralScanSnapshot
          (if (or (= var 7) (= var 9223372036854775790) (= var (- 0 1)))
            count
            0)
          0
          0))]
    [again : OptInlineLiteralScanSnapshot
      (opt-inline-literal-scan-snapshot (Array seq) var)]
    (and
      (opt-inline-literal-scan-same? expected wanted)
      (opt-inline-literal-scan-same? expected again))))

(define (compiler-optimize-inline-literal-dense-scan-self-test) : bool
  (let
    [count : i64 0]
    [ok? : bool true]
    (while (<= count 17)
      (if (and
        (opt-inline-literal-scan-case? count 0)
        (opt-inline-literal-scan-case? count 7)
        (opt-inline-literal-scan-case? count 9223372036854775790)
        (opt-inline-literal-scan-case? count (- 0 1))
        (opt-inline-literal-scan-case? count (- 0 7)))
        unit
        (set! ok? false))
      (set! count (+ count 1)))
    (and
      ok?
      (opt-inline-literal-scan-case? 65 0)
      (opt-inline-literal-scan-case? 65 9223372036854775790))))

(test
  inline-literal-dense-scan
  (test.assert-true
    (compiler-optimize-inline-literal-dense-scan-self-test)
    "dense literal scans preserve all definition/literal counters, order, and retained inputs across linked, dense, and mixed block storage"))

;; --- INL-18: literal-argument specialization --------------------------------
;;
;; A FORWARDER: a body whose every exit is a direct tail call and which carries
;; no `Return` of its own. Spliced at a call site, each tail call becomes a call
;; plus the continuation, so the body retires only its own boundary; its worth
;; is what the site's literal arguments fold. The frontend materializes a
;; literal argument as a temp (`t = 1`, then `f(t, ...)`), which is what the
;; hot caller below spells at its site; its cold twin passes a parameter
;; through instead, and the tier has nothing to price there.
(define (opt-inline-tail-only-forwarder [callee-name : i64] [helper-name : i64]) : ir.CompilerIrFunction
  (let
    [args-a : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 1)]
    [args-b : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 1)]
    (set! (array-ref args-a 0) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args-b 0) (ir.CompilerIrValue.Var 2))
    (Function
      callee-name
      (opt-inline-switch-params)
      (I64)
      3
      (ir.compiler-ir-blocks
        (irt.block "entry:
               branch %0, arm_a, arm_b")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "arm_a")
          (opt-test-instrs
            (ir.CompilerIrInstr.TailCall helper-name (Array args-a) (I64))))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "arm_b")
          (opt-test-instrs
            (ir.CompilerIrInstr.TailCall helper-name (Array args-b) (I64)))))
      Ordinary)))

(define (opt-inline-tail-only-site-call
  [callee-name : i64]
  [tag : ir.CompilerIrValue]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) tag)
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Call 5 callee-name (Array args) (I64))))

;; The loop-site caller's shape, with the site's first argument either the
;; temp a literal `1` was materialized into or the caller's own parameter.
(define (opt-inline-tail-only-site-body [callee-name : i64] [literal? : bool]) : ir.CompilerIrInstrSeq
  (if literal?
    (opt-test-instrs
      (ir.CompilerIrInstr.Mov 6 (I64 1) (I64))
      (opt-inline-tail-only-site-call callee-name (Var 6))
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))
    (opt-test-instrs
      (opt-inline-tail-only-site-call callee-name (Var 0))
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))))

(define (opt-inline-tail-only-site-function
  [func-name : i64]
  [callee-name : i64]
  [literal? : bool]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    7
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "latch:
               jump header
             exit:
               return %4")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-loop-site-entry-instrs))
      (irt.block
        "header:
             %4 = phi [%3, entry], [%5, latch] : i64
             branch %0, body, exit")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-inline-tail-only-site-body callee-name literal?)))
    Ordinary))

;; The encoding is `spent` then the calls to the forwarder left in `main`. With
;; the literal the site reaches a verdict; without it the tail-only clause
;; refuses before pricing and the call survives.
(define (compiler-optimize-inline-checked-tail-only-self-test [literal? : bool]) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-tail-only-site-function
              symbols.main
              callee-name
              literal?))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-tail-only-forwarder
                  callee-name
                  symbols.external-helper))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [calls : i64
      (opt-count-direct-call-name-function-seq armed "main" "inline_switch")]
    [verified? : bool (opt-inline-mb2-main-verified? armed "main")]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 100 spent) calls)
      (- 0 1))))

;; The leading `Mov`s of a literal into a block, which is how the specialized
;; copy pins a parameter.
(define (opt-inline-entry-literal-movs-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    index
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov _ value _)
        (match value
          [(I64 _) (opt-inline-entry-literal-movs-from instrs (+ index 1))]
          [_ index])]
      [_ index])))

(define (opt-inline-entry-literal-movs [blocks : ir.CompilerIrBlockList]) : i64
  (match (ir.compiler-ir-block-list-view blocks)
    [(slice block & _)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs) (opt-inline-entry-literal-movs-from instrs 0)])]
    [_ (- 0 1)]))

(define (opt-inline-specialization-args) : (__tl_dyn-array ir.CompilerIrValue)
  (__tl_make-array
    (ir.CompilerIrValue.I64 5)
    (ir.CompilerIrValue.Bool true)
    (ir.CompilerIrValue.I64 7)))

(define (compiler-optimize-inline-checked-specialization-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [forwarder : ir.CompilerIrFunction
      (opt-inline-tail-only-forwarder
        symbols.inline-switch
        symbols.external-helper)]
    [_record : unit
      (begin
        (let
          [args (ir.CompilerIrCallArgs.Array (opt-inline-specialization-args))]
          (opt.opt-inline-checked-record-literals! args))
        (opt.opt-inline-checked-adopt-literals!))]
    [recorded : i64 (opt.opt-inline-checked-literal-count-now)]
    [pinned : i64
      (match (opt.opt-inline-checked-specialized forwarder)
        [(Some special)
          (opt-inline-entry-literal-movs (opt.opt-function-blocks special))]
        [(No) (- 0 1)])]
    [no-args : ir.CompilerIrCallArgs Nil]
    [_clear : unit
      (begin
        (opt.opt-inline-checked-record-literals! no-args)
        (opt.opt-inline-checked-adopt-literals!))]
    [unpinned? : bool
      (match (opt.opt-inline-checked-specialized forwarder)
        [(No) true]
        [(Some _) false])]
    (cond
      ;; the window's cap reads the fold as part of a free inline's prediction;
      ;; the floor does not
      [(not (opt.opt-inline-checked-window-ok-at? 20 8 0)) 1]
      [(opt.opt-inline-checked-window-ok-at? 21 8 0) 2]
      [(not (opt.opt-inline-checked-window-ok-at? 21 8 1)) 3]
      [(opt.opt-inline-checked-window-ok-at? 3 8 100) 4]
      ;; cg-map-insert-ref! into cg-census-blocks: 2,049 against 576 with a
      ;; fold of 768
      [(not (opt.opt-inline-checked-window-ok-at? 2049 576 768)) 5]
      [(opt.opt-inline-checked-window-ok-at? 2049 576 0) 6]
      ;; a forwarder is tail-only; a body with a `Return` is not
      [(not
          (let
            [blocks (opt.opt-function-blocks forwarder)]
            (opt.opt-inline-checked-tail-only-body? blocks)))
        7]
      [(let
          [blocks
            (let
              [func (opt-inline-switch-callee-named symbols.inline-switch)]
              (opt.opt-function-blocks func))]
          (opt.opt-inline-checked-tail-only-body? blocks))
        8]
      ;; two `I64` arguments of three are literals, and the specialized copy
      ;; pins exactly those two at its entry
      [(not (= recorded 2)) 9]
      [(not (= pinned 2)) 10]
      ;; nothing to pin, no copy
      [(not unpinned?) 11]
      [else 42])))

;; --- INL-2: the post-keep rescan -------------------------------------------
;;
;; A kept site puts a COPY of the callee's body into the caller, and the copy
;; brings its own call sites. The walk that ranked the caller's candidates never
;; saw them: the clone is built during the rewrite and the block walk does not
;; re-enter it. So a caller whose rounds ended with a keep is scanned once more
;; over the body those rounds left, and the sites the copies exposed get rounds
;; of their own. See opt-inline-checked-max-generations.
;;
;; The chain below is three call-carrying bodies of the shape the accept
;; fixtures use, each calling the next with the same arity, plus a cold second
;; caller for each so no single-site or duplicating band can claim any of them.
;; Every one of the chain's own sites sits in its `zero` block, which is outside
;; its switch's self-loop and is not an entry block, so the depth floor refuses
;; all of them where they stand: the ONLY site any of these bodies has that the
;; tier will price is the one in `main`, which is in a loop.
;;
;; That is what makes the generations visible one at a time. Generation 1 prices
;; `main`'s in-loop site of the first body; its copy carries the second body's
;; site into `main`'s loop, where generation 2 prices it; and that copy carries
;; the third body's site, which a third generation would price and which the
;; bound stops. The encoding below reads all three off the surviving calls.
(define (opt-inline-rescan-chain-leaf-zero-instrs [callee-name : i64]) : ir.CompilerIrInstrSeq
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (opt-test-instrs-with-tail
      (opt-inline-dup-leaf-jump-zero-instrs)
      (ir.CompilerIrInstr.Call 4 callee-name (Array args) (I64)))))

(define (opt-inline-rescan-chain-leaf [name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    name
    5
    (opt-inline-rescan-chain-leaf-zero-instrs callee-name)))

;; The cold second reference for each link of the chain, from one straight-line
;; caller: three depth-0 sites of call-carrying bodies, which the depth floor
;; refuses (the entry relaxation needs a call-free callee) and every band
;; refuses on the callee's calls. It exists to keep the census's reference count
;; at two per body, and does nothing else.
(define (opt-inline-rescan-chain-cold-call [callee-name : i64] [dst : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Call dst callee-name (Array args) (I64))))

(define (opt-inline-rescan-chain-cold-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-branch
    (opt-inline-switch-params)
    (I64)
    7
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-rescan-chain-cold-call symbols.inline-loop 3)
          (opt-inline-rescan-chain-cold-call symbols.inline-nonleaf 4)
          (opt-inline-rescan-chain-cold-call symbols.inline-switch 5)
          (irt.instr "return %5"))))
    Ordinary))

(define (opt-inline-rescan-chain-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-inline-loop-site-function
        symbols.main
        symbols.inline-loop
        (opt-inline-loop-site-entry-instrs)))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-rescan-chain-cold-caller symbols))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-inline-rescan-chain-leaf
                symbols.inline-loop
                symbols.inline-nonleaf))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (opt-inline-rescan-chain-leaf
                    symbols.inline-nonleaf
                    symbols.inline-switch))
                (&
                  (ir.compiler-ir-function-seq-prepend
                    (&
                      (opt-inline-rescan-chain-leaf
                        symbols.inline-switch
                        symbols.external-helper))
                    (& (ir.compiler-ir-function-seq-empty))))))))))))

;; The encoding is the core verdicts spent, then the relaxed ones, then main's
;; surviving calls to the three links, one digit apiece, outermost link first.
;;
;; 11001 is: one core verdict (generation 1, the first link), one relaxed
;; verdict (generation 2, the second link -- a second body in this caller, so a
;; relaxed candidate by the lock), no call left to either of those two, and one
;; call left to the third. Bound the generations to one and the same fixture
;; reads 10010: the second link's site is never offered, which is the whole of
;; what the rescan adds and the whole of what the bound stops.
(define (compiler-optimize-inline-checked-rescan-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-rescan-chain-functions symbols)
        2)]
    [code : i64
      (+
        (*
          100
          (opt-count-direct-call-name-function-seq armed "main" "inline_loop"))
        (+
          (*
            10
            (opt-count-direct-call-name-function-seq
              armed
              "main"
              "inline_nonleaf"))
          (opt-count-direct-call-name-function-seq armed "main" "inline_switch")))]
    ;; Core verdicts and RELAXED ones are counted apart, because the rescan's
    ;; candidate is a second body in this caller and every second body is a
    ;; relaxed candidate: reading only the core budget would not show that the
    ;; rescan priced anything at all.
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [relaxed-spent : i64
      (-
        (opt.opt-inline-checked-relaxed-program-budget)
        (opt.opt-inline-checked-relaxed-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_loop")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 10000 spent) (+ (* 1000 relaxed-spent) code))
      (- 0 1))))

;; --- INL-19: the rescan after a BAND absorb --------------------------------
;;
;; The single-reference absorb band moves a whole body into its caller, calls
;; and all, and the walk that moved it does not re-enter the moved blocks: the
;; sites inside were scanned once in the absorbed body's own text, where the
;; depth floor refused every one of them, and in the caller nothing offered a
;; verdict on them at all. So a caller whose first walk absorbed a body is
;; rescanned exactly as a caller whose rounds kept one is
;; (opt-inline-checked-absorb-exposed-sites?).
;;
;; The absorbed body is the wide single-site callee of the absorb fixtures --
;; ten parameters, 220 instructions, a loop -- padded past the cost band's
;; block fuel so that the single-reference absorb band is what moves it, and
;; with one call to the rescan chain's second link in its `zero` block, OUTSIDE
;; its own loop: in the body's own text that site is depth 0 and refused on the
;; floor (a call inside the loop would be priced right there, with no rescan
;; needed), and `main` is the in-loop caller the absorb fixtures move the body
;; into (compiler-optimize-inline-single-site-loop-site-call-bearing-absorb-ok?
;; is the same admission). The second and third links are the rescan
;; fixture's, with the cold caller referencing exactly those two so each keeps
;; its second reference: bodies no band takes and the tier prices.
;;
;; The encoding is the rescan fixture's: core verdicts spent, relaxed ones,
;; then `main`'s surviving calls to the three links, one digit apiece. 10001
;; is: no verdict in generation one (the band took the first link, and the
;; tier is not asked about a site a band takes), one CORE verdict in the
;; generation the absorb opened -- the second link is the caller's first body
;; -- and kept, no call left to the first two links, one call left to the
;; third, which the copy the keep made exposed and the generation bound leaves
;; where it is. Without the absorb rescan the same program reads 10: no verdict
;; anywhere and the second link's call sits inside `main`'s loop unpriced.
;; The wide single-site body with the chain call in its `zero` block: outside
;; the body's own loop, so in the body's own text the site is depth 0 and the
;; depth floor refuses it there (exactly the chain fixture's reading), and
;; inside `main`'s loop once the band has moved the body in.
;; A chain of `remaining` single-jump blocks from `entry` to `loop`, so the
;; body holds more blocks than the cost band's fuel
;; (opt-inline-cost-block-fuel) and the single-reference absorb band is the one
;; admitter left -- the sccp_lattice shape, where `sccp-process-instr`'s sixty
;; blocks are what leave the move to that band.
(define (opt-inline-absorb-rescan-pad-label [index : i64]) : i64
  (ir.compiler-ir-label (& (str_cat.str-cat "pad_" (string.int->string index)))))

(define (opt-inline-absorb-rescan-pad-count) : i64
  (+ (opt.opt-inline-cost-block-fuel) 4))

(define (opt-inline-absorb-rescan-pad-blocks!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [remaining : i64]
  [index : i64]
  [tail : ir.CompilerIrBlockList]) : unit
  (if (<= remaining 0)
    (ir.compiler-ir-block-builder-append-list! out tail)
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-absorb-rescan-pad-label index)
          (opt-test-instrs
            (ir.CompilerIrInstr.Jump
              (if (<= remaining 1)
                (ir.compiler-ir-label "loop")
                (opt-inline-absorb-rescan-pad-label (+ index 1)))))))
      (opt-inline-absorb-rescan-pad-blocks!
        out
        (- remaining 1)
        (+ index 1)
        tail))))

(define (opt-inline-absorb-rescan-first-link-blocks
  [params : i64]
  [zero-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (opt.opt-blocks-collect
      opt-inline-absorb-rescan-pad-blocks!
      (opt-inline-absorb-rescan-pad-count)
      0
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "loop")
          (opt-test-instrs-with-tail
            (opt-inline-wide-pad-instrs
              (opt-inline-wide-pad-count)
              params
              (irt.instrs "switch %0 base 0 [0:zero, 1:one] default loop"))
            (irt.instr "bounds_check %1, %2 message \"switch_bounds_ok\"")))
        (ir.CompilerIrBlock.Block (ir.compiler-ir-label "zero") zero-instrs)
        (irt.block "one:
                 jump join")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "join")
          (opt-test-instrs
            (opt-inline-wide-loop-phi-instr params)
            (ir.CompilerIrInstr.Return
              (Some (Var (opt-inline-wide-phi-var params))))))))
    (irt.block "entry:
         jump pad_0")))

(define (opt-inline-absorb-rescan-first-link [name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (let
    [params : i64 (opt-inline-wide-param-count)]
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Function
      name
      (opt-inline-wide-params params)
      (I64)
      (+ (opt-inline-wide-phi-var params) 2)
      (opt-inline-absorb-rescan-first-link-blocks
        params
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            (+ (opt-inline-wide-phi-var params) 1)
            callee-name
            (Array args)
            (I64))
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "join"))))
      Ordinary)))

(define (opt-inline-absorb-rescan-cold-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-branch
    (opt-inline-switch-params)
    (I64)
    7
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-rescan-chain-cold-call symbols.inline-nonleaf 4)
          (opt-inline-rescan-chain-cold-call symbols.inline-switch 5)
          (irt.instr "return %5"))))
    Ordinary))

(define (opt-inline-absorb-rescan-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-wide-loop-caller symbols.main symbols.inline-loop))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-absorb-rescan-cold-caller symbols))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-inline-absorb-rescan-first-link
                symbols.inline-loop
                symbols.inline-nonleaf))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (opt-inline-rescan-chain-leaf
                    symbols.inline-nonleaf
                    symbols.inline-switch))
                (&
                  (ir.compiler-ir-function-seq-prepend
                    (&
                      (opt-inline-rescan-chain-leaf
                        symbols.inline-switch
                        symbols.external-helper))
                    (& (ir.compiler-ir-function-seq-empty))))))))))))

(define (compiler-optimize-inline-checked-absorb-rescan-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [armed : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-absorb-rescan-functions symbols)
        2)]
    [code : i64
      (+
        (*
          100
          (opt-count-direct-call-name-function-seq armed "main" "inline_loop"))
        (+
          (*
            10
            (opt-count-direct-call-name-function-seq
              armed
              "main"
              "inline_nonleaf"))
          (opt-count-direct-call-name-function-seq armed "main" "inline_switch")))]
    [spent : i64
      (-
        (opt.opt-inline-checked-program-budget)
        (opt.opt-inline-checked-budget-current))]
    [relaxed-spent : i64
      (-
        (opt.opt-inline-checked-relaxed-program-budget)
        (opt.opt-inline-checked-relaxed-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 10000 spent) (+ (* 1000 relaxed-spent) code))
      (- 0 1))))

;; --- INL-6: the shape a rescan generation's BAND walk may not absorb -------
;;
;; A caller keeps a site; the copy carries the callee's own straight-line call
;; sites into the caller, and if the caller's site was in a loop those sites are
;; now IN one. That is a change of admission for every band that asks
;; `opt-inline-bounds-loop-site-in-loop?`, and what the rescan's walk then does
;; with them is committed or discarded by whether some verdict in that
;; generation keeps -- so it is a rewrite nothing priced (asm_render's
;; `asm-fold-text` is that rewrite, and a loss);
;; opt-inline-checked-rescan-loop-import? is the clause that refuses it.
;;
;; What that clause is, is three questions, and this pins the two that are
;; decidable without a caller: the SHAPE it separates, and the generation gate
;; that keeps it inert everywhere else.
;;
;; The two bodies are the corpus's two answers, and they differ in exactly the
;; property the clause reads. `opt-inline-switch-callee-named` carries a LOOP
;; behind its bounds check -- asm_render's byte-fold class, the one that lands a
;; loop NEST in a caller the measured tier merged and loses the accumulator's
;; register. `opt-inline-acyclic-switch-callee` is the same size, the same
;; arity and the same bounds check with no loop -- lex_source's character-class
;; shape, whose two absorptions the clause must leave alone, and which is why
;; the clause asks about the callee's back edges rather than only about the
;; site.
;;
;; The generation gate is asserted on both bodies because it is what bounds the
;; clause's cost: in generation one it answers before the caller's natural-loop
;; facts are forced, so every caller in a program that never reaches a rescan
;; pays one integer compare for it.
;;
;; The benchmark-level behaviour is not asserted here. A fixture small enough to
;; assert by construction is also small enough that the measured tier keeps
;; what the corpus's tier refuses on the accept window, so an end-to-end
;; differential over this program shows the same result either way; the
;; asm-shape case over `benchmarks/asm_render/bench.tl`
;; (`asm-render-fold-accumulator` in tests/codegen/asm-shape.cases) is what
;; carries that claim.
(define (compiler-optimize-inline-rescan-loop-nest-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    [cyclic : ir.CompilerIrBlockList
      (let
        [func (opt-inline-switch-callee-named symbols.inline-switch)]
        (opt.opt-function-blocks func))]
    [acyclic : ir.CompilerIrBlockList
      (let
        [func (opt-inline-acyclic-switch-callee symbols)]
        (opt.opt-function-blocks func))]
    (and
      ;; generation one: the tier has reshaped nothing, so the clause is inert
      ;; for either body and answers without asking the caller anything.
      (= (opt.opt-inline-checked-generation-current) 1)
      (not (opt.opt-inline-checked-rescan-loop-import? cyclic))
      (not (opt.opt-inline-checked-rescan-loop-import? acyclic))
      ;; ...and the shape it separates: a loop behind the bounds check, against
      ;; the same body with none.
      (not (opt.opt-inline-tiny-predicate-acyclic? (& cyclic)))
      (opt.opt-inline-tiny-predicate-acyclic? (& acyclic)))))

;; --- what a generation carries, and what it retires -------------------------
;;
;; The accepted table is the caller's, not the generation's: a rescan does not
;; refund the verdict caps, the callee lock's distinct bodies or the accept cap,
;; because a caller does not get a fresh allowance by being walked twice. What
;; the generation boundary DOES change is what a row names -- a row of a
;; finished generation names a site of a function that no longer exists as such,
;; since its inline is already inside the body this generation started from, so
;; it must never match a site again.
;;
;; This drives the bookkeeping directly, the way the sequence fixtures drive the
;; round bookkeeping: it is decidable without a fixture the size of a benchmark
;; kernel, and it is exactly what decides whether a rescan can double-splice a
;; body or take an allowance the first generation already spent.
(define (compiler-optimize-inline-checked-generation-carry-ok?) : bool
  (let
    [a : i64 (opt-inline-checked-seq-callee-a)]
    [b : i64 (opt-inline-checked-seq-callee-b)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    [_scan : unit (opt.opt-inline-checked-scan-record! a 60 0 900 false false)]
    [armed-first? : bool (opt.opt-inline-checked-arm-next-target!)]
    [_keep : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    [gen1-accepted? : bool (opt.opt-inline-checked-accepted? a 60 0)]
    [gen1-verdicts : i64 (opt.opt-inline-checked-caller-verdicts-current)]
    [_next : unit (opt.opt-inline-checked-generation-begin!)]
    ;; the generation advanced, and the caller's own allowances did not reset
    [gen2 : i64 (opt.opt-inline-checked-generation-current)]
    [gen2-verdicts : i64 (opt.opt-inline-checked-caller-verdicts-current)]
    [gen2-accepted-count : i64 (opt.opt-inline-checked-accepted-current)]
    ;; ...but the finished generation's row no longer names a live site
    [gen1-row-retired? : bool (not (opt.opt-inline-checked-accepted? a 60 0))]
    ;; ...while the lock still counts its body, so a second body in the rescan
    ;; is a RELAXED candidate, ranked behind every core row and drawing on the
    ;; relaxations' reserve
    [_scan2 : unit (opt.opt-inline-checked-scan-record! b 61 1 800 false false)]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [second-relaxed? : bool (opt.opt-inline-checked-target-relaxed-current?)]
    [_keep2 : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    ;; the rescan's own row names its own site, and the accept cap counts both
    [gen2-accepted? : bool (opt.opt-inline-checked-accepted? b 61 1)]
    [final-accepted-count : i64 (opt.opt-inline-checked-accepted-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      gen1-accepted?
      (= gen1-verdicts 1)
      (= gen2 2)
      (= gen2-verdicts 1)
      (= gen2-accepted-count 1)
      gen1-row-retired?
      armed-second?
      second-relaxed?
      gen2-accepted?
      (= final-accepted-count 2)
      ;; and a caller's own start does reset all of it
      (= (opt.opt-inline-checked-generation-current) 1)
      (= (opt.opt-inline-checked-accepted-current) 0))))

;; The per-caller ACCEPT cap is one of the allowances a rescan carries: a caller
;; whose generations have together filled the accepted table cannot bank another
;; site in a later generation, because the table is the CALLER's and a rescan
;; does not hand it back empty. Generation 1 banks one site here and the rescan
;; banks the rest, so the row that finds the table full is one a generation
;; boundary was crossed to reach.
(define (opt-inline-checked-fill-accepts [taken : i64]) : i64
  (if (>= taken (opt.opt-inline-checked-max-caller-accepts))
    taken
    (begin
      (opt.opt-inline-checked-accept-target!)
      (opt-inline-checked-fill-accepts (+ taken 1)))))

(define (compiler-optimize-inline-checked-generation-accept-cap-ok?) : bool
  (let
    [a : i64 (opt-inline-checked-seq-callee-a)]
    [b : i64 (opt-inline-checked-seq-callee-b)]
    [cap : i64 (opt.opt-inline-checked-max-caller-accepts)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    [_scan : unit (opt.opt-inline-checked-scan-record! a 80 0 900 false false)]
    [armed-first? : bool (opt.opt-inline-checked-arm-next-target!)]
    [_keep : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    [gen1-accepted : i64 (opt.opt-inline-checked-accepted-current)]
    [_next : unit (opt.opt-inline-checked-generation-begin!)]
    ;; the rescan starts from the table generation 1 left, not from an empty one
    [carried : i64 (opt.opt-inline-checked-accepted-current)]
    [_scan2 : unit (opt.opt-inline-checked-scan-record! b 81 1 800 false false)]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [_keep2 : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    ;; ...and the rest of the rescan's accepts fill it exactly to the cap
    [filled : i64
      (opt-inline-checked-fill-accepts
        (opt.opt-inline-checked-accepted-current))]
    [at-cap : i64 (opt.opt-inline-checked-accepted-current)]
    ;; the accept past the cap banks nothing: the site is priced and reverted
    ;; rather than kept, and no later walk of this caller rebuilds it
    [_over : unit (opt.opt-inline-checked-accept-target!)]
    [after-over : i64 (opt.opt-inline-checked-accepted-current)]
    [gen1-row-still-counted? : bool
      (> (opt.opt-inline-checked-accepted-current) 1)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      (= gen1-accepted 1)
      (= carried 1)
      armed-second?
      (= filled cap)
      (= at-cap cap)
      (= after-over cap)
      gen1-row-still-counted?
      (= (opt.opt-inline-checked-accepted-current) 0))))

;; ...and the other side of the same check, on a body the window prices.
;;
;; The verdict is priced here against a plan that did NOT change: the same
;; caller stands in for both sides of the rollback, so nothing was saved and
;; `before - after` is exactly the boundary the site would retire plus the
;; callee's own body, priced where the inline would put it. A body that costs
;; more than the boundary it retires is over-credit rather than saving, which
;; is precisely what the window's upper bound refuses. INL-17 waives that bound
;; for a body of at most sixty-four instructions per execution, so the callee
;; here is the eighty-block acyclic sole-call leaf, well past the waiver; what
;; separates the two outcomes is the measured plan and nothing about the body.
(define (compiler-optimize-inline-checked-call-carrying-revert-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [caller : ir.CompilerIrFunction
      (opt-inline-loop-site-function
        symbols.main
        callee-name
        (opt-inline-loop-site-entry-instrs))]
    [leaf : ir.CompilerIrFunction (opt-inline-sole-call-leaf callee-name)]
    [keep? : bool
      (opt.opt-inline-checked-verdict
        (ast.ast-node-pool-reader-type-segment-bases)
        (& caller)
        (& caller)
        (& leaf)
        1
        (opt.opt-inline-census-depth-base)
        3
        (- 0 1))]
    (not keep?)))

;; --- the sequence: one caller, one site at a time ---------------------------
;;
;; The tier prices a caller's sites in SEQUENCE: a scan walk ranks them, and
;; then one round per verdict rebuilds the caller with the sites already kept
;; plus one new one and prices exactly that difference. These drive the round
;; bookkeeping directly -- the scan table, the ranking, the accepted table and
;; the caps -- because that bookkeeping is what decides which sites a caller is
;; offered and in which order, and it is decidable without a fixture the size of
;; a benchmark kernel.
;;
;; The end-to-end behaviours these encode: two sites of one map lookup accepted
;; in sequence in one caller, a first site refused and a second accepted in the
;; same caller, and a caller whose second site names a different callee
;; refused.
(define (opt-inline-checked-seq-callee-a) : i64
  (opt-test-symbol "seq_callee_a"))

(define (opt-inline-checked-seq-callee-b) : i64
  (opt-test-symbol "seq_callee_b"))

;; Two sites of ONE callee, offered richest-first, both kept: the second round
;; arms the second site because the caller's first accept named that callee, and
;; both end up in the accepted table -- which is what makes a later walk rebuild
;; both.
(define (compiler-optimize-inline-checked-sequence-two-sites-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    ;; the poorer site first in walk order, so only the ranking can order them
    [_scan : unit
      (begin
        (opt.opt-inline-checked-scan-record! callee 10 1 100 false false)
        (opt.opt-inline-checked-scan-record! callee 11 2 900 false false))]
    [armed-first? : bool (opt.opt-inline-checked-arm-next-target!)]
    [first-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [_keep-first : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [second-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [_keep-second : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    [armed-third? : bool (opt.opt-inline-checked-arm-next-target!)]
    ;; read the tables before the reset puts them back
    [rich-kept? : bool (opt.opt-inline-checked-accepted? callee 11 2)]
    [poor-kept? : bool (opt.opt-inline-checked-accepted? callee 10 1)]
    [verdicts : i64 (opt.opt-inline-checked-caller-verdicts-current)]
    [accepted : i64 (opt.opt-inline-checked-accepted-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      armed-second?
      ;; RICHEST FIRST: the second-recorded site is worth nine times the first
      ;; and is priced first, against the state the scan walk built
      (= first-pos 2)
      (= second-pos 1)
      ;; and the caller has nothing left to arm
      (not armed-third?)
      ;; both sites are in the accepted table, so every later walk of this
      ;; caller rebuilds both
      rich-kept?
      poor-kept?
      ;; two verdicts, two accepts
      (= verdicts 2)
      (= accepted 2))))

;; The partial state. One site of a caller is kept and the next REVERTED: the
;; reverted site never enters the accepted table, so the state the caller ends
;; on carries the first site and not the second -- which is the whole reason the
;; rollback is per site rather than per caller.
(define (compiler-optimize-inline-checked-sequence-partial-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    [_scan : unit
      (begin
        (opt.opt-inline-checked-scan-record! callee 20 0 900 false false)
        (opt.opt-inline-checked-scan-record! callee 21 3 100 false false))]
    [_first : unit
      (begin
        (opt.opt-inline-checked-arm-next-target!)
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    ;; the second verdict reverts: spent, never accepted
    [_second : unit
      (begin
        (opt.opt-inline-checked-arm-next-target!)
        (opt.opt-inline-checked-spend-verdict!))]
    [kept? : bool (opt.opt-inline-checked-accepted? callee 20 0)]
    [dropped? : bool (opt.opt-inline-checked-accepted? callee 21 3)]
    [verdicts : i64 (opt.opt-inline-checked-caller-verdicts-current)]
    [accepted : i64 (opt.opt-inline-checked-accepted-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      kept?
      (not dropped?)
      ;; both sites were priced, one survived
      (= verdicts 2)
      (= accepted 1))))

;; RICHNESS, and the growth in its denominator. Two sites worth the same by the
;; free-inline prediction alone are ordered by what they cost the caller's
;; growth budget, because that budget is a CEILING ON THEIR SUM and the order
;; decides which of them fit: left to the block walk, a large grow routine can
;; come first and leave the ceiling too low for a small comparison leaf.
(define (compiler-optimize-inline-checked-richness-ok?) : bool
  (and
    ;; the prediction still dominates: a site worth ten times as much outranks
    ;; a slightly cheaper one
    (>
      (opt.opt-inline-checked-richness 640 6 60)
      (opt.opt-inline-checked-richness 64 6 50))
    ;; equal predictions: the smaller body first
    (>
      (opt.opt-inline-checked-richness 8 6 59)
      (opt.opt-inline-checked-richness 8 6 276))
    ;; and arity still moves the prediction it divides
    (>
      (opt.opt-inline-checked-richness 8 14 59)
      (opt.opt-inline-checked-richness 8 2 59))
    ;; a degenerate body cannot divide by zero
    (> (opt.opt-inline-checked-richness 8 6 0) 0)))

;; Fill the scan table to its cap with distinct sites of one callee, richest
;; first so the drain order is the record order.
(define (opt-inline-checked-seq-fill-scan [callee : i64] [row : i64]) : unit
  (if (>= row (opt.opt-inline-checked-scan-cap))
    unit
    (begin
      (opt.opt-inline-checked-scan-record!
        callee
        (+ 100 row)
        row
        (- 1000 row)
        false
        false)
      (opt-inline-checked-seq-fill-scan callee (+ row 1)))))

;; Arm and spend verdicts until the caller is refused one, and report how many.
(define (opt-inline-checked-seq-drain [taken : i64]) : i64
  (if (opt.opt-inline-checked-arm-next-target!)
    (begin
      (opt.opt-inline-checked-spend-verdict!)
      (opt-inline-checked-seq-drain (+ taken 1)))
    taken))

;; THE PER-CALLER CAP. Verdicts are bounded per caller as well as per program,
;; so one caller holding many candidates cannot drain the program's budget and
;; leave every later caller unmeasured.
(define (compiler-optimize-inline-checked-caller-cap-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [cap : i64 (opt.opt-inline-checked-max-caller-verdicts)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    [_scan : unit (opt-inline-checked-seq-fill-scan callee 0)]
    [armed : i64 (opt-inline-checked-seq-drain 0)]
    [budget-left : i64 (opt.opt-inline-checked-budget-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      ;; the scan ranked more candidates than the caller may price
      (> (opt.opt-inline-checked-scan-cap) cap)
      (= armed cap)
      ;; and the program keeps the rest of its budget for later callers
      (= budget-left (- (opt.opt-inline-checked-program-budget) cap)))))

;; ONE CALLEE PER CALLER. Once a caller has KEPT a site, its later sites are
;; restricted to that callee: what pays is one body landing at the sites that
;; share it, and what loses is a caller absorbing different bodies.
(define (compiler-optimize-inline-checked-one-callee-ok?) : bool
  (let
    [a : i64 (opt-inline-checked-seq-callee-a)]
    [b : i64 (opt-inline-checked-seq-callee-b)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    ;; the OTHER callee's site is the richer of the two
    [_scan : unit
      (begin
        (opt.opt-inline-checked-scan-record! a 30 0 100 false false)
        (opt.opt-inline-checked-scan-record! b 31 1 900 false false))]
    ;; before any accept, the richest wins outright
    [armed-first? : bool (opt.opt-inline-checked-arm-next-target!)]
    [first-callee : i64 (opt.opt-inline-checked-target-callee-current)]
    ;; that first site REVERTS, which claims nothing...
    [_revert : unit (opt.opt-inline-checked-spend-verdict!)]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [second-callee : i64 (opt.opt-inline-checked-target-callee-current)]
    ;; ...and this one is KEPT, which claims the caller for callee `a`
    [_keep : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    ;; a fresh caller-scan holding both callees now offers only `a`
    [_next : unit
      (begin
        (opt.opt-inline-checked-scan-record! b 32 2 900 false false)
        (opt.opt-inline-checked-scan-record! a 33 3 100 false false))]
    [armed-third? : bool (opt.opt-inline-checked-arm-next-target!)]
    [third-callee : i64 (opt.opt-inline-checked-target-callee-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      armed-second?
      armed-third?
      (= first-callee b)
      (= second-callee a)
      ;; the richer site names the other callee and is passed over for the
      ;; poorer site of the one this caller kept
      (= third-callee a))))

;; --- the relaxed depth floor, the entry-site rule and the lock -------------
;;
;; The relaxed depth floor. The clause exists to disqualify a straight-line site
;; in a caller nothing reaches; the composite frequency says exactly that in the
;; currency that also counts the loops ABOVE the caller, so where the frequency
;; carries the evidence the depth floor stands down and the verdict decides.
(define (compiler-optimize-inline-checked-depth-floor-ok?) : bool
  (and
    (> (opt.opt-inline-checked-min-site-depth) 0)
    ;; a call-free callee at an ENTRY site of a caller reached through a loop:
    ;; all three answers are available and the floor stands down
    (=
      (opt.opt-inline-checked-effective-min-site-depth
        (opt.opt-inline-checked-depth-relaxed-frequency)
        true
        true)
      0)
    ;; the same site under a caller nothing reaches through a loop
    (=
      (opt.opt-inline-checked-effective-min-site-depth
        (- (opt.opt-inline-checked-depth-relaxed-frequency) 1)
        true
        true)
      (opt.opt-inline-checked-min-site-depth))
    ;; ...a hot caller whose site is NOT the block it runs once per invocation:
    ;; the plan's currency has nothing to credit a whole boundary against
    (=
      (opt.opt-inline-checked-effective-min-site-depth
        (opt.opt-inline-checked-depth-relaxed-frequency)
        false
        true)
      (opt.opt-inline-checked-min-site-depth))
    ;; ...and a call-carrying callee, whose imported call takes away the one
    ;; thing a depth-0 inline can win beyond its 6+np boundary
    (=
      (opt.opt-inline-checked-effective-min-site-depth
        (opt.opt-inline-checked-depth-relaxed-frequency)
        true
        false)
      (opt.opt-inline-checked-min-site-depth))
    ;; the two floors read the same rung, so the depth clause is reached exactly
    ;; when the frequency clause has already passed
    (=
      (opt.opt-inline-checked-depth-relaxed-frequency)
      (opt.opt-inline-checked-min-frequency))))

(define (opt-inline-pos-return-literal) : ir.CompilerIrInstr
  (irt.instr "return 0"))

(define (opt-inline-pos-branch-at [yes : i64] [no : i64]) : ir.CompilerIrInstr
  (Branch (Var 0) yes no))

(define (opt-inline-pos-branch [yes : String] [no : String]) : ir.CompilerIrInstr
  (opt-inline-pos-branch-at
    (ir.compiler-ir-label (& yes))
    (ir.compiler-ir-label (& no))))

;; An entry branch, the arm the site sits in, and one sibling block per shape
;; the arm reading has to tell apart.
(define (opt-inline-pos-arm-blocks
  [work-instrs : ir.CompilerIrInstrSeq]
  [sibling : i64]
  [sibling-instrs : ir.CompilerIrInstrSeq]
  [tail-blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    tail-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-inline-pos-branch-at (ir.compiler-ir-label "arm_work") sibling)))
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "arm_work") work-instrs)
    (ir.CompilerIrBlock.Block sibling sibling-instrs)))

(define (opt-inline-pos-post-arm-blocks [tail-blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    tail-blocks
    (irt.block "entry:
         branch %0, pm_a, pm_b")
    (irt.block "pm_a:
           jump pm_check")
    (irt.block "pm_b:
             jump pm_check")
    (irt.block "pm_check:
               branch %0, arm_work, arm_bail")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "arm_work")
      (opt-inline-pos-arm-work-instrs))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "arm_bail")
      (opt-test-instrs (opt-inline-pos-return-literal)))))

(define (opt-inline-pos-arm-work-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%1 = call pos_leaf() : i64
     return %1"))

;; The same arm carrying a second call of its own, which is the call the caller
;; clause counts against the site.
(define (opt-inline-pos-arm-work-two-calls) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = call pos_leaf() : i64
     %2 = call pos_other() : i64
     return %2"))

;; INL-9's shape: a DISPATCH. `entry` and `d_spine` are the spine -- call-free
;; blocks that only compare and branch -- and `d_arm1`, `d_arm2`, `d_arm3` are
;; the three cases hanging off it. Only `d_arm1` is a successor of the entry
;; branch, which is why the arm reading above sees one arm of a three-arm
;; dispatch and the census reports `none` for the other two.
(define (opt-inline-pos-dispatch-blocks [spine-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "d_arm2:
             %2 = call pos_other() : i64
             return %2
           d_arm3:
             %3 = call pos_leaf() : i64
             return %3")
    (irt.block "entry:
         branch %0, d_arm1, d_spine")
    (irt.block
      "d_arm1:
           %1 = call pos_leaf() : i64
           return %1")
    (ir.CompilerIrBlock.Block (ir.compiler-ir-label "d_spine") spine-instrs)))

;; The spine block as a dispatch has it -- a compare and a branch -- and the
;; same block given a call of its own, which is what stops it being a spine at
;; all: reaching the arms below it is then not free, and the arms are no longer
;; one case each of a selector.
(define (opt-inline-pos-dispatch-spine-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs (opt-inline-pos-branch "d_arm2" "d_arm3")))

(define (opt-inline-pos-dispatch-working-spine-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%4 = call pos_other() : i64
     branch %0, d_arm2, d_arm3"))

(define (opt-inline-pos-blocks [mode : i64]) : ir.CompilerIrBlockList
  (cond
    ;; 0: the merge block post-dominates the entry, and the site's own call is
    ;; the only call the caller carries
    [(= mode 0)
      (irt.blocks
        "entry:
           branch %0, pos_hit, pos_miss
         pos_hit:
           %1 = mov 1 : i64
           jump pos_merge
         pos_miss:
           %2 = mov 2 : i64
           jump pos_merge
         pos_merge:
           %3 = call pos_leaf() : i64
           return %3")]
    ;; 1: the same merge block in a caller with two more calls of its own
    [(= mode 1)
      (irt.blocks
        "entry:
           %4 = call pos_other() : i64
           %5 = call pos_other() : i64
           branch %0, pos_hit, pos_miss
         pos_hit:
           %1 = mov 1 : i64
           jump pos_merge
         pos_miss:
           %2 = mov 2 : i64
           jump pos_merge
         pos_merge:
           %3 = call pos_leaf() : i64
           return %3")]
    ;; 2: the sibling arm returns a literal
    [(= mode 2)
      (opt-inline-pos-arm-blocks
        (opt-inline-pos-arm-work-instrs)
        (ir.compiler-ir-label "arm_bail")
        (opt-test-instrs (opt-inline-pos-return-literal))
        (ir.compiler-ir-block-list-empty))]
    ;; 3: the sibling arm is itself a direct tail call, so the caller is allowed
    ;; the two calls the two arms between them make
    [(= mode 3)
      (opt-inline-pos-arm-blocks
        (opt-inline-pos-arm-work-instrs)
        (ir.compiler-ir-label "arm_tail")
        (irt.instrs "tailcall pos_other() : i64")
        (ir.compiler-ir-block-list-empty))]
    ;; 4: ...and one call past that pair is one too many
    [(= mode 4)
      (opt-inline-pos-arm-blocks
        (opt-inline-pos-arm-work-two-calls)
        (ir.compiler-ir-label "arm_tail")
        (irt.instrs "tailcall pos_other() : i64")
        (ir.compiler-ir-block-list-empty))]
    ;; 5: the sibling arm carries a loop, so the two arms do not run the caller
    ;; out between them and the site is not credited a whole boundary
    [(= mode 5)
      (opt-inline-pos-arm-blocks
        (opt-inline-pos-arm-work-instrs)
        (ir.compiler-ir-label "arm_loop")
        (opt-test-instrs (opt-inline-pos-branch "arm_loop" "arm_done"))
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "arm_done")
            (opt-test-instrs (opt-inline-pos-return-literal)))))]
    ;; 6: the sibling arm jumps to a block that returns a literal, which is the
    ;; one indirection the arm reading follows
    [(= mode 6)
      (opt-inline-pos-arm-blocks
        (opt-inline-pos-arm-work-instrs)
        (ir.compiler-ir-label "arm_jump")
        (irt.instrs "jump arm_lit")
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "arm_lit")
            (opt-test-instrs (opt-inline-pos-return-literal)))))]
    ;; 7: the same two arms, with the site's arm carrying a second call and the
    ;; sibling returning rather than tail-calling: the extra allowance is the
    ;; tail call's alone
    [(= mode 7)
      (opt-inline-pos-arm-blocks
        (opt-inline-pos-arm-work-two-calls)
        (ir.compiler-ir-label "arm_bail")
        (opt-test-instrs (opt-inline-pos-return-literal))
        (ir.compiler-ir-block-list-empty))]
    ;; 9: mode 1's caller -- the post merge, two extra calls -- given a LOOP of
    ;; its own below the site. The merge still post-dominates the entry, and the
    ;; caller's plan cost is no longer a per-invocation number, so INL-8's
    ;; POST reading stands down and the count refuses the site.
    [(= mode 9)
      (irt.blocks
        "entry:
           %4 = call pos_other() : i64
           %5 = call pos_other() : i64
           branch %0, pos_hit, pos_miss
         pos_hit:
           jump pos_merge
         pos_miss:
           jump pos_merge
         pos_merge:
           %3 = call pos_leaf() : i64
           jump pos_loop
         pos_loop:
           branch %0, pos_loop, pos_done
         pos_done:
           return %3")]
    ;; 10: a three-arm DISPATCH. The spine is call-free, so every arm is one
    ;; case of a selector that runs exactly one of them per invocation.
    [(= mode 10)
      (opt-inline-pos-dispatch-blocks (opt-inline-pos-dispatch-spine-instrs))]
    ;; 11: the same dispatch with a CALL in the spine block. Reaching the two
    ;; arms below it is no longer free, so the spine stops there and neither of
    ;; them is a dispatch arm.
    [(= mode 11)
      (opt-inline-pos-dispatch-blocks
        (opt-inline-pos-dispatch-working-spine-instrs))]
    ;; INL-20b: the site's arm hangs off a branch BELOW the entry that post-dominates
    ;; it -- entry -> {pm_a, pm_b} -> pm_check -> {arm_work, arm_bail}. The entry
    ;; reading sees no arm (the entry's arms are pm_a and pm_b), the post reading
    ;; sees no post-dominator (arm_bail leaves without arm_work), and the spine
    ;; reading ends at the merge; the branch pm_check post-dominates the entry
    ;; and its sibling arm returns a literal, which is the arm reading stated
    ;; off pm_check instead of the entry. This is `sccp-state-bind` after its
    ;; first two keeps: `sccp-env-set-in!` in the else arm of the value-equality
    ;; branch below the inlined lookup and join.
    [(= mode 12)
      (opt-inline-pos-post-arm-blocks (ir.compiler-ir-block-list-empty))]
    ;; 13: the same shape with a second way into the site's arm -- pm_a jumps
    ;; straight to arm_work -- so arm_work is a merge, no arm of anything, and
    ;; the reading refuses it.
    [(= mode 13)
      (ir.compiler-ir-blocks
        (irt.block "entry:
             branch %0, pm_a, pm_b")
        (irt.block "pm_a:
               jump arm_work")
        (irt.block "pm_b:
                 jump pm_check")
        (irt.block "pm_check:
                   branch %0, arm_work, arm_bail")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "arm_work")
          (opt-inline-pos-arm-work-instrs))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "arm_bail")
          (opt-test-instrs (opt-inline-pos-return-literal))))]
    ;; SW-SPINE 16: the `(or a b)` shape -- entry -> {j_a, j_b} -> j_merge,
    ;; jump blocks feeding a phi merge that is the selecting branch, with a
    ;; two-level chain below it. This is `sccp-normalize-const` at the point
    ;; the tier looks: no reading before the widening reaches `j_arm3`.
    [(= mode 16)
      (irt.blocks
        "entry:
           branch %0, j_a, j_b
         j_a:
           jump j_merge
         j_b:
           jump j_merge
         j_merge:
           branch %0, j_arm1, j_spine
         j_arm1:
           %1 = call pos_leaf() : i64
           return %1
         j_spine:
           branch %0, j_arm2, j_arm3
         j_arm2:
           %2 = call pos_other() : i64
           return %2
         j_arm3:
           %3 = call pos_leaf() : i64
           return %3")]
    ;; SW-SPINE 14: the dispatch as one `switch`; 15: the same switch block
    ;; with a call of its own, which is no spine.
    [(= mode 14)
      (irt.blocks
        "entry:
           switch %0 base 0 [0:s_arm1, 1:s_arm2] default s_arm3
         s_arm1:
           %1 = call pos_leaf() : i64
           return %1
         s_arm2:
           %2 = call pos_other() : i64
           return %2
         s_arm3:
           %3 = call pos_leaf() : i64
           return %3")]
    [(= mode 15)
      (irt.blocks
        "entry:
           %4 = call pos_other() : i64
           switch %0 base 0 [0:s_arm1, 1:s_arm2] default s_arm3
         s_arm1:
           %1 = call pos_leaf() : i64
           return %1
         s_arm2:
           %2 = call pos_other() : i64
           return %2
         s_arm3:
           %3 = call pos_leaf() : i64
           return %3")]
    ;; 8: NEITHER. One arm returns, so the merge below the other does not
    ;; post-dominate the entry, and the merge is no arm of the entry branch.
    [else
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks
          "nb_join:
                 %1 = call pos_leaf() : i64
                 return %1")
        (irt.block "entry:
             branch %0, nb_hit, nb_miss")
        (irt.block "nb_hit:
               jump nb_join")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "nb_miss")
          (opt-test-instrs (opt-inline-pos-return-literal))))]))

;; The shape as a function, so the caller facts the clause reads -- the natural
;; loop set and the self-recursion flag -- can be installed for it. INL-8's
;; reading of the post class is a caller FACT rather than a property of the
;; block list, so a fixture that asked the class without installing them would
;; be asking about whichever caller the walk installed last.
(define (opt-inline-pos-caller-name) : i64
  (opt-test-symbol "pos_caller"))

(define (opt-inline-pos-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-inline-pos-caller-name)
    (opt-inline-switch-params)
    (I64)
    8
    blocks
    Ordinary))

(define (opt-inline-pos-install! [blocks : ir.CompilerIrBlockList]) : unit
  (let
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-pos-function (opt.compiler-opt-global-shared-view blocks)))
        (& (ir.compiler-ir-function-seq-empty)))]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [census : opt.OptInlineCensus
      (opt.opt-inline-census-build index (& functions))]
    (opt.opt-inline-caller-facts-install!
      index
      census
      (opt-inline-pos-caller-name)
      blocks)))

;; The position class the checked inliner gives the site labelled `name`.
(define (opt-inline-pos-site [mode : i64] [position : i64] [name : String]) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-inline-pos-blocks mode)]
    [_install : unit
      (opt-inline-pos-install! (opt.compiler-opt-global-shared-view blocks))]
    (opt.opt-inline-checked-position-class
      (& blocks)
      position
      (ir.compiler-ir-label (& name)))))

;; The floor as the depth clause reads it: entry-equivalent and call-free at one
;; census weight stands it down to zero, and anything else leaves it standing.
(define (opt-inline-pos-floor [pos : i64]) : i64
  (opt.opt-inline-checked-effective-min-site-depth
    (opt.opt-inline-checked-depth-relaxed-frequency)
    (opt.opt-inline-checked-entry-equivalent? pos)
    true))

(define (compiler-optimize-inline-checked-entry-equivalent-ok?) : bool
  (and
    ;; POST: a merge block every path out of the entry runs, in a caller whose
    ;; only call is the site's own -- and the floor stands down for it
    (= (opt-inline-pos-site 0 3 "pos_merge") (opt.opt-inline-checked-pos-post))
    (= (opt-inline-pos-floor (opt.opt-inline-checked-pos-post)) 0)
    ;; ...the SAME block in a caller carrying two more calls of its own. The
    ;; count refuses it -- it is no wrapper -- and INL-8 admits it anyway,
    ;; because a post block runs once per invocation and a LOOP-FREE caller's
    ;; plan cost is the per-invocation number the boundary is credited against.
    ;; This is the shape of `cg-map-probe` into `cg-map-insert-ref!`.
    (not
      (opt.opt-inline-checked-wrapper-shaped?
        (& (opt-inline-pos-blocks 1))
        (opt.opt-inline-checked-pos-post)))
    (= (opt-inline-pos-site 1 3 "pos_merge") (opt.opt-inline-checked-pos-post))
    ;; ...and the same caller given a loop of its own is refused again: the
    ;; plan charges its loop body eight times per invocation, so the boundary
    ;; this site retires is not in the currency the verdict compares. The floor
    ;; then stands, and `site-depth` is the clause the census reports.
    (= (opt-inline-pos-site 9 3 "pos_merge") (opt.opt-inline-checked-pos-none))
    (=
      (opt-inline-pos-floor (opt.opt-inline-checked-pos-none))
      (opt.opt-inline-checked-min-site-depth))
    (string.eq
      (opt.opt-inline-checked-clause-text
        (opt.opt-inline-checked-clause-site-depth))
      "site-depth")
    ;; ARM: the sibling arm returns a literal, so the two arms run the caller
    ;; out between them
    (= (opt-inline-pos-site 2 1 "arm_work") (opt.opt-inline-checked-pos-arm))
    ;; ...the sibling arm is itself a direct tail call: the caller is allowed
    ;; the two calls the two arms make between them
    (= (opt-inline-pos-site 3 1 "arm_work") (opt.opt-inline-checked-pos-arm))
    ;; ...and one call past that pair is one too many. The ARM reading keeps the
    ;; count that INL-8 stood down for POST: an arm block runs on some fraction
    ;; of invocations and is credited a whole boundary anyway, which is sound
    ;; only while the caller holds no call this site does not account for.
    (= (opt-inline-pos-site 4 1 "arm_work") (opt.opt-inline-checked-pos-none))
    ;; ...and INL-9's dispatch reading may NOT take it back. This is the
    ;; lex_source shape -- `ls-number-float?`, a small band-absorbable caller
    ;; whose two arm sites the count refuses -- and its entry block is a
    ;; call-free branch, so the spine reading would answer YES for it. What
    ;; keeps it refused is the ORDER: opt-inline-checked-widened-class asks post,
    ;; then arm, then dispatch, and a block the ARM reading classifies never
    ;; reaches the dispatch one. The two facts, stated separately, are the whole
    ;; separation between `ls-number-float?` and a dispatch caller.
    (let
      [blocks (opt-inline-pos-blocks 4)]
      (opt.opt-inline-checked-arm-site?
        blocks
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-label "arm_work")))
    (opt.opt-inline-checked-dispatch-arm-site?
      (& (opt-inline-pos-blocks 4))
      (ir.compiler-ir-label "entry")
      (ir.compiler-ir-label "arm_work"))
    ;; ...the second call is the TAIL CALL's allowance alone: the same two calls
    ;; under a sibling that returns are refused
    (= (opt-inline-pos-site 7 1 "arm_work") (opt.opt-inline-checked-pos-none))
    ;; ...a sibling arm carrying a loop is not an exit, so the ARM reading
    ;; refuses the site: the pair does not run the caller out between them.
    ;; INL-9's dispatch reading answers about the same block on different
    ;; grounds and takes it -- the entry block is a call-free branch, so it is a
    ;; one-block spine that selects one of its two successors, and the site runs
    ;; at most once per invocation whatever the sibling then does. The clause
    ;; that gates it is the callee's, not the caller's, and the corpus is
    ;; byte-identical either way (see opt-inline-checked-dispatch-callee-ok?).
    (=
      (opt-inline-pos-site 5 1 "arm_work")
      (opt.opt-inline-checked-pos-dispatch))
    ;; ...and the one indirection the arm reading follows: a sibling that jumps
    ;; to a block returning a literal
    (= (opt-inline-pos-site 6 1 "arm_work") (opt.opt-inline-checked-pos-arm))
    ;; INL-20b: the arm of a branch BELOW the entry that post-dominates it.
    ;; The entry's own arms are the two jumps into the merge, so the entry
    ;; reading has no arm to see; the branch below the merge runs once per
    ;; invocation and its sibling returns a literal, and the reading is the
    ;; arm reading stated off that branch. The count clause still holds: the
    ;; caller's one call is the site's.
    (= (opt-inline-pos-site 12 4 "arm_work") (opt.opt-inline-checked-pos-arm))
    (opt.opt-inline-checked-post-arm-site?
      (& (opt-inline-pos-blocks 12))
      (ir.compiler-ir-label "entry")
      (ir.compiler-ir-label "arm_work"))
    ;; ...and the branch itself, or a block with a second way in, is no arm:
    ;; pm_check post-dominates the entry (it reads POST), and arm_work with a
    ;; jump from pm_a into it is a merge the post-arm reading refuses. SW-SPINE:
    ;; the dispatch walk, asked after it, now reaches arm_work through pm_a's
    ;; jump and through pm_check's branch -- every block on both paths is
    ;; call-free and only routes, and arm_work runs at most once per
    ;; invocation -- so the site reads DISPATCH, and the verdict prices it.
    (= (opt-inline-pos-site 12 3 "pm_check") (opt.opt-inline-checked-pos-post))
    (not
      (opt.opt-inline-checked-post-arm-site?
        (& (opt-inline-pos-blocks 13))
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-label "arm_work")))
    (=
      (opt-inline-pos-site 13 4 "arm_work")
      (opt.opt-inline-checked-pos-dispatch))
    ;; A merge below an arm that returns post-dominates nothing and is no arm
    ;; of the entry branch, so the post and arm readings leave the floor
    ;; standing. SW-SPINE: it is the second case of a two-way selector whose
    ;; first case leaves -- the entry branches to nb_hit, which returns, or
    ;; into nb_join through a call-free jump block -- and the dispatch walk
    ;; reads it so; the caller here is wrapper-shaped, so the site's position
    ;; is the whole question.
    (=
      (opt-inline-pos-site 8 3 "nb_join")
      (opt.opt-inline-checked-pos-dispatch))
    ;; DISPATCH: a three-arm selector whose spine only compares and branches.
    ;; The FIRST arm is a successor of the entry branch and the arm reading
    ;; still refuses it -- its sibling is the rest of the chain, which works --
    ;; and the two below it are not entry-adjacent at all. All three are one
    ;; case each of a selector that runs exactly one of them per invocation, and
    ;; the caller carries three calls, which is one per arm and hopeless for the
    ;; count clause by construction.
    (=
      (opt-inline-pos-site 10 1 "d_arm1")
      (opt.opt-inline-checked-pos-dispatch))
    (=
      (opt-inline-pos-site 10 4 "d_arm3")
      (opt.opt-inline-checked-pos-dispatch))
    (= (opt-inline-pos-floor (opt.opt-inline-checked-pos-dispatch)) 0)
    (not
      (opt.opt-inline-checked-wrapper-shaped?
        (& (opt-inline-pos-blocks 10))
        (opt.opt-inline-checked-pos-dispatch)))
    ;; ...and a spine block that CALLS is no spine: the arms below it stop being
    ;; free to reach, and the floor stands for both of them.
    (= (opt-inline-pos-site 11 4 "d_arm3") (opt.opt-inline-checked-pos-none))
    (= (opt-inline-pos-site 11 3 "d_arm2") (opt.opt-inline-checked-pos-none))
    ;; SW-SPINE: the selector spelled as the `switch` the cond lowering emits
    ;; for literal compares on one value (`sccp-normalize-const`'s class
    ;; dispatch). Every case target and the default is an arm; the arm reading
    ;; has no branch to read; and a call in the switch block unmakes the spine
    ;; exactly as it does the branch one.
    (=
      (opt-inline-pos-site 14 1 "s_arm1")
      (opt.opt-inline-checked-pos-dispatch))
    (=
      (opt-inline-pos-site 14 2 "s_arm2")
      (opt.opt-inline-checked-pos-dispatch))
    (=
      (opt-inline-pos-site 14 3 "s_arm3")
      (opt.opt-inline-checked-pos-dispatch))
    (not
      (let
        [blocks (opt-inline-pos-blocks 14)]
        (opt.opt-inline-checked-arm-site?
          blocks
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-label "s_arm1"))))
    (= (opt-inline-pos-site 15 1 "s_arm1") (opt.opt-inline-checked-pos-none))
    (= (opt-inline-pos-site 15 3 "s_arm3") (opt.opt-inline-checked-pos-none))
    ;; ...and the `(or a b)` spelling: jump blocks feeding the phi merge that
    ;; selects are walked through, so the arms below the merge are dispatch
    ;; arms -- the first of them is what the post-arm reading refuses (its
    ;; sibling works on), and the two below that are not entry-adjacent at all.
    (=
      (opt-inline-pos-site 16 4 "j_arm1")
      (opt.opt-inline-checked-pos-dispatch))
    (=
      (opt-inline-pos-site 16 6 "j_arm2")
      (opt.opt-inline-checked-pos-dispatch))
    (=
      (opt-inline-pos-site 16 7 "j_arm3")
      (opt.opt-inline-checked-pos-dispatch))
    ;; THE DISPATCH ARM'S OWN CLAUSE is on the CALLEE and it is acyclicity: an
    ;; imported loop is paid at every entry while the arm runs on a fraction of
    ;; them.
    (let
      [blocks (opt-inline-pos-blocks 10)]
      (opt.opt-inline-checked-dispatch-callee-ok? blocks))
    (not
      (let
        [blocks (opt-inline-pos-blocks 5)]
        (opt.opt-inline-checked-dispatch-callee-ok? blocks)))
    ;; THE TRUE ENTRY SITE is untouched by the caller clause: the caller of
    ;; shape 1 carries three calls and its entry block is still entry-equivalent
    (= (opt-inline-pos-site 1 0 "entry") (opt.opt-inline-checked-pos-entry))
    (= (opt-inline-pos-floor (opt.opt-inline-checked-pos-entry)) 0)
    ;; the trace names each reading, and `none` is what a refused site reports
    (string.eq
      (opt.opt-inline-checked-pos-text (opt.opt-inline-checked-pos-entry))
      "entry")
    (string.eq
      (opt.opt-inline-checked-pos-text (opt.opt-inline-checked-pos-post))
      "post")
    (string.eq
      (opt.opt-inline-checked-pos-text (opt.opt-inline-checked-pos-arm))
      "arm")
    (string.eq
      (opt.opt-inline-checked-pos-text (opt.opt-inline-checked-pos-dispatch))
      "dispatch")
    ;; the verdict line names the SIDE of the two-sided window it fell on, which
    ;; is what INL-9's first question turned on: `ssa-dominates?` into
    ;; `ssa-dominance-frontier`, a modelled saving of 1034 against a boundary
    ;; of 512, was `cap` under the 2x bound and is `in` under the 2.5x one
    ;; (INL-17d); one past two and a half boundaries is `cap`.
    (string.eq (opt.opt-inline-checked-window-text 1034 512) "in")
    (string.eq (opt.opt-inline-checked-window-text 1281 512) "cap")
    (string.eq (opt.opt-inline-checked-window-text 104 64) "in")
    (string.eq (opt.opt-inline-checked-window-text (- 0 69) 64) "floor")
    (string.eq
      (opt.opt-inline-checked-pos-text (opt.opt-inline-checked-pos-none))
      "none")))

;; The recorded loser's own shape: a SEVEN-parameter builder with a loop of its
;; own, call-free and bounds-free, at a straight-line site. Seven parameters is
;; what makes the boundary 13 -- the number the `cfg-build-csr` autopsy records
;; against a modelled saving of 23 -- and a builder large enough to have its own
;; loop is what makes the merge something the plan has to price rather than
;; something it can wave through.
(define (opt-inline-checked-builder-arity) : i64
  7)

(define (opt-inline-checked-builder-pad) : i64
  20)

(define (opt-inline-checked-builder-params-from [index : i64] [count : i64]) : ir.CompilerIrParamSeq
  (if (>= index count)
    (ir.compiler-ir-param-seq-empty)
    (ir.compiler-ir-param-seq-prepend
      (Param "builder" (I64) index)
      (opt-inline-checked-builder-params-from (+ index 1) count))))

;; The parameter each padding add reads: every one of the seven, then the second
;; again, so all of them stay live to the end of the body.
(define (opt-inline-checked-builder-param [index : i64]) : i64
  (if (< index (opt-inline-checked-builder-arity))
    index
    1))

(define (opt-inline-checked-builder-chain
  [index : i64]
  [count : i64]
  [acc-var : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (>= index count)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-checked-builder-chain (+ index 1) count (+ acc-var 1) tail)
      (ir.CompilerIrInstr.BinOp
        (+ acc-var 1)
        (Add)
        (Var acc-var)
        (Var (opt-inline-checked-builder-param index))
        (I64)))))

;; The chain's last definition: it starts at `arity + 1` and defines one var per
;; padding add, so the value the latch carries back is `arity + 1 + pad`. (It
;; read `arity + 2 + pad` -- one past the chain -- for as long as the tier
;; refused every site of this body: a phi input nothing defines is a use before
;; definition, which the self-tests only verify on the holder once the body is
;; cloned into it.)
(define (opt-inline-checked-builder-latch-var) : i64
  (+ (opt-inline-checked-builder-arity) (+ 1 (opt-inline-checked-builder-pad))))

(define (opt-inline-checked-builder-function [name : i64]) : ir.CompilerIrFunction
  (let
    [arity : i64 (opt-inline-checked-builder-arity)]
    (Function
      name
      (opt-inline-checked-builder-params-from 0 arity)
      (I64)
      (+ (opt-inline-checked-builder-latch-var) 1)
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks "done:
                 return %8")
        (irt.block
          "entry:
             %7 = mov 0 : i64
             jump header")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "header")
          (opt-test-instrs
            (ir.CompilerIrInstr.Phi
              (+ arity 1)
              (ir.compiler-ir-phi-input-seq-prepend
                (Var arity)
                (ir.compiler-ir-label "entry")
                (&
                  (ir.compiler-ir-phi-input-seq-prepend
                    (Var (opt-inline-checked-builder-latch-var))
                    (ir.compiler-ir-label "body")
                    (& (ir.compiler-ir-phi-input-seq-empty)))))
              (I64))
            (irt.instr "branch %0, body, done")))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-inline-checked-builder-chain
            0
            (opt-inline-checked-builder-pad)
            (+ arity 1)
            (irt.instrs "jump header"))))
      Ordinary)))

(define (opt-inline-checked-builder-args!
  [args : (&mut args (__tl_dyn-array ir.CompilerIrValue))]
  [index : i64]
  [count : i64]) : unit
  (unless
    (>= index count)
    (set!
      (array-ref args index)
      (ir.CompilerIrValue.Var
        (if (< index 3)
          index
          2)))
    (opt-inline-checked-builder-args! args (+ index 1) count)))

(define (opt-inline-checked-builder-call [callee-name : i64] [dst : i64]) : ir.CompilerIrInstr
  (let
    [count : i64 (opt-inline-checked-builder-arity)]
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue count)]
    (opt-inline-checked-builder-args! (&mut args) 0 count)
    (Call dst callee-name (Array args) (I64))))

;; --- INL-9: the arms of a DISPATCH, and the clause that is on the callee -----
;;
;; The shape `sccp-value`, `sccp-immediate` and `sccp-fold-compare` have: a
;; caller whose whole body is a selector over a tag, every arm of which calls
;; one helper. The call COUNT is hopeless here by
;; construction -- there is one call per arm -- and the ARM reading sees only
;; the first arm, because only the first arm is a successor of the entry branch.
;;
;; The two modes differ in ONE thing: the leaf's own shape. Mode 0's leaf is
;; ACYCLIC and its arms are measured and kept; mode 1's is the same leaf with a
;; loop around its chain, and the dispatch reading refuses it before any pricing
;; -- `site-depth` with `pos` reading `none` -- because a loop imported into an
;; arm is paid at every entry while the arm runs on a fraction of them. Both
;; leaves are call-free, both take seven parameters, and both are past the
;; shared-accessor band's 28 and the hot-loop-leaf band's 120, so no band is
;; offered either of them and what the numbers report is this tier alone.
(define (opt-inline-inl9-leaf-pad) : i64
  130)

(define (opt-inline-inl9-leaf-acc) : i64
  (+ (opt-inline-checked-builder-arity) (opt-inline-inl9-leaf-pad)))

;; The straight-line leaf: seven parameters folded into an accumulator and
;; returned. No branch at all, so nothing about it is cyclic.
(define (opt-inline-inl9-leaf-function [name : i64]) : ir.CompilerIrFunction
  (let
    [arity : i64 (opt-inline-checked-builder-arity)]
    (Function
      name
      (opt-inline-checked-builder-params-from 0 arity)
      (I64)
      (+ (opt-inline-inl9-leaf-acc) 1)
      (ir.compiler-ir-blocks
        (irt.block
          "entry:
             %7 = mov 0 : i64
             jump body")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-inline-checked-builder-chain
            0
            (opt-inline-inl9-leaf-pad)
            arity
            (opt-test-instrs
              (ir.CompilerIrInstr.Return
                (Some (Var (opt-inline-inl9-leaf-acc))))))))
      Ordinary)))

;; ...and the same chain with a loop around it. Same arity, same instructions,
;; same call-freedom: the ONE difference is the back edge, which is the clause.
(define (opt-inline-inl9-cyclic-leaf-function [name : i64]) : ir.CompilerIrFunction
  (let
    [arity : i64 (opt-inline-checked-builder-arity)]
    [last : i64 (+ (opt-inline-inl9-leaf-acc) 1)]
    (Function
      name
      (opt-inline-checked-builder-params-from 0 arity)
      (I64)
      (+ last 1)
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks "done:
                 return %8")
        (irt.block
          "entry:
             %7 = mov 0 : i64
             jump header")
        (irt.block
          "header:
               %8 = phi [%7, entry], [%138, body] : i64
               branch %0, body, done")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-inline-checked-builder-chain
            0
            (opt-inline-inl9-leaf-pad)
            (+ arity 1)
            (irt.instrs "jump header"))))
      Ordinary)))

;; The dispatch: `entry` and `d_spine` compare and branch and do nothing else,
;; and the three arms below them each call the leaf once. Only `d_arm1` is a
;; successor of the entry branch.
(define (opt-inline-inl9-dispatch-function [func-name : i64] [leaf-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    8
    (ir.compiler-ir-blocks
      (irt.block "entry:
           branch %0, d_arm1, d_spine")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "d_arm1")
        (opt-test-instrs
          (opt-inline-checked-builder-call leaf-name 3)
          (irt.instr "return %3")))
      (irt.block "d_spine:
               branch %1, d_arm2, d_arm3")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "d_arm2")
        (opt-test-instrs
          (opt-inline-checked-builder-call leaf-name 4)
          (irt.instr "return %4")))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "d_arm3")
        (opt-test-instrs
          (opt-inline-checked-builder-call leaf-name 5)
          (irt.instr "return %5"))))
    Ordinary))

(define (opt-inline-inl9-leaf-name) : i64
  (opt-test-symbol "inl9_leaf"))

(define (opt-inline-inl9-dispatch-name) : i64
  (opt-test-symbol "inl9_dispatch"))

;; 1000 * verdicts spent + calls to the leaf left in the dispatch, so a change
;; in either reads straight off the number.
(define (opt-inline-checked-inl9-self-test [mode : i64]) : i64
  (let
    [leaf-name : i64 (opt-inline-inl9-leaf-name)]
    [cyclic? : bool (= mode 1)]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (&
            (irt.func
              "function @inl9_driver(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 7 {
             entry:
               %3 = mov 0 : i64
               jump header
             header:
               %4 = phi [%3, entry], [%6, latch] : i64
               branch %0, body, exit
             body:
               %6 = call inl9_dispatch(%1, %0, %2) : i64
               jump latch
             latch:
               jump header
             exit:
               return %4
             }"))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-inl9-dispatch-function
                  (opt-inline-inl9-dispatch-name)
                  leaf-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (if cyclic?
                      (opt-inline-inl9-cyclic-leaf-function leaf-name)
                      (opt-inline-inl9-leaf-function leaf-name)))
                  (& (ir.compiler-ir-function-seq-empty)))))))
        2)]
    [spent : i64
      (+
        (-
          (opt.opt-inline-checked-program-budget)
          (opt.opt-inline-checked-budget-current))
        (-
          (opt.opt-inline-checked-relaxed-program-budget)
          (opt.opt-inline-checked-relaxed-budget-current)))]
    [dispatch-calls : i64
      (opt-count-direct-call-name-function-seq
        optimized
        "inl9_dispatch"
        "inl9_leaf")]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? optimized "inl9_driver")
        (opt-inline-mb2-main-verified? optimized "inl9_dispatch")
        (opt-inline-mb2-main-verified? optimized "inl9_leaf"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 1000 spent) dispatch-calls)
      (- 0 1))))

(define (opt-inline-inl8-holder-tail [loop? : bool]) : ir.CompilerIrBlockList
  (if loop?
    (irt.blocks
      "i8_loop:
         branch %0, i8_loop, i8_done
       i8_done:
         return %5")
    (ir.compiler-ir-block-list-empty)))

(define (opt-inline-inl8-holder-function
  [func-name : i64]
  [callee-name : i64]
  [helper-name : i64]
  [loop? : bool]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (ir.compiler-ir-blocks-with-tail
      (opt-inline-inl8-holder-tail loop?)
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-loop-site-call helper-name 3)
          (opt-inline-loop-site-call helper-name 4)
          (irt.instr "branch %0, i8_hit, i8_miss")))
      (irt.block "i8_hit:
             jump i8_merge")
      (irt.block "i8_miss:
               jump i8_merge")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "i8_merge")
        (opt-test-instrs
          (opt-inline-loop-site-call callee-name 5)
          (if loop?
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "i8_loop"))
            (irt.instr "return %5")))))
    Ordinary))

;; 1000 * verdicts spent + 10 * calls left in the holder + calls left in the
;; wrapper, so a change in any of the three reads straight off the number.
;; Its own four symbols: the fixture's leaf is a different body from every other
;; fixture's, and sharing a name with one of them would let whichever ran first
;; decide what the other measured.
(define (opt-inline-inl8-leaf-name) : i64
  (opt-test-symbol "inl8_leaf"))

(define (opt-inline-inl8-holder-name) : i64
  (opt-test-symbol "inl8_holder"))

(define (opt-inline-checked-inl8-self-test [mode : i64]) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 (opt-inline-inl8-leaf-name)]
    [loop? : bool (= mode 1)]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (&
            (irt.func
              "function @inl8_driver(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 7 {
             entry:
               %3 = mov 0 : i64
               jump header
             header:
               %4 = phi [%3, entry], [%6, latch] : i64
               branch %0, body, exit
             body:
               %5 = call inl8_wrapper(%1, %0, %2) : i64
               %6 = call inl8_holder(%1, %0, %2) : i64
               jump latch
             latch:
               jump header
             exit:
               return %4
             }"))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (irt.func
                  "function @inl8_wrapper(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 4 {
               entry:
                 %3 = call inl8_leaf(%1, %0, %2) : i64
                 return %3
               }"))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (&
                    (opt-inline-inl8-holder-function
                      (opt-inline-inl8-holder-name)
                      callee-name
                      symbols.external-predicate
                      loop?))
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (& (opt-inline-dup-leaf-plain callee-name))
                      (& (ir.compiler-ir-function-seq-empty)))))))))
        2)]
    [spent : i64
      (+
        (-
          (opt.opt-inline-checked-program-budget)
          (opt.opt-inline-checked-budget-current))
        (-
          (opt.opt-inline-checked-relaxed-program-budget)
          (opt.opt-inline-checked-relaxed-budget-current)))]
    [holder-calls : i64
      (opt-count-direct-call-name-function-seq
        optimized
        "inl8_holder"
        "inl8_leaf")]
    [wrapper-calls : i64
      (opt-count-direct-call-name-function-seq
        optimized
        "inl8_wrapper"
        "inl8_leaf")]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? optimized "inl8_driver")
        (opt-inline-mb2-main-verified? optimized "inl8_holder")
        (opt-inline-mb2-main-verified? optimized "inl8_wrapper")
        (opt-inline-mb2-main-verified? optimized "inl8_leaf"))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 1000 spent) (+ (* 10 holder-calls) wrapper-calls))
      (- 0 1))))

;; A DEPTH-0 site in a caller that holds its own hot loop: the shape of
;; `cfg-build-csr` into `cfg-function` (a builder at a straight-line site of a
;; loop-holding caller) and of the interner's hash leaf at its depth-0 site.
;; `inline_nonleaf` calls the leaf from its ENTRY block and then runs a loop
;; that carries `live` values across itself -- the register pressure a
;; site-depth clause would stand in for, and the only thing that makes the site
;; worth measuring rather than refusing by shape.
;;
;; The carried values are derived from a parameter rather than from literals, so
;; the tier's own re-optimization cannot fold them away before it prices them.
(define (opt-inline-checked-live-defs
  [index : i64]
  [count : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (>= index count)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-checked-live-defs (+ index 1) count tail)
      (ir.CompilerIrInstr.BinOp
        (+ 6 index)
        (Add)
        (Var 1)
        (I64 (+ index 1))
        (I64)))))

(define (opt-inline-checked-live-uses
  [index : i64]
  [count : i64]
  [acc-var : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (>= index count)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-checked-live-uses (+ index 1) count (+ acc-var 1) tail)
      (ir.CompilerIrInstr.BinOp
        (+ acc-var 1)
        (Add)
        (Var acc-var)
        (Var (+ 6 index))
        (I64)))))

;; Values the caller keeps live across its own loop.
(define (opt-inline-checked-depth0-live) : i64
  20)

(define (opt-inline-checked-depth0-latch-var) : i64
  (+ 6 (* 2 (opt-inline-checked-depth0-live))))

;; The three spellings of the SAME site, which differ only in which block of the
;; caller the builder call sits in:
;;
;;   0 entry     the caller's entry block
;;   1 threaded  one unconditional jump further on, in a block every path out of
;;               the entry runs -- it POST-DOMINATES the entry, so INL-4 reads it
;;               as entry-equivalent in this wrapper-shaped caller
;;   2 guarded   a merge below a guard whose other arm RETURNS, which
;;               post-dominates nothing and is no arm of the entry branch: the
;;               floor stands exactly as it did before the widening
(define (opt-inline-checked-depth0-shape-entry) : i64
  0)

(define (opt-inline-checked-depth0-shape-threaded) : i64
  1)

(define (opt-inline-checked-depth0-shape-guarded) : i64
  2)

(define (opt-inline-checked-depth0-site-block [shape : i64]) : i64
  (if (= shape (opt-inline-checked-depth0-shape-entry))
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-label "setup")))

;; The loop half of the caller, shared by both spellings: the header whose phi
;; names the block the call sits in, the body that carries the live values
;; across the loop, the latch and the exit.
(define (opt-inline-checked-depth0-loop-blocks [shape : i64]) : ir.CompilerIrBlockList
  (let
    [live : i64 (opt-inline-checked-depth0-live)]
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "latch:
             jump header
           exit:
             return %4")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "header")
        (opt-test-instrs
          (ir.CompilerIrInstr.Phi
            4
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 3)
              (opt-inline-checked-depth0-site-block shape)
              (&
                (ir.compiler-ir-phi-input-seq-prepend
                  (Var (opt-inline-checked-depth0-latch-var))
                  (ir.compiler-ir-label "latch")
                  (& (ir.compiler-ir-phi-input-seq-empty)))))
            (I64))
          ;; `idx`, not `tag`: the builder's own loop exits only on a false
          ;; `tag`, so a header testing `tag` again would be decided dead below
          ;; the inlined body by the flag's own test, and the priced plan would
          ;; measure that fixture artifact instead of the site.
          (irt.instr "branch %1, body, exit")))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs-with-tail
          (opt-inline-checked-live-uses
            0
            live
            (+ 6 live)
            (irt.instrs "jump latch"))
          (ir.CompilerIrInstr.BinOp (+ 6 live) (Add) (Var 4) (Var 5) (I64)))))))

;; The block the builder call sits in, and nothing else, is what the three
;; shapes vary; the caller, its loop, its live set and the frequency are
;; identical across all three.
(define (opt-inline-checked-depth0-setup-instrs [callee-name : i64]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-inline-checked-builder-call callee-name 5)
    (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header"))))

(define (opt-inline-checked-depth0-entry-instrs
  [callee-name : i64]
  [shape : i64]) : ir.CompilerIrInstrSeq
  (let
    [live : i64 (opt-inline-checked-depth0-live)]
    (cond
      ;; the call itself, in the one block a caller runs exactly once
      [(= shape (opt-inline-checked-depth0-shape-entry))
        (opt-inline-checked-live-defs
          0
          live
          (opt-test-instrs
            (irt.instr "%3 = mov 0 : i64")
            (opt-inline-checked-builder-call callee-name 5)
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header"))))]
      ;; one unconditional jump on to the block that holds it
      [(= shape (opt-inline-checked-depth0-shape-threaded))
        (opt-inline-checked-live-defs
          0
          live
          (irt.instrs "%3 = mov 0 : i64
             jump setup"))]
      ;; ...or a guard whose other arm leaves the function, which is what makes
      ;; the block below it neither the entry's post-dominator nor its arm
      [else
        (opt-inline-checked-live-defs
          0
          live
          (irt.instrs
            "%3 = mov 0 : i64
             branch %0, guard_in, guard_out"))])))

(define (opt-inline-checked-depth0-caller-blocks
  [callee-name : i64]
  [shape : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (cond
      [(= shape (opt-inline-checked-depth0-shape-entry))
        (opt-inline-checked-depth0-loop-blocks shape)]
      [(= shape (opt-inline-checked-depth0-shape-threaded))
        (ir.compiler-ir-blocks-with-tail
          (opt-inline-checked-depth0-loop-blocks shape)
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "setup")
            (opt-inline-checked-depth0-setup-instrs callee-name)))]
      [else
        (ir.compiler-ir-blocks-with-tail
          (opt-inline-checked-depth0-loop-blocks shape)
          (irt.block "guard_in:
               jump setup")
          (irt.block "guard_out:
                 return 0")
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "setup")
            (opt-inline-checked-depth0-setup-instrs callee-name)))])
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-inline-checked-depth0-entry-instrs callee-name shape))))

(define (opt-inline-checked-depth0-caller-function
  [func-name : i64]
  [callee-name : i64]
  [shape : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    (+ (opt-inline-checked-depth0-latch-var) 1)
    (opt-inline-checked-depth0-caller-blocks callee-name shape)
    Ordinary))

;; One straight-line block calling the holder and the leaf once each. It is what
;; keeps both of them at two references, so no single-reference band can take
;; either one and the measured tier is the only door they have.
(define (opt-inline-checked-cold-pair-function
  [func-name : i64]
  [holder-name : i64]
  [leaf-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    5
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-loop-site-call holder-name 3)
          (opt-inline-checked-builder-call leaf-name 4)
          (irt.instr "return %4"))))
    Ordinary))

;; The same driver reaching the holder from inside a loop, which is the only
;; thing that differs between the two programs below: it multiplies the holder's
;; census reference count by one loop level, and that is what carries the
;; holder's straight-line leaf site over the composite-frequency floor.
(define (opt-inline-checked-hot-driver-function
  [func-name : i64]
  [holder-name : i64]) : ir.CompilerIrFunction
  (opt-inline-loop-site-function
    func-name
    holder-name
    (opt-inline-loop-site-entry-instrs)))

(define (opt-inline-checked-cold-driver-function
  [func-name : i64]
  [holder-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-loop-site-call holder-name 3)
          (irt.instr "return %3"))))
    Ordinary))

;; Modes 0 and 1 put the call in the entry block (cold driver, then hot); mode 2
;; threads it one jump on; mode 3 puts it below a returning guard.
(define (opt-inline-checked-depth0-shape-of [mode : i64]) : i64
  (cond
    [(= mode 2) (opt-inline-checked-depth0-shape-threaded)]
    [(= mode 3) (opt-inline-checked-depth0-shape-guarded)]
    [else (opt-inline-checked-depth0-shape-entry)]))

(define (opt-inline-checked-depth0-program
  [symbols : OptInlineMultiTestSymbols]
  [mode : i64]) : ir.CompilerIrFunctionSeq
  (let
    [holder-name : i64 symbols.inline-nonleaf]
    [leaf-name : i64 symbols.inline-switch]
    (ir.compiler-ir-function-seq-prepend
      (&
        (if (= mode 0)
          (opt-inline-checked-cold-driver-function symbols.main holder-name)
          (opt-inline-checked-hot-driver-function symbols.main holder-name)))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-checked-cold-pair-function
              symbols.inline-loop
              holder-name
              leaf-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-checked-depth0-caller-function
                  holder-name
                  leaf-name
                  (opt-inline-checked-depth0-shape-of mode)))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-checked-builder-function leaf-name))
                  (& (ir.compiler-ir-function-seq-empty)))))))))))

;; The encoding is `spent` then the builder calls left in the holder, so a change
;; in either reads directly off the number: 100 * verdicts + surviving calls.
;;
;; The hot program spends ONE verdict -- the holder's depth-0 builder site,
;; which the relaxed floor lets through -- and TAKES the builder: the site
;; reaches the verdict and the verdict, not a static clause, decides it. (INL-15
;; prices the plan with the allocator's own estimator and keeps it, and the
;; holder that absorbed a loop is not offered again inside `main`'s loop.) The
;; cold twin spends NONE: with the driver's call out of its loop the composite
;; frequency is one, and the frequency clause refuses before any pricing. That
;; pair is the whole of change (c) -- a depth-0 site is refused, or kept, on the
;; priced numbers rather than by a depth floor.
(define (opt-inline-checked-depth0-self-test [mode : i64]) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-checked-depth0-program symbols mode)
        2)]
    ;; BOTH budgets: the depth-0 site is admitted by a relaxed clause and is
    ;; charged to the relaxations' reserve (CB-2b), the holder's own in-loop
    ;; site to the core budget, and this fixture is about how many verdicts the
    ;; tier reached in all.
    [spent : i64
      (+
        (-
          (opt.opt-inline-checked-program-budget)
          (opt.opt-inline-checked-budget-current))
        (-
          (opt.opt-inline-checked-relaxed-program-budget)
          (opt.opt-inline-checked-relaxed-budget-current)))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    [holder-calls : i64
      (opt-count-direct-call-name-function-seq
        optimized
        "inline_nonleaf"
        "inline_switch")]
    [verified? : bool
      (opt-inline-mb2-main-verified? optimized "inline_nonleaf")]
    (if verified?
      (+ (* 100 spent) holder-calls)
      (- 0 1))))

(define (opt-inline-checked-seq-callee-c) : i64
  (opt-test-symbol "seq_callee_c"))

;; THE LOCK AS A BOUND. What protects the caller from a second body is the
;; VERDICT: every body past the first has to deliver its whole modelled saving
;; in its own right. The lock is a compile-time bound: a caller may keep at most
;; opt-inline-checked-max-callees distinct bodies, and the ranking -- worth per
;; instruction copied, whose worth is the composite frequency the call graph's
;; synthetic counts supply -- decides which.
;;
;; So: N distinct bodies are admitted in the order they are ranked, the (N+1)th
;; is refused, and a SLIM accept does not refuse the next body by proxy (the
;; reading is still published, and the verdict is still the one that reads it).
(define (opt-inline-checked-lock-bodies-fill [row : i64] [count : i64]) : unit
  (if (>= row count)
    unit
    (begin
      (opt.opt-inline-checked-scan-record!
        (opt-inline-checked-seq-body-callee row)
        (+ 400 row)
        row
        (- 900 row)
        false
        false)
      (opt-inline-checked-lock-bodies-fill (+ row 1) count))))

;; Arm, spend and ACCEPT one body at a time, reporting how many distinct bodies
;; the caller was allowed to take before the lock refused one.
(define (opt-inline-checked-lock-bodies-take
  [row : i64]
  [count : i64]
  [taken : i64]) : i64
  (if (>= row count)
    taken
    (if (not (opt.opt-inline-checked-arm-next-target!))
      taken
      (let
        [_spend : unit (opt.opt-inline-checked-spend-verdict!)]
        [_accept : unit (opt.opt-inline-checked-accept-target!)]
        (opt-inline-checked-lock-bodies-take (+ row 1) count (+ taken 1))))))

;; A distinct callee per row, so the lock counts bodies rather than sites.
(define (opt-inline-checked-seq-body-callee [row : i64]) : i64
  (cond
    [(= row 0) (opt-inline-checked-seq-callee-a)]
    [(= row 1) (opt-inline-checked-seq-callee-b)]
    [(= row 2) (opt-inline-checked-seq-callee-c)]
    [(= row 3) (opt-test-symbol "seq_callee_d")]
    [(= row 4) (opt-test-symbol "seq_callee_e")]
    [(= row 5) (opt-test-symbol "seq_callee_f")]
    [(= row 6) (opt-test-symbol "seq_callee_g")]
    [(= row 7) (opt-test-symbol "seq_callee_h")]
    [else (opt-test-symbol "seq_callee_i")]))

(define (compiler-optimize-inline-checked-lock-bodies-ok?) : bool
  (let
    [bound : i64 (opt.opt-inline-checked-max-callees)]
    [a : i64 (opt-inline-checked-seq-callee-a)]
    [b : i64 (opt-inline-checked-seq-callee-b)]
    ;; A SLIM accept of the first body does not speak for the second: the
    ;; reading is published, and the lock does not read it.
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    [_slim : unit (opt.opt-inline-checked-publish-margin! false)]
    [_scan-slim : unit
      (opt.opt-inline-checked-scan-record! a 50 0 900 false false)]
    [armed-slim? : bool (opt.opt-inline-checked-arm-next-target!)]
    [_keep-slim : unit
      (begin
        (opt.opt-inline-checked-spend-verdict!)
        (opt.opt-inline-checked-accept-target!))]
    [slim-published? : bool (opt.opt-inline-checked-last-margin-clear-current?)]
    [slim-same? : bool (opt.opt-inline-checked-callee-allowed? a)]
    [slim-other? : bool (opt.opt-inline-checked-callee-allowed? b)]
    ;; ...and the armed second body is the one the verdict holds to the clear
    ;; margin, which is where that discipline decides something
    [_scan-second : unit
      (opt.opt-inline-checked-scan-record! b 51 1 800 false false)]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [second-callee : i64 (opt.opt-inline-checked-target-callee-current)]
    [second-body? : bool (opt.opt-inline-checked-second-body?)]
    [second-relaxed? : bool (opt.opt-inline-checked-target-relaxed-current?)]
    ;; THE BOUND. A fresh caller offering one more distinct body than the lock
    ;; allows takes exactly the bound, richest first, and the next is refused.
    [_bound-caller : unit (opt.opt-inline-checked-caller-begin!)]
    [_fill : unit (opt-inline-checked-lock-bodies-fill 0 (+ bound 1))]
    [taken : i64 (opt-inline-checked-lock-bodies-take 0 (+ bound 1) 0)]
    [distinct : i64 (opt.opt-inline-checked-accepted-callee-count)]
    [over? : bool
      (opt.opt-inline-checked-callee-allowed?
        (opt-inline-checked-seq-body-callee bound))]
    [kept-first? : bool
      (opt.opt-inline-checked-callee-allowed?
        (opt-inline-checked-seq-body-callee 0))]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      armed-slim?
      armed-second?
      (not slim-published?)
      slim-same?
      slim-other?
      (= second-callee b)
      second-body?
      ;; a body past the first is a RELAXED candidate, on the same terms as a
      ;; below-the-floor site
      second-relaxed?
      ;; exactly N bodies, and the (N+1)th refused
      (= taken bound)
      (= distinct bound)
      (not over?)
      kept-first?)))

;; --- CB-2b: a relaxed candidate may only ADD a verdict, never take one -------
;;
;; The program budget is spent by refusals exactly as it is by accepts and it is
;; spent in walk order, so admitting a MARGINAL candidate anywhere takes a
;; verdict away from a candidate somewhere later: extra relaxed candidates that
;; all revert can push real keeps off the end of the budget.
;;
;; So the relaxations rank behind, and spend apart from, everything the
;; unrelaxed tier would have priced. These pin both halves.
(define (compiler-optimize-inline-checked-relaxed-rank-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    ;; two RELAXED rows, either of them nine times richer than the core one
    [_scan : unit
      (begin
        (opt.opt-inline-checked-scan-record! callee 70 0 900 true false)
        (opt.opt-inline-checked-scan-record! callee 71 1 100 false false)
        (opt.opt-inline-checked-scan-record! callee 72 2 800 true false))]
    [armed-first? : bool (opt.opt-inline-checked-arm-next-target!)]
    [first-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [first-relaxed? : bool (opt.opt-inline-checked-target-relaxed-current?)]
    [_spend-first : unit (opt.opt-inline-checked-spend-verdict!)]
    [core-left : i64 (opt.opt-inline-checked-budget-current)]
    [reserve-left : i64 (opt.opt-inline-checked-relaxed-budget-current)]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [second-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [second-relaxed? : bool (opt.opt-inline-checked-target-relaxed-current?)]
    [_spend-second : unit (opt.opt-inline-checked-spend-verdict!)]
    [core-after : i64 (opt.opt-inline-checked-budget-current)]
    [reserve-after : i64 (opt.opt-inline-checked-relaxed-budget-current)]
    ;; the caller's relaxed allowance is the lock's bound less its one
    ;; unrelaxed body, so a third row is on the table only while that allowance
    ;; has room for it
    [armed-third? : bool (opt.opt-inline-checked-arm-next-target!)]
    [core-verdicts : i64 (opt.opt-inline-checked-caller-verdicts-current)]
    [relaxed-verdicts : i64
      (opt.opt-inline-checked-caller-relaxed-verdicts-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      armed-second?
      (if (> (opt.opt-inline-checked-max-caller-relaxed-verdicts) 1)
        armed-third?
        (not armed-third?))
      ;; CORE FIRST, richness second: the poorest core row is priced before the
      ;; richest relaxed one
      (= first-pos 1)
      (not first-relaxed?)
      (= second-pos 0)
      second-relaxed?
      ;; and each verdict is charged to its own budget
      (= core-left (- (opt.opt-inline-checked-program-budget) 1))
      (= reserve-left (opt.opt-inline-checked-relaxed-program-budget))
      (= core-after (- (opt.opt-inline-checked-program-budget) 1))
      (= reserve-after (- (opt.opt-inline-checked-relaxed-program-budget) 1))
      (= core-verdicts 1)
      ;; one verdict of each class was SPENT; the third row was only armed
      (= relaxed-verdicts 1))))

;; One relaxed verdict in each of `count` successive callers, which is the most
;; the per-caller allowance lets any of them have.
(define (opt-inline-checked-relaxed-drain
  [callee : i64]
  [row : i64]
  [count : i64]
  [armed : i64]) : i64
  (if (>= row count)
    armed
    (let
      [_caller : unit (opt.opt-inline-checked-caller-begin!)]
      [_scan : unit
        (opt.opt-inline-checked-scan-record!
          callee
          (+ 200 row)
          row
          900
          true
          false)]
      [ok? : bool (opt.opt-inline-checked-arm-next-target!)]
      [_spend : unit
        (if ok?
          (opt.opt-inline-checked-spend-verdict!)
          unit)]
      (opt-inline-checked-relaxed-drain
        callee
        (+ row 1)
        count
        (+
          armed
          (if ok?
            1
            0))))))

;; THE RESERVE. Every relaxed verdict the program can afford is spent, and the
;; core budget comes out of it untouched: the caller that arrives next is armed
;; exactly as it would have been had no clause ever been relaxed.
(define (compiler-optimize-inline-checked-relaxed-reserve-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [reserve : i64 (opt.opt-inline-checked-relaxed-program-budget)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    [spent : i64 (opt-inline-checked-relaxed-drain callee 0 reserve 0)]
    [core-untouched : i64 (opt.opt-inline-checked-budget-current)]
    [reserve-left : i64 (opt.opt-inline-checked-relaxed-budget-current)]
    ;; the next caller's relaxed row is refused for want of reserve...
    [_next : unit (opt.opt-inline-checked-caller-begin!)]
    [_scan-relaxed : unit
      (opt.opt-inline-checked-scan-record! callee 300 0 900 true false)]
    [relaxed-again? : bool (opt.opt-inline-checked-arm-next-target!)]
    ;; ...and its CORE row is armed anyway, which is the whole claim
    [_scan-core : unit
      (opt.opt-inline-checked-scan-record! callee 301 1 100 false false)]
    [core-armed? : bool (opt.opt-inline-checked-arm-next-target!)]
    [core-relaxed? : bool (opt.opt-inline-checked-target-relaxed-current?)]
    [core-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      (> reserve 0)
      (= spent reserve)
      (= core-untouched (opt.opt-inline-checked-program-budget))
      (= reserve-left 0)
      (not relaxed-again?)
      core-armed?
      (not core-relaxed?)
      (= core-pos 1))))

;; --- INL-1: the call graph's synthetic entry counts --------------------------
;;
;; The census's hot reference count sees ONE call level: a leaf reached through
;; two straight-line wrappers from a loop reads as cold, because the wrappers'
;; own sites are straight-line. The counts propagated over the call graph
;; (opt.opt-inline-synth-build!) are what the composite site
;; frequency reads instead, and these pin the four properties the tier depends
;; on: the chain, the recursive component, the unknown-caller base, and the
;; saturation.
(define (opt-inline-synth-leaf-function [func-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    3
    (irt.blocks "entry:
         return %0")
    Ordinary))

;; entry -> loop -> wrapper -> wrapper -> leaf. The loop holder calls `mid` from
;; its loop body (depth 1, one census weight); `mid` and `wrap` are
;; straight-line, so the census's own count for `wrap` is ONE and the leaf's
;; site under it reads as cold on that count alone.
(define (opt-inline-synth-chain-program) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (irt.func
        "function @main(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 5 {
       entry:
         %3 = call synth_outer(%1, %0, %2) : i64
         return %3
       }"))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-loop-site-function
            (opt-test-symbol "synth_outer")
            (opt-test-symbol "synth_mid")
            (opt-inline-loop-site-entry-instrs)))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (irt.func
                "function @synth_mid(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 5 {
           entry:
             %3 = call synth_wrap(%1, %0, %2) : i64
             return %3
           }"))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (irt.func
                    "function @synth_wrap(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 5 {
             entry:
               %3 = call synth_leaf(%1, %0, %2) : i64
               return %3
             }"))
                (&
                  (ir.compiler-ir-function-seq-prepend
                    (&
                      (opt-inline-synth-leaf-function
                        (opt-test-symbol "synth_leaf")))
                    (& (ir.compiler-ir-function-seq-empty))))))))))))

;; A self-recursive loop holder, reached once from the entry: its component is
;; its own, and its count has to carry its own repetition.
(define (opt-inline-synth-recursive-program) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (irt.func
        "function @main(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 5 {
       entry:
         %3 = call synth_rec(%1, %0, %2) : i64
         return %3
       }"))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-loop-site-function
            (opt-test-symbol "synth_rec")
            (opt-test-symbol "synth_rec")
            (opt-inline-loop-site-entry-instrs)))
        (& (ir.compiler-ir-function-seq-empty))))))

;; The same loop body calls one ordinary leaf and one whose address the entry
;; also takes, so the two differ by exactly the unknown-caller base.
(define (opt-inline-synth-address-program) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (irt.func
        "function @main(tag=%0:i64, idx=%1:i64, len=%2:i64) -> i64 vars 6 {
       entry:
         %3 = call synth_outer(%1, %0, %2) : i64
         %4 = mov fn@synth_taken : i64
         return %3
       }"))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-inline-loop-site-function
            (opt-test-symbol "synth_outer")
            (opt-test-symbol "synth_plain")
            (opt-inline-loop-site-entry-instrs)))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-inline-loop-site-function
                (opt-test-symbol "synth_plain")
                (opt-test-symbol "synth_taken")
                (opt-inline-loop-site-entry-instrs)))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (opt-inline-synth-leaf-function
                    (opt-test-symbol "synth_taken")))
                (& (ir.compiler-ir-function-seq-empty))))))))))

;; Build the counts for one program and report the count of one function by
;; name. `mode` selects which reading is wanted: the synthetic count, or the
;; census's one-level hot reference count over the same program.
(define (opt-inline-synth-count-of
  [functions : ir.CompilerIrFunctionSeq]
  [name : i64]
  [hot? : bool]) : i64
  (let
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [graph : opt.OptCallGraph (opt.opt-callgraph-build index)]
    [scc-result : opt.OptSccResult (opt.opt-scc-compute graph)]
    [census : opt.OptInlineCensus
      (opt.opt-inline-census-build index (& functions))]
    [_build : unit
      (opt.opt-inline-synth-build!
        index
        census
        graph
        scc-result
        (& (opt.opt-inline-slot-order scc-result)))]
    [out : i64
      (if hot?
        (opt.opt-inline-census-hot-refcount index census name)
        (opt.opt-inline-synth-for-name index name))]
    [_reset : unit (opt.opt-inline-synth-reset!)]
    out))

;; THE CHAIN. One census weight is what the tier's frequency floor asks for, and
;; the wrapper two levels below the loop delivers it on the propagated count
;; while the census's own count for the same function is one.
(define (compiler-optimize-inline-synth-chain-ok?) : bool
  (let
    [weight : i64 (opt.opt-inline-census-depth-weight 1)]
    [wrap-synth : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-chain-program)
        (opt-test-symbol "synth_wrap")
        false)]
    [wrap-hot : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-chain-program)
        (opt-test-symbol "synth_wrap")
        true)]
    [mid-synth : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-chain-program)
        (opt-test-symbol "synth_mid")
        false)]
    [leaf-synth : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-chain-program)
        (opt-test-symbol "synth_leaf")
        false)]
    [outer-synth : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-chain-program)
        (opt-test-symbol "synth_outer")
        false)]
    ;; and the counts are gone once the pass that built them is over
    [after-reset : i64 (opt.opt-inline-synth-at 0)]
    (and
      (> weight 1)
      ;; the entry is reached once; the loop holder is reached once from it
      (= outer-synth 1)
      ;; ...and its loop body's site carries one census weight down the chain
      (= mid-synth weight)
      (= wrap-synth weight)
      (= leaf-synth weight)
      ;; which is the frequency floor the tier reads, on a site the census's own
      ;; count calls cold
      (>= wrap-synth (opt.opt-inline-checked-min-frequency))
      (= wrap-hot 1)
      (< wrap-hot (opt.opt-inline-checked-min-frequency))
      (= after-reset 0)
      (not (opt.opt-inline-synth-ready?)))))

;; THE RECURSIVE COMPONENT. Its members push to each other for a bounded number
;; of rounds, so a self-recursive loop holder reads hotter than the one call
;; that reaches it, and the result is bounded, reproducible, and inside the cap.
(define (compiler-optimize-inline-synth-recursive-ok?) : bool
  (let
    [weight : i64 (opt.opt-inline-census-depth-weight 1)]
    [rec-first : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-recursive-program)
        (opt-test-symbol "synth_rec")
        false)]
    [rec-again : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-recursive-program)
        (opt-test-symbol "synth_rec")
        false)]
    [cap : i64 (opt.opt-inline-synth-cap)]
    (and
      ;; one entry call, plus its own loop's repetition
      (> rec-first weight)
      (<= rec-first cap)
      ;; deterministic: the same program gives the same counts
      (= rec-first rec-again)
      ;; ...and the saturating arithmetic is what bounds it
      (= (opt.opt-inline-synth-mul cap 2) cap)
      (= (opt.opt-inline-synth-mul (/ cap 2) 4) cap)
      (= (opt.opt-inline-synth-mul cap 1) cap)
      (= (opt.opt-inline-synth-mul 0 64) 0)
      (= (opt.opt-inline-synth-mul 8 8) 64)
      (= (opt.opt-inline-synth-add (- cap 1) 100) cap)
      (= (opt.opt-inline-synth-add 8 8) 16)
      (> (opt.opt-inline-synth-rounds) 0))))

;; THE UNKNOWN-CALLER BASE. An address-taken callee may be reached by an
;; indirect call this compilation cannot see, so its count starts at one; the
;; ordinary callee beside it, called from the same block, starts at zero and
;; carries only what its callers deliver.
(define (compiler-optimize-inline-synth-address-taken-ok?) : bool
  (let
    [weight : i64 (opt.opt-inline-census-depth-weight 1)]
    [plain : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-address-program)
        (opt-test-symbol "synth_plain")
        false)]
    [taken : i64
      (opt-inline-synth-count-of
        (opt-inline-synth-address-program)
        (opt-test-symbol "synth_taken")
        false)]
    (and
      (= plain weight)
      ;; the same site weight, one call level further down, plus the base
      (= taken (+ (* weight weight) 1)))))

;; THE ORDER. The ranking is worth per instruction copied, and the worth is the
;; composite frequency: of two candidate sites alike in everything else, the
;; hotter one is armed first, whatever order the caller's walk found them in.
(define (compiler-optimize-inline-synth-order-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [cold : i64 (opt.opt-inline-checked-richness 8 2 40)]
    [hot : i64 (opt.opt-inline-checked-richness 4096 2 40)]
    [_begin : unit (opt.opt-inline-checked-program-begin!)]
    ;; the COLD site is found first, so only the ranking can order them
    [_scan : unit
      (begin
        (opt.opt-inline-checked-scan-record! callee 80 0 cold false false)
        (opt.opt-inline-checked-scan-record! callee 81 1 hot false false))]
    [armed-first? : bool (opt.opt-inline-checked-arm-next-target!)]
    [first-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [_spend : unit (opt.opt-inline-checked-spend-verdict!)]
    [armed-second? : bool (opt.opt-inline-checked-arm-next-target!)]
    [second-pos : i64 (opt.opt-inline-checked-target-pos-current)]
    [_reset : unit (opt.opt-inline-checked-program-begin!)]
    (and
      ;; richness is monotone in the frequency it is asked about
      (> hot cold)
      (>
        (opt.opt-inline-checked-richness 4096 2 40)
        (opt.opt-inline-checked-richness 4096 2 80))
      armed-first?
      armed-second?
      (= first-pos 1)
      (= second-pos 0))))

;; --- and the same claim end to end: a claim adds, it does not withdraw -------
;;
;; The tiny leaf every cheap band takes for free: one straight-line block, three
;; parameters, two arithmetic instructions. Nothing about it is the measured
;; tier's business, and the measured tier is never asked about it -- a site a
;; band admits is never offered to the check.
(define (opt-inline-checked-cheap-leaf-function [name : i64]) : ir.CompilerIrFunction
  (Function
    name
    (opt-inline-switch-params)
    (I64)
    5
    (irt.blocks
      "entry:
         %3 = add %0, %1 : i64
         %4 = bit_xor %3, %2 : i64
         return %4")
    Ordinary))

;; The hot caller: the builder at its ENTRY block, which every band refuses --
;; the loop bands want the site inside the caller's loop, the sole-call band
;; wants an acyclic callee, and a second reference keeps the single-site band
;; out -- and a loop of its own holding two of the leaf's four sites, which
;; every band takes.
(define (opt-inline-checked-cheap-hot-caller
  [func-name : i64]
  [leaf-name : i64]
  [builder-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    10
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "latch:
               jump header
             exit:
               return %4")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%3 = mov 0 : i64")
          (opt-inline-checked-builder-call builder-name 5)
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header"))))
      (irt.block
        "header:
             %4 = phi [%3, entry], [%9, latch] : i64
             branch %0, body, exit")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (opt-inline-loop-site-call leaf-name 6)
          (opt-inline-loop-site-call leaf-name 7)
          (irt.instr "%8 = add %6, %7 : i64")
          (irt.instr "%9 = add %8, %5 : i64")
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))))
    Ordinary))

;; The cold caller: the leaf's other two sites, plus the second reference to the
;; builder and to the hot caller, so no single-reference band can claim either
;; of them before the measured tier is asked.
(define (opt-inline-checked-cheap-cold-caller
  [func-name : i64]
  [leaf-name : i64]
  [builder-name : i64]
  [hot-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    10
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-checked-builder-call builder-name 3)
          (opt-inline-loop-site-call leaf-name 4)
          (opt-inline-loop-site-call leaf-name 5)
          (opt-inline-loop-site-call hot-name 6)
          (irt.instr "%7 = add %4, %5 : i64")
          (irt.instr "%8 = add %3, %6 : i64")
          (irt.instr "%9 = add %7, %8 : i64")
          (irt.instr "return %9"))))
    Ordinary))

(define (opt-inline-checked-cheap-program [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (let
    [leaf-name : i64 symbols.inline-tiny-predicate]
    [builder-name : i64 symbols.inline-switch]
    [hot-name : i64 symbols.inline-nonleaf]
    (ir.compiler-ir-function-seq-prepend
      (& (opt-inline-checked-hot-driver-function symbols.main hot-name))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-checked-cheap-cold-caller
              symbols.inline-loop
              leaf-name
              builder-name
              hot-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-checked-cheap-hot-caller
                  hot-name
                  leaf-name
                  builder-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-checked-builder-function builder-name))
                  (&
                    (ir.compiler-ir-function-seq-prepend
                      (& (opt-inline-checked-cheap-leaf-function leaf-name))
                      (& (ir.compiler-ir-function-seq-empty)))))))))))))

(define (opt-count-direct-call-name-functions
  [functions : ir.CompilerIrFunctionSeq]
  [name : String]) : i64
  (let
    [index : i64 0]
    [count : i64 0]
    (while (< index functions.len)
      (match (ir.compiler-ir-function-seq-ref functions index)
        [(Function _ _ _ _ blocks _)
          (set!
            count
            (+
              count
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                (opt.compiler-opt-global-shared-view name))))])
      (set! index (+ index 1)))
    count))

;; The encoding is the tier's verdicts, then the builder's surviving calls, then
;; the leaf's: 10000 * verdicts + 100 * builder calls + calls to the four-site
;; leaf left anywhere in the program.
;;
;; ONE verdict: the builder's entry-block site in the hot caller is the one site
;; in this program no band will take, so it is the measured tier's, and it
;; reaches the tier while the tier is claiming nothing else. NO leaf calls: the
;; cheap bands take all four of the leaf's sites -- two of them inside the very
;; caller the claim lands in -- and the claim leaves every one of them where it
;; was. (The builder's own cold second reference is band-absorbed into a
;; loop-free caller, which is why nothing calls it either.)
(define (opt-inline-checked-cheap-tier-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [_arm : unit
      (begin
        (opt.opt-inline-checked-set-active! true)
        (opt.opt-inline-checked-program-begin!))]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-checked-cheap-program symbols)
        2)]
    [spent : i64
      (+
        (-
          (opt.opt-inline-checked-program-budget)
          (opt.opt-inline-checked-budget-current))
        (-
          (opt.opt-inline-checked-relaxed-program-budget)
          (opt.opt-inline-checked-relaxed-budget-current)))]
    [_disarm : unit (opt.opt-inline-checked-set-active! false)]
    [leaf-calls : i64
      (opt-count-direct-call-name-functions
        (opt.compiler-opt-global-shared-view optimized)
        "inline_tiny_predicate")]
    [builder-calls : i64
      (opt-count-direct-call-name-functions optimized "inline_switch")]
    (+ (* 10000 spent) (+ (* 100 builder-calls) leaf-calls))))

(define (compiler-optimize-inline-dup-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1))))

;; --- single-site absorption at any size (wide boundary, cold site) ----------
;;
;; The callee under test is the cyclic bounds-carrying Switch leaf above,
;; widened to ten parameters and padded past two hundred instructions. Every
;; band that could otherwise take it refuses it on size or on shape: the loop
;; tier caps the body at 32 instructions, the recursive-site tier at 128 and
;; wants a self-recursive caller, and no cost-model path reaches it at all
;; because a cyclic bounds-carrying body fails
;; opt-inline-multiblock-bounds-loop-ok?. So whatever these fixtures admit was
;; admitted by opt-inline-single-site-absorb-ok? and by nothing else, and only
;; the CALLER or the callee's reference count varies across them.
(define (opt-inline-wide-param-count) : i64
  10)

(define (opt-inline-wide-pad-count) : i64
  220)

(define (opt-inline-wide-params-from [index : i64] [count : i64]) : ir.CompilerIrParamSeq
  (if (>= index count)
    (ir.compiler-ir-param-seq-empty)
    (ir.compiler-ir-param-seq-prepend
      (Param "wide" (I64) index)
      (opt-inline-wide-params-from (+ index 1) count))))

(define (opt-inline-wide-params [count : i64]) : ir.CompilerIrParamSeq
  (opt-inline-wide-params-from 0 count))

;; Straight-line adds, each defining a fresh var, in front of `tail`. This
;; padding is the only thing standing between the fixture and the size ceilings
;; this band exists to remove.
(define (opt-inline-wide-pad-instrs
  [remaining : i64]
  [dst : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (<= remaining 0)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-wide-pad-instrs (- remaining 1) (+ dst 1) tail)
      (ir.CompilerIrInstr.BinOp dst (Add) (Var 0) (I64 1) (I64)))))

;; The join phi sits just past the padding, so a fixture's var count is
;; params + padding + 1.
(define (opt-inline-wide-phi-var [params : i64]) : i64
  (+ params (opt-inline-wide-pad-count)))

(define (opt-inline-wide-loop-phi-instr [params : i64]) : ir.CompilerIrInstr
  (Phi
    (opt-inline-wide-phi-var params)
    (ir.compiler-ir-phi-input-seq-prepend
      (I64 10)
      (ir.compiler-ir-label "zero")
      (&
        (ir.compiler-ir-phi-input-seq-prepend
          (I64 20)
          (ir.compiler-ir-label "one")
          (& (ir.compiler-ir-phi-input-seq-empty)))))
    (I64)))

;; entry -> loop -> {zero, one} -> join, with the loop's default edge back to
;; `loop`. Cyclic and bounds-carrying, so every size-capped band refuses it.
(define (opt-inline-wide-callee-blocks
  [params : i64]
  [extra-loop-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs-with-tail
        (opt-inline-wide-pad-instrs
          (opt-inline-wide-pad-count)
          params
          (opt-test-instr-seq-append
            extra-loop-instrs
            (irt.instrs "switch %0 base 0 [0:zero, 1:one] default loop")))
        (irt.instr "bounds_check %1, %2 message \"switch_bounds_ok\"")))
    (irt.block "zero:
             jump join")
    (irt.block "one:
               jump join")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "join")
      (opt-test-instrs
        (opt-inline-wide-loop-phi-instr params)
        (ir.CompilerIrInstr.Return
          (Some (Var (opt-inline-wide-phi-var params))))))))

(define (opt-inline-wide-callee-arity [callee-name : i64] [params : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-wide-params params)
    (I64)
    (+ (opt-inline-wide-phi-var params) 1)
    (opt-inline-wide-callee-blocks params (ir.compiler-ir-instr-seq-empty))
    Ordinary))

(define (opt-inline-wide-callee [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-wide-callee-arity callee-name (opt-inline-wide-param-count)))

;; Argument slots cycle over the caller's three live vars, so no
;; all-constant-argument path can admit a site behind the band's back.
(define (opt-inline-wide-fill-args!
  [args : (&mut args (__tl_dyn-array ir.CompilerIrValue))]
  [index : i64]
  [count : i64]
  [slot : i64]) : unit
  (unless
    (>= index count)
    (set! (array-ref args index) (ir.CompilerIrValue.Var slot))
    (opt-inline-wide-fill-args!
      args
      (+ index 1)
      count
      (if (>= (+ slot 1) 3)
        0
        (+ slot 1)))))

(define (opt-inline-wide-call [callee-name : i64] [params : i64] [dst : i64]) : ir.CompilerIrInstr
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue params)]
    (opt-inline-wide-fill-args! (&mut args) 0 params 0)
    (Call dst callee-name (Array args) (I64))))

;; The same wide callee with one call inside its loop, for the call-free clause.
(define (opt-inline-wide-callee-calling [callee-name : i64] [helper-name : i64]) : ir.CompilerIrFunction
  (let
    [params : i64 (opt-inline-wide-param-count)]
    (Function
      callee-name
      (opt-inline-wide-params params)
      (I64)
      (+ (opt-inline-wide-phi-var params) 2)
      (opt-inline-wide-callee-blocks
        params
        (opt-test-instrs
          (opt-inline-wide-call
            helper-name
            params
            (+ (opt-inline-wide-phi-var params) 1))))
      Ordinary)))

;; A straight-line caller: the site is in no natural loop, which is what this
;; band requires and what the loop tier forbids.
(define (opt-inline-wide-cold-caller
  [func-name : i64]
  [callee-name : i64]
  [params : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-wide-call callee-name params 3)
          (irt.instr "return %3"))))
    Ordinary))

;; The same straight-line caller with the callee's address taken first. Nothing
;; else differs from the headline fixture.
(define (opt-inline-wide-address-taken-caller
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    5
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 4 (Function callee-name) (I64))
          (opt-inline-wide-call callee-name (opt-inline-wide-param-count) 3)
          (irt.instr "return %3"))))
    Ordinary))

;; The same caller with the wide call inside a natural loop. entry -> header ->
;; {body -> latch -> header, exit}, with the call in `body`; the back edge
;; leaves from `latch` so the call block is not a phi predecessor.
(define (opt-inline-wide-loop-caller-blocks [callee-name : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "latch:
             jump header
           exit:
             return %4")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-inline-loop-site-entry-instrs))
    (irt.block
      "header:
           %4 = phi [%3, entry], [%5, latch] : i64
           branch %0, body, exit")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs
        (opt-inline-wide-call callee-name (opt-inline-wide-param-count) 5)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch"))))))

(define (opt-inline-wide-loop-caller [func-name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (opt-inline-wide-loop-caller-blocks callee-name)
    Ordinary))

;; The middle link of the cascade: wide, single-site, straight-line, multiblock,
;; and itself calling the wide leaf. It carries a bounds check of its own so
;; that the separately-tested cascade clause -- which refuses an import that
;; would hand a bounds-FREE single-site caller its first bounds check -- is not
;; what this fixture ends up measuring.
(define (opt-inline-wide-cascade-middle [func-name : i64] [leaf-name : i64]) : ir.CompilerIrFunction
  (let
    [params : i64 (opt-inline-wide-param-count)]
    (Function
      func-name
      (opt-inline-wide-params params)
      (I64)
      (+ params 1)
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks "exit:
             return %10")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (opt-test-instrs
            (irt.instr "bounds_check %1, %2 message \"mid_bounds_ok\"")
            (opt-inline-wide-call leaf-name params params)
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "exit")))))
      Ordinary)))

(define (opt-inline-wide-optimized [functions : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    functions
    2))

(define (opt-inline-wide-two-function-optimized
  [caller : ir.CompilerIrFunction]
  [callee : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (opt-inline-wide-optimized
    (ir.compiler-ir-function-seq-prepend
      (& caller)
      (&
        (ir.compiler-ir-function-seq-prepend
          (& callee)
          (& (ir.compiler-ir-function-seq-empty)))))))

(define (opt-inline-wide-remaining-calls [optimized : ir.CompilerIrFunctionSeq]) : i64
  (opt-count-direct-call-name-function-seq optimized "main" "inline_switch"))

;; The headline case: a 220-instruction, ten-parameter, single-site callee is
;; absorbed whole at its one straight-line site. The call disappears, the body
;; lands, and the bounds check the callee owned is now the caller's.
(define (compiler-optimize-inline-single-site-wide-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-two-function-optimized
        (opt-inline-wide-cold-caller
          symbols.main
          callee-name
          (opt-inline-wide-param-count))
        (opt-inline-wide-callee callee-name))]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; The identical callee at an IN-LOOP site is absorbed too, and the body it
;; lands is the same one. The merged frame is paid once per caller invocation,
;; while at an in-loop site the boundary the absorption buys is retired once per
;; ITERATION, so an unbounded body may be moved inside a loop as well as next to
;; one. See clause 3 at opt-inline-single-site-absorb-ok?.
(define (compiler-optimize-inline-single-site-wide-loop-site-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-two-function-optimized
        (opt-inline-wide-loop-caller symbols.main callee-name)
        (opt-inline-wide-callee callee-name))]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (=
              (opt.opt-count-bounds-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; A chain of `count` jump-only blocks labelled chain_0 .. chain_(count-1),
;; each jumping to the next and the last jumping to `tail-label`. This is how
;; the fixtures below reach an exact block count without adding instructions
;; the cost model would price or edges the acyclic checks would refuse.
(define (opt-inline-chain-block-label [index : i64]) : i64
  (ir.compiler-ir-label
    (& (str_cat.str-cat "chain_" (string.int->string index) ""))))

(define (opt-inline-chain-blocks!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [index : i64]
  [count : i64]
  [tail-label : i64]
  [tail : ir.CompilerIrBlockList]) : unit
  (if (>= index count)
    (ir.compiler-ir-block-builder-append-list! out tail)
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-chain-block-label index)
          (opt-test-instrs
            (ir.CompilerIrInstr.Jump
              (if (>= (+ index 1) count)
                tail-label
                (opt-inline-chain-block-label (+ index 1)))))))
      (opt-inline-chain-blocks! out (+ index 1) count tail-label tail))))

(define (opt-inline-chain-exit-label) : i64
  (ir.compiler-ir-label "chain_exit"))

(define (opt-inline-chain-exit-block) : ir.CompilerIrBlockList
  (irt.blocks "chain_exit:
       return 0"))

;; A bounds-free, call-free, acyclic single-site callee of exactly `blocks`
;; blocks and `params` parameters. Nothing but the band can admit it once it is
;; past the cost model's 32-block fuel: the hot-loop-leaf gate wants a cyclic
;; body, the chain gate wants an in-loop site, and the measured tier wants a
;; site at loop depth 1 or more.
(define (opt-inline-chain-callee
  [callee-name : i64]
  [params : i64]
  [blocks : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-wide-params params)
    (I64)
    params
    (opt.opt-blocks-collect
      opt-inline-chain-blocks!
      0
      (- blocks 1)
      (opt-inline-chain-exit-label)
      (opt-inline-chain-exit-block))
    Ordinary))

;; The same straight-line caller as opt-inline-wide-cold-caller with `pad`
;; jump-only blocks in front of the call block, so the fixture can name the
;; caller's block count exactly. Total blocks are `pad + 1`.
(define (opt-inline-wide-padded-caller
  [func-name : i64]
  [callee-name : i64]
  [params : i64]
  [pad : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    4
    (opt.opt-blocks-collect
      opt-inline-chain-blocks!
      0
      pad
      (ir.compiler-ir-label "site")
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "site")
          (opt-test-instrs
            (opt-inline-wide-call callee-name params 3)
            (irt.instr "return %3")))))
    Ordinary))

;; Below the arity floor there is no argument marshalling for the absorption to
;; retire and the narrow class stays with the site-conditioned tiers: the
;; identical 220-instruction body that the band absorbs at ten parameters stays
;; out of line at three, in a two-block caller (a small-caller relief that
;; admitted it would merge every small program's single-site functions into
;; `main` for no gain; see opt-inline-single-site-min-params) ...
(define (compiler-optimize-inline-single-site-narrow-small-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [narrow : i64 3]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-padded-caller symbols.main callee-name narrow 1)
          (opt-inline-wide-callee-arity callee-name narrow)))
      1)))

;; ... and in a 71-block one, the large-caller shape of `pl-parse-line` and
;; `pl-record-sweep`, where narrow absorptions are a loss.
(define (compiler-optimize-inline-single-site-narrow-large-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [narrow : i64 3]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-padded-caller symbols.main callee-name narrow 70)
          (opt-inline-wide-callee-arity callee-name narrow)))
      1)))

;; --- the narrow class at an IN-LOOP site ------------------------------------
;;
;; Clause 2's second half. The leaf is the
;; cyclic bounds-carrying Switch leaf the loop tier is built around -- three
;; parameters, seven instructions in five blocks, call-free -- and `mid` is
;; single-reference and bounds-free, so the loop tier refuses the import on its
;; cascade clause and nothing else in this file can admit it. That is exactly
;; `stdlib.vector.generated.i64/set-ref!` (3 parameters, 22 instructions in 6
;; blocks) at its in-loop site in `cfg-scan-ints` and `gvn-scan-ints`, which
;; the waiver moves.
;;
;; Each fixture below builds one program and varies one thing: where `mid`
;; makes the call, and how big the leaf is.
(define (opt-inline-narrow-site-program
  [symbols : OptInlineMultiTestSymbols]
  [mid : ir.CompilerIrFunction]
  [leaf : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-switch-caller-named symbols symbols.inline-nonleaf))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& mid)
        (&
          (ir.compiler-ir-function-seq-prepend
            (& leaf)
            (& (ir.compiler-ir-function-seq-empty))))))))

(define (opt-inline-narrow-site-optimized
  [symbols : OptInlineMultiTestSymbols]
  [mid : ir.CompilerIrFunction]
  [leaf : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-inline-narrow-site-program symbols mid leaf)
    2))

;; Calls to the leaf left in `mid`. `main`'s own copy of `mid`, if the cost
;; model took one, is not counted: the inliner leaves the original function
;; standing for global DCE to remove afterwards, so `mid` is the one place that
;; answers whether the import happened.
(define (opt-inline-narrow-site-remaining-calls
  [optimized : ir.CompilerIrFunctionSeq]) : i64
  (opt-count-direct-call-name-function-seq
    optimized
    "inline_nonleaf"
    "inline_switch"))

;; The same five blocks and the same natural loop as opt-inline-loop-site-
;; function, with the one call moved out of `body` and into `entry`. The pair
;; differs in the SITE and in nothing else.
(define (opt-inline-straight-site-function
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "header:
           %4 = phi [%3, entry], [%5, latch] : i64
           branch %0, body, exit
         body:
           jump latch
         latch:
           jump header
         exit:
           return %4")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instr-seq-prepend
          (irt.instr "%3 = mov 0 : i64")
          (opt-test-instr-seq-prepend
            (opt-inline-loop-site-call callee-name 5)
            (irt.instrs "jump header")))))
    Ordinary))

;; `count` extra Movs ahead of the `zero` case's jump. The leaf keeps its five
;; blocks, its three parameters, its bounds check and its loop, and only its
;; instruction count moves, so a pair of fixtures can sit either side of
;; opt-inline-bounds-loop-max-body.
(define (opt-inline-narrow-fat-zero-instrs [count : i64]) : ir.CompilerIrInstrSeq
  (if (<= count 0)
    (opt-inline-dup-leaf-jump-zero-instrs)
    (opt-test-instr-seq-prepend
      (Mov 4 (I64 count) (I64))
      (opt-inline-narrow-fat-zero-instrs (- count 1)))))

(define (opt-inline-narrow-fat-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    5
    (opt-inline-narrow-fat-zero-instrs 40)))

;; Below the arity floor, at an IN-LOOP site, at the loop tier's size and
;; call-free: the body moves. Nothing else in the file admits this shape -- the
;; loop tier refuses it on the cascade clause, the hot-loop-leaf gate asks the
;; same clause, and a cyclic bounds-carrying body has no cost-model path.
(define (compiler-optimize-inline-single-site-narrow-loop-site-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    (=
      (opt-inline-narrow-site-remaining-calls
        (opt-inline-narrow-site-optimized
          symbols
          (opt-inline-loop-site-function
            symbols.inline-nonleaf
            leaf-name
            (opt-inline-loop-site-entry-instrs))
          (opt-inline-switch-callee-named leaf-name)))
      0)))

;; The same leaf and the same caller with the call moved into `entry`: at a
;; STRAIGHT-LINE site the boundary is retired once per caller invocation, the
;; frame tax is paid at the same rate, and below the arity floor there is no
;; marshalling in that boundary to tip the comparison. The narrow class stays
;; out.
(define (compiler-optimize-inline-single-site-narrow-straight-site-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    (=
      (opt-inline-narrow-site-remaining-calls
        (opt-inline-narrow-site-optimized
          symbols
          (opt-inline-straight-site-function symbols.inline-nonleaf leaf-name)
          (opt-inline-switch-callee-named leaf-name)))
      1)))

;; ... and past the loop tier's size class the same in-loop site refuses it:
;; 47 instructions is past opt-inline-bounds-loop-max-body, which is where
;; clause 2 stops admitting a below-floor boundary. Everything else is the
;; positive fixture above.
(define (compiler-optimize-inline-single-site-narrow-oversize-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    (=
      (opt-inline-narrow-site-remaining-calls
        (opt-inline-narrow-site-optimized
          symbols
          (opt-inline-loop-site-function
            symbols.inline-nonleaf
            leaf-name
            (opt-inline-loop-site-entry-instrs))
          (opt-inline-narrow-fat-leaf leaf-name)))
      1)))

;; A wide single-site callee at the pathological-case backstop is still
;; absorbed: 128 blocks is opt-inline-single-site-max-blocks exactly, and this
;; band has no growth budget to spend.
(define (compiler-optimize-inline-single-site-size-cap-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [wide : i64 (opt-inline-wide-param-count)]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller symbols.main callee-name wide)
          (opt-inline-chain-callee callee-name wide 128)))
      0)))

;; One block past the backstop the same body is absorbed anyway, because the
;; sole-call tier answers first and carries no block cap: the body is ACYCLIC
;; and the site is straight-line, which is the whole of that tier's admission.
;; This fixture asserted a refusal until the sole-call tier landed; the
;; backstop it was testing still governs the arity/frame-tax band, which is
;; what compiler-optimize-inline-sole-call-cyclic-refusal-ok? now pins -- a
;; body one block past the backstop that the sole-call tier will not take
;; because it carries a back edge.
(define (compiler-optimize-inline-sole-call-past-backstop-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [wide : i64 (opt-inline-wide-param-count)]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller symbols.main callee-name wide)
          (opt-inline-chain-callee callee-name wide 129)))
      0)))

;; A one-parameter, one-block, three-reference leaf: too many references to be
;; absorbable, small enough that the ordinary cost model admits it (1
;; instruction against a call bonus of 6). The only thing that can refuse it is
;; the shared block fuel.
(define (opt-inline-fuel-tiny-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-wide-params 1)
    (I64)
    2
    (irt.blocks "entry:
         %1 = add %0, 1 : i64
         return %1")
    Ordinary))

(define (opt-inline-fuel-tiny-call [callee-name : i64] [dst : i64]) : ir.CompilerIrInstr
  (Call dst callee-name (One (Var 0)) (I64)))

;; entry absorbs the 34-block single-site callee; `mid` then holds three sites
;; of the tiny leaf, walked with whatever growth accumulator the absorption
;; left behind.
(define (opt-inline-fuel-caller
  [func-name : i64]
  [big-name : i64]
  [tiny-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    8
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "exit:
             return %6")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-wide-call big-name (opt-inline-wide-param-count) 3)
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "mid"))))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "mid")
        (opt-test-instrs
          (opt-inline-fuel-tiny-call tiny-name 4)
          (opt-inline-fuel-tiny-call tiny-name 5)
          (opt-inline-fuel-tiny-call tiny-name 6)
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "exit")))))
    Ordinary))

;; The band MOVES a body; it does not copy one, so the blocks it lands do not
;; spend the shared growth budget the cost model draws on. The 34-block
;; absorption in `entry` is past that budget on its own, and the three
;; one-instruction leaf sites in `mid` are admitted anyway. With the moved
;; blocks charged to `added-so-far` instead they would all three be refused.
(define (compiler-optimize-inline-single-site-absorb-keeps-block-fuel-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [big-name : i64 symbols.inline-switch]
    [tiny-name : i64 symbols.external-helper]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-fuel-caller symbols.main big-name tiny-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-chain-callee
                  big-name
                  (opt-inline-wide-param-count)
                  34))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-fuel-tiny-leaf tiny-name))
                  (& (ir.compiler-ir-function-seq-empty))))))))]
    (and
      (=
        (opt-inline-wide-remaining-calls
          (ir.compiler-ir-global-shared-view optimized))
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "external_helper")
        0))))

;; Two references is not absorption. The identical callee reached from two cold
;; sites keeps its body at both: this band moves, it never copies, and the
;; duplication tier that does copy caps the body at 32.
(define (compiler-optimize-inline-single-site-two-reference-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-wide-cold-caller
              symbols.main
              callee-name
              (opt-inline-wide-param-count)))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-inline-wide-cold-caller
                  symbols.inline-loop
                  callee-name
                  (opt-inline-wide-param-count)))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-wide-callee callee-name))
                  (& (ir.compiler-ir-function-seq-empty))))))))]
    (and
      (=
        (opt-inline-wide-remaining-calls
          (opt.compiler-opt-global-shared-view optimized))
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; A callee that calls itself is refused, and refused by the reference count
;; rather than by a clause of its own: the census counts the self-call, so one
;; external caller plus one self-call is two references, not one. (The
;; call-free clause refuses it a second time; the fixture below isolates that
;; clause on a callee that is not recursive.)
(define (compiler-optimize-inline-single-site-self-recursive-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller
            symbols.main
            callee-name
            (opt-inline-wide-param-count))
          (opt-inline-wide-callee-calling callee-name callee-name)))
      1)))

;; The same wide callee with one call to an external helper in its body stays
;; out of line AT A STRAIGHT-LINE SITE: this band prices a body by counting it,
;; and a callee's own calls are a cost those counts do not carry -- the wider
;; callee-saved prologue they force at the merged entry is paid once per caller
;; invocation, and here the boundary it buys is retired once per caller
;; invocation too. The fixture below is the same callee at an in-loop site;
;; only the caller differs.
(define (compiler-optimize-inline-single-site-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller
            symbols.main
            callee-name
            (opt-inline-wide-param-count))
          (opt-inline-wide-callee-calling callee-name symbols.external-helper)))
      1)))

;; ... and at an IN-LOOP site the same call-carrying body absorbs. The imported
;; call already ran once per iteration before the move, so nothing inside the
;; iteration changes except that the boundary stops running in it. This is the
;; intern_table shape: `it-intern-slice` calls `it-hash-words`,
;; `it-grow!` and `it-map-insert-from` and absorbs into `it-bench`'s per-line
;; loop.
(define (compiler-optimize-inline-single-site-loop-site-call-bearing-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-loop-caller symbols.main callee-name)
          (opt-inline-wide-callee-calling callee-name symbols.external-helper)))
      0)))

;; An address-taken callee is refused even at one call site: the address is a
;; second way in, so the body cannot move.
(define (compiler-optimize-inline-single-site-address-taken-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-address-taken-caller symbols.main callee-name)
          (opt-inline-wide-callee callee-name)))
      1)))

;; The clause-6 pair, on the shape the cascade clause exists for. `mid` is
;; single-reference and carries no bounds check of its own, so importing the
;; bounds-carrying wide leaf hands it its first one and costs it its own inline
;; -- which is what the clause refuses. Both programs are identical except for
;; where `mid` makes the call: `opt-inline-wide-cold-caller` puts it in
;; straight-line code, `opt-inline-wide-loop-caller` puts it in a natural loop.
;; The leaf is the call-free ten-parameter body the headline fixture absorbs,
;; so the cascade clause is the only thing that can separate the two.
;;
;; The loop tier keeps this clause at both sites and has its own fixture for it
;; (compiler-optimize-inline-bounds-loop-cascade-refusal-ok?, the
;; `qs-fill`/`qs-bench` shape). That leaf takes three parameters, so the arity
;; floor keeps this band away from it entirely and the two verdicts do not
;; collide.
(define (opt-inline-single-site-cascade-clause-program
  [symbols : OptInlineMultiTestSymbols]
  [mid : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-switch-caller-named symbols symbols.inline-nonleaf))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& mid)
        (&
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-wide-callee symbols.inline-switch))
            (& (ir.compiler-ir-function-seq-empty))))))))

(define (compiler-optimize-inline-single-site-cascade-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (opt-inline-single-site-cascade-clause-program
          symbols
          (opt-inline-wide-cold-caller
            symbols.inline-nonleaf
            symbols.inline-switch
            (opt-inline-wide-param-count))))]
    [admitted : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (opt-inline-single-site-cascade-clause-program
          symbols
          (opt-inline-wide-loop-caller
            symbols.inline-nonleaf
            symbols.inline-switch)))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          refused
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          admitted
          "inline_nonleaf"
          "inline_switch")
        0))))

;; The cascade. `main` calls a wide single-site middle function, which calls the
;; wide single-site leaf. SCC order absorbs the leaf into the middle function
;; first, which makes the middle function call-free in time to be absorbed into
;; `main` in the SAME pass, so both boundaries are gone after one run.
;;
;; Reported as one number so the achieved depth is visible when it changes:
;; ten times the calls to the middle function still in `main`, plus the calls
;; to the leaf still anywhere. 0 is the full two-level cascade; 10 would be the
;; leaf absorbed but the middle function left standing.
(define (compiler-optimize-inline-single-site-cascade-depth-code) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    [mid-name : i64 symbols.inline-nonleaf]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (ir.compiler-ir-function-seq-prepend
          (&
            (opt-inline-wide-cold-caller
              symbols.main
              mid-name
              (opt-inline-wide-param-count)))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-wide-cascade-middle mid-name leaf-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-wide-callee leaf-name))
                  (& (ir.compiler-ir-function-seq-empty))))))))]
    (+
      (*
        10
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_nonleaf"))
      (+
        (opt-inline-wide-remaining-calls
          (opt.compiler-opt-global-shared-view optimized))
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")))))

;; --- sole-call absorption ---------------------------------------------------
;;
;; The tier under test admits a callee with exactly one static reference at a
;; STRAIGHT-LINE site when the callee's body is ACYCLIC, with no arity floor,
;; no body-size ceiling and no block ceiling -- LLVM's `isSoleCallToLocalFunction`
;; rule with one structural refusal. Every fixture below builds the same
;; program and varies exactly one thing.
;;
;; The leaf is `opt-inline-chain-callee`: bounds-free, call-free, acyclic, and
;; eighty blocks -- past the cost model's 32-block fuel, past the branch-chain
;; gate's 64 and past the measured tier's 64, so nothing else in this file can
;; admit it at either site; the hot-loop-leaf gate wants a cyclic body. At
;; three parameters the arity/frame-tax band is out too, so whatever these
;; fixtures admit was admitted by opt-inline-sole-call-absorb-ok? and by
;; nothing else.
(define (opt-inline-sole-call-params) : i64
  3)

(define (opt-inline-sole-call-blocks) : i64
  80)

(define (opt-inline-sole-call-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-chain-callee
    callee-name
    (opt-inline-sole-call-params)
    (opt-inline-sole-call-blocks)))

;; The identical chain with ONE back edge: the last chain block branches to
;; `chain_0` instead of falling into the exit. Same parameters, same block
;; count, same instruction shapes -- the back edge is the only difference, so a
;; verdict that changes between this leaf and the one above changed on the
;; cycle and on nothing else.
(define (opt-inline-sole-call-cyclic-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (let
    [blocks : i64 (opt-inline-sole-call-blocks)]
    (Function
      callee-name
      (opt-inline-wide-params (opt-inline-sole-call-params))
      (I64)
      (opt-inline-sole-call-params)
      (opt.opt-blocks-collect
        opt-inline-chain-blocks!
        0
        (- blocks 2)
        (ir.compiler-ir-label "chain_latch")
        (ir.compiler-ir-blocks-with-tail
          (opt-inline-chain-exit-block)
          (irt.block
            "chain_latch:
               branch %0, chain_0, chain_exit")))
      Ordinary)))

;; The same acyclic chain leaf with a call to itself in its first block. The
;; census counts that self-reference, so the callee carries two references and
;; is not class 1 -- which is exactly why the tier needs no separate recursion
;; clause.
(define (opt-inline-sole-call-self-recursive-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (let
    [params : i64 (opt-inline-sole-call-params)]
    (Function
      callee-name
      (opt-inline-wide-params params)
      (I64)
      (+ params 1)
      (ir.compiler-ir-blocks-with-tail
        (opt.opt-blocks-collect
          opt-inline-chain-blocks!
          0
          (- (opt-inline-sole-call-blocks) 1)
          (opt-inline-chain-exit-label)
          (opt-inline-chain-exit-block))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "self_entry")
          (opt-test-instrs
            (opt-inline-wide-call callee-name params params)
            (ir.CompilerIrInstr.Jump (opt-inline-chain-block-label 0)))))
      Ordinary)))

;; A straight-line caller at the tier's arity, one block, one call.
;; The same acyclic chain leaf with an `__sret` first parameter, which is what
;; makes the clone stage its arguments. Nothing else about the body changes.
(define (opt-inline-sole-call-sret-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (ir.compiler-ir-param-seq-prepend
      (Param (ir.compiler-ir-hidden-sret-param-name) (I64) 0)
      (opt-inline-wide-params-from 1 (opt-inline-sole-call-params)))
    (I64)
    (opt-inline-sole-call-params)
    (opt.opt-blocks-collect
      opt-inline-chain-blocks!
      0
      (- (opt-inline-sole-call-blocks) 1)
      (opt-inline-chain-exit-label)
      (opt-inline-chain-exit-block))
    Ordinary))

(define (opt-inline-sole-call-caller [func-name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-wide-cold-caller
    func-name
    callee-name
    (opt-inline-sole-call-params)))

;; The same caller with the callee's address taken first, and nothing else
;; changed.
(define (opt-inline-sole-call-address-taken-caller
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    5
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 4 (Function callee-name) (I64))
          (opt-inline-wide-call callee-name (opt-inline-sole-call-params) 3)
          (irt.instr "return %3"))))
    Ordinary))

;; The same caller with the call inside a natural loop: entry -> header ->
;; {body -> latch -> header, exit}, the call in `body`.
(define (opt-inline-sole-call-loop-caller [func-name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "latch:
               jump header
             exit:
               return %4")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-loop-site-entry-instrs))
      (irt.block
        "header:
             %4 = phi [%3, entry], [%5, latch] : i64
             branch %0, body, exit")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (opt-inline-wide-call callee-name (opt-inline-sole-call-params) 5)
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))))
    Ordinary))

;; The same loop with the call TWO deciding branches below the header: header
;; -> {guard_a, exit}, guard_a -> {guard_b, exit}, guard_b -> {body, exit}, the
;; call in `body`. Each guard's exit arm cannot reach the site without leaving
;; the loop, so every one of them counts toward the site's control-dependence
;; depth (see opt-inline-sole-call-loop-site-depth): the site reads 3, one past
;; opt-inline-sole-call-max-loop-depth. The guards test the two parameters the
;; header does not, so no pass can fold them into the header's own branch.
(define (opt-inline-sole-call-deep-loop-caller
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "latch:
                   jump header
                 exit:
                   return %4")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-loop-site-entry-instrs))
      (irt.block
        "header:
             %4 = phi [%3, entry], [%5, latch] : i64
             branch %0, guard_a, exit")
      (irt.block "guard_a:
               branch %1, guard_b, exit")
      (irt.block "guard_b:
                 branch %2, body, exit")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (opt-inline-wide-call callee-name (opt-inline-sole-call-params) 5)
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))))
    Ordinary))

;; The headline case: three parameters, forty blocks, one straight-line site.
;; The arity floor refuses it, the cost model's block fuel refuses it, and the
;; sole-call tier takes it anyway -- the body MOVES, so there is no growth to
;; budget and no marshalling threshold to clear.
(define (compiler-optimize-inline-sole-call-narrow-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-two-function-optimized
        (opt-inline-sole-call-caller symbols.main callee-name)
        (opt-inline-sole-call-leaf callee-name))]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch")
              0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; The one structural refusal. The identical leaf with a single back edge stays
;; out of line: a loop-carrying body absorbed into a caller compounds the
;; pressure the caller's own regions already carry, and absorptions of that
;; shape lose. See the header above opt-inline-sole-call-pressure-ok?.
(define (compiler-optimize-inline-sole-call-cyclic-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-sole-call-caller symbols.main callee-name)
          (opt-inline-sole-call-cyclic-leaf callee-name)))
      1)))

;; The same acyclic leaf at an IN-LOOP site the loop runs every iteration
;; absorbs too: the site is the loop body itself, depth 1 under
;; opt-inline-sole-call-loop-site-depth, and the boundary it retires is paid per
;; iteration (asm-render-line into asm-render-chunk's per-line loop is this
;; shape at benchmark size).
(define (compiler-optimize-inline-sole-call-loop-site-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-sole-call-loop-caller symbols.main callee-name)
          (opt-inline-sole-call-leaf callee-name)))
      0)))

;; ...and the same leaf at an in-loop site the loop takes now and then stays
;; out. Two deciding branches below the header put the site at depth 3, past
;; opt-inline-sole-call-max-loop-depth: an absorption there lands the whole body
;; inside a region the caller's allocator already prices, for a boundary the
;; loop retires on a handful of iterations (ls-apostrophe-char-end at the sixth
;; arm of ls-tokenize's dispatch is this shape).
(define (compiler-optimize-inline-sole-call-loop-site-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-sole-call-deep-loop-caller symbols.main callee-name)
          (opt-inline-sole-call-leaf callee-name)))
      1)))

;; Two references is not a sole call. The identical leaf reached from two
;; straight-line sites keeps its body at both: this tier moves, it never copies.
(define (compiler-optimize-inline-sole-call-two-reference-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-sole-call-caller symbols.main callee-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-sole-call-caller symbols.inline-loop callee-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-sole-call-leaf callee-name))
                  (& (ir.compiler-ir-function-seq-empty))))))))]
    (and
      (=
        (opt-inline-wide-remaining-calls
          (opt.compiler-opt-global-shared-view optimized))
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; An address-taken callee is refused at one call site: the address is a second
;; way in, so the body cannot move and the function cannot be pruned.
(define (compiler-optimize-inline-sole-call-address-taken-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-sole-call-address-taken-caller symbols.main callee-name)
          (opt-inline-sole-call-leaf callee-name)))
      1)))

;; A directly recursive callee is refused with no clause of its own: its own
;; call is a second static reference, so the census never calls it class 1.
(define (compiler-optimize-inline-sole-call-self-recursive-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-sole-call-caller symbols.main callee-name)
          (opt-inline-sole-call-self-recursive-leaf callee-name)))
      1)))

;; A callee with no body in the program's function sequence -- which is exactly
;; what an extern is, since externs live in their own sequence and the inliner
;; walks only functions -- keeps its call. The census resolves no slot, so the
;; reference count is 0 and the absorb class is 0.
(define (compiler-optimize-inline-sole-call-extern-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-optimized
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-sole-call-caller symbols.main symbols.inline-switch))
            (& (ir.compiler-ir-function-seq-empty)))))
      1)))

;; The middle link: a straight-line, single-site, multiblock caller that itself
;; calls the acyclic leaf, at the tier's arity and with an acyclic body of its
;; own.
;; The fail-closed staged-argument refusal. The identical leaf with an `__sret`
;; parameter stays out of line: the clone's staged path is where the recorded
;; wrong-code reproducer lives (see the note under
;; opt-inline-sole-call-absorb-ok?), so this tier does not go there. A callee
;; that writes its own parameter slots is refused by the same clause.
(define (compiler-optimize-inline-sole-call-staged-args-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-sole-call-caller symbols.main callee-name)
          (opt-inline-sole-call-sret-leaf callee-name)))
      1)))

(define (opt-inline-sole-call-middle [func-name : i64] [leaf-name : i64]) : ir.CompilerIrFunction
  (let
    [params : i64 (opt-inline-sole-call-params)]
    (Function
      func-name
      (opt-inline-wide-params params)
      (I64)
      (+ params 1)
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks "exit:
             return %3")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (opt-test-instrs
            (opt-inline-wide-call leaf-name params params)
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "exit")))))
      Ordinary)))

;; Two-level absorption: `main` calls the middle function, which calls the leaf.
;; SCC order rewrites the leaf's caller before the caller's caller, so the leaf
;; lands in the middle function first and the MERGED middle function is what
;; `main` then absorbs -- both boundaries gone in one pass, with the middle
;; function's phi predecessors renamed twice.
;;
;; Reported as one number so the achieved depth stays visible when it changes:
;; ten times the calls to the middle function still in `main`, plus the calls to
;; the leaf still anywhere, plus one hundred if the merged `main` fails the
;; structural check that the pred renames and cloned labels are consistent. 0 is
;; the full two-level cascade with a well-formed result.
(define (compiler-optimize-inline-sole-call-cascade-depth-code) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    [mid-name : i64 symbols.inline-nonleaf]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-sole-call-caller symbols.main mid-name))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-sole-call-middle mid-name leaf-name))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-sole-call-leaf leaf-name))
                  (& (ir.compiler-ir-function-seq-empty))))))))]
    [structure-penalty : i64
      (match (opt-function-seq-find optimized "main")
        [(Some main)
          (if (opt.opt-inline-structure-ok? (& (opt.opt-function-blocks main)))
            0
            100)]
        [(No) 100])]
    (+
      structure-penalty
      (+
        (*
          10
          (opt-count-direct-call-name-function-seq
            optimized
            "main"
            "inline_nonleaf"))
        (+
          (opt-inline-wide-remaining-calls
            (opt.compiler-opt-global-shared-view optimized))
          (opt-count-direct-call-name-function-seq
            optimized
            "inline_nonleaf"
            "inline_switch"))))))

;; --- shared acyclic accessor admission --------------------------------------
;;
;; The callee under test is an ACYCLIC bounds-carrying Switch leaf reached from
;; several in-loop sites -- the pl-byte-at shape. Every fixture below
;; builds the same program and varies exactly one thing: the number of callers
;; (the reference floor), whether the body makes a call, whether the body is
;; cyclic, and whether the sites sit in loops.
(define (opt-inline-shared-accessor-leaf-named
  [callee-name : i64]
  [vars : i64]
  [zero-instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-switch-params)
    (I64)
    vars
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "one:
             jump join
           other:
             jump join
           join:
             %3 = phi [10, zero], [20, one], [30, other] : i64
             return %3")
      (irt.block
        "entry:
           bounds_check %1, %2 message \"switch_bounds_ok\"
           switch %0 base 0 [0:zero, 1:one] default other")
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "zero") zero-instrs))
    Ordinary))

(define (opt-inline-shared-accessor-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-shared-accessor-leaf-named
    callee-name
    4
    (opt-inline-dup-leaf-jump-zero-instrs)))

(define (opt-inline-shared-accessor-calling-leaf
  [callee-name : i64]
  [helper-name : i64]) : ir.CompilerIrFunction
  (opt-inline-shared-accessor-leaf-named
    callee-name
    5
    (opt-inline-dup-leaf-call-zero-instrs helper-name)))

;; The same cyclic body with one call in its `zero` case: refused by the
;; accessor's call-free pricing clause and by the hot loop leaf's.
(define (opt-inline-shared-cyclic-calling-leaf
  [callee-name : i64]
  [helper-name : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-switch-params)
    (I64)
    5
    (ir.compiler-ir-blocks
      (irt.block "entry:
           jump loop")
      (irt.block
        "loop:
             switch %0 base 0 [0:zero, 1:one] default loop")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "zero")
        (opt-inline-dup-leaf-call-zero-instrs helper-name))
      (irt.block "one:
                 jump join")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "join")
        (opt-test-instrs
          (opt-inline-switch-loop-phi-instr)
          (irt.instr "return %3"))))
    Ordinary))

;; Straight-line callers, for the site clause.
(define (opt-inline-shared-flat-caller-chain
  [names : (__tl_dyn-array i64)]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-inline-shared-flat-caller-chain-from (& names) 0 callee-name tail))

(define (opt-inline-shared-flat-caller-chain-from
  [names : (& names (__tl_dyn-array i64))]
  [at : i64]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (if (>= at (array-length names))
    tail
    (let
      [name : i64 (array-ref names at)]
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            name
            (opt-inline-switch-params)
            (I64)
            4
            (ir.compiler-ir-blocks
              (ir.CompilerIrBlock.Block
                (ir.compiler-ir-label "entry")
                (opt-test-instrs
                  (opt-inline-switch-caller-call-named callee-name)
                  (irt.instr "return %3"))))
            Ordinary))
        (&
          (opt-inline-shared-flat-caller-chain-from
            names
            (+ at 1)
            callee-name
            tail))))))

(define (opt-inline-shared-caller-names
  [symbols : OptInlineMultiTestSymbols]
  [count : i64]) : (__tl_dyn-array i64)
  (let
    [all : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [names : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [i : i64 0]
    (set! (array-ref all 0) symbols.main)
    (set! (array-ref all 1) symbols.inline-nonleaf)
    (set! (array-ref all 2) symbols.inline-loop)
    (set! (array-ref all 3) symbols.mb-bounds)
    (set! (array-ref all 4) symbols.inline-branch)
    (while (< i count)
      ;; Newest first, as the callers were listed before.
      (set! (array-ref names (- (- count 1) i)) (array-ref all i))
      (set! i (+ i 1)))
    names))

;; Total direct calls to `call-name` left across the first `count` caller names.
(define (opt-inline-shared-remaining-calls
  [functions : ir.CompilerIrFunctionSeq]
  [count : i64]) : i64
  (let
    [names : (__tl_dyn-array String) (__tl_make-array String 5)]
    [total : i64 0]
    [i : i64 0]
    (set! (array-ref names 0) "main")
    (set! (array-ref names 1) "inline_nonleaf")
    (set! (array-ref names 2) "inline_loop")
    (set! (array-ref names 3) "mb_bounds")
    (set! (array-ref names 4) "inline_branch")
    (while (< i count)
      (set!
        total
        (+
          total
          (opt-count-direct-call-name-function-seq
            functions
            (opt.compiler-opt-global-array-element-shared-view names i)
            "inline_switch")))
      (set! i (+ i 1)))
    total))

(define (opt-inline-shared-accessor-optimized
  [symbols : OptInlineMultiTestSymbols]
  [count : i64]
  [in-loop? : bool]
  [leaf : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (let
    [callee-name : i64 symbols.inline-switch]
    [names : (__tl_dyn-array i64)
      (opt-inline-shared-caller-names symbols count)]
    [tail : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (& leaf)
        (& (ir.compiler-ir-function-seq-empty)))]
    (opt-test-inline-program-functions
      (ast.ast-node-pool-reader-type-segment-bases)
      (if in-loop?
        (opt-inline-dup-caller-chain names callee-name tail)
        (opt-inline-shared-flat-caller-chain names callee-name tail))
      2)))

;; Five in-loop callers put the leaf at the reference floor and every site takes
;; it; four leave it one short and every site keeps its call.
(define (compiler-optimize-inline-shared-accessor-floor-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : ir.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        true
        (opt-inline-shared-accessor-leaf callee-name))]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        4
        true
        (opt-inline-shared-accessor-leaf callee-name))]
    (and
      (= (opt-inline-shared-remaining-calls admitted 5) 0)
      (= (opt-inline-shared-remaining-calls refused 4) 4))))

;; The same leaf with one call in its body stays out of line at all five sites:
;; this band copies one body into every site, so the cost a callee's own calls
;; carry is paid five times over and its model cannot see any of it.
(define (compiler-optimize-inline-shared-accessor-call-free-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        true
        (opt-inline-shared-accessor-calling-leaf
          callee-name
          symbols.external-helper))]
    (= (opt-inline-shared-remaining-calls refused 5) 5)))

;; A cyclic CALL-BEARING body at the same five in-loop sites stays refused:
;; this admission is for the acyclic accessor, and the hot loop leaf's
;; call-free pricing clause refuses the cyclic shape from the other side. A
;; cyclic call-free leaf at these sites is not refused anywhere -- it is
;; exactly what opt-inline-hot-loop-leaf-ok? admits, and that is covered by the
;; hot-loop-leaf tests below.
(define (compiler-optimize-inline-shared-accessor-acyclic-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        true
        (opt-inline-shared-cyclic-calling-leaf
          callee-name
          symbols.external-helper))]
    (= (opt-inline-shared-remaining-calls refused 5) 5)))

;; The identical leaf at five STRAIGHT-LINE sites stays refused: a boundary that
;; runs once per call cannot repay a duplicated body.
(define (compiler-optimize-inline-shared-accessor-in-loop-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        false
        (opt-inline-shared-accessor-leaf callee-name))]
    (= (opt-inline-shared-remaining-calls refused 5) 5)))

;; --- dominant-reference accessors at straight-line sites ---------------------
;;
;; Same leaf, same straight-line callers as the refusal directly above; the only
;; thing that varies is how many of them there are. Below
;; opt-inline-shared-accessor-dominant-min-refcount the per-site loop clause
;; still refuses every one; at the floor the callee's own weight is the
;; argument and every site takes it.
(define (opt-inline-dominant-caller-text [index : i64]) : String
  (str_cat.str-cat "dominant_caller_" (string.int->string index)))

(define (opt-inline-dominant-caller-names-from [index : i64] [count : i64]) : (__tl_dyn-array
    i64)
  (let
    [names : (__tl_dyn-array i64)
      (__tl_make-array
        i64
        (if (> count index)
          (- count index)
          0))]
    [at : i64 index]
    (while (< at count)
      (set!
        (array-ref names (- at index))
        (opt-test-symbol (opt-inline-dominant-caller-text at)))
      (set! at (+ at 1)))
    names))

(define (opt-inline-dominant-remaining-calls
  [functions : ir.CompilerIrFunctionSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    0
    (+
      (opt-count-direct-call-name-function-seq
        functions
        (opt-inline-dominant-caller-text index)
        "inline_switch")
      (opt-inline-dominant-remaining-calls functions (+ index 1) count))))

(define (opt-inline-dominant-optimized [callee-name : i64] [count : i64]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-inline-shared-flat-caller-chain
      (opt-inline-dominant-caller-names-from 0 count)
      callee-name
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-shared-accessor-leaf callee-name))
        (& (ir.compiler-ir-function-seq-empty))))
    2))

;; 64 straight-line callers put the leaf at the dominant floor and every site
;; takes it; 63 leave it one short and every site keeps its call. This is the
;; one clause the two counts differ in: the sites, the leaf, and every budget
;; are identical.
(define (compiler-optimize-inline-shared-accessor-dominant-floor-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : ir.CompilerIrFunctionSeq
      (opt-inline-dominant-optimized callee-name 64)]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-dominant-optimized callee-name 63)]
    (and
      (= (opt-inline-dominant-remaining-calls admitted 0 64) 0)
      (= (opt-inline-dominant-remaining-calls refused 0 63) 63))))

;; A CALL-BEARING body at the dominant floor stays refused at all 64 sites: the
;; floor relaxes the two per-site questions, not the pricing clause that keeps
;; a copied body's own calls out of a model that cannot count them.
(define (compiler-optimize-inline-shared-accessor-dominant-call-free-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-shared-flat-caller-chain
          (opt-inline-dominant-caller-names-from 0 64)
          callee-name
          (ir.compiler-ir-function-seq-prepend
            (&
              (opt-inline-shared-accessor-calling-leaf
                callee-name
                symbols.external-helper))
            (& (ir.compiler-ir-function-seq-empty))))
        2)]
    (= (opt-inline-dominant-remaining-calls refused 0 64) 64)))

;; --- dominant accessors reached by loop-depth weight -------------------------
;;
;; The tier above is entered on 64 counted references. It is also entered on 64
;; WEIGHTED references, where a site inside one loop weighs 8 and a site inside
;; a nested loop weighs 64 (opt-inline-census-depth-weight). Two sites at depth
;; two therefore clear the same floor that took 64 straight-line sites.
;;
;; The leaf below is built to be refused by every other band, so these fixtures
;; isolate exactly the weighted entrance:
;;
;;   - eight blocks, so the duplication band's 32/6 refuses it on block count
;;     and the cost model prices it at 12 + 6*9 against a threshold of 4;
;;   - one block holding four instructions, so the branch-chain gate's
;;     three-instruction block cap refuses it;
;;   - two static references, so the shared tier's raw floor of five refuses it.
;;     The hot-loop-leaf gate's reference clause begins at one, so what keeps
;;     the leaf out of that band is its LAST clause -- the body is acyclic, and
;;     the band takes only genuinely cyclic ones. That makes this fixture the
;;     acyclic clause's pin: if the band ever stopped asking, the
;;     one-loop-shallower refusal below would start admitting;
;;   - bounds-free, acyclic and call-free, so nothing above refuses it for a
;;     reason the weighted entrance does not own.
(define (opt-inline-depth-leaf-zero-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%4 = mov 1 : i64
     %5 = mov 2 : i64
     %6 = mov 3 : i64
     jump join"))

(define (opt-inline-depth-relay-label [index : i64]) : i64
  (ir.compiler-ir-label
    (& (str_cat.str-cat "relay" (string.int->string index)))))

;; `other` -> relay_0 -> ... -> relay_{count-1} -> join. The chain length is the
;; only thing separating the admitted leaf from the oversize one.
(define (opt-inline-depth-relay-blocks!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [index : i64]
  [count : i64]
  [tail : ir.CompilerIrBlockList]) : unit
  (if (>= index count)
    (ir.compiler-ir-block-builder-append-list! out tail)
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-depth-relay-label index)
          (opt-test-instrs
            (ir.CompilerIrInstr.Jump
              (if (= (+ index 1) count)
                (ir.compiler-ir-label "join")
                (opt-inline-depth-relay-label (+ index 1)))))))
      (opt-inline-depth-relay-blocks! out (+ index 1) count tail))))

(define (opt-inline-depth-leaf-join-block [relays : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "join")
      (opt-test-instrs
        (ir.CompilerIrInstr.Phi
          3
          (ir.compiler-ir-phi-input-seq-prepend
            (I64 10)
            (ir.compiler-ir-label "zero")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (I64 20)
                (ir.compiler-ir-label "one")
                (&
                  (ir.compiler-ir-phi-input-seq-prepend
                    (I64 30)
                    (opt-inline-depth-relay-label (- relays 1))
                    (& (ir.compiler-ir-phi-input-seq-empty)))))))
          (I64))
        (irt.instr "return %3")))))

(define (opt-inline-depth-relay-block
  [label : String]
  [target : String]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    tail
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label (& label))
      (opt-test-instrs
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label (& target)))))))

;; `entry-instrs` and the relay count are the only things the bounds-carrying
;; and oversize variants change, so all three leaves share one block chain.
(define (opt-inline-depth-leaf-named
  [callee-name : i64]
  [entry-instrs : ir.CompilerIrInstrSeq]
  [relays : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-switch-params)
    (I64)
    7
    (ir.compiler-ir-blocks-with-tail
      (opt-inline-depth-relay-block
        "one"
        "join"
        (opt-inline-depth-relay-block
          "other"
          "relay0"
          (opt.opt-blocks-collect
            opt-inline-depth-relay-blocks!
            0
            relays
            (opt-inline-depth-leaf-join-block relays))))
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") entry-instrs)
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "zero")
        (opt-inline-depth-leaf-zero-instrs)))
    Ordinary))

(define (opt-inline-depth-leaf-switch-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "switch %0 base 0 [0:zero, 1:one] default other"))

(define (opt-inline-depth-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-depth-leaf-named
    callee-name
    (opt-inline-depth-leaf-switch-instrs)
    3))

;; The identical leaf plus one bounds check. The weighted entrance was once
;; closed to this class and is now open to it; the leaf pins that the bounds
;; check is not what decides the verdict -- the weight is.
(define (opt-inline-depth-bounds-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-depth-leaf-named
    callee-name
    (opt-test-instrs-with-tail
      (opt-inline-depth-leaf-switch-instrs)
      (irt.instr "bounds_check %1, %2 message \"switch_bounds_ok\""))
    3))

;; The identical leaf past the accessor block ceiling: the weighted entrance
;; relaxes which references count as dominant, never the size bands.
(define (opt-inline-depth-oversize-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-depth-leaf-named
    callee-name
    (opt-inline-depth-leaf-switch-instrs)
    6))

;; entry -> outer_header -> {inner_pre -> inner_header -> {inner_body ->
;; inner_latch -> inner_header, outer_latch -> outer_header}, exit}. The call
;; sits in `inner_body`, two loops deep, so its census weight is 8*8.
(define (opt-inline-depth-nested-caller-blocks [callee-name : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (opt-inline-depth-relay-block
      "inner_pre"
      "inner_header"
      (ir.compiler-ir-blocks-with-tail
        (irt.blocks
          "inner_latch:
                 jump inner_header
               outer_latch:
                 jump outer_header
               exit:
                 return %4")
        (irt.block
          "inner_header:
               branch %1, inner_body, outer_latch")
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "inner_body")
          (opt-test-instrs
            (opt-inline-loop-site-call callee-name 5)
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "inner_latch"))))))
    (irt.block "entry:
         %3 = mov 0 : i64
         jump outer_header")
    (irt.block
      "outer_header:
           %4 = phi [%3, entry], [%5, outer_latch] : i64
           branch %0, inner_pre, exit")))

(define (opt-inline-depth-nested-caller [func-name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (opt-inline-depth-nested-caller-blocks callee-name)
    Ordinary))

(define (opt-inline-depth-caller-chain
  [names : (__tl_dyn-array i64)]
  [callee-name : i64]
  [nested? : bool]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-inline-depth-caller-chain-from (& names) 0 callee-name nested? tail))

(define (opt-inline-depth-caller-chain-from
  [names : (& names (__tl_dyn-array i64))]
  [at : i64]
  [callee-name : i64]
  [nested? : bool]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (if (>= at (array-length names))
    tail
    (let
      [name : i64 (array-ref names at)]
      (ir.compiler-ir-function-seq-prepend
        (&
          (if nested?
            (opt-inline-depth-nested-caller name callee-name)
            (opt-inline-loop-site-function
              name
              callee-name
              (opt-inline-loop-site-entry-instrs))))
        (&
          (opt-inline-depth-caller-chain-from
            names
            (+ at 1)
            callee-name
            nested?
            tail))))))

(define (opt-inline-depth-optimized
  [callee-name : i64]
  [nested? : bool]
  [leaf : ir.CompilerIrFunction]) : ir.CompilerIrFunctionSeq
  (opt-test-inline-program-functions
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-inline-depth-caller-chain
      (opt-inline-dominant-caller-names-from 0 2)
      callee-name
      nested?
      (ir.compiler-ir-function-seq-prepend
        (& leaf)
        (& (ir.compiler-ir-function-seq-empty))))
    2))

;; Two nested-loop sites weigh 128 and take the leaf; the identical leaf at two
;; SINGLE-loop sites weighs 16 and keeps both calls. Nothing but the loop depth
;; of the two call sites differs -- same leaf, same reference count, same
;; budgets, both sites inside a loop either way.
(define (compiler-optimize-inline-accessor-depth-weight-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : ir.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        true
        (opt-inline-depth-leaf callee-name))]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        false
        (opt-inline-depth-leaf callee-name))]
    (and
      (= (opt-inline-dominant-remaining-calls admitted 0 2) 0)
      (= (opt-inline-dominant-remaining-calls refused 0 2) 2))))

;; A body past the accessor block ceiling stays out of line at the same two
;; nested-loop sites: the weighted count changes which references are dominant,
;; never how big an admitted body may be.
(define (compiler-optimize-inline-accessor-depth-oversize-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        true
        (opt-inline-depth-oversize-leaf callee-name))]
    (= (opt-inline-dominant-remaining-calls refused 0 2) 2)))

;; The identical leaf carrying one bounds check is admitted at the same two
;; nested-loop sites, and refused one loop shallower: the weighted entrance does
;; not demand a bounds-free callee. What holds the line for this leaf is the
;; floor itself: two sites one loop shallower weigh 16, not 128, and keep both
;; calls.
(define (compiler-optimize-inline-accessor-depth-bounds-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : ir.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        true
        (opt-inline-depth-bounds-leaf callee-name))]
    [refused : ir.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        false
        (opt-inline-depth-bounds-leaf callee-name))]
    (and
      (= (opt-inline-dominant-remaining-calls admitted 0 2) 0)
      (= (opt-inline-dominant-remaining-calls refused 0 2) 2))))

;; Multiple latches targeting one header are alternative backedges of the same
;; loop, not nested loops. The old difference marker added one level per edge,
;; so the header/body below incorrectly received depth 2 and could admit an
;; accessor at nested-loop weight solely because the loop had two `continue`
;; paths.
(define (opt-inline-depth-multi-latch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump header
     header:
       branch %0, body, exit
     body:
       branch %1, latch-a, latch-b
     latch-a:
       jump header
     latch-b:
       jump header
     exit:
       return"))

(define (compiler-optimize-inline-depth-multiple-latches-ok?) : bool
  (opt.opt-inline-census-depths-build!
    (& (opt-inline-depth-multi-latch-blocks)))
  (and
    (= (opt.opt-inline-census-depth-at 0) 0)
    (= (opt.opt-inline-census-depth-at 1) 1)
    (= (opt.opt-inline-census-depth-at 2) 1)
    (= (opt.opt-inline-census-depth-at 3) 1)
    (= (opt.opt-inline-census-depth-at 4) 1)
    (= (opt.opt-inline-census-depth-at 5) 0)))

;; --- branch-chain classifiers ------------------------------------------------
;;
;; The callee under test is a bounds-free acyclic decision chain: five
;; compare-and-branch blocks over one parameter, each arm jumping to a shared
;; join. It is twelve instructions in twelve blocks, so the duplication band's
;; 32/6 refuses it on block count alone and the cost model prices it at
;; 12 + 6*13 with no absorb credit to spend. Two in-loop callers hold it, the
;; same shape opt-inline-dup-absorb-ok? serves.
(define (opt-inline-chain-hit-label [index : i64]) : i64
  (ir.compiler-ir-label (& (str_cat.str-cat "hit" (string.int->string index)))))

(define (opt-inline-chain-test-label [index : i64]) : i64
  (if (= index 0)
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-label
      (& (str_cat.str-cat "chain" (string.int->string index))))))

;; hit_i and the miss block all reach `join`, so the phi carries one input per
;; arm. Built newest-first from the miss edge inward.
(define (opt-inline-chain-phi-inputs [index : i64] [arms : i64]) : ir.CompilerIrPhiInputSeq
  (if (< index 0)
    (ir.compiler-ir-phi-input-seq-prepend
      (I64 0)
      (ir.compiler-ir-label "miss")
      (& (ir.compiler-ir-phi-input-seq-empty)))
    (ir.compiler-ir-phi-input-seq-prepend
      (I64 1)
      (opt-inline-chain-hit-label index)
      (& (opt-inline-chain-phi-inputs (- index 1) arms)))))

(define (opt-inline-chain-hit-blocks!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [index : i64]
  [arms : i64]
  [tail : ir.CompilerIrBlockList]) : unit
  (if (>= index arms)
    (ir.compiler-ir-block-builder-append-list! out tail)
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-chain-hit-label index)
          (irt.instrs "jump join")))
      (opt-inline-chain-hit-blocks! out (+ index 1) arms tail))))

(define (opt-inline-chain-test-blocks!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [index : i64]
  [arms : i64]
  [tail : ir.CompilerIrBlockList]) : unit
  (if (>= index arms)
    (ir.compiler-ir-block-builder-append-list! out tail)
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-chain-test-label index)
          (opt-test-instrs
            (ir.CompilerIrInstr.Branch
              (Var 0)
              (opt-inline-chain-hit-label index)
              (if (= (+ index 1) arms)
                (ir.compiler-ir-label "miss")
                (opt-inline-chain-test-label (+ index 1)))))))
      (opt-inline-chain-test-blocks! out (+ index 1) arms tail))))

;; `padding` is prepended to the miss block: zero for the chain shape, four
;; movs for the merge-web shape, which is the only thing that separates the two
;; fixtures below.
(define (opt-inline-chain-pad-instrs
  [count : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (<= count 0)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-chain-pad-instrs (- count 1) tail)
      (ir.CompilerIrInstr.Mov (+ 3 count) (I64 count) (I64)))))

(define (opt-inline-chain-leaf [callee-name : i64] [arms : i64] [padding : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-switch-params)
    (I64)
    (+ 4 padding)
    (opt.opt-blocks-collect
      opt-inline-chain-test-blocks!
      0
      arms
      (opt.opt-blocks-collect
        opt-inline-chain-hit-blocks!
        0
        arms
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "miss")
            (opt-inline-chain-pad-instrs padding (irt.instrs "jump join")))
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "join")
            (opt-test-instrs
              (ir.CompilerIrInstr.Phi
                3
                (opt-inline-chain-phi-inputs (- arms 1) arms)
                (I64))
              (irt.instr "return %3"))))))
    Ordinary))

(define (opt-inline-chain-remaining-calls
  [functions : ir.CompilerIrFunctionSeq]) : i64
  (+
    (opt-count-direct-call-name-function-seq functions "main" "inline_switch")
    (opt-count-direct-call-name-function-seq
      functions
      "inline_nonleaf"
      "inline_switch")))

;; Twelve instructions in twelve blocks, no block above one instruction: the
;; block cap is the only thing refusing it, and the chain gate is what admits
;; it at both in-loop sites.
(define (compiler-optimize-inline-branch-chain-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-chain-leaf callee-name 5 0))]
    (= (opt-inline-chain-remaining-calls optimized) 0)))

;; The same block count and the same in-loop sites, with four movs moved into
;; one block. Sixteen instructions is still far inside every band; the body is
;; no longer a chain, so it stays refused at both sites -- the block cap's job.
(define (compiler-optimize-inline-branch-chain-merge-web-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-chain-leaf callee-name 5 4))]
    (= (opt-inline-chain-remaining-calls optimized) 2)))

;; --- hot loop leaves ---------------------------------------------------------
;;
;; The callee under test is the cyclic bounds-carrying Switch leaf again, at
;; three references and up. Every fixture below varies exactly one clause of
;; opt-inline-hot-loop-leaf-ok?; the single-reference fixtures at the end of the
;; family cover the single-reference class.
;; Three in-loop callers of the call-free leaf: every site takes a copy, and
;; the leaf stays in the program only while sites remain (here: none do).
(define (compiler-optimize-inline-hot-loop-leaf-three-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-plain callee-name))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        0))))

;; The identical leaf with one call in its body stays out of line at all three
;; sites: this band copies the biggest bodies of any into loop sites, and a
;; callee's own calls are exactly the cost its instruction and block counts
;; cannot carry.
(define (compiler-optimize-inline-hot-loop-leaf-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; A pad chain for the too-big leaf: var 4 anchors it, each BinOp feeds the
;; next, and the chain ends in the case block's jump.
(define (opt-inline-hot-loop-big-leaf-pad-from
  [var : i64]
  [remaining : i64]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (<= remaining 0)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from (+ var 1) (- remaining 1) tail)
      (ir.CompilerIrInstr.BinOp var (Add) (Var (- var 1)) (I64 1) (I64)))))

;; The same leaf shape at 135 body instructions -- one past
;; opt-inline-hot-loop-leaf-max-body -- still call-free, still cyclic, still at
;; three in-loop sites.
(define (opt-inline-hot-loop-big-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    (+ 6 128)
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from
        5
        128
        (opt-inline-dup-leaf-jump-zero-instrs))
      (ir.CompilerIrInstr.Mov 4 (I64 0) (I64)))))

(define (compiler-optimize-inline-hot-loop-leaf-too-big-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-big-leaf callee-name))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; A big-tier leaf: 41 body instructions -- above the legacy 32/6 band, inside
;; the hot-loop-leaf band -- still call-free and cyclic.
(define (opt-inline-hot-loop-mid-leaf [callee-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    (+ 6 34)
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from
        5
        34
        (opt-inline-dup-leaf-jump-zero-instrs))
      (ir.CompilerIrInstr.Mov 4 (I64 0) (I64)))))

;; Three small in-loop callers of the big-tier leaf: a caller small enough
;; that the imported loop effectively replaces its body takes the copy at an
;; in-loop site (the gvn-facts-grow shape).
(define (compiler-optimize-inline-hot-loop-leaf-in-loop-small-caller-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-mid-leaf callee-name))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        0))))

;; A jump-block pad chain for the big caller: entry -> pad0 -> ... -> header.
(define (opt-inline-hot-loop-pad-label [index : i64]) : i64
  (ir.compiler-ir-label (& (str_cat.str-cat "pad" (string.int->string index)))))

(define (opt-inline-hot-loop-pad-blocks-from!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [index : i64]
  [count : i64]
  [tail : ir.CompilerIrBlockList]) : unit
  (if (>= index count)
    (ir.compiler-ir-block-builder-append-list! out tail)
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-hot-loop-pad-label index)
          (opt-test-instrs
            (ir.CompilerIrInstr.Jump
              (if (< (+ index 1) count)
                (opt-inline-hot-loop-pad-label (+ index 1))
                (ir.compiler-ir-label "header"))))))
      (opt-inline-hot-loop-pad-blocks-from! out (+ index 1) count tail))))

;; The in-loop caller shape, grown past opt-inline-hot-loop-leaf-max-caller-blocks
;; by twelve jump blocks between entry and header: the call is still in the
;; loop, but the caller's own working set dwarfs the import.
(define (opt-inline-hot-loop-big-caller-function
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    6
    (ir.compiler-ir-blocks-with-tail
      (opt.opt-blocks-collect
        opt-inline-hot-loop-pad-blocks-from!
        0
        12
        (ir.compiler-ir-blocks-with-tail
          (irt.blocks
            "latch:
                 jump header
               exit:
                 return %4")
          (irt.block
            "header:
               %4 = phi [%3, pad11], [%5, latch] : i64
               branch %0, body, exit")
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "body")
            (opt-test-instrs
              (opt-inline-loop-site-call callee-name 5)
              (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch"))))))
      (irt.block "entry:
           %3 = mov 0 : i64
           jump pad0"))
    Ordinary))

(define (opt-inline-hot-loop-big-caller-chain
  [names : (__tl_dyn-array i64)]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-inline-hot-loop-big-caller-chain-from (& names) 0 callee-name tail))

(define (opt-inline-hot-loop-big-caller-chain-from
  [names : (& names (__tl_dyn-array i64))]
  [at : i64]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (if (>= at (array-length names))
    tail
    (let
      [name : i64 (array-ref names at)]
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-hot-loop-big-caller-function name callee-name))
        (&
          (opt-inline-hot-loop-big-caller-chain-from
            names
            (+ at 1)
            callee-name
            tail))))))

;; The same big-tier leaf at the same in-loop sites inside 17-block callers:
;; above the caller-size cap the import would tax the caller loop's
;; allocation (the pl-run-chunk shape), so every site keeps its call.
(define (compiler-optimize-inline-hot-loop-leaf-in-loop-big-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-hot-loop-big-caller-chain
          (opt-inline-dup-three-caller-names symbols)
          callee-name
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-hot-loop-mid-leaf callee-name))
            (& (ir.compiler-ir-function-seq-empty))))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; Three STRAIGHT-LINE callers with no loop of their own: the imported loop
;; becomes each caller's only one, so no caller loop's allocation is there to
;; lengthen, and every site takes a copy.
(define (compiler-optimize-inline-hot-loop-leaf-loop-free-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        3
        false
        (opt-inline-dup-leaf-plain callee-name))]
    (= (opt-inline-shared-remaining-calls optimized 3) 0)))

;; --- INL-7: the loop a loop-free caller has not been given yet ---------------
;;
;; The tier directly above rests on "the imported loop becomes the caller's ONLY
;; one", read off the caller's natural loops. The inliner ran BEFORE
;; opt-tailrec-function (then the per-function pipeline's first pass; INL-11 now
;; runs it ahead of the inliner), which turns a self tail-call into a back edge
;; to the entry block. So a
;; self-tail-recursive caller presents here with an empty natural-loop set and
;; leaves with a loop around its whole body, and an import admitted on the
;; strength of the empty set lands inside it.
;;
;; These callers are the two answers, and they differ in exactly the property
;; opt-inline-caller-loop-free? now reads: the same straight-line entry block
;; with the same site, with and without a self tail-call behind a branch. The
;; branch is what keeps the recursive shape's site straight-line -- the caller
;; still has no natural loop, which is the whole point.
(define (opt-inline-recursive-caller-self-args) : ir.CompilerIrCallArgs
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 3)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (set! (array-ref args 1) (ir.CompilerIrValue.Var 1))
    (set! (array-ref args 2) (ir.CompilerIrValue.Var 2))
    (Array args)))

(define (opt-inline-recursive-caller-blocks
  [self-name : i64]
  [callee-name : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "done:
           return %3")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-inline-switch-caller-call-named callee-name)
        (irt.instr "branch %0, recur, done")))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "recur")
      (opt-test-instrs
        (ir.CompilerIrInstr.TailCall
          self-name
          (opt-inline-recursive-caller-self-args)
          (I64))))))

(define (opt-inline-recursive-caller-function
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    4
    (opt-inline-recursive-caller-blocks func-name callee-name)
    Ordinary))

(define (opt-inline-recursive-caller-chain
  [names : (__tl_dyn-array i64)]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-inline-recursive-caller-chain-from (& names) 0 callee-name tail))

(define (opt-inline-recursive-caller-chain-from
  [names : (& names (__tl_dyn-array i64))]
  [at : i64]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (if (>= at (array-length names))
    tail
    (let
      [name : i64 (array-ref names at)]
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-recursive-caller-function name callee-name))
        (&
          (opt-inline-recursive-caller-chain-from
            names
            (+ at 1)
            callee-name
            tail))))))

;; The same big-tier cyclic leaf as the loop-free positive directly above, at
;; the same three sites, in callers that call themselves. The caller's self
;; tail-call becomes a back edge ahead of the inline stage (INL-11), so each
;; caller presents its loop, the site reads in-loop, and the in-loop tier
;; admits the leaf under its own gates (the caller is three blocks, well inside
;; opt-inline-hot-loop-leaf-max-caller-blocks), so every site takes the copy.
;; Nothing else about the program differs -- the leaf, the reference count, the
;; site's block and every budget are identical to the positive above -- so this
;; pair is the rewrite's ordering and only that. (sccp_lattice's
;; `sccp-rewrite-phi` into `sccp-rewrite-rows` is the shape at benchmark size,
;; and it stays out there on SIZE: the in-loop tier's own gates refuse it, see
;; the `sccp-rewrite-phi-import-*` cases in tests/codegen/asm-shape.cases.)
(define (compiler-optimize-inline-hot-loop-leaf-recursive-caller-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-recursive-caller-chain
          (opt-inline-shared-caller-names symbols 3)
          callee-name
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-dup-leaf-plain callee-name))
            (& (ir.compiler-ir-function-seq-empty))))
        2)]
    (= (opt-inline-shared-remaining-calls optimized 3) 0)))

;; ...and the clause itself, on the three caller shapes it has to tell apart,
;; with the value `--trace-passes` prints as the band line's `caller-rec=` field
;; asserted beside each answer. A straight-line caller is loop-free and is not
;; recursive; the same caller with a self tail-call behind a branch is STILL
;; free of natural loops and is no longer loop-free to this clause; a caller
;; with a real back edge is neither, and is refused by the reading the clause
;; already had.
(define (compiler-optimize-inline-recursive-caller-loop-free-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [functions : ir.CompilerIrFunctionSeq
      (opt-inline-recursive-caller-chain
        (opt-inline-shared-caller-names symbols 1)
        callee-name
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-dup-leaf-plain callee-name))
          (& (ir.compiler-ir-function-seq-empty))))]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [census : opt.OptInlineCensus
      (opt.opt-inline-census-build index (& functions))]
    [_install-flat : unit
      (let
        [blocks
          (let
            [func (opt-inline-switch-caller-named symbols callee-name)]
            (opt.opt-function-blocks func))]
        (opt.opt-inline-caller-facts-install! index census symbols.main blocks))]
    [flat-loop-free? : bool (opt.opt-inline-caller-loop-free?)]
    [flat-recursive? : bool (opt.opt-inline-caller-recursive?)]
    [_install-recursive : unit
      (let
        [blocks (opt-inline-recursive-caller-blocks symbols.main callee-name)]
        (opt.opt-inline-caller-facts-install! index census symbols.main blocks))]
    [recursive-loop-free? : bool (opt.opt-inline-caller-loop-free?)]
    [recursive-recursive? : bool (opt.opt-inline-caller-recursive?)]
    [_install-loop : unit
      (let
        [blocks
          (opt-inline-loop-site-caller-blocks
            callee-name
            (opt-inline-loop-site-entry-instrs))]
        (opt.opt-inline-caller-facts-install! index census symbols.main blocks))]
    [loop-loop-free? : bool (opt.opt-inline-caller-loop-free?)]
    [loop-recursive? : bool (opt.opt-inline-caller-recursive?)]
    (and
      flat-loop-free?
      (not flat-recursive?)
      (not recursive-loop-free?)
      recursive-recursive?
      (not loop-loop-free?)
      (not loop-recursive?))))

;; A caller that loops, but whose call sits in the loop's EXIT block: no site
;; tier fires -- the site is not in the loop, the caller is not loop-free, and
;; the in-loop tier never sees the exit block -- so the import keeps its
;; boundary at all three callers.
(define (opt-inline-hot-loop-cold-site-caller
  [func-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    func-name
    (opt-inline-switch-params)
    (I64)
    7
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-inline-loop-site-entry-instrs))
      (irt.block
        "header:
             %4 = phi [%3, entry], [%5, latch] : i64
             branch %0, body, exit")
      (irt.block
        "body:
               %5 = mov %4 : i64
               jump latch")
      (irt.block "latch:
                 jump header")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "exit")
        (opt-test-instrs
          (opt-inline-loop-site-call callee-name 6)
          (irt.instr "return %6"))))
    Ordinary))

(define (opt-inline-hot-loop-cold-site-chain
  [names : (__tl_dyn-array i64)]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (opt-inline-hot-loop-cold-site-chain-from (& names) 0 callee-name tail))

(define (opt-inline-hot-loop-cold-site-chain-from
  [names : (& names (__tl_dyn-array i64))]
  [at : i64]
  [callee-name : i64]
  [tail : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (if (>= at (array-length names))
    tail
    (let
      [name : i64 (array-ref names at)]
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-hot-loop-cold-site-caller name callee-name))
        (&
          (opt-inline-hot-loop-cold-site-chain-from
            names
            (+ at 1)
            callee-name
            tail))))))

(define (compiler-optimize-inline-hot-loop-leaf-cold-site-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-hot-loop-cold-site-chain
          (opt-inline-dup-three-caller-names symbols)
          callee-name
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-dup-leaf-plain callee-name))
            (& (ir.compiler-ir-function-seq-empty))))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; Six straight-line call blocks in one loop-free caller, one call per block.
;; Each copy of the five-block leaf costs the caller six blocks of block fuel,
;; so five copies fit the per-caller budget and the sixth keeps its call.
(define (opt-inline-hot-loop-budget-label [index : i64]) : i64
  (ir.compiler-ir-label
    (& (str_cat.str-cat "budget" (string.int->string index)))))

(define (opt-inline-hot-loop-budget-blocks-from!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [callee-name : i64]
  [index : i64]
  [sites : i64]) : unit
  (if (>= index sites)
    (ir.compiler-ir-block-builder-append-list!
      out
      (irt.blocks "budget_exit:
         return %3"))
    (begin
      (ir.compiler-ir-block-builder-push!
        out
        (ir.CompilerIrBlock.Block
          (opt-inline-hot-loop-budget-label index)
          (opt-test-instrs
            ;; a per-site first argument (`idx + index`, computed rather than a
            ;; literal), so the sites stay distinct calls: identical write-free
            ;; calls along the chain would otherwise be one call and five copies
            ;; (CSE-CALL), which is not the fuel question this fixture asks
            (ir.CompilerIrInstr.BinOp
              (+ 10 index)
              (Add)
              (Var 1)
              (I64 index)
              (I64))
            (opt-inline-loop-site-call-idx callee-name (+ 3 index) (+ 10 index))
            (ir.CompilerIrInstr.Jump
              (if (< (+ index 1) sites)
                (opt-inline-hot-loop-budget-label (+ index 1))
                (ir.compiler-ir-label "budget_exit"))))))
      (opt-inline-hot-loop-budget-blocks-from!
        out
        callee-name
        (+ index 1)
        sites))))

(define (compiler-optimize-inline-hot-loop-leaf-budget-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              symbols.main
              (opt-inline-switch-params)
              (I64)
              16
              (opt.opt-blocks-collect
                opt-inline-hot-loop-budget-blocks-from!
                callee-name
                0
                6)
              Ordinary))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-dup-leaf-plain callee-name))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      1)))

;; --- the single-reference sites the band takes -------------------------------
;;
;; The band's reference clause begins at one reference. What these fixtures pin
;; is that the reference class is open and every other clause of the band still
;; binds.
;;
;; ONE in-loop caller of the big-tier leaf. Nothing else can take it: absorption
;; is refused because the site is in a loop (and the leaf is under the arity
;; floor), the legacy bounds-loop absorb band is refused because 41 instructions
;; is past its 32, and the cost model's absorb bonus cannot help because the
;; bounds-loop gate is what stands in the way. This band is what takes it.
(define (opt-inline-hot-loop-one-caller-names
  [symbols : OptInlineMultiTestSymbols]) : (__tl_dyn-array i64)
  (let
    [only : i64 symbols.main]
    (__tl_make-array only)))

(define (compiler-optimize-inline-hot-loop-leaf-single-reference-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-hot-loop-one-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-mid-leaf callee-name))]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      0)))

;; The SIZE clause at the newly opened reference class: the same single in-loop
;; site, the leaf one instruction past opt-inline-hot-loop-leaf-max-body. The
;; band's size ceiling is not a function of the reference count, so the call
;; stays.
(define (compiler-optimize-inline-hot-loop-leaf-single-reference-too-big-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-hot-loop-one-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-big-leaf callee-name))]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      1)))

;; The big-tier leaf with one call in its body: past the legacy absorb band on
;; size, inside this band on size, and refused by the CALL-FREE clause. The pad
;; chain ends in the call so the anchor mov keeps var 4 to itself.
(define (opt-inline-hot-loop-mid-leaf-call-instrs [helper-name : i64]) : ir.CompilerIrInstrSeq
  (let
    [args : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 1)]
    (set! (array-ref args 0) (ir.CompilerIrValue.Var 0))
    (opt-test-instrs-with-tail
      (opt-inline-dup-leaf-jump-zero-instrs)
      (ir.CompilerIrInstr.Call 39 helper-name (Array args) (I64)))))

(define (opt-inline-hot-loop-mid-leaf-calling
  [callee-name : i64]
  [helper-name : i64]) : ir.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    (+ 6 35)
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from
        5
        34
        (opt-inline-hot-loop-mid-leaf-call-instrs helper-name))
      (ir.CompilerIrInstr.Mov 4 (I64 0) (I64)))))

(define (compiler-optimize-inline-hot-loop-leaf-single-reference-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-hot-loop-one-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-mid-leaf-calling
          callee-name
          symbols.external-helper))]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      1)))

(define (opt-inline-phi-span-ok-instr-seq-from?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [spans : ir.CompilerSourceSpans]
  [caller-name : i64]
  [line : i64]
  [col : i64]) : bool
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    false
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs pos)]
      (or
        (match (opt.compiler-opt-global-shared-view instr)
          [(Phi _ _ _) (opt-span-lookup-ok? spans caller-name instr line col)]
          [_ false])
        (opt-inline-phi-span-ok-instr-seq-from?
          instrs
          (+ pos 1)
          spans
          caller-name
          line
          col)))))

(define (opt-inline-phi-span-ok-blocks?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [spans : ir.CompilerSourceSpans]
  [caller-name : i64]
  [line : i64]
  [col : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (or
            (opt-inline-phi-span-ok-instr-seq-from?
              instrs
              0
              (ir.compiler-ir-global-shared-view spans)
              caller-name
              line
              col)
            (opt-inline-phi-span-ok-blocks? rest spans caller-name line col))])]))

;; The span cases run at a chosen optimizer LEVEL. The negative direction used
;; to be supplied by a callee name the opt2 gate refused (`qs-partition`, when
;; the acyclic gate's only escape was the `vm-run` name match); the hot-loop-leaf
;; band admits that shape on its own terms now, so the refusing case is selected
;; by level instead -- below opt2 the multiblock inliner does not run, the call
;; survives, and its caller-side span must still be intact.
(define (opt-inline-switch-span-case-code
  [callee-text : String]
  [expect-inline? : bool]
  [level : i64]) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64
      (opt-test-symbol (opt.compiler-opt-global-shared-view callee-text))]
    [caller-name : i64 symbols.main]
    [callee-phi : ir.CompilerIrInstr (opt-inline-switch-loop-phi-instr)]
    [caller-call : ir.CompilerIrInstr
      (opt-inline-switch-caller-call-named callee-name)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert-instr
          (opt-spans-base)
          (ir.compiler-ir-symbol-typed-id callee-name)
          (& callee-phi)
          (opt-test-span 171 33))
        (ir.compiler-ir-symbol-typed-id caller-name)
        (& caller-call)
        (opt-test-span 181 35))]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [code : i64
      (begin
        (ir.compiler-debug-info-set-enabled! true)
        (match (opt-test-inline-program-with-spans
          (ast.ast-node-pool-reader-context-current)
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-inline-switch-functions-named symbols callee-name)
          level
          spans)
          [(Program optimized optimized-spans)
            (match (opt-function-seq-find optimized "main")
              [(Some main)
                (let
                  [blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks main)]
                  (+
                    (if (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view blocks)
                        callee-text)
                      (if expect-inline?
                        0
                        1))
                      1
                      0)
                    (+
                      (if (=
                        (opt.opt-count-bounds-blocks
                          (ir.compiler-ir-block-list-view blocks))
                        (if expect-inline?
                          1
                          0))
                        2
                        0)
                      (+
                        (if (if expect-inline?
                          (opt-inline-phi-span-ok-blocks?
                            (ir.compiler-ir-block-list-view blocks)
                            optimized-spans
                            caller-name
                            171
                            33)
                          (opt-span-lookup-ok?
                            optimized-spans
                            caller-name
                            caller-call
                            181
                            35))
                          4
                          0)
                        (if (opt.opt-inline-structure-ok? (& blocks))
                          8
                          0)))))]
              [(No) 0])]))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    code))

(define (opt-inline-costly-switch-params) : ir.CompilerIrParamSeq
  (irt.params "tag=%0:i64"))

;; Five body instructions plus six added blocks leave this non-absorbable i64
;; callee above the weighted threshold even with a constant argument at each
;; of its two sites. Switch admission must not bypass that cost decision.
(define (opt-inline-costly-switch-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-switch-costly
    (opt-inline-costly-switch-params)
    (I64)
    2
    (irt.blocks
      "entry:
         switch %0 base 0 [0:zero, 1:one] default other
       zero:
         jump join
       one:
         jump join
       other:
         jump join
       join:
         %1 = phi [10, zero], [20, one], [30, other] : i64
         return %1")
    Ordinary))

(define (opt-inline-costly-switch-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            0
            symbols.inline-switch-costly
            (One (I64 0))
            (I64))
          (ir.CompilerIrInstr.Call
            1
            symbols.inline-switch-costly
            (One (I64 1))
            (I64))
          (irt.instr "%2 = add %0, %1 : i64")
          (irt.instr "return %2"))))
    Ordinary))

(define (compiler-optimize-inline-multiblock-switch-cost-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-costly-switch-caller symbols))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-costly-switch-callee symbols))
              (& (ir.compiler-ir-function-seq-empty)))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_switch_costly")
              2)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (opt-inline-mut-param-params) : ir.CompilerIrParamSeq
  (irt.params "n=%0:i64"))

(define (opt-inline-mut-param-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-mut-param-loop
    (opt-inline-mut-param-params)
    (I64)
    1
    (irt.blocks
      "entry:
         jump loop
       loop:
         %0 = add %0, 1 : i64
         branch false, loop, exit
       exit:
         return %0")
    Ordinary))

(define (opt-inline-mut-param-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            0
            symbols.inline-mut-param-loop
            (One (I64 4))
            (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-mut-param-functions [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-mut-param-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-mut-param-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-optimize-inline-mut-param-loop-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-mut-param-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_mut_param_loop")
              0)
            (= (ir.compiler-ir-block-list-count blocks) 5)
            (opt.opt-verify-ok? (& (opt.opt-verify-function (& main))))))]
      [(No) false])))

(define (opt-inline-caller-phi-loop-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    2
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "left:
           jump join
         right:
           jump join
         join:
           %1 = phi [7, left], [9, right] : i64
           return %1")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 symbols.inline-loop Nil (I64))
          (irt.instr "branch true, left, right"))))
    Ordinary))

(define (opt-inline-caller-phi-loop-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-caller-phi-loop-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-loop-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-optimize-inline-caller-phi-loop-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-caller-phi-loop-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_loop")
              0)
            (= (ir.compiler-ir-block-list-count blocks) 8)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (opt-inline-nonleaf-callee-named
  [symbols : OptInlineMultiTestSymbols]
  [helper-name : i64]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "ret:
             return 3")
      (irt.block "entry:
           branch true, call, ret")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "call")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 helper-name Nil (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-nonleaf-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (opt-inline-nonleaf-callee-named symbols symbols.external-helper))

(define (opt-inline-nonleaf-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 symbols.inline-nonleaf Nil (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-nonleaf-functions [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-nonleaf-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-nonleaf-functions-named
  [symbols : OptInlineMultiTestSymbols]
  [helper-name : i64]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-nonleaf-callee-named symbols helper-name))
        (& (ir.compiler-ir-function-seq-empty))))))

;; The caller's call to the multiblock call-carrying callee, and the callee's
;; own call, as span keys.
(define (opt-inline-nonleaf-caller-call [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrInstr
  (Call 0 symbols.inline-nonleaf Nil (I64)))

(define (opt-inline-nonleaf-inner-call [helper-name : i64]) : ir.CompilerIrInstr
  (Call 0 helper-name Nil (I64)))

;; The SPANS variant of the multiblock clone, carrying a call.
;;
;; opt-inline-clone-multiblock-blocks-with-spans is a second copy of the clone
;; walk, so the fact that the plain walk clones a call correctly says nothing
;; about this one. The callee's call is rebased into the caller's frame -- the
;; callee's `Call 0` becomes the caller's `Call 1`, because the caller already
;; owns var 0 -- and the span the cloned call carries has to follow it to that
;; new key, or the merged caller reports the CALL SITE's line for an
;; instruction that came from the callee.
(define (compiler-optimize-spans-inline-multiblock-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr-located
        (ir.compiler-source-spans-insert-instr-located
          (opt-spans-base)
          (opt-test-span-symbol "inline_nonleaf")
          (& (opt-inline-nonleaf-inner-call symbols.external-helper))
          703
          (opt-test-span 73 11))
        (opt-test-span-symbol "main")
        (& (opt-inline-nonleaf-caller-call symbols))
        803
        (opt-test-span 83 17))]
    [cloned-call : ir.CompilerIrInstr
      (Call 1 symbols.external-helper Nil (I64))]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (ir.compiler-debug-info-set-enabled! true)
        (match (opt-test-inline-program-with-spans
          (ast.ast-node-pool-reader-context-current)
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-inline-nonleaf-functions symbols)
          2
          spans)
          [(Program optimized optimized-spans)
            (match (opt-function-seq-find optimized "main")
              [(Some main)
                (let
                  [blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks main)]
                  (and
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view blocks)
                        "inline_nonleaf")
                      0)
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view blocks)
                        "external_helper")
                      1)
                    (opt.opt-inline-structure-ok? (& blocks))
                    (opt-inline-mb2-main-verified? optimized "main")
                    ;; the callee's own line, under the caller's key
                    (opt-span-lookup-ok?
                      optimized-spans
                      (opt-test-symbol "main")
                      cloned-call
                      73
                      11)
                    (opt-location-lookup-ok?
                      optimized-spans
                      (opt-test-symbol "main")
                      cloned-call
                      703
                      73
                      11)))]
              [(No) false])]))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    ok))

;; ...and the same clone with the call being an ABORT, which is what trap
;; parity rests on.
;;
;; With debug info off -- the configuration every corpus binary and the
;; self-compile are built in -- opt-remap-spans-instr-key builds a key only for
;; instructions that can abort at runtime, and `stdlib.io/panic` is one of them.
;; So this is the one span in a cloned call-carrying body that survives a
;; release build, and it is the span the abort message prints. If the clone
;; dropped it or left it under the callee's key, an abort inside an inlined
;; callee would report the caller's line instead of the callee's, and trap
;; output would stop matching the un-inlined build byte for byte.
(define (opt-inline-panic-symbol) : i64
  (opt-test-symbol "stdlib/io.tl::stdlib.io/panic"))

(define (compiler-optimize-inline-clone-abort-span-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [panic-name : i64 (opt-inline-panic-symbol)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert-instr
          (opt-spans-base)
          (opt-test-span-symbol "inline_nonleaf")
          (& (opt-inline-nonleaf-inner-call panic-name))
          (opt-test-span 61 9))
        (opt-test-span-symbol "main")
        (& (opt-inline-nonleaf-caller-call symbols))
        (opt-test-span 62 3))]
    [cloned-call : ir.CompilerIrInstr
      (irt.instr "%1 = call stdlib/io.tl::stdlib.io/panic() : i64")]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (ir.compiler-debug-info-set-enabled! false)
        (match (opt-test-inline-program-with-spans
          (ast.ast-node-pool-reader-context-current)
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-inline-nonleaf-functions-named symbols panic-name)
          2
          spans)
          [(Program optimized optimized-spans)
            (match (opt-function-seq-find optimized "main")
              [(Some main)
                (let
                  [blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks main)]
                  (and
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view blocks)
                        "inline_nonleaf")
                      0)
                    (opt.opt-inline-structure-ok? (& blocks))
                    (opt-inline-mb2-main-verified? optimized "main")
                    ;; the abort still points at the callee's line
                    (opt-span-lookup-ok?
                      optimized-spans
                      (opt-test-symbol "main")
                      cloned-call
                      61
                      9)))]
              [(No) false])]))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    ok))

;; --- a chain whose SECOND import carries a call ----------------------------
;;
;; main -> mid -> leaf, with the CALL in the leaf. SCC order processes callees
;; before callers, so `leaf` is cloned into `mid` first and `mid` -- which now
;; holds a cloned call, cloned blocks and a cloned continuation phi -- is cloned
;; into `main` second. That second clone is the one that re-clones an already
;; cloned call: it has to rebase the call a second time, prefix the labels a
;; second time, and leave `main` with exactly one call, to the leaf's own
;; helper. Both callees have a single reference, so the chain is absorbed
;; bottom-up in one pass.
(define (opt-inline-chain-mid [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-loop
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "mid_ret:
             return 9")
      (irt.block "entry:
           branch true, mid_call, mid_ret")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "mid_call")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 symbols.inline-nonleaf Nil (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-chain-main [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 0 symbols.inline-loop Nil (I64))
          (irt.instr "return %0"))))
    Ordinary))

(define (compiler-optimize-inline-chain-second-import-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-chain-main symbols))
          (&
            (ir.compiler-ir-function-seq-prepend
              (& (opt-inline-chain-mid symbols))
              (&
                (ir.compiler-ir-function-seq-prepend
                  (& (opt-inline-nonleaf-callee symbols))
                  (& (ir.compiler-ir-function-seq-empty)))))))
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_loop")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              1)
            (opt.opt-inline-structure-ok? (& blocks))
            (opt-inline-mb2-main-verified? optimized "main")))]
      [(No) false])))

(define (compiler-optimize-inline-multiblock-nonleaf-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-nonleaf-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              1)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; The tail-call twin of opt-inline-nonleaf-callee-named: the same three-block
;; body, except the arm that called the helper and returned its result is the
;; fused form the lowerer actually emits for `(helper)` in tail position -- a
;; single `TailCall`. Nothing else about the callee changes, so anything this
;; body does that the plain nonleaf body does not is the tail-call admission.
(define (opt-inline-tail-call-callee [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "ret:
             return 3")
      (irt.block "entry:
           branch true, call, ret")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "call")
        (opt-test-instrs
          (ir.CompilerIrInstr.TailCall symbols.external-helper Nil (I64)))))
    Ordinary))

;; The nearest refused neighbour: identical body, except the tail call goes
;; through a computed callee. The admission stops at the direct form, so this
;; callee's whole body stays out of its single call site.
;;
;; The target is LOADED, not spelled. `TailCallIndirect (Value.Function f)` is
;; not a computed target at all by the time the inliner sees it:
;; opt-devirt-known-function-instr rewrites exactly that pattern into a direct
;; `TailCall f` before the pass runs, and this fixture written that way inlined
;; -- correctly, and for the direct admission rather than the indirect one it
;; was meant to pin. A load from a global is a target devirtualization cannot
;; see through, which is what makes the refusal this test claims the reason the
;; site survives.
(define (opt-inline-tail-call-indirect-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "ret:
             return 3")
      (irt.block "entry:
           branch true, call, ret")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "call")
        (opt-test-instrs
          (ir.CompilerIrInstr.Load 0 (Global symbols.external-helper) (I64))
          (irt.instr "tailcall* %0() : i64"))))
    Ordinary))

(define (opt-inline-tail-call-functions [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-tail-call-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-tail-call-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-tail-call-indirect-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

;; A body whose exit arm is a direct tail call inlines, and the merged caller
;; carries the CONVERTED shape: the callee is gone, its tail call is an
;; ordinary direct call to the helper, no tail call survives anywhere in the
;; caller, and the converted call's result reaches the site through the same
;; single continuation phi every multiblock inline builds.
(define (compiler-optimize-inline-multiblock-tail-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-call-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-tail-call-blocks
                (ir.compiler-ir-block-list-view blocks))
              0)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; The same program with an INDIRECT tail call: the call site keeps its call.
(define (compiler-optimize-inline-multiblock-tail-call-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-call-indirect-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; Idempotence: re-running the inliner over its own output leaves the merged
;; caller alone. The converted call is a plain call to a callee the pass has
;; no body for, so there is nothing left to absorb and no second conversion.
(define (compiler-optimize-inline-multiblock-tail-call-idempotent-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [once : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-call-functions symbols)
        2)]
    [twice : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.compiler-opt-global-shared-view once)
        2)]
    (match (opt-function-seq-find once "main")
      [(Some once-main)
        (match (opt-function-seq-find twice "main")
          [(Some twice-main)
            (let
              [once-blocks : ir.CompilerIrBlockList
                (opt.opt-function-blocks once-main)]
              [twice-blocks : ir.CompilerIrBlockList
                (opt.opt-function-blocks twice-main)]
              (and
                (=
                  (ir.compiler-ir-block-list-count once-blocks)
                  (ir.compiler-ir-block-list-count twice-blocks))
                (=
                  (opt-count-direct-call-name-blocks
                    (ir.compiler-ir-block-list-view twice-blocks)
                    "external_helper")
                  1)
                (=
                  (opt-count-tail-call-blocks
                    (ir.compiler-ir-block-list-view twice-blocks))
                  0)
                (=
                  (opt-count-phi-blocks
                    (ir.compiler-ir-block-list-view once-blocks))
                  (opt-count-phi-blocks
                    (ir.compiler-ir-block-list-view twice-blocks)))
                (opt.opt-inline-structure-ok? (& twice-blocks))))]
          [(No) false])]
      [(No) false])))

;; --- one-block callee whose only terminator is a direct tail call -----------
;;
;; The forwarder / defaulted-argument wrapper: `(define (f v) (g v 7))`. The
;; lowerer fuses the body's single call into the return, so the whole function
;; is one block ending in a `TailCall` and carries no `Return` at all. Until
;; opt-inline-body-terminator-ok? admitted that exit, the shape was refused by
;; every band -- the single-block path wanted a `Return` terminator and the
;; multiblock path wants more than one block -- so the wrapper's frame,
;; argument moves, call and jump were paid at every site.
(define (opt-inline-single-block-tail-call-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 7 : i64")
          (ir.CompilerIrInstr.TailCall
            symbols.external-helper
            (One (Var 0))
            (I64)))))
    Ordinary))

;; The nearest refused neighbour, on the same terms as the multiblock pair
;; above: the target is LOADED, so devirtualization cannot spell it and the
;; census cannot price the site. The body stays out of its call site.
(define (opt-inline-single-block-tail-call-indirect-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Load 0 (Global symbols.external-helper) (I64))
          (irt.instr "tailcall* %0() : i64"))))
    Ordinary))

;; A one-block body whose tail call names the callee itself: the self-recursion
;; the tail-recursion-to-loop pass owns. INL-11 runs that pass over every
;; function BEFORE the whole-program inline stage (opt-tailrec-function-seq!),
;; so the inliner meets this body as the loop it becomes -- a jump back to its
;; own entry, no tail call left -- and refuses it by shape (an exitless loop
;; has no return to splice).
(define (opt-inline-single-block-self-tail-call-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.TailCall symbols.inline-nonleaf Nil (I64)))))
    Ordinary))

;; Mutual recursion through the tail call: the callee's one block tail-calls
;; the CALLER. Inlining it would put a self-call inside `main` and would make
;; the census's reference accounting for `main` wrong; the shared SCC is what
;; refuses it.
(define (opt-inline-single-block-tail-call-to-caller-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs (ir.CompilerIrInstr.TailCall symbols.main Nil (I64)))))
    Ordinary))

(define (opt-inline-single-block-tail-call-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-single-block-tail-call-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-single-block-tail-call-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-single-block-tail-call-indirect-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-single-block-self-tail-call-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-single-block-self-tail-call-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-single-block-tail-call-to-caller-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-nonleaf-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-single-block-tail-call-to-caller-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

;; The wrapper inlines, and what lands at the site is the TAIL TARGET's call:
;; `%0 = call external_helper(7)`, in the caller's one block, with no tail call
;; and no continuation block or phi anywhere -- the single-block expansion adds
;; neither, which is what makes this cheaper than routing the same body through
;; the multiblock clone.
(define (compiler-optimize-inline-single-block-tail-call-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-tail-call-blocks
                (ir.compiler-ir-block-list-view blocks))
              0)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 0)
            (= (ir.compiler-ir-block-list-count blocks) 1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; Level 1 runs the call-free tiny-leaf pass only, and a body that ends in a
;; tail call is not call-free. The site keeps its call in the cheap build.
(define (compiler-optimize-inline-single-block-tail-call-level1-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-functions symbols)
        1)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; The indirect twin keeps its call.
(define (compiler-optimize-inline-single-block-tail-call-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-indirect-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; Self-recursion and mutual recursion through the tail call both keep their
;; call sites. The self-recursive callee reaches the inliner already rewritten
;; into a loop (INL-11): its self tail call is gone and a jump to its own entry
;; stands in its place.
(define (compiler-optimize-inline-single-block-self-tail-call-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-self-tail-call-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (match (opt-function-seq-find optimized "inline_nonleaf")
          [(Some callee)
            (let
              [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
              [callee-blocks : ir.CompilerIrBlockList
                (opt.opt-function-blocks callee)]
              (and
                (=
                  (opt-count-direct-call-name-blocks
                    (ir.compiler-ir-block-list-view blocks)
                    "inline_nonleaf")
                  1)
                (=
                  (opt-count-tail-call-blocks
                    (ir.compiler-ir-block-list-view blocks))
                  0)
                (=
                  (opt-count-tail-call-blocks
                    (ir.compiler-ir-block-list-view callee-blocks))
                  0)
                ;; the rewrite's preheader and the back edge both jump to
                ;; the entry
                (opt-block-list-has-label?
                  (ir.compiler-ir-block-list-view callee-blocks)
                  (ir.compiler-ir-label "entry__ssa_entry"))
                (=
                  (opt-count-jump-to-blocks
                    (ir.compiler-ir-block-list-view callee-blocks)
                    (ir.compiler-ir-label "entry"))
                  2)
                (opt.opt-inline-structure-ok? (& blocks))))]
          [(No) false])]
      [(No) false])))

(define (compiler-optimize-inline-single-block-tail-call-to-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-single-block-tail-call-to-caller-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-tail-call-blocks
                (ir.compiler-ir-block-list-view blocks))
              0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; --- direct tail-call SITES -------------------------------------------------
;;
;; The site class the inliner could not see. `(define (main) (f))` lowers to one
;; block holding a single `TailCall f`: no destination, no continuation, and --
;; until opt-inline-try-with-spans grew its TailCall arm -- no inline site
;; either, so a caller that does nothing but forward paid `f`'s whole call
;; boundary. The rewrite is the simpler of the two site classes: the callee's
;; exit becomes the caller's exit, so a `Return` exit lands as the caller's
;; `Return` and a `TailCall h` exit is forwarded as a `TailCall h`, never as a
;; call.
(define (opt-inline-tail-site-caller [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    0
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.TailCall symbols.inline-nonleaf Nil (I64)))))
    Ordinary))

;; The indirect twin of the site: the target is LOADED, so nothing names a
;; callee and the census cannot price it. It must survive the pass untouched.
(define (opt-inline-tail-site-indirect-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Load 0 (Global symbols.inline-nonleaf) (I64))
          (irt.instr "tailcall* %0() : i64"))))
    Ordinary))

;; The ordinary `Return`-exit callee, seen from a tail site.
(define (opt-inline-tail-site-return-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (irt.blocks "entry:
         %0 = mov 7 : i64
         return %0")
    Ordinary))

;; A self-tail-recursive callee: one block, one `Mov`, and a tail call to
;; ITSELF. Its own tail call is now a site the walk visits, and it is the site
;; that must stay refused -- expanding it would copy the body into itself and
;; the next round would do it again. opt-inline-callee-ok? refuses it by name
;; and opt-inline-lookup-inlinable refuses it by SCC; opt-tailrec is what turns
;; it into a loop.
(define (opt-inline-self-tail-recursive-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 7 : i64")
          (ir.CompilerIrInstr.TailCall symbols.inline-nonleaf Nil (I64)))))
    Ordinary))

;; The mutual-recursion pair's other half: it tail-calls the CALLER back. The
;; two functions share an SCC, so neither site may be taken -- taking either one
;; would put a copy of one body inside the other and leave the cycle intact.
(define (opt-inline-tail-site-mutual-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-nonleaf
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (irt.instr "%0 = mov 7 : i64")
          (ir.CompilerIrInstr.TailCall symbols.main Nil (I64)))))
    Ordinary))

(define (opt-inline-tail-site-return-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-tail-site-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-tail-site-return-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-tail-site-tail-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-tail-site-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-single-block-tail-call-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-tail-site-indirect-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-tail-site-indirect-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-tail-site-return-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-tail-site-self-recursive-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-tail-site-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-self-tail-recursive-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-inline-tail-site-mutual-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-tail-site-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-tail-site-mutual-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

;; (a) A `Return`-exit callee at a tail site: the body lands in the caller's one
;; block and the callee's `Return` IS the caller's `Return`. No call and no tail
;; call survive, and no block or phi is added.
(define (compiler-optimize-inline-tail-site-return-exit-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-return-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-tail-call-blocks
                (ir.compiler-ir-block-list-view blocks))
              0)
            (=
              (opt-count-tail-call-indirect-blocks
                (ir.compiler-ir-block-list-view blocks))
              0)
            (=
              (opt-count-return-blocks (ir.compiler-ir-block-list-view blocks))
              1)
            (=
              (opt-count-instrs-blocks (ir.compiler-ir-block-list-view blocks))
              2)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 0)
            (= (ir.compiler-ir-block-list-count blocks) 1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; (b) A `TailCall`-exit callee at a tail site: the exit is FORWARDED. The
;; caller ends in a tail call to the inner target, not in a call plus a return,
;; so the chain's stack usage is what it was.
(define (compiler-optimize-inline-tail-site-tail-exit-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-tail-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-tail-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "external_helper")
              1)
            (=
              (opt-count-tail-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-tail-call-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (=
              (opt-count-return-blocks (ir.compiler-ir-block-list-view blocks))
              0)
            (=
              (opt-count-instrs-blocks (ir.compiler-ir-block-list-view blocks))
              2)
            (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 0)
            (= (ir.compiler-ir-block-list-count blocks) 1)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; (c) A `TailCallIndirect` site is not a site.
(define (compiler-optimize-inline-tail-site-indirect-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-indirect-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-tail-call-indirect-blocks
                (ir.compiler-ir-block-list-view blocks))
              1)
            (=
              (opt-count-tail-call-blocks
                (ir.compiler-ir-block-list-view blocks))
              0)
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              0)
            (=
              (opt-count-instrs-blocks (ir.compiler-ir-block-list-view blocks))
              2)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

;; (d) The self-recursive tail site is a back edge before the inliner runs
;; (INL-11: opt-tailrec-function-seq! precedes the whole-program walk). The
;; callee keeps its `Mov`, its tail call to itself has become a jump to its own
;; entry behind the rewrite's preheader, and no site was taken: had one been,
;; the body would hold a second copy of the `Mov`.
(define (compiler-optimize-inline-tail-site-self-recursion-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-self-recursive-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "inline_nonleaf")
      [(Some callee)
        (let
          [callee-blocks : ir.CompilerIrBlockList
            (opt.opt-function-blocks callee)]
          (and
            (=
              (opt-count-tail-call-name-blocks
                (ir.compiler-ir-block-list-view callee-blocks)
                "inline_nonleaf")
              0)
            ;; preheader jump, the `Mov`, the back-edge jump
            (=
              (opt-count-instrs-blocks
                (ir.compiler-ir-block-list-view callee-blocks))
              3)
            (= (ir.compiler-ir-block-list-count callee-blocks) 2)
            (opt-block-list-has-label?
              (ir.compiler-ir-block-list-view callee-blocks)
              (ir.compiler-ir-label "entry__ssa_entry"))
            (=
              (opt-count-jump-to-blocks
                (ir.compiler-ir-block-list-view callee-blocks)
                (ir.compiler-ir-label "entry"))
              2)
            (opt.opt-inline-structure-ok? (& callee-blocks))))]
      [(No) false])))

;; (e) The mutual-recursion pair: neither half moves, because the SCC test
;; refuses a callee that can reach its caller back.
(define (compiler-optimize-inline-tail-site-mutual-recursion-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-mutual-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (match (opt-function-seq-find optimized "inline_nonleaf")
          [(Some callee)
            (let
              [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
              [callee-blocks : ir.CompilerIrBlockList
                (opt.opt-function-blocks callee)]
              (and
                (=
                  (opt-count-tail-call-name-blocks
                    (ir.compiler-ir-block-list-view blocks)
                    "inline_nonleaf")
                  1)
                (=
                  (opt-count-instrs-blocks
                    (ir.compiler-ir-block-list-view blocks))
                  1)
                (=
                  (opt-count-tail-call-name-blocks
                    (ir.compiler-ir-block-list-view callee-blocks)
                    "main")
                  1)
                (=
                  (opt-count-instrs-blocks
                    (ir.compiler-ir-block-list-view callee-blocks))
                  2)
                (opt.opt-inline-structure-ok? (& blocks))))]
          [(No) false])]
      [(No) false])))

;; (f) Level 1 runs the call-free tiny-leaf pass, which fires on `Call` sites
;; only. The tail site is untouched in the cheap build.
(define (compiler-optimize-inline-tail-site-level1-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-tail-site-return-functions symbols)
        1)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-tail-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_nonleaf")
              1)
            (=
              (opt-count-instrs-blocks (ir.compiler-ir-block-list-view blocks))
              1)
            (=
              (opt-count-return-blocks (ir.compiler-ir-block-list-view blocks))
              0)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (opt-inline-repeated-nonleaf-predicate-callee
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-tiny-nonleaf-predicate
    (ir.compiler-ir-param-seq-empty)
    (Bool)
    2
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "ret:
             return false")
      (irt.block "entry:
           branch true, call, ret")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "call")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 1 symbols.external-predicate Nil (Bool))
          (irt.instr "return %1"))))
    Ordinary))

(define (opt-inline-repeated-nonleaf-predicate-caller
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (Bool)
    2
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks "done:
             return false")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            0
            symbols.inline-tiny-nonleaf-predicate
            Nil
            (Bool))
          (irt.instr "branch %0, second, done")))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "second")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            1
            symbols.inline-tiny-nonleaf-predicate
            Nil
            (Bool))
          (irt.instr "return %1"))))
    Ordinary))

(define (opt-inline-repeated-nonleaf-predicate-functions
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-repeated-nonleaf-predicate-caller symbols))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-repeated-nonleaf-predicate-callee symbols))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-optimize-inline-repeated-nonleaf-predicate-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-nonleaf-predicate-functions symbols)
        2)]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_tiny_nonleaf_predicate")
              2)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (compiler-optimize-inline-census-direct-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq (opt-inline-frame-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [census : opt.OptInlineCensus
      (opt.opt-inline-census-build index (& functions))]
    (and
      (= (opt.opt-inline-census-refcount index census symbols.inline-add) 1)
      (not
        (opt.opt-inline-census-address-taken? index census symbols.inline-add))
      (opt.opt-inline-census-absorbable?
        (& index)
        (& census)
        symbols.main
        symbols.inline-add))))

(define (compiler-optimize-inline-census-address-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (opt-inline-known-indirect-functions symbols)]
    [index : opt.OptFunctionIndex (opt.opt-function-index-build functions)]
    [census : opt.OptInlineCensus
      (opt.opt-inline-census-build index (& functions))]
    (and
      (opt.opt-inline-census-address-taken? index census symbols.inline-add)
      (not
        (opt.opt-inline-census-absorbable?
          (& index)
          (& census)
          symbols.main
          symbols.inline-add)))))

(define (compiler-optimize-inline-cost-model-ok?) : bool
  (and
    (opt.opt-inline-bounds-leaf-return-type? (& (I64)))
    (opt.opt-inline-bounds-leaf-return-type? (& (Bool)))
    (opt.opt-inline-bounds-leaf-return-type? (& (Unit)))
    (not (opt.opt-inline-bounds-leaf-return-type? (& (String))))
    (opt.opt-inline-value-constant? (& (I64 7)))
    (not (opt.opt-inline-value-constant? (& (Var 7))))
    (=
      (let
        [args (ir.CompilerIrCallArgs.Two (I64 1) (Var 2))]
        (opt.opt-inline-args-const-count args))
      1)
    (opt.opt-inline-cost-inline? 8 0 0 false 64 0)
    (not (opt.opt-inline-cost-inline? 10 3 0 false 10 0))
    (opt.opt-inline-cost-inline? 10 3 0 true 10 0)
    (not
      (opt.opt-inline-cost-inline?
        1
        1
        0
        true
        (opt.opt-inline-heavy-gate-block-limit)
        0))
    (not (opt.opt-inline-cost-inline? 1 1 0 true 80 32))
    (opt.opt-inline-cost-inline? 8 1 8 false 10 0)
    (not (opt.opt-inline-bounds-inline-ok? true false 1 2))
    (opt.opt-inline-bounds-inline-ok? true false 2 2)
    (opt.opt-inline-bounds-inline-ok? true true 0 2)
    (opt.opt-inline-bounds-inline-ok? false false 0 2)))

(define (compiler-optimize-inline-multiblock-return-gate-ok?) : bool
  (let
    [direct-params : ir.CompilerIrParamSeq (irt.params "value=%0:i64")]
    [enum-name : i64 (opt-test-symbol "InlineReturnEnum")]
    [enum-ty : ast.AstType (Enum enum-name)]
    ;; #8555: a two-word register group, which `group_split` takes apart, is
    ;; admitted; a group wider than its word limit and an unknown
    ;; representation are not.
    [two-word : ir.CompilerIrRepresentationIndex
      (ir.compiler-ir-representation-index-merge-group
        (ir.compiler-ir-representation-index-empty)
        (ast.ast-nominal-name-id-key enum-name)
        2
        0)]
    [wide : ir.CompilerIrRepresentationIndex
      (ir.compiler-ir-representation-index-merge-group
        (ir.compiler-ir-representation-index-empty)
        (ast.ast-nominal-name-id-key enum-name)
        9
        0)]
    [unknown : ir.CompilerIrRepresentationIndex
      (ir.compiler-ir-representation-index-empty)]
    [sret-params : ir.CompilerIrParamSeq
      (ir.compiler-ir-param-seq-prepend
        (Param
          (ir.compiler-ir-hidden-sret-param-name)
          (ast.ast-ty-mut-ptr (& enum-ty))
          0)
        (opt.compiler-opt-global-shared-view direct-params))]
    (and
      (not
        (opt.opt-inline-multiblock-return-type-ok?
          (& direct-params)
          (& enum-ty)))
      (opt.opt-inline-multiblock-return-type-ok? (& direct-params) (& (I64)))
      (opt.opt-inline-multiblock-return-type-ok? (& direct-params) (& (Unit)))
      (opt.opt-inline-multiblock-return-type-ok? (& sret-params) (& enum-ty))
      (opt.opt-inline-return-representation-ok? (& two-word) (& enum-ty))
      (not (opt.opt-inline-return-representation-ok? (& wide) (& enum-ty)))
      (not (opt.opt-inline-return-representation-ok? (& unknown) (& enum-ty))))))

(define (opt-inline-dense-input-shape-ok? [instrs : ir.CompilerIrInstrSeq]) : bool
  (and
    (= (ir.compiler-ir-instr-seq-count instrs) 3)
    (match (ir.compiler-ir-instr-seq-ref instrs 0)
      [(Mov first-dst (I64 first-value) _)
        (and (= first-dst 10) (= first-value 7))]
      [_ false])
    (match (ir.compiler-ir-instr-seq-ref instrs 1)
      [(BinOp second-dst (Add) (Var second-left) (I64 second-right) _)
        (and (= second-dst 11) (= second-left 10) (= second-right 5))]
      [_ false])
    (match (ir.compiler-ir-instr-seq-ref instrs 2)
      [(Mov final-dst (Var final-source) _)
        (and (= final-dst 99) (= final-source 11))]
      [_ false])))

(define (compiler-optimize-inline-dense-input-ok?) : bool
  (let
    [callee-instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%0 = mov 7 : i64
         %1 = add %0, 5 : i64
         return %1")]
    [block : ir.CompilerIrBlock
      (Block
        (ir.compiler-ir-label "dense_inline")
        (ir.compiler-ir-global-shared-view callee-instrs))]
    [cons-blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks (ir.compiler-ir-global-shared-view block))]
    [array-blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-global-shared-view cons-blocks)]
    [cons-seq : ir.CompilerIrInstrSeq
      (opt.opt-inline-single-block-instrs cons-blocks)]
    [array-seq : ir.CompilerIrInstrSeq
      (opt.opt-inline-single-block-instrs array-blocks)]
    [expanded-cons : ir.CompilerIrInstrSeq
      (opt-test-inline-expand-instrs
        (ir.compiler-ir-global-shared-view cons-seq)
        99
        (I64)
        Nil
        0
        10
        "dense")]
    [expanded-array : ir.CompilerIrInstrSeq
      (opt-test-inline-expand-instrs
        (ir.compiler-ir-global-shared-view array-seq)
        99
        (I64)
        Nil
        0
        10
        "dense")]
    [empty-block : ir.CompilerIrBlock
      (Block
        (ir.compiler-ir-label "dense_empty")
        (ir.compiler-ir-instr-seq-empty))]
    [empty-seq : ir.CompilerIrInstrSeq
      (let
        [blocks
          (ir.compiler-ir-blocks
            (ir.compiler-ir-global-shared-view empty-block))]
        (opt.opt-inline-single-block-instrs blocks))]
    [multi-blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks block empty-block)]
    [multi-array-seq : ir.CompilerIrInstrSeq
      (let
        [blocks multi-blocks]
        (opt.opt-inline-single-block-instrs blocks))]
    [no-bounds : ir.CompilerIrInstrSeq callee-instrs]
    [with-bounds : ir.CompilerIrInstrSeq
      (irt.instrs
        "%0 = mov 1 : i64
         %1 = mov 2 : i64
         bounds_check %0, %1 message \"dense_bounds.ok\"
         return")]
    (and
      (= (ir.compiler-ir-instr-seq-count cons-seq) 3)
      (= (ir.compiler-ir-instr-seq-count array-seq) 3)
      (opt-inline-dense-input-shape-ok? expanded-cons)
      (opt-inline-dense-input-shape-ok? expanded-array)
      (= (ir.compiler-ir-instr-seq-count empty-seq) 0)
      (= (ir.compiler-ir-instr-seq-count multi-array-seq) 0)
      (not (opt.opt-inline-instr-seq-has-bounds-check? (& no-bounds)))
      (opt.opt-inline-instr-seq-has-bounds-check? (& with-bounds))
      (not
        (opt.opt-inline-instr-seq-has-bounds-check?
          (& (ir.compiler-ir-instr-seq-empty)))))))

;; #6219: a SysV MEMORY-class aggregate parameter is pointer-shaped in IR, but
;; the backend's call emission gives it a private byte copy.  Keep that call
;; boundary through every inliner admission path and distinguish IR-owned
;; transport names from source-owned spelling collisions.
(define (opt-inline-private-memory-test-params [value-ty : ast.AstType]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param (ir.compiler-ir-hidden-sret-param-name) (U64) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "value" value-ty 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-inline-private-memory-test-body) : ir.CompilerIrBlockList
  (irt.blocks
    "private_memory.entry:
       store_ptr %1, 99 : i64
       copy_bytes %0, %1, 24
       return %0"))

(define (opt-inline-private-memory-test-callee
  [name : i64]
  [value-ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    name
    (opt-inline-private-memory-test-params value-ty)
    (U64)
    2
    (opt-inline-private-memory-test-body)
    Ordinary))

(define (opt-inline-private-memory-test-caller
  [caller-name : i64]
  [callee-name : i64]
  [value-ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    caller-name
    (opt-inline-private-memory-test-params value-ty)
    (Unit)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "private_memory.caller")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 2 callee-name (Two (Var 0) (Var 1)) (U64))
          (ir.CompilerIrInstr.Return (No)))))
    Ordinary))

(define (opt-inline-private-memory-test-functions
  [caller-name : i64]
  [callee-name : i64]
  [value-ty : (& value-ty ast.AstType)]) : ir.CompilerIrFunctionSeq
  (let
    [value-ty : ast.AstType
      (owned_view.compiler-owned-reference-shared-view value-ty)]
    (ir.compiler-ir-function-seq-prepend
      (&
        (opt-inline-private-memory-test-caller
          caller-name
          callee-name
          (ir.compiler-ir-global-shared-view value-ty)))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-private-memory-test-callee callee-name value-ty))
          (& (ir.compiler-ir-function-seq-empty)))))))

(define (compiler-optimize-inline-private-memory-boundary-ok?) : bool
  (let
    [private-text : String "__tl_internal_abi_mem_s24__array_i64_3"]
    [group-text : String "__tl_internal_abi_group_m0__inline_control"]
    [private-id : i64
      (opt-test-symbol (opt.compiler-opt-global-shared-view private-text))]
    [source-id : i64 (ci.intern private-text)]
    [group-id : i64 (opt-test-symbol group-text)]
    [private-ty : ast.AstType (Struct private-id)]
    [private-args-ty : ast.AstType
      (ast.ast-ty-struct-args private-id (ast.ast-lifetime-list-new))]
    [source-ty : ast.AstType (Struct source-id)]
    [group-ty : ast.AstType (Struct group-id)]
    [private-callee-name : i64 (opt-test-symbol "inline_private_memory")]
    [private-caller-name : i64 (opt-test-symbol "private_memory_main")]
    [source-callee-name : i64 (opt-test-symbol "inline_source_collision")]
    [source-caller-name : i64 (opt-test-symbol "source_collision_main")]
    [private-params : ir.CompilerIrParamSeq
      (opt-inline-private-memory-test-params
        (opt.compiler-opt-global-shared-view private-ty))]
    [source-params : ir.CompilerIrParamSeq
      (opt-inline-private-memory-test-params
        (opt.compiler-opt-global-shared-view source-ty))]
    [private-callee : ir.CompilerIrFunction
      (opt-inline-private-memory-test-callee
        private-callee-name
        (opt.compiler-opt-global-shared-view private-ty))]
    [source-callee : ir.CompilerIrFunction
      (opt-inline-private-memory-test-callee
        source-callee-name
        (opt.compiler-opt-global-shared-view source-ty))]
    [private-level1 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-private-memory-test-functions
          private-caller-name
          private-callee-name
          private-ty)
        1)]
    [private-level2 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-private-memory-test-functions
          private-caller-name
          private-callee-name
          private-ty)
        2)]
    [source-level1 : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-private-memory-test-functions
          source-caller-name
          source-callee-name
          source-ty)
        1)]
    (match (opt-function-seq-find private-level1 "private_memory_main")
      [(Some private-main-level1)
        (match (opt-function-seq-find private-level2 "private_memory_main")
          [(Some private-main-level2)
            (match (opt-function-seq-find source-level1 "source_collision_main")
              [(Some source-main-level1)
                (let
                  [private-level1-blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks private-main-level1)]
                  [private-level2-blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks private-main-level2)]
                  [source-level1-blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks source-main-level1)]
                  (and
                    (ir.compiler-ir-symbol-owned? private-id)
                    (not (ir.compiler-ir-symbol-owned? source-id))
                    (ir.compiler-ir-symbol-owned? group-id)
                    (opt.opt-inline-private-memory-transport-type?
                      (& private-ty))
                    (opt.opt-inline-private-memory-transport-type?
                      (& private-args-ty))
                    (not
                      (opt.opt-inline-private-memory-transport-type?
                        (& source-ty)))
                    (not
                      (opt.opt-inline-private-memory-transport-type?
                        (& group-ty)))
                    (opt.opt-inline-params-have-private-memory?
                      (& private-params))
                    (not
                      (opt.opt-inline-callee-ok?
                        private-callee
                        private-caller-name))
                    (not
                      (opt.opt-inline-multiblock-callee-body-ok?
                        (& private-params)
                        (& (U64))
                        2
                        (& (opt-inline-private-memory-test-body))))
                    (opt.opt-inline-callee-ok? source-callee source-caller-name)
                    (not
                      (opt.opt-inline-params-have-private-memory?
                        (& source-params)))
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view private-level1-blocks)
                        "inline_private_memory")
                      1)
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view private-level2-blocks)
                        "inline_private_memory")
                      1)
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view source-level1-blocks)
                        "inline_source_collision")
                      0)))]
              [(No) false])]
          [(No) false])]
      [(No) false])))

;; --- INL-3: aggregate-building callee bodies --------------------------------
;;
;; A function that builds a struct value locally reserves its storage as a RUN
;; of `alloc` words closed by an `addr_of` of the run's last word (lowering's
;; `lower-reserve-inline-storage`), fills it through geps, and copies the
;; finished aggregate into its `__sret` buffer. A multiblock gate that refused
;; `Alloc` and `AddrOf` outright would refuse that whole class of callee by
;; SHAPE -- silently, before any band or the measured tier priced a site.
;;
;; These fixtures pin the admission and the two clauses that still refuse:
;; an `alloc` writing a parameter slot and an `addr_of` naming a parameter,
;; both of which would make the clone's affine rebasing touch a value the site
;; substitutes rather than a body-local the site owns.
(define (opt-inline-alloc-sret-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "cond" (Bool) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param (ir.compiler-ir-hidden-sret-param-name) (U64) 1)
      (ir.compiler-ir-param-seq-empty))))

;; entry reserves four storage words and closes the run, the two arms fill the
;; aggregate through the closing pointer, and the join copies it into the
;; caller's buffer -- the exact shape of `sccp-env-lookup-in`.
;;
;; `addr-src` and `first-alloc-dst` select the two refusable variants: 5 and 2
;; are the admitted body (a body-local run, closed by an `addr_of` of its last
;; word); 1 makes the `addr_of` name the `__sret` PARAMETER, and 0 makes the
;; first `alloc` write the `cond` parameter's slot.
(define (opt-inline-alloc-sret-body [addr-src : i64] [first-alloc-dst : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "alloc_sret.then:
         %7 = gep %6, 0 : u8
         store_ptr %7, 11 : i64
         jump alloc_sret.cont
       alloc_sret.else:
         %8 = gep %6, 0 : u8
         store_ptr %8, 22 : i64
         jump alloc_sret.cont
       alloc_sret.cont:
         copy_bytes %1, %6, 32
         return %1")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "alloc_sret.entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Alloc first-alloc-dst (I64))
        (ir.CompilerIrInstr.Alloc 3 (I64))
        (ir.CompilerIrInstr.Alloc 4 (I64))
        (ir.CompilerIrInstr.Alloc 5 (I64))
        (ir.CompilerIrInstr.AddrOf 6 addr-src)
        (irt.instr "branch %0, alloc_sret.then, alloc_sret.else")))))

;; The same aggregate build as one straight-line block: refused as `structure`
;; because the multiblock gate leaves a one-block body inside the single-block
;; cap to the single-block path, which keeps its own whitelist.
(define (opt-inline-alloc-sret-single-block-body) : ir.CompilerIrBlockList
  (irt.blocks
    "alloc_sret.only:
       %2 = alloc i64
       %6 = addr_of %2
       copy_bytes %1, %6, 8
       return %1"))

;; The aggregate body with a `Store` in the join. The module global-cell write
;; is in the MULTIBLOCK whitelist as well as the single-block one (INL-5,
;; INL-6), so the body is a POSITIVE: it says the multiblock gate admits an
;; aggregate build whose join writes a global cell. The `other-instr:`
;; vocabulary is pinned below on `syscall`, which no whitelist carries and none
;; is expected to.
(define (opt-inline-alloc-sret-store-body) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "alloc_store.entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Alloc 2 (I64))
        (ir.CompilerIrInstr.AddrOf 6 2)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "alloc_store.cont"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "alloc_store.cont")
      (opt-test-instrs
        (ir.CompilerIrInstr.Store 7 (I64 3) (I64))
        (ir.CompilerIrInstr.Return (Some (Var 1)))))))

;; A parameter list the clone's affine rebasing cannot read: the params do not
;; start at var 0, so `id < np` no longer names them.
(define (opt-inline-alloc-sret-shifted-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "cond" (Bool) 1)
    (ir.compiler-ir-param-seq-prepend
      (Param (ir.compiler-ir-hidden-sret-param-name) (U64) 2)
      (ir.compiler-ir-param-seq-empty))))

;; No `__sret` and a struct return the register classifier refuses: the body's
;; exits carry a value the site cannot bind.
(define (opt-inline-alloc-sret-value-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, slot=%1:u64"))

(define (opt-inline-alloc-sret-shape-reason
  [params : ir.CompilerIrParamSeq]
  [ret : ast.AstType]
  [blocks : ir.CompilerIrBlockList]) : i64
  (opt.opt-inline-multiblock-callee-shape-reason
    (& params)
    (& ret)
    9
    (& blocks)))

;; The shape gate's verdict on each body above, and the reason text a
;; `--trace-passes` `inline-shape|` line carries for it.
;; INL-23. A one-block body of `count` instructions before its return: a chain
;; of adds from the one parameter.
(define (opt-inline-one-block-test-body [count : i64]) : ir.CompilerIrBlockList
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity (+ count 1))]
    [k : i64 1]
    (while (<= k count)
      (ir.compiler-ir-instr-builder-push!
        (&mut builder)
        (ir.CompilerIrInstr.BinOp k (Add) (Var (- k 1)) (I64 1) (I64)))
      (set! k (+ k 1)))
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Return (Some (Var count))))
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "one_block.entry")
        (ir.compiler-ir-instr-builder-to-seq builder)))))

(define (opt-inline-one-block-test-shape-reason [count : i64]) : i64
  (opt.opt-inline-multiblock-callee-shape-reason
    (& (irt.params "x=%0:i64"))
    (& (I64))
    (+ count 2)
    (& (opt-inline-one-block-test-body count))))

;; INL-23. The multiblock gate leaves a one-block body to the single-block tier
;; while it fits that tier's cap and admits it one instruction past the cap;
;; the checked tier's small-body bound then decides which of those one-block
;; bodies keep.
(define (compiler-optimize-inline-one-block-shape-ok?) : bool
  (let
    [cap : i64 (opt.opt-inline-max-body)]
    (and
      (=
        (opt-inline-one-block-test-shape-reason cap)
        (opt.opt-inline-shape-structure))
      (=
        (opt-inline-one-block-test-shape-reason (+ cap 1))
        (opt.opt-inline-shape-ok))
      (opt.opt-inline-checked-small-body? 296 8)
      (opt.opt-inline-checked-small-body? 512 8)
      (not (opt.opt-inline-checked-small-body? 520 8)))))

(define (compiler-optimize-inline-multiblock-alloc-shape-ok?) : bool
  (let
    [private-text : String "__tl_internal_abi_mem_s32__alloc_sret"]
    [private-id : i64 (opt-test-symbol private-text)]
    [private-params : ir.CompilerIrParamSeq
      (ir.compiler-ir-param-seq-prepend
        (Param "cond" (Struct private-id) 0)
        (ir.compiler-ir-param-seq-prepend
          (Param (ir.compiler-ir-hidden-sret-param-name) (U64) 1)
          (ir.compiler-ir-param-seq-empty)))]
    [agg-id : i64 (opt-test-symbol "alloc_sret_agg")]
    [admitted : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-params)
        (U64)
        (opt-inline-alloc-sret-body 5 2))]
    [addr-param : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-params)
        (U64)
        (opt-inline-alloc-sret-body 1 2))]
    [alloc-param : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-params)
        (U64)
        (opt-inline-alloc-sret-body 5 0))]
    [private-memory : i64
      (opt-inline-alloc-sret-shape-reason
        private-params
        (U64)
        (opt-inline-alloc-sret-body 5 2))]
    [return-type : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-value-params)
        (Struct agg-id)
        (opt-inline-alloc-sret-body 5 2))]
    [shifted : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-shifted-params)
        (U64)
        (opt-inline-alloc-sret-body 5 2))]
    [single : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-params)
        (U64)
        (opt-inline-alloc-sret-single-block-body))]
    [store : i64
      (opt-inline-alloc-sret-shape-reason
        (opt-inline-alloc-sret-params)
        (U64)
        (opt-inline-alloc-sret-store-body))]
    (and
      (= admitted (opt.opt-inline-shape-ok))
      (opt.opt-inline-multiblock-callee-body-ok?
        (& (opt-inline-alloc-sret-params))
        (& (U64))
        9
        (& (opt-inline-alloc-sret-body 5 2)))
      (= addr-param (opt.opt-inline-shape-addr-of))
      (= alloc-param (opt.opt-inline-shape-alloc))
      (= private-memory (opt.opt-inline-shape-private-memory-param))
      (= return-type (opt.opt-inline-shape-return-type))
      (= shifted (opt.opt-inline-shape-params-not-sequential))
      (= single (opt.opt-inline-shape-structure))
      ;; INL-6: admitted, and admitted as a BODY, not merely as a reason code.
      (= store (opt.opt-inline-shape-ok))
      (opt.opt-inline-multiblock-callee-body-ok?
        (& (opt-inline-alloc-sret-params))
        (& (U64))
        9
        (& (opt-inline-alloc-sret-store-body)))
      (string.eq (opt.opt-inline-shape-reason-text admitted) "ok")
      (string.eq (opt.opt-inline-shape-reason-text addr-param) "addr_of")
      (string.eq (opt.opt-inline-shape-reason-text alloc-param) "alloc")
      (string.eq
        (opt.opt-inline-shape-reason-text private-memory)
        "private-memory-param")
      (string.eq (opt.opt-inline-shape-reason-text return-type) "return-type")
      (string.eq
        (opt.opt-inline-shape-reason-text shifted)
        "params-not-sequential")
      (string.eq (opt.opt-inline-shape-reason-text single) "structure")
      (string.eq (opt.opt-inline-shape-reason-text store) "ok")
      ;; ...and the `other-instr:<kind>` vocabulary still reports a kind no
      ;; whitelist carries. `syscall` is that kind: it names a body the inliner
      ;; must never clone.
      (string.eq
        (opt.opt-inline-shape-reason-text
          (+ (opt.opt-inline-shape-other-base) 2))
        "other-instr:syscall"))))

;; The register allocator recovers an aggregate's storage by scanning for a
;; maximal run of `Alloc` with CONSECUTIVE dst ids closed by an `AddrOf` of the
;; run's last id, inside one block (compiler_regalloc.tl
;; compiler-reg-color-detect-storage-seq). The clone's rebasing is affine and
;; moves nothing, so a spliced body's run has to survive that scan unchanged --
;; a run that lost a word would give a 32-byte aggregate an 8-byte slot. These
;; two counters are the same scan, so the fixture below pins the invariant the
;; allocator actually reads.
(define (opt-count-alloc-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [index : i64 0]
    [total : i64 0]
    (while (< index count)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Alloc _ _) (set! total (+ total 1))]
        [_ unit])
      (set! index (+ index 1)))
    total))

(define (opt-count-closed-alloc-runs-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [index : i64 0]
    [run-first : i64 (- 0 1)]
    [run-last : i64 (- 0 1)]
    [run-count : i64 0]
    [runs : i64 0]
    (while (< index count)
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Alloc dst _)
          (if (or (= run-count 0) (= dst (+ run-last 1)))
            (begin
              (if (= run-count 0)
                (set! run-first dst)
                unit)
              (set! run-last dst)
              (set! run-count (+ run-count 1)))
            (begin
              (set! run-first dst)
              (set! run-last dst)
              (set! run-count 1)))]
        [(AddrOf _ src)
          (if (and
            (> run-count 0)
            (= src run-last)
            (= run-first (+ (- src run-count) 1)))
            (set! runs (+ runs 1))
            unit)
          (set! run-first (- 0 1))
          (set! run-last (- 0 1))
          (set! run-count 0)]
        [_
          (set! run-first (- 0 1))
          (set! run-last (- 0 1))
          (set! run-count 0)])
      (set! index (+ index 1)))
    runs))

(define (opt-count-alloc-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-alloc-instr-seq instrs) (opt-count-alloc-blocks rest))])]))

(define (opt-count-closed-alloc-runs-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-closed-alloc-runs-instr-seq instrs)
            (opt-count-closed-alloc-runs-blocks rest))])]))

(define (opt-inline-alloc-sret-callee [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    callee-name
    (opt-inline-alloc-sret-params)
    (U64)
    9
    (opt-inline-alloc-sret-body 5 2)
    Ordinary))

;; The site is inside a loop, and it is spliced ONCE: the clone's storage run
;; is created at the site, not per iteration, so the merged caller holds the
;; caller's own run plus exactly one copy of the callee's.
(define (opt-inline-alloc-sret-caller [caller-name : i64] [callee-name : i64]) : ir.CompilerIrFunction
  (Function
    caller-name
    (ir.compiler-ir-param-seq-empty)
    (I64)
    11
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "latch:
               %9 = add %6, 1 : i64
               jump header
             exit:
               %10 = load %4 : i64
               return %10")
      (irt.block
        "entry:
           %0 = alloc i64
           %1 = alloc i64
           %2 = alloc i64
           %3 = alloc i64
           %4 = addr_of %3
           %5 = mov 0 : i64
           jump header")
      (irt.block
        "header:
             %6 = phi [%5, entry], [%9, latch] : i64
             %7 = lt %6, 4 : i64
             branch %7, body, exit")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "body")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            8
            callee-name
            (Two (Bool true) (Var 4))
            (U64))
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch")))))
    Ordinary))

(define (opt-inline-alloc-sret-functions
  [caller-name : i64]
  [callee-name : i64]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (& (opt-inline-alloc-sret-caller caller-name callee-name))
    (&
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-alloc-sret-callee callee-name))
        (& (ir.compiler-ir-function-seq-empty))))))

;; The splice itself: the call is gone, the merged caller verifies, and both
;; storage runs -- the caller's own and the one copy the site imported -- are
;; still the shape the allocator scans for.
(define (compiler-optimize-inline-multiblock-alloc-splice-ok?) : bool
  (let
    [callee-name : i64 (opt-test-symbol "inline_alloc_sret")]
    [caller-name : i64 (opt-test-symbol "alloc_sret_main")]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-alloc-sret-functions caller-name callee-name)
        2)]
    (match (opt-function-seq-find optimized "alloc_sret_main")
      [(Some main)
        (let
          [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-blocks
                (ir.compiler-ir-block-list-view blocks)
                "inline_alloc_sret")
              0)
            (=
              (opt-count-alloc-blocks (ir.compiler-ir-block-list-view blocks))
              8)
            (=
              (opt-count-closed-alloc-runs-blocks
                (ir.compiler-ir-block-list-view blocks))
              2)
            (opt.opt-inline-structure-ok? (& blocks))))]
      [(No) false])))

(define (compiler-optimize-inline-self-test) : i64
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-frame-functions symbols)
        2)]
    [devirt-direct : ir.CompilerIrFunction
      (opt-devirt-known-function-function
        (opt-inline-known-indirect-caller symbols))]
    [devirt-dynamic : ir.CompilerIrFunction
      (opt-devirt-known-function-function (opt-devirt-dynamic-caller))]
    [devirt-local-alias : ir.CompilerIrFunction
      (opt-devirt-known-function-function (opt-devirt-local-alias-caller false))]
    [devirt-duplicate-alias : ir.CompilerIrFunction
      (opt-devirt-known-function-function (opt-devirt-local-alias-caller true))]
    [devirt-inlined : ir.CompilerIrFunctionSeq
      (opt-test-inline-program-functions
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-inline-known-indirect-functions symbols)
        2)]
    [devirt-reach : ir.CompilerIrFunctionSeq
      (let
        [program
          (opt-test-optimize-program-with-level (opt-devirt-reach-program) 2)]
        (opt-program-functions program))]
    [valid-structure : bool
      (opt.opt-inline-structure-ok?
        (&
          (let
            [func (opt-inline-frame-caller symbols)]
            (opt.opt-function-blocks func))))]
    [duplicate-def-structure : bool
      (opt.opt-inline-structure-ok?
        (&
          (let
            [func (opt-ssa-duplicate-def-function)]
            (opt.opt-function-blocks func))))]
    [duplicate-label-revert : ir.CompilerIrFunction
      (let
        [fallback (opt-inline-frame-caller symbols)]
        (opt-test-inline-revert-or-keep
          fallback
          (opt-ssa-duplicate-label-function)))]
    [unknown-successor-revert : ir.CompilerIrFunction
      (let
        [fallback (opt-inline-frame-caller symbols)]
        (opt-test-inline-revert-or-keep
          fallback
          (opt-ssa-unknown-successor-function)))]
    [bad-phi-revert : ir.CompilerIrFunction
      (let
        [fallback (opt-inline-frame-caller symbols)]
        (opt-test-inline-revert-or-keep fallback (opt-ssa-bad-phi-function)))]
    [valid-keep : ir.CompilerIrFunction
      (let
        [fallback (opt-inline-frame-caller symbols)]
        (opt-test-inline-revert-or-keep
          fallback
          (opt-inline-frame-callee symbols)))]
    (match (opt-function-seq-find optimized "main")
      [(Some main)
        (let
          [instrs : ir.CompilerIrInstrSeq (opt-function-first-instrs main)]
          (unless (= (opt.opt-function-frame main) 4) (return 1))
          (unless (= (ir.compiler-ir-instr-seq-count instrs) 5) (return 2))
          (unless (= (opt-inline-count-binop-dst instrs 3) 1) (return 3))
          (unless (= (opt-inline-count-binop-dst instrs 5) 0) (return 4))
          (unless (opt-inline-mov-dst-src? instrs 2 3) (return 5))
          (unless
            (= (opt-count-direct-call-name-instr-seq instrs "inline_add") 0)
            (return 6))
          (unless
            (=
              (let
                [instrs (opt-function-first-instrs devirt-direct)]
                (opt-count-direct-call-name-instr-seq instrs "inline_add"))
              1)
            (return 7))
          (unless
            (=
              (let
                [instrs (opt-function-first-instrs devirt-direct)]
                (opt-count-indirect-call-instrs instrs))
              0)
            (return 8))
          (unless
            (=
              (let
                [instrs (opt-function-first-instrs devirt-dynamic)]
                (opt-count-indirect-call-instrs instrs))
              1)
            (return 9))
          (unless
            (=
              (let
                [instrs (opt-function-first-instrs devirt-dynamic)]
                (opt-count-direct-call-name-instr-seq instrs "inline_add"))
              0)
            (return 10))
          (unless
            (=
              (let
                [blocks (opt.opt-function-blocks devirt-local-alias)]
                (opt-count-direct-call-name-blocks
                  (ir.compiler-ir-block-list-view blocks)
                  "local_alias_target"))
              1)
            (return 111))
          (unless
            (=
              (let
                [walked-blocks : ir.CompilerIrBlockList
                  (opt.opt-function-blocks devirt-local-alias)]
                (opt-count-indirect-call-blocks
                  (ir.compiler-ir-block-list-view walked-blocks)))
              0)
            (return 112))
          ;; Multiple definitions make the alias path-dependent, even when
          ;; every definition happens to be a function literal.
          (unless
            (=
              (let
                [walked-blocks : ir.CompilerIrBlockList
                  (opt.opt-function-blocks devirt-duplicate-alias)]
                (opt-count-indirect-call-blocks
                  (ir.compiler-ir-block-list-view walked-blocks)))
              1)
            (return 113))
          (match (opt-function-seq-find devirt-inlined "main")
            [(Some indirect-main)
              (let
                [indirect-instrs : ir.CompilerIrInstrSeq
                  (opt-function-first-instrs indirect-main)]
                (unless
                  (= (opt.opt-function-frame indirect-main) 4)
                  (return 11))
                (unless
                  (= (ir.compiler-ir-instr-seq-count indirect-instrs) 5)
                  (return 12))
                (unless
                  (= (opt-inline-count-binop-dst indirect-instrs 3) 1)
                  (return 13))
                (unless
                  (= (opt-count-indirect-call-instrs indirect-instrs) 0)
                  (return 14))
                (unless
                  (opt-inline-mov-dst-src? indirect-instrs 2 3)
                  (return 15))
                (unless
                  (= (ir.compiler-ir-function-seq-count devirt-reach) 1)
                  (return 16))
                (unless
                  (opt.opt-function-seq-defines? devirt-reach "main")
                  (return 17))
                (when
                  (opt.opt-function-seq-defines? devirt-reach "kept_target")
                  (return 18))
                (when
                  (opt.opt-function-seq-defines? devirt-reach "dead")
                  (return 19))
                (unless valid-structure (return 20))
                (unless duplicate-def-structure (return 21))
                (unless
                  (let
                    [type-segment-bases
                      (ast.ast-node-pool-reader-type-segment-bases)]
                    [b (opt-inline-frame-caller symbols)]
                    (opt.opt-function-eq
                      type-segment-bases
                      duplicate-label-revert
                      b))
                  (return 22))
                (unless
                  (let
                    [type-segment-bases
                      (ast.ast-node-pool-reader-type-segment-bases)]
                    [b (opt-inline-frame-caller symbols)]
                    (opt.opt-function-eq
                      type-segment-bases
                      unknown-successor-revert
                      b))
                  (return 23))
                (unless
                  (let
                    [type-segment-bases
                      (ast.ast-node-pool-reader-type-segment-bases)]
                    [b (opt-inline-frame-caller symbols)]
                    (opt.opt-function-eq type-segment-bases bad-phi-revert b))
                  (return 24))
                (unless
                  (let
                    [type-segment-bases
                      (ast.ast-node-pool-reader-type-segment-bases)]
                    [b (opt-inline-frame-callee symbols)]
                    (opt.opt-function-eq type-segment-bases valid-keep b))
                  (return 25))
                (unless (compiler-optimize-inline-level-gate-ok?) (return 26))
                (unless
                  (compiler-optimize-inline-self-recursive-ok?)
                  (return 27))
                (unless (compiler-optimize-inline-large-callee-ok?) (return 28))
                (unless
                  (compiler-optimize-inline-bounds-callee-ok?)
                  (return 29))
                (unless
                  (compiler-optimize-inline-checked-depth-weighting-ok?)
                  (return 101))
                (unless
                  (compiler-optimize-inline-checked-window-ok?)
                  (return 102))
                (unless
                  (compiler-optimize-inline-checked-budget-ok?)
                  (return 103))
                (unless
                  (compiler-optimize-inline-checked-band-exclusion-ok?)
                  (return 104))
                (unless
                  (compiler-optimize-inline-checked-call-carrying-ok?)
                  (return 105))
                (unless
                  (compiler-optimize-inline-checked-call-carrying-deep-ok?)
                  (return 106))
                (unless
                  (compiler-optimize-inline-checked-call-carrying-revert-ok?)
                  (return 107))
                (unless
                  (compiler-optimize-spans-inline-multiblock-call-ok?)
                  (return 108))
                (unless
                  (compiler-optimize-inline-clone-abort-span-ok?)
                  (return 109))
                (unless
                  (compiler-optimize-inline-chain-second-import-call-ok?)
                  (return 110))
                (unless
                  (compiler-optimize-inline-bounds-labels-distinct-ok?)
                  (return 46))
                (unless
                  (compiler-optimize-inline-bounds-label-guard-ok?)
                  (return 47))
                (unless
                  (compiler-optimize-inline-bounds-leaf-body-gate-ok?)
                  (return 48))
                (unless
                  (compiler-optimize-inline-small-bounds-leaf-ok?)
                  (return 55))
                (unless
                  (compiler-optimize-inline-bounds-leaf-char-return-ok?)
                  (return 56))
                (unless
                  (compiler-optimize-inline-band-boundary-ok?)
                  (return 57))
                (unless (compiler-optimize-inline-dense-input-ok?) (return 58))
                (unless (compiler-optimize-inline-multi-call-ok?) (return 30))
                (unless
                  (compiler-optimize-inline-census-direct-ok?)
                  (return 31))
                (unless
                  (compiler-optimize-inline-census-address-ok?)
                  (return 32))
                (unless (compiler-optimize-inline-cost-model-ok?) (return 33))
                (unless
                  (compiler-optimize-inline-bottom-up-writeback-ok?)
                  (return 34))
                (unless
                  (compiler-optimize-inline-mutual-scc-refusal-ok?)
                  (return 35))
                (unless (compiler-optimize-inline-pack-word-ok?) (return 36))
                (unless (compiler-optimize-inline-multiblock-ok?) (return 37))
                (unless
                  (compiler-optimize-inline-multiblock-acyclic-ok?)
                  (return 39))
                (unless
                  (compiler-optimize-inline-multiblock-bounds-ok?)
                  (return 46))
                (unless
                  (compiler-optimize-inline-multiblock-switch-ok?)
                  (return 50))
                (unless
                  (compiler-optimize-inline-multiblock-switch-cost-refusal-ok?)
                  (return 51))
                (unless
                  (compiler-optimize-inline-mut-param-loop-ok?)
                  (return 44))
                (unless
                  (compiler-optimize-inline-caller-phi-loop-ok?)
                  (return 45))
                (unless
                  (compiler-optimize-inline-multiblock-nonleaf-ok?)
                  (return 40))
                (unless
                  (compiler-optimize-inline-multiblock-tail-call-ok?)
                  (return 60))
                (unless
                  (compiler-optimize-inline-multiblock-tail-call-indirect-refusal-ok?)
                  (return 61))
                (unless
                  (compiler-optimize-inline-multiblock-tail-call-idempotent-ok?)
                  (return 62))
                (unless
                  (compiler-optimize-inline-single-block-tail-call-ok?)
                  (return 63))
                (unless
                  (compiler-optimize-inline-single-block-tail-call-level1-refusal-ok?)
                  (return 64))
                (unless
                  (compiler-optimize-inline-single-block-tail-call-indirect-refusal-ok?)
                  (return 65))
                (unless
                  (compiler-optimize-inline-single-block-self-tail-call-refusal-ok?)
                  (return 66))
                (unless
                  (compiler-optimize-inline-single-block-tail-call-to-caller-refusal-ok?)
                  (return 67))
                (unless
                  (compiler-optimize-inline-tail-site-return-exit-ok?)
                  (return 68))
                (unless
                  (compiler-optimize-inline-tail-site-tail-exit-ok?)
                  (return 69))
                (unless
                  (compiler-optimize-inline-tail-site-indirect-refusal-ok?)
                  (return 70))
                (unless
                  (compiler-optimize-inline-tail-site-self-recursion-refusal-ok?)
                  (return 71))
                (unless
                  (compiler-optimize-inline-tail-site-mutual-recursion-refusal-ok?)
                  (return 72))
                (unless
                  (compiler-optimize-inline-tail-site-level1-refusal-ok?)
                  (return 73))
                (unless
                  (compiler-optimize-inline-repeated-tiny-predicate-ok?)
                  (return 46))
                (unless
                  (compiler-optimize-inline-repeated-nonleaf-predicate-refusal-ok?)
                  (return 47))
                (unless
                  (compiler-optimize-inline-multiblock-return-gate-ok?)
                  (return 49))
                (unless
                  (compiler-optimize-inline-private-memory-boundary-ok?)
                  (return 59))
                42)]
            [(No) 41]))]
      [(No) 43])))

(define (opt-block-list-has-label?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [label : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block block-label _)
          (if (= block-label label)
            true
            (opt-block-list-has-label? rest label))])]))

(define (opt-block-list-label-at?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [index : i64]
  [label : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (if (= index 0)
        (match (owned_view.compiler-owned-reference-shared-view block)
          [(Block block-label _) (= block-label label)])
        (opt-block-list-label-at? rest (- index 1) label))]))

(define (opt-count-branches-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-branches-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(Branch _ _ _) 1]
          [_ 0])))))

(define (opt-count-branches-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-branches-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-branches-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-branches-instr-seq instrs)
            (opt-count-branches-blocks rest))])]))

(define (opt-count-jump-to-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [target : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-jump-to-instr-seq-from
      slots
      (+ index 1)
      count
      target
      (+
        acc
        (match (array-ref slots index)
          [(Jump label)
            (if (= label target)
              1
              0)]
          [_ 0])))))

(define (opt-count-jump-to-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [target : i64]) : i64
  (opt-count-jump-to-instr-seq-from instrs.slots 0 instrs.len target 0))

(define (opt-count-jump-to-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [target : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-jump-to-instr-seq instrs target)
            (opt-count-jump-to-blocks rest target))])]))

(define (opt-count-tail-call-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-tail-call-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(TailCall _ _ _) 1]
          [_ 0])))))

(define (opt-count-tail-call-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-tail-call-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-tail-call-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-tail-call-instr-seq instrs)
            (opt-count-tail-call-blocks rest))])]))

(define (opt-count-tail-call-name-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [name : String]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-tail-call-name-instr-seq-from
      slots
      (+ index 1)
      count
      (ir.compiler-ir-global-shared-view name)
      (+
        acc
        (match (array-ref slots index)
          [(TailCall target _ _)
            (if (string.eq (ir.compiler-ir-symbol-text target) name)
              1
              0)]
          [_ 0])))))

(define (opt-count-tail-call-name-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [name : String]) : i64
  (opt-count-tail-call-name-instr-seq-from instrs.slots 0 instrs.len name 0))

(define (opt-count-tail-call-name-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [name : String]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-tail-call-name-instr-seq
              instrs
              (ir.compiler-ir-global-shared-view name))
            (opt-count-tail-call-name-blocks rest name))])]))

;; ...and the same count read through a program, the way
;; opt-count-direct-call-name-function-seq reads its own: a site "taken" by
;; converting a tail call into an ordinary call has to be visible as the
;; difference between these two counts, so both are asked.
(define (opt-count-tail-call-name-function-seq
  [functions : ir.CompilerIrFunctionSeq]
  [func-name : String]
  [call-name : String]) : i64
  (match (opt-function-seq-find functions func-name)
    [(Some func)
      (let
        [blocks (opt.opt-function-blocks func)]
        (opt-count-tail-call-name-blocks
          (ir.compiler-ir-block-list-view blocks)
          call-name))]
    [(No) (- 0 1)]))

(define (opt-count-tail-call-indirect-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-tail-call-indirect-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(TailCallIndirect _ _ _) 1]
          [_ 0])))))

(define (opt-count-tail-call-indirect-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-tail-call-indirect-instr-seq-from
              instrs.slots
              0
              instrs.len
              0)
            (opt-count-tail-call-indirect-blocks rest))])]))

(define (opt-count-return-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-return-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(Return _) 1]
          [_ 0])))))

(define (opt-count-return-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-return-instr-seq-from instrs.slots 0 instrs.len 0)
            (opt-count-return-blocks rest))])]))

;; Total instructions across a function's blocks. A refusal test that only
;; counts terminators cannot tell "left alone" from "expanded into a copy of
;; itself", which is precisely the failure a self-recursive tail site would
;; produce, so the refusal tests count the body too.
(define (opt-count-instrs-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (ir.compiler-ir-instr-seq-count instrs)
            (opt-count-instrs-blocks rest))])]))

(define (opt-tailrec-test-params) : ir.CompilerIrParamSeq
  (irt.params "a=%0:i64, b=%1:i64"))

(define (opt-tailrec-test-function) : ir.CompilerIrFunction
  (let
    [name : i64 (opt-test-symbol "tail_swap")]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 2)]
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (irt.instr "tailcall tail_swap(%1, %0) : i64"))
    (ir.compiler-ir-instr-builder-push! (&mut builder) (irt.instr "return %0"))
    (Function
      name
      (opt-tailrec-test-params)
      (I64)
      2
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-builder-to-seq builder)))
      Ordinary)))

(define (opt-tailrec-expected-instrs) : ir.CompilerIrInstrSeq
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 5)]
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Mov 2 (Var 1) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Mov 3 (Var 0) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Mov 0 (Var 2) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Mov 1 (Var 3) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "entry")))
    (ir.compiler-ir-instr-builder-to-seq builder)))

(define (opt-tailrec-entry-instrs [blocks : (& blocks ir.CompilerIrBlockList)]) : ir.CompilerIrInstrSeq
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label "entry"))
    [(No) (ir.compiler-ir-instr-seq-empty)]
    [(Some block)
      (match block
        [(Block _ instrs) instrs])]))

(define (opt-tailrec-entry-collision-function) : ir.CompilerIrFunction
  (match (opt-tailrec-test-function)
    [(Function name params ret frame blocks function-abi)
      (Function
        name
        params
        ret
        frame
        (opt.opt-blocks-append
          (& blocks)
          (& (irt.blocks "entry__ssa_entry:
               return 0")))
        function-abi)]))

(define (compiler-optimize-tailrec-self-test) : i64
  (let
    [rewritten : ir.CompilerIrFunction
      (opt.opt-tailrec-function (opt-tailrec-test-function))]
    [rewritten-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks rewritten)]
    [rewritten-instrs : ir.CompilerIrInstrSeq
      (opt-tailrec-entry-instrs rewritten-blocks)]
    [collision : ir.CompilerIrFunction (opt-tailrec-entry-collision-function)]
    [collision-out : ir.CompilerIrFunction
      (opt.opt-tailrec-function (opt.compiler-opt-global-shared-view collision))]
    (cond
      [(not (= (opt.opt-function-frame rewritten) 4)) 1]
      [(not
          (opt.opt-instr-seq-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (& rewritten-instrs)
            (& (opt-tailrec-expected-instrs))))
        2]
      [(not
          (=
            (opt-count-tail-call-blocks
              (ir.compiler-ir-block-list-view rewritten-blocks))
            0))
        3]
      [(not
          (opt-rotate-ssa-test-single-jump-to?
            rewritten-blocks
            (ir.compiler-ir-label "entry__ssa_entry")
            (ir.compiler-ir-label "entry")))
        7]
      [(not
          (=
            (opt-count-jump-to-blocks
              (ir.compiler-ir-block-list-view rewritten-blocks)
              (ir.compiler-ir-label "entry"))
            2))
        4]
      [(not
          (opt.opt-function-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            collision
            collision-out))
        10]
      [else 42])))

(define (opt-count-phi-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-phi-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(Phi _ _ _) 1]
          [_ 0])))))

(define (opt-count-phi-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-phi-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-phi-blocks [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-phi-instr-seq instrs) (opt-count-phi-blocks rest))])]))

(define (opt-phi-types-match-instr-seq-from?
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [ty : ast.AstType]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    true
    (and
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Phi _ _ phi-ty) (opt.opt-type-eq type-segment-bases phi-ty (& ty))]
        [_ true])
      (opt-phi-types-match-instr-seq-from?
        type-segment-bases
        instrs
        (+ index 1)
        ty))))

(define (opt-phi-types-match-blocks?
  [type-segment-bases : i64]
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [ty : ast.AstType]) : bool
  (match blocks
    [(slice) true]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (and
            (opt-phi-types-match-instr-seq-from?
              type-segment-bases
              instrs
              0
              (ast.ast-global-shared-view ty))
            (opt-phi-types-match-blocks? type-segment-bases rest ty))])]))

(define (opt-count-mov-dst-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [dst : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mov-dst-instr-seq-from
      slots
      (+ index 1)
      count
      dst
      (+
        acc
        (match (array-ref slots index)
          [(Mov mov-dst _ _)
            (if (= mov-dst dst)
              1
              0)]
          [_ 0])))))

(define (opt-count-mov-dst-instr-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]) : i64
  (opt-count-mov-dst-instr-seq-from instrs.slots 0 instrs.len dst 0))

(define (opt-count-mov-dst-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-mov-dst-instr-seq instrs dst)
            (opt-count-mov-dst-blocks rest dst))])]))

(define (opt-count-arith-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-arith-instr-seq instrs) (opt-count-arith-blocks rest))])]))

(define (opt-count-arith-label-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [label : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block block-label instrs)
          (if (= block-label label)
            (opt-count-arith-instr-seq instrs)
            (opt-count-arith-label-blocks rest label))])]))

(define (opt-count-mul-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mul-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(BinOp _ op _ _ _)
            (match op
              [(Mul) 1]
              [_ 0])]
          [_ 0])))))

(define (opt-count-mul-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-mul-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-mul-label-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [label : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block block-label instrs)
          (if (= block-label label)
            (opt-count-mul-instr-seq instrs)
            (opt-count-mul-label-blocks rest label))])]))

(define (opt-blocks-mov-dst-i64-value
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(slice) fallback]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [value : i64 (opt-mov-dst-i64-value-instr-seq instrs dst fallback)]
            (if (= value fallback)
              (opt-blocks-mov-dst-i64-value rest dst fallback)
              value))])]))

(define (opt-count-cast-blocks [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-cast-instr-seq instrs) (opt-count-cast-blocks rest))])]))

(define (opt-count-gep-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-gep-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(Gep _ _ _ _) 1]
          [_ 0])))))

(define (opt-count-gep-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-gep-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-gep-blocks [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-gep-instr-seq instrs) (opt-count-gep-blocks rest))])]))

(define (opt-count-gep-label-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [label : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block block-label instrs)
          (if (= block-label label)
            (opt-count-gep-instr-seq instrs)
            (opt-count-gep-label-blocks rest label))])]))

(define (opt-count-word-instrs-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Word _ _ _ _) 1]
        [_ 0])
      (opt-count-word-instrs-from instrs (+ index 1)))))

(define (opt-count-word-instrs [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-word-instrs-from instrs 0))

(define (opt-count-load-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-load-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(Load _ _ _) 1]
          [_ 0])))))

(define (opt-count-load-instr-seq [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-load-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-load-blocks [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-load-instr-seq instrs) (opt-count-load-blocks rest))])]))

(define (opt-count-load-label-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [label : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block block-label instrs)
          (if (= block-label label)
            (opt-count-load-instr-seq instrs)
            (opt-count-load-label-blocks rest label))])]))

(define (opt-blocks-binop-lhs-var
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(slice) fallback]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [value : i64 (opt-copy-binop-lhs-var-instr-seq instrs dst)]
            (if (= value (- 0 1))
              (opt-blocks-binop-lhs-var rest dst fallback)
              value))])]))

(define (opt-blocks-mov-src-var
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(slice) fallback]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [value : i64 (opt-mov-src-var-instr-seq instrs dst fallback)]
            (if (= value fallback)
              (opt-blocks-mov-src-var rest dst fallback)
              value))])]))

(define (opt-mov-src-var-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(Mov mov-dst (Var src) _)
        (if (= mov-dst dst)
          src
          (opt-mov-src-var-instr-seq-from slots (+ index 1) count dst fallback))]
      [_ (opt-mov-src-var-instr-seq-from slots (+ index 1) count dst fallback)])))

(define (opt-mov-src-var-instr-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-src-var-instr-seq-from instrs.slots 0 instrs.len dst fallback))

;; The var a `return` reads, or `fallback` when no block returns a var. Used to
;; pin which value a substituted use ends up reading.
(define (opt-return-var-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(Return (Some (Var var))) var]
      [_ (opt-return-var-instr-seq-from slots (+ index 1) count fallback)])))

(define (opt-return-i64-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(Return (Some (I64 value))) value]
      [_ (opt-return-i64-instr-seq-from slots (+ index 1) count fallback)])))

(define (opt-blocks-return-i64
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [fallback : i64]) : i64
  (match blocks
    [(slice) fallback]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [value : i64
              (opt-return-i64-instr-seq-from instrs.slots 0 instrs.len fallback)]
            (if (= value fallback)
              (opt-blocks-return-i64 rest fallback)
              value))])]))

(define (opt-blocks-return-var
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [fallback : i64]) : i64
  (match blocks
    [(slice) fallback]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [value : i64
              (opt-return-var-instr-seq-from instrs.slots 0 instrs.len fallback)]
            (if (= value fallback)
              (opt-blocks-return-var rest fallback)
              value))])]))

(define (opt-cfg-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "cfg")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-sccp-cond-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool"))

(define (opt-sccp-loop-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%4:bool"))

(define (opt-gvn-scalar-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, lhs=%1:i64, rhs=%2:i64"))

(define (opt-gvn-pointer-params) : ir.CompilerIrParamSeq
  (irt.params "ptr=%1:i64"))

(define (opt-gvn-pointer-cond-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, ptr=%1:i64"))

(define (opt-gvn-checked-ref-cond-params) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "cond" (Bool) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "read" (ast.ast-ty-ref 0 (& (I64))) 1)
      (ir.compiler-ir-param-seq-prepend
        (Param "write" (ast.ast-ty-mut-ref 0 (& (I64))) 2)
        (ir.compiler-ir-param-seq-empty)))))

(define (opt-gvn-function
  [name : String]
  [params : ir.CompilerIrParamSeq]
  [ret-ty : ast.AstType]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function (opt-test-symbol name) params ret-ty 16 blocks Ordinary))

(define (opt-gvn-dominated-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = add %1, %2 : i64
       branch %0, then, else
     then:
       %4 = add %1, %2 : i64
       jump join
     else:
       %5 = add %1, %2 : i64
       jump join
     join:
       %6 = phi [%4, then], [%5, else] : i64
       return %6"))

(define (opt-gvn-sibling-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       %3 = add %1, %2 : i64
       return %3
     else:
       %4 = add %1, %2 : i64
       return %4"))

(define (opt-gvn-phi-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %5 = phi [%1, entry], [%4, body] : i64
       %3 = add %5, %2 : i64
       branch %0, body, exit
     body:
       %4 = add %5, %2 : i64
       jump loop
     exit:
       return %3"))

(define (opt-gvn-load-barrier-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       jump use
     use:
       %4 = load %1 : i64
       return %4"))

(define (opt-gvn-load-join-safe-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       branch %0, then, else
     then:
       jump join
     else:
       jump join
     join:
       %4 = load %1 : i64
       return %4"))

(define (opt-gvn-checked-ref-store-path-blocks [lose-root? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "else:
           jump join
         join:
           %4 = load %1 : i64
           return %4")
    (irt.block
      "entry:
         %3 = load %1 : i64
         branch %0, then, else")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "then")
      (if lose-root?
        (irt.instrs
          "%2 = mov 99 : i64
             store_ptr %2, 9 : i64
             jump join")
        (irt.instrs "store_ptr %2, 9 : i64
             jump join")))))

(define (opt-gvn-load-store-path-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       branch %0, then, else
     then:
       store_ptr %1, 9 : i64
       jump join
     else:
       jump join
     join:
       %4 = load %1 : i64
       return %4"))

(define (opt-gvn-single-load-store-forward-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = alloc i64
       %1 = gep %0, 0 : i64
       store_ptr %1, 9 : i64
       jump use
     use:
       %3 = load %1 : i64
       return %3"))

(define (opt-gvn-load-call-path-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       branch %0, then, else
     then:
       %9 = call touch() : i64
       jump join
     else:
       jump join
     join:
       %4 = load %1 : i64
       return %4"))

(define (opt-gvn-load-address-redef-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       jump use
     use:
       %1 = mov 7 : i64
       %4 = load %1 : i64
       return %4"))

(define (opt-gvn-load-type-mismatch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       jump use
     use:
       %4 = load %1 : bool
       return %4"))

(define (opt-gvn-copy-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov %1 : i64
       jump use
     use:
       %4 = add %3, 1 : i64
       return %4"))

(define (opt-gvn-cast-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = cast %1 : i64 to i32
       jump use
     use:
       %4 = cast %1 : i64 to i32
       return %4"))

(define (opt-gvn-gep-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = gep %1, 8 : u8
       jump use
     use:
       %4 = gep %1, 8 : u8
       return %4"))

(define (opt-global-expr-hash-collision-guard-ok?) : bool
  (let
    [key : opt.OptGlobalExprKey (BinKey (Add) (Var 1) (Var 2) (I64))]
    [other-key : opt.OptGlobalExprKey (BinKey (Sub) (Var 1) (Var 2) (I64))]
    [buckets : (__tl_dyn-array opt.OptGlobalFacts)
      (__tl_make-array opt.OptGlobalFacts 1)]
    [table : opt.OptGlobalFactTable
      (opt.OptGlobalFactTable (opt.compiler-opt-global-shared-view buckets))]
    [doms : opt.OptDomInfo
      (opt-cfg-dominators
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "entry")
            (ir.compiler-ir-instr-seq-empty))))]
    (set!
      (array-ref buckets 0)
      (opt-global-facts-push
        (opt.opt-global-facts-new)
        (Expr (opt.compiler-opt-global-shared-view key) 7 0 1)))
    (and
      (match (opt.opt-global-fact-lookup
        (ast.ast-node-pool-reader-type-segment-bases)
        table
        (& (Expr key 8 0 0))
        doms
        0
        2)
        [(Some value)
          (match value
            [(Var id) (= id 7)]
            [_ false])]
        [(No) false])
      (match (opt.opt-global-fact-lookup
        (ast.ast-node-pool-reader-type-segment-bases)
        table
        (& (Expr other-key 8 0 0))
        doms
        0
        2)
        [(No) true]
        [(Some _) false]))))

(define (opt-gvn-hash-collision-guard-ok?) : bool
  (let
    [key : opt.OptExprKey (BinKey (Add) (Var 1) (Var 2) (I64))]
    [other-key : opt.OptExprKey (BinKey (Sub) (Var 1) (Var 2) (I64))]
    [buckets : (__tl_dyn-array opt.OptGvnBucket)
      (__tl_make-array opt.OptGvnBucket 1)]
    [table : opt.OptGvnMap
      (opt.OptGvnMap
        (opt.compiler-opt-global-shared-view buckets)
        (opt.opt-gvn-affine-defs-empty))]
    (set! (array-ref buckets 0) (opt.OptGvnBucket.Nil))
    (opt-gvn-table-insert!
      (ast.ast-node-pool-reader-type-segment-bases)
      table
      (Entry (opt.compiler-opt-global-shared-view key) 7 0))
    (and
      (=
        (opt.opt-gvn-lookup
          (ast.ast-node-pool-reader-type-segment-bases)
          table
          (& key))
        7)
      (=
        (opt.opt-gvn-lookup
          (ast.ast-node-pool-reader-type-segment-bases)
          table
          (& other-key))
        (- 0 1)))))

(define (opt-gvn-nearest-scope-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = add %1, %2 : i64
       jump mid
     mid:
       %4 = add %1, %2 : i64
       jump use
     use:
       %5 = add %1, %2 : i64
       return %5"))

(define (opt-gvn-scoped-nearest-dominator-ok?) : bool
  (let
    [out : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-scalar-params)
        (opt-gvn-nearest-scope-blocks))]
    (and
      (=
        (opt-blocks-mov-src-var (ir.compiler-ir-block-list-view out) 4 (- 0 1))
        3)
      (=
        (opt-blocks-mov-src-var (ir.compiler-ir-block-list-view out) 5 (- 0 1))
        4))))

;; The Pack is in `entry`, while its Var-backed Word extraction is in the
;; dominated `use` block. Global forwarding must rewrite the binop operand to
;; parameter v1; the array DCE then removes both the Word copy and the now-dead
;; Pack.
(define (opt-global-pack-word-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = pack [%0, %1] : Pair
       jump use
     use:
       %3 = word %2, 1 : i64
       %4 = add %3, 1 : i64
       return %4"))

(define (opt-global-pack-word-forwarded-blocks) : ir.CompilerIrBlockList
  (let
    [forwarded : ir.CompilerIrFunction
      (opt-global-value-number-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-function
          "global_pack_word"
          (opt-gvn-test-params)
          (I64)
          (opt-global-pack-word-blocks)))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks forwarded)]
    [uses : (__tl_dyn-array i64) (opt.opt-collect-blocks-uses-array 16 blocks)]
    (opt.opt-dce-block-list-array (& uses) (& blocks))))

;; --- wide-literal operand suppression ---------------------------------------
;;
;; Pins `opt-global-copy-keep-wide-left`: a constant that no operand can encode
;; as an immediate stays a Var reference at its use, so its defining Mov keeps
;; the hoistable form the bit-test rewrite (and LICM) built.
;;
;; Left operand of the BinOp defining `dst`: its var id while it is still a Var,
;; -1 once copy propagation replaced it with a literal, -2 when no such BinOp
;; survives.
(define (opt-wide-literal-lhs-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 2)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BinOp actual _ lhs _ _)
        (if (= actual dst)
          (match lhs
            [(Var id) id]
            [_ (- 0 1)])
          (opt-wide-literal-lhs-instr-seq instrs (+ index 1) dst))]
      [_ (opt-wide-literal-lhs-instr-seq instrs (+ index 1) dst)])))

(define (opt-wide-literal-lhs-var
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) (- 0 2)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64 (opt-wide-literal-lhs-instr-seq instrs 0 dst)]
            (if (= found (- 0 2))
              (opt-wide-literal-lhs-var rest dst)
              found))])]))

;; Right operand of the BinOp defining `dst`, same encoding as the left probe.
(define (opt-wide-literal-rhs-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 2)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BinOp actual _ _ rhs _)
        (if (= actual dst)
          (match rhs
            [(Var id) id]
            [_ (- 0 1)])
          (opt-wide-literal-rhs-instr-seq instrs (+ index 1) dst))]
      [_ (opt-wide-literal-rhs-instr-seq instrs (+ index 1) dst)])))

(define (opt-wide-literal-rhs-var
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) (- 0 2)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64 (opt-wide-literal-rhs-instr-seq instrs 0 dst)]
            (if (= found (- 0 2))
              (opt-wide-literal-rhs-var rest dst)
              found))])]))

;; `entry` defines the constant and jumps to the block it dominates, which shifts
;; it by a parameter. This is the bit-test mask shape: the constant is one block
;; up (a preheader, once a loop is around it) and the count is not constant, so
;; the shift can never fold.
(define (opt-wide-literal-cross-block-blocks [literal : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "use:
         %4 = shr %3, %1 : i64
         return %4")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (I64 literal) (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "use"))))))

;; Same two blocks with the constant on the RIGHT. The backend's own wide-RHS
;; relief covers this position, so the fold must survive untouched.
(define (opt-wide-literal-cross-block-rhs-blocks [literal : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "use:
         %4 = bit_and %1, %3 : i64
         return %4")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (I64 literal) (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "use"))))))

;; The constant and its use in ONE block. Nothing is hoistable here, so the
;; literal must still reach the operand -- the global sweep declines it by
;; position and the block-local copy propagation in the scalar folder does it,
;; which is what the whole-pipeline probe below checks.
(define (opt-wide-literal-same-block-blocks [literal : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (I64 literal) (I64))
        (irt.instr "%4 = shr %3, %1 : i64")
        (irt.instr "return %4")))))

;; The global sweep followed by DCE, so a Mov that survives is one the sweep
;; deliberately kept a use for.
(define (opt-wide-literal-gvn-blocks
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [propagated : ir.CompilerIrBlockList
      (let
        [func
          (opt-global-value-number-function
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function name (opt-gvn-scalar-params) (I64) blocks))]
        (opt.opt-function-blocks func))]
    [uses : (__tl_dyn-array i64)
      (opt.opt-collect-blocks-uses-array 16 propagated)]
    (opt.opt-dce-block-list-array (& uses) (& propagated))))

(define (opt-wide-literal-optimized-blocks
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [func
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-function name (opt-gvn-scalar-params) (I64) blocks))]
    (opt.opt-function-blocks func)))

;; A 64-bit window mask of the shape `opt-bit-test-mask-block` builds: well
;; outside imm32, so no operand can encode it.
(define (opt-wide-literal-mask) : i64
  4899916392364504625)

(define (compiler-optimize-wide-literal-operand-self-test) : i64
  (let
    [wide-left : ir.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "wide_left"
        (opt-wide-literal-cross-block-blocks (opt-wide-literal-mask)))]
    [imm32-left : ir.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "imm32_left"
        (opt-wide-literal-cross-block-blocks 1234567))]
    [wide-right : ir.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "wide_right"
        (opt-wide-literal-cross-block-rhs-blocks (opt-wide-literal-mask)))]
    [same-block : ir.CompilerIrBlockList
      (opt-wide-literal-optimized-blocks
        "wide_same_block"
        (opt-wide-literal-same-block-blocks (opt-wide-literal-mask)))]
    (cond
      ;; The wide constant stays a Var operand and its defining Mov survives,
      ;; which is what leaves the constant hoistable.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view wide-left)
              4)
            3))
        1]
      [(not
          (=
            (opt-count-mov-i64-value-blocks
              (ir.compiler-ir-block-list-view wide-left)
              (opt-wide-literal-mask))
            1))
        2]
      ;; An imm32 constant is an immediate in the same position, so it folds
      ;; exactly as before and its Mov dies.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view imm32-left)
              4)
            (- 0 1)))
        3]
      [(not
          (=
            (opt-count-mov-i64-value-blocks
              (ir.compiler-ir-block-list-view imm32-left)
              1234567)
            0))
        4]
      ;; Right operands keep folding at any width.
      [(not
          (=
            (opt-wide-literal-rhs-var
              (ir.compiler-ir-block-list-view wide-right)
              4)
            (- 0 1)))
        5]
      ;; Nothing to hoist inside one block: the pipeline still folds.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view same-block)
              4)
            (- 0 1)))
        6]
      [else 42])))

(define (opt-load-subst-return [var : i64]) : ir.CompilerIrInstr
  (Return (Some (Var var))))

;; Diamond: the join's read is redundant with the entry's, and its only use is
;; an ordinary operand, so the copy goes and the operand reads the entry load.
(define (opt-load-subst-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       branch %0, then, else
     then:
       jump join
     else:
       jump join
     join:
       %4 = load %1 : i64
       %5 = add %4, %4 : i64
       return %5"))

;; Phi-carried: the redundant read's ONLY use is a phi input, whose use position
;; is the incoming edge rather than the phi's block. The substituter refuses phi
;; inputs, so the use survives and the copy stays -- today's Mov form.
(define (opt-load-subst-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       branch %0, then, else
     then:
       %4 = load %1 : i64
       jump join
     else:
       jump join
     join:
       %5 = phi [%4, then], [%3, else] : i64
       return %5"))

;; Loop escape: the dominating read is INSIDE the loop and the redundant read is
;; after it, so substituting would pin the loop's value across every later
;; block. The profitability gate refuses; the copy stays.
(define (opt-load-subst-loop-escape-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump header
     header:
       %3 = load %1 : i64
       branch %0, body, exit
     body:
       jump header
     exit:
       %4 = load %1 : i64
       %5 = add %4, %4 : i64
       return %5"))

;; Same loop: both reads live in the same loop body, so substitution extends the
;; value only where it already lives. The gate allows it and the copy goes.
(define (opt-load-subst-loop-inner-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump header
     header:
       %3 = load %1 : i64
       branch %0, inner, exit
     inner:
       %4 = load %1 : i64
       %5 = add %4, %4 : i64
       jump header
     exit:
       return %3"))

;; GVN-LOOP-2: a loop whose body has no store or call. The entry's read is
;; carried across the back edge only when its value (var 3) is a use INSIDE
;; the loop: here the header doubles it, so the exit's re-read of `ptr` folds
;; onto the entry's load (one load left).
(define (opt-load-subst-loop-carry-live-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       jump header
     header:
       %5 = add %3, %3 : i64
       branch %0, body, exit
     body:
       jump header
     exit:
       %4 = load %1 : i64
       %6 = add %4, %4 : i64
       return %6"))

;; The same store-free loop, but nothing inside it reads var 3: carrying the
;; entry would pin a value across the loop that the loop never needs, so the
;; table drops it and the exit re-reads `ptr` (two loads).
(define (opt-load-subst-loop-carry-dead-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       jump header
     header:
       branch %0, body, exit
     body:
       jump header
     exit:
       %4 = load %1 : i64
       %6 = add %4, %4 : i64
       return %6"))

;; The live-value loop with a store in its body: the back edge may have
;; written `ptr`'s word, so nothing carries and the exit re-reads (two loads).
(define (opt-load-subst-loop-carry-store-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = load %1 : i64
       jump header
     header:
       %5 = add %3, %3 : i64
       branch %0, body, exit
     body:
       store_ptr %1, %5 : i64
       jump header
     exit:
       %4 = load %1 : i64
       %6 = add %4, %4 : i64
       return %6"))

(define (opt-load-subst-run [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-gvn-blocks
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-gvn-pointer-cond-params)
    blocks))

;; --- GSF-1: a global cell read right behind its own store ---------------------
;;
;; The probe stores `%1` into `gsf_cell` and reads the cell twice right behind
;; the store. The reads are word-cell promotion candidates (two reads of a
;; scalar, never address-taken global), so the walk materialises one `Mov`
;; for them -- and with the cell's contents known from the store, that `Mov`
;; reads `%1` instead of the cell: no `Mov dst @gsf_cell` and no `@gsf_cell`
;; operand survives in the block. A call to the program's writer between the
;; store and the reads may rewrite the cell, and the materialised `Mov` then
;; still reads it.
(defstruct OptGsfSymbols
  (cell i64)
  (writer i64)
  (probe i64))

(define (opt-gsf-symbols) : OptGsfSymbols
  (OptGsfSymbols
    (opt-test-symbol "gsf_cell")
    (opt-test-symbol "gsf_writer")
    (opt-test-symbol "gsf_probe")))

(define (opt-gsf-globals [symbols : OptGsfSymbols]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 1)]
    (opt-test-global-builder-push! (&mut builder) symbols.cell (I64) (I64 7))
    (ir.compiler-ir-global-builder-to-seq builder)))

;; The writer `set!`s the cell, which keeps it out of the proven-constant
;; substitution and gives the negative twin a callee that may write it.
(define (opt-gsf-writer-function [symbols : OptGsfSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.writer
    (ir.compiler-ir-param-seq-empty)
    (I64)
    4
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Store symbols.cell (I64 3) (I64))
          (irt.instr "return 0"))))
    Ordinary))

(define (opt-gsf-read-twice-tail [symbols : OptGsfSymbols]) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.BinOp
      6
      (Add)
      (Global symbols.cell)
      (Global symbols.cell)
      (I64))
    (opt-load-subst-return 6)))

(define (opt-gsf-blocks [symbols : OptGsfSymbols] [call? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instr-seq-append
        (if call?
          (opt-test-instrs
            (ir.CompilerIrInstr.Store symbols.cell (Var 1) (I64))
            (ir.CompilerIrInstr.Call 5 symbols.writer (Nil) (I64)))
          (opt-test-instrs
            (ir.CompilerIrInstr.Store symbols.cell (Var 1) (I64))))
        (opt-gsf-read-twice-tail symbols)))))

(define (opt-gsf-probe-function [symbols : OptGsfSymbols] [call? : bool]) : ir.CompilerIrFunction
  (Function
    symbols.probe
    (opt-gvn-pointer-cond-params)
    (I64)
    16
    (opt-gsf-blocks symbols call?)
    Ordinary))

(define (opt-gsf-run [call? : bool]) : ir.CompilerIrBlockList
  (let
    [symbols : OptGsfSymbols (opt-gsf-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (& (opt-gsf-writer-function symbols))
        (&
          (ir.compiler-ir-function-seq-prepend
            (& (opt-gsf-probe-function symbols call?))
            (& (ir.compiler-ir-function-seq-empty)))))]
    [cells : opt.OptGlobalCellSummary
      (opt.opt-global-cell-summary-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-gsf-globals symbols))
        (& functions))]
    [blocks : ir.CompilerIrBlockList (opt-gsf-blocks symbols call?)]
    (opt-gvn-blocks-with-context-and-call-memory
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks))
      (opt-gvn-pointer-cond-params)
      (opt_i64_i64_map.with-capacity 1)
      cells
      blocks)))

(define (compiler-optimize-global-store-forward-self-test) : i64
  (let
    [entry : i64 (ir.compiler-ir-label "entry")]
    [forwarded : ir.CompilerIrBlockList (opt-gsf-run false)]
    [kept : ir.CompilerIrBlockList (opt-gsf-run true)]
    (cond
      ;; the promoted read is a copy of %1: no cell load, no cell operand
      [(not
          (=
            (opt-lp-count-label
              (ir.compiler-ir-block-list-view forwarded)
              entry
              true)
            0))
        1]
      [(not
          (=
            (opt-lp-count-label
              (ir.compiler-ir-block-list-view forwarded)
              entry
              false)
            0))
        2]
      ;; the writer between store and reads: the cell is read
      [(=
          (+
            (opt-lp-count-label
              (ir.compiler-ir-block-list-view kept)
              entry
              true)
            (opt-lp-count-label
              (ir.compiler-ir-block-list-view kept)
              entry
              false))
          0)
        3]
      [else 42])))

(test
  global-store-forward
  (test.assert-i64-eq
    (compiler-optimize-global-store-forward-self-test)
    42
    "a global cell read right behind its own store reads the stored value, and a call that may write the cell in between keeps the cell read"))

;; --- GDP-1: a global array's handle gep is a header var ------------------------
;;
;; `gep @arr 0` is the descriptor's own address, so the u64 loaded through it is
;; the data pointer and every gep off that is an element address. The header
;; set is built from declared result types alone and had no opinion about a
;; gep, so the data pointer got no kind, `gep p, i` keyed Raw (by its own
;; temp), and two identical element reads of a global array never shared a
;; key. With the gep's dst marked a header var (only when the global's declared
;; type is a header type) the second element read is a copy of the first. A
;; scalar-typed global keeps all three loads.
(defstruct OptGdpSymbols
  (arr i64)
  (probe i64))

(define (opt-gdp-symbols) : OptGdpSymbols
  (OptGdpSymbols (opt-test-symbol "gdp_arr") (opt-test-symbol "gdp_probe")))

(define (opt-gdp-globals [symbols : OptGdpSymbols] [header? : bool]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 1)]
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.arr
      (if header?
        (DynArray 0)
        (I64))
      (I64 0))
    (ir.compiler-ir-global-builder-to-seq builder)))

;; `%1` is the index parameter; the two element reads are structurally the
;; same gep of the same data pointer.
(define (opt-gdp-blocks [symbols : OptGdpSymbols]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Gep 10 (Global symbols.arr) (I64 0) (I64))
        (irt.instr "%11 = load %10 : u64")
        (irt.instr "%12 = gep %11, %1 : i64")
        (irt.instr "%13 = load %12 : i64")
        (irt.instr "%14 = gep %11, %1 : i64")
        (irt.instr "%15 = load %14 : i64")
        (irt.instr "%16 = add %13, %15 : i64")
        (opt-load-subst-return 16)))))

(define (opt-gdp-probe-function [symbols : OptGdpSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.probe
    (opt-gvn-pointer-cond-params)
    (I64)
    20
    (opt-gdp-blocks symbols)
    Ordinary))

(define (opt-gdp-run [header? : bool]) : ir.CompilerIrBlockList
  (let
    [symbols : OptGdpSymbols (opt-gdp-symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (& (opt-gdp-probe-function symbols))
        (& (ir.compiler-ir-function-seq-empty)))]
    [cells : opt.OptGlobalCellSummary
      (opt.opt-global-cell-summary-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-gdp-globals symbols header?))
        (& functions))]
    [blocks : ir.CompilerIrBlockList (opt-gdp-blocks symbols)]
    (opt-gvn-blocks-with-context-and-call-memory
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt.opt-cfg-context-build (ir.compiler-ir-global-shared-view blocks))
      (opt-gvn-pointer-cond-params)
      (opt_i64_i64_map.with-capacity 1)
      cells
      blocks)))

(define (compiler-optimize-global-handle-gep-header-self-test) : i64
  (let
    [entry : i64 (ir.compiler-ir-label "entry")]
    [header : ir.CompilerIrBlockList (opt-gdp-run true)]
    [scalar : ir.CompilerIrBlockList (opt-gdp-run false)]
    (cond
      ;; the data pointer and ONE element read; the second is a copy
      [(not (= (opt-licm-multi-exit-count-loads header entry) 2)) 1]
      ;; a scalar global is no handle: nothing keys off it, three loads stay
      [(not (= (opt-licm-multi-exit-count-loads scalar entry) 3)) 2]
      [else 42])))

(test
  global-handle-gep-header
  (test.assert-i64-eq
    (compiler-optimize-global-handle-gep-header-self-test)
    42
    "a zero gep off a header-typed global's handle is a header var, so two identical element reads through its data pointer share one load; a scalar-typed global keeps every load"))

;; --- MF-2 join phis and MF-3 bypass-edge load PRE -----------------------------
;;
;; `cond` is var 0 and `arr` var 1, a descriptor handle -- the dereferenceable
;; base MF-3 admits. The scalar-pointer families above reuse
;; opt-gvn-pointer-cond-params, whose `ptr` is a plain i64 and therefore is NOT
;; a hoistable base; both parameter sets are needed to separate the two rules.
(define (opt-load-join-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, arr=%1:(__tl_dyn-array i64)"))

(define (opt-load-join-run [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-gvn-blocks
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-load-join-params)
    blocks))

;; `count` chained `mov` definitions from var `base`, so a loop that uses them
;; all is over the live-in budget.
(define (opt-load-join-pressure-defs
  [acc : (&mut acc ir.CompilerIrInstrBuilder)]
  [base : i64]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (while (< index count)
      (ir.compiler-ir-instr-builder-push!
        acc
        (ir.CompilerIrInstr.Mov (+ base index) (I64 (+ 7 index)) (I64)))
      (set! index (+ index 1)))
    unit))

;; `count - 1` chained adds reading every var the definitions above bound, so
;; each of them is a live-in of the block that holds this run.
(define (opt-load-join-pressure-uses
  [acc : (&mut acc ir.CompilerIrInstrBuilder)]
  [base : i64]
  [count : i64]
  [dst : i64]) : unit
  (let
    [index : i64 1]
    (while (< index count)
      (ir.compiler-ir-instr-builder-push!
        acc
        (ir.CompilerIrInstr.BinOp
          (+ dst index)
          (Add)
          (if (= index 1)
            (Var base)
            (Var (+ dst (- index 1))))
          (Var (+ base index))
          (I64)))
      (set! index (+ index 1)))
    unit))

(define (opt-load-join-pressure-count) : i64
  16)

;; A guard diamond whose two arms load one word into two names: the intersect at
;; `join` drops the key, MF-2 phis the two names instead.
(define (opt-load-join-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       %3 = load %1 : i64
       jump join
     else:
       %4 = load %1 : i64
       jump join
     join:
       %5 = load %1 : i64
       return %5"))

;; The same diamond, but the join is the preheader of a loop that is already
;; over opt-licm-chain-live-in-budget live-ins: the phi would be one
;; more, so the budget refuses it.
(define (opt-load-join-budget-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
                 return %6")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (ir.compiler-ir-instr-builder-to-seq
        (let
          [built : ir.CompilerIrInstrBuilder
            (ir.compiler-ir-instr-builder-with-capacity
              (+ (opt-load-join-pressure-count) 1))]
          (opt-load-join-pressure-defs
            (&mut built)
            20
            (opt-load-join-pressure-count))
          (ir.compiler-ir-instr-builder-push!
            (&mut built)
            (irt.instr "branch %0, then, else"))
          built)))
    (irt.block "then:
           %3 = load %1 : i64
           jump join")
    (irt.block "else:
             %4 = load %1 : i64
             jump join")
    (irt.block "join:
               jump header")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "header")
      (ir.compiler-ir-instr-builder-to-seq
        (let
          [built : ir.CompilerIrInstrBuilder
            (ir.compiler-ir-instr-builder-with-capacity
              (+ (opt-load-join-pressure-count) 2))]
          (opt-load-join-pressure-uses
            (&mut built)
            20
            (opt-load-join-pressure-count)
            60)
          (ir.compiler-ir-instr-builder-push!
            (&mut built)
            (irt.instr "%6 = load %1 : i64"))
          (ir.compiler-ir-instr-builder-push!
            (&mut built)
            (irt.instr "branch %0, header, exit"))
          built)))))

;; The partially redundant shape MF-3 owns: the descriptor word is loaded only
;; on the guarded arm, so the join loses it and re-derives it. `base?` false
;; bases the arm's gep on a DATA POINTER instead of the handle, which is not
;; dereferenceable on the bypass edge and must be refused.
(define (opt-load-pre-bypass-blocks [handle-base? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block
      "entry:
         %10 = gep %1, 0 : i64
         %11 = load %10 : u64
         branch %0, arm, join")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "arm")
      (opt-test-instrs
        (ir.CompilerIrInstr.Gep
          2
          (Var
            (if handle-base?
              1
              11))
          (I64 1)
          (I64))
        (irt.instr "%3 = load %2 : i64")
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "join"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "join")
      (opt-test-instrs
        (ir.CompilerIrInstr.Gep
          4
          (Var
            (if handle-base?
              1
              11))
          (I64 1)
          (I64))
        (irt.instr "%5 = load %4 : i64")
        (ir.CompilerIrInstr.Gep
          6
          (Var
            (if handle-base?
              1
              11))
          (I64 1)
          (I64))
        (irt.instr "%7 = load %6 : i64")
        (irt.instr "return %7")))))

(define (opt-load-pre-latch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump header
     header:
       jump latch
     latch:
       branch %0, arm, header
     arm:
       %2 = gep %1, 1 : i64
       %3 = load %2 : i64
       jump exit
     exit:
       %4 = gep %1, 1 : i64
       %5 = load %4 : i64
       %6 = gep %1, 1 : i64
       %7 = load %6 : i64
       return %7"))

;; The hoist destination is a loop header already at the live-in budget: the
;; hoisted value would be one more value live across a loop that is already
;; paying for as many as the budget allows.
(define (opt-load-pre-pressure-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "exit:
               %4 = gep %1, 1 : i64
               %5 = load %4 : i64
               %6 = gep %1, 1 : i64
               %7 = load %6 : i64
               return %7")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (ir.compiler-ir-instr-builder-to-seq
        (let
          [built : ir.CompilerIrInstrBuilder
            (ir.compiler-ir-instr-builder-with-capacity
              (+ (opt-load-join-pressure-count) 1))]
          (opt-load-join-pressure-defs
            (&mut built)
            20
            (opt-load-join-pressure-count))
          (ir.compiler-ir-instr-builder-push!
            (&mut built)
            (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header")))
          built)))
    (irt.block "header:
           branch %0, arm, exit")
    (irt.block
      "arm:
             %2 = gep %1, 1 : i64
             %3 = load %2 : i64
             jump latch")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "latch")
      (ir.compiler-ir-instr-builder-to-seq
        (let
          [built : ir.CompilerIrInstrBuilder
            (ir.compiler-ir-instr-builder-with-capacity
              (+ (opt-load-join-pressure-count) 1))]
          (opt-load-join-pressure-uses
            (&mut built)
            20
            (opt-load-join-pressure-count)
            60)
          (ir.compiler-ir-instr-builder-push!
            (&mut built)
            (irt.instr "branch %0, header, exit"))
          built)))))

(define (compiler-optimize-load-join-pre-self-test) : i64
  (let
    [diamond : ir.CompilerIrBlockList
      (opt-load-join-run (opt-load-join-diamond-blocks))]
    [budget : ir.CompilerIrBlockList
      (opt-load-join-run (opt-load-join-budget-blocks))]
    [bypass : ir.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-bypass-blocks true))]
    [element : ir.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-bypass-blocks false))]
    [latch : ir.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-latch-blocks))]
    [pressure : ir.CompilerIrBlockList
      (opt-load-join-run (opt-load-pre-pressure-blocks))]
    (cond
      ;; MF-2: the two arms' names become one phi in the join, and the join's
      ;; own load reads it instead of repeating the read.
      [(not
          (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view diamond)) 1))
        50]
      [(not
          (= (opt-count-load-blocks (ir.compiler-ir-block-list-view diamond)) 2))
        51]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view diamond)
              (ir.compiler-ir-label "join"))
            0))
        52]
      ;; MF-2 budget: the join is the preheader of a loop already over the
      ;; live-in budget, so no phi is minted at all.
      [(not
          (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view budget)) 0))
        53]
      ;; MF-3: the guarded arm's `gep ; load` moves into the guard block, so the
      ;; join reuses it and the function loads the word once.
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view bypass)
              (ir.compiler-ir-label "arm"))
            0))
        54]
      [(not
          (= (opt-count-load-blocks (ir.compiler-ir-block-list-view bypass)) 2))
        55]
      ;; MF-3 refuses an element base: a data pointer read out of the descriptor
      ;; is not dereferenceable on the edge the guard was protecting.
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view element)
              (ir.compiler-ir-label "arm"))
            1))
        56]
      ;; MF-3 refuses a loop latch as the destination.
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view latch)
              (ir.compiler-ir-label "latch"))
            0))
        57]
      ;; MF-3 refuses a destination in a loop already at the live-in budget.
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view pressure)
              (ir.compiler-ir-label "header"))
            0))
        58]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view pressure)
              (ir.compiler-ir-label "arm"))
            1))
        59]
      [else 42])))

(define (compiler-optimize-load-gvn-substitution-self-test) : i64
  (let
    [diamond : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-diamond-blocks))]
    [diamond-again : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-run (opt-load-subst-diamond-blocks)))]
    [phi : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-phi-blocks))]
    [loop-escape : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-escape-blocks))]
    [loop-inner : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-inner-blocks))]
    [carry-live : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-carry-live-blocks))]
    [carry-dead : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-carry-dead-blocks))]
    [carry-store : ir.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-carry-store-blocks))]
    (cond
      ;; Diamond: one load left, no copy, and the operand reads the dominating
      ;; load directly.
      [(not
          (= (opt-count-load-blocks (ir.compiler-ir-block-list-view diamond)) 1))
        1]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view diamond)
              4)
            0))
        2]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view diamond)
              5
              (- 0 1))
            3))
        3]
      ;; Idempotent: a second pass over the substituted blocks changes nothing.
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view diamond-again))
            1))
        4]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view diamond-again)
              4)
            0))
        5]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view diamond-again)
              5
              (- 0 1))
            3))
        6]
      ;; Phi-carried use: the copy survives as the Mov form, phi input intact.
      [(not (= (opt-count-load-blocks (ir.compiler-ir-block-list-view phi)) 1))
        7]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view phi)
              4
              (- 0 1))
            3))
        8]
      ;; Loop escape: rewritten, but left as a copy rather than pinning the
      ;; loop's value across the exit.
      [(not
          (=
            (opt-count-load-blocks (ir.compiler-ir-block-list-view loop-escape))
            1))
        9]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view loop-escape)
              4
              (- 0 1))
            3))
        10]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view loop-escape)
              5
              (- 0 1))
            4))
        11]
      ;; Same loop: substituted, exactly like the diamond.
      [(not
          (=
            (opt-count-load-blocks (ir.compiler-ir-block-list-view loop-inner))
            1))
        12]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view loop-inner)
              4)
            0))
        13]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view loop-inner)
              5
              (- 0 1))
            3))
        14]
      ;; GVN-LOOP-2: the store-free loop carries the entry read whose value it
      ;; uses, so the exit's re-read folds; a value the loop never reads is not
      ;; carried, and a store in the body carries nothing.
      [(not
          (=
            (opt-count-load-blocks (ir.compiler-ir-block-list-view carry-live))
            1))
        15]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view carry-live)
              6
              (- 0 1))
            3))
        16]
      [(not
          (=
            (opt-count-load-blocks (ir.compiler-ir-block-list-view carry-dead))
            2))
        17]
      [(not
          (=
            (opt-count-load-blocks (ir.compiler-ir-block-list-view carry-store))
            2))
        18]
      ;; The join-phi (MF-2) and bypass-edge load PRE (MF-3) families run from
      ;; here, so they are covered by this suite's one registered entry point.
      [else (compiler-optimize-load-join-pre-self-test)])))

(define (opt-global-simd-copy-select-var-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [read-mask? : bool]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Select payload-box)
        (let
          [actual-dst (opt.compiler-opt-box-field-shared-view payload-box dst)]
          [value
            (if read-mask?
              (opt.compiler-opt-box-field-shared-view payload-box mask)
              (opt.compiler-opt-box-field-shared-view payload-box on-true))]
          (if (= actual-dst dst)
            (match value
              [(Var var) var]
              [_ (- 0 1)])
            (opt-global-simd-copy-select-var-instr-seq-from
              instrs
              (+ index 1)
              dst
              read-mask?)))]
      [_
        (opt-global-simd-copy-select-var-instr-seq-from
          instrs
          (+ index 1)
          dst
          read-mask?)])))

(define (opt-global-simd-copy-select-var-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]
  [read-mask? : bool]) : i64
  (match blocks
    [(slice) (- 0 1)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64
              (opt-global-simd-copy-select-var-instr-seq-from
                instrs
                0
                dst
                read-mask?)]
            (if (= found (- 0 1))
              (opt-global-simd-copy-select-var-blocks rest dst read-mask?)
              found))])]))

(define (opt-global-simd-copy-vector-lhs-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) (- 0 1)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64 (opt-vector-binop-lhs-var instrs dst)]
            (if (= found (- 0 1))
              (opt-global-simd-copy-vector-lhs-blocks rest dst)
              found))])]))

(define (opt-global-simd-copy-reduce-src-instr-seq-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(VectorReduce actual _ src _ _)
        (if (= actual dst)
          (match src
            [(Var var) var]
            [_ (- 0 1)])
          (opt-global-simd-copy-reduce-src-instr-seq-from
            instrs
            (+ index 1)
            dst))]
      [_
        (opt-global-simd-copy-reduce-src-instr-seq-from instrs (+ index 1) dst)])))

(define (opt-global-simd-copy-reduce-src-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) (- 0 1)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64
              (opt-global-simd-copy-reduce-src-instr-seq-from instrs 0 dst)]
            (if (= found (- 0 1))
              (opt-global-simd-copy-reduce-src-blocks rest dst)
              found))])]))

;; A vector and mask alias are defined in the entry and consumed in its
;; dominated body. The second Select uses a distinct computed mask, so the
;; copy sweep must forward the aliases without conflating active masks.
(define (opt-global-simd-copy-dominated-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block
      "entry:
         %3 = mask_not %0 lanes 4
         %4 = mov %1 : i64
         %5 = mov %0 : bool
         jump body")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs
        (ir.ir-instr-vector-bin-op 6 (Add) (Var 4) (Var 2) 4 (I64))
        (ir.ir-instr-select 7 (Var 5) (Var 6) (Var 2) 4 (I64))
        (ir.ir-instr-select 8 (Var 3) (Var 7) (Var 2) 4 (I64))
        (irt.instr "%9 = vector_reduce_sum %8 lanes 4 : i64")
        (irt.instr "return %9")))))

;; Duplicate definitions model a mutable pre-SSA clone destination. The global
;; pass is SSA-gated, so it must return this input unchanged rather than treating
;; the first copy fact as a function-wide vector identity.
(define (opt-global-simd-copy-redefined-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov %1 : i64
       jump clone
     clone:
       %3 = mov %2 : i64
       %4 = vector_reduce_sum %3 lanes 4 : i64
       return %4"))

;; Each arm has its own vector alias. Edge-aware copy forwarding may simplify
;; the Phi inputs, but it must not substitute either arm's value through the
;; join's Phi destination.
(define (opt-global-simd-copy-join-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       %3 = mov %1 : i64
       jump join
     else:
       %4 = mov %2 : i64
       jump join
     join:
       %5 = phi [%3, then], [%4, else] : i64
       %6 = vector_reduce_sum %5 lanes 4 : i64
       return %6"))

(define (opt-global-simd-copy-run
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [func
      (opt-global-value-number-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-function name (opt-gvn-scalar-params) (I64) blocks))]
    (opt.opt-function-blocks func)))

(define (opt-global-simd-copy-dominated-out) : ir.CompilerIrBlockList
  (let
    [forwarded : ir.CompilerIrBlockList
      (opt-global-simd-copy-run
        "global_simd_copy_dominated"
        (opt-global-simd-copy-dominated-blocks))]
    [uses : (__tl_dyn-array i64)
      (opt.opt-collect-blocks-uses-array 16 forwarded)]
    (opt.opt-dce-block-list-array (& uses) (& forwarded))))

(define (compiler-optimize-global-simd-copy-self-test) : i64
  (let
    [dominated : ir.CompilerIrBlockList (opt-global-simd-copy-dominated-out)]
    [redefined : ir.CompilerIrBlockList
      (opt-global-simd-copy-run
        "global_simd_copy_redefined"
        (opt-global-simd-copy-redefined-blocks))]
    [join : ir.CompilerIrBlockList
      (opt-global-simd-copy-run
        "global_simd_copy_join"
        (opt-global-simd-copy-join-blocks))]
    (cond
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view dominated)
              4)
            0))
        1]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view dominated)
              5)
            0))
        2]
      [(not
          (=
            (opt-global-simd-copy-vector-lhs-blocks
              (ir.compiler-ir-block-list-view dominated)
              6)
            1))
        3]
      [(not
          (=
            (opt-global-simd-copy-select-var-blocks
              (ir.compiler-ir-block-list-view dominated)
              7
              true)
            0))
        4]
      [(not
          (=
            (opt-global-simd-copy-select-var-blocks
              (ir.compiler-ir-block-list-view dominated)
              7
              false)
            6))
        5]
      ;; The second Select's distinct active mask must remain distinct.
      [(not
          (=
            (opt-global-simd-copy-select-var-blocks
              (ir.compiler-ir-block-list-view dominated)
              8
              true)
            3))
        6]
      ;; The verifier rejects the duplicate clone destination, so no copy fact
      ;; crosses its redefinition.
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view redefined)
              3)
            2))
        7]
      [(not
          (=
            (opt-global-simd-copy-reduce-src-blocks
              (ir.compiler-ir-block-list-view redefined)
              4)
            3))
        8]
      ;; The join use still reads the Phi result rather than either arm-local
      ;; alias.
      [(not
          (=
            (opt-global-simd-copy-reduce-src-blocks
              (ir.compiler-ir-block-list-view join)
              6)
            5))
        9]
      [else 42])))

(test
  global-simd-copy-dominance
  (test.assert-i64-eq
    (compiler-optimize-global-simd-copy-self-test)
    42
    "global SIMD copies propagate only through dominating stable identities and keep masks and joins distinct"))

(define (compiler-optimize-global-value-number-self-test) : i64
  (let
    [dominated : ir.CompilerIrBlockList
      (let
        [func
          (opt-test-optimize-function
            (ast.ast-node-pool-reader-context-current)
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_dominated"
              (opt-gvn-scalar-params)
              (I64)
              (opt-gvn-dominated-diamond-blocks)))]
        (opt.opt-function-blocks func))]
    [sibling : ir.CompilerIrBlockList
      (let
        [func
          (opt-test-optimize-function
            (ast.ast-node-pool-reader-context-current)
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_sibling"
              (opt-gvn-scalar-params)
              (I64)
              (opt-gvn-sibling-blocks)))]
        (opt.opt-function-blocks func))]
    [loop : ir.CompilerIrBlockList
      (let
        [func
          (opt-test-optimize-function
            (ast.ast-node-pool-reader-context-current)
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_loop"
              (opt-gvn-scalar-params)
              (I64)
              (opt-gvn-phi-loop-blocks)))]
        (opt.opt-function-blocks func))]
    [load-safe : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-barrier-blocks))]
    [load-join-safe : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-join-safe-blocks))]
    [load-store-path : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-store-path-blocks))]
    [single-load-store-forward : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-param-seq-empty)
        (opt-gvn-single-load-store-forward-blocks))]
    [load-call-path : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-call-path-blocks))]
    [checked-ref-store-path : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-checked-ref-cond-params)
        (opt-gvn-checked-ref-store-path-blocks false))]
    [checked-ref-root-loss : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-checked-ref-cond-params)
        (opt-gvn-checked-ref-store-path-blocks true))]
    [load-address-redef : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-address-redef-blocks))]
    [load-type-mismatch : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-type-mismatch-blocks))]
    [copy : ir.CompilerIrBlockList
      (let
        [func
          (opt-test-optimize-function
            (ast.ast-node-pool-reader-context-current)
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_copy"
              (opt-gvn-pointer-params)
              (I64)
              (opt-gvn-copy-blocks)))]
        (opt.opt-function-blocks func))]
    [cast : ir.CompilerIrBlockList
      (let
        [func
          (opt-test-optimize-function
            (ast.ast-node-pool-reader-context-current)
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_cast"
              (opt-gvn-pointer-params)
              (I32)
              (opt-gvn-cast-blocks)))]
        (opt.opt-function-blocks func))]
    [gep : ir.CompilerIrBlockList
      (let
        [func
          (opt-test-optimize-function
            (ast.ast-node-pool-reader-context-current)
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_gep"
              (opt-gvn-pointer-params)
              (U8)
              (opt-gvn-gep-blocks)))]
        (opt.opt-function-blocks func))]
    [global-gep : ir.CompilerIrBlockList
      (let
        [func
          (opt-global-value-number-function
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "gvn_global_gep"
              (opt-gvn-scalar-params)
              (I64)
              (opt-gvn-global-gep-call-blocks)))]
        (opt.opt-function-blocks func))]
    [pack-word : ir.CompilerIrBlockList (opt-global-pack-word-forwarded-blocks)]
    (cond
      [(not
          (=
            (opt-count-arith-blocks (ir.compiler-ir-block-list-view dominated))
            1))
        1]
      ;; The branch-local copies feed only phi edges. Edge-aware forwarding
      ;; rewrites both inputs to the dominating value, then DCE removes them.
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view dominated)
              4
              (- 0 1))
            (- 0 1)))
        2]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view dominated)
              5
              (- 0 1))
            (- 0 1)))
        3]
      [(not
          (=
            (opt-count-arith-blocks (ir.compiler-ir-block-list-view sibling))
            2))
        4]
      [(not
          (= (opt-count-arith-blocks (ir.compiler-ir-block-list-view loop)) 1))
        5]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view loop)
              4
              (- 0 1))
            (- 0 1)))
        6]
      ;; The forwarded read's only use is the return value, which substitution
      ;; mode redirects to the dominating load before deleting the copy.
      [(not
          (=
            (opt-count-load-blocks (ir.compiler-ir-block-list-view load-safe))
            1))
        7]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view load-safe)
              4)
            0))
        8]
      [(not
          (=
            (opt-blocks-return-var
              (ir.compiler-ir-block-list-view load-safe)
              (- 0 1))
            3))
        43]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view load-join-safe))
            1))
        9]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view load-join-safe)
              4)
            0))
        10]
      [(not
          (=
            (opt-blocks-return-var
              (ir.compiler-ir-block-list-view load-join-safe)
              (- 0 1))
            3))
        44]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view load-store-path))
            2))
        11]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view load-store-path)
              4
              (- 0 1))
            (- 0 1)))
        12]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view load-call-path))
            2))
        13]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view load-call-path)
              4
              (- 0 1))
            (- 0 1)))
        14]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view load-address-redef))
            2))
        15]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view load-address-redef)
              4
              (- 0 1))
            (- 0 1)))
        16]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view load-type-mismatch))
            2))
        17]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view copy)
              4
              (- 0 1))
            1))
        18]
      [(not
          (=
            (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view copy) 3)
            0))
        19]
      [(not (= (opt-count-cast-blocks (ir.compiler-ir-block-list-view cast)) 0))
        20]
      [(not
          (=
            (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view cast) 4)
            0))
        21]
      [(not (= (opt-count-gep-blocks (ir.compiler-ir-block-list-view gep)) 1))
        22]
      [(not
          (=
            (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view gep) 4)
            0))
        23]
      [(not (opt-global-expr-hash-collision-guard-ok?)) 24]
      [(not (opt-gvn-hash-collision-guard-ok?)) 25]
      [(not (opt-gvn-scoped-nearest-dominator-ok?)) 26]
      [(not
          (=
            (opt-count-gep-label-blocks
              (ir.compiler-ir-block-list-view global-gep)
              (ir.compiler-ir-label "use"))
            1))
        27]
      [(match (let
          [instr (irt.instr "%9 = gep @pool, 8 : i64")]
          (opt.opt-global-key-for-instr instr))
          [(Some _) true]
          [(No) false])
        28]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view checked-ref-store-path))
            2))
        29]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view checked-ref-store-path)
              4)
            0))
        30]
      [(not
          (=
            (opt-blocks-return-var
              (ir.compiler-ir-block-list-view checked-ref-store-path)
              (- 0 1))
            4))
        45]
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view checked-ref-root-loss))
            2))
        31]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view checked-ref-root-loss)
              4
              (- 0 1))
            (- 0 1)))
        32]
      ;; The forwarded value is a literal, so substitution mode puts the 9 in
      ;; the return operand and drops the copy entirely.
      [(not
          (=
            (opt-count-load-blocks
              (ir.compiler-ir-block-list-view single-load-store-forward))
            0))
        33]
      [(not
          (=
            (opt-count-mov-dst-blocks
              (ir.compiler-ir-block-list-view single-load-store-forward)
              3)
            0))
        34]
      [(not
          (=
            (opt-blocks-return-i64
              (ir.compiler-ir-block-list-view single-load-store-forward)
              (- 0 1))
            9))
        46]
      [(not
          (=
            (opt-blocks-binop-lhs-var
              (ir.compiler-ir-block-list-view pack-word)
              4
              (- 0 1))
            1))
        35]
      [(not
          (=
            (opt-count-words-blocks (ir.compiler-ir-block-list-view pack-word))
            0))
        36]
      [(not
          (=
            (opt-count-packs-blocks (ir.compiler-ir-block-list-view pack-word))
            0))
        37]
      [else (compiler-optimize-global-simd-copy-self-test)])))

;; Regression fixture for the global-GVN stale-global-read miscompile: the
;; entry block computes a Gep off the CURRENT value of mutable global `pool`,
;; one branch calls a function that may replace `pool`, and the join block
;; recomputes the same Gep. Forwarding the entry Gep into the join would read
;; the pre-call array's capacity address.
(define (opt-gvn-global-gep-call-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = gep @pool, 8 : i64
       %4 = load %3 : i64
       branch %0, grow, use
     grow:
       %5 = call grow_pool() : unit
       jump use
     use:
       %6 = gep @pool, 8 : i64
       %7 = load %6 : i64
       return %7"))

(define (opt-sccp-cross-block-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 20 : i64
       jump rhs
     rhs:
       %1 = add %0, 22 : i64
       return %1"))

(define (opt-sccp-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       %1 = mov 7 : i64
       jump join
     else:
       %2 = mov 7 : i64
       jump join
     join:
       %3 = phi [%1, then], [%2, else] : i64
       return %3"))

(define (opt-sccp-constant-branch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov true : bool
       branch %0, then, else
     then:
       return 1
     else:
       return 2"))

(define (opt-sccp-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 0 : i64
       jump loop
     loop:
       %1 = phi [%0, entry], [%2, body] : i64
       branch %4, body, exit
     body:
       %2 = add %1, 1 : i64
       jump loop
     exit:
       return %1"))

(define (opt-sccp-trap-blocks) : ir.CompilerIrBlockList
  (irt.blocks "entry:
       %1 = div 1, 0 : i64
       return %1"))

;; SCCP is the first pass where the lowered constant-index dynamic-array access
;; has both bounds operands available as literals. Pin all three decisions: an
;; in-range literal check disappears, an out-of-range literal check remains a
;; trap, and a data-dependent check is untouched.
(define (opt-sccp-constant-bounds-blocks [index : i64] [length : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 0 (I64 index) (U64))
        (ir.CompilerIrInstr.Mov 1 (I64 length) (U64))
        (irt.instr "bounds_check %0, %1 message \"bounds_ok\"")
        (irt.instr "return %0")))))

(define (opt-sccp-dynamic-bounds-params) : ir.CompilerIrParamSeq
  (irt.params "index=%0:u64, length=%1:u64"))

(define (opt-sccp-dynamic-bounds-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       bounds_check %0, %1 message \"bounds_ok\"
       return %0"))

;; Regression guard: a branch conditioned on an IrInstrWord-extracted enum
;; tag. Pack/Word dsts must be bound Overdefined in the SCCP lattice; left
;; Unknown, the branch would mark NO successor executable and both arms would be
;; folded away as unreachable (a stale-constant miscompile on matches over
;; 16-byte register-resident enums).
(define (opt-sccp-group-word-branch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = pack [1, 5] : i64
       %1 = word %0, 0 : i64
       %2 = eq %1, 0 : bool
       branch %2, then, else
     then:
       %3 = mov 2 : i64
       jump merge
     else:
       %3 = mov 3 : i64
       jump merge
     merge:
       return %3"))

;; A local whose address escapes into a call can be written through that
;; address, so its single `mov` is not its only definition (#7972). sccp must
;; keep the `le %0, 0` read after the call and the `add` on the else arm
;; instead of folding both through the initializer.
(define (opt-sccp-addr-of-call-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 0 : i64
       %1 = addr_of %0
       %2 = call write-through(%1) : i64
       %3 = le %0, 0 : bool
       branch %3, then, else
     then:
       return 2
     else:
       %4 = add %0, 35 : i64
       return %4"))

;; The same escape, but the loop header reads the local before the body takes
;; its address. The first sweep still sees the initializer and marks only the
;; body executable; the body's `addr_of` must then lower the local so the next
;; sweep keeps the header branch and the exit.
(define (opt-sccp-addr-of-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 0 : i64
       jump loop
     loop:
       %1 = eq %0, 0 : bool
       branch %1, body, exit
     body:
       %2 = addr_of %0
       %3 = call write-through(%2) : i64
       jump loop
     exit:
       return %0"))

(define (compiler-optimize-sccp-self-test) : i64
  (let
    [cross : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-cross-block-blocks)))]
    [diamond : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-sccp-cond-params))
        (& (opt-sccp-diamond-blocks)))]
    [branch-source : ir.CompilerIrBlockList (opt-sccp-constant-branch-blocks)]
    [branch : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& branch-source))]
    [branch-context-result : opt.OptBlockCtxResult
      (opt-sccp-blocks-with-context-result
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-cfg-context-build
          (opt.compiler-opt-global-shared-view branch-source))
        (ir.compiler-ir-param-seq-empty)
        branch-source)]
    [branch-context : ir.CompilerIrBlockList
      (match (opt.compiler-opt-global-shared-view branch-context-result)
        [(Result blocks _ _) blocks])]
    [branch-context-valid : bool
      (match branch-context-result
        [(Result _ _ valid) valid])]
    [loop : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-sccp-loop-params))
        (& (opt-sccp-loop-blocks)))]
    [trap : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-trap-blocks)))]
    [group : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-group-word-branch-blocks)))]
    [in-range-bounds : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-constant-bounds-blocks 0 64)))]
    [out-of-range-bounds : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-constant-bounds-blocks 64 64)))]
    [dynamic-bounds : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-sccp-dynamic-bounds-params))
        (& (opt-sccp-dynamic-bounds-blocks)))]
    [addr-of-call : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-addr-of-call-blocks)))]
    [addr-of-loop : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& (opt-sccp-addr-of-loop-blocks)))]
    (cond
      [(not
          (= (opt-count-arith-blocks (ir.compiler-ir-block-list-view cross)) 0))
        1]
      [(not
          (=
            (opt-blocks-mov-dst-i64-value
              (ir.compiler-ir-block-list-view cross)
              1
              (- 0 999))
            42))
        2]
      [(not
          (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view diamond)) 0))
        3]
      [(not
          (=
            (opt-blocks-mov-dst-i64-value
              (ir.compiler-ir-block-list-view diamond)
              3
              (- 0 999))
            7))
        4]
      [(not (= (ir.compiler-ir-block-list-count branch) 2)) 5]
      [(opt-block-list-has-label?
          (ir.compiler-ir-block-list-view branch)
          (ir.compiler-ir-label "else"))
        6]
      [(not
          (=
            (opt-count-branches-blocks (ir.compiler-ir-block-list-view branch))
            0))
        7]
      [(not
          (=
            (opt-count-jump-to-blocks
              (ir.compiler-ir-block-list-view branch)
              (ir.compiler-ir-label "then"))
            1))
        8]
      [(not (= (ir.compiler-ir-block-list-count loop) 4)) 9]
      [(not (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view loop)) 1))
        10]
      [(not
          (=
            (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view loop) 1)
            0))
        11]
      [(not
          (= (opt-count-arith-blocks (ir.compiler-ir-block-list-view loop)) 1))
        12]
      [(not
          (= (opt-count-arith-blocks (ir.compiler-ir-block-list-view trap)) 1))
        13]
      [(not
          (=
            (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view trap) 1)
            0))
        14]
      [(not (= (ir.compiler-ir-block-list-count group) 4)) 15]
      [(not
          (=
            (opt-count-branches-blocks (ir.compiler-ir-block-list-view group))
            1))
        16]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view group)
            (ir.compiler-ir-label "then")))
        17]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view group)
            (ir.compiler-ir-label "else")))
        18]
      [(not (= (ir.compiler-ir-block-list-count branch-context) 2)) 19]
      [(not branch-context-valid) 20]
      [(opt-block-list-has-label?
          (ir.compiler-ir-block-list-view branch-context)
          (ir.compiler-ir-label "else"))
        21]
      [(not
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view in-range-bounds))
            0))
        22]
      [(not
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view out-of-range-bounds))
            1))
        23]
      [(not
          (=
            (opt.opt-count-bounds-blocks
              (ir.compiler-ir-block-list-view dynamic-bounds))
            1))
        24]
      [(not
          (=
            (opt-count-branches-blocks
              (ir.compiler-ir-block-list-view addr-of-call))
            1))
        25]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view addr-of-call)
            (ir.compiler-ir-label "else")))
        26]
      [(not
          (=
            (opt-blocks-mov-dst-i64-value
              (ir.compiler-ir-block-list-view addr-of-call)
              4
              (- 0 999))
            (- 0 999)))
        27]
      [(not
          (=
            (opt-count-branches-blocks
              (ir.compiler-ir-block-list-view addr-of-loop))
            1))
        28]
      [(not
          (opt-block-list-has-label?
            (ir.compiler-ir-block-list-view addr-of-loop)
            (ir.compiler-ir-label "exit")))
        29]
      [else 42])))

;; --- address-taken locals are never forwarded (#7972) -----------------------
;;
;; `%3` copies the `lhs` parameter and then has its address passed to a call,
;; which may store through it. The global copy must not forward `%1` into `%3`'s
;; later reads, nor `%3` into the copy `%4` made before the call; global CSE must
;; not reuse the pre-call `mul %3, 3` for the post-call one; and affine folding
;; must not rewrite `add %3, 1` through `%3 = mov %1`. `%11`/`%12` are the same
;; shapes on the untouched `rhs` parameter, which both passes still forward.
(define (opt-addr-taken-gvn-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov %1 : i64
       %4 = mov %3 : i64
       %5 = mul %3, 3 : i64
       %11 = mov %2 : i64
       %6 = addr_of %3
       %7 = call write-through(%6) : i64
       jump next
     next:
       %8 = mul %3, 3 : i64
       %9 = add %3, %4 : i64
       %12 = add %11, %9 : i64
       %10 = add %8, %12 : i64
       return %10"))

(define (opt-addr-taken-affine-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov %1 : i64
       %10 = mov %2 : i64
       %5 = addr_of %3
       %6 = call write-through(%5) : i64
       %7 = add %3, 1 : i64
       %11 = add %10, 4 : i64
       %9 = add %7, %11 : i64
       return %9"))

;; Block-local fold (#7973): `%3 = mov 5` is a `set!` after the address was
;; taken and `%8` copies `%3` before a second call, so neither the constant 5
;; nor the copy `%8 -> %3` survives the call that may rewrite `%3`. `%11` is the
;; same constant on a local whose address is never taken, which still folds.
(define (opt-addr-taken-fold-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov %1 : i64
       %5 = addr_of %3
       %3 = mov 5 : i64
       %6 = call write-through(%5) : i64
       %7 = add %3, 1 : i64
       %8 = mov %3 : i64
       %9 = call write-through(%5) : i64
       %10 = add %8, %7 : i64
       %11 = mov 4 : i64
       %12 = add %11, 1 : i64
       %13 = add %10, %12 : i64
       return %13"))

(define (compiler-optimize-addr-taken-forwarding-self-test) : i64
  (let
    [global : ir.CompilerIrBlockList
      (let
        [func
          (opt-global-value-number-function
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt-gvn-function
              "addr_taken_gvn"
              (opt-gvn-scalar-params)
              (I64)
              (opt-addr-taken-gvn-blocks)))]
        (opt.opt-function-blocks func))]
    [affine : ir.CompilerIrBlockList
      (opt.opt-affine-fold-blocks 16 (opt-addr-taken-affine-blocks))]
    [fold : ir.CompilerIrBlockList
      (opt.opt-blocks-build
        (opt-addr-taken-fold-blocks)
        opt-test-optimize-block-list!
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases))]
    (cond
      ;; Global CSE kept the post-call multiply ...
      [(not
          (=
            (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view global) 8)
            0))
        1]
      ;; ... and the global copy left every read of %3, and the pre-call copy
      ;; %4, in place.
      [(not
          (=
            (opt-wide-literal-lhs-var (ir.compiler-ir-block-list-view global) 8)
            3))
        2]
      [(not
          (=
            (opt-wide-literal-lhs-var (ir.compiler-ir-block-list-view global) 9)
            3))
        3]
      [(not
          (=
            (opt-wide-literal-rhs-var (ir.compiler-ir-block-list-view global) 9)
            4))
        4]
      ;; Control: the untouched copy %11 of `rhs` is still forwarded.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view global)
              12)
            2))
        5]
      ;; Affine folding left the post-call read of %3 alone ...
      [(not
          (=
            (opt-wide-literal-lhs-var (ir.compiler-ir-block-list-view affine) 7)
            3))
        6]
      ;; ... and still folded the control chain through %10 = mov %2.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view affine)
              11)
            2))
        7]
      ;; Fold kept the post-call read of %3 rather than folding 5 + 1 ...
      [(not
          (=
            (opt-wide-literal-lhs-var (ir.compiler-ir-block-list-view fold) 7)
            3))
        8]
      ;; ... and the pre-call copy %8 rather than forwarding %3 into it.
      [(not
          (=
            (opt-wide-literal-lhs-var (ir.compiler-ir-block-list-view fold) 10)
            8))
        9]
      ;; Control: the constant of the untaken %11 still folds %12 away.
      [(not
          (=
            (opt-wide-literal-lhs-var (ir.compiler-ir-block-list-view fold) 12)
            (- 0 2)))
        10]
      [else 42])))

;; --- sccp honours the wide-literal left-operand refusal ----------------------
;;
;; sccp substitutes Const lattice values into operands directly, so it can undo
;; `opt-global-copy-keep-wide-left` unless it applies the same rule: a wide
;; (non-imm32) literal is not encodable as a left operand, so folding it there
;; only re-materializes the constant at the use. sccp is where this matters
;; most -- it is the FIRST constant lattice a freshly minted bit-test mask Mov
;; meets (opt-bit-test-mask-block runs after the fixpoint's sccp slot in the
;; iteration that forms the mask, so the late whole-function sccp run sees it
;; before any copy sweep does).
;;
;; The fixtures and the operand probes are the copy-propagation ones above:
;; `opt-wide-literal-cross-block-blocks` is exactly the mask shape -- constant
;; defined in the dominating block, shift count a parameter, so the shift can
;; never fold.
;;
;; Control: the shift count is a constant too, so the BinOp itself is constant
;; and `opt-sccp-rewrite-scalar-def` must still replace the whole instruction
;; with a Mov. `opt-wide-literal-lhs-var` reports -2 when no BinOp defines the
;; dst, i.e. when the fold happened.
(define (opt-sccp-wide-literal-const-count-blocks [literal : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "use:
         %4 = shr %3, %5 : i64
         return %4")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (I64 literal) (I64))
        (ir.CompilerIrInstr.Mov 5 (I64 7) (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "use"))))))

(define (opt-sccp-wide-literal-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt.opt-sccp-blocks
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-gvn-scalar-params))
    (& blocks)))

(define (compiler-optimize-sccp-wide-literal-operand-self-test) : i64
  (let
    [wide-left : ir.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-wide-literal-cross-block-blocks (opt-wide-literal-mask)))]
    [imm32-left : ir.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-wide-literal-cross-block-blocks 1234567))]
    [wide-right : ir.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-wide-literal-cross-block-rhs-blocks (opt-wide-literal-mask)))]
    [const-count : ir.CompilerIrBlockList
      (opt-sccp-wide-literal-blocks
        (opt-sccp-wide-literal-const-count-blocks (opt-wide-literal-mask)))]
    (cond
      ;; The mask stays a Var operand and its defining Mov survives, which is
      ;; what keeps the materialization hoistable out of the loop.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view wide-left)
              4)
            3))
        1]
      [(not
          (=
            (opt-count-mov-i64-value-blocks
              (ir.compiler-ir-block-list-view wide-left)
              (opt-wide-literal-mask))
            1))
        2]
      ;; An imm32 literal is encodable in that position, so it still folds.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view imm32-left)
              4)
            (- 0 1)))
        3]
      [(not
          (=
            (opt-count-mov-i64-value-blocks
              (ir.compiler-ir-block-list-view imm32-left)
              1234567)
            1))
        4]
      ;; Right operands keep folding at any width.
      [(not
          (=
            (opt-wide-literal-rhs-var
              (ir.compiler-ir-block-list-view wide-right)
              4)
            (- 0 1)))
        5]
      ;; A fully-constant BinOp still collapses to a Mov of the result.
      [(not
          (=
            (opt-wide-literal-lhs-var
              (ir.compiler-ir-block-list-view const-count)
              4)
            (- 0 2)))
        6]
      [else 42])))

(test
  optimize-sccp-wide-literal-left-operand
  (test.assert-i64-eq
    (compiler-optimize-sccp-wide-literal-operand-self-test)
    42
    "sccp refuses to fold a wide literal into a BinOp's left operand and keeps its Mov alive, while imm32 left operands, right operands and fully-constant expressions still fold"))

(define (opt-cfg-constant-if-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch true, then, else
     then:
       return 1
     else:
       return 2"))

(define (opt-cfg-loop-guard-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       branch false, body, exit
     body:
       jump loop
     exit:
       return 0"))

(define (opt-cfg-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch true, then, else
     then:
       %1 = mov 10 : i64
       jump join
     else:
       %2 = mov 20 : i64
       jump join
     join:
       %3 = phi [%1, then], [%2, else] : i64
       return %3"))

;; Both entry and header remain reachable after folding entry's true branch,
;; but entry no longer has a direct edge to tail. The stale entry phi arm must
;; be removed based on tail's actual predecessors.
(define (opt-cfg-folded-edge-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch true, header, tail
     header:
       jump tail
     tail:
       %1 = phi [10, entry], [20, header] : i64
       return %1"))

;; `%1 = phi [5, entry], [carried, latch]`: with `carried` the phi itself the
;; loop only ever passes 5 round, so the phi is 5. With any other value the
;; inputs disagree and it stays a phi.
(define (opt-uniform-phi-loop-blocks [carried : ir.CompilerIrValue]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "latch:
           jump header
         exit:
           return %1")
    (irt.block "entry:
         jump header")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "header")
      (opt-test-instrs
        (ir.CompilerIrInstr.Phi
          1
          (ir.compiler-ir-phi-input-seq-prepend
            (I64 5)
            (ir.compiler-ir-label "entry")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                carried
                (ir.compiler-ir-label "latch")
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          (I64))
        (irt.instr "branch %0, latch, exit")))))

;; Two stacked diamonds over one opaque call result: `%2` is uniform in `%1`
;; and `%3` is uniform in `%2`. Neither is a constant, so sccp cannot reach
;; either; the chain has to collapse on the uniform rule alone, and both links
;; must go in the same sweep.
(define (opt-uniform-phi-chain-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = call opaque() : i64
       branch %0, then, else
     then:
       jump join
     else:
       jump join
     join:
       %2 = phi [%1, then], [%1, else] : i64
       branch %0, then2, else2
     then2:
       jump join2
     else2:
       jump join2
     join2:
       %3 = phi [%2, then2], [%2, else2] : i64
       return %3"))

;; A join whose first phi folds and whose second does not. The `Mov` may not
;; land inside the phi prefix: the backend's edge-copy emitter walks a block
;; from instruction 0 and stops at the first non-phi, so a phi left below the
;; mov would silently lose every incoming copy.
(define (opt-uniform-phi-mixed-join-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       jump join
     else:
       jump join
     join:
       %1 = phi [7, then], [7, else] : i64
       %2 = phi [1, then], [2, else] : i64
       %3 = add %1, %2 : i64
       return %3"))

(define (opt-uniform-phi-block-of
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]) : ir.CompilerIrBlock
  (match (opt.opt-cfg-find-block blocks label)
    [(Some block) block]
    [(No) (Block label (ir.compiler-ir-instr-seq-empty))]))

(define (opt-uniform-phi-instr-phi-dst?
  [instr : ir.CompilerIrInstr]
  [dst : i64]) : bool
  (match instr
    [(Phi phi-dst _ _) (= phi-dst dst)]
    [_ false]))

(define (opt-uniform-phi-instr-mov-dst?
  [instr : ir.CompilerIrInstr]
  [dst : i64]
  [want : ir.CompilerIrValue]) : bool
  (match instr
    [(Mov mov-dst value _)
      (and (= mov-dst dst) (opt.opt-value-eq (& want) (& value)))]
    [_ false]))

(define (opt-uniform-phi-chain-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "uniform-phi-chain")
    (opt-sccp-cond-params)
    (I64)
    16
    (opt-uniform-phi-chain-blocks)
    Ordinary))

(define (opt-uniform-phi-folded-instr-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [want : ir.CompilerIrValue]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (if (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov mov-dst value _)
        (and (= mov-dst dst) (opt.opt-value-eq (& want) (& value)))]
      [_ false])
      true
      (opt-uniform-phi-folded-instr-seq? instrs (+ index 1) dst want))))

(define (opt-uniform-phi-folded?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]
  [want : ir.CompilerIrValue]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (if (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-uniform-phi-folded-instr-seq?
            instrs
            0
            dst
            (ir.compiler-ir-global-shared-view want))])
        true
        (opt-uniform-phi-folded? rest dst want))]))

(define (opt-cfg-trap-path-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, ok, trap
     ok:
       return 0
     trap:
       %9 = call panic() : unit
       return 1"))

(define (opt-cfg-fallthrough-prune-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (ir.compiler-ir-instr-seq-empty))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "reachable-empty")
      (ir.compiler-ir-instr-seq-empty))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 1)))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "dead-empty")
      (ir.compiler-ir-instr-seq-empty))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "dead-exit")
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 2)))))))

(define (opt-cfg-fallthrough-prune-ok? [blocks : ir.CompilerIrBlockList]) : bool
  (and
    (= (ir.compiler-ir-block-list-count blocks) 3)
    (opt-block-list-has-label?
      (ir.compiler-ir-block-list-view blocks)
      (ir.compiler-ir-label "entry"))
    (opt-block-list-has-label?
      (ir.compiler-ir-block-list-view blocks)
      (ir.compiler-ir-label "reachable-empty"))
    (opt-block-list-has-label?
      (ir.compiler-ir-block-list-view blocks)
      (ir.compiler-ir-label "exit"))
    (not
      (opt-block-list-has-label?
        (ir.compiler-ir-block-list-view blocks)
        (ir.compiler-ir-label "dead-empty")))
    (not
      (opt-block-list-has-label?
        (ir.compiler-ir-block-list-view blocks)
        (ir.compiler-ir-label "dead-exit")))
    (opt.opt-cfg-successor-targets-known? blocks)
    (opt.opt-verify-ok?
      (& (opt.opt-verify-function (& (opt-cfg-test-function blocks)))))))

(define (opt-bool-branch-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "bool-branch")
    (opt-sccp-cond-params)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-bool-branch-two-cond-params) : ir.CompilerIrParamSeq
  (irt.params "left=%0:bool, right=%1:bool"))

(define (opt-bool-branch-constant-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, true-left, choose
     choose:
       branch %1, false-middle, true-right
     true-left:
       jump merge
     false-middle:
       jump merge
     true-right:
       jump merge
     merge:
       %4 = phi [true, true-left], [false, false-middle], [true, true-right] : bool
       branch %4, yes, no
     yes:
       %5 = phi [11, merge] : i64
       return %5
     no:
       %6 = phi [22, merge] : i64
       return %6"))

(define (opt-bool-branch-nonconstant-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, left, right
     left:
       jump merge
     right:
       jump merge
     merge:
       %4 = phi [%0, left], [%1, right] : bool
       branch %4, yes, no
     yes:
       return 1
     no:
       return 0"))

(define (opt-bool-branch-multi-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, left, right
     left:
       jump merge
     right:
       jump merge
     merge:
       %3 = phi [11, left], [22, right] : i64
       %4 = phi [true, left], [false, right] : bool
       branch %4, yes, no
     yes:
       return %3
     no:
       return %3"))

;; A bool merge whose consuming branch sits past the merge block: `merge` holds
;; the phi and falls through to `gap`, `gap` falls through to `branch-site`, and
;; only `branch-site` tests the phi. That is what the front end emits whenever a
;; boolean merge and the `if` reading it land on separate joins, and the fuser
;; has to look through the run to see the same rewrite. Modes:
;;   0 -- `gap` is a pure fallthrough owned by the merge: fusible.
;;   1 -- `gap` carries a real instruction, so the run cannot simply die.
;;   2 -- `side` also reaches `gap`, so the run is not the merge's to retarget.
(define (opt-bool-branch-merge-chain-gap-instrs [mode : i64]) : ir.CompilerIrInstrSeq
  (let
    [tail : ir.CompilerIrInstrSeq (irt.instrs "jump branch-site")]
    (if (= mode 1)
      (irt.instrs "%7 = mov 7 : i64
         jump branch-site")
      tail)))

(define (opt-bool-branch-merge-chain-tail [mode : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (if (= mode 2)
      (irt.blocks "side:
                         jump gap")
      (ir.compiler-ir-block-list-empty))
    (irt.block "true-left:
         jump merge")
    (irt.block "false-middle:
           jump merge")
    (irt.block "true-right:
             jump merge")
    (irt.block
      "merge:
               %4 = phi [true, true-left], [false, false-middle], [true, true-right] : bool
               jump gap")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "gap")
      (opt-bool-branch-merge-chain-gap-instrs mode))
    (irt.block "branch-site:
                   branch %4, yes, no")
    (irt.block
      "yes:
                     %5 = phi [11, branch-site] : i64
                     return %5")
    (irt.block
      "no:
                       %6 = phi [22, branch-site] : i64
                       return %6")))

(define (opt-bool-branch-merge-chain-blocks [mode : i64]) : ir.CompilerIrBlockList
  (if (= mode 2)
    (ir.compiler-ir-blocks-with-tail
      (opt-bool-branch-merge-chain-tail mode)
      (irt.block "entry:
           branch %0, spread, choose")
      (irt.block "spread:
             branch %1, true-left, side")
      (irt.block "choose:
               branch %1, false-middle, true-right"))
    (ir.compiler-ir-blocks-with-tail
      (opt-bool-branch-merge-chain-tail mode)
      (irt.block "entry:
           branch %0, true-left, choose")
      (irt.block "choose:
             branch %1, false-middle, true-right"))))

(define (opt-bool-branch-constant-test-function
  [blocks : (& blocks ir.CompilerIrBlockList)]) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList
      (owned_view.compiler-owned-reference-shared-view blocks)]
    (Function
      (opt-test-symbol "bool-branch-constant")
      (opt-bool-branch-two-cond-params)
      (I64)
      16
      blocks
      Ordinary)))

;; The chain shape of `opt-bool-branch-merge-chain-blocks 0` reached through a
;; block whose branch sccp folds. `entry` tests a var sccp proves `true`, so the
;; edge `entry -> join` dies and `join`'s phi keeps an input for a label that is
;; no longer one of its predecessors. Every pass that verify-gates its input --
;; the bool-branch fuser included -- then declines the WHOLE function, and the
;; fusible chain further down survives untouched. The pipeline's sccp entry
;; point has to hand on blocks that verify for this fixture to fuse.
(define (opt-sccp-folded-edge-chain-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (opt-sccp-folded-edge-chain-tail)
    (irt.block
      "entry:
         %10 = mov true : bool
         branch %10, pick, join")
    (irt.block "pick:
           branch %0, true-left, choose")
    (irt.block "choose:
             branch %1, false-middle, true-right")))

(define (opt-sccp-folded-edge-chain-tail) : ir.CompilerIrBlockList
  (irt.blocks
    "true-left:
       jump merge
     false-middle:
       jump merge
     true-right:
       jump merge
     merge:
       %4 = phi [true, true-left], [false, false-middle], [true, true-right] : bool
       jump gap
     gap:
       jump branch-site
     branch-site:
       branch %4, yes, no
     yes:
       %5 = phi [11, branch-site] : i64
       jump join
     no:
       %6 = phi [22, branch-site] : i64
       jump join
     join:
       %7 = phi [0, entry], [%5, yes], [%6, no] : i64
       return %7"))

(define (opt-bool-branch-first-phi-has-label?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-label : i64]
  [pred-label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks block-label)
    [(No) false]
    [(Some block)
      (match block
        [(Block _ instrs)
          (and
            (> (ir.compiler-ir-instr-seq-count instrs) 0)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(Phi _ inputs _)
                (opt.opt-bool-branch-phi-input-has-label? inputs pred-label)]
              [_ false]))])]))

(define (opt-bool-branch-chain-test-params) : ir.CompilerIrParamSeq
  (irt.params "a=%0:i64, b=%1:i64, c=%2:i64"))

;; mode 0: a three-comparison And tree; mode 1: its first And result also
;; escapes to a Mov and must block the rewrite; mode 2: an Or-mixed tree, which
;; is outside the first-cut transform.
(define (opt-bool-branch-chain-test-blocks [mode : i64]) : ir.CompilerIrBlockList
  (let
    [first-op : ir.CompilerIrBinOp
      (if (= mode 2)
        (Or)
        (And))]
    [after-first : ir.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (if (= mode 1)
          (irt.instrs "%8 = mov %6 : bool")
          (ir.compiler-ir-instr-seq-empty))
        (ir.CompilerIrInstr.BinOp 6 first-op (Var 3) (Var 4) (Bool)))]
    [entry-tail : ir.CompilerIrInstrSeq
      (opt.opt-licm-unswitch-instrs-onto
        (& after-first)
        (& (irt.instrs "%7 = and %6, %5 : bool
           branch %7, yes, no")))]
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "yes:
           %9 = phi [11, entry] : i64
           return %9
         no:
           %10 = phi [22, entry] : i64
           return %10")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs-with-tail
          entry-tail
          (irt.instr "%3 = lt %0, %1 : i64")
          (irt.instr "%4 = ge %2, 0 : i64")
          (irt.instr "%5 = le %1, %2 : i64"))))))

(define (opt-bool-branch-chain-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "bool-branch-chain")
    (opt-bool-branch-chain-test-params)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-bool-branch-chain-test-run [mode : i64]) : opt.OptFunctionPassResult
  (let
    [blocks : ir.CompilerIrBlockList (opt-bool-branch-chain-test-blocks mode)]
    [func : ir.CompilerIrFunction
      (opt-bool-branch-chain-test-function
        (ir.compiler-ir-global-shared-view blocks))]
    (match (opt.opt-bool-branch-chain-function-with-context-result
      (ast.ast-node-pool-reader-type-segment-bases)
      (& (opt.opt-cfg-context-build blocks))
      false
      (& func))
      [(Result next _ changed?) (Result next changed?)])))

(define (opt-bool-branch-chain-compare-branch-block?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(No) false]
    [(Some block)
      (match block
        [(Block _ instrs)
          (and
            (= (ir.compiler-ir-instr-seq-count instrs) 2)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(BinOp dst op _ _ _)
                (and
                  (opt.opt-bool-branch-compare-op? (& op))
                  (match (ir.compiler-ir-instr-seq-ref instrs 1)
                    [(Branch (Var cond) _ _) (= dst cond)]
                    [_ false]))]
              [_ false]))])]))

;; --- constant-branch jump threading fixtures --------------------------------
;;
;; The shape below is the lowered `(or c1 c2)` loop guard, copied from the opt2
;; IR dump of route_http's byte-scan loop: an inner diamond materializes a
;; boolean into a phi, a forwarding block carries it to the outer merge, and the
;; outer merge retests it. Both merge phis are pure control flow, so every
;; incoming edge already decides the branch.
;;
;; The fixtures drive the whole opt2 function pipeline
;; (`opt-test-optimize-function`) rather than the pass entry point.
(define (opt-thread-three-cond-params) : ir.CompilerIrParamSeq
  (irt.params "outer=%0:bool, left=%1:bool, right=%2:bool"))

;; `blocked` inserts an effectful call between the merge phi and its branch, so
;; the merge no longer consists of phis and the branch alone.
(define (opt-thread-chain-blocks [blocked : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "tc-yes:
                     return 1
                   tc-no:
                     return 0")
    (irt.block "entry:
         branch %0, tc-then, tc-else")
    (irt.block "tc-then:
           jump tc-merge")
    (irt.block "tc-else:
             branch %1, tc-inner-then, tc-inner-else")
    (irt.block "tc-inner-then:
               jump tc-inner-merge")
    (irt.block "tc-inner-else:
                 jump tc-inner-merge")
    (irt.block
      "tc-inner-merge:
                   %3 = phi [true, tc-inner-then], [false, tc-inner-else] : bool
                   jump tc-merge")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "tc-merge")
      (opt-test-instrs-with-tail
        (if blocked
          (irt.instrs
            "%5 = call thread-probe() : i64
                         branch %4, tc-yes, tc-no")
          (irt.instrs "branch %4, tc-yes, tc-no"))
        (irt.instr "%4 = phi [true, tc-then], [%3, tc-inner-merge] : bool")))))

;; Same chain, but both decided targets are reached from a second path as well,
;; so `ts-yes` carries a real multi-input phi over the threaded merge edge.
(define (opt-thread-successor-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, ts-alt, ts-guard
     ts-alt:
       jump ts-yes
     ts-guard:
       branch %1, ts-then, ts-else
     ts-then:
       jump ts-merge
     ts-else:
       branch %2, ts-inner-then, ts-inner-else
     ts-inner-then:
       jump ts-inner-merge
     ts-inner-else:
       jump ts-inner-merge
     ts-inner-merge:
       %4 = phi [true, ts-inner-then], [false, ts-inner-else] : bool
       jump ts-merge
     ts-merge:
       %5 = phi [true, ts-then], [%4, ts-inner-merge] : bool
       branch %5, ts-yes, ts-no
     ts-yes:
       %6 = phi [10, ts-merge], [20, ts-alt] : i64
       return %6
     ts-no:
       return 30"))

(define (opt-thread-test-function
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol name)
    (opt-thread-three-cond-params)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-thread-optimized [name : String] [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt-test-optimize-function
    (ast.ast-node-pool-reader-context-current)
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-thread-test-function name blocks)))

;; --- widened jump-threading fixtures ----------------------------------------
;;
;; These drive `opt-thread-const-branch-blocks` directly rather than the whole
;; opt2 pipeline, so what they assert is the pass's own rewrite: which edges it
;; redirects, which value each redirected predecessor takes over, and which
;; shapes it still refuses.
(define (opt-thread-pass-result [blocks : ir.CompilerIrBlockList] [fuel : i64]) : opt.OptBlockListPassResult
  (opt.opt-thread-const-branch-blocks
    (ast.ast-node-pool-reader-type-segment-bases)
    (& blocks)
    16
    fuel))

(define (opt-thread-pass-blocks
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [fuel : i64]) : ir.CompilerIrBlockList
  (match (opt-thread-pass-result
    (owned_view.compiler-owned-reference-shared-view blocks)
    fuel)
    [(Result next _) next]))

(define (opt-thread-pass-changed?
  [blocks : ir.CompilerIrBlockList]
  [fuel : i64]) : bool
  (match (opt-thread-pass-result blocks fuel)
    [(Result _ changed) changed]))

(define (opt-thread-pass-verified? [blocks : ir.CompilerIrBlockList]) : bool
  (opt.opt-verify-ok?
    (&
      (opt.opt-verify-function
        (& (opt-thread-test-function "thread-pass" blocks))))))

(define (opt-thread-first-phi-input
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-label : i64]
  [pred-label : i64]) : ir.CompilerIrMaybeValue
  (match (opt.opt-cfg-find-block blocks block-label)
    [(No) (No)]
    [(Some block)
      (match block
        [(Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 0)
            (No)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(Phi _ inputs _)
                (opt.opt-thread-phi-input-value inputs pred-label)]
              [_ (No)]))])]))

(define (opt-thread-first-phi-input-i64?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-label : i64]
  [pred-label : i64]
  [want : i64]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(No) false]
    [(Some value)
      (match value
        [(I64 got) (= got want)]
        [_ false])]))

(define (opt-thread-first-phi-input-bool?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-label : i64]
  [pred-label : i64]
  [want : bool]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(No) false]
    [(Some value)
      (match value
        [(Bool got)
          (if want
            got
            (not got))]
        [_ false])]))

(define (opt-thread-first-phi-has-input?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [block-label : i64]
  [pred-label : i64]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(No) false]
    [(Some _) true]))

;; D1 -- three phis ahead of the branch. Only `%6` decides it; `%4` and `%5`
;; are read solely across the merge's own out-edges, so each redirected
;; predecessor takes over the value its own input carried and the merge's phis
;; lose that input. `tp-alt` keeps both destinations multi-entry so the repaired
;; phis survive the round's cleanup.
(define (opt-thread-multi-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, tp-alt, tp-guard
     tp-alt:
       branch %2, tp-yes, tp-no
     tp-guard:
       branch %1, tp-a, tp-b
     tp-a:
       jump tp-merge
     tp-b:
       jump tp-merge
     tp-merge:
       %4 = phi [10, tp-a], [20, tp-b] : i64
       %5 = phi [11, tp-a], [21, tp-b] : i64
       %6 = phi [true, tp-a], [false, tp-b] : bool
       branch %6, tp-yes, tp-no
     tp-yes:
       %7 = phi [%4, tp-merge], [30, tp-alt] : i64
       return %7
     tp-no:
       %8 = phi [%5, tp-merge], [31, tp-alt] : i64
       return %8"))

;; D1 rail -- `%4` is read by an ordinary instruction in a successor, not by a
;; phi on the merge edge. Threading a predecessor past the merge would reach
;; that read without passing the definition, so the whole block is refused.
(define (opt-thread-live-out-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, tv-alt, tv-guard
     tv-alt:
       jump tv-no
     tv-guard:
       branch %1, tv-a, tv-b
     tv-a:
       jump tv-merge
     tv-b:
       jump tv-merge
     tv-merge:
       %4 = phi [10, tv-a], [20, tv-b] : i64
       %5 = phi [true, tv-a], [false, tv-b] : bool
       branch %5, tv-yes, tv-no
     tv-yes:
       %6 = add %4, 1 : i64
       return %6
     tv-no:
       return 40"))

;; D1 -- only `tx-a` decides the branch. `tx-b` carries a parameter, so its
;; edge stays exactly where it is and the merge survives holding it.
(define (opt-thread-mixed-edge-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, tx-alt, tx-guard
     tx-alt:
       branch %2, tx-yes, tx-no
     tx-guard:
       branch %1, tx-a, tx-b
     tx-a:
       jump tx-merge
     tx-b:
       jump tx-merge
     tx-merge:
       %4 = phi [10, tx-a], [20, tx-b] : i64
       %5 = phi [true, tx-a], [%2, tx-b] : bool
       branch %5, tx-yes, tx-no
     tx-yes:
       %6 = phi [%4, tx-merge], [30, tx-alt] : i64
       return %6
     tx-no:
       return 40"))

;; The D2 fixtures need an `i64` parameter for the edge that must not fold, so
;; they carry their own signature.
(define (opt-thread-cmp-params) : ir.CompilerIrParamSeq
  (irt.params "outer=%0:bool, left=%1:bool, right=%2:bool, n=%3:i64"))

(define (opt-thread-cmp-test-function
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol name)
    (opt-thread-cmp-params)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-thread-cmp-verified? [blocks : ir.CompilerIrBlockList]) : bool
  (opt.opt-verify-ok?
    (&
      (opt.opt-verify-function
        (& (opt-thread-cmp-test-function "thread-cmp" blocks))))))

;; D2 -- the branch reads a comparison over the block's own `i64` phi. `tq-a`
;; carries `5` and `tq-b` carries `-1`, so both decide the comparison and both
;; are redirected, `tq-a` to `tq-yes` carrying the `5` the successor phi asked
;; for and `tq-b` to `tq-no`. `tq-c` and `tq-d` carry a parameter and never
;; decide, so the merge survives holding exactly those two.
(define (opt-thread-compare-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, tq-alt, tq-guard
     tq-alt:
       branch %1, tq-yes, tq-no
     tq-guard:
       branch %1, tq-g1, tq-g2
     tq-g1:
       branch %2, tq-a, tq-b
     tq-g2:
       branch %2, tq-c, tq-d
     tq-a:
       jump tq-merge
     tq-b:
       jump tq-merge
     tq-c:
       jump tq-merge
     tq-d:
       jump tq-merge
     tq-merge:
       %5 = phi [5, tq-a], [-1, tq-b], [%3, tq-c], [%3, tq-d] : i64
       %6 = ge %5, 0 : i64
       branch %6, tq-yes, tq-no
     tq-yes:
       %7 = phi [%5, tq-merge], [30, tq-alt] : i64
       return %7
     tq-no:
       %8 = phi [41, tq-merge], [31, tq-alt] : i64
       return %8"))

;; JT-1 -- the same shape with an equality comparison, `eq %5, 5`. `tq-a`
;; carries `5` and decides it true, `tq-b` carries `-1` and decides it false,
;; so both are redirected exactly as under `ge`; `tq-c` and `tq-d` carry a
;; parameter and never decide, so the merge survives holding those two.
(define (opt-thread-compare-eq-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, tq-alt, tq-guard
     tq-alt:
       branch %1, tq-yes, tq-no
     tq-guard:
       branch %1, tq-g1, tq-g2
     tq-g1:
       branch %2, tq-a, tq-b
     tq-g2:
       branch %2, tq-c, tq-d
     tq-a:
       jump tq-merge
     tq-b:
       jump tq-merge
     tq-c:
       jump tq-merge
     tq-d:
       jump tq-merge
     tq-merge:
       %5 = phi [5, tq-a], [-1, tq-b], [%3, tq-c], [%3, tq-d] : i64
       %6 = eq %5, 5 : i64
       branch %6, tq-yes, tq-no
     tq-yes:
       %7 = phi [%5, tq-merge], [30, tq-alt] : i64
       return %7
     tq-no:
       %8 = phi [41, tq-merge], [31, tq-alt] : i64
       return %8"))

;; D3 -- `%4` decides the merge's branch AND is read again by `td-yes`'s phi on
;; the merge edge. The single-use gate refused that; the live-out rule admits it,
;; because the extra reader is exactly one of the merge's own out-edges and the
;; repair re-expresses it at the threaded origin.
(define (opt-thread-multi-use-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, td-alt, td-guard
     td-alt:
       branch %1, td-yes, td-no
     td-guard:
       branch %1, td-a, td-b
     td-a:
       jump td-merge
     td-b:
       jump td-merge
     td-merge:
       %4 = phi [true, td-a], [false, td-b] : bool
       branch %4, td-yes, td-no
     td-yes:
       %5 = phi [%4, td-merge], [false, td-alt] : bool
       branch %5, td-y1, td-y2
     td-y1:
       return 1
     td-y2:
       return 2
     td-no:
       return 40"))

;; D3 -- six decided predecessors on one merge. A round redirects at most
;; `opt-thread-pred-budget` of them, so one round leaves two behind and the
;; fixpoint picks those up on the next: the cap bounds the phi-web growth per
;; round without costing the rewrite.
(define (opt-thread-wide-merge-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, tk-g1, tk-g2
     tk-g1:
       branch %1, tk-p0, tk-p1
     tk-g2:
       branch %1, tk-g3, tk-g4
     tk-g3:
       branch %2, tk-p2, tk-p3
     tk-g4:
       branch %2, tk-p4, tk-p5
     tk-p0:
       jump tk-merge
     tk-p1:
       jump tk-merge
     tk-p2:
       jump tk-merge
     tk-p3:
       jump tk-merge
     tk-p4:
       jump tk-merge
     tk-p5:
       jump tk-merge
     tk-merge:
       %4 = phi [true, tk-p0], [false, tk-p1], [true, tk-p2], [false, tk-p3], [true, tk-p4], [false, tk-p5] : bool
       branch %4, tk-yes, tk-no
     tk-yes:
       return 1
     tk-no:
       return 0"))

;; D3 at scale: PREDS decided predecessors on one merge, reached through a chain
;; of dispatch branches. At `opt-thread-pred-budget` redirects a round it takes
;; PREDS / 4 rounds, each of which rebuilds the list.
(define (opt-thread-many-round-merge-blocks [preds : i64]) : ir.CompilerIrBlockList
  (let
    [text : String "entry:\n branch %0, tm-p0, tm-g1\n"]
    [phi : String "tm-merge:\n %4 = phi [true, tm-p0]"]
    [index : i64 1]
    (while (< index preds)
      (set!
        text
        (if (< index (- preds 1))
          (str_cat.str-cat
            text
            "tm-g"
            (string.int->string index)
            ":\n branch %0, tm-p"
            (string.int->string index)
            ", tm-g"
            (string.int->string (+ index 1))
            "\n")
          (str_cat.str-cat
            text
            "tm-g"
            (string.int->string index)
            ":\n jump tm-p"
            (string.int->string index)
            "\n")))
      (set!
        phi
        (str_cat.str-cat
          phi
          (if (= (bit-and index 1) 0)
            ", [true, tm-p"
            ", [false, tm-p")
          (string.int->string index)
          "]"))
      (set! index (+ index 1)))
    (set! index 0)
    (while (< index preds)
      (set!
        text
        (str_cat.str-cat
          text
          "tm-p"
          (string.int->string index)
          ":\n jump tm-merge\n"))
      (set! index (+ index 1)))
    (irt.blocks
      (str_cat.str-cat
        text
        phi
        " : bool\n branch %4, tm-yes, tm-no\ntm-yes:\n return 1\ntm-no:\n return 0"))))

;; Bytes the pass bumps in its caller's arena, rounds' regions excluded.
(cfg
  test
  (define (opt-thread-pass-caller-bytes [preds : i64] [fuel : i64]) : i64
    (let
      [home : i64 (arena.tl_arena_current)]
      [scratch : arena.Arena (arena.make)]
      [_enter : unit
        (unsafe
          (arena.tl_arena_set scratch.handle))]
      [blocks : ir.CompilerIrBlockList
        (opt-thread-many-round-merge-blocks preds)]
      [start : i64
        (allocation_profile.compiler-allocation-profile-arena-bump-bytes
          scratch.handle)]
      [_result : opt.OptBlockListPassResult
        (opt-thread-pass-result blocks fuel)]
      [bytes : i64
        (-
          (allocation_profile.compiler-allocation-profile-arena-bump-bytes
            scratch.handle)
          start)]
      (unsafe
        (arena.tl_arena_set home))
      (arena.destroy-safe! scratch)
      bytes)))

;; Rounds after the first leave only one copy of the final list in the caller's
;; arena, so 24 rounds cost it about what one round does instead of 24 times as
;; much; the output is still the fully threaded, verified list.
(test
  opt-thread-later-rounds-keep-two-generations
  (let
    [one-round : i64 (opt-thread-pass-caller-bytes 96 1)]
    [all-rounds : i64 (opt-thread-pass-caller-bytes 96 64)]
    [blocks : ir.CompilerIrBlockList (opt-thread-many-round-merge-blocks 96)]
    [partial : ir.CompilerIrBlockList (opt-thread-pass-blocks blocks 23)]
    [threaded : ir.CompilerIrBlockList (opt-thread-pass-blocks blocks 64)]
    (test.assert-true
      (opt-block-list-has-label?
        (ir.compiler-ir-block-list-view partial)
        (ir.compiler-ir-label "tm-merge"))
      "23 rounds leave decided predecessors on the merge")
    (test.assert-false
      (opt-block-list-has-label?
        (ir.compiler-ir-block-list-view threaded)
        (ir.compiler-ir-label "tm-merge"))
      "24 rounds thread every predecessor past the merge")
    (test.assert-true
      (opt-thread-pass-verified? threaded)
      "the threaded list verifies")
    (test.assert-true
      (> one-round 0)
      "the first round runs in the caller's arena")
    (test.assert-true
      (< all-rounds (* one-round 3))
      "later rounds do not grow the caller's arena with the round count")))

;; --- forwarding-block straightening ----------------------------------------
;; Both arms are trampolines and neither destination carries a phi, so both
;; edges thread. The `true` arm goes through two of them, which is the chain
;; case: the destination's phis are repaired against the LAST forwarding block,
;; not the first. No trampoline here is followed by its own target, so none of
;; them is an already-elided `jmp`.
(define (opt-cfg-straighten-plain-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, sf-then, sf-else
     sf-then:
       jump sf-mid
     sf-else:
       jump sf-no
     sf-yes:
       return 1
     sf-mid:
       jump sf-yes
     sf-no:
       return 0"))

;; The arith_loop shape: a jump-only block sitting immediately before its own
;; target. The backend already elides that `jmp`, and both `opt-loop-preheaders`
;; and the M-F loop-constant hoist need the block to stay, so the pass must
;; decline and report no change.
(define (opt-cfg-straighten-fallthrough-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, sk-pre, sk-out
     sk-pre:
       jump sk-body
     sk-body:
       return 1
     sk-out:
       return 0"))

;; Only the `true` arm is a trampoline; the `false` arm does real work, so it
;; stays a predecessor. The join's phi therefore has to survive with the
;; threaded origin substituted for the removed block.
(define (opt-cfg-straighten-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, sp-then, sp-else
     sp-then:
       jump sp-join
     sp-else:
       %1 = mov 7 : i64
       jump sp-join
     sp-join:
       %2 = phi [1, sp-then], [%1, sp-else] : i64
       return %2"))

;; The `it-slice-eq?` trap, minimised: both arms are trampolines onto the same
;; join and the join's phi gives them different values. Threading both would
;; need two `entry` inputs in one phi, so the second arm must be refused.
(define (opt-cfg-straighten-duplicate-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, sd-then, sd-else
     sd-then:
       jump sd-join
     sd-else:
       jump sd-join
     sd-spacer:
       return 2
     sd-join:
       %1 = phi [1, sd-then], [0, sd-else] : i64
       return %1"))

;; Switch coverage: the default edge and one case edge thread to different
;; destinations, while a second case aimed at the destination the first case
;; already claimed is refused. The default is decided first, so `accepted` has
;; to carry across both the default and the case walk.
(define (opt-cfg-straighten-switch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       switch %0 base 1 [1:ss-a, 2:ss-b] default ss-d
     ss-a:
       jump ss-x
     ss-b:
       jump ss-x
     ss-d:
       jump ss-y
     ss-x:
       return 1
     ss-y:
       return 2"))

;; No block is a bare `jump`, so the candidate scan must decline before the
;; clone, the CFG index and the use census are ever built.
(define (opt-cfg-straighten-inert-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, si-yes, si-no
     si-yes:
       return 1
     si-no:
       return 0"))

;; The pass verifies its own result and hands back the input when the verify
;; rejects, so these blocks have to be verifiable to begin with: the branch
;; condition is a declared parameter rather than a free var.
(define (opt-cfg-straighten-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "straighten")
    (opt-sccp-cond-params)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-cfg-straighten-run [blocks : ir.CompilerIrBlockList]) : opt.OptFunctionPassResult
  (opt.opt-cfg-straighten-final-pass
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-cfg-straighten-test-function blocks))))

;; A switch index is an integer, so this variant declares an i64 parameter
;; where the branch cases declare a bool one.
(define (opt-cfg-straighten-tag-params) : ir.CompilerIrParamSeq
  (irt.params "tag=%0:i64"))

(define (opt-cfg-straighten-run-switch [blocks : ir.CompilerIrBlockList]) : opt.OptFunctionPassResult
  (opt.opt-cfg-straighten-final-pass
    (ast.ast-node-pool-reader-type-segment-bases)
    (&
      (Function
        (opt-test-symbol "straighten-switch")
        (opt-cfg-straighten-tag-params)
        (I64)
        16
        blocks
        Ordinary))))

(define (opt-cfg-switch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       switch %0 base 1 [1:one, 2:two] default other
     one:
       return 1
     two:
       return 2
     other:
       return 0"))

;: `opt-cfg-index-build` numbers blocks in block-list walk order, so for a walk
;: over the list the index was built from, the position *is* the id. Several
;: optimizer passes rely on that instead of hashing the label to recover it
;: (refs #5718), and nothing else pins it: every other test here obtains an id
;: through `opt-cfg-index-id` and then uses it consistently, so renumbering the
;: index -- by reverse postorder, say, to make the dominator tables denser --
;: would leave those green while silently pointing the walk-position readers at
;: a different block. This asserts the numbering itself.
(define (opt-cfg-index-walk-order-ids-ok?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [index : opt.OptCfgIndex]
  [position : i64]) : bool
  (match blocks
    [(slice) true]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block label _)
          (and
            (match (opt.opt-cfg-index-id index label)
              [(Some id) (= id position)]
              [(None) false])
            (opt-cfg-index-walk-order-ids-ok? rest index (+ position 1)))])]))

(define (opt-cfg-index-numbering-ok?) : bool
  (let
    [blocks : ir.CompilerIrBlockList (opt-cfg-switch-blocks)]
    (opt-cfg-index-walk-order-ids-ok?
      (ir.compiler-ir-block-list-view blocks)
      (opt.opt-cfg-index-build (& blocks))
      0)))

(define (opt-cfg-switch-successors-ok?) : bool
  (let
    [successors : opt.OptLabelSet
      (let
        [index (opt.opt-cfg-index-build (& (opt-cfg-switch-blocks)))]
        (opt.opt-cfg-index-successors index (ir.compiler-ir-label "entry")))]
    (and
      (= (opt.opt-label-count successors) 3)
      (opt.opt-label-contains successors (ir.compiler-ir-label "one"))
      (opt.opt-label-contains successors (ir.compiler-ir-label "two"))
      (opt.opt-label-contains successors (ir.compiler-ir-label "other")))))

(define (opt-ssa-cond-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool"))

(define (opt-ssa-loop-params) : ir.CompilerIrParamSeq
  (irt.params "seed=%0:i64, cond=%4:bool"))

(define (opt-ssa-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       %1 = mov 10 : i64
       jump join
     else:
       %2 = mov 20 : i64
       jump join
     join:
       %3 = phi [%1, then], [%2, else] : i64
       return %3"))

(define (opt-ssa-diamond-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_diamond")
    (opt-ssa-cond-params)
    (I64)
    16
    (opt-ssa-diamond-blocks)
    Ordinary))

(define (opt-ssa-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %1 = phi [%0, entry], [%2, body] : i64
       branch %4, body, exit
     body:
       %2 = add %1, 1 : i64
       jump loop
     exit:
       return %1"))

(define (opt-ssa-loop-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_loop")
    (opt-ssa-loop-params)
    (I64)
    16
    (opt-ssa-loop-blocks)
    Ordinary))

(define (opt-ssa-construct-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, then, else
     then:
       %1 = mov 10 : i64
       jump join
     else:
       %1 = mov 20 : i64
       jump join
     join:
       return %1"))

(define (opt-ssa-construct-diamond-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_construct_diamond")
    (opt-ssa-cond-params)
    (I64)
    2
    (opt-ssa-construct-diamond-blocks)
    Ordinary))

(define (opt-ssa-construct-loop-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%4:bool"))

(define (opt-ssa-construct-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 0 : i64
       jump loop
     loop:
       branch %4, body, exit
     body:
       %1 = add %1, 1 : i64
       jump loop
     exit:
       return %1"))

(define (opt-ssa-construct-loop-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_construct_loop")
    (opt-ssa-construct-loop-params)
    (I64)
    5
    (opt-ssa-construct-loop-blocks)
    Ordinary))

(define (opt-ssa-construct-mutated-param-params) : ir.CompilerIrParamSeq
  (irt.params "value=%0:i64, cond=%1:bool"))

(define (opt-ssa-construct-mutated-param-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %1, then, else
     then:
       %0 = mov 10 : i64
       jump join
     else:
       jump join
     join:
       return %0"))

(define (opt-ssa-construct-mutated-param-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_construct_mutated_param")
    (opt-ssa-construct-mutated-param-params)
    (I64)
    2
    (opt-ssa-construct-mutated-param-blocks)
    Ordinary))

(define (opt-ssa-construct-address-taken-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 1 : i64
       %2 = addr_of %1
       %1 = mov 2 : i64
       return %1"))

(define (opt-ssa-construct-address-taken-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_construct_address_taken")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    3
    (opt-ssa-construct-address-taken-blocks)
    Ordinary))

(define (opt-ssa-fixed-handle-params [ty : ast.AstType]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "cond" (Bool) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "left" (ast.ast-global-shared-view ty) 1)
      (ir.compiler-ir-param-seq-prepend
        (Param "right" ty 2)
        (ir.compiler-ir-param-seq-empty)))))

(define (opt-ssa-fixed-handle-diamond-blocks [ty : ast.AstType]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "join:
             return %3")
    (irt.block "entry:
         branch %0, then, else")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "then")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (Var 1) (ast.ast-global-shared-view ty))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "join"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "else")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (Var 2) ty)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "join"))))))

(define (opt-ssa-fixed-handle-diamond-function [ty : (& ty ast.AstType)]) : ir.CompilerIrFunction
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    (Function
      (opt-test-symbol "ssa_fixed_handle_diamond")
      (opt-ssa-fixed-handle-params (ast.ast-global-shared-view ty))
      (ast.ast-global-shared-view ty)
      4
      (opt-ssa-fixed-handle-diamond-blocks ty)
      Ordinary)))

(define (opt-ssa-fixed-handle-diamond-ok? [ty : ast.AstType]) : bool
  (let
    [out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-ssa-fixed-handle-diamond-function ty)))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (and
      (opt.opt-verify-ok? (& (opt.opt-verify-function (& out))))
      (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
      (= (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view blocks) 3) 0)
      (opt-phi-types-match-blocks?
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-block-list-view blocks)
        ty))))

(define (opt-ssa-fixed-handle-loop-params [ty : ast.AstType]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "seed" (ast.ast-global-shared-view ty) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "next" ty 1)
      (irt.params "cond=%2:bool"))))

(define (opt-ssa-fixed-handle-loop-blocks [ty : ast.AstType]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
             return %3")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (Var 0) (ast.ast-global-shared-view ty))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
    (irt.block "loop:
           branch %2, body, exit")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 3 (Var 1) ty)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))))

(define (opt-ssa-fixed-handle-loop-function [ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_fixed_handle_loop")
    (opt-ssa-fixed-handle-loop-params (ast.ast-global-shared-view ty))
    (ast.ast-global-shared-view ty)
    4
    (opt-ssa-fixed-handle-loop-blocks ty)
    Ordinary))

(define (opt-ssa-fixed-handle-loop-ok? [ty : ast.AstType]) : bool
  (let
    [out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (opt-ssa-fixed-handle-loop-function (ast.ast-global-shared-view ty))))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (and
      (opt.opt-verify-ok? (& (opt.opt-verify-function (& out))))
      (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
      (= (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view blocks) 3) 0)
      (opt-phi-types-match-blocks?
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-block-list-view blocks)
        ty))))

(define (opt-ssa-fixed-handle-address-taken-function [ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_fixed_handle_address_taken")
    (ir.compiler-ir-param-seq-prepend
      (Param "value" (ast.ast-global-shared-view ty) 0)
      (ir.compiler-ir-param-seq-empty))
    (ast.ast-global-shared-view ty)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 1 (Var 0) (ast.ast-global-shared-view ty))
          (ir.CompilerIrInstr.AddrOf 2 1)
          (ir.CompilerIrInstr.Mov 1 (Var 0) ty)
          (irt.instr "return %1"))))
    Ordinary))

(define (opt-ssa-fixed-handle-unsupported-dst-function [ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_fixed_handle_unsupported_dst")
    (ir.compiler-ir-param-seq-prepend
      (Param "value" (ast.ast-global-shared-view ty) 0)
      (ir.compiler-ir-param-seq-empty))
    (ast.ast-global-shared-view ty)
    2
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Alloc 1 (ast.ast-global-shared-view ty))
          (ir.CompilerIrInstr.Mov 1 (Var 0) ty)
          (irt.instr "return %1"))))
    Ordinary))

(define (opt-ssa-fixed-handle-boundary-ok?) : bool
  (and
    (let
      [ty (ast.AstType.String)]
      (opt.opt-ssa-register-value-type? ty))
    (let
      [ty (ast.AstType.Str)]
      (opt.opt-ssa-register-value-type? ty))
    (let
      [ty (ast.ast-ty-func (ast.ast-type-list-new) (& (I64)))]
      (opt.opt-ssa-register-value-type? ty))
    (let
      [ty (ast.ast-ty-array (& (I64)) 2)]
      (opt.opt-ssa-register-value-type? ty))
    (let
      [ty (ast.ast-ty-dyn-array (& (I64)))]
      (opt.opt-ssa-register-value-type? ty))
    (let
      [ty (ast.ast-ty-box (& (I64)))]
      (opt.opt-ssa-register-value-type? ty))
    (not
      (let
        [ty (ast.AstType.Bytes)]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.Unit)]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.Never)]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.Expr)]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.ExprList)]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.ast-ty-tuple (ast.ast-type-list-new))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.ast-ty-region 0 (& (I64)))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.ast-ty-slice (& (I64)))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.Enum (opt-test-symbol "SsaBoundaryEnum"))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty
          (ast.ast-ty-enum-args
            (opt-test-symbol "SsaBoundaryEnumArgs")
            (ast.ast-lifetime-list-new))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.Struct (opt-test-symbol "SsaBoundaryStruct"))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty
          (ast.ast-ty-struct-args
            (opt-test-symbol "SsaBoundaryStructArgs")
            (ast.ast-lifetime-list-new))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty (ast.AstType.Var (opt-test-symbol "SsaBoundaryVar"))]
        (opt.opt-ssa-register-value-type? ty)))
    (not
      (let
        [ty
          (ast.ast-ty-var-args
            (opt-test-symbol "SsaBoundaryVarArgs")
            (ast.ast-lifetime-list-new))]
        (opt.opt-ssa-register-value-type? ty)))))

(define (opt-ssa-representation-index-for-functions
  [functions : ir.CompilerIrFunctionSeq]) : ir.CompilerIrRepresentationIndex
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    (ir.compiler-ir-representation-index-build
      bases
      (&
        (Program
          (ir.compiler-ir-global-seq-empty)
          functions
          (ir.compiler-ir-extern-seq-empty))))))

(define (opt-ssa-representation-index-for-function
  [func : (& func ir.CompilerIrFunction)]) : ir.CompilerIrRepresentationIndex
  (let
    [func : ir.CompilerIrFunction
      (owned_view.compiler-owned-reference-shared-view func)]
    (opt-ssa-representation-index-for-functions
      (ir.compiler-ir-function-seq-prepend
        (& func)
        (& (ir.compiler-ir-function-seq-empty))))))

(define (opt-ssa-representation-group-evidence-function [ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_representation_group_evidence")
    (ir.compiler-ir-param-seq-empty)
    (Unit)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Pack
            0
            (ir.compiler-ir-value-seq-prepend
              (& (I64 1))
              (&
                (ir.compiler-ir-value-seq-prepend
                  (& (I64 2))
                  (& (ir.compiler-ir-value-seq-empty)))))
            ty)
          (ir.CompilerIrInstr.Return (No)))))
    Ordinary))

(define (opt-ssa-representation-aware-diamond-ok?
  [ty : ast.AstType]
  [representations : ir.CompilerIrRepresentationIndex]) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function-with-representations
        bases
        (& representations)
        (& (opt-ssa-fixed-handle-diamond-function ty)))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (and
      (opt.opt-verify-ok? (& (opt.opt-verify-function (& out))))
      (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
      (= (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view blocks) 3) 0)
      (opt-phi-types-match-blocks?
        bases
        (ir.compiler-ir-block-list-view blocks)
        ty))))

(define (opt-ssa-representation-aware-loop-ok?
  [ty : ast.AstType]
  [representations : ir.CompilerIrRepresentationIndex]) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function-with-representations
        bases
        (& representations)
        (&
          (opt-ssa-fixed-handle-loop-function
            (ir.compiler-ir-global-shared-view ty))))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks out)]
    (and
      (opt.opt-verify-ok? (& (opt.opt-verify-function (& out))))
      (= (opt-count-phi-blocks (ir.compiler-ir-block-list-view blocks)) 1)
      (= (opt-count-mov-dst-blocks (ir.compiler-ir-block-list-view blocks) 3) 0)
      (opt-phi-types-match-blocks?
        bases
        (ir.compiler-ir-block-list-view blocks)
        ty))))

(define (opt-ssa-representation-aware-rejected?
  [func : ir.CompilerIrFunction]
  [representations : ir.CompilerIrRepresentationIndex]) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [b
      (opt.opt-ssa-construct-function-with-representations
        bases
        (& representations)
        (& func))]
    (opt.opt-function-eq bases func b)))

;; --- register-group word split (group_split) ----------------------------------
;;
;; Fixtures for compiler_optimize's `group_split`. Each is a whole function whose
;; register-group evidence is its own `pack`s, as in the pipeline. An accepted
;; function verifies after the split and SSA construction, and does not after
;; SSA construction alone; a refused one is left exactly as it was.
(define (opt-gsplit-ssa [func : ir.CompilerIrFunction] [split? : bool]) : ir.CompilerIrFunction
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [representations : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function (& func))]
    [input : ir.CompilerIrFunction
      (if split?
        (opt.opt-group-split-function bases (& representations) func)
        func)]
    (opt.opt-ssa-construct-function-with-representations
      bases
      (& representations)
      (& input))))

(define (opt-gsplit-accepted? [text : String]) : bool
  (and
    (opt.opt-verify-ok?
      (&
        (opt.opt-verify-function
          (& (opt-gsplit-ssa (irt.func (string.copy (& text))) true)))))
    (not
      (opt.opt-verify-ok?
        (& (opt.opt-verify-function (& (opt-gsplit-ssa (irt.func text) false))))))))

(define (opt-gsplit-refused? [text : String]) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [func : ir.CompilerIrFunction (irt.func text)]
    [representations : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function (& func))]
    [split : ir.CompilerIrFunction
      (opt.opt-group-split-function
        bases
        (& representations)
        (opt.compiler-opt-global-shared-view func))]
    (opt.opt-function-eq bases func split)))

;; How many `word` instructions the split writes, of float type or not.
(define (opt-gsplit-word-count [text : String] [float? : bool]) : i64
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [func : ir.CompilerIrFunction (irt.func text)]
    [representations : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function (& func))]
    [split : ir.CompilerIrFunction
      (opt.opt-group-split-function bases (& representations) func)]
    [flat : opt.OptSplitFlat
      (opt.opt-aggregate-split-flatten (& (opt.opt-function-blocks split)))]
    [index : i64 0]
    [count : i64 0]
    (while (< index flat.count)
      (match (opt.opt-aggregate-split-at (& flat) index)
        [(Word _ _ _ ty)
          (if (=
            (match ty
              [(F64) true]
              [_ false])
            float?)
            (set! count (+ count 1))
            unit)]
        [_ unit])
      (set! index (+ index 1)))
    count))

;; A two-word enum reassigned in a loop: the `Maybe` shape.
(define (opt-gsplit-loop-text) : String
  "function @gsplit_loop(n=%0:i64) -> MaybeId vars 7 {
   entry:
     %1 = pack [0, 0] : MaybeId
     %2 = mov %1 : MaybeId
     %3 = mov 0 : i64
     jump header
   header:
     %4 = lt %3, %0 : i64
     branch %4, body, exit
   body:
     %5 = pack [1, %3] : MaybeId
     %2 = mov %5 : MaybeId
     %6 = add %3, 1 : i64
     %3 = mov %6 : i64
     jump header
   exit:
     return %2
   }")

(define (opt-gsplit-three-word-text) : String
  "function @gsplit_three(n=%0:i64) -> Tri vars 7 {
   entry:
     %1 = pack [0, 0, 0] : Tri
     %2 = mov %1 : Tri
     %3 = mov 0 : i64
     jump header
   header:
     %4 = lt %3, %0 : i64
     branch %4, body, exit
   body:
     %5 = pack [%3, 1, %3] : Tri
     %2 = mov %5 : Tri
     %6 = add %3, 1 : i64
     %3 = mov %6 : i64
     jump header
   exit:
     return %2
   }")

;; Word 1 is a float, so its split words are f64 and word 0's stay i64.
(define (opt-gsplit-mixed-text) : String
  "function @gsplit_mixed(n=%0:i64, x=%1:f64) -> Mix vars 8 {
   entry:
     %2 = pack [0, %1] : Mix
     %3 = mov %2 : Mix
     %4 = mov 0 : i64
     jump header
   header:
     %5 = lt %4, %0 : i64
     branch %5, body, exit
   body:
     %6 = pack [%4, %1] : Mix
     %3 = mov %6 : Mix
     %7 = add %4, 1 : i64
     %4 = mov %7 : i64
     jump header
   exit:
     return %3
   }")

;; A group parameter the loop reassigns, as tail recursion leaves it: its words
;; start the entry block, which has no predecessors.
(define (opt-gsplit-param-text) : String
  "function @gsplit_param(g=%0:MaybeId, n=%1:i64) -> MaybeId vars 5 {
   entry:
     jump header
   header:
     %2 = lt %1, 10 : i64
     branch %2, body, exit
   body:
     %3 = pack [1, %1] : MaybeId
     %0 = mov %3 : MaybeId
     %4 = add %1, 1 : i64
     %1 = mov %4 : i64
     jump header
   exit:
     return %0
   }")

;; Nested loops, a join, the group as a call argument, and the group as the
;; input of a pre-existing phi on both edges.
(define (opt-gsplit-uses-text) : String
  "function @gsplit_uses(n=%0:i64) -> MaybeId vars 15 {
   entry:
     %1 = pack [0, 0] : MaybeId
     %2 = mov %1 : MaybeId
     %3 = mov 0 : i64
     jump outer
   outer:
     %4 = lt %3, %0 : i64
     branch %4, inner_init, done
   inner_init:
     %5 = mov 0 : i64
     jump inner
   inner:
     %6 = lt %5, %3 : i64
     branch %6, inner_body, outer_next
   inner_body:
     %7 = eq %5, 2 : i64
     branch %7, hit, miss
   hit:
     %8 = pack [1, %5] : MaybeId
     %2 = mov %8 : MaybeId
     jump inner_join
   miss:
     %9 = call gsplit_use(%2) : i64
     jump inner_join
   inner_join:
     %10 = add %5, 1 : i64
     %5 = mov %10 : i64
     jump inner
   outer_next:
     %11 = add %3, 1 : i64
     %3 = mov %11 : i64
     jump outer
   done:
     %12 = eq %3, 0 : i64
     branch %12, left, right
   left:
     jump join
   right:
     jump join
   join:
     %13 = phi [%2, left], [%2, right] : MaybeId
     return %13
   }")

(define (opt-gsplit-address-text) : String
  "function @gsplit_address(n=%0:i64) -> MaybeId vars 7 {
   entry:
     %1 = pack [0, 0] : MaybeId
     %2 = mov %1 : MaybeId
     %6 = addr_of %2
     branch %0, then, exit
   then:
     %5 = pack [1, %0] : MaybeId
     %2 = mov %5 : MaybeId
     jump exit
   exit:
     return %2
   }")

;; No `pack` gives `Opaque` any word evidence, so its representation is unknown.
(define (opt-gsplit-unknown-text) : String
  "function @gsplit_unknown(n=%0:i64) -> Opaque vars 3 {
   entry:
     %1 = call gsplit_make() : Opaque
     branch %0, then, exit
   then:
     %1 = call gsplit_make() : Opaque
     jump exit
   exit:
     return %1
   }")

(define (opt-gsplit-over-limit-text) : String
  "function @gsplit_big(n=%0:i64) -> Big vars 4 {
   entry:
     %1 = pack [0, 0, 0, 0, 0, 0, 0, 0, 0] : Big
     %2 = mov %1 : Big
     branch %0, then, exit
   then:
     %3 = pack [1, 1, 1, 1, 1, 1, 1, 1, 1] : Big
     %2 = mov %3 : Big
     jump exit
   exit:
     return %2
   }")

;; An indirect call is not a definition the split rewrites.
(define (opt-gsplit-foreign-def-text) : String
  "function @gsplit_foreign(n=%0:i64) -> MaybeId vars 4 {
   entry:
     %1 = pack [0, 0] : MaybeId
     %2 = mov %1 : MaybeId
     branch %0, then, exit
   then:
     %2 = call* fn@gsplit_callee() : MaybeId
     jump exit
   exit:
     return %2
   }")

;; A join of packs read only through `word`: the result of an inlined
;; multi-exit callee that the caller matches on (#8555).
(define (opt-gsplit-join-text) : String
  "function @gsplit_join(n=%0:i64) -> i64 vars 8 {
   entry:
     %1 = lt %0, 10 : i64
     branch %1, left, right
   left:
     %2 = pack [0, 0] : MaybeId
     jump join
   right:
     %3 = pack [1, %0] : MaybeId
     jump join
   join:
     %4 = phi [%2, left], [%3, right] : MaybeId
     %5 = word %4, 0 : i64
     %6 = word %4, 1 : i64
     %7 = add %5, %6 : i64
     return %7
   }")

;; The same join also returned whole: a use other than `word` keeps the group.
(define (opt-gsplit-join-escape-text) : String
  "function @gsplit_join_escape(n=%0:i64) -> MaybeId vars 6 {
   entry:
     %1 = lt %0, 10 : i64
     branch %1, left, right
   left:
     %2 = pack [0, 0] : MaybeId
     jump join
   right:
     %3 = pack [1, %0] : MaybeId
     jump join
   join:
     %4 = phi [%2, left], [%3, right] : MaybeId
     %5 = word %4, 0 : i64
     return %4
   }")

;; The split, then SSA-constructed, join: no group phi and no `word` is left,
;; the function verifies, and each of the two words reaches the join as an
;; `i64` phi of its own, which copy propagation turns into `phi [0, 1]` for the
;; tag.
(define (opt-gsplit-join-split-ok?) : bool
  (let
    [out : ir.CompilerIrFunction
      (opt-gsplit-ssa (irt.func (opt-gsplit-join-text)) true)]
    [flat : opt.OptSplitFlat
      (opt.opt-aggregate-split-flatten (& (opt.opt-function-blocks out)))]
    [index : i64 0]
    [group-phis : i64 0]
    [words : i64 0]
    [word-phis : i64 0]
    (while (< index flat.count)
      (match (opt.opt-aggregate-split-at (& flat) index)
        [(Phi _ _ ty)
          (match ty
            [(I64) (set! word-phis (+ word-phis 1))]
            [_ (set! group-phis (+ group-phis 1))])]
        [(Word _ _ _ _) (set! words (+ words 1))]
        [_ unit])
      (set! index (+ index 1)))
    (and
      (opt.opt-verify-ok? (& (opt.opt-verify-function (& out))))
      (= group-phis 0)
      (= words 0)
      (= word-phis 2))))

(define (compiler-optimize-group-split-self-test) : i64
  (cond
    [(not (opt-gsplit-join-split-ok?)) 13]
    [(not (opt-gsplit-refused? (opt-gsplit-join-escape-text))) 14]
    [(not (opt-gsplit-accepted? (opt-gsplit-loop-text))) 1]
    [(not (opt-gsplit-accepted? (opt-gsplit-three-word-text))) 2]
    [(not (= (opt-gsplit-word-count (opt-gsplit-three-word-text) false) 6)) 3]
    [(not (opt-gsplit-accepted? (opt-gsplit-mixed-text))) 4]
    [(not (= (opt-gsplit-word-count (opt-gsplit-mixed-text) true) 2)) 5]
    [(not (= (opt-gsplit-word-count (opt-gsplit-mixed-text) false) 2)) 6]
    [(not (opt-gsplit-accepted? (opt-gsplit-param-text))) 7]
    [(not (opt-gsplit-accepted? (opt-gsplit-uses-text))) 8]
    [(not (opt-gsplit-refused? (opt-gsplit-address-text))) 9]
    [(not (opt-gsplit-refused? (opt-gsplit-unknown-text))) 10]
    [(not (opt-gsplit-refused? (opt-gsplit-over-limit-text))) 11]
    [(not (opt-gsplit-refused? (opt-gsplit-foreign-def-text))) 12]
    [else 42]))

(define (opt-ssa-over-budget-function) : ir.CompilerIrFunction
  (let
    [count : i64 (+ (opt.opt-ssa-block-budget) 1)]
    [slots : (__tl_dyn-array ir.CompilerIrBlock)
      (__tl_make-array ir.CompilerIrBlock count)]
    [index : i64 0]
    (while (< index count)
      (set!
        (array-ref slots index)
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label
            (& (str_cat.str-cat "ssa_budget_" (string.int->string index))))
          (ir.compiler-ir-instr-seq2
            (Mov 0 (I64 index) (I64))
            (irt.instr "return %0"))))
      (set! index (+ index 1)))
    (Function
      (opt-test-symbol "ssa_over_budget")
      (ir.compiler-ir-param-seq-empty)
      (I64)
      1
      (Array (ir.CompilerIrBlockSeq slots count))
      Ordinary)))

(define (compiler-optimize-ssa-fixed-handle-self-test) : i64
  (let
    [func-ty : ast.AstType (ast.ast-ty-func (ast.ast-type-list-new) (& (I64)))]
    [array-ty : ast.AstType (ast.ast-ty-array (& (I64)) 2)]
    [dyn-array-ty : ast.AstType (ast.ast-ty-dyn-array (& (I64)))]
    [box-ty : ast.AstType (ast.ast-ty-box (& (I64)))]
    [nominal-ty : ast.AstType
      (Enum (opt-test-symbol "SsaRepresentationOneWord"))]
    [group-ty : ast.AstType (Struct (opt-test-symbol "SsaRepresentationGroup"))]
    [nominal-diamond : ir.CompilerIrFunction
      (opt-ssa-fixed-handle-diamond-function nominal-ty)]
    [known-one : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function nominal-diamond)]
    [group-diamond : ir.CompilerIrFunction
      (opt-ssa-fixed-handle-diamond-function group-ty)]
    [group-index : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-functions
        (ir.compiler-ir-function-seq-prepend
          (& group-diamond)
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (opt-ssa-representation-group-evidence-function
                  (ast.ast-global-shared-view group-ty)))
              (& (ir.compiler-ir-function-seq-empty))))))]
    [missing-index : ir.CompilerIrRepresentationIndex
      (ir.compiler-ir-representation-index-empty)]
    [nominal-address-taken : ir.CompilerIrFunction
      (opt-ssa-fixed-handle-address-taken-function
        (ast.ast-global-shared-view nominal-ty))]
    [nominal-address-index : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function nominal-address-taken)]
    [nominal-unsupported : ir.CompilerIrFunction
      (opt-ssa-fixed-handle-unsupported-dst-function
        (ast.ast-global-shared-view nominal-ty))]
    [nominal-unsupported-index : ir.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function nominal-unsupported)]
    [over-budget : ir.CompilerIrFunction (opt-ssa-over-budget-function)]
    [over-budget-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (& over-budget))]
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [address-taken : ir.CompilerIrFunction
      (opt-ssa-fixed-handle-address-taken-function
        (ast.ast-global-shared-view box-ty))]
    [address-taken-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (& address-taken))]
    [unsupported-dst : ir.CompilerIrFunction
      (opt-ssa-fixed-handle-unsupported-dst-function
        (ast.ast-global-shared-view dyn-array-ty))]
    [unsupported-dst-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (& unsupported-dst))]
    (cond
      [(not (opt-ssa-fixed-handle-boundary-ok?)) 1]
      [(not (opt-ssa-fixed-handle-diamond-ok? (String))) 2]
      [(not (opt-ssa-fixed-handle-diamond-ok? (Str))) 3]
      [(not
          (opt-ssa-fixed-handle-diamond-ok?
            (ast.ast-global-shared-view func-ty)))
        4]
      [(not (opt-ssa-fixed-handle-diamond-ok? array-ty)) 5]
      [(not (opt-ssa-fixed-handle-diamond-ok? dyn-array-ty)) 6]
      [(not (opt-ssa-fixed-handle-diamond-ok? box-ty)) 7]
      [(not (opt-ssa-fixed-handle-loop-ok? (String))) 8]
      [(not (opt-ssa-fixed-handle-loop-ok? func-ty)) 9]
      [(not
          (opt.opt-function-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            address-taken
            address-taken-out))
        10]
      [(not
          (opt.opt-function-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            unsupported-dst
            unsupported-dst-out))
        11]
      [(not
          (opt.opt-ssa-register-value-type-with-representations?
            bases
            (& known-one)
            (& nominal-ty)))
        12]
      [(opt.opt-ssa-register-value-type-with-representations?
          bases
          (& group-index)
          (& group-ty))
        13]
      [(opt.opt-ssa-register-value-type-with-representations?
          bases
          (& missing-index)
          (& nominal-ty))
        14]
      [(opt.opt-ssa-register-value-type-with-representations?
          bases
          (& known-one)
          (& (Var (opt-test-symbol "SsaRepresentationVar"))))
        15]
      [(opt.opt-ssa-register-value-type-with-representations?
          bases
          (& known-one)
          (&
            (ast.ast-ty-var-args
              (opt-test-symbol "SsaRepresentationVarArgs")
              (ast.ast-lifetime-list-new))))
        16]
      [(not
          (opt-ssa-representation-aware-diamond-ok?
            (ast.ast-global-shared-view nominal-ty)
            (opt.compiler-opt-global-shared-view known-one)))
        17]
      [(not (opt-ssa-representation-aware-loop-ok? nominal-ty known-one)) 18]
      [(not (opt-ssa-representation-aware-rejected? group-diamond group-index))
        19]
      [(not
          (opt-ssa-representation-aware-rejected? nominal-diamond missing-index))
        20]
      [(not
          (opt-ssa-representation-aware-rejected?
            nominal-address-taken
            nominal-address-index))
        21]
      [(not
          (opt-ssa-representation-aware-rejected?
            nominal-unsupported
            nominal-unsupported-index))
        22]
      [(not (opt.opt-function-eq bases over-budget over-budget-out)) 23]
      [else 42])))

;; The raw tail-recursion-to-loop shape targets the function ENTRY block and its
;; latch reassigns a parameter. SSA construction must decline that raw form (a
;; phi cannot see the implicit function-entry edge). Tailrec production first
;; adds an explicit entry preheader; the paired fixture below must then construct
;; a valid typed loop phi.
(define (opt-ssa-entry-backedge-params) : ir.CompilerIrParamSeq
  (irt.params "index=%0:i64, count=%1:i64"))

(define (opt-ssa-entry-backedge-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = lt %0, %1 : bool
       branch %2, body, exit
     body:
       %3 = add %0, 1 : i64
       %0 = mov %3 : i64
       jump entry
     exit:
       return %0"))

(define (opt-ssa-entry-backedge-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_entry_backedge")
    (opt-ssa-entry-backedge-params)
    (I64)
    4
    (opt-ssa-entry-backedge-blocks)
    Ordinary))

(define (opt-ssa-entry-backedge-preheader-function) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "ssa_entry_backedge_preheader")
    (opt-ssa-entry-backedge-params)
    (I64)
    4
    (opt.opt-ssa-explicit-entry-blocks (opt-ssa-entry-backedge-blocks))
    Ordinary))

(define (opt-natural-loop-nested-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump outer
     outer:
       jump inner
     inner:
       branch %4, inner-body, outer-latch
     inner-body:
       jump inner
     outer-latch:
       branch %8, outer, exit
     exit:
       return 0"))

(define (opt-natural-loop-irreducible-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch true, left, right
     left:
       jump right
     right:
       branch true, left, exit
     exit:
       return 0"))

(define (opt-natural-loop-no-preheader-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch true, pre-one, pre-two
     pre-one:
       jump loop
     pre-two:
       jump loop
     loop:
       branch true, body, exit
     body:
       jump loop
     exit:
       return 0"))

(define (opt-natural-loop-multi-backedge-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       branch true, left, right
     left:
       jump loop
     right:
       jump loop"))

(define (opt-natural-loop-maybe-body-count
  [maybe : (& maybe opt.OptMaybeNaturalLoop)]) : i64
  (match maybe
    [(No) 0]
    [(Some loop) (opt.opt-label-count (opt.opt-natural-loop-body loop))]))

(define (opt-natural-loop-maybe-body-block-count
  [maybe : (& maybe opt.OptMaybeNaturalLoop)]) : i64
  (match maybe
    [(No) 0]
    [(Some loop)
      (let
        [blocks (opt.opt-natural-loop-body-blocks loop)]
        (ir.compiler-ir-block-list-count blocks))]))

(define (opt-natural-loop-maybe-body-contains?
  [maybe : (& maybe opt.OptMaybeNaturalLoop)]
  [label : i64]) : bool
  (match maybe
    [(No) false]
    [(Some loop)
      (opt.opt-label-contains (opt.opt-natural-loop-body loop) label)]))

(define (opt-natural-loop-maybe-body-contains-id?
  [index : (& index opt.OptCfgIndex)]
  [maybe : (& maybe opt.OptMaybeNaturalLoop)]
  [label : i64]) : bool
  (match maybe
    [(No) false]
    [(Some loop)
      (match (opt.opt-cfg-index-id index label)
        [(Some id) (opt.opt-natural-loop-body-contains-id? loop id)]
        [(None) false])]))

(define (opt-natural-loop-maybe-body-block-label-at?
  [maybe : (& maybe opt.OptMaybeNaturalLoop)]
  [index : i64]
  [label : i64]) : bool
  (match maybe
    [(No) false]
    [(Some loop)
      (let
        [walked-blocks : ir.CompilerIrBlockList
          (opt.opt-natural-loop-body-blocks loop)]
        (opt-block-list-label-at?
          (ir.compiler-ir-block-list-view walked-blocks)
          index
          label))]))

(define (opt-natural-loop-maybe-preheader-label?
  [maybe : (& maybe opt.OptMaybeNaturalLoop)]
  [label : i64]) : bool
  (match maybe
    [(No) false]
    [(Some loop)
      (match (opt.opt-natural-loop-preheader loop)
        [(Some actual) (= actual label)]
        [(No) false])]))

(define (opt-natural-loop-maybe-no-preheader? [maybe : opt.OptMaybeNaturalLoop]) : bool
  (match maybe
    [(No) false]
    [(Some loop)
      (match (opt.opt-natural-loop-preheader loop)
        [(No) true]
        [(Some _) false])]))

(define (opt-loop-rotation-top-test-blocks [constant-edge? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "loop:
         %2 = lt %1, 10 : bool
         branch %2, body, exit
       body:
         %1 = add %1, 1 : i64
         jump loop
       exit:
         return %1")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 1 (I64 0) (I64))
        (if constant-edge?
          (irt.instr "branch true, loop, exit")
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop")))))))

(define (opt-loop-rotation-false-body-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 0 : i64
       jump loop
     loop:
       %2 = lt %1, 10 : bool
       branch %2, exit, body
     body:
       %1 = add %1, 1 : i64
       jump loop
     exit:
       return %1"))

(define (opt-loop-rotation-successors?
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]
  [left : i64]
  [right : i64]) : bool
  (let
    [blocks : ir.CompilerIrBlockList
      (owned_view.compiler-owned-reference-shared-view blocks)]
    [successors : opt.OptLabelSet
      (let
        [index (opt.opt-cfg-index-build (& blocks))]
        (opt.opt-cfg-index-successors index label))]
    (and
      (= (opt.opt-label-count successors) 2)
      (opt.opt-label-contains successors left)
      (opt.opt-label-contains successors right))))

(define (opt-licm-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, lhs=%1:i64, rhs=%2:i64"))

(define (opt-licm-test-function [blocks : (& blocks ir.CompilerIrBlockList)]) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList
      (owned_view.compiler-owned-reference-shared-view blocks)]
    (Function
      (opt-test-symbol "licm")
      (opt-licm-params)
      (I64)
      16
      blocks
      Ordinary)))

(define (opt-licm-optimized-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt.opt-licm-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-licm-test-function blocks))))

(define (opt-licm-late-optimized-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (let
    [func : ir.CompilerIrFunction (opt-licm-test-function blocks)]
    (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
      (ast.ast-node-pool-reader-type-segment-bases)
      (& (opt.opt-cfg-context-build blocks))
      false
      (& (opt_i64_i64_map.with-capacity 1))
      (& (opt_i64_i64_map.with-capacity 1))
      (& (opt.opt-global-cell-summary-empty))
      true
      (& func))
      [(Result next _) next])))

(define (opt-licm-array-params) : ir.CompilerIrParamSeq
  (irt.params "cond=%0:bool, array=%1:(__tl_dyn-array i64), ptr=%2:u64"))

(define (opt-licm-array-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "licm_array")
    (opt-licm-array-params)
    (I64)
    16
    blocks
    Ordinary))

(define (opt-licm-array-optimized-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt.opt-licm-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-licm-array-test-function blocks))))

(define (opt-licm-array-late-optimized-function
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (let
    [func : ir.CompilerIrFunction
      (opt-licm-array-test-function (ir.compiler-ir-global-shared-view blocks))]
    (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
      (ast.ast-node-pool-reader-type-segment-bases)
      (& (opt.opt-cfg-context-build blocks))
      false
      (& (opt_i64_i64_map.with-capacity 1))
      (& (opt_i64_i64_map.with-capacity 1))
      (& (opt.opt-global-cell-summary-empty))
      true
      (& func))
      [(Result next _) next])))

(define (opt-licm-array-optimized-function-with-direct-call-clean
  [blocks : ir.CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]) : ir.CompilerIrFunction
  (opt.opt-licm-function-with-direct-call-clean
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-licm-array-test-function blocks))
    (& direct-call-clean)))

;; The POST-BCE run, which is where the descriptor-header exception lives (see
;; opt-licm-apply-loop's `descriptor-header-hoist?`), with a caller-supplied
;; clean map so a callee's proven memory class decides the hoist.
(define (opt-licm-array-late-optimized-function-with-direct-call-clean
  [blocks : ir.CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]) : ir.CompilerIrFunction
  (let
    [func : ir.CompilerIrFunction
      (opt-licm-array-test-function
        (opt.compiler-opt-global-shared-view blocks))]
    (match (opt.opt-licm-function-with-context-result-and-direct-call-clean
      (ast.ast-node-pool-reader-type-segment-bases)
      (& (opt.opt-cfg-context-build blocks))
      false
      (& direct-call-clean)
      (& (opt_i64_i64_map.with-capacity 1))
      (& (opt.opt-global-cell-summary-empty))
      true
      (& func))
      [(Result next _) next])))

(define (opt-licm-touch-clean-map [symbols : OptLicmTestSymbols] [bits : i64]) : opt_i64_i64_map.Map
  (let
    [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (opt_i64_i64_map.insert-ref!
      (&mut map)
      (ir.compiler-ir-symbol-id symbols.touch)
      bits)
    map))

(define (opt-licm-summary-for-instr [instr : ir.CompilerIrInstr]) : opt.OptLicmStoreSummary
  (opt.opt-licm-store-summary-blocks
    (ast.ast-node-pool-reader-type-segment-bases)
    (&
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "summary")
          (opt-test-instrs instr))))
    (opt.opt-licm-store-summary-empty)))

(define (opt-licm-arithmetic-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov 0 : i64
       jump loop
     loop:
       %4 = phi [%3, entry], [%5, body] : i64
       %10 = add %1, %2 : i64
       %11 = mul %10, 2 : i64
       %12 = mov 4096 : i64
       %13 = cast %12 : i64 to u64
       %14 = bitcast %13 : u64 to u64
       %15 = gep %14, %2 : u8
       branch %0, body, exit
     body:
       %5 = add %4, 1 : i64
       jump loop
     exit:
       return %11"))

;; Entry-preheader profitability fixture. The first two arithmetic values are
;; consumed only by the bypassable `cold` arm. The loaded value is likewise
;; cold-only, but its Gep/Load chain is outside the arithmetic profitability
;; gate.
(define (opt-licm-profitability-loop-tail) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %4 = add %1, %2 : i64
       %5 = neg %1 : i64
       %6 = gep %10, 0 : i64
       %7 = load %6 : i64
       branch %0, cold, latch
     cold:
       %8 = add %4, %5 : i64
       %9 = add %7, 1 : i64
       %12 = mov %8 : i64
       %13 = mov %9 : i64
       jump latch
     latch:
       branch %0, loop, exit
     exit:
       store_ptr %10, 0 : i64
       return 0"))

(define (opt-licm-profitability-blocks [non-entry-preheader? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (if non-entry-preheader?
      (ir.compiler-ir-blocks-with-tail
        (opt-licm-profitability-loop-tail)
        (irt.block "pre:
             jump loop"))
      (opt-licm-profitability-loop-tail))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Alloc 3 (I64))
        (irt.instr "%10 = addr_of %3")
        (irt.instr "store_ptr %10, 7 : i64")
        (ir.CompilerIrInstr.Jump
          (if non-entry-preheader?
            (ir.compiler-ir-label "pre")
            (ir.compiler-ir-label "loop")))))))

;; One outer loop with four consumer classes: a bypassable cold sibling, two
;; nested-loop blocks, the outer latch, and the function exit.
(define (opt-licm-hot-use-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump outer
     outer:
       %24 = lt %1, %2 : bool
       %25 = lt %2, %1 : bool
       %26 = mov %25 : bool
       branch %24, cold, inner
     cold:
       %20 = add %10, 1 : i64
       jump outer-latch
     inner:
       %21 = add %11, 1 : i64
       branch %0, inner-body, outer-latch
     inner-body:
       %22 = neg %12 : i64
       jump inner
     outer-latch:
       %23 = add %13, 1 : i64
       branch %0, outer, exit
     exit:
       return %14"))

(define (opt-licm-hot-use-self-test) : i64
  (let
    [blocks : ir.CompilerIrBlockList (opt-licm-hot-use-test-blocks)]
    [context : opt.OptCfgContext
      (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))]
    [loops : opt_natural_loop_vec.Vec
      (opt.opt-cfg-natural-loops-with-context
        (opt.compiler-opt-global-shared-view blocks)
        context)]
    (match (opt.opt-natural-loop-find
      (opt_natural_loop_vec.view loops)
      (ir.compiler-ir-label "outer")
      (ir.compiler-ir-label "outer-latch"))
      [(No) 1]
      [(Some outer)
        (match (opt.opt-cfg-index-id
          context.index
          (ir.compiler-ir-label "outer-latch"))
          [(None) 2]
          [(Some latch-id)
            (let
              [hot : (__tl_dyn-array i64)
                (opt.opt-licm-hot-use-vars
                  context
                  latch-id
                  loops
                  (opt.opt-natural-loop-header outer)
                  (opt.opt-natural-loop-body outer)
                  true
                  blocks
                  (opt.opt-used-array-new 64))]
              [ungated : (__tl_dyn-array i64)
                (opt.opt-licm-hot-use-vars
                  context
                  latch-id
                  loops
                  (opt.opt-natural-loop-header outer)
                  (opt.opt-natural-loop-body outer)
                  false
                  blocks
                  (opt.opt-used-array-new 64))]
              (cond
                [(opt.opt-used-array-contains hot 10) 3]
                [(not (opt.opt-used-array-contains hot 11)) 4]
                [(not (opt.opt-used-array-contains hot 12)) 5]
                [(not (opt.opt-used-array-contains hot 13)) 6]
                [(not (opt.opt-used-array-contains hot 14)) 7]
                [(not (opt.opt-used-array-contains ungated 10)) 8]
                ;; A compare whose every use is a branch condition is not
                ;; collected, gated or not; one with a non-branch use still is.
                [(opt.opt-used-array-contains hot 24) 9]
                [(opt.opt-used-array-contains ungated 24) 10]
                [(not (opt.opt-used-array-contains hot 25)) 11]
                [(not (opt.opt-used-array-contains ungated 25)) 12]
                [else 42]))])])))

(define (compiler-optimize-licm-profitability-self-test) : i64
  (let
    [entry-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-profitability-blocks false))]
    [entry : ir.CompilerIrBlockList (opt.opt-function-blocks entry-func)]
    [non-entry-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-profitability-blocks true))]
    [non-entry : ir.CompilerIrBlockList
      (opt.opt-function-blocks non-entry-func)]
    (cond
      [(not (= (opt-licm-hot-use-self-test) 42)) 1]
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& entry-func)))))
        2]
      [(not
          (=
            (opt-count-arith-label-blocks
              (ir.compiler-ir-block-list-view entry)
              (ir.compiler-ir-label "loop"))
            2))
        3]
      [(not
          (=
            (opt-count-arith-label-blocks
              (ir.compiler-ir-block-list-view entry)
              (ir.compiler-ir-label "cold"))
            2))
        4]
      [(not
          (=
            (opt-count-gep-label-blocks
              (ir.compiler-ir-block-list-view entry)
              (ir.compiler-ir-label "entry"))
            1))
        5]
      [(not
          (=
            (opt-count-load-label-blocks
              (ir.compiler-ir-block-list-view entry)
              (ir.compiler-ir-label "entry"))
            1))
        6]
      [(not
          (opt.opt-verify-ok? (& (opt.opt-verify-function (& non-entry-func)))))
        7]
      [(not
          (=
            (opt-count-arith-label-blocks
              (ir.compiler-ir-block-list-view non-entry)
              (ir.compiler-ir-label "pre"))
            4))
        8]
      [(not
          (=
            (opt-count-arith-label-blocks
              (ir.compiler-ir-block-list-view non-entry)
              (ir.compiler-ir-label "loop"))
            0))
        9]
      [(not
          (=
            (opt-count-arith-label-blocks
              (ir.compiler-ir-block-list-view non-entry)
              (ir.compiler-ir-label "cold"))
            0))
        10]
      [else 42])))

(define (opt-licm-simd-instr-kind [instr : ir.CompilerIrInstr] [dst : i64]) : i64
  (match instr
    [(Splat actual _ _ _)
      (if (= actual dst)
        1
        0)]
    [(VectorBinOp payload-box)
      (if (= (__tl-project-field (__tl-box-place payload-box) dst) dst)
        2
        0)]
    [(VectorCompare payload-box)
      (if (= (__tl-project-field (__tl-box-place payload-box) dst) dst)
        3
        0)]
    ;; A moved vector or mask must remain its original SIMD instruction; a
    ;; scalar copy cannot faithfully stage either register class.
    [(Mov actual _ _)
      (if (= actual dst)
        4
        0)]
    [_ 0]))

(define (opt-licm-simd-kind-in-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (let
      [kind : i64
        (opt-licm-simd-instr-kind
          (ir.compiler-ir-instr-seq-ref instrs index)
          dst)]
      (if (= kind 0)
        (opt-licm-simd-kind-in-seq instrs (+ index 1) dst)
        kind))))

(define (opt-licm-simd-index-in-seq
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (if (=
      (opt-licm-simd-instr-kind (ir.compiler-ir-instr-seq-ref instrs index) dst)
      0)
      (opt-licm-simd-index-in-seq instrs (+ index 1) dst)
      index)))

(define (opt-licm-simd-kind-at
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]
  [dst : i64]) : i64
  (match (let
    [blocks-2 (owned_view.compiler-owned-reference-shared-view blocks)]
    (opt.opt-cfg-find-block blocks-2 label))
    [(No) (- 0 1)]
    [(Some block)
      (match block
        [(Block _ instrs) (opt-licm-simd-kind-in-seq instrs 0 dst)])]))

(define (opt-licm-simd-index-at
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [label : i64]
  [dst : i64]) : i64
  (match (let
    [blocks-2 (owned_view.compiler-owned-reference-shared-view blocks)]
    (opt.opt-cfg-find-block blocks-2 label))
    [(No) (- 0 1)]
    [(Some block)
      (match block
        [(Block _ instrs) (opt-licm-simd-index-in-seq instrs 0 dst)])]))

;; One guaranteed self-loop. Every SIMD result has a hot in-loop consumer, and
;; every operand is either a parameter or an earlier member of the chain.
(define (opt-licm-simd-chain-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
           return 0")
    (irt.block "entry:
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs
        (irt.instr "%4 = splat %1 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 5 (Add) (Var 4) (Var 4) 4 (I64))
        (ir.ir-instr-vector-compare 6 (Lt) (Var 5) (Var 4) 4 (I64))
        (irt.instr "%7 = mask_reduce_any %6 lanes 4")
        (irt.instr "branch %0, loop, exit")))))

;; The first splat is invariant, then the chain meets a splat of a loop-carried
;; phi. Motion must stop at that operation and leave every dependent SIMD value
;; in the loop.
(define (opt-licm-simd-mixed-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
           return 0")
    (irt.block "entry:
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs
        (irt.instr "%3 = phi [0, entry], [%4, loop] : i64")
        (irt.instr "%5 = splat %1 lanes 4 : i64")
        (irt.instr "%6 = splat %3 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 7 (Add) (Var 5) (Var 6) 4 (I64))
        (ir.ir-instr-vector-compare 8 (Lt) (Var 7) (Var 5) 4 (I64))
        (irt.instr "%9 = mask_reduce_any %8 lanes 4")
        (irt.instr "%4 = add %3, 1 : i64")
        (irt.instr "branch %0, loop, exit")))))

;; Independent SIMD values whose only consumers are on a bypassable sibling do
;; not pay for longer live ranges. The vector operands are already available in
;; the preheader so only the hot-use gate decides these three candidates.
(define (opt-licm-simd-cold-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "cold:
           %7 = vector_reduce_sum %4 lanes 4 : i64
           %8 = vector_reduce_sum %5 lanes 4 : i64
           %9 = mask_reduce_any %6 lanes 4
           jump latch
         latch:
           branch %0, loop, exit
         exit:
           return 0")
    (irt.block
      "entry:
         %10 = splat %1 lanes 4 : i64
         %11 = splat %2 lanes 4 : i64
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs
        (irt.instr "%4 = splat %1 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 5 (Add) (Var 10) (Var 11) 4 (I64))
        (ir.ir-instr-vector-compare 6 (Lt) (Var 10) (Var 11) 4 (I64))
        (irt.instr "branch %0, cold, latch")))))

;; The sibling producer does not dominate the right arm. Its dependent binop
;; and compare have outside-loop uses (and are therefore hot), but may not move
;; because their operands remain loop definitions rather than hoisted defs.
(define (opt-licm-simd-sibling-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "latch:
               branch %0, loop, exit
             exit:
               %7 = vector_reduce_sum %5 lanes 4 : i64
               %8 = mask_reduce_any %6 lanes 4
               return 0")
    (irt.block
      "entry:
         %10 = splat %2 lanes 4 : i64
         jump loop")
    (irt.block "loop:
           branch %0, left, right")
    (irt.block
      "left:
             %4 = splat %1 lanes 4 : i64
             jump latch")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "right")
      (opt-test-instrs
        (ir.ir-instr-vector-bin-op 5 (Add) (Var 4) (Var 10) 4 (I64))
        (ir.ir-instr-vector-compare 6 (Lt) (Var 5) (Var 10) 4 (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "latch"))))))

;; Vector arithmetic with scalar-style trap semantics is intentionally outside
;; the pure/speculatable subset even when all operands and uses are invariant.
(define (opt-licm-simd-trap-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
           return 0")
    (irt.block
      "entry:
         %10 = splat %1 lanes 4 : i64
         %11 = splat %2 lanes 4 : i64
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs
        (ir.ir-instr-vector-bin-op 4 (Div) (Var 10) (Var 11) 4 (I64))
        (irt.instr "%5 = vector_reduce_sum %4 lanes 4 : i64")
        (irt.instr "branch %0, loop, exit")))))

(define (compiler-optimize-licm-simd-self-test) : i64
  (let
    [chain-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-simd-chain-blocks))]
    [chain : ir.CompilerIrBlockList (opt.opt-function-blocks chain-func)]
    [mixed-func : ir.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-simd-mixed-blocks))]
    [mixed : ir.CompilerIrBlockList (opt.opt-function-blocks mixed-func)]
    [cold : ir.CompilerIrBlockList
      (let
        [func (opt-licm-optimized-function (opt-licm-simd-cold-blocks))]
        (opt.opt-function-blocks func))]
    [sibling : ir.CompilerIrBlockList
      (let
        [func (opt-licm-optimized-function (opt-licm-simd-sibling-blocks))]
        (opt.opt-function-blocks func))]
    [trap : ir.CompilerIrBlockList
      (let
        [func (opt-licm-optimized-function (opt-licm-simd-trap-blocks))]
        (opt.opt-function-blocks func))]
    [entry : i64 (ir.compiler-ir-label "entry")]
    [loop : i64 (ir.compiler-ir-label "loop")]
    (cond
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& chain-func)))))
        1]
      [(not (opt.opt-verify-ok? (& (opt.opt-verify-function (& mixed-func)))))
        2]
      [(not (= (opt-licm-simd-kind-at (& chain) entry 4) 1)) 3]
      [(not (= (opt-licm-simd-kind-at (& chain) entry 5) 2)) 4]
      [(not (= (opt-licm-simd-kind-at (& chain) entry 6) 3)) 5]
      [(not (= (opt-licm-simd-kind-at (& chain) loop 4) 0)) 6]
      [(not (= (opt-licm-simd-kind-at (& chain) loop 5) 0)) 7]
      [(not (= (opt-licm-simd-kind-at (& chain) loop 6) 0)) 8]
      [(not
          (<
            (opt-licm-simd-index-at (& chain) entry 4)
            (opt-licm-simd-index-at (& chain) entry 5)))
        9]
      [(not
          (<
            (opt-licm-simd-index-at (& chain) entry 5)
            (opt-licm-simd-index-at (& chain) entry 6)))
        10]
      ;; No scalar Mov was substituted for any SIMD destination.
      [(= (opt-licm-simd-kind-at (& chain) entry 4) 4) 11]
      [(= (opt-licm-simd-kind-at (& chain) entry 5) 4) 12]
      [(= (opt-licm-simd-kind-at (& chain) entry 6) 4) 13]
      ;; The invariant prefix moves; the loop-carried splat and everything
      ;; depending on it remain in the loop.
      [(not (= (opt-licm-simd-kind-at (& mixed) entry 5) 1)) 14]
      [(not (= (opt-licm-simd-kind-at (& mixed) loop 6) 1)) 15]
      [(not (= (opt-licm-simd-kind-at (& mixed) loop 7) 2)) 16]
      [(not (= (opt-licm-simd-kind-at (& mixed) loop 8) 3)) 17]
      ;; Cold-only values retain their original forms in the header.
      [(not (= (opt-licm-simd-kind-at (& cold) loop 4) 1)) 18]
      [(not (= (opt-licm-simd-kind-at (& cold) loop 5) 2)) 19]
      [(not (= (opt-licm-simd-kind-at (& cold) loop 6) 3)) 20]
      ;; A producer available only on a sibling cannot seed an invariant chain.
      [(not
          (=
            (opt-licm-simd-kind-at (& sibling) (ir.compiler-ir-label "left") 4)
            1))
        21]
      [(not
          (=
            (opt-licm-simd-kind-at (& sibling) (ir.compiler-ir-label "right") 5)
            2))
        22]
      [(not
          (=
            (opt-licm-simd-kind-at (& sibling) (ir.compiler-ir-label "right") 6)
            3))
        23]
      [(not (= (opt-licm-simd-kind-at (& trap) loop 4) 2)) 24]
      [else 42])))

(define (opt-licm-trap-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %10 = div %1, %2 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %10"))

(define (opt-licm-call-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump loop
     loop:
       %8 = call tl_noop() : i64
       %10 = add %8, %1 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %10"))

(define (opt-licm-no-preheader-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, pre-one, pre-two
     pre-one:
       jump loop
     pre-two:
       jump loop
     loop:
       %10 = add %1, %2 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %10"))

(define (opt-licm-nested-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump outer
     outer:
       jump inner
     inner:
       %10 = add %1, %2 : i64
       branch %0, inner-body, outer-latch
     inner-body:
       jump inner
     outer-latch:
       branch %0, outer, exit
     exit:
       return %10"))

(define (opt-licm-load-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov 0 : i64
       %6 = alloc i64
       %10 = addr_of %6
       store_ptr %10, 99 : i64
       jump loop
     loop:
       %4 = phi [%3, entry], [%5, body] : i64
       %7 = gep %10, 0 : i64
       %8 = load %7 : i64
       %5 = add %4, 1 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %8"))

(define (opt-licm-load-store-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov 0 : i64
       %6 = alloc i64
       %10 = addr_of %6
       store_ptr %10, 99 : i64
       jump loop
     loop:
       %4 = phi [%3, entry], [%5, body] : i64
       %7 = gep %10, 0 : i64
       %8 = load %7 : i64
       store_ptr %7, 100 : i64
       %5 = add %4, 1 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %8"))

(define (opt-licm-load-call-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov 0 : i64
       %6 = alloc i64
       %10 = addr_of %6
       store_ptr %10, 99 : i64
       jump loop
     loop:
       %4 = phi [%3, entry], [%5, body] : i64
       %7 = gep %10, 0 : i64
       %8 = load %7 : i64
       %9 = call touch() : i64
       %5 = add %4, 1 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %8"))

(define (opt-licm-load-varying-address-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %3 = mov 0 : i64
       %6 = alloc i64
       %10 = addr_of %6
       store_ptr %10, 99 : i64
       jump loop
     loop:
       %4 = phi [%3, entry], [%5, body] : i64
       %7 = gep %10, %4 : i64
       %8 = load %7 : i64
       %5 = add %4, 1 : i64
       branch %0, body, exit
     body:
       jump loop
     exit:
       return %8"))

(define (opt-licm-loop-blocks-with-body
  [body : ir.CompilerIrInstrSeq]
  [ret-var : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block "entry:
         %3 = mov 0 : i64
         jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs-with-tail
        body
        (irt.instr "%4 = phi [%3, entry], [%5, body] : i64")))
    (irt.block "body:
             jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (Var ret-var)))))))

(define (opt-licm-loop-finish-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%5 = add %4, 1 : i64
     branch %0, body, exit"))

(define (opt-licm-header-load-element-store-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "%9 = gep %1, 0 : u8")
      (ir.CompilerIrInstr.Load 10 (Var 9) (U64))
      (irt.instr "%11 = gep %10, %4 : i64")
      (irt.instr "store_ptr %11, 100 : i64"))
    8))

;; Hashmap slots add an inline-field Gep after the scaled slot-address Gep.
;; Both hops remain inside the separately allocated data buffer, so neither
;; store can change the descriptor's data/length fields.
(define (opt-licm-header-load-element-gep-chain-store-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "%9 = gep %1, 0 : u8")
      (ir.CompilerIrInstr.Load 10 (Var 9) (U64))
      (irt.instr "%11 = gep %10, %4 : i64")
      (irt.instr "%12 = gep %11, 8 : u8")
      (irt.instr "store_ptr %12, 100 : i64"))
    8))

;; Vector and predicated stores through a descriptor's loaded data pointer
;; mutate only its separately allocated elements. The direct `%array` load is
;; the zero-offset data-slot form left after GVN folds `gep %array, 0`.
(define (opt-licm-header-load-vector-store-blocks [mode : i64]) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (ir.CompilerIrInstr.Load 10 (Var 1) (U64))
      (if (= mode 1)
        (ir.ir-instr-predicated-store
          (Var 10)
          (Var 4)
          (I64 100)
          (I64 15)
          4
          (I64))
        (ir.ir-instr-vector-store
          (if (= mode 2)
            (Var 2)
            (Var 10))
          (Var 4)
          (I64 100)
          4
          (I64))))
    8))

(define (opt-licm-header-load-header-store-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "%9 = gep %1, 0 : u8")
      (irt.instr "store_ptr %7, 101 : i64")
      (irt.instr "store_ptr %9, 102 : u64"))
    8))

(define (opt-licm-header-load-copybytes-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "copy_bytes %1, %2, 8"))
    8))

(defstruct OptLicmTestSymbols
  (touch i64)
  (probe i64)
  (writer i64)
  (leaf i64)
  ;; A callee that hands its own argument straight back -- the internal sret
  ;; shape opt-licm-return-alias-map recognizes.
  (ret-arg i64))

(define (opt-licm-test-symbols) : OptLicmTestSymbols
  (OptLicmTestSymbols
    (opt-test-symbol "touch")
    (opt-test-symbol "probe")
    (opt-test-symbol "writer")
    (opt-test-symbol "leaf")
    (opt-test-symbol "ret_arg")))

(define (opt-licm-header-load-call-blocks [symbols : OptLicmTestSymbols]) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "%9 = gep %1, 0 : u8")
      (ir.CompilerIrInstr.Load 10 (Var 9) (U64))
      (irt.instr "%11 = gep %10, %4 : i64")
      (irt.instr "store_ptr %11, 100 : i64")
      (ir.CompilerIrInstr.Call 12 symbols.touch (Nil) (I64)))
    8))

;; The DESCRIPTOR-HANDLE spelling of a header load: `load %array` reads the
;; data-pointer word directly (GVN canonicalizes a zero-offset descriptor Gep
;; back to the handle), so the load's address is the loop-invariant parameter
;; itself and no address formation has to move with it. The body then writes an
;; element through that buffer and calls a direct callee. Whether the load can
;; leave the loop is decided by the callee's proven memory class alone.
(define (opt-licm-header-handle-load-call-blocks [symbols : OptLicmTestSymbols]) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (ir.CompilerIrInstr.Load 8 (Var 1) (U64))
      (irt.instr "%9 = gep %8, %4 : i64")
      (irt.instr "store_ptr %9, 100 : i64")
      (ir.CompilerIrInstr.Call 12 symbols.touch (Nil) (I64)))
    8))

(define (opt-licm-header-load-unknown-store-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "store_ptr %2, 103 : i64"))
    8))

;; A Gep does not sanitize an unknown/escaped raw pointer. Its store remains a
;; full alias barrier for descriptor loads.
(define (opt-licm-header-load-unknown-gep-store-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 1 : i64")
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64))
      (irt.instr "%9 = gep %2, 8 : u8")
      (irt.instr "store_ptr %9, 103 : i64"))
    8))

(define (opt-licm-element-load-element-store-blocks) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (opt-licm-loop-finish-instrs)
      (irt.instr "%7 = gep %1, 0 : u8")
      (ir.CompilerIrInstr.Load 8 (Var 7) (U64))
      (irt.instr "%9 = gep %8, %4 : i64")
      (ir.CompilerIrInstr.Load 10 (Var 9) (I64))
      (irt.instr "store_ptr %9, 100 : i64"))
    10))

(define (opt-licm-declare-global [name : i64] [ty : ast.AstType]) : unit
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 1)]
    (ir.compiler-ir-global-builder-push!
      (&mut builder)
      (ir.CompilerIrGlobal.Global name ty (I64 0)))
    (let
      [globals : ir.CompilerIrGlobalSeq
        (ir.compiler-ir-global-builder-to-seq builder)]
      (opt.opt-licm-deref-globals-fill!
        (ast.ast-node-pool-reader-type-segment-bases)
        (& globals)))))

;; R7: a `Global` operand is a hidden rip-relative load of that global's cell,
;; so the descriptor chain rooted at one is loop-invariant exactly when the body
;; cannot write the cell. `tail` selects what else the body does: 0 nothing,
;; 1 a `Store` back into the same global, 2 a call whose effects are unknown,
;; 3 a call to the NON-RETURNING oob-abort helper -- which must read exactly
;; like 0, because nothing it could do is observable on the continuing path.
(define (opt-licm-global-cell-load-blocks
  [symbols : OptLicmTestSymbols]
  [cell : i64]
  [tail : i64]) : ir.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
      (cond
        [(= tail 1)
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (ir.CompilerIrInstr.Store cell (I64 104) (I64)))]
        [(= tail 2)
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (ir.CompilerIrInstr.Call 12 symbols.touch (Nil) (I64)))]
        [(= tail 3)
          (opt-test-instrs-with-tail
            (opt-licm-loop-finish-instrs)
            (ir.CompilerIrInstr.Call
              12
              cbi.compiler-builtin-id-tl-oob-abort
              (Nil)
              (Unit)))]
        [else (opt-licm-loop-finish-instrs)])
      (ir.CompilerIrInstr.Gep 7 (Global cell) (I64 0) (U8))
      (ir.CompilerIrInstr.Load 8 (Var 7) (I64)))
    8))

(define (opt-licm-direct-call-clean-test-functions
  [symbols : OptLicmTestSymbols]) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (opt-test-function-symbol
        symbols.probe
        (opt-test-instrs
          (ir.CompilerIrInstr.Call 90 symbols.probe (Nil) (I64))
          (irt.instr "return %90"))))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (opt-test-function-symbol
            symbols.writer
            (irt.instrs "store_ptr %1, 1 : i64
           return 0")))
        (&
          (ir.compiler-ir-function-seq-prepend
            (& (opt-test-function-symbol symbols.leaf (irt.instrs "return 7")))
            (& (ir.compiler-ir-function-seq-empty))))))))

(cfg
  test
  (define (opt-licm-checked-root-params
    [read-ty : ast.AstType]
    [write-ty : ast.AstType]
    [other-ty : ast.AstType]) : ir.CompilerIrParamSeq
    (ir.compiler-ir-param-seq-prepend
      (Param "cond" (Bool) 0)
      (ir.compiler-ir-param-seq-prepend
        (Param "read" read-ty 1)
        (ir.compiler-ir-param-seq-prepend
          (Param "write" write-ty 2)
          (ir.compiler-ir-param-seq-prepend
            (Param "raw" (U64) 3)
            (ir.compiler-ir-param-seq-prepend
              (Param "other" other-ty 4)
              (ir.compiler-ir-param-seq-empty))))))))

(cfg
  test
  (define (opt-licm-checked-root-function
    [read-ty : ast.AstType]
    [write-ty : ast.AstType]
    [other-ty : ast.AstType]
    [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
    (Function
      (opt-test-symbol "licm_checked_root")
      (opt-licm-checked-root-params read-ty write-ty other-ty)
      (I64)
      32
      blocks
      Ordinary)))

(cfg
  test
  (define (opt-licm-checked-root-barrier [mode : i64]) : ir.CompilerIrInstrSeq
    (cond
      [(= mode 1) (irt.instrs "copy_bytes %3, %3, 8")]
      [(= mode 2) (irt.instrs "%11 = call touch() : i64")]
      ;; An indirect call through the raw parameter. There is no callee name to
      ;; resolve, so no clean map can describe it: the LICM store summaries take
      ;; `call-or-unknown?` unconditionally here.
      [(= mode 3) (irt.instrs "%11 = call* %3() : i64")]
      [else (ir.compiler-ir-instr-seq-empty)])))

(cfg
  test
  (define (opt-licm-checked-root-loop-tail) : ir.CompilerIrInstrSeq
    (irt.instrs "%7 = add %6, 1 : i64
       branch %0, body, exit")))

(cfg
  test
  (define (opt-licm-checked-root-blocks
    [load-base : i64]
    [store-base : i64]
    [barrier-mode : i64]) : ir.CompilerIrBlockList
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "body:
             jump loop
           exit:
             return %9")
      (irt.block "entry:
           %5 = mov 0 : i64
           jump loop")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instrs-with-tail
          (opt.opt-licm-unswitch-instrs-onto
            (& (opt-licm-checked-root-barrier barrier-mode))
            (& (opt-licm-checked-root-loop-tail)))
          (irt.instr "%6 = phi [%5, entry], [%7, body] : i64")
          (ir.CompilerIrInstr.Gep 8 (Var load-base) (I64 0) (I64))
          (irt.instr "%9 = load %8 : i64")
          (ir.CompilerIrInstr.Gep 10 (Var store-base) (I64 0) (I64))
          (irt.instr "store_ptr %10, 9 : i64"))))))

(cfg
  test
  (define (opt-licm-checked-root-fresh-blocks) : ir.CompilerIrBlockList
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "body:
             jump loop
           exit:
             return %9")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 5 (I64 0) (I64))
          (ir.CompilerIrInstr.Call
            12
            cbi.compiler-builtin-id-tl-alloc
            (Nil)
            (U64))
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "loop")
        (opt-test-instrs-with-tail
          (opt-licm-checked-root-loop-tail)
          (irt.instr "%6 = phi [%5, entry], [%7, body] : i64")
          (irt.instr "%8 = gep %1, 0 : i64")
          (irt.instr "%9 = load %8 : i64")
          (irt.instr "%10 = gep %12, 0 : i64")
          (irt.instr "store_ptr %10, 9 : i64"))))))

(cfg
  test
  (define (opt-licm-checked-root-fresh-header-blocks) : ir.CompilerIrBlockList
    (ir.compiler-ir-blocks-with-tail
      (irt.blocks
        "body:
             jump loop
           exit:
             return %9")
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Mov 5 (I64 0) (I64))
          (ir.CompilerIrInstr.Call
            12
            cbi.compiler-builtin-id-tl-alloc
            (One (I64 16))
            (DynArray 0))
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "loop"))))
      (ir.CompilerIrBlock.Block
