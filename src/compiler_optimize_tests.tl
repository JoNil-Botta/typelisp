    [cl-call-length : i64
      (opt.opt-cl-init-length
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-cl-test-init-call-function
          (opt-test-symbol "__global_init_cl_called")
          (opt-test-symbol "cl_mutate_descriptor")))]
