    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "left")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; `left` is a direct successor of entry but also reachable through `right`.
;; Entry still dominates it, keeping the fixture valid SSA, while its two
;; predecessors make it ineligible for sinking.
(define (opt-successor-sink-multi-pred-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "left")
          (compiler_ir_types.compiler-ir-label "right"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "right")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "left"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "left")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; The StorePtr between the Load and terminator is an explicit first-cut load
;; barrier even though the loaded result is used in only one successor.
(define (opt-successor-sink-store-barrier-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Load
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "use")
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; SafeDiv still has language-level abort semantics and must not be scheduled
;; conditionally, despite otherwise looking like a pure binary definition.
(define (opt-successor-sink-trapping-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.SafeDiv)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "use")
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-successor-sink-instr-seq-defines?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : bool
  (if (>=
    index
    (compiler_ir_types.compiler-ir-instr-seq-count
      (compiler_ir_types.compiler-ir-global-shared-view instrs)))
    false
    (match (compiler_optimize.opt-instr-def-var
      (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        index))
      [(option_i64.Some found)
        (if (= found dst)
          true
          (opt-successor-sink-instr-seq-defines? instrs (+ index 1) dst))]
      [(option_i64.None)
        (opt-successor-sink-instr-seq-defines? instrs (+ index 1) dst)])))

(define (opt-successor-sink-def-label
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label instrs)
          (if (opt-successor-sink-instr-seq-defines? instrs 0 dst)
            label
            (opt-successor-sink-def-label
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              dst
              fallback))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-successor-sink-def-label
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        fallback)]))

(define (opt-successor-sink-run-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-successor-sink-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-successor-sink-test-function name blocks)))

(define (opt-successor-sink-run
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (opt-successor-sink-run-function name blocks)))

(define (compiler-optimize-successor-sink-self-test) : i64
  (let
    [positive : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_positive"
        (opt-successor-sink-positive-blocks))]
    [jump : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_jump"
        (opt-successor-sink-jump-blocks))]
    [remat-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_remat"
        (opt-successor-sink-remat-blocks))]
    [remat : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view remat-function))]
    [live-range-blocked : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_live_range_blocked"
        (opt-successor-sink-live-range-blocked-blocks))]
    [terminator-live : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_terminator_live"
        (opt-successor-sink-terminator-live-blocks))]
    [external-leaf-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_external_leaf"
        (opt-successor-sink-external-leaf-blocks))]
    [external-leaf : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view
          external-leaf-function))]
    [remat-cap-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_remat_cap"
        (opt-successor-sink-remat-cap-blocks))]
    [remat-cap : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view remat-cap-function))]
    [induction-input : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-induction-remat-blocks)]
    [induction-cell : (__tl_dyn-array i64)
      (compiler_optimize.opt-used-array-new 1)]
    [_induction-cell-init : unit (set! (array-ref induction-cell 0) 16)]
    [induction-direct : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-successor-sink-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        16
        (compiler_optimize.compiler-opt-global-shared-view induction-cell)
        induction-input)]
    [induction-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_induction_remat"
        (opt-successor-sink-induction-remat-blocks))]
    [induction : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view induction-function))]
    [induction-step-two-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_induction_step_two"
        (opt-successor-sink-induction-remat-blocks-with-step 2))]
    [induction-step-two : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view
          induction-step-two-function))]
    [multi-use : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_multi_use"
        (opt-successor-sink-multi-use-blocks))]
    [multi-pred : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_multi_pred"
        (opt-successor-sink-multi-pred-blocks))]
    [store-barrier : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_store_barrier"
        (opt-successor-sink-store-barrier-blocks))]
    [trapping : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_trapping"
        (opt-successor-sink-trapping-blocks))]
    (begin
      (unless
        (=
          (opt-successor-sink-def-label
            (compiler_optimize.compiler-opt-global-shared-view positive)
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "use"))
        (return 1))
      (unless
        (=
          (opt-successor-sink-def-label
            positive
            3
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "use"))
        (return 2))
      (unless
        (=
          (opt-successor-sink-def-label
            multi-use
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 3))
      (unless
        (=
          (opt-successor-sink-def-label
            multi-pred
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 4))
      (unless
        (=
          (opt-successor-sink-def-label
            store-barrier
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 5))
      (unless
        (=
          (opt-successor-sink-def-label
            trapping
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 6))
      (unless
        (=
          (compiler_optimize.opt-function-frame
            (compiler_optimize.compiler-opt-global-shared-view remat-function))
          18)
        (return 7))
      (unless
        (and
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view remat)
              2
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view remat)
              3
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view remat)
              4
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view remat)
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view remat)
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              remat
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 8))
      (unless
        (and
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                live-range-blocked)
              3
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry"))
          (=
            (opt-successor-sink-def-label
              live-range-blocked
              4
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry")))
        (return 9))
      (unless
        (and
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                terminator-live)
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              terminator-live
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 10))
      (unless
        (and
          (=
            (compiler_optimize.opt-function-frame
              (compiler_optimize.compiler-opt-global-shared-view
                external-leaf-function))
            16)
          (=
            (opt-successor-sink-def-label
              external-leaf
              4
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry")))
        (return 11))
      (unless
        (=
          (compiler_optimize.opt-function-frame
            (compiler_optimize.compiler-opt-global-shared-view
              remat-cap-function))
          16)
        (return 12))
      (unless
        (=
          (opt-successor-sink-def-label
            remat-cap
            8
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 13))
      (unless
        (and
          (= (array-ref induction-cell 0) 18)
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                induction-direct)
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                induction-direct)
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                induction-direct)
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction-direct
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 14))
      (unless
        (and
          (=
            (compiler_optimize.opt-function-frame
              (compiler_optimize.compiler-opt-global-shared-view
                induction-function))
            18)
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view induction)
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view induction)
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view induction)
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 15))
      (unless
        (and
          (=
            (compiler_optimize.opt-function-frame
              (compiler_optimize.compiler-opt-global-shared-view
                induction-step-two-function))
            16)
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                induction-step-two)
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                induction-step-two)
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              (compiler_optimize.compiler-opt-global-shared-view
                induction-step-two)
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label-none))
          (=
            (opt-successor-sink-def-label
              induction-step-two
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label-none)))
        (return 16))
      (unless
        (=
          (opt-successor-sink-def-label
            jump
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "use"))
        (return 17))
      42)))

;; Returns the lhs var id of the `BinOp` whose destination is `dst`, or -1 if it
;; is absent or its lhs is not a var. Used to inspect copy-propagation rewrites.
(define (opt-copy-binop-lhs-var-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]) : i64
  (if (>= index count)
    (- 0 1)
    (match (array-ref slots index)
      [(compiler_ir_types.CompilerIrInstr.BinOp actual _ lhs _ _)
        (if (= actual dst)
          (match lhs
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-copy-binop-lhs-var-instr-seq-from slots (+ index 1) count dst))]
      [_ (opt-copy-binop-lhs-var-instr-seq-from slots (+ index 1) count dst)])))

(define (opt-copy-binop-lhs-var-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-copy-binop-lhs-var-instr-seq-from instrs.slots 0 instrs.len dst))

;; `[Mov v1 = v0, BinOp v2 = v1 + 1]`: copy propagation rewrites the binop lhs
;; from v1 to v0.
(define (opt-copy-pos-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))))

;; `[Mov v1 = v0, Load v0 = *v9, BinOp v2 = v1 + 1]`: redefining the copy source
;; v0 invalidates the v1 -> v0 fact, so the binop lhs stays v1.
(define (opt-copy-src-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      0
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))))

;; `[Mov v1 = v0, Load v1 = *v9, BinOp v2 = v1 + 1]`: redefining the copy
;; destination v1 invalidates the fact, so the binop lhs stays v1.
(define (opt-copy-dst-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      1
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))))

;; `[BinOp v2 = v0 + v1, BinOp v3 = v0 + v1, BinOp v4 = v3 + 1, Return v4]`: CSE
;; rewrites the second expression to `Mov v3 = v2`; copy propagation then rewrites
;; the v4 lhs from v3 to v2, leaving the `Mov v3` copy dead for DCE to drop (the
;; `Return v4` keeps v4 live so only the copy is removed: 4 instrs -> 3).
(define (opt-copy-cse-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      4
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 4)))))

;; `[Mov v1 = 1.5f64, BinOp v2 = v1 + v1]`: an F64 source is not recorded as a
;; copy in this slice, so the binop lhs stays v1 (no unsafe literal propagation).
(define (opt-copy-f64-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.F64 (opt-test-f64-bits "1.5"))
      (compiler_ast_types.AstType.F64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.F64))))

(define (opt-copy-phi-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Phi
      2
      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "left")
        (compiler_ir_types.compiler-ir-phi-input-seq-empty))
      (compiler_ast_types.AstType.I64))))

(define (opt-copy-pack-words
  [a : compiler_ir_types.CompilerIrValue]
  [b : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrValueSeq
  (compiler_ir_types.compiler-ir-value-seq-prepend
    a
    (compiler_ir_types.compiler-ir-value-seq-prepend
      b
      (compiler_ir_types.compiler-ir-value-seq-empty))))

(define (opt-copy-pack-word-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Pack
      2
      (opt-copy-pack-words
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1))
      (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
    (compiler_ir_types.CompilerIrInstr.Word
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      0
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      4
      (compiler_ir_types.CompilerIrValue.Var 2)
      1
      (compiler_ast_types.AstType.I64))))

(define (opt-copy-pack-source-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Pack
      2
      (opt-copy-pack-words
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1))
      (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
    (compiler_ir_types.CompilerIrInstr.Load
      0
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      0
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      4
      (compiler_ir_types.CompilerIrValue.Var 2)
      1
      (compiler_ast_types.AstType.I64))))

(define (opt-copy-pack-dst-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Pack
      2
      (opt-copy-pack-words
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1))
      (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      0
      (compiler_ast_types.AstType.I64))))

(define (opt-copy-mov-src-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    fallback
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov found src _)
        (if (= found dst)
          (match src
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ fallback])
          (opt-copy-mov-src-var-from instrs (+ index 1) dst fallback))]
      [_ (opt-copy-mov-src-var-from instrs (+ index 1) dst fallback)])))

(define (opt-copy-mov-src-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-copy-mov-src-var-from instrs 0 dst fallback))

(define (opt-copy-word-src-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    fallback
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Word found src _ _)
        (if (= found dst)
          (match src
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ fallback])
          (opt-copy-word-src-var-from instrs (+ index 1) dst fallback))]
      [_ (opt-copy-word-src-var-from instrs (+ index 1) dst fallback)])))

(define (opt-copy-word-src-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-copy-word-src-var-from instrs 0 dst fallback))

(define (opt-phi-first-input-var
  [inputs : compiler_ir_types.CompilerIrPhiInputSeq]
  [fallback : i64]) : i64
  (let
    [phi-inputs-at-10899-3 : compiler_ir_types.CompilerIrPhiInputSeq inputs]
    (if (<= phi-inputs-at-10899-3.len 0)
      fallback
      (let
        [phi-input-at-10899-3 : compiler_ir_types.CompilerIrPhiInput
          (compiler_ir_types.compiler-ir-phi-input-seq-ref
            (compiler_ir_types.compiler-ir-global-shared-view
              phi-inputs-at-10899-3)
            0)]
        [value : compiler_ir_types.CompilerIrValue phi-input-at-10899-3.value]
        (match value
          [(compiler_ir_types.CompilerIrValue.Var id) id]
          [_ fallback])))))

(define (opt-phi-dst-first-input-var-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    fallback
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Phi found inputs _)
        (if (= found dst)
          (opt-phi-first-input-var inputs fallback)
          (opt-phi-dst-first-input-var-from instrs (+ index 1) dst fallback))]
      [_ (opt-phi-dst-first-input-var-from instrs (+ index 1) dst fallback)])))

(define (opt-phi-dst-first-input-var
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-phi-dst-first-input-var-from instrs 0 dst fallback))

;; Returns 42 when block-local copy propagation: rewrites a var copy into a later
;; use (pos: lhs v1 -> v0); does not propagate after the source (src-redef) or
;; destination (dst-redef) var is redefined; rewrites a CSE-introduced copy so
;; DCE can drop it (cse: lhs v3 -> v2, leaving 3 instrs); does not propagate an
;; unsafe F64 source (f64: lhs stays v1); and leaves phi inputs untouched because
;; they are edge operands rather than block-local value uses.
(define (compiler-optimize-copy-self-test) : i64
  (let
    [pos : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-pos-instrs))]
    [src-redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-src-redef-instrs))]
    [dst-redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-dst-redef-instrs))]
    [cse : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-test-cse-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_optimize.OptExprTable.Nil)
          (opt-copy-cse-instrs)))]
    [cse-dce : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs
        (opt-test-collect-instrs-uses
          (opt_i64_i64_map.with-capacity 64)
          (compiler_optimize.compiler-opt-global-shared-view cse))
        (compiler_optimize.compiler-opt-global-shared-view cse))]
    [f64 : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-f64-instrs))]
    [phi : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-phi-instrs))]
    [pack-word : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-pack-word-instrs))]
    [pack-source-redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-pack-source-redef-instrs))]
    [pack-dst-redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (opt-copy-pack-dst-redef-instrs))]
    (cond
      [(not (= (opt-copy-binop-lhs-var-instr-seq pos 2) 0)) 1]
      [(not (= (opt-copy-binop-lhs-var-instr-seq src-redef 2) 1)) 2]
      [(not (= (opt-copy-binop-lhs-var-instr-seq dst-redef 2) 1)) 3]
      [(not (= (opt-copy-binop-lhs-var-instr-seq cse 4) 2)) 4]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count cse-dce) 3)) 5]
      [(not (= (opt-copy-binop-lhs-var-instr-seq f64 2) 1)) 6]
      [(not (= (opt-phi-dst-first-input-var phi 2 (- 0 1)) 1)) 7]
      [(not
          (=
            (opt-copy-mov-src-var
              (compiler_optimize.compiler-opt-global-shared-view pack-word)
              3
              (- 0 1))
            0))
        8]
      [(not (= (opt-copy-mov-src-var pack-word 4 (- 0 1)) 1)) 9]
      [(not
          (=
            (opt-copy-word-src-var
              (compiler_optimize.compiler-opt-global-shared-view
                pack-source-redef)
              3
              (- 0 1))
            2))
        10]
      [(not (= (opt-copy-mov-src-var pack-source-redef 4 (- 0 1)) 1)) 11]
      [(not (= (opt-copy-word-src-var pack-dst-redef 3 (- 0 1)) 2)) 12]
      [else 42])))

;; Count explicit trapping bounds checks after the dedicated bounds pass.
(define (opt-count-bounds-instrs-from-index
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.BoundsCheck _ _ _) 1]
        [_ 0])
      (opt-count-bounds-instrs-from-index instrs (+ index 1)))))

(define (opt-count-bounds-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-bounds-instrs-from-index instrs 0))

(define (opt-bounds-duplicate-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-different-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-call-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.Call
      9
      (opt-test-symbol "touch")
      (compiler_ir_types.CompilerIrCallArgs.Nil)
      (compiler_ast_types.AstType.Unit))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-branch-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ir_types.compiler-ir-label "ok")
      (compiler_ir_types.compiler-ir-label "fail"))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-dce-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))))

;; Index-cast canonicalization: two accesses to the same logical index
;; (var0) and array (var1) each emit a fresh `Cast(_, I64->U64)` of var0 and a
;; fresh length load; the second bounds check is redundant. Without
;; canonicalization the distinct cast vars (10 vs 14) never match, so this case
;; pins the optimization (count 1).
(define (opt-bounds-index-cast-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Cast
      10
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      11
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      12
      (compiler_ir_types.CompilerIrValue.Var 11)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Cast
      13
      (compiler_ir_types.CompilerIrValue.Var 12)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 13)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.Cast
      14
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      15
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      16
      (compiler_ir_types.CompilerIrValue.Var 15)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Cast
      17
      (compiler_ir_types.CompilerIrValue.Var 16)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 14)
      (compiler_ir_types.CompilerIrValue.Var 17)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

;; Adversarial: redefining the index source (var0) between the two checks must
;; invalidate the canonicalized fact, so the second check is kept (count 2). A
;; `<=`-into-`<` or stale-source bug would wrongly drop it.
(define (opt-bounds-index-cast-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Cast
      10
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      11
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      12
      (compiler_ir_types.CompilerIrValue.Var 11)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Cast
      13
      (compiler_ir_types.CompilerIrValue.Var 12)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 13)
      (compiler_ir_types.compiler-ir-label "bounds_ok.0"))
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Cast
      14
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      15
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      16
      (compiler_ir_types.CompilerIrValue.Var 15)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Cast
      17
      (compiler_ir_types.CompilerIrValue.Var 16)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 14)
      (compiler_ir_types.CompilerIrValue.Var 17)
      (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))

(define (opt-bounds-cross-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "bounds_ok.0"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "next")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "bounds_ok.1"))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(defstruct OptLoopBceTestSymbols
  (touch i64)
  (argc i64)
  (base i64))

(define (opt-loop-bce-test-symbols) : OptLoopBceTestSymbols
  (OptLoopBceTestSymbols
    (opt-test-symbol "touch")
    (opt-test-symbol "argc")
    (opt-test-symbol "base")))

(define (opt-loop-bce-test-summaries
  [symbols : OptLoopBceTestSymbols]
  [clean-touch : bool]
  [argc-return : bool]) : compiler_optimize.OptLoopBceSummaries
  (let
    [clean : opt_i64_i64_map.Map
      (if clean-touch
        (let
          [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut map)
              (compiler_ir_types.compiler-ir-symbol-id symbols.touch)
              1)
            map))
        (opt_i64_i64_map.with-capacity 8))]
    [argc : opt_i64_i64_map.Map
      (if argc-return
        (let
          [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
          (begin
            (opt_i64_i64_map.insert-ref!
              (&mut map)
              (compiler_ir_types.compiler-ir-symbol-id symbols.argc)
              1)
            map))
        (opt_i64_i64_map.with-capacity 8))]
    (compiler_optimize.OptLoopBceSummaries
      true
      (profile_state.compiler-profile-state-new)
      (compiler_optimize.compiler-opt-global-shared-view clean)
      clean
      (opt_i64_i64_map.with-capacity 8)
      argc
      (opt_i64_i64_map.with-capacity 8)
      (opt_i64_i64_map.with-capacity 8)
      (opt_i64_i64_map.with-capacity 8)
      (compiler_optimize.opt-global-cell-summary-empty)
      (compiler_ir_types.compiler-ir-representation-index-empty))))

