(define (opt-cs-test-n6) : ir.CompilerIrFunction
  (opt-cs-test-run
    "function @cs_fn(n=%0:i64) -> i64 vars 12 {
     entry:
       %1 = mov 0 : i64
       jump pre
     pre:
