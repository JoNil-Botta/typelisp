;; Dense fixture literals expand to one right-sized builder and forward pushes.
;; Each expansion owns its backing array, so separate tests cannot accidentally
;; share mutable instruction storage.
(defmacro (opt-test-instrs-push!
  [builder : comptime.Expr]
  [carrier : comptime.Expr]
  [index : comptime.Expr]) : unit
  (match index
    [(comptime.Expr.Int i)
      (match carrier
        [(comptime.Expr.Call _ instrs)
          (if (>= i (comptime.expr-list-length instrs))
            `unit
            `(begin
              (ir.compiler-ir-instr-builder-push!
                ,builder
                ,(comptime.expr-list-nth instrs i))
              (opt-test-instrs-push!
                ,builder
                ,carrier
                ,(comptime.expr-int (+ i 1)))))]
        [_ `unit])]
    [_ `unit]))

(defmacro (opt-test-instrs [instrs : ir.CompilerIrInstr ...]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (comptime.expr-list-length instrs)]
    `(let
      [builder : ir.CompilerIrInstrBuilder
        (ir.compiler-ir-instr-builder-with-capacity ,(comptime.expr-int count))]
      (opt-test-instrs-push! (&mut builder) (__opt-test-instrs ,@instrs) 0)
      (ir.compiler-ir-instr-builder-to-seq builder))))

;; Prefix a computed dense suffix without rebuilding fixtures as recursive
;; lists. Prefix expressions retain their source order; the suffix is evaluated
;; once after them and appended through the dense builder API.
(defmacro (opt-test-instrs-with-tail
  [tail : ir.CompilerIrInstrSeq]
  [instrs : ir.CompilerIrInstr ...]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (comptime.expr-list-length instrs)]
    `(let
      [builder : ir.CompilerIrInstrBuilder
        (ir.compiler-ir-instr-builder-with-capacity ,(comptime.expr-int count))]
      (opt-test-instrs-push! (&mut builder) (__opt-test-instrs ,@instrs) 0)
      (let
        [suffix : ir.CompilerIrInstrSeq ,tail]
        [suffix-count : i64 (ir.compiler-ir-instr-seq-count suffix)]
        (ir.compiler-ir-instr-builder-append-seq-range!
          (&mut builder)
          suffix
          0
          suffix-count)
        (ir.compiler-ir-instr-builder-to-seq
          (ir.compiler-ir-global-shared-view builder))))))

(define (opt-test-instr-seq-copy [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    (ir.compiler-ir-instr-builder-append-seq-range!
      (&mut builder)
      instrs
      0
      count)
    (ir.compiler-ir-instr-builder-to-seq builder)))

;; Dynamic fixture generators cannot use the variadic literal macros above.
;; Keep their computed prefixes dense and in source order.
(define (opt-test-instr-seq-prepend
  [instr : ir.CompilerIrInstr]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [tail-count : i64 (ir.compiler-ir-instr-seq-count tail)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity (+ tail-count 1))]
    (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
    (ir.compiler-ir-instr-builder-append-seq-range!
      (&mut builder)
      tail
      0
      tail-count)
    (ir.compiler-ir-instr-builder-to-seq builder)))

(define (opt-test-fold-instrs
  [type-segment-bases : i64]
  [env : opt.OptConstEnv]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [result : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
    (opt-fold-instrs! type-segment-bases env (&mut result))
    result))

(define (opt-test-strength-instrs
  [env : opt.OptConstEnv]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [result : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
    (opt-strength-instrs! env (&mut result))
    result))

(define (opt-test-collect-instrs-uses
  [set : opt_i64_i64_map.Map]
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : opt_i64_i64_map.Map
  (opt-collect-instrs-uses set (& instrs)))

(define (opt-test-dce-instrs
  [set : (& set opt_i64_i64_map.Map)]
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : ir.CompilerIrInstrSeq
  (let
    [instrs : ir.CompilerIrInstrSeq
      (owned_view.compiler-owned-reference-shared-view instrs)]
    [result : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
    (opt-dce-instrs! set (&mut result))
    result))

(define (opt-test-instr-seq-eq
  [type-segment-bases : i64]
  [left : ir.CompilerIrInstrSeq]
  [right : ir.CompilerIrInstrSeq]) : bool
  (opt.opt-instr-seq-eq type-segment-bases (& left) (& right)))

(define (opt-test-cse-instrs
  [type-segment-bases : i64]
  [table : opt.OptExprTable]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [result : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
    (opt-cse-instrs! type-segment-bases table (&mut result))
    result))

(define (opt-test-copy-instrs
  [env : opt.OptCopyEnv]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [result : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
    (opt-copy-instrs! env (&mut result))
    result))

(define (opt-test-bounds-instrs
  [type-segment-bases : i64]
  [facts : opt.OptBoundsFacts]
  [casts : opt.OptBoundsCastEnv]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [result : ir.CompilerIrInstrSeq (opt-test-instr-seq-copy instrs)]
    (opt-bounds-instrs! type-segment-bases facts casts (&mut result))
    result))

(define (opt-fold-cell-lhs-binop? [instr : (& instr ir.CompilerIrInstr)]) : bool
  (match instr
    [(BinOp _ _ (Global _) _ _) true]
    [_ false]))

(define (opt-fold-instrs!
  [type-segment-bases : i64]
  [env : opt.OptConstEnv]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [count : i64 instrs.len]
    [state : opt.OptConstEnv env]
    [index : i64 0]
    (while (< index count)
      (let
        [cur : ir.CompilerIrInstr (clone (array-ref instrs.slots index))]
        ;; the peek clones the next slot only behind a cell-lhs binop, which
        ;; is rare; every other instruction pays one shape test
        [rmw? : bool
          (and
            (opt-fold-cell-lhs-binop? cur)
            (< (+ index 1) count)
            (opt.opt-fold-rmw-shape?
              (& cur)
              (& (clone (array-ref instrs.slots (+ index 1))))))]
        (match (opt.opt-fold-instr
          type-segment-bases
          (opt.compiler-opt-global-shared-view state)
          cur
          rmw?)
          [(Result next-state rewritten)
            (set! (array-ref instrs.slots index) rewritten)
            (set! state next-state)
            (set! index (+ index 1))])))))

(define (opt-strength-instrs!
  [env : opt.OptConstEnv]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [count : i64 instrs.len]
    [state : opt.OptConstEnv env]
    [index : i64 0]
    (while (< index count)
      (match (opt.opt-strength-instr
        state
        (clone (array-ref instrs.slots index)))
        [(Result next-state rewritten)
          (set! (array-ref instrs.slots index) rewritten)
          (set! state next-state)
          (set! index (+ index 1))]))))

(define (opt-collect-instrs-uses
  [set : opt_i64_i64_map.Map]
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : opt_i64_i64_map.Map
  (let
    [state : opt_i64_i64_map.Map set]
    [index : i64 0]
    (while (< index instrs.len)
      (set!
        state
        (let
          [instr (clone (array-ref instrs.slots index))]
          (opt.opt-collect-instr-uses state instr)))
      (set! index (+ index 1)))
    state))

(define (opt-array-next-adjacent-alloc-ref?
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [count : i64]
  [index : i64]
  [dst : i64]) : bool
  (if (>= (+ index 1) count)
    false
    (opt.opt-instr-alloc-dst?
      (& (clone (array-ref slots (+ index 1))))
      (+ dst 1))))

;; Map-backed block-local DCE for the fixtures: the same dead-instruction rule as
;; the pipeline's opt.opt-instr-dead-array?, over an i64 -> count use map.
(define (opt-instr-dead?
  [set : (& set opt_i64_i64_map.Map)]
  [instr : (& instr ir.CompilerIrInstr)]) : bool
  (match (owned_view.compiler-owned-reference-shared-view instr)
    [(or (Mov dst _ _) (AddrOf dst _) (Gep dst _ _ _) (Cast dst _ _ _)
         (Load dst _ _) (UnOp dst _ _ _) (Phi dst _ _) (LaneId dst _ _)
         (Splat dst _ _ _) (VectorReduce dst _ _ _ _) (MaskBinOp dst _ _ _ _)
         (MaskNot dst _ _) (MaskReduce dst _ _ _) (TailMask dst _ _ _)
         (Pack dst _ _) (Word dst _ _ _))
      (not (opt.opt-used-contains set dst))]
    [(BinOp dst op _ rhs ty)
      (and
        (not (opt.opt-dce-binop-traps? (& op) (& rhs) (& ty)))
        (not (opt.opt-used-contains set dst)))]
    [(VectorBinOp payload-box)
      (let
        [dst (deref payload-box).dst]
        (not (opt.opt-used-contains set dst)))]
    [(VectorPrefix payload-box)
      (let
        [dst (deref payload-box).dst]
        (not (opt.opt-used-contains set dst)))]
    [(VectorCompare payload-box)
      (let
        [dst (deref payload-box).dst]
        (not (opt.opt-used-contains set dst)))]
    [(Select payload-box)
      (let
        [dst (deref payload-box).dst]
        (not (opt.opt-used-contains set dst)))]
    [_ false]))

(define (opt-dce-instrs-from
  [set : (& set opt_i64_i64_map.Map)]
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [count : i64]
  [index : i64]
  [prev-alloc-dst : i64]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (if (>= index count)
    unit
    (let
      [instr : ir.CompilerIrInstr (clone (array-ref slots index))]
      (if (opt-instr-dead? set instr)
        (opt-dce-instrs-from set slots count (+ index 1) -2 builder)
        (match (opt.compiler-opt-global-shared-view instr)
          [(Alloc dst _)
            (if (and
              (not (opt.opt-used-contains set dst))
              (not
                (or
                  (= prev-alloc-dst (- dst 1))
                  (opt-array-next-adjacent-alloc-ref? slots count index dst))))
              unit
              (ir.compiler-ir-instr-builder-push! builder instr))
            (opt-dce-instrs-from set slots count (+ index 1) dst builder)]
          [_
            (ir.compiler-ir-instr-builder-push! builder instr)
            (opt-dce-instrs-from set slots count (+ index 1) -2 builder)])))))

(define (opt-dce-instrs!
  [set : (& set opt_i64_i64_map.Map)]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity instrs.len)]
    (opt-dce-instrs-from set (& instrs.slots) instrs.len 0 -2 (&mut builder))
    (set! instrs.slots builder.slots)
    (set! instrs.len builder.len)))

(define (opt-cse-instrs!
  [type-segment-bases : i64]
  [table : opt.OptExprTable]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [count : i64 instrs.len]
    [state : opt.OptExprTable table]
    [index : i64 0]
    (while (< index count)
      (match (opt.opt-cse-instr
        type-segment-bases
        (opt.compiler-opt-global-shared-view state)
        (clone (array-ref instrs.slots index)))
        [(Result next-state rewritten)
          (set! (array-ref instrs.slots index) rewritten)
          (set! state next-state)
          (set! index (+ index 1))]))))

(define (opt-copy-instrs!
  [env : opt.OptCopyEnv]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [count : i64 instrs.len]
    [state : opt.OptCopyEnv env]
    [index : i64 0]
    [own : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-reference-shared-view instrs)))]
    [_addr-taken : unit
      (opt.opt-function-addr-taken-install!
        (opt-test-addr-of-bound (ir.compiler-ir-block-list-view own))
        (& own))]
    (while (< index count)
      (match (opt.opt-copy-instr
        (& state)
        (& (clone (array-ref instrs.slots index))))
        [(Result next-state rewritten)
          (set! (array-ref instrs.slots index) rewritten)
          (set! state next-state)
          (set! index (+ index 1))]))))

(define (opt-bounds-instrs!
  [type-segment-bases : i64]
  [facts : opt.OptBoundsFacts]
  [casts : opt.OptBoundsCastEnv]
  [instrs : (&mut instrs ir.CompilerIrInstrSeq)]) : unit
  (let
    [count : i64 instrs.len]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [state : opt.OptBoundsSeqState (Plain facts casts)]
    [index : i64 0]
    (while (< index count)
      (let
        [instr : ir.CompilerIrInstr (clone (array-ref instrs.slots index))]
        [step : opt.OptBoundsSeqStep
          (match state
            [(Plain current-facts current-casts)
              (opt.opt-bounds-seq-step-plain
                type-segment-bases
                current-facts
                current-casts
                instr)]
            [(Object current-facts lengths ptrs current-casts)
              (opt.opt-bounds-seq-step-object
                type-segment-bases
                current-facts
                lengths
                ptrs
                current-casts
                instr)])]
        (match step
          [(Step next-state keep)
            (if keep
              (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
              unit)
            (set! state next-state)
            (set! index (+ index 1))])))
    (set! instrs.slots builder.slots)
    (set! instrs.len builder.len)))

(define (opt-load-cse-instrs-from
  [type-segment-bases : i64]
  [hs : opt.OptLoadHeaderSet]
  [sources : opt.OptValueSources]
  [call-memory : opt_i64_i64_map.Map]
  [state : opt.OptLoadCseState]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [cells : opt.OptGlobalCellSummary (opt.opt-load-cse-no-cells-view)]
    [no-canon : (__tl_dyn-array i64) (opt.opt-load-canon-none)]
    [next-state : opt.OptLoadCseState state]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity count)]
    [index : i64 0]
    (while (< index count)
      (match (opt.opt-load-cse-dispatch
        type-segment-bases
        (&mut no-canon)
        hs
        false
        sources
        call-memory
        cells
        (opt.compiler-opt-global-shared-view next-state)
        (ir.compiler-ir-instr-seq-ref instrs index))
        [(Result after-state new-instr)
          (set! next-state after-state)
          (ir.compiler-ir-instr-builder-push! (&mut builder) new-instr)])
      (set! index (+ index 1)))
    (ir.compiler-ir-instr-builder-to-seq builder)))

(define (opt-load-cse-instrs
  [type-segment-bases : i64]
  [hs : opt.OptLoadHeaderSet]
  [state : opt.OptLoadCseState]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (opt-load-cse-instrs-from
    type-segment-bases
    hs
    (opt.opt-value-sources-new)
    (opt_i64_i64_map.with-capacity 1)
    state
    instrs))

;; The optimizer's program and inliner entries all thread source spans. A
;; fixture without spans runs the production entry with an empty span table and
;; keeps only the optimized code.
(define (opt-test-optimize-program-with-level
  [program : ir.CompilerIrProgram]
  [level : i64]) : ir.CompilerIrProgram
  (match (opt.optimize-program-with-spans-and-level
    (& program)
    (ir.compiler-source-spans-empty)
    level)
    [(Program optimized _) optimized]))

;; The inline stage with no optimizer-input arena: final bodies escape into the
;; current arena, as they do for every caller that is not the level-2 program
;; optimizer.
(define (opt-test-inline-program-with-spans
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionSeq]
  [level : i64]
  [spans : ir.CompilerSourceSpans]) : opt.OptInlineSpanProgram
  (let
    [input : opt.OptOptimizerInput (opt.opt-optimizer-input-new 0 0)]
    (opt.opt-inline-program-functions-with-spans
      pools
      (&mut input)
      type-segment-bases
      functions
      level
      spans)))

(define (opt-test-inline-program-functions
  [type-segment-bases : i64]
  [functions : ir.CompilerIrFunctionSeq]
  [level : i64]) : ir.CompilerIrFunctionSeq
  (match (opt-test-inline-program-with-spans
    (ast.ast-node-pool-reader-context-current)
    type-segment-bases
    functions
    level
    (ir.compiler-source-spans-empty))
    [(Program inlined _) inlined]))

;; The level-2 per-function pass fixpoint followed by the final if-conversion
;; and constant-branch threading, without the rest of the production level-2
;; tail (optimize-function-with-level). The pass fixtures below were written
;; against exactly this sequence.
(define (opt-test-optimize-function
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (let
    [fixed : ir.CompilerIrFunction
      (match (opt.optimize-function-fixed-pass-with-summaries
        pools
        type-segment-bases
        func
        (opt.optimize-function-max-iterations)
        (& (opt.opt-program-summaries-empty)))
        [(Result next _) next])]
    [converted : ir.CompilerIrFunction
      (match (opt.opt-if-convert-final-pass type-segment-bases (& fixed))
        [(Result next _) next])]
    (match (opt.opt-thread-const-branch-final-pass
      type-segment-bases
      (& converted))
      [(Result next _) next])))

;; One past the highest var a block's `addr_of` reads: the frame a test driver
;; installs address-taken marks for, so they cover every address-taken var
;; whether the block defines it or reads it as a param.
(define (opt-test-addr-of-bound-instr-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (let
    [index : i64 0]
    [bound : i64 0]
    (while (< index (ir.compiler-ir-instr-seq-count instrs))
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(AddrOf _ src)
          (if (> (+ src 1) bound)
            (set! bound (+ src 1))
            unit)]
        [_ unit])
      (set! index (+ index 1)))
    bound))

(define (opt-test-addr-of-bound
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [here : i64 (opt-test-addr-of-bound-instr-seq instrs)]
            [later : i64 (opt-test-addr-of-bound rest)]
            (if (> here later)
              here
              later))])]))

;; The block-local pipeline (fold, CSE, load-CSE, DSE, copy, bounds) on one
;; block with no header-typed handles, load kinds, alias seeds or scan scratch:
;; the context-free form of the per-block step optimize-block-list-for-function
;; runs. It installs the block's own `addr_of`s as the fold pipeline's
;; address-taken marks, as the function pass installs its whole-function scan.
(define (opt-test-optimize-block
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : ir.CompilerIrBlock
  (let
    [profile-state
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))]
    [own : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks (opt.compiler-opt-global-shared-view block))]
    [_addr-taken : unit
      (opt.opt-function-addr-taken-install!
        (opt-test-addr-of-bound (ir.compiler-ir-block-list-view own))
        (& own))]
    [hs (opt.opt-load-header-set-empty)]
    [dead-kinds (opt.opt-load-kinds-empty)]
    [load-kinds (opt.opt-load-kinds-empty)]
    [entry-label (ir.compiler-ir-label "entry")]
    [seed-facts (opt.opt-alias-empty)]
    [tables : opt.OptBlockExprTables (opt.opt-block-expr-tables-new)]
    (opt.optimize-block-hs-with-kinds
      profile-state
      pools
      type-segment-bases
      hs
      dead-kinds
      (& load-kinds)
      entry-label
      seed-facts
      (__tl_make-array i64 0)
      (&mut tables)
      block)))

(define (opt-test-optimize-block-list!
  [out : (&mut out ir.CompilerIrBlockBuilder)]
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]) : unit
  (match blocks
    [(slice) unit]
    [(slice block & rest)
      (ir.compiler-ir-block-builder-push!
        out
        (opt-test-optimize-block
          pools
          type-segment-bases
          (owned_view.compiler-owned-reference-shared-view block)))
      (opt-test-optimize-block-list! out rest pools type-segment-bases)]))

;; A call-site stand-in for the span-carrying clone walks: with an empty span
;; table no location is found for it, so the clones carry no spans.
(define (opt-test-inline-no-span-call) : ir.CompilerIrInstr
  (Return (No)))

(define (opt-test-inline-expand-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [dst : i64]
  [ret : ast.AstType]
  [sa : ir.CompilerIrCallArgs]
  [np : i64]
  [base : i64]
  [label-prefix : String]) : ir.CompilerIrInstrSeq
  (match (let
    [source-spans (ir.compiler-source-spans-empty)]
    (opt.opt-inline-expand-instrs-with-spans
      instrs
      dst
      ret
      sa
      np
      base
      label-prefix
      source-spans
      (ir.compiler-source-spans-empty)
      0
      (opt-test-inline-no-span-call)
      0))
    [(State expanded _ _ _) expanded]))

;; Keep an inliner rewrite only when its caller still has a valid structure.
(define (opt-test-inline-revert-or-keep
  [fallback : (& fallback ir.CompilerIrFunction)]
  [next : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (ir.compiler-ir-global-shared-view next)
    [(Function _ _ _ _ blocks _)
      (if (opt.opt-inline-structure-ok? (& blocks))
        next
        (owned_view.compiler-owned-reference-shared-view fallback))]))

(define (opt-bg-test-plan
  [block : i64]
  [ok : i64]
  [slow : i64]
  [pre : i64]
  [marker : i64]) : opt.OptBgPlan
  (let
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 1)]
    (ir.compiler-ir-instr-builder-push!
      (&mut builder)
      (ir.CompilerIrInstr.Mov marker (I64 marker) (I64)))
    (opt.OptBgPlan
      block
      ok
      slow
      pre
      0
      marker
      marker
      (I64 marker)
      (__tl_make-array bool 0)
      (ir.compiler-ir-instr-builder-to-seq builder)
      (ir.compiler-ir-instr-seq-empty)
      0
      (- 0 1)
      false)))

(define (opt-bg-test-slow-label-order?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [expected : i64]
  [remaining : i64]) : bool
  (match blocks
    [(slice) (= remaining 0)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block label _)
          (and
            (> remaining 0)
            (= label expected)
            (opt-bg-test-slow-label-order? rest (- expected 1) (- remaining 1)))])]))

(define (opt-bg-test-relabel-order? [inputs : ir.CompilerIrPhiInputSeq]) : bool
  (let
    [phi-inputs-at-103173-5 : ir.CompilerIrPhiInputSeq inputs]
    (if (<= phi-inputs-at-103173-5.len 0)
      false
      (let
        [phi-input-at-103173-5 : ir.CompilerIrPhiInput
          (ir.compiler-ir-phi-input-seq-ref phi-inputs-at-103173-5 0)]
        [first : i64 phi-input-at-103173-5.label]
        [rest : ir.CompilerIrPhiInputSeq
          (ir.CompilerIrPhiInputSeq
            phi-inputs-at-103173-5.slots
            (+ phi-inputs-at-103173-5.start 1)
            (- phi-inputs-at-103173-5.len 1))]
        (and
          (= first 200)
          (let
            [phi-inputs-at-103177-11 : ir.CompilerIrPhiInputSeq rest]
            (if (<= phi-inputs-at-103177-11.len 0)
              false
              (let
                [phi-input-at-103177-11 : ir.CompilerIrPhiInput
                  (ir.compiler-ir-phi-input-seq-ref phi-inputs-at-103177-11 0)]
                [second : i64 phi-input-at-103177-11.label]
                [tail : ir.CompilerIrPhiInputSeq
                  (ir.CompilerIrPhiInputSeq
                    phi-inputs-at-103177-11.slots
                    (+ phi-inputs-at-103177-11.start 1)
                    (- phi-inputs-at-103177-11.len 1))]
                (and
                  (= second 208)
                  (let
                    [phi-inputs-at-103182-17 : ir.CompilerIrPhiInputSeq tail]
                    (if (<= phi-inputs-at-103182-17.len 0)
                      true
                      false)))))))))))

(test
  optimizer-bounds-group-plan-dense-storage-grows-and-preserves-rewrite-order
  (let
    [empty : opt.OptBgPlanList (Nil)]
    [retained : opt.OptBgPlanList
      (opt.opt-bg-plan-list-prepend
        (opt-bg-test-plan 44 144 244 77 44)
        (opt.compiler-opt-global-shared-view empty))]
    [two : opt.OptBgPlanList
      (opt.opt-bg-plan-list-prepend
        (opt-bg-test-plan 45 145 245 77 45)
        (opt.compiler-opt-global-shared-view retained))]
    ;; Branch from the retained prefix after `two` extended its shared
    ;; backing store. The high-water marker must protect both views.
    [branched : opt.OptBgPlanList
      (opt.opt-bg-plan-list-prepend
        (opt-bg-test-plan 46 146 246 77 46)
        (opt.compiler-opt-global-shared-view retained))]
    [duplicate : opt.OptBgPlanList
      (opt.opt-bg-plan-list-prepend
        (opt-bg-test-plan 44 145 345 77 145)
        (opt.compiler-opt-global-shared-view retained))]
    [plans : opt.OptBgPlanList (Nil)]
    [cursor : i64 0]
    (test.assert-i64-eq
      (opt.opt-bg-plan-list-count empty)
      0
      "bounds-group empty plan storage")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of empty 91)
      91
      "bounds-group empty lookup keeps the label")
    (match (opt.opt-bg-plan-for empty 91)
      [(No) unit]
      [_ (test.assert-true false "bounds-group empty lookup has no plan")])
    (test.assert-i64-eq
      (opt.opt-bg-plan-list-count retained)
      1
      "bounds-group retained singleton length")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of retained 44)
      144
      "bounds-group retained singleton value")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of retained 45)
      45
      "bounds-group retained singleton excludes later extension")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of two 45)
      145
      "bounds-group first retained branch survives")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of branched 46)
      146
      "bounds-group second retained branch survives")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of two 46)
      46
      "bounds-group sibling branches stay independent")
    (test.assert-i64-eq
      (opt.opt-bg-plan-ok-of duplicate 44)
      145
      "bounds-group newest duplicate plan wins")
    (while (< cursor 9)
      (set!
        plans
        (opt.opt-bg-plan-list-prepend
          (opt-bg-test-plan cursor (+ cursor 200) (+ cursor 100) 77 cursor)
          plans))
      (set! cursor (+ cursor 1)))
    (match (opt.compiler-opt-global-shared-view plans)
      [(Nil) (test.assert-true false "bounds-group plan storage is non-empty")]
      [(Dense items extent len)
        (test.assert-i64-eq len 9 "bounds-group plan storage length")
        (test.assert-i64-eq
          (array-ref extent 0)
          9
          "bounds-group plan high-water length")
        (test.assert-true
          (>= (array-length items) 9)
          "bounds-group plan storage grows past eight")])
    (test.assert-i64-eq
      (opt.opt-bg-plan-list-ref plans 0).block
      8
      "bounds-group newest plan stays first")
    (test.assert-i64-eq
      (opt.opt-bg-plan-list-ref plans 8).block
      0
      "bounds-group oldest plan stays last")
    (let
      [hoisted : ir.CompilerIrInstrSeq (opt.opt-bg-hoisted-for-label plans 77)]
      [inputs : ir.CompilerIrPhiInputSeq
        (ir.compiler-ir-phi-input-seq-prepend
          (I64 10)
          0
          (&
            (ir.compiler-ir-phi-input-seq-prepend
              (I64 11)
              8
              (& (ir.compiler-ir-phi-input-seq-empty)))))]
      (test.assert-i64-eq
        (ir.compiler-ir-instr-seq-count hoisted)
        9
        "bounds-group multiple hoists share one preheader")
      (match (ir.compiler-ir-instr-seq-ref hoisted 0)
        [(Mov dst _ _)
          (test.assert-i64-eq dst 8 "bounds-group newest hoist stays first")]
        [_ (test.assert-true false "bounds-group first hoist shape")])
      (match (ir.compiler-ir-instr-seq-ref hoisted 8)
        [(Mov dst _ _)
          (test.assert-i64-eq dst 0 "bounds-group oldest hoist stays last")]
        [_ (test.assert-true false "bounds-group last hoist shape")])
      (test.assert-true
        (opt-bg-test-relabel-order? (opt.opt-bg-relabel-inputs inputs plans))
        "bounds-group lookup relabels multiple split blocks in phi order")
      (test.assert-true
        (let
          [walked-blocks : ir.CompilerIrBlockList
            (opt.opt-bg-slow-blocks plans)]
          (opt-bg-test-slow-label-order?
            (ir.compiler-ir-block-list-view walked-blocks)
            108
            9))
        "bounds-group slow blocks keep deterministic newest-first order"))))

(define (opt-sccp-blocks-with-context-result
  [type-segment-bases : i64]
  [context : opt.OptCfgContext]
  [params : ir.CompilerIrParamSeq]
  [blocks : ir.CompilerIrBlockList]) : opt.OptBlockCtxResult
  (match (opt.opt-sccp-analyze
    type-segment-bases
    (& context)
    (& params)
    (& blocks))
    [(State _ _ env _ _)
      (if (opt.opt-sccp-env-any-const? env 0)
        (opt.opt-cfg-simplify-blocks-with-context-result
          (Result
            (opt.opt-sccp-rewrite-blocks (& env) (& blocks))
            context
            (not (opt.opt-sccp-blocks-change-successors? (& env) blocks))))
        ;; No constants: the rewrite is the identity and no branch condition
        ;; can have folded to a literal, so the context is valid as-is.
        (opt.opt-cfg-simplify-blocks-with-context-result
          (Result blocks context true)))]))

(define (opt-gvn-blocks-with-context-and-call-memory
  [profile-state : profile_state.CompilerProfileMetrics]
  [type-segment-bases : i64]
  [context : opt.OptCfgContext]
  [params : ir.CompilerIrParamSeq]
  [call-memory : opt_i64_i64_map.Map]
  [cells : opt.OptGlobalCellSummary]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match (opt.opt-gvn-blocks-with-context-and-call-memory-result
    profile-state
    type-segment-bases
    (& context)
    (& params)
    (& call-memory)
    cells
    0
    (& blocks))
    [(Result out-blocks _) out-blocks]))

(define (opt-gvn-blocks
  [type-segment-bases : i64]
  [params : ir.CompilerIrParamSeq]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (opt-gvn-blocks-with-context-and-call-memory
    (profile_state.compiler-profile-state-metrics
      (profile_state.compiler-profile-state-new))
    type-segment-bases
    (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
    params
    (opt_i64_i64_map.with-capacity 1)
    (opt.opt-global-cell-summary-empty)
    blocks))

(define (opt-alias-run-from
  [facts : opt.OptAliasFacts]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : opt.OptAliasFacts
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    facts
    (opt-alias-run-from
      (opt.opt-alias-update-facts
        (& facts)
        (& (ir.compiler-ir-instr-seq-ref instrs index)))
      instrs
      (+ index 1))))

(define (opt-alias-run
  [facts : opt.OptAliasFacts]
  [instrs : ir.CompilerIrInstrSeq]) : opt.OptAliasFacts
  (opt-alias-run-from facts instrs 0))

(define (opt-scratch-scope-scan-instrs
  [type-segment-bases : i64]
  [state : opt.OptScratchScopeState]
  [instrs : ir.CompilerIrInstrSeq]) : opt.OptScratchScopeState
  (opt.opt-scratch-scope-scan-instr-seq-from
    type-segment-bases
    state
    (& instrs)
    0))

(define (opt-scratch-scope-report-instrs
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]) : opt.OptScratchScopeReport
  (opt.opt-scratch-scope-report-from-state
    (opt-scratch-scope-scan-instrs
      type-segment-bases
      (opt.opt-scratch-state-initial)
      instrs)))

(define (opt-scratch-report-candidate?
  [report : opt.OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]) : bool
  (match report
    [(Report allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (opt.opt-scratch-blocker-none? blocker))]))

(define (opt-scratch-report-blocked?
  [_type-segment-bases : i64]
  [report : opt.OptScratchScopeReport]
  [expected-allocs : i64]
  [expected-bytes : i64]
  [reason : String]) : bool
  (match report
    [(Report allocs bytes blocker)
      (and
        (= allocs expected-allocs)
        (= bytes expected-bytes)
        (match blocker
          [(Blocked found) (string.eq found reason)]
          [(NoBlocker) false]))]))

(define (opt-scratch-reset-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt.compiler-opt-global-shared-view func)
    [(Function _ _ _ _ blocks _)
      (match (opt.opt-scratch-reset-function-with-context-result
        type-segment-bases
        (& (opt.opt-cfg-context-build blocks))
        false
        (& func))
        [(Result next _) next])]))

(define (opt-scratch-reset-pre-ssa-function-with-context-result
  [pools : ast.AstNodePoolContext]
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : opt.OptFunctionCtxResult
  (match func
    [(Function name params ret-ty frame blocks function-abi)
      (let
        [context : opt.OptCfgContext
          (opt.opt-cfg-context-build
            (ir.compiler-ir-clone-block-list pools (& blocks)))]
        [input : ir.CompilerIrFunction
          (Function name params ret-ty frame blocks function-abi)]
        [preheaders-result : opt.OptFunctionCtxResult
          (opt.opt-loop-preheaders-function-with-context-result
            context
            false
            input)]
        [preheaders : ir.CompilerIrFunction
          (match (opt.compiler-opt-global-shared-view preheaders-result)
            [(Result f _) f])]
        [preheaders-context : opt.OptCfgContext
          (match preheaders-result
            [(Result _ ctx) ctx])]
        (opt.opt-scratch-reset-function-with-context-result
          type-segment-bases
          (& preheaders-context)
          false
          (& preheaders)))]))

(test
  value-source-counts-dense-semantics
  (let
    [sources : opt.OptValueSources (opt.opt-value-sources-new)]
    [independent : opt.OptValueSources (opt.opt-value-sources-new)]
    (set! sources (opt.opt-gvn-defs-add sources -1))
    (set! sources (opt.opt-gvn-defs-add sources 0))
    ;; Grow repeatedly, preserving both definitions and the candidate count.
    (set! sources (opt.opt-gvn-defs-add sources 15))
    (set! sources (opt.opt-gvn-defs-add sources 512))
    (set! sources (opt.opt-gvn-defs-add sources 0))
    (test.assert-i64-eq
      (opt.opt-gvn-count sources -1)
      1
      "growth preserves the expression candidate count")
    (test.assert-i64-eq
      (opt.opt-gvn-count sources 0)
      2
      "multiple definitions prevent reuse")
    (test.assert-true
      (not (opt.opt-gvn-stable-var? sources 0))
      "a reassigned parameter is not stable")
    (test.assert-true
      (opt.opt-gvn-stable-var? sources 15)
      "the former capacity boundary retains its definition")
    (test.assert-true
      (opt.opt-gvn-stable-var? sources 512)
      "a new large value id is stable")
    (test.assert-i64-eq
      (opt.opt-gvn-count sources 511)
      0
      "unwritten grown slots are absent")
    (test.assert-i64-eq
      (opt.opt-gvn-count sources 9223372036854775807)
      0
      "out-of-range reads cannot overflow the slot calculation")
    (test.assert-i64-eq
      (opt.opt-gvn-count independent 0)
      0
      "function inventories are independent")))

(test
  switch-copy-env-indexed-semantics
  (let
    [env : opt.OptSwitchCopyEnv (Empty)]
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 12)
      12
      "a missing destination resolves to itself")
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env (- 0 1))
      (- 0 1)
      "a negative sentinel stays out of the dense table")
    (set!
      env
      (opt.opt-switch-copy-env-note env (& (irt.instr "%64 = mov %7 : i64"))))
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 64)
      7
      "a high destination grows the direct table")
    (set!
      env
      (opt.opt-switch-copy-env-note env (& (irt.instr "%64 = mov %8 : i64"))))
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 64)
      8
      "the newest destination binding replaces the old source")
    (set!
      env
      (opt.opt-switch-copy-env-note env (& (irt.instr "%65 = mov %8 : i64"))))
    (set!
      env
      (opt.opt-switch-copy-env-note env (& (irt.instr "%70 = mov %9 : i64"))))
    (set!
      env
      (opt.opt-switch-copy-env-note env (& (irt.instr "%8 = mov 0 : i64"))))
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 64)
      64
      "redefining a source drops the first dependent destination")
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 65)
      65
      "source invalidation drops every dependent destination")
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 70)
      9
      "source invalidation preserves unrelated destinations")
    (set!
      env
      (opt.opt-switch-copy-env-note env (& (irt.instr "%70 = mov 0 : i64"))))
    (test.assert-i64-eq
      (opt.opt-switch-copy-env-resolve env 70)
      70
      "a non-copy destination redefinition drops its stale fact")))

;; A total, order-free reading of one pointer-provenance class, so the test
;; below can assert the class a var carries as a single integer.
(define (opt-licm-ptr-kind-code [kind : opt.OptLicmPtrKind]) : i64
  (match kind
    [(Unknown) 0]
    [(HeaderSlot object) (+ 1000 object)]
    [(DataSlot object) (+ 2000 object)]
    [(DataBuffer object) (+ 3000 object)]
    [(DataElement object) (+ 4000 object)]
    [(LocalObject object) (+ 5000 object)]
    [_ (- 0 1)]))

;; LICM's pointer-provenance environment, as the recorded bind / lookup / rebind
;; / unbind sequence its consumers actually perform. The table is var-indexed,
;; so the contract has to be stated rather than inherited from a list's shape.
;;
;; The two clauses worth naming: a rebind REPLACES a var's class instead of
;; shadowing it, so unbinding once leaves the var unbound rather than uncovering
;; an older binding; and binding `Unknown` RETIRES a class rather than recording
;; one, which is how the walk invalidates a redefined var.
(test
  licm-ptr-env-indexed-semantics
  (let
    [env : opt.OptLicmPtrEnv (opt.opt-licm-ptr-env-new)]
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 3))
      0
      "a never-bound var reads Unknown")
    (test.assert-true
      (not (opt.opt-licm-ptr-env-bound? (& env) 3))
      "a never-bound var is not bound")
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env (- 0 1)))
      0
      "a negative sentinel stays out of the dense table")
    (set! env (opt.opt-licm-ptr-bind env 3 (DataSlot 7)))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 3))
      2007
      "a bound var reads back its class")
    (test.assert-true
      (opt.opt-licm-ptr-env-bound? (& env) 3)
      "a bound var is bound")
    (set! env (opt.opt-licm-ptr-bind env 64 (DataBuffer 9)))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 64))
      3009
      "a high var grows the direct table")
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 3))
      2007
      "growing the table preserves every earlier binding")
    (set! env (opt.opt-licm-ptr-bind env 3 (DataElement 11)))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 3))
      4011
      "rebinding a var replaces its class")
    (set! env (opt.opt-licm-ptr-unbind env 3))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 3))
      0
      "one unbind leaves a rebound var unbound: the rebind replaced, it did not shadow")
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 64))
      3009
      "unbinding one var preserves the others")
    (set! env (opt.opt-licm-ptr-unbind env 3))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 3))
      0
      "unbinding an already-unbound var is a no-op")
    (set! env (opt.opt-licm-ptr-bind env 5 (Unknown)))
    (test.assert-true
      (not (opt.opt-licm-ptr-env-bound? (& env) 5))
      "binding Unknown records nothing")
    (set! env (opt.opt-licm-ptr-bind env 5 (LocalObject 5)))
    (set! env (opt.opt-licm-ptr-bind env 5 (Unknown)))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 5))
      0
      "binding Unknown retires the class a var carried")
    (set! env (opt.opt-licm-ptr-unbind-bound (& env) 4096))
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 4096))
      0
      "unbinding a var past the table does not grow it")
    (test.assert-i64-eq
      (opt-licm-ptr-kind-code (opt.opt-licm-ptr-lookup env 64))
      3009
      "an out-of-range unbind leaves the table alone")))

(test
  bounds-cast-env-indexed-semantics
  (let
    [env : opt.OptBoundsCastEnv (Empty)]
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 12)))
        (& (Var 12)))
      "a missing destination canonicalizes to itself")
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var (- 0 1))))
        (& (Var (- 0 1))))
      "a negative var stays out of the dense table")
    (set! env (opt.opt-bounds-cast-bind (& env) 64 (Var 7)))
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 64)))
        (& (Var 7)))
      "a high destination grows the direct table")
    (set! env (opt.opt-bounds-cast-bind (& env) 64 (Var 8)))
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 64)))
        (& (Var 8)))
      "the newest destination binding replaces the old source")
    (set! env (opt.opt-bounds-cast-bind (& env) 65 (Var 8)))
    (set! env (opt.opt-bounds-cast-bind (& env) 70 (Var 9)))
    (set! env (opt.opt-bounds-cast-unbind env 8))
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 64)))
        (& (Var 64)))
      "source invalidation drops the first dependent destination")
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 65)))
        (& (Var 65)))
      "source invalidation drops every dependent destination")
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 70)))
        (& (Var 9)))
      "source invalidation preserves unrelated destinations")
    (set! env (opt.opt-bounds-cast-bind (& env) 512 (I64 33)))
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 512)))
        (& (I64 33)))
      "table growth preserves non-var sources")
    (set! env (opt.opt-bounds-cast-bind (& env) 71 (Var 70)))
    (set! env (opt.opt-bounds-cast-unbind env 70))
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 70)))
        (& (Var 70)))
      "destination invalidation drops its stale binding")
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 71)))
        (& (Var 71)))
      "destination invalidation also drops its dependents")
    (test.assert-true
      (opt.opt-value-eq
        (& (opt.opt-bounds-cast-canon env (Var 512)))
        (& (I64 33)))
      "compaction preserves later unrelated destinations")))

;; #6061: force every converted dense family past its initial capacity and
;; pin their logical newest-first/LIFO semantics.
(define (opt-dense-test-licm-roots
  [roots : opt.OptLicmStoreRootList]
  [next : i64]
  [last : i64]) : opt.OptLicmStoreRootList
  (if (> next last)
    roots
    (opt-dense-test-licm-roots
      (opt.opt-licm-store-roots-add roots (Fresh next))
      (+ next 1)
      last)))

(define (opt-dense-test-unroll-memories
  [type-segment-bases : i64]
  [memories : opt.OptUnrollSimdMemoryList]
  [next : i64]
  [last : i64]) : opt.OptUnrollSimdMemoryList
  (if (> next last)
    memories
    (opt-dense-test-unroll-memories
      type-segment-bases
      (opt.opt-unroll-simd-memory-add
        type-segment-bases
        memories
        (Var next)
        (I64))
      (+ next 1)
      last)))

(define (opt-dense-test-reach-push
  [worklist : opt.OptReachWorklist]
  [next : i64]
  [last : i64]) : opt.OptReachWorklist
  (if (> next last)
    worklist
    (opt-dense-test-reach-push
      (opt.opt-reach-worklist-push worklist next)
      (+ next 1)
      last)))

(define (opt-dense-test-reach-pop-order?
  [worklist : opt.OptReachWorklist]
  [expected : i64]) : bool
  (match (opt.opt-reach-worklist-pop (& worklist))
    [(Empty) (< expected 0)]
    [(Item found rest)
      (and
        (= found expected)
        (opt-dense-test-reach-pop-order? rest (- expected 1)))]))

(define (opt-dense-test-reach-reuse?) : bool
  (match (opt.opt-reach-worklist-pop
    (& (opt-dense-test-reach-push (opt.opt-reach-worklist-new) 0 20)))
    [(Empty) false]
    [(Item found rest)
      (if (= found 20)
        (match (opt.opt-reach-worklist-pop
          (& (opt.opt-reach-worklist-push rest 99)))
          [(Empty) false]
          [(Item reused tail)
            (and (= reused 99) (opt-dense-test-reach-pop-order? tail 19))])
        false)]))

(define (opt-dense-test-scratch-roots
  [roots : opt.OptScratchRootList]
  [next : i64]
  [last : i64]) : opt.OptScratchRootList
  (if (> next last)
    roots
    (opt-dense-test-scratch-roots
      (opt.opt-scratch-root-list-add roots next)
      (+ next 1)
      last)))

;; Dense fact `next` of kind 0 (copy), 1 (expression) or 2 (pack word), with
;; `next` in every number.
(define (opt-dense-test-global-fact [kind : i64] [next : i64]) : opt.OptGlobalFact
  (cond
    [(= kind 0) (Copy next (I64 next) 0 next)]
    [(= kind 1) (Expr (MovKey (I64 next) (I64)) next 0 next)]
    [else (PackWord next next (I64 next) 0 next)]))

(define (opt-global-facts-push
  [facts : opt.OptGlobalFacts]
  [fact : opt.OptGlobalFact]) : opt.OptGlobalFacts
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (opt_global_fact_vec.push-ref! (&mut items) fact)
    (opt.OptGlobalFacts items)))

(define (opt-dense-test-global-facts
  [kind : i64]
  [facts : opt.OptGlobalFacts]
  [next : i64]
  [last : i64]) : opt.OptGlobalFacts
  (if (> next last)
    facts
    (opt-dense-test-global-facts
      kind
      (opt-global-facts-push facts (opt-dense-test-global-fact kind next))
      (+ next 1)
      last)))

;; Whether fact `index` of `facts` is dense fact `expected`.
(define (opt-dense-test-global-fact-is?
  [facts : (& facts opt.OptGlobalFacts)]
  [index : i64]
  [expected : i64]) : bool
  (let
    [items : opt_global_fact_vec.Vec facts.items]
    (match (clone (array-ref (opt_global_fact_vec.slots (& items)) index))
      [(Copy dst src _ _)
        (and
          (= dst expected)
          (match src
            [(I64 value) (= value expected)]
            [_ false]))]
      [(Expr _ dst _ _) (= dst expected)]
      [(PackWord group word-index value _ _)
        (and
          (= group expected)
          (= word-index expected)
          (match value
            [(I64 found) (= found expected)]
            [_ false]))])))

(define (opt-dense-test-var-def-index-is?
  [defs : (& defs (__tl_dyn-array opt.OptMaybeVarDef))]
  [var : i64]
  [expected-block : i64]
  [expected-pos : i64]) : bool
  (match (opt.opt-var-def-lookup defs var)
    [(No) false]
    [(Some def)
      (match def
        [(Def found block pos)
          (and (= found var) (= block expected-block) (= pos expected-pos))])]))

(define (opt-dense-test-var-def-index-empty?
  [defs : (__tl_dyn-array opt.OptMaybeVarDef)]
  [var : i64]) : bool
  (match (opt.opt-var-def-lookup defs var)
    [(No) true]
    [(Some _) false]))

(define (opt-dense-test-gvn-scope-push
  [type-segment-bases : i64]
  [table : (& table opt.OptGvnMap)]
  [changes : opt.OptGvnScopeChanges]
  [next : i64]
  [last : i64]) : opt.OptGvnScopeChanges
  (if (> next last)
    changes
    (opt-dense-test-gvn-scope-push
      type-segment-bases
      table
      (opt.opt-gvn-table-push!
        type-segment-bases
        table
        (Entry (BinKey (Add) (I64 next) (I64 0) (I64)) next 0)
        (& changes))
      (+ next 1)
      last)))

(define (opt-dense-test-gvn-scope-rollback? [type-segment-bases : i64]) : bool
  (let
    [table : opt.OptGvnMap (opt-gvn-map-empty 16)]
    [changes : opt.OptGvnScopeChanges
      (opt-dense-test-gvn-scope-push
        type-segment-bases
        table
        (opt.opt-gvn-scope-changes-new)
        1
        16)]
    [last-key : opt.OptExprKey (BinKey (Add) (I64 16) (I64 0) (I64))]
    [before : i64 (opt.opt-gvn-lookup type-segment-bases table (& last-key))]
    (opt.opt-gvn-table-restore! table (& changes))
    (and
      (= (opt-gvn-scope-changes-count changes) 16)
      (= before 16)
      (= (opt.opt-gvn-lookup type-segment-bases table (& last-key)) (- 0 1)))))

(define (opt-dense-test-ssa-sites
  [sites : opt.OptSsaPhiSites]
  [next : i64]
  [last : i64]) : opt.OptSsaPhiSites
  (if (> next last)
    sites
    (opt-dense-test-ssa-sites
      (opt.opt-ssa-phi-sites-prepend sites next (+ 100 next) (I64) (+ 200 next))
      (+ next 1)
      last)))

(define (opt-dense-test-ssa-site-is?
  [sites : (& sites opt.OptSsaPhiSites)]
  [index : i64]
  [expected : i64]) : bool
  (match (opt.opt-ssa-phi-sites-ref sites index)
    [(PhiSite var label _ phi-var)
      (and
        (= var expected)
        (= label (+ 100 expected))
        (= phi-var (+ 200 expected)))]
    [_ false]))

(define (opt-dense-test-ssa-rename-blocks
  [blocks : opt.OptSsaRenameBlocks]
  [next : i64]
  [last : i64]) : opt.OptSsaRenameBlocks
  (if (> next last)
    blocks
    (let
      [empty : ir.CompilerIrInstrSeq (ir.compiler-ir-instr-seq-empty)]
      (opt-dense-test-ssa-rename-blocks
        (opt-ssa-rename-blocks-prepend blocks next (& empty))
        (+ next 1)
        last))))

(define (opt-dense-test-ssa-rename-block-newest?
  [blocks : (& blocks opt.OptSsaRenameBlocks)]) : bool
  (match (opt.opt-ssa-rename-blocks-ref blocks 0)
    [(RenameBlock label instrs)
      (and
        (= label 4)
        (= (ir.compiler-ir-instr-seq-count instrs) 1)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(Return _) true]
          [_ false]))]
    [_ false]))

(define (opt-dense-test-ssa-rename-block-is?
  [blocks : (& blocks opt.OptSsaRenameBlocks)]
  [index : i64]
  [expected-label : i64]) : bool
  (match (opt.opt-ssa-rename-blocks-ref blocks index)
    [(RenameBlock label _) (= label expected-label)]
    [_ false]))

(define (opt-dense-test-ssa-block-outs
  [outs : opt.OptSsaBlockOuts]
  [next : i64]
  [last : i64]) : opt.OptSsaBlockOuts
  (if (> next last)
    outs
    (opt-dense-test-ssa-block-outs
      (opt.opt-ssa-block-outs-prepend
        outs
        next
        (&
          (opt.opt-ssa-env-bind
            (opt.opt-ssa-env-register
              (opt.opt-ssa-env-with-capacity (+ next 1) 1 1)
              next)
            next
            (+ 1000 next))))
      (+ next 1)
      last)))

(define (opt-dense-test-ssa-block-out-newest?
  [outs : (& outs opt.OptSsaBlockOuts)]) : bool
  (match (opt.opt-ssa-env-snapshot-lookup
    (& (opt.opt-ssa-block-out-lookup outs 4))
    99)
    [(Some current) (= current 123)]
    [(None) false]))

(define (opt-dense-test-ssa-block-out-is?
  [outs : (& outs opt.OptSsaBlockOuts)]
  [index : i64]
  [expected-label : i64]) : bool
  (match (opt.opt-ssa-block-outs-ref outs index)
    [(BlockOut label _) (= label expected-label)]
    [_ false]))

(define (opt-dense-test-ssa-env-register-range
  [env : opt.OptSsaRenameEnv]
  [next : i64]
  [last : i64]) : opt.OptSsaRenameEnv
  (if (> next last)
    env
    (opt-dense-test-ssa-env-register-range
      (opt.opt-ssa-env-register env next)
      (+ next 1)
      last)))

(define (opt-dense-test-ssa-env-bind-range
  [env : opt.OptSsaRenameEnv]
  [next : i64]
  [last : i64]) : opt.OptSsaRenameEnv
  (if (> next last)
    env
    (opt-dense-test-ssa-env-bind-range
      (opt.opt-ssa-env-bind env next (+ 100 next))
      (+ next 1)
      last)))

(define (opt-dense-test-ssa-env-value?
  [env : (& env opt.OptSsaRenameEnv)]
  [var : i64]
  [expected : i64]) : bool
  (match (opt.opt-ssa-env-lookup env var)
    [(Some current) (= current expected)]
    [(None) false]))

(define (opt-dense-test-ssa-env-missing?
  [env : (& env opt.OptSsaRenameEnv)]
  [var : i64]) : bool
  (match (opt.opt-ssa-env-lookup env var)
    [(Some _) false]
    [(None) true]))

(define (opt-dense-test-ssa-snapshot-value?
  [outs : (& outs opt.OptSsaBlockOuts)]
  [label : i64]
  [var : i64]
  [expected : i64]) : bool
  (match (opt.opt-ssa-env-snapshot-lookup
    (& (opt.opt-ssa-block-out-lookup outs label))
    var)
    [(Some current) (= current expected)]
    [(None) false]))

(define (opt-dense-test-ssa-snapshot-missing?
  [outs : opt.OptSsaBlockOuts]
  [label : i64]
  [var : i64]) : bool
  (match (opt.opt-ssa-env-snapshot-lookup
    (& (opt.opt-ssa-block-out-lookup outs label))
    var)
    [(Some _) false]
    [(None) true]))

(define (opt-dense-test-ssa-env-indexed-rollback?) : bool
  (let
    ;; Thirteen registered candidates cross the former small fixture sizes.
    ;; The first twelve are live at the checkpoint; var 12 distinguishes an
    ;; absent registered slot from an unregistered/out-of-range vreg.
    [registered : opt.OptSsaRenameEnv
      (opt-dense-test-ssa-env-register-range
        (opt.opt-ssa-env-with-capacity 16 13 20)
        0
        12)]
    [registered-count : i64 registered.entry-count]
    [base : opt.OptSsaRenameEnv
      (opt-dense-test-ssa-env-bind-range registered 0 11)]
    [checkpoint : i64 (opt.opt-ssa-env-checkpoint base)]
    [branch-a : opt.OptSsaRenameEnv
      (opt.opt-ssa-env-bind (opt.opt-ssa-env-bind base 3 303) 12 312)]
    [outs-a : opt.OptSsaBlockOuts
      (opt.opt-ssa-block-outs-prepend (opt-ssa-block-outs-new) 10 (& branch-a))]
    [restored : opt.OptSsaRenameEnv
      (opt.opt-ssa-env-rollback branch-a checkpoint)]
    [restored-ok? : bool
      (and
        (opt-dense-test-ssa-env-value? restored 0 100)
        (opt-dense-test-ssa-env-value? restored 3 103)
        (opt-dense-test-ssa-env-value? restored 11 111)
        (opt-dense-test-ssa-env-missing? restored 12)
        (opt-dense-test-ssa-env-missing? restored 15)
        (opt-dense-test-ssa-env-missing? restored (- 0 1))
        (opt-dense-test-ssa-env-missing? restored 16))]
    [branch-b : opt.OptSsaRenameEnv
      (opt.opt-ssa-env-bind (opt.opt-ssa-env-bind restored 3 403) 12 412)]
    [outs : opt.OptSsaBlockOuts
      (opt.opt-ssa-block-outs-prepend outs-a 20 (& branch-b))]
    (and
      (= checkpoint 12)
      (= registered-count 13)
      restored-ok?
      (opt-dense-test-ssa-snapshot-value? outs 10 3 303)
      (opt-dense-test-ssa-snapshot-value? outs 10 12 312)
      (opt-dense-test-ssa-snapshot-value? outs 20 3 403)
      (opt-dense-test-ssa-snapshot-value? outs 20 12 412)
      (opt-dense-test-ssa-snapshot-missing? outs 99 3))))

(define (opt-dense-test-ssa-var-block-index) : opt.OptCfgIndex
  (opt.opt-cfg-index-build
    (&
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "dense_ssa_defs_a")
          (ir.compiler-ir-instr-seq-empty))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "dense_ssa_defs_b")
          (ir.compiler-ir-instr-seq-empty))))))

(define (opt-dense-test-ssa-var-blocks-fill
  [index : (& index opt.OptCfgIndex)]
  [blocks : opt.OptSsaVarBlocks]
  [label : i64]
  [var : i64]) : opt.OptSsaVarBlocks
  (if (> var 9)
    blocks
    (opt-dense-test-ssa-var-blocks-fill
      index
      (if (or (= var 1) (= var 4) (= var 8))
        blocks
        (opt.opt-ssa-var-blocks-add index blocks var label))
      label
      (+ var 1))))

(define (opt-dense-test-ssa-var-blocks [index : (& index opt.OptCfgIndex)]) : opt.OptSsaVarBlocks
  (let
    [label-a : i64 (ir.compiler-ir-label "dense_ssa_defs_a")]
    [label-b : i64 (ir.compiler-ir-label "dense_ssa_defs_b")]
    [unknown : i64 (ir.compiler-ir-label "dense_ssa_defs_unknown")]
    (opt-dense-test-ssa-var-blocks-fill
      index
      (opt.opt-ssa-var-blocks-add
        index
        (opt.opt-ssa-var-blocks-add
          index
          (opt.opt-ssa-var-blocks-add
            index
            (opt.opt-ssa-var-blocks-add
              index
              (opt.opt-ssa-var-blocks-with-capacity 10 10)
              8
              label-b)
            8
            label-a)
          8
          label-b)
        1
        unknown)
      label-b
      0)))

(define (compiler-optimize-dense-storage-self-test) : i64
  (let
    [type-segment-bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [licm : opt.OptLicmStoreRootList
      (opt-dense-test-licm-roots (opt.opt-licm-store-roots-new) 1 8)]
    [memories : opt.OptUnrollSimdMemoryList
      (opt-dense-test-unroll-memories
        type-segment-bases
        (opt.opt-unroll-simd-memory-new)
        1
        8)]
    [memory-count : i64 (opt.opt-unroll-simd-memory-count memories)]
    [newest-index : i64
      (opt.opt-unroll-simd-memory-index
        type-segment-bases
        memories
        (& (Var 8))
        (& (I64))
        0)]
    [oldest-index : i64
      (opt.opt-unroll-simd-memory-index
        type-segment-bases
        memories
        (& (Var 1))
        (& (I64))
        0)]
    [deduped : opt.OptUnrollSimdMemoryList
      (opt.opt-unroll-simd-memory-add type-segment-bases memories (Var 4) (I64))]
    [deduped-count : i64 (opt.opt-unroll-simd-memory-count deduped)]
    [typed : opt.OptUnrollSimdMemoryList
      (opt.opt-unroll-simd-memory-add type-segment-bases deduped (Var 1) (U64))]
    [roots : opt.OptScratchRootList
      (opt-dense-test-scratch-roots (opt.opt-scratch-root-list-new) 1 32)]
    [global-copy : opt.OptGlobalFacts
      (opt-dense-test-global-facts 0 (opt.opt-global-facts-new) 1 8)]
    [global-expr : opt.OptGlobalFacts
      (opt-dense-test-global-facts 1 (opt.opt-global-facts-new) 1 8)]
    [global-pack-word : opt.OptGlobalFacts
      (opt-dense-test-global-facts 2 (opt.opt-global-facts-new) 1 8)]
    [ssa-sites : opt.OptSsaPhiSites
      (opt.opt-ssa-phi-sites-prepend
        (opt-dense-test-ssa-sites (opt.opt-ssa-phi-sites-new) 1 8)
        4
        104
        (I64)
        204)]
    [ssa-sites-empty : opt.OptSsaPhiSites (opt.opt-ssa-phi-sites-new)]
    [ssa-renamed-independent : opt.OptSsaRenameBlocks
      (opt-ssa-rename-blocks-new)]
    [ssa-renamed-body : ir.CompilerIrInstrSeq
      (ir.compiler-ir-instr-seq1 (Return (No)))]
    [ssa-renamed : opt.OptSsaRenameBlocks
      (opt-ssa-rename-blocks-prepend
        (opt-dense-test-ssa-rename-blocks (opt-ssa-rename-blocks-new) 1 8)
        4
        (& ssa-renamed-body))]
    [ssa-outs-independent : opt.OptSsaBlockOuts (opt-ssa-block-outs-new)]
    [ssa-outs : opt.OptSsaBlockOuts
      (opt.opt-ssa-block-outs-prepend
        (opt-dense-test-ssa-block-outs (opt-ssa-block-outs-new) 1 8)
        4
        (&
          (opt.opt-ssa-env-bind
            (opt.opt-ssa-env-register
              (opt.opt-ssa-env-with-capacity 100 1 1)
              99)
            99
            123)))]
    [ssa-var-block-index : opt.OptCfgIndex (opt-dense-test-ssa-var-block-index)]
    [ssa-var-blocks : opt.OptSsaVarBlocks
      (opt-dense-test-ssa-var-blocks ssa-var-block-index)]
    [ssa-var-blocks-empty : opt.OptSsaVarBlocks
      (opt.opt-ssa-var-blocks-with-capacity 0 0)]
    [ssa-var-eight-labels : opt.OptLabelSet
      (opt.opt-ssa-var-blocks-lookup (& ssa-var-blocks) 8)]
    [ssa-var-one-labels : opt.OptLabelSet
      (opt.opt-ssa-var-blocks-lookup (& ssa-var-blocks) 1)]
    [var-defs : (__tl_dyn-array opt.OptMaybeVarDef)
      (opt-var-defs-index
        (irt.params "value=%0:i64")
        3
        (irt.blocks "dense_var_defs:
             %2 = mov 7 : i64"))]
    [doms : opt.OptDomInfo
      (opt-cfg-dominators
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block
            (ir.compiler-ir-label "dense_storage")
            (ir.compiler-ir-instr-seq-empty))))]
    ;; Two facts for one key, both available: the one listed first answers.
    [copy-precedence : opt.OptGlobalFactTable
      (opt.opt-global-fact-table
        0
        (&
          (opt-global-facts-push
            (opt-global-facts-push
              (opt.opt-global-facts-new)
              (Copy 7 (I64 2) 0 2))
            (Copy 7 (I64 1) 0 1))))]
    [expr-key : opt.OptGlobalExprKey (MovKey (I64 9) (I64))]
    [expr-precedence : opt.OptGlobalFactTable
      (opt.opt-global-fact-table
        type-segment-bases
        (&
          (opt-global-facts-push
            (opt-global-facts-push
              (opt.opt-global-facts-new)
              (Expr (opt.compiler-opt-global-shared-view expr-key) 2 0 2))
            (Expr (opt.compiler-opt-global-shared-view expr-key) 1 0 1))))]
    [pack-precedence : opt.OptGlobalFactTable
      (opt.opt-global-fact-table
        0
        (&
          (opt-global-facts-push
            (opt-global-facts-push
              (opt.opt-global-facts-new)
              (PackWord 7 0 (I64 2) 0 2))
            (PackWord 7 0 (I64 1) 0 1))))]
    (cond
      [(not (opt.opt-licm-store-roots-safe? licm (Fresh 99))) 1]
      [(opt.opt-licm-store-roots-safe? licm (Fresh 4)) 2]
      [(not (= memory-count 8)) 3]
      [(not (= newest-index 0)) 4]
      [(not (= oldest-index 7)) 5]
      [(not (= deduped-count 8)) 6]
      [(not (= (opt.opt-unroll-simd-memory-count typed) 9)) 7]
      [(not
          (=
            (opt.opt-unroll-simd-memory-index
              type-segment-bases
              typed
              (& (Var 1))
              (& (U64))
              0)
            0))
        8]
      [(not (opt-dense-test-reach-reuse?)) 12]
      [(not (opt.opt-scratch-root-list-contains? (& roots) 1)) 13]
      [(not (opt.opt-scratch-root-list-contains? (& roots) 32)) 14]
      [(opt.opt-scratch-root-list-contains? (& roots) 33) 15]
      [(not (= (opt.opt-global-facts-count global-copy) 8)) 16]
      [(not (opt-dense-test-global-fact-is? global-copy 0 1)) 17]
      [(not (opt-dense-test-global-fact-is? global-copy 7 8)) 18]
      [(not (= (opt.opt-global-facts-count global-expr) 8)) 19]
      [(not (opt-dense-test-global-fact-is? global-expr 0 1)) 20]
      [(not (opt-dense-test-global-fact-is? global-expr 7 8)) 21]
      [(not (= (opt.opt-global-facts-count global-pack-word) 8)) 22]
      [(not (opt-dense-test-global-fact-is? global-pack-word 0 1)) 23]
      [(not (opt-dense-test-global-fact-is? global-pack-word 7 8)) 24]
      [(not (opt-dense-test-var-def-index-is? var-defs 0 0 0)) 25]
      [(not (opt-dense-test-var-def-index-is? var-defs 2 0 1)) 26]
      [(not (opt-dense-test-var-def-index-empty? var-defs 1)) 27]
      [(match (opt.opt-global-fact-lookup
          0
          copy-precedence
          (& (Copy 7 (Unit) 0 0))
          doms
          0
          3)
          [(Some value)
            (match value
              [(I64 found) (not (= found 2))]
              [_ true])]
          [(No) true])
        28]
      [(match (opt.opt-global-fact-lookup
          type-segment-bases
          expr-precedence
          (& (Expr expr-key 9 0 0))
          doms
          0
          3)
          [(Some value)
            (match value
              [(Var found) (not (= found 2))]
              [_ true])]
          [(No) true])
        29]
      [(match (opt.opt-global-fact-lookup
          0
          pack-precedence
          (& (PackWord 7 0 (Unit) 0 0))
          doms
          0
          3)
          [(Some value)
            (match value
              [(I64 found) (not (= found 2))]
              [_ true])]
          [(No) true])
        30]
      [(not (opt-dense-test-gvn-scope-rollback? type-segment-bases)) 31]
      [(not (= (opt.opt-ssa-phi-sites-count ssa-sites-empty) 0)) 32]
      [(not (= (opt.opt-ssa-phi-sites-count ssa-sites) 9)) 33]
      [(not (opt-dense-test-ssa-site-is? ssa-sites 0 4)) 34]
      [(not (opt-dense-test-ssa-site-is? ssa-sites 1 8)) 35]
      [(not (opt-dense-test-ssa-site-is? ssa-sites 8 1)) 36]
      [(not (= (opt.opt-ssa-rename-blocks-count ssa-renamed) 9)) 37]
      [(not (= (opt.opt-ssa-rename-blocks-count ssa-renamed-independent) 0)) 38]
      [(opt.opt-ssa-rename-blocks-contains? (& ssa-renamed-independent) 1) 39]
      [(not (opt.opt-ssa-rename-blocks-contains? (& ssa-renamed) 1)) 40]
      [(not (opt.opt-ssa-rename-blocks-contains? (& ssa-renamed) 8)) 41]
      [(not (opt-dense-test-ssa-rename-block-newest? ssa-renamed)) 43]
      [(not (opt-dense-test-ssa-rename-block-is? ssa-renamed 1 8)) 44]
      [(not (opt-dense-test-ssa-rename-block-is? ssa-renamed 8 1)) 45]
      [(not (= (opt.opt-ssa-block-outs-count ssa-outs) 9)) 46]
      [(not (= (opt.opt-ssa-block-outs-count ssa-outs-independent) 0)) 47]
      [(not (opt-dense-test-ssa-block-out-newest? ssa-outs)) 48]
      [(not (opt-dense-test-ssa-block-out-is? ssa-outs 1 8)) 49]
      [(not (opt-dense-test-ssa-block-out-is? ssa-outs 8 1)) 50]
      [(match (opt.opt-ssa-env-snapshot-lookup
          (& (opt.opt-ssa-block-out-lookup ssa-outs-independent 1))
          1)
          [(Some _) true]
          [(None) false])
        51]
      [(not (= (opt.opt-label-count ssa-var-eight-labels) 2)) 52]
      [(not
          (=
            (opt.opt-label-ref ssa-var-eight-labels 0)
            (ir.compiler-ir-label "dense_ssa_defs_a")))
        53]
      [(not
          (=
            (opt.opt-label-ref ssa-var-eight-labels 1)
            (ir.compiler-ir-label "dense_ssa_defs_b")))
        54]
      [(not (= (opt.opt-label-count ssa-var-one-labels) 1)) 55]
      [(not
          (=
            (opt.opt-label-ref ssa-var-one-labels 0)
            (ir.compiler-ir-label "dense_ssa_defs_unknown")))
        56]
      [(not
          (=
            (opt.opt-label-count
              (opt.opt-ssa-var-blocks-lookup (& ssa-var-blocks) 4))
            0))
        57]
      [(not
          (=
            (opt.opt-label-count
              (opt.opt-ssa-var-blocks-lookup (& ssa-var-blocks-empty) 8))
            0))
        58]
      [(not
          (=
            (opt.opt-label-count
              (opt.opt-ssa-var-blocks-lookup (& ssa-var-blocks) (- 0 1)))
            0))
        59]
      [(not (opt-dense-test-ssa-env-indexed-rollback?)) 60]
      [else 42])))

;; --- self-test ---------------------------------------------------------------
(define (opt-arith-instr-count [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(or (BinOp _ _ _ _ _) (UnOp _ _ _ _)) 1]
    [_ 0]))

(define (opt-count-arith-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-arith-instr-seq-from
      (opt.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (opt-arith-instr-count
          (opt.compiler-opt-global-array-element-shared-view slots index))))))

(define (opt-count-arith-instr-seq [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (let
    [instrs : ir.CompilerIrInstrSeq
      (owned_view.compiler-owned-reference-shared-view instrs)]
    (opt-count-arith-instr-seq-from instrs.slots 0 instrs.len 0)))

(define (opt-cpuid-instr-count [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(CpuId _ _ _ _) 1]
    [_ 0]))

(define (opt-xgetbv-instr-count [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(Xgetbv _ _) 1]
    [_ 0]))

(define (opt-count-cpuid-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-cpuid-instr-seq-from
      (opt.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (opt-cpuid-instr-count
          (opt.compiler-opt-global-array-element-shared-view slots index))))))

(define (opt-count-cpuid-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-cpuid-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-xgetbv-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-xgetbv-instr-seq-from
      (opt.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (opt-xgetbv-instr-count
          (opt.compiler-opt-global-array-element-shared-view slots index))))))

(define (opt-count-xgetbv-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-xgetbv-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-cpuid-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-cpuid-instr-seq instrs) (opt-count-cpuid-blocks rest))])]))

(define (opt-count-xgetbv-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-xgetbv-instr-seq instrs) (opt-count-xgetbv-blocks rest))])]))

(define (opt-count-exact-instr-seq-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [needle : ir.CompilerIrInstr]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-count-exact-instr-seq-from
      instrs
      (opt.compiler-opt-global-shared-view needle)
      (+ index 1)
      (if (opt.opt-instr-eq
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-instr-seq-ref instrs index))
        (& needle))
        (+ acc 1)
        acc))))

(define (opt-count-exact-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [needle : (& needle ir.CompilerIrInstr)]) : i64
  (opt-count-exact-instr-seq-from
    instrs
    (owned_view.compiler-owned-reference-shared-view needle)
    0
    0))

(define (opt-count-exact-instr-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [needle : (& needle ir.CompilerIrInstr)]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-exact-instr-seq instrs needle)
            (opt-count-exact-instr-blocks rest needle))])]))

(define (opt-count-exact-instr-functions
  [functions : ir.CompilerIrFunctionSeq]
  [needle : ir.CompilerIrInstr]) : i64
  (let
    [index : i64 0]
    [count : i64 0]
    (while (< index functions.len)
      (match (ir.compiler-ir-function-seq-ref functions index)
        [(Function _ _ _ _ blocks _)
          (set!
            count
            (+
              count
              (opt-count-exact-instr-blocks
                (ir.compiler-ir-block-list-view blocks)
                needle)))])
      (set! index (+ index 1)))
    count))

(define (opt-count-exact-instr-program
  [program : (& program ir.CompilerIrProgram)]
  [needle : ir.CompilerIrInstr]) : i64
  (let
    [program : ir.CompilerIrProgram
      (owned_view.compiler-owned-reference-shared-view program)]
    (match program
      [(Program _ functions _)
        (opt-count-exact-instr-functions functions needle)])))

(define (opt-sum-mov-i64-from [instrs : ir.CompilerIrInstrSeq] [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-mov-i64-value (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-sum-mov-i64-from instrs (+ index 1)))))

(define (opt-sum-mov-i64 [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-sum-mov-i64-from instrs 0))

(define (opt-mov-i64-value [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(Mov _ (I64 n) _) n]
    [_ 0]))

(define (opt-count-mov-i64-value-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [needle : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mov-i64-value-instr-seq-from
      slots
      (+ index 1)
      count
      needle
      (+
        acc
        (match (array-ref slots index)
          [(Mov _ (I64 n) _)
            (if (= n needle)
              1
              0)]
          [_ 0])))))

(define (opt-count-mov-i64-value-instr-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [needle : i64]) : i64
  (opt-count-mov-i64-value-instr-seq-from instrs.slots 0 instrs.len needle 0))

(define (opt-count-mov-bool-value-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [needle : bool]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (+
        (match instr
          [(Mov _ (Bool b) _)
            (if needle
              (if b
                1
                0)
              (if b
                0
                1))]
          [_ 0])
        (opt-count-mov-bool-value-from instrs (+ index 1) needle)))))

(define (opt-count-mov-bool-value
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [needle : bool]) : i64
  (opt-count-mov-bool-value-from instrs 0 needle))

(define (opt-sum-mov-var-src-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (+
        (match instr
          [(Mov _ (Var id) _) id]
          [_ 0])
        (opt-sum-mov-var-src-from instrs (+ index 1))))))

(define (opt-sum-mov-var-src [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-sum-mov-var-src-from instrs 0))

(define (opt-mov-dst-type-tag-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov d _ ty)
        (if (= d dst)
          (ast.ast-type-tag (& ty))
          (opt-mov-dst-type-tag-from instrs (+ index 1) dst))]
      [_ (opt-mov-dst-type-tag-from instrs (+ index 1) dst)])))

(define (opt-mov-dst-type-tag
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]) : i64
  (opt-mov-dst-type-tag-from instrs 0 dst))

(define (opt-mov-dst-i64-value-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(Mov d (I64 n) _)
        (if (= d dst)
          n
          (opt-mov-dst-i64-value-instr-seq-from
            slots
            (+ index 1)
            count
            dst
            fallback))]
      [_
        (opt-mov-dst-i64-value-instr-seq-from
          slots
          (+ index 1)
          count
          dst
          fallback)])))

(define (opt-mov-dst-i64-value-instr-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-dst-i64-value-instr-seq-from instrs.slots 0 instrs.len dst fallback))

(define (opt-mov-dst-bool-value-from?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [needle : bool]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov d (Bool b) _)
        (if (= d dst)
          (if needle
            b
            (not b))
          (opt-mov-dst-bool-value-from? instrs (+ index 1) dst needle))]
      [_ (opt-mov-dst-bool-value-from? instrs (+ index 1) dst needle)])))

(define (opt-mov-dst-bool-value?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [needle : bool]) : bool
  (opt-mov-dst-bool-value-from? instrs 0 dst needle))

(define (opt-mov-dst-char-code-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    fallback
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov d (Char c) _)
        (if (= d dst)
          (cast c : i64)
          (opt-mov-dst-char-code-from instrs (+ index 1) dst fallback))]
      [_ (opt-mov-dst-char-code-from instrs (+ index 1) dst fallback)])))

(define (opt-mov-dst-char-code
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-dst-char-code-from instrs 0 dst fallback))

(define (opt-test-f64-bits [text : String]) : u64
  (match (cfloat.compiler-float-parse-f64-bits text)
    [(CompilerFloatSomeBits bits) bits]
    [(CompilerFloatNoBits) (cast 0 : u64)]))

(define (opt-test-f32-bits [text : String]) : u64
  (match (cfloat.compiler-float-parse-f32-bits text)
    [(CompilerFloatSomeBits bits) bits]
    [(CompilerFloatNoBits) (cast 0 : u64)]))

(define (opt-mov-dst-f64-bits-from?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]
  [want : u64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov d (F64 bits) _)
        (if (= d dst)
          (= bits want)
          (opt-mov-dst-f64-bits-from? instrs (+ index 1) dst want))]
      [_ (opt-mov-dst-f64-bits-from? instrs (+ index 1) dst want)])))

(define (opt-mov-dst-f64-bits?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]
  [want : u64]) : bool
  (opt-mov-dst-f64-bits-from? instrs 0 dst want))

(define (opt-test-span [line : i64] [col : i64]) : ast.AstSourceSpan
  (ast.ast-source-span line col line col))

(define (opt-source-span-line-col-ok?
  [span : ast.AstSourceSpan]
  [line : i64]
  [col : i64]) : bool
  (and
    (= (ast.ast-source-span-start-line span) line)
    (= (ast.ast-source-span-start-col span) col)))

(define (opt-span-lookup-ok?
  [spans : (& spans ir.CompilerSourceSpans)]
  [function : i64]
  [instr : (& instr ir.CompilerIrInstr)]
  [line : i64]
  [col : i64]) : bool
  (let
    [spans : ir.CompilerSourceSpans
      (owned_view.compiler-owned-reference-shared-view spans)]
    [instr : ir.CompilerIrInstr
      (owned_view.compiler-owned-reference-shared-view instr)]
    (match (ir.compiler-source-spans-lookup-instr
      (& spans)
      (ir.compiler-ir-symbol-typed-id function)
      (& instr))
      [(Some span) (opt-source-span-line-col-ok? span line col)]
      [(No) false])))

(define (opt-span-lookup-missing?
  [spans : (& spans ir.CompilerSourceSpans)]
  [function : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (let
    [spans : ir.CompilerSourceSpans
      (owned_view.compiler-owned-reference-shared-view spans)]
    (match (ir.compiler-source-spans-lookup-instr
      (& spans)
      (ir.compiler-ir-symbol-typed-id function)
      (& instr))
      [(Some _) false]
      [(No) true])))

(define (opt-location-lookup-ok?
  [spans : (& spans ir.CompilerSourceSpans)]
  [function : i64]
  [instr : ir.CompilerIrInstr]
  [path-id : i64]
  [line : i64]
  [col : i64]) : bool
  (let
    [spans : ir.CompilerSourceSpans
      (owned_view.compiler-owned-reference-shared-view spans)]
    (match (ir.compiler-source-spans-lookup-instr-location
      (& spans)
      (ir.compiler-ir-symbol-typed-id function)
      (& instr))
      [(Some (ir.CompilerSourceLocation found-path-id span))
        (and
          (= found-path-id path-id)
          (opt-source-span-line-col-ok? span line col))]
      [(No) false])))

(define (opt-test-symbol [name : String]) : i64
  (cbi.compiler-builtin-initialize-for-parse!)
  (ir.compiler-ir-test-symbol name))

(define (opt-test-span-symbol [name : String]) : ir.CompilerIrSymbolId
  (ir.compiler-ir-symbol-typed-id (opt-test-symbol name)))

;; The program-summary builders' inputs, computed the way
;; opt-build-program-summaries computes them.
(define (opt-test-const-divisors
  [globals : ir.CompilerIrGlobalSeq]
  [functions : (& functions ir.CompilerIrFunctionSeq)]) : opt_i64_i64_map.Map
  (let
    [facts : opt.OptProgramFacts (opt.opt-program-facts-build functions)]
    (opt.opt-const-divisors-build (& globals) facts.disq)))

(define (opt-test-summaries-with-global-cell
  [summaries : opt.OptProgramSummaries]
  [cell : opt.OptGlobalCellSummary]) : opt.OptProgramSummaries
  (let
    [out : opt.OptProgramSummaries summaries]
    (set! out.global-cell cell)
    out))

(define (opt-test-arg-global-roots
  [globals : ir.CompilerIrGlobalSeq]
  [externs : ir.CompilerIrExternSeq]
  [functions : (& functions ir.CompilerIrFunctionSeq)]) : opt.OptArgGlobalScan
  (opt.opt-arg-global-roots
    (& globals)
    (& externs)
    functions
    (opt.opt-function-index-capacity (opt.opt-function-seq-count functions))))

;; IAG-2's storage table over a program with no externs.
(define (opt-test-global-obj-build
  [globals : ir.CompilerIrGlobalSeq]
  [functions : (& functions ir.CompilerIrFunctionSeq)]
  [addr-taken : (& addr-taken opt_i64_i64_map.Map)]
  [capacity : i64]) : opt.OptGlobalModRef
  (let
    [index : opt.OptProgramIndex (opt.opt-program-index-build functions)]
    [roots : opt.OptArgGlobalScan
      (opt-test-arg-global-roots
        (opt.compiler-opt-global-shared-view globals)
        (ir.compiler-ir-extern-seq-empty)
        functions)]
    (opt.opt-global-obj-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (& globals)
      functions
      index
      roots
      addr-taken
      capacity)))

;; The same table attached to a cell summary, the way
;; opt-build-program-summaries attaches it.
(define (opt-test-global-obj-attach
  [globals : ir.CompilerIrGlobalSeq]
  [functions : (& functions ir.CompilerIrFunctionSeq)]
  [capacity : i64]
  [cells : opt.OptGlobalCellSummary]) : opt.OptGlobalCellSummary
  (let
    [out : opt.OptGlobalCellSummary cells]
    (set!
      out.obj-mod-ref
      (opt-test-global-obj-build globals functions out.addr-taken capacity))
    out))

(define (opt-test-global-builder-push!
  [builder : (&mut builder ir.CompilerIrGlobalBuilder)]
  [name : i64]
  [ty : ast.AstType]
  [value : ir.CompilerIrValue]) : unit
  (ir.compiler-ir-global-builder-push!
    builder
    (ir.CompilerIrGlobal.Global name ty value)))

(define (compiler-optimize-runtime-call-identity-self-test) : i64
  (let
    [generated-alloc : i64 (opt-test-symbol "tl_alloc")]
    [generated-arena : i64 (opt-test-symbol "arena-current")]
    [runtime-alloc : ir.CompilerIrInstr
      (Call
        91
        cbi.compiler-builtin-id-tl-alloc
        (One (I64 16))
        (Struct (ci.intern "RuntimePair")))]
    [hygienic-alloc : ir.CompilerIrInstr
      (irt.instr "%92 = call tl_alloc(16) : HygienicPair")]
    [runtime-abort : ir.CompilerIrInstr
      (Call 93 cbi.compiler-builtin-id-tl-abort-label (Nil) (Unit))]
    [hygienic-abort : ir.CompilerIrInstr
      (irt.instr "%94 = call .L_tl_abort() : unit")]
    [runtime-facts : opt.OptAliasFacts
      (let
        [facts (opt.opt-alias-empty)]
        (opt.opt-alias-update-value-facts facts runtime-alloc 0))]
    [hygienic-facts : opt.OptAliasFacts
      (let
        [facts (opt.opt-alias-empty)]
        (opt.opt-alias-update-value-facts facts hygienic-alloc 0))]
    (cond
      [(= generated-alloc cbi.compiler-builtin-id-tl-alloc) 1]
      [(not
          (string.eq
            (ir.compiler-ir-symbol-text generated-alloc)
            (ir.compiler-ir-symbol-text cbi.compiler-builtin-id-tl-alloc)))
        2]
      [(not
          (ir.compiler-ir-symbol-eq?
            cbi.compiler-builtin-id-tl-alloc
            cbi.compiler-builtin-id-tl-alloc))
        15]
      [(ir.compiler-ir-symbol-eq?
          generated-alloc
          cbi.compiler-builtin-id-tl-alloc)
        16]
      [(not
          (ir.compiler-ir-effect-eq?
            (ir.compiler-ir-instr-effect (& runtime-alloc))
            MemoryWrite))
        3]
      [(not
          (ir.compiler-ir-effect-eq?
            (ir.compiler-ir-instr-effect (& hygienic-alloc))
            Unknown))
        4]
      [(match (opt.opt-aggregate-direct-alloc
          (opt.compiler-opt-global-shared-view runtime-alloc))
          [(Some _ _ _) false]
          [(No) true])
        5]
      [(match (opt.opt-aggregate-direct-alloc
          (opt.compiler-opt-global-shared-view hygienic-alloc))
          [(No) false]
          [(Some _ _ _) true])
        6]
      [(match (opt.opt-scratch-direct-alloc
          (ast.ast-node-pool-reader-type-segment-bases)
          runtime-alloc)
          [(Alloc _ _) false]
          [(NoAlloc) true])
        7]
      [(match (opt.opt-scratch-direct-alloc
          (ast.ast-node-pool-reader-type-segment-bases)
          hygienic-alloc)
          [(NoAlloc) false]
          [(Alloc _ _) true])
        8]
      [(match (opt.opt-alias-lookup (& runtime-facts) 91)
          [(Some kind) (not (opt-alias-kind-eq kind (Unique 0)))]
          [(No) true])
        9]
      [(match (opt.opt-alias-lookup (& hygienic-facts) 92)
          [(No) false]
          [(Some _) true])
        10]
      [(not (opt.opt-licm-return-staging-instr? (& runtime-abort))) 11]
      [(opt.opt-licm-return-staging-instr? (& hygienic-abort)) 12]
      [(not
          (opt.opt-scratch-arena-helper-call?
            cbi.compiler-builtin-id-arena-current))
        13]
      [(opt.opt-scratch-arena-helper-call? generated-arena) 14]
      [else 42])))

(define (opt-spans-function-with-frame
  [instrs : ir.CompilerIrInstrSeq]
  [frame : i64]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "main")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    frame
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))
    Ordinary))

(define (opt-spans-function [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (opt-spans-function-with-frame instrs 4))

(define (opt-spans-program-with-frame
  [instrs : ir.CompilerIrInstrSeq]
  [frame : i64]) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (opt-spans-function-with-frame instrs frame))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)))

(define (opt-spans-program [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrProgram
  (opt-spans-program-with-frame instrs 4))

(define (opt-spans-base) : ir.CompilerSourceSpans
  (ir.compiler-source-spans-insert
    (ir.compiler-source-spans-empty)
    (ir.compiler-ir-symbol-typed-id (opt-test-symbol "main"))
    (opt-test-span 3 1)))

(define (compiler-optimize-spans-dce-ok?) : bool
  (let
    [dead : ir.CompilerIrInstr (Mov 0 (I64 1) (I64))]
    [live : ir.CompilerIrInstr (irt.instr "%1 = call opaque() : i64")]
    [instrs : ir.CompilerIrInstrSeq
      (opt-test-instrs (clone dead) (clone live) (irt.instr "return %1"))]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert-instr
          (opt-spans-base)
          (opt-test-span-symbol "main")
          (& dead)
          (opt-test-span 21 3))
        (opt-test-span-symbol "main")
        (& live)
        (opt-test-span 31 5))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-spans-program instrs))
      spans
      1)
      [(Program _ optimized-spans)
        (and
          (= (ir.compiler-source-spans-instr-count (& optimized-spans)) 1)
          (opt-span-lookup-missing?
            optimized-spans
            (opt-test-symbol "main")
            dead)
          (opt-span-lookup-ok?
            optimized-spans
            (opt-test-symbol "main")
            live
            31
            5))])))

(define (compiler-optimize-spans-fold-ok?) : bool
  (let
    [folded : ir.CompilerIrInstr (irt.instr "%2 = add 20, 22 : i64")]
    [rewritten : ir.CompilerIrInstr (Mov 2 (I64 42) (I64))]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%2 = add 20, 22 : i64
         %3 = addr_of %2
         return %3")]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (opt-spans-base)
        (opt-test-span-symbol "main")
        (& folded)
        (opt-test-span 41 7))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-spans-program instrs))
      spans
      2)
      [(Program _ optimized-spans)
        (opt-span-lookup-ok?
          optimized-spans
          (opt-test-symbol "main")
          rewritten
          41
          7)])))

(define (compiler-optimize-spans-cse-ok?) : bool
  (let
    [first : ir.CompilerIrInstr (irt.instr "%2 = add %0, %1 : i64")]
    [second : ir.CompilerIrInstr (irt.instr "%3 = add %0, %1 : i64")]
    [rewritten : ir.CompilerIrInstr (Mov 3 (Var 2) (I64))]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%2 = add %0, %1 : i64
         %3 = add %0, %1 : i64
         %4 = addr_of %3
         return %4")]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert-instr
          (opt-spans-base)
          (opt-test-span-symbol "main")
          (& first)
          (opt-test-span 51 9))
        (opt-test-span-symbol "main")
        (& second)
        (opt-test-span 61 11))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-spans-program-with-frame instrs 5))
      spans
      2)
      [(Program optimized optimized-spans)
        (and
          (opt-span-lookup-ok?
            optimized-spans
            (opt-test-symbol "main")
            first
            51
            9)
          (opt-span-lookup-ok?
            optimized-spans
            (opt-test-symbol "main")
            rewritten
            61
            11)
          (= (opt-count-exact-instr-program optimized rewritten) 1)
          (= (opt-count-exact-instr-program optimized (AddrOf 4 3)) 1)
          (= (opt-count-exact-instr-program optimized (AddrOf 4 2)) 0))])))

(define (compiler-optimize-dead-addrof-ok?) : bool
  (let
    [producer : ir.CompilerIrInstr (irt.instr "%2 = add %0, %1 : i64")]
    [addr : ir.CompilerIrInstr (AddrOf 3 2)]
    [instrs : ir.CompilerIrInstrSeq
      (opt-test-instrs (clone producer) (clone addr) (irt.instr "return 42"))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-spans-program instrs))
      (opt-spans-base)
      1)
      [(Program optimized _)
        (and
          (= (opt-count-exact-instr-program optimized producer) 0)
          (= (opt-count-exact-instr-program optimized addr) 0))])))

(defstruct OptInlineSpanTestSymbols
  (main i64)
  (inline-span i64)
  (opaque i64))

(define (opt-inline-span-test-symbols) : OptInlineSpanTestSymbols
  (OptInlineSpanTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "inline_span")
    (opt-test-symbol "opaque")))

(define (opt-inline-span-callee-call [symbols : OptInlineSpanTestSymbols]) : ir.CompilerIrInstr
  (Call 1 symbols.opaque (One (Var 0)) (I64)))

(define (opt-inline-span-callee [symbols : OptInlineSpanTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.inline-span
    (irt.params "value=%0:i64")
    (I64)
    2
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-span-callee-call symbols)
          (irt.instr "return %1"))))
    Ordinary))

(define (opt-inline-span-caller-call [symbols : OptInlineSpanTestSymbols]) : ir.CompilerIrInstr
  (Call 0 symbols.inline-span (One (I64 7)) (I64)))

(define (opt-inline-span-caller [symbols : OptInlineSpanTestSymbols]) : ir.CompilerIrFunction
  (Function
    symbols.main
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-span-caller-call symbols)
          (irt.instr "return %0"))))
    Ordinary))

(define (opt-inline-span-program [symbols : OptInlineSpanTestSymbols]) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (opt-inline-span-caller symbols))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (opt-inline-span-callee symbols))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)))

(define (compiler-optimize-spans-inline-callee-ok?) : bool
  (let
    [symbols : OptInlineSpanTestSymbols (opt-inline-span-test-symbols)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr-located
        (ir.compiler-source-spans-insert-instr-located
          (opt-spans-base)
          (opt-test-span-symbol "inline_span")
          (& (opt-inline-span-callee-call symbols))
          701
          (opt-test-span 71 13))
        (opt-test-span-symbol "main")
        (& (opt-inline-span-caller-call symbols))
        801
        (opt-test-span 81 15))]
    [cloned-call : ir.CompilerIrInstr
      (Call 1 symbols.opaque (One (I64 7)) (I64))]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (ir.compiler-debug-info-set-enabled! true)
        (match (opt.optimize-program-with-spans-and-level
          (& (opt-inline-span-program symbols))
          spans
          2)
          [(Program _ optimized-spans)
            (and
              (opt-span-lookup-ok?
                optimized-spans
                (opt-test-symbol "main")
                cloned-call
                71
                13)
              (opt-location-lookup-ok?
                optimized-spans
                (opt-test-symbol "main")
                cloned-call
                701
                71
                13))]))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    ok))

(define (compiler-optimize-spans-inline-fallback-ok?) : bool
  (let
    [symbols : OptInlineSpanTestSymbols (opt-inline-span-test-symbols)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (opt-spans-base)
        (opt-test-span-symbol "main")
        (& (opt-inline-span-caller-call symbols))
        (opt-test-span 91 17))]
    [cloned-call : ir.CompilerIrInstr
      (Call 1 symbols.opaque (One (I64 7)) (I64))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-inline-span-program symbols))
      spans
      2)
      [(Program _ optimized-spans)
        (opt-span-lookup-ok?
          optimized-spans
          (opt-test-symbol "main")
          cloned-call
          91
          17)])))

(define (compiler-optimize-spans-inline-multiblock-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert-instr
          (opt-spans-base)
          (opt-test-span-symbol "inline_branch")
          (& (opt-inline-branch-callee-mov))
          (opt-test-span 141 27))
        (opt-test-span-symbol "main")
        (& (opt-inline-branch-caller-call symbols))
        (opt-test-span 151 29))]
    [phi : ir.CompilerIrInstr
      (irt.instr
        "%0 = phi [%1, inl.entry.0.then], [42, inl.entry.0.else] : i64")]
    (match (opt-test-inline-program-with-spans
      (ast.ast-node-pool-reader-context-current)
      (ast.ast-node-pool-reader-type-segment-bases)
      (opt-inline-branch-functions symbols)
      2
      spans)
      [(Program optimized optimized-spans)
        (match (opt-function-seq-find optimized "main")
          [(Some main)
            (and
              (=
                (let
                  [blocks (opt.opt-function-blocks main)]
                  (ir.compiler-ir-block-list-count blocks))
                5)
              (let
                [spans (opt.compiler-opt-global-shared-view optimized-spans)]
                [function (opt-test-symbol "main")]
                [instr (opt-inline-branch-callee-mov)]
                (opt-span-lookup-ok? spans function instr 141 27))
              (opt-span-lookup-ok?
                optimized-spans
                (opt-test-symbol "main")
                phi
                151
                29))]
          [(No) false])])))

;; ABT-1: the ok-label of the first BoundsCheck in a block list, or -1. A
;; cloned check's label is freshened by the site prefix, so a test cannot spell
;; the copy's key -- it has to read it back off the inlined body.
(define (opt-first-bounds-ok-label-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    (- 0 1)
    (match (array-ref slots index)
      [(BoundsCheck _ _ ok-label) ok-label]
      [_ (opt-first-bounds-ok-label-instr-seq-from slots (+ index 1) count)])))

(define (opt-first-bounds-ok-label-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) (- 0 1)]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (let
            [found : i64
              (opt-first-bounds-ok-label-instr-seq-from
                instrs.slots
                0
                instrs.len)]
            (if (>= found 0)
              found
              (opt-first-bounds-ok-label-blocks rest)))])]))

;; The spans the ABT-1 scenario starts from: the CALLEE's check located in
;; mb_bounds at 57:29 of path 613, and the CALL located in main at 12:5 of path
;; 401. A correct clone answers with the callee's location under the caller's
;; key; attributing it to the site would answer 401/12/5, and dropping the path
;; would answer 0 -- which is what the backend's abort-site install reads as
;; "no location" (compiler-backend-runtime-abort-site-install! requires a
;; positive path id), degrading `tl_oob_abort_at` to the bare `tl_oob_abort`.
(define (opt-inline-mb-bounds-located-spans
  [symbols : OptInlineMultiTestSymbols]) : ir.CompilerSourceSpans
  (ir.compiler-source-spans-insert-instr-located
    (ir.compiler-source-spans-insert-instr-located
      (opt-spans-base)
      (opt-test-span-symbol "mb_bounds")
      (& (irt.instr "bounds_check %0, %1 message \"mb_ok\""))
      613
      (opt-test-span 57 29))
    (opt-test-span-symbol "main")
    (& (Call 2 symbols.mb-bounds (Two (Var 0) (Var 1)) (I64)))
    401
    (opt-test-span 12 5)))

(define (opt-inline-mb-bounds-located-clone-ok? [debug? : bool]) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [spans : ir.CompilerSourceSpans
      (opt-inline-mb-bounds-located-spans symbols)]
    [source-label : i64 (ir.compiler-ir-label "mb_ok")]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (ir.compiler-debug-info-set-enabled! debug?)
        (match (opt-test-inline-program-with-spans
          (ast.ast-node-pool-reader-context-current)
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-mb-bounds-caller symbols))
            (&
              (ir.compiler-ir-function-seq-prepend
                (& (opt-inline-mb-bounds-callee symbols))
                (& (ir.compiler-ir-function-seq-empty)))))
          2
          spans)
          [(Program optimized optimized-spans)
            (match (opt-function-seq-find optimized "main")
              [(Some main)
                (let
                  [blocks : ir.CompilerIrBlockList
                    (opt.opt-function-blocks main)]
                  [cloned-label : i64
                    (opt-first-bounds-ok-label-blocks
                      (ir.compiler-ir-block-list-view blocks))]
                  (and
                    ;; The body really was copied, and the copy's ok-label is
                    ;; the freshened one -- not the callee's own spelling.
                    (=
                      (opt-count-direct-call-name-blocks
                        (ir.compiler-ir-block-list-view blocks)
                        "mb_bounds")
                      0)
                    (=
                      (opt.opt-count-bounds-blocks
                        (ir.compiler-ir-block-list-view blocks))
                      1)
                    (>= cloned-label 0)
                    (not (= cloned-label source-label))
                    ;; The clone answers with the CALLEE's location, path id
                    ;; included, under the caller's key.
                    (opt-location-lookup-ok?
                      optimized-spans
                      (opt-test-symbol "main")
                      (BoundsCheck (Var 0) (Var 1) cloned-label)
                      613
                      57
                      29)))]
              [(No) false])]))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    ok))

;; ABT-1: a BoundsCheck the multiblock with-spans path copies out of a callee
;; keeps the CALLEE's LOCATED span. The ordinary (no `-g`) build is the one the
;; driver compiles through and the one the defect was in: it recorded the
;; clone's span unlocated, so every bounds abort raised inside an inlined body
;; printed the bare `tl: array index out of bounds` at --opt-level 2 while the
;; same body out of line printed file:line:col with index and length. The `-g`
;; arm pins that the site's own location -- present here, and the fallback for
;; a clone the callee never gave a span -- does not win over the callee's.
(define (compiler-optimize-spans-inline-multiblock-bounds-located-ok?) : bool
  (and
    (opt-inline-mb-bounds-located-clone-ok? false)
    (opt-inline-mb-bounds-located-clone-ok? true)))

;; The level-2 inline stage rewrites each caller inside a scratch phase and
;; escapes only its final body, cloned through the job's explicit pools
;; (#8362). The parameter type below names a nested node past the job pool's
;; first type segment; the ambient pool installed during the stage is a
;; different, empty one. Both callers must still absorb the leaf, and their
;; escaped parameter types must resolve through the job pool.
(define (opt-inline-job-pool-function
  [name : String]
  [param-type : ast.AstType]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol name)
    (ir.compiler-ir-param-seq-prepend
      (Param "p" param-type 0)
      (ir.compiler-ir-param-seq-empty))
    (I64)
    2
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))
    Ordinary))

(define (opt-inline-job-pool-caller [name : String] [param-type : ast.AstType]) : ir.CompilerIrFunction
  (opt-inline-job-pool-function
    name
    param-type
    (opt-test-instrs
      (ir.CompilerIrInstr.Call
        1
        (opt-test-symbol "job_pool_leaf")
        (One (Var 0))
        (I64))
      (ir.CompilerIrInstr.Return (Some (Var 1))))))

(define (opt-inline-job-pool-leaf-calls [func : (& func ir.CompilerIrFunction)]) : i64
  (match (owned_view.compiler-owned-reference-shared-view func)
    [(Function _ _ _ _ blocks _)
      (opt-count-direct-call-name-blocks
        (ir.compiler-ir-block-list-view blocks)
        "job_pool_leaf")]))

;; The caller's escaped parameter is `(Ref _ array)` whose array resolves, in
;; the job pool, to `(Array elem 4)` with `elem` resolving to i64.
(define (opt-inline-job-pool-param-ok?
  [bases : i64]
  [func : (& func ir.CompilerIrFunction)]) : bool
  (match (owned_view.compiler-owned-reference-shared-view func)
    [(Function _ params _ _ blocks _)
      (and
        (=
          (opt-count-direct-call-name-blocks
            (ir.compiler-ir-block-list-view blocks)
            "job_pool_leaf")
          0)
        (= (ir.compiler-ir-param-seq-count params) 1)
        (match (ir.compiler-ir-param-seq-ref params 0)
          [(Param _ (Ref _ array-id) _)
            (match (ast.ast-type-segment-bases-get bases array-id)
              [(Array elem-id 4)
                (match (ast.ast-type-segment-bases-get bases elem-id)
                  [(I64) true]
                  [_ false])]
              [_ false])]
          [_ false]))]))

(define (opt-inline-job-pool-caller-ok?
  [bases : i64]
  [out : (& out ir.CompilerIrFunctionSeq)]
  [name : String]) : bool
  (match (opt-function-seq-find out name)
    [(Some func) (opt-inline-job-pool-param-ok? bases (& func))]
    [(No) false]))

;; One level-2 inline run on a fresh job pool grown by `fill` distinct type
;; nodes, with a different, empty pool installed as the ambient context while
;; it runs. True when the parameter's array node sits past the pool's first
;; segment, an unoptimized caller calls the leaf once, and both callers absorb
;; the leaf while keeping their job-pool parameter type.
(define (opt-inline-job-pool-run-ok? [fill : i64]) : bool
  (let
    [job : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 4 16)]
    [filler : i64 (ast.ast-node-pool-context-type-push job (Bool))]
    [i : i64 0]
    [_fill
      : unit
      ;; Distinct nodes, so deduplication cannot collapse them, until the
      ;; pool has crossed its first 1,024-node segment.
      (while (< i fill)
        (set!
          filler
          (ast.ast-node-pool-context-type-push job (Array filler (+ i 1))))
        (set! i (+ i 1)))]
    [elem-id : i64 (ast.ast-node-pool-context-type-push job (I64))]
    [array-id : i64 (ast.ast-node-pool-context-type-push job (Array elem-id 4))]
    [bases : i64 (ast.ast-node-pool-context-type-segment-bases job)]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (& (opt-inline-job-pool-caller "job_pool_a" (Ref 1 array-id)))
        (&
          (ir.compiler-ir-function-seq-prepend
            (& (opt-inline-job-pool-caller "job_pool_b" (Ref 1 array-id)))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (opt-inline-job-pool-function
                    "job_pool_leaf"
                    (Ref 1 array-id)
                    (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 7))))))
                (& (ir.compiler-ir-function-seq-empty)))))))]
    [ambient : ast.AstNodePoolContext
      (ast.ast-node-pool-reader-context-current)]
    [_install-empty : unit
      (ast.ast-node-pool-context-install!
        (ast.ast-node-pool-context-new-with-capacities 4 16))]
    [inlined : opt.OptInlineSpanProgram
      (opt-test-inline-program-with-spans
        job
        bases
        functions
        2
        (ir.compiler-source-spans-empty))]
    [_restore : unit (ast.ast-node-pool-context-install! ambient)]
    [control : ir.CompilerIrFunction
      (opt-inline-job-pool-caller "job_pool_c" (Ref 1 array-id))]
    (and
      (> array-id ast.ast-type-node-pool-segment-size)
      (= (opt-inline-job-pool-leaf-calls (& control)) 1)
      (match inlined
        [(Program out _)
          (and
            (opt-inline-job-pool-caller-ok? bases (& out) "job_pool_a")
            (opt-inline-job-pool-caller-ok? bases (& out) "job_pool_b"))]))))

(test
  optimizer-inline-callers-escape-through-explicit-job-pool
  (test.assert-true
    (opt-inline-job-pool-run-ok? 1100)
    "with an empty ambient pool, both callers absorb the leaf and keep a parameter type that resolves past the explicit job pool's first segment"))

;; Every run destroys its scratch arena before returning. Three runs in one
;; process, alternating two job pools of different sizes, would read a table
;; the previous run left pointing into its rewound phases.
(test
  optimizer-inline-repeated-interleaved-job-pools
  (test.assert-true (opt-inline-job-pool-run-ok? 1100) "job A")
  (test.assert-true (opt-inline-job-pool-run-ok? 1300) "job B")
  (test.assert-true (opt-inline-job-pool-run-ok? 1100) "job A again"))

;; The level-2 per-function loop reads its input from the optimizer-input arena
;; (#8386). `input_loop` absorbs the leaf, while `main` and `input_leaf` have no
;; site to rewrite. `input_dead` is rewritten but unreachable, so pruning drops
;; it together with the fully inlined leaf.
(define (opt-input-arena-functions) : ir.CompilerIrFunctionSeq
  (match (irt.program
    "function @main() -> i64 vars 1 {
     entry:
       %0 = call input_loop(1) : i64
       return %0
     }
     function @input_loop(n=%0:i64) -> i64 vars 3 {
     entry:
       %1 = call input_leaf(%0) : i64
       %2 = call input_loop(%1) : i64
       return %2
     }
     function @input_leaf(n=%0:i64) -> i64 vars 1 {
     entry:
       return 7
     }
     function @input_dead(n=%0:i64) -> i64 vars 2 {
     entry:
       %1 = call input_leaf(%0) : i64
       return %1
     }")
    [(Program _ functions _) functions]))

(define (opt-input-arena-leaf-calls
  [functions : (& functions ir.CompilerIrFunctionSeq)]
  [name : String]) : i64
  (match (opt-function-seq-find functions name)
    [(Some func)
      (let
        [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks func)]
        (opt-count-direct-call-name-blocks
          (ir.compiler-ir-block-list-view blocks)
          "input_leaf"))]
    [(No) -1]))

(define (opt-input-arena-all-placed?
  [input : (& input opt.OptOptimizerInput)]
  [functions : (& functions ir.CompilerIrFunctionSeq)]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (while (< i functions.len)
      (if (opt.opt-optimizer-input-placed?
        input
        (& (ir.compiler-ir-function-seq-ref functions i)))
        unit
        (set! ok false))
      (set! i (+ i 1)))
    ok))

;; Every index body is placed as the stage finishes it, whether its caller was
;; rewritten or not, and whether or not it survives pruning. The survivors then
;; need no copy.
(test
  optimizer-input-inline-stage-places-every-body
  (let
    [bodies : i64 (opt.opt-optimizer-input-carrier 2)]
    [input : opt.OptOptimizerInput (opt.opt-optimizer-input-new bodies 4)]
    [inlined : opt.OptInlineSpanProgram
      (opt.opt-inline-program-functions-with-spans
        (ast.ast-node-pool-reader-context-current)
        (&mut input)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-input-arena-functions)
        2
        (ir.compiler-source-spans-empty))]
    [out : ir.CompilerIrFunctionSeq
      (match inlined
        [(Program functions _) functions])]
    [survivors : ir.CompilerIrFunctionSeq
      (match (opt.opt-prune-unreachable-program
        (ir.compiler-ir-global-seq-empty)
        (owned_view.compiler-owned-shared-view out)
        (& (ir.compiler-ir-extern-seq-empty)))
        [(Program _ functions) functions])]
    ;; The stage output still holds the pruned bodies, whose chunk the carry
    ;; releases, so read it first.
    [out-placed? : bool (opt-input-arena-all-placed? (& input) (& out))]
    [out-loop-leaf-calls : i64
      (opt-input-arena-leaf-calls (& out) "input_loop")]
    [carried : ir.CompilerIrFunctionSeq
      (opt.opt-optimizer-input-carry
        (ast.ast-node-pool-reader-context-current)
        (&mut input)
        (owned_view.compiler-owned-shared-view survivors))]
    (test.assert-true (> bodies 0) "level 2 has an optimizer-input arena")
    (test.assert-i64-eq out.len 4 "the stage returns every index body")
    (test.assert-true
      out-placed?
      "rewritten, unrewritten and later pruned bodies are all placed")
    (test.assert-i64-eq
      out-loop-leaf-calls
      0
      "the placed input_loop is its rewritten body")
    (test.assert-i64-eq survivors.len 2 "pruning keeps main and input_loop")
    (test.assert-i64-eq
      (opt-input-arena-leaf-calls (& survivors) "input_dead")
      -1
      "the pruned caller is not a survivor")
    (test.assert-i64-eq carried.len 2 "the loop reads both survivors")
    (test.assert-true
      (opt-input-arena-all-placed? (& input) (& carried))
      "the carried survivors are the placed bodies")
    (opt.opt-optimizer-input-release-all! (&mut input))))

;; A survivor the stage never placed is copied into the input arena, so the
;; loop still reads nothing from the arena that produced it: here the source
;; arena is destroyed before the carried bodies are read.
(test
  optimizer-input-carry-copies-unplaced-survivors
  (let
    [bodies : i64 (opt.opt-optimizer-input-carrier 2)]
    [source : i64 (arena.tl_arena_make)]
    [input : opt.OptOptimizerInput (opt.opt-optimizer-input-new bodies 4)]
    [functions : ir.CompilerIrFunctionSeq
      (in-arena (arena.Arena source) (opt-input-arena-functions))]
    [placed-before? : bool
      (opt-input-arena-all-placed? (& input) (& functions))]
    [carried : ir.CompilerIrFunctionSeq
      (opt.opt-optimizer-input-carry
        (ast.ast-node-pool-reader-context-current)
        (&mut input)
        functions)]
    [_destroy-source : unit
      (unsafe
        (arena.tl_arena_destroy source))]
    (test.assert-false placed-before? "nothing was placed")
    (test.assert-i64-eq carried.len 4 "every survivor is carried")
    (test.assert-i64-eq
      (opt-input-arena-leaf-calls (& carried) "input_loop")
      1
      "the copied input_loop is intact")
    (test.assert-i64-eq
      (opt-input-arena-leaf-calls (& carried) "input_dead")
      1
      "the copied input_dead is intact")
    (unsafe
      (arena.tl_arena_destroy bodies))))

;; Level 1 has no input arena: the stage places nothing and the loop reads the
;; stage's own sequence in place.
(test
  optimizer-input-level-one-reads-stage-output-in-place
  (let
    [input : opt.OptOptimizerInput
      (opt.opt-optimizer-input-new (opt.opt-optimizer-input-carrier 1) 4)]
    [inlined : opt.OptInlineSpanProgram
      (opt.opt-inline-program-functions-with-spans
        (ast.ast-node-pool-reader-context-current)
        (&mut input)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-input-arena-functions)
        1
        (ir.compiler-source-spans-empty))]
    [out : ir.CompilerIrFunctionSeq
      (match inlined
        [(Program functions _) functions])]
    [carried : ir.CompilerIrFunctionSeq
      (opt.opt-optimizer-input-carry
        (ast.ast-node-pool-reader-context-current)
        (&mut input)
        (owned_view.compiler-owned-shared-view out))]
    (test.assert-i64-eq input.arena 0 "level 1 has no optimizer-input arena")
    (test.assert-i64-eq input.placed.len 0 "level 1 places nothing")
    (test.assert-i64-eq
      (array-length input.release.order)
      0
      "level 1 has no input chunk to release")
    (test.assert-i64-eq carried.len out.len "the loop reads the stage output")))

;; Each placed body goes into the chunk of its index slot (#8446). The carry
;; releases a chunk no survivor is in, and the loop releases each other chunk
;; only once it has passed that chunk's last survivor. A survivor whose name was
;; placed but whose body is a different one is copied into the carrier, which
;; outlives every chunk.
(test
  optimizer-input-chunks-release-after-last-survivor
  (let
    [pools : ast.AstNodePoolContext (ast.ast-node-pool-reader-context-current)]
    [carrier : i64 (opt.opt-optimizer-input-carrier 2)]
    ;; Four functions give two slots per chunk.
    [input : opt.OptOptimizerInput (opt.opt-optimizer-input-new carrier 4)]
    [functions : ir.CompilerIrFunctionSeq (opt-input-arena-functions)]
    [placed-main : ir.CompilerIrFunction
      (opt.opt-optimizer-input-place
        pools
        (&mut input)
        0
        (& (ir.compiler-ir-function-seq-ref (& functions) 0)))]
    [placed-loop : ir.CompilerIrFunction
      (opt.opt-optimizer-input-place
        pools
        (&mut input)
        1
        (& (ir.compiler-ir-function-seq-ref (& functions) 1)))]
    [placed-leaf : ir.CompilerIrFunction
      (opt.opt-optimizer-input-place
        pools
        (&mut input)
        2
        (& (ir.compiler-ir-function-seq-ref (& functions) 2)))]
    [placed-dead : ir.CompilerIrFunction
      (opt.opt-optimizer-input-place
        pools
        (&mut input)
        9
        (& (ir.compiler-ir-function-seq-ref (& functions) 3)))]
    [dead-placed? : bool
      (opt.opt-optimizer-input-placed? (& input) (& placed-dead))]
    [survivors : ir.CompilerIrFunctionSeq
      (let
        [builder : ir.CompilerIrFunctionBuilder
          (ir.compiler-ir-function-builder-with-capacity 4)]
        (ir.compiler-ir-function-builder-push! (&mut builder) placed-main)
        (ir.compiler-ir-function-builder-push! (&mut builder) placed-loop)
        (ir.compiler-ir-function-builder-push! (&mut builder) placed-leaf)
        (ir.compiler-ir-function-builder-push!
          (&mut builder)
          (ir.compiler-ir-function-seq-ref (& functions) 3))
        (ir.compiler-ir-function-builder-to-seq builder))]
    [carried : ir.CompilerIrFunctionSeq
      (opt.opt-optimizer-input-carry pools (&mut input) survivors)]
    [release : opt.OptOptimizerInputRelease input.release]
    [copy : ir.CompilerIrFunction
      (ir.compiler-ir-function-seq-ref (& carried) 3)]
    (test.assert-true dead-placed? "a placed body matches its record")
    (test.assert-false
      (opt.opt-optimizer-input-placed? (& input) (& copy))
      "a different body under a placed name is not the placed one")
    (test.assert-i64-eq (array-length release.chunks) 32 "one entry per chunk")
    (test.assert-true (> (array-ref release.chunks 0) 0) "chunk 0 is open")
    (test.assert-true (> (array-ref release.chunks 1) 0) "chunk 1 is open")
    (test.assert-i64-eq
      (array-ref release.chunks 4)
      0
      "the chunk no survivor is in is released at the carry")
    (test.assert-i64-eq
      (array-ref release.chunks 2)
      0
      "an unused chunk is never opened")
    (test.assert-i64-eq
      (array-ref release.last 0)
      1
      "chunk 0 is last read by input_loop")
    (test.assert-i64-eq
      (array-ref release.last 1)
      2
      "chunk 1 is last read by input_leaf")
    (test.assert-i64-eq (array-ref release.last 4) -1 "chunk 4 has no reader")
    (test.assert-i64-eq
      (array-length release.order)
      2
      "two chunks wait for the loop")
    (let
      [cursor : i64
        (opt.opt-optimizer-input-release-passed! (&mut release) 0 0)]
      (test.assert-i64-eq cursor 0 "after main, chunk 0 still has a reader")
      (test.assert-true
        (> (array-ref release.chunks 0) 0)
        "chunk 0 stays open while input_loop is ahead")
      (set!
        cursor
        (opt.opt-optimizer-input-release-passed! (&mut release) 1 cursor))
      (test.assert-i64-eq cursor 1 "chunk 0 goes after input_loop")
      (test.assert-i64-eq (array-ref release.chunks 0) 0 "chunk 0 is released")
      (test.assert-true
        (> (array-ref release.chunks 1) 0)
        "chunk 1 stays open while input_leaf is ahead")
      (set!
        cursor
        (opt.opt-optimizer-input-release-passed! (&mut release) 2 cursor))
      (test.assert-i64-eq
        (array-ref release.chunks 1)
        0
        "chunk 1 goes after input_leaf")
      (set!
        cursor
        (opt.opt-optimizer-input-release-passed! (&mut release) 3 cursor))
      (test.assert-i64-eq cursor 2 "the copy releases no chunk")
      (let
        [copy-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks copy)]
        (test.assert-i64-eq
          (opt-count-direct-call-name-blocks
            (ir.compiler-ir-block-list-view copy-blocks)
            "input_leaf")
          1
          "the copied survivor outlives every chunk"))
      (opt.opt-optimizer-input-release-all! (&mut input)))))

;; The production level-2 path destroys the inline arena before its
;; per-function loop, so every body the loop reads must already be resident in
;; the input arena.
(test
  optimizer-input-level-two-program-reads-resident-bodies
  (match (opt-test-optimize-program-with-level
    (Program
      (ir.compiler-ir-global-seq-empty)
      (opt-input-arena-functions)
      (ir.compiler-ir-extern-seq-empty))
    2)
    [(Program _ functions _)
      (test.assert-i64-eq
        (opt-input-arena-leaf-calls (& functions) "input_loop")
        0
        "input_loop keeps its absorbed leaf")
      (test.assert-i64-eq
        (opt-input-arena-leaf-calls (& functions) "input_dead")
        -1
        "the unreachable caller is pruned")
      (test.assert-true
        (>= (opt-input-arena-leaf-calls (& functions) "main") 0)
        "main survives")]))

;; Each caller's phase escapes only the span rows its own rewrite added
;; (#8362), so the spans table grows linearly in the number of rewritten
;; callers: six rewritten callers add exactly six times the rows one adds.
(define (opt-inline-linear-span-instr-count [callers : i64]) : i64
  (let
    [functions : ir.CompilerIrFunctionSeq (ir.compiler-ir-function-seq-empty)]
    [spans : ir.CompilerSourceSpans (opt-spans-base)]
    [i : i64 0]
    ;; Each caller has its own single-site copy of the bounds callee, whose
    ;; bounds check carries a located span.
    (while (< i callers)
      (let
        [suffix : String (string.int->string i)]
        [callee-name : String (str_cat.str-cat "lin_callee_" (clone suffix))]
        (set!
          spans
          (ir.compiler-source-spans-insert-instr-located
            spans
            (opt-test-span-symbol (clone callee-name))
            (& (irt.instr "bounds_check %0, %1 message \"lin_ok\""))
            613
            (opt-test-span 57 29)))
        (set!
          functions
          (ir.compiler-ir-function-seq-prepend
            (&
              (Function
                (opt-test-symbol (clone callee-name))
                (irt.params "idx=%0:i64, len=%1:i64")
                (I64)
                3
                (irt.blocks
                  "entry:
                       bounds_check %0, %1 message \"lin_ok\"
                       branch true, then, else
                     then:
                       return %0
                     else:
                       return 0")
                Ordinary))
            (&
              (ir.compiler-ir-function-seq-prepend
                (&
                  (Function
                    (opt-test-symbol (str_cat.str-cat "lin_caller_" suffix))
                    (irt.params "a=%0:i64, b=%1:i64")
                    (I64)
                    3
                    (ir.compiler-ir-blocks
                      (ir.CompilerIrBlock.Block
                        (ir.compiler-ir-label "entry")
                        (opt-test-instrs
                          (ir.CompilerIrInstr.Call
                            2
                            (opt-test-symbol callee-name)
                            (Two (Var 0) (Var 1))
                            (I64))
                          (irt.instr "return %2"))))
                    Ordinary))
                (& functions)))))
        (set! i (+ i 1))))
    (let
      [input-rows : i64
        (ir.compiler-source-spans-instr-count (& (clone spans)))]
      (match (opt-test-inline-program-with-spans
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        functions
        2
        spans)
        [(Program _ out-spans)
          (- (ir.compiler-source-spans-instr-count (& out-spans)) input-rows)]))))

(test
  optimizer-inline-span-rows-grow-linearly-with-callers
  (let
    [one : i64 (opt-inline-linear-span-instr-count 1)]
    [six : i64 (opt-inline-linear-span-instr-count 6)]
    (test.assert-true
      (> one 0)
      "an inlined located bounds check adds span rows")
    (test.assert-i64-eq
      six
      (* 6 one)
      "six rewritten callers add six times one caller's rows")))

(define (compiler-optimize-spans-non-inline-call-ok?) : bool
  (let
    [call : ir.CompilerIrInstr (irt.instr "%1 = call opaque(5) : i64")]
    [instrs : ir.CompilerIrInstrSeq
      (opt-test-instrs (clone call) (irt.instr "return %1"))]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (opt-spans-base)
        (opt-test-span-symbol "main")
        (& call)
        (opt-test-span 101 19))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-spans-program instrs))
      spans
      2)
      [(Program _ optimized-spans)
        (opt-span-lookup-ok?
          optimized-spans
          (opt-test-symbol "main")
          call
          101
          19)])))

(define (compiler-optimize-spans-pack-word-ok?) : bool
  (let
    [pack : ir.CompilerIrInstr (irt.instr "%2 = pack [%0, %1] : Pair")]
    [word : ir.CompilerIrInstr (Word 3 (Var 2) 0 (I64))]
    [tail : ir.CompilerIrInstr (irt.instr "tailcall* fn@tail_target() : i64")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%2 = pack [%0, %1] : Pair
         %3 = word %2, 0 : i64
         tailcall* fn@tail_target() : i64
         return %3")]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert-instr
          (ir.compiler-source-spans-insert-instr
            (opt-spans-base)
            (opt-test-span-symbol "main")
            (& pack)
            (opt-test-span 111 21))
          (opt-test-span-symbol "main")
          (& word)
          (opt-test-span 121 23))
        (opt-test-span-symbol "main")
        (& tail)
        (opt-test-span 131 25))]
    (match (opt.optimize-program-with-spans-and-level
      (& (opt-spans-program instrs))
      (ir.compiler-ir-global-shared-view spans)
      0)
      [(Program _ optimized-spans)
        (and
          (= (ir.compiler-source-spans-instr-count (& spans)) 2)
          (opt-span-lookup-ok? spans (opt-test-symbol "main") pack 111 21)
          (opt-span-lookup-ok? spans (opt-test-symbol "main") word 121 23)
          (opt-span-lookup-missing?
            spans
            (opt-test-symbol "main")
            (opt.compiler-opt-global-shared-view tail))
          (= (ir.compiler-source-spans-instr-count (& optimized-spans)) 2)
          (opt-span-lookup-ok?
            optimized-spans
            (opt-test-symbol "main")
            pack
            111
            21)
          (opt-span-lookup-ok?
            optimized-spans
            (opt-test-symbol "main")
            word
            121
            23)
          (opt-span-lookup-missing?
            optimized-spans
            (opt-test-symbol "main")
            tail))])))

(define (compiler-optimize-runtime-abort-span-filter-ok?) : bool
  (let
    [div : ir.CompilerIrInstr (irt.instr "%1 = div %0, 2 : i64")]
    [add : ir.CompilerIrInstr (irt.instr "%2 = add %0, 2 : i64")]
    [bounds : ir.CompilerIrInstr (BoundsCheck (Var 0) (I64 2) 19)]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [function : ir.CompilerIrSymbolId (ir.compiler-ir-symbol-typed-id 7)]
    [ok : bool
      (begin
        (ir.compiler-debug-info-set-enabled! false)
        (and
          (match (opt.opt-remap-spans-instr-key function div)
            [(SomeKey (Value found-function 1))
              (ir.compiler-ir-symbol-id-eq? found-function function)]
            [_ false])
          (match (opt.opt-remap-spans-instr-key function bounds)
            [(SomeKey (Bounds found-function 19))
              (ir.compiler-ir-symbol-id-eq? found-function function)]
            [_ false])
          (match (opt.opt-remap-spans-instr-key function add)
            [(NoKey) true]
            [_ false])))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    ok))

(define (opt-bounds-span-check [label : String]) : ir.CompilerIrInstr
  (BoundsCheck (Var 0) (Var 1) (ir.compiler-ir-label (& label))))

;; A BoundsCheck's span is keyed by its ok-label, and every clone family that
;; copies a KEPT check must uniquify that label (two blocks may not define one
;; assembly symbol) by appending `__bce_fast`, `__licm_false`, or `__u<digits>`.
;; The lookup strips one such suffix at a time, so the copy still reports the
;; source check it was cloned from; without that the backend degrades
;; `tl_oob_abort_at` (file:line:col plus index/length) to the bare
;; `tl_oob_abort` for every check a versioned fast clone keeps.
(define (compiler-optimize-spans-bounds-clone-suffix-ok?) : bool
  (let
    [checked : i64 (opt-test-symbol "main")]
    [elsewhere : i64 (opt-test-symbol "bce_span_probe_other_fn")]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr-located
        (opt-spans-base)
        (ir.compiler-ir-symbol-typed-id checked)
        (& (opt-bounds-span-check "bce_span_probe_body"))
        907
        (opt-test-span 44 12))]
    ;; Interned but never given a span: the miss below then proves the span is
    ;; absent rather than the stripped spelling being an unknown label.
    [absent : i64 (ir.compiler-ir-label "bce_span_probe_absent")]
    (and
      (>= absent 0)
      ;; An UNVERSIONED check keeps resolving exactly as before.
      (opt-location-lookup-ok?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body")
        907
        44
        12)
      ;; Each clone family's suffix falls back to the original check's span,
      ;; including the stacked spelling a versioned clone gets when unrolled.
      (opt-location-lookup-ok?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__bce_fast")
        907
        44
        12)
      (opt-location-lookup-ok?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__licm_false")
        907
        44
        12)
      (opt-location-lookup-ok?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__u0")
        907
        44
        12)
      (opt-location-lookup-ok?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__u12")
        907
        44
        12)
      (opt-location-lookup-ok?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__bce_fast__u1")
        907
        44
        12)
      ;; The fallback never invents a location: an unregistered base stays
      ;; unlocated, a look-alike no clone family produces is not stripped, and
      ;; the retry stays inside the function that owns the check.
      (opt-span-lookup-missing?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_absent__bce_fast"))
      (opt-span-lookup-missing?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__unusual"))
      (opt-span-lookup-missing?
        spans
        checked
        (opt-bounds-span-check "bce_span_probe_body__u"))
      (opt-span-lookup-missing?
        spans
        elsewhere
        (opt-bounds-span-check "bce_span_probe_body__bce_fast"))
      ;; The strip is only correct while the spellings above are the ones the
      ;; clone families actually append, so pin them at their producers.
      (compiler-optimize-spans-bounds-clone-suffix-producers-ok?))))

(define (compiler-optimize-spans-bounds-clone-suffix-producers-ok?) : bool
  (let
    [body : i64 (ir.compiler-ir-label "bce_span_probe_body")]
    [body-labels : opt.OptLabelSet (opt.opt-label-add (Nil) body)]
    (and
      (string.eq
        (ir.compiler-ir-label-text (opt.opt-bce-mb-fast-label body-labels body))
        "bce_span_probe_body__bce_fast")
      (string.eq
        (ir.compiler-ir-label-text
          (opt.opt-licm-unswitch-clone-label body-labels body))
        "bce_span_probe_body__licm_false")
      (string.eq (opt.opt-unroll-copy-suffix 0) "__u0")
      (string.eq (opt.opt-unroll-copy-suffix 12) "__u12"))))

(test
  bounds-check-clone-suffix-span-fallback
  (test.assert-true
    (compiler-optimize-spans-bounds-clone-suffix-ok?)
    "a kept bounds check inside a versioned/unswitched/unrolled clone resolves to the source check its suffixed ok-label was cloned from, so the backend keeps emitting the located tl_oob_abort_at, while an unregistered base, a non-clone look-alike suffix, and another function all stay unlocated"))

(define (compiler-optimize-spans-self-test) : i64
  (let
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        ;; Full instruction-span remapping is a debug-mode contract. Release
        ;; builds retain only abort-capable instructions to avoid hot-path cost.
        (ir.compiler-debug-info-set-enabled! true)
        (and
          (compiler-optimize-spans-dce-ok?)
          (compiler-optimize-spans-fold-ok?)
          (compiler-optimize-spans-cse-ok?)
          (compiler-optimize-dead-addrof-ok?)
          (compiler-optimize-spans-inline-callee-ok?)
          (compiler-optimize-spans-inline-fallback-ok?)
          (compiler-optimize-spans-inline-multiblock-ok?)
          (compiler-optimize-spans-non-inline-call-ok?)
          (compiler-optimize-spans-pack-word-ok?)
          (compiler-optimize-runtime-abort-span-filter-ok?)
          (compiler-optimize-spans-bounds-clone-suffix-ok?)))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    (if ok
      42
      1)))

(define (opt-aggregate-test-alloc) : ir.CompilerIrInstr
  (Call
    1
    cbi.compiler-builtin-id-tl-alloc
    (One (I64 16))
    (Struct (ci.intern "Pair"))))

(define (opt-aggregate-positive-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "%2 = gep %1, 0 : u8")
    (irt.instr "store_ptr %2, 10 : i64")
    (irt.instr "%3 = gep %1, 8 : u8")
    (irt.instr "store_ptr %3, true : bool")
    (irt.instr "%4 = gep %1, 0 : u8")
    (ir.CompilerIrInstr.Load 5 (Var 4) (I64))
    (irt.instr "return %5")))

(define (opt-aggregate-returned-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs (opt-aggregate-test-alloc) (irt.instr "return %1")))

(define (opt-aggregate-passed-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "%2 = call touch(%1) : unit")
    (irt.instr "return 0")))

(define (opt-aggregate-global-store-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "store @escaped, %1 : u64")
    (irt.instr "return 0")))

(define (opt-aggregate-store-through-other-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "store_ptr %99, %1 : u64")
    (irt.instr "return 0")))

(define (opt-aggregate-unknown-offset-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "%2 = gep %1, %9 : u8")
    (irt.instr "return 0")))

(define (opt-aggregate-call-separated-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "%2 = gep %1, 0 : u8")
    (irt.instr "store_ptr %2, 10 : i64")
    (irt.instr "%9 = call touch() : unit")
    (irt.instr "%3 = gep %1, 0 : u8")
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))
    (irt.instr "return %4")))

(define (opt-aggregate-predicated-memory-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-aggregate-test-alloc)
    (irt.instr "%2 = gep %1, 0 : u8")
    (irt.instr "store_ptr %2, 10 : i64")
    (ir.ir-instr-predicated-load 8 (Var 99) (I64 0) (Bool true) 4 (I64))
    (irt.instr "%3 = gep %1, 0 : u8")
    (ir.CompilerIrInstr.Load 4 (Var 3) (I64))
    (irt.instr "return %4")))

(define (opt-aggregate-phi-flowed-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "join:
         %2 = phi [%1, entry] : u64
         return 0")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-aggregate-test-alloc)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "join"))))))

(define (opt-aggregate-no-candidates? [instrs : ir.CompilerIrInstrSeq]) : bool
  (=
    (let
      [candidates
        (opt-aggregate-allocation-candidates
          (ast.ast-node-pool-reader-type-segment-bases)
          (opt-spans-program instrs))]
      (opt-aggregate-candidate-list-count candidates))
    0))

(define (opt-aggregate-phi-flowed-rejected?) : bool
  (=
    (let
      [candidates
        (opt-aggregate-allocation-candidates
          (ast.ast-node-pool-reader-type-segment-bases)
          (Program
            (ir.compiler-ir-global-seq-empty)
            (ir.compiler-ir-function-seq-prepend
              (&
                (Function
                  (opt-test-symbol "main")
                  (ir.compiler-ir-param-seq-empty)
                  (I64)
                  4
                  (opt-aggregate-phi-flowed-blocks)
                  Ordinary))
              (& (ir.compiler-ir-function-seq-empty)))
            (ir.compiler-ir-extern-seq-empty)))]
      (opt-aggregate-candidate-list-count candidates))
    0))

(define (opt-aggregate-positive-classified?) : bool
  (let
    [instrs : ir.CompilerIrInstrSeq (opt-aggregate-positive-instrs)]
    [instr-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [candidates : opt_aggregate_candidate_vec.Vec
      (opt-aggregate-allocation-candidates
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-spans-program instrs))]
    (if (= (opt-aggregate-candidate-list-count candidates) 1)
      (match (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) 0)
        [(Candidate base ty size ptrs accesses)
          (and
            (= base 1)
            (= size 16)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              ty
              (& (Struct (ci.intern "Pair"))))
            (= (opt-aggregate-pointer-list-count ptrs) 3)
            (= (opt_aggregate_access_vec.len (& accesses)) 3)
            (=
              (opt-aggregate-access-list-store-count
                (opt.compiler-opt-global-shared-view accesses))
              2)
            (=
              (opt-aggregate-access-list-load-count
                (opt.compiler-opt-global-shared-view accesses))
              1)
            (< (opt_aggregate_pointer_vec.capacity (& ptrs)) instr-count)
            (< (opt_aggregate_access_vec.capacity (& accesses)) instr-count))])
      false)))

;; Grow the append-ordered classifier scratch vector past its initial capacity.
;; The optimizer relies on the exact load/store order when it later promotes an
;; aggregate, so test both the interleaving and the metadata preserved by each
;; access entry.
(define (opt-aggregate-access-vector-growth-ok?) : bool
  (let
    [accesses : opt_aggregate_access_vec.Vec
      (opt_aggregate_access_vec.with-capacity 1)]
    (opt_aggregate_access_vec.push-ref!
      (&mut accesses)
      (opt.OptAggregateAccess.Store 0 (I64)))
    (opt_aggregate_access_vec.push-ref!
      (&mut accesses)
      (opt.OptAggregateAccess.Load 11 0 (I64)))
    (opt_aggregate_access_vec.push-ref!
      (&mut accesses)
      (opt.OptAggregateAccess.Store 8 (Bool)))
    (opt_aggregate_access_vec.push-ref!
      (&mut accesses)
      (opt.OptAggregateAccess.Load 12 8 (Bool)))
    (opt_aggregate_access_vec.push-ref!
      (&mut accesses)
      (opt.OptAggregateAccess.Store 16 (U64)))
    (and
      (= (opt_aggregate_access_vec.len (& accesses)) 5)
      (>= (opt_aggregate_access_vec.capacity (& accesses)) 5)
      (=
        (opt-aggregate-access-list-store-count
          (opt.compiler-opt-global-shared-view accesses))
        3)
      (=
        (opt-aggregate-access-list-load-count
          (opt.compiler-opt-global-shared-view accesses))
        2)
      (match (opt_aggregate_access_vec.get
        (& accesses)
        0
        (opt.OptAggregateAccess.Store -1 (Unit)))
        [(Store offset ty)
          (and
            (= offset 0)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              ty
              (& (I64))))]
        [_ false])
      (match (opt_aggregate_access_vec.get
        (& accesses)
        1
        (opt.OptAggregateAccess.Store -1 (Unit)))
        [(Load dst offset ty)
          (and
            (= dst 11)
            (= offset 0)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              ty
              (& (I64))))]
        [_ false])
      (match (opt_aggregate_access_vec.get
        (& accesses)
        2
        (opt.OptAggregateAccess.Store -1 (Unit)))
        [(Store offset ty)
          (and
            (= offset 8)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              ty
              (& (Bool))))]
        [_ false])
      (match (opt_aggregate_access_vec.get
        (& accesses)
        3
        (opt.OptAggregateAccess.Store -1 (Unit)))
        [(Load dst offset ty)
          (and
            (= dst 12)
            (= offset 8)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              ty
              (& (Bool))))]
        [_ false])
      (match (opt_aggregate_access_vec.get
        (& accesses)
        4
        (opt.OptAggregateAccess.Store -1 (Unit)))
        [(Store offset ty)
          (and
            (= offset 16)
            (opt.opt-type-eq
              (ast.ast-node-pool-reader-type-segment-bases)
              ty
              (& (U64))))]
        [_ false]))))

;; Exercise the three former hand-written scratch wrappers past their initial
;; capacity. Pointer facts must retain append order and newest-match lookup;
;; candidates and promotion slots must keep the same selection order.
(define (opt-aggregate-core-vector-growth-ok?) : bool
  (let
    [ptrs : opt_aggregate_pointer_vec.Vec
      (opt_aggregate_pointer_vec.with-capacity 1)]
    [candidates : opt_aggregate_candidate_vec.Vec
      (opt_aggregate_candidate_vec.with-capacity 1)]
    [promote-slots : opt_aggregate_promote_slot_vec.Vec
      (opt_aggregate_promote_slot_vec.with-capacity 1)]
    [index : i64 0]
    (while (< index 5)
      (opt_aggregate_pointer_vec.push-ref!
        (&mut ptrs)
        (opt.OptAggregatePointer.Pointer
          (if (or (= index 0) (= index 4))
            10
            (+ 10 index))
          (* index 8)))
      (opt_aggregate_candidate_vec.push-ref!
        (&mut candidates)
        (opt.OptAggregateAllocCandidate.Candidate
          index
          (Unit)
          (+ index 1)
          (opt_aggregate_pointer_vec.new)
          (opt_aggregate_access_vec.new)))
      (opt_aggregate_promote_slot_vec.push-ref!
        (&mut promote-slots)
        (opt.OptAggregatePromoteSlot.Slot index (+ 100 index)))
      (set! index (+ index 1)))
    (and
      (= (opt_aggregate_pointer_vec.len (& ptrs)) 5)
      (>= (opt_aggregate_pointer_vec.capacity (& ptrs)) 5)
      (= (opt_aggregate_candidate_vec.len (& candidates)) 5)
      (>= (opt_aggregate_candidate_vec.capacity (& candidates)) 5)
      (= (opt_aggregate_promote_slot_vec.len (& promote-slots)) 5)
      (>= (opt_aggregate_promote_slot_vec.capacity (& promote-slots)) 5)
      (match (opt_aggregate_pointer_vec.get
        (& ptrs)
        0
        (opt.OptAggregatePointer.Pointer -1 -1))
        [(Pointer var offset) (and (= var 10) (= offset 0))])
      (match (opt.opt-aggregate-pointer-list-lookup ptrs 10)
        [(Some offset) (= offset 32)]
        [(None) false])
      (match (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) 0)
        [(Candidate base _ size _ _) (and (= base 0) (= size 1))])
      (match (array-ref (opt_aggregate_candidate_vec.slots (& candidates)) 4)
        [(Candidate base _ size _ _) (and (= base 4) (= size 5))])
      (match (opt.opt-aggregate-promote-lookup promote-slots 4)
        [(Some storage) (= storage 104)]
        [(None) false]))))

(define (compiler-optimize-aggregate-candidate-self-test) : i64
  (cond
    [(not (opt-aggregate-positive-classified?)) 1]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-returned-instrs))) 2]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-passed-instrs))) 3]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-global-store-instrs))) 4]
    [(not
        (opt-aggregate-no-candidates?
          (opt-aggregate-store-through-other-instrs)))
      5]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-unknown-offset-instrs)))
      6]
    [(not (opt-aggregate-no-candidates? (opt-aggregate-call-separated-instrs)))
      7]
    [(not (opt-aggregate-phi-flowed-rejected?)) 8]
    [(not
        (opt-aggregate-no-candidates? (opt-aggregate-predicated-memory-instrs)))
      9]
    [(not (opt-aggregate-access-vector-growth-ok?)) 10]
    [(not (opt-aggregate-core-vector-growth-ok?)) 11]
    [(not
        (opt-aggregate-cross-block-candidates-rejected?
          (opt-aggregate-cross-block-load-blocks)))
      12]
    [(not
        (opt-aggregate-cross-block-candidates-rejected?
          (opt-aggregate-cross-block-load-blocks)))
      13]
    [(not
        (opt-aggregate-cross-block-flatten-order-ok?
          (opt-aggregate-cross-block-load-blocks)))
      14]
    [(not
        (opt-aggregate-cross-block-flatten-order-ok?
          (opt-aggregate-cross-block-load-blocks)))
      15]
    [else 42]))

(define (opt-aggregate-array-local-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Call
      1
      cbi.compiler-builtin-id-tl-alloc
      (One (I64 16))
      (ast.ast-ty-array (& (I64)) 2))
    (ir.CompilerIrInstr.Gep 2 (Var 1) (I64 0) (U8))
    (ir.CompilerIrInstr.StorePtr (Var 2) (Var 9) (ast.ast-ty-array (& (I64)) 2))
    (ir.CompilerIrInstr.Gep 3 (Var 1) (I64 0) (U8))
    (ir.CompilerIrInstr.Load 4 (Var 3) (ast.ast-ty-array (& (I64)) 2))
    (ir.CompilerIrInstr.Return (Some (I64 0)))))

(define (opt-count-tl-alloc-calls-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Call _ name _ _)
          (if (= name cbi.compiler-builtin-id-tl-alloc)
            1
            0)]
        [_ 0])
      (opt-count-tl-alloc-calls-from instrs (+ index 1)))))

(define (opt-count-tl-alloc-calls [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-tl-alloc-calls-from instrs 0))

(define (opt-count-ir-alloc-instrs-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(Alloc _ _) 1]
        [_ 0])
      (opt-count-ir-alloc-instrs-from instrs (+ index 1)))))

(define (opt-count-ir-alloc-instrs [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-ir-alloc-instrs-from instrs 0))

(define (opt-count-addr-of-instrs-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(AddrOf _ _) 1]
        [_ 0])
      (opt-count-addr-of-instrs-from instrs (+ index 1)))))

(define (opt-count-addr-of-instrs [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-addr-of-instrs-from instrs 0))

(define (opt-aggregate-promote-shape-ok? [instrs : ir.CompilerIrInstrSeq]) : bool
  (and
    (= (ir.compiler-ir-instr-seq-count instrs) 10)
    (match (ir.compiler-ir-instr-seq-ref instrs 0)
      [(Alloc first-dst first-ty)
        (match (ir.compiler-ir-instr-seq-ref instrs 1)
          [(Alloc second-dst second-ty)
            (match (ir.compiler-ir-instr-seq-ref instrs 2)
              [(AddrOf base storage)
                (and
                  (= first-dst 4)
                  (= second-dst 5)
                  (= storage 5)
                  (= base 1)
                  (opt.opt-type-eq
                    (ast.ast-node-pool-reader-type-segment-bases)
                    first-ty
                    (& second-ty)))]
              [_ false])]
          [_ false])]
      [_ false])))

(define (opt-aggregate-promote-test-function [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrFunction
  (opt.opt-aggregate-stack-promote-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-spans-function instrs)))

;; Self-test helper: materializes the optimized first block for dense fixture
;; assertions only, outside the production optimizer pipeline.
(define (opt-aggregate-promote-test-instrs [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (match (opt-aggregate-promote-test-function instrs)
    [(Function _ _ _ _ blocks _)
      (match (ir.compiler-ir-block-list-view blocks)
        [(slice block & _)
          (match (owned_view.compiler-owned-reference-shared-view block)
            [(Block _ optimized) optimized])]
        [(slice) (ir.compiler-ir-instr-seq-empty)])]))

(define (opt-aggregate-promote-test-frame [instrs : ir.CompilerIrInstrSeq]) : i64
  (match (opt-aggregate-promote-test-function instrs)
    [(Function _ _ _ frame _ _) frame]))

(define (compiler-optimize-aggregate-promote-self-test) : i64
  (let
    [positive : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-positive-instrs))]
    [returned : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-returned-instrs))]
    [passed : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-passed-instrs))]
    [stored : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-global-store-instrs))]
    [unknown-offset : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-unknown-offset-instrs))]
    [call-separated : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-call-separated-instrs))]
    [array-local : ir.CompilerIrInstrSeq
      (opt-aggregate-promote-test-instrs (opt-aggregate-array-local-instrs))]
    [level0 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt-spans-program (opt-aggregate-positive-instrs))
        0)]
    [level2 : ir.CompilerIrProgram
      (opt-test-optimize-program-with-level
        (opt-spans-program (opt-aggregate-positive-instrs))
        2)]
    (cond
      [(not (= (opt-count-tl-alloc-calls positive) 0)) 1]
      [(not (= (opt-count-ir-alloc-instrs positive) 2)) 2]
      [(not (= (opt-count-addr-of-instrs positive) 1)) 3]
      [(not (opt-aggregate-promote-shape-ok? positive)) 4]
      [(not
          (=
            (opt-aggregate-promote-test-frame (opt-aggregate-positive-instrs))
            6))
        5]
      [(not (= (opt-count-tl-alloc-calls returned) 1)) 6]
      [(not (= (opt-count-tl-alloc-calls passed) 1)) 7]
      [(not (= (opt-count-tl-alloc-calls stored) 1)) 8]
      [(not (= (opt-count-tl-alloc-calls unknown-offset) 1)) 9]
      [(not (= (opt-count-tl-alloc-calls call-separated) 1)) 10]
      [(not (= (opt-count-tl-alloc-calls array-local) 1)) 11]
      [(not
          (=
            (let
              [instrs (opt-program-first-instrs level0)]
              (opt-count-tl-alloc-calls instrs))
            1))
        12]
      [(not
          (=
            (let
              [instrs (opt-program-first-instrs level2)]
              (opt-count-tl-alloc-calls instrs))
            0))
        13]
      [else 42])))

(define (opt-aggregate-cross-block-load-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "next:
         %3 = gep %1, 0 : u8
         %4 = load %3 : i64
         return %4")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-aggregate-test-alloc)
        (irt.instr "%2 = gep %1, 0 : u8")
        (irt.instr "store_ptr %2, 10 : i64")
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "next"))))))

(define (opt-aggregate-cross-block-candidates-rejected?
  [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [program : ir.CompilerIrProgram
      (Program
        (ir.compiler-ir-global-seq-empty)
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (opt-test-symbol "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              4
              blocks
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))
        (ir.compiler-ir-extern-seq-empty))]
    [candidates : opt_aggregate_candidate_vec.Vec
      (opt-aggregate-allocation-candidates
        (ast.ast-node-pool-reader-type-segment-bases)
        program)]
    (= (opt-aggregate-candidate-list-count candidates) 0)))

(define (opt-aggregate-cross-block-flatten-order-ok?
  [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [instrs : ir.CompilerIrInstrSeq
      (opt.opt-aggregate-flatten-blocks (& blocks))]
    (and
      (= (ir.compiler-ir-instr-seq-count instrs) 7)
      (match (ir.compiler-ir-instr-seq-ref instrs 0)
        [(Call dst name _ _)
          (and (= dst 1) (= name cbi.compiler-builtin-id-tl-alloc))]
        [_ false])
      (match (ir.compiler-ir-instr-seq-ref instrs 1)
        [(Gep dst (Var src) (I64 offset) _)
          (and (= dst 2) (= src 1) (= offset 0))]
        [_ false])
      (match (ir.compiler-ir-instr-seq-ref instrs 2)
        [(StorePtr (Var ptr) (I64 value) _) (and (= ptr 2) (= value 10))]
        [_ false])
      (match (ir.compiler-ir-instr-seq-ref instrs 3)
        [(Jump label)
          (ir.compiler-ir-symbol-eq? label (ir.compiler-ir-label "next"))]
        [_ false])
      (match (ir.compiler-ir-instr-seq-ref instrs 4)
        [(Gep dst (Var src) (I64 offset) _)
          (and (= dst 3) (= src 1) (= offset 0))]
        [_ false])
      (match (ir.compiler-ir-instr-seq-ref instrs 5)
        [(Load dst (Var src) _) (and (= dst 4) (= src 3))]
        [_ false])
      (match (ir.compiler-ir-instr-seq-ref instrs 6)
        [(Return (Some (Var value))) (= value 4)]
        [_ false]))))

(define (opt-count-mov-i64-value-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [needle : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-mov-i64-value-instr-seq instrs needle)
            (opt-count-mov-i64-value-blocks rest needle))])]))

;; --- SROA-2: aggregate word split -------------------------------------------
;;
;; Fixtures for compiler_optimize's `aggregate_split`. Each one is a whole
;; function so the pass sees the joins it exists for; the negatives assert the
;; pass leaves the memory object exactly where it was.
(define (opt-agsplit-kind-load) : i64
  1)

(define (opt-agsplit-kind-tl-alloc) : i64
  2)

(define (opt-agsplit-kind-store-ptr) : i64
  3)

(define (opt-agsplit-kind-copy-bytes) : i64
  4)

(define (opt-agsplit-kind-return-literal) : i64
  5)

(define (opt-agsplit-kind-gep) : i64
  6)

;; One instruction's contribution to the requested census. `arg` is the literal
;; a `return-literal` row must carry; it is ignored by every other kind.
(define (opt-agsplit-count-instr
  [instr : ir.CompilerIrInstr]
  [kind : i64]
  [arg : i64]) : i64
  (cond
    [(= kind (opt-agsplit-kind-load))
      (match instr
        [(Load _ _ _) 1]
        [_ 0])]
    [(= kind (opt-agsplit-kind-tl-alloc))
      (match instr
        [(Call _ name _ _)
          (if (= name cbi.compiler-builtin-id-tl-alloc)
            1
            0)]
        [_ 0])]
    [(= kind (opt-agsplit-kind-store-ptr))
      (match instr
        [(StorePtr _ _ _) 1]
        [_ 0])]
    [(= kind (opt-agsplit-kind-copy-bytes))
      (match instr
        [(CopyBytes _ _ _) 1]
        [_ 0])]
    [(= kind (opt-agsplit-kind-gep))
      (match instr
        [(Gep _ _ _ _) 1]
        [_ 0])]
    [(= kind (opt-agsplit-kind-return-literal))
      (match instr
        [(Return maybe)
          (match maybe
            [(Some value)
              (match value
                [(I64 literal)
                  (if (= literal arg)
                    1
                    0)]
                [_ 0])]
            [(No) 0])]
        [_ 0])]
    [else 0]))

(define (opt-agsplit-count-seq
  [instrs : ir.CompilerIrInstrSeq]
  [kind : i64]
  [arg : i64]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-agsplit-count-instr
        (ir.compiler-ir-instr-seq-ref instrs index)
        kind
        arg)
      (opt-agsplit-count-seq instrs kind arg (+ index 1)))))

(define (opt-agsplit-count-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [kind : i64]
  [arg : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (+
        (match (owned_view.compiler-owned-reference-shared-view block)
          [(Block _ instrs) (opt-agsplit-count-seq instrs kind arg 0)])
        (opt-agsplit-count-blocks rest kind arg))]))

(define (opt-agsplit-count-function
  [func : (& func ir.CompilerIrFunction)]
  [kind : i64]
  [arg : i64]) : i64
  (match func
    [(Function _ _ _ _ blocks _)
      (opt-agsplit-count-blocks
        (ir.compiler-ir-block-list-view blocks)
        kind
        arg)]))

(define (opt-agsplit-function [blocks : ir.CompilerIrBlockList] [frame : i64]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "main")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    frame
    blocks
    Ordinary))

(define (opt-agsplit-split [blocks : ir.CompilerIrBlockList] [frame : i64]) : ir.CompilerIrFunction
  (opt.opt-aggregate-split-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (opt-agsplit-function blocks frame)))

;; The whole level-2 pipeline over the same fixture, which is where the packet's
;; claim actually lands: the split feeds `ssa`, `ssa` builds the phi, and `sccp`
;; and `thread_branch` decide the match the phi now carries.
(define (opt-agsplit-optimized [blocks : ir.CompilerIrBlockList] [frame : i64]) : ir.CompilerIrFunction
  (match (opt-test-optimize-program-with-level
    (Program
      (ir.compiler-ir-global-seq-empty)
      (ir.compiler-ir-function-seq-prepend
        (& (opt-agsplit-function blocks frame))
        (& (ir.compiler-ir-function-seq-empty)))
      (ir.compiler-ir-extern-seq-empty))
    2)
    [(Program _ funcs _) (ir.compiler-ir-function-seq-ref funcs 0)]))

(define (opt-agsplit-alloc [dst : i64] [size : i64]) : ir.CompilerIrInstr
  (Call
    dst
    cbi.compiler-builtin-id-tl-alloc
    (One (I64 size))
    (Struct (ci.intern "Pair"))))

(define (opt-agsplit-gep [dst : i64] [base : i64] [offset : i64]) : ir.CompilerIrInstr
  (Gep dst (Var base) (I64 offset) (U8)))

(define (opt-agsplit-store-literal [ptr : i64] [literal : i64]) : ir.CompilerIrInstr
  (StorePtr (Var ptr) (I64 literal) (I64)))

(define (opt-agsplit-load [dst : i64] [ptr : i64]) : ir.CompilerIrInstr
  (Load dst (Var ptr) (I64)))

(define (opt-agsplit-block [label : String] [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlock
  (Block (ir.compiler-ir-label (& label)) instrs))

;; POSITIVE. Three match arms store the same tag into word 0 of a two-word
;; aggregate; the join reloads it and compares. After the split the tag is a phi
;; of three identical literals, so `sccp` folds the compare and the else arm is
;; unreachable -- which the pre-split pipeline cannot do, because the load has
;; no single dominating store.
(define (opt-agsplit-join-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (ir.CompilerIrInstr.EntryArgc 2)
        (ir.CompilerIrInstr.BinOp 3 Eq (Var 2) (I64 0) (I64))
        (ir.CompilerIrInstr.Branch
          (Var 3)
          (ir.compiler-ir-label "arm0")
          (ir.compiler-ir-label "next1"))))
    (opt-agsplit-block
      "arm0"
      (opt-test-instrs
        (opt-agsplit-gep 4 1 0)
        (opt-agsplit-store-literal 4 7)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "cont"))))
    (opt-agsplit-block
      "next1"
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp 5 Eq (Var 2) (I64 1) (I64))
        (ir.CompilerIrInstr.Branch
          (Var 5)
          (ir.compiler-ir-label "arm1")
          (ir.compiler-ir-label "arm2"))))
    (opt-agsplit-block
      "arm1"
      (opt-test-instrs
        (opt-agsplit-gep 6 1 0)
        (opt-agsplit-store-literal 6 7)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "cont"))))
    (opt-agsplit-block
      "arm2"
      (opt-test-instrs
        (opt-agsplit-gep 7 1 0)
        (opt-agsplit-store-literal 7 7)
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "cont"))))
    (opt-agsplit-block
      "cont"
      (opt-test-instrs
        (opt-agsplit-gep 8 1 0)
        (opt-agsplit-load 9 8)
        (ir.CompilerIrInstr.BinOp 10 Eq (Var 9) (I64 7) (I64))
        (ir.CompilerIrInstr.Branch
          (Var 10)
          (ir.compiler-ir-label "hit")
          (ir.compiler-ir-label "miss"))))
    (opt-agsplit-block
      "hit"
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 100)))))
    (opt-agsplit-block
      "miss"
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 200)))))))

;; POSITIVE. A whole-size `copy_bytes` with BOTH sides split becomes register
;; moves, and the load out of the destination becomes a register read.
(define (opt-agsplit-copy-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (opt-agsplit-alloc 2 16)
        (opt-agsplit-gep 3 2 0)
        (opt-agsplit-store-literal 3 9)
        (opt-agsplit-gep 4 2 8)
        (opt-agsplit-store-literal 4 11)
        (ir.CompilerIrInstr.CopyBytes (Var 1) (Var 2) 16)
        (opt-agsplit-gep 5 1 8)
        (opt-agsplit-load 6 5)
        (ir.CompilerIrInstr.Return (Some (Var 6)))))))

;; NEGATIVE: escape:call. The aggregate is an argument of a direct call, in the
;; friendliest position there is -- last statement of a returning block, nothing
;; reads it afterwards. It is still refused: the callee reads the buffer, so the
;; storage must exist at the call and every word would have to be written back
;; there, which is a loss (see opt-aggregate-split-refuse-args!).
(define (opt-agsplit-call-arg-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (opt-agsplit-gep 2 1 0)
        (opt-agsplit-store-literal 2 5)
        (opt-agsplit-gep 3 1 8)
        (opt-agsplit-store-literal 3 6)
        (opt-agsplit-gep 4 1 0)
        (opt-agsplit-load 5 4)
        (ir.CompilerIrInstr.Call
          6
          (opt-test-symbol "touch")
          (One (Var 1))
          (Unit))
        (ir.CompilerIrInstr.Return (Some (Var 5)))))))

;; NEGATIVE: escape:call. The same call, but the aggregate is read again after
;; it, so the callee's view of the buffer is observable and the split refuses.
(define (opt-agsplit-escape-call-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (opt-agsplit-gep 2 1 0)
        (opt-agsplit-store-literal 2 5)
        (ir.CompilerIrInstr.Call
          3
          (opt-test-symbol "touch")
          (One (Var 1))
          (Unit))
        (opt-agsplit-gep 4 1 0)
        (opt-agsplit-load 5 4)
        (ir.CompilerIrInstr.Return (Some (Var 5)))))))

;; A `bool` store / load at byte `offset` of the aggregate at var 1.
(define (opt-agsplit-store-bool [ptr : i64] [value : bool]) : ir.CompilerIrInstr
  (StorePtr (Var ptr) (Bool value) (Bool)))

(define (opt-agsplit-load-bool [dst : i64] [ptr : i64]) : ir.CompilerIrInstr
  (Load dst (Var ptr) (Bool)))

;; POSITIVE lanes (#8555). An `I64Range`-shaped aggregate: an `i64` word and
;; two `bool` flags packed into the third word at bytes 16 and 17. Each flag is
;; a lane of its own, so the split takes the whole object, and the branch on
;; the first flag folds once SSA and `sccp` see its stored literal.
(define (opt-agsplit-lanes-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 24)
        (opt-agsplit-gep 2 1 0)
        (opt-agsplit-store-literal 2 7)
        (opt-agsplit-gep 3 1 16)
        (opt-agsplit-store-bool 3 false)
        (opt-agsplit-gep 4 1 17)
        (opt-agsplit-store-bool 4 true)
        (opt-agsplit-gep 5 1 16)
        (opt-agsplit-load-bool 6 5)
        (opt-agsplit-gep 7 1 17)
        (opt-agsplit-load-bool 8 7)
        (ir.CompilerIrInstr.Branch
          (Var 6)
          (ir.compiler-ir-label "flagged")
          (ir.compiler-ir-label "plain"))))
    (opt-agsplit-block
      "flagged"
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 200)))))
    (opt-agsplit-block
      "plain"
      (opt-test-instrs
        (opt-agsplit-gep 9 1 0)
        (opt-agsplit-load 10 9)
        (ir.CompilerIrInstr.Branch
          (Var 8)
          (ir.compiler-ir-label "done")
          (ir.compiler-ir-label "flagged"))))
    (opt-agsplit-block
      "done"
      (opt-test-instrs (ir.CompilerIrInstr.Return (Some (I64 100)))))))

;; NEGATIVE: access:word-type. A word read whole that is also written as an
;; `i32` lane: a word is one var or a set of lanes, never both.
(define (opt-agsplit-lane-overlap-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (opt-agsplit-gep 2 1 0)
        (ir.CompilerIrInstr.StorePtr (Var 2) (I64 5) (I32))
        (opt-agsplit-gep 3 1 0)
        (opt-agsplit-load 4 3)
        (ir.CompilerIrInstr.Return (Some (Var 4)))))))

;; NEGATIVE: access:copy-lanes. A whole-object copy over a word of lanes would
;; have to carry the bytes no lane names.
(define (opt-agsplit-copy-lanes-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (ir.CompilerIrInstr.EntryArgv 2)
        (ir.CompilerIrInstr.CopyBytes (Var 1) (Var 2) 16)
        (opt-agsplit-gep 3 1 8)
        (opt-agsplit-load-bool 4 3)
        (ir.CompilerIrInstr.Return (Some (Var 4)))))))

;; NEGATIVE: ptr:gep-scale. A gep whose offset is not a literal.
(define (opt-agsplit-dynamic-gep-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (ir.CompilerIrInstr.EntryArgc 2)
        (ir.CompilerIrInstr.Gep 3 (Var 1) (Var 2) (U8))
        (opt-agsplit-load 4 3)
        (ir.CompilerIrInstr.Return (Some (Var 4)))))))

;; NEGATIVE: access:copy-size. A partial copy overlaps a word.
(define (opt-agsplit-partial-copy-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (ir.CompilerIrInstr.EntryArgv 2)
        (ir.CompilerIrInstr.CopyBytes (Var 1) (Var 2) 12)
        (opt-agsplit-gep 3 1 0)
        (opt-agsplit-load 4 3)
        (ir.CompilerIrInstr.Return (Some (Var 4)))))))

;; NEGATIVE: escape:use. The pointer itself is stored to memory.
(define (opt-agsplit-stored-pointer-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (opt-agsplit-block
      "entry"
      (opt-test-instrs
        (opt-agsplit-alloc 1 16)
        (ir.CompilerIrInstr.Store (opt-test-symbol "escaped") (Var 1) (U64))
        (opt-agsplit-gep 2 1 0)
        (opt-agsplit-load 3 2)
        (ir.CompilerIrInstr.Return (Some (Var 3)))))))

(define (compiler-optimize-aggregate-split-self-test) : i64
  (let
    [join-split : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-join-blocks) 12)]
    [join-opt : ir.CompilerIrFunction
      (opt-agsplit-optimized (opt-agsplit-join-blocks) 12)]
    [copy-split : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-copy-blocks) 8)]
    [copy-opt : ir.CompilerIrFunction
      (opt-agsplit-optimized (opt-agsplit-copy-blocks) 8)]
    [call-arg : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-call-arg-blocks) 8)]
    [escape-call : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-escape-call-blocks) 8)]
    [lanes : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-lanes-blocks) 11)]
    [lanes-opt : ir.CompilerIrFunction
      (opt-agsplit-optimized (opt-agsplit-lanes-blocks) 11)]
    [lane-overlap : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-lane-overlap-blocks) 5)]
    [copy-lanes : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-copy-lanes-blocks) 5)]
    [dynamic-gep : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-dynamic-gep-blocks) 6)]
    [partial-copy : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-partial-copy-blocks) 6)]
    [stored-pointer : ir.CompilerIrFunction
      (opt-agsplit-split (opt-agsplit-stored-pointer-blocks) 5)]
    (cond
      ;; POSITIVE join: the memory object and every access to it are gone.
      [(!=
          (opt-agsplit-count-function join-split (opt-agsplit-kind-tl-alloc) 0)
          0)
        1]
      [(!= (opt-agsplit-count-function join-split (opt-agsplit-kind-load) 0) 0)
        2]
      [(!=
          (opt-agsplit-count-function join-split (opt-agsplit-kind-store-ptr) 0)
          0)
        3]
      ;; ...and the phi the split exposes lets sccp/thread_branch decide the
      ;; match: the miss arm is unreachable afterwards.
      [(!=
          (opt-agsplit-count-function
            join-opt
            (opt-agsplit-kind-return-literal)
            200)
          0)
        4]
      [(<
          (opt-agsplit-count-function
            join-opt
            (opt-agsplit-kind-return-literal)
            100)
          1)
        5]
      ;; POSITIVE copy: both sides split, so the copy is register moves.
      [(!=
          (opt-agsplit-count-function
            copy-split
            (opt-agsplit-kind-copy-bytes)
            0)
          0)
        6]
      [(!=
          (opt-agsplit-count-function copy-split (opt-agsplit-kind-tl-alloc) 0)
          0)
        7]
      [(!= (opt-agsplit-count-function copy-split (opt-agsplit-kind-load) 0) 0)
        8]
      [(!=
          (opt-agsplit-count-function
            copy-opt
            (opt-agsplit-kind-return-literal)
            11)
          1)
        9]
      ;; NEGATIVE call argument: the storage, the stores and the load all stay.
      [(!=
          (opt-agsplit-count-function call-arg (opt-agsplit-kind-tl-alloc) 0)
          1)
        10]
      [(!= (opt-agsplit-count-function call-arg (opt-agsplit-kind-load) 0) 1)
        11]
      [(!=
          (opt-agsplit-count-function call-arg (opt-agsplit-kind-store-ptr) 0)
          2)
        12]
      ;; NEGATIVES: every refusal class leaves the memory object alone.
      [(!= (opt-agsplit-count-function escape-call (opt-agsplit-kind-load) 0) 1)
        13]
      ;; POSITIVE lanes: no memory object, no access left, and the folded
      ;; flag retires the arm that returns 200.
      [(!= (opt-agsplit-count-function lanes (opt-agsplit-kind-load) 0) 0) 14]
      [(!= (opt-agsplit-count-function lanes (opt-agsplit-kind-store-ptr) 0) 0)
        18]
      [(!= (opt-agsplit-count-function lanes (opt-agsplit-kind-tl-alloc) 0) 0)
        19]
      [(!=
          (opt-agsplit-count-function
            lanes-opt
            (opt-agsplit-kind-return-literal)
            200)
          0)
        20]
      [(!=
          (opt-agsplit-count-function lane-overlap (opt-agsplit-kind-load) 0)
          1)
        21]
      [(!=
          (opt-agsplit-count-function
            copy-lanes
            (opt-agsplit-kind-copy-bytes)
            0)
          1)
        22]
      [(!= (opt-agsplit-count-function dynamic-gep (opt-agsplit-kind-load) 0) 1)
        15]
      [(!=
          (opt-agsplit-count-function
            partial-copy
            (opt-agsplit-kind-copy-bytes)
            0)
          1)
        16]
      [(!=
          (opt-agsplit-count-function stored-pointer (opt-agsplit-kind-load) 0)
          1)
        17]
      [else 42])))

;; Reuse the branch/copy/escape fixtures with the runtime String descriptor
;; type. Only the allocation type changes; its complete use graph stays intact.
(define (opt-agsplit-string-instr [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match (opt.compiler-opt-global-shared-view instr)
    [(Call dst name args ty)
      (Call
        dst
        name
        args
        (if (= name cbi.compiler-builtin-id-tl-alloc)
          (String)
          ty))]
    [_ instr]))

(define (opt-agsplit-string-blocks [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [out : ir.CompilerIrBlockBuilder (ir.compiler-ir-block-builder-new)]
    [count : i64 (ir.compiler-ir-block-list-count blocks)]
    [i : i64 0]
    (while (< i count)
      (match (opt-cmp-dup-block-at blocks i)
        [(Block label instrs)
          (let
            [b : ir.CompilerIrInstrBuilder (ir.compiler-ir-instr-builder-new)]
            [j : i64 0]
            (while (< j instrs.len)
              (ir.compiler-ir-instr-builder-push!
                (&mut b)
                (opt-agsplit-string-instr
                  (ir.compiler-ir-instr-seq-ref instrs j)))
              (set! j (+ j 1)))
            (ir.compiler-ir-block-builder-push!
              (&mut out)
              (ir.CompilerIrBlock.Block
                label
                (ir.compiler-ir-instr-builder-to-seq b))))])
      (set! i (+ i 1)))
    (ir.compiler-ir-block-builder-to-list out)))

(test
  local-string-descriptor-splitting
  (let
    [mode : i64 0]
    (while (< mode 8)
      (let
        [blocks : ir.CompilerIrBlockList
          (opt-agsplit-string-blocks
            (cond
              [(= mode 0) (opt-agsplit-join-blocks)]
              [(= mode 1) (opt-agsplit-copy-blocks)]
              [(= mode 2) (opt-agsplit-call-arg-blocks)]
              [(= mode 3) (opt-agsplit-escape-call-blocks)]
              [(= mode 4) (opt-agsplit-lane-overlap-blocks)]
              [(= mode 5) (opt-agsplit-dynamic-gep-blocks)]
              [(= mode 6) (opt-agsplit-partial-copy-blocks)]
              [else (opt-agsplit-stored-pointer-blocks)]))]
        [out : ir.CompilerIrFunction (opt-agsplit-split blocks 12)]
        (test.assert-i64-eq
          (opt-agsplit-count-function out (opt-agsplit-kind-tl-alloc) 0)
          (if (< mode 2)
            0
            1)
          "split private String words, retain escaped or incompatible storage")
        (set! mode (+ mode 1)))))
  (test.assert-i64-eq
    (let
      [func
        (opt-agsplit-optimized
          (opt-agsplit-string-blocks (opt-agsplit-copy-blocks))
          12)]
      (opt-agsplit-count-function func (opt-agsplit-kind-return-literal) 11))
    1
    "descriptor copying preserves its length through the whole pipeline")
  (test.assert-i64-eq
    (let
      [func
        (opt-agsplit-split
          (ir.compiler-ir-blocks
            (opt-agsplit-block
              "entry"
              (opt-test-instrs
                (opt-agsplit-string-instr (opt-agsplit-alloc 1 16))
                (opt-agsplit-gep 2 1 8)
                (opt-agsplit-store-literal 2 11)
                (opt-agsplit-load 3 2)
                (irt.instr "store_owned %3 -> %1 : String")
                (irt.instr "return %3"))))
          6)]
      (opt-agsplit-count-function func (opt-agsplit-kind-tl-alloc) 0))
    1
    "an ownership edge retains the String descriptor")
  (let
    [mode : i64 0]
    (while (< mode 3)
      (test.assert-true
        (match (opt.opt-aggregate-split-direct-alloc
          (&
            (Call
              1
              (if (= mode 0)
                (opt-test-symbol "foreign-alloc")
                cbi.compiler-builtin-id-tl-alloc)
              (One
                (I64
                  (if (= mode 0)
                    16
                    (if (= mode 1)
                      8
                      24))))
              (String))))
          [(No) true]
          [_ false])
        "only the exact 16-byte runtime String descriptor is admitted")
      (set! mode (+ mode 1)))))

(define (opt-count-cast-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-cast-instr-seq-from
      slots
      (+ index 1)
      count
      (+
        acc
        (match (array-ref slots index)
          [(Cast _ _ _ _) 1]
          [_ 0])))))

(define (opt-count-cast-instr-seq [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-cast-instr-seq-from instrs.slots 0 instrs.len 0))

;; Builds `[Mov v0=20, Mov v1=22, BinOp v2 = v0 + v1]` (one arithmetic instr).
(define (opt-self-test-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = mov 20 : i64
     %1 = mov 22 : i64
     %2 = add %0, %1 : i64"))

(define (opt-stale-load-test-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = mov 41 : i64
     %0 = load %9 : i64
     %1 = add %0, 1 : i64"))

(define (opt-vector-mask-test-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Mov 0 (I64 3) (I64))
    (ir.CompilerIrInstr.Mov 1 (I64 4) (I64))
    (ir.CompilerIrInstr.Splat 2 (Var 0) 4 (I64))
    (ir.CompilerIrInstr.LaneId 3 4 (I64))
    (irt.instr "%4 = tail_mask %0, %1 lanes 4")
    (ir.ir-instr-vector-bin-op 5 (Add) (Var 2) (Var 3) 4 (I64))
    (ir.ir-instr-select 6 (Var 4) (Var 5) (Var 2) 4 (I64))
    (ir.ir-instr-predicated-store (Var 8) (Var 0) (Var 6) (Var 4) 4 (I64))))

(define (opt-vector-cse-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.ir-instr-vector-bin-op 2 (Add) (Var 0) (Var 1) 4 (I64))
    (ir.ir-instr-vector-bin-op 3 (Add) (Var 0) (Var 1) 4 (I64))))

(define (opt-vector-reduce-cse-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = vector_reduce_sum %0 lanes 4 : i64
     %2 = vector_reduce_sum %0 lanes 4 : i64"))

(define (opt-vector-reduce-stale-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov 10 : i64
     %1 = vector_reduce_sum %0 lanes 4 : i64
     %2 = add %1, 1 : i64"))

(define (opt-vector-copy-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Mov 2 (Var 0) (I64))
    (ir.ir-instr-vector-bin-op 3 (Add) (Var 2) (Var 1) 4 (I64))))

(define (opt-mask-copy-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%2 = mov %0 : bool
     %3 = mask_and %2, %1 lanes 4"))

(define (opt-mask-reduce-copy-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%1 = mov %0 : bool
     %2 = mask_reduce_any %1 lanes 4"))

(define (opt-mask-not-copy-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov %0 : bool
     %2 = mask_not %1 lanes 4
     %4 = mov true : bool
     %5 = mask_not %4 lanes 4"))

(define (opt-mask-idempotent-copy-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov %0 : bool
     %2 = mask_or %1, %1 lanes 4
     %3 = mask_reduce_any %2 lanes 4
     %4 = mask_and %1, %1 lanes 4
     %5 = mask_reduce_any %4 lanes 4"))

(define (opt-count-vector-binop-instrs-from-index
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(VectorBinOp _) 1]
        [_ 0])
      (opt-count-vector-binop-instrs-from-index instrs (+ index 1)))))

(define (opt-count-vector-binop-instrs
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-vector-binop-instrs-from-index instrs 0))

(define (opt-count-vector-reduce-instrs-from-index
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs index)
        [(VectorReduce _ _ _ _ _) 1]
        [_ 0])
      (opt-count-vector-reduce-instrs-from-index instrs (+ index 1)))))

(define (opt-count-vector-reduce-instrs
  [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-vector-reduce-instrs-from-index instrs 0))

(define (opt-vector-binop-lhs-var-from
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(VectorBinOp (box (fields [d dst] lhs)))
        (if (= d dst)
          (match lhs
            [(Var id) id]
            [_ (- 0 1)])
          (opt-vector-binop-lhs-var-from instrs (+ index 1) dst))]
      [_ (opt-vector-binop-lhs-var-from instrs (+ index 1) dst)])))

(define (opt-vector-binop-lhs-var [instrs : ir.CompilerIrInstrSeq] [dst : i64]) : i64
  (opt-vector-binop-lhs-var-from instrs 0 dst))

(define (opt-mask-binop-lhs-var-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(MaskBinOp d _ lhs _ _)
        (if (= d dst)
          (match lhs
            [(Var id) id]
            [_ (- 0 1)])
          (opt-mask-binop-lhs-var-from instrs (+ index 1) dst))]
      [_ (opt-mask-binop-lhs-var-from instrs (+ index 1) dst)])))

(define (opt-mask-binop-lhs-var
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]) : i64
  (opt-mask-binop-lhs-var-from instrs 0 dst))

(define (opt-mask-reduce-src-var-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(MaskReduce d _ src _)
        (if (= d dst)
          (match src
            [(Var id) id]
            [_ (- 0 1)])
          (opt-mask-reduce-src-var-from instrs (+ index 1) dst))]
      [_ (opt-mask-reduce-src-var-from instrs (+ index 1) dst)])))

(define (opt-mask-reduce-src-var
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]) : i64
  (opt-mask-reduce-src-var-from instrs 0 dst))

(define (opt-mask-not-src-var-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(MaskNot d src _)
        (if (= d dst)
          (match src
            [(Var id) id]
            [_ (- 0 1)])
          (opt-mask-not-src-var-from instrs (+ index 1) dst))]
      [_ (opt-mask-not-src-var-from instrs (+ index 1) dst)])))

(define (opt-mask-not-src-var
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [dst : i64]) : i64
  (opt-mask-not-src-var-from instrs 0 dst))

(define (compiler-optimize-vector-mask-self-test) : i64
  (let
    [instrs : ir.CompilerIrInstrSeq (opt-vector-mask-test-instrs)]
    [folded : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt.compiler-opt-global-shared-view instrs))]
    [dce : ir.CompilerIrInstrSeq
      (let
        [set
          (opt-test-collect-instrs-uses
            (opt_i64_i64_map.with-capacity 64)
            instrs)]
        (opt-test-dce-instrs set instrs))]
    [bounds : ir.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (Empty)
        (opt.compiler-opt-global-shared-view instrs))]
    [vector-cse : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-vector-cse-instrs))]
    [vector-reduce-cse : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-vector-reduce-cse-instrs))]
    [vector-stale : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-vector-reduce-stale-instrs))]
    [vector-copy : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-vector-copy-instrs))]
    [mask-copy : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-mask-copy-instrs))]
    [mask-reduce-copy : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-mask-reduce-copy-instrs))]
    [mask-not-copy : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs (opt.opt-copy-env-empty) (opt-mask-not-copy-instrs))]
    [mask-idempotent-copy : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt-test-fold-instrs
          (ast.ast-node-pool-reader-type-segment-bases)
          (Nil)
          (opt-mask-idempotent-copy-instrs)))]
    [mask-idempotent-dce : ir.CompilerIrInstrSeq
      (let
        [set
          (opt-test-collect-instrs-uses
            (opt_i64_i64_map.with-capacity 64)
            mask-idempotent-copy)]
        (opt-test-dce-instrs set mask-idempotent-copy))]
    (cond
      [(not
          (opt-test-instr-seq-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            folded
            instrs))
        1]
      [(not (= (ir.compiler-ir-instr-seq-count dce) 8)) 2]
      [(not (= (ir.compiler-ir-instr-seq-count bounds) 8)) 3]
      [(not (= (opt-count-vector-binop-instrs vector-cse) 1)) 4]
      [(not
          (= (opt-mov-dst-type-tag vector-cse 3) (ast.ast-type-tag (& (I64)))))
        5]
      [(not (= (opt-count-vector-reduce-instrs vector-reduce-cse) 2)) 6]
      [(not (= (opt-mov-dst-type-tag vector-reduce-cse 2) 0)) 7]
      [(not (= (opt-count-arith-instr-seq vector-stale) 1)) 8]
      [(not (= (opt-count-mov-i64-value-instr-seq vector-stale 11) 0)) 9]
      [(not (= (opt-vector-binop-lhs-var vector-copy 3) 0)) 10]
      [(not (= (opt-mask-binop-lhs-var mask-copy 3) 0)) 11]
      [(not (= (opt-mask-reduce-src-var mask-reduce-copy 2) 0)) 12]
      [(not (= (opt-mask-not-src-var mask-not-copy 2) 0)) 13]
      [(not (= (opt-mask-binop-lhs-var mask-idempotent-copy 2) 0)) 14]
      [(not (= (opt-mask-binop-lhs-var mask-idempotent-copy 4) 0)) 15]
      [(not (= (opt-mov-dst-type-tag mask-idempotent-copy 2) 0)) 16]
      [(not (= (opt-mask-reduce-src-var mask-idempotent-copy 3) 0)) 17]
      [(not (= (opt-mask-reduce-src-var mask-idempotent-copy 5) 0)) 18]
      [(not (= (ir.compiler-ir-instr-seq-count mask-idempotent-dce) 0)) 19]
      [(not (= (opt-mask-not-src-var mask-not-copy 5) 4)) 20]
      [else 42])))

(define (compiler-optimize-self-test-failure-message
  [name : String]
  [actual : i64]
  [expected : i64]) : String
  (str_cat.str-cat
    "optimizer self-test failed: "
    name
    " (expected "
    (string.int->string expected)
    ", got "
    (string.int->string actual)
    ")"))

(define (compiler-optimize-self-test-require-i64!
  [name : String]
  [actual : i64]
  [expected : i64]) : unit
  (unless
    (= actual expected)
    (io.panic
      (compiler-optimize-self-test-failure-message name actual expected))))

(define (compiler-optimize-self-test-require! [name : String] [ok : bool]) : unit
  (unless ok (io.panic (str_cat.str-cat "optimizer self-test failed: " name))))

(define (compiler-optimize-debug-verifier-self-test) : i64
  (let
    [program : ir.CompilerIrProgram
      (irt.program
        "function @debug-invalid() -> i64 vars 1 {
         entry:
           return %0
         }")]
    (match (opt.opt-verify-program program)
      [(Err message)
        (if (string.eq
          message
          "function @debug-invalid: block entry instruction 0: optimizer verify: use before definition")
          42
          1)]
      [(Ok) 2])))

(define (opt-sret-role-verify-function
  [args : ir.CompilerIrCallArgs]
  [result-ty : ast.AstType]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "sret_role_verify")
    (irt.params "storage=%0:u64")
    (Unit)
    2
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (opt-test-instrs
          (ir.CompilerIrInstr.Call
            1
            (opt-test-symbol "sret_callee")
            args
            result-ty)
          (ir.CompilerIrInstr.Return No))))
    Ordinary))

(define (opt-sret-role-rejected?
  [args : ir.CompilerIrCallArgs]
  [result-ty : ast.AstType]) : bool
  (match (opt.opt-verify-function
    (& (opt-sret-role-verify-function args result-ty)))
    [(Err _) true]
    [(Ok) false]))

(test
  optimizer-sret-role-verifier
  (test.assert-true
    (and
      (opt.opt-verify-ok?
        (&
          (opt.opt-verify-function
            (&
              (opt-sret-role-verify-function
                (ir.compiler-ir-call-args-sret-from-seq
                  (& (ir.compiler-ir-value-seq1 (Var 0)))
                  0)
                (U64))))))
      (opt-sret-role-rejected?
        (ir.compiler-ir-call-args-sret-from-seq
          (& (ir.compiler-ir-value-seq1 (Var 0)))
          1)
        (U64))
      (opt-sret-role-rejected?
        (ir.compiler-ir-call-args-sret-from-seq
          (& (ir.compiler-ir-value-seq1 (I64 0)))
          0)
        (U64))
      (opt-sret-role-rejected?
        (ir.compiler-ir-call-args-sret-from-seq
          (& (ir.compiler-ir-value-seq1 (Var 0)))
          0)
        (F64)))
    "sret role requires a live pointer variable, in-range index and pointer result"))

(define (opt-indirect-call-def-is? [instr : ir.CompilerIrInstr] [want : i64]) : bool
  (match (opt.opt-instr-def-var (opt.compiler-opt-global-shared-view instr))
    [(Some found) (= found want)]
    [(None) false]))

(define (opt-indirect-call-nondef? [instr : ir.CompilerIrInstr]) : bool
  (match (opt.opt-instr-def-var (opt.compiler-opt-global-shared-view instr))
    [(Some _) false]
    [(None) true]))

;; Value-returning indirect calls define their first payload field. Aggregate
;; C-ABI store-result calls only write through an existing base, and an indirect
;; tail call transfers control, so neither of those forms defines an SSA value.
(define (compiler-optimize-indirect-call-def-self-test) : i64
  (let
    [indirect : ir.CompilerIrInstr (irt.instr "%7 = call* fn@callee() : i64")]
    [indirect-c : ir.CompilerIrInstr
      (irt.instr "%8 = call_c* fn@extern_callee() : i64")]
    [direct-store : ir.CompilerIrInstr
      (ir.ir-instr-call-cabi-store-result
        (I64 0)
        (opt-test-symbol "aggregate_callee")
        Nil
        (ir.CompilerIrCAbiReturnSlotSeq
          (__tl_make-array ir.CompilerIrCAbiReturnSlot 0)
          0))]
    [indirect-store : ir.CompilerIrInstr
      (ir.ir-instr-call-indirect-cabi-store-result
        (I64 0)
        (Function (opt-test-symbol "aggregate_indirect_callee"))
        Nil
        (ir.CompilerIrCAbiReturnSlotSeq
          (__tl_make-array ir.CompilerIrCAbiReturnSlot 0)
          0))]
    [tail : ir.CompilerIrInstr (irt.instr "tailcall* fn@tail_callee() : i64")]
    (cond
      [(not (opt-indirect-call-def-is? indirect 7)) 1]
      [(not (opt-indirect-call-def-is? indirect-c 8)) 2]
      [(not
          (opt.opt-verify-ok?
            (&
              (opt.opt-verify-function
                (&
                  (irt.func
                    "function @indirect_def() -> i64 vars 8 {
                 entry:
                   %7 = call* fn@callee() : i64
                   return %7
                 }"))))))
        3]
      [(not
          (opt.opt-verify-ok?
            (&
              (opt.opt-verify-function
                (&
                  (irt.func
                    "function @indirect_c_def() -> i64 vars 9 {
                 entry:
                   %8 = call_c* fn@extern_callee() : i64
                   return %8
                 }"))))))
        4]
      [(not (opt-indirect-call-nondef? direct-store)) 5]
      [(not (opt-indirect-call-nondef? indirect-store)) 6]
      [(not (opt-indirect-call-nondef? tail)) 7]
      [else 42])))

;; Returns 42 when folding turns the one arithmetic instruction into a `Mov`
;; literal whose value (20 + 22) is correct, and a later `Load` redefining a
;; formerly-constant var invalidates the stale fact before another arithmetic
;; instruction reads that var.
(define (compiler-optimize-self-test) : i64
  (let
    [instrs : ir.CompilerIrInstrSeq (opt-self-test-instrs)]
    [optimized : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt.compiler-opt-global-shared-view instrs))]
    [fold-fire-result : opt.OptBlockListPassResult
      (opt.optimize-block-list-for-function-pass
        (profile_state.compiler-profile-state-metrics
          (profile_state.compiler-profile-state-new))
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        8
        (& (ir.compiler-ir-param-seq-empty))
        (irt.blocks
          "entry:
             %0 = mov 20 : i64
             %1 = mov 22 : i64
             %2 = add %0, %1 : i64"))]
    [fold-noop-result : opt.OptBlockListPassResult
      (opt.optimize-block-list-for-function-pass
        (profile_state.compiler-profile-state-metrics
          (profile_state.compiler-profile-state-new))
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        1
        (& (ir.compiler-ir-param-seq-empty))
        (irt.blocks "entry:
             return 42"))]
    (compiler-optimize-self-test-require!
      "fold pass reports a real rewrite"
      (match fold-fire-result
        [(Result _ changed) changed]))
    (compiler-optimize-self-test-require!
      "fold pass reports and reuses a no-op"
      (match fold-noop-result
        [(Result _ changed) (not changed)]))
    (compiler-optimize-self-test-require-i64!
      "constant-fold input arithmetic count"
      (opt-count-arith-instr-seq instrs)
      1)
    (compiler-optimize-self-test-require-i64!
      "constant-fold output arithmetic count"
      (opt-count-arith-instr-seq optimized)
      0)
    (compiler-optimize-self-test-require-i64!
      "constant-fold literal sum"
      (opt-sum-mov-i64 optimized)
      84)
    (let
      [stale-instrs : ir.CompilerIrInstrSeq (opt-stale-load-test-instrs)]
      [stale-optimized : ir.CompilerIrInstrSeq
        (opt-test-fold-instrs
          (ast.ast-node-pool-reader-type-segment-bases)
          (Nil)
          stale-instrs)]
      (compiler-optimize-self-test-require-i64!
        "stale load invalidates constant fact"
        (opt-count-arith-instr-seq stale-optimized)
        1)
      (compiler-optimize-self-test-require-i64!
        "vector/mask folding and copy propagation"
        (compiler-optimize-vector-mask-self-test)
        42)
      (compiler-optimize-self-test-require-i64!
        "indirect call definition bookkeeping"
        (compiler-optimize-indirect-call-def-self-test)
        42)
      42)))

(define (opt-typed-fold-u64-shr-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Mov 20 (I64 (- 0 1)) (U64))
    (ir.CompilerIrInstr.Mov 21 (I64 63) (U8))
    (ir.CompilerIrInstr.BinOp 22 (Shr (U8)) (Var 20) (Var 21) (U64))
    (ir.CompilerIrInstr.BinOp 23 (Shl (U8)) (Var 20) (I64 256) (U64))))

(define (opt-typed-fold-shift-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-u64-shr-instrs)
    (ir.CompilerIrInstr.Mov 15 (I64 1) (I64))
    (ir.CompilerIrInstr.Mov 16 (I64 3) (U8))
    (ir.CompilerIrInstr.BinOp 17 (Shl (U8)) (Var 15) (Var 16) (I64))
    (irt.instr "%18 = mov -8 : i64")
    (irt.instr "%19 = shr %18, 1 : i64")))

(define (opt-typed-fold-div-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-shift-instrs)
    (irt.instr "%13 = div 42, 6 : i64")
    (irt.instr "%14 = mod 22, 7 : u8")))

(define (opt-typed-fold-bool-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-div-instrs)
    (irt.instr "%11 = mov true : bool")
    (irt.instr "%12 = and %11, false : bool")))

(define (opt-typed-fold-cast-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-bool-instrs)
    (irt.instr "%7 = cast %0 : u8 to i64")
    (irt.instr "%8 = cast 300 : u16 to char")
    (ir.CompilerIrInstr.Mov 9 (Char 'A') (Char))
    (irt.instr "%10 = cast %9 : char to i64")))

(define (opt-typed-fold-compare-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-cast-instrs)
    (ir.CompilerIrInstr.Mov 3 (I64 (- 0 1)) (I8))
    (ir.CompilerIrInstr.Mov 4 (I64 1) (I8))
    (irt.instr "%5 = lt %3, %4 : bool")
    (irt.instr "%6 = lt %0, %1 : bool")))

(define (opt-typed-fold-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-typed-fold-compare-instrs)
    (ir.CompilerIrInstr.Mov 0 (I64 255) (U8))
    (ir.CompilerIrInstr.Mov 1 (I64 1) (U8))
    (irt.instr "%2 = add %0, %1 : u8")))

(define (opt-typed-fold-invalid-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.BinOp 30 (Div) (I64 1) (I64 0) (I64))
    (ir.CompilerIrInstr.BinOp 31 (Div) (I64 (- 0 128)) (I64 (- 0 1)) (I8))
    (ir.CompilerIrInstr.BinOp 32 (Shl (I64)) (I64 1) (I64 (- 0 1)) (I64))
    (ir.CompilerIrInstr.BinOp 33 (Shl (I64)) (I64 1) (I64 8) (U8))))

(define (opt-float-fold-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Mov 40 (F64 (opt-test-f64-bits "1.5")) (F64))
    (ir.CompilerIrInstr.BinOp
      41
      (Add)
      (Var 40)
      (F64 (opt-test-f64-bits "2.25"))
      (F64))
    (ir.CompilerIrInstr.BinOp
      42
      (Lt)
      (Var 41)
      (F64 (opt-test-f64-bits "4.0"))
      (Bool))
    (irt.instr "%43 = neg %41 : f64")
    (ir.CompilerIrInstr.Cast
      44
      (F64 (opt-test-f64-bits "1.00000001"))
      (F64)
      (F32))
    (ir.CompilerIrInstr.BinOp
      56
      (Mul)
      (F64 (opt-test-f64-bits "-0.0"))
      (F64 (opt-test-f64-bits "1.0"))
      (F64))))

(define (opt-float-fold-invalid-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.BinOp
      45
      (Div)
      (F64 (opt-test-f64-bits "1.0"))
      (F64 (opt-test-f64-bits "0.0"))
      (F64))
    (ir.CompilerIrInstr.BinOp
      57
      (Div)
      (F64 (opt-test-f32-bits "1.0"))
      (F64 (opt-test-f32-bits "0.0"))
      (F32))
    (ir.CompilerIrInstr.BinOp
      58
      (Mul)
      (F64 (opt-test-f64-bits "1e+308"))
      (F64 (opt-test-f64-bits "1e+308"))
      (F64))
    (ir.CompilerIrInstr.Cast 59 (F64 (opt-test-f64-bits "3.5e+38")) (F64) (F32))))

(define (opt-finite-cast-fold-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%46 = cast -42 : i64 to f64")
    (irt.instr "%47 = cast -1 : u64 to f64")
    (irt.instr "%48 = cast -1 : u64 to f32")
    (ir.CompilerIrInstr.Cast 49 (Char 'A') (Char) (F64))
    (ir.CompilerIrInstr.Cast 50 (F64 (opt-test-f64-bits "3.75")) (F64) (I64))
    (ir.CompilerIrInstr.Cast 51 (F64 (opt-test-f64-bits "-3.75")) (F64) (I64))
    (ir.CompilerIrInstr.Cast 52 (F64 (opt-test-f64-bits "65.9")) (F64) (Char))
    (ir.CompilerIrInstr.Cast 53 (F64 (opt-test-f32-bits "3.9")) (F32) (I64))
    (irt.instr "%54 = cast 16777217 : i64 to f32")
    (ir.CompilerIrInstr.Cast 55 (F64 (opt-test-f32-bits "-3.9")) (F32) (I64))
    (ir.CompilerIrInstr.Cast
      63
      (F64 (opt-test-f64-bits "9223372036854775808.0"))
      (F64)
      (U64))
    (ir.CompilerIrInstr.Cast
      64
      (F64 (opt-test-f64-bits "9223372036854777856.0"))
      (F64)
      (U64))
    (ir.CompilerIrInstr.Cast
      65
      (F64 (opt-test-f64-bits "18446744073709549568.0"))
      (F64)
      (U64))
    (ir.CompilerIrInstr.Cast
      66
      (F64 (opt-test-f32-bits "18446742974197923840.0"))
      (F32)
      (U64))
    (irt.instr "%67 = cast -9223371487098961919 : u64 to f32")))

(define (opt-finite-cast-no-fold-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Cast
      60
      (F64 (opt-test-f64-bits "9223372036854775808.0"))
      (F64)
      (I64))
    (ir.CompilerIrInstr.Cast 61 (F64 (opt-test-f64-bits "-1.0")) (F64) (U8))
    (ir.CompilerIrInstr.Cast 62 (F64 (opt-test-f64-bits "256.0")) (F64) (Char))))

(define (compiler-optimize-float-fold-ok?) : bool
  (let
    [pos : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-float-fold-instrs))]
    [neg : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-float-fold-invalid-instrs))]
    [finite-casts : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-finite-cast-fold-instrs))]
    [deferred-casts : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-finite-cast-no-fold-instrs))]
    (and
      (= (opt-count-arith-instr-seq pos) 0)
      (= (opt-count-cast-instr-seq pos) 0)
      (opt-mov-dst-f64-bits? pos 41 (opt-test-f64-bits "3.75"))
      (opt-mov-dst-bool-value? pos 42 true)
      (opt-mov-dst-f64-bits? pos 43 (opt-test-f64-bits "-3.75"))
      (opt-mov-dst-f64-bits? pos 44 (opt-test-f32-bits "1.00000001"))
      (opt-mov-dst-f64-bits? pos 56 (opt-test-f64-bits "-0.0"))
      (= (opt-count-arith-instr-seq neg) 3)
      (= (opt-count-cast-instr-seq neg) 1)
      (= (opt-count-cast-instr-seq finite-casts) 0)
      (opt-mov-dst-f64-bits? finite-casts 46 (opt-test-f64-bits "-42.0"))
      (opt-mov-dst-f64-bits?
        finite-casts
        47
        (opt-test-f64-bits "18446744073709551616.0"))
      (opt-mov-dst-f64-bits?
        finite-casts
        48
        (opt-test-f32-bits "18446744073709551616.0"))
      (opt-mov-dst-f64-bits? finite-casts 49 (opt-test-f64-bits "65.0"))
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 50 999) 3)
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 51 999) (- 0 3))
      (= (opt-mov-dst-char-code finite-casts 52 0) 65)
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 53 999) 3)
      (opt-mov-dst-f64-bits? finite-casts 54 (opt-test-f32-bits "16777217.0"))
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 55 999) (- 0 3))
      (=
        (opt-mov-dst-i64-value-instr-seq finite-casts 63 999)
        -9223372036854775808)
      (=
        (opt-mov-dst-i64-value-instr-seq finite-casts 64 999)
        -9223372036854773760)
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 65 999) -2048)
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 66 999) -1099511627776)
      (opt-mov-dst-f64-bits?
        finite-casts
        67
        (opt-test-f32-bits "9223373136366403584.0"))
      (= (opt-count-cast-instr-seq deferred-casts) 3))))

;; --- commutative constant-lhs canonicalisation --------------------------------
;;
;; The backend's immediate forms all key off an immediate RHS, so `K op x` and
;; `x op K` -- the same value -- lower to different instruction counts. These
;; fixtures pin which shapes move and, just as importantly, which do not.
;;
;;   C1 admitted : `2 + x`   -> `x + 2`
;;   C2 admitted : `3 * x`   -> `x * 3`      (the rest of the commutative set:
;;                 `7 & x`, `7 | x`, `7 ^ x` follow on dsts 3/4/5)
;;   C3 refused  : `x + 2` is already canonical -- untouched, which is also the
;;                 idempotence witness (the rule cannot oscillate).
;;   C4 refused  : `2 - x` -- Sub does not commute.
;;   C5 refused  : `2 << x` -- Shl does not commute (and its RHS is separately
;;                 typed).
;;   C6 admitted : `0 - x` on i64 -> `UnOp Neg x`, the one non-commutative
;;                 constant-lhs shape with a strictly better single-instruction
;;                 form.
;;   C7 refused  : `0 - x` on i32 -- the Neg rule is restricted to the 8-byte
;;                 integer types.
;;   C8 refused  : `2.0 + x` on f64 -- `addsd` propagates the FIRST operand's
;;                 NaN payload, so the swap is observable.
;;   C9 twin     : `0 - 5` is a literal pair, so the constant folder answers it
;;                 first and the result is `Mov -5`, exactly as before the rule
;;                 existed.
;;   C10 admitted: `@g + x` -> `x + @g` (CANON-G: the backend's memory-source
;;                 form keys off the right operand exactly as the immediate
;;                 forms do).
;;   C11 refused : `@g + @h` -- two cells have no better spelling either way.
;;   C12 refused : `@g + x` stored straight back into `@g` -- the
;;                 read-modify-write the RMW-2 peephole folds keeps its cell on
;;                 the left.
(define (opt-cc-var? [v : ir.CompilerIrValue] [id : i64]) : bool
  (match v
    [(Var x) (= x id)]
    [_ false]))

(define (opt-cc-i64? [v : ir.CompilerIrValue] [k : i64]) : bool
  (match v
    [(I64 x) (= x k)]
    [_ false]))

(define (opt-cc-f64? [v : ir.CompilerIrValue]) : bool
  (match v
    [(F64 _) true]
    [_ false]))

(define (opt-cc-global? [v : ir.CompilerIrValue] [name : i64]) : bool
  (match v
    [(Global g) (= g name)]
    [_ false]))

;; Bare cell ids: the rule reads nothing but the id, and interning a symbol
;; here would re-seed the builtin table under the typed-fold fixtures that run
;; after this one.
(define (opt-cc-g) : i64
  4242)

(define (opt-cc-h) : i64
  4243)

(define (opt-cc-op-is? [op : ir.CompilerIrBinOp] [tag : i64]) : bool
  (=
    tag
    (match op
      [(Add) 1]
      [(Mul) 2]
      [(BitAnd) 3]
      [(BitOr) 4]
      [(BitXor) 5]
      [(Sub) 6]
      [(Shl _) 7]
      [_ 0])))

(define (opt-cc-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (irt.instr "%1 = add 2, %0 : i64")
    (irt.instr "%2 = mul 3, %0 : i64")
    (irt.instr "%3 = bit_and 7, %0 : i64")
    (irt.instr "%4 = bit_or 7, %0 : i64")
    (irt.instr "%5 = bit_xor 7, %0 : i64")
    (irt.instr "%6 = add %0, 2 : i64")
    (irt.instr "%7 = sub 2, %0 : i64")
    (irt.instr "%8 = shl 2, %0 : i64")
    (irt.instr "%9 = sub 0, %0 : i64")
    (irt.instr "%10 = sub 0, %0 : i32")
    (ir.CompilerIrInstr.BinOp
      11
      (Add)
      (F64 (opt-test-f64-bits "2.0"))
      (Var 0)
      (F64))
    (irt.instr "%12 = sub 0, 5 : i64")
    (ir.CompilerIrInstr.BinOp 13 (Add) (Global (opt-cc-g)) (Var 0) (I64))
    (ir.CompilerIrInstr.BinOp
      14
      (Add)
      (Global (opt-cc-g))
      (Global (opt-cc-h))
      (I64))
    (ir.CompilerIrInstr.BinOp 15 (Add) (Global (opt-cc-g)) (Var 0) (I64))
    (ir.CompilerIrInstr.Store (opt-cc-g) (Var 15) (I64))))

;; 0 when `instr` has the shape the rule prescribes for its dst, else the code
;; naming the case that broke.
(define (opt-cc-check-instr [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(BinOp dst op l r _)
      (cond
        [(= dst 1)
          (if (and (opt-cc-op-is? op 1) (opt-cc-var? l 0) (opt-cc-i64? r 2))
            0
            1)]
        [(= dst 2)
          (if (and (opt-cc-op-is? op 2) (opt-cc-var? l 0) (opt-cc-i64? r 3))
            0
            2)]
        [(= dst 3)
          (if (and (opt-cc-op-is? op 3) (opt-cc-var? l 0) (opt-cc-i64? r 7))
            0
            3)]
        [(= dst 4)
          (if (and (opt-cc-op-is? op 4) (opt-cc-var? l 0) (opt-cc-i64? r 7))
            0
            4)]
        [(= dst 5)
          (if (and (opt-cc-op-is? op 5) (opt-cc-var? l 0) (opt-cc-i64? r 7))
            0
            5)]
        [(= dst 6)
          (if (and (opt-cc-op-is? op 1) (opt-cc-var? l 0) (opt-cc-i64? r 2))
            0
            6)]
        [(= dst 7)
          (if (and (opt-cc-op-is? op 6) (opt-cc-i64? l 2) (opt-cc-var? r 0))
            0
            7)]
        [(= dst 8)
          (if (and (opt-cc-op-is? op 7) (opt-cc-i64? l 2) (opt-cc-var? r 0))
            0
            8)]
        [(= dst 9) 19]
        [(= dst 10)
          (if (and (opt-cc-op-is? op 6) (opt-cc-i64? l 0) (opt-cc-var? r 0))
            0
            10)]
        [(= dst 11)
          (if (and (opt-cc-op-is? op 1) (opt-cc-f64? l) (opt-cc-var? r 0))
            0
            11)]
        [(= dst 12) 22]
        [(= dst 13)
          (if (and
            (opt-cc-op-is? op 1)
            (opt-cc-var? l 0)
            (opt-cc-global? r (opt-cc-g)))
            0
            13)]
        [(= dst 14)
          (if (and
            (opt-cc-op-is? op 1)
            (opt-cc-global? l (opt-cc-g))
            (opt-cc-global? r (opt-cc-h)))
            0
            14)]
        [(= dst 15)
          (if (and
            (opt-cc-op-is? op 1)
            (opt-cc-global? l (opt-cc-g))
            (opt-cc-var? r 0))
            0
            15)]
        [else 30])]
    [(UnOp dst op src _)
      (cond
        [(= dst 9)
          (match op
            [(Neg)
              (if (opt-cc-var? src 0)
                0
                9)]
            [_ 9])]
        [else 31])]
    [(Mov dst src _)
      (cond
        [(= dst 12)
          (if (opt-cc-i64? src (- 0 5))
            0
            12)]
        [else 32])]
    [(Store _ _ _) 0]
    [_ 33]))

(define (opt-cc-check-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (let
      [code : i64
        (opt-cc-check-instr (ir.compiler-ir-instr-seq-ref instrs index))]
      (if (= code 0)
        (opt-cc-check-from instrs (+ index 1))
        code))))

(define (opt-cc-check [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-cc-check-from instrs 0))

(define (compiler-optimize-commute-constant-lhs-self-test) : i64
  (let
    [once : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-cc-instrs))]
    [twice : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (ir.compiler-ir-global-shared-view once))]
    (unless (= (opt-cc-check once) 0) (return (opt-cc-check once)))
    ;; idempotence: the canonical form is a fixpoint of the same pass
    (unless (= (opt-cc-check twice) 0) (return (+ 40 (opt-cc-check twice))))
    42))

(define (compiler-optimize-typed-fold-self-test) : i64
  (let
    [pos : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-typed-fold-instrs))]
    [neg : ir.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (Nil)
        (opt-typed-fold-invalid-instrs))]
    (unless (= (opt-count-arith-instr-seq pos) 0) (return 1))
    (unless (= (opt-count-cast-instr-seq pos) 0) (return 3))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 2 (- 0 999)) 0) (return 4))
    (unless (opt-mov-dst-bool-value? pos 5 true) (return 5))
    (unless (opt-mov-dst-bool-value? pos 6 false) (return 6))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 7 0) 255) (return 7))
    (unless (= (opt-mov-dst-char-code pos 8 0) 44) (return 8))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 10 0) 65) (return 9))
    (unless (opt-mov-dst-bool-value? pos 12 false) (return 10))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 13 0) 7) (return 11))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 14 0) 1) (return 12))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 17 0) 8) (return 13))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 19 0) (- 0 4)) (return 14))
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 22 0) 1) (return 15))
    ;; An immediate is normalized with the shift's U8 RHS payload before
    ;; folding: 256 wraps to zero instead of being treated as an invalid
    ;; U64 count, preserving the all-ones U64 lhs.
    (unless (= (opt-mov-dst-i64-value-instr-seq pos 23 0) (- 0 1)) (return 16))
    (unless (= (opt-count-arith-instr-seq neg) 4) (return 17))
    (unless (cfloat.compiler-float-self-test) (return 18))
    (unless (compiler-optimize-float-fold-ok?) (return 19))
    (unless
      (and
        (match (let
          [op (ir.CompilerIrUnOp.Sqrt)]
          [src
            (opt.OptKnownConst.SomeConst (F64 (opt-test-f64-bits "4.0")) (F64))]
          [result-ty (ast.AstType.F64)]
          (opt.opt-fold-unop op (& src) result-ty))
          [(No) true]
          [_ false])
        (match (let
          [op (ir.CompilerIrUnOp.Sqrt)]
          [src
            (opt.OptKnownConst.SomeConst (F64 (opt-test-f32-bits "4.0")) (F32))]
          [result-ty (ast.AstType.F32)]
          (opt.opt-fold-unop op (& src) result-ty))
          [(No) true]
          [_ false]))
      (return 20))
    42))

;; Positive strength-reduction cases: integer neutral/absorbing identities and
;; boolean `and`/`or` identities. The first instruction uses `AstType.U8` to prove
;; non-i64 integer result types keep their original type.
(define (opt-strength-self-test-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = add %1, 0 : u8
     %11 = add 0, %2 : i64
     %12 = sub %3, 0 : i64
     %13 = mul %4, 1 : i64
     %14 = mul 1, %5 : i64
     %15 = mul %6, 0 : i64
     %16 = mul 0, %7 : i64
     %17 = and %8, true : bool
     %18 = and true, %9 : bool
     %19 = and %8, false : bool
     %20 = and false, %9 : bool
     %21 = or %8, false : bool
     %22 = or false, %9 : bool
     %23 = or %8, true : bool
     %24 = or true, %9 : bool"))

;; Negative cases for edge-sensitive operations and non-identities: division,
;; modulo, shifts, and `0 - x` must stay as `BinOp`s.
(define (opt-strength-negative-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%30 = div %1, 0 : i64
     %31 = mod %1, 0 : i64
     %32 = shl %1, 0 : i64
     %33 = shr %1, 0 : i64
     %34 = sub 0, %1 : i64"))

;; Returns 42 when every positive identity is rewritten to `Mov`, the typed U8
;; identity keeps its result type, and the negative cases stay untouched.
(define (compiler-optimize-strength-self-test) : i64
  (let
    [pos : ir.CompilerIrInstrSeq
      (opt-test-strength-instrs (Nil) (opt-strength-self-test-instrs))]
    [neg : ir.CompilerIrInstrSeq
      (opt-test-strength-instrs (Nil) (opt-strength-negative-instrs))]
    (cond
      [(not (= (opt-count-arith-instr-seq pos) 0)) 1]
      [(not (= (opt-sum-mov-var-src pos) 49)) 2]
      [(not (= (opt-count-mov-i64-value-instr-seq pos 0) 2)) 3]
      [(not (= (opt-count-mov-bool-value pos false) 2)) 4]
      [(not (= (opt-count-mov-bool-value pos true) 2)) 5]
      [(not (= (opt-mov-dst-type-tag pos 10) (ast.ast-type-tag (& (U8))))) 6]
      [(not (= (opt-count-arith-instr-seq neg) 5)) 7]
      [else 42])))

;; Builds `[Mov v0=99 (unused), Call v1 = noop(), Pack v2 (unused), Return v1]`.
;; `v0` and `v2` are dead pure temporaries; `v1` is produced by a side-effecting
;; call and used by the return, so DCE must drop only the pure temporaries
;; (4 instrs -> 2).
(define (opt-dce-self-test-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = mov 99 : i64
     %1 = call noop() : i64
     %2 = pack [7, 9] : i64
     return %1"))

(define (opt-dce-isolated-unused-alloc-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = alloc i64
     return"))

(define (opt-dce-used-alloc-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = alloc i64
     %1 = addr_of %0
     return %1"))

(define (opt-dce-alloc-run-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = alloc i64
     %1 = alloc i64
     %2 = alloc i64
     return"))

(define (opt-dce-clean-list-count [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (let
    [used : opt_i64_i64_map.Map
      (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) instrs)]
    [cleaned : ir.CompilerIrInstrSeq (opt-test-dce-instrs used instrs)]
    (ir.compiler-ir-instr-seq-count cleaned)))

(define (opt-dce-clean-array-count [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [block : ir.CompilerIrBlock (Block (ir.compiler-ir-label "entry") instrs)]
    [used : (__tl_dyn-array i64)
      (let
        [blocks
          (ir.compiler-ir-blocks (opt.compiler-opt-global-shared-view block))]
        (opt.opt-collect-blocks-uses-array 64 blocks))]
    (match block
      [(Block _ block-instrs)
        (ir.compiler-ir-instr-seq-count
          (opt.opt-dce-instr-seq-array used block-instrs))])))

(define (compiler-optimize-dce-alloc-self-test) : i64
  (let
    [isolated : ir.CompilerIrInstrSeq (opt-dce-isolated-unused-alloc-instrs)]
    [used : ir.CompilerIrInstrSeq (opt-dce-used-alloc-instrs)]
    [run : ir.CompilerIrInstrSeq (opt-dce-alloc-run-instrs)]
    (cond
      [(not (= (opt-dce-clean-list-count isolated) 1)) 1]
      [(not (= (opt-dce-clean-list-count used) 3)) 2]
      [(not (= (opt-dce-clean-list-count run) 4)) 3]
      [(not (= (opt-dce-clean-array-count isolated) 1)) 4]
      [(not (= (opt-dce-clean-array-count used) 3)) 5]
      [(not (= (opt-dce-clean-array-count run) 4)) 6]
      [else 42])))

;; Forward block order sees v0 before the later dead v1 that uses it. One DCE
;; sweep drops v1 too late to revisit v0; the fixed-point driver must recollect
;; uses and remove v0 on its second sweep.
(define (opt-dce-cross-block-chain) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 1 : i64
       jump exit
     exit:
       %1 = mov %0 : i64
       return"))

;; Returns 42 when DCE keeps the used call result `v1` and the side-effecting
;; instructions, drops the unused `v0`, and is idempotent on a second pass.
(define (compiler-optimize-dce-self-test) : i64
  (let
    [instrs : ir.CompilerIrInstrSeq (opt-dce-self-test-instrs)]
    [used : opt_i64_i64_map.Map
      (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) instrs)]
    [cleaned : ir.CompilerIrInstrSeq (opt-test-dce-instrs used instrs)]
    [again : ir.CompilerIrInstrSeq
      (let
        [set
          (opt-test-collect-instrs-uses
            (opt_i64_i64_map.with-capacity 64)
            cleaned)]
        (opt-test-dce-instrs set cleaned))]
    [unused-word-dead : bool
      (let
        [set (opt_i64_i64_map.with-capacity 4)]
        [instr (irt.instr "%3 = word %2, 0 : i64")]
        (opt-instr-dead? set instr))]
    [dead-blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (opt-test-instr-seq-copy (opt.compiler-opt-global-shared-view instrs))))]
    [dead-result : opt.OptBlockListPassResult
      (opt.opt-dce-block-list-array-pass
        (& (opt.opt-collect-blocks-uses-array 8 dead-blocks))
        dead-blocks)]
    [live-blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (opt.compiler-opt-global-shared-view cleaned)))]
    [live-result : opt.OptBlockListPassResult
      (opt.opt-dce-block-list-array-pass
        (& (opt.opt-collect-blocks-uses-array 8 live-blocks))
        live-blocks)]
    [cross-blocks : ir.CompilerIrBlockList (opt-dce-cross-block-chain)]
    [cross-once : ir.CompilerIrBlockList
      (match (opt.opt-dce-block-list-array-pass
        (& (opt.opt-collect-blocks-uses-array 2 cross-blocks))
        (opt.compiler-opt-global-shared-view cross-blocks))
        [(Result next _) next])]
    [cross-fixed : ir.CompilerIrBlockList
      (opt.opt-dce-block-list-array-fixpoint 2 (& cross-blocks) 8)]
    [alloc-tests : i64 (compiler-optimize-dce-alloc-self-test)]
    (cond
      [(not
          (match dead-result
            [(Result _ changed) changed]))
        1]
      [(not
          (match live-result
            [(Result _ changed) (not changed)]))
        2]
      [(not (opt.opt-used-contains used 1)) 3]
      [(opt.opt-used-contains used 0) 4]
      [(not (= (ir.compiler-ir-instr-seq-count instrs) 4)) 5]
      [(not (= (ir.compiler-ir-instr-seq-count cleaned) 2)) 6]
      [(not (= (ir.compiler-ir-instr-seq-count again) 2)) 7]
      [(not unused-word-dead) 8]
      [(not (= alloc-tests 42)) 9]
      [(not (= (ir.compiler-ir-block-list-instruction-count (& cross-once)) 3))
        10]
      [(not (= (ir.compiler-ir-block-list-instruction-count (& cross-fixed)) 2))
        11]
      [else 42])))

;; Builds `[Mov v0=4096 (an address), Load v1 = *v0, Return v1]`. `v0` feeds a
;; `Load`, so DCE must treat it as used and keep it; without collecting the
;; Load's operand uses, DCE would wrongly drop `v0`'s Mov and break the load.
(define (opt-dce-mem-self-test-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = mov 4096 : i64
     %1 = load %0 : i64
     return %1"))

;; Returns 42 when DCE keeps the `Mov` that feeds the `Load` (operand uses of
;; pointer/memory ops are collected), leaving all three instructions intact.
(define (compiler-optimize-dce-mem-self-test) : i64
  (let
    [instrs : ir.CompilerIrInstrSeq (opt-dce-mem-self-test-instrs)]
    [used : opt_i64_i64_map.Map
      (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) instrs)]
    [cleaned : ir.CompilerIrInstrSeq (opt-test-dce-instrs used instrs)]
    (if (opt.opt-used-contains used 0)
      (if (= (ir.compiler-ir-instr-seq-count cleaned) 3)
        42
        2)
      1)))

(define (opt-count-binop-op-instr
  [instr : ir.CompilerIrInstr]
  [op : ir.CompilerIrBinOp]) : i64
  (match instr
    [(BinOp _ actual _ _ _)
      (if (opt.opt-binop-eq (& actual) (& op))
        1
        0)]
    [_ 0]))

(define (opt-count-binop-op-instr-seq-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [op : (& op ir.CompilerIrBinOp)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    acc
    (opt-count-binop-op-instr-seq-from
      instrs
      op
      (+ index 1)
      (+
        acc
        (opt-count-binop-op-instr
          (ir.compiler-ir-instr-seq-ref instrs index)
          (owned_view.compiler-owned-reference-shared-view op))))))

(define (opt-count-binop-op-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [op : (& op ir.CompilerIrBinOp)]) : i64
  (opt-count-binop-op-instr-seq-from instrs op 0 0))

(define (opt-count-binop-op-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [op : ir.CompilerIrBinOp]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-binop-op-instr-seq instrs op)
            (opt-count-binop-op-blocks rest op))])]))

(define (opt-divrem-test-params [ty : ast.AstType]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-prepend
    (Param "lhs" (ast.ast-global-shared-view ty) 0)
    (ir.compiler-ir-param-seq-prepend
      (Param "rhs" ty 1)
      (ir.compiler-ir-param-seq-empty))))

(define (opt-divrem-cast-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = cast %1 : i64 to i64
       %3 = gt %2, 0 : bool
       branch %3, safe, exit
     safe:
       %4 = div %0, %1 : i64
       return %4
     exit:
       return 0"))

(define (opt-divrem-rhs-redefined-before-branch-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = ne %1, 0 : bool
       %1 = mov 0 : i64
       branch %2, safe, exit
     safe:
       %3 = div %0, %1 : i64
       return %3
     exit:
       return 0"))

(define (opt-divrem-rhs-redefined-in-safe-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = ne %1, 0 : bool
       branch %2, safe, exit
     safe:
       %1 = mov 0 : i64
       %3 = div %0, %1 : i64
       return %3
     exit:
       return 0"))

(define (opt-divrem-lhs-not-min-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "safe:
           %4 = div %0, %1 : i64
           return %4
         exit:
           return 0")
    (irt.block
      "entry:
         %2 = ne %1, 0 : bool
         branch %2, check_lhs, exit")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "check_lhs")
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp
          3
          (Ne)
          (Var 0)
          (I64
            (let
              [ty (ast.AstType.I64)]
              (opt.opt-signed-min ty)))
          (Bool))
        (irt.instr "branch %3, safe, exit")))))

(define (opt-divrem-dce-blocks
  [params : ir.CompilerIrParamSeq]
  [blocks : ir.CompilerIrBlockList]
  [frame : i64]) : ir.CompilerIrBlockList
  (let
    [safe : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        params
        blocks)]
    [used : (__tl_dyn-array i64) (opt.opt-collect-blocks-uses-array frame safe)]
    (opt.opt-dce-block-list-array (& used) (& safe))))

;; BITLEN: the rotated `while (> probe 0) probe >>= 1, bits += 1` loop, with
;; each ingredient of the idiom a parameter so the refusals can each break one.
(define (opt-bitlen-test-blocks
  [ty : ast.AstType]
  [guard-op : ir.CompilerIrBinOp]
  [guard-true-edge? : bool]
  [guarded? : bool]
  [exit-op : ir.CompilerIrBinOp]
  [shift : i64]
  [step : i64]
  [probe-escapes? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (if guarded?
        (opt-test-instrs
          (ir.CompilerIrInstr.BinOp
            2
            guard-op
            (Var 0)
            (I64 0)
            (opt.compiler-opt-global-shared-view ty))
          (if guard-true-edge?
            (irt.instr "branch %2, pre, exit")
            (irt.instr "branch %2, exit, pre")))
        (opt-test-instrs (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "pre")))))
    (irt.block "pre:
           jump loop")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "loop")
      (opt-test-instrs
        (ir.CompilerIrInstr.Phi
          3
          (ir.compiler-ir-phi-input-seq-prepend
            (I64 0)
            (ir.compiler-ir-label "pre")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (Var 6)
                (ir.compiler-ir-label "loop")
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          (opt.compiler-opt-global-shared-view ty))
        (ir.CompilerIrInstr.Phi
          4
          (ir.compiler-ir-phi-input-seq-prepend
            (Var 0)
            (ir.compiler-ir-label "pre")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (Var 5)
                (ir.compiler-ir-label "loop")
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          (opt.compiler-opt-global-shared-view ty))
        (ir.CompilerIrInstr.BinOp
          5
          (Shr (I64))
          (Var 4)
          (I64 shift)
          (opt.compiler-opt-global-shared-view ty))
        (ir.CompilerIrInstr.BinOp
          7
          (Add)
          (Var 3)
          (I64 step)
          (opt.compiler-opt-global-shared-view ty))
        (ir.CompilerIrInstr.Mov
          6
          (Var 7)
          (opt.compiler-opt-global-shared-view ty))
        (ir.CompilerIrInstr.BinOp
          8
          exit-op
          (Var 5)
          (I64 0)
          (opt.compiler-opt-global-shared-view ty))
        (irt.instr "branch %8, loop, exit")))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (opt-test-instrs
        (ir.CompilerIrInstr.Phi
          9
          (ir.compiler-ir-phi-input-seq-prepend
            (I64 0)
            (ir.compiler-ir-label "entry")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (if probe-escapes?
                  (Var 4)
                  (Var 6))
                (ir.compiler-ir-label "loop")
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          ty)
        (irt.instr "return %9")))))

;; 1 when the pass turned the loop into its closed form (a bit_length of the
;; probe and a jump to the exit), 0 when it left the loop alone, -1 otherwise.
(define (opt-bitlen-test-outcome [blocks : ir.CompilerIrBlockList]) : i64
  (match (let
    [blocks-2 (opt.opt-bit-length-idiom-blocks 10 blocks)]
    (opt.opt-cfg-find-block blocks-2 (ir.compiler-ir-label "loop")))
    [(Some (Block _ instrs))
      (match (ir.compiler-ir-instr-seq-ref instrs (- instrs.len 1))
        [(Branch _ _ _) 0]
        [(Jump target)
          (if (and
            (= target (ir.compiler-ir-label "exit"))
            (match (ir.compiler-ir-instr-seq-ref instrs 2)
              [(UnOp 5 (BitLength) (Var 4) _) true]
              [_ false])
            (match (ir.compiler-ir-instr-seq-ref instrs 3)
              [(Mov 7 (Var 5) _) true]
              [_ false]))
            1
            (- 0 1))]
        [_ (- 0 1)])]
    [(No) (- 0 1)]))

;; Reordering the independent source increment ahead of the shift must not
;; leave the replacement add/copy reading BitLength's result before it exists.
;; Check the verifier as well as admission, with literal and runtime seeds.
(define (opt-bitlen-order-function
  [ty : ast.AstType]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol "bitlen_order")
    (opt-divrem-test-params (opt.compiler-opt-global-shared-view ty))
    ty
    10
    blocks
    Ordinary))

(define (opt-bitlen-counter-first-ok?
  [ty : (& ty ast.AstType)]
  [seed : ir.CompilerIrValue]) : bool
  (let
    [ty : ast.AstType (owned_view.compiler-owned-reference-shared-view ty)]
    [seq : ir.CompilerIrBlockSeq
      (ir.compiler-ir-block-list-seq
        (opt-bitlen-test-blocks
          (opt.compiler-opt-global-shared-view ty)
          (Gt)
          true
          true
          (Gt)
          1
          1
          false))]
    [slots : (__tl_dyn-array ir.CompilerIrBlock)
      (opt.compiler-opt-global-shared-view seq.slots)]
    (match (ir.compiler-ir-block-seq-ref seq 2)
      [(Block label instrs)
        (set!
          (array-ref slots 2)
          (ir.CompilerIrBlock.Block
            label
            (opt-test-instrs
              (ir.CompilerIrInstr.Phi
                3
                (ir.compiler-ir-phi-input-seq-prepend
                  seed
                  (ir.compiler-ir-label "pre")
                  (&
                    (ir.compiler-ir-phi-input-seq-prepend
                      (Var 6)
                      (ir.compiler-ir-label "loop")
                      (& (ir.compiler-ir-phi-input-seq-empty)))))
                (opt.compiler-opt-global-shared-view ty))
              (ir.compiler-ir-instr-seq-ref instrs 1)
              (ir.compiler-ir-instr-seq-ref instrs 3)
              (ir.compiler-ir-instr-seq-ref instrs 4)
              (ir.compiler-ir-instr-seq-ref instrs 2)
              (ir.compiler-ir-instr-seq-ref instrs 5)
              (ir.compiler-ir-instr-seq-ref instrs 6))))])
    (let
      [blocks : ir.CompilerIrBlockList (Array seq)]
      [rewritten : ir.CompilerIrBlockList
        (opt.opt-bit-length-idiom-blocks
          10
          (opt.compiler-opt-global-shared-view blocks))]
      (and
        (opt.opt-verify-ok?
          (&
            (opt.opt-verify-function
              (&
                (opt-bitlen-order-function
                  (opt.compiler-opt-global-shared-view ty)
                  blocks)))))
        (opt.opt-verify-ok?
          (&
            (opt.opt-verify-function
              (&
                (opt-bitlen-order-function
                  ty
                  (opt.compiler-opt-global-shared-view rewritten))))))
        (match (opt.opt-cfg-find-block rewritten (ir.compiler-ir-label "loop"))
          [(Some (Block _ instrs))
            (and
              (match (ir.compiler-ir-instr-seq-ref instrs 2)
                [(UnOp _ (BitLength) _ _) true]
                [_ false])
              (match (ir.compiler-ir-instr-seq-ref instrs (- instrs.len 1))
                [(Jump _) true]
                [_ false]))]
          [_ false])))))

(cfg
  test
  (test
    bit-length-counter-first-has-valid-definition-order
    (let
      [kind : i64 0]
      (while (< kind 2)
        (let
          [ty : ast.AstType
            (if (= kind 0)
              (I64)
              (U64))]
          (test.assert-true
            (opt-bitlen-counter-first-ok? ty (I64 0))
            "zero seed")
          (test.assert-true
            (opt-bitlen-counter-first-ok? ty (I64 100))
            "nonzero seed")
          (test.assert-true
            (opt-bitlen-counter-first-ok? ty (Var 1))
            "runtime seed")
          (test.assert-true
            (opt-bitlen-counter-first-ok? ty (I64 9223372036854775807))
            "wrapping seed")
          (set! kind (+ kind 1)))))))

(define (compiler-optimize-bit-length-self-test) : i64
  (cond
    ;; the idiom behind a `probe > 0` guard, signed and unsigned
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Gt) true true (Gt) 1 1 false))
          1))
      1]
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (U64) (Ne) true true (Ne) 1 1 false))
          1))
      2]
    ;; reached on the false edge of `probe <= 0`
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Le) false true (Gt) 1 1 false))
          1))
      3]
    ;; no guard: a non-positive probe still runs the body once
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Gt) true false (Gt) 1 1 false))
          0))
      4]
    ;; the guard's true edge of `probe <= 0` proves nothing
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Le) true true (Gt) 1 1 false))
          0))
      5]
    ;; the probe's last value leaves the loop
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Gt) true true (Gt) 1 1 true))
          0))
      6]
    ;; a different shift or step is not a bit count
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Gt) true true (Gt) 2 1 false))
          0))
      7]
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Gt) true true (Gt) 1 2 false))
          0))
      8]
    ;; a signed `!= 0` exit never ends for a negative probe
    [(not
        (=
          (opt-bitlen-test-outcome
            (opt-bitlen-test-blocks (I64) (Gt) true true (Ne) 1 1 false))
          0))
      9]
    ;; constant folding of the op itself
    [(not
        (and
          (= (opt.opt-bit-length-of 1 true) 1)
          (= (opt.opt-bit-length-of 1024 true) 11)
          (= (opt.opt-bit-length-of 0 true) 0)
          (= (opt.opt-bit-length-of (- 0 5) true) 0)
          (= (opt.opt-bit-length-of (- 0 5) false) 64)
          (= (opt.opt-bit-length-of 9223372036854775807 true) 63)))
      10]
    [else 42]))

(define (compiler-optimize-divrem-safety-self-test) : i64
  (let
    [i64-params : ir.CompilerIrParamSeq (opt-divrem-test-params (I64))]
    [u64-params : ir.CompilerIrParamSeq (opt-divrem-test-params (U64))]
    [signed-positive : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (irt.blocks
          "entry:
             %2 = gt %1, 0 : bool
             branch %2, safe, exit
           safe:
             %3 = div %0, %1 : i64
             return %3
           exit:
             return 0"))]
    [signed-mod-positive : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (irt.blocks
          "entry:
             %2 = ge %1, 1 : bool
             branch %2, safe, exit
           safe:
             %3 = mod %0, %1 : i64
             return %3
           exit:
             return 0"))]
    [unsigned-nonzero : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        u64-params
        (irt.blocks
          "entry:
             %2 = ne %1, 0 : bool
             branch %2, safe, exit
           safe:
             %3 = div %0, %1 : u64
             return %3
           exit:
             return 0"))]
    [lhs-not-min : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-lhs-not-min-blocks))]
    [zero-reachable : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (irt.blocks
          "entry:
             %2 = ne %1, -1 : bool
             branch %2, safe, exit
           safe:
             %3 = div %0, %1 : i64
             return %3
           exit:
             return 0"))]
    [neg-one-reachable : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (irt.blocks
          "entry:
             %2 = ne %1, 0 : bool
             branch %2, safe, exit
           safe:
             %3 = div %0, %1 : i64
             return %3
           exit:
             return 0"))]
    [weak-negative-range : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (irt.blocks
          "entry:
             %2 = lt %1, 0 : bool
             branch %2, safe, exit
           safe:
             %3 = div %0, %1 : i64
             return %3
           exit:
             return 0"))]
    [cast-unsupported : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-cast-blocks))]
    [rhs-redefined-before-branch : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-rhs-redefined-before-branch-blocks))]
    [rhs-redefined-in-safe : ir.CompilerIrBlockList
      (opt-divrem-safety-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-rhs-redefined-in-safe-blocks))]
    [safe-unused : ir.CompilerIrBlockList
      (opt-divrem-dce-blocks
        (opt.compiler-opt-global-shared-view i64-params)
        (irt.blocks
          "entry:
             %2 = gt %1, 0 : bool
             branch %2, safe, exit
           safe:
             %3 = div %0, %1 : i64
             return 0
           exit:
             return 0")
        4)]
    [unproven-unused : ir.CompilerIrBlockList
      (opt-divrem-dce-blocks
        i64-params
        (irt.blocks
          "entry:
             %2 = div %0, %1 : i64
             return 0")
        4)]
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view signed-positive)
          (SafeDiv))
        1)
      (return 1))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view signed-positive)
          (Div))
        0)
      (return 2))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view signed-mod-positive)
          (SafeMod))
        1)
      (return 3))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view unsigned-nonzero)
          (SafeDiv))
        1)
      (return 4))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view lhs-not-min)
          (SafeDiv))
        1)
      (return 5))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view zero-reachable)
          (Div))
        1)
      (return 6))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view neg-one-reachable)
          (Div))
        1)
      (return 7))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view weak-negative-range)
          (Div))
        1)
      (return 8))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view cast-unsupported)
          (Div))
        1)
      (return 9))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view rhs-redefined-before-branch)
          (Div))
        1)
      (return 10))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view rhs-redefined-in-safe)
          (Div))
        1)
      (return 11))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view safe-unused)
          (SafeDiv))
        0)
      (return 12))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view safe-unused)
          (Div))
        0)
      (return 13))
    (unless
      (=
        (opt-count-binop-op-blocks
          (ir.compiler-ir-block-list-view unproven-unused)
          (Div))
        1)
      (return 14))
    42))

;; `[BinOp v2 = v0 + v1, BinOp v3 = v0 + v1]` with non-constant operands: CSE
;; rewrites the second into `Mov v3 = v2` (two arithmetic instrs -> one).
(define (opt-cse-self-test-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%2 = add %0, %1 : i64
     %3 = add %0, %1 : i64"))

;; Shift direction, lhs, rhs value, result, and destination shape are identical
;; here; only the RHS count type differs. The raw I64(-1) is a signed -1 under
;; I8 metadata and the all-ones byte under U8 metadata, so CSE must retain both
;; trapping expressions instead of rewriting the second one to a Mov from the
;; first. A shared Var would be malformed IR because it cannot have both types.
(define (opt-cse-shift-count-type-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.BinOp 60 (Shl (I8)) (Var 0) (I64 (- 0 1)) (I64))
    (ir.CompilerIrInstr.BinOp 61 (Shl (U8)) (Var 0) (I64 (- 0 1)) (I64))))

(define (opt-shift-binop-count [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(or (BinOp _ (Shl _) _ _ _) (BinOp _ (Shr _) _ _ _)) 1]
    [_ 0]))

(define (opt-count-shift-binops-from
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-shift-binop-count (ir.compiler-ir-instr-seq-ref instrs index))
      (opt-count-shift-binops-from instrs (+ index 1)))))

(define (opt-count-shift-binops [instrs : (& instrs ir.CompilerIrInstrSeq)]) : i64
  (opt-count-shift-binops-from instrs 0))

(define (opt-cse-sqrt-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%2 = sqrt %0 : f64
     %3 = sqrt %0 : f64"))

;; A store between the two identical expressions clears the table, so the second
;; expression is preserved (no cross-store CSE).
(define (opt-cse-store-clears-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = add %0, %1 : i64
     store @g, 0 : i64
     %3 = add %0, %1 : i64"))

;; Redefining an operand (`v0`) between the two expressions invalidates the
;; available entry, so the second expression is preserved (correctness on
;; non-SSA IR).
(define (opt-cse-operand-redef-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = add %0, %1 : i64
     %0 = mov 5 : i64
     %3 = add %0, %1 : i64"))

(define (opt-cse-probe-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = cpuid %0, 0 word 1
     %3 = cpuid %0, 0 word 1
     %4 = xgetbv 0
     %5 = xgetbv 0"))

(define (opt-cse-probe-different-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%2 = cpuid 7, 0 word 1
     %3 = cpuid 7, 0 word 2
     %4 = cpuid 7, 1 word 1
     %5 = xgetbv 0
     %6 = xgetbv 1"))

(define (opt-simd-cse-instrs) : ir.CompilerIrInstrSeq
  (opt-test-instrs
    (ir.CompilerIrInstr.Splat 20 (Var 0) 4 (I64))
    (ir.CompilerIrInstr.Splat 21 (Var 0) 4 (I64))
    (ir.CompilerIrInstr.Splat 22 (Var 0) 8 (I64))
    (ir.ir-instr-vector-bin-op 30 (Add) (Var 2) (Var 3) 4 (I64))
    (ir.ir-instr-vector-bin-op 31 (Add) (Var 2) (Var 3) 4 (I64))
    (ir.ir-instr-vector-bin-op 32 (Sub) (Var 2) (Var 3) 4 (I64))
    (ir.ir-instr-vector-bin-op 33 (Add) (Var 2) (Var 3) 8 (I64))
    (ir.ir-instr-vector-bin-op 34 (Add) (Var 2) (Var 3) 4 (U64))
    (ir.ir-instr-vector-compare 40 (Eq) (Var 4) (Var 5) 4 (I64))
    (ir.ir-instr-vector-compare 41 (Eq) (Var 4) (Var 5) 4 (I64))
    (ir.ir-instr-vector-compare 42 (Ne) (Var 4) (Var 5) 4 (I64))
    (ir.ir-instr-vector-compare 43 (Eq) (Var 4) (Var 5) 8 (I64))
    (ir.ir-instr-vector-compare 44 (Eq) (Var 4) (Var 5) 4 (U64))
    (ir.ir-instr-vector-bin-op 50 (Mul) (Var 21) (Var 31) 4 (I64))))

(define (compiler-optimize-simd-local-cse-self-test) : i64
  (let
    [input : ir.CompilerIrInstrSeq (opt-simd-cse-instrs)]
    [rewritten : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt.compiler-opt-global-shared-view input))]
    [copied : ir.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (opt.opt-copy-env-empty)
        (opt.compiler-opt-global-shared-view rewritten))]
    (cond
      [(not (opt.opt-scan-cse-dup-from (& input.slots) 0 input.len)) 1]
      [(not (= (opt-mov-src-var-instr-seq rewritten 21 (- 0 1)) 20)) 2]
      [(not (= (opt-mov-src-var-instr-seq rewritten 31 (- 0 1)) 30)) 3]
      [(not (= (opt-mov-src-var-instr-seq rewritten 41 (- 0 1)) 40)) 4]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 22) 0)) 5]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 32) 0)) 6]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 33) 0)) 7]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 34) 0)) 8]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 42) 0)) 9]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 43) 0)) 10]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 44) 0)) 11]
      [(not (= (opt-vector-binop-lhs-var copied 50) 20)) 12]
      [else 42])))

;; Self-test: const-global propagation. Verifies the immutability proof and the
;; operand rewrite it feeds.
;;
;; ADMITTED: a global with a literal `I64` initialiser that the program never
;; stores to and never takes the address of, whose value fits a signed 32-bit
;; immediate. `zero` (value 0) is a member like any other value -- the zero
;; divisor exception under REWRITE is a divisor-position rule, not an
;; immutability one.
;;
;; REFUSED: `mut` (a `Store` anywhere in the program), `borrowed` (a `GlobalAddr`
;; anywhere), `uninit` and `runtime` (no literal initialiser -- `runtime` carries
;; the `CompilerIrValue.RuntimeGlobal` form that lowering gives a global whose
;; initialiser is evaluated by a startup `__global_init_*` function, so a
;; startup-initialised global can never be folded), and `big` (wider than an
;; imm32: `global_cell` already keeps such a constant in one hoisted register,
;; which beats a per-use `movabs` -- see opt-const-globals-imm32-fits?).
;;
;; REWRITE: every use of an admitted global becomes its literal, EXCEPT a div/mod
;; divisor whose constant is zero, which keeps its trapping global-load form.
;; A bounds check whose index is an admitted global becomes a literal check,
;; which is what lets SCCP discharge it -- the intern_table P6 shape.
(defstruct OptConstDivisorTestSymbols
  (konst i64)
  (mutable i64)
  (uninit i64)
  (borrowed i64)
  (zero i64)
  (big i64)
  (runtime i64))

(define (opt-const-divisor-test-symbols) : OptConstDivisorTestSymbols
  (OptConstDivisorTestSymbols
    (opt-test-symbol "konst")
    (opt-test-symbol "mut")
    (opt-test-symbol "uninit")
    (opt-test-symbol "borrowed")
    (opt-test-symbol "zero")
    (opt-test-symbol "big")
    (opt-test-symbol "runtime")))

(define (opt-const-divisor-test-globals [symbols : OptConstDivisorTestSymbols]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 7)]
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.konst
      (I64)
      (I64 1000000007))
    (opt-test-global-builder-push! (&mut builder) symbols.mutable (I64) (I64 7))
    (opt-test-global-builder-push! (&mut builder) symbols.uninit (I64) (Unit))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.borrowed
      (I64)
      (I64 99))
    (opt-test-global-builder-push! (&mut builder) symbols.zero (I64) (I64 0))
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.big
      (I64)
      (I64 4294967295))
    ;; The shape lowering gives a global whose initialiser is not a
    ;; compile-time constant: the value is the startup initialiser function,
    ;; not a literal, so the table can never see a value to fold.
    (opt-test-global-builder-push!
      (&mut builder)
      symbols.runtime
      (I64)
      (RuntimeGlobal (opt-test-symbol "__global_init_runtime")))
    (ir.compiler-ir-global-builder-to-seq builder)))

(define (opt-const-divisor-test-blocks [symbols : OptConstDivisorTestSymbols]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp 10 (Mod) (Var 0) (Global symbols.konst) (I64))
        (ir.CompilerIrInstr.BinOp
          11
          (Mod)
          (Var 0)
          (Global symbols.mutable)
          (I64))
        (ir.CompilerIrInstr.BinOp
          12
          (Div)
          (Var 0)
          (Global symbols.uninit)
          (I64))
        (ir.CompilerIrInstr.BinOp 13 (Add) (Var 0) (Global symbols.konst) (I64))
        (ir.CompilerIrInstr.BinOp
          14
          (BitAnd)
          (Var 0)
          (Global symbols.borrowed)
          (I64))
        (ir.CompilerIrInstr.BinOp
          15
          (BitAnd)
          (Var 0)
          (Global symbols.zero)
          (I64))
        (ir.CompilerIrInstr.BinOp
          16
          (BitAnd)
          (Var 0)
          (Global symbols.big)
          (I64))
        (ir.CompilerIrInstr.Mov 17 (Global symbols.konst) (I64))
        (irt.instr "%18 = bit_xor %17, 1 : i64")
        (ir.CompilerIrInstr.Mov 19 (Global symbols.konst) (I64))
        (irt.instr "%21 = lt %0, %19 : i64")
        ;; A zero-valued constant global in a DIVISOR position keeps its load.
        (ir.CompilerIrInstr.BinOp 22 (Mod) (Var 0) (Global symbols.zero) (I64))
        ;; A wide constant global is refused on profitability, everywhere.
        (ir.CompilerIrInstr.BinOp 23 (Div) (Var 0) (Global symbols.big) (I64))
        ;; A startup-initialised global is not foldable in any position.
        (ir.CompilerIrInstr.BinOp
          24
          (BitAnd)
          (Var 0)
          (Global symbols.runtime)
          (I64))
        (ir.CompilerIrInstr.Mov 20 (GlobalAddr symbols.borrowed) (U64))
        (ir.CompilerIrInstr.Store symbols.mutable (I64 9) (I64))
        (irt.instr "return %10")))))

(define (opt-const-divisor-test-rhs-in-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [count : i64]
  [dst : i64]) : ir.CompilerIrValue
  (if (>= index count)
    (Unit)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BinOp d _ _ rhs _)
        (if (= d dst)
          rhs
          (opt-const-divisor-test-rhs-in-seq instrs (+ index 1) count dst))]
      [_ (opt-const-divisor-test-rhs-in-seq instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-rhs
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : ir.CompilerIrValue
  (match blocks
    [(slice) (Unit)]
    [(slice block & _)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-const-divisor-test-rhs-in-seq
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            dst)])]))

(define (opt-const-divisor-test-mov-src-in-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [count : i64]
  [dst : i64]) : ir.CompilerIrValue
  (if (>= index count)
    (Unit)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(Mov d src _)
        (if (= d dst)
          src
          (opt-const-divisor-test-mov-src-in-seq instrs (+ index 1) count dst))]
      [_ (opt-const-divisor-test-mov-src-in-seq instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-mov-src
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : ir.CompilerIrValue
  (match blocks
    [(slice) (Unit)]
    [(slice block & _)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (opt-const-divisor-test-mov-src-in-seq
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            dst)])]))

;; The intern_table P6 shape end to end: a never-written literal global read as
;; an ordinary operand of a compare, and the SAME global standing as the index
;; operand of a bounds check. Once the const-global rewrite has turned both into
;; literals, SCCP must fold the compare to a constant (the BinOp becomes a Mov of
;; the decided value) and discharge the in-range check outright.
(define (opt-const-divisor-test-sccp-blocks
  [symbols : OptConstDivisorTestSymbols]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.CompilerIrInstr.Mov 30 (Global symbols.konst) (I64))
        (irt.instr "%31 = lt %30, 2000000000 : i64")
        (ir.CompilerIrInstr.BoundsCheck
          (Global symbols.zero)
          (I64 3)
          (ir.compiler-ir-label "bounds_ok"))
        (irt.instr "return %31")))))

(define (opt-const-divisor-test-binop-dst-in-seq?
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [count : i64]
  [dst : i64]) : bool
  (if (>= index count)
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BinOp found _ _ _ _)
        (if (= found dst)
          true
          (opt-const-divisor-test-binop-dst-in-seq?
            instrs
            (+ index 1)
            count
            dst))]
      [_
        (opt-const-divisor-test-binop-dst-in-seq? instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-binop-dst?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (if (opt-const-divisor-test-binop-dst-in-seq?
            instrs
            0
            (ir.compiler-ir-instr-seq-count instrs)
            dst)
            true
            (opt-const-divisor-test-binop-dst? rest dst))])]))

(define (opt-const-divisor-test-bounds-index-in-seq
  [instrs : (& instrs ir.CompilerIrInstrSeq)]
  [index : i64]
  [count : i64]) : ir.CompilerIrValue
  (if (>= index count)
    (Unit)
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(BoundsCheck idx _ _) idx]
      [_ (opt-const-divisor-test-bounds-index-in-seq instrs (+ index 1) count)])))

(define (opt-const-divisor-test-is-unit? [v : (& v ir.CompilerIrValue)]) : bool
  (match v
    [(Unit) true]
    [_ false]))

;; `Unit` when the blocks carry no bounds check at all, which is how the SCCP
;; leg asserts the check was discharged rather than merely rewritten.
(define (opt-const-divisor-test-bounds-index
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : ir.CompilerIrValue
  (match blocks
    [(slice) (Unit)]
    [(slice block & rest)
      (let
        [found : ir.CompilerIrValue
          (match (owned_view.compiler-owned-reference-shared-view block)
            [(Block _ instrs)
              (opt-const-divisor-test-bounds-index-in-seq
                instrs
                0
                (ir.compiler-ir-instr-seq-count instrs))])]
        (if (opt-const-divisor-test-is-unit? found)
          (opt-const-divisor-test-bounds-index rest)
          found))]))

(define (opt-const-divisor-test-is-i64? [v : ir.CompilerIrValue] [n : i64]) : bool
  (match v
    [(I64 m) (= m n)]
    [_ false]))

(define (opt-const-divisor-test-is-global?
  [v : ir.CompilerIrValue]
  [name : String]) : bool
  (match v
    [(Global m) (string.eq (ir.compiler-ir-symbol-text m) name)]
    [_ false]))

(define (compiler-optimize-const-divisor-self-test) : i64
  (let
    [symbols : OptConstDivisorTestSymbols (opt-const-divisor-test-symbols)]
    [globals : ir.CompilerIrGlobalSeq (opt-const-divisor-test-globals symbols)]
    [blocks : ir.CompilerIrBlockList (opt-const-divisor-test-blocks symbols)]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (opt-test-symbol "f")
            (ir.compiler-ir-param-seq-empty)
            (I64)
            16
            (opt.compiler-opt-global-shared-view blocks)
            Ordinary))
        (& (ir.compiler-ir-function-seq-empty)))]
    [table : opt_i64_i64_map.Map (opt-test-const-divisors globals functions)]
    [rewritten : ir.CompilerIrBlockList
      (opt.opt-const-divisor-rewrite-blocks table (& blocks))]
    ;; The P6 leg: run the same rewrite the pipeline runs at the top of the
    ;; level-2 iteration, then hand the result to SCCP exactly as the pipeline's
    ;; sccp slot does.
    [sccp-input : ir.CompilerIrBlockList
      (opt.opt-const-divisor-rewrite-blocks
        table
        (& (opt-const-divisor-test-sccp-blocks symbols)))]
    [sccp-folded : ir.CompilerIrBlockList
      (opt.opt-sccp-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (& (ir.compiler-ir-param-seq-empty))
        (& sccp-input))]
    (cond
      [(not (opt_i64_i64_map.contains? (& table) symbols.konst)) 1]
      [(not
          (match (opt_i64_i64_map.get (& table) symbols.konst)
            [(LookupFound n) (= n 1000000007)]
            [(LookupMissing) false]))
        2]
      [(opt_i64_i64_map.contains? (& table) symbols.mutable) 3]
      [(opt_i64_i64_map.contains? (& table) symbols.uninit) 4]
      [(opt_i64_i64_map.contains? (& table) symbols.borrowed) 5]
      [(not
          (match (opt_i64_i64_map.get (& table) symbols.zero)
            [(LookupFound n) (= n 0)]
            [(LookupMissing) false]))
        6]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              10)
            1000000007))
        7]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              13)
            1000000007))
        8]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              11)
            "mut"))
        9]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              12)
            "uninit"))
        10]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              14)
            "borrowed"))
        11]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              15)
            0))
        12]
      [(opt_i64_i64_map.contains?
          (& table)
          (ir.compiler-ir-symbol-id symbols.big))
        13]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              16)
            "big"))
        14]
      ;; Every Mov source is substituted, whether the Move feeds arithmetic
      ;; or only a compare: the fold that follows removes the Move, so the
      ;; literal is never held in a register.
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-mov-src
              (ir.compiler-ir-block-list-view rewritten)
              17)
            1000000007))
        15]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-mov-src
              (ir.compiler-ir-block-list-view rewritten)
              19)
            1000000007))
        16]
      ;; A zero divisor is the one position an admitted global is NOT
      ;; substituted into.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              22)
            "zero"))
        17]
      ;; ... and so is a wide constant, in a divisor position like any other.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              23)
            "big"))
        18]
      ;; A startup-initialised global never enters the table ...
      [(opt_i64_i64_map.contains?
          (& table)
          (ir.compiler-ir-symbol-id symbols.runtime))
        19]
      ;; ... and so keeps its hidden-load form at every use.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (ir.compiler-ir-block-list-view rewritten)
              24)
            "runtime"))
        20]
      ;; P6, before SCCP: the bounds check's INDEX operand is now the literal.
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-bounds-index
              (ir.compiler-ir-block-list-view sccp-input))
            0))
        21]
      ;; P6, after SCCP: the in-range check is discharged outright ...
      [(not
          (let
            [v
              (opt-const-divisor-test-bounds-index
                (ir.compiler-ir-block-list-view sccp-folded))]
            (opt-const-divisor-test-is-unit? v)))
        22]
      ;; ... and the dependent compare folded to a constant, so no BinOp
      ;; computes it any more.
      [(opt-const-divisor-test-binop-dst?
          (ir.compiler-ir-block-list-view sccp-folded)
          31)
        23]
      [else 42])))

;; Returns 42 when CSE eliminates the repeated pure expression (2 arithmetic
;; instrs -> 1) yet preserves the second expression both across an intervening
;; store and across an operand redefinition (still 2 arithmetic instrs each).
;; It also CSEs identical CPU probes while preserving probes with different
;; register indices or operands.
(define (compiler-optimize-cse-self-test) : i64
  (let
    [cse : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-self-test-instrs))]
    [sqrt : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-sqrt-instrs))]
    [store : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-store-clears-instrs))]
    [redef : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-operand-redef-instrs))]
    [probe : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-probe-instrs))]
    [probe-different : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-probe-different-instrs))]
    [shift-count-types : ir.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.opt-expr-table-new)
        (opt-cse-shift-count-type-instrs))]
    (unless (= (opt-count-arith-instr-seq cse) 1) (return 1))
    (unless (= (opt-mov-src-var-instr-seq sqrt 3 (- 0 1)) 2) (return 10))
    (unless (= (opt-count-arith-instr-seq store) 2) (return 2))
    (unless (= (opt-count-arith-instr-seq redef) 2) (return 3))
    (unless
      (=
        (opt-count-cpuid-instr-seq (ir.compiler-ir-global-shared-view probe))
        1)
      (return 4))
    (unless (= (opt-mov-src-var-instr-seq probe 3 (- 0 1)) 2) (return 5))
    (unless
      (=
        (opt-count-xgetbv-instr-seq (ir.compiler-ir-global-shared-view probe))
        1)
      (return 6))
    (unless (= (opt-mov-src-var-instr-seq probe 5 (- 0 1)) 4) (return 7))
    (unless
      (=
        (opt-count-cpuid-instr-seq
          (ir.compiler-ir-global-shared-view probe-different))
        3)
      (return 8))
    (unless (= (opt-count-xgetbv-instr-seq probe-different) 2) (return 9))
    (unless (= (opt-count-shift-binops shift-count-types) 2) (return 10))
    (unless
      (= (opt-count-mov-dst-instr-seq shift-count-types 61) 0)
      (return 11))
    42))

;; --- cross-block GVN self-tests ---------------------------------------------
(define (opt-gvn-test-params) : ir.CompilerIrParamSeq
  (irt.params "a=%0:i64, b=%1:i64"))

(define (opt-gvn-count-binops-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-count-arith-instr-seq instrs)
            (opt-gvn-count-binops-blocks rest))])]))

;; Diamond: `a + b` computed in the entry block and recomputed in the
;; post-dominating join. The entry strictly dominates the join, so the join's
;; expression is rewritten to a copy and the binop count drops from 2 to 1.
(define (opt-gvn-diamond-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %10 = add %0, %1 : i64
       branch %0, l, r
     l:
       jump j
     r:
       jump j
     j:
       %11 = add %0, %1 : i64
       return %11"))

;; Two sibling arms each compute `a + b`, and the join recomputes it. Neither arm
;; strictly dominates the join, so no cross-block CSE fires and all 3 binops stay.
(define (opt-gvn-siblings-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       branch %0, l, r
     l:
       %10 = add %0, %1 : i64
       jump j
     r:
       %11 = add %0, %1 : i64
       jump j
     j:
       %12 = add %0, %1 : i64
       return %12"))

;; The shared operand `v2` is reassigned in each block, so it has two value
;; sources and is not stable. Even though the entry dominates the join, the two
;; `v0 + v2` expressions compute different values and must not be CSE'd: 2 binops.
(define (opt-gvn-redef-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov 5 : i64
       %10 = add %0, %2 : i64
       jump j
     j:
       %2 = mov 7 : i64
       %11 = add %0, %2 : i64
       return %11"))

;; Loop: the header computes `a + b` and the body recomputes it. The header
;; strictly dominates the body, so the body's expression is rewritten: 2 -> 1.
(define (opt-gvn-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump h
     h:
       %10 = add %0, %1 : i64
       branch %0, body, exit
     body:
       %11 = add %0, %1 : i64
       jump h
     exit:
       return %10"))

(define (opt-gvn-probe-dominated-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %20 = cpuid 7, 0 word 1
       %21 = xgetbv 0
       jump use
     use:
       %22 = cpuid 7, 0 word 1
       %23 = xgetbv 0
       return %23"))

(define (opt-gvn-probe-different-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %20 = cpuid 7, 0 word 1
       %21 = xgetbv 0
       jump use
     use:
       %22 = cpuid 7, 0 word 2
       %23 = cpuid 7, 1 word 1
       %24 = xgetbv 1
       return %24"))

;; Returns 42 only when cross-block GVN rewrites dominated repeats (diamond and
;; loop drop to 1 binop), leaves non-dominating siblings alone (3 binops), and
;; refuses to CSE across a reassigned operand (2 binops). CPU probes are reused
;; only when an identical probe is available from a strict dominator.
(define (compiler-optimize-gvn-self-test) : i64
  (let
    [probe : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-test-params)
        (opt-gvn-probe-dominated-blocks))]
    [probe-different : ir.CompilerIrBlockList
      (opt-gvn-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-test-params)
        (opt-gvn-probe-different-blocks))]
    (unless
      (=
        (let
          [walked-blocks : ir.CompilerIrBlockList
            (opt-gvn-blocks
              (ast.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-diamond-blocks))]
          (opt-gvn-count-binops-blocks
            (ir.compiler-ir-block-list-view walked-blocks)))
        1)
      (return 1))
    (unless
      (=
        (let
          [walked-blocks : ir.CompilerIrBlockList
            (opt-gvn-blocks
              (ast.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-siblings-blocks))]
          (opt-gvn-count-binops-blocks
            (ir.compiler-ir-block-list-view walked-blocks)))
        3)
      (return 2))
    (unless
      (=
        (let
          [walked-blocks : ir.CompilerIrBlockList
            (opt-gvn-blocks
              (ast.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-redef-blocks))]
          (opt-gvn-count-binops-blocks
            (ir.compiler-ir-block-list-view walked-blocks)))
        2)
      (return 3))
    (unless
      (=
        (let
          [walked-blocks : ir.CompilerIrBlockList
            (opt-gvn-blocks
              (ast.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-loop-blocks))]
          (opt-gvn-count-binops-blocks
            (ir.compiler-ir-block-list-view walked-blocks)))
        1)
      (return 4))
    (unless
      (= (opt-count-cpuid-blocks (ir.compiler-ir-block-list-view probe)) 1)
      (return 5))
    (unless
      (=
        (opt-blocks-mov-src-var
          (ir.compiler-ir-block-list-view probe)
          22
          (- 0 1))
        20)
      (return 6))
    (unless
      (= (opt-count-xgetbv-blocks (ir.compiler-ir-block-list-view probe)) 1)
      (return 7))
    (unless
      (=
        (opt-blocks-mov-src-var
          (ir.compiler-ir-block-list-view probe)
          23
          (- 0 1))
        21)
      (return 8))
    (unless
      (=
        (opt-count-cpuid-blocks
          (ir.compiler-ir-block-list-view probe-different))
        3)
      (return 9))
    (unless
      (=
        (opt-count-xgetbv-blocks
          (ir.compiler-ir-block-list-view probe-different))
        2)
      (return 10))
    42))

(define (opt-simd-gvn-kind-count-instr
  [instr : ir.CompilerIrInstr]
  [kind : i64]) : i64
  (match instr
    [(Splat _ _ _ _)
      (if (= kind 0)
        1
        0)]
    [(VectorBinOp _)
      (if (= kind 1)
        1
        0)]
    [(VectorCompare _)
      (if (= kind 2)
        1
        0)]
    [_ 0]))

(define (opt-simd-gvn-kind-count-seq
  [instrs : ir.CompilerIrInstrSeq]
  [kind : i64]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-simd-gvn-kind-count-instr
        (ir.compiler-ir-instr-seq-ref instrs index)
        kind)
      (opt-simd-gvn-kind-count-seq instrs kind (+ index 1)))))

(define (opt-simd-gvn-kind-count-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [kind : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+
            (opt-simd-gvn-kind-count-seq instrs kind 0)
            (opt-simd-gvn-kind-count-blocks rest kind))])]))

(define (opt-simd-gvn-dominated-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (irt.instr "%10 = splat %0 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 11 (Add) (Var 10) (Var 10) 4 (I64))
        (ir.ir-instr-vector-compare 12 (Eq) (Var 11) (Var 11) 4 (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "child"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "child")
      (opt-test-instrs
        (irt.instr "%20 = splat %0 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 21 (Add) (Var 10) (Var 10) 4 (I64))
        (ir.ir-instr-vector-compare 22 (Eq) (Var 11) (Var 11) 4 (I64))
        (irt.instr "return %22")))))

(define (opt-simd-gvn-sibling-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "exit:
             return %10")
    (irt.block
      "entry:
         %10 = splat %0 lanes 4 : i64
         branch %1, left, right")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "left")
      (opt-test-instrs
        (ir.ir-instr-vector-bin-op 20 (Add) (Var 10) (Var 10) 4 (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "exit"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "right")
      (opt-test-instrs
        (ir.ir-instr-vector-bin-op 21 (Add) (Var 10) (Var 10) 4 (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "exit"))))))

(define (opt-simd-gvn-redefined-operand-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (irt.instr "%10 = splat %0 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 20 (Add) (Var 10) (Var 10) 4 (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "child"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "child")
      (opt-test-instrs
        (irt.instr "%10 = splat %1 lanes 4 : i64")
        (ir.ir-instr-vector-bin-op 21 (Add) (Var 10) (Var 10) 4 (I64))
        (irt.instr "return %21")))))

(define (opt-simd-gvn-current-block-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %20 = splat %0 lanes 4 : i64
       %21 = splat %0 lanes 4 : i64
       return %20"))

(define (opt-simd-gvn-redefined-dst-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (ir.ir-instr-vector-bin-op 20 (Add) (Var 0) (Var 0) 4 (I64))
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "child"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "child")
      (opt-test-instrs
        (irt.instr "%20 = mov 0 : i64")
        (ir.ir-instr-vector-bin-op 21 (Add) (Var 0) (Var 0) 4 (I64))
        (irt.instr "return %21")))))

(define (compiler-optimize-simd-gvn-self-test) : i64
  (let
    [type-segment-bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [dominated : ir.CompilerIrBlockList
      (opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-dominated-blocks))]
    [siblings : ir.CompilerIrBlockList
      (opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-sibling-blocks))]
    [redefined : ir.CompilerIrBlockList
      (opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-redefined-operand-blocks))]
    [current : ir.CompilerIrBlockList
      (opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-current-block-blocks))]
    [dst-redefined : ir.CompilerIrBlockList
      (opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-redefined-dst-blocks))]
    (cond
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view dominated)
              0)
            1))
        1]
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view dominated)
              1)
            1))
        2]
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view dominated)
              2)
            1))
        3]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view dominated)
              20
              (- 0 1))
            10))
        4]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view dominated)
              21
              (- 0 1))
            11))
        5]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view dominated)
              22
              (- 0 1))
            12))
        6]
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view siblings)
              1)
            2))
        7]
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view redefined)
              1)
            2))
        8]
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view current)
              0)
            2))
        9]
      [(not
          (=
            (opt-blocks-mov-src-var
              (ir.compiler-ir-block-list-view current)
              20
              (- 0 1))
            (- 0 1)))
        10]
      [(not
          (=
            (opt-simd-gvn-kind-count-blocks
              (ir.compiler-ir-block-list-view dst-redefined)
              1)
            2))
        11]
      [else 42])))

(define (opt-word-instr-count [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(Word _ _ _ _) 1]
    [_ 0]))

(define (opt-count-word-instr-seq-from
  [slots : (& slots (__tl_dyn-array ir.CompilerIrInstr))]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-word-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-word-instr-count (clone (array-ref slots index)))))))

(define (opt-count-word-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-word-instr-seq-from (& instrs.slots) 0 instrs.len 0))

(define (opt-count-words-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-word-instr-seq instrs) (opt-count-words-blocks rest))])]))

(define (opt-pack-instr-count [instr : ir.CompilerIrInstr]) : i64
  (match instr
    [(Pack _ _ _) 1]
    [_ 0]))

(define (opt-count-pack-instr-seq-from
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-pack-instr-seq-from
      (opt.compiler-opt-global-shared-view slots)
      (+ index 1)
      count
      (+
        acc
        (opt-pack-instr-count
          (opt.compiler-opt-global-array-element-shared-view slots index))))))

(define (opt-count-pack-instr-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (opt-count-pack-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-packs-blocks
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs)
          (+ (opt-count-pack-instr-seq instrs) (opt-count-packs-blocks rest))])]))

;; A Pack whose extractions all fold block-locally leaves the group unused:
;; the array-backed pipeline DCE must retire it (the map-backed DCE always
;; did; the array mirror was missing the Pack/Word arms).
(define (opt-dce-pack-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %10 = pack [%0, %1] : Pair
       %11 = word %10, 0 : i64
       %12 = word %10, 1 : i64
       %13 = add %11, %12 : i64
       return %13"))

;; Returns 42 only when the full pipeline folds both extractions block-locally
;; and retires the now-unused Pack (0 Words and 0 Packs remain).
(define (compiler-optimize-dce-pack-self-test) : i64
  (match (let
    [pools (ast.ast-node-pool-reader-context-current)]
    [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
    [func
      (ir.CompilerIrFunction.Function
        (opt-test-symbol "dce_pack")
        (opt-gvn-test-params)
        (I64)
        16
        (opt-dce-pack-blocks)
        Ordinary)]
    (opt.optimize-function-once-with-summaries
      pools
      type-segment-bases
      func
      (opt.opt-program-summaries-empty)))
    [(Function _ _ _ _ optimized-blocks _)
      (unless
        (=
          (opt-count-words-blocks
            (ir.compiler-ir-block-list-view optimized-blocks))
          0)
        (return 1))
      (unless
        (=
          (opt-count-packs-blocks
            (ir.compiler-ir-block-list-view optimized-blocks))
          0)
        (return 2))
      42]))

(define (opt-instr-compare-dst? [instr : ir.CompilerIrInstr] [dst : i64]) : bool
  (match instr
    [(BinOp d op _ _ _)
      (and (= d dst) (opt.opt-bool-branch-compare-op? (& op)))]
    [_ false]))

(define (opt-block-instr-at
  [block : (& block ir.CompilerIrBlock)]
  [index : i64]) : ir.CompilerIrInstr
  (match (owned_view.compiler-owned-reference-shared-view block)
    [(Block _ instrs) (ir.compiler-ir-instr-seq-ref instrs index)]))

(define (opt-block-instr-count [block : (& block ir.CompilerIrBlock)]) : i64
  (match (owned_view.compiler-owned-reference-shared-view block)
    [(Block _ instrs) (ir.compiler-ir-instr-seq-count instrs)]))

;; The counted-fill shape: the loop-closing compare sits one flag-safe
;; pointer-increment Gep away from its branch. Sinking moves it adjacent so
;; the backend can fuse cmp;jcc.
(define (opt-cmp-sink-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %5 = lt %0, %1 : bool
       %6 = gep %2, 8 : i64
       branch %5, t, f
     t:
       return %0
     f:
       return %1"))

;; Same shape, but the intervening instruction redefines a compare operand:
;; the compare must stay put.
(define (opt-cmp-sink-blocked-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %5 = lt %0, %1 : bool
       %0 = add %1, %1 : i64
       branch %5, t, f
     t:
       return %0
     f:
       return %1"))

;; Returns 42 only when the movable compare lands right before the branch and
;; the operand-clobbering one stays at index 0.
(define (compiler-optimize-cmp-sink-self-test) : i64
  (match (opt.opt-cmp-sink-blocks-pass (opt-cmp-sink-test-blocks))
    [(Result moved-blocks moved-changed)
      (match (ir.compiler-ir-block-list-view moved-blocks)
        [(slice moved & _)
          (match (opt.opt-cmp-sink-blocks-pass
            (opt-cmp-sink-blocked-test-blocks))
            [(Result stayed-blocks stayed-changed)
              (match (ir.compiler-ir-block-list-view stayed-blocks)
                [(slice stayed & _)
                  (unless moved-changed (return 1))
                  (when stayed-changed (return 2))
                  (unless
                    (opt-instr-compare-dst?
                      (opt-block-instr-at
                        moved
                        (- (opt-block-instr-count moved) 2))
                      5)
                    (return 3))
                  (unless
                    (opt-instr-compare-dst? (opt-block-instr-at stayed 0) 5)
                    (return 4))
                  42]
                [_ 5])])]
        [_ 6])]))

;; benchmarks/liveness_scan's hot body: three element reads lowered first,
;; then the `xor`/`and`/`or` chain that consumes them in reverse order. Every
;; load must end up immediately before ITS consumer.
(define (opt-load-sink-chain-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %10 = gep %0, %3 : i64
       %11 = load %10 : i64
       %12 = gep %1, %3 : i64
       %13 = load %12 : i64
       %14 = gep %2, %3 : i64
       %15 = load %14 : i64
       %16 = bit_xor %15, -1 : i64
       %17 = bit_and %13, %16 : i64
       %18 = bit_or %11, %17 : i64
       return %18"))

;; A StorePtr between the load and its consumer may alias the loaded cell.
(define (opt-load-sink-store-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %10 = gep %0, %3 : i64
       %11 = load %10 : i64
       %12 = gep %1, %3 : i64
       store_ptr %12, %5 : i64
       %18 = bit_or %11, %5 : i64
       return %18"))

;; A call between the load and its consumer may store anywhere.
(define (opt-load-sink-call-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %10 = gep %0, %3 : i64
       %11 = load %10 : i64
       %21 = call load_sink_callee() : i64
       %18 = bit_or %11, %21 : i64
       return %18"))

;; The gep's base is redefined before the consumer. SSA forbids this, so the
;; guard is belt and braces -- but it is the guard that makes the pass safe
;; without a dominance query, so it gets a fixture.
(define (opt-load-sink-rebase-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %10 = gep %0, %3 : i64
       %11 = load %10 : i64
       %0 = mov 7 : i64
       %18 = bit_or %11, %0 : i64
       return %18"))

;; The first load has a second reader, so the backend fold could never fire on
;; it and the pair must not move.
(define (opt-load-sink-double-use-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %10 = gep %0, %3 : i64
       %11 = load %10 : i64
       %12 = gep %1, %3 : i64
       %13 = load %12 : i64
       %17 = bit_and %13, %5 : i64
       %18 = bit_or %11, %17 : i64
       %19 = mov %11 : i64
       return %18"))

;; An UNRELATED bounds check sits between the first load and its consumer.
;; Crossing it is allowed: the check only aborts, and a load that no longer
;; runs on the aborting path has no observable effect (see the pass note).
(define (opt-load-sink-bounds-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "loop:
       %10 = gep %0, %3 : i64
       %11 = load %10 : i64
       bounds_check %3, %6 message \"bounds_ok\"
       %12 = gep %1, %3 : i64
       %13 = load %12 : i64
       %18 = bit_or %11, %13 : i64
       return %18"))

(define (opt-load-sink-run [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlock
  (let
    [sunk : ir.CompilerIrBlockList (opt.opt-load-sink-blocks 32 blocks)]
    (match (ir.compiler-ir-block-list-view sunk)
      [(slice block & _)
        (owned_view.compiler-owned-reference-shared-view block)]
      [_
        (Block (ir.compiler-ir-label "empty") (ir.compiler-ir-instr-seq-empty))])))

(define (opt-load-sink-instr-dst? [instr : ir.CompilerIrInstr] [dst : i64]) : bool
  (= (ir.compiler-ir-instr-dst instr) dst))

;; `dsts` names the expected definition at each index, using -1 for the
;; terminator.
(define (opt-load-sink-order?
  [block : (& block ir.CompilerIrBlock)]
  [dsts : (& dsts (__tl_dyn-array i64))]) : bool
  (let
    [count : i64 (array-length dsts)]
    [index : i64 0]
    [ok : bool (= (opt-block-instr-count block) count)]
    (while (and ok (< index count))
      (unless
        (opt-load-sink-instr-dst?
          (opt-block-instr-at block index)
          (array-ref dsts index))
        (set! ok false))
      (set! index (+ index 1)))
    ok))

;; A refused pair is still the block's first two instructions; a sunk one is
;; not, because whatever followed it takes index 0.
(define (opt-load-sink-pair-stayed? [blocks : ir.CompilerIrBlockList]) : bool
  (let
    [block : ir.CompilerIrBlock (opt-load-sink-run blocks)]
    (and
      (opt-load-sink-instr-dst? (opt-block-instr-at block 0) 10)
      (opt-load-sink-instr-dst? (opt-block-instr-at block 1) 11))))

;; Returns 42 only when the liveness_scan chain re-orders into three adjacent
;; `gep; load; binop` triples, every refusal fixture stays byte-identical, the
;; bounds-check fixture sinks, and a second run is a no-op.
(define (compiler-optimize-load-sink-self-test) : i64
  (let
    [chain : ir.CompilerIrBlock
      (opt-load-sink-run (opt-load-sink-chain-blocks))]
    [expected : (__tl_dyn-array i64) (__tl_make-array i64 10)]
    [bounds-expected : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    (set! (array-ref expected 0) 14)
    (set! (array-ref expected 1) 15)
    (set! (array-ref expected 2) 16)
    (set! (array-ref expected 3) 12)
    (set! (array-ref expected 4) 13)
    (set! (array-ref expected 5) 17)
    (set! (array-ref expected 6) 10)
    (set! (array-ref expected 7) 11)
    (set! (array-ref expected 8) 18)
    (set! (array-ref expected 9) (- 0 1))
    (unless (opt-load-sink-order? chain expected) (return 1))
    ;; Idempotence: the sunk block is already at its fixpoint.
    (unless
      (let
        [block (opt-load-sink-run (ir.compiler-ir-blocks chain))]
        (opt-load-sink-order? block expected))
      (return 2))
    ;; Refusals: an aliasing store, a call, a redefined base, a second use.
    (unless
      (opt-load-sink-pair-stayed? (opt-load-sink-store-blocks))
      (return 3))
    (unless (opt-load-sink-pair-stayed? (opt-load-sink-call-blocks)) (return 4))
    (unless
      (opt-load-sink-pair-stayed? (opt-load-sink-rebase-blocks))
      (return 5))
    (unless
      (opt-load-sink-pair-stayed? (opt-load-sink-double-use-blocks))
      (return 6))
    ;; The bounds check is not a barrier: the pair lands past it, ahead of
    ;; the second pair, so both reach the consumer adjacent.
    (set! (array-ref bounds-expected 0) (- 0 1))
    (set! (array-ref bounds-expected 1) 10)
    (set! (array-ref bounds-expected 2) 11)
    (set! (array-ref bounds-expected 3) 12)
    (set! (array-ref bounds-expected 4) 13)
    (set! (array-ref bounds-expected 5) 18)
    (set! (array-ref bounds-expected 6) (- 0 1))
    (unless
      (let
        [block (opt-load-sink-run (opt-load-sink-bounds-blocks))]
        (opt-load-sink-order? block bounds-expected))
      (return 7))
    42))

;; --- late compare duplication ----------------------------------------------
;;
;; Fixtures share two i64 parameters (vars 0 and 1) plus a spare var 2 that
;; stands in for a pointer, and always define the comparison as var 5.
(define (opt-cmp-dup-test-function
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol name)
    (irt.params "a=%0:i64, b=%1:i64, p=%2:i64")
    (I64)
    16
    blocks
    Ordinary))

(define (opt-cmp-dup-test-compare [lhs : ir.CompilerIrValue]) : ir.CompilerIrInstr
  (BinOp 5 (Lt) lhs (Var 1) (I64)))

;; The same comparison against a LITERAL right operand. One variable operand
;; means a copy exchanges the boolean's live range for that variable's
;; one-for-one, which is what admits a SINGLE-reader sink.
(define (opt-cmp-dup-test-compare-lit [lhs : ir.CompilerIrValue]) : ir.CompilerIrInstr
  (BinOp 5 (Lt) lhs (I64 7) (I64)))

(define (opt-cmp-dup-test-branch [cond-var : i64] [yes : String] [no : String]) : ir.CompilerIrInstr
  (Branch
    (Var cond-var)
    (ir.compiler-ir-label (& yes))
    (ir.compiler-ir-label (& no))))

(define (opt-test-instr-seq-append
  [head : ir.CompilerIrInstrSeq]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [head-count : i64 (ir.compiler-ir-instr-seq-count head)]
    [tail-count : i64 (ir.compiler-ir-instr-seq-count tail)]
    [builder : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity (+ head-count tail-count))]
    (ir.compiler-ir-instr-builder-append-seq-range!
      (&mut builder)
      head
      0
      head-count)
    (ir.compiler-ir-instr-builder-append-seq-range!
      (&mut builder)
      tail
      0
      tail-count)
    (ir.compiler-ir-instr-builder-to-seq builder)))

;; `entry` computes the comparison and branches on it right away (already
;; fused); `mid` and `other` read the same boolean from elsewhere and are the
;; sites that need their own copy. `extra?` adds the third site the budget test
;; needs. `mid-head` prefixes `mid`, which is how the non-branch-reader
;; fixtures add a second kind of use.
(define (opt-cmp-dup-shared-blocks
  [mid-head : ir.CompilerIrInstrSeq]
  [lhs : ir.CompilerIrValue]
  [extra? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "tail:
             return %0
           exit:
             return %1")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-cmp-dup-test-compare lhs)
        (opt-cmp-dup-test-branch 5 "mid" "exit")))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "mid")
      (opt-test-instr-seq-append
        mid-head
        (opt-test-instrs (opt-cmp-dup-test-branch 5 "other" "exit"))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "other")
      (if extra?
        (opt-test-instrs (opt-cmp-dup-test-branch 5 "exit" "tail"))
        (irt.instrs "jump tail")))))

;; The single-reader shape LICM leaves behind: `entry` computes the condition
;; and jumps, and the ONLY reader is the branch in `mid`. The copy `mid` takes
;; is a SINK -- it takes the last reader, so the original is dead and the `dce`
;; below the pass retires it (this pass leaves it in place, which is what the
;; assertions on `entry` state). `entry-head` prefixes `entry` and `mid-head`
;; prefixes `mid`, which is how the dead-reader and multiply-defined-operand
;; fixtures add their extra instruction.
(define (opt-cmp-dup-sink-blocks
  [entry-head : ir.CompilerIrInstrSeq]
  [mid-head : ir.CompilerIrInstrSeq]
  [compare : ir.CompilerIrInstr]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "tail:
           return %0
         exit:
           return %1")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instr-seq-append
        entry-head
        (opt-test-instrs
          compare
          (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "mid")))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "mid")
      (opt-test-instr-seq-append
        mid-head
        (opt-test-instrs (opt-cmp-dup-test-branch 5 "tail" "exit"))))))

;; `add` on the two parameters, used as the definition -- or, twice over, as the
;; MULTIPLE definitions -- of the comparison's left operand.
(define (opt-cmp-dup-operand-def [rhs : i64]) : ir.CompilerIrInstr
  (BinOp 6 (Add) (Var 0) (Var rhs) (I64)))

;; One instruction on its own list, the shape the fixture heads want.
(define (opt-cmp-dup-one-instr [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstrSeq
  (opt-test-instrs instr))

;; The negation shape the backend fuses by exchanging the branch's two labels.
;; `%5` is read by the entry branch AND by the negation, so it is refused; the
;; negation's own single reader is the branch in `other`, which therefore takes
;; a copy of the `not`. The comparison is not adjacent to the negation and not
;; single-use, so the `not (cmp a b)` fold cannot reach it either -- the copy is
;; the only thing that fuses this branch.
(define (opt-cmp-dup-not-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %5 = lt %0, %1 : i64
       branch %5, mid, exit
     mid:
       %6 = not %5 : bool
       jump other
     other:
       branch %6, tail, exit
     tail:
       return %0
     exit:
       return %1"))

(define (opt-cmp-dup-block-at
  [blocks : (& blocks ir.CompilerIrBlockList)]
  [index : i64]) : ir.CompilerIrBlock
  (match (owned_view.compiler-owned-reference-shared-view blocks)
    [(Array seq) (ir.compiler-ir-block-seq-ref seq index)]))

;; True when the block is exactly `compare; branch-on-that-compare`, the shape
;; the backend's fusion gate accepts.
(define (opt-cmp-dup-block-fused?
  [block : ir.CompilerIrBlock]
  [expect-dst : i64]) : bool
  (and
    (= (opt-block-instr-count block) 2)
    (opt-instr-compare-dst? (opt-block-instr-at block 0) expect-dst)
    (match (opt-block-instr-at block 1)
      [(Branch cond _ _)
        (match cond
          [(Var v) (= v expect-dst)]
          [_ false])]
      [_ false])))

;; True when the block is exactly `not; branch-on-that-negation` over `src`, the
;; second def shape the backend's fusion gate accepts.
(define (opt-cmp-dup-block-not-fused?
  [block : ir.CompilerIrBlock]
  [expect-dst : i64]
  [src : i64]) : bool
  (and
    (= (opt-block-instr-count block) 2)
    (match (opt-block-instr-at block 0)
      [(UnOp dst (Not) value (Bool))
        (and (= dst expect-dst) (opt.opt-value-is-var? value src))]
      [_ false])
    (match (opt-block-instr-at block 1)
      [(Branch cond _ _)
        (match cond
          [(Var v) (= v expect-dst)]
          [_ false])]
      [_ false])))

(define (opt-cmp-dup-run
  [name : String]
  [blocks : ir.CompilerIrBlockList]
  [copies : i64]) : ir.CompilerIrFunction
  (let
    [func (opt-cmp-dup-test-function name blocks)]
    (opt.opt-cmp-dup-function-with-budget func copies)))

;; Definition counts for the operand-admission arms: vars 0 and 1 have one
;; definition each, var 2 none, and var 3 as many as the caller asks for.
(define (opt-cmp-dup-defs-array [multi-def : i64]) : (__tl_dyn-array i64)
  (__tl_make-array 1 1 0 multi-def))

;; Returns 42 only when every arm of the compare-duplication contract holds.
(define (compiler-optimize-cmp-dup-self-test) : i64
  (let
    [defs : (__tl_dyn-array i64) (opt-cmp-dup-defs-array 2)]
    [shared : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_shared"
        (opt-cmp-dup-shared-blocks
          (ir.compiler-ir-instr-seq-empty)
          (Var 0)
          false)
        64)]
    [shared-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks shared)]
    ;; A stored boolean is a reader no copy can retire: the materialisation
    ;; stays, so a copy would only trade the site's `test` for a `cmp`.
    [stored : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_stored"
        (opt-cmp-dup-shared-blocks
          (irt.instrs "store_ptr %2, %5 : bool")
          (Var 0)
          false)
        64)]
    ;; A phi input is a reader too, and one this pass must never rewrite.
    [phi-input : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_phi"
        (opt-cmp-dup-shared-blocks
          (irt.instrs
            "%6 = phi [%5, entry] : bool
             store_ptr %2, %6 : bool")
          (Var 0)
          false)
        64)]
    ;; An operand that is not a stable single definition refuses: a `Global` is
    ;; an implicit mutable read, so a second evaluation may see another value.
    [global-operand : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_global"
        (opt-cmp-dup-shared-blocks
          (ir.compiler-ir-instr-seq-empty)
          (Global 7)
          false)
        64)]
    ;; Idempotence: the copies are single-use, so a second round finds nothing.
    [again : ir.CompilerIrFunction (opt.opt-cmp-dup-function shared)]
    ;; Budget: two loose sites, room for only one copy. The family must refuse
    ;; as a whole; a partial rewrite cannot retire the shared boolean.
    [capped : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_capped"
        (opt-cmp-dup-shared-blocks
          (ir.compiler-ir-instr-seq-empty)
          (Var 0)
          true)
        1)]
    [uncapped : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_uncapped"
        (opt-cmp-dup-shared-blocks
          (ir.compiler-ir-instr-seq-empty)
          (Var 0)
          true)
        64)]
    ;; The single-reader shape: one branch, in another block, is the whole use
    ;; list. The copy it takes is a sink, so the family is admitted with ONE
    ;; branch use.
    [sunk : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_sunk"
        (opt-cmp-dup-sink-blocks
          (ir.compiler-ir-instr-seq-empty)
          (ir.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-test-compare-lit (Var 0)))
        64)]
    [sunk-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks sunk)]
    ;; A reader that is itself DEAD is not a reason to refuse -- `successor_sink`
    ;; strands exactly this `mov` copy of a condition it rematerialised. The
    ;; pass sweeps its input with the same `dce` that follows it, so the sink
    ;; still fires and the stranded copy is gone from the result.
    [dead-reader : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_dead_reader"
        (opt-cmp-dup-sink-blocks
          (ir.compiler-ir-instr-seq-empty)
          (irt.instrs "%6 = mov %5 : bool")
          (opt-cmp-dup-test-compare-lit (Var 0)))
        64)]
    ;; Control for the multiple-definition arm below: the same fixture with the
    ;; operand defined ONCE sinks.
    [one-def-operand : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_one_def_operand"
        (opt-cmp-dup-sink-blocks
          (opt-cmp-dup-one-instr (opt-cmp-dup-operand-def 1))
          (ir.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-test-compare-lit (Var 6)))
        64)]
    ;; Two definitions of that operand and nothing else changes: the copy would
    ;; have no point at which the recipe is known to hold, so the family is
    ;; refused. SSA makes this unreachable in the pipeline; the pass tests it
    ;; rather than trusting the clone-producing passes above it.
    [multi-def-operand : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_multi_def_operand"
        (opt-cmp-dup-sink-blocks
          (opt-cmp-dup-one-instr (opt-cmp-dup-operand-def 1))
          (opt-cmp-dup-one-instr (opt-cmp-dup-operand-def 0))
          (opt-cmp-dup-test-compare-lit (Var 6)))
        64)]
    ;; TWO variable operands and a single branch reader: the copy would put both
    ;; operands where one boolean used to be, so the sink is refused. The
    ;; `shared` fixture above is the same comparison with a second branch reader
    ;; and IS rewritten -- a shared boolean pays for the extra value.
    [two-var-single-reader : ir.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_two_var_single_reader"
        (opt-cmp-dup-sink-blocks
          (ir.compiler-ir-instr-seq-empty)
          (ir.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-test-compare (Var 0)))
        64)]
    ;; The boolean negation the backend fuses by exchanging the branch labels.
    [not-sunk : ir.CompilerIrFunction
      (opt-cmp-dup-run "cmp_dup_not" (opt-cmp-dup-not-blocks) 64)]
    [not-sunk-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks not-sunk)]
    ;; The already-adjacent site is left alone and the remote one gained its
    ;; own copy of the same comparison.
    (unless (= (opt.opt-function-frame shared) 17) (return 1))
    (unless
      (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at shared-blocks 0) 5)
      (return 2))
    (unless
      (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at shared-blocks 1) 16)
      (return 3))
    (unless
      (match (let
        [block (opt-cmp-dup-block-at shared-blocks 1)]
        (opt-block-instr-at block 0))
        [(BinOp _ _ lhs rhs _)
          (and (opt.opt-value-is-var? lhs 0) (opt.opt-value-is-var? rhs 1))]
        [_ false])
      (return 4))
    ;; Refusals leave the frame -- and therefore the whole function -- alone.
    (unless (= (opt.opt-function-frame global-operand) 16) (return 5))
    (unless (= (opt.opt-function-frame again) 17) (return 6))
    (unless (= (opt.opt-function-frame capped) 16) (return 7))
    (unless (= (opt.opt-function-frame uncapped) 18) (return 8))
    ;; Operand admission, stated directly: literals and single-definition
    ;; variables are re-evaluable; the compare's own destination, a
    ;; multiply-defined variable, and implicit global reads are not.
    (unless (opt.opt-cmp-dup-operand-ok? (& (I64 3)) 5 defs) (return 9))
    (unless (opt.opt-cmp-dup-operand-ok? (& (Var 0)) 5 defs) (return 10))
    (when (opt.opt-cmp-dup-operand-ok? (& (Var 3)) 5 defs) (return 11))
    (when (opt.opt-cmp-dup-operand-ok? (& (Var 5)) 5 defs) (return 12))
    (when
      (opt.opt-cmp-dup-operand-ok? (& (RuntimeGlobal 2)) 5 defs)
      (return 13))
    ;; Both extra readers refuse outright: nothing is copied and the phi
    ;; input still names the shared comparison.
    (unless (= (opt.opt-function-frame stored) 16) (return 14))
    (unless (= (opt.opt-function-frame phi-input) 16) (return 15))
    (unless
      (match (let
        [block
          (let
            [blocks (opt.opt-function-blocks phi-input)]
            (opt-cmp-dup-block-at blocks 1))]
        (opt-block-instr-at block 0))
        [(Phi _ inputs _)
          (let
            [phi-inputs-at-9533-13 : ir.CompilerIrPhiInputSeq inputs]
            (if (<= phi-inputs-at-9533-13.len 0)
              false
              (let
                [phi-input-at-9533-13 : ir.CompilerIrPhiInput
                  (ir.compiler-ir-phi-input-seq-ref phi-inputs-at-9533-13 0)]
                [value : ir.CompilerIrValue phi-input-at-9533-13.value]
                (opt.opt-value-is-var? value 5))))]
        [_ false])
      (return 16))
    ;; The remote branch took its own copy of the comparison, and the copy is
    ;; adjacent to it -- the backend's fusion gate reads exactly that.
    (unless (= (opt.opt-function-frame sunk) 17) (return 17))
    (unless
      (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at sunk-blocks 1) 16)
      (return 18))
    (unless
      (match (let
        [block (opt-cmp-dup-block-at sunk-blocks 1)]
        (opt-block-instr-at block 0))
        [(BinOp _ _ lhs rhs _)
          (and
            (opt.opt-value-is-var? lhs 0)
            (match rhs
              [(I64 n) (= n 7)]
              [_ false]))]
        [_ false])
      (return 19))
    ;; The original is left exactly where it was: retiring it is the job of
    ;; the `dce` that runs under the pass in `opt-cmp-dup-final-pass`.
    (unless
      (and
        (=
          (let
            [block (opt-cmp-dup-block-at sunk-blocks 0)]
            (opt-block-instr-count block))
          2)
        (opt-instr-compare-dst?
          (let
            [block (opt-cmp-dup-block-at sunk-blocks 0)]
            (opt-block-instr-at block 0))
          5))
      (return 20))
    ;; The dead `mov` reader neither blocks the sink nor survives it.
    (unless (= (opt.opt-function-frame dead-reader) 17) (return 21))
    (unless
      (opt-cmp-dup-block-fused?
        (let
          [blocks (opt.opt-function-blocks dead-reader)]
          (opt-cmp-dup-block-at blocks 1))
        16)
      (return 22))
    ;; Operand definition counts, at the pass level this time: one definition
    ;; sinks, two refuse, and nothing else differs between the two fixtures.
    (unless (= (opt.opt-function-frame one-def-operand) 17) (return 23))
    (unless (= (opt.opt-function-frame multi-def-operand) 16) (return 24))
    ;; The live-range exchange has to be one-for-one for a single reader.
    (unless (= (opt.opt-function-frame two-var-single-reader) 16) (return 25))
    ;; The negation is copied onto its branch as a negation; the comparison it
    ;; reads keeps its own already-fused site and is itself refused, because
    ;; the negation is a non-branch reader of it.
    (unless (= (opt.opt-function-frame not-sunk) 17) (return 26))
    (unless
      (opt-cmp-dup-block-not-fused?
        (opt-cmp-dup-block-at not-sunk-blocks 2)
        16
        5)
      (return 27))
    (unless
      (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at not-sunk-blocks 0) 5)
      (return 28))
    42))

;; --- DCE-LATE: the last dead-instruction sweep -------------------------------
;;
;; Fixtures share one i64 parameter (var 0) and a 16-slot frame, and drive
;; `opt-dce-late-final-pass` directly: the slot is the LAST thing the level-2
;; pipeline runs, so nothing below it can hide a shape it fails to retire.
(define (opt-dce-late-test-function
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol name)
    (irt.params "a=%0:i64")
    (I64)
    16
    blocks
    Ordinary))

(define (opt-dce-late-run [name : String] [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (match (opt.opt-dce-late-final-pass
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-dce-late-test-function name blocks)))
    [(Result next _) next]))

(define (opt-dce-late-run-changed?
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : bool
  (match (opt.opt-dce-late-final-pass
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-dce-late-test-function name blocks)))
    [(Result _ changed) changed]))

;; `%5` is a literal Mov nothing reads, `%6` an addition only `%5`'s neighbour
;; could have read, and `%7` the copy the return consumes. The sweep must
;; retire the first two and keep the third.
(define (opt-dce-late-dead-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %5 = mov -1 : i64
       %6 = add %0, %5 : i64
       %7 = mov %0 : i64
       return %7"))

;; The same literal Mov, this time READ by the return: nothing may touch it.
(define (opt-dce-late-live-blocks) : ir.CompilerIrBlockList
  (irt.blocks "entry:
       %5 = mov -1 : i64
       return %5"))

;; A Mov read ONLY by a phi input is read all the same, and the phi's own
;; block keeps it: use counting has no special case for phi operands.
(define (opt-dce-late-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %5 = mov -1 : i64
       jump join
     join:
       %6 = phi [%5, entry] : i64
       return %6"))

;; The threader's leftover: the branch condition is a Mov of a bool literal, so
;; one arm is unreachable. `cond?` false spells the same shape with a compare,
;; which decides nothing and must be left exactly as written.
(define (opt-dce-late-branch-blocks [literal? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "taken:
         return 1
       other:
         return 2")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (opt-test-instrs
        (if literal?
          (irt.instr "%5 = mov false : bool")
          (irt.instr "%5 = lt %0, 7 : bool"))
        (irt.instr "branch %5, taken, other")))))

(define (opt-dce-late-instr-mov? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(Mov _ _ _) true]
    [_ false]))

(define (opt-dce-late-instr-jump-to? [instr : ir.CompilerIrInstr] [label : i64]) : bool
  (match instr
    [(Jump target) (= target label)]
    [_ false]))

;; Returns 42 only when every arm of the late sweep's contract holds.
(define (compiler-optimize-dce-late-self-test) : i64
  (let
    [dead : ir.CompilerIrFunction
      (opt-dce-late-run "dce_late_dead" (opt-dce-late-dead-blocks))]
    [live : ir.CompilerIrFunction
      (opt-dce-late-run "dce_late_live" (opt-dce-late-live-blocks))]
    [live-changed? : bool
      (opt-dce-late-run-changed? "dce_late_live" (opt-dce-late-live-blocks))]
    [phi : ir.CompilerIrFunction
      (opt-dce-late-run "dce_late_phi" (opt-dce-late-phi-blocks))]
    [folded : ir.CompilerIrFunction
      (opt-dce-late-run "dce_late_fold" (opt-dce-late-branch-blocks true))]
    [folded-changed? : bool
      (opt-dce-late-run-changed?
        "dce_late_fold"
        (opt-dce-late-branch-blocks true))]
    [kept : ir.CompilerIrFunction
      (opt-dce-late-run "dce_late_keep" (opt-dce-late-branch-blocks false))]
    [kept-changed? : bool
      (opt-dce-late-run-changed?
        "dce_late_keep"
        (opt-dce-late-branch-blocks false))]
    [dead-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks dead)]
    [live-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks live)]
    [phi-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks phi)]
    [folded-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks folded)]
    [kept-blocks : ir.CompilerIrBlockList (opt.opt-function-blocks kept)]
    ;; The zero-use literal Mov and the addition that was its only neighbour
    ;; are both gone; the copy the return reads stays.
    (unless
      (=
        (let
          [block (opt-cmp-dup-block-at dead-blocks 0)]
          (opt-block-instr-count block))
        2)
      (return 1))
    (unless
      (opt-dce-late-instr-mov?
        (let
          [block (opt-cmp-dup-block-at dead-blocks 0)]
          (opt-block-instr-at block 0)))
      (return 2))
    (unless
      (match (let
        [block (opt-cmp-dup-block-at dead-blocks 0)]
        (opt-block-instr-at block 0))
        [(Mov dst src _) (and (= dst 7) (opt.opt-value-is-var? src 0))]
        [_ false])
      (return 3))
    ;; A read literal Mov survives, and the pass reports no change.
    (unless
      (=
        (let
          [block (opt-cmp-dup-block-at live-blocks 0)]
          (opt-block-instr-count block))
        2)
      (return 4))
    (unless
      (opt-dce-late-instr-mov?
        (let
          [block (opt-cmp-dup-block-at live-blocks 0)]
          (opt-block-instr-at block 0)))
      (return 5))
    (when live-changed? (return 6))
    ;; A phi input is a read.
    (unless
      (=
        (let
          [block (opt-cmp-dup-block-at phi-blocks 0)]
          (opt-block-instr-count block))
        2)
      (return 7))
    (unless
      (opt-dce-late-instr-mov?
        (let
          [block (opt-cmp-dup-block-at phi-blocks 0)]
          (opt-block-instr-at block 0)))
      (return 8))
    ;; The literal-fed branch becomes a jump to the arm the literal selects,
    ;; the other arm is dropped, and the Mov that fed it goes with it.
    (unless (= (ir.compiler-ir-block-list-count folded-blocks) 2) (return 9))
    (unless
      (opt-block-list-has-label?
        (ir.compiler-ir-block-list-view folded-blocks)
        (ir.compiler-ir-label "other"))
      (return 10))
    (when
      (opt-block-list-has-label?
        (ir.compiler-ir-block-list-view folded-blocks)
        (ir.compiler-ir-label "taken"))
      (return 11))
    (unless
      (=
        (let
          [block (opt-cmp-dup-block-at folded-blocks 0)]
          (opt-block-instr-count block))
        1)
      (return 12))
    (unless
      (opt-dce-late-instr-jump-to?
        (let
          [block (opt-cmp-dup-block-at folded-blocks 0)]
          (opt-block-instr-at block 0))
        (ir.compiler-ir-label "other"))
      (return 13))
    (unless folded-changed? (return 14))
    ;; A branch on a real comparison decides nothing: both arms stay and the
    ;; block is left exactly as written.
    (unless (= (ir.compiler-ir-block-list-count kept-blocks) 3) (return 15))
    (unless
      (=
        (let
          [block (opt-cmp-dup-block-at kept-blocks 0)]
          (opt-block-instr-count block))
        2)
      (return 16))
    (when kept-changed? (return 17))
    42))

(test
  dce-late-final-sweep
  (test.assert-i64-eq
    (compiler-optimize-dce-late-self-test)
    42
    "the late slot retires a zero-use Mov and the chain it fed, keeps a Mov read by a return or by a phi input, folds a branch whose condition is a Mov of a bool literal into a jump and drops the arm it retired, and leaves a branch on a real comparison alone"))

;; --- DCE-LATE: the decided join and its pre-copy -----------------------------
;;
;; The `found`/`done` shape, spelled the way `cfg_straighten` hands it to the
;; slot. `join` is decided on every edge -- its condition is a phi of bool
;; literals -- but it also carries `%7`, read only from the true side, and the
;; PRE-COPY `%8 = mov %0` the phi cleanup left behind, read only from the false
;; side. Two region-local definitions owned by two different successors is what
;; makes `thread_branch_late` refuse the merge whole, so the slot has to
;; forward the pre-copy before the threader can decide anything.
(define (opt-dce-late-precopy-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %5 = lt %0, 7 : bool
       branch %5, one, two
     one:
       jump join
     two:
       jump join
     join:
       %6 = phi [true, one], [false, two] : bool
       %7 = phi [%0, one], [1, two] : i64
       %8 = mov %0 : i64
       branch %6, then, else
     then:
       return %7
     else:
       %9 = add %8, 1 : i64
       return %9"))

(define (opt-dce-late-instrs-count-mov-dst
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : i64
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs pos)
        [(Mov mov-dst _ _)
          (if (= mov-dst dst)
            1
            0)]
        [_ 0])
      (opt-dce-late-instrs-count-mov-dst instrs (+ pos 1) dst))))

(define (opt-dce-late-blocks-count-mov-dst
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (+
        (match (owned_view.compiler-owned-reference-shared-view block)
          [(Block _ instrs) (opt-dce-late-instrs-count-mov-dst instrs 0 dst)])
        (opt-dce-late-blocks-count-mov-dst rest dst))]))

(define (opt-dce-late-instrs-count-branches
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]) : i64
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (ir.compiler-ir-instr-seq-ref instrs pos)
        [(Branch _ _ _) 1]
        [_ 0])
      (opt-dce-late-instrs-count-branches instrs (+ pos 1)))))

(define (opt-dce-late-blocks-count-branches
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]) : i64
  (match blocks
    [(slice) 0]
    [(slice block & rest)
      (+
        (match (owned_view.compiler-owned-reference-shared-view block)
          [(Block _ instrs) (opt-dce-late-instrs-count-branches instrs 0)])
        (opt-dce-late-blocks-count-branches rest))]))

;; Does any block read `var` as an ordinary (non-phi) operand of an Add?
(define (opt-dce-late-blocks-add-reads?
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [var : i64]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (or
        (match (owned_view.compiler-owned-reference-shared-view block)
          [(Block _ instrs) (opt-dce-late-instrs-add-reads? instrs 0 var)])
        (opt-dce-late-blocks-add-reads? rest var))]))

(define (opt-dce-late-instrs-add-reads?
  [instrs : ir.CompilerIrInstrSeq]
  [pos : i64]
  [var : i64]) : bool
  (if (>= pos (ir.compiler-ir-instr-seq-count instrs))
    false
    (or
      (match (ir.compiler-ir-instr-seq-ref instrs pos)
        [(BinOp _ _ left _ _) (opt.opt-value-is-var? left var)]
        [_ false])
      (opt-dce-late-instrs-add-reads? instrs (+ pos 1) var))))

;; Returns 42 only when the slot retires the decided join outright.
(define (compiler-optimize-dce-late-precopy-self-test) : i64
  (let
    [threaded : ir.CompilerIrFunction
      (opt-dce-late-run "dce_late_precopy" (opt-dce-late-precopy-blocks))]
    [changed? : bool
      (opt-dce-late-run-changed?
        "dce_late_precopy"
        (opt-dce-late-precopy-blocks))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks threaded)]
    (unless changed? (return 1))
    ;; The pre-copy is gone -- forwarded at its use, then swept.
    (unless
      (=
        (opt-dce-late-blocks-count-mov-dst
          (ir.compiler-ir-block-list-view blocks)
          8)
        0)
      (return 2))
    ;; Its reader now names the copy's source directly.
    (unless
      (opt-dce-late-blocks-add-reads? (ir.compiler-ir-block-list-view blocks) 0)
      (return 3))
    ;; Only the entry's undecided compare-branch is left: the join's decided
    ;; branch is retired, so no edge materializes a literal to re-test it.
    (unless
      (=
        (opt-dce-late-blocks-count-branches
          (ir.compiler-ir-block-list-view blocks))
        1)
      (return 4))
    42))

(test
  dce-late-decided-join-precopy
  (test.assert-i64-eq
    (compiler-optimize-dce-late-precopy-self-test)
    42
    "the late slot forwards the pre-copy a uniform-phi fold left in a decided join, threads the join's decided edges, and leaves neither the copy nor a branch on a per-edge literal behind"))

;; Pricing a candidate runs the frozen priced pipeline, which leaves the late
;; sweep out; nothing it does switches the sweep off for the pipeline after it.
(define (compiler-optimize-late-sweep-after-pricing-self-test) : i64
  (let
    ;; Priced exactly the way `opt-inline-checked-verdict` prices a site; the
    ;; cost itself is not what is under test, the state it leaves behind is.
    [priced : i64
      (opt.opt-inline-checked-plan-cost
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (&
          (opt-dce-late-test-function
            "dce_late_priced"
            (opt-dce-late-dead-blocks))))]
    (cond
      [(< priced 0) 1]
      [(not
          (opt-dce-late-run-changed?
            "dce_late_after_pricing"
            (opt-dce-late-dead-blocks)))
        2]
      [else 42])))

(test
  dce-late-runs-after-pricing
  (test.assert-i64-eq
    (compiler-optimize-late-sweep-after-pricing-self-test)
    42
    "pricing a candidate leaves the pipeline's own late sweep on, so it runs and reports its change"))

(define (opt-successor-sink-test-function
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (Function
    (opt-test-symbol name)
    (irt.params "cond=%0:bool, value=%1:i64")
    (I64)
    16
    blocks
    Ordinary))

;; Both producers start in `entry`. Backward planning first moves the Pack whose
;; Word use is in `use`, then recognizes that the Load's only remaining use is
;; in that already-moved Pack and moves the Load ahead of it.
(define (opt-successor-sink-positive-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = load %1 : i64
       %3 = pack [%2] : OneWord
       branch %0, use, other
     use:
       %4 = word %3, 0 : i64
       return %4
     other:
       return 0"))

;; An unconditional edge is a scheduling boundary, not an execution choice.
;; The incoming parameter is therefore already live across it, and the Mov can
;; move beside its sole use without extending execution or violating dominance.
(define (opt-successor-sink-jump-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov %1 : i64
       jump use
     use:
       %3 = add %2, 1 : i64
       return %3"))

;; The payload address uses a two-instruction address chain that is also needed
;; by the tag load in the dispatch block. Sinking the payload Load therefore
;; moves v4 but clones v3 and, transitively, v2 with fresh ids 16 and 17.
(define (opt-successor-sink-remat-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mul %1, 16 : i64
       %3 = gep %1, %2 : u8
       %4 = gep %3, 8 : u8
       %5 = load %4 : i64
       %6 = load %3 : i64
       switch %6 base 0 [0:other] default use
     use:
       return %5
     other:
       return %6"))

;; v2 is a source-block Mov with uses in both paths. It cannot move and is not
;; in the Gep/BinOp rematerialization whitelist, so neither consumer may sink.
(define (opt-successor-sink-live-range-blocked-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov %1 : i64
       %3 = load %2 : i64
       %4 = add %2, 1 : i64
       branch %0, use, other
     use:
       return %3
     other:
       return %4"))

;; v2 is external to `entry`, but the key address/load/compare makes it part of
;; the terminator dependency slice. The sibling payload Gep/Load may therefore
;; move to the matching arm without rematerializing that already-live leaf.
(define (opt-successor-sink-terminator-live-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "preheader:
       %2 = mov %1 : i64
       jump entry
     entry:
       %3 = gep %2, 0 : u8
       %4 = load %3 : i64
       %5 = gep %2, 8 : u8
       %6 = load %5 : i64
       %7 = eq %4, 1 : bool
       branch %7, use, other
     use:
       return %6
     other:
       return 0"))

;; v2 is defined in a predecessor and is not otherwise live in either
;; successor. Moving the source-block address producer would extend v2's live
;; range, while cloning it would do the same, so the payload Load must stay.
(define (opt-successor-sink-external-leaf-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "preheader:
       %2 = mov %1 : i64
       jump entry
     entry:
       %3 = add %2, 8 : i64
       %4 = load %3 : i64
       branch %0, use, other
     use:
       return %4
     other:
       return 0"))

;; Sinking v8 would require cloning v6..v2. The fifth clone exceeds the cap;
;; the whole transaction, including its tentative fresh frame ids, rolls back.
(define (opt-successor-sink-remat-cap-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = add %1, 1 : i64
       %3 = add %2, 1 : i64
       %4 = add %3, 1 : i64
       %5 = add %4, 1 : i64
       %6 = add %5, 1 : i64
       %7 = gep %6, 0 : u8
       %8 = load %7 : i64
       %9 = add %6, 1 : i64
       switch %9 base 0 [0:other] default use
     use:
       return %8
     other:
       return %9"))

;; Strength-reduced loop-pointer form used by vm_run. The dead block-local Mul
;; is the retained rematerialization recipe; v12 itself must not reach `use`.
(define (opt-successor-sink-induction-remat-blocks-with-step [step : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block
      "preheader:
         %10 = mul 0, 16 : i64
         %11 = gep %1, %10 : u8
         jump header")
    (irt.block
      "header:
           %12 = phi [%11, preheader], [%13, merge] : i64
           %2 = phi [0, preheader], [%3, merge] : i64
           %4 = mul %2, 16 : i64
           %5 = gep %12, 8 : u8
           %6 = load %5 : i64
           %7 = gep %12, 0 : u8
           %8 = load %7 : i64
           switch %8 base 0 [0:other] default use")
    (irt.block "use:
             return %6")
    (irt.block "other:
               jump merge")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "merge")
      (opt-test-instrs
        (ir.CompilerIrInstr.BinOp 3 (Add) (Var 2) (I64 step) (I64))
        (irt.instr "%13 = gep %12, 16 : u8")
        (ir.CompilerIrInstr.Jump (ir.compiler-ir-label "header"))))))

(define (opt-successor-sink-induction-remat-blocks) : ir.CompilerIrBlockList
  (opt-successor-sink-induction-remat-blocks-with-step 1))

;; v2 is read in both successors, so neither successor owns every use.
(define (opt-successor-sink-multi-use-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov %1 : i64
       branch %0, left, right
     left:
       return %2
     right:
       return %2"))

;; `left` is a direct successor of entry but also reachable through `right`.
;; Entry still dominates it, keeping the fixture valid SSA, while its two
;; predecessors make it ineligible for sinking.
(define (opt-successor-sink-multi-pred-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov %1 : i64
       branch %0, left, right
     right:
       jump left
     left:
       return %2"))

;; The StorePtr between the Load and terminator is an explicit first-cut load
;; barrier even though the loaded result is used in only one successor.
(define (opt-successor-sink-store-barrier-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = load %1 : i64
       store_ptr %1, 9 : i64
       branch %0, use, other
     use:
       return %2
     other:
       return 0"))

;; SafeDiv still has language-level abort semantics and must not be scheduled
;; conditionally, despite otherwise looking like a pure binary definition.
(define (opt-successor-sink-trapping-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = safe_div %1, 2 : i64
       branch %0, use, other
     use:
       return %2
     other:
       return 0"))

(define (opt-successor-sink-instr-seq-defines?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (let
      [instr (ir.compiler-ir-instr-seq-ref instrs index)]
      (opt.opt-instr-def-var (opt.compiler-opt-global-shared-view instr)))
      [(Some found)
        (if (= found dst)
          true
          (opt-successor-sink-instr-seq-defines? instrs (+ index 1) dst))]
      [(None) (opt-successor-sink-instr-seq-defines? instrs (+ index 1) dst)])))

(define (opt-successor-sink-def-label
  [blocks : (& blocks (Slice ir.CompilerIrBlock))]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(slice) fallback]
    [(slice block & rest)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block label instrs)
          (if (opt-successor-sink-instr-seq-defines? instrs 0 dst)
            label
            (opt-successor-sink-def-label rest dst fallback))])]))

(define (opt-successor-sink-run-function
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (opt.opt-successor-sink-function
    (ast.ast-node-pool-reader-type-segment-bases)
    (& (opt-successor-sink-test-function name blocks))))

(define (opt-successor-sink-run
  [name : String]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [func (opt-successor-sink-run-function name blocks)]
    (opt.opt-function-blocks func)))

(define (compiler-optimize-successor-sink-self-test) : i64
  (let
    [positive : ir.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_positive"
        (opt-successor-sink-positive-blocks))]
    [jump : ir.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_jump"
        (opt-successor-sink-jump-blocks))]
    [remat-function : ir.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_remat"
        (opt-successor-sink-remat-blocks))]
    [remat : ir.CompilerIrBlockList (opt.opt-function-blocks remat-function)]
    [live-range-blocked : ir.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_live_range_blocked"
        (opt-successor-sink-live-range-blocked-blocks))]
    [terminator-live : ir.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_terminator_live"
        (opt-successor-sink-terminator-live-blocks))]
    [external-leaf-function : ir.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_external_leaf"
        (opt-successor-sink-external-leaf-blocks))]
    [external-leaf : ir.CompilerIrBlockList
      (opt.opt-function-blocks external-leaf-function)]
    [remat-cap-function : ir.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_remat_cap"
        (opt-successor-sink-remat-cap-blocks))]
    [remat-cap : ir.CompilerIrBlockList
      (opt.opt-function-blocks remat-cap-function)]
    [induction-input : ir.CompilerIrBlockList
      (opt-successor-sink-induction-remat-blocks)]
    [induction-cell : (__tl_dyn-array i64) (opt.opt-used-array-new 1)]
    [_induction-cell-init : unit (set! (array-ref induction-cell 0) 16)]
    [induction-direct : ir.CompilerIrBlockList
      (opt.opt-successor-sink-blocks
        (ast.ast-node-pool-reader-type-segment-bases)
        16
        (opt.compiler-opt-global-shared-view induction-cell)
        (& induction-input))]
    [induction-function : ir.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_induction_remat"
        (opt-successor-sink-induction-remat-blocks))]
    [induction : ir.CompilerIrBlockList
      (opt.opt-function-blocks induction-function)]
    [induction-step-two-function : ir.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_induction_step_two"
