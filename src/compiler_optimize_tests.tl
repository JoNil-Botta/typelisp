        16]
      [(not (= (opt.opt-natural-loop-list-count diamond-loops) 0)) 17]
      [(not (= (opt.opt-natural-loop-list-count irreducible-loops) 0)) 18]
      [(not (= (opt.opt-natural-loop-list-count no-preheader-loops) 1)) 19]
      [(not
