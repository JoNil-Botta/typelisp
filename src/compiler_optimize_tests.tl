        41]
      [(not (= (opt-count-load-instr-seq copybytes-overlap) 2)) 42]
      [(not (= (opt-count-mov-dst-instr-seq copybytes-overlap 5) 0)) 43]
      [(not (opt-load-cse-cap-self-test?)) 45]
      [(not (= (opt-count-load-instr-seq checked-distinct) 1)) 46]
      [(not
