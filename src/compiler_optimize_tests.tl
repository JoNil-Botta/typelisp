(defstruct OptInlineSpanTestSymbols
  (main i64)
  (inline-span i64)
  (opaque i64))

(define (opt-inline-span-test-symbols) : OptInlineSpanTestSymbols
  (OptInlineSpanTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "inline_span")
    (opt-test-symbol "opaque")))

(define (opt-inline-span-callee-call [symbols : OptInlineSpanTestSymbols]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    1
    symbols.opaque
    (compiler_ir_types.CompilerIrCallArgs.One
      (compiler_ir_types.CompilerIrValue.Var 0))
    (compiler_ast_types.AstType.I64)))

(define (opt-inline-span-callee [symbols : OptInlineSpanTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-span
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "value"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-seq-empty))
    (compiler_ast_types.AstType.I64)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-span-callee-call symbols)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 1)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-span-caller-call [symbols : OptInlineSpanTestSymbols]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    0
    symbols.inline-span
    (compiler_ir_types.CompilerIrCallArgs.One
      (compiler_ir_types.CompilerIrValue.I64 7))
    (compiler_ast_types.AstType.I64)))

(define (opt-inline-span-caller [symbols : OptInlineSpanTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-span-caller-call symbols)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-span-program [symbols : OptInlineSpanTestSymbols]) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-span-caller symbols)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-span-callee symbols)
        (compiler_ir_types.compiler-ir-function-seq-empty)))
    (compiler_ir_types.compiler-ir-extern-seq-empty)))

(define (compiler-optimize-spans-inline-callee-ok?) : bool
  (let
    [symbols : OptInlineSpanTestSymbols (opt-inline-span-test-symbols)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr-located
        (compiler_ir_types.compiler-source-spans-insert-instr-located
          (opt-spans-base)
          (opt-test-span-symbol "inline_span")
          (opt-inline-span-callee-call symbols)
          701
          (opt-test-span 71 13))
        (opt-test-span-symbol "main")
        (opt-inline-span-caller-call symbols)
        801
        (opt-test-span 81 15))]
    [cloned-call : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        1
        symbols.opaque
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 7))
        (compiler_ast_types.AstType.I64))]
    [previous-debug : bool (compiler_ir_types.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        (compiler_ir_types.compiler-debug-info-set-enabled! true)
        (match (compiler_optimize.optimize-program-with-spans-and-level
          (opt-inline-span-program symbols)
          (compiler_ir_types.compiler-ir-global-shared-view spans)
          2)
          [(compiler_optimize.CompilerOptimizedProgram.Program
              _
              optimized-spans)
            (and
              (opt-span-lookup-ok?
                (compiler_optimize.compiler-opt-global-shared-view
                  optimized-spans)
                (opt-test-symbol "main")
                (compiler_optimize.compiler-opt-global-shared-view cloned-call)
                71
                13)
              (opt-location-lookup-ok?
                optimized-spans
                (opt-test-symbol "main")
                cloned-call
                701
                71
                13))]))]
    (begin
      (compiler_ir_types.compiler-debug-info-set-enabled! previous-debug)
      ok)))

