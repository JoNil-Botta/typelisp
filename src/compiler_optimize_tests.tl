          (opt-thread-first-phi-input-i64?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-multi-phi-blocks)
            (compiler_ir_types.compiler-ir-label "tp-yes")
            (compiler_ir_types.compiler-ir-label "tp-alt")
            30)
          (not
            (opt-thread-first-phi-has-input?
              (compiler_optimize.compiler-opt-global-shared-view
                thread-multi-phi-blocks)
              (compiler_ir_types.compiler-ir-label "tp-yes")
              (compiler_ir_types.compiler-ir-label "tp-merge")))
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-multi-phi-blocks)))
        (return 69))
      ;; D1 rail, widened by T2-5: `%4` is read by an ordinary instruction in
      ;; `tv-yes`, which is entered only from the merge and dominates every
      ;; reader, so the merge's definition still reaches them on every path
      ;; INTO `tv-yes` -- as long as no edge is threaded past the merge into
      ;; that side. `tv-a` carries the `true` that would do exactly that and is
      ;; refused; `tv-b` carries `false`, whose side reads nothing the merge
      ;; defines, and threads. The merge survives holding `tv-a`.
      (unless
        (and
          thread-live-out-changed
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-live-out-blocks)
            (compiler_ir_types.compiler-ir-label "tv-merge"))
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-live-out-blocks)
              (compiler_ir_types.compiler-ir-label "tv-merge"))
            1)
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-live-out-blocks)
              (compiler_ir_types.compiler-ir-label "tv-no"))
            2)
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-live-out-blocks)))
        (return 70))
      ;; D1: a non-constant edge is untouched. `tx-a` decides the branch and
      ;; threads; `tx-b` carries a parameter, so the merge stays and keeps it.
      (unless
        (and
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-mixed-edge-blocks)
            (compiler_ir_types.compiler-ir-label "tx-merge"))
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-mixed-edge-blocks)
              (compiler_ir_types.compiler-ir-label "tx-merge"))
            1)
          (opt-thread-first-phi-input-i64?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-mixed-edge-blocks)
            (compiler_ir_types.compiler-ir-label "tx-yes")
            (compiler_ir_types.compiler-ir-label "tx-a")
            10)
          (opt-thread-first-phi-has-input?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-mixed-edge-blocks)
            (compiler_ir_types.compiler-ir-label "tx-yes")
            (compiler_ir_types.compiler-ir-label "tx-merge"))
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-mixed-edge-blocks)))
        (return 71))
      ;; D2: the branch reads a comparison over the merge's own `i64` phi.
      ;; `5 >= 0` decides `tq-a` and `-1 >= 0` decides `tq-b`; both are
      ;; redirected, `tq-a` carrying the `5` the successor phi asked for.
      ;; `tq-c` and `tq-d` never decide, so the merge survives holding exactly
      ;; those two.
      (unless
        (and
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-blocks)
            (compiler_ir_types.compiler-ir-label "tq-merge"))
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-compare-blocks)
              (compiler_ir_types.compiler-ir-label "tq-merge"))
            2)
          (opt-thread-first-phi-input-i64?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-blocks)
            (compiler_ir_types.compiler-ir-label "tq-yes")
            (compiler_ir_types.compiler-ir-label "tq-a")
            5)
          (opt-thread-first-phi-input-i64?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-blocks)
            (compiler_ir_types.compiler-ir-label "tq-no")
            (compiler_ir_types.compiler-ir-label "tq-b")
            41)
          (opt-thread-first-phi-has-input?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-blocks)
            (compiler_ir_types.compiler-ir-label "tq-yes")
            (compiler_ir_types.compiler-ir-label "tq-merge"))
          (opt-thread-cmp-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-blocks)))
        (return 72))
      ;; D2 rail: the same shape with an equality comparison. `tr-a` carries the
      ;; `5` that decides `eq %5, 5`, but only the ordering comparisons are
      ;; threaded, so nothing moves.
      (unless
        (and
          (not thread-compare-open-changed)
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-open-blocks)
            (compiler_ir_types.compiler-ir-label "tr-merge"))
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-compare-open-blocks)
              (compiler_ir_types.compiler-ir-label "tr-merge"))
            2)
          (opt-thread-cmp-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-compare-open-blocks)))
        (return 73))
      ;; D3: the condition phi has a second reader -- `td-yes`'s phi on the
      ;; merge edge. The old single-use gate refused the block outright; the
      ;; live-out rule admits it and the repair hands `td-a` the `true` the
      ;; condition phi carried for that edge.
      (unless
        (and
          (not
            (opt-block-list-has-label?
              (compiler_optimize.compiler-opt-global-shared-view
                thread-multi-use-blocks)
              (compiler_ir_types.compiler-ir-label "td-merge")))
          (opt-thread-first-phi-input-bool?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-multi-use-blocks)
            (compiler_ir_types.compiler-ir-label "td-yes")
            (compiler_ir_types.compiler-ir-label "td-a")
            true)
          (opt-thread-first-phi-input-bool?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-multi-use-blocks)
            (compiler_ir_types.compiler-ir-label "td-yes")
            (compiler_ir_types.compiler-ir-label "td-alt")
            false)
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-multi-use-blocks))
          ;; A further round then decides `td-yes` itself on the edge the
          ;; repair rewrote: `td-a` leaves it for `td-y1` directly, while
          ;; `td-alt` keeps its conditional edge and the block stays.
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-multi-use-settled-blocks)
              (compiler_ir_types.compiler-ir-label "td-yes"))
            0)
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-multi-use-settled-blocks)))
        (return 74))
      ;; D3: six decided predecessors, `opt-thread-pred-budget` of them per
      ;; round. One round leaves two behind, two rounds finish the block, and
      ;; the production fuel converges.
      (unless
        (and
          (opt-block-list-has-label?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-wide-one-round-blocks)
            (compiler_ir_types.compiler-ir-label "tk-merge"))
          (=
            (opt-count-jump-to-blocks
              (compiler_optimize.compiler-opt-global-shared-view
                thread-wide-one-round-blocks)
              (compiler_ir_types.compiler-ir-label "tk-merge"))
            2)
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-wide-one-round-blocks))
          (not
            (opt-block-list-has-label?
              (compiler_optimize.compiler-opt-global-shared-view
                thread-wide-two-round-blocks)
              (compiler_ir_types.compiler-ir-label "tk-merge")))
          (not
            (opt-block-list-has-label?
              (compiler_optimize.compiler-opt-global-shared-view
                thread-wide-blocks)
              (compiler_ir_types.compiler-ir-label "tk-merge")))
          (opt-thread-pass-verified?
            (compiler_optimize.compiler-opt-global-shared-view
              thread-wide-blocks)))
        (return 75))
      ;; Fuel: at the production round cap the pass reaches a fixpoint -- a
      ;; second run over its own output finds nothing left to thread, for the
      ;; multi-round wide merge and for both widened shapes.
      (unless
        (and
          (not thread-wide-settled?)
          (not thread-multi-phi-settled?)
          (not thread-compare-settled?))
        (return 76))
      42)))

(define (compiler-optimize-fixed-point-self-test) : i64
  (let
    [func : compiler_ir_types.CompilerIrFunction
      (opt-test-function (opt-fixed-point-instrs))]
    [once : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function-once
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view func))]
    [fixed : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        func)]
    [once-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-function-first-instrs once)]
    [fixed-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-function-first-instrs fixed)]
    [optimized-program : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (opt-test-program (opt-fixed-point-instrs))
        3)]
    [again-program : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (compiler_optimize.compiler-opt-global-shared-view optimized-program)
        3)]
    (cond
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count once-instrs) 4))
        1]
      [(not (= (opt-count-arith-instr-seq once-instrs) 3)) 2]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count fixed-instrs) 3))
        3]
      [(not (= (opt-count-arith-instr-seq fixed-instrs) 2)) 4]
      [(not
          (compiler_optimize.opt-program-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            optimized-program
            again-program))
        5]
      [else 42])))

;; --- implicit scratch-region self-tests -------------------------------------
(define (opt-scratch-test-alloc) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    1
    cbi.compiler-builtin-id-tl-alloc
    (compiler_ir_types.CompilerIrCallArgs.One
      (compiler_ir_types.CompilerIrValue.I64 32))
    (compiler_ast_types.AstType.U64)))

(define (opt-scratch-test-ir-alloc) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Alloc 1 (compiler_ast_types.AstType.I64)))

(define (opt-scratch-test-return-zero) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Return
    (compiler_ir_types.CompilerIrMaybeValue.Some
      (compiler_ir_types.CompilerIrValue.I64 0))))

(define (opt-scratch-test-one-block
  [middle : compiler_ir_types.CompilerIrInstr]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-test-alloc)
    middle
    (opt-scratch-test-return-zero)))

(define (opt-scratch-positive-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-test-alloc)
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.U64))
    (opt-scratch-test-return-zero)))

(define (opt-scratch-loop-candidate-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (opt-scratch-test-alloc)
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs (opt-scratch-test-return-zero)))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-scratch-loop-list-has-candidate?
  [loops : compiler_optimize.OptNaturalLoopList]) : bool
  (match loops
    [(compiler_optimize.OptNaturalLoopList.Nil) false]
    [(compiler_optimize.OptNaturalLoopList.Cons loop rest)
      (or
        (compiler_optimize.opt-scratch-report-candidate?
          (compiler_optimize.opt-scratch-scope-report-blocks
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-natural-loop-body-blocks loop))
          1
          32)
        (opt-scratch-loop-list-has-candidate?
          (compiler_ir_types.compiler-ir-box-shared-view rest)))]))

(define (opt-scratch-reset-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "scratch_reset_test")
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    10
    blocks))

(define (opt-scratch-reset-header-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ir_types.compiler-ir-label "body")
      (compiler_ir_types.compiler-ir-label "exit"))))

(define (opt-scratch-reset-body-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-test-ir-alloc)
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "loop"))))

(define (opt-scratch-reset-unknown-alloc) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    1
    cbi.compiler-builtin-id-tl-alloc
    (compiler_ir_types.CompilerIrCallArgs.One
      (compiler_ir_types.CompilerIrValue.Var 0))
    (compiler_ast_types.AstType.U64)))

(define (opt-scratch-reset-unknown-body-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (opt-scratch-reset-unknown-alloc)
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "loop"))))

(define (opt-scratch-reset-blocks-with-body
  [body-instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "preheader"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "preheader")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-scratch-reset-header-instrs))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            body-instrs)
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs (opt-scratch-test-return-zero)))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-scratch-reset-positive-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-scratch-reset-blocks-with-body (opt-scratch-reset-body-instrs)))

(define (opt-scratch-reset-level-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-scratch-reset-blocks-with-body (opt-scratch-reset-unknown-body-instrs)))

(define (opt-scratch-reset-level-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "main")
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-seq-empty))
    (compiler_ast_types.AstType.I64)
    10
    (opt-scratch-reset-level-blocks)))

(define (opt-scratch-reset-level-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-scratch-reset-level-function)
      (compiler_ir_types.compiler-ir-function-seq-empty))
    (compiler_ir_types.compiler-ir-extern-seq-empty)))

(define (opt-scratch-reset-call-blocked-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-scratch-reset-blocks-with-body
    (opt-test-instrs
      (opt-scratch-test-ir-alloc)
      (compiler_ir_types.CompilerIrInstr.Call
        2
        (opt-test-symbol "touch")
        (compiler_ir_types.CompilerIrCallArgs.Nil)
        (compiler_ast_types.AstType.Unit))
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "loop")))))

(define (opt-scratch-reset-header-alloc-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "preheader"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "preheader")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-test-instrs-with-tail
            (opt-scratch-reset-header-instrs)
            (opt-scratch-test-ir-alloc)))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "loop"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs (opt-scratch-test-return-zero)))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-scratch-reset-early-exit-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "preheader"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "preheader")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-scratch-reset-header-instrs))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-test-instrs
              (opt-scratch-test-ir-alloc)
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Bool true)
                (compiler_ir_types.compiler-ir-label "ret")
                (compiler_ir_types.compiler-ir-label "latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "latch")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "loop"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "ret")
                (opt-test-instrs (opt-scratch-test-return-zero)))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "exit")
                  (opt-test-instrs (opt-scratch-test-return-zero)))
                compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-scratch-reset-rewrite
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-scratch-reset-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-scratch-reset-test-function
      (compiler_ir_types.compiler-ir-global-shared-view blocks))))

(define (opt-scratch-reset-call-count
  [func : compiler_ir_types.CompilerIrFunction]
  [name : String]) : i64
  (opt-count-direct-call-name-blocks
    (compiler_optimize.opt-function-blocks
      (compiler_optimize.compiler-opt-global-shared-view func))
    name))

(define (opt-scratch-reset-level-program-call-count
  [level : i64]
  [name : String]) : i64
  (match (compiler_optimize.optimize-program-with-level
    (opt-scratch-reset-level-program)
    level)
    [(compiler_ir_types.CompilerIrProgram.Program _ functions _)
      (match (compiler_optimize.opt-function-seq-find
        (compiler_optimize.compiler-opt-global-shared-view functions)
        "main")
        [(compiler_optimize.OptMaybeFunction.No) (- 0 1)]
        [(compiler_optimize.OptMaybeFunction.Some func)
          (opt-scratch-reset-call-count func name)])]))

(define (opt-scratch-reset-emitted?
  [func : compiler_ir_types.CompilerIrFunction]) : bool
  (and
    (=
      (opt-scratch-reset-call-count
        (compiler_optimize.compiler-opt-global-shared-view func)
        "tl_region_mark")
      1)
    (= (opt-scratch-reset-call-count func "tl_region_reset") 1)))

(define (opt-scratch-reset-not-emitted?
  [func : compiler_ir_types.CompilerIrFunction]) : bool
  (and
    (=
      (opt-scratch-reset-call-count
        (compiler_optimize.compiler-opt-global-shared-view func)
        "tl_region_mark")
      0)
    (= (opt-scratch-reset-call-count func "tl_region_reset") 0)))

(define (opt-scratch-reset-runtime-ids-canonical?) : bool
  (match (compiler_optimize.opt-scratch-reset-mark-instr 10)
    [(compiler_ir_types.CompilerIrInstr.Call _ mark-id _ _)
      (match (compiler_optimize.opt-scratch-reset-reset-instr 11 10)
        [(compiler_ir_types.CompilerIrInstr.Call _ reset-id _ _)
          (and
            (= mark-id cbi.compiler-builtin-id-tl-region-mark)
            (= reset-id cbi.compiler-builtin-id-tl-region-reset))]
        [_ false])]
    [_ false]))

(define (compiler-optimize-scratch-region-self-test) : i64
  (begin
    (cbi.compiler-builtin-initialize-for-parse!)
    (let
      [positive : compiler_optimize.OptScratchScopeReport
        (compiler_optimize.opt-scratch-scope-report-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-scratch-positive-instrs))]
      [loop-positive : bool
        (opt-scratch-loop-list-has-candidate?
          (compiler_optimize.opt-cfg-natural-loops
            (opt-scratch-loop-candidate-blocks)))]
      [call-blocked : compiler_optimize.OptScratchScopeReport
        (compiler_optimize.opt-scratch-scope-report-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-scratch-test-one-block
            (compiler_ir_types.CompilerIrInstr.Call
              9
              (opt-test-symbol "touch")
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.Unit))))]
      [extern-blocked : compiler_optimize.OptScratchScopeReport
        (compiler_optimize.opt-scratch-scope-report-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-scratch-test-one-block
            (compiler_ir_types.CompilerIrInstr.CallIndirectC
              9
              (compiler_ir_types.CompilerIrValue.Function
                (opt-test-symbol "ffi_touch"))
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.I64))))]
      [raw-blocked : compiler_optimize.OptScratchScopeReport
        (compiler_optimize.opt-scratch-scope-report-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-scratch-test-one-block
            (compiler_ir_types.CompilerIrInstr.AddrOf 2 1)))]
      ;; The scratch analysis records its roots with `opt-alias-mark-unique`, so
      ;; the fixture builds the fact the same way instead of hand-encoding it.
      [store-blocked : compiler_optimize.OptScratchScopeReport
        (let
          [roots : compiler_optimize.OptScratchRootList
            (compiler_optimize.opt-scratch-root-list-add
              (compiler_optimize.opt-scratch-root-list-new)
              1)]
          (compiler_optimize.OptScratchScopeReport.Report
            1
            32
            (compiler_optimize.opt-scratch-blocker-reason
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              roots
              (compiler_optimize.opt-alias-mark-unique
                (compiler_optimize.opt-alias-empty)
                1
                0)
              (compiler_ir_types.CompilerIrInstr.StorePtr
                (compiler_ir_types.CompilerIrValue.Var 99)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.U64)))))]
      [arena-blocked : compiler_optimize.OptScratchScopeReport
        (compiler_optimize.opt-scratch-scope-report-instrs
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-scratch-test-one-block
            (compiler_ir_types.CompilerIrInstr.Call
              9
              cbi.compiler-builtin-id-tl-region-mark
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.I64))))]
      [return-blocked : compiler_optimize.OptScratchScopeReport
        (let
          [roots : compiler_optimize.OptScratchRootList
            (compiler_optimize.opt-scratch-root-list-add
              (compiler_optimize.opt-scratch-root-list-new)
              1)]
          (compiler_optimize.OptScratchScopeReport.Report
            1
            32
            (compiler_optimize.opt-scratch-blocker-reason
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              roots
              (compiler_optimize.opt-alias-mark-unique
                (compiler_optimize.opt-alias-empty)
                1
                0)
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1))))))]
      [reset-positive : compiler_ir_types.CompilerIrFunction
        (opt-scratch-reset-rewrite (opt-scratch-reset-positive-blocks))]
      [reset-call-blocked : compiler_ir_types.CompilerIrFunction
        (opt-scratch-reset-rewrite (opt-scratch-reset-call-blocked-blocks))]
      [reset-header-alloc : compiler_ir_types.CompilerIrFunction
        (opt-scratch-reset-rewrite (opt-scratch-reset-header-alloc-blocks))]
      [reset-early-exit : compiler_ir_types.CompilerIrFunction
        (opt-scratch-reset-rewrite (opt-scratch-reset-early-exit-blocks))]
      [reset-pre-ssa : compiler_ir_types.CompilerIrFunction
        (match (compiler_optimize.opt-scratch-reset-pre-ssa-function-with-context-result
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-scratch-reset-level-function))
          [(compiler_optimize.OptFunctionCtxResult.Result f _) f])]
      [level0-mark-count : i64
        (opt-scratch-reset-level-program-call-count 0 "tl_region_mark")]
      [level0-reset-count : i64
        (opt-scratch-reset-level-program-call-count 0 "tl_region_reset")]
      [level1-mark-count : i64
        (opt-scratch-reset-level-program-call-count 1 "tl_region_mark")]
      [level1-reset-count : i64
        (opt-scratch-reset-level-program-call-count 1 "tl_region_reset")]
      [level2-mark-count : i64
        (opt-scratch-reset-level-program-call-count 2 "tl_region_mark")]
      [level2-reset-count : i64
        (opt-scratch-reset-level-program-call-count 2 "tl_region_reset")]
      (cond
        [(not (compiler_optimize.opt-scratch-report-candidate? positive 1 32))
          1]
        [(not loop-positive) 2]
        [(not
            (compiler_optimize.opt-scratch-report-blocked?
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              call-blocked
              1
              32
              "call"))
          3]
        [(not
            (compiler_optimize.opt-scratch-report-blocked?
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              extern-blocked
              1
              32
              "extern_call"))
          4]
        [(not
            (compiler_optimize.opt-scratch-report-blocked?
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              raw-blocked
              1
              32
              "raw_pointer"))
          5]
        [(not
            (compiler_optimize.opt-scratch-report-blocked?
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              store-blocked
              1
              32
              "store_outer"))
          6]
        [(not
            (compiler_optimize.opt-scratch-report-blocked?
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              arena-blocked
              1
              32
              "arena_helper"))
          7]
        [(not
            (compiler_optimize.opt-scratch-report-blocked?
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              return-blocked
              1
              32
              "return_escape"))
          8]
        [(not
            (opt-scratch-reset-emitted?
              (compiler_optimize.compiler-opt-global-shared-view reset-positive)))
          9]
        [(not
            (=
              (compiler_optimize.opt-function-frame
                (compiler_optimize.compiler-opt-global-shared-view
                  reset-positive))
              12))
          10]
        [(not (opt-scratch-reset-not-emitted? reset-call-blocked)) 11]
        [(not (opt-scratch-reset-not-emitted? reset-header-alloc)) 12]
        [(not (opt-scratch-reset-not-emitted? reset-early-exit)) 13]
        [(not (opt-scratch-reset-emitted? reset-pre-ssa)) 14]
        [(not (= level0-mark-count 0)) 15]
        [(not (= level0-reset-count 0)) 16]
        [(not (= level1-mark-count 0)) 17]
        [(not (= level1-reset-count 0)) 18]
        [(not (= level2-mark-count 1)) 19]
        [(not (= level2-reset-count 1)) 20]
        [(not (opt-scratch-reset-runtime-ids-canonical?)) 21]
        [else 42]))))

;; --- noalias fact model self-test -------------------------------------------
(define (opt-alias-test-unique-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 8)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))))

(define (opt-alias-test-transitive-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 8)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 8)
      (compiler_ast_types.AstType.I64))))

(define (opt-alias-test-load-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))))

(define (opt-alias-test-store-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 5)
      (compiler_ast_types.AstType.I64))))

(define (opt-alias-test-call-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      9
      (opt-test-symbol "tl_noop")
      (compiler_ir_types.CompilerIrCallArgs.Nil)
      (compiler_ast_types.AstType.I64))))

(define (opt-alias-test-copy-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      2
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.I64))))

(define (opt-alias-join-facts-a) : compiler_optimize.OptAliasFacts
  (compiler_optimize.opt-alias-bind
    (compiler_optimize.opt-alias-bind
      (compiler_optimize.opt-alias-bind
        (compiler_optimize.opt-alias-empty)
        0
        (compiler_optimize.OptAliasKind.Unique 0))
      1
      (compiler_optimize.OptAliasKind.Derived 0))
    2
    (compiler_optimize.OptAliasKind.MayAlias)))

(define (opt-alias-join-facts-b) : compiler_optimize.OptAliasFacts
  (compiler_optimize.opt-alias-bind
    (compiler_optimize.opt-alias-bind
      (compiler_optimize.opt-alias-bind
        (compiler_optimize.opt-alias-empty)
        0
        (compiler_optimize.OptAliasKind.Unique 0))
      1
      (compiler_optimize.OptAliasKind.MayAlias))
    3
    (compiler_optimize.OptAliasKind.Unique 0)))

(define (opt-alias-sample-store) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.StorePtr
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.CompilerIrValue.I64 5)
    (compiler_ast_types.AstType.I64)))

(define (opt-alias-sample-tail-call) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.TailCall
    (opt-test-symbol "tl_noop")
    (compiler_ir_types.CompilerIrCallArgs.Nil)
    (compiler_ast_types.AstType.I64)))

(define (opt-alias-sample-binop) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    9
    (compiler_ir_types.CompilerIrBinOp.Add)
    (compiler_ir_types.CompilerIrValue.I64 1)
    (compiler_ir_types.CompilerIrValue.I64 2)
    (compiler_ast_types.AstType.I64)))

(define (compiler-optimize-alias-self-test) : i64
  (let
    [unique : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-run
        (compiler_optimize.opt-alias-empty)
        (opt-alias-test-unique-instrs))]
    [transitive : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-run
        (compiler_optimize.opt-alias-empty)
        (opt-alias-test-transitive-instrs))]
    [loaded : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-run
        (compiler_optimize.opt-alias-empty)
        (opt-alias-test-load-instrs))]
    [stored : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-run
        (compiler_optimize.opt-alias-empty)
        (opt-alias-test-store-instrs))]
    [called : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-run
        (compiler_optimize.opt-alias-empty)
        (opt-alias-test-call-instrs))]
    [copied : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-run
        (compiler_optimize.opt-alias-empty)
        (opt-alias-test-copy-instrs))]
    [joined : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-intersect
        (opt-alias-join-facts-a)
        (opt-alias-join-facts-b))]
    [invalidated : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-mark-invalidated
        (compiler_optimize.opt-alias-mark-unique
          (compiler_optimize.opt-alias-empty)
          0
          0)
        0)]
    [seeded : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-seed-params
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-load-cse-mixed-ref-params))]
    (cond
      [(not
          (compiler_optimize.opt-alias-contains?
            (compiler_optimize.compiler-opt-global-shared-view unique)
            0
            (compiler_optimize.OptAliasKind.Unique 0)))
        1]
      [(not
          (compiler_optimize.opt-alias-contains?
            (compiler_optimize.compiler-opt-global-shared-view unique)
            1
            (compiler_optimize.OptAliasKind.Derived 0)))
        2]
      [(not
          (compiler_optimize.opt-alias-absent?
            (compiler_optimize.compiler-opt-global-shared-view unique)
            2))
        3]
      [(not (= (compiler_optimize.opt-alias-facts-len unique) 2)) 4]
      [(not
          (compiler_optimize.opt-alias-contains?
            transitive
            2
            (compiler_optimize.OptAliasKind.Derived 0)))
        5]
      [(not
          (compiler_optimize.opt-alias-contains?
            (compiler_optimize.compiler-opt-global-shared-view loaded)
            0
            (compiler_optimize.OptAliasKind.Unique 0)))
        6]
      [(not
          (compiler_optimize.opt-alias-contains?
            loaded
            1
            (compiler_optimize.OptAliasKind.MayAlias)))
        7]
      [(not (= (compiler_optimize.opt-alias-facts-len stored) 0)) 8]
      [(not
          (compiler_optimize.opt-alias-instr-clears-all?
            (opt-alias-sample-store)))
        9]
      [(not (= (compiler_optimize.opt-alias-facts-len called) 0)) 10]
      [(not
          (compiler_optimize.opt-alias-instr-clears-all?
            (opt-alias-sample-tail-call)))
        11]
      [(not
          (compiler_optimize.opt-alias-contains?
            (compiler_optimize.compiler-opt-global-shared-view copied)
            1
            (compiler_optimize.OptAliasKind.Derived 0)))
        12]
      [(not
          (compiler_optimize.opt-alias-contains?
            copied
            2
            (compiler_optimize.OptAliasKind.MayAlias)))
        13]
      [(not
          (=
            (compiler_optimize.opt-alias-facts-len
              (compiler_optimize.compiler-opt-global-shared-view joined))
            1))
        14]
      [(not
          (compiler_optimize.opt-alias-contains?
            (compiler_optimize.compiler-opt-global-shared-view joined)
            0
            (compiler_optimize.OptAliasKind.Unique 0)))
        15]
      [(compiler_optimize.opt-alias-contains?
          joined
          1
          (compiler_optimize.OptAliasKind.Derived 0))
        16]
      [(compiler_optimize.opt-alias-instr-clears-all? (opt-alias-sample-binop))
        17]
      [(not
          (compiler_optimize.opt-alias-contains?
            invalidated
            0
            (compiler_optimize.OptAliasKind.Invalidated)))
        18]
      [(not
          (compiler_optimize.opt-alias-contains?
            (compiler_optimize.compiler-opt-global-shared-view seeded)
            0
            (compiler_optimize.OptAliasKind.SharedRef)))
        19]
      [(not
          (compiler_optimize.opt-alias-contains?
            seeded
            1
            (compiler_optimize.OptAliasKind.ExclusiveRef)))
        20]
      ;; Allocation epochs survive the packed encoding, distinguish otherwise
      ;; identical Unique roots, and the retired -1 code stays conservative.
      [(not
          (compiler_optimize.opt-alias-kind-eq
            (compiler_optimize.opt-alias-kind-decode
              (compiler_optimize.opt-alias-kind-encode
                (compiler_optimize.OptAliasKind.Unique 7)))
            (compiler_optimize.OptAliasKind.Unique 7)))
        21]
      [(compiler_optimize.opt-alias-kind-eq
          (compiler_optimize.OptAliasKind.Unique 0)
          (compiler_optimize.OptAliasKind.Unique 1))
        22]
      [(not
          (compiler_optimize.opt-alias-kind-eq
            (compiler_optimize.opt-alias-kind-decode -1)
            (compiler_optimize.OptAliasKind.Invalidated)))
        23]
      [else 42])))

(define (opt-load-cse-run [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (compiler_optimize.opt-load-cse-instrs
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-load-header-set-empty)
    (compiler_optimize.opt-load-cse-empty-state-for-size
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (compiler_ir_types.compiler-ir-instr-seq-count
        (compiler_optimize.compiler-opt-global-shared-view instrs)))
    instrs))

;; Run with header-typed handle params (vars 0 and 1 are (__tl_dyn-array i64)
;; descriptors) so the descriptor/element granularity rules can be exercised.
(define (opt-load-cse-run-with-array-param
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (compiler_optimize.opt-load-cse-instrs
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-load-header-set-from-function
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "xs"
          (compiler_ast_types.AstType.DynArray 0)
          0)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "ys"
            (compiler_ast_types.AstType.DynArray 0)
            1)
          (compiler_ir_types.compiler-ir-param-seq-empty)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_optimize.compiler-opt-global-shared-view instrs))
        (compiler_ir_types.CompilerIrBlockList.Nil)))
    (compiler_optimize.opt-load-cse-empty-state-for-size
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (compiler_ir_types.compiler-ir-instr-seq-count
        (compiler_optimize.compiler-opt-global-shared-view instrs)))
    instrs))

(define (opt-load-cse-run-with-params
  [params : compiler_ir_types.CompilerIrParamSeq]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (compiler_optimize.opt-load-cse-instrs
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-load-header-set-from-function
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.compiler-opt-global-shared-view params)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_optimize.compiler-opt-global-shared-view instrs))
        (compiler_ir_types.CompilerIrBlockList.Nil)))
    (compiler_optimize.opt-load-cse-state-with-caps-and-facts
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))
      (compiler_optimize.opt-load-cse-table-cap-for-size
        (compiler_ir_types.compiler-ir-instr-seq-count
          (compiler_optimize.compiler-opt-global-shared-view instrs)))
      (compiler_optimize.opt-load-cse-kinds-cap-for-size
        (compiler_ir_types.compiler-ir-instr-seq-count
          (compiler_optimize.compiler-opt-global-shared-view instrs)))
      (compiler_optimize.opt-alias-seed-params
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view params)))
    instrs))

;; Drive the fused block-local load/copy traversal used by optimize-block. This
;; also exercises the native-Slice Word facts that intentionally do not belong
;; to the standalone load-CSE helper above.
(define (opt-load-copy-run-with-params
  [params : compiler_ir_types.CompilerIrParamSeq]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [type-segment-bases : i64
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_optimize.compiler-opt-global-shared-view instrs))
        (compiler_ir_types.CompilerIrBlockList.Nil))]
    [hs : compiler_optimize.OptLoadHeaderSet
      (compiler_optimize.opt-load-header-set-from-function
        type-segment-bases
        (compiler_optimize.compiler-opt-global-shared-view params)
        blocks)]
    [seq : compiler_ir_types.CompilerIrInstrSeq instrs]
    (begin
      (compiler_optimize.opt-load-copy-instr-seq-rewrite!
        type-segment-bases
        hs
        (compiler_optimize.opt-load-cse-state-with-caps-and-facts
          (profile_state.compiler-profile-state-metrics
            (profile_state.compiler-profile-state-new))
          (compiler_optimize.opt-load-cse-table-cap-for-size
            (compiler_ir_types.compiler-ir-instr-seq-count
              (compiler_optimize.compiler-opt-global-shared-view seq)))
          (compiler_optimize.opt-load-cse-kinds-cap-for-size
