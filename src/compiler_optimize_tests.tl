;; A bool merge whose consuming branch sits past the merge block: `merge` holds
;; the phi and falls through to `gap`, `gap` falls through to `branch-site`, and
;; only `branch-site` tests the phi. That is what the front end emits whenever a
;; boolean merge and the `if` reading it land on separate joins, and the fuser
;; has to look through the run to see the same rewrite. Modes:
;;   0 -- `gap` is a pure fallthrough owned by the merge: fusible.
;;   1 -- `gap` carries a real instruction, so the run cannot simply die.
;;   2 -- `side` also reaches `gap`, so the run is not the merge's to retarget.
(define (opt-bool-branch-merge-chain-gap-instrs [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [tail : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "branch-site")))]
    (if (= mode 1)
      (opt-test-instrs-with-tail
        tail
        (compiler_ir_types.CompilerIrInstr.Mov
          7
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64)))
      tail)))

(define (opt-bool-branch-merge-chain-tail [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "true-left")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "merge"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "false-middle")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "true-right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "merge"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "merge")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Bool true)
                  (compiler_ir_types.compiler-ir-label "true-left")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Bool false)
                    (compiler_ir_types.compiler-ir-label "false-middle")
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "true-right")
                      (compiler_ir_types.compiler-ir-phi-input-seq-empty))))
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "gap"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "gap")
              (opt-bool-branch-merge-chain-gap-instrs mode))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "branch-site")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "yes")
                    (compiler_ir_types.compiler-ir-label "no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      5
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 11)
                        (compiler_ir_types.compiler-ir-label "branch-site")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 5)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        6
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.I64 22)
                          (compiler_ir_types.compiler-ir-label "branch-site")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 6)))))
                  (if (= mode 2)
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "side")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Jump
                            (compiler_ir_types.compiler-ir-label "gap"))))
                      (compiler_ir_types.CompilerIrBlockList.Nil))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

(define (opt-bool-branch-merge-chain-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (if (= mode 2)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "spread")
            (compiler_ir_types.compiler-ir-label "choose"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "spread")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "true-left")
              (compiler_ir_types.compiler-ir-label "side"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "choose")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.compiler-ir-label "false-middle")
                (compiler_ir_types.compiler-ir-label "true-right"))))
          (opt-bool-branch-merge-chain-tail mode))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "true-left")
            (compiler_ir_types.compiler-ir-label "choose"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "choose")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "false-middle")
              (compiler_ir_types.compiler-ir-label "true-right"))))
        (opt-bool-branch-merge-chain-tail mode)))))

(define (opt-bool-branch-constant-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bool-branch-constant")
    (opt-bool-branch-two-cond-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

;; The chain shape of `opt-bool-branch-merge-chain-blocks 0` reached through a
;; block whose branch sccp folds. `entry` tests a var sccp proves `true`, so the
;; edge `entry -> join` dies and `join`'s phi keeps an input for a label that is
;; no longer one of its predecessors. Every pass that verify-gates its input --
;; the bool-branch fuser included -- then declines the WHOLE function, and the
;; fusible chain further down survives untouched. The pipeline's sccp entry
;; point has to hand on blocks that verify for this fixture to fuse.
(define (opt-sccp-folded-edge-chain-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          10
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ir_types.compiler-ir-label "pick")
          (compiler_ir_types.compiler-ir-label "join"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "pick")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "true-left")
            (compiler_ir_types.compiler-ir-label "choose"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "choose")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "false-middle")
              (compiler_ir_types.compiler-ir-label "true-right"))))
        (opt-sccp-folded-edge-chain-tail)))))

(define (opt-sccp-folded-edge-chain-tail) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "true-left")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "merge"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "false-middle")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "true-right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "merge"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "merge")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Bool true)
                  (compiler_ir_types.compiler-ir-label "true-left")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Bool false)
                    (compiler_ir_types.compiler-ir-label "false-middle")
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "true-right")
                      (compiler_ir_types.compiler-ir-phi-input-seq-empty))))
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "gap"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "gap")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "branch-site"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "branch-site")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "yes")
                    (compiler_ir_types.compiler-ir-label "no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      5
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 11)
                        (compiler_ir_types.compiler-ir-label "branch-site")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "join"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        6
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.I64 22)
                          (compiler_ir_types.compiler-ir-label "branch-site")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "join"))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "join")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Phi
                          7
                          (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                            (compiler_ir_types.CompilerIrValue.I64 0)
                            (compiler_ir_types.compiler-ir-label "entry")
                            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                              (compiler_ir_types.CompilerIrValue.Var 5)
                              (compiler_ir_types.compiler-ir-label "yes")
                              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                (compiler_ir_types.CompilerIrValue.Var 6)
                                (compiler_ir_types.compiler-ir-label "no")
                                (compiler_ir_types.compiler-ir-phi-input-seq-empty))))
                          (compiler_ast_types.AstType.I64))
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.Var 7)))))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

(define (opt-bool-branch-first-phi-has-label?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks block-label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (and
            (>
              (compiler_ir_types.compiler-ir-instr-seq-count
                (compiler_ir_types.compiler-ir-global-shared-view instrs))
              0)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref
              (compiler_ir_types.compiler-ir-global-shared-view instrs)
              0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (compiler_optimize.opt-bool-branch-phi-input-has-label?
                  inputs
                  pred-label)]
              [_ false]))])]))

(define (opt-bool-branch-chain-test-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "a"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "b"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "c"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

;; mode 0: a three-comparison And tree; mode 1: its first And result also
;; escapes to a Mov and must block the rewrite; mode 2: an Or-mixed tree, which
;; is outside the first-cut transform.
(define (opt-bool-branch-chain-test-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [first-op : compiler_ir_types.CompilerIrBinOp
      (if (= mode 2)
        (compiler_ir_types.CompilerIrBinOp.Or)
        (compiler_ir_types.CompilerIrBinOp.And))]
    [after-first : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (if (= mode 1)
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              8
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.Bool)))
          (compiler_ir_types.compiler-ir-instr-seq-empty))
        (compiler_ir_types.CompilerIrInstr.BinOp
          6
          first-op
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ast_types.AstType.Bool)))]
    [entry-tail : compiler_ir_types.CompilerIrInstrSeq
      (compiler_optimize.opt-licm-unswitch-instrs-onto
        after-first
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            7
            (compiler_ir_types.CompilerIrBinOp.And)
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no"))))]
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs-with-tail
          entry-tail
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Ge)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Le)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "yes")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              9
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.I64 11)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 9)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "no")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                10
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.I64 22)
                  (compiler_ir_types.compiler-ir-label "entry")
                  (compiler_ir_types.compiler-ir-phi-input-seq-empty))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 10)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-bool-branch-chain-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bool-branch-chain")
    (opt-bool-branch-chain-test-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-bool-branch-chain-test-run [mode : i64]) : compiler_optimize.OptFunctionPassResult
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-bool-branch-chain-test-blocks mode)]
    [func : compiler_ir_types.CompilerIrFunction
      (opt-bool-branch-chain-test-function
        (compiler_ir_types.compiler-ir-global-shared-view blocks))]
    (compiler_optimize.opt-bool-branch-chain-function-with-context-result
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      func)))

(define (opt-bool-branch-chain-compare-branch-block?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (and
            (=
              (compiler_ir_types.compiler-ir-instr-seq-count
                (compiler_ir_types.compiler-ir-global-shared-view instrs))
              2)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref
              (compiler_ir_types.compiler-ir-global-shared-view instrs)
              0)
              [(compiler_ir_types.CompilerIrInstr.BinOp dst op _ _ _)
                (and
                  (compiler_optimize.opt-bool-branch-compare-op? op)
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref
                    (compiler_ir_types.compiler-ir-global-shared-view instrs)
                    1)
                    [(compiler_ir_types.CompilerIrInstr.Branch
                        (compiler_ir_types.CompilerIrValue.Var cond)
                        _
                        _)
                      (= dst cond)]
                    [_ false]))]
              [_ false]))])]))

;; --- constant-branch jump threading fixtures --------------------------------
;;
;; The shape below is the lowered `(or c1 c2)` loop guard, copied from the opt2
;; IR dump of route_http's byte-scan loop: an inner diamond materializes a
;; boolean into a phi, a forwarding block carries it to the outer merge, and the
;; outer merge retests it. Both merge phis are pure control flow, so every
;; incoming edge already decides the branch.
;;
;; The fixtures drive the whole opt2 function pipeline (`optimize-function`)
;; rather than the pass entry point, so a tree carrying only these tests still
;; compiles and reports the new codes.
(define (opt-thread-three-cond-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "outer"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "left"
        (compiler_ast_types.AstType.Bool)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "right"
          (compiler_ast_types.AstType.Bool)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

;; `blocked` inserts an effectful call between the merge phi and its branch, so
;; the merge no longer consists of phis and the branch alone.
(define (opt-thread-chain-blocks [blocked : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tc-then")
          (compiler_ir_types.compiler-ir-label "tc-else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tc-then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "tc-merge"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tc-else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tc-inner-then")
              (compiler_ir_types.compiler-ir-label "tc-inner-else"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tc-inner-then")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tc-inner-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tc-inner-else")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tc-inner-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tc-inner-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    3
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tc-inner-then")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "tc-inner-else")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "tc-merge"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tc-merge")
                  (opt-test-instrs-with-tail
                    (if blocked
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Call
                          5
                          (opt-test-symbol "thread-probe")
                          (compiler_ir_types.CompilerIrCallArgs.Nil)
                          (compiler_ast_types.AstType.I64))
                        (compiler_ir_types.CompilerIrInstr.Branch
                          (compiler_ir_types.CompilerIrValue.Var 4)
                          (compiler_ir_types.compiler-ir-label "tc-yes")
                          (compiler_ir_types.compiler-ir-label "tc-no")))
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Branch
                          (compiler_ir_types.CompilerIrValue.Var 4)
                          (compiler_ir_types.compiler-ir-label "tc-yes")
                          (compiler_ir_types.compiler-ir-label "tc-no"))))
                    (compiler_ir_types.CompilerIrInstr.Phi
                      4
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Bool true)
                        (compiler_ir_types.compiler-ir-label "tc-then")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.Var 3)
                          (compiler_ir_types.compiler-ir-label "tc-inner-merge")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                      (compiler_ast_types.AstType.Bool))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tc-yes")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.I64 1)))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "tc-no")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.I64 0)))))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

;; Same chain, but both decided targets are reached from a second path as well,
;; so `ts-yes` carries a real multi-input phi over the threaded merge edge.
(define (opt-thread-successor-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "ts-alt")
          (compiler_ir_types.compiler-ir-label "ts-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "ts-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "ts-yes"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "ts-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "ts-then")
              (compiler_ir_types.compiler-ir-label "ts-else"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "ts-then")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "ts-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "ts-else")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.compiler-ir-label "ts-inner-then")
                  (compiler_ir_types.compiler-ir-label "ts-inner-else"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "ts-inner-then")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "ts-inner-merge"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "ts-inner-else")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "ts-inner-merge"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "ts-inner-merge")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        4
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.Bool true)
                          (compiler_ir_types.compiler-ir-label "ts-inner-then")
                          (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                            (compiler_ir_types.CompilerIrValue.Bool false)
                            (compiler_ir_types.compiler-ir-label
                              "ts-inner-else")
                            (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                        (compiler_ast_types.AstType.Bool))
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "ts-merge"))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "ts-merge")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Phi
                          5
                          (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                            (compiler_ir_types.CompilerIrValue.Bool true)
                            (compiler_ir_types.compiler-ir-label "ts-then")
                            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                              (compiler_ir_types.CompilerIrValue.Var 4)
                              (compiler_ir_types.compiler-ir-label
                                "ts-inner-merge")
                              (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                          (compiler_ast_types.AstType.Bool))
                        (compiler_ir_types.CompilerIrInstr.Branch
                          (compiler_ir_types.CompilerIrValue.Var 5)
                          (compiler_ir_types.compiler-ir-label "ts-yes")
                          (compiler_ir_types.compiler-ir-label "ts-no"))))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "ts-yes")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Phi
                            6
                            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                              (compiler_ir_types.CompilerIrValue.I64 10)
                              (compiler_ir_types.compiler-ir-label "ts-merge")
                              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                (compiler_ir_types.CompilerIrValue.I64 20)
                                (compiler_ir_types.compiler-ir-label "ts-alt")
                                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                            (compiler_ast_types.AstType.I64))
                          (compiler_ir_types.CompilerIrInstr.Return
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              (compiler_ir_types.CompilerIrValue.Var 6)))))
                      (compiler_ir_types.compiler-ir-block-cons
                        (compiler_ir_types.CompilerIrBlock.Block
                          (compiler_ir_types.compiler-ir-label "ts-no")
                          (opt-test-instrs
                            (compiler_ir_types.CompilerIrInstr.Return
                              (compiler_ir_types.CompilerIrMaybeValue.Some
                                (compiler_ir_types.CompilerIrValue.I64 30)))))
                        (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))))

(define (opt-thread-test-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol name)
    (opt-thread-three-cond-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-thread-optimized
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.optimize-function
    (compiler_ast_types.ast-node-pool-reader-context-current)
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-thread-test-function name blocks)))

;; --- widened jump-threading fixtures ----------------------------------------
;;
;; These drive `opt-thread-const-branch-blocks` directly rather than the whole
;; opt2 pipeline, so what they assert is the pass's own rewrite: which edges it
;; redirects, which value each redirected predecessor takes over, and which
;; shapes it still refuses.
(define (opt-thread-pass-result
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fuel : i64]) : compiler_optimize.OptBlockListPassResult
  (compiler_optimize.opt-thread-const-branch-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    blocks
    16
    fuel))

(define (opt-thread-pass-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fuel : i64]) : compiler_ir_types.CompilerIrBlockList
  (match (opt-thread-pass-result blocks fuel)
    [(compiler_optimize.OptBlockListPassResult.Result next _) next]))

(define (opt-thread-pass-changed?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [fuel : i64]) : bool
  (match (opt-thread-pass-result blocks fuel)
    [(compiler_optimize.OptBlockListPassResult.Result _ changed) changed]))

(define (opt-thread-pass-verified?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (compiler_optimize.opt-verify-ok?
    (compiler_optimize.opt-verify-function
      (opt-thread-test-function "thread-pass" blocks))))

(define (opt-thread-first-phi-input
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]) : compiler_ir_types.CompilerIrMaybeValue
  (match (compiler_optimize.opt-cfg-find-block blocks block-label)
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.CompilerIrMaybeValue.No)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            (compiler_ir_types.CompilerIrMaybeValue.No)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (compiler_optimize.opt-thread-phi-input-value inputs pred-label)]
              [_ (compiler_ir_types.CompilerIrMaybeValue.No)]))])]))

(define (opt-thread-first-phi-input-i64?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]
  [want : i64]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(compiler_ir_types.CompilerIrMaybeValue.No) false]
    [(compiler_ir_types.CompilerIrMaybeValue.Some value)
      (match value
        [(compiler_ir_types.CompilerIrValue.I64 got) (= got want)]
        [_ false])]))

(define (opt-thread-first-phi-input-bool?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]
  [want : bool]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(compiler_ir_types.CompilerIrMaybeValue.No) false]
    [(compiler_ir_types.CompilerIrMaybeValue.Some value)
      (match value
        [(compiler_ir_types.CompilerIrValue.Bool got)
          (if want
            got
            (not got))]
        [_ false])]))

(define (opt-thread-first-phi-has-input?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block-label : i64]
  [pred-label : i64]) : bool
  (match (opt-thread-first-phi-input blocks block-label pred-label)
    [(compiler_ir_types.CompilerIrMaybeValue.No) false]
    [(compiler_ir_types.CompilerIrMaybeValue.Some _) true]))

;; D1 -- three phis ahead of the branch. Only `%6` decides it; `%4` and `%5`
;; are read solely across the merge's own out-edges, so each redirected
;; predecessor takes over the value its own input carried and the merge's phis
;; lose that input. `tp-alt` keeps both destinations multi-entry so the repaired
;; phis survive the round's cleanup.
(define (opt-thread-multi-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tp-alt")
          (compiler_ir_types.compiler-ir-label "tp-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tp-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "tp-yes")
            (compiler_ir_types.compiler-ir-label "tp-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tp-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tp-a")
              (compiler_ir_types.compiler-ir-label "tp-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tp-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tp-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tp-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tp-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tp-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "tp-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "tp-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.I64 11)
                      (compiler_ir_types.compiler-ir-label "tp-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 21)
                        (compiler_ir_types.compiler-ir-label "tp-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    6
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tp-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "tp-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 6)
                    (compiler_ir_types.compiler-ir-label "tp-yes")
                    (compiler_ir_types.compiler-ir-label "tp-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tp-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      7
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 4)
                        (compiler_ir_types.compiler-ir-label "tp-merge")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "tp-alt")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 7)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tp-no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        8
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.Var 5)
                          (compiler_ir_types.compiler-ir-label "tp-merge")
                          (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                            (compiler_ir_types.CompilerIrValue.I64 31)
                            (compiler_ir_types.compiler-ir-label "tp-alt")
                            (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 8)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; D1 rail -- `%4` is read by an ordinary instruction in a successor, not by a
;; phi on the merge edge. Threading a predecessor past the merge would reach
;; that read without passing the definition, so the whole block is refused.
(define (opt-thread-live-out-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tv-alt")
          (compiler_ir_types.compiler-ir-label "tv-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tv-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "tv-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tv-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tv-a")
              (compiler_ir_types.compiler-ir-label "tv-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tv-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tv-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tv-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tv-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tv-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "tv-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "tv-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tv-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "tv-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.compiler-ir-label "tv-yes")
                    (compiler_ir_types.compiler-ir-label "tv-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tv-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.BinOp
                      6
                      (compiler_ir_types.CompilerIrBinOp.Add)
                      (compiler_ir_types.CompilerIrValue.Var 4)
                      (compiler_ir_types.CompilerIrValue.I64 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 6)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tv-no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.I64 40)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; D1 -- only `tx-a` decides the branch. `tx-b` carries a parameter, so its
;; edge stays exactly where it is and the merge survives holding it.
(define (opt-thread-mixed-edge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tx-alt")
          (compiler_ir_types.compiler-ir-label "tx-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tx-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "tx-yes")
            (compiler_ir_types.compiler-ir-label "tx-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tx-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tx-a")
              (compiler_ir_types.compiler-ir-label "tx-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tx-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tx-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tx-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tx-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tx-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "tx-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "tx-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "tx-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 2)
                        (compiler_ir_types.compiler-ir-label "tx-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.compiler-ir-label "tx-yes")
                    (compiler_ir_types.compiler-ir-label "tx-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tx-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      6
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 4)
                        (compiler_ir_types.compiler-ir-label "tx-merge")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "tx-alt")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 6)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tx-no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.I64 40)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; The D2 fixtures need an `i64` parameter for the edge that must not fold, so
;; they carry their own signature.
(define (opt-thread-cmp-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "outer"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "left"
        (compiler_ast_types.AstType.Bool)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "right"
          (compiler_ast_types.AstType.Bool)
          2)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "n"
            (compiler_ast_types.AstType.I64)
            3)
          (compiler_ir_types.compiler-ir-param-seq-empty))))))

(define (opt-thread-cmp-test-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol name)
    (opt-thread-cmp-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-thread-cmp-verified?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (compiler_optimize.opt-verify-ok?
    (compiler_optimize.opt-verify-function
      (opt-thread-cmp-test-function "thread-cmp" blocks))))

;; D2 -- the branch reads a comparison over the block's own `i64` phi. `tq-a`
;; carries `5` and `tq-b` carries `-1`, so both decide the comparison and both
;; are redirected, `tq-a` to `tq-yes` carrying the `5` the successor phi asked
;; for and `tq-b` to `tq-no`. `tq-c` and `tq-d` carry a parameter and never
;; decide, so the merge survives holding exactly those two -- which is also the
;; floor `opt-thread-compare-min-preds` would have stopped at.
(define (opt-thread-compare-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tq-alt")
          (compiler_ir_types.compiler-ir-label "tq-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tq-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "tq-yes")
            (compiler_ir_types.compiler-ir-label "tq-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tq-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tq-g1")
              (compiler_ir_types.compiler-ir-label "tq-g2"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tq-g1")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "tq-a")
                (compiler_ir_types.compiler-ir-label "tq-b"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tq-g2")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.compiler-ir-label "tq-c")
                  (compiler_ir_types.compiler-ir-label "tq-d"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tq-a")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "tq-merge"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tq-b")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "tq-merge"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tq-c")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "tq-merge"))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "tq-d")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Jump
                          (compiler_ir_types.compiler-ir-label "tq-merge"))))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "tq-merge")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Phi
                            5
                            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                              (compiler_ir_types.CompilerIrValue.I64 5)
                              (compiler_ir_types.compiler-ir-label "tq-a")
                              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
                                (compiler_ir_types.compiler-ir-label "tq-b")
                                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                  (compiler_ir_types.CompilerIrValue.Var 3)
                                  (compiler_ir_types.compiler-ir-label "tq-c")
                                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                    (compiler_ir_types.CompilerIrValue.Var 3)
                                    (compiler_ir_types.compiler-ir-label "tq-d")
                                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))))
                            (compiler_ast_types.AstType.I64))
                          (compiler_ir_types.CompilerIrInstr.BinOp
                            6
                            (compiler_ir_types.CompilerIrBinOp.Ge)
                            (compiler_ir_types.CompilerIrValue.Var 5)
                            (compiler_ir_types.CompilerIrValue.I64 0)
                            (compiler_ast_types.AstType.I64))
                          (compiler_ir_types.CompilerIrInstr.Branch
                            (compiler_ir_types.CompilerIrValue.Var 6)
                            (compiler_ir_types.compiler-ir-label "tq-yes")
                            (compiler_ir_types.compiler-ir-label "tq-no"))))
                      (compiler_ir_types.compiler-ir-block-cons
                        (compiler_ir_types.CompilerIrBlock.Block
                          (compiler_ir_types.compiler-ir-label "tq-yes")
                          (opt-test-instrs
                            (compiler_ir_types.CompilerIrInstr.Phi
                              7
                              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                (compiler_ir_types.CompilerIrValue.Var 5)
                                (compiler_ir_types.compiler-ir-label "tq-merge")
                                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                  (compiler_ir_types.CompilerIrValue.I64 30)
                                  (compiler_ir_types.compiler-ir-label "tq-alt")
                                  (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                              (compiler_ast_types.AstType.I64))
                            (compiler_ir_types.CompilerIrInstr.Return
                              (compiler_ir_types.CompilerIrMaybeValue.Some
                                (compiler_ir_types.CompilerIrValue.Var 7)))))
                        (compiler_ir_types.compiler-ir-block-cons
                          (compiler_ir_types.CompilerIrBlock.Block
                            (compiler_ir_types.compiler-ir-label "tq-no")
                            (opt-test-instrs
                              (compiler_ir_types.CompilerIrInstr.Phi
                                8
                                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                  (compiler_ir_types.CompilerIrValue.I64 41)
                                  (compiler_ir_types.compiler-ir-label
                                    "tq-merge")
                                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                    (compiler_ir_types.CompilerIrValue.I64 31)
                                    (compiler_ir_types.compiler-ir-label
                                      "tq-alt")
                                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                                (compiler_ast_types.AstType.I64))
                              (compiler_ir_types.CompilerIrInstr.Return
                                (compiler_ir_types.CompilerIrMaybeValue.Some
                                  (compiler_ir_types.CompilerIrValue.Var 8)))))
                          (compiler_ir_types.CompilerIrBlockList.Nil))))))))))))))

;; D2 rail -- the same shape with an equality comparison. `tr-a` carries `5`
;; and would decide `eq %5, 5`, but only the ordering comparisons are threaded,
;; so the pass reports no change at all.
(define (opt-thread-compare-open-edge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tr-alt")
          (compiler_ir_types.compiler-ir-label "tr-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tr-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "tr-yes")
            (compiler_ir_types.compiler-ir-label "tr-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tr-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tr-a")
              (compiler_ir_types.compiler-ir-label "tr-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tr-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tr-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tr-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "tr-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tr-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    5
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.I64 5)
                      (compiler_ir_types.compiler-ir-label "tr-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 3)
                        (compiler_ir_types.compiler-ir-label "tr-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    6
                    (compiler_ir_types.CompilerIrBinOp.Eq)
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.CompilerIrValue.I64 5)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 6)
                    (compiler_ir_types.compiler-ir-label "tr-yes")
                    (compiler_ir_types.compiler-ir-label "tr-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tr-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      7
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.I64 40)
                        (compiler_ir_types.compiler-ir-label "tr-merge")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "tr-alt")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 7)))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tr-no")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Phi
                        8
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.I64 41)
                          (compiler_ir_types.compiler-ir-label "tr-merge")
                          (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                            (compiler_ir_types.CompilerIrValue.I64 31)
                            (compiler_ir_types.compiler-ir-label "tr-alt")
                            (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 8)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))))

;; D3 -- `%4` decides the merge's branch AND is read again by `td-yes`'s phi on
;; the merge edge. The single-use gate refused that; the live-out rule admits it,
;; because the extra reader is exactly one of the merge's own out-edges and the
;; repair re-expresses it at the threaded origin.
(define (opt-thread-multi-use-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "td-alt")
          (compiler_ir_types.compiler-ir-label "td-guard"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "td-alt")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "td-yes")
            (compiler_ir_types.compiler-ir-label "td-no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "td-guard")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "td-a")
              (compiler_ir_types.compiler-ir-label "td-b"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "td-a")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "td-merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "td-b")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "td-merge"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "td-merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    4
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Bool true)
                      (compiler_ir_types.compiler-ir-label "td-a")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Bool false)
                        (compiler_ir_types.compiler-ir-label "td-b")
                        (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "td-yes")
                    (compiler_ir_types.compiler-ir-label "td-no"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "td-yes")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      5
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 4)
                        (compiler_ir_types.compiler-ir-label "td-merge")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.Bool false)
                          (compiler_ir_types.compiler-ir-label "td-alt")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                      (compiler_ast_types.AstType.Bool))
                    (compiler_ir_types.CompilerIrInstr.Branch
                      (compiler_ir_types.CompilerIrValue.Var 5)
                      (compiler_ir_types.compiler-ir-label "td-y1")
                      (compiler_ir_types.compiler-ir-label "td-y2"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "td-y1")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.I64 1)))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "td-y2")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Return
                          (compiler_ir_types.CompilerIrMaybeValue.Some
                            (compiler_ir_types.CompilerIrValue.I64 2)))))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "td-no")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Return
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              (compiler_ir_types.CompilerIrValue.I64 40)))))
                      (compiler_ir_types.CompilerIrBlockList.Nil))))))))))))

;; D3 -- six decided predecessors on one merge. A round redirects at most
;; `opt-thread-pred-budget` of them, so one round leaves two behind and the
;; fixpoint picks those up on the next: the cap bounds the phi-web growth per
;; round without costing the rewrite.
(define (opt-thread-wide-merge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "tk-g1")
          (compiler_ir_types.compiler-ir-label "tk-g2"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "tk-g1")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "tk-p0")
            (compiler_ir_types.compiler-ir-label "tk-p1"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "tk-g2")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "tk-g3")
              (compiler_ir_types.compiler-ir-label "tk-g4"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "tk-g3")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "tk-p2")
                (compiler_ir_types.compiler-ir-label "tk-p3"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "tk-g4")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.compiler-ir-label "tk-p4")
                  (compiler_ir_types.compiler-ir-label "tk-p5"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "tk-p0")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "tk-merge"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "tk-p1")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "tk-merge"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "tk-p2")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Jump
                        (compiler_ir_types.compiler-ir-label "tk-merge"))))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "tk-p3")
                      (opt-test-instrs
                        (compiler_ir_types.CompilerIrInstr.Jump
                          (compiler_ir_types.compiler-ir-label "tk-merge"))))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "tk-p4")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Jump
                            (compiler_ir_types.compiler-ir-label "tk-merge"))))
                      (compiler_ir_types.compiler-ir-block-cons
                        (compiler_ir_types.CompilerIrBlock.Block
                          (compiler_ir_types.compiler-ir-label "tk-p5")
                          (opt-test-instrs
                            (compiler_ir_types.CompilerIrInstr.Jump
                              (compiler_ir_types.compiler-ir-label "tk-merge"))))
                        (compiler_ir_types.compiler-ir-block-cons
                          (compiler_ir_types.CompilerIrBlock.Block
                            (compiler_ir_types.compiler-ir-label "tk-merge")
                            (opt-test-instrs
                              (compiler_ir_types.CompilerIrInstr.Phi
                                4
                                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                  (compiler_ir_types.CompilerIrValue.Bool true)
                                  (compiler_ir_types.compiler-ir-label "tk-p0")
                                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                    (compiler_ir_types.CompilerIrValue.Bool
                                      false)
                                    (compiler_ir_types.compiler-ir-label
                                      "tk-p1")
                                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                      (compiler_ir_types.CompilerIrValue.Bool
                                        true)
                                      (compiler_ir_types.compiler-ir-label
                                        "tk-p2")
                                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                        (compiler_ir_types.CompilerIrValue.Bool
                                          false)
                                        (compiler_ir_types.compiler-ir-label
                                          "tk-p3")
                                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                          (compiler_ir_types.CompilerIrValue.Bool
                                            true)
                                          (compiler_ir_types.compiler-ir-label
                                            "tk-p4")
                                          (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                                            (compiler_ir_types.CompilerIrValue.Bool
                                              false)
                                            (compiler_ir_types.compiler-ir-label
                                              "tk-p5")
                                            (compiler_ir_types.compiler-ir-phi-input-seq-empty)))))))
                                (compiler_ast_types.AstType.Bool))
                              (compiler_ir_types.CompilerIrInstr.Branch
                                (compiler_ir_types.CompilerIrValue.Var 4)
                                (compiler_ir_types.compiler-ir-label "tk-yes")
                                (compiler_ir_types.compiler-ir-label "tk-no"))))
                          (compiler_ir_types.compiler-ir-block-cons
                            (compiler_ir_types.CompilerIrBlock.Block
                              (compiler_ir_types.compiler-ir-label "tk-yes")
                              (opt-test-instrs
                                (compiler_ir_types.CompilerIrInstr.Return
                                  (compiler_ir_types.CompilerIrMaybeValue.Some
                                    (compiler_ir_types.CompilerIrValue.I64 1)))))
                            (compiler_ir_types.compiler-ir-block-cons
                              (compiler_ir_types.CompilerIrBlock.Block
                                (compiler_ir_types.compiler-ir-label "tk-no")
                                (opt-test-instrs
                                  (compiler_ir_types.CompilerIrInstr.Return
                                    (compiler_ir_types.CompilerIrMaybeValue.Some
                                      (compiler_ir_types.CompilerIrValue.I64 0)))))
                              (compiler_ir_types.CompilerIrBlockList.Nil))))))))))))))))

;; --- forwarding-block straightening ----------------------------------------
;; Both arms are trampolines and neither destination carries a phi, so both
;; edges thread. The `true` arm goes through two of them, which is the chain
;; case: the destination's phis are repaired against the LAST forwarding block,
;; not the first. No trampoline here is followed by its own target, so none of
;; them is an already-elided `jmp`.
(define (opt-cfg-straighten-plain-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "sf-then")
          (compiler_ir_types.compiler-ir-label "sf-else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "sf-then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "sf-mid"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "sf-else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "sf-no"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "sf-yes")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 1)))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "sf-mid")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "sf-yes"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "sf-no")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 0)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

;; The arith_loop shape: a jump-only block sitting immediately before its own
;; target. The backend already elides that `jmp`, and both `opt-loop-preheaders`
;; and the M-F loop-constant hoist need the block to stay, so the pass must
;; decline and report no change.
(define (opt-cfg-straighten-fallthrough-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "sk-pre")
          (compiler_ir_types.compiler-ir-label "sk-out"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "sk-pre")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "sk-body"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "sk-body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 1)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "sk-out")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Only the `true` arm is a trampoline; the `false` arm does real work, so it
;; stays a predecessor. The join's phi therefore has to survive with the
;; threaded origin substituted for the removed block.
(define (opt-cfg-straighten-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "sp-then")
          (compiler_ir_types.compiler-ir-label "sp-else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "sp-then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "sp-join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "sp-else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              1
              (compiler_ir_types.CompilerIrValue.I64 7)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "sp-join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "sp-join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                2
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ir_types.compiler-ir-label "sp-then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 1)
                    (compiler_ir_types.compiler-ir-label "sp-else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 2)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; The `it-slice-eq?` trap, minimised: both arms are trampolines onto the same
;; join and the join's phi gives them different values. Threading both would
;; need two `entry` inputs in one phi, so the second arm must be refused.
(define (opt-cfg-straighten-duplicate-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "sd-then")
          (compiler_ir_types.compiler-ir-label "sd-else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "sd-then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "sd-join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "sd-else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "sd-join"))))
        ;; Unreachable spacer: it keeps both arms off `sd-join`'s lexical front
        ;; door, so neither is skipped as an already-elided `jmp` and the
        ;; duplicate-predecessor rail is what decides the second arm.
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "sd-spacer")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 2)))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "sd-join")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Phi
                  1
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ir_types.compiler-ir-label "sd-then")
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.I64 0)
                      (compiler_ir_types.compiler-ir-label "sd-else")
                      (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 1)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

;; Switch coverage: the default edge and one case edge thread to different
;; destinations, while a second case aimed at the destination the first case
;; already claimed is refused. The default is decided first, so `accepted` has
;; to carry across both the default and the case walk.
(define (opt-cfg-straighten-switch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Switch
          (compiler_ir_types.CompilerIrValue.Var 0)
          1
          (compiler_ir_types.compiler-ir-switch-case-seq2
            (compiler_ir_types.CompilerIrSwitchCase.Case
              1
              (compiler_ir_types.compiler-ir-label "ss-a"))
            (compiler_ir_types.CompilerIrSwitchCase.Case
              2
              (compiler_ir_types.compiler-ir-label "ss-b")))
          (compiler_ir_types.compiler-ir-label "ss-d"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "ss-a")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "ss-x"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "ss-b")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "ss-x"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "ss-d")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "ss-y"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "ss-x")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 1)))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "ss-y")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 2)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

;; No block is a bare `jump`, so the candidate scan must decline before the
;; clone, the CFG index and the use census are ever built.
(define (opt-cfg-straighten-inert-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "si-yes")
          (compiler_ir_types.compiler-ir-label "si-no"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "si-yes")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 1)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "si-no")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

;; The pass verifies its own result and hands back the input when the verify
;; rejects, so these blocks have to be verifiable to begin with: the branch
;; condition is a declared parameter rather than a free var.
(define (opt-cfg-straighten-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "straighten")
    (opt-sccp-cond-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-cfg-straighten-run
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_optimize.OptFunctionPassResult
  (compiler_optimize.opt-cfg-straighten-final-pass
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-cfg-straighten-test-function
      (compiler_ir_types.compiler-ir-global-shared-view blocks))))

;; A switch index is an integer, so this variant declares an i64 parameter
;; where the branch cases declare a bool one.
(define (opt-cfg-straighten-tag-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "tag"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-empty)))

(define (opt-cfg-straighten-run-switch
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_optimize.OptFunctionPassResult
  (compiler_optimize.opt-cfg-straighten-final-pass
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "straighten-switch")
      (opt-cfg-straighten-tag-params)
      (compiler_ast_types.AstType.I64)
      16
      blocks)))

(define (opt-cfg-switch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Switch
          (compiler_ir_types.CompilerIrValue.Var 0)
          1
          (compiler_ir_types.compiler-ir-switch-case-seq2
            (compiler_ir_types.CompilerIrSwitchCase.Case
              1
              (compiler_ir_types.compiler-ir-label "one"))
            (compiler_ir_types.CompilerIrSwitchCase.Case
              2
              (compiler_ir_types.compiler-ir-label "two")))
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "one")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 1)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "two")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 2)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "other")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;: `opt-cfg-index-build` numbers blocks in block-list walk order, so for a walk
;: over the list the index was built from, the position *is* the id. Several
;: optimizer passes now rely on that instead of hashing the label to recover it
;: (refs #5718), and nothing else pins it: every other test here obtains an id
;: through `opt-cfg-index-id` and then uses it consistently, so renumbering the
;: index -- by reverse postorder, say, to make the dominator tables denser --
;: would leave those green while silently pointing the walk-position readers at
;: a different block. This asserts the numbering itself.
(define (opt-cfg-index-walk-order-ids-ok?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [index : compiler_optimize.OptCfgIndex]
  [position : i64]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) true]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label _)
          (and
            (match (compiler_optimize.opt-cfg-index-id
              (compiler_optimize.compiler-opt-global-shared-view index)
              label)
              [(option_i64.Some id) (= id position)]
              [(option_i64.None) false])
            (opt-cfg-index-walk-order-ids-ok?
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              index
              (+ position 1)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-cfg-index-walk-order-ids-ok?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        index
        position)]))

(define (opt-cfg-index-numbering-ok?) : bool
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList (opt-cfg-switch-blocks)]
    (opt-cfg-index-walk-order-ids-ok?
      (compiler_ir_types.compiler-ir-global-shared-view blocks)
      (compiler_optimize.opt-cfg-index-build blocks)
      0)))

(define (opt-cfg-switch-successors-ok?) : bool
  (let
    [successors : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-cfg-index-successors
        (compiler_optimize.opt-cfg-index-build (opt-cfg-switch-blocks))
        (compiler_ir_types.compiler-ir-label "entry"))]
    (and
      (=
        (compiler_optimize.opt-label-count
          (compiler_optimize.compiler-opt-global-shared-view successors))
        3)
      (compiler_optimize.opt-label-contains
        (compiler_optimize.compiler-opt-global-shared-view successors)
        (compiler_ir_types.compiler-ir-label "one"))
      (compiler_optimize.opt-label-contains
        (compiler_optimize.compiler-opt-global-shared-view successors)
        (compiler_ir_types.compiler-ir-label "two"))
      (compiler_optimize.opt-label-contains
        successors
        (compiler_ir_types.compiler-ir-label "other")))))

(define (opt-ssa-cond-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-empty)))

(define (opt-ssa-loop-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "seed"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "cond"
        (compiler_ast_types.AstType.Bool)
        4)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-ssa-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              2
              (compiler_ir_types.CompilerIrValue.I64 20)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                3
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 3)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-ssa-diamond-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
