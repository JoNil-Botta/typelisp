              (compiler_ir_types.CompilerIrValue.Var 21)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (compiler-optimize-simd-gvn-self-test) : i64
  (let
    [type-segment-bases : i64
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [dominated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-dominated-blocks))]
    [siblings : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-sibling-blocks))]
    [redefined : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-redefined-operand-blocks))]
    [current : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-current-block-blocks))]
    [dst-redefined : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        type-segment-bases
        (opt-gvn-test-params)
        (opt-simd-gvn-redefined-dst-blocks))]
    (cond
      [(not (= (opt-simd-gvn-kind-count-blocks dominated 0) 1)) 1]
      [(not (= (opt-simd-gvn-kind-count-blocks dominated 1) 1)) 2]
      [(not (= (opt-simd-gvn-kind-count-blocks dominated 2) 1)) 3]
      [(not (= (opt-blocks-mov-src-var dominated 20 (- 0 1)) 10)) 4]
      [(not (= (opt-blocks-mov-src-var dominated 21 (- 0 1)) 11)) 5]
      [(not (= (opt-blocks-mov-src-var dominated 22 (- 0 1)) 12)) 6]
      [(not (= (opt-simd-gvn-kind-count-blocks siblings 1) 2)) 7]
      [(not (= (opt-simd-gvn-kind-count-blocks redefined 1) 2)) 8]
      [(not (= (opt-simd-gvn-kind-count-blocks current 0) 2)) 9]
      [(not (= (opt-blocks-mov-src-var current 20 (- 0 1)) (- 0 1))) 10]
      [(not (= (opt-simd-gvn-kind-count-blocks dst-redefined 1) 2)) 11]
      [else 42])))

(define (opt-word-instr-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Word _ _ _ _) 1]
    [_ 0]))

(define (opt-count-word-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-word-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-word-instr-count (array-ref slots index))))))

(define (opt-count-word-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-word-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-words-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-word-instr-seq instrs)
            (opt-count-words-blocks (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-words-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-pack-instr-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Pack _ _ _) 1]
    [_ 0]))

(define (opt-count-pack-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-pack-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-pack-instr-count (array-ref slots index))))))

(define (opt-count-pack-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-pack-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-packs-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-pack-instr-seq instrs)
            (opt-count-packs-blocks (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-packs-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

;; A Pack whose extractions all fold block-locally leaves the group unused:
;; the array-backed pipeline DCE must retire it (the map-backed DCE always
;; did; the array mirror was missing the Pack/Word arms).
(define (opt-dce-pack-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Pack
          10
          (compiler_ir_types.compiler-ir-value-seq-prepend
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-value-seq-empty)))
          (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
        (compiler_ir_types.CompilerIrInstr.Word
          11
          (compiler_ir_types.CompilerIrValue.Var 10)
          0
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Word
          12
          (compiler_ir_types.CompilerIrValue.Var 10)
          1
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          13
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 13)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

;; Returns 42 only when the full pipeline folds both extractions block-locally
;; and retires the now-unused Pack (0 Words and 0 Packs remain).
(define (compiler-optimize-dce-pack-self-test) : i64
  (match (compiler_optimize.optimize-function-once
    (compiler_ast_types.ast-node-pool-reader-context-current)
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "dce_pack")
      (opt-gvn-test-params)
      (compiler_ast_types.AstType.I64)
      16
      (opt-dce-pack-blocks)))
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ optimized-blocks)
      (begin
        (unless (= (opt-count-words-blocks optimized-blocks) 0) (return 1))
        (unless (= (opt-count-packs-blocks optimized-blocks) 0) (return 2))
        42)]))

(define (opt-instr-compare-dst?
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp d op _ _ _)
      (and (= d dst) (compiler_optimize.opt-bool-branch-compare-op? op))]
    [_ false]))

(define (opt-block-instr-at
  [block : compiler_ir_types.CompilerIrBlock]
  [index : i64]) : compiler_ir_types.CompilerIrInstr
  (match block
    [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
      (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]))

(define (opt-block-instr-count [block : compiler_ir_types.CompilerIrBlock]) : i64
  (match block
    [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
      (compiler_ir_types.compiler-ir-instr-seq-count instrs)]))

;; The counted-fill shape: the loop-closing compare sits one flag-safe
;; pointer-increment Gep away from its branch. Sinking moves it adjacent so
;; the backend can fuse cmp;jcc.
(define (opt-cmp-sink-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "loop")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          5
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Gep
          6
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 5)
          (compiler_ir_types.compiler-ir-label "t")
          (compiler_ir_types.compiler-ir-label "f"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "t")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "f")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

;; Same shape, but the intervening instruction redefines a compare operand:
;; the compare must stay put.
(define (opt-cmp-sink-blocked-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "loop")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          5
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.BinOp
          0
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 5)
          (compiler_ir_types.compiler-ir-label "t")
          (compiler_ir_types.compiler-ir-label "f"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "t")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "f")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

;; Returns 42 only when the movable compare lands right before the branch and
;; the operand-clobbering one stays at index 0.
(define (compiler-optimize-cmp-sink-self-test) : i64
  (match (compiler_optimize.opt-cmp-sink-blocks-pass (opt-cmp-sink-test-blocks))
    [(compiler_optimize.OptBlockListPassResult.Result
        moved-blocks
        moved-changed)
      (match moved-blocks
        [(compiler_ir_types.CompilerIrBlockList.Cons moved _)
          (match (compiler_optimize.opt-cmp-sink-blocks-pass
            (opt-cmp-sink-blocked-test-blocks))
            [(compiler_optimize.OptBlockListPassResult.Result
                stayed-blocks
                stayed-changed)
              (match stayed-blocks
                [(compiler_ir_types.CompilerIrBlockList.Cons stayed _)
                  (begin
                    (unless moved-changed (return 1))
                    (when stayed-changed (return 2))
                    (unless
                      (opt-instr-compare-dst?
                        (opt-block-instr-at
                          moved
                          (- (opt-block-instr-count moved) 2))
                        5)
                      (return 3))
                    (unless
                      (opt-instr-compare-dst? (opt-block-instr-at stayed 0) 5)
                      (return 4))
                    42)]
                [_ 5])])]
        [_ 6])]))

;; --- single-use load sinking -----------------------------------------------
;;
;; Fixtures use vars 0/1/2 as array bases, 3 as the shared index, 5 as a spare
;; scalar and 6 as a spare length. Pairs are `gep 1x; load 1x+1`.
(define (opt-load-sink-gep [dst : i64] [base : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Gep
    dst
    (compiler_ir_types.CompilerIrValue.Var base)
    (compiler_ir_types.CompilerIrValue.Var 3)
    (compiler_ast_types.AstType.I64)))

(define (opt-load-sink-load [dst : i64] [address : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Load
    dst
    (compiler_ir_types.CompilerIrValue.Var address)
    (compiler_ast_types.AstType.I64)))

(define (opt-load-sink-binop
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    dst
    op
    lhs
    rhs
    (compiler_ast_types.AstType.I64)))

(define (opt-load-sink-var [var : i64]) : compiler_ir_types.CompilerIrValue
  (compiler_ir_types.CompilerIrValue.Var var))

(define (opt-load-sink-return [var : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Return
    (compiler_ir_types.CompilerIrMaybeValue.Some (opt-load-sink-var var))))

(define (opt-load-sink-block-of [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "loop")
      instrs)
    compiler_ir_types.CompilerIrBlockList.Nil))

;; benchmarks/liveness_scan's flagship body: three element reads lowered first,
;; then the `xor`/`and`/`or` chain that consumes them in reverse order. Every
;; load must end up immediately before ITS consumer.
(define (opt-load-sink-chain-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-load-sink-block-of
    (opt-test-instrs
      (opt-load-sink-gep 10 0)
      (opt-load-sink-load 11 10)
      (opt-load-sink-gep 12 1)
      (opt-load-sink-load 13 12)
      (opt-load-sink-gep 14 2)
      (opt-load-sink-load 15 14)
      (opt-load-sink-binop
        16
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        (opt-load-sink-var 15)
        (compiler_ir_types.CompilerIrValue.I64 (- 0 1)))
      (opt-load-sink-binop
        17
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (opt-load-sink-var 13)
        (opt-load-sink-var 16))
      (opt-load-sink-binop
        18
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (opt-load-sink-var 11)
        (opt-load-sink-var 17))
      (opt-load-sink-return 18))))

;; A StorePtr between the load and its consumer may alias the loaded cell.
(define (opt-load-sink-store-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-load-sink-block-of
    (opt-test-instrs
      (opt-load-sink-gep 10 0)
      (opt-load-sink-load 11 10)
      (opt-load-sink-gep 12 1)
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (opt-load-sink-var 12)
        (opt-load-sink-var 5)
        (compiler_ast_types.AstType.I64))
      (opt-load-sink-binop
        18
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (opt-load-sink-var 11)
        (opt-load-sink-var 5))
      (opt-load-sink-return 18))))

;; A call between the load and its consumer may store anywhere.
(define (opt-load-sink-call-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-load-sink-block-of
    (opt-test-instrs
      (opt-load-sink-gep 10 0)
      (opt-load-sink-load 11 10)
      (compiler_ir_types.CompilerIrInstr.Call
        21
        (opt-test-symbol "load_sink_callee")
        compiler_ir_types.CompilerIrCallArgs.Nil
        (compiler_ast_types.AstType.I64))
      (opt-load-sink-binop
        18
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (opt-load-sink-var 11)
        (opt-load-sink-var 21))
      (opt-load-sink-return 18))))

;; The gep's base is redefined before the consumer. SSA forbids this, so the
;; guard is belt and braces -- but it is the guard that makes the pass safe
;; without a dominance query, so it gets a fixture.
(define (opt-load-sink-rebase-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-load-sink-block-of
    (opt-test-instrs
      (opt-load-sink-gep 10 0)
      (opt-load-sink-load 11 10)
      (compiler_ir_types.CompilerIrInstr.Mov
        0
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ast_types.AstType.I64))
      (opt-load-sink-binop
        18
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (opt-load-sink-var 11)
        (opt-load-sink-var 0))
      (opt-load-sink-return 18))))

;; The first load has a second reader, so the backend fold could never fire on
;; it and the pair must not move.
(define (opt-load-sink-double-use-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-load-sink-block-of
    (opt-test-instrs
      (opt-load-sink-gep 10 0)
      (opt-load-sink-load 11 10)
      (opt-load-sink-gep 12 1)
      (opt-load-sink-load 13 12)
      (opt-load-sink-binop
        17
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (opt-load-sink-var 13)
        (opt-load-sink-var 5))
      (opt-load-sink-binop
        18
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (opt-load-sink-var 11)
        (opt-load-sink-var 17))
      (compiler_ir_types.CompilerIrInstr.Mov
        19
        (opt-load-sink-var 11)
        (compiler_ast_types.AstType.I64))
      (opt-load-sink-return 18))))

;; An UNRELATED bounds check sits between the first load and its consumer.
;; Crossing it is allowed: the check only aborts, and a load that no longer
;; runs on the aborting path has no observable effect (see the pass note).
(define (opt-load-sink-bounds-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-load-sink-block-of
    (opt-test-instrs
      (opt-load-sink-gep 10 0)
      (opt-load-sink-load 11 10)
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (opt-load-sink-var 3)
        (opt-load-sink-var 6)
        (compiler_ir_types.compiler-ir-label "bounds_ok"))
      (opt-load-sink-gep 12 1)
      (opt-load-sink-load 13 12)
      (opt-load-sink-binop
        18
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (opt-load-sink-var 11)
        (opt-load-sink-var 13))
      (opt-load-sink-return 18))))

(define (opt-load-sink-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlock
  (match (compiler_optimize.opt-load-sink-blocks 32 blocks)
    [(compiler_ir_types.CompilerIrBlockList.Cons block _) block]
    [_
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "empty")
        (compiler_ir_types.compiler-ir-instr-seq-empty))]))

(define (opt-load-sink-instr-dst?
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]) : bool
  (= (compiler_optimize.opt-gvn-instr-dst instr) dst))

;; `dsts` names the expected definition at each index, using -1 for the
;; terminator.
(define (opt-load-sink-order?
  [block : compiler_ir_types.CompilerIrBlock]
  [dsts : (__tl_dyn-array i64)]) : bool
  (let
    [count : i64 (array-length dsts)]
    [index : i64 0]
    [ok : bool (= (opt-block-instr-count block) count)]
    (begin
      (while (and ok (< index count))
        (begin
          (unless
            (opt-load-sink-instr-dst?
              (opt-block-instr-at block index)
              (array-ref dsts index))
            (set! ok false))
          (set! index (+ index 1))))
      ok)))

;; A refused pair is still the block's first two instructions; a sunk one is
;; not, because whatever followed it takes index 0.
(define (opt-load-sink-pair-stayed?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (let
    [block : compiler_ir_types.CompilerIrBlock (opt-load-sink-run blocks)]
    (and
      (opt-load-sink-instr-dst? (opt-block-instr-at block 0) 10)
      (opt-load-sink-instr-dst? (opt-block-instr-at block 1) 11))))

;; Returns 42 only when the flagship chain re-orders into three adjacent
;; `gep; load; binop` triples, every refusal fixture stays byte-identical, the
;; bounds-check fixture sinks, and a second run is a no-op.
(define (compiler-optimize-load-sink-self-test) : i64
  (let
    [chain : compiler_ir_types.CompilerIrBlock
      (opt-load-sink-run (opt-load-sink-chain-blocks))]
    [expected : (__tl_dyn-array i64) (array.make-array i64 10)]
    [bounds-expected : (__tl_dyn-array i64) (array.make-array i64 7)]
    (begin
      (set! (array-ref expected 0) 14)
      (set! (array-ref expected 1) 15)
      (set! (array-ref expected 2) 16)
      (set! (array-ref expected 3) 12)
      (set! (array-ref expected 4) 13)
      (set! (array-ref expected 5) 17)
      (set! (array-ref expected 6) 10)
      (set! (array-ref expected 7) 11)
      (set! (array-ref expected 8) 18)
      (set! (array-ref expected 9) (- 0 1))
      (unless (opt-load-sink-order? chain expected) (return 1))
      ;; Idempotence: the sunk block is already at its fixpoint.
      (unless
        (opt-load-sink-order?
          (opt-load-sink-run
            (compiler_ir_types.compiler-ir-block-cons
              chain
              compiler_ir_types.CompilerIrBlockList.Nil))
          expected)
        (return 2))
      ;; Refusals: an aliasing store, a call, a redefined base, a second use.
      (unless
        (opt-load-sink-pair-stayed? (opt-load-sink-store-blocks))
        (return 3))
      (unless
        (opt-load-sink-pair-stayed? (opt-load-sink-call-blocks))
        (return 4))
      (unless
        (opt-load-sink-pair-stayed? (opt-load-sink-rebase-blocks))
        (return 5))
      (unless
        (opt-load-sink-pair-stayed? (opt-load-sink-double-use-blocks))
        (return 6))
      ;; The bounds check is not a barrier: the pair lands past it, ahead of
      ;; the second pair, so both reach the consumer adjacent.
      (set! (array-ref bounds-expected 0) (- 0 1))
      (set! (array-ref bounds-expected 1) 10)
      (set! (array-ref bounds-expected 2) 11)
      (set! (array-ref bounds-expected 3) 12)
      (set! (array-ref bounds-expected 4) 13)
      (set! (array-ref bounds-expected 5) 18)
      (set! (array-ref bounds-expected 6) (- 0 1))
      (unless
        (opt-load-sink-order?
          (opt-load-sink-run (opt-load-sink-bounds-blocks))
          bounds-expected)
        (return 7))
      42)))

;; --- late compare duplication ----------------------------------------------
;;
;; Fixtures share two i64 parameters (vars 0 and 1) plus a spare var 2 that
;; stands in for a pointer, and always define the comparison as var 5.
(define (opt-cmp-dup-test-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol name)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "a"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "b"
          (compiler_ast_types.AstType.I64)
          1)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "p"
            (compiler_ast_types.AstType.I64)
            2)
          compiler_ir_types.CompilerIrParamList.Nil)))
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-cmp-dup-test-compare [lhs : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    5
    (compiler_ir_types.CompilerIrBinOp.Lt)
    lhs
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ast_types.AstType.I64)))

;; The same comparison against a LITERAL right operand. One variable operand
;; means a copy exchanges the boolean's live range for that variable's
;; one-for-one, which is what admits a SINGLE-reader sink.
(define (opt-cmp-dup-test-compare-lit [lhs : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    5
    (compiler_ir_types.CompilerIrBinOp.Lt)
    lhs
    (compiler_ir_types.CompilerIrValue.I64 7)
    (compiler_ast_types.AstType.I64)))

(define (opt-cmp-dup-test-branch [cond-var : i64] [yes : String] [no : String]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Branch
    (compiler_ir_types.CompilerIrValue.Var cond-var)
    (compiler_ir_types.compiler-ir-label yes)
    (compiler_ir_types.compiler-ir-label no)))

(define (opt-test-instr-seq-append
  [head : compiler_ir_types.CompilerIrInstrSeq]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [head-count : i64 (compiler_ir_types.compiler-ir-instr-seq-count head)]
    [tail-count : i64 (compiler_ir_types.compiler-ir-instr-seq-count tail)]
    [builder : compiler_ir_types.CompilerIrInstrBuilder
      (compiler_ir_types.compiler-ir-instr-builder-with-capacity
        (+ head-count tail-count))]
    (begin
      (compiler_ir_types.compiler-ir-instr-builder-append-seq-range!
        (&mut builder)
        head
        0
        head-count)
      (compiler_ir_types.compiler-ir-instr-builder-append-seq-range!
        (&mut builder)
        tail
        0
        tail-count)
      (compiler_ir_types.compiler-ir-instr-builder-to-seq builder))))

(define (opt-cmp-dup-test-return-block [label : String] [var : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label label)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var var))))))

;; `entry` computes the comparison and branches on it right away (already
;; fused); `mid` and `other` read the same boolean from elsewhere and are the
;; sites that need their own copy. `extra?` adds the third site the budget test
;; needs. `mid-head` prefixes `mid`, which is how the non-branch-reader
;; fixtures add a second kind of use.
(define (opt-cmp-dup-shared-blocks
  [mid-head : compiler_ir_types.CompilerIrInstrSeq]
  [lhs : compiler_ir_types.CompilerIrValue]
  [extra? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-cmp-dup-test-compare lhs)
        (opt-cmp-dup-test-branch 5 "mid" "exit")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "mid")
        (opt-test-instr-seq-append
          mid-head
          (opt-test-instrs (opt-cmp-dup-test-branch 5 "other" "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (if extra?
            (opt-test-instrs (opt-cmp-dup-test-branch 5 "exit" "tail"))
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "tail")))))
        (compiler_ir_types.compiler-ir-block-cons
          (opt-cmp-dup-test-return-block "tail" 0)
          (compiler_ir_types.compiler-ir-block-cons
            (opt-cmp-dup-test-return-block "exit" 1)
            compiler_ir_types.CompilerIrBlockList.Nil))))))

;; The single-reader shape LICM leaves behind: `entry` computes the condition
;; and jumps, and the ONLY reader is the branch in `mid`. The copy `mid` takes
;; is a SINK -- it takes the last reader, so the original is dead and the `dce`
;; below the pass retires it (this pass leaves it in place, which is what the
;; assertions on `entry` state). `entry-head` prefixes `entry` and `mid-head`
;; prefixes `mid`, which is how the dead-reader and multiply-defined-operand
;; fixtures add their extra instruction.
(define (opt-cmp-dup-sink-blocks
  [entry-head : compiler_ir_types.CompilerIrInstrSeq]
  [mid-head : compiler_ir_types.CompilerIrInstrSeq]
  [compare : compiler_ir_types.CompilerIrInstr]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instr-seq-append
        entry-head
        (opt-test-instrs
          compare
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "mid")))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "mid")
        (opt-test-instr-seq-append
          mid-head
          (opt-test-instrs (opt-cmp-dup-test-branch 5 "tail" "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (opt-cmp-dup-test-return-block "tail" 0)
        (compiler_ir_types.compiler-ir-block-cons
          (opt-cmp-dup-test-return-block "exit" 1)
          compiler_ir_types.CompilerIrBlockList.Nil)))))

;; `add` on the two parameters, used as the definition -- or, twice over, as the
;; MULTIPLE definitions -- of the comparison's left operand.
(define (opt-cmp-dup-operand-def [rhs : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    6
    (compiler_ir_types.CompilerIrBinOp.Add)
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.CompilerIrValue.Var rhs)
    (compiler_ast_types.AstType.I64)))

;; One instruction on its own list, the shape the fixture heads want.
(define (opt-cmp-dup-one-instr [instr : compiler_ir_types.CompilerIrInstr]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs instr))

;; The negation shape the backend fuses by exchanging the branch's two labels.
;; `%5` is read by the entry branch AND by the negation, so it is refused; the
;; negation's own single reader is the branch in `other`, which therefore takes
;; a copy of the `not`. The comparison is not adjacent to the negation and not
;; single-use, so the `not (cmp a b)` fold cannot reach it either -- the copy is
;; the only thing that fuses this branch.
(define (opt-cmp-dup-not-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-cmp-dup-test-compare (compiler_ir_types.CompilerIrValue.Var 0))
        (opt-cmp-dup-test-branch 5 "mid" "exit")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "mid")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.UnOp
            6
            (compiler_ir_types.CompilerIrUnOp.Not)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "other"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs (opt-cmp-dup-test-branch 6 "tail" "exit")))
        (compiler_ir_types.compiler-ir-block-cons
          (opt-cmp-dup-test-return-block "tail" 0)
          (compiler_ir_types.compiler-ir-block-cons
            (opt-cmp-dup-test-return-block "exit" 1)
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-cmp-dup-block-at
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [index : i64]) : compiler_ir_types.CompilerIrBlock
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler_ir_types.compiler-ir-block-seq-ref seq index)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (if (<= index 0)
        block
        (opt-cmp-dup-block-at (__tl-box-place rest) (- index 1)))]
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "missing")
        (compiler_ir_types.compiler-ir-instr-seq-empty))]))

;; True when the block is exactly `compare; branch-on-that-compare`, the shape
;; the backend's fusion gate accepts.
(define (opt-cmp-dup-block-fused?
  [block : compiler_ir_types.CompilerIrBlock]
  [expect-dst : i64]) : bool
  (and
    (= (opt-block-instr-count block) 2)
    (opt-instr-compare-dst? (opt-block-instr-at block 0) expect-dst)
    (match (opt-block-instr-at block 1)
      [(compiler_ir_types.CompilerIrInstr.Branch cond _ _)
        (match cond
          [(compiler_ir_types.CompilerIrValue.Var v) (= v expect-dst)]
          [_ false])]
      [_ false])))

;; True when the block is exactly `not; branch-on-that-negation` over `src`, the
;; second def shape the backend's fusion gate accepts.
(define (opt-cmp-dup-block-not-fused?
  [block : compiler_ir_types.CompilerIrBlock]
  [expect-dst : i64]
  [src : i64]) : bool
  (and
    (= (opt-block-instr-count block) 2)
    (match (opt-block-instr-at block 0)
      [(compiler_ir_types.CompilerIrInstr.UnOp
          dst
          (compiler_ir_types.CompilerIrUnOp.Not)
          value
          (compiler_ast_types.AstType.Bool))
        (and (= dst expect-dst) (compiler_optimize.opt-value-is-var? value src))]
      [_ false])
    (match (opt-block-instr-at block 1)
      [(compiler_ir_types.CompilerIrInstr.Branch cond _ _)
        (match cond
          [(compiler_ir_types.CompilerIrValue.Var v) (= v expect-dst)]
          [_ false])]
      [_ false])))

(define (opt-cmp-dup-run
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [copies : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-cmp-dup-function-with-budget
    (opt-cmp-dup-test-function name blocks)
    copies))

;; Definition counts for the operand-admission arms: vars 0 and 1 have one
;; definition each, var 2 none, and var 3 as many as the caller asks for.
(define (opt-cmp-dup-defs-array [multi-def : i64]) : (__tl_dyn-array i64)
  (__tl_make-array 1 1 0 multi-def))

;; Returns 42 only when every arm of the compare-duplication contract holds.
(define (compiler-optimize-cmp-dup-self-test) : i64
  (let
    [defs : (__tl_dyn-array i64) (opt-cmp-dup-defs-array 2)]
    [shared : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_shared"
        (opt-cmp-dup-shared-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (compiler_ir_types.CompilerIrValue.Var 0)
          false)
        64)]
    [shared-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks shared)]
    ;; A stored boolean is a reader no copy can retire: the materialisation
    ;; stays, so a copy would only trade the site's `test` for a `cmp`.
    [stored : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_stored"
        (opt-cmp-dup-shared-blocks
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ast_types.AstType.Bool)))
          (compiler_ir_types.CompilerIrValue.Var 0)
          false)
        64)]
    ;; A phi input is a reader too, and one this pass must never rewrite.
    [phi-input : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_phi"
        (opt-cmp-dup-shared-blocks
          (opt-test-instrs-with-tail
            (opt-cmp-dup-one-instr
              (compiler_ir_types.CompilerIrInstr.StorePtr
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.CompilerIrValue.Var 6)
                (compiler_ast_types.AstType.Bool)))
            (compiler_ir_types.CompilerIrInstr.Phi
              6
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.CompilerIrPhiInputList.Nil))
              (compiler_ast_types.AstType.Bool)))
          (compiler_ir_types.CompilerIrValue.Var 0)
          false)
        64)]
    ;; An operand that is not a stable single definition refuses: a `Global` is
    ;; an implicit mutable read, so a second evaluation may see another value.
    [global-operand : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_global"
        (opt-cmp-dup-shared-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (compiler_ir_types.CompilerIrValue.Global 7)
          false)
        64)]
    ;; Idempotence: the copies are single-use, so a second round finds nothing.
    [again : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-cmp-dup-function shared)]
    ;; Budget: two loose sites, room for only one copy. The family must refuse
    ;; as a whole; a partial rewrite cannot retire the shared boolean.
    [capped : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_capped"
        (opt-cmp-dup-shared-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (compiler_ir_types.CompilerIrValue.Var 0)
          true)
        1)]
    [uncapped : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_uncapped"
        (opt-cmp-dup-shared-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (compiler_ir_types.CompilerIrValue.Var 0)
          true)
        64)]
    ;; The single-reader shape: one branch, in another block, is the whole use
    ;; list. The copy it takes is a sink, so the family is admitted with ONE
    ;; branch use.
    [sunk : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_sunk"
        (opt-cmp-dup-sink-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-test-compare-lit
            (compiler_ir_types.CompilerIrValue.Var 0)))
        64)]
    [sunk-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks sunk)]
    ;; A reader that is itself DEAD is not a reason to refuse -- `successor_sink`
    ;; strands exactly this `mov` copy of a condition it rematerialised. The
    ;; pass sweeps its input with the same `dce` that follows it, so the sink
    ;; still fires and the stranded copy is gone from the result.
    [dead-reader : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_dead_reader"
        (opt-cmp-dup-sink-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-one-instr
            (compiler_ir_types.CompilerIrInstr.Mov
              6
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ast_types.AstType.Bool)))
          (opt-cmp-dup-test-compare-lit
            (compiler_ir_types.CompilerIrValue.Var 0)))
        64)]
    ;; Control for the multiple-definition arm below: the same fixture with the
    ;; operand defined ONCE sinks.
    [one-def-operand : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_one_def_operand"
        (opt-cmp-dup-sink-blocks
          (opt-cmp-dup-one-instr (opt-cmp-dup-operand-def 1))
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-test-compare-lit
            (compiler_ir_types.CompilerIrValue.Var 6)))
        64)]
    ;; Two definitions of that operand and nothing else changes: the copy would
    ;; have no point at which the recipe is known to hold, so the family is
    ;; refused. SSA makes this unreachable in the pipeline; the pass tests it
    ;; rather than trusting the clone-producing passes above it.
    [multi-def-operand : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_multi_def_operand"
        (opt-cmp-dup-sink-blocks
          (opt-cmp-dup-one-instr (opt-cmp-dup-operand-def 1))
          (opt-cmp-dup-one-instr (opt-cmp-dup-operand-def 0))
          (opt-cmp-dup-test-compare-lit
            (compiler_ir_types.CompilerIrValue.Var 6)))
        64)]
    ;; TWO variable operands and a single branch reader: the copy would put both
    ;; operands where one boolean used to be, so the sink is refused. The
    ;; `shared` fixture above is the same comparison with a second branch reader
    ;; and IS rewritten -- a shared boolean pays for the extra value.
    [two-var-single-reader : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run
        "cmp_dup_two_var_single_reader"
        (opt-cmp-dup-sink-blocks
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (compiler_ir_types.compiler-ir-instr-seq-empty)
          (opt-cmp-dup-test-compare (compiler_ir_types.CompilerIrValue.Var 0)))
        64)]
    ;; The boolean negation the backend fuses by exchanging the branch labels.
    [not-sunk : compiler_ir_types.CompilerIrFunction
      (opt-cmp-dup-run "cmp_dup_not" (opt-cmp-dup-not-blocks) 64)]
    [not-sunk-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks not-sunk)]
    (begin
      ;; The already-adjacent site is left alone and the remote one gained its
      ;; own copy of the same comparison.
      (unless (= (compiler_optimize.opt-function-frame shared) 17) (return 1))
      (unless
        (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at shared-blocks 0) 5)
        (return 2))
      (unless
        (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at shared-blocks 1) 16)
        (return 3))
      (unless
        (match (opt-block-instr-at (opt-cmp-dup-block-at shared-blocks 1) 0)
          [(compiler_ir_types.CompilerIrInstr.BinOp _ _ lhs rhs _)
            (and
              (compiler_optimize.opt-value-is-var? lhs 0)
              (compiler_optimize.opt-value-is-var? rhs 1))]
          [_ false])
        (return 4))
      ;; Refusals leave the frame -- and therefore the whole function -- alone.
      (unless
        (= (compiler_optimize.opt-function-frame global-operand) 16)
        (return 5))
      (unless (= (compiler_optimize.opt-function-frame again) 17) (return 6))
      (unless (= (compiler_optimize.opt-function-frame capped) 16) (return 7))
      (unless (= (compiler_optimize.opt-function-frame uncapped) 18) (return 8))
      ;; Operand admission, stated directly: literals and single-definition
      ;; variables are re-evaluable; the compare's own destination, a
      ;; multiply-defined variable, and implicit global reads are not.
      (unless
        (compiler_optimize.opt-cmp-dup-operand-ok?
          (compiler_ir_types.CompilerIrValue.I64 3)
          5
          defs)
        (return 9))
      (unless
        (compiler_optimize.opt-cmp-dup-operand-ok?
          (compiler_ir_types.CompilerIrValue.Var 0)
          5
          defs)
        (return 10))
      (when
        (compiler_optimize.opt-cmp-dup-operand-ok?
          (compiler_ir_types.CompilerIrValue.Var 3)
          5
          defs)
        (return 11))
      (when
        (compiler_optimize.opt-cmp-dup-operand-ok?
          (compiler_ir_types.CompilerIrValue.Var 5)
          5
          defs)
        (return 12))
      (when
        (compiler_optimize.opt-cmp-dup-operand-ok?
          (compiler_ir_types.CompilerIrValue.RuntimeGlobal 2)
          5
          defs)
        (return 13))
      ;; Both extra readers refuse outright: nothing is copied and the phi
      ;; input still names the shared comparison.
      (unless (= (compiler_optimize.opt-function-frame stored) 16) (return 14))
      (unless
        (= (compiler_optimize.opt-function-frame phi-input) 16)
        (return 15))
      (unless
        (match (opt-block-instr-at
          (opt-cmp-dup-block-at
            (compiler_optimize.opt-function-blocks phi-input)
            1)
          0)
          [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
            (match inputs
              [(compiler_ir_types.CompilerIrPhiInputList.Cons value _ _)
                (compiler_optimize.opt-value-is-var? value 5)]
              [(compiler_ir_types.CompilerIrPhiInputList.Array seq)
                (and
                  (= seq.len 1)
                  (compiler_optimize.opt-value-is-var?
                    (__tl-project-field (array-ref seq.slots 0) value)
                    5))]
              [_ false])]
          [_ false])
        (return 16))
      ;; The remote branch took its own copy of the comparison, and the copy is
      ;; adjacent to it -- the backend's fusion gate reads exactly that.
      (unless (= (compiler_optimize.opt-function-frame sunk) 17) (return 17))
      (unless
        (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at sunk-blocks 1) 16)
        (return 18))
      (unless
        (match (opt-block-instr-at (opt-cmp-dup-block-at sunk-blocks 1) 0)
          [(compiler_ir_types.CompilerIrInstr.BinOp _ _ lhs rhs _)
            (and
              (compiler_optimize.opt-value-is-var? lhs 0)
              (match rhs
                [(compiler_ir_types.CompilerIrValue.I64 n) (= n 7)]
                [_ false]))]
          [_ false])
        (return 19))
      ;; The original is left exactly where it was: retiring it is the job of
      ;; the `dce` that runs under the pass in `opt-cmp-dup-final-pass`.
      (unless
        (and
          (= (opt-block-instr-count (opt-cmp-dup-block-at sunk-blocks 0)) 2)
          (opt-instr-compare-dst?
            (opt-block-instr-at (opt-cmp-dup-block-at sunk-blocks 0) 0)
            5))
        (return 20))
      ;; The dead `mov` reader neither blocks the sink nor survives it.
      (unless
        (= (compiler_optimize.opt-function-frame dead-reader) 17)
        (return 21))
      (unless
        (opt-cmp-dup-block-fused?
          (opt-cmp-dup-block-at
            (compiler_optimize.opt-function-blocks dead-reader)
            1)
          16)
        (return 22))
      ;; Operand definition counts, at the pass level this time: one definition
      ;; sinks, two refuse, and nothing else differs between the two fixtures.
      (unless
        (= (compiler_optimize.opt-function-frame one-def-operand) 17)
        (return 23))
      (unless
        (= (compiler_optimize.opt-function-frame multi-def-operand) 16)
        (return 24))
      ;; The live-range exchange has to be one-for-one for a single reader.
      (unless
        (= (compiler_optimize.opt-function-frame two-var-single-reader) 16)
        (return 25))
      ;; The negation is copied onto its branch as a negation; the comparison it
      ;; reads keeps its own already-fused site and is itself refused, because
      ;; the negation is a non-branch reader of it.
      (unless
        (= (compiler_optimize.opt-function-frame not-sunk) 17)
        (return 26))
      (unless
        (opt-cmp-dup-block-not-fused?
          (opt-cmp-dup-block-at not-sunk-blocks 2)
          16
          5)
        (return 27))
      (unless
        (opt-cmp-dup-block-fused? (opt-cmp-dup-block-at not-sunk-blocks 0) 5)
        (return 28))
      42)))

(define (opt-successor-sink-test-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol name)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "cond"
        (compiler_ast_types.AstType.Bool)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "value"
          (compiler_ast_types.AstType.I64)
          1)
        compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.I64)
    16
    blocks))

;; Both producers start in `entry`. Backward planning first moves the Pack whose
;; Word use is in `use`, then recognizes that the Load's only remaining use is
;; in that already-moved Pack and moves the Load ahead of it.
(define (opt-successor-sink-positive-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Load
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Pack
          3
          (compiler_ir_types.compiler-ir-value-seq-prepend
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-value-seq-empty))
          (compiler_ast_types.AstType.Struct (ci.intern "OneWord")))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "use")
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Word
            4
            (compiler_ir_types.CompilerIrValue.Var 3)
            0
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; An unconditional edge is a scheduling boundary, not an execution choice.
;; The incoming parameter is therefore already live across it, and the Mov can
;; move beside its sole use without extending execution or violating dominance.
(define (opt-successor-sink-jump-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The payload address uses a two-instruction address chain that is also needed
;; by the tag load in the dispatch block. Sinking the payload Load therefore
;; moves v4 but clones v3 and, transitively, v2 with fresh ids 16 and 17.
(define (opt-successor-sink-remat-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 16)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Gep
          3
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.Gep
          4
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.Load
          5
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          6
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Switch
          (compiler_ir_types.CompilerIrValue.Var 6)
          0
          (compiler_ir_types.compiler-ir-switch-case-seq1
            (compiler_ir_types.CompilerIrSwitchCase.Case
              0
              (compiler_ir_types.compiler-ir-label "other")))
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 5)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 6)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; v2 is a source-block Mov with uses in both paths. It cannot move and is not
;; in the Gep/BinOp rematerialization whitelist, so neither consumer may sink.
(define (opt-successor-sink-live-range-blocked-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          4
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "use")
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 4)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; v2 is external to `entry`, but the key address/load/compare makes it part of
;; the terminator dependency slice. The sibling payload Gep/Load may therefore
;; move to the matching arm without rematerializing that already-live leaf.
(define (opt-successor-sink-terminator-live-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "preheader")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "entry"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Load
            4
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Gep
            5
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Load
            6
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            7
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.compiler-ir-label "use")
            (compiler_ir_types.compiler-ir-label "other"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "use")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 6)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "other")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

;; v2 is defined in a predecessor and is not otherwise live in either
;; successor. Moving the source-block address producer would extend v2's live
;; range, while cloning it would do the same, so the payload Load must stay.
(define (opt-successor-sink-external-leaf-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "preheader")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
