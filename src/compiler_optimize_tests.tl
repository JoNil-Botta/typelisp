;; The load-AND-store body class and its own copy factor.
(define (compiler-optimize-unroll-load-store-self-test) : i64
  (let
    [merge-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 0))]
    [merge : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view merge-func))]
    ;; Second pass over the already-rewritten function: the generated labels
    ;; and the dropped self-edge make the result ineligible to its own scan.
    [idempotent-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view merge-func))]
    [idempotent : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks idempotent-func)]
    [refused-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 1))]
    [refused : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks refused-func)]
    [fill-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 2))]
    [fill : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view fill-func))]
    [checked-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-load-store-test-function 3))]
    [checked : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks checked-func)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view merge-func))))
        1]
      ;; entry, guard, unrolled body, remainder loop, exit.
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view merge))
            5))
        2]
      ;; TWO copies, not sixteen: the load-and-store factor.
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              (compiler_ir_types.compiler-ir-global-shared-view merge)
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            2))
        3]
      [(not
          (=
            (opt-unroll-test-count-load-in-block
              (compiler_ir_types.compiler-ir-global-shared-view merge)
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            4))
        4]
      ;; The original block stays in place as the remainder loop, one copy
      ;; wide, so an odd trip count still executes every index exactly once.
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              (compiler_ir_types.compiler-ir-global-shared-view merge)
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        5]
      ;; Idempotent: a second pass finds nothing left to rewrite.
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view idempotent))
            5))
        6]
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              (compiler_ir_types.compiler-ir-global-shared-view idempotent)
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            2))
        7]
      ;; Nearest refusal: one memory operation outside every body whitelist.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count refused) 3)) 8]
      [(compiler_optimize.opt-unroll-body-load-store-instr-ok?
          (compiler_ir_types.CompilerIrInstr.CopyBytes
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 6)
            8))
        9]
      ;; The other boundary of the class: a vector instruction keeps its body
      ;; on the store-free SIMD admission and the gang unroller, never here,
      ;; even though the scalar whitelist admits it store-free.
      [(compiler_optimize.opt-unroll-body-load-store-instr-ok?
          (compiler_ir_types.CompilerIrInstr.VectorLoad
            5
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 3)
            4
            (compiler_ast_types.AstType.I64)))
        15]
      [(not
          (compiler_optimize.opt-unroll-body-instr-ok?
            (compiler_ir_types.CompilerIrInstr.VectorLoad
              5
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 3)
              4
              (compiler_ast_types.AstType.I64))))
        16]
      ;; The other side of the factor table: a store-only body keeps sixteen.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view fill-func))))
        10]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view fill))
            5))
        11]
      [(not
          (=
            (opt-unroll-test-count-store-ptr-in-block
              (compiler_ir_types.compiler-ir-global-shared-view fill)
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            16))
        12]
      [(not (= (compiler_optimize.opt-unroll-group-copies) 16)) 13]
      [(not (= (compiler_optimize.opt-unroll-load-store-group-copies) 2)) 14]
      ;; A still-checked merge body is not a fast clone: unrolling it would
      ;; duplicate the check AND pre-empt the versioner that removes it.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count checked) 3)) 17]
      [(compiler_optimize.opt-unroll-body-load-store-instr-ok?
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body__bounds_ok.0")))
        18]
      ;; ... while the store-free class still admits exactly that check.
      [(not
          (compiler_optimize.opt-unroll-body-instr-ok?
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "body__bounds_ok.0"))))
        19]
      [else 42])))

(define (compiler-optimize-unroll-self-test) : i64
  (let
    [func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-test-function (opt-unroll-test-blocks 1)))]
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view func))]
    [nonunit-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-test-function (opt-unroll-test-blocks 2)))]
    [nonunit : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view nonunit-func))]
    [vector-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-vector-test-function))]
    [vector-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view vector-func))]
    [mutable-vector-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-vector-test-function false))]
    [mutable-vector-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view mutable-vector-func))]
    [store-required-input : compiler_ir_types.CompilerIrFunction
      (opt-unroll-mutable-vector-test-function false)]
    [store-required-func : compiler_ir_types.CompilerIrFunction
      (match (compiler_optimize.opt-unroll-simd-function-with-context-result
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.opt-cfg-context-build
          (compiler_optimize.opt-function-blocks
            (compiler_optimize.compiler-opt-global-shared-view
              store-required-input)))
        store-required-input
        true)
        [(compiler_optimize.OptFunctionCtxResult.Result result _) result])]
    [local-base-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-vector-test-function true))]
    [local-base-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view local-base-func))]
    [map-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 0))]
    [map-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view map-func))]
    [alias-map-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 1))]
    [alias-map-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view alias-map-func))]
    [local-store-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 2))]
    [local-store-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view local-store-func))]
    [bad-store-index-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-unroll-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 3))]
    [bad-store-index-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view bad-store-index-func))]
    [pipeline-map-func : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-unroll-mutable-map-test-function 0))]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view func))))
        1]
      ;; entry, guard, unrolled body, remainder loop, exit.
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view out))
            5))
        2]
      ;; sixteen acc adds + sixteen counter adds.
      [(<
          (opt-unroll-test-count-add-in-block
            (compiler_ir_types.compiler-ir-global-shared-view out)
            (compiler_ir_types.compiler-ir-label "body__unroll_body"))
          32)
        3]
      ;; a non-unit counter step is not canonical: blocks stay untouched.
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view nonunit))
            3))
        4]
      ;; Bounds-check labels must remain unique at the sixteen-copy factor.
      [(not (string.eq (compiler_optimize.opt-unroll-copy-suffix 15) "__u15"))
        5]
      [(string.eq
          (compiler_optimize.opt-unroll-copy-suffix 3)
          (compiler_optimize.opt-unroll-copy-suffix 15))
        6]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view vector-func))))
        7]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view vector-out))
            5))
        8]
      ;; Eight admitted SIMD instructions across all sixteen body copies.
      [(not
          (=
            (opt-unroll-test-count-vector-in-block
              vector-out
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            128))
        9]
      ;; Store-bearing SIMD loops remain outside this unroller.
      [(compiler_optimize.opt-unroll-body-instr-ok?
          (compiler_ir_types.ir-instr-vector-store
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.Var 10)
            4
            (compiler_ast_types.AstType.I64)))
        10]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function mutable-vector-func)))
        11]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view
                mutable-vector-out))
            6))
        12]
      ;; Three vector instructions across all sixteen mutable body copies.
      [(not
          (=
            (opt-unroll-test-count-vector-in-block
              mutable-vector-out
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            48))
        13]
      ;; A base defined inside the loop cannot feed the shared pre-body Gep.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function local-base-func)))
        14]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view local-base-out))
            3))
        15]
      ;; A store-bearing three-base map gets sixteen sequential gang copies.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function map-func)))
        16]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view map-out))
            6))
        17]
      [(not
          (=
            (opt-unroll-test-count-vector-in-block
              (compiler_optimize.compiler-opt-global-shared-view map-out)
              (compiler_ir_types.compiler-ir-label "body__unroll_body"))
            64))
        18]
      [(not
          (=
            (opt-unroll-test-count-in-block
              (compiler_optimize.compiler-opt-global-shared-view map-out)
              (compiler_ir_types.compiler-ir-label "body__unroll_body")
              true)
            16))
        19]
      [(not
          (=
            (opt-unroll-test-count-in-block
              map-out
              (compiler_ir_types.compiler-ir-label "body__unroll_body")
              false)
            3))
        20]
      ;; Exact duplicate bases deduplicate their group Gep. Runtime aliases
      ;; between distinct parameters are still safe because copies stay ordered.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function alias-map-func)))
        21]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view alias-map-out))
            6))
        22]
      [(not
          (=
            (opt-unroll-test-count-in-block
              (compiler_optimize.compiler-opt-global-shared-view alias-map-out)
              (compiler_ir_types.compiler-ir-label "body__unroll_body")
              true)
            16))
        23]
      [(not
          (=
            (opt-unroll-test-count-in-block
              alias-map-out
              (compiler_ir_types.compiler-ir-label "body__unroll_body")
              false)
            1))
        24]
      ;; Loop-local bases and noncanonical store indices remain rejected.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function local-store-func)))
        25]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view local-store-out))
            3))
        26]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function bad-store-index-func)))
        27]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view
                bad-store-index-out))
            3))
        28]
      [(not
          (compiler_optimize.opt-unroll-simd-body-instr-ok?
            (compiler_ir_types.ir-instr-vector-store
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 9)
              4
              (compiler_ast_types.AstType.I64))))
        29]
      [(compiler_optimize.opt-unroll-simd-body-instr-ok?
          (compiler_ir_types.ir-instr-predicated-store
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 9)
            (compiler_ir_types.CompilerIrValue.Var 6)
            4
            (compiler_ast_types.AstType.I64)))
        30]
      [(compiler_optimize.opt-unroll-simd-body-instr-ok?
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 9)
            (compiler_ast_types.AstType.I64)))
        31]
      ;; The main pipeline must run this mutable-only path before register-value
      ;; SSA.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-final-function
              (compiler_optimize.compiler-opt-global-shared-view
                pipeline-map-func))))
        32]
      ;; Later CFG cleanup may merge the generated label, but it never shrinks
      ;; the virtual-register frame allocated by the sixteen-copy rewrite.
      [(not
          (>
            (compiler_optimize.opt-function-frame
              (compiler_optimize.compiler-opt-global-shared-view
                pipeline-map-func))
            11))
        33]
      ;; The speculative pre-SSA path is store-bearing only. Store-free
      ;; reductions retain their established later-pipeline handling.
      [(not
          (=
            (compiler_optimize.opt-function-frame
              (compiler_optimize.compiler-opt-global-shared-view
                store-required-func))
            10))
        34]
      [(compiler_optimize.opt-unroll-simd-body-instr-ok?
          (compiler_ir_types.ir-instr-predicated-load
            8
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Bool true)
            4
            (compiler_ast_types.AstType.I64)))
        35]
      [else 42])))

;; --- bounds-check loop versioning self-test ------------------------------------
(define (opt-bce-version-test-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "n"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "len"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "base"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

;; entry -> loop (i phi, acc phi, bounds check, acc += i, i += 1) -> exit
;; (acc merged through an exit phi). Variant 0 checks the unrelated ADD result
;; and is underivable; 1 checks i directly; 2 checks i*3; 3 checks i-2; 4
;; checks i*(-3), whose decreasing/wrapping range must remain underivable; and
;; 5 checks a strength-reduced derived phi that starts at 1 and steps by 3.
;; Variants 6-13 cover the strided variable-base forms: 6 checks base+2*i
;; (Mul form) and 7 does the same with a StorePtr body; 8 checks base+dphi
;; and 9 checks (base+dphi)+1, where dphi is a derived phi stepping by 2
;; (the shape induction lowering leaves for base+2*i); 10 adds a second,
;; underivable data check that must STAY in the fast clone (partial
;; versioning); 11 gives the strided offset INT64_MIN (rejects), 12 scales by
;; -2 (rejects), 13 scales by 0 (rejects), 14 checks base+i directly, and 15
;; gives the base an in-loop definition (rejects) -- the non-invariant-base
;; form can never prove invariance, while 14's LONE scale-1 check clears the
;; re-costed guard-economics gate (one eliminable check). Variant 16 is 14's
;; two-check twin: base+i AND base+i+1, which version through the same
;; no-division scale-1 guard. Variants 17-25 stride the counter by 8 (the
;; word-loader shape): 17 is 16's twin and versions (the guard gains the step-k
;; no-wrap condition `wrap(bound + step - 1) >= bound`), 18 is 14's lone-check
;; twin and versions under the re-costed gate, 19 checks the step-8 counter
;; directly (the plain counter case, `bound <= len`), 20 keeps the step-8
;; stride but compares against an in-loop definition -- a non-loop-invariant
;; bound still refuses -- and 21 is a THREE-member scale-1 fan (base+i, +1, +2)
;; whose guard must cost exactly what 17's two-member fan costs. Variants
;; 22-23 are the step refusals (a zero step and a non-literal one), and
;; 24-25 are the no-wrap condition's literal-bound boundary: 24's bound of
;; 100 satisfies the cap at compile time and emits no condition, while 25's
;; i64-MAX bound can never satisfy it and rejects the versioning outright.
;; Variants 26-33 cover the guard algebra and the decreasing index forms:
;; 26 checks `base - i` (the reversed-copy shape) and versions through the
;; MIRRORED conditions with no division at all; 27 gives that form's strided
;; side an i64-MIN offset, whose negation is not representable, and rejects;
;; 28 is a bare derived phi read at TWO offsets with no variable base, which
;; collapses to one derived family; 29 is a scale-2 variable-base fan with
;; kmin < 0 (`base+2i-1` and `base+2i+1`), which collapses to one quotient
;; and one extra minimum compare; 30 checks the counter against a length that
;; IS the loop bound, so the family's `bound <= len` conjunct is reflexive and
;; must not be emitted; 31 makes both the bound and the length the same
;; literal, so EVERY conjunct folds and the guard states a literal `true`;
;; 32-33 are the once-only pair, whose two signed compares merge into one
;; unsigned `seed <u bound` exactly when the bound is a container length --
;; 32 loads its bound from a length slot, 33 takes the same shape's bound from
;; a plain parameter and keeps both compares. Variants 34-35 are the word-loader
;; extremal family `base+i` and `base+i+7` on a step-8 counter: 34 checks
;; against a container length, whose guard implies the counter's no-wrap cap;
;; 35 uses an arbitrary signed length and must keep the explicit cap. 36 is
;; 34's single-point twin -- one `base + i` check against the same container
;; length -- which still takes the normal form because nothing else checks that
;; base; 37 adds a SECOND single-point family over the SAME base against a
;; second container length, which shares the signed `base >= 0` and therefore
;; keeps the signed chain.
(define (opt-bce-version-test-check-tail [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [check-length : compiler_ir_types.CompilerIrValue
      (if (or (= variant 34) (= variant 36) (= variant 37))
        (compiler_ir_types.CompilerIrValue.Var 15)
        (compiler_ir_types.CompilerIrValue.Var 1))]
    [after-check : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          6
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 3)
          ;; Variants 17+ stride the counter by 8 (the word-loader shape);
          ;; 22 steps by 0 and 23 by a non-literal, both of which the shape
          ;; scan must refuse.
          (cond
            [(= variant 23) (compiler_ir_types.CompilerIrValue.Var 0)]
            [(= variant 22) (compiler_ir_types.CompilerIrValue.I64 0)]
            [(or
                (and (>= variant 17) (<= variant 25))
                (= variant 34)
                (= variant 35))
              (compiler_ir_types.CompilerIrValue.I64 8)]
            [else (compiler_ir_types.CompilerIrValue.I64 1)])
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          7
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 6)
          ;; Variant 20 compares against an in-loop definition: the bound is
          ;; not loop-invariant and the shape scan must refuse. Variants
          ;; 24-25 use a LITERAL bound, which folds the no-wrap condition at
          ;; compile time (24 satisfies the cap, 25 cannot).
          (cond
            [(= variant 20) (compiler_ir_types.CompilerIrValue.Var 5)]
            [(or (= variant 24) (= variant 31))
              (compiler_ir_types.CompilerIrValue.I64 100)]
            [(= variant 25)
              (compiler_ir_types.CompilerIrValue.I64 9223372036854775807)]
            ;; 32's bound is the length-slot load the entry block makes.
            [(= variant 32) (compiler_ir_types.CompilerIrValue.Var 15)]
            [else (compiler_ir_types.CompilerIrValue.Var 0)])
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 7)
          (compiler_ir_types.compiler-ir-label "loop")
          (compiler_ir_types.compiler-ir-label "done")))]
    [check : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs-with-tail
        (cond
          ;; 7 stores through the checked index.
          [(= variant 7)
            (opt-test-instrs-with-tail
              after-check
              (compiler_ir_types.CompilerIrInstr.StorePtr
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.CompilerIrValue.Var 9)
                (compiler_ast_types.AstType.I64)))]
          ;; 10's second check is data-shaped (a product of two in-loop
          ;; values): underivable, so it must stay in the fast clone.
          [(= variant 10)
            (opt-test-instrs-with-tail
              after-check
              (compiler_ir_types.CompilerIrInstr.BoundsCheck
                (compiler_ir_types.CompilerIrValue.Var 15)
                (compiler_ir_types.compiler-ir-global-shared-view check-length)
                (compiler_ir_types.compiler-ir-label "bce_version_ok_data")))]
          ;; 16's second check is `base + i + 1`: a SECOND eliminable
          ;; scale-1 variable-base index, which is what clears the gate.
          ;; 17 is 16's step-8 twin.
          [(or (= variant 16) (= variant 17))
            (opt-test-instrs-with-tail
              after-check
              (compiler_ir_types.CompilerIrInstr.BoundsCheck
                (compiler_ir_types.CompilerIrValue.Var 11)
                (compiler_ir_types.compiler-ir-global-shared-view check-length)
                (compiler_ir_types.compiler-ir-label "bce_version_ok_second")))]
          ;; 28's second check reads the SAME derived phi two slots along, and
