  [index : compiler_optimize.OptCfgIndex]
  [blocks : compiler_optimize.OptSsaVarBlocks (:consume)]
  [label : i64]
  [var : i64]) : compiler_optimize.OptSsaVarBlocks
  (if (> var 9)
