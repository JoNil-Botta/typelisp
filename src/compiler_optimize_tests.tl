(define (opt-blocks-binop-lhs-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [value : i64 (opt-copy-binop-lhs-var-instr-seq instrs dst)]
            (if (= value (- 0 1))
              (opt-blocks-binop-lhs-var (__tl-box-place rest) dst fallback)
              value))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-blocks-binop-lhs-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        fallback)]))

(define (opt-blocks-mov-src-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
