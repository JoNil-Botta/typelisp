(define (opt-load-cse-barrier-blocked?
  [barrier : compiler_ir_types.CompilerIrInstr]) : bool
  (let
    [optimized : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-barrier-instrs barrier))]
    (and
      (= (opt-count-load-instr-seq optimized) 2)
      (= (opt-count-mov-dst-instr-seq optimized 3) 0))))

;; GAP4: store-to-load forwarding -- the load after the store becomes a Mov of
;; the stored literal (and the pre-store entry is provably dropped: the Mov's
;; source is 9, not var 2).
(define (opt-load-cse-store-forward-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

;; Sub-word constant stores forward only after normalizing to the load type.
(define (opt-load-cse-subword-const-forward-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 4)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.Bool))))

;; A value read by a same-type sub-word load is canonical and can be forwarded.
(define (opt-load-cse-subword-load-forward-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.Load
