    (not
      (compiler_optimize.opt-ssa-register-value-type?
        (compiler_ast_types.AstType.Var (opt-test-symbol "SsaBoundaryVar"))))
    (not
      (compiler_optimize.opt-ssa-register-value-type?
        (compiler_ast_types.ast-ty-var-args
          (opt-test-symbol "SsaBoundaryVarArgs")
          (compiler_ast_types.ast-lifetime-list-new))))))

(define (opt-ssa-representation-index-for-functions
  [functions : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrRepresentationIndex
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    (compiler_ir_types.compiler-ir-representation-index-build
      bases
      (compiler_ir_types.CompilerIrProgram.Program
        (compiler_ir_types.compiler-ir-global-seq-empty)
        functions
        (compiler_ir_types.compiler-ir-extern-seq-empty)))))

(define (opt-ssa-representation-index-for-function
  [func : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrRepresentationIndex
  (opt-ssa-representation-index-for-functions
    (compiler_ir_types.compiler-ir-function-seq-prepend
      func
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-ssa-representation-group-evidence-function
  [ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "ssa_representation_group_evidence")
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.Unit)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Pack
            0
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ir_types.compiler-ir-value-seq-prepend
                (compiler_ir_types.CompilerIrValue.I64 2)
                (compiler_ir_types.compiler-ir-value-seq-empty)))
            ty)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.No))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-ssa-representation-aware-diamond-ok?
  [ty : compiler_ast_types.AstType]
  [representations : compiler_ir_types.CompilerIrRepresentationIndex]) : bool
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function-with-representations
        bases
        (compiler_ir_types.compiler-ir-global-shared-view representations)
        (opt-ssa-fixed-handle-diamond-function
          (compiler_ir_types.compiler-ir-global-shared-view ty)))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view out))]
    (and
      (compiler_optimize.opt-verify-ok?
        (compiler_optimize.opt-verify-function
          (compiler_optimize.compiler-opt-global-shared-view out)))
      (=
        (opt-count-phi-blocks
          (compiler_ir_types.compiler-ir-global-shared-view blocks))
        1)
      (=
        (opt-count-mov-dst-blocks
          (compiler_ir_types.compiler-ir-global-shared-view blocks)
          3)
        0)
      (opt-phi-types-match-blocks?
        bases
        (compiler_ir_types.compiler-ir-global-shared-view blocks)
        ty))))

(define (opt-ssa-representation-aware-loop-ok?
  [ty : compiler_ast_types.AstType]
  [representations : compiler_ir_types.CompilerIrRepresentationIndex]) : bool
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function-with-representations
        bases
        (compiler_ir_types.compiler-ir-global-shared-view representations)
        (opt-ssa-fixed-handle-loop-function
          (compiler_ir_types.compiler-ir-global-shared-view ty)))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view out))]
    (and
      (compiler_optimize.opt-verify-ok?
        (compiler_optimize.opt-verify-function
          (compiler_optimize.compiler-opt-global-shared-view out)))
      (=
        (opt-count-phi-blocks
          (compiler_ir_types.compiler-ir-global-shared-view blocks))
        1)
      (=
        (opt-count-mov-dst-blocks
          (compiler_ir_types.compiler-ir-global-shared-view blocks)
          3)
        0)
      (opt-phi-types-match-blocks?
        bases
        (compiler_ir_types.compiler-ir-global-shared-view blocks)
        ty))))

(define (opt-ssa-representation-aware-rejected?
  [func : compiler_ir_types.CompilerIrFunction]
  [representations : compiler_ir_types.CompilerIrRepresentationIndex]) : bool
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    (compiler_optimize.opt-function-eq
      bases
      (compiler_optimize.compiler-opt-global-shared-view func)
      (compiler_optimize.opt-ssa-construct-function-with-representations
        bases
        (compiler_ir_types.compiler-ir-global-shared-view representations)
        (compiler_optimize.compiler-opt-global-shared-view func)))))

(define (opt-ssa-over-budget-function) : compiler_ir_types.CompilerIrFunction
  (let
    [count : i64 (+ (compiler_optimize.opt-ssa-block-budget) 1)]
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
      (__tl_make-array compiler_ir_types.CompilerIrBlock count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label
                (str_cat.str-cat "ssa_budget_" (string.int->string index)))
              (compiler_ir_types.compiler-ir-instr-seq2
                (compiler_ir_types.CompilerIrInstr.Mov
                  0
                  (compiler_ir_types.CompilerIrValue.I64 index)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 0))))))
          (set! index (+ index 1))))
      (compiler_ir_types.CompilerIrFunction.Function
        (opt-test-symbol "ssa_over_budget")
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (compiler_ast_types.AstType.I64)
        1
        (compiler_ir_types.CompilerIrBlockList.Array
          (compiler_ir_types.CompilerIrBlockSeq slots count))))))

(define (compiler-optimize-ssa-fixed-handle-self-test) : i64
  (let
    [func-ty : compiler_ast_types.AstType
      (compiler_ast_types.ast-ty-func
        (compiler_ast_types.ast-type-list-new)
        (compiler_ast_types.AstType.I64))]
    [array-ty : compiler_ast_types.AstType
      (compiler_ast_types.ast-ty-array (compiler_ast_types.AstType.I64) 2)]
    [dyn-array-ty : compiler_ast_types.AstType
      (compiler_ast_types.ast-ty-dyn-array (compiler_ast_types.AstType.I64))]
    [box-ty : compiler_ast_types.AstType
      (compiler_ast_types.ast-ty-box (compiler_ast_types.AstType.I64))]
    [nominal-ty : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Enum
        (opt-test-symbol "SsaRepresentationOneWord"))]
    [group-ty : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Struct
        (opt-test-symbol "SsaRepresentationGroup"))]
    [nominal-diamond : compiler_ir_types.CompilerIrFunction
      (opt-ssa-fixed-handle-diamond-function
        (compiler_ast_types.ast-global-shared-view nominal-ty))]
    [known-one : compiler_ir_types.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function
        (compiler_optimize.compiler-opt-global-shared-view nominal-diamond))]
    [group-diamond : compiler_ir_types.CompilerIrFunction
      (opt-ssa-fixed-handle-diamond-function
        (compiler_ast_types.ast-global-shared-view group-ty))]
    [group-index : compiler_ir_types.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-functions
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (compiler_optimize.compiler-opt-global-shared-view group-diamond)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-ssa-representation-group-evidence-function
              (compiler_ast_types.ast-global-shared-view group-ty))
            (compiler_ir_types.compiler-ir-function-seq-empty))))]
    [missing-index : compiler_ir_types.CompilerIrRepresentationIndex
      (compiler_ir_types.compiler-ir-representation-index-empty)]
    [nominal-address-taken : compiler_ir_types.CompilerIrFunction
      (opt-ssa-fixed-handle-address-taken-function
        (compiler_ast_types.ast-global-shared-view nominal-ty))]
    [nominal-address-index : compiler_ir_types.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function
        (compiler_optimize.compiler-opt-global-shared-view
          nominal-address-taken))]
    [nominal-unsupported : compiler_ir_types.CompilerIrFunction
      (opt-ssa-fixed-handle-unsupported-dst-function
        (compiler_ast_types.ast-global-shared-view nominal-ty))]
    [nominal-unsupported-index : compiler_ir_types.CompilerIrRepresentationIndex
      (opt-ssa-representation-index-for-function
        (compiler_optimize.compiler-opt-global-shared-view nominal-unsupported))]
    [over-budget : compiler_ir_types.CompilerIrFunction
      (opt-ssa-over-budget-function)]
    [over-budget-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view over-budget))]
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [address-taken : compiler_ir_types.CompilerIrFunction
      (opt-ssa-fixed-handle-address-taken-function
        (compiler_ast_types.ast-global-shared-view box-ty))]
    [address-taken-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view address-taken))]
    [unsupported-dst : compiler_ir_types.CompilerIrFunction
      (opt-ssa-fixed-handle-unsupported-dst-function
        (compiler_ast_types.ast-global-shared-view dyn-array-ty))]
    [unsupported-dst-out : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view unsupported-dst))]
    (cond
      [(not (opt-ssa-fixed-handle-boundary-ok?)) 1]
      [(not
          (opt-ssa-fixed-handle-diamond-ok? (compiler_ast_types.AstType.String)))
        2]
      [(not (opt-ssa-fixed-handle-diamond-ok? (compiler_ast_types.AstType.Str)))
        3]
      [(not
          (opt-ssa-fixed-handle-diamond-ok?
            (compiler_ast_types.ast-global-shared-view func-ty)))
        4]
      [(not
          (opt-ssa-fixed-handle-diamond-ok?
            (compiler_ast_types.ast-global-shared-view array-ty)))
        5]
      [(not
          (opt-ssa-fixed-handle-diamond-ok?
            (compiler_ast_types.ast-global-shared-view dyn-array-ty)))
        6]
      [(not
          (opt-ssa-fixed-handle-diamond-ok?
            (compiler_ast_types.ast-global-shared-view box-ty)))
        7]
      [(not (opt-ssa-fixed-handle-loop-ok? (compiler_ast_types.AstType.String)))
        8]
      [(not
          (opt-ssa-fixed-handle-loop-ok?
            (compiler_ast_types.ast-global-shared-view func-ty)))
        9]
      [(not
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            address-taken
            address-taken-out))
        10]
      [(not
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            unsupported-dst
            unsupported-dst-out))
        11]
      [(not
          (compiler_optimize.opt-ssa-register-value-type-with-representations?
            bases
            (compiler_optimize.compiler-opt-global-shared-view known-one)
            (compiler_ast_types.ast-global-shared-view nominal-ty)))
        12]
      [(compiler_optimize.opt-ssa-register-value-type-with-representations?
          bases
          (compiler_optimize.compiler-opt-global-shared-view group-index)
          (compiler_ast_types.ast-global-shared-view group-ty))
        13]
      [(compiler_optimize.opt-ssa-register-value-type-with-representations?
          bases
          (compiler_optimize.compiler-opt-global-shared-view missing-index)
          (compiler_ast_types.ast-global-shared-view nominal-ty))
        14]
      [(compiler_optimize.opt-ssa-register-value-type-with-representations?
          bases
          (compiler_optimize.compiler-opt-global-shared-view known-one)
          (compiler_ast_types.AstType.Var
            (opt-test-symbol "SsaRepresentationVar")))
        15]
      [(compiler_optimize.opt-ssa-register-value-type-with-representations?
          bases
          (compiler_optimize.compiler-opt-global-shared-view known-one)
          (compiler_ast_types.ast-ty-var-args
            (opt-test-symbol "SsaRepresentationVarArgs")
            (compiler_ast_types.ast-lifetime-list-new)))
        16]
      [(not
          (opt-ssa-representation-aware-diamond-ok?
            (compiler_ast_types.ast-global-shared-view nominal-ty)
            (compiler_optimize.compiler-opt-global-shared-view known-one)))
        17]
      [(not
          (opt-ssa-representation-aware-loop-ok?
            (compiler_ast_types.ast-global-shared-view nominal-ty)
            (compiler_optimize.compiler-opt-global-shared-view known-one)))
        18]
      [(not
          (opt-ssa-representation-aware-rejected?
            group-diamond
            (compiler_optimize.compiler-opt-global-shared-view group-index)))
        19]
      [(not
          (opt-ssa-representation-aware-rejected?
            nominal-diamond
            (compiler_optimize.compiler-opt-global-shared-view missing-index)))
        20]
      [(not
          (opt-ssa-representation-aware-rejected?
            nominal-address-taken
            nominal-address-index))
        21]
      [(not
          (opt-ssa-representation-aware-rejected?
            nominal-unsupported
            nominal-unsupported-index))
        22]
      [(not
          (compiler_optimize.opt-function-eq bases over-budget over-budget-out))
        23]
      [else 42])))

;; The raw tail-recursion-to-loop shape targets the function ENTRY block and its
;; latch reassigns a parameter. SSA construction must decline that raw form (a
;; phi cannot see the implicit function-entry edge). Tailrec production first
;; adds an explicit entry preheader; the paired fixture below must then construct
;; a valid typed loop phi.
(define (opt-ssa-entry-backedge-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "index"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "count"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-ssa-entry-backedge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "body")
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "body")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "entry"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 0)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-ssa-entry-backedge-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "ssa_entry_backedge")
    (opt-ssa-entry-backedge-params)
    (compiler_ast_types.AstType.I64)
    4
    (opt-ssa-entry-backedge-blocks)))

(define (opt-ssa-entry-backedge-preheader-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "ssa_entry_backedge_preheader")
    (opt-ssa-entry-backedge-params)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_optimize.opt-ssa-explicit-entry-blocks
      (opt-ssa-entry-backedge-blocks))))

(define (opt-natural-loop-nested-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "outer"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "outer")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "inner"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "inner")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.compiler-ir-label "inner-body")
              (compiler_ir_types.compiler-ir-label "outer-latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "inner-body")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "inner"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "outer-latch")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 8)
                  (compiler_ir_types.compiler-ir-label "outer")
                  (compiler_ir_types.compiler-ir-label "exit"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 0)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-natural-loop-irreducible-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "left")
          (compiler_ir_types.compiler-ir-label "right"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "left")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "right"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Bool true)
              (compiler_ir_types.compiler-ir-label "left")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-natural-loop-no-preheader-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "pre-one")
          (compiler_ir_types.compiler-ir-label "pre-two"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "pre-one")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "pre-two")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "loop")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Bool true)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "body")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "loop"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 0)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-natural-loop-multi-backedge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "left")
            (compiler_ir_types.compiler-ir-label "right"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "left")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "right")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "loop"))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-natural-loop-maybe-body-count
  [maybe : compiler_optimize.OptMaybeNaturalLoop]) : i64
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) 0]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (compiler_optimize.opt-label-count
        (compiler_optimize.opt-natural-loop-body loop))]))

(define (opt-natural-loop-maybe-body-block-count
  [maybe : compiler_optimize.OptMaybeNaturalLoop]) : i64
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) 0]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (compiler_ir_types.compiler-ir-block-list-count
        (compiler_optimize.opt-natural-loop-body-blocks loop))]))

(define (opt-natural-loop-maybe-body-contains?
  [maybe : compiler_optimize.OptMaybeNaturalLoop]
  [label : i64]) : bool
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) false]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (compiler_optimize.opt-label-contains
        (compiler_optimize.opt-natural-loop-body loop)
        label)]))

(define (opt-natural-loop-maybe-body-contains-id?
  [index : compiler_optimize.OptCfgIndex]
  [maybe : compiler_optimize.OptMaybeNaturalLoop]
  [label : i64]) : bool
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) false]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (match (compiler_optimize.opt-cfg-index-id index label)
        [(option_i64.Some id)
          (compiler_optimize.opt-natural-loop-body-contains-id? loop id)]
        [(option_i64.None) false])]))

(define (opt-natural-loop-maybe-body-block-label-at?
  [maybe : compiler_optimize.OptMaybeNaturalLoop]
  [index : i64]
  [label : i64]) : bool
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) false]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (opt-block-list-label-at?
        (compiler_optimize.opt-natural-loop-body-blocks loop)
        index
        label)]))

(define (opt-natural-loop-maybe-preheader-label?
  [maybe : compiler_optimize.OptMaybeNaturalLoop]
  [label : i64]) : bool
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) false]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (match (compiler_optimize.opt-natural-loop-preheader loop)
        [(compiler_optimize.OptLoopPreheader.Some actual) (= actual label)]
        [(compiler_optimize.OptLoopPreheader.No) false])]))

(define (opt-natural-loop-maybe-no-preheader?
  [maybe : compiler_optimize.OptMaybeNaturalLoop]) : bool
  (match maybe
    [(compiler_optimize.OptMaybeNaturalLoop.No) false]
    [(compiler_optimize.OptMaybeNaturalLoop.Some loop)
      (match (compiler_optimize.opt-natural-loop-preheader loop)
        [(compiler_optimize.OptLoopPreheader.No) true]
        [(compiler_optimize.OptLoopPreheader.Some _) false])]))

(define (opt-loop-rotation-top-test-blocks [constant-edge? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (if constant-edge?
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.compiler-ir-label "exit"))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop")))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              1
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-loop-rotation-false-body-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "exit")
            (compiler_ir_types.compiler-ir-label "body"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              1
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-loop-rotation-successors?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]
  [left : i64]
  [right : i64]) : bool
  (let
    [successors : compiler_optimize.OptLabelSet
      (compiler_optimize.opt-cfg-index-successors
        (compiler_optimize.opt-cfg-index-build blocks)
        label)]
    (and
      (=
        (compiler_optimize.opt-label-count
          (compiler_optimize.compiler-opt-global-shared-view successors))
        2)
      (compiler_optimize.opt-label-contains
        (compiler_optimize.compiler-opt-global-shared-view successors)
        left)
      (compiler_optimize.opt-label-contains successors right))))

(define (opt-licm-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "lhs"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "rhs"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

(define (opt-licm-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "licm")
    (opt-licm-params)
    (compiler_ast_types.AstType.I64)
    16
    blocks))

(define (opt-licm-optimized-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-licm-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-licm-test-function
      (compiler_ir_types.compiler-ir-global-shared-view blocks))))

(define (opt-licm-late-optimized-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (let
    [func : compiler_ir_types.CompilerIrFunction
      (opt-licm-test-function
        (compiler_ir_types.compiler-ir-global-shared-view blocks))]
    (match (compiler_optimize.opt-licm-function-with-context-result-and-direct-call-clean
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (opt_i64_i64_map.with-capacity 1)
      (opt_i64_i64_map.with-capacity 1)
      (compiler_optimize.opt-global-cell-summary-empty)
      true
      func)
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

(define (opt-licm-array-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "array"
        (compiler_ast_types.AstType.DynArray 0)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "ptr"
          (compiler_ast_types.AstType.U64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

(define (opt-licm-array-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "licm_array")
    (opt-licm-array-params)
    (compiler_ast_types.AstType.I64)
    16
