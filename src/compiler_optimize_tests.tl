(define (compiler-optimize-float-fold-ok?) : bool
  (let
    [pos : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-float-fold-instrs))]
    [neg : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-float-fold-invalid-instrs))]
    [finite-casts : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-finite-cast-fold-instrs))]
    [deferred-casts : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-finite-cast-no-fold-instrs))]
    (and
      (= (opt-count-arith-instr-seq pos) 0)
      (= (opt-count-cast-instr-seq pos) 0)
      (opt-mov-dst-f64-bits? pos 41 (opt-test-f64-bits "3.75"))
      (opt-mov-dst-bool-value? pos 42 true)
      (opt-mov-dst-f64-bits? pos 43 (opt-test-f64-bits "-3.75"))
      (opt-mov-dst-f64-bits? pos 44 (opt-test-f32-bits "1.00000001"))
      (opt-mov-dst-f64-bits? pos 56 (opt-test-f64-bits "-0.0"))
      (= (opt-count-arith-instr-seq neg) 3)
      (= (opt-count-cast-instr-seq neg) 1)
      (= (opt-count-cast-instr-seq finite-casts) 0)
      (opt-mov-dst-f64-bits? finite-casts 46 (opt-test-f64-bits "-42.0"))
      (opt-mov-dst-f64-bits?
        finite-casts
        47
        (opt-test-f64-bits "18446744073709551616.0"))
      (opt-mov-dst-f64-bits?
        finite-casts
        48
        (opt-test-f32-bits "18446744073709551616.0"))
      (opt-mov-dst-f64-bits? finite-casts 49 (opt-test-f64-bits "65.0"))
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 50 999) 3)
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 51 999) (- 0 3))
      (= (opt-mov-dst-char-code finite-casts 52 0) 65)
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 53 999) 3)
      (opt-mov-dst-f64-bits? finite-casts 54 (opt-test-f32-bits "16777217.0"))
      (= (opt-mov-dst-i64-value-instr-seq finite-casts 55 999) (- 0 3))
      (= (opt-count-cast-instr-seq deferred-casts) 4))))

;; --- commutative constant-lhs canonicalisation --------------------------------
;;
;; The backend's immediate forms all key off an immediate RHS, so `K op x` and
;; `x op K` -- the same value -- lower to different instruction counts. These
;; fixtures pin which shapes move and, just as importantly, which do not.
;;
;;   C1 admitted : `2 + x`   -> `x + 2`
;;   C2 admitted : `3 * x`   -> `x * 3`      (the rest of the commutative set:
;;                 `7 & x`, `7 | x`, `7 ^ x` follow on dsts 3/4/5)
;;   C3 refused  : `x + 2` is already canonical -- untouched, which is also the
;;                 idempotence witness (the rule cannot oscillate).
;;   C4 refused  : `2 - x` -- Sub does not commute.
;;   C5 refused  : `2 << x` -- Shl does not commute (and its RHS is separately
;;                 typed).
;;   C6 admitted : `0 - x` on i64 -> `UnOp Neg x`, the one non-commutative
;;                 constant-lhs shape with a strictly better single-instruction
;;                 form.
;;   C7 refused  : `0 - x` on i32 -- the Neg rule is restricted to the 8-byte
;;                 integer types.
;;   C8 refused  : `2.0 + x` on f64 -- `addsd` propagates the FIRST operand's
;;                 NaN payload, so the swap is observable.
;;   C9 twin     : `0 - 5` is a literal pair, so the constant folder answers it
;;                 first and the result is `Mov -5`, exactly as before the rule
;;                 existed.
(define (opt-cc-var? [v : compiler_ir_types.CompilerIrValue] [id : i64]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.Var x) (= x id)]
    [_ false]))

(define (opt-cc-i64? [v : compiler_ir_types.CompilerIrValue] [k : i64]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.I64 x) (= x k)]
    [_ false]))

(define (opt-cc-f64? [v : compiler_ir_types.CompilerIrValue]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.F64 _) true]
    [_ false]))

(define (opt-cc-op-is? [op : compiler_ir_types.CompilerIrBinOp] [tag : i64]) : bool
  (=
    tag
    (match op
      [(compiler_ir_types.CompilerIrBinOp.Add) 1]
      [(compiler_ir_types.CompilerIrBinOp.Mul) 2]
      [(compiler_ir_types.CompilerIrBinOp.BitAnd) 3]
      [(compiler_ir_types.CompilerIrBinOp.BitOr) 4]
      [(compiler_ir_types.CompilerIrBinOp.BitXor) 5]
      [(compiler_ir_types.CompilerIrBinOp.Sub) 6]
      [(compiler_ir_types.CompilerIrBinOp.Shl _) 7]
      [_ 0])))

(define (opt-cc-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      1
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.I64 3)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.BitAnd)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      4
      (compiler_ir_types.CompilerIrBinOp.BitOr)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      5
      (compiler_ir_types.CompilerIrBinOp.BitXor)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      6
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      7
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      8
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      9
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      10
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I32))
    (compiler_ir_types.CompilerIrInstr.BinOp
      11
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.F64 (opt-test-f64-bits "2.0"))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.F64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      12
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.I64 5)
      (compiler_ast_types.AstType.I64))))

;; 0 when `instr` has the shape the rule prescribes for its dst, else the code
;; naming the case that broke.
(define (opt-cc-check-instr [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp dst op l r _)
      (cond
        [(= dst 1)
          (if (and (opt-cc-op-is? op 1) (opt-cc-var? l 0) (opt-cc-i64? r 2))
            0
            1)]
        [(= dst 2)
          (if (and (opt-cc-op-is? op 2) (opt-cc-var? l 0) (opt-cc-i64? r 3))
            0
            2)]
        [(= dst 3)
          (if (and (opt-cc-op-is? op 3) (opt-cc-var? l 0) (opt-cc-i64? r 7))
            0
            3)]
        [(= dst 4)
          (if (and (opt-cc-op-is? op 4) (opt-cc-var? l 0) (opt-cc-i64? r 7))
            0
            4)]
        [(= dst 5)
          (if (and (opt-cc-op-is? op 5) (opt-cc-var? l 0) (opt-cc-i64? r 7))
            0
            5)]
        [(= dst 6)
          (if (and (opt-cc-op-is? op 1) (opt-cc-var? l 0) (opt-cc-i64? r 2))
            0
            6)]
        [(= dst 7)
          (if (and (opt-cc-op-is? op 6) (opt-cc-i64? l 2) (opt-cc-var? r 0))
            0
            7)]
        [(= dst 8)
          (if (and (opt-cc-op-is? op 7) (opt-cc-i64? l 2) (opt-cc-var? r 0))
            0
            8)]
        [(= dst 9) 19]
        [(= dst 10)
          (if (and (opt-cc-op-is? op 6) (opt-cc-i64? l 0) (opt-cc-var? r 0))
            0
            10)]
        [(= dst 11)
          (if (and (opt-cc-op-is? op 1) (opt-cc-f64? l) (opt-cc-var? r 0))
            0
            11)]
        [(= dst 12) 22]
        [else 30])]
    [(compiler_ir_types.CompilerIrInstr.UnOp dst op src _)
      (cond
        [(= dst 9)
          (match op
            [(compiler_ir_types.CompilerIrUnOp.Neg)
              (if (opt-cc-var? src 0)
                0
                9)]
            [_ 9])]
        [else 31])]
    [(compiler_ir_types.CompilerIrInstr.Mov dst src _)
      (cond
        [(= dst 12)
          (if (opt-cc-i64? src (- 0 5))
            0
            12)]
        [else 32])]
    [_ 33]))

(define (opt-cc-check-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (let
      [code : i64
        (opt-cc-check-instr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))]
      (if (= code 0)
        (opt-cc-check-from instrs (+ index 1))
        code))))

(define (opt-cc-check [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-cc-check-from instrs 0))

(define (compiler-optimize-commute-constant-lhs-self-test) : i64
  (let
    [once : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-cc-instrs))]
    [twice : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        once)]
    (begin
      (unless (= (opt-cc-check once) 0) (return (opt-cc-check once)))
      ;; idempotence: the canonical form is a fixpoint of the same pass
      (unless (= (opt-cc-check twice) 0) (return (+ 40 (opt-cc-check twice))))
      42)))

(define (compiler-optimize-typed-fold-self-test) : i64
  (let
    [pos : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-typed-fold-instrs))]
    [neg : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-fold-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptConstEnv.Nil)
        (opt-typed-fold-invalid-instrs))]
    (begin
      (unless (= (opt-count-arith-instr-seq pos) 0) (return 1))
      (unless (= (opt-count-cast-instr-seq pos) 0) (return 3))
      (unless
        (= (opt-mov-dst-i64-value-instr-seq pos 2 (- 0 999)) 0)
        (return 4))
      (unless (opt-mov-dst-bool-value? pos 5 true) (return 5))
      (unless (opt-mov-dst-bool-value? pos 6 false) (return 6))
      (unless (= (opt-mov-dst-i64-value-instr-seq pos 7 0) 255) (return 7))
      (unless (= (opt-mov-dst-char-code pos 8 0) 44) (return 8))
      (unless (= (opt-mov-dst-i64-value-instr-seq pos 10 0) 65) (return 9))
      (unless (opt-mov-dst-bool-value? pos 12 false) (return 10))
      (unless (= (opt-mov-dst-i64-value-instr-seq pos 13 0) 7) (return 11))
      (unless (= (opt-mov-dst-i64-value-instr-seq pos 14 0) 1) (return 12))
      (unless (= (opt-mov-dst-i64-value-instr-seq pos 17 0) 8) (return 13))
      (unless
        (= (opt-mov-dst-i64-value-instr-seq pos 19 0) (- 0 4))
        (return 14))
      (unless (= (opt-mov-dst-i64-value-instr-seq pos 22 0) 1) (return 15))
      ;; An immediate is normalized with the shift's U8 RHS payload before
      ;; folding: 256 wraps to zero instead of being treated as an invalid
      ;; U64 count, preserving the all-ones U64 lhs.
      (unless
        (= (opt-mov-dst-i64-value-instr-seq pos 23 0) (- 0 1))
        (return 16))
      (unless (= (opt-count-arith-instr-seq neg) 4) (return 17))
      (unless (compiler_float.compiler-float-self-test) (return 18))
      (unless (compiler-optimize-float-fold-ok?) (return 19))
      (unless
        (and
          (match (compiler_optimize.opt-fold-unop
            (compiler_ir_types.CompilerIrUnOp.Sqrt)
            (compiler_optimize.OptKnownConst.SomeConst
              (compiler_ir_types.CompilerIrValue.F64 (opt-test-f64-bits "4.0"))
              (compiler_ast_types.AstType.F64))
            (compiler_ast_types.AstType.F64))
            [(compiler_ir_types.CompilerIrMaybeValue.No) true]
            [_ false])
          (match (compiler_optimize.opt-fold-unop
            (compiler_ir_types.CompilerIrUnOp.Sqrt)
            (compiler_optimize.OptKnownConst.SomeConst
              (compiler_ir_types.CompilerIrValue.F64 (opt-test-f32-bits "4.0"))
              (compiler_ast_types.AstType.F32))
            (compiler_ast_types.AstType.F32))
            [(compiler_ir_types.CompilerIrMaybeValue.No) true]
            [_ false]))
        (return 20))
      42)))

;; Positive strength-reduction cases: integer neutral/absorbing identities and
;; boolean `and`/`or` identities. The first instruction uses `AstType.U8` to prove
;; non-i64 integer result types keep their original type.
(define (opt-strength-self-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      10
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.BinOp
      11
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      12
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      13
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      14
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      15
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      16
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      17
      (compiler_ir_types.CompilerIrBinOp.And)
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      18
      (compiler_ir_types.CompilerIrBinOp.And)
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      19
      (compiler_ir_types.CompilerIrBinOp.And)
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ir_types.CompilerIrValue.Bool false)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      20
      (compiler_ir_types.CompilerIrBinOp.And)
      (compiler_ir_types.CompilerIrValue.Bool false)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      21
      (compiler_ir_types.CompilerIrBinOp.Or)
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ir_types.CompilerIrValue.Bool false)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      22
      (compiler_ir_types.CompilerIrBinOp.Or)
      (compiler_ir_types.CompilerIrValue.Bool false)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      23
      (compiler_ir_types.CompilerIrBinOp.Or)
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      24
      (compiler_ir_types.CompilerIrBinOp.Or)
      (compiler_ir_types.CompilerIrValue.Bool true)
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ast_types.AstType.Bool))))

;; Negative cases for edge-sensitive operations and non-identities: division,
;; modulo, shifts, and `0 - x` must stay as `BinOp`s.
(define (opt-strength-negative-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      30
      (compiler_ir_types.CompilerIrBinOp.Div)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      31
      (compiler_ir_types.CompilerIrBinOp.Mod)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      32
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      33
      (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      34
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

;; Returns 42 when every positive identity is rewritten to `Mov`, the typed U8
;; identity keeps its result type, and the negative cases stay untouched.
(define (compiler-optimize-strength-self-test) : i64
  (let
    [pos : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-strength-instrs
        (compiler_optimize.OptConstEnv.Nil)
        (opt-strength-self-test-instrs))]
    [neg : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-strength-instrs
        (compiler_optimize.OptConstEnv.Nil)
        (opt-strength-negative-instrs))]
    (cond
      [(not (= (opt-count-arith-instr-seq pos) 0)) 1]
      [(not (= (opt-sum-mov-var-src pos) 49)) 2]
      [(not (= (opt-count-mov-i64-value-instr-seq pos 0) 2)) 3]
      [(not (= (opt-count-mov-bool-value pos false) 2)) 4]
      [(not (= (opt-count-mov-bool-value pos true) 2)) 5]
      [(not
          (=
            (opt-mov-dst-type-tag pos 10)
            (compiler_ast_types.ast-type-tag (compiler_ast_types.AstType.U8))))
        6]
      [(not (= (opt-count-arith-instr-seq neg) 5)) 7]
      [else 42])))

;; Builds `[Mov v0=99 (unused), Call v1 = noop(), Pack v2 (unused), Return v1]`.
;; `v0` and `v2` are dead pure temporaries; `v1` is produced by a side-effecting
;; call and used by the return, so DCE must drop only the pure temporaries
;; (4 instrs -> 2).
(define (opt-dce-self-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 99)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      1
      (opt-test-symbol "noop")
      (compiler_ir_types.CompilerIrCallArgs.Nil)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Pack
      2
      (compiler_ir_types.compiler-ir-value-seq-prepend
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ir_types.compiler-ir-value-seq-prepend
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ir_types.compiler-ir-value-seq-empty)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 1)))))

(define (opt-dce-isolated-unused-alloc-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.No))))

(define (opt-dce-used-alloc-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.AddrOf 1 0)
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 1)))))

(define (opt-dce-alloc-run-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Alloc 0 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Alloc 1 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Alloc 2 (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.No))))

(define (opt-dce-clean-list-count
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (let
    [used : opt_i64_i64_map.Map
      (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) instrs)]
    [cleaned : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs used instrs)]
    (compiler_ir_types.compiler-ir-instr-seq-count cleaned)))

(define (opt-dce-clean-array-count
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (let
    [block : compiler_ir_types.CompilerIrBlock
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        instrs)]
    [used : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array
        64
        (compiler_ir_types.compiler-ir-block-cons
          block
          compiler_ir_types.CompilerIrBlockList.Nil))]
    [cleaned : compiler_ir_types.CompilerIrBlock
      (compiler_optimize.opt-dce-block-array used block)]
    (match cleaned
      [(compiler_ir_types.CompilerIrBlock.Block _ cleaned-instrs)
        (compiler_ir_types.compiler-ir-instr-seq-count cleaned-instrs)])))

(define (compiler-optimize-dce-alloc-self-test) : i64
  (let
    [isolated : compiler_ir_types.CompilerIrInstrSeq
      (opt-dce-isolated-unused-alloc-instrs)]
    [used : compiler_ir_types.CompilerIrInstrSeq (opt-dce-used-alloc-instrs)]
    [run : compiler_ir_types.CompilerIrInstrSeq (opt-dce-alloc-run-instrs)]
    (cond
      [(not (= (opt-dce-clean-list-count isolated) 1)) 1]
      [(not (= (opt-dce-clean-list-count used) 3)) 2]
      [(not (= (opt-dce-clean-list-count run) 4)) 3]
      [(not (= (opt-dce-clean-array-count isolated) 1)) 4]
      [(not (= (opt-dce-clean-array-count used) 3)) 5]
      [(not (= (opt-dce-clean-array-count run) 4)) 6]
      [else 42])))

;; Forward block order sees v0 before the later dead v1 that uses it. One DCE
;; sweep drops v1 too late to revisit v0; the fixed-point driver must recollect
;; uses and remove v0 on its second sweep.
(define (opt-dce-cross-block-chain) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "exit")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.No))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; Returns 42 when DCE keeps the used call result `v1` and the side-effecting
;; instructions, drops the unused `v0`, and is idempotent on a second pass.
(define (compiler-optimize-dce-self-test) : i64
  (let
    [instrs : compiler_ir_types.CompilerIrInstrSeq (opt-dce-self-test-instrs)]
    [used : opt_i64_i64_map.Map
      (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) instrs)]
    [cleaned : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs used instrs)]
    [again : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs
        (opt-test-collect-instrs-uses
          (opt_i64_i64_map.with-capacity 64)
          cleaned)
        cleaned)]
    [unused-word-dead : bool
      (compiler_optimize.opt-instr-dead?
        (opt_i64_i64_map.with-capacity 4)
        (compiler_ir_types.CompilerIrInstr.Word
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          0
          (compiler_ast_types.AstType.I64)))]
    [dead-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instr-seq-copy instrs))
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [dead-result : compiler_optimize.OptBlockListPassResult
      (compiler_optimize.opt-dce-block-list-array-pass
        (compiler_optimize.opt-collect-blocks-uses-array 8 dead-blocks)
        dead-blocks)]
    [live-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          cleaned)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [live-result : compiler_optimize.OptBlockListPassResult
      (compiler_optimize.opt-dce-block-list-array-pass
        (compiler_optimize.opt-collect-blocks-uses-array 8 live-blocks)
        live-blocks)]
    [cross-blocks : compiler_ir_types.CompilerIrBlockList
      (opt-dce-cross-block-chain)]
    [cross-once : compiler_ir_types.CompilerIrBlockList
      (match (compiler_optimize.opt-dce-block-list-array-pass
        (compiler_optimize.opt-collect-blocks-uses-array 2 cross-blocks)
        cross-blocks)
        [(compiler_optimize.OptBlockListPassResult.Result next _) next])]
    [cross-fixed : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-dce-block-list-array-fixpoint 2 cross-blocks 8)]
    [alloc-tests : i64 (compiler-optimize-dce-alloc-self-test)]
    (cond
      [(not
          (match dead-result
            [(compiler_optimize.OptBlockListPassResult.Result _ changed)
              changed]))
        1]
      [(not
          (match live-result
            [(compiler_optimize.OptBlockListPassResult.Result _ changed)
              (not changed)]))
        2]
      [(not (compiler_optimize.opt-used-contains used 1)) 3]
      [(compiler_optimize.opt-used-contains used 0) 4]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 4)) 5]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count cleaned) 2)) 6]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count again) 2)) 7]
      [(not unused-word-dead) 8]
      [(not (= alloc-tests 42)) 9]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-instruction-count
              cross-once)
            3))
        10]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-instruction-count
              cross-fixed)
            2))
        11]
      [else 42])))

;; Builds `[Mov v0=4096 (an address), Load v1 = *v0, Return v1]`. `v0` feeds a
;; `Load`, so DCE must treat it as used and keep it; without collecting the
;; Load's operand uses, DCE would wrongly drop `v0`'s Mov and break the load.
(define (opt-dce-mem-self-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 4096)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 1)))))

;; Returns 42 when DCE keeps the `Mov` that feeds the `Load` (operand uses of
;; pointer/memory ops are collected), leaving all three instructions intact.
(define (compiler-optimize-dce-mem-self-test) : i64
  (let
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-dce-mem-self-test-instrs)]
    [used : opt_i64_i64_map.Map
      (opt-test-collect-instrs-uses (opt_i64_i64_map.with-capacity 64) instrs)]
    [cleaned : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs used instrs)]
    (if (compiler_optimize.opt-used-contains used 0)
      (if (= (compiler_ir_types.compiler-ir-instr-seq-count cleaned) 3)
        42
        2)
      1)))

(define (opt-count-binop-op-instr
  [instr : compiler_ir_types.CompilerIrInstr]
  [op : compiler_ir_types.CompilerIrBinOp]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp _ actual _ _ _)
      (if (compiler_optimize.opt-binop-eq actual op)
        1
        0)]
    [_ 0]))

(define (opt-count-binop-op-instr-seq-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [op : compiler_ir_types.CompilerIrBinOp]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (opt-count-binop-op-instr-seq-from
      instrs
      op
      (+ index 1)
      (+
        acc
        (opt-count-binop-op-instr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          op)))))

(define (opt-count-binop-op-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [op : compiler_ir_types.CompilerIrBinOp]) : i64
  (opt-count-binop-op-instr-seq-from instrs op 0 0))

(define (opt-count-binop-op-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [op : compiler_ir_types.CompilerIrBinOp]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-binop-op-instr-seq instrs op)
            (opt-count-binop-op-blocks (__tl-box-place rest) op))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-binop-op-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        op)]))

(define (opt-divrem-test-return
  [result : compiler_ir_types.CompilerIrValue]
  [return-result? : bool]) : compiler_ir_types.CompilerIrInstr
  (if return-result?
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some result))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 0)))))

(define (opt-divrem-test-params [ty : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param "lhs" ty 0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param "rhs" ty 1)
      (compiler_ir_types.CompilerIrParamList.Nil))))

(define (opt-divrem-branch-blocks
  [cmp-op : compiler_ir_types.CompilerIrBinOp]
  [cmp-lhs : compiler_ir_types.CompilerIrValue]
  [cmp-rhs : compiler_ir_types.CompilerIrValue]
  [arith-op : compiler_ir_types.CompilerIrBinOp]
  [arith-lhs : compiler_ir_types.CompilerIrValue]
  [arith-rhs : compiler_ir_types.CompilerIrValue]
  [arith-ty : compiler_ast_types.AstType]
  [return-result? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          cmp-op
          cmp-lhs
          cmp-rhs
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "safe")
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "safe")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            arith-op
            arith-lhs
            arith-rhs
            arith-ty)
          (opt-divrem-test-return
            (compiler_ir_types.CompilerIrValue.Var 3)
            return-result?)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-divrem-cast-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Cast
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          3
          (compiler_ir_types.CompilerIrBinOp.Gt)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.compiler-ir-label "safe")
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "safe")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Div)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-divrem-rhs-redefined-before-branch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "safe")
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "safe")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Div)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-divrem-rhs-redefined-in-safe-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "safe")
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "safe")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Div)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-divrem-lhs-not-min-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "check_lhs")
          (compiler_ir_types.compiler-ir-label "exit"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "check_lhs")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Ne)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64
              (compiler_optimize.opt-signed-min
                (compiler_ast_types.AstType.I64)))
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "safe")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "safe")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              4
              (compiler_ir_types.CompilerIrBinOp.Div)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 4)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-divrem-dce-blocks
  [params : compiler_ir_types.CompilerIrParamList]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [frame : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        params
        blocks)]
    [used : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array frame safe)]
    (compiler_optimize.opt-dce-block-list-array used safe)))

(define (compiler-optimize-divrem-safety-self-test) : i64
  (let
    [i64-params : compiler_ir_types.CompilerIrParamList
      (opt-divrem-test-params (compiler_ast_types.AstType.I64))]
    [u64-params : compiler_ir_types.CompilerIrParamList
      (opt-divrem-test-params (compiler_ast_types.AstType.U64))]
    [signed-positive : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Gt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [signed-mod-positive : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ge)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [unsigned-nonzero : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        u64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.U64)
          true))]
    [lhs-not-min : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-lhs-not-min-blocks))]
    [zero-reachable : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [neg-one-reachable : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [weak-negative-range : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [cast-unsupported : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-cast-blocks))]
    [rhs-redefined-before-branch : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-rhs-redefined-before-branch-blocks))]
    [rhs-redefined-in-safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        i64-params
        (opt-divrem-rhs-redefined-in-safe-blocks))]
    [safe-unused : compiler_ir_types.CompilerIrBlockList
      (opt-divrem-dce-blocks
        i64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Gt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          false)
        4)]
    [unproven-unused : compiler_ir_types.CompilerIrBlockList
      (opt-divrem-dce-blocks
        i64-params
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "entry")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                2
                (compiler_ir_types.CompilerIrBinOp.Div)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          compiler_ir_types.CompilerIrBlockList.Nil)
        4)]
    (begin
      (unless
        (=
          (opt-count-binop-op-blocks
            signed-positive
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          1)
        (return 1))
      (unless
        (=
          (opt-count-binop-op-blocks
            signed-positive
            (compiler_ir_types.CompilerIrBinOp.Div))
          0)
        (return 2))
      (unless
        (=
          (opt-count-binop-op-blocks
            signed-mod-positive
            (compiler_ir_types.CompilerIrBinOp.SafeMod))
          1)
        (return 3))
      (unless
        (=
          (opt-count-binop-op-blocks
            unsigned-nonzero
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          1)
        (return 4))
      (unless
        (=
          (opt-count-binop-op-blocks
            lhs-not-min
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          1)
        (return 5))
      (unless
        (=
          (opt-count-binop-op-blocks
            zero-reachable
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 6))
      (unless
        (=
          (opt-count-binop-op-blocks
            neg-one-reachable
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 7))
      (unless
        (=
          (opt-count-binop-op-blocks
            weak-negative-range
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 8))
      (unless
        (=
          (opt-count-binop-op-blocks
            cast-unsupported
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 9))
      (unless
        (=
          (opt-count-binop-op-blocks
            rhs-redefined-before-branch
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 10))
      (unless
        (=
          (opt-count-binop-op-blocks
            rhs-redefined-in-safe
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 11))
      (unless
        (=
          (opt-count-binop-op-blocks
            safe-unused
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          0)
        (return 12))
      (unless
        (=
          (opt-count-binop-op-blocks
            safe-unused
            (compiler_ir_types.CompilerIrBinOp.Div))
          0)
        (return 13))
      (unless
        (=
          (opt-count-binop-op-blocks
            unproven-unused
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 14))
      42)))

;; `[BinOp v2 = v0 + v1, BinOp v3 = v0 + v1]` with non-constant operands: CSE
;; rewrites the second into `Mov v3 = v2` (two arithmetic instrs -> one).
(define (opt-cse-self-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

;; Shift direction, lhs, rhs value, result, and destination shape are identical
;; here; only the RHS count type differs. The raw I64(-1) is a signed -1 under
;; I8 metadata and the all-ones byte under U8 metadata, so CSE must retain both
;; trapping expressions instead of rewriting the second one to a Mov from the
;; first. A shared Var would be malformed IR because it cannot have both types.
(define (opt-cse-shift-count-type-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      60
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I8))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      61
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
      (compiler_ast_types.AstType.I64))))

(define (opt-shift-binop-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp
        _
        (compiler_ir_types.CompilerIrBinOp.Shl _)
        _
        _
        _)
      1]
    [(compiler_ir_types.CompilerIrInstr.BinOp
        _
        (compiler_ir_types.CompilerIrBinOp.Shr _)
        _
        _
        _)
      1]
    [_ 0]))

(define (opt-count-shift-binops-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-shift-binop-count
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
      (opt-count-shift-binops-from instrs (+ index 1)))))

(define (opt-count-shift-binops [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-shift-binops-from instrs 0))

(define (opt-cse-sqrt-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.UnOp
      2
      (compiler_ir_types.CompilerIrUnOp.Sqrt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.F64))
    (compiler_ir_types.CompilerIrInstr.UnOp
      3
      (compiler_ir_types.CompilerIrUnOp.Sqrt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.F64))))

;; A store between the two identical expressions clears the table, so the second
;; expression is preserved (no cross-store CSE).
(define (opt-cse-store-clears-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      (opt-test-symbol "g")
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

;; Redefining an operand (`v0`) between the two expressions invalidates the
;; available entry, so the second expression is preserved (correctness on
;; non-SSA IR).
(define (opt-cse-operand-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 5)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

(define (opt-cse-probe-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.CpuId
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      1)
    (compiler_ir_types.CompilerIrInstr.CpuId
      3
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      1)
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      4
      (compiler_ir_types.CompilerIrValue.I64 0))
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      5
      (compiler_ir_types.CompilerIrValue.I64 0))))

(define (opt-cse-probe-different-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.CpuId
      2
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.I64 0)
      1)
    (compiler_ir_types.CompilerIrInstr.CpuId
      3
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.I64 0)
      2)
    (compiler_ir_types.CompilerIrInstr.CpuId
      4
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.I64 1)
      1)
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      5
      (compiler_ir_types.CompilerIrValue.I64 0))
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      6
      (compiler_ir_types.CompilerIrValue.I64 1))))

(define (opt-simd-cse-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Splat
      20
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Splat
      21
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Splat
      22
      (compiler_ir_types.CompilerIrValue.Var 0)
      8
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      30
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      31
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      32
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      33
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      8
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      34
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.ir-instr-vector-compare
      40
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      41
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      42
      (compiler_ir_types.CompilerIrBinOp.Ne)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      43
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      8
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      44
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.ir-instr-vector-bin-op
      50
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.Var 21)
      (compiler_ir_types.CompilerIrValue.Var 31)
      4
      (compiler_ast_types.AstType.I64))))

(define (compiler-optimize-simd-local-cse-self-test) : i64
  (let
    [input : compiler_ir_types.CompilerIrInstrSeq (opt-simd-cse-instrs)]
    [rewritten : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        input)]
    [copied : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs (compiler_optimize.OptCopyEnv.Nil) rewritten)]
    (cond
      [(not (compiler_optimize.opt-scan-cse-dup-from input.slots 0 input.len))
        1]
      [(not (= (opt-mov-src-var-instr-seq rewritten 21 (- 0 1)) 20)) 2]
      [(not (= (opt-mov-src-var-instr-seq rewritten 31 (- 0 1)) 30)) 3]
      [(not (= (opt-mov-src-var-instr-seq rewritten 41 (- 0 1)) 40)) 4]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 22) 0)) 5]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 32) 0)) 6]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 33) 0)) 7]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 34) 0)) 8]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 42) 0)) 9]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 43) 0)) 10]
      [(not (= (opt-count-mov-dst-instr-seq rewritten 44) 0)) 11]
      [(not (= (opt-vector-binop-lhs-var copied 50) 20)) 12]
      [else 42])))

;; Returns 42 when CSE eliminates the repeated pure expression (2 arithmetic
;; instrs -> 1) yet preserves the second expression both across an intervening
;; store and across an operand redefinition (still 2 arithmetic instrs each).
;; It also CSEs identical CPU probes while preserving probes with different
;; register indices or operands.
;; Self-test: const-global propagation. Verifies the immutability proof and the
;; operand rewrite it feeds.
;;
;; ADMITTED: a global with a literal `I64` initialiser that the program never
;; stores to and never takes the address of, whose value fits a signed 32-bit
;; immediate. `zero` (value 0) is a member like any other value -- the exclusion
;; that used to keep it out was a divisor-position rule, not an immutability one.
;;
;; REFUSED: `mut` (a `Store` anywhere in the program), `borrowed` (a `GlobalAddr`
;; anywhere), `uninit` and `runtime` (no literal initialiser -- `runtime` carries
;; the `CompilerIrValue.RuntimeGlobal` form that lowering gives a global whose
;; initialiser is evaluated by a startup `__global_init_*` function, so a
;; startup-initialised global can never be folded), and `big` (wider than an
;; imm32: `global_cell` already keeps such a constant in one hoisted register,
;; which beats a per-use `movabs` -- see opt-const-globals-imm32-fits?).
;;
;; REWRITE: every use of an admitted global becomes its literal, EXCEPT a div/mod
;; divisor whose constant is zero, which keeps its trapping global-load form.
;; A bounds check whose index is an admitted global becomes a literal check,
;; which is what lets SCCP discharge it -- the intern_table P6 shape.
(defstruct OptConstDivisorTestSymbols
  (konst i64)
  (mutable i64)
  (uninit i64)
  (borrowed i64)
  (zero i64)
  (big i64)
  (runtime i64))

(define (opt-const-divisor-test-symbols) : OptConstDivisorTestSymbols
  (OptConstDivisorTestSymbols
    (opt-test-symbol "konst")
    (opt-test-symbol "mut")
    (opt-test-symbol "uninit")
    (opt-test-symbol "borrowed")
    (opt-test-symbol "zero")
    (opt-test-symbol "big")
    (opt-test-symbol "runtime")))

(define (opt-const-divisor-test-globals [symbols : OptConstDivisorTestSymbols]) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [builder : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 7)]
    (begin
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.konst
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 1000000007))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.mutable
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 7))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.uninit
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.Unit))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.borrowed
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 99))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.zero
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.big
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 4294967295))
      ;; The shape lowering gives a global whose initialiser is not a
      ;; compile-time constant: the value is the startup initialiser function,
      ;; not a literal, so the table can never see a value to fold.
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.runtime
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.RuntimeGlobal
          (opt-test-symbol "__global_init_runtime")))
      (compiler_ir_types.compiler-ir-global-builder-to-seq builder))))

(define (opt-const-divisor-test-blocks [symbols : OptConstDivisorTestSymbols]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          11
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.mutable)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          12
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.uninit)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          13
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          14
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.borrowed)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          15
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.zero)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          16
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.big)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          17
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          18
          (compiler_ir_types.CompilerIrBinOp.BitXor)
          (compiler_ir_types.CompilerIrValue.Var 17)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          19
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          21
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 19)
          (compiler_ast_types.AstType.I64))
        ;; A zero-valued constant global in a DIVISOR position keeps its load.
        (compiler_ir_types.CompilerIrInstr.BinOp
          22
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.zero)
          (compiler_ast_types.AstType.I64))
        ;; A wide constant global is refused on profitability, everywhere.
        (compiler_ir_types.CompilerIrInstr.BinOp
          23
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.big)
          (compiler_ast_types.AstType.I64))
        ;; A startup-initialised global is not foldable in any position.
        (compiler_ir_types.CompilerIrInstr.BinOp
          24
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.runtime)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          20
          (compiler_ir_types.CompilerIrValue.GlobalAddr symbols.borrowed)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Store
          symbols.mutable
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 10)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

(define (opt-const-divisor-test-rhs-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index count)
    (compiler_ir_types.CompilerIrValue.Unit)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp d _ _ rhs _)
        (if (= d dst)
          rhs
          (opt-const-divisor-test-rhs-in-seq instrs (+ index 1) count dst))]
      [_ (opt-const-divisor-test-rhs-in-seq instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-rhs
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrValue.Unit)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-const-divisor-test-rhs-in-seq
            instrs
            0
            (compiler_ir_types.compiler-ir-instr-seq-count instrs)
            dst)])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-rhs
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-const-divisor-test-mov-src-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index count)
    (compiler_ir_types.CompilerIrValue.Unit)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov d src _)
        (if (= d dst)
          src
          (opt-const-divisor-test-mov-src-in-seq instrs (+ index 1) count dst))]
      [_ (opt-const-divisor-test-mov-src-in-seq instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-mov-src
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrValue.Unit)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-const-divisor-test-mov-src-in-seq
            instrs
            0
            (compiler_ir_types.compiler-ir-instr-seq-count instrs)
            dst)])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-mov-src
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; The intern_table P6 shape end to end: a never-written literal global read as
;; an ordinary operand of a compare, and the SAME global standing as the index
;; operand of a bounds check. Once the const-global rewrite has turned both into
;; literals, SCCP must fold the compare to a constant (the BinOp becomes a Mov of
;; the decided value) and discharge the in-range check outright.
(define (opt-const-divisor-test-sccp-blocks
  [symbols : OptConstDivisorTestSymbols]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          30
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          31
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 30)
          (compiler_ir_types.CompilerIrValue.I64 2000000000)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Global symbols.zero)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 31)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-const-divisor-test-binop-dst-in-seq?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]) : bool
  (if (>= index count)
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp found _ _ _ _)
        (if (= found dst)
          true
          (opt-const-divisor-test-binop-dst-in-seq?
            instrs
            (+ index 1)
            count
            dst))]
      [_
        (opt-const-divisor-test-binop-dst-in-seq? instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-binop-dst?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (opt-const-divisor-test-binop-dst-in-seq?
            instrs
            0
            (compiler_ir_types.compiler-ir-instr-seq-count instrs)
            dst)
            true
            (opt-const-divisor-test-binop-dst? (__tl-box-place rest) dst))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-binop-dst?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-const-divisor-test-bounds-index-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index count)
    (compiler_ir_types.CompilerIrValue.Unit)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BoundsCheck idx _ _) idx]
      [_ (opt-const-divisor-test-bounds-index-in-seq instrs (+ index 1) count)])))

(define (opt-const-divisor-test-is-unit?
  [v : compiler_ir_types.CompilerIrValue]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.Unit) true]
    [_ false]))

;; `Unit` when the blocks carry no bounds check at all, which is how the SCCP
;; leg asserts the check was discharged rather than merely rewritten.
(define (opt-const-divisor-test-bounds-index
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrValue
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrValue.Unit)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (let
        [found : compiler_ir_types.CompilerIrValue
          (match block
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
              (opt-const-divisor-test-bounds-index-in-seq
                instrs
                0
                (compiler_ir_types.compiler-ir-instr-seq-count instrs))])]
        (if (opt-const-divisor-test-is-unit? found)
          (opt-const-divisor-test-bounds-index (__tl-box-place rest))
          found))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-bounds-index
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-const-divisor-test-is-i64?
  [v : compiler_ir_types.CompilerIrValue]
  [n : i64]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.I64 m) (= m n)]
    [_ false]))

(define (opt-const-divisor-test-is-global?
  [v : compiler_ir_types.CompilerIrValue]
  [name : String]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.Global m)
      (string.eq (compiler_ir_types.compiler-ir-symbol-text m) name)]
    [_ false]))

(define (compiler-optimize-const-divisor-self-test) : i64
  (let
    [symbols : OptConstDivisorTestSymbols (opt-const-divisor-test-symbols)]
    [globals : compiler_ir_types.CompilerIrGlobalSeq
      (opt-const-divisor-test-globals symbols)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-const-divisor-test-blocks symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "f")
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.I64)
          16
          blocks)
        (compiler_ir_types.compiler-ir-function-seq-empty))]
    [table : opt_i64_i64_map.Map
      (compiler_optimize.opt-const-divisors-build globals functions)]
    [rewritten : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-const-divisor-rewrite-blocks table blocks)]
    [move-rewritten : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-const-global-move-rewrite-blocks
        table
        (compiler_optimize.opt-const-global-move-fold-vars-blocks
          (opt_i64_i64_map.with-capacity 8)
          blocks)
        blocks)]
    ;; The P6 leg: run the same rewrite the pipeline runs at the top of the
    ;; level-2 iteration, then hand the result to SCCP exactly as the pipeline's
    ;; sccp slot does.
    [sccp-input : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-const-divisor-rewrite-blocks
        table
        (opt-const-divisor-test-sccp-blocks symbols))]
    [sccp-folded : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrParamList.Nil
        sccp-input)]
    (cond
      [(not (opt_i64_i64_map.contains? (& table) symbols.konst)) 1]
      [(not
          (match (opt_i64_i64_map.get (& table) symbols.konst)
            [(opt_i64_i64_map.LookupFound n) (= n 1000000007)]
            [(opt_i64_i64_map.LookupMissing) false]))
        2]
      [(opt_i64_i64_map.contains? (& table) symbols.mutable) 3]
      [(opt_i64_i64_map.contains? (& table) symbols.uninit) 4]
      [(opt_i64_i64_map.contains? (& table) symbols.borrowed) 5]
      [(not
          (match (opt_i64_i64_map.get (& table) symbols.zero)
            [(opt_i64_i64_map.LookupFound n) (= n 0)]
            [(opt_i64_i64_map.LookupMissing) false]))
        6]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs rewritten 10)
            1000000007))
        7]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs rewritten 13)
            1000000007))
        8]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 11)
            "mut"))
        9]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 12)
            "uninit"))
        10]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 14)
            "borrowed"))
        11]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs rewritten 15)
            0))
        12]
      [(opt_i64_i64_map.contains?
          (& table)
          (compiler_ir_types.compiler-ir-symbol-id symbols.big))
        13]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 16)
            "big"))
        14]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-mov-src move-rewritten 17)
            1000000007))
        15]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-mov-src move-rewritten 19)
            "konst"))
        16]
      ;; A zero divisor is the one position an admitted global is NOT
      ;; substituted into.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 22)
            "zero"))
        17]
      ;; ... and so is a wide constant, in a divisor position like any other.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 23)
            "big"))
        18]
      ;; A startup-initialised global never enters the table ...
      [(opt_i64_i64_map.contains?
          (& table)
          (compiler_ir_types.compiler-ir-symbol-id symbols.runtime))
        19]
      ;; ... and so keeps its hidden-load form at every use.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs rewritten 24)
            "runtime"))
        20]
      ;; P6, before SCCP: the bounds check's INDEX operand is now the literal.
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-bounds-index sccp-input)
            0))
        21]
      ;; P6, after SCCP: the in-range check is discharged outright ...
      [(not
          (opt-const-divisor-test-is-unit?
            (opt-const-divisor-test-bounds-index sccp-folded)))
        22]
      ;; ... and the dependent compare folded to a constant, so no BinOp
      ;; computes it any more.
      [(opt-const-divisor-test-binop-dst? sccp-folded 31) 23]
      [else 42])))

(define (compiler-optimize-cse-self-test) : i64
  (let
    [cse : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-self-test-instrs))]
    [sqrt : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-sqrt-instrs))]
    [store : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-store-clears-instrs))]
    [redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-operand-redef-instrs))]
    [probe : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-probe-instrs))]
    [probe-different : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-probe-different-instrs))]
    [shift-count-types : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-shift-count-type-instrs))]
    (begin
      (unless (= (opt-count-arith-instr-seq cse) 1) (return 1))
      (unless (= (opt-mov-src-var-instr-seq sqrt 3 (- 0 1)) 2) (return 10))
      (unless (= (opt-count-arith-instr-seq store) 2) (return 2))
      (unless (= (opt-count-arith-instr-seq redef) 2) (return 3))
      (unless (= (opt-count-cpuid-instr-seq probe) 1) (return 4))
      (unless (= (opt-mov-src-var-instr-seq probe 3 (- 0 1)) 2) (return 5))
      (unless (= (opt-count-xgetbv-instr-seq probe) 1) (return 6))
      (unless (= (opt-mov-src-var-instr-seq probe 5 (- 0 1)) 4) (return 7))
      (unless (= (opt-count-cpuid-instr-seq probe-different) 3) (return 8))
      (unless (= (opt-count-xgetbv-instr-seq probe-different) 2) (return 9))
      (unless (= (opt-count-shift-binops shift-count-types) 2) (return 10))
      (unless
        (= (opt-count-mov-dst-instr-seq shift-count-types 61) 0)
        (return 11))
      42)))

;; --- cross-block GVN self-tests ---------------------------------------------
(define (opt-gvn-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "a"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "b"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.CompilerIrParamList.Nil))))

(define (opt-gvn-count-binops-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-arith-instr-seq instrs)
            (opt-gvn-count-binops-blocks (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-gvn-count-binops-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

;; Diamond: `a + b` computed in the entry block and recomputed in the
;; post-dominating join. The entry strictly dominates the join, so the join's
;; expression is rewritten to a copy and the binop count drops from 2 to 1.
(define (opt-gvn-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "l")
          (compiler_ir_types.compiler-ir-label "r"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "l")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "j"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "r")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "j"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "j")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                11
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 11)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Two sibling arms each compute `a + b`, and the join recomputes it. Neither arm
;; strictly dominates the join, so no cross-block CSE fires and all 3 binops stay.
(define (opt-gvn-siblings-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "l")
          (compiler_ir_types.compiler-ir-label "r"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "l")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            10
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "j"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "r")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              11
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "j"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "j")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                12
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 12)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; The shared operand `v2` is reassigned in each block, so it has two value
;; sources and is not stable. Even though the entry dominates the join, the two
;; `v0 + v2` expressions compute different values and must not be CSE'd: 2 binops.
(define (opt-gvn-redef-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "j"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "j")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            2
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            11
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 11)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

;; Loop: the header computes `a + b` and the body recomputes it. The header
;; strictly dominates the body, so the body's expression is rewritten: 2 -> 1.
(define (opt-gvn-loop-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "h"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "h")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            10
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              11
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "h"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 10)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-gvn-probe-dominated-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.CpuId
          20
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          1)
        (compiler_ir_types.CompilerIrInstr.Xgetbv
          21
          (compiler_ir_types.CompilerIrValue.I64 0))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CpuId
            22
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ir_types.CompilerIrValue.I64 0)
            1)
          (compiler_ir_types.CompilerIrInstr.Xgetbv
            23
            (compiler_ir_types.CompilerIrValue.I64 0))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 23)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-gvn-probe-different-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.CpuId
          20
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          1)
        (compiler_ir_types.CompilerIrInstr.Xgetbv
          21
          (compiler_ir_types.CompilerIrValue.I64 0))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CpuId
            22
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ir_types.CompilerIrValue.I64 0)
            2)
          (compiler_ir_types.CompilerIrInstr.CpuId
            23
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ir_types.CompilerIrValue.I64 1)
            1)
          (compiler_ir_types.CompilerIrInstr.Xgetbv
            24
            (compiler_ir_types.CompilerIrValue.I64 1))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 24)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

;; Returns 42 only when cross-block GVN rewrites dominated repeats (diamond and
;; loop drop to 1 binop), leaves non-dominating siblings alone (3 binops), and
;; refuses to CSE across a reassigned operand (2 binops). CPU probes are reused
;; only when an identical probe is available from a strict dominator.
(define (compiler-optimize-gvn-self-test) : i64
  (let
    [probe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-test-params)
        (opt-gvn-probe-dominated-blocks))]
    [probe-different : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-test-params)
        (opt-gvn-probe-different-blocks))]
    (begin
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-diamond-blocks)))
          1)
        (return 1))
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-siblings-blocks)))
          3)
        (return 2))
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-redef-blocks)))
          2)
        (return 3))
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-loop-blocks)))
          1)
        (return 4))
      (unless (= (opt-count-cpuid-blocks probe) 1) (return 5))
      (unless (= (opt-blocks-mov-src-var probe 22 (- 0 1)) 20) (return 6))
      (unless (= (opt-count-xgetbv-blocks probe) 1) (return 7))
      (unless (= (opt-blocks-mov-src-var probe 23 (- 0 1)) 21) (return 8))
      (unless (= (opt-count-cpuid-blocks probe-different) 3) (return 9))
      (unless (= (opt-count-xgetbv-blocks probe-different) 2) (return 10))
      42)))

(define (opt-simd-gvn-kind-count-instr
  [instr : compiler_ir_types.CompilerIrInstr]
  [kind : i64]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Splat _ _ _ _)
      (if (= kind 0)
        1
        0)]
    [(compiler_ir_types.CompilerIrInstr.VectorBinOp _)
      (if (= kind 1)
        1
        0)]
    [(compiler_ir_types.CompilerIrInstr.VectorCompare _)
      (if (= kind 2)
        1
        0)]
    [_ 0]))

(define (opt-simd-gvn-kind-count-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [kind : i64]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-simd-gvn-kind-count-instr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        kind)
      (opt-simd-gvn-kind-count-seq instrs kind (+ index 1)))))

(define (opt-simd-gvn-kind-count-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [kind : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-simd-gvn-kind-count-seq instrs kind 0)
            (opt-simd-gvn-kind-count-blocks (__tl-box-place rest) kind))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-simd-gvn-kind-count-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        kind)]))

(define (opt-simd-gvn-dominated-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 0)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.ir-instr-vector-bin-op
          11
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ir_types.CompilerIrValue.Var 10)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.ir-instr-vector-compare
          12
          (compiler_ir_types.CompilerIrBinOp.Eq)
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.CompilerIrValue.Var 11)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "child"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "child")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Splat
            20
            (compiler_ir_types.CompilerIrValue.Var 0)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-bin-op
            21
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 10)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-compare
            22
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.CompilerIrValue.Var 11)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 22)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-simd-gvn-sibling-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 0)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "left")
          (compiler_ir_types.compiler-ir-label "right"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "left")
        (opt-test-instrs
          (compiler_ir_types.ir-instr-vector-bin-op
            20
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 10)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "right")
          (opt-test-instrs
            (compiler_ir_types.ir-instr-vector-bin-op
              21
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 10)
              (compiler_ir_types.CompilerIrValue.Var 10)
              4
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 10)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-simd-gvn-redefined-operand-blocks) : compiler_ir_types.CompilerIrBlockList
