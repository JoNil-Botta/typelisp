(define (opt-bce-mb3-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb3_fixture")
    (opt-bce-version-test-params)
    (compiler_ast_types.AstType.I64)
    opt-bce-mb3-test-frame
    blocks))

(define (opt-bce-mb3-test-versioned-fn [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-bce-version-function
    (opt-bce-mb3-test-function (opt-bce-mb3-test-blocks variant))))

(define (opt-bce-mb3-test-versioned [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (opt-bce-mb3-test-versioned-fn variant)))

(define (opt-bce-mb3-test-verify-ok? [variant : i64]) : bool
  (compiler_optimize.opt-verify-ok?
    (compiler_optimize.opt-verify-function
      (opt-bce-mb3-test-versioned-fn variant))))

(define (opt-bce-mb3-test-versioned? [variant : i64]) : bool
  (opt-block-list-has-label?
    (opt-bce-mb3-test-versioned variant)
    (compiler_ir_types.compiler-ir-label "header__bce_fast")))

;; Running the versioner on its own output must change nothing: the generated
;; fast labels are what make the loop ineligible to both scans.
(define (opt-bce-mb3-test-refixed-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (compiler_optimize.opt-bce-version-function
      (opt-bce-mb3-test-versioned-fn variant))))

(define (compiler-optimize-bce-version-mb-merged-body-self-test) : i64
  (let
    [merged : compiler_ir_types.CompilerIrBlockList
      (opt-bce-mb3-test-versioned 0)]
    (cond
      [(not (opt-bce-mb3-test-verify-ok? 0)) 1]
      [(not (opt-bce-mb3-test-versioned? 0)) 2]
      ;; the guard sits on the preheader edge and the whole loop clones
      [(not
          (opt-block-list-has-label?
            merged
            (compiler_ir_types.compiler-ir-label "header__bce_guard")))
        3]
      [(not
          (opt-block-list-has-label?
            merged
            (compiler_ir_types.compiler-ir-label "gate__bce_fast")))
        4]
      ;; both exit arms AND the callee's exit join joined the clone group
      [(not
          (opt-block-list-has-label?
            merged
            (compiler_ir_types.compiler-ir-label "gexit__bce_fast")))
        5]
      [(not
          (opt-block-list-has-label?
            merged
            (compiler_ir_types.compiler-ir-label "hexit__bce_fast")))
        6]
      [(not
          (opt-block-list-has-label?
            merged
            (compiler_ir_types.compiler-ir-label "cjoin__bce_fast")))
        7]
      ;; check-free clone, checked original
      [(not
          (=
            (opt-bce-version-test-block-checks
              merged
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        8]
      [(not
          (=
            (opt-bce-version-test-block-checks
              merged
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        9]
      ;; the continuation's phi gained exactly one parallel fast-edge input
      ;; (cjoin, calt, cjoin__bce_fast) and stayed a single phi
      [(not
          (=
            (opt-bce-mb2-test-block-phis
              merged
              (compiler_ir_types.compiler-ir-label "cont"))
            1))
        10]
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              merged
              (compiler_ir_types.compiler-ir-label "cont"))
            3))
        11]
      ;; idempotent: a second run is a no-op
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (opt-bce-mb3-test-refixed-blocks 0))
            (compiler_ir_types.compiler-ir-block-list-count merged)))
        12]
      [else 42])))

;; The boundaries of the exit-join admission.
(define (compiler-optimize-bce-version-mb-merged-body-refusal-self-test) : i64
  (cond
    ;; a loop edge into the join is the ordinary exit shape, not an absorbed
    ;; continuation: not admitted here
    [(not (opt-bce-mb3-test-verify-ok? 1)) 1]
    [(opt-bce-mb3-test-versioned? 1) 2]
    ;; a join carrying a check is not clonable as a forwarder
    [(not (opt-bce-mb3-test-verify-ok? 2)) 3]
    [(opt-bce-mb3-test-versioned? 2) 4]
    ;; a join predecessor that is not clonable as a forwarder refuses
    [(not (opt-bce-mb3-test-verify-ok? 3)) 5]
    [(opt-bce-mb3-test-versioned? 3) 6]
    [else 42]))

;; --- cross-array check-domain fusion ------------------------------------------
;;
;; A counted multi-block loop walking THREE arrays through one opaque index.
;; `body` (the header) loads `v = mem[i]` under the counter check and branches
;; on the safe-accessor sentinel `v >= 0`. Its true arm `anchor` checks
;; `v < lenA`; the dominated arm `then` uses the same `v` against `lenB` and
;; `lenC`. Only the anchor bounds `v` -- it is a loaded value, so no trip-range
;; derivation reaches it -- and the two dominated checks derive from it under
;; the guard conjuncts `lenA <=u lenB` and `lenA <=u lenC`, which is exactly the
;; fusion rule. The fused checks must NOT feed the guard-dominated floor folder:
;; their proof relies on the earlier sentinel and using them to delete it would
;; be circular.
;;
;; Variants:
;;   0 the arm READS through the covered index;
;;   1 the arm indexes an ESCAPING value instead -- a second load nothing has
;;     bounded -- so its checks have no anchor and must be kept;
;;   2 the arm STORES through the covered index (the covered-store case: a
;;     store's check constrains its INDEX, so it fuses exactly like a read).
;;
;; Vars: 0-4 params (n, lenA, lenB, lenC, mem), 5 the counter phi, 6-7 and 10
;; the header, 11-16 the arm, 17-18 the latch.
(define opt-bce-fuse-test-frame : i64
  20)

(define (opt-bce-fuse-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "n"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "lena"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "lenb"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "lenc"
            (compiler_ast_types.AstType.I64)
            3)
          (compiler_ir_types.compiler-ir-param-cons
            (compiler_ir_types.CompilerIrParam.Param
              "mem"
              (compiler_ast_types.AstType.U64)
              4)
            (compiler_ir_types.CompilerIrParamList.Nil)))))))

(define (opt-bce-fuse-test-body-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        5
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 17)
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "fuse_ok0"))
      (compiler_ir_types.CompilerIrInstr.Gep
        6
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        7
        (compiler_ir_types.CompilerIrValue.Var 6)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        10
        (compiler_ir_types.CompilerIrBinOp.Ge)
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 10)
        (compiler_ir_types.compiler-ir-label "anchor")
        (compiler_ir_types.compiler-ir-label "latch")))))

(define (opt-bce-fuse-test-anchor-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "anchor")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.compiler-ir-label "fuse_ok1"))
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "then")))))

;; The index each arm check uses. Variant 1 gives them two different ESCAPING
;; loads -- values no check has bounded and no anchor dominates -- so neither
;; may be admitted; every other variant uses the covered `v`.
(define (opt-bce-fuse-test-arm-index [variant : i64]) : i64
  (if (= variant 1)
    12
    7))

(define (opt-bce-fuse-test-arm-index2 [variant : i64]) : i64
  (if (= variant 1)
    14
    7))

(define (opt-bce-fuse-test-then-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "then")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Gep
        11
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        12
        (compiler_ir_types.CompilerIrValue.Var 11)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var
          (opt-bce-fuse-test-arm-index variant))
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ir_types.compiler-ir-label "fuse_ok2"))
      (compiler_ir_types.CompilerIrInstr.Gep
        13
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var
          (opt-bce-fuse-test-arm-index variant))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        14
        (compiler_ir_types.CompilerIrValue.Var 13)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var
          (opt-bce-fuse-test-arm-index2 variant))
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.compiler-ir-label "fuse_ok3"))
      (compiler_ir_types.CompilerIrInstr.Gep
        15
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var
          (opt-bce-fuse-test-arm-index2 variant))
        (compiler_ast_types.AstType.I64))
      (if (= variant 2)
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 15)
          (compiler_ir_types.CompilerIrValue.Var 14)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          16
          (compiler_ir_types.CompilerIrValue.Var 15)
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "latch")))))

(define (opt-bce-fuse-test-latch-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "latch")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.BinOp
        17
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        18
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 17)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 18)
        (compiler_ir_types.compiler-ir-label "body")
        (compiler_ir_types.compiler-ir-label "exit")))))

(define (opt-bce-fuse-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-bce-mb-test-jump-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-label "body"))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-fuse-test-body-block)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-bce-fuse-test-anchor-block)
        (compiler_ir_types.compiler-ir-block-cons
          (opt-bce-fuse-test-then-block variant)
          (compiler_ir_types.compiler-ir-block-cons
            (opt-bce-fuse-test-latch-block)
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 0)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-bce-fuse-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_fuse_fixture")
    (opt-bce-fuse-test-params)
    (compiler_ast_types.AstType.I64)
    opt-bce-fuse-test-frame
    blocks))

(define (opt-bce-fuse-test-versioned [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-bce-version-function
    (opt-bce-fuse-test-function (opt-bce-fuse-test-blocks variant))))

(define (opt-bce-fuse-test-has-block?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : String]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label name))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some _) true]))

(define (opt-bce-fuse-test-verify-ok?
  [func : compiler_ir_types.CompilerIrFunction]) : bool
  (compiler_optimize.opt-verify-ok?
    (compiler_optimize.opt-verify-function func)))

(define (opt-bce-fuse-test-branch-terminated?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : String]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label name))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            (if (< count 1)
              false
              (match (compiler_ir_types.compiler-ir-instr-seq-ref
                instrs
                (- count 1))
                [(compiler_ir_types.CompilerIrInstr.Branch _ _ _) true]
                [_ false])))])]))

;; (a) three arrays, ONE region guard, a fast clone whose only surviving check
;;     is the anchor the other two derive from, and whose loaded-index sentinel
;;     remains conditional;
;; (b) the covered STORE reaches the same shape;
;; (c) an escaping index refuses fusion and keeps both dominated checks;
;; (d) the slow region is byte-for-byte the original, so a guard-failing or
;;     zero-trip run still reaches every check at its own abort site;
;; (f) re-running the pass on the rewrite changes nothing.
(define (compiler-optimize-bce-fuse-self-test) : i64
  (let
    [read-only-fn : compiler_ir_types.CompilerIrFunction
      (opt-bce-fuse-test-versioned 0)]
    [read-only : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks read-only-fn)]
    [escaping-fn : compiler_ir_types.CompilerIrFunction
      (opt-bce-fuse-test-versioned 1)]
    [escaping : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks escaping-fn)]
    [stored-fn : compiler_ir_types.CompilerIrFunction
      (opt-bce-fuse-test-versioned 2)]
    [stored : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks stored-fn)]
    [again-fn : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function read-only-fn)]
    [again : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks again-fn)]
    (cond
      [(not (opt-bce-fuse-test-verify-ok? read-only-fn)) 1]
      ;; (a) one guard for the whole region, on the loop entry edge
      [(not (opt-bce-fuse-test-has-block? read-only "body__bce_guard")) 2]
      [(opt-bce-fuse-test-has-block? read-only "then__bce_guard") 3]
      [(opt-bce-fuse-test-has-block? read-only "latch__bce_guard") 4]
      ;; the counter check derives from the trip range and the two dominated
      ;; checks derive from the anchor, which itself stays: nothing bounds an
      ;; opaque load
      [(not
          (=
            (opt-bce-version-test-block-checks
              read-only
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              read-only
              (compiler_ir_types.compiler-ir-label "anchor__bce_fast"))
            1))
        6]
      [(not
          (=
            (opt-bce-version-test-block-checks
              read-only
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            0))
        7]
      ;; The fused checks rely on this sentinel before the anchor. It cannot be
      ;; folded from their later, path-conditional proof.
      [(not (opt-bce-fuse-test-branch-terminated? read-only "body__bce_fast"))
        8]
      ;; (d) the slow region keeps every check at its original site
      [(not
          (=
            (opt-bce-version-test-block-checks
              read-only
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        9]
      [(not
          (=
            (opt-bce-version-test-block-checks
              read-only
              (compiler_ir_types.compiler-ir-label "anchor"))
            1))
        10]
      [(not
          (=
            (opt-bce-version-test-block-checks
              read-only
              (compiler_ir_types.compiler-ir-label "then"))
            2))
        11]
      ;; (b) the covered store derives exactly like the covered read
      [(not (opt-bce-fuse-test-verify-ok? stored-fn)) 12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              stored
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            0))
        13]
      [(not
          (=
            (opt-bce-version-test-block-checks
              stored
              (compiler_ir_types.compiler-ir-label "then"))
            2))
        14]
      ;; (c) an escaping index has no anchor: both dominated checks stay in the
      ;; clone, exactly as any underivable index does
      [(not (opt-bce-fuse-test-verify-ok? escaping-fn)) 15]
      [(not
          (=
            (opt-bce-version-test-block-checks
              escaping
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            2))
        16]
      ;; (f) idempotence: a converted region is not offered a second time
      [(not (opt-bce-fuse-test-verify-ok? again-fn)) 17]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count again)
            (compiler_ir_types.compiler-ir-block-list-count read-only)))
        18]
      [else 42])))

(define (opt-bce-mb-pair-test-guard-has-len-fact-from?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp _ op lhs rhs _)
        (match op
          [(compiler_ir_types.CompilerIrBinOp.Ge)
            (or
              (and
                (compiler_optimize.opt-value-eq
                  lhs
                  (compiler_ir_types.CompilerIrValue.Var 1))
                (compiler_optimize.opt-value-eq
                  rhs
                  (compiler_ir_types.CompilerIrValue.I64 1)))
              (opt-bce-mb-pair-test-guard-has-len-fact-from? instrs (+ index 1)))]
          [_ (opt-bce-mb-pair-test-guard-has-len-fact-from? instrs (+ index 1))])]
      [_ (opt-bce-mb-pair-test-guard-has-len-fact-from? instrs (+ index 1))])))

(define (opt-bce-mb-pair-test-guard-short-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : compiler_ir_types.CompilerIrMaybeValue
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (compiler_ir_types.CompilerIrMaybeValue.No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs _)
        (match op
          [(compiler_ir_types.CompilerIrBinOp.Sub)
            (if (and
              (compiler_optimize.opt-value-eq
                lhs
                (compiler_ir_types.CompilerIrValue.Var 1))
              (match rhs
                [(compiler_ir_types.CompilerIrValue.Var _) true]
                [_ false]))
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var dst))
              (opt-bce-mb-pair-test-guard-short-from instrs (+ index 1)))]
          [_ (opt-bce-mb-pair-test-guard-short-from instrs (+ index 1))])]
      [_ (opt-bce-mb-pair-test-guard-short-from instrs (+ index 1))])))

(define (opt-bce-mb-pair-test-guard-has-len-fact?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "entry"))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-pair-test-guard-has-len-fact-from? instrs 0)])]))

(define (opt-bce-mb-pair-test-guard-short
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrMaybeValue
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "entry"))
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.CompilerIrMaybeValue.No)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-pair-test-guard-short-from instrs 0)])]))

(define (opt-bce-mb-pair-test-block-uses-length-from?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [length : compiler_ir_types.CompilerIrValue]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BoundsCheck _ check-length _)
        (or
          (compiler_optimize.opt-value-eq check-length length)
          (opt-bce-mb-pair-test-block-uses-length-from?
            instrs
            (+ index 1)
            length))]
      [_
        (opt-bce-mb-pair-test-block-uses-length-from? instrs (+ index 1) length)])))

(define (opt-bce-mb-pair-test-body-uses-length?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [length : compiler_ir_types.CompilerIrValue]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "then"))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-pair-test-block-uses-length-from? instrs 0 length)])]))

;; The synthesized pair-min subtraction is the only `x - 1` in the rewritten
;; block whose destination came from the fixture's spare frame (var ids at or
;; above `opt-bce-mb-test-frame`); the fixture's own `phi-1 - 1` writes var 6.
(define (opt-bce-mb-pair-test-min-sub-lhs-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : compiler_ir_types.CompilerIrMaybeValue
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (compiler_ir_types.CompilerIrMaybeValue.No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs _)
        (match op
          [(compiler_ir_types.CompilerIrBinOp.Sub)
            (if (and
              (>= dst opt-bce-mb-test-frame)
              (compiler_optimize.opt-value-eq
                rhs
                (compiler_ir_types.CompilerIrValue.I64 1)))
              (compiler_ir_types.CompilerIrMaybeValue.Some lhs)
              (opt-bce-mb-pair-test-min-sub-lhs-from instrs (+ index 1)))]
          [_ (opt-bce-mb-pair-test-min-sub-lhs-from instrs (+ index 1))])]
      [_ (opt-bce-mb-pair-test-min-sub-lhs-from instrs (+ index 1))])))

(define (opt-bce-mb-pair-test-min-sub-lhs
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrMaybeValue
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "then"))
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.CompilerIrMaybeValue.No)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-pair-test-min-sub-lhs-from instrs 0)])]))

(define (opt-bce-mb-pair-test-block-casts-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Cast _ _ _ _) 1]
        [_ 0])
      (opt-bce-mb-pair-test-block-casts-from instrs (+ index 1)))))

(define (opt-bce-mb-pair-test-block-casts
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "then"))
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-bce-mb-pair-test-block-casts-from instrs 0)])]))

;; Positive: the sp-1/sp-2 pair combines after the optimizer fixpoint, in the
;; existing total-enum loop. Its preheader owns len>=1 and the saturated len-1
;; used by the single replacement check. No blocks or loop versions are made.
;; Negatives retain both checks when separated by a store, when their lengths
;; differ, or when the existing preheader cannot establish the required fact.
;; The rollback case lets the removed affine definition escape through a phi;
;; the verifier gate must reject that candidate and preserve both checks.
(define (compiler-optimize-bce-version-mb-paired-self-test) : i64
  (let
    [positive : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 6)))]
    [positive-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks positive)]
    [stored : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 7)))]
    [stored-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks stored)]
    [different : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 8)))]
    [different-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks different)]
    [no-fact : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 9)))]
    [no-fact-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks no-fact)]
    [rollback : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 10)))]
    [rollback-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks rollback)]
    [cast-dead : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 11)))]
    [cast-dead-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks cast-dead)]
    [cast-live : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-late-bounds-pair-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-test-function (opt-bce-mb-test-blocks 12)))]
    [cast-live-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks cast-live)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function positive)))
        1]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count positive-out) 7))
        2]
      [(opt-block-list-has-label?
          positive-out
          (compiler_ir_types.compiler-ir-label "body__bce_fast"))
        3]
      [(not
          (=
            (opt-bce-version-test-block-checks
              positive-out
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        4]
      [(not (opt-bce-mb-pair-test-guard-has-len-fact? positive-out)) 5]
      [(match (opt-bce-mb-pair-test-guard-short positive-out)
          [(compiler_ir_types.CompilerIrMaybeValue.Some short-length)
            (not
              (opt-bce-mb-pair-test-body-uses-length? positive-out short-length))]
          [(compiler_ir_types.CompilerIrMaybeValue.No) true])
        6]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function stored)))
        7]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count stored-out) 7))
        8]
      [(not
          (=
            (opt-bce-version-test-block-checks
              stored-out
              (compiler_ir_types.compiler-ir-label "then"))
            2))
        9]
      [(opt-bce-mb-pair-test-guard-has-len-fact? stored-out) 10]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function different)))
        11]
      [(not
          (= (compiler_ir_types.compiler-ir-block-list-count different-out) 7))
        12]
      [(not
          (=
            (opt-bce-version-test-block-checks
              different-out
              (compiler_ir_types.compiler-ir-label "then"))
            2))
        13]
      [(opt-bce-mb-pair-test-guard-has-len-fact? different-out) 14]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function no-fact)))
        15]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count no-fact-out) 7))
        16]
      [(not
          (=
            (opt-bce-version-test-block-checks
              no-fact-out
              (compiler_ir_types.compiler-ir-label "then"))
            2))
        17]
      [(opt-bce-mb-pair-test-guard-has-len-fact? no-fact-out) 18]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function rollback)))
        19]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count rollback-out) 7))
        20]
      [(not
          (=
            (opt-bce-version-test-block-checks
              rollback-out
              (compiler_ir_types.compiler-ir-label "then"))
            2))
        21]
      [(opt-bce-mb-pair-test-guard-has-len-fact? rollback-out) 22]
      ;; Common-base offsets identify var6 (phi-1) / var13 (phi-2), with the
      ;; later operand as the smaller index.
      [(match (compiler_optimize.opt-bce-mb-affine-pair
          (opt-bce-mb-test-blocks 6)
          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ir_types.CompilerIrValue.Var 13))
          [(compiler_optimize.OptBceMbAffinePair.Some first-smaller)
            first-smaller]
          [(compiler_optimize.OptBceMbAffinePair.No) true])
        23]
      ;; The bytecode-VM shape. The pair still forms through the reinterpret
      ;; cast, but the min index must read the cast's SOURCE (var 6), not the
      ;; cast destination (var 11) -- reading the cast keeps it alive as a bare
      ;; register copy and blocks the backend's `lea -1(src)` fold. With no
      ;; other reader the stranded cast def is deleted outright.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function cast-dead)))
        24]
      [(not
          (= (compiler_ir_types.compiler-ir-block-list-count cast-dead-out) 7))
        25]
      [(not
          (=
            (opt-bce-version-test-block-checks
              cast-dead-out
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        26]
      [(not (opt-bce-mb-pair-test-guard-has-len-fact? cast-dead-out)) 27]
      [(match (opt-bce-mb-pair-test-min-sub-lhs cast-dead-out)
          [(compiler_ir_types.CompilerIrMaybeValue.Some lhs)
            (not
              (compiler_optimize.opt-value-eq
                lhs
                (compiler_ir_types.CompilerIrValue.Var 6)))]
          [(compiler_ir_types.CompilerIrMaybeValue.No) true])
        28]
      [(not (= (opt-bce-mb-pair-test-block-casts cast-dead-out) 0)) 29]
      ;; A second reader keeps the cast def alive; only the dead-def cleanup is
      ;; withheld, and the min index still reads through the cast.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function cast-live)))
        30]
      [(not
          (= (compiler_ir_types.compiler-ir-block-list-count cast-live-out) 7))
        31]
      [(not
          (=
            (opt-bce-version-test-block-checks
              cast-live-out
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        32]
      [(match (opt-bce-mb-pair-test-min-sub-lhs cast-live-out)
          [(compiler_ir_types.CompilerIrMaybeValue.Some lhs)
            (not
              (compiler_optimize.opt-value-eq
                lhs
                (compiler_ir_types.CompilerIrValue.Var 6)))]
          [(compiler_ir_types.CompilerIrMaybeValue.No) true])
        33]
      [(not (= (opt-bce-mb-pair-test-block-casts cast-live-out) 1)) 34]
      [else 42])))

;; Two rejections that leave the function byte-for-byte alone: a call-carrying
;; body whose two derived checks are below the per-call floor, and a clone that
;; overruns the instruction budget.
(define (compiler-optimize-bce-version-mb-negative-self-test) : i64
  (let
    [with-call : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function
          (opt-bce-mb-test-function (opt-bce-mb-test-blocks 2))))]
    ;; The same nine-block chain the positive fixture versions, with each
    ;; forwarder padded to twenty-three instructions: 166 cloned instructions
    ;; against a budget of 160, so the growth cap -- and nothing else --
    ;; rejects it.
    [too-big : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function
          (opt-bce-mb-test-chain-function 22)))]
    (cond
      ;; every rejection leaves the function untouched.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count with-call) 6)) 1]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count too-big) 11)) 2]
      [else 42])))

;; --- guard-dominated compare folding fixture ----------------------------------
;;
;; The pl-line-end shape reduced to its essentials: a counted do-while loop
;; (counter %3 seeded from the invariant param %2, step +1, latch `%8 < %0`)
;; whose ONE derivable check `bounds_check %3, %1` makes the guard prove
;; `%2 >= 0 && %2 < %0 && %0 <= %1`, and whose header then branches on a
;; comparison the guard already decides. `variant` picks that comparison:
;;   0  `%3 >= 0`      folds TRUE  (monotone induction: counter >= seed >= 0)
;;   1  `%3 < 0`       folds FALSE (same fact, other side)
;;   2  `%12 >= 0`     REFUSED: %12 is a second induction phi whose step is
;;                     the non-literal %1, so it is not the counter the guard
;;                     bounded -- the pass never proved it monotone
;;   3  `%6 >= 0` with `%6 = sub %3, 5` REFUSED: a value the loop itself
;;                     writes is neither the counter phi nor invariant
;;   4  `%3 >= 1`      REFUSED: true of every executed trip only via range
;;                     reasoning the rules deliberately do not do; the guard
;;                     proves the seed `>= 0`, not `>= 1`
;;   5  `%0 <= %1`     folds TRUE  (invariant recomputation: the guard's own
;;                     `bound <= length` conjunct, same operator and operands)
;;   6  `%0 < %1`      REFUSED: `<` is not the recorded `<=`, and deriving it
;;                     would need reasoning past exact conjunct identity
;;   7  `%3 >= 0` with a phi in the "else" arm fed from the header REFUSED:
;;                     folding would delete an edge a phi still selects on
;;   8  `%6 >= 0` with `%6 = add %3, 1` and `bounds_check %6, %1` folds TRUE:
;;                     the removed check's exact index has a proven floor
;; Vars: 0-2 params, 3 counter phi, 5 header condition, 6 the variant-3
;; in-loop value, 8 the step, 9 the latch compare, 10 the exit phi, 11 the
;; variant-7 else phi, 12-13 the variant-2 non-literal-step phi.
(define opt-bce-fold-test-frame : i64
  16)

(define (opt-bce-fold-test-nonliteral-variant? [variant : i64]) : bool
  (= variant 2))

(define (opt-bce-fold-test-else-phi-variant? [variant : i64]) : bool
  (= variant 7))

(define (opt-bce-fold-test-derived-check-variant? [variant : i64]) : bool
  (= variant 8))

;; The comparison the header branches on.
(define (opt-bce-fold-test-cond-instr [variant : i64]) : compiler_ir_types.CompilerIrInstr
  (cond
    [(= variant 1)
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))]
    [(= variant 2)
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Ge)
        (compiler_ir_types.CompilerIrValue.Var 12)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))]
    [(or (= variant 3) (opt-bce-fold-test-derived-check-variant? variant))
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Ge)
        (compiler_ir_types.CompilerIrValue.Var 6)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))]
    [(= variant 4)
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Ge)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))]
    [(= variant 5)
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Le)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64))]
    [(= variant 6)
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64))]
    [else
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Ge)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))]))

;; Header: counter phi, the optional second (non-literal-step) phi, the check,
;; the variant-3 in-loop value, the condition, the branch.
(define (opt-bce-fold-test-header-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (opt-bce-fold-test-header-tail variant)
      (compiler_ir_types.CompilerIrInstr.Phi
        3
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 8)
            (compiler_ir_types.compiler-ir-label "merge")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64)))))

(define (opt-bce-fold-test-header-tail [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [core : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          6
          (if (opt-bce-fold-test-derived-check-variant? variant)
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrBinOp.Sub))
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64
            (if (opt-bce-fold-test-derived-check-variant? variant)
              1
              5))
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var
            (if (opt-bce-fold-test-derived-check-variant? variant)
              6
              3))
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "fold_ok0"))
        (opt-bce-fold-test-cond-instr variant)
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 5)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else")))]
    (if (opt-bce-fold-test-nonliteral-variant? variant)
      (opt-test-instrs-with-tail
        core
        (compiler_ir_types.CompilerIrInstr.Phi
          12
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 13)
              (compiler_ir_types.compiler-ir-label "merge")
              (compiler_ir_types.CompilerIrPhiInputList.Nil)))
          (compiler_ast_types.AstType.I64)))
      core)))

