    (unless
      (and
        (opt-uniform-phi-folded?
          (ir.compiler-ir-block-list-view chain-merge-blocks)
          5
          (I64 11))
        (opt-uniform-phi-folded?
          (ir.compiler-ir-block-list-view chain-merge-blocks)
          6
          (I64 22)))
      (return 73))
    (unless
      (opt.opt-verify-ok?
        (& (opt.opt-verify-function (& chain-merge-optimized))))
