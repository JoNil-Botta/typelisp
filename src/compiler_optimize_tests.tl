              (compiler_ir_types.CompilerIrValue.Var 8)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 9)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; Strength-reduced loop-pointer form used by vm_run. The dead block-local Mul
;; is the retained rematerialization recipe; v12 itself must not reach `use`.
(define (opt-successor-sink-induction-remat-blocks-with-step [step : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "preheader")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrValue.I64 16)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Gep
          11
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            12
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 11)
              (compiler_ir_types.compiler-ir-label "preheader")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 13)
                (compiler_ir_types.compiler-ir-label "merge")
                compiler_ir_types.CompilerIrPhiInputList.Nil))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Phi
            2
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "preheader")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.compiler-ir-label "merge")
                compiler_ir_types.CompilerIrPhiInputList.Nil))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Mul)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 16)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Gep
            5
            (compiler_ir_types.CompilerIrValue.Var 12)
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Load
            6
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Gep
            7
            (compiler_ir_types.CompilerIrValue.Var 12)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Load
            8
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Switch
            (compiler_ir_types.CompilerIrValue.Var 8)
            0
            (compiler_ir_types.compiler-ir-switch-case-seq1
              (compiler_ir_types.CompilerIrSwitchCase.Case
                0
                (compiler_ir_types.compiler-ir-label "other")))
            (compiler_ir_types.compiler-ir-label "use"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "use")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 6)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "other")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "merge")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.BinOp
                  3
                  (compiler_ir_types.CompilerIrBinOp.Add)
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.CompilerIrValue.I64 step)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Gep
                  13
                  (compiler_ir_types.CompilerIrValue.Var 12)
                  (compiler_ir_types.CompilerIrValue.I64 16)
                  (compiler_ast_types.AstType.U8))
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-successor-sink-induction-remat-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-successor-sink-induction-remat-blocks-with-step 1))

;; v2 is read in both successors, so neither successor owns every use.
(define (opt-successor-sink-multi-use-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "left")
          (compiler_ir_types.compiler-ir-label "right"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "left")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "right")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; `left` is a direct successor of entry but also reachable through `right`.
;; Entry still dominates it, keeping the fixture valid SSA, while its two
;; predecessors make it ineligible for sinking.
(define (opt-successor-sink-multi-pred-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "left")
          (compiler_ir_types.compiler-ir-label "right"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "right")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "left"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "left")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; The StorePtr between the Load and terminator is an explicit first-cut load
;; barrier even though the loaded result is used in only one successor.
(define (opt-successor-sink-store-barrier-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Load
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "use")
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; SafeDiv still has language-level abort semantics and must not be scheduled
;; conditionally, despite otherwise looking like a pure binary definition.
(define (opt-successor-sink-trapping-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.SafeDiv)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "use")
          (compiler_ir_types.compiler-ir-label "other"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "other")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-successor-sink-instr-seq-defines?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_optimize.opt-instr-def-var
      (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
      [(option_i64.Some found)
        (if (= found dst)
          true
          (opt-successor-sink-instr-seq-defines? instrs (+ index 1) dst))]
      [(option_i64.None)
        (opt-successor-sink-instr-seq-defines? instrs (+ index 1) dst)])))

(define (opt-successor-sink-def-label
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]
  [fallback : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) fallback]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label instrs)
          (if (opt-successor-sink-instr-seq-defines? instrs 0 dst)
            label
            (opt-successor-sink-def-label (__tl-box-place rest) dst fallback))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-successor-sink-def-label
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst
        fallback)]))

(define (opt-successor-sink-run-function
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-successor-sink-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-successor-sink-test-function name blocks)))

(define (opt-successor-sink-run
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (opt-successor-sink-run-function name blocks)))

(define (compiler-optimize-successor-sink-self-test) : i64
  (let
    [positive : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_positive"
        (opt-successor-sink-positive-blocks))]
    [jump : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_jump"
        (opt-successor-sink-jump-blocks))]
    [remat-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_remat"
        (opt-successor-sink-remat-blocks))]
    [remat : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks remat-function)]
    [live-range-blocked : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_live_range_blocked"
        (opt-successor-sink-live-range-blocked-blocks))]
    [terminator-live : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_terminator_live"
        (opt-successor-sink-terminator-live-blocks))]
    [external-leaf-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_external_leaf"
        (opt-successor-sink-external-leaf-blocks))]
    [external-leaf : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks external-leaf-function)]
    [remat-cap-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_remat_cap"
        (opt-successor-sink-remat-cap-blocks))]
    [remat-cap : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks remat-cap-function)]
    [induction-input : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-induction-remat-blocks)]
    [induction-cell : (__tl_dyn-array i64)
      (compiler_optimize.opt-used-array-new 1)]
    [_induction-cell-init : unit (set! (array-ref induction-cell 0) 16)]
    [induction-direct : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-successor-sink-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        16
        induction-cell
        induction-input)]
    [induction-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_induction_remat"
        (opt-successor-sink-induction-remat-blocks))]
    [induction : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks induction-function)]
    [induction-step-two-function : compiler_ir_types.CompilerIrFunction
      (opt-successor-sink-run-function
        "successor_sink_induction_step_two"
        (opt-successor-sink-induction-remat-blocks-with-step 2))]
    [induction-step-two : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks induction-step-two-function)]
    [multi-use : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_multi_use"
        (opt-successor-sink-multi-use-blocks))]
    [multi-pred : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_multi_pred"
        (opt-successor-sink-multi-pred-blocks))]
    [store-barrier : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_store_barrier"
        (opt-successor-sink-store-barrier-blocks))]
    [trapping : compiler_ir_types.CompilerIrBlockList
      (opt-successor-sink-run
        "successor_sink_trapping"
        (opt-successor-sink-trapping-blocks))]
    (begin
      (unless
        (=
          (opt-successor-sink-def-label
            positive
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "use"))
        (return 1))
      (unless
        (=
          (opt-successor-sink-def-label
            positive
            3
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "use"))
        (return 2))
      (unless
        (=
          (opt-successor-sink-def-label
            multi-use
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 3))
      (unless
        (=
          (opt-successor-sink-def-label
            multi-pred
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 4))
      (unless
        (=
          (opt-successor-sink-def-label
            store-barrier
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 5))
      (unless
        (=
          (opt-successor-sink-def-label
            trapping
            2
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 6))
      (unless
        (= (compiler_optimize.opt-function-frame remat-function) 18)
        (return 7))
      (unless
        (and
          (=
            (opt-successor-sink-def-label
              remat
              2
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry"))
          (=
            (opt-successor-sink-def-label
              remat
              3
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry"))
          (=
            (opt-successor-sink-def-label
              remat
              4
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              remat
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              remat
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              remat
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 8))
      (unless
        (and
          (=
            (opt-successor-sink-def-label
              live-range-blocked
              3
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry"))
          (=
            (opt-successor-sink-def-label
              live-range-blocked
              4
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry")))
        (return 9))
      (unless
        (and
          (=
            (opt-successor-sink-def-label
              terminator-live
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              terminator-live
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 10))
      (unless
        (and
          (= (compiler_optimize.opt-function-frame external-leaf-function) 16)
          (=
            (opt-successor-sink-def-label
              external-leaf
              4
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "entry")))
        (return 11))
      (unless
        (= (compiler_optimize.opt-function-frame remat-cap-function) 16)
        (return 12))
      (unless
        (=
          (opt-successor-sink-def-label
            remat-cap
            8
            (compiler_ir_types.compiler-ir-label-none))
          (compiler_ir_types.compiler-ir-label "entry"))
        (return 13))
      (unless
        (and
          (= (array-ref induction-cell 0) 18)
          (=
            (opt-successor-sink-def-label
              induction-direct
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction-direct
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction-direct
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction-direct
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 14))
      (unless
        (and
          (= (compiler_optimize.opt-function-frame induction-function) 18)
          (=
            (opt-successor-sink-def-label
              induction
              6
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction
              5
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction
              16
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use"))
          (=
            (opt-successor-sink-def-label
              induction
              17
              (compiler_ir_types.compiler-ir-label-none))
            (compiler_ir_types.compiler-ir-label "use")))
        (return 15))
      (unless
        (and
          (=
            (compiler_optimize.opt-function-frame induction-step-two-function)
