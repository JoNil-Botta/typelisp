(define (opt-count-mov-dst-i64-src-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [src : i64]) : i64
  (if (>=
    index
    (compiler_ir_types.compiler-ir-instr-seq-count
      (compiler_optimize.compiler-opt-global-shared-view instrs)))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_optimize.compiler-opt-global-shared-view instrs)
        index)
        [(compiler_ir_types.CompilerIrInstr.Mov mov-dst mov-src _)
          (if (= mov-dst dst)
            (match mov-src
              [(compiler_ir_types.CompilerIrValue.I64 value)
                (if (= value src)
                  1
                  0)]
              [_ 0])
            0)]
        [_ 0])
      (opt-count-mov-dst-i64-src-from
        (compiler_optimize.compiler-opt-global-shared-view instrs)
        (+ index 1)
        dst
        src))))

(define (opt-count-mov-dst-i64-src
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [src : i64]) : i64
  (opt-count-mov-dst-i64-src-from instrs 0 dst src))

