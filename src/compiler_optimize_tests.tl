(define (opt-inline-bounds-leaf-char-symbol) : i64
  (opt-test-symbol "bounds_leaf_char_inline"))

(define (opt-inline-bounds-leaf-owned-symbol) : i64
  (opt-test-symbol "bounds_leaf_owned_inline"))

;; One bounds-leaf shape -- single block, bounds-checked, call-free, two body
;; instructions -- instantiated at two return types. Every other property the
;; admission path reads is held fixed, so an outcome difference between the two
;; instantiations isolates opt-inline-bounds-leaf-return-type?.
(define (opt-inline-bounds-leaf-typed-callee
  [name : i64]
  [ret : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.compiler-ir-function-compact-blocks
    (compiler_ir_types.CompilerIrFunction.Function
      name
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "idx"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "len"
            (compiler_ast_types.AstType.I64)
            1)
          compiler_ir_types.CompilerIrParamList.Nil))
      ret
      3
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "bounds_leaf_typed.ok"))
            (compiler_ir_types.CompilerIrInstr.Mov 2 value ret)
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; Two ordinary call sites with variable arguments: two references make the
;; callee non-absorbable and no argument is constant, so the generic has-bounds
;; policy refuses it and admission can only come from the bounds-leaf path.
(define (opt-inline-call-bounds-leaf-typed-twice
  [symbols : OptInlineBoundsTestSymbols]
  [callee : i64]
  [ret : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            callee
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            ret)
          (compiler_ir_types.CompilerIrInstr.Call
            3
            callee
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 0))
            ret)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 42)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-bounds-leaf-char-functions
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf-typed-twice
      symbols
      (opt-inline-bounds-leaf-char-symbol)
      (compiler_ast_types.AstType.Char))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-typed-callee
        (opt-inline-bounds-leaf-char-symbol)
        (compiler_ast_types.AstType.Char)
        (compiler_ir_types.CompilerIrValue.Char 'A'))
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-leaf-owned-functions
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf-typed-twice
      symbols
      (opt-inline-bounds-leaf-owned-symbol)
      (compiler_ast_types.AstType.String))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-typed-callee
        (opt-inline-bounds-leaf-owned-symbol)
        (compiler_ast_types.AstType.String)
        (compiler_ir_types.CompilerIrValue.String "leaf"))
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-band-symbol) : i64
  (opt-test-symbol "band_inline"))

;; A pure arithmetic chain of exactly `limit` body instructions over two
;; parameters, closed by a Return of the last one. Every instruction writes a
;; fresh variable at or above the parameter count, so the body clears
;; opt-inline-body-instr-ok?, and it carries neither a Call nor a BoundsCheck,
;; which keeps the bounds-leaf path and its 1..48 band out of the decision.
;; Admission then turns on opt-inline-max-body and the cost gate alone.
(define (opt-inline-band-instrs [index : i64] [limit : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (>= index limit)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var (+ limit 1)))))
    (opt-test-instrs-with-tail
      (opt-inline-band-instrs (+ index 1) limit)
      (compiler_ir_types.CompilerIrInstr.BinOp
        (+ index 2)
        (compiler_ir_types.CompilerIrBinOp.Add)
        (if (= index 0)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var (+ index 1)))
        (if (= index 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 1))
        (compiler_ast_types.AstType.I64)))))

(define (opt-inline-band-callee [body : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.compiler-ir-function-compact-blocks
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-inline-band-symbol)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "a"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "b"
            (compiler_ast_types.AstType.I64)
            1)
          compiler_ir_types.CompilerIrParamList.Nil))
      (compiler_ast_types.AstType.I64)
      (+ body 2)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-inline-band-instrs 0 body))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-inline-band-args [const-args? : bool] [first : i64] [second : i64]) : compiler_ir_types.CompilerIrCallArgs
  (if const-args?
    (compiler_ir_types.CompilerIrCallArgs.Two
      (compiler_ir_types.CompilerIrValue.I64 (+ first 3))
      (compiler_ir_types.CompilerIrValue.I64 (+ second 5)))
    (compiler_ir_types.CompilerIrCallArgs.Two
      (compiler_ir_types.CompilerIrValue.Var first)
      (compiler_ir_types.CompilerIrValue.Var second))))

;; Two ordinary call sites, so the callee is never absorbable and the cost
;; gate's 1000-point absorb bonus never fires. `const-args?` selects the only
;; other term that can move the price: literal arguments give the site two
;; constant arguments and 3 * 2 = 6 points of savings, Mov-materialised
;; variables give it none.
(define (opt-inline-band-caller [const-args? : bool]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "main")
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            (opt-inline-band-symbol)
            (opt-inline-band-args const-args? 0 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            (opt-inline-band-symbol)
            (opt-inline-band-args const-args? 1 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-band-functions [body : i64] [const-args? : bool]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-band-caller const-args?)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-band-callee body)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-multi-call-caller [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    6
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 20)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.inline-add
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            symbols.inline-add
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 2))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-multi-call-functions [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-multi-call-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
