(define (opt-divrem-dce-blocks
  [params : compiler_ir_types.CompilerIrParamSeq]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [frame : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        params
        blocks)]
    [used : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array
        frame
        (compiler_optimize.compiler-opt-global-shared-view safe))]
    (compiler_optimize.opt-dce-block-list-array used safe)))

(define (compiler-optimize-divrem-safety-self-test) : i64
  (let
    [i64-params : compiler_ir_types.CompilerIrParamSeq
      (opt-divrem-test-params (compiler_ast_types.AstType.I64))]
    [u64-params : compiler_ir_types.CompilerIrParamSeq
      (opt-divrem-test-params (compiler_ast_types.AstType.U64))]
    [signed-positive : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Gt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [signed-mod-positive : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ge)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [unsigned-nonzero : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        u64-params
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.U64)
          true))]
    [lhs-not-min : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-lhs-not-min-blocks))]
    [zero-reachable : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [neg-one-reachable : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [weak-negative-range : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          true))]
    [cast-unsupported : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-cast-blocks))]
    [rhs-redefined-before-branch : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-rhs-redefined-before-branch-blocks))]
    [rhs-redefined-in-safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-divrem-safety-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-rhs-redefined-in-safe-blocks))]
    [safe-unused : compiler_ir_types.CompilerIrBlockList
      (opt-divrem-dce-blocks
        (compiler_optimize.compiler-opt-global-shared-view i64-params)
        (opt-divrem-branch-blocks
          (compiler_ir_types.CompilerIrBinOp.Gt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          false)
        4)]
    [unproven-unused : compiler_ir_types.CompilerIrBlockList
      (opt-divrem-dce-blocks
        i64-params
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "entry")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                2
                (compiler_ir_types.CompilerIrBinOp.Div)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          compiler_ir_types.CompilerIrBlockList.Nil)
        4)]
    (begin
      (unless
        (=
          (opt-count-binop-op-blocks
            (compiler_optimize.compiler-opt-global-shared-view signed-positive)
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          1)
        (return 1))
      (unless
        (=
          (opt-count-binop-op-blocks
            signed-positive
            (compiler_ir_types.CompilerIrBinOp.Div))
          0)
        (return 2))
      (unless
        (=
          (opt-count-binop-op-blocks
            signed-mod-positive
            (compiler_ir_types.CompilerIrBinOp.SafeMod))
          1)
        (return 3))
      (unless
        (=
          (opt-count-binop-op-blocks
            unsigned-nonzero
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          1)
        (return 4))
      (unless
        (=
          (opt-count-binop-op-blocks
            lhs-not-min
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          1)
        (return 5))
      (unless
        (=
          (opt-count-binop-op-blocks
            zero-reachable
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 6))
      (unless
        (=
          (opt-count-binop-op-blocks
            neg-one-reachable
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 7))
      (unless
        (=
          (opt-count-binop-op-blocks
            weak-negative-range
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 8))
      (unless
        (=
          (opt-count-binop-op-blocks
            cast-unsupported
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 9))
      (unless
        (=
          (opt-count-binop-op-blocks
            rhs-redefined-before-branch
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 10))
      (unless
        (=
          (opt-count-binop-op-blocks
            rhs-redefined-in-safe
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 11))
      (unless
        (=
          (opt-count-binop-op-blocks
            (compiler_optimize.compiler-opt-global-shared-view safe-unused)
            (compiler_ir_types.CompilerIrBinOp.SafeDiv))
          0)
        (return 12))
      (unless
        (=
          (opt-count-binop-op-blocks
            safe-unused
            (compiler_ir_types.CompilerIrBinOp.Div))
          0)
        (return 13))
      (unless
        (=
          (opt-count-binop-op-blocks
            unproven-unused
            (compiler_ir_types.CompilerIrBinOp.Div))
          1)
        (return 14))
      42)))

;; `[BinOp v2 = v0 + v1, BinOp v3 = v0 + v1]` with non-constant operands: CSE
;; rewrites the second into `Mov v3 = v2` (two arithmetic instrs -> one).
(define (opt-cse-self-test-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

;; Shift direction, lhs, rhs value, result, and destination shape are identical
;; here; only the RHS count type differs. The raw I64(-1) is a signed -1 under
;; I8 metadata and the all-ones byte under U8 metadata, so CSE must retain both
;; trapping expressions instead of rewriting the second one to a Mov from the
;; first. A shared Var would be malformed IR because it cannot have both types.
(define (opt-cse-shift-count-type-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      60
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I8))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      61
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
      (compiler_ast_types.AstType.I64))))

(define (opt-shift-binop-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp
        _
        (compiler_ir_types.CompilerIrBinOp.Shl _)
        _
        _
        _)
      1]
    [(compiler_ir_types.CompilerIrInstr.BinOp
        _
        (compiler_ir_types.CompilerIrBinOp.Shr _)
        _
        _
        _)
      1]
    [_ 0]))

(define (opt-count-shift-binops-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-shift-binop-count
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
      (opt-count-shift-binops-from instrs (+ index 1)))))

(define (opt-count-shift-binops [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-shift-binops-from instrs 0))

(define (opt-cse-sqrt-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.UnOp
      2
      (compiler_ir_types.CompilerIrUnOp.Sqrt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.F64))
    (compiler_ir_types.CompilerIrInstr.UnOp
      3
      (compiler_ir_types.CompilerIrUnOp.Sqrt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.F64))))

;; A store between the two identical expressions clears the table, so the second
;; expression is preserved (no cross-store CSE).
(define (opt-cse-store-clears-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      (opt-test-symbol "g")
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

;; Redefining an operand (`v0`) between the two expressions invalidates the
;; available entry, so the second expression is preserved (correctness on
;; non-SSA IR).
(define (opt-cse-operand-redef-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      0
      (compiler_ir_types.CompilerIrValue.I64 5)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))))

(define (opt-cse-probe-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.CpuId
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      1)
    (compiler_ir_types.CompilerIrInstr.CpuId
      3
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      1)
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      4
      (compiler_ir_types.CompilerIrValue.I64 0))
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      5
      (compiler_ir_types.CompilerIrValue.I64 0))))

(define (opt-cse-probe-different-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.CpuId
      2
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.I64 0)
      1)
    (compiler_ir_types.CompilerIrInstr.CpuId
      3
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.I64 0)
      2)
    (compiler_ir_types.CompilerIrInstr.CpuId
      4
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ir_types.CompilerIrValue.I64 1)
      1)
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      5
      (compiler_ir_types.CompilerIrValue.I64 0))
    (compiler_ir_types.CompilerIrInstr.Xgetbv
      6
      (compiler_ir_types.CompilerIrValue.I64 1))))

(define (opt-simd-cse-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Splat
      20
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Splat
      21
      (compiler_ir_types.CompilerIrValue.Var 0)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Splat
      22
      (compiler_ir_types.CompilerIrValue.Var 0)
      8
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      30
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      31
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      32
      (compiler_ir_types.CompilerIrBinOp.Sub)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      33
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      8
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-bin-op
      34
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      4
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.ir-instr-vector-compare
      40
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      41
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      42
      (compiler_ir_types.CompilerIrBinOp.Ne)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      43
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      8
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.ir-instr-vector-compare
      44
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.Var 5)
      4
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.ir-instr-vector-bin-op
      50
      (compiler_ir_types.CompilerIrBinOp.Mul)
      (compiler_ir_types.CompilerIrValue.Var 21)
      (compiler_ir_types.CompilerIrValue.Var 31)
      4
      (compiler_ast_types.AstType.I64))))

(define (compiler-optimize-simd-local-cse-self-test) : i64
  (let
    [input : compiler_ir_types.CompilerIrInstrSeq (opt-simd-cse-instrs)]
    [rewritten : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (compiler_optimize.compiler-opt-global-shared-view input))]
    [copied : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-copy-instrs
        (compiler_optimize.OptCopyEnv.Nil)
        (compiler_optimize.compiler-opt-global-shared-view rewritten))]
    (cond
      [(not (compiler_optimize.opt-scan-cse-dup-from input.slots 0 input.len))
        1]
      [(not
          (=
            (opt-mov-src-var-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              21
              (- 0 1))
            20))
        2]
      [(not
          (=
            (opt-mov-src-var-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              31
              (- 0 1))
            30))
        3]
      [(not
          (=
            (opt-mov-src-var-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              41
              (- 0 1))
            40))
        4]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              22)
            0))
        5]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              32)
            0))
        6]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              33)
            0))
        7]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              34)
            0))
        8]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              42)
            0))
        9]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              43)
            0))
        10]
      [(not
          (=
            (opt-count-mov-dst-instr-seq
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              44)
            0))
        11]
      [(not (= (opt-vector-binop-lhs-var copied 50) 20)) 12]
      [else 42])))

;; Returns 42 when CSE eliminates the repeated pure expression (2 arithmetic
;; instrs -> 1) yet preserves the second expression both across an intervening
;; store and across an operand redefinition (still 2 arithmetic instrs each).
;; It also CSEs identical CPU probes while preserving probes with different
;; register indices or operands.
;; Self-test: const-global propagation. Verifies the immutability proof and the
;; operand rewrite it feeds.
;;
;; ADMITTED: a global with a literal `I64` initialiser that the program never
;; stores to and never takes the address of, whose value fits a signed 32-bit
;; immediate. `zero` (value 0) is a member like any other value -- the exclusion
;; that used to keep it out was a divisor-position rule, not an immutability one.
;;
;; REFUSED: `mut` (a `Store` anywhere in the program), `borrowed` (a `GlobalAddr`
;; anywhere), `uninit` and `runtime` (no literal initialiser -- `runtime` carries
;; the `CompilerIrValue.RuntimeGlobal` form that lowering gives a global whose
;; initialiser is evaluated by a startup `__global_init_*` function, so a
;; startup-initialised global can never be folded), and `big` (wider than an
;; imm32: `global_cell` already keeps such a constant in one hoisted register,
;; which beats a per-use `movabs` -- see opt-const-globals-imm32-fits?).
;;
;; REWRITE: every use of an admitted global becomes its literal, EXCEPT a div/mod
;; divisor whose constant is zero, which keeps its trapping global-load form.
;; A bounds check whose index is an admitted global becomes a literal check,
;; which is what lets SCCP discharge it -- the intern_table P6 shape.
(defstruct OptConstDivisorTestSymbols
  (konst i64)
  (mutable i64)
  (uninit i64)
  (borrowed i64)
  (zero i64)
  (big i64)
  (runtime i64))

(define (opt-const-divisor-test-symbols) : OptConstDivisorTestSymbols
  (OptConstDivisorTestSymbols
    (opt-test-symbol "konst")
    (opt-test-symbol "mut")
    (opt-test-symbol "uninit")
    (opt-test-symbol "borrowed")
    (opt-test-symbol "zero")
    (opt-test-symbol "big")
    (opt-test-symbol "runtime")))

(define (opt-const-divisor-test-globals [symbols : OptConstDivisorTestSymbols]) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [builder : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 7)]
    (begin
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.konst
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 1000000007))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.mutable
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 7))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.uninit
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.Unit))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.borrowed
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 99))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.zero
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.big
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 4294967295))
      ;; The shape lowering gives a global whose initialiser is not a
      ;; compile-time constant: the value is the startup initialiser function,
      ;; not a literal, so the table can never see a value to fold.
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.runtime
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.RuntimeGlobal
          (opt-test-symbol "__global_init_runtime")))
      (compiler_ir_types.compiler-ir-global-builder-to-seq builder))))

(define (opt-const-divisor-test-blocks [symbols : OptConstDivisorTestSymbols]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          11
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.mutable)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          12
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.uninit)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          13
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          14
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.borrowed)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          15
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.zero)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          16
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.big)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          17
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          18
          (compiler_ir_types.CompilerIrBinOp.BitXor)
          (compiler_ir_types.CompilerIrValue.Var 17)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          19
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          21
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 19)
          (compiler_ast_types.AstType.I64))
        ;; A zero-valued constant global in a DIVISOR position keeps its load.
        (compiler_ir_types.CompilerIrInstr.BinOp
          22
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.zero)
          (compiler_ast_types.AstType.I64))
        ;; A wide constant global is refused on profitability, everywhere.
        (compiler_ir_types.CompilerIrInstr.BinOp
          23
          (compiler_ir_types.CompilerIrBinOp.Div)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.big)
          (compiler_ast_types.AstType.I64))
        ;; A startup-initialised global is not foldable in any position.
        (compiler_ir_types.CompilerIrInstr.BinOp
          24
          (compiler_ir_types.CompilerIrBinOp.BitAnd)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Global symbols.runtime)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          20
          (compiler_ir_types.CompilerIrValue.GlobalAddr symbols.borrowed)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Store
          symbols.mutable
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 10)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

(define (opt-const-divisor-test-rhs-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index count)
    (compiler_ir_types.CompilerIrValue.Unit)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.BinOp d _ _ rhs _)
        (if (= d dst)
          rhs
          (opt-const-divisor-test-rhs-in-seq instrs (+ index 1) count dst))]
      [_ (opt-const-divisor-test-rhs-in-seq instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-rhs
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrValue.Unit)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-const-divisor-test-rhs-in-seq
            (compiler_ir_types.compiler-ir-global-shared-view instrs)
            0
            (compiler_ir_types.compiler-ir-instr-seq-count
              (compiler_ir_types.compiler-ir-global-shared-view instrs))
            dst)])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-rhs
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-const-divisor-test-mov-src-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index count)
    (compiler_ir_types.CompilerIrValue.Unit)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.Mov d src _)
        (if (= d dst)
          src
          (opt-const-divisor-test-mov-src-in-seq instrs (+ index 1) count dst))]
      [_ (opt-const-divisor-test-mov-src-in-seq instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-mov-src
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : compiler_ir_types.CompilerIrValue
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrValue.Unit)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-const-divisor-test-mov-src-in-seq
            (compiler_ir_types.compiler-ir-global-shared-view instrs)
            0
            (compiler_ir_types.compiler-ir-instr-seq-count
              (compiler_ir_types.compiler-ir-global-shared-view instrs))
            dst)])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-mov-src
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; The intern_table P6 shape end to end: a never-written literal global read as
;; an ordinary operand of a compare, and the SAME global standing as the index
;; operand of a bounds check. Once the const-global rewrite has turned both into
;; literals, SCCP must fold the compare to a constant (the BinOp becomes a Mov of
;; the decided value) and discharge the in-range check outright.
(define (opt-const-divisor-test-sccp-blocks
  [symbols : OptConstDivisorTestSymbols]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          30
          (compiler_ir_types.CompilerIrValue.Global symbols.konst)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          31
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 30)
          (compiler_ir_types.CompilerIrValue.I64 2000000000)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Global symbols.zero)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 31)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-const-divisor-test-binop-dst-in-seq?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [dst : i64]) : bool
  (if (>= index count)
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.BinOp found _ _ _ _)
        (if (= found dst)
          true
          (opt-const-divisor-test-binop-dst-in-seq?
            instrs
            (+ index 1)
            count
            dst))]
      [_
        (opt-const-divisor-test-binop-dst-in-seq? instrs (+ index 1) count dst)])))

(define (opt-const-divisor-test-binop-dst?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : bool
  (match (compiler_ir_types.compiler-ir-global-shared-view blocks)
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match (compiler_ir_types.compiler-ir-global-shared-view block)
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (opt-const-divisor-test-binop-dst-in-seq?
            (compiler_ir_types.compiler-ir-global-shared-view instrs)
            0
            (compiler_ir_types.compiler-ir-instr-seq-count instrs)
            dst)
            true
            (opt-const-divisor-test-binop-dst?
              (compiler_ir_types.compiler-ir-box-shared-view rest)
              dst))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-binop-dst?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

(define (opt-const-divisor-test-bounds-index-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : compiler_ir_types.CompilerIrValue
  (if (>= index count)
    (compiler_ir_types.CompilerIrValue.Unit)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      index)
      [(compiler_ir_types.CompilerIrInstr.BoundsCheck idx _ _) idx]
      [_ (opt-const-divisor-test-bounds-index-in-seq instrs (+ index 1) count)])))

(define (opt-const-divisor-test-is-unit?
  [v : compiler_ir_types.CompilerIrValue]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.Unit) true]
    [_ false]))

;; `Unit` when the blocks carry no bounds check at all, which is how the SCCP
;; leg asserts the check was discharged rather than merely rewritten.
(define (opt-const-divisor-test-bounds-index
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrValue
  (match (compiler_ir_types.compiler-ir-global-shared-view blocks)
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler_ir_types.CompilerIrValue.Unit)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (let
        [found : compiler_ir_types.CompilerIrValue
          (match (compiler_ir_types.compiler-ir-global-shared-view block)
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
              (opt-const-divisor-test-bounds-index-in-seq
                (compiler_ir_types.compiler-ir-global-shared-view instrs)
                0
                (compiler_ir_types.compiler-ir-instr-seq-count instrs))])]
        (if (opt-const-divisor-test-is-unit?
          (compiler_ir_types.compiler-ir-global-shared-view found))
          (opt-const-divisor-test-bounds-index
            (compiler_ir_types.compiler-ir-box-shared-view rest))
          found))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-const-divisor-test-bounds-index
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-const-divisor-test-is-i64?
  [v : compiler_ir_types.CompilerIrValue]
  [n : i64]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.I64 m) (= m n)]
    [_ false]))

(define (opt-const-divisor-test-is-global?
  [v : compiler_ir_types.CompilerIrValue]
  [name : String]) : bool
  (match v
    [(compiler_ir_types.CompilerIrValue.Global m)
      (string.eq (compiler_ir_types.compiler-ir-symbol-text m) name)]
    [_ false]))

(define (compiler-optimize-const-divisor-self-test) : i64
  (let
    [symbols : OptConstDivisorTestSymbols (opt-const-divisor-test-symbols)]
    [globals : compiler_ir_types.CompilerIrGlobalSeq
      (opt-const-divisor-test-globals symbols)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-const-divisor-test-blocks symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "f")
          (compiler_ir_types.compiler-ir-param-seq-empty)
          (compiler_ast_types.AstType.I64)
          16
          (compiler_optimize.compiler-opt-global-shared-view blocks))
        (compiler_ir_types.compiler-ir-function-seq-empty))]
    [table : opt_i64_i64_map.Map
      (compiler_optimize.opt-const-divisors-build globals functions)]
    [rewritten : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-const-divisor-rewrite-blocks
        (compiler_optimize.compiler-opt-global-shared-view table)
        (compiler_optimize.compiler-opt-global-shared-view blocks))]
    [move-rewritten : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-const-global-move-rewrite-blocks
        (compiler_optimize.compiler-opt-global-shared-view table)
        (compiler_optimize.opt-const-global-move-fold-vars-blocks
          (opt_i64_i64_map.with-capacity 8)
          (compiler_optimize.compiler-opt-global-shared-view blocks))
        blocks)]
    ;; The P6 leg: run the same rewrite the pipeline runs at the top of the
    ;; level-2 iteration, then hand the result to SCCP exactly as the pipeline's
    ;; sccp slot does.
    [sccp-input : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-const-divisor-rewrite-blocks
        (compiler_optimize.compiler-opt-global-shared-view table)
        (opt-const-divisor-test-sccp-blocks symbols))]
    [sccp-folded : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-sccp-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (compiler_optimize.compiler-opt-global-shared-view sccp-input))]
    (cond
      [(not (opt_i64_i64_map.contains? (& table) symbols.konst)) 1]
      [(not
          (match (opt_i64_i64_map.get (& table) symbols.konst)
            [(opt_i64_i64_map.LookupFound n) (= n 1000000007)]
            [(opt_i64_i64_map.LookupMissing) false]))
        2]
      [(opt_i64_i64_map.contains? (& table) symbols.mutable) 3]
      [(opt_i64_i64_map.contains? (& table) symbols.uninit) 4]
      [(opt_i64_i64_map.contains? (& table) symbols.borrowed) 5]
      [(not
          (match (opt_i64_i64_map.get (& table) symbols.zero)
            [(opt_i64_i64_map.LookupFound n) (= n 0)]
            [(opt_i64_i64_map.LookupMissing) false]))
        6]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (compiler_ir_types.compiler-ir-global-shared-view rewritten)
              10)
            1000000007))
        7]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              13)
            1000000007))
        8]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              11)
            "mut"))
        9]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              12)
            "uninit"))
        10]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              14)
            "borrowed"))
        11]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-rhs
              (compiler_optimize.compiler-opt-global-shared-view rewritten)
              15)
            0))
        12]
      [(opt_i64_i64_map.contains?
          (& table)
          (compiler_ir_types.compiler-ir-symbol-id symbols.big))
        13]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_ir_types.compiler-ir-global-shared-view rewritten)
              16)
            "big"))
        14]
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-mov-src
              (compiler_optimize.compiler-opt-global-shared-view move-rewritten)
              17)
            1000000007))
        15]
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-mov-src move-rewritten 19)
            "konst"))
        16]
      ;; A zero divisor is the one position an admitted global is NOT
      ;; substituted into.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_ir_types.compiler-ir-global-shared-view rewritten)
              22)
            "zero"))
        17]
      ;; ... and so is a wide constant, in a divisor position like any other.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_ir_types.compiler-ir-global-shared-view rewritten)
              23)
            "big"))
        18]
      ;; A startup-initialised global never enters the table ...
      [(opt_i64_i64_map.contains?
          (& table)
          (compiler_ir_types.compiler-ir-symbol-id symbols.runtime))
        19]
      ;; ... and so keeps its hidden-load form at every use.
      [(not
          (opt-const-divisor-test-is-global?
            (opt-const-divisor-test-rhs
              (compiler_ir_types.compiler-ir-global-shared-view rewritten)
              24)
            "runtime"))
        20]
      ;; P6, before SCCP: the bounds check's INDEX operand is now the literal.
      [(not
          (opt-const-divisor-test-is-i64?
            (opt-const-divisor-test-bounds-index sccp-input)
            0))
        21]
      ;; P6, after SCCP: the in-range check is discharged outright ...
      [(not
          (opt-const-divisor-test-is-unit?
            (opt-const-divisor-test-bounds-index
              (compiler_ir_types.compiler-ir-global-shared-view sccp-folded))))
        22]
      ;; ... and the dependent compare folded to a constant, so no BinOp
      ;; computes it any more.
      [(opt-const-divisor-test-binop-dst? sccp-folded 31) 23]
      [else 42])))

(define (compiler-optimize-cse-self-test) : i64
  (let
    [cse : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-self-test-instrs))]
    [sqrt : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-sqrt-instrs))]
    [store : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-store-clears-instrs))]
    [redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-operand-redef-instrs))]
    [probe : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-probe-instrs))]
    [probe-different : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-probe-different-instrs))]
    [shift-count-types : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-cse-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptExprTable.Nil)
        (opt-cse-shift-count-type-instrs))]
    (begin
      (unless
        (=
          (opt-count-arith-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view cse))
          1)
        (return 1))
      (unless
        (=
          (opt-mov-src-var-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view sqrt)
            3
            (- 0 1))
          2)
        (return 10))
      (unless
        (=
          (opt-count-arith-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view store))
          2)
        (return 2))
      (unless
        (=
          (opt-count-arith-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view redef))
          2)
        (return 3))
      (unless
        (=
          (opt-count-cpuid-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view probe))
          1)
        (return 4))
      (unless
        (=
          (opt-mov-src-var-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view probe)
            3
            (- 0 1))
          2)
        (return 5))
      (unless
        (=
          (opt-count-xgetbv-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view probe))
          1)
        (return 6))
      (unless
        (=
          (opt-mov-src-var-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view probe)
            5
            (- 0 1))
          4)
        (return 7))
      (unless
        (=
          (opt-count-cpuid-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view probe-different))
          3)
        (return 8))
      (unless
        (=
          (opt-count-xgetbv-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view probe-different))
          2)
        (return 9))
      (unless
        (=
          (opt-count-shift-binops
            (compiler_ir_types.compiler-ir-global-shared-view shift-count-types))
          2)
        (return 10))
      (unless
        (=
          (opt-count-mov-dst-instr-seq
            (compiler_ir_types.compiler-ir-global-shared-view shift-count-types)
            61)
          0)
        (return 11))
      42)))

;; --- cross-block GVN self-tests ---------------------------------------------
(define (opt-gvn-test-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "a"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "b"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(define (opt-gvn-count-binops-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-arith-instr-seq instrs)
            (opt-gvn-count-binops-blocks
              (compiler_ir_types.compiler-ir-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-gvn-count-binops-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

;; Diamond: `a + b` computed in the entry block and recomputed in the
;; post-dominating join. The entry strictly dominates the join, so the join's
;; expression is rewritten to a copy and the binop count drops from 2 to 1.
(define (opt-gvn-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "l")
          (compiler_ir_types.compiler-ir-label "r"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "l")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "j"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "r")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "j"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "j")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                11
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 11)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Two sibling arms each compute `a + b`, and the join recomputes it. Neither arm
;; strictly dominates the join, so no cross-block CSE fires and all 3 binops stay.
(define (opt-gvn-siblings-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "l")
          (compiler_ir_types.compiler-ir-label "r"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "l")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            10
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "j"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "r")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              11
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "j"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "j")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                12
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 12)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; The shared operand `v2` is reassigned in each block, so it has two value
;; sources and is not stable. Even though the entry dominates the join, the two
;; `v0 + v2` expressions compute different values and must not be CSE'd: 2 binops.
(define (opt-gvn-redef-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          10
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "j"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "j")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            2
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            11
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 11)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

;; Loop: the header computes `a + b` and the body recomputes it. The header
;; strictly dominates the body, so the body's expression is rewritten: 2 -> 1.
(define (opt-gvn-loop-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "h"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "h")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            10
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              11
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "h"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 10)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-gvn-probe-dominated-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.CpuId
          20
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          1)
        (compiler_ir_types.CompilerIrInstr.Xgetbv
          21
          (compiler_ir_types.CompilerIrValue.I64 0))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CpuId
            22
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ir_types.CompilerIrValue.I64 0)
            1)
          (compiler_ir_types.CompilerIrInstr.Xgetbv
            23
            (compiler_ir_types.CompilerIrValue.I64 0))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 23)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-gvn-probe-different-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.CpuId
          20
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          1)
        (compiler_ir_types.CompilerIrInstr.Xgetbv
          21
          (compiler_ir_types.CompilerIrValue.I64 0))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CpuId
            22
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ir_types.CompilerIrValue.I64 0)
            2)
          (compiler_ir_types.CompilerIrInstr.CpuId
            23
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ir_types.CompilerIrValue.I64 1)
            1)
          (compiler_ir_types.CompilerIrInstr.Xgetbv
            24
            (compiler_ir_types.CompilerIrValue.I64 1))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 24)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

;; Returns 42 only when cross-block GVN rewrites dominated repeats (diamond and
;; loop drop to 1 binop), leaves non-dominating siblings alone (3 binops), and
;; refuses to CSE across a reassigned operand (2 binops). CPU probes are reused
;; only when an identical probe is available from a strict dominator.
(define (compiler-optimize-gvn-self-test) : i64
  (let
    [probe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-test-params)
        (opt-gvn-probe-dominated-blocks))]
    [probe-different : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-test-params)
        (opt-gvn-probe-different-blocks))]
    (begin
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-diamond-blocks)))
          1)
        (return 1))
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-siblings-blocks)))
          3)
        (return 2))
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-redef-blocks)))
          2)
        (return 3))
      (unless
        (=
          (opt-gvn-count-binops-blocks
            (compiler_optimize.opt-gvn-blocks
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (opt-gvn-test-params)
              (opt-gvn-loop-blocks)))
          1)
        (return 4))
      (unless
        (=
          (opt-count-cpuid-blocks
            (compiler_optimize.compiler-opt-global-shared-view probe))
          1)
        (return 5))
      (unless
        (=
          (opt-blocks-mov-src-var
            (compiler_optimize.compiler-opt-global-shared-view probe)
            22
            (- 0 1))
          20)
        (return 6))
      (unless
        (=
          (opt-count-xgetbv-blocks
            (compiler_optimize.compiler-opt-global-shared-view probe))
          1)
        (return 7))
      (unless (= (opt-blocks-mov-src-var probe 23 (- 0 1)) 21) (return 8))
      (unless
        (=
          (opt-count-cpuid-blocks
            (compiler_optimize.compiler-opt-global-shared-view probe-different))
          3)
        (return 9))
      (unless (= (opt-count-xgetbv-blocks probe-different) 2) (return 10))
      42)))

(define (opt-simd-gvn-kind-count-instr
  [instr : compiler_ir_types.CompilerIrInstr]
  [kind : i64]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Splat _ _ _ _)
      (if (= kind 0)
        1
        0)]
    [(compiler_ir_types.CompilerIrInstr.VectorBinOp _)
      (if (= kind 1)
        1
        0)]
    [(compiler_ir_types.CompilerIrInstr.VectorCompare _)
      (if (= kind 2)
        1
        0)]
    [_ 0]))

(define (opt-simd-gvn-kind-count-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [kind : i64]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-simd-gvn-kind-count-instr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        kind)
      (opt-simd-gvn-kind-count-seq instrs kind (+ index 1)))))

(define (opt-simd-gvn-kind-count-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [kind : i64]) : i64
  (match (compiler_ir_types.compiler-ir-global-shared-view blocks)
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match (compiler_ir_types.compiler-ir-global-shared-view block)
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-simd-gvn-kind-count-seq
              (compiler_ir_types.compiler-ir-global-shared-view instrs)
              kind
              0)
            (opt-simd-gvn-kind-count-blocks
              (compiler_ir_types.compiler-ir-block-list-box-shared-view rest)
              kind))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-simd-gvn-kind-count-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        kind)]))

(define (opt-simd-gvn-dominated-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 0)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.ir-instr-vector-bin-op
          11
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ir_types.CompilerIrValue.Var 10)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.ir-instr-vector-compare
          12
          (compiler_ir_types.CompilerIrBinOp.Eq)
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.CompilerIrValue.Var 11)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "child"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "child")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Splat
            20
            (compiler_ir_types.CompilerIrValue.Var 0)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-bin-op
            21
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 10)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-compare
            22
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.CompilerIrValue.Var 11)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 22)))))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-simd-gvn-sibling-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 0)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "left")
          (compiler_ir_types.compiler-ir-label "right"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "left")
        (opt-test-instrs
          (compiler_ir_types.ir-instr-vector-bin-op
            20
            (compiler_ir_types.CompilerIrBinOp.Add)
