            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-devirt-local-alias-caller [duplicate? : bool]) : compiler_ir_types.CompilerIrFunction
  (let
    [target : i64 (opt-test-symbol "local_alias_target")]
    [entry-tail : compiler_ir_types.CompilerIrInstrSeq
      (if duplicate?
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.Function
              (opt-test-symbol "local_alias_other"))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "call")))
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "call"))))]
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "local_alias_caller")
      compiler_ir_types.CompilerIrParamList.Nil
      (compiler_ast_types.AstType.I64)
      2
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instrs-with-tail
            entry-tail
            (compiler_ir_types.CompilerIrInstr.Mov
              0
              (compiler_ir_types.CompilerIrValue.Function target)
              (compiler_ast_types.AstType.I64))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "call")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.CallIndirect
                1
                (compiler_ir_types.CompilerIrValue.Var 0)
                compiler_ir_types.CompilerIrCallArgs.Nil
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 1)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-devirt-reach-target) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "kept_target")
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 7)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-devirt-reach-main) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "main")
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.CallIndirect
            1
            (compiler_ir_types.CompilerIrValue.Function
              (opt-test-symbol "kept_target"))
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 1)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-devirt-reach-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-devirt-reach-main)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-devirt-reach-target)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-test-function-named "dead" (opt-global-dce-return-instrs 9))
          (compiler_ir_types.compiler-ir-function-seq-empty))))
    (compiler_ir_types.compiler-ir-extern-seq-empty)))

(define (opt-inline-count-binop-dst-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.BinOp d _ _ _ _)
          (if (= d dst)
            1
            0)]
        [_ 0])
      (opt-inline-count-binop-dst-from instrs (+ index 1) dst))))

(define (opt-inline-count-binop-dst
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-inline-count-binop-dst-from instrs 0 dst))

(define (opt-count-direct-call-name-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [name : String]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-direct-call-name-instr-seq-from
      slots
      (+ index 1)
      count
      name
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Call _ call-name _ _)
            (if (string.eq
              (compiler_ir_types.compiler-ir-symbol-text call-name)
              name)
              1
              0)]
          [_ 0])))))

(define (opt-count-direct-call-name-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [name : String]) : i64
  (opt-count-direct-call-name-instr-seq-from instrs.slots 0 instrs.len name 0))

(define (opt-count-direct-call-name-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : String]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-direct-call-name-instr-seq instrs name)
            (opt-count-direct-call-name-blocks (__tl-box-place rest) name))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-direct-call-name-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        name)]))

(define (opt-count-direct-call-name-function-seq
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [func-name : String]
  [call-name : String]) : i64
  (match (compiler_optimize.opt-function-seq-find functions func-name)
    [(compiler_optimize.OptMaybeFunction.Some func)
      (opt-count-direct-call-name-blocks
        (compiler_optimize.opt-function-blocks func)
        call-name)]
    [(compiler_optimize.OptMaybeFunction.No) (- 0 1)]))

(define (opt-count-indirect-call-instrs-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.CallIndirect _ _ _ _) 1]
        [(compiler_ir_types.CompilerIrInstr.CallIndirectC _ _ _ _) 1]
        [_ 0])
      (opt-count-indirect-call-instrs-from instrs (+ index 1)))))

(define (opt-count-indirect-call-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-indirect-call-instrs-from instrs 0))

(define (opt-count-indirect-call-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-indirect-call-instrs instrs)
            (opt-count-indirect-call-blocks (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-indirect-call-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-inline-mov-dst-src-from?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [src : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov
          d
          (compiler_ir_types.CompilerIrValue.Var s)
          _)
        (if (and (= d dst) (= s src))
          true
          (opt-inline-mov-dst-src-from? instrs (+ index 1) dst src))]
      [_ (opt-inline-mov-dst-src-from? instrs (+ index 1) dst src)])))

(define (opt-inline-mov-dst-src?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [src : i64]) : bool
  (opt-inline-mov-dst-src-from? instrs 0 dst src))

(define (opt-inline-function-instrs
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [name : String]) : compiler_ir_types.CompilerIrInstrSeq
  (match (compiler_optimize.opt-function-seq-find functions name)
    [(compiler_optimize.OptMaybeFunction.Some func)
      (opt-function-first-instrs func)]
    [(compiler_optimize.OptMaybeFunction.No)
      (compiler_ir_types.compiler-ir-instr-seq-empty)]))

(define (opt-inline-function-frame
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [name : String]) : i64
  (match (compiler_optimize.opt-function-seq-find functions name)
    [(compiler_optimize.OptMaybeFunction.Some func)
      (compiler_optimize.opt-function-frame func)]
    [(compiler_optimize.OptMaybeFunction.No) (- 0 1)]))

(define (compiler-optimize-inline-level-gate-ok?) : bool
  (let
    [level0 : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs (opt-inline-level-functions 0) "main")]
    [level1 : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs (opt-inline-level-functions 1) "main")]
    [level2 : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs (opt-inline-level-functions 2) "main")]
    (and
      (= (opt-count-direct-call-name-instr-seq level0 "inline_add") 1)
      ;; Level 1 runs the call-free tiny-leaf pass, which admits the
      ;; inline_add fixture; only level 0 leaves the call in place.
      (= (opt-count-direct-call-name-instr-seq level1 "inline_add") 0)
      (= (opt-count-direct-call-name-instr-seq level2 "inline_add") 0))))

(define (compiler-optimize-inline-self-recursive-ok?) : bool
  (let
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-self-recursive)
        (compiler_ir_types.compiler-ir-function-seq-empty))]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        functions
        2)]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "self_inline")]
    (= (opt-count-direct-call-name-instr-seq instrs "self_inline") 1)))

(define (compiler-optimize-inline-large-callee-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-large-functions symbols)
        2)]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    (= (opt-count-direct-call-name-instr-seq instrs "too_large_inline") 1)))

;; --- two admitted multiblock candidates in one block --------------------------
;;
;; Both land. The scan used to take at most one multiblock rewrite per block and
;; hand the suffix to the single-block walk, so whichever admitted candidate came
;; first claimed the block and evicted every later one -- the opposite of the
;; "never evict a banked inline" invariant the gate comments assert. The suffix
;; now goes back through the same scan, which makes that invariant structural.
(define (opt-inline-mb2-branch-blocks
  [body : compiler_ir_types.CompilerIrInstrSeq]
  [value : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        body)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 value)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-inline-mb2-small-callee [name : i64] [value : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    (opt-inline-branch-params)
    (compiler_ast_types.AstType.I64)
    2
    (opt-inline-mb2-branch-blocks
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 value)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 1))))
      value)))

(define (opt-inline-mb2-big-instrs [idx : i64] [limit : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (> idx limit)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var idx))))
    (opt-test-instrs-with-tail
      (opt-inline-mb2-big-instrs (+ idx 1) limit)
      (compiler_ir_types.CompilerIrInstr.BinOp
        (+ idx 1)
        (compiler_ir_types.CompilerIrBinOp.Add)
        (if (= idx 0)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrValue.Var idx))
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64)))))

;; Same shape, far past every body budget: the second candidate is refused and
;; the scan has to stop cleanly on the block the first one already rewrote.
(define (opt-inline-mb2-big-limit) : i64
  200)

(define (opt-inline-mb2-big-callee [name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    (opt-inline-branch-params)
    (compiler_ast_types.AstType.I64)
    (+ (opt-inline-mb2-big-limit) 3)
    (opt-inline-mb2-branch-blocks
      (opt-inline-mb2-big-instrs 0 (opt-inline-mb2-big-limit))
      5)))

(define (opt-inline-mb2-caller [name : i64] [first : i64] [second : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            first
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.Bool true))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            1
            second
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.Bool false))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-mb2-program
  [caller : compiler_ir_types.CompilerIrFunction]
  [first : compiler_ir_types.CompilerIrFunction]
  [second : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      caller
      (compiler_ir_types.compiler-ir-function-seq-prepend
        first
        (compiler_ir_types.compiler-ir-function-seq-prepend
          second
          (compiler_ir_types.compiler-ir-function-seq-empty))))
    2))

(define (opt-inline-mb2-extra-caller [name : i64] [callee : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            callee
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.Bool true))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-mb2-shared-program
  [caller : compiler_ir_types.CompilerIrFunction]
  [first : compiler_ir_types.CompilerIrFunction]
  [second : compiler_ir_types.CompilerIrFunction]
  [extra1 : compiler_ir_types.CompilerIrFunction]
  [extra2 : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      caller
      (compiler_ir_types.compiler-ir-function-seq-prepend
        first
        (compiler_ir_types.compiler-ir-function-seq-prepend
          second
          (compiler_ir_types.compiler-ir-function-seq-prepend
            extra1
            (compiler_ir_types.compiler-ir-function-seq-prepend
              extra2
              (compiler_ir_types.compiler-ir-function-seq-empty))))))
    2))

(define (opt-inline-mb2-main-blocks
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [name : String]) : compiler_ir_types.CompilerIrBlockList
  (match (compiler_optimize.opt-function-seq-find functions name)
    [(compiler_optimize.OptMaybeFunction.Some func)
      (compiler_optimize.opt-function-blocks func)]
    [(compiler_optimize.OptMaybeFunction.No)
      compiler_ir_types.CompilerIrBlockList.Nil]))

(define (opt-inline-mb2-main-verified?
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [name : String]) : bool
  (match (compiler_optimize.opt-function-seq-find functions name)
    [(compiler_optimize.OptMaybeFunction.Some func)
      (compiler_optimize.opt-verify-ok?
        (compiler_optimize.opt-verify-function func))]
    [(compiler_optimize.OptMaybeFunction.No) false]))

(define (compiler-optimize-inline-two-multiblock-self-test) : i64
  (let
    [main-name : i64 (opt-test-symbol "mb2_main")]
    [a-name : i64 (opt-test-symbol "mb2_a")]
    [b-name : i64 (opt-test-symbol "mb2_b")]
    [big-name : i64 (opt-test-symbol "mb2_big")]
    [both : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-mb2-program
        (opt-inline-mb2-caller main-name a-name b-name)
        (opt-inline-mb2-small-callee a-name 7)
        (opt-inline-mb2-small-callee b-name 11))]
    [both-blocks : compiler_ir_types.CompilerIrBlockList
      (opt-inline-mb2-main-blocks both "mb2_main")]
    ;; `mb2_big` is referenced three times, so no site can claim it by
    ;; absorption, and its body is far past what the duplicating clauses buy.
    [fuel : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-mb2-shared-program
        (opt-inline-mb2-caller main-name a-name big-name)
        (opt-inline-mb2-small-callee a-name 7)
        (opt-inline-mb2-big-callee big-name)
        (opt-inline-mb2-extra-caller (opt-test-symbol "mb2_extra1") big-name)
        (opt-inline-mb2-extra-caller (opt-test-symbol "mb2_extra2") big-name))]
    [fuel-blocks : compiler_ir_types.CompilerIrBlockList
      (opt-inline-mb2-main-blocks fuel "mb2_main")]
    (cond
      ;; both admitted candidates land: neither call survives
      [(not (= (opt-count-direct-call-name-blocks both-blocks "mb2_a") 0)) 1]
      [(not (= (opt-count-direct-call-name-blocks both-blocks "mb2_b") 0)) 2]
      ;; entry + 3 cloned + cont, twice over: the second split carves the
      ;; continuation the first one opened
      [(not (= (compiler_ir_types.compiler-ir-block-list-count both-blocks) 9))
        3]
      [(not (opt-inline-mb2-main-verified? both "mb2_main")) 4]
      ;; the refused second candidate leaves the first one banked
      [(not (= (opt-count-direct-call-name-blocks fuel-blocks "mb2_a") 0)) 5]
      [(not (= (opt-count-direct-call-name-blocks fuel-blocks "mb2_big") 1)) 6]
      [(not (= (compiler_ir_types.compiler-ir-block-list-count fuel-blocks) 5))
        7]
      [(not (opt-inline-mb2-main-verified? fuel "mb2_main")) 8]
      [else 42])))

(define (compiler-optimize-inline-bounds-callee-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-functions symbols)
        2)]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    (and
      (= (opt-count-direct-call-name-instr-seq instrs "bounds_inline") 0)
      (= (opt-count-bounds-instrs instrs) 1)
      (> (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
        [(compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.I64 index)
            (compiler_ir_types.CompilerIrValue.I64 length)
            label)
          (and
            (= index 0)
            (= length 4)
            (not (not (compiler_ir_types.compiler-ir-label-some? label)))
            (not
              (= label (compiler_ir_types.compiler-ir-label "bounds_inline.ok"))))]
        [_ false]))))

(define (compiler-optimize-inline-bounds-labels-distinct-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-twice-functions symbols)
        2)]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    (and
      (= (opt-count-direct-call-name-instr-seq instrs "bounds_inline") 0)
      (= (opt-count-bounds-instrs instrs) 2)
      (> (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
        [(compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.I64 first-index)
            (compiler_ir_types.CompilerIrValue.I64 first-length)
            first-label)
          (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 2)
            [(compiler_ir_types.CompilerIrInstr.BoundsCheck
                (compiler_ir_types.CompilerIrValue.I64 second-index)
                (compiler_ir_types.CompilerIrValue.I64 second-length)
                second-label)
              (and
                (= first-index 0)
                (= first-length 4)
                (= second-index 1)
                (= second-length 4)
                (not
                  (not (compiler_ir_types.compiler-ir-label-some? first-label)))
                (not
                  (not (compiler_ir_types.compiler-ir-label-some? second-label)))
                (not (= first-label second-label))
                (not
                  (=
                    first-label
                    (compiler_ir_types.compiler-ir-label "bounds_inline.ok")))
                (not
                  (=
                    second-label
                    (compiler_ir_types.compiler-ir-label "bounds_inline.ok"))))]
            [_ false])]
        [_ false]))))

(define (compiler-optimize-inline-bounds-label-guard-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-twice-functions symbols)
        2)]
    [duplicate : compiler_ir_types.CompilerIrFunction
      (opt-inline-duplicate-bounds-label-function symbols)]
    [fallback : compiler_ir_types.CompilerIrFunction
      (opt-inline-frame-caller (opt-inline-frame-test-symbols))]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (and
          (compiler_optimize.opt-inline-structure-ok?
            (compiler_optimize.opt-function-blocks main))
          (not
            (compiler_optimize.opt-inline-structure-ok?
              (compiler_optimize.opt-function-blocks duplicate)))
          (compiler_optimize.opt-function-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_optimize.opt-inline-revert-or-keep fallback duplicate)
            fallback))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (compiler-optimize-inline-bounds-leaf-body-gate-ok?) : bool
  (let
    [accepted-symbols : OptInlineBoundsTestSymbols
      (opt-inline-bounds-test-symbols)]
    [rejected-symbols : OptInlineBoundsTestSymbols
      (opt-inline-bounds-test-symbols)]
    [accepted : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-functions
          accepted-symbols
          (compiler_optimize.opt-inline-bounds-leaf-max-body))
        2)]
    [rejected : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-functions
          rejected-symbols
          (+ (compiler_optimize.opt-inline-bounds-leaf-max-body) 1))
        2)]
    [accepted-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs accepted "main")]
    [rejected-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs rejected "main")]
    (and
      (=
        (opt-count-direct-call-name-instr-seq
          accepted-instrs
          "bounds_leaf_inline")
        0)
      (= (opt-count-bounds-instrs accepted-instrs) 1)
      (=
        (opt-count-direct-call-name-instr-seq
          rejected-instrs
          "bounds_leaf_inline")
        1))))

;; The small end of the bounds-leaf band. Both bodies here are at or below
;; opt-inline-max-body, so the generic single-block path sees them and
;; opt-inline-bounds-inline-ok? refuses them: two call sites make the callee
;; non-absorbable and the arguments are variables, not constants. Admission
;; therefore proves the bounds-leaf path covers 1..opt-inline-max-body, the
;; band that used to be excluded. The third program pins the whitelist: a
;; body-carrying Call keeps the call boundary at both sites.
(define (compiler-optimize-inline-small-bounds-leaf-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [minimal : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-twice-functions symbols 1)
        2)]
    [boundary : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-twice-functions
          symbols
          (compiler_optimize.opt-inline-max-body))
        2)]
    [leaf-call : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-call-functions symbols)
        2)]
    [minimal-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs minimal "main")]
    [boundary-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs boundary "main")]
    [leaf-call-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs leaf-call "main")]
    (and
      (=
        (opt-count-direct-call-name-instr-seq
          minimal-instrs
          "bounds_leaf_inline")
        0)
      (= (opt-count-bounds-instrs minimal-instrs) 2)
      (=
        (opt-count-direct-call-name-instr-seq
          boundary-instrs
          "bounds_leaf_inline")
        0)
      (= (opt-count-bounds-instrs boundary-instrs) 2)
      (=
        (opt-count-direct-call-name-instr-seq
          leaf-call-instrs
          "bounds_leaf_call_inline")
        2)
      (=
        (opt-count-direct-call-name-instr-seq leaf-call-instrs "opaque_sink")
        0)
      (= (opt-count-bounds-instrs leaf-call-instrs) 0))))

;; The bounds-leaf return-type gate. Both programs run the same bounds-leaf body
;; from two ordinary call sites with variable arguments, so admission turns only
;; on the declared return type. `char` is a non-owning scalar that return-to-mov
;; cloning reproduces exactly, so both call boundaries disappear and both bounds
;; checks land in the caller. An owned `String` result keeps its call boundary,
;; because that boundary carries cleanup semantics the expansion does not
;; reproduce; refusal must also leave the callee's bounds check in the callee
;; rather than leak a copy into the caller.
(define (compiler-optimize-inline-bounds-leaf-char-return-ok?) : bool
  (let
    [symbols : OptInlineBoundsTestSymbols (opt-inline-bounds-test-symbols)]
    [char-program : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-char-functions symbols)
        2)]
    [owned-program : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-bounds-leaf-owned-functions symbols)
        2)]
    [char-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs char-program "main")]
    [owned-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs owned-program "main")]
    (and
      (compiler_optimize.opt-inline-bounds-leaf-return-type?
        (compiler_ast_types.AstType.Char))
      (not
        (compiler_optimize.opt-inline-bounds-leaf-return-type?
          (compiler_ast_types.AstType.String)))
      (=
        (opt-count-direct-call-name-instr-seq
          char-instrs
          "bounds_leaf_char_inline")
        0)
      (= (opt-count-bounds-instrs char-instrs) 2)
      (=
        (opt-count-direct-call-name-instr-seq
          owned-instrs
          "bounds_leaf_owned_inline")
        2)
      (= (opt-count-bounds-instrs owned-instrs) 0))))

(define (opt-inline-band-residual-calls [body : i64] [const-args? : bool]) : i64
  (opt-count-direct-call-name-instr-seq
    (opt-inline-function-instrs
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-band-functions body const-args?)
        2)
      "main")
    "band_inline"))

;; The opt-inline-max-body boundary, pinned from all four sides. Every program
;; here runs one call-free, bounds-free, single-block pure callee from two
;; ordinary call sites, so the callee is non-absorbable and no other admission
;; path can reach it: what is left is the shape cap and the cost gate, which
;; both read the same instruction count.
;;
;; The single-block path adds no blocks, so the cost gate reduces to
;; net = body - min(body, 3 * const-args) - 6 admitted at net <= 4:
;;   body 10, no constant arguments -- net = 4, admitted. This is the shape the
;;     old cap of 8 refused at every call site even though the cost model had
;;     already priced it as a win.
;;   body 12, two constant arguments per site -- savings min(12, 6) = 6 and
;;     net = 0, admitted right at the cap.
;;   body 12, no constant arguments -- net = 6, refused. Lifting the cap does
;;     not hand the decision to the cap; the price still has to clear.
;;   body 13, two constant arguments per site -- net = 1, which the cost gate
;;     would take. The cap refuses it anyway, which is the whole reason the cap
;;     exists above the priced ceiling of 10: const-savings saturates at the
;;     body size, so past that point the cost formula stops bounding growth.
(define (compiler-optimize-inline-band-boundary-ok?) : bool
  (and
    (= (opt-inline-band-residual-calls 10 false) 0)
    (= (opt-inline-band-residual-calls 12 true) 0)
    (= (opt-inline-band-residual-calls 12 false) 2)
    (= (opt-inline-band-residual-calls 13 true) 2)))

(define (compiler-optimize-inline-multi-call-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-multi-call-functions symbols)
        2)]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    [frame : i64 (opt-inline-function-frame optimized "main")]
    (cond
      [(not (= frame 8)) false]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 7)) false]
      [(not (= (opt-count-direct-call-name-instr-seq instrs "inline_add") 0))
        false]
      [(not (= (opt-inline-count-binop-dst instrs 6) 1)) false]
      [(not (= (opt-inline-count-binop-dst instrs 7) 1)) false]
      [(not (opt-inline-mov-dst-src? instrs 2 6)) false]
      [(not (opt-inline-mov-dst-src? instrs 3 7)) false]
      [else true])))

(define (compiler-optimize-inline-bottom-up-writeback-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-cascade-functions symbols)
        2)]
    [main-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "main")]
    [mid-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "inline_mid")]
    (and
      (= (opt-count-direct-call-name-instr-seq main-instrs "inline_mid") 0)
      (= (opt-count-direct-call-name-instr-seq main-instrs "inline_add") 0)
      (= (opt-inline-count-binop-dst main-instrs 4) 1)
      (= (opt-count-direct-call-name-instr-seq mid-instrs "inline_add") 0)
      (= (opt-inline-count-binop-dst mid-instrs 3) 1))))

(define (compiler-optimize-inline-mutual-scc-refusal-ok?) : bool
  (let
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-mutual-functions)
        2)]
    [a-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "inline_mut_a")]
    [b-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-inline-function-instrs optimized "inline_mut_b")]
    (and
      (= (opt-count-direct-call-name-instr-seq a-instrs "inline_mut_b") 1)
      (= (opt-count-direct-call-name-instr-seq a-instrs "inline_mut_a") 0)
      (= (opt-count-direct-call-name-instr-seq b-instrs "inline_mut_a") 1)
      (= (opt-count-direct-call-name-instr-seq b-instrs "inline_mut_b") 0))))

(define (opt-inline-pack-words-are-vars-1-2?
  [words : compiler_ir_types.CompilerIrValueSeq]) : bool
  (if (= words.len 2)
    (match (compiler_ir_types.compiler-ir-value-seq-ref words 0)
      [(compiler_ir_types.CompilerIrValue.Var av)
        (match (compiler_ir_types.compiler-ir-value-seq-ref words 1)
          [(compiler_ir_types.CompilerIrValue.Var bv) (and (= av 1) (= bv 2))]
          [_ false])]
      [_ false])
    false))

;; True when the inlined body contains a Pack reading the CALLER's argument
;; vars (1/2, remapped from the callee's params 0/1) and a Word whose source
;; is that Pack's (rebased) destination.
(define (opt-inline-pack-word-remap-ok-scan-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [pack-dst : i64]
  [pack-ok : bool]
  [word-ok : bool]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (and pack-ok word-ok)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Pack dst words _)
        (opt-inline-pack-word-remap-ok-scan-from
          instrs
          (+ index 1)
          dst
          (opt-inline-pack-words-are-vars-1-2? words)
          word-ok)]
      [(compiler_ir_types.CompilerIrInstr.Word _ src _ _)
        (opt-inline-pack-word-remap-ok-scan-from
          instrs
          (+ index 1)
          pack-dst
          pack-ok
          (match src
            [(compiler_ir_types.CompilerIrValue.Var sv) (= sv pack-dst)]
            [_ false]))]
      [_
        (opt-inline-pack-word-remap-ok-scan-from
          instrs
          (+ index 1)
          pack-dst
          pack-ok
          word-ok)])))

(define (opt-inline-pack-word-remap-ok-scan
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pack-dst : i64]
  [pack-ok : bool]
  [word-ok : bool]) : bool
  (opt-inline-pack-word-remap-ok-scan-from instrs 0 pack-dst pack-ok word-ok))

(define (compiler-optimize-inline-pack-word-ok?) : bool
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-pack-word-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (and
          (=
            (opt-count-direct-call-name-instr-seq
              (opt-function-first-instrs main)
              "inline_group_word")
            0)
          (opt-inline-pack-word-remap-ok-scan
            (opt-function-first-instrs main)
            (- 0 1)
            false
            false))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (opt-inline-branch-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    compiler_ir_types.CompilerIrParamList.Nil))

(define (opt-inline-branch-callee-mov) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Mov
    1
    (compiler_ir_types.CompilerIrValue.I64 7)
    (compiler_ast_types.AstType.I64)))

(defstruct OptInlineMultiTestSymbols
  (main i64)
  (inline-branch i64)
  (inline-tiny-predicate i64)
  (inline-loop i64)
  (mb-bounds i64)
  (inline-switch i64)
  (inline-switch-costly i64)
  (inline-mut-param-loop i64)
  (inline-nonleaf i64)
  (external-helper i64)
  (inline-tiny-nonleaf-predicate i64)
  (external-predicate i64))

(define (opt-inline-multi-test-symbols) : OptInlineMultiTestSymbols
  (OptInlineMultiTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "inline_branch")
    (opt-test-symbol "inline_tiny_predicate")
    (opt-test-symbol "inline_loop")
    (opt-test-symbol "mb_bounds")
    (opt-test-symbol "inline_switch")
    (opt-test-symbol "inline_switch_costly")
    (opt-test-symbol "inline_mut_param_loop")
    (opt-test-symbol "inline_nonleaf")
    (opt-test-symbol "external_helper")
    (opt-test-symbol "inline_tiny_nonleaf_predicate")
    (opt-test-symbol "external_predicate")))

(define (opt-inline-branch-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-branch
    (opt-inline-branch-params)
    (compiler_ast_types.AstType.I64)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "then")
            (compiler_ir_types.compiler-ir-label "else"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "then")
          (opt-test-instrs
            (opt-inline-branch-callee-mov)
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "else")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 42)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-branch-caller-call [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    0
    symbols.inline-branch
    (compiler_ir_types.CompilerIrCallArgs.One
      (compiler_ir_types.CompilerIrValue.Bool true))
    (compiler_ast_types.AstType.I64)))

(define (opt-inline-branch-caller [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-branch-caller-call symbols)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-branch-functions [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-branch-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-branch-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-repeated-predicate-callee
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-tiny-predicate
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "value"
        (compiler_ast_types.AstType.I64)
        0)
      compiler_ir_types.CompilerIrParamList.Nil)
    (compiler_ast_types.AstType.Bool)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            1
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "yes")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Bool true)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "no")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Bool false)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-repeated-predicate-caller
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.Bool)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            symbols.inline-tiny-predicate
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.I64 7))
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "second")
            (compiler_ir_types.compiler-ir-label "done"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "second")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Call
              1
              symbols.inline-tiny-predicate
              (compiler_ir_types.CompilerIrCallArgs.One
                (compiler_ir_types.CompilerIrValue.I64 12))
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "done")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Bool false)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-repeated-predicate-functions
  [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-repeated-predicate-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-repeated-predicate-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (compiler-optimize-inline-repeated-tiny-predicate-ok?) : bool
  (let
    [level0-symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [level1-symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [level2-symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [level0 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-predicate-functions level0-symbols)
        0)]
    [level1 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-predicate-functions level1-symbols)
        1)]
    [level2 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-repeated-predicate-functions level2-symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find level2 "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (=
              (opt-count-direct-call-name-function-seq
                level0
                "main"
                "inline_tiny_predicate")
              2)
            (=
              (opt-count-direct-call-name-function-seq
                level1
                "main"
                "inline_tiny_predicate")
              2)
            (=
              (opt-count-direct-call-name-blocks blocks "inline_tiny_predicate")
              0)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (compiler-optimize-inline-multiblock-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-branch-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_branch") 0)
            (= (compiler_ir_types.compiler-ir-block-list-count blocks) 5)
            (= (opt-count-phi-blocks blocks) 1)
            (= (compiler_optimize.opt-function-frame main) 2)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (opt-inline-loop-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-loop
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Bool true)
              (compiler_ir_types.compiler-ir-label "loop")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 1)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-loop-caller [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            symbols.inline-loop
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-loop-functions [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-loop-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-loop-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (compiler-optimize-inline-multiblock-acyclic-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-loop-functions symbols)
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_loop") 0)
            (= (compiler_ir_types.compiler-ir-block-list-count blocks) 5)
            (= (opt-count-phi-blocks blocks) 0)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; Multiblock bounds-carrying absorbable callee: with BoundsCheck admitted to
;; the multiblock instruction set, a single-call-site helper whose body
;; contains a check must inline (the absorb bonus), with its ok-label
;; freshened by the site prefix so the caller's labels stay unique.
(define (opt-inline-mb-bounds-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.mb-bounds
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "idx"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          1)
        compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "mb_ok"))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Bool true)
            (compiler_ir_types.compiler-ir-label "then")
            (compiler_ir_types.compiler-ir-label "else"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "then")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 0)))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "else")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-mb-bounds-caller [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "a"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "b"
          (compiler_ast_types.AstType.I64)
          1)
        compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.mb-bounds
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (compiler-optimize-inline-multiblock-bounds-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-mb-bounds-caller symbols)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-mb-bounds-callee symbols)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "mb_bounds") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (opt-inline-switch-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "tag"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "idx"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          2)
        compiler_ir_types.CompilerIrParamList.Nil))))

(define (opt-inline-switch-cases [zero-label : i64] [one-label : i64]) : compiler_ir_types.CompilerIrSwitchCaseSeq
  (compiler_ir_types.compiler-ir-switch-case-seq2
    (compiler_ir_types.CompilerIrSwitchCase.Case 0 zero-label)
    (compiler_ir_types.CompilerIrSwitchCase.Case 1 one-label)))

(define (opt-inline-switch-loop-bounds-instr [ok-label : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BoundsCheck
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ir_types.CompilerIrValue.Var 2)
    ok-label))

(define (opt-inline-switch-loop-phi-instr) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Phi
    3
    (compiler_ir_types.compiler-ir-phi-input-cons
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ir_types.compiler-ir-label "zero")
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 20)
        (compiler_ir_types.compiler-ir-label "one")
        compiler_ir_types.CompilerIrPhiInputList.Nil))
    (compiler_ast_types.AstType.I64)))

;; A cyclic bounds-carrying Switch callee remains behind the acyclic gate even
;; when absorbable, unless its exact IR-symbol leaf is the measured `vm-run`
;; exception.
(define (opt-inline-switch-callee-named [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-test-instrs
            (opt-inline-switch-loop-bounds-instr
              (compiler_ir_types.compiler-ir-label "switch_bounds_ok"))
            (compiler_ir_types.CompilerIrInstr.Switch
              (compiler_ir_types.CompilerIrValue.Var 0)
              0
              (opt-inline-switch-cases
                (compiler_ir_types.compiler-ir-label "zero")
                (compiler_ir_types.compiler-ir-label "one"))
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "zero")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "one")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "join")
                (opt-test-instrs
                  (opt-inline-switch-loop-phi-instr)
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 3)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-inline-switch-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-switch-callee-named symbols.inline-switch))

;; The acyclic counterpart exercises Switch admission and label remapping. Its
;; join phi makes stale, unprefixed case/default predecessor labels observable.
(define (opt-inline-acyclic-switch-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-switch
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "switch_bounds_ok"))
          (compiler_ir_types.CompilerIrInstr.Switch
            (compiler_ir_types.CompilerIrValue.Var 0)
            0
            (opt-inline-switch-cases
              (compiler_ir_types.compiler-ir-label "zero")
              (compiler_ir_types.compiler-ir-label "one"))
            (compiler_ir_types.compiler-ir-label "other"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "zero")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "one")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "other")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "join")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    3
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "zero")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "one")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "other")
                          compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 3)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-inline-switch-caller-call-named [callee-name : i64]) : compiler_ir_types.CompilerIrInstr
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 3)]
    (begin
      ;; Swap the first two arguments so the Switch scrutinee and BoundsCheck
      ;; index must both be remapped rather than retaining their callee ids.
      (set! (array-ref args 0) (compiler_ir_types.CompilerIrValue.Var 1))
      (set! (array-ref args 1) (compiler_ir_types.CompilerIrValue.Var 0))
      (set! (array-ref args 2) (compiler_ir_types.CompilerIrValue.Var 2))
      (compiler_ir_types.CompilerIrInstr.Call
        3
        callee-name
        (compiler_ir_types.CompilerIrCallArgs.Array args)
        (compiler_ast_types.AstType.I64)))))

(define (opt-inline-switch-caller-named
  [symbols : OptInlineMultiTestSymbols]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-switch-caller-call-named callee-name)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-switch-caller [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-switch-caller-named symbols symbols.inline-switch))

(define (opt-inline-cloned-switch-terminator-ok?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "inl.entry.0.entry"))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.BoundsCheck _ _ ok-label)
                (and
                  (=
                    ok-label
                    (compiler_ir_types.compiler-ir-label
                      "inl.entry.0.switch_bounds_ok"))
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 1)
                    [(compiler_ir_types.CompilerIrInstr.Switch
                        value
                        tag-base
                        cases
                        default-label)
                      (let
                        [case-labels : compiler_optimize.OptLabelSet
                          (compiler_optimize.opt-cfg-switch-case-successors
                            compiler_optimize.OptLabelSet.Nil
                            cases)]
                        (and
                          (match value
                            [(compiler_ir_types.CompilerIrValue.Var id)
                              (= id 1)]
                            [_ false])
                          (= tag-base 0)
                          (= (compiler_optimize.opt-label-count case-labels) 2)
                          (compiler_optimize.opt-label-contains
                            case-labels
                            (compiler_ir_types.compiler-ir-label
                              "inl.entry.0.zero"))
                          (compiler_optimize.opt-label-contains
                            case-labels
                            (compiler_ir_types.compiler-ir-label
                              "inl.entry.0.one"))
                          (=
                            default-label
                            (compiler_ir_types.compiler-ir-label
                              "inl.entry.0.other"))))]
                    [_ false]))]
              [_ false])
            false)])]))

(define (opt-inline-cloned-switch-phi-ok?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "inl.entry.0.join"))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (> (compiler_ir_types.compiler-ir-instr-seq-count instrs) 0)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                (and
                  (=
                    (compiler_ir_types.compiler-ir-phi-input-list-count inputs)
                    3)
                  (compiler_optimize.opt-inline-phi-input-label?
                    inputs
                    (compiler_ir_types.compiler-ir-label "inl.entry.0.zero"))
                  (compiler_optimize.opt-inline-phi-input-label?
                    inputs
                    (compiler_ir_types.compiler-ir-label "inl.entry.0.one"))
                  (compiler_optimize.opt-inline-phi-input-label?
                    inputs
                    (compiler_ir_types.compiler-ir-label "inl.entry.0.other")))]
              [_ false])
            false)])]))

(define (compiler-optimize-inline-multiblock-switch-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-switch-caller symbols)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-acyclic-switch-callee symbols)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_switch") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (opt-inline-cloned-switch-terminator-ok? blocks)
            (opt-inline-cloned-switch-phi-ok? blocks)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; THIS WAS A REFUSAL TEST. The cyclic bounds+switch callee at its single site
;; in a loop-free caller used to stay behind the acyclic admission gate, and the
;; hot-loop-leaf band could not rescue it because that band began at three
;; references. The band now begins at one (see its reference clause), and this
;; shape is exactly what its loop-free site tier was measured to take: the
;; imported loop becomes the caller's only loop, so there is no caller loop
;; whose allocation the second working set could tax. What the assertion pins is
;; that the newly enabled clone is a CORRECT one -- the boundary is retired, the
;; callee's bounds check comes along rather than being dropped, and the cloned
;; CFG verifies.
(define (compiler-optimize-inline-multiblock-cyclic-bounds-switch-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-switch-caller symbols)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-switch-callee symbols)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_switch") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

(define (opt-inline-switch-functions-named
  [symbols : OptInlineMultiTestSymbols]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-switch-caller-named symbols callee-name)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-switch-callee-named callee-name)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-switch-case-result-ok?
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [callee-text : String]
  [expected-calls : i64]
  [expected-bounds : i64]) : bool
  (match (compiler_optimize.opt-function-seq-find functions "main")
    [(compiler_optimize.OptMaybeFunction.Some main)
      (let
        [blocks : compiler_ir_types.CompilerIrBlockList
          (compiler_optimize.opt-function-blocks main)]
        (and
          (=
            (opt-count-direct-call-name-blocks blocks callee-text)
            expected-calls)
          (= (compiler_optimize.opt-count-bounds-blocks blocks) expected-bounds)
          (compiler_optimize.opt-inline-structure-ok? blocks)))]
    [(compiler_optimize.OptMaybeFunction.No) false]))

(define (compiler-optimize-inline-vm-run-bounds-loop-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [vm-text : String "bench.tl::vm-run"]
    [other-text : String "bench.tl::qs-partition"]
    [vm-name : i64 (opt-test-symbol vm-text)]
    [other-name : i64 (opt-test-symbol other-text)]
    [vm-opt2 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-switch-functions-named symbols vm-name)
        2)]
    [other-opt2 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-switch-functions-named symbols other-name)
        2)]
    [vm-opt1 : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-switch-functions-named symbols vm-name)
        1)]
    (and
      (opt-inline-switch-case-result-ok? vm-opt2 vm-text 0 1)
      ;; `qs-partition` USED TO STAY REFUSED HERE, and that is what the
      ;; name-matching exception above existed to arrange: at opt2 only a leaf
      ;; whose name ends in `vm-run` escaped the acyclic gate. It escapes on its
      ;; SHAPE now -- one reference, call-free, cyclic, in a loop-free caller is
      ;; the hot-loop-leaf band's loop-free tier, which since the band's
      ;; reference clause was widened to one reference no longer needs a name.
      ;; The exception is not dead: it still admits a `vm-run` leaf the band
      ;; refuses on size or on caller shape, which is why it stays.
      (opt-inline-switch-case-result-ok? other-opt2 other-text 0 1)
      ;; opt1 still refuses BOTH: below opt2 the multiblock inliner does not run
      ;; at all, so the widened band cannot reach this shape there.
      (opt-inline-switch-case-result-ok? vm-opt1 vm-text 1 0))))

;; --- loop-bearing bounds callee admission (in-loop site + cascade) ----------
;;
;; The callee under test is the cyclic bounds-carrying Switch leaf above, which
;; the shared gate refuses everywhere except at an in-loop site. Only the
;; CALLER varies across these fixtures, so each test isolates exactly one
;; clause of opt-inline-bounds-loop-absorb-ok?.
(define (opt-inline-loop-site-call [callee-name : i64] [dst : i64]) : compiler_ir_types.CompilerIrInstr
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 3)]
    (begin
      (set! (array-ref args 0) (compiler_ir_types.CompilerIrValue.Var 1))
      (set! (array-ref args 1) (compiler_ir_types.CompilerIrValue.Var 0))
      (set! (array-ref args 2) (compiler_ir_types.CompilerIrValue.Var 2))
      (compiler_ir_types.CompilerIrInstr.Call
        dst
        callee-name
        (compiler_ir_types.CompilerIrCallArgs.Array args)
        (compiler_ast_types.AstType.I64)))))

;; entry -> header -> {body -> latch -> header, exit}. The call sits in `body`,
;; a member of the natural loop headed by `header`. The back edge leaves from
;; `latch` rather than from `body` so the call block is not a phi predecessor:
;; that suppression of the absorb bonus is a separate, already-measured rule
;; (#5193), and mixing it in would stop this fixture from testing the site
;; condition it exists to test.
(define (opt-inline-loop-site-caller-blocks
  [callee-name : i64]
  [entry-instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      entry-instrs)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            4
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "latch")
                compiler_ir_types.CompilerIrPhiInputList.Nil))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (opt-inline-loop-site-call callee-name 5)
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "latch")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 4)))))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-inline-loop-site-entry-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      3
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "header"))))

;; Same entry, plus a bounds check the caller already owns. Used to flip the
;; cascade clause without touching anything else.
(define (opt-inline-loop-site-bounds-entry-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (opt-inline-loop-site-entry-instrs)
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.compiler-ir-label "caller_bounds_ok"))))

(define (opt-inline-loop-site-function
  [func-name : i64]
  [callee-name : i64]
  [entry-instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    6
    (opt-inline-loop-site-caller-blocks callee-name entry-instrs)))

;; `main` calls the leaf from inside a loop: the boundary is repaid per
;; iteration, so the gate admits it.
(define (compiler-optimize-inline-bounds-loop-in-loop-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-loop-site-function
            symbols.main
            callee-name
            (opt-inline-loop-site-entry-instrs))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-switch-callee-named callee-name)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_switch") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; THIS WAS A REFUSAL TEST, on the argument that retiring a boundary which runs
;; once cannot pay for the caller's allocation. That argument is about a caller
;; whose allocation there is something to lose -- and this caller is loop-free,
;; which is the case the hot-loop-leaf band's third site tier was measured on
;; (gvn-facts-slot's five straight-line sites): with no caller loop, the
;; imported loop becomes the only one and there is no allocation to tax. The
;; band could not reach this site while its reference clause began at three
;; references; at one reference it does, and the corpus measured the widening
;; non-regressing on all 22 rows.
(define (compiler-optimize-inline-bounds-loop-cold-site-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-switch-caller-named symbols callee-name)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-switch-callee-named callee-name)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_switch") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; `mid` is single-reference and carries no bounds checks, so the cascade
;; clause is live for every leaf it imports. The leaf here CALLS OUT, and that
;; is what keeps the clause the only thing separating the two programs below:
;; the single-site band's clause 2 now takes a narrow leaf at an in-loop site,
;; but only a call-free one, so a call-bearing leaf still reaches this tier and
;; only this tier. The call-free counterpart of exactly this program is
;; compiler-optimize-inline-single-site-narrow-loop-site-absorb-ok?, where the
;; body moves; between them the two fixtures isolate call-freedom.
(define (opt-inline-cascade-program
  [symbols : OptInlineMultiTestSymbols]
  [mid-entry : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (let
    [mid-name : i64 symbols.inline-nonleaf]
    [leaf-name : i64 symbols.inline-switch]
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-switch-caller-named symbols mid-name)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-loop-site-function mid-name leaf-name mid-entry)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-dup-leaf-calling leaf-name symbols.external-helper)
          (compiler_ir_types.compiler-ir-function-seq-empty))))))

;; `mid` is single-reference and carries no bounds checks, so it is inlined at
;; its own call site for free. Importing the bounds-carrying loop leaf would
;; hand it its first bounds check and cost it that inline, so the import is
;; refused even though the site is in a loop.
(define (compiler-optimize-inline-bounds-loop-cascade-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-cascade-program symbols (opt-inline-loop-site-entry-instrs))
        2)]
    [admitted : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-cascade-program
          symbols
          (opt-inline-loop-site-bounds-entry-instrs))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          refused
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          admitted
          "inline_nonleaf"
          "inline_switch")
        0))))

;; --- duplicating a two-reference leaf into its in-loop sites ----------------
;;
;; The leaf under test is the cyclic bounds-carrying Switch leaf again, built
;; here in two versions that differ in exactly one instruction: whether the
;; `zero` case makes a call. Everything else across these fixtures varies only
;; in the CALLERS, so each test isolates one clause of
;; opt-inline-dup-absorb-ok?.
(define (opt-inline-dup-leaf-named
  [callee-name : i64]
  [vars : i64]
  [zero-instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    vars
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-test-instrs
            (opt-inline-switch-loop-bounds-instr
              (compiler_ir_types.compiler-ir-label "switch_bounds_ok"))
            (compiler_ir_types.CompilerIrInstr.Switch
              (compiler_ir_types.CompilerIrValue.Var 0)
              0
              (opt-inline-switch-cases
                (compiler_ir_types.compiler-ir-label "zero")
                (compiler_ir_types.compiler-ir-label "one"))
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "zero")
            zero-instrs)
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "one")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "join")
                (opt-test-instrs
                  (opt-inline-switch-loop-phi-instr)
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 3)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-inline-dup-leaf-jump-zero-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "join"))))

;; The same case block, plus one call to a helper the program does not define,
;; so nothing can inline it away before the leaf itself is offered.
(define (opt-inline-dup-leaf-call-zero-instrs [helper-name : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 1)]
    (begin
      (set! (array-ref args 0) (compiler_ir_types.CompilerIrValue.Var 0))
      (opt-test-instrs-with-tail
        (opt-inline-dup-leaf-jump-zero-instrs)
        (compiler_ir_types.CompilerIrInstr.Call
          4
          helper-name
          (compiler_ir_types.CompilerIrCallArgs.Array args)
          (compiler_ast_types.AstType.I64))))))

(define (opt-inline-dup-leaf-plain [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    4
    (opt-inline-dup-leaf-jump-zero-instrs)))

(define (opt-inline-dup-leaf-calling [callee-name : i64] [helper-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    5
    (opt-inline-dup-leaf-call-zero-instrs helper-name)))

(define (opt-inline-dup-caller-chain
  [names : compiler_optimize.OptSlotList]
  [callee-name : i64]
  [tail : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (match names
    [(compiler_optimize.OptSlotList.Nil) tail]
    [(compiler_optimize.OptSlotList.Cons name rest)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-loop-site-function
          name
          callee-name
          (opt-inline-loop-site-entry-instrs))
        (opt-inline-dup-caller-chain (__tl-box-place rest) callee-name tail))]))

(define (opt-inline-dup-two-caller-names [symbols : OptInlineMultiTestSymbols]) : compiler_optimize.OptSlotList
  (compiler_optimize.OptSlotList.Cons
    symbols.main
    (box
      (compiler_optimize.OptSlotList.Cons
        symbols.inline-nonleaf
        (box (compiler_optimize.OptSlotList.Nil))))))

(define (opt-inline-dup-three-caller-names
  [symbols : OptInlineMultiTestSymbols]) : compiler_optimize.OptSlotList
  (compiler_optimize.OptSlotList.Cons
    symbols.inline-loop
    (box (opt-inline-dup-two-caller-names symbols))))

(define (opt-inline-dup-optimized
  [callers : compiler_optimize.OptSlotList]
  [callee-name : i64]
  [leaf : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-inline-dup-caller-chain
      callers
      callee-name
      (compiler_ir_types.compiler-ir-function-seq-prepend
        leaf
        (compiler_ir_types.compiler-ir-function-seq-empty)))
    2))

;; Two in-loop callers duplicate the leaf into both. The three-reference shape
;; that used to sit here as the ceiling case moved to the hot-loop-leaf tests
;; below, and since that band's reference clause was widened to one reference it
;; would take this two-reference leaf as well: both bands admit it and the
;; duplicating one, being cheaper, is asked first. What this test pins is
;; unchanged either way -- the leaf reaches both in-loop sites.
(define (compiler-optimize-inline-dup-two-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [two : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-plain callee-name))]
    (and
      (= (opt-count-direct-call-name-function-seq two "main" "inline_switch") 0)
      (=
        (opt-count-direct-call-name-function-seq
          two
          "inline_nonleaf"
          "inline_switch")
        0))))

;; The identical two-reference leaf, at two in-loop sites, one of whose callers
;; is itself a single-reference bounds-free function: that caller would lose its
;; own inline by taking the leaf's bounds check, so the cascade clause refuses
;; the copy THERE and admits it at the other site. One caller taking the body
;; does not commit the other.
;;
;; This is also the CASCADE pin for the hot-loop-leaf band. That band carries
;; its own copy of the cascade clause, and since its reference clause was
;; widened to one reference it now reaches this two-reference leaf too -- so the
;; refused site stays refused only while BOTH bands keep asking. Drop the clause
;; from either one and the assertion below starts finding zero calls.
(define (compiler-optimize-inline-dup-cascade-per-caller-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [mid-name : i64 symbols.inline-nonleaf]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-switch-caller-named symbols mid-name)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-loop-site-function
              mid-name
              callee-name
              (opt-inline-loop-site-entry-instrs))
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-inline-loop-site-function
                symbols.inline-loop
                callee-name
                (opt-inline-loop-site-entry-instrs))
              (compiler_ir_types.compiler-ir-function-seq-prepend
                (opt-inline-dup-leaf-plain callee-name)
                (compiler_ir_types.compiler-ir-function-seq-empty)))))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        0))))

;; The same two-reference leaf with one call in its body stays out of line at
;; both sites. The clone path handles calls -- the measured tier clones
;; call-carrying bodies and this file pins that -- but this band's model prices
;; a body by counting it, and a callee's own calls cost the caller its leaf
;; frame and every value live across them. See opt-inline-blocks-call-free?.
;; --- the measured-plan inline check -----------------------------------------
;;
;; The tier itself (compiler_optimize.tl, opt-inline-checked-*) admits one site
;; per caller from the class every band refuses, rebuilds the caller both ways,
;; prices both plans, and keeps the inline only when the measured plan agrees
;; with what a free inline would predict. These pin the pieces that decide that:
;; the depth model both sides are priced in, the accept window, the program
;; budget that bounds the tier's compile-time cost, and the two structural
;; guarantees -- a caller with no candidate pays nothing, and whichever side of
;; the rollback is kept verifies.
;; A two-block function: an entry that jumps into a self-loop. The loop block
;; carries `loop-instrs` instructions, the entry carries one.
(define (opt-inline-checked-depth-fixture [name : i64] [loop-instrs : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-inline-checked-depth-loop-instrs loop-instrs))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-inline-checked-depth-loop-instrs [remaining : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (<= remaining 1)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "loop")))
    (opt-test-instrs-with-tail
      (opt-inline-checked-depth-loop-instrs (- remaining 1))
      (compiler_ir_types.CompilerIrInstr.Mov
        0
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64)))))

;; The currency both sides of the check are priced in. A block inside one loop
;; weighs opt-inline-census-depth-base; `offset` is the depth the body would
;; land at in its caller, and the ladder SATURATES at
;; opt-inline-census-depth-cap, which is the whole reason the callee is priced
;; through an offset instead of by multiplying two weights.
(define (compiler-optimize-inline-checked-depth-weighting-ok?) : bool
  (let
    [func : compiler_ir_types.CompilerIrFunction
      (opt-inline-checked-depth-fixture (opt-test-symbol "checked_depth") 4)]
    [base : i64 (compiler_optimize.opt-inline-census-depth-base)]
    [at0 : i64 (compiler_optimize.opt-inline-checked-weighted-instrs-at func 0)]
    [at1 : i64 (compiler_optimize.opt-inline-checked-weighted-instrs-at func 1)]
    [at2 : i64 (compiler_optimize.opt-inline-checked-weighted-instrs-at func 2)]
    [at3 : i64 (compiler_optimize.opt-inline-checked-weighted-instrs-at func 3)]
    (and
      ;; one entry instruction at depth 0 plus four loop instructions at depth 1
      (= at0 (+ 1 (* base 4)))
      ;; one level down: the entry joins depth 1, the loop reaches depth 2
      (= at1 (+ base (* base (* base 4))))
      ;; and the ladder saturates, so a third level costs nothing more
      (= at2 at3)
      (= at2 (compiler_optimize.opt-inline-checked-weighted-instrs-at func 9)))))

;; The accept window. A free inline saves exactly `boundary`; the tier keeps a
;; site only when the model lands within a factor of two of that in BOTH
;; directions -- too little and the inline did not repay, too much and the two
;; sides were not measured in the same currency.
(define (compiler-optimize-inline-checked-window-ok?) : bool
  (and
    ;; exactly what a free inline predicts
    (compiler_optimize.opt-inline-checked-window-ok? 64 64)
    ;; the two edges of the window
    (compiler_optimize.opt-inline-checked-window-ok? 32 64)
    (compiler_optimize.opt-inline-checked-window-ok? 128 64)
    ;; below it: the boundary was retired and the merged body ate the saving
    (not (compiler_optimize.opt-inline-checked-window-ok? 31 64))
    (not (compiler_optimize.opt-inline-checked-window-ok? 0 64))
    (not (compiler_optimize.opt-inline-checked-window-ok? (- 0 400) 64))
    ;; above it: the model claims more than an inline can produce, which is what
    ;; every documented loser looks like here (pl-line-end models 1,193 against
    ;; a boundary of 64)
    (not (compiler_optimize.opt-inline-checked-window-ok? 129 64))
    (not (compiler_optimize.opt-inline-checked-window-ok? 1193 64))
    ;; the boundary itself scales with arity, which is the part of a call
    ;; sequence that does
    (>
      (compiler_optimize.opt-inline-checked-boundary-cost 14)
      (compiler_optimize.opt-inline-checked-boundary-cost 2))))

;; The program budget counts VERDICTS, not accepts, because a rejected
;; candidate costs the same work an accepted one does. The level-2 inline
;; driver arms the tier and resets the budget; the test hook disarms it.
(define (compiler-optimize-inline-checked-budget-ok?) : bool
  (begin
    (compiler_optimize.opt-inline-checked-set-active! false)
    (compiler_optimize.opt-inline-checked-program-begin!)
    (if (compiler_optimize.opt-inline-checked-armed?)
      false
      (begin
        (compiler_optimize.opt-inline-checked-set-active! true)
        (if (not (compiler_optimize.opt-inline-checked-armed?))
          (begin
            (compiler_optimize.opt-inline-checked-set-active! false)
            false)
          (let
            [budget-reset? : bool
              (=
                (compiler_optimize.opt-inline-checked-budget-current)
                (compiler_optimize.opt-inline-checked-program-budget))]
            (begin
              ;; every fixture leaves the tier as it found it: the optimizer
              ;; unit tests share one process, and the band fixtures below
              ;; assert what the BANDS do
              (compiler_optimize.opt-inline-checked-set-active! false)
              budget-reset?)))))))

;; Two structural guarantees on the whole-program pass, asserted on the
;; multiblock fixtures the bands already own:
;;
;;   1. a program whose sites the BANDS admit spends no budget. The tier is
;;      asked only about sites no band takes, so a band-admitted site never
;;      reaches a verdict -- which is both the correctness rule (the cheaper
;;      admitter wins) and the reason the tier costs nothing on ordinary code;
;;   2. whatever the rollback keeps verifies. The accepted side is the walk's
;;      own rewrite and the reverted side is the banked-band-only rewrite, and
;;      both go through the same structural verifier the pass already runs.
(define (compiler-optimize-inline-checked-band-exclusion-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (compiler_optimize.opt-inline-checked-set-active! true)
        (compiler_optimize.opt-inline-checked-program-begin!))]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-plain callee-name))]
    [spent : i64
      (-
        (compiler_optimize.opt-inline-checked-program-budget)
        (compiler_optimize.opt-inline-checked-budget-current))]
    [_disarm : unit (compiler_optimize.opt-inline-checked-set-active! false)]
    (and
      ;; the duplication band takes both sites, so the measured tier is never
      ;; asked and the budget is untouched
      (= spent 0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        0)
      (opt-inline-mb2-main-verified? optimized "main")
      (opt-inline-mb2-main-verified? optimized "inline_nonleaf"))))

;; The tier DECIDES a call-carrying candidate, and whichever side of the
;; rollback it keeps verifies.
;;
;; The static bands refuse a call-carrying body outright -- that is their
;; pricing clause, and opt-inline-dup-call-bearing-refusal pins it -- so this
;; leaf reaches every one of its three in-loop sites with its boundary intact
;; once the bands are done. The tier has no such clause: it rebuilds each
;; caller with the site, re-plans the merged function, and keeps the site only
;; when the measured saving lands in the accept window. This drives that
;; sequence over the three callers and pins BOTH outcomes at once -- the callers
;; whose plan repays keep the body, the caller whose plan does not keeps its
;; call -- which is the property the tier's whole rollback exists to provide and
;; the one that a clause refusing the candidate outright could never exercise.
;;
;; The encoding is `spent`, then the armed call counts, then the banked ones,
;; so a change in any of the three reads directly off the number.
(define (compiler-optimize-inline-checked-call-carrying-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_disarm : unit
      (begin
        (compiler_optimize.opt-inline-checked-program-begin!)
        (compiler_optimize.opt-inline-checked-set-active! false))]
    [banked : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    [banked-code : i64
      (+
        (*
          100
          (opt-count-direct-call-name-function-seq
            banked
            "main"
            "inline_switch"))
        (+
          (*
            10
            (opt-count-direct-call-name-function-seq
              banked
              "inline_nonleaf"
              "inline_switch"))
          (opt-count-direct-call-name-function-seq
            banked
            "inline_loop"
            "inline_switch")))]
    [_arm : unit
      (begin
        (compiler_optimize.opt-inline-checked-set-active! true)
        (compiler_optimize.opt-inline-checked-program-begin!))]
    [armed : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    [armed-code : i64
      (+
        (*
          100
          (opt-count-direct-call-name-function-seq armed "main" "inline_switch"))
        (+
          (*
            10
            (opt-count-direct-call-name-function-seq
              armed
              "inline_nonleaf"
              "inline_switch"))
          (opt-count-direct-call-name-function-seq
            armed
            "inline_loop"
            "inline_switch")))]
    [spent : i64
      (-
        (compiler_optimize.opt-inline-checked-program-budget)
        (compiler_optimize.opt-inline-checked-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf")
        (opt-inline-mb2-main-verified? armed "inline_loop"))]
    [_disarm-after : unit
      (compiler_optimize.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 1000000 spent) (+ (* 1000 armed-code) banked-code))
      (- 0 1))))

;; spent=3, armed=000 (all three callers kept the body), banked=111 (the bands
;; left every site out of line).
(define (compiler-optimize-inline-checked-call-carrying-ok?) : bool
  (= (compiler-optimize-inline-checked-call-carrying-self-test) 3000111))

;; The same in-loop site, one loop deeper. entry -> outer -> header -> body,
;; with the call in `body`, so the site's depth weight is the census ladder's
;; second rung rather than its first. Nothing else about the site changes: the
;; callee, its arity and its body are the ones the accept fixture uses.
(define (opt-inline-nested-loop-site-blocks [callee-name : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "outer"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "outer")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            6
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.compiler-ir-label "outer_latch")
                compiler_ir_types.CompilerIrPhiInputList.Nil))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "header")
            (compiler_ir_types.compiler-ir-label "done"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "header")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              4
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 6)
                (compiler_ir_types.compiler-ir-label "outer")
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 5)
                  (compiler_ir_types.compiler-ir-label "latch")
                  compiler_ir_types.CompilerIrPhiInputList.Nil))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "body")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-test-instrs
              (opt-inline-loop-site-call callee-name 5)
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "latch")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "outer_latch"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "outer_latch")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "outer"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "done")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 6)))))
                  compiler_ir_types.CompilerIrBlockList.Nil)))))))))

(define (opt-inline-nested-loop-site-function
  [func-name : i64]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    7
    (opt-inline-nested-loop-site-blocks callee-name)))

;; Two nested-loop callers of the same call-carrying leaf. Two references keep
;; every band away -- the duplicating, hot-loop-leaf and shared-accessor bands
;; all refuse a call-carrying body, and with no single-reference absorb bonus
;; the ordinary cost model refuses a five-block callee on block weight alone --
;; so both sites reach the measured tier, one loop deeper than the accept
;; fixture's.
(define (compiler-optimize-inline-checked-call-carrying-deep-self-test) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [_arm : unit
      (begin
        (compiler_optimize.opt-inline-checked-set-active! true)
        (compiler_optimize.opt-inline-checked-program-begin!))]
    [armed : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-nested-loop-site-function symbols.main callee-name)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-nested-loop-site-function
              symbols.inline-nonleaf
              callee-name)
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-inline-dup-leaf-calling callee-name symbols.external-helper)
              (compiler_ir_types.compiler-ir-function-seq-empty))))
        2)]
    [code : i64
      (+
        (*
          10
          (opt-count-direct-call-name-function-seq armed "main" "inline_switch"))
        (opt-count-direct-call-name-function-seq
          armed
          "inline_nonleaf"
          "inline_switch"))]
    [spent : i64
      (-
        (compiler_optimize.opt-inline-checked-program-budget)
        (compiler_optimize.opt-inline-checked-budget-current))]
    [verified? : bool
      (and
        (opt-inline-mb2-main-verified? armed "main")
        (opt-inline-mb2-main-verified? armed "inline_nonleaf")
        (opt-inline-mb2-main-verified? armed "inline_switch"))]
    [_disarm : unit (compiler_optimize.opt-inline-checked-set-active! false)]
    (if verified?
      (+ (* 100 spent) code)
      (- 0 1))))

(define (compiler-optimize-inline-checked-call-carrying-deep-ok?) : bool
  (= (compiler-optimize-inline-checked-call-carrying-deep-self-test) 200))

;; ...and the other side of the same check, on the same call-carrying body.
;;
;; The verdict is priced here against a plan that did NOT change: the same
;; caller stands in for both sides of the rollback, so nothing was saved and
;; `before - after` is exactly the boundary the site would retire plus the
;; callee's own body, priced where the inline would put it. A body that costs
;; more than the boundary it retires is over-credit rather than saving, which
;; is precisely what the window's upper bound refuses -- and the callee here is
;; the call-carrying leaf the accept fixtures use, so what separates the two
;; outcomes is the measured plan and nothing about the callee's calls.
(define (compiler-optimize-inline-checked-call-carrying-revert-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [caller : compiler_ir_types.CompilerIrFunction
      (opt-inline-loop-site-function
        symbols.main
        callee-name
        (opt-inline-loop-site-entry-instrs))]
    [leaf : compiler_ir_types.CompilerIrFunction
      (opt-inline-dup-leaf-calling callee-name symbols.external-helper)]
    [keep? : bool
      (compiler_optimize.opt-inline-checked-verdict
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        caller
        caller
        leaf
        1
        (compiler_optimize.opt-inline-census-depth-base)
        3
        (- 0 1))]
    (not keep?)))

;; --- the sequence: one caller, one site at a time ---------------------------
;;
;; The tier prices a caller's sites in SEQUENCE: a scan walk ranks them, and
;; then one round per verdict rebuilds the caller with the sites already kept
;; plus one new one and prices exactly that difference. These drive the round
;; bookkeeping directly -- the scan table, the ranking, the accepted table and
;; the caps -- because that bookkeeping is what decides which sites a caller is
;; offered and in which order, and it is decidable without a fixture the size of
;; a benchmark kernel.
;;
;; The end-to-end behaviour these encode was measured on the corpus and is
;; recorded at the tier: two sites of one map lookup accepted in sequence in one
;; caller (hashmap_get -11.40%), a first site refused and a second accepted in
;; the same caller (gvn_table's invalidate-var), and a caller whose second site
;; names a different callee refused (opt_quicksort, which regressed +2.01% when
;; it was allowed).
(define (opt-inline-checked-seq-callee-a) : i64
  (opt-test-symbol "seq_callee_a"))

(define (opt-inline-checked-seq-callee-b) : i64
  (opt-test-symbol "seq_callee_b"))

;; Two sites of ONE callee, offered richest-first, both kept: the second round
;; arms the second site because the caller's first accept named that callee, and
;; both end up in the accepted table -- which is what makes a later walk rebuild
;; both.
(define (compiler-optimize-inline-checked-sequence-two-sites-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [_begin : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    ;; the poorer site first in walk order, so only the ranking can order them
    [_scan : unit
      (begin
        (compiler_optimize.opt-inline-checked-scan-record! callee 10 1 100)
        (compiler_optimize.opt-inline-checked-scan-record! callee 11 2 900))]
    [armed-first? : bool
      (compiler_optimize.opt-inline-checked-arm-next-target!)]
    [first-pos : i64 (compiler_optimize.opt-inline-checked-target-pos-current)]
    [_keep-first : unit
      (begin
        (compiler_optimize.opt-inline-checked-spend-verdict!)
        (compiler_optimize.opt-inline-checked-accept-target!))]
    [armed-second? : bool
      (compiler_optimize.opt-inline-checked-arm-next-target!)]
    [second-pos : i64 (compiler_optimize.opt-inline-checked-target-pos-current)]
    [_keep-second : unit
      (begin
        (compiler_optimize.opt-inline-checked-spend-verdict!)
        (compiler_optimize.opt-inline-checked-accept-target!))]
    [armed-third? : bool
      (compiler_optimize.opt-inline-checked-arm-next-target!)]
    ;; read the tables before the reset puts them back
    [rich-kept? : bool
      (compiler_optimize.opt-inline-checked-accepted? callee 11 2)]
    [poor-kept? : bool
      (compiler_optimize.opt-inline-checked-accepted? callee 10 1)]
    [verdicts : i64
      (compiler_optimize.opt-inline-checked-caller-verdicts-current)]
    [accepted : i64 (compiler_optimize.opt-inline-checked-accepted-current)]
    [_reset : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      armed-second?
      ;; RICHEST FIRST: the second-recorded site is worth nine times the first
      ;; and is priced first, against the state the scan walk built
      (= first-pos 2)
      (= second-pos 1)
      ;; and the caller has nothing left to arm
      (not armed-third?)
      ;; both sites are in the accepted table, so every later walk of this
      ;; caller rebuilds both
      rich-kept?
      poor-kept?
      ;; two verdicts, two accepts
      (= verdicts 2)
      (= accepted 2))))

;; The partial state. One site of a caller is kept and the next REVERTED: the
;; reverted site never enters the accepted table, so the state the caller ends
;; on carries the first site and not the second -- which is the whole reason the
;; rollback is per site rather than per caller.
(define (compiler-optimize-inline-checked-sequence-partial-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [_begin : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    [_scan : unit
      (begin
        (compiler_optimize.opt-inline-checked-scan-record! callee 20 0 900)
        (compiler_optimize.opt-inline-checked-scan-record! callee 21 3 100))]
    [_first : unit
      (begin
        (compiler_optimize.opt-inline-checked-arm-next-target!)
        (compiler_optimize.opt-inline-checked-spend-verdict!)
        (compiler_optimize.opt-inline-checked-accept-target!))]
    ;; the second verdict reverts: spent, never accepted
    [_second : unit
      (begin
        (compiler_optimize.opt-inline-checked-arm-next-target!)
        (compiler_optimize.opt-inline-checked-spend-verdict!))]
    [kept? : bool (compiler_optimize.opt-inline-checked-accepted? callee 20 0)]
    [dropped? : bool
      (compiler_optimize.opt-inline-checked-accepted? callee 21 3)]
    [verdicts : i64
      (compiler_optimize.opt-inline-checked-caller-verdicts-current)]
    [accepted : i64 (compiler_optimize.opt-inline-checked-accepted-current)]
    [_reset : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    (and
      kept?
      (not dropped?)
      ;; both sites were priced, one survived
      (= verdicts 2)
      (= accepted 1))))

;; RICHNESS, and the growth in its denominator. Two sites worth the same by the
;; free-inline prediction alone are ordered by what they cost the caller's
;; growth budget, because that budget is a CEILING ON THEIR SUM and the order
;; decides which of them fit. Measured: the interner's three equally-predicted
;; candidates left to the block walk put a 35-block grow routine first and the
;; comparison leaf third, where the ceiling refused it for fifteen blocks.
(define (compiler-optimize-inline-checked-richness-ok?) : bool
  (and
    ;; the prediction still dominates: a site worth ten times as much outranks
    ;; a slightly cheaper one
    (>
      (compiler_optimize.opt-inline-checked-richness 640 6 60)
      (compiler_optimize.opt-inline-checked-richness 64 6 50))
    ;; equal predictions: the smaller body first
    (>
      (compiler_optimize.opt-inline-checked-richness 8 6 59)
      (compiler_optimize.opt-inline-checked-richness 8 6 276))
    ;; and arity still moves the prediction it divides
    (>
      (compiler_optimize.opt-inline-checked-richness 8 14 59)
      (compiler_optimize.opt-inline-checked-richness 8 2 59))
    ;; a degenerate body cannot divide by zero
    (> (compiler_optimize.opt-inline-checked-richness 8 6 0) 0)))

;; Fill the scan table to its cap with distinct sites of one callee, richest
;; first so the drain order is the record order.
(define (opt-inline-checked-seq-fill-scan [callee : i64] [row : i64]) : unit
  (if (>= row (compiler_optimize.opt-inline-checked-scan-cap))
    unit
    (begin
      (compiler_optimize.opt-inline-checked-scan-record!
        callee
        (+ 100 row)
        row
        (- 1000 row))
      (opt-inline-checked-seq-fill-scan callee (+ row 1)))))

;; Arm and spend verdicts until the caller is refused one, and report how many.
(define (opt-inline-checked-seq-drain [taken : i64]) : i64
  (if (compiler_optimize.opt-inline-checked-arm-next-target!)
    (begin
      (compiler_optimize.opt-inline-checked-spend-verdict!)
      (opt-inline-checked-seq-drain (+ taken 1)))
    taken))

;; THE PER-CALLER CAP. Verdicts are bounded per caller as well as per program,
;; so one caller holding many candidates cannot drain the program's budget and
;; leave every later caller unmeasured.
(define (compiler-optimize-inline-checked-caller-cap-ok?) : bool
  (let
    [callee : i64 (opt-inline-checked-seq-callee-a)]
    [cap : i64 (compiler_optimize.opt-inline-checked-max-caller-verdicts)]
    [_begin : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    [_scan : unit (opt-inline-checked-seq-fill-scan callee 0)]
    [armed : i64 (opt-inline-checked-seq-drain 0)]
    [budget-left : i64 (compiler_optimize.opt-inline-checked-budget-current)]
    [_reset : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    (and
      ;; the scan ranked more candidates than the caller may price
      (> (compiler_optimize.opt-inline-checked-scan-cap) cap)
      (= armed cap)
      ;; and the program keeps the rest of its budget for later callers
      (=
        budget-left
        (- (compiler_optimize.opt-inline-checked-program-budget) cap)))))

;; ONE CALLEE PER CALLER. Once a caller has KEPT a site, its later sites are
;; restricted to that callee. The rule is measured: the sequence's corpus wins
;; are all one body landing at the sites that share it, and its losses are all a
;; caller absorbing different bodies -- opt_quicksort took a fill loop and then
;; a checksum loop and regressed +2.01%, intern_table took a map insert and then
;; a hash and regressed +1.60%.
(define (compiler-optimize-inline-checked-one-callee-ok?) : bool
  (let
    [a : i64 (opt-inline-checked-seq-callee-a)]
    [b : i64 (opt-inline-checked-seq-callee-b)]
    [_begin : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    ;; the OTHER callee's site is the richer of the two
    [_scan : unit
      (begin
        (compiler_optimize.opt-inline-checked-scan-record! a 30 0 100)
        (compiler_optimize.opt-inline-checked-scan-record! b 31 1 900))]
    ;; before any accept, the richest wins outright
    [armed-first? : bool
      (compiler_optimize.opt-inline-checked-arm-next-target!)]
    [first-callee : i64
      (compiler_optimize.opt-inline-checked-target-callee-current)]
    ;; that first site REVERTS, which claims nothing...
    [_revert : unit (compiler_optimize.opt-inline-checked-spend-verdict!)]
    [armed-second? : bool
      (compiler_optimize.opt-inline-checked-arm-next-target!)]
    [second-callee : i64
      (compiler_optimize.opt-inline-checked-target-callee-current)]
    ;; ...and this one is KEPT, which claims the caller for callee `a`
    [_keep : unit
      (begin
        (compiler_optimize.opt-inline-checked-spend-verdict!)
        (compiler_optimize.opt-inline-checked-accept-target!))]
    ;; a fresh caller-scan holding both callees now offers only `a`
    [_next : unit
      (begin
        (compiler_optimize.opt-inline-checked-scan-record! b 32 2 900)
        (compiler_optimize.opt-inline-checked-scan-record! a 33 3 100))]
    [armed-third? : bool
      (compiler_optimize.opt-inline-checked-arm-next-target!)]
    [third-callee : i64
      (compiler_optimize.opt-inline-checked-target-callee-current)]
    [_reset : unit (compiler_optimize.opt-inline-checked-program-begin!)]
    (and
      armed-first?
      armed-second?
      armed-third?
      (= first-callee b)
      (= second-callee a)
      ;; the richer site names the other callee and is passed over for the
      ;; poorer site of the one this caller kept
      (= third-callee a))))

(define (compiler-optimize-inline-dup-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1))))

;; --- single-site absorption at any size (wide boundary, cold site) ----------
;;
;; The callee under test is the cyclic bounds-carrying Switch leaf above,
;; widened to ten parameters and padded past two hundred instructions. Every
;; band that could otherwise take it refuses it on size or on shape: the loop
;; tier caps the body at 32 instructions, the recursive-site tier at 128 and
;; wants a self-recursive caller, and no cost-model path reaches it at all
;; because a cyclic bounds-carrying body fails
;; opt-inline-multiblock-bounds-loop-ok?. So whatever these fixtures admit was
;; admitted by opt-inline-single-site-absorb-ok? and by nothing else, and only
;; the CALLER or the callee's reference count varies across them.
(define (opt-inline-wide-param-count) : i64
  10)

(define (opt-inline-wide-pad-count) : i64
  220)

(define (opt-inline-wide-params-from [index : i64] [count : i64]) : compiler_ir_types.CompilerIrParamList
  (if (>= index count)
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "wide"
        (compiler_ast_types.AstType.I64)
        index)
      (opt-inline-wide-params-from (+ index 1) count))))

(define (opt-inline-wide-params [count : i64]) : compiler_ir_types.CompilerIrParamList
  (opt-inline-wide-params-from 0 count))

;; Straight-line adds, each defining a fresh var, in front of `tail`. This
;; padding is the only thing standing between the fixture and the size ceilings
;; this band exists to remove.
(define (opt-inline-wide-pad-instrs
  [remaining : i64]
  [dst : i64]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (if (<= remaining 0)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-wide-pad-instrs (- remaining 1) (+ dst 1) tail)
      (compiler_ir_types.CompilerIrInstr.BinOp
        dst
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64)))))

;; The join phi sits just past the padding, so a fixture's var count is
;; params + padding + 1.
(define (opt-inline-wide-phi-var [params : i64]) : i64
  (+ params (opt-inline-wide-pad-count)))

(define (opt-inline-wide-loop-phi-instr [params : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Phi
    (opt-inline-wide-phi-var params)
    (compiler_ir_types.compiler-ir-phi-input-cons
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ir_types.compiler-ir-label "zero")
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 20)
        (compiler_ir_types.compiler-ir-label "one")
        compiler_ir_types.CompilerIrPhiInputList.Nil))
    (compiler_ast_types.AstType.I64)))

;; entry -> loop -> {zero, one} -> join, with the loop's default edge back to
;; `loop`. Cyclic and bounds-carrying, so every size-capped band refuses it.
(define (opt-inline-wide-callee-blocks
  [params : i64]
  [extra-loop-instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs-with-tail
          (opt-inline-wide-pad-instrs
            (opt-inline-wide-pad-count)
            params
            (opt-test-instr-seq-append
              extra-loop-instrs
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Switch
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  0
                  (opt-inline-switch-cases
                    (compiler_ir_types.compiler-ir-label "zero")
                    (compiler_ir_types.compiler-ir-label "one"))
                  (compiler_ir_types.compiler-ir-label "loop")))))
          (opt-inline-switch-loop-bounds-instr
            (compiler_ir_types.compiler-ir-label "switch_bounds_ok"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "zero")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "one")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "join")
              (opt-test-instrs
                (opt-inline-wide-loop-phi-instr params)
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var
                      (opt-inline-wide-phi-var params))))))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-inline-wide-callee-arity [callee-name : i64] [params : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-wide-params params)
    (compiler_ast_types.AstType.I64)
    (+ (opt-inline-wide-phi-var params) 1)
    (opt-inline-wide-callee-blocks
      params
      (compiler_ir_types.compiler-ir-instr-seq-empty))))

(define (opt-inline-wide-callee [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-wide-callee-arity callee-name (opt-inline-wide-param-count)))

;; Argument slots cycle over the caller's three live vars, so no
;; all-constant-argument path can admit a site behind the band's back.
(define (opt-inline-wide-fill-args!
  [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)]
  [index : i64]
  [count : i64]
  [slot : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (set! (array-ref args index) (compiler_ir_types.CompilerIrValue.Var slot))
      (opt-inline-wide-fill-args!
        args
        (+ index 1)
        count
        (if (>= (+ slot 1) 3)
          0
          (+ slot 1))))))

(define (opt-inline-wide-call [callee-name : i64] [params : i64] [dst : i64]) : compiler_ir_types.CompilerIrInstr
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue params)]
    (begin
      (opt-inline-wide-fill-args! args 0 params 0)
      (compiler_ir_types.CompilerIrInstr.Call
        dst
        callee-name
        (compiler_ir_types.CompilerIrCallArgs.Array args)
        (compiler_ast_types.AstType.I64)))))

;; The same wide callee with one call inside its loop, for the call-free clause.
(define (opt-inline-wide-callee-calling [callee-name : i64] [helper-name : i64]) : compiler_ir_types.CompilerIrFunction
  (let
    [params : i64 (opt-inline-wide-param-count)]
    (compiler_ir_types.CompilerIrFunction.Function
      callee-name
      (opt-inline-wide-params params)
      (compiler_ast_types.AstType.I64)
      (+ (opt-inline-wide-phi-var params) 2)
      (opt-inline-wide-callee-blocks
        params
        (opt-test-instrs
          (opt-inline-wide-call
            helper-name
            params
            (+ (opt-inline-wide-phi-var params) 1)))))))

;; A straight-line caller: the site is in no natural loop, which is what this
;; band requires and what the loop tier forbids.
(define (opt-inline-wide-cold-caller
  [func-name : i64]
  [callee-name : i64]
  [params : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-wide-call callee-name params 3)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The same straight-line caller with the callee's address taken first. Nothing
;; else differs from the headline fixture.
(define (opt-inline-wide-address-taken-caller
  [func-name : i64]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    5
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            4
            (compiler_ir_types.CompilerIrValue.Function callee-name)
            (compiler_ast_types.AstType.I64))
          (opt-inline-wide-call callee-name (opt-inline-wide-param-count) 3)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The same caller with the wide call inside a natural loop. entry -> header ->
;; {body -> latch -> header, exit}, with the call in `body`; the back edge
;; leaves from `latch` so the call block is not a phi predecessor.
(define (opt-inline-wide-loop-caller-blocks [callee-name : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-inline-loop-site-entry-instrs))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            4
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "latch")
                compiler_ir_types.CompilerIrPhiInputList.Nil))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (opt-inline-wide-call callee-name (opt-inline-wide-param-count) 5)
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "latch")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 4)))))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-inline-wide-loop-caller [func-name : i64] [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    6
    (opt-inline-wide-loop-caller-blocks callee-name)))

;; The middle link of the cascade: wide, single-site, straight-line, multiblock,
;; and itself calling the wide leaf. It carries a bounds check of its own so
;; that the separately-tested cascade clause -- which refuses an import that
;; would hand a bounds-FREE single-site caller its first bounds check -- is not
;; what this fixture ends up measuring.
(define (opt-inline-wide-cascade-middle [func-name : i64] [leaf-name : i64]) : compiler_ir_types.CompilerIrFunction
  (let
    [params : i64 (opt-inline-wide-param-count)]
    (compiler_ir_types.CompilerIrFunction.Function
      func-name
      (opt-inline-wide-params params)
      (compiler_ast_types.AstType.I64)
      (+ params 1)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.compiler-ir-label "mid_bounds_ok"))
            (opt-inline-wide-call leaf-name params params)
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var params)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-inline-wide-optimized
  [functions : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    functions
    2))

(define (opt-inline-wide-two-function-optimized
  [caller : compiler_ir_types.CompilerIrFunction]
  [callee : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (opt-inline-wide-optimized
    (compiler_ir_types.compiler-ir-function-seq-prepend
      caller
      (compiler_ir_types.compiler-ir-function-seq-prepend
        callee
        (compiler_ir_types.compiler-ir-function-seq-empty)))))

(define (opt-inline-wide-remaining-calls
  [optimized : compiler_ir_types.CompilerIrFunctionSeq]) : i64
  (opt-count-direct-call-name-function-seq optimized "main" "inline_switch"))

;; The headline case: a 220-instruction, ten-parameter, single-site callee is
;; absorbed whole at its one straight-line site. The call disappears, the body
;; lands, and the bounds check the callee owned is now the caller's.
(define (compiler-optimize-inline-single-site-wide-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-two-function-optimized
        (opt-inline-wide-cold-caller
          symbols.main
          callee-name
          (opt-inline-wide-param-count))
        (opt-inline-wide-callee callee-name))]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_switch") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; The identical callee at an IN-LOOP site is absorbed too, and the body it
;; lands is the same one. THIS WAS A REFUSAL TEST, on the argument that an
;; unbounded body may be moved next to a loop and not inside one. What that
;; argument priced was the merged frame, which is paid once per caller
;; invocation -- while at an in-loop site the boundary it buys is retired once
;; per ITERATION. The measurement it rested on (liveness_scan +17.10%, and
;; +13.3% re-measured) was an allocator fact, and the allocator packets under
;; this one retired it: the same absorption now measures liveness_scan -1.113%
;; and intern_table -8.451%. See clause 3 at opt-inline-single-site-absorb-ok?.
(define (compiler-optimize-inline-single-site-wide-loop-site-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-two-function-optimized
        (opt-inline-wide-loop-caller symbols.main callee-name)
        (opt-inline-wide-callee callee-name))]
    (match (compiler_optimize.opt-function-seq-find optimized "main")
      [(compiler_optimize.OptMaybeFunction.Some main)
        (let
          [blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_optimize.opt-function-blocks main)]
          (and
            (= (opt-count-direct-call-name-blocks blocks "inline_switch") 0)
            (= (compiler_optimize.opt-count-bounds-blocks blocks) 1)
            (compiler_optimize.opt-inline-structure-ok? blocks)))]
      [(compiler_optimize.OptMaybeFunction.No) false])))

;; A chain of `count` jump-only blocks labelled chain_0 .. chain_(count-1),
;; each jumping to the next and the last jumping to `tail-label`. This is how
;; the fixtures below reach an exact block count without adding instructions
;; the cost model would price or edges the acyclic checks would refuse.
(define (opt-inline-chain-block-label [index : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat "chain_" (string.int->string index) "")))

(define (opt-inline-chain-blocks
  [index : i64]
  [count : i64]
  [tail-label : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index count)
    tail
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (opt-inline-chain-block-label index)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (if (>= (+ index 1) count)
              tail-label
              (opt-inline-chain-block-label (+ index 1))))))
      (opt-inline-chain-blocks (+ index 1) count tail-label tail))))

(define (opt-inline-chain-exit-label) : i64
  (compiler_ir_types.compiler-ir-label "chain_exit"))

(define (opt-inline-chain-exit-block) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (opt-inline-chain-exit-label)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.I64 0)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

;; A bounds-free, call-free, acyclic single-site callee of exactly `blocks`
;; blocks and `params` parameters. Nothing but the band can admit it once it is
;; past the cost model's 32-block fuel: the hot-loop-leaf gate wants a cyclic
;; body, the chain gate wants an in-loop site, and the measured tier wants a
;; site at loop depth 1 or more.
(define (opt-inline-chain-callee
  [callee-name : i64]
  [params : i64]
  [blocks : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-wide-params params)
    (compiler_ast_types.AstType.I64)
    params
    (opt-inline-chain-blocks
      0
      (- blocks 1)
      (opt-inline-chain-exit-label)
      (opt-inline-chain-exit-block))))

;; The same straight-line caller as opt-inline-wide-cold-caller with `pad`
;; jump-only blocks in front of the call block, so the fixture can name the
;; caller's block count exactly. Total blocks are `pad + 1`.
(define (opt-inline-wide-padded-caller
  [func-name : i64]
  [callee-name : i64]
  [params : i64]
  [pad : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    4
    (opt-inline-chain-blocks
      0
      pad
      (compiler_ir_types.compiler-ir-label "site")
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "site")
          (opt-test-instrs
            (opt-inline-wide-call callee-name params 3)
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 3)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; Below the arity floor there is no argument marshalling for the absorption to
;; retire and the narrow class stays with the site-conditioned tiers: the
;; identical 220-instruction body that the band absorbs at ten parameters stays
;; out of line at three, in a two-block caller (the small-caller relief that
;; once admitted it measured nothing in the corpus and merged every small
;; program's single-site functions into `main`; see
;; opt-inline-single-site-min-params) ...
(define (compiler-optimize-inline-single-site-narrow-small-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [narrow : i64 3]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-padded-caller symbols.main callee-name narrow 1)
          (opt-inline-wide-callee-arity callee-name narrow)))
      1)))

;; ... and in a 71-block one, the shape the corpus measured: `pl-parse-line` at
;; 127 blocks and `pl-record-sweep` at 197 took three and one narrow
;; absorptions respectively and cost peephole_lines +1.29%.
(define (compiler-optimize-inline-single-site-narrow-large-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [narrow : i64 3]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-padded-caller symbols.main callee-name narrow 70)
          (opt-inline-wide-callee-arity callee-name narrow)))
      1)))

;; --- the narrow class at an IN-LOOP site ------------------------------------
;;
;; Clause 2's second half, on the shape the corpus measured. The leaf is the
;; cyclic bounds-carrying Switch leaf the loop tier is built around -- three
;; parameters, seven instructions in five blocks, call-free -- and `mid` is
;; single-reference and bounds-free, so the loop tier refuses the import on its
;; cascade clause and nothing else in this file can admit it. That is exactly
;; `stdlib.vector.generated.i64/set-ref!` (3 parameters, 22 instructions in 6
;; blocks) at its in-loop site in `cfg-scan-ints` and `gvn-scan-ints`, which
;; the waiver moves for cfg_domloops -0.590% and gvn_table -1.291%.
;;
;; Each fixture below builds one program and varies one thing: where `mid`
;; makes the call, and how big the leaf is.
(define (opt-inline-narrow-site-program
  [symbols : OptInlineMultiTestSymbols]
  [mid : compiler_ir_types.CompilerIrFunction]
  [leaf : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-switch-caller-named symbols symbols.inline-nonleaf)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      mid
      (compiler_ir_types.compiler-ir-function-seq-prepend
        leaf
        (compiler_ir_types.compiler-ir-function-seq-empty)))))

(define (opt-inline-narrow-site-optimized
  [symbols : OptInlineMultiTestSymbols]
  [mid : compiler_ir_types.CompilerIrFunction]
  [leaf : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-inline-narrow-site-program symbols mid leaf)
    2))

;; Calls to the leaf left in `mid`. `main`'s own copy of `mid`, if the cost
;; model took one, is not counted: the inliner leaves the original function
;; standing for global DCE to remove afterwards, so `mid` is the one place that
;; answers whether the import happened.
(define (opt-inline-narrow-site-remaining-calls
  [optimized : compiler_ir_types.CompilerIrFunctionSeq]) : i64
  (opt-count-direct-call-name-function-seq
    optimized
    "inline_nonleaf"
    "inline_switch"))

;; The same five blocks and the same natural loop as opt-inline-loop-site-
;; function, with the one call moved out of `body` and into `entry`. The pair
;; differs in the SITE and in nothing else.
(define (opt-inline-straight-site-function
  [func-name : i64]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    6
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instr-seq-prepend
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (opt-test-instr-seq-prepend
            (opt-inline-loop-site-call callee-name 5)
            (opt-test-instr-seq-prepend
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))
              (compiler_ir_types.compiler-ir-instr-seq-empty)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "header")
          (opt-test-instr-seq-prepend
            (compiler_ir_types.CompilerIrInstr.Phi
              4
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 5)
                  (compiler_ir_types.compiler-ir-label "latch")
                  compiler_ir_types.CompilerIrPhiInputList.Nil))
              (compiler_ast_types.AstType.I64))
            (opt-test-instr-seq-prepend
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.compiler-ir-label "exit"))
              (compiler_ir_types.compiler-ir-instr-seq-empty))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-test-instr-seq-prepend
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "latch"))
              (compiler_ir_types.compiler-ir-instr-seq-empty)))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "latch")
              (opt-test-instr-seq-prepend
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))
                (compiler_ir_types.compiler-ir-instr-seq-empty)))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instr-seq-prepend
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 4)))
                  (compiler_ir_types.compiler-ir-instr-seq-empty)))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

;; `count` extra Movs ahead of the `zero` case's jump. The leaf keeps its five
;; blocks, its three parameters, its bounds check and its loop, and only its
;; instruction count moves, so a pair of fixtures can sit either side of
;; opt-inline-bounds-loop-max-body.
(define (opt-inline-narrow-fat-zero-instrs [count : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (<= count 0)
    (opt-inline-dup-leaf-jump-zero-instrs)
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.Mov
        4
        (compiler_ir_types.CompilerIrValue.I64 count)
        (compiler_ast_types.AstType.I64))
      (opt-inline-narrow-fat-zero-instrs (- count 1)))))

(define (opt-inline-narrow-fat-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    5
    (opt-inline-narrow-fat-zero-instrs 40)))

;; Below the arity floor, at an IN-LOOP site, at the loop tier's size and
;; call-free: the body moves. Nothing else in the file admits this shape -- the
;; loop tier refuses it on the cascade clause, the hot-loop-leaf gate asks the
;; same clause, and a cyclic bounds-carrying body has no cost-model path.
(define (compiler-optimize-inline-single-site-narrow-loop-site-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    (=
      (opt-inline-narrow-site-remaining-calls
        (opt-inline-narrow-site-optimized
          symbols
          (opt-inline-loop-site-function
            symbols.inline-nonleaf
            leaf-name
            (opt-inline-loop-site-entry-instrs))
          (opt-inline-switch-callee-named leaf-name)))
      0)))

;; The same leaf and the same caller with the call moved into `entry`: at a
;; STRAIGHT-LINE site the boundary is retired once per caller invocation, the
;; frame tax is paid at the same rate, and below the arity floor there is no
;; marshalling in that boundary to tip the comparison. The narrow class stays
;; out.
(define (compiler-optimize-inline-single-site-narrow-straight-site-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    (=
      (opt-inline-narrow-site-remaining-calls
        (opt-inline-narrow-site-optimized
          symbols
          (opt-inline-straight-site-function symbols.inline-nonleaf leaf-name)
          (opt-inline-switch-callee-named leaf-name)))
      1)))

;; ... and past the loop tier's size class the same in-loop site refuses it:
;; 47 instructions is past opt-inline-bounds-loop-max-body, which is where
;; clause 2 stops admitting a below-floor boundary. Everything else is the
;; positive fixture above.
(define (compiler-optimize-inline-single-site-narrow-oversize-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    (=
      (opt-inline-narrow-site-remaining-calls
        (opt-inline-narrow-site-optimized
          symbols
          (opt-inline-loop-site-function
            symbols.inline-nonleaf
            leaf-name
            (opt-inline-loop-site-entry-instrs))
          (opt-inline-narrow-fat-leaf leaf-name)))
      1)))

;; A wide single-site callee at the pathological-case backstop is still
;; absorbed: 128 blocks is opt-inline-single-site-max-blocks exactly, and this
;; band has no growth budget to spend.
(define (compiler-optimize-inline-single-site-size-cap-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [wide : i64 (opt-inline-wide-param-count)]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller symbols.main callee-name wide)
          (opt-inline-chain-callee callee-name wide 128)))
      0)))

;; One block past the backstop and the same body stays out of line. Nothing but
;; the backstop refuses it: the reference class, the arity, the site and the
;; call-free body are all what the fixture above uses.
(define (compiler-optimize-inline-single-site-size-cap-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [wide : i64 (opt-inline-wide-param-count)]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller symbols.main callee-name wide)
          (opt-inline-chain-callee callee-name wide 129)))
      1)))

;; A one-parameter, one-block, three-reference leaf: too many references to be
;; absorbable, small enough that the ordinary cost model admits it (1
;; instruction against a call bonus of 6). The only thing that can refuse it is
;; the shared block fuel.
(define (opt-inline-fuel-tiny-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-wide-params 1)
    (compiler_ast_types.AstType.I64)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            1
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 1)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-fuel-tiny-call [callee-name : i64] [dst : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Call
    dst
    callee-name
    (compiler_ir_types.CompilerIrCallArgs.One
      (compiler_ir_types.CompilerIrValue.Var 0))
    (compiler_ast_types.AstType.I64)))

;; entry absorbs the 34-block single-site callee; `mid` then holds three sites
;; of the tiny leaf, walked with whatever growth accumulator the absorption
;; left behind.
(define (opt-inline-fuel-caller
  [func-name : i64]
  [big-name : i64]
  [tiny-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    8
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (opt-inline-wide-call big-name (opt-inline-wide-param-count) 3)
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "mid"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "mid")
          (opt-test-instrs
            (opt-inline-fuel-tiny-call tiny-name 4)
            (opt-inline-fuel-tiny-call tiny-name 5)
            (opt-inline-fuel-tiny-call tiny-name 6)
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 6)))))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

;; The band MOVES a body; it does not copy one, so the blocks it lands do not
;; spend the shared growth budget the cost model draws on. The 34-block
;; absorption in `entry` is past that budget on its own, and the three
;; one-instruction leaf sites in `mid` are admitted anyway. With the moved
;; blocks charged to `added-so-far` instead they are all three refused -- which
;; is what left `it-i64-ref` and `it-bucket` behind calls in intern_table's
;; `it-bench`, 27.2M of callgrind self cost the base tree does not pay.
(define (compiler-optimize-inline-single-site-absorb-keeps-block-fuel-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [big-name : i64 symbols.inline-switch]
    [tiny-name : i64 symbols.external-helper]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-fuel-caller symbols.main big-name tiny-name)
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-chain-callee big-name (opt-inline-wide-param-count) 34)
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-inline-fuel-tiny-leaf tiny-name)
              (compiler_ir_types.compiler-ir-function-seq-empty)))))]
    (and
      (= (opt-inline-wide-remaining-calls optimized) 0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "external_helper")
        0))))

;; Two references is not absorption. The identical callee reached from two cold
;; sites keeps its body at both: this band moves, it never copies, and the
;; duplication tier that does copy caps the body at 32.
(define (compiler-optimize-inline-single-site-two-reference-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-wide-cold-caller
            symbols.main
            callee-name
            (opt-inline-wide-param-count))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-wide-cold-caller
              symbols.inline-loop
              callee-name
              (opt-inline-wide-param-count))
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-inline-wide-callee callee-name)
              (compiler_ir_types.compiler-ir-function-seq-empty)))))]
    (and
      (= (opt-inline-wide-remaining-calls optimized) 1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; A callee that calls itself is refused, and refused by the reference count
;; rather than by a clause of its own: the census counts the self-call, so one
;; external caller plus one self-call is two references, not one. (The
;; call-free clause refuses it a second time; the fixture below isolates that
;; clause on a callee that is not recursive.)
(define (compiler-optimize-inline-single-site-self-recursive-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller
            symbols.main
            callee-name
            (opt-inline-wide-param-count))
          (opt-inline-wide-callee-calling callee-name callee-name)))
      1)))

;; The same wide callee with one call to an external helper in its body stays
;; out of line AT A STRAIGHT-LINE SITE: this band prices a body by counting it,
;; and a callee's own calls are a cost those counts do not carry -- the wider
;; callee-saved prologue they force at the merged entry is paid once per caller
;; invocation, and here the boundary it buys is retired once per caller
;; invocation too. The fixture below is the same callee at an in-loop site;
;; only the caller differs.
(define (compiler-optimize-inline-single-site-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-cold-caller
            symbols.main
            callee-name
            (opt-inline-wide-param-count))
          (opt-inline-wide-callee-calling callee-name symbols.external-helper)))
      1)))

;; ... and at an IN-LOOP site the same call-carrying body absorbs. The imported
;; call already ran once per iteration before the move, so nothing inside the
;; iteration changes except that the boundary stops running in it. This is the
;; measured intern_table shape: `it-intern-slice` calls `it-hash-words`,
;; `it-grow!` and `it-map-insert-from` and absorbs into `it-bench`'s per-line
;; loop for -8.451%.
(define (compiler-optimize-inline-single-site-loop-site-call-bearing-absorb-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-loop-caller symbols.main callee-name)
          (opt-inline-wide-callee-calling callee-name symbols.external-helper)))
      0)))

;; An address-taken callee is refused even at one call site: the address is a
;; second way in, so the body cannot move.
(define (compiler-optimize-inline-single-site-address-taken-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    (=
      (opt-inline-wide-remaining-calls
        (opt-inline-wide-two-function-optimized
          (opt-inline-wide-address-taken-caller symbols.main callee-name)
          (opt-inline-wide-callee callee-name)))
      1)))

;; The clause-6 pair, on the shape the cascade clause exists for. `mid` is
;; single-reference and carries no bounds check of its own, so importing the
;; bounds-carrying wide leaf hands it its first one and costs it its own inline
;; -- which is what the clause refuses. Both programs are identical except for
;; where `mid` makes the call: `opt-inline-wide-cold-caller` puts it in
;; straight-line code, `opt-inline-wide-loop-caller` puts it in a natural loop.
;; The leaf is the call-free ten-parameter body the headline fixture absorbs,
;; so the cascade clause is the only thing that can separate the two.
;;
;; The loop tier keeps this clause at both sites and has its own fixture for it
;; (compiler-optimize-inline-bounds-loop-cascade-refusal-ok?, the measured
;; `qs-fill`/`qs-bench` shape). That leaf takes three parameters, so the arity
;; floor keeps this band away from it entirely and the two verdicts do not
;; collide.
(define (opt-inline-single-site-cascade-clause-program
  [symbols : OptInlineMultiTestSymbols]
  [mid : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-switch-caller-named symbols symbols.inline-nonleaf)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      mid
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-wide-callee symbols.inline-switch)
        (compiler_ir_types.compiler-ir-function-seq-empty)))))

(define (compiler-optimize-inline-single-site-cascade-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (opt-inline-single-site-cascade-clause-program
          symbols
          (opt-inline-wide-cold-caller
            symbols.inline-nonleaf
            symbols.inline-switch
            (opt-inline-wide-param-count))))]
    [admitted : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (opt-inline-single-site-cascade-clause-program
          symbols
          (opt-inline-wide-loop-caller
            symbols.inline-nonleaf
            symbols.inline-switch)))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          refused
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          admitted
          "inline_nonleaf"
          "inline_switch")
        0))))

;; The cascade. `main` calls a wide single-site middle function, which calls the
;; wide single-site leaf. SCC order absorbs the leaf into the middle function
;; first, which makes the middle function call-free in time to be absorbed into
;; `main` in the SAME pass, so both boundaries are gone after one run.
;;
;; Reported as one number so the achieved depth is visible when it changes:
;; ten times the calls to the middle function still in `main`, plus the calls
;; to the leaf still anywhere. 0 is the full two-level cascade; 10 would be the
;; leaf absorbed but the middle function left standing.
(define (compiler-optimize-inline-single-site-cascade-depth-code) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [leaf-name : i64 symbols.inline-switch]
    [mid-name : i64 symbols.inline-nonleaf]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-wide-optimized
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-inline-wide-cold-caller
            symbols.main
            mid-name
            (opt-inline-wide-param-count))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-wide-cascade-middle mid-name leaf-name)
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-inline-wide-callee leaf-name)
              (compiler_ir_types.compiler-ir-function-seq-empty)))))]
    (+
      (*
        10
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_nonleaf"))
      (+
        (opt-inline-wide-remaining-calls optimized)
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")))))

;; --- shared acyclic accessor admission --------------------------------------
;;
;; The callee under test is an ACYCLIC bounds-carrying Switch leaf reached from
;; several in-loop sites -- the measured pl-byte-at shape. Every fixture below
;; builds the same program and varies exactly one thing: the number of callers
;; (the reference floor), whether the body makes a call, whether the body is
;; cyclic, and whether the sites sit in loops.
(define (opt-inline-shared-accessor-leaf-named
  [callee-name : i64]
  [vars : i64]
  [zero-instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    vars
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "switch_bounds_ok"))
          (compiler_ir_types.CompilerIrInstr.Switch
            (compiler_ir_types.CompilerIrValue.Var 0)
            0
            (opt-inline-switch-cases
              (compiler_ir_types.compiler-ir-label "zero")
              (compiler_ir_types.compiler-ir-label "one"))
            (compiler_ir_types.compiler-ir-label "other"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "zero")
          zero-instrs)
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "one")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "other")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "join")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    3
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.I64 10)
                      (compiler_ir_types.compiler-ir-label "zero")
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.I64 20)
                        (compiler_ir_types.compiler-ir-label "one")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.I64 30)
                          (compiler_ir_types.compiler-ir-label "other")
                          compiler_ir_types.CompilerIrPhiInputList.Nil)))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 3)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-inline-shared-accessor-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-shared-accessor-leaf-named
    callee-name
    4
    (opt-inline-dup-leaf-jump-zero-instrs)))

(define (opt-inline-shared-accessor-calling-leaf
  [callee-name : i64]
  [helper-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-shared-accessor-leaf-named
    callee-name
    5
    (opt-inline-dup-leaf-call-zero-instrs helper-name)))

;; The same cyclic body with one call in its `zero` case: refused by the
;; accessor's call-free pricing clause and by the hot loop leaf's.
(define (opt-inline-shared-cyclic-calling-leaf
  [callee-name : i64]
  [helper-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    5
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "loop"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "loop")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Switch
              (compiler_ir_types.CompilerIrValue.Var 0)
              0
              (opt-inline-switch-cases
                (compiler_ir_types.compiler-ir-label "zero")
                (compiler_ir_types.compiler-ir-label "one"))
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "zero")
            (opt-inline-dup-leaf-call-zero-instrs helper-name))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "one")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "join")
                (opt-test-instrs
                  (opt-inline-switch-loop-phi-instr)
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 3)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

;; Straight-line callers, for the site clause.
(define (opt-inline-shared-flat-caller-chain
  [names : compiler_optimize.OptSlotList]
  [callee-name : i64]
  [tail : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (match names
    [(compiler_optimize.OptSlotList.Nil) tail]
    [(compiler_optimize.OptSlotList.Cons name rest)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (compiler_ir_types.CompilerIrFunction.Function
          name
          (opt-inline-switch-params)
          (compiler_ast_types.AstType.I64)
          4
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "entry")
              (opt-test-instrs
                (opt-inline-switch-caller-call-named callee-name)
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 3)))))
            compiler_ir_types.CompilerIrBlockList.Nil))
        (opt-inline-shared-flat-caller-chain
          (__tl-box-place rest)
          callee-name
          tail))]))

(define (opt-inline-shared-caller-names
  [symbols : OptInlineMultiTestSymbols]
  [count : i64]) : compiler_optimize.OptSlotList
  (let
    [all : (__tl_dyn-array i64) (array.make-array i64 5)]
    [acc : compiler_optimize.OptSlotList (compiler_optimize.OptSlotList.Nil)]
    [i : i64 0]
    (begin
      (set! (array-ref all 0) symbols.main)
      (set! (array-ref all 1) symbols.inline-nonleaf)
      (set! (array-ref all 2) symbols.inline-loop)
      (set! (array-ref all 3) symbols.mb-bounds)
      (set! (array-ref all 4) symbols.inline-branch)
      (while (< i count)
        (begin
          (set!
            acc
            (compiler_optimize.OptSlotList.Cons (array-ref all i) (box acc)))
          (set! i (+ i 1))))
      acc)))

;; Total direct calls to `call-name` left across the first `count` caller names.
(define (opt-inline-shared-remaining-calls
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [count : i64]) : i64
  (let
    [names : (__tl_dyn-array String) (array.make-array String 5)]
    [total : i64 0]
    [i : i64 0]
    (begin
      (set! (array-ref names 0) "main")
      (set! (array-ref names 1) "inline_nonleaf")
      (set! (array-ref names 2) "inline_loop")
      (set! (array-ref names 3) "mb_bounds")
      (set! (array-ref names 4) "inline_branch")
      (while (< i count)
        (begin
          (set!
            total
            (+
              total
              (opt-count-direct-call-name-function-seq
                functions
                (array-ref names i)
                "inline_switch")))
          (set! i (+ i 1))))
      total)))

(define (opt-inline-shared-accessor-optimized
  [symbols : OptInlineMultiTestSymbols]
  [count : i64]
  [in-loop? : bool]
  [leaf : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (let
    [callee-name : i64 symbols.inline-switch]
    [names : compiler_optimize.OptSlotList
      (opt-inline-shared-caller-names symbols count)]
    [tail : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_ir_types.compiler-ir-function-seq-prepend
        leaf
        (compiler_ir_types.compiler-ir-function-seq-empty))]
    (compiler_optimize.opt-inline-program-functions
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (if in-loop?
        (opt-inline-dup-caller-chain names callee-name tail)
        (opt-inline-shared-flat-caller-chain names callee-name tail))
      2)))

;; Five in-loop callers put the leaf at the reference floor and every site takes
;; it; four leave it one short and every site keeps its call.
(define (compiler-optimize-inline-shared-accessor-floor-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        true
        (opt-inline-shared-accessor-leaf callee-name))]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        4
        true
        (opt-inline-shared-accessor-leaf callee-name))]
    (and
      (= (opt-inline-shared-remaining-calls admitted 5) 0)
      (= (opt-inline-shared-remaining-calls refused 4) 4))))

;; The same leaf with one call in its body stays out of line at all five sites:
;; this band copies one body into every site, so the cost a callee's own calls
;; carry is paid five times over and its model cannot see any of it.
(define (compiler-optimize-inline-shared-accessor-call-free-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        true
        (opt-inline-shared-accessor-calling-leaf
          callee-name
          symbols.external-helper))]
    (= (opt-inline-shared-remaining-calls refused 5) 5)))

;; A cyclic CALL-BEARING body at the same five in-loop sites stays refused:
;; this admission is for the acyclic accessor, and the hot loop leaf's
;; call-free pricing clause refuses the cyclic shape from the other side. A
;; cyclic call-free leaf at these sites is no longer refused anywhere -- it is
;; exactly what opt-inline-hot-loop-leaf-ok? admits, and that is covered by the
;; hot-loop-leaf tests below.
(define (compiler-optimize-inline-shared-accessor-acyclic-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        true
        (opt-inline-shared-cyclic-calling-leaf
          callee-name
          symbols.external-helper))]
    (= (opt-inline-shared-remaining-calls refused 5) 5)))

;; The identical leaf at five STRAIGHT-LINE sites stays refused: a boundary that
;; runs once per call cannot repay a duplicated body.
(define (compiler-optimize-inline-shared-accessor-in-loop-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        5
        false
        (opt-inline-shared-accessor-leaf callee-name))]
    (= (opt-inline-shared-remaining-calls refused 5) 5)))

;; --- dominant-reference accessors at straight-line sites ---------------------
;;
;; Same leaf, same straight-line callers as the refusal directly above; the only
;; thing that varies is how many of them there are. Below
;; opt-inline-shared-accessor-dominant-min-refcount the per-site loop clause
;; still refuses every one; at the floor the callee's own weight is the
;; argument and every site takes it.
(define (opt-inline-dominant-caller-text [index : i64]) : String
  (str_cat.str-cat "dominant_caller_" (string.int->string index)))

(define (opt-inline-dominant-caller-names-from [index : i64] [count : i64]) : compiler_optimize.OptSlotList
  (if (>= index count)
    (compiler_optimize.OptSlotList.Nil)
    (compiler_optimize.OptSlotList.Cons
      (opt-test-symbol (opt-inline-dominant-caller-text index))
      (box (opt-inline-dominant-caller-names-from (+ index 1) count)))))

(define (opt-inline-dominant-remaining-calls
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [index : i64]
  [count : i64]) : i64
  (if (>= index count)
    0
    (+
      (opt-count-direct-call-name-function-seq
        functions
        (opt-inline-dominant-caller-text index)
        "inline_switch")
      (opt-inline-dominant-remaining-calls functions (+ index 1) count))))

(define (opt-inline-dominant-optimized [callee-name : i64] [count : i64]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-inline-shared-flat-caller-chain
      (opt-inline-dominant-caller-names-from 0 count)
      callee-name
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-shared-accessor-leaf callee-name)
        (compiler_ir_types.compiler-ir-function-seq-empty)))
    2))

;; 64 straight-line callers put the leaf at the dominant floor and every site
;; takes it; 63 leave it one short and every site keeps its call. This is the
;; one clause the two counts differ in: the sites, the leaf, and every budget
;; are identical.
(define (compiler-optimize-inline-shared-accessor-dominant-floor-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dominant-optimized callee-name 64)]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dominant-optimized callee-name 63)]
    (and
      (= (opt-inline-dominant-remaining-calls admitted 0 64) 0)
      (= (opt-inline-dominant-remaining-calls refused 0 63) 63))))

;; A CALL-BEARING body at the dominant floor stays refused at all 64 sites: the
;; floor relaxes the two per-site questions, not the pricing clause that keeps
;; a copied body's own calls out of a model that cannot count them.
(define (compiler-optimize-inline-shared-accessor-dominant-call-free-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-shared-flat-caller-chain
          (opt-inline-dominant-caller-names-from 0 64)
          callee-name
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-shared-accessor-calling-leaf
              callee-name
              symbols.external-helper)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (= (opt-inline-dominant-remaining-calls refused 0 64) 64)))

;; --- dominant accessors reached by loop-depth weight -------------------------
;;
;; The tier above is entered on 64 counted references. It is also entered on 64
;; WEIGHTED references, where a site inside one loop weighs 8 and a site inside
;; a nested loop weighs 64 (opt-inline-census-depth-weight). Two sites at depth
;; two therefore clear the same floor that took 64 straight-line sites.
;;
;; The leaf below is built to be refused by every other band, so these fixtures
;; isolate exactly the weighted entrance:
;;
;;   - eight blocks, so the duplication band's 32/6 refuses it on block count
;;     and the cost model prices it at 12 + 6*9 against a threshold of 4;
;;   - one block holding four instructions, so the branch-chain gate's
;;     three-instruction block cap refuses it;
;;   - two static references, so the shared tier's raw floor of five refuses it.
;;     This used to refuse the hot-loop-leaf gate too, whose reference clause
;;     began at three; that clause now begins at one, so what keeps the leaf out
;;     of that band is its LAST clause instead -- the body is acyclic, and the
;;     band takes only genuinely cyclic ones. That makes this fixture the
;;     acyclic clause's pin: if the band ever stopped asking, the
;;     one-loop-shallower refusal below would start admitting;
;;   - bounds-free, acyclic and call-free, so nothing above refuses it for a
;;     reason the weighted entrance does not own.
(define (opt-inline-depth-leaf-zero-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      4
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      5
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      6
      (compiler_ir_types.CompilerIrValue.I64 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "join"))))

(define (opt-inline-depth-relay-label [index : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat "relay" (string.int->string index))))

;; `other` -> relay_0 -> ... -> relay_{count-1} -> join. The chain length is the
;; only thing separating the admitted leaf from the oversize one.
(define (opt-inline-depth-relay-blocks
  [index : i64]
  [count : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index count)
    tail
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (opt-inline-depth-relay-label index)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (if (= (+ index 1) count)
              (compiler_ir_types.compiler-ir-label "join")
              (opt-inline-depth-relay-label (+ index 1))))))
      (opt-inline-depth-relay-blocks (+ index 1) count tail))))

(define (opt-inline-depth-leaf-join-block [relays : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "join")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Phi
          3
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ir_types.compiler-ir-label "zero")
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.I64 20)
              (compiler_ir_types.compiler-ir-label "one")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.I64 30)
                (opt-inline-depth-relay-label (- relays 1))
                compiler_ir_types.CompilerIrPhiInputList.Nil)))
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 3)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

(define (opt-inline-depth-relay-block
  [label : String]
  [target : String]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label label)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label target))))
    tail))

;; `entry-instrs` and the relay count are the only things the bounds-carrying
;; and oversize variants change, so all three leaves share one block chain.
(define (opt-inline-depth-leaf-named
  [callee-name : i64]
  [entry-instrs : compiler_ir_types.CompilerIrInstrSeq]
  [relays : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    7
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        entry-instrs)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "zero")
          (opt-inline-depth-leaf-zero-instrs))
        (opt-inline-depth-relay-block
          "one"
          "join"
          (opt-inline-depth-relay-block
            "other"
            "relay0"
            (opt-inline-depth-relay-blocks
              0
              relays
              (opt-inline-depth-leaf-join-block relays))))))))

(define (opt-inline-depth-leaf-switch-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Switch
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (opt-inline-switch-cases
        (compiler_ir_types.compiler-ir-label "zero")
        (compiler_ir_types.compiler-ir-label "one"))
      (compiler_ir_types.compiler-ir-label "other"))))

(define (opt-inline-depth-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-depth-leaf-named
    callee-name
    (opt-inline-depth-leaf-switch-instrs)
    3))

;; The identical leaf plus one bounds check. The weighted entrance was once
;; closed to this class and is now open to it; the leaf pins that the bounds
;; check is not what decides the verdict -- the weight is.
(define (opt-inline-depth-bounds-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-depth-leaf-named
    callee-name
    (opt-test-instrs-with-tail
      (opt-inline-depth-leaf-switch-instrs)
      (opt-inline-switch-loop-bounds-instr
        (compiler_ir_types.compiler-ir-label "switch_bounds_ok")))
    3))

;; The identical leaf past the accessor block ceiling: the weighted entrance
;; relaxes which references count as dominant, never the size bands.
(define (opt-inline-depth-oversize-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-depth-leaf-named
    callee-name
    (opt-inline-depth-leaf-switch-instrs)
    6))

;; entry -> outer_header -> {inner_pre -> inner_header -> {inner_body ->
;; inner_latch -> inner_header, outer_latch -> outer_header}, exit}. The call
;; sits in `inner_body`, two loops deep, so its census weight is 8*8.
(define (opt-inline-depth-nested-caller-blocks [callee-name : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "outer_header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "outer_header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            4
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "outer_latch")
                compiler_ir_types.CompilerIrPhiInputList.Nil))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "inner_pre")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (opt-inline-depth-relay-block
        "inner_pre"
        "inner_header"
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "inner_header")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.compiler-ir-label "inner_body")
                (compiler_ir_types.compiler-ir-label "outer_latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "inner_body")
              (opt-test-instrs
                (opt-inline-loop-site-call callee-name 5)
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "inner_latch"))))
            (opt-inline-depth-relay-block
              "inner_latch"
              "inner_header"
              (opt-inline-depth-relay-block
                "outer_latch"
                "outer_header"
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "exit")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 4)))))
                  compiler_ir_types.CompilerIrBlockList.Nil)))))))))

(define (opt-inline-depth-nested-caller [func-name : i64] [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    6
    (opt-inline-depth-nested-caller-blocks callee-name)))

(define (opt-inline-depth-caller-chain
  [names : compiler_optimize.OptSlotList]
  [callee-name : i64]
  [nested? : bool]
  [tail : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (match names
    [(compiler_optimize.OptSlotList.Nil) tail]
    [(compiler_optimize.OptSlotList.Cons name rest)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (if nested?
          (opt-inline-depth-nested-caller name callee-name)
          (opt-inline-loop-site-function
            name
            callee-name
            (opt-inline-loop-site-entry-instrs)))
        (opt-inline-depth-caller-chain
          (__tl-box-place rest)
          callee-name
          nested?
          tail))]))

(define (opt-inline-depth-optimized
  [callee-name : i64]
  [nested? : bool]
  [leaf : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_optimize.opt-inline-program-functions
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-inline-depth-caller-chain
      (opt-inline-dominant-caller-names-from 0 2)
      callee-name
      nested?
      (compiler_ir_types.compiler-ir-function-seq-prepend
        leaf
        (compiler_ir_types.compiler-ir-function-seq-empty)))
    2))

;; Two nested-loop sites weigh 128 and take the leaf; the identical leaf at two
;; SINGLE-loop sites weighs 16 and keeps both calls. Nothing but the loop depth
;; of the two call sites differs -- same leaf, same reference count, same
;; budgets, both sites inside a loop either way.
(define (compiler-optimize-inline-accessor-depth-weight-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        true
        (opt-inline-depth-leaf callee-name))]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        false
        (opt-inline-depth-leaf callee-name))]
    (and
      (= (opt-inline-dominant-remaining-calls admitted 0 2) 0)
      (= (opt-inline-dominant-remaining-calls refused 0 2) 2))))

;; A body past the accessor block ceiling stays out of line at the same two
;; nested-loop sites: the weighted count changes which references are dominant,
;; never how big an admitted body may be.
(define (compiler-optimize-inline-accessor-depth-oversize-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        true
        (opt-inline-depth-oversize-leaf callee-name))]
    (= (opt-inline-dominant-remaining-calls refused 0 2) 2)))

;; The identical leaf carrying one bounds check is admitted at the same two
;; nested-loop sites, and refused one loop shallower. The weighted entrance used
;; to demand a bounds-free callee, because an imported guard de-fused, its check
;; survived, and the base and length spilled; all three are fixed, and dropping
;; the clause is measured as gvn_table -19,205,435 and cfg_domloops -6,354,925.
;; What still holds the line for this leaf is the floor itself: two sites one
;; loop shallower weigh 16, not 128, and keep both calls.
(define (compiler-optimize-inline-accessor-depth-bounds-admission-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [admitted : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        true
        (opt-inline-depth-bounds-leaf callee-name))]
    [refused : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-depth-optimized
        callee-name
        false
        (opt-inline-depth-bounds-leaf callee-name))]
    (and
      (= (opt-inline-dominant-remaining-calls admitted 0 2) 0)
      (= (opt-inline-dominant-remaining-calls refused 0 2) 2))))

;; Multiple latches targeting one header are alternative backedges of the same
;; loop, not nested loops. The old difference marker added one level per edge,
;; so the header/body below incorrectly received depth 2 and could admit an
;; accessor at nested-loop weight solely because the loop had two `continue`
;; paths.
(define (opt-inline-depth-multi-latch-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "latch-a")
              (compiler_ir_types.compiler-ir-label "latch-b"))))
        (opt-inline-depth-relay-block
          "latch-a"
          "header"
          (opt-inline-depth-relay-block
            "latch-b"
            "header"
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    compiler_ir_types.CompilerIrMaybeValue.No)))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (compiler-optimize-inline-depth-multiple-latches-ok?) : bool
  (begin
    (compiler_optimize.opt-inline-census-depths-build!
      (opt-inline-depth-multi-latch-blocks))
    (and
      (= (compiler_optimize.opt-inline-census-depth-at 0) 0)
      (= (compiler_optimize.opt-inline-census-depth-at 1) 1)
      (= (compiler_optimize.opt-inline-census-depth-at 2) 1)
      (= (compiler_optimize.opt-inline-census-depth-at 3) 1)
      (= (compiler_optimize.opt-inline-census-depth-at 4) 1)
      (= (compiler_optimize.opt-inline-census-depth-at 5) 0))))

;; --- branch-chain classifiers ------------------------------------------------
;;
;; The callee under test is a bounds-free acyclic decision chain: five
;; compare-and-branch blocks over one parameter, each arm jumping to a shared
;; join. It is twelve instructions in twelve blocks, so the duplication band's
;; 32/6 refuses it on block count alone and the cost model prices it at
;; 12 + 6*13 with no absorb credit to spend. Two in-loop callers hold it, the
;; same shape opt-inline-dup-absorb-ok? serves.
(define (opt-inline-chain-hit-label [index : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat "hit" (string.int->string index))))

(define (opt-inline-chain-test-label [index : i64]) : i64
  (if (= index 0)
    (compiler_ir_types.compiler-ir-label "entry")
    (compiler_ir_types.compiler-ir-label
      (str_cat.str-cat "chain" (string.int->string index)))))

;; hit_i and the miss block all reach `join`, so the phi carries one input per
;; arm. Built newest-first from the miss edge inward.
(define (opt-inline-chain-phi-inputs [index : i64] [arms : i64]) : compiler_ir_types.CompilerIrPhiInputList
  (if (< index 0)
    (compiler_ir_types.compiler-ir-phi-input-cons
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.compiler-ir-label "miss")
      compiler_ir_types.CompilerIrPhiInputList.Nil)
    (compiler_ir_types.compiler-ir-phi-input-cons
      (compiler_ir_types.CompilerIrValue.I64 1)
      (opt-inline-chain-hit-label index)
      (opt-inline-chain-phi-inputs (- index 1) arms))))

(define (opt-inline-chain-hit-blocks
  [index : i64]
  [arms : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index arms)
    tail
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (opt-inline-chain-hit-label index)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (opt-inline-chain-hit-blocks (+ index 1) arms tail))))

(define (opt-inline-chain-test-blocks
  [index : i64]
  [arms : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index arms)
    tail
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (opt-inline-chain-test-label index)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (opt-inline-chain-hit-label index)
            (if (= (+ index 1) arms)
              (compiler_ir_types.compiler-ir-label "miss")
              (opt-inline-chain-test-label (+ index 1))))))
      (opt-inline-chain-test-blocks (+ index 1) arms tail))))

;; `padding` is prepended to the miss block: zero for the chain shape, four
;; movs for the merge-web shape, which is the only thing that separates the two
;; fixtures below.
(define (opt-inline-chain-pad-instrs
  [count : i64]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (if (<= count 0)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-chain-pad-instrs (- count 1) tail)
      (compiler_ir_types.CompilerIrInstr.Mov
        (+ 3 count)
        (compiler_ir_types.CompilerIrValue.I64 count)
        (compiler_ast_types.AstType.I64)))))

(define (opt-inline-chain-leaf [callee-name : i64] [arms : i64] [padding : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    callee-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    (+ 4 padding)
    (opt-inline-chain-test-blocks
      0
      arms
      (opt-inline-chain-hit-blocks
        0
        arms
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "miss")
            (opt-inline-chain-pad-instrs
              padding
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join")))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "join")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Phi
                  3
                  (opt-inline-chain-phi-inputs (- arms 1) arms)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 3)))))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-inline-chain-remaining-calls
  [functions : compiler_ir_types.CompilerIrFunctionSeq]) : i64
  (+
    (opt-count-direct-call-name-function-seq functions "main" "inline_switch")
    (opt-count-direct-call-name-function-seq
      functions
      "inline_nonleaf"
      "inline_switch")))

;; Twelve instructions in twelve blocks, no block above one instruction: the
;; block cap is the only thing refusing it, and the chain gate is what admits
;; it at both in-loop sites.
(define (compiler-optimize-inline-branch-chain-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-chain-leaf callee-name 5 0))]
    (= (opt-inline-chain-remaining-calls optimized) 0)))

;; The same block count and the same in-loop sites, with four movs moved into
;; one block. Sixteen instructions is still far inside every band; the body is
;; no longer a chain, so it stays refused at both sites -- the block cap's
;; original job, kept.
(define (compiler-optimize-inline-branch-chain-merge-web-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-two-caller-names symbols)
        callee-name
        (opt-inline-chain-leaf callee-name 5 4))]
    (= (opt-inline-chain-remaining-calls optimized) 2)))

;; --- hot loop leaves ---------------------------------------------------------
;;
;; The callee under test is the cyclic bounds-carrying Switch leaf again, at
;; three references and up, which is where this band's admission used to start.
;; Every fixture below varies exactly one clause of
;; opt-inline-hot-loop-leaf-ok?; the single-reference fixtures at the end of the
;; family cover the class the reference clause opened.
;; Three in-loop callers of the call-free leaf: every site takes a copy, and
;; the leaf stays in the program only while sites remain (here: none do).
(define (compiler-optimize-inline-hot-loop-leaf-three-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-plain callee-name))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        0))))

;; The identical leaf with one call in its body stays out of line at all three
;; sites: this band copies the biggest bodies of any into loop sites, and a
;; callee's own calls are exactly the cost its instruction and block counts
;; cannot carry.
(define (compiler-optimize-inline-hot-loop-leaf-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-dup-leaf-calling callee-name symbols.external-helper))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; A pad chain for the too-big leaf: var 4 anchors it, each BinOp feeds the
;; next, and the chain ends in the case block's jump.
(define (opt-inline-hot-loop-big-leaf-pad-from
  [var : i64]
  [remaining : i64]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (if (<= remaining 0)
    tail
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from (+ var 1) (- remaining 1) tail)
      (compiler_ir_types.CompilerIrInstr.BinOp
        var
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var (- var 1))
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64)))))

;; The same leaf shape at 135 body instructions -- one past
;; opt-inline-hot-loop-leaf-max-body's measured band -- still call-free, still
;; cyclic, still at three in-loop sites.
(define (opt-inline-hot-loop-big-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    (+ 6 128)
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from
        5
        128
        (opt-inline-dup-leaf-jump-zero-instrs))
      (compiler_ir_types.CompilerIrInstr.Mov
        4
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64)))))

(define (compiler-optimize-inline-hot-loop-leaf-too-big-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-big-leaf callee-name))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; A big-tier leaf: 41 body instructions -- above the legacy 32/6 band, inside
;; the hot-loop-leaf band -- still call-free and cyclic.
(define (opt-inline-hot-loop-mid-leaf [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    (+ 6 34)
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from
        5
        34
        (opt-inline-dup-leaf-jump-zero-instrs))
      (compiler_ir_types.CompilerIrInstr.Mov
        4
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64)))))

;; Three small in-loop callers of the big-tier leaf: a caller small enough
;; that the imported loop effectively replaces its body takes the copy at an
;; in-loop site (the gvn-facts-grow shape).
(define (compiler-optimize-inline-hot-loop-leaf-in-loop-small-caller-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-dup-three-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-mid-leaf callee-name))]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        0)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        0))))

;; A jump-block pad chain for the big caller: entry -> pad0 -> ... -> header.
(define (opt-inline-hot-loop-pad-label [index : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat "pad" (string.int->string index))))

(define (opt-inline-hot-loop-pad-blocks-from
  [index : i64]
  [count : i64]
  [tail : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index count)
    tail
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (opt-inline-hot-loop-pad-label index)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (if (< (+ index 1) count)
              (opt-inline-hot-loop-pad-label (+ index 1))
              (compiler_ir_types.compiler-ir-label "header")))))
      (opt-inline-hot-loop-pad-blocks-from (+ index 1) count tail))))

;; The in-loop caller shape, grown past opt-inline-hot-loop-leaf-max-caller-blocks
;; by twelve jump blocks between entry and header: the call is still in the
;; loop, but the caller's own working set dwarfs the import.
(define (opt-inline-hot-loop-big-caller-function
  [func-name : i64]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    6
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (opt-inline-hot-loop-pad-label 0))))
      (opt-inline-hot-loop-pad-blocks-from
        0
        12
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "header")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 3)
                  (opt-inline-hot-loop-pad-label 11)
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    (compiler_ir_types.compiler-ir-label "latch")
                    compiler_ir_types.CompilerIrPhiInputList.Nil))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "body")
              (opt-test-instrs
                (opt-inline-loop-site-call callee-name 5)
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "latch"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "latch")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "header"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "exit")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 4)))))
                compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-inline-hot-loop-big-caller-chain
  [names : compiler_optimize.OptSlotList]
  [callee-name : i64]
  [tail : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (match names
    [(compiler_optimize.OptSlotList.Nil) tail]
    [(compiler_optimize.OptSlotList.Cons name rest)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-hot-loop-big-caller-function name callee-name)
        (opt-inline-hot-loop-big-caller-chain
          (__tl-box-place rest)
          callee-name
          tail))]))

;; The same big-tier leaf at the same in-loop sites inside 17-block callers:
;; above the caller-size cap the import would tax the caller loop's
;; allocation (the pl-run-chunk shape), so every site keeps its call.
(define (compiler-optimize-inline-hot-loop-leaf-in-loop-big-caller-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-hot-loop-big-caller-chain
          (opt-inline-dup-three-caller-names symbols)
          callee-name
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-hot-loop-mid-leaf callee-name)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; Three STRAIGHT-LINE callers with no loop of their own: the imported loop
;; becomes each caller's only one, so no caller loop's allocation is there to
;; lengthen, and every site takes a copy.
(define (compiler-optimize-inline-hot-loop-leaf-loop-free-site-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-shared-accessor-optimized
        symbols
        3
        false
        (opt-inline-dup-leaf-plain callee-name))]
    (= (opt-inline-shared-remaining-calls optimized 3) 0)))

;; A caller that loops, but whose call sits in the loop's EXIT block: no site
;; tier fires -- the site is not in the loop, the caller is not loop-free, and
;; the in-loop tier never sees the exit block -- so the import keeps its
;; boundary at all three callers.
(define (opt-inline-hot-loop-cold-site-caller
  [func-name : i64]
  [callee-name : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    func-name
    (opt-inline-switch-params)
    (compiler_ast_types.AstType.I64)
    7
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-inline-loop-site-entry-instrs))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "header")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              4
              (compiler_ir_types.compiler-ir-phi-input-cons
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 5)
                  (compiler_ir_types.compiler-ir-label "latch")
                  compiler_ir_types.CompilerIrPhiInputList.Nil))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "body")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Mov
                5
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "latch")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (opt-inline-loop-site-call callee-name 6)
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 6)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-inline-hot-loop-cold-site-chain
  [names : compiler_optimize.OptSlotList]
  [callee-name : i64]
  [tail : compiler_ir_types.CompilerIrFunctionSeq]) : compiler_ir_types.CompilerIrFunctionSeq
  (match names
    [(compiler_optimize.OptSlotList.Nil) tail]
    [(compiler_optimize.OptSlotList.Cons name rest)
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-inline-hot-loop-cold-site-caller name callee-name)
        (opt-inline-hot-loop-cold-site-chain
          (__tl-box-place rest)
          callee-name
          tail))]))

(define (compiler-optimize-inline-hot-loop-leaf-cold-site-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-inline-hot-loop-cold-site-chain
          (opt-inline-dup-three-caller-names symbols)
          callee-name
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-dup-leaf-plain callee-name)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (and
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "main"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_nonleaf"
          "inline_switch")
        1)
      (=
        (opt-count-direct-call-name-function-seq
          optimized
          "inline_loop"
          "inline_switch")
        1))))

;; Six straight-line call blocks in one loop-free caller, one call per block.
;; Each copy of the five-block leaf costs the caller six blocks of block fuel,
;; so five copies fit the per-caller budget and the sixth keeps its call.
(define (opt-inline-hot-loop-budget-label [index : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat "budget" (string.int->string index))))

(define (opt-inline-hot-loop-budget-blocks-from
  [callee-name : i64]
  [index : i64]
  [sites : i64]) : compiler_ir_types.CompilerIrBlockList
  (if (>= index sites)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "budget_exit")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (opt-inline-hot-loop-budget-label index)
        (opt-test-instrs
          (opt-inline-loop-site-call callee-name (+ 3 index))
          (compiler_ir_types.CompilerIrInstr.Jump
            (if (< (+ index 1) sites)
              (opt-inline-hot-loop-budget-label (+ index 1))
              (compiler_ir_types.compiler-ir-label "budget_exit")))))
      (opt-inline-hot-loop-budget-blocks-from callee-name (+ index 1) sites))))

(define (compiler-optimize-inline-hot-loop-leaf-budget-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (compiler_optimize.opt-inline-program-functions
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (compiler_ir_types.CompilerIrFunction.Function
            symbols.main
            (opt-inline-switch-params)
            (compiler_ast_types.AstType.I64)
            9
            (opt-inline-hot-loop-budget-blocks-from callee-name 0 6))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-inline-dup-leaf-plain callee-name)
            (compiler_ir_types.compiler-ir-function-seq-empty)))
        2)]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      1)))

;; --- the single-reference sites the band now takes ---------------------------
;;
;; The reference clause used to read `> opt-inline-dup-max-refcount`, so this
;; band began at three references; it now begins at one. The clause's own
;; comment carries the history and both measurements; what these fixtures pin is
;; that the widening opened exactly one thing -- the reference class -- and left
;; every other clause of the band binding.
;;
;; ONE in-loop caller of the big-tier leaf. Nothing else can take it: absorption
;; is refused because the site is in a loop (and the leaf is under the arity
;; floor), the legacy bounds-loop absorb band is refused because 41 instructions
;; is past its 32, and the cost model's absorb bonus cannot help because the
;; bounds-loop gate is what stands in the way. Before the widening the reference
;; clause refused it too and the call survived; now this band is what takes it.
(define (opt-inline-hot-loop-one-caller-names
  [symbols : OptInlineMultiTestSymbols]) : compiler_optimize.OptSlotList
  (compiler_optimize.OptSlotList.Cons
    symbols.main
    (box (compiler_optimize.OptSlotList.Nil))))

(define (compiler-optimize-inline-hot-loop-leaf-single-reference-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-hot-loop-one-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-mid-leaf callee-name))]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      0)))

;; The SIZE clause at the newly opened reference class: the same single in-loop
;; site, the leaf one instruction past opt-inline-hot-loop-leaf-max-body. The
;; band's size ceiling is not a function of the reference count, so the call
;; stays.
(define (compiler-optimize-inline-hot-loop-leaf-single-reference-too-big-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-hot-loop-one-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-big-leaf callee-name))]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      1)))

;; The big-tier leaf with one call in its body: past the legacy absorb band on
;; size, inside this band on size, and refused by the CALL-FREE clause. The pad
;; chain ends in the call so the anchor mov keeps var 4 to itself.
(define (opt-inline-hot-loop-mid-leaf-call-instrs [helper-name : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 1)]
    (begin
      (set! (array-ref args 0) (compiler_ir_types.CompilerIrValue.Var 0))
      (opt-test-instrs-with-tail
        (opt-inline-dup-leaf-jump-zero-instrs)
        (compiler_ir_types.CompilerIrInstr.Call
          39
          helper-name
          (compiler_ir_types.CompilerIrCallArgs.Array args)
          (compiler_ast_types.AstType.I64))))))

(define (opt-inline-hot-loop-mid-leaf-calling
  [callee-name : i64]
  [helper-name : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-inline-dup-leaf-named
    callee-name
    (+ 6 35)
    (opt-test-instrs-with-tail
      (opt-inline-hot-loop-big-leaf-pad-from
        5
        34
        (opt-inline-hot-loop-mid-leaf-call-instrs helper-name))
      (compiler_ir_types.CompilerIrInstr.Mov
        4
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64)))))

(define (compiler-optimize-inline-hot-loop-leaf-single-reference-call-bearing-refusal-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 symbols.inline-switch]
    [optimized : compiler_ir_types.CompilerIrFunctionSeq
      (opt-inline-dup-optimized
        (opt-inline-hot-loop-one-caller-names symbols)
        callee-name
        (opt-inline-hot-loop-mid-leaf-calling
          callee-name
          symbols.external-helper))]
    (=
      (opt-count-direct-call-name-function-seq optimized "main" "inline_switch")
      1)))

(define (opt-inline-phi-span-ok-instr-seq-from?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pos : i64]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [caller-name : i64]
  [line : i64]
  [col : i64]) : bool
  (if (>= pos (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs pos)]
      (or
        (match instr
          [(compiler_ir_types.CompilerIrInstr.Phi _ _ _)
            (opt-span-lookup-ok? spans caller-name instr line col)]
          [_ false])
        (opt-inline-phi-span-ok-instr-seq-from?
          instrs
          (+ pos 1)
          spans
          caller-name
          line
          col)))))

(define (opt-inline-phi-span-ok-blocks?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [caller-name : i64]
  [line : i64]
  [col : i64]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (or
            (opt-inline-phi-span-ok-instr-seq-from?
              instrs
              0
              spans
              caller-name
              line
              col)
            (opt-inline-phi-span-ok-blocks?
              (__tl-box-place rest)
              spans
              caller-name
              line
              col))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-inline-phi-span-ok-blocks?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        spans
        caller-name
        line
        col)]))

;; The span cases run at a chosen optimizer LEVEL. The negative direction used
;; to be supplied by a callee name the opt2 gate refused (`qs-partition`, when
;; the acyclic gate's only escape was the `vm-run` name match); the hot-loop-leaf
;; band admits that shape on its own terms now, so the refusing case is selected
;; by level instead -- below opt2 the multiblock inliner does not run, the call
;; survives, and its caller-side span must still be intact.
(define (opt-inline-switch-span-case-code
  [callee-text : String]
  [expect-inline? : bool]
  [level : i64]) : i64
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [callee-name : i64 (opt-test-symbol callee-text)]
    [caller-name : i64 symbols.main]
    [callee-phi : compiler_ir_types.CompilerIrInstr
      (opt-inline-switch-loop-phi-instr)]
    [caller-call : compiler_ir_types.CompilerIrInstr
      (opt-inline-switch-caller-call-named callee-name)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr
        (compiler_ir_types.compiler-source-spans-insert-instr
          (opt-spans-base)
          callee-name
          callee-phi
          (opt-test-span 171 33))
        caller-name
        caller-call
        (opt-test-span 181 35))]
    [previous-debug : bool (compiler_ir_types.compiler-debug-info-enabled?)]
    [code : i64
      (begin
        (compiler_ir_types.compiler-debug-info-set-enabled! true)
        (match (compiler_optimize.opt-inline-program-functions-with-spans
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-inline-switch-functions-named symbols callee-name)
          level
          spans)
          [(compiler_optimize.OptInlineSpanProgram.Program
              optimized
              optimized-spans)
            (match (compiler_optimize.opt-function-seq-find optimized "main")
              [(compiler_optimize.OptMaybeFunction.Some main)
                (let
                  [blocks : compiler_ir_types.CompilerIrBlockList
                    (compiler_optimize.opt-function-blocks main)]
                  (+
                    (if (=
                      (opt-count-direct-call-name-blocks blocks callee-text)
                      (if expect-inline?
                        0
                        1))
                      1
                      0)
                    (+
                      (if (=
                        (compiler_optimize.opt-count-bounds-blocks blocks)
                        (if expect-inline?
                          1
                          0))
                        2
                        0)
                      (+
                        (if (if expect-inline?
                          (opt-inline-phi-span-ok-blocks?
                            blocks
                            optimized-spans
                            caller-name
                            171
                            33)
                          (opt-span-lookup-ok?
                            optimized-spans
                            caller-name
                            caller-call
                            181
                            35))
                          4
                          0)
                        (if (compiler_optimize.opt-inline-structure-ok? blocks)
                          8
                          0)))))]
              [(compiler_optimize.OptMaybeFunction.No) 0])]))]
    (begin
      (compiler_ir_types.compiler-debug-info-set-enabled! previous-debug)
      code)))

(define (opt-inline-costly-switch-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "tag"
      (compiler_ast_types.AstType.I64)
      0)
    compiler_ir_types.CompilerIrParamList.Nil))

;; Five body instructions plus six added blocks leave this non-absorbable i64
;; callee above the weighted threshold even with a constant argument at each
;; of its two sites. Switch admission must not bypass that cost decision.
(define (opt-inline-costly-switch-callee [symbols : OptInlineMultiTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-switch-costly
    (opt-inline-costly-switch-params)
    (compiler_ast_types.AstType.I64)
    2
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Switch
            (compiler_ir_types.CompilerIrValue.Var 0)
            0
            (opt-inline-switch-cases
              (compiler_ir_types.compiler-ir-label "zero")
              (compiler_ir_types.compiler-ir-label "one"))
            (compiler_ir_types.compiler-ir-label "other"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "zero")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "one")
            (opt-test-instrs
