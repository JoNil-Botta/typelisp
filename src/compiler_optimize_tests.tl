        61]
      [else 42])))

(define (compiler-optimize-loop-rotation-self-test) : i64
  (let
    [raw : ir.CompilerIrBlockList (opt-loop-rotation-top-test-blocks false)]
    [rotated : ir.CompilerIrBlockList
      (opt.opt-loop-rotation-blocks
        (ast.ast-node-pool-reader-context-current)
        (opt.compiler-opt-global-shared-view raw))]
    [constant-edge-rotated : ir.CompilerIrBlockList
      (match (opt.opt-loop-rotation-normalized-function-result
        (ast.ast-node-pool-reader-context-current)
        (opt-cfg-test-function (opt-loop-rotation-top-test-blocks true)))
        [(opt.OptBlockCtxResult.Result blocks _ _) blocks])]
    [false-body-rotated : ir.CompilerIrBlockList
      (opt.opt-loop-rotation-blocks
        (ast.ast-node-pool-reader-context-current)
        (opt-loop-rotation-false-body-blocks))]
    [ssa : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-cfg-test-function (opt.compiler-opt-global-shared-view rotated)))]
    [ssa-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view ssa))]
    [optimized : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-cfg-test-function raw))]
    [optimized-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks optimized)]
    [no-preheader : ir.CompilerIrBlockList
      (opt-natural-loop-no-preheader-blocks)]
    [multi-backedge : ir.CompilerIrBlockList
      (opt-natural-loop-multi-backedge-blocks)]
    [with-phi : ir.CompilerIrBlockList (opt-ssa-loop-blocks)]
    (cond
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view rotated))
            3))
        1]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view rotated)
          (ir.compiler-ir-label "loop"))
        2]
      [(not
          (opt-loop-rotation-successors?
            (opt.compiler-opt-global-shared-view rotated)
            (ir.compiler-ir-label "entry")
            (ir.compiler-ir-label "body")
            (ir.compiler-ir-label "exit")))
        3]
      [(not
          (opt-loop-rotation-successors?
            (opt.compiler-opt-global-shared-view rotated)
            (ir.compiler-ir-label "body")
            (ir.compiler-ir-label "body")
            (ir.compiler-ir-label "exit")))
        4]
      [(not
          (=
            (opt-count-jump-to-blocks
              (opt.compiler-opt-global-shared-view rotated)
              (ir.compiler-ir-label "loop"))
            0))
        5]
      [(not (= (opt-count-branches-blocks rotated) 2)) 6]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view false-body-rotated)
          (ir.compiler-ir-label "loop"))
        7]
      [(not
          (opt-loop-rotation-successors?
            false-body-rotated
            (ir.compiler-ir-label "entry")
            (ir.compiler-ir-label "body")
            (ir.compiler-ir-label "exit")))
        8]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function ssa))) 9]
      [(not (> (opt-count-phi-blocks ssa-blocks) 0)) 10]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view optimized-blocks)
          (ir.compiler-ir-label "loop"))
        11]
      [(not (opt.opt-cfg-successor-targets-known? optimized-blocks)) 12]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-loop-rotation-blocks
              (ast.ast-node-pool-reader-context-current)
              (opt.compiler-opt-global-shared-view no-preheader))
            no-preheader))
        13]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-loop-rotation-blocks
              (ast.ast-node-pool-reader-context-current)
              (opt.compiler-opt-global-shared-view multi-backedge))
            multi-backedge))
        14]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-loop-rotation-blocks
              (ast.ast-node-pool-reader-context-current)
              (opt.compiler-opt-global-shared-view with-phi))
            with-phi))
        15]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (opt.compiler-opt-global-shared-view constant-edge-rotated))
            3))
        16]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view constant-edge-rotated)
          (ir.compiler-ir-label "loop"))
        17]
      [(not
          (opt-loop-rotation-successors?
            constant-edge-rotated
            (ir.compiler-ir-label "entry")
            (ir.compiler-ir-label "body")
            (ir.compiler-ir-label "exit")))
        18]
      [else 42])))

;; Nested-loop SSA fixture: the inner-loop counter/accumulator phis at the
;; OUTER header have no definition on the function-entry path. Before the
;; dead-path zero-input fix in opt-ssa-phi-inputs, materialization named the
;; ORIGINAL var on those inputs, the use-before-definition verify rejected the
;; result, and SSA construction silently fell back -- disabling every SSA-gated
;; pass (GVN, load-GVN, preheaders, LICM, induction, loop-BCE) for any function
;; containing a nested loop. The fixture mirrors a lowered nested array-sum:
;; handle-field geps/loads in the inner body must hoist once SSA succeeds.
(define (opt-ssa-nested-loop-params) : ir.CompilerIrParamSeq
  (irt.params "rounds=%0:i64, n=%1:i64, arr=%2:(__tl_dyn-array i64)"))

(define (opt-ssa-nested-loop-inner-body) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%10 = gep %2, 1 : i64
     %11 = load %10 : i64
     %12 = gep %2, 0 : u8
     %13 = load %12 : u64
     %14 = gep %13, %5 : i64
     %15 = load %14 : i64
     %16 = add %3, %15 : i64
     %19 = add %16, %11 : i64
     %3 = mov %19 : i64
     %17 = add %5, 1 : i64
     %5 = mov %17 : i64
     jump inner_head"))

(define (opt-ssa-nested-loop-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "ssa_nested_loop")
    (opt-ssa-nested-loop-params)
    (ast.AstType.I64)
    32
    (ir.compiler-ir-block-cons
      (irt.block
        "entry:
           %3 = mov 0 : i64
           %4 = mov 0 : i64
           jump outer_head")
      (ir.compiler-ir-block-cons
        (irt.block
          "outer_head:
             %6 = lt %4, %0 : bool
             branch %6, outer_body, exit")
        (ir.compiler-ir-block-cons
          (irt.block
            "outer_body:
               %5 = mov 0 : i64
               jump inner_head")
          (ir.compiler-ir-block-cons
            (irt.block
              "inner_head:
                 %7 = lt %5, %1 : bool
                 branch %7, inner_body, outer_latch")
            (ir.compiler-ir-block-cons
              (ir.CompilerIrBlock.Block
                (ir.compiler-ir-label "inner_body")
                (opt-ssa-nested-loop-inner-body))
              (irt.blocks
                "outer_latch:
                   %18 = add %4, 1 : i64
                   %4 = mov %18 : i64
                   jump outer_head
                 exit:
                   return %3"))))))
    ir.CompilerIrFunctionAbi.Ordinary))

;; Fixture for the post-SSA rotation pass: `entry` is the single-successor
;; preheader, `header` carries one loop phi plus a pure guard and the loop
;; branch, `body` increments the phi, `latch` jumps back unconditionally, and
;; `exit` returns the phi (exercising the exit-phi path). With `side-exit`
;; the body branches straight to `exit`, which must reject the rotation.
(define (opt-rotate-ssa-test-blocks [side-exit : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block "entry:
         jump header")
    (ir.compiler-ir-block-cons
      (irt.block
        "header:
           %1 = phi [0, entry], [%2, latch] : i64
           %3 = lt %1, %0 : bool
           branch %3, body, exit")
      (ir.compiler-ir-block-cons
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "body")
          (opt-test-instrs-with-tail
            (if side-exit
              (irt.instrs "branch true, latch, exit")
              (irt.instrs "jump latch"))
            (irt.instr "%2 = add %1, 1 : i64")))
        (irt.blocks
          "latch:
             jump header
           exit:
             return %1")))))

(define (opt-rotate-ssa-test-function [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "rotate_ssa")
    (irt.params "n=%0:i64")
    (ast.AstType.I64)
    4
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-rotate-ssa-test-run [side-exit : bool]) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList (opt-rotate-ssa-test-blocks side-exit)]
    (match (opt.opt-rotate-ssa-function-with-context-result
      (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
      false
      (opt-rotate-ssa-test-function blocks))
      [(opt.OptFunctionCtxResult.Result next _) next])))

(define (opt-rotate-ssa-test-starts-with-phi?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (<= (ir.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ _ _) true]
              [_ false]))])]))

(define (opt-rotate-ssa-test-single-jump-to?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]
  [target : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (= (ir.compiler-ir-instr-seq-count instrs) 1)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Jump jump-target) (= jump-target target)]
              [_ false])
            false)])]))

;; Two sibling counted loops, both rotatable. One rotation per invocation used
;; to mean the second one waited for the next PIPELINE iteration -- and the cap
;; is two, so a third loop never got one at all, while `bce_version` locked
;; whichever loops lost the race into their top-tested form. The rounds inside
;; the pass settle every loop before anything downstream reads the function.
(define (opt-rotate-ssa-test-counted-loop
  [header : String]
  [land : String]
  [body : String]
  [latch : String]
  [exit-label : String]
  [phi : i64]
  [step : i64]
  [cond-var : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label (opt.compiler-opt-global-shared-view header))
      (opt-test-instrs
        (ir.CompilerIrInstr.Phi
          phi
          (ir.compiler-ir-phi-input-seq-prepend
            (ir.CompilerIrValue.I64 0)
            (ir.compiler-ir-label land)
            (ir.compiler-ir-phi-input-seq-prepend
              (ir.CompilerIrValue.Var step)
              (ir.compiler-ir-label (opt.compiler-opt-global-shared-view latch))
              (ir.compiler-ir-phi-input-seq-empty)))
          (ast.AstType.I64))
        (ir.CompilerIrInstr.BinOp
          cond-var
          (ir.CompilerIrBinOp.Lt)
          (ir.CompilerIrValue.Var phi)
          (ir.CompilerIrValue.Var 0)
          (ast.AstType.Bool))
        (ir.CompilerIrInstr.Branch
          (ir.CompilerIrValue.Var cond-var)
          (ir.compiler-ir-label (opt.compiler-opt-global-shared-view body))
          (ir.compiler-ir-label exit-label))))
    (ir.compiler-ir-block-cons
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label body)
        (opt-test-instrs
          (ir.CompilerIrInstr.BinOp
            step
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var phi)
            (ir.CompilerIrValue.I64 1)
            (ast.AstType.I64))
          (ir.CompilerIrInstr.Jump
            (ir.compiler-ir-label (opt.compiler-opt-global-shared-view latch)))))
      (ir.compiler-ir-block-cons
        (opt-dead-phi-test-jump-block latch header)
        tail))))

(define (opt-rotate-ssa-test-siblings) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump h1
     h1:
       %1 = phi [0, entry], [%2, l1] : i64
       %3 = lt %1, %0 : bool
       branch %3, b1, mid
     b1:
       %2 = add %1, 1 : i64
       jump l1
     l1:
       jump h1
     mid:
       jump h2
     h2:
       %4 = phi [0, mid], [%5, l2] : i64
       %6 = lt %4, %0 : bool
       branch %6, b2, exit
     b2:
       %5 = add %4, 1 : i64
       jump l2
     l2:
       jump h2
     exit:
       return %4"))

(define (opt-rotate-ssa-test-siblings-run) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList (opt-rotate-ssa-test-siblings)]
    (match (opt.opt-rotate-ssa-function-with-context-result
      (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
      false
      (ir.CompilerIrFunction.Function
        (opt-test-symbol "rotate_ssa_siblings")
        (irt.params "n=%0:i64")
        (ast.AstType.I64)
        7
        blocks
        ir.CompilerIrFunctionAbi.Ordinary))
      [(opt.OptFunctionCtxResult.Result next _) next])))

;; The `it-slice-eq?` class, in the shape `flag_exit` leaves behind: a
;; single-test header, and a body that can leave the loop through its OWN exit
;; block -- never through the header's exit arm, which is the break shape
;; `opt-rotate-ssa-body-avoids-exit?` still refuses. Both exits meet again in
;; `done`.
;;
;; With `live-out` the counter is also read past the loop, on BOTH exit edges.
;; The classified placement serves each edge from the block that dominates it:
;; the `exit` edge takes the fresh exit phi, and the `escape` edge keeps the
;; counter itself, because after rotation the BODY block holds the moved phi
;; and dominates the body's own exit. Both variants therefore rotate; the
;; blanket single-exit refusal this used to hit is gone.
(define (opt-rotate-ssa-test-second-exit-blocks [live-out : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (opt-flag-exit-test-jump-block "entry" "header")
    (ir.compiler-ir-block-cons
      (irt.block
        "header:
           %1 = phi [0, entry], [%2, latch] : i64
           %3 = lt %1, %0 : bool
           branch %3, body, exit")
      (ir.compiler-ir-block-cons
        (irt.block
          "body:
             %4 = lt %1, 7 : bool
             branch %4, cont, escape")
        (ir.compiler-ir-block-cons
          (irt.block
            "cont:
               %2 = add %1, 1 : i64
               jump latch")
          (ir.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "latch" "header")
            (ir.compiler-ir-block-cons
              (opt-flag-exit-test-jump-block "escape" "done")
              (ir.compiler-ir-block-cons
                (opt-flag-exit-test-jump-block "exit" "done")
                (ir.compiler-ir-block-cons
                  (ir.CompilerIrBlock.Block
                    (ir.compiler-ir-label "done")
                    (if live-out
                      (irt.instrs
                        "%5 = phi [%1, exit], [%1, escape] : i64
                         return %5")
                      (irt.instrs "return 0")))
                  (ir.CompilerIrBlockList.Nil))))))))))

(define (opt-rotate-ssa-test-second-exit-function
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "rotate_ssa_second_exit")
    (irt.params "n=%0:i64")
    (ast.AstType.I64)
    6
    blocks
    ir.CompilerIrFunctionAbi.Ordinary))

(define (opt-rotate-ssa-test-second-exit-run [live-out : bool]) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList
      (opt-rotate-ssa-test-second-exit-blocks live-out)]
    (match (opt.opt-rotate-ssa-function-with-context-result
      (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
      false
      (opt-rotate-ssa-test-second-exit-function blocks))
      [(opt.OptFunctionCtxResult.Result next _) next])))

;; A rotated loop tests its own exit condition on the back edge, so its latch
;; ends in a Branch; a top-tested one jumps back unconditionally.
(define (opt-rotate-ssa-test-ends-with-branch?
  [blocks : ir.CompilerIrBlockList]
  [label : i64]) : bool
  (match (opt.opt-cfg-find-block blocks label)
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
            (if (<= count 0)
              false
              (match (ir.compiler-ir-instr-seq-ref instrs (- count 1))
                [(ir.CompilerIrInstr.Branch _ _ _) true]
                [_ false])))])]))

(define (opt-rotate-ssa-test-latches-branch?
  [blocks : ir.CompilerIrBlockList]
  [loops : opt.OptNaturalLoopList]) : bool
  (match loops
    [(opt.OptNaturalLoopList.Nil) true]
    [(opt.OptNaturalLoopList.Cons loop rest)
      (and
        (opt-rotate-ssa-test-ends-with-branch?
          (ir.compiler-ir-global-shared-view blocks)
          (opt.opt-natural-loop-latch loop))
        (opt-rotate-ssa-test-latches-branch? blocks (deref rest)))]))

;; `it-slice-eq?` as SSA construction hands it to the loop passes: the counter
;; and the monotone flag ride the header together, the gate re-tests the flag,
;; the mismatch arm clears it, and the flag is read past the loop on BOTH exit
;; edges. That last reader is what refuses the rotation up top -- the exit phi
;; would have to reach `escape`, which the header's exit block does not
;; dominate. `flag_exit` retires exactly that reader (it folds both edges to
;; literals) and leaves the loop rotatable, but it runs six passes BELOW the
;; rotation stage and needs a pipeline iteration of its own to fire, so the
;; rotatable shape only exists after the last upstream chance to rotate it.
(define (opt-rotate-ssa-test-flag-loop-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump header
     header:
       %1 = phi [0, entry], [%2, latch] : i64
       %3 = phi [true, entry], [%4, latch] : bool
       %5 = lt %1, %0 : bool
       branch %5, gate, exit
     gate:
       branch %3, cont, escape
     cont:
       %6 = lt %1, 7 : bool
       branch %6, match, mismatch
     match:
       jump latch
     mismatch:
       jump latch
     latch:
       %4 = phi [false, mismatch], [%3, match] : bool
       %2 = add %1, 1 : i64
       jump header
     escape:
       jump done
     exit:
       jump done
     done:
       %7 = phi [%3, exit], [%3, escape] : bool
       return %7"))

(define (opt-rotate-ssa-test-flag-loop-function) : ir.CompilerIrFunction
  (ir.CompilerIrFunction.Function
    (opt-test-symbol "rotate_ssa_flag_loop")
    (irt.params "n=%0:i64")
    (ast.AstType.Bool)
    10
    (opt-rotate-ssa-test-flag-loop-blocks)
    ir.CompilerIrFunctionAbi.Ordinary))

;; One rotation pass over the flag loop, with nothing below it in the pipeline.
;; This has to leave the loop ALONE: the flag is flag_exit's monotone seed with
;; flag_exit's own gate (a branch on the flag itself, leaving the loop), and
;; that pass -- six slots below -- converts the shape into a direct exit and
;; deletes the second exit outright, leaving a single-exit loop the rotation
;; then takes in the ordinary way with the flag test gone from the trip.
;; Rotating first moves the flag phi out of the header, C1 stops matching, and
;; the conversion never fires again: measured at +35,506,866 Ir on
;; benchmarks/intern_table.
(define (opt-rotate-ssa-test-flag-loop-run) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList (opt-rotate-ssa-test-flag-loop-blocks)]
    (match (opt.opt-rotate-ssa-function-with-context-result
      (opt.opt-cfg-context-build blocks)
      false
      (opt-rotate-ssa-test-flag-loop-function))
      [(opt.OptFunctionCtxResult.Result next _) next])))

;; End to end: whatever order the loop passes settle in, no loop of this class
;; may reach the backend jumping back unconditionally to a header that re-tests
;; its own counter. Note this fixture is clean enough that `flag_exit` converts
;; it on pipeline iteration 1, so the rotation stage ABOVE it can still win the
;; race here -- the assertion is the invariant, not the round that establishes
;; it. What forced the second round is the extra iteration a genuinely lowered
;; `while` spends before the conversion fires; `benchmarks/intern_table`'s
;; `it-slice-eq?` is the measured case and stayed top-tested without it.
(define (opt-rotate-ssa-test-pipeline-bottom-tested?) : bool
  (let
    [optimized : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-rotate-ssa-test-flag-loop-function))]
    [blocks : ir.CompilerIrBlockList (opt.opt-function-blocks optimized)]
    [loops : opt.OptNaturalLoopList
      (opt.opt-cfg-natural-loops (opt.compiler-opt-global-shared-view blocks))]
    (and
      (>
        (opt.opt-natural-loop-list-count
          (opt.compiler-opt-global-shared-view loops))
        0)
      (opt-rotate-ssa-test-latches-branch? blocks loops))))

;; The exit phi has to carry the zero-trip value on the preheader edge and the
;; last iteration's value on the latch edge -- the whole point of minting it.
(define (opt-rotate-ssa-test-exit-phi-inputs-ok?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label "exit"))
    [(opt.OptMaybeBlock.No) false]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (<= (ir.compiler-ir-instr-seq-count instrs) 0)
            false
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ inputs _)
                (and
                  (=
                    (opt-rotate-ssa-test-phi-input-value
                      (opt.compiler-opt-global-shared-view inputs)
                      "entry")
                    0)
                  (= (opt-rotate-ssa-test-phi-input-value inputs "latch") 2))]
              [_ false]))])]))

;; The value a named block's leading phi carries on a named edge, using the
;; same encoding as `opt-rotate-ssa-test-phi-input-value`. This is what pins
;; LCSSA placement: one join phi, two edges, two different sources.
(define (opt-rotate-ssa-test-block-phi-input-value
  [blocks : ir.CompilerIrBlockList]
  [label : String]
  [edge : String]) : i64
  (match (opt.opt-cfg-find-block blocks (ir.compiler-ir-label label))
    [(opt.OptMaybeBlock.No) (- 0 2)]
    [(opt.OptMaybeBlock.Some block)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (<= (ir.compiler-ir-instr-seq-count instrs) 0)
            (- 0 2)
            (match (ir.compiler-ir-instr-seq-ref instrs 0)
              [(ir.CompilerIrInstr.Phi _ inputs _)
                (opt-rotate-ssa-test-phi-input-value inputs edge)]
              [_ (- 0 2)]))])]))

;; 0 for the literal `0` the preheader edge carries, the var id for a Var input,
;; -1 when the edge is missing or carries anything else.
(define (opt-rotate-ssa-test-phi-input-value
  [inputs : ir.CompilerIrPhiInputSeq]
  [label : String]) : i64
  (let
    [phi-inputs-at-57835-3 : ir.CompilerIrPhiInputSeq inputs]
    (if (<= phi-inputs-at-57835-3.len 0)
      (- 0 1)
      (let
        [phi-input-at-57835-3 : ir.CompilerIrPhiInput
          (ir.compiler-ir-phi-input-seq-ref
            (ir.compiler-ir-global-shared-view phi-inputs-at-57835-3)
            0)]
        [value : ir.CompilerIrValue phi-input-at-57835-3.value]
        [input-label : i64 phi-input-at-57835-3.label]
        [rest : ir.CompilerIrPhiInputSeq
          (ir.CompilerIrPhiInputSeq
            phi-inputs-at-57835-3.slots
            (+ phi-inputs-at-57835-3.start 1)
            (- phi-inputs-at-57835-3.len 1))]
        (if (=
          input-label
          (ir.compiler-ir-label (opt.compiler-opt-global-shared-view label)))
          (match value
            [(ir.CompilerIrValue.Var var) var]
            [(ir.CompilerIrValue.I64 literal) literal]
            [_ (- 0 1)])
          (opt-rotate-ssa-test-phi-input-value rest label))))))

;; `bce_version`'s output shape: a guard picks between two clones of one counted
;; loop and BOTH clones leave through the SAME exit block. The exit block's
;; predecessor set is then {fast header, slow header}, and the rotation refused
;; both halves -- including the fast half, the one that actually runs -- because
;; it demanded the exit block be the header's private successor. That demand
;; exists only to keep the fresh exit phis well formed; with no loop-carried
;; value read past the loop there are no exit phis, nothing is prepended to the
;; exit block, and the rotation merely swaps the header's edge into it for the
;; preheader's and the latch's. `recompute!`'s writeback loop in
;; benchmarks/liveness_scan is the measured case.
;;
;; With `merge-phi` the shared block merges both counters, which is both an
;; outside reader (exit phis are needed) and a pre-existing phi in the exit
;; block -- refused, unchanged, on either count.
(define (opt-rotate-ssa-test-shared-exit-blocks [merge-phi : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-block-cons
    (irt.block
      "entry:
         %10 = lt %0, 5 : bool
         branch %10, g1, g2")
    (ir.compiler-ir-block-cons
      (opt-flag-exit-test-jump-block "g1" "h1")
      (opt-rotate-ssa-test-counted-loop
        "h1"
        "g1"
        "b1"
        "l1"
        "shared"
        1
        2
        3
        (ir.compiler-ir-block-cons
          (opt-flag-exit-test-jump-block "g2" "h2")
          (opt-rotate-ssa-test-counted-loop
            "h2"
            "g2"
            "b2"
            "l2"
            "shared"
            4
            5
            6
            (ir.compiler-ir-block-cons
              (ir.CompilerIrBlock.Block
                (ir.compiler-ir-label "shared")
                (if merge-phi
                  (irt.instrs
                    "%7 = phi [%1, h1], [%4, h2] : i64
                     return %7")
                  (irt.instrs "return 0")))
              (ir.CompilerIrBlockList.Nil))))))))

(define (opt-rotate-ssa-test-shared-exit-run [merge-phi : bool]) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList
      (opt-rotate-ssa-test-shared-exit-blocks merge-phi)]
    (match (opt.opt-rotate-ssa-function-with-context-result
      (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
      false
      (ir.CompilerIrFunction.Function
        (opt-test-symbol "rotate_ssa_shared_exit")
        (irt.params "n=%0:i64")
        (ast.AstType.I64)
        11
        blocks
        ir.CompilerIrFunctionAbi.Ordinary))
      [(opt.OptFunctionCtxResult.Result next _) next])))

;; Scan discipline: a REFUSED loop must not retire the rounds. The leading loop
;; here is the one shape the classified placement still refuses -- it leaves
;; the loop through a body block, and its counter is read past both exits by a
;; NON-PHI instruction at the join where the two exit paths meet. Neither the
;; exit block nor the body block dominates that join, so neither the fresh exit
;; phi nor the moved phi reaches the read, and serving it would need a phi at
;; the join whose other inputs this rewrite does not own. (A phi INPUT at the
;; same join is placeable, and that is the live-out fixture above; only a
;; non-phi read is not.) The plain counted loop that follows it in the loop
;; list is rotatable and has nothing to do with it. The refusal used to be delivered by the post-rotation
;; verify, which sat ABOVE the scan and ended the whole rounds loop, so the
;; trailing loop was never examined by that stage -- nor by the next one, which
;; re-scans the same list and stops at the same place. That is how
;; benchmarks/liveness_scan's writeback loop stayed top-tested through both
;; rotation stages.
(define (opt-rotate-ssa-test-scan-past-refusal-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump header
     header:
       %1 = phi [0, entry], [%2, latch] : i64
       %3 = lt %1, %0 : bool
       branch %3, body, exit
     body:
       %4 = lt %1, 7 : bool
       branch %4, cont, escape
     cont:
       %2 = add %1, 1 : i64
       jump latch
     latch:
       jump header
     escape:
       jump done
     exit:
       jump done
     done:
       %5 = add %1, 0 : i64
       jump h2
     h2:
       %6 = phi [0, done], [%7, l2] : i64
       %8 = lt %6, %0 : bool
       branch %8, b2, tail
     b2:
       %7 = add %6, 1 : i64
       jump l2
     l2:
       jump h2
     tail:
       return %5"))

(define (opt-rotate-ssa-test-scan-past-refusal-run) : ir.CompilerIrFunction
  (let
    [blocks : ir.CompilerIrBlockList
      (opt-rotate-ssa-test-scan-past-refusal-blocks)]
    (match (opt.opt-rotate-ssa-function-with-context-result
      (opt.opt-cfg-context-build (opt.compiler-opt-global-shared-view blocks))
      false
      (ir.CompilerIrFunction.Function
        (opt-test-symbol "rotate_ssa_scan_past_refusal")
        (irt.params "n=%0:i64")
        (ast.AstType.I64)
        9
        blocks
        ir.CompilerIrFunctionAbi.Ordinary))
      [(opt.OptFunctionCtxResult.Result next _) next])))

;; Fixpoint discipline: the rotated latch ends in the cloned guard branch, not a
;; jump, so `opt-loop-rotation-edge-compatible?` refuses it and a second run
;; changes nothing.
(define (opt-rotate-ssa-test-rerun [once : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (match (opt.opt-rotate-ssa-function-with-context-result
    (opt.opt-cfg-context-build
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view once)))
    false
    once)
    [(opt.OptFunctionCtxResult.Result next _) next]))

(define (compiler-optimize-rotate-ssa-self-test) : i64
  (let
    [rotated : ir.CompilerIrFunction (opt-rotate-ssa-test-run false)]
    [rotated-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt.compiler-opt-global-shared-view rotated))]
    [side-exit : ir.CompilerIrFunction (opt-rotate-ssa-test-run true)]
    [side-exit-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks side-exit)]
    [second-exit-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-rotate-ssa-test-second-exit-run false))]
    [second-exit-live-out-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-rotate-ssa-test-second-exit-run true))]
    [shared-exit-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-rotate-ssa-test-shared-exit-run false))]
    [scan-past-refusal-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks (opt-rotate-ssa-test-scan-past-refusal-run))]
    (cond
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view rotated))))
        1]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view rotated-blocks)
          (ir.compiler-ir-label "header"))
        2]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view rotated-blocks))
            5))
        3]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            (opt.compiler-opt-global-shared-view rotated-blocks)
            (ir.compiler-ir-label "exit")))
        4]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            (opt.compiler-opt-global-shared-view rotated-blocks)
            (ir.compiler-ir-label "body")))
        5]
      [(not
          (opt-rotate-ssa-test-single-jump-to?
            (opt.compiler-opt-global-shared-view rotated-blocks)
            (ir.compiler-ir-label "header__rotate_land")
            (ir.compiler-ir-label "body")))
        6]
      [(not
          (>
            (opt.opt-function-frame
              (opt.compiler-opt-global-shared-view rotated))
            4))
        7]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.compiler-opt-global-shared-view side-exit-blocks)
            (opt-rotate-ssa-test-blocks true)))
        8]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view side-exit-blocks))
            5))
        9]
      [(not
          (opt-block-list-has-label?
            side-exit-blocks
            (ir.compiler-ir-label "header")))
        10]
      ;; both sibling loops rotate inside ONE invocation
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-rotate-ssa-test-siblings-run))))
        11]
      [(not
          (opt-block-list-has-label?
            (opt.opt-function-blocks (opt-rotate-ssa-test-siblings-run))
            (ir.compiler-ir-label "h1__rotate_land")))
        12]
      [(not
          (opt-block-list-has-label?
            (opt.opt-function-blocks (opt-rotate-ssa-test-siblings-run))
            (ir.compiler-ir-label "h2__rotate_land")))
        13]
      [(opt-block-list-has-label?
          (opt.opt-function-blocks (opt-rotate-ssa-test-siblings-run))
          (ir.compiler-ir-label "h1"))
        14]
      [(opt-block-list-has-label?
          (opt.opt-function-blocks (opt-rotate-ssa-test-siblings-run))
          (ir.compiler-ir-label "h2"))
        15]
      ;; the `it-slice-eq?` class: a body that leaves the loop by its own exit
      ;; block rotates, and the rotated latch carries the test
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view second-exit-blocks)
          (ir.compiler-ir-label "header"))
        16]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view second-exit-blocks)
            (ir.compiler-ir-label "header__rotate_land")))
        17]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            (opt.compiler-opt-global-shared-view second-exit-blocks)
            (ir.compiler-ir-label "body")))
        18]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            (opt.compiler-opt-global-shared-view second-exit-blocks)
            (ir.compiler-ir-label "latch")))
        19]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            (opt.compiler-opt-global-shared-view second-exit-blocks)
            (ir.compiler-ir-label "entry")))
        20]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt-rotate-ssa-test-second-exit-run false))))
        21]
      ;; ... and STILL rotates once a loop-carried value is read past BOTH
      ;; exits, because the two edges are served from different definitions:
      ;; the join phi's `exit` input takes the fresh exit phi (var 8: the fixture's frame is 6 and
      ;; the two cloned guards take 6 and 7) and its `escape` input keeps the moved
      ;; phi (var 1), which the body block dominates after rotation.
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view second-exit-live-out-blocks)
          (ir.compiler-ir-label "header"))
        22]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view second-exit-live-out-blocks)
            (ir.compiler-ir-label "header__rotate_land")))
        46]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-rotate-ssa-test-second-exit-run true))))
        47]
      [(not
          (opt-rotate-ssa-test-starts-with-phi?
            (opt.compiler-opt-global-shared-view second-exit-live-out-blocks)
            (ir.compiler-ir-label "exit")))
        48]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            (opt.compiler-opt-global-shared-view second-exit-live-out-blocks)
            (ir.compiler-ir-label "latch")))
        49]
      [(not
          (=
            (opt-rotate-ssa-test-block-phi-input-value
              (opt.compiler-opt-global-shared-view second-exit-live-out-blocks)
              "done"
              "exit")
            8))
        50]
      [(not
          (=
            (opt-rotate-ssa-test-block-phi-input-value
              (opt.compiler-opt-global-shared-view second-exit-live-out-blocks)
              "done"
              "escape")
            1))
        51]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-second-exit-run true)))
            second-exit-live-out-blocks))
        52]
      ;; the flag class is DEFERRED to flag_exit, not rotated here
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks (opt-rotate-ssa-test-flag-loop-run))
            (opt-rotate-ssa-test-flag-loop-blocks)))
        53]
      ;; the exit phi merges the preheader's zero-trip value and the latch's
      [(not
          (opt-rotate-ssa-test-exit-phi-inputs-ok?
            (opt.compiler-opt-global-shared-view rotated-blocks)))
        23]
      ;; rotating a rotated loop is a no-op, in both fixtures
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks (opt-rotate-ssa-test-rerun rotated))
            rotated-blocks))
        24]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-second-exit-run false)))
            second-exit-blocks))
        25]
      ;; and the whole pipeline settles the class bottom-tested
      [(not (opt-rotate-ssa-test-pipeline-bottom-tested?)) 26]
      ;; `bce_version`'s two clones share one exit block; with nothing read past
      ;; the loop BOTH rotate
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt-rotate-ssa-test-shared-exit-run false))))
        27]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view shared-exit-blocks)
            (ir.compiler-ir-label "h1__rotate_land")))
        28]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view shared-exit-blocks)
            (ir.compiler-ir-label "h2__rotate_land")))
        29]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view shared-exit-blocks)
          (ir.compiler-ir-label "h1"))
        30]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view shared-exit-blocks)
          (ir.compiler-ir-label "h2"))
        31]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            (opt.compiler-opt-global-shared-view shared-exit-blocks)
            (ir.compiler-ir-label "l1")))
        32]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            (opt.compiler-opt-global-shared-view shared-exit-blocks)
            (ir.compiler-ir-label "l2")))
        33]
      ;; ... and the shared exit block keeps its own predecessors: no phi is
      ;; prepended there, so it needs none of them
      [(opt-rotate-ssa-test-starts-with-phi?
          (opt.compiler-opt-global-shared-view shared-exit-blocks)
          (ir.compiler-ir-label "shared"))
        34]
      ;; once the shared block merges both counters it is both an outside
      ;; reader and a pre-existing exit phi: refused, unchanged
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks (opt-rotate-ssa-test-shared-exit-run true))
            (opt-rotate-ssa-test-shared-exit-blocks true)))
        35]
      ;; rotating the shared-exit pair twice is a no-op
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-shared-exit-run false)))
            shared-exit-blocks))
        36]
      ;; a refused loop does not retire the scan: the leading multi-exit
      ;; live-out loop stays put and the counted loop behind it still rotates
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt-rotate-ssa-test-scan-past-refusal-run))))
        37]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view scan-past-refusal-blocks)
            (ir.compiler-ir-label "header")))
        38]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view scan-past-refusal-blocks)
          (ir.compiler-ir-label "header__rotate_land"))
        39]
      [(not
          (opt-rotate-ssa-test-single-jump-to?
            (opt.compiler-opt-global-shared-view scan-past-refusal-blocks)
            (ir.compiler-ir-label "latch")
            (ir.compiler-ir-label "header")))
        40]
      [(not
          (opt-block-list-has-label?
            (opt.compiler-opt-global-shared-view scan-past-refusal-blocks)
            (ir.compiler-ir-label "h2__rotate_land")))
        41]
      [(opt-block-list-has-label?
          (opt.compiler-opt-global-shared-view scan-past-refusal-blocks)
          (ir.compiler-ir-label "h2"))
        43]
      [(not
          (opt-rotate-ssa-test-ends-with-branch?
            (opt.compiler-opt-global-shared-view scan-past-refusal-blocks)
            (ir.compiler-ir-label "l2")))
        44]
      [(not
          (opt.opt-block-list-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            (opt.opt-function-blocks
              (opt-rotate-ssa-test-rerun
                (opt-rotate-ssa-test-scan-past-refusal-run)))
            scan-past-refusal-blocks))
        45]
      [else 42])))

(define (opt-label-set-persistent-branch-self-test) : bool
  (let
    [base-label : i64 (ir.compiler-ir-label "label-set-base")]
    [left-label : i64 (ir.compiler-ir-label "label-set-left")]
    [right-label : i64 (ir.compiler-ir-label "label-set-right")]
    [tail-label : i64 (ir.compiler-ir-label "label-set-tail")]
    [base : opt.OptLabelSet
      (opt.opt-label-add (opt.OptLabelSet.Nil) base-label)]
    [left : opt.OptLabelSet
      (opt.opt-label-add (opt.compiler-opt-global-shared-view base) left-label)]
    [right : opt.OptLabelSet
      (opt.opt-label-add (opt.compiler-opt-global-shared-view base) right-label)]
    [left-tail : opt.OptLabelSet
      (opt.opt-label-tail (opt.compiler-opt-global-shared-view left))]
    [tail-extended : opt.OptLabelSet (opt.opt-label-add left-tail tail-label)]
    (and
      (= (opt.opt-label-count (opt.compiler-opt-global-shared-view base)) 1)
      (opt.opt-label-contains
        (opt.compiler-opt-global-shared-view base)
        base-label)
      (not
        (opt.opt-label-contains
          (opt.compiler-opt-global-shared-view base)
          left-label))
      (not (opt.opt-label-contains base right-label))
      (= (opt.opt-label-count (opt.compiler-opt-global-shared-view left)) 2)
      (opt.opt-label-contains
        (opt.compiler-opt-global-shared-view left)
        left-label)
      (not
        (opt.opt-label-contains
          (opt.compiler-opt-global-shared-view left)
          right-label))
      (not (opt.opt-label-contains left tail-label))
      (= (opt.opt-label-count (opt.compiler-opt-global-shared-view right)) 2)
      (opt.opt-label-contains
        (opt.compiler-opt-global-shared-view right)
        right-label)
      (not (opt.opt-label-contains right left-label))
      (=
        (opt.opt-label-count
          (opt.compiler-opt-global-shared-view tail-extended))
        2)
      (opt.opt-label-contains
        (opt.compiler-opt-global-shared-view tail-extended)
        base-label)
      (opt.opt-label-contains
        (opt.compiler-opt-global-shared-view tail-extended)
        tail-label)
      (not (opt.opt-label-contains tail-extended left-label)))))

(define (compiler-optimize-ssa-self-test) : i64
  (let
    [diamond-blocks : ir.CompilerIrBlockList (opt-ssa-diamond-blocks)]
    [diamond-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build
        (opt.compiler-opt-global-shared-view diamond-blocks))]
    [diamond-doms : opt.OptDomInfo
      (opt-cfg-dominators
        (opt.compiler-opt-global-shared-view diamond-blocks))]
    [then-frontier : opt.OptLabelSet
      (opt-cfg-dominance-frontier
        (opt.compiler-opt-global-shared-view diamond-blocks)
        (ir.compiler-ir-label "then"))]
    [else-frontier : opt.OptLabelSet
      (opt-cfg-dominance-frontier
        (opt.compiler-opt-global-shared-view diamond-blocks)
        (ir.compiler-ir-label "else"))]
    [loop-blocks : ir.CompilerIrBlockList (opt-ssa-loop-blocks)]
    [loop-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build
        (opt.compiler-opt-global-shared-view loop-blocks))]
    [loop-doms : opt.OptDomInfo
      (opt-cfg-dominators (opt.compiler-opt-global-shared-view loop-blocks))]
    [loop-frontier : opt.OptLabelSet
      (opt-cfg-dominance-frontier loop-blocks (ir.compiler-ir-label "loop"))]
    [unreachable-index : opt.OptCfgIndex
      (opt.opt-cfg-index-build (opt-ssa-unreachable-blocks))]
    [unreachable-order : ir.CompilerIrBlockList
      (opt.opt-cfg-reachable-block-order (opt-ssa-unreachable-blocks))]
    [constructed-diamond : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-diamond-function))]
    [constructed-diamond-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view constructed-diamond))]
    [constructed-loop : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-loop-function))]
    [constructed-loop-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view constructed-loop))]
    [constructed-param : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-mutated-param-function))]
    [constructed-param-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view constructed-param))]
    [address-taken : ir.CompilerIrFunction
      (opt-ssa-construct-address-taken-function)]
    [address-taken-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.compiler-opt-global-shared-view address-taken))]
    [existing-phi : ir.CompilerIrFunction
      (opt-cfg-test-function (opt-cfg-phi-blocks))]
    [existing-phi-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.compiler-opt-global-shared-view existing-phi))]
    [pipeline-loop : ir.CompilerIrFunction
      (opt.optimize-function-once-with-summaries
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-construct-loop-function)
        (opt.opt-loop-bce-empty-summaries))]
    [pipeline-loop-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view pipeline-loop))]
    [entry-backedge : ir.CompilerIrFunction (opt-ssa-entry-backedge-function)]
    [entry-backedge-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt.compiler-opt-global-shared-view entry-backedge))]
    [entry-backedge-preheader-out : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-entry-backedge-preheader-function))]
    [constructed-nested : ir.CompilerIrFunction
      (opt.opt-ssa-construct-function
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-nested-loop-function))]
    [constructed-nested-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view constructed-nested))]
    [pipeline-nested : ir.CompilerIrFunction
      (opt.optimize-function-once-with-summaries
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-nested-loop-function)
        (opt.opt-loop-bce-empty-summaries))]
    [pipeline-nested-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (opt.compiler-opt-global-shared-view pipeline-nested))]
    (cond
      [(not
          (=
            (opt.opt-label-count
              (opt.opt-cfg-predecessors
                (opt.compiler-opt-global-shared-view diamond-blocks)
                (ir.compiler-ir-label "join")))
            2))
        1]
      [(not (= (opt.opt-cfg-index-block-count diamond-index) 4)) 2]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-ssa-diamond-function))))
        3]
      [(not
          (opt.opt-label-set-eq?
            (opt.opt-cfg-index-predecessors
              diamond-index
              (ir.compiler-ir-label "join"))
            (opt.opt-cfg-predecessors-scan
              (opt.compiler-opt-global-shared-view diamond-blocks)
              (ir.compiler-ir-label "join"))))
        4]
      [(not
          (opt.opt-label-set-eq?
            (opt.opt-cfg-index-successors
              diamond-index
              (ir.compiler-ir-label "entry"))
            (opt.opt-cfg-blocks-successors-scan
              diamond-blocks
              (ir.compiler-ir-label "entry"))))
        5]
      [(not (= unreachable-index.reach-count 1)) 6]
      [(not
          (opt.opt-cfg-index-reachable?
            unreachable-index
            (ir.compiler-ir-label "entry")))
        7]
      [(opt.opt-cfg-index-reachable?
          unreachable-index
          (ir.compiler-ir-label "dead"))
        8]
      [(not
          (=
            (opt-cfg-index-rpo-label unreachable-index 0)
            (ir.compiler-ir-label "entry")))
        9]
      [(not
          (=
            (opt-cfg-index-rpo-label loop-index 0)
            (ir.compiler-ir-label "entry")))
        10]
      [(not
          (opt.opt-dom-dominates?
            diamond-doms
            (ir.compiler-ir-label "entry")
            (ir.compiler-ir-label "join")))
        11]
      [(opt.opt-dom-dominates?
          diamond-doms
          (ir.compiler-ir-label "then")
          (ir.compiler-ir-label "join"))
        12]
      [(not
          (opt.opt-label-contains then-frontier (ir.compiler-ir-label "join")))
        13]
      [(not
          (opt.opt-label-contains else-frontier (ir.compiler-ir-label "join")))
        14]
      [(not
          (opt.opt-dom-dominates?
            loop-doms
            (ir.compiler-ir-label "loop")
            (ir.compiler-ir-label "body")))
        15]
      [(not
          (opt.opt-label-contains loop-frontier (ir.compiler-ir-label "loop")))
        16]
      [(not
          (=
            (ir.compiler-ir-block-list-count
              (ir.compiler-ir-global-shared-view unreachable-order))
            1))
        17]
      [(not
          (opt-block-list-has-label?
            unreachable-order
            (ir.compiler-ir-label "entry")))
        18]
      [(not
          (opt.opt-verify-ok? (opt.opt-verify-function (opt-ssa-loop-function))))
        19]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function (opt-ssa-unreachable-function))))
        20]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-duplicate-label-function))
            "optimizer verify: duplicate block label"))
        21]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-unknown-successor-function))
            "optimizer verify: unknown successor label"))
        22]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-bad-phi-function))
            "optimizer verify: phi predecessor mismatch"))
        23]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-duplicate-def-function))
            "optimizer verify: duplicate var definition"))
        24]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-use-before-def-function))
            "optimizer verify: use before definition"))
        25]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-runtime-global-operand-function))
            "optimizer verify: runtime-global marker used as an instruction value"))
        63]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-dominance-fail-function))
            "optimizer verify: use is not dominated by definition"))
        26]
      [(not
          (=
            (opt.opt-cfg-index-rpo-num
              loop-index
              (opt.opt-cfg-index-rpo-id loop-index 0))
            0))
        27]
      [(not (opt-label-set-persistent-branch-self-test)) 60]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function constructed-diamond)))
        36]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view constructed-diamond-blocks))
            1))
        37]
      [(not (= (opt-count-mov-dst-blocks constructed-diamond-blocks 1) 0)) 38]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function constructed-loop))) 39]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view constructed-loop-blocks))
            1))
        40]
      [(not (= (opt-count-mov-dst-blocks constructed-loop-blocks 1) 0)) 41]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function constructed-param)))
        46]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.compiler-opt-global-shared-view constructed-param-blocks))
            1))
        47]
      [(not (= (opt-count-mov-dst-blocks constructed-param-blocks 0) 0)) 48]
      [(not
          (opt.opt-function-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            address-taken
            address-taken-out))
        49]
      [(not
          (opt.opt-function-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            existing-phi
            existing-phi-out))
        50]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function pipeline-loop))) 51]
      [(not (= (opt-count-mov-dst-blocks pipeline-loop-blocks 1) 0)) 52]
      [(not
          (opt.opt-function-eq
            (ast.ast-node-pool-reader-type-segment-bases)
            entry-backedge
            entry-backedge-out))
        53]
      [(not
          (opt.opt-verify-ok?
            (opt.opt-verify-function
              (opt.compiler-opt-global-shared-view entry-backedge-preheader-out))))
        61]
      [(not
          (=
            (opt-count-phi-blocks
              (opt.opt-function-blocks entry-backedge-preheader-out))
            1))
        62]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function constructed-nested)))
        54]
      [(not (> (opt-count-phi-blocks constructed-nested-blocks) 0)) 55]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function pipeline-nested))) 56]
      [(not
          (=
            (opt-count-load-label-blocks
              pipeline-nested-blocks
              (ir.compiler-ir-label "inner_body"))
            1))
        57]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-out-of-range-def-function -1 1))
            "optimizer verify: duplicate var definition"))
        58]
      [(not
          (opt-verify-error-ok?
            (opt.opt-verify-function (opt-ssa-out-of-range-def-function 1 1))
            "optimizer verify: duplicate var definition"))
        59]
      [else 42])))

;; Returns 42 only when a phi whose surviving inputs all name one value folds to
;; a `Mov` of that value, a self-reference on the back edge does not block it,
;; disagreeing inputs keep the phi, and a chain of such phis collapses whole in
;; a single cleanup sweep and a single pipeline run.
(define (compiler-optimize-uniform-phi-self-test) : i64
  (let
    [bool-uniform : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks
        (irt.blocks
          "entry:
             branch %0, then, else
           then:
             jump join
           else:
             jump join
           join:
             %1 = phi [false, then], [false, else] : bool
             return %1"))]
    [i64-uniform : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks
        (irt.blocks
          "entry:
             branch %0, then, else
           then:
             jump join
           else:
             jump join
           join:
             %1 = phi [7, then], [7, else] : i64
             return %1"))]
    [i64-mixed : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks
        (irt.blocks
          "entry:
             branch %0, then, else
           then:
             jump join
           else:
             jump join
           join:
             %1 = phi [10, then], [20, else] : i64
             return %1"))]
    [bool-mixed : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks
        (irt.blocks
          "entry:
             branch %0, then, else
           then:
             jump join
           else:
             jump join
           join:
             %1 = phi [true, then], [false, else] : bool
             return %1"))]
    [self-uniform : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks
        (opt-uniform-phi-loop-blocks (ir.CompilerIrValue.Var 1)))]
    [self-mixed : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks
        (opt-uniform-phi-loop-blocks (ir.CompilerIrValue.I64 6)))]
    [chain-cleanup : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks (opt-uniform-phi-chain-blocks))]
    [mixed-join : ir.CompilerIrBlockList
      (opt.opt-cfg-simplify-blocks (opt-uniform-phi-mixed-join-blocks))]
    [mixed-join-block : ir.CompilerIrBlock
      (opt-uniform-phi-block-of
        (ir.compiler-ir-global-shared-view mixed-join)
        (ir.compiler-ir-label "join"))]
    [chain-pipeline : ir.CompilerIrFunction
      (opt-test-optimize-function
        (ast.ast-node-pool-reader-context-current)
        (ast.ast-node-pool-reader-type-segment-bases)
        (opt-uniform-phi-chain-function))]
    [chain-pipeline-blocks : ir.CompilerIrBlockList
      (opt.opt-function-blocks
        (ir.compiler-ir-global-shared-view chain-pipeline))]
    (cond
      ;; (a) both arms the same literal, bool and i64.
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view bool-uniform))
            0))
        1]
      [(not
          (opt-uniform-phi-folded?
            bool-uniform
            1
            (ir.CompilerIrValue.Bool false)))
        2]
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view i64-uniform))
            0))
        3]
      [(not (opt-uniform-phi-folded? i64-uniform 1 (ir.CompilerIrValue.I64 7)))
        4]
      ;; (c) two different constants: the phi stays, and no `Mov` replaces it.
      [(not
          (=
            (opt-count-phi-blocks (ir.compiler-ir-global-shared-view i64-mixed))
            1))
        5]
      [(not (= (opt-count-mov-dst-blocks i64-mixed 1) 0)) 6]
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view bool-mixed))
            1))
        7]
      [(not (= (opt-count-mov-dst-blocks bool-mixed 1) 0)) 8]
      ;; (b) a self-reference is skipped, so the entry constant carries.
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view self-uniform))
            0))
        9]
      [(not (opt-uniform-phi-folded? self-uniform 1 (ir.CompilerIrValue.I64 5)))
        10]
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view self-mixed))
            1))
        11]
      [(not (= (opt-count-mov-dst-blocks self-mixed 1) 0)) 12]
      ;; (d) both links of a chain go in one sweep, and the pipeline leaves the
      ;; function with no phi at all.
      [(not
          (=
            (opt-count-phi-blocks
              (ir.compiler-ir-global-shared-view chain-cleanup))
            0))
        13]
      [(not
          (opt-uniform-phi-folded?
            (ir.compiler-ir-global-shared-view chain-cleanup)
            2
            (ir.CompilerIrValue.Var 1)))
        14]
      [(not
          (opt-uniform-phi-folded? chain-cleanup 3 (ir.CompilerIrValue.Var 2)))
        15]
      [(not (= (opt-count-phi-blocks chain-pipeline-blocks) 0)) 16]
      ;; One phi of a block folds and the other does not: the survivor stays at
      ;; the head of the block so the backend still finds the whole phi prefix,
      ;; and the fold's `Mov` follows it.
      [(not
          (=
            (opt-block-instr-count
              (ir.compiler-ir-global-shared-view mixed-join-block))
            4))
        18]
      [(not
          (opt-uniform-phi-instr-phi-dst?
            (opt-block-instr-at
              (ir.compiler-ir-global-shared-view mixed-join-block)
              0)
            2))
        19]
      [(not
          (opt-uniform-phi-instr-mov-dst?
            (opt-block-instr-at mixed-join-block 1)
            1
            (ir.CompilerIrValue.I64 7)))
        20]
      [(not (= (opt-count-phi-blocks mixed-join) 1)) 21]
      [(not (opt.opt-verify-ok? (opt.opt-verify-function chain-pipeline))) 17]
      [else 42])))

