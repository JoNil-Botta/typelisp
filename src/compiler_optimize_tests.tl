    (compiler_ir_types.CompilerIrInstr.Load
      7
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ast_types.AstType.I64))))

(define (opt-load-cse-slice-unknown-store-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Word
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 99)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      5
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      7
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ast_types.AstType.I64))))

(define (opt-load-cse-slice-call-barrier-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Word
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Word
      3
      (compiler_ir_types.CompilerIrValue.Var 0)
      1
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Call
      4
      (opt-test-symbol "touch_slice")
      (compiler_ir_types.CompilerIrCallArgs.Nil)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      5
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Word
      6
      (compiler_ir_types.CompilerIrValue.Var 0)
      1
      (compiler_ast_types.AstType.U64))))

;; Address-taking makes the parameter's own two-word storage mutable, unlike a
;; store through its data pointer. The whole-function marker must refuse reuse.
(define (opt-load-cse-slice-address-store-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Word
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.AddrOf 3 0)
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Word
      4
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))))

;; General aggregate Word operations remain store-sensitive; only recognized
;; native Slice parameter groups get the specialized stable-word fact.
(define (opt-load-cse-group-word-store-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Word
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 99)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))))

;; Hashmap slot stores use a scaled data-buffer Gep followed by an unscaled
;; inline-field Gep. The latter must retain element provenance so it preserves
;; cached descriptor-field loads while still invalidating buffer loads.
(define (opt-load-cse-element-gep-chain-store-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      4
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.Gep
      7
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ir_types.CompilerIrValue.I64 8)
      (compiler_ast_types.AstType.U8))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      8
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      9
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ast_types.AstType.I64))))

;; Canonical GLOBAL-base keys: the descriptor fetch group `gep @g, 1` spends a
;; fresh temp per copy, and a BoundsCheck (effect ControlFlow) sits between the
;; copies. The second load must fold to a Mov of the first.
(define (opt-load-cse-global-canonical-gep-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (opt-test-symbol "bounds_ok"))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))))

;; MUST-INVALIDATE: an intervening StorePtr through an unclassified pointer may
;; alias the global's storage, so the re-load stays a load.
(define (opt-load-cse-global-store-barrier-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 99)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))))

;; Chained const offsets sum: `gep (gep @g 1) 1` and the flat `gep @g 2` are one
;; canonical key, so the second load folds.
(define (opt-load-cse-global-gep-chain-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      4
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.I64))))

;; A VARIABLE offset off a global ends the canonical resolution: the gep keeps
;; its own temp's raw identity. A repeat load through the SAME temp still folds
;; (var 3); a load through a gep at a DIFFERENT index var must not (var 6).
(define (opt-load-cse-global-var-offset-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      5
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ast_types.AstType.I64))))

;; The shape every access to a global array emits: the gep base is the POINTER
;; STORED IN the global (`Global`, a fresh `movq g(%rip)` per copy), not the
;; global's address. Distinct temps of one slot must fold across a BoundsCheck.
(define (opt-load-cse-global-value-base-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (opt-test-symbol "bounds_ok"))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))))

;; MUST-INVALIDATE, and the reason the value-base map is dropped by every write:
;; a Store to the global replaces the pointer the gep base reads, so the second
;; group addresses a DIFFERENT descriptor and the re-load must stay a load.
(define (opt-load-cse-global-value-base-store-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      global
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))))

;; REGION-STABLE CELL, granular `Store` kill: a write to a DIFFERENT named cell
;; cannot reach this one, so the chain root re-derivation folds instead of
;; re-walking. This is the shape the descriptor chain takes between two writes
;; to unrelated global scalars (a length or a deleted counter).
(define (opt-load-cse-global-cell-other-store-instrs
  [global : i64]
  [other : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      other
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))))

;; A named-cell write leaves DESCRIPTOR HEADER words alone: the cell holds the
;; handle, the header lives in the object the handle points at. Var 0 is a
;; header-typed param (opt-load-cse-run-with-array-param), so the len re-load
;; folds across the `Store`.
(define (opt-load-cse-global-cell-header-store-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      global
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      4
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.I64))))

;; An ELEMENT store writes data-buffer payload, which no named cell overlaps, so
;; the cell word survives it. Var 0 is a header-typed param whose data pointer
;; roots the element address; the cell entry belongs to an unrelated global.
(define (opt-load-cse-global-cell-element-store-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      4
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      7
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      8
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ast_types.AstType.I64))))

;; The two spellings are DIFFERENT addresses -- `Global g` is [g]+8, `GlobalAddr
;; g` is &g+8 -- so one offset off one symbol must not fold across them.
(define (opt-load-cse-global-base-form-mismatch-instrs [global : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Global global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.GlobalAddr global)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))))

(define (opt-load-global-base-test-eq?
  [base : compiler_optimize.OptMaybeGlobalBase]
  [global : i64]
  [off : i64]
  [value-base? : bool]) : bool
  (match base
    [(compiler_optimize.OptMaybeGlobalBase.Some
        actual-global
        actual-off
        actual-value-base?)
      (and
        (= actual-global global)
        (= actual-off off)
        (=
          (if actual-value-base?
            1
            0)
          (if value-base?
            1
            0)))]
    [(compiler_optimize.OptMaybeGlobalBase.No) false]))

;; Dense global-base state is mutable within a block, but predecessor snapshots
;; must remain isolated across clone/drop/bind and joins must retain only exact
;; agreements.
(define (opt-load-global-bases-self-test?) : bool
  (let
    [seed : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-bind
        (compiler_optimize.opt-load-global-bases-empty)
        1
        10
        8
        true)]
    [left : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-clone seed)]
    [left2 : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-bind left 2 20 16 false)]
    [right : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-clone seed)]
    [right2 : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-bind right 2 20 16 false)]
    [joined : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-intersect left2 right2)]
    [different : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-clone seed)]
    [different2 : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-bind different 2 20 24 false)]
    [narrowed : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-intersect left2 different2)]
    [dropped : compiler_optimize.OptLoadGlobalBases
      (compiler_optimize.opt-load-global-bases-drop-var left2 1)]
    (and
      ;; Mutating the cloned left branch did not alter the retained seed.
      (= seed.len 1)
      (opt-load-global-base-test-eq?
        (compiler_optimize.opt-load-global-bases-lookup seed 1)
        10
        8
        true)
      ;; Exact bindings from both branches survive a join.
      (= joined.len 2)
      (opt-load-global-base-test-eq?
        (compiler_optimize.opt-load-global-bases-lookup joined 2)
        20
        16
        false)
      ;; A conflicting offset is dropped while the common binding remains.
      (= narrowed.len 1)
      (opt-load-global-base-test-eq?
        (compiler_optimize.opt-load-global-bases-lookup narrowed 1)
        10
        8
        true)
      ;; In-place compaction removes only the selected binding.
      (= dropped.len 1)
      (match (compiler_optimize.opt-load-global-bases-lookup dropped 1)
        [(compiler_optimize.OptMaybeGlobalBase.No) true]
        [_ false])
      (opt-load-global-base-test-eq?
        (compiler_optimize.opt-load-global-bases-lookup dropped 2)
        20
        16
        false))))

(define (opt-load-cse-cap-self-test?) : bool
  (let
    [profile-state : profile_state.CompilerProfileMetrics
      (profile_state.compiler-profile-state-metrics
        (profile_state.compiler-profile-state-new))]
    [key0 : compiler_optimize.OptLoadKey
      (compiler_optimize.OptLoadKey.Raw
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.I64)
        false)]
    [key1 : compiler_optimize.OptLoadKey
      (compiler_optimize.OptLoadKey.Raw
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64)
        false)]
    [table1 : compiler_optimize.OptLoadTable
      (compiler_optimize.opt-load-table-bind
        profile-state
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptLoadTable.Nil)
        1
        key0
        (compiler_ir_types.CompilerIrValue.Var 10)
        0)]
    [table2 : compiler_optimize.OptLoadTable
      (compiler_optimize.opt-load-table-bind
        profile-state
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        table1
        1
        key1
        (compiler_ir_types.CompilerIrValue.Var 11)
        0)]
    [table-updated : compiler_optimize.OptLoadTable
      (compiler_optimize.opt-load-table-bind
        profile-state
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        table2
        1
        key0
        (compiler_ir_types.CompilerIrValue.Var 12)
        0)]
    [kinds1 : compiler_optimize.OptLoadPtrKinds
      (compiler_optimize.opt-load-kinds-bind
        profile-state
        (compiler_optimize.opt-load-kinds-empty-with-cap profile-state 1)
        1
        (OptLoadLocElement))]
    [kinds2 : compiler_optimize.OptLoadPtrKinds
      (compiler_optimize.opt-load-kinds-bind
        profile-state
        kinds1
        2
        (OptLoadLocElement))]
    [field-ok : compiler_optimize.OptLoadLocKind
      (compiler_optimize.opt-load-loc-field-checked
        profile-state
        (- compiler_optimize.opt-load-loc-field-base-limit 1)
        (- compiler_optimize.opt-load-loc-field-offset-limit 1)
        (- compiler_optimize.opt-load-loc-field-width-limit 1)
        true)]
    [field-bad : compiler_optimize.OptLoadLocKind
      (compiler_optimize.opt-load-loc-field-checked
        profile-state
        compiler_optimize.opt-load-loc-field-base-limit
        0
        8
        false)]
    (and
      (opt-load-global-bases-self-test?)
      (=
        (compiler_optimize.opt-load-cse-table-cap-for-size 8)
        compiler_optimize.opt-load-cse-table-cap-floor)
      (=
        (compiler_optimize.opt-load-cse-kinds-cap-for-size 8)
        compiler_optimize.opt-load-cse-kinds-cap-floor)
      (=
        (compiler_optimize.opt-load-cse-table-cap-for-size
          (*
            compiler_optimize.opt-load-cse-cap-hard-max
            (* compiler_optimize.opt-load-cse-cap-scale-divisor 2)))
        compiler_optimize.opt-load-cse-cap-hard-max)
      (= (compiler_optimize.opt-load-table-len table2) 1)
      (match (compiler_optimize.opt-load-table-lookup
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        table2
        key1)
        [(compiler_ir_types.CompilerIrMaybeValue.No) true]
        [_ false])
      (match (compiler_optimize.opt-load-table-lookup
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        table-updated
        key0)
        [(compiler_ir_types.CompilerIrMaybeValue.Some value)
          (match value
            [(compiler_ir_types.CompilerIrValue.Var id) (= id 12)]
            [_ false])]
        [(compiler_ir_types.CompilerIrMaybeValue.No) false])
      (match (compiler_optimize.opt-load-kinds-lookup kinds2 1)
        [(OptLoadLocElement) true]
        [_ false])
      (match (compiler_optimize.opt-load-kinds-lookup kinds2 2)
        [(OptLoadLocUnknown) true]
        [_ false])
      (match field-ok
        [(OptLoadLocField base off width header?)
          (and
            (= base (- compiler_optimize.opt-load-loc-field-base-limit 1))
            (= off (- compiler_optimize.opt-load-loc-field-offset-limit 1))
            (= width (- compiler_optimize.opt-load-loc-field-width-limit 1))
            header?)]
        [_ false])
      (match field-bad
        [(OptLoadLocUnknown) true]
        [_ false]))))

(define (opt-call-memory-test-map [name : i64] [summary : i64]) : opt_i64_i64_map.Map
  (let
    [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut map)
        (compiler_ir_types.compiler-ir-symbol-id name)
        summary)
      map)))

;; Two header-typed descriptor params, so a `gep var0, k` load keys as
;; `Field 0 k*8 I64 header?=true` -- the class an element-only callee provably
;; cannot reach.
(define (opt-load-cse-descriptor-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "xs"
      (compiler_ast_types.AstType.DynArray 0)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "ys"
        (compiler_ast_types.AstType.DynArray 0)
        1)
      (compiler_ir_types.CompilerIrParamList.Nil))))

;; Descriptor-field load, a call, then the same descriptor-field load. Only the
;; callee's summary decides whether the second load survives.
(define (opt-load-cse-descriptor-call-instrs [name : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      4
      name
      (compiler_ir_types.CompilerIrCallArgs.One
        (compiler_ir_types.CompilerIrValue.Var 1))
      (compiler_ast_types.AstType.Unit))
    (compiler_ir_types.CompilerIrInstr.Gep
      5
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ast_types.AstType.I64))))

;; The other side of the layer split: an ELEMENT load (through the descriptor's
;; data slot) must NOT survive an element-only callee, because that is exactly
;; the storage such a callee writes.
(define (opt-load-cse-element-call-instrs [name : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Gep
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      6
      name
      (compiler_ir_types.CompilerIrCallArgs.One
        (compiler_ir_types.CompilerIrValue.Var 1))
      (compiler_ast_types.AstType.Unit))
    (compiler_ir_types.CompilerIrInstr.Gep
      7
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.I64 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      8
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ast_types.AstType.I64))))

(define (opt-call-memory-test-call-instrs
  [name : i64]
  [arg : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Load
      3
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      4
      name
      (compiler_ir_types.CompilerIrCallArgs.One arg)
      (compiler_ast_types.AstType.Unit))
    (compiler_ir_types.CompilerIrInstr.Load
      5
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))))

(define (opt-call-memory-test-function
  [name : i64]
  [params : compiler_ir_types.CompilerIrParamList]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    params
    (compiler_ast_types.AstType.Unit)
    16
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        instrs)
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-call-memory-test-functions
  [wrapper : i64]
  [leaf : i64]
  [global-writer : i64]
  [raw-writer : i64]
  [indirect-writer : i64]
  [recursive : i64]
  [clean : i64]) : compiler_ir_types.CompilerIrFunctionSeq
  (let
    [params : compiler_ir_types.CompilerIrParamList
      (opt-load-cse-mixed-ref-params)]
    (compiler_ir_types.compiler-ir-function-seq-prepend
      ;; Wrapper precedes its leaf so the leaf-to-caller fixed point needs a
      ;; later round; leaf param 0 is wrapper argument/root 1.
      (opt-call-memory-test-function
        wrapper
        params
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            3
            leaf
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 0))
            (compiler_ast_types.AstType.Unit))))
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-call-memory-test-function
          leaf
          params
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.I64 9)
              (compiler_ast_types.AstType.I64))))
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-call-memory-test-function
            global-writer
            params
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Store
                (opt-test-symbol "call_memory_global")
                (compiler_ir_types.CompilerIrValue.I64 9)
                (compiler_ast_types.AstType.I64))))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-call-memory-test-function
              raw-writer
              params
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.StorePtr
                  (compiler_ir_types.CompilerIrValue.Var 99)
                  (compiler_ir_types.CompilerIrValue.I64 9)
                  (compiler_ast_types.AstType.I64))))
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-call-memory-test-function
                indirect-writer
                params
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.CallIndirect
                    3
                    (compiler_ir_types.CompilerIrValue.Function leaf)
                    (compiler_ir_types.CompilerIrCallArgs.Nil)
                    (compiler_ast_types.AstType.Unit))))
              (compiler_ir_types.compiler-ir-function-seq-prepend
                (opt-call-memory-test-function
                  recursive
                  params
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Call
                      3
                      recursive
                      (compiler_ir_types.CompilerIrCallArgs.Two
                        (compiler_ir_types.CompilerIrValue.Var 0)
                        (compiler_ir_types.CompilerIrValue.Var 1))
                      (compiler_ast_types.AstType.Unit))))
                (compiler_ir_types.compiler-ir-function-seq-prepend
                  (opt-call-memory-test-function
                    clean
                    params
                    (compiler_ir_types.compiler-ir-instr-seq-empty))
                  (compiler_ir_types.compiler-ir-function-seq-empty))))))))))

;; A CYCLE of two mutually recursive writers. Each stores through the element
;; buffer its own descriptor parameter names and hands that same descriptor to
;; the other, so neither member can be resolved by the pessimistic phase -- each
;; waits on the other -- and the cycle's least fixed point is the ELEMENT bit
;; ALONE: no member writes a parameter's own storage, a global cell, or anything
;; unknown.
;;
;; `global?` gives the SECOND member one additional global-cell store. That bit
;; has to survive the ascending iteration and land on BOTH members: the first
;; carries it back off its call. It is what pins the iteration as a real fixed
;; point rather than optimistic-forever -- a seed of 0 that were simply
;; committed would report both members global-clean.
(define (opt-call-memory-cycle-tail [callee : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Call
      5
      callee
      (compiler_ir_types.CompilerIrCallArgs.One
        (compiler_ir_types.CompilerIrValue.Var 0))
      (compiler_ast_types.AstType.Unit))))

(define (opt-call-memory-cycle-body
  [callee : i64]
  [cell : i64]
  [global? : bool]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (if global?
      (opt-test-instrs-with-tail
        (opt-call-memory-cycle-tail callee)
        (compiler_ir_types.CompilerIrInstr.Store
          cell
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ast_types.AstType.I64)))
      (opt-call-memory-cycle-tail callee))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 4)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.U64))))

(define (opt-call-memory-cycle-functions
  [first : i64]
  [second : i64]
  [cell : i64]
  [global? : bool]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-call-memory-test-function
      first
      (opt-load-cse-descriptor-params)
      (opt-call-memory-cycle-body second cell false))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-call-memory-test-function
        second
        (opt-load-cse-descriptor-params)
        (opt-call-memory-cycle-body first cell global?))
      (compiler_ir_types.compiler-ir-function-seq-empty))))

;; The optimistic phase driven directly, so its BUDGET can be pinned: with no
;; rounds left it must hand back the pessimistic map it was given rather than
;; the optimistic one it was building.
(define (opt-call-memory-cycle-optimistic
  [first : i64]
  [second : i64]
  [cell : i64]
  [rounds : i64]) : opt_i64_i64_map.Map
  (compiler_optimize.opt-call-memory-optimistic-fixed
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-call-memory-cycle-functions first second cell false)
    (opt_i64_i64_map.with-capacity 8)
    (compiler_optimize.opt-call-memory-function-set
      (opt-call-memory-cycle-functions first second cell false)
      (opt_i64_i64_map.with-capacity 8))
    (compiler_optimize.opt-call-memory-seed-optimistic
      (opt-call-memory-cycle-functions first second cell false)
      (opt_i64_i64_map.with-capacity 8)
      (opt_i64_i64_map.with-capacity 8))
    8
    rounds))

(define (opt-call-memory-cycle-clean-bits
  [first : i64]
  [second : i64]
  [cell : i64]) : opt_i64_i64_map.Map
  (compiler_optimize.opt-loop-bce-direct-call-clean-add-memory-clean
    (opt-call-memory-cycle-functions first second cell false)
    (compiler_optimize.opt-call-memory-build
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-call-memory-cycle-functions first second cell false)
      8)
    (opt_i64_i64_map.with-capacity 8)))

(define (opt-call-memory-summary-is?
  [summaries : opt_i64_i64_map.Map]
  [name : i64]
  [expected : i64]) : bool
  (match (opt_i64_i64_map.get
    (& summaries)
    (compiler_ir_types.compiler-ir-symbol-id name))
    [(opt_i64_i64_map.LookupFound summary) (= summary expected)]
    [(opt_i64_i64_map.LookupMissing) false]))

(define (opt-call-memory-summary-has?
  [summaries : opt_i64_i64_map.Map]
  [name : i64]
  [flag : i64]) : bool
  (match (opt_i64_i64_map.get
    (& summaries)
    (compiler_ir_types.compiler-ir-symbol-id name))
    [(opt_i64_i64_map.LookupFound summary) (not (= (bit-and summary flag) 0))]
    [(opt_i64_i64_map.LookupMissing) false]))

(define (compiler-optimize-load-cse-self-test) : i64
  (let
    [positive : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-positive-instrs))]
    [call-touch : i64 (opt-test-symbol "call_memory_touch")]
    [call-write-param : opt_i64_i64_map.Map
      (opt-call-memory-test-map call-touch 1)]
    [call-disjoint : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        call-write-param
        (opt-call-memory-test-call-instrs
          call-touch
          (compiler_ir_types.CompilerIrValue.Var 1)))]
    [call-same-root : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        call-write-param
        (opt-call-memory-test-call-instrs
          call-touch
          (compiler_ir_types.CompilerIrValue.Var 0)))]
    [call-global : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        (opt-call-memory-test-map
          call-touch
          (compiler_optimize.opt-call-memory-global-bit))
        (opt-call-memory-test-call-instrs
          call-touch
          (compiler_ir_types.CompilerIrValue.Var 1)))]
    [call-unknown : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-mixed-ref-params)
        (opt-call-memory-test-map
          call-touch
          (compiler_optimize.opt-call-memory-unknown-bit))
        (opt-call-memory-test-call-instrs
          call-touch
          (compiler_ir_types.CompilerIrValue.Var 1)))]
    ;; An element-only callee keeps the DESCRIPTOR layer alive across the call
    ;; (the header-typed Field entry) but not the ELEMENT layer it writes.
    [call-element-only : opt_i64_i64_map.Map
      (opt-call-memory-test-map
        call-touch
        (compiler_optimize.opt-call-memory-element-bit))]
    [call-descriptor-element : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        call-element-only
        (opt-load-cse-descriptor-call-instrs call-touch))]
    [call-descriptor-unknown : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        (opt-call-memory-test-map
          call-touch
          (compiler_optimize.opt-call-memory-unknown-bit))
        (opt-load-cse-descriptor-call-instrs call-touch))]
    [call-descriptor-global : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        (opt-call-memory-test-map
          call-touch
          (compiler_optimize.opt-call-memory-global-bit))
        (opt-load-cse-descriptor-call-instrs call-touch))]
    [call-element-layer : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params-and-call-memory
        (opt-load-cse-descriptor-params)
        call-element-only
        (opt-load-cse-element-call-instrs call-touch))]
    [summary-wrapper : i64 (opt-test-symbol "call_memory_wrapper")]
    [summary-leaf : i64 (opt-test-symbol "call_memory_leaf")]
    [summary-global : i64 (opt-test-symbol "call_memory_global_writer")]
    [summary-raw : i64 (opt-test-symbol "call_memory_raw_writer")]
    [summary-indirect : i64 (opt-test-symbol "call_memory_indirect_writer")]
    [summary-recursive : i64 (opt-test-symbol "call_memory_recursive")]
    [summary-clean : i64 (opt-test-symbol "call_memory_clean")]
    [call-summaries : opt_i64_i64_map.Map
      (compiler_optimize.opt-call-memory-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-call-memory-test-functions
          summary-wrapper
          summary-leaf
          summary-global
          summary-raw
          summary-indirect
          summary-recursive
          summary-clean)
        32)]
    [cycle-a : i64 (opt-test-symbol "call_memory_cycle_a")]
    [cycle-b : i64 (opt-test-symbol "call_memory_cycle_b")]
    [cycle-cell : i64 (opt-test-symbol "call_memory_cycle_cell")]
    [cycle-element : opt_i64_i64_map.Map
      (compiler_optimize.opt-call-memory-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-call-memory-cycle-functions cycle-a cycle-b cycle-cell false)
        8)]
    [cycle-global : opt_i64_i64_map.Map
      (compiler_optimize.opt-call-memory-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-call-memory-cycle-functions cycle-a cycle-b cycle-cell true)
        8)]
    [cycle-bail : opt_i64_i64_map.Map
      (opt-call-memory-cycle-optimistic cycle-a cycle-b cycle-cell 0)]
    [cycle-rounds : opt_i64_i64_map.Map
      (opt-call-memory-cycle-optimistic cycle-a cycle-b cycle-cell 4)]
    [cycle-clean : opt_i64_i64_map.Map
      (opt-call-memory-cycle-clean-bits cycle-a cycle-b cycle-cell)]
    ;; The whole summary of an element-only member of the cycle. Its one write
    ;; is `store_ptr <buffer>, 7 : u64`, so besides the element bit the summary
    ;; carries the ALIAS CLASS that write stores (packet T2-2 / MF-4 ii,
    ;; opt-call-memory-element-class-bit): u64 is class 1. Before that field
    ;; existed the element bit stood alone, which is what these assertions used
    ;; to spell -- the summaries below are compared for EQUALITY, so the class
    ;; has to be part of them.
    [cycle-element-summary : i64
      (compiler_optimize.opt-call-memory-summary-add-element-class 0 1)]
    ;; GAP4: a store through an UNKNOWN pointer still clears everything.
    [store : bool
      (opt-load-cse-barrier-blocked?
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 99)
          (compiler_ir_types.CompilerIrValue.I64 9)
          (compiler_ast_types.AstType.I64)))]
    [store-forward : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-store-forward-instrs))]
    [subword-const-forward : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-subword-const-forward-instrs))]
    [subword-load-forward : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-subword-load-forward-instrs))]
    [subword-unknown-var : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-subword-unknown-var-instrs))]
    [canonical-gep : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-canonical-gep-instrs))]
    [element-store : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param (opt-load-cse-element-store-instrs))]
    [element-invalidate : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-element-invalidate-instrs))]
    [other-base-store : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param (opt-load-cse-other-base-store-instrs))]
    [same-base-disjoint : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-array-param
        (opt-load-cse-same-base-disjoint-instrs))]
    [copybytes-forward : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-copybytes-forward-instrs))]
    [copybytes-overlap : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run (opt-load-cse-copybytes-overlap-instrs))]
    [checked-distinct : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-mixed-ref-params)
        (opt-load-cse-disjoint-checked-root-instrs))]
    [checked-shared-alias : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-shared-ref-params)
        (opt-load-cse-disjoint-checked-root-instrs))]
    [checked-same-root : compiler_ir_types.CompilerIrInstrSeq
      (opt-load-cse-run-with-params
        (opt-load-cse-exclusive-ref-params)
        (opt-load-cse-same-checked-root-instrs))]
    [fresh-tl-alloc-root : compiler_ir_types.CompilerIrInstrSeq
