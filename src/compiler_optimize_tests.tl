                  (compiler_ir_types.compiler-ir-label "loopb")
                  (compiler_ir_types.compiler-ir-label "exit"))
                (compiler_ir_types.compiler-ir-instr-seq-empty)))))))))

(define (opt-gep-starved-test-jump-to-rem) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "rem"))
    (compiler_ir_types.compiler-ir-instr-seq-empty)))

(define (opt-gep-starved-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instr-seq-prepend
        (compiler_ir_types.CompilerIrInstr.BinOp
          6
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.Bool))
        (opt-test-instr-seq-prepend
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.compiler-ir-label "apre1")
            (compiler_ir_types.compiler-ir-label "apre2"))
          (compiler_ir_types.compiler-ir-instr-seq-empty))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "apre1")
        (opt-gep-starved-test-jump-to-rem))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "apre2")
          (opt-gep-starved-test-jump-to-rem))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "rem")
            (opt-gep-starved-test-rem-instrs))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "bguard")
              (opt-test-instr-seq-prepend
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 6)
                  (compiler_ir_types.compiler-ir-label "loopb")
                  (compiler_ir_types.compiler-ir-label "exit"))
                (compiler_ir_types.compiler-ir-instr-seq-empty)))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "loopb")
                (opt-gep-starved-test-loopb-instrs))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "exit")
                  (opt-test-instr-seq-prepend
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.I64 0)))
                    (compiler_ir_types.compiler-ir-instr-seq-empty)))
                (compiler_ir_types.CompilerIrBlockList.Nil)))))))))

(define (opt-gep-starved-test-run) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-gep-offset-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "gep_offset_starved")
      (opt-gep-nested-test-params)
      (compiler_ast_types.AstType.I64)
      32
      (opt-gep-starved-test-blocks))))

(define (compiler-optimize-gep-offset-starved-self-test) : i64
  (let
    [split : compiler_ir_types.CompilerIrFunction (opt-gep-starved-test-run)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks split)]
    [pre-label : i64 (compiler_ir_types.compiler-ir-label "loopb__preheader")]
    [loopb-label : i64 (compiler_ir_types.compiler-ir-label "loopb")]
    [rem-label : i64 (compiler_ir_types.compiler-ir-label "rem")]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function split)))
        1]
      ;; the second loop got its preheader even though the first refused one
      [(not (= (compiler_ir_types.compiler-ir-block-list-count blocks) 8)) 2]
      [(not (= (opt-gep-offset-test-geps-in blocks pre-label) 1)) 3]
      [(not
          (compiler_optimize.opt-value-eq
            (opt-gep-nested-test-gep-offset-in blocks pre-label 0)
            (compiler_ir_types.CompilerIrValue.Var 3)))
        4]
      [(not (= (opt-gep-offset-test-geps-in blocks loopb-label) 1)) 5]
      [(not
          (compiler_optimize.opt-value-eq
            (opt-gep-nested-test-gep-offset-in blocks loopb-label 0)
            (compiler_ir_types.CompilerIrValue.Var 20)))
        6]
      ;; the refused loop is left exactly as it was
      [(not (= (opt-gep-offset-test-geps-in blocks rem-label) 1)) 7]
      [(not
          (compiler_optimize.opt-value-eq
            (opt-gep-nested-test-gep-offset-in blocks rem-label 0)
            (compiler_ir_types.CompilerIrValue.Var 11)))
        8]
      [(not (= (compiler_optimize.opt-function-frame split) 33)) 9]
      [else 42])))

(test
  gep-offset-refused-preheader-not-fatal
  (test.assert-i64-eq
    (compiler-optimize-gep-offset-starved-self-test)
    42
    "a loop whose preheader cannot be synthesized only skips itself: later candidate loops still get theirs and split"))

;; --- monotone-flag loop-exit conversion self-tests ----------------------------
;; One `(while (and (< i n) ok) ... (set! ok false))` loop in the shape
;; `it-slice-eq?` reaches the pass with, with the variant selector perturbing
;; exactly one condition at a time:
;;   0  the plain shape: the flag only ever clears, gates the loop, and dies at
;;      the exit phi -- this converts, and is the enabled control every negative
;;      variant below is one edit away from
;;   1  the gate reads `not flag` instead of the flag -- how
;;      `(while (and (< i n) (not done)) ...)` lowers, and the shape
;;      it-map-insert-from and gvn_table's probe loops have -- so C3 takes the
;;      arms the other way round and converts, and the `not` goes with the
;;      branch it fed
;;   2  the loop counter is read after the loop (ls-scan-symbol-end's shape:
;;      a scan returning its counter) from a position the gate's exit arm does
;;      NOT dominate, so C8 rejects
;;   3  the flag itself is returned rather than reaching an exit phi
;;      (pl-ranges-eq?'s shape): the gate's arm collapses onto the return block
;;      and C8 mints the exit phi that carries the answer
;;   4  a call sits on the path the redirect would skip (pl-run-chunk's shape),
;;      so C6 rejects
;;   5  the gate's exit arm has a second predecessor (gd-dijkstra's shape), so
;;      C7 rejects
;;   6  `(set! ok true)` from a false seed, resolved through an intermediate phi
;;      and a Mov: K = false, C = true, and the gate's arms are swapped
;;   7  the gate's exit arm jumps INTO the counter-exhausted exit instead of the
;;      shared merge -- the shape a loop that tests the flag BEFORE the counter
;;      lowers to (`opt-symbol-leaf-matches-from?`) -- so C7's separation clause
;;      rejects
;;   8  the gate reads `eq flag, true`, C3's other helper shape, which selects
;;      the arms exactly as the bare flag does and converts
;; Variants 2-5 and 7 each keep every other condition satisfied, so a variant
;; that stopped rejecting would convert rather than silently pass.
(define (opt-flag-exit-test-entry-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "loop"))))

(define (opt-flag-exit-test-seed [variant : i64]) : compiler_ir_types.CompilerIrValue
  (if (= variant 6)
    (compiler_ir_types.CompilerIrValue.Bool false)
    (compiler_ir_types.CompilerIrValue.Bool true)))

(define (opt-flag-exit-test-loop-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      10
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 14)
          (compiler_ir_types.compiler-ir-label "latch")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Phi
      11
      (compiler_ir_types.compiler-ir-phi-input-cons
        (opt-flag-exit-test-seed variant)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 13)
          (compiler_ir_types.compiler-ir-label "latch")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.BinOp
      12
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 12)
      (compiler_ir_types.compiler-ir-label "gate")
      (compiler_ir_types.compiler-ir-label "done_full"))))

;; Variant 1 routes the flag through a `not` on the way to the branch, which
;; swaps which arm the cleared flag selects; variant 8 routes it through
;; `eq flag, true`, which does not.
(define (opt-flag-exit-test-gate-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (cond
    [(= variant 1)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.UnOp
          18
          (compiler_ir_types.CompilerIrUnOp.Not)
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 18)
          (compiler_ir_types.compiler-ir-label "done_early")
          (compiler_ir_types.compiler-ir-label "body")))]
    [(= variant 8)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          18
          (compiler_ir_types.CompilerIrBinOp.Eq)
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 18)
          (compiler_ir_types.compiler-ir-label "body")
          (compiler_ir_types.compiler-ir-label "done_early")))]
    [else
      (opt-test-instrs
        (if (= variant 6)
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "done_early")
            (compiler_ir_types.compiler-ir-label "body"))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "done_early"))))]))

(define (opt-flag-exit-test-body-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      15
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      16
      (compiler_ir_types.CompilerIrValue.Var 15)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      17
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 16)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 17)
      (compiler_ir_types.compiler-ir-label "match")
      (compiler_ir_types.compiler-ir-label "mismatch"))))

;; Variant 4 puts a call on the block the redirect would jump past.
(define (opt-flag-exit-test-latch-tail [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    (if (= variant 4)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Call
          19
          cbi.compiler-builtin-id-tl-abort-label
          (compiler_ir_types.CompilerIrCallArgs.Nil)
          (compiler_ast_types.AstType.Unit))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop")))
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.CompilerIrInstr.BinOp
      14
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))))

;; Variant 6 clears to `true` and resolves the flag through an extra phi and a
;; Mov, which is the transitive leg of the closure walk.
(define (opt-flag-exit-test-latch-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 6)
    (opt-test-instrs-with-tail
      (opt-flag-exit-test-latch-tail variant)
      (compiler_ir_types.CompilerIrInstr.Phi
        18
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "mismatch")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "match")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Mov
        13
        (compiler_ir_types.CompilerIrValue.Var 18)
        (compiler_ast_types.AstType.Bool)))
    (opt-test-instrs-with-tail
      (opt-flag-exit-test-latch-tail variant)
      (compiler_ir_types.CompilerIrInstr.Phi
        13
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Bool false)
          (compiler_ir_types.compiler-ir-label "mismatch")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "match")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.Bool)))))

;; Variant 5 sends the counter-exhausted exit through the gate's arm instead of
;; straight to the merge, so that arm acquires a second predecessor.
(define (opt-flag-exit-test-done-full-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Jump
      (if (= variant 5)
        (compiler_ir_types.compiler-ir-label "done_early")
        (compiler_ir_types.compiler-ir-label "exit")))))

(define (opt-flag-exit-test-exit-phi [variant : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Phi
    20
    (if (= variant 7)
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.Var 11)
        (compiler_ir_types.compiler-ir-label "done_full")
        (compiler_ir_types.CompilerIrPhiInputList.Nil))
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.Var 11)
        (compiler_ir_types.compiler-ir-label "done_early")
        (if (= variant 5)
          (compiler_ir_types.CompilerIrPhiInputList.Nil)
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "done_full")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))))
    (compiler_ast_types.AstType.Bool)))

;; Variant 2 reads the loop counter after the loop; variant 3 returns the flag
;; itself instead of letting the exit phi carry it out.
(define (opt-flag-exit-test-exit-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 3)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var 11))))
    (opt-test-instrs-with-tail
      (if (= variant 2)
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            21
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.BinOp
            22
            (compiler_ir_types.CompilerIrBinOp.And)
            (compiler_ir_types.CompilerIrValue.Var 20)
            (compiler_ir_types.CompilerIrValue.Var 21)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 22))))
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 20)))))
      (opt-flag-exit-test-exit-phi variant))))

(define (opt-flag-exit-test-jump-block [label : String] [target : String]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label label)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label target)))))

(define (opt-flag-exit-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-flag-exit-test-entry-instrs))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-flag-exit-test-loop-instrs variant))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "gate")
          (opt-flag-exit-test-gate-instrs variant))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-flag-exit-test-body-instrs))
          (compiler_ir_types.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "match" "latch")
            (compiler_ir_types.compiler-ir-block-cons
              (opt-flag-exit-test-jump-block "mismatch" "latch")
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "latch")
                  (opt-flag-exit-test-latch-instrs variant))
                (compiler_ir_types.compiler-ir-block-cons
                  (opt-flag-exit-test-jump-block
                    "done_early"
                    (if (= variant 7)
                      "done_full"
                      "exit"))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "done_full")
                      (opt-flag-exit-test-done-full-instrs variant))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "exit")
                        (opt-flag-exit-test-exit-instrs variant))
                      (compiler_ir_types.CompilerIrBlockList.Nil))))))))))))

(define (opt-flag-exit-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "base"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "want"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

(define (opt-flag-exit-test-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "flag_exit")
    (opt-flag-exit-test-params)
    (compiler_ast_types.AstType.Bool)
    23
    (opt-flag-exit-test-blocks variant)))

(define (opt-flag-exit-test-run [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-flag-exit-function
    (opt-flag-exit-test-function variant)))

;; --- shape probes -------------------------------------------------------------
(define (opt-flag-exit-test-last-instr
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : compiler_optimize.OptFlagExitMaybeInstr
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_optimize.OptFlagExitMaybeInstr.No)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            (if (= count 0)
              (compiler_optimize.OptFlagExitMaybeInstr.No)
              (compiler_optimize.OptFlagExitMaybeInstr.Some
                (compiler_ir_types.compiler-ir-instr-seq-ref instrs (- count 1)))))])]))

;; The label a block's terminating Jump targets; -1 when it does not end in one.
(define (opt-flag-exit-test-jump-target
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt-flag-exit-test-last-instr blocks label)
    [(compiler_optimize.OptFlagExitMaybeInstr.No) (- 0 1)]
    [(compiler_optimize.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(compiler_ir_types.CompilerIrInstr.Jump target) target]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-jumps-to?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [target : String]) : bool
  (=
    (opt-flag-exit-test-jump-target blocks label)
    (compiler_ir_types.compiler-ir-label target)))

(define (opt-flag-exit-test-phi-in-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : compiler_ir_types.CompilerIrPhiInputList
  (if (>= pos (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (compiler_ir_types.CompilerIrPhiInputList.Nil)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs pos)
      [(compiler_ir_types.CompilerIrInstr.Phi found inputs _)
        (if (= found dst)
          inputs
          (opt-flag-exit-test-phi-in-instrs instrs (+ pos 1) dst))]
      [_ (opt-flag-exit-test-phi-in-instrs instrs (+ pos 1) dst)])))

(define (opt-flag-exit-test-phi-inputs
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : compiler_ir_types.CompilerIrPhiInputList
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.CompilerIrPhiInputList.Nil)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-test-phi-in-instrs instrs 0 dst)])]))

;; 1 when the phi input on `pred` is the literal `true`, 0 when it is `false`,
;; -1 for anything else (including a missing input).
(define (opt-flag-exit-test-phi-bool
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]
  [pred : String]) : i64
  (match (compiler_optimize.opt-thread-phi-input-value
    (opt-flag-exit-test-phi-inputs blocks label dst)
    (compiler_ir_types.compiler-ir-label pred))
    [(compiler_ir_types.CompilerIrMaybeValue.No) (- 0 1)]
    [(compiler_ir_types.CompilerIrMaybeValue.Some value)
      (match value
        [(compiler_ir_types.CompilerIrValue.Bool literal)
          (if literal
            1
            0)]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-phi-input-count
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : i64
  (compiler_ir_types.compiler-ir-phi-input-list-count
    (opt-flag-exit-test-phi-inputs blocks label dst)))

;; 1 when the block's first instruction is `dst = mov <literal>`, 0 otherwise.
(define (opt-flag-exit-test-mov-bool
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-test-mov-scan instrs 0 dst)])]))

(define (opt-flag-exit-test-mov-scan
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : i64
  (if (>= pos (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs pos)
      [(compiler_ir_types.CompilerIrInstr.Mov found src _)
        (if (= found dst)
          (match src
            [(compiler_ir_types.CompilerIrValue.Bool literal)
              (if literal
                1
                0)]
            [_ (- 0 1)])
          (opt-flag-exit-test-mov-scan instrs (+ pos 1) dst))]
      [_ (opt-flag-exit-test-mov-scan instrs (+ pos 1) dst)])))

;; Predecessors of `label`, counted straight off the terminators so the probe
;; does not depend on the pass's own CFG machinery.
(define (opt-flag-exit-test-targets-label?
  [instr : compiler_ir_types.CompilerIrInstr]
  [label : i64]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Jump target) (= target label)]
    [(compiler_ir_types.CompilerIrInstr.Branch _ true-label false-label)
      (or (= true-label label) (= false-label label))]
    [_ false]))

(define (opt-flag-exit-test-pred-count
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : i64
  (opt-flag-exit-test-pred-count-from
    blocks
    (compiler_ir_types.compiler-ir-label label)))

(define (opt-flag-exit-test-pred-count-from
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (+
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
            (let
              [count : i64
                (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
              (if (= count 0)
                0
                (if (opt-flag-exit-test-targets-label?
                  (compiler_ir_types.compiler-ir-instr-seq-ref
                    instrs
                    (- count 1))
                  label)
                  1
                  0)))])
        (opt-flag-exit-test-pred-count-from (__tl-box-place rest) label))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-flag-exit-test-pred-count-from
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        label)]))

(define (opt-flag-exit-test-instr-count
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (compiler_ir_types.compiler-ir-instr-seq-count instrs)])]))

(define (opt-flag-exit-test-unchanged? [variant : i64]) : bool
  (compiler_optimize.opt-block-list-eq
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-function-blocks (opt-flag-exit-test-run variant))
    (opt-flag-exit-test-blocks variant)))

;; The negative control for every rejecting variant: the pass's own entry verify
;; also returns the input untouched, so a fixture that the verifier rejected
;; would "pass" its rejection assertion for the wrong reason.
(define (opt-flag-exit-test-input-verifies? [variant : i64]) : bool
  (compiler_optimize.opt-verify-ok?
    (compiler_optimize.opt-verify-function
      (opt-flag-exit-test-function variant))))

(define (opt-flag-exit-test-rejects? [variant : i64]) : bool
  (and
    (opt-flag-exit-test-input-verifies? variant)
    (opt-flag-exit-test-unchanged? variant)))

(define (compiler-optimize-flag-exit-self-test) : i64
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [converted : compiler_ir_types.CompilerIrFunction
      (opt-flag-exit-test-run 0)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks converted)]
    [twice : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-flag-exit-function converted))]
    [set-true : compiler_ir_types.CompilerIrFunction (opt-flag-exit-test-run 6)]
    [set-true-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks set-true)]
    [negated : compiler_ir_types.CompilerIrFunction (opt-flag-exit-test-run 1)]
    [negated-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks negated)]
    [compared : compiler_ir_types.CompilerIrFunction (opt-flag-exit-test-run 8)]
    [compared-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks compared)]
    [returned : compiler_ir_types.CompilerIrFunction (opt-flag-exit-test-run 3)]
    [returned-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks returned)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function converted)))
        1]
      ;; the gate stopped testing the flag
      [(not (opt-flag-exit-test-jumps-to? blocks "gate" "body")) 2]
      ;; and the clear site leaves the loop directly
      [(not (opt-flag-exit-test-jumps-to? blocks "mismatch" "done_early")) 3]
      ;; the clear edge is gone from the latch phi
      [(not (= (opt-flag-exit-test-phi-input-count blocks "latch" 13) 1)) 4]
      ;; the exit phi carries the answer as literals: cleared on the gate's arm,
      ;; still set on the counter-exhausted arm
      [(not (= (opt-flag-exit-test-phi-bool blocks "exit" 20 "done_early") 0))
        5]
      [(not (= (opt-flag-exit-test-phi-bool blocks "exit" 20 "done_full") 1)) 6]
      ;; no exit gained a predecessor
      [(not
          (=
            (opt-flag-exit-test-pred-count blocks "exit")
            (opt-flag-exit-test-pred-count (opt-flag-exit-test-blocks 0) "exit")))
        7]
      [(not (= (opt-flag-exit-test-pred-count blocks "done_early") 1)) 8]
      ;; the flag's own definitions are pinned to the continuing constant, so
      ;; the phi <-> phi cycle is broken and DCE can retire them
      [(not (= (opt-flag-exit-test-phi-bool blocks "loop" 11 "entry") 1)) 9]
      [(not (= (opt-flag-exit-test-phi-bool blocks "loop" 11 "latch") 1)) 10]
      [(not (= (opt-flag-exit-test-phi-bool blocks "latch" 13 "match") 1)) 11]
      ;; idempotence: the next pipeline iteration finds nothing left to convert
      [(not (compiler_optimize.opt-block-list-eq bases blocks twice)) 12]
      ;; C3: a `not` between the flag and the branch swaps the arms and the
      ;; helper goes with the branch it fed -- the gate block is left with its
      ;; jump alone
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function negated)))
        26]
      [(not (opt-flag-exit-test-jumps-to? negated-blocks "gate" "body")) 13]
      [(not (= (opt-flag-exit-test-instr-count negated-blocks "gate") 1)) 27]
      [(not
          (opt-flag-exit-test-jumps-to? negated-blocks "mismatch" "done_early"))
        28]
      [(not
          (=
            (opt-flag-exit-test-phi-bool negated-blocks "exit" 20 "done_early")
            0))
        29]
      [(not
          (=
            (opt-flag-exit-test-phi-bool negated-blocks "exit" 20 "done_full")
            1))
        30]
      ;; C3: `eq flag, true` keeps the arms as the bare flag has them
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function compared)))
        31]
      [(not (opt-flag-exit-test-jumps-to? compared-blocks "gate" "body")) 32]
      [(not (= (opt-flag-exit-test-instr-count compared-blocks "gate") 1)) 33]
      [(not
          (opt-flag-exit-test-jumps-to? compared-blocks "mismatch" "done_early"))
        34]
      [(not
          (=
            (opt-flag-exit-test-phi-bool compared-blocks "exit" 20 "done_early")
            0))
        35]
      ;; C8: the loop counter is read after the loop
      [(not (opt-flag-exit-test-rejects? 2)) 14]
      ;; C8: the flag itself is returned, so the exit phi minted at the
      ;; collapsed arm carries it -- cleared on the redirected edge, still set
      ;; on the counter-exhausted one
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function returned)))
        15]
      [(not (opt-flag-exit-test-jumps-to? returned-blocks "gate" "body")) 36]
      [(not (opt-flag-exit-test-jumps-to? returned-blocks "mismatch" "exit"))
        37]
      [(not
          (=
            (opt-flag-exit-test-instr-count returned-blocks "done_early")
            (- 0 1)))
        38]
      [(not
          (=
            (opt-flag-exit-test-phi-bool returned-blocks "exit" 23 "mismatch")
            0))
        39]
      [(not
          (=
            (opt-flag-exit-test-phi-var returned-blocks "exit" 23 "done_full")
            11))
        40]
      ;; C6: a call sits on the path the redirect skips
      [(not (opt-flag-exit-test-rejects? 4)) 16]
      ;; C7: the gate's exit arm has a second predecessor
      [(not (opt-flag-exit-test-rejects? 5)) 17]
      ;; C7: the gate's exit arm falls INTO the counter-exhausted exit, so a
      ;; cleared path traverses that exit's edge and the fold would call it
      ;; continuing
      [(not (opt-flag-exit-test-rejects? 7)) 25]
      ;; a false seed cleared to `true` through a phi and a Mov converts the
      ;; same way, with the gate's arms the other way round
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function set-true)))
        18]
      [(not (opt-flag-exit-test-jumps-to? set-true-blocks "gate" "body")) 19]
      [(not
          (opt-flag-exit-test-jumps-to? set-true-blocks "mismatch" "done_early"))
        20]
      [(not
          (=
            (opt-flag-exit-test-phi-bool set-true-blocks "exit" 20 "done_early")
            1))
        21]
      [(not
          (=
            (opt-flag-exit-test-phi-bool set-true-blocks "exit" 20 "done_full")
            0))
        22]
      [(not (= (opt-flag-exit-test-mov-bool set-true-blocks "latch" 13) 0)) 23]
      [(not
          (= (opt-flag-exit-test-phi-bool set-true-blocks "latch" 18 "match") 0))
        24]
      [else 42])))

(test
  flag-exit-monotone-loop-exit
  (test.assert-i64-eq
    (compiler-optimize-flag-exit-self-test)
    42
    "a loop-carried bool that only clears becomes a direct exit jump at the clear site, adds no exit predecessor, and rejects every shape that could observe the retired flag"))

;; --- generalized monotone-flag conversion self-tests --------------------------
;; The merged shape the inliner produces and the probe loops intern_table and
;; gvn_table are built from: the counter test leaves the loop through the SAME
;; block the gate's exit arm is, that block carries phis, and the loop's
;; accumulator is read after it. The variant selector perturbs one thing at a
;; time:
;;   0  the plain generalized shape -- X has phis and a second (in-loop)
;;      predecessor, and a header phi is read from X -- so C7 fills X's phi on
;;      the redirected edge and C8 mints an exit phi for the accumulator
;;   1  the clear edge leaves its predecessor on one arm of a Branch rather than
;;      on a Jump, so only that arm is retargeted
;;   2  X reads the loop COUNTER instead of the accumulator, and the counter's
;;      value at the gate is an `add` the redirect would skip, so C8 rejects
;;   3  X's phi reads a header phi whose latch input is an `add` rather than a
;;      phi or a Mov, so the value the redirected edge would have to name does
;;      not exist and C7 rejects
;;   4  an empty block sits between the gate and X, which is how a lowered
;;      `while` reaches this pass; the arm collapses through it onto X and the
;;      spacer goes with the branch that reached it
;;   5  the same spacer, but carrying the lowered `and`'s dead answer ahead of
;;      its jump -- which is what the arm actually holds in pipeline ROUND 1,
;;      the DCE that retires it sitting a whole round below this pass -- so the
;;      arm still collapses through it and the loop converts a round earlier
;;   6  a spacer that does work: a store ahead of the jump, which the redirect
;;      would skip, so C7 refuses and the loop is left alone
(define (opt-flag-exit-gen-clear-pred [variant : i64]) : String
  (if (= variant 1)
    "body"
    "mismatch"))

(define (opt-flag-exit-gen-entry-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "loop"))))

(define (opt-flag-exit-gen-loop-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      10
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 14)
          (compiler_ir_types.compiler-ir-label "latch")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Phi
      11
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.Bool true)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 13)
          (compiler_ir_types.compiler-ir-label "latch")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Phi
      19
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 23)
          (compiler_ir_types.compiler-ir-label "latch")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      12
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 12)
      (compiler_ir_types.compiler-ir-label "gate")
      (compiler_ir_types.compiler-ir-label "out"))))

;; Variants 4-6 put a block between the gate's exit arm and X.
(define (opt-flag-exit-gen-spaced? [variant : i64]) : bool
  (and (>= variant 4) (<= variant 6)))

;; Variants 5 and 6 need a var and a frame slot the mint does not also want.
(define (opt-flag-exit-gen-frame [variant : i64]) : i64
  (if (>= variant 5)
    33
    32))

(define (opt-flag-exit-gen-arm [variant : i64]) : String
  (if (opt-flag-exit-gen-spaced? variant)
    "spacer"
    "out"))

(define (opt-flag-exit-gen-out-pred [variant : i64]) : String
  (if (opt-flag-exit-gen-spaced? variant)
    "spacer"
    "gate"))

;; Variant 4's spacer is empty. Variant 5's carries the dead answer a lowered
;; `(and c f)` materialises on the arm the `and` is false on: pure, and read by
;; nothing, so deleting it with the block changes no value and no effect --
;; which is what lets the collapse look through it in the round the pipeline
;; DCE has not reached it yet. Variant 6's carries a store instead: real work on
;; the edge the redirect jumps past.
(define (opt-flag-exit-gen-spacer-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (cond
    [(= variant 5)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          32
          (compiler_ir_types.CompilerIrValue.Bool false)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "out")))]
    [(= variant 6)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "out")))]
    [else
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "out")))]))

(define (opt-flag-exit-gen-gate-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 11)
      (compiler_ir_types.compiler-ir-label "body")
      (compiler_ir_types.compiler-ir-label (opt-flag-exit-gen-arm variant)))))

;; Variant 1 clears on the false arm of the body's own Branch, so the clear
;; predecessor has a second successor the redirect must leave alone.
(define (opt-flag-exit-gen-body-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      15
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      16
      (compiler_ir_types.CompilerIrValue.Var 15)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      17
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 16)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 17)
      (compiler_ir_types.compiler-ir-label "match")
      (compiler_ir_types.compiler-ir-label
        (if (= variant 1)
          "latch"
          "mismatch")))))

;; Variant 3 carries the accumulator round the back edge through an `add`
;; instead of a phi, so the redirected edge has no name for its next value.
(define (opt-flag-exit-gen-latch-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      13
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.Bool false)
        (compiler_ir_types.compiler-ir-label
          (opt-flag-exit-gen-clear-pred variant))
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.compiler-ir-label "match")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.Bool))
    (if (= variant 3)
      (compiler_ir_types.CompilerIrInstr.BinOp
        23
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 19)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Phi
        23
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 16)
          (compiler_ir_types.compiler-ir-label
            (opt-flag-exit-gen-clear-pred variant))
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 19)
            (compiler_ir_types.compiler-ir-label "match")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64)))
    (compiler_ir_types.CompilerIrInstr.BinOp
      14
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "loop"))))

;; Variant 3 puts a loop value the redirect cannot name straight into X's phi;
;; every other variant lets the flag reach it and reads the accumulator (the
;; counter, for variant 2) from X's own block.
(define (opt-flag-exit-gen-out-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 3)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        20
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 19)
          (compiler_ir_types.compiler-ir-label "gate")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 19)
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        25
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 20)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var 25))))
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        20
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.compiler-ir-label
            (opt-flag-exit-gen-out-pred variant))
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.BinOp
        24
        (compiler_ir_types.CompilerIrBinOp.Add)
        (if (= variant 2)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ir_types.CompilerIrValue.Var 19))
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        25
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 24)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.BinOp
        26
        (compiler_ir_types.CompilerIrBinOp.And)
        (compiler_ir_types.CompilerIrValue.Var 20)
        (compiler_ir_types.CompilerIrValue.Var 25)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var 26))))))

(define (opt-flag-exit-gen-tail-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "latch")
      (opt-flag-exit-gen-latch-instrs variant))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "out")
        (opt-flag-exit-gen-out-instrs variant))
      (if (opt-flag-exit-gen-spaced? variant)
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "spacer")
            (opt-flag-exit-gen-spacer-instrs variant))
          (compiler_ir_types.CompilerIrBlockList.Nil))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-flag-exit-gen-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-flag-exit-gen-entry-instrs))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-flag-exit-gen-loop-instrs))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "gate")
          (opt-flag-exit-gen-gate-instrs variant))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-flag-exit-gen-body-instrs variant))
          (compiler_ir_types.compiler-ir-block-cons
            (opt-flag-exit-test-jump-block "match" "latch")
            (if (= variant 1)
              (opt-flag-exit-gen-tail-blocks variant)
              (compiler_ir_types.compiler-ir-block-cons
                (opt-flag-exit-test-jump-block "mismatch" "latch")
                (opt-flag-exit-gen-tail-blocks variant)))))))))

(define (opt-flag-exit-gen-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "flag_exit_general")
    (opt-flag-exit-test-params)
    (compiler_ast_types.AstType.Bool)
    (opt-flag-exit-gen-frame variant)
    (opt-flag-exit-gen-blocks variant)))

(define (opt-flag-exit-gen-run [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-flag-exit-function
    (opt-flag-exit-gen-function variant)))

(define (opt-flag-exit-gen-rejects? [variant : i64]) : bool
  (and
    (compiler_optimize.opt-verify-ok?
      (compiler_optimize.opt-verify-function
        (opt-flag-exit-gen-function variant)))
    (compiler_optimize.opt-block-list-eq
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-function-blocks (opt-flag-exit-gen-run variant))
      (opt-flag-exit-gen-blocks variant))))

;; The var a phi's input on `pred` names, or -1 when the input is missing or is
;; not a var.
(define (opt-flag-exit-test-phi-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]
  [pred : String]) : i64
  (match (compiler_optimize.opt-thread-phi-input-value
    (opt-flag-exit-test-phi-inputs blocks label dst)
    (compiler_ir_types.compiler-ir-label pred))
    [(compiler_ir_types.CompilerIrMaybeValue.No) (- 0 1)]
    [(compiler_ir_types.CompilerIrMaybeValue.Some value)
      (match value
        [(compiler_ir_types.CompilerIrValue.Var var) var]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-binop-lhs-scan
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pos : i64]
  [dst : i64]) : i64
  (if (>= pos (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs pos)
      [(compiler_ir_types.CompilerIrInstr.BinOp found _ lhs _ _)
        (if (= found dst)
          (match lhs
            [(compiler_ir_types.CompilerIrValue.Var var) var]
            [_ (- 0 1)])
          (opt-flag-exit-test-binop-lhs-scan instrs (+ pos 1) dst))]
      [_ (opt-flag-exit-test-binop-lhs-scan instrs (+ pos 1) dst)])))

(define (opt-flag-exit-test-binop-lhs
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-flag-exit-test-binop-lhs-scan instrs 0 dst)])]))

;; The label a block's terminating Branch takes on its false arm, or -1 when it
;; does not end in one.
(define (opt-flag-exit-test-branch-false
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt-flag-exit-test-last-instr blocks label)
    [(compiler_optimize.OptFlagExitMaybeInstr.No) (- 0 1)]
    [(compiler_optimize.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(compiler_ir_types.CompilerIrInstr.Branch _ _ false-label) false-label]
        [_ (- 0 1)])]))

(define (opt-flag-exit-test-branch-true
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : i64
  (match (opt-flag-exit-test-last-instr blocks label)
    [(compiler_optimize.OptFlagExitMaybeInstr.No) (- 0 1)]
    [(compiler_optimize.OptFlagExitMaybeInstr.Some instr)
      (match instr
        [(compiler_ir_types.CompilerIrInstr.Branch _ true-label _) true-label]
        [_ (- 0 1)])]))

(define (compiler-optimize-flag-exit-general-self-test) : i64
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [converted : compiler_ir_types.CompilerIrFunction (opt-flag-exit-gen-run 0)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks converted)]
    [twice : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-flag-exit-function converted))]
    [armed : compiler_ir_types.CompilerIrFunction (opt-flag-exit-gen-run 1)]
    [armed-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks armed)]
    [spaced : compiler_ir_types.CompilerIrFunction (opt-flag-exit-gen-run 4)]
    [spaced-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks spaced)]
    [dead-spaced : compiler_ir_types.CompilerIrFunction
      (opt-flag-exit-gen-run 5)]
    [dead-spaced-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks dead-spaced)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function converted)))
        1]
      ;; the gate stopped testing the flag and the clear site leaves directly,
      ;; even though X carries phis and keeps its counter-exit predecessor
      [(not (opt-flag-exit-test-jumps-to? blocks "gate" "body")) 2]
      [(not (opt-flag-exit-test-jumps-to? blocks "mismatch" "out")) 3]
      [(not (= (opt-flag-exit-test-pred-count blocks "out") 2)) 4]
      ;; X's phi swapped its gate input for the redirected edge's literal and
      ;; kept the counter exit's
      [(not (= (opt-flag-exit-test-phi-input-count blocks "out" 20) 2)) 5]
      [(not (= (opt-flag-exit-test-phi-bool blocks "out" 20 "mismatch") 0)) 6]
      [(not (= (opt-flag-exit-test-phi-var blocks "out" 20 "loop") 11)) 7]
      ;; the accumulator got an exit phi: itself on the surviving edge, and the
      ;; value the skipped run would have carried on the redirected one
      [(not (= (opt-flag-exit-test-phi-input-count blocks "out" 32) 2)) 8]
      [(not (= (opt-flag-exit-test-phi-var blocks "out" 32 "loop") 19)) 9]
      [(not (= (opt-flag-exit-test-phi-var blocks "out" 32 "mismatch") 16)) 10]
      ;; and the read under X went to it
      [(not (= (opt-flag-exit-test-binop-lhs blocks "out" 24) 32)) 11]
      ;; the clear edge is gone from both latch phis
      [(not (= (opt-flag-exit-test-phi-input-count blocks "latch" 13) 1)) 12]
      [(not (= (opt-flag-exit-test-phi-input-count blocks "latch" 23) 1)) 13]
      ;; the flag's own definitions are pinned to the continuing constant
      [(not (= (opt-flag-exit-test-phi-bool blocks "loop" 11 "entry") 1)) 14]
      [(not (= (opt-flag-exit-test-phi-bool blocks "loop" 11 "latch") 1)) 15]
      ;; idempotence
      [(not (compiler_optimize.opt-block-list-eq bases blocks twice)) 16]
      ;; a clear edge on one arm of a Branch: that arm alone is retargeted
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function armed)))
        17]
      [(not (opt-flag-exit-test-jumps-to? armed-blocks "gate" "body")) 18]
      [(not
          (=
            (opt-flag-exit-test-branch-false armed-blocks "body")
            (compiler_ir_types.compiler-ir-label "out")))
        19]
      [(not
          (=
            (opt-flag-exit-test-branch-true armed-blocks "body")
            (compiler_ir_types.compiler-ir-label "match")))
        20]
      [(not (= (opt-flag-exit-test-phi-bool armed-blocks "out" 20 "body") 0))
        21]
      [(not (= (opt-flag-exit-test-phi-var armed-blocks "out" 32 "body") 16))
        22]
      ;; an empty block between the gate and X: the arm collapses through it,
      ;; the redirect lands on X itself, and the spacer is deleted
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function spaced)))
        23]
      [(not (opt-flag-exit-test-jumps-to? spaced-blocks "gate" "body")) 24]
      [(not (opt-flag-exit-test-jumps-to? spaced-blocks "mismatch" "out")) 25]
      [(not (= (opt-flag-exit-test-instr-count spaced-blocks "spacer") (- 0 1)))
        26]
      [(not (= (opt-flag-exit-test-phi-input-count spaced-blocks "out" 20) 2))
        27]
      [(not
          (= (opt-flag-exit-test-phi-bool spaced-blocks "out" 20 "mismatch") 0))
        28]
      [(not
          (= (opt-flag-exit-test-phi-var spaced-blocks "out" 32 "mismatch") 16))
        29]
      [(not (= (opt-flag-exit-test-binop-lhs spaced-blocks "out" 24) 32)) 30]
      ;; the ROUND 1 shape: the arm holds the lowered `and`'s dead answer ahead
      ;; of its jump, and the collapse looks through it -- the conversion
      ;; happens in the round `licm`, `gvn` and `bce_version` can still use it,
      ;; rather than waiting for the round's tail DCE to make the arm bare
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function dead-spaced)))
        33]
      [(not (opt-flag-exit-test-jumps-to? dead-spaced-blocks "gate" "body")) 34]
      [(not (opt-flag-exit-test-jumps-to? dead-spaced-blocks "mismatch" "out"))
        35]
      [(not
          (=
            (opt-flag-exit-test-instr-count dead-spaced-blocks "spacer")
            (- 0 1)))
        36]
      [(not
          (=
            (opt-flag-exit-test-phi-bool dead-spaced-blocks "out" 20 "mismatch")
            0))
        37]
      [(not
          (=
            (opt-flag-exit-test-phi-var dead-spaced-blocks "out" 33 "mismatch")
            16))
        38]
      [(not (= (opt-flag-exit-test-binop-lhs dead-spaced-blocks "out" 24) 33))
        39]
      ;; C7: a spacer that does WORK is not one -- a store on the arm is an
      ;; effect the redirect would jump past, so the loop is left alone
      [(not (opt-flag-exit-gen-rejects? 6)) 40]
      ;; C8: the counter's value at the gate is an `add` the redirect skips
      [(not (opt-flag-exit-gen-rejects? 2)) 31]
      ;; C7: X's phi names a loop value whose next value is an `add`, not a phi
      [(not (opt-flag-exit-gen-rejects? 3)) 32]
      [else 42])))

(test
  flag-exit-generalized-loop-exit
  (test.assert-i64-eq
    (compiler-optimize-flag-exit-general-self-test)
    42
    "a gate whose exit arm carries phis and a second predecessor converts, the redirected edge carries the value the skipped run would have delivered, a Branch clear edge moves only its own arm, a spacer holding only dead pure code still collapses, and a value the run cannot name still refuses"))

;; --- dead phi elimination self-tests ------------------------------------------
;; The fixture is the shape SSA construction produces for a mutable local whose
;; last assignment sits in a conditional arm inside a loop, which is the shape
;; every guarded compare loop reaches the loop passes in: the `if` merge's phi
;; (%12) captures a value defined INSIDE the inner loop on the taken edge and
;; the enclosing header's phi (%11) on the skipped one, and the header phi reads
;; the merge phi straight back. Nothing else reads either, so the pair is dead
;; -- and use-count DCE can never say so, because each keeps the other's count
;; at one. While it lives, %20 counts as read outside the inner loop, which is
;; what `flag_exit`'s C8 and `bce_version`'s `opt-bce-mb-defs-escape?` refuse.
;;   0  the plain dead cycle: both phis go, the live counter stays
;;   1  a non-phi reader (the return) makes the cycle live: nothing goes
;;   2  the only reader is another PHI that is itself live, so liveness has to
;;      propagate through it: nothing goes
(define (opt-dead-phi-test-done-instrs [variant : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (= variant 2)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        18
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.compiler-ir-label "outer")
          (compiler_ir_types.CompilerIrPhiInputList.Nil))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var 18))))
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (if (= variant 1)
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.CompilerIrValue.Var 10)))))))

(define (opt-dead-phi-test-outer-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      10
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 14)
          (compiler_ir_types.compiler-ir-label "merge")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Phi
      11
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ir_types.compiler-ir-label "merge")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      15
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 15)
      (compiler_ir_types.compiler-ir-label "guard")
      (compiler_ir_types.compiler-ir-label "done"))))

(define (opt-dead-phi-test-inner-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      20
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.compiler-ir-label "inner_pre")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 21)
          (compiler_ir_types.compiler-ir-label "inner")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      21
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 20)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      22
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 21)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 22)
      (compiler_ir_types.compiler-ir-label "inner")
      (compiler_ir_types.compiler-ir-label "inner_exit"))))

(define (opt-dead-phi-test-merge-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Phi
      12
      (compiler_ir_types.compiler-ir-phi-input-cons
        (compiler_ir_types.CompilerIrValue.Var 20)
        (compiler_ir_types.compiler-ir-label "inner_exit")
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Var 11)
          (compiler_ir_types.compiler-ir-label "skip")
          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      14
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "outer"))))

(define (opt-dead-phi-test-jump-block [label : String] [target : String]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label label)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label target)))))

(define (opt-dead-phi-test-guard-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.BinOp
      16
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 10)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.Bool))
    (compiler_ir_types.CompilerIrInstr.Branch
      (compiler_ir_types.CompilerIrValue.Var 16)
      (compiler_ir_types.compiler-ir-label "inner_pre")
      (compiler_ir_types.compiler-ir-label "skip"))))

(define (opt-dead-phi-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (opt-dead-phi-test-jump-block "entry" "outer")
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "outer")
        (opt-dead-phi-test-outer-instrs))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "guard")
          (opt-dead-phi-test-guard-instrs))
        (compiler_ir_types.compiler-ir-block-cons
          (opt-dead-phi-test-jump-block "inner_pre" "inner")
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "inner")
              (opt-dead-phi-test-inner-instrs))
            (compiler_ir_types.compiler-ir-block-cons
              (opt-dead-phi-test-jump-block "inner_exit" "merge")
              (compiler_ir_types.compiler-ir-block-cons
                (opt-dead-phi-test-jump-block "skip" "merge")
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "merge")
                    (opt-dead-phi-test-merge-instrs))
                  (compiler_ir_types.compiler-ir-block-cons
                    (compiler_ir_types.CompilerIrBlock.Block
                      (compiler_ir_types.compiler-ir-label "done")
                      (opt-dead-phi-test-done-instrs variant))
                    (compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

(define (opt-dead-phi-test-wrap
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "dead_phi")
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "n"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "m"
          (compiler_ast_types.AstType.I64)
          1)
        (compiler_ir_types.CompilerIrParamList.Nil)))
    (compiler_ast_types.AstType.I64)
    23
    blocks))

(define (opt-dead-phi-test-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (opt-dead-phi-test-wrap (opt-dead-phi-test-blocks variant)))

(define (opt-dead-phi-test-run [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (compiler_optimize.opt-dead-phi-function
      (opt-dead-phi-test-function variant))))

(define (opt-dead-phi-test-phi-count-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (opt-dead-phi-test-phi-count-instrs
      instrs
      (+ index 1)
      (+
        acc
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          [(compiler_ir_types.CompilerIrInstr.Phi _ _ _) 1]
          [_ 0])))))

(define (opt-dead-phi-test-phi-count
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-test-phi-count-instrs instrs 0 0)])]))

(define (opt-dead-phi-test-defines-instrs?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (if (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Phi found _ _) (= found dst)]
      [_ false])
      true
      (opt-dead-phi-test-defines-instrs? instrs (+ index 1) dst))))

(define (opt-dead-phi-test-defines?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]
  [dst : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label label))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-dead-phi-test-defines-instrs? instrs 0 dst)])]))

(define (opt-dead-phi-test-unchanged? [variant : i64]) : bool
  (compiler_optimize.opt-block-list-eq
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-dead-phi-test-run variant)
    (opt-dead-phi-test-blocks variant)))

(define (compiler-optimize-dead-phi-self-test) : i64
  (let
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [swept : compiler_ir_types.CompilerIrBlockList (opt-dead-phi-test-run 0)]
    [twice : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-dead-phi-function (opt-dead-phi-test-wrap swept)))]
    [dense-swept : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-dead-phi-function
          (compiler_ir_types.compiler-ir-function-compact-blocks
            (opt-dead-phi-test-function 0))))]
    (cond
      ;; the fixture the negative variants rely on is well formed to start with
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-dead-phi-test-function 0))))
        1]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-dead-phi-test-wrap swept))))
        2]
      ;; both members of the cycle are gone
      [(opt-dead-phi-test-defines? swept "outer" 11) 3]
      [(opt-dead-phi-test-defines? swept "merge" 12) 4]
      ;; the live counter phi and the inner loop's own phi are untouched
      [(not (opt-dead-phi-test-defines? swept "outer" 10)) 5]
      [(not (opt-dead-phi-test-defines? swept "inner" 20)) 6]
      ;; and with the cycle gone the inner counter has no reader outside the
      ;; inner loop at all, which is the fact both loop passes read
      [(not (= (opt-dead-phi-test-phi-count swept "merge") 0)) 7]
      [(not (= (opt-dead-phi-test-phi-count swept "outer") 1)) 8]
      ;; idempotent: a second sweep finds nothing
      [(not (compiler_optimize.opt-block-list-eq bases swept twice)) 9]
      ;; a non-phi reader keeps the whole cycle
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-dead-phi-test-function 1))))
        10]
      [(not (opt-dead-phi-test-unchanged? 1)) 11]
      ;; so does a reader that is itself a live phi: liveness has to propagate
      ;; through the phi web, not stop at the first phi
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (opt-dead-phi-test-function 2))))
        12]
      [(not (opt-dead-phi-test-unchanged? 2)) 13]
      ;; Current production IR is dense. The sweep must retain that container
      ;; shape instead of rebuilding the recursive compatibility lists.
      [(not
          (match dense-swept
            [(compiler_ir_types.CompilerIrBlockList.Array _) true]
            [_ false]))
        14]
      [(not (compiler_optimize.opt-block-list-eq bases swept dense-swept)) 15]
      [else 42])))

(test
  dead-phi-cycle-elimination
  (test.assert-i64-eq
    (compiler-optimize-dead-phi-self-test)
    42
    "a phi web whose only readers are phis is retired, cycles included, while a non-phi reader or a live phi reader anywhere in the web keeps all of it"))

(define (opt-gep-split-test-gep-count-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (opt-gep-split-test-gep-count-from
      instrs
      (+ index 1)
      (+
        acc
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          [(compiler_ir_types.CompilerIrInstr.Gep _ _ _ _) 1]
          [_ 0])))))

(define (opt-gep-split-test-gep-count
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-gep-split-test-gep-count-from instrs 0 0)
            (opt-gep-split-test-gep-count (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-gep-split-test-gep-count
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

;; One shared Gep feeding a Load and a StorePtr (the quicksort swap shape);
;; `other-use` adds a BinOp consumer, which must leave the Gep untouched.
(define (opt-gep-split-test-shared-blocks [other-use : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Gep
          3
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          4
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ast_types.AstType.I64))
        (if other-use
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            5
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64)))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 4)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

;; Lowering can wrap a field/index address in `Gep address, 0 : u8` before a
;; memory operation. The wrapper must inherit the inner Gep recipe so the dead
;; inner definition can be removed and the backend sees one fusible Gep.
(define (opt-gep-split-test-chain-blocks
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [other-use : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Gep
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          offset
          elem-ty)
        (compiler_ir_types.CompilerIrInstr.Gep
          4
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (if other-use
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            5
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64)))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 1)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-gep-split-test-chain-function
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [other-use : bool]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-gep-split-function
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "gep_split_chain")
      (opt-bce-version-test-params)
      (compiler_ast_types.AstType.I64)
      6
      (opt-gep-split-test-chain-blocks offset elem-ty other-use))))

(define (opt-gep-split-test-chain-shape?
  [func : compiler_ir_types.CompilerIrFunction]
  [expected-base : compiler_ir_types.CompilerIrValue]
  [expected-offset : compiler_ir_types.CompilerIrValue]
  [expected-ty : compiler_ast_types.AstType]) : bool
  (match (compiler_optimize.opt-function-blocks func)
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (> (compiler_ir_types.compiler-ir-instr-seq-count instrs) 1)
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 1)
              [(compiler_ir_types.CompilerIrInstr.Gep dst base offset elem-ty)
                (and
                  (= dst 4)
                  (compiler_optimize.opt-value-eq base expected-base)
                  (compiler_optimize.opt-value-eq offset expected-offset)
                  (compiler_optimize.opt-type-eq
                    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                    elem-ty
                    expected-ty))]
              [_ false])
            false)])]
    [_ false]))

(define (compiler-optimize-gep-split-self-test) : i64
  (let
    [split : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-gep-split-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "gep_split_shared")
          (opt-bce-version-test-params)
          (compiler_ast_types.AstType.I64)
          8
          (opt-gep-split-test-shared-blocks false)))]
    [split-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks split)]
    [untouched : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-gep-split-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "gep_split_other_use")
          (opt-bce-version-test-params)
          (compiler_ast_types.AstType.I64)
          8
          (opt-gep-split-test-shared-blocks true)))]
    [chain-zero : compiler_ir_types.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.U8)
        false)]
    [chain-disp : compiler_ir_types.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (compiler_ir_types.CompilerIrValue.I64 8)
        (compiler_ast_types.AstType.U8)
        false)]
    [chain-index : compiler_ir_types.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.I64)
        false)]
    [chain-other-use : compiler_ir_types.CompilerIrFunction
      (opt-gep-split-test-chain-function
        (compiler_ir_types.CompilerIrValue.I64 8)
        (compiler_ast_types.AstType.U8)
        true)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function split)))
        1]
      ;; the shared Gep is cloned per use (Load + StorePtr get one fresh
      ;; single-use Gep each); the dead original is left for the pipeline's
      ;; DCE, so the block holds 2 fresh + 1 dead = 3 Geps.
      [(not (= (opt-gep-split-test-gep-count split-blocks) 3)) 2]
      ;; a Gep with a non-address consumer (the BinOp) is not split.
      [(not
          (=
            (opt-gep-split-test-gep-count
              (compiler_optimize.opt-function-blocks untouched))
            1))
        3]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function untouched)))
        4]
      [(not
          (opt-gep-split-test-chain-shape?
            chain-zero
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.U8)))
        5]
      [(not
          (opt-gep-split-test-chain-shape?
            chain-disp
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.U8)))
        6]
      [(not
          (opt-gep-split-test-chain-shape?
            chain-index
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.I64)))
        7]
      ;; A non-memory use of the inner address rejects the collapse; the outer
      ;; Gep still reads var 3 and therefore remains materialized by the backend.
      [(not
          (opt-gep-split-test-chain-shape?
            chain-other-use
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.U8)))
        8]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function chain-zero)))
        9]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function chain-disp)))
        10]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function chain-index)))
        11]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function chain-other-use)))
        12]
      [else 42])))

;; --- multi-block versioning pipeline self-test --------------------------------------
;; Full-pipeline integration: a lowered while loop whose body splits into a
;; store++ path and a skip path (the quicksort partition shape) must rotate
;; into a multi-block counted loop, version, and leave every fast-derived
;; block check-free while the slow original keeps its per-iteration checks.
(define (opt-bce-mb-pipeline-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          4
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "mbp_ok0"))
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BinOp
              6
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.I64 4)
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.compiler-ir-label "then")
              (compiler_ir_types.compiler-ir-label "else"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "then")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BoundsCheck
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.compiler-ir-label "mbp_ok1"))
              (compiler_ir_types.CompilerIrInstr.BinOp
                7
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Mov
                4
                (compiler_ir_types.CompilerIrValue.Var 7)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (opt-bce-mb-test-jump-block
              (compiler_ir_types.compiler-ir-label "else")
              (compiler_ir_types.compiler-ir-label "merge"))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "merge")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    8
                    (compiler_ir_types.CompilerIrBinOp.Add)
                    (compiler_ir_types.CompilerIrValue.Var 3)
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Mov
                    3
                    (compiler_ir_types.CompilerIrValue.Var 8)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "header"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "exit")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 4)))))
                (compiler_ir_types.CompilerIrBlockList.Nil)))))))))

(define (opt-bce-mb-test-matches-at?
  [label : String]
  [needle : String]
  [off : i64]
  [index : i64]) : bool
  (if (>= index (string.string-length needle))
    true
    (if (=
      (cast (string.string-ref label (+ off index)) : i64)
      (cast (string.string-ref needle index) : i64))
      (opt-bce-mb-test-matches-at? label needle off (+ index 1))
      false)))

(define (opt-bce-mb-test-label-contains-from?
  [label : String]
  [needle : String]
  [off : i64]) : bool
  (if (> (+ off (string.string-length needle)) (string.string-length label))
    false
    (if (opt-bce-mb-test-matches-at? label needle off 0)
      true
      (opt-bce-mb-test-label-contains-from? label needle (+ off 1)))))

(define (opt-bce-mb-test-label-contains? [label : i64] [needle : String]) : bool
  (opt-bce-mb-test-label-contains-from?
    (compiler_ir_types.compiler-ir-label-text label)
    needle
    0))

;; Count blocks whose label contains needle.
(define (opt-bce-mb-test-matching-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [needle : String]
  [acc : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) acc]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-test-matching-blocks
        (__tl-box-place rest)
        needle
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block label _)
            (if (opt-bce-mb-test-label-contains? label needle)
              (+ acc 1)
              acc)]))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-bce-mb-test-matching-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        needle
        acc)]))

;; Total BoundsChecks in blocks whose label contains needle.
(define (opt-bce-mb-test-matching-checks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [needle : String]
  [acc : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) acc]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (opt-bce-mb-test-matching-checks
        (__tl-box-place rest)
        needle
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block label instrs)
            (if (opt-bce-mb-test-label-contains? label needle)
              (+
                acc
                (compiler_optimize.opt-bce-version-check-count
                  instrs
                  0
                  (compiler_ir_types.compiler-ir-instr-seq-count instrs)
                  0))
              acc)]))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-bce-mb-test-matching-checks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        needle
        acc)]))

(define (compiler-optimize-bce-version-mb-pipeline-self-test) : i64
  (let
    [optimized : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "bce_version_mb_while_fixture")
          (opt-bce-version-test-params)
          (compiler_ast_types.AstType.I64)
          9
          (opt-bce-mb-pipeline-blocks)))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks optimized)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function optimized)))
        1]
      ;; the fast region exists ...
      [(< (opt-bce-mb-test-matching-blocks blocks "__bce_fast" 0) 2) 2]
      ;; ... every fast-derived block is check-free ...
      [(not (= (opt-bce-mb-test-matching-checks blocks "__bce_fast" 0) 0)) 3]
      ;; ... and the slow original keeps its per-iteration checks ("" is a
      ;; prefix of every label, so this counts checks function-wide).
      [(< (opt-bce-version-test-prefix-checks blocks "" 0) 2) 4]
      [else 42])))

;; --- multi-block eq-loop bce-version self-tests --------------------------------
;;
;; The byte-compare loop shape (intern_table's it-slice-eq?): a top-tested
;; counted loop (the counter compare ends the header, the latch jumps back)
;; with a second header phi carrying the running flag, two variable-base
;; checked loads whose lengths are per-iteration descriptor loads, and a
;; direct outside use of the flag in an exit block reached through two
;; single-edge forwarding stubs. Variant 1 versions: the guard hoists one
;; gep+load per descriptor length, both checks leave the fast clone, the
;; stubs gain fast twins, and the materialized exit phi carries the fast-edge
;; inputs. Variant 2 gives the check index an in-loop base (that check stays
;; underivable; the second still derives, so the loop partially versions), 3
;; scales the counter by two (the scale-N variable-base guard covers it: the
;; check derives through a synthesized derived seed, so the loop versions
;; check-free), and 4 stores into the loop body (the descriptor-length hoist
;; needs a write-free loop, so no check derives and the function is
;; untouched).
(define (opt-bce-mb-eq-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "arr"
      (compiler_ast_types.AstType.DynArray 0)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "arr2"
        (compiler_ast_types.AstType.DynArray 0)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "start"
            (compiler_ast_types.AstType.I64)
            3)
          (compiler_ir_types.compiler-ir-param-cons
            (compiler_ir_types.CompilerIrParam.Param
              "start2"
              (compiler_ast_types.AstType.I64)
              4)
            (compiler_ir_types.CompilerIrParamList.Nil)))))))

(define (opt-bce-mb-eq-test-header-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "header")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        5
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 13)
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Phi
        6
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 14)
            (compiler_ir_types.compiler-ir-label "latch")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.BinOp
        7
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ir_types.compiler-ir-label "flagtest")
        (compiler_ir_types.compiler-ir-label "exita")))))

;; The two var-base checked byte loads over descriptor lengths. Variant 2
;; moves the base into the loop (`(i*i) + i`), 3 scales the counter
;; (`start + 2*i`), and 4 stores into the body.
(define (opt-bce-mb-eq-test-body-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs
      (cond
        [(= variant 2)
          (compiler_ir_types.CompilerIrInstr.BinOp
            30
            (compiler_ir_types.CompilerIrBinOp.Mul)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))]
        [(= variant 3)
          (compiler_ir_types.CompilerIrInstr.BinOp
            30
            (compiler_ir_types.CompilerIrBinOp.Mul)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ast_types.AstType.I64))]
        [else
          (compiler_ir_types.CompilerIrInstr.Mov
            30
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))])
      (compiler_ir_types.CompilerIrInstr.BinOp
        8
        (compiler_ir_types.CompilerIrBinOp.Add)
        (if (= variant 2)
          (compiler_ir_types.CompilerIrValue.Var 30)
          (compiler_ir_types.CompilerIrValue.Var 3))
        (if (= variant 3)
          (compiler_ir_types.CompilerIrValue.Var 30)
          (compiler_ir_types.CompilerIrValue.Var 5))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Cast
        9
        (compiler_ir_types.CompilerIrValue.Var 8)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.Gep
        10
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        11
        (compiler_ir_types.CompilerIrValue.Var 10)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Cast
        12
        (compiler_ir_types.CompilerIrValue.Var 11)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 9)
        (compiler_ir_types.CompilerIrValue.Var 12)
        (compiler_ir_types.compiler-ir-label "mbe_ok0"))
      (compiler_ir_types.CompilerIrInstr.BinOp
        15
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Cast
        16
        (compiler_ir_types.CompilerIrValue.Var 15)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.Gep
        17
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        18
        (compiler_ir_types.CompilerIrValue.Var 17)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Cast
        19
        (compiler_ir_types.CompilerIrValue.Var 18)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 16)
        (compiler_ir_types.CompilerIrValue.Var 19)
        (compiler_ir_types.compiler-ir-label "mbe_ok1"))
      (compiler_ir_types.CompilerIrInstr.Gep
        20
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        21
        (compiler_ir_types.CompilerIrValue.Var 20)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.Gep
        22
        (compiler_ir_types.CompilerIrValue.Var 21)
        (compiler_ir_types.CompilerIrValue.Var 8)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.Load
        23
        (compiler_ir_types.CompilerIrValue.Var 22)
        (compiler_ast_types.AstType.U8))
      (if (= variant 4)
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 21)
          (compiler_ir_types.CompilerIrValue.Var 23)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.CompilerIrInstr.Mov
          29
          (compiler_ir_types.CompilerIrValue.Var 23)
          (compiler_ast_types.AstType.U8)))
      (compiler_ir_types.CompilerIrInstr.Gep
        24
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        25
        (compiler_ir_types.CompilerIrValue.Var 24)
        (compiler_ast_types.AstType.U64))
      (compiler_ir_types.CompilerIrInstr.Gep
        26
        (compiler_ir_types.CompilerIrValue.Var 25)
        (compiler_ir_types.CompilerIrValue.Var 15)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.Load
        27
        (compiler_ir_types.CompilerIrValue.Var 26)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.BinOp
        28
        (compiler_ir_types.CompilerIrBinOp.Eq)
        (compiler_ir_types.CompilerIrValue.Var 23)
        (compiler_ir_types.CompilerIrValue.Var 27)
        (compiler_ast_types.AstType.U8))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 28)
        (compiler_ir_types.compiler-ir-label "then")
        (compiler_ir_types.compiler-ir-label "else")))))

(define (opt-bce-mb-eq-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-mb-eq-test-header-block)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "flagtest")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.compiler-ir-label "body")
              (compiler_ir_types.compiler-ir-label "exitb"))))
        (compiler_ir_types.compiler-ir-block-cons
          (opt-bce-mb-eq-test-body-block variant)
          (compiler_ir_types.compiler-ir-block-cons
            (opt-bce-mb-test-jump-block
              (compiler_ir_types.compiler-ir-label "then")
              (compiler_ir_types.compiler-ir-label "latch"))
            (compiler_ir_types.compiler-ir-block-cons
              (opt-bce-mb-test-jump-block
                (compiler_ir_types.compiler-ir-label "else")
                (compiler_ir_types.compiler-ir-label "latch"))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "latch")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Phi
                      14
                      (compiler_ir_types.compiler-ir-phi-input-cons
                        (compiler_ir_types.CompilerIrValue.Var 6)
                        (compiler_ir_types.compiler-ir-label "then")
                        (compiler_ir_types.compiler-ir-phi-input-cons
                          (compiler_ir_types.CompilerIrValue.Bool false)
                          (compiler_ir_types.compiler-ir-label "else")
                          (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                      (compiler_ast_types.AstType.Bool))
                    (compiler_ir_types.CompilerIrInstr.BinOp
                      13
                      (compiler_ir_types.CompilerIrBinOp.Add)
                      (compiler_ir_types.CompilerIrValue.Var 5)
                      (compiler_ir_types.CompilerIrValue.I64 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "header"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (opt-bce-mb-test-jump-block
                    (compiler_ir_types.compiler-ir-label "exita")
                    (compiler_ir_types.compiler-ir-label "exit"))
                  (compiler_ir_types.compiler-ir-block-cons
                    (opt-bce-mb-test-jump-block
                      (compiler_ir_types.compiler-ir-label "exitb")
                      (compiler_ir_types.compiler-ir-label "exit"))
                    (compiler_ir_types.compiler-ir-block-cons
                      (compiler_ir_types.CompilerIrBlock.Block
                        (compiler_ir_types.compiler-ir-label "exit")
                        (opt-test-instrs
                          (compiler_ir_types.CompilerIrInstr.Return
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              (compiler_ir_types.CompilerIrValue.Var 6)))))
                      compiler_ir_types.CompilerIrBlockList.Nil)))))))))))

(define (opt-bce-mb-eq-test-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mb_eq_fixture")
    (opt-bce-mb-eq-test-params)
    (compiler_ast_types.AstType.Bool)
    31
    (opt-bce-mb-eq-test-blocks variant)))

(define (opt-bce-mb-eq-test-no-fast?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "header__bce_fast"))
    [(compiler_optimize.OptMaybeBlock.No) true]
    [(compiler_optimize.OptMaybeBlock.Some _) false]))

(define (compiler-optimize-bce-version-mb-eq-self-test) : i64
  (let
    [versioned : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-bce-version-function-with-types
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bce-mb-eq-test-function 1))]
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks versioned)]
    [in-loop-base-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function-with-types
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mb-eq-test-function 2)))]
    [scaled-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function-with-types
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mb-eq-test-function 3)))]
    [stored-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function-with-types
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mb-eq-test-function 4)))]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function versioned)))
        1]
      ;; ten originals + guard + six fast loop blocks + two stub twins.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count out) 19)) 2]
      [(match (compiler_optimize.opt-cfg-find-block
          out
          (compiler_ir_types.compiler-ir-label "header__bce_guard"))
          [(compiler_optimize.OptMaybeBlock.No) true]
          [(compiler_optimize.OptMaybeBlock.Some _) false])
        3]
      ;; both checks left the fast clone body; the slow body keeps both.
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        4]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body"))
            2))
        5]
      ;; the forwarding stubs gained fast twins.
      [(opt-bce-mb-eq-test-no-fast? out) 6]
      [(match (compiler_optimize.opt-cfg-find-block
          out
          (compiler_ir_types.compiler-ir-label "exita__bce_fast"))
          [(compiler_optimize.OptMaybeBlock.No) true]
          [(compiler_optimize.OptMaybeBlock.Some _) false])
        7]
      [(match (compiler_optimize.opt-cfg-find-block
          out
          (compiler_ir_types.compiler-ir-label "exitb__bce_fast"))
          [(compiler_optimize.OptMaybeBlock.No) true]
          [(compiler_optimize.OptMaybeBlock.Some _) false])
        8]
      ;; the materialized exit phi carries both slow and both fast edges.
      [(not
          (=
            (opt-bce-version-test-exit-phi-inputs
              out
              (compiler_ir_types.compiler-ir-label "exit"))
            4))
        9]
      ;; the scale-1 quotient is exact: the guard needs no division.
      [(not
          (=
            (opt-count-binop-op-blocks
              out
              (compiler_ir_types.CompilerIrBinOp.Div))
            0))
        10]
      ;; an in-loop base cannot prove invariance: that check stays, but the
      ;; second check still derives, so the loop PARTIALLY versions.
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count in-loop-base-out)
            19))
        11]
      [(not
          (=
            (opt-bce-version-test-block-checks
              in-loop-base-out
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            1))
        12]
      ;; scale-2 with a variable base now DERIVES through the scale-N
      ;; variable-base guard (a synthesized derived seed with step 2), so the
      ;; loop versions check-free instead of keeping the strided check.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count scaled-out) 19))
        13]
      [(not
          (=
            (opt-bce-version-test-block-checks
              scaled-out
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        14]
      ;; a store in the body blocks the descriptor-length hoist: no
      ;; derivable check, so the loop is left untouched.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count stored-out) 10))
        15]
      [(not (opt-bce-mb-eq-test-no-fast? stored-out)) 16]
      ;; the scale-2 variable-base check pays one quotient division.
      [(not
          (=
            (opt-count-binop-op-blocks
              scaled-out
              (compiler_ir_types.CompilerIrBinOp.Div))
            1))
        17]
      [else 42])))

;; Runtime boundary behavior of the versioned eq loop: windows ending exactly
;; at the array end still pass the guard, and every window compares the same
;; with or without versioning.
(define (opt-bce-mb-eq-runtime-make [n : i64] [seed : i64]) : (__tl_dyn-array
    u8)
  (let
    [out : (__tl_dyn-array u8) (array.make-array u8 n)]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref out i) (cast (+ seed i) : u8))
          (set! i (+ i 1))))
      out)))

(define (opt-bce-mb-eq-runtime-slice-eq?
  [a : (__tl_dyn-array u8)]
  [a-start : i64]
  [b : (__tl_dyn-array u8)]
  [b-start : i64]
  [len : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (while (and (< i len) ok)
        (begin
          (if (= (array-ref a (+ a-start i)) (array-ref b (+ b-start i)))
            unit
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

(test
  bce-version-mb-eq-loop-ir
  (test.assert-i64-eq
    (compiler-optimize-bce-version-mb-eq-self-test)
    42
    "top-tested eq loop with var-base descriptor-length checks versions check-free"))

(test
  bce-version-mb-eq-loop-runtime-boundary
  (let
    [buf : (__tl_dyn-array u8) (opt-bce-mb-eq-runtime-make 16 0)]
    [other : (__tl_dyn-array u8) (opt-bce-mb-eq-runtime-make 16 0)]
    (begin
      (set! (array-ref other 15) 255)
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 8 buf 8 8)
        true
        "equal window ending exactly at the array end")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 0 other 0 8)
        true
        "equal window from a zero base")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 8 other 8 8)
        false
        "last byte differs at the array end")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 8 other 8 7)
        true
        "shared prefix compares equal")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 0 buf 1 8)
        false
        "offset windows differ")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 15 buf 15 1)
        true
        "single byte at the last slot")
      (test.assert-bool-eq
        (opt-bce-mb-eq-runtime-slice-eq? buf 4 buf 4 0)
        true
        "empty window"))))

;; --- call-carrying multiblock clone fixture -----------------------------------
;;
;; A counted do-while nest whose body holds a DIRECT CALL and three descriptor-
;; length checks. Two of the lengths hang off parameter handles the loop never
;; defines; the third hangs off a handle the loop RELOADS out of a module
;; global's cell every iteration, which is the chain
;; opt-bce-mb-descriptor-base has to rebuild in the guard.
;;
;; `variant` moves exactly one thing:
;;   0  the call's callee is element-clean (bit 2)     -- VERSIONS
;;   1  no call at all (a Mov in its place)            -- VERSIONS (the twin)
;;   2  the callee writes through its parameters       -- REFUSED: bit 1 alone
;;      (global-clean but NOT descriptor-safe)            cannot rule out a
;;                                                        write to the caller's
;;                                                        own descriptor
;;   3  the call is INDIRECT                           -- REFUSED: the clone
;;                                                        whitelist has no
;;                                                        indirect call in it,
;;                                                        so the shape scan
;;                                                        rejects the block
;;   4  element-clean callee, but the two parameter    -- REFUSED: one derived
;;      checks are given an in-loop length so only        check against a
;;      the global-rooted check derives                   duplicated call site
;;   5  the callee is unresolved (absent from the      -- REFUSED: no bit
;;      clean map)
;;   6  the callee is memory-clean (bit 0)             -- VERSIONS (the other
;;                                                        admitting bit)
(define (opt-bce-mbcall-test-global) : i64
  (opt-test-symbol "mbcall_workspace"))

(define (opt-bce-mbcall-test-callee [variant : i64]) : i64
  (cond
    [(= variant 2) (opt-test-symbol "mbcall_param_callee")]
    [(= variant 5) (opt-test-symbol "mbcall_unresolved_callee")]
    [(= variant 6) (opt-test-symbol "mbcall_memory_callee")]
    [else (opt-test-symbol "mbcall_clean_callee")]))

;; The per-callee bits the loop-BCE summaries would have built for this
;; fixture's callees, spelled through the same producer production uses
;; (opt-loop-bce-direct-call-clean-bits) so the test cannot drift from it:
;;
;;   clean   summary = element bit only            -> global + element (2|4)
;;   memory  summary = 0                           -> memory + global  (1|2)
;;   param   summary = one parameter-write bit     -> global alone     (2)
;;   unresolved                                    -> absent
(define (opt-bce-mbcall-test-clean-map) : opt_i64_i64_map.Map
  (let
    [out : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-test-symbol "mbcall_clean_callee")
        (compiler_optimize.opt-loop-bce-direct-call-clean-bits
          (compiler_optimize.opt-call-memory-summary-add-element 0)))
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-test-symbol "mbcall_memory_callee")
        (compiler_optimize.opt-loop-bce-direct-call-clean-bits 0))
      (opt_i64_i64_map.insert-ref!
        (&mut out)
        (opt-test-symbol "mbcall_param_callee")
        (compiler_optimize.opt-loop-bce-direct-call-clean-bits 1))
      out)))

(define (opt-bce-mbcall-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "arr"
      (compiler_ast_types.AstType.DynArray 0)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "arr2"
        (compiler_ast_types.AstType.DynArray 0)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          2)
        compiler_ir_types.CompilerIrParamList.Nil))))

;; One `gep handle, 1` + `load` + `cast` + `bounds_check` group.
(define (opt-bce-mbcall-test-check
  [handle : compiler_ir_types.CompilerIrValue]
  [gep-var : i64]
  [load-var : i64]
  [cast-var : i64]
  [length : compiler_ir_types.CompilerIrValue]
  [ok-label : i64]
  [rest : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs-with-tail
    rest
    (compiler_ir_types.CompilerIrInstr.Gep
      gep-var
      handle
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      load-var
      (compiler_ir_types.CompilerIrValue.Var gep-var)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Cast
      cast-var
      (compiler_ir_types.CompilerIrValue.Var load-var)
      (compiler_ast_types.AstType.I64)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 7)
      length
      ok-label)))

(define (opt-bce-mbcall-test-body-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (opt-bce-mbcall-test-check
        (compiler_ir_types.CompilerIrValue.Var 0)
        4
        5
        6
        ;; Variant 4 replaces the proven length with the counter itself: the
        ;; check stays, but nothing about it derives.
        (if (= variant 4)
          (compiler_ir_types.CompilerIrValue.Var 7)
          (compiler_ir_types.CompilerIrValue.Var 6))
        (compiler_ir_types.compiler-ir-label "mbcall_ok0")
        (opt-bce-mbcall-test-check
          (compiler_ir_types.CompilerIrValue.Var 1)
          8
          9
          10
          (if (= variant 4)
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.CompilerIrValue.Var 10))
          (compiler_ir_types.compiler-ir-label "mbcall_ok1")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              11
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ast_types.AstType.Bool))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 11)
              (compiler_ir_types.compiler-ir-label "then")
              (compiler_ir_types.compiler-ir-label "else")))))
      (compiler_ir_types.CompilerIrInstr.Phi
        3
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 30)
            (compiler_ir_types.compiler-ir-label "merge")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Cast
        7
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.U64)))))

;; The call itself, plus the global-rooted descriptor chain the guard has to
;; rebuild: `gep @g, 0` / `load` recovers a handle the loop defines, so the old
;; "base must not be a loop def" test refused the whole chain.
(define (opt-bce-mbcall-test-then-block [variant : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "then")
    (opt-test-instrs-with-tail
      (opt-bce-mbcall-test-check
        (compiler_ir_types.CompilerIrValue.Var 14)
        15
        16
        17
        (compiler_ir_types.CompilerIrValue.Var 17)
        (compiler_ir_types.compiler-ir-label "mbcall_ok2")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "merge"))))
      (cond
        [(= variant 1)
          (compiler_ir_types.CompilerIrInstr.Mov
            12
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))]
        [(= variant 3)
          (compiler_ir_types.CompilerIrInstr.CallIndirect
            12
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.Var 2))
            (compiler_ast_types.AstType.I64))]
        [else
          (compiler_ir_types.CompilerIrInstr.Call
            12
            (opt-bce-mbcall-test-callee variant)
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.Var 2))
            (compiler_ast_types.AstType.I64))])
      (compiler_ir_types.CompilerIrInstr.Gep
        13
        (compiler_ir_types.CompilerIrValue.Global (opt-bce-mbcall-test-global))
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        14
        (compiler_ir_types.CompilerIrValue.Var 13)
        (compiler_ast_types.AstType.DynArray 0)))))

(define (opt-bce-mbcall-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "body"))))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-bce-mbcall-test-body-block variant)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-bce-mbcall-test-then-block variant)
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "else")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "merge")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.BinOp
                  30
                  (compiler_ir_types.CompilerIrBinOp.Add)
                  (compiler_ir_types.CompilerIrValue.Var 3)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.BinOp
                  31
                  (compiler_ir_types.CompilerIrBinOp.Lt)
                  (compiler_ir_types.CompilerIrValue.Var 30)
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ast_types.AstType.Bool))
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 31)
                  (compiler_ir_types.compiler-ir-label "body")
                  (compiler_ir_types.compiler-ir-label "exit"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 0)))))
              compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-bce-mbcall-test-function [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "bce_version_mbcall_fixture")
    (opt-bce-mbcall-test-params)
    (compiler_ast_types.AstType.I64)
    40
    (opt-bce-mbcall-test-blocks variant)))

(define (opt-bce-mbcall-test-run [variant : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-bce-version-function-with-types-and-calls
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-bce-mbcall-test-clean-map)
    (opt-bce-mbcall-test-function variant)))

(define (opt-bce-mbcall-test-out [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks (opt-bce-mbcall-test-run variant)))

;; The `Call` dsts of one block, newest-first, as a count of how many of them
;; are >= `floor`. The clone's call must define a FRESH var (the fresh-id pass
;; allocates from the frame size up), never the original's.
(define (opt-bce-mbcall-test-call-dsts-above
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]
  [floor : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 0]
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            [seen : i64 0]
            (begin
              (while (< index count)
                (begin
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref
                    instrs
                    index)
                    [(compiler_ir_types.CompilerIrInstr.Call dst _ _ _)
                      (if (>= dst floor)
                        (set! seen (+ seen 1))
                        unit)]
                    [_ unit])
                  (set! index (+ index 1))))
              seen))])]))

;; How many `Call` instructions one block holds.
(define (opt-bce-mbcall-test-block-calls
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 0]
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            [seen : i64 0]
            (begin
              (while (< index count)
                (begin
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref
                    instrs
                    index)
                    [(compiler_ir_types.CompilerIrInstr.Call _ _ _ _)
                      (set! seen (+ seen 1))]
                    [_ unit])
                  (set! index (+ index 1))))
              seen))])]))

(define (opt-bce-mbcall-test-unversioned? [variant : i64]) : bool
  (let
    [out : compiler_ir_types.CompilerIrBlockList
      (opt-bce-mbcall-test-out variant)]
    (and
      (= (compiler_ir_types.compiler-ir-block-list-count out) 6)
      (match (compiler_optimize.opt-cfg-find-block
        out
        (compiler_ir_types.compiler-ir-label "body__bce_fast"))
        [(compiler_optimize.OptMaybeBlock.No) true]
        [(compiler_optimize.OptMaybeBlock.Some _) false]))))

(define (compiler-optimize-bce-version-mbcall-self-test) : i64
  (let
    [versioned : compiler_ir_types.CompilerIrFunction
      (opt-bce-mbcall-test-run 0)]
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks versioned)]
    [twin-out : compiler_ir_types.CompilerIrBlockList
      (opt-bce-mbcall-test-out 1)]
    [memory-out : compiler_ir_types.CompilerIrBlockList
      (opt-bce-mbcall-test-out 6)]
    ;; Idempotence: the fast labels now exist, which
    ;; opt-bce-mb-fast-labels-fresh? refuses on, so a second pass is a no-op.
    [again-out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-bce-version-function-with-types-and-calls
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-bce-mbcall-test-clean-map)
          versioned))]
    (cond
      ;; (4) SSA validity of the cloned call: the pass's own verifier is what
      ;; gates every application, and a clone that re-defined the original
      ;; call's dst would fail it here.
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function versioned)))
        1]
      ;; six originals + guard + five fast clones (body/then/else/merge and the
      ;; entry stub is not cloned) -- entry and exit stay shared.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count out) 11)) 2]
      [(match (compiler_optimize.opt-cfg-find-block
          out
          (compiler_ir_types.compiler-ir-label "body__bce_guard"))
          [(compiler_optimize.OptMaybeBlock.No) true]
          [(compiler_optimize.OptMaybeBlock.Some _) false])
        3]
      ;; (1) all three checks left the fast clone; the slow loop keeps all
      ;; three.
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body__bce_fast"))
            0))
        4]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            0))
        5]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "body"))
            2))
        6]
      [(not
          (=
            (opt-bce-version-test-block-checks
              out
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        7]
      ;; The call is DUPLICATED, not moved: one in each copy.
      [(not
          (=
            (opt-bce-mbcall-test-block-calls
              out
              (compiler_ir_types.compiler-ir-label "then"))
            1))
        8]
      [(not
          (=
            (opt-bce-mbcall-test-block-calls
              out
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            1))
        9]
      ;; ... and the clone's call defines a FRESH var: every id the fresh-id
      ;; pass mints is at or above the fixture's frame size of 40, while the
      ;; original's dst is 12.
      [(not
          (=
            (opt-bce-mbcall-test-call-dsts-above
              out
              (compiler_ir_types.compiler-ir-label "then__bce_fast")
              40)
            1))
        10]
      [(not
          (=
            (opt-bce-mbcall-test-call-dsts-above
              out
              (compiler_ir_types.compiler-ir-label "then")
              40)
            0))
        11]
      ;; The guard REBUILDS the global-rooted descriptor chain: it holds a
      ;; `gep @mbcall_workspace, 0`, which no other guard the pass emits does.
      [(not
          (opt-bce-mbcall-test-guard-has-global?
            out
            (compiler_ir_types.compiler-ir-label "body__bce_guard")))
        12]
      ;; (7) idempotent.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count again-out) 11))
        13]
      [(match (compiler_optimize.opt-cfg-find-block
          again-out
          (compiler_ir_types.compiler-ir-label "body__bce_fast__bce_fast"))
          [(compiler_optimize.OptMaybeBlock.No) false]
          [(compiler_optimize.OptMaybeBlock.Some _) true])
        14]
      ;; The call-free twin versions identically -- the call is priced, not
      ;; structurally special.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count twin-out) 11))
        15]
      [(not
          (=
            (opt-bce-version-test-block-checks
              twin-out
              (compiler_ir_types.compiler-ir-label "then__bce_fast"))
            0))
        16]
      ;; A MEMORY-clean callee is the other bit that admits the chain.
      [(not (= (compiler_ir_types.compiler-ir-block-list-count memory-out) 11))
        17]
      ;; (2) A callee that could write a descriptor through a parameter is
      ;; global-clean but NOT descriptor-safe: the chain stops deriving and the
      ;; loop is refused outright.
      [(not (opt-bce-mbcall-test-unversioned? 2)) 18]
      ;; (3) An INDIRECT call is outside the clone whitelist.
      [(not (opt-bce-mbcall-test-unversioned? 3)) 19]
      ;; (6) One derived check does not pay for a duplicated call site.
      [(not (opt-bce-mbcall-test-unversioned? 4)) 20]
      ;; An unresolved callee earns no bit at all.
      [(not (opt-bce-mbcall-test-unversioned? 5)) 21]
      ;; (5) The summary bit itself: element-only earns bit 2, element PLUS a
      ;; parameter write does not -- that callee's write may be the caller's
      ;; own descriptor.
      [(not
          (=
            (bit-and
              (compiler_optimize.opt-loop-bce-direct-call-clean-bits
                (compiler_optimize.opt-call-memory-summary-add-element 0))
              (compiler_optimize.opt-direct-call-clean-unconditional-global-bit))
            (compiler_optimize.opt-direct-call-clean-unconditional-global-bit)))
        22]
      [(not
          (=
            (bit-and
              (compiler_optimize.opt-loop-bce-direct-call-clean-bits
                (compiler_optimize.opt-call-memory-summary-add-element 1))
              (compiler_optimize.opt-direct-call-clean-unconditional-global-bit))
            0))
        23]
      ;; ... while that same summary keeps bit 1, so nothing the global-operand
      ;; readers already proved is lost.
      [(not
          (=
            (bit-and
              (compiler_optimize.opt-loop-bce-direct-call-clean-bits
                (compiler_optimize.opt-call-memory-summary-add-element 1))
              (compiler_optimize.opt-direct-call-clean-global-bit))
            (compiler_optimize.opt-direct-call-clean-global-bit)))
        24]
      ;; ... and a global-writing callee earns nothing.
      [(not
          (=
            (compiler_optimize.opt-loop-bce-direct-call-clean-bits
              (compiler_optimize.opt-call-memory-summary-add-global
                (compiler_optimize.opt-call-memory-summary-add-element 0)))
            0))
        25]
      [else 42])))

;; Does this guard block rebuild a module global's descriptor chain?
(define (opt-bce-mbcall-test-guard-has-global?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]) : bool
  (match (compiler_optimize.opt-cfg-find-block blocks label)
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [index : i64 0]
            [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
            [seen : bool false]
            (begin
              (while (< index count)
                (begin
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref
                    instrs
                    index)
                    [(compiler_ir_types.CompilerIrInstr.Gep _ base _ _)
                      (match base
                        [(compiler_ir_types.CompilerIrValue.Global sym)
                          (if (= sym (opt-bce-mbcall-test-global))
                            (set! seen true)
                            unit)]
                        [_ unit])]
                    [_ unit])
                  (set! index (+ index 1))))
              seen))])]))

(test
  bce-version-mbcall-clone
  (test.assert-i64-eq
    (compiler-optimize-bce-version-mbcall-self-test)
    42
    "a call-carrying counted loop versions when its callee cannot move a descriptor word"))

;; --- strided variable-base runtime boundary tests ---------------------------------
;;
;; Strided windows with a variable base: `base + scale*i + k` exactly at the
;; array end still passes the synthesized derived-seed guard, and every
;; in-bounds window computes the same result with or without versioning. A
;; window one past the end fails the guard and aborts on the checked slow
;; path; the inline harness has no way to assert aborts, so only correct
;; results are asserted here.
(define (opt-bce-sb-runtime-make [n : i64] [step : i64]) : (__tl_dyn-array i64)
  (let
    [out : (__tl_dyn-array i64) (array.make-array i64 n)]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref out i) (* i step))
          (set! i (+ i 1))))
      out)))

(define (opt-bce-sb-runtime-sum2
  [text : (__tl_dyn-array i64)]
  [base : i64]
  [count : i64]) : i64
  (let
    [i : i64 0]
    [acc : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! acc (+ acc (array-ref text (+ base (* i 2)))))
          (set! acc (+ acc (array-ref text (+ (+ base (* i 2)) 1))))
          (set! i (+ i 1))))
      acc)))

(define (opt-bce-sb-runtime-sum8
  [text : (__tl_dyn-array i64)]
  [base : i64]
  [count : i64]) : i64
  (let
    [i : i64 0]
    [acc : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! acc (+ acc (array-ref text (+ base (* i 8)))))
          (set! i (+ i 1))))
      acc)))

(define (opt-bce-sb-runtime-fill2
  [out : (__tl_dyn-array i64)]
  [base : i64]
  [count : i64]
  [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref out (+ base (* i 2))) value)
          (set! i (+ i 1))))
      unit)))

(define (opt-bce-sb-runtime-fill8
  [out : (__tl_dyn-array i64)]
  [base : i64]
  [count : i64]
  [value : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref out (+ base (* i 8))) value)
          (set! i (+ i 1))))
      unit)))

;; The CSR counting-fill shape: a strided variable-base token read (derivable)
;; feeding a data-indexed fill read+write (kept in the fast clone).
(define (opt-bce-sb-runtime-hist2
  [tokens : (__tl_dyn-array i64)]
  [fill : (__tl_dyn-array i64)]
  [base : i64]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (let
          [src : i64 (array-ref tokens (+ base (* i 2)))]
          (begin
            (set! (array-ref fill src) (+ (array-ref fill src) 1))
            (set! i (+ i 1)))))
      unit)))

(test
  bce-version-strided-runtime-load2-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 16 3)]
    (begin
      ;; base + 2*(count-1) + 1 == 15: the pair window ends exactly at the
      ;; array end, so the guard accepts at equality.
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 4 6)
        342
        "scale-2 pair window ending exactly at the array end")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 0 8)
        360
        "scale-2 whole array from a zero base")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 14 1)
        87
        "scale-2 single pair at the last slots")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum2 buf 4 0)
        0
        "scale-2 empty window"))))

(test
  bce-version-strided-runtime-load8-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 25 1)]
    (begin
      ;; base + 8*(count-1) == 24: the stride lands exactly on the last slot.
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 0 4)
        48
        "scale-8 window landing exactly on the last slot")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 1 3)
        27
        "scale-8 interior window")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 24 1)
        24
        "scale-8 single read at the last slot")
      (test.assert-i64-eq
        (opt-bce-sb-runtime-sum8 buf 3 0)
        0
        "scale-8 empty window"))))

(test
  bce-version-strided-runtime-store2-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 16 1)]
    (begin
      ;; base + 2*(count-1) == 14: the last store lands at the stride boundary.
      (opt-bce-sb-runtime-fill2 buf 4 6 7)
      (test.assert-i64-eq
        (array-ref buf 14)
        7
        "scale-2 store at the stride boundary")
      (test.assert-i64-eq
        (array-ref buf 15)
        15
        "slot past the stride untouched")
      (test.assert-i64-eq
        (array-ref buf 2)
        2
        "slot before the window untouched")
      (opt-bce-sb-runtime-fill2 buf 0 8 9)
      (test.assert-i64-eq (array-ref buf 0) 9 "scale-2 store from a zero base")
      (test.assert-i64-eq
        (array-ref buf 14)
        9
        "scale-2 boundary store from a zero base"))))

(test
  bce-version-strided-runtime-store8-boundary
  (let
    [buf : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 25 1)]
    (begin
      ;; base + 8*(count-1) == 24: the last store lands exactly on the last slot.
      (opt-bce-sb-runtime-fill8 buf 0 4 7)
      (test.assert-i64-eq (array-ref buf 24) 7 "scale-8 store on the last slot")
      (test.assert-i64-eq
        (array-ref buf 23)
        23
        "slot beside the stride untouched")
      (test.assert-i64-eq (array-ref buf 8) 7 "scale-8 interior stride slot")
      (opt-bce-sb-runtime-fill8 buf 1 3 9)
      (test.assert-i64-eq
        (array-ref buf 17)
        9
        "scale-8 store from a nonzero base")
      (test.assert-i64-eq
        (array-ref buf 18)
        18
        "slot past the nonzero stride untouched"))))

(test
  bce-version-strided-runtime-partial-hist
  (let
    [tokens : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 16 0)]
    [fill : (__tl_dyn-array i64) (opt-bce-sb-runtime-make 8 0)]
    (begin
      (set! (array-ref tokens 0) 7)
      (set! (array-ref tokens 2) 3)
      (set! (array-ref tokens 4) 7)
      (set! (array-ref tokens 6) 1)
      (set! (array-ref tokens 8) 3)
      (set! (array-ref tokens 10) 7)
      (set! (array-ref tokens 12) 2)
      (set! (array-ref tokens 14) 5)
      ;; base + 2*(count-1) == 14: the last token read is in bounds; the
      ;; fill checks ride along in the fast clone.
      (opt-bce-sb-runtime-hist2 tokens fill 0 8)
      (test.assert-i64-eq
        (array-ref fill 7)
        3
        "histogram slot 7 counted three hits")
      (test.assert-i64-eq
        (array-ref fill 3)
        2
        "histogram slot 3 counted two hits")
      (test.assert-i64-eq
        (array-ref fill 1)
        1
        "histogram slot 1 counted one hit")
      (test.assert-i64-eq
        (array-ref fill 2)
        1
        "histogram slot 2 counted one hit")
      (test.assert-i64-eq
        (array-ref fill 5)
        1
        "histogram slot 5 counted one hit")
      (test.assert-i64-eq (array-ref fill 0) 0 "histogram slot 0 stayed empty"))))

(define (opt-unroll-mb-read-only-test-body) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "read_only")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Load
          9
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "read_only_exit"))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

;; Build the exact CFG fragment produced by the production multiblock clone at
;; an absorbed call site, then leave a self tail call in its continuation. The
;; optimizer turns that tail call into an entry backedge. This combines the two
;; shapes that exposed the regression: a cloned, bounds-carrying inner loop and
;; an enclosing caller loop whose header is the function entry.
(define (opt-merged-loop-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "n"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "len"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        ;; Model the unchanged dynamic-array handle carried by the real
        ;; absorbed-call shape. Register-value SSA now renames this slot safely.
        (compiler_ir_types.CompilerIrParam.Param
          "base"
          (compiler_ast_types.AstType.DynArray 0)
          2)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "rounds"
            (compiler_ast_types.AstType.I64)
            3)
          (compiler_ir_types.CompilerIrParamList.Nil))))))

(define (opt-merged-loop-test-callee-args) : compiler_ir_types.CompilerIrCallArgs
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 3)]
    (begin
      (set! (array-ref args 0) (compiler_ir_types.CompilerIrValue.Var 0))
      (set! (array-ref args 1) (compiler_ir_types.CompilerIrValue.Var 1))
      (set! (array-ref args 2) (compiler_ir_types.CompilerIrValue.Var 2))
      (compiler_ir_types.CompilerIrCallArgs.Array args))))

(define (opt-merged-loop-test-tail-args [rounds : i64]) : compiler_ir_types.CompilerIrCallArgs
  (let
    [args : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 4)]
    (begin
      ;; The first three arguments are unchanged. Identity writes must not
      ;; survive the tail-recursion conversion plus register-value SSA pipeline.
      (set! (array-ref args 0) (compiler_ir_types.CompilerIrValue.Var 0))
      (set! (array-ref args 1) (compiler_ir_types.CompilerIrValue.Var 1))
      (set! (array-ref args 2) (compiler_ir_types.CompilerIrValue.Var 2))
      (set! (array-ref args 3) (compiler_ir_types.CompilerIrValue.Var rounds))
      (compiler_ir_types.CompilerIrCallArgs.Array args))))

(define (opt-merged-loop-test-callee-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (compiler_optimize.opt-ssa-construct-function
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_ir_types.CompilerIrFunction.Function
        (opt-test-symbol "merged_loop_callee")
        (opt-bce-version-test-params)
        (compiler_ast_types.AstType.I64)
        9
        (opt-bce-mb-pipeline-blocks)))))

(define (opt-merged-loop-test-function) : compiler_ir_types.CompilerIrFunction
  (let
    [name : i64 (opt-test-symbol "merged_loop_caller")]
    [prefix : String "inl.absorbed.0"]
    [cont : i64 (compiler_ir_types.compiler-ir-label "inl.absorbed.0.cont")]
    (match (compiler_optimize.opt-inline-clone-multiblock-blocks
      (opt-merged-loop-test-callee-blocks)
      prefix
      cont
      ;; The tail-call result slot base production would hand this clone:
      ;; base 5 + (callee frame 9 - 3 params). This callee carries no tail
      ;; call, so no block reads it.
      11
      (opt-merged-loop-test-callee-args)
      3
      5)
      [(compiler_optimize.OptInlineMultiClone.Clone cloned return-inputs)
        (let
          [entry-blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "entry")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    4
                    (compiler_ir_types.CompilerIrBinOp.Gt)
                    (compiler_ir_types.CompilerIrValue.Var 3)
                    (compiler_ir_types.CompilerIrValue.I64 0)
                    (compiler_ast_types.AstType.Bool))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "call_site")
                    (compiler_ir_types.compiler-ir-label "caller_exit"))))
              (compiler_ir_types.compiler-ir-block-cons
                (opt-bce-mb-test-jump-block
                  (compiler_ir_types.compiler-ir-label "call_site")
                  (compiler_ir_types.compiler-ir-label "inl.absorbed.0.entry"))
                (compiler_ir_types.CompilerIrBlockList.Nil)))]
          [tail-blocks : compiler_ir_types.CompilerIrBlockList
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                cont
                (opt-test-instrs
                  (compiler_optimize.opt-inline-cont-result-instr
                    100
                    return-inputs
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    101
                    (compiler_ir_types.CompilerIrBinOp.Sub)
                    (compiler_ir_types.CompilerIrValue.Var 3)
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.TailCall
                    name
                    (opt-merged-loop-test-tail-args 101)
                    (compiler_ast_types.AstType.I64))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "caller_exit")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.I64 0)))))
                (compiler_ir_types.CompilerIrBlockList.Nil)))]
          (compiler_ir_types.CompilerIrFunction.Function
            name
            (opt-merged-loop-test-params)
            (compiler_ast_types.AstType.I64)
            102
            (compiler_optimize.opt-inline-block-append
              entry-blocks
              (compiler_optimize.opt-inline-block-append cloned tail-blocks))))])))

;; The unroller's multi-block companion must pick up the check-free versioned
;; diamond on a later optimizer iteration (after its dedicated preheader has
;; been synthesized), peel the odd iteration, and emit exactly two body copies.
(define (compiler-optimize-unroll-mb-self-test) : i64
  (let
    [optimized : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.CompilerIrFunction.Function
          (opt-test-symbol "unroll_mb_while_fixture")
          (opt-bce-version-test-params)
          (compiler_ast_types.AstType.I64)
          9
          (opt-bce-mb-pipeline-blocks)))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks optimized)]
    [merged : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-merged-loop-test-function))]
    [merged-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks merged)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function optimized)))
        1]
      [(not
          (opt-block-list-has-label?
            blocks
            (compiler_ir_types.compiler-ir-label
              "body__bce_fast__unroll2_guard")))
        2]
      ;; Arm-local swap/update work is deliberately not if-converted: both
      ;; four-block unrolled diamonds remain intact.
      [(not (= (opt-bce-mb-test-matching-blocks blocks "__unroll2_0" 0) 4)) 3]
      [(not (= (opt-bce-mb-test-matching-blocks blocks "__unroll2_1" 0) 4)) 4]
      ;; The original fast peel and both pair copies remain check-free; the
      ;; slow original still carries both aborting checks.
      [(not (= (opt-bce-mb-test-matching-checks blocks "__unroll2" 0) 0)) 5]
      [(not (= (opt-bce-mb-test-matching-checks blocks "__bce_fast" 0) 0)) 6]
      [(< (opt-bce-version-test-prefix-checks blocks "" 0) 2) 7]
      ;; The profitability gate rejects read-only diamonds; StorePtr is
      ;; admitted only on this proven-fast path, while calls and checks
      ;; themselves remain outside the cloning whitelist.
      [(not
          (=
            (compiler_optimize.opt-unroll-mb-body-status
              (opt-unroll-mb-read-only-test-body))
            0))
        8]
      [(not
          (compiler_optimize.opt-unroll-mb-body-instr-ok?
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))))
        9]
      [(compiler_optimize.opt-unroll-mb-body-instr-ok?
          (compiler_ir_types.CompilerIrInstr.Call
            0
            (opt-test-symbol "unroll_mb_callee")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.I64)))
        10]
      [(compiler_optimize.opt-unroll-mb-body-instr-ok?
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "unroll_mb_check")))
        11]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function merged)))
        12]
      [(not
          (opt-block-list-has-label?
            merged-blocks
            (compiler_ir_types.compiler-ir-label "entry__ssa_entry")))
        13]
      [(not
          (opt-block-list-has-label?
            merged-blocks
            (compiler_ir_types.compiler-ir-label
              "inl.absorbed.0.body__bce_fast__unroll2_guard")))
        14]
      [(not
          (= (opt-bce-mb-test-matching-blocks merged-blocks "__unroll2_0" 0) 4))
        15]
      [(not
          (= (opt-bce-mb-test-matching-blocks merged-blocks "__unroll2_1" 0) 4))
        16]
      [(not
          (= (opt-bce-mb-test-matching-checks merged-blocks "__bce_fast" 0) 0))
        17]
      [else 42])))

;; --- pre-existing-phi SSA construction self-test --------------------------------
;; A value-if join lowers to a Phi while `set!` locals stay multi-def Movs, so
;; the function reaches SSA construction with BOTH pre-existing phis and rename
;; candidates. Construction must rename the phi's inputs per edge; a phi whose
;; DST is itself multi-def must reject (function left non-SSA).
(define (opt-ssa-preexisting-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.CompilerIrParamList.Nil)))

(define (opt-ssa-preexisting-test-blocks [dup-phi-dst : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Mov
          (if dup-phi-dst
            4
            5)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              3
              (compiler_ir_types.CompilerIrValue.I64 11)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                4
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 3)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 3)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Mov
                2
                (compiler_ir_types.CompilerIrValue.I64 9)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.BinOp
                6
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 6)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-ssa-preexisting-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "ssa_preexisting_phi")
    (opt-ssa-preexisting-test-params)
    (compiler_ast_types.AstType.I64)
    7
    blocks))

(define (opt-ssa-preexisting-test-first-phi-inputs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]) : compiler_ir_types.CompilerIrValueSeq
  (if (>= index count)
    (compiler_ir_types.compiler-ir-value-seq-empty)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
        (match (compiler_ir_types.compiler-ir-phi-input-list-force-cons inputs)
          [(compiler_ir_types.CompilerIrPhiInputList.Cons a _ rest)
            (match (__tl-box-place rest)
              [(compiler_ir_types.CompilerIrPhiInputList.Cons b _ _)
                (compiler_ir_types.compiler-ir-value-seq2 a b)]
              [_ (compiler_ir_types.compiler-ir-value-seq-empty)])]
          [_ (compiler_ir_types.compiler-ir-value-seq-empty)])]
      [_ (opt-ssa-preexisting-test-first-phi-inputs instrs (+ index 1) count)])))

;; The join block's first phi's two inputs; Nil when missing.
(define (opt-ssa-preexisting-test-phi-inputs
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrValueSeq
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label "join"))
    [(compiler_optimize.OptMaybeBlock.No)
      (compiler_ir_types.compiler-ir-value-seq-empty)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-ssa-preexisting-test-first-phi-inputs
            instrs
            0
            (compiler_ir_types.compiler-ir-instr-seq-count instrs))])]))

(define (compiler-optimize-ssa-preexisting-phi-self-test) : i64
  (let
    [constructed : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-preexisting-test-function
          (opt-ssa-preexisting-test-blocks false)))]
    [rejected : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-ssa-construct-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-ssa-preexisting-test-function
          (opt-ssa-preexisting-test-blocks true)))]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function constructed)))
        1]
      ;; the pre-existing join phi reads the then/else VERSIONS of var 3: two
      ;; Var inputs that differ from each other (unrewritten would be 3 == 3).
      [(let
          [values : compiler_ir_types.CompilerIrValueSeq
            (opt-ssa-preexisting-test-phi-inputs
              (compiler_optimize.opt-function-blocks constructed))]
          (if (= values.len 2)
            (match (compiler_ir_types.compiler-ir-value-seq-ref values 0)
              [(compiler_ir_types.CompilerIrValue.Var av)
                (match (compiler_ir_types.compiler-ir-value-seq-ref values 1)
                  [(compiler_ir_types.CompilerIrValue.Var bv) (= av bv)]
                  [_ true])]
              [_ true])
            true))
        2]
      ;; a multi-def phi DST rejects: the function stays non-SSA.
      [(compiler_optimize.opt-verify-ok?
          (compiler_optimize.opt-verify-function rejected))
        3]
      [else 42])))

;; --- multi-exit loop LICM self-test ---------------------------------------------
;; A probe-shaped search loop (guarded header, bounds check, early-return side
;; exit) must still hoist its loop-invariant ptr/len loads; adding an in-loop
;; store must block the hoist.
(define (opt-licm-multi-exit-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "map"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "key"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "limit"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

(define (opt-licm-multi-exit-header-block) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "header")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        3
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.compiler-ir-label "next")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Phi
        4
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 11)
            (compiler_ir_types.compiler-ir-label "next")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.compiler-ir-label "body")
        (compiler_ir_types.compiler-ir-label "exit")))))

(define (opt-licm-multi-exit-body-tail [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Gep
      12
      (compiler_ir_types.CompilerIrValue.Var 9)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      13
      (compiler_ir_types.CompilerIrValue.Var 12)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      14
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 13)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.Bool))
    (if (= mode 0)
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "next"))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 14)
        (compiler_ir_types.compiler-ir-label "found")
        (compiler_ir_types.compiler-ir-label "next")))))

(define (opt-licm-multi-exit-body-block [mode : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs-with-tail
      (opt-licm-multi-exit-body-tail mode)
      (compiler_ir_types.CompilerIrInstr.Gep
        6
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        7
        (compiler_ir_types.CompilerIrValue.Var 6)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ir_types.compiler-ir-label "licm_multi_exit_ok"))
      (compiler_ir_types.CompilerIrInstr.Gep
        8
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        9
        (compiler_ir_types.CompilerIrValue.Var 8)
        (compiler_ast_types.AstType.I64)))))

(define (opt-licm-multi-exit-next-block [with-store : bool]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "next")
    (opt-test-instrs-with-tail
      (if with-store
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 12)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "header")))
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "header"))))
      (compiler_ir_types.CompilerIrInstr.BinOp
        10
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        11
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64)))))

(define (opt-licm-multi-exit-found-block [mode : i64]) : compiler_ir_types.CompilerIrBlock
  (if (= mode 1)
    ;; return-shaped side exit: a found handler locates the slot (bounded
    ;; memory work) and returns -- still a short-trip SEARCH, so the invariant
    ;; load hoist is suppressed (the put! shape: gep/load/store then return).
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "found")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Load
          16
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 12)
          (compiler_ir_types.CompilerIrValue.Var 16)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 16)))))
    ;; break-shaped side exit: the continuation calls out to unbounded work,
    ;; marking a long-trip kernel -- the hoist stays.
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "found")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Call
          16
          (opt-test-symbol "licm_multi_exit_callee")
          (compiler_ir_types.CompilerIrCallArgs.Nil)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 16)))))))

(define (opt-licm-multi-exit-tail-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [exit-block : compiler_ir_types.CompilerIrBlock
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "exit")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 0)))))]
    (if (= mode 0)
      (compiler_ir_types.compiler-ir-block-cons
        exit-block
        (compiler_ir_types.CompilerIrBlockList.Nil))
      (compiler_ir_types.compiler-ir-block-cons
        (opt-licm-multi-exit-found-block mode)
        (compiler_ir_types.compiler-ir-block-cons
          exit-block
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-licm-multi-exit-test-blocks [mode : i64] [with-store : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-licm-multi-exit-header-block)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-licm-multi-exit-body-block mode)
        (compiler_ir_types.compiler-ir-block-cons
          (opt-licm-multi-exit-next-block with-store)
          (opt-licm-multi-exit-tail-blocks mode))))))

(define (opt-licm-multi-exit-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "licm_multi_exit")
    (opt-licm-multi-exit-test-params)
    (compiler_ast_types.AstType.I64)
    17
    blocks))

(define (opt-licm-multi-exit-count-loads-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-licm-multi-exit-count-loads-seq
      instrs
      (+ index 1)
      count
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Load _ _ _) (+ acc 1)]
        [_ acc]))))

(define (opt-licm-multi-exit-count-loads
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label-want : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block blocks label-want)
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-licm-multi-exit-count-loads-seq
            instrs
            0
            (compiler_ir_types.compiler-ir-instr-seq-count instrs)
            0)])]))

(define (compiler-optimize-licm-multi-exit-self-test) : i64
  (let
    [single : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-licm-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 0 false)))]
    [single-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks single)]
    [ret-exit : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-licm-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 1 false)))]
    [ret-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks ret-exit)]
    [brk-exit : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-licm-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 2 false)))]
    [brk-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks brk-exit)]
    [stored : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-licm-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-licm-multi-exit-test-function
          (opt-licm-multi-exit-test-blocks 0 true)))]
    [stored-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks stored)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function single)))
        1]
      ;; single-exit search loop: the invariant ptr/len loads hoist; only the
      ;; varying element load stays in the body.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              single-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        2]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              single-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        3]
      ;; a RETURN-SHAPED side exit (early-return probe that does bounded
      ;; gep/load/store work then returns -- the put! shape) suppresses the
      ;; load hoist: short trips make it pure register pressure (see the
      ;; measured note at opt-licm-apply-loop).
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              ret-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            3))
        4]
      ;; a BREAK-shaped side exit (continuation calls out to unbounded work)
      ;; marks a long-trip kernel: the hoist stays.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              brk-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        5]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              brk-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        6]
      ;; an in-loop store blocks the hoist entirely.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              stored-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            3))
        7]
      [else 42])))

;; --- descriptor-header hoist past the return-shaped suppression ---------------
;;
;; The probe-shaped side-exit suppression (opt-licm-apply-loop) is a
;; profitability gate: descriptor header loads (data-pointer and length slots
;; of a loop-invariant array handle) are excepted from it in the late licm
;; when the loop body cannot write a descriptor header. This shape mirrors
;; opt-licm-multi-exit-test-blocks but with an array-typed parameter: a
;; guarded counted loop whose body bounds-checks against the descriptor
;; length, reads an element through the descriptor data pointer, and exits
;; early through a RETURN-shaped side exit. Poison variants: 0 = clean body,
;; 1 = unknown call in the latch, 2 = store through an unknown pointer,
;; 3 = store through the loaded element pointer (an element-only store, which
;; must NOT block the header hoist).
(define (opt-licm-dh-test-params) : compiler_ir_types.CompilerIrParamList
  (compiler_ir_types.compiler-ir-param-cons
    (compiler_ir_types.CompilerIrParam.Param
      "array"
      (compiler_ast_types.AstType.DynArray 0)
      0)
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "key"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "limit"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.CompilerIrParamList.Nil)))))

(define (opt-licm-dh-header-block [variant-base? : bool]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "header")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Phi
        3
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.compiler-ir-label "next")
            (compiler_ir_types.CompilerIrPhiInputList.Nil)))
        (compiler_ast_types.AstType.I64))
      (if variant-base?
        (compiler_ir_types.CompilerIrInstr.Phi
          16
          (compiler_ir_types.compiler-ir-phi-input-cons
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-phi-input-cons
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "next")
              (compiler_ir_types.CompilerIrPhiInputList.Nil)))
          (compiler_ast_types.AstType.DynArray 0))
        (compiler_ir_types.CompilerIrInstr.Mov
          16
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64)))
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.compiler-ir-label "body")
        (compiler_ir_types.compiler-ir-label "exit")))))

(define (opt-licm-dh-body-block [variant-base? : bool]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "body")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Gep
        6
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        7
        (compiler_ir_types.CompilerIrValue.Var 6)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BoundsCheck
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ir_types.compiler-ir-label "licm_dh_ok"))
      (compiler_ir_types.CompilerIrInstr.Gep
        8
        (compiler_ir_types.CompilerIrValue.Var
          (if variant-base?
            16
            0))
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        9
        (compiler_ir_types.CompilerIrValue.Var 8)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Gep
        12
        (compiler_ir_types.CompilerIrValue.Var 9)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.Load
        13
        (compiler_ir_types.CompilerIrValue.Var 12)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.BinOp
        14
        (compiler_ir_types.CompilerIrBinOp.Eq)
        (compiler_ir_types.CompilerIrValue.Var 13)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 14)
        (compiler_ir_types.compiler-ir-label "found")
        (compiler_ir_types.compiler-ir-label "next")))))

(define (opt-licm-dh-next-block [poison : i64]) : compiler_ir_types.CompilerIrBlock
  (compiler_ir_types.CompilerIrBlock.Block
    (compiler_ir_types.compiler-ir-label "next")
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.BinOp
        10
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (cond
        [(= poison 1)
          (compiler_ir_types.CompilerIrInstr.Call
            15
            (opt-test-symbol "licm_dh_callee")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.I64))]
        [(= poison 2)
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.Var 13)
            (compiler_ast_types.AstType.I64))]
        [(= poison 3)
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 12)
            (compiler_ir_types.CompilerIrValue.Var 13)
            (compiler_ast_types.AstType.I64))]
        [else
          (compiler_ir_types.CompilerIrInstr.Mov
            15
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))])
      (compiler_ir_types.CompilerIrInstr.Jump
        (compiler_ir_types.compiler-ir-label "header")))))

(define (opt-licm-dh-test-blocks [poison : i64] [variant-base? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "header"))))
    (compiler_ir_types.compiler-ir-block-cons
      (opt-licm-dh-header-block variant-base?)
      (compiler_ir_types.compiler-ir-block-cons
        (opt-licm-dh-body-block variant-base?)
        (compiler_ir_types.compiler-ir-block-cons
          (opt-licm-dh-next-block poison)
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "found")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 13)))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 0)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

(define (opt-licm-dh-test-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "licm_dh")
    (opt-licm-dh-test-params)
    (compiler_ast_types.AstType.I64)
    17
    blocks))

(define (opt-licm-dh-late-optimized-function
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrFunction
  (let
    [func : compiler_ir_types.CompilerIrFunction
      (opt-licm-dh-test-function blocks)]
    (match (compiler_optimize.opt-licm-function-with-context-result-and-direct-call-clean
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-cfg-context-build blocks)
      false
      (opt_i64_i64_map.with-capacity 1)
      (opt_i64_i64_map.with-capacity 1)
      (compiler_optimize.opt-global-cell-summary-empty)
      true
      func)
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

(define (compiler-optimize-licm-dh-self-test) : i64
  (let
    [early : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-licm-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-licm-dh-test-function (opt-licm-dh-test-blocks 0 false)))]
    [early-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks early)]
    [clean : compiler_ir_types.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 0 false))]
    [clean-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks clean)]
    [called : compiler_ir_types.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 1 false))]
    [called-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks called)]
    [stored : compiler_ir_types.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 2 false))]
    [stored-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks stored)]
    [elem : compiler_ir_types.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 3 false))]
    [elem-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks elem)]
    [varbase : compiler_ir_types.CompilerIrFunction
      (opt-licm-dh-late-optimized-function (opt-licm-dh-test-blocks 0 true))]
    [varbase-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks varbase)]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function clean)))
        1]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function elem)))
        2]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function varbase)))
        3]
      ;; late licm, clean body: both descriptor header loads (length AND
      ;; data-pointer) leave the return-shaped-exit loop; only the varying
      ;; element load stays.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              clean-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        4]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              clean-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        5]
      ;; the PRE-BCE licm keeps the suppression: moving descriptor facts that
      ;; early can hide the bound identity bce still needs.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              early-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            3))
        6]
      ;; an unknown call in the body blocks the exception.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              called-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            3))
        7]
      ;; a store through an unknown pointer (a header-or-unknown store) blocks
      ;; the exception.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              stored-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            3))
        8]
      ;; an element-only store through the loaded data pointer does NOT block
      ;; it: element storage is disjoint from descriptor header words.
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              elem-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            1))
        9]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              elem-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            2))
        10]
      ;; a loop-variant descriptor base keeps its data-pointer load in the
      ;; body (the invariant length load still hoists).
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              varbase-blocks
              (compiler_ir_types.compiler-ir-label "body"))
            2))
        11]
      [(not
          (=
            (opt-licm-multi-exit-count-loads
              varbase-blocks
              (compiler_ir_types.compiler-ir-label "entry"))
            1))
        12]
      [else 42])))

(test
  licm-descriptor-header-hoist
  (test.assert-i64-eq
    (compiler-optimize-licm-dh-self-test)
    42
    "late licm hoists descriptor header loads from a header-write-free loop past the return-shaped suppression"))

;; Runtime witnesses for the hoisted data-pointer semantics: reads through the
;; descriptor must return the right values, and an element store in the loop
;; must be observed by the element reads (only the header load moves; element
;; loads stay in the body -- the IR-level poison-3 case stores through the
;; loaded element pointer, an alias of the hoisted header's data pointer).
(define (opt-licm-dh-runtime-sum
  [arr : (__tl_dyn-array i64)]
  [n : i64]
  [stop : i64]) : i64
  (let
    [i : i64 0]
    [ok : bool true]
    [acc : i64 0]
    (begin
      (while (and (< i n) ok)
        (begin
          (set! acc (+ acc (array-ref arr i)))
          (if (= (array-ref arr i) stop)
            (set! ok false)
            unit)
          (set! i (+ i 1))))
      acc)))

;; Store at i, accumulate the mirror slot n-1-i: the middle iteration reads a
;; slot stored by an earlier iteration, so the stores must be observed through
;; whatever pointer the loads use.
(define (opt-licm-dh-runtime-alias-store [arr : (__tl_dyn-array i64)] [n : i64]) : i64
  (let
    [i : i64 0]
    [ok : bool true]
    [acc : i64 0]
    (begin
      (while (and (< i n) ok)
        (begin
          (set! (array-ref arr i) (+ (array-ref arr i) 1))
          (set! acc (+ acc (array-ref arr (- (- n 1) i))))
          (if (< (array-ref arr (- (- n 1) i)) 0)
            (set! ok false)
            unit)
          (set! i (+ i 1))))
      acc)))

(test
  licm-descriptor-header-runtime
  (let
    [arr : (__tl_dyn-array i64) (array.make-array i64 8)]
    [work : (__tl_dyn-array i64) (array.make-array i64 5)]
    (begin
      (set! (array-ref arr 0) 3)
      (set! (array-ref arr 1) 1)
      (set! (array-ref arr 2) 4)
      (set! (array-ref arr 3) 1)
      (set! (array-ref arr 4) 5)
      (set! (array-ref arr 5) 9)
      (set! (array-ref arr 6) 2)
      (set! (array-ref arr 7) 6)
      (test.assert-i64-eq
        (opt-licm-dh-runtime-sum arr 8 100)
        31
        "flag-exit loop over the descriptor data pointer sums every element")
      (test.assert-i64-eq
        (opt-licm-dh-runtime-sum arr 8 4)
        8
        "the early flag exit keeps the partial sum")
      (set! (array-ref work 1) 1)
      (set! (array-ref work 2) 2)
      (set! (array-ref work 3) 3)
      (set! (array-ref work 4) 4)
      (test.assert-i64-eq
        (opt-licm-dh-runtime-alias-store work 5)
        13
        "element reads observe the loop's earlier element stores")
      (test.assert-i64-eq
        (array-ref work 3)
        4
        "each element store landed exactly once"))))

;; The compatibility ownership model still permits a by-value dynamic-array
;; handle to be representation-copied. The original and returned handles can
;; therefore supply overlapping `&` and `&mut` parameters even though their SSA
;; parameter vars differ. LICM must not use those different vars as noalias
;; evidence. These are executable witnesses for both a direct object-slot load
;; and a nested owning-descriptor load chain.
(defstruct OptLicmCompatDirectHolder
  (value i64))

(define (opt-licm-compat-alias-direct
  [items : (__tl_dyn-array OptLicmCompatDirectHolder)]) : (__tl_dyn-array
    OptLicmCompatDirectHolder)
  items)

(define (opt-licm-compat-overwrite-and-read
  [view : (& OptLicmCompatDirectHolder)]
  [items : (&mut (__tl_dyn-array OptLicmCompatDirectHolder))]) : i64
  (let
    [i : i64 0]
    [sum : i64 0]
    (begin
      (while (< i 2)
        (begin
          (set! (array-ref items 0) (OptLicmCompatDirectHolder (+ i 10)))
          (set! sum (+ sum view.value))
          (set! i (+ i 1))))
      sum)))

(define (opt-licm-compat-direct-result) : i64
  (let
    [items : (__tl_dyn-array OptLicmCompatDirectHolder)
      (array.make-array OptLicmCompatDirectHolder 1)]
    (begin
      (set! (array-ref items 0) (OptLicmCompatDirectHolder 1))
      (let
        [alias : (__tl_dyn-array OptLicmCompatDirectHolder)
          (opt-licm-compat-alias-direct items)]
        (opt-licm-compat-overwrite-and-read
          (& (array-ref items 0))
          (&mut alias))))))

(defstruct OptLicmCompatNestedHolder
  (items (__tl_dyn-array i64)))

(define (opt-licm-compat-alias-nested
  [items : (__tl_dyn-array OptLicmCompatNestedHolder)]) : (__tl_dyn-array
    OptLicmCompatNestedHolder)
  items)

(define (opt-licm-compat-replace-and-read-inner
  [view : (& OptLicmCompatNestedHolder)]
  [holders : (&mut (__tl_dyn-array OptLicmCompatNestedHolder))]
  [replacement : (__tl_dyn-array i64)]) : i64
  (let
    [i : i64 0]
    [result : i64 0]
    (begin
      (while (< i 1)
        (begin
          (set! (array-ref holders 0) (OptLicmCompatNestedHolder replacement))
          (set! result (array-ref view.items 0))
          (set! i (+ i 1))))
      result)))

(define (opt-licm-compat-nested-result) : i64
  (let
    [old-items : (__tl_dyn-array i64) (array.make-array i64 1)]
    [new-items : (__tl_dyn-array i64) (array.make-array i64 1)]
    [holders : (__tl_dyn-array OptLicmCompatNestedHolder)
      (array.make-array OptLicmCompatNestedHolder 1)]
    (begin
      (set! (array-ref old-items 0) 10)
      (set! (array-ref new-items 0) 20)
      (set! (array-ref holders 0) (OptLicmCompatNestedHolder old-items))
      (let
        [alias : (__tl_dyn-array OptLicmCompatNestedHolder)
          (opt-licm-compat-alias-nested holders)]
        (opt-licm-compat-replace-and-read-inner
          (& (array-ref holders 0))
          (&mut alias)
          new-items)))))

(test
  licm-compatibility-root-alias
  (begin
    (test.assert-i64-eq
      (opt-licm-compat-direct-result)
      21
      "direct shared/exclusive compatibility aliases observe each store")
    (test.assert-i64-eq
      (opt-licm-compat-nested-result)
      20
      "nested owning-handle compatibility aliases observe replacement")))

(test
  licm-root-disjointness
  (begin
    (test.assert-true
      (compiler_optimize.opt-licm-root-disjoint-store?
        (compiler_optimize.OptLicmRoot.Fresh 1)
        (compiler_optimize.OptLicmRoot.Fresh 2))
      "different fresh allocations are disjoint")
    (test.assert-true
      (compiler_optimize.opt-licm-root-disjoint-store?
        (compiler_optimize.OptLicmRoot.Exclusive 1)
        (compiler_optimize.OptLicmRoot.Fresh 2))
      "a fresh allocation is disjoint from caller storage")
    (test.assert-false
      (compiler_optimize.opt-licm-root-disjoint-store?
        (compiler_optimize.OptLicmRoot.Exclusive 1)
        (compiler_optimize.OptLicmRoot.Exclusive 2))
      "different mutable reference parameters may compatibility-alias")
    (test.assert-false
      (compiler_optimize.opt-licm-root-disjoint-store?
        (compiler_optimize.OptLicmRoot.Exclusive 1)
        (compiler_optimize.OptLicmRoot.Shared 2))
      "shared and mutable reference parameters may compatibility-alias")))

;; --- affine chain folding self-test -------------------------------------------
;; Emulates the x4 unroller's output: an LCG chain `((x*5+3)*5+3)*5+3` must
;; collapse so the last pair reads `x*125` and `+93`, and a counter chain
;; `((x+1)+1)-? ` must rebase every link onto x. Negative: a two-use mul stays.
(define (opt-affine-test-binop-shape?
  [block : compiler_ir_types.CompilerIrBlock]
  [index : i64]
  [want-dst : i64]
  [want-mul : bool]
  [want-src : i64]
  [want-const : i64]) : bool
  (match block
    [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs _)
          (and
            (= dst want-dst)
            (match op
              [(compiler_ir_types.CompilerIrBinOp.Mul) want-mul]
              [(compiler_ir_types.CompilerIrBinOp.Add) (not want-mul)]
              [_ false])
            (match lhs
              [(compiler_ir_types.CompilerIrValue.Var v) (= v want-src)]
              [_ false])
            (match rhs
              [(compiler_ir_types.CompilerIrValue.I64 k) (= k want-const)]
              [_ false]))]
        [_ false])]))

(define (opt-affine-test-first-block
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlock
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Cons block _) block]
    [_
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "missing")
        (compiler_ir_types.compiler-ir-instr-seq-empty))]))

(define (opt-affine-lcg-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          3
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          4
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          5
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          6
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 5)
          (compiler_ir_types.CompilerIrValue.I64 5)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          7
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 7)))))
    (compiler_ir_types.CompilerIrBlockList.Nil)))

