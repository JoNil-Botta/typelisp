(define (opt-test-bounds-instrs
  [type-segment-bases : i64]
  [facts : compiler_optimize.OptBoundsFacts]
  [casts : compiler_optimize.OptBoundsCastEnv]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [result : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instr-seq-copy instrs)]
    (begin
      (compiler_optimize.opt-bounds-instrs!
        type-segment-bases
        facts
        casts
        (&mut result))
      result)))

(test
  switch-copy-env-indexed-semantics
  (let
    [env : compiler_optimize.OptSwitchCopyEnv
      (compiler_optimize.OptSwitchCopyEnv.Empty)]
    (begin
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 12)
        12
        "a missing destination resolves to itself")
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env (- 0 1))
        (- 0 1)
        "a negative sentinel stays out of the dense table")
      (set!
        env
        (compiler_optimize.opt-switch-copy-env-note
          env
          (compiler_ir_types.CompilerIrInstr.Mov
            64
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ast_types.AstType.I64))))
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 64)
        7
        "a high destination grows the direct table")
      (set!
        env
        (compiler_optimize.opt-switch-copy-env-note
          env
          (compiler_ir_types.CompilerIrInstr.Mov
            64
            (compiler_ir_types.CompilerIrValue.Var 8)
            (compiler_ast_types.AstType.I64))))
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 64)
        8
        "the newest destination binding replaces the old source")
      (set!
        env
        (compiler_optimize.opt-switch-copy-env-note
          env
          (compiler_ir_types.CompilerIrInstr.Mov
            65
            (compiler_ir_types.CompilerIrValue.Var 8)
            (compiler_ast_types.AstType.I64))))
      (set!
        env
        (compiler_optimize.opt-switch-copy-env-note
          env
          (compiler_ir_types.CompilerIrInstr.Mov
            70
            (compiler_ir_types.CompilerIrValue.Var 9)
            (compiler_ast_types.AstType.I64))))
      (set!
        env
        (compiler_optimize.opt-switch-copy-env-note
          env
          (compiler_ir_types.CompilerIrInstr.Mov
            8
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))))
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 64)
        64
        "redefining a source drops the first dependent destination")
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 65)
        65
        "source invalidation drops every dependent destination")
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 70)
        9
        "source invalidation preserves unrelated destinations")
      (set!
        env
        (compiler_optimize.opt-switch-copy-env-note
          env
          (compiler_ir_types.CompilerIrInstr.Mov
            70
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))))
      (test.assert-i64-eq
        (compiler_optimize.opt-switch-copy-env-resolve env 70)
        70
        "a non-copy destination redefinition drops its stale fact"))))

(test
  bounds-cast-env-indexed-semantics
  (let
    [env : compiler_optimize.OptBoundsCastEnv
      (compiler_optimize.OptBoundsCastEnv.Empty)]
    (begin
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 12))
          (compiler_ir_types.CompilerIrValue.Var 12))
        "a missing destination canonicalizes to itself")
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var (- 0 1)))
          (compiler_ir_types.CompilerIrValue.Var (- 0 1)))
        "a negative var stays out of the dense table")
      (set!
        env
        (compiler_optimize.opt-bounds-cast-bind
          env
          64
          (compiler_ir_types.CompilerIrValue.Var 7)))
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 64))
          (compiler_ir_types.CompilerIrValue.Var 7))
        "a high destination grows the direct table")
      (set!
        env
        (compiler_optimize.opt-bounds-cast-bind
          env
          64
          (compiler_ir_types.CompilerIrValue.Var 8)))
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 64))
          (compiler_ir_types.CompilerIrValue.Var 8))
        "the newest destination binding replaces the old source")
      (set!
        env
        (compiler_optimize.opt-bounds-cast-bind
          env
          65
          (compiler_ir_types.CompilerIrValue.Var 8)))
      (set!
        env
        (compiler_optimize.opt-bounds-cast-bind
          env
          70
          (compiler_ir_types.CompilerIrValue.Var 9)))
      (set! env (compiler_optimize.opt-bounds-cast-unbind env 8))
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 64))
          (compiler_ir_types.CompilerIrValue.Var 64))
        "source invalidation drops the first dependent destination")
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 65))
          (compiler_ir_types.CompilerIrValue.Var 65))
        "source invalidation drops every dependent destination")
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 70))
          (compiler_ir_types.CompilerIrValue.Var 9))
        "source invalidation preserves unrelated destinations")
      (set!
        env
        (compiler_optimize.opt-bounds-cast-bind
          env
          512
          (compiler_ir_types.CompilerIrValue.I64 33)))
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 512))
          (compiler_ir_types.CompilerIrValue.I64 33))
        "table growth preserves non-var sources")
      (set!
        env
        (compiler_optimize.opt-bounds-cast-bind
          env
          71
          (compiler_ir_types.CompilerIrValue.Var 70)))
      (set! env (compiler_optimize.opt-bounds-cast-unbind env 70))
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 70))
          (compiler_ir_types.CompilerIrValue.Var 70))
        "destination invalidation drops its stale binding")
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 71))
          (compiler_ir_types.CompilerIrValue.Var 71))
        "destination invalidation also drops its dependents")
      (test.assert-true
        (compiler_optimize.opt-value-eq
          (compiler_optimize.opt-bounds-cast-canon
            env
            (compiler_ir_types.CompilerIrValue.Var 512))
          (compiler_ir_types.CompilerIrValue.I64 33))
        "compaction preserves later unrelated destinations"))))

;; #6061: force every converted dense family past its initial capacity and
;; pin the logical newest-first/LIFO semantics that the former Cons chains had.
(define (opt-dense-test-licm-roots
  [roots : compiler_optimize.OptLicmStoreRootList]
  [next : i64]
  [last : i64]) : compiler_optimize.OptLicmStoreRootList
  (if (> next last)
    roots
    (opt-dense-test-licm-roots
      (compiler_optimize.opt-licm-store-roots-add
        roots
        (compiler_optimize.OptLicmRoot.Fresh next))
      (+ next 1)
      last)))

(define (opt-dense-test-unroll-memories
  [type-segment-bases : i64]
  [memories : compiler_optimize.OptUnrollSimdMemoryList]
  [next : i64]
  [last : i64]) : compiler_optimize.OptUnrollSimdMemoryList
  (if (> next last)
    memories
    (opt-dense-test-unroll-memories
      type-segment-bases
      (compiler_optimize.opt-unroll-simd-memory-add
        type-segment-bases
        memories
        (compiler_ir_types.CompilerIrValue.Var next)
        (compiler_ast_types.AstType.I64))
      (+ next 1)
      last)))

(define (opt-dense-test-late-drops
  [drops : compiler_optimize.OptLateBoundsPairDrop]
  [next : i64]
  [last : i64]) : compiler_optimize.OptLateBoundsPairDrop
  (if (> next last)
    drops
    (opt-dense-test-late-drops
      (compiler_optimize.opt-late-bounds-pair-drops-add drops next)
      (+ next 1)
      last)))

(define (opt-dense-test-reach-push
  [worklist : compiler_optimize.OptReachWorklist]
  [next : i64]
  [last : i64]) : compiler_optimize.OptReachWorklist
  (if (> next last)
    worklist
    (opt-dense-test-reach-push
      (compiler_optimize.opt-reach-worklist-push worklist next)
      (+ next 1)
      last)))

(define (opt-dense-test-reach-pop-order?
  [worklist : compiler_optimize.OptReachWorklist]
  [expected : i64]) : bool
  (match (compiler_optimize.opt-reach-worklist-pop worklist)
    [(compiler_optimize.OptReachWorklistPop.Empty) (< expected 0)]
    [(compiler_optimize.OptReachWorklistPop.Item found rest)
      (and
        (= found expected)
        (opt-dense-test-reach-pop-order? rest (- expected 1)))]))

(define (opt-dense-test-reach-reuse?) : bool
  (match (compiler_optimize.opt-reach-worklist-pop
    (opt-dense-test-reach-push (compiler_optimize.opt-reach-worklist-new) 0 20))
    [(compiler_optimize.OptReachWorklistPop.Empty) false]
    [(compiler_optimize.OptReachWorklistPop.Item found rest)
      (if (= found 20)
        (match (compiler_optimize.opt-reach-worklist-pop
          (compiler_optimize.opt-reach-worklist-push rest 99))
          [(compiler_optimize.OptReachWorklistPop.Empty) false]
          [(compiler_optimize.OptReachWorklistPop.Item reused tail)
            (and (= reused 99) (opt-dense-test-reach-pop-order? tail 19))])
        false)]))

(define (opt-dense-test-scratch-roots
  [roots : compiler_optimize.OptScratchRootList]
  [next : i64]
  [last : i64]) : compiler_optimize.OptScratchRootList
  (if (> next last)
    roots
    (opt-dense-test-scratch-roots
      (compiler_optimize.opt-scratch-root-list-add roots next)
      (+ next 1)
      last)))

(define (opt-dense-test-global-copy-facts
  [facts : compiler_optimize.OptGlobalCopyFacts (:consume)]
  [next : i64]
  [last : i64]) : compiler_optimize.OptGlobalCopyFacts
  (if (> next last)
    facts
    (opt-dense-test-global-copy-facts
      (compiler_optimize.opt-global-copy-facts-prepend
        facts
        (compiler_optimize.OptGlobalCopyFact.Fact
          next
          (compiler_ir_types.CompilerIrValue.I64 next)
          0
          next))
      (+ next 1)
      last)))

(define (opt-dense-test-global-expr-facts
  [facts : compiler_optimize.OptGlobalExprFacts (:consume)]
  [next : i64]
  [last : i64]) : compiler_optimize.OptGlobalExprFacts
  (if (> next last)
    facts
    (opt-dense-test-global-expr-facts
      (compiler_optimize.opt-global-expr-facts-prepend
        facts
        (compiler_optimize.OptGlobalExprFact.Fact
          (compiler_optimize.OptGlobalExprKey.MovKey
            (compiler_ir_types.CompilerIrValue.I64 next)
            (compiler_ast_types.AstType.I64))
          next
          0
          next))
      (+ next 1)
      last)))

(define (opt-dense-test-global-pack-word-facts
  [facts : compiler_optimize.OptGlobalPackWordFacts (:consume)]
  [next : i64]
  [last : i64]) : compiler_optimize.OptGlobalPackWordFacts
  (if (> next last)
    facts
    (opt-dense-test-global-pack-word-facts
      (compiler_optimize.opt-global-pack-word-facts-prepend
        facts
        (compiler_optimize.OptGlobalPackWordFact.Fact
          next
          next
          (compiler_ir_types.CompilerIrValue.I64 next)
          0
          next))
      (+ next 1)
      last)))

(define (opt-dense-test-global-copy-fact-is?
  [facts : compiler_optimize.OptGlobalCopyFacts]
  [index : i64]
  [expected : i64]) : bool
  (match (compiler_optimize.opt-global-copy-facts-ref facts index)
    [(compiler_optimize.OptGlobalCopyFact.Fact dst src _ _)
      (and
        (= dst expected)
        (match src
          [(compiler_ir_types.CompilerIrValue.I64 value) (= value expected)]
          [_ false]))]))

(define (opt-dense-test-global-expr-fact-is?
  [facts : compiler_optimize.OptGlobalExprFacts]
  [index : i64]
  [expected : i64]) : bool
  (match (compiler_optimize.opt-global-expr-facts-ref facts index)
    [(compiler_optimize.OptGlobalExprFact.Fact _ dst _ _) (= dst expected)]))

(define (opt-dense-test-global-pack-word-fact-is?
  [facts : compiler_optimize.OptGlobalPackWordFacts]
  [index : i64]
  [expected : i64]) : bool
  (match (compiler_optimize.opt-global-pack-word-facts-ref facts index)
    [(compiler_optimize.OptGlobalPackWordFact.Fact group word-index value _ _)
      (and
        (= group expected)
        (= word-index expected)
        (match value
          [(compiler_ir_types.CompilerIrValue.I64 found) (= found expected)]
          [_ false]))]))

(define (opt-dense-test-var-def-index-is?
  [defs : (__tl_dyn-array compiler_optimize.OptMaybeVarDef)]
  [var : i64]
  [expected-block : i64]
  [expected-pos : i64]) : bool
  (match (compiler_optimize.opt-var-def-lookup defs var)
    [(compiler_optimize.OptMaybeVarDef.No) false]
    [(compiler_optimize.OptMaybeVarDef.Some def)
      (match def
        [(compiler_optimize.OptVarDef.Def found block pos)
          (and (= found var) (= block expected-block) (= pos expected-pos))])]))

(define (opt-dense-test-var-def-index-empty?
  [defs : (__tl_dyn-array compiler_optimize.OptMaybeVarDef)]
  [var : i64]) : bool
  (match (compiler_optimize.opt-var-def-lookup defs var)
    [(compiler_optimize.OptMaybeVarDef.No) true]
    [(compiler_optimize.OptMaybeVarDef.Some _) false]))

(define (opt-dense-test-gvn-scope-push
  [type-segment-bases : i64]
  [table : compiler_optimize.OptGvnMap]
  [changes : compiler_optimize.OptGvnScopeChanges (:consume)]
  [next : i64]
  [last : i64]) : compiler_optimize.OptGvnScopeChanges
  (if (> next last)
    changes
    (opt-dense-test-gvn-scope-push
      type-segment-bases
      table
      (compiler_optimize.opt-gvn-table-push!
        type-segment-bases
        table
        (compiler_optimize.OptGvnEntry.Entry
          (compiler_optimize.OptExprKey.BinKey
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.I64 next)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          next
          0)
        changes)
      (+ next 1)
      last)))

(define (opt-dense-test-gvn-scope-rollback? [type-segment-bases : i64]) : bool
  (let
    [table : compiler_optimize.OptGvnMap
      (compiler_optimize.opt-gvn-map-empty 16)]
    [changes : compiler_optimize.OptGvnScopeChanges
      (opt-dense-test-gvn-scope-push
        type-segment-bases
        table
        (compiler_optimize.opt-gvn-scope-changes-new)
        1
        16)]
    [last-key : compiler_optimize.OptExprKey
      (compiler_optimize.OptExprKey.BinKey
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.I64 16)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))]
    [before : i64
      (compiler_optimize.opt-gvn-lookup type-segment-bases table last-key)]
    (begin
      (compiler_optimize.opt-gvn-table-restore! table changes)
      (and
        (= (compiler_optimize.opt-gvn-scope-changes-count changes) 16)
        (= before 16)
        (=
          (compiler_optimize.opt-gvn-lookup type-segment-bases table last-key)
          (- 0 1))))))

(define (opt-dense-test-ssa-sites
  [sites : compiler_optimize.OptSsaPhiSites (:consume)]
  [next : i64]
  [last : i64]) : compiler_optimize.OptSsaPhiSites
  (if (> next last)
    sites
    (opt-dense-test-ssa-sites
      (compiler_optimize.opt-ssa-phi-sites-prepend
        sites
        next
        (+ 100 next)
        (compiler_ast_types.AstType.I64)
        (+ 200 next))
      (+ next 1)
      last)))

(define (opt-dense-test-ssa-site-is?
  [sites : compiler_optimize.OptSsaPhiSites]
