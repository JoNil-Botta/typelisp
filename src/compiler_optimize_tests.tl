        (compiler_ir_types.CompilerIrValue.Var 7)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ir_types.CompilerIrValue.I64 103)
        (compiler_ast_types.AstType.I64)))
    8))

;; A Gep does not sanitize an unknown/escaped raw pointer. Its store remains a
;; full alias barrier for descriptor loads.
(define (opt-licm-header-load-unknown-gep-store-blocks) : compiler_ir_types.CompilerIrBlockList
  (opt-licm-loop-blocks-with-body
    (opt-test-instrs-with-tail
