          [(option_i64.None) false])
        51]
      [(not (= (compiler_optimize.opt-label-count ssa-var-eight-labels) 2)) 52]
      [(not
          (=
            (compiler_optimize.opt-label-ref ssa-var-eight-labels 0)
            (compiler_ir_types.compiler-ir-label "dense_ssa_defs_a")))
        53]
      [(not
          (=
            (compiler_optimize.opt-label-ref ssa-var-eight-labels 1)
            (compiler_ir_types.compiler-ir-label "dense_ssa_defs_b")))
        54]
      [(not (= (compiler_optimize.opt-label-count ssa-var-one-labels) 1)) 55]
      [(not
          (=
            (compiler_optimize.opt-label-ref ssa-var-one-labels 0)
            (compiler_ir_types.compiler-ir-label "dense_ssa_defs_unknown")))
        56]
      [(not
          (=
            (compiler_optimize.opt-label-count
              (compiler_optimize.opt-ssa-var-blocks-lookup ssa-var-blocks 4))
            0))
        57]
      [(not
          (=
            (compiler_optimize.opt-label-count
              (compiler_optimize.opt-ssa-var-blocks-lookup
                ssa-var-blocks-empty
                8))
            0))
        58]
      [(not
          (=
            (compiler_optimize.opt-label-count
              (compiler_optimize.opt-ssa-var-blocks-lookup
                ssa-var-blocks
                (- 0 1)))
            0))
        59]
      [(not (opt-dense-test-ssa-env-indexed-rollback?)) 60]
      [else 42])))

;; --- self-test ---------------------------------------------------------------
(define (opt-arith-instr-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp _ _ _ _ _) 1]
    [(compiler_ir_types.CompilerIrInstr.UnOp _ _ _ _) 1]
    [_ 0]))

(define (opt-count-arith-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-arith-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-arith-instr-count (array-ref slots index))))))

(define (opt-count-arith-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-arith-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-cpuid-instr-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.CpuId _ _ _ _) 1]
    [_ 0]))

(define (opt-xgetbv-instr-count [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Xgetbv _ _) 1]
    [_ 0]))

(define (opt-count-cpuid-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-cpuid-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-cpuid-instr-count (array-ref slots index))))))

(define (opt-count-cpuid-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-cpuid-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-xgetbv-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-xgetbv-instr-seq-from
      slots
      (+ index 1)
      count
      (+ acc (opt-xgetbv-instr-count (array-ref slots index))))))

(define (opt-count-xgetbv-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-count-xgetbv-instr-seq-from instrs.slots 0 instrs.len 0))

(define (opt-count-cpuid-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-cpuid-instr-seq instrs)
            (opt-count-cpuid-blocks (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-cpuid-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-xgetbv-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-xgetbv-instr-seq instrs)
            (opt-count-xgetbv-blocks (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-xgetbv-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-count-exact-instr-seq-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [needle : compiler_ir_types.CompilerIrInstr]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (opt-count-exact-instr-seq-from
      instrs
      needle
      (+ index 1)
      (if (compiler_optimize.opt-instr-eq
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        needle)
        (+ acc 1)
        acc))))

(define (opt-count-exact-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [needle : compiler_ir_types.CompilerIrInstr]) : i64
  (opt-count-exact-instr-seq-from instrs needle 0 0))

(define (opt-count-exact-instr-blocks
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [needle : compiler_ir_types.CompilerIrInstr]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-count-exact-instr-seq instrs needle)
            (opt-count-exact-instr-blocks (__tl-box-place rest) needle))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-count-exact-instr-blocks
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        needle)]))

(define (opt-count-exact-instr-functions
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [needle : compiler_ir_types.CompilerIrInstr]) : i64
  (let
    [index : i64 0]
    [count : i64 0]
    (begin
      (while (< index functions.len)
        (begin
          (match (compiler_ir_types.compiler-ir-function-seq-ref
            functions
            index)
            [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
              (set!
                count
                (+ count (opt-count-exact-instr-blocks blocks needle)))])
          (set! index (+ index 1))))
      count)))

(define (opt-count-exact-instr-program
  [program : compiler_ir_types.CompilerIrProgram]
  [needle : compiler_ir_types.CompilerIrInstr]) : i64
  (match program
    [(compiler_ir_types.CompilerIrProgram.Program _ functions _)
      (opt-count-exact-instr-functions functions needle)]))

(define (opt-sum-mov-i64-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (opt-mov-i64-value
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
      (opt-sum-mov-i64-from instrs (+ index 1)))))

(define (opt-sum-mov-i64 [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-sum-mov-i64-from instrs 0))

(define (opt-mov-i64-value [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Mov
        _
        (compiler_ir_types.CompilerIrValue.I64 n)
        _)
      n]
    [_ 0]))

(define (opt-count-mov-i64-value-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [needle : i64]
  [acc : i64]) : i64
  (if (>= index count)
    acc
    (opt-count-mov-i64-value-instr-seq-from
      slots
      (+ index 1)
      count
      needle
      (+
        acc
        (match (array-ref slots index)
          [(compiler_ir_types.CompilerIrInstr.Mov
              _
              (compiler_ir_types.CompilerIrValue.I64 n)
              _)
            (if (= n needle)
              1
              0)]
          [_ 0])))))

(define (opt-count-mov-i64-value-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [needle : i64]) : i64
  (opt-count-mov-i64-value-instr-seq-from instrs.slots 0 instrs.len needle 0))

(define (opt-count-mov-bool-value-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [needle : bool]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      (+
        (match instr
          [(compiler_ir_types.CompilerIrInstr.Mov
              _
              (compiler_ir_types.CompilerIrValue.Bool b)
              _)
            (if needle
              (if b
                1
                0)
              (if b
                0
                1))]
          [_ 0])
        (opt-count-mov-bool-value-from instrs (+ index 1) needle)))))

(define (opt-count-mov-bool-value
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [needle : bool]) : i64
  (opt-count-mov-bool-value-from instrs 0 needle))

(define (opt-sum-mov-var-src-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      (+
        (match instr
          [(compiler_ir_types.CompilerIrInstr.Mov
              _
              (compiler_ir_types.CompilerIrValue.Var id)
              _)
            id]
          [_ 0])
        (opt-sum-mov-var-src-from instrs (+ index 1))))))

(define (opt-sum-mov-var-src [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (opt-sum-mov-var-src-from instrs 0))

(define (opt-mov-dst-type-tag-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov d _ ty)
        (if (= d dst)
          (compiler_ast_types.ast-type-tag ty)
          (opt-mov-dst-type-tag-from instrs (+ index 1) dst))]
      [_ (opt-mov-dst-type-tag-from instrs (+ index 1) dst)])))

(define (opt-mov-dst-type-tag
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]) : i64
  (opt-mov-dst-type-tag-from instrs 0 dst))

(define (opt-mov-dst-i64-value-instr-seq-from
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [index : i64]
  [count : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index count)
    fallback
    (match (array-ref slots index)
      [(compiler_ir_types.CompilerIrInstr.Mov
          d
          (compiler_ir_types.CompilerIrValue.I64 n)
          _)
        (if (= d dst)
          n
          (opt-mov-dst-i64-value-instr-seq-from
            slots
            (+ index 1)
            count
            dst
            fallback))]
      [_
        (opt-mov-dst-i64-value-instr-seq-from
          slots
          (+ index 1)
          count
          dst
          fallback)])))

(define (opt-mov-dst-i64-value-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-dst-i64-value-instr-seq-from instrs.slots 0 instrs.len dst fallback))

(define (opt-mov-dst-bool-value-from?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [needle : bool]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov
          d
          (compiler_ir_types.CompilerIrValue.Bool b)
          _)
        (if (= d dst)
          (if needle
            b
            (not b))
          (opt-mov-dst-bool-value-from? instrs (+ index 1) dst needle))]
      [_ (opt-mov-dst-bool-value-from? instrs (+ index 1) dst needle)])))

(define (opt-mov-dst-bool-value?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [needle : bool]) : bool
  (opt-mov-dst-bool-value-from? instrs 0 dst needle))

(define (opt-mov-dst-char-code-from
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [fallback : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    fallback
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov
          d
          (compiler_ir_types.CompilerIrValue.Char c)
          _)
        (if (= d dst)
          (cast c : i64)
          (opt-mov-dst-char-code-from instrs (+ index 1) dst fallback))]
      [_ (opt-mov-dst-char-code-from instrs (+ index 1) dst fallback)])))

(define (opt-mov-dst-char-code
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [fallback : i64]) : i64
  (opt-mov-dst-char-code-from instrs 0 dst fallback))

(define (opt-test-f64-bits [text : String]) : u64
  (match (compiler_float.compiler-float-parse-f64-bits text)
    [(CompilerFloatSomeBits bits) bits]
    [(CompilerFloatNoBits) (cast 0 : u64)]))

(define (opt-test-f32-bits [text : String]) : u64
  (match (compiler_float.compiler-float-parse-f32-bits text)
    [(CompilerFloatSomeBits bits) bits]
    [(CompilerFloatNoBits) (cast 0 : u64)]))

(define (opt-mov-dst-f64-bits-from?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]
  [want : u64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Mov
          d
          (compiler_ir_types.CompilerIrValue.F64 bits)
          _)
        (if (= d dst)
          (= bits want)
          (opt-mov-dst-f64-bits-from? instrs (+ index 1) dst want))]
      [_ (opt-mov-dst-f64-bits-from? instrs (+ index 1) dst want)])))

(define (opt-mov-dst-f64-bits?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [dst : i64]
  [want : u64]) : bool
  (opt-mov-dst-f64-bits-from? instrs 0 dst want))

(define (opt-test-span [line : i64] [col : i64]) : compiler_ast_types.AstSourceSpan
  (compiler_ast_types.ast-source-span line col line col))

(define (opt-source-span-line-col-ok?
  [span : compiler_ast_types.AstSourceSpan]
  [line : i64]
  [col : i64]) : bool
  (and
    (= (compiler_ast_types.ast-source-span-start-line span) line)
    (= (compiler_ast_types.ast-source-span-start-col span) col)))

(define (opt-span-lookup-ok?
  [spans : compiler_ir_types.CompilerSourceSpans]
  [function : i64]
  [instr : compiler_ir_types.CompilerIrInstr]
  [line : i64]
  [col : i64]) : bool
  (match (compiler_ir_types.compiler-source-spans-lookup-instr
    spans
    function
    instr)
    [(compiler_ir_types.CompilerMaybeSourceSpan.Some span)
      (opt-source-span-line-col-ok? span line col)]
    [(compiler_ir_types.CompilerMaybeSourceSpan.No) false]))

(define (opt-span-lookup-missing?
  [spans : compiler_ir_types.CompilerSourceSpans]
  [function : i64]
  [instr : compiler_ir_types.CompilerIrInstr]) : bool
  (match (compiler_ir_types.compiler-source-spans-lookup-instr
    spans
    function
    instr)
    [(compiler_ir_types.CompilerMaybeSourceSpan.Some _) false]
    [(compiler_ir_types.CompilerMaybeSourceSpan.No) true]))

(define (opt-location-lookup-ok?
  [spans : compiler_ir_types.CompilerSourceSpans]
  [function : i64]
  [instr : compiler_ir_types.CompilerIrInstr]
  [path-id : i64]
  [line : i64]
  [col : i64]) : bool
  (match (compiler_ir_types.compiler-source-spans-lookup-instr-location
    spans
    function
    instr)
    [(compiler_ir_types.CompilerMaybeSourceLocation.Some
        (compiler_ir_types.CompilerSourceLocation found-path-id span))
      (and
        (= found-path-id path-id)
        (opt-source-span-line-col-ok? span line col))]
    [(compiler_ir_types.CompilerMaybeSourceLocation.No) false]))

(define (opt-test-symbol [name : String]) : i64
  (begin
    (cbi.compiler-builtin-initialize-for-parse!)
    (compiler_ir_types.compiler-ir-test-symbol name)))

(define (opt-test-global-builder-push!
  [builder : (&mut builder compiler_ir_types.CompilerIrGlobalBuilder)]
  [name : i64]
  [ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]) : unit
  (compiler_ir_types.compiler-ir-global-builder-push!
    builder
    (compiler_ir_types.CompilerIrGlobal.Global name ty value)))

(define (compiler-optimize-runtime-call-identity-self-test) : i64
  (let
    [generated-alloc : i64 (opt-test-symbol "tl_alloc")]
    [generated-abort : i64 (opt-test-symbol ".L_tl_abort")]
    [generated-arena : i64 (opt-test-symbol "arena-current")]
    [runtime-alloc : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        91
        cbi.compiler-builtin-id-tl-alloc
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 16))
        (compiler_ast_types.AstType.Struct (ci.intern "RuntimePair")))]
    [hygienic-alloc : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        92
        generated-alloc
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 16))
        (compiler_ast_types.AstType.Struct (ci.intern "HygienicPair")))]
    [runtime-abort : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        93
        cbi.compiler-builtin-id-tl-abort-label
        (compiler_ir_types.CompilerIrCallArgs.Nil)
        (compiler_ast_types.AstType.Unit))]
    [hygienic-abort : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        94
        generated-abort
        (compiler_ir_types.CompilerIrCallArgs.Nil)
        (compiler_ast_types.AstType.Unit))]
    [runtime-facts : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-update-value-facts
        (compiler_optimize.opt-alias-empty)
        runtime-alloc
        0)]
    [hygienic-facts : compiler_optimize.OptAliasFacts
      (compiler_optimize.opt-alias-update-value-facts
        (compiler_optimize.opt-alias-empty)
        hygienic-alloc
        0)]
    (cond
      [(= generated-alloc cbi.compiler-builtin-id-tl-alloc) 1]
      [(not
          (string.eq
            (compiler_ir_types.compiler-ir-symbol-text generated-alloc)
            (compiler_ir_types.compiler-ir-symbol-text
              cbi.compiler-builtin-id-tl-alloc)))
        2]
      [(not
          (compiler_ir_types.compiler-ir-symbol-eq?
            cbi.compiler-builtin-id-tl-alloc
            cbi.compiler-builtin-id-tl-alloc))
        15]
      [(compiler_ir_types.compiler-ir-symbol-eq?
          generated-alloc
          cbi.compiler-builtin-id-tl-alloc)
        16]
      [(not
          (compiler_ir_types.compiler-ir-effect-eq?
            (compiler_ir_types.compiler-ir-instr-effect runtime-alloc)
            compiler_ir_types.CompilerIrEffect.MemoryWrite))
        3]
      [(not
          (compiler_ir_types.compiler-ir-effect-eq?
            (compiler_ir_types.compiler-ir-instr-effect hygienic-alloc)
            compiler_ir_types.CompilerIrEffect.Unknown))
        4]
      [(match (compiler_optimize.opt-aggregate-direct-alloc runtime-alloc)
          [(compiler_optimize.OptMaybeAggregateAlloc.Some _ _ _) false]
          [(compiler_optimize.OptMaybeAggregateAlloc.No) true])
        5]
      [(match (compiler_optimize.opt-aggregate-direct-alloc hygienic-alloc)
          [(compiler_optimize.OptMaybeAggregateAlloc.No) false]
          [(compiler_optimize.OptMaybeAggregateAlloc.Some _ _ _) true])
        6]
      [(match (compiler_optimize.opt-scratch-direct-alloc
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          runtime-alloc)
          [(compiler_optimize.OptScratchAlloc.Alloc _ _) false]
          [(compiler_optimize.OptScratchAlloc.NoAlloc) true])
        7]
      [(match (compiler_optimize.opt-scratch-direct-alloc
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          hygienic-alloc)
          [(compiler_optimize.OptScratchAlloc.NoAlloc) false]
          [(compiler_optimize.OptScratchAlloc.Alloc _ _) true])
        8]
      [(match (compiler_optimize.opt-alias-lookup runtime-facts 91)
          [(compiler_optimize.OptMaybeAliasKind.Some kind)
            (not
              (compiler_optimize.opt-alias-kind-eq
                kind
                (compiler_optimize.OptAliasKind.Unique 0)))]
          [(compiler_optimize.OptMaybeAliasKind.No) true])
        9]
      [(match (compiler_optimize.opt-alias-lookup hygienic-facts 92)
          [(compiler_optimize.OptMaybeAliasKind.No) false]
          [(compiler_optimize.OptMaybeAliasKind.Some _) true])
        10]
      [(not (compiler_optimize.opt-licm-return-staging-instr? runtime-abort))
        11]
      [(compiler_optimize.opt-licm-return-staging-instr? hygienic-abort) 12]
      [(not
          (compiler_optimize.opt-scratch-arena-helper-call?
            cbi.compiler-builtin-id-arena-current))
        13]
      [(compiler_optimize.opt-scratch-arena-helper-call? generated-arena) 14]
      [else 42])))

(define (opt-spans-function-with-frame
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [frame : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "main")
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    frame
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        instrs)
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-spans-function [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (opt-spans-function-with-frame instrs 4))

(define (opt-spans-program-with-frame
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [frame : i64]) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
