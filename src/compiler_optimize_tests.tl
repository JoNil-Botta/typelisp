(define (compiler-optimize-spans-inline-multiblock-ok?) : bool
  (let
    [symbols : OptInlineMultiTestSymbols (opt-inline-multi-test-symbols)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr
        (compiler_ir_types.compiler-source-spans-insert-instr
          (opt-spans-base)
          (opt-test-span-symbol "inline_branch")
          (opt-inline-branch-callee-mov)
          (opt-test-span 141 27))
        (opt-test-span-symbol "main")
        (opt-inline-branch-caller-call symbols)
        (opt-test-span 151 29))]
    [phi : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Phi
        0
        (opt-inline-span-branch-phi-inputs)
        (compiler_ast_types.AstType.I64))]
    (match (compiler_optimize.opt-inline-program-functions-with-spans
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-inline-branch-functions symbols)
      2
      spans)
      [(compiler_optimize.OptInlineSpanProgram.Program
          optimized
          optimized-spans)
        (match (compiler_optimize.opt-function-seq-find
          (compiler_optimize.compiler-opt-global-shared-view optimized)
          "main")
          [(compiler_optimize.OptMaybeFunction.Some main)
            (and
              (=
                (compiler_ir_types.compiler-ir-block-list-count
                  (compiler_optimize.opt-function-blocks
                    (compiler_optimize.compiler-opt-global-shared-view main)))
                5)
              (opt-span-lookup-ok?
                (compiler_optimize.compiler-opt-global-shared-view
                  optimized-spans)
                (opt-test-symbol "main")
                (opt-inline-branch-callee-mov)
                141
                27)
              (opt-span-lookup-ok?
                optimized-spans
                (opt-test-symbol "main")
                phi
                151
                29))]
          [(compiler_optimize.OptMaybeFunction.No) false])])))

(define (compiler-optimize-spans-non-inline-call-ok?) : bool
  (let
    [call : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Call
        1
        (opt-test-symbol "opaque")
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 5))
        (compiler_ast_types.AstType.I64))]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (clone call)
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 1))))]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr
        (opt-spans-base)
        (opt-test-span-symbol "main")
        (compiler_optimize.compiler-opt-global-shared-view call)
        (opt-test-span 101 19))]
    (match (compiler_optimize.optimize-program-with-spans-and-level
      (opt-spans-program instrs)
      (compiler_ir_types.compiler-ir-global-shared-view spans)
      2)
      [(compiler_optimize.CompilerOptimizedProgram.Program _ optimized-spans)
        (opt-span-lookup-ok?
          optimized-spans
          (opt-test-symbol "main")
          call
          101
          19)])))

(define (compiler-optimize-spans-pack-word-ok?) : bool
  (let
    [pack : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Pack
        2
