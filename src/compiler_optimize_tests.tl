;; Dense fixture literals expand to one right-sized builder and forward pushes.
;; Each expansion owns its backing array, so separate tests cannot accidentally
;; share mutable instruction storage.
(defmacro (opt-test-instrs-push!
  [builder : comptime.Expr]
  [carrier : comptime.Expr]
  [index : comptime.Expr]) : unit
  (match index
    [(comptime.Expr.Int i)
      (match carrier
        [(comptime.Expr.Call _ instrs)
          (if (>= i (comptime.expr-list-length instrs))
            `unit
            `(begin
              (compiler_ir_types.compiler-ir-instr-builder-push!
                ,builder
                ,(comptime.expr-list-nth instrs i))
              (opt-test-instrs-push!
                ,builder
                ,carrier
                ,(comptime.expr-int (+ i 1)))))]
        [_ `unit])]
    [_ `unit]))

(defmacro (opt-test-instrs [instrs : compiler_ir_types.CompilerIrInstr ...]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [count : i64 (comptime.expr-list-length instrs)]
    `(let
      [builder : compiler_ir_types.CompilerIrInstrBuilder
        (compiler_ir_types.compiler-ir-instr-builder-with-capacity
          ,(comptime.expr-int count))]
      (begin
        (opt-test-instrs-push! (&mut builder) (__opt-test-instrs ,@instrs) 0)
        (compiler_ir_types.compiler-ir-instr-builder-to-seq builder)))))

;; Prefix a computed dense suffix without rebuilding fixtures as recursive
;; lists. Prefix expressions retain their source order; the suffix is evaluated
;; once after them and appended through the dense builder API.
(defmacro (opt-test-instrs-with-tail
  [tail : compiler_ir_types.CompilerIrInstrSeq]
  [instrs : compiler_ir_types.CompilerIrInstr ...]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [count : i64 (comptime.expr-list-length instrs)]
    `(let
      [builder : compiler_ir_types.CompilerIrInstrBuilder
        (compiler_ir_types.compiler-ir-instr-builder-with-capacity
          ,(comptime.expr-int count))]
      (begin
        (opt-test-instrs-push! (&mut builder) (__opt-test-instrs ,@instrs) 0)
        (let
          [suffix : compiler_ir_types.CompilerIrInstrSeq ,tail]
          (begin
            (compiler_ir_types.compiler-ir-instr-builder-append-seq-range!
              (&mut builder)
              suffix
              0
              (compiler_ir_types.compiler-ir-instr-seq-count suffix))
            (compiler_ir_types.compiler-ir-instr-builder-to-seq builder)))))))

(define (opt-test-instr-seq-copy
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
    [builder : compiler_ir_types.CompilerIrInstrBuilder
      (compiler_ir_types.compiler-ir-instr-builder-with-capacity count)]
    (begin
      (compiler_ir_types.compiler-ir-instr-builder-append-seq-range!
        (&mut builder)
        instrs
        0
        count)
      (compiler_ir_types.compiler-ir-instr-builder-to-seq builder))))

;; Dynamic fixture generators cannot use the variadic literal macros above.
;; Keep their computed prefixes dense while preserving the source-order shape
;; of the old recursive builders.
(define (opt-test-instr-seq-prepend
  [instr : compiler_ir_types.CompilerIrInstr]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [tail-count : i64 (compiler_ir_types.compiler-ir-instr-seq-count tail)]
    [builder : compiler_ir_types.CompilerIrInstrBuilder
      (compiler_ir_types.compiler-ir-instr-builder-with-capacity
        (+ tail-count 1))]
    (begin
      (compiler_ir_types.compiler-ir-instr-builder-push! (&mut builder) instr)
      (compiler_ir_types.compiler-ir-instr-builder-append-seq-range!
        (&mut builder)
        tail
        0
        tail-count)
      (compiler_ir_types.compiler-ir-instr-builder-to-seq builder))))

(define (opt-test-fold-instrs
  [type-segment-bases : i64]
  [env : compiler_optimize.OptConstEnv]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [result : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instr-seq-copy instrs)]
    (begin
      (compiler_optimize.opt-fold-instrs! type-segment-bases env (&mut result))
      result)))

(define (opt-test-strength-instrs
  [env : compiler_optimize.OptConstEnv]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [result : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instr-seq-copy instrs)]
    (begin
      (compiler_optimize.opt-strength-instrs! env (&mut result))
      result)))

(define (opt-test-collect-instrs-uses
  [set : opt_i64_i64_map.Map]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : opt_i64_i64_map.Map
  (compiler_optimize.opt-collect-instrs-uses set (& instrs)))

(define (opt-test-dce-instrs
  [set : opt_i64_i64_map.Map]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [result : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instr-seq-copy instrs)]
    (begin
      (compiler_optimize.opt-dce-instrs! set (&mut result))
      result)))

(define (opt-test-instr-seq-eq
  [type-segment-bases : i64]
  [left : compiler_ir_types.CompilerIrInstrSeq]
  [right : compiler_ir_types.CompilerIrInstrSeq]) : bool
  (compiler_optimize.opt-instr-seq-eq type-segment-bases left right))

(define (opt-test-cse-instrs
  [type-segment-bases : i64]
  [table : compiler_optimize.OptExprTable]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
