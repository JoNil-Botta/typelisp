(cfg
  test
  (define (opt-licm-checked-root-join-blocks [mixed? : bool]) : compiler_ir_types.CompilerIrBlockList
    (let
      [ref-ty : compiler_ast_types.AstType
        (compiler_ast_types.ast-ty-ref 0 (compiler_ast_types.AstType.I64))]
      (compiler_ir_types.compiler-ir-block-cons
