(define (opt-owned-test-transfer-code
  [defs : (__tl_dyn-array compiler_optimize.OptMaybeVarDef)]
  [context : compiler_optimize.OptCfgContext]
  [return-alias : opt_i64_i64_map.Map]
  [path-root : i64]
  [offset : i64]
