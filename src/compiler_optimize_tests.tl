(define (opt-licm-array-optimized-function-with-direct-call-clean
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]) : compiler_ir_types.CompilerIrFunction
  (compiler_optimize.opt-licm-function-with-direct-call-clean
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-licm-array-test-function
      (compiler_ir_types.compiler-ir-global-shared-view blocks))
    direct-call-clean))

;; The POST-BCE run, which is where the descriptor-header exception lives (see
;; opt-licm-apply-loop's `descriptor-header-hoist?`), with a caller-supplied
;; clean map so a callee's proven memory class decides the hoist.
(define (opt-licm-array-late-optimized-function-with-direct-call-clean
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [direct-call-clean : opt_i64_i64_map.Map]) : compiler_ir_types.CompilerIrFunction
  (let
    [func : compiler_ir_types.CompilerIrFunction
      (opt-licm-array-test-function
        (compiler_optimize.compiler-opt-global-shared-view blocks))]
    (match (compiler_optimize.opt-licm-function-with-context-result-and-direct-call-clean
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-cfg-context-build
        (compiler_optimize.compiler-opt-global-shared-view blocks))
      false
      direct-call-clean
      (opt_i64_i64_map.with-capacity 1)
      (compiler_optimize.opt-global-cell-summary-empty)
      true
      func)
      [(compiler_optimize.OptFunctionCtxResult.Result next _) next])))

(define (opt-licm-touch-clean-map [symbols : OptLicmTestSymbols] [bits : i64]) : opt_i64_i64_map.Map
  (let
    [map : opt_i64_i64_map.Map (opt_i64_i64_map.with-capacity 8)]
    (begin
      (opt_i64_i64_map.insert-ref!
        (&mut map)
        (compiler_ir_types.compiler-ir-symbol-id symbols.touch)
        bits)
      map)))

(define (opt-licm-summary-for-instr [instr : compiler_ir_types.CompilerIrInstr]) : compiler_optimize.OptLicmStoreSummary
  (compiler_optimize.opt-licm-store-summary-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "summary")
        (opt-test-instrs instr))
      (compiler_ir_types.CompilerIrBlockList.Nil))
    (compiler_optimize.opt-licm-store-summary-empty)))

(define (opt-licm-arithmetic-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            4
            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "body")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            10
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            11
            (compiler_ir_types.CompilerIrBinOp.Mul)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            12
            (compiler_ir_types.CompilerIrValue.I64 4096)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Cast
            13
            (compiler_ir_types.CompilerIrValue.Var 12)
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.AstType.U64))
          (compiler_ir_types.CompilerIrInstr.Bitcast
            14
            (compiler_ir_types.CompilerIrValue.Var 13)
            (compiler_ast_types.AstType.U64)
            (compiler_ast_types.AstType.U64))
          (compiler_ir_types.CompilerIrInstr.Gep
            15
            (compiler_ir_types.CompilerIrValue.Var 14)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "body")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 11)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Entry-preheader profitability fixture. The first two arithmetic values are
;; consumed only by the bypassable `cold` arm. The loaded value is likewise
;; cold-only, but its Gep/Load chain is outside the arithmetic profitability
;; gate.
(define (opt-licm-profitability-loop-tail) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "loop")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          4
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.UnOp
          5
          (compiler_ir_types.CompilerIrUnOp.Neg)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Gep
          6
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          7
          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "cold")
          (compiler_ir_types.compiler-ir-label "latch"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "cold")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            8
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            9
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            12
            (compiler_ir_types.CompilerIrValue.Var 8)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            13
            (compiler_ir_types.CompilerIrValue.Var 9)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "latch"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "latch")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-label "loop")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              ;; A real instruction on the exit path keeps this out of LICM's
              ;; separate return-shaped-loop suppression.
              (compiler_ir_types.CompilerIrInstr.StorePtr
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.CompilerIrValue.I64 0)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.I64 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-licm-profitability-blocks [non-entry-preheader? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Alloc
          3
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.StorePtr
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (if non-entry-preheader?
            (compiler_ir_types.compiler-ir-label "pre")
            (compiler_ir_types.compiler-ir-label "loop")))))
    (if non-entry-preheader?
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "pre")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))))
        (opt-licm-profitability-loop-tail))
      (opt-licm-profitability-loop-tail))))

;; One outer loop with four consumer classes: a bypassable cold sibling, two
;; nested-loop blocks, the outer latch, and the function exit.
(define (opt-licm-hot-use-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "outer"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "outer")
        (opt-test-instrs
          ;; `%24`'s ONLY use is the branch below. A compare left where its
          ;; branch is costs `cmp; jcc`; hoisted it costs `cmp; setcc; movzx`
          ;; once plus `test; jcc` every iteration -- never a per-iteration
          ;; win, so it is not a consumer that can pay for a hoist.
          (compiler_ir_types.CompilerIrInstr.BinOp
            24
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.Bool))
          ;; `%25` has a NON-branch use as well, so it has to be materialized
          ;; wherever it is defined and hoisting really does remove work: it
          ;; stays a hot use.
          (compiler_ir_types.CompilerIrInstr.BinOp
            25
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Mov
            26
            (compiler_ir_types.CompilerIrValue.Var 25)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 24)
            (compiler_ir_types.compiler-ir-label "cold")
            (compiler_ir_types.compiler-ir-label "inner"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "cold")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              20
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 10)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "outer-latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "inner")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                21
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 11)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "inner-body")
                (compiler_ir_types.compiler-ir-label "outer-latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "inner-body")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.UnOp
                  22
                  (compiler_ir_types.CompilerIrUnOp.Neg)
                  (compiler_ir_types.CompilerIrValue.Var 12)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "inner"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "outer-latch")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    23
                    (compiler_ir_types.CompilerIrBinOp.Add)
                    (compiler_ir_types.CompilerIrValue.Var 13)
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 0)
                    (compiler_ir_types.compiler-ir-label "outer")
                    (compiler_ir_types.compiler-ir-label "exit"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "exit")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 14)))))
                (compiler_ir_types.CompilerIrBlockList.Nil)))))))))

(define (opt-licm-hot-use-self-test) : i64
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-licm-hot-use-test-blocks)]
    [context : compiler_optimize.OptCfgContext
      (compiler_optimize.opt-cfg-context-build
        (compiler_optimize.compiler-opt-global-shared-view blocks))]
    [loops : compiler_optimize.OptNaturalLoopList
      (compiler_optimize.opt-cfg-natural-loops-with-context
        (compiler_optimize.compiler-opt-global-shared-view blocks)
        (compiler_optimize.compiler-opt-global-shared-view context))]
    (match (compiler_optimize.opt-natural-loop-find
      (compiler_optimize.compiler-opt-global-shared-view loops)
      (compiler_ir_types.compiler-ir-label "outer")
      (compiler_ir_types.compiler-ir-label "outer-latch"))
      [(compiler_optimize.OptMaybeNaturalLoop.No) 1]
      [(compiler_optimize.OptMaybeNaturalLoop.Some outer)
        (match (compiler_optimize.opt-cfg-index-id
          (compiler_optimize.compiler-opt-global-shared-view context.index)
          (compiler_ir_types.compiler-ir-label "outer-latch"))
          [(option_i64.None) 2]
          [(option_i64.Some latch-id)
            (let
              [hot : opt_i64_i64_map.Map
                (compiler_optimize.opt-licm-hot-use-vars
                  (compiler_optimize.compiler-opt-global-shared-view context)
                  latch-id
                  (compiler_optimize.compiler-opt-global-shared-view loops)
                  (compiler_optimize.opt-natural-loop-header
                    (compiler_optimize.compiler-opt-global-shared-view outer))
                  (compiler_optimize.opt-natural-loop-body
                    (compiler_optimize.compiler-opt-global-shared-view outer))
                  true
                  (compiler_optimize.compiler-opt-global-shared-view blocks)
                  (opt_i64_i64_map.with-capacity 16))]
              [ungated : opt_i64_i64_map.Map
                (compiler_optimize.opt-licm-hot-use-vars
                  (compiler_optimize.compiler-opt-global-shared-view context)
                  latch-id
                  (compiler_optimize.compiler-opt-global-shared-view loops)
                  (compiler_optimize.opt-natural-loop-header
                    (compiler_optimize.compiler-opt-global-shared-view outer))
                  (compiler_optimize.opt-natural-loop-body
                    (compiler_optimize.compiler-opt-global-shared-view outer))
                  false
                  (compiler_optimize.compiler-opt-global-shared-view blocks)
                  (opt_i64_i64_map.with-capacity 16))]
              (cond
                [(compiler_optimize.opt-used-contains
                    (compiler_optimize.compiler-opt-global-shared-view hot)
                    10)
                  3]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view hot)
                      11))
                  4]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view hot)
                      12))
                  5]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view hot)
                      13))
                  6]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view hot)
                      14))
                  7]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view
                        ungated)
                      10))
                  8]
                ;; A compare whose every use is a branch condition is not
                ;; collected, gated or not; one with a non-branch use still is.
                [(compiler_optimize.opt-used-contains
                    (compiler_optimize.compiler-opt-global-shared-view hot)
                    24)
                  9]
                [(compiler_optimize.opt-used-contains
                    (compiler_optimize.compiler-opt-global-shared-view ungated)
                    24)
                  10]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view hot)
                      25))
                  11]
                [(not
                    (compiler_optimize.opt-used-contains
                      (compiler_optimize.compiler-opt-global-shared-view
                        ungated)
                      25))
                  12]
                [else 42]))])])))

(define (compiler-optimize-licm-profitability-self-test) : i64
  (let
    [entry-func : compiler_ir_types.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-profitability-blocks false))]
    [entry : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view entry-func))]
    [non-entry-func : compiler_ir_types.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-profitability-blocks true))]
    [non-entry : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.compiler-opt-global-shared-view non-entry-func))]
    (cond
      [(not (= (opt-licm-hot-use-self-test) 42)) 1]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view entry-func))))
        2]
      [(not
          (=
            (opt-count-arith-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view entry)
              (compiler_ir_types.compiler-ir-label "loop"))
            2))
        3]
      [(not
          (=
            (opt-count-arith-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view entry)
              (compiler_ir_types.compiler-ir-label "cold"))
            2))
        4]
      [(not
          (=
            (opt-count-gep-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view entry)
              (compiler_ir_types.compiler-ir-label "entry"))
            1))
        5]
      [(not
          (=
            (opt-count-load-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view entry)
              (compiler_ir_types.compiler-ir-label "entry"))
            1))
        6]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (compiler_optimize.compiler-opt-global-shared-view non-entry-func))))
        7]
      [(not
          (=
            (opt-count-arith-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view non-entry)
              (compiler_ir_types.compiler-ir-label "pre"))
            4))
        8]
      [(not
          (=
            (opt-count-arith-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view non-entry)
              (compiler_ir_types.compiler-ir-label "loop"))
            0))
        9]
      [(not
          (=
            (opt-count-arith-label-blocks
              (compiler_optimize.compiler-opt-global-shared-view non-entry)
              (compiler_ir_types.compiler-ir-label "cold"))
            0))
        10]
      [else 42])))

(define (opt-licm-simd-instr-kind
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Splat actual _ _ _)
      (if (= actual dst)
        1
        0)]
    [(compiler_ir_types.CompilerIrInstr.VectorBinOp payload-box)
      (if (= (__tl-project-field (__tl-box-place payload-box) dst) dst)
        2
        0)]
    [(compiler_ir_types.CompilerIrInstr.VectorCompare payload-box)
      (if (= (__tl-project-field (__tl-box-place payload-box) dst) dst)
        3
        0)]
    ;; A moved vector or mask must remain its original SIMD instruction; a
    ;; scalar copy cannot faithfully stage either register class.
    [(compiler_ir_types.CompilerIrInstr.Mov actual _ _)
      (if (= actual dst)
        4
        0)]
    [_ 0]))

(define (opt-licm-simd-kind-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (let
      [kind : i64
        (opt-licm-simd-instr-kind
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          dst)]
      (if (= kind 0)
        (opt-licm-simd-kind-in-seq instrs (+ index 1) dst)
        kind))))

(define (opt-licm-simd-index-in-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 1)
    (if (=
      (opt-licm-simd-instr-kind
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        dst)
      0)
      (opt-licm-simd-index-in-seq instrs (+ index 1) dst)
      index)))

(define (opt-licm-simd-kind-at
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [label : i64]
  [dst : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    (owned_view.compiler-owned-reference-shared-view blocks)
    label)
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-licm-simd-kind-in-seq instrs 0 dst)])]))

(define (opt-licm-simd-index-at
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [label : i64]
  [dst : i64]) : i64
  (match (compiler_optimize.opt-cfg-find-block
    (owned_view.compiler-owned-reference-shared-view blocks)
    label)
    [(compiler_optimize.OptMaybeBlock.No) (- 0 1)]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (opt-licm-simd-index-in-seq instrs 0 dst)])]))

;; One guaranteed self-loop. Every SIMD result has a hot in-loop consumer, and
;; every operand is either a parameter or an earlier member of the chain.
(define (opt-licm-simd-chain-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Splat
            4
            (compiler_ir_types.CompilerIrValue.Var 1)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-bin-op
            5
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 4)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-compare
            6
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.CompilerIrValue.Var 4)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.MaskReduce
            7
            (compiler_ir_types.CompilerIrMaskReduceOp.Any)
            (compiler_ir_types.CompilerIrValue.Var 6)
            4)
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

;; The first splat is invariant, then the chain meets a splat of a loop-carried
;; phi. Motion must stop at that operation and leave every dependent SIMD value
;; in the loop.
(define (opt-licm-simd-mixed-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Phi
            3
            (compiler_ir_types.compiler-ir-phi-input-seq-prepend
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.compiler-ir-label "loop")
                (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Splat
            5
            (compiler_ir_types.CompilerIrValue.Var 1)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Splat
            6
            (compiler_ir_types.CompilerIrValue.Var 3)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-bin-op
            7
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.CompilerIrValue.Var 6)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-compare
            8
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 7)
            (compiler_ir_types.CompilerIrValue.Var 5)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.MaskReduce
            9
            (compiler_ir_types.CompilerIrMaskReduceOp.Any)
            (compiler_ir_types.CompilerIrValue.Var 8)
            4)
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

;; Independent SIMD values whose only consumers are on a bypassable sibling do
;; not pay for longer live ranges. The vector operands are already available in
;; the preheader so only the hot-use gate decides these three candidates.
(define (opt-licm-simd-cold-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 1)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Splat
          11
          (compiler_ir_types.CompilerIrValue.Var 2)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Splat
            4
            (compiler_ir_types.CompilerIrValue.Var 1)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-bin-op
            5
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 11)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.ir-instr-vector-compare
            6
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 11)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "cold")
            (compiler_ir_types.compiler-ir-label "latch"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "cold")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.VectorReduce
              7
              (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
              (compiler_ir_types.CompilerIrValue.Var 4)
              4
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.VectorReduce
              8
              (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
              (compiler_ir_types.CompilerIrValue.Var 5)
              4
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.MaskReduce
              9
              (compiler_ir_types.CompilerIrMaskReduceOp.Any)
              (compiler_ir_types.CompilerIrValue.Var 6)
              4)
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "latch")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "loop")
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 0)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

;; The sibling producer does not dominate the right arm. Its dependent binop
;; and compare have outside-loop uses (and are therefore hot), but may not move
;; because their operands remain loop definitions rather than hoisted defs.
(define (opt-licm-simd-sibling-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 2)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "left")
            (compiler_ir_types.compiler-ir-label "right"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "left")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Splat
              4
              (compiler_ir_types.CompilerIrValue.Var 1)
              4
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "latch"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "right")
            (opt-test-instrs
              (compiler_ir_types.ir-instr-vector-bin-op
                5
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.CompilerIrValue.Var 10)
                4
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.ir-instr-vector-compare
                6
                (compiler_ir_types.CompilerIrBinOp.Lt)
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.CompilerIrValue.Var 10)
                4
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "latch"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "latch")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ir_types.compiler-ir-label "loop")
                  (compiler_ir_types.compiler-ir-label "exit"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "exit")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.VectorReduce
                    7
                    (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
                    (compiler_ir_types.CompilerIrValue.Var 5)
                    4
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.MaskReduce
                    8
                    (compiler_ir_types.CompilerIrMaskReduceOp.Any)
                    (compiler_ir_types.CompilerIrValue.Var 6)
                    4)
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 0)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

;; Vector arithmetic with scalar-style trap semantics is intentionally outside
;; the pure/speculatable subset even when all operands and uses are invariant.
(define (opt-licm-simd-trap-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Splat
          10
          (compiler_ir_types.CompilerIrValue.Var 1)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Splat
          11
          (compiler_ir_types.CompilerIrValue.Var 2)
          4
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "loop"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "loop")
        (opt-test-instrs
          (compiler_ir_types.ir-instr-vector-bin-op
            4
            (compiler_ir_types.CompilerIrBinOp.Div)
            (compiler_ir_types.CompilerIrValue.Var 10)
            (compiler_ir_types.CompilerIrValue.Var 11)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.VectorReduce
            5
            (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
            (compiler_ir_types.CompilerIrValue.Var 4)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.compiler-ir-label "exit"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (compiler-optimize-licm-simd-self-test) : i64
  (let
    [chain-func : compiler_ir_types.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-simd-chain-blocks))]
    [chain : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (owned_view.compiler-owned-shared-view chain-func))]
    [mixed-func : compiler_ir_types.CompilerIrFunction
      (opt-licm-optimized-function (opt-licm-simd-mixed-blocks))]
    [mixed : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (owned_view.compiler-owned-shared-view mixed-func))]
    [cold : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-licm-optimized-function (opt-licm-simd-cold-blocks)))]
    [sibling : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-licm-optimized-function (opt-licm-simd-sibling-blocks)))]
    [trap : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (opt-licm-optimized-function (opt-licm-simd-trap-blocks)))]
    [entry : i64 (compiler_ir_types.compiler-ir-label "entry")]
    [loop : i64 (compiler_ir_types.compiler-ir-label "loop")]
    (cond
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (owned_view.compiler-owned-shared-view chain-func))))
        1]
      [(not
          (compiler_optimize.opt-verify-ok?
            (compiler_optimize.opt-verify-function
              (owned_view.compiler-owned-shared-view mixed-func))))
        2]
      [(not (= (opt-licm-simd-kind-at (& chain) entry 4) 1)) 3]
      [(not (= (opt-licm-simd-kind-at (& chain) entry 5) 2)) 4]
      [(not (= (opt-licm-simd-kind-at (& chain) entry 6) 3)) 5]
      [(not (= (opt-licm-simd-kind-at (& chain) loop 4) 0)) 6]
      [(not (= (opt-licm-simd-kind-at (& chain) loop 5) 0)) 7]
      [(not (= (opt-licm-simd-kind-at (& chain) loop 6) 0)) 8]
      [(not
          (<
            (opt-licm-simd-index-at (& chain) entry 4)
            (opt-licm-simd-index-at (& chain) entry 5)))
        9]
      [(not
          (<
            (opt-licm-simd-index-at (& chain) entry 5)
            (opt-licm-simd-index-at (& chain) entry 6)))
        10]
      ;; No scalar Mov was substituted for any SIMD destination.
      [(= (opt-licm-simd-kind-at (& chain) entry 4) 4) 11]
      [(= (opt-licm-simd-kind-at (& chain) entry 5) 4) 12]
      [(= (opt-licm-simd-kind-at (& chain) entry 6) 4) 13]
      ;; The invariant prefix moves; the loop-carried splat and everything
      ;; depending on it remain in the loop.
      [(not (= (opt-licm-simd-kind-at (& mixed) entry 5) 1)) 14]
      [(not (= (opt-licm-simd-kind-at (& mixed) loop 6) 1)) 15]
      [(not (= (opt-licm-simd-kind-at (& mixed) loop 7) 2)) 16]
      [(not (= (opt-licm-simd-kind-at (& mixed) loop 8) 3)) 17]
      ;; Cold-only values retain their original forms in the header.
      [(not (= (opt-licm-simd-kind-at (& cold) loop 4) 1)) 18]
      [(not (= (opt-licm-simd-kind-at (& cold) loop 5) 2)) 19]
      [(not (= (opt-licm-simd-kind-at (& cold) loop 6) 3)) 20]
      ;; A producer available only on a sibling cannot seed an invariant chain.
      [(not
          (=
            (opt-licm-simd-kind-at
              (& sibling)
              (compiler_ir_types.compiler-ir-label "left")
              4)
            1))
        21]
      [(not
          (=
            (opt-licm-simd-kind-at
              (& sibling)
              (compiler_ir_types.compiler-ir-label "right")
              5)
            2))
        22]
      [(not
          (=
            (opt-licm-simd-kind-at
              (& sibling)
              (compiler_ir_types.compiler-ir-label "right")
              6)
            3))
        23]
      [(not (= (opt-licm-simd-kind-at (& trap) loop 4) 2)) 24]
      [else 42])))

