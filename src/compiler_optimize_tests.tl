;; Dominated bounds-dedup fixture: entry checks (idx,len); the dominated mid /
;; left / exit blocks re-check the same pair (removable), while a different
;; length, a multi-def index, and a sibling block that only sees the multi-def
;; var must all keep their checks.
(define (opt-bounds-dom-test-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "cond"
      (compiler_ast_types.AstType.Bool)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "idx"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "len2"
            (compiler_ast_types.AstType.I64)
            3)
          (compiler_ir_types.compiler-ir-param-seq-empty))))))

(define (opt-bounds-dom-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "e_ok"))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "mid"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "mid")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.compiler-ir-label "m_ok"))
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "m2_ok"))
          (compiler_ir_types.CompilerIrInstr.Mov
            5
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-label "left")
            (compiler_ir_types.compiler-ir-label "right"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "left")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.compiler-ir-label "l_ok"))
            (compiler_ir_types.CompilerIrInstr.Mov
              5
              (compiler_ir_types.CompilerIrValue.I64 2)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.compiler-ir-label "l2_ok"))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "right")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BoundsCheck
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ir_types.compiler-ir-label "r_ok"))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "join")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.BoundsCheck
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.CompilerIrValue.Var 2)
                  (compiler_ir_types.compiler-ir-label "j_ok"))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 1)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (compiler-optimize-bounds-dom-self-test) : i64
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-dom-test-blocks)]
    [before : i64
      (compiler_optimize.opt-count-bounds-blocks
        (compiler_optimize.compiler-opt-global-shared-view blocks))]
    [after-blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-bounds-dom-blocks-with-context
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.opt-cfg-context-build
          (compiler_optimize.compiler-opt-global-shared-view blocks))
        (opt-bounds-dom-test-params)
        8
        blocks)]
    [after : i64
      (compiler_optimize.opt-count-bounds-blocks
        (compiler_optimize.compiler-opt-global-shared-view after-blocks))]
    (cond
      [(not (= before 7)) 1]
      ;; kept: entry (first), mid's different-length, left's multi-def index,
      ;; right's multi-def index. dropped: mid/left/join duplicates of
      ;; (idx,len). The fixture is intentionally multi-def (the negative
      ;; case), so a full verify does not apply; the pass only deletes
      ;; mid-block instructions, checked structurally below.
      [(not (= after 4)) 2]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view after-blocks))
            5))
        3]
      [(not (compiler_optimize.opt-cfg-successor-targets-known? after-blocks))
        4]
      [else 42])))

;; Native Slice lowering re-extracts the two-word parameter group at every
;; access. The first successful `(index, length)` check must therefore dominate
;; later checks even when their length Words have distinct SSA destinations and
;; an element store lies between them. A different Slice is a different fact;
;; taking the original parameter's storage address disables the specialization.
(define (opt-bounds-dom-slice-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "left"
      (compiler_ast_types.ast-ty-ref
        0
        (compiler_ast_types.ast-ty-slice (compiler_ast_types.AstType.I64)))
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "right"
        (compiler_ast_types.ast-ty-mut-ref
          0
          (compiler_ast_types.ast-ty-slice (compiler_ast_types.AstType.I64)))
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "index"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

(define (opt-bounds-dom-slice-entry-instrs [address-taken? : bool]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [tail : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Word
          4
          (compiler_ir_types.CompilerIrValue.Var 0)
          1
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ir_types.compiler-ir-label "slice_entry_ok"))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "mid")))]
    (if address-taken?
      (opt-test-instrs-with-tail
        tail
        (compiler_ir_types.CompilerIrInstr.AddrOf 10 0))
      tail)))

(define (opt-bounds-dom-slice-mid-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Word
      5
      (compiler_ir_types.CompilerIrValue.Var 0)
      0
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Gep
      6
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.StorePtr
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ir_types.CompilerIrValue.I64 9)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Word
      7
      (compiler_ir_types.CompilerIrValue.Var 0)
      1
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ir_types.compiler-ir-label "slice_same_ok"))
    (compiler_ir_types.CompilerIrInstr.Word
      8
      (compiler_ir_types.CompilerIrValue.Var 1)
      1
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BoundsCheck
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ir_types.compiler-ir-label "slice_other_ok"))
    (compiler_ir_types.CompilerIrInstr.Jump
      (compiler_ir_types.compiler-ir-label "exit"))))

(define (opt-bounds-dom-slice-blocks [address-taken? : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-bounds-dom-slice-entry-instrs address-taken?))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "mid")
        (opt-bounds-dom-slice-mid-instrs))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "exit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Word
              9
              (compiler_ir_types.CompilerIrValue.Var 0)
              1
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.Var 9)
              (compiler_ir_types.compiler-ir-label "slice_exit_ok"))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-bounds-dom-slice-run
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-bounds-dom-blocks-with-context
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-cfg-context-build
      (compiler_ir_types.compiler-ir-global-shared-view blocks))
    (opt-bounds-dom-slice-params)
    11
    blocks))

(define (compiler-optimize-bounds-dom-slice-word-self-test) : i64
  (let
    [input : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-dom-slice-blocks false)]
    [after : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-dom-slice-run
        (compiler_ir_types.compiler-ir-global-shared-view input))]
    [again : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-dom-slice-run
        (compiler_ir_types.compiler-ir-global-shared-view after))]
    [escaped-input : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-dom-slice-blocks true)]
    [escaped-after : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-dom-slice-run escaped-input)]
    (cond
      [(not
          (=
            (compiler_optimize.opt-count-bounds-blocks
              (compiler_ir_types.compiler-ir-global-shared-view input))
            4))
        1]
      ;; Kept: the first check for `left`, and the independent `right` check.
      ;; Dropped: both dominated re-extractions of `left`'s stable length.
      [(not
          (=
            (compiler_optimize.opt-count-bounds-blocks
              (compiler_ir_types.compiler-ir-global-shared-view after))
            2))
        2]
      [(not (= (compiler_optimize.opt-count-bounds-blocks again) 2)) 3]
      ;; AddrOf makes `left`'s register-group storage mutable, so all four
      ;; differently-named lengths remain conservative.
      [(not (= (compiler_optimize.opt-count-bounds-blocks escaped-after) 4)) 4]
      [(not
          (compiler_optimize.opt-cfg-successor-targets-known?
            (compiler_ir_types.compiler-ir-global-shared-view after)))
        5]
      [else 42])))

;; --- unsigned range-check merge ----------------------------------------------
;;
;; `(and (>= i 0) (< i n))` is one unsigned compare when `n` is non-negative.
;; The fixture is the short-circuit diamond the front end emits: a lower-bound
;; block branching into a two-instruction upper-bound block, both false edges on
;; one failure arm. Knobs cover the four lower spellings, both upper operand
;; orders, whether the bound is provably non-negative, an extra consumer of the
;; lower compare, and a split failure arm.
;;
;; Params: idx = %0, len = %1, probe = %2. Fresh casts start at the frame, 16.
(define (opt-range-merge-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "idx"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "len"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "probe"
          (compiler_ast_types.AstType.I64)
          2)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

;; 0 `ge i 0`, 1 `gt i -1`, 2 `le 0 i`, 3 `lt -1 i`.
(define (opt-range-merge-low-instr [kind : i64]) : compiler_ir_types.CompilerIrInstr
  (cond
    [(= kind 0)
      (compiler_ir_types.CompilerIrInstr.BinOp
        3
        (compiler_ir_types.CompilerIrBinOp.Ge)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ast_types.AstType.I64))]
    [(= kind 1)
      (compiler_ir_types.CompilerIrInstr.BinOp
        3
        (compiler_ir_types.CompilerIrBinOp.Gt)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
        (compiler_ast_types.AstType.I64))]
    [(= kind 2)
      (compiler_ir_types.CompilerIrInstr.BinOp
        3
        (compiler_ir_types.CompilerIrBinOp.Le)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.I64))]
    [else
      (compiler_ir_types.CompilerIrInstr.BinOp
        3
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.I64))]))

;; 0 `lt i bound`, 1 `gt bound i`. `bound` is `len` (%1), which the true arm
;; bounds-checks against, or `probe` (%2), which nothing ever checks -- the
;; negative case for the non-negativity gate.
(define (opt-range-merge-high-instr [kind : i64] [bound : i64]) : compiler_ir_types.CompilerIrInstr
  (if (= kind 0)
    (compiler_ir_types.CompilerIrInstr.BinOp
      4
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var bound)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      4
      (compiler_ir_types.CompilerIrBinOp.Gt)
      (compiler_ir_types.CompilerIrValue.Var bound)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))))

(define (opt-range-merge-low-instrs
  [low-kind : i64]
  [extra-use? : bool]
  [low-fail : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if extra-use?
    (opt-test-instrs
      (opt-range-merge-low-instr low-kind)
      (compiler_ir_types.CompilerIrInstr.Mov
        10
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ast_types.AstType.Bool))
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.compiler-ir-label "high")
        low-fail))
    (opt-test-instrs
      (opt-range-merge-low-instr low-kind)
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.compiler-ir-label "high")
        low-fail))))

(define (opt-range-merge-blocks
  [low-kind : i64]
  [high-kind : i64]
  [bound : i64]
  [extra-use? : bool]
  [split-arms? : bool]) : compiler_ir_types.CompilerIrBlockList
  (let
    [low-fail : i64
      (compiler_ir_types.compiler-ir-label
        (if split-arms?
          "fail_low"
          "fail"))]
    [high-fail : i64
      (compiler_ir_types.compiler-ir-label
        (if split-arms?
          "fail_high"
          "fail"))]
    [tail : compiler_ir_types.CompilerIrBlockList
      (if split-arms?
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "fail_low")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "fail"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "fail_high")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "fail"))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))
        (compiler_ir_types.CompilerIrBlockList.Nil))]
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "low"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "low")
          (opt-range-merge-low-instrs low-kind extra-use? low-fail))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "high")
            (opt-test-instrs
              (opt-range-merge-high-instr high-kind bound)
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ir_types.compiler-ir-label "ok")
                high-fail)))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "ok")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.BoundsCheck
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ir_types.CompilerIrValue.Var 1)
                  (compiler_ir_types.compiler-ir-label "ok_ok"))
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 0)))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "fail")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))))))
              tail)))))))

;; Already-merged shape, hand-written the way the fold leaves it. The
;; `bounds_check` below it is the round-two question: the SIGNED component facts
;; are gone, and only the unsigned reading of the merged guard can discharge it.
(define (opt-range-merge-merged-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Cast
          5
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Cast
          6
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          7
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 5)
          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 7)
          (compiler_ir_types.compiler-ir-label "ok")
          (compiler_ir_types.compiler-ir-label "fail"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "ok")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "ok_ok"))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "fail")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 (- 0 1))))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-range-merge-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (match (compiler_optimize.opt-bounds-dom-blocks-with-context-result
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-cfg-context-build
      (compiler_optimize.compiler-opt-global-shared-view blocks))
    (opt-range-merge-params)
    16
    (opt_i64_i64_map.with-capacity 1)
    (compiler_optimize.opt-len-eq-use-empty)
    blocks)
    [(compiler_optimize.OptBoundsDomResult.Result result _) result]))

(define (opt-range-merge-run-frame
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match (compiler_optimize.opt-bounds-dom-blocks-with-context-result
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-cfg-context-build
      (compiler_optimize.compiler-opt-global-shared-view blocks))
    (opt-range-merge-params)
    16
    (opt_i64_i64_map.with-capacity 1)
    (compiler_optimize.opt-len-eq-use-empty)
    blocks)
    [(compiler_optimize.OptBoundsDomResult.Result _ frame) frame]))

(define (opt-range-merge-count-instrs
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pos : i64]) : i64
  (if (>= pos (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    0
    (+
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs pos)
        [(compiler_ir_types.CompilerIrInstr.BinOp _ _ _ _ ty)
          (match ty
            [(compiler_ast_types.AstType.U64) 1]
            [_ 0])]
        [_ 0])
      (opt-range-merge-count-instrs instrs (+ pos 1)))))

;; How many unsigned-typed comparisons the output holds.
(define (opt-range-merge-count-unsigned
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match (compiler_optimize.compiler-opt-global-shared-view blocks)
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-range-merge-count-instrs instrs 0)
            (opt-range-merge-count-unsigned
              (compiler_optimize.compiler-opt-box-shared-view rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-range-merge-count-unsigned
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-range-merge-true-instrs?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [pos : i64]
  [var : i64]) : bool
  (if (>= pos (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    false
    (if (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs pos)
      [(compiler_ir_types.CompilerIrInstr.Mov dst src _)
        (and
          (= dst var)
          (match src
            [(compiler_ir_types.CompilerIrValue.Bool value) value]
            [_ false]))]
      [_ false])
      true
      (opt-range-merge-true-instrs? instrs (+ pos 1) var))))

;; Is `var` defined by `mov true` -- the upper compare the merge discharged?
(define (opt-range-merge-true?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [var : i64]) : bool
  (match (compiler_optimize.compiler-opt-global-shared-view blocks)
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (or
            (opt-range-merge-true-instrs? instrs 0 var)
            (opt-range-merge-true?
              (compiler_optimize.compiler-opt-box-shared-view rest)
              var))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-range-merge-true?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        var)]))

;; One knob combination merged: exactly one unsigned compare, the upper compare
;; retired to `true`, two fresh cast vars, and the dominated duplicate check the
;; true arm holds still discharged (the component facts are not lost).
(define (opt-range-merge-case-merged?
  [low-kind : i64]
  [high-kind : i64]
  [split-arms? : bool]) : bool
  (let
    [input : compiler_ir_types.CompilerIrBlockList
      (opt-range-merge-blocks low-kind high-kind 1 false split-arms?)]
    [after : compiler_ir_types.CompilerIrBlockList
      (opt-range-merge-run
        (opt-range-merge-blocks low-kind high-kind 1 false split-arms?))]
    [frame : i64
      (opt-range-merge-run-frame
        (opt-range-merge-blocks low-kind high-kind 1 false split-arms?))]
    (and
      (= (compiler_optimize.opt-count-bounds-blocks input) 1)
      (=
        (opt-range-merge-count-unsigned
          (compiler_optimize.compiler-opt-global-shared-view after))
        1)
      (opt-range-merge-true?
        (compiler_optimize.compiler-opt-global-shared-view after)
        4)
      (= frame 18)
      ;; The dominated duplicate the true arm holds is still discharged: the
      ;; merge did not cost the walk the component facts.
      (=
        (compiler_optimize.opt-count-bounds-blocks
          (compiler_optimize.compiler-opt-global-shared-view after))
        0)
      (compiler_optimize.opt-cfg-successor-targets-known?
        (compiler_optimize.compiler-opt-global-shared-view after)))))

(define (opt-range-merge-case-refused?
  [bound : i64]
  [extra-use? : bool]
  [split-arms? : bool]) : bool
  (let
    [after : compiler_ir_types.CompilerIrBlockList
      (opt-range-merge-run
        (opt-range-merge-blocks 0 0 bound extra-use? split-arms?))]
    [frame : i64
      (opt-range-merge-run-frame
        (opt-range-merge-blocks 0 0 bound extra-use? split-arms?))]
    (and
      (=
        (opt-range-merge-count-unsigned
          (compiler_optimize.compiler-opt-global-shared-view after))
        0)
      (not
        (opt-range-merge-true?
          (compiler_optimize.compiler-opt-global-shared-view after)
          4))
      (= frame 16))))

(define (compiler-optimize-range-merge-self-test) : i64
  (cond
    ;; (a) `(>= i 0) && (< i n)` with `n` a proven length, both operand orders.
    [(not (opt-range-merge-case-merged? 0 0 false)) 1]
    [(not (opt-range-merge-case-merged? 0 1 false)) 2]
    ;; (b) the `(> i -1)` spelling, and the two reversed lower spellings.
    [(not (opt-range-merge-case-merged? 1 0 false)) 3]
    [(not (opt-range-merge-case-merged? 2 0 false)) 4]
    [(not (opt-range-merge-case-merged? 3 1 false)) 5]
    ;; The two failure arms may be distinct one-`Jump` blocks onto one target.
    [(not (opt-range-merge-case-merged? 0 0 true)) 6]
    ;; (c) `n` NOT provably non-negative -- the bound is `probe`, which nothing
    ;; checks and no fact bounds: no merge.
    [(not (opt-range-merge-case-refused? 2 false false)) 7]
    [(not (opt-range-merge-case-refused? 2 false true)) 8]
    ;; (d) the lower compare has a second consumer, so its value must survive.
    [(not (opt-range-merge-case-refused? 1 true false)) 9]
    ;; (e) the merged spelling still discharges a dominated duplicate check --
    ;; the round-two question, where only the unsigned fact remains.
    [(not
        (=
          (compiler_optimize.opt-count-bounds-blocks
            (opt-range-merge-merged-blocks))
          1))
      10]
    [(not
        (=
          (compiler_optimize.opt-count-bounds-blocks
            (opt-range-merge-run (opt-range-merge-merged-blocks)))
          0))
      11]
    ;; Idempotent: the merged output is not a candidate for itself.
    [(not
        (=
          (opt-range-merge-count-unsigned
            (opt-range-merge-run
              (opt-range-merge-run (opt-range-merge-blocks 0 0 1 false false))))
          1))
      12]
    [else 42]))

;; --- whole-program non-negative scalar globals -------------------------------
;;
;; One program, eight `i64` globals, one function whose stores exercise each
;; admitted and each refused shape:
;;
;;   lit      <- 5                    literal, non-negative       ADMITTED
;;   neg      <- -3                   literal, negative           refused
;;   len      <- load (gep @text, 1)  a descriptor length word    ADMITTED
;;   plen     <- load (gep %p, 1)     a header PARAMETER's length ADMITTED
;;   counter  <- add @counter, 1      arithmetic can overflow     refused
;;   masked   <- bit-and %x, 63       mask clears the sign bit    ADMITTED
;;   alias-a  <- @alias-b             mutual dependence, both     ADMITTED
;;   alias-b  <- @alias-a             (the optimistic fixpoint)
;;   tainted  <- @counter             depends on a refused global refused
;;   escaped  <- 0                    address taken               refused
;;   init-neg <- (never stored)       negative initializer        refused
(defstruct OptNonnegTestSymbols
  (lit i64)
  (neg i64)
  (len i64)
  (plen i64)
  (counter i64)
  (masked i64)
  (alias-a i64)
  (alias-b i64)
  (tainted i64)
  (escaped i64)
  (init-neg i64)
  (text i64))

(define (opt-nonneg-test-symbols) : OptNonnegTestSymbols
  (OptNonnegTestSymbols
    (opt-test-symbol "nn_lit")
    (opt-test-symbol "nn_neg")
    (opt-test-symbol "nn_len")
    (opt-test-symbol "nn_plen")
    (opt-test-symbol "nn_counter")
    (opt-test-symbol "nn_masked")
    (opt-test-symbol "nn_alias_a")
    (opt-test-symbol "nn_alias_b")
    (opt-test-symbol "nn_tainted")
    (opt-test-symbol "nn_escaped")
    (opt-test-symbol "nn_init_neg")
    (opt-test-symbol "nn_text")))

(define (opt-nonneg-test-globals [symbols : OptNonnegTestSymbols]) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [builder : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 12)]
    (begin
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.lit
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.neg
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.len
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.plen
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.counter
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.masked
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.alias-a
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.alias-b
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.tainted
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.escaped
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.init-neg
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 (- 0 1)))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.text
        (compiler_ast_types.AstType.String)
        (compiler_ir_types.CompilerIrValue.Unit))
      (compiler_ir_types.compiler-ir-global-builder-to-seq builder))))

(define (opt-nonneg-test-instrs [symbols : OptNonnegTestSymbols]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    ;; lit <- 5
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.lit
      (compiler_ir_types.CompilerIrValue.I64 5)
      (compiler_ast_types.AstType.I64))
    ;; neg <- -3
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.neg
      (compiler_ir_types.CompilerIrValue.I64 (- 0 3))
      (compiler_ast_types.AstType.I64))
    ;; len <- (string-length @text): load (gep @text, 1) : i64
    (compiler_ir_types.CompilerIrInstr.Gep
      1
      (compiler_ir_types.CompilerIrValue.Global symbols.text)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      2
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.len
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64))
    ;; plen <- (array-length p), p the header parameter, through one Mov copy
    (compiler_ir_types.CompilerIrInstr.Gep
      3
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Load
      4
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      5
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.plen
      (compiler_ir_types.CompilerIrValue.Var 5)
      (compiler_ast_types.AstType.I64))
    ;; counter <- counter + 1
    (compiler_ir_types.CompilerIrInstr.BinOp
      6
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Global symbols.counter)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.counter
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ast_types.AstType.I64))
    ;; masked <- (bit-and opaque 63)
    (compiler_ir_types.CompilerIrInstr.BinOp
      7
      (compiler_ir_types.CompilerIrBinOp.BitAnd)
      (compiler_ir_types.CompilerIrValue.Var 4)
      (compiler_ir_types.CompilerIrValue.I64 63)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.masked
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ast_types.AstType.I64))
    ;; alias-a <- @alias-b, alias-b <- @alias-a
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.alias-a
      (compiler_ir_types.CompilerIrValue.Global symbols.alias-b)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.alias-b
      (compiler_ir_types.CompilerIrValue.Global symbols.alias-a)
      (compiler_ast_types.AstType.I64))
    ;; tainted <- @counter
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.tainted
      (compiler_ir_types.CompilerIrValue.Global symbols.counter)
      (compiler_ast_types.AstType.I64))
    ;; &escaped
    (compiler_ir_types.CompilerIrInstr.Mov
      8
      (compiler_ir_types.CompilerIrValue.GlobalAddr symbols.escaped)
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 2)))))

(define (opt-nonneg-test-functions [symbols : OptNonnegTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-test-symbol "nn_f")
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "p"
          (compiler_ast_types.ast-ty-dyn-array (compiler_ast_types.AstType.I64))
          0)
        (compiler_ir_types.compiler-ir-param-seq-empty))
      (compiler_ast_types.AstType.I64)
      16
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-nonneg-test-instrs symbols))
        (compiler_ir_types.CompilerIrBlockList.Nil)))
    (compiler_ir_types.compiler-ir-function-seq-empty)))

(define (compiler-optimize-nonneg-globals-self-test) : i64
  (let
    [symbols : OptNonnegTestSymbols (opt-nonneg-test-symbols)]
    [globals : compiler_ir_types.CompilerIrGlobalSeq
      (opt-nonneg-test-globals symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-nonneg-test-functions symbols)]
    [cell : compiler_optimize.OptGlobalCellSummary
      (compiler_optimize.opt-global-cell-summary-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        globals
        functions)]
    [table : opt_i64_i64_map.Map cell.nonneg]
    (cond
      ;; ADMITTED
      [(not (opt_i64_i64_map.contains? (& table) symbols.lit)) 1]
      [(not (opt_i64_i64_map.contains? (& table) symbols.len)) 2]
      [(not (opt_i64_i64_map.contains? (& table) symbols.plen)) 3]
      [(not (opt_i64_i64_map.contains? (& table) symbols.masked)) 4]
      ;; the optimistic fixpoint keeps a mutually dependent pair
      [(not (opt_i64_i64_map.contains? (& table) symbols.alias-a)) 5]
      [(not (opt_i64_i64_map.contains? (& table) symbols.alias-b)) 6]
      ;; REFUSED
      [(opt_i64_i64_map.contains? (& table) symbols.neg) 7]
      [(opt_i64_i64_map.contains? (& table) symbols.counter) 8]
      ;; the refusal propagates through the dependence edge
      [(opt_i64_i64_map.contains? (& table) symbols.tainted) 9]
      [(opt_i64_i64_map.contains? (& table) symbols.escaped) 10]
      [(opt_i64_i64_map.contains? (& table) symbols.init-neg) 11]
      ;; a descriptor global is not a scalar i64 candidate at all
      [(opt_i64_i64_map.contains? (& table) symbols.text) 12]
      [else 42])))

;; --- constant-offset runs: widening + ordered subsumption --------------------
;;
;; Six shapes over ONE base (`idx`, param 1) and two lengths (`len`, `len2`),
;; driving `opt-bounds-dom-blocks-with-context` end to end: the reordering
;; peephole and the bracket subsumption are two halves of one rule, so the
;; fixtures state what the pass must leave behind rather than which half acted.
;;
;;   0 increasing run idx, idx+1, idx+2 against `len` -- the `gvn-run-block`
;;     shape. The widest check (and its Add) move to the run's front and the
;;     middle check goes: TWO checks left, an Add first in the block.
;;   1 the same run with a STORE between its first two checks. Reordering a trap
;;     across an observable effect is exactly what the rule forbids, so all
;;     THREE stay.
;;   2 the same run against TWO lengths: no pair of facts brackets anything and
;;     all three stay.
;;   3 decreasing run idx+2, idx+1, idx -- `it-hash-words`' word loader. The
;;     narrowest check moves up beside the widest one: TWO left.
;;   4 a two-member run, idx+1 then idx, with the base's sign unknown: the lower
;;     bracket is missing and nothing is retired.
;;   5 shape 4 behind a dominating `idx >= 0`: the nonneg route supplies the
;;     lower bracket and the second check goes.
(define (opt-bounds-run-check
  [index : compiler_ir_types.CompilerIrValue]
  [length : compiler_ir_types.CompilerIrValue]
  [label : String]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BoundsCheck
    index
    length
    (compiler_ir_types.compiler-ir-label label)))

(define (opt-bounds-run-add [dst : i64] [offset : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    dst
    (compiler_ir_types.CompilerIrBinOp.Add)
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ir_types.CompilerIrValue.I64 offset)
    (compiler_ast_types.AstType.I64)))

(define (opt-bounds-run-return) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 1)))
    (compiler_ir_types.compiler-ir-instr-seq-empty)))

(define (opt-bounds-run-append
  [head : compiler_ir_types.CompilerIrInstrSeq]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-append head tail))

;; `gep len, 0` + `store_ptr`: the observable effect variant 1 puts between the
;; run's checks.
(define (opt-bounds-run-store) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (compiler_ir_types.CompilerIrInstr.Gep
      6
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64))
    (opt-test-instr-seq-prepend
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 6)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-seq-empty))))

(define (opt-bounds-run-length [variant : i64]) : compiler_ir_types.CompilerIrValue
  (if (= variant 2)
    (compiler_ir_types.CompilerIrValue.Var 3)
    (compiler_ir_types.CompilerIrValue.Var 2)))

(define (opt-bounds-run-increasing
  [variant : i64]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-bounds-run-check
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.Var 2)
      "run_ok0")
    (opt-bounds-run-append
      (if (= variant 1)
        (opt-bounds-run-store)
        (compiler_ir_types.compiler-ir-instr-seq-empty))
      (opt-test-instr-seq-prepend
        (opt-bounds-run-add 4 1)
        (opt-test-instr-seq-prepend
          (opt-bounds-run-check
            (compiler_ir_types.CompilerIrValue.Var 4)
            (opt-bounds-run-length variant)
            "run_ok1")
          (opt-test-instr-seq-prepend
            (opt-bounds-run-add 5 2)
            (opt-test-instr-seq-prepend
              (opt-bounds-run-check
                (compiler_ir_types.CompilerIrValue.Var 5)
                (opt-bounds-run-length variant)
                "run_ok2")
              tail)))))))

(define (opt-bounds-run-decreasing
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-bounds-run-add 5 2)
    (opt-test-instr-seq-prepend
      (opt-bounds-run-check
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.CompilerIrValue.Var 2)
        "run_ok2")
      (opt-test-instr-seq-prepend
        (opt-bounds-run-add 4 1)
        (opt-test-instr-seq-prepend
          (opt-bounds-run-check
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 2)
            "run_ok1")
          (opt-test-instr-seq-prepend
            (opt-bounds-run-check
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 2)
              "run_ok0")
            tail))))))

(define (opt-bounds-run-pair [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instr-seq-prepend
    (opt-bounds-run-add 4 1)
    (opt-test-instr-seq-prepend
      (opt-bounds-run-check
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 2)
        "run_ok1")
      (opt-test-instr-seq-prepend
        (opt-bounds-run-check
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 2)
          "run_ok0")
        tail))))

(define (opt-bounds-run-instrs
  [variant : i64]
  [tail : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrInstrSeq
  (cond
    [(<= variant 2) (opt-bounds-run-increasing variant tail)]
    [(= variant 3) (opt-bounds-run-decreasing tail)]
    [else (opt-bounds-run-pair tail)]))

;; Variant 5 puts the run behind a dominating `idx >= 0` edge, which is the only
;; way the offset-0 check of a two-member run can go.
(define (opt-bounds-run-test-blocks [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (if (= variant 5)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instr-seq-prepend
          (compiler_ir_types.CompilerIrInstr.BinOp
            7
            (compiler_ir_types.CompilerIrBinOp.Ge)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (opt-test-instr-seq-prepend
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 7)
              (compiler_ir_types.compiler-ir-label "guarded")
              (compiler_ir_types.compiler-ir-label "exit"))
            (compiler_ir_types.compiler-ir-instr-seq-empty))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "guarded")
          (opt-bounds-run-instrs
            variant
            (opt-test-instr-seq-prepend
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "exit"))
              (compiler_ir_types.compiler-ir-instr-seq-empty))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-bounds-run-return))
          (compiler_ir_types.CompilerIrBlockList.Nil))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-bounds-run-instrs variant (opt-bounds-run-return)))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-bounds-run-rewrite [variant : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (opt-bounds-run-test-blocks variant)]
    (compiler_optimize.opt-bounds-dom-blocks-with-context
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_optimize.opt-cfg-context-build
        (compiler_ir_types.compiler-ir-global-shared-view blocks))
      (opt-bounds-dom-test-params)
      16
      blocks)))

(define (opt-bounds-run-checks [variant : i64]) : i64
  (compiler_optimize.opt-count-bounds-blocks (opt-bounds-run-rewrite variant)))

;; Did the widening hoist the run's other bracket ahead of its first check? The
;; Add that computes the widest index is then the block's first instruction.
(define (opt-bounds-run-hoisted-add?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : String]) : bool
  (match (compiler_optimize.opt-cfg-find-block
    blocks
    (compiler_ir_types.compiler-ir-label
      (compiler_optimize.compiler-opt-global-shared-view label)))
    [(compiler_optimize.OptMaybeBlock.No) false]
    [(compiler_optimize.OptMaybeBlock.Some block)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (< (compiler_ir_types.compiler-ir-instr-seq-count instrs) 1)
            false
            (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
              [(compiler_ir_types.CompilerIrInstr.BinOp _ op _ rhs _)
                (and
                  (compiler_optimize.opt-binop-eq
                    op
                    (compiler_ir_types.CompilerIrBinOp.Add))
                  (match rhs
                    [(compiler_ir_types.CompilerIrValue.I64 offset)
                      (= offset 2)]
                    [_ false]))]
              [_ false]))])]))

(define (compiler-optimize-bounds-run-self-test) : i64
  (cond
    ;; the increasing run: two checks left, widest bracket hoisted to the front
    [(not (= (opt-bounds-run-checks 0) 2)) 1]
    [(not (opt-bounds-run-hoisted-add? (opt-bounds-run-rewrite 0) "entry")) 2]
    ;; an observable effect between the checks forbids the reordering
    [(not (= (opt-bounds-run-checks 1) 3)) 3]
    [(opt-bounds-run-hoisted-add? (opt-bounds-run-rewrite 1) "entry") 4]
    ;; two lengths: no bracket pair exists
    [(not (= (opt-bounds-run-checks 2) 3)) 5]
    ;; the decreasing run
    [(not (= (opt-bounds-run-checks 3) 2)) 6]
    ;; two members, unknown sign: the lower bracket is missing
    [(not (= (opt-bounds-run-checks 4) 2)) 7]
    ;; the same pair under a dominating `idx >= 0`
    [(not (= (opt-bounds-run-checks 5) 1)) 8]
    [else 42]))

(test
  bounds-dom-constant-offset-run-widening
  (test.assert-i64-eq
    (compiler-optimize-bounds-run-self-test)
    42
    "a constant-offset run against one length keeps only its two bracketing checks with the widest bracket hoisted to the run's front, while a store between the checks blocks the reordering, two lengths bracket nothing, and an offset below the run needs a dominating nonnegative fact"))

;; --- rule (a): a dominating fact decides a dominated compare -----------------
;;
;; The probes below drive `opt-dom-cmp-lookup` with a single fact in scope and
;; read its verdict as 0 unknown / 1 true / 2 false, which is exactly the
;; implication algebra without any CFG plumbing around it. The fixture after
;; them covers the two properties the algebra cannot see on its own: a fact is
;; only recorded for an operand the function defines once, and a bounds check an
;; equal-or-stronger dominating check subsumes is deleted.
(define (opt-rule-a-fact
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [value : bool]) : compiler_optimize.OptDomCmpFacts
  (compiler_optimize.OptDomCmpFacts.Cons
    (compiler_optimize.OptDomCmpFact.Fact op lhs rhs ty value 0)
    (box (compiler_optimize.OptDomCmpFacts.Nil))))

(define (opt-rule-a-probe
  [fact-op : compiler_ir_types.CompilerIrBinOp]
  [fact-lhs : compiler_ir_types.CompilerIrValue]
  [fact-rhs : compiler_ir_types.CompilerIrValue]
  [fact-ty : compiler_ast_types.AstType]
  [fact-value : bool]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]) : i64
  (match (compiler_optimize.opt-dom-cmp-lookup
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-rule-a-fact fact-op fact-lhs fact-rhs fact-ty fact-value)
    op
    lhs
    rhs
    ty)
    [(compiler_optimize.OptDomCmpLookup.No) 0]
    [(compiler_optimize.OptDomCmpLookup.Some decided)
      (if decided
        1
        2)]))

(define (opt-rule-a-var) : compiler_ir_types.CompilerIrValue
  (compiler_ir_types.CompilerIrValue.Var 1))

(define (opt-rule-a-other) : compiler_ir_types.CompilerIrValue
  (compiler_ir_types.CompilerIrValue.Var 2))

(define (opt-rule-a-lit [value : i64]) : compiler_ir_types.CompilerIrValue
  (compiler_ir_types.CompilerIrValue.I64 value))

;; Operator and type shorthands: the qualified constructors are what make a
;; probe list unreadable, and every probe below needs several.
(define (opt-rule-a-lt) : compiler_ir_types.CompilerIrBinOp
  (compiler_ir_types.CompilerIrBinOp.Lt))

(define (opt-rule-a-le) : compiler_ir_types.CompilerIrBinOp
  (compiler_ir_types.CompilerIrBinOp.Le))

(define (opt-rule-a-gt) : compiler_ir_types.CompilerIrBinOp
  (compiler_ir_types.CompilerIrBinOp.Gt))

(define (opt-rule-a-ge) : compiler_ir_types.CompilerIrBinOp
  (compiler_ir_types.CompilerIrBinOp.Ge))

(define (opt-rule-a-ne) : compiler_ir_types.CompilerIrBinOp
  (compiler_ir_types.CompilerIrBinOp.Ne))

(define (opt-rule-a-i64) : compiler_ast_types.AstType
  (compiler_ast_types.AstType.I64))

;; `v <fact-op> fact-k` decides `v <op> k`, both compares read in `ty`.
(define (opt-rule-a-typed-probe
  [fact-op : compiler_ir_types.CompilerIrBinOp]
  [fact-k : i64]
  [fact-value : bool]
  [op : compiler_ir_types.CompilerIrBinOp]
  [k : i64]
  [ty : compiler_ast_types.AstType]) : i64
  (opt-rule-a-probe
    fact-op
    (opt-rule-a-var)
    (opt-rule-a-lit fact-k)
    (compiler_optimize.compiler-opt-global-shared-view ty)
    fact-value
    op
    (opt-rule-a-var)
    (opt-rule-a-lit k)
    ty))

(define (opt-rule-a-lit-probe
  [fact-op : compiler_ir_types.CompilerIrBinOp]
  [fact-k : i64]
  [fact-value : bool]
  [op : compiler_ir_types.CompilerIrBinOp]
  [k : i64]) : i64
  (opt-rule-a-typed-probe fact-op fact-k fact-value op k (opt-rule-a-i64)))

;; The first failing case wins: once `previous` is non-zero it is carried
;; through unchanged, so the returned code names the EARLIEST mismatch.
(define (opt-rule-a-step [previous : i64] [code : i64] [got : i64] [want : i64]) : i64
  (if (!= previous 0)
    previous
    (if (= got want)
      0
      code)))

(define (compiler-optimize-dom-cmp-rule-a-self-test) : i64
  (let
    [fail : i64 0]
    (begin
      ;; (a) the identical compare, and its exact negation, still decide.
      (set!
        fail
        (opt-rule-a-step
          fail
          1
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-lt) 3)
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          2
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 false (opt-rule-a-lt) 3)
          2))
      ;; same operands, weaker operator: `i < 3` gives `i <= 3` and `i != 3`,
      ;; and refutes `i >= 3`.
      (set!
        fail
        (opt-rule-a-step
          fail
          3
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-le) 3)
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          4
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-ne) 3)
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          5
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-ge) 3)
          2))
      ;; `i > 0` decides `i >= 0`; `i >= 0` does NOT decide `i > 0`.
      (set!
        fail
        (opt-rule-a-step
          fail
          6
          (opt-rule-a-lit-probe (opt-rule-a-gt) 0 true (opt-rule-a-ge) 0)
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          7
          (opt-rule-a-lit-probe (opt-rule-a-ge) 0 true (opt-rule-a-gt) 0)
          0))
      ;; (b) a weaker literal: `i < 3` decides `i < 5`, and decides `i <= 2`
      ;; through the immediate-successor step.
      (set!
        fail
        (opt-rule-a-step
          fail
          8
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-lt) 5)
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          9
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 true (opt-rule-a-le) 2)
          1))
      ;; `i > 0` decides `i >= 1` (the successor step the other way round).
      (set!
        fail
        (opt-rule-a-step
          fail
          10
          (opt-rule-a-lit-probe (opt-rule-a-gt) 0 true (opt-rule-a-ge) 1)
          1))
      ;; `i >= 3` refutes `i < 2` and decides nothing about `i < 4`.
      (set!
        fail
        (opt-rule-a-step
          fail
          11
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 false (opt-rule-a-lt) 2)
          2))
      (set!
        fail
        (opt-rule-a-step
          fail
          12
          (opt-rule-a-lit-probe (opt-rule-a-lt) 3 false (opt-rule-a-lt) 4)
          0))
      ;; (d) the weaker literal only travels one way: `i < 5` says nothing
      ;; about `i < 3`, and a fact about another var never matches.
      (set!
        fail
        (opt-rule-a-step
          fail
          13
          (opt-rule-a-lit-probe (opt-rule-a-lt) 5 true (opt-rule-a-lt) 3)
          0))
      (set!
        fail
        (opt-rule-a-step
          fail
          14
          (opt-rule-a-probe
            (opt-rule-a-lt)
            (opt-rule-a-var)
            (opt-rule-a-lit 3)
            (opt-rule-a-i64)
            true
            (opt-rule-a-lt)
            (opt-rule-a-other)
            (opt-rule-a-lit 5)
            (opt-rule-a-i64))
          0))
      ;; two non-literal operands still decide through operand identity, in
      ;; either order: `i < n` refutes `n <= i`.
      (set!
        fail
        (opt-rule-a-step
          fail
          15
          (opt-rule-a-probe
            (opt-rule-a-lt)
            (opt-rule-a-var)
            (opt-rule-a-other)
            (opt-rule-a-i64)
            true
            (opt-rule-a-le)
            (opt-rule-a-other)
            (opt-rule-a-var)
            (opt-rule-a-i64))
          2))
      ;; (f) the literals are ordered in the FACT'S OWN type. Unsigned `i < 5`
      ;; decides `i < 0xffffffffffffffff`; the signed reading of the same two
      ;; literals puts `-1` BELOW `5`, where `i < 5` decides nothing.
      (set!
        fail
        (opt-rule-a-step
          fail
          16
          (opt-rule-a-typed-probe
            (opt-rule-a-lt)
            5
            true
            (opt-rule-a-lt)
            (- 0 1)
            (compiler_ast_types.AstType.U64))
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          17
          (opt-rule-a-lit-probe (opt-rule-a-lt) 5 true (opt-rule-a-lt) (- 0 1))
          0))
      ;; (f) a fact in one type never decides a compare in another.
      (set!
        fail
        (opt-rule-a-step
          fail
          18
          (opt-rule-a-probe
            (opt-rule-a-lt)
            (opt-rule-a-var)
            (opt-rule-a-lit 3)
            (compiler_ast_types.AstType.U64)
            true
            (opt-rule-a-lt)
            (opt-rule-a-var)
            (opt-rule-a-lit 3)
            (opt-rule-a-i64))
          0))
      ;; (f) the successor step refuses at the type's maximum, where `k + 1`
      ;; would wrap; the plain order still decides this one.
      (set!
        fail
        (opt-rule-a-step
          fail
          19
          (opt-rule-a-typed-probe
            (opt-rule-a-gt)
            127
            true
            (opt-rule-a-gt)
            (- 0 128)
            (compiler_ast_types.AstType.I8))
          1))
      ;; The transitive step: `i < n` and `n <= len` decide `i < len`, which
      ;; neither fact names both operands of.
      (set!
        fail
        (opt-rule-a-step
          fail
          20
          (opt-rule-a-chain-probe (opt-rule-a-le) (opt-rule-a-lt))
          1))
      (set!
        fail
        (opt-rule-a-step
          fail
          21
          (opt-rule-a-chain-probe (opt-rule-a-le) (opt-rule-a-le))
          1))
      ;; Two non-strict steps give only `i <= len`.
      (set!
        fail
        (opt-rule-a-step
          fail
          22
          (opt-rule-a-chain-probe-op
            (opt-rule-a-le)
            (opt-rule-a-le)
            (opt-rule-a-lt))
          0))
      (set!
        fail
        (opt-rule-a-step
          fail
          23
          (opt-rule-a-chain-probe-op
            (opt-rule-a-le)
            (opt-rule-a-le)
            (opt-rule-a-le))
          1))
      ;; A step in the WRONG direction chains nothing: `n >= len` leaves
      ;; `i < len` open.
      (set!
        fail
        (opt-rule-a-step
          fail
          24
          (opt-rule-a-chain-probe (opt-rule-a-ge) (opt-rule-a-lt))
          0))
      (if (= fail 0)
        42
        fail))))

;; `i <head-op> n` from one fact and `n <mid-op> len` from another, queried as
;; `i <op> len` -- the shape a versioned loop leaves behind, where the header
;; bounds the counter and the entry guard bounds the bound. Var 1 is `i`,
;; var 2 is `n`, var 3 is `len`.
(define (opt-rule-a-chain-probe-op
  [head-op : compiler_ir_types.CompilerIrBinOp]
  [mid-op : compiler_ir_types.CompilerIrBinOp]
  [op : compiler_ir_types.CompilerIrBinOp]) : i64
  (match (compiler_optimize.opt-dom-cmp-lookup-chained
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.OptDomCmpFacts.Cons
      (compiler_optimize.OptDomCmpFact.Fact
        head-op
        (opt-rule-a-var)
        (opt-rule-a-other)
        (opt-rule-a-i64)
        true
        0)
      (box (opt-rule-a-chain-tail-facts mid-op)))
    op
    (opt-rule-a-var)
    (compiler_ir_types.CompilerIrValue.Var 3)
    (opt-rule-a-i64))
    [(compiler_optimize.OptDomCmpLookup.No) 0]
    [(compiler_optimize.OptDomCmpLookup.Some decided)
      (if decided
        1
        2)]))

(define (opt-rule-a-chain-tail-facts
  [mid-op : compiler_ir_types.CompilerIrBinOp]) : compiler_optimize.OptDomCmpFacts
  (compiler_optimize.OptDomCmpFacts.Cons
    (compiler_optimize.OptDomCmpFact.Fact
      mid-op
      (opt-rule-a-other)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (opt-rule-a-i64)
      true
      0)
    (box (compiler_optimize.OptDomCmpFacts.Nil))))

;; `i < n` chained through `n <mid-op> len`, queried as `i <op> len`.
(define (opt-rule-a-chain-probe
  [mid-op : compiler_ir_types.CompilerIrBinOp]
  [op : compiler_ir_types.CompilerIrBinOp]) : i64
  (opt-rule-a-chain-probe-op (opt-rule-a-lt) mid-op op))

;; Rule (a) at CFG scope. `entry` branches on `idx < 3`; the true arm re-tests
;; the weaker `idx < 5` (folded) and checks `(idx, 8)`, which the dominating
;; `(idx, 4)` check subsumes -- 4 <= 8 and the passed check proves the index
;; nonnegative -- while `(idx, 2)` is not subsumed and stays. The false arm's
;; `idx >= 3` decides nothing about `idx < 5`, so that copy survives.
(define (opt-rule-a-cfg-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "idx"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-empty)))

(define (opt-rule-a-cfg-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          1
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "hit")
          (compiler_ir_types.compiler-ir-label "miss"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "hit")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 4)
            (compiler_ir_types.compiler-ir-label "h_ok"))
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ir_types.compiler-ir-label "h2_ok"))
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ir_types.compiler-ir-label "h3_ok"))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "miss")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BinOp
              3
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.I64 5)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; (c) The same shape with the compared operand REDEFINED. `n` is written in
;; two places, so it is not a single-source var and the guard's fact about it
;; is never recorded -- the dominated re-test must survive untouched.
(define (opt-rule-a-redef-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          1
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "hit")
          (compiler_ir_types.compiler-ir-label "join"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "hit")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 9)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "join")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (opt-rule-a-count-compares-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>=
    index
    (compiler_ir_types.compiler-ir-instr-seq-count
      (compiler_ir_types.compiler-ir-global-shared-view instrs)))
    acc
    (opt-rule-a-count-compares-seq
      (compiler_ir_types.compiler-ir-global-shared-view instrs)
      (+ index 1)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref
        (compiler_ir_types.compiler-ir-global-shared-view instrs)
        index)
        [(compiler_ir_types.CompilerIrInstr.BinOp _ _ _ _ _) (+ acc 1)]
        [_ acc]))))

(define (opt-rule-a-count-compares
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-rule-a-count-compares-seq instrs 0 0)
            (opt-rule-a-count-compares (deref rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-rule-a-count-compares
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-rule-a-run
  [params : compiler_ir_types.CompilerIrParamSeq]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-bounds-dom-blocks-with-context
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-cfg-context-build
      (compiler_optimize.compiler-opt-global-shared-view blocks))
    params
    8
    blocks))

(define (compiler-optimize-dom-cmp-rule-a-cfg-self-test) : i64
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList (opt-rule-a-cfg-blocks)]
    [after-blocks : compiler_ir_types.CompilerIrBlockList
      (opt-rule-a-run
        (opt-rule-a-cfg-params)
        (compiler_optimize.compiler-opt-global-shared-view blocks))]
    [redef : compiler_ir_types.CompilerIrBlockList (opt-rule-a-redef-blocks)]
    [after-redef : compiler_ir_types.CompilerIrBlockList
      (opt-rule-a-run
        (compiler_ir_types.compiler-ir-param-seq-empty)
        (compiler_optimize.compiler-opt-global-shared-view redef))]
    (cond
      [(not
          (=
            (compiler_optimize.opt-count-bounds-blocks
              (compiler_optimize.compiler-opt-global-shared-view blocks))
            3))
        1]
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_ir_types.compiler-ir-global-shared-view blocks))
            3))
        2]
      ;; (e) kept: the dominating `(idx, 4)` check and the unsubsumed
      ;; `(idx, 2)`. dropped: `(idx, 8)`, which `(idx, 4)` subsumes.
      [(not
          (=
            (compiler_optimize.opt-count-bounds-blocks
              (compiler_optimize.compiler-opt-global-shared-view after-blocks))
            2))
        3]
      ;; (b) folded: `idx < 5` on the true arm. kept: the branch's own compare
      ;; and the false arm's copy, which `idx >= 3` does not decide.
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view after-blocks))
            2))
        4]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_ir_types.compiler-ir-global-shared-view after-blocks))
            4))
        5]
      [(not (compiler_optimize.opt-cfg-successor-targets-known? after-blocks))
        6]
      ;; (c) nothing folds when the compared operand is redefined between.
      [(not (= (opt-rule-a-count-compares redef) 2)) 7]
      [(not (= (opt-rule-a-count-compares after-redef) 2)) 8]
      [else 42])))

;; --- rule (phi): a compare every joining edge already decided ---------------
;;
;; One rotated-loop fixture in three shapes, driven through the same pass entry
;; the rule-a fixtures use. `mode` selects:
;;
;;   0 ADMITTED. The entry test enters the landing pad on its TRUE edge and the
;;     latch re-tests the same predicate of the values it carries, so both edges
;;     into the header decide `lo < hi` the same way and the header's own copy
;;     folds to a constant. The landing pad is the one-hop shape: it does not
;;     branch itself, so its own sole entry edge is what answers.
;;   1 REFUSED, edges disagree. The only change is that the entry test enters
;;     the landing pad on its FALSE edge: that edge now proves `lo >= hi` while
;;     the latch still proves `lo < hi`, so the two verdicts conflict.
;;   2 REFUSED, one edge decides nothing. The only change is the latch testing
;;     the stepped value against a DIFFERENT bound.
;;
;; vars: 0 lo (param), 1 hi (param), 8 other (param), 2 entry test, 3 header
;; phi, 5 stepped, 6 header test (the fold's target), 7 latch test.
(define (opt-phi-carried-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "lo"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "hi"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "other"
          (compiler_ast_types.AstType.I64)
          8)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

(define (opt-phi-carried-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label
            (if (= mode 1)
              "exit"
              "land"))
          (compiler_ir_types.compiler-ir-label
            (if (= mode 1)
              "land"
              "exit")))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "land")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "header"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "header")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Phi
              3
              (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.compiler-ir-label "land")
                (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                  (compiler_ir_types.CompilerIrValue.Var 5)
                  (compiler_ir_types.compiler-ir-label "latch")
                  (compiler_ir_types.compiler-ir-phi-input-seq-empty)))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.BinOp
              6
              (compiler_ir_types.CompilerIrBinOp.Lt)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.compiler-ir-label "latch")
              (compiler_ir_types.compiler-ir-label "exit"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "latch")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.BinOp
                5
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.BinOp
                7
                (compiler_ir_types.CompilerIrBinOp.Lt)
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.CompilerIrValue.Var
                  (if (= mode 2)
                    8
                    1))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 7)
                (compiler_ir_types.compiler-ir-label "header")
                (compiler_ir_types.compiler-ir-label "exit"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "exit")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 1)))))
            (compiler_ir_types.CompilerIrBlockList.Nil)))))))

(define (opt-phi-carried-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-bounds-dom-blocks-with-context
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-cfg-context-build
      (compiler_optimize.compiler-opt-global-shared-view blocks))
    (opt-phi-carried-params)
    12
    blocks))

(define (compiler-optimize-dom-cmp-phi-carried-self-test) : i64
  (let
    [admitted : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-blocks 0)]
    [after : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-run
        (compiler_optimize.compiler-opt-global-shared-view admitted))]
    ;; IDEMPOTENCE: the rewritten function is a fixed point of the same pass.
    [again : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-run
        (compiler_optimize.compiler-opt-global-shared-view after))]
    [disagree : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-blocks 1)]
    [after-disagree : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-run
        (compiler_optimize.compiler-opt-global-shared-view disagree))]
    [undecided : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-blocks 2)]
    [after-undecided : compiler_ir_types.CompilerIrBlockList
      (opt-phi-carried-run
        (compiler_optimize.compiler-opt-global-shared-view undecided))]
    (cond
      ;; four BinOps go in: the entry test, the header test, the step, the
      ;; latch test.
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view admitted))
            4))
        1]
      ;; ADMITTED: the header test became a Mov; nothing else moved.
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view after))
            3))
        2]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_optimize.compiler-opt-global-shared-view after))
            5))
        3]
      [(not
          (compiler_optimize.opt-cfg-successor-targets-known?
            (compiler_optimize.compiler-opt-global-shared-view after)))
        4]
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view again))
            3))
        5]
      [(not
          (=
            (compiler_ir_types.compiler-ir-block-list-count
              (compiler_optimize.compiler-opt-global-shared-view again))
            5))
        6]
      ;; REFUSED (edges disagree): all four survive.
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view disagree))
            4))
        7]
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view after-disagree))
            4))
        8]
      ;; REFUSED (one edge decides nothing): all four survive.
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view undecided))
            4))
        9]
      [(not
          (=
            (opt-rule-a-count-compares
              (compiler_optimize.compiler-opt-global-shared-view
                after-undecided))
            4))
        10]
      [else 42])))

;; --- rule (branch): a BRANCH a dominating branch already decided ------------
;;
;; GVN unifies the dominated duplicate compare with the dominating one, so the
;; dominated block holds `Mov c2 = c1` plus `branch c2` and no comparison at
;; all: the compare fold has nothing to rewrite and only the branch itself can
;; be decided. `mode` selects the shape (vars: 0 idx, 1 len, 8 other are
;; parameters; 2 the deciding compare, 3 the dominated condition, 4 an opaque
;; test, 5/6/9/10 the u64 casts):
;;
;;   0 the TRUE edge of a dominating branch on the same compare.
;;   1 the FALSE edge of the same branch, which decides the negation.
;;   2 a passed `bounds_check idx,len`, which records `0 <= idx < len`; the
;;     branch sits below it in a block holding no comparison.
;;   3 the compare's operands are `cast i64 -> u64` of the deciding branch's
;;     operands, spelled with FRESH cast destinations, so only the pass's cast
;;     canonicalization makes the two compares the same question.
;;   4 REFUSED: the branch sits at a JOIN the deciding edge does not dominate.
(define (opt-branch-fold-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "idx"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "len"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "other"
          (compiler_ast_types.AstType.I64)
          8)
        (compiler_ir_types.compiler-ir-param-seq-empty)))))

(define (opt-branch-fold-entry-instrs [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (cond
    [(= mode 2)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "e_ok"))
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          4
          (compiler_ir_types.CompilerIrBinOp.Ne)
          (compiler_ir_types.CompilerIrValue.Var 8)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ir_types.compiler-ir-label "hit")
          (compiler_ir_types.compiler-ir-label "miss")))]
    [(= mode 3)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Cast
          5
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Cast
          6
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 5)
          (compiler_ir_types.CompilerIrValue.Var 6)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "hit")
          (compiler_ir_types.compiler-ir-label "miss")))]
    [else
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label
            (if (= mode 1)
              "miss"
              "hit"))
          (compiler_ir_types.compiler-ir-label
            (if (= mode 1)
              "hit"
              "miss"))))]))

(define (opt-branch-fold-hit-instrs [mode : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (cond
    [(= mode 2)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.compiler-ir-label "inner")
          (compiler_ir_types.compiler-ir-label "alt")))]
    [(= mode 3)
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Cast
          9
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Cast
          10
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          3
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 9)
          (compiler_ir_types.CompilerIrValue.Var 10)
          (compiler_ast_types.AstType.U64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.compiler-ir-label "inner")
          (compiler_ir_types.compiler-ir-label "alt")))]
    [else
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.compiler-ir-label "inner")
          (compiler_ir_types.compiler-ir-label "alt")))]))

(define (opt-branch-fold-tail-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "miss")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "join"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "inner")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "join"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "alt")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Return
                (compiler_ir_types.CompilerIrMaybeValue.Some
                  (compiler_ir_types.CompilerIrValue.Var 0)))))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-branch-fold-blocks [mode : i64]) : compiler_ir_types.CompilerIrBlockList
  (if (= mode 4)
    ;; The deciding branch's two arms meet at `merge`, which the true edge does
    ;; not dominate, so no fact reaches the branch there.
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-branch-fold-entry-instrs 0))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "hit")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "merge"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "miss")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "merge"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "merge")
              (opt-branch-fold-hit-instrs 0))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "inner")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "join"))))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "alt")
                  (opt-test-instrs
                    (compiler_ir_types.CompilerIrInstr.Jump
                      (compiler_ir_types.compiler-ir-label "join"))))
                (compiler_ir_types.compiler-ir-block-cons
                  (compiler_ir_types.CompilerIrBlock.Block
                    (compiler_ir_types.compiler-ir-label "join")
                    (opt-test-instrs
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 0)))))
                  (compiler_ir_types.CompilerIrBlockList.Nil))))))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-branch-fold-entry-instrs mode))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "hit")
          (opt-branch-fold-hit-instrs mode))
        (opt-branch-fold-tail-blocks)))))

;; A diamond whose dominated branch is decided TRUE and whose dead arm carries
;; one input of the merge phi: the CFG cleanup that runs below this pass must
;; drop exactly that input and the block it came from.
(define (opt-branch-fold-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-branch-fold-entry-instrs 0))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "hit")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "inner")
            (compiler_ir_types.compiler-ir-label "alt"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "inner")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Mov
              4
              (compiler_ir_types.CompilerIrValue.I64 7)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "join"))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "alt")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Mov
                5
                (compiler_ir_types.CompilerIrValue.I64 9)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "join"))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "miss")
              (opt-test-instrs
                (compiler_ir_types.CompilerIrInstr.Mov
                  6
                  (compiler_ir_types.CompilerIrValue.I64 5)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "join"))))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.CompilerIrBlock.Block
                (compiler_ir_types.compiler-ir-label "join")
                (opt-test-instrs
                  (compiler_ir_types.CompilerIrInstr.Phi
                    7
                    (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                      (compiler_ir_types.CompilerIrValue.Var 4)
                      (compiler_ir_types.compiler-ir-label "inner")
                      (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                        (compiler_ir_types.CompilerIrValue.Var 5)
                        (compiler_ir_types.compiler-ir-label "alt")
                        (compiler_ir_types.compiler-ir-phi-input-seq-prepend
                          (compiler_ir_types.CompilerIrValue.Var 6)
                          (compiler_ir_types.compiler-ir-label "miss")
                          (compiler_ir_types.compiler-ir-phi-input-seq-empty))))
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 7)))))
              (compiler_ir_types.CompilerIrBlockList.Nil))))))))

;; `want` is 1 for a branch decided TRUE and 0 for one decided FALSE.
(define (opt-branch-fold-count-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [want : i64]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (let
      [next-acc : i64
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          [(compiler_ir_types.CompilerIrInstr.Branch cond _ _)
            (match cond
              [(compiler_ir_types.CompilerIrValue.Bool known)
                (if known
                  (if (= want 1)
                    (+ acc 1)
                    acc)
                  (if (= want 1)
                    acc
                    (+ acc 1)))]
              [_ acc])]
          [_ acc])]
      (opt-branch-fold-count-seq instrs want (+ index 1) next-acc))))

(define (opt-branch-fold-count
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [want : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-branch-fold-count-seq instrs want 0 0)
            (opt-branch-fold-count (deref rest) want))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-branch-fold-count
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        want)]))

(define (opt-branch-fold-phi-inputs-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    acc
    (let
      [next-acc : i64
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
          [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
            (+ acc (compiler_ir_types.compiler-ir-phi-input-seq-count inputs))]
          [_ acc])]
      (opt-branch-fold-phi-inputs-seq instrs (+ index 1) next-acc))))

(define (opt-branch-fold-phi-inputs
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (+
            (opt-branch-fold-phi-inputs-seq instrs 0 0)
            (opt-branch-fold-phi-inputs (deref rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-branch-fold-phi-inputs
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (opt-branch-fold-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-bounds-dom-blocks-with-context
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_optimize.opt-cfg-context-build
      (compiler_optimize.compiler-opt-global-shared-view blocks))
    (opt-branch-fold-params)
    12
    blocks))

(define (opt-branch-fold-count-is?
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [want : i64]
  [expected : i64]) : bool
  (=
    (opt-branch-fold-count
      (owned_view.compiler-owned-reference-shared-view blocks)
      want)
    expected))

(define (opt-branch-fold-block-count-is?
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [expected : i64]) : bool
  (=
    (compiler_ir_types.compiler-ir-block-list-count
      (owned_view.compiler-owned-reference-shared-view blocks))
    expected))

(define (opt-branch-fold-phi-input-count-is?
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [expected : i64]) : bool
  (=
    (opt-branch-fold-phi-inputs
      (owned_view.compiler-owned-reference-shared-view blocks))
    expected))

(define (opt-branch-fold-successors-known?
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]) : bool
  (compiler_optimize.opt-cfg-successor-targets-known?
    (owned_view.compiler-owned-reference-shared-view blocks)))

(define (compiler-optimize-dom-cmp-branch-fold-self-test) : i64
  (let
    [same : compiler_ir_types.CompilerIrBlockList (opt-branch-fold-blocks 0)]
    [after-same : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run (owned_view.compiler-owned-shared-view same))]
    ;; IDEMPOTENCE: the rewritten function is a fixed point of the same pass.
    [again : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run (owned_view.compiler-owned-shared-view after-same))]
    [negated : compiler_ir_types.CompilerIrBlockList (opt-branch-fold-blocks 1)]
    [after-negated : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run negated)]
    [checked : compiler_ir_types.CompilerIrBlockList (opt-branch-fold-blocks 2)]
    [after-checked : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run checked)]
    [casted : compiler_ir_types.CompilerIrBlockList (opt-branch-fold-blocks 3)]
    [after-casted : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run casted)]
    [joined : compiler_ir_types.CompilerIrBlockList (opt-branch-fold-blocks 4)]
    [after-joined : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run joined)]
    [diamond : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-phi-blocks)]
    [after-diamond : compiler_ir_types.CompilerIrBlockList
      (opt-branch-fold-run (owned_view.compiler-owned-shared-view diamond))]
    [cleaned : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-cfg-simplify-blocks
        (owned_view.compiler-owned-shared-view after-diamond))]
    (cond
      ;; (a) the dominating branch's TRUE edge decides the copy the dominated
      ;; block branches on. Nothing else in the function is decided.
      [(not (opt-branch-fold-count-is? (& same) 1 0)) 1]
      [(not (opt-branch-fold-count-is? (& same) 0 0)) 2]
      [(not (opt-branch-fold-count-is? (& after-same) 1 1)) 3]
      [(not (opt-branch-fold-count-is? (& after-same) 0 0)) 4]
      ;; The terminators keep both successor labels, so the block set and the
      ;; CFG this pass hands to sccp are untouched.
      [(not (opt-branch-fold-block-count-is? (& after-same) 6)) 5]
      [(not (opt-branch-fold-successors-known? (& after-same))) 6]
      [(not (opt-branch-fold-count-is? (& again) 1 1)) 7]
      [(not (opt-branch-fold-block-count-is? (& again) 6)) 8]
      ;; (b) the FALSE edge of the same branch decides the negation.
      [(not (opt-branch-fold-count-is? (& after-negated) 0 1)) 9]
      [(not (opt-branch-fold-count-is? (& after-negated) 1 0)) 10]
      ;; (c) a passed bounds check decides `idx < len` for the branch below it,
      ;; in a block that holds no comparison at all.
      [(not (opt-branch-fold-count-is? (& after-checked) 1 1)) 11]
      [(not (opt-branch-fold-count-is? (& after-checked) 0 0)) 12]
      ;; (d) the same question spelled through fresh `cast i64 -> u64`
      ;; destinations on both operands.
      [(not (opt-branch-fold-count-is? (& after-casted) 1 1)) 13]
      [(not (opt-branch-fold-count-is? (& after-casted) 0 0)) 14]
      ;; (e) REFUSED at a join the deciding edge does not dominate.
      [(not (opt-branch-fold-count-is? (& after-joined) 1 0)) 15]
      [(not (opt-branch-fold-count-is? (& after-joined) 0 0)) 16]
      [(not (opt-branch-fold-block-count-is? (& after-joined) 7)) 17]
      ;; (f) the dead arm's phi input, and the arm itself, go away in the CFG
      ;; cleanup that runs below this pass -- not in the pass.
      [(not (opt-branch-fold-phi-input-count-is? (& diamond) 3)) 18]
      [(not (opt-branch-fold-count-is? (& after-diamond) 1 1)) 19]
      [(not (opt-branch-fold-phi-input-count-is? (& after-diamond) 3)) 20]
      [(not (opt-branch-fold-block-count-is? (& after-diamond) 6)) 21]
      [(not (opt-branch-fold-block-count-is? (& cleaned) 5)) 22]
      [(not (opt-branch-fold-phi-input-count-is? (& cleaned) 2)) 23]
      [(not (opt-branch-fold-count-is? (& cleaned) 1 0)) 24]
      [(not (opt-branch-fold-successors-known? (& cleaned))) 25]
      [else 42])))

(define (compiler-optimize-bounds-self-test) : i64
  (let
    [symbols : OptLoopBceTestSymbols (opt-loop-bce-test-symbols)]
    [duplicate : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-duplicate-instrs))]
    [different : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-different-instrs))]
    [redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-redef-instrs))]
    [call : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-call-instrs))]
    [branch : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-branch-instrs))]
    [copy : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-test-copy-instrs
          (compiler_optimize.OptCopyEnv.Nil)
          (opt-bounds-copy-instrs)))]
    [dce : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-dce-instrs
        (opt-test-collect-instrs-uses
          (opt_i64_i64_map.with-capacity 64)
          (opt-bounds-dce-instrs))
        (opt-bounds-dce-instrs))]
    [cross : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.optimize-block-list
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-bounds-cross-blocks))]
    [loop-positive : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-blocks symbols 0 false)
        (opt-loop-bce-test-summaries symbols false false))]
    [loop-negative-init : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-argc-blocks symbols (- 0 1) false)
        (opt-loop-bce-test-summaries symbols false true))]
    [loop-unknown-call : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-argc-blocks symbols 0 true)
        (opt-loop-bce-test-summaries symbols false true))]
    [loop-clean-call : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-argc-blocks symbols 0 true)
        (opt-loop-bce-test-summaries symbols true true))]
    [loop-argc : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-argc-blocks symbols 0 false)
        (opt-loop-bce-test-summaries symbols false true))]
    [loop-nested : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-nested-blocks symbols)
        (opt-loop-bce-test-summaries symbols false true))]
    [string-positive : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (opt-loop-bce-string-test-body 2)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-mismatch : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (opt-loop-bce-string-test-body 20)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-call : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (opt-loop-bce-string-test-call-body symbols 2)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-store : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (opt-loop-bce-string-test-store-body 2)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-negative-init : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          (- 0 1)
          (opt-loop-bce-string-test-body 2)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-off-by-one : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (opt-loop-bce-string-test-body 2)
          true)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-reassign : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (opt-loop-bce-string-test-reassign-body)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-split : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-split-blocks)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-transitive : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-transitive-blocks true)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-transitive-missing-upper : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-transitive-blocks false)
        (opt-loop-bce-test-summaries symbols false false))]
    [loop-affine-reversed : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-affine-blocks
          symbols
          0
          7
          (opt-loop-bce-test-affine-body true)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [loop-affine-missing-offset-bound : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-affine-blocks
          symbols
          0
          10
          (opt-loop-bce-test-affine-body true)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [string-affine-missing-offset-bound : i64
      (opt-loop-bce-string-test-count
        (opt-loop-bce-string-test-blocks
          0
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "body")
            (opt-loop-bce-string-test-affine-body-instrs 2 true))
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [loop-affine-negative-init : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-affine-blocks
          symbols
          (- 0 1)
          7
          (opt-loop-bce-test-affine-body true)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [loop-affine-call : i64
      (opt-loop-bce-test-count
        (opt-loop-bce-test-affine-blocks
          symbols
          0
          7
          (opt-loop-bce-test-affine-call-body symbols true)
          false)
        (opt-loop-bce-test-summaries symbols false false))]
    [index-cast : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-index-cast-instrs))]
    [index-cast-redef : compiler_ir_types.CompilerIrInstrSeq
      (opt-test-bounds-instrs
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_optimize.OptBoundsFacts.Nil)
        (compiler_optimize.OptBoundsCastEnv.Empty)
        (opt-bounds-index-cast-redef-instrs))]
    (cond
      [(not (= (opt-count-bounds-instrs duplicate) 1)) 1]
      [(not (= (opt-count-bounds-instrs different) 2)) 2]
      [(not (= (opt-count-bounds-instrs redef) 2)) 3]
      [(not (= (opt-count-bounds-instrs call) 2)) 4]
      [(not (= (opt-count-bounds-instrs branch) 2)) 5]
      [(not (= (opt-count-bounds-instrs copy) 1)) 6]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count dce) 3)) 7]
      [(not (= (compiler_optimize.opt-count-bounds-blocks cross) 2)) 8]
      [(not (= loop-positive 0)) 9]
      [(not (= loop-negative-init 1)) 10]
      [(not (= loop-unknown-call 1)) 11]
      [(not (= loop-clean-call 0)) 12]
      [(not (= loop-argc 0)) 13]
      [(not (= loop-nested 0)) 14]
      [(not (= string-positive 0)) 15]
      [(not (= string-mismatch 1)) 16]
      [(not (= string-call 1)) 17]
      [(not (= string-store 1)) 18]
      [(not (= string-negative-init 1)) 19]
      [(not (= string-off-by-one 1)) 20]
      [(not (= string-reassign 1)) 21]
      [(not (= string-split 0)) 22]
      [(not (= (opt-count-bounds-instrs index-cast) 1)) 23]
      [(not (= (opt-count-bounds-instrs index-cast-redef) 2)) 24]
      [(not (= string-transitive 0)) 25]
      [(not (= string-transitive-missing-upper 1)) 26]
      [(not (= loop-affine-reversed 0)) 27]
      [(not (= loop-affine-missing-offset-bound 1)) 28]
      [(not (= string-affine-missing-offset-bound 1)) 29]
      [(not (= loop-affine-negative-init 1)) 30]
      [(not (= loop-affine-call 1)) 31]
      [else 42])))

;; Copy propagation can expose a repeated expression only after CSE has already
;; run for that iteration. A second pass then CSEs `v3` to `v2`; copy propagation
;; rewrites `v4`, and DCE drops the now-unused copy.
(define (opt-fixed-point-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      1
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      3
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.BinOp
      4
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ir_types.CompilerIrValue.Var 3)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 4)))))

(define (opt-test-function-symbol
  [name : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    5
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        instrs)
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-test-function-named
  [name : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (opt-test-function-symbol (opt-test-symbol name) instrs))

(define (opt-test-function [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrFunction
  (opt-test-function-named "fixed" instrs))

(define (opt-test-program [instrs : compiler_ir_types.CompilerIrInstrSeq]) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function instrs)
      (compiler_ir_types.compiler-ir-function-seq-empty))
    (compiler_ir_types.compiler-ir-extern-seq-empty)))

;; Self-test helper: exposes the first optimized block as a list for existing
;; instruction-count assertions; not used by production passes.
(define (opt-function-first-instrs
  [func : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrInstrSeq
  (match func
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler_ir_types.compiler-ir-block-list-force-cons blocks)
        [(compiler_ir_types.CompilerIrBlockList.Cons block _)
          (match block
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs) instrs])]
        [(compiler_ir_types.CompilerIrBlockList.Array _)
          (compiler_ir_types.compiler-ir-instr-seq-empty)]
        [(compiler_ir_types.CompilerIrBlockList.Nil)
          (compiler_ir_types.compiler-ir-instr-seq-empty)])]))

(define (opt-program-first-instrs
  [program : compiler_ir_types.CompilerIrProgram]) : compiler_ir_types.CompilerIrInstrSeq
  (match program
    [(compiler_ir_types.CompilerIrProgram.Program _ funcs _)
      (if (> funcs.len 0)
        (opt-function-first-instrs
          (compiler_ir_types.compiler-ir-function-seq-ref funcs 0))
        (compiler_ir_types.compiler-ir-instr-seq-empty))]))

(define (opt-program-functions [program : compiler_ir_types.CompilerIrProgram]) : compiler_ir_types.CompilerIrFunctionSeq
  (match program
    [(compiler_ir_types.CompilerIrProgram.Program _ funcs _) funcs]))

(define (opt-program-globals [program : compiler_ir_types.CompilerIrProgram]) : compiler_ir_types.CompilerIrGlobalSeq
  (match program
    [(compiler_ir_types.CompilerIrProgram.Program globals _ _) globals]))

(define (opt-global-list-defines?
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [name : String]) : bool
  (opt-global-seq-defines? globals name 0))

(define (opt-global-seq-defines?
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [name : String]
  [index : i64]) : bool
  (if (>=
    index
    (compiler_ir_types.compiler-ir-global-seq-count
      (compiler_optimize.compiler-opt-global-shared-view globals)))
    false
    (match (compiler_ir_types.compiler-ir-global-seq-ref
      (compiler_optimize.compiler-opt-global-shared-view globals)
      index)
      [(compiler_ir_types.CompilerIrGlobal.Global global-name _ _)
        (if (string.eq
          (compiler_ir_types.compiler-ir-symbol-text global-name)
          name)
          true
          (opt-global-seq-defines? globals name (+ index 1)))])))

(define (opt-level-parse-ok? [value : String] [expected : i64]) : bool
  (match (compiler_optimize.compiler-optimize-parse-level value)
    [(compiler_optimize.ResultCompilerOptimizeLevel.Ok level)
      (= level expected)]
    [(compiler_optimize.ResultCompilerOptimizeLevel.Err) false]))

(define (opt-level-parse-err? [value : String]) : bool
  (match (compiler_optimize.compiler-optimize-parse-level value)
    [(compiler_optimize.ResultCompilerOptimizeLevel.Ok _) false]
    [(compiler_optimize.ResultCompilerOptimizeLevel.Err) true]))

(define (compiler-optimize-level-policy-ok?) : bool
  (and
    (= (compiler_optimize.compiler-optimize-default-level) 1)
    (compiler_optimize.compiler-optimize-level-valid? 0)
    (compiler_optimize.compiler-optimize-level-valid? 1)
    (compiler_optimize.compiler-optimize-level-valid? 2)
    (not (compiler_optimize.compiler-optimize-level-valid? 3))
    (not (compiler_optimize.compiler-optimize-level-valid? (- 0 1)))
    (not (compiler_optimize.compiler-optimize-level-valid? 4))
    (opt-level-parse-ok? "0" 0)
    (opt-level-parse-ok? "1" 1)
    (opt-level-parse-ok? "2" 2)
    (opt-level-parse-err? "3")
    (opt-level-parse-err? "")
    (opt-level-parse-err? "4")
    (opt-level-parse-err? "10")))

(define (compiler-optimize-level-program-ok?) : bool
  (let
    [program : compiler_ir_types.CompilerIrProgram
      (opt-test-program (opt-self-test-instrs))]
    [level0 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (compiler_optimize.compiler-opt-global-shared-view program)
        0)]
    [level1 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (compiler_optimize.compiler-opt-global-shared-view program)
        1)]
    [level2 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (compiler_optimize.compiler-opt-global-shared-view program)
        2)]
    [defaulted : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program
        (compiler_optimize.compiler-opt-global-shared-view program))]
    [fixed-program : compiler_ir_types.CompilerIrProgram
      (opt-test-program (opt-fixed-point-instrs))]
    [level1-fixed : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (compiler_optimize.compiler-opt-global-shared-view fixed-program)
        1)]
    [level2-fixed : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level fixed-program 2)]
    [level0-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-program-first-instrs
        (compiler_optimize.compiler-opt-global-shared-view level0))]
    [level1-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-program-first-instrs
        (compiler_optimize.compiler-opt-global-shared-view level1))]
    [level2-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-program-first-instrs level2)]
    [level1-fixed-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-program-first-instrs level1-fixed)]
    [level2-fixed-instrs : compiler_ir_types.CompilerIrInstrSeq
      (opt-program-first-instrs level2-fixed)]
    (cond
      [(not
          (compiler_optimize.opt-program-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            program
            level0))
        false]
      [(not (= (opt-count-arith-instr-seq level0-instrs) 1)) false]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count level1-instrs) 0))
        false]
      [(not (= (compiler_ir_types.compiler-ir-instr-seq-count level2-instrs) 0))
        false]
      [(not
          (compiler_optimize.opt-program-eq
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            level1
            defaulted))
        false]
      [(not
          (=
            (compiler_ir_types.compiler-ir-instr-seq-count level1-fixed-instrs)
            4))
        false]
      [(not (= (opt-count-arith-instr-seq level1-fixed-instrs) 3)) false]
      [(not
          (=
            (compiler_ir_types.compiler-ir-instr-seq-count level2-fixed-instrs)
            3))
        false]
      [(not (= (opt-count-arith-instr-seq level2-fixed-instrs) 2)) false]
      [else true])))

(define (compiler-optimize-level1-escape-equivalent-one-ok?
  [func : compiler_ir_types.CompilerIrFunction]) : bool
  (let
    [summaries : compiler_optimize.OptLoopBceSummaries
      (compiler_optimize.opt-loop-bce-empty-summaries)]
    [expected : compiler_ir_types.CompilerIrFunction
      (compiler_ir_types.compiler-ir-function-compact-blocks
        (compiler_optimize.optimize-function-with-level-and-summaries
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_optimize.compiler-opt-global-shared-view func)
          1
          (compiler_optimize.compiler-opt-global-shared-view summaries)))]
    [scratch : i64 (arena.tl_arena_make)]
    [escaped : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.optimize-function-level1-escaping-with-summaries
        (compiler_ast_types.ast-node-pool-reader-context-current)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        func
        scratch
        summaries)]
    [ok : bool
      (compiler_optimize.opt-function-eq
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        expected
        escaped)]
    (begin
      (unsafe
        (arena.tl_arena_destroy scratch))
      ok)))

(define (compiler-optimize-level1-escape-equivalent-ok?) : bool
  (and
    (compiler-optimize-level1-escape-equivalent-one-ok?
      (opt-test-function
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 0))))))
    (compiler-optimize-level1-escape-equivalent-one-ok?
      (opt-test-function (opt-self-test-instrs)))))

(define (compiler-optimize-level-self-test) : i64
  (begin
    (unless (compiler-optimize-level-policy-ok?) (return 1))
    (unless (compiler-optimize-level-program-ok?) (return 2))
    (unless (compiler-optimize-level1-escape-equivalent-ok?) (return 3))
    42))

(defstruct OptGlobalDceTestSymbols
  (main i64)
  (helper i64)
  (dead i64)
  (callback-target i64)
  (callback i64)
  (used-global i64)
  (stored-global i64)
  (runtime-global i64)
  (dead-global i64))

(define (opt-global-dce-test-symbols) : OptGlobalDceTestSymbols
  (OptGlobalDceTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "helper")
    (opt-test-symbol "dead")
    (opt-test-symbol "callback-target")
    (opt-test-symbol "callback")
    (opt-test-symbol "used-global")
    (opt-test-symbol "stored-global")
    (opt-test-symbol "runtime-global")
    (opt-test-symbol "dead-global")))

(define (opt-global-dce-main-instrs [symbols : OptGlobalDceTestSymbols]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Mov
      3
      (compiler_ir_types.CompilerIrValue.Global symbols.used-global)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Store
      symbols.stored-global
      (compiler_ir_types.CompilerIrValue.I64 99)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      1
      symbols.helper
      (compiler_ir_types.CompilerIrCallArgs.Nil)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      2
      (opt-test-symbol "tl_substring")
      (compiler_ir_types.compiler-ir-call-args-from-seq
        (compiler_ir_types.compiler-ir-value-seq-prepend
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.compiler-ir-value-seq-prepend
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.compiler-ir-value-seq-empty)))))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var 3)))))

(define (opt-global-dce-return-instrs [value : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 value)))))

(define (opt-global-dce-large-return-step [idx : i64] [value : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (>= idx 9)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.I64 value))))
    (opt-test-instrs-with-tail
      (opt-global-dce-large-return-step (+ idx 1) value)
      (compiler_ir_types.CompilerIrInstr.Mov
        idx
        (compiler_ir_types.CompilerIrValue.I64 value)
        (compiler_ast_types.AstType.I64)))))

;; A direct-called fixture callee whose call-free body exceeds the opt1
;; tiny-leaf cap, so the level-1 pruning assertions keep an out-of-line
;; callee to observe instead of watching it get inlined away.
(define (opt-global-dce-large-callee [name : i64] [value : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    name
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    10
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-global-dce-large-return-step 0 value))
      (compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-global-dce-globals [symbols : OptGlobalDceTestSymbols]) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [builder : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 5)]
    (begin
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.callback
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.Global symbols.callback-target))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.used-global
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 3))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.stored-global
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.runtime-global
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.Unit))
      (opt-test-global-builder-push!
        (&mut builder)
        symbols.dead-global
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 5))
      (compiler_ir_types.compiler-ir-global-builder-to-seq builder))))

(define (opt-global-dce-program [symbols : OptGlobalDceTestSymbols]) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (opt-global-dce-globals symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function-symbol
        symbols.main
        (opt-global-dce-main-instrs symbols))
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-global-dce-large-callee symbols.helper 7)
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-test-function-symbol
            symbols.dead
            (opt-global-dce-return-instrs 9))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-test-function-symbol
              symbols.callback-target
              (opt-global-dce-return-instrs 11))
            (compiler_ir_types.compiler-ir-function-seq-prepend
              (opt-test-function-named
                "C:/repo/stdlib/runtime.tl::substring"
                (opt-global-dce-return-instrs 13))
              (compiler_ir_types.compiler-ir-function-seq-prepend
                (opt-test-function-named
                  "C:/repo/stdlib/runtime.tl::int-to-string"
                  (opt-global-dce-return-instrs 17))
                (compiler_ir_types.compiler-ir-function-seq-empty)))))))
    (compiler_ir_types.compiler-ir-extern-seq-empty)))

(define (opt-global-dce-no-main-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function-named "helper" (opt-global-dce-return-instrs 7))
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-test-function-named "dead" (opt-global-dce-return-instrs 9))
        (compiler_ir_types.compiler-ir-function-seq-empty)))
    (compiler_ir_types.compiler-ir-extern-seq-empty)))

(define (compiler-optimize-global-dce-ok?) : bool
  (let
    [symbols : OptGlobalDceTestSymbols (opt-global-dce-test-symbols)]
    [program : compiler_ir_types.CompilerIrProgram
      (opt-global-dce-program symbols)]
    ;; Level 0 keeps every function; level 1 (the cheap optimized build) prunes
    ;; functions unreachable from the roots without inlining the survivors.
    [level0 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (compiler_optimize.compiler-opt-global-shared-view program)
        0)]
    [level1 : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level program 1)]
    [no-main : compiler_ir_types.CompilerIrProgram
      (compiler_optimize.optimize-program-with-level
        (opt-global-dce-no-main-program)
        1)]
    [level0-functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-program-functions
        (compiler_ir_types.compiler-ir-global-shared-view level0))]
    [level1-functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-program-functions
        (compiler_ir_types.compiler-ir-global-shared-view level1))]
    [no-main-functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-program-functions no-main)]
    [level0-globals : compiler_ir_types.CompilerIrGlobalSeq
      (opt-program-globals level0)]
    [level1-globals : compiler_ir_types.CompilerIrGlobalSeq
      (opt-program-globals level1)]
    (and
      (=
        (compiler_ir_types.compiler-ir-function-seq-count
          (compiler_ir_types.compiler-ir-global-shared-view level0-functions))
        6)
      (=
        (compiler_ir_types.compiler-ir-function-seq-count
          (compiler_ir_types.compiler-ir-global-shared-view level1-functions))
        4)
      (=
        (compiler_ir_types.compiler-ir-global-seq-count
          (compiler_ir_types.compiler-ir-global-shared-view level0-globals))
        5)
      (=
        (compiler_ir_types.compiler-ir-global-seq-count
          (compiler_ir_types.compiler-ir-global-shared-view level1-globals))
        3)
      (compiler_optimize.opt-function-seq-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-functions)
        "main")
      (compiler_optimize.opt-function-seq-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-functions)
        "helper")
      (compiler_optimize.opt-function-seq-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-functions)
        "callback-target")
      (compiler_optimize.opt-function-seq-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-functions)
        "C:/repo/stdlib/runtime.tl::substring")
      (not
        (compiler_optimize.opt-function-seq-defines?
          (compiler_ir_types.compiler-ir-global-shared-view level1-functions)
          "C:/repo/stdlib/runtime.tl::int-to-string"))
      (not
        (compiler_optimize.opt-function-seq-defines?
          (compiler_ir_types.compiler-ir-global-shared-view level1-functions)
          "dead"))
      (opt-global-list-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-globals)
        "used-global")
      (opt-global-list-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-globals)
        "stored-global")
      (opt-global-list-defines?
        (compiler_ir_types.compiler-ir-global-shared-view level1-globals)
        "runtime-global")
      (not
        (opt-global-list-defines?
          (compiler_ir_types.compiler-ir-global-shared-view level1-globals)
          "dead-global"))
      (not
        (opt-global-list-defines?
          (compiler_ir_types.compiler-ir-global-shared-view level1-globals)
          "callback"))
      (= (compiler_ir_types.compiler-ir-function-seq-count no-main-functions) 2))))

(define (compiler-optimize-global-dce-self-test) : i64
  (if (compiler-optimize-global-dce-ok?)
    42
    1))

(defstruct OptCallgraphTestSymbols
  (main i64)
  (a i64)
  (b i64)
  (c i64)
  (address-taken i64)
  (external i64)
  (rec-even i64)
  (rec-odd i64)
  (lonely i64)
  (self i64)
  (leaf i64))

(define (opt-callgraph-test-symbols) : OptCallgraphTestSymbols
  (OptCallgraphTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "a")
    (opt-test-symbol "b")
    (opt-test-symbol "c")
    (opt-test-symbol "address_taken")
    (opt-test-symbol "external")
    (opt-test-symbol "rec_even")
    (opt-test-symbol "rec_odd")
    (opt-test-symbol "lonely")
    (opt-test-symbol "self")
    (opt-test-symbol "leaf")))

(define (opt-callgraph-test-slot
  [index : compiler_optimize.OptFunctionIndex]
  [name : i64]) : i64
  (match (compiler_optimize.opt-function-index-slot index name)
    [(option_i64.Some slot) slot]
    [(option_i64.None) -1]))

(define (opt-callgraph-test-edge?
  [index : compiler_optimize.OptFunctionIndex]
  [graph : compiler_optimize.OptCallGraph]
  [caller : i64]
  [callee : i64]) : bool
  (compiler_optimize.opt-callgraph-has-edge?
    graph
    (opt-callgraph-test-slot
      (compiler_optimize.compiler-opt-global-shared-view index)
      caller)
    (opt-callgraph-test-slot index callee)))

(define (opt-callgraph-test-edge-count
  [index : compiler_optimize.OptFunctionIndex]
  [graph : compiler_optimize.OptCallGraph]
  [caller : i64]) : i64
  (compiler_optimize.opt-callgraph-callee-count
    graph
    (opt-callgraph-test-slot index caller)))

(define (opt-callgraph-main-instrs [symbols : OptCallgraphTestSymbols]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Call
      0
      symbols.a
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      1
      symbols.external
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.CallIndirect
      2
      (compiler_ir_types.CompilerIrValue.Function symbols.c)
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Mov
      3
      (compiler_ir_types.CompilerIrValue.Global symbols.address-taken)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.TailCall
      symbols.b
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))))

(define (opt-callgraph-call-instrs [name : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Call
      0
      name
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 0)))))

(define (opt-callgraph-tail-instrs [name : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.TailCall
      name
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))))

(define (opt-callgraph-return-instrs) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 0)))))

(define (opt-callgraph-acyclic-functions [symbols : OptCallgraphTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-test-function-symbol symbols.main (opt-callgraph-main-instrs symbols))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function-symbol symbols.a (opt-callgraph-call-instrs symbols.c))
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-test-function-symbol symbols.b (opt-callgraph-return-instrs))
        (compiler_ir_types.compiler-ir-function-seq-prepend
          (opt-test-function-symbol
            symbols.c
            (opt-callgraph-tail-instrs symbols.b))
          (compiler_ir_types.compiler-ir-function-seq-prepend
            (opt-test-function-symbol
              symbols.address-taken
              (opt-callgraph-return-instrs))
            (compiler_ir_types.compiler-ir-function-seq-empty)))))))

(define (opt-callgraph-rec-even-instrs [symbols : OptCallgraphTestSymbols]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Call
      0
      symbols.rec-odd
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Call
      1
      symbols.rec-odd
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.I64 0)))))

(define (opt-callgraph-recursive-functions [symbols : OptCallgraphTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-test-function-symbol
      symbols.rec-even
      (opt-callgraph-rec-even-instrs symbols))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function-symbol
        symbols.rec-odd
        (opt-callgraph-tail-instrs symbols.rec-even))
      (compiler_ir_types.compiler-ir-function-seq-prepend
        (opt-test-function-symbol symbols.lonely (opt-callgraph-return-instrs))
        (compiler_ir_types.compiler-ir-function-seq-empty)))))

(define (compiler-optimize-callgraph-acyclic-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-callgraph-acyclic-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build functions)]
    [graph : compiler_optimize.OptCallGraph
      (compiler_optimize.opt-callgraph-build
        (compiler_optimize.compiler-opt-global-shared-view index))]
    (cond
      [(not (= graph.count 5)) false]
      [(not
          (=
            (opt-callgraph-test-edge-count
              (compiler_optimize.compiler-opt-global-shared-view index)
              (compiler_optimize.compiler-opt-global-shared-view graph)
              symbols.main)
            2))
        false]
      [(not
          (opt-callgraph-test-edge?
            (compiler_optimize.compiler-opt-global-shared-view index)
            (compiler_optimize.compiler-opt-global-shared-view graph)
            symbols.main
            symbols.a))
        false]
      [(not
          (opt-callgraph-test-edge?
            (compiler_optimize.compiler-opt-global-shared-view index)
            (compiler_optimize.compiler-opt-global-shared-view graph)
            symbols.main
            symbols.b))
        false]
      [(opt-callgraph-test-edge?
          (compiler_optimize.compiler-opt-global-shared-view index)
          (compiler_optimize.compiler-opt-global-shared-view graph)
          symbols.main
          symbols.c)
        false]
      [(opt-callgraph-test-edge?
          (compiler_optimize.compiler-opt-global-shared-view index)
          (compiler_optimize.compiler-opt-global-shared-view graph)
          symbols.main
          symbols.address-taken)
        false]
      [(not
          (=
            (opt-callgraph-test-edge-count
              (compiler_optimize.compiler-opt-global-shared-view index)
              (compiler_optimize.compiler-opt-global-shared-view graph)
              symbols.a)
            1))
        false]
      [(not
          (opt-callgraph-test-edge?
            (compiler_optimize.compiler-opt-global-shared-view index)
            (compiler_optimize.compiler-opt-global-shared-view graph)
            symbols.a
            symbols.c))
        false]
      [(not
          (=
            (opt-callgraph-test-edge-count
              (compiler_optimize.compiler-opt-global-shared-view index)
              (compiler_optimize.compiler-opt-global-shared-view graph)
              symbols.b)
            0))
        false]
      [(not
          (=
            (opt-callgraph-test-edge-count
              (compiler_optimize.compiler-opt-global-shared-view index)
              (compiler_optimize.compiler-opt-global-shared-view graph)
              symbols.c)
            1))
        false]
      [(not
          (opt-callgraph-test-edge?
            (compiler_optimize.compiler-opt-global-shared-view index)
            (compiler_optimize.compiler-opt-global-shared-view graph)
            symbols.c
            symbols.b))
        false]
      [(not
          (=
            (opt-callgraph-test-edge-count index graph symbols.address-taken)
            0))
        false]
      [else true])))

(define (compiler-optimize-callgraph-recursive-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-callgraph-recursive-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build functions)]
    [graph : compiler_optimize.OptCallGraph
      (compiler_optimize.opt-callgraph-build
        (compiler_optimize.compiler-opt-global-shared-view index))]
    (cond
      [(not (= graph.count 3)) false]
      [(not
          (=
            (opt-callgraph-test-edge-count
              (compiler_optimize.compiler-opt-global-shared-view index)
              (compiler_optimize.compiler-opt-global-shared-view graph)
              symbols.rec-even)
            1))
        false]
      [(not
          (opt-callgraph-test-edge?
            (compiler_optimize.compiler-opt-global-shared-view index)
            (compiler_optimize.compiler-opt-global-shared-view graph)
            symbols.rec-even
            symbols.rec-odd))
        false]
      [(opt-callgraph-test-edge?
          (compiler_optimize.compiler-opt-global-shared-view index)
          (compiler_optimize.compiler-opt-global-shared-view graph)
          symbols.rec-even
          symbols.rec-even)
        false]
      [(not
          (=
            (opt-callgraph-test-edge-count
              (compiler_optimize.compiler-opt-global-shared-view index)
              (compiler_optimize.compiler-opt-global-shared-view graph)
              symbols.rec-odd)
            1))
        false]
      [(not
          (opt-callgraph-test-edge?
            (compiler_optimize.compiler-opt-global-shared-view index)
            (compiler_optimize.compiler-opt-global-shared-view graph)
            symbols.rec-odd
            symbols.rec-even))
        false]
      [(not (= (opt-callgraph-test-edge-count index graph symbols.lonely) 0))
        false]
      [else true])))

(define (opt-scc-result-component
  [result : compiler_optimize.OptSccResult]
  [slot : i64]) : i64
  (array-ref result.scc-of slot))

(define (opt-scc-component-size
  [result : compiler_optimize.OptSccResult]
  [scc-id : i64]) : i64
  (let
    [scc-of : (__tl_dyn-array i64) result.scc-of]
    [count : i64 (array-length scc-of)]
    [slot : i64 0]
    [size : i64 0]
    (begin
      (while (< slot count)
        (begin
          (if (= (array-ref scc-of slot) scc-id)
            (set! size (+ size 1))
            unit)
          (set! slot (+ slot 1))))
      size)))

(define (opt-scc-order-position
  [result : compiler_optimize.OptSccResult]
  [scc-id : i64]) : i64
  (let
    [order : (__tl_dyn-array i64)
      (compiler_optimize.compiler-opt-global-shared-view result.order)]
    [count : i64 (array-length order)]
    [index : i64 0]
    [position : i64 (- 0 1)]
    (begin
      (while (and (< index count) (< position 0))
        (begin
          (if (= (array-ref order index) scc-id)
            (set! position index)
            unit)
          (set! index (+ index 1))))
      position)))

(define (opt-scc-before?
  [result : compiler_optimize.OptSccResult]
  [left : i64]
  [right : i64]) : bool
  (let
    [left-pos : i64
      (opt-scc-order-position
        (compiler_optimize.compiler-opt-global-shared-view result)
        left)]
    [right-pos : i64 (opt-scc-order-position result right)]
    (and (>= left-pos 0) (>= right-pos 0) (< left-pos right-pos))))

(define (opt-scc-self-recursive-functions [symbols : OptCallgraphTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-test-function-symbol
      symbols.self
      (opt-callgraph-tail-instrs symbols.self))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-test-function-symbol symbols.leaf (opt-callgraph-return-instrs))
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (compiler-optimize-scc-self-recursive-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-scc-self-recursive-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build functions)]
    [graph : compiler_optimize.OptCallGraph
      (compiler_optimize.opt-callgraph-build
        (compiler_optimize.compiler-opt-global-shared-view index))]
    [result : compiler_optimize.OptSccResult
      (compiler_optimize.opt-scc-compute
        (compiler_optimize.compiler-opt-global-shared-view graph))]
    [self-slot : i64
      (opt-callgraph-test-slot
        (compiler_optimize.compiler-opt-global-shared-view index)
        symbols.self)]
    [leaf-slot : i64 (opt-callgraph-test-slot index symbols.leaf)]
    [self-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        self-slot)]
    [leaf-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        leaf-slot)]
    (cond
      [(not
          (compiler_optimize.opt-callgraph-has-edge? graph self-slot self-slot))
        false]
      [(< self-scc 0) false]
      [(< leaf-scc 0) false]
      [(= self-scc leaf-scc) false]
      [(not
          (=
            (opt-scc-component-size
              (compiler_optimize.compiler-opt-global-shared-view result)
              self-scc)
            1))
        false]
      [(not (= (opt-scc-component-size result leaf-scc) 1)) false]
      [else true])))

(define (compiler-optimize-scc-mutual-recursive-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-callgraph-recursive-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build functions)]
    [graph : compiler_optimize.OptCallGraph
      (compiler_optimize.opt-callgraph-build
        (compiler_optimize.compiler-opt-global-shared-view index))]
    [result : compiler_optimize.OptSccResult
      (compiler_optimize.opt-scc-compute graph)]
    [even-slot : i64
      (opt-callgraph-test-slot
        (compiler_optimize.compiler-opt-global-shared-view index)
        symbols.rec-even)]
    [odd-slot : i64
      (opt-callgraph-test-slot
        (compiler_optimize.compiler-opt-global-shared-view index)
        symbols.rec-odd)]
    [lonely-slot : i64 (opt-callgraph-test-slot index symbols.lonely)]
    [even-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        even-slot)]
    [odd-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        odd-slot)]
    [lonely-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        lonely-slot)]
    (cond
      [(< even-scc 0) false]
      [(not (= even-scc odd-scc)) false]
      [(= even-scc lonely-scc) false]
      [(not
          (=
            (opt-scc-component-size
              (compiler_optimize.compiler-opt-global-shared-view result)
              even-scc)
            2))
        false]
      [(not (= (opt-scc-component-size result lonely-scc) 1)) false]
      [else true])))

(define (compiler-optimize-scc-reverse-topo-ok?) : bool
  (let
    [symbols : OptCallgraphTestSymbols (opt-callgraph-test-symbols)]
    [functions : compiler_ir_types.CompilerIrFunctionSeq
      (opt-callgraph-acyclic-functions symbols)]
    [index : compiler_optimize.OptFunctionIndex
      (compiler_optimize.opt-function-index-build functions)]
    [graph : compiler_optimize.OptCallGraph
      (compiler_optimize.opt-callgraph-build
        (compiler_optimize.compiler-opt-global-shared-view index))]
    [result : compiler_optimize.OptSccResult
      (compiler_optimize.opt-scc-compute graph)]
    [order : (__tl_dyn-array i64)
      (compiler_optimize.compiler-opt-global-shared-view result.order)]
    [main-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        (opt-callgraph-test-slot
          (compiler_optimize.compiler-opt-global-shared-view index)
          symbols.main))]
    [a-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        (opt-callgraph-test-slot
          (compiler_optimize.compiler-opt-global-shared-view index)
          symbols.a))]
    [b-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        (opt-callgraph-test-slot
          (compiler_optimize.compiler-opt-global-shared-view index)
          symbols.b))]
    [c-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        (opt-callgraph-test-slot
          (compiler_optimize.compiler-opt-global-shared-view index)
          symbols.c))]
    [address-scc : i64
      (opt-scc-result-component
        (compiler_optimize.compiler-opt-global-shared-view result)
        (opt-callgraph-test-slot index symbols.address-taken))]
    (cond
      [(not (= (array-length order) 5)) false]
      [(not (= (array-ref order 0) b-scc)) false]
      [(not (= (array-ref order 1) c-scc)) false]
      [(not (= (array-ref order 2) a-scc)) false]
      [(not (= (array-ref order 3) main-scc)) false]
      [(not (= (array-ref order 4) address-scc)) false]
      [(not
          (opt-scc-before?
            (compiler_optimize.compiler-opt-global-shared-view result)
            b-scc
            c-scc))
        false]
      [(not
          (opt-scc-before?
            (compiler_optimize.compiler-opt-global-shared-view result)
            c-scc
            a-scc))
        false]
      [(not
          (opt-scc-before?
            (compiler_optimize.compiler-opt-global-shared-view result)
            a-scc
            main-scc))
        false]
      [(not (opt-scc-before? result b-scc main-scc)) false]
      [else true])))

(define (compiler-optimize-scc-self-test) : i64
  (cond
    [(not (compiler-optimize-scc-self-recursive-ok?)) 1]
    [(not (compiler-optimize-scc-mutual-recursive-ok?)) 2]
    [(not (compiler-optimize-scc-reverse-topo-ok?)) 3]
    [else 42]))

(define (compiler-optimize-callgraph-self-test) : i64
  (if (compiler-optimize-callgraph-acyclic-ok?)
    (if (compiler-optimize-callgraph-recursive-ok?)
      42
      2)
    1))

(define (opt-inline-frame-params) : compiler_ir_types.CompilerIrParamSeq
  (compiler_ir_types.compiler-ir-param-seq-prepend
    (compiler_ir_types.CompilerIrParam.Param
      "left"
      (compiler_ast_types.AstType.I64)
      0)
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "right"
        (compiler_ast_types.AstType.I64)
        1)
      (compiler_ir_types.compiler-ir-param-seq-empty))))

(defstruct OptInlineFrameTestSymbols
  (main i64)
  (inline-add i64)
  (inline-mid i64)
  (inline-group-word i64))

(define (opt-inline-frame-test-symbols) : OptInlineFrameTestSymbols
  (OptInlineFrameTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "inline_add")
    (opt-test-symbol "inline_mid")
    (opt-test-symbol "inline_group_word")))

(define (opt-inline-frame-callee [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-add
    (opt-inline-frame-params)
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-frame-caller [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 32)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.inline-add
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-frame-functions [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-frame-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-frame-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-known-indirect-caller [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 10)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 32)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.CallIndirect
            2
            (compiler_ir_types.CompilerIrValue.Function symbols.inline-add)
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-known-indirect-functions
  [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-known-indirect-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-frame-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-pack-word-callee [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.inline-group-word
    (opt-inline-frame-params)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Pack
            2
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.compiler-ir-value-seq-prepend
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ir_types.compiler-ir-value-seq-empty)))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Word
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            1
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The caller passes its args from vars 1/2 (NOT the callee's param ids 0/1)
;; and uses a spacer var 0, so a missing remap of the inlined Pack/Word
;; operands is observable: the cloned Pack must read vars 1/2 (the call
;; arguments), never the callee-local 0/1 (regression guard -- the inliner
;; cloned Pack/Word through its catch-all without remapping).
(define (opt-inline-pack-word-caller [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 99)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 20)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            2
            (compiler_ir_types.CompilerIrValue.I64 22)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            symbols.inline-group-word
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 2))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-pack-word-functions [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-pack-word-caller symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-pack-word-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-level-functions [level : i64]) : compiler_ir_types.CompilerIrFunctionSeq
  (let
    [symbols : OptInlineFrameTestSymbols (opt-inline-frame-test-symbols)]
    (compiler_optimize.opt-inline-program-functions
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-inline-frame-functions symbols)
      level)))

(define (opt-inline-self-recursive) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "self_inline")
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            0
            (opt-test-symbol "self_inline")
            compiler_ir_types.CompilerIrCallArgs.Nil
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-large-callee-instrs [idx : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (> idx (compiler_optimize.opt-inline-max-body))
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var idx))))
    (opt-test-instrs-with-tail
      (opt-inline-large-callee-instrs (+ idx 1))
      (compiler_ir_types.CompilerIrInstr.BinOp
        (+ idx 1)
        (compiler_ir_types.CompilerIrBinOp.Add)
        (if (= idx 0)
          (compiler_ir_types.CompilerIrValue.I64 0)
          (compiler_ir_types.CompilerIrValue.Var idx))
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64)))))

(defstruct OptInlineBoundsTestSymbols
  (main i64)
  (too-large i64)
  (bounds-inline i64)
  (bounds-leaf-inline i64))

(define (opt-inline-bounds-test-symbols) : OptInlineBoundsTestSymbols
  (OptInlineBoundsTestSymbols
    (opt-test-symbol "main")
    (opt-test-symbol "too_large_inline")
    (opt-test-symbol "bounds_inline")
    (opt-test-symbol "bounds_leaf_inline")))

(define (opt-inline-large-callee [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.too-large
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    (+ (compiler_optimize.opt-inline-max-body) 2)
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-inline-large-callee-instrs 0))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-bounds-callee [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.bounds-inline
    (compiler_ir_types.compiler-ir-param-seq-prepend
      (compiler_ir_types.CompilerIrParam.Param
        "idx"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "len"
          (compiler_ast_types.AstType.I64)
          1)
        (compiler_ir_types.compiler-ir-param-seq-empty)))
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "bounds_inline.ok"))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-call-one [dst : i64] [callee : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (opt-test-instrs
    (compiler_ir_types.CompilerIrInstr.Call
      dst
      callee
      compiler_ir_types.CompilerIrCallArgs.Nil
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.CompilerIrInstr.Return
      (compiler_ir_types.CompilerIrMaybeValue.Some
        (compiler_ir_types.CompilerIrValue.Var dst)))))

(define (opt-inline-call-large [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-inline-call-one 0 symbols.too-large))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-call-bounds [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.bounds-inline
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.CompilerIrValue.I64 4))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 2)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-call-bounds-twice [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.bounds-inline
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.CompilerIrValue.I64 4))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            symbols.bounds-inline
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ir_types.CompilerIrValue.I64 4))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-duplicate-bounds-label-function
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    0
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ir_types.CompilerIrValue.I64 4)
            (compiler_ir_types.compiler-ir-label "dup.ok"))
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ir_types.CompilerIrValue.I64 4)
            (compiler_ir_types.compiler-ir-label "dup.ok"))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 0)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-large-functions [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-large symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-large-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-functions [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-twice-functions
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-twice symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-callee symbols)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-leaf-instrs [index : i64] [limit : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (>= index limit)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.No)))
    (opt-test-instrs-with-tail
      (opt-inline-bounds-leaf-instrs (+ index 1) limit)
      (if (= index 0)
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "bounds_leaf.ok"))
        (compiler_ir_types.CompilerIrInstr.Mov
          (+ index 1)
          (compiler_ir_types.CompilerIrValue.I64 index)
          (compiler_ast_types.AstType.I64))))))

(define (opt-inline-bounds-leaf-callee
  [symbols : OptInlineBoundsTestSymbols]
  [body : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.compiler-ir-function-compact-blocks
    (compiler_ir_types.CompilerIrFunction.Function
      symbols.bounds-leaf-inline
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "idx"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "len"
            (compiler_ast_types.AstType.I64)
            1)
          (compiler_ir_types.compiler-ir-param-seq-empty)))
      (compiler_ast_types.AstType.Unit)
      (+ body 1)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-inline-bounds-leaf-instrs 0 body))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-inline-call-bounds-leaf [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.bounds-leaf-inline
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 42)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-bounds-leaf-functions
  [symbols : OptInlineBoundsTestSymbols]
  [body : i64]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-callee symbols body)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

;; Two ordinary call sites with variable arguments: the callee is neither
;; absorbable (refcount 2) nor all-const-args, so opt-inline-bounds-inline-ok?
;; refuses it and admission has to come from the bounds-leaf path.
(define (opt-inline-call-bounds-leaf-twice
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            symbols.bounds-leaf-inline
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            symbols.bounds-leaf-inline
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 0))
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 42)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-bounds-leaf-twice-functions
  [symbols : OptInlineBoundsTestSymbols]
  [body : i64]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf-twice symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-callee symbols body)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-leaf-call-symbol) : i64
  (opt-test-symbol "bounds_leaf_call_inline"))

(define (opt-inline-bounds-leaf-opaque-symbol) : i64
  (opt-test-symbol "opaque_sink"))

;; Small has-bounds callee whose body carries a Call. The bounds-leaf
;; whitelist refuses calls, so this shape must keep its call boundary even
;; though its body is well inside the admitted size band.
(define (opt-inline-bounds-leaf-call-callee) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.compiler-ir-function-compact-blocks
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-inline-bounds-leaf-call-symbol)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "idx"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "len"
            (compiler_ast_types.AstType.I64)
            1)
          (compiler_ir_types.compiler-ir-param-seq-empty)))
      (compiler_ast_types.AstType.Unit)
      4
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "bounds_leaf_call.ok"))
            (compiler_ir_types.CompilerIrInstr.Call
              2
              (opt-inline-bounds-leaf-opaque-symbol)
              (compiler_ir_types.CompilerIrCallArgs.One
                (compiler_ir_types.CompilerIrValue.Var 0))
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.No))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-inline-call-bounds-leaf-call-twice
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            (opt-inline-bounds-leaf-call-symbol)
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            (opt-inline-bounds-leaf-call-symbol)
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 0))
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 42)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-bounds-leaf-call-functions
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf-call-twice symbols)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-call-callee)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-leaf-char-symbol) : i64
  (opt-test-symbol "bounds_leaf_char_inline"))

(define (opt-inline-bounds-leaf-owned-symbol) : i64
  (opt-test-symbol "bounds_leaf_owned_inline"))

;; One bounds-leaf shape -- single block, bounds-checked, call-free, two body
;; instructions -- instantiated at two return types. Every other property the
;; admission path reads is held fixed, so an outcome difference between the two
;; instantiations isolates opt-inline-bounds-leaf-return-type?.
(define (opt-inline-bounds-leaf-typed-callee
  [name : i64]
  [ret : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.compiler-ir-function-compact-blocks
    (compiler_ir_types.CompilerIrFunction.Function
      name
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "idx"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "len"
            (compiler_ast_types.AstType.I64)
            1)
          (compiler_ir_types.compiler-ir-param-seq-empty)))
      (compiler_ast_types.ast-global-shared-view ret)
      3
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "bounds_leaf_typed.ok"))
            (compiler_ir_types.CompilerIrInstr.Mov 2 value ret)
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 2)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

;; Two ordinary call sites with variable arguments: two references make the
;; callee non-absorbable and no argument is constant, so the generic has-bounds
;; policy refuses it and admission can only come from the bounds-leaf path.
(define (opt-inline-call-bounds-leaf-typed-twice
  [symbols : OptInlineBoundsTestSymbols]
  [callee : i64]
  [ret : compiler_ast_types.AstType]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            callee
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1))
            (compiler_ast_types.ast-global-shared-view ret))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            callee
            (compiler_ir_types.CompilerIrCallArgs.Two
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 0))
            ret)
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 42)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-bounds-leaf-char-functions
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf-typed-twice
      symbols
      (opt-inline-bounds-leaf-char-symbol)
      (compiler_ast_types.AstType.Char))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-typed-callee
        (opt-inline-bounds-leaf-char-symbol)
        (compiler_ast_types.AstType.Char)
        (compiler_ir_types.CompilerIrValue.Char 'A'))
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-bounds-leaf-owned-functions
  [symbols : OptInlineBoundsTestSymbols]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-call-bounds-leaf-typed-twice
      symbols
      (opt-inline-bounds-leaf-owned-symbol)
      (compiler_ast_types.AstType.String))
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-bounds-leaf-typed-callee
        (opt-inline-bounds-leaf-owned-symbol)
        (compiler_ast_types.AstType.String)
        (compiler_ir_types.CompilerIrValue.String "leaf"))
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-band-symbol) : i64
  (opt-test-symbol "band_inline"))

;; A pure arithmetic chain of exactly `limit` body instructions over two
;; parameters, closed by a Return of the last one. Every instruction writes a
;; fresh variable at or above the parameter count, so the body clears
;; opt-inline-body-instr-ok?, and it carries neither a Call nor a BoundsCheck,
;; which keeps the bounds-leaf path and its 1..48 band out of the decision.
;; Admission then turns on opt-inline-max-body and the cost gate alone.
(define (opt-inline-band-instrs [index : i64] [limit : i64]) : compiler_ir_types.CompilerIrInstrSeq
  (if (>= index limit)
    (opt-test-instrs
      (compiler_ir_types.CompilerIrInstr.Return
        (compiler_ir_types.CompilerIrMaybeValue.Some
          (compiler_ir_types.CompilerIrValue.Var (+ limit 1)))))
    (opt-test-instrs-with-tail
      (opt-inline-band-instrs (+ index 1) limit)
      (compiler_ir_types.CompilerIrInstr.BinOp
        (+ index 2)
        (compiler_ir_types.CompilerIrBinOp.Add)
        (if (= index 0)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var (+ index 1)))
        (if (= index 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 1))
        (compiler_ast_types.AstType.I64)))))

(define (opt-inline-band-callee [body : i64]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.compiler-ir-function-compact-blocks
    (compiler_ir_types.CompilerIrFunction.Function
      (opt-inline-band-symbol)
      (compiler_ir_types.compiler-ir-param-seq-prepend
        (compiler_ir_types.CompilerIrParam.Param
          "a"
          (compiler_ast_types.AstType.I64)
          0)
        (compiler_ir_types.compiler-ir-param-seq-prepend
          (compiler_ir_types.CompilerIrParam.Param
            "b"
            (compiler_ast_types.AstType.I64)
            1)
          (compiler_ir_types.compiler-ir-param-seq-empty)))
      (compiler_ast_types.AstType.I64)
      (+ body 2)
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (opt-inline-band-instrs 0 body))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (opt-inline-band-args [const-args? : bool] [first : i64] [second : i64]) : compiler_ir_types.CompilerIrCallArgs
  (if const-args?
    (compiler_ir_types.CompilerIrCallArgs.Two
      (compiler_ir_types.CompilerIrValue.I64 (+ first 3))
      (compiler_ir_types.CompilerIrValue.I64 (+ second 5)))
    (compiler_ir_types.CompilerIrCallArgs.Two
      (compiler_ir_types.CompilerIrValue.Var first)
      (compiler_ir_types.CompilerIrValue.Var second))))

;; Two ordinary call sites, so the callee is never absorbable and the cost
;; gate's 1000-point absorb bonus never fires. `const-args?` selects the only
;; other term that can move the price: literal arguments give the site two
;; constant arguments and 3 * 2 = 6 points of savings, Mov-materialised
;; variables give it none.
(define (opt-inline-band-caller [const-args? : bool]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (opt-test-symbol "main")
    (compiler_ir_types.compiler-ir-param-seq-empty)
    (compiler_ast_types.AstType.I64)
    4
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "entry")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            2
            (opt-inline-band-symbol)
            (opt-inline-band-args const-args? 0 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Call
            3
            (opt-inline-band-symbol)
            (opt-inline-band-args const-args? 1 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 3)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-inline-band-functions [body : i64] [const-args? : bool]) : compiler_ir_types.CompilerIrFunctionSeq
  (compiler_ir_types.compiler-ir-function-seq-prepend
    (opt-inline-band-caller const-args?)
    (compiler_ir_types.compiler-ir-function-seq-prepend
      (opt-inline-band-callee body)
      (compiler_ir_types.compiler-ir-function-seq-empty))))

(define (opt-inline-multi-call-caller [symbols : OptInlineFrameTestSymbols]) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    symbols.main
