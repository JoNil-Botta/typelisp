(define (opt-gvn-scoped-nearest-dominator-ok?) : bool
  (let
    [out : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-scalar-params)
        (opt-gvn-nearest-scope-blocks))]
    (and
      (= (opt-blocks-mov-src-var out 4 (- 0 1)) 3)
      (= (opt-blocks-mov-src-var out 5 (- 0 1)) 4))))

;; The Pack is in `entry`, while its Var-backed Word extraction is in the
;; dominated `use` block. Global forwarding must rewrite the binop operand to
;; parameter v1; the array DCE then removes both the Word copy and the now-dead
;; Pack.
(define (opt-global-pack-word-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Pack
          2
          (compiler_ir_types.compiler-ir-value-seq-prepend
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.compiler-ir-value-seq-prepend
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-value-seq-empty)))
          (compiler_ast_types.AstType.Struct (ci.intern "Pair")))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Word
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            1
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (opt-global-pack-word-forwarded-blocks) : compiler_ir_types.CompilerIrBlockList
  (let
    [forwarded : compiler_ir_types.CompilerIrFunction
      (compiler_optimize.opt-global-value-number-function
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-function
          "global_pack_word"
          (opt-gvn-test-params)
          (compiler_ast_types.AstType.I64)
          (opt-global-pack-word-blocks)))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks forwarded)]
    [uses : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array 16 blocks)]
    (compiler_optimize.opt-dce-block-list-array uses blocks)))

;; --- wide-literal operand suppression ---------------------------------------
;;
;; Pins `opt-global-copy-keep-wide-left`: a constant that no operand can encode
;; as an immediate stays a Var reference at its use, so its defining Mov keeps
;; the hoistable form the bit-test rewrite (and LICM) built.
;;
;; Left operand of the BinOp defining `dst`: its var id while it is still a Var,
;; -1 once copy propagation replaced it with a literal, -2 when no such BinOp
;; survives.
(define (opt-wide-literal-lhs-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 2)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp actual _ lhs _ _)
        (if (= actual dst)
          (match lhs
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-wide-literal-lhs-instr-seq instrs (+ index 1) dst))]
      [_ (opt-wide-literal-lhs-instr-seq instrs (+ index 1) dst)])))

(define (opt-wide-literal-lhs-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 2)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64 (opt-wide-literal-lhs-instr-seq instrs 0 dst)]
            (if (= found (- 0 2))
              (opt-wide-literal-lhs-var (__tl-box-place rest) dst)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-wide-literal-lhs-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; Right operand of the BinOp defining `dst`, same encoding as the left probe.
(define (opt-wide-literal-rhs-instr-seq
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [dst : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (- 0 2)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp actual _ _ rhs _)
        (if (= actual dst)
          (match rhs
            [(compiler_ir_types.CompilerIrValue.Var id) id]
            [_ (- 0 1)])
          (opt-wide-literal-rhs-instr-seq instrs (+ index 1) dst))]
      [_ (opt-wide-literal-rhs-instr-seq instrs (+ index 1) dst)])))

(define (opt-wide-literal-rhs-var
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [dst : i64]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (- 0 2)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (let
            [found : i64 (opt-wide-literal-rhs-instr-seq instrs 0 dst)]
            (if (= found (- 0 2))
              (opt-wide-literal-rhs-var (__tl-box-place rest) dst)
              found))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (opt-wide-literal-rhs-var
        (compiler_ir_types.compiler-ir-block-seq-to-list seq)
        dst)]))

;; `entry` defines the constant and jumps to the block it dominates, which shifts
;; it by a parameter. This is the bit-test mask shape: the constant is one block
;; up (a preheader, once a loop is around it) and the count is not constant, so
;; the shift can never fold.
(define (opt-wide-literal-cross-block-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.Shr
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; Same two blocks with the constant on the RIGHT. The backend's own wide-RHS
;; relief covers this position, so the fold must survive untouched.
(define (opt-wide-literal-cross-block-rhs-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Jump
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "use")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.BinOp
            4
            (compiler_ir_types.CompilerIrBinOp.BitAnd)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.Var 4)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

;; The constant and its use in ONE block. Nothing is hoistable here, so the
;; literal must still reach the operand -- the global sweep declines it by
;; position and the block-local copy propagation in the scalar folder does it,
;; which is what the whole-pipeline probe below checks.
(define (opt-wide-literal-same-block-blocks [literal : i64]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Mov
          3
          (compiler_ir_types.CompilerIrValue.I64 literal)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.BinOp
          4
          (compiler_ir_types.CompilerIrBinOp.Shr
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var 4)))))
    compiler_ir_types.CompilerIrBlockList.Nil))

;; The global sweep followed by DCE, so a Mov that survives is one the sweep
;; deliberately kept a use for.
(define (opt-wide-literal-gvn-blocks
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (let
    [propagated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-global-value-number-function
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            name
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            blocks)))]
    [uses : (__tl_dyn-array i64)
      (compiler_optimize.opt-collect-blocks-uses-array 16 propagated)]
    (compiler_optimize.opt-dce-block-list-array uses propagated)))

(define (opt-wide-literal-optimized-blocks
  [name : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-function-blocks
    (compiler_optimize.optimize-function
      (compiler_ast_types.ast-node-pool-reader-context-current)
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (opt-gvn-function
        name
        (opt-gvn-scalar-params)
        (compiler_ast_types.AstType.I64)
        blocks))))

;; A 64-bit window mask of the shape `opt-bit-test-mask-block` builds: well
;; outside imm32, so no operand can encode it.
(define (opt-wide-literal-mask) : i64
  4899916392364504625)

(define (compiler-optimize-wide-literal-operand-self-test) : i64
  (let
    [wide-left : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "wide_left"
        (opt-wide-literal-cross-block-blocks (opt-wide-literal-mask)))]
    [imm32-left : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "imm32_left"
        (opt-wide-literal-cross-block-blocks 1234567))]
    [wide-right : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-gvn-blocks
        "wide_right"
        (opt-wide-literal-cross-block-rhs-blocks (opt-wide-literal-mask)))]
    [same-block : compiler_ir_types.CompilerIrBlockList
      (opt-wide-literal-optimized-blocks
        "wide_same_block"
        (opt-wide-literal-same-block-blocks (opt-wide-literal-mask)))]
    (cond
      ;; The wide constant stays a Var operand and its defining Mov survives,
      ;; which is what leaves the constant hoistable.
      [(not (= (opt-wide-literal-lhs-var wide-left 4) 3)) 1]
      [(not
          (=
            (opt-count-mov-i64-value-blocks wide-left (opt-wide-literal-mask))
            1))
        2]
      ;; An imm32 constant is an immediate in the same position, so it folds
      ;; exactly as before and its Mov dies.
      [(not (= (opt-wide-literal-lhs-var imm32-left 4) (- 0 1))) 3]
      [(not (= (opt-count-mov-i64-value-blocks imm32-left 1234567) 0)) 4]
      ;; Right operands keep folding at any width.
      [(not (= (opt-wide-literal-rhs-var wide-right 4) (- 0 1))) 5]
      ;; Nothing to hoist inside one block: the pipeline still folds.
      [(not (= (opt-wide-literal-lhs-var same-block 4) (- 0 1))) 6]
      [else 42])))

;; --- load-GVN substitution mode ---------------------------------------------
;;
;; Every fixture below reads the same `ptr` parameter (var 1) twice, so the
;; second read is redundant with the first and opt-load-cse-core-load rewrites
;; it to `Mov 4 <- Var 3`. Only the shape around the reads changes, which is
;; what decides whether substitution mode deletes that copy.
(define (opt-load-subst-read [dst : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Load
    dst
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ast_types.AstType.I64)))

(define (opt-load-subst-double [dst : i64] [src : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.BinOp
    dst
    (compiler_ir_types.CompilerIrBinOp.Add)
    (compiler_ir_types.CompilerIrValue.Var src)
    (compiler_ir_types.CompilerIrValue.Var src)
    (compiler_ast_types.AstType.I64)))

(define (opt-load-subst-jump [label : String]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Jump
    (compiler_ir_types.compiler-ir-label label)))

(define (opt-load-subst-branch [on-true : String] [on-false : String]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Branch
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.compiler-ir-label on-true)
    (compiler_ir_types.compiler-ir-label on-false)))

(define (opt-load-subst-return [var : i64]) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Return
    (compiler_ir_types.CompilerIrMaybeValue.Some
      (compiler_ir_types.CompilerIrValue.Var var))))

;; Diamond: the join's read is redundant with the entry's, and its only use is
;; an ordinary operand, so the copy goes and the operand reads the entry load.
(define (opt-load-subst-diamond-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-load-subst-read 3)
        (opt-load-subst-branch "then" "else")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs (opt-load-subst-jump "join")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs (opt-load-subst-jump "join")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (opt-load-subst-read 4)
              (opt-load-subst-double 5 4)
              (opt-load-subst-return 5)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Phi-carried: the redundant read's ONLY use is a phi input, whose use position
;; is the incoming edge rather than the phi's block. The substituter refuses phi
;; inputs, so the use survives and the copy stays -- today's Mov form.
(define (opt-load-subst-phi-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (opt-load-subst-read 3)
        (opt-load-subst-branch "then" "else")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "then")
        (opt-test-instrs (opt-load-subst-read 4) (opt-load-subst-jump "join")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "else")
          (opt-test-instrs (opt-load-subst-jump "join")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "join")
            (opt-test-instrs
              (compiler_ir_types.CompilerIrInstr.Phi
                5
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 4)
                  (compiler_ir_types.compiler-ir-label "then")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 3)
                    (compiler_ir_types.compiler-ir-label "else")
                    (compiler_ir_types.CompilerIrPhiInputList.Nil)))
                (compiler_ast_types.AstType.I64))
              (opt-load-subst-return 5)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Loop escape: the dominating read is INSIDE the loop and the redundant read is
;; after it, so substituting would pin the loop's value across every later
;; block. The profitability gate refuses; the copy stays.
(define (opt-load-subst-loop-escape-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs (opt-load-subst-jump "header")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (opt-load-subst-read 3)
          (opt-load-subst-branch "body" "exit")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "body")
          (opt-test-instrs (opt-load-subst-jump "header")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs
              (opt-load-subst-read 4)
              (opt-load-subst-double 5 4)
              (opt-load-subst-return 5)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Same loop: both reads live in the same loop body, so substitution extends the
;; value only where it already lives. The gate allows it and the copy goes.
(define (opt-load-subst-loop-inner-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs (opt-load-subst-jump "header")))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "header")
        (opt-test-instrs
          (opt-load-subst-read 3)
          (opt-load-subst-branch "inner" "exit")))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "inner")
          (opt-test-instrs
            (opt-load-subst-read 4)
            (opt-load-subst-double 5 4)
            (opt-load-subst-jump "header")))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.CompilerIrBlock.Block
            (compiler_ir_types.compiler-ir-label "exit")
            (opt-test-instrs (opt-load-subst-return 3)))
          (compiler_ir_types.CompilerIrBlockList.Nil))))))

(define (opt-load-subst-run [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler_optimize.opt-gvn-blocks
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (opt-gvn-pointer-cond-params)
    blocks))

(define (compiler-optimize-load-gvn-substitution-self-test) : i64
  (let
    [diamond : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-diamond-blocks))]
    [diamond-again : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-run (opt-load-subst-diamond-blocks)))]
    [phi : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-phi-blocks))]
    [loop-escape : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-escape-blocks))]
    [loop-inner : compiler_ir_types.CompilerIrBlockList
      (opt-load-subst-run (opt-load-subst-loop-inner-blocks))]
    (cond
      ;; Diamond: one load left, no copy, and the operand reads the dominating
      ;; load directly.
      [(not (= (opt-count-load-blocks diamond) 1)) 1]
      [(not (= (opt-count-mov-dst-blocks diamond 4) 0)) 2]
      [(not (= (opt-blocks-binop-lhs-var diamond 5 (- 0 1)) 3)) 3]
      ;; Idempotent: a second pass over the substituted blocks changes nothing.
      [(not (= (opt-count-load-blocks diamond-again) 1)) 4]
      [(not (= (opt-count-mov-dst-blocks diamond-again 4) 0)) 5]
      [(not (= (opt-blocks-binop-lhs-var diamond-again 5 (- 0 1)) 3)) 6]
      ;; Phi-carried use: the copy survives as the Mov form, phi input intact.
      [(not (= (opt-count-load-blocks phi) 1)) 7]
      [(not (= (opt-blocks-mov-src-var phi 4 (- 0 1)) 3)) 8]
      ;; Loop escape: rewritten, but left as a copy rather than pinning the
      ;; loop's value across the exit.
      [(not (= (opt-count-load-blocks loop-escape) 1)) 9]
      [(not (= (opt-blocks-mov-src-var loop-escape 4 (- 0 1)) 3)) 10]
      [(not (= (opt-blocks-binop-lhs-var loop-escape 5 (- 0 1)) 4)) 11]
      ;; Same loop: substituted, exactly like the diamond.
      [(not (= (opt-count-load-blocks loop-inner) 1)) 12]
      [(not (= (opt-count-mov-dst-blocks loop-inner 4) 0)) 13]
      [(not (= (opt-blocks-binop-lhs-var loop-inner 5 (- 0 1)) 3)) 14]
      [else 42])))

(define (compiler-optimize-global-value-number-self-test) : i64
  (let
    [dominated : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_dominated"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-dominated-diamond-blocks))))]
    [sibling : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_sibling"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-sibling-blocks))))]
    [loop : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_loop"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-phi-loop-blocks))))]
    [load-safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-barrier-blocks))]
    [load-join-safe : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-join-safe-blocks))]
    [load-store-path : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-store-path-blocks))]
    [single-load-store-forward : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.CompilerIrParamList.Nil)
        (opt-gvn-single-load-store-forward-blocks))]
    [load-call-path : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-cond-params)
        (opt-gvn-load-call-path-blocks))]
    [checked-ref-store-path : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-checked-ref-cond-params)
        (opt-gvn-checked-ref-store-path-blocks false))]
    [checked-ref-root-loss : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-checked-ref-cond-params)
        (opt-gvn-checked-ref-store-path-blocks true))]
    [load-address-redef : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-address-redef-blocks))]
    [load-type-mismatch : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-gvn-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (opt-gvn-pointer-params)
        (opt-gvn-load-type-mismatch-blocks))]
    [copy : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_copy"
            (opt-gvn-pointer-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-copy-blocks))))]
    [cast : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_cast"
            (opt-gvn-pointer-params)
            (compiler_ast_types.AstType.I32)
            (opt-gvn-cast-blocks))))]
    [gep : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.optimize-function
          (compiler_ast_types.ast-node-pool-reader-context-current)
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_gep"
            (opt-gvn-pointer-params)
            (compiler_ast_types.AstType.U8)
            (opt-gvn-gep-blocks))))]
    [global-gep : compiler_ir_types.CompilerIrBlockList
      (compiler_optimize.opt-function-blocks
        (compiler_optimize.opt-global-value-number-function
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (opt-gvn-function
            "gvn_global_gep"
            (opt-gvn-scalar-params)
            (compiler_ast_types.AstType.I64)
            (opt-gvn-global-gep-call-blocks))))]
    [pack-word : compiler_ir_types.CompilerIrBlockList
      (opt-global-pack-word-forwarded-blocks)]
    (cond
      [(not (= (opt-count-arith-blocks dominated) 1)) 1]
      ;; The branch-local copies feed only phi edges. Edge-aware forwarding
      ;; rewrites both inputs to the dominating value, then DCE removes them.
      [(not (= (opt-blocks-mov-src-var dominated 4 (- 0 1)) (- 0 1))) 2]
      [(not (= (opt-blocks-mov-src-var dominated 5 (- 0 1)) (- 0 1))) 3]
      [(not (= (opt-count-arith-blocks sibling) 2)) 4]
      [(not (= (opt-count-arith-blocks loop) 1)) 5]
      [(not (= (opt-blocks-mov-src-var loop 4 (- 0 1)) (- 0 1))) 6]
      ;; The forwarded read's only use is the return value, which substitution
      ;; mode redirects to the dominating load before deleting the copy.
      [(not (= (opt-count-load-blocks load-safe) 1)) 7]
      [(not (= (opt-count-mov-dst-blocks load-safe 4) 0)) 8]
      [(not (= (opt-blocks-return-var load-safe (- 0 1)) 3)) 43]
      [(not (= (opt-count-load-blocks load-join-safe) 1)) 9]
      [(not (= (opt-count-mov-dst-blocks load-join-safe 4) 0)) 10]
      [(not (= (opt-blocks-return-var load-join-safe (- 0 1)) 3)) 44]
      [(not (= (opt-count-load-blocks load-store-path) 2)) 11]
      [(not (= (opt-blocks-mov-src-var load-store-path 4 (- 0 1)) (- 0 1))) 12]
      [(not (= (opt-count-load-blocks load-call-path) 2)) 13]
      [(not (= (opt-blocks-mov-src-var load-call-path 4 (- 0 1)) (- 0 1))) 14]
      [(not (= (opt-count-load-blocks load-address-redef) 2)) 15]
      [(not (= (opt-blocks-mov-src-var load-address-redef 4 (- 0 1)) (- 0 1)))
        16]
      [(not (= (opt-count-load-blocks load-type-mismatch) 2)) 17]
      [(not (= (opt-blocks-binop-lhs-var copy 4 (- 0 1)) 1)) 18]
      [(not (= (opt-count-mov-dst-blocks copy 3) 0)) 19]
      [(not (= (opt-count-cast-blocks cast) 0)) 20]
      [(not (= (opt-count-mov-dst-blocks cast 4) 0)) 21]
      [(not (= (opt-count-gep-blocks gep) 1)) 22]
      [(not (= (opt-count-mov-dst-blocks gep 4) 0)) 23]
      [(not (opt-global-expr-hash-collision-guard-ok?)) 24]
      [(not (opt-gvn-hash-collision-guard-ok?)) 25]
      [(not (opt-gvn-scoped-nearest-dominator-ok?)) 26]
      [(not
          (=
            (opt-count-gep-label-blocks
              global-gep
              (compiler_ir_types.compiler-ir-label "use"))
            1))
        27]
      [(match (compiler_optimize.opt-global-key-for-instr
          (compiler_ir_types.CompilerIrInstr.Gep
            9
            (compiler_ir_types.CompilerIrValue.Global (opt-test-symbol "pool"))
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.I64)))
          [(compiler_optimize.OptMaybeGlobalExprKey.Some _) true]
          [(compiler_optimize.OptMaybeGlobalExprKey.No) false])
        28]
      [(not (= (opt-count-load-blocks checked-ref-store-path) 1)) 29]
      [(not (= (opt-count-mov-dst-blocks checked-ref-store-path 4) 0)) 30]
      [(not (= (opt-blocks-return-var checked-ref-store-path (- 0 1)) 3)) 45]
      [(not (= (opt-count-load-blocks checked-ref-root-loss) 2)) 31]
      [(not
          (= (opt-blocks-mov-src-var checked-ref-root-loss 4 (- 0 1)) (- 0 1)))
        32]
      ;; The forwarded value is a literal, so substitution mode puts the 9 in
      ;; the return operand and drops the copy entirely.
      [(not (= (opt-count-load-blocks single-load-store-forward) 0)) 33]
      [(not (= (opt-count-mov-dst-blocks single-load-store-forward 3) 0)) 34]
      [(not (= (opt-blocks-return-i64 single-load-store-forward (- 0 1)) 9)) 46]
      [(not (= (opt-blocks-binop-lhs-var pack-word 4 (- 0 1)) 1)) 35]
      [(not (= (opt-count-words-blocks pack-word) 0)) 36]
      [(not (= (opt-count-packs-blocks pack-word) 0)) 37]
      [else 42])))

;; Regression fixture for the global-GVN stale-global-read miscompile: the
;; entry block computes a Gep off the CURRENT value of mutable global `pool`,
;; one branch calls a function that may replace `pool`, and the join block
;; recomputes the same Gep. Forwarding the entry Gep into the join would read
;; the pre-call array's capacity address (the opt2 self-build bounds abort in
;; `ty-node-push` once the node pool grew).
(define (opt-gvn-global-gep-call-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.CompilerIrBlock.Block
      (compiler_ir_types.compiler-ir-label "entry")
      (opt-test-instrs
        (compiler_ir_types.CompilerIrInstr.Gep
          3
          (compiler_ir_types.CompilerIrValue.Global (opt-test-symbol "pool"))
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Load
          4
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstr.Branch
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "grow")
          (compiler_ir_types.compiler-ir-label "use"))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.CompilerIrBlock.Block
        (compiler_ir_types.compiler-ir-label "grow")
        (opt-test-instrs
          (compiler_ir_types.CompilerIrInstr.Call
            5
            (opt-test-symbol "grow_pool")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.Unit))
          (compiler_ir_types.CompilerIrInstr.Jump
            (compiler_ir_types.compiler-ir-label "use"))))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "use")
          (opt-test-instrs
            (compiler_ir_types.CompilerIrInstr.Gep
              6
              (compiler_ir_types.CompilerIrValue.Global
                (opt-test-symbol "pool"))
              (compiler_ir_types.CompilerIrValue.I64 8)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Load
              7
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 7)))))
        (compiler_ir_types.CompilerIrBlockList.Nil)))))

