    [index : i64 0]
    (while (< index (array-length source-present))
      (begin
        (if (= (array-ref source-present index) 0)
          unit
          (compiler-reg-var-type-array-set!
            present
            items
            (compiler-reg-remap-id remap index)
            (array-ref source-items index)))
        (set! index (+ index 1))))))

(define (compiler-reg-color-rebuild-types
  [remap : (__tl_dyn-array i64)]
  [vars : i64]
  [types : CompilerRegVarTypes]) : CompilerRegVarTypes
  (let
    [present : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [items : (__tl_dyn-array ast.AstType) (array.make-array ast.AstType vars)]
    (begin
      (compiler-reg-color-scatter-types remap present items types)
      (CompilerRegVarTypes present items))))

;; Spilled scalars are dropped: the id remap re-homes them, so emission's
;; formula-slot fallback covers the new id and a stale Spill offset keyed by
;; the old id must never shadow it.
(define (compiler-reg-color-scatter-assignments
  [remap : (__tl_dyn-array i64)]
  [present : (__tl_dyn-array i64)]
  [items : (__tl_dyn-array CompilerRegLocation)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (let
    [source-present : (__tl_dyn-array i64) assignments.present]
    [source-items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [var : i64 0]
    (begin
      (while (< var (array-length source-present))
        (begin
          (if (= (array-ref source-present var) 0)
            unit
            (let
              [location : CompilerRegLocation (array-ref source-items var)]
              (match location
                [(CompilerRegLocation.Spill _) unit]
                [_
                  (let
                    [new-id : i64 (compiler-reg-remap-id remap var)]
                    (if (and (>= new-id 0) (< new-id (array-length present)))
                      (begin
                        (set! (array-ref present new-id) 1)
                        (set! (array-ref items new-id) location))
                      unit))])))
          (set! var (+ var 1))))
      unit)))

(define (compiler-reg-color-rebuild-assignments
  [remap : (__tl_dyn-array i64)]
  [vars : i64]
  [assignments : CompilerRegAssignmentTable]) : CompilerRegAssignmentTable
  (let
    [present : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [items : (__tl_dyn-array CompilerRegLocation)
      (array.make-array CompilerRegLocation vars)]
    (begin
      (compiler-reg-fill-location-array items (CompilerRegLocation.Spill 0))
      (compiler-reg-color-scatter-assignments remap present items assignments)
      (CompilerRegAssignmentTable present items))))

;; Identity-pin scalar parameter variables: the prologue's param spill writes
;; each parameter to its remapped formula slot, and ordinary parameters keep
;; their ids so those slots are never shared. AVX2 private SPMD parameters need
;; a four-word YMM range, so leave those unpinned for the private-range pass.
(define (compiler-reg-color-param-pins
  [params : ir.CompilerIrParamList]
  [remap : (__tl_dyn-array i64)]
  [slot-ends : (__tl_dyn-array i64)]
  [highest : i64]) : i64
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) highest]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-color-param-pins
        (ir.compiler-ir-param-seq-to-list seq)
        remap
        slot-ends
        highest)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name _ var-id)
          (begin
            (if (and
              (not (compiler-reg-spmd-avx2-special-param? name))
              (< var-id (array-length remap)))
              (begin
                (set! (array-ref remap var-id) var-id)
                (set! (array-ref slot-ends var-id) 9223372036854775807))
              unit)
            (compiler-reg-color-param-pins
              (__tl-box-place rest)
              remap
              slot-ends
              (if (compiler-reg-spmd-avx2-special-param? name)
                highest
                (compiler-reg-max highest (+ var-id 1)))))])]))

;; --- M-B: stack-homed register-group Mov coalescing -------------------------
;; A group-typed `IrInstrMov dst <- src` between two slot-resident group vars
;; round-trips both 8-byte words through the group-return register pair into a
;; SECOND slot pair (4 movs per enum/struct copy, e.g. every match-scrutinee
;; binding). When src's live range ends exactly where dst's begins -- at the
;; mov itself: src's last read is the copy that first defines dst -- the two
;; vars can share one slot pair. The coloring remap aliases dst's id onto
;; src's id, so the emitted IR carries ONE var (word0 + word1 formula slots
;; follow the id) and the mov becomes a same-home no-op the backend elides.
;;
;; Guards (all required):
;;   * dst != src, both group vars (fn-group-vars) of ast-type-eq? types --
;;     same word count and SSE word classes, and the rebuilt per-id type
;;     table entry stays exact for the merged id;
;;   * both slot-resident (CompilerRegNoLocation): never register/pair (their
;;     homes differ), never Spill (a spilled group uses the adjacent
;;     [offset, offset-8] layout, not the two-region formula slots), never
;;     Remat;
;;   * neither in `ineligible`: excludes AddrOf'd vars, whose intervals
;;     understate pointer-mediated reads, and group params, whose formula
;;     slots are the prologue's ABI hand-off contract;
;;   * neither already remapped (parameter identity pins, storage ranges);
;;   * hull(src).end == hull(dst).start, both hulls present. Interval points
;;     are unique per instruction (2 coords each), so this equality proves
;;     the same instruction carries src's LAST liveness event (a read; src is
;;     not in its live-after) and dst's FIRST (its def) -- and that
;;     instruction is this mov. Vars minted by the caller-save/loop-split/
;;     remat/splitkit rewrites have no plan interval and fail the hull check;
;;     those rewrites only insert reads where a value is genuinely live and
;;     only redefine register-homed values, so the plan hulls remain valid
;;     order witnesses for the NoLocation vars admitted here.
(define (compiler-reg-color-hull-bounds
  [intervals : CompilerRegIntervalSeq]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 interval.var]
          [start : i64 interval.start]
          [end : i64 interval.end]
          (if (and (>= var 0) (< var (array-length starts)))
            (begin
              (if (or
                (< (array-ref starts var) 0)
                (< start (array-ref starts var)))
                (set! (array-ref starts var) start)
                unit)
              (if (> end (array-ref ends var))
                (set! (array-ref ends var) end)
                unit))
            unit))
        (set! index (+ index 1))))))

(define (compiler-reg-color-group-mov-alias-instr!
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [alias : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [remap : (__tl_dyn-array i64)]
  [hull-starts : (__tl_dyn-array i64)]
  [hull-ends : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var src-var)
          (if (and
            (>= dst 0)
            (< dst (array-length alias))
            (>= src-var 0)
            (< src-var (array-length alias))
            (not (= dst src-var))
            (live.compiler-live-set-contains? group-vars dst)
            (live.compiler-live-set-contains? group-vars src-var)
            (not (live.compiler-live-set-contains? ineligible dst))
            (not (live.compiler-live-set-contains? ineligible src-var))
            (< (array-ref remap dst) 0)
            (< (array-ref remap src-var) 0)
            (>= (array-ref hull-starts dst) 0)
            (>= (array-ref hull-starts src-var) 0)
            (= (array-ref hull-ends src-var) (array-ref hull-starts dst))
            (ast.ast-type-eq-with-seg-bases?
              type-segment-bases
              (array-ref var-tys dst)
              (array-ref var-tys src-var))
            (match (compiler-reg-assignment-table-lookup assignment-index dst)
              [(CompilerRegMaybeLocation.Some _) false]
              [(CompilerRegMaybeLocation.No) true])
            (match (compiler-reg-assignment-table-lookup
              assignment-index
              src-var)
              [(CompilerRegMaybeLocation.Some _) false]
              [(CompilerRegMaybeLocation.No) true]))
            (set! (array-ref alias dst) src-var)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-color-group-mov-alias-seq!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [alias : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [remap : (__tl_dyn-array i64)]
  [hull-starts : (__tl_dyn-array i64)]
  [hull-ends : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (while (< i len)
      (begin
        (compiler-reg-color-group-mov-alias-instr!
          type-segment-bases
          (array-ref slots i)
          alias
          group-vars
          ineligible
          assignment-index
          var-tys
          remap
          hull-starts
          hull-ends)
        (set! i (+ i 1))))))

(define (compiler-reg-color-group-mov-alias-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [alias : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [remap : (__tl_dyn-array i64)]
  [hull-starts : (__tl_dyn-array i64)]
  [hull-ends : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-group-mov-alias-seq!
              type-segment-bases
              instrs
              alias
              group-vars
              ineligible
              assignment-index
              var-tys
              remap
              hull-starts
              hull-ends)])
        (compiler-reg-color-group-mov-alias-blocks!
          type-segment-bases
          (__tl-box-place rest)
          alias
          group-vars
          ineligible
          assignment-index
          var-tys
          remap
          hull-starts
          hull-ends))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (< i (ir.compiler-ir-block-seq-count seq))
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-group-mov-alias-seq!
                  type-segment-bases
                  instrs
                  alias
                  group-vars
                  ineligible
                  assignment-index
                  var-tys
                  remap
                  hull-starts
                  hull-ends)])
            (set! i (+ i 1)))))]))

;; Follow an alias chain (C=B after B=A) to its root. Chains are acyclic by
;; construction -- each link strictly advances the hull touch point -- but a
;; step cap keeps this total on any malformed input.
(define (compiler-reg-color-group-alias-root
  [alias : (__tl_dyn-array i64)]
  [var : i64]) : i64
  (let
    [root : i64 var]
    [steps : i64 0]
    (begin
      (while (and
        (< steps 64)
        (>= root 0)
        (< root (array-length alias))
        (>= (array-ref alias root) 0))
        (begin
          (set! root (array-ref alias root))
          (set! steps (+ steps 1))))
      root)))

;; --- M-B2: stack-homed SCALAR phi/mov web slot sharing ----------------------
;; A spilled phi web costs a slot-to-slot copy on every incoming edge: the phi's
;; input is written to ITS slot and then copied into the phi's slot (four
;; instructions once the backend has to scavenge a scratch register through
;; push/pop). When the members never hold a live value at the same time ONE slot
;; serves the whole web and every one of those copies disappears: the coloring
;; remap merges their ids, so `compiler-backend-vars-same-home?` (same var id =>
;; same home) makes the backend's leading-phi-copy builder drop the copy before
;; emission, and a Mov between merged ids is a same-home no-op.
;;
;; INTERFERENCE MODEL. The plan's intervals are the CONSERVATIVE hulls, which
;; treat a phi as USING every input AT THE PHI BLOCK; that leaks a loop carry
;; backward around its own loop, so the carry's hull overlaps its phi's hull from
;; function entry onward and the pairs worth merging all look live at once.
;; Legality is therefore judged on EDGE-PRECISE hulls (LLVM PHIElimination
;; semantics: an input is a copy at the end of ITS OWN predecessor), the exact
;; SSA interference model the register coalescer already trusts, recomputed here
;; over the FINAL rewritten blocks so its point coordinates describe the IR the
;; backend actually emits. The plan's conservative hulls keep their existing job
;; unchanged -- deciding which OTHER variable may reuse a slot -- through the
;; ordinary disjoint-interval walk, which now sees the whole web as one variable
;; and therefore reserves the UNION of the members' conservative hulls.
;;
;; WEB RULE (conservative; when in doubt, no alias). Membership is decided by
;; PAIRWISE EP-hull disjointness: a web may absorb another web only when EVERY
;; cross pair of members has non-overlapping hulls, so every pair of members in
;; the result is provably never live at once. The single exception is a Mov
;; witness: `hull(src).end == hull(dst).start` is admitted for THAT pair --
;; exactly the group-Mov rule above. Interval points are unique per instruction
;; (2 coords each), so that equality proves this mov carries src's LAST liveness
;; event and dst's FIRST. A touch WITHOUT a Mov witness is rejected: the backend
;; may write a destination home before reading a source home, and phi parallel
;; copies at a block edge read inputs and write destinations at the same interval
;; position -- the same hazard that makes compiler-reg-color-find-slot demand a
;; STRICT `<`.
;;
;; ORDER INDEPENDENCE (M-B3). The rule above replaces a monotone one: a variable
;; used to join only when its hull started strictly after the web's LATEST end
;; (`web-end`), and only while still virgin. Both guards made the result depend
;; on the order links are offered, and rejected merges that do not interfere at
;; all. In intern_table's it-intern-slice all three loop carries lost their
;; carry-to-phi merge that way: the web absorbed the LATER back-edge member
;; first, after which `web-end` sat past the earlier member's start even though
;; the two hulls are disjoint; and a phi dst that had already joined one web
;; could never be joined to a second. Both are now expressible: webs are unioned
;; (not just extended), and the admission test looks at all member pairs instead
;; of a single running maximum.
;;
;; The old monotone test is still tried FIRST and, when it passes, takes exactly
;; the old action -- so the Mov at-boundary allowance keeps its precise shape and
;; every merge the previous rule would have made at a given state is still made:
;; `web-end(root) < start(later)` implies `end(m) <= web-end(root) < start(later)`
;; for every member m, which is the all-pairs test. The pass therefore admits a
;; superset of the old merges at each decision point.
;;
;; COST. Webs are held as an intrusive circular member list (`web-next`, a
;; singleton points at itself) with a size counter, and merges are gated on the
;; combined size fitting `compiler-reg-color-scalar-web-cap`. One link attempt is
;; O(1) when either web is a singleton -- the overwhelmingly common case, and
;; exactly today's cost -- and at worst O(cap^2) bounded array reads. The splice
;; itself is O(size(absorbed)) and re-points every absorbed member directly at the
;; surviving root, so `alias` stays the depth-one forest the remap propagation and
;; interval rewrite expect.
;;
;; MEMBERSHIP GUARDS mirror the scalar walk's own admission rules, so a merged
;; web colors exactly as one of its members would have: colorable scalars of one
;; stack word, never group vars (their formula slots are the prologue's ABI
;; hand-off contract), never `ineligible` (AddrOf'd vars, whose intervals
;; understate pointer-mediated reads), never already remapped (parameter
;; identity pins), never register-homed (their homes are not slots),
;; ast-type-identical (the rebuilt per-id type table keeps ONE type for the
;; merged id, and the backend recovers operand width from it), and a plan
;; interval must exist -- vars minted by the caller-save/loop-split/remat
;; rewrites have none and the walk never colors them.
(define (compiler-reg-color-ep-hull-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [live-afters : live.CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [after-items : (__tl_dyn-array live.CompilerLiveI64Set) live-afters.items]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [instr : ir.CompilerIrInstr (array-ref slots index)]
          [live-after : live.CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (live.compiler-live-set-empty))]
          [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
          [id-count : i64 (live.compiler-live-instr-use-ids-nophi! instr)]
          (begin
            (if (< id-count 0)
              (begin
                (compiler-reg-extend-set-words
                  starts
                  ends
                  (live.compiler-live-instr-defs instr)
                  0
                  out-point)
                (compiler-reg-extend-set-words
                  starts
                  ends
                  (live.compiler-live-instr-uses-nophi instr)
                  0
                  out-point))
              (begin
                (compiler-reg-extend-interval
                  starts
                  ends
                  (live.compiler-live-instr-def-var instr)
                  out-point)
                (compiler-reg-extend-interval-ids!
                  starts
                  ends
                  ids
                  id-count
                  out-point)))
            (compiler-reg-extend-set-words
              starts
              ends
              live-after
              0
              (+ out-point 1))
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-color-ep-hull-blocks!
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (compiler-reg-color-ep-hull-blocks!
            (__tl-box-place rest)
            liveness
            (compiler-reg-color-ep-hull-seq!
              instrs
              (compiler-reg-live-intervals-find-afters liveness label)
              point
              starts
              ends)
            starts
            ends)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    out-point
                    (compiler-reg-color-ep-hull-seq!
                      instrs
                      (compiler-reg-live-intervals-find-afters liveness label)
                      out-point
                      starts
                      ends))])
              (set! i (+ i 1))))
          out-point))]))

;; Per-variable core of the scalar walk's admission test: colorable, not
;; group- or ineligible-pinned, not already renumbered by the parameter pins,
;; and not register-homed. Nothing here changes between the scalar-web builder
;; and the walk itself, so it is decided ONCE per variable and read back as a
;; single array probe by both the web-eligibility pass below and the interval
;; filter that feeds the walk -- which would otherwise repeat two live-set
;; probes and an assignment lookup per variable AND again per interval.
(define (compiler-reg-color-slot-eligible!
  [slot-eligible : (__tl_dyn-array bool)]
  [vars : i64]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [colorable : (__tl_dyn-array bool)]
  [remap : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (set!
          (array-ref slot-eligible i)
          (and
            (array-ref colorable i)
            (not (live.compiler-live-set-contains? group-vars i))
            (not (live.compiler-live-set-contains? ineligible i))
            (< (array-ref remap i) 0)
            (match (compiler-reg-assignment-table-lookup assignment-index i)
              [(CompilerRegMaybeLocation.Some location)
                (match location
                  [(CompilerRegLocation.Spill _) true]
                  [_ false])]
              [(CompilerRegMaybeLocation.No) true])))
        (set! i (+ i 1))))))

;; One membership decision per variable, taken once so the per-pair test below
;; is three array reads. The scalar walk's own admission test plus the two
;; extra conditions a web member must meet.
(define (compiler-reg-color-scalar-alias-eligible!
  [eligible : (__tl_dyn-array bool)]
  [vars : i64]
  [slot-eligible : (__tl_dyn-array bool)]
  [hull-starts : (__tl_dyn-array i64)]
  [vector-stack-words : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (set!
          (array-ref eligible i)
          (and
            (array-ref slot-eligible i)
            (>= (array-ref hull-starts i) 0)
            (= (compiler-reg-vector-stack-words-for-var vector-stack-words i) 1)))
        (set! i (+ i 1))))))

;; Largest web the all-pairs admission test will build. Bounds every member walk
;; below and keeps a link attempt's worst case at a few hundred array reads; real
;; webs are far smaller (the deepest in the benchmark corpus is 7).
(define compiler-reg-color-scalar-web-cap : i64
  16)

;; EP hulls are convex intervals, so non-overlap is exactly one endpoint compare.
(define (compiler-reg-color-scalar-hulls-disjoint?
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : bool
  (or
    (< (array-ref ep-ends a) (array-ref ep-starts b))
    (< (array-ref ep-ends b) (array-ref ep-starts a))))

;; Disjointness of `x` against every member of the web whose circular member list
;; starts at `root-b`. The single pair (touch-a, touch-b) -- the Mov witness's own
;; src/dst -- may TOUCH at `end(touch-a) == start(touch-b)`; every other pair must
;; be strictly disjoint. Callers pass -1/-1 when there is no Mov witness, which no
;; real var id can equal.
(define (compiler-reg-color-scalar-web-var-disjoint?
  [web-next : (__tl_dyn-array i64)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [x : i64]
  [root-b : i64]
  [touch-a : i64]
  [touch-b : i64]) : bool
  (let
    [y : i64 root-b]
    [steps : i64 0]
    (begin
      (while (< steps compiler-reg-color-scalar-web-cap)
        (begin
          (unless
            (compiler-reg-color-scalar-hulls-disjoint? ep-starts ep-ends x y)
            (unless
              (and
                (or
                  (and (= x touch-a) (= y touch-b))
                  (and (= x touch-b) (= y touch-a)))
                (= (array-ref ep-ends touch-a) (array-ref ep-starts touch-b)))
              (return false)))
          (set! y (array-ref web-next y))
          (set! steps (+ steps 1))
          (when (= y root-b) (return true))))
      false)))

;; Every cross pair of the two webs is disjoint (see the header's WEB RULE).
(define (compiler-reg-color-scalar-webs-disjoint?
  [web-next : (__tl_dyn-array i64)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [root-a : i64]
  [root-b : i64]
  [touch-a : i64]
  [touch-b : i64]) : bool
  (let
    [x : i64 root-a]
    [steps : i64 0]
    (begin
      (while (< steps compiler-reg-color-scalar-web-cap)
        (begin
          (unless
            (compiler-reg-color-scalar-web-var-disjoint?
              web-next
              ep-starts
              ep-ends
              x
              root-b
              touch-a
              touch-b)
            (return false))
          (set! x (array-ref web-next x))
          (set! steps (+ steps 1))
          (when (= x root-a) (return true))))
      false)))

;; Absorb the web rooted at `root-b` into the one rooted at `root-a`: re-point
;; every absorbed member's alias directly at `root-a` (keeping the forest depth
;; one), splice the two circular lists, and carry the size and hull end across.
(define (compiler-reg-color-scalar-web-splice!
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [root-a : i64]
  [root-b : i64]) : unit
  (let
    [a-next : i64 (array-ref web-next root-a)]
    [count : i64 (array-ref web-size root-b)]
    [member : i64 root-b]
    [last : i64 root-b]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref alias member) root-a)
          (set! (array-ref web-root member) false)
          (set!
            (array-ref web-end root-a)
            (compiler-reg-max
              (array-ref web-end root-a)
              (array-ref ep-ends member)))
          (set! last member)
          (set! member (array-ref web-next member))
          (set! i (+ i 1))))
      (set! (array-ref web-next root-a) root-b)
      (set! (array-ref web-next last) a-next)
      (set! (array-ref alias root-a) (- 0 1))
      (set! (array-ref web-root root-a) true)
      (set! (array-ref web-size root-a) (+ (array-ref web-size root-a) count))
      unit)))

;; Join the web owning `later` to the web owning `earlier`. The old monotone test
;; (web's latest EP hull end strictly before `later`'s start, or exactly at it for
;; a Mov witness) is tried first and keeps its exact shape; when it does not
;; apply, the webs merge if EVERY cross pair of members has disjoint hulls. See
;; the header for why the second test subsumes the first at any given state.
(define (compiler-reg-color-scalar-alias-link!
  [type-segment-bases : i64]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [earlier : i64]
  [later : i64]
  [mov-witness : bool]) : unit
  (if (and
    (>= earlier 0)
    (< earlier (array-length alias))
    (>= later 0)
    (< later (array-length alias))
    (not (= earlier later))
    (array-ref eligible earlier)
    (array-ref eligible later)
    (>= (array-ref ep-starts earlier) 0)
    (>= (array-ref ep-starts later) 0))
    (let
      [root : i64 (compiler-reg-color-group-alias-root alias earlier)]
      [other : i64 (compiler-reg-color-group-alias-root alias later)]
      [bounded : bool
        (and
          (>= root 0)
          (< root (array-length alias))
          (>= other 0)
          (< other (array-length alias))
          (not (= root other))
          (array-ref eligible root)
          (array-ref eligible other)
          (>= (array-ref web-end root) 0)
          (>= (array-ref web-end other) 0)
          (ast.ast-type-eq-with-seg-bases?
            type-segment-bases
            (array-ref var-tys root)
            (array-ref var-tys later))
          (ast.ast-type-eq-with-seg-bases?
            type-segment-bases
            (array-ref var-tys root)
            (array-ref var-tys other)))]
      ;; The pre-M-B3 rule, unchanged: `later` still virgin, and the web's
      ;; running maximum end strictly before its start (or the Mov touch).
      [monotone : bool
        (and
          bounded
          (= other later)
          (< (array-ref alias later) 0)
          (not (array-ref web-root later))
          (if (< (array-ref web-end root) (array-ref ep-starts later))
            true
            (and
              mov-witness
              (= (array-ref web-end root) (array-ref ep-ends earlier))
              (= (array-ref ep-ends earlier) (array-ref ep-starts later)))))]
      [merge : bool
        (or
          monotone
          (and
            bounded
            (<=
              (+ (array-ref web-size root) (array-ref web-size other))
              compiler-reg-color-scalar-web-cap)
            (compiler-reg-color-scalar-webs-disjoint?
              web-next
              ep-starts
              ep-ends
              root
              other
              (if mov-witness
                earlier
                (- 0 1))
              (if mov-witness
                later
                (- 0 1)))))]
      (if merge
        (compiler-reg-color-scalar-web-splice!
          alias
          web-root
          web-end
          web-next
          web-size
          ep-ends
          root
          other)
        unit))
    unit))

;; A phi pair has no Mov witness, so both orderings are offered and whichever
;; direction the web rule admits wins; equal starts are impossible for distinct
;; defs and are rejected by both attempts.
;;
;; LOOP-CARRY PRIORITY (M-B3). Inputs are offered in TWO passes: `phi-pass` true
;; visits only inputs that are themselves phi definitions, then a second call
;; visits the rest. A phi dst whose sources conflict with each other can join only
;; ONE of their webs, and the first offer wins; taking the phi-defined source
;; first puts the dst in the LOOP CARRY's web rather than a computed value's.
;; That is the profitable choice: the carry's web already spans the header phi and
;; the back-edge phi, so joining it turns several edges' copies into same-home
;; no-ops, while joining a computed value's singleton web can only ever silence
;; the one edge that value arrives on. In it-intern-slice this is exactly
;; `%208 = phi [%187, if_else.36], [%210, if_then.35]`: `%187` (an `add`) truly
;; overlaps `%210` at its own def point, so only one of the two can be joined, and
;; taking `%210` retires the copies on the if_then.35 and if_merge.37 edges
;; (4.15M dynamic) at the cost of one on if_else.36 (0.79M).
(define (compiler-reg-color-scalar-alias-phi-inputs!
  [type-segment-bases : i64]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]
  [phi-pass : bool]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-scalar-alias-phi-inputs!
        type-segment-bases
        alias
        web-root
        web-end
        web-next
        web-size
        eligible
        var-tys
        ep-starts
        ep-ends
        phi-def
        phi-pass
        dst
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (match value
          [(ir.CompilerIrValue.Var src)
            (let
              [src-is-phi : bool
                (and
                  (>= src 0)
                  (< src (array-length phi-def))
                  (array-ref phi-def src))]
              (when
                (if phi-pass
                  src-is-phi
                  (not src-is-phi))
                (begin
                  (compiler-reg-color-scalar-alias-link!
                    type-segment-bases
                    alias
                    web-root
                    web-end
                    web-next
                    web-size
                    eligible
                    var-tys
                    ep-starts
                    ep-ends
                    src
                    dst
                    false)
                  (compiler-reg-color-scalar-alias-link!
                    type-segment-bases
                    alias
                    web-root
                    web-end
                    web-next
                    web-size
                    eligible
                    var-tys
                    ep-starts
                    ep-ends
                    dst
                    src
                    false))))]
          [_ unit])
        (compiler-reg-color-scalar-alias-phi-inputs!
          type-segment-bases
          alias
          web-root
          web-end
          web-next
          web-size
          eligible
          var-tys
          ep-starts
          ep-ends
          phi-def
          phi-pass
          dst
          (__tl-box-place rest)))]))

;; One instruction's link offers for ONE pass. `phi-pass` true is the loop-carry
;; priority pass (phi-defined phi inputs only); the Mov witness rides that pass so
;; the second visit adds nothing for non-phi instructions. The caller re-reads the
;; instruction for the second pass because a phi's input list is owned.
(define (compiler-reg-color-scalar-alias-instr!
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]
  [phi-pass : bool]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var src-var)
          (when
            phi-pass
            (compiler-reg-color-scalar-alias-link!
              type-segment-bases
              alias
              web-root
              web-end
              web-next
              web-size
              eligible
              var-tys
              ep-starts
              ep-ends
              src-var
              dst
              true))]
        [_ unit])]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-scalar-alias-phi-inputs!
        type-segment-bases
        alias
        web-root
        web-end
        web-next
        web-size
        eligible
        var-tys
        ep-starts
        ep-ends
        phi-def
        phi-pass
        dst
        inputs)]
    [_ unit]))

(define (compiler-reg-color-scalar-alias-seq!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (while (< i len)
      (begin
        ;; Loop-carry priority: offer this instruction's phi-defined inputs (and
        ;; the Mov witness) first, then its remaining inputs.
        (compiler-reg-color-scalar-alias-instr!
          type-segment-bases
          (array-ref slots i)
          alias
          web-root
          web-end
          web-next
          web-size
          eligible
          var-tys
          ep-starts
          ep-ends
          phi-def
          true)
        ;; Only a Phi has anything left for the second pass, and re-reading the
        ;; instruction owns a copy -- borrow-test the tag before paying for it.
        (match (& (array-ref slots i))
          [(ir.CompilerIrInstr.Phi _ _ _)
            (compiler-reg-color-scalar-alias-instr!
              type-segment-bases
              (ir.compiler-ir-instr-seq-ref instrs i)
              alias
              web-root
              web-end
              web-next
              web-size
              eligible
              var-tys
              ep-starts
              ep-ends
              phi-def
              false)]
          [_ unit])
        (set! i (+ i 1))))))

(define (compiler-reg-color-scalar-alias-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-scalar-alias-seq!
              type-segment-bases
              instrs
              alias
              web-root
              web-end
              web-next
              web-size
              eligible
              var-tys
              ep-starts
              ep-ends
              phi-def)])
        (compiler-reg-color-scalar-alias-blocks!
          type-segment-bases
          (__tl-box-place rest)
          alias
          web-root
          web-end
          web-next
          web-size
          eligible
          var-tys
          ep-starts
          ep-ends
          phi-def))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (< i (ir.compiler-ir-block-seq-count seq))
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-scalar-alias-seq!
                  type-segment-bases
                  instrs
                  alias
                  web-root
                  web-end
                  web-next
                  web-size
                  eligible
                  var-tys
                  ep-starts
                  ep-ends
                  phi-def)])
            (set! i (+ i 1)))))]))

;; Mark every variable defined by a Phi, for the loop-carry priority pass.
(define (compiler-reg-color-scalar-phi-def-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (while (< i len)
      (begin
        (match (& (array-ref slots i))
          [(ir.CompilerIrInstr.Phi _ _ _)
            (match (ir.compiler-ir-instr-seq-ref instrs i)
              [(ir.CompilerIrInstr.Phi dst _ _)
                (when
                  (and (>= dst 0) (< dst (array-length phi-def)))
                  (set! (array-ref phi-def dst) true))]
              [_ unit])]
          [_ unit])
        (set! i (+ i 1))))))

(define (compiler-reg-color-scalar-phi-def-blocks!
  [blocks : ir.CompilerIrBlockList]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-scalar-phi-def-seq! instrs phi-def)])
        (compiler-reg-color-scalar-phi-def-blocks!
          (__tl-box-place rest)
          phi-def))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (< i (ir.compiler-ir-block-seq-count seq))
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-scalar-phi-def-seq! instrs phi-def)])
            (set! i (+ i 1)))))]))

;; Cheap gate: does any Mov or Phi in the function relate two members-in-waiting?
;; A function with no candidate pair never pays for the edge-precise liveness
;; fixpoint below, which is the only non-trivial cost this pass adds.
(define (compiler-reg-color-scalar-alias-candidate-inputs?
  [eligible : (__tl_dyn-array bool)]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-scalar-alias-candidate-inputs?
        eligible
        dst
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (if (match value
        [(ir.CompilerIrValue.Var src)
          (and
            (not (= src dst))
            (>= src 0)
            (< src (array-length eligible))
            (array-ref eligible src))]
        [_ false])
        true
        (compiler-reg-color-scalar-alias-candidate-inputs?
          eligible
          dst
          (__tl-box-place rest)))]))

(define (compiler-reg-color-scalar-alias-candidate-instr?
  [instr : ir.CompilerIrInstr]
  [eligible : (__tl_dyn-array bool)]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (and
        (>= dst 0)
        (< dst (array-length eligible))
        (array-ref eligible dst)
        (match src
          [(ir.CompilerIrValue.Var src-var)
            (and
              (not (= src-var dst))
              (>= src-var 0)
              (< src-var (array-length eligible))
              (array-ref eligible src-var))]
          [_ false]))]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (and
        (>= dst 0)
        (< dst (array-length eligible))
        (array-ref eligible dst)
        (compiler-reg-color-scalar-alias-candidate-inputs? eligible dst inputs))]
    [_ false]))

(define (compiler-reg-color-scalar-alias-candidate-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [eligible : (__tl_dyn-array bool)]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    [found : bool false]
    (begin
      (while (and (< i len) (not found))
        (begin
          (if (compiler-reg-color-scalar-alias-candidate-instr?
            (array-ref slots i)
            eligible)
            (set! found true)
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-color-scalar-alias-candidate-blocks?
  [blocks : ir.CompilerIrBlockList]
  [eligible : (__tl_dyn-array bool)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-scalar-alias-candidate-seq? instrs eligible)])
        true
        (compiler-reg-color-scalar-alias-candidate-blocks?
          (__tl-box-place rest)
          eligible))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [found : bool false]
        (begin
          (while (and (< i count) (not found))
            (begin
              (if (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (compiler-reg-color-scalar-alias-candidate-seq?
                    instrs
                    eligible)])
                (set! found true)
                unit)
              (set! i (+ i 1))))
          found))]))

(define (compiler-reg-color-scalar-alias
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [slot-eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [hull-starts : (__tl_dyn-array i64)]
  [vector-stack-words : (__tl_dyn-array i64)]) : (__tl_dyn-array i64)
  (let
    [alias : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [eligible : (__tl_dyn-array bool) (array.make-array bool vars)]
    [_cleared : unit (compiler-reg-fill-i64-array alias (- 0 1))]
    [_eligible : unit
      (compiler-reg-color-scalar-alias-eligible!
        eligible
        vars
        slot-eligible
        hull-starts
        vector-stack-words)]
    (begin
      (if (compiler-reg-color-scalar-alias-candidate-blocks? blocks eligible)
        (let
          [ep-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [ep-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [web-end : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [web-root : (__tl_dyn-array bool) (array.make-array bool vars)]
          ;; Intrusive circular member list + size, one web per variable to start
          ;; (a singleton's `web-next` points at itself).
          [web-next : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [web-size : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [phi-def : (__tl_dyn-array bool) (array.make-array bool vars)]
          [liveness : live.CompilerFunctionLiveness
            (live.compiler-live-analyze-blocks-edge-precise blocks vars)]
          (begin
            (compiler-reg-fill-i64-array ep-starts (- 0 1))
            (compiler-reg-fill-i64-array ep-ends (- 0 1))
            (compiler-reg-color-ep-hull-blocks!
              blocks
              liveness
              0
              ep-starts
              ep-ends)
            (compiler-reg-color-scalar-phi-def-blocks! blocks phi-def)
            (let
              [i : i64 0]
              (while (< i vars)
                (begin
                  (set! (array-ref web-end i) (array-ref ep-ends i))
                  (set! (array-ref web-root i) false)
                  (set! (array-ref web-next i) i)
                  (set! (array-ref web-size i) 1)
                  (set! i (+ i 1)))))
            (compiler-reg-color-scalar-alias-blocks!
              type-segment-bases
              blocks
              alias
              web-root
              web-end
              web-next
              web-size
              eligible
              var-tys
              ep-starts
              ep-ends
              phi-def)))
        unit)
      alias)))

;; Collect the intervals the scalar walk can act on, in the interval sequence's
;; own order, and report how many were kept.
;;
;; An interval is dropped when its web root fails the walk's STATIC skip test,
;; already decided per variable in `slot-eligible`. None of those conditions
;; changes while the walk runs, so the walk would visit such an interval only to
;; skip it without touching any state; dropping it here is invisible to the
;; result and takes ~99% of the entries out of the sort, the extent scan and the
;; walk. The one remaining skip -- `remap` filled in BY the walk for a split
;; interval's earlier sibling -- is dynamic and stays in the walk.
;;
;; Every interval of one variable shares one web root and therefore one verdict,
;; which is what keeps compiler-reg-color-extent-ends exact on the survivors for
;; the variables the walk actually reads. The kept entries still carry their
;; ORIGINAL variable, so the sort key below is the one the full array used;
;; compiler-reg-color-alias-rewrite-intervals! retargets them afterwards exactly
;; as it did before.
(define (compiler-reg-color-walk-interval-fill
  [intervals : CompilerRegIntervalSeq]
  [items : (__tl_dyn-array CompilerRegInterval)]
  [alias : (__tl_dyn-array i64)]
  [slot-eligible : (__tl_dyn-array bool)]) : i64
  (let
    [count : i64 (compiler-reg-interval-seq-count intervals)]
    [index : i64 0]
    [out-index : i64 0]
    (begin
      (while (< index count)
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref intervals index)]
            (if (array-ref
              slot-eligible
              (compiler-reg-color-group-alias-root alias interval.var))
              (begin
                (set! (array-ref items out-index) interval)
                (set! out-index (+ out-index 1)))
              unit))
          (set! index (+ index 1))))
      out-index)))

;; Retarget every kept interval of an aliased member onto its web root, so the
;; scalar walk colors the web ONCE against the union of the members'
;; conservative hulls (compiler-reg-color-extent-ends then reports that union as
;; the root's extent). Starts are untouched and the array is already sorted on
;; the pre-alias key, so the walk's greedy order is unchanged.
(define (compiler-reg-color-alias-rewrite-intervals!
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]
  [alias : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (let
          [interval : CompilerRegInterval (array-ref items i)]
          [var : i64 interval.var]
          [root : i64 (compiler-reg-color-group-alias-root alias var)]
          (if (= root var)
            unit
            (begin
              (set!
                (array-ref items i)
                (CompilerRegInterval root interval.start interval.end))
              unit)))
        (set! i (+ i 1))))))

;; Members took no slot of their own during the walk; hand each one its web
;; root's slot. A member the storage pass already claimed keeps that home, so no
;; earlier decision is overwritten.
(define (compiler-reg-color-alias-propagate-remap!
  [remap : (__tl_dyn-array i64)]
  [alias : (__tl_dyn-array i64)]
  [vars : i64]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (if (< (array-ref remap i) 0)
          (let
            [root : i64 (compiler-reg-color-group-alias-root alias i)]
            (if (and (not (= root i)) (>= (array-ref remap root) 0))
              (set! (array-ref remap i) (array-ref remap root))
              unit))
          unit)
        (set! i (+ i 1))))))

;; Total frame renumbering: colorable stack scalars share slots when their
;; intervals are disjoint, colorable inline-storage ranges are shared above
;; that scalar prefix, every remaining slot-resident variable gets a private
;; dense slot above them, and register-homed variables move to ids that are not
;; used by a stack slot. The assignment table is rebuilt on the new keys.
;;
;; `fusion-pinned` names spilled variables whose IDENTITY the backend still
;; needs after the renumbering: a single-use address temp the following
;; instruction folds into its addressing mode (see
;; compiler-backend-gep-fusion-pinned-vars). Merging one of those onto a shared
;; representative would make the merged id's use count -- recomputed on the
;; remapped blocks -- far greater than one and silently disable the fusion
;; peephole. Pinned variables are therefore withheld from every sharing
;; mechanism (the scalar walk and its phi/mov webs) and land in the private
;; dense slots below, one fresh slot each.
(define (compiler-reg-color-stack-slots
  [type-segment-bases : i64]
  [plan : CompilerRegPlan]
  [group-vars : live.CompilerLiveI64Set]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [slot-candidate-vars : i64]
  [fusion-pinned : live.CompilerLiveI64Set]) : CompilerRegColoring
  (let
    [intervals : CompilerRegIntervalSeq (compiler-reg-plan-intervals plan)]
    (if (compiler-reg-interval-seq-empty? intervals)
      CompilerRegColoring.None
      (let
        [vector-stack-words : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [_vector-stack-words : unit
          (begin
            (compiler-reg-vector-stack-words-params! params vector-stack-words)
            (compiler-reg-vector-stack-words-blocks! blocks vector-stack-words))]
        [slots : i64
          (+
            (+
              vars
              (compiler-reg-vector-stack-extra-slots vector-stack-words 0 0))
            8)]
        [slot-ends : (__tl_dyn-array i64) (array.make-array i64 slots)]
        [assignments : CompilerRegAssignmentTable
          (compiler-reg-plan-assignments plan)]
        [assignment-index : CompilerRegAssignmentTable
          (compiler-reg-assignment-table-with-min-capacity assignments vars)]
        [ineligible : live.CompilerLiveI64Set
          (compiler-reg-plan-ineligible plan)]
        [colorable : (__tl_dyn-array bool) (array.make-array bool vars)]
        ;; Boolean, not a count: the only question asked below is whether the
        ;; variable is referenced at all (see compiler-reg-ref-marks-blocks!).
        [references : (__tl_dyn-array bool) (array.make-array bool vars)]
        [remap : (__tl_dyn-array i64) (array.make-array i64 vars)]
        ;; `colorable` is not cleared here: `array.make-array` zero-fills its
        ;; backing store (bool's default is the all-zero byte), so every element
        ;; already reads `false`, and `compiler-reg-color-flags` below only
        ;; overwrites the entries it decides. `references` above relies on the
        ;; same zero-fill for its "no IR reference" default.
        [_cleared : unit
          (let
            [i : i64 0]
            (begin
              (while (< i slots)
                (begin
                  (set! (array-ref slot-ends i) (- 0 1))
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (set! (array-ref remap i) (- 0 1))
                  (set! i (+ i 1))))))]
        [_flagged : unit
          (begin
            (compiler-reg-color-flags (compiler-reg-plan-types plan) colorable)
            ;; Scratch pseudo-vars are consumed through planned registers or
            ;; the legacy scavenger, never through formula stack slots.
            (let
              [i : i64 slot-candidate-vars]
              (while (< i vars)
                (begin
                  (set! (array-ref colorable i) false)
                  (set! i (+ i 1)))))
            ;; Clearing the colorable flag is exactly the "no shared slot"
            ;; decision: it withdraws the variable from the scalar walk AND
            ;; from the phi/mov web builder (the only two mechanisms that hand
            ;; one slot to several variables), leaving the private-slot loop
            ;; below to give it a fresh id of its own.
            (if (> (live.compiler-live-set-word-count fusion-pinned) 0)
              (let
                [i : i64 0]
                (while (< i vars)
                  (begin
                    (if (live.compiler-live-set-contains? fusion-pinned i)
                      (set! (array-ref colorable i) false)
                      unit)
                    (set! i (+ i 1)))))
              unit))]
        ;; Count direct IR uses and defs, not type-table membership: dead defs
        ;; still emit a write, while raw-id holes and register-only scratch
        ;; pseudo-vars have no instruction reference and need no formula slot.
        [_referenced : unit
          (begin
            (compiler-reg-color-reference-intervals! intervals references)
            (compiler-reg-ref-marks-blocks! references blocks)
            (compiler-reg-spmd-avx2-special-param-references! params references))]
        [var-tys : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType vars)]
        [slot-tys : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType slots)]
        [_typed : unit
          (compiler-reg-color-var-tys (compiler-reg-plan-types plan) var-tys)]
        [param-floor : i64
          (compiler-reg-color-param-pins params remap slot-ends 0)]
        ;; The scalar walk's per-variable admission test, decided once here --
        ;; after the parameter pins are in `remap`, which is the last write
        ;; before the walk itself starts filling it -- and read by the web
        ;; builder and by the interval filter below.
        [slot-eligible : (__tl_dyn-array bool) (array.make-array bool vars)]
        [_slot-eligible : unit
          (compiler-reg-color-slot-eligible!
            slot-eligible
            vars
            group-vars
            ineligible
            assignment-index
            colorable
            remap)]
        ;; Conservative per-var hulls of the plan intervals, shared by the
        ;; scalar-web membership gate below and the group-Mov overlay further
        ;; down (both only ever read them).
        [hull-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [hull-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [_hull-bounds : unit
          (begin
            (compiler-reg-fill-i64-array hull-starts (- 0 1))
            (compiler-reg-fill-i64-array hull-ends (- 0 1))
            (compiler-reg-color-hull-bounds intervals hull-starts hull-ends))]
        ;; M-B2: member -> web-root links for scalar phi/mov webs whose
        ;; edge-precise hulls never overlap (see the header above). Applied by
        ;; retargeting the members' intervals onto the root before the walk,
        ;; and by handing each member the root's slot after it.
        [scalar-alias : (__tl_dyn-array i64)
          (compiler-reg-color-scalar-alias
            type-segment-bases
            blocks
            vars
            slot-eligible
            var-tys
            hull-starts
            vector-stack-words)]
        [sorted : (__tl_dyn-array CompilerRegInterval)
          (array.make-array
            CompilerRegInterval
            (compiler-reg-interval-seq-count intervals))]
        ;; Only the walk-eligible intervals land in `sorted`; `sorted-count`
        ;; bounds them and everything downstream reads that bound instead of
        ;; the array's capacity.
        [sorted-count : i64
          (compiler-reg-color-walk-interval-fill
            intervals
            sorted
            scalar-alias
            slot-eligible)]
        [_sorted : unit (compiler-reg-color-heapsort sorted sorted-count)]
        [_alias-intervals : unit
          (compiler-reg-color-alias-rewrite-intervals!
            sorted
            sorted-count
            scalar-alias)]
        [extent-ends : (__tl_dyn-array i64)
          (compiler-reg-color-extent-ends sorted sorted-count vars)]
        [stack-prefix : i64
          (compiler-reg-color-walk
            type-segment-bases
            sorted
            sorted-count
            0
            assignment-index
            group-vars
            ineligible
            colorable
            var-tys
            slot-ends
            slot-tys
            extent-ends
            0
            remap)]
        [storage-prefix : i64
          (compiler-reg-color-inline-storage
            blocks
            intervals
            slot-ends
            remap
            vars
            stack-prefix)]
        [_alias-remap : unit
          (compiler-reg-color-alias-propagate-remap! remap scalar-alias vars)]
        [group-alias
          : (__tl_dyn-array i64)
          ;; M-B: dst -> src alias links for coalescable group-typed Movs
          ;; (see compiler-reg-color-group-mov-alias-instr!). Applied in the
          ;; private-slot loop below: an aliased dst shares its root's slot
          ;; pair instead of taking a fresh one.
          (let
            [alias : (__tl_dyn-array i64) (array.make-array i64 vars)]
            (begin
              (compiler-reg-fill-i64-array alias (- 0 1))
              (compiler-reg-color-group-mov-alias-blocks!
                type-segment-bases
                blocks
                alias
                group-vars
                ineligible
                assignment-index
                var-tys
                remap
                hull-starts
                hull-ends)
              alias))]
        [slot-count
          : i64
          ;; Private dense slots for final, real IR variables that the scalar
          ;; and inline-storage walks skipped, one slot each. Raw-id holes and
          ;; register-only scratch pseudo-vars have no frame demand. Group-
          ;; mov-aliased dsts share their root's slot pair (word1 formula
          ;; slots follow the id).
          (let
            [next : i64 storage-prefix]
            [i : i64 0]
            (begin
              (while (and (< i vars) (< i slot-candidate-vars))
                (begin
                  (if (or
                    (not (array-ref references i))
                    (>= (array-ref remap i) 0))
                    unit
                    (let
                      [root : i64
                        (compiler-reg-color-group-alias-root group-alias i)]
                      (if (not (= root i))
                        (begin
                          (if (< (array-ref remap root) 0)
                            (let
                              [words : i64
                                (compiler-reg-vector-stack-words-for-var
                                  vector-stack-words
                                  root)]
                              [slot : i64
                                (compiler-reg-color-reserve-private-range!
                                  slot-ends
                                  next
                                  words)]
                              (begin
                                (set!
                                  (array-ref remap root)
                                  (+ slot (- words 1)))
                                (set! next (+ slot words))))
                            unit)
                          (set! (array-ref remap i) (array-ref remap root)))
                        (match (compiler-reg-assignment-table-lookup
                          assignment-index
                          i)
                          [(CompilerRegMaybeLocation.Some location)
                            (match location
                              [(CompilerRegLocation.Spill _)
                                (let
                                  [words : i64
                                    (compiler-reg-vector-stack-words-for-var
                                      vector-stack-words
                                      i)]
                                  [slot : i64
                                    (compiler-reg-color-reserve-private-range!
                                      slot-ends
                                      next
                                      words)]
                                  (begin
                                    (set!
                                      (array-ref remap i)
                                      (+ slot (- words 1)))
                                    (set! next (+ slot words))))]
                              [_ unit])]
                          [(CompilerRegMaybeLocation.No)
                            (let
                              [words : i64
                                (compiler-reg-vector-stack-words-for-var
                                  vector-stack-words
                                  i)]
                              [slot : i64
                                (compiler-reg-color-reserve-private-range!
                                  slot-ends
                                  next
                                  words)]
                              (begin
                                (set! (array-ref remap i) (+ slot (- words 1)))
                                (set! next (+ slot words))))]))))
                  (set! i (+ i 1))))
              ;; Scratch pseudo-vars live above the real-IR watermark and are
              ;; register-only. Preserve those already-disjoint ids instead
              ;; of letting the generic free-id pass alias them onto a frame
              ;; slot that belongs to a real value.
              (while (< i vars)
                (begin
                  (if (< (array-ref remap i) 0)
                    (set! (array-ref remap i) i)
                    unit)
                  (set! i (+ i 1))))
              next))]
        [_renumbered
          : unit
          ;; Register-homed and unmentioned variables take the remaining FREE
          ;; ids of [0, vars), in var order (deterministic). Filling gaps
          ;; keeps the renumbering a bijection into [0, vars): an id at or
          ;; past vars would be silently dropped by the raw-var-sized rebuild
          ;; arrays and side tables. A register-homed variable never touches
          ;; its formula slot, so a free id below the watermark is safe.
          ;; `taken` starts all-false from the zero-filled allocation, as
          ;; `references` and `colorable` above do.
          (let
            [taken : (__tl_dyn-array bool) (array.make-array bool vars)]
            [i : i64 0]
            [free : i64 0]
            (begin
              (while (< i vars)
                (begin
                  (if (and
                    (>= (array-ref remap i) 0)
                    (< (array-ref remap i) vars))
                    (set! (array-ref taken (array-ref remap i)) true)
                    unit)
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (if (< (array-ref remap i) 0)
                    (begin
                      (while (if (< free vars)
                        (array-ref taken free)
                        false)
                        (set! free (+ free 1)))
                      (set! (array-ref remap i) free)
                      (set! free (+ free 1)))
                    unit)
                  (set! i (+ i 1))))))]
        (CompilerRegColoring.Remap
          remap
          (compiler-reg-max slot-count param-floor))))))

;; --- var-id remap application ----------------------------------------------
;; The backend computes stack slots from variable ids at many emission sites,
;; so compaction is applied by rewriting var ids in the IR: each stack-resident
;; variable id becomes its dense slot id and the formula slot follows. Pinned
;; params and register-homed variables keep or receive non-slot ids, so the
;; rebuilt assignment table and formula slots stay valid.
(define (compiler-reg-remap-id [remap : (__tl_dyn-array i64)] [id : i64]) : i64
  (if (and (>= id 0) (< id (array-length remap)))
    (array-ref remap id)
    id))

(define (compiler-reg-remap-value
  [remap : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match value
    [(ir.CompilerIrValue.Var id)
      (ir.CompilerIrValue.Var (compiler-reg-remap-id remap id))]
    [_ value]))

(define (compiler-reg-remap-value-list
  [remap : (__tl_dyn-array i64)]
  [values : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (match (ir.compiler-ir-value-list-force-cons values)
    [(ir.CompilerIrValueList.Nil) ir.CompilerIrValueList.Nil]
    [(ir.CompilerIrValueList.Array seq)
      (compiler-reg-remap-value-list
        remap
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons head rest)
      (ir.compiler-ir-value-cons
        (compiler-reg-remap-value remap head)
        (compiler-reg-remap-value-list remap (__tl-box-place rest)))]))

(define (compiler-reg-remap-params
  [remap : (__tl_dyn-array i64)]
  [params : ir.CompilerIrParamList]) : ir.CompilerIrParamList
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) ir.CompilerIrParamList.Nil]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-remap-params remap (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name ty var)
          (ir.compiler-ir-param-cons
            (ir.CompilerIrParam.Param name ty (compiler-reg-remap-id remap var))
            (compiler-reg-remap-params remap (__tl-box-place rest)))])]))

(define (compiler-reg-remap-call-args
  [remap : (__tl_dyn-array i64)]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) ir.CompilerIrCallArgs.Nil]
    [(ir.CompilerIrCallArgs.One a)
      (ir.CompilerIrCallArgs.One (compiler-reg-remap-value remap a))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (compiler-reg-remap-value remap a)
        (compiler-reg-remap-value remap b))]
    [(ir.CompilerIrCallArgs.Array items)
      (let
        [count : i64 (array-length items)]
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (set!
                (array-ref out i)
                (compiler-reg-remap-value remap (array-ref items i)))
              (set! i (+ i 1))))
          (ir.CompilerIrCallArgs.Array out)))]))

(define (compiler-reg-remap-spmd-call-arg
  [remap : (__tl_dyn-array i64)]
  [arg : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArg
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class value ty)
      (ir.CompilerIrSpmdCallArg.Arg
        class
        (compiler-reg-remap-value remap value)
        ty)]))

(define (compiler-reg-remap-spmd-call-args
  [remap : (__tl_dyn-array i64)]
  [args : ir.CompilerIrSpmdCallArgList]) : ir.CompilerIrSpmdCallArgList
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil) ir.CompilerIrSpmdCallArgList.Nil]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (ir.CompilerIrSpmdCallArgList.Cons
        (compiler-reg-remap-spmd-call-arg remap arg)
        (box (compiler-reg-remap-spmd-call-args remap (__tl-box-place rest))))]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 seq.len]
        [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg) seq.slots]
        [out : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
          (array.make-array ir.CompilerIrSpmdCallArg count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (set!
                (array-ref out i)
                (compiler-reg-remap-spmd-call-arg remap (array-ref slots i)))
              (set! i (+ i 1))))
          (ir.CompilerIrSpmdCallArgList.Array
            (ir.CompilerIrSpmdCallArgSeq out count))))]))

(define (compiler-reg-remap-spmd-call-result
  [remap : (__tl_dyn-array i64)]
  [result : ir.CompilerIrSpmdCallResult]) : ir.CompilerIrSpmdCallResult
  (match result
    [(ir.CompilerIrSpmdCallResult.Unit) ir.CompilerIrSpmdCallResult.Unit]
    [(ir.CompilerIrSpmdCallResult.Value dst class ty)
      (ir.CompilerIrSpmdCallResult.Value
        (compiler-reg-remap-id remap dst)
        class
        ty)]))

(define (compiler-reg-remap-phi-inputs
  [remap : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-remap-phi-inputs
        remap
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (compiler-reg-remap-value remap value)
        label
        (compiler-reg-remap-phi-inputs remap (__tl-box-place rest)))]))

(define (compiler-reg-remap-maybe-value
  [remap : (__tl_dyn-array i64)]
  [value : ir.CompilerIrMaybeValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrMaybeValue.No) ir.CompilerIrMaybeValue.No]
    [(ir.CompilerIrMaybeValue.Some inner)
      (ir.CompilerIrMaybeValue.Some (compiler-reg-remap-value remap inner))]))

(define (compiler-reg-remap-instr
  [remap : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst value ty)
      (ir.CompilerIrInstr.Mov
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap value)
        ty)]
    [(ir.CompilerIrInstr.Alloc dst ty)
      (ir.CompilerIrInstr.Alloc (compiler-reg-remap-id remap dst) ty)]
    [(ir.CompilerIrInstr.AddrOf dst src)
      (ir.CompilerIrInstr.AddrOf
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-id remap src))]
    [(ir.CompilerIrInstr.Gep dst base offset ty)
      (ir.CompilerIrInstr.Gep
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap base)
        (compiler-reg-remap-value remap offset)
        ty)]
    [(ir.CompilerIrInstr.Load dst src ty)
      (ir.CompilerIrInstr.Load
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        ty)]
    [(ir.CompilerIrInstr.StorePtr ptr value ty)
      (ir.CompilerIrInstr.StorePtr
        (compiler-reg-remap-value remap ptr)
        (compiler-reg-remap-value remap value)
        ty)]
    [(ir.CompilerIrInstr.CopyBytes dst src size)
      (ir.CompilerIrInstr.CopyBytes
        (compiler-reg-remap-value remap dst)
        (compiler-reg-remap-value remap src)
        size)]
    [(ir.CompilerIrInstr.BoundsCheck index length ok-label)
      (ir.CompilerIrInstr.BoundsCheck
        (compiler-reg-remap-value remap index)
        (compiler-reg-remap-value remap length)
        ok-label)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Cast
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (ir.CompilerIrInstr.Bitcast
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        from-ty
        to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (ir.CompilerIrInstr.BinOp
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap lhs)
        (compiler-reg-remap-value remap rhs)
        ty)]
    [(ir.CompilerIrInstr.UnOp dst op value ty)
      (ir.CompilerIrInstr.UnOp
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap value)
        ty)]
    [(ir.CompilerIrInstr.LaneId dst lanes ty)
      (ir.CompilerIrInstr.LaneId (compiler-reg-remap-id remap dst) lanes ty)]
    [(ir.CompilerIrInstr.Splat dst value lanes ty)
      (ir.CompilerIrInstr.Splat
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap value)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-bin-op
          (compiler-reg-remap-id remap dst)
          op
          (compiler-reg-remap-value remap lhs)
          (compiler-reg-remap-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-prefix
          (compiler-reg-remap-id remap dst)
          op
          (compiler-reg-remap-value remap src)
          (compiler-reg-remap-value remap carry)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorReduce dst op src lanes ty)
      (ir.CompilerIrInstr.VectorReduce
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap src)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [op (__tl-project-field (__tl-box-place payload-box) op)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-compare
          (compiler-reg-remap-id remap dst)
          op
          (compiler-reg-remap-value remap lhs)
          (compiler-reg-remap-value remap rhs)
          lanes
          ty))]
    [(ir.CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (ir.CompilerIrInstr.MaskBinOp
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap lhs)
        (compiler-reg-remap-value remap rhs)
        lanes)]
    [(ir.CompilerIrInstr.MaskNot dst src lanes)
      (ir.CompilerIrInstr.MaskNot
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        lanes)]
    [(ir.CompilerIrInstr.MaskReduce dst op src lanes)
      (ir.CompilerIrInstr.MaskReduce
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap src)
        lanes)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [true-value (__tl-project-field (__tl-box-place payload-box) on-true)]
        [false-value (__tl-project-field (__tl-box-place payload-box) on-false)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-select
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap mask)
          (compiler-reg-remap-value remap true-value)
          (compiler-reg-remap-value remap false-value)
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorLoad dst base index lanes ty)
      (ir.CompilerIrInstr.VectorLoad
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap base)
        (compiler-reg-remap-value remap index)
        lanes
        ty)]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-store
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index)
          (compiler-reg-remap-value remap value)
          lanes
          ty))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-predicated-store
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index)
          (compiler-reg-remap-value remap value)
          (compiler-reg-remap-value remap mask)
          lanes
          ty))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-predicated-load
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index)
          (compiler-reg-remap-value remap mask)
          lanes
          ty))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [lane-offset
          (__tl-project-field (__tl-box-place payload-box) lane-offset)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-gather-load
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index-base)
          (compiler-reg-remap-value remap index)
          lane-offset
          lanes
          ty))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (ir.ir-instr-vector-shuffle
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap source)
          (compiler-reg-remap-value remap selector-low)
          (compiler-reg-remap-maybe-value remap selector-high)
          (compiler-reg-remap-value remap active-lanes)
          lanes
          ty))]
    [(ir.CompilerIrInstr.TailMask dst index length lanes)
      (ir.CompilerIrInstr.TailMask
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap index)
        (compiler-reg-remap-value remap length)
        lanes)]
    [(ir.CompilerIrInstr.EntryArgc dst)
      (ir.CompilerIrInstr.EntryArgc (compiler-reg-remap-id remap dst))]
    [(ir.CompilerIrInstr.EntryArgv dst)
      (ir.CompilerIrInstr.EntryArgv (compiler-reg-remap-id remap dst))]
    [(ir.CompilerIrInstr.EntryEnvp dst)
      (ir.CompilerIrInstr.EntryEnvp (compiler-reg-remap-id remap dst))]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (ir.CompilerIrInstr.CpuId
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap leaf)
        (compiler-reg-remap-value remap subleaf)
        reg-index)]
    [(ir.CompilerIrInstr.Xgetbv dst index)
      (ir.CompilerIrInstr.Xgetbv
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap index))]
    [(ir.CompilerIrInstr.Syscall dst args)
      (ir.CompilerIrInstr.Syscall
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-call-args remap args))]
    [(ir.CompilerIrInstr.Call dst name args ty)
      (ir.CompilerIrInstr.Call
        (compiler-reg-remap-id remap dst)
        name
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirect dst callee args ty)
      (ir.CompilerIrInstr.CallIndirect
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap callee)
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(ir.CompilerIrInstr.CallIndirectC dst callee args ty)
      (ir.CompilerIrInstr.CallIndirectC
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap callee)
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-cabi-store-result
          (compiler-reg-remap-value remap base)
          name
          (compiler-reg-remap-call-args remap args)
          slots))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [slots (__tl-project-field (__tl-box-place payload-box) slots)]
        (ir.ir-instr-call-indirect-cabi-store-result
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap callee)
          (compiler-reg-remap-call-args remap args)
          slots))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (ir.ir-instr-spmd-call
          callee
          backend
          lanes
          (compiler-reg-remap-value remap active-mask)
          (compiler-reg-remap-spmd-call-args remap args)
          (compiler-reg-remap-spmd-call-result remap result)))]
    [(ir.CompilerIrInstr.TailCall name args ty)
      (ir.CompilerIrInstr.TailCall
        name
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(ir.CompilerIrInstr.TailCallIndirect callee args ty)
      (ir.CompilerIrInstr.TailCallIndirect
        (compiler-reg-remap-value remap callee)
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(ir.CompilerIrInstr.Store name value ty)
      (ir.CompilerIrInstr.Store name (compiler-reg-remap-value remap value) ty)]
    [(ir.CompilerIrInstr.Jump _) instr]
    [(ir.CompilerIrInstr.Branch cond true-label false-label)
      (ir.CompilerIrInstr.Branch
        (compiler-reg-remap-value remap cond)
        true-label
        false-label)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (ir.CompilerIrInstr.TotalEnumBranch
        (compiler-reg-remap-value remap cond)
        true-label
        false-label)]
    [(ir.CompilerIrInstr.Return value)
      (ir.CompilerIrInstr.Return (compiler-reg-remap-maybe-value remap value))]
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-phi-inputs remap inputs)
        ty)]
    [(ir.CompilerIrInstr.Pack dst words ty)
      (ir.CompilerIrInstr.Pack
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value-list remap words)
        ty)]
    [(ir.CompilerIrInstr.Word dst src index ty)
      (ir.CompilerIrInstr.Word
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        index
        ty)]
    [(ir.CompilerIrInstr.Switch index base cases default-label)
      (ir.CompilerIrInstr.Switch
        (compiler-reg-remap-value remap index)
        base
        cases
        default-label)]
    [(ir.CompilerIrInstr.TotalEnumSwitch
        index
        base
        cases
        default-label
        trap-label)
      (ir.CompilerIrInstr.TotalEnumSwitch
        (compiler-reg-remap-value remap index)
        base
        cases
        default-label
        trap-label)]))

;; A 1:1 var remap: the output is exactly as long as the input, so it is
;; written straight into a right-sized dense sequence instead of through a
;; cons spine. The output is FRESH and the input is never written through, so
;; the aliasing graph is unchanged and no unique-ownership argument is needed
;; (refs #5726).
(define (compiler-reg-remap-instr-seq
  [remap : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref out index)
            (compiler-reg-remap-instr remap (array-ref slots index)))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

(define (compiler-reg-remap-blocks
  [remap : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.CompilerIrBlockList.Cons
            (ir.CompilerIrBlock.Block
              label
              (compiler-reg-remap-instr-seq remap instrs))
            (box (compiler-reg-remap-blocks remap (__tl-box-place rest))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    (array-ref slots i)
                    (ir.CompilerIrBlock.Block
                      label
                      (compiler-reg-remap-instr-seq remap instrs)))])
              (set! i (+ i 1))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count))))]))

(define (compiler-reg-plan-assignments [plan : CompilerRegPlan]) : CompilerRegAssignmentTable
  (match plan
    [(CompilerRegPlan.Plan assignments _ _ _ _ _) assignments]))

(define (compiler-reg-plan-ineligible [plan : CompilerRegPlan]) : live.CompilerLiveI64Set
  (match plan
    [(CompilerRegPlan.Plan _ ineligible _ _ _ _) ineligible]))

(define (compiler-reg-plan-intervals [plan : CompilerRegPlan]) : CompilerRegIntervalSeq
  (match plan
    [(CompilerRegPlan.Plan _ _ intervals _ _ _) intervals]))

(define (compiler-reg-plan-types [plan : CompilerRegPlan]) : CompilerRegVarTypes
  (match plan
    [(CompilerRegPlan.Plan _ _ _ types _ _) types]))

(define (compiler-reg-plan-caller-save-regs [plan : CompilerRegPlan]) : (__tl_dyn-array
    i64)
  (match plan
    [(CompilerRegPlan.Plan _ _ _ _ split _)
      (compiler-reg-call-split-regs split)]))

(define (compiler-reg-plan-caller-save-regions [plan : CompilerRegPlan]) : CompilerRegCallRegionSeq
  (match plan
    [(CompilerRegPlan.Plan _ _ _ _ split _)
      (compiler-reg-call-split-regions split)]))

(define (compiler-reg-plan-caller-save-evictions [plan : CompilerRegPlan]) : CompilerRegCallEvictSeq
  (match plan
    [(CompilerRegPlan.Plan _ _ _ _ split _)
      (compiler-reg-call-split-evictions split)]))

(define (compiler-reg-assignment-table-merge
  [extra : CompilerRegAssignmentTable]
  [base : CompilerRegAssignmentTable]) : CompilerRegAssignmentTable
  (let
    [out : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-copy-with-capacity
        base
        (array-length extra.present))]
    (begin
      (compiler-reg-assignment-table-overlay! out extra)
      out)))

(define (compiler-reg-var-types-merge
  [extra : CompilerRegVarTypes]
  [base : CompilerRegVarTypes]) : CompilerRegVarTypes
  (let
    [extra-present : (__tl_dyn-array i64) extra.present]
    [extra-items : (__tl_dyn-array ast.AstType) extra.items]
    [base-present : (__tl_dyn-array i64) base.present]
    [base-items : (__tl_dyn-array ast.AstType) base.items]
    (if (= (array-length extra-present) 0)
      base
      (let
        [size : i64
          (if (> (array-length extra-present) (array-length base-present))
            (array-length extra-present)
            (array-length base-present))]
        [present : (__tl_dyn-array i64) (array.make-array i64 size)]
        [items : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType size)]
        [index : i64 0]
        (begin
          (while (< index (array-length base-present))
            (begin
              (set! (array-ref present index) (array-ref base-present index))
              (set! (array-ref items index) (array-ref base-items index))
              (set! index (+ index 1))))
          (set! index 0)
          (while (< index (array-length extra-present))
            (begin
              (if (= (array-ref extra-present index) 0)
                unit
                (begin
                  (set! (array-ref present index) 1)
                  (set! (array-ref items index) (array-ref extra-items index))))
              (set! index (+ index 1))))
          (CompilerRegVarTypes present items))))))

(define (compiler-reg-plan-with-call-save-rewrite
  [plan : CompilerRegPlan]
  [rewrite : CompilerRegCallSaveRewrite]) : CompilerRegPlan
  (match plan
    [(CompilerRegPlan.Plan
        assignments
        ineligible
        intervals
        types
        shadows
        split-plan)
      (match rewrite
        [(CompilerRegCallSaveRewrite.Rewrite
            _
            _
            _
            extra-assignments
            extra-types)
          (CompilerRegPlan.Plan
            (compiler-reg-assignment-table-merge extra-assignments assignments)
            ineligible
            intervals
            (compiler-reg-var-types-merge extra-types types)
            shadows
            split-plan)])]))

;; Leaf-CSR replanning temporarily preassigns an adjacent compare->branch result
;; to the loop register so the greedy can place the real split range there.
;; That boolean is proven fuse-only by candidate selection and therefore has no
;; materialized home in emitted code. Publish it as frame-free rematerialized
;; metadata after allocation so scratch occupancy does not treat the phantom
;; result as a second physical value. Fresh split vars are >= `in-vars` and keep
;; their real preassigned homes.
(define (compiler-reg-leaf-csr-phantom-assignments
  [assignments : CompilerRegAssignmentTable]
  [in-vars : i64]) : CompilerRegAssignmentTable
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [limit : i64
      (if (< in-vars (array-length present))
        in-vars
        (array-length present))]
    [out : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-make limit)]
    [var : i64 0]
    (begin
      (while (< var limit)
        (begin
          (if (= (array-ref present var) 0)
            unit
            (begin
              (compiler-reg-assignment-table-insert
                out
                var
                (CompilerRegLocation.Remat (ir.CompilerIrValue.Bool false)))
              unit))
          (set! var (+ var 1))))
      out)))

(define (compiler-reg-plan-hide-leaf-csr-phantoms
  [plan : CompilerRegPlan]
  [preassignments : CompilerRegAssignmentTable]
  [in-vars : i64]) : CompilerRegPlan
  (match plan
    [(CompilerRegPlan.Plan
        assignments
        ineligible
        intervals
        types
        shadows
        split-plan)
      (CompilerRegPlan.Plan
        (compiler-reg-assignment-table-merge
          (compiler-reg-leaf-csr-phantom-assignments preassignments in-vars)
          assignments)
        ineligible
        intervals
        types
        shadows
        split-plan)]))

(define (compiler-reg-plan-var-count-intervals
  [intervals : CompilerRegIntervalSeq]
  [best : i64]) : i64
  (let
    [out : i64 best]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (begin
          (let
            [var : i64
              (__tl-project-field
                (compiler-reg-interval-seq-ref intervals index)
                var)]
            (if (>= var out)
              (set! out (+ var 1))
              unit))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-plan-var-count-assignments
  [assignments : CompilerRegAssignmentTable]
  [best : i64]) : i64
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [var : i64 (- (array-length present) 1)]
    (begin
      (while (if (< var 0)
        false
        (= (array-ref present var) 0))
        (set! var (- var 1)))
      (if (>= var best)
        (+ var 1)
        best))))

(define (compiler-reg-plan-var-count-types
  [types : CompilerRegVarTypes]
  [best : i64]) : i64
  (let
    [present : (__tl_dyn-array i64) types.present]
    [index : i64 (- (array-length present) 1)]
    (begin
      (while (if (< index 0)
        false
        (= (array-ref present index) 0))
        (set! index (- index 1)))
      (if (>= index best)
        (+ index 1)
        best))))

(define (compiler-reg-plan-var-count [plan : CompilerRegPlan] [min-vars : i64]) : i64
  (match plan
    [(CompilerRegPlan.Plan assignments _ intervals types _ _)
      (compiler-reg-plan-var-count-types
        types
        (compiler-reg-plan-var-count-assignments
          assignments
          (compiler-reg-plan-var-count-intervals intervals min-vars)))]))

;; A scratch requirement is an instruction-selection temporary that must have a
;; physical register for a bounded point range.  The requirement is independent
;; of any particular emitter family: `role` identifies the consumer, while the
;; typed constraint carries the register file and legal-home policy.  An empty
;; assigned register is an explicit "use the legacy scavenger" outcome.
(defenum CompilerRegScratchClass
  (Gp)
  (Xmm))

(defenum CompilerRegScratchRole
  (CallTarget)
  (CallStage)
  (CallMemoryXmm)
  (AggregateWord)
  (PhiCycle)
  (PhiCycleXmm)
  (PhiStage)
  (SwitchIndex)
  (SwitchTable)
  (BoundsLength)
  (BoundsIndex)
  (ShuffleActive)
  (ShuffleSelector)
  (MemoryAddress)
  (MemoryIndex)
  (MemoryValue)
  (CopyDst)
  (CopySrc)
  (CopyValue)
  (CopyValueXmm)
  (SplatValueGp)
  (SplatValueXmm)
  (SimdAddressBase)
  (SimdAddressIndex)
  (TailMaskCount)
  (TailMaskIndex)
  (TailMaskBits)
  (VectorPrefixCarry)
  (VectorPrefixBits)
  (VectorPrefixValue)
  (VectorPrefixWork0)
  (VectorPrefixWork1)
  (VectorReduceAccumulator)
  (VectorReduceScratch)
  (FloatCastValueXmm)
  (FloatCastValueGp)
  (FloatCastScratchGp)
  (FloatBitcastValueXmm)
  (FloatBitcastValueGp)
  (FloatMoveValueXmm)
  (FloatMemoryValueXmm)
  (FloatArithmeticResultXmm)
  (FloatArithmeticRhsXmm)
  (FloatCompareLhsXmm)
  (FloatCompareRhsXmm)
  (FloatCompareResultGp)
  (FloatUnaryResultXmm)
  (FloatReturnResultXmm)
  (FloatReturnResultGp)
  (ScalarPrimary)
  (ScalarSecondary)
  (ScalarTertiary)
  (FixedRax)
  (FixedRdx)
  (FixedRcx)
  (BranchTest)
  (CpuIdSave))

(defstruct CompilerRegScratchConstraint
  (register-class CompilerRegScratchClass)
  (allowed CompilerRegIdSeq)
  (excluded CompilerRegIdSeq)
  (fixed i64))

(defstruct CompilerRegScratchRequirement
  (point i64)
  (ordinal i64)
  (role CompilerRegScratchRole)
  (constraint CompilerRegScratchConstraint)
  (lo i64)
  (hi i64)
  (var i64))

(defstruct CompilerRegScratchAssignment
  (requirement CompilerRegScratchRequirement)
  (register i64))

;; `first[instruction-index]` plus the slot ordinal is an O(1) item lookup.
;; Points are the allocator's even instruction points, so instruction-index is
;; point/2 for list and dense block representations alike.  The arrays are
;; allocated to the exact function counts: there is no site cap.
(defstruct CompilerRegScratchPlan
  (items (__tl_dyn-array CompilerRegScratchAssignment))
  (first (__tl_dyn-array i64))
  (slots (__tl_dyn-array i64)))

(defenum CompilerRegScratchPlanResult
  (Result CompilerRegPlan CompilerRegScratchPlan))

(define (compiler-reg-scratch-plan-empty) : CompilerRegScratchPlan
  (CompilerRegScratchPlan
    (array.make-array CompilerRegScratchAssignment 0)
    (array.make-array i64 0)
    (array.make-array i64 0)))

(define (compiler-reg-scratch-plan-count [plan : CompilerRegScratchPlan]) : i64
  (array-length plan.items))

(define (compiler-reg-scratch-plan-register
  [plan : CompilerRegScratchPlan]
  [point : i64]
  [ordinal : i64]) : i64
  (if (or (< point 0) (not (= (% point 2) 0)) (< ordinal 0))
    cabi.compiler-reg-id-invalid
    (let
      [instruction : i64 (/ point 2)]
      [firsts : (__tl_dyn-array i64) plan.first]
      [slot-counts : (__tl_dyn-array i64) plan.slots]
      (if (or
        (>= instruction (array-length firsts))
        (>= instruction (array-length slot-counts))
        (>= ordinal (array-ref slot-counts instruction)))
        cabi.compiler-reg-id-invalid
        (let
          [index : i64 (+ (array-ref firsts instruction) ordinal)]
          [items : (__tl_dyn-array CompilerRegScratchAssignment) plan.items]
          (if (or (< index 0) (>= index (array-length items)))
            cabi.compiler-reg-id-invalid
            (let
              [item : CompilerRegScratchAssignment (array-ref items index)]
              [requirement : CompilerRegScratchRequirement item.requirement]
              (if (and
                (= requirement.point point)
                (= requirement.ordinal ordinal))
                item.register
                cabi.compiler-reg-id-invalid))))))))

(define (compiler-reg-scratch-var-register-homed?
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register _) true]
        [(CompilerRegLocation.RegisterPair _ _) true]
        [_ false])]
    [_ false]))

(define (compiler-reg-scratch-value-direct?
  [assignments : CompilerRegAssignmentTable]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (compiler-reg-scratch-var-register-homed? assignments var)]
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.Unit) true]
    [_ false]))

(define (compiler-reg-scratch-value-integer-immediate?
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [_ false]))

(define (compiler-reg-scratch-value-register-homed?
  [assignments : CompilerRegAssignmentTable]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (compiler-reg-scratch-var-register-homed? assignments var)]
    [_ false]))

(define (compiler-reg-scratch-value-same-home?
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]) : bool
  (match src
    [(ir.CompilerIrValue.Var src-var)
      (if (= dst src-var)
        true
        (match (compiler-reg-assignment-lookup assignments dst)
          [(CompilerRegMaybeLocation.Some dst-location)
            (match (compiler-reg-assignment-lookup assignments src-var)
              [(CompilerRegMaybeLocation.Some src-location)
                (compiler-reg-location-eq? dst-location src-location)]
              [(CompilerRegMaybeLocation.No) false])]
          [(CompilerRegMaybeLocation.No) false]))]
    [_ false]))

(define (compiler-reg-scratch-var-register-home
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : i64
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register reg) reg]
        [_ cabi.compiler-reg-id-invalid])]
    [(CompilerRegMaybeLocation.No) cabi.compiler-reg-id-invalid]))

(define (compiler-reg-scratch-float-value-register
  [assignments : CompilerRegAssignmentTable]
  [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var var)
      (let
        [home : i64 (compiler-reg-scratch-var-register-home assignments var)]
        (if (cabi.compiler-abi-xmm-register-id? home)
          home
          cabi.compiler-reg-id-invalid))]
    [_ cabi.compiler-reg-id-invalid]))

(define (compiler-reg-scratch-float-value-memory?
  [assignments : CompilerRegAssignmentTable]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _) true]
            [_ false])]
        [(CompilerRegMaybeLocation.No) true])]
    [(ir.CompilerIrValue.Global _) true]
    [(ir.CompilerIrValue.F64 _) true]
    [_ false]))

(define (compiler-reg-scratch-float-rhs-direct?
  [assignments : CompilerRegAssignmentTable]
  [rhs : ir.CompilerIrValue]
  [accumulator : i64]) : bool
  (let
    [home : i64 (compiler-reg-scratch-float-value-register assignments rhs)]
    (or
      (and
        (not (= home cabi.compiler-reg-id-invalid))
        (not (compiler-reg-registers-overlap? home accumulator)))
      (compiler-reg-scratch-float-value-memory? assignments rhs))))

(define (compiler-reg-scratch-float-value?
  [types : CompilerRegVarTypes]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var)
      (match (compiler-reg-var-types-lookup types var)
        [(CompilerRegMaybeType.Some ty) (compiler-reg-float-type? ty)]
        [(CompilerRegMaybeType.No) false])]
    [(ir.CompilerIrValue.F64 _) true]
    [_ false]))

(define (compiler-reg-scratch-float-binop?
  [types : CompilerRegVarTypes]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (or
    (compiler-reg-float-type? ty)
    (compiler-reg-scratch-float-value? types lhs)
    (compiler-reg-scratch-float-value? types rhs)))

(define (compiler-reg-scratch-compare-op? [op : ir.CompilerIrBinOp]) : bool
  (ir.compiler-ir-binop-compare? op))

(define (compiler-reg-scratch-float-arithmetic-slot-count
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [rhs : ir.CompilerIrValue]
  [binop-return : bool]) : i64
  (if binop-return
    (+
      1
      (if (compiler-reg-scratch-float-rhs-direct?
        assignments
        rhs
        (cabi.compiler-abi-xmm-register-id 0))
        0
        1))
    (let
      [dst-home : i64 (compiler-reg-scratch-var-register-home assignments dst)]
      (if (and
        (>= (compiler-reg-xmm-family-index dst-home) 0)
        (compiler-reg-scratch-float-rhs-direct? assignments rhs dst-home))
        0
        (+
          1
          (if (compiler-reg-scratch-float-rhs-direct?
            assignments
            rhs
            cabi.compiler-reg-id-invalid)
            0
            1))))))

(define (compiler-reg-scratch-float-compare-fallback?
  [assignments : CompilerRegAssignmentTable]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : bool
  (let
    [lhs-home : i64 (compiler-reg-scratch-float-value-register assignments lhs)]
    (or
      (= lhs-home cabi.compiler-reg-id-invalid)
      (not (compiler-reg-scratch-float-rhs-direct? assignments rhs lhs-home)))))

(define (compiler-reg-scratch-float-compare-slot-count
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [binop-return : bool]) : i64
  (let
    [fallback? : bool
      (compiler-reg-scratch-float-compare-fallback? assignments lhs rhs)]
    [rhs-temp? : bool
      (and
        fallback?
        (not
          (compiler-reg-scratch-float-rhs-direct?
            assignments
            rhs
            cabi.compiler-reg-id-invalid)))]
    (if binop-return
      (+
        1
        (if fallback?
          1
          0)
        (if rhs-temp?
          1
          0))
      (+
        (if fallback?
          1
          0)
        (if rhs-temp?
          1
          0)
        (if (compiler-reg-scratch-var-register-homed? assignments dst)
          0
          1)))))

(define (compiler-reg-scratch-cast-xmm-needed?
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and from-float to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and (not from-float) to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and from-float (not to-float))
        (not (compiler-reg-scratch-value-register-homed? assignments src))]
      [else false])))

(define (compiler-reg-scratch-cast-gp-count
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : i64
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and (not from-float) to-float)
        ;; Unsigned 64-bit conversion destructively shifts a copy and needs a
        ;; second GP sibling for the low bit, even when the input is homed.
        (match from-ty
          [(ast.AstType.U64) 2]
          [_
            (if (compiler-reg-scratch-value-register-homed? assignments src)
              0
              1)])]
      [(and from-float (not to-float))
        (if (compiler-reg-scratch-var-register-homed? assignments dst)
          0
          1)]
      [else 0])))

(define (compiler-reg-scratch-cast-slot-count
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : i64
  (if (and
    (ast.ast-type-eq-with-seg-bases? type-segment-bases from-ty to-ty)
    (compiler-reg-scratch-value-same-home? assignments dst src))
    0
    (+
      (if (compiler-reg-scratch-cast-xmm-needed?
        assignments
        dst
        src
        from-ty
        to-ty)
        1
        0)
      (compiler-reg-scratch-cast-gp-count assignments dst src from-ty to-ty))))

(define (compiler-reg-scratch-bitcast-xmm-needed?
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and from-float (not to-float))
        (not (compiler-reg-scratch-value-register-homed? assignments src))]
      [(and (not from-float) to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and from-float to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [else false])))

(define (compiler-reg-scratch-bitcast-gp-needed?
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and from-float (not to-float))
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and (not from-float) to-float)
        (not (compiler-reg-scratch-value-register-homed? assignments src))]
      [else false])))

(define (compiler-reg-scratch-bitcast-slot-count
  [assignments : CompilerRegAssignmentTable]
  [dst : i64]
  [src : ir.CompilerIrValue]
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : i64
  (+
    (if (compiler-reg-scratch-bitcast-xmm-needed?
      assignments
      dst
      src
      from-ty
      to-ty)
      1
      0)
    (if (compiler-reg-scratch-bitcast-gp-needed?
      assignments
      dst
      src
      from-ty
      to-ty)
      1
      0)))

(define (compiler-reg-scratch-binop-return-next?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 1) (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.BinOp dst _ _ _ _)
        (match (ir.compiler-ir-instr-seq-ref instrs (+ index 1))
          [(ir.CompilerIrInstr.Return maybe)
            (match maybe
              [(ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var value))
                (= value dst)]
              [_ false])]
          [_ false])]
      [_ false])))

(define (compiler-reg-scratch-vreg-slots
  [_type-segment-bases : i64]
  [_abi : cabi.CompilerRegTargetAbi]
  [_assignments : CompilerRegAssignmentTable]
  [_types : CompilerRegVarTypes]
  [_instr : ir.CompilerIrInstr]
  [_phi-targets : CompilerRegLabelSeq]
  [_phi-xmm-targets : CompilerRegLabelSeq]
  [_binop-return : bool]) : i64
  (cfg
    scratch-vreg
    (match _instr
      ;; Fixed-width ordinals keep the map independent of assignment failure.
      [(ir.CompilerIrInstr.Call _ name _ _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-c-memory-call-name? name))
          2
          1)]
      [(ir.CompilerIrInstr.CallIndirect _ _ args _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-call-args-have-private-memory?
            _type-segment-bases
            _types
            args))
          3
          2)]
      [(ir.CompilerIrInstr.CallIndirectC _ _ args _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-call-args-have-c-memory-marker? args))
          3
          2)]
      [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
        (let
          [name (__tl-project-field (__tl-box-place payload-box) name)]
          (if (and
            (compiler-reg-linux-abi? _abi)
            (compiler-reg-c-memory-call-name? name))
            3
            2))]
      [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
        (let
          [args (__tl-project-field (__tl-box-place payload-box) args)]
          (if (and
            (compiler-reg-linux-abi? _abi)
            (compiler-reg-call-args-have-c-memory-marker? args))
            3
            2))]
      [(ir.CompilerIrInstr.TailCall name _ _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-c-memory-call-name? name))
          2
          1)]
      [(ir.CompilerIrInstr.TailCallIndirect _ args _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-call-args-have-private-memory?
            _type-segment-bases
            _types
            args))
          3
          2)]
      [(ir.CompilerIrInstr.Pack _ _ _) 2]
      [(ir.CompilerIrInstr.Word _ _ _ _) 1]
      [(ir.CompilerIrInstr.Jump target)
        (if (compiler-reg-label-seq-contains? _phi-targets target)
          (if (compiler-reg-label-seq-contains? _phi-xmm-targets target)
            3
            2)
          0)]
      [(ir.CompilerIrInstr.Branch condition true-label false-label)
        (if (or
          (compiler-reg-label-seq-contains? _phi-targets true-label)
          (compiler-reg-label-seq-contains? _phi-targets false-label))
          (if (or
            (compiler-reg-label-seq-contains? _phi-xmm-targets true-label)
            (compiler-reg-label-seq-contains? _phi-xmm-targets false-label))
            4
            3)
          (if (compiler-reg-scratch-value-direct? _assignments condition)
            0
            1))]
      [(ir.CompilerIrInstr.TotalEnumBranch condition true-label false-label)
        (compiler-reg-scratch-vreg-slots
          _type-segment-bases
          _abi
          _assignments
          _types
          (ir.CompilerIrInstr.Branch condition true-label false-label)
          _phi-targets
          _phi-xmm-targets
          _binop-return)]
      [(ir.CompilerIrInstr.Select payload-box)
        (let
          [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
          (if (= lanes 0)
            3
            0))]
      ;; Division has two explicit fixed operands plus three simultaneously
      ;; live GP temporaries. Variable shifts have a fixed %rcx count plus one
      ;; result temporary. Other scalar binops reserve only the staging home
      ;; their selected shape consumes; notably, a Var RHS immediately returned
      ;; through %rax gets one context-aware home instead of taxing every ALU.
      [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
        (if (compiler-reg-scratch-float-binop? _types lhs rhs ty)
          (if (compiler-reg-scratch-compare-op? op)
            (compiler-reg-scratch-float-compare-slot-count
              _assignments
              dst
              lhs
              rhs
              _binop-return)
            (compiler-reg-scratch-float-arithmetic-slot-count
              _assignments
              dst
              rhs
              _binop-return))
          (if (compiler-reg-clobber-binop-div? op)
            5
            (if (compiler-reg-clobber-binop-shift? op rhs ty)
              2
              (if (ir.compiler-ir-binop-compare? op)
                ;; Fused comparisons keep two distinct operand homes live
                ;; through the following Branch.
                (if (or
                  (compiler-reg-scratch-value-direct? _assignments lhs)
                  (compiler-reg-scratch-value-direct? _assignments rhs))
                  0
                  2)
                (match op
                  ;; Constant shifts accumulate directly in a register-homed
                  ;; destination; a spill needs one result staging home.
                  [(ir.CompilerIrBinOp.Shl _)
                    (if (compiler-reg-scratch-var-register-homed?
                      _assignments
                      dst)
                      0
                      1)]
                  [(ir.CompilerIrBinOp.Shr _)
                    (if (compiler-reg-scratch-var-register-homed?
                      _assignments
                      dst)
                      0
                      1)]
                  [_
                    (if _binop-return
                      (match rhs
                        [(ir.CompilerIrValue.Var _) 1]
                        [_ 0])
                      (match rhs
                        [(ir.CompilerIrValue.Var _)
                          (if (compiler-reg-scratch-var-register-homed?
                            _assignments
                            dst)
                            (if (compiler-reg-scratch-value-same-home?
                              _assignments
                              dst
                              rhs)
                              (if (and
                                (compiler-reg-scratch-value-direct?
                                  _assignments
                                  lhs)
                                (match op
                                  [(ir.CompilerIrBinOp.Add) true]
                                  [(ir.CompilerIrBinOp.And) true]
                                  [(ir.CompilerIrBinOp.Or) true]
                                  [(ir.CompilerIrBinOp.BitAnd) true]
                                  [(ir.CompilerIrBinOp.BitOr) true]
                                  [(ir.CompilerIrBinOp.BitXor) true]
                                  [_ false]))
                                0
                                1)
                              0)
                            0)]
                        [_ 0]))])))))]
      [(ir.CompilerIrInstr.UnOp dst _ _ _)
        (if (compiler-reg-scratch-var-register-homed? _assignments dst)
          0
          1)]
      [(ir.CompilerIrInstr.CpuId _ _ _ _) 1]
      [(ir.CompilerIrInstr.Switch _ _ _ _) 2]
      [(ir.CompilerIrInstr.TotalEnumSwitch index base cases default-label _)
        (compiler-reg-scratch-vreg-slots
          _type-segment-bases
          _abi
          _assignments
          _types
          (ir.CompilerIrInstr.Switch index base cases default-label)
          _phi-targets
          _phi-xmm-targets
          _binop-return)]
      [(ir.CompilerIrInstr.BoundsCheck _ _ _) 2]
      ;; Ordered selector validation keeps active-lanes and the current selector
      ;; in independent GP temporaries.
      [(ir.CompilerIrInstr.VectorShuffle _) 2]
      [(ir.CompilerIrInstr.AddrOf dst _)
        (if (compiler-reg-scratch-var-register-homed? _assignments dst)
          0
          1)]
      [(ir.CompilerIrInstr.Gep dst base offset _)
        (if (and
          (compiler-reg-scratch-var-register-homed? _assignments dst)
          (compiler-reg-scratch-value-direct? _assignments base)
          (compiler-reg-scratch-value-integer-immediate? offset))
          0
          2)]
      [(ir.CompilerIrInstr.Load dst src ty)
        (let
          [address? : bool
            (not (compiler-reg-scratch-value-direct? _assignments src))]
          [value? : bool
            (and
              (compiler-reg-scalar-type? ty)
              (not (compiler-reg-scratch-var-register-homed? _assignments dst)))]
          (if value?
            2
            (if address?
              1
              0)))]
      [(ir.CompilerIrInstr.StorePtr dst src ty)
        (let
          [address? : bool
            (not (compiler-reg-scratch-value-direct? _assignments dst))]
          [value? : bool
            (and
              (compiler-reg-scalar-type? ty)
              (not (compiler-reg-scratch-value-direct? _assignments src)))]
          (if value?
            2
            (if address?
              1
              0)))]
      [(ir.CompilerIrInstr.CopyBytes _ _ size)
        (if (<= size 0)
          0
          (if (>= size 16)
            (if (= (% size 16) 0)
              3
              4)
            3))]
      [(ir.CompilerIrInstr.Store _ value ty)
        (if (and
          (compiler-reg-scalar-type? ty)
          (not (compiler-reg-scratch-value-direct? _assignments value)))
          1
          0)]
      [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
        (compiler-reg-scratch-cast-slot-count
          _type-segment-bases
          _assignments
          dst
          src
          from-ty
          to-ty)]
      [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
        (compiler-reg-scratch-bitcast-slot-count
          _assignments
          dst
          src
          from-ty
          to-ty)]
      [(ir.CompilerIrInstr.Mov dst src ty)
        (if (and
          (compiler-reg-float-type? ty)
          (not (compiler-reg-scratch-value-same-home? _assignments dst src))
          (not (compiler-reg-scratch-var-register-homed? _assignments dst)))
          1
          0)]
      ;; A non-memory splat stages integer lanes through GP+XMM and float lanes
      ;; through XMM. Keep the two fixed ordinals so emission lookup remains
      ;; stable regardless of the source home and selected element type.
      [(ir.CompilerIrInstr.Splat _ _ _ _) 2]
      ;; Every SIMD indexed address needs a stable base slot. Dynamic indices
      ;; additionally need an independent GP slot; integer immediates fold into
      ;; the addressing displacement and must not reserve that second ordinal.
      [(ir.CompilerIrInstr.VectorLoad _ _ index _ _)
        (if (compiler-reg-scratch-value-integer-immediate? index)
          1
          2)]
      [(ir.CompilerIrInstr.VectorStore payload-box)
        (let
          [index (__tl-project-field (__tl-box-place payload-box) index)]
          (if (compiler-reg-scratch-value-integer-immediate? index)
            1
            2))]
      [(ir.CompilerIrInstr.PredicatedStore payload-box)
        (let
          [index (__tl-project-field (__tl-box-place payload-box) index)]
          (if (compiler-reg-scratch-value-integer-immediate? index)
            1
            2))]
      [(ir.CompilerIrInstr.PredicatedLoad payload-box)
        (let
          [index (__tl-project-field (__tl-box-place payload-box) index)]
          (if (compiler-reg-scratch-value-integer-immediate? index)
            1
            2))]
      [(ir.CompilerIrInstr.GatherLoad payload-box)
        (let
          [index (__tl-project-field (__tl-box-place payload-box) index)]
          [lane-offset
            (__tl-project-field (__tl-box-place payload-box) lane-offset)]
          (if (or
            lane-offset
            (compiler-reg-scratch-value-integer-immediate? index))
            1
            2))]
      ;; The dynamic AVX-512 tail-mask expansion holds a fixed %rcx shift
      ;; count, an index copy, and the constructed mask bits simultaneously.
      ;; A fully immediate mask uses the separate constant fast path.
      [(ir.CompilerIrInstr.TailMask _ index length _)
        (if (and
          (compiler-reg-scratch-value-integer-immediate? index)
          (compiler-reg-scratch-value-integer-immediate? length))
          0
          3)]
      ;; Numeric and AVX2-bool prefixes need a carry/materialization slot, a
      ;; destination staging slot, and two simultaneous XMM work registers.
      ;; AVX-512 bool prefixes operate in the mask/GP banks and need only their
      ;; carry and prefix-bit GP slots.
      [(ir.CompilerIrInstr.VectorPrefix payload-box)
        (let
          [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
          [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
          (match elem-ty
            [(ast.AstType.Bool)
              (if (> lanes 32)
                2
                4)]
            [_ 4]))]
      [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) 2]
      [_ 0])
    0))

(define (compiler-reg-scratch-vreg-count-seq
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentTable]
  [types : CompilerRegVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-targets : CompilerRegLabelSeq]
  [phi-xmm-targets : CompilerRegLabelSeq]
  [count : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 instrs.len]
    [i : i64 0]
    [out : i64 count]
    (begin
      (while (< i len)
        (begin
          (set!
            out
            (+
              out
              (compiler-reg-scratch-vreg-slots
                type-segment-bases
                target-abi
                assignments
                types
                (array-ref slots i)
                phi-targets
                phi-xmm-targets
                (compiler-reg-scratch-binop-return-next? instrs i))))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-scratch-vreg-count-blocks
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentTable]
  [types : CompilerRegVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [phi-targets : CompilerRegLabelSeq]
  [phi-xmm-targets : CompilerRegLabelSeq]
  [count : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) count]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-scratch-vreg-count-blocks
            type-segment-bases
            target-abi
            assignments
            types
            (__tl-box-place rest)
            phi-targets
            phi-xmm-targets
            (compiler-reg-scratch-vreg-count-seq
              type-segment-bases
              target-abi
              assignments
              types
              instrs
              phi-targets
              phi-xmm-targets
              count))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [block-count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : i64 count]
        (begin
          (while (< i block-count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-scratch-vreg-count-seq
                      type-segment-bases
                      target-abi
                      assignments
                      types
                      instrs
                      phi-targets
                      phi-xmm-targets
                      out))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-scratch-vreg-instr-count-blocks
  [blocks : ir.CompilerIrBlockList]
  [count : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) count]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-scratch-vreg-instr-count-blocks
            (__tl-box-place rest)
            (+ count instrs.len))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [block-count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : i64 count]
        (begin
          (while (< i block-count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! out (+ out instrs.len))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-copy-i64-array!
  [dst : (__tl_dyn-array i64)]
  [src : (__tl_dyn-array i64)]
  [i : i64]) : unit
  (if (>= i (array-length src))
    unit
    (begin
      (if (< i (array-length dst))
        (set! (array-ref dst i) (array-ref src i))
        unit)
      (compiler-reg-copy-i64-array! dst src (+ i 1)))))

(define (compiler-reg-copy-ast-type-array!
  [dst : (__tl_dyn-array ast.AstType)]
  [src : (__tl_dyn-array ast.AstType)]
  [i : i64]) : unit
  (if (>= i (array-length src))
    unit
    (begin
      (if (< i (array-length dst))
        (set! (array-ref dst i) (array-ref src i))
        unit)
      (compiler-reg-copy-ast-type-array! dst src (+ i 1)))))

(define (compiler-reg-copy-interval-seq-array!
  [dst : (__tl_dyn-array CompilerRegIntervalSeq)]
  [src : (__tl_dyn-array CompilerRegIntervalSeq)]
  [i : i64]) : unit
  (if (>= i (array-length src))
    unit
    (begin
      (if (< i (array-length dst))
        (set! (array-ref dst i) (array-ref src i))
        unit)
      (compiler-reg-copy-interval-seq-array! dst src (+ i 1)))))

(define (compiler-reg-fill-interval-seq-array!
  [items : (__tl_dyn-array CompilerRegIntervalSeq)]
  [i : i64]) : unit
  (if (>= i (array-length items))
    unit
    (begin
      (set! (array-ref items i) (compiler-reg-interval-seq-empty))
      (compiler-reg-fill-interval-seq-array! items (+ i 1)))))

;; Same shape as the interval-seq filler above: a small recursive helper that
;; gives every slot its own empty value.
;;
;; This MUST stay a separate function. Writing the identical loop inline in
;; compiler-reg-greedy-occupancy-make miscompiles on linux-x86_64 (the built
;; compiler aborts with "tl: allocation failed" on any opt2 compile, while the
;; windows-x86_64 build of the same source is fine); hoisting the fill here
;; makes both targets correct. Reduced repro and evidence: an
;; occupancy-make-local `while` filling a `(__tl_dyn-array T)` whose element
;; type is a struct holding a dynamic array, versus the same fill in a helper.
(define (compiler-reg-fill-live-union-array!
  [items : (__tl_dyn-array CompilerRegLiveUnion)]
  [i : i64]) : unit
  (if (>= i (array-length items))
    unit
    (begin
      (set! (array-ref items i) (compiler-reg-live-union-empty))
      (compiler-reg-fill-live-union-array! items (+ i 1)))))

;; Generic constrained scratch-plan construction.  These builders attach the
;; deterministic instruction/ordinal identity, interval, and physical-home policy.
(defenum CompilerRegScratchFillState
  (State i64 i64))

(defstruct CompilerRegScratchPolicy
  (call-allowed CompilerRegIdSeq)
  (tail-call-allowed CompilerRegIdSeq)
  (gp-allowed CompilerRegIdSeq)
  (phi-excluded CompilerRegIdSeq))

(define (compiler-reg-scratch-call-target-excluded) : CompilerRegIdSeq
  (compiler-reg-id-seq-prepend
    cabi.compiler-reg-id-rax
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-rcx
      (compiler-reg-id-seq-prepend
        cabi.compiler-reg-id-rdx
        (compiler-reg-id-seq-prepend
          cabi.compiler-reg-id-r8
          (compiler-reg-id-seq-prepend
            cabi.compiler-reg-id-r9
            (compiler-reg-id-seq-prepend
              cabi.compiler-reg-id-rdi
              (compiler-reg-id-seq-prepend
                cabi.compiler-reg-id-rsi
                (compiler-reg-id-seq-prepend
                  cabi.compiler-reg-id-r11
                  (compiler-reg-id-seq-empty))))))))))

(define (compiler-reg-scratch-used-registers
  [assignments : CompilerRegAssignmentTable]
  [regs : CompilerRegIdSeq]) : CompilerRegIdSeq
  (let
    [index : i64 0]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity (compiler-reg-id-seq-count regs))]
    (begin
      (while (< index (compiler-reg-id-seq-count regs))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (begin
            (if (compiler-reg-assignments-use-register? assignments reg)
              (set! out (compiler-reg-id-seq-push out reg))
              unit)
            (set! index (+ index 1)))))
      out)))

(define (compiler-reg-scratch-call-target-allowed
  [target-abi : cabi.CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentTable]
  [tail? : bool]) : CompilerRegIdSeq
  ;; %r10 is the legacy preferred target scratch.  A non-tail call may also use
  ;; a callee-saved register already present in the function plan (and therefore
  ;; already preserved by the prologue); never introduce a save solely for a
  ;; scratch slot.  Tail jumps restore those homes before jumping, so they are
  ;; restricted to %r10.
  (compiler-reg-id-seq-prepend
    cabi.compiler-reg-id-r10
    (if tail?
      (compiler-reg-id-seq-empty)
      (compiler-reg-scratch-used-registers
        assignments
        (compiler-reg-callee-saved-integer-registers-for-abi target-abi)))))

(define (compiler-reg-scratch-policy
  [target-abi : cabi.CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentTable]
  [phi-excluded : CompilerRegIdSeq]) : CompilerRegScratchPolicy
  (CompilerRegScratchPolicy
    (compiler-reg-scratch-call-target-allowed target-abi assignments false)
    (compiler-reg-scratch-call-target-allowed target-abi assignments true)
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-r8
      (compiler-reg-id-seq-prepend
        cabi.compiler-reg-id-r9
        (compiler-reg-id-seq-prepend
          cabi.compiler-reg-id-r10
          (compiler-reg-id-seq-prepend
            cabi.compiler-reg-id-r11
            (compiler-reg-scratch-used-registers
              assignments
              (compiler-reg-callee-saved-integer-registers-for-abi target-abi))))))
    phi-excluded))

(define (compiler-reg-scratch-call-target-constraint
  [allowed : CompilerRegIdSeq]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    allowed
    (compiler-reg-scratch-call-target-excluded)
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-gp-constraint-excluding
  [excluded : CompilerRegIdSeq]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    (compiler-reg-id-seq-empty)
    excluded
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-call-stage-constraint
  [policy : CompilerRegScratchPolicy]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    policy.call-allowed
    (compiler-reg-scratch-call-target-excluded)
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-location-registers
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : CompilerRegIdSeq
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register reg)
          (compiler-reg-id-seq-prepend reg (compiler-reg-id-seq-empty))]
        [(CompilerRegLocation.RegisterPair lo hi)
          (compiler-reg-id-seq-prepend
            lo
            (compiler-reg-id-seq-prepend hi (compiler-reg-id-seq-empty)))]
        [_ (compiler-reg-id-seq-empty)])]
    [(CompilerRegMaybeLocation.No) (compiler-reg-id-seq-empty)]))

(define (compiler-reg-scratch-value-registers
  [assignments : CompilerRegAssignmentTable]
  [value : ir.CompilerIrValue]) : CompilerRegIdSeq
  (match value
    [(ir.CompilerIrValue.Var var)
      (compiler-reg-scratch-location-registers assignments var)]
    [_ (compiler-reg-id-seq-empty)]))

(define (compiler-reg-scratch-instr-registers
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]) : CompilerRegIdSeq
  (match instr
    [(ir.CompilerIrInstr.AddrOf dst src)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-location-registers assignments src))]
    [(ir.CompilerIrInstr.Gep dst base offset _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-scratch-value-registers assignments offset)))]
    [(ir.CompilerIrInstr.Load dst src _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.StorePtr dst src _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-value-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.CopyBytes dst src _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-value-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.Pack dst words _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-pack-registers assignments words))]
    [(ir.CompilerIrInstr.Word dst src _ _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-value-registers assignments index)
        (compiler-reg-scratch-value-registers assignments length))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments source)
            (compiler-reg-id-seq-append
              (compiler-reg-scratch-value-registers assignments selector-low)
              (compiler-reg-id-seq-append
                (match selector-high
                  [(ir.CompilerIrMaybeValue.Some value)
                    (compiler-reg-scratch-value-registers assignments value)]
                  [(ir.CompilerIrMaybeValue.No) (compiler-reg-id-seq-empty)])
                (compiler-reg-scratch-value-registers assignments active-lanes))))))]
    [(ir.CompilerIrInstr.BinOp dst _ lhs rhs _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments lhs)
          (compiler-reg-scratch-value-registers assignments rhs)))]
    [(ir.CompilerIrInstr.UnOp dst _ src _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.Branch cond _ _)
      (compiler-reg-scratch-value-registers assignments cond)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond _ _)
      (compiler-reg-scratch-value-registers assignments cond)]
    [(ir.CompilerIrInstr.CpuId dst leaf subleaf _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments leaf)
          (compiler-reg-scratch-value-registers assignments subleaf)))]
    [(ir.CompilerIrInstr.Switch index _ _ _)
      (compiler-reg-scratch-value-registers assignments index)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (compiler-reg-scratch-value-registers assignments index)]
    [(ir.CompilerIrInstr.Store _ value _)
      (compiler-reg-scratch-value-registers assignments value)]
    [(ir.CompilerIrInstr.Cast dst src _ _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.Bitcast dst src _ _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.Mov dst src _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.Splat dst value _ _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments value))]
    [(ir.CompilerIrInstr.VectorLoad dst base index _ _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-scratch-value-registers assignments index)))]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments index)
            (compiler-reg-scratch-value-registers assignments value))))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments index)
            (compiler-reg-id-seq-append
              (compiler-reg-scratch-value-registers assignments value)
              (compiler-reg-scratch-value-registers assignments mask)))))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments base)
            (compiler-reg-id-seq-append
              (compiler-reg-scratch-value-registers assignments index)
              (compiler-reg-scratch-value-registers assignments mask)))))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments base)
            (compiler-reg-id-seq-append
              (compiler-reg-scratch-value-registers assignments index-base)
              (compiler-reg-scratch-value-registers assignments index)))))]
    [(ir.CompilerIrInstr.TailMask dst index length _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-value-registers assignments index)
          (compiler-reg-scratch-value-registers assignments length)))]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments lhs)
            (compiler-reg-scratch-value-registers assignments rhs))))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments src)
            (compiler-reg-scratch-value-registers assignments carry))))]
    [(ir.CompilerIrInstr.VectorReduce dst _ src _ _)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (compiler-reg-id-seq-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-seq-append
            (compiler-reg-scratch-value-registers assignments mask)
            (compiler-reg-id-seq-append
              (compiler-reg-scratch-value-registers assignments on-true)
              (compiler-reg-scratch-value-registers assignments on-false)))))]
    [_ (compiler-reg-id-seq-empty)]))

(define (compiler-reg-scratch-memory-constraint
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]) : CompilerRegScratchConstraint
  (compiler-reg-scratch-gp-constraint-excluding
    (compiler-reg-scratch-instr-registers assignments instr)))

(define (compiler-reg-scratch-xmm-constraint
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Xmm)
    (compiler-reg-id-seq-empty)
    (compiler-reg-scratch-instr-registers assignments instr)
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-aggregate-constraint
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]
  [sse? : bool]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (if sse?
      (CompilerRegScratchClass.Xmm)
      (CompilerRegScratchClass.Gp))
    (if sse?
      (compiler-reg-id-seq-empty)
      policy.gp-allowed)
    (compiler-reg-scratch-instr-registers assignments instr)
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-pack-registers
  [assignments : CompilerRegAssignmentTable]
  [words : ir.CompilerIrValueList]) : CompilerRegIdSeq
  (match words
    [(ir.CompilerIrValueList.Nil) (compiler-reg-id-seq-empty)]
    [(ir.CompilerIrValueList.Cons word rest)
      (compiler-reg-id-seq-append
        (compiler-reg-scratch-value-registers assignments word)
        (compiler-reg-scratch-pack-registers assignments (__tl-box-place rest)))]
    [(ir.CompilerIrValueList.Array seq)
      (compiler-reg-scratch-pack-registers
        assignments
        (ir.compiler-ir-value-seq-to-list seq))]))

(define (compiler-reg-scratch-phi-constraint
  [policy : CompilerRegScratchPolicy]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    policy.gp-allowed
    policy.phi-excluded
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-phi-xmm-constraint
  [policy : CompilerRegScratchPolicy]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Xmm)
    (compiler-reg-id-seq-empty)
    policy.phi-excluded
    cabi.compiler-reg-id-invalid))

(define (compiler-reg-scratch-switch-constraint
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]) : CompilerRegScratchConstraint
  (compiler-reg-scratch-gp-constraint-excluding
    (compiler-reg-id-seq-append
      policy.phi-excluded
      (compiler-reg-scratch-instr-registers assignments instr))))

(define (compiler-reg-scratch-fixed-constraint
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]
  [reg : i64]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    (compiler-reg-id-seq-empty)
    (compiler-reg-scratch-instr-registers assignments instr)
    reg))

(define (compiler-reg-scratch-fixed-xmm-constraint
  [_assignments : CompilerRegAssignmentTable]
  [_instr : ir.CompilerIrInstr]
  [reg : i64]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Xmm)
    (compiler-reg-id-seq-empty)
    (compiler-reg-id-seq-empty)
    reg))

(define (compiler-reg-scratch-scalar-constraint
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]
  [extra : CompilerRegIdSeq]) : CompilerRegScratchConstraint
  (compiler-reg-scratch-gp-constraint-excluding
    (compiler-reg-id-seq-append
      extra
      (compiler-reg-scratch-instr-registers assignments instr))))

(define (compiler-reg-scratch-div-fixed-registers) : CompilerRegIdSeq
  (compiler-reg-id-seq-prepend
    cabi.compiler-reg-id-rax
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-rdx
      (compiler-reg-id-seq-empty))))

(define (compiler-reg-scratch-cpuid-fixed-registers) : CompilerRegIdSeq
  (compiler-reg-id-seq-prepend
    cabi.compiler-reg-id-rax
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-rbx
      (compiler-reg-id-seq-prepend
        cabi.compiler-reg-id-rcx
        (compiler-reg-id-seq-prepend
          cabi.compiler-reg-id-rdx
          (compiler-reg-id-seq-empty))))))

;; Phi copies execute on predecessor edges, before the merge block's phi
;; destinations become live.  Exclude every phi destination home in the
;; function from both edge scratch slots; source homes already interfere at the
;; predecessor terminator point.  The function-wide union is conservative but
;; also covers fused terminators without rebuilding edge-specific liveness.
(define (compiler-reg-scratch-phi-dst-registers-instr
  [assignments : CompilerRegAssignmentTable]
  [instr : ir.CompilerIrInstr]) : CompilerRegIdSeq
  (match instr
    [(ir.CompilerIrInstr.Phi dst _ _)
      (compiler-reg-scratch-location-registers assignments dst)]
    [_ (compiler-reg-id-seq-empty)]))

(define (compiler-reg-scratch-seq-starts-with-phi?
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (if (= (ir.compiler-ir-instr-seq-count instrs) 0)
    false
    (match (ir.compiler-ir-instr-seq-ref instrs 0)
      [(ir.CompilerIrInstr.Phi _ _ _) true]
      [_ false])))

(define (compiler-reg-scratch-phi-targets-block-seq-from
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : CompilerRegLabelSeq
  (let
    [at : i64 index]
    [out : CompilerRegLabelSeq
      (compiler-reg-label-seq-with-capacity
        (if (< index (ir.compiler-ir-block-seq-count blocks))
          (- (ir.compiler-ir-block-seq-count blocks) index)
          0))]
    (begin
      (while (< at (ir.compiler-ir-block-seq-count blocks))
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks at)
            [(ir.CompilerIrBlock.Block label instrs)
              (if (compiler-reg-scratch-seq-starts-with-phi? instrs)
                (set! out (compiler-reg-label-seq-push out label))
                unit)])
          (set! at (+ at 1))))
      out)))

(define (compiler-reg-scratch-phi-targets-blocks
  [blocks : ir.CompilerIrBlockList]) : CompilerRegLabelSeq
  (compiler-reg-scratch-phi-targets-block-seq-from
    (live.compiler-live-ir-block-list-to-seq blocks)
    0))

(define (compiler-reg-scratch-seq-has-float-phi-from?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ ty)
        (or
          (compiler-reg-float-type? ty)
          (compiler-reg-scratch-seq-has-float-phi-from? instrs (+ index 1)))]
      [_ false])))

(define (compiler-reg-scratch-phi-xmm-targets-block-seq-from
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : CompilerRegLabelSeq
  (let
    [at : i64 index]
    [out : CompilerRegLabelSeq
      (compiler-reg-label-seq-with-capacity
        (if (< index (ir.compiler-ir-block-seq-count blocks))
          (- (ir.compiler-ir-block-seq-count blocks) index)
          0))]
    (begin
      (while (< at (ir.compiler-ir-block-seq-count blocks))
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks at)
            [(ir.CompilerIrBlock.Block label instrs)
              (if (compiler-reg-scratch-seq-has-float-phi-from? instrs 0)
                (set! out (compiler-reg-label-seq-push out label))
                unit)])
          (set! at (+ at 1))))
      out)))

(define (compiler-reg-scratch-phi-xmm-targets-blocks
  [blocks : ir.CompilerIrBlockList]) : CompilerRegLabelSeq
  (compiler-reg-scratch-phi-xmm-targets-block-seq-from
    (live.compiler-live-ir-block-list-to-seq blocks)
    0))

(define (compiler-reg-scratch-phi-dst-registers-seq-from
  [assignments : CompilerRegAssignmentTable]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : CompilerRegIdSeq
  (let
    [at : i64 index]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< index (ir.compiler-ir-instr-seq-count instrs))
          (* 2 (- (ir.compiler-ir-instr-seq-count instrs) index))
          0))]
    (begin
      (while (< at (ir.compiler-ir-instr-seq-count instrs))
        (begin
          (set!
            out
            (compiler-reg-id-seq-push-all
              out
              (compiler-reg-scratch-phi-dst-registers-instr
                assignments
                (ir.compiler-ir-instr-seq-ref instrs at))))
          (set! at (+ at 1))))
      out)))

(define (compiler-reg-scratch-phi-dst-registers-block-seq-from
  [assignments : CompilerRegAssignmentTable]
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : CompilerRegIdSeq
  (let
    [at : i64 index]
    [out : CompilerRegIdSeq (compiler-reg-id-seq-empty)]
    (begin
      (while (< at (ir.compiler-ir-block-seq-count blocks))
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks at)
            [(ir.CompilerIrBlock.Block _ instrs)
              (set!
                out
                (compiler-reg-id-seq-push-all
                  out
                  (compiler-reg-scratch-phi-dst-registers-seq-from
                    assignments
                    instrs
                    0)))])
          (set! at (+ at 1))))
      out)))

(define (compiler-reg-scratch-phi-dst-registers-blocks
  [assignments : CompilerRegAssignmentTable]
  [blocks : ir.CompilerIrBlockList]) : CompilerRegIdSeq
  (compiler-reg-scratch-phi-dst-registers-block-seq-from
    assignments
    (live.compiler-live-ir-block-list-to-seq blocks)
    0))

(define (compiler-reg-scratch-requirement-local
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [instr : ir.CompilerIrInstr]
  [point : i64]
  [ordinal : i64]
  [var : i64]
  [binop-return : bool]) : CompilerRegScratchRequirement
  (match instr
    [(ir.CompilerIrInstr.Call _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.CallStage)
          (CompilerRegScratchRole.CallMemoryXmm))
        (if (= ordinal 0)
          (compiler-reg-scratch-call-stage-constraint policy)
          (compiler-reg-scratch-xmm-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.CallTarget)
          (CompilerRegScratchRole.CallStage))
        (if (= ordinal 0)
          (compiler-reg-scratch-call-target-constraint policy.call-allowed)
          (compiler-reg-scratch-call-stage-constraint policy))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CallTarget)]
          [(= ordinal 1) (CompilerRegScratchRole.CallStage)]
          [else (CompilerRegScratchRole.CallMemoryXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-call-target-constraint policy.call-allowed)]
          [(= ordinal 1) (compiler-reg-scratch-call-stage-constraint policy)]
          [else (compiler-reg-scratch-xmm-constraint assignments instr)])
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CallTarget)]
          [(= ordinal 1) (CompilerRegScratchRole.CallStage)]
          [else (CompilerRegScratchRole.CallMemoryXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-call-target-constraint policy.call-allowed)]
          [(= ordinal 1) (compiler-reg-scratch-call-stage-constraint policy)]
          [else (compiler-reg-scratch-xmm-constraint assignments instr)])
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CallTarget)]
          [(= ordinal 1) (CompilerRegScratchRole.CallStage)]
          [else (CompilerRegScratchRole.CallMemoryXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-call-target-constraint policy.call-allowed)]
          [(= ordinal 1) (compiler-reg-scratch-call-stage-constraint policy)]
          [else (compiler-reg-scratch-xmm-constraint assignments instr)])
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.CallTarget)
          (CompilerRegScratchRole.CallStage))
        (if (= ordinal 0)
          (compiler-reg-scratch-call-target-constraint policy.tail-call-allowed)
          (compiler-reg-scratch-call-stage-constraint policy))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.TailCall _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.CallStage)
        (compiler-reg-scratch-call-stage-constraint policy)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Pack _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.AggregateWord)
        (compiler-reg-scratch-aggregate-constraint
          policy
          assignments
          instr
          (compiler-reg-type-register-group-word-sse?
            type-segment-bases
            ty
            ordinal))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Word _ _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.AggregateWord)
        (compiler-reg-scratch-aggregate-constraint
          policy
          assignments
          instr
          (compiler-reg-float-type? ty))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Jump _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.PhiCycle)]
          [(= ordinal 1) (CompilerRegScratchRole.PhiStage)]
          [else (CompilerRegScratchRole.PhiCycleXmm)])
        (if (= ordinal 2)
          (compiler-reg-scratch-phi-xmm-constraint policy)
          (compiler-reg-scratch-phi-constraint policy))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (compiler-reg-scratch-float-binop? var-types lhs rhs ty)
        (let
          [compare? : bool (compiler-reg-scratch-compare-op? op)]
          [fallback? : bool
            (and
              compare?
              (compiler-reg-scratch-float-compare-fallback? assignments lhs rhs))]
          [rhs-temp? : bool
            (and
              fallback?
              (not
                (compiler-reg-scratch-float-rhs-direct?
                  assignments
                  rhs
                  cabi.compiler-reg-id-invalid)))]
          [role : CompilerRegScratchRole
            (cond
              [(and binop-return compare? (= ordinal 0))
                (CompilerRegScratchRole.FloatReturnResultGp)]
              [(and binop-return compare? (= ordinal 1))
                (CompilerRegScratchRole.FloatCompareLhsXmm)]
              [(and binop-return compare?)
                (CompilerRegScratchRole.FloatCompareRhsXmm)]
              [(and binop-return (= ordinal 0))
                (CompilerRegScratchRole.FloatReturnResultXmm)]
              [binop-return (CompilerRegScratchRole.FloatArithmeticRhsXmm)]
              [(and compare? fallback? (= ordinal 0))
                (CompilerRegScratchRole.FloatCompareLhsXmm)]
              [(and compare? rhs-temp? (= ordinal 1))
                (CompilerRegScratchRole.FloatCompareRhsXmm)]
              [compare? (CompilerRegScratchRole.FloatCompareResultGp)]
              [(= ordinal 0) (CompilerRegScratchRole.FloatArithmeticResultXmm)]
              [else (CompilerRegScratchRole.FloatArithmeticRhsXmm)])]
          [constraint : CompilerRegScratchConstraint
            (match role
              [(CompilerRegScratchRole.FloatReturnResultGp)
                (CompilerRegScratchConstraint
                  (CompilerRegScratchClass.Gp)
                  (compiler-reg-id-seq-empty)
                  (compiler-reg-id-seq-empty)
                  cabi.compiler-reg-id-rax)]
              [(CompilerRegScratchRole.FloatReturnResultXmm)
                (compiler-reg-scratch-fixed-xmm-constraint
                  assignments
                  instr
                  (cabi.compiler-abi-xmm-register-id 0))]
              [(CompilerRegScratchRole.FloatCompareResultGp)
                (compiler-reg-scratch-scalar-constraint
                  assignments
                  instr
                  (compiler-reg-id-seq-empty))]
              [_ (compiler-reg-scratch-xmm-constraint assignments instr)])]
          (CompilerRegScratchRequirement
            point
            ordinal
            role
            constraint
            point
            (+ point 1)
            var))
        (let
          [div? : bool (compiler-reg-clobber-binop-div? op)]
          [shift? : bool
            (match instr
              [(ir.CompilerIrInstr.BinOp _ shift-op _ rhs ty)
                (compiler-reg-clobber-binop-shift? shift-op rhs ty)]
              [_ false])]
          [role : CompilerRegScratchRole
            (cond
              [div?
                (cond
                  [(= ordinal 0) (CompilerRegScratchRole.FixedRax)]
                  [(= ordinal 1) (CompilerRegScratchRole.FixedRdx)]
                  [(= ordinal 2) (CompilerRegScratchRole.ScalarPrimary)]
                  [(= ordinal 3) (CompilerRegScratchRole.ScalarSecondary)]
                  [else (CompilerRegScratchRole.ScalarTertiary)])]
              [(and shift? (= ordinal 0)) (CompilerRegScratchRole.FixedRcx)]
              [(= ordinal 0) (CompilerRegScratchRole.ScalarPrimary)]
              [else (CompilerRegScratchRole.ScalarSecondary)])]
          [constraint : CompilerRegScratchConstraint
            (cond
              [(and div? (= ordinal 0))
                (compiler-reg-scratch-fixed-constraint
                  assignments
                  instr
                  cabi.compiler-reg-id-rax)]
              [(and div? (= ordinal 1))
                (compiler-reg-scratch-fixed-constraint
                  assignments
                  instr
                  cabi.compiler-reg-id-rdx)]
              [(and shift? (= ordinal 0))
                (compiler-reg-scratch-fixed-constraint
                  assignments
                  instr
                  cabi.compiler-reg-id-rcx)]
              [else
                (compiler-reg-scratch-scalar-constraint
                  assignments
                  instr
                  (cond
                    [div? (compiler-reg-scratch-div-fixed-registers)]
                    [shift?
                      (compiler-reg-id-seq-prepend
                        cabi.compiler-reg-id-rcx
                        (compiler-reg-id-seq-empty))]
                    [else (compiler-reg-id-seq-empty)]))])]
          (CompilerRegScratchRequirement
            point
            ordinal
            role
            constraint
            point
            ;; A compare can fuse through the following Branch. Its operand
            ;; homes end at this IR point, so keep the planned homes live through
            ;; that successor point and explicitly exclude those operands above.
            (if (compiler-reg-clobber-binop-div? op)
              (+ point 1)
              (if (ir.compiler-ir-binop-compare? op)
                (+ point 3)
                (+ point 1)))
            var)))]
    [(ir.CompilerIrInstr.UnOp _ _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (compiler-reg-float-type? ty)
          (CompilerRegScratchRole.FloatUnaryResultXmm)
          (CompilerRegScratchRole.ScalarPrimary))
        (if (compiler-reg-float-type? ty)
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-scalar-constraint
            assignments
            instr
            (compiler-reg-id-seq-empty)))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.CpuId _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.CpuIdSave)
        (compiler-reg-scratch-scalar-constraint
          assignments
          instr
          (compiler-reg-scratch-cpuid-fixed-registers))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Branch _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.BranchTest)]
          [(= ordinal 1) (CompilerRegScratchRole.PhiCycle)]
          [(= ordinal 2) (CompilerRegScratchRole.PhiStage)]
          [else (CompilerRegScratchRole.PhiCycleXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-scalar-constraint
              assignments
              instr
              (compiler-reg-id-seq-empty))]
          [(= ordinal 3) (compiler-reg-scratch-phi-xmm-constraint policy)]
          [else (compiler-reg-scratch-phi-constraint policy)])
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.TotalEnumBranch cond true-label false-label)
      (compiler-reg-scratch-requirement-local
        type-segment-bases
        target-abi
        policy
        assignments
        var-types
        (ir.CompilerIrInstr.Branch cond true-label false-label)
        point
        ordinal
        var
        binop-return)]
    [(ir.CompilerIrInstr.Switch _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SwitchIndex)
          (CompilerRegScratchRole.SwitchTable))
        (compiler-reg-scratch-switch-constraint policy assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.TotalEnumSwitch index base cases default-label _)
      (compiler-reg-scratch-requirement-local
        type-segment-bases
        target-abi
        policy
        assignments
        var-types
        (ir.CompilerIrInstr.Switch index base cases default-label)
        point
        ordinal
        var
        binop-return)]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.BoundsLength)
          (CompilerRegScratchRole.BoundsIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.VectorShuffle _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.ShuffleActive)
          (CompilerRegScratchRole.ShuffleSelector))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.AddrOf _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.MemoryAddress)
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Gep _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.MemoryAddress)
          (CompilerRegScratchRole.MemoryIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        ;; A fused GEP+memory consumer reads these homes at the following
        ;; instruction point. Keep both siblings live through that point.
        (+ point 3)
        var)]
    [(ir.CompilerIrInstr.Load _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.MemoryAddress)
          (if (compiler-reg-float-type? ty)
            (CompilerRegScratchRole.FloatMemoryValueXmm)
            (CompilerRegScratchRole.MemoryValue)))
        (if (and (> ordinal 0) (compiler-reg-float-type? ty))
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.StorePtr _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.MemoryAddress)
          (if (compiler-reg-float-type? ty)
            (CompilerRegScratchRole.FloatMemoryValueXmm)
            (CompilerRegScratchRole.MemoryValue)))
        (if (and (> ordinal 0) (compiler-reg-float-type? ty))
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.CopyBytes _ _ size)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CopyDst)]
          [(= ordinal 1) (CompilerRegScratchRole.CopySrc)]
          [(and (= ordinal 2) (>= size 16))
            (CompilerRegScratchRole.CopyValueXmm)]
          [else (CompilerRegScratchRole.CopyValue)])
        (if (and (= ordinal 2) (>= size 16))
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Store _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (compiler-reg-float-type? ty)
          (CompilerRegScratchRole.FloatMemoryValueXmm)
          (CompilerRegScratchRole.MemoryValue))
        (if (compiler-reg-float-type? ty)
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (let
        [xmm? : bool
          (compiler-reg-scratch-cast-xmm-needed?
            assignments
            dst
            src
            from-ty
            to-ty)]
        [gp-ordinal : i64
          (-
            ordinal
            (if xmm?
              1
              0))]
        (CompilerRegScratchRequirement
          point
          ordinal
          (if (and xmm? (= ordinal 0))
            (CompilerRegScratchRole.FloatCastValueXmm)
            (if (= gp-ordinal 0)
              (CompilerRegScratchRole.FloatCastValueGp)
              (CompilerRegScratchRole.FloatCastScratchGp)))
          (if (and xmm? (= ordinal 0))
            (compiler-reg-scratch-xmm-constraint assignments instr)
            (compiler-reg-scratch-memory-constraint assignments instr))
          point
          (+ point 1)
          var))]
    [(ir.CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (let
        [xmm? : bool
          (compiler-reg-scratch-bitcast-xmm-needed?
            assignments
            dst
            src
            from-ty
            to-ty)]
        (CompilerRegScratchRequirement
          point
          ordinal
          (if (and xmm? (= ordinal 0))
            (CompilerRegScratchRole.FloatBitcastValueXmm)
            (CompilerRegScratchRole.FloatBitcastValueGp))
          (if (and xmm? (= ordinal 0))
            (compiler-reg-scratch-xmm-constraint assignments instr)
            (compiler-reg-scratch-memory-constraint assignments instr))
          point
          (+ point 1)
          var))]
    [(ir.CompilerIrInstr.Mov _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.FloatMoveValueXmm)
        (compiler-reg-scratch-xmm-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Splat _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SplatValueGp)
          (CompilerRegScratchRole.SplatValueXmm))
        (if (= ordinal 0)
          (compiler-reg-scratch-memory-constraint assignments instr)
          (compiler-reg-scratch-xmm-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.VectorStore _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.PredicatedStore _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.PredicatedLoad _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.GatherLoad _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.TailMask _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.TailMaskCount)]
          [(= ordinal 1) (CompilerRegScratchRole.TailMaskIndex)]
          [else (CompilerRegScratchRole.TailMaskBits)])
        (if (= ordinal 0)
          (compiler-reg-scratch-fixed-constraint
            assignments
            instr
            cabi.compiler-reg-id-rcx)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        [avx512-bool? : bool
          (match elem-ty
            [(ast.AstType.Bool) (> lanes 32)]
            [_ false])]
        (CompilerRegScratchRequirement
          point
          ordinal
          (cond
            [(= ordinal 0) (CompilerRegScratchRole.VectorPrefixCarry)]
            [avx512-bool? (CompilerRegScratchRole.VectorPrefixBits)]
            [(= ordinal 1) (CompilerRegScratchRole.VectorPrefixValue)]
            [(= ordinal 2) (CompilerRegScratchRole.VectorPrefixWork0)]
            [else (CompilerRegScratchRole.VectorPrefixWork1)])
          (if (or (= ordinal 0) avx512-bool?)
            (compiler-reg-scratch-memory-constraint assignments instr)
            (compiler-reg-scratch-xmm-constraint assignments instr))
          point
          (+ point 1)
          var))]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.VectorReduceAccumulator)
          (CompilerRegScratchRole.VectorReduceScratch))
        (compiler-reg-scratch-xmm-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(ir.CompilerIrInstr.Select payload-box)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.ScalarPrimary)
        (compiler-reg-scratch-scalar-constraint
          assignments
          instr
          (compiler-reg-id-seq-empty))
        point
        (+ point 1)
        var)]
    [_
      ;; Unreachable for a non-zero slot count, but keep a total constructor so
      ;; future role additions fail safely to an unassigned GP requirement.
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.BoundsLength)
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Gp)
          (compiler-reg-id-seq-empty)
          (compiler-reg-greedy-integer-pool-for-abi target-abi)
          cabi.compiler-reg-id-invalid)
        point
        (+ point 1)
        var)]))

;; Fused backend emission can consume scratch slots from several consecutive IR
;; instructions as one atomic group.  Give every slot in that group the same
;; reservation interval and the union of every consumed instruction's homes.
;; This keeps a later sibling result home from aliasing an earlier planned
;; scratch register even when ordinary IR liveness ends at the sibling point.
(define (compiler-reg-scratch-requirement
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [instr : ir.CompilerIrInstr]
  [point : i64]
  [ordinal : i64]
  [var : i64]
  [binop-return : bool]
  [group-lo : i64]
  [group-hi : i64]
  [group-excluded : CompilerRegIdSeq]) : CompilerRegScratchRequirement
  (let
    [local : CompilerRegScratchRequirement
      (compiler-reg-scratch-requirement-local
        type-segment-bases
        target-abi
        policy
        assignments
        var-types
        instr
        point
        ordinal
        var
        binop-return)]
    [constraint : CompilerRegScratchConstraint local.constraint]
    (CompilerRegScratchRequirement
      local.point
      local.ordinal
      local.role
      (CompilerRegScratchConstraint
        constraint.register-class
        constraint.allowed
        (match local.role
          [(CompilerRegScratchRole.FloatReturnResultXmm) constraint.excluded]
          [(CompilerRegScratchRole.FloatReturnResultGp) constraint.excluded]
          [_ (compiler-reg-id-seq-append group-excluded constraint.excluded)])
        constraint.fixed)
      group-lo
      group-hi
      local.var)))

(define (compiler-reg-scratch-mark-requirement!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]
  [requirement : CompilerRegScratchRequirement]) : unit
  (let
    [var : i64 requirement.var]
    [lo : i64 requirement.lo]
    [hi : i64 requirement.hi]
    (if (or (< var 0) (>= var (array-length starts)))
      unit
      (begin
        (set! (array-ref starts var) lo)
        (set! (array-ref ends var) hi)
        (set!
          (array-ref segments var)
          (compiler-reg-interval-seq-prepend
            (CompilerRegInterval var lo hi)
            (compiler-reg-interval-seq-empty)))
        (set! (array-ref present var) 1)
        (set!
          (array-ref types var)
          (match requirement.constraint.register-class
            [(CompilerRegScratchClass.Gp) (ast.AstType.I64)]
            [(CompilerRegScratchClass.Xmm) (ast.AstType.F64)]))))))

(define (compiler-reg-scratch-instr-gep? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-load? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-store-ptr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-copy-bytes? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-binop? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-branch? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-return? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Return _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-not? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.UnOp _ (ir.CompilerIrUnOp.Not) _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-mov? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-jump? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump _) true]
    [_ false]))

(define (compiler-reg-scratch-group-init!
  [firsts : (__tl_dyn-array i64)]
  [lasts : (__tl_dyn-array i64)]
  [len : i64]) : unit
  (let
    [i : i64 0]
    (while (< i len)
      (begin
        (set! (array-ref firsts i) i)
        (set! (array-ref lasts i) i)
        (set! i (+ i 1))))))

;; Candidate fusion regions are discovered left-to-right.  Existing regions
;; may overlap the new candidate, so merge their complete bounds and publish
;; the resulting common span to every member.
(define (compiler-reg-scratch-group-merge!
  [firsts : (__tl_dyn-array i64)]
  [lasts : (__tl_dyn-array i64)]
  [start : i64]
  [end : i64]) : unit
  (let
    [lo : i64
      (if (< start (array-ref firsts start))
        start
        (array-ref firsts start))]
    [hi : i64
      (if (> end (array-ref lasts end))
        end
        (array-ref lasts end))]
    [i : i64 lo]
    (begin
      (while (<= i hi)
        (begin
          (if (< (array-ref firsts i) lo)
            (set! lo (array-ref firsts i))
            unit)
          (if (> (array-ref lasts i) hi)
            (set! hi (array-ref lasts i))
            unit)
          (set! i (+ i 1))))
      (set! i lo)
      (while (<= i hi)
        (begin
          (set! (array-ref firsts i) lo)
          (set! (array-ref lasts i) hi)
          (set! i (+ i 1)))))))

(defenum CompilerRegScratchFusionKind
  (Gep)
  (Load)
  (StorePtr)
  (CopyBytes)
  (BinOp)
  (Branch)
  (Return)
  (Not)
  (Mov)
  (Jump))

(define (compiler-reg-scratch-seq-instr?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [kind : CompilerRegScratchFusionKind]) : bool
  (if (or (< index 0) (>= index (ir.compiler-ir-instr-seq-count instrs)))
    false
    (let
      [instr : ir.CompilerIrInstr (ir.compiler-ir-instr-seq-ref instrs index)]
      (match kind
        [(CompilerRegScratchFusionKind.Gep)
          (compiler-reg-scratch-instr-gep? instr)]
        [(CompilerRegScratchFusionKind.Load)
          (compiler-reg-scratch-instr-load? instr)]
        [(CompilerRegScratchFusionKind.StorePtr)
          (compiler-reg-scratch-instr-store-ptr? instr)]
        [(CompilerRegScratchFusionKind.CopyBytes)
          (compiler-reg-scratch-instr-copy-bytes? instr)]
        [(CompilerRegScratchFusionKind.BinOp)
          (compiler-reg-scratch-instr-binop? instr)]
        [(CompilerRegScratchFusionKind.Branch)
          (compiler-reg-scratch-instr-branch? instr)]
        [(CompilerRegScratchFusionKind.Return)
          (compiler-reg-scratch-instr-return? instr)]
        [(CompilerRegScratchFusionKind.Not)
          (compiler-reg-scratch-instr-not? instr)]
        [(CompilerRegScratchFusionKind.Mov)
          (compiler-reg-scratch-instr-mov? instr)]
        [(CompilerRegScratchFusionKind.Jump)
          (compiler-reg-scratch-instr-jump? instr)]))))

(define (compiler-reg-scratch-seq-vector-load-binop?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 1) (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _)
        (match (ir.compiler-ir-instr-seq-ref instrs (+ index 1))
          [(ir.CompilerIrInstr.VectorBinOp _) true]
          [_ false])]
      [_ false])))

;; Mirror every backend path that obtains another instruction's planned slot
;; with scratch-plan-register-ahead.  These syntactic candidates are slightly
;; conservative: the backend also checks uses/types before fusing, while the
;; planner safely reserves the group whenever the instruction shape could fuse.
(define (compiler-reg-scratch-fusion-groups!
  [instrs : ir.CompilerIrInstrSeq]
  [firsts : (__tl_dyn-array i64)]
  [lasts : (__tl_dyn-array i64)]) : unit
  (let
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (begin
      (compiler-reg-scratch-group-init! firsts lasts len)
      (while (< i len)
        (begin
          (cond
            ;; A SIMD VectorLoad can fold into the following VectorBinOp. The
            ;; address temporaries remain live through the folded instruction,
            ;; whose result and register operand must also be excluded.
            [(compiler-reg-scratch-seq-vector-load-binop? instrs i)
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            ;; Gep+Load can grow into the paired aggregate load or into a
            ;; load/compare/branch bundle.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 3)
                  (CompilerRegScratchFusionKind.Load)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 3))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 3)
                  (CompilerRegScratchFusionKind.Branch)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 3))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.BinOp)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Mov))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (or
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.Load))
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.StorePtr))
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.CopyBytes))))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            ;; Pointer chasing emits two Loads as one unit.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.Branch)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            ;; StorePtr/Gep/StorePtr preserves the first store's sibling homes
            ;; while the second address and value are staged.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.StorePtr))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            ;; Compare/branch and not/branch share terminator scratch slots.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.BinOp))
                (or
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.Branch))
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.Return))))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Not))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Branch)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Mov))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Jump)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            ;; Div/mod polish can consume a producer and a following fused
            ;; Gep+StorePtr in one emergency preservation region.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 3)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 3))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            [else unit])
          (set! i (+ i 1)))))))

(define (compiler-reg-scratch-group-registers-from
  [assignments : CompilerRegAssignmentTable]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : CompilerRegIdSeq
  (if (> index last)
    (compiler-reg-id-seq-empty)
    (compiler-reg-id-seq-append
      (compiler-reg-scratch-instr-registers
        assignments
        (ir.compiler-ir-instr-seq-ref instrs index))
      (compiler-reg-scratch-group-registers-from
        assignments
        instrs
        (+ index 1)
        last))))

(define (compiler-reg-scratch-fill-slots!
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [instr : ir.CompilerIrInstr]
  [point : i64]
  [group-lo : i64]
  [group-hi : i64]
  [group-excluded : CompilerRegIdSeq]
  [scratch-base : i64]
  [item-start : i64]
  [slot : i64]
  [slot-count : i64]
  [binop-return : bool]
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : unit
  (if (>= slot slot-count)
    unit
    (let
      [item-index : i64 (+ item-start slot)]
      [requirement : CompilerRegScratchRequirement
        (compiler-reg-scratch-requirement
          type-segment-bases
          target-abi
          policy
          assignments
          var-types
          instr
          point
          slot
          (+ scratch-base item-index)
          binop-return
          group-lo
          group-hi
          group-excluded)]
      (begin
        (set!
          (array-ref items item-index)
          (CompilerRegScratchAssignment
            requirement
            cabi.compiler-reg-id-invalid))
        (compiler-reg-scratch-mark-requirement!
          starts
          ends
          segments
          present
          types
          requirement)
        (compiler-reg-scratch-fill-slots!
          type-segment-bases
          target-abi
          policy
          assignments
          var-types
          instr
          point
          group-lo
          group-hi
          group-excluded
          scratch-base
          item-start
          (+ slot 1)
          slot-count
          binop-return
          items
          starts
          ends
          segments
          present
          types)))))

(define (compiler-reg-scratch-fill-seq!
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [phi-targets : CompilerRegLabelSeq]
  [phi-xmm-targets : CompilerRegLabelSeq]
  [instruction-start : i64]
  [item-start : i64]
  [scratch-base : i64]
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [firsts : (__tl_dyn-array i64)]
  [slot-counts : (__tl_dyn-array i64)]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : CompilerRegScratchFillState
  (let
    [instr-slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 instrs.len]
    [group-firsts : (__tl_dyn-array i64) (array.make-array i64 len)]
    [group-lasts : (__tl_dyn-array i64) (array.make-array i64 len)]
    [i : i64 0]
    [instruction : i64 instruction-start]
    [item : i64 item-start]
    (begin
      (compiler-reg-scratch-fusion-groups! instrs group-firsts group-lasts)
      (while (< i len)
        (let
          [instr : ir.CompilerIrInstr (array-ref instr-slots i)]
          [group-first : i64 (array-ref group-firsts i)]
          [group-last : i64 (array-ref group-lasts i)]
          [group-excluded : CompilerRegIdSeq
            (compiler-reg-scratch-group-registers-from
              assignments
              instrs
              group-first
              group-last)]
          [n : i64
            (compiler-reg-scratch-vreg-slots
              type-segment-bases
              target-abi
              assignments
              var-types
              instr
              phi-targets
              phi-xmm-targets
              (compiler-reg-scratch-binop-return-next? instrs i))]
          (begin
            (set! (array-ref firsts instruction) item)
            (set! (array-ref slot-counts instruction) n)
            (compiler-reg-scratch-fill-slots!
              type-segment-bases
              target-abi
              policy
              assignments
              var-types
              instr
              (* 2 instruction)
              (* 2 (+ instruction-start group-first))
              (+ (* 2 (+ instruction-start group-last)) 1)
              group-excluded
              scratch-base
              item
              0
              n
              (compiler-reg-scratch-binop-return-next? instrs i)
              items
              starts
              ends
              segments
              present
              types)
            (set! item (+ item n))
            (set! instruction (+ instruction 1))
            (set! i (+ i 1)))))
      (CompilerRegScratchFillState.State instruction item))))

(define (compiler-reg-scratch-fill-blocks!
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [phi-targets : CompilerRegLabelSeq]
  [phi-xmm-targets : CompilerRegLabelSeq]
  [instruction-start : i64]
  [item-start : i64]
  [scratch-base : i64]
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [firsts : (__tl_dyn-array i64)]
  [slot-counts : (__tl_dyn-array i64)]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : CompilerRegScratchFillState
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (CompilerRegScratchFillState.State instruction-start item-start)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-scratch-fill-seq!
            type-segment-bases
            target-abi
            policy
            assignments
            var-types
            instrs
            phi-targets
            phi-xmm-targets
            instruction-start
            item-start
            scratch-base
            items
            firsts
            slot-counts
            starts
            ends
            segments
            present
            types)
            [(CompilerRegScratchFillState.State next-instruction next-item)
              (compiler-reg-scratch-fill-blocks!
                type-segment-bases
                target-abi
                policy
                assignments
                var-types
                (__tl-box-place rest)
                phi-targets
                phi-xmm-targets
                next-instruction
                next-item
                scratch-base
                items
                firsts
                slot-counts
                starts
                ends
                segments
                present
                types)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [instruction : i64 instruction-start]
        [item : i64 item-start]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-scratch-fill-seq!
                    type-segment-bases
                    target-abi
                    policy
                    assignments
                    var-types
                    instrs
                    phi-targets
                    phi-xmm-targets
                    instruction
                    item
                    scratch-base
                    items
                    firsts
                    slot-counts
                    starts
                    ends
                    segments
                    present
                    types)
                    [(CompilerRegScratchFillState.State
                        next-instruction
                        next-item)
                      (begin
                        (set! instruction next-instruction)
                        (set! item next-item))])])
              (set! i (+ i 1))))
          (CompilerRegScratchFillState.State instruction item)))]))

;; Cycle 14's early model is deliberately narrower than the generic late
;; scratch planner: only scalar SafeDiv/SafeMod with an integer literal divisor
;; contributes worklist entries. BoundsCheck, Switch, variable divmod, ordinary
;; Div/Mod, and float operations remain late-only.
(define (compiler-reg-early-scratch-literal? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [_ false]))

(define (compiler-reg-early-scratch-target? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op _ rhs ty)
      (and
        (not (compiler-reg-float-type? ty))
        (match op
          [(ir.CompilerIrBinOp.SafeDiv) true]
          [(ir.CompilerIrBinOp.SafeMod) true]
          [_ false])
        (compiler-reg-early-scratch-literal? rhs))]
    [_ false]))

(define (compiler-reg-early-scratch-count-seq [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 instrs.len]
    [i : i64 0]
    [count : i64 0]
    (begin
      (while (< i len)
        (begin
          (if (compiler-reg-early-scratch-target? (array-ref slots i))
            ;; Reuse the generic divmod model's fixed width: rax, rdx, and
            ;; three simultaneous GP temporaries.
            (set! count (+ count 5))
            unit)
          (set! i (+ i 1))))
      count)))

(define (compiler-reg-early-scratch-count-blocks
  [blocks : ir.CompilerIrBlockList]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) 0]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (+
            (compiler-reg-early-scratch-count-seq instrs)
            (compiler-reg-early-scratch-count-blocks (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [len : i64 (ir.compiler-ir-block-seq-count seq)]
        [count : i64 0]
        (begin
          (while (< i len)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    count
                    (+ count (compiler-reg-early-scratch-count-seq instrs)))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-early-scratch-expansion-requirement
  [requirement : CompilerRegScratchRequirement]) : CompilerRegScratchRequirement
  (let
    [point : i64 requirement.point]
    ;; The allocator's half-open [point, point+1] instruction window covers the
    ;; complete atomic divmod expansion. Inputs whose final use is this BinOp end
    ;; at `point` and may therefore donate their register to the expansion; the
    ;; result and every value live through the instruction still overlap it.
    (CompilerRegScratchRequirement
      point
      requirement.ordinal
      requirement.role
      requirement.constraint
      point
      (+ point 1)
      requirement.var)))

(define (compiler-reg-early-scratch-mark-one!
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignment-view : CompilerRegAssignmentTable]
  [assignment-table : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [instr : ir.CompilerIrInstr]
  [point : i64]
  [ordinal : i64]
  [var : i64]
  [binop-return : bool]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]) : unit
  (let
    [requirement : CompilerRegScratchRequirement
      (compiler-reg-early-scratch-expansion-requirement
        (compiler-reg-scratch-requirement-local
          type-segment-bases
          target-abi
          policy
          assignment-view
          var-types
          instr
          point
          ordinal
          var
          binop-return))]
    [fixed : i64 requirement.constraint.fixed]
    (begin
      (compiler-reg-scratch-mark-requirement!
        starts
        ends
        segments
        present
        types
        requirement)
      (set! (array-ref scratch-excluded var) requirement.constraint.excluded)
      (if (= fixed cabi.compiler-reg-id-invalid)
        unit
        (begin
          (compiler-reg-assignment-table-insert
            assignment-table
            var
            (CompilerRegLocation.Register fixed))
          unit)))))

(define (compiler-reg-early-scratch-fill-seq!
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignment-view : CompilerRegAssignmentTable]
  [assignment-table : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [instrs : ir.CompilerIrInstrSeq]
  [block-weight : i64]
  [instruction-start : i64]
  [scratch-start : i64]
  [scratch-base : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]
  [scratch-weights : (__tl_dyn-array i64)]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]) : CompilerRegScratchFillState
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 instrs.len]
    [i : i64 0]
    [instruction : i64 instruction-start]
    [scratch : i64 scratch-start]
    (begin
      (while (< i len)
        (let
          [instr : ir.CompilerIrInstr (array-ref slots i)]
          (begin
            (if (compiler-reg-early-scratch-target? instr)
              (let
                [ordinal : i64 0]
                (begin
                  (while (< ordinal 5)
                    (begin
                      (compiler-reg-early-scratch-mark-one!
                        type-segment-bases
                        target-abi
                        policy
                        assignment-view
                        assignment-table
                        var-types
                        instr
                        (* 2 instruction)
                        ordinal
                        (+ scratch-base scratch ordinal)
                        (compiler-reg-scratch-binop-return-next? instrs i)
                        starts
                        ends
                        segments
                        present
                        types
                        scratch-excluded)
                      ;; Each non-fixed requirement contributes one demand
                      ;; occurrence at the expansion's loop depth.
                      (set!
                        (array-ref scratch-weights (+ scratch ordinal))
                        (if (>= ordinal 2)
                          block-weight
                          0))
                      (set! ordinal (+ ordinal 1))))
                  (set! scratch (+ scratch 5))))
              unit)
            (set! instruction (+ instruction 1))
            (set! i (+ i 1)))))
      (CompilerRegScratchFillState.State instruction scratch))))

(define (compiler-reg-early-scratch-fill-blocks!
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignment-view : CompilerRegAssignmentTable]
  [assignment-table : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypes]
  [blocks : ir.CompilerIrBlockList]
  [depths : (__tl_dyn-array i64)]
  [block-index : i64]
  [instruction-start : i64]
  [scratch-start : i64]
  [scratch-base : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]
  [scratch-weights : (__tl_dyn-array i64)]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]) : CompilerRegScratchFillState
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (CompilerRegScratchFillState.State instruction-start scratch-start)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-early-scratch-fill-seq!
            type-segment-bases
            target-abi
            policy
            assignment-view
            assignment-table
            var-types
            instrs
            (compiler-reg-loop-depth-weight (array-ref depths block-index))
            instruction-start
            scratch-start
            scratch-base
            starts
            ends
            segments
            present
            types
            scratch-weights
            scratch-excluded)
            [(CompilerRegScratchFillState.State next-instruction next-scratch)
              (compiler-reg-early-scratch-fill-blocks!
                type-segment-bases
                target-abi
                policy
                assignment-view
                assignment-table
                var-types
                (__tl-box-place rest)
                depths
                (+ block-index 1)
                next-instruction
                next-scratch
                scratch-base
                starts
                ends
                segments
                present
                types
                scratch-weights
                scratch-excluded)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [len : i64 (ir.compiler-ir-block-seq-count seq)]
        [instruction : i64 instruction-start]
        [scratch : i64 scratch-start]
        (begin
          (while (< i len)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-early-scratch-fill-seq!
                    type-segment-bases
                    target-abi
                    policy
                    assignment-view
                    assignment-table
                    var-types
                    instrs
                    (compiler-reg-loop-depth-weight
                      (array-ref depths (+ block-index i)))
                    instruction
                    scratch
                    scratch-base
                    starts
                    ends
                    segments
                    present
                    types
                    scratch-weights
                    scratch-excluded)
                    [(CompilerRegScratchFillState.State
                        next-instruction
                        next-scratch)
                      (begin
                        (set! instruction next-instruction)
                        (set! scratch next-scratch))])])
              (set! i (+ i 1))))
          (CompilerRegScratchFillState.State instruction scratch)))]))

(define (compiler-reg-early-scratch-model
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [base-index : CompilerRegIntervalIndex]
  [base-types : CompilerRegVarTypes]
  [base-assignments : CompilerRegAssignmentTable]
  [enabled : bool]) : CompilerRegEarlyScratchModel
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [scratch-base : i64 (array-length base-index.starts)]
        [scratch-count : i64
          (if enabled
            (compiler-reg-early-scratch-count-blocks blocks)
            0)]
        (if (= scratch-count 0)
          (CompilerRegEarlyScratchModel
            base-index
            base-types
            base-assignments
            (array.make-array i64 0)
            (array.make-array CompilerRegIdSeq 0)
            scratch-base
            0)
          (let
            [out-vars : i64 (+ scratch-base scratch-count)]
            [starts : (__tl_dyn-array i64) (array.make-array i64 out-vars)]
            [ends : (__tl_dyn-array i64) (array.make-array i64 out-vars)]
            [segments : (__tl_dyn-array CompilerRegIntervalSeq)
              (array.make-array CompilerRegIntervalSeq out-vars)]
            [present : (__tl_dyn-array i64) (array.make-array i64 out-vars)]
            [types : (__tl_dyn-array ast.AstType)
              (array.make-array ast.AstType out-vars)]
            [scratch-weights : (__tl_dyn-array i64)
              (array.make-array i64 scratch-count)]
            [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)
              (array.make-array CompilerRegIdSeq out-vars)]
            [depths : (__tl_dyn-array i64)
              (compiler-reg-function-loop-depths blocks)]
            [assignment-view : CompilerRegAssignmentTable base-assignments]
            [assignments : CompilerRegAssignmentTable
              (compiler-reg-assignment-table-copy-with-capacity
                assignment-view
                out-vars)]
            [policy : CompilerRegScratchPolicy
              (compiler-reg-scratch-policy
                target-abi
                assignment-view
                (compiler-reg-id-seq-empty))]
            (begin
              (compiler-reg-fill-i64-array starts -1)
              (compiler-reg-fill-i64-array ends -1)
              (compiler-reg-fill-interval-seq-array! segments 0)
              (compiler-reg-copy-i64-array! starts base-index.starts 0)
              (compiler-reg-copy-i64-array! ends base-index.ends 0)
              (compiler-reg-copy-interval-seq-array!
                segments
                base-index.segments
                0)
              (compiler-reg-copy-i64-array! present base-types.present 0)
              (compiler-reg-copy-ast-type-array! types base-types.items 0)
              (compiler-reg-early-scratch-fill-blocks!
                type-segment-bases
                target-abi
                policy
                assignment-view
                assignments
                base-types
                blocks
                depths
                0
                0
                0
                scratch-base
                starts
                ends
                segments
                present
                types
                scratch-weights
                scratch-excluded)
              (CompilerRegEarlyScratchModel
                (CompilerRegIntervalIndex starts ends segments)
                (CompilerRegVarTypes present types)
                assignments
                scratch-weights
                scratch-excluded
                scratch-base
                scratch-count)))))]))

(define (compiler-reg-early-scratch-extend-weights
  [weights : (__tl_dyn-array i64)]
  [raw-weights : (__tl_dyn-array i64)]
  [vars : i64]
  [scratch-base : i64]
  [scratch-count : i64]
  [scratch-weights : (__tl_dyn-array i64)]) : (__tl_dyn-array i64)
  (if (= scratch-count 0)
    weights
    (let
      [out : (__tl_dyn-array i64) (array.make-array i64 vars)]
      [max-raw : i64 0]
      [r : i64 0]
      [v : i64 scratch-base]
      (begin
        (compiler-reg-copy-i64-array! out weights 0)
        (while (< r (array-length raw-weights))
          (begin
            (if (> (array-ref raw-weights r) max-raw)
              (set! max-raw (array-ref raw-weights r))
              unit)
            (set! r (+ r 1))))
        ;; Use the same (discounted * radix + raw) scale as real values. Scratch
        ;; is not rematerialisable, so its discounted and raw costs are equal.
        ;; A non-zero demand wins an exact real-value tie by one unit: failing to
        ;; place it costs a save+restore pair, while evicting the equally cold
        ;; occupant pays one honest spill/reload home. The ordinary greedy keeps
        ;; its strict-lower eviction rule; only these targeted pseudos receive the
        ;; preservation-cost tie-break. An unprofitable requirement remains
        ;; unassigned and the retained late planner/scavenger supplies fallback.
        (while (< v vars)
          (let
            [scratch-index : i64 (- v scratch-base)]
            [weight : i64
              (if (< scratch-index (array-length scratch-weights))
                (array-ref scratch-weights scratch-index)
                0)]
            [combined : i64 (+ (* weight (+ max-raw 1)) weight)]
            [priced : i64
              (if (= weight 0)
                combined
                (+ combined 1))]
            (begin
              (set!
                (array-ref out v)
                (if (>= priced (compiler-reg-greedy-evict-inf))
                  (- (compiler-reg-greedy-evict-inf) 1)
                  priced))
              (set! v (+ v 1)))))
        out))))

(define (compiler-reg-early-scratch-intervals
  [intervals : CompilerRegIntervalSeq]
  [scratch-base : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count intervals))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          (begin
            (if (>= interval.var scratch-base)
              (set! out (compiler-reg-interval-seq-append out interval))
              unit)
            (set! index (+ index 1)))))
      out)))

(define (compiler-reg-assignment-table-copy-range!
  [dst : CompilerRegAssignmentTable]
  [src : CompilerRegAssignmentTable]
  [start : i64]
  [end : i64]) : unit
  (let
    [v : i64 start]
    (while (< v end)
      (begin
        (match (compiler-reg-assignment-table-lookup src v)
          [(CompilerRegMaybeLocation.Some location)
            (begin
              (compiler-reg-assignment-table-insert dst v location)
              unit)]
          [(CompilerRegMaybeLocation.No) unit])
        (set! v (+ v 1))))))

(define (compiler-reg-assignment-table-prefix
  [assignments : CompilerRegAssignmentTable]
  [vars : i64]) : CompilerRegAssignmentTable
  (if (= vars (array-length assignments.present))
    assignments
    (let
      [out : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make vars)]
      (begin
        (compiler-reg-assignment-table-copy-range! out assignments 0 vars)
        out))))

(define (compiler-reg-assignment-table-prefix-eq?
  [left : CompilerRegAssignmentTable]
  [right : CompilerRegAssignmentTable]
  [limit : i64]
  [var : i64]) : bool
  (if (>= var limit)
    true
    (and
      (match (compiler-reg-assignment-table-lookup left var)
        [(CompilerRegMaybeLocation.Some left-location)
          (match (compiler-reg-assignment-table-lookup right var)
            [(CompilerRegMaybeLocation.Some right-location)
              (compiler-reg-location-eq? left-location right-location)]
            [(CompilerRegMaybeLocation.No) false])]
        [(CompilerRegMaybeLocation.No)
          (match (compiler-reg-assignment-table-lookup right var)
            [(CompilerRegMaybeLocation.Some _) false]
            [(CompilerRegMaybeLocation.No) true])])
      (compiler-reg-assignment-table-prefix-eq? left right limit (+ var 1)))))

(define (compiler-reg-assignment-table-with-scratch
  [real-assignments : CompilerRegAssignmentTable]
  [scratch-assignments : CompilerRegAssignmentTable]
  [scratch-base : i64]
  [scratch-count : i64]) : CompilerRegAssignmentTable
  (if (= scratch-count 0)
    real-assignments
    (let
      [out-vars : i64 (+ scratch-base scratch-count)]
      [out : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make out-vars)]
      (begin
        (compiler-reg-assignment-table-copy-range!
          out
          real-assignments
          0
          scratch-base)
        (compiler-reg-assignment-table-copy-range!
          out
          scratch-assignments
          scratch-base
          out-vars)
        out))))

(define (compiler-reg-scratch-default-pool
  [target-abi : cabi.CompilerRegTargetAbi]
  [register-class : CompilerRegScratchClass]) : CompilerRegIdSeq
  (match register-class
    [(CompilerRegScratchClass.Gp)
      ;; A scratch interval is confined to one lowering expansion and never
      ;; crosses a call. Give both targets the canonical GP candidate order so
      ;; Win64's shorter volatile prefix cannot advance the same demand to a
      ;; different save class (notably %rbx) solely because of ABI pool order.
      (compiler-reg-greedy-integer-pool-for-abi
        (cabi.CompilerRegTargetAbi.Linux))]
    [(CompilerRegScratchClass.Xmm)
      (compiler-reg-xmm-registers-for-abi target-abi)]))

(define (compiler-reg-scratch-constraint-pool
  [target-abi : cabi.CompilerRegTargetAbi]
  [constraint : CompilerRegScratchConstraint]) : CompilerRegIdSeq
  (let
    [fixed : i64 constraint.fixed]
    (if (not (= fixed cabi.compiler-reg-id-invalid))
      (compiler-reg-id-seq-prepend fixed (compiler-reg-id-seq-empty))
      (let
        [allowed : CompilerRegIdSeq constraint.allowed]
        (if (compiler-reg-id-seq-empty? allowed)
          (compiler-reg-scratch-default-pool
            target-abi
            constraint.register-class)
          allowed)))))

(define (compiler-reg-scratch-register-array
  [target-abi : cabi.CompilerRegTargetAbi]) : (__tl_dyn-array i64)
  (let
    ;; Fixed ABI roles must remain addressable by the inverse index even while
    ;; the default-off scratch-vreg experiment keeps XMM0/XMM1 out of the
    ;; ordinary allocator pool.
    [xmm-registers : CompilerRegIdSeq
      (if (compiler-reg-low-xmm-allocatable?)
        (compiler-reg-xmm-registers-for-abi target-abi)
        (compiler-reg-id-seq-prepend
          (cabi.compiler-abi-xmm-register-id 0)
          (compiler-reg-id-seq-prepend
            (cabi.compiler-abi-xmm-register-id 1)
            (compiler-reg-xmm-registers-for-abi target-abi))))]
    [registers : CompilerRegIdSeq
      (compiler-reg-id-seq-append
        (compiler-reg-greedy-integer-pool-for-abi
          (cabi.CompilerRegTargetAbi.Linux))
        xmm-registers)]
    [out : (__tl_dyn-array i64)
      (array.make-array i64 (compiler-reg-id-seq-count registers))]
    (begin
      (compiler-reg-greedy-id-seq-to-array registers out 0)
      out)))

;; Every production scratch constraint maps into the combined GP/XMM occupancy
;; above. Keep the full assignment-table scan as a fail-closed fallback for an
;; unrecognized future register spelling rather than silently treating it free.
(define (compiler-reg-scratch-register-free-from?
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [var : i64]
  [reg : i64]
  [index : i64]
  [vars : i64]) : bool
  (if (>= index vars)
    true
    (let
      [present : (__tl_dyn-array i64) assignments.present]
      [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
      (if (and
        (not (= index var))
        (< index (array-length present))
        (= (array-ref present index) 1)
        (compiler-reg-location-uses-register? (array-ref items index) reg)
        (compiler-reg-vars-interfere-segmented-index? interval-index var index))
        false
        (compiler-reg-scratch-register-free-from?
          assignments
          interval-index
          var
          reg
          (+ index 1)
          vars)))))

(define (compiler-reg-scratch-pick-register
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [var : i64]
  [vars : i64]
  [candidates : CompilerRegIdSeq]
  [excluded : CompilerRegIdSeq]) : i64
  (let
    [index : i64 0]
    [result : i64 cabi.compiler-reg-id-invalid]
    (begin
      (while (and
        (< index (compiler-reg-id-seq-count candidates))
        (= result cabi.compiler-reg-id-invalid))
        (let
          [reg : i64 (compiler-reg-id-seq-ref candidates index)]
          [reg-index : i64 (compiler-reg-greedy-pool-index occupancy reg)]
          (begin
            (if (and
              (not (compiler-reg-id-seq-contains? excluded reg))
              (if (>= reg-index 0)
                (compiler-reg-greedy-reg-free?
                  occupancy
                  interval-index
                  ref-counts
                  var
                  reg-index)
                (compiler-reg-scratch-register-free-from?
                  assignments
                  interval-index
                  var
                  reg
                  0
                  vars)))
              (set! result reg)
              unit)
            (set! index (+ index 1)))))
      result)))

(define (compiler-reg-scratch-return-fixed-role?
  [role : CompilerRegScratchRole]) : bool
  (match role
    [(CompilerRegScratchRole.FloatReturnResultXmm) true]
    [(CompilerRegScratchRole.FloatReturnResultGp) true]
    [_ false]))

(define (compiler-reg-scratch-tail-mask-count-role?
  [role : CompilerRegScratchRole]) : bool
  (match role
    [(CompilerRegScratchRole.TailMaskCount) true]
    [_ false]))

(define (compiler-reg-scratch-assign-items!
  [target-abi : cabi.CompilerRegTargetAbi]
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [index : i64]
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]
  [vars : i64]) : unit
  (if (>= index (array-length items))
    unit
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement item.requirement]
      [constraint : CompilerRegScratchConstraint requirement.constraint]
      [reg
        : i64
        ;; The tail-mask index is copied to ordinal 1 before the end value is
        ;; loaded into %rcx. Permit the fixed count to overlap that instruction
        ;; input, but make an unrelated live-through resident fail so emission
        ;; takes the sound legacy save/restore fallback. Sibling requirements
        ;; are assigned afterward and see a successful synthetic home.
        (if (compiler-reg-scratch-tail-mask-count-role? requirement.role)
          (if (compiler-reg-id-seq-contains?
            constraint.excluded
            constraint.fixed)
            constraint.fixed
            (compiler-reg-scratch-pick-register
              assignments
              occupancy
              interval-index
              ref-counts
              requirement.var
              vars
              (compiler-reg-scratch-constraint-pool target-abi constraint)
              constraint.excluded))
          ;; A return result is the final consumer of its operand homes. Its
          ;; fixed ABI register may therefore overlap an input; a simultaneously
          ;; live RHS preservation requirement is assigned afterward and sees
          ;; this synthetic fixed home, so it must choose a distinct register.
          (if (compiler-reg-scratch-return-fixed-role? requirement.role)
            constraint.fixed
            (compiler-reg-scratch-pick-register
              assignments
              occupancy
              interval-index
              ref-counts
              requirement.var
              vars
              (compiler-reg-scratch-constraint-pool target-abi constraint)
              constraint.excluded)))]
      (begin
        (if (= reg cabi.compiler-reg-id-invalid)
          unit
          (begin
            (compiler-reg-assignment-table-insert
              assignments
              requirement.var
              (CompilerRegLocation.Register reg))
            (compiler-reg-greedy-occupancy-record-location!
              occupancy
              requirement.var
              (CompilerRegLocation.Register reg))
            (set!
              (array-ref items index)
              (CompilerRegScratchAssignment requirement reg))))
        (compiler-reg-scratch-assign-items!
          target-abi
          items
          (+ index 1)
          assignments
          occupancy
          interval-index
          ref-counts
          reg-arr
          rcount
          vars)))))

(define (compiler-reg-scratch-clear-group-from!
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [index : i64]
  [lo : i64]
  [hi : i64]) : unit
  (if (>= index (array-length items))
    unit
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement item.requirement]
      (begin
        (if (and (= requirement.lo lo) (= requirement.hi hi))
          (set!
            (array-ref items index)
            (CompilerRegScratchAssignment
              requirement
              cabi.compiler-reg-id-invalid))
          unit)
        (compiler-reg-scratch-clear-group-from! items (+ index 1) lo hi)))))

;; A fused emitter must never mix a partially allocated planned group with
;; independent scavenger choices.  If any slot in a common reservation span
;; failed, clear every sibling slot so planned-or-scavenge handles the complete
;; group through the legacy sound fallback.
(define (compiler-reg-scratch-clear-incomplete-groups!
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement item.requirement]
      (begin
        (if (and
          (> (- requirement.hi requirement.lo) 1)
          (= item.register cabi.compiler-reg-id-invalid))
          (compiler-reg-scratch-clear-group-from!
            items
            0
            requirement.lo
            requirement.hi)
          unit)
        (compiler-reg-scratch-clear-incomplete-groups! items (+ index 1))))))

(define (compiler-reg-scratch-callee-saved-register?
  [target-abi : cabi.CompilerRegTargetAbi]
  [reg : i64]) : bool
  (or
    (compiler-reg-id-seq-contains? (compiler-reg-sysv-integer-registers) reg)
    (= reg cabi.compiler-reg-id-rbp)
    (match target-abi
      [(cabi.CompilerRegTargetAbi.Linux) false]
      [(cabi.CompilerRegTargetAbi.Windows)
        (or
          (= reg cabi.compiler-reg-id-rsi)
          (= reg cabi.compiler-reg-id-rdi)
          (compiler-reg-id-seq-contains?
            (compiler-reg-xmm-callee-registers-for-abi target-abi)
            reg))])))

(define (compiler-reg-scratch-compact-assignments-from
  [target-abi : cabi.CompilerRegTargetAbi]
  [items : (__tl_dyn-array CompilerRegScratchAssignment)]
  [index : i64]
  [success : i64]
  [vars : i64]
  [seen : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]) : CompilerRegAssignmentTable
  (if (>= index (array-length items))
    assignments
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [reg : i64 item.register]
      (if (or
        (= reg cabi.compiler-reg-id-invalid)
        (not (compiler-reg-scratch-callee-saved-register? target-abi reg))
        (compiler-reg-id-seq-contains? seen reg))
        (compiler-reg-scratch-compact-assignments-from
          target-abi
          items
          (+ index 1)
          success
          vars
          seen
          assignments)
        (compiler-reg-assignments-prepend
          (CompilerRegAssignment
            (+ vars success)
            (CompilerRegLocation.Register reg))
          (compiler-reg-scratch-compact-assignments-from
            target-abi
            items
            (+ index 1)
            (+ success 1)
            vars
            (compiler-reg-id-seq-prepend reg seen)
            assignments))))))

(define (compiler-reg-plan-with-scratch-vreg-result
  [_type-segment-bases : i64]
  [_abi : cabi.CompilerRegTargetAbi]
  [_func : ir.CompilerIrFunction]
  [plan : CompilerRegPlan]
  [_vars : i64]) : CompilerRegScratchPlanResult
  (cfg
    scratch-vreg
    (match _func
      [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
        (let
          [phi-targets : CompilerRegLabelSeq
            (compiler-reg-scratch-phi-targets-blocks blocks)]
          [phi-xmm-targets : CompilerRegLabelSeq
            (compiler-reg-scratch-phi-xmm-targets-blocks blocks)]
          [scratch-count : i64
            (compiler-reg-scratch-vreg-count-blocks
              _type-segment-bases
              _abi
              (compiler-reg-plan-assignments plan)
              (compiler-reg-plan-types plan)
              blocks
              phi-targets
              phi-xmm-targets
              0)]
          [instruction-count : i64
            (compiler-reg-scratch-vreg-instr-count-blocks blocks 0)]
          (if (= scratch-count 0)
            (CompilerRegScratchPlanResult.Result
              plan
              (CompilerRegScratchPlan
                (array.make-array CompilerRegScratchAssignment 0)
                (array.make-array i64 instruction-count)
                (array.make-array i64 instruction-count)))
            (let
              [out-vars : i64 (+ _vars scratch-count)]
              [scratch-policy : CompilerRegScratchPolicy
                (compiler-reg-scratch-policy
                  _abi
                  (compiler-reg-plan-assignments plan)
                  (compiler-reg-scratch-phi-dst-registers-blocks
                    (compiler-reg-plan-assignments plan)
                    blocks))]
              [base-type-info : CompilerRegVarTypes
                (compiler-reg-plan-types plan)]
              [liveness-handle : CompilerRegLivenessHandle
                (compiler-reg-liveness-handle-make _func false)]
              [base-interval-selection : CompilerRegIntervalSelection
                (compiler-reg-live-interval-selection
                  _func
                  liveness-handle.baseline)]
              (match base-interval-selection
                [(CompilerRegIntervalSelection.Selection _ base-index)
                  (let
                    [starts : (__tl_dyn-array i64)
                      (array.make-array i64 out-vars)]
                    [ends : (__tl_dyn-array i64)
                      (array.make-array i64 out-vars)]
                    [segments : (__tl_dyn-array CompilerRegIntervalSeq)
                      (array.make-array CompilerRegIntervalSeq out-vars)]
                    [present : (__tl_dyn-array i64)
                      (array.make-array i64 out-vars)]
                    [types : (__tl_dyn-array ast.AstType)
                      (array.make-array ast.AstType out-vars)]
                    [items : (__tl_dyn-array CompilerRegScratchAssignment)
                      (array.make-array
                        CompilerRegScratchAssignment
                        scratch-count)]
                    [firsts : (__tl_dyn-array i64)
                      (array.make-array i64 instruction-count)]
                    [slot-counts : (__tl_dyn-array i64)
                      (array.make-array i64 instruction-count)]
                    (begin
                      (compiler-reg-fill-i64-array starts -1)
                      (compiler-reg-fill-i64-array ends -1)
                      (compiler-reg-fill-interval-seq-array! segments 0)
                      (compiler-reg-copy-i64-array! starts base-index.starts 0)
                      (compiler-reg-copy-i64-array! ends base-index.ends 0)
                      (compiler-reg-copy-interval-seq-array!
                        segments
                        base-index.segments
                        0)
                      (compiler-reg-copy-i64-array!
                        present
                        base-type-info.present
                        0)
                      (compiler-reg-copy-ast-type-array!
                        types
                        base-type-info.items
                        0)
                      (compiler-reg-scratch-fill-blocks!
                        _type-segment-bases
                        _abi
                        scratch-policy
                        (compiler-reg-plan-assignments plan)
                        (compiler-reg-plan-types plan)
                        blocks
                        phi-targets
                        phi-xmm-targets
                        0
                        0
                        _vars
                        items
                        firsts
                        slot-counts
                        starts
                        ends
                        segments
                        present
                        types)
                      (let
                        [type-info : CompilerRegVarTypes
                          (CompilerRegVarTypes present types)]
                        [interval-index : CompilerRegIntervalIndex
                          (CompilerRegIntervalIndex starts ends segments)]
                        [intervals : CompilerRegIntervalSeq
                          (compiler-reg-interval-arrays-to-seq
                            starts
                            ends
                            (- out-vars 1)
                            (compiler-reg-interval-seq-empty))]
                        [plan-assignments : CompilerRegAssignmentTable
                          (compiler-reg-plan-assignments plan)]
                        [assignments : CompilerRegAssignmentTable
                          (compiler-reg-assignment-table-copy-with-capacity
                            plan-assignments
                            out-vars)]
                        [scratch-registers : (__tl_dyn-array i64)
                          (compiler-reg-scratch-register-array _abi)]
                        [scratch-register-count : i64
                          (array-length scratch-registers)]
                        [scratch-occupancy : CompilerRegGreedyOccupancy
                          (compiler-reg-greedy-occupancy-make
                            assignments
                            interval-index
                            scratch-registers
                            scratch-register-count)]
                        [scratch-ref-counts : (__tl_dyn-array i64)
                          (array.make-array i64 out-vars)]
                        (begin
                          ;; Constraint-aware, non-evicting assignment: every
                          ;; synthetic interval and all previously assigned homes
                          ;; are visible before a register is selected.  Failure
                          ;; leaves the item register empty for safe fallback.
                          (compiler-reg-scratch-assign-items!
                            _abi
                            items
                            0
                            assignments
                            scratch-occupancy
                            interval-index
                            scratch-ref-counts
                            scratch-registers
                            scratch-register-count
                            out-vars)
                          (compiler-reg-scratch-clear-incomplete-groups!
                            items
                            0)
                          (CompilerRegScratchPlanResult.Result
                            (match plan
                              [(CompilerRegPlan.Plan
                                  base-assignments
                                  ineligible
                                  base-intervals
                                  base-types
                                  call-split
                                  split-plan)
                                (CompilerRegPlan.Plan
                                  ;; Scratch requirements are not IR values and
                                  ;; never need stack slots. Publish each
                                  ;; successful callee-saved home only once,
                                  ;; densely after the real vars, so prologue
                                  ;; accounting sees it without making
                                  ;; caller-saved temporaries inflate every
                                  ;; var-sized backend table.
                                  (compiler-reg-assignment-table-merge
                                    (compiler-reg-scratch-compact-assignments-from
                                      _abi
                                      items
                                      0
                                      0
                                      _vars
                                      (compiler-reg-id-seq-empty)
                                      (compiler-reg-assignment-table-empty))
                                    base-assignments)
                                  ineligible
                                  base-intervals
                                  base-types
                                  call-split
                                  split-plan)])
                            (CompilerRegScratchPlan items firsts slot-counts))))))]))))])
    (CompilerRegScratchPlanResult.Result plan (compiler-reg-scratch-plan-empty))))

(define (compiler-reg-caller-save-remap-fill!
  [remap : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length remap))
    unit
    (begin
      (set! (array-ref remap index) index)
      (compiler-reg-caller-save-remap-fill! remap (+ index 1)))))

(define (compiler-reg-caller-save-remap [vars : i64]) : (__tl_dyn-array i64)
  (let
    [remap : (__tl_dyn-array i64) (array.make-array i64 vars)]
    (begin
      (compiler-reg-caller-save-remap-fill! remap 0)
      remap)))

(define (compiler-reg-caller-save-var-type
  [type-info : CompilerRegVarTypes]
  [var : i64]) : ast.AstType
  (match (compiler-reg-var-types-lookup type-info var)
    [(CompilerRegMaybeType.Some ty) ty]
    [(CompilerRegMaybeType.No) (ast.AstType.I64)]))

;; ---------------------------------------------------------------------------
;; M-G2b backend realization of the per-call-region split. Runs FIRST in the
;; backend rewrite pipeline (caller-save -> loop-split -> remat)
;; on blocks byte-identical to the ones the allocator numbered, so the
;; region point coords map 1:1. For each accepted region [lo,hi] of var V:
;;   * at lo: mint a fresh segment var W assigned V's shadow caller-saved
;;     register, emit the entry reload `Mov W <- V` when entry-flag = 1
;;     (V resolves to its own home slot), and remap V -> W;
;;   * every instr in [lo,hi] goes through the remap;
;;   * at hi: emit the exit store `Mov V <- W` when exit-flag = 1 -- BEFORE
;;     hi's instr when it is control flow (a terminator only READS V, so
;;     the order is free), else right after it -- then reset the remap.
;; The remap is strictly PER-VAR, never slot-class-wide: storage coloring
;; later assigns every var its own slot from its own liveness, so
;; coalesce-class members sharing a plan offset can end up in DIFFERENT
;; final slots (their value flows through the class's explicit copy movs,
;; which this rewrite leaves untouched -- a class-wide remap homed on the
;; root's slot reads/writes the wrong storage once coloring de-aliases the
;; members).
;; Regions are kind-0-clobber-free and non-overlapping per var by
;; construction, so no mid-region call handling exists and the home slot is
;; authoritative everywhere outside [lo,hi]. Phi instructions are never
;; remapped (their inputs are read on predecessor EDGES; a block region
;; starts after the leading phis, and a loop region's root is by admission
;; never phi-defined). The minted W assignments join the plan, so the
;; downstream scavenge-interval rebuild sees W's register occupied over
;; exactly the region -- the same soundness net the loop-split rescue uses.
;;
;; SPAN. Block rows sit inside one block; loop rows (P11b) run from their
;; preheader anchor through the loop's last block, so the walk must survive
;; block boundaries: the untouched-block fast path is taken only when nothing
;; is active, and the end-of-block drain drops only rows already past their
;; hi. A loop row is read-only by admission (defs = 0 -> exit-flag = 0), so
;; crossing a region EXIT edge needs no store: the shadow is simply dead
;; there and the root's slot was never stale.
;; ---------------------------------------------------------------------------
(define (compiler-reg-call-region-list-count
  [regions : CompilerRegCallRegionSeq]) : i64
  regions.len)

;; Newest-accepted region first, matching the walk order of the former list.
(define (compiler-reg-call-region-fill-arrays!
  [regions : CompilerRegCallRegionSeq]
  [r-var : (__tl_dyn-array i64)]
  [r-lo : (__tl_dyn-array i64)]
  [r-hi : (__tl_dyn-array i64)]
  [r-entry : (__tl_dyn-array i64)]
  [r-exit : (__tl_dyn-array i64)]
  [i : i64]) : unit
  (let
    [slots : (__tl_dyn-array CompilerRegCallRegion) regions.slots]
    [index : i64 (- regions.len 1)]
    [at : i64 i]
    (while (>= index 0)
      (begin
        (match (array-ref slots index)
          [(CompilerRegCallRegion var lo hi entry-flag exit-flag)
            (begin
              (set! (array-ref r-var at) var)
              (set! (array-ref r-lo at) lo)
              (set! (array-ref r-hi at) hi)
              (set! (array-ref r-entry at) entry-flag)
              (set! (array-ref r-exit at) exit-flag))])
        (set! at (+ at 1))
        (set! index (- index 1))))))

(define (compiler-reg-call-region-sort-swap!
  [arr : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : unit
  (let
    [tmp : i64 (array-ref arr a)]
    (begin
      (set! (array-ref arr a) (array-ref arr b))
      (set! (array-ref arr b) tmp))))

(define (compiler-reg-call-region-sort-by-lo!
  [r-var : (__tl_dyn-array i64)]
  [r-lo : (__tl_dyn-array i64)]
  [r-hi : (__tl_dyn-array i64)]
  [r-entry : (__tl_dyn-array i64)]
  [r-exit : (__tl_dyn-array i64)]
  [count : i64]) : unit
  (let
    [i : i64 1]
    (while (< i count)
      (let
        [j : i64 i]
        (begin
          (while (and (> j 0) (> (array-ref r-lo (- j 1)) (array-ref r-lo j)))
            (begin
              (compiler-reg-call-region-sort-swap! r-var (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-lo (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-hi (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-entry (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-exit (- j 1) j)
              (set! j (- j 1))))
          (set! i (+ i 1)))))))

(define (compiler-reg-call-region-control-flow-instr?
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Jump _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Return _) true]
    [(ir.CompilerIrInstr.Switch _ _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ false]))

;; Exit stores for every active root whose region ends at `point` (emitted
;; only when the region redefined the value and it lives on -- exit-flag).
;; Pushed in increasing `active` order, matching the program order the old
;; reversed-cons accumulator produced after its final flip (refs #5726).
(define (compiler-reg-call-region-exit-stores
  [active : (__tl_dyn-array i64)]
  [active-n : i64]
  [act-hi : (__tl_dyn-array i64)]
  [act-exit : (__tl_dyn-array i64)]
  [act-w : (__tl_dyn-array i64)]
  [point : i64]
  [type-info : CompilerRegVarTypes]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : unit
  (let
    [j : i64 0]
    (while (< j active-n)
      (let
        [root : i64 (array-ref active j)]
        (begin
          (if (and
            (= (array-ref act-hi root) point)
            (= (array-ref act-exit root) 1)
            (>= (array-ref act-w root) 0))
            (ir.compiler-ir-instr-builder-push!
              (&mut builder)
              (ir.CompilerIrInstr.Mov
                root
                (ir.CompilerIrValue.Var (array-ref act-w root))
                (compiler-reg-caller-save-var-type type-info root)))
            unit)
          (set! j (+ j 1)))))))

;; Eviction steps sorted by point, saves before restores when a point carries
;; both (it never does, but the order is the semantically safe one).
(define (compiler-reg-call-evict-fill-arrays!
  [evictions : CompilerRegCallEvictSeq]
  [e-var : (__tl_dyn-array i64)]
  [e-point : (__tl_dyn-array i64)]
  [e-kind : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array CompilerRegCallEvict) evictions.slots]
    [count : i64 evictions.len]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (match (array-ref slots i)
            [(CompilerRegCallEvict var point kind)
              (begin
                (set! (array-ref e-var i) var)
                (set! (array-ref e-point i) point)
                (set! (array-ref e-kind i) kind))])
          (set! i (+ i 1))))
      (set! i 1)
      (while (< i count)
        (let
          [j : i64 i]
          (begin
            (while (and
              (> j 0)
              (or
                (> (array-ref e-point (- j 1)) (array-ref e-point j))
                (and
                  (= (array-ref e-point (- j 1)) (array-ref e-point j))
                  (> (array-ref e-kind (- j 1)) (array-ref e-kind j)))))
              (begin
                (compiler-reg-call-region-sort-swap! e-var (- j 1) j)
                (compiler-reg-call-region-sort-swap! e-point (- j 1) j)
                (compiler-reg-call-region-sort-swap! e-kind (- j 1) j)
                (set! j (- j 1))))
            (set! i (+ i 1))))))))

(define (compiler-reg-caller-save-rewrite-blocks
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (let
    [regions : CompilerRegCallRegionSeq
      (compiler-reg-plan-caller-save-regions plan)]
    [count : i64 (compiler-reg-call-region-list-count regions)]
    (if (= count 0)
      (CompilerRegCallSaveRewrite.Rewrite
        blocks
        vars
        vars
        (compiler-reg-assignment-table-empty)
        (compiler-reg-var-types-empty))
      (let
        [shadow-regs : (__tl_dyn-array i64)
          (compiler-reg-plan-caller-save-regs plan)]
        ;; Parked-occupant save/reload steps (P11b phase 3). Empty for every
        ;; function the free-register search served, which is all but a handful.
        [evictions : CompilerRegCallEvictSeq
          (compiler-reg-plan-caller-save-evictions plan)]
        [e-count : i64 evictions.len]
        [e-var : (__tl_dyn-array i64) (array.make-array i64 (+ e-count 1))]
        [e-point : (__tl_dyn-array i64) (array.make-array i64 (+ e-count 1))]
        [e-kind : (__tl_dyn-array i64) (array.make-array i64 (+ e-count 1))]
        [e-cursor : i64 0]
        ;; victim var -> the slot-homed var minted for its save, -1 = none yet
        [evict-w : (__tl_dyn-array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [r-var : (__tl_dyn-array i64) (array.make-array i64 count)]
        [r-lo : (__tl_dyn-array i64) (array.make-array i64 count)]
        [r-hi : (__tl_dyn-array i64) (array.make-array i64 count)]
        [r-entry : (__tl_dyn-array i64) (array.make-array i64 count)]
        [r-exit : (__tl_dyn-array i64) (array.make-array i64 count)]
        [remap : (__tl_dyn-array i64) (compiler-reg-caller-save-remap vars)]
        [act-w : (__tl_dyn-array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [act-hi : (__tl_dyn-array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [act-exit : (__tl_dyn-array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [active : (__tl_dyn-array i64) (array.make-array i64 (+ count 1))]
        [active-n : i64 0]
        [next-var : i64 vars]
        [extra-assignments : CompilerRegAssignmentTable
          (compiler-reg-assignment-table-empty)]
        [extra-types : CompilerRegVarTypes (compiler-reg-var-types-empty)]
        [cursor : i64 0]
        [point : i64 0]
        [seq : ir.CompilerIrBlockSeq
          (live.compiler-live-ir-block-list-to-seq blocks)]
        [bslots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
        [nblocks : i64 seq.len]
        [out-rev : ir.CompilerIrBlockList ir.CompilerIrBlockList.Nil]
        [b : i64 0]
        (begin
          (compiler-reg-call-region-fill-arrays!
            regions
            r-var
            r-lo
            r-hi
            r-entry
            r-exit
            0)
          (compiler-reg-call-region-sort-by-lo!
            r-var
            r-lo
            r-hi
            r-entry
            r-exit
            count)
          (compiler-reg-call-evict-fill-arrays! evictions e-var e-point e-kind)
          (compiler-reg-fill-i64-array act-w (- 0 1))
          (compiler-reg-fill-i64-array evict-w (- 0 1))
          ;; Mint each victim's slot var UP FRONT. A reload can sit at a point
          ;; earlier in layout than its save (the save follows the victim's
          ;; definition, and a loop may exit backwards into an enclosing body),
          ;; so the var has to exist before the walk, not at the save's turn.
          (let
            [ei : i64 0]
            (while (< ei e-count)
              (let
                [victim : i64 (array-ref e-var ei)]
                (begin
                  (when
                    (and
                      (=
                        (array-ref e-kind ei)
                        (compiler-reg-call-evict-kind-save))
                      (>= victim 0)
                      (< victim (array-length evict-w))
                      (< (array-ref evict-w victim) 0))
                    (let
                      [w : i64 next-var]
                      (begin
                        (set! next-var (+ next-var 1))
                        (set! (array-ref evict-w victim) w)
                        (set!
                          extra-assignments
                          (compiler-reg-assignments-prepend
                            (CompilerRegAssignment
                              w
                              (CompilerRegLocation.Spill
                                (compiler-reg-stack-slot-offset w)))
                            extra-assignments))
                        (set!
                          extra-types
                          (compiler-reg-var-types-insert
                            extra-types
                            w
                            (compiler-reg-caller-save-var-type type-info victim))))))
                  (set! ei (+ ei 1))))))
          (while (< b nblocks)
            (begin
              (match (array-ref bslots b)
                [(ir.CompilerIrBlock.Block label instrs)
                  (let
                    [ilen : i64 (ir.compiler-ir-instr-seq-count instrs)]
                    [span : i64 (* 2 ilen)]
                    (if (and
                      (= active-n 0)
                      (or
                        (>= cursor count)
                        (>= (array-ref r-lo cursor) (+ point span)))
                      ;; ... and no eviction step lands in this block either:
                      ;; a reload target is a block the region walk otherwise
                      ;; has no reason to open
                      (or
                        (>= e-cursor e-count)
                        (>= (array-ref e-point e-cursor) (+ point span))))
                      ;; nothing active from an earlier block and no region
                      ;; starts here -> keep the block untouched
                      (begin
                        (set!
                          out-rev
                          (ir.compiler-ir-block-cons
                            (ir.CompilerIrBlock.Block label instrs)
                            out-rev))
                        (set! point (+ point span)))
                      (let
                        [islots : (__tl_dyn-array ir.CompilerIrInstr)
                          instrs.slots]
                        [i : i64 0]
                        ;; Forward scan into a builder, interleaving
                        ;; region-entry movs and control-flow exit stores in
                        ;; program order. The old shape built a REVERSED cons
                        ;; accumulator and flipped it with
                        ;; `compiler-ir-instr-list-reverse-onto`; the forward
                        ;; scan emits the same final order with no list at all
                        ;; (refs #5726). Seeded at the block's own length:
                        ;; caller-save only ever appends those movs/stores.
                        [builder : ir.CompilerIrInstrBuilder
                          (ir.compiler-ir-instr-builder-with-capacity ilen)]
                        (begin
                          (while (< i ilen)
                            (let
                              [instr : ir.CompilerIrInstr (array-ref islots i)]
                              (begin
                                ;; defensive: drop any region whose lo was
                                ;; passed without matching (must not happen)
                                (while (and
                                  (< cursor count)
                                  (< (array-ref r-lo cursor) point))
                                  (set! cursor (+ cursor 1)))
                                (while (and
                                  (< e-cursor e-count)
                                  (< (array-ref e-point e-cursor) point))
                                  (set! e-cursor (+ e-cursor 1)))
                                ;; Parked-occupant save/reload steps, emitted
                                ;; BEFORE the activations below: at the anchor
                                ;; the victim's store has to read its register
                                ;; while it still holds the victim, and the
                                ;; shadow load is exactly what overwrites it.
                                (while (and
                                  (< e-cursor e-count)
                                  (= (array-ref e-point e-cursor) point))
                                  (let
                                    [victim : i64 (array-ref e-var e-cursor)]
                                    (begin
                                      (when
                                        (and
                                          (>= victim 0)
                                          (< victim (array-length evict-w))
                                          (>= (array-ref evict-w victim) 0))
                                        (if (=
                                          (array-ref e-kind e-cursor)
                                          (compiler-reg-call-evict-kind-save))
                                          (ir.compiler-ir-instr-builder-push!
                                            (&mut builder)
                                            (ir.CompilerIrInstr.Mov
                                              (array-ref evict-w victim)
                                              (ir.CompilerIrValue.Var victim)
                                              (compiler-reg-caller-save-var-type
                                                type-info
                                                victim)))
                                          (ir.compiler-ir-instr-builder-push!
                                            (&mut builder)
                                            (ir.CompilerIrInstr.Mov
                                              victim
                                              (ir.CompilerIrValue.Var
                                                (array-ref evict-w victim))
                                              (compiler-reg-caller-save-var-type
                                                type-info
                                                victim)))))
                                      (set! e-cursor (+ e-cursor 1)))))
                                ;; activations at this point
                                (while (and
                                  (< cursor count)
                                  (= (array-ref r-lo cursor) point))
                                  (let
                                    [root : i64 (array-ref r-var cursor)]
                                    [w : i64 next-var]
                                    [reg : i64
                                      (if (and
                                        (>= root 0)
                                        (< root (array-length shadow-regs)))
                                        (array-ref shadow-regs root)
                                        cabi.compiler-reg-id-invalid)]
                                    [ty : ast.AstType
                                      (compiler-reg-caller-save-var-type
                                        type-info
                                        root)]
                                    (begin
                                      (if (or
                                        (= reg cabi.compiler-reg-id-invalid)
                                        (>= (array-ref act-w root) 0))
                                        ;; defensive decline: no register or
                                        ;; already active
                                        unit
                                        (begin
                                          (set! next-var (+ next-var 1))
                                          (set!
                                            extra-assignments
                                            (compiler-reg-assignments-prepend
                                              (CompilerRegAssignment
                                                w
                                                (CompilerRegLocation.Register
                                                  reg))
                                              extra-assignments))
                                          (set!
                                            extra-types
                                            (compiler-reg-var-types-insert
                                              extra-types
                                              w
                                              ty))
                                          (if (= (array-ref r-entry cursor) 1)
                                            (ir.compiler-ir-instr-builder-push!
                                              (&mut builder)
                                              (ir.CompilerIrInstr.Mov
                                                w
                                                (ir.CompilerIrValue.Var root)
                                                ty))
                                            unit)
                                          (set! (array-ref act-w root) w)
                                          (set!
                                            (array-ref act-hi root)
                                            (array-ref r-hi cursor))
                                          (set!
                                            (array-ref act-exit root)
                                            (array-ref r-exit cursor))
                                          (set! (array-ref remap root) w)
                                          (set!
                                            (array-ref active active-n)
                                            root)
                                          (set! active-n (+ active-n 1))))
                                      (set! cursor (+ cursor 1)))))
                                (let
                                  [out-instr : ir.CompilerIrInstr
                                    (if (> active-n 0)
                                      (match instr
                                        [(ir.CompilerIrInstr.Phi _ _ _) instr]
                                        [_
                                          (compiler-reg-remap-instr remap instr)])
                                      instr)]
                                  [cf : bool
                                    (compiler-reg-call-region-control-flow-instr?
                                      instr)]
                                  (begin
                                    (if cf
                                      (begin
                                        (compiler-reg-call-region-exit-stores
                                          active
                                          active-n
                                          act-hi
                                          act-exit
                                          act-w
                                          point
                                          type-info
                                          (&mut builder))
                                        (ir.compiler-ir-instr-builder-push!
                                          (&mut builder)
                                          out-instr))
                                      (begin
                                        (ir.compiler-ir-instr-builder-push!
                                          (&mut builder)
                                          out-instr)
                                        (compiler-reg-call-region-exit-stores
                                          active
                                          active-n
                                          act-hi
                                          act-exit
                                          act-w
                                          point
                                          type-info
                                          (&mut builder))))
                                    ;; deactivate the regions ending here
                                    (let
                                      [j : i64 0]
                                      (while (< j active-n)
                                        (let
                                          [root : i64 (array-ref active j)]
                                          (if (= (array-ref act-hi root) point)
                                            (begin
                                              (set! (array-ref remap root) root)
                                              (set!
                                                (array-ref act-w root)
                                                (- 0 1))
                                              (set! active-n (- active-n 1))
                                              (set!
                                                (array-ref active j)
                                                (array-ref active active-n)))
                                            (set! j (+ j 1))))))))
                                (set! point (+ point 2))
                                (set! i (+ i 1)))))
                          ;; Defensive drain. A loop row deliberately outlives
                          ;; its first block -- the back edge is INSIDE the
                          ;; span, which is where its win comes from -- so the
                          ;; drain can no longer be unconditional. It now drops
                          ;; only rows whose hi was walked past without the
                          ;; per-instruction deactivation firing (must not
                          ;; happen); a row with hi still ahead stays active
                          ;; into the next block.
                          (let
                            [j : i64 0]
                            (while (< j active-n)
                              (let
                                [root : i64 (array-ref active j)]
                                (if (< (array-ref act-hi root) point)
                                  (begin
                                    (set! (array-ref remap root) root)
                                    (set! (array-ref act-w root) (- 0 1))
                                    (set! active-n (- active-n 1))
                                    (set!
                                      (array-ref active j)
                                      (array-ref active active-n)))
                                  (set! j (+ j 1))))))
                          (set!
                            out-rev
                            (ir.compiler-ir-block-cons
                              (ir.CompilerIrBlock.Block
                                label
                                (ir.compiler-ir-instr-builder-to-seq builder))
                              out-rev))))))])
              (set! b (+ b 1))))
          (CompilerRegCallSaveRewrite.Rewrite
            (ir.compiler-ir-block-list-reverse-onto
              out-rev
              ir.CompilerIrBlockList.Nil)
            vars
            next-var
            extra-assignments
            extra-types))))))

(define (compiler-reg-remat-table-record-def!
  [table : CompilerRegRematTable]
  [instr : ir.CompilerIrInstr]
  [allow-invariant-loads : bool]) : unit
  (let
    [def-counts : (__tl_dyn-array i64) table.def-counts]
    [candidates : (__tl_dyn-array i64) table.candidates]
    [kinds : (__tl_dyn-array i64) table.kinds]
    [values : (__tl_dyn-array ir.CompilerIrValue) table.values]
    [offsets : (__tl_dyn-array ir.CompilerIrValue) table.offsets]
    [op-types : (__tl_dyn-array ast.AstType) table.op-types]
    [types : (__tl_dyn-array ast.AstType) table.types]
    (begin
      (compiler-reg-ref-counts-add-var-weighted!
        def-counts
        (compiler-reg-instr-def-var instr)
        1)
      (match instr
        [(ir.CompilerIrInstr.Mov dst value ty)
          (if (and
            (compiler-reg-remat-mov-value? value allow-invariant-loads)
            (>= dst 0)
            (< dst (array-length candidates))
            (not (= (array-ref candidates dst) 2)))
            (begin
              (set! (array-ref candidates dst) 1)
              (set! (array-ref kinds dst) (compiler-reg-remat-kind-mov))
              (set! (array-ref values dst) value)
              (set! (array-ref op-types dst) ty)
              (set! (array-ref types dst) ty))
            unit)]
        [(ir.CompilerIrInstr.Gep dst base offset ty)
          (if (and
            (compiler-reg-remat-gep? base offset)
            (>= dst 0)
            (< dst (array-length candidates))
            (not (= (array-ref candidates dst) 2)))
            (begin
              (set! (array-ref candidates dst) 1)
              (set! (array-ref kinds dst) (compiler-reg-remat-kind-gep))
              (set! (array-ref values dst) base)
              (set! (array-ref offsets dst) offset)
              (set! (array-ref op-types dst) ty)
              (set! (array-ref types dst) (compiler-reg-addr-of-result-type)))
            unit)]
        [(ir.CompilerIrInstr.Load dst src ty)
          (if (and
            (compiler-reg-remat-load? src allow-invariant-loads)
            (>= dst 0)
            (< dst (array-length candidates))
            (not (= (array-ref candidates dst) 2)))
            (begin
              (set! (array-ref candidates dst) 1)
              (set! (array-ref kinds dst) (compiler-reg-remat-kind-load))
              (set! (array-ref values dst) src)
              (set! (array-ref op-types dst) ty)
              (set! (array-ref types dst) ty))
            unit)]
        [(ir.CompilerIrInstr.AddrOf _ src)
          ;; Address-taken values need stable storage. Mark the source as
          ;; poisoned so the use-site remat rewrite cannot replace it with a
          ;; freshly materialized temporary.
          (if (and (>= src 0) (< src (array-length candidates)))
            (begin
              (set! (array-ref candidates src) 2)
              unit)
            unit)]
        [_ unit]))))

(define (compiler-reg-remat-table-record-instrs!
  [table : CompilerRegRematTable]
  [instrs : ir.CompilerIrInstrSeq]
  [allow-invariant-loads : bool]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-remat-table-record-def!
          table
          (array-ref slots index)
          allow-invariant-loads)
        (set! index (+ index 1))))))

(define (compiler-reg-remat-table-record-blocks!
  [table : CompilerRegRematTable]
  [blocks : ir.CompilerIrBlockList]
  [allow-invariant-loads : bool]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-remat-table-record-instrs!
              table
              instrs
              allow-invariant-loads)])
        (compiler-reg-remat-table-record-blocks!
          table
          (__tl-box-place rest)
          allow-invariant-loads))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-remat-table-record-instrs!
                  table
                  instrs
                  allow-invariant-loads)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-remat-table-build [func : ir.CompilerIrFunction]) : CompilerRegRematTable
  (match func
    [(ir.CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [def-counts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [candidates : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [kinds : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [values : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue vars)]
        [offsets : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue vars)]
        [op-types : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType vars)]
        [types : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType vars)]
        [allow-invariant-loads : bool
          (compiler-reg-remat-invariant-loads-ok? func)]
        [table : CompilerRegRematTable
          (CompilerRegRematTable
            def-counts
            candidates
            kinds
            values
            offsets
            op-types
            types)]
        (begin
          (compiler-reg-fill-i64-array def-counts 0)
          (compiler-reg-fill-i64-array candidates 0)
          (compiler-reg-fill-i64-array kinds 0)
          ;; Parameters are an implicit definition at function entry (their
          ;; incoming value). Count them so a param that is ALSO written by a
          ;; single in-body `mov` (e.g. a tail-recursion-to-loop back edge that
          ;; assigns a constant, `param <- #false`) is NOT mistaken for a
          ;; single-def rematerialisable var: rematerialising it would recompute
          ;; the constant at the loop-header use and silently drop the
          ;; first-iteration incoming argument value.
          (compiler-reg-param-count-defs! params def-counts)
          (compiler-reg-remat-table-record-blocks!
            table
            blocks
            allow-invariant-loads)
          table))]))

(define (compiler-reg-remat-var-spilled?
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Spill _) true]
        [_ false])]
    [(CompilerRegMaybeLocation.No) true]))

(define (compiler-reg-remat-table-eligible?
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentTable]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [var : i64]) : bool
  (let
    [def-counts : (__tl_dyn-array i64) table.def-counts]
    [candidates : (__tl_dyn-array i64) table.candidates]
    (and
      (>= var 0)
      (< var (array-length def-counts))
      (= (array-ref def-counts var) 1)
      (= (array-ref candidates var) 1)
      (compiler-reg-remat-var-spilled? assignments var)
      (not (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)))))

(define (compiler-reg-remat-registers-for-type [ty : ast.AstType]) : CompilerRegIdSeq
  (if (compiler-reg-float-type? ty)
    (compiler-reg-xmm-registers)
    (if (compiler-reg-register-eligible-type? ty)
      (compiler-reg-id-seq-prepend
        cabi.compiler-reg-id-r9
        (compiler-reg-id-seq-empty))
      (compiler-reg-id-seq-empty))))

(define (compiler-reg-remat-interval-active-at?
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [point : i64]) : bool
  (match (compiler-reg-interval-index-lookup intervals var)
    [(CompilerRegMaybeInterval.Some interval)
      (and (<= interval.start point) (<= point interval.end))]
    [(CompilerRegMaybeInterval.No) false]))

(define (compiler-reg-remat-location-conflicts-at?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [point : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [var : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< var (array-length present)) (not conflict))
        (begin
          (if (and
            (not (= (array-ref present var) 0))
            (compiler-reg-location-overlaps? (array-ref items var) location)
            (compiler-reg-remat-interval-active-at? intervals var point))
            (set! conflict true)
            unit)
          (set! var (+ var 1))))
      conflict)))

(define (compiler-reg-remat-first-free-register-at
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [point : i64]
  [chosen : CompilerRegIdSeq]) : CompilerRegMaybeId
  (let
    [index : i64 0]
    [result : CompilerRegMaybeId CompilerRegMaybeId.No]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (if (and
            (not (compiler-reg-id-seq-contains? chosen reg))
            (not
              (compiler-reg-remat-location-conflicts-at?
                assignments
                intervals
                point
                (CompilerRegLocation.Register reg))))
            (begin
              (set! result (CompilerRegMaybeId.Some reg))
              (set! done true))
            (set! index (+ index 1)))))
      result)))

(define (compiler-reg-remat-selected-register
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [point : i64]
  [chosen : CompilerRegIdSeq]
  [var : i64]) : CompilerRegMaybeId
  (let
    [types : (__tl_dyn-array ast.AstType) table.types]
    (if (or (< var 0) (>= var (array-length types)))
      CompilerRegMaybeId.No
      (compiler-reg-remat-first-free-register-at
        (compiler-reg-remat-registers-for-type (array-ref types var))
        assignments
        intervals
        point
        chosen))))

(define (compiler-reg-remat-instr
  [table : CompilerRegRematTable]
  [temp : i64]
  [var : i64]) : ir.CompilerIrInstr
  (let
    [kinds : (__tl_dyn-array i64) table.kinds]
    [values : (__tl_dyn-array ir.CompilerIrValue) table.values]
    [offsets : (__tl_dyn-array ir.CompilerIrValue) table.offsets]
    [op-types : (__tl_dyn-array ast.AstType) table.op-types]
    [types : (__tl_dyn-array ast.AstType) table.types]
    [ty : ast.AstType (array-ref types var)]
    [value : ir.CompilerIrValue (array-ref values var)]
    (cond
      [(= (array-ref kinds var) (compiler-reg-remat-kind-load))
        (ir.CompilerIrInstr.Load temp value ty)]
      [(= (array-ref kinds var) (compiler-reg-remat-kind-gep))
        (ir.CompilerIrInstr.Gep
          temp
          value
          (array-ref offsets var)
          (array-ref op-types var))]
      [else (ir.CompilerIrInstr.Mov temp value ty)])))

(define (compiler-reg-remat-use-site-ok? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Phi _ _ _) false]
    ;; Remat temps are assigned to caller-clobbered homes for a single expanded
    ;; instruction. Avoid instructions whose backend expansion may clobber those
    ;; homes before every operand has been consumed.
    [_ (not (compiler-reg-backend-caller-clobber-instr? instr))]))

;; Reset the entries of a shared, function-scoped identity remap array that a
;; single instruction touched. Only the vars in `uses` (the instruction's
;; operands) could have been overwritten, so restoring identity for those bits
;; returns the array to "no-remap" for the next instruction without an
;; O(vars) rescan/zero. Set bits at ids >= vars are skipped, matching the old
;; ascending `(while (< var vars) ...)` loop which never visited them.
(define (compiler-reg-remat-reset-remap-uses!
  [remap : (__tl_dyn-array i64)]
  [uses : live.CompilerLiveI64Set]
  [vars : i64]) : unit
  (let
    [word-index : i64 0]
    [word-count : i64 (live.compiler-live-set-word-count uses)]
    (while (< word-index word-count)
      (let
        [bits : i64 (live.compiler-live-set-word-at-bounded uses word-index)]
        [base : i64 (* word-index (live.compiler-live-set-word-bits))]
        [bit : i64 0]
        (begin
          (while (not (= bits 0))
            (begin
              (if (not (= (bit-and bits 1) 0))
                (let
                  [var : i64 (+ base bit)]
                  (if (< var vars)
                    (set! (array-ref remap var) var)
                    unit))
                unit)
              (set! bits (shr bits 1))
              (set! bit (+ bit 1))))
          (set! word-index (+ word-index 1)))))))

(define (compiler-reg-remat-rewrite-one-instr
  [instr : ir.CompilerIrInstr]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentTable]
  [extra-types : CompilerRegVarTypes]
  [remap : (__tl_dyn-array i64)]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : CompilerRegCallSaveInstrRewrite
  (if (compiler-reg-remat-use-site-ok? instr)
    (let
      ;; `uses` is the (1-3 var) operand bitset for THIS instruction. Iterate
      ;; only its set bits in ascending order instead of scanning all `vars`,
      ;; which is byte-identical to the old loop (which also only ran the body
      ;; for set bits in ascending order) but avoids the per-instruction
      ;; O(vars) scan + array zero. `remap` is a function-scoped identity array
      ;; reused across instructions; we restore the bits we set afterwards.
      [uses : live.CompilerLiveI64Set (live.compiler-live-instr-uses instr)]
      [types : (__tl_dyn-array ast.AstType) table.types]
      [chosen : CompilerRegIdSeq (compiler-reg-id-seq-empty)]
      [out-next-var : i64 next-var]
      [out-extra-assignments : CompilerRegAssignmentTable extra-assignments]
      [out-extra-types : CompilerRegVarTypes extra-types]
      [word-index : i64 0]
      [word-count : i64 (live.compiler-live-set-word-count uses)]
      (begin
        (while (< word-index word-count)
          (let
            [bits : i64
              (live.compiler-live-set-word-at-bounded uses word-index)]
            [base : i64 (* word-index (live.compiler-live-set-word-bits))]
            [bit : i64 0]
            (begin
              (while (not (= bits 0))
                (begin
                  (if (not (= (bit-and bits 1) 0))
                    (let
                      [var : i64 (+ base bit)]
                      (if (and
                        (< var vars)
                        (compiler-reg-remat-table-eligible?
                          table
                          assignments
                          parents
                          merged-roots
                          var))
                        (match (compiler-reg-remat-selected-register
                          table
                          assignments
                          intervals
                          point
                          chosen
                          var)
                          [(CompilerRegMaybeId.Some reg)
                            (let
                              [temp : i64 out-next-var]
                              [ty : ast.AstType (array-ref types var)]
                              (begin
                                (set! (array-ref remap var) temp)
                                ;; Recipes for one instruction are pushed in
                                ;; the order they are chosen (ascending operand
                                ;; var). That is exactly the order the old
                                ;; reverse-consed `prefix` produced once the
                                ;; reversed accumulator was flipped at the end.
                                (ir.compiler-ir-instr-builder-push!
                                  (&mut builder)
                                  (compiler-reg-remat-instr table temp var))
                                (set!
                                  chosen
                                  (compiler-reg-id-seq-prepend reg chosen))
                                (set!
                                  out-extra-assignments
                                  (compiler-reg-assignments-prepend
                                    (CompilerRegAssignment
                                      temp
                                      (CompilerRegLocation.Register reg))
                                    out-extra-assignments))
                                (set!
                                  out-extra-types
                                  (compiler-reg-var-types-insert
                                    out-extra-types
                                    temp
                                    ty))
                                (set! out-next-var (+ out-next-var 1))))]
                          [(CompilerRegMaybeId.No) unit])
                        unit))
                    unit)
                  (set! bits (shr bits 1))
                  (set! bit (+ bit 1))))
              (set! word-index (+ word-index 1)))))
        (if (= out-next-var next-var)
          (begin
            (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
            (CompilerRegCallSaveInstrRewrite.Rewrite
              (+ point 2)
              out-next-var
              out-extra-assignments
              out-extra-types))
          (let
            [rewritten : ir.CompilerIrInstr
              (compiler-reg-remap-instr remap instr)]
            (begin
              ;; Restore the shared remap array to identity for the next instr.
              (compiler-reg-remat-reset-remap-uses! remap uses vars)
              (ir.compiler-ir-instr-builder-push! (&mut builder) rewritten)
              (CompilerRegCallSaveInstrRewrite.Rewrite
                (+ point 2)
                out-next-var
                out-extra-assignments
                out-extra-types))))))
    (begin
      (ir.compiler-ir-instr-builder-push! (&mut builder) instr)
      (CompilerRegCallSaveInstrRewrite.Rewrite
        (+ point 2)
        next-var
        extra-assignments
        extra-types))))

;; Scan one block's instructions forward, appending each rewritten instruction
;; (preceded by the remat recipes it needs) to the caller's builder. The old
;; shape converted the block to a cons list, walked it building a REVERSED cons
;; accumulator, and flipped it with `compiler-ir-instr-list-reverse-onto`; the
;; forward scan emits in the same final order with no list at all.
(define (compiler-reg-remat-rewrite-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentTable]
  [extra-types : CompilerRegVarTypes]
  [remap : (__tl_dyn-array i64)]
  [builder : (&mut builder ir.CompilerIrInstrBuilder)]) : CompilerRegCallSaveInstrRewrite
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [out-point : i64 point]
    [out-next-var : i64 next-var]
    [out-extra-assignments : CompilerRegAssignmentTable extra-assignments]
    [out-extra-types : CompilerRegVarTypes extra-types]
    (begin
      (while (< index count)
        (begin
          (match (compiler-reg-remat-rewrite-one-instr
            (ir.compiler-ir-instr-seq-ref instrs index)
            out-point
            vars
            out-next-var
            table
            assignments
            intervals
            parents
            merged-roots
            out-extra-assignments
            out-extra-types
            remap
            (&mut builder))
            [(CompilerRegCallSaveInstrRewrite.Rewrite
                point2
                next-var2
                extra-assignments2
                extra-types2)
              (begin
                (set! out-point point2)
                (set! out-next-var next-var2)
                (set! out-extra-assignments extra-assignments2)
                (set! out-extra-types extra-types2))])
          (set! index (+ index 1))))
      (CompilerRegCallSaveInstrRewrite.Rewrite
        out-point
        out-next-var
        out-extra-assignments
        out-extra-types))))

(define (compiler-reg-remat-rewrite-blocks-rev
  [blocks : ir.CompilerIrBlockList]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentTable]
  [extra-types : CompilerRegVarTypes]
  [remap : (__tl_dyn-array i64)]
  [acc : ir.CompilerIrBlockList]) : CompilerRegCallSaveRewrite
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (CompilerRegCallSaveRewrite.Rewrite
        acc
        point
        next-var
        extra-assignments
        extra-types)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            ;; Seeded at the block's own length: remat only ever appends recipe
            ;; instructions, and the (majority) blocks with no eligible operand
            ;; land exactly on this capacity with no grow.
            [builder : ir.CompilerIrInstrBuilder
              (ir.compiler-ir-instr-builder-with-capacity
                (ir.compiler-ir-instr-seq-count instrs))]
            (match (compiler-reg-remat-rewrite-instrs
              instrs
              point
              vars
              next-var
              table
              assignments
              intervals
              parents
              merged-roots
              extra-assignments
              extra-types
              remap
              (&mut builder))
              [(CompilerRegCallSaveInstrRewrite.Rewrite
                  next-point
                  next-var2
                  extra-assignments2
                  extra-types2)
                (compiler-reg-remat-rewrite-blocks-rev
                  (__tl-box-place rest)
                  next-point
                  vars
                  next-var2
                  table
                  assignments
                  intervals
                  parents
                  merged-roots
                  extra-assignments2
                  extra-types2
                  remap
                  (ir.compiler-ir-block-cons
                    (ir.CompilerIrBlock.Block
                      label
                      (ir.compiler-ir-instr-builder-to-seq builder))
                    acc))]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-remat-rewrite-block-seq-rev
        seq
        point
        vars
        next-var
        table
        assignments
        intervals
        parents
        merged-roots
        extra-assignments
        extra-types
        remap
        acc)]))

(define (compiler-reg-remat-rewrite-block-seq-rev
  [seq : ir.CompilerIrBlockSeq]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentTable]
  [extra-types : CompilerRegVarTypes]
  [remap : (__tl_dyn-array i64)]
  [acc : ir.CompilerIrBlockList]) : CompilerRegCallSaveRewrite
  (let
    [i : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count seq)]
    [out-point : i64 point]
    [out-next-var : i64 next-var]
    [out-extra-assignments : CompilerRegAssignmentTable extra-assignments]
    [out-extra-types : CompilerRegVarTypes extra-types]
    [out-acc : ir.CompilerIrBlockList acc]
    (begin
      (while (< i count)
        (begin
          (match (ir.compiler-ir-block-seq-ref seq i)
            [(ir.CompilerIrBlock.Block label instrs)
              (let
                [builder : ir.CompilerIrInstrBuilder
                  (ir.compiler-ir-instr-builder-with-capacity
                    (ir.compiler-ir-instr-seq-count instrs))]
                (match (compiler-reg-remat-rewrite-instrs
                  instrs
                  out-point
                  vars
                  out-next-var
                  table
                  assignments
                  intervals
                  parents
                  merged-roots
                  out-extra-assignments
                  out-extra-types
                  remap
                  (&mut builder))
                  [(CompilerRegCallSaveInstrRewrite.Rewrite
                      next-point
                      next-var2
                      extra-assignments2
                      extra-types2)
                    (begin
                      (set! out-point next-point)
                      (set! out-next-var next-var2)
                      (set! out-extra-assignments extra-assignments2)
                      (set! out-extra-types extra-types2)
                      (set!
                        out-acc
                        (ir.compiler-ir-block-cons
                          (ir.CompilerIrBlock.Block
                            label
                            (ir.compiler-ir-instr-builder-to-seq builder))
                          out-acc)))]))])
          (set! i (+ i 1))))
      (CompilerRegCallSaveRewrite.Rewrite
        out-acc
        out-point
        out-next-var
        out-extra-assignments
        out-extra-types))))

;; Remat replaces spilled cheap-recompute defs with recompute-at-use homes;
;; with no Spill assignment in the plan there is nothing to rescue, so skip
;; the remat table, liveness fixpoint, interval selection, and coalesce map
;; for the (majority) spill-free functions.
(define (compiler-reg-assignments-have-spill?
  [assignments : CompilerRegAssignmentTable]) : bool
  (compiler-reg-assignment-table-has-spill? assignments))

(define (compiler-reg-remat-rewrite-blocks
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (if (not
    (compiler-reg-assignments-have-spill? (compiler-reg-plan-assignments plan)))
    (CompilerRegCallSaveRewrite.Rewrite
      blocks
      vars
      vars
      (compiler-reg-assignment-table-empty)
      (compiler-reg-var-types-empty))
    (let
      [table : CompilerRegRematTable (compiler-reg-remat-table-build func)]
      [group-vars : live.CompilerLiveI64Set
        (compiler-reg-function-group-vars type-segment-bases func type-info)]
      [liveness-handle : CompilerRegLivenessHandle
        (compiler-reg-liveness-handle-make func false)]
      [liveness : live.CompilerFunctionLiveness liveness-handle.baseline]
      (match (compiler-reg-live-interval-selection func liveness)
        [(CompilerRegIntervalSelection.Selection intervals interval-index)
          (let
            [coalesce : CompilerRegCoalesceMap
              (compiler-reg-coalesce-map-build
                (compiler-reg-function-moves func false)
                interval-index
                type-info
                group-vars
                vars
                (array.make-array i64 0))]
            [parents : (__tl_dyn-array i64) coalesce.parents]
            [merged-roots : live.CompilerLiveI64Set
              (compiler-reg-coalesce-merged-root-set coalesce)]
            ;; One function-scoped identity remap array, reused across every
            ;; instruction. Each rewritten instruction restores the few bits it
            ;; touches (see compiler-reg-remat-reset-remap-uses!), replacing the
            ;; old per-instruction O(vars) allocation + zero + identity fill.
            [remap : (__tl_dyn-array i64) (compiler-reg-caller-save-remap vars)]
            (match (compiler-reg-remat-rewrite-blocks-rev
              blocks
              0
              vars
              vars
              table
              (compiler-reg-plan-assignments plan)
              interval-index
              parents
              merged-roots
              (compiler-reg-assignment-table-empty)
              (compiler-reg-var-types-empty)
              remap
              ir.CompilerIrBlockList.Nil)
              [(CompilerRegCallSaveRewrite.Rewrite
                  rev
                  _
                  out-vars
                  extra-assignments
                  extra-types)
                (CompilerRegCallSaveRewrite.Rewrite
                  (ir.compiler-ir-block-list-reverse-onto
                    rev
                    ir.CompilerIrBlockList.Nil)
                  vars
                  out-vars
                  extra-assignments
                  extra-types)]))]))))

(define (compiler-reg-location-register?
  [maybe-location : CompilerRegMaybeLocation]
  [reg : i64]) : bool
  (match maybe-location
    [(CompilerRegMaybeLocation.Some location)
      (compiler-reg-location-uses-register? location reg)]
    [_ false]))