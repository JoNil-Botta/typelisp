;; compiler_regalloc.tl - Planning-only scalar register allocation.
;;
;; This pass mirrors the legacy backend's planning shape without changing
;; assembly emission. It computes inspectable live intervals, ineligible vars,
;; and register/spill homes for scalar IR values. The selfhost pools keep
;; %rsp/%rbp reserved and admit caller-saved integer/XMM registers only for
;; values that cannot be clobbered by call emission.
(import stdlib.io)
(import stdlib.array)
(import stdlib.string)
(import stdlib.hashmap)
(import (hashmap.hashmap String i64) as reg_string_i64_map)

;; Block labels are interned ids, so their maps are integer-keyed (refs #5718).
(import (hashmap.hashmap i64 i64) as reg_label_i64_map)
(import (hashmap.hashmap i64 i64) as reg_i64_i64_map)
(import "compiler_abi.tl")
(import "compiler_liveness.tl")
(import compiler_parallel_move as pmove)
(cfg test (import stdlib.test))

(defenum CompilerRegIdList
  (Nil)
  (Cons i64 (Box CompilerRegIdList)))

;; Block labels are interned ids, so they need their own list rather than
;; sharing the register-name list (refs #5718).
(defenum CompilerRegLabelList
  (Nil)
  (Cons i64 (Box CompilerRegLabelList)))

;; Width is an instruction property, not a physical-register identity. Scalar
;; XMM and width-neutral vector homes have distinct compact IDs so emission
;; retains the required class; their ownership IDs collapse onto the same
;; hardware family for interference.
(defenum CompilerRegLocation
  (Register i64)
  ;; A 2-word register-group value lives in two GP registers (word0,
  ;; word1). A group that cannot get two registers spills to a 16-byte slot,
  ;; represented as the ordinary CompilerRegLocation.Spill (the backend reads the second
  ;; word at offset-8 using the program word-count map).
  (RegisterPair i64 i64)
  (Spill i64)
  ;; Rematerialization: a single-def value whose definition is a cheap static
  ;; recompute (a constant or an address materialization `leaq label(%rip)`) is
  ;; not spilled to a slot under pressure -- it is RECOMPUTED at each use and its
  ;; defining store is dropped. The carried IrValue is exactly what the def Mov
  ;; produced, so recomputing always yields the identical value.
  (Remat CompilerIrValue))

(defenum CompilerRegMaybeLocation
  (No)
  (Some CompilerRegLocation))

(defenum CompilerRegMaybeId
  (No)
  (Some i64))

(defstruct CompilerRegAssignment
  (var i64)
  (location CompilerRegLocation))

(defenum CompilerRegAssignmentList
  (Nil)
  (Cons CompilerRegAssignment (Box CompilerRegAssignmentList)))

(defstruct CompilerRegInterval
  (var i64)
  (start i64)
  (end i64))

;; Dense interval storage. The live logical sequence is the contiguous
;; `slots[0 .. len)` prefix, in exactly the order consumers observe. Hot
;; producers append into geometric capacity; the cold prepend helper preserves
;; fixture/worklist order by shifting the live prefix. Per-variable segment
;; sequences in CompilerRegIntervalIndex are sorted by ascending start.
(defstruct CompilerRegIntervalSeq
  (slots (Array CompilerRegInterval))
  (len i64))

(defenum CompilerRegMaybeInterval
  (No)
  (Some CompilerRegInterval))

(defstruct CompilerRegVarType
  (var i64)
  (ty AstType))

;; The per-function var-type view is a pair of var-id-indexed arrays. The `Array`
;; arm below lets it BE a var-type list, so the whole-function view costs one
;; struct rather than one cons cell per live variable, and every lookup through
;; it is an index rather than a walk of the ascending-id list.
(defstruct CompilerRegVarTypes
  (present (Array i64))
  (items (Array AstType)))

(defenum CompilerRegVarTypeList
  (Nil)
  (Cons CompilerRegVarType (Box CompilerRegVarTypeList))
  (Array CompilerRegVarTypes))

(defenum CompilerRegMaybeType
  (No)
  (Some AstType))

(defstruct CompilerRegAssignmentIndex
  (present (Array i64))
  (items (Array CompilerRegLocation)))

(defstruct CompilerRegAssignmentTable
  (present (Array i64))
  (items (Array CompilerRegLocation)))

;; Mutable inverse index for the greedy allocator's physical-register homes.
;; `words` is a flat [register][variable-word] bitset; primary/secondary retain
;; each variable's current pool indices so assignment updates clear old homes in
;; O(1). Register pairs occupy both indexed registers.
(defstruct CompilerRegGreedyOccupancy
  (words (Array i64))
  (word-count i64)
  (primary (Array i64))
  (secondary (Array i64))
  ;; Canonical ownership register ID -> pool index, -1 when absent.
  (pool-index (Array i64)))

(defstruct CompilerRegIntervalIndex
  (starts (Array i64))
  (ends (Array i64))
  (segments (Array CompilerRegIntervalSeq)))

(defenum CompilerRegIntervalSelection
  (Selection CompilerRegIntervalSeq CompilerRegIntervalIndex))

;; Scalar literal SafeDiv/SafeMod scratch participates in the ordinary greedy
;; allocation before the final homes are published.  The model is empty for
;; every function without that exact shape, so unrelated worklists keep their
;; original size.  Synthetic ids start at `scratch-base` and are stripped from
;; the public CompilerRegPlan after they have constrained the real homes.
(defstruct CompilerRegEarlyScratchModel
  (interval-index CompilerRegIntervalIndex)
  (type-info CompilerRegVarTypes)
  (assignments CompilerRegAssignmentTable)
  (scratch-weights (Array i64))
  ;; Per-synthetic-var physical homes barred by the real lowering constraint.
  ;; C15b feeds these into the scratch greedy so a pseudo cannot satisfy demand
  ;; with an operand/result home that the late scratch planner must reject.
  (scratch-excluded (Array CompilerRegIdList))
  (scratch-base i64)
  (scratch-count i64))

;; A liveness handle belongs to exactly one immutable CompilerIrFunction value.
;; Regalloc creates a fresh handle after every IR rewrite, then shares its
;; baseline analysis through all read-only planning helpers for that version.
;; The edge-precise result is populated only for the scalar coalescer, which is
;; the sole consumer.  Keeping both analyses here makes the version boundary
;; explicit and prevents accidental cross-function reuse.
(defenum CompilerRegMaybeLiveness
  (No)
  (Some CompilerFunctionLiveness))

(defstruct CompilerRegLivenessHandle
  (baseline CompilerFunctionLiveness)
  (edge-precise CompilerRegMaybeLiveness))

(cfg
  (any regalloc-liveness-census test)
  (define compiler-reg-liveness-census-baseline : i64
    0))
(cfg
  (any regalloc-liveness-census test)
  (define compiler-reg-liveness-census-edge-precise : i64
    0))

(define (compiler-reg-instr-seq-has-phi?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ _ _) true]
      [_ (compiler-reg-instr-seq-has-phi? instrs (+ index 1))])))

(define (compiler-reg-block-seq-has-phi?
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-block-seq-count blocks))
    false
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block _ instrs)
        (if (compiler-reg-instr-seq-has-phi? instrs 0)
          true
          (compiler-reg-block-seq-has-phi? blocks (+ index 1)))])))

(define (compiler-reg-blocks-have-phi? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (compiler-reg-instr-seq-has-phi? instrs 0)
            true
            (compiler-reg-blocks-have-phi? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq) (compiler-reg-block-seq-has-phi? seq 0)]))

(define (compiler-reg-liveness-handle-make
  [func : CompilerIrFunction]
  [need-edge-precise : bool]) : CompilerRegLivenessHandle
  (let
    [baseline : CompilerFunctionLiveness (compiler-live-analyze-function func)]
    (begin
      (cfg
        (any regalloc-liveness-census test)
        (set!
          compiler-reg-liveness-census-baseline
          (+ compiler-reg-liveness-census-baseline 1))
        unit)
      (cfg
        regalloc-liveness-census
        (io.print-error
          (if (and
            need-edge-precise
            (match func
              [(CompilerIrFunction.Function _ _ _ _ blocks)
                (compiler-reg-blocks-have-phi? blocks)]))
            "regalloc-liveness-census|baseline=1|edge-precise=1\n"
            "regalloc-liveness-census|baseline=1|edge-precise=0\n"))
        unit)
      (if need-edge-precise
        (match func
          [(CompilerIrFunction.Function _ _ _ _ blocks)
            ;; Edge-precise liveness differs from the baseline only at Phi
            ;; instructions (phi inputs attribute to predecessor edges instead
            ;; of the phi block). A phi-free function has identical analyses,
            ;; so reuse the baseline instead of running a second fixpoint.
            (if (compiler-reg-blocks-have-phi? blocks)
              (let
                [edge-precise : CompilerFunctionLiveness
                  (compiler-live-analyze-function-edge-precise func)]
                (begin
                  (cfg
                    (any regalloc-liveness-census test)
                    (set!
                      compiler-reg-liveness-census-edge-precise
                      (+ compiler-reg-liveness-census-edge-precise 1))
                    unit)
                  (CompilerRegLivenessHandle
                    baseline
                    (CompilerRegMaybeLiveness.Some edge-precise))))
              (CompilerRegLivenessHandle
                baseline
                (CompilerRegMaybeLiveness.Some baseline)))])
        (CompilerRegLivenessHandle baseline (CompilerRegMaybeLiveness.No))))))

(define (compiler-reg-liveness-handle-edge-precise
  [handle : CompilerRegLivenessHandle]) : CompilerFunctionLiveness
  (match (struct-get handle edge-precise)
    [(CompilerRegMaybeLiveness.Some liveness) liveness]
    [(CompilerRegMaybeLiveness.No)
      ;; Callers requesting this accessor are scalar coalescer paths and must
      ;; request edge-precise analysis when constructing their handle.
      (io.panic "regalloc: missing edge-precise liveness handle")]))

(defstruct CompilerRegActive
  (var i64)
  (end i64)
  (reg i64))

;; Linear-scan active set: a contiguous run sorted by (end, var) ascending.
(defstruct CompilerRegActiveSeq
  (slots (Array CompilerRegActive))
  (len i64))

;; One accepted per-call-region placement (M-G2b): a spilled call-spanning
;; root `var` is homed in its shadow caller-saved register over the point
;; range [lo,hi] -- the inclusive point coords of the first/last coalesce-class
;; reference inside ONE kind-0-clobber-free run of ONE block. The backend
;; caller-save rewrite mints a register-homed segment var W for the range,
;; remaps every class reference in it to W, and materializes the boundary
;; movs: `Mov W <- var` at lo when entry = 1 (the value is live INTO the
;; region), and `Mov var <- W` after hi when exit = 1 (the region redefines
;; the value AND it lives past the region). The home slot stays the
;; authoritative cross-call location everywhere outside the region.
(defenum CompilerRegCallRegion
  (CompilerRegCallRegion i64 i64 i64 i64 i64))

;; Accepted placements in ACCEPT order; consumers walk it back to front, which
;; is the order the former prepend-built cons list presented.
(defstruct CompilerRegCallRegionSeq
  (slots (Array CompilerRegCallRegion))
  (len i64))

;; Call-spanning split result: the shadow (split) var set, a per-var map
;; (var-id -> caller-saved register ID for its call-free regions, -1 = none),
;; and the accepted per-call-region placements the backend rewrite realizes.
;; The regs map generalizes the former single hardcoded %r9 so multiple
;; OVERLAPPING call-spanning values can each be kept in a distinct caller-saved
;; register between the same calls.
(defenum CompilerRegCallSplit
  (CompilerRegCallSplit CompilerLiveI64Set (Array i64) CompilerRegCallRegionSeq))

(define (compiler-reg-call-split-shadows [s : CompilerRegCallSplit]) : CompilerLiveI64Set
  (match s
    [(CompilerRegCallSplit shadows _ _) shadows]))

(define (compiler-reg-call-split-regs [s : CompilerRegCallSplit]) : (Array i64)
  (match s
    [(CompilerRegCallSplit _ regs _) regs]))

(define (compiler-reg-call-split-regions [s : CompilerRegCallSplit]) : CompilerRegCallRegionSeq
  (match s
    [(CompilerRegCallSplit _ _ regions) regions]))

(define (compiler-reg-call-region-seq-empty) : CompilerRegCallRegionSeq
  (CompilerRegCallRegionSeq (array.make-array CompilerRegCallRegion 0) 0))

(define (compiler-reg-call-split-empty) : CompilerRegCallSplit
  (CompilerRegCallSplit
    (compiler-live-set-empty)
    (array.make-array i64 0)
    (compiler-reg-call-region-seq-empty)))

;; SplitKit occupant-liberation record (design 3.2): to free a callee-saved
;; register R for a call-spanning value V across its crossing region, a cold
;; through-occupant O of R is split -- stored to its slot before the region and
;; reloaded after -- so R is free over [region-start,region-end). Fields:
;;   occupant var O, region start, region end (point coords), the freed CSR
;;   register, and O's stack slot offset (store-before / reload-after home).
;; Carried by the split plan; the array stays empty until M5 turns the
;; live-occupant lever on.
(defenum CompilerRegOccupantSplit
  (CompilerRegOccupantSplit i64 i64 i64 i64 i64))

;; SplitKit per-sub-range value model (design 1.2). Produced by the greedy and
;; threaded through CompilerRegPlan: a spilled call-spanning value V keeps its
;; canonical stack slot while its live range partitions at call boundaries into
;; register sub-ranges (future minted pieces V_i + boundary copies) and slot
;; sub-ranges. Indexed by piece var id:
;;   piece-of[V_i]        -- original root V of a minted piece; -1 for non-pieces
;;   piece-start/-end     -- V_i's sub-range [start,end) in point coords
;;   piece-reg[V_i]       -- physreg ID the worklist gave V_i (-1 = spilled)
;;   piece-writeback[V_i] -- 1 iff V is redefined inside V_i (needs the OUT copy)
;;   occupant-split       -- the freed-CSR store/reload plans (design 3.2)
;; M1 threads an EMPTY (budget-0) plan: no pieces are minted and nothing consumes
;; it, so allocation and emission are unchanged until M2+ populate it.
(defstruct CompilerRegSplitPlan
  (piece-of (Array i64))
  (piece-start (Array i64))
  (piece-end (Array i64))
  (piece-reg (Array i64))
  (piece-writeback (Array i64))
  (occupant-split (Array CompilerRegOccupantSplit)))

(defenum CompilerRegPlan
  (Plan
    CompilerRegAssignmentList
    CompilerLiveI64Set
    CompilerRegIntervalSeq
    CompilerRegVarTypeList
    CompilerRegCallSplit
    CompilerRegSplitPlan))

(defenum CompilerRegAssignState
  (State CompilerRegActiveSeq CompilerRegAssignmentTable))

(defenum CompilerRegCallSaveAssignState
  (State CompilerRegAssignmentTable CompilerRegCallSplit))

(defenum CompilerRegCallSaveRewrite
  (Rewrite
    CompilerIrBlockList
    i64
    i64
    CompilerRegAssignmentList
    CompilerRegVarTypeList))

;; Per-instruction rewrite state for rematerialization. The rewritten
;; instructions themselves are not carried here: they are pushed straight into
;; a caller-owned `CompilerIrInstrBuilder` threaded `(&mut ...)` through the
;; walk, so the payload is only the scalars and lists that thread forward
;; (emit point, next var id, and the extra assignment/type lists remat grows).
(defenum CompilerRegCallSaveInstrRewrite
  (Rewrite i64 i64 CompilerRegAssignmentList CompilerRegVarTypeList))

;; Conservative cold-call clobber splitting happens before scalar allocation.
;; `temp-start` is the first synthetic stack-home used to carry a protected GP
;; value across the cold call, or -1 when the input function was returned
;; unchanged.  The rewritten function is the single source of truth for both
;; liveness and emission.
(defenum CompilerRegColdCallRewrite
  (Rewrite CompilerIrFunction i64))

(defenum CompilerRegColdCallCandidate
  (NoCandidate)
  (Candidate i64 i64))

;; Form (a) early-exit shrink wrapping is also an IR rewrite before scalar
;; allocation. These per-function results accompany the returned function;
;; empty labels mean the input was unchanged. Backend emission is sequential,
;; including its FPO retry, so the state is reset by every rewrite call.
(define compiler-reg-early-exit-saving-label : i64
  -1)
(define compiler-reg-early-exit-bare-label : String
  "")
(define compiler-reg-early-exit-prefix-count : i64
  0)

(define (compiler-reg-cold-call-rewrite-function-value
  [rewrite : CompilerRegColdCallRewrite]) : CompilerIrFunction
  (match rewrite
    [(CompilerRegColdCallRewrite.Rewrite func _) func]))

(define (compiler-reg-cold-call-rewrite-temp-start
  [rewrite : CompilerRegColdCallRewrite]) : i64
  (match rewrite
    [(CompilerRegColdCallRewrite.Rewrite _ temp-start) temp-start]))

(defstruct CompilerRegRematTable
  (def-counts (Array i64))
  (candidates (Array i64))
  (kinds (Array i64))
  (values (Array CompilerIrValue))
  (offsets (Array CompilerIrValue))
  (op-types (Array AstType))
  (types (Array AstType)))

(define (compiler-reg-remat-kind-mov) : i64
  1)

(define (compiler-reg-remat-kind-load) : i64
  2)

(define (compiler-reg-remat-kind-gep) : i64
  3)

(defenum CompilerRegEdgeCopyDirection
  (IntoRegion)
  (OutOfRegion))

(defenum CompilerRegEdgeCopyPlacement
  (PredEnd)
  (SuccEntry))

(defenum CompilerRegEdgeCopy
  (Copy
    i64
    i64
    i64
    i64
    AstType
    CompilerRegEdgeCopyDirection
    CompilerRegEdgeCopyPlacement))

;; Boundary copies in plan order (the order the former reverse-at-the-end cons
;; accumulator produced), so consumers walk it front to back.
(defstruct CompilerRegEdgeCopySeq
  (slots (Array CompilerRegEdgeCopy))
  (len i64))

(defenum CompilerRegEdgeCopyPlacementResult
  (Ok CompilerRegEdgeCopyPlacement)
  (Refused String))

(defenum CompilerRegEdgeCopyPlan
  (Plan CompilerRegEdgeCopySeq)
  (Refused String))

(defenum CompilerRegEdgeCopyRewrite
  (Rewrite CompilerIrBlockList)
  (Refused String))

;; A loop-split rescue candidate. The region is a LIST of block labels: a single
;; label for the single-block (read-only / non-phi self-loop / step-2 single-block)
;; paths, or the whole natural-loop block range for the step-2 MULTI-BLOCK
;; phi-carried homing. apply-candidate remaps every region block and the edge-copy
;; plan (already multi-block aware) places boundary copies at the region edges.
(defenum CompilerRegLoopSplitCandidate
  (NoCandidate)
  (Candidate i64 CompilerRegLabelList AstType i64 CompilerRegEdgeCopySeq i64))

(defenum CompilerRegLeafCsrSplitCandidate
  (NoCandidate)
  (Candidate
    i64
    CompilerRegLabelList
    AstType
    i64
    i64
    CompilerRegEdgeCopySeq
    i64))

(defstruct CompilerRegLeafCsrFuseFacts
  (uses i64)
  (free-branches i64))

(defenum CompilerRegLoopSplitRewriteResult
  (Result CompilerRegCallSaveRewrite i64))

;; Result of the eviction-aware register pick (below): a candidate register `r`
;; together with the strictly-lower-weight var to evict (re-spill) so `r` becomes
;; free over the loop region, or None when no such register exists.
(defenum CompilerRegLoopSplitEvict
  (CompilerRegLoopSplitEvictNone)
  (CompilerRegLoopSplitEvict i64 i64))

(defenum CompilerRegParamAssignPlan
  (Plan CompilerRegAssignmentTable CompilerLiveI64Set CompilerLiveI64Set))

(cfg
  (any regalloc-census test)
  (defstruct CompilerRegCallSpanCensus
    (counts (Array i64))))

(defstruct CompilerRegMove
  (src i64)
  (dst i64)
  (strict bool))

;; Coalesce move candidates in ADD order. The former cons list was built by
;; prepending, so its head was the newest entry: every order-sensitive consumer
;; below (mark-strict, class merging, first-wins copy hints) walks index
;; `len - 1` down to 0.
(defstruct CompilerRegMoveSeq
  (slots (Array CompilerRegMove))
  (len i64))

;; Deterministic move-copy classes used by scalar home coalescing. Roots are the
;; lowest var id in each class; allocation then reuses any assigned class home.
(defstruct CompilerRegCoalesceMap
  (parents (Array i64)))

(define (compiler-reg-id-cons [head : i64] [rest : CompilerRegIdList]) : CompilerRegIdList
  (CompilerRegIdList.Cons head (box rest)))

(define (compiler-reg-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (> prefix-len text-len)
      false
      (string.eq (string.substring text 0 prefix-len) prefix))))

(define (compiler-reg-spmd-varying-param? [name : String]) : bool
  (compiler-reg-string-prefix? name "__tl_spmd_varying_arg_"))

(define (compiler-reg-spmd-mask-param? [name : String]) : bool
  (or
    (string.eq name "__tl_spmd_active_mask")
    (compiler-reg-string-prefix? name "__tl_spmd_mask_arg_")))

(define (compiler-reg-assignment-cons
  [head : CompilerRegAssignment]
  [rest : CompilerRegAssignmentList]) : CompilerRegAssignmentList
  (CompilerRegAssignmentList.Cons head (box rest)))

(define (compiler-reg-var-type-cons
  [head : CompilerRegVarType]
  [rest : CompilerRegVarTypeList]) : CompilerRegVarTypeList
  (CompilerRegVarTypeList.Cons head (box rest)))

;; Capacity for a seq that must hold `len + 1` elements; the caller copies the
;; live prefix into a fresh array of this size when the current one is full.
(define (compiler-reg-seq-grown-capacity [cap : i64]) : i64
  (if (< cap 4)
    4
    (* cap 2)))

(define (compiler-reg-interval-seq-empty) : CompilerRegIntervalSeq
  (CompilerRegIntervalSeq (array.make-array CompilerRegInterval 0) 0))

(define (compiler-reg-interval-seq-with-capacity [capacity : i64]) : CompilerRegIntervalSeq
  (CompilerRegIntervalSeq (array.make-array CompilerRegInterval capacity) 0))

(defmacro (compiler-reg-interval-seq-count [items : CompilerRegIntervalSeq]) : i64
  `(struct-get ,items len))

(defmacro (compiler-reg-interval-seq-empty? [items : CompilerRegIntervalSeq]) : bool
  `(= (struct-get ,items len) 0))

(defmacro (compiler-reg-interval-seq-ref
  [items : CompilerRegIntervalSeq]
  [index : i64]) : CompilerRegInterval
  `(array-ref (struct-get ,items slots) ,index))

(define (compiler-reg-interval-seq-grow [items : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [slots : (Array CompilerRegInterval) (struct-get items slots)]
    [len : i64 (struct-get items len)]
    ;; Most per-variable segment sequences contain one interval.  Start at one
    ;; slot so their dense backing arrays do not zero three unused interval
    ;; records; subsequent growth remains geometric.
    [capacity : i64
      (if (= (array-length slots) 0)
        1
        (* (array-length slots) 2))]
    [bigger : (Array CompilerRegInterval)
      (array.make-array CompilerRegInterval capacity)]
    [index : i64 0]
    (begin
      (while (< index len)
        (begin
          (array-set! bigger index (array-ref slots index))
          (set! index (+ index 1))))
      (CompilerRegIntervalSeq bigger len))))

(define (compiler-reg-interval-seq-prepend
  [head : CompilerRegInterval]
  [rest : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [len : i64 (struct-get rest len)]
    [old-slots : (Array CompilerRegInterval) (struct-get rest slots)]
    [capacity : i64
      (if (> (array-length old-slots) len)
        (array-length old-slots)
        (if (= (array-length old-slots) 0)
          1
          (* (array-length old-slots) 2)))]
    [slots : (Array CompilerRegInterval)
      (array.make-array CompilerRegInterval capacity)]
    [index : i64 0]
    (begin
      ;; Prepend is intentionally persistent: some cold fixture/worklist
      ;; builders retain `rest`, so shifting its shared backing array would
      ;; mutate that still-live view.
      (array-set! slots 0 head)
      (while (< index len)
        (begin
          (array-set! slots (+ index 1) (array-ref old-slots index))
          (set! index (+ index 1))))
      (CompilerRegIntervalSeq slots (+ len 1)))))

(define (compiler-reg-interval-seq-append
  [items : CompilerRegIntervalSeq]
  [item : CompilerRegInterval]) : CompilerRegIntervalSeq
  (let
    [ready : CompilerRegIntervalSeq
      (if (>= (struct-get items len) (array-length (struct-get items slots)))
        (compiler-reg-interval-seq-grow items)
        items)]
    [slots : (Array CompilerRegInterval) (struct-get ready slots)]
    [len : i64 (struct-get ready len)]
    (begin
      (array-set! slots len item)
      (CompilerRegIntervalSeq slots (+ len 1)))))

(define (compiler-reg-interval-seq-append-all
  [items : CompilerRegIntervalSeq]
  [suffix : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq items]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count suffix))
        (begin
          (set!
            out
            (compiler-reg-interval-seq-append
              out
              (compiler-reg-interval-seq-ref suffix index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-edge-copy-seq-empty) : CompilerRegEdgeCopySeq
  (CompilerRegEdgeCopySeq (array.make-array CompilerRegEdgeCopy 0) 0))

(define (compiler-reg-edge-copy-seq-push
  [copies : CompilerRegEdgeCopySeq]
  [item : CompilerRegEdgeCopy]) : CompilerRegEdgeCopySeq
  (let
    [slots : (Array CompilerRegEdgeCopy) (struct-get copies slots)]
    [len : i64 (struct-get copies len)]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (Array CompilerRegEdgeCopy)
            (array.make-array
              CompilerRegEdgeCopy
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (array-set! bigger i (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (array-set! slots len item)
      (CompilerRegEdgeCopySeq slots (+ len 1)))))

(define (compiler-reg-active-seq-empty) : CompilerRegActiveSeq
  (CompilerRegActiveSeq (array.make-array CompilerRegActive 0) 0))

(define (compiler-reg-move-seq-empty) : CompilerRegMoveSeq
  (CompilerRegMoveSeq (array.make-array CompilerRegMove 0) 0))

(define (compiler-reg-move-seq-push
  [moves : CompilerRegMoveSeq]
  [item : CompilerRegMove]) : CompilerRegMoveSeq
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [len : i64 (struct-get moves len)]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (Array CompilerRegMove)
            (array.make-array
              CompilerRegMove
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (array-set! bigger i (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (array-set! slots len item)
      (CompilerRegMoveSeq slots (+ len 1)))))

(define (compiler-reg-call-region-seq-push
  [regions : CompilerRegCallRegionSeq]
  [item : CompilerRegCallRegion]) : CompilerRegCallRegionSeq
  (let
    [slots : (Array CompilerRegCallRegion) (struct-get regions slots)]
    [len : i64 (struct-get regions len)]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (Array CompilerRegCallRegion)
            (array.make-array
              CompilerRegCallRegion
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (array-set! bigger i (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (array-set! slots len item)
      (CompilerRegCallRegionSeq slots (+ len 1)))))

(define (compiler-reg-call-region-stat-seq-empty) : CompilerRegCallRegionStatSeq
  (CompilerRegCallRegionStatSeq
    (array.make-array CompilerRegCallRegionStat 0)
    0))

(define (compiler-reg-call-region-stat-seq-push
  [rows : CompilerRegCallRegionStatSeq]
  [item : CompilerRegCallRegionStat]) : CompilerRegCallRegionStatSeq
  (let
    [slots : (Array CompilerRegCallRegionStat) (struct-get rows slots)]
    [len : i64 (struct-get rows len)]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (Array CompilerRegCallRegionStat)
            (array.make-array
              CompilerRegCallRegionStat
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (array-set! bigger i (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (array-set! slots len item)
      (CompilerRegCallRegionStatSeq slots (+ len 1)))))

(define (compiler-reg-max [a : i64] [b : i64]) : i64
  (if (> a b)
    a
    b))

(define (compiler-reg-stack-slot-offset [var : i64]) : i64
  (- 0 (* 8 (+ var 1))))

;; Allocatable integer register pool. Only callee-saved registers are admitted
;; by the primary pass:
;; a value whose live interval spans a call keeps its home across that call
;; because the callee preserves these registers, so no spill/reload around the
;; call is needed. The former pool also offered %r8/%r9, which are caller-saved
;; under both SysV and Win64 and are clobbered by an intervening call — a value
;; homed there and read after the call (e.g. the first operand of `(+ a (f))`)
;; would silently observe garbage. The five registers below are exactly those
;; the backend prologue/epilogue save and restore. Mirrors the former Rust
;; backend's `SYSV_ALLOCATABLE_INTEGER_REGS` (callee-saved only).
;;
;; %rbx is callee-saved under both SysV and Win64 and was historically reserved
;; as the backend's hard scratch register for the right-hand operand of integer
;; binops/compares/gep/div/shift. That fixed scratch role moved under the
;; scavenger, freeing %rbx to join the callee-saved pool. It is added LAST so
;; functions needing four or fewer registers keep their previous r12-r15 homes;
;; %rbx only homes a value once the four call-safe registers are exhausted, and
;; when it does the backend prologue/epilogue saves/restores it into a frame slot
;; exactly like r12-r15.
(define (compiler-reg-sysv-integer-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-r12
    (compiler-reg-id-cons
      compiler-reg-id-r13
      (compiler-reg-id-cons
        compiler-reg-id-r14
        (compiler-reg-id-cons
          compiler-reg-id-r15
          (compiler-reg-id-cons compiler-reg-id-rbx CompilerRegIdList.Nil))))))

;; M-G3 stage 2 / Win64 FPO: %rbp as the last callee-saved pool register. Only
;; enabled per-function by the backend (compiler-reg-set-rbp-pool-enabled!) when
;; the function is frame-pointer-omission eligible: the prologue then addresses
;; the frame purely rsp-relative, freeing %rbp to home a value like every other
;; nonvolatile register. %rbp is added LAST in each ABI pool so lower-pressure
;; functions keep their existing assignments.
;; The flag defaults to false, so every non-backend planning path (regalloc unit
;; tests, SIMD/AVX config, stack-only plans) sees the historical 14-register pool.
(define compiler-reg-rbp-pool-enabled : bool
  false)

(define (compiler-reg-set-rbp-pool-enabled! [on : bool]) : unit
  (set! compiler-reg-rbp-pool-enabled on))

(define (compiler-reg-sysv-integer-registers-with-rbp) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-r12
    (compiler-reg-id-cons
      compiler-reg-id-r13
      (compiler-reg-id-cons
        compiler-reg-id-r14
        (compiler-reg-id-cons
          compiler-reg-id-r15
          (compiler-reg-id-cons
            compiler-reg-id-rbx
            (compiler-reg-id-cons compiler-reg-id-rbp CompilerRegIdList.Nil)))))))

;; Conservative caller-saved extension for the scalar opt2 pass. These registers
;; are caller-saved on both SysV and Win64, are not callee-saved registers that
;; would need prologue/epilogue save/restore, and are used only for intervals
;; that do not span a modeled backend caller-clobber point. This legacy helper is
;; intentionally the three-register subset; the unified greedy pool owns
;; %r10/%r11/%r8 behind the same clobber filter.
(define (compiler-reg-zero-call-caller-saved-integer-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-r9
    (compiler-reg-id-cons
      compiler-reg-id-rcx
      (compiler-reg-id-cons compiler-reg-id-rdx CompilerRegIdList.Nil))))

(define (compiler-reg-caller-saved-integer-registers-from-abi
  [abi : CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdList
  (if (>= idx (compiler-abi-caller-saved-gp-register-count abi))
    CompilerRegIdList.Nil
    (compiler-reg-id-cons
      (compiler-abi-caller-saved-gp-register-id abi idx)
      (compiler-reg-caller-saved-integer-registers-from-abi abi (+ idx 1)))))

(define (compiler-reg-callee-saved-integer-registers-from-abi
  [abi : CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdList
  (if (>= idx (compiler-abi-callee-saved-gp-register-count abi))
    CompilerRegIdList.Nil
    (compiler-reg-id-cons
      (compiler-abi-callee-saved-gp-register-id abi idx)
      (compiler-reg-callee-saved-integer-registers-from-abi abi (+ idx 1)))))

(define (compiler-reg-sysv-caller-saved-integer-registers) : CompilerRegIdList
  (compiler-reg-caller-saved-integer-registers-from-abi
    CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-sysv-callee-saved-integer-registers) : CompilerRegIdList
  (compiler-reg-callee-saved-integer-registers-from-abi
    CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-win64-caller-saved-integer-registers) : CompilerRegIdList
  (compiler-reg-caller-saved-integer-registers-from-abi
    CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-win64-callee-saved-integer-registers) : CompilerRegIdList
  (compiler-reg-callee-saved-integer-registers-from-abi
    CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-id-list-append
  [left : CompilerRegIdList]
  [right : CompilerRegIdList]) : CompilerRegIdList
  (match left
    [(CompilerRegIdList.Nil) right]
    [(CompilerRegIdList.Cons reg rest)
      (compiler-reg-id-cons
        reg
        (compiler-reg-id-list-append (box-get rest) right))]))

(define (compiler-reg-callee-saved-integer-registers-for-abi
  [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    [(CompilerRegTargetAbi.Linux) (compiler-reg-sysv-integer-registers)]
    [(CompilerRegTargetAbi.Windows)
      (compiler-reg-win64-callee-saved-integer-registers)]))

(define (compiler-reg-callee-saved-integer-register-count-for-abi
  [abi : CompilerRegTargetAbi]) : i64
  (compiler-reg-id-list-count
    (compiler-reg-callee-saved-integer-registers-for-abi abi)))

;; Under scratch-vreg, every XMM-family register is allocator-owned. Volatile
;; registers form the prefix and ABI-nonvolatile registers form the suffix, so
;; the greedy clobber constraint can restrict call-spanning values to the suffix.
;; ABI-fixed argument/result uses and instruction-selection temporaries are
;; represented by preferences, clobber points, or bounded scratch requirements.
;; The default-off path retains XMM0/XMM1 as reserved backend scratch until the
;; scratch-vreg cutover.
(define (compiler-reg-low-xmm-allocatable?) : bool
  (cfg scratch-vreg true false))

(define (compiler-reg-xmm-class-register [reg : i64] [vector : bool]) : i64
  (compiler-abi-register-with-vector-class reg vector))

(define (compiler-reg-xmm-caller-registers-for-abi-range
  [abi : CompilerRegTargetAbi]
  [idx : i64]
  [end : i64]
  [vector : bool]) : CompilerRegIdList
  (if (or
    (>= idx end)
    (>= idx (compiler-abi-caller-saved-xmm-register-count abi)))
    CompilerRegIdList.Nil
    (let
      [reg : i64 (compiler-abi-caller-saved-xmm-register-id abi idx)]
      [tail : CompilerRegIdList
        (compiler-reg-xmm-caller-registers-for-abi-range
          abi
          (+ idx 1)
          end
          vector)]
      (if (and (not (compiler-reg-low-xmm-allocatable?)) (< idx 2))
        tail
        (compiler-reg-id-cons (compiler-reg-xmm-class-register reg vector) tail)))))

(define (compiler-reg-xmm-caller-registers-for-abi-from
  [abi : CompilerRegTargetAbi]
  [idx : i64]
  [vector : bool]) : CompilerRegIdList
  (compiler-reg-xmm-caller-registers-for-abi-range
    abi
    idx
    (compiler-abi-caller-saved-xmm-register-count abi)
    vector))

(define (compiler-reg-xmm-callee-registers-for-abi-from
  [abi : CompilerRegTargetAbi]
  [idx : i64]
  [vector : bool]) : CompilerRegIdList
  (if (>= idx (compiler-abi-callee-saved-xmm-register-count abi))
    CompilerRegIdList.Nil
    (compiler-reg-id-cons
      (compiler-reg-xmm-class-register
        (compiler-abi-callee-saved-xmm-register-id abi idx)
        vector)
      (compiler-reg-xmm-callee-registers-for-abi-from abi (+ idx 1) vector))))

(define (compiler-reg-xmm-registers-for-abi-build [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (compiler-reg-id-list-append
    (compiler-reg-xmm-caller-registers-for-abi-from abi 0 false)
    (compiler-reg-xmm-callee-registers-for-abi-from abi 0 false)))

(define (compiler-reg-vector-registers-for-abi-build
  [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    [(CompilerRegTargetAbi.Linux)
      ;; Preserve the established high-register vector preference, then use
      ;; XMM2-XMM5 as overflow capacity. XMM0/XMM1 stay out of the vector class
      ;; until every vector lowering has explicit scratch.
      (compiler-reg-id-list-append
        (compiler-reg-xmm-caller-registers-for-abi-range
          abi
          6
          (compiler-abi-caller-saved-xmm-register-count abi)
          true)
        (compiler-reg-xmm-caller-registers-for-abi-range abi 2 6 true))]
    [(CompilerRegTargetAbi.Windows)
      ;; Keep XMM2-XMM5 as the volatile prefix before XMM6-XMM15.
      (compiler-reg-id-list-append
        (compiler-reg-xmm-caller-registers-for-abi-range abi 2 6 true)
        (compiler-reg-xmm-callee-registers-for-abi-from abi 0 true))]))

(define compiler-reg-linux-xmm-registers : CompilerRegIdList
  (compiler-reg-xmm-registers-for-abi-build CompilerRegTargetAbi.Linux))
(define compiler-reg-windows-xmm-registers : CompilerRegIdList
  (compiler-reg-xmm-registers-for-abi-build CompilerRegTargetAbi.Windows))
(define compiler-reg-linux-vector-registers : CompilerRegIdList
  (compiler-reg-vector-registers-for-abi-build CompilerRegTargetAbi.Linux))
(define compiler-reg-windows-vector-registers : CompilerRegIdList
  (compiler-reg-vector-registers-for-abi-build CompilerRegTargetAbi.Windows))
(define compiler-reg-linux-xmm-callee-registers : CompilerRegIdList
  (compiler-reg-xmm-callee-registers-for-abi-from
    CompilerRegTargetAbi.Linux
    0
    false))
(define compiler-reg-windows-xmm-callee-registers : CompilerRegIdList
  (compiler-reg-xmm-callee-registers-for-abi-from
    CompilerRegTargetAbi.Windows
    0
    false))
(define compiler-reg-linux-vector-callee-registers : CompilerRegIdList
  (compiler-reg-xmm-callee-registers-for-abi-from
    CompilerRegTargetAbi.Linux
    0
    true))
(define compiler-reg-windows-vector-callee-registers : CompilerRegIdList
  (compiler-reg-xmm-callee-registers-for-abi-from
    CompilerRegTargetAbi.Windows
    0
    true))

(define (compiler-reg-xmm-registers-for-abi [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    [(CompilerRegTargetAbi.Linux) compiler-reg-linux-xmm-registers]
    [(CompilerRegTargetAbi.Windows) compiler-reg-windows-xmm-registers]))

(define (compiler-reg-vector-registers-for-abi [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    [(CompilerRegTargetAbi.Linux) compiler-reg-linux-vector-registers]
    [(CompilerRegTargetAbi.Windows) compiler-reg-windows-vector-registers]))

(define (compiler-reg-xmm-callee-registers-for-abi [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    [(CompilerRegTargetAbi.Linux) compiler-reg-linux-xmm-callee-registers]
    [(CompilerRegTargetAbi.Windows) compiler-reg-windows-xmm-callee-registers]))

(define (compiler-reg-vector-callee-registers-for-abi
  [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    [(CompilerRegTargetAbi.Linux) compiler-reg-linux-vector-callee-registers]
    [(CompilerRegTargetAbi.Windows)
      compiler-reg-windows-vector-callee-registers]))

(define (compiler-reg-xmm-caller-register-count-for-abi
  [abi : CompilerRegTargetAbi]) : i64
  (-
    (compiler-abi-caller-saved-xmm-register-count abi)
    (if (compiler-reg-low-xmm-allocatable?)
      0
      2)))

(define (compiler-reg-vector-caller-register-count-for-abi
  [abi : CompilerRegTargetAbi]) : i64
  (- (compiler-abi-caller-saved-xmm-register-count abi) 2))

(define (compiler-reg-xmm-registers) : CompilerRegIdList
  (compiler-reg-xmm-registers-for-abi CompilerRegTargetAbi.Linux))

(define (compiler-reg-xmm-family-index [reg : i64]) : i64
  (compiler-abi-register-vector-family-index reg))

(define (compiler-reg-registers-overlap? [left : i64] [right : i64]) : bool
  (compiler-abi-registers-overlap? left right))

(define (compiler-reg-mask-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    (compiler-abi-mask-register-id 1)
    (compiler-reg-id-cons
      (compiler-abi-mask-register-id 2)
      (compiler-reg-id-cons
        (compiler-abi-mask-register-id 3)
        (compiler-reg-id-cons
          (compiler-abi-mask-register-id 4)
          (compiler-reg-id-cons
            (compiler-abi-mask-register-id 5)
            (compiler-reg-id-cons
              (compiler-abi-mask-register-id 6)
              CompilerRegIdList.Nil)))))))

(define (compiler-reg-caller-saved-xmm-registers-from-abi
  [abi : CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdList
  (if (>= idx (compiler-abi-caller-saved-xmm-register-count abi))
    CompilerRegIdList.Nil
    (compiler-reg-id-cons
      (compiler-abi-caller-saved-xmm-register-id abi idx)
      (compiler-reg-caller-saved-xmm-registers-from-abi abi (+ idx 1)))))

(define (compiler-reg-callee-saved-xmm-registers-from-abi
  [abi : CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdList
  (if (>= idx (compiler-abi-callee-saved-xmm-register-count abi))
    CompilerRegIdList.Nil
    (compiler-reg-id-cons
      (compiler-abi-callee-saved-xmm-register-id abi idx)
      (compiler-reg-callee-saved-xmm-registers-from-abi abi (+ idx 1)))))

(define (compiler-reg-sysv-caller-saved-xmm-registers) : CompilerRegIdList
  (compiler-reg-caller-saved-xmm-registers-from-abi
    CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-sysv-callee-saved-xmm-registers) : CompilerRegIdList
  (compiler-reg-callee-saved-xmm-registers-from-abi
    CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-win64-caller-saved-xmm-registers) : CompilerRegIdList
  (compiler-reg-caller-saved-xmm-registers-from-abi
    CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-win64-callee-saved-xmm-registers) : CompilerRegIdList
  (compiler-reg-callee-saved-xmm-registers-from-abi
    CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-id-list-count [regs : CompilerRegIdList]) : i64
  (match regs
    [(CompilerRegIdList.Nil) 0]
    [(CompilerRegIdList.Cons _ rest)
      (+ 1 (compiler-reg-id-list-count (box-get rest)))]))

(define (compiler-reg-id-list-contains? [regs : CompilerRegIdList] [want : i64]) : bool
  (match regs
    [(CompilerRegIdList.Nil) false]
    [(CompilerRegIdList.Cons reg rest)
      (if (= reg want)
        true
        (compiler-reg-id-list-contains? (box-get rest) want))]))

(define (compiler-reg-float-type? [ty : AstType]) : bool
  (match ty
    [(AstType.F64) true]
    [(AstType.F32) true]
    [_ false]))

(define (compiler-reg-scalar-type? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Func _ _) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [_ false]))

;; Aggregate types represented as a single 8-byte handle (an arena/heap pointer
;; or a fat-string descriptor pointer). Their VALUES are register-sized, so a var
;; of one of these types can live in a callee-saved register exactly like a raw
;; pointer — the backend already moves them with a plain movq. Values whose
;; address is taken (AddrOf source) or that name a stack object (Alloc) stay on
;; the stack via the memory rule, so register homing here is safe. Zero-sized
;; AstType.Expr/AstType.ExprList are excluded.
(define (compiler-reg-handle-type? [ty : AstType]) : bool
  (match ty
    [(AstType.String) true]
    [(AstType.Str) true]
    [(AstType.Box _) true]
    [(AstType.Array _ _) true]
    [(AstType.DynArray _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Var _) true]
    [(AstType.VarArgs _ _) true]
    [_ false]))

(define (compiler-reg-register-eligible-type? [ty : AstType]) : bool
  (if (compiler-reg-scalar-type? ty)
    true
    (compiler-reg-handle-type? ty)))

(define (compiler-reg-var-type-insert
  [types : CompilerRegVarTypeList]
  [var : i64]
  [ty : AstType]) : CompilerRegVarTypeList
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-var-type-insert
        (compiler-reg-var-type-seq-to-list seq)
        var
        ty)]
    [(CompilerRegVarTypeList.Nil)
      (compiler-reg-var-type-cons
        (CompilerRegVarType var ty)
        CompilerRegVarTypeList.Nil)]
    [(CompilerRegVarTypeList.Cons item rest)
      (let
        [id : i64 (struct-get item var)]
        (if (= id var)
          (compiler-reg-var-type-cons
            (CompilerRegVarType var ty)
            (box-get rest))
          (if (> id var)
            (compiler-reg-var-type-cons (CompilerRegVarType var ty) types)
            (compiler-reg-var-type-cons
              item
              (compiler-reg-var-type-insert (box-get rest) var ty)))))]))

(define (compiler-reg-var-type-lookup
  [types : CompilerRegVarTypeList]
  [var : i64]) : CompilerRegMaybeType
  (match types
    [(CompilerRegVarTypeList.Array seq) (compiler-reg-var-types-lookup seq var)]
    [(CompilerRegVarTypeList.Nil) CompilerRegMaybeType.No]
    [(CompilerRegVarTypeList.Cons item rest)
      (let
        [id : i64 (struct-get item var)]
        (if (= id var)
          (CompilerRegMaybeType.Some (struct-get item ty))
          (if (> id var)
            CompilerRegMaybeType.No
            (compiler-reg-var-type-lookup (box-get rest) var))))]))

(define (compiler-reg-var-types-list [types : CompilerRegVarTypes]) : CompilerRegVarTypeList
  (CompilerRegVarTypeList.Array types))

(define (compiler-reg-var-types-lookup
  [types : CompilerRegVarTypes]
  [var : i64]) : CompilerRegMaybeType
  (let
    [present : (Array i64) (struct-get types present)]
    [items : (Array AstType) (struct-get types items)]
    (if (or (< var 0) (>= var (array-length present)))
      CompilerRegMaybeType.No
      (if (= (array-ref present var) 0)
        CompilerRegMaybeType.No
        (CompilerRegMaybeType.Some (array-ref items var))))))

(define (compiler-reg-addr-of-result-type) : AstType
  (ast-ty-mut-ptr (AstType.U8)))

(define (compiler-reg-var-type-array-set!
  [present : (Array i64)]
  [types : (Array AstType)]
  [var : i64]
  [ty : AstType]) : unit
  (if (or (< var 0) (>= var (array-length present)))
    unit
    (begin
      (array-set! present var 1)
      (array-set! types var ty))))

(define (compiler-reg-param-types-array!
  [params : CompilerIrParamList]
  [present : (Array i64)]
  [types : (Array AstType)]) : unit
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) unit]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-param-types-array!
        (compiler-ir-param-seq-to-list seq)
        present
        types)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ ty id)
          (begin
            (compiler-reg-var-type-array-set! present types id ty)
            (compiler-reg-param-types-array! (box-get rest) present types))])]))

(define (compiler-reg-instr-def-type-array!
  [instr : CompilerIrInstr]
  [present : (Array i64)]
  [types : (Array AstType)]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(CompilerIrInstr.AddrOf dst _)
      (compiler-reg-var-type-array-set!
        present
        types
        dst
        (compiler-reg-addr-of-result-type))]
    [(CompilerIrInstr.Gep dst _ _ _)
      (compiler-reg-var-type-array-set!
        present
        types
        dst
        (compiler-reg-addr-of-result-type))]
    [(CompilerIrInstr.Load dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(CompilerIrInstr.Cast dst _ _ to-ty)
      (compiler-reg-var-type-array-set! present types dst to-ty)]
    [(CompilerIrInstr.Bitcast dst _ _ to-ty)
      (compiler-reg-var-type-array-set! present types dst to-ty)]
    [(CompilerIrInstr.BinOp dst op _ _ ty)
      (compiler-reg-var-type-array-set!
        present
        types
        dst
        (compiler-ir-binop-result-type op ty))]
    [(CompilerIrInstr.UnOp dst _ _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(CompilerIrInstr.VectorReduce dst _ _ _ elem-ty)
      (compiler-reg-var-type-array-set! present types dst elem-ty)]
    [(CompilerIrInstr.MaskReduce dst _ _ _)
      (compiler-reg-var-type-array-set! present types dst (AstType.Bool))]
    [(CompilerIrInstr.Call dst _ _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (struct-get (box-get payload-box) result)]
        (match result
          [(CompilerIrSpmdCallResult.Unit) unit]
          [(CompilerIrSpmdCallResult.Value dst _ ty)
            (compiler-reg-var-type-array-set! present types dst ty)]))]
    [(CompilerIrInstr.Phi dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(CompilerIrInstr.Pack dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(CompilerIrInstr.Word dst _ _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [_ unit]))

(define (compiler-reg-instr-seq-types-array!
  [instrs : CompilerIrInstrSeq]
  [present : (Array i64)]
  [types : (Array AstType)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-instr-def-type-array!
            (array-ref slots index)
            present
            types)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-block-list-types-array!
  [blocks : CompilerIrBlockList]
  [present : (Array i64)]
  [types : (Array AstType)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-instr-seq-types-array! instrs present types)
            (compiler-reg-block-list-types-array! (box-get rest) present types))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-instr-seq-types-array! instrs present types)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-var-type-arrays-to-list
  [present : (Array i64)]
  [types : (Array AstType)]
  [index : i64]
  [acc : CompilerRegVarTypeList]) : CompilerRegVarTypeList
  (if (< index 0)
    acc
    (compiler-reg-var-type-arrays-to-list
      present
      types
      (- index 1)
      (if (= (array-ref present index) 0)
        acc
        (compiler-reg-var-type-cons
          (CompilerRegVarType index (array-ref types index))
          acc)))))

;; Materialize the ascending-id cons form of an array view, for the arms that
;; still walk entries rather than index them.
(define (compiler-reg-var-type-seq-to-list [types : CompilerRegVarTypes]) : CompilerRegVarTypeList
  (compiler-reg-var-type-arrays-to-list
    (struct-get types present)
    (struct-get types items)
    (- (array-length (struct-get types present)) 1)
    CompilerRegVarTypeList.Nil))

(define (compiler-reg-function-var-types [func : CompilerIrFunction]) : CompilerRegVarTypes
  (match func
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [present : (Array i64) (array.make-array i64 vars)]
        [types : (Array AstType) (array.make-array AstType vars)]
        (begin
          (compiler-reg-param-types-array! params present types)
          (compiler-reg-block-list-types-array! blocks present types)
          (CompilerRegVarTypes present types)))]))

(define (compiler-reg-move-list-contains?
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]) : bool
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [index : i64 (- (struct-get moves len) 1)]
    [found : bool false]
    (begin
      (while (and (>= index 0) (not found))
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [found-src : i64 (struct-get item src)]
            [found-dst : i64 (struct-get item dst)]
            (if (and (= found-src src) (= found-dst dst))
              (set! found true)
              unit))
          (set! index (- index 1))))
      found)))

(define (compiler-reg-move-list-contains-undirected?
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]) : bool
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [index : i64 (- (struct-get moves len) 1)]
    [found : bool false]
    (begin
      (while (and (>= index 0) (not found))
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [found-src : i64 (struct-get item src)]
            [found-dst : i64 (struct-get item dst)]
            (if (or
              (and (= found-src src) (= found-dst dst))
              (and (= found-src dst) (= found-dst src)))
              (set! found true)
              unit))
          (set! index (- index 1))))
      found)))

(define (compiler-reg-move-list-empty? [moves : CompilerRegMoveSeq]) : bool
  (= (struct-get moves len) 0))

(define (compiler-reg-move-parallel-resource [var : i64]) : i64
  (+ var 1))

(define (compiler-reg-move-parallel-id [src : i64] [dst : i64]) : i64
  (+ (* (+ src 1) 1000000) (+ dst 1)))

(define (compiler-reg-move-parallel-edge [move : CompilerRegMove]) : pmove.CompilerParallelMoveEdge
  (pmove.ParallelMoveEdge
    (compiler-reg-move-parallel-id (struct-get move src) (struct-get move dst))
    (compiler-reg-move-parallel-resource (struct-get move dst))
    0
    (compiler-reg-move-parallel-resource (struct-get move src))
    0))

(define (compiler-reg-move-list-parallel-edges [moves : CompilerRegMoveSeq]) : pmove.CompilerParallelMoveEdgeList
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [count : i64 (struct-get moves len)]
    [index : i64 0]
    [edges : pmove.CompilerParallelMoveEdgeList pmove.CompilerParallelMoveNil]
    (begin
      (while (< index count)
        (begin
          (set!
            edges
            (pmove.compiler-parallel-move-edge-cons
              (compiler-reg-move-parallel-edge (array-ref slots index))
              edges))
          (set! index (+ index 1))))
      edges)))

(define (compiler-reg-move-list-parallel-decision [moves : CompilerRegMoveSeq]) : pmove.CompilerParallelMoveDecision
  (let
    [edges : pmove.CompilerParallelMoveEdgeList
      (compiler-reg-move-list-parallel-edges moves)]
    (pmove.compiler-parallel-move-decision edges edges)))

(define (compiler-reg-move-list-parallel-decision-ok?) : bool
  (let
    [chain : CompilerRegMoveSeq
      (compiler-reg-move-seq-push
        (compiler-reg-move-seq-push
          (compiler-reg-move-seq-empty)
          (CompilerRegMove 1 2 false))
        (CompilerRegMove 0 1 false))]
    [cycle : CompilerRegMoveSeq
      (compiler-reg-move-seq-push
        (compiler-reg-move-seq-push
          (compiler-reg-move-seq-empty)
          (CompilerRegMove 1 0 false))
        (CompilerRegMove 0 1 false))]
    (and
      (match (compiler-reg-move-list-parallel-decision chain)
        [(pmove.CompilerParallelMoveUnblocked id)
          (= id (compiler-reg-move-parallel-id 1 2))]
        [_ false])
      (match (compiler-reg-move-list-parallel-decision cycle)
        [(pmove.CompilerParallelMoveCycle id)
          (= id (compiler-reg-move-parallel-id 0 1))]
        [_ false]))))

;; Marks the NEWEST undirected match (the head of the former cons list) strict.
(define (compiler-reg-move-list-mark-strict
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]) : CompilerRegMoveSeq
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [index : i64 (- (struct-get moves len) 1)]
    (begin
      (while (>= index 0)
        (let
          [item : CompilerRegMove (array-ref slots index)]
          [found-src : i64 (struct-get item src)]
          [found-dst : i64 (struct-get item dst)]
          (if (or
            (and (= found-src src) (= found-dst dst))
            (and (= found-src dst) (= found-dst src)))
            (begin
              (array-set!
                slots
                index
                (CompilerRegMove found-src found-dst true))
              (set! index (- 0 1)))
            (set! index (- index 1)))))
      moves)))

(define (compiler-reg-move-list-add
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]
  [strict : bool]
  [undirected : bool]) : CompilerRegMoveSeq
  (if (= src dst)
    moves
    (if (if undirected
      (compiler-reg-move-list-contains-undirected? moves src dst)
      (compiler-reg-move-list-contains? moves src dst))
      (if strict
        (compiler-reg-move-list-mark-strict moves src dst)
        moves)
      (compiler-reg-move-seq-push moves (CompilerRegMove src dst strict)))))

(define (compiler-reg-phi-input-moves
  [dst : i64]
  [inputs : CompilerIrPhiInputList]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) moves]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-input-moves
        dst
        (compiler-ir-phi-input-seq-to-list seq)
        moves
        strict-pairs)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (let
        [tail : CompilerRegMoveSeq
          (compiler-reg-phi-input-moves dst (box-get rest) moves strict-pairs)]
        (match value
          [(CompilerIrValue.Var src)
            (compiler-reg-move-list-add tail src dst strict-pairs strict-pairs)]
          [_ tail]))]))

(define (compiler-reg-instr-moves
  [instr : CompilerIrInstr]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var var)
          (compiler-reg-move-list-add moves var dst false strict-pairs)]
        [_ moves])]
    [(CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-phi-input-moves dst inputs moves strict-pairs)]
    [_ moves]))

(define (compiler-reg-instr-seq-moves
  [instrs : CompilerIrInstrSeq]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [out : CompilerRegMoveSeq moves]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-reg-instr-moves (array-ref slots index) out strict-pairs))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-block-list-moves
  [blocks : CompilerIrBlockList]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match blocks
    [(CompilerIrBlockList.Nil) moves]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-block-list-moves
            (box-get rest)
            (compiler-reg-instr-seq-moves instrs moves strict-pairs)
            strict-pairs)])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerRegMoveSeq moves]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-instr-seq-moves instrs out strict-pairs))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-function-moves
  [func : CompilerIrFunction]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-block-list-moves
        blocks
        (compiler-reg-move-seq-empty)
        strict-pairs)]))

;; M-C (part 1): a 64-bit-width integer cast (i64 <-> u64) is a pure register
;; copy -- the optimizer deliberately KEEPS same-width sign-reinterpreting casts
;; as IrInstrCast (opt-int-cast-as-mov?) and the backend emits them as a plain
;; `movq src-home, dst-home` (compiler-backend-emit-cast, the same-size arm),
;; eliding it when the homes coincide. The bounds-check index temp is exactly
;; this shape (lower-cast-value i64->u64 feeding IrInstrBoundsCheck). Narrower
;; same-width casts (i32<->u32 ...) are excluded: their register homes hold the
;; sign/zero-NORMALIZED 64-bit value, which differs between the signednesses,
;; so those pairs are not same-valued at the 64-bit register level.
(define (compiler-reg-int-width-64? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.U64) true]
    [_ false]))

(define (compiler-reg-cast-copy-64? [from-ty : AstType] [to-ty : AstType]) : bool
  (and (compiler-reg-int-width-64? from-ty) (compiler-reg-int-width-64? to-ty)))

;; Scalar operations whose backend lowering can destructively reuse an operand
;; home for the result. Comparisons produce a fresh boolean through cmp/setcc;
;; div/mod use fixed rax:rdx and are not ordinary operand ties.
(define (compiler-reg-binop-destructive-tie? [op : CompilerIrBinOp]) : bool
  (and
    (not (compiler-reg-clobber-binop-div? op))
    (not (compiler-ir-binop-compare? op))))

(define (compiler-reg-binop-destructive-commutative? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Add) true]
    [(CompilerIrBinOp.Mul) true]
    [(CompilerIrBinOp.And) true]
    [(CompilerIrBinOp.Or) true]
    [(CompilerIrBinOp.BitAnd) true]
    [(CompilerIrBinOp.BitOr) true]
    [(CompilerIrBinOp.BitXor) true]
    [_ false]))

;; Harvest width-64 int casts as coalescable moves (M-C part 1). Kept SEPARATE
;; from compiler-reg-function-moves so the SIMD/AVX plan path and the post-hoc
;; loop-split/remat coalesce rebuilds stay byte-identical; only the scalar-opt2
;; plan-from seeds its move list with these (appended BEHIND the real moves so
;; existing first-wins copy-hint priorities are unchanged).
(define (compiler-reg-cast-move-instr
  [instr : CompilerIrInstr]
  [moves : CompilerRegMoveSeq]) : CompilerRegMoveSeq
  (match instr
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (match src
        [(CompilerIrValue.Var var)
          (if (compiler-reg-cast-copy-64? from-ty to-ty)
            (compiler-reg-move-list-add moves var dst false false)
            moves)]
        [_ moves])]
    [_ moves]))

(define (compiler-reg-cast-moves-seq
  [instrs : CompilerIrInstrSeq]
  [moves : CompilerRegMoveSeq]) : CompilerRegMoveSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [out : CompilerRegMoveSeq moves]
    (begin
      (while (>= index 0)
        (begin
          (set! out (compiler-reg-cast-move-instr (array-ref slots index) out))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-cast-moves-blocks
  [blocks : CompilerIrBlockList]
  [moves : CompilerRegMoveSeq]) : CompilerRegMoveSeq
  (match blocks
    [(CompilerIrBlockList.Nil) moves]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-cast-moves-blocks
            (box-get rest)
            (compiler-reg-cast-moves-seq instrs moves))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerRegMoveSeq moves]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-cast-moves-seq instrs out))])
              (set! i (+ i 1))))
          out))]))

;; Destructive ties are useful for chains, but feeding every scalar binop into
;; the general class coalescer makes arithmetic-heavy self-host functions
;; pathologically expensive. Build a bounded candidate set instead. A tie is
;; harvested when either endpoint is already move/phi-related, when its source is
;; another destructive result, or when its destination feeds another destructive
;; operation. This covers straight-line chains and phi-carried reductions while
;; skipping isolated arithmetic.
(define (compiler-reg-destructive-mark-move-vars!
  [moves : CompilerRegMoveSeq]
  [anchors : (Array i64)]) : unit
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [count : i64 (struct-get moves len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (let
          [item : CompilerRegMove (array-ref slots index)]
          [src : i64 (struct-get item src)]
          [dst : i64 (struct-get item dst)]
          (begin
            (if (and (>= src 0) (< src (array-length anchors)))
              (array-set! anchors src 1)
              unit)
            (if (and (>= dst 0) (< dst (array-length anchors)))
              (array-set! anchors dst 1)
              unit)))
        (set! index (+ index 1))))))

(define (compiler-reg-destructive-shape-instr!
  [instr : CompilerIrInstr]
  [defs : (Array i64)]
  [uses : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs _)
      (if (compiler-reg-binop-destructive-tie? op)
        (begin
          (if (and (>= dst 0) (< dst (array-length defs)))
            (array-set! defs dst 1)
            unit)
          (match lhs
            [(CompilerIrValue.Var var)
              (if (and (>= var 0) (< var (array-length uses)))
                (array-set! uses var 1)
                unit)]
            [_ unit])
          (if (compiler-reg-binop-destructive-commutative? op)
            (match rhs
              [(CompilerIrValue.Var var)
                (if (and (>= var 0) (< var (array-length uses)))
                  (array-set! uses var 1)
                  unit)]
              [_ unit])
            unit))
        unit)]
    [_ unit]))

(define (compiler-reg-destructive-shape-seq!
  [instrs : CompilerIrInstrSeq]
  [defs : (Array i64)]
  [uses : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-destructive-shape-instr!
          (array-ref slots index)
          defs
          uses)
        (set! index (+ index 1))))))

(define (compiler-reg-destructive-shape-blocks!
  [blocks : CompilerIrBlockList]
  [defs : (Array i64)]
  [uses : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-destructive-shape-seq! instrs defs uses)])
        (compiler-reg-destructive-shape-blocks! (box-get rest) defs uses))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-destructive-shape-seq! instrs defs uses)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-destructive-candidate?
  [src : i64]
  [dst : i64]
  [anchors : (Array i64)]
  [defs : (Array i64)]
  [uses : (Array i64)]
  [eligible : (Array i64)]) : bool
  (and
    (>= src 0)
    (< src (array-length anchors))
    (>= dst 0)
    (< dst (array-length anchors))
    (< src (array-length eligible))
    (< dst (array-length eligible))
    (= (array-ref eligible src) 1)
    (= (array-ref eligible dst) 1)
    (or
      (= (array-ref anchors src) 1)
      (= (array-ref anchors dst) 1)
      (= (array-ref defs src) 1)
      (= (array-ref uses dst) 1))))

(define (compiler-reg-destructive-add-value-tie
  [value : CompilerIrValue]
  [dst : i64]
  [moves : CompilerRegMoveSeq]
  [anchors : (Array i64)]
  [defs : (Array i64)]
  [uses : (Array i64)]
  [eligible : (Array i64)]) : CompilerRegMoveSeq
  (match value
    [(CompilerIrValue.Var src)
      (if (compiler-reg-destructive-candidate?
        src
        dst
        anchors
        defs
        uses
        eligible)
        (compiler-reg-move-list-add moves src dst false false)
        moves)]
    [_ moves]))

(define (compiler-reg-destructive-value-candidate?
  [value : CompilerIrValue]
  [dst : i64]
  [anchors : (Array i64)]
  [defs : (Array i64)]
  [uses : (Array i64)]
  [eligible : (Array i64)]) : bool
  (match value
    [(CompilerIrValue.Var src)
      (compiler-reg-destructive-candidate? src dst anchors defs uses eligible)]
    [_ false]))

(define (compiler-reg-destructive-tie-instr
  [instr : CompilerIrInstr]
  [moves : CompilerRegMoveSeq]
  [anchors : (Array i64)]
  [defs : (Array i64)]
  [uses : (Array i64)]
  [eligible : (Array i64)]) : CompilerRegMoveSeq
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs _)
      (if (compiler-reg-binop-destructive-tie? op)
        ;; Select exactly one destructive home. Prefer lhs whenever it is an
        ;; eligible chain candidate; for commutative operations, rhs is the
        ;; deterministic fallback when lhs cannot participate. Adding both
        ;; alternatives lets unrelated rhs values reshape otherwise-stable
        ;; coalesce classes and can increase register pressure.
        (if (compiler-reg-destructive-value-candidate?
          lhs
          dst
          anchors
          defs
          uses
          eligible)
          (compiler-reg-destructive-add-value-tie
            lhs
            dst
            moves
            anchors
            defs
            uses
            eligible)
          (if (compiler-reg-binop-destructive-commutative? op)
            (match lhs
              ;; A variable lhs remains the canonical destructive operand even
              ;; when it is not a chain candidate. Falling through to rhs in
              ;; that case perturbs unrelated arithmetic classes. A literal lhs
              ;; has no reusable home, so rhs is the only legal alternative.
              [(CompilerIrValue.Var _) moves]
              [_
                (match rhs
                  ;; Keep the alternate relation chain-shaped: the reusable rhs
                  ;; must itself be a destructive result. This covers operand-
                  ;; swapped commutative chains without turning literal-led
                  ;; standalone arithmetic into a global preference source.
                  [(CompilerIrValue.Var rhs-var)
                    (if (and
                      (>= rhs-var 0)
                      (< rhs-var (array-length defs))
                      (= (array-ref defs rhs-var) 1))
                      (compiler-reg-destructive-add-value-tie
                        rhs
                        dst
                        moves
                        anchors
                        defs
                        uses
                        eligible)
                      moves)]
                  [_ moves])])
            moves))
        moves)]
    [_ moves]))

(define (compiler-reg-destructive-tie-moves-seq
  [instrs : CompilerIrInstrSeq]
  [moves : CompilerRegMoveSeq]
  [anchors : (Array i64)]
  [defs : (Array i64)]
  [uses : (Array i64)]
  [eligible : (Array i64)]) : CompilerRegMoveSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [index : i64 (- (struct-get instrs len) 1)]
    [out : CompilerRegMoveSeq moves]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-reg-destructive-tie-instr
              (array-ref slots index)
              out
              anchors
              defs
              uses
              eligible))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-destructive-tie-moves-blocks
  [blocks : CompilerIrBlockList]
  [moves : CompilerRegMoveSeq]
  [anchors : (Array i64)]
  [defs : (Array i64)]
  [uses : (Array i64)]
  [eligible : (Array i64)]) : CompilerRegMoveSeq
  (match blocks
    [(CompilerIrBlockList.Nil) moves]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-destructive-tie-moves-blocks
            (box-get rest)
            (compiler-reg-destructive-tie-moves-seq
              instrs
              moves
              anchors
              defs
              uses
              eligible)
            anchors
            defs
            uses
            eligible)])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerRegMoveSeq moves]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-destructive-tie-moves-seq
                      instrs
                      out
                      anchors
                      defs
                      uses
                      eligible))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-function-destructive-tie-moves
  [func : CompilerIrFunction]
  [moves : CompilerRegMoveSeq]
  [eligible : (Array i64)]) : CompilerRegMoveSeq
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [anchors : (Array i64) (array.make-array i64 vars)]
        [defs : (Array i64) (array.make-array i64 vars)]
        [uses : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-destructive-mark-move-vars!
            (compiler-reg-function-moves func false)
            anchors)
          (compiler-reg-destructive-shape-blocks! blocks defs uses)
          (compiler-reg-destructive-tie-moves-blocks
            blocks
            moves
            anchors
            defs
            uses
            eligible)))]))

;; function-moves with the width-64 cast copies appended at the TAIL (the cast
;; list is built first and used as the seed accumulator the real moves are
;; prepended onto), so every existing move keeps its first-wins position for
;; copy-hints and the coalesce pass sees the cast pairs last.
(define (compiler-reg-function-moves-with-destructive-and-casts-eligible
  [func : CompilerIrFunction]
  [strict-pairs : bool]
  [eligible : (Array i64)]) : CompilerRegMoveSeq
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-block-list-moves
        blocks
        (compiler-reg-function-destructive-tie-moves
          func
          (compiler-reg-cast-moves-blocks blocks (compiler-reg-move-seq-empty))
          eligible)
        strict-pairs)]))

(define (compiler-reg-function-moves-with-destructive-and-casts
  [func : CompilerIrFunction]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match func
    [(CompilerIrFunction.Function _ _ _ vars _)
      (let
        [eligible : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array eligible 1)
          (compiler-reg-function-moves-with-destructive-and-casts-eligible
            func
            strict-pairs
            eligible)))]))

(define (compiler-reg-move-list-filter-storage-identity
  [moves : CompilerRegMoveSeq]
  [storage-vars : CompilerLiveI64Set]) : CompilerRegMoveSeq
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [count : i64 (struct-get moves len)]
    [index : i64 0]
    [out : CompilerRegMoveSeq (compiler-reg-move-seq-empty)]
    (begin
      (while (< index count)
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [src : i64 (struct-get item src)]
            [dst : i64 (struct-get item dst)]
            (if (or
              (compiler-live-set-contains? storage-vars src)
              (compiler-live-set-contains? storage-vars dst))
              unit
              (set! out (compiler-reg-move-seq-push out item))))
          (set! index (+ index 1))))
      out)))

;; For a NON-zero `value`, or for an array being *re*-initialised. `make-array`
;; of an i64 array already hands back zeroed memory, so a `... 0` fill directly
;; after the allocation repeats the allocator's work with a scalar loop.
(define (compiler-reg-fill-i64-array [items : (Array i64)] [value : i64]) : unit
  (let
    [index : i64 0]
    [count : i64 (array-length items)]
    (begin
      (while (< index count)
        (begin
          (array-set! items index value)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-select-false-preference-instr!
  [instr : CompilerIrInstr]
  [preferences : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [false-value (struct-get (box-get payload-box) on-false)]
        (match false-value
          [(CompilerIrValue.Var false-var)
            (if (and (>= dst 0) (< dst (array-length preferences)))
              (array-set! preferences dst false-var)
              unit)]
          [_ unit]))]
    [_ unit]))

(define (compiler-reg-select-false-preference-seq!
  [instrs : CompilerIrInstrSeq]
  [preferences : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-select-false-preference-instr!
            (array-ref slots index)
            preferences)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-select-false-preference-blocks!
  [blocks : CompilerIrBlockList]
  [preferences : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-select-false-preference-seq! instrs preferences)])
        (compiler-reg-select-false-preference-blocks!
          (box-get rest)
          preferences))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-select-false-preference-seq! instrs preferences)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-select-false-preferences
  [func : CompilerIrFunction]
  [vars : i64]) : (Array i64)
  (let
    [preferences : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-reg-fill-i64-array preferences -1)
      (match func
        [(CompilerIrFunction.Function _ _ _ _ blocks)
          (compiler-reg-select-false-preference-blocks! blocks preferences)])
      preferences)))

(define (compiler-reg-fill-location-array
  [items : (Array CompilerRegLocation)]
  [value : CompilerRegLocation]) : unit
  (let
    [index : i64 0]
    [count : i64 (array-length items)]
    (begin
      (while (< index count)
        (begin
          (array-set! items index value)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-assignment-index-fill!
  [assignments : CompilerRegAssignmentList]
  [present : (Array i64)]
  [items : (Array CompilerRegLocation)]) : unit
  (match assignments
    [(CompilerRegAssignmentList.Nil) unit]
    [(CompilerRegAssignmentList.Cons item rest)
      (begin
        (let
          [var : i64 (struct-get item var)]
          (if (or
            (< var 0)
            (>= var (array-length present))
            (not (= (array-ref present var) 0)))
            unit
            (begin
              (array-set! present var 1)
              (array-set! items var (struct-get item location)))))
        (compiler-reg-assignment-index-fill! (box-get rest) present items))]))

(define (compiler-reg-assignment-index-build
  [assignments : CompilerRegAssignmentList]
  [vars : i64]) : CompilerRegAssignmentIndex
  (let
    [present : (Array i64) (array.make-array i64 vars)]
    [items : (Array CompilerRegLocation)
      (array.make-array CompilerRegLocation vars)]
    (begin
      (compiler-reg-fill-location-array items (CompilerRegLocation.Spill 0))
      (compiler-reg-assignment-index-fill! assignments present items)
      (CompilerRegAssignmentIndex present items))))

(define (compiler-reg-assignment-index-lookup
  [index : CompilerRegAssignmentIndex]
  [var : i64]) : CompilerRegMaybeLocation
  (let
    [present : (Array i64) (struct-get index present)]
    [items : (Array CompilerRegLocation) (struct-get index items)]
    (if (or (< var 0) (>= var (array-length present)))
      CompilerRegMaybeLocation.No
      (if (= (array-ref present var) 0)
        CompilerRegMaybeLocation.No
        (CompilerRegMaybeLocation.Some (array-ref items var))))))

(define (compiler-reg-assignment-table-make [vars : i64]) : CompilerRegAssignmentTable
  (let
    [n : i64
      (if (< vars 1)
        1
        vars)]
    [present : (Array i64) (array.make-array i64 n)]
    [items : (Array CompilerRegLocation)
      (array.make-array CompilerRegLocation n)]
    (begin
      (compiler-reg-fill-location-array items (CompilerRegLocation.Spill 0))
      (CompilerRegAssignmentTable present items))))

(define (compiler-reg-assignment-table-insert
  [assignments : CompilerRegAssignmentTable]
  [var : i64]
  [location : CompilerRegLocation]) : CompilerRegAssignmentTable
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    (begin
      (if (or (< var 0) (>= var (array-length present)))
        unit
        (begin
          (array-set! present var 1)
          (array-set! items var location)))
      assignments)))

;; RAGreedy Component 1: drop a var's current assignment (present[var]=0) without
;; choosing a new location. The evict-and-requeue worklist UNASSIGNS an evicted
;; resident here (rather than whole-spilling it via insert-Spill) so it can be
;; re-enqueued and given a fresh allocation attempt. items[var] is left stale; it
;; is dead while present[var]=0 and is overwritten on the next insert.
(define (compiler-reg-assignment-table-unassign
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : CompilerRegAssignmentTable
  (let
    [present : (Array i64) (struct-get assignments present)]
    (begin
      (if (or (< var 0) (>= var (array-length present)))
        unit
        (array-set! present var 0))
      assignments)))

(define (compiler-reg-assignment-table-lookup
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : CompilerRegMaybeLocation
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    (if (or (< var 0) (>= var (array-length present)))
      CompilerRegMaybeLocation.No
      (if (= (array-ref present var) 0)
        CompilerRegMaybeLocation.No
        (CompilerRegMaybeLocation.Some (array-ref items var))))))

(define (compiler-reg-assignment-table-has-spill-from?
  [assignments : CompilerRegAssignmentTable]
  [index : i64]) : bool
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    (cond
      [(>= index (array-length present)) false]
      [(= (array-ref present index) 0)
        (compiler-reg-assignment-table-has-spill-from? assignments (+ index 1))]
      [else
        (match (array-ref items index)
          [(CompilerRegLocation.Spill _) true]
          [_
            (compiler-reg-assignment-table-has-spill-from?
              assignments
              (+ index 1))])])))

(define (compiler-reg-assignment-table-has-spill?
  [assignments : CompilerRegAssignmentTable]) : bool
  (compiler-reg-assignment-table-has-spill-from? assignments 0))

(define (compiler-reg-assignment-table-to-list-from
  [assignments : CompilerRegAssignmentTable]
  [index : i64]
  [out : CompilerRegAssignmentList]) : CompilerRegAssignmentList
  (if (< index 0)
    out
    (let
      [present : (Array i64) (struct-get assignments present)]
      [items : (Array CompilerRegLocation) (struct-get assignments items)]
      (compiler-reg-assignment-table-to-list-from
        assignments
        (- index 1)
        (if (= (array-ref present index) 0)
          out
          (compiler-reg-assignment-cons
            (CompilerRegAssignment index (array-ref items index))
            out))))))

(define (compiler-reg-assignment-table-to-list
  [assignments : CompilerRegAssignmentTable]) : CompilerRegAssignmentList
  (compiler-reg-assignment-table-to-list-from
    assignments
    (- (array-length (struct-get assignments present)) 1)
    CompilerRegAssignmentList.Nil))

(define (compiler-reg-interval-index-fill!
  [intervals : CompilerRegIntervalSeq]
  [starts : (Array i64)]
  [ends : (Array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 (struct-get interval var)]
          (if (or
            (< var 0)
            (>= var (array-length starts))
            (>= (array-ref starts var) 0))
            unit
            (begin
              (array-set! starts var (struct-get interval start))
              (array-set! ends var (struct-get interval end)))))
        (set! index (+ index 1))))))

(define (compiler-reg-interval-index-build
  [intervals : CompilerRegIntervalSeq]
  [vars : i64]) : CompilerRegIntervalIndex
  (let
    [starts : (Array i64) (array.make-array i64 vars)]
    [ends : (Array i64) (array.make-array i64 vars)]
    [segments : (Array CompilerRegIntervalSeq)
      (array.make-array CompilerRegIntervalSeq 0)]
    (begin
      (compiler-reg-fill-i64-array starts -1)
      (compiler-reg-fill-i64-array ends -1)
      (compiler-reg-interval-index-fill! intervals starts ends)
      (CompilerRegIntervalIndex starts ends segments))))

(define (compiler-reg-interval-index-lookup
  [index : CompilerRegIntervalIndex]
  [var : i64]) : CompilerRegMaybeInterval
  (let
    [starts : (Array i64) (struct-get index starts)]
    [ends : (Array i64) (struct-get index ends)]
    (if (or (< var 0) (>= var (array-length starts)))
      CompilerRegMaybeInterval.No
      (if (< (array-ref starts var) 0)
        CompilerRegMaybeInterval.No
        (CompilerRegMaybeInterval.Some
          (CompilerRegInterval var (array-ref starts var) (array-ref ends var)))))))

(define (compiler-reg-extend-interval
  [starts : (Array i64)]
  [ends : (Array i64)]
  [var : i64]
  [point : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length starts))
      unit
      (let
        [start : i64 (array-ref starts var)]
        [end : i64 (array-ref ends var)]
        (begin
          (if (< start 0)
            (begin
              (array-set! starts var point)
              (array-set! ends var point))
            (begin
              (if (< point start)
                (array-set! starts var point)
                unit)
              (if (> point end)
                (array-set! ends var point)
                unit)))
          unit)))))

(define (compiler-reg-low-bit-index [bits : i64]) : i64
  (let
    [value : i64 bits]
    [offset : i64 0]
    (begin
      (if (= (bit-and value 0xffffffff) 0)
        (begin
          (set! value (shr value 32))
          (set! offset (+ offset 32)))
        unit)
      (if (= (bit-and value 0xffff) 0)
        (begin
          (set! value (shr value 16))
          (set! offset (+ offset 16)))
        unit)
      (if (= (bit-and value 0xff) 0)
        (begin
          (set! value (shr value 8))
          (set! offset (+ offset 8)))
        unit)
      (if (= (bit-and value 0xf) 0)
        (begin
          (set! value (shr value 4))
          (set! offset (+ offset 4)))
        unit)
      (if (= (bit-and value 0x3) 0)
        (begin
          (set! value (shr value 2))
          (set! offset (+ offset 2)))
        unit)
      (if (= (bit-and value 0x1) 0)
        (+ offset 1)
        offset))))

;; Live-set and greedy-occupancy words use only their low 32 bits. Isolate the
;; lowest set bit and map its 32-bit De Bruijn product to the bit index. This
;; replaces the five dependent branch-and-shift steps in the hot register-
;; allocator scans with one multiply and one compact table lookup.
(define compiler-reg-low-bit-index32-table : (Array i64 32)
  (array
    (cast 0 : i64)
    1
    28
    2
    29
    14
    24
    3
    30
    22
    20
    15
    25
    17
    4
    8
    31
    27
    13
    23
    21
    19
    16
    7
    26
    12
    18
    6
    11
    5
    10
    9))

(defmacro (compiler-reg-low-bit-index32 [bits : i64]) : i64
  `(let
    [value : i64 (bit-and ,bits 0xffffffff)]
    (if (= value 0)
      (cast 31 : i64)
      (let
        [isolated : i64 (bit-and value (- 0 value))]
        [slot : i64 (shr (bit-and (* isolated 0x077cb531) 0xffffffff) 27)]
        (cast (array-ref compiler-reg-low-bit-index32-table slot) : i64)))))

(define (compiler-reg-segment-flush-var!
  [segments : (Array CompilerRegIntervalSeq)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [var : i64]) : unit
  (if (or (< var 0) (>= var (array-length starts)) (< (array-ref starts var) 0))
    unit
    (let
      [existing : CompilerRegIntervalSeq (array-ref segments var)]
      [interval : CompilerRegInterval
        (CompilerRegInterval var (array-ref starts var) (array-ref ends var))]
      (begin
        (if (compiler-reg-interval-seq-empty? existing)
          (let
            [slots : (Array CompilerRegInterval)
              (array.make-array CompilerRegInterval 1)]
            (begin
              (array-set! slots 0 interval)
              (array-set! segments var (CompilerRegIntervalSeq slots 1))))
          (array-set!
            segments
            var
            (compiler-reg-interval-seq-append existing interval)))
        (array-set! starts var -1)
        (array-set! ends var -1)
        unit))))

(define (compiler-reg-segment-note-point!
  [segments : (Array CompilerRegIntervalSeq)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [var : i64]
  [point : i64]) : unit
  (if (or (< var 0) (>= var (array-length starts)))
    unit
    (if (< (array-ref starts var) 0)
      (begin
        (array-set! starts var point)
        (array-set! ends var point))
      (let
        [end : i64 (array-ref ends var)]
        (if (<= point (+ end 1))
          (if (> point end)
            (array-set! ends var point)
            unit)
          (begin
            (compiler-reg-segment-flush-var! segments starts ends var)
            (array-set! starts var point)
            (array-set! ends var point)))))))

(define (compiler-reg-extend-segment-set-word-bits!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]
  [bits : i64]
  [var : i64]
  [point : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [index : i64 (compiler-reg-low-bit-index32 bits)]
      [item-var : i64 (+ var index)]
      (begin
        (compiler-reg-extend-interval starts ends item-var point)
        (compiler-reg-segment-note-point!
          segments
          segment-starts
          segment-ends
          item-var
          point)
        (compiler-reg-extend-segment-set-word-bits!
          starts
          ends
          segments
          segment-starts
          segment-ends
          (bit-and bits (- bits 1))
          var
          point)))))

(define (compiler-reg-extend-segment-set-words!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]
  [set : CompilerLiveI64Set]
  [word-index : i64]
  [point : i64]) : unit
  (let
    [index : i64 word-index]
    [word-count : i64 (compiler-live-set-word-count set)]
    (while (< index word-count)
      (begin
        ;; Empty words are the common case in a sparse live set, and
        ;; `compiler-reg-extend-segment-set-word-bits!` does nothing for them --
        ;; it tests `bits` against zero before anything else. Testing here
        ;; instead skips setting up an eight-argument call per empty word;
        ;; behaviour is unchanged because the callee was already a no-op.
        (let
          [bits : i64 (compiler-live-set-word-at-bounded set index)]
          (if (= bits 0)
            unit
            (compiler-reg-extend-segment-set-word-bits!
              starts
              ends
              segments
              segment-starts
              segment-ends
              bits
              (* index (compiler-live-set-word-bits))
              point)))
        (set! index (+ index 1))))))

;; Note a live point into the per-var SEGMENTS only, WITHOUT
;; touching the coarse [start,end] interval. Bridges pass-through liveness so a
;; value live ACROSS an instruction is one continuous segment. Coarse already
;; spans this interior point (min..max), so leaving it untouched keeps the
;; linear-scan placement byte-identical -- only segment-precise interference
;; (consumed by coalescing) is corrected.
(define (compiler-reg-segment-note-set-word-bits!
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]
  [bits : i64]
  [var : i64]
  [point : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [index : i64 (compiler-reg-low-bit-index32 bits)]
      [item-var : i64 (+ var index)]
      (begin
        (compiler-reg-segment-note-point!
          segments
          segment-starts
          segment-ends
          item-var
          point)
        (compiler-reg-segment-note-set-word-bits!
          segments
          segment-starts
          segment-ends
          (bit-and bits (- bits 1))
          var
          point)))))

(define (compiler-reg-segment-note-set-words!
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]
  [set : CompilerLiveI64Set]
  [word-index : i64]
  [point : i64]) : unit
  (let
    [index : i64 word-index]
    [word-count : i64 (compiler-live-set-word-count set)]
    (while (< index word-count)
      (begin
        ;; Same as `compiler-reg-extend-segment-set-words!`: the callee returns
        ;; immediately for an empty word, so testing here skips the call setup
        ;; for the common case without changing what happens.
        (let
          [bits : i64 (compiler-live-set-word-at-bounded set index)]
          (if (= bits 0)
            unit
            (compiler-reg-segment-note-set-word-bits!
              segments
              segment-starts
              segment-ends
              bits
              (* index (compiler-live-set-word-bits))
              point)))
        (set! index (+ index 1))))))

(define (compiler-reg-extend-segment-instr!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]
  [live-after : CompilerLiveI64Set]
  [point : i64]
  [instr : CompilerIrInstr]) : unit
  (begin
    (compiler-reg-extend-segment-set-words!
      starts
      ends
      segments
      segment-starts
      segment-ends
      (compiler-live-instr-defs instr)
      0
      point)
    (compiler-reg-extend-segment-set-words!
      starts
      ends
      segments
      segment-starts
      segment-ends
      (compiler-live-instr-uses instr)
      0
      point)
    ;; Bridge live-after values into the SEGMENT at `point` (LLVM
    ;; SlotIndex semantics: a value live-OUT of this instruction is live AT it),
    ;; making a pass-through value one continuous segment instead of degenerate
    ;; single-point segments that wrongly fail the half-open overlap test. A value
    ;; whose LAST use is here is NOT in live-after, so it still ends at `point`,
    ;; preserving the def/use touch that lets a copy/two-address result coalesce.
    ;; Defs are already marked at `point` above, so this never extends a def back.
    (compiler-reg-segment-note-set-words!
      segments
      segment-starts
      segment-ends
      live-after
      0
      point)
    (compiler-reg-extend-segment-set-words!
      starts
      ends
      segments
      segment-starts
      segment-ends
      live-after
      0
      (+ point 1))))

(define (compiler-reg-extend-set-words
  [starts : (Array i64)]
  [ends : (Array i64)]
  [set : CompilerLiveI64Set]
  [word-index : i64]
  [point : i64]) : unit
  (let
    [index : i64 word-index]
    [word-count : i64 (compiler-live-set-word-count set)]
    (while (< index word-count)
      (begin
        ;; `compiler-reg-extend-set-word-bits` returns immediately for an empty
        ;; word, so testing here skips the call setup for the common case.
        (let
          [bits : i64 (compiler-live-set-word-at-bounded set index)]
          (if (= bits 0)
            unit
            (compiler-reg-extend-set-word-bits
              starts
              ends
              bits
              (* index (compiler-live-set-word-bits))
              point)))
        (set! index (+ index 1))))))

(define (compiler-reg-extend-set-word-bits
  [starts : (Array i64)]
  [ends : (Array i64)]
  [bits : i64]
  [var : i64]
  [point : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [index : i64 (compiler-reg-low-bit-index32 bits)]
      (begin
        (compiler-reg-extend-interval starts ends (+ var index) point)
        (compiler-reg-extend-set-word-bits
          starts
          ends
          (bit-and bits (- bits 1))
          var
          point)))))

(define (compiler-reg-extend-instr
  [starts : (Array i64)]
  [ends : (Array i64)]
  [live-after : CompilerLiveI64Set]
  [point : i64]
  [instr : CompilerIrInstr]) : unit
  (begin
    (compiler-reg-extend-set-words
      starts
      ends
      (compiler-live-instr-defs instr)
      0
      point)
    (compiler-reg-extend-set-words
      starts
      ends
      (compiler-live-instr-uses instr)
      0
      point)
    (compiler-reg-extend-set-words starts ends live-after 0 (+ point 1))))

(define (compiler-reg-live-intervals-instr-seq
  [instrs : CompilerIrInstrSeq]
  [live-afters : CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [after-items : (Array CompilerLiveI64Set) (struct-get live-afters items)]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [live-after : CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (compiler-live-set-empty))]
          (begin
            (compiler-reg-extend-instr
              starts
              ends
              live-after
              out-point
              (array-ref slots index))
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-live-intervals-find-afters
  [liveness : CompilerFunctionLiveness]
  [label : i64]) : CompilerLiveInstrSetVec
  (match (compiler-live-function-find-block liveness label)
    [(CompilerLiveMaybeBlock.Some live-block)
      (compiler-live-block-instr-after live-block)]
    [(CompilerLiveMaybeBlock.No) (compiler-live-instr-set-vec-empty)]))

(define (compiler-reg-live-intervals-blocks-with-live
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) point]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [live-afters : CompilerLiveInstrSetVec
              (compiler-reg-live-intervals-find-afters liveness label)]
            (compiler-reg-live-intervals-blocks-with-live
              (box-get rest)
              liveness
              (compiler-reg-live-intervals-instr-seq
                instrs
                live-afters
                point
                starts
                ends)
              starts
              ends))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block label instrs)
                  (let
                    [live-afters : CompilerLiveInstrSetVec
                      (compiler-reg-live-intervals-find-afters liveness label)]
                    (set!
                      out-point
                      (compiler-reg-live-intervals-instr-seq
                        instrs
                        live-afters
                        out-point
                        starts
                        ends)))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-interval-arrays-to-seq
  [starts : (Array i64)]
  [ends : (Array i64)]
  [index : i64]
  [acc : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [old-slots : (Array CompilerRegInterval) (struct-get acc slots)]
    [old-len : i64 (struct-get acc len)]
    [additional-capacity : i64
      (if (< index 0)
        0
        (+ index 1))]
    [slots : (Array CompilerRegInterval)
      (array.make-array CompilerRegInterval (+ old-len additional-capacity))]
    [out-len : i64 old-len]
    [copy-index : i64 0]
    [var : i64 0]
    (begin
      (while (< copy-index old-len)
        (begin
          (array-set! slots copy-index (array-ref old-slots copy-index))
          (set! copy-index (+ copy-index 1))))
      (while (<= var index)
        (begin
          (if (< (array-ref starts var) 0)
            unit
            (begin
              (array-set!
                slots
                out-len
                (CompilerRegInterval
                  var
                  (array-ref starts var)
                  (array-ref ends var)))
              (set! out-len (+ out-len 1))))
          (set! var (+ var 1))))
      (CompilerRegIntervalSeq slots out-len))))

(define (compiler-reg-live-intervals
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]) : CompilerRegIntervalSeq
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [starts : (Array i64) (array.make-array i64 vars)]
        [ends : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (compiler-reg-live-intervals-blocks-with-live
            blocks
            liveness
            0
            starts
            ends)
          (compiler-reg-interval-arrays-to-seq
            starts
            ends
            (- vars 1)
            (compiler-reg-interval-seq-empty))))]))

(define (compiler-reg-live-interval-selection-instr-seq
  [instrs : CompilerIrInstrSeq]
  [live-afters : CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [after-items : (Array CompilerLiveI64Set) (struct-get live-afters items)]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [live-after : CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (compiler-live-set-empty))]
          [instr : CompilerIrInstr (array-ref slots index)]
          (begin
            (compiler-reg-extend-segment-instr!
              starts
              ends
              segments
              segment-starts
              segment-ends
              live-after
              out-point
              instr)
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-live-interval-selection-blocks
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) point]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [live-afters : CompilerLiveInstrSetVec
              (compiler-reg-live-intervals-find-afters liveness label)]
            (compiler-reg-live-interval-selection-blocks
              (box-get rest)
              liveness
              (compiler-reg-live-interval-selection-instr-seq
                instrs
                live-afters
                point
                starts
                ends
                segments
                segment-starts
                segment-ends)
              starts
              ends
              segments
              segment-starts
              segment-ends))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block label instrs)
                  (let
                    [live-afters : CompilerLiveInstrSetVec
                      (compiler-reg-live-intervals-find-afters liveness label)]
                    (set!
                      out-point
                      (compiler-reg-live-interval-selection-instr-seq
                        instrs
                        live-afters
                        out-point
                        starts
                        ends
                        segments
                        segment-starts
                        segment-ends)))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-live-interval-selection
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]) : CompilerRegIntervalSelection
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [starts : (Array i64) (array.make-array i64 vars)]
        [ends : (Array i64) (array.make-array i64 vars)]
        [segments : (Array CompilerRegIntervalSeq)
          (array.make-array CompilerRegIntervalSeq vars)]
        [segment-starts : (Array i64) (array.make-array i64 vars)]
        [segment-ends : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (compiler-reg-fill-i64-array segment-starts -1)
          (compiler-reg-fill-i64-array segment-ends -1)
          (compiler-reg-live-interval-selection-blocks
            blocks
            liveness
            0
            starts
            ends
            segments
            segment-starts
            segment-ends)
          (let
            [index : i64 0]
            (while (< index vars)
              (begin
                (compiler-reg-segment-flush-var!
                  segments
                  segment-starts
                  segment-ends
                  index)
                (set! index (+ index 1)))))
          (CompilerRegIntervalSelection.Selection
            (compiler-reg-interval-arrays-to-seq
              starts
              ends
              (- vars 1)
              (compiler-reg-interval-seq-empty))
            (CompilerRegIntervalIndex starts ends segments))))]))

;; ---------------------------------------------------------------------------
;; Edge-precise segment build (used only for the coalescer's interference index).
;; Identical to the conservative builder EXCEPT a phi instruction contributes NO
;; uses at the phi point -- its inputs are edge-uses, already kept live to the end
;; of their own predecessor by compiler-live-analyze-function-edge-precise's
;; phi-out live-out. The phi result is still a def at the phi point, and live-after
;; bridging is unchanged. This drops the spurious phi-input segments that make a
;; loop carry falsely interfere with itself.
;; ---------------------------------------------------------------------------
(define (compiler-reg-extend-segment-instr-ep!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]
  [live-after : CompilerLiveI64Set]
  [point : i64]
  [instr : CompilerIrInstr]) : unit
  (begin
    (compiler-reg-extend-segment-set-words!
      starts
      ends
      segments
      segment-starts
      segment-ends
      (compiler-live-instr-defs instr)
      0
      point)
    (match instr
      [(CompilerIrInstr.Phi _ _ _) unit]
      [_
        (compiler-reg-extend-segment-set-words!
          starts
          ends
          segments
          segment-starts
          segment-ends
          (compiler-live-instr-uses instr)
          0
          point)])
    (compiler-reg-segment-note-set-words!
      segments
      segment-starts
      segment-ends
      live-after
      0
      point)
    (compiler-reg-extend-segment-set-words!
      starts
      ends
      segments
      segment-starts
      segment-ends
      live-after
      0
      (+ point 1))))

(define (compiler-reg-live-interval-selection-ep-instr-seq
  [instrs : CompilerIrInstrSeq]
  [live-afters : CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [after-items : (Array CompilerLiveI64Set) (struct-get live-afters items)]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [live-after : CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (compiler-live-set-empty))]
          [instr : CompilerIrInstr (array-ref slots index)]
          (begin
            (compiler-reg-extend-segment-instr-ep!
              starts
              ends
              segments
              segment-starts
              segment-ends
              live-after
              out-point
              instr)
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-live-interval-selection-ep-blocks
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [segment-starts : (Array i64)]
  [segment-ends : (Array i64)]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) point]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [live-afters : CompilerLiveInstrSetVec
              (compiler-reg-live-intervals-find-afters liveness label)]
            (compiler-reg-live-interval-selection-ep-blocks
              (box-get rest)
              liveness
              (compiler-reg-live-interval-selection-ep-instr-seq
                instrs
                live-afters
                point
                starts
                ends
                segments
                segment-starts
                segment-ends)
              starts
              ends
              segments
              segment-starts
              segment-ends))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block label instrs)
                  (let
                    [live-afters : CompilerLiveInstrSetVec
                      (compiler-reg-live-intervals-find-afters liveness label)]
                    (set!
                      out-point
                      (compiler-reg-live-interval-selection-ep-instr-seq
                        instrs
                        live-afters
                        out-point
                        starts
                        ends
                        segments
                        segment-starts
                        segment-ends)))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-live-interval-selection-ep
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]) : CompilerRegIntervalIndex
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [starts : (Array i64) (array.make-array i64 vars)]
        [ends : (Array i64) (array.make-array i64 vars)]
        [segments : (Array CompilerRegIntervalSeq)
          (array.make-array CompilerRegIntervalSeq vars)]
        [segment-starts : (Array i64) (array.make-array i64 vars)]
        [segment-ends : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (compiler-reg-fill-i64-array segment-starts -1)
          (compiler-reg-fill-i64-array segment-ends -1)
          (compiler-reg-live-interval-selection-ep-blocks
            blocks
            liveness
            0
            starts
            ends
            segments
            segment-starts
            segment-ends)
          (let
            [index : i64 0]
            (while (< index vars)
              (begin
                (compiler-reg-segment-flush-var!
                  segments
                  segment-starts
                  segment-ends
                  index)
                (set! index (+ index 1)))))
          (CompilerRegIntervalIndex starts ends segments)))]))

;; ---------------------------------------------------------------------------
;; Hybrid coalescing interference index (SOUND containment of edge-precise).
;;
;; Edge-precise (EP) liveness is the precise SSA interference, but using it for
;; EVERY var is risky: a single EP bug for a non-carry value would mis-coalesce it.
;; We only NEED EP precision for the loop-carry phi web (phi results + their
;; inputs); every other value's conservative interference is already correct.
;;
;; So the hybrid index keeps the CONSERVATIVE coarse [start,end] for all vars and
;; the CONSERVATIVE segments for non-phi-touched vars, substituting EP segments
;; ONLY for phi-touched vars (a phi result or a phi input). Soundness: for a pair
;; (A phi-touched, B not), the overlap test compares A's EP segments against B's
;; CONSERVATIVE segments; since conservative over-approximates B's real liveness,
;; any real interference of A with B is still detected -- only A-vs-A' (both
;; phi-touched carry-web members) get the precise relaxation. A non-phi value (e.g.
;; a struct field bound by a match) therefore can never be wrongly coalesced.
;; ---------------------------------------------------------------------------
(define (compiler-reg-phi-touched-add-inputs!
  [inputs : CompilerIrPhiInputList]
  [mask : (Array i64)]) : unit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-touched-add-inputs!
        (compiler-ir-phi-input-seq-to-list seq)
        mask)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (match value
          [(CompilerIrValue.Var v) (compiler-reg-mark-phi-def! mask v)]
          [_ unit])
        (compiler-reg-phi-touched-add-inputs! (box-get rest) mask))]))

;; ---------------------------------------------------------------------------
;; Live-out-input phi exclusion (soundness guard on the EP coalescer).
;;
;; Edge-precise coalescing of a phi carry is safe only when every phi input DIES at
;; the phi -- i.e. is consumed on its predecessor edge and not live past the phi's
;; block. When an input is instead live-OUT of the phi block (e.g. a mutable loop
;; counter `v` that is a phi input to an in-loop `(if ... a v)` merge yet is also used
;; across the rest of the loop), its edge-precise segment collapses to the tiny
;; predecessor-edge slice, understating how entangled it is; coalescing this phi's
;; result with a (dead) sibling input then shares a register across a region where the
;; entangled input is genuinely live, corrupting it (this is exactly the
;; `compiler-reg-merged-root-index` self-host mis-coalesce the fixpoint caught).
;;
;; So a phi with ANY live-out input is normally EXCLUDED from EP relaxation: its
;; result and inputs fall back to conservative interference. The narrow exception is
;; a single-block self-loop back-edge value that is DEFINED in the block and has no
;; ordinary (non-phi) use there. Such a value is live-out only to feed successor phi
;; edges: sharing its storage with the header phi is exactly the destructive loop
;; carry, while a counter still used by the exit compare fails the non-phi-use proof.
;; Pure loop/if-merge carries whose inputs are all dead after the merge stay relaxed
;; as before. Using the sound EP block live-out here can only over-exclude (a missed
;; coalesce), never under-exclude.
;; ---------------------------------------------------------------------------
(define (compiler-reg-block-live-out-by-label
  [liveness : CompilerFunctionLiveness]
  [label : i64]) : CompilerLiveI64Set
  (match (compiler-live-function-find-block liveness label)
    [(CompilerLiveMaybeBlock.Some lb) (struct-get lb live-out)]
    [(CompilerLiveMaybeBlock.No) (compiler-live-set-empty)]))

(define (compiler-reg-phi-inputs-any-live-out?
  [inputs : CompilerIrPhiInputList]
  [live-out : CompilerLiveI64Set]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-inputs-any-live-out?
        (compiler-ir-phi-input-seq-to-list seq)
        live-out)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (if (match value
        [(CompilerIrValue.Var v) (compiler-live-set-contains? live-out v)]
        [_ false])
        true
        (compiler-reg-phi-inputs-any-live-out? (box-get rest) live-out))]))

(define (compiler-reg-instr-seq-defines-var?
  [instrs : CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (if (compiler-live-set-contains?
            (compiler-live-instr-defs (array-ref slots index))
            var)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-instr-seq-non-phi-uses-var?
  [instrs : CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (let
          [instr : CompilerIrInstr (array-ref slots index)]
          (begin
            (match instr
              [(CompilerIrInstr.Phi _ _ _) unit]
              [_
                (if (compiler-live-set-contains?
                  (compiler-live-instr-uses instr)
                  var)
                  (set! found true)
                  unit)])
            (set! index (+ index 1)))))
      found)))

(define (compiler-reg-phi-live-out-inputs-self-loop-safe?
  [inputs : CompilerIrPhiInputList]
  [live-out : CompilerLiveI64Set]
  [instrs : CompilerIrInstrSeq]
  [block-label : i64]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-live-out-inputs-self-loop-safe?
        (compiler-ir-phi-input-seq-to-list seq)
        live-out
        instrs
        block-label)]
    [(CompilerIrPhiInputList.Cons value predecessor rest)
      (and
        (match value
          [(CompilerIrValue.Var var)
            (if (compiler-live-set-contains? live-out var)
              (and
                (= predecessor block-label)
                (compiler-reg-instr-seq-defines-var? instrs var)
                (not (compiler-reg-instr-seq-non-phi-uses-var? instrs var)))
              true)]
          [_ true])
        (compiler-reg-phi-live-out-inputs-self-loop-safe?
          (box-get rest)
          live-out
          instrs
          block-label))]))

(define (compiler-reg-phi-touched-safe-seq!
  [instrs : CompilerIrInstrSeq]
  [live-out : CompilerLiveI64Set]
  [self-loop : bool]
  [block-label : i64]
  [mask : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(CompilerIrInstr.Phi dst inputs _)
              (if (and
                (compiler-reg-phi-inputs-any-live-out? inputs live-out)
                (not
                  (and
                    self-loop
                    (compiler-reg-phi-live-out-inputs-self-loop-safe?
                      inputs
                      live-out
                      instrs
                      block-label))))
                unit
                (begin
                  (compiler-reg-mark-phi-def! mask dst)
                  (compiler-reg-phi-touched-add-inputs! inputs mask)))]
            [_ unit])
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-phi-touched-safe-blocks!
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [allow-exit-live-self-loop : bool]
  [mask : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (begin
            (compiler-reg-phi-touched-safe-seq!
              instrs
              (compiler-reg-block-live-out-by-label liveness label)
              (and
                allow-exit-live-self-loop
                (compiler-live-label-set-contains?
                  (compiler-live-block-successors block)
                  label))
              label
              mask)
            (compiler-reg-phi-touched-safe-blocks!
              (box-get rest)
              liveness
              allow-exit-live-self-loop
              mask))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block label instrs)
                (compiler-reg-phi-touched-safe-seq!
                  instrs
                  (compiler-reg-block-live-out-by-label liveness label)
                  (and
                    allow-exit-live-self-loop
                    (compiler-live-label-set-contains?
                      (compiler-live-block-successors
                        (compiler-ir-block-seq-ref seq i))
                      label))
                  label
                  mask)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-phi-touched-safe-mode
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [allow-exit-live-self-loop : bool]) : (Array i64)
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [mask : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-phi-touched-safe-blocks!
            blocks
            liveness
            allow-exit-live-self-loop
            mask)
          mask))]))

(define (compiler-reg-function-phi-touched-safe
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]) : (Array i64)
  (compiler-reg-function-phi-touched-safe-mode func liveness true))

;; Hybrid segments: EP segments for phi-touched vars, conservative otherwise.
(define (compiler-reg-hybrid-coalesce-index
  [cons-index : CompilerRegIntervalIndex]
  [ep-index : CompilerRegIntervalIndex]
  [mask : (Array i64)]) : CompilerRegIntervalIndex
  (let
    [cons-starts : (Array i64) (struct-get cons-index starts)]
    [cons-ends : (Array i64) (struct-get cons-index ends)]
    [cons-segs : (Array CompilerRegIntervalSeq)
      (struct-get cons-index segments)]
    [ep-segs : (Array CompilerRegIntervalSeq) (struct-get ep-index segments)]
    [n : i64 (array-length cons-starts)]
    [hybrid-segs : (Array CompilerRegIntervalSeq)
      (array.make-array CompilerRegIntervalSeq n)]
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (array-set!
            hybrid-segs
            v
            (if (if (< v (array-length mask))
              (= (array-ref mask v) 1)
              false)
              (if (< v (array-length ep-segs))
                (array-ref ep-segs v)
                (compiler-reg-interval-seq-empty))
              (if (< v (array-length cons-segs))
                (array-ref cons-segs v)
                (compiler-reg-interval-seq-empty))))
          (set! v (+ v 1))))
      (CompilerRegIntervalIndex cons-starts cons-ends hybrid-segs))))

;; ---------------------------------------------------------------------------
;; Cheap block-level liveness for register planning (#perf).
;;
;; The register allocator only needs, per variable, a single [first-live,
;; last-live] interval, which can be built from block-level live-in/live-out plus
;; per-instruction mentions. This pass reuses the tested use/def/successor
;; extraction from compiler-live-build-blocks, then runs the backward dataflow
;; fixpoint over MUTABLE i64-word bitsets (in place, no per-operation allocation),
;; instead of the shared liveness pass's immutable linked-list bitset unions and
;; per-instruction live-after materialization. Block-level live-in/out keeps the
;; intervals sound across control flow that pure mention ranges miss (a
;; loop-carried value is live-out of the body and live-in of the header, so its
;; interval covers the whole loop). 63 data bits per word avoid the i64 sign bit.
;; ---------------------------------------------------------------------------
(define (compiler-reg-bits-words [vars : i64]) : i64
  (/ (+ vars 62) 63))

(define (compiler-reg-bits-set! [row : (Array i64)] [base : i64] [var : i64]) : unit
  (let
    [w : i64 (+ base (/ var 63))]
    (array-set! row w (bit-or (array-ref row w) (shl 1 (% var 63))))))

(define (compiler-reg-chunk->row!
  [row : (Array i64)]
  [base : i64]
  [bits : i64]
  [var-base : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [i : i64 (compiler-reg-low-bit-index32 bits)]
      (begin
        (compiler-reg-bits-set! row base (+ var-base i))
        (compiler-reg-chunk->row! row base (bit-and bits (- bits 1)) var-base)))))

(define (compiler-reg-set-words->row!
  [set : CompilerLiveI64Set]
  [row : (Array i64)]
  [base : i64]
  [word-index : i64]) : unit
  (if (>= word-index (compiler-live-set-word-count set))
    unit
    (begin
      (compiler-reg-chunk->row!
        row
        base
        (compiler-live-set-word-at-bounded set word-index)
        (* word-index (compiler-live-set-word-bits)))
      (compiler-reg-set-words->row! set row base (+ word-index 1)))))

(define (compiler-reg-set->row!
  [set : CompilerLiveI64Set]
  [row : (Array i64)]
  [base : i64]) : unit
  (compiler-reg-set-words->row! set row base 0))

(define (compiler-reg-live-block-succs [block : CompilerLiveBlock]) : CompilerLiveLabelSet
  (struct-get block successors))

(define (compiler-reg-bits-build-rows-from-array!
  [blocks : (Array CompilerLiveBlock)]
  [idmap : reg_label_i64_map.Map]
  [use-rows : (Array i64)]
  [def-rows : (Array i64)]
  [words : i64]
  [index : i64]) : reg_label_i64_map.Map
  (if (>= index (array-length blocks))
    idmap
    (let
      [block : CompilerLiveBlock (array-ref blocks index)]
      (begin
        (compiler-reg-set->row!
          (struct-get block uses)
          use-rows
          (* index words))
        (compiler-reg-set->row!
          (struct-get block defs)
          def-rows
          (* index words))
        (reg_label_i64_map.insert-ref!
          (&mut idmap)
          (struct-get block label)
          index)
        (compiler-reg-bits-build-rows-from-array!
          blocks
          idmap
          use-rows
          def-rows
          words
          (+ index 1))))))

(define (compiler-reg-bits-clear-row!
  [row : (Array i64)]
  [base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set! row (+ base w) 0)
          (set! w (+ w 1))))
      unit)))

(define (compiler-reg-bits-or-row!
  [dst : (Array i64)]
  [dbase : i64]
  [src : (Array i64)]
  [sbase : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (array-set!
            dst
            (+ dbase w)
            (bit-or (array-ref dst (+ dbase w)) (array-ref src (+ sbase w))))
          (set! w (+ w 1))))
      unit)))

(define (compiler-reg-bits-or-succs!
  [live-out : (Array i64)]
  [live-in : (Array i64)]
  [succs : CompilerLiveLabelSet]
  [idmap : reg_label_i64_map.Map]
  [b : i64]
  [words : i64]) : unit
  (match succs
    [(CompilerLiveLabelSet.Nil) unit]
    [(CompilerLiveLabelSet.Dense _ _)
      (begin
        (match (reg_label_i64_map.get
          (& idmap)
          (compiler-live-label-set-ref succs 0))
          [(reg_label_i64_map.LookupFound idx)
            (compiler-reg-bits-or-row!
              live-out
              (* b words)
              live-in
              (* idx words)
              words)]
          [(reg_label_i64_map.LookupMissing) unit])
        (compiler-reg-bits-or-succs!
          live-out
          live-in
          (compiler-live-label-set-tail succs)
          idmap
          b
          words))]))

(define (compiler-reg-bits-update-live-in!
  [live-in : (Array i64)]
  [use-rows : (Array i64)]
  [live-out : (Array i64)]
  [def-rows : (Array i64)]
  [base : i64]
  [words : i64]) : bool
  (let
    [w : i64 0]
    [changed : bool false]
    (begin
      (while (< w words)
        (let
          [idx : i64 (+ base w)]
          [next : i64
            (bit-or
              (array-ref use-rows idx)
              (bit-and
                (array-ref live-out idx)
                (bit-xor (array-ref def-rows idx) -1)))]
          (begin
            (if (= next (array-ref live-in idx))
              unit
              (begin
                (array-set! live-in idx next)
                (set! changed true)))
            (set! w (+ w 1)))))
      changed)))

(define (compiler-reg-bits-iterate!
  [arr : (Array CompilerLiveBlock)]
  [idmap : reg_label_i64_map.Map]
  [words : i64]
  [use-rows : (Array i64)]
  [live-in : (Array i64)]
  [live-out : (Array i64)]
  [def-rows : (Array i64)]
  [b : i64]
  [changed : bool]) : bool
  (if (< b 0)
    changed
    (begin
      (compiler-reg-bits-clear-row! live-out (* b words) words)
      (compiler-reg-bits-or-succs!
        live-out
        live-in
        (compiler-reg-live-block-succs (array-ref arr b))
        idmap
        b
        words)
      (let
        [next-changed : bool
          (if (compiler-reg-bits-update-live-in!
            live-in
            use-rows
            live-out
            def-rows
            (* b words)
            words)
            true
            changed)]
        (compiler-reg-bits-iterate!
          arr
          idmap
          words
          use-rows
          live-in
          live-out
          def-rows
          (- b 1)
          next-changed)))))

(define (compiler-reg-bits-fixpoint!
  [arr : (Array CompilerLiveBlock)]
  [idmap : reg_label_i64_map.Map]
  [count : i64]
  [words : i64]
  [use-rows : (Array i64)]
  [live-in : (Array i64)]
  [live-out : (Array i64)]
  [def-rows : (Array i64)]) : unit
  (if (compiler-reg-bits-iterate!
    arr
    idmap
    words
    use-rows
    live-in
    live-out
    def-rows
    (- count 1)
    false)
    (compiler-reg-bits-fixpoint!
      arr
      idmap
      count
      words
      use-rows
      live-in
      live-out
      def-rows)
    unit))

(define (compiler-reg-bits-extend-word!
  [bits : i64]
  [var-base : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [point : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [i : i64 (compiler-reg-low-bit-index bits)]
      (begin
        (compiler-reg-extend-interval starts ends (+ var-base i) point)
        (compiler-reg-bits-extend-word!
          (bit-and bits (- bits 1))
          var-base
          starts
          ends
          point)))))

(define (compiler-reg-bits-extend-row!
  [row : (Array i64)]
  [base : i64]
  [words : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [point : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (compiler-reg-bits-extend-word!
            (array-ref row (+ base w))
            (* w 63)
            starts
            ends
            point)
          (set! w (+ w 1))))
      unit)))

(define (compiler-reg-bits-mentions-instr-seq
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-extend-instr
            starts
            ends
            (compiler-live-set-empty)
            out-point
            (array-ref slots index))
          (set! out-point (+ out-point 2))
          (set! index (+ index 1))))
      out-point)))

(define (compiler-reg-bits-intervals-walk
  [ir-blocks : CompilerIrBlockList]
  [live-in : (Array i64)]
  [live-out : (Array i64)]
  [words : i64]
  [b : i64]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]) : i64
  (match ir-blocks
    [(CompilerIrBlockList.Nil) point]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-bits-extend-row!
              live-in
              (* b words)
              words
              starts
              ends
              point)
            (let
              [end-point : i64
                (compiler-reg-bits-mentions-instr-seq instrs point starts ends)]
              (begin
                (compiler-reg-bits-extend-row!
                  live-out
                  (* b words)
                  words
                  starts
                  ends
                  end-point)
                (compiler-reg-bits-intervals-walk
                  (box-get rest)
                  live-in
                  live-out
                  words
                  (+ b 1)
                  end-point
                  starts
                  ends))))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [block-index : i64 b]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (begin
                    (compiler-reg-bits-extend-row!
                      live-in
                      (* block-index words)
                      words
                      starts
                      ends
                      out-point)
                    (set!
                      out-point
                      (compiler-reg-bits-mentions-instr-seq
                        instrs
                        out-point
                        starts
                        ends))
                    (compiler-reg-bits-extend-row!
                      live-out
                      (* block-index words)
                      words
                      starts
                      ends
                      out-point))])
              (set! block-index (+ block-index 1))
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-bits-map-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (compiler-reg-block-intervals [func : CompilerIrFunction]) : CompilerRegIntervalSeq
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
        [live-blocks : (Array CompilerLiveBlock)
          (compiler-live-build-block-array seq)]
        [count : i64 (array-length live-blocks)]
        [words : i64 (compiler-reg-bits-words vars)]
        [cells : i64 (* count words)]
        [use-rows : (Array i64) (array.make-array i64 cells)]
        [def-rows : (Array i64) (array.make-array i64 cells)]
        [live-in : (Array i64) (array.make-array i64 cells)]
        [live-out : (Array i64) (array.make-array i64 cells)]
        [starts : (Array i64) (array.make-array i64 vars)]
        [ends : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (let
            [idmap : reg_label_i64_map.Map
              (compiler-reg-bits-build-rows-from-array!
                live-blocks
                (reg_label_i64_map.with-capacity
                  (compiler-reg-bits-map-capacity count))
                use-rows
                def-rows
                words
                0)]
            (begin
              (compiler-reg-bits-fixpoint!
                live-blocks
                idmap
                count
                words
                use-rows
                live-in
                live-out
                def-rows)
              (compiler-reg-bits-intervals-walk
                blocks
                live-in
                live-out
                words
                0
                0
                starts
                ends)
              (compiler-reg-interval-arrays-to-seq
                starts
                ends
                (- vars 1)
                (compiler-reg-interval-seq-empty))))))]))

;; When handles-ok? is true (scalar path) 8-byte aggregate handles are register
;; eligible; when false (SIMD/AVX path, unchanged) only CPU scalars/pointers are.
(define (compiler-reg-ineligible-non-scalars
  [types : CompilerRegVarTypeList]
  [set : CompilerLiveI64Set]
  [handles-ok? : bool]) : CompilerLiveI64Set
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-ineligible-non-scalars
        (compiler-reg-var-type-seq-to-list seq)
        set
        handles-ok?)]
    [(CompilerRegVarTypeList.Nil) set]
    [(CompilerRegVarTypeList.Cons item rest)
      (compiler-reg-ineligible-non-scalars
        (box-get rest)
        (if (if handles-ok?
          (compiler-reg-register-eligible-type? (struct-get item ty))
          (compiler-reg-scalar-type? (struct-get item ty)))
          set
          (compiler-live-set-insert set (struct-get item var)))
        handles-ok?)]))

(define (compiler-reg-ineligible-params
  [params : CompilerIrParamList]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) set]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-ineligible-params (compiler-ir-param-seq-to-list seq) set)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (compiler-reg-ineligible-params
            (box-get rest)
            (compiler-live-set-insert set var))])]))

(define (compiler-reg-integer-param-type?
  [type-segment-bases : i64]
  [ty : AstType]) : bool
  (and
    ;; GAP3b: pin-eligibility matches greedy-eligibility
    ;; (compiler-reg-param-greedy-eligible?). An 8-byte handle (Array/String/
    ;; enum/struct descriptor pointer) arriving in %rdi is pin-identical to a
    ;; scalar: M-A2/M-C2 established handles as ordinary GP values the backend
    ;; moves with a plain movq, and M-A already let handle params take greedy
    ;; CSR homes in every function -- the pin path kept a stale scalar-only
    ;; restriction from the pre-M-A era, paying an entry copy plus a
    ;; callee-saved save for every handle param of a zero-clobber leaf
    ;; (sum_array shape). Floats keep the XMM exclusion; two-word register
    ;; groups occupy two ABI slots and keep the legacy stack home; genuinely
    ;; by-reference/address-taken params are excluded upstream by
    ;; base-ineligible (compiler-reg-param-pin-safe?).
    (compiler-reg-register-eligible-type? ty)
    (not (compiler-reg-float-type? ty))
    (not (compiler-reg-type-register-group? type-segment-bases ty))))

;; M-A (RC1): a non-group register-eligible param that did NOT get
;; an ABI pin stays OUT of the ineligible/blocked sets and becomes an ordinary
;; greedy candidate. Its greedy home is restricted to the CALLEE-SAVED pool
;; (compiler-reg-greedy-alloc-one! `is-param`): the backend's entry copy writes
;; the home register in the prologue (after the callee-saved saves), and a
;; callee-saved home can neither clobber another param's incoming arg register
;; nor be clobbered by a call. Handle types (Array/String/enum/struct -- 8-byte
;; descriptors) qualify exactly like scalars. Floats use the same rule over the
;; ABI XMM bank: SysV has no nonvolatile suffix, while Win64 may keep an unpinned
;; parameter in XMM6-XMM15. Two-word register groups keep the legacy stack home.
(define (compiler-reg-param-greedy-eligible?
  [type-segment-bases : i64]
  [ty : AstType]) : bool
  (and
    (compiler-reg-register-eligible-type? ty)
    (not (compiler-reg-type-register-group? type-segment-bases ty))))

(define (compiler-reg-param-int-reg
  [abi : CompilerRegTargetAbi]
  [int-idx : i64]
  [position : i64]) : CompilerRegMaybeId
  (let
    [idx : i64
      (if (compiler-abi-arg-banks-independent? abi)
        int-idx
        position)]
    [reg : i64 (compiler-abi-gp-arg-register-id abi idx)]
    ;; %r8 is the backend's integer scratch register on both ABIs.
    (if (or (= reg compiler-reg-id-invalid) (= reg compiler-reg-id-r8))
      CompilerRegMaybeId.No
      (CompilerRegMaybeId.Some reg))))

(define (compiler-reg-param-float-reg
  [abi : CompilerRegTargetAbi]
  [float-idx : i64]
  [position : i64]) : CompilerRegMaybeId
  (let
    [idx : i64
      (if (compiler-abi-arg-banks-independent? abi)
        float-idx
        position)]
    [reg : i64 (compiler-abi-float-arg-register-id abi idx)]
    (if (or
      (= reg compiler-reg-id-invalid)
      (not
        (compiler-reg-id-list-contains?
          (compiler-reg-xmm-registers-for-abi abi)
          reg)))
      CompilerRegMaybeId.No
      (CompilerRegMaybeId.Some reg))))

;; GAP3c: inclusive-START point-range spanning test for the pin gate. A param
;; is defined by the PROLOGUE (before point 0) and its interval is
;; entry-extended to start at 0 (M-A), so -- unlike an ordinary var, whose
;; start point is its own defining instruction (a call result born AT a call
;; is not clobbered by it) -- a clobber point AT the interval start is already
;; inside the param's live range: `start <= c < end`. The greedy's
;; strict-interior test (compiler-reg-greedy-var-spans-clobber?) would let a
;; param live ACROSS a call at point 0 (function opens with the call, param
;; used after) keep its caller-saved pin -- a miscompile. A clobber at `end`
;; stays non-spanning: it is the param's own last-use instruction, whose
;; operands are read before the clobber lands (the model every register-homed
;; value already relies on). Out-of-range vars conservatively span.
(define (compiler-reg-param-pin-word-in-range?
  [bits : i64]
  [var-base : i64]
  [start : i64]
  [end : i64]) : bool
  (if (= bits 0)
    false
    (let
      [i : i64 (compiler-reg-low-bit-index32 bits)]
      [c : i64 (+ var-base i)]
      (if (if (<= start c)
        (< c end)
        false)
        true
        (compiler-reg-param-pin-word-in-range?
          (bit-and bits (- bits 1))
          var-base
          start
          end)))))

(define (compiler-reg-param-pin-set-in-range-words?
  [set : CompilerLiveI64Set]
  [start : i64]
  [end : i64]
  [word-index : i64]) : bool
  (if (>= word-index (compiler-live-set-word-count set))
    false
    (if (compiler-reg-param-pin-word-in-range?
      (compiler-live-set-word-at-bounded set word-index)
      (* word-index (compiler-live-set-word-bits))
      start
      end)
      true
      (compiler-reg-param-pin-set-in-range-words?
        set
        start
        end
        (+ word-index 1)))))

(define (compiler-reg-param-pin-spans-clobber?
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : CompilerLiveI64Set]
  [var : i64]) : bool
  (let
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    (if (and (>= var 0) (< var (array-length starts)))
      (if (< (array-ref starts var) 0)
        false
        (compiler-reg-param-pin-set-in-range-words?
          clobber-points
          (array-ref starts var)
          (array-ref ends var)
          0))
      true)))

;; GAP3c: per-interval pin clobber gate. A param may keep its incoming ABI
;; register iff no clobber/pressure point falls inside the pinned interval
;; (inclusive-start spanning test above), by the greedy's kind point sets:
;;   * kind 0 (call-like: call/tailcall/syscall/cpuid/xgetbv) clobbers every
;;     caller-saved register: bans any spanned pin;
;;   * kind 1 (div/mod, constant divisors included): bans any spanned pin.
;;     The register hazard alone is only %rax:%rdx, but the canned divmod
;;     expansion is SCRATCH-HUNGRY (magic reciprocal + rounding temps), and a
;;     pin live across it measurably starves the scavenger into per-iteration
;;     emergency save/restore pairs (qs_checksum: +4 movs/iter for -4
;;     prologue movs = a net loss in every loop) -- so all pins are refused,
;;     not just %rdx;
;;   * kind 2 (VARIABLE-count shift) hardwires only %rcx/%cl and stages at
;;     most the count: bans only a spanned %rcx pin.
;; Switch dispatches no longer participate in this gate. GAP2b-v2 made the
;; dispatch emergency scavenge restore borrowed occupants before the indirect
;; jmp, so the old function-global "any switch bans all pins" guard would now
;; reject valid placements for a bug that is no longer present.
;; "Spanned" is the inclusive-start test: a param whose LAST use is the
;; clobbering instruction itself (the dividend/divisor of the div, an
;; outgoing argument of the call) is read before the clobber lands, exactly
;; as the greedy already assumes for every register-homed value.
;; BoundsCheck/Pack are absent from all kinds (clobber-point-instr?/kind sets
;; exclude them); their scavenged scratches see the pin through the
;; interval-driven occupancy masks like any other register-homed value. A var
;; without an interval never spans here; pin-safe? independently refuses
;; params without an interval (unused params are never pinned).
(define (compiler-reg-param-pin-clobber-free?
  [interval-index : CompilerRegIntervalIndex]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [low-xmm-points : CompilerLiveI64Set]
  [var : i64]
  [reg : i64]) : bool
  ;; GAP2b-v2: the kind-3 (any-switch-refuses-all-pins) clause is REMOVED. The
  ;; dispatch emitter's emergency scavenge is now sound (it restores every
  ;; borrowed occupant BEFORE the indirect jmp via a slot-indirect transfer --
  ;; compiler-backend-emit-switch-dispatch-emergency), so an ABI pin that
  ;; perturbs occupancy at a dispatch no longer risks the restore-after-jmp
  ;; miscompile.
  (and
    (not (compiler-reg-param-pin-spans-clobber? interval-index call-points var))
    (not (compiler-reg-param-pin-spans-clobber? interval-index div-points var))
    (or
      (not (= reg compiler-reg-id-rcx))
      (not
        (compiler-reg-param-pin-spans-clobber? interval-index shift-points var)))
    (or
      (and
        (not (= reg (compiler-abi-xmm-register-id 0)))
        (not (= reg (compiler-abi-xmm-register-id 1))))
      (not
        (compiler-reg-param-pin-spans-clobber?
          interval-index
          low-xmm-points
          var)))))

(define (compiler-reg-param-pin-safe?
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [base-ineligible : CompilerLiveI64Set]
  [var : i64]
  [reg : i64]) : bool
  (and
    (not (compiler-live-set-contains? base-ineligible var))
    (match (compiler-reg-interval-index-lookup interval-index var)
      [(CompilerRegMaybeInterval.Some interval)
        (not
          (compiler-reg-assignment-table-location-conflicts?
            assignments
            interval-index
            var
            (- 0 1)
            (CompilerRegLocation.Register reg)))]
      [(CompilerRegMaybeInterval.No) false])))

(define (compiler-reg-param-assign-walk
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [params : CompilerIrParamList]
  [interval-index : CompilerRegIntervalIndex]
  [assignments : CompilerRegAssignmentTable]
  [ineligible : CompilerLiveI64Set]
  [blocked : CompilerLiveI64Set]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [pins-ok? : bool]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [low-xmm-points : CompilerLiveI64Set]) : CompilerRegParamAssignPlan
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil)
      (CompilerRegParamAssignPlan.Plan assignments ineligible blocked)]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-param-assign-walk
        type-segment-bases
        abi
        (compiler-ir-param-seq-to-list seq)
        interval-index
        assignments
        ineligible
        blocked
        int-idx
        float-idx
        position
        pins-ok?
        call-points
        div-points
        shift-points
        low-xmm-points)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ ty var-id)
          (let
            [is-float : bool (compiler-reg-float-type? ty)]
            [is-group : bool
              (compiler-reg-type-register-group? type-segment-bases ty)]
            [next-int : i64
              (if is-float
                int-idx
                (+ int-idx 1))]
            [next-float : i64
              (if is-float
                (+ float-idx 1)
                float-idx)]
            [next-position : i64 (+ position 1)]
            ;; A register-group param occupies TWO ABI slots; this walk's
            ;; int-idx accounting does not model that, so every pin PAST a
            ;; group param is disabled (the group itself never pins).
            [tail-pins-ok? : bool (and pins-ok? (not is-group))]
            [reg : CompilerRegMaybeId
              (if (and pins-ok? (not is-group))
                (if is-float
                  (compiler-reg-param-float-reg abi float-idx position)
                  (if (compiler-reg-integer-param-type? type-segment-bases ty)
                    (compiler-reg-param-int-reg abi int-idx position)
                    CompilerRegMaybeId.No))
                CompilerRegMaybeId.No)]
            (match reg
              [(CompilerRegMaybeId.Some home)
                ;; GAP3c: the pin gate is PER-INTERVAL and per-register (the
                ;; old function-global backend-clobber-point? gate revoked
                ;; every pin on any call/div/shift anywhere -- apply_op's div
                ;; disqualified pins its add arm never reached). The pinned
                ;; var is deliberately NOT inserted into `blocked`: the greedy
                ;; skips already-assigned vars, and plan-from's coalesce-hull
                ;; validation (compiler-reg-param-pins-demote!) may still
                ;; revoke the pin, after which the param must compete as an
                ;; ordinary callee-saved greedy candidate.
                (if (and
                  (compiler-reg-param-pin-clobber-free?
                    interval-index
                    call-points
                    div-points
                    shift-points
                    low-xmm-points
                    var-id
                    home)
                  (compiler-reg-param-pin-safe?
                    assignments
                    interval-index
                    ineligible
                    var-id
                    home))
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    abi
                    (box-get rest)
                    interval-index
                    (compiler-reg-assignment-table-insert
                      assignments
                      var-id
                      (CompilerRegLocation.Register home))
                    ineligible
                    blocked
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points)
                  ;; Pin-unsafe scalar param: integer and float scalar params
                  ;; are greedy-eligible -- leave it out of
                  ;; ineligible/blocked so the greedy may home it callee-saved.
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    abi
                    (box-get rest)
                    interval-index
                    assignments
                    ineligible
                    blocked
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points))]
              [(CompilerRegMaybeId.No)
                ;; No ABI pin available (skipped arg register, stack-passed
                ;; position, post-group position, or non-pinnable type). A
                ;; greedy-eligible param stays unblocked (M-A candidate);
                ;; group/otherwise-ineligible params keep the legacy
                ;; stack home. base-ineligible members (address-taken, stack
                ;; call args, ...) are already in both sets and stay excluded.
                (if (compiler-reg-param-greedy-eligible? type-segment-bases ty)
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    abi
                    (box-get rest)
                    interval-index
                    assignments
                    ineligible
                    blocked
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points)
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    abi
                    (box-get rest)
                    interval-index
                    assignments
                    (compiler-live-set-insert ineligible var-id)
                    (compiler-live-set-insert blocked var-id)
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points))]))])]))

(define (compiler-reg-param-assign-plan
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [interval-index : CompilerRegIntervalIndex]
  [base-ineligible : CompilerLiveI64Set]
  [vars : i64]
  [ignore-single-cold-call? : bool]) : CompilerRegParamAssignPlan
  (match func
    [(CompilerIrFunction.Function _ params _ _ _)
      (match (compiler-ir-param-list-force-cons params)
        [(CompilerIrParamList.Nil)
          (CompilerRegParamAssignPlan.Plan
            (compiler-reg-assignment-table-make vars)
            base-ineligible
            base-ineligible)]
        [(CompilerIrParamList.Array seq)
          (let
            [assignments : CompilerRegAssignmentTable
              (compiler-reg-assignment-table-make vars)]
            (compiler-reg-param-assign-walk
              type-segment-bases
              abi
              (compiler-ir-param-seq-to-list seq)
              interval-index
              assignments
              base-ineligible
              base-ineligible
              0
              0
              0
              true
              (if ignore-single-cold-call?
                (compiler-live-set-empty)
                (compiler-reg-clobber-kind-points type-segment-bases func 0))
              (compiler-reg-clobber-kind-points type-segment-bases func 1)
              (compiler-reg-clobber-kind-points type-segment-bases func 2)
              (cfg
                scratch-vreg
                (compiler-reg-clobber-kind-points type-segment-bases func 5)
                (compiler-live-set-empty))))]
        [(CompilerIrParamList.Cons _ _)
          (let
            [assignments : CompilerRegAssignmentTable
              (compiler-reg-assignment-table-make vars)]
            ;; M-A (RC1): the walk always runs -- non-pinned greedy-eligible
            ;; params stay out of ineligible/blocked in ALL functions and
            ;; compete in the greedy for a callee-saved home.
            ;; GAP3c: the pin gate is PER-INTERVAL and per-register instead of
            ;; the old function-global backend-clobber-point? test: a param
            ;; whose live range crosses no clobber point that could overwrite
            ;; ITS register keeps the incoming ABI register even in a function
            ;; with calls/divs/shifts elsewhere (the greedy's kind 0/1/2 point
            ;; sets; see compiler-reg-param-pin-clobber-free?). The walk's
            ;; per-var check uses the param's OWN interval; plan-from
            ;; re-validates every surviving pin against its coalesce-class
            ;; hull once the coalesce map exists (a disjoint-coalesced member
            ;; may extend the pinned register's effective range past a
            ;; clobber; compiler-reg-param-pins-demote!).
            (compiler-reg-param-assign-walk
              type-segment-bases
              abi
              params
              interval-index
              assignments
              base-ineligible
              base-ineligible
              0
              0
              0
              true
              (if ignore-single-cold-call?
                (compiler-live-set-empty)
                (compiler-reg-clobber-kind-points type-segment-bases func 0))
              (compiler-reg-clobber-kind-points type-segment-bases func 1)
              (compiler-reg-clobber-kind-points type-segment-bases func 2)
              (cfg
                scratch-vreg
                (compiler-reg-clobber-kind-points type-segment-bases func 5)
                (compiler-live-set-empty))))])]))

(define (compiler-reg-ineligible-instr
  [instr : CompilerIrInstr]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.Alloc dst _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.AddrOf _ src) (compiler-live-set-insert set src)]
    ;; A GEP result is a computed scalar pointer (mut-ptr U8); like an AddrOf
    ;; *destination* it is register-eligible. It only needs a memory home if its
    ;; own address is taken, which the AddrOf arm above already covers (it marks
    ;; the AddrOf *source* ineligible). Unconditionally pinning every GEP result
    ;; to a stack slot left the backend's register-home GEP fast path dead and
    ;; forced a reload-into-%r10 per dereference (the #1 movq destination in the
    ;; mov census). A register-homed GEP is computed straight into its home with
    ;; a single leaq and dereferenced directly, so it is left eligible here.
    [_ set]))

(define (compiler-reg-ineligible-instr-seq
  [instrs : CompilerIrInstrSeq]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set! out (compiler-reg-ineligible-instr (array-ref slots index) out))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-ineligible-memory
  [blocks : CompilerIrBlockList]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-ineligible-memory
            (box-get rest)
            (compiler-reg-ineligible-instr-seq instrs set))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-ineligible-instr-seq instrs out))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-call-live-instr-seq
  [instrs : CompilerIrInstrSeq]
  [liveness : CompilerFunctionLiveness]
  [label : i64]
  [start-index : i64]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [instr-index : i64 start-index]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(CompilerIrInstr.Call _ _ _ _)
                (compiler-live-set-union
                  out
                  (compiler-live-after liveness label instr-index))]
              [(CompilerIrInstr.CallCAbiStoreResult payload-box)
                (compiler-live-set-union
                  out
                  (compiler-live-after liveness label instr-index))]
              [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (compiler-live-set-union
                  out
                  (compiler-live-after liveness label instr-index))]
              [(CompilerIrInstr.SpmdCall payload-box)
                (compiler-live-set-union
                  out
                  (compiler-live-after liveness label instr-index))]
              [(CompilerIrInstr.TailCall _ _ _)
                (compiler-live-set-union
                  out
                  (compiler-live-after liveness label instr-index))]
              [(CompilerIrInstr.TailCallIndirect _ _ _)
                (compiler-live-set-union
                  out
                  (compiler-live-after liveness label instr-index))]
              [_ out]))
          (set! instr-index (+ instr-index 1))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-call-live-blocks
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-reg-call-live-blocks
            (box-get rest)
            liveness
            (compiler-reg-call-live-instr-seq instrs liveness label 0 set))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block label instrs)
                  (set!
                    out
                    (compiler-reg-call-live-instr-seq
                      instrs
                      liveness
                      label
                      0
                      out))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-call-arg-vars-instr-seq
  [instrs : CompilerIrInstrSeq]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(CompilerIrInstr.Call _ _ args _)
                (compiler-live-set-union
                  out
                  (compiler-live-call-args-vars args))]
              [(CompilerIrInstr.CallCAbiStoreResult payload-box)
                (let
                  [base (struct-get (box-get payload-box) base)]
                  [args (struct-get (box-get payload-box) args)]
                  (compiler-live-set-union
                    out
                    (compiler-live-value-vars-into
                      (compiler-live-call-args-vars args)
                      base)))]
              [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (let
                  [base (struct-get (box-get payload-box) base)]
                  [func (struct-get (box-get payload-box) callee)]
                  [args (struct-get (box-get payload-box) args)]
                  (compiler-live-set-union
                    out
                    (compiler-live-value-vars-into
                      (compiler-live-value-vars-into
                        (compiler-live-call-args-vars args)
                        base)
                      func)))]
              [(CompilerIrInstr.SpmdCall payload-box)
                (let
                  [active-mask (struct-get (box-get payload-box) active-mask)]
                  [args (struct-get (box-get payload-box) args)]
                  (compiler-live-set-union
                    out
                    (compiler-live-value-vars-into
                      (compiler-live-spmd-call-args-vars args)
                      active-mask)))]
              [(CompilerIrInstr.TailCall _ args _)
                (compiler-live-set-union
                  out
                  (compiler-live-call-args-vars args))]
              [(CompilerIrInstr.TailCallIndirect func args _)
                (compiler-live-set-union
                  out
                  (compiler-live-value-vars-into
                    (compiler-live-call-args-vars args)
                    func))]
              [_ out]))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-call-arg-vars-blocks
  [blocks : CompilerIrBlockList]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-call-arg-vars-blocks
            (box-get rest)
            (compiler-reg-call-arg-vars-instr-seq instrs set))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-call-arg-vars-instr-seq instrs out))])
              (set! i (+ i 1))))
          out))]))

;; --- Register-eligible GP call args ---------------------------------------
;; Direct, c-abi, and indirect call USER args may stay register-eligible when
;; every arg is passed in a single GP arg register, within the per-ABI arg-register
;; count from that call shape's starting ABI slot. Scalars and 8-byte handles are
;; one register class here; the backend resolves any register source/dest conflict
;; among them with a target-aware parallel move. Float/group/aggregate/stack args
;; still stay memory-sourced because they use other banks, multiple registers, or
;; stack marshalling. Special operands such as indirect call targets and C ABI
;; result bases also stay memory-sourced; the backend loads them after user arg
;; setup. The SIMD path keeps the old block-everything behavior via
;; compiler-reg-call-arg-vars-blocks (unchanged).
;; Per-ABI GP integer arg-register count: SysV has 6 (%rdi/%rsi/%rdx/%rcx/%r8/%r9),
;; Win64 has 4 (%rcx/%rdx/%r8/%r9). Mirrored in the backend at
;; compiler-backend-call-args-gp-parallel-from? -- keep the two in sync.
(define (compiler-reg-arg-reg-limit-for-abi [abi : CompilerRegTargetAbi]) : i64
  (compiler-abi-gp-arg-register-count abi))

;; A call arg is passed in a SINGLE general-purpose arg register on both ABIs iff it
;; is neither a float nor a register-group value. Handle values (string/box/array/
;; enum/single-word-struct pointers) count as GP, exactly like a raw pointer -- the
;; backend marshals them with one movq. This is the regalloc mirror of the backend's
;; compiler-backend-types-all-gp-int? (the parallel-move precondition); keep the two
;; in sync.
(define (compiler-reg-call-arg-gp-class?
  [type-segment-bases : i64]
  [value : CompilerIrValue]
  [types : CompilerRegVarTypeList]) : bool
  (match value
    [(CompilerIrValue.Var id)
      (match (compiler-reg-var-type-lookup types id)
        [(CompilerRegMaybeType.Some ty)
          (and
            (not (compiler-reg-float-type? ty))
            (not (compiler-reg-type-register-group? type-segment-bases ty)))]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerIrValue.F64 _) false]
    [(CompilerIrValue.Unit) false]
    [_ true]))

(define (compiler-reg-call-args-array-gp-class?
  [type-segment-bases : i64]
  [values : (Array CompilerIrValue)]
  [types : CompilerRegVarTypeList]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    true
    (and
      (compiler-reg-call-arg-gp-class?
        type-segment-bases
        (array-ref values index)
        types)
      (compiler-reg-call-args-array-gp-class?
        type-segment-bases
        values
        types
        (+ index 1)
        count))))

(define (compiler-reg-call-args-gp-class?
  [type-segment-bases : i64]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]) : bool
  (match args
    [(CompilerIrCallArgs.Nil) false]
    [(CompilerIrCallArgs.One v)
      (compiler-reg-call-arg-gp-class? type-segment-bases v types)]
    [(CompilerIrCallArgs.Two a b)
      (and
        (compiler-reg-call-arg-gp-class? type-segment-bases a types)
        (compiler-reg-call-arg-gp-class? type-segment-bases b types))]
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-call-args-array-gp-class?
        type-segment-bases
        values
        types
        0
        (array-length values))]))

;; A call whose args are ALL single-GP-register passed (and within the per-ABI
;; arg-register arity from its starting ABI slot) is marshalled by the backend
;; with the sound parallel move (compiler-backend-emit-arg-move-list) whenever a
;; register source/dest conflict exists, so ALL its arg vars -- scalars and
;; 8-byte handles alike, they are the same GP register class -- may stay
;; register-homed. Mirrors compiler-backend-call-args-gp-parallel-from?.
(define (compiler-reg-call-gp-parallel-from?
  [type-segment-bases : i64]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]
  [start : i64]
  [limit : i64]) : bool
  (let
    [count : i64 (compiler-ir-call-args-count args)]
    (and
      (> count 0)
      (<= (+ start count) limit)
      (compiler-reg-call-args-gp-class? type-segment-bases args types))))

(define (compiler-reg-call-arg-float?
  [value : CompilerIrValue]
  [types : CompilerRegVarTypeList]) : bool
  (match value
    [(CompilerIrValue.Var id)
      (match (compiler-reg-var-type-lookup types id)
        [(CompilerRegMaybeType.Some ty) (compiler-reg-float-type? ty)]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerIrValue.F64 _) true]
    [_ false]))

(define (compiler-reg-call-arg-group?
  [type-segment-bases : i64]
  [value : CompilerIrValue]
  [types : CompilerRegVarTypeList]) : bool
  (match value
    [(CompilerIrValue.Var id)
      (match (compiler-reg-var-type-lookup types id)
        [(CompilerRegMaybeType.Some ty)
          (compiler-reg-type-register-group? type-segment-bases ty)]
        [(CompilerRegMaybeType.No) true])]
    [_ false]))

(define (compiler-reg-call-args-array-has-group?
  [type-segment-bases : i64]
  [values : (Array CompilerIrValue)]
  [types : CompilerRegVarTypeList]
  [i : i64]) : bool
  (if (>= i (array-length values))
    false
    (or
      (compiler-reg-call-arg-group?
        type-segment-bases
        (array-ref values i)
        types)
      (compiler-reg-call-args-array-has-group?
        type-segment-bases
        values
        types
        (+ i 1)))))

(define (compiler-reg-call-args-have-group?
  [type-segment-bases : i64]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]) : bool
  (match args
    [(CompilerIrCallArgs.Nil) false]
    [(CompilerIrCallArgs.One a)
      (compiler-reg-call-arg-group? type-segment-bases a types)]
    [(CompilerIrCallArgs.Two a b)
      (or
        (compiler-reg-call-arg-group? type-segment-bases a types)
        (compiler-reg-call-arg-group? type-segment-bases b types))]
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-call-args-array-has-group?
        type-segment-bases
        values
        types
        0)]))

;; The backend's current float marshaller is ordered rather than a parallel-move
;; solver. A register-passed float may nevertheless enter the greedy: after
;; allocation we retain its home only when it is exactly the ABI destination
;; register and demote every other home to a memory source. GP args on a mixed
;; call and stack-passed floats remain structurally blocked here. Register groups
;; use the old all-memory rule because their multi-slot ABI accounting is separate.
(define (compiler-reg-call-arg-vars-selective-value
  [out : CompilerLiveI64Set]
  [value : CompilerIrValue]
  [types : CompilerRegVarTypeList]
  [abi : CompilerRegTargetAbi]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]) : CompilerLiveI64Set
  (match value
    [(CompilerIrValue.Var id)
      (let
        [is-float : bool (compiler-reg-call-arg-float? value types)]
        (if (and
          is-float
          (not
            (compiler-abi-stack-call-arg-for-banks?
              abi
              is-float
              int-idx
              float-idx
              position)))
          out
          (compiler-live-set-insert out id)))]
    [_ out]))

(define (compiler-reg-call-arg-vars-selective-array
  [out : CompilerLiveI64Set]
  [values : (Array CompilerIrValue)]
  [types : CompilerRegVarTypeList]
  [abi : CompilerRegTargetAbi]
  [i : i64]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]) : CompilerLiveI64Set
  (if (>= i (array-length values))
    out
    (let
      [value : CompilerIrValue (array-ref values i)]
      [is-float : bool (compiler-reg-call-arg-float? value types)]
      (compiler-reg-call-arg-vars-selective-array
        (compiler-reg-call-arg-vars-selective-value
          out
          value
          types
          abi
          int-idx
          float-idx
          position)
        values
        types
        abi
        (+ i 1)
        (if is-float
          int-idx
          (+ int-idx 1))
        (if is-float
          (+ float-idx 1)
          float-idx)
        (+ position 1)))))

(define (compiler-reg-call-arg-vars-selective
  [out : CompilerLiveI64Set]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]
  [abi : CompilerRegTargetAbi]
  [start : i64]) : CompilerLiveI64Set
  (match args
    [(CompilerIrCallArgs.Nil) out]
    [(CompilerIrCallArgs.One a)
      (compiler-reg-call-arg-vars-selective-value out a types abi start 0 start)]
    [(CompilerIrCallArgs.Two a b)
      (let
        [a-float : bool (compiler-reg-call-arg-float? a types)]
        [after-a : CompilerLiveI64Set
          (compiler-reg-call-arg-vars-selective-value
            out
            a
            types
            abi
            start
            0
            start)]
        (compiler-reg-call-arg-vars-selective-value
          after-a
          b
          types
          abi
          (if a-float
            start
            (+ start 1))
          (if a-float
            1
            0)
          (+ start 1)))]
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-call-arg-vars-selective-array
        out
        values
        types
        abi
        0
        start
        0
        start)]))

(define (compiler-reg-call-arg-vars-unless-gp-parallel
  [type-segment-bases : i64]
  [out : CompilerLiveI64Set]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]
  [start : i64]
  [abi : CompilerRegTargetAbi]) : CompilerLiveI64Set
  (if (compiler-reg-call-gp-parallel-from?
    type-segment-bases
    args
    types
    start
    (compiler-reg-arg-reg-limit-for-abi abi))
    out
    (if (compiler-reg-call-args-have-group? type-segment-bases args types)
      (compiler-live-set-union out (compiler-live-call-args-vars args))
      (compiler-reg-call-arg-vars-selective out args types abi start))))

(define (compiler-reg-call-arg-vars-instr-seq-scalar
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [set : CompilerLiveI64Set]
  [types : CompilerRegVarTypeList]
  [abi : CompilerRegTargetAbi]) : CompilerLiveI64Set
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(CompilerIrInstr.Call _ _ args _)
                ;; GP-parallel call (every arg passed in ONE GP arg register,
                ;; within the per-ABI arity): scalars and 8-byte handles are the
                ;; same register class to the backend, whose marshalling resolves
                ;; every register source/dest conflict with the sound parallel
                ;; move (compiler-backend-emit-call-args), so ALL arg vars --
                ;; handle args included -- may stay register-homed. Zero-arg
                ;; calls have no arg vars to disqualify. Register groups retain
                ;; the all-memory rule. A register-passed float may reach the
                ;; XMM greedy, but its final home is retained only when it equals
                ;; the ABI target; every other float home is demoted later.
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  out
                  args
                  types
                  0
                  abi)]
              [(CompilerIrInstr.CallCAbiStoreResult payload-box)
                (let
                  [base (struct-get (box-get payload-box) base)]
                  [args (struct-get (box-get payload-box) args)]
                  (compiler-reg-call-arg-vars-unless-gp-parallel
                    type-segment-bases
                    (compiler-live-value-vars-into out base)
                    args
                    types
                    0
                    abi))]
              [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (let
                  [base (struct-get (box-get payload-box) base)]
                  [func (struct-get (box-get payload-box) callee)]
                  [args (struct-get (box-get payload-box) args)]
                  (compiler-reg-call-arg-vars-unless-gp-parallel
                    type-segment-bases
                    (compiler-live-value-vars-into
                      (compiler-live-value-vars-into out base)
                      func)
                    args
                    types
                    0
                    abi))]
              ;; Tail calls (M-G2a): the true tail-jump path marshals args FIRST
              ;; (compiler-backend-emit-tail-call routes a gp-parallel shape --
              ;; tail-stack-count 0, target always an in-program function, so
              ;; never c-abi -- through the same conflict-checked
              ;; compiler-backend-emit-call-args as direct calls) and only THEN
              ;; emits the epilogue (compiler-backend-tail-jump-tail: CSR
              ;; restores + leave + jmp). CSR-homed sources are read before
              ;; their restore overwrites them; the arg registers are all
              ;; caller-saved on both ABIs, so the restores never touch
              ;; marshalled args; register-only marshalling writes no frame
              ;; slot the restores read. So a gp-parallel tail call
              ;; disqualifies NO arg vars, exactly like a gp-parallel direct
              ;; call. Register groups retain the all-memory rule; eligible float
              ;; args use the same exact-target-or-demote contract as direct calls.
              [(CompilerIrInstr.TailCall _ args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  out
                  args
                  types
                  0
                  abi)]
              ;; Indirect tail calls marshal at base 1 (closure env reserved in
              ;; ABI arg-register 0). The backend's base-aware parallel move can
              ;; safely marshal register-homed GP user args, but the closure
              ;; pointer itself is loaded after argument setup and remains
              ;; memory-sourced.
              [(CompilerIrInstr.TailCallIndirect func args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  (compiler-live-value-vars-into out func)
                  args
                  types
                  1
                  abi)]
              ;; Closure/indirect calls reserve ABI arg-register 0 for the env and
              ;; marshal user args at base 1. Register-homed GP user args are safe
              ;; through the same base-aware backend parallel move; the closure
              ;; descriptor/call target remains memory-sourced because it is loaded
              ;; after argument setup.
              [(CompilerIrInstr.CallIndirect _ func args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  (compiler-live-value-vars-into out func)
                  args
                  types
                  1
                  abi)]
              [(CompilerIrInstr.CallIndirectC _ func args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  (compiler-live-value-vars-into out func)
                  args
                  types
                  0
                  abi)]
              [_ out]))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-call-arg-vars-blocks-scalar
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [set : CompilerLiveI64Set]
  [types : CompilerRegVarTypeList]
  [abi : CompilerRegTargetAbi]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-call-arg-vars-blocks-scalar
            type-segment-bases
            (box-get rest)
            (compiler-reg-call-arg-vars-instr-seq-scalar
              type-segment-bases
              instrs
              set
              types
              abi)
            types
            abi)])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-call-arg-vars-instr-seq-scalar
                      type-segment-bases
                      instrs
                      out
                      types
                      abi))])
              (set! i (+ i 1))))
          out))]))

;; Ineligible variables are computed structurally (non-scalar/non-handle types,
;; call-argument vars, address-taken/memory targets). A value live across a call
;; is NOT structurally ineligible: the primary integer pool admits only
;; callee-saved registers (%r12-%r15/%rbx) which the callee (TypeLisp function
;; prologue/epilogue, or a runtime helper that push/pops them) preserves across
;; the call. The scalar zero-call extension is layered on later and separately
;; rejects any interval spanning a modeled caller-clobber point.
(define (compiler-reg-ineligible-vars-non-params
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [types : CompilerRegVarTypeList]
  [abi : CompilerRegTargetAbi]) : CompilerLiveI64Set
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-ineligible-memory
        blocks
        (compiler-reg-call-arg-vars-blocks-scalar
          type-segment-bases
          blocks
          (compiler-reg-ineligible-non-scalars
            types
            (compiler-live-set-empty)
            true)
          types
          abi))]))

;; SIMD/AVX register planning shares the integer GP allocation quality of the
;; scalar path: a value live across a call is NOT force-spilled. The SIMD integer
;; pool is the 5 callee-saved GP registers (compiler-reg-sysv-integer-registers)
;; with caller-saved-count=0, so a call-spanning integer that wins one of them is
;; preserved across the call by the callee (TypeLisp prologue/epilogue, or a
;; runtime helper that push/pops the callee-saved set) -- exactly as on the scalar
;; path, where the same callee-saved-only argument keeps call-spanning integers
;; register-homed. Float and vector candidates use the same ABI-aware clobber
;; constraint: SysV has no nonvolatile XMM suffix, while Win64 can keep them in
;; XMM6-XMM15. Aggregate handles and masks remain ineligible via
;; compiler-reg-ineligible-non-scalars (false), so only CPU scalars/pointers are
;; register eligible -- unchanged. The
;; caller-saved call-spanning RESCUE is deliberately NOT enabled here: the
;; backend's call-save rewrite (compiler-reg-caller-save-rewrite-blocks, which
;; materialises the save/restore around calls) is gated to scalar mode only
;; (call-save-enabled = false for AVX), so rehoming a spilled call-spanning value
;; into a caller-saved register would leave it unsaved across the call. Spilled
;; call-spanning integers therefore stay in memory (still correct), exactly as a
;; non-rescued scalar spill would.
(define (compiler-reg-ineligible-vars-simd
  [func : CompilerIrFunction]
  [_type-info : CompilerRegVarTypes]
  [types : CompilerRegVarTypeList]
  [intervals : CompilerRegIntervalSeq]) : CompilerLiveI64Set
  (match func
    [(CompilerIrFunction.Function _ params _ _ blocks)
      ;; Mask registers have no ABI-nonvolatile subset and remain ineligible
      ;; across calls. Float/vector call constraints are applied by their greedy
      ;; allocators instead: SysV forces a spill, while Win64 admits XMM6-XMM15.
      (let
        [vector-mask-defs : CompilerLiveUseDef
          (compiler-reg-function-vector-mask-defs func)]
        [private-param-defs : CompilerLiveUseDef
          (compiler-reg-spmd-private-param-defs
            params
            (compiler-live-set-empty)
            (compiler-live-set-empty))]
        [call-points : CompilerLiveI64Set (compiler-reg-call-points func)]
        ;; Only hidden helper parameters must escape the structural
        ;; non-scalar block so their incoming private registers get homes.
        ;; SpmdCall operands/results can use their ordinary vector spill
        ;; homes; admitting them to fixed-register allocation here would
        ;; also reclassify synthetic/scalar IR fixtures as SIMD values.
        [private-param-vars : CompilerLiveI64Set
          (compiler-live-set-union
            (struct-get private-param-defs uses)
            (struct-get private-param-defs defs))]
        [base-ineligible : CompilerLiveI64Set
          (compiler-live-set-minus
            (compiler-reg-ineligible-memory
              blocks
              (compiler-reg-ineligible-params
                params
                (compiler-reg-call-arg-vars-blocks
                  blocks
                  (compiler-reg-ineligible-non-scalars
                    types
                    (compiler-live-set-empty)
                    false))))
            private-param-vars)]
        (compiler-reg-mark-spanning-in-set
          intervals
          (struct-get vector-mask-defs defs)
          call-points
          base-ineligible))]))

(define (compiler-reg-interval-before?
  [left : CompilerRegInterval]
  [right : CompilerRegInterval]) : bool
  (let
    [left-start : i64 (struct-get left start)]
    [right-start : i64 (struct-get right start)]
    [left-end : i64 (struct-get left end)]
    [right-end : i64 (struct-get right end)]
    (cond
      [(< left-start right-start) true]
      [(> left-start right-start) false]
      [(< left-end right-end) true]
      [(> left-end right-end) false]
      [else (< (struct-get left var) (struct-get right var))])))

(define (compiler-reg-candidate-interval-copy [item : CompilerRegInterval]) : CompilerRegInterval
  (CompilerRegInterval
    (struct-get item var)
    (struct-get item start)
    (struct-get item end)))

(define (compiler-reg-candidate-sift-down
  [items : (Array CompilerRegInterval)]
  [root : i64]
  [count : i64]) : unit
  (let
    [node : i64 root]
    [done : bool false]
    (while (not done)
      (let
        [left : i64 (+ (* node 2) 1)]
        [right : i64 (+ (* node 2) 2)]
        [largest : i64
          (let
            [pick : i64 node]
            (begin
              (if (and
                (< left count)
                (compiler-reg-interval-before?
                  (array-ref items pick)
                  (array-ref items left)))
                (set! pick left)
                unit)
              (if (and
                (< right count)
                (compiler-reg-interval-before?
                  (array-ref items pick)
                  (array-ref items right)))
                (set! pick right)
                unit)
              pick))]
        (if (= largest node)
          (set! done true)
          (let
            [node-item : CompilerRegInterval
              (compiler-reg-candidate-interval-copy (array-ref items node))]
            [largest-item : CompilerRegInterval
              (compiler-reg-candidate-interval-copy (array-ref items largest))]
            (begin
              (array-set! items node largest-item)
              (array-set! items largest node-item)
              (set! node largest))))))))

(define (compiler-reg-candidate-heapsort!
  [items : (Array CompilerRegInterval)]
  [count : i64]) : unit
  (begin
    (let
      [index : i64 (- (/ count 2) 1)]
      (while (>= index 0)
        (begin
          (compiler-reg-candidate-sift-down items index count)
          (set! index (- index 1)))))
    (let
      [last : i64 (- count 1)]
      (while (> last 0)
        (let
          [root-item : CompilerRegInterval
            (compiler-reg-candidate-interval-copy (array-ref items 0))]
          [last-item : CompilerRegInterval
            (compiler-reg-candidate-interval-copy (array-ref items last))]
          (begin
            (array-set! items 0 last-item)
            (array-set! items last root-item)
            (compiler-reg-candidate-sift-down items 0 last)
            (set! last (- last 1))))))))

(define (compiler-reg-candidate-sort [candidates : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [count : i64 (compiler-reg-interval-seq-count candidates)]
    [items : (Array CompilerRegInterval)
      (array.make-array CompilerRegInterval count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            items
            index
            (compiler-reg-interval-seq-ref candidates index))
          (set! index (+ index 1))))
      (compiler-reg-candidate-heapsort! items count)
      (CompilerRegIntervalSeq items count))))

(define (compiler-reg-candidates
  [intervals : CompilerRegIntervalSeq]
  [types : CompilerRegVarTypes]
  [ineligible : CompilerLiveI64Set]
  [want-float : bool]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count intervals))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          (begin
            (let
              [var : i64 (struct-get interval var)]
              (if (compiler-live-set-contains? ineligible var)
                unit
                (match (compiler-reg-var-types-lookup types var)
                  [(CompilerRegMaybeType.Some ty)
                    (if (if want-float
                      (compiler-reg-float-type? ty)
                      (not (compiler-reg-float-type? ty)))
                      (set! out (compiler-reg-interval-seq-append out interval))
                      unit)]
                  [(CompilerRegMaybeType.No) unit])))
            (set! index (+ index 1)))))
      (compiler-reg-candidate-sort out))))

(define (compiler-reg-vector-defs-instr
  [instr : CompilerIrInstr]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.LaneId dst _ _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.Splat dst _ _ _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        (compiler-live-set-insert set dst))]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (match elem-ty
          [(AstType.Bool) set]
          [_ (compiler-live-set-insert set dst)]))]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        (if (= lanes 0)
          set
          (compiler-live-set-insert set dst)))]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _)
      (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (match elem-ty
          [(AstType.Bool) set]
          [_ (compiler-live-set-insert set dst)]))]
    [(CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        (compiler-live-set-insert set dst))]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        (compiler-live-set-insert set dst))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (struct-get (box-get payload-box) backend)]
        [result (struct-get (box-get payload-box) result)]
        (match backend
          [(CompilerIrSpmdBackend.Avx512)
            (match result
              [(CompilerIrSpmdCallResult.Unit) set]
              [(CompilerIrSpmdCallResult.Value dst class _)
                (match class
                  [(CompilerIrSpmdValueClass.Varying)
                    (compiler-live-set-insert set dst)]
                  [_ set])])]
          [_ set]))]
    [_ set]))

(define (compiler-reg-mask-defs-instr
  [instr : CompilerIrInstr]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        (compiler-live-set-insert set dst))]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.MaskNot dst _ _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (match elem-ty
          [(AstType.Bool) (compiler-live-set-insert set dst)]
          [_ set]))]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (match elem-ty
          [(AstType.Bool) (compiler-live-set-insert set dst)]
          [_ set]))]
    [(CompilerIrInstr.TailMask dst _ _ _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (struct-get (box-get payload-box) backend)]
        [result (struct-get (box-get payload-box) result)]
        (match backend
          [(CompilerIrSpmdBackend.Avx512)
            (match result
              [(CompilerIrSpmdCallResult.Unit) set]
              [(CompilerIrSpmdCallResult.Value dst class _)
                (match class
                  [(CompilerIrSpmdValueClass.Mask)
                    (compiler-live-set-insert set dst)]
                  [_ set])])]
          [_ set]))]
    [_ set]))

(define (compiler-reg-spmd-private-param-defs
  [params : CompilerIrParamList]
  [vector-set : CompilerLiveI64Set]
  [mask-set : CompilerLiveI64Set]) : CompilerLiveUseDef
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) (CompilerLiveUseDef vector-set mask-set)]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-spmd-private-param-defs
        (compiler-ir-param-seq-to-list seq)
        vector-set
        mask-set)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param name _ var)
          (compiler-reg-spmd-private-param-defs
            (box-get rest)
            (if (compiler-reg-spmd-varying-param? name)
              (compiler-live-set-insert vector-set var)
              vector-set)
            (if (compiler-reg-spmd-mask-param? name)
              (compiler-live-set-insert mask-set var)
              mask-set))])]))

(define (compiler-reg-vector-mask-defs-instr-seq
  [instrs : CompilerIrInstrSeq]
  [vector-set : CompilerLiveI64Set]
  [mask-set : CompilerLiveI64Set]) : CompilerLiveUseDef
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out-vector : CompilerLiveI64Set vector-set]
    [out-mask : CompilerLiveI64Set mask-set]
    (begin
      (while (< index count)
        (begin
          (set!
            out-vector
            (compiler-reg-vector-defs-instr (array-ref slots index) out-vector))
          (set!
            out-mask
            (compiler-reg-mask-defs-instr (array-ref slots index) out-mask))
          (set! index (+ index 1))))
      (CompilerLiveUseDef out-vector out-mask))))

(define (compiler-reg-vector-mask-defs-blocks
  [blocks : CompilerIrBlockList]
  [vector-set : CompilerLiveI64Set]
  [mask-set : CompilerLiveI64Set]) : CompilerLiveUseDef
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerLiveUseDef vector-set mask-set)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [defs : CompilerLiveUseDef
              (compiler-reg-vector-mask-defs-instr-seq
                instrs
                vector-set
                mask-set)]
            (compiler-reg-vector-mask-defs-blocks
              (box-get rest)
              (struct-get defs uses)
              (struct-get defs defs)))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-vector : CompilerLiveI64Set vector-set]
        [out-mask : CompilerLiveI64Set mask-set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (let
                    [defs : CompilerLiveUseDef
                      (compiler-reg-vector-mask-defs-instr-seq
                        instrs
                        out-vector
                        out-mask)]
                    (begin
                      (set! out-vector (struct-get defs uses))
                      (set! out-mask (struct-get defs defs))))])
              (set! i (+ i 1))))
          (CompilerLiveUseDef out-vector out-mask)))]))

(define (compiler-reg-function-vector-mask-defs [func : CompilerIrFunction]) : CompilerLiveUseDef
  (match func
    [(CompilerIrFunction.Function _ params _ _ blocks)
      (let
        [defs : CompilerLiveUseDef
          (compiler-reg-spmd-private-param-defs
            params
            (compiler-live-set-empty)
            (compiler-live-set-empty))]
        (compiler-reg-vector-mask-defs-blocks
          blocks
          (struct-get defs uses)
          (struct-get defs defs)))]))

(define (compiler-reg-special-candidates
  [intervals : CompilerRegIntervalSeq]
  [vars : CompilerLiveI64Set]
  [blocked : CompilerLiveI64Set]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count intervals))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          (begin
            (let
              [var : i64 (struct-get interval var)]
              (if (and
                (compiler-live-set-contains? vars var)
                (not (compiler-live-set-contains? blocked var)))
                (set! out (compiler-reg-interval-seq-append out interval))
                unit))
            (set! index (+ index 1)))))
      (compiler-reg-candidate-sort out))))

;; Vector/mask IR values carry their scalar lane type in type-info, so the
;; earlier scalar-class greedy can provisionally assign them a GP/XMM home.
;; Class-specific allocation owns the final home and must replace that
;; provisional assignment; the old fixed-candidate allocator did so implicitly.
(define (compiler-reg-unassign-special-candidates!
  [assignments : CompilerRegAssignmentTable]
  [candidates : CompilerRegIntervalSeq]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count candidates))
      (begin
        (compiler-reg-assignment-table-unassign
          assignments
          (struct-get (compiler-reg-interval-seq-ref candidates index) var))
        (set! index (+ index 1))))))

(define (compiler-reg-active-before?
  [left : CompilerRegActive]
  [right : CompilerRegActive]) : bool
  (let
    [left-end : i64 (struct-get left end)]
    [right-end : i64 (struct-get right end)]
    (if (< left-end right-end)
      true
      (if (> left-end right-end)
        false
        (< (struct-get left var) (struct-get right var))))))

;; Place `item` after every element it does not strictly precede -- the position
;; the former cons walk chose -- shifting the suffix up one slot.
(define (compiler-reg-active-insert
  [active : CompilerRegActiveSeq]
  [item : CompilerRegActive]) : CompilerRegActiveSeq
  (let
    [slots : (Array CompilerRegActive) (struct-get active slots)]
    [len : i64 (struct-get active len)]
    [at : i64 0]
    (begin
      (while (and
        (< at len)
        (not (compiler-reg-active-before? item (array-ref slots at))))
        (set! at (+ at 1)))
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (Array CompilerRegActive)
            (array.make-array
              CompilerRegActive
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (array-set! bigger i (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (let
        [j : i64 len]
        (while (> j at)
          (begin
            (array-set! slots j (array-ref slots (- j 1)))
            (set! j (- j 1)))))
      (array-set! slots at item)
      (CompilerRegActiveSeq slots (+ len 1)))))

;; Drop everything that ended at or before `start`. Survivors are re-inserted
;; from the back so the result matches the former tail-first cons rebuild.
(define (compiler-reg-expire-active
  [active : CompilerRegActiveSeq]
  [start : i64]) : CompilerRegActiveSeq
  (let
    [slots : (Array CompilerRegActive) (struct-get active slots)]
    [index : i64 (- (struct-get active len) 1)]
    [out : CompilerRegActiveSeq (compiler-reg-active-seq-empty)]
    (begin
      (while (>= index 0)
        (begin
          (let
            [item : CompilerRegActive (array-ref slots index)]
            (if (<= (struct-get item end) start)
              unit
              (set! out (compiler-reg-active-insert out item))))
          (set! index (- index 1))))
      out)))

;; General hole-filling: is `reg` held by an active value that
;; conflicts with `var`? Two same-register values conflict iff their live
;; SEGMENTS overlap. This is sound for EVERY candidate because the allocator runs
;; on the merged-root index, where each candidate carries complete segments -- a
;; singleton its own live range, a class root the union of its members'. Every
;; segment hole is therefore genuine deadness, exactly the LLVM LiveInterval
;; property that makes segment-overlap an exact interference test. The earlier
;; rule trusted holes only for non-singleton roots, conservatively treating all
;; other values' segments as if incomplete; the merged-root index guarantees they
;; are not, so the restriction is dropped. (`hole-aware-vars` is retained on the
;; signature for the call sites but no longer gates the decision.)
(define (compiler-reg-active-register-conflicts?
  [active : CompilerRegActiveSeq]
  [reg : i64]
  [index : CompilerRegIntervalIndex]
  [var : i64]
  ;; lint-allow: unused-variable
  [hole-aware-vars : CompilerLiveI64Set]) : bool
  (let
    [slots : (Array CompilerRegActive) (struct-get active slots)]
    [count : i64 (struct-get active len)]
    [at : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< at count) (not conflict))
        (begin
          (let
            [item : CompilerRegActive (array-ref slots at)]
            (if (and
              (compiler-reg-registers-overlap? reg (struct-get item reg))
              (compiler-reg-vars-interfere-segmented-index?
                index
                var
                (struct-get item var)))
              (set! conflict true)
              unit))
          (set! at (+ at 1))))
      conflict)))

;; First register not in conflict with `var` over its live segments
;; (CompilerRegMaybeId.No if every register is occupied by an interfering value).
(define (compiler-reg-first-free-register-holes
  [regs : CompilerRegIdList]
  [active : CompilerRegActiveSeq]
  [index : CompilerRegIntervalIndex]
  [var : i64]
  [hole-aware-vars : CompilerLiveI64Set]) : CompilerRegMaybeId
  (match regs
    [(CompilerRegIdList.Nil) (CompilerRegMaybeId.No)]
    [(CompilerRegIdList.Cons reg rest)
      (if (compiler-reg-active-register-conflicts?
        active
        reg
        index
        var
        hole-aware-vars)
        (compiler-reg-first-free-register-holes
          (box-get rest)
          active
          index
          var
          hole-aware-vars)
        (CompilerRegMaybeId.Some reg))]))

(define (compiler-reg-assignment-insert
  [assignments : CompilerRegAssignmentList]
  [var : i64]
  [location : CompilerRegLocation]) : CompilerRegAssignmentList
  (match assignments
    [(CompilerRegAssignmentList.Nil)
      (compiler-reg-assignment-cons
        (CompilerRegAssignment var location)
        CompilerRegAssignmentList.Nil)]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [id : i64 (struct-get item var)]
        (if (= id var)
          (compiler-reg-assignment-cons
            (CompilerRegAssignment var location)
            (box-get rest))
          (if (> id var)
            (compiler-reg-assignment-cons
              (CompilerRegAssignment var location)
              assignments)
            (compiler-reg-assignment-cons
              item
              (compiler-reg-assignment-insert (box-get rest) var location)))))]))

(define (compiler-reg-assignment-lookup
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : CompilerRegMaybeLocation
  (let
    [cursor : CompilerRegAssignmentList assignments]
    [result : CompilerRegMaybeLocation CompilerRegMaybeLocation.No]
    [done : bool false]
    (begin
      (while (not done)
        (match cursor
          [(CompilerRegAssignmentList.Nil) (set! done true)]
          [(CompilerRegAssignmentList.Cons item rest)
            (let
              [id : i64 (struct-get item var)]
              (if (= id var)
                (begin
                  (set!
                    result
                    (CompilerRegMaybeLocation.Some (struct-get item location)))
                  (set! done true))
                (if (> id var)
                  (set! done true)
                  (set! cursor (box-get rest)))))]))
      result)))

(define (compiler-reg-location-eq?
  [left : CompilerRegLocation]
  [right : CompilerRegLocation]) : bool
  (match left
    [(CompilerRegLocation.Register left-reg)
      (match right
        [(CompilerRegLocation.Register right-reg) (= left-reg right-reg)]
        [_ false])]
    [(CompilerRegLocation.RegisterPair left-a left-b)
      (match right
        [(CompilerRegLocation.RegisterPair right-a right-b)
          (and (= left-a right-a) (= left-b right-b))]
        [_ false])]
    [(CompilerRegLocation.Spill left-offset)
      (match right
        [(CompilerRegLocation.Spill right-offset) (= left-offset right-offset)]
        [_ false])]
    ;; Conservative: distinct rematerialised values never alias, and treating two
    ;; equal ones as different only forgoes a copy elision (never unsound).
    [(CompilerRegLocation.Remat _) false]))

;; Physical ownership overlap is deliberately separate from logical location
;; equality.  A %vec6 vector home and a %xmm6 scalar home are different
;; allocator-class spellings, but they cannot hold interfering values.  Spill
;; slots retain their existing exact-offset alias rule.
(define (compiler-reg-location-overlaps?
  [left : CompilerRegLocation]
  [right : CompilerRegLocation]) : bool
  (match left
    [(CompilerRegLocation.Register left-reg)
      (match right
        [(CompilerRegLocation.Register right-reg)
          (compiler-reg-registers-overlap? left-reg right-reg)]
        [(CompilerRegLocation.RegisterPair right-a right-b)
          (or
            (compiler-reg-registers-overlap? left-reg right-a)
            (compiler-reg-registers-overlap? left-reg right-b))]
        [_ false])]
    [(CompilerRegLocation.RegisterPair left-a left-b)
      (match right
        [(CompilerRegLocation.Register right-reg)
          (or
            (compiler-reg-registers-overlap? left-a right-reg)
            (compiler-reg-registers-overlap? left-b right-reg))]
        [(CompilerRegLocation.RegisterPair right-a right-b)
          (or
            (compiler-reg-registers-overlap? left-a right-a)
            (compiler-reg-registers-overlap? left-a right-b)
            (compiler-reg-registers-overlap? left-b right-a)
            (compiler-reg-registers-overlap? left-b right-b))]
        [_ false])]
    [(CompilerRegLocation.Spill left-offset)
      (match right
        [(CompilerRegLocation.Spill right-offset) (= left-offset right-offset)]
        [_ false])]
    [(CompilerRegLocation.Remat _) false]))

(define (compiler-reg-location-uses-register?
  [location : CompilerRegLocation]
  [reg : i64]) : bool
  (match location
    [(CompilerRegLocation.Register found)
      (compiler-reg-registers-overlap? found reg)]
    [(CompilerRegLocation.RegisterPair a b)
      (or
        (compiler-reg-registers-overlap? a reg)
        (compiler-reg-registers-overlap? b reg))]
    [(CompilerRegLocation.Spill _) false]
    [(CompilerRegLocation.Remat _) false]))

(define (compiler-reg-location-primary-register
  [location : CompilerRegLocation]) : i64
  (match location
    [(CompilerRegLocation.Register found) found]
    [(CompilerRegLocation.RegisterPair first _) first]
    [_ compiler-reg-id-invalid]))

(define (compiler-reg-assignment-index-var-uses-register?
  [assignment-index : CompilerRegAssignmentIndex]
  [var : i64]
  [reg : i64]) : bool
  (match (compiler-reg-assignment-index-lookup assignment-index var)
    [(CompilerRegMaybeLocation.Some location)
      (compiler-reg-location-uses-register? location reg)]
    [(CompilerRegMaybeLocation.No) false]))

(define (compiler-reg-assignment-index-primary-register-home
  [assignment-index : CompilerRegAssignmentIndex]
  [var : i64]) : i64
  (match (compiler-reg-assignment-index-lookup assignment-index var)
    [(CompilerRegMaybeLocation.Some location)
      (compiler-reg-location-primary-register location)]
    [(CompilerRegMaybeLocation.No) compiler-reg-id-invalid]))

(define (compiler-reg-assignments-use-register?
  [assignments : CompilerRegAssignmentList]
  [reg : i64]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (if (compiler-reg-location-uses-register? (struct-get item location) reg)
        true
        (compiler-reg-assignments-use-register? (box-get rest) reg))]))

(define (compiler-reg-assignments-register-use-count
  [assignments : CompilerRegAssignmentList]
  [reg : i64]) : i64
  (match assignments
    [(CompilerRegAssignmentList.Nil) 0]
    [(CompilerRegAssignmentList.Cons item rest)
      (+
        (if (compiler-reg-location-uses-register?
          (struct-get item location)
          reg)
          1
          0)
        (compiler-reg-assignments-register-use-count (box-get rest) reg))]))

(define (compiler-reg-var-live-at-point?
  [starts : (Array i64)]
  [ends : (Array i64)]
  [var : i64]
  [point : i64]) : bool
  (and
    (>= var 0)
    (< var (array-length starts))
    (< var (array-length ends))
    (>= (array-ref starts var) 0)
    (<= (array-ref starts var) point)
    (<= point (array-ref ends var))))

(define (compiler-reg-var-live-over-range?
  [starts : (Array i64)]
  [ends : (Array i64)]
  [var : i64]
  [lo : i64]
  [hi : i64]) : bool
  (and
    (>= var 0)
    (< var (array-length starts))
    (< var (array-length ends))
    (>= (array-ref starts var) 0)
    (>= (array-ref ends var) 0)
    (<= (array-ref starts var) hi)
    (<= lo (array-ref ends var))))

(define (compiler-reg-assignment-index-register-free-at-point?
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : CompilerRegAssignmentIndex]
  [vars : i64]
  [point : i64]
  [reg : i64]) : bool
  (let
    [v : i64 0]
    [free : bool true]
    (begin
      (while (and (< v vars) free)
        (begin
          (if (and
            (compiler-reg-var-live-at-point? starts ends v point)
            (compiler-reg-assignment-index-var-uses-register?
              assignment-index
              v
              reg))
            (set! free false)
            unit)
          (set! v (+ v 1))))
      free)))

(define (compiler-reg-assignment-index-register-free-over-range?
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : CompilerRegAssignmentIndex]
  [vars : i64]
  [lo : i64]
  [hi : i64]
  [reg : i64]) : bool
  (let
    [v : i64 0]
    [free : bool true]
    (begin
      (while (and (< v vars) free)
        (begin
          (if (and
            (compiler-reg-var-live-over-range? starts ends v lo hi)
            (compiler-reg-assignment-index-var-uses-register?
              assignment-index
              v
              reg))
            (set! free false)
            unit)
          (set! v (+ v 1))))
      free)))

(define (compiler-reg-interval-lookup
  [intervals : CompilerRegIntervalSeq]
  [var : i64]) : CompilerRegMaybeInterval
  (let
    [index : i64 0]
    [result : CompilerRegMaybeInterval CompilerRegMaybeInterval.No]
    [done : bool false]
    (begin
      (while (and
        (< index (compiler-reg-interval-seq-count intervals))
        (not done))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [id : i64 (struct-get interval var)]
          (cond
            [(= id var)
              (begin
                (set! result (CompilerRegMaybeInterval.Some interval))
                (set! done true))]
            [(> id var) (set! done true)]
            [else (set! index (+ index 1))])))
      result)))

(define (compiler-reg-interval-overlap?
  [left : CompilerRegInterval]
  [right : CompilerRegInterval]) : bool
  (let
    [left-start : i64 (struct-get left start)]
    [left-end : i64 (struct-get left end)]
    [right-start : i64 (struct-get right start)]
    [right-end : i64 (struct-get right end)]
    ;; Half-open boundary touch (X.end == Y.start): X's last read happens
    ;; before Y's same-point def writes, so the pair may share a register
    ;; -- EXCEPT when the touch point is 0 (M-A RC1). A value live at
    ;; point 0 without a def there (a parameter) had its home register
    ;; written in the PROLOGUE, before point 0, which the point model
    ;; cannot represent: two params used only near entry would otherwise
    ;; look disjoint ([0,0] vs [0,e]) and share a home whose second entry
    ;; copy destroys the first param's value. A 0-touch therefore counts
    ;; as overlap; touches at any later point keep the half-open rule.
    (not
      (or
        (and (<= left-end right-start) (not (= right-start 0)))
        (and (<= right-end left-start) (not (= left-start 0)))))))

(define (compiler-reg-interval-seq-overlaps-one?
  [segments : CompilerRegIntervalSeq]
  [interval : CompilerRegInterval]) : bool
  (let
    [slots : (Array CompilerRegInterval) (struct-get segments slots)]
    [count : i64 (struct-get segments len)]
    [index : i64 0]
    [overlap : bool false]
    [done : bool false]
    (begin
      (while (and (< index count) (not done))
        (let
          [head : CompilerRegInterval (array-ref slots index)]
          [head-start : i64 (struct-get head start)]
          [head-end : i64 (struct-get head end)]
          [interval-start : i64 (struct-get interval start)]
          [interval-end : i64 (struct-get interval end)]
          (cond
            [(and (<= head-end interval-start) (not (= interval-start 0)))
              (set! index (+ index 1))]
            [(and (<= interval-end head-start) (not (= head-start 0)))
              (set! done true)]
            [else
              (begin
                (set! overlap true)
                (set! done true))])))
      overlap)))

(define (compiler-reg-interval-seq-overlaps?
  [left : CompilerRegIntervalSeq]
  [right : CompilerRegIntervalSeq]) : bool
  (let
    [left-slots : (Array CompilerRegInterval) (struct-get left slots)]
    [right-slots : (Array CompilerRegInterval) (struct-get right slots)]
    [left-count : i64 (struct-get left len)]
    [right-count : i64 (struct-get right len)]
    [left-index : i64 0]
    [right-index : i64 0]
    [overlap : bool false]
    (begin
      ;; Both inputs are ascending by start. A non-overlapping pair lets the
      ;; scan retire the interval that ends first; neither cursor retreats.
      (while (and
        (< left-index left-count)
        (< right-index right-count)
        (not overlap))
        (let
          [left-interval : CompilerRegInterval
            (array-ref left-slots left-index)]
          [right-interval : CompilerRegInterval
            (array-ref right-slots right-index)]
          [left-start : i64 (struct-get left-interval start)]
          [left-end : i64 (struct-get left-interval end)]
          [right-start : i64 (struct-get right-interval start)]
          [right-end : i64 (struct-get right-interval end)]
          (cond
            [(and (<= left-end right-start) (not (= right-start 0)))
              (set! left-index (+ left-index 1))]
            [(and (<= right-end left-start) (not (= left-start 0)))
              (set! right-index (+ right-index 1))]
            [else (set! overlap true)])))
      overlap)))

(define (compiler-reg-interval-range?
  [intervals : CompilerRegIntervalSeq]
  [var : i64]
  [start : i64]
  [end : i64]) : bool
  (match (compiler-reg-interval-lookup intervals var)
    [(CompilerRegMaybeInterval.Some interval)
      (and
        (= (struct-get interval start) start)
        (= (struct-get interval end) end))]
    [(CompilerRegMaybeInterval.No) false]))

(define (compiler-reg-vars-interfere-index?
  [intervals : CompilerRegIntervalIndex]
  [left : i64]
  [right : i64]) : bool
  (if (= left right)
    true
    (match (compiler-reg-interval-index-lookup intervals left)
      [(CompilerRegMaybeInterval.Some left-interval)
        (match (compiler-reg-interval-index-lookup intervals right)
          [(CompilerRegMaybeInterval.Some right-interval)
            (compiler-reg-interval-overlap? left-interval right-interval)]
          [(CompilerRegMaybeInterval.No) true])]
      [(CompilerRegMaybeInterval.No) true])))

;; Answer interference from per-var live segments when both
;; sides have segment data, with the coarse interval as the conservative
;; fallback.
(define (compiler-reg-vars-interfere-segmented-index?
  [intervals : CompilerRegIntervalIndex]
  [left : i64]
  [right : i64]) : bool
  (if (= left right)
    true
    (let
      [segments : (Array CompilerRegIntervalSeq)
        (struct-get intervals segments)]
      [left-segments : CompilerRegIntervalSeq
        (if (or (< left 0) (>= left (array-length segments)))
          (compiler-reg-interval-seq-empty)
          (array-ref segments left))]
      [right-segments : CompilerRegIntervalSeq
        (if (or (< right 0) (>= right (array-length segments)))
          (compiler-reg-interval-seq-empty)
          (array-ref segments right))]
      (if (and
        (not (compiler-reg-interval-seq-empty? left-segments))
        (not (compiler-reg-interval-seq-empty? right-segments)))
        (compiler-reg-interval-seq-overlaps? left-segments right-segments)
        (compiler-reg-vars-interfere-index? intervals left right)))))

;; Two values may share a register iff they occupy the SAME register class. The
;; old rule demanded identical AstType tags AND scalar-ness, which refused to
;; coalesce a copy between e.g. an i64 and a Ptr, or -- far more commonly in this
;; compiler -- between any two 8-byte HANDLE values (Enum/Struct/String/Box/Array
;; descriptors), even though all of those live in one GP register and are moved
;; with a plain movq. Nominal type is irrelevant to register sharing: the only
;; constraint is GP-vs-SSE (you cannot put a GP value in an XMM register), and
;; width consistency is already guaranteed because coalescing is driven by pure
;; moves, whose two endpoints always have the same representation. So: both
;; register-eligible, and both the same register class.
(define (compiler-reg-compatible-types?
  [types : CompilerRegVarTypes]
  [left : i64]
  [right : i64]) : bool
  (match (compiler-reg-var-types-lookup types left)
    [(CompilerRegMaybeType.Some left-ty)
      (match (compiler-reg-var-types-lookup types right)
        [(CompilerRegMaybeType.Some right-ty)
          (and
            (compiler-reg-register-eligible-type? left-ty)
            (compiler-reg-register-eligible-type? right-ty)
            (if (compiler-reg-float-type? left-ty)
              (compiler-reg-float-type? right-ty)
              (not (compiler-reg-float-type? right-ty))))]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerRegMaybeType.No) false]))

;; M-C2: the overlap waiver admits every REGISTER-ELIGIBLE non-group value,
;; not just CPU scalars. The scalar-type? restriction predated handle register
;; eligibility (M-A/M-A2): when it was written, 8-byte handle values
;; (Array/String/enum/struct descriptors) were categorically stack-homed, so
;; scalar-only merely mirrored global eligibility. The waiver's value-carry
;; proof (single-def direct-copy chain => one register holds the shared bit
;; pattern) is representation-based and type-agnostic for anything the backend
;; moves with a plain movq; register groups never reach this test (both sides
;; are refused via group-vars in compiler-reg-coalesce-vars-compatible?), and
;; the float check keeps GP/XMM classes apart exactly as before.
(define (compiler-reg-same-value-overlap-eligible?
  [types : CompilerRegVarTypes]
  [left : i64]
  [right : i64]) : bool
  (match (compiler-reg-var-types-lookup types left)
    [(CompilerRegMaybeType.Some left-ty)
      (match (compiler-reg-var-types-lookup types right)
        [(CompilerRegMaybeType.Some right-ty)
          (and
            (compiler-reg-register-eligible-type? left-ty)
            (compiler-reg-register-eligible-type? right-ty)
            (if (compiler-reg-float-type? left-ty)
              (compiler-reg-float-type? right-ty)
              (not (compiler-reg-float-type? right-ty))))]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerRegMaybeType.No) false]))

(define (compiler-reg-location-conflicts?
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [assigned-var : i64 (struct-get item var)]
        [assigned-location : CompilerRegLocation (struct-get item location)]
        (if (or (= assigned-var var) (= assigned-var ignore-var))
          (compiler-reg-location-conflicts?
            (box-get rest)
            intervals
            var
            ignore-var
            location)
          (if (and
            (compiler-reg-location-overlaps? assigned-location location)
            (compiler-reg-vars-interfere-index? intervals var assigned-var))
            true
            (compiler-reg-location-conflicts?
              (box-get rest)
              intervals
              var
              ignore-var
              location))))]))

(define (compiler-reg-assignment-table-location-conflicts-from?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]
  [index : i64]) : bool
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    (cond
      [(>= index (array-length present)) false]
      [(= (array-ref present index) 0)
        (compiler-reg-assignment-table-location-conflicts-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(or (= index var) (= index ignore-var))
        (compiler-reg-assignment-table-location-conflicts-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(and
          (compiler-reg-location-overlaps? (array-ref items index) location)
          (compiler-reg-vars-interfere-index? intervals var index))
        true]
      [else
        (compiler-reg-assignment-table-location-conflicts-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))])))

(define (compiler-reg-assignment-table-location-conflicts?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (compiler-reg-assignment-table-location-conflicts-from?
    assignments
    intervals
    var
    ignore-var
    location
    0))

(define (compiler-reg-assignment-table-location-conflicts-segmented-from?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]
  [index : i64]) : bool
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    (cond
      [(>= index (array-length present)) false]
      [(= (array-ref present index) 0)
        (compiler-reg-assignment-table-location-conflicts-segmented-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(or (= index var) (= index ignore-var))
        (compiler-reg-assignment-table-location-conflicts-segmented-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(and
          (compiler-reg-location-overlaps? (array-ref items index) location)
          (compiler-reg-vars-interfere-segmented-index? intervals var index))
        true]
      [else
        (compiler-reg-assignment-table-location-conflicts-segmented-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))])))

(define (compiler-reg-assignment-table-location-conflicts-segmented?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (compiler-reg-assignment-table-location-conflicts-segmented-from?
    assignments
    intervals
    var
    ignore-var
    location
    0))

;; ---------------------------------------------------------------------------
;; #2 value-number same-value coalescing (move-flood bucket b).
;;
;; Bucket b (un-coalesced SSA copies, the dominant move class) is src-live
;; fan-out: `dst := src` where src stays live past the copy, so src and dst
;; OVERLAP and the interference-gated coalescer rejects them. But a copy whose
;; dst and src are BOTH single-static-def holds one identical value over the
;; entire overlap (dst mirrors src, neither is ever redefined), so merging them
;; into one register is sound regardless of overlap -- LLVM's
;; valuesIdentical/CR_Erase case (RegisterCoalescer.cpp:2799/3008).
;;
;; SOUNDNESS: only DIRECT `CompilerIrInstr.Mov dst (CompilerIrValue.Var src)` copies with
;; def-count[dst]==def-count[src]==1 enter the same-value relation. Phi inputs
;; (path-dependent) and multi-def vars -- the loop-carried set!/back-edge values
;; that are the fibonacci/four_acc/bce_sum miscompile class -- are EXCLUDED
;; because loop-carried values are lowered to phis or carry multiple defs and so
;; are never single-def direct copies. The relaxation only WAIVES interference
;; for proven same-value pairs; the geometry predicate is unchanged, and the
;; all-pairs class-compatibility check still rejects any class that would mix a
;; distinct-value var with an overlapping member.
;; The single var an instruction defines, or -1. Mirrors the def list of
;; compiler-reg-instr-def-type-array! so the def census stays complete (a missed def
;; site would understate a multi-def var and is the one unsound failure mode).
(define (compiler-reg-instr-def-var [instr : CompilerIrInstr]) : i64
  (match instr
    [(CompilerIrInstr.Mov dst _ _) dst]
    [(CompilerIrInstr.Alloc dst _) dst]
    [(CompilerIrInstr.AddrOf dst _) dst]
    [(CompilerIrInstr.Gep dst _ _ _) dst]
    [(CompilerIrInstr.Load dst _ _) dst]
    [(CompilerIrInstr.Cast dst _ _ _) dst]
    [(CompilerIrInstr.Bitcast dst _ _ _) dst]
    [(CompilerIrInstr.BinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.UnOp dst _ _ _) dst]
    [(CompilerIrInstr.LaneId dst _ _) dst]
    [(CompilerIrInstr.Splat dst _ _ _) dst]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.VectorReduce dst _ _ _ _) dst]
    [(CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _) dst]
    [(CompilerIrInstr.MaskNot dst _ _) dst]
    [(CompilerIrInstr.MaskReduce dst _ _ _) dst]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.VectorLoad dst _ _ _ _) dst]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        dst)]
    [(CompilerIrInstr.TailMask dst _ _ _) dst]
    [(CompilerIrInstr.EntryArgc dst) dst]
    [(CompilerIrInstr.EntryArgv dst) dst]
    [(CompilerIrInstr.EntryEnvp dst) dst]
    [(CompilerIrInstr.CpuId dst _ _ _) dst]
    [(CompilerIrInstr.Xgetbv dst _) dst]
    [(CompilerIrInstr.Syscall dst _) dst]
    [(CompilerIrInstr.Call dst _ _ _) dst]
    [(CompilerIrInstr.CallIndirect dst _ _ _) dst]
    [(CompilerIrInstr.CallIndirectC dst _ _ _) dst]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (struct-get (box-get payload-box) result)]
        (match result
          [(CompilerIrSpmdCallResult.Unit) (- 0 1)]
          [(CompilerIrSpmdCallResult.Value dst _ _) dst]))]
    [(CompilerIrInstr.Phi dst _ _) dst]
    [(CompilerIrInstr.Pack dst _ _) dst]
    [(CompilerIrInstr.Word dst _ _ _) dst]
    [_ (- 0 1)]))

(define (compiler-reg-count-def! [counts : (Array i64)] [var : i64]) : unit
  (if (and (>= var 0) (< var (array-length counts)))
    (array-set! counts var (+ (array-ref counts var) 1))
    unit))

(define (compiler-reg-count-seq-defs!
  [instrs : CompilerIrInstrSeq]
  [counts : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-count-def!
            counts
            (compiler-reg-instr-def-var (array-ref slots index)))
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-count-block-defs!
  [blocks : CompilerIrBlockList]
  [counts : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-count-seq-defs! instrs counts)
            (compiler-reg-count-block-defs! (box-get rest) counts))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-count-seq-defs! instrs counts)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-mark-phi-def! [phi-defs : (Array i64)] [var : i64]) : unit
  (if (and (>= var 0) (< var (array-length phi-defs)))
    (array-set! phi-defs var 1)
    unit))

(define (compiler-reg-mark-phi-defs-seq!
  [instrs : CompilerIrInstrSeq]
  [phi-defs : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(CompilerIrInstr.Phi dst _ _)
              (compiler-reg-mark-phi-def! phi-defs dst)]
            [_ unit])
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-mark-phi-defs-blocks!
  [blocks : CompilerIrBlockList]
  [phi-defs : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-mark-phi-defs-seq! instrs phi-defs)
            (compiler-reg-mark-phi-defs-blocks! (box-get rest) phi-defs))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-mark-phi-defs-seq! instrs phi-defs)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-param-count-defs!
  [params : CompilerIrParamList]
  [counts : (Array i64)]) : unit
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) unit]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-param-count-defs!
        (compiler-ir-param-seq-to-list seq)
        counts)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ id)
          (begin
            (compiler-reg-count-def! counts id)
            (compiler-reg-param-count-defs! (box-get rest) counts))])]))

(define (compiler-reg-function-def-counts [func : CompilerIrFunction]) : (Array
    i64)
  (match func
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [counts : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-param-count-defs! params counts)
          (compiler-reg-count-block-defs! blocks counts)
          counts))]))

;; Same-value union-find, path-compressed; the class root is its min member id.
(define (compiler-reg-sv-find [parents : (Array i64)] [x : i64]) : i64
  (if (or (< x 0) (>= x (array-length parents)))
    (- 0 1)
    (let
      [p : i64 (array-ref parents x)]
      (if (= p x)
        x
        (let
          [r : i64 (compiler-reg-sv-find parents p)]
          (begin
            (array-set! parents x r)
            r))))))

(define (compiler-reg-sv-union! [parents : (Array i64)] [a : i64] [b : i64]) : unit
  (let
    [ra : i64 (compiler-reg-sv-find parents a)]
    [rb : i64 (compiler-reg-sv-find parents b)]
    (if (or (< ra 0) (< rb 0) (= ra rb))
      unit
      (if (< ra rb)
        (array-set! parents rb ra)
        (array-set! parents ra rb)))))

(define (compiler-reg-sv-single-def? [counts : (Array i64)] [var : i64]) : bool
  (and (>= var 0) (< var (array-length counts)) (= (array-ref counts var) 1)))

(define (compiler-reg-sv-single-def-non-phi?
  [counts : (Array i64)]
  [phi-defs : (Array i64)]
  [var : i64]) : bool
  (and
    (compiler-reg-sv-single-def? counts var)
    (or (>= var (array-length phi-defs)) (= (array-ref phi-defs var) 0))))

(define (compiler-reg-sv-eligible? [eligible : (Array i64)] [var : i64]) : bool
  (if (= (array-length eligible) 0)
    true
    (and
      (>= var 0)
      (< var (array-length eligible))
      (= (array-ref eligible var) 1))))

(define (compiler-reg-sv-add-instr!
  [instr : CompilerIrInstr]
  [counts : (Array i64)]
  [phi-defs : (Array i64)]
  [eligible : (Array i64)]
  [parents : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var svar)
          (if (and
            (compiler-reg-sv-single-def-non-phi? counts phi-defs dst)
            (compiler-reg-sv-single-def-non-phi? counts phi-defs svar)
            (compiler-reg-sv-eligible? eligible dst)
            (compiler-reg-sv-eligible? eligible svar))
            (compiler-reg-sv-union! parents svar dst)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-sv-seq!
  [instrs : CompilerIrInstrSeq]
  [counts : (Array i64)]
  [phi-defs : (Array i64)]
  [eligible : (Array i64)]
  [parents : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-sv-add-instr!
            (array-ref slots index)
            counts
            phi-defs
            eligible
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-sv-blocks!
  [blocks : CompilerIrBlockList]
  [counts : (Array i64)]
  [phi-defs : (Array i64)]
  [eligible : (Array i64)]
  [parents : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-sv-seq! instrs counts phi-defs eligible parents)
            (compiler-reg-sv-blocks!
              (box-get rest)
              counts
              phi-defs
              eligible
              parents))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-sv-seq! instrs counts phi-defs eligible parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-same-value-parents-filtered
  [func : CompilerIrFunction]
  [eligible : (Array i64)]) : (Array i64)
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [counts : (Array i64) (compiler-reg-function-def-counts func)]
        [phi-defs : (Array i64) (array.make-array i64 vars)]
        [parents : (Array i64) (array.make-array i64 vars)]
        [index : i64 0]
        (begin
          (compiler-reg-mark-phi-defs-blocks! blocks phi-defs)
          (while (< index vars)
            (begin
              (array-set! parents index index)
              (set! index (+ index 1))))
          (compiler-reg-sv-blocks! blocks counts phi-defs eligible parents)
          parents))]))

(define (compiler-reg-function-same-value-parents [func : CompilerIrFunction]) : (Array
    i64)
  (compiler-reg-function-same-value-parents-filtered
    func
    (array.make-array i64 0)))

(define (compiler-reg-same-value-eligible-vars
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : CompilerLiveI64Set]) : (Array i64)
  (let
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    [eligible : (Array i64) (array.make-array i64 (array-length starts))]
    [var : i64 0]
    (begin
      (while (< var (array-length starts))
        (begin
          (if (and
            (>= (array-ref starts var) 0)
            (not
              (compiler-reg-call-set-in-range?
                clobber-points
                (array-ref starts var)
                (array-ref ends var))))
            (array-set! eligible var 1)
            unit)
          (set! var (+ var 1))))
      eligible)))

(define (compiler-reg-same-value-eligible-vars-excluding
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : CompilerLiveI64Set]
  [storage-vars : CompilerLiveI64Set]) : (Array i64)
  (let
    [eligible : (Array i64)
      (compiler-reg-same-value-eligible-vars interval-index clobber-points)]
    [var : i64 0]
    (begin
      (while (< var (array-length eligible))
        (begin
          (if (compiler-live-set-contains? storage-vars var)
            (array-set! eligible var 0)
            unit)
          (set! var (+ var 1))))
      eligible)))

;; ---------------------------------------------------------------------------
;; M-C (part 1): same-value coalescing for copies OF mutable sources.
;;
;; The single-def-only same-value relation above never merges a copy of a
;; MUTABLE var (multi-def loop counter, or a phi-defined carry), so the
;; lowerer's fresh bounds-check index temps (`t = Mov i` / the width-64
;; `t = Cast i : u64`) each burn a register and a `movq` per iteration.
;;
;; Extension rule for `Mov/Cast64 dst <- src` where src is mutable:
;;   * dst is single-def non-phi and kind-0-eligible (existing semantics),
;;   * src is kind-0-eligible (existing clobber-span exclusion semantics),
;;   * both are GP-int scalars (floats/handles/groups excluded),
;;   * NO def point of the class's mutable member falls inside the LIVENESS
;;     (segments, hull fallback) of any single-def member of the other class.
;;
;; Soundness: the shared register is written by every def of the mutable m and
;; by each member's copy; two members co-live at q hold different values only
;; if some def D of m executed between their copy anchors -- but then the
;; earlier chain link is live AT D (its next use is reachable), so D lies in
;; that member's live segments and the merge was refused. Phi defs are modeled
;; at the phi instruction point: the backend writes phi homes only on the
;; specific CFG edge (single-successor pred ends, where live-out(pred) =
;; live-in(header), or dedicated `_branch_*` edge blocks -- switches reject phi
;; targets), and intra-edge-block read/write conflicts are ordered by the
;; parallel-copy solver, so "live at a write" implies "live at the phi point",
;; which the segment test sees. A class carries AT MOST ONE mutable member
;; (mutables only ever enter as copy SOURCES; a second one is refused), and the
;; def-inside check runs against the WHOLE other class on every union, so
;; copy-of-copy chains cannot smuggle a member past a def (the chain test).
;; The conservative interval-index is used (over-approximated liveness can only
;; refuse more), NOT the EP-relaxed coalesce index.
;;
;; The relation is consumed exactly like the single-def one: it only WAIVES the
;; overlap test for scalar pairs in compiler-reg-coalesce-vars-compatible?; the
;; merged root inherits the union interval/segments (merged-root-index), so
;; spans-call/div/shift for the class is the conservative OR of its members.
;; Only the scalar-opt2 plan builds this relation; SIMD/AVX and the post-hoc
;; loop-split/remat coalesce rebuilds keep the old builder byte-identical.
;; ---------------------------------------------------------------------------
(defstruct CompilerRegSvMultiCtx
  (parents (Array i64))
  (counts (Array i64))
  (phi-defs (Array i64))
  (eligible (Array i64))
  (class-multi (Array i64))
  (def-off (Array i64))
  (def-pts (Array i64))
  (starts (Array i64))
  (ends (Array i64))
  (segments (Array CompilerRegIntervalSeq))
  (int-ok (Array i64)))

;; Fill the flattened per-var def-point buckets (block defs only; param entry
;; defs execute before every instruction and can never fall between two copy
;; anchors, so they are excluded). Same 2-points-per-instruction numbering as
;; compiler-reg-clobber-kind-points and the interval builders.
(define (compiler-reg-sv-def-points-fill-seq
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [cursor : (Array i64)]
  [pts : (Array i64)]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [p : i64 point]
    (begin
      (while (< index count)
        (begin
          (let
            [v : i64 (compiler-reg-instr-def-var (array-ref slots index))]
            (if (and (>= v 0) (< v (array-length cursor)))
              (let
                [slot : i64 (array-ref cursor v)]
                (begin
                  (if (and (>= slot 0) (< slot (array-length pts)))
                    (array-set! pts slot p)
                    unit)
                  (array-set! cursor v (+ slot 1))))
              unit))
          (set! p (+ p 2))
          (set! index (+ index 1))))
      p)))

(define (compiler-reg-sv-def-points-fill-blocks
  [blocks : CompilerIrBlockList]
  [point : i64]
  [cursor : (Array i64)]
  [pts : (Array i64)]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) point]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-sv-def-points-fill-blocks
            (box-get rest)
            (compiler-reg-sv-def-points-fill-seq instrs point cursor pts)
            cursor
            pts)])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out-point
                    (compiler-reg-sv-def-points-fill-seq
                      instrs
                      out-point
                      cursor
                      pts))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-sv-point-in-segments?
  [segs : CompilerRegIntervalSeq]
  [p : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-interval-seq-count segs)) (not found))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref segs index)]
            (if (and
              (<= (struct-get interval start) p)
              (<= p (struct-get interval end)))
              (set! found true)
              (set! index (+ index 1))))
          unit))
      found)))

;; Is point p inside var v's liveness? Segment-precise when segments exist,
;; whole-hull fallback otherwise. Inclusive at both ends: a def point can never
;; equal another instruction's point, so inclusivity only rounds block-boundary
;; geometry conservatively (toward refusing a merge).
(define (compiler-reg-sv-point-in-var-live?
  [ctx : CompilerRegSvMultiCtx]
  [v : i64]
  [p : i64]) : bool
  (let
    [segments : (Array CompilerRegIntervalSeq) (struct-get ctx segments)]
    [starts : (Array i64) (struct-get ctx starts)]
    [ends : (Array i64) (struct-get ctx ends)]
    [segs : CompilerRegIntervalSeq
      (if (and (>= v 0) (< v (array-length segments)))
        (array-ref segments v)
        (compiler-reg-interval-seq-empty))]
    (if (compiler-reg-interval-seq-empty? segs)
      (if (and (>= v 0) (< v (array-length starts)))
        (and
          (>= (array-ref starts v) 0)
          (<= (array-ref starts v) p)
          (<= p (array-ref ends v)))
        false)
      (compiler-reg-sv-point-in-segments? segs p))))

;; Does any def point of mutable var m fall inside v's liveness?
(define (compiler-reg-sv-multi-def-in-var?
  [ctx : CompilerRegSvMultiCtx]
  [m : i64]
  [v : i64]) : bool
  (let
    [def-off : (Array i64) (struct-get ctx def-off)]
    [def-pts : (Array i64) (struct-get ctx def-pts)]
    (if (or (< m 0) (>= (+ m 1) (array-length def-off)))
      true
      (let
        [i : i64 (array-ref def-off m)]
        [stop : i64 (array-ref def-off (+ m 1))]
        [hit : bool false]
        (begin
          (while (< i stop)
            (begin
              (if (and
                (not hit)
                (compiler-reg-sv-point-in-var-live?
                  ctx
                  v
                  (if (and (>= i 0) (< i (array-length def-pts)))
                    (array-ref def-pts i)
                    (- 0 1))))
                (set! hit true)
                unit)
              (set! i (+ i 1))))
          hit)))))

;; Does any def point of m fall inside the liveness of ANY single-def member of
;; the class rooted at `root`?
(define (compiler-reg-sv-multi-conflict?
  [ctx : CompilerRegSvMultiCtx]
  [m : i64]
  [root : i64]) : bool
  (let
    [parents : (Array i64) (struct-get ctx parents)]
    [counts : (Array i64) (struct-get ctx counts)]
    [phi-defs : (Array i64) (struct-get ctx phi-defs)]
    [n : i64 (array-length parents)]
    [v : i64 0]
    [hit : bool false]
    (begin
      (while (< v n)
        (begin
          (if (and
            (not hit)
            (compiler-reg-sv-single-def-non-phi? counts phi-defs v)
            (= (compiler-reg-sv-find parents v) root)
            (compiler-reg-sv-multi-def-in-var? ctx m v))
            (set! hit true)
            unit)
          (set! v (+ v 1))))
      hit)))

;; Metadata-maintaining union: refuses a second mutable member, refuses when the
;; (dragged or direct) mutable's defs intrude into the other class's liveness,
;; and records the surviving class's mutable member under the new root.
(define (compiler-reg-sv-multi-union!
  [ctx : CompilerRegSvMultiCtx]
  [a : i64]
  [b : i64]) : unit
  (let
    [parents : (Array i64) (struct-get ctx parents)]
    [class-multi : (Array i64) (struct-get ctx class-multi)]
    [ra : i64 (compiler-reg-sv-find parents a)]
    [rb : i64 (compiler-reg-sv-find parents b)]
    (if (or (< ra 0) (< rb 0) (= ra rb))
      unit
      (let
        [ma : i64
          (if (< ra (array-length class-multi))
            (array-ref class-multi ra)
            (- 0 1))]
        [mb : i64
          (if (< rb (array-length class-multi))
            (array-ref class-multi rb)
            (- 0 1))]
        (if (and (>= ma 0) (>= mb 0))
          unit
          (let
            [m : i64
              (if (>= ma 0)
                ma
                mb)]
            (if (and
              (>= m 0)
              (compiler-reg-sv-multi-conflict?
                ctx
                m
                (if (>= ma 0)
                  rb
                  ra)))
              unit
              (begin
                (compiler-reg-sv-union! parents a b)
                (let
                  [r : i64 (compiler-reg-sv-find parents a)]
                  (if (and (>= r 0) (< r (array-length class-multi)))
                    (array-set! class-multi r m)
                    unit))))))))))

(define (compiler-reg-sv-int-ok? [int-ok : (Array i64)] [v : i64]) : bool
  (and (>= v 0) (< v (array-length int-ok)) (= (array-ref int-ok v) 1)))

;; One copy pair (Mov, or width-64 int Cast). The single-def-src path mirrors
;; the original relation (no type restriction); the mutable-src path is the
;; M-C extension, GP-int scalars only.
(define (compiler-reg-sv-multi-pair!
  [ctx : CompilerRegSvMultiCtx]
  [svar : i64]
  [dst : i64]) : unit
  (let
    [counts : (Array i64) (struct-get ctx counts)]
    [phi-defs : (Array i64) (struct-get ctx phi-defs)]
    [eligible : (Array i64) (struct-get ctx eligible)]
    [int-ok : (Array i64) (struct-get ctx int-ok)]
    (if (and
      (compiler-reg-sv-single-def-non-phi? counts phi-defs dst)
      (compiler-reg-sv-eligible? eligible dst)
      (compiler-reg-sv-eligible? eligible svar))
      (if (compiler-reg-sv-single-def-non-phi? counts phi-defs svar)
        (compiler-reg-sv-multi-union! ctx svar dst)
        (if (and
          (compiler-reg-sv-int-ok? int-ok svar)
          (compiler-reg-sv-int-ok? int-ok dst))
          (compiler-reg-sv-multi-union! ctx svar dst)
          unit))
      unit)))

(define (compiler-reg-sv-multi-add-instr!
  [instr : CompilerIrInstr]
  [ctx : CompilerRegSvMultiCtx]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var svar) (compiler-reg-sv-multi-pair! ctx svar dst)]
        [_ unit])]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (match src
        [(CompilerIrValue.Var svar)
          (if (compiler-reg-cast-copy-64? from-ty to-ty)
            (compiler-reg-sv-multi-pair! ctx svar dst)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-sv-multi-seq!
  [instrs : CompilerIrInstrSeq]
  [ctx : CompilerRegSvMultiCtx]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-sv-multi-add-instr! (array-ref slots index) ctx)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-sv-multi-blocks!
  [blocks : CompilerIrBlockList]
  [ctx : CompilerRegSvMultiCtx]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-sv-multi-seq! instrs ctx)])
        (compiler-reg-sv-multi-blocks! (box-get rest) ctx))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-sv-multi-seq! instrs ctx)])
            (set! i (+ i 1)))))]))

;; Build the extended same-value relation (scalar-opt2 plan path only).
(define (compiler-reg-function-same-value-parents-multi
  [func : CompilerIrFunction]
  [eligible : (Array i64)]
  [type-info : CompilerRegVarTypes]
  [interval-index : CompilerRegIntervalIndex]) : (Array i64)
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [counts : (Array i64) (compiler-reg-function-def-counts func)]
        [phi-defs : (Array i64) (array.make-array i64 vars)]
        [parents : (Array i64) (array.make-array i64 vars)]
        [class-multi : (Array i64) (array.make-array i64 vars)]
        [int-ok : (Array i64) (array.make-array i64 vars)]
        [bucket : (Array i64) (array.make-array i64 vars)]
        [def-off : (Array i64) (array.make-array i64 (+ vars 1))]
        [index : i64 0]
        (begin
          (compiler-reg-mark-phi-defs-blocks! blocks phi-defs)
          (compiler-reg-count-block-defs! blocks bucket)
          (array-set! def-off 0 0)
          (while (< index vars)
            (begin
              (array-set!
                def-off
                (+ index 1)
                (+ (array-ref def-off index) (array-ref bucket index)))
              (set! index (+ index 1))))
          (set! index 0)
          (let
            [total : i64 (array-ref def-off vars)]
            [def-pts : (Array i64)
              (array.make-array
                i64
                (if (< total 1)
                  1
                  total))]
            [cursor : (Array i64) (array.make-array i64 vars)]
            (begin
              (while (< index vars)
                (begin
                  (array-set! parents index index)
                  (array-set! cursor index (array-ref def-off index))
                  (array-set!
                    class-multi
                    index
                    (if (compiler-reg-sv-single-def-non-phi?
                      counts
                      phi-defs
                      index)
                      (- 0 1)
                      index))
                  (array-set!
                    int-ok
                    index
                    (match (compiler-reg-var-types-lookup type-info index)
                      [(CompilerRegMaybeType.Some ty)
                        (if (and
                          (compiler-reg-scalar-type? ty)
                          (not (compiler-reg-float-type? ty)))
                          1
                          0)]
                      [(CompilerRegMaybeType.No) 0]))
                  (set! index (+ index 1))))
              (let
                [_fill : i64
                  (compiler-reg-sv-def-points-fill-blocks
                    blocks
                    0
                    cursor
                    def-pts)]
                (begin
                  (compiler-reg-sv-multi-blocks!
                    blocks
                    (CompilerRegSvMultiCtx
                      parents
                      counts
                      phi-defs
                      eligible
                      class-multi
                      def-off
                      def-pts
                      (struct-get interval-index starts)
                      (struct-get interval-index ends)
                      (struct-get interval-index segments)
                      int-ok))
                  parents))))))]))

(define (compiler-reg-same-value-class?
  [parents : (Array i64)]
  [left : i64]
  [right : i64]) : bool
  (if (= (array-length parents) 0)
    false
    (let
      [rl : i64 (compiler-reg-sv-find parents left)]
      [rr : i64 (compiler-reg-sv-find parents right)]
      (and (>= rl 0) (= rl rr)))))

(define (compiler-reg-coalesce-map-init!
  [parents : (Array i64)]
  [sizes : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length parents))
    unit
    (begin
      (array-set! parents index index)
      (array-set! sizes index 1)
      (compiler-reg-coalesce-map-init! parents sizes (+ index 1)))))

(define (compiler-reg-coalesce-map-root-from-parents
  [parents : (Array i64)]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length parents)))
    (- 0 1)
    (array-ref parents var)))

(define (compiler-reg-coalesce-vars-compatible?
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [left : i64]
  [right : i64]
  [strict : bool]
  [sv-parents : (Array i64)]) : bool
  (and
    (not (= left right))
    (not (compiler-live-set-contains? group-vars left))
    (not (compiler-live-set-contains? group-vars right))
    (compiler-reg-compatible-types? types left right)
    ;; #2 same-value relaxation: a proven same-value pair (single-def direct copy)
    ;; may coalesce despite overlap -- one register holds the shared value. The
    ;; geometry test itself is unchanged; this only ADDS the same-value escape.
    (or
      (not
        (if strict
          (compiler-reg-vars-interfere-index? intervals left right)
          (compiler-reg-vars-interfere-segmented-index? intervals left right)))
      (and
        (compiler-reg-same-value-overlap-eligible? types left right)
        (compiler-reg-same-value-class? sv-parents left right)))))

(define (compiler-reg-coalesce-map-var-compatible-with-root?
  [parents : (Array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [var : i64]
  [root : i64]
  [strict : bool]
  [index : i64]
  [sv-parents : (Array i64)]) : bool
  (cond
    [(>= index (array-length parents)) true]
    [(= (array-ref parents index) root)
      (if (compiler-reg-coalesce-vars-compatible?
        intervals
        types
        group-vars
        var
        index
        strict
        sv-parents)
        (compiler-reg-coalesce-map-var-compatible-with-root?
          parents
          intervals
          types
          group-vars
          var
          root
          strict
          (+ index 1)
          sv-parents)
        false)]
    [else
      (compiler-reg-coalesce-map-var-compatible-with-root?
        parents
        intervals
        types
        group-vars
        var
        root
        strict
        (+ index 1)
        sv-parents)]))

(define (compiler-reg-coalesce-map-classes-compatible-from?
  [parents : (Array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [left-root : i64]
  [right-root : i64]
  [strict : bool]
  [index : i64]
  [sv-parents : (Array i64)]) : bool
  (cond
    [(>= index (array-length parents)) true]
    [(= (array-ref parents index) left-root)
      (if (compiler-reg-coalesce-map-var-compatible-with-root?
        parents
        intervals
        types
        group-vars
        index
        right-root
        strict
        0
        sv-parents)
        (compiler-reg-coalesce-map-classes-compatible-from?
          parents
          intervals
          types
          group-vars
          left-root
          right-root
          strict
          (+ index 1)
          sv-parents)
        false)]
    [else
      (compiler-reg-coalesce-map-classes-compatible-from?
        parents
        intervals
        types
        group-vars
        left-root
        right-root
        strict
        (+ index 1)
        sv-parents)]))

(define (compiler-reg-coalesce-map-classes-compatible?
  [parents : (Array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [left-root : i64]
  [right-root : i64]
  [strict : bool]
  [sv-parents : (Array i64)]) : bool
  (compiler-reg-coalesce-map-classes-compatible-from?
    parents
    intervals
    types
    group-vars
    left-root
    right-root
    strict
    0
    sv-parents))

(define (compiler-reg-coalesce-map-merge-root-parents-into!
  [parents : (Array i64)]
  [winner : i64]
  [loser : i64]
  [index : i64]) : unit
  (if (>= index (array-length parents))
    unit
    (begin
      (if (= (array-ref parents index) loser)
        (array-set! parents index winner)
        unit)
      (compiler-reg-coalesce-map-merge-root-parents-into!
        parents
        winner
        loser
        (+ index 1)))))

;; Per-pair join (LLVM joinVirtRegs structure): maintain a per-root merged COARSE
;; interval [start,end] -- the union extent of the class members. Two roots with
;; DISJOINT coarse extents provably have no interfering member pair (each member's
;; segments lie within its coarse interval, which lies within the root extent), so
;; they join in O(1) without the O(n^2) all-pairs class scan. This is a sound
;; SUBSET of classes-compatible? (coarse-disjoint => segment-disjoint => every
;; cross pair non-interfering; the class is type-homogeneous and src/dst types are
;; already checked), so the coalescing RESULT is identical -- only the common
;; disjoint case takes the fast path. When extents overlap, the exact
;; classes-compatible? check still decides, preserving coalescing semantics
;; precisely.
(define (compiler-reg-coalesce-init-coarse!
  [root-start : (Array i64)]
  [root-end : (Array i64)]
  [src-start : (Array i64)]
  [src-end : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length root-start))
    unit
    (begin
      (array-set!
        root-start
        index
        (if (< index (array-length src-start))
          (array-ref src-start index)
          (- 0 1)))
      (array-set!
        root-end
        index
        (if (< index (array-length src-end))
          (array-ref src-end index)
          (- 0 1)))
      (compiler-reg-coalesce-init-coarse!
        root-start
        root-end
        src-start
        src-end
        (+ index 1)))))

(define (compiler-reg-coalesce-coarse-disjoint?
  [root-start : (Array i64)]
  [root-end : (Array i64)]
  [a : i64]
  [b : i64]) : bool
  (let
    [a-start : i64 (array-ref root-start a)]
    [a-end : i64 (array-ref root-end a)]
    [b-start : i64 (array-ref root-start b)]
    [b-end : i64 (array-ref root-end b)]
    (if (or (< a-start 0) (< a-end 0) (< b-start 0) (< b-end 0))
      false
      (or (<= a-end b-start) (<= b-end a-start)))))

(define (compiler-reg-coalesce-map-merge-root-into!
  [parents : (Array i64)]
  [sizes : (Array i64)]
  [root-start : (Array i64)]
  [root-end : (Array i64)]
  [winner : i64]
  [loser : i64]) : unit
  (begin
    (array-set!
      sizes
      winner
      (+ (array-ref sizes winner) (array-ref sizes loser)))
    (array-set! sizes loser 0)
    (let
      [loser-start : i64 (array-ref root-start loser)]
      [loser-end : i64 (array-ref root-end loser)]
      [winner-start : i64 (array-ref root-start winner)]
      [winner-end : i64 (array-ref root-end winner)]
      (begin
        (if (< winner-start 0)
          (array-set! root-start winner loser-start)
          (if (if (< loser-start 0)
            false
            (< loser-start winner-start))
            (array-set! root-start winner loser-start)
            unit))
        (if (> loser-end winner-end)
          (array-set! root-end winner loser-end)
          unit)))
    (compiler-reg-coalesce-map-merge-root-parents-into! parents winner loser 0)))

(define (compiler-reg-coalesce-map-try-merge!
  [parents : (Array i64)]
  [sizes : (Array i64)]
  [root-start : (Array i64)]
  [root-end : (Array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [left : i64]
  [right : i64]
  [strict : bool]
  [sv-parents : (Array i64)]) : bool
  (let
    [left-root : i64 (compiler-reg-coalesce-map-root-from-parents parents left)]
    [right-root : i64
      (compiler-reg-coalesce-map-root-from-parents parents right)]
    (cond
      [(or (< left-root 0) (< right-root 0) (= left-root right-root)) false]
      [(not
          (compiler-reg-coalesce-vars-compatible?
            intervals
            types
            group-vars
            left
            right
            strict
            sv-parents))
        false]
      [(or
          (and
            (= (array-ref sizes left-root) 1)
            (= (array-ref sizes right-root) 1))
          ;; per-pair join fast path: disjoint merged extents => trivially legal.
          (compiler-reg-coalesce-coarse-disjoint?
            root-start
            root-end
            left-root
            right-root)
          (compiler-reg-coalesce-map-classes-compatible?
            parents
            intervals
            types
            group-vars
            left-root
            right-root
            strict
            sv-parents))
        (let
          [winner : i64
            (if (< left-root right-root)
              left-root
              right-root)]
          [loser : i64
            (if (< left-root right-root)
              right-root
              left-root)]
          (begin
            (compiler-reg-coalesce-map-merge-root-into!
              parents
              sizes
              root-start
              root-end
              winner
              loser)
            true))]
      [else false])))

(define (compiler-reg-coalesce-map-merge-moves!
  [parents : (Array i64)]
  [sizes : (Array i64)]
  [root-start : (Array i64)]
  [root-end : (Array i64)]
  [moves : CompilerRegMoveSeq]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [changed : bool]
  [sv-parents : (Array i64)]) : bool
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [index : i64 (- (struct-get moves len) 1)]
    [out : bool changed]
    (begin
      (while (>= index 0)
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [did-merge : bool
              (compiler-reg-coalesce-map-try-merge!
                parents
                sizes
                root-start
                root-end
                intervals
                types
                group-vars
                (struct-get item src)
                (struct-get item dst)
                (struct-get item strict)
                sv-parents)]
            (set! out (or out did-merge)))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-coalesce-map-fixpoint!
  [parents : (Array i64)]
  [sizes : (Array i64)]
  [root-start : (Array i64)]
  [root-end : (Array i64)]
  [moves : CompilerRegMoveSeq]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [sv-parents : (Array i64)]) : unit
  (begin
    (compiler-reg-coalesce-map-merge-moves!
      parents
      sizes
      root-start
      root-end
      moves
      intervals
      types
      group-vars
      false
      sv-parents)
    unit))

(define (compiler-reg-coalesce-map-build
  [moves : CompilerRegMoveSeq]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [vars : i64]
  [sv-parents : (Array i64)]) : CompilerRegCoalesceMap
  (if (compiler-reg-move-list-empty? moves)
    (CompilerRegCoalesceMap (array.make-array i64 0))
    (let
      [n : i64
        (if (< vars 1)
          1
          vars)]
      [parents : (Array i64) (array.make-array i64 n)]
      [sizes : (Array i64) (array.make-array i64 n)]
      [root-start : (Array i64) (array.make-array i64 n)]
      [root-end : (Array i64) (array.make-array i64 n)]
      (begin
        (compiler-reg-coalesce-map-init! parents sizes 0)
        (compiler-reg-coalesce-init-coarse!
          root-start
          root-end
          (struct-get intervals starts)
          (struct-get intervals ends)
          0)
        (compiler-reg-coalesce-map-fixpoint!
          parents
          sizes
          root-start
          root-end
          moves
          intervals
          types
          group-vars
          sv-parents)
        (CompilerRegCoalesceMap parents)))))

(define (compiler-reg-coalesce-location-from-class-from
  [coalesce : CompilerRegCoalesceMap]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [root : i64]
  [index : i64]) : CompilerRegMaybeLocation
  (let
    [parents : (Array i64) (struct-get coalesce parents)]
    (cond
      [(>= index (array-length parents)) CompilerRegMaybeLocation.No]
      [(or (= index var) (not (= (array-ref parents index) root)))
        (compiler-reg-coalesce-location-from-class-from
          coalesce
          assignments
          intervals
          var
          root
          (+ index 1))]
      [else
        (match (compiler-reg-assignment-table-lookup assignments index)
          [(CompilerRegMaybeLocation.Some location)
            (if (compiler-reg-assignment-table-location-conflicts-segmented?
              assignments
              intervals
              var
              index
              location)
              (compiler-reg-coalesce-location-from-class-from
                coalesce
                assignments
                intervals
                var
                root
                (+ index 1))
              (CompilerRegMaybeLocation.Some location))]
          [(CompilerRegMaybeLocation.No)
            (compiler-reg-coalesce-location-from-class-from
              coalesce
              assignments
              intervals
              var
              root
              (+ index 1))])])))

(define (compiler-reg-coalesce-location
  [coalesce : CompilerRegCoalesceMap]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]) : CompilerRegMaybeLocation
  (let
    [parents : (Array i64) (struct-get coalesce parents)]
    [root : i64 (compiler-reg-coalesce-map-root-from-parents parents var)]
    (if (< root 0)
      CompilerRegMaybeLocation.No
      (compiler-reg-coalesce-location-from-class-from
        coalesce
        assignments
        intervals
        var
        root
        0))))

(define (compiler-reg-assignment-count
  [assignments : CompilerRegAssignmentList]) : i64
  (match assignments
    [(CompilerRegAssignmentList.Nil) 0]
    [(CompilerRegAssignmentList.Cons _ rest)
      (+ 1 (compiler-reg-assignment-count (box-get rest)))]))

(define (compiler-reg-spill-count [assignments : CompilerRegAssignmentList]) : i64
  (match assignments
    [(CompilerRegAssignmentList.Nil) 0]
    [(CompilerRegAssignmentList.Cons item rest)
      (match (struct-get item location)
        [(CompilerRegLocation.Spill _)
          (+ 1 (compiler-reg-spill-count (box-get rest)))]
        [_ (compiler-reg-spill-count (box-get rest))])]))

(define (compiler-reg-copy-hints-add-move!
  [hints : (Array i64)]
  [parents : (Array i64)]
  [src : i64]
  [dst : i64]) : unit
  (let
    [n : i64 (array-length hints)]
    [root-src : i64
      (if (if (>= src 0)
        (< src (array-length parents))
        false)
        (array-ref parents src)
        src)]
    [root-dst : i64
      (if (if (>= dst 0)
        (< dst (array-length parents))
        false)
        (array-ref parents dst)
        dst)]
    (if (or
      (= root-src root-dst)
      (< root-src 0)
      (>= root-src n)
      (< root-dst 0)
      (>= root-dst n))
      unit
      (begin
        (if (< (array-ref hints root-src) 0)
          (array-set! hints root-src root-dst)
          unit)
        (if (< (array-ref hints root-dst) 0)
          (array-set! hints root-dst root-src)
          unit)
        unit))))

(define (compiler-reg-copy-hints-from-moves!
  [hints : (Array i64)]
  [parents : (Array i64)]
  [moves : CompilerRegMoveSeq]) : unit
  (let
    [slots : (Array CompilerRegMove) (struct-get moves slots)]
    [index : i64 (- (struct-get moves len) 1)]
    (while (>= index 0)
      (begin
        (let
          [item : CompilerRegMove (array-ref slots index)]
          (compiler-reg-copy-hints-add-move!
            hints
            parents
            (struct-get item src)
            (struct-get item dst)))
        (set! index (- index 1))))))

;; Two-address binop dst<->operand coalesce hints (LLVM TwoAddressInstructionPass).
;; The backend lowers a two-address binop as `movq lhs,staging; op rhs,staging`,
;; so biasing dst onto lhs's register elides the `movq` when they coincide. div/mod
;; are rax:rdx-fixed (staging is not the dst) -> skipped. Commutative ops also hint
;; dst<->rhs so the allocator can coalesce whichever operand lands free. Pure
;; tie-break: copy-hints-add-move! is first-wins and the greedy consumes it free-
;; only (never forces a spill/evict).
(define (compiler-reg-binop-two-address? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Div) false]
    [(CompilerIrBinOp.Mod) false]
    [(CompilerIrBinOp.SafeDiv) false]
    [(CompilerIrBinOp.SafeMod) false]
    [_ true]))

(define (compiler-reg-binop-commutative? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Add) true]
    [(CompilerIrBinOp.Mul) true]
    [(CompilerIrBinOp.And) true]
    [(CompilerIrBinOp.Or) true]
    [(CompilerIrBinOp.BitAnd) true]
    [(CompilerIrBinOp.BitOr) true]
    [(CompilerIrBinOp.BitXor) true]
    [_ false]))

(define (compiler-reg-copy-hints-from-binops-instr!
  [instr : CompilerIrInstr]
  [hints : (Array i64)]
  [parents : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.BinOp dst op lhs rhs _)
      (if (compiler-reg-binop-two-address? op)
        (begin
          (match lhs
            [(CompilerIrValue.Var lhs-var)
              (compiler-reg-copy-hints-add-move! hints parents lhs-var dst)]
            [_ unit])
          (if (compiler-reg-binop-commutative? op)
            (match rhs
              [(CompilerIrValue.Var rhs-var)
                (compiler-reg-copy-hints-add-move! hints parents rhs-var dst)]
              [_ unit])
            unit))
        unit)]
    [_ unit]))

(define (compiler-reg-copy-hints-from-binops-seq!
  [instrs : CompilerIrInstrSeq]
  [hints : (Array i64)]
  [parents : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-copy-hints-from-binops-instr!
            (array-ref slots index)
            hints
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-copy-hints-from-binops-blocks!
  [blocks : CompilerIrBlockList]
  [hints : (Array i64)]
  [parents : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-copy-hints-from-binops-seq! instrs hints parents)])
        (compiler-reg-copy-hints-from-binops-blocks!
          (box-get rest)
          hints
          parents))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-copy-hints-from-binops-seq! instrs hints parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-copy-hints-from-binops!
  [func : CompilerIrFunction]
  [hints : (Array i64)]
  [parents : (Array i64)]) : unit
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-copy-hints-from-binops-blocks! blocks hints parents)]))

;; Build per-root copy hints from the move list + two-address binops, mapping each
;; endpoint to its coalesce root. Moves are added first (first-wins), then binops
;; fill the rest, biasing each binop dst toward an operand's register.
(define (compiler-reg-function-copy-hints
  [moves : CompilerRegMoveSeq]
  [coalesce : CompilerRegCoalesceMap]
  [n : i64]
  [func : CompilerIrFunction]) : (Array i64)
  (let
    [hints : (Array i64) (array.make-array i64 n)]
    [parents : (Array i64) (struct-get coalesce parents)]
    (begin
      (compiler-reg-fill-i64-array hints -1)
      (compiler-reg-copy-hints-from-moves! hints parents moves)
      (compiler-reg-copy-hints-from-binops! func hints parents)
      hints)))

(define (compiler-reg-fixed-preferred-register
  [assignments : CompilerRegAssignmentTable]
  [active : CompilerRegActiveSeq]
  [regs : CompilerRegIdList]
  [preferences : (Array i64)]
  [interval-index : CompilerRegIntervalIndex]
  [var : i64]
  [start : i64]) : CompilerRegMaybeId
  (if (or (< var 0) (>= var (array-length preferences)))
    (CompilerRegMaybeId.No)
    (let
      [preferred : i64 (array-ref preferences var)]
      [ends : (Array i64) (struct-get interval-index ends)]
      (if (or
        (< preferred 0)
        (>= preferred (array-length ends))
        (> (array-ref ends preferred) start))
        (CompilerRegMaybeId.No)
        (match (compiler-reg-assignment-table-lookup assignments preferred)
          [(CompilerRegMaybeLocation.Some location)
            (match location
              [(CompilerRegLocation.Register reg)
                (if (or
                  (not (compiler-reg-id-list-contains-physical? regs reg))
                  (compiler-reg-active-register-conflicts?
                    active
                    reg
                    interval-index
                    var
                    (compiler-live-set-empty)))
                  (CompilerRegMaybeId.No)
                  (CompilerRegMaybeId.Some reg))]
              [_ (CompilerRegMaybeId.No)])]
          [(CompilerRegMaybeLocation.No) (CompilerRegMaybeId.No)])))))

(define (compiler-reg-id-list-contains-physical?
  [regs : CompilerRegIdList]
  [reg : i64]) : bool
  (match regs
    [(CompilerRegIdList.Nil) false]
    [(CompilerRegIdList.Cons candidate rest)
      (if (compiler-reg-registers-overlap? candidate reg)
        true
        (compiler-reg-id-list-contains-physical? (box-get rest) reg))]))

(define (compiler-reg-assignment-table-physical-active-from
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [regs : CompilerRegIdList]
  [index : i64]
  [active : CompilerRegActiveSeq]) : CompilerRegActiveSeq
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    (if (>= index (array-length present))
      active
      (let
        [next : CompilerRegActiveSeq
          (if (= (array-ref present index) 0)
            active
            (match (array-ref items index)
              [(CompilerRegLocation.Register reg)
                (if (compiler-reg-id-list-contains-physical? regs reg)
                  (match (compiler-reg-interval-index-lookup
                    interval-index
                    index)
                    [(CompilerRegMaybeInterval.Some interval)
                      (compiler-reg-active-insert
                        active
                        (CompilerRegActive index (struct-get interval end) reg))]
                    [(CompilerRegMaybeInterval.No) active])
                  active)]
              [_ active]))]
        (compiler-reg-assignment-table-physical-active-from
          assignments
          interval-index
          regs
          (+ index 1)
          next)))))

;; Fixed-candidate allocation follows scalar allocation. Seed its active set
;; once with every already-assigned owner of the candidate physical bank; the
;; normal segment-aware interference query then prevents a future scalar
;; %xmm6 and an overlapping %vec6 from being accepted as independent homes.
;; This keeps candidate selection O(assignments + candidates * pool) rather
;; than rescanning the full scalar table for every register choice.
(define (compiler-reg-first-free-fixed-register
  [regs : CompilerRegIdList]
  [active : CompilerRegActiveSeq]
  [interval-index : CompilerRegIntervalIndex]
  [var : i64]) : CompilerRegMaybeId
  (match regs
    [(CompilerRegIdList.Nil) (CompilerRegMaybeId.No)]
    [(CompilerRegIdList.Cons reg rest)
      (if (compiler-reg-active-register-conflicts?
        active
        reg
        interval-index
        var
        (compiler-live-set-empty))
        (compiler-reg-first-free-fixed-register
          (box-get rest)
          active
          interval-index
          var)
        (CompilerRegMaybeId.Some reg))]))

(define (compiler-reg-assign-fixed-candidates-from
  [candidates : CompilerRegIntervalSeq]
  [index : i64]
  [regs : CompilerRegIdList]
  [active : CompilerRegActiveSeq]
  [assignments : CompilerRegAssignmentTable]
  [preferences : (Array i64)]
  [interval-index : CompilerRegIntervalIndex]) : CompilerRegAssignState
  (if (>= index (compiler-reg-interval-seq-count candidates))
    (CompilerRegAssignState.State active assignments)
    (let
      [interval : CompilerRegInterval
        (compiler-reg-interval-seq-ref candidates index)]
      [var : i64 (struct-get interval var)]
      [start : i64 (struct-get interval start)]
      [end : i64 (struct-get interval end)]
      [expired : CompilerRegActiveSeq (compiler-reg-expire-active active start)]
      [preferred : CompilerRegMaybeId
        (compiler-reg-fixed-preferred-register
          assignments
          expired
          regs
          preferences
          interval-index
          var
          start)]
      (match preferred
        [(CompilerRegMaybeId.Some reg)
          (compiler-reg-assign-fixed-candidates-from
            candidates
            (+ index 1)
            regs
            (compiler-reg-active-insert expired (CompilerRegActive var end reg))
            (compiler-reg-assignment-table-insert
              assignments
              var
              (CompilerRegLocation.Register reg))
            preferences
            interval-index)]
        [(CompilerRegMaybeId.No)
          (match (compiler-reg-first-free-fixed-register
            regs
            expired
            interval-index
            var)
            [(CompilerRegMaybeId.No)
              (compiler-reg-assign-fixed-candidates-from
                candidates
                (+ index 1)
                regs
                expired
                assignments
                preferences
                interval-index)]
            [(CompilerRegMaybeId.Some reg)
              (compiler-reg-assign-fixed-candidates-from
                candidates
                (+ index 1)
                regs
                (compiler-reg-active-insert
                  expired
                  (CompilerRegActive var end reg))
                (compiler-reg-assignment-table-insert
                  assignments
                  var
                  (CompilerRegLocation.Register reg))
                preferences
                interval-index)])]))))

(define (compiler-reg-assign-fixed-candidates
  [candidates : CompilerRegIntervalSeq]
  [regs : CompilerRegIdList]
  [active : CompilerRegActiveSeq]
  [assignments : CompilerRegAssignmentTable]
  [preferences : (Array i64)]
  [interval-index : CompilerRegIntervalIndex]) : CompilerRegAssignState
  (compiler-reg-assign-fixed-candidates-from
    candidates
    0
    regs
    (compiler-reg-assignment-table-physical-active-from
      assignments
      interval-index
      regs
      0
      active)
    assignments
    preferences
    interval-index))

;; Call points (#perf/correctness): the primary integer pool admits only
;; callee-saved registers, so a value live across a call keeps its home safely.
;; The scalar caller-saved extension consults a stricter backend clobber set.
;; XMM/float/vector pools apply the same point set as an ABI register-mask
;; constraint: volatile homes are unavailable across these points, while an ABI
;; nonvolatile suffix remains legal.
(defenum CompilerRegCallScan
  (Scan i64 CompilerLiveI64Set))

(define (compiler-reg-call-points-seq
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [set : CompilerLiveI64Set]) : CompilerRegCallScan
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [p : i64 point]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(CompilerIrInstr.Call _ _ _ _) (compiler-live-set-insert out p)]
              [(CompilerIrInstr.CallIndirect _ _ _ _)
                (compiler-live-set-insert out p)]
              [(CompilerIrInstr.CallIndirectC _ _ _ _)
                (compiler-live-set-insert out p)]
              [(CompilerIrInstr.CallCAbiStoreResult payload-box)
                (compiler-live-set-insert out p)]
              [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (compiler-live-set-insert out p)]
              [(CompilerIrInstr.SpmdCall payload-box)
                (compiler-live-set-insert out p)]
              [(CompilerIrInstr.TailCall _ _ _)
                (compiler-live-set-insert out p)]
              [(CompilerIrInstr.TailCallIndirect _ _ _)
                (compiler-live-set-insert out p)]
              [_ out]))
          (set! p (+ p 2))
          (set! index (+ index 1))))
      (CompilerRegCallScan.Scan p out))))

(define (compiler-reg-call-points-blocks
  [blocks : CompilerIrBlockList]
  [point : i64]
  [set : CompilerLiveI64Set]) : CompilerRegCallScan
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerRegCallScan.Scan point set)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-call-points-seq instrs point set)
            [(CompilerRegCallScan.Scan p2 s2)
              (compiler-reg-call-points-blocks (box-get rest) p2 s2)])])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        [out-set : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-call-points-seq instrs out-point out-set)
                    [(CompilerRegCallScan.Scan p2 s2)
                      (begin
                        (set! out-point p2)
                        (set! out-set s2))])])
              (set! i (+ i 1))))
          (CompilerRegCallScan.Scan out-point out-set)))]))

(define (compiler-reg-call-points [func : CompilerIrFunction]) : CompilerLiveI64Set
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler-reg-call-points-blocks
        blocks
        0
        (compiler-live-set-empty))
        [(CompilerRegCallScan.Scan _ set) set])]))

(define (compiler-reg-backend-clobber-binop? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Div) true]
    [(CompilerIrBinOp.Mod) true]
    [(CompilerIrBinOp.SafeDiv) true]
    [(CompilerIrBinOp.SafeMod) true]
    [(CompilerIrBinOp.Shl) true]
    [(CompilerIrBinOp.Shr) true]
    [_ false]))

(define (compiler-reg-backend-caller-clobber-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Call _ _ _ _) true]
    [(CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(CompilerIrInstr.CallCAbiStoreResult _) true]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(CompilerIrInstr.SpmdCall _) true]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(CompilerIrInstr.Syscall _ _) true]
    [(CompilerIrInstr.BoundsCheck _ _ _) true]
    [(CompilerIrInstr.CpuId _ _ _ _) true]
    [(CompilerIrInstr.Xgetbv _ _) true]
    [(CompilerIrInstr.Pack _ _ _) true]
    [(CompilerIrInstr.BinOp _ op _ _ _)
      (compiler-reg-backend-clobber-binop? op)]
    [_ false]))

;; Clobber-POINT predicate for the register-search restriction + same-value
;; coalescing exclusion. Identical to caller-clobber-instr? EXCEPT bounds checks
;; are NOT clobber points: a bounds check's only register-clobbering effect is the
;; cold `call tl_oob_abort` on the never-taken failure branch, and that abort is
;; NORETURN -- on the success (fall-through) path NO caller-saved register is
;; clobbered. So a value live across a bounds check is never actually clobbered;
;; treating it as call-spanning wrongly bans it from all 9 caller-saved regs
;; (start-idx = caller-saved-count) AND excludes its loop-carried phi from
;; coalescing (2x slot inflation), forcing array-loop values to spill where clang
;; keeps them in registers. caller-clobber-instr? stays true for bounds checks so
;; remat-use-site-ok? remains conservative (the bounds-check cmp's scavenged
;; scratch could clobber a single-instruction remat home).
;;
;; IrInstrPack is ALSO not a clobber point. A Pack
;; (the 16-byte register-resident aggregate build for Maybe/Pair/tuple) never
;; clobbers a caller-saved register holding another live value:
;; compiler-backend-emit-pack-words takes a pure register-move fast path into the
;; Pack's OWN group-home registers (compiler-backend-emit-pack-words-direct-
;; registers -- only dst0/dst1, which the allocator gave the Pack's result, never
;; a live-across value's home), and for memory words it loads through a SCAVENGED
;; scratch (compiler-backend-scavenge-reg-here / -xmm-reg, default %r8/%r9/%xmm2/
;; %xmm3) chosen via the interval-aware occupied-mask -- scavenge-candidate-ok?
;; rejects any register free-bit not clear in the occupancy mask, so it can never
;; pick a register homing a live value, and even the default fallback is emergency
;; push/pop-wrapped when occupied. So a value live across a Pack is never actually
;; clobbered; treating it as call-spanning wrongly bans it from all 9 caller-saved
;; regs and excludes its loop-carried phi from same-value coalescing (forcing
;; spills/static reloads where the value could stay register-resident). The emit-
;; time scavenge freeness self-check is the soundness net. caller-clobber-instr?
;; stays true for Pack (remat conservatism), same split as bounds checks.
(define (compiler-reg-backend-clobber-point-instr?
  [_type-segment-bases : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BoundsCheck _ _ _) false]
    [(CompilerIrInstr.Pack _ _ _) false]
    ;; GAP3a: a shift by an in-range CONSTANT count is emitted as `shlq $imm, reg`
    ;; (compiler-backend-binop-immediate-shift-asm) and never reads or writes
    ;; %rcx/%cl, so it is NOT a clobber point. Only variable-count shifts (or
    ;; out-of-range constants, which fall back to the %cl register path) remain
    ;; clobber points -- the same rhs/type-aware classification the greedy's
    ;; kind-2 point set already uses (compiler-reg-clobber-binop-shift?). Before
    ;; this arm the coarse op-only test (compiler-reg-backend-clobber-binop? via
    ;; caller-clobber-instr?) counted EVERY shift, so the param ABI-pin gate
    ;; (compiler-reg-param-assign-plan) stack-homed or CSR-copied all params of
    ;; zero-call functions whose only "clobbers" were constant shifts
    ;; (crc_update shape). Divisions keep their rax:rdx clobber classification.
    ;; compiler-reg-backend-caller-clobber-instr? intentionally stays
    ;; conservative (remat-use-site-ok? / splitkit range proofs).
    [(CompilerIrInstr.BinOp _ op _ rhs ty)
      (or
        (compiler-reg-clobber-binop-div? op)
        (compiler-reg-clobber-binop-shift? op rhs ty))]
    [_ (compiler-reg-backend-caller-clobber-instr? instr)]))

(define (compiler-reg-backend-win64-extra-clobber-instr?
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [(CompilerIrInstr.AddrOf _ _) true]
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [(CompilerIrInstr.Load _ _ _) true]
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [(CompilerIrInstr.Cast _ _ _ _) true]
    [(CompilerIrInstr.Bitcast _ _ _ _) true]
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(CompilerIrInstr.UnOp _ _ _ _) true]
    [(CompilerIrInstr.LaneId _ _ _) true]
    [(CompilerIrInstr.Splat _ _ _ _) true]
    [(CompilerIrInstr.VectorBinOp _) true]
    [(CompilerIrInstr.VectorPrefix _) true]
    [(CompilerIrInstr.VectorReduce _ _ _ _ _) true]
    [(CompilerIrInstr.VectorCompare _) true]
    [(CompilerIrInstr.MaskBinOp _ _ _ _ _) true]
    [(CompilerIrInstr.MaskNot _ _ _) true]
    [(CompilerIrInstr.MaskReduce _ _ _ _) true]
    [(CompilerIrInstr.Select _) true]
    [(CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    [(CompilerIrInstr.VectorStore _) true]
    [(CompilerIrInstr.PredicatedStore _) true]
    [(CompilerIrInstr.PredicatedLoad _) true]
    [(CompilerIrInstr.GatherLoad _) true]
    [(CompilerIrInstr.VectorShuffle _) true]
    [(CompilerIrInstr.TailMask _ _ _ _) true]
    [(CompilerIrInstr.EntryArgc _) true]
    [(CompilerIrInstr.EntryArgv _) true]
    [(CompilerIrInstr.EntryEnvp _) true]
    [(CompilerIrInstr.Store _ _ _) true]
    [(CompilerIrInstr.Branch _ _ _) true]
    [(CompilerIrInstr.Return _) true]
    [(CompilerIrInstr.Pack _ _ _) true]
    [(CompilerIrInstr.Word _ _ _ _) true]
    [(CompilerIrInstr.Switch _ _ _ _) true]
    [_ false]))

(define (compiler-reg-backend-caller-clobber-instr-for-abi?
  [abi : CompilerRegTargetAbi]
  [instr : CompilerIrInstr]) : bool
  (match abi
    [(CompilerRegTargetAbi.Linux)
      (compiler-reg-backend-caller-clobber-instr? instr)]
    [(CompilerRegTargetAbi.Windows)
      (or
        (compiler-reg-backend-caller-clobber-instr? instr)
        (compiler-reg-backend-win64-extra-clobber-instr? instr))]))

;; Per-register clobber model (15c). The merged caller-clobber set above is too
;; coarse for the greedy: it treats a div/shift exactly like a call (all
;; caller-saved unavailable across it). But idiv clobbers only rax:rdx, and a variable shift only rcx, so a value CAN cross a
;; div in %r9/%rcx and a shift in %r9/%rdx. These per-kind point sets let the
;; greedy forbid only the registers an op actually clobbers.
;;   kind 0 = call-like (all caller-saved)   kind 1 = idiv
;;   kind 2 = shift                          kind 4 = loop-split rdx use
(define (compiler-reg-clobber-binop-div? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Div) true]
    [(CompilerIrBinOp.Mod) true]
    [(CompilerIrBinOp.SafeDiv) true]
    [(CompilerIrBinOp.SafeMod) true]
    [_ false]))

(define (compiler-reg-clobber-binop-rdx? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Mul) true]
    [_ (compiler-reg-clobber-binop-div? op)]))

;; A shift binop clobbers %rcx ONLY when its count is emitted through the %cl
;; register path. The backend emits a CONSTANT, in-range count as an immediate
;; `shlq $imm, reg` (compiler-backend-binop-immediate-shift-asm) that never reads
;; or writes %rcx/%cl; a VARIABLE count -- or a constant the immediate path
;; rejects as out-of-range (count<0 or count>=type-width) -- is instead moved
;; into %rcx and shifted by %cl (compiler-backend-binop-shift-asm). So a value
;; live across a constant in-range shift is NEVER actually clobbered in %rcx;
;; the old op-only test treated every shift as an %rcx clobber point and
;; needlessly banned such values from %rcx (compiler-reg-greedy-forbidden-regs
;; via spans-shift). This rhs/type-aware test mirrors the backend's own
;; emission predicate compiler-backend-binop-valid-immediate-shift?; the shift
;; width is replicated locally (integer byte-size * 8) because regalloc must not
;; depend on the backend (cf. compiler-abi-gp-arg-register). scavcheck
;; SELFCHECK_CLEAN is the soundness net: a misclassified count that actually uses
;; %cl would surface as a %rcx clobber of a live value.
(define (compiler-reg-clobber-shift-width [ty : AstType]) : i64
  (match ty
    [(AstType.I64) 64]
    [(AstType.U64) 64]
    [(AstType.I32) 32]
    [(AstType.U32) 32]
    [(AstType.I16) 16]
    [(AstType.U16) 16]
    [(AstType.I8) 8]
    [(AstType.U8) 8]
    [_ 0]))

;; True when rhs is a constant shift count the backend emits as an immediate
;; `$imm` (no %rcx use). Mirrors compiler-backend-immediate-operand restricted to
;; an integer constant + compiler-backend-shift-count-valid? (0 <= count <
;; width). Any other rhs (a variable, or an out-of-range constant) is left to the
;; %cl register path, so it stays a clobber point (conservative).
(define (compiler-reg-shift-const-in-range?
  [rhs : CompilerIrValue]
  [ty : AstType]) : bool
  (match rhs
    [(CompilerIrValue.I64 n)
      (and (>= n 0) (< n (compiler-reg-clobber-shift-width ty)))]
    [_ false]))

(define (compiler-reg-clobber-binop-shift?
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [ty : AstType]) : bool
  (match op
    [(CompilerIrBinOp.Shl) (not (compiler-reg-shift-const-in-range? rhs ty))]
    [(CompilerIrBinOp.Shr) (not (compiler-reg-shift-const-in-range? rhs ty))]
    [_ false]))

(define (compiler-reg-clobber-instr-kind?
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [kind : i64]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op _ rhs ty)
      (cond
        [(= kind 1) (compiler-reg-clobber-binop-div? op)]
        [(= kind 2) (compiler-reg-clobber-binop-shift? op rhs ty)]
        [(= kind 4) (compiler-reg-clobber-binop-rdx? op)]
        [else false])]
    ;; kind 3 = switch dispatch points (GAP3c pin gate only; never kind 0 --
    ;; a switch clobbers no register per se, but its DISPATCH emitter's
    ;; emergency scavenge wraps a save/restore around the indirect jmp whose
    ;; restore lands AFTER the jmp = unreachable (the GAP2b vm_run finding),
    ;; so occupancy added at a dispatch by an ABI pin must be refused until
    ;; that emitter is fixed).
    [(CompilerIrInstr.Switch _ _ _ _) (= kind 3)]
    [_
      (cond
        [(= kind 0)
          (compiler-reg-backend-clobber-point-instr? type-segment-bases instr)]
        ;; kind 5 = vector lowering that may still use XMM0/XMM1 family
        ;; spellings internally. The scalar allocator treats only those two
        ;; physical homes as clobbered; the vector pool remains XMM2+.
        [(= kind 5)
          (match instr
            [(CompilerIrInstr.VectorBinOp _) true]
            [(CompilerIrInstr.VectorCompare _) true]
            [(CompilerIrInstr.MaskNot _ _ _) true]
            [(CompilerIrInstr.Select _) true]
            [(CompilerIrInstr.PredicatedLoad _) true]
            [(CompilerIrInstr.VectorShuffle _) true]
            [(CompilerIrInstr.TailMask _ _ _ _) true]
            [_ false])]
        [else false])]))

(define (compiler-reg-clobber-kind-points-seq
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [set : CompilerLiveI64Set]
  [kind : i64]) : CompilerRegCallScan
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [p : i64 point]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (if (compiler-reg-clobber-instr-kind?
            type-segment-bases
            (array-ref slots index)
            kind)
            (set! out (compiler-live-set-insert out p))
            unit)
          (set! p (+ p 2))
          (set! index (+ index 1))))
      (CompilerRegCallScan.Scan p out))))

(define (compiler-reg-clobber-kind-points-blocks
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [point : i64]
  [set : CompilerLiveI64Set]
  [kind : i64]) : CompilerRegCallScan
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerRegCallScan.Scan point set)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-clobber-kind-points-seq
            type-segment-bases
            instrs
            point
            set
            kind)
            [(CompilerRegCallScan.Scan p2 s2)
              (compiler-reg-clobber-kind-points-blocks
                type-segment-bases
                (box-get rest)
                p2
                s2
                kind)])])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        [out-set : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-clobber-kind-points-seq
                    type-segment-bases
                    instrs
                    out-point
                    out-set
                    kind)
                    [(CompilerRegCallScan.Scan p2 s2)
                      (begin
                        (set! out-point p2)
                        (set! out-set s2))])])
              (set! i (+ i 1))))
          (CompilerRegCallScan.Scan out-point out-set)))]))

(define (compiler-reg-clobber-kind-points
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [kind : i64]) : CompilerLiveI64Set
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler-reg-clobber-kind-points-blocks
        type-segment-bases
        blocks
        0
        (compiler-live-set-empty)
        kind)
        [(CompilerRegCallScan.Scan _ set) set])]))

;; "Does any set bit of `bits` land strictly inside (start, end) once offset by
;; `var-base`?" The bit positions satisfying `start < var-base + i < end` form a
;; contiguous run, so the whole question is one mask test instead of a walk over
;; the set bits.
;;
;; The mask is clamped to positions 0..31 because `compiler-reg-low-bit-index32`
;; only ever reported indices in that range: it masks its argument to
;; `0xffffffff` and answers 31 when the low word is empty. A word carrying bits
;; above position 31 therefore tested index 31 in the original loop, which is
;; reproduced here by folding that case into bit 31 of the effective word rather
;; than assuming callers never pass one.
(define (compiler-reg-call-word-range-mask [low-bit : i64] [high-bit : i64]) : i64
  (shl (- (shl 1 (+ (- high-bit low-bit) 1)) 1) low-bit))

(define (compiler-reg-call-word-in-range?
  [bits : i64]
  [var-base : i64]
  [start : i64]
  [end : i64]) : bool
  (let
    [low : i64 (bit-and bits 0xffffffff)]
    [effective : i64
      (if (= bits low)
        low
        (bit-or low 0x80000000))]
    (if (= effective 0)
      false
      (let
        [lo : i64 (- (+ start 1) var-base)]
        [hi : i64 (- (- end 1) var-base)]
        [low-bit : i64
          (if (< lo 0)
            0
            lo)]
        [high-bit : i64
          (if (> hi 31)
            31
            hi)]
        (if (> low-bit high-bit)
          false
          (not
            (=
              (bit-and
                effective
                (compiler-reg-call-word-range-mask low-bit high-bit))
              0)))))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-word-count-in-range
    [bits : i64]
    [var-base : i64]
    [start : i64]
    [end : i64]) : i64
    (if (= bits 0)
      0
      (let
        [i : i64 (compiler-reg-low-bit-index32 bits)]
        [c : i64 (+ var-base i)]
        [rest : i64
          (compiler-reg-call-word-count-in-range
            (bit-and bits (- bits 1))
            var-base
            start
            end)]
        (if (if (< start c)
          (< c end)
          false)
          (+ 1 rest)
          rest)))))

(define (compiler-reg-call-set-in-range-words?
  [set : CompilerLiveI64Set]
  [start : i64]
  [end : i64]
  [word-index : i64]
  [last-word : i64]) : bool
  (if (> word-index last-word)
    false
    (if (compiler-reg-call-word-in-range?
      (compiler-live-set-word-at-bounded set word-index)
      (* word-index (compiler-live-set-word-bits))
      start
      end)
      true
      (compiler-reg-call-set-in-range-words?
        set
        start
        end
        (+ word-index 1)
        last-word))))

;; Only the words holding positions inside `(start, end)` can answer yes, so the
;; scan starts and stops at those words instead of walking the whole set. Word
;; `w` holds global positions `w * word-bits .. w * word-bits + word-bits - 1`,
;; and the positions of interest are `start + 1 .. end - 1`, which gives the
;; bounds directly. Words outside that span contain no position the predicate
;; could accept, so skipping them cannot change the answer.
(define (compiler-reg-call-set-in-range?
  [set : CompilerLiveI64Set]
  [start : i64]
  [end : i64]) : bool
  (let
    [bits : i64 (compiler-live-set-word-bits)]
    [last-pos : i64 (- end 1)]
    [first-pos : i64
      (if (< (+ start 1) 0)
        0
        (+ start 1))]
    (if (> first-pos last-pos)
      false
      (let
        [count : i64 (compiler-live-set-word-count set)]
        [first-word : i64 (/ first-pos bits)]
        [raw-last-word : i64 (/ last-pos bits)]
        [last-word : i64
          (if (>= raw-last-word count)
            (- count 1)
            raw-last-word)]
        (if (> first-word last-word)
          false
          (compiler-reg-call-set-in-range-words?
            set
            start
            end
            first-word
            last-word))))))

(define (compiler-reg-direct-call-points-seq
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [set : CompilerLiveI64Set]) : CompilerRegCallScan
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [p : i64 point]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(CompilerIrInstr.Call _ _ _ _) (compiler-live-set-insert out p)]
              [(CompilerIrInstr.SpmdCall payload-box)
                (compiler-live-set-insert out p)]
              [_ out]))
          (set! p (+ p 2))
          (set! index (+ index 1))))
      (CompilerRegCallScan.Scan p out))))

(define (compiler-reg-direct-call-points-blocks
  [blocks : CompilerIrBlockList]
  [point : i64]
  [set : CompilerLiveI64Set]) : CompilerRegCallScan
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerRegCallScan.Scan point set)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-direct-call-points-seq instrs point set)
            [(CompilerRegCallScan.Scan p2 s2)
              (compiler-reg-direct-call-points-blocks (box-get rest) p2 s2)])])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        [out-set : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-direct-call-points-seq
                    instrs
                    out-point
                    out-set)
                    [(CompilerRegCallScan.Scan p2 s2)
                      (begin
                        (set! out-point p2)
                        (set! out-set s2))])])
              (set! i (+ i 1))))
          (CompilerRegCallScan.Scan out-point out-set)))]))

(define (compiler-reg-direct-call-points [func : CompilerIrFunction]) : CompilerLiveI64Set
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler-reg-direct-call-points-blocks
        blocks
        0
        (compiler-live-set-empty))
        [(CompilerRegCallScan.Scan _ set) set])]))

(define (compiler-reg-loop-depth-max) : i64
  8)

(define (compiler-reg-loop-depth-weight [depth : i64]) : i64
  (cond
    [(<= depth 0) 1]
    [(= depth 1) 2]
    [(= depth 2) 4]
    [(= depth 3) 8]
    [else 16]))

(define (compiler-reg-loop-depth-block-ids
  [blocks : CompilerIrBlockList]
  [ids : reg_label_i64_map.Map]
  [index : i64]) : reg_label_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) ids]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (begin
            (reg_label_i64_map.insert-ref! (&mut ids) label index)
            (compiler-reg-loop-depth-block-ids (box-get rest) ids (+ index 1)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-loop-depth-block-ids-seq seq ids index)]))

(define (compiler-reg-loop-depth-block-ids-seq
  [seq : CompilerIrBlockSeq]
  [ids : reg_label_i64_map.Map]
  [index : i64]) : reg_label_i64_map.Map
  (let
    [count : i64 (compiler-ir-block-seq-count seq)]
    [i : i64 index]
    [out : reg_label_i64_map.Map ids]
    (begin
      (while (< i count)
        (match (compiler-ir-block-seq-ref seq i)
          [(CompilerIrBlock.Block label _)
            (reg_label_i64_map.insert-ref! (&mut out) label i)])
        (set! i (+ i 1)))
      out)))

(define (compiler-reg-loop-depth-record-succ!
  [loop-ends : (Array i64)]
  [ids : reg_label_i64_map.Map]
  [source-id : i64]
  [label : i64]) : unit
  (match (reg_label_i64_map.get (& ids) label)
    [(reg_label_i64_map.LookupFound target-id)
      (if (and (>= target-id 0) (<= target-id source-id))
        (if (> source-id (array-ref loop-ends target-id))
          (array-set! loop-ends target-id source-id)
          unit)
        unit)]
    [(reg_label_i64_map.LookupMissing) unit]))

(define (compiler-reg-loop-depth-record-succs!
  [loop-ends : (Array i64)]
  [ids : reg_label_i64_map.Map]
  [source-id : i64]
  [succs : CompilerLiveLabelSet]) : unit
  (match succs
    [(CompilerLiveLabelSet.Nil) unit]
    [(CompilerLiveLabelSet.Dense _ _)
      (begin
        (compiler-reg-loop-depth-record-succ!
          loop-ends
          ids
          source-id
          (compiler-live-label-set-ref succs 0))
        (compiler-reg-loop-depth-record-succs!
          loop-ends
          ids
          source-id
          (compiler-live-label-set-tail succs)))]))

(define (compiler-reg-loop-depth-record-blocks!
  [blocks : CompilerIrBlockList]
  [ids : reg_label_i64_map.Map]
  [loop-ends : (Array i64)]
  [index : i64]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (compiler-reg-loop-depth-record-succs!
          loop-ends
          ids
          index
          (compiler-live-block-successors block))
        (compiler-reg-loop-depth-record-blocks!
          (box-get rest)
          ids
          loop-ends
          (+ index 1)))]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-loop-depth-record-blocks-seq! seq ids loop-ends index)]))

(define (compiler-reg-loop-depth-record-blocks-seq!
  [seq : CompilerIrBlockSeq]
  [ids : reg_label_i64_map.Map]
  [loop-ends : (Array i64)]
  [index : i64]) : unit
  (let
    [count : i64 (compiler-ir-block-seq-count seq)]
    [i : i64 index]
    (while (< i count)
      (begin
        (compiler-reg-loop-depth-record-succs!
          loop-ends
          ids
          i
          (compiler-live-block-successors (compiler-ir-block-seq-ref seq i)))
        (set! i (+ i 1))))))

(define (compiler-reg-loop-depth-bump-range!
  [depths : (Array i64)]
  [index : i64]
  [end : i64]) : unit
  (if (or (>= index (array-length depths)) (> index end))
    unit
    (begin
      (if (< (array-ref depths index) (compiler-reg-loop-depth-max))
        (array-set! depths index (+ (array-ref depths index) 1))
        unit)
      (compiler-reg-loop-depth-bump-range! depths (+ index 1) end))))

(define (compiler-reg-loop-depths-from-ends!
  [loop-ends : (Array i64)]
  [depths : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length loop-ends))
    unit
    (begin
      (if (>= (array-ref loop-ends index) index)
        (compiler-reg-loop-depth-bump-range!
          depths
          index
          (array-ref loop-ends index))
        unit)
      (compiler-reg-loop-depths-from-ends! loop-ends depths (+ index 1)))))

(define (compiler-reg-function-loop-depths [blocks : CompilerIrBlockList]) : (Array
    i64)
  (let
    [count : i64 (compiler-ir-block-list-count blocks)]
    [depths : (Array i64) (array.make-array i64 count)]
    [loop-ends : (Array i64) (array.make-array i64 count)]
    [ids : reg_label_i64_map.Map
      (compiler-reg-loop-depth-block-ids
        blocks
        (reg_label_i64_map.with-capacity (compiler-reg-bits-map-capacity count))
        0)]
    (begin
      (compiler-reg-fill-i64-array loop-ends (- 0 1))
      (compiler-reg-loop-depth-record-blocks! blocks ids loop-ends 0)
      (compiler-reg-loop-depths-from-ends! loop-ends depths 0)
      depths)))

(define (compiler-reg-ref-counts-add-word-weighted!
  [counts : (Array i64)]
  [bits : i64]
  [var-base : i64]
  [weight : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [i : i64 (compiler-reg-low-bit-index32 bits)]
      [var : i64 (+ var-base i)]
      (begin
        (if (and (>= var 0) (< var (array-length counts)))
          (array-set! counts var (+ (array-ref counts var) weight))
          unit)
        (compiler-reg-ref-counts-add-word-weighted!
          counts
          (bit-and bits (- bits 1))
          var-base
          weight)))))

(define (compiler-reg-ref-counts-add-word!
  [counts : (Array i64)]
  [bits : i64]
  [var-base : i64]) : unit
  (compiler-reg-ref-counts-add-word-weighted! counts bits var-base 1))

(define (compiler-reg-ref-counts-add-set-words!
  [counts : (Array i64)]
  [set : CompilerLiveI64Set]
  [word-index : i64]) : unit
  (if (>= word-index (compiler-live-set-word-count set))
    unit
    (begin
      (compiler-reg-ref-counts-add-word!
        counts
        (compiler-live-set-word-at-bounded set word-index)
        (* word-index (compiler-live-set-word-bits)))
      (compiler-reg-ref-counts-add-set-words! counts set (+ word-index 1)))))

(define (compiler-reg-ref-counts-add-set!
  [counts : (Array i64)]
  [set : CompilerLiveI64Set]) : unit
  (compiler-reg-ref-counts-add-set-words! counts set 0))

(define (compiler-reg-ref-counts-add-set-words-weighted!
  [counts : (Array i64)]
  [set : CompilerLiveI64Set]
  [word-index : i64]
  [weight : i64]) : unit
  (if (>= word-index (compiler-live-set-word-count set))
    unit
    (begin
      ;; `compiler-reg-ref-counts-add-word-weighted!` returns immediately for an
      ;; empty word, so testing here skips the call for the common case in a
      ;; sparse live set without changing what happens.
      (let
        [bits : i64 (compiler-live-set-word-at-bounded set word-index)]
        (if (= bits 0)
          unit
          (compiler-reg-ref-counts-add-word-weighted!
            counts
            bits
            (* word-index (compiler-live-set-word-bits))
            weight)))
      (compiler-reg-ref-counts-add-set-words-weighted!
        counts
        set
        (+ word-index 1)
        weight))))

(define (compiler-reg-ref-counts-add-set-weighted!
  [counts : (Array i64)]
  [set : CompilerLiveI64Set]
  [weight : i64]) : unit
  (compiler-reg-ref-counts-add-set-words-weighted! counts set 0 weight))

(define (compiler-reg-ref-counts-add-instr!
  [counts : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (begin
    (compiler-reg-ref-counts-add-set! counts (compiler-live-instr-uses instr))
    (compiler-reg-ref-counts-add-set! counts (compiler-live-instr-defs instr))))

(define (compiler-reg-ref-counts-add-instr-weighted!
  [counts : (Array i64)]
  [instr : CompilerIrInstr]
  [weight : i64]) : unit
  (begin
    (compiler-reg-ref-counts-add-set-weighted!
      counts
      (compiler-live-instr-uses instr)
      weight)
    (compiler-reg-ref-counts-add-set-weighted!
      counts
      (compiler-live-instr-defs instr)
      weight)))

(define (compiler-reg-ref-counts-seq!
  [counts : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-ref-counts-add-instr! counts (array-ref slots index))
        (set! index (+ index 1))))))

(define (compiler-reg-ref-counts-seq-weighted!
  [counts : (Array i64)]
  [instrs : CompilerIrInstrSeq]
  [weight : i64]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-ref-counts-add-instr-weighted!
          counts
          (array-ref slots index)
          weight)
        (set! index (+ index 1))))))

(define (compiler-reg-ref-counts-blocks!
  [counts : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-counts-seq! counts instrs)])
        (compiler-reg-ref-counts-blocks! counts (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-counts-seq! counts instrs)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-ref-counts-blocks-weighted!
  [counts : (Array i64)]
  [blocks : CompilerIrBlockList]
  [depths : (Array i64)]
  [block-index : i64]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-counts-seq-weighted!
              counts
              instrs
              (compiler-reg-loop-depth-weight (array-ref depths block-index)))])
        (compiler-reg-ref-counts-blocks-weighted!
          counts
          (box-get rest)
          depths
          (+ block-index 1)))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [index : i64 block-index]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-counts-seq-weighted!
                  counts
                  instrs
                  (compiler-reg-loop-depth-weight (array-ref depths index)))])
            (set! index (+ index 1))
            (set! i (+ i 1)))))]))

(define (compiler-reg-remat-value? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [(CompilerIrValue.F64 _) true]
    [(CompilerIrValue.GlobalAddr _) true]
    [_ false]))

(define (compiler-reg-remat-mov-value?
  [value : CompilerIrValue]
  [allow-invariant-loads : bool]) : bool
  (match value
    [(CompilerIrValue.Global _) allow-invariant-loads]
    [_ (compiler-reg-remat-value? value)]))

(define (compiler-reg-remat-gep?
  [base : CompilerIrValue]
  [offset : CompilerIrValue]) : bool
  (match base
    [(CompilerIrValue.GlobalAddr _)
      (match offset
        [(CompilerIrValue.I64 _) true]
        [_ false])]
    [_ false]))

(define (compiler-reg-remat-load?
  [src : CompilerIrValue]
  [allow-invariant-loads : bool]) : bool
  (if allow-invariant-loads
    (match src
      [(CompilerIrValue.GlobalAddr _) true]
      [_ false])
    false))

(define (compiler-reg-remat-discount-weight [weight : i64]) : i64
  (/ weight 2))

;; A value the backend can RECOMPUTE in one instruction at each use: a static
;; address materialisation (`leaq label(%rip)`). Plain integer/bool/char constants
;; are deliberately EXCLUDED: the optimiser's constant propagation already inlines
;; them directly into their uses (so an optimised function never carries a constant
;; in a spillable vreg), making constant remat moot on real code; addresses cannot
;; always be folded into an instruction's immediate, so they are the case that
;; genuinely benefits. CompilerIrValue.Global (a LOAD of a mutable global) and CompilerIrValue.F64
;; (no scalar backend support) must never be rematerialised.
(define (compiler-reg-remat-recompute-value? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.GlobalAddr _) true]
    [(CompilerIrValue.Function _) true]
    [(CompilerIrValue.String _) true]
    [(CompilerIrValue.Bytes _) true]
    [_ false]))

(define (compiler-reg-remat-init-vals!
  [vals : (Array CompilerIrValue)]
  [vars : i64]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (array-set! vals i (CompilerIrValue.Unit))
        (set! i (+ i 1))))))

;; Record var -> rematerialisable value for every var whose SOLE definition is a
;; Mov of a recomputable value.
(define (compiler-reg-collect-remat-seq!
  [instrs : CompilerIrInstrSeq]
  [def-counts : (Array i64)]
  [flags : (Array i64)]
  [vals : (Array CompilerIrValue)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (match (array-ref slots index)
          [(CompilerIrInstr.Mov dst value _)
            ;; flags[dst]: 0 = not remat, 1 = remat, 2 = poisoned (address-taken,
            ;; must keep a real slot). A poisoned var never becomes remat.
            (if (if (if (compiler-reg-remat-recompute-value? value)
              (compiler-reg-sv-single-def? def-counts dst)
              false)
              (if (>= dst 0)
                (if (< dst (array-length flags))
                  (not (= (array-ref flags dst) 2))
                  false)
                false)
              false)
              (begin
                (array-set! flags dst 1)
                (array-set! vals dst value)
                unit)
              unit)]
          ;; Taking a var's address needs its real storage; poison it so it is
          ;; never rematerialised (its slot must hold the value).
          [(CompilerIrInstr.AddrOf _ src)
            (if (if (>= src 0)
              (< src (array-length flags))
              false)
              (begin
                (array-set! flags src 2)
                unit)
              unit)]
          [_ unit])
        (set! index (+ index 1))))))

(define (compiler-reg-collect-remat-blocks!
  [blocks : CompilerIrBlockList]
  [def-counts : (Array i64)]
  [flags : (Array i64)]
  [vals : (Array CompilerIrValue)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-collect-remat-seq! instrs def-counts flags vals)])
        (compiler-reg-collect-remat-blocks!
          (box-get rest)
          def-counts
          flags
          vals))]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-collect-remat-seq-from! seq 0 def-counts flags vals)]))

(define (compiler-reg-collect-remat-seq-from!
  [blocks : CompilerIrBlockSeq]
  [index : i64]
  [def-counts : (Array i64)]
  [flags : (Array i64)]
  [vals : (Array CompilerIrValue)]) : unit
  (if (>= index (compiler-ir-block-seq-count blocks))
    unit
    (begin
      (match (compiler-ir-block-seq-ref blocks index)
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-collect-remat-seq! instrs def-counts flags vals)])
      (compiler-reg-collect-remat-seq-from!
        blocks
        (+ index 1)
        def-counts
        flags
        vals))))

;; Post-allocation rewrite: a singleton (non-coalesced) rematerialisable var that
;; the allocator chose to SPILL is converted to CompilerRegLocation.Remat instead -- its
;; uses recompute the value and its def store is dropped (backend). Coalesced
;; members are excluded so a class never half-remats. The already-reserved spill
;; slot is simply left unused.
(define (compiler-reg-rewrite-remat-assignments
  [assignments : CompilerRegAssignmentTable]
  [func : CompilerIrFunction]
  [coalesce : CompilerRegCoalesceMap]
  [shadows : CompilerLiveI64Set]
  [vars : i64]) : CompilerRegAssignmentTable
  (let
    [def-counts : (Array i64) (compiler-reg-function-def-counts func)]
    [parents : (Array i64) (struct-get coalesce parents)]
    [merged-roots : CompilerLiveI64Set
      (compiler-reg-coalesce-merged-root-set coalesce)]
    [flags : (Array i64) (array.make-array i64 vars)]
    [vals : (Array CompilerIrValue) (array.make-array CompilerIrValue vars)]
    [v : i64 0]
    (begin
      (compiler-reg-remat-init-vals! vals vars)
      (match func
        [(CompilerIrFunction.Function _ _ _ _ blocks)
          (match blocks
            [(CompilerIrBlockList.Array seq)
              (compiler-reg-collect-remat-seq-from! seq 0 def-counts flags vals)]
            [_
              (compiler-reg-collect-remat-blocks! blocks def-counts flags vals)])])
      (while (< v vars)
        (begin
          ;; Skip vars the call-spanning saver shadows: those keep a real slot to
          ;; restore from around calls, so they must not lose it to remat.
          (if (if (< v (array-length flags))
            (if (= (array-ref flags v) 1)
              (if (compiler-live-set-contains? shadows v)
                false
                (not
                  (compiler-reg-coalesce-var-nonsingleton?
                    parents
                    merged-roots
                    v)))
              false)
            false)
            (match (compiler-reg-assignment-table-lookup assignments v)
              [(CompilerRegMaybeLocation.Some loc)
                (match loc
                  [(CompilerRegLocation.Spill _)
                    (begin
                      (compiler-reg-assignment-table-insert
                        assignments
                        v
                        (CompilerRegLocation.Remat (array-ref vals v)))
                      unit)]
                  [_ unit])]
              [(CompilerRegMaybeLocation.No) unit])
            unit)
          (set! v (+ v 1))))
      assignments)))

(define (compiler-reg-coalesce-var-nonsingleton?
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length parents)))
    false
    (let
      [root : i64 (array-ref parents var)]
      [mapped : i64
        (if (and (>= root 0) (< root (array-length parents)))
          root
          var)]
      (compiler-live-set-contains? merged-roots mapped))))

(define (compiler-reg-remat-discount-single-def-spill-weights!
  [weights : (Array i64)]
  [def-status : (Array i64)]
  [coalesce : CompilerRegCoalesceMap]) : unit
  (let
    [parents : (Array i64) (struct-get coalesce parents)]
    [merged-roots : CompilerLiveI64Set
      (compiler-reg-coalesce-merged-root-set coalesce)]
    [var : i64 0]
    (while (< var (array-length weights))
      (begin
        (let
          [status : i64
            (if (< var (array-length def-status))
              (array-ref def-status var)
              0)]
          (if (and
            (= (bit-and status 1) 1)
            (= (/ status 2) 1)
            (not
              (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)))
            (array-set!
              weights
              var
              (compiler-reg-remat-discount-weight (array-ref weights var)))
            unit))
        (set! var (+ var 1))))))

(define (compiler-reg-remat-instr-mutates-memory? [instr : CompilerIrInstr]) : bool
  (match (compiler-ir-instr-effect instr)
    [(CompilerIrEffect.MemoryWrite) true]
    [(CompilerIrEffect.Unknown) true]
    [_ false]))

(define (compiler-reg-remat-instrs-mutates-memory?
  [instrs : CompilerIrInstrSeq]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (set!
            found
            (compiler-reg-remat-instr-mutates-memory? (array-ref slots index)))
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-remat-blocks-mutates-memory?
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (or
            (compiler-reg-remat-instrs-mutates-memory? instrs)
            (compiler-reg-remat-blocks-mutates-memory? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [found : bool false]
        (begin
          (while (and (< i count) (not found))
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    found
                    (compiler-reg-remat-instrs-mutates-memory? instrs))])
              (set! i (+ i 1))))
          found))]))

(define (compiler-reg-remat-invariant-loads-ok? [func : CompilerIrFunction]) : bool
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (not (compiler-reg-remat-blocks-mutates-memory? blocks))]))

(define (compiler-reg-remat-status-candidate-add-instr!
  [def-status : (Array i64)]
  [instr : CompilerIrInstr]
  [allow-invariant-loads : bool]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst value _)
      (if (and
        (compiler-reg-remat-mov-value? value allow-invariant-loads)
        (>= dst 0)
        (< dst (array-length def-status)))
        (array-set! def-status dst (bit-or (array-ref def-status dst) 1))
        unit)]
    [(CompilerIrInstr.Gep dst base offset _)
      (if (and
        (compiler-reg-remat-gep? base offset)
        (>= dst 0)
        (< dst (array-length def-status)))
        (array-set! def-status dst (bit-or (array-ref def-status dst) 1))
        unit)]
    [(CompilerIrInstr.Load dst src _)
      (if (and
        (compiler-reg-remat-load? src allow-invariant-loads)
        (>= dst 0)
        (< dst (array-length def-status)))
        (array-set! def-status dst (bit-or (array-ref def-status dst) 1))
        unit)]
    [_ unit]))

(define (compiler-reg-ref-counts-add-instr-weighted-remat!
  [counts : (Array i64)]
  [def-status : (Array i64)]
  [instr : CompilerIrInstr]
  [weight : i64]
  [allow-invariant-loads : bool]) : unit
  (let
    [uses : CompilerLiveI64Set (compiler-live-instr-uses instr)]
    [defs : CompilerLiveI64Set (compiler-live-instr-defs instr)]
    (begin
      (compiler-reg-ref-counts-add-set-weighted! counts uses weight)
      (compiler-reg-ref-counts-add-set-weighted! counts defs weight)
      (compiler-reg-ref-counts-add-set-weighted! def-status defs 2)
      (compiler-reg-remat-status-candidate-add-instr!
        def-status
        instr
        allow-invariant-loads))))

(define (compiler-reg-ref-counts-seq-weighted-remat!
  [counts : (Array i64)]
  [def-status : (Array i64)]
  [instrs : CompilerIrInstrSeq]
  [weight : i64]
  [allow-invariant-loads : bool]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-ref-counts-add-instr-weighted-remat!
            counts
            def-status
            (array-ref slots index)
            weight
            allow-invariant-loads)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-ref-counts-blocks-weighted-remat!
  [counts : (Array i64)]
  [def-status : (Array i64)]
  [blocks : CompilerIrBlockList]
  [depths : (Array i64)]
  [block-index : i64]
  [allow-invariant-loads : bool]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-counts-seq-weighted-remat!
              counts
              def-status
              instrs
              (compiler-reg-loop-depth-weight (array-ref depths block-index))
              allow-invariant-loads)])
        (compiler-reg-ref-counts-blocks-weighted-remat!
          counts
          def-status
          (box-get rest)
          depths
          (+ block-index 1)
          allow-invariant-loads))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [index : i64 block-index]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-counts-seq-weighted-remat!
                  counts
                  def-status
                  instrs
                  (compiler-reg-loop-depth-weight (array-ref depths index))
                  allow-invariant-loads)])
            (set! index (+ index 1))
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-spill-weights [func : CompilerIrFunction]) : (Array
    i64)
  (match func
    [(CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [counts : (Array i64) (array.make-array i64 vars)]
        [depths : (Array i64) (compiler-reg-function-loop-depths blocks)]
        (begin
          (compiler-reg-ref-counts-blocks-weighted! counts blocks depths 0)
          counts))]))

(define (compiler-reg-function-spill-weights-combined
  [func : CompilerIrFunction]
  [coalesce : CompilerRegCoalesceMap]
  [vars : i64]) : (Array i64)
  (match func
    [(CompilerIrFunction.Function _ _ _ fn-vars blocks)
      (let
        [raw : (Array i64) (array.make-array i64 fn-vars)]
        [def-status : (Array i64) (array.make-array i64 fn-vars)]
        [depths : (Array i64) (compiler-reg-function-loop-depths blocks)]
        [allow-invariant-loads : bool
          (compiler-reg-remat-invariant-loads-ok? func)]
        (begin
          (compiler-reg-ref-counts-blocks-weighted-remat!
            raw
            def-status
            blocks
            depths
            0
            allow-invariant-loads)
          (let
            [discounted : (Array i64) (array.make-array i64 fn-vars)]
            (begin
              (compiler-reg-copy-i64-array! discounted raw 0)
              (compiler-reg-remat-discount-single-def-spill-weights!
                discounted
                def-status
                coalesce)
              (compiler-reg-greedy-combine-spill-weights
                (compiler-reg-merge-ref-counts coalesce discounted vars)
                (compiler-reg-merge-ref-counts coalesce raw vars))))))]))

(define (compiler-reg-interval-index-var-has-segments?
  [index : CompilerRegIntervalIndex]
  [var : i64]) : bool
  (let
    [segments : (Array CompilerRegIntervalSeq) (struct-get index segments)]
    (and
      (>= var 0)
      (< var (array-length segments))
      (not (compiler-reg-interval-seq-empty? (array-ref segments var))))))

(define (compiler-reg-edge-copy-list-count [copies : CompilerRegEdgeCopySeq]) : i64
  (struct-get copies len))

(define (compiler-reg-region-label-map-from
  [labels : CompilerRegLabelList]
  [out : reg_label_i64_map.Map]) : reg_label_i64_map.Map
  (match labels
    [(CompilerRegLabelList.Nil) out]
    [(CompilerRegLabelList.Cons label rest)
      (begin
        (reg_label_i64_map.insert-ref! (&mut out) label 1)
        (compiler-reg-region-label-map-from (box-get rest) out))]))

(define (compiler-reg-region-label-map [labels : CompilerRegLabelList]) : reg_label_i64_map.Map
  (compiler-reg-region-label-map-from
    labels
    (reg_label_i64_map.with-capacity
      (compiler-reg-bits-map-capacity (compiler-reg-label-list-count labels)))))

(define (compiler-reg-label-list-contains?
  [labels : CompilerRegLabelList]
  [want : i64]) : bool
  (match labels
    [(CompilerRegLabelList.Nil) false]
    [(CompilerRegLabelList.Cons head rest)
      (if (= head want)
        true
        (compiler-reg-label-list-contains? (box-get rest) want))]))

(define (compiler-reg-label-list-count [labels : CompilerRegLabelList]) : i64
  (match labels
    [(CompilerRegLabelList.Nil) 0]
    [(CompilerRegLabelList.Cons _ rest)
      (+ 1 (compiler-reg-label-list-count (box-get rest)))]))

(define (compiler-reg-region-label?
  [region : reg_label_i64_map.Map]
  [label : i64]) : bool
  (match (reg_label_i64_map.get (& region) label)
    [(reg_label_i64_map.LookupFound _) true]
    [(reg_label_i64_map.LookupMissing) false]))

(define (compiler-reg-edge-copy-live-block-label [block : CompilerLiveBlock]) : i64
  (struct-get block label))

(define (compiler-reg-edge-copy-increment-pred!
  [liveness : CompilerFunctionLiveness]
  [pred-counts : (Array i64)]
  [label : i64]) : unit
  (let
    [index : i64 (compiler-live-function-block-index liveness label)]
    (if (>= index 0)
      (array-set! pred-counts index (+ (array-ref pred-counts index) 1))
      unit)))

(define (compiler-reg-edge-copy-count-preds-succs!
  [liveness : CompilerFunctionLiveness]
  [pred-counts : (Array i64)]
  [succs : CompilerLiveLabelSet]) : unit
  (match succs
    [(CompilerLiveLabelSet.Nil) unit]
    [(CompilerLiveLabelSet.Dense _ _)
      (begin
        (compiler-reg-edge-copy-increment-pred!
          liveness
          pred-counts
          (compiler-live-label-set-ref succs 0))
        (compiler-reg-edge-copy-count-preds-succs!
          liveness
          pred-counts
          (compiler-live-label-set-tail succs)))]))

(define (compiler-reg-edge-copy-count-preds-blocks!
  [liveness : CompilerFunctionLiveness]
  [blocks : (Array CompilerLiveBlock)]
  [pred-counts : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length blocks))
    unit
    (begin
      (compiler-reg-edge-copy-count-preds-succs!
        liveness
        pred-counts
        (compiler-reg-live-block-succs (array-ref blocks index)))
      (compiler-reg-edge-copy-count-preds-blocks!
        liveness
        blocks
        pred-counts
        (+ index 1)))))

(define (compiler-reg-edge-copy-pred-counts
  [liveness : CompilerFunctionLiveness]
  [blocks : (Array CompilerLiveBlock)]) : (Array i64)
  (let
    [pred-counts : (Array i64) (array.make-array i64 (array-length blocks))]
    (begin
      (compiler-reg-edge-copy-count-preds-blocks! liveness blocks pred-counts 0)
      pred-counts)))

(define (compiler-reg-edge-copy-refusal [from-label : i64] [to-label : i64]) : String
  (string.concat5
    "regalloc: edge copy from "
    (compiler-ir-label-text from-label)
    " to "
    (compiler-ir-label-text to-label)
    " needs critical-edge splitting"))

(define (compiler-reg-edge-copy-placement-for
  [from-label : i64]
  [to-label : i64]
  [from-succs : i64]
  [to-preds : i64]) : CompilerRegEdgeCopyPlacementResult
  (cond
    [(= from-succs 1)
      (CompilerRegEdgeCopyPlacementResult.Ok
        CompilerRegEdgeCopyPlacement.PredEnd)]
    [(= to-preds 1)
      (CompilerRegEdgeCopyPlacementResult.Ok
        CompilerRegEdgeCopyPlacement.SuccEntry)]
    [else
      (CompilerRegEdgeCopyPlacementResult.Refused
        (compiler-reg-edge-copy-refusal from-label to-label))]))

(define (compiler-reg-edge-copy-live-on-edge?
  [from-block : CompilerLiveBlock]
  [to-block : CompilerLiveBlock]
  [var : i64]) : bool
  (and
    (compiler-live-set-contains? (compiler-live-block-live-out from-block) var)
    (compiler-live-set-contains? (compiler-live-block-live-in to-block) var)))

;; Group-aware variant for the SplitKit phi-carried homing: the coalesce group
;; (which shares one spill slot) is live across the edge iff SOME member is live
;; out of `from` AND SOME member is live in to `to`. Different members are live on
;; different boundary edges (the preheader edge carries the phi's INIT input, the
;; exit edge carries the back-edge/result member), but they share the slot the
;; INTO/OUT copies load/store, so any-member liveness is the correct test.
(define (compiler-reg-edge-copy-group-live-on-edge?
  [from-block : CompilerLiveBlock]
  [to-block : CompilerLiveBlock]
  [members : CompilerLiveI64Set]) : bool
  (and
    (compiler-live-set-intersects?
      (compiler-live-block-live-out from-block)
      members)
    (compiler-live-set-intersects?
      (compiler-live-block-live-in to-block)
      members)))

(define (compiler-reg-edge-copy-boundary-one
  [liveness : CompilerFunctionLiveness]
  [blocks : (Array CompilerLiveBlock)]
  [pred-counts : (Array i64)]
  [region : reg_label_i64_map.Map]
  [from-block : CompilerLiveBlock]
  [from-label : i64]
  [from-inside : bool]
  [from-succs : i64]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]
  [members : CompilerLiveI64Set]
  [to-label : i64]
  [acc : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyPlan
  (let
    [to-index : i64 (compiler-live-function-block-index liveness to-label)]
    (if (>= to-index 0)
      (let
        [to-block : CompilerLiveBlock (array-ref blocks to-index)]
        [to-inside : bool (compiler-reg-region-label? region to-label)]
        (if (or
          (= from-inside to-inside)
          (not
            ;; An empty `members` set selects the existing per-var liveness test
            ;; (read-only / non-phi homing -- byte-identical). A non-empty set is
            ;; the phi-carried coalesce group: the slot is live on the edge iff ANY
            ;; member is (no single member is live on every boundary edge).
            (if (= (compiler-live-set-word-count members) 0)
              (compiler-reg-edge-copy-live-on-edge?
                from-block
                to-block
                stack-var)
              (compiler-reg-edge-copy-group-live-on-edge?
                from-block
                to-block
                members))))
          (CompilerRegEdgeCopyPlan.Plan acc)
          (match (compiler-reg-edge-copy-placement-for
            from-label
            to-label
            from-succs
            (array-ref pred-counts to-index))
            [(CompilerRegEdgeCopyPlacementResult.Ok placement)
              (if to-inside
                (CompilerRegEdgeCopyPlan.Plan
                  (compiler-reg-edge-copy-seq-push
                    acc
                    (CompilerRegEdgeCopy.Copy
                      from-label
                      to-label
                      stack-var
                      region-var
                      ty
                      CompilerRegEdgeCopyDirection.IntoRegion
                      placement)))
                (CompilerRegEdgeCopyPlan.Plan
                  (compiler-reg-edge-copy-seq-push
                    acc
                    (CompilerRegEdgeCopy.Copy
                      from-label
                      to-label
                      region-var
                      stack-var
                      ty
                      CompilerRegEdgeCopyDirection.OutOfRegion
                      placement))))]
            [(CompilerRegEdgeCopyPlacementResult.Refused message)
              (CompilerRegEdgeCopyPlan.Refused message)])))
      (CompilerRegEdgeCopyPlan.Refused
        (string.concat3
          "regalloc: edge copy target block not found: "
          (compiler-ir-label-text to-label)
          "")))))

(define (compiler-reg-edge-copy-boundary-succs
  [liveness : CompilerFunctionLiveness]
  [blocks : (Array CompilerLiveBlock)]
  [pred-counts : (Array i64)]
  [region : reg_label_i64_map.Map]
  [from-block : CompilerLiveBlock]
  [from-label : i64]
  [from-inside : bool]
  [from-succs : i64]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]
  [members : CompilerLiveI64Set]
  [succs : CompilerLiveLabelSet]
  [acc : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyPlan
  (match succs
    [(CompilerLiveLabelSet.Nil) (CompilerRegEdgeCopyPlan.Plan acc)]
    [(CompilerLiveLabelSet.Dense _ _)
      (match (compiler-reg-edge-copy-boundary-one
        liveness
        blocks
        pred-counts
        region
        from-block
        from-label
        from-inside
        from-succs
        stack-var
        region-var
        ty
        members
        (compiler-live-label-set-ref succs 0)
        acc)
        [(CompilerRegEdgeCopyPlan.Plan next)
          (compiler-reg-edge-copy-boundary-succs
            liveness
            blocks
            pred-counts
            region
            from-block
            from-label
            from-inside
            from-succs
            stack-var
            region-var
            ty
            members
            (compiler-live-label-set-tail succs)
            next)]
        [(CompilerRegEdgeCopyPlan.Refused message)
          (CompilerRegEdgeCopyPlan.Refused message)])]))

(define (compiler-reg-edge-copy-boundary-blocks
  [liveness : CompilerFunctionLiveness]
  [blocks : (Array CompilerLiveBlock)]
  [pred-counts : (Array i64)]
  [region : reg_label_i64_map.Map]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]
  [members : CompilerLiveI64Set]
  [index : i64]
  [acc : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyPlan
  (if (>= index (array-length blocks))
    (CompilerRegEdgeCopyPlan.Plan acc)
    (let
      [block : CompilerLiveBlock (array-ref blocks index)]
      [label : i64 (compiler-reg-edge-copy-live-block-label block)]
      [succs : CompilerLiveLabelSet (compiler-reg-live-block-succs block)]
      (match (compiler-reg-edge-copy-boundary-succs
        liveness
        blocks
        pred-counts
        region
        block
        label
        (compiler-reg-region-label? region label)
        (compiler-live-label-set-count succs)
        stack-var
        region-var
        ty
        members
        succs
        acc)
        [(CompilerRegEdgeCopyPlan.Plan next)
          (compiler-reg-edge-copy-boundary-blocks
            liveness
            blocks
            pred-counts
            region
            stack-var
            region-var
            ty
            members
            (+ index 1)
            next)]
        [(CompilerRegEdgeCopyPlan.Refused message)
          (CompilerRegEdgeCopyPlan.Refused message)]))))

(define (compiler-reg-edge-copy-plan-for-region-group-with-liveness
  [liveness : CompilerFunctionLiveness]
  [region-labels : CompilerRegLabelList]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]
  [members : CompilerLiveI64Set]) : CompilerRegEdgeCopyPlan
  (compiler-reg-edge-copy-plan-for-region-members-with-liveness
    liveness
    region-labels
    stack-var
    region-var
    ty
    members))

(define (compiler-reg-edge-copy-plan-for-region-with-liveness
  [liveness : CompilerFunctionLiveness]
  [region-labels : CompilerRegLabelList]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]) : CompilerRegEdgeCopyPlan
  (compiler-reg-edge-copy-plan-for-region-members-with-liveness
    liveness
    region-labels
    stack-var
    region-var
    ty
    (compiler-live-set-empty)))

(define (compiler-reg-edge-copy-plan-for-region-members
  [func : CompilerIrFunction]
  [region-labels : CompilerRegLabelList]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]
  [members : CompilerLiveI64Set]) : CompilerRegEdgeCopyPlan
  (compiler-reg-edge-copy-plan-for-region-members-with-liveness
    (compiler-live-analyze-function func)
    region-labels
    stack-var
    region-var
    ty
    members))

(define (compiler-reg-edge-copy-plan-for-region-members-with-liveness
  [liveness : CompilerFunctionLiveness]
  [region-labels : CompilerRegLabelList]
  [stack-var : i64]
  [region-var : i64]
  [ty : AstType]
  [members : CompilerLiveI64Set]) : CompilerRegEdgeCopyPlan
  (match liveness
    [(CompilerFunctionLiveness.Liveness _ blocks)
      (let
        [pred-counts : (Array i64)
          (compiler-reg-edge-copy-pred-counts liveness blocks)]
        (compiler-reg-edge-copy-boundary-blocks
          liveness
          blocks
          pred-counts
          (compiler-reg-region-label-map region-labels)
          stack-var
          region-var
          ty
          members
          0
          (compiler-reg-edge-copy-seq-empty)))]))

(define (compiler-reg-edge-copy-instr [copy : CompilerRegEdgeCopy]) : CompilerIrInstr
  (match copy
    [(CompilerRegEdgeCopy.Copy _ _ src dst ty _ _)
      (CompilerIrInstr.Mov dst (CompilerIrValue.Var src) ty)]))

(define (compiler-reg-edge-copy-target-label [copy : CompilerRegEdgeCopy]) : i64
  (match copy
    [(CompilerRegEdgeCopy.Copy from-label to-label _ _ _ _ placement)
      (match placement
        [(CompilerRegEdgeCopyPlacement.PredEnd) from-label]
        [(CompilerRegEdgeCopyPlacement.SuccEntry) to-label])]))

(define (compiler-reg-edge-copy-placement [copy : CompilerRegEdgeCopy]) : CompilerRegEdgeCopyPlacement
  (match copy
    [(CompilerRegEdgeCopy.Copy _ _ _ _ _ _ placement) placement]))

(define (compiler-reg-edge-copy-insert-before-last
  [instrs : CompilerIrInstrList]
  [copy-instr : CompilerIrInstr]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil)
      (compiler-ir-instr-cons copy-instr CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match (box-get rest)
        [(CompilerIrInstrList.Nil)
          (compiler-ir-instr-cons
            copy-instr
            (compiler-ir-instr-cons instr CompilerIrInstrList.Nil))]
        [_
          (compiler-ir-instr-cons
            instr
            (compiler-reg-edge-copy-insert-before-last
              (box-get rest)
              copy-instr))])]))

(define (compiler-reg-edge-copy-insert-after-phis
  [instrs : CompilerIrInstrList]
  [copy-instr : CompilerIrInstr]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil)
      (compiler-ir-instr-cons copy-instr CompilerIrInstrList.Nil)]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.Phi _ _ _)
          (compiler-ir-instr-cons
            instr
            (compiler-reg-edge-copy-insert-after-phis (box-get rest) copy-instr))]
        [_ (compiler-ir-instr-cons copy-instr instrs)])]))

(define (compiler-reg-edge-copy-insert-in-block
  [block : CompilerIrBlock]
  [copy : CompilerRegEdgeCopy]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [copy-instr : CompilerIrInstr (compiler-reg-edge-copy-instr copy)]
        [items : CompilerIrInstrList (compiler-ir-instr-seq-to-list instrs)]
        [rewritten : CompilerIrInstrList
          (match (compiler-reg-edge-copy-placement copy)
            [(CompilerRegEdgeCopyPlacement.PredEnd)
              (compiler-reg-edge-copy-insert-before-last items copy-instr)]
            [(CompilerRegEdgeCopyPlacement.SuccEntry)
              (compiler-reg-edge-copy-insert-after-phis items copy-instr)])]
        (CompilerIrBlock.Block
          label
          (compiler-ir-instr-seq-from-list rewritten)))]))

(define (compiler-reg-edge-copy-insert-one
  [blocks : CompilerIrBlockList]
  [copy : CompilerRegEdgeCopy]) : CompilerRegEdgeCopyRewrite
  (match blocks
    [(CompilerIrBlockList.Nil)
      (CompilerRegEdgeCopyRewrite.Refused
        (string.concat3
          "regalloc: edge copy insertion block not found: "
          (compiler-ir-label-text (compiler-reg-edge-copy-target-label copy))
          ""))]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label _)
          (if (= label (compiler-reg-edge-copy-target-label copy))
            (CompilerRegEdgeCopyRewrite.Rewrite
              (compiler-ir-block-cons
                (compiler-reg-edge-copy-insert-in-block block copy)
                (box-get rest)))
            (match (compiler-reg-edge-copy-insert-one (box-get rest) copy)
              [(CompilerRegEdgeCopyRewrite.Rewrite tail)
                (CompilerRegEdgeCopyRewrite.Rewrite
                  (compiler-ir-block-cons block tail))]
              [(CompilerRegEdgeCopyRewrite.Refused message)
                (CompilerRegEdgeCopyRewrite.Refused message)]))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [count : i64 (compiler-ir-block-seq-count seq)]
        [slots : (Array CompilerIrBlock)
          (array.make-array CompilerIrBlock count)]
        [i : i64 0]
        [found : bool false]
        [target : i64 (compiler-reg-edge-copy-target-label copy)]
        (begin
          (while (< i count)
            (let
              [block : CompilerIrBlock (compiler-ir-block-seq-ref seq i)]
              (begin
                (array-set!
                  slots
                  i
                  (match block
                    [(CompilerIrBlock.Block label _)
                      (if (and (not found) (= label target))
                        (begin
                          (set! found true)
                          (compiler-reg-edge-copy-insert-in-block block copy))
                        block)]))
                (set! i (+ i 1)))))
          (if found
            (CompilerRegEdgeCopyRewrite.Rewrite
              (CompilerIrBlockList.Array (CompilerIrBlockSeq slots count)))
            (CompilerRegEdgeCopyRewrite.Refused
              (string.concat3
                "regalloc: edge copy insertion block not found: "
                (compiler-ir-label-text target)
                "")))))]))

(define (compiler-reg-edge-copy-apply
  [blocks : CompilerIrBlockList]
  [copies : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyRewrite
  (let
    [slots : (Array CompilerRegEdgeCopy) (struct-get copies slots)]
    [count : i64 (struct-get copies len)]
    [index : i64 0]
    [current : CompilerIrBlockList blocks]
    [refusal : String ""]
    [refused : bool false]
    (begin
      (while (and (< index count) (not refused))
        (begin
          (match (compiler-reg-edge-copy-insert-one
            current
            (array-ref slots index))
            [(CompilerRegEdgeCopyRewrite.Rewrite rewritten)
              (set! current rewritten)]
            [(CompilerRegEdgeCopyRewrite.Refused message)
              (begin
                (set! refusal message)
                (set! refused true))])
          (set! index (+ index 1))))
      (if refused
        (CompilerRegEdgeCopyRewrite.Refused refusal)
        (CompilerRegEdgeCopyRewrite.Rewrite current)))))

(define (compiler-reg-loop-split-noop
  [blocks : CompilerIrBlockList]
  [vars : i64]) : CompilerRegCallSaveRewrite
  (CompilerRegCallSaveRewrite.Rewrite
    blocks
    vars
    vars
    CompilerRegAssignmentList.Nil
    CompilerRegVarTypeList.Nil))

(define (compiler-reg-loop-split-direction-present?
  [copies : CompilerRegEdgeCopySeq]
  [want-into : bool]) : bool
  (let
    [slots : (Array CompilerRegEdgeCopy) (struct-get copies slots)]
    [count : i64 (struct-get copies len)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (match (array-ref slots index)
            [(CompilerRegEdgeCopy.Copy _ _ _ _ _ direction _)
              (if (match direction
                [(CompilerRegEdgeCopyDirection.IntoRegion) want-into]
                [(CompilerRegEdgeCopyDirection.OutOfRegion) (not want-into)])
                (set! found true)
                unit)])
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-loop-split-copies-bidirectional?
  [copies : CompilerRegEdgeCopySeq]) : bool
  (and
    (compiler-reg-loop-split-direction-present? copies true)
    (compiler-reg-loop-split-direction-present? copies false)))

;; SplitKit step 1 (redefined write-back). Does any phi instruction in this block
;; DEFINE `var`? Phi-defined loop-carried values are EXCLUDED from the redefined
;; write-back path: rewriting a phi destination to the region register (and routing
;; its back-edge input through that register) is the phi-correct step-2 work. A var
;; that is redefined only by ordinary (non-phi) instructions has no such hazard --
;; the region remap rewrites its def to the register and the internal self-back-edge
;; carries it in-register.
;; Scanned in place over the contiguous sequence: materialising a cons list
;; first cost one 112 B heap node per instruction to answer a question that
;; reads one tag and one destination var. refs #5726
(define (compiler-reg-loop-split-phi-defines-var?
  [instrs : CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-instr-seq-ref instrs index)
            [(CompilerIrInstr.Phi dst _ _) (when (= dst var) (return true))]
            [_ unit])
          (set! index (+ index 1))))
      false)))

;; SplitKit step 1. Is `block` a single-block self-loop -- i.e. does it list its own
;; label among its successors (the loop body branches back to itself)? For such a
;; block the back-edge is INTERNAL to the (single-block) region, so a value homed in
;; a register stays in that register across iterations with NO boundary copy on the
;; back-edge. This is the only loop shape where a REDEFINED value can be soundly
;; homed with the existing single-block region machinery: a value carried across an
;; EXTERNAL back-edge (body -> header) would be reloaded/written-back every iteration
;; (no benefit) and, more importantly, would normally be phi-carried (step 2).
(define (compiler-reg-loop-split-self-loop?
  [block : CompilerLiveBlock]
  [region-label : i64]) : bool
  (compiler-live-label-set-contains?
    (compiler-reg-live-block-succs block)
    region-label))

;; SplitKit step 1. Is `var` its own coalesce root (parents[var] == var)? The
;; redefined write-back path homes the WHOLE coalesced group, so it only accepts a
;; root (a non-root member is reached via its root) -- that homes each group exactly
;; once and keeps the slot/edge-copy bookkeeping anchored on the canonical var. A var
;; with no coalesce entry (out of range) is a trivial singleton root.
(define (compiler-reg-loop-split-coalesce-root?
  [parents : (Array i64)]
  [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length parents)))
    true
    (= (array-ref parents var) var)))

;; SplitKit step 1. Point every coalesced member of `root` (every v with
;; parents[v] == root, including root itself) at `new-var` in the region remap. The
;; coalescer merged these vars because they are move-related and share one storage
;; slot; redirecting them all to the homed register inside the region (with the
;; INTO/OUT copies syncing that shared slot at the boundary) is the write-back that a
;; root-only remap would have left half-done. For a singleton root this sets exactly
;; remap[root] = new-var (byte-identical to the prior root-only remap).
(define (compiler-reg-loop-split-remap-coalesced-group!
  [remap : (Array i64)]
  [parents : (Array i64)]
  [root : i64]
  [new-var : i64]) : unit
  (let
    [n : i64 (array-length remap)]
    [v : i64 0]
    (while (< v n)
      (begin
        (if (and (< v (array-length parents)) (= (array-ref parents v) root))
          (array-set! remap v new-var)
          unit)
        (set! v (+ v 1))))))

;; SplitKit step 2 (phi-carried homing). The bitset of every coalesce-group
;; member of `root` (every v in [0,vars) with parents[v] == root, root included).
;; The coalescer keeps `parents` flat (every member points directly at its root --
;; see merge-root-parents-into!), so membership is a single array read. Used for
;; group-aware liveness on region-boundary edges and for the group mention count.
(define (compiler-reg-loop-split-group-member-set
  [parents : (Array i64)]
  [root : i64]
  [vars : i64]) : CompilerLiveI64Set
  (let
    [n : i64
      (if (< vars (array-length parents))
        vars
        (array-length parents))]
    [set : CompilerLiveI64Set (compiler-live-set-empty)]
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (if (= (array-ref parents v) root)
            (set! set (compiler-live-set-insert set v))
            unit)
          (set! v (+ v 1))))
      set)))

;; Every input of a group-carrying phi must be a VARIABLE whose root is also
;; `root`. This is the phi-correctness gate: after the region remap rewrites every
;; group member to the homed register R, such a phi becomes `R = phi [R, ...],
;; [R, ...]` -- an identity whose per-edge lowering is a self-move (R = R), so it
;; cannot RACE the INTO copy (R = slot) on the preheader edge. A constant input or
;; an input in a DIFFERENT coalesce group would lower to a real edge move that
;; conflicts with the INTO copy (order-dependent => silent miscompile), so it is
;; rejected.
(define (compiler-reg-loop-split-phi-inputs-all-in-group?
  [inputs : CompilerIrPhiInputList]
  [parents : (Array i64)]
  [root : i64]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) true]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-loop-split-phi-inputs-all-in-group?
        (compiler-ir-phi-input-seq-to-list seq)
        parents
        root)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (and
        (match value
          [(CompilerIrValue.Var src)
            (and
              (>= src 0)
              (< src (array-length parents))
              (= (array-ref parents src) root))]
          [_ false])
        (compiler-reg-loop-split-phi-inputs-all-in-group?
          (box-get rest)
          parents
          root))]))

;; The block is a phi-carrier for `root` iff (a) some phi DEFINES a group member
;; -- that phi is the loop-carrying one, its result flows around the back-edge --
;; AND (b) every such phi has all-in-group inputs (the phi-correctness gate
;; below; vacuously true when no such phi exists, which is why (a) is required
;; separately). (a) ensures we only take this path for genuinely phi-carried
;; values; step 1 handles the non-phi self-loop redefinition.
;;
;; This is the top seq->list site of the whole opt2 self-compile (227.9M Ir over
;; 357 755 calls): it used to materialise the block as a cons list ONCE and then
;; walk that list TWICE, once per predicate. Both predicates are pure read-only
;; scans, so they run directly over the sequence and the list is gone. refs #5726
(define (compiler-reg-loop-split-phi-group-defined-seq?
  [instrs : CompilerIrInstrSeq]
  [parents : (Array i64)]
  [root : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-instr-seq-ref instrs index)
            [(CompilerIrInstr.Phi dst _ _)
              (when
                (and
                  (>= dst 0)
                  (< dst (array-length parents))
                  (= (array-ref parents dst) root))
                (return true))]
            [_ unit])
          (set! index (+ index 1))))
      false)))

(define (compiler-reg-loop-split-phi-carry-clean-seq?
  [instrs : CompilerIrInstrSeq]
  [parents : (Array i64)]
  [root : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-instr-seq-ref instrs index)
            [(CompilerIrInstr.Phi dst inputs _)
              (if (and
                (>= dst 0)
                (< dst (array-length parents))
                (= (array-ref parents dst) root))
                (unless
                  (compiler-reg-loop-split-phi-inputs-all-in-group?
                    inputs
                    parents
                    root)
                  (return false))
                unit)]
            [_ unit])
          (set! index (+ index 1))))
      true)))

(define (compiler-reg-loop-split-phi-carried-group?
  [instrs : CompilerIrInstrSeq]
  [parents : (Array i64)]
  [root : i64]) : bool
  (and
    (compiler-reg-loop-split-phi-group-defined-seq? instrs parents root)
    (compiler-reg-loop-split-phi-carry-clean-seq? instrs parents root)))

;; The step-2 acceptance predicate: a single-block SELF-LOOP that carries `var`'s
;; coalesce group through a phi-correct header phi, with `var` the canonical
;; coalesce root. The back-edge of a self-loop is internal to the (single-block)
;; region, so the carried value stays in the homed register across iterations with
;; NO per-iteration copy; the only boundary work is the INTO copy at the loop entry
;; and (when the value is read after the loop) the OUT copy at the exit, both
;; placed/refused by the edge-copy planner.
(define (compiler-reg-loop-split-phi-carried-candidate?
  [block : CompilerLiveBlock]
  [region-label : i64]
  [instrs : CompilerIrInstrSeq]
  [var : i64]
  [parents : (Array i64)]) : bool
  (and
    (compiler-reg-loop-split-self-loop? block region-label)
    (compiler-reg-loop-split-coalesce-root? parents var)
    (compiler-reg-loop-split-phi-carried-group? instrs parents var)))

(define (compiler-reg-loop-split-instr-mentions-var?
  [instr : CompilerIrInstr]
  [var : i64]) : bool
  (or
    (compiler-live-set-contains? (compiler-live-instr-uses instr) var)
    (compiler-live-set-contains? (compiler-live-instr-defs instr) var)))

;; Group-aware mention count: how many instructions touch ANY member of the homed
;; coalesce group (used by the hot-benefit gate for the phi-carried path, where the
;; per-iteration uses are spread across the phi result / back-edge / preheader
;; members rather than a single var).
(define (compiler-reg-loop-split-instr-mentions-group?
  [instr : CompilerIrInstr]
  [members : CompilerLiveI64Set]) : bool
  (or
    (compiler-live-set-intersects? (compiler-live-instr-uses instr) members)
    (compiler-live-set-intersects? (compiler-live-instr-defs instr) members)))

;; Read-only counter: scan the sequence in place. refs #5726
(define (compiler-reg-loop-split-mention-count-group
  [instrs : CompilerIrInstrSeq]
  [members : CompilerLiveI64Set]) : i64
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [total : i64 0]
    (begin
      (while (< index count)
        (begin
          (if (compiler-reg-loop-split-instr-mentions-group?
            (compiler-ir-instr-seq-ref instrs index)
            members)
            (set! total (+ total 1))
            unit)
          (set! index (+ index 1))))
      total)))

;; Read-only counter: scan the sequence in place. refs #5726
(define (compiler-reg-loop-split-mention-count
  [instrs : CompilerIrInstrSeq]
  [var : i64]) : i64
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [total : i64 0]
    (begin
      (while (< index count)
        (begin
          (if (compiler-reg-loop-split-instr-mentions-var?
            (compiler-ir-instr-seq-ref instrs index)
            var)
            (set! total (+ total 1))
            unit)
          (set! index (+ index 1))))
      total)))

(define (compiler-reg-loop-split-region-interval
  [region-var : i64]
  [start : i64]
  [end : i64]) : CompilerRegIntervalSeq
  (compiler-reg-interval-seq-prepend
    (CompilerRegInterval region-var start end)
    (compiler-reg-interval-seq-empty)))

(define (compiler-reg-loop-split-var-overlaps-region?
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [region-intervals : CompilerRegIntervalSeq]) : bool
  (let
    [segments : (Array CompilerRegIntervalSeq) (struct-get intervals segments)]
    [var-segments : CompilerRegIntervalSeq
      (if (or (< var 0) (>= var (array-length segments)))
        (compiler-reg-interval-seq-empty)
        (array-ref segments var))]
    (if (not (compiler-reg-interval-seq-empty? var-segments))
      (compiler-reg-interval-seq-overlaps? var-segments region-intervals)
      (match (compiler-reg-interval-index-lookup intervals var)
        [(CompilerRegMaybeInterval.Some interval)
          (compiler-reg-interval-seq-overlaps-one? region-intervals interval)]
        [(CompilerRegMaybeInterval.No) true]))))

(define (compiler-reg-loop-split-location-conflicts-region?
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [assigned-var : i64 (struct-get item var)]
        [assigned-location : CompilerRegLocation (struct-get item location)]
        (if (or
          (= assigned-var ignore-var)
          (not (compiler-reg-location-overlaps? assigned-location location)))
          (compiler-reg-loop-split-location-conflicts-region?
            (box-get rest)
            intervals
            region-intervals
            ignore-var
            location)
          (if (compiler-reg-loop-split-var-overlaps-region?
            intervals
            assigned-var
            region-intervals)
            true
            (compiler-reg-loop-split-location-conflicts-region?
              (box-get rest)
              intervals
              region-intervals
              ignore-var
              location))))]))

(define (compiler-reg-loop-split-first-register
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]) : CompilerRegMaybeId
  (match regs
    [(CompilerRegIdList.Nil) CompilerRegMaybeId.No]
    [(CompilerRegIdList.Cons reg rest)
      (if (compiler-reg-loop-split-location-conflicts-region?
        assignments
        intervals
        region-intervals
        ignore-var
        (CompilerRegLocation.Register reg))
        (compiler-reg-loop-split-first-register
          (box-get rest)
          assignments
          intervals
          region-intervals
          ignore-var)
        (CompilerRegMaybeId.Some reg))]))

;; Return the single assigned var (other than ignore-var) that holds `location`
;; and overlaps the region, or -1 if zero -- or more than one -- such var exists.
;; `acc` threads the search: -2 = none seen yet, -1 = multiple (not evictable),
;; >=0 = the one var found so far.
(define (compiler-reg-loop-split-region-occupant
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [location : CompilerRegLocation]
  [acc : i64]) : i64
  (match assignments
    [(CompilerRegAssignmentList.Nil) acc]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [assigned-var : i64 (struct-get item var)]
        [assigned-location : CompilerRegLocation (struct-get item location)]
        (if (or
          (= acc (- 0 1))
          (= assigned-var ignore-var)
          (not (compiler-reg-location-overlaps? assigned-location location)))
          (compiler-reg-loop-split-region-occupant
            (box-get rest)
            intervals
            region-intervals
            ignore-var
            location
            acc)
          (if (compiler-reg-loop-split-var-overlaps-region?
            intervals
            assigned-var
            region-intervals)
            (compiler-reg-loop-split-region-occupant
              (box-get rest)
              intervals
              region-intervals
              ignore-var
              location
              (if (= acc (- 0 2))
                assigned-var
                (- 0 1)))
            (compiler-reg-loop-split-region-occupant
              (box-get rest)
              intervals
              region-intervals
              ignore-var
              location
              acc))))]))

;; Eviction-aware register pick: used when no candidate register is FREE over the
;; region. Find a candidate register whose region occupant is a SINGLE var of
;; STRICTLY LOWER spill weight than the loop-invariant being homed. Re-spilling
;; that lower-weight var frees the register for the hotter invariant -- a strict
;; total-spill-cost decrease (so it cannot oscillate; fuel bounds it anyway).
;; Returns the register and the var to evict, or None.
(define (compiler-reg-loop-split-first-register-evict
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [weights : (Array i64)]
  [inv-weight : i64]) : CompilerRegLoopSplitEvict
  (match regs
    [(CompilerRegIdList.Nil) (CompilerRegLoopSplitEvictNone)]
    [(CompilerRegIdList.Cons reg rest)
      (let
        [occ : i64
          (compiler-reg-loop-split-region-occupant
            assignments
            intervals
            region-intervals
            ignore-var
            (CompilerRegLocation.Register reg)
            (- 0 2))]
        (if (and
          (>= occ 0)
          (< occ (array-length weights))
          (< (array-ref weights occ) inv-weight))
          (CompilerRegLoopSplitEvict reg occ)
          (compiler-reg-loop-split-first-register-evict
            (box-get rest)
            assignments
            intervals
            region-intervals
            ignore-var
            weights
            inv-weight)))]))

(define (compiler-reg-loop-split-type-ok?
  [type-info : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [var : i64]) : CompilerRegMaybeType
  (if (compiler-live-set-contains? group-vars var)
    CompilerRegMaybeType.No
    (match (compiler-reg-var-types-lookup type-info var)
      [(CompilerRegMaybeType.Some ty)
        (if (and
          (compiler-reg-register-eligible-type? ty)
          (not (compiler-reg-float-type? ty)))
          (CompilerRegMaybeType.Some ty)
          CompilerRegMaybeType.No)]
      [(CompilerRegMaybeType.No) CompilerRegMaybeType.No])))

(define (compiler-reg-loop-split-hot-benefit?
  [mentions : i64]
  [depth : i64]
  [copy-count : i64]) : bool
  (and
    (> depth 0)
    (> mentions 0)
    (> (* mentions (compiler-reg-loop-depth-weight depth)) copy-count)))

(define (compiler-reg-loop-split-succs-has-backedge?
  [liveness : CompilerFunctionLiveness]
  [source-index : i64]
  [succs : CompilerLiveLabelSet]) : bool
  (match succs
    [(CompilerLiveLabelSet.Nil) false]
    [(CompilerLiveLabelSet.Dense _ _)
      (let
        [target-index : i64
          (compiler-live-function-block-index
            liveness
            (compiler-live-label-set-ref succs 0))]
        (if (>= target-index 0)
          (if (<= target-index source-index)
            true
            (compiler-reg-loop-split-succs-has-backedge?
              liveness
              source-index
              (compiler-live-label-set-tail succs)))
          (compiler-reg-loop-split-succs-has-backedge?
            liveness
            source-index
            (compiler-live-label-set-tail succs))))]))

(define (compiler-reg-loop-split-region-remap-blocks
  [blocks : CompilerIrBlockList]
  [region : reg_label_i64_map.Map]
  [remap : (Array i64)]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [rewritten-block : CompilerIrBlock
              (if (compiler-reg-region-label? region label)
                (CompilerIrBlock.Block
                  label
                  (compiler-reg-remap-instr-seq remap instrs))
                block)]
            (compiler-ir-block-cons
              rewritten-block
              (compiler-reg-loop-split-region-remap-blocks
                (box-get rest)
                region
                remap)))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [count : i64 (compiler-ir-block-seq-count seq)]
        [slots : (Array CompilerIrBlock)
          (array.make-array CompilerIrBlock count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (let
              [block : CompilerIrBlock (compiler-ir-block-seq-ref seq i)]
              (begin
                (array-set!
                  slots
                  i
                  (match block
                    [(CompilerIrBlock.Block label instrs)
                      (if (compiler-reg-region-label? region label)
                        (CompilerIrBlock.Block
                          label
                          (compiler-reg-remap-instr-seq remap instrs))
                        block)]))
                (set! i (+ i 1)))))
          (CompilerIrBlockList.Array (CompilerIrBlockSeq slots count))))]))

;; A loop region (one loop block) is clobber-free for caller-saved registers iff it
;; contains no call/syscall -- those clobber the whole caller-saved set. Per-reg
;; fixed-use hazards are handled separately: %rcx is offered only when the region
;; crosses no variable shift, and %rdx only when it crosses no div/mod/mul fixed
;; use. In a clobber-free region a caller-saved reg survives the loop and is
;; protected from scratch use by the scavenger freeness check (the rescued var's
;; home is occupied while live) -- exactly as for the callee-saved regs the rescue
;; already uses, so no prologue save is needed.
(define (compiler-reg-loop-split-seq-has-call-or-syscall?
  [instrs : CompilerIrInstrSeq]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (set!
            found
            (match (array-ref slots index)
              [(CompilerIrInstr.Call _ _ _ _) true]
              [(CompilerIrInstr.CallIndirect _ _ _ _) true]
              [(CompilerIrInstr.CallIndirectC _ _ _ _) true]
              [(CompilerIrInstr.CallCAbiStoreResult _) true]
              [(CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
              [(CompilerIrInstr.TailCall _ _ _) true]
              [(CompilerIrInstr.TailCallIndirect _ _ _) true]
              [(CompilerIrInstr.Syscall _ _) true]
              [_ false]))
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-loop-split-region-crosses-kind-seq?
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [kind : i64]
  [start : i64]
  [end : i64]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [p : i64 point]
    [found : bool false]
    (begin
      (while (and (< index count) (< p end) (not found))
        (begin
          (if (and
            (>= p start)
            (compiler-reg-clobber-instr-kind?
              type-segment-bases
              (array-ref slots index)
              kind))
            (set! found true)
            unit)
          (set! p (+ p 2))
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-loop-split-region-crosses-kind-blocks?
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [point : i64]
  [kind : i64]
  [start : i64]
  [end : i64]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [next-point : i64
              (+ point (* 2 (compiler-ir-instr-seq-count instrs)))]
            (cond
              [(>= point end) false]
              [(<= next-point start)
                (compiler-reg-loop-split-region-crosses-kind-blocks?
                  type-segment-bases
                  (box-get rest)
                  next-point
                  kind
                  start
                  end)]
              [(compiler-reg-loop-split-region-crosses-kind-seq?
                  type-segment-bases
                  instrs
                  point
                  kind
                  start
                  end)
                true]
              [else
                (compiler-reg-loop-split-region-crosses-kind-blocks?
                  type-segment-bases
                  (box-get rest)
                  next-point
                  kind
                  start
                  end)]))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [p : i64 point]
        [found : bool false]
        (begin
          (while (and (< index count) (< p end) (not found))
            (match (compiler-ir-block-seq-ref seq index)
              [(CompilerIrBlock.Block _ instrs)
                (let
                  [next-point : i64
                    (+ p (* 2 (compiler-ir-instr-seq-count instrs)))]
                  (begin
                    (if (and
                      (> next-point start)
                      (compiler-reg-loop-split-region-crosses-kind-seq?
                        type-segment-bases
                        instrs
                        p
                        kind
                        start
                        end))
                      (set! found true)
                      unit)
                    (set! p next-point)
                    (set! index (+ index 1))))]))
          found))]))

(define (compiler-reg-loop-split-region-crosses-kind?
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [kind : i64]
  [start : i64]
  [end : i64]) : bool
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-loop-split-region-crosses-kind-blocks?
        type-segment-bases
        blocks
        0
        kind
        start
        end)]))

(define (compiler-reg-loop-split-region-rcx-safe?
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [start : i64]
  [end : i64]) : bool
  (not
    (compiler-reg-loop-split-region-crosses-kind?
      type-segment-bases
      func
      2
      start
      end)))

(define (compiler-reg-loop-split-region-rdx-safe?
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [start : i64]
  [end : i64]) : bool
  (not
    (compiler-reg-loop-split-region-crosses-kind?
      type-segment-bases
      func
      4
      start
      end)))

(define (compiler-reg-loop-split-cons-if
  [enabled : bool]
  [reg : i64]
  [rest : CompilerRegIdList]) : CompilerRegIdList
  (if enabled
    (compiler-reg-id-cons reg rest)
    rest))

;; Candidate registers for the loop-split rescue. Always the 5 callee-saved (sound
;; everywhere). When the region is clobber-free, ALSO offer caller-saved
;; r8/r9/rsi/rdi and the fixed-use regs %rcx/%rdx when the region-specific
;; clobber scan proves they are not overwritten. Caller-saved candidates are tried
;; first, so a clobber-free hot loop can keep a value in a register without adding
;; a callee reg to the prologue save set.
(define (compiler-reg-loop-split-candidate-regs
  [clobber-free? : bool]
  [rcx-safe? : bool]
  [rdx-safe? : bool]) : CompilerRegIdList
  (if clobber-free?
    (compiler-reg-id-cons
      compiler-reg-id-r8
      (compiler-reg-id-cons
        compiler-reg-id-r9
        (compiler-reg-id-cons
          compiler-reg-id-rsi
          (compiler-reg-id-cons
            compiler-reg-id-rdi
            (compiler-reg-loop-split-cons-if
              rcx-safe?
              compiler-reg-id-rcx
              (compiler-reg-loop-split-cons-if
                rdx-safe?
                compiler-reg-id-rdx
                (compiler-reg-sysv-integer-registers)))))))
    (compiler-reg-sysv-integer-registers)))

;; ---------------------------------------------------------------------------
;; On-demand per-header critical-edge split (dedicated preheader insertion).
;;
;; A loop block that is its own region (phi-header with a self/critical entry
;; edge -- the array_sum shape) cannot receive the once-per-loop INTO copy:
;; edge-copy-plan-for-region refuses because the entry edge is critical
;; (predecessor has >1 successor AND the loop block has >1 predecessor). LLVM's
;; LoopSimplify inserts a dedicated preheader. We do the same, but ONLY for the
;; one header the loop-split is about to home (so non-qualifying loops are
;; untouched -- a global insert+prune perturbs every loop's per-round liveness,
;; which is why slice-2 measured +3299). These per-header helpers (ported from
;; the slice-2 preheader machinery) splice a single `<h>.preheader: jmp <h>`
;; block before header h, redirect h's single out-of-loop critical-edge
;; predecessor to it, and relabel h's phi inputs from that predecessor to the
;; preheader (a pass-through, value-preserving).
;; ---------------------------------------------------------------------------
(define (compiler-reg-preheader-block-label [block : CompilerIrBlock]) : i64
  (match block
    [(CompilerIrBlock.Block label _) label]))

(define (compiler-reg-preheader-succ-count [block : CompilerIrBlock]) : i64
  (compiler-live-label-set-count (compiler-live-block-successors block)))

(define (compiler-reg-preheader-succ-contains?
  [block : CompilerIrBlock]
  [label : i64]) : bool
  (compiler-live-label-set-contains?
    (compiler-live-block-successors block)
    label))

;; True iff the block's terminator is a conditional branch -- the only
;; critical-edge terminator we know how to redirect (a Jump has a single
;; successor, so it is never a critical edge).
(define (compiler-reg-preheader-terminator-branch? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [c : i64 (compiler-ir-instr-seq-count instrs)]
        (if (<= c 0)
          false
          (match (compiler-ir-instr-seq-ref instrs (- c 1))
            [(CompilerIrInstr.Branch _ _ _) true]
            [_ false])))]))

;; loop-ends[h] = highest block index with a back-edge to block h (-1 if none).
;; h is a loop header iff loop-ends[h] >= h; [h..loop-ends[h]] is its natural
;; loop. Same back-edge scan the loop-depth pass uses.
(define (compiler-reg-preheader-loop-ends
  [blocks : CompilerIrBlockList]
  [count : i64]) : (Array i64)
  (let
    [loop-ends : (Array i64) (array.make-array i64 count)]
    [ids : reg_label_i64_map.Map
      (compiler-reg-loop-depth-block-ids
        blocks
        (reg_label_i64_map.with-capacity (compiler-reg-bits-map-capacity count))
        0)]
    (begin
      (compiler-reg-fill-i64-array loop-ends (- 0 1))
      (compiler-reg-loop-depth-record-blocks! blocks ids loop-ends 0)
      loop-ends)))

(define (compiler-reg-preheader-loop-ends-seq
  [seq : CompilerIrBlockSeq]
  [count : i64]) : (Array i64)
  (let
    [loop-ends : (Array i64) (array.make-array i64 count)]
    [ids : reg_label_i64_map.Map
      (compiler-reg-loop-depth-block-ids-seq
        seq
        (reg_label_i64_map.with-capacity (compiler-reg-bits-map-capacity count))
        0)]
    (begin
      (compiler-reg-fill-i64-array loop-ends (- 0 1))
      (compiler-reg-loop-depth-record-blocks-seq! seq ids loop-ends 0)
      loop-ends)))

;; Scan all blocks for predecessors of header `h` (succ contains h-label) that
;; lie OUTSIDE the natural-loop range [h..le]. Returns the single such index,
;; -1 if none, or -2 if more than one (multi-entry -- not this slice).
(define (compiler-reg-preheader-scan-outside-preds
  [orig : (Array CompilerIrBlock)]
  [h : i64]
  [le : i64]
  [h-label : i64]
  [n : i64]
  [p : i64]
  [found : i64]) : i64
  (if (>= p n)
    found
    (if (= found (- 0 2))
      (- 0 2)
      (compiler-reg-preheader-scan-outside-preds
        orig
        h
        le
        h-label
        n
        (+ p 1)
        (if (and
          (or (< p h) (> p le))
          (compiler-reg-preheader-succ-contains? (array-ref orig p) h-label))
          (if (= found (- 0 1))
            p
            (- 0 2))
          found)))))

;; If the header at block index `h` qualifies for a dedicated preheader, return
;; the block index of its single out-of-loop predecessor; otherwise -1.
(define (compiler-reg-preheader-pred-for-header
  [orig : (Array CompilerIrBlock)]
  [loop-ends : (Array i64)]
  [ids : reg_label_i64_map.Map]
  [h : i64]
  [h-label : i64]) : i64
  (if (or
    (<= h 0)
    (>= h (array-length loop-ends))
    (< (array-ref loop-ends h) h)
    (reg_label_i64_map.contains?
      (& ids)
      (compiler-ir-label
        (str_cat.str-cat (compiler-ir-label-text h-label) ".preheader"))))
    (- 0 1)
    (let
      [le : i64 (array-ref loop-ends h)]
      [n : i64 (array-length orig)]
      [pred : i64
        (compiler-reg-preheader-scan-outside-preds
          orig
          h
          le
          h-label
          n
          0
          (- 0 1))]
      (if (< pred 0)
        (- 0 1)
        (if (and
          (> (compiler-reg-preheader-succ-count (array-ref orig pred)) 1)
          (compiler-reg-preheader-terminator-branch? (array-ref orig pred)))
          pred
          (- 0 1))))))

;; Redirect a successor label: if `s` is a header that gets a preheader and the
;; block doing the redirect (`pred-index`) is that header's single out-of-loop
;; predecessor, retarget to the header's preheader label; else unchanged.
(define (compiler-reg-preheader-subst-label
  [ids : reg_label_i64_map.Map]
  [header-pred : (Array i64)]
  [pred-index : i64]
  [s : i64]) : i64
  (match (reg_label_i64_map.get (& ids) s)
    [(reg_label_i64_map.LookupFound h-idx)
      (if (and
        (< h-idx (array-length header-pred))
        (= (array-ref header-pred h-idx) pred-index))
        (compiler-ir-label
          (str_cat.str-cat (compiler-ir-label-text s) ".preheader"))
        s)]
    [(reg_label_i64_map.LookupMissing) s]))

(define (compiler-reg-preheader-list-replace-last
  [instrs : CompilerIrInstrList]
  [new-last : CompilerIrInstr]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) CompilerIrInstrList.Nil]
    [(CompilerIrInstrList.Cons instr rest)
      (match (box-get rest)
        [(CompilerIrInstrList.Nil)
          (compiler-ir-instr-cons new-last CompilerIrInstrList.Nil)]
        [_
          (compiler-ir-instr-cons
            instr
            (compiler-reg-preheader-list-replace-last (box-get rest) new-last))])]))

;; Redirect the conditional-branch terminator of `block` (at `index`) for any
;; target that is a preheader-getting header whose single out-of-loop
;; predecessor is this block.
(define (compiler-reg-preheader-redirect-block
  [ids : reg_label_i64_map.Map]
  [header-pred : (Array i64)]
  [block : CompilerIrBlock]
  [index : i64]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [c : i64 (compiler-ir-instr-seq-count instrs)]
        (if (<= c 0)
          block
          (match (compiler-ir-instr-seq-ref instrs (- c 1))
            [(CompilerIrInstr.Branch cond t f)
              (let
                [nt : i64
                  (compiler-reg-preheader-subst-label ids header-pred index t)]
                [nf : i64
                  (compiler-reg-preheader-subst-label ids header-pred index f)]
                (if (and (= nt t) (= nf f))
                  block
                  (CompilerIrBlock.Block
                    label
                    (compiler-ir-instr-seq-from-list
                      (compiler-reg-preheader-list-replace-last
                        (compiler-ir-instr-seq-to-list instrs)
                        (CompilerIrInstr.Branch cond nt nf))))))]
            [_ block])))]))

;; Relabel a header's phi inputs that came from `pred-label` to `ph-label`
;; (the value is unchanged -- the preheader is a pass-through).
(define (compiler-reg-preheader-relabel-phi-inputs
  [inputs : CompilerIrPhiInputList]
  [pred-label : i64]
  [ph-label : i64]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) CompilerIrPhiInputList.Nil]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-preheader-relabel-phi-inputs
        (compiler-ir-phi-input-seq-to-list seq)
        pred-label
        ph-label)]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        value
        (if (= label pred-label)
          ph-label
          label)
        (compiler-reg-preheader-relabel-phi-inputs
          (box-get rest)
          pred-label
          ph-label))]))

(define (compiler-reg-preheader-relabel-instr-list
  [instrs : CompilerIrInstrList]
  [pred-label : i64]
  [ph-label : i64]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) CompilerIrInstrList.Nil]
    [(CompilerIrInstrList.Cons instr rest)
      (compiler-ir-instr-cons
        (match instr
          [(CompilerIrInstr.Phi dst inputs ty)
            (CompilerIrInstr.Phi
              dst
              (compiler-reg-preheader-relabel-phi-inputs
                inputs
                pred-label
                ph-label)
              ty)]
          [_ instr])
        (compiler-reg-preheader-relabel-instr-list
          (box-get rest)
          pred-label
          ph-label))]))

(define (compiler-reg-preheader-relabel-header
  [block : CompilerIrBlock]
  [pred-label : i64]
  [ph-label : i64]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (CompilerIrBlock.Block
        label
        (compiler-ir-instr-seq-from-list
          (compiler-reg-preheader-relabel-instr-list
            (compiler-ir-instr-seq-to-list instrs)
            pred-label
            ph-label)))]))

;; Walk the block list: redirect each block's terminator, and immediately
;; before each preheader-getting header splice an empty `jmp header` preheader
;; (with the header's phi inputs relabeled from the predecessor to it).
(define (compiler-reg-preheader-rewrite
  [orig : (Array CompilerIrBlock)]
  [ids : reg_label_i64_map.Map]
  [header-pred : (Array i64)]
  [blocks : CompilerIrBlockList]
  [index : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [tail : CompilerIrBlockList
          (compiler-reg-preheader-rewrite
            orig
            ids
            header-pred
            (box-get rest)
            (+ index 1))]
        [redirected : CompilerIrBlock
          (compiler-reg-preheader-redirect-block ids header-pred block index)]
        [pred : i64
          (if (< index (array-length header-pred))
            (array-ref header-pred index)
            (- 0 1))]
        (if (>= pred 0)
          (let
            [h-label : i64 (compiler-reg-preheader-block-label block)]
            [ph-label : i64
              (compiler-ir-label
                (str_cat.str-cat (compiler-ir-label-text h-label) ".preheader"))]
            [pred-label : i64
              (compiler-reg-preheader-block-label (array-ref orig pred))]
            (compiler-ir-block-cons
              (compiler-ir-block
                ph-label
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Jump h-label)
                  CompilerIrInstrList.Nil))
              (compiler-ir-block-cons
                (compiler-reg-preheader-relabel-header
                  redirected
                  pred-label
                  ph-label)
                tail)))
          (compiler-ir-block-cons redirected tail)))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 (- (compiler-ir-block-seq-count seq) 1)]
        [out : CompilerIrBlockList CompilerIrBlockList.Nil]
        (begin
          (while (>= i 0)
            (let
              [actual-index : i64 (+ index i)]
              [block : CompilerIrBlock (compiler-ir-block-seq-ref seq i)]
              [redirected : CompilerIrBlock
                (compiler-reg-preheader-redirect-block
                  ids
                  header-pred
                  block
                  actual-index)]
              [pred : i64
                (if (< actual-index (array-length header-pred))
                  (array-ref header-pred actual-index)
                  (- 0 1))]
              (begin
                (set!
                  out
                  (if (>= pred 0)
                    (let
                      [h-label : i64 (compiler-reg-preheader-block-label block)]
                      [ph-label : i64
                        (compiler-ir-label
                          (str_cat.str-cat
                            (compiler-ir-label-text h-label)
                            ".preheader"))]
                      [pred-label : i64
                        (compiler-reg-preheader-block-label
                          (array-ref orig pred))]
                      (compiler-ir-block-cons
                        (compiler-ir-block
                          ph-label
                          (compiler-ir-instr-cons
                            (CompilerIrInstr.Jump h-label)
                            CompilerIrInstrList.Nil))
                        (compiler-ir-block-cons
                          (compiler-reg-preheader-relabel-header
                            redirected
                            pred-label
                            ph-label)
                          out)))
                    (compiler-ir-block-cons redirected out)))
                (set! i (- i 1)))))
          out))]))

;; Splice a dedicated preheader for ONE header (given by label). Builds a
;; header-pred array with only that header set (if it qualifies via
;; pred-for-header), then runs the per-header rewrite. Non-target loops are
;; untouched. Returns the original blocks unchanged if the header does not
;; qualify (no critical-edge out-of-loop predecessor, or a preheader already
;; exists).
(define (compiler-reg-loop-split-splice-preheader
  [blocks : CompilerIrBlockList]
  [header-label : i64]) : CompilerIrBlockList
  (let
    [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
    [count : i64 (compiler-ir-block-seq-count seq)]
    (if (<= count 1)
      blocks
      (let
        [orig : (Array CompilerIrBlock) (struct-get seq slots)]
        [ids : reg_label_i64_map.Map
          (compiler-reg-loop-depth-block-ids-seq
            seq
            (reg_label_i64_map.with-capacity
              (compiler-reg-bits-map-capacity count))
            0)]
        [loop-ends : (Array i64)
          (compiler-reg-preheader-loop-ends-seq seq count)]
        [header-pred : (Array i64) (array.make-array i64 count)]
        (begin
          (compiler-reg-fill-i64-array header-pred (- 0 1))
          (match (reg_label_i64_map.get (& ids) header-label)
            [(reg_label_i64_map.LookupFound h)
              (let
                [pred : i64
                  (compiler-reg-preheader-pred-for-header
                    orig
                    loop-ends
                    ids
                    h
                    header-label)]
                (if (>= pred 0)
                  (begin
                    (array-set! header-pred h pred)
                    (compiler-reg-preheader-rewrite
                      orig
                      ids
                      header-pred
                      blocks
                      0))
                  blocks))]
            [(reg_label_i64_map.LookupMissing) blocks]))))))

(define (compiler-reg-loop-split-try-var
  [_abi : CompilerRegTargetAbi]
  [_func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [region-label : i64]
  [block : CompilerLiveBlock]
  [instrs : CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdList]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (let
    ;; SplitKit step 2: is this a phi-carried single-block self-loop value (a real
    ;; SSA loop-carried accumulator/counter, phi-defined at the loop header) whose
    ;; whole coalesce group is phi-correct (every header-phi input is in the group)?
    ;; If so we home the GROUP (the shared spill slot) in a register across the
    ;; self-loop with a group-aware boundary plan; step 1 only covered NON-phi
    ;; self-loop redefinition.
    [phi-carried? : bool
      (compiler-reg-loop-split-phi-carried-candidate?
        block
        region-label
        instrs
        var
        parents)]
    [members : CompilerLiveI64Set
      (if phi-carried?
        (compiler-reg-loop-split-group-member-set parents var vars)
        (compiler-live-set-empty))]
    (if (if phi-carried?
      ;; Phi-carried gate. The structural preconditions (self-loop, `var` is the
      ;; coalesce root, the header phi(s) carrying the group have all-in-group
      ;; inputs) are checked by phi-carried-candidate? above. The remaining gate
      ;; is only "is it a spillable multi-segment value"; group liveness across
      ;; the region boundary is enforced by the group-aware plan below (an INTO
      ;; copy proves the group is live into the loop; OUT copies, emitted on every
      ;; live exit edge or else the plan is refused, prove the write-backs exist).
      (compiler-reg-interval-index-var-has-segments? intervals var)
      (and
        (compiler-live-set-contains? (compiler-live-block-live-in block) var)
        (compiler-live-set-contains? (compiler-live-block-live-out block) var)
        ;; SplitKit step 1: admit BOTH read-only loop invariants (var not written in the
        ;; region) AND redefined values, but for redefinition only in the bounded sound
        ;; case: a single-block self-loop where the redefinition is NOT phi-carried. The
        ;; read-only path needs only an INTO copy; the redefined path additionally needs
        ;; write-back (OUT copies), required below. `(not (defs-in-block))` used to
        ;; hard-reject every redefined value.
        (or
          (not
            (compiler-live-set-contains? (compiler-live-block-defs block) var))
          (and
            (compiler-reg-loop-split-self-loop? block region-label)
            (not (compiler-reg-loop-split-phi-defines-var? instrs var))))
        (compiler-reg-interval-index-var-has-segments? intervals var)
        ;; Coalescing gate. A carried `(set! acc EXPR)` lowers to `tmp = EXPR; acc = tmp`,
        ;; so the reg-alloc coalescer merges acc with tmp -- EVERY loop-carried redefined
        ;; value is a non-singleton coalesce root. The READ-ONLY path keeps the original
        ;; exclusion (region-remap rewrites only the homed var, so coalesced members would
        ;; be left dangling). The REDEFINED self-loop path instead HOMES THE WHOLE COALESCED
        ;; GROUP: apply-candidate remaps every move-related member to the region register
        ;; and the INTO/OUT copies sync the shared slot at the region boundary -- so a
        ;; coalesced ROOT is accepted (a non-root member is left for its root's turn, so the
        ;; group is homed exactly once).
        (if (compiler-live-set-contains? (compiler-live-block-defs block) var)
          (compiler-reg-loop-split-coalesce-root? parents var)
          (not
            (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)))))
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _)
              (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
                [(CompilerRegMaybeType.Some ty)
                  (let
                    [labels : CompilerRegLabelList
                      (CompilerRegLabelList.Cons
                        region-label
                        (box CompilerRegLabelList.Nil))]
                    [mentions : i64
                      (if phi-carried?
                        (compiler-reg-loop-split-mention-count-group
                          instrs
                          members)
                        (compiler-reg-loop-split-mention-count instrs var))]
                    [region-intervals : CompilerRegIntervalSeq
                      (compiler-reg-loop-split-region-interval
                        vars
                        region-start
                        region-end)]
                    (match (if phi-carried?
                      (compiler-reg-edge-copy-plan-for-region-group-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty
                        members)
                      (compiler-reg-edge-copy-plan-for-region-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty))
                      [(CompilerRegEdgeCopyPlan.Plan copies)
                        (let
                          [copy-count : i64
                            (compiler-reg-edge-copy-list-count copies)]
                          (if (and
                            ;; Read-only loop invariants are sound with an INTO copy
                            ;; alone: the var is never written in the region, so its
                            ;; slot stays authoritative for any out-of-region read.
                            ;; REDEFINED values (var in defs block -- the SplitKit
                            ;; step-1 case) instead REQUIRE write-back: an OUT copy must
                            ;; store the region register back to the var's slot at every
                            ;; region exit so out-of-region reads observe the current
                            ;; value. The planner emits an OUT copy on every live exit
                            ;; edge or REFUSES (critical edge -> handled above), so a
                            ;; non-refused bidirectional plan write-backs every exit;
                            ;; requiring at least one OUT (copies-bidirectional?) rejects
                            ;; the degenerate no-exit redefinition that never writes back.
                            ;;
                            ;; The PHI-CARRIED path uses the weaker INTO-present test:
                            ;; the group-aware planner already emits an OUT copy on
                            ;; every live exit edge (or refuses on a critical one), so a
                            ;; non-refused plan with an INTO copy has all required
                            ;; write-backs; values NOT live after the loop (a homed
                            ;; counter) correctly need no OUT copy and are still homed.
                            (if phi-carried?
                              (compiler-reg-loop-split-direction-present?
                                copies
                                true)
                              (if (compiler-live-set-contains?
                                (compiler-live-block-defs block)
                                var)
                                (compiler-reg-loop-split-copies-bidirectional?
                                  copies)
                                (compiler-reg-loop-split-direction-present?
                                  copies
                                  true)))
                            (compiler-reg-loop-split-hot-benefit?
                              mentions
                              depth
                              copy-count))
                            (match (compiler-reg-loop-split-first-register
                              candidate-regs
                              assignments
                              intervals
                              region-intervals
                              var)
                              [(CompilerRegMaybeId.Some reg)
                                (CompilerRegLoopSplitCandidate.Candidate
                                  var
                                  labels
                                  ty
                                  reg
                                  copies
                                  (- 0 1))]
                              [(CompilerRegMaybeId.No)
                                (match (compiler-reg-loop-split-first-register-evict
                                  candidate-regs
                                  assignments
                                  intervals
                                  region-intervals
                                  var
                                  weights
                                  (if (< var (array-length weights))
                                    (array-ref weights var)
                                    0))
                                  [(CompilerRegLoopSplitEvict ereg evar)
                                    (CompilerRegLoopSplitCandidate.Candidate
                                      var
                                      labels
                                      ty
                                      ereg
                                      copies
                                      evar)]
                                  [(CompilerRegLoopSplitEvictNone)
                                    (CompilerRegLoopSplitCandidate.NoCandidate)])])
                            (CompilerRegLoopSplitCandidate.NoCandidate)))]
                      [(CompilerRegEdgeCopyPlan.Refused _)
                        (CompilerRegLoopSplitCandidate.NoCandidate)]))]
                [(CompilerRegMaybeType.No)
                  (CompilerRegLoopSplitCandidate.NoCandidate)])]
            [_ (CompilerRegLoopSplitCandidate.NoCandidate)])]
        [(CompilerRegMaybeLocation.No)
          (CompilerRegLoopSplitCandidate.NoCandidate)])
      (CompilerRegLoopSplitCandidate.NoCandidate))))

(define (compiler-reg-loop-split-select-var
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [region-label : i64]
  [block : CompilerLiveBlock]
  [instrs : CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdList]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (if (>= var vars)
    (CompilerRegLoopSplitCandidate.NoCandidate)
    (match (compiler-reg-loop-split-try-var
      abi
      func
      liveness
      region-label
      block
      instrs
      region-start
      region-end
      depth
      candidate-regs
      vars
      var
      type-info
      assignments
      intervals
      group-vars
      parents
      merged-roots
      weights)
      [(CompilerRegLoopSplitCandidate.NoCandidate)
        (compiler-reg-loop-split-select-var
          abi
          func
          liveness
          region-label
          block
          instrs
          region-start
          region-end
          depth
          candidate-regs
          vars
          (+ var 1)
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          weights)]
      [(CompilerRegLoopSplitCandidate.Candidate
          stack-var
          label
          ty
          reg
          copies
          evicted)
        (CompilerRegLoopSplitCandidate.Candidate
          stack-var
          label
          ty
          reg
          copies
          evicted)])))

(define (compiler-reg-loop-split-select-blocks
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [depths : (Array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerRegLoopSplitCandidate.NoCandidate)]
    [(CompilerIrBlockList.Cons ir-block rest)
      (match ir-block
        [(CompilerIrBlock.Block label instrs)
          (let
            [next-point : i64
              (+ point (* 2 (compiler-ir-instr-seq-count instrs)))]
            [depth : i64
              (if (< block-index (array-length depths))
                (array-ref depths block-index)
                0)]
            [candidate-regs : CompilerRegIdList
              (compiler-reg-loop-split-candidate-regs
                (not (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
                (compiler-reg-loop-split-region-rcx-safe?
                  type-segment-bases
                  func
                  point
                  next-point)
                (compiler-reg-loop-split-region-rdx-safe?
                  type-segment-bases
                  func
                  point
                  next-point))]
            (if (and
              (< block-index (array-length live-blocks))
              (> depth 0)
              ;; phi-blocks allowed: the not-defined-in-block gate in try-var
              ;; restricts to read-only invariants (a phi-defined var IS defined
              ;; in the block, so it is rejected), and on-demand preheader
              ;; insertion carries/relabels the header's phi inputs.
              true
              (compiler-reg-loop-split-succs-has-backedge?
                liveness
                block-index
                (compiler-reg-live-block-succs
                  (array-ref live-blocks block-index))))
              (match (compiler-reg-loop-split-select-var
                abi
                func
                liveness
                label
                (array-ref live-blocks block-index)
                instrs
                point
                next-point
                depth
                candidate-regs
                vars
                0
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                weights)
                [(CompilerRegLoopSplitCandidate.NoCandidate)
                  (compiler-reg-loop-split-select-blocks
                    type-segment-bases
                    abi
                    func
                    (box-get rest)
                    liveness
                    live-blocks
                    depths
                    next-point
                    (+ block-index 1)
                    vars
                    type-info
                    assignments
                    intervals
                    group-vars
                    parents
                    merged-roots
                    weights)]
                [(CompilerRegLoopSplitCandidate.Candidate
                    stack-var
                    region
                    ty
                    reg
                    copies
                    evicted)
                  (CompilerRegLoopSplitCandidate.Candidate
                    stack-var
                    region
                    ty
                    reg
                    copies
                    evicted)])
              (compiler-reg-loop-split-select-blocks
                type-segment-bases
                abi
                func
                (box-get rest)
                liveness
                live-blocks
                depths
                next-point
                (+ block-index 1)
                vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                weights)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-loop-split-select-blocks-seq
        type-segment-bases
        abi
        func
        seq
        liveness
        live-blocks
        depths
        point
        block-index
        vars
        type-info
        assignments
        intervals
        group-vars
        parents
        merged-roots
        weights)]))

(define (compiler-reg-loop-split-select-blocks-seq
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [seq : CompilerIrBlockSeq]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [depths : (Array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (let
    [i : i64 0]
    [count : i64 (compiler-ir-block-seq-count seq)]
    [out : CompilerRegLoopSplitCandidate
      (CompilerRegLoopSplitCandidate.NoCandidate)]
    [found : bool false]
    [p : i64 point]
    [b : i64 block-index]
    (begin
      (while (and (< i count) (not found))
        (begin
          (match (compiler-ir-block-seq-ref seq i)
            [(CompilerIrBlock.Block label instrs)
              (let
                [next-point : i64
                  (+ p (* 2 (compiler-ir-instr-seq-count instrs)))]
                [depth : i64
                  (if (< b (array-length depths))
                    (array-ref depths b)
                    0)]
                [candidate-regs : CompilerRegIdList
                  (compiler-reg-loop-split-candidate-regs
                    (not
                      (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
                    (compiler-reg-loop-split-region-rcx-safe?
                      type-segment-bases
                      func
                      p
                      next-point)
                    (compiler-reg-loop-split-region-rdx-safe?
                      type-segment-bases
                      func
                      p
                      next-point))]
                (begin
                  (if (and
                    (< b (array-length live-blocks))
                    (> depth 0)
                    (compiler-reg-loop-split-succs-has-backedge?
                      liveness
                      b
                      (compiler-reg-live-block-succs (array-ref live-blocks b))))
                    (match (compiler-reg-loop-split-select-var
                      abi
                      func
                      liveness
                      label
                      (array-ref live-blocks b)
                      instrs
                      p
                      next-point
                      depth
                      candidate-regs
                      vars
                      0
                      type-info
                      assignments
                      intervals
                      group-vars
                      parents
                      merged-roots
                      weights)
                      [(CompilerRegLoopSplitCandidate.NoCandidate) unit]
                      [(CompilerRegLoopSplitCandidate.Candidate
                          stack-var
                          region
                          ty
                          reg
                          copies
                          evicted)
                        (begin
                          (set!
                            out
                            (CompilerRegLoopSplitCandidate.Candidate
                              stack-var
                              region
                              ty
                              reg
                              copies
                              evicted))
                          (set! found true))])
                    unit)
                  (set! p next-point)))])
          (set! b (+ b 1))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-loop-split-apply-candidate
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [stack-var : i64]
  [region-labels : CompilerRegLabelList]
  [ty : AstType]
  [reg : i64]
  [copies : CompilerRegEdgeCopySeq]
  [evicted-var : i64]
  [parents : (Array i64)]) : CompilerRegCallSaveRewrite
  (let
    [remap : (Array i64) (compiler-reg-caller-save-remap vars)]
    ;; The region is the candidate's block-label list (one label for the
    ;; single-block paths -- byte-identical to the prior single-label map -- or the
    ;; whole natural loop for the multi-block phi-carried homing).
    [region-map : reg_label_i64_map.Map
      (compiler-reg-region-label-map region-labels)]
    ;; The new region-resident var (id `vars`) takes the register. When this
    ;; candidate evicted a lower-weight var to free that register, also override
    ;; the evicted var to Spill -- assignment-list-merge -> assignment-insert
    ;; overwrites its prior Register home, and a whole-var spill is always sound.
    ;; (The offset is a placeholder; color-stack-slots re-colors all spills.)
    [extra-assignments : CompilerRegAssignmentList
      (if (>= evicted-var 0)
        (compiler-reg-assignment-cons
          (CompilerRegAssignment vars (CompilerRegLocation.Register reg))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment
              evicted-var
              (CompilerRegLocation.Spill
                (compiler-reg-stack-slot-offset evicted-var)))
            CompilerRegAssignmentList.Nil))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment vars (CompilerRegLocation.Register reg))
          CompilerRegAssignmentList.Nil))]
    (begin
      (array-set! remap stack-var vars)
      ;; Home the whole coalesced group (move-related members of `stack-var`), not
      ;; just the root, so a redefined carried value's every alias inside the region
      ;; resolves to the homed register. For a singleton root this re-sets exactly
      ;; remap[stack-var] = vars (identical to the root-only remap above).
      (compiler-reg-loop-split-remap-coalesced-group!
        remap
        parents
        stack-var
        vars)
      (match (compiler-reg-edge-copy-apply
        (compiler-reg-loop-split-region-remap-blocks blocks region-map remap)
        copies)
        [(CompilerRegEdgeCopyRewrite.Rewrite rewritten-blocks)
          (CompilerRegCallSaveRewrite.Rewrite
            rewritten-blocks
            vars
            (+ vars 1)
            extra-assignments
            (compiler-reg-var-type-cons
              (CompilerRegVarType vars ty)
              CompilerRegVarTypeList.Nil))]
        [(CompilerRegEdgeCopyRewrite.Refused _)
          (compiler-reg-loop-split-noop blocks vars)]))))

;; ===========================================================================
;; SplitKit step 2 -- MULTI-BLOCK phi-carried homing (the dominant 607 population).
;;
;; A real SSA loop-carried value is a phi at the loop HEADER taking the initial
;; value from the preheader edge and the updated value from the back-edge; the body
;; that updates it is a SEPARATE block. So it is a MULTI-BLOCK region (header +
;; body), which the single-block self-loop path (try-var) rejects. Here we home the
;; whole coalesce group across the natural loop: the back-edge is INTERNAL to the
;; region (the carry stays in the homed register with NO per-iteration copy), the
;; preheader edge gets the INTO copy, and live exit edges get the OUT copy (or the
;; plan is refused on a critical edge). The phi becomes `R = phi [R,..],[R,..]`
;; (an identity whose per-edge lowering is a self-move) once every group member --
;; result, back-edge input, preheader input -- is remapped to R; the
;; phi-correctness gate (every header-phi input is in the group) guarantees that,
;; so the INTO copy cannot race a real phi-lowering move.
;;
;; BOUNDED to a 2-block natural loop (header H + single body B = H+1) where B is
;; entered ONLY from H (pred-count 1): a clean single-entry loop whose only external
;; entry is H's preheader edge, so soundness matches the single-block case. Wider
;; natural-loop bodies (>2 blocks) are the next slice.
;; ===========================================================================
;; Start point (doubled instruction index, matching select-blocks) of each block;
;; length n+1 so points[n] is the end point of the last block.
(define (compiler-reg-loop-phi-mb-block-points
  [block-array : (Array CompilerIrBlock)]) : (Array i64)
  (let
    [n : i64 (array-length block-array)]
    [points : (Array i64) (array.make-array i64 (+ n 1))]
    [i : i64 0]
    [acc : i64 0]
    (begin
      (while (< i n)
        (begin
          (array-set! points i acc)
          (set!
            acc
            (+
              acc
              (match (array-ref block-array i)
                [(CompilerIrBlock.Block _ instrs)
                  (* 2 (compiler-ir-instr-seq-count instrs))])))
          (set! i (+ i 1))))
      (array-set! points n acc)
      points)))

(define (compiler-reg-loop-phi-mb-region-labels
  [block-array : (Array CompilerIrBlock)]
  [idx : i64]
  [end-idx : i64]) : CompilerRegLabelList
  (if (or (> idx end-idx) (>= idx (array-length block-array)))
    CompilerRegLabelList.Nil
    (CompilerRegLabelList.Cons
      (match (array-ref block-array idx)
        [(CompilerIrBlock.Block label _) label])
      (box
        (compiler-reg-loop-phi-mb-region-labels block-array (+ idx 1) end-idx)))))

;; Any call/syscall in region blocks [s..e]? (caller-saved candidates are only safe
;; when none clobbers them across the loop.)
(define (compiler-reg-loop-phi-mb-region-has-call?
  [block-array : (Array CompilerIrBlock)]
  [s : i64]
  [e : i64]) : bool
  (if (or (> s e) (>= s (array-length block-array)))
    false
    (or
      (match (array-ref block-array s)
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-seq-has-call-or-syscall? instrs)])
      (compiler-reg-loop-phi-mb-region-has-call? block-array (+ s 1) e))))

;; Sum group mentions across region blocks [s..e] (hot-benefit input).
(define (compiler-reg-loop-phi-mb-region-mentions
  [block-array : (Array CompilerIrBlock)]
  [s : i64]
  [e : i64]
  [members : CompilerLiveI64Set]) : i64
  (if (or (> s e) (>= s (array-length block-array)))
    0
    (+
      (match (array-ref block-array s)
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-mention-count-group instrs members)])
      (compiler-reg-loop-phi-mb-region-mentions block-array (+ s 1) e members))))

;; Try to home coalesce-root `var`'s phi-carried group across the 2-block region.
(define (compiler-reg-loop-phi-mb-try-var
  [_func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [block-array : (Array CompilerIrBlock)]
  [h : i64]
  [end-idx : i64]
  [header-instrs : CompilerIrInstrSeq]
  [region-labels : CompilerRegLabelList]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdList]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (if (and
    (compiler-reg-loop-split-coalesce-root? parents var)
    (compiler-reg-loop-split-phi-carried-group? header-instrs parents var)
    (compiler-reg-interval-index-var-has-segments? intervals var))
    (match (compiler-reg-assignment-lookup assignments var)
      [(CompilerRegMaybeLocation.Some location)
        (match location
          [(CompilerRegLocation.Spill _)
            (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
              [(CompilerRegMaybeType.Some ty)
                (let
                  [members : CompilerLiveI64Set
                    (compiler-reg-loop-split-group-member-set parents var vars)]
                  [mentions : i64
                    (compiler-reg-loop-phi-mb-region-mentions
                      block-array
                      h
                      end-idx
                      members)]
                  [region-intervals : CompilerRegIntervalSeq
                    (compiler-reg-loop-split-region-interval
                      vars
                      region-start
                      region-end)]
                  (match (compiler-reg-edge-copy-plan-for-region-group-with-liveness
                    liveness
                    region-labels
                    var
                    vars
                    ty
                    members)
                    [(CompilerRegEdgeCopyPlan.Plan copies)
                      (if (and
                        ;; INTO present + non-refused => every live exit edge already
                        ;; carries its OUT write-back (the planner refuses otherwise),
                        ;; so this is the sufficient soundness witness; not-live-out
                        ;; carried values correctly need no OUT copy.
                        (compiler-reg-loop-split-direction-present? copies true)
                        (compiler-reg-loop-split-hot-benefit?
                          mentions
                          depth
                          (compiler-reg-edge-copy-list-count copies)))
                        (match (compiler-reg-loop-split-first-register
                          candidate-regs
                          assignments
                          intervals
                          region-intervals
                          var)
                          [(CompilerRegMaybeId.Some reg)
                            (CompilerRegLoopSplitCandidate.Candidate
                              var
                              region-labels
                              ty
                              reg
                              copies
                              (- 0 1))]
                          [(CompilerRegMaybeId.No)
                            (match (compiler-reg-loop-split-first-register-evict
                              candidate-regs
                              assignments
                              intervals
                              region-intervals
                              var
                              weights
                              (if (< var (array-length weights))
                                (array-ref weights var)
                                0))
                              [(CompilerRegLoopSplitEvict ereg evar)
                                (CompilerRegLoopSplitCandidate.Candidate
                                  var
                                  region-labels
                                  ty
                                  ereg
                                  copies
                                  evar)]
                              [(CompilerRegLoopSplitEvictNone)
                                (CompilerRegLoopSplitCandidate.NoCandidate)])])
                        (CompilerRegLoopSplitCandidate.NoCandidate))]
                    [(CompilerRegEdgeCopyPlan.Refused _)
                      (CompilerRegLoopSplitCandidate.NoCandidate)]))]
              [(CompilerRegMaybeType.No)
                (CompilerRegLoopSplitCandidate.NoCandidate)])]
          [_ (CompilerRegLoopSplitCandidate.NoCandidate)])]
      [(CompilerRegMaybeLocation.No)
        (CompilerRegLoopSplitCandidate.NoCandidate)])
    (CompilerRegLoopSplitCandidate.NoCandidate)))

(define (compiler-reg-loop-phi-mb-select-var
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [block-array : (Array CompilerIrBlock)]
  [h : i64]
  [end-idx : i64]
  [header-instrs : CompilerIrInstrSeq]
  [region-labels : CompilerRegLabelList]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdList]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (if (>= var vars)
    (CompilerRegLoopSplitCandidate.NoCandidate)
    (match (compiler-reg-loop-phi-mb-try-var
      func
      liveness
      block-array
      h
      end-idx
      header-instrs
      region-labels
      region-start
      region-end
      depth
      candidate-regs
      vars
      var
      type-info
      assignments
      intervals
      group-vars
      parents
      weights)
      [(CompilerRegLoopSplitCandidate.NoCandidate)
        (compiler-reg-loop-phi-mb-select-var
          func
          liveness
          block-array
          h
          end-idx
          header-instrs
          region-labels
          region-start
          region-end
          depth
          candidate-regs
          vars
          (+ var 1)
          type-info
          assignments
          intervals
          group-vars
          parents
          weights)]
      [(CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)
        (CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)])))

;; Scan block indices for a 2-block natural-loop header (loop-ends[h]==h+1) whose
;; body B=h+1 is entered ONLY from h (pred-count 1) and at loop depth>0, then try
;; to home one of its phi-carried groups.
(define (compiler-reg-loop-phi-mb-select-headers
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [block-array : (Array CompilerIrBlock)]
  [points : (Array i64)]
  [loop-ends : (Array i64)]
  [pred-counts : (Array i64)]
  [depths : (Array i64)]
  [h : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (if (>= h (array-length block-array))
    (CompilerRegLoopSplitCandidate.NoCandidate)
    (let
      [end-idx : i64
        (if (< h (array-length loop-ends))
          (array-ref loop-ends h)
          (- 0 1))]
      [body : i64 (+ h 1)]
      (if (and
        (= end-idx body)
        (< body (array-length block-array))
        (< h (array-length depths))
        (> (array-ref depths h) 0)
        (< body (array-length pred-counts))
        (= (array-ref pred-counts body) 1))
        (let
          [region-start : i64 (array-ref points h)]
          [region-end : i64 (array-ref points (+ end-idx 1))]
          [candidate-regs : CompilerRegIdList
            (compiler-reg-loop-split-candidate-regs
              (not
                (compiler-reg-loop-phi-mb-region-has-call?
                  block-array
                  h
                  end-idx))
              (compiler-reg-loop-split-region-rcx-safe?
                type-segment-bases
                func
                region-start
                region-end)
              (compiler-reg-loop-split-region-rdx-safe?
                type-segment-bases
                func
                region-start
                region-end))]
          (match (compiler-reg-loop-phi-mb-select-var
            func
            liveness
            block-array
            h
            end-idx
            (match (array-ref block-array h)
              [(CompilerIrBlock.Block _ instrs) instrs])
            (compiler-reg-loop-phi-mb-region-labels block-array h end-idx)
            region-start
            region-end
            (array-ref depths h)
            candidate-regs
            vars
            0
            type-info
            assignments
            intervals
            group-vars
            parents
            weights)
            [(CompilerRegLoopSplitCandidate.NoCandidate)
              (compiler-reg-loop-phi-mb-select-headers
                type-segment-bases
                func
                liveness
                block-array
                points
                loop-ends
                pred-counts
                depths
                (+ h 1)
                vars
                type-info
                assignments
                intervals
                group-vars
                parents
                weights)]
            [(CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)
              (CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)]))
        (compiler-reg-loop-phi-mb-select-headers
          type-segment-bases
          func
          liveness
          block-array
          points
          loop-ends
          pred-counts
          depths
          (+ h 1)
          vars
          type-info
          assignments
          intervals
          group-vars
          parents
          weights)))))

;; Top-level multi-block phi selector: build block array / points / loop-ends /
;; pred-counts and scan headers. Returns a candidate (with multi-block region
;; labels) or NoCandidate. Called as the fallback after the single-block
;; select-blocks finds nothing, so the single-block paths stay byte-identical.
(define (compiler-reg-loop-phi-mb-select
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [depths : (Array i64)]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [weights : (Array i64)]) : CompilerRegLoopSplitCandidate
  (let
    [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
    [block-array : (Array CompilerIrBlock) (struct-get seq slots)]
    [count : i64 (array-length block-array)]
    (if (<= count 1)
      (CompilerRegLoopSplitCandidate.NoCandidate)
      (compiler-reg-loop-phi-mb-select-headers
        type-segment-bases
        func
        liveness
        block-array
        (compiler-reg-loop-phi-mb-block-points block-array)
        (compiler-reg-preheader-loop-ends-seq seq count)
        (compiler-reg-edge-copy-pred-counts liveness live-blocks)
        depths
        0
        vars
        type-info
        assignments
        intervals
        group-vars
        parents
        weights))))

;; A leaf can still exhaust the caller-saved bank inside a hot loop even when a
;; caller-saved register is free before or after that loop. The whole-range
;; greedy then gives a read-only loop invariant a callee-saved home and pays a
;; push/pop on every function invocation. Split that range at the natural-loop
;; boundary when all of the following are proven:
;;
;;   * the function has no kind-0 caller-clobber point;
;;   * the invariant is the sole user of its callee-saved physical register;
;;   * one caller-saved register is free over the loop and a different one is
;;     free over every live segment outside the loop;
;;   * the edge-copy planner needs exactly one INTO move and no write-back.
;;
;; The last gate makes the static instruction-count delta strictly profitable:
;; one boundary move replaces the callee-save push+pop pair. No spill or
;; eviction is admitted. The hashmap get-value-or shape is the motivating case:
;; its slots pointer moves from a pre-loop volatile register into the %r8 that
;; becomes dead after the hash multiply.
(define (compiler-reg-leaf-csr-fuse-free-branch-var
  [slots : (Array CompilerIrInstr)]
  [index : i64]) : i64
  (if (<= index 0)
    (- 0 1)
    (match (array-ref slots index)
      [(CompilerIrInstr.Branch cond _ _)
        (match cond
          [(CompilerIrValue.Var var)
            (match (array-ref slots (- index 1))
              [(CompilerIrInstr.BinOp dst op _ _ ty)
                (if (and
                  (= dst var)
                  (compiler-reg-scratch-compare-op? op)
                  (not (compiler-reg-float-type? ty)))
                  var
                  (- 0 1))]
              [(CompilerIrInstr.UnOp dst (CompilerIrUnOp.Not) _ (AstType.Bool))
                (if (= dst var)
                  var
                  (- 0 1))]
              [_ (- 0 1)])]
          [_ (- 0 1)])]
      [_ (- 0 1)])))

(define (compiler-reg-leaf-csr-fuse-facts-seq
  [instrs : CompilerIrInstrSeq]
  [var : i64]) : CompilerRegLeafCsrFuseFacts
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [uses : i64 0]
    [free-branches : i64 0]
    (begin
      (while (< index count)
        (begin
          (if (compiler-live-set-contains?
            (compiler-live-instr-uses (array-ref slots index))
            var)
            (set! uses (+ uses 1))
            unit)
          (if (= (compiler-reg-leaf-csr-fuse-free-branch-var slots index) var)
            (set! free-branches (+ free-branches 1))
            unit)
          (set! index (+ index 1))))
      (CompilerRegLeafCsrFuseFacts uses free-branches))))

(define (compiler-reg-leaf-csr-fuse-facts-blocks
  [blocks : CompilerIrBlockList]
  [var : i64]
  [uses : i64]
  [free-branches : i64]) : CompilerRegLeafCsrFuseFacts
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerRegLeafCsrFuseFacts uses free-branches)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [facts : CompilerRegLeafCsrFuseFacts
              (compiler-reg-leaf-csr-fuse-facts-seq instrs var)]
            (compiler-reg-leaf-csr-fuse-facts-blocks
              (box-get rest)
              var
              (+ uses (struct-get facts uses))
              (+ free-branches (struct-get facts free-branches))))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-leaf-csr-fuse-facts-block-seq seq var uses free-branches)]))

(define (compiler-reg-leaf-csr-fuse-facts-block-seq
  [blocks : CompilerIrBlockSeq]
  [var : i64]
  [uses : i64]
  [free-branches : i64]) : CompilerRegLeafCsrFuseFacts
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [total-uses : i64 uses]
    [total-free : i64 free-branches]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-block-seq-ref blocks index)
            [(CompilerIrBlock.Block _ instrs)
              (let
                [facts : CompilerRegLeafCsrFuseFacts
                  (compiler-reg-leaf-csr-fuse-facts-seq instrs var)]
                (begin
                  (set! total-uses (+ total-uses (struct-get facts uses)))
                  (set!
                    total-free
                    (+ total-free (struct-get facts free-branches)))))])
          (set! index (+ index 1))))
      (CompilerRegLeafCsrFuseFacts total-uses total-free))))

(define (compiler-reg-leaf-csr-fuse-safe?
  [func : CompilerIrFunction]
  [var : i64]) : bool
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [facts : CompilerRegLeafCsrFuseFacts
          (compiler-reg-leaf-csr-fuse-facts-blocks blocks var 0 0)]
        (and
          (> (struct-get facts uses) 0)
          (= (struct-get facts uses) (struct-get facts free-branches))))]))

(define (compiler-reg-leaf-csr-location-conflicts-region?
  [func : CompilerIrFunction]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [assigned-var : i64 (struct-get item var)]
        [assigned-location : CompilerRegLocation (struct-get item location)]
        (if (or
          (= assigned-var ignore-var)
          (not (compiler-reg-location-overlaps? assigned-location location))
          (compiler-reg-leaf-csr-fuse-safe? func assigned-var))
          (compiler-reg-leaf-csr-location-conflicts-region?
            func
            (box-get rest)
            intervals
            region-intervals
            ignore-var
            location)
          (if (compiler-reg-loop-split-var-overlaps-region?
            intervals
            assigned-var
            region-intervals)
            true
            (compiler-reg-leaf-csr-location-conflicts-region?
              func
              (box-get rest)
              intervals
              region-intervals
              ignore-var
              location))))]))

(define (compiler-reg-leaf-csr-first-inner-register
  [func : CompilerIrFunction]
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]) : CompilerRegMaybeId
  (match regs
    [(CompilerRegIdList.Nil) CompilerRegMaybeId.No]
    [(CompilerRegIdList.Cons reg rest)
      (if (compiler-reg-leaf-csr-location-conflicts-region?
        func
        assignments
        intervals
        region-intervals
        ignore-var
        (CompilerRegLocation.Register reg))
        (compiler-reg-leaf-csr-first-inner-register
          func
          (box-get rest)
          assignments
          intervals
          region-intervals
          ignore-var)
        (CompilerRegMaybeId.Some reg))]))

(define (compiler-reg-leaf-csr-filter-caller-regs
  [regs : CompilerRegIdList]
  [rax-safe? : bool]
  [rcx-safe? : bool]
  [rdx-safe? : bool]) : CompilerRegIdList
  (match regs
    [(CompilerRegIdList.Nil) CompilerRegIdList.Nil]
    [(CompilerRegIdList.Cons reg rest)
      (let
        [tail : CompilerRegIdList
          (compiler-reg-leaf-csr-filter-caller-regs
            (box-get rest)
            rax-safe?
            rcx-safe?
            rdx-safe?)]
        (if (or
          (and (= reg compiler-reg-id-rax) (not rax-safe?))
          (and (= reg compiler-reg-id-rcx) (not rcx-safe?))
          (and (= reg compiler-reg-id-rdx) (not rdx-safe?)))
          tail
          (compiler-reg-id-cons reg tail)))]))

(define (compiler-reg-leaf-csr-caller-regs
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [start : i64]
  [end : i64]) : CompilerRegIdList
  (compiler-reg-leaf-csr-filter-caller-regs
    (compiler-reg-caller-saved-integer-registers-from-abi abi 0)
    (not
      (compiler-reg-loop-split-region-crosses-kind?
        type-segment-bases
        func
        1
        start
        end))
    (compiler-reg-loop-split-region-rcx-safe? type-segment-bases func start end)
    (compiler-reg-loop-split-region-rdx-safe? type-segment-bases func start end)))

(define (compiler-reg-leaf-csr-region-defines?
  [live-blocks : (Array CompilerLiveBlock)]
  [start-index : i64]
  [end-index : i64]
  [var : i64]) : bool
  (let
    [index : i64 start-index]
    [found : bool false]
    (begin
      (while (and
        (<= index end-index)
        (< index (array-length live-blocks))
        (not found))
        (begin
          (if (compiler-live-set-contains?
            (compiler-live-block-defs (array-ref live-blocks index))
            var)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-leaf-csr-region-mentions
  [blocks : (Array CompilerIrBlock)]
  [start-index : i64]
  [end-index : i64]
  [var : i64]) : i64
  (if (or (> start-index end-index) (>= start-index (array-length blocks)))
    0
    (+
      (match (array-ref blocks start-index)
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-mention-count instrs var)])
      (compiler-reg-leaf-csr-region-mentions
        blocks
        (+ start-index 1)
        end-index
        var))))

(define (compiler-reg-leaf-csr-location-conflicts-outer-segments?
  [segments : CompilerRegIntervalSeq]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-start : i64]
  [region-end : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [slots : (Array CompilerRegInterval) (struct-get segments slots)]
    [count : i64 (struct-get segments len)]
    [index : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< index count) (not conflict))
        (begin
          (let
            [interval : CompilerRegInterval (array-ref slots index)]
            [start : i64 (struct-get interval start)]
            [end : i64 (struct-get interval end)]
            [before? : bool
              (and
                (< start region-start)
                (compiler-reg-loop-split-location-conflicts-region?
                  assignments
                  intervals
                  (compiler-reg-loop-split-region-interval
                    ignore-var
                    start
                    (if (< end region-start)
                      end
                      region-start))
                  ignore-var
                  location))]
            [after? : bool
              (and
                (> end region-end)
                (compiler-reg-loop-split-location-conflicts-region?
                  assignments
                  intervals
                  (compiler-reg-loop-split-region-interval
                    ignore-var
                    (if (> start region-end)
                      start
                      region-end)
                    end)
                  ignore-var
                  location))]
            (if (or before? after?)
              (set! conflict true)
              unit))
          (set! index (+ index 1))))
      conflict)))

(define (compiler-reg-leaf-csr-location-conflicts-outer?
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-start : i64]
  [region-end : i64]
  [var : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [segments : (Array CompilerRegIntervalSeq) (struct-get intervals segments)]
    [var-segments : CompilerRegIntervalSeq
      (if (and (>= var 0) (< var (array-length segments)))
        (array-ref segments var)
        (compiler-reg-interval-seq-empty))]
    (if (not (compiler-reg-interval-seq-empty? var-segments))
      (compiler-reg-leaf-csr-location-conflicts-outer-segments?
        var-segments
        assignments
        intervals
        region-start
        region-end
        var
        location)
      (match (compiler-reg-interval-index-lookup intervals var)
        [(CompilerRegMaybeInterval.Some interval)
          (compiler-reg-leaf-csr-location-conflicts-outer-segments?
            (compiler-reg-interval-seq-prepend
              interval
              (compiler-reg-interval-seq-empty))
            assignments
            intervals
            region-start
            region-end
            var
            location)]
        [(CompilerRegMaybeInterval.No) true]))))

(define (compiler-reg-leaf-csr-first-outer-register
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [region-start : i64]
  [region-end : i64]
  [var : i64]
  [inner-reg : i64]) : CompilerRegMaybeId
  (match regs
    [(CompilerRegIdList.Nil) CompilerRegMaybeId.No]
    [(CompilerRegIdList.Cons reg rest)
      (if (or
        (compiler-reg-registers-overlap? reg inner-reg)
        (compiler-reg-leaf-csr-location-conflicts-outer?
          assignments
          intervals
          region-start
          region-end
          var
          (CompilerRegLocation.Register reg)))
        (compiler-reg-leaf-csr-first-outer-register
          (box-get rest)
          assignments
          intervals
          region-start
          region-end
          var
          inner-reg)
        (CompilerRegMaybeId.Some reg))]))

(define (compiler-reg-leaf-csr-try-var
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [block-array : (Array CompilerIrBlock)]
  [region-labels : CompilerRegLabelList]
  [region-start-index : i64]
  [region-end-index : i64]
  [region-start : i64]
  [region-end : i64]
  [vars : i64]
  [var : i64]
  [param-vars : CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [inner-regs : CompilerRegIdList]
  [outer-regs : CompilerRegIdList]
  [callee-regs : CompilerRegIdList]) : CompilerRegLeafCsrSplitCandidate
  (if (or
    (compiler-live-set-contains? param-vars var)
    (compiler-live-set-contains? group-vars var)
    (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)
    (>= region-start-index (array-length live-blocks))
    (not
      (compiler-live-set-contains?
        (compiler-live-block-live-in (array-ref live-blocks region-start-index))
        var))
    (compiler-reg-leaf-csr-region-defines?
      live-blocks
      region-start-index
      region-end-index
      var)
    (<=
      (compiler-reg-leaf-csr-region-mentions
        block-array
        region-start-index
        region-end-index
        var)
      0))
    CompilerRegLeafCsrSplitCandidate.NoCandidate
    (match (compiler-reg-assignment-lookup assignments var)
      [(CompilerRegMaybeLocation.Some location)
        (match location
          [(CompilerRegLocation.Register csr)
            (if (and
              (compiler-reg-id-list-contains? callee-regs csr)
              (=
                (compiler-reg-assignments-register-use-count assignments csr)
                1))
              (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
                [(CompilerRegMaybeType.Some ty)
                  (let
                    [region-intervals : CompilerRegIntervalSeq
                      (compiler-reg-loop-split-region-interval
                        vars
                        region-start
                        region-end)]
                    (match (compiler-reg-leaf-csr-first-inner-register
                      func
                      inner-regs
                      assignments
                      intervals
                      region-intervals
                      var)
                      [(CompilerRegMaybeId.Some inner-reg)
                        (let
                          [fused-occupant : i64
                            (compiler-reg-loop-split-region-occupant
                              assignments
                              intervals
                              region-intervals
                              var
                              (CompilerRegLocation.Register inner-reg)
                              (- 0 2))]
                          [outer : CompilerRegMaybeId
                            (compiler-reg-leaf-csr-first-outer-register
                              outer-regs
                              assignments
                              intervals
                              region-start
                              region-end
                              var
                              inner-reg)]
                          (if (= fused-occupant (- 0 1))
                            CompilerRegLeafCsrSplitCandidate.NoCandidate
                            (match outer
                              [(CompilerRegMaybeId.Some outer-reg)
                                (match (compiler-reg-edge-copy-plan-for-region-with-liveness
                                  liveness
                                  region-labels
                                  var
                                  (+ vars 1)
                                  ty)
                                  [(CompilerRegEdgeCopyPlan.Plan copies)
                                    (if (and
                                      (=
                                        (compiler-reg-edge-copy-list-count
                                          copies)
                                        1)
                                      (compiler-reg-loop-split-direction-present?
                                        copies
                                        true))
                                      (CompilerRegLeafCsrSplitCandidate.Candidate
                                        var
                                        region-labels
                                        ty
                                        inner-reg
                                        outer-reg
                                        copies
                                        fused-occupant)
                                      CompilerRegLeafCsrSplitCandidate.NoCandidate)]
                                  [(CompilerRegEdgeCopyPlan.Refused _)
                                    CompilerRegLeafCsrSplitCandidate.NoCandidate])]
                              [(CompilerRegMaybeId.No)
                                CompilerRegLeafCsrSplitCandidate.NoCandidate])))]
                      [(CompilerRegMaybeId.No)
                        CompilerRegLeafCsrSplitCandidate.NoCandidate]))]
                [(CompilerRegMaybeType.No)
                  CompilerRegLeafCsrSplitCandidate.NoCandidate])
              CompilerRegLeafCsrSplitCandidate.NoCandidate)]
          [_ CompilerRegLeafCsrSplitCandidate.NoCandidate])]
      [(CompilerRegMaybeLocation.No)
        CompilerRegLeafCsrSplitCandidate.NoCandidate])))

(define (compiler-reg-leaf-csr-select-var
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [block-array : (Array CompilerIrBlock)]
  [region-labels : CompilerRegLabelList]
  [region-start-index : i64]
  [region-end-index : i64]
  [region-start : i64]
  [region-end : i64]
  [vars : i64]
  [var : i64]
  [param-vars : CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [inner-regs : CompilerRegIdList]
  [outer-regs : CompilerRegIdList]
  [callee-regs : CompilerRegIdList]) : CompilerRegLeafCsrSplitCandidate
  (if (>= var vars)
    CompilerRegLeafCsrSplitCandidate.NoCandidate
    (match (compiler-reg-leaf-csr-try-var
      func
      liveness
      live-blocks
      block-array
      region-labels
      region-start-index
      region-end-index
      region-start
      region-end
      vars
      var
      param-vars
      type-info
      assignments
      intervals
      group-vars
      parents
      merged-roots
      inner-regs
      outer-regs
      callee-regs)
      [(CompilerRegLeafCsrSplitCandidate.NoCandidate)
        (compiler-reg-leaf-csr-select-var
          func
          liveness
          live-blocks
          block-array
          region-labels
          region-start-index
          region-end-index
          region-start
          region-end
          vars
          (+ var 1)
          param-vars
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          inner-regs
          outer-regs
          callee-regs)]
      [(CompilerRegLeafCsrSplitCandidate.Candidate
          split-var
          labels
          ty
          inner-reg
          outer-reg
          copies
          fused-occupant)
        (CompilerRegLeafCsrSplitCandidate.Candidate
          split-var
          labels
          ty
          inner-reg
          outer-reg
          copies
          fused-occupant)])))

(define (compiler-reg-leaf-csr-select-headers
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [block-array : (Array CompilerIrBlock)]
  [points : (Array i64)]
  [loop-ends : (Array i64)]
  [depths : (Array i64)]
  [header : i64]
  [vars : i64]
  [param-vars : CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [outer-regs : CompilerRegIdList]
  [callee-regs : CompilerRegIdList]) : CompilerRegLeafCsrSplitCandidate
  (if (>= header (array-length block-array))
    CompilerRegLeafCsrSplitCandidate.NoCandidate
    (let
      [end-index : i64
        (if (< header (array-length loop-ends))
          (array-ref loop-ends header)
          (- 0 1))]
      (if (and
        (>= end-index header)
        (< (+ end-index 1) (array-length points))
        (< header (array-length depths))
        (> (array-ref depths header) 0))
        (let
          [region-start : i64 (array-ref points header)]
          [region-end : i64 (array-ref points (+ end-index 1))]
          [inner-regs : CompilerRegIdList
            (compiler-reg-leaf-csr-caller-regs
              type-segment-bases
              abi
              func
              region-start
              region-end)]
          (match (compiler-reg-leaf-csr-select-var
            func
            liveness
            live-blocks
            block-array
            (compiler-reg-loop-phi-mb-region-labels
              block-array
              header
              end-index)
            header
            end-index
            region-start
            region-end
            vars
            0
            param-vars
            type-info
            assignments
            intervals
            group-vars
            parents
            merged-roots
            inner-regs
            outer-regs
            callee-regs)
            [(CompilerRegLeafCsrSplitCandidate.NoCandidate)
              (compiler-reg-leaf-csr-select-headers
                type-segment-bases
                abi
                func
                liveness
                live-blocks
                block-array
                points
                loop-ends
                depths
                (+ header 1)
                vars
                param-vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                outer-regs
                callee-regs)]
            [(CompilerRegLeafCsrSplitCandidate.Candidate
                split-var
                labels
                ty
                inner-reg
                outer-reg
                copies
                fused-occupant)
              (CompilerRegLeafCsrSplitCandidate.Candidate
                split-var
                labels
                ty
                inner-reg
                outer-reg
                copies
                fused-occupant)]))
        (compiler-reg-leaf-csr-select-headers
          type-segment-bases
          abi
          func
          liveness
          live-blocks
          block-array
          points
          loop-ends
          depths
          (+ header 1)
          vars
          param-vars
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          outer-regs
          callee-regs)))))

(define (compiler-reg-leaf-csr-remap-edge-copy
  [copy : CompilerRegEdgeCopy]
  [from-var : i64]
  [to-var : i64]) : CompilerRegEdgeCopy
  (match copy
    [(CompilerRegEdgeCopy.Copy
        from-label
        to-label
        src
        dst
        ty
        direction
        placement)
      (CompilerRegEdgeCopy.Copy
        from-label
        to-label
        (if (= src from-var)
          to-var
          src)
        (if (= dst from-var)
          to-var
          dst)
        ty
        direction
        placement)]))

(define (compiler-reg-leaf-csr-remap-edge-copies
  [copies : CompilerRegEdgeCopySeq]
  [from-var : i64]
  [to-var : i64]) : CompilerRegEdgeCopySeq
  (let
    [source : (Array CompilerRegEdgeCopy) (struct-get copies slots)]
    [count : i64 (struct-get copies len)]
    [out : (Array CompilerRegEdgeCopy)
      (array.make-array
        CompilerRegEdgeCopy
        (if (< count 1)
          1
          count))]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            out
            index
            (compiler-reg-leaf-csr-remap-edge-copy
              (array-ref source index)
              from-var
              to-var))
          (set! index (+ index 1))))
      (CompilerRegEdgeCopySeq out count))))

;; The split boundary must remain a real copy after the fresh allocation pass.
;; A plain Mov is deliberately coalescable, which would reunite the outside and
;; loop pieces and recreate the original whole-function callee-saved range.
;; A same-type Bitcast has identical backend copy semantics, but is not a
;; coalescing candidate.
(define (compiler-reg-leaf-csr-boundary-instr
  [instr : CompilerIrInstr]
  [src-var : i64]
  [dst-var : i64]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (match src
        [(CompilerIrValue.Var found-src)
          (if (and (= dst dst-var) (= found-src src-var))
            (match ty
              [(AstType.I64) (CompilerIrInstr.Bitcast dst src ty ty)]
              [(AstType.U64) (CompilerIrInstr.Bitcast dst src ty ty)]
              [_ (CompilerIrInstr.Cast dst src ty ty)])
            instr)]
        [_ instr])]
    [_ instr]))

(define (compiler-reg-leaf-csr-boundary-instrs
  [instrs : CompilerIrInstrList]
  [src-var : i64]
  [dst-var : i64]) : CompilerIrInstrList
  (match instrs
    [(CompilerIrInstrList.Nil) CompilerIrInstrList.Nil]
    [(CompilerIrInstrList.Cons instr rest)
      (compiler-ir-instr-cons
        (compiler-reg-leaf-csr-boundary-instr instr src-var dst-var)
        (compiler-reg-leaf-csr-boundary-instrs (box-get rest) src-var dst-var))]))

(define (compiler-reg-leaf-csr-boundary-blocks
  [blocks : CompilerIrBlockList]
  [src-var : i64]
  [dst-var : i64]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-ir-block-cons
            (CompilerIrBlock.Block
              label
              (compiler-ir-instr-seq-from-list
                (compiler-reg-leaf-csr-boundary-instrs
                  (compiler-ir-instr-seq-to-list instrs)
                  src-var
                  dst-var)))
            (compiler-reg-leaf-csr-boundary-blocks
              (box-get rest)
              src-var
              dst-var))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [count : i64 (compiler-ir-block-seq-count seq)]
        [slots : (Array CompilerIrBlock)
          (array.make-array CompilerIrBlock count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (match (compiler-ir-block-seq-ref seq index)
                [(CompilerIrBlock.Block label instrs)
                  (array-set!
                    slots
                    index
                    (CompilerIrBlock.Block
                      label
                      (compiler-ir-instr-seq-from-list
                        (compiler-reg-leaf-csr-boundary-instrs
                          (compiler-ir-instr-seq-to-list instrs)
                          src-var
                          dst-var))))])
              (set! index (+ index 1))))
          (CompilerIrBlockList.Array (CompilerIrBlockSeq slots count))))]))

(define (compiler-reg-leaf-csr-apply-candidate
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [stack-var : i64]
  [region-labels : CompilerRegLabelList]
  [ty : AstType]
  [inner-reg : i64]
  [outer-reg : i64]
  [copies : CompilerRegEdgeCopySeq]
  [fused-occupant : i64]) : CompilerRegCallSaveRewrite
  (let
    [outer-var : i64 vars]
    [inner-var : i64 (+ vars 1)]
    [outer-remap : (Array i64) (compiler-reg-caller-save-remap vars)]
    [region-remap : (Array i64) (compiler-reg-caller-save-remap (+ vars 1))]
    [extra-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment
          outer-var
          (CompilerRegLocation.Register outer-reg))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment
            inner-var
            (CompilerRegLocation.Register inner-reg))
          (if (>= fused-occupant 0)
            (compiler-reg-assignment-cons
              (CompilerRegAssignment
                fused-occupant
                (CompilerRegLocation.Register inner-reg))
              CompilerRegAssignmentList.Nil)
            CompilerRegAssignmentList.Nil)))]
    (begin
      (array-set! outer-remap stack-var outer-var)
      (array-set! region-remap outer-var inner-var)
      (match (compiler-reg-edge-copy-apply
        (compiler-reg-loop-split-region-remap-blocks
          (compiler-reg-remap-blocks outer-remap blocks)
          (compiler-reg-region-label-map region-labels)
          region-remap)
        (compiler-reg-leaf-csr-remap-edge-copies copies stack-var outer-var))
        [(CompilerRegEdgeCopyRewrite.Rewrite rewritten-blocks)
          (CompilerRegCallSaveRewrite.Rewrite
            (compiler-reg-leaf-csr-boundary-blocks
              rewritten-blocks
              outer-var
              inner-var)
            vars
            (+ vars 2)
            extra-assignments
            (compiler-reg-var-type-cons
              (CompilerRegVarType outer-var ty)
              (compiler-reg-var-type-cons
                (CompilerRegVarType inner-var ty)
                CompilerRegVarTypeList.Nil)))]
        [(CompilerRegEdgeCopyRewrite.Refused _)
          (compiler-reg-loop-split-noop blocks vars)]))))

(define (compiler-reg-leaf-csr-split-rewrite-one
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (if (or
    (not (compiler-reg-scalar-full-intervals? func))
    (>
      (compiler-live-set-count
        (compiler-reg-clobber-kind-points type-segment-bases func 0))
      0))
    (compiler-reg-loop-split-noop blocks vars)
    (let
      [depths : (Array i64) (compiler-reg-function-loop-depths blocks)]
      (if (not (compiler-reg-depths-have-loop? depths 0))
        (compiler-reg-loop-split-noop blocks vars)
        (let
          [liveness : CompilerFunctionLiveness
            (compiler-live-analyze-function func)]
          [selection : CompilerRegIntervalSelection
            (compiler-reg-live-interval-selection func liveness)]
          [assignments : CompilerRegAssignmentList
            (compiler-reg-plan-assignments plan)]
          [types : CompilerRegVarTypeList
            (compiler-reg-var-types-list type-info)]
          [group-vars : CompilerLiveI64Set
            (compiler-reg-function-group-vars type-segment-bases func types)]
          [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
          [block-array : (Array CompilerIrBlock) (struct-get seq slots)]
          [param-vars : CompilerLiveI64Set
            (match func
              [(CompilerIrFunction.Function _ params _ _ _)
                (compiler-reg-ineligible-params
                  params
                  (compiler-live-set-empty))])]
          [outer-regs : CompilerRegIdList
            (compiler-reg-leaf-csr-caller-regs
              type-segment-bases
              abi
              func
              0
              (array-ref
                (compiler-reg-loop-phi-mb-block-points block-array)
                (array-length block-array)))]
          [callee-regs : CompilerRegIdList
            (compiler-reg-callee-saved-integer-registers-from-abi abi 0)]
          (match selection
            [(CompilerRegIntervalSelection.Selection _ intervals)
              (let
                [coalesce : CompilerRegCoalesceMap
                  (compiler-reg-coalesce-map-build
                    (compiler-reg-function-moves func false)
                    intervals
                    type-info
                    group-vars
                    vars
                    (array.make-array i64 0))]
                [parents : (Array i64) (struct-get coalesce parents)]
                [merged-roots : CompilerLiveI64Set
                  (compiler-reg-coalesce-merged-root-set coalesce)]
                (match liveness
                  [(CompilerFunctionLiveness.Liveness _ live-blocks)
                    (match (compiler-reg-leaf-csr-select-headers
                      type-segment-bases
                      abi
                      func
                      liveness
                      live-blocks
                      block-array
                      (compiler-reg-loop-phi-mb-block-points block-array)
                      (compiler-reg-preheader-loop-ends-seq
                        seq
                        (array-length block-array))
                      depths
                      0
                      vars
                      param-vars
                      type-info
                      assignments
                      intervals
                      group-vars
                      parents
                      merged-roots
                      outer-regs
                      callee-regs)
                      [(CompilerRegLeafCsrSplitCandidate.NoCandidate)
                        (compiler-reg-loop-split-noop blocks vars)]
                      [(CompilerRegLeafCsrSplitCandidate.Candidate
                          stack-var
                          region-labels
                          ty
                          inner-reg
                          outer-reg
                          copies
                          fused-occupant)
                        (compiler-reg-leaf-csr-apply-candidate
                          blocks
                          vars
                          stack-var
                          region-labels
                          ty
                          inner-reg
                          outer-reg
                          copies
                          fused-occupant)])]))]))))))

;; Multi-split: rescue EVERY profitable spilled loop-carried var, not just the
;; first. Each split rewrites the IR (region uses -> a new register-resident var
;; SV + edge copies at the region boundary) and merges SV's register assignment
;; into `plan`; the next pass recomputes liveness/intervals on the rewritten
;; blocks, so its conflict check (loop-split-first-register / location-conflicts-
;; region?) already sees every prior split's SV occupying its register across its
;; region and avoids it -- which is exactly what makes picking the FINAL (not
;; re-allocated) registers sound. The region remap also stops the same var being
;; re-selected for the same region, so it converges; fuel (the integer register
;; count) bounds it. With a single candidate this is bit-identical to the old
;; one-shot behaviour (merging additions with the empty tail is the identity).
(define (compiler-reg-depths-have-loop? [depths : (Array i64)] [index : i64]) : bool
  (if (>= index (array-length depths))
    false
    (if (> (array-ref depths index) 0)
      true
      (compiler-reg-depths-have-loop? depths (+ index 1)))))

(define (compiler-reg-loop-split-rewrite-one
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegLoopSplitRewriteResult
  (if (not (compiler-reg-scalar-full-intervals? func))
    (CompilerRegLoopSplitRewriteResult.Result
      (compiler-reg-loop-split-noop blocks vars)
      (compiler-ir-label-none))
    (let
      [depths : (Array i64) (compiler-reg-function-loop-depths blocks)]
      ;; Every candidate class (single-block self-loop/read-only, single-block
      ;; phi, multi-block phi-carried) and the refused-preheader splice lives
      ;; inside a natural loop. A function with no loop-depth above zero can
      ;; produce none of them, so skip the liveness fixpoint, interval build,
      ;; and coalesce map entirely for loop-free functions.
      (if (not (compiler-reg-depths-have-loop? depths 0))
        (CompilerRegLoopSplitRewriteResult.Result
          (compiler-reg-loop-split-noop blocks vars)
          (compiler-ir-label-none))
        (let
          [liveness-handle : CompilerRegLivenessHandle
            (compiler-reg-liveness-handle-make func false)]
          (compiler-reg-loop-split-rewrite-fueled
            type-segment-bases
            abi
            func
            liveness-handle
            blocks
            vars
            type-info
            plan
            depths
            (compiler-reg-callee-saved-integer-register-count-for-abi abi)))))))

(define (compiler-reg-loop-split-rewrite-fueled
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [liveness-handle : CompilerRegLivenessHandle]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]
  [depths : (Array i64)]
  [fuel : i64]) : CompilerRegLoopSplitRewriteResult
  (if (<= fuel 0)
    (CompilerRegLoopSplitRewriteResult.Result
      (compiler-reg-loop-split-noop blocks vars)
      (compiler-ir-label-none))
    (let
      [liveness : CompilerFunctionLiveness
        (struct-get liveness-handle baseline)]
      [selection : CompilerRegIntervalSelection
        (compiler-reg-live-interval-selection func liveness)]
      [types : CompilerRegVarTypeList (compiler-reg-var-types-list type-info)]
      [assignments : CompilerRegAssignmentList
        (compiler-reg-plan-assignments plan)]
      [group-vars : CompilerLiveI64Set
        (compiler-reg-function-group-vars type-segment-bases func types)]
      (match selection
        [(CompilerRegIntervalSelection.Selection _ intervals)
          (let
            [coalesce : CompilerRegCoalesceMap
              (compiler-reg-coalesce-map-build
                (compiler-reg-function-moves func false)
                intervals
                type-info
                group-vars
                vars
                (array.make-array i64 0))]
            [parents : (Array i64) (struct-get coalesce parents)]
            [merged-roots : CompilerLiveI64Set
              (compiler-reg-coalesce-merged-root-set coalesce)]
            (match liveness
              [(CompilerFunctionLiveness.Liveness _ live-blocks)
                (match (match (compiler-reg-loop-split-select-blocks
                  type-segment-bases
                  abi
                  func
                  blocks
                  liveness
                  live-blocks
                  depths
                  0
                  0
                  vars
                  type-info
                  assignments
                  intervals
                  group-vars
                  parents
                  merged-roots
                  (compiler-reg-function-spill-weights func))
                  ;; Step-2 fallback: when the single-block paths (read-only /
                  ;; non-phi self-loop / single-block phi) find nothing, try the
                  ;; MULTI-BLOCK phi-carried homing (the dominant 607 population).
                  ;; As a fallback it leaves every single-block decision -- and so
                  ;; all non-phi / read-only codegen -- byte-identical.
                  [(CompilerRegLoopSplitCandidate.NoCandidate)
                    (compiler-reg-loop-phi-mb-select
                      type-segment-bases
                      func
                      blocks
                      liveness
                      live-blocks
                      depths
                      vars
                      type-info
                      assignments
                      intervals
                      group-vars
                      parents
                      (compiler-reg-function-spill-weights func))]
                  [(CompilerRegLoopSplitCandidate.Candidate
                      sv
                      lbls
                      ty
                      reg
                      copies
                      ev)
                    (CompilerRegLoopSplitCandidate.Candidate
                      sv
                      lbls
                      ty
                      reg
                      copies
                      ev)])
                  [(CompilerRegLoopSplitCandidate.NoCandidate)
                    (CompilerRegLoopSplitRewriteResult.Result
                      (compiler-reg-loop-split-noop blocks vars)
                      (compiler-reg-loop-split-refused-select-blocks
                        type-segment-bases
                        func
                        blocks
                        liveness
                        live-blocks
                        depths
                        0
                        0
                        vars
                        type-info
                        assignments
                        intervals
                        group-vars
                        parents
                        merged-roots))]
                  [(CompilerRegLoopSplitCandidate.Candidate
                      stack-var
                      region-label
                      ty
                      reg
                      copies
                      evicted)
                    (let
                      [applied : CompilerRegCallSaveRewrite
                        (compiler-reg-loop-split-apply-candidate
                          blocks
                          vars
                          stack-var
                          region-label
                          ty
                          reg
                          copies
                          evicted
                          parents)]
                      (match applied
                        [(CompilerRegCallSaveRewrite.Rewrite
                            new-blocks
                            _
                            new-vars
                            split-assignments
                            split-types)
                          (match func
                            [(CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                _
                                _)
                              (let
                                [new-func : CompilerIrFunction
                                  (CompilerIrFunction.Function
                                    name
                                    params
                                    ret-ty
                                    new-vars
                                    new-blocks)]
                                [new-plan : CompilerRegPlan
                                  (compiler-reg-plan-with-call-save-rewrite
                                    plan
                                    applied)]
                                [rest : CompilerRegLoopSplitRewriteResult
                                  (compiler-reg-loop-split-rewrite-fueled
                                    type-segment-bases
                                    abi
                                    new-func
                                    (compiler-reg-liveness-handle-make
                                      new-func
                                      false)
                                    new-blocks
                                    new-vars
                                    type-info
                                    new-plan
                                    (compiler-reg-function-loop-depths
                                      new-blocks)
                                    (- fuel 1))]
                                (match rest
                                  [(CompilerRegLoopSplitRewriteResult.Result
                                      rest-rewrite
                                      refused-header)
                                    (match rest-rewrite
                                      [(CompilerRegCallSaveRewrite.Rewrite
                                          final-blocks
                                          _
                                          final-vars
                                          rest-assignments
                                          rest-types)
                                        (CompilerRegLoopSplitRewriteResult.Result
                                          (CompilerRegCallSaveRewrite.Rewrite
                                            final-blocks
                                            vars
                                            final-vars
                                            ;; ROUND ORDER, NOT UNWIND ORDER
                                            ;; (#5927). Each fuel round rewrites
                                            ;; the PREVIOUS round's blocks, so the
                                            ;; rounds are a SEQUENCE of plan edits
                                            ;; and the last edit for a var must
                                            ;; win. This round contributes
                                            ;; `split-assignments`; the deeper
                                            ;; rounds contribute
                                            ;; `rest-assignments`, and merge's
                                            ;; FIRST argument overwrites the
                                            ;; second. Merging this round's edits
                                            ;; last resurrected an assignment a
                                            ;; LATER round had deliberately
                                            ;; overridden: the eviction pick
                                            ;; re-spills the single region
                                            ;; occupant of the register it takes,
                                            ;; and when that occupant is an
                                            ;; earlier round's own region var, the
                                            ;; re-spill was dropped and BOTH region
                                            ;; vars kept the same physical register
                                            ;; across the same loop -- the second
                                            ;; region var's preheader INTO copy
                                            ;; then clobbered the first's only def
                                            ;; (a loop bound reaching the back-edge
                                            ;; compare, silently miscompiled).
                                            ;; Deeper-round edits therefore go in
                                            ;; as `extra` so they win.
                                            (compiler-reg-assignment-list-merge
                                              rest-assignments
                                              split-assignments)
                                            ;; Types stay in unwind order: every
                                            ;; round types exactly one FRESH var
                                            ;; id, so no round ever overrides
                                            ;; another's entry and the merge
                                            ;; direction cannot change the map.
                                            (compiler-reg-var-type-list-merge
                                              split-types
                                              rest-types))
                                          refused-header)])]))])]))])]))]))))

;; ---------------------------------------------------------------------------
;; Scan for a loop block whose region rescue is REFUSED only because of a
;; critical entry edge, yet is otherwise homeable (all gates pass and a register
;; is free over the region). Returns that block's label (the header to splice a
;; preheader before) or "" if none. Mirrors select-blocks/select-var/try-var but
;; (a) does not skip phi-blocks and (b) acts on the EdgeCopyRefused branch.
;; ---------------------------------------------------------------------------
(define (compiler-reg-loop-split-refused-try-var
  [_func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [region-label : i64]
  [block : CompilerLiveBlock]
  [instrs : CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  ;; lint-allow: unused-variable
  [depth : i64]
  [candidate-regs : CompilerRegIdList]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]) : i64
  (let
    ;; SplitKit step 2: phi-carried single-block self-loop refused only by a
    ;; critical ENTRY edge is unblocked by a dedicated preheader, just like the
    ;; read-only case below. Variable-bound loops (no provable >=1 trip) keep the
    ;; zero-trip pre-test, so entry->header is critical; a preheader gives the
    ;; once-per-loop INTO copy a non-critical edge. (Live-out values whose EXIT
    ;; edge is also critical still refuse at plan time -- not a preheader case.)
    [phi-carried? : bool
      (compiler-reg-loop-split-phi-carried-candidate?
        block
        region-label
        instrs
        var
        parents)]
    [members : CompilerLiveI64Set
      (if phi-carried?
        (compiler-reg-loop-split-group-member-set parents var vars)
        (compiler-live-set-empty))]
    (if (if phi-carried?
      (compiler-reg-interval-index-var-has-segments? intervals var)
      (and
        (compiler-live-set-contains? (compiler-live-block-live-in block) var)
        (compiler-live-set-contains? (compiler-live-block-live-out block) var)
        (not (compiler-live-set-contains? (compiler-live-block-defs block) var))
        (compiler-reg-interval-index-var-has-segments? intervals var)
        (not (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var))))
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _)
              (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
                [(CompilerRegMaybeType.Some ty)
                  (let
                    [labels : CompilerRegLabelList
                      (CompilerRegLabelList.Cons
                        region-label
                        (box CompilerRegLabelList.Nil))]
                    [region-intervals : CompilerRegIntervalSeq
                      (compiler-reg-loop-split-region-interval
                        vars
                        region-start
                        region-end)]
                    (match (if phi-carried?
                      (compiler-reg-edge-copy-plan-for-region-group-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty
                        members)
                      (compiler-reg-edge-copy-plan-for-region-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty))
                      ;; A plan (not refused) means the existing rounds already
                      ;; handle this var -- not a preheader case.
                      [(CompilerRegEdgeCopyPlan.Plan _)
                        (compiler-ir-label-none)]
                      ;; Refused = critical entry edge. Homeable iff a register is
                      ;; free over the region; if so a preheader unblocks it.
                      [(CompilerRegEdgeCopyPlan.Refused _)
                        (match (compiler-reg-loop-split-first-register
                          candidate-regs
                          assignments
                          intervals
                          region-intervals
                          var)
                          [(CompilerRegMaybeId.Some _) region-label]
                          [(CompilerRegMaybeId.No) (compiler-ir-label-none)])]))]
                [(CompilerRegMaybeType.No) (compiler-ir-label-none)])]
            [_ (compiler-ir-label-none)])]
        [(CompilerRegMaybeLocation.No) (compiler-ir-label-none)])
      (compiler-ir-label-none))))

(define (compiler-reg-loop-split-refused-select-var
  [func : CompilerIrFunction]
  [liveness : CompilerFunctionLiveness]
  [region-label : i64]
  [block : CompilerLiveBlock]
  [instrs : CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdList]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]) : i64
  (if (>= var vars)
    (compiler-ir-label-none)
    (let
      [r : i64
        (compiler-reg-loop-split-refused-try-var
          func
          liveness
          region-label
          block
          instrs
          region-start
          region-end
          depth
          candidate-regs
          vars
          var
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots)]
      (if (= r (compiler-ir-label-none))
        (compiler-reg-loop-split-refused-select-var
          func
          liveness
          region-label
          block
          instrs
          region-start
          region-end
          depth
          candidate-regs
          vars
          (+ var 1)
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots)
        r))))

(define (compiler-reg-loop-split-refused-select-blocks
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [depths : (Array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) (compiler-ir-label-none)]
    [(CompilerIrBlockList.Cons ir-block rest)
      (match ir-block
        [(CompilerIrBlock.Block label instrs)
          (let
            [next-point : i64
              (+ point (* 2 (compiler-ir-instr-seq-count instrs)))]
            [depth : i64
              (if (< block-index (array-length depths))
                (array-ref depths block-index)
                0)]
            [candidate-regs : CompilerRegIdList
              (compiler-reg-loop-split-candidate-regs
                (not (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
                (compiler-reg-loop-split-region-rcx-safe?
                  type-segment-bases
                  func
                  point
                  next-point)
                (compiler-reg-loop-split-region-rdx-safe?
                  type-segment-bases
                  func
                  point
                  next-point))]
            (if (and
              (< block-index (array-length live-blocks))
              (> depth 0)
              (compiler-reg-loop-split-succs-has-backedge?
                liveness
                block-index
                (compiler-reg-live-block-succs
                  (array-ref live-blocks block-index))))
              (let
                [r : i64
                  (compiler-reg-loop-split-refused-select-var
                    func
                    liveness
                    label
                    (array-ref live-blocks block-index)
                    instrs
                    point
                    next-point
                    depth
                    candidate-regs
                    vars
                    0
                    type-info
                    assignments
                    intervals
                    group-vars
                    parents
                    merged-roots)]
                (if (= r (compiler-ir-label-none))
                  (compiler-reg-loop-split-refused-select-blocks
                    type-segment-bases
                    func
                    (box-get rest)
                    liveness
                    live-blocks
                    depths
                    next-point
                    (+ block-index 1)
                    vars
                    type-info
                    assignments
                    intervals
                    group-vars
                    parents
                    merged-roots)
                  r))
              (compiler-reg-loop-split-refused-select-blocks
                type-segment-bases
                func
                (box-get rest)
                liveness
                live-blocks
                depths
                next-point
                (+ block-index 1)
                vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-loop-split-refused-select-blocks-seq
        type-segment-bases
        func
        seq
        liveness
        live-blocks
        depths
        point
        block-index
        vars
        type-info
        assignments
        intervals
        group-vars
        parents
        merged-roots)]))

(define (compiler-reg-loop-split-refused-select-blocks-seq
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [seq : CompilerIrBlockSeq]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [depths : (Array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]) : i64
  (compiler-reg-loop-split-refused-select-blocks-seq-from
    type-segment-bases
    func
    seq
    liveness
    live-blocks
    depths
    point
    block-index
    vars
    type-info
    assignments
    intervals
    group-vars
    parents
    merged-roots
    0))

(define (compiler-reg-loop-split-refused-select-blocks-seq-from
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [seq : CompilerIrBlockSeq]
  [liveness : CompilerFunctionLiveness]
  [live-blocks : (Array CompilerLiveBlock)]
  [depths : (Array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [index : i64]) : i64
  (if (>= index (compiler-ir-block-seq-count seq))
    (compiler-ir-label-none)
    (match (compiler-ir-block-seq-ref seq index)
      [(CompilerIrBlock.Block label instrs)
        (let
          [next-point : i64
            (+ point (* 2 (compiler-ir-instr-seq-count instrs)))]
          [depth : i64
            (if (< block-index (array-length depths))
              (array-ref depths block-index)
              0)]
          [candidate-regs : CompilerRegIdList
            (compiler-reg-loop-split-candidate-regs
              (not (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
              (compiler-reg-loop-split-region-rcx-safe?
                type-segment-bases
                func
                point
                next-point)
              (compiler-reg-loop-split-region-rdx-safe?
                type-segment-bases
                func
                point
                next-point))]
          (if (and
            (< block-index (array-length live-blocks))
            (> depth 0)
            (compiler-reg-loop-split-succs-has-backedge?
              liveness
              block-index
              (compiler-reg-live-block-succs
                (array-ref live-blocks block-index))))
            (let
              [r : i64
                (compiler-reg-loop-split-refused-select-var
                  func
                  liveness
                  label
                  (array-ref live-blocks block-index)
                  instrs
                  point
                  next-point
                  depth
                  candidate-regs
                  vars
                  0
                  type-info
                  assignments
                  intervals
                  group-vars
                  parents
                  merged-roots)]
              (if (= r (compiler-ir-label-none))
                (compiler-reg-loop-split-refused-select-blocks-seq-from
                  type-segment-bases
                  func
                  seq
                  liveness
                  live-blocks
                  depths
                  next-point
                  (+ block-index 1)
                  vars
                  type-info
                  assignments
                  intervals
                  group-vars
                  parents
                  merged-roots
                  (+ index 1))
                r))
            (compiler-reg-loop-split-refused-select-blocks-seq-from
              type-segment-bases
              func
              seq
              liveness
              live-blocks
              depths
              next-point
              (+ block-index 1)
              vars
              type-info
              assignments
              intervals
              group-vars
              parents
              merged-roots
              (+ index 1))))])))

(define (compiler-reg-loop-split-max-rounds-for-abi
  [abi : CompilerRegTargetAbi]) : i64
  ;; Campaign: +6 for the caller-saved rescue rounds (r8/r9/rsi/rdi plus
  ;; guarded rcx/rdx) in
  ;; clobber-free regions; extra rounds stop early when no free candidate remains.
  (+ (compiler-reg-callee-saved-integer-register-count-for-abi abi) 6))

(define (compiler-reg-loop-split-rewrite-rounds
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [in-vars : i64]
  [current-vars : i64]
  [plan : CompilerRegPlan]
  [extra-assignments : CompilerRegAssignmentList]
  [extra-types : CompilerRegVarTypeList]
  [rounds-left : i64]) : CompilerRegCallSaveRewrite
  (if (<= rounds-left 0)
    (CompilerRegCallSaveRewrite.Rewrite
      blocks
      in-vars
      current-vars
      extra-assignments
      extra-types)
    (let
      [round-plan : CompilerRegPlan
        (compiler-reg-plan-with-call-save-rewrite
          plan
          (CompilerRegCallSaveRewrite.Rewrite
            blocks
            in-vars
            current-vars
            extra-assignments
            extra-types))]
      [round-type-info : CompilerRegVarTypes
        (compiler-reg-function-var-types func)]
      (match (compiler-reg-loop-split-rewrite-one
        type-segment-bases
        abi
        func
        blocks
        current-vars
        round-type-info
        round-plan)
        [(CompilerRegLoopSplitRewriteResult.Result rewrite refused-header)
          (match rewrite
            [(CompilerRegCallSaveRewrite.Rewrite
                next-blocks
                _
                next-vars
                next-assignments
                next-types)
              (if (= next-vars current-vars)
                ;; No var homed this round. Before giving up, use the refused
                ;; preheader label found during the same liveness pass as the
                ;; candidate search.
                (if (= refused-header (compiler-ir-label-none))
                  (CompilerRegCallSaveRewrite.Rewrite
                    blocks
                    in-vars
                    current-vars
                    extra-assignments
                    extra-types)
                  (let
                    [spliced : CompilerIrBlockList
                      (compiler-reg-loop-split-splice-preheader
                        blocks
                        refused-header)]
                    (if (>
                      (compiler-ir-block-list-count spliced)
                      (compiler-ir-block-list-count blocks))
                      (match func
                        [(CompilerIrFunction.Function name params ret-ty _ _)
                          (compiler-reg-loop-split-rewrite-rounds
                            type-segment-bases
                            abi
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              current-vars
                              spliced)
                            spliced
                            in-vars
                            current-vars
                            plan
                            extra-assignments
                            extra-types
                            (- rounds-left 1))])
                      (CompilerRegCallSaveRewrite.Rewrite
                        blocks
                        in-vars
                        current-vars
                        extra-assignments
                        extra-types))))
                (match func
                  [(CompilerIrFunction.Function name params ret-ty _ _)
                    (let
                      [merged-assignments : CompilerRegAssignmentList
                        (compiler-reg-assignment-list-merge
                          next-assignments
                          extra-assignments)]
                      [merged-types : CompilerRegVarTypeList
                        (compiler-reg-var-type-list-merge
                          next-types
                          extra-types)]
                      [next-func : CompilerIrFunction
                        (CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          next-vars
                          next-blocks)]
                      (compiler-reg-loop-split-rewrite-rounds
                        type-segment-bases
                        abi
                        next-func
                        next-blocks
                        in-vars
                        next-vars
                        plan
                        merged-assignments
                        merged-types
                        (- rounds-left 1)))]))])]))))

(define (compiler-reg-loop-split-rewrite-blocks
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [_type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (compiler-reg-loop-split-rewrite-blocks-for-abi
    type-segment-bases
    CompilerRegTargetAbi.Linux
    func
    blocks
    vars
    _type-info
    plan))

(define (compiler-reg-loop-split-rewrite-blocks-for-abi
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [_type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (compiler-reg-loop-split-rewrite-rounds
    type-segment-bases
    abi
    func
    blocks
    vars
    vars
    plan
    CompilerRegAssignmentList.Nil
    CompilerRegVarTypeList.Nil
    (compiler-reg-loop-split-max-rounds-for-abi abi)))

;; ---------------------------------------------------------------------------
;; M-G2b -- per-call-region split via the WIDENED caller-saved rescue.
;;
;; Gate autopsy of the pre-M-G2b rescue (fired 6/8,959 spilled call-spanning
;; roots): (1) it required %r9 free over the var's WHOLE hull -- a
;; call-spanning hull covers most of the function and %r9 is in the zero-call
;; scratch pool, so nearly every hull conflicted (the single biggest killer);
;; (2) `boundary-vars` excluded every var live across ANY block boundary,
;; i.e. every loop-carried value and every param -- the entire hot
;; population; (3) `calls == clobbers` rejected any hull containing a
;; div/shift; (4) `clobber-vars` rejected any var that is an argument or
;; result of ANY call; (5) the `refs > 2*calls+1` benefit gate charged every
;; call in the hull two boundary movs even where the value had no uses
;; between those calls.
;;
;; The widened design replaces whole-hull shadowing with PER-REGION homing:
;;   region  = maximal run of instrs inside ONE block containing no kind-0
;;             clobber (call/syscall/cpuid/xgetbv/...; div/shift are NOT
;;             boundaries because the shadow pool never contains
;;             rax/rdx/rcx, the only registers they clobber), trimmed to the
;;             first/last coalesce-class reference [lo,hi];
;;   select  = regions with >= 2 uses AND net memory-op win >= 2, where
;;             net = uses + defs - entry-reload - exit-store. The SplitKit-M5
;;             failure mode was boundary movs outweighing the win; this bound
;;             makes every accepted region profitable BY CONSTRUCTION, both
;;             statically and per loop iteration (a block-scoped region's
;;             boundary movs execute exactly as often as its uses);
;;   cap     = best 4 regions per root (net * loop-depth-weight score,
;;             preferring regions in loop bodies), 64 regions per function;
;;   reg     = first of %r8/%r9/%rsi/%rdi (SysV; %r8/%r9 on Win64 where
;;             rsi/rdi are callee-saved) whose segment-precise occupancy is
;;             free over ALL of the root's selected regions -- the same
;;             caller-saved subset the loop-split rescue proved safe for
;;             clobber-free regions (rax/rcx/rdx are fixed-use, r10/r11 are
;;             the emergency scavenger's preferred picks).
;; Boundary vars / params / multi-block values are ADMITTED: the home slot
;; stays the authoritative location at every region boundary (the entry
;; reload reads it; the exit store refreshes it before any code outside the
;; block can run -- the region is clobber-free straight-line code), which is
;; the old rescue's slot discipline generalized. The assignment table is NOT
;; modified: shadow roots stay CompilerRegSpill (their home slot lives on,
;; and the remat interlock keeps them remat-free); the backend caller-save
;; rewrite mints the register-homed segment vars from the region table.
;; ---------------------------------------------------------------------------
;; Per-region statistics row from the enumeration walk: var, lo, hi, uses,
;; defs, first-def (1 = the region's first class ref is a def whose instr
;; does not read the class -> no entry reload needed), loop depth.
(defenum CompilerRegCallRegionStat
  (CompilerRegCallRegionStat i64 i64 i64 i64 i64 i64 i64))

;; One bucket of candidate rows in FLUSH order; the picker walks it back to
;; front, which is the order the former prepend-built cons bucket presented.
(defstruct CompilerRegCallRegionStatSeq
  (slots (Array CompilerRegCallRegionStat))
  (len i64))

(defenum CompilerRegCallRegionMaybeStat
  (CompilerRegCallRegionNoStat)
  (CompilerRegCallRegionSomeStat CompilerRegCallRegionStat))

;; Region boundary = kind-0 clobber (all caller-saved registers die). This
;; matches the greedy's kind-0 classification exactly: div/shift BinOps are
;; kind-1/2 (rax:rdx / rcx only) and NOT boundaries; BoundsCheck/Pack are not
;; clobber points at all (compiler-reg-backend-clobber-point-instr? type-segment-bases excludes
;; them).
(define (compiler-reg-call-region-boundary-instr?
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ _ _ _ _) false]
    [_ (compiler-reg-backend-clobber-point-instr? type-segment-bases instr)]))

;; Shadow register pool: caller-saved registers with NO fixed-use hazard
;; inside a kind-0-free region. Unlike loop-split's guarded rcx/rdx widening,
;; call-region shadows keep the stable r8/r9/rsi/rdi subset: rax/rcx/rdx carry
;; div/shift/return fixed uses, r10/r11 are the emergency scavenger's default
;; picks. %rsi/%rdi are callee-saved homes on Win64, so shadows there stay on
;; the two common caller-saved registers.
(define (compiler-reg-call-region-pool [abi : CompilerRegTargetAbi]) : (Array
    i64)
  (match abi
    [(CompilerRegTargetAbi.Linux)
      (make-array
        (cast compiler-reg-id-r8 : i64)
        compiler-reg-id-r9
        compiler-reg-id-rsi
        compiler-reg-id-rdi)]
    [(CompilerRegTargetAbi.Windows)
      (make-array (cast compiler-reg-id-r8 : i64) compiler-reg-id-r9)]))

;; Size guards: at most 4 realized regions per root and 64 per function
;; (bounds the minted segment vars and the rewrite work).
(define (compiler-reg-call-region-root-cap) : i64
  4)

(define (compiler-reg-call-region-function-cap) : i64
  64)

;; ---------------------------------------------------------------------------
;; Cycle 26: property-based dominating early-return shrink wrapping.
;;
;; Discover a frame-free entry region made of compare+branch blocks over
;; incoming parameters/literals. Safe returns are cloned onto the initial bare
;; path, all other exits must share one saving frontier, and every framed edge
;; back into the region targets a framed clone. This is independent of source
;; name, parameter count/types, return type, total block count, and body shape.
(define (compiler-reg-early-exit-value-safe?
  [params : CompilerLiveI64Set]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var) (compiler-live-set-contains? params var)]
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.F64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [(CompilerIrValue.Unit) true]
    [_ false]))

(define (compiler-reg-early-exit-return-block?
  [params : CompilerLiveI64Set]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (and
        (= (compiler-ir-instr-seq-count instrs) 1)
        (match (compiler-ir-instr-seq-ref instrs 0)
          [(CompilerIrInstr.Return maybe)
            (match maybe
              [(CompilerIrMaybeValue.No) true]
              [(CompilerIrMaybeValue.Some value)
                (compiler-reg-early-exit-value-safe? params value)])]
          [_ false]))]))

(define (compiler-reg-early-exit-guard-block?
  [params : CompilerLiveI64Set]
  [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (and
        (= (compiler-ir-instr-seq-count instrs) 2)
        (match (compiler-ir-instr-seq-ref instrs 0)
          [(CompilerIrInstr.BinOp dst op lhs rhs ty)
            (and
              (compiler-reg-scratch-compare-op? op)
              ;; The shrink-wrap prefix renderer currently uses the integer
              ;; compare emitter.  XMM-homed operands would reach its GP-only
              ;; register sizing path, so floating guards are not admissible.
              (not (compiler-reg-float-type? ty))
              (compiler-reg-early-exit-value-safe? params lhs)
              (compiler-reg-early-exit-value-safe? params rhs)
              (match (compiler-ir-instr-seq-ref instrs 1)
                [(CompilerIrInstr.Branch cond _ _)
                  (match cond
                    [(CompilerIrValue.Var cond-var) (= cond-var dst)]
                    [_ false])]
                [_ false]))]
          [_ false]))]))

(define (compiler-reg-early-exit-framed-label [label : i64]) : i64
  (compiler-ir-label
    (string.append (compiler-ir-label-text label) "__shrinkwrap_framed")))

(define (compiler-reg-early-exit-bare-label-at
  [prefix : String]
  [states : (Array i64)]
  [index : i64]) : i64
  (let
    [i : i64 0]
    [ordinal : i64 0]
    (begin
      (while (< i index)
        (begin
          (if (= (array-ref states i) 2)
            (set! ordinal (+ ordinal 1))
            unit)
          (set! i (+ i 1))))
      (compiler-ir-label (string.append prefix (string.int->string ordinal))))))

;; mode 0 is the initial prefix, 1 is the ordinary body, and 2 is a framed
;; guard clone. Only terminators change, preserving all variable identities.
(define (compiler-reg-early-exit-target
  [seq : CompilerIrBlockSeq]
  [states : (Array i64)]
  [target : i64]
  [mode : i64]
  [saving-label : i64]
  [bare-prefix : String]) : i64
  (let
    [index : i64 (compiler-reg-cold-call-find-label seq target)]
    (if (< index 0)
      target
      (let
        [state : i64 (array-ref states index)]
        (cond
          [(= mode 0)
            (cond
              [(= state 1) target]
              [(= state 2)
                (compiler-reg-early-exit-bare-label-at bare-prefix states index)]
              [else saving-label])]
          [(= mode 1)
            (if (= state 1)
              (compiler-reg-early-exit-framed-label target)
              target)]
          [else
            (if (= state 1)
              (compiler-reg-early-exit-framed-label target)
              target)])))))

(define (compiler-reg-early-exit-rewrite-block
  [seq : CompilerIrBlockSeq]
  [states : (Array i64)]
  [block : CompilerIrBlock]
  [mode : i64]
  [saving-label : i64]
  [bare-prefix : String]) : CompilerIrBlock
  (match block
    [(CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          block
          (let
            [last : CompilerIrInstr
              (compiler-ir-instr-seq-ref instrs (- count 1))]
            [replacement : CompilerIrInstr
              (match last
                [(CompilerIrInstr.Jump target)
                  (CompilerIrInstr.Jump
                    (compiler-reg-early-exit-target
                      seq
                      states
                      target
                      mode
                      saving-label
                      bare-prefix))]
                [(CompilerIrInstr.Branch cond on-true on-false)
                  (CompilerIrInstr.Branch
                    cond
                    (compiler-reg-early-exit-target
                      seq
                      states
                      on-true
                      mode
                      saving-label
                      bare-prefix)
                    (compiler-reg-early-exit-target
                      seq
                      states
                      on-false
                      mode
                      saving-label
                      bare-prefix))]
                [_ last])]
            [out : (Array CompilerIrInstr)
              (array.make-array CompilerIrInstr count)]
            [i : i64 0]
            (begin
              (while (< i count)
                (begin
                  (array-set!
                    out
                    i
                    (if (= i (- count 1))
                      replacement
                      (compiler-ir-instr-seq-ref instrs i)))
                  (set! i (+ i 1))))
              (CompilerIrBlock.Block label (CompilerIrInstrSeq out count))))))]))

(define (compiler-reg-early-exit-frontier-phi?
  [seq : CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (< index 0)
    true
    (match (compiler-ir-block-seq-ref seq index)
      [(CompilerIrBlock.Block _ instrs)
        (and
          (> (compiler-ir-instr-seq-count instrs) 0)
          (match (compiler-ir-instr-seq-ref instrs 0)
            [(CompilerIrInstr.Phi _ _ _) true]
            [_ false]))])))

(define (compiler-reg-early-exit-target-is-guard?
  [seq : CompilerIrBlockSeq]
  [states : (Array i64)]
  [target : i64]) : bool
  (let
    [index : i64 (compiler-reg-cold-call-find-label seq target)]
    (and (>= index 0) (= (array-ref states index) 1))))

;; Framed guard clones are needed only for real body/back edges.  An acyclic
;; entry guard reaches the saving frontier once and is never revisited, so a
;; clone would be unreachable and would disrupt the body's natural fallthrough
;; into its return block.  If any outside edge re-enters the guard region, clone
;; the whole region: internal guard edges can then remain structurally identical
;; on the framed path, including multi-block chains.
(define (compiler-reg-early-exit-needs-framed-clones?
  [seq : CompilerIrBlockSeq]
  [states : (Array i64)]) : bool
  (let
    [i : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< i (compiler-ir-block-seq-count seq)))
        (begin
          (if (not (= (array-ref states i) 1))
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (let
                  [count : i64 (compiler-ir-instr-seq-count instrs)]
                  (if (> count 0)
                    (match (compiler-ir-instr-seq-ref instrs (- count 1))
                      [(CompilerIrInstr.Jump target)
                        (if (compiler-reg-early-exit-target-is-guard?
                          seq
                          states
                          target)
                          (set! found true)
                          unit)]
                      [(CompilerIrInstr.Branch _ on-true on-false)
                        (if (or
                          (compiler-reg-early-exit-target-is-guard?
                            seq
                            states
                            on-true)
                          (compiler-reg-early-exit-target-is-guard?
                            seq
                            states
                            on-false))
                          (set! found true)
                          unit)]
                      [_ unit])
                    unit))])
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-early-exit-label-collision?
  [seq : CompilerIrBlockSeq]
  [states : (Array i64)]
  [saving-label : i64]
  [bare-prefix : String]) : bool
  (let
    [i : i64 0]
    [collision : bool false]
    (begin
      (while (and (not collision) (< i (compiler-ir-block-seq-count seq)))
        (match (compiler-ir-block-seq-ref seq i)
          [(CompilerIrBlock.Block label _)
            (begin
              (if (or
                (= label saving-label)
                (compiler-reg-string-prefix?
                  (compiler-ir-label-text label)
                  bare-prefix))
                (set! collision true)
                unit)
              (if (and
                (not collision)
                (= (array-ref states i) 1)
                (>=
                  (compiler-reg-cold-call-find-label
                    seq
                    (compiler-reg-early-exit-framed-label label))
                  0))
                (set! collision true)
                unit)
              (if (and
                (not collision)
                (= (array-ref states i) 2)
                (>=
                  (compiler-reg-cold-call-find-label
                    seq
                    (compiler-reg-early-exit-bare-label-at bare-prefix states i))
                  0))
                (set! collision true)
                unit))])
        (set! i (+ i 1)))
      collision)))

(define (compiler-reg-early-exit-shrinkwrap-function
  [func : CompilerIrFunction]) : CompilerIrFunction
  (begin
    (set! compiler-reg-early-exit-saving-label (compiler-ir-label-none))
    (set! compiler-reg-early-exit-bare-label "")
    (set! compiler-reg-early-exit-prefix-count 0)
    (match func
      [(CompilerIrFunction.Function name params ret-ty vars blocks)
        (let
          [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
          [count : i64 (compiler-ir-block-seq-count seq)]
          [param-vars : CompilerLiveI64Set
            (compiler-reg-ineligible-params params (compiler-live-set-empty))]
          (if (or
            (<= count 0)
            (not
              (compiler-reg-early-exit-guard-block?
                param-vars
                (compiler-ir-block-seq-ref seq 0))))
            func
            (let
              [states : (Array i64) (array.make-array i64 count)]
              [fruitful : (Array i64) (array.make-array i64 count)]
              [queue : (Array i64) (array.make-array i64 count)]
              [head : i64 0]
              [tail : i64 0]
              [scan : i64 0]
              [changed : bool true]
              [valid : bool true]
              [return-count : i64 0]
              [frontier-index : i64 (- 0 1)]
              [guard-count : i64 0]
              (begin
                ;; A cheap comparison belongs to the prefix only when some path
                ;; through cheap comparisons reaches a bare return. This prevents
                ;; greedily absorbing a compare whose two successors are distinct
                ;; framed frontiers (the common loop-entry guard after an early
                ;; return) while retaining real multi-block guard chains.
                (while (< scan count)
                  (begin
                    (if (compiler-reg-early-exit-return-block?
                      param-vars
                      (compiler-ir-block-seq-ref seq scan))
                      (array-set! fruitful scan 1)
                      unit)
                    (set! scan (+ scan 1))))
                (while changed
                  (begin
                    (set! changed false)
                    (set! scan 0)
                    (while (< scan count)
                      (begin
                        (if (and
                          (= (array-ref fruitful scan) 0)
                          (compiler-reg-early-exit-guard-block?
                            param-vars
                            (compiler-ir-block-seq-ref seq scan)))
                          (match (compiler-ir-block-seq-ref seq scan)
                            [(CompilerIrBlock.Block _ instrs)
                              (match (compiler-ir-instr-seq-ref instrs 1)
                                [(CompilerIrInstr.Branch _ on-true on-false)
                                  (let
                                    [true-index : i64
                                      (compiler-reg-cold-call-find-label
                                        seq
                                        on-true)]
                                    [false-index : i64
                                      (compiler-reg-cold-call-find-label
                                        seq
                                        on-false)]
                                    (if (or
                                      (and
                                        (>= true-index 0)
                                        (= (array-ref fruitful true-index) 1))
                                      (and
                                        (>= false-index 0)
                                        (= (array-ref fruitful false-index) 1)))
                                      (begin
                                        (array-set! fruitful scan 1)
                                        (set! changed true))
                                      unit))]
                                [_ unit])])
                          unit)
                        (set! scan (+ scan 1))))))
                (if (and valid (= (array-ref fruitful 0) 1))
                  (begin
                    (array-set! states 0 1)
                    (array-set! queue 0 0)
                    (set! tail 1))
                  (set! valid false))
                ;; Discover the maximal safe region. Non-safe successors form the
                ;; saving frontier and therefore must all name the same block.
                (while (and valid (< head tail))
                  (let
                    [index : i64 (array-ref queue head)]
                    (begin
                      (set! head (+ head 1))
                      (match (compiler-ir-block-seq-ref seq index)
                        [(CompilerIrBlock.Block _ instrs)
                          (match (compiler-ir-instr-seq-ref instrs 1)
                            [(CompilerIrInstr.Branch _ on-true on-false)
                              (let
                                [side : i64 0]
                                (while (and valid (< side 2))
                                  (let
                                    [target : i64
                                      (if (= side 0)
                                        on-true
                                        on-false)]
                                    [target-index : i64
                                      (compiler-reg-cold-call-find-label
                                        seq
                                        target)]
                                    (begin
                                      (cond
                                        [(< target-index 0) (set! valid false)]
                                        [(and
                                            (=
                                              (array-ref fruitful target-index)
                                              1)
                                            (compiler-reg-early-exit-guard-block?
                                              param-vars
                                              (compiler-ir-block-seq-ref
                                                seq
                                                target-index)))
                                          (if (=
                                            (array-ref states target-index)
                                            0)
                                            (begin
                                              (array-set! states target-index 1)
                                              (array-set!
                                                queue
                                                tail
                                                target-index)
                                              (set! tail (+ tail 1)))
                                            unit)]
                                        [(compiler-reg-early-exit-return-block?
                                            param-vars
                                            (compiler-ir-block-seq-ref
                                              seq
                                              target-index))
                                          (if (=
                                            (array-ref states target-index)
                                            0)
                                            (begin
                                              (array-set! states target-index 2)
                                              (set!
                                                return-count
                                                (+ return-count 1)))
                                            unit)]
                                        [(< frontier-index 0)
                                          (begin
                                            (set! frontier-index target-index)
                                            (array-set! states target-index 3))]
                                        [(not (= frontier-index target-index))
                                          (set! valid false)]
                                        [else unit])
                                      (set! side (+ side 1))))))]
                            [_ (set! valid false)])]))))
                (set! guard-count tail)
                (if (or
                  (not valid)
                  (<= return-count 0)
                  (< frontier-index 0)
                  (compiler-reg-early-exit-frontier-phi? seq frontier-index))
                  func
                  (match (compiler-ir-block-seq-ref seq 0)
                    [(CompilerIrBlock.Block entry-label _)
                      (let
                        [saving-label : i64
                          (compiler-ir-label
                            (string.append
                              (compiler-ir-label-text entry-label)
                              "__shrinkwrap_save"))]
                        [bare-prefix : String
                          (string.append
                            (compiler-ir-label-text entry-label)
                            "__shrinkwrap_bare")]
                        [framed-count : i64
                          (if (compiler-reg-early-exit-needs-framed-clones?
                            seq
                            states)
                            guard-count
                            0)]
                        [out-count : i64
                          (+ (+ count return-count) (+ framed-count 1))]
                        [out : (Array CompilerIrBlock)
                          (array.make-array CompilerIrBlock out-count)]
                        [out-index : i64 0]
                        [i : i64 0]
                        [save-instrs : (Array CompilerIrInstr)
                          (array.make-array CompilerIrInstr 1)]
                        (if (compiler-reg-early-exit-label-collision?
                          seq
                          states
                          saving-label
                          bare-prefix)
                          func
                          (begin
                            ;; Initial guard prefix.
                            (while (< i count)
                              (begin
                                (if (= (array-ref states i) 1)
                                  (begin
                                    (array-set!
                                      out
                                      out-index
                                      (compiler-reg-early-exit-rewrite-block
                                        seq
                                        states
                                        (compiler-ir-block-seq-ref seq i)
                                        0
                                        saving-label
                                        bare-prefix))
                                    (set! out-index (+ out-index 1)))
                                  unit)
                                (set! i (+ i 1))))
                            ;; Bare-return clones remain contiguous with the prefix.
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (= (array-ref states i) 2)
                                  (match (compiler-ir-block-seq-ref seq i)
                                    [(CompilerIrBlock.Block _ instrs)
                                      (begin
                                        (array-set!
                                          out
                                          out-index
                                          (CompilerIrBlock.Block
                                            (compiler-reg-early-exit-bare-label-at
                                              bare-prefix
                                              states
                                              i)
                                            instrs))
                                        (set! out-index (+ out-index 1)))])
                                  unit)
                                (set! i (+ i 1))))
                            (array-set!
                              save-instrs
                              0
                              (CompilerIrInstr.Jump
                                (compiler-reg-cold-call-block-label
                                  (compiler-ir-block-seq-ref seq frontier-index))))
                            (array-set!
                              out
                              out-index
                              (CompilerIrBlock.Block
                                saving-label
                                (CompilerIrInstrSeq save-instrs 1)))
                            (set! out-index (+ out-index 1))
                            ;; Original framed body blocks, with backedges redirected.
                            ;; Keep the return blocks until after the framed guard
                            ;; clones.  This preserves the useful body -> guard ->
                            ;; return fallthrough chain instead of adding a jump on
                            ;; every loop iteration (the C21 layout property, now
                            ;; applied to every admitted CFG).
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (and
                                  (not (= (array-ref states i) 1))
                                  (not (= (array-ref states i) 2)))
                                  (begin
                                    (array-set!
                                      out
                                      out-index
                                      (compiler-reg-early-exit-rewrite-block
                                        seq
                                        states
                                        (compiler-ir-block-seq-ref seq i)
                                        1
                                        saving-label
                                        bare-prefix))
                                    (set! out-index (+ out-index 1)))
                                  unit)
                                (set! i (+ i 1))))
                            ;; Framed clones preserve ordinary return/epilogue edges.
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (and
                                  (> framed-count 0)
                                  (= (array-ref states i) 1))
                                  (match (compiler-reg-early-exit-rewrite-block
                                    seq
                                    states
                                    (compiler-ir-block-seq-ref seq i)
                                    2
                                    saving-label
                                    bare-prefix)
                                    [(CompilerIrBlock.Block label instrs)
                                      (begin
                                        (array-set!
                                          out
                                          out-index
                                          (CompilerIrBlock.Block
                                            (compiler-reg-early-exit-framed-label
                                              label)
                                            instrs))
                                        (set! out-index (+ out-index 1)))])
                                  unit)
                                (set! i (+ i 1))))
                            ;; The framed copies of bare-path returns retain their
                            ;; original labels and therefore still use the ordinary
                            ;; shared epilogue after the saving edge.
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (= (array-ref states i) 2)
                                  (begin
                                    (array-set!
                                      out
                                      out-index
                                      (compiler-reg-early-exit-rewrite-block
                                        seq
                                        states
                                        (compiler-ir-block-seq-ref seq i)
                                        1
                                        saving-label
                                        bare-prefix))
                                    (set! out-index (+ out-index 1)))
                                  unit)
                                (set! i (+ i 1))))
                            (set!
                              compiler-reg-early-exit-saving-label
                              saving-label)
                            (set!
                              compiler-reg-early-exit-bare-label
                              bare-prefix)
                            (set!
                              compiler-reg-early-exit-prefix-count
                              (+ guard-count return-count))
                            (CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              vars
                              (CompilerIrBlockList.Array
                                (CompilerIrBlockSeq out out-count))))))]))))))])))

;; ---------------------------------------------------------------------------
;; Cycle 20: cold-call clobber splitting.
;;
;; The backend's Windows unwind program describes a fixed entry prologue, so
;; sinking nonvolatile pushes into arbitrary body blocks is not a portable
;; first shrink-wrap form.  Instead, recognize one deliberately narrow CFG
;; shape and make the call clobber disappear from GP allocation:
;;
;;   * exactly one kind-0 clobber in the function;
;;   * that clobber is the sole instruction before a jump in a side block;
;;   * the jump has a bypass predecessor and leads toward a real loop;
;;   * two to twelve ordinary GP values are live through the call.
;;
;; Each live-through value V gets a stack-only carrier S.  The cold block is
;; rewritten to `S <- V; call; V <- S; jump`.  The scalar allocator then ignores
;; this one GP call-mask point: V has been killed before the call and redefined
;; after it, while S is forced to memory.  The no-call edge retains V in its
;; caller-saved home and executes no boundary copies.  Float/vector call masks
;; are intentionally unchanged.
;; ---------------------------------------------------------------------------
(define (compiler-reg-cold-call-clobber-count-seq
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]) : i64
  (let
    [i : i64 0]
    [count : i64 0]
    (begin
      (while (< i (compiler-ir-instr-seq-count instrs))
        (begin
          (if (compiler-reg-call-region-boundary-instr?
            type-segment-bases
            (compiler-ir-instr-seq-ref instrs i))
            (set! count (+ count 1))
            unit)
          (set! i (+ i 1))))
      count)))

(define (compiler-reg-cold-call-find-candidate
  [type-segment-bases : i64]
  [seq : CompilerIrBlockSeq]) : CompilerRegColdCallCandidate
  (let
    [b : i64 0]
    [clobbers : i64 0]
    [candidate : i64 (- 0 1)]
    [join : i64 (compiler-ir-label-none)]
    (begin
      (while (< b (compiler-ir-block-seq-count seq))
        (begin
          (match (compiler-ir-block-seq-ref seq b)
            [(CompilerIrBlock.Block _ instrs)
              (begin
                (set!
                  clobbers
                  (+
                    clobbers
                    (compiler-reg-cold-call-clobber-count-seq
                      type-segment-bases
                      instrs)))
                (if (= (compiler-ir-instr-seq-count instrs) 2)
                  (match (compiler-ir-instr-seq-ref instrs 0)
                    [(CompilerIrInstr.Call _ _ _ _)
                      (match (compiler-ir-instr-seq-ref instrs 1)
                        [(CompilerIrInstr.Jump target)
                          (if (= candidate (- 0 1))
                            (begin
                              (set! candidate b)
                              (set! join target))
                            (set! candidate (- 0 2)))]
                        [_ unit])]
                    [_ unit])
                  unit))])
          (set! b (+ b 1))))
      (if (and (= clobbers 1) (>= candidate 0))
        (CompilerRegColdCallCandidate.Candidate candidate join)
        CompilerRegColdCallCandidate.NoCandidate))))

(define (compiler-reg-cold-call-block-label [block : CompilerIrBlock]) : i64
  (match block
    [(CompilerIrBlock.Block label _) label]))

(define (compiler-reg-cold-call-find-label
  [seq : CompilerIrBlockSeq]
  [label : i64]) : i64
  (let
    [i : i64 0]
    [found : i64 (- 0 1)]
    (begin
      (while (and (< i (compiler-ir-block-seq-count seq)) (< found 0))
        (begin
          (if (=
            (compiler-reg-cold-call-block-label
              (compiler-ir-block-seq-ref seq i))
            label)
            (set! found i)
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-cold-call-predecessor-count
  [seq : CompilerIrBlockSeq]
  [label : i64]
  [excluded : i64]) : i64
  (let
    [i : i64 0]
    [count : i64 0]
    (begin
      (while (< i (compiler-ir-block-seq-count seq))
        (begin
          (if (and
            (not (= i excluded))
            (compiler-live-label-set-contains?
              (compiler-live-block-successors (compiler-ir-block-seq-ref seq i))
              label))
            (set! count (+ count 1))
            unit)
          (set! i (+ i 1))))
      count)))

(define (compiler-reg-cold-call-reaches-loop-labels?
  [seq : CompilerIrBlockSeq]
  [depths : (Array i64)]
  [labels : CompilerLiveLabelSet]
  [seen : (Array bool)]) : bool
  (match labels
    [(CompilerLiveLabelSet.Nil) false]
    [(CompilerLiveLabelSet.Dense _ _)
      (or
        (compiler-reg-cold-call-reaches-loop-from?
          seq
          depths
          (compiler-reg-cold-call-find-label
            seq
            (compiler-live-label-set-ref labels 0))
          seen)
        (compiler-reg-cold-call-reaches-loop-labels?
          seq
          depths
          (compiler-live-label-set-tail labels)
          seen))]))

(define (compiler-reg-cold-call-reaches-loop-from?
  [seq : CompilerIrBlockSeq]
  [depths : (Array i64)]
  [block : i64]
  [seen : (Array bool)]) : bool
  (if (or
    (< block 0)
    (>= block (compiler-ir-block-seq-count seq))
    (array-ref seen block))
    false
    (begin
      (array-set! seen block true)
      (or
        (> (array-ref depths block) 0)
        (compiler-reg-cold-call-reaches-loop-labels?
          seq
          depths
          (compiler-live-block-successors (compiler-ir-block-seq-ref seq block))
          seen)))))

(define (compiler-reg-cold-call-cfg-ok?
  [blocks : CompilerIrBlockList]
  [seq : CompilerIrBlockSeq]
  [call-block : i64]
  [join-label : i64]) : bool
  (let
    [join-block : i64 (compiler-reg-cold-call-find-label seq join-label)]
    [depths : (Array i64) (compiler-reg-function-loop-depths blocks)]
    [reaches-loop? : bool
      (compiler-reg-cold-call-reaches-loop-from?
        seq
        depths
        join-block
        (array.make-array bool (compiler-ir-block-seq-count seq)))]
    [call-label : i64
      (compiler-reg-cold-call-block-label
        (compiler-ir-block-seq-ref seq call-block))]
    (and
      (> call-block 0)
      (> join-block call-block)
      (= (array-ref depths call-block) 0)
      reaches-loop?
      (> (compiler-reg-cold-call-predecessor-count seq call-label (- 0 1)) 0)
      ;; One predecessor is the call block and at least one distinct predecessor
      ;; is the bypass edge.
      (> (compiler-reg-cold-call-predecessor-count seq join-label (- 0 1)) 1)
      (> (compiler-reg-cold-call-predecessor-count seq join-label call-block) 0))))

(define (compiler-reg-cold-call-protectable-type?
  [type-segment-bases : i64]
  [ty : AstType]) : bool
  (and
    (compiler-reg-register-eligible-type? ty)
    (not (compiler-reg-float-type? ty))
    (not (compiler-reg-type-register-group? type-segment-bases ty))))

;; Fill `selected` in ascending var-id order.  Returning cap+1 means either the
;; bounded budget was exceeded or a live GP register-group could not be carried
;; in one stack word.  Edge-precise liveness keeps loop-phi back-edge inputs off
;; this preheader boundary.
(define (compiler-reg-cold-call-select-live!
  [type-segment-bases : i64]
  [live-after : CompilerLiveI64Set]
  [defs : CompilerLiveI64Set]
  [memory-vars : CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [vars : i64]
  [selected : (Array i64)]) : i64
  (let
    [v : i64 0]
    [count : i64 0]
    [unsafe : bool false]
    (begin
      (while (< v vars)
        (begin
          (if (and
            (compiler-live-set-contains? live-after v)
            (not (compiler-live-set-contains? defs v))
            (not (compiler-live-set-contains? memory-vars v)))
            (match (compiler-reg-var-types-lookup type-info v)
              [(CompilerRegMaybeType.Some ty)
                (if (compiler-reg-cold-call-protectable-type?
                  type-segment-bases
                  ty)
                  (begin
                    (if (< count (array-length selected))
                      (array-set! selected count v)
                      unit)
                    (set! count (+ count 1)))
                  ;; XMM-family values retain their real call masks; values
                  ;; that are not register-eligible already have stack homes.
                  ;; A GP register group would be exposed by the ignored mask,
                  ;; but this first form has only one-word carriers.
                  (if (and
                    (compiler-reg-register-eligible-type? ty)
                    (not (compiler-reg-float-type? ty)))
                    (set! unsafe true)
                    unit))]
              [(CompilerRegMaybeType.No) unit])
            unit)
          (set! v (+ v 1))))
      (if unsafe
        (+ (array-length selected) 1)
        count))))

(define (compiler-reg-cold-call-rewrite-instrs
  [instrs : CompilerIrInstrSeq]
  [selected : (Array i64)]
  [selected-count : i64]
  [temp-start : i64]
  [type-info : CompilerRegVarTypes]) : CompilerIrInstrSeq
  (let
    [old-count : i64 (compiler-ir-instr-seq-count instrs)]
    [out-count : i64 (+ old-count (* 2 selected-count))]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr out-count)]
    [w : i64 0]
    [i : i64 0]
    (begin
      ;; Candidate admission fixes the call at instruction zero.
      (while (< i selected-count)
        (let
          [v : i64 (array-ref selected i)]
          (begin
            (match (compiler-reg-var-types-lookup type-info v)
              [(CompilerRegMaybeType.Some ty)
                (array-set!
                  out
                  w
                  (CompilerIrInstr.Mov
                    (+ temp-start i)
                    (CompilerIrValue.Var v)
                    ty))]
              [(CompilerRegMaybeType.No) unit])
            (set! w (+ w 1))
            (set! i (+ i 1)))))
      (array-set! out w (compiler-ir-instr-seq-ref instrs 0))
      (set! w (+ w 1))
      (set! i 0)
      (while (< i selected-count)
        (let
          [v : i64 (array-ref selected i)]
          (begin
            (match (compiler-reg-var-types-lookup type-info v)
              [(CompilerRegMaybeType.Some ty)
                (array-set!
                  out
                  w
                  (CompilerIrInstr.Mov
                    v
                    (CompilerIrValue.Var (+ temp-start i))
                    ty))]
              [(CompilerRegMaybeType.No) unit])
            (set! w (+ w 1))
            (set! i (+ i 1)))))
      (set! i 1)
      (while (< i old-count)
        (begin
          (array-set! out w (compiler-ir-instr-seq-ref instrs i))
          (set! w (+ w 1))
          (set! i (+ i 1))))
      (CompilerIrInstrSeq out out-count))))

(define (compiler-reg-cold-call-rewrite-function
  [type-segment-bases : i64]
  [func : CompilerIrFunction]) : CompilerRegColdCallRewrite
  (match func
    [(CompilerIrFunction.Function name params ret-ty vars blocks)
      (let
        [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
        (match (compiler-reg-cold-call-find-candidate type-segment-bases seq)
          [(CompilerRegColdCallCandidate.NoCandidate)
            (CompilerRegColdCallRewrite.Rewrite func (- 0 1))]
          [(CompilerRegColdCallCandidate.Candidate call-block join-label)
            (if (not
              (compiler-reg-cold-call-cfg-ok? blocks seq call-block join-label))
              (CompilerRegColdCallRewrite.Rewrite func (- 0 1))
              (let
                [type-info : CompilerRegVarTypes
                  (compiler-reg-function-var-types func)]
                [liveness
                  : CompilerFunctionLiveness
                  ;; Phi inputs belong to predecessor edges.  The baseline
                  ;; block analysis conservatively made back-edge inputs look
                  ;; live across this preheader call (nine values in the
                  ;; hashmap helper instead of the three real parameters).
                  (compiler-live-analyze-function-edge-precise func)]
                [call-instrs : CompilerIrInstrSeq
                  (match (compiler-ir-block-seq-ref seq call-block)
                    [(CompilerIrBlock.Block _ instrs) instrs])]
                [call-instr : CompilerIrInstr
                  (compiler-ir-instr-seq-ref call-instrs 0)]
                [selected : (Array i64) (array.make-array i64 12)]
                [selected-count : i64
                  (compiler-reg-cold-call-select-live!
                    type-segment-bases
                    (compiler-live-after
                      liveness
                      (compiler-reg-cold-call-block-label
                        (compiler-ir-block-seq-ref seq call-block))
                      0)
                    (compiler-live-instr-defs call-instr)
                    (compiler-reg-ineligible-memory
                      blocks
                      (compiler-live-set-empty))
                    type-info
                    vars
                    selected)]
                (if (or (< selected-count 2) (> selected-count 12))
                  (CompilerRegColdCallRewrite.Rewrite func (- 0 1))
                  (let
                    [count : i64 (compiler-ir-block-seq-count seq)]
                    [out : (Array CompilerIrBlock)
                      (array.make-array CompilerIrBlock count)]
                    [b : i64 0]
                    (begin
                      (while (< b count)
                        (begin
                          (array-set!
                            out
                            b
                            (if (= b call-block)
                              (match (compiler-ir-block-seq-ref seq b)
                                [(CompilerIrBlock.Block label instrs)
                                  (CompilerIrBlock.Block
                                    label
                                    (compiler-reg-cold-call-rewrite-instrs
                                      instrs
                                      selected
                                      selected-count
                                      vars
                                      type-info))])
                              (compiler-ir-block-seq-ref seq b)))
                          (set! b (+ b 1))))
                      (CompilerRegColdCallRewrite.Rewrite
                        (CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          (+ vars selected-count)
                          (CompilerIrBlockList.Array
                            (CompilerIrBlockSeq out count)))
                        vars))))))]))]))

(define (compiler-reg-call-region-root
  [parents : (Array i64)]
  [n : i64]
  [v : i64]) : i64
  (if (and (>= v 0) (< v (array-length parents)))
    (let
      [p : i64 (array-ref parents v)]
      (if (and (>= p 0) (< p n))
        p
        v))
    v))

;; Flush root's open region row into its bucket (kept only when it can ever
;; be selected: >= 2 uses) and close it.
(define (compiler-reg-call-region-flush-root!
  [root : i64]
  [buckets : (Array CompilerRegCallRegionStatSeq)]
  [cur-lo : (Array i64)]
  [cur-hi : (Array i64)]
  [cur-uses : (Array i64)]
  [cur-defs : (Array i64)]
  [cur-firstdef : (Array i64)]
  [cur-depth : (Array i64)]) : unit
  (begin
    (if (and (>= (array-ref cur-lo root) 0) (>= (array-ref cur-uses root) 2))
      (array-set!
        buckets
        root
        (compiler-reg-call-region-stat-seq-push
          (array-ref buckets root)
          (CompilerRegCallRegionStat
            root
            (array-ref cur-lo root)
            (array-ref cur-hi root)
            (array-ref cur-uses root)
            (array-ref cur-defs root)
            (array-ref cur-firstdef root)
            (array-ref cur-depth root))))
      unit)
    (array-set! cur-lo root (- 0 1))))

;; Attribute one instr's refs (its uses OR defs var set) to the candidates'
;; open regions. PER-VAR, deliberately NOT class-merged: storage coloring
;; later assigns every var its OWN slot by its own liveness, so two
;; coalesce-class members that share a plan offset may end up in DIFFERENT
;; final slots (their value flows through the class's explicit copy movs).
;; A region's boundary movs must therefore read/write exactly the var whose
;; refs they serve -- a class-merged region homed on the ROOT's slot reads
;; stale storage once coloring de-aliases the members (the M-G2b gating
;; miscompile: color_walk's entry reload read the root's slot while the
;; region's member refs lived in their own colored slot).
;; `rid` is the current region id (bumped at every block start and at every
;; kind-0 boundary instr); a ref under a NEW rid flushes the var's previous
;; region row and opens a fresh one at this point. Callers pass the uses set
;; FIRST, so a region opened by a def-that-also-reads (x = x + 1) correctly
;; records first-def = 0 (entry reload required).
(define (compiler-reg-call-region-note-set!
  [set : CompilerLiveI64Set]
  [is-def : bool]
  [cand : (Array i64)]
  [n : i64]
  [rid : i64]
  [p : i64]
  [depth : i64]
  [buckets : (Array CompilerRegCallRegionStatSeq)]
  [cur-region : (Array i64)]
  [cur-lo : (Array i64)]
  [cur-hi : (Array i64)]
  [cur-uses : (Array i64)]
  [cur-defs : (Array i64)]
  [cur-firstdef : (Array i64)]
  [cur-depth : (Array i64)]) : unit
  (let
    [wi : i64 0]
    [wc : i64 (compiler-live-set-word-count set)]
    (while (< wi wc)
      (let
        [bits : i64 (compiler-live-set-word-at-bounded set wi)]
        (begin
          (while (not (= bits 0))
            (let
              [b : i64 (compiler-reg-low-bit-index32 bits)]
              [v : i64 (+ (* wi (compiler-live-set-word-bits)) b)]
              (begin
                (if (and (>= v 0) (< v n) (= (array-ref cand v) 1))
                  (begin
                    (if (not (= (array-ref cur-region v) rid))
                      (begin
                        (compiler-reg-call-region-flush-root!
                          v
                          buckets
                          cur-lo
                          cur-hi
                          cur-uses
                          cur-defs
                          cur-firstdef
                          cur-depth)
                        (array-set! cur-region v rid)
                        (array-set! cur-lo v p)
                        (array-set! cur-hi v p)
                        (array-set! cur-uses v 0)
                        (array-set! cur-defs v 0)
                        (array-set!
                          cur-firstdef
                          v
                          (if is-def
                            1
                            0))
                        (array-set! cur-depth v depth))
                      unit)
                    (array-set! cur-hi v p)
                    (if is-def
                      (array-set! cur-defs v (+ (array-ref cur-defs v) 1))
                      (array-set! cur-uses v (+ (array-ref cur-uses v) 1))))
                  unit)
                (set! bits (bit-and bits (- bits 1))))))
          (set! wi (+ wi 1)))))))

;; Enumeration walk: single pass over all instrs in layout order with the
;; greedy's point numbering (+2 per instr across blocks). Phi instructions
;; are skipped entirely (they sit at block heads; their inputs are read on
;; EDGES in predecessor blocks and their defs land in the home slot, so they
;; are never region members).
(define (compiler-reg-call-region-collect!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [depths : (Array i64)]
  [cand : (Array i64)]
  [n : i64]
  [buckets : (Array CompilerRegCallRegionStatSeq)]) : unit
  (let
    [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
    [bslots : (Array CompilerIrBlock) (struct-get seq slots)]
    [nblocks : i64 (struct-get seq len)]
    [cur-region : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-lo : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-hi : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-uses : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-defs : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-firstdef : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-depth : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [p : i64 0]
    [rid : i64 0]
    [b : i64 0]
    (begin
      (compiler-reg-fill-i64-array cur-region (- 0 1))
      (compiler-reg-fill-i64-array cur-lo (- 0 1))
      (while (< b nblocks)
        (begin
          (set! rid (+ rid 1))
          (match (array-ref bslots b)
            [(CompilerIrBlock.Block _ instrs)
              (let
                [islots : (Array CompilerIrInstr) (struct-get instrs slots)]
                [ilen : i64 (compiler-ir-instr-seq-count instrs)]
                [depth : i64
                  (if (< b (array-length depths))
                    (array-ref depths b)
                    0)]
                [i : i64 0]
                (while (< i ilen)
                  (let
                    [instr : CompilerIrInstr (array-ref islots i)]
                    (begin
                      (if (compiler-reg-call-region-boundary-instr?
                        type-segment-bases
                        instr)
                        (set! rid (+ rid 1))
                        (match instr
                          [(CompilerIrInstr.Phi _ _ _) unit]
                          [_
                            (begin
                              (compiler-reg-call-region-note-set!
                                (compiler-live-instr-uses instr)
                                false
                                cand
                                n
                                rid
                                p
                                depth
                                buckets
                                cur-region
                                cur-lo
                                cur-hi
                                cur-uses
                                cur-defs
                                cur-firstdef
                                cur-depth)
                              (compiler-reg-call-region-note-set!
                                (compiler-live-instr-defs instr)
                                true
                                cand
                                n
                                rid
                                p
                                depth
                                buckets
                                cur-region
                                cur-lo
                                cur-hi
                                cur-uses
                                cur-defs
                                cur-firstdef
                                cur-depth))]))
                      (set! p (+ p 2))
                      (set! i (+ i 1))))))])
          (set! b (+ b 1))))
      (let
        [r : i64 0]
        (while (< r n)
          (begin
            (if (= (array-ref cand r) 1)
              (compiler-reg-call-region-flush-root!
                r
                buckets
                cur-lo
                cur-hi
                cur-uses
                cur-defs
                cur-firstdef
                cur-depth)
              unit)
            (set! r (+ r 1))))))))

(define (compiler-reg-call-region-stat-entry [stat : CompilerRegCallRegionStat]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ _ _ firstdef _)
      (if (= firstdef 1)
        0
        1)]))

;; Exit store needed iff the region redefines the value AND it lives past the
;; region's last instr (interval end beyond hi's live-after half-point).
;; Unknown interval -> conservative 1 (an extra dead store is safe; a missing
;; live store is a miscompile).
(define (compiler-reg-call-region-stat-exit
  [stat : CompilerRegCallRegionStat]
  [ends : (Array i64)]) : i64
  (match stat
    [(CompilerRegCallRegionStat var _ hi _ defs _ _)
      (if (= defs 0)
        0
        (if (and
          (>= var 0)
          (< var (array-length ends))
          (<= (array-ref ends var) (+ hi 1)))
          0
          1))]))

(define (compiler-reg-call-region-stat-net
  [stat : CompilerRegCallRegionStat]
  [ends : (Array i64)]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ uses defs _ _)
      (-
        (+ uses defs)
        (+
          (compiler-reg-call-region-stat-entry stat)
          (compiler-reg-call-region-stat-exit stat ends)))]))

(define (compiler-reg-call-region-stat-score
  [stat : CompilerRegCallRegionStat]
  [ends : (Array i64)]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ _ _ _ depth)
      (*
        (compiler-reg-call-region-stat-net stat ends)
        (compiler-reg-loop-depth-weight depth))]))

;; Profitability floor: >= 2 uses (the memo bound) AND net memory-op win
;; >= 2 after charging the boundary movs.
(define (compiler-reg-call-region-stat-eligible?
  [stat : CompilerRegCallRegionStat]
  [ends : (Array i64)]) : bool
  (match stat
    [(CompilerRegCallRegionStat _ _ _ uses _ _ _)
      (and (>= uses 2) (>= (compiler-reg-call-region-stat-net stat ends) 2))]))

(define (compiler-reg-call-region-picked?
  [picked-lo : (Array i64)]
  [k : i64]
  [lo : i64]) : bool
  (let
    [j : i64 0]
    [found : bool false]
    (begin
      (while (< j k)
        (begin
          (if (= (array-ref picked-lo j) lo)
            (set! found true)
            unit)
          (set! j (+ j 1))))
      found)))

;; Best not-yet-picked eligible row by score (region lo is unique per root,
;; so it doubles as the picked-row key).
(define (compiler-reg-call-region-best-from
  [rows : CompilerRegCallRegionStatSeq]
  [ends : (Array i64)]
  [picked-lo : (Array i64)]
  [k : i64]
  [best-score : i64]
  [best : CompilerRegCallRegionMaybeStat]) : CompilerRegCallRegionMaybeStat
  (let
    [slots : (Array CompilerRegCallRegionStat) (struct-get rows slots)]
    [index : i64 (- (struct-get rows len) 1)]
    [top-score : i64 best-score]
    [top : CompilerRegCallRegionMaybeStat best]
    (begin
      (while (>= index 0)
        (let
          [stat : CompilerRegCallRegionStat (array-ref slots index)]
          [score : i64 (compiler-reg-call-region-stat-score stat ends)]
          (begin
            (match stat
              [(CompilerRegCallRegionStat _ lo _ _ _ _ _)
                (if (and
                  (compiler-reg-call-region-stat-eligible? stat ends)
                  (not (compiler-reg-call-region-picked? picked-lo k lo))
                  (> score top-score))
                  (begin
                    (set! top-score score)
                    (set! top (CompilerRegCallRegionSomeStat stat)))
                  unit)])
            (set! index (- index 1)))))
      top)))

;; Segment-precise occupancy: does var overlap point range [lo,hi]?
;; CLOSED-interval overlap (inclusive at both ends, unlike the allocator's
;; half-open boundary-touch waiver) so even a boundary-touching occupant --
;; e.g. a dead def at lo whose register write would land between our entry
;; reload and the region body -- conflicts. Hull fallback when no segments.
(define (compiler-reg-call-region-var-overlaps-segs?
  [segs : CompilerRegIntervalSeq]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-interval-seq-count segs)) (not found))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref segs index)]
          (if (and
            (<= (struct-get interval start) (+ hi 1))
            (>= (struct-get interval end) lo))
            (set! found true)
            (set! index (+ index 1)))))
      found)))

(define (compiler-reg-call-region-var-overlaps?
  [interval-index : CompilerRegIntervalIndex]
  [v : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [segments : (Array CompilerRegIntervalSeq)
      (struct-get interval-index segments)]
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    (if (and (>= v 0) (< v (array-length starts)))
      (let
        [segs : CompilerRegIntervalSeq
          (if (< v (array-length segments))
            (array-ref segments v)
            (compiler-reg-interval-seq-empty))]
        (if (not (compiler-reg-interval-seq-empty? segs))
          (compiler-reg-call-region-var-overlaps-segs? segs lo hi)
          (and
            (>= (array-ref starts v) 0)
            (<= (array-ref starts v) (+ hi 1))
            (>= (array-ref ends v) lo))))
      true)))

(define (compiler-reg-call-region-pool-index-of
  [pool : (Array i64)]
  [reg : i64]) : i64
  (let
    [j : i64 0]
    [found : i64 (- 0 1)]
    (begin
      (while (< j (array-length pool))
        (begin
          (if (and (< found 0) (= (array-ref pool j) reg))
            (set! found j)
            unit)
          (set! j (+ j 1))))
      found)))

;; Is pool register `pix` occupied over [lo,hi] by any recorded occupant?
;; Occupants = every var assigned a pool register (or a register pair
;; containing one) plus every previously accepted shadow var (recorded on
;; its coalesce root, whose merged segments cover it). A candidate's own
;; occupancy is appended only AFTER all its regions are picked, so no
;; self-skip is needed -- and none is WANTED: two same-class siblings must
;; not share a register over overlapping regions (they are distinct values
;; under the storage-sharing coalesce).
(define (compiler-reg-call-region-reg-conflicts?
  [occ-var : (Array i64)]
  [occ-reg : (Array i64)]
  [occ-n : i64]
  [interval-index : CompilerRegIntervalIndex]
  [pix : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [j : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< j occ-n) (not conflict))
        (begin
          (if (and
            (= (array-ref occ-reg j) pix)
            (compiler-reg-call-region-var-overlaps?
              interval-index
              (array-ref occ-var j)
              lo
              hi))
            (set! conflict true)
            unit)
          (set! j (+ j 1))))
      conflict)))

;; Mark candidate roots in `cand` (spilled + register-eligible scalar/handle
;; type + hull spans a kind-0 clobber + no remat-candidate class member -- a
;; remat'd value has no stable slot to reload from) and record their ids in
;; walk order in `order`. Returns the candidate count.
(define (compiler-reg-call-region-mark-candidates
  [candidates : CompilerRegIntervalSeq]
  [index : i64]
  [assignments : CompilerRegAssignmentTable]
  [type-info : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [kind0 : CompilerLiveI64Set]
  [root-has-remat : (Array i64)]
  [n : i64]
  [cand : (Array i64)]
  [order : (Array i64)]
  [count : i64]) : i64
  (if (>= index (compiler-reg-interval-seq-count candidates))
    count
    (let
      [interval : CompilerRegInterval
        (compiler-reg-interval-seq-ref candidates index)]
      [var : i64 (struct-get interval var)]
      [start : i64 (struct-get interval start)]
      [end : i64 (struct-get interval end)]
      ;; lint-allow: single-begin
      (begin
        (if (and
          (>= var 0)
          (< var n)
          (= (array-ref root-has-remat var) 0)
          (compiler-reg-call-set-in-range? kind0 start end)
          (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
            [(CompilerRegMaybeType.Some _) true]
            [(CompilerRegMaybeType.No) false])
          (match (compiler-reg-assignment-table-lookup assignments var)
            [(CompilerRegMaybeLocation.Some location)
              (match location
                [(CompilerRegLocation.Spill _) true]
                [_ false])]
            [(CompilerRegMaybeLocation.No) false]))
          (begin
            (array-set! cand var 1)
            (array-set! order count var)
            (compiler-reg-call-region-mark-candidates
              candidates
              (+ index 1)
              assignments
              type-info
              group-vars
              kind0
              root-has-remat
              n
              cand
              order
              (+ count 1)))
          (compiler-reg-call-region-mark-candidates
            candidates
            (+ index 1)
            assignments
            type-info
            group-vars
            kind0
            root-has-remat
            n
            cand
            order
            count))))))

;; The widened rescue entry point (M-G2b): enumerate every candidate root's
;; call-free regions, select the profitable ones, and home each accepted
;; root's regions in one caller-saved shadow register. The assignment table
;; is returned UNCHANGED (shadow roots stay spilled; the region table drives
;; the backend rewrite).
(define (compiler-reg-assign-caller-saved-call-spanning
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [candidates : CompilerRegIntervalSeq]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [type-info : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [parents : (Array i64)]) : CompilerRegCallSaveAssignState
  (let
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    [n : i64 (array-length starts)]
    [an : i64
      (if (< n 1)
        1
        n)]
    [kind0 : CompilerLiveI64Set
      (compiler-reg-clobber-kind-points type-segment-bases func 0)]
    [remat-cands : (Array i64)
      (struct-get (compiler-reg-remat-table-build func) candidates)]
    [root-has-remat : (Array i64) (array.make-array i64 an)]
    [cand : (Array i64) (array.make-array i64 an)]
    [order : (Array i64) (array.make-array i64 an)]
    [v : i64 0]
    (begin
      (while (< v (array-length remat-cands))
        (begin
          (if (= (array-ref remat-cands v) 1)
            (let
              [rr : i64 (compiler-reg-call-region-root parents n v)]
              (if (and (>= rr 0) (< rr n))
                (array-set! root-has-remat rr 1)
                unit))
            unit)
          (set! v (+ v 1))))
      (let
        [root-count : i64
          (compiler-reg-call-region-mark-candidates
            candidates
            0
            assignments
            type-info
            group-vars
            kind0
            root-has-remat
            n
            cand
            order
            0)]
        [cand-count : i64 root-count]
        ;; Per-var live-after horizon: the var's coalesce ROOT's merged hull
        ;; end (members have no eff-index entry of their own); unknown ->
        ;; conservative far end (an unneeded exit store is safe, a missing
        ;; one is a miscompile).
        [vend : (Array i64) (array.make-array i64 an)]
        (begin
          ;; extend candidacy to coalesce-class MEMBERS of accepted roots:
          ;; their refs are attributed per-var (see note-set!), so each member
          ;; needs its own candidacy bit, type gate included.
          (let
            [v : i64 0]
            (while (< v n)
              (begin
                (if (and
                  (> root-count 0)
                  (= (array-ref cand v) 0)
                  (let
                    [rr : i64 (compiler-reg-call-region-root parents n v)]
                    (and (not (= rr v)) (= (array-ref cand rr) 1)))
                  (match (compiler-reg-loop-split-type-ok?
                    type-info
                    group-vars
                    v)
                    [(CompilerRegMaybeType.Some _) true]
                    [(CompilerRegMaybeType.No) false]))
                  (begin
                    (array-set! cand v 1)
                    (array-set! order cand-count v)
                    (set! cand-count (+ cand-count 1)))
                  unit)
                (set! v (+ v 1)))))
          (let
            [v : i64 0]
            (while (< v n)
              (begin
                (let
                  [rr : i64 (compiler-reg-call-region-root parents n v)]
                  (array-set!
                    vend
                    v
                    (if (and
                      (>= rr 0)
                      (< rr (array-length ends))
                      (>= (array-ref ends rr) 0))
                      (array-ref ends rr)
                      1073741824)))
                (set! v (+ v 1)))))
          (if (= cand-count 0)
            (CompilerRegCallSaveAssignState.State
              assignments
              (compiler-reg-call-split-empty))
            (match func
              [(CompilerIrFunction.Function _ _ _ _ blocks)
                (let
                  [depths : (Array i64)
                    (compiler-reg-function-loop-depths blocks)]
                  [buckets : (Array CompilerRegCallRegionStatSeq)
                    (array.make-array CompilerRegCallRegionStatSeq an)]
                  [pool : (Array i64) (compiler-reg-call-region-pool abi)]
                  [pool-count : i64 (array-length pool)]
                  [present : (Array i64) (struct-get assignments present)]
                  [items : (Array CompilerRegLocation)
                    (struct-get assignments items)]
                  ;; occupants of the pool registers (var id + pool index); a
                  ;; register PAIR can contribute two entries and every accepted
                  ;; shadow root appends one, so size 3n bounds it.
                  [occ-var : (Array i64) (array.make-array i64 (+ (* 3 an) 1))]
                  [occ-reg : (Array i64) (array.make-array i64 (+ (* 3 an) 1))]
                  [occ-n : i64 0]
                  [shadows : CompilerLiveI64Set (compiler-live-set-empty)]
                  [shadow-regs : (Array i64) (array.make-array i64 an)]
                  [regions : CompilerRegCallRegionSeq
                    (compiler-reg-call-region-seq-empty)]
                  [budget : i64 (compiler-reg-call-region-function-cap)]
                  [root-cap : i64 (compiler-reg-call-region-root-cap)]
                  [picked-lo : (Array i64) (array.make-array i64 4)]
                  [picked-hi : (Array i64) (array.make-array i64 4)]
                  [picked-entry : (Array i64) (array.make-array i64 4)]
                  [picked-exit : (Array i64) (array.make-array i64 4)]
                  [idx : i64 0]
                  [ci : i64 0]
                  (begin
                    (compiler-reg-fill-i64-array
                      shadow-regs
                      compiler-reg-id-invalid)
                    (let
                      [bi : i64 0]
                      (while (< bi an)
                        (begin
                          (array-set!
                            buckets
                            bi
                            (compiler-reg-call-region-stat-seq-empty))
                          (set! bi (+ bi 1)))))
                    (compiler-reg-call-region-collect!
                      type-segment-bases
                      blocks
                      depths
                      cand
                      n
                      buckets)
                    ;; index the pool-register occupants once
                    (while (< idx n)
                      (begin
                        (if (= (array-ref present idx) 1)
                          (match (array-ref items idx)
                            [(CompilerRegLocation.Register r)
                              (let
                                [pi : i64
                                  (compiler-reg-call-region-pool-index-of
                                    pool
                                    r)]
                                (if (>= pi 0)
                                  (begin
                                    (array-set! occ-var occ-n idx)
                                    (array-set! occ-reg occ-n pi)
                                    (set! occ-n (+ occ-n 1)))
                                  unit))]
                            [(CompilerRegLocation.RegisterPair r0 r1)
                              (begin
                                (let
                                  [pi : i64
                                    (compiler-reg-call-region-pool-index-of
                                      pool
                                      r0)]
                                  (if (>= pi 0)
                                    (begin
                                      (array-set! occ-var occ-n idx)
                                      (array-set! occ-reg occ-n pi)
                                      (set! occ-n (+ occ-n 1)))
                                    unit))
                                (let
                                  [pi : i64
                                    (compiler-reg-call-region-pool-index-of
                                      pool
                                      r1)]
                                  (if (>= pi 0)
                                    (begin
                                      (array-set! occ-var occ-n idx)
                                      (array-set! occ-reg occ-n pi)
                                      (set! occ-n (+ occ-n 1)))
                                    unit)))]
                            [_ unit])
                          unit)
                        (set! idx (+ idx 1))))
                    ;; place candidates in walk order until the budget runs out
                    (while (and (< ci cand-count) (> budget 0))
                      (let
                        [root : i64 (array-ref order ci)]
                        [rows : CompilerRegCallRegionStatSeq
                          (array-ref buckets root)]
                        [k : i64 0]
                        [cap : i64
                          (if (< budget root-cap)
                            budget
                            root-cap)]
                        [more : bool true]
                        (begin
                          (compiler-reg-fill-i64-array picked-lo (- 0 1))
                          ;; pick up to `cap` best rows by net*depth score
                          (while (and more (< k cap))
                            (match (compiler-reg-call-region-best-from
                              rows
                              vend
                              picked-lo
                              k
                              (- 0 1)
                              (CompilerRegCallRegionNoStat))
                              [(CompilerRegCallRegionNoStat) (set! more false)]
                              [(CompilerRegCallRegionSomeStat stat)
                                (match stat
                                  [(CompilerRegCallRegionStat _ lo hi _ _ _ _)
                                    (begin
                                      (array-set! picked-lo k lo)
                                      (array-set! picked-hi k hi)
                                      (array-set!
                                        picked-entry
                                        k
                                        (compiler-reg-call-region-stat-entry
                                          stat))
                                      (array-set!
                                        picked-exit
                                        k
                                        (compiler-reg-call-region-stat-exit
                                          stat
                                          vend))
                                      (set! k (+ k 1)))])]))
                          (if (> k 0)
                            ;; first pool register free over ALL picked regions
                            (let
                              [pix : i64 0]
                              [chosen : i64 (- 0 1)]
                              (begin
                                (while (and (< pix pool-count) (< chosen 0))
                                  (let
                                    [j : i64 0]
                                    [free : bool true]
                                    (begin
                                      (while (and (< j k) free)
                                        (begin
                                          (if (compiler-reg-call-region-reg-conflicts?
                                            occ-var
                                            occ-reg
                                            occ-n
                                            interval-index
                                            pix
                                            (array-ref picked-lo j)
                                            (array-ref picked-hi j))
                                            (set! free false)
                                            unit)
                                          (set! j (+ j 1))))
                                      (if free
                                        (set! chosen pix)
                                        unit)
                                      (set! pix (+ pix 1)))))
                                (if (>= chosen 0)
                                  (let
                                    [j : i64 0]
                                    (begin
                                      (set!
                                        shadows
                                        (compiler-live-set-insert shadows root))
                                      (array-set!
                                        shadow-regs
                                        root
                                        (array-ref pool chosen))
                                      (while (< j k)
                                        (begin
                                          (set!
                                            regions
                                            (compiler-reg-call-region-seq-push
                                              regions
                                              (CompilerRegCallRegion
                                                root
                                                (array-ref picked-lo j)
                                                (array-ref picked-hi j)
                                                (array-ref picked-entry j)
                                                (array-ref picked-exit j))))
                                          (set! j (+ j 1))))
                                      ;; occupancy is recorded on the coalesce
                                      ;; ROOT: members carry no eff-index
                                      ;; segments of their own, and the root's
                                      ;; merged segments conservatively cover
                                      ;; every sibling.
                                      (array-set!
                                        occ-var
                                        occ-n
                                        (compiler-reg-call-region-root
                                          parents
                                          n
                                          root))
                                      (array-set! occ-reg occ-n chosen)
                                      (set! occ-n (+ occ-n 1))
                                      (set! budget (- budget k))))
                                  unit)))
                            unit)
                          (set! ci (+ ci 1)))))
                    (CompilerRegCallSaveAssignState.State
                      assignments
                      (CompilerRegCallSplit shadows shadow-regs regions))))])))))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-set-count-in-range-words
    [set : CompilerLiveI64Set]
    [start : i64]
    [end : i64]
    [word-index : i64]) : i64
    (if (>= word-index (compiler-live-set-word-count set))
      0
      (+
        (compiler-reg-call-word-count-in-range
          (compiler-live-set-word-at-bounded set word-index)
          (* word-index (compiler-live-set-word-bits))
          start
          end)
        (compiler-reg-call-set-count-in-range-words
          set
          start
          end
          (+ word-index 1))))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-set-count-in-range
    [set : CompilerLiveI64Set]
    [start : i64]
    [end : i64]) : i64
    (compiler-reg-call-set-count-in-range-words set start end 0)))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-empty) : CompilerRegCallSpanCensus
    (CompilerRegCallSpanCensus (array.make-array i64 12))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-outcome-register) : i64
    0))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-outcome-spill) : i64
    1))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-outcome-unassigned) : i64
    2))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-bucket [calls : i64]) : i64
    (cond [(= calls 0) 0] [(= calls 1) 1] [(< calls 4) 2] [else 3])))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-index [bucket : i64] [outcome : i64]) : i64
    (+ (* bucket 3) outcome)))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-add!
    [census : CompilerRegCallSpanCensus]
    [calls : i64]
    [outcome : i64]) : unit
    (let
      [counts : (Array i64) (struct-get census counts)]
      [index : i64
        (compiler-reg-call-span-census-index
          (compiler-reg-call-span-bucket calls)
          outcome)]
      (array-set! counts index (+ (array-ref counts index) 1)))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-count
    [census : CompilerRegCallSpanCensus]
    [bucket : i64]
    [outcome : i64]) : i64
    (array-ref
      (struct-get census counts)
      (compiler-reg-call-span-census-index bucket outcome))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-assignment-outcome
    [assignments : CompilerRegAssignmentList]
    [split-vars : CompilerLiveI64Set]
    [var : i64]) : i64
    (if (compiler-live-set-contains? split-vars var)
      (compiler-reg-call-span-outcome-register)
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.No)
          (compiler-reg-call-span-outcome-unassigned)]
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _)
              (compiler-reg-call-span-outcome-spill)]
            [_ (compiler-reg-call-span-outcome-register)])]))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-intervals!
    [census : CompilerRegCallSpanCensus]
    [intervals : CompilerRegIntervalSeq]
    [assignments : CompilerRegAssignmentList]
    [call-points : CompilerLiveI64Set]
    [split-vars : CompilerLiveI64Set]) : unit
    (let
      [index : i64 0]
      (while (< index (compiler-reg-interval-seq-count intervals))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref intervals index)]
            (compiler-reg-call-span-census-add!
              census
              (compiler-reg-call-set-count-in-range
                call-points
                (struct-get interval start)
                (struct-get interval end))
              (compiler-reg-call-span-assignment-outcome
                assignments
                split-vars
                (struct-get interval var))))
          (set! index (+ index 1)))))))

;; Caller-saved integer homes must clear this measured gate before they can be
;; enabled for call-spanning ranges: the register-home benefit must exceed
;; 2*calls_spanned memory ops (spill+reload per normal call) plus the spill-slot
;; and frame overhead. Split-selected originals count as register-covered even
;; though the canonical original var remains stack-homed across the call.
(cfg
  (any regalloc-census test)
  (define (compiler-reg-plan-call-span-census
    [func : CompilerIrFunction]
    [plan : CompilerRegPlan]) : CompilerRegCallSpanCensus
    (let
      [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
      [census : CompilerRegCallSpanCensus (compiler-reg-call-span-census-empty)]
      (begin
        (match plan
          [(CompilerRegPlan.Plan
              assignments
              ineligible
              intervals
              _
              split-vars
              _)
            (compiler-reg-call-span-census-intervals!
              census
              (compiler-reg-candidates intervals type-info ineligible false)
              assignments
              (compiler-reg-call-points func)
              (compiler-reg-call-split-shadows split-vars))])
        census))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-merge-into!
    [dst : CompilerRegCallSpanCensus]
    [src : CompilerRegCallSpanCensus]) : unit
    (let
      [dst-counts : (Array i64) (struct-get dst counts)]
      [src-counts : (Array i64) (struct-get src counts)]
      [index : i64 0]
      (begin
        (while (< index (array-length dst-counts))
          (begin
            (array-set!
              dst-counts
              index
              (+ (array-ref dst-counts index) (array-ref src-counts index)))
            (set! index (+ index 1))))
        unit))))

(cfg
  regalloc-census
  (define compiler-reg-call-span-census-total : CompilerRegCallSpanCensus
    (compiler-reg-call-span-census-empty)))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-reset!) : unit
    (set!
      compiler-reg-call-span-census-total
      (compiler-reg-call-span-census-empty))))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-record-plan!
    [func : CompilerIrFunction]
    [plan : CompilerRegPlan]) : unit
    (compiler-reg-call-span-census-merge-into!
      compiler-reg-call-span-census-total
      (compiler-reg-plan-call-span-census func plan))))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-row
    [bucket-name : String]
    [bucket : i64]) : String
    (string.concat5
      "regalloc-call-span-census|"
      bucket-name
      "|"
      (string.int->string
        (compiler-reg-call-span-census-count
          compiler-reg-call-span-census-total
          bucket
          (compiler-reg-call-span-outcome-register)))
      (string.concat5
        "|"
        (string.int->string
          (compiler-reg-call-span-census-count
            compiler-reg-call-span-census-total
            bucket
            (compiler-reg-call-span-outcome-spill)))
        "|"
        (string.int->string
          (compiler-reg-call-span-census-count
            compiler-reg-call-span-census-total
            bucket
            (compiler-reg-call-span-outcome-unassigned)))
        "\n"))))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-print!) : unit
    (begin
      (io.print-error
        "regalloc-call-span-census|calls_spanned|register|spill|unassigned\n")
      (io.print-error (compiler-reg-call-span-census-row "0" 0))
      (io.print-error (compiler-reg-call-span-census-row "1" 1))
      (io.print-error (compiler-reg-call-span-census-row "2-3" 2))
      (io.print-error (compiler-reg-call-span-census-row "4+" 3)))))

;; ---- move census (cfg regalloc-census) ------------------------------------
;; Categorise every harvested IR move by why it survived as a reg-reg copy, to
;; see where the move flood actually comes from. Slots:
;;   0 harvested      total moves seen
;;   1 coalesced      src/dst share a coalesce root -> emitted as a self-move
;;   2 samevalue_unco un-coalesced but proven SAME VALUE (#2 should catch these;
;;                    leftovers are multi-def / class-check rejects)
;;   3 disjoint_unco  un-coalesced, DISTINCT value, but live SEGMENTS are
;;                    DISJOINT -> the two could share one register via sound
;;                    hole-filling, so copy-hint *should* fold the copy away
;;   4 interfere      un-coalesced, distinct value, segments overlap -> a real
;;                    simultaneous-liveness copy (needs a split, else irreducible)
(cfg
  regalloc-census
  (define compiler-reg-move-census-counts : (Array i64)
    (array.make-array i64 16)))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-reset!) : unit
    (compiler-reg-fill-i64-array compiler-reg-move-census-counts 0)))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-bump! [slot : i64]) : unit
    (if (if (< slot 0)
      true
      (>= slot (array-length compiler-reg-move-census-counts)))
      unit
      (array-set!
        compiler-reg-move-census-counts
        slot
        (+ (array-ref compiler-reg-move-census-counts slot) 1)))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-find [parents : (Array i64)] [v : i64]) : i64
    (if (if (< v 0)
      true
      (>= v (array-length parents)))
      v
      (let
        [p : i64 (array-ref parents v)]
        (if (= p v)
          v
          (compiler-reg-move-census-find parents p))))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-record!
    [moves : CompilerRegMoveSeq]
    [parents : (Array i64)]
    [interval-index : CompilerRegIntervalIndex]
    [eff-index : CompilerRegIntervalIndex]
    [types : CompilerRegVarTypes]
    [group-vars : CompilerLiveI64Set]
    [sv-parents : (Array i64)]) : unit
    (let
      [slots : (Array CompilerRegMove) (struct-get moves slots)]
      [index : i64 (- (struct-get moves len) 1)]
      (while (>= index 0)
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [src : i64 (struct-get item src)]
            [dst : i64 (struct-get item dst)]
            (begin
              (compiler-reg-move-census-bump! 0)
              (let
                [rs : i64 (compiler-reg-move-census-find parents src)]
                [rd : i64 (compiler-reg-move-census-find parents dst)]
                (if (= rs rd)
                  (compiler-reg-move-census-bump! 1)
                  (if (compiler-reg-same-value-class? sv-parents src dst)
                    (compiler-reg-move-census-bump! 2)
                    (if (not
                      (compiler-reg-vars-interfere-segmented-index?
                        interval-index
                        src
                        dst))
                      ;; vars are segment-disjoint. Split by whether their
                      ;; coalesce ROOTS also stay disjoint (slot 5: a root-level
                      ;; copy-hint COULD place them in one register) or the merged
                      ;; classes now conflict (slot 6). Slot 7: of the rootfree
                      ;; ones, the PAIR is coalesce-vars-compatible? -> the merge
                      ;; was blocked by the all-pairs class check, not the pair.
                      (begin
                        (compiler-reg-move-census-bump! 3)
                        (if (compiler-reg-vars-interfere-segmented-index?
                          eff-index
                          rs
                          rd)
                          (compiler-reg-move-census-bump! 6)
                          (begin
                            (compiler-reg-move-census-bump! 5)
                            (if (compiler-reg-coalesce-vars-compatible?
                              interval-index
                              types
                              group-vars
                              src
                              dst
                              false
                              sv-parents)
                              (compiler-reg-move-census-bump! 7)
                              (if (if (compiler-live-set-contains?
                                group-vars
                                src)
                                true
                                (compiler-live-set-contains? group-vars dst))
                                (compiler-reg-move-census-bump! 8)
                                (if (not
                                  (compiler-reg-compatible-types? types src dst))
                                  (compiler-reg-move-census-bump! 9)
                                  (compiler-reg-move-census-bump! 10)))))))
                      (compiler-reg-move-census-bump! 4)))))))
          (set! index (- index 1)))))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-count-text [index : i64]) : String
    (string.int->string (array-ref compiler-reg-move-census-counts index))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-print!) : unit
    (begin
      (io.print-error
        "regalloc-move-census|harvested|coalesced|samevalue_unco|disjoint_unco|interfere|disjoint_rootfree|disjoint_rootblocked|rootfree_paircompat|rootfree_group|rootfree_typemismatch|rootfree_other\n")
      (io.print-error
        (string.concat5
          "regalloc-move-census|"
          (compiler-reg-move-census-count-text 0)
          "|"
          (compiler-reg-move-census-count-text 1)
          (string.concat5
            "|"
            (compiler-reg-move-census-count-text 2)
            "|"
            (compiler-reg-move-census-count-text 3)
            (string.concat5
              "|"
              (compiler-reg-move-census-count-text 4)
              "|"
              (compiler-reg-move-census-count-text 5)
              (string.concat5
                "|"
                (compiler-reg-move-census-count-text 6)
                "|"
                (compiler-reg-move-census-count-text 7)
                (string.concat5
                  "|"
                  (compiler-reg-move-census-count-text 8)
                  "|"
                  (compiler-reg-move-census-count-text 9)
                  (string.concat3
                    "|"
                    (compiler-reg-move-census-count-text 10)
                    "\n"))))))))))

;; Mark every var that is a member of `member-set` AND whose live interval
;; spans a call point as ineligible. Used by the SIMD planner to keep
;; call-spanning MASK values out of registers: opmask registers have no
;; ABI-nonvolatile subset, so a value kept in one across a call would be
;; clobbered by the callee (unsound).
(define (compiler-reg-mark-spanning-in-set
  [intervals : CompilerRegIntervalSeq]
  [member-set : CompilerLiveI64Set]
  [call-points : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [out : CompilerLiveI64Set ineligible]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref intervals index)]
            [var : i64 (struct-get interval var)]
            (if (if (compiler-live-set-contains? member-set var)
              (compiler-reg-call-set-in-range?
                call-points
                (struct-get interval start)
                (struct-get interval end))
              false)
              (set! out (compiler-live-set-insert out var))
              unit))
          (set! index (+ index 1))))
      out)))

;; The set of 2-word register-group vars in a function -- those defined by
;; CompilerIrInstr.Pack and those read by CompilerIrInstr.Word (the group value being extracted),
;; closed over Mov/Phi copies. These vars need TWO general-purpose registers.
(define (compiler-reg-group-vars-instr
  [set : CompilerLiveI64Set]
  [instr : CompilerIrInstr]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.Pack dst _ _) (compiler-live-set-insert set dst)]
    [(CompilerIrInstr.Word _ src _ _)
      (match src
        [(CompilerIrValue.Var v) (compiler-live-set-insert set v)]
        [_ set])]
    [_ set]))

(define (compiler-reg-group-vars-instr-seq
  [set : CompilerLiveI64Set]
  [instrs : CompilerIrInstrSeq]) : CompilerLiveI64Set
  (let
    [i : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (compiler-reg-group-vars-instr
              out
              (compiler-ir-instr-seq-ref instrs i)))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-group-vars-blocks
  [set : CompilerLiveI64Set]
  [blocks : CompilerIrBlockList]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-vars-blocks
            (compiler-reg-group-vars-instr-seq set instrs)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-group-vars-instr-seq out instrs))])
              (set! i (+ i 1))))
          out))]))

;; A Phi merging group values, or a Mov copying one, must mark its dst (and
;; the other endpoints) as a group var too -- otherwise the merged value gets a
;; single register and word1 is dropped. Group-ness flows both ways across these
;; copies, so we close the seed set over them to a fixpoint below.
(define (compiler-reg-phi-inputs-any-in-set?
  [set : CompilerLiveI64Set]
  [inputs : CompilerIrPhiInputList]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-inputs-any-in-set?
        set
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (match value
        [(CompilerIrValue.Var v)
          (if (compiler-live-set-contains? set v)
            true
            (compiler-reg-phi-inputs-any-in-set? set (box-get rest)))]
        [_ (compiler-reg-phi-inputs-any-in-set? set (box-get rest))])]))

(define (compiler-reg-phi-inputs-insert-all
  [set : CompilerLiveI64Set]
  [inputs : CompilerIrPhiInputList]) : CompilerLiveI64Set
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) set]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-inputs-insert-all
        set
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (let
        [next : CompilerLiveI64Set
          (match value
            [(CompilerIrValue.Var v) (compiler-live-set-insert set v)]
            [_ set])]
        (compiler-reg-phi-inputs-insert-all next (box-get rest)))]))

(define (compiler-reg-group-vars-propagate-instr
  [set : CompilerLiveI64Set]
  [instr : CompilerIrInstr]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var v)
          (if (or
            (compiler-live-set-contains? set dst)
            (compiler-live-set-contains? set v))
            (compiler-live-set-insert (compiler-live-set-insert set dst) v)
            set)]
        [_ set])]
    [(CompilerIrInstr.Phi dst inputs _)
      (if (or
        (compiler-live-set-contains? set dst)
        (compiler-reg-phi-inputs-any-in-set? set inputs))
        (compiler-reg-phi-inputs-insert-all
          (compiler-live-set-insert set dst)
          inputs)
        set)]
    [_ set]))

;; Iterate the instruction SEQ in place by index. The fixpoint re-runs the
;; propagation pass once per round; materializing each block's instr-seq to a list
;; every round (compiler-ir-instr-seq-to-list) allocated O(rounds * instrs) of
;; transient list nodes per function, which on the largest functions overflowed
;; the per-function scratch arena into a second chunk -- enough to expose the
;; arena rewind's latent reuse hazard and corrupt later emission. Reading the seq
;; by index allocates nothing.
(define (compiler-reg-group-vars-propagate-seq
  [set : CompilerLiveI64Set]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerLiveI64Set
  (if (>= index (compiler-ir-instr-seq-count instrs))
    set
    (compiler-reg-group-vars-propagate-seq
      (compiler-reg-group-vars-propagate-instr
        set
        (compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (compiler-reg-group-vars-propagate-blocks
  [set : CompilerLiveI64Set]
  [blocks : CompilerIrBlockList]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-vars-propagate-blocks
            (compiler-reg-group-vars-propagate-seq set instrs 0)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-group-vars-propagate-seq out instrs 0))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-group-vars-fixpoint
  [set : CompilerLiveI64Set]
  [blocks : CompilerIrBlockList]) : CompilerLiveI64Set
  (let
    [next : CompilerLiveI64Set
      (compiler-reg-group-vars-propagate-blocks set blocks)]
    (if (= (compiler-live-set-count next) (compiler-live-set-count set))
      next
      (compiler-reg-group-vars-fixpoint next blocks))))

;; Program-wide aggregate-type-name -> machine-word count map, mirroring
;; CompilerBackendProgramIndex.group-word-counts. The backend sets this once
;; before per-function planning (compiler-reg-set-group-counts!). It lets the
;; register allocator recognise a 2-word register-group value by its TYPE even
;; when this function contains no CompilerIrInstr.Pack that produced it -- e.g. the result
;; of a call returning a group, a group-typed parameter, or a Mov of a group.
;; Without it such a var is mis-classified as an 8-byte handle (see
;; compiler-reg-handle-type?), gets a single GP register, and emit-group-store
;; writes both words into that one register -- silently dropping word1. (At -O2
;; these tiny callees are inlined so the standalone pattern rarely survives; at
;; -O1 it is pervasive.) Self-tests never set it, so the map stays empty and the
;; structural Pack/Word seeding below is unaffected.
(define compiler-reg-group-counts : reg_string_i64_map.Map
  (reg_string_i64_map.with-capacity 8))
(define compiler-reg-group-class-masks : reg_string_i64_map.Map
  (reg_string_i64_map.with-capacity 8))

;; Direct C calls do not carry ABI metadata in CompilerIrInstr.Call. The backend
;; seeds this program-wide name set from extern signatures before planning.
(define compiler-reg-c-memory-call-names : reg_i64_i64_map.Map
  (reg_i64_i64_map.with-capacity 8))

(define (compiler-reg-set-group-counts! [counts : reg_string_i64_map.Map]) : unit
  (set! compiler-reg-group-counts counts))

(define (compiler-reg-set-group-class-masks! [masks : reg_string_i64_map.Map]) : unit
  (set! compiler-reg-group-class-masks masks))

(define (compiler-reg-clear-c-memory-call-names!) : unit
  (set! compiler-reg-c-memory-call-names (reg_i64_i64_map.with-capacity 8)))

(define (compiler-reg-add-c-memory-call-name! [name : i64]) : unit
  (reg_i64_i64_map.insert-ref! (&mut compiler-reg-c-memory-call-names) name 1))

(define (compiler-reg-c-memory-call-name? [name : i64]) : bool
  (reg_i64_i64_map.contains? (& compiler-reg-c-memory-call-names) name))

(define (compiler-reg-linux-abi? [abi : CompilerRegTargetAbi]) : bool
  (match abi
    [(CompilerRegTargetAbi.Linux) true]
    [(CompilerRegTargetAbi.Windows) false]))

(define (compiler-reg-c-memory-marker-array-from?
  [values : (Array CompilerIrValue)]
  [index : i64]) : bool
  ;; Lowering encodes a by-memory aggregate as value, byte-size, Unit. Indirect
  ;; C calls have no signature id, so this marker is their exact local signal.
  (if (>= (+ index 1) (array-length values))
    false
    (match (array-ref values index)
      [(CompilerIrValue.I64 size)
        (if (and
          (> size 0)
          (match (array-ref values (+ index 1))
            [(CompilerIrValue.Unit) true]
            [_ false]))
          true
          (compiler-reg-c-memory-marker-array-from? values (+ index 1)))]
      [_ (compiler-reg-c-memory-marker-array-from? values (+ index 1))])))

(define (compiler-reg-call-args-have-c-memory-marker?
  [args : CompilerIrCallArgs]) : bool
  (match args
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-c-memory-marker-array-from? values 1)]
    [_ false]))

;; The aggregate type name a value carries (mirror of
;; compiler-backend-aggregate-type-name); empty for non-aggregate types.
(define (compiler-reg-aggregate-type-name-with-seg-bases
  [type-segment-bases : i64]
  [ty : AstType]) : String
  (match ty
    [(AstType.Struct name) (ast-nominal-name-id-display name)]
    [(AstType.StructArgs name _) (ast-nominal-name-id-display name)]
    [(AstType.Enum name) (ast-nominal-name-id-display name)]
    [(AstType.EnumArgs name _) (ast-nominal-name-id-display name)]
    [(AstType.Region _ inner)
      (compiler-reg-aggregate-type-name-with-seg-bases
        type-segment-bases
        (ast-type-segment-bases-get type-segment-bases inner))]
    [_ ""]))

;; True when a var's type is a >=2-word register-group per the program map.
(define (compiler-reg-type-register-group?
  [type-segment-bases : i64]
  [ty : AstType]) : bool
  (let
    [name : String
      (compiler-reg-aggregate-type-name-with-seg-bases type-segment-bases ty)]
    (if (string.eq name "")
      false
      (match (reg_string_i64_map.get (& compiler-reg-group-counts) name)
        [(reg_string_i64_map.LookupFound count) (> count 1)]
        [(reg_string_i64_map.LookupMissing) false]))))

(define (compiler-reg-type-register-group-has-sse?
  [type-segment-bases : i64]
  [ty : AstType]) : bool
  (let
    [name : String
      (compiler-reg-aggregate-type-name-with-seg-bases type-segment-bases ty)]
    (if (string.eq name "")
      false
      (match (reg_string_i64_map.get (& compiler-reg-group-class-masks) name)
        [(reg_string_i64_map.LookupFound mask) (> mask 0)]
        [(reg_string_i64_map.LookupMissing) false]))))

(define (compiler-reg-type-register-group-word-sse?
  [type-segment-bases : i64]
  [ty : AstType]
  [word-index : i64]) : bool
  (let
    [name : String
      (compiler-reg-aggregate-type-name-with-seg-bases type-segment-bases ty)]
    (if (or (string.eq name "") (< word-index 0) (> word-index 1))
      false
      (match (reg_string_i64_map.get (& compiler-reg-group-class-masks) name)
        [(reg_string_i64_map.LookupFound mask)
          (not
            (=
              (bit-and
                mask
                (if (= word-index 0)
                  1
                  2))
              0))]
        [(reg_string_i64_map.LookupMissing) false]))))

(define (compiler-reg-var-register-group-has-sse?
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [var : i64]) : bool
  (match (compiler-reg-var-types-lookup types var)
    [(CompilerRegMaybeType.Some ty)
      (compiler-reg-type-register-group-has-sse? type-segment-bases ty)]
    [(CompilerRegMaybeType.No) false]))

;; Array-view form of the seed below: same ascending-id visit order, indexed
;; instead of walked.
(define (compiler-reg-group-vars-from-types-seq
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [present : (Array i64) (struct-get types present)]
    [items : (Array AstType) (struct-get types items)]
    [count : i64 (array-length present)]
    [index : i64 0]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (if (= (array-ref present index) 0)
            unit
            (if (compiler-reg-type-register-group?
              type-segment-bases
              (array-ref items index))
              (set! out (compiler-live-set-insert out index))
              unit))
          (set! index (+ index 1))))
      out)))

;; Seed every var whose TYPE is a 2-word register-group (the type-based group
;; vars the structural Pack/Word scan misses).
(define (compiler-reg-group-vars-from-types
  [type-segment-bases : i64]
  [types : CompilerRegVarTypeList]
  [set : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-group-vars-from-types-seq type-segment-bases seq set)]
    [(CompilerRegVarTypeList.Nil) set]
    [(CompilerRegVarTypeList.Cons item rest)
      (compiler-reg-group-vars-from-types
        type-segment-bases
        (box-get rest)
        (if (compiler-reg-type-register-group?
          type-segment-bases
          (struct-get item ty))
          (compiler-live-set-insert set (struct-get item var))
          set))]))

(define (compiler-reg-function-group-vars
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [types : CompilerRegVarTypeList]) : CompilerLiveI64Set
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-group-vars-fixpoint
        (compiler-reg-group-vars-from-types
          type-segment-bases
          types
          (compiler-reg-group-vars-blocks (compiler-live-set-empty) blocks))
        blocks)]))

;; LLVM-style coalescing-by-rename. LLVM removes a copy by renaming
;; the two virtual registers into ONE, so a coalesced class is a single value the
;; allocator places atomically. Here: collapse each coalesce class to its root
;; var. `compiler-reg-merged-root-index` returns an interval index in which ONLY
;; the root carries an interval -- the merged [min-start, max-end] over all class
;; members -- and every non-root member is dropped (start = -1, excluded from the
;; candidate list). The allocator then sees one indivisible candidate per class:
;; one placement, one eviction unit, one register, across every pass and pool.
;; Members inherit the root's location via compiler-reg-expand-class-assignments.
;; The merged coarse interval drives interference; a singleton var's coarse
;; interval already equals its live range, so non-coalesced values are unaffected.
(define (compiler-reg-interval-seq-insert-merged
  [segments : CompilerRegIntervalSeq]
  [var : i64]
  [start : i64]
  [end : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (+ (compiler-reg-interval-seq-count segments) 1))]
    [merged-start : i64 start]
    [merged-end : i64 end]
    [inserted : bool false]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segments))
        (let
          [head : CompilerRegInterval
            (compiler-reg-interval-seq-ref segments index)]
          (begin
            (let
              [head-start : i64 (struct-get head start)]
              [head-end : i64 (struct-get head end)]
              (cond
                [(< head-end merged-start)
                  (set! out (compiler-reg-interval-seq-append out head))]
                [(< merged-end head-start)
                  (begin
                    (if inserted
                      unit
                      (begin
                        (set!
                          out
                          (compiler-reg-interval-seq-append
                            out
                            (CompilerRegInterval var merged-start merged-end)))
                        (set! inserted true)))
                    (set! out (compiler-reg-interval-seq-append out head)))]
                [else
                  (begin
                    (if (< head-start merged-start)
                      (set! merged-start head-start)
                      unit)
                    (if (> head-end merged-end)
                      (set! merged-end head-end)
                      unit))]))
            (set! index (+ index 1)))))
      (if inserted
        out
        (compiler-reg-interval-seq-append
          out
          (CompilerRegInterval var merged-start merged-end))))))

(define (compiler-reg-union-segments
  [src : CompilerRegIntervalSeq]
  [root : i64]
  [dst : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq dst]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count src))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref src index)]
            (set!
              out
              (compiler-reg-interval-seq-insert-merged
                out
                root
                (struct-get interval start)
                (struct-get interval end))))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-merged-root-index
  [coalesce : CompilerRegCoalesceMap]
  [interval-index : CompilerRegIntervalIndex]) : CompilerRegIntervalIndex
  (let
    [orig-starts : (Array i64) (struct-get interval-index starts)]
    [orig-ends : (Array i64) (struct-get interval-index ends)]
    [orig-segs : (Array CompilerRegIntervalSeq)
      (struct-get interval-index segments)]
    [parents : (Array i64) (struct-get coalesce parents)]
    [n : i64 (array-length orig-starts)]
    [root-starts : (Array i64) (array.make-array i64 n)]
    [root-ends : (Array i64) (array.make-array i64 n)]
    [root-segs : (Array CompilerRegIntervalSeq)
      (array.make-array CompilerRegIntervalSeq n)]
    [v : i64 0]
    (begin
      (compiler-reg-fill-i64-array root-starts -1)
      (compiler-reg-fill-i64-array root-ends -1)
      ;; Object-array entries are not valid empty sequences by default. Initialise
      ;; every root explicitly before accumulating its sorted segment union.
      (while (< v n)
        (begin
          (array-set! root-segs v (compiler-reg-interval-seq-empty))
          (set! v (+ v 1))))
      (set! v 0)
      (while (< v n)
        (begin
          (if (>= (array-ref orig-starts v) 0)
            (let
              [r : i64
                (if (< v (array-length parents))
                  (array-ref parents v)
                  v)]
              [rr : i64
                (if (and (>= r 0) (< r n))
                  r
                  v)]
              (begin
                (if (or
                  (< (array-ref root-starts rr) 0)
                  (< (array-ref orig-starts v) (array-ref root-starts rr)))
                  (array-set! root-starts rr (array-ref orig-starts v))
                  unit)
                (if (> (array-ref orig-ends v) (array-ref root-ends rr))
                  (array-set! root-ends rr (array-ref orig-ends v))
                  unit)
                ;; The root carries the UNION of its
                ;; members' segments. Normal coalescing only merges
                ;; non-interfering members, but same-value coalescing deliberately
                ;; admits overlapping members, so keep the root segment list
                ;; sorted and non-overlapping while preserving genuine holes.
                (array-set!
                  root-segs
                  rr
                  (compiler-reg-union-segments
                    (if (< v (array-length orig-segs))
                      (array-ref orig-segs v)
                      (compiler-reg-interval-seq-empty))
                    rr
                    (array-ref root-segs rr)))))
            unit)
          (set! v (+ v 1))))
      (CompilerRegIntervalIndex root-starts root-ends root-segs))))

;; Non-singleton coalesce roots are the only values whose segment holes are
;; intentionally widened by class merging, so only they may drive hole-aware
;; register reuse.
(define (compiler-reg-coalesce-merged-root-set-from
  [parents : (Array i64)]
  [index : i64]
  [out : CompilerLiveI64Set]) : CompilerLiveI64Set
  (if (>= index (array-length parents))
    out
    (let
      [root : i64 (array-ref parents index)]
      (compiler-reg-coalesce-merged-root-set-from
        parents
        (+ index 1)
        (if (and
          (>= root 0)
          (< root (array-length parents))
          (not (= root index)))
          (compiler-live-set-insert out root)
          out)))))

(define (compiler-reg-coalesce-merged-root-set
  [coalesce : CompilerRegCoalesceMap]) : CompilerLiveI64Set
  (compiler-reg-coalesce-merged-root-set-from
    (struct-get coalesce parents)
    0
    (compiler-live-set-empty)))

(define (compiler-reg-coalesce-root-set-from-vars-from
  [parents : (Array i64)]
  [source : CompilerLiveI64Set]
  [index : i64]
  [out : CompilerLiveI64Set]) : CompilerLiveI64Set
  (if (>= index (array-length parents))
    out
    (let
      [root : i64 (array-ref parents index)]
      [mapped : i64
        (if (and (>= root 0) (< root (array-length parents)))
          root
          index)]
      (compiler-reg-coalesce-root-set-from-vars-from
        parents
        source
        (+ index 1)
        (if (compiler-live-set-contains? source index)
          (compiler-live-set-insert out mapped)
          out)))))

(define (compiler-reg-coalesce-root-set-from-vars
  [coalesce : CompilerRegCoalesceMap]
  [source : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [parents : (Array i64) (struct-get coalesce parents)]
    (if (= (array-length parents) 0)
      source
      (compiler-reg-coalesce-root-set-from-vars-from
        parents
        source
        0
        (compiler-live-set-empty)))))

;; Expand a per-root assignment table to all original vars -- every
;; member of a coalesce class inherits its root's location (register or spill
;; slot). This realises the coalesce: the copy `member <- root` becomes
;; src-reg == dst-reg and is dropped at emission. A var whose root got no
;; location stays absent (spills by default).
(define (compiler-reg-expand-class-assignments
  [assignments : CompilerRegAssignmentTable]
  [coalesce : CompilerRegCoalesceMap]
  [storage-vars : CompilerLiveI64Set]
  [orig-starts : (Array i64)]
  [vars : i64]) : CompilerRegAssignmentTable
  (let
    [parents : (Array i64) (struct-get coalesce parents)]
    [out : CompilerRegAssignmentTable (compiler-reg-assignment-table-make vars)]
    [v : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (and
            (< v (array-length orig-starts))
            (>= (array-ref orig-starts v) 0)
            ;; Storage-identity vars (`Alloc` destinations and `AddrOf`
            ;; sources) need their own formula slot to hold the bytes whose
            ;; address is exposed. If coalescing merged them into a register
            ;; root, do not inherit that home; the original copy remains and
            ;; materializes the storage slot for the later AddrOf.
            (not (compiler-live-set-contains? storage-vars v)))
            (let
              [r : i64
                (if (< v (array-length parents))
                  (array-ref parents v)
                  v)]
              [rr : i64
                (if (and (>= r 0) (< r vars))
                  r
                  v)]
              (match (compiler-reg-assignment-table-lookup assignments rr)
                [(CompilerRegMaybeLocation.Some loc)
                  (begin
                    (compiler-reg-assignment-table-insert out v loc)
                    unit)]
                [(CompilerRegMaybeLocation.No) unit]))
            unit)
          (set! v (+ v 1))))
      out)))

;; ---------------------------------------------------------------------------
;; SplitKit Phase A step 0: coalesce/segment-preserving spill bookkeeping.
;; ---------------------------------------------------------------------------
;; The empty (budget-0) split plan: no minted pieces, no occupant splits. M1
;; threads this through CompilerRegPlan on every path so the per-sub-range model
;; is carried but inert; M2+ replace it with a populated plan from the greedy.
(define (compiler-reg-split-plan-empty) : CompilerRegSplitPlan
  (CompilerRegSplitPlan
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array CompilerRegOccupantSplit 0)))

;; The spill-weight eviction scores a candidate by its use count,
;; but a merged class root carries only its OWN var's weight -- which can be the
;; least-used member of the class (e.g. a phi result used once), so the eviction
;; underweights a hot coalesced loop value and spills it (crc32's accumulator).
;; Give the root the MAX weight over its members: that captures the class's
;; hottest reference rate (enough to keep a hot loop value resident) without
;; SUM's over-weighting, which would evict hot singletons that share the loop
;; (the reps var in spmd_reduce).
(define (compiler-reg-merge-ref-counts
  [coalesce : CompilerRegCoalesceMap]
  [ref-counts : (Array i64)]
  [vars : i64]) : (Array i64)
  (let
    [parents : (Array i64) (struct-get coalesce parents)]
    [out : (Array i64) (array.make-array i64 vars)]
    [v : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (< v (array-length ref-counts))
            (let
              [r : i64
                (if (< v (array-length parents))
                  (array-ref parents v)
                  v)]
              [rr : i64
                (if (and (>= r 0) (< r vars))
                  r
                  v)]
              [w : i64 (array-ref ref-counts v)]
              (if (> w (array-ref out rr))
                (array-set! out rr w)
                unit))
            unit)
          (set! v (+ v 1))))
      out)))

;; ============================================================================
;; LLVM-style per-vreg Greedy register allocator (RAGreedy). The single allocation
;; algorithm across the whole compiler: scalar integer (ABI-specific
;; caller/callee-saved pools with call-clobber as interference), SIMD/AVX integer
;; (the Linux callee-saved pool), and float/vector->XMM-family. For each
;; register class one selectOrSplit
;; pass over the coalesced ROOTS:
;;   * spill-weight PRIORITY ORDER (remat-discounted ref-counts desc, var asc) --
;;     the LLVM enqueue priority;
;;   * a GLOBAL per-physreg interference union (LiveIntervalUnion): a register is
;;     free for a root iff the SOUND segmented-index test clears against EVERY var
;;     holding it (prepass picks + already-assigned roots);
;;   * CALL-CLOBBER as interference: a caller-saved register is unavailable to a
;;     value whose live range crosses a call (the regmask clobbers it);
;;   * COPY-HINT biasing: try the copy-neighbour's register first;
;;   * remat-aware spill-weight EVICTION + the RS_* stage machine: clear a register
;;     all of whose interferers are strictly lower weight, else (split-eligible)
;;     mark RS_Split for the region-split post-pass, else spill. Strict weight order
;;     => terminating. Group/pair roots are left UNASSIGNED (backend stack-homes
;;     them); the call-spanning save/restore rescue then runs over the integer
;;     result.
(define (compiler-reg-greedy-pool-index-capacity) : i64
  (+ compiler-reg-id-mask-base compiler-reg-id-mask-count))

(define (compiler-reg-greedy-pool-index-build
  [reg-arr : (Array i64)]
  [rcount : i64]) : (Array i64)
  (let
    [out : (Array i64)
      (array.make-array i64 (compiler-reg-greedy-pool-index-capacity))]
    [i : i64 0]
    (begin
      (compiler-reg-fill-i64-array out -1)
      (while (< i rcount)
        (let
          [key : i64 (compiler-abi-register-ownership-id (array-ref reg-arr i))]
          (begin
            (if (and
              (>= key 0)
              (< key (array-length out))
              (< (array-ref out key) 0))
              (array-set! out key i)
              unit)
            (set! i (+ i 1)))))
      out)))

(define (compiler-reg-greedy-pool-index
  [occupancy : CompilerRegGreedyOccupancy]
  [reg : i64]) : i64
  (let
    [key : i64 (compiler-abi-register-ownership-id reg)]
    [index : (Array i64) (struct-get occupancy pool-index)]
    (if (and (>= key 0) (< key (array-length index)))
      (array-ref index key)
      -1)))

(define (compiler-reg-greedy-occupancy-word-index
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [word-index : i64]) : i64
  (+ (* reg-index (struct-get occupancy word-count)) word-index))

(define (compiler-reg-greedy-occupancy-set-bit!
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [var : i64]
  [present : bool]) : unit
  (let
    [primary : (Array i64) (struct-get occupancy primary)]
    [word-count : i64 (struct-get occupancy word-count)]
    (if (or (< reg-index 0) (< var 0) (>= var (array-length primary)))
      unit
      (let
        [word-index : i64 (compiler-live-set-word-index var)]
        (if (>= word-index word-count)
          unit
          (let
            [words : (Array i64) (struct-get occupancy words)]
            [flat-index : i64
              (compiler-reg-greedy-occupancy-word-index
                occupancy
                reg-index
                word-index)]
            [mask : i64 (compiler-live-set-bit-mask var)]
            [old : i64 (array-ref words flat-index)]
            (array-set!
              words
              flat-index
              (if present
                (bit-or old mask)
                (bit-and old (bit-xor mask -1))))))))))

(define (compiler-reg-greedy-occupancy-clear!
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : unit
  (let
    [primary : (Array i64) (struct-get occupancy primary)]
    [secondary : (Array i64) (struct-get occupancy secondary)]
    (if (or (< var 0) (>= var (array-length primary)))
      unit
      (let
        [first : i64 (array-ref primary var)]
        [second : i64 (array-ref secondary var)]
        (begin
          (compiler-reg-greedy-occupancy-set-bit! occupancy first var false)
          (if (and (>= second 0) (not (= first second)))
            (compiler-reg-greedy-occupancy-set-bit! occupancy second var false)
            unit)
          (array-set! primary var -1)
          (array-set! secondary var -1))))))

(define (compiler-reg-greedy-occupancy-assign!
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]
  [first : i64]
  [second : i64]) : unit
  (let
    [primary : (Array i64) (struct-get occupancy primary)]
    [secondary : (Array i64) (struct-get occupancy secondary)]
    (if (or (< var 0) (>= var (array-length primary)))
      unit
      (begin
        (compiler-reg-greedy-occupancy-clear! occupancy var)
        (array-set! primary var first)
        (array-set! secondary var second)
        (compiler-reg-greedy-occupancy-set-bit! occupancy first var true)
        (if (and (>= second 0) (not (= first second)))
          (compiler-reg-greedy-occupancy-set-bit! occupancy second var true)
          unit)))))

(define (compiler-reg-greedy-occupancy-record-location!
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]
  [location : CompilerRegLocation]) : unit
  (match location
    [(CompilerRegLocation.Register reg)
      (compiler-reg-greedy-occupancy-assign!
        occupancy
        var
        (compiler-reg-greedy-pool-index occupancy reg)
        -1)]
    [(CompilerRegLocation.RegisterPair first second)
      (compiler-reg-greedy-occupancy-assign!
        occupancy
        var
        (compiler-reg-greedy-pool-index occupancy first)
        (compiler-reg-greedy-pool-index occupancy second))]
    [(CompilerRegLocation.Spill _) unit]
    [(CompilerRegLocation.Remat _) unit]))

(define (compiler-reg-greedy-occupancy-make
  [assignments : CompilerRegAssignmentTable]
  [reg-arr : (Array i64)]
  [rcount : i64]) : CompilerRegGreedyOccupancy
  (let
    [present : (Array i64) (struct-get assignments present)]
    [items : (Array CompilerRegLocation) (struct-get assignments items)]
    [n : i64 (array-length present)]
    [word-count : i64
      (/
        (+ n (- (compiler-live-set-word-bits) 1))
        (compiler-live-set-word-bits))]
    [storage-word-count : i64
      (if (< word-count 1)
        1
        word-count)]
    [storage-reg-count : i64
      (if (< rcount 1)
        1
        rcount)]
    [words : (Array i64)
      (array.make-array i64 (* storage-reg-count storage-word-count))]
    [primary : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [secondary : (Array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [pool-index : (Array i64)
      (compiler-reg-greedy-pool-index-build reg-arr rcount)]
    [occupancy : CompilerRegGreedyOccupancy
      (CompilerRegGreedyOccupancy words word-count primary secondary pool-index)]
    [var : i64 0]
    (begin
      (compiler-reg-fill-i64-array words 0)
      (compiler-reg-fill-i64-array primary -1)
      (compiler-reg-fill-i64-array secondary -1)
      (while (< var n)
        (begin
          (if (= (array-ref present var) 1)
            (compiler-reg-greedy-occupancy-record-location!
              occupancy
              var
              (array-ref items var))
            unit)
          (set! var (+ var 1))))
      occupancy)))

(define (compiler-reg-greedy-assignment-register!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-arr : (Array i64)]
  [var : i64]
  [reg-index : i64]) : CompilerRegAssignmentTable
  (begin
    (compiler-reg-greedy-occupancy-assign! occupancy var reg-index -1)
    (compiler-reg-assignment-table-insert
      assignments
      var
      (CompilerRegLocation.Register (array-ref reg-arr reg-index)))))

(define (compiler-reg-greedy-assignment-spill!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : CompilerRegAssignmentTable
  (begin
    (compiler-reg-greedy-occupancy-clear! occupancy var)
    (compiler-reg-assignment-table-insert
      assignments
      var
      (CompilerRegLocation.Spill (compiler-reg-stack-slot-offset var)))))

(define (compiler-reg-greedy-assignment-unassign!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : CompilerRegAssignmentTable
  (begin
    (compiler-reg-greedy-occupancy-clear! occupancy var)
    (compiler-reg-assignment-table-unassign assignments var)))

(define (compiler-reg-greedy-id-list-to-array
  [regs : CompilerRegIdList]
  [out : (Array i64)]
  [i : i64]) : unit
  (match regs
    [(CompilerRegIdList.Nil) unit]
    [(CompilerRegIdList.Cons reg rest)
      (begin
        (if (< i (array-length out))
          (array-set! out i reg)
          unit)
        (compiler-reg-greedy-id-list-to-array (box-get rest) out (+ i 1)))]))

;; Max ref-count among vars holding `reg` that interfere with `var`; -1 if none.
(define (compiler-reg-greedy-interferer-max
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [var : i64]
  [reg-index : i64]
  [word-index : i64]
  [acc : i64]) : i64
  (if (>= word-index (struct-get occupancy word-count))
    acc
    (let
      [words : (Array i64) (struct-get occupancy words)]
      [bits : i64
        (array-ref
          words
          (compiler-reg-greedy-occupancy-word-index
            occupancy
            reg-index
            word-index))]
      [best : i64 acc]
      (begin
        (while (not (= bits 0))
          (let
            [bit : i64 (compiler-reg-low-bit-index32 bits)]
            [other : i64 (+ (* word-index (compiler-live-set-word-bits)) bit)]
            (begin
              (if (and
                (not (= other var))
                (compiler-reg-vars-interfere-segmented-index?
                  interval-index
                  var
                  other))
                (let
                  [weight : i64
                    (if (< other (array-length ref-counts))
                      (array-ref ref-counts other)
                      0)]
                  (if (> weight best)
                    (set! best weight)
                    unit))
                unit)
              (set! bits (bit-and bits (- bits 1))))))
        (compiler-reg-greedy-interferer-max
          occupancy
          interval-index
          ref-counts
          var
          reg-index
          (+ word-index 1)
          best)))))

(define (compiler-reg-greedy-reg-free?
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [var : i64]
  [reg-index : i64]) : bool
  (=
    (compiler-reg-greedy-interferer-max
      occupancy
      interval-index
      ref-counts
      var
      reg-index
      0
      (- 0 1))
    (- 0 1)))

;; {rax,rdx}: the registers an idiv hard-clobbers (rax:rdx outputs). The INT_MIN/-1
;; overflow guard temps are no longer hardcoded to %r10/%r11 -- the guard scavenges
;; free registers (compiler-backend-div-overflow-guard-asm-with-plan), avoiding any
;; div-spanning value via the live query, so a div-spanning var may now use
;; %r10/%r11. rax stays reserved.
(define (compiler-reg-greedy-div-clobber-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-rax
    (compiler-reg-id-cons compiler-reg-id-rdx CompilerRegIdList.Nil)))

;; Caller-saved registers a div/shift-spanning (but NOT call-spanning) var may not
;; use: div-span -> {rax,rdx}, shift-span -> {rcx}, unioned. The call-span case is
;; handled separately by the start-idx skip, so it is not represented here.
(define (compiler-reg-greedy-forbidden-regs
  [spans-div : bool]
  [spans-shift : bool]) : CompilerRegIdList
  (let
    [div-part : CompilerRegIdList
      (if spans-div
        (compiler-reg-greedy-div-clobber-registers)
        CompilerRegIdList.Nil)]
    (if spans-shift
      (compiler-reg-id-cons compiler-reg-id-rcx div-part)
      div-part)))

(define (compiler-reg-greedy-first-free
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [var : i64]
  [reg-arr : (Array i64)]
  [ridx : i64]
  [rcount : i64]
  [forbidden : CompilerRegIdList]) : i64
  (if (>= ridx rcount)
    -1
    (let
      [reg : i64 (array-ref reg-arr ridx)]
      (if (and
        (not (compiler-reg-id-list-contains? forbidden reg))
        (compiler-reg-greedy-reg-free?
          occupancy
          interval-index
          ref-counts
          var
          ridx))
        ridx
        (compiler-reg-greedy-first-free
          occupancy
          interval-index
          ref-counts
          var
          reg-arr
          (+ ridx 1)
          rcount
          forbidden)))))

;; Copy-hint register: the reg held by the copy-neighbour, if it is in the pool
;; and free for `var`. Biases `var` onto its move-partner's register.
(define (compiler-reg-greedy-hint-free-reg
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [copy-hints : (Array i64)]
  [allowed-regs : CompilerRegIdList]
  [var : i64]
  [forbidden : CompilerRegIdList]) : i64
  (if (or (< var 0) (>= var (array-length copy-hints)))
    -1
    (let
      [nb : i64 (array-ref copy-hints var)]
      (if (< nb 0)
        -1
        (match (compiler-reg-assignment-table-lookup assignments nb)
          [(CompilerRegMaybeLocation.Some loc)
            (match loc
              [(CompilerRegLocation.Register r)
                (let
                  [reg-index : i64 (compiler-reg-greedy-pool-index occupancy r)]
                  (if (and
                    (>= reg-index 0)
                    (not (compiler-reg-id-list-contains? forbidden r))
                    (compiler-reg-id-list-contains? allowed-regs r)
                    (compiler-reg-greedy-reg-free?
                      occupancy
                      interval-index
                      ref-counts
                      var
                      reg-index))
                    reg-index
                    -1))]
              [(CompilerRegLocation.RegisterPair _ _) -1]
              [(CompilerRegLocation.Spill _) -1]
              [(CompilerRegLocation.Remat _) -1])]
          [(CompilerRegMaybeLocation.No) -1])))))

;; RAGreedy Component 1 cascade cap (LLVM canEvictInterference / cascade number).
;; A resident may be evicted+requeued at most this many times; once its
;; evict-count reaches the cap it becomes UNEVICTABLE (see interferer-max-capped),
;; so it stays put and the would-be evictor spills instead. This bounds the total
;; number of (re-)allocation attempts to count*(cap+1) -> guaranteed termination,
;; independent of the strict-lower-weight quality gate.
(define (compiler-reg-greedy-evict-cascade-cap) : i64
  4)

;; A weight strictly larger than any real spill weight; returned by
;; interferer-max-capped when a register is pinned by an over-cap (unevictable)
;; resident, so the `< weight` evictability gate can never select it.
(define (compiler-reg-greedy-evict-inf) : i64
  1000000000)

;; Like compiler-reg-greedy-interferer-max, but cascade-aware: if any interferer
;; holding `reg` (and interfering with `var`) has already been evicted at least
;; `cap` times, returns evict-inf (the register is unevictable). Otherwise returns
;; the max interferer weight (-1 if no interferer), identical to interferer-max.
;; With every evict-count==0 this is byte-identical to interferer-max, so the
;; no-eviction forward pass is unchanged.
(define (compiler-reg-greedy-interferer-max-capped
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [evict-count : (Array i64)]
  [var : i64]
  [reg-index : i64]
  [word-index : i64]
  [acc : i64]) : i64
  (if (>= word-index (struct-get occupancy word-count))
    acc
    (let
      [words : (Array i64) (struct-get occupancy words)]
      [bits : i64
        (array-ref
          words
          (compiler-reg-greedy-occupancy-word-index
            occupancy
            reg-index
            word-index))]
      [best : i64 acc]
      (begin
        (while (and (not (= bits 0)) (< best (compiler-reg-greedy-evict-inf)))
          (let
            [bit : i64 (compiler-reg-low-bit-index32 bits)]
            [other : i64 (+ (* word-index (compiler-live-set-word-bits)) bit)]
            (begin
              (if (and
                (not (= other var))
                (compiler-reg-vars-interfere-segmented-index?
                  interval-index
                  var
                  other))
                (let
                  [ec : i64
                    (if (< other (array-length evict-count))
                      (array-ref evict-count other)
                      0)]
                  [weight : i64
                    (if (< other (array-length ref-counts))
                      (array-ref ref-counts other)
                      0)]
                  (if (>= ec (compiler-reg-greedy-evict-cascade-cap))
                    (set! best (compiler-reg-greedy-evict-inf))
                    (if (> weight best)
                      (set! best weight)
                      unit)))
                unit)
              (set! bits (bit-and bits (- bits 1))))))
        (if (>= best (compiler-reg-greedy-evict-inf))
          best
          (compiler-reg-greedy-interferer-max-capped
            occupancy
            interval-index
            ref-counts
            evict-count
            var
            reg-index
            (+ word-index 1)
            best))))))

;; First pool register all of whose interferers are STRICTLY lower weight than
;; `weight` (so clearing it costs less than spilling `var`) AND none of which is
;; over the cascade cap; "" if none.
(define (compiler-reg-greedy-first-evictable
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [evict-count : (Array i64)]
  [var : i64]
  [weight : i64]
  [reg-arr : (Array i64)]
  [ridx : i64]
  [rcount : i64]
  [forbidden : CompilerRegIdList]) : i64
  (if (>= ridx rcount)
    -1
    (let
      [reg : i64 (array-ref reg-arr ridx)]
      [m : i64
        (compiler-reg-greedy-interferer-max-capped
          occupancy
          interval-index
          ref-counts
          evict-count
          var
          ridx
          0
          (- 0 1))]
      (if (and
        (not (compiler-reg-id-list-contains? forbidden reg))
        (>= m 0)
        (< m weight))
        ridx
        (compiler-reg-greedy-first-evictable
          occupancy
          interval-index
          ref-counts
          evict-count
          var
          weight
          reg-arr
          (+ ridx 1)
          rcount
          forbidden)))))

;; RAGreedy Component 1: evict every resident holding `reg` that interferes with
;; `var`, then UNASSIGN it (present[]=0) and RE-ENQUEUE it (pending[]=1) for a
;; fresh allocation attempt, bumping its cascade evict-count. This replaces the
;; old whole-spill-on-evict (which gave the evicted resident no second chance):
;; the requeued resident competes again at its own priority and may land in a
;; different free register, or evict a still-lower resident, or finally spill.
;; first-evictable's cap gate guarantees no resident is requeued more than the
;; cascade cap, so the worklist terminates.
(define (compiler-reg-greedy-evict-requeue!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [pending : (Array i64)]
  [evict-count : (Array i64)]
  [heap : CompilerRegGreedyHeap]
  [ref-counts : (Array i64)]
  [var : i64]
  [reg-index : i64]
  [word-index : i64]) : unit
  (if (>= word-index (struct-get occupancy word-count))
    unit
    (let
      [words : (Array i64) (struct-get occupancy words)]
      [bits : i64
        (array-ref
          words
          (compiler-reg-greedy-occupancy-word-index
            occupancy
            reg-index
            word-index))]
      (begin
        (while (not (= bits 0))
          (let
            [bit : i64 (compiler-reg-low-bit-index32 bits)]
            [other : i64 (+ (* word-index (compiler-live-set-word-bits)) bit)]
            (begin
              (if (and
                (not (= other var))
                (compiler-reg-vars-interfere-segmented-index?
                  interval-index
                  var
                  other))
                (begin
                  (compiler-reg-greedy-assignment-unassign!
                    assignments
                    occupancy
                    other)
                  (if (< other (array-length pending))
                    (begin
                      (array-set! pending other 1)
                      (compiler-reg-greedy-heap-push! heap ref-counts other))
                    unit)
                  (if (< other (array-length evict-count))
                    (array-set!
                      evict-count
                      other
                      (+ (array-ref evict-count other) 1))
                    unit))
                unit)
              (set! bits (bit-and bits (- bits 1))))))
        (compiler-reg-greedy-evict-requeue!
          assignments
          occupancy
          interval-index
          pending
          evict-count
          heap
          ref-counts
          var
          reg-index
          (+ word-index 1))))))

(define (compiler-reg-greedy-already-assigned?
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : bool
  (match (compiler-reg-assignment-table-lookup assignments var)
    [(CompilerRegMaybeLocation.Some _) true]
    [(CompilerRegMaybeLocation.No) false]))

;; RS_* stage machine (LLVM RAGreedy selectOrSplit, made explicit on the per-vreg
;; base). alloc-one! pops one root in priority order and returns its terminal
;; stage:
;;   RS_Assign (1) -- got a register (hint reg, free reg, or by evicting strictly
;;                    lower-weight interferers).
;;   RS_Split  (2) -- no register, but the spilled root has a split-eligible
;;                    (multi-segment / loop-carried) live range, so the function-
;;                    level region-splitter (compiler-reg-loop-split-*, run as the
;;                    backend post-pass on THIS plan) will rescue it: rewrite the
;;                    hot region to a fresh register-resident var + cold-edge
;;                    boundary copies, cost-gated by mentions x loop-depth. The
;;                    greedy returns a CompilerRegPlan (not a rewritten function),
;;                    so the IR-rewriting split necessarily lives in that post-pass;
;;                    this stage records the selectOrSplit decision.
;;   RS_Spill  (3) -- no register and not split-eligible: stack-home it.
;; The plan output is identical to the single-pass M1 (every non-assigned root is
;; spilled either way); the stage is the explicit decision the post-pass consumes.
(define (compiler-reg-greedy-stage-rs-new) : i64
  0)

(define (compiler-reg-greedy-stage-rs-assign) : i64
  1)

(define (compiler-reg-greedy-stage-rs-split) : i64
  2)

(define (compiler-reg-greedy-stage-rs-spill) : i64
  3)

;; Physical-register preference (arg-var -> ABI-arg-register coalescing). For an
;; OUTGOING call-argument var the plan records the greedy-integer-pool INDEX of the
;; SysV register it will be marshalled into (arg position i ->
;; compiler-backend-arg-reg i: 0=%rdi,1=%rsi,2=%rdx,3=%rcx,4=%r8,5=%r9). Homing the
;; arg value directly in that register turns the backend's `movq <home>, %rdi`
;; marshalling move into a `movq %rdi, %rdi` self-move that the peephole drops.
;; SOUND because an arg value is consumed AT the call (not live across it):
;;   * `spans-call` vars are gated out, so a genuinely call-spanning value is NEVER
;;     homed in a caller-saved arg register (it would be clobbered by the call it
;;     spans) -- those fall through to the callee-saved-only search below;
;;   * the preference is honoured ONLY when the register is in the active pool, not
;;     clobbered by a spanned div/shift (`forbidden`), and FREE over the var's whole
;;     interval (no interferer holds it). Any failure returns "" and the normal
;;     hint/free/evict pick runs, so a preference can never force a spill, evict a
;;     value, or create interference -- it only biases a free choice.
(define (compiler-reg-greedy-arg-pref-reg
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [arg-prefs : (Array i64)]
  [reg-arr : (Array i64)]
  [rcount : i64]
  [var : i64]
  [forbidden : CompilerRegIdList]
  [spans-call : bool]) : i64
  (if (or spans-call (< var 0) (>= var (array-length arg-prefs)))
    -1
    (let
      [idx : i64 (array-ref arg-prefs var)]
      (if (or (< idx 0) (>= idx rcount))
        -1
        (let
          [reg : i64 (array-ref reg-arr idx)]
          (if (and
            (not (compiler-reg-id-list-contains? forbidden reg))
            (compiler-reg-greedy-reg-free?
              occupancy
              interval-index
              ref-counts
              var
              idx))
            idx
            -1))))))

(define (compiler-reg-greedy-alloc-one!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [copy-hints : (Array i64)]
  [arg-prefs : (Array i64)]
  [group-vars : CompilerLiveI64Set]
  [param-roots : CompilerLiveI64Set]
  [regs : CompilerRegIdList]
  [reg-arr : (Array i64)]
  [rcount : i64]
  [var : i64]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [callee-regs : CompilerRegIdList]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (Array CompilerRegIdList)]
  [pending : (Array i64)]
  [evict-count : (Array i64)]
  [heap : CompilerRegGreedyHeap]) : i64
  (if (or
    (compiler-reg-greedy-already-assigned? assignments var)
    (compiler-live-set-contains? group-vars var))
    (compiler-reg-greedy-stage-rs-new)
    (let
      ;; Per-register clobber (15c). A call-spanning value may use NO caller-saved
      ;; reg (start past the caller-saved prefix, callee-saved copy-hints only) --
      ;; the original coarse rule. A value that spans only a div/shift may still use
      ;; the caller-saved regs that op does NOT clobber: it searches the whole pool
      ;; (start-idx 0) with `forbidden` excluding just {rax,rdx} (div) and/or
      ;; {rcx} (shift).
      [spans-call : bool
        (compiler-reg-greedy-var-spans-clobber? interval-index call-points var)]
      [spans-div : bool
        (compiler-reg-greedy-var-spans-clobber? interval-index div-points var)]
      [spans-shift : bool
        (compiler-reg-greedy-var-spans-clobber? interval-index shift-points var)]
      ;; M-A (RC1) v1: a param (or a coalesce class containing one) is restricted
      ;; to CALLEE-SAVED homes regardless of call-spanning. The entry copy writes
      ;; the home in the prologue; a caller-saved home could be clobbered by a
      ;; later param's entry-copy scratch or an early scavenge, and the incoming
      ;; SysV arg registers are all caller-saved, so CSR homes are the copy-safe
      ;; set (the prologue saves CSRs BEFORE the param copies run).
      [is-param : bool (compiler-live-set-contains? param-roots var)]
      [csr-only : bool (or spans-call is-param)]
      [start-idx : i64
        (if csr-only
          caller-saved-count
          0)]
      [hint-regs : CompilerRegIdList
        (if csr-only
          callee-regs
          regs)]
      [scratch-forbidden : CompilerRegIdList
        (if (and (>= var 0) (< var (array-length scratch-excluded)))
          (array-ref scratch-excluded var)
          CompilerRegIdList.Nil)]
      [forbidden : CompilerRegIdList
        (let
          [base : CompilerRegIdList
            (if csr-only
              CompilerRegIdList.Nil
              (compiler-reg-greedy-forbidden-regs spans-div spans-shift))]
          (compiler-reg-id-list-append
            scratch-forbidden
            (if (and (>= unspillable-from 0) (>= var unspillable-from))
              (compiler-reg-id-list-append
                (compiler-reg-scratch-div-fixed-registers)
                base)
              base)))]
      ;; Highest-priority bias: if this var is an outgoing call argument, try its
      ;; ABI arg register first (free-only, never evicting). Falls through to the
      ;; copy-hint / first-free / evict pick when the arg register is unavailable.
      ;; csr-only (call-spanning OR param) declines: arg registers are all
      ;; caller-saved.
      [pref : i64
        (compiler-reg-greedy-arg-pref-reg
          occupancy
          interval-index
          ref-counts
          arg-prefs
          reg-arr
          rcount
          var
          forbidden
          csr-only)]
      [hint : i64
        (compiler-reg-greedy-hint-free-reg
          assignments
          occupancy
          interval-index
          ref-counts
          copy-hints
          hint-regs
          var
          forbidden)]
      ;; The ABI arg-register preference takes priority over the copy hint; both
      ;; are free-only picks (no eviction), so a single nonnegative test assigns
      ;; whichever applies and otherwise falls through to first-free/evict/spill.
      [chosen : i64
        (if (>= pref 0)
          pref
          hint)]
      (if (>= chosen 0)
        (begin
          (compiler-reg-greedy-assignment-register!
            assignments
            occupancy
            reg-arr
            var
            chosen)
          (compiler-reg-greedy-stage-rs-assign))
        (let
          [free : i64
            (compiler-reg-greedy-first-free
              occupancy
              interval-index
              ref-counts
              var
              reg-arr
              start-idx
              rcount
              forbidden)]
          (if (>= free 0)
            (begin
              (compiler-reg-greedy-assignment-register!
                assignments
                occupancy
                reg-arr
                var
                free)
              (compiler-reg-greedy-stage-rs-assign))
            (let
              [weight : i64
                (if (< var (array-length ref-counts))
                  (array-ref ref-counts var)
                  0)]
              [ev : i64
                (compiler-reg-greedy-first-evictable
                  occupancy
                  interval-index
                  ref-counts
                  evict-count
                  var
                  weight
                  reg-arr
                  start-idx
                  rcount
                  forbidden)]
              (if (>= ev 0)
                (begin
                  (compiler-reg-greedy-evict-requeue!
                    assignments
                    occupancy
                    interval-index
                    pending
                    evict-count
                    heap
                    ref-counts
                    var
                    ev
                    0)
                  (compiler-reg-greedy-assignment-register!
                    assignments
                    occupancy
                    reg-arr
                    var
                    ev)
                  (compiler-reg-greedy-stage-rs-assign))
                ;; Synthetic scratch requirements have no stack representation:
                ;; leave an impossible placement unassigned for the retained
                ;; post-pass/scavenger fallback. Real values keep the ordinary
                ;; whole-interval spill path.
                (if (and (>= unspillable-from 0) (>= var unspillable-from))
                  (compiler-reg-greedy-stage-rs-new)
                  (begin
                    (compiler-reg-greedy-assignment-spill!
                      assignments
                      occupancy
                      var)
                    (if (compiler-reg-interval-index-var-has-segments?
                      interval-index
                      var)
                      (compiler-reg-greedy-stage-rs-split)
                      (compiler-reg-greedy-stage-rs-spill))))))))))))

(define (compiler-reg-greedy-collect-vars
  [candidates : CompilerRegIntervalSeq]
  [out : (Array i64)]
  [i : i64]) : i64
  (let
    [index : i64 0]
    [at : i64 i]
    (begin
      (while (< index (compiler-reg-interval-seq-count candidates))
        (begin
          (let
            [var : i64
              (struct-get (compiler-reg-interval-seq-ref candidates index) var)]
            (begin
              (if (< at (array-length out))
                (array-set! out at var)
                unit)
              (set! at (+ at 1))))
          (set! index (+ index 1))))
      at)))

(define (compiler-reg-greedy-weight-before?
  [ref-counts : (Array i64)]
  [a : i64]
  [b : i64]) : bool
  (let
    [wa : i64
      (if (< a (array-length ref-counts))
        (array-ref ref-counts a)
        0)]
    [wb : i64
      (if (< b (array-length ref-counts))
        (array-ref ref-counts b)
        0)]
    (if (> wa wb)
      true
      (if (< wa wb)
        false
        (< a b)))))

(define (compiler-reg-greedy-sort-insert!
  [arr : (Array i64)]
  [ref-counts : (Array i64)]
  [j : i64]) : unit
  (if (<= j 0)
    unit
    (let
      [cur : i64 (array-ref arr j)]
      [prev : i64 (array-ref arr (- j 1))]
      (if (compiler-reg-greedy-weight-before? ref-counts cur prev)
        (begin
          (array-set! arr j prev)
          (array-set! arr (- j 1) cur)
          (compiler-reg-greedy-sort-insert! arr ref-counts (- j 1)))
        unit))))

(define (compiler-reg-greedy-sort!
  [arr : (Array i64)]
  [ref-counts : (Array i64)]
  [i : i64]
  [count : i64]) : unit
  (if (>= i count)
    unit
    (begin
      (compiler-reg-greedy-sort-insert! arr ref-counts i)
      (compiler-reg-greedy-sort! arr ref-counts (+ i 1) count))))

;; Combine the remat-DISCOUNTED spill weight (primary eviction priority) with the
;; RAW (undiscounted) use-density (secondary tie-break) into a single key:
;;   combined = discounted * (maxRaw + 1) + raw
;; Sorting/eviction by `combined` therefore orders first by discounted weight
;; (remat values are cheaper to spill, so they rank lower and spill first) and,
;; among equal discounted weight, by raw use count (the genuinely coldest value
;; spills first). The /2 remat discount collapses distinct use counts to the same
;; small integer; without the raw secondary key the greedy would spill an
;; arbitrary tied value (e.g. a 2-use value over the 1-use coldest). maxRaw+1 as
;; the radix keeps `discounted` strictly dominant. A non-remat value (discounted
;; == raw) outranks a remat value of equal raw, so remat is still preferred for
;; spilling.
(define (compiler-reg-greedy-combine-spill-weights
  [discounted : (Array i64)]
  [raw : (Array i64)]) : (Array i64)
  (let
    [n : i64 (array-length discounted)]
    [out : (Array i64) (array.make-array i64 n)]
    [max-raw : i64 0]
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (let
            [r : i64
              (if (< v (array-length raw))
                (array-ref raw v)
                0)]
            (if (> r max-raw)
              (set! max-raw r)
              unit))
          (set! v (+ v 1))))
      (set! v 0)
      (while (< v n)
        (begin
          (let
            [d : i64 (array-ref discounted v)]
            [r : i64
              (if (< v (array-length raw))
                (array-ref raw v)
                0)]
            (array-set! out v (+ (* d (+ max-raw 1)) r)))
          (set! v (+ v 1))))
      out)))

;; Binary max-heap over (spill weight desc, var-id asc) -- the exact
;; compiler-reg-greedy-weight-before? total order the O(n) pending-array scan
;; selected, so pops are bit-identical while costing O(log n). The pending array
;; stays authoritative for membership: entries it no longer marks are lazily
;; discarded on pop, so evict-requeue never needs a decrease-key.
(defstruct CompilerRegGreedyHeap
  (arr (Array i64))
  (len i64))

(define (compiler-reg-greedy-heap-weight [ref-counts : (Array i64)] [v : i64]) : i64
  (if (< v (array-length ref-counts))
    (array-ref ref-counts v)
    0))

(define (compiler-reg-greedy-heap-better?
  [ref-counts : (Array i64)]
  [a : i64]
  [b : i64]) : bool
  (let
    [wa : i64 (compiler-reg-greedy-heap-weight ref-counts a)]
    [wb : i64 (compiler-reg-greedy-heap-weight ref-counts b)]
    (if (> wa wb)
      true
      (if (= wa wb)
        (< a b)
        false))))

(define (compiler-reg-greedy-heap-swap! [arr : (Array i64)] [a : i64] [b : i64]) : unit
  (let
    [t : i64 (array-ref arr a)]
    (begin
      (array-set! arr a (array-ref arr b))
      (array-set! arr b t))))

(define (compiler-reg-greedy-heap-sift-up!
  [arr : (Array i64)]
  [ref-counts : (Array i64)]
  [index : i64]) : unit
  (if (<= index 0)
    unit
    (let
      [parent : i64 (/ (- index 1) 2)]
      (if (compiler-reg-greedy-heap-better?
        ref-counts
        (array-ref arr index)
        (array-ref arr parent))
        (begin
          (compiler-reg-greedy-heap-swap! arr index parent)
          (compiler-reg-greedy-heap-sift-up! arr ref-counts parent))
        unit))))

(define (compiler-reg-greedy-heap-sift-down!
  [arr : (Array i64)]
  [ref-counts : (Array i64)]
  [len : i64]
  [index : i64]) : unit
  (let
    [left : i64 (+ (* index 2) 1)]
    [right : i64 (+ (* index 2) 2)]
    (if (>= left len)
      unit
      (let
        [best : i64
          (if (compiler-reg-greedy-heap-better?
            ref-counts
            (array-ref arr left)
            (array-ref arr index))
            left
            index)]
        [best2 : i64
          (if (and
            (< right len)
            (compiler-reg-greedy-heap-better?
              ref-counts
              (array-ref arr right)
              (array-ref arr best)))
            right
            best)]
        (if (= best2 index)
          unit
          (begin
            (compiler-reg-greedy-heap-swap! arr index best2)
            (compiler-reg-greedy-heap-sift-down! arr ref-counts len best2)))))))

(define (compiler-reg-greedy-heap-copy-from!
  [next : (Array i64)]
  [old : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length old))
    unit
    (begin
      (array-set! next index (array-ref old index))
      (compiler-reg-greedy-heap-copy-from! next old (+ index 1)))))

(define (compiler-reg-greedy-heap-grow! [heap : CompilerRegGreedyHeap]) : unit
  (let
    [old : (Array i64) (struct-get heap arr)]
    [next : (Array i64) (array.make-array i64 (* (array-length old) 2))]
    (begin
      (compiler-reg-greedy-heap-copy-from! next old 0)
      (set! (struct-get heap arr) next))))

(define (compiler-reg-greedy-heap-push!
  [heap : CompilerRegGreedyHeap]
  [ref-counts : (Array i64)]
  [v : i64]) : unit
  (begin
    (if (>= (struct-get heap len) (array-length (struct-get heap arr)))
      (compiler-reg-greedy-heap-grow! heap)
      unit)
    (let
      [index : i64 (struct-get heap len)]
      (begin
        (array-set! (struct-get heap arr) index v)
        (set! (struct-get heap len) (+ index 1))
        (compiler-reg-greedy-heap-sift-up!
          (struct-get heap arr)
          ref-counts
          index)))))

(define (compiler-reg-greedy-heap-pop!
  [heap : CompilerRegGreedyHeap]
  [ref-counts : (Array i64)]
  [pending : (Array i64)]) : i64
  (if (<= (struct-get heap len) 0)
    (- 0 1)
    (let
      [arr : (Array i64) (struct-get heap arr)]
      [top : i64 (array-ref arr 0)]
      [last-index : i64 (- (struct-get heap len) 1)]
      (begin
        (array-set! arr 0 (array-ref arr last-index))
        (set! (struct-get heap len) last-index)
        (if (> last-index 0)
          (compiler-reg-greedy-heap-sift-down! arr ref-counts last-index 0)
          unit)
        (if (and
          (>= top 0)
          (< top (array-length pending))
          (= (array-ref pending top) 1))
          top
          (compiler-reg-greedy-heap-pop! heap ref-counts pending))))))

;; Seed the worklist: mark every collected root arr[i..count) pending. Non-roots
;; (group-var members, never-collected vars) stay pending=0 and are never popped.
(define (compiler-reg-greedy-worklist-seed!
  [arr : (Array i64)]
  [i : i64]
  [count : i64]
  [pending : (Array i64)]
  [heap : CompilerRegGreedyHeap]
  [ref-counts : (Array i64)]
  [scratch-base : i64]
  [scratch-phase : bool]) : unit
  (if (>= i count)
    unit
    (begin
      (let
        [v : i64 (array-ref arr i)]
        (if (and
          (>= v 0)
          (< v (array-length pending))
          (or
            (< scratch-base 0)
            (if scratch-phase
              (>= v scratch-base)
              (< v scratch-base))))
          (begin
            (array-set! pending v 1)
            (compiler-reg-greedy-heap-push! heap ref-counts v))
          unit))
      (compiler-reg-greedy-worklist-seed!
        arr
        (+ i 1)
        count
        pending
        heap
        ref-counts
        scratch-base
        scratch-phase))))

;; Re-entrant evict-and-requeue worklist loop (RAGreedy Component 1). Pop the
;; highest-weight pending root, dequeue it (pending=0), run selectOrSplit
;; (alloc-one!), and record its terminal RS_* stage. alloc-one! may, on the
;; tryEvict path, UNASSIGN + RE-ENQUEUE strictly-lower-weight residents (setting
;; their pending=1 and bumping evict-count); those get a fresh allocation attempt
;; here at their own priority. Termination: a resident is requeued at most
;; cascade-cap times (first-evictable refuses to evict an over-cap resident), so
;; the total pop count is bounded by count*(cap+1).
(define (compiler-reg-greedy-worklist-run!
  [pending : (Array i64)]
  [evict-count : (Array i64)]
  [heap : CompilerRegGreedyHeap]
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [copy-hints : (Array i64)]
  [arg-prefs : (Array i64)]
  [group-vars : CompilerLiveI64Set]
  [param-roots : CompilerLiveI64Set]
  [regs : CompilerRegIdList]
  [reg-arr : (Array i64)]
  [rcount : i64]
  [stages : (Array i64)]
  [n : i64]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [callee-regs : CompilerRegIdList]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (Array CompilerRegIdList)]) : unit
  (let
    [v : i64 (compiler-reg-greedy-heap-pop! heap ref-counts pending)]
    (if (< v 0)
      unit
      (begin
        (if (and (>= v 0) (< v (array-length pending)))
          (array-set! pending v 0)
          unit)
        (let
          [stg : i64
            (compiler-reg-greedy-alloc-one!
              assignments
              occupancy
              interval-index
              ref-counts
              copy-hints
              arg-prefs
              group-vars
              param-roots
              regs
              reg-arr
              rcount
              v
              call-points
              div-points
              shift-points
              callee-regs
              caller-saved-count
              unspillable-from
              scratch-excluded
              pending
              evict-count
              heap)]
          (if (and (>= v 0) (< v (array-length stages)))
            (array-set! stages v stg)
            unit))
        (compiler-reg-greedy-worklist-run!
          pending
          evict-count
          heap
          assignments
          occupancy
          interval-index
          ref-counts
          copy-hints
          arg-prefs
          group-vars
          param-roots
          regs
          reg-arr
          rcount
          stages
          n
          call-points
          div-points
          shift-points
          callee-regs
          caller-saved-count
          unspillable-from
          scratch-excluded)))))

;; Staged worklist driver (RAGreedy Component 1): re-entrant evict-and-requeue
;; priority worklist over the unassigned root set, processing highest-current-
;; weight first. Replaces the static forward recursion: when a higher-weight root
;; evicts a lower-weight resident, the resident is UNASSIGNED and RE-ENQUEUED for
;; another allocation attempt (instead of being whole-spilled with no second
;; chance) -- the foundation Component 2 (split-on-spill) builds on. With no
;; eviction firing (the strict descending-weight order makes tryEvict dead for
;; the initial pass) the worklist pops the same sorted sequence and produces the
;; same plan as the old forward pass. `arr[i..count)` are the sorted roots; the
;; per-root terminal RS_* stage is recorded in `stages` for the post-pass split.
(define (compiler-reg-greedy-alloc-all!
  [arr : (Array i64)]
  [i : i64]
  [count : i64]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [copy-hints : (Array i64)]
  [arg-prefs : (Array i64)]
  [group-vars : CompilerLiveI64Set]
  [param-roots : CompilerLiveI64Set]
  [regs : CompilerRegIdList]
  [reg-arr : (Array i64)]
  [rcount : i64]
  [stages : (Array i64)]
  [n : i64]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [callee-regs : CompilerRegIdList]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (Array CompilerRegIdList)]) : unit
  (let
    [cap : i64
      (if (< n 1)
        1
        n)]
    [pending : (Array i64) (array.make-array i64 cap)]
    [evict-count : (Array i64) (array.make-array i64 cap)]
    [heap : CompilerRegGreedyHeap
      (CompilerRegGreedyHeap
        (array.make-array
          i64
          (if (< (- count i) 1)
            1
            (- count i)))
        0)]
    [occupancy : CompilerRegGreedyOccupancy
      (compiler-reg-greedy-occupancy-make assignments reg-arr rcount)]
    (begin
      ;; Scratch pseudos have no stack home. Mark them at the eviction cascade
      ;; cap so a placed pseudo can evict/requeue a real value but can never be
      ;; evicted itself. Fixed rax/rdx roles remain precolored in the table;
      ;; their occupancy is represented by the existing div clobber set so the
      ;; atomic instruction's operands/results may meet at the boundary.
      (if (>= unspillable-from 0)
        (let
          [v : i64 unspillable-from]
          (while (< v cap)
            (begin
              (compiler-reg-greedy-occupancy-clear! occupancy v)
              (array-set! evict-count v (compiler-reg-greedy-evict-cascade-cap))
              (set! v (+ v 1)))))
        unit)
      ;; Establish the unchanged real-value coloring first. Scratch then joins
      ;; the same occupancy/worklist and may evict/requeue a cheaper real root;
      ;; a no-pressure site cannot perturb an already valid real plan merely by
      ;; changing equal-weight heap insertion order.
      (compiler-reg-greedy-worklist-seed!
        arr
        i
        count
        pending
        heap
        ref-counts
        unspillable-from
        false)
      (compiler-reg-greedy-worklist-run!
        pending
        evict-count
        heap
        assignments
        occupancy
        interval-index
        ref-counts
        copy-hints
        arg-prefs
        group-vars
        param-roots
        regs
        reg-arr
        rcount
        stages
        n
        call-points
        div-points
        shift-points
        callee-regs
        caller-saved-count
        unspillable-from
        scratch-excluded)
      (if (>= unspillable-from 0)
        (begin
          (compiler-reg-greedy-worklist-seed!
            arr
            i
            count
            pending
            heap
            ref-counts
            unspillable-from
            true)
          (compiler-reg-greedy-worklist-run!
            pending
            evict-count
            heap
            assignments
            occupancy
            interval-index
            ref-counts
            copy-hints
            arg-prefs
            group-vars
            param-roots
            regs
            reg-arr
            rcount
            stages
            n
            call-points
            div-points
            shift-points
            callee-regs
            caller-saved-count
            unspillable-from
            scratch-excluded))
        unit))))

;; Unified Greedy integer register pool: caller-saved zero-call scratch
;; (%r9/%rcx/%rdx) FIRST so non-call-spanning values prefer them -- no
;; prologue/epilogue save/restore, the LLVM CSR-cost try-order -- then the other
;; caller-saved pool members (%r10/%r11/%r8), then the callee-saved pool. The
;; first `caller-saved-count` entries are caller-saved: a value whose live range
;; spans a backend clobber-point (call site / op that clobbers caller-saved regs)
;; may NOT use them (it would be clobbered across the clobber), exactly the
;; regmask-as-interference rule. Such values start their register search at the
;; callee-saved offset. This folds the old prepass-partition +
;; caller-saved-overflow into ONE allocation pass.
(define (compiler-reg-greedy-integer-pool) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-rax
    (compiler-reg-id-cons
      compiler-reg-id-rsi
      (compiler-reg-id-cons
        compiler-reg-id-rdi
        (compiler-reg-id-cons
          compiler-reg-id-r9
          (compiler-reg-id-cons
            compiler-reg-id-rcx
            (compiler-reg-id-cons
              compiler-reg-id-rdx
              (compiler-reg-id-cons
                compiler-reg-id-r10
                (compiler-reg-id-cons
                  compiler-reg-id-r11
                  (compiler-reg-id-cons
                    compiler-reg-id-r8
                    (compiler-reg-sysv-integer-registers)))))))))))

(define (compiler-reg-greedy-caller-saved-count) : i64
  (-
    (compiler-reg-id-list-count (compiler-reg-greedy-integer-pool))
    (compiler-reg-id-list-count (compiler-reg-sysv-integer-registers))))

;; ABI-aware GP greedy pool. SysV is the byte-identical default pool above. Win64
;; differs ONLY in the caller/callee SPLIT: %rsi/%rdi are NONVOLATILE (callee-
;; saved) on Win64, so they must live in the callee-saved suffix (saved/restored
;; by the prologue, kept across calls) rather than the caller-saved prefix --
;; otherwise a Win64 function homes a value in %rsi/%rdi, treats it as clobbered
;; across calls, and clobbers the caller's nonvolatile register. All 14 registers
;; are in the pool for both ABIs; only the order (and thus caller-saved-count)
;; changes. The SysV self-host fixpoint cannot exercise this (SysV-only).
(define (compiler-reg-greedy-integer-pool-for-abi [abi : CompilerRegTargetAbi]) : CompilerRegIdList
  (match abi
    ;; M-G3 stage 2: when the backend enabled the per-function FPO flag, %rbp
    ;; joins as the LAST callee-saved register (index 14; the caller-saved
    ;; boundary stays 9 -- compiler-reg-greedy-caller-saved-count is derived
    ;; from the base pool, unchanged). Functions needing <= 5 CSRs keep their
    ;; previous homes.
    [(CompilerRegTargetAbi.Linux)
      (if compiler-reg-rbp-pool-enabled
        (compiler-reg-id-cons
          compiler-reg-id-rax
          (compiler-reg-id-cons
            compiler-reg-id-rsi
            (compiler-reg-id-cons
              compiler-reg-id-rdi
              (compiler-reg-id-cons
                compiler-reg-id-r9
                (compiler-reg-id-cons
                  compiler-reg-id-rcx
                  (compiler-reg-id-cons
                    compiler-reg-id-rdx
                    (compiler-reg-id-cons
                      compiler-reg-id-r10
                      (compiler-reg-id-cons
                        compiler-reg-id-r11
                        (compiler-reg-id-cons
                          compiler-reg-id-r8
                          (compiler-reg-sysv-integer-registers-with-rbp))))))))))
        (compiler-reg-greedy-integer-pool))]
    [(CompilerRegTargetAbi.Windows)
      ;; Win64: %rsi/%rdi are nonvolatile (callee-saved). The backend prologue/
      ;; epilogue saves them with the Win64 callee-save suffix. Keep the existing
      ;; r12-r15,rbx order first so old homes are stable until pressure reaches
      ;; the two extra Win64 nonvolatile registers. An FPO-eligible function
      ;; appends %rbp after both, preserving every existing home.
      ;; caller-saved (volatile) first: rax,rcx,rdx,r8,r9,r10,r11 (7), then the
      ;; backend-saved callee suffix r12-r15,rbx,rsi,rdi[,rbp].
      (let
        [base : CompilerRegIdList
          (compiler-reg-id-cons
            compiler-reg-id-rax
            (compiler-reg-id-cons
              compiler-reg-id-rcx
              (compiler-reg-id-cons
                compiler-reg-id-rdx
                (compiler-reg-id-cons
                  compiler-reg-id-r8
                  (compiler-reg-id-cons
                    compiler-reg-id-r9
                    (compiler-reg-id-cons
                      compiler-reg-id-r10
                      (compiler-reg-id-cons
                        compiler-reg-id-r11
                        (compiler-reg-id-list-append
                          (compiler-reg-sysv-integer-registers)
                          (compiler-reg-id-cons
                            compiler-reg-id-rsi
                            (compiler-reg-id-cons
                              compiler-reg-id-rdi
                              CompilerRegIdList.Nil))))))))))]
        (if compiler-reg-rbp-pool-enabled
          (compiler-reg-id-list-append
            base
            (compiler-reg-id-cons compiler-reg-id-rbp CompilerRegIdList.Nil))
          base))]))

(define (compiler-reg-greedy-caller-saved-count-for-abi
  [abi : CompilerRegTargetAbi]) : i64
  (match abi
    [(CompilerRegTargetAbi.Linux) (compiler-reg-greedy-caller-saved-count)]
    [(CompilerRegTargetAbi.Windows)
      ;; The optional %rbp is appended to the nonvolatile suffix and must not
      ;; move this boundary.
      (compiler-abi-caller-saved-gp-register-count abi)]))

;; Coarse clobber-span test: does var's [start,end] cross any clobber-point?
;; (The clobber-span half of the old per-register zero-call gate, sans the
;; conflict check which the LiveIntervalUnion test already covers.)
;; Out-of-range -> conservative spanning (callee-saved only).
(define (compiler-reg-greedy-var-spans-clobber?
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : CompilerLiveI64Set]
  [var : i64]) : bool
  (let
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    (if (and (>= var 0) (< var (array-length starts)))
      (compiler-reg-call-set-in-range?
        clobber-points
        (array-ref starts var)
        (array-ref ends var))
      true)))

(define (compiler-reg-low-xmm-forbidden-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    (compiler-abi-xmm-register-id 0)
    (compiler-reg-id-cons
      (compiler-abi-xmm-register-id 1)
      CompilerRegIdList.Nil)))

(define (compiler-reg-low-xmm-exclusions
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : CompilerLiveI64Set]) : (Array CompilerRegIdList)
  (let
    [vars : i64 (array-length (struct-get interval-index starts))]
    [out : (Array CompilerRegIdList) (array.make-array CompilerRegIdList vars)]
    [i : i64 0]
    (begin
      (while (< i vars)
        (begin
          (array-set!
            out
            i
            (if (compiler-reg-greedy-var-spans-clobber?
              interval-index
              clobber-points
              i)
              (compiler-reg-low-xmm-forbidden-registers)
              CompilerRegIdList.Nil))
          (set! i (+ i 1))))
      out)))

;; Integer call-argument register IDs by position. Invalid past the ABI
;; register arguments (the rest are stack-passed and get no preference).
(define (compiler-reg-abi-arg-reg [abi : CompilerRegTargetAbi] [pos : i64]) : i64
  (compiler-abi-gp-arg-register-id abi pos))

(define (compiler-reg-id-list-index-of
  [regs : CompilerRegIdList]
  [want : i64]
  [i : i64]) : i64
  (match regs
    [(CompilerRegIdList.Nil) -1]
    [(CompilerRegIdList.Cons reg rest)
      (if (= reg want)
        i
        (compiler-reg-id-list-index-of (box-get rest) want (+ i 1)))]))

;; Greedy-integer-pool INDEX of the ABI register for integer arg position `pos`,
;; or -1 if `pos` is not a register-passed argument. Computed by searching the
;; live ABI pool definition, so it stays correct if the pool order changes.
(define (compiler-reg-greedy-arg-pool-index-for-abi
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [pos : i64]) : i64
  (let
    [reg : i64 (compiler-reg-abi-arg-reg abi pos)]
    (if (= reg compiler-reg-id-invalid)
      -1
      (compiler-reg-id-list-index-of pool reg 0))))

;; Record arg-var -> ABI-register preference (greedy-pool index) for one call
;; argument at integer position `pos`. Only IrValueVar args take a home; the
;; var is mapped to its coalesce root (parents) like the copy hints, and the first
;; preference for a root wins. Stack-passed positions yield -1 and are skipped.
(define (compiler-reg-arg-pref-value!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [value : CompilerIrValue]
  [pos : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match value
    [(CompilerIrValue.Var v)
      (let
        [idx : i64 (compiler-reg-greedy-arg-pool-index-for-abi abi pool pos)]
        (if (< idx 0)
          unit
          (let
            [root : i64
              (if (if (>= v 0)
                (< v (array-length parents))
                false)
                (array-ref parents v)
                v)]
            (if (if (>= root 0)
              (< root (array-length prefs))
              false)
              (if (< (array-ref prefs root) 0)
                (begin
                  (array-set! prefs root idx)
                  unit)
                unit)
              unit))))]
    [_ unit]))

(define (compiler-reg-arg-pref-array-at!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [values : (Array CompilerIrValue)]
  [i : i64]
  [pos : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (if (>= i (array-length values))
    unit
    (begin
      (compiler-reg-arg-pref-value!
        abi
        pool
        (array-ref values i)
        pos
        prefs
        parents)
      (compiler-reg-arg-pref-array-at!
        abi
        pool
        values
        (+ i 1)
        (+ pos 1)
        prefs
        parents))))

(define (compiler-reg-arg-pref-args-at!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [args : CompilerIrCallArgs]
  [start : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One a)
      (compiler-reg-arg-pref-value! abi pool a start prefs parents)]
    [(CompilerIrCallArgs.Two a b)
      (begin
        (compiler-reg-arg-pref-value! abi pool a start prefs parents)
        (compiler-reg-arg-pref-value! abi pool b (+ start 1) prefs parents))]
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-arg-pref-array-at! abi pool values 0 start prefs parents)]))

(define (compiler-reg-arg-pref-args!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [args : CompilerIrCallArgs]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (compiler-reg-arg-pref-args-at! abi pool args 0 prefs parents))

;; Outgoing call instructions whose integer args are marshalled through ABI arg
;; registers. The callee/function-pointer operand of the indirect forms is NOT an
;; argument and is left without a preference. Closure calls reserve ABI arg slot
;; 0 for the environment pointer, so their user-arg preferences start at slot 1.
;; Syscalls use a different register convention and are intentionally omitted.
(define (compiler-reg-arg-pref-instr!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [instr : CompilerIrInstr]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-reg-arg-pref-args! abi pool args prefs parents)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [args (struct-get (box-get payload-box) args)]
        (compiler-reg-arg-pref-args! abi pool args prefs parents))]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [args (struct-get (box-get payload-box) args)]
        (compiler-reg-arg-pref-args! abi pool args prefs parents))]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-reg-arg-pref-args! abi pool args prefs parents)]
    [(CompilerIrInstr.TailCallIndirect _ args _)
      (compiler-reg-arg-pref-args-at! abi pool args 1 prefs parents)]
    [(CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-arg-pref-args-at! abi pool args 1 prefs parents)]
    [(CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-arg-pref-args! abi pool args prefs parents)]
    [_ unit]))

;; M-C (part 2): call-result %rax preference. The backend stores a scalar call
;; result from %rax into the dst var's home (`movq %rax, <home>` via
;; emit-call-result-store), so homing the dst IN %rax turns that store into an
;; elided self-move. Record a free-only bias toward the pool index of %rax for
;; every var defined by a call-like instruction with a GP-scalar result. Same
;; substrate and consumption as the outgoing-arg preference: first-wins per
;; coalesce root, tried free-only in alloc-one! (never evicts), declined for
;; csr-only roots (call-spanning or param classes -- %rax is illegal across a
;; kind-0 clobber anyway), and filtered against the per-root forbidden set (a
;; div-spanning root already excludes %rax). Float results return in %xmm0 --
;; skipped. Group results use the return register PAIR -- their dst is a group
;; var alloc-one! skips before reading prefs, so a stray pref would be inert;
;; the C-ABI StoreResult forms write memory slots and are omitted entirely.
;; Registered AFTER the arg walk so an existing arg-register preference keeps
;; priority (either bias elides exactly one mov for arg-and-result vars).
(define (compiler-reg-result-pref-var!
  [dst : i64]
  [rax-idx : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (if (< rax-idx 0)
    unit
    (let
      [root : i64
        (if (if (>= dst 0)
          (< dst (array-length parents))
          false)
          (array-ref parents dst)
          dst)]
      (if (if (>= root 0)
        (< root (array-length prefs))
        false)
        (if (< (array-ref prefs root) 0)
          (begin
            (array-set! prefs root rax-idx)
            unit)
          unit)
        unit))))

(define (compiler-reg-result-pref-instr!
  [instr : CompilerIrInstr]
  [rax-idx : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Call dst _ _ ty)
      (if (compiler-reg-float-type? ty)
        unit
        (compiler-reg-result-pref-var! dst rax-idx prefs parents))]
    [(CompilerIrInstr.CallIndirect dst _ _ ty)
      (if (compiler-reg-float-type? ty)
        unit
        (compiler-reg-result-pref-var! dst rax-idx prefs parents))]
    [(CompilerIrInstr.CallIndirectC dst _ _ ty)
      (if (compiler-reg-float-type? ty)
        unit
        (compiler-reg-result-pref-var! dst rax-idx prefs parents))]
    [(CompilerIrInstr.Syscall dst _)
      (compiler-reg-result-pref-var! dst rax-idx prefs parents)]
    [_ unit]))

(define (compiler-reg-result-pref-seq!
  [instrs : CompilerIrInstrSeq]
  [rax-idx : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-result-pref-instr!
            (array-ref slots index)
            rax-idx
            prefs
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-result-pref-blocks!
  [blocks : CompilerIrBlockList]
  [rax-idx : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-result-pref-seq! instrs rax-idx prefs parents)])
        (compiler-reg-result-pref-blocks! (box-get rest) rax-idx prefs parents))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-result-pref-seq! instrs rax-idx prefs parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-arg-pref-seq!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [instrs : CompilerIrInstrSeq]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-arg-pref-instr!
            abi
            pool
            (array-ref slots index)
            prefs
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-arg-pref-blocks!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [blocks : CompilerIrBlockList]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-arg-pref-seq! abi pool instrs prefs parents)])
        (compiler-reg-arg-pref-blocks! abi pool (box-get rest) prefs parents))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-arg-pref-seq! abi pool instrs prefs parents)])
            (set! i (+ i 1)))))]))

;; Build the per-root physical-register preference array: each outgoing call-arg
;; var biased toward the ABI register it is marshalled into. Indexed by coalesce
;; root (like copy hints); -1 = no preference.
(define (compiler-reg-function-arg-prefs
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [coalesce : CompilerRegCoalesceMap]
  [n : i64]) : (Array i64)
  (let
    [prefs : (Array i64) (array.make-array i64 n)]
    [parents : (Array i64) (struct-get coalesce parents)]
    [pool : CompilerRegIdList (compiler-reg-greedy-integer-pool-for-abi abi)]
    (begin
      (compiler-reg-fill-i64-array prefs -1)
      (match func
        [(CompilerIrFunction.Function _ _ _ _ blocks)
          (begin
            (compiler-reg-arg-pref-blocks! abi pool blocks prefs parents)
            ;; M-C (part 2): call-result %rax bias fills roots the arg walk
            ;; left unbiased. The pool index is looked up from the live ABI pool
            ;; definition so it tracks any pool reorder (both ABIs: index 0).
            (compiler-reg-result-pref-blocks!
              blocks
              (compiler-reg-id-list-index-of pool compiler-reg-id-rax 0)
              prefs
              parents))])
      prefs)))

;; Float call arguments use independent XMM ordinals on SysV and shared argument
;; positions on Win64. Record only preferences that exist in the allocator's XMM
;; pool. Under scratch-vreg, XMM0/XMM1 are ordinary volatile homes as well as
;; leading ABI argument registers, so these preferences eliminate their moves.
;; `is-float` is supplied by the caller. Every caller already needs the same
;; classification to advance the argument-bank indices, and recomputing it here
;; walked the sorted var-type list a second time for the same value.
(define (compiler-reg-float-arg-pref-value!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [value : CompilerIrValue]
  [is-float : bool]
  [float-idx : i64]
  [position : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match value
    [(CompilerIrValue.Var v)
      (if is-float
        (let
          [abi-idx : i64
            (if (compiler-abi-arg-banks-independent? abi)
              float-idx
              position)]
          [reg : i64 (compiler-abi-float-arg-register-id abi abi-idx)]
          [idx : i64 (compiler-reg-id-list-index-of pool reg 0)]
          [root : i64
            (if (if (>= v 0)
              (< v (array-length parents))
              false)
              (array-ref parents v)
              v)]
          (if (and
            (>= idx 0)
            (if (>= root 0)
              (< root (array-length prefs))
              false)
            (< (array-ref prefs root) 0))
            (begin
              (array-set! prefs root idx)
              unit)
            unit))
        unit)]
    [_ unit]))

(define (compiler-reg-float-arg-pref-array!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [values : (Array CompilerIrValue)]
  [types : CompilerRegVarTypeList]
  [i : i64]
  [float-idx : i64]
  [position : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (if (>= i (array-length values))
    unit
    (let
      [value : CompilerIrValue (array-ref values i)]
      [is-float : bool (compiler-reg-call-arg-float? value types)]
      (begin
        (compiler-reg-float-arg-pref-value!
          abi
          pool
          value
          is-float
          float-idx
          position
          prefs
          parents)
        (compiler-reg-float-arg-pref-array!
          abi
          pool
          values
          types
          (+ i 1)
          (if is-float
            (+ float-idx 1)
            float-idx)
          (+ position 1)
          prefs
          parents)))))

(define (compiler-reg-float-arg-pref-args-at!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]
  [position : i64]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One a)
      (compiler-reg-float-arg-pref-value!
        abi
        pool
        a
        (compiler-reg-call-arg-float? a types)
        0
        position
        prefs
        parents)]
    [(CompilerIrCallArgs.Two a b)
      (let
        [a-float : bool (compiler-reg-call-arg-float? a types)]
        (begin
          (compiler-reg-float-arg-pref-value!
            abi
            pool
            a
            a-float
            0
            position
            prefs
            parents)
          (compiler-reg-float-arg-pref-value!
            abi
            pool
            b
            (compiler-reg-call-arg-float? b types)
            (if a-float
              1
              0)
            (+ position 1)
            prefs
            parents)))]
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-float-arg-pref-array!
        abi
        pool
        values
        types
        0
        0
        position
        prefs
        parents)]))

(define (compiler-reg-float-arg-pref-instr!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [instr : CompilerIrInstr]
  [types : CompilerRegVarTypeList]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-reg-float-arg-pref-args-at! abi pool args types 0 prefs parents)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [args (struct-get (box-get payload-box) args)]
        (compiler-reg-float-arg-pref-args-at!
          abi
          pool
          args
          types
          0
          prefs
          parents))]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [args (struct-get (box-get payload-box) args)]
        (compiler-reg-float-arg-pref-args-at!
          abi
          pool
          args
          types
          0
          prefs
          parents))]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-reg-float-arg-pref-args-at! abi pool args types 0 prefs parents)]
    [(CompilerIrInstr.TailCallIndirect _ args _)
      (compiler-reg-float-arg-pref-args-at! abi pool args types 1 prefs parents)]
    [(CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-float-arg-pref-args-at! abi pool args types 1 prefs parents)]
    [(CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-float-arg-pref-args-at! abi pool args types 0 prefs parents)]
    [_ unit]))

(define (compiler-reg-float-arg-pref-seq!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [instrs : CompilerIrInstrSeq]
  [types : CompilerRegVarTypeList]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [i : i64 0]
    (while (< i count)
      (begin
        (compiler-reg-float-arg-pref-instr!
          abi
          pool
          (array-ref slots i)
          types
          prefs
          parents)
        (set! i (+ i 1))))))

(define (compiler-reg-float-arg-pref-blocks!
  [abi : CompilerRegTargetAbi]
  [pool : CompilerRegIdList]
  [blocks : CompilerIrBlockList]
  [types : CompilerRegVarTypeList]
  [prefs : (Array i64)]
  [parents : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-float-arg-pref-seq!
              abi
              pool
              instrs
              types
              prefs
              parents)])
        (compiler-reg-float-arg-pref-blocks!
          abi
          pool
          (box-get rest)
          types
          prefs
          parents))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-float-arg-pref-seq!
                  abi
                  pool
                  instrs
                  types
                  prefs
                  parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-float-arg-prefs
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [types : CompilerRegVarTypeList]
  [coalesce : CompilerRegCoalesceMap]
  [n : i64]) : (Array i64)
  (let
    [prefs : (Array i64) (array.make-array i64 n)]
    [parents : (Array i64) (struct-get coalesce parents)]
    [pool : CompilerRegIdList (compiler-reg-xmm-registers-for-abi abi)]
    (begin
      (compiler-reg-fill-i64-array prefs -1)
      (match func
        [(CompilerIrFunction.Function _ _ _ _ blocks)
          (compiler-reg-float-arg-pref-blocks!
            abi
            pool
            blocks
            types
            prefs
            parents)])
      prefs)))

;; Enforce the contract required by the ordered backend float marshaller: every
;; register-homed float call arg must already be in its ABI destination. A greedy
;; fallback register, XMM0/XMM1 target, stack target, or conflicting preference
;; therefore becomes unassigned and is materialised from its normal stack home.
;; Same as the pref variant: the caller has already classified this argument.
(define (compiler-reg-float-arg-demote-value!
  [abi : CompilerRegTargetAbi]
  [value : CompilerIrValue]
  [is-float : bool]
  [float-idx : i64]
  [position : i64]
  [parents : (Array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match value
    [(CompilerIrValue.Var v)
      (if is-float
        (let
          [abi-idx : i64
            (if (compiler-abi-arg-banks-independent? abi)
              float-idx
              position)]
          [target : i64 (compiler-abi-float-arg-register-id abi abi-idx)]
          [root : i64
            (if (if (>= v 0)
              (< v (array-length parents))
              false)
              (array-ref parents v)
              v)]
          (if (compiler-reg-location-register?
            (compiler-reg-assignment-table-lookup assignments root)
            target)
            unit
            (begin
              (compiler-reg-assignment-table-unassign assignments root)
              unit)))
        unit)]
    [_ unit]))

(define (compiler-reg-float-arg-demote-array!
  [abi : CompilerRegTargetAbi]
  [values : (Array CompilerIrValue)]
  [types : CompilerRegVarTypeList]
  [i : i64]
  [float-idx : i64]
  [position : i64]
  [parents : (Array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (if (>= i (array-length values))
    unit
    (let
      [value : CompilerIrValue (array-ref values i)]
      [is-float : bool (compiler-reg-call-arg-float? value types)]
      (begin
        (compiler-reg-float-arg-demote-value!
          abi
          value
          is-float
          float-idx
          position
          parents
          assignments)
        (compiler-reg-float-arg-demote-array!
          abi
          values
          types
          (+ i 1)
          (if is-float
            (+ float-idx 1)
            float-idx)
          (+ position 1)
          parents
          assignments)))))

(define (compiler-reg-float-arg-demote-args!
  [abi : CompilerRegTargetAbi]
  [args : CompilerIrCallArgs]
  [types : CompilerRegVarTypeList]
  [position : i64]
  [parents : (Array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One a)
      (compiler-reg-float-arg-demote-value!
        abi
        a
        (compiler-reg-call-arg-float? a types)
        0
        position
        parents
        assignments)]
    [(CompilerIrCallArgs.Two a b)
      (let
        [a-float : bool (compiler-reg-call-arg-float? a types)]
        (begin
          (compiler-reg-float-arg-demote-value!
            abi
            a
            a-float
            0
            position
            parents
            assignments)
          (compiler-reg-float-arg-demote-value!
            abi
            b
            (compiler-reg-call-arg-float? b types)
            (if a-float
              1
              0)
            (+ position 1)
            parents
            assignments)))]
    [(CompilerIrCallArgs.Array values)
      (compiler-reg-float-arg-demote-array!
        abi
        values
        types
        0
        0
        position
        parents
        assignments)]))

(define (compiler-reg-float-arg-demote-instr!
  [abi : CompilerRegTargetAbi]
  [instr : CompilerIrInstr]
  [types : CompilerRegVarTypeList]
  [parents : (Array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match instr
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-reg-float-arg-demote-args! abi args types 0 parents assignments)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [args (struct-get (box-get payload-box) args)]
        (compiler-reg-float-arg-demote-args!
          abi
          args
          types
          0
          parents
          assignments))]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [args (struct-get (box-get payload-box) args)]
        (compiler-reg-float-arg-demote-args!
          abi
          args
          types
          0
          parents
          assignments))]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-reg-float-arg-demote-args! abi args types 0 parents assignments)]
    [(CompilerIrInstr.TailCallIndirect _ args _)
      (compiler-reg-float-arg-demote-args! abi args types 1 parents assignments)]
    [(CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-float-arg-demote-args! abi args types 1 parents assignments)]
    [(CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-float-arg-demote-args! abi args types 0 parents assignments)]
    [_ unit]))

(define (compiler-reg-float-arg-demote-seq!
  [abi : CompilerRegTargetAbi]
  [instrs : CompilerIrInstrSeq]
  [types : CompilerRegVarTypeList]
  [parents : (Array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [i : i64 0]
    (while (< i count)
      (begin
        (compiler-reg-float-arg-demote-instr!
          abi
          (array-ref slots i)
          types
          parents
          assignments)
        (set! i (+ i 1))))))

(define (compiler-reg-float-arg-demote-blocks!
  [abi : CompilerRegTargetAbi]
  [blocks : CompilerIrBlockList]
  [types : CompilerRegVarTypeList]
  [parents : (Array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-float-arg-demote-seq!
              abi
              instrs
              types
              parents
              assignments)])
        (compiler-reg-float-arg-demote-blocks!
          abi
          (box-get rest)
          types
          parents
          assignments))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-float-arg-demote-seq!
                  abi
                  instrs
                  types
                  parents
                  assignments)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-float-call-args-demote!
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [types : CompilerRegVarTypeList]
  [coalesce : CompilerRegCoalesceMap]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-float-arg-demote-blocks!
        abi
        blocks
        types
        (struct-get coalesce parents)
        assignments)]))

(define (compiler-reg-greedy-state-with-scratch-exclusions
  [candidates : CompilerRegIntervalSeq]
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [param-roots : CompilerLiveI64Set]
  [ref-counts : (Array i64)]
  [copy-hints : (Array i64)]
  [arg-prefs : (Array i64)]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [callee-regs : CompilerRegIdList]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (Array CompilerRegIdList)]) : CompilerRegAssignState
  (let
    [n : i64 (array-length (struct-get assignments present))]
    [rcount : i64 (compiler-reg-id-list-count regs)]
    [reg-arr : (Array i64)
      (array.make-array
        i64
        (if (< (compiler-reg-id-list-count regs) 1)
          1
          (compiler-reg-id-list-count regs)))]
    [order : (Array i64)
      (array.make-array
        i64
        (if (< (array-length (struct-get assignments present)) 1)
          1
          (array-length (struct-get assignments present))))]
    ;; RS_* stage per root (RS_New until selectOrSplit runs); the post-pass region
    ;; split rescues the RS_Split entries.
    [stages : (Array i64)
      (array.make-array
        i64
        (if (< (array-length (struct-get assignments present)) 1)
          1
          (array-length (struct-get assignments present))))]
    (begin
      (compiler-reg-greedy-id-list-to-array regs reg-arr 0)
      (let
        [count : i64 (compiler-reg-greedy-collect-vars candidates order 0)]
        (begin
          (compiler-reg-greedy-sort! order ref-counts 0 count)
          (compiler-reg-greedy-alloc-all!
            order
            0
            count
            assignments
            interval-index
            ref-counts
            copy-hints
            arg-prefs
            group-vars
            param-roots
            regs
            reg-arr
            rcount
            stages
            n
            call-points
            div-points
            shift-points
            callee-regs
            caller-saved-count
            unspillable-from
            scratch-excluded)
          (CompilerRegAssignState.State
            (compiler-reg-active-seq-empty)
            assignments))))))

(define (compiler-reg-greedy-state
  [candidates : CompilerRegIntervalSeq]
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [group-vars : CompilerLiveI64Set]
  [param-roots : CompilerLiveI64Set]
  [ref-counts : (Array i64)]
  [copy-hints : (Array i64)]
  [arg-prefs : (Array i64)]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [callee-regs : CompilerRegIdList]
  [caller-saved-count : i64]
  [unspillable-from : i64]) : CompilerRegAssignState
  (compiler-reg-greedy-state-with-scratch-exclusions
    candidates
    regs
    assignments
    interval-index
    group-vars
    param-roots
    ref-counts
    copy-hints
    arg-prefs
    call-points
    div-points
    shift-points
    callee-regs
    caller-saved-count
    unspillable-from
    (array.make-array CompilerRegIdList 0)))

;; ============================================================================
;; GAP2b: register-PAIR homing for 16-byte group values. The greedy
;; structurally excludes group vars (2-word aggregates) from scalar candidates,
;; so CompilerRegRegisterPair -- a fully-plumbed location the backend already
;; supports (emit-pack / group-word-operand / scavenge occupancy masks / CSR
;; save detection / storage-coloring rebuild) -- is assigned here, after the
;; scalar homes are final.
;;
;; Candidate soundness gates:
;;  * A clobber-free component first tries the stable caller-saved pair
;;    {r8,r9}. It avoids growing the prologue save set and has no div/shift
;;    fixed-use role. Group values marshalled by a normal call only see the CSR
;;    pool until that multiword ABI path participates in the pair parallel-move
;;    solver. A component that crosses a kind-0 clobber also only sees
;;    {r12,r13,r14,r15,rbx}; %rbp stays out because the FPO/scavenger plan owns
;;    its admission.
;;  * Per-call-region scalar shadows also use the caller-saved pool. A pair
;;    candidate rejects an overlapping shadow region, so the later rewrite can
;;    never mint a scalar home into either pair half.
;;  * Phi endpoints are admitted: compiler_parallel_move represents both pair
;;    halves as resources, so a scalar phi copy that writes either half blocks
;;    until the pair source has been read. The old whole-location exclusion was
;;    made obsolete by that solver.
;;  * group Movs are handled by CO-ASSIGNMENT: Mov-connected components under
;;    the same-value proof (BOTH endpoints single-def, so the component
;;    carries exactly one value and may share one home even under hull
;;    overlap -- the relation scalars got in #2/M-C but groups never did) get
;;    ONE shared pair for every member, so the component's Movs elide as
;;    same-home copies -- strictly better than the storage-coloring slot
;;    aliasing they replace. A group Mov without that proof may retain an
;;    ordinary two-word copy between independently chosen homes; the backend
;;    stages both source words before writing either destination, so this is
;;    safe and admits phi-adjacent group values.
;;  * NOT tail-call args (restore-order analysis kept out of v1), NOT params
;;    (entry marshalling), NOT address-taken/memory-targeted vars.
;;  * Call results, returns, Pack/Word and switch dispatch all read through
;;    compiler-backend-group-word-operand, which is pair-aware. Group arguments
;;    to ordinary direct and indirect calls may use a CSR pair, but not r8:r9,
;;    until their multiword ABI marshalling participates in the pair
;;    parallel-move solver. A CSR pair is preserved across calls by the callee,
;;    so call-spanning group values are admitted.
;; Interference: per-var segment-precise (the same
;; compiler-reg-vars-interfere-segmented-index? the greedy trusts) against
;; every var holding the probed register (scalar home or either pair half),
;; including pairs this pass already placed.
(define (compiler-reg-group-pair-add-value-var
  [set : CompilerLiveI64Set]
  [value : CompilerIrValue]) : CompilerLiveI64Set
  (match value
    [(CompilerIrValue.Var id) (compiler-live-set-insert set id)]
    [_ set]))

(define (compiler-reg-group-pair-add-call-args
  [set : CompilerLiveI64Set]
  [args : CompilerIrCallArgs]) : CompilerLiveI64Set
  (match args
    [(CompilerIrCallArgs.Nil) set]
    [(CompilerIrCallArgs.One a) (compiler-reg-group-pair-add-value-var set a)]
    [(CompilerIrCallArgs.Two a b)
      (compiler-reg-group-pair-add-value-var
        (compiler-reg-group-pair-add-value-var set a)
        b)]
    [(CompilerIrCallArgs.Array arr)
      (let
        [n : i64 (array-length arr)]
        [i : i64 0]
        [acc : CompilerLiveI64Set set]
        (begin
          (while (< i n)
            (begin
              (set!
                acc
                (compiler-reg-group-pair-add-value-var acc (array-ref arr i)))
              (set! i (+ i 1))))
          acc))]))

;; The ordinary call marshaller emits its group-word moves independently. A
;; source already in r8:r9 can therefore overlap an earlier argument
;; destination. Keep the affected component eligible for a CSR pair, but bar
;; it from the caller-saved pair until call marshalling uses the pair
;; parallel-move solver.
(define (compiler-reg-group-pair-caller-unsafe-instr
  [set : CompilerLiveI64Set]
  [instr : CompilerIrInstr]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [(CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [(CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [_ set]))

;; Read-only fold over the instruction stream: scan the sequence in place
;; instead of materialising it as a cons list first. refs #5726
(define (compiler-reg-group-pair-caller-unsafe-instr-seq
  [set : CompilerLiveI64Set]
  [instrs : CompilerIrInstrSeq]) : CompilerLiveI64Set
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-group-pair-caller-unsafe-instr
              out
              (compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-group-pair-caller-unsafe-blocks
  [set : CompilerLiveI64Set]
  [blocks : CompilerIrBlockList]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-pair-caller-unsafe-blocks
            (compiler-reg-group-pair-caller-unsafe-instr-seq set instrs)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-group-pair-caller-unsafe-instr-seq out instrs))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-group-pair-excluded-instr
  [set : CompilerLiveI64Set]
  [instr : CompilerIrInstr]
  [group-vars : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var _) set]
        [_
          ;; a group Mov from a NON-var source (constant materialisation)
          ;; writes the dst through the group return regs; keep the dst out
          ;; rather than reason about that path in v1.
          (if (compiler-live-set-contains? group-vars dst)
            (compiler-live-set-insert set dst)
            set)])]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [(CompilerIrInstr.TailCallIndirect target args _)
      (compiler-reg-group-pair-add-value-var
        (compiler-reg-group-pair-add-call-args set args)
        target)]
    [_ set]))

(define (compiler-reg-group-pair-excluded-instr-seq
  [set : CompilerLiveI64Set]
  [instrs : CompilerIrInstrSeq]
  [group-vars : CompilerLiveI64Set]) : CompilerLiveI64Set
  (let
    [i : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [out : CompilerLiveI64Set set]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (compiler-reg-group-pair-excluded-instr
              out
              (compiler-ir-instr-seq-ref instrs i)
              group-vars))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-group-pair-excluded-blocks
  [set : CompilerLiveI64Set]
  [blocks : CompilerIrBlockList]
  [group-vars : CompilerLiveI64Set]) : CompilerLiveI64Set
  (match blocks
    [(CompilerIrBlockList.Nil) set]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-pair-excluded-blocks
            (compiler-reg-group-pair-excluded-instr-seq set instrs group-vars)
            (box-get rest)
            group-vars)])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-group-pair-excluded-instr-seq
                      out
                      instrs
                      group-vars))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-group-pair-csr [idx : i64]) : i64
  (cond
    [(= idx 0) compiler-reg-id-r12]
    [(= idx 1) compiler-reg-id-r13]
    [(= idx 2) compiler-reg-id-r14]
    [(= idx 3) compiler-reg-id-r15]
    [else compiler-reg-id-rbx]))

;; The late pair pass reserves only the non-argument caller-saved pair. rax,
;; rcx and rdx have fixed ABI or div/shift roles; r10/r11 are scavenger scratch;
;; rsi/rdi stay with ordinary argument marshalling.
(define (compiler-reg-group-pair-caller-saved [idx : i64]) : i64
  (if (= idx 0)
    compiler-reg-id-r8
    compiler-reg-id-r9))

(define (compiler-reg-group-pair-candidate-count [caller-saved-ok? : bool]) : i64
  (if caller-saved-ok?
    7
    5))

(define (compiler-reg-group-pair-candidate
  [caller-saved-ok? : bool]
  [idx : i64]) : i64
  (if caller-saved-ok?
    (if (< idx 2)
      (compiler-reg-group-pair-caller-saved idx)
      (compiler-reg-group-pair-csr (- idx 2)))
    (compiler-reg-group-pair-csr idx)))

;; A caller-saved pair must not overlap a scalar shadow that the per-call-region
;; rescue will materialise after this plan is built. The shadow table records
;; one register per root and point ranges for each realised region; conservative
;; hull overlap is enough here (a false conflict only retains a stack home).
(define (compiler-reg-group-pair-component-live-over-range?
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i count) (not hit))
        (begin
          (if (compiler-reg-var-live-over-range?
            starts
            ends
            (array-ref members i)
            lo
            hi)
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

(define (compiler-reg-group-pair-shadow-reg-conflicts?
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [split : CompilerRegCallSplit]
  [reg : i64]) : bool
  (match split
    [(CompilerRegCallSplit _ shadow-regs regions)
      (compiler-reg-group-pair-shadow-reg-conflicts-regions?
        interval-index
        members
        count
        shadow-regs
        regions
        reg)]))

(define (compiler-reg-group-pair-shadow-reg-conflicts-regions?
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [shadow-regs : (Array i64)]
  [regions : CompilerRegCallRegionSeq]
  [reg : i64]) : bool
  (let
    [slots : (Array CompilerRegCallRegion) (struct-get regions slots)]
    [index : i64 (- (struct-get regions len) 1)]
    [conflict : bool false]
    (begin
      (while (and (>= index 0) (not conflict))
        (begin
          (match (array-ref slots index)
            [(CompilerRegCallRegion root lo hi _ _)
              (if (and
                (>= root 0)
                (< root (array-length shadow-regs))
                (= (array-ref shadow-regs root) reg)
                (compiler-reg-group-pair-component-live-over-range?
                  interval-index
                  members
                  count
                  lo
                  hi))
                (set! conflict true)
                unit)])
          (set! index (- index 1))))
      conflict)))

(define (compiler-reg-group-pair-weight [weights : (Array i64)] [v : i64]) : i64
  (if (and (>= v 0) (< v (array-length weights)))
    (array-ref weights v)
    0))

(define (compiler-reg-group-pair-component-clobber-free?
  [interval-index : CompilerRegIntervalIndex]
  [call-points : CompilerLiveI64Set]
  [members : (Array i64)]
  [count : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (while (and (< i count) ok)
        (begin
          (if (compiler-reg-greedy-var-spans-clobber?
            interval-index
            call-points
            (array-ref members i))
            (set! ok false)
            unit)
          (set! i (+ i 1))))
      ok)))

(define (compiler-reg-group-pair-component-contains?
  [set : CompilerLiveI64Set]
  [members : (Array i64)]
  [count : i64]) : bool
  (let
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i count) (not hit))
        (begin
          (if (compiler-live-set-contains? set (array-ref members i))
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

;; A pair component may evict only scalar register occupants that are strictly
;; colder than the component's hottest member. An overlapping pair occupying
;; this register, or an equal/hotter scalar, makes it unavailable; spill/remat
;; homes and pairs in other registers do not occupy it. The returned positive
;; cost ranks alternatives by the total displaced spill weight; -1 means
;; unavailable. A zero cost is an already-free register.
(define (compiler-reg-group-pair-reg-evict-cost
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [weights : (Array i64)]
  [component-weight : i64]
  [reg : i64]
  [vars : i64]
  [idx : i64]
  [cost : i64]) : i64
  (if (>= idx vars)
    cost
    (if (compiler-reg-group-pair-component-conflicts-var?
      interval-index
      members
      count
      idx)
      (match (compiler-reg-assignment-table-lookup assignments idx)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Register held)
              (if (= held reg)
                (let
                  [weight : i64 (compiler-reg-group-pair-weight weights idx)]
                  (if (< weight component-weight)
                    (compiler-reg-group-pair-reg-evict-cost
                      assignments
                      interval-index
                      members
                      count
                      weights
                      component-weight
                      reg
                      vars
                      (+ idx 1)
                      (+ cost (+ weight 1)))
                    (- 0 1)))
                (compiler-reg-group-pair-reg-evict-cost
                  assignments
                  interval-index
                  members
                  count
                  weights
                  component-weight
                  reg
                  vars
                  (+ idx 1)
                  cost))]
            [(CompilerRegLocation.RegisterPair first second)
              (if (or (= first reg) (= second reg))
                (- 0 1)
                (compiler-reg-group-pair-reg-evict-cost
                  assignments
                  interval-index
                  members
                  count
                  weights
                  component-weight
                  reg
                  vars
                  (+ idx 1)
                  cost))]
            [(CompilerRegLocation.Spill _)
              (compiler-reg-group-pair-reg-evict-cost
                assignments
                interval-index
                members
                count
                weights
                component-weight
                reg
                vars
                (+ idx 1)
                cost)]
            [(CompilerRegLocation.Remat _)
              (compiler-reg-group-pair-reg-evict-cost
                assignments
                interval-index
                members
                count
                weights
                component-weight
                reg
                vars
                (+ idx 1)
                cost)])]
        [(CompilerRegMaybeLocation.No)
          (compiler-reg-group-pair-reg-evict-cost
            assignments
            interval-index
            members
            count
            weights
            component-weight
            reg
            vars
            (+ idx 1)
            cost)])
      (compiler-reg-group-pair-reg-evict-cost
        assignments
        interval-index
        members
        count
        weights
        component-weight
        reg
        vars
        (+ idx 1)
        cost))))

(define (compiler-reg-group-pair-component-conflicts-var?
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [var : i64]) : bool
  (let
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i count) (not hit))
        (begin
          (if (compiler-reg-vars-interfere-segmented-index?
            interval-index
            (array-ref members i)
            var)
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

(define (compiler-reg-group-pair-component-register-cost
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [weights : (Array i64)]
  [component-weight : i64]
  [caller-saved? : bool]
  [split : CompilerRegCallSplit]
  [reg : i64]
  [vars : i64]) : i64
  (if (and
    caller-saved?
    (compiler-reg-group-pair-shadow-reg-conflicts?
      interval-index
      members
      count
      split
      reg))
    (- 0 1)
    (compiler-reg-group-pair-reg-evict-cost
      assignments
      interval-index
      members
      count
      weights
      component-weight
      reg
      vars
      0
      0)))

(define (compiler-reg-group-pair-evict-reg-conflicts!
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [members : (Array i64)]
  [count : i64]
  [reg : i64]
  [vars : i64]
  [idx : i64]) : unit
  (if (>= idx vars)
    unit
    (begin
      (if (compiler-reg-group-pair-component-conflicts-var?
        interval-index
        members
        count
        idx)
        (match (compiler-reg-assignment-table-lookup assignments idx)
          [(CompilerRegMaybeLocation.Some location)
            (match location
              [(CompilerRegLocation.Register held)
                (if (= held reg)
                  (let
                    [_spill : CompilerRegAssignmentTable
                      (compiler-reg-assignment-table-insert
                        assignments
                        idx
                        (CompilerRegLocation.Spill
                          (compiler-reg-stack-slot-offset idx)))]
                    unit)
                  unit)]
              [_ unit])]
          [(CompilerRegMaybeLocation.No) unit])
        unit)
      (compiler-reg-group-pair-evict-reg-conflicts!
        assignments
        interval-index
        members
        count
        reg
        vars
        (+ idx 1)))))

;; Union-find root with full-path compression (iterative).
(define (compiler-reg-group-pair-find [parents : (Array i64)] [v : i64]) : i64
  (let
    [root : i64 v]
    (begin
      (while (not (= (array-ref parents root) root))
        (set! root (array-ref parents root)))
      (let
        [cur : i64 v]
        (while (not (= (array-ref parents cur) root))
          (let
            [next : i64 (array-ref parents cur)]
            (begin
              (array-set! parents cur root)
              (set! cur next)))))
      root)))

;; Group-Mov value-carry edges: union dst/src when BOTH endpoints are sound
;; candidates and BOTH are SINGLE-DEF (the same-value coalescing rationale,
;; which groups never received): dst's only def is this Mov and src is never
;; redefined, so the whole component carries ONE value -- sharing one home is
;; correct even when the hulls OVERLAP (copy-prop routinely keeps the call
;; result live past the Mov, so the M-B slot-alias adjacency proof is too
;; brittle here). If that proof fails but BOTH endpoints are group values, they
;; stay independently eligible: emit-mov stages both source words before either
;; destination write, and phi edges use the pair-aware parallel-move solver.
;; This can retain a necessary group copy, but it is safe and lets phi-carried
;; groups receive pairs. A one-sided group mismatch remains poisoned because it
;; indicates incomplete group-identity propagation rather than a normal copy.
;; Read-only scan (its writes go to the union-find/poison side arrays, never to
;; the IR): walk the contiguous sequence instead of materialising a cons list.
;; refs #5726
(define (compiler-reg-group-pair-mov-edges-instr
  [instr : CompilerIrInstr]
  [group-vars : CompilerLiveI64Set]
  [excluded : CompilerLiveI64Set]
  [starts : (Array i64)]
  [def-counts : (Array i64)]
  [parents : (Array i64)]
  [poisoned : (Array bool)]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var src-var)
          (if (and
            (compiler-live-set-contains? group-vars dst)
            (compiler-live-set-contains? group-vars src-var))
            (if (and
              (not (= dst src-var))
              (>= dst 0)
              (< dst (array-length parents))
              (>= src-var 0)
              (< src-var (array-length parents))
              (not (compiler-live-set-contains? excluded dst))
              (not (compiler-live-set-contains? excluded src-var))
              (>= (array-ref starts dst) 0)
              (>= (array-ref starts src-var) 0)
              (compiler-reg-sv-single-def? def-counts dst)
              (compiler-reg-sv-single-def? def-counts src-var))
              (let
                [rd : i64 (compiler-reg-group-pair-find parents dst)]
                [rs : i64 (compiler-reg-group-pair-find parents src-var)]
                (array-set! parents rd rs))
              unit)
            (if (or
              (compiler-live-set-contains? group-vars dst)
              (compiler-live-set-contains? group-vars src-var))
              (begin
                (if (and (>= dst 0) (< dst (array-length poisoned)))
                  (array-set! poisoned dst true)
                  unit)
                (if (and (>= src-var 0) (< src-var (array-length poisoned)))
                  (array-set! poisoned src-var true)
                  unit))
              unit))]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-group-pair-mov-edges-instr-seq
  [instrs : CompilerIrInstrSeq]
  [group-vars : CompilerLiveI64Set]
  [excluded : CompilerLiveI64Set]
  [starts : (Array i64)]
  [def-counts : (Array i64)]
  [parents : (Array i64)]
  [poisoned : (Array bool)]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (begin
        (compiler-reg-group-pair-mov-edges-instr
          (compiler-ir-instr-seq-ref instrs index)
          group-vars
          excluded
          starts
          def-counts
          parents
          poisoned)
        (set! index (+ index 1))))))

(define (compiler-reg-group-pair-mov-edges-blocks
  [blocks : CompilerIrBlockList]
  [group-vars : CompilerLiveI64Set]
  [excluded : CompilerLiveI64Set]
  [starts : (Array i64)]
  [def-counts : (Array i64)]
  [parents : (Array i64)]
  [poisoned : (Array bool)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-group-pair-mov-edges-instr-seq
              instrs
              group-vars
              excluded
              starts
              def-counts
              parents
              poisoned)
            (compiler-reg-group-pair-mov-edges-blocks
              (box-get rest)
              group-vars
              excluded
              starts
              def-counts
              parents
              poisoned))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-group-pair-mov-edges-instr-seq
                  instrs
                  group-vars
                  excluded
                  starts
                  def-counts
                  parents
                  poisoned)])
            (set! i (+ i 1)))))]))

;; TRUE when var v is a sound pair-component member on its own account.
;; SSE-word groups (e.g. an i64+f64 enum) are excluded: the pair pool contains
;; GP registers only, and a float word homed in a GP register would emit an
;; invalid xmm<->gp movsd (the class mask registry is the same data the
;; backend's group-word-sse? reads).
(define (compiler-reg-group-pair-member-ok?
  [type-segment-bases : i64]
  [v : i64]
  [type-info : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [excluded : CompilerLiveI64Set]
  [starts : (Array i64)]
  [poisoned : (Array bool)]
  [assignments : CompilerRegAssignmentTable]) : bool
  (and
    (compiler-live-set-contains? group-vars v)
    (not (compiler-live-set-contains? excluded v))
    (not (array-ref poisoned v))
    (not
      (compiler-reg-var-register-group-has-sse? type-segment-bases type-info v))
    (>= (array-ref starts v) 0)
    (match (compiler-reg-assignment-table-lookup assignments v)
      [(CompilerRegMaybeLocation.Some _) false]
      [(CompilerRegMaybeLocation.No) true])))

(define (compiler-reg-assign-group-pairs
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [type-info : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [interval-index : CompilerRegIntervalIndex]
  [assignments : CompilerRegAssignmentTable]
  [weights : (Array i64)]
  [call-points : CompilerLiveI64Set]
  [split : CompilerRegCallSplit]) : CompilerRegAssignmentTable
  (match func
    [(CompilerIrFunction.Function _ params _ _ blocks)
      (let
        [starts : (Array i64) (struct-get interval-index starts)]
        [ends : (Array i64) (struct-get interval-index ends)]
        [vars : i64 (array-length starts)]
        [excluded : CompilerLiveI64Set
          (compiler-reg-group-pair-excluded-blocks
            (compiler-reg-ineligible-memory
              blocks
              (compiler-reg-ineligible-params params (compiler-live-set-empty)))
            blocks
            group-vars)]
        [caller-unsafe : CompilerLiveI64Set
          (compiler-reg-group-pair-caller-unsafe-blocks
            (compiler-live-set-empty)
            blocks)]
        [def-counts : (Array i64) (compiler-reg-function-def-counts func)]
        [parents : (Array i64) (array.make-array i64 vars)]
        [poisoned : (Array bool) (array.make-array bool vars)]
        [members : (Array i64) (array.make-array i64 vars)]
        [v : i64 0]
        (begin
          (while (< v vars)
            (begin
              (array-set! parents v v)
              (array-set! poisoned v false)
              (set! v (+ v 1))))
          (compiler-reg-group-pair-mov-edges-blocks
            blocks
            group-vars
            excluded
            starts
            def-counts
            parents
            poisoned)
          (set! v 0)
          (while (< v vars)
            (begin
              (if (and
                (= (compiler-reg-group-pair-find parents v) v)
                (compiler-reg-group-pair-member-ok?
                  type-segment-bases
                  v
                  type-info
                  group-vars
                  excluded
                  starts
                  poisoned
                  assignments))
                (compiler-reg-assign-group-pair-component
                  type-segment-bases
                  v
                  vars
                  type-info
                  group-vars
                  excluded
                  caller-unsafe
                  starts
                  ends
                  poisoned
                  parents
                  members
                  interval-index
                  assignments
                  weights
                  call-points
                  split)
                unit)
              (set! v (+ v 1))))
          assignments))]))

;; Place ONE component (root r): collect members, prove every member sound
;; (the single-def Mov-edge relation guarantees the component carries ONE
;; value, so members may overlap freely -- same-value semantics), then choose
;; the cheapest candidate pair. Already-free pairs cost zero; otherwise every
;; interfering scalar must be strictly colder than the component's hottest
;; member and is demoted to its ordinary spill slot before the pair is assigned.
(define (compiler-reg-assign-group-pair-component
  [type-segment-bases : i64]
  [r : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [group-vars : CompilerLiveI64Set]
  [excluded : CompilerLiveI64Set]
  [caller-unsafe : CompilerLiveI64Set]
  [starts : (Array i64)]
  ;; lint-allow: unused-variable
  [ends : (Array i64)]
  [poisoned : (Array bool)]
  [parents : (Array i64)]
  [members : (Array i64)]
  [interval-index : CompilerRegIntervalIndex]
  [assignments : CompilerRegAssignmentTable]
  [weights : (Array i64)]
  [call-points : CompilerLiveI64Set]
  [split : CompilerRegCallSplit]) : unit
  (let
    [count : i64 0]
    [ok : bool true]
    [component-weight : i64 0]
    [w : i64 0]
    (begin
      (while (< w vars)
        (begin
          (if (= (compiler-reg-group-pair-find parents w) r)
            (begin
              (if (compiler-reg-group-pair-member-ok?
                type-segment-bases
                w
                type-info
                group-vars
                excluded
                starts
                poisoned
                assignments)
                (begin
                  (array-set! members count w)
                  (set! count (+ count 1)))
                (set! ok false))
              (let
                [weight : i64 (compiler-reg-group-pair-weight weights w)]
                (if (> weight component-weight)
                  (set! component-weight weight)
                  unit)))
            unit)
          (set! w (+ w 1))))
      (if (and ok (> component-weight 0) (> count 0))
        (let
          [caller-saved-ok? : bool
            (and
              (not
                (compiler-reg-group-pair-component-contains?
                  caller-unsafe
                  members
                  count))
              (compiler-reg-group-pair-component-clobber-free?
                interval-index
                call-points
                members
                count))]
          [candidate-count : i64
            (compiler-reg-group-pair-candidate-count caller-saved-ok?)]
          [best0 : i64 (- 0 1)]
          [best1 : i64 (- 0 1)]
          [best-cost : i64 (- 0 1)]
          [i0 : i64 0]
          (begin
            ;; Search all pairs so an already-free pair always beats eviction,
            ;; and otherwise the coldest displaced scalar set wins.
            (while (< i0 candidate-count)
              (let
                [reg0 : i64
                  (compiler-reg-group-pair-candidate caller-saved-ok? i0)]
                [cost0 : i64
                  (compiler-reg-group-pair-component-register-cost
                    assignments
                    interval-index
                    members
                    count
                    weights
                    component-weight
                    (and caller-saved-ok? (< i0 2))
                    split
                    reg0
                    vars)]
                (begin
                  (if (>= cost0 0)
                    (let
                      [i1 : i64 (+ i0 1)]
                      (while (< i1 candidate-count)
                        (let
                          [reg1 : i64
                            (compiler-reg-group-pair-candidate
                              caller-saved-ok?
                              i1)]
                          [cost1 : i64
                            (compiler-reg-group-pair-component-register-cost
                              assignments
                              interval-index
                              members
                              count
                              weights
                              component-weight
                              (and caller-saved-ok? (< i1 2))
                              split
                              reg1
                              vars)]
                          (begin
                            (if (and
                              (>= cost1 0)
                              (or (< best-cost 0) (< (+ cost0 cost1) best-cost)))
                              (begin
                                (set! best0 i0)
                                (set! best1 i1)
                                (set! best-cost (+ cost0 cost1)))
                              unit)
                            (set! i1 (+ i1 1))))))
                    unit)
                  (set! i0 (+ i0 1)))))
            (if (>= best0 0)
              (let
                [reg0 : i64
                  (compiler-reg-group-pair-candidate caller-saved-ok? best0)]
                [reg1 : i64
                  (compiler-reg-group-pair-candidate caller-saved-ok? best1)]
                [pair : CompilerRegLocation
                  (CompilerRegLocation.RegisterPair reg0 reg1)]
                [m : i64 0]
                (begin
                  (compiler-reg-group-pair-evict-reg-conflicts!
                    assignments
                    interval-index
                    members
                    count
                    reg0
                    vars
                    0)
                  (compiler-reg-group-pair-evict-reg-conflicts!
                    assignments
                    interval-index
                    members
                    count
                    reg1
                    vars
                    0)
                  (cfg
                    regalloc-census
                    (io.print-error
                      (str_cat.str-cat
                        "group-pair-assigned|members="
                        (string.int->string count)
                        "|"
                        reg0
                        ":"
                        reg1
                        "|evict-cost="
                        (string.int->string best-cost)
                        "\n"))
                    unit)
                  (while (< m count)
                    (let
                      [_ins : CompilerRegAssignmentTable
                        (compiler-reg-assignment-table-insert
                          assignments
                          (array-ref members m)
                          pair)]
                      (set! m (+ m 1))))))
              unit)))
        unit))))

;; GAP3c: coalesce-hull validation of the ABI pins. The pin walk judged each
;; param on its OWN interval, but expand-class-assignments later copies a
;; coalesce ROOT's location onto every class member -- so a pinned param that
;; roots a class effectively occupies its caller-saved register over the whole
;; MERGED hull. A disjoint-coalesced member living past a call would then read
;; the pin register after the call clobbered it (the same hazard the comment at
;; eff-blocked describes for blocked vars, made live by per-interval pins: the
;; old function-global gate could never pin in a clobber-having function, so no
;; member hull could contain a clobber point). Re-run the per-register clobber
;; test on the ROOT's eff-index hull; a failing pin -- or a pin on a var some
;; smaller-id root absorbed (its assignment would be discarded at expansion
;; anyway) -- is UNASSIGNED. The demoted param was never inserted into
;; `blocked` (GAP3c walk), so its root competes in the greedy as an ordinary
;; callee-saved candidate, exactly the M-A contract.
(define (compiler-reg-param-pins-demote-walk!
  [params : CompilerIrParamList]
  [assignments : CompilerRegAssignmentTable]
  [parents : (Array i64)]
  [eff-index : CompilerRegIntervalIndex]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [low-xmm-points : CompilerLiveI64Set]) : unit
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) unit]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-param-pins-demote-walk!
        (compiler-ir-param-seq-to-list seq)
        assignments
        parents
        eff-index
        call-points
        div-points
        shift-points
        low-xmm-points)]
    [(CompilerIrParamList.Cons param rest)
      (begin
        (match param
          [(CompilerIrParam.Param _ _ var-id)
            (match (compiler-reg-assignment-table-lookup assignments var-id)
              [(CompilerRegMaybeLocation.Some location)
                (match location
                  [(CompilerRegLocation.Register home)
                    (let
                      [root : i64
                        (if (and
                          (>= var-id 0)
                          (< var-id (array-length parents)))
                          (array-ref parents var-id)
                          var-id)]
                      (if (and
                        (= root var-id)
                        (compiler-reg-param-pin-clobber-free?
                          eff-index
                          call-points
                          div-points
                          shift-points
                          low-xmm-points
                          var-id
                          home))
                        unit
                        (begin
                          (compiler-reg-assignment-table-unassign
                            assignments
                            var-id)
                          unit)))]
                  [_ unit])]
              [(CompilerRegMaybeLocation.No) unit])])
        (compiler-reg-param-pins-demote-walk!
          (box-get rest)
          assignments
          parents
          eff-index
          call-points
          div-points
          shift-points
          low-xmm-points))]))

(define (compiler-reg-param-pins-demote!
  [func : CompilerIrFunction]
  [assignments : CompilerRegAssignmentTable]
  [coalesce : CompilerRegCoalesceMap]
  [eff-index : CompilerRegIntervalIndex]
  [call-points : CompilerLiveI64Set]
  [div-points : CompilerLiveI64Set]
  [shift-points : CompilerLiveI64Set]
  [low-xmm-points : CompilerLiveI64Set]) : unit
  (match func
    [(CompilerIrFunction.Function _ params _ _ _)
      (compiler-reg-param-pins-demote-walk!
        params
        assignments
        (struct-get coalesce parents)
        eff-index
        call-points
        div-points
        shift-points
        low-xmm-points)]))

(define (compiler-reg-plan-from
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [liveness-handle : CompilerRegLivenessHandle]
  [type-info : CompilerRegVarTypes]
  [types : CompilerRegVarTypeList]
  [intervals : CompilerRegIntervalSeq]
  [interval-index : CompilerRegIntervalIndex]
  [assignment-table : CompilerRegAssignmentTable]
  [ineligible : CompilerLiveI64Set]
  [blocked : CompilerLiveI64Set]
  [allow-caller-saved-zero-call : bool]
  [mask-vars-use-vector-registers : bool]
  [abi : CompilerRegTargetAbi]
  [ignore-single-cold-call? : bool]
  [forced-spill-from : i64]) : CompilerRegPlan
  (let
    [storage-identity-vars : CompilerLiveI64Set
      (let
        [base : CompilerLiveI64Set
          (if allow-caller-saved-zero-call
            (match func
              [(CompilerIrFunction.Function _ _ _ _ blocks)
                (compiler-reg-ineligible-memory
                  blocks
                  (compiler-live-set-empty))])
            (compiler-live-set-empty))]
        (if (>= forced-spill-from 0)
          (match func
            [(CompilerIrFunction.Function _ _ _ fn-vars _)
              (compiler-reg-live-set-insert-range
                base
                forced-spill-from
                fn-vars)])
          base))]
    ;; Destructive operand/result ties carry different values and never receive
    ;; the same-value overlap waiver. Keep their ordinary non-overlap relation
    ;; out of intervals spanning call-like, fixed div/mod, or variable-shift
    ;; clobber points, and out of storage-identity variables. Unlike a copy class,
    ;; a different-value destructive chain must not reshape itself across any of
    ;; those physical-register boundaries.
    [clobber-points : CompilerLiveI64Set
      (if ignore-single-cold-call?
        (compiler-live-set-empty)
        (compiler-reg-clobber-kind-points type-segment-bases func 0))]
    ;; Per-register clobber point sets (15c): kind 1 = idiv (rax:rdx), kind 2 =
    ;; variable shift (rcx). Bound once here and reused both for the destructive
    ;; tie exclusion below and for the GAP3c pin demotion / greedy further down;
    ;; each was previously walked twice per function.
    ;; `compiler-reg-clobber-kind-points` is a pure fold over the function's
    ;; blocks and `compiler-live-set-union` never writes through its operands,
    ;; so the shared sets are the same values the two walks produced.
    [div-points : CompilerLiveI64Set
      (compiler-reg-clobber-kind-points type-segment-bases func 1)]
    [shift-points : CompilerLiveI64Set
      (compiler-reg-clobber-kind-points type-segment-bases func 2)]
    [destructive-fixed-points : CompilerLiveI64Set
      (compiler-live-set-union div-points shift-points)]
    [destructive-clobber-points : CompilerLiveI64Set
      (compiler-live-set-union clobber-points destructive-fixed-points)]
    [destructive-eligible : (Array i64)
      (compiler-reg-same-value-eligible-vars-excluding
        interval-index
        destructive-clobber-points
        storage-identity-vars)]
    [raw-moves
      : CompilerRegMoveSeq
      ;; Phi back-edge moves NON-strict so loop-carried phi/copy pairs coalesce
      ;; (then merge into one root via coalescing-by-rename). SIMD already
      ;; passed false here; only the scalar-opt2 plan gains the loop coalescing.
      ;; Scalar opt2 additionally harvests bounded destructive-binop chain ties,
      ;; then width-64 int casts as copies. SIMD/AVX keeps the plain move list
      ;; byte-identical.
      (if allow-caller-saved-zero-call
        (compiler-reg-function-moves-with-destructive-and-casts-eligible
          func
          false
          destructive-eligible)
        (compiler-reg-function-moves func false))]
    [moves : CompilerRegMoveSeq
      (compiler-reg-move-list-filter-storage-identity
        raw-moves
        storage-identity-vars)]
    [group-vars : CompilerLiveI64Set
      (compiler-reg-function-group-vars type-segment-bases func types)]
    ;; Same-value overlap-coalescing exclusion points. This is the KIND-0
    ;; (call-like: call/syscall/cpuid/xgetbv) point set, NOT the coarse merged
    ;; caller-clobber set. A value that spans only a div/mod or shift is safely
    ;; handled by the greedy's per-register forbidden-regs (div -> {rax,rdx},
    ;; shift -> {rcx}): the coalesced root inherits the union interval and the
    ;; greedy forbids exactly those registers, so the value keeps every other
    ;; register and is never clobbered. Excluding such div/shift-spanning
    ;; same-values from coalescing (as the merged set did) needlessly inflated
    ;; register pressure. Bounds-check and Pack are already absent from both sets
    ;; (clobber-point-instr? returns false for them), so only div/shift differ.
    ;; XMM-family ABI volatility is narrower than the GP clobber model above.
    ;; CpuId/Xgetbv/syscall have fixed GP effects but preserve XMM registers, so
    ;; only real call instructions restrict float/vector candidates to the ABI
    ;; nonvolatile suffix.
    [xmm-call-points : CompilerLiveI64Set (compiler-reg-call-points func)]
    ;; Compiler-emitted vector lowering still contains a bounded set of
    ;; XMM0/XMM1-family temporaries. Make that ownership explicit to the scalar
    ;; greedy while scratch-vreg admits those homes; values not crossing one of
    ;; these points remain free to use the low ABI registers.
    [low-xmm-clobber-points : CompilerLiveI64Set
      (cfg
        scratch-vreg
        (compiler-reg-clobber-kind-points type-segment-bases func 5)
        (compiler-live-set-empty))]
    ;; #2 same-value overlap coalescing: single-def direct copy pairs carry one
    ;; identical value and may coalesce even when their live segments overlap.
    ;; Vars spanning a modeled caller-clobber point stay out of the same-value
    ;; relation; their save/restore and regmask constraints are already
    ;; represented by normal interference and must not be bypassed by an overlap
    ;; waiver.
    [sv-parents
      : (Array i64)
      ;; M-C (part 1): the scalar-opt2 path uses the extended relation that also
      ;; admits copies of mutable (multi-def / phi-def) sources under the
      ;; def-inside-liveness safety check; other paths keep the single-def-only
      ;; builder (their coalesce map is empty anyway).
      (if allow-caller-saved-zero-call
        (compiler-reg-function-same-value-parents-multi
          func
          (compiler-reg-same-value-eligible-vars-excluding
            interval-index
            clobber-points
            storage-identity-vars)
          type-info
          interval-index)
        (compiler-reg-function-same-value-parents-filtered
          func
          (compiler-reg-same-value-eligible-vars-excluding
            interval-index
            clobber-points
            storage-identity-vars)))]
    ;; Edge-precise interference index (LLVM PHIElimination semantics) used ONLY to
    ;; gate coalescing: a loop-carried phi value and its back-edge / merge input do
    ;; not really interfere (the conservative index spuriously overlaps them via
    ;; phi-inputs-live-at-the-header), so this lets the carry coalesce into ONE
    ;; interval. Allocation/eviction below keep the conservative interval-index, so
    ;; a precision error here can only mis-coalesce (caught by the fixpoint), never
    ;; under-approximate allocation interference.
    [coalesce-index : CompilerRegIntervalIndex
      (if (compiler-reg-move-list-empty? moves)
        interval-index
        (if allow-caller-saved-zero-call
          ;; Edge-precise liveness (PHIElimination semantics) computed once and shared
          ;; by the coalescing segment index AND the live-out-input phi exclusion.
          ;; Skipped entirely when there are no moves to coalesce (the empty arm
          ;; above): the map build below returns the empty map without reading
          ;; this index, so the plan is unchanged and the EP interval
          ;; selection + safe-mode exclusion are provably dead work for
          ;; move-free functions.
          (let
            [ep-liveness : CompilerFunctionLiveness
              (compiler-reg-liveness-handle-edge-precise liveness-handle)]
            (compiler-reg-hybrid-coalesce-index
              interval-index
              (compiler-reg-live-interval-selection-ep func ep-liveness)
              ;; Exclude unsafe live-out inputs while admitting proven self-loop
              ;; back-edge-only values. Fixed div/mod or variable-shift functions
              ;; retain the conservative guard: relaxing an otherwise unrelated
              ;; carry can reshape fixed-home pressure differently on SysV/Win64.
              (compiler-reg-function-phi-touched-safe-mode
                func
                ep-liveness
                (= (compiler-live-set-word-count destructive-fixed-points) 0))))
          interval-index))]
    [coalesce : CompilerRegCoalesceMap
      (if allow-caller-saved-zero-call
        (compiler-reg-coalesce-map-build
          moves
          coalesce-index
          type-info
          group-vars
          (array-length (struct-get coalesce-index starts))
          sv-parents)
        (CompilerRegCoalesceMap (array.make-array i64 0)))]
    ;; Collapse coalesce classes to one root candidate each, and run
    ;; the allocation passes over those roots with an EMPTY coalesce map (the
    ;; merge already realised coalescing, so no per-member coalesce-location is
    ;; needed). SIMD/AVX (allow-caller-saved-zero-call = false) builds no coalesce
    ;; map, so eff-* fall back to the originals and that path is byte-identical.
    [eff-index : CompilerRegIntervalIndex
      (if allow-caller-saved-zero-call
        (compiler-reg-merged-root-index coalesce interval-index)
        interval-index)]
    [low-xmm-exclusions : (Array CompilerRegIdList)
      (cfg
        scratch-vreg
        (compiler-reg-low-xmm-exclusions eff-index low-xmm-clobber-points)
        (array.make-array CompilerRegIdList 0))]
    ;; `div-points` / `shift-points` (kinds 1 and 2) are the sets bound above;
    ;; the GAP3c pin demotion below and the greedy share that one computation.
    ;; GAP3c: validate every ABI pin against its coalesce-class hull now that
    ;; the coalesce map exists; unsound pins are unassigned and their params
    ;; fall through to the ordinary greedy CSR path (see
    ;; compiler-reg-param-pins-demote!). Scalar-opt2 only -- the SIMD path
    ;; never pins (param-assign-plan is not on it).
    [_pin-demote : unit
      (if allow-caller-saved-zero-call
        (compiler-reg-param-pins-demote!
          func
          assignment-table
          coalesce
          eff-index
          clobber-points
          div-points
          shift-points
          low-xmm-clobber-points)
        unit)]
    ;; Only scalar opt2 builds the targeted five-pseudo model. When the exact
    ;; literal SafeDiv/SafeMod shape is absent, the builder returns the original
    ;; index/types/table by identity and does not grow the worklist.
    [early-scratch-model : CompilerRegEarlyScratchModel
      (compiler-reg-early-scratch-model
        type-segment-bases
        abi
        func
        eff-index
        type-info
        assignment-table
        allow-caller-saved-zero-call)]
    [allocation-index : CompilerRegIntervalIndex
      (struct-get early-scratch-model interval-index)]
    [early-scratch-base : i64 (struct-get early-scratch-model scratch-base)]
    [early-scratch-count : i64 (struct-get early-scratch-model scratch-count)]
    [early-scratch-weights : (Array i64)
      (struct-get early-scratch-model scratch-weights)]
    ;; move census (cfg regalloc-census only; no-op otherwise): categorise the
    ;; harvested moves against the final coalesce result + per-var and per-root
    ;; segments.
    [_move-census : unit
      (cfg
        regalloc-census
        (if allow-caller-saved-zero-call
          (compiler-reg-move-census-record!
            moves
            (struct-get coalesce parents)
            interval-index
            eff-index
            type-info
            group-vars
            sv-parents)
          unit)
        unit)]
    [eff-intervals : CompilerRegIntervalSeq
      (if allow-caller-saved-zero-call
        (compiler-reg-interval-arrays-to-seq
          (struct-get eff-index starts)
          (struct-get eff-index ends)
          (- (array-length (struct-get eff-index starts)) 1)
          (compiler-reg-interval-seq-empty))
        intervals)]
    [allocation-intervals : CompilerRegIntervalSeq
      (if (= early-scratch-count 0)
        eff-intervals
        (compiler-reg-interval-arrays-to-seq
          (struct-get allocation-index starts)
          (struct-get allocation-index ends)
          (- (array-length (struct-get allocation-index starts)) 1)
          (compiler-reg-interval-seq-empty)))]
    ;; copy-hint biasing: per-root preferred move-neighbour for the integer passes.
    [copy-hints
      : (Array i64)
      ;; Built unconditionally now that the greedy allocates the SIMD-integer path
      ;; too: with the empty false-path coalesce, copy-hints-add-move! falls back to
      ;; identity roots, so this yields direct var->move-neighbour hints -- letting
      ;; the SIMD-integer greedy bias a copy's dst onto its src register (LLVM-style
      ;; copy hint for every class), which the old linear-scan did via `moves`.
      ;; The scalar float->XMM greedy consumes the same hints over its XMM pool.
      (compiler-reg-function-copy-hints
        moves
        coalesce
        (array-length (struct-get interval-index starts))
        func)]
    ;; arg-var -> ABI-arg-register physical preference: each outgoing call-argument
    ;; var biased toward the target register it will be marshalled into, so the
    ;; backend's `movq <home>, <arg-reg>` becomes an elided self-move. Indexed by
    ;; coalesce root, like copy-hints. The scalar-opt2 integer greedy consumes
    ;; this GP-pool array; the float greedy consumes the separate XMM-pool array
    ;; below. SIMD-integer uses a different pool and ignores both.
    [arg-prefs : (Array i64)
      (compiler-reg-function-arg-prefs
        abi
        func
        coalesce
        (array-length (struct-get interval-index starts)))]
    [float-arg-prefs : (Array i64)
      (compiler-reg-function-float-arg-prefs
        abi
        func
        types
        coalesce
        (array-length (struct-get interval-index starts)))]
    ;; The effective scalar allocation pass sees only coalesced
    ;; roots, so original-var exclusions must block the root. Otherwise a root
    ;; may get a register even though one merged member is a call argument or
    ;; parameter that must stay stack/ABI-homed; on Windows that let a stack
    ;; CreateFileA argument inherit %r9 after the same call clobbered %r9 for the
    ;; fourth ABI argument.
    [eff-blocked : CompilerLiveI64Set
      (if allow-caller-saved-zero-call
        (compiler-reg-coalesce-root-set-from-vars coalesce blocked)
        blocked)]
    ;; M-A (RC1): param var ids mapped to their coalesce ROOTS -- each greedy
    ;; allocates class roots, and a class containing a param must be restricted
    ;; to callee-saved homes (alloc-one! `is-param`; the entry copy writes the
    ;; home in the prologue). Reuses the ineligible-params walk as a plain
    ;; param-id collector. Scalar-opt2 only: the SIMD path stack-homes every
    ;; param (ineligible-vars-simd). Integer and float candidates consume the
    ;; same root set over their respective callee-saved banks.
    [param-roots : CompilerLiveI64Set
      (if allow-caller-saved-zero-call
        (compiler-reg-coalesce-root-set-from-vars
          coalesce
          (match func
            [(CompilerIrFunction.Function _ params _ _ _)
              (compiler-reg-ineligible-params params (compiler-live-set-empty))]))
        (compiler-live-set-empty))]
    [integer-candidates : CompilerRegIntervalSeq
      (compiler-reg-candidates eff-intervals type-info eff-blocked false)]
    [scratch-candidates : CompilerRegIntervalSeq
      (compiler-reg-early-scratch-intervals
        allocation-intervals
        early-scratch-base)]
    [integer-registers : CompilerRegIdList
      (compiler-reg-callee-saved-integer-registers-for-abi abi)]
    [vector-mask-defs : CompilerLiveUseDef
      (compiler-reg-function-vector-mask-defs func)]
    ;; Loop-depth-weighted use counts drive spill-weight eviction on the
    ;; integer scalar opt2 stage (allow-caller-saved-zero-call is the scalar-opt2
    ;; discriminator). An empty array selects the original furthest-end policy,
    ;; keeping the SIMD/AVX plan and the caller-saved XMM stage byte-identical.
    [base-eviction-ref-counts : (Array i64)
      (if allow-caller-saved-zero-call
        ;; The greedy ALWAYS uses remat-discounted spill weights for its priority
        ;; order (LLVM RAGreedy always computes spill weights). The old
        ;; remat-weight-needed gate compared total candidates to the full
        ;; (8-register) pool, so a call-spanning function -- whose values may only
        ;; use only the ABI callee-saved suffix and so oversubscribe even below
        ;; the full scalar pool size -- got an empty weight array and fell back to var-id
        ;; order, keeping the rematerialisable constant in a register and spilling
        ;; a more expensive non-remat value. Always scoring fixes that (each
        ;; coalesced class scored by its hottest member). The discounted
        ;; weight is combined with the RAW use-density as a tie-break (combine-
        ;; spill-weights) so that among equal-discounted values the genuinely
        ;; coldest one spills, not an arbitrary tied one.
        (compiler-reg-function-spill-weights-combined
          func
          coalesce
          (array-length (struct-get interval-index starts)))
        (array.make-array i64 0))]
    [base-eviction-raw-counts : (Array i64)
      (if (and allow-caller-saved-zero-call (> early-scratch-count 0))
        (compiler-reg-merge-ref-counts
          coalesce
          (compiler-reg-function-spill-weights func)
          (array-length (struct-get interval-index starts)))
        (array.make-array i64 0))]
    [eviction-ref-counts : (Array i64)
      (compiler-reg-early-scratch-extend-weights
        base-eviction-ref-counts
        base-eviction-raw-counts
        (array-length (struct-get allocation-index starts))
        early-scratch-base
        early-scratch-count
        early-scratch-weights)]
    ;; The greedy's per-register clobber restriction (15c) reuses the kind
    ;; point sets bound above: `clobber-points` IS the kind-0 set, and
    ;; div-points/shift-points let the greedy forbid only the registers each op
    ;; actually clobbers, so a div/shift-spanning value keeps the caller-saved
    ;; regs the op leaves alone instead of being forced callee-saved. On the
    ;; SIMD-integer path caller-saved-count=0 makes every pool register
    ;; callee-saved (no restriction); XMM-family paths use the ABI volatile/
    ;; nonvolatile boundary directly.
    [call-points : CompilerLiveI64Set clobber-points]
    ;; Step B: preserve the established scalar coloring as the base plan. The
    ;; scratch-only worklist below starts from that exact table and may
    ;; evict/requeue real roots when a targeted instruction creates pressure.
    ;; If it moves no real root, downstream passes retain this original table by
    ;; identity, keeping no-pressure functions byte-identical.
    [prepass-assignments : CompilerRegAssignmentTable assignment-table]
    [integer-state
      : CompilerRegAssignState
      ;; Integer allocation via the unified per-vreg Greedy allocator (priority-queue
      ;; selectOrSplit, per-physreg LiveIntervalUnion, call-clobber as interference).
      ;; Scalar-opt2 (true) uses the ABI-specific integer pool + coalescing; the
      ;; SIMD/AVX branch below (false) uses the Linux callee-saved pool with no
      ;; coalescing -- the same algorithm, a conservative config.
      (if allow-caller-saved-zero-call
        (compiler-reg-greedy-state
          integer-candidates
          (compiler-reg-greedy-integer-pool-for-abi abi)
          prepass-assignments
          eff-index
          group-vars
          param-roots
          base-eviction-ref-counts
          copy-hints
          arg-prefs
          call-points
          div-points
          shift-points
          integer-registers
          (compiler-reg-greedy-caller-saved-count-for-abi abi)
          -1)
        ;; SIMD/AVX integer allocation: same unified greedy, over the 5 callee-saved
        ;; integer registers (= the old SIMD pool) with caller-saved-count=0 so every
        ;; register is treated callee-saved (no caller-saved-first ordering; the SIMD
        ;; path never partitioned). ref-counts/copy-hints are empty here -> the
        ;; greedy's bounds-guarded spill-weight/hint accesses fall back to var-id
        ;; order / no-hint, matching the old linear-scan's defaults.
        (compiler-reg-greedy-state
          integer-candidates
          integer-registers
          prepass-assignments
          eff-index
          group-vars
          (compiler-live-set-empty)
          base-eviction-ref-counts
          copy-hints
          (array.make-array i64 0)
          call-points
          div-points
          shift-points
          integer-registers
          0
          -1))]
    [base-integer-assignments : CompilerRegAssignmentTable
      (match integer-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    ;; The early interval shape is allocation-independent, but each lowering
    ;; constraint excludes the instruction operands' PHYSICAL homes. Refresh the
    ;; targeted model after base coloring so C15b's scratch phase cannot claim a
    ;; home that the retained late planner must reject. Non-target functions keep
    ;; the original empty model by identity and pay no second walk.
    [colored-early-scratch-model : CompilerRegEarlyScratchModel
      (if (= early-scratch-count 0)
        early-scratch-model
        (compiler-reg-early-scratch-model
          type-segment-bases
          abi
          func
          eff-index
          type-info
          base-integer-assignments
          true))]
    [allocation-table : CompilerRegAssignmentTable
      (struct-get colored-early-scratch-model assignments)]
    [early-scratch-excluded : (Array CompilerRegIdList)
      (struct-get colored-early-scratch-model scratch-excluded)]
    [scratch-input-assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-with-scratch
        base-integer-assignments
        allocation-table
        early-scratch-base
        early-scratch-count)]
    [scratch-state : CompilerRegAssignState
      (if (= early-scratch-count 0)
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          scratch-input-assignments)
        (compiler-reg-greedy-state-with-scratch-exclusions
          scratch-candidates
          (compiler-reg-greedy-integer-pool-for-abi abi)
          scratch-input-assignments
          allocation-index
          group-vars
          param-roots
          eviction-ref-counts
          copy-hints
          arg-prefs
          call-points
          div-points
          shift-points
          integer-registers
          (compiler-reg-greedy-caller-saved-count-for-abi abi)
          early-scratch-base
          early-scratch-excluded))]
    [integer-scratch-assignments : CompilerRegAssignmentTable
      (match scratch-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [integer-assignments : CompilerRegAssignmentTable
      (if (or
        (= early-scratch-count 0)
        (compiler-reg-assignment-table-prefix-eq?
          base-integer-assignments
          integer-scratch-assignments
          early-scratch-base
          0))
        base-integer-assignments
        (compiler-reg-assignment-table-prefix
          integer-scratch-assignments
          early-scratch-base))]
    ;; Step B: the caller-saved-overflow pass is gone -- the unified greedy already
    ;; allocates the caller-saved zero-call prefix itself, so retrying the same
    ;; registers here was redundant. The call-spanning save/restore rescue (a
    ;; real spill-avoidance, not a register-allocation pass) is kept and fed the
    ;; greedy's assignments directly.
    [integer-with-call-save-state : CompilerRegCallSaveAssignState
      (if (and
        allow-caller-saved-zero-call
        (compiler-reg-assignment-table-has-spill? integer-assignments))
        (compiler-reg-assign-caller-saved-call-spanning
          type-segment-bases
          abi
          func
          integer-candidates
          integer-assignments
          eff-index
          type-info
          group-vars
          (struct-get coalesce parents))
        (CompilerRegCallSaveAssignState.State
          integer-assignments
          (compiler-reg-call-split-empty)))]
    [integer-call-assignments : CompilerRegAssignmentTable
      (match integer-with-call-save-state
        [(CompilerRegCallSaveAssignState.State assignments _) assignments])]
    [call-save-split : CompilerRegCallSplit
      (match integer-with-call-save-state
        [(CompilerRegCallSaveAssignState.State _ split) split])]
    [call-save-shadows : CompilerLiveI64Set
      (compiler-reg-call-split-shadows call-save-split)]
    [scalar-state
      : CompilerRegAssignState
      ;; float -> XMM allocation: the unified greedy over the ABI XMM bank.
      ;; A clobber-spanning float starts at the ABI callee-saved suffix: none on
      ;; SysV (so it spills), XMM6-XMM15 on Win64. Non-spanning floats may use the
      ;; whole configured XMM pool. Reuse the coalesced-class spill weights and copy
      ;; hints so float pressure is ordered by actual use density and moves bias
      ;; toward an already assigned neighbour, matching the integer greedy.
      (compiler-reg-greedy-state-with-scratch-exclusions
        (compiler-reg-candidates eff-intervals type-info eff-blocked true)
        (compiler-reg-xmm-registers-for-abi abi)
        integer-call-assignments
        eff-index
        group-vars
        param-roots
        base-eviction-ref-counts
        copy-hints
        float-arg-prefs
        xmm-call-points
        div-points
        shift-points
        (compiler-reg-xmm-callee-registers-for-abi abi)
        (compiler-reg-xmm-caller-register-count-for-abi abi)
        -1
        low-xmm-exclusions)]
    [scalar-assignments : CompilerRegAssignmentTable
      (match scalar-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [_float-call-arg-demote : unit
      (if allow-caller-saved-zero-call
        (compiler-reg-float-call-args-demote!
          abi
          func
          types
          coalesce
          scalar-assignments)
        unit)]
    [vector-vars : CompilerLiveI64Set (struct-get vector-mask-defs uses)]
    [mask-vars : CompilerLiveI64Set (struct-get vector-mask-defs defs)]
    ;; Scalar-only functions (no vector or mask IR values) have no special
    ;; candidates at all: the select-false preference walk, both special-candidate
    ;; interval filters, the vector greedy, and the mask fixed-candidate pass all
    ;; return their inputs unchanged, so skip the whole vector/mask prep chain.
    [vector-mask-empty? : bool
      (and
        (= (compiler-live-set-count vector-vars) 0)
        (= (compiler-live-set-count mask-vars) 0))]
    [vector-candidate-vars : CompilerLiveI64Set
      (if vector-mask-empty?
        vector-vars
        (if mask-vars-use-vector-registers
          (compiler-live-set-union vector-vars mask-vars)
          vector-vars))]
    [mask-candidate-vars : CompilerLiveI64Set
      (if vector-mask-empty?
        mask-vars
        (if mask-vars-use-vector-registers
          (compiler-live-set-empty)
          mask-vars))]
    [vector-preferences : (Array i64)
      (if vector-mask-empty?
        (array.make-array i64 0)
        (compiler-reg-function-select-false-preferences
          func
          (array-length (struct-get interval-index starts))))]
    [vector-candidates : CompilerRegIntervalSeq
      (if vector-mask-empty?
        (compiler-reg-interval-seq-empty)
        (compiler-reg-special-candidates
          intervals
          vector-candidate-vars
          blocked))]
    [_vector-class-reset : unit
      (compiler-reg-unassign-special-candidates!
        scalar-assignments
        vector-candidates)]
    [vector-state
      : CompilerRegAssignState
      ;; Vectors share the XMM physical bank and the scalar greedy's ABI
      ;; clobber rule. `%vecN` is an allocator-only class spelling; backend
      ;; save/restore sees the same physical N through the overlap helper.
      (if vector-mask-empty?
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          scalar-assignments)
        (compiler-reg-greedy-state
          vector-candidates
          (compiler-reg-vector-registers-for-abi abi)
          scalar-assignments
          interval-index
          (compiler-live-set-empty)
          (compiler-live-set-empty)
          (array.make-array i64 0)
          vector-preferences
          (array.make-array i64 0)
          xmm-call-points
          div-points
          shift-points
          (compiler-reg-vector-callee-registers-for-abi abi)
          (compiler-reg-vector-caller-register-count-for-abi abi)
          -1))]
    [vector-assignments : CompilerRegAssignmentTable
      (match vector-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [_mask-class-reset
      : unit
      ;; The scalar greedy provisionally homes mask values in GP registers.
      ;; Clear those homes before fixed k-register allocation so excess mask
      ;; pressure remains unassigned and is emitted through the existing
      ;; stack-slot spill path instead of reaching the backend as a GP home.
      (compiler-reg-unassign-special-candidates!
        vector-assignments
        (compiler-reg-special-candidates intervals mask-candidate-vars blocked))]
    [mask-state : CompilerRegAssignState
      (if vector-mask-empty?
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          vector-assignments)
        (compiler-reg-assign-fixed-candidates
          (compiler-reg-special-candidates
            intervals
            mask-candidate-vars
            blocked)
          (compiler-reg-mask-registers)
          (compiler-reg-active-seq-empty)
          vector-assignments
          (array.make-array i64 0)
          interval-index))]
    [assignments : CompilerRegAssignmentTable
      (match mask-state
        [(CompilerRegAssignState.State _ found) found])]
    ;; SplitKit removed: CompilerRegPlan still carries an (empty) split-plan
    ;; field, but nothing populates or consumes it.
    [split-plan : CompilerRegSplitPlan (compiler-reg-split-plan-empty)]
    ;; The passes above assigned class ROOTS; expand so every member
    ;; inherits its root's location (realising the coalesce). SIMD/AVX has no
    ;; coalesce map, so this is the identity there.
    [final-assignments : CompilerRegAssignmentTable
      (if allow-caller-saved-zero-call
        (compiler-reg-rewrite-remat-assignments
          (compiler-reg-expand-class-assignments
            assignments
            coalesce
            storage-identity-vars
            (struct-get interval-index starts)
            (array-length (struct-get interval-index starts)))
          func
          coalesce
          call-save-shadows
          (array-length (struct-get interval-index starts)))
        assignments)]
    ;; GAP2b: register-pair homing for group values. Runs LAST, when every
    ;; scalar home is final, so pair selection/eviction is judged against the
    ;; exact register landscape the backend will see. Linux scalar-opt2 only
    ;; (the M-G3/M-F gating pattern); every other path is byte-identical.
    [pair-assignments : CompilerRegAssignmentTable
      (if allow-caller-saved-zero-call
        (match abi
          [(CompilerRegTargetAbi.Linux)
            (compiler-reg-assign-group-pairs
              type-segment-bases
              func
              type-info
              group-vars
              interval-index
              final-assignments
              base-eviction-ref-counts
              call-points
              call-save-split)]
          [(CompilerRegTargetAbi.Windows) final-assignments])
        final-assignments)]
    (CompilerRegPlan.Plan
      (compiler-reg-assignment-table-to-list pair-assignments)
      ineligible
      intervals
      types
      call-save-split
      split-plan)))

;; SIMD/AVX register plan (unchanged from before #perf): full dataflow-liveness
;; intervals + the call-live-conservative ineligibility, keeping AVX backend
;; golden output byte-identical.
(define (compiler-reg-plan-function-with-type-segment-bases-for-abi
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make func false)]
    [liveness : CompilerFunctionLiveness (struct-get liveness-handle baseline)]
    [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    [types : CompilerRegVarTypeList (compiler-reg-var-types-list type-info)]
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-live-intervals func liveness)]
    [ineligible : CompilerLiveI64Set
      (compiler-reg-ineligible-vars-simd func type-info types intervals)]
    [vars : i64
      (match func
        [(CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    (compiler-reg-plan-from
      type-segment-bases
      func
      liveness-handle
      type-info
      types
      intervals
      (compiler-reg-interval-index-build intervals vars)
      (compiler-reg-assignment-table-make vars)
      ineligible
      ineligible
      false
      false
      abi
      false
      (- 0 1))))

(define (compiler-reg-plan-function-for-abi
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-with-type-segment-bases-for-abi
    (ast-node-pool-reader-type-segment-bases)
    abi
    func))

(define (compiler-reg-plan-function [func : CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-for-abi CompilerRegTargetAbi.Linux func))

(define (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make func false)]
    [liveness : CompilerFunctionLiveness (struct-get liveness-handle baseline)]
    [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    [types : CompilerRegVarTypeList (compiler-reg-var-types-list type-info)]
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-live-intervals func liveness)]
    [ineligible : CompilerLiveI64Set
      (compiler-reg-ineligible-vars-simd func type-info types intervals)]
    [vars : i64
      (match func
        [(CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    (compiler-reg-plan-from
      type-segment-bases
      func
      liveness-handle
      type-info
      types
      intervals
      (compiler-reg-interval-index-build intervals vars)
      (compiler-reg-assignment-table-make vars)
      ineligible
      ineligible
      false
      true
      abi
      false
      (- 0 1))))

(define (compiler-reg-plan-function-avx2-for-abi
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
    (ast-node-pool-reader-type-segment-bases)
    abi
    func))

(define (compiler-reg-scalar-full-intervals? [func : CompilerIrFunction]) : bool
  (match func
    [(CompilerIrFunction.Function _ _ _ _ _) true]))

;; M-A (RC1) correctness requirement: a register-homed param's home register is
;; WRITTEN by the backend's entry copy in the prologue, before the first
;; instruction, so the param's interval must be reserved from the function's
;; first point. The precise (segmented) builder starts a live-in-at-entry param
;; at point 1 (live-after of instr 0 extends at point+1); a var whose interval
;; is exactly [0,0] would then look disjoint under the coarse [start,end]
;; fallback, share the param's home register, and its instr-0 def would
;; overwrite the param's entry-copied value before the param's first read.
;; Force every used param's interval (both starts[] and its earliest segment)
;; to start at point 0. Params with no interval (never used) are left alone --
;; they never become candidates.
(define (compiler-reg-param-segments-extend-entry
  [segs : CompilerRegIntervalSeq]
  [min-start : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count segs))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segs))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref segs index)]
            [start : i64 (struct-get interval start)]
            (set!
              out
              (compiler-reg-interval-seq-append
                out
                (CompilerRegInterval
                  (struct-get interval var)
                  (if (= start min-start)
                    0
                    start)
                  (struct-get interval end)))))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-param-segments-min-start
  [segs : CompilerRegIntervalSeq]
  [best : i64]) : i64
  (let
    [out : i64 best]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segs))
        (begin
          (let
            [start : i64
              (struct-get (compiler-reg-interval-seq-ref segs index) start)]
            (if (or (< out 0) (< start out))
              (set! out start)
              unit))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-param-intervals-extend-entry!
  [params : CompilerIrParamList]
  [interval-index : CompilerRegIntervalIndex]) : unit
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) unit]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-param-intervals-extend-entry!
        (compiler-ir-param-seq-to-list seq)
        interval-index)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var)
          (let
            [starts : (Array i64) (struct-get interval-index starts)]
            [segments : (Array CompilerRegIntervalSeq)
              (struct-get interval-index segments)]
            (begin
              (if (and
                (>= var 0)
                (< var (array-length starts))
                (> (array-ref starts var) 0))
                (begin
                  (array-set! starts var 0)
                  (if (< var (array-length segments))
                    (let
                      [segs : CompilerRegIntervalSeq (array-ref segments var)]
                      [min-start : i64
                        (compiler-reg-param-segments-min-start segs (- 0 1))]
                      (if (> min-start 0)
                        (begin
                          (array-set!
                            segments
                            var
                            (compiler-reg-param-segments-extend-entry
                              segs
                              min-start))
                          unit)
                        unit))
                    unit))
                unit)
              (compiler-reg-param-intervals-extend-entry!
                (box-get rest)
                interval-index)))])]))

(define (compiler-reg-live-set-insert-range
  [set : CompilerLiveI64Set]
  [start : i64]
  [end : i64]) : CompilerLiveI64Set
  (if (>= start end)
    set
    (compiler-reg-live-set-insert-range
      (compiler-live-set-insert set start)
      (+ start 1)
      end)))

;; An empty var-type view, for callers that must bind one on a path where the
;; scalar plan is not taken and no types are needed.
(define (compiler-reg-var-types-empty) : CompilerRegVarTypes
  (CompilerRegVarTypes (array.make-array i64 0) (array.make-array AstType 0)))

(define (compiler-reg-plan-function-scalar-cold-for-abi
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [forced-spill-from : i64]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-for-abi-with-types
    abi
    func
    forced-spill-from
    (compiler-reg-function-var-types func)))

;; `type-info` must be `(compiler-reg-function-var-types func)`. The backend
;; already needs that view for its caller-save rewrite, so it computes it once
;; and passes it in rather than having both walk the function.
(define (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]
  [forced-assignments : CompilerRegAssignmentList]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make func true)]
    [types : CompilerRegVarTypeList (compiler-reg-var-types-list type-info)]
    [vars : i64
      (match func
        [(CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    [interval-selection : CompilerRegIntervalSelection
      (if (compiler-reg-scalar-full-intervals? func)
        (compiler-reg-live-interval-selection
          func
          (if (>= forced-spill-from 0)
            (compiler-reg-liveness-handle-edge-precise liveness-handle)
            (struct-get liveness-handle baseline)))
        (let
          [block-intervals : CompilerRegIntervalSeq
            (compiler-reg-block-intervals func)]
          (CompilerRegIntervalSelection.Selection
            block-intervals
            (compiler-reg-interval-index-build block-intervals vars))))]
    (match interval-selection
      [(CompilerRegIntervalSelection.Selection _ interval-index)
        (let
          ;; M-A (RC1): reserve every used param's interval from function entry
          ;; (mutates the index arrays), then rebuild the interval sequence from
          ;; the mutated arrays so both views agree. Content-identical to the
          ;; builder's sequence when no param moved.
          [_param-extend : unit
            (match func
              [(CompilerIrFunction.Function _ params _ _ _)
                (compiler-reg-param-intervals-extend-entry!
                  params
                  interval-index)])]
          [intervals : CompilerRegIntervalSeq
            (compiler-reg-interval-arrays-to-seq
              (struct-get interval-index starts)
              (struct-get interval-index ends)
              (- vars 1)
              (compiler-reg-interval-seq-empty))]
          [cold-split? : bool (>= forced-spill-from 0)]
          [base-ineligible : CompilerLiveI64Set
            (let
              [base : CompilerLiveI64Set
                (compiler-reg-ineligible-vars-non-params
                  type-segment-bases
                  func
                  types
                  abi)]
              (if cold-split?
                (compiler-reg-live-set-insert-range base forced-spill-from vars)
                base))]
          [param-plan : CompilerRegParamAssignPlan
            (compiler-reg-param-assign-plan
              type-segment-bases
              abi
              func
              interval-index
              base-ineligible
              vars
              cold-split?)]
          (match param-plan
            [(CompilerRegParamAssignPlan.Plan preassignments ineligible blocked)
              (let
                [_forced : unit
                  (compiler-reg-assignment-table-fill!
                    preassignments
                    forced-assignments)]
                (compiler-reg-plan-from
                  type-segment-bases
                  func
                  liveness-handle
                  type-info
                  types
                  intervals
                  interval-index
                  preassignments
                  ineligible
                  blocked
                  true
                  false
                  abi
                  cold-split?
                  forced-spill-from))]))])))

(define (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
    type-segment-bases
    abi
    func
    forced-spill-from
    type-info
    CompilerRegAssignmentList.Nil))

(define (compiler-reg-plan-function-scalar-cold-for-abi-with-types
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
    (ast-node-pool-reader-type-segment-bases)
    abi
    func
    forced-spill-from
    type-info))

(define (compiler-reg-plan-function-scalar-for-abi
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-for-abi abi func (- 0 1)))

(define (compiler-reg-plan-function-scalar [func : CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-for-abi CompilerRegTargetAbi.Linux func))

;; The cold-call carrier is the ABI boundary: it must never be colored into a
;; register or rematerialized, because the real call is deliberately absent
;; from the GP clobber mask.  Missing assignments are the backend's ordinary
;; stack-home representation and are therefore valid here.
(cfg
  (any test scavenge-self-check)
  (define (compiler-reg-cold-call-carriers-stack?
    [plan : CompilerRegPlan]
    [temp-start : i64]
    [vars : i64]) : bool
    (if (< temp-start 0)
      true
      (match plan
        [(CompilerRegPlan.Plan assignments _ _ _ _ _)
          (let
            [v : i64 temp-start]
            [ok : bool (< temp-start vars)]
            (begin
              (while (and ok (< v vars))
                (begin
                  (match (compiler-reg-assignment-lookup assignments v)
                    [(CompilerRegMaybeLocation.No) unit]
                    [(CompilerRegMaybeLocation.Some location)
                      (match location
                        [(CompilerRegLocation.Spill _) unit]
                        [_ (set! ok false)])])
                  (set! v (+ v 1))))
              ok))]))))

(define (compiler-reg-plan-function-stack-only [func : CompilerIrFunction]) : CompilerRegPlan
  (let
    [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    (CompilerRegPlan.Plan
      CompilerRegAssignmentList.Nil
      (compiler-live-set-empty)
      (compiler-reg-interval-seq-empty)
      (compiler-reg-var-types-list type-info)
      (compiler-reg-call-split-empty)
      (compiler-reg-split-plan-empty))))

;; --- stack-slot compaction and storage coloring -----------------------------
;; One frame slot per raw IR variable wastes most of the frame once register
;; allocation has moved many values into registers. The scalar pass renumbers
;; stack-resident scalar variables into a dense frame-slot prefix after regalloc,
;; preserving parameter ids for the prologue spill contract. A second pass
;; colors contiguous inline-storage ranges, sharing those range slots when their
;; AddrOf/Gep-derived pointer lifetimes are disjoint. Variables that already
;; have a register home, dead raw-id holes, and register-only scratch pseudo-vars
;; receive free non-slot ids, and stack-homed register groups are remapped by
;; their word0 id; the backend places word1 in the matching second var-region.
;; Plans with no intervals (the stack-only opt0/opt1 path skips liveness) pass
;; through unchanged. The result's slot count replaces the raw var count in the
;; backend's frame layout.
(defenum CompilerRegColoring
  (None)
  (Remap (Array i64) i64))

;; Per-var slot-colorability flags: only values the register allocator could
;; legally home in one 64-bit register (scalars and 8-byte handles) are known
;; to occupy exactly one frame slot. Anything else (vectors, masks, inline
;; groups, unknown) is skipped by the scalar interval walk and then receives a
;; private dense slot if it still needs stack storage.
(define (compiler-reg-color-flags
  [types : CompilerRegVarTypeList]
  [flags : (Array bool)]) : unit
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-color-flags (compiler-reg-var-type-seq-to-list seq) flags)]
    [(CompilerRegVarTypeList.Nil) unit]
    [(CompilerRegVarTypeList.Cons item rest)
      (let
        [var : i64 (struct-get item var)]
        (begin
          (if (< var (array-length flags))
            (array-set!
              flags
              var
              (or
                (compiler-reg-scalar-type? (struct-get item ty))
                (compiler-reg-handle-type? (struct-get item ty))))
            unit)
          (compiler-reg-color-flags (box-get rest) flags)))]))

;; Mark every variable with a final liveness interval. Combined with direct IR
;; uses/defs below, this distinguishes real values (including dead emitted defs)
;; from gaps in the monotonic variable-id watermark.
(define (compiler-reg-color-reference-intervals!
  [intervals : CompilerRegIntervalSeq]
  [references : (Array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [var : i64
            (struct-get (compiler-reg-interval-seq-ref intervals index) var)]
          (if (and (>= var 0) (< var (array-length references)))
            (array-set! references var 1)
            unit))
        (set! index (+ index 1))))))

;; Per-var AstType array for the coloring walk's same-type sharing guard.
;; Every colorable var has a types-list entry (compiler-reg-color-flags only
;; sets its flag from one), so the walk never reads an unwritten element.
(define (compiler-reg-color-var-tys
  [types : CompilerRegVarTypeList]
  [tys : (Array AstType)]) : unit
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-color-var-tys (compiler-reg-var-type-seq-to-list seq) tys)]
    [(CompilerRegVarTypeList.Nil) unit]
    [(CompilerRegVarTypeList.Cons item rest)
      (let
        [var : i64 (struct-get item var)]
        (begin
          (if (< var (array-length tys))
            (array-set! tys var (struct-get item ty))
            unit)
          (compiler-reg-color-var-tys (box-get rest) tys)))]))

(define (compiler-reg-vector-elem-size [ty : AstType]) : i64
  (match ty
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [_ 8]))

(define (compiler-reg-vector-stack-words-for-shape
  [lanes : i64]
  [elem-ty : AstType]) : i64
  (let
    [bytes : i64 (* lanes (compiler-reg-vector-elem-size elem-ty))]
    (if (<= bytes 0)
      1
      (/ (+ bytes 7) 8))))

(define (compiler-reg-vector-stack-words-set!
  [words : (Array i64)]
  [var : i64]
  [lanes : i64]
  [elem-ty : AstType]) : unit
  (if (or (< var 0) (>= var (array-length words)))
    unit
    (let
      [next : i64 (compiler-reg-vector-stack-words-for-shape lanes elem-ty)]
      [old : i64 (array-ref words var)]
      (if (> next old)
        (array-set! words var next)
        unit))))

(define (compiler-reg-vector-stack-words-set-mask!
  [words : (Array i64)]
  [var : i64]) : unit
  ;; AVX2 represents lane masks in a full YMM register. AVX-512 uses compact
  ;; k-register spills, but reserving the same four-word range is harmless and
  ;; keeps this target-neutral census conservative.
  (if (or (< var 0) (>= var (array-length words)))
    unit
    (let
      [old : i64 (array-ref words var)]
      (if (> old 3)
        unit
        (array-set! words var 4)))))

(define (compiler-reg-vector-stack-words-instr!
  [instr : CompilerIrInstr]
  [words : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.LaneId dst lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(CompilerIrInstr.Splat dst _ lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (if (= lanes 0)
          unit
          (match elem-ty
            [(AstType.Bool)
              (compiler-reg-vector-stack-words-set-mask! words dst)]
            [_ (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)])))]
    [(CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        (compiler-reg-vector-stack-words-set-mask! words dst))]
    [(CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(CompilerIrInstr.MaskNot dst _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(CompilerIrInstr.TailMask dst _ _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(CompilerIrInstr.VectorLoad dst _ _ lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (match elem-ty
          [(AstType.Bool) (compiler-reg-vector-stack-words-set-mask! words dst)]
          [_ (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]))]
    [(CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (struct-get (box-get payload-box) backend)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [result (struct-get (box-get payload-box) result)]
        (match backend
          [(CompilerIrSpmdBackend.Avx512)
            (match result
              [(CompilerIrSpmdCallResult.Unit) unit]
              [(CompilerIrSpmdCallResult.Value dst class elem-ty)
                (match class
                  [(CompilerIrSpmdValueClass.Varying)
                    (compiler-reg-vector-stack-words-set!
                      words
                      dst
                      lanes
                      elem-ty)]
                  [_ unit])])]
          [_ unit]))]
    [_ unit]))

(define (compiler-reg-vector-stack-words-seq!
  [instrs : CompilerIrInstrSeq]
  [words : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-vector-stack-words-instr! (array-ref slots index) words)
        (set! index (+ index 1))))))

(define (compiler-reg-vector-stack-words-blocks!
  [blocks : CompilerIrBlockList]
  [words : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-vector-stack-words-seq! instrs words)])
        (compiler-reg-vector-stack-words-blocks! (box-get rest) words))]
    [(CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        (while (< index (compiler-ir-block-seq-count seq))
          (begin
            (match (compiler-ir-block-seq-ref seq index)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-vector-stack-words-seq! instrs words)])
            (set! index (+ index 1)))))]))

(define (compiler-reg-vector-stack-extra-slots
  [words : (Array i64)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (array-length words))
    acc
    (let
      [w : i64 (array-ref words index)]
      (compiler-reg-vector-stack-extra-slots
        words
        (+ index 1)
        (if (> w 1)
          (+ acc (- w 1))
          acc)))))

(define (compiler-reg-vector-stack-words-for-var
  [words : (Array i64)]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length words)))
    1
    (let
      [w : i64 (array-ref words var)]
      (if (> w 1)
        w
        1))))

(define (compiler-reg-color-reserve-private-range!
  [slot-ends : (Array i64)]
  [next : i64]
  [words : i64]) : i64
  (let
    [size : i64
      (if (> words 1)
        words
        1)]
    [slot : i64 (compiler-reg-color-next-free-range slot-ends next size 0)]
    (begin
      (compiler-reg-color-set-range-ends!
        slot-ends
        slot
        size
        9223372036854775807)
      slot)))

;; Sorted insert by (start, var): deterministic processing order.
;; In-place heapsort of an interval array by (start, var) -- deterministic
;; total order, O(n log n), no allocation beyond the array itself (the
;; insertion-sort cons spine it replaces allocated O(n^2) cells, which blew
;; the scratch arena on ~7000-var functions).
(define (compiler-reg-color-interval-before?
  [a : CompilerRegInterval]
  [b : CompilerRegInterval]) : bool
  (let
    [a-start : i64 (struct-get a start)]
    [b-start : i64 (struct-get b start)]
    (or
      (< a-start b-start)
      (and (= a-start b-start) (< (struct-get a var) (struct-get b var))))))

(define (compiler-reg-color-interval-copy [item : CompilerRegInterval]) : CompilerRegInterval
  (CompilerRegInterval
    (struct-get item var)
    (struct-get item start)
    (struct-get item end)))

(define (compiler-reg-color-sift-down
  [items : (Array CompilerRegInterval)]
  [root : i64]
  [count : i64]) : unit
  (let
    [node : i64 root]
    [done : bool false]
    (while (not done)
      (let
        [left : i64 (+ (* node 2) 1)]
        [right : i64 (+ (* node 2) 2)]
        [largest : i64
          (let
            [pick : i64 node]
            (begin
              (if (and
                (< left count)
                (compiler-reg-color-interval-before?
                  (array-ref items pick)
                  (array-ref items left)))
                (set! pick left)
                unit)
              (if (and
                (< right count)
                (compiler-reg-color-interval-before?
                  (array-ref items pick)
                  (array-ref items right)))
                (set! pick right)
                unit)
              pick))]
        (if (= largest node)
          (set! done true)
          (let
            [node-item : CompilerRegInterval
              (compiler-reg-color-interval-copy (array-ref items node))]
            [largest-item : CompilerRegInterval
              (compiler-reg-color-interval-copy (array-ref items largest))]
            (begin
              (array-set! items node largest-item)
              (array-set! items largest node-item)
              (set! node largest))))))))

(define (compiler-reg-color-heapsort
  [items : (Array CompilerRegInterval)]
  [count : i64]) : unit
  (begin
    (let
      [i : i64 (- (/ count 2) 1)]
      (while (>= i 0)
        (begin
          (compiler-reg-color-sift-down items i count)
          (set! i (- i 1)))))
    (let
      [last : i64 (- count 1)]
      (while (> last 0)
        (let
          [root-item : CompilerRegInterval
            (compiler-reg-color-interval-copy (array-ref items 0))]
          [last-item : CompilerRegInterval
            (compiler-reg-color-interval-copy (array-ref items last))]
          (begin
            (array-set! items 0 last-item)
            (array-set! items last root-item)
            (compiler-reg-color-sift-down items 0 last)
            (set! last (- last 1))))))))

(define (compiler-reg-color-interval-count [intervals : CompilerRegIntervalSeq]) : i64
  (compiler-reg-interval-seq-count intervals))

(define (compiler-reg-color-interval-fill
  [intervals : CompilerRegIntervalSeq]
  [items : (Array CompilerRegInterval)]
  [index : i64]) : unit
  (let
    [source-index : i64 0]
    [out-index : i64 index]
    (while (< source-index (compiler-reg-interval-seq-count intervals))
      (begin
        (array-set!
          items
          out-index
          (compiler-reg-interval-seq-ref intervals source-index))
        (set! source-index (+ source-index 1))
        (set! out-index (+ out-index 1))))))

(define (compiler-reg-color-sorted-array [intervals : CompilerRegIntervalSeq]) : (Array
    CompilerRegInterval)
  (let
    [count : i64 (compiler-reg-color-interval-count intervals)]
    [items : (Array CompilerRegInterval)
      (array.make-array CompilerRegInterval count)]
    (begin
      (compiler-reg-color-interval-fill intervals items 0)
      (compiler-reg-color-heapsort items count)
      items)))

;; Per-variable full lifetime end over all split live intervals. The scalar
;; coloring walk assigns each variable one remapped frame slot, so a slot must
;; stay busy until that variable's last interval ends, even if the interval
;; sequence has a hole before a later use.
(define (compiler-reg-color-extent-ends
  [items : (Array CompilerRegInterval)]
  [vars : i64]) : (Array i64)
  (let
    [ends : (Array i64) (array.make-array i64 vars)]
    [i : i64 0]
    (begin
      (while (< i vars)
        (begin
          (array-set! ends i (- 0 1))
          (set! i (+ i 1))))
      (set! i 0)
      (while (< i (array-length items))
        (let
          [interval : CompilerRegInterval (array-ref items i)]
          [var : i64 (struct-get interval var)]
          [end : i64 (struct-get interval end)]
          (begin
            (if (and (>= var 0) (< var vars) (> end (array-ref ends var)))
              (array-set! ends var end)
              unit)
            (set! i (+ i 1)))))
      ends)))

;; First slot id at or after `from` that is not identity-pinned to a
;; parameter (pins mark slot-ends with i64-max). Fresh slots fill the gaps a
;; sparse parameter id leaves behind, so slot ids never run past the pinned
;; band and the overall renumbering stays inside [0, vars).
(define (compiler-reg-color-next-free-slot
  [slot-ends : (Array i64)]
  [from : i64]) : i64
  (if (>= from (array-length slot-ends))
    from
    (if (= (array-ref slot-ends from) 9223372036854775807)
      (compiler-reg-color-next-free-slot slot-ends (+ from 1))
      from)))

;; Lowest used slot whose previous occupant ended strictly before `start`.
;; STRICT `<`: phi parallel copies at a block edge read inputs and write
;; destinations at the same interval position, so same-position reuse would let
;; one phi's destination clobber another phi's not-yet-read input through the
;; slot. Parameter pins use i64-max in slot-ends and therefore never match.
;; SAME-TYPE only: sharing a slot MERGES the two variables' ids in the emitted
;; IR, and the rebuilt per-id type table keeps ONE type. The backend recovers
;; operand width/signedness/float-ness from that table (e.g.
;; compiler-backend-binop-operand-ty for bit ops), so merging an i64 with a
;; bool would emit `andb` for a 64-bit bit-and -- a real M-A2 bring-up
;; miscompile (compiler-live-set-minus-words). Only type-identical variables
;; may merge.
(define (compiler-reg-color-find-slot
  [type-segment-bases : i64]
  [slot-ends : (Array i64)]
  [slot-tys : (Array AstType)]
  [ty : AstType]
  [used : i64]
  [start : i64]
  [index : i64]) : i64
  (if (>= index used)
    used
    (if (and
      (< (array-ref slot-ends index) start)
      (ast-type-eq-with-seg-bases?
        type-segment-bases
        (array-ref slot-tys index)
        ty))
      index
      (compiler-reg-color-find-slot
        type-segment-bases
        slot-ends
        slot-tys
        ty
        used
        start
        (+ index 1)))))

(define (compiler-reg-color-walk
  [type-segment-bases : i64]
  [items : (Array CompilerRegInterval)]
  [count : i64]
  [index : i64]
  [assignment-index : CompilerRegAssignmentIndex]
  [pinned : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]
  [colorable : (Array bool)]
  [var-tys : (Array AstType)]
  [slot-ends : (Array i64)]
  [slot-tys : (Array AstType)]
  [extent-ends : (Array i64)]
  [used : i64]
  [remap : (Array i64)]) : i64
  (if (>= index count)
    used
    (let
      [interval : CompilerRegInterval (array-ref items index)]
      [var : i64 (struct-get interval var)]
      [start : i64 (struct-get interval start)]
      [end : i64 (struct-get interval end)]
      (if (or
        ;; Already renumbered: parameter identity pins (the prologue's
        ;; param spill targets the ORIGINAL id's formula slot, so a pinned
        ;; id must never be reassigned mid-walk) and split intervals (the
        ;; first interval wins; revisiting would leak the first slot).
        (>= (array-ref remap var) 0)
        (not (array-ref colorable var))
        (compiler-live-set-contains? pinned var)
        (compiler-live-set-contains? ineligible var)
        ;; Spilled scalars are re-homed by the id remap (the stale
        ;; assignment entry keyed by the old id is never queried);
        ;; register-homed values keep their ids and homes.
        (match (compiler-reg-assignment-index-lookup assignment-index var)
          [(CompilerRegMaybeLocation.Some location)
            (match location
              [(CompilerRegLocation.Spill _) false]
              [_ true])]
          [(CompilerRegMaybeLocation.No) false]))
        (compiler-reg-color-walk
          type-segment-bases
          items
          count
          (+ index 1)
          assignment-index
          pinned
          ineligible
          colorable
          var-tys
          slot-ends
          slot-tys
          extent-ends
          used
          remap)
        (let
          ;; Prefer the lowest SAME-TYPE scalar slot whose prior owner ended
          ;; before this variable starts. Otherwise take a fresh slot,
          ;; skipping param-pinned ids so sparse parameter ids leave no hole.
          [ty : AstType (array-ref var-tys var)]
          [found : i64
            (compiler-reg-color-find-slot
              type-segment-bases
              slot-ends
              slot-tys
              ty
              used
              start
              0)]
          [slot : i64
            (if (>= found used)
              (compiler-reg-color-next-free-slot slot-ends used)
              found)]
          [next-used : i64
            (if (>= found used)
              (+ slot 1)
              used)]
          [full-end : i64 (compiler-reg-max end (array-ref extent-ends var))]
          (begin
            (array-set! slot-ends slot full-end)
            (if (< slot (array-length slot-tys))
              (array-set! slot-tys slot ty)
              unit)
            (array-set! remap var slot)
            (compiler-reg-color-walk
              type-segment-bases
              items
              count
              (+ index 1)
              assignment-index
              pinned
              ineligible
              colorable
              var-tys
              slot-ends
              slot-tys
              extent-ends
              next-used
              remap)))))))

(define (compiler-reg-color-fill-interval-bounds
  [intervals : CompilerRegIntervalSeq]
  [starts : (Array i64)]
  [ends : (Array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 (struct-get interval var)]
          (if (and (>= var 0) (< var (array-length starts)))
            (begin
              (array-set! starts var (struct-get interval start))
              (array-set! ends var (struct-get interval end)))
            unit))
        (set! index (+ index 1))))))

(define (compiler-reg-color-mark-storage-vars
  [range-of-var : (Array i64)]
  [first : i64]
  [count : i64]
  [range-id : i64]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (if (and (>= (+ first i) 0) (< (+ first i) (array-length range-of-var)))
          (array-set! range-of-var (+ first i) range-id)
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-detect-storage-seq
  [instrs : CompilerIrInstrSeq]
  [range-of-var : (Array i64)]
  [range-base : (Array i64)]
  [range-size : (Array i64)]
  [range-count : i64]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    [run-first : i64 (- 0 1)]
    [run-last : i64 (- 0 1)]
    [run-count : i64 0]
    [ranges : i64 range-count]
    (begin
      (while (< i len)
        (begin
          (match (array-ref slots i)
            [(CompilerIrInstr.Alloc dst _)
              (if (or (= run-count 0) (= dst (+ run-last 1)))
                (begin
                  (if (= run-count 0)
                    (set! run-first dst)
                    unit)
                  (set! run-last dst)
                  (set! run-count (+ run-count 1)))
                (begin
                  (set! run-first dst)
                  (set! run-last dst)
                  (set! run-count 1)))]
            [(CompilerIrInstr.AddrOf _ src)
              (begin
                (if (and
                  (> run-count 0)
                  (= src run-last)
                  (= run-first (+ (- src run-count) 1))
                  (< ranges (array-length range-base)))
                  (begin
                    (array-set! range-base ranges src)
                    (array-set! range-size ranges run-count)
                    (compiler-reg-color-mark-storage-vars
                      range-of-var
                      run-first
                      run-count
                      ranges)
                    (set! ranges (+ ranges 1)))
                  unit)
                (set! run-first (- 0 1))
                (set! run-last (- 0 1))
                (set! run-count 0))]
            [_
              (begin
                (set! run-first (- 0 1))
                (set! run-last (- 0 1))
                (set! run-count 0))])
          (set! i (+ i 1))))
      ranges)))

(define (compiler-reg-color-detect-storage-blocks
  [blocks : CompilerIrBlockList]
  [range-of-var : (Array i64)]
  [range-base : (Array i64)]
  [range-size : (Array i64)]
  [range-count : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) range-count]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-detect-storage-blocks
            (box-get rest)
            range-of-var
            range-base
            range-size
            (compiler-reg-color-detect-storage-seq
              instrs
              range-of-var
              range-base
              range-size
              range-count))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 range-count]
        (begin
          (while (< i (compiler-ir-block-seq-count seq))
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    count
                    (compiler-reg-color-detect-storage-seq
                      instrs
                      range-of-var
                      range-base
                      range-size
                      count))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-color-value-root
  [roots : (Array i64)]
  [value : CompilerIrValue]) : i64
  (match value
    [(CompilerIrValue.Var var)
      (if (and (>= var 0) (< var (array-length roots)))
        (array-ref roots var)
        (- 0 1))]
    [_ (- 0 1)]))

(define (compiler-reg-color-merge-root [acc : i64] [root : i64]) : i64
  (cond
    [(< root 0) (- 0 1)]
    [(< acc 0) root]
    [(= acc root) root]
    [else (- 0 2)]))

(define (compiler-reg-color-phi-root
  [roots : (Array i64)]
  [inputs : CompilerIrPhiInputList]
  [acc : i64]) : i64
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) acc]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-phi-root
        roots
        (compiler-ir-phi-input-seq-to-list seq)
        acc)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (let
        [next : i64
          (compiler-reg-color-merge-root
            acc
            (compiler-reg-color-value-root roots value))]
        (if (= next (- 0 1))
          (- 0 1)
          (if (= next (- 0 2))
            (- 0 2)
            (compiler-reg-color-phi-root roots (box-get rest) next))))]))

(define (compiler-reg-color-set-root!
  [roots : (Array i64)]
  [invalid : (Array bool)]
  [dst : i64]
  [root : i64]) : bool
  (if (or (< root 0) (< dst 0) (>= dst (array-length roots)))
    false
    (let
      [old : i64 (array-ref roots dst)]
      (if (= old root)
        false
        (if (< old 0)
          (begin
            (array-set! roots dst root)
            true)
          (begin
            (if (< old (array-length invalid))
              (array-set! invalid old true)
              unit)
            (if (< root (array-length invalid))
              (array-set! invalid root true)
              unit)
            (array-set! roots dst (- 0 2))
            true))))))

(define (compiler-reg-color-propagate-root-instr
  [instr : CompilerIrInstr]
  [range-of-var : (Array i64)]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : bool
  (match instr
    [(CompilerIrInstr.AddrOf dst src)
      (if (and (>= src 0) (< src (array-length range-of-var)))
        (compiler-reg-color-set-root!
          roots
          invalid
          dst
          (array-ref range-of-var src))
        false)]
    [(CompilerIrInstr.Gep dst base _ _)
      (compiler-reg-color-set-root!
        roots
        invalid
        dst
        (compiler-reg-color-value-root roots base))]
    [(CompilerIrInstr.Mov dst value _)
      (compiler-reg-color-set-root!
        roots
        invalid
        dst
        (compiler-reg-color-value-root roots value))]
    [(CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-set-root!
        roots
        invalid
        dst
        (compiler-reg-color-phi-root roots inputs (- 0 1)))]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [true-value (struct-get (box-get payload-box) on-true)]
        [false-value (struct-get (box-get payload-box) on-false)]
        [left : i64 (compiler-reg-color-value-root roots true-value)]
        [right : i64 (compiler-reg-color-value-root roots false-value)]
        (if (>= right 0)
          (compiler-reg-color-set-root! roots invalid dst right)
          (if (and (>= left 0) (= left right))
            (compiler-reg-color-set-root! roots invalid dst left)
            false)))]
    [_ false]))

(define (compiler-reg-color-propagate-root-seq
  [instrs : CompilerIrInstrSeq]
  [range-of-var : (Array i64)]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    [changed : bool false]
    (begin
      (while (< i len)
        (begin
          (if (compiler-reg-color-propagate-root-instr
            (array-ref slots i)
            range-of-var
            roots
            invalid)
            (set! changed true)
            unit)
          (set! i (+ i 1))))
      changed)))

(define (compiler-reg-color-propagate-root-blocks
  [blocks : CompilerIrBlockList]
  [range-of-var : (Array i64)]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (let
            [head : bool
              (compiler-reg-color-propagate-root-seq
                instrs
                range-of-var
                roots
                invalid)]
            [tail : bool
              (compiler-reg-color-propagate-root-blocks
                (box-get rest)
                range-of-var
                roots
                invalid)]
            (or head tail))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [changed : bool false]
        (begin
          (while (< i (compiler-ir-block-seq-count seq))
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (if (compiler-reg-color-propagate-root-seq
                    instrs
                    range-of-var
                    roots
                    invalid)
                    (set! changed true)
                    unit)])
              (set! i (+ i 1))))
          changed))]))

(define (compiler-reg-color-propagate-roots
  [blocks : CompilerIrBlockList]
  [range-of-var : (Array i64)]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : unit
  (let
    [changed : bool true]
    [rounds : i64 0]
    [limit : i64 (array-length roots)]
    (while (and changed (< rounds limit))
      (begin
        (set!
          changed
          (compiler-reg-color-propagate-root-blocks
            blocks
            range-of-var
            roots
            invalid))
        (set! rounds (+ rounds 1))))))

(define (compiler-reg-color-invalidate-root!
  [invalid : (Array bool)]
  [root : i64]) : unit
  (if (and (>= root 0) (< root (array-length invalid)))
    (array-set! invalid root true)
    unit))

(define (compiler-reg-color-invalidate-value!
  [roots : (Array i64)]
  [invalid : (Array bool)]
  [value : CompilerIrValue]) : unit
  (compiler-reg-color-invalidate-root!
    invalid
    (compiler-reg-color-value-root roots value)))

(define (compiler-reg-color-invalidate-maybe-value!
  [roots : (Array i64)]
  [invalid : (Array bool)]
  [value : CompilerIrMaybeValue]) : unit
  (match value
    [(CompilerIrMaybeValue.No) unit]
    [(CompilerIrMaybeValue.Some inner)
      (compiler-reg-color-invalidate-value! roots invalid inner)]))

(define (compiler-reg-color-invalidate-call-args!
  [roots : (Array i64)]
  [invalid : (Array bool)]
  [args : CompilerIrCallArgs]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One a)
      (compiler-reg-color-invalidate-value! roots invalid a)]
    [(CompilerIrCallArgs.Two a b)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid a)
        (compiler-reg-color-invalidate-value! roots invalid b))]
    [(CompilerIrCallArgs.Array items)
      (let
        [i : i64 0]
        [len : i64 (array-length items)]
        (while (< i len)
          (begin
            (compiler-reg-color-invalidate-value!
              roots
              invalid
              (array-ref items i))
            (set! i (+ i 1)))))]))

(define (compiler-reg-color-invalidate-spmd-call-args!
  [roots : (Array i64)]
  [invalid : (Array bool)]
  [args : CompilerIrSpmdCallArgList]) : unit
  (match args
    [(CompilerIrSpmdCallArgList.Nil) unit]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (compiler-reg-color-invalidate-value! roots invalid value)
            (compiler-reg-color-invalidate-spmd-call-args!
              roots
              invalid
              (box-get rest)))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (while (< i count)
          (begin
            (match (array-ref slots i)
              [(CompilerIrSpmdCallArg.Arg _ value _)
                (compiler-reg-color-invalidate-value! roots invalid value)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-color-invalidate-phi!
  [roots : (Array i64)]
  [invalid : (Array bool)]
  [dst-root : i64]
  [inputs : CompilerIrPhiInputList]) : unit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-invalidate-phi!
        roots
        invalid
        dst-root
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (let
        [root : i64 (compiler-reg-color-value-root roots value)]
        (begin
          (if (and (>= root 0) (not (= root dst-root)))
            (compiler-reg-color-invalidate-root! invalid root)
            unit)
          (compiler-reg-color-invalidate-phi!
            roots
            invalid
            dst-root
            (box-get rest))))]))

(define (compiler-reg-color-invalidate-instr!
  [instr : CompilerIrInstr]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst value _)
      (let
        [root : i64 (compiler-reg-color-value-root roots value)]
        (if (and
          (>= root 0)
          (or
            (>= dst (array-length roots))
            (not (= (array-ref roots dst) root))))
          (compiler-reg-color-invalidate-root! invalid root)
          unit))]
    [(CompilerIrInstr.Gep dst base _ _)
      (let
        [root : i64 (compiler-reg-color-value-root roots base)]
        (if (and
          (>= root 0)
          (or
            (>= dst (array-length roots))
            (not (= (array-ref roots dst) root))))
          (compiler-reg-color-invalidate-root! invalid root)
          unit))]
    [(CompilerIrInstr.StorePtr dst src _)
      (compiler-reg-color-invalidate-value! roots invalid src)]
    [(CompilerIrInstr.BoundsCheck index length _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid index)
        (compiler-reg-color-invalidate-value! roots invalid length))]
    [(CompilerIrInstr.Cast _ src _ _)
      (compiler-reg-color-invalidate-value! roots invalid src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (compiler-reg-color-invalidate-value! roots invalid src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid lhs)
        (compiler-reg-color-invalidate-value! roots invalid rhs))]
    [(CompilerIrInstr.UnOp _ _ value _)
      (compiler-reg-color-invalidate-value! roots invalid value)]
    [(CompilerIrInstr.Splat _ value _ _)
      (compiler-reg-color-invalidate-value! roots invalid value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (struct-get (box-get payload-box) lhs)]
        [rhs (struct-get (box-get payload-box) rhs)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid lhs)
          (compiler-reg-color-invalidate-value! roots invalid rhs)))]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (struct-get (box-get payload-box) src)]
        [carry (struct-get (box-get payload-box) carry)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid src)
          (compiler-reg-color-invalidate-value! roots invalid carry)))]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-reg-color-invalidate-value! roots invalid src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (struct-get (box-get payload-box) lhs)]
        [rhs (struct-get (box-get payload-box) rhs)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid lhs)
          (compiler-reg-color-invalidate-value! roots invalid rhs)))]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid lhs)
        (compiler-reg-color-invalidate-value! roots invalid rhs))]
    [(CompilerIrInstr.MaskNot _ src _)
      (compiler-reg-color-invalidate-value! roots invalid src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-reg-color-invalidate-value! roots invalid src)]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [mask (struct-get (box-get payload-box) mask)]
        [true-value (struct-get (box-get payload-box) on-true)]
        [false-value (struct-get (box-get payload-box) on-false)]
        [left : i64 (compiler-reg-color-value-root roots true-value)]
        [right : i64 (compiler-reg-color-value-root roots false-value)]
        [dst-root : i64
          (if (and (>= dst 0) (< dst (array-length roots)))
            (array-ref roots dst)
            (- 0 1))]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid mask)
          (if (and (>= left 0) (not (= left dst-root)))
            (compiler-reg-color-invalidate-root! invalid left)
            unit)
          (if (and (>= right 0) (not (= right dst-root)))
            (compiler-reg-color-invalidate-root! invalid right)
            unit)))]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid base)
        (compiler-reg-color-invalidate-value! roots invalid index))]
    [(CompilerIrInstr.VectorStore payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [value (struct-get (box-get payload-box) value)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid base)
          (compiler-reg-color-invalidate-value! roots invalid index)
          (compiler-reg-color-invalidate-value! roots invalid value)))]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [value (struct-get (box-get payload-box) value)]
        [mask (struct-get (box-get payload-box) mask)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid base)
          (compiler-reg-color-invalidate-value! roots invalid index)
          (compiler-reg-color-invalidate-value! roots invalid value)
          (compiler-reg-color-invalidate-value! roots invalid mask)))]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [mask (struct-get (box-get payload-box) mask)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid base)
          (compiler-reg-color-invalidate-value! roots invalid index)
          (compiler-reg-color-invalidate-value! roots invalid mask)))]
    [(CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index-base (struct-get (box-get payload-box) index-base)]
        [index (struct-get (box-get payload-box) index)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid base)
          (compiler-reg-color-invalidate-value! roots invalid index-base)
          (compiler-reg-color-invalidate-value! roots invalid index)))]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (struct-get (box-get payload-box) source)]
        [selector-low (struct-get (box-get payload-box) selector-low)]
        [selector-high (struct-get (box-get payload-box) selector-high)]
        [active-lanes (struct-get (box-get payload-box) active-lanes)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid source)
          (compiler-reg-color-invalidate-value! roots invalid selector-low)
          (match selector-high
            [(CompilerIrMaybeValue.Some value)
              (compiler-reg-color-invalidate-value! roots invalid value)]
            [(CompilerIrMaybeValue.No) unit])
          (compiler-reg-color-invalidate-value! roots invalid active-lanes)))]
    [(CompilerIrInstr.TailMask _ index length _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid index)
        (compiler-reg-color-invalidate-value! roots invalid length))]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid leaf)
        (compiler-reg-color-invalidate-value! roots invalid subleaf))]
    [(CompilerIrInstr.Xgetbv _ index)
      (compiler-reg-color-invalidate-value! roots invalid index)]
    [(CompilerIrInstr.Syscall _ args)
      (compiler-reg-color-invalidate-call-args! roots invalid args)]
    [(CompilerIrInstr.Call _ name args _)
      (if (string.eq (compiler-ir-symbol-text name) "tl_memcpy")
        unit
        (compiler-reg-color-invalidate-call-args! roots invalid args))]
    [(CompilerIrInstr.CallIndirect _ callee args _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid callee)
        (compiler-reg-color-invalidate-call-args! roots invalid args))]
    [(CompilerIrInstr.CallIndirectC _ callee args _)
      (begin
        (compiler-reg-color-invalidate-value! roots invalid callee)
        (compiler-reg-color-invalidate-call-args! roots invalid args))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [args (struct-get (box-get payload-box) args)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid base)
          (compiler-reg-color-invalidate-call-args! roots invalid args)))]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [callee (struct-get (box-get payload-box) callee)]
        [args (struct-get (box-get payload-box) args)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid base)
          (compiler-reg-color-invalidate-value! roots invalid callee)
          (compiler-reg-color-invalidate-call-args! roots invalid args)))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask (struct-get (box-get payload-box) active-mask)]
        [args (struct-get (box-get payload-box) args)]
        (begin
          (compiler-reg-color-invalidate-value! roots invalid active-mask)
          (compiler-reg-color-invalidate-spmd-call-args! roots invalid args)))]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-reg-color-invalidate-call-args! roots invalid args)]
    [(CompilerIrInstr.Store _ value _)
      (compiler-reg-color-invalidate-value! roots invalid value)]
    [(CompilerIrInstr.Branch value _ _)
      (compiler-reg-color-invalidate-value! roots invalid value)]
    [(CompilerIrInstr.Return value)
      (compiler-reg-color-invalidate-maybe-value! roots invalid value)]
    [(CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-invalidate-phi!
        roots
        invalid
        (if (and (>= dst 0) (< dst (array-length roots)))
          (array-ref roots dst)
          (- 0 1))
        inputs)]
    [_ unit]))

(define (compiler-reg-color-invalidate-seq!
  [instrs : CompilerIrInstrSeq]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (while (< i len)
      (begin
        (compiler-reg-color-invalidate-instr! (array-ref slots i) roots invalid)
        (set! i (+ i 1))))))

(define (compiler-reg-color-invalidate-blocks!
  [blocks : CompilerIrBlockList]
  [roots : (Array i64)]
  [invalid : (Array bool)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-invalidate-seq! instrs roots invalid)])
        (compiler-reg-color-invalidate-blocks! (box-get rest) roots invalid))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (< i (compiler-ir-block-seq-count seq))
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-invalidate-seq! instrs roots invalid)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-color-range-liveness!
  [roots : (Array i64)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [range-starts : (Array i64)]
  [range-ends : (Array i64)]) : unit
  (let
    [i : i64 0]
    [_max-start : i64 9223372036854775807]
    (while (< i (array-length roots))
      (let
        [root : i64 (array-ref roots i)]
        (begin
          (if (and (>= root 0) (< root (array-length range-starts)))
            (let
              [start : i64 (array-ref starts i)]
              [end : i64 (array-ref ends i)]
              (if (>= start 0)
                (begin
                  (if (< start (array-ref range-starts root))
                    (array-set! range-starts root start)
                    unit)
                  (if (> end (array-ref range-ends root))
                    (array-set! range-ends root end)
                    unit))
                unit))
            unit)
          (set! i (+ i 1)))))))

(define (compiler-reg-color-range-free?
  [slot-ends : (Array i64)]
  [slot : i64]
  [size : i64]
  [start : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (if (> (+ slot size) (array-length slot-ends))
        (set! ok false)
        unit)
      (while (and ok (< i size))
        (begin
          (if (< (array-ref slot-ends (+ slot i)) start)
            unit
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

(define (compiler-reg-color-next-free-range
  [slot-ends : (Array i64)]
  [from : i64]
  [size : i64]
  [start : i64]) : i64
  (let
    [slot : i64 from]
    [done : bool false]
    (begin
      (while (not done)
        (if (compiler-reg-color-range-free? slot-ends slot size start)
          (set! done true)
          (set! slot (+ slot 1))))
      slot)))

(define (compiler-reg-color-set-range-ends!
  [slot-ends : (Array i64)]
  [slot : i64]
  [size : i64]
  [end : i64]) : unit
  (let
    [i : i64 0]
    (while (< i size)
      (begin
        (if (< (+ slot i) (array-length slot-ends))
          (array-set! slot-ends (+ slot i) end)
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-remap-storage-range!
  [remap : (Array i64)]
  [base : i64]
  [size : i64]
  [slot : i64]) : unit
  (let
    [first : i64 (+ (- base size) 1)]
    [i : i64 0]
    (while (< i size)
      (begin
        (if (and (>= (+ first i) 0) (< (+ first i) (array-length remap)))
          (array-set! remap (+ first i) (+ slot i))
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-range-clear?
  [remap : (Array i64)]
  [base : i64]
  [size : i64]) : bool
  (let
    [first : i64 (+ (- base size) 1)]
    [i : i64 0]
    [ok : bool true]
    (begin
      (while (and ok (< i size))
        (begin
          (if (and
            (>= (+ first i) 0)
            (< (+ first i) (array-length remap))
            (< (array-ref remap (+ first i)) 0))
            unit
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

(define (compiler-reg-color-storage-ranges
  [slot-ends : (Array i64)]
  [remap : (Array i64)]
  [range-base : (Array i64)]
  [range-size : (Array i64)]
  [range-starts : (Array i64)]
  [range-ends : (Array i64)]
  [invalid : (Array bool)]
  [range-count : i64]
  [from : i64]) : i64
  (let
    [range : i64 0]
    [used : i64 from]
    [max-start : i64 9223372036854775807]
    (begin
      (while (< range range-count)
        (let
          [start : i64 (array-ref range-starts range)]
          [end : i64 (array-ref range-ends range)]
          [size : i64 (array-ref range-size range)]
          [base : i64 (array-ref range-base range)]
          (begin
            (if (and
              (not (array-ref invalid range))
              (< start max-start)
              (>= end start)
              (> size 0)
              (compiler-reg-color-range-clear? remap base size))
              (let
                [slot : i64
                  (compiler-reg-color-next-free-range slot-ends from size start)]
                (begin
                  (compiler-reg-color-set-range-ends! slot-ends slot size end)
                  (compiler-reg-color-remap-storage-range! remap base size slot)
                  (if (> (+ slot size) used)
                    (set! used (+ slot size))
                    unit)))
              unit)
            (set! range (+ range 1)))))
      used)))

;; Color only contiguous inline-storage ranges. These slots are addressed only
;; through AddrOf/Gep-derived pointers, so ranges may share ids with each other
;; when their pointer lifetimes are disjoint. They deliberately start after the
;; scalar stack prefix to avoid giving a real scalar value and an aggregate
;; storage word the same global type-table key.
(define (compiler-reg-color-inline-storage
  [blocks : CompilerIrBlockList]
  [intervals : CompilerRegIntervalSeq]
  [slot-ends : (Array i64)]
  [remap : (Array i64)]
  [vars : i64]
  [from : i64]) : i64
  (let
    [range-of-var : (Array i64) (array.make-array i64 vars)]
    [range-base : (Array i64) (array.make-array i64 vars)]
    [range-size : (Array i64) (array.make-array i64 vars)]
    [range-starts : (Array i64) (array.make-array i64 vars)]
    [range-ends : (Array i64) (array.make-array i64 vars)]
    [invalid : (Array bool) (array.make-array bool vars)]
    [roots : (Array i64) (array.make-array i64 vars)]
    [starts : (Array i64) (array.make-array i64 vars)]
    [ends : (Array i64) (array.make-array i64 vars)]
    [max-start : i64 9223372036854775807]
    [_cleared : unit
      (let
        [i : i64 0]
        (while (< i vars)
          (begin
            (array-set! range-of-var i (- 0 1))
            (array-set! range-base i (- 0 1))
            (array-set! range-size i 0)
            (array-set! range-starts i max-start)
            (array-set! range-ends i (- 0 1))
            (array-set! invalid i false)
            (array-set! roots i (- 0 1))
            (array-set! starts i (- 0 1))
            (array-set! ends i (- 0 1))
            (set! i (+ i 1)))))]
    [range-count : i64
      (compiler-reg-color-detect-storage-blocks
        blocks
        range-of-var
        range-base
        range-size
        0)]
    (if (= range-count 0)
      from
      (begin
        (compiler-reg-color-fill-interval-bounds intervals starts ends)
        (compiler-reg-color-propagate-roots blocks range-of-var roots invalid)
        (compiler-reg-color-invalidate-blocks! blocks roots invalid)
        (compiler-reg-color-range-liveness!
          roots
          starts
          ends
          range-starts
          range-ends)
        (compiler-reg-color-storage-ranges
          slot-ends
          remap
          range-base
          range-size
          range-starts
          range-ends
          invalid
          range-count
          from)))))

;; Rebuild the var-type table on remapped keys. Type and assignment lookups
;; early-exit on the ascending-id list invariant, so remapping keys in place
;; would silently break every lookup past the first out-of-order entry
;; (observed: register homes lost to formula-slot fallbacks and i64 compares
;; emitted as cmpb once the width lookup missed). Scatter the entries into
;; new-id-indexed arrays and rebuild the list in id order instead. Storage-range
;; coloring may alias multiple old inline-storage vars onto the same new id, but
;; those ids are never used as scalar value keys; later entries may overwrite the
;; unused storage type without affecting emission.
(define (compiler-reg-color-scatter-types
  [remap : (Array i64)]
  [present : (Array i64)]
  [items : (Array AstType)]
  [types : CompilerRegVarTypeList]) : unit
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-color-scatter-types
        remap
        present
        items
        (compiler-reg-var-type-seq-to-list seq))]
    [(CompilerRegVarTypeList.Nil) unit]
    [(CompilerRegVarTypeList.Cons item rest)
      (begin
        (compiler-reg-var-type-array-set!
          present
          items
          (compiler-reg-remap-id remap (struct-get item var))
          (struct-get item ty))
        (compiler-reg-color-scatter-types remap present items (box-get rest)))]))

(define (compiler-reg-color-rebuild-types
  [remap : (Array i64)]
  [vars : i64]
  [types : CompilerRegVarTypeList]) : CompilerRegVarTypeList
  (let
    [present : (Array i64) (array.make-array i64 vars)]
    [items : (Array AstType) (array.make-array AstType vars)]
    (begin
      (compiler-reg-color-scatter-types remap present items types)
      (CompilerRegVarTypeList.Array (CompilerRegVarTypes present items)))))

;; Spilled scalars are dropped: the id remap re-homes them, so emission's
;; formula-slot fallback covers the new id and a stale Spill offset keyed by
;; the old id must never shadow it.
(define (compiler-reg-color-scatter-assignments
  [remap : (Array i64)]
  [present : (Array i64)]
  [items : (Array CompilerRegLocation)]
  [assignments : CompilerRegAssignmentList]) : unit
  (match assignments
    [(CompilerRegAssignmentList.Nil) unit]
    [(CompilerRegAssignmentList.Cons item rest)
      (begin
        (let
          [var : i64 (struct-get item var)]
          [location : CompilerRegLocation (struct-get item location)]
          (match location
            [(CompilerRegLocation.Spill _) unit]
            [_
              (let
                [new-id : i64 (compiler-reg-remap-id remap var)]
                (if (and (>= new-id 0) (< new-id (array-length present)))
                  (begin
                    (array-set! present new-id 1)
                    (array-set! items new-id location))
                  unit))]))
        (compiler-reg-color-scatter-assignments
          remap
          present
          items
          (box-get rest)))]))

(define (compiler-reg-assignment-arrays-to-list
  [present : (Array i64)]
  [items : (Array CompilerRegLocation)]
  [index : i64]
  [acc : CompilerRegAssignmentList]) : CompilerRegAssignmentList
  (if (< index 0)
    acc
    (compiler-reg-assignment-arrays-to-list
      present
      items
      (- index 1)
      (if (= (array-ref present index) 0)
        acc
        (compiler-reg-assignment-cons
          (CompilerRegAssignment index (array-ref items index))
          acc)))))

(define (compiler-reg-color-rebuild-assignments
  [remap : (Array i64)]
  [vars : i64]
  [assignments : CompilerRegAssignmentList]) : CompilerRegAssignmentList
  (let
    [present : (Array i64) (array.make-array i64 vars)]
    [items : (Array CompilerRegLocation)
      (array.make-array CompilerRegLocation vars)]
    (begin
      (compiler-reg-fill-location-array items (CompilerRegLocation.Spill 0))
      (compiler-reg-color-scatter-assignments remap present items assignments)
      (compiler-reg-assignment-arrays-to-list
        present
        items
        (- vars 1)
        CompilerRegAssignmentList.Nil))))

;; Identity-pin parameter variables: the prologue's param spill writes each
;; parameter to the formula slot of its ORIGINAL id (the ABI hand-off
;; contract), so params keep their ids and their slots are never shared.
(define (compiler-reg-color-param-pins
  [params : CompilerIrParamList]
  [remap : (Array i64)]
  [slot-ends : (Array i64)]
  [highest : i64]) : i64
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) highest]
    [(CompilerIrParamList.Array seq)
      (compiler-reg-color-param-pins
        (compiler-ir-param-seq-to-list seq)
        remap
        slot-ends
        highest)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ _ var-id)
          (begin
            (if (< var-id (array-length remap))
              (begin
                (array-set! remap var-id var-id)
                (array-set! slot-ends var-id 9223372036854775807))
              unit)
            (compiler-reg-color-param-pins
              (box-get rest)
              remap
              slot-ends
              (compiler-reg-max highest (+ var-id 1))))])]))

;; --- M-B: stack-homed register-group Mov coalescing -------------------------
;; A group-typed `IrInstrMov dst <- src` between two slot-resident group vars
;; round-trips both 8-byte words through the group-return register pair into a
;; SECOND slot pair (4 movs per enum/struct copy, e.g. every match-scrutinee
;; binding). When src's live range ends exactly where dst's begins -- at the
;; mov itself: src's last read is the copy that first defines dst -- the two
;; vars can share one slot pair. The coloring remap aliases dst's id onto
;; src's id, so the emitted IR carries ONE var (word0 + word1 formula slots
;; follow the id) and the mov becomes a same-home no-op the backend elides.
;;
;; Guards (all required):
;;   * dst != src, both group vars (fn-group-vars) of ast-type-eq? types --
;;     same word count and SSE word classes, and the rebuilt per-id type
;;     table entry stays exact for the merged id;
;;   * both slot-resident (CompilerRegNoLocation): never register/pair (their
;;     homes differ), never Spill (a spilled group uses the adjacent
;;     [offset, offset-8] layout, not the two-region formula slots), never
;;     Remat;
;;   * neither in `ineligible`: excludes AddrOf'd vars, whose intervals
;;     understate pointer-mediated reads, and group params, whose formula
;;     slots are the prologue's ABI hand-off contract;
;;   * neither already remapped (parameter identity pins, storage ranges);
;;   * hull(src).end == hull(dst).start, both hulls present. Interval points
;;     are unique per instruction (2 coords each), so this equality proves
;;     the same instruction carries src's LAST liveness event (a read; src is
;;     not in its live-after) and dst's FIRST (its def) -- and that
;;     instruction is this mov. Vars minted by the caller-save/loop-split/
;;     remat/splitkit rewrites have no plan interval and fail the hull check;
;;     those rewrites only insert reads where a value is genuinely live and
;;     only redefine register-homed values, so the plan hulls remain valid
;;     order witnesses for the NoLocation vars admitted here.
(define (compiler-reg-color-hull-bounds
  [intervals : CompilerRegIntervalSeq]
  [starts : (Array i64)]
  [ends : (Array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 (struct-get interval var)]
          [start : i64 (struct-get interval start)]
          [end : i64 (struct-get interval end)]
          (if (and (>= var 0) (< var (array-length starts)))
            (begin
              (if (or
                (< (array-ref starts var) 0)
                (< start (array-ref starts var)))
                (array-set! starts var start)
                unit)
              (if (> end (array-ref ends var))
                (array-set! ends var end)
                unit))
            unit))
        (set! index (+ index 1))))))

(define (compiler-reg-color-group-mov-alias-instr!
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [alias : (Array i64)]
  [group-vars : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentIndex]
  [var-tys : (Array AstType)]
  [remap : (Array i64)]
  [hull-starts : (Array i64)]
  [hull-ends : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var src-var)
          (if (and
            (>= dst 0)
            (< dst (array-length alias))
            (>= src-var 0)
            (< src-var (array-length alias))
            (not (= dst src-var))
            (compiler-live-set-contains? group-vars dst)
            (compiler-live-set-contains? group-vars src-var)
            (not (compiler-live-set-contains? ineligible dst))
            (not (compiler-live-set-contains? ineligible src-var))
            (< (array-ref remap dst) 0)
            (< (array-ref remap src-var) 0)
            (>= (array-ref hull-starts dst) 0)
            (>= (array-ref hull-starts src-var) 0)
            (= (array-ref hull-ends src-var) (array-ref hull-starts dst))
            (ast-type-eq-with-seg-bases?
              type-segment-bases
              (array-ref var-tys dst)
              (array-ref var-tys src-var))
            (match (compiler-reg-assignment-index-lookup assignment-index dst)
              [(CompilerRegMaybeLocation.Some _) false]
              [(CompilerRegMaybeLocation.No) true])
            (match (compiler-reg-assignment-index-lookup
              assignment-index
              src-var)
              [(CompilerRegMaybeLocation.Some _) false]
              [(CompilerRegMaybeLocation.No) true]))
            (array-set! alias dst src-var)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-color-group-mov-alias-seq!
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [alias : (Array i64)]
  [group-vars : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentIndex]
  [var-tys : (Array AstType)]
  [remap : (Array i64)]
  [hull-starts : (Array i64)]
  [hull-ends : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (while (< i len)
      (begin
        (compiler-reg-color-group-mov-alias-instr!
          type-segment-bases
          (array-ref slots i)
          alias
          group-vars
          ineligible
          assignment-index
          var-tys
          remap
          hull-starts
          hull-ends)
        (set! i (+ i 1))))))

(define (compiler-reg-color-group-mov-alias-blocks!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [alias : (Array i64)]
  [group-vars : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentIndex]
  [var-tys : (Array AstType)]
  [remap : (Array i64)]
  [hull-starts : (Array i64)]
  [hull-ends : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-group-mov-alias-seq!
              type-segment-bases
              instrs
              alias
              group-vars
              ineligible
              assignment-index
              var-tys
              remap
              hull-starts
              hull-ends)])
        (compiler-reg-color-group-mov-alias-blocks!
          type-segment-bases
          (box-get rest)
          alias
          group-vars
          ineligible
          assignment-index
          var-tys
          remap
          hull-starts
          hull-ends))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (< i (compiler-ir-block-seq-count seq))
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-group-mov-alias-seq!
                  type-segment-bases
                  instrs
                  alias
                  group-vars
                  ineligible
                  assignment-index
                  var-tys
                  remap
                  hull-starts
                  hull-ends)])
            (set! i (+ i 1)))))]))

;; Follow an alias chain (C=B after B=A) to its root. Chains are acyclic by
;; construction -- each link strictly advances the hull touch point -- but a
;; step cap keeps this total on any malformed input.
(define (compiler-reg-color-group-alias-root [alias : (Array i64)] [var : i64]) : i64
  (let
    [root : i64 var]
    [steps : i64 0]
    (begin
      (while (and
        (< steps 64)
        (>= root 0)
        (< root (array-length alias))
        (>= (array-ref alias root) 0))
        (begin
          (set! root (array-ref alias root))
          (set! steps (+ steps 1))))
      root)))

;; --- M-B2: stack-homed SCALAR phi/mov web slot sharing ----------------------
;; A spilled phi web costs a slot-to-slot copy on every incoming edge: the phi's
;; input is written to ITS slot and then copied into the phi's slot (four
;; instructions once the backend has to scavenge a scratch register through
;; push/pop). When the members never hold a live value at the same time ONE slot
;; serves the whole web and every one of those copies disappears: the coloring
;; remap merges their ids, so `compiler-backend-vars-same-home?` (same var id =>
;; same home) makes the backend's leading-phi-copy builder drop the copy before
;; emission, and a Mov between merged ids is a same-home no-op.
;;
;; INTERFERENCE MODEL. The plan's intervals are the CONSERVATIVE hulls, which
;; treat a phi as USING every input AT THE PHI BLOCK; that leaks a loop carry
;; backward around its own loop, so the carry's hull overlaps its phi's hull from
;; function entry onward and the pairs worth merging all look live at once.
;; Legality is therefore judged on EDGE-PRECISE hulls (LLVM PHIElimination
;; semantics: an input is a copy at the end of ITS OWN predecessor), the exact
;; SSA interference model the register coalescer already trusts, recomputed here
;; over the FINAL rewritten blocks so its point coordinates describe the IR the
;; backend actually emits. The plan's conservative hulls keep their existing job
;; unchanged -- deciding which OTHER variable may reuse a slot -- through the
;; ordinary disjoint-interval walk, which now sees the whole web as one variable
;; and therefore reserves the UNION of the members' conservative hulls.
;;
;; WEB RULE (conservative; when in doubt, no alias). A variable joins a web only
;; when its EP hull starts STRICTLY after the latest EP hull end already in that
;; web (`web-end`). Every pair of members is then provably never live at once,
;; and joins strictly advance the hull position, so the alias graph is acyclic.
;; The single exception is a Mov witness: `hull(src).end == hull(dst).start` is
;; admitted when the web's latest end IS src's -- exactly the group-Mov rule
;; above. Interval points are unique per instruction (2 coords each), so that
;; equality proves this mov carries src's LAST liveness event and dst's FIRST. A
;; touch WITHOUT a Mov witness is rejected: the backend may write a destination
;; home before reading a source home, and phi parallel copies at a block edge
;; read inputs and write destinations at the same interval position -- the same
;; hazard that makes compiler-reg-color-find-slot demand a STRICT `<`.
;;
;; MEMBERSHIP GUARDS mirror the scalar walk's own admission rules, so a merged
;; web colors exactly as one of its members would have: colorable scalars of one
;; stack word, never group vars (their formula slots are the prologue's ABI
;; hand-off contract), never `ineligible` (AddrOf'd vars, whose intervals
;; understate pointer-mediated reads), never already remapped (parameter
;; identity pins), never register-homed (their homes are not slots),
;; ast-type-identical (the rebuilt per-id type table keeps ONE type for the
;; merged id, and the backend recovers operand width from it), and a plan
;; interval must exist -- vars minted by the caller-save/loop-split/remat
;; rewrites have none and the walk never colors them.
(define (compiler-reg-color-ep-hull-seq!
  [instrs : CompilerIrInstrSeq]
  [live-afters : CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [after-items : (Array CompilerLiveI64Set) (struct-get live-afters items)]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [instr : CompilerIrInstr (array-ref slots index)]
          [live-after : CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (compiler-live-set-empty))]
          (begin
            (compiler-reg-extend-set-words
              starts
              ends
              (compiler-live-instr-defs instr)
              0
              out-point)
            (compiler-reg-extend-set-words
              starts
              ends
              (compiler-live-instr-uses-nophi instr)
              0
              out-point)
            (compiler-reg-extend-set-words
              starts
              ends
              live-after
              0
              (+ out-point 1))
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-color-ep-hull-blocks!
  [blocks : CompilerIrBlockList]
  [liveness : CompilerFunctionLiveness]
  [point : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) point]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (compiler-reg-color-ep-hull-blocks!
            (box-get rest)
            liveness
            (compiler-reg-color-ep-hull-seq!
              instrs
              (compiler-reg-live-intervals-find-afters liveness label)
              point
              starts
              ends)
            starts
            ends)])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block label instrs)
                  (set!
                    out-point
                    (compiler-reg-color-ep-hull-seq!
                      instrs
                      (compiler-reg-live-intervals-find-afters liveness label)
                      out-point
                      starts
                      ends))])
              (set! i (+ i 1))))
          out-point))]))

;; One membership decision per variable, taken once so the per-pair test below
;; is three array reads. Same predicate the scalar walk applies to an interval.
(define (compiler-reg-color-scalar-alias-eligible!
  [eligible : (Array bool)]
  [vars : i64]
  [group-vars : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentIndex]
  [colorable : (Array bool)]
  [remap : (Array i64)]
  [hull-starts : (Array i64)]
  [vector-stack-words : (Array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (array-set!
          eligible
          i
          (and
            (array-ref colorable i)
            (not (compiler-live-set-contains? group-vars i))
            (not (compiler-live-set-contains? ineligible i))
            (< (array-ref remap i) 0)
            (>= (array-ref hull-starts i) 0)
            (= (compiler-reg-vector-stack-words-for-var vector-stack-words i) 1)
            (match (compiler-reg-assignment-index-lookup assignment-index i)
              [(CompilerRegMaybeLocation.Some location)
                (match location
                  [(CompilerRegLocation.Spill _) true]
                  [_ false])]
              [(CompilerRegMaybeLocation.No) true])))
        (set! i (+ i 1))))))

;; Join `later` to the web that owns `earlier`, when the web's latest EP hull end
;; is strictly before `later`'s EP hull start (or exactly at it for a Mov
;; witness, see the header). `later` must be a virgin variable -- neither already
;; a member nor already a web root -- so every member has exactly one home and
;; the alias graph stays a forest of depth one.
(define (compiler-reg-color-scalar-alias-link!
  [type-segment-bases : i64]
  [alias : (Array i64)]
  [web-root : (Array bool)]
  [web-end : (Array i64)]
  [eligible : (Array bool)]
  [var-tys : (Array AstType)]
  [ep-starts : (Array i64)]
  [ep-ends : (Array i64)]
  [earlier : i64]
  [later : i64]
  [mov-witness : bool]) : unit
  (if (and
    (>= earlier 0)
    (< earlier (array-length alias))
    (>= later 0)
    (< later (array-length alias))
    (not (= earlier later))
    (array-ref eligible earlier)
    (array-ref eligible later)
    (>= (array-ref ep-starts earlier) 0)
    (>= (array-ref ep-starts later) 0)
    (< (array-ref alias later) 0)
    (not (array-ref web-root later)))
    (let
      [root : i64 (compiler-reg-color-group-alias-root alias earlier)]
      (if (and
        (not (= root later))
        (>= root 0)
        (< root (array-length alias))
        (array-ref eligible root)
        (>= (array-ref web-end root) 0)
        (if (< (array-ref web-end root) (array-ref ep-starts later))
          true
          (and
            mov-witness
            (= (array-ref web-end root) (array-ref ep-ends earlier))
            (= (array-ref ep-ends earlier) (array-ref ep-starts later))))
        (ast-type-eq-with-seg-bases?
          type-segment-bases
          (array-ref var-tys root)
          (array-ref var-tys later)))
        (begin
          (array-set! alias later root)
          (array-set! web-root root true)
          (array-set!
            web-end
            root
            (compiler-reg-max
              (array-ref web-end root)
              (array-ref ep-ends later)))
          unit)
        unit))
    unit))

;; A phi pair has no Mov witness, so both orderings are offered and the strictly
;; earlier hull (if any) wins; equal starts are impossible for distinct defs and
;; are rejected by both attempts.
(define (compiler-reg-color-scalar-alias-phi-inputs!
  [type-segment-bases : i64]
  [alias : (Array i64)]
  [web-root : (Array bool)]
  [web-end : (Array i64)]
  [eligible : (Array bool)]
  [var-tys : (Array AstType)]
  [ep-starts : (Array i64)]
  [ep-ends : (Array i64)]
  [dst : i64]
  [inputs : CompilerIrPhiInputList]) : unit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-scalar-alias-phi-inputs!
        type-segment-bases
        alias
        web-root
        web-end
        eligible
        var-tys
        ep-starts
        ep-ends
        dst
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (match value
          [(CompilerIrValue.Var src)
            (begin
              (compiler-reg-color-scalar-alias-link!
                type-segment-bases
                alias
                web-root
                web-end
                eligible
                var-tys
                ep-starts
                ep-ends
                src
                dst
                false)
              (compiler-reg-color-scalar-alias-link!
                type-segment-bases
                alias
                web-root
                web-end
                eligible
                var-tys
                ep-starts
                ep-ends
                dst
                src
                false))]
          [_ unit])
        (compiler-reg-color-scalar-alias-phi-inputs!
          type-segment-bases
          alias
          web-root
          web-end
          eligible
          var-tys
          ep-starts
          ep-ends
          dst
          (box-get rest)))]))

(define (compiler-reg-color-scalar-alias-instr!
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [alias : (Array i64)]
  [web-root : (Array bool)]
  [web-end : (Array i64)]
  [eligible : (Array bool)]
  [var-tys : (Array AstType)]
  [ep-starts : (Array i64)]
  [ep-ends : (Array i64)]) : unit
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var src-var)
          (compiler-reg-color-scalar-alias-link!
            type-segment-bases
            alias
            web-root
            web-end
            eligible
            var-tys
            ep-starts
            ep-ends
            src-var
            dst
            true)]
        [_ unit])]
    [(CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-scalar-alias-phi-inputs!
        type-segment-bases
        alias
        web-root
        web-end
        eligible
        var-tys
        ep-starts
        ep-ends
        dst
        inputs)]
    [_ unit]))

(define (compiler-reg-color-scalar-alias-seq!
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [alias : (Array i64)]
  [web-root : (Array bool)]
  [web-end : (Array i64)]
  [eligible : (Array bool)]
  [var-tys : (Array AstType)]
  [ep-starts : (Array i64)]
  [ep-ends : (Array i64)]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (while (< i len)
      (begin
        (compiler-reg-color-scalar-alias-instr!
          type-segment-bases
          (array-ref slots i)
          alias
          web-root
          web-end
          eligible
          var-tys
          ep-starts
          ep-ends)
        (set! i (+ i 1))))))

(define (compiler-reg-color-scalar-alias-blocks!
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [alias : (Array i64)]
  [web-root : (Array bool)]
  [web-end : (Array i64)]
  [eligible : (Array bool)]
  [var-tys : (Array AstType)]
  [ep-starts : (Array i64)]
  [ep-ends : (Array i64)]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-scalar-alias-seq!
              type-segment-bases
              instrs
              alias
              web-root
              web-end
              eligible
              var-tys
              ep-starts
              ep-ends)])
        (compiler-reg-color-scalar-alias-blocks!
          type-segment-bases
          (box-get rest)
          alias
          web-root
          web-end
          eligible
          var-tys
          ep-starts
          ep-ends))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (< i (compiler-ir-block-seq-count seq))
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-scalar-alias-seq!
                  type-segment-bases
                  instrs
                  alias
                  web-root
                  web-end
                  eligible
                  var-tys
                  ep-starts
                  ep-ends)])
            (set! i (+ i 1)))))]))

;; Cheap gate: does any Mov or Phi in the function relate two members-in-waiting?
;; A function with no candidate pair never pays for the edge-precise liveness
;; fixpoint below, which is the only non-trivial cost this pass adds.
(define (compiler-reg-color-scalar-alias-candidate-inputs?
  [eligible : (Array bool)]
  [dst : i64]
  [inputs : CompilerIrPhiInputList]) : bool
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) false]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-scalar-alias-candidate-inputs?
        eligible
        dst
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (if (match value
        [(CompilerIrValue.Var src)
          (and
            (not (= src dst))
            (>= src 0)
            (< src (array-length eligible))
            (array-ref eligible src))]
        [_ false])
        true
        (compiler-reg-color-scalar-alias-candidate-inputs?
          eligible
          dst
          (box-get rest)))]))

(define (compiler-reg-color-scalar-alias-candidate-instr?
  [instr : CompilerIrInstr]
  [eligible : (Array bool)]) : bool
  (match instr
    [(CompilerIrInstr.Mov dst src _)
      (and
        (>= dst 0)
        (< dst (array-length eligible))
        (array-ref eligible dst)
        (match src
          [(CompilerIrValue.Var src-var)
            (and
              (not (= src-var dst))
              (>= src-var 0)
              (< src-var (array-length eligible))
              (array-ref eligible src-var))]
          [_ false]))]
    [(CompilerIrInstr.Phi dst inputs _)
      (and
        (>= dst 0)
        (< dst (array-length eligible))
        (array-ref eligible dst)
        (compiler-reg-color-scalar-alias-candidate-inputs? eligible dst inputs))]
    [_ false]))

(define (compiler-reg-color-scalar-alias-candidate-seq?
  [instrs : CompilerIrInstrSeq]
  [eligible : (Array bool)]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    [found : bool false]
    (begin
      (while (and (< i len) (not found))
        (begin
          (if (compiler-reg-color-scalar-alias-candidate-instr?
            (array-ref slots i)
            eligible)
            (set! found true)
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-color-scalar-alias-candidate-blocks?
  [blocks : CompilerIrBlockList]
  [eligible : (Array bool)]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (if (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-scalar-alias-candidate-seq? instrs eligible)])
        true
        (compiler-reg-color-scalar-alias-candidate-blocks?
          (box-get rest)
          eligible))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [found : bool false]
        (begin
          (while (and (< i count) (not found))
            (begin
              (if (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (compiler-reg-color-scalar-alias-candidate-seq?
                    instrs
                    eligible)])
                (set! found true)
                unit)
              (set! i (+ i 1))))
          found))]))

(define (compiler-reg-color-scalar-alias
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [group-vars : CompilerLiveI64Set]
  [ineligible : CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentIndex]
  [colorable : (Array bool)]
  [var-tys : (Array AstType)]
  [remap : (Array i64)]
  [hull-starts : (Array i64)]
  [vector-stack-words : (Array i64)]) : (Array i64)
  (let
    [alias : (Array i64) (array.make-array i64 vars)]
    [eligible : (Array bool) (array.make-array bool vars)]
    [_cleared : unit (compiler-reg-fill-i64-array alias (- 0 1))]
    [_eligible : unit
      (compiler-reg-color-scalar-alias-eligible!
        eligible
        vars
        group-vars
        ineligible
        assignment-index
        colorable
        remap
        hull-starts
        vector-stack-words)]
    (begin
      (if (compiler-reg-color-scalar-alias-candidate-blocks? blocks eligible)
        (let
          [ep-starts : (Array i64) (array.make-array i64 vars)]
          [ep-ends : (Array i64) (array.make-array i64 vars)]
          [web-end : (Array i64) (array.make-array i64 vars)]
          [web-root : (Array bool) (array.make-array bool vars)]
          [liveness : CompilerFunctionLiveness
            (compiler-live-analyze-blocks-edge-precise blocks)]
          (begin
            (compiler-reg-fill-i64-array ep-starts (- 0 1))
            (compiler-reg-fill-i64-array ep-ends (- 0 1))
            (compiler-reg-color-ep-hull-blocks!
              blocks
              liveness
              0
              ep-starts
              ep-ends)
            (let
              [i : i64 0]
              (while (< i vars)
                (begin
                  (array-set! web-end i (array-ref ep-ends i))
                  (array-set! web-root i false)
                  (set! i (+ i 1)))))
            (compiler-reg-color-scalar-alias-blocks!
              type-segment-bases
              blocks
              alias
              web-root
              web-end
              eligible
              var-tys
              ep-starts
              ep-ends)))
        unit)
      alias)))

;; Retarget every interval of an aliased member onto its web root, so the scalar
;; walk colors the web ONCE against the union of the members' conservative hulls
;; (compiler-reg-color-extent-ends then reports that union as the root's extent).
;; Starts are untouched, so the array stays sorted by start and the walk's greedy
;; order is unchanged.
(define (compiler-reg-color-alias-rewrite-intervals!
  [items : (Array CompilerRegInterval)]
  [alias : (Array i64)]) : unit
  (let
    [count : i64 (array-length items)]
    [i : i64 0]
    (while (< i count)
      (begin
        (let
          [interval : CompilerRegInterval (array-ref items i)]
          [var : i64 (struct-get interval var)]
          [root : i64 (compiler-reg-color-group-alias-root alias var)]
          (if (= root var)
            unit
            (begin
              (array-set!
                items
                i
                (CompilerRegInterval
                  root
                  (struct-get interval start)
                  (struct-get interval end)))
              unit)))
        (set! i (+ i 1))))))

;; Members took no slot of their own during the walk; hand each one its web
;; root's slot. A member the storage pass already claimed keeps that home, so no
;; earlier decision is overwritten.
(define (compiler-reg-color-alias-propagate-remap!
  [remap : (Array i64)]
  [alias : (Array i64)]
  [vars : i64]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (if (< (array-ref remap i) 0)
          (let
            [root : i64 (compiler-reg-color-group-alias-root alias i)]
            (if (and (not (= root i)) (>= (array-ref remap root) 0))
              (array-set! remap i (array-ref remap root))
              unit))
          unit)
        (set! i (+ i 1))))))

;; Total frame renumbering: colorable stack scalars share slots when their
;; intervals are disjoint, colorable inline-storage ranges are shared above
;; that scalar prefix, every remaining slot-resident variable gets a private
;; dense slot above them, and register-homed variables move to ids that are not
;; used by a stack slot. The assignment table is rebuilt on the new keys.
(define (compiler-reg-color-stack-slots
  [type-segment-bases : i64]
  [plan : CompilerRegPlan]
  [group-vars : CompilerLiveI64Set]
  [params : CompilerIrParamList]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [slot-candidate-vars : i64]) : CompilerRegColoring
  (let
    [intervals : CompilerRegIntervalSeq (compiler-reg-plan-intervals plan)]
    (if (compiler-reg-interval-seq-empty? intervals)
      CompilerRegColoring.None
      (let
        [vector-stack-words : (Array i64) (array.make-array i64 vars)]
        [_vector-stack-words : unit
          (compiler-reg-vector-stack-words-blocks! blocks vector-stack-words)]
        [slots : i64
          (+
            (+
              vars
              (compiler-reg-vector-stack-extra-slots vector-stack-words 0 0))
            8)]
        [slot-ends : (Array i64) (array.make-array i64 slots)]
        [assignments : CompilerRegAssignmentList
          (compiler-reg-plan-assignments plan)]
        [assignment-index : CompilerRegAssignmentIndex
          (compiler-reg-assignment-index-build assignments vars)]
        [ineligible : CompilerLiveI64Set (compiler-reg-plan-ineligible plan)]
        [colorable : (Array bool) (array.make-array bool vars)]
        [references : (Array i64) (array.make-array i64 vars)]
        [remap : (Array i64) (array.make-array i64 vars)]
        [_cleared : unit
          (let
            [i : i64 0]
            (begin
              (while (< i slots)
                (begin
                  (array-set! slot-ends i (- 0 1))
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (array-set! colorable i false)
                  (array-set! remap i (- 0 1))
                  (set! i (+ i 1))))))]
        [_flagged : unit
          (begin
            (compiler-reg-color-flags (compiler-reg-plan-types plan) colorable)
            ;; Scratch pseudo-vars are consumed through planned registers or
            ;; the legacy scavenger, never through formula stack slots.
            (let
              [i : i64 slot-candidate-vars]
              (while (< i vars)
                (begin
                  (array-set! colorable i false)
                  (set! i (+ i 1))))))]
        ;; Count direct IR uses and defs, not type-table membership: dead defs
        ;; still emit a write, while raw-id holes and register-only scratch
        ;; pseudo-vars have no instruction reference and need no formula slot.
        [_referenced : unit
          (begin
            (compiler-reg-color-reference-intervals! intervals references)
            (compiler-reg-ref-counts-blocks! references blocks))]
        [var-tys : (Array AstType) (array.make-array AstType vars)]
        [slot-tys : (Array AstType) (array.make-array AstType slots)]
        [_typed : unit
          (compiler-reg-color-var-tys (compiler-reg-plan-types plan) var-tys)]
        [param-floor : i64
          (compiler-reg-color-param-pins params remap slot-ends 0)]
        ;; Conservative per-var hulls of the plan intervals, shared by the
        ;; scalar-web membership gate below and the group-Mov overlay further
        ;; down (both only ever read them).
        [hull-starts : (Array i64) (array.make-array i64 vars)]
        [hull-ends : (Array i64) (array.make-array i64 vars)]
        [_hull-bounds : unit
          (begin
            (compiler-reg-fill-i64-array hull-starts (- 0 1))
            (compiler-reg-fill-i64-array hull-ends (- 0 1))
            (compiler-reg-color-hull-bounds intervals hull-starts hull-ends))]
        ;; M-B2: member -> web-root links for scalar phi/mov webs whose
        ;; edge-precise hulls never overlap (see the header above). Applied by
        ;; retargeting the members' intervals onto the root before the walk,
        ;; and by handing each member the root's slot after it.
        [scalar-alias : (Array i64)
          (compiler-reg-color-scalar-alias
            type-segment-bases
            blocks
            vars
            group-vars
            ineligible
            assignment-index
            colorable
            var-tys
            remap
            hull-starts
            vector-stack-words)]
        [sorted : (Array CompilerRegInterval)
          (compiler-reg-color-sorted-array intervals)]
        [_alias-intervals : unit
          (compiler-reg-color-alias-rewrite-intervals! sorted scalar-alias)]
        [extent-ends : (Array i64) (compiler-reg-color-extent-ends sorted vars)]
        [stack-prefix : i64
          (compiler-reg-color-walk
            type-segment-bases
            sorted
            (array-length sorted)
            0
            assignment-index
            group-vars
            ineligible
            colorable
            var-tys
            slot-ends
            slot-tys
            extent-ends
            0
            remap)]
        [storage-prefix : i64
          (compiler-reg-color-inline-storage
            blocks
            intervals
            slot-ends
            remap
            vars
            stack-prefix)]
        [_alias-remap : unit
          (compiler-reg-color-alias-propagate-remap! remap scalar-alias vars)]
        [group-alias
          : (Array i64)
          ;; M-B: dst -> src alias links for coalescable group-typed Movs
          ;; (see compiler-reg-color-group-mov-alias-instr!). Applied in the
          ;; private-slot loop below: an aliased dst shares its root's slot
          ;; pair instead of taking a fresh one.
          (let
            [alias : (Array i64) (array.make-array i64 vars)]
            (begin
              (compiler-reg-fill-i64-array alias (- 0 1))
              (compiler-reg-color-group-mov-alias-blocks!
                type-segment-bases
                blocks
                alias
                group-vars
                ineligible
                assignment-index
                var-tys
                remap
                hull-starts
                hull-ends)
              alias))]
        [slot-count
          : i64
          ;; Private dense slots for final, real IR variables that the scalar
          ;; and inline-storage walks skipped, one slot each. Raw-id holes and
          ;; register-only scratch pseudo-vars have no frame demand. Group-
          ;; mov-aliased dsts share their root's slot pair (word1 formula
          ;; slots follow the id).
          (let
            [next : i64 storage-prefix]
            [i : i64 0]
            (begin
              (while (and (< i vars) (< i slot-candidate-vars))
                (begin
                  (if (or
                    (= (array-ref references i) 0)
                    (>= (array-ref remap i) 0))
                    unit
                    (let
                      [root : i64
                        (compiler-reg-color-group-alias-root group-alias i)]
                      (if (not (= root i))
                        (begin
                          (if (< (array-ref remap root) 0)
                            (let
                              [words : i64
                                (compiler-reg-vector-stack-words-for-var
                                  vector-stack-words
                                  root)]
                              [slot : i64
                                (compiler-reg-color-reserve-private-range!
                                  slot-ends
                                  next
                                  words)]
                              (begin
                                (array-set! remap root (+ slot (- words 1)))
                                (set! next (+ slot words))))
                            unit)
                          (array-set! remap i (array-ref remap root)))
                        (match (compiler-reg-assignment-index-lookup
                          assignment-index
                          i)
                          [(CompilerRegMaybeLocation.Some location)
                            (match location
                              [(CompilerRegLocation.Spill _)
                                (let
                                  [words : i64
                                    (compiler-reg-vector-stack-words-for-var
                                      vector-stack-words
                                      i)]
                                  [slot : i64
                                    (compiler-reg-color-reserve-private-range!
                                      slot-ends
                                      next
                                      words)]
                                  (begin
                                    (array-set! remap i (+ slot (- words 1)))
                                    (set! next (+ slot words))))]
                              [_ unit])]
                          [(CompilerRegMaybeLocation.No)
                            (let
                              [words : i64
                                (compiler-reg-vector-stack-words-for-var
                                  vector-stack-words
                                  i)]
                              [slot : i64
                                (compiler-reg-color-reserve-private-range!
                                  slot-ends
                                  next
                                  words)]
                              (begin
                                (array-set! remap i (+ slot (- words 1)))
                                (set! next (+ slot words))))]))))
                  (set! i (+ i 1))))
              ;; Scratch pseudo-vars live above the real-IR watermark and are
              ;; register-only. Preserve those already-disjoint ids instead
              ;; of letting the generic free-id pass alias them onto a frame
              ;; slot that belongs to a real value.
              (while (< i vars)
                (begin
                  (if (< (array-ref remap i) 0)
                    (array-set! remap i i)
                    unit)
                  (set! i (+ i 1))))
              next))]
        [_renumbered
          : unit
          ;; Register-homed and unmentioned variables take the remaining FREE
          ;; ids of [0, vars), in var order (deterministic). Filling gaps
          ;; keeps the renumbering a bijection into [0, vars): an id at or
          ;; past vars would be silently dropped by the raw-var-sized rebuild
          ;; arrays and side tables. A register-homed variable never touches
          ;; its formula slot, so a free id below the watermark is safe.
          (let
            [taken : (Array bool) (array.make-array bool vars)]
            [i : i64 0]
            [free : i64 0]
            (begin
              (while (< i vars)
                (begin
                  (array-set! taken i false)
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (if (and
                    (>= (array-ref remap i) 0)
                    (< (array-ref remap i) vars))
                    (array-set! taken (array-ref remap i) true)
                    unit)
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (if (< (array-ref remap i) 0)
                    (begin
                      (while (if (< free vars)
                        (array-ref taken free)
                        false)
                        (set! free (+ free 1)))
                      (array-set! remap i free)
                      (set! free (+ free 1)))
                    unit)
                  (set! i (+ i 1))))))]
        (CompilerRegColoring.Remap
          remap
          (compiler-reg-max slot-count param-floor))))))

;; --- var-id remap application ----------------------------------------------
;; The backend computes stack slots from variable ids at many emission sites,
;; so compaction is applied by rewriting var ids in the IR: each stack-resident
;; variable id becomes its dense slot id and the formula slot follows. Pinned
;; params and register-homed variables keep or receive non-slot ids, so the
;; rebuilt assignment table and formula slots stay valid.
(define (compiler-reg-remap-id [remap : (Array i64)] [id : i64]) : i64
  (if (and (>= id 0) (< id (array-length remap)))
    (array-ref remap id)
    id))

(define (compiler-reg-remap-value
  [remap : (Array i64)]
  [value : CompilerIrValue]) : CompilerIrValue
  (match value
    [(CompilerIrValue.Var id)
      (CompilerIrValue.Var (compiler-reg-remap-id remap id))]
    [_ value]))

(define (compiler-reg-remap-value-list
  [remap : (Array i64)]
  [values : CompilerIrValueList]) : CompilerIrValueList
  (match (compiler-ir-value-list-force-cons values)
    [(CompilerIrValueList.Nil) CompilerIrValueList.Nil]
    [(CompilerIrValueList.Array seq)
      (compiler-reg-remap-value-list remap (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons head rest)
      (compiler-ir-value-cons
        (compiler-reg-remap-value remap head)
        (compiler-reg-remap-value-list remap (box-get rest)))]))

(define (compiler-reg-remap-call-args
  [remap : (Array i64)]
  [args : CompilerIrCallArgs]) : CompilerIrCallArgs
  (match args
    [(CompilerIrCallArgs.Nil) CompilerIrCallArgs.Nil]
    [(CompilerIrCallArgs.One a)
      (CompilerIrCallArgs.One (compiler-reg-remap-value remap a))]
    [(CompilerIrCallArgs.Two a b)
      (CompilerIrCallArgs.Two
        (compiler-reg-remap-value remap a)
        (compiler-reg-remap-value remap b))]
    [(CompilerIrCallArgs.Array items)
      (let
        [count : i64 (array-length items)]
        [out : (Array CompilerIrValue) (array.make-array CompilerIrValue count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (array-set!
                out
                i
                (compiler-reg-remap-value remap (array-ref items i)))
              (set! i (+ i 1))))
          (CompilerIrCallArgs.Array out)))]))

(define (compiler-reg-remap-spmd-call-arg
  [remap : (Array i64)]
  [arg : CompilerIrSpmdCallArg]) : CompilerIrSpmdCallArg
  (match arg
    [(CompilerIrSpmdCallArg.Arg class value ty)
      (CompilerIrSpmdCallArg.Arg
        class
        (compiler-reg-remap-value remap value)
        ty)]))

(define (compiler-reg-remap-spmd-call-args
  [remap : (Array i64)]
  [args : CompilerIrSpmdCallArgList]) : CompilerIrSpmdCallArgList
  (match args
    [(CompilerIrSpmdCallArgList.Nil) CompilerIrSpmdCallArgList.Nil]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (CompilerIrSpmdCallArgList.Cons
        (compiler-reg-remap-spmd-call-arg remap arg)
        (box (compiler-reg-remap-spmd-call-args remap (box-get rest))))]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        [out : (Array CompilerIrSpmdCallArg)
          (array.make-array CompilerIrSpmdCallArg count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (array-set!
                out
                i
                (compiler-reg-remap-spmd-call-arg remap (array-ref slots i)))
              (set! i (+ i 1))))
          (CompilerIrSpmdCallArgList.Array (CompilerIrSpmdCallArgSeq out count))))]))

(define (compiler-reg-remap-spmd-call-result
  [remap : (Array i64)]
  [result : CompilerIrSpmdCallResult]) : CompilerIrSpmdCallResult
  (match result
    [(CompilerIrSpmdCallResult.Unit) CompilerIrSpmdCallResult.Unit]
    [(CompilerIrSpmdCallResult.Value dst class ty)
      (CompilerIrSpmdCallResult.Value
        (compiler-reg-remap-id remap dst)
        class
        ty)]))

(define (compiler-reg-remap-phi-inputs
  [remap : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : CompilerIrPhiInputList
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) CompilerIrPhiInputList.Nil]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-reg-remap-phi-inputs
        remap
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value label rest)
      (compiler-ir-phi-input-cons
        (compiler-reg-remap-value remap value)
        label
        (compiler-reg-remap-phi-inputs remap (box-get rest)))]))

(define (compiler-reg-remap-maybe-value
  [remap : (Array i64)]
  [value : CompilerIrMaybeValue]) : CompilerIrMaybeValue
  (match value
    [(CompilerIrMaybeValue.No) CompilerIrMaybeValue.No]
    [(CompilerIrMaybeValue.Some inner)
      (CompilerIrMaybeValue.Some (compiler-reg-remap-value remap inner))]))

(define (compiler-reg-remap-instr
  [remap : (Array i64)]
  [instr : CompilerIrInstr]) : CompilerIrInstr
  (match instr
    [(CompilerIrInstr.Mov dst value ty)
      (CompilerIrInstr.Mov
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap value)
        ty)]
    [(CompilerIrInstr.Alloc dst ty)
      (CompilerIrInstr.Alloc (compiler-reg-remap-id remap dst) ty)]
    [(CompilerIrInstr.AddrOf dst src)
      (CompilerIrInstr.AddrOf
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-id remap src))]
    [(CompilerIrInstr.Gep dst base offset ty)
      (CompilerIrInstr.Gep
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap base)
        (compiler-reg-remap-value remap offset)
        ty)]
    [(CompilerIrInstr.Load dst src ty)
      (CompilerIrInstr.Load
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        ty)]
    [(CompilerIrInstr.StorePtr ptr value ty)
      (CompilerIrInstr.StorePtr
        (compiler-reg-remap-value remap ptr)
        (compiler-reg-remap-value remap value)
        ty)]
    [(CompilerIrInstr.CopyBytes dst src size)
      (CompilerIrInstr.CopyBytes
        (compiler-reg-remap-value remap dst)
        (compiler-reg-remap-value remap src)
        size)]
    [(CompilerIrInstr.BoundsCheck index length ok-label)
      (CompilerIrInstr.BoundsCheck
        (compiler-reg-remap-value remap index)
        (compiler-reg-remap-value remap length)
        ok-label)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (CompilerIrInstr.Cast
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (CompilerIrInstr.Bitcast
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        from-ty
        to-ty)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (CompilerIrInstr.BinOp
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap lhs)
        (compiler-reg-remap-value remap rhs)
        ty)]
    [(CompilerIrInstr.UnOp dst op value ty)
      (CompilerIrInstr.UnOp
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap value)
        ty)]
    [(CompilerIrInstr.LaneId dst lanes ty)
      (CompilerIrInstr.LaneId (compiler-reg-remap-id remap dst) lanes ty)]
    [(CompilerIrInstr.Splat dst value lanes ty)
      (CompilerIrInstr.Splat
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap value)
        lanes
        ty)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [op (struct-get (box-get payload-box) op)]
        [lhs (struct-get (box-get payload-box) lhs)]
        [rhs (struct-get (box-get payload-box) rhs)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-vector-bin-op
          (compiler-reg-remap-id remap dst)
          op
          (compiler-reg-remap-value remap lhs)
          (compiler-reg-remap-value remap rhs)
          lanes
          ty))]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [op (struct-get (box-get payload-box) op)]
        [src (struct-get (box-get payload-box) src)]
        [carry (struct-get (box-get payload-box) carry)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-vector-prefix
          (compiler-reg-remap-id remap dst)
          op
          (compiler-reg-remap-value remap src)
          (compiler-reg-remap-value remap carry)
          lanes
          ty))]
    [(CompilerIrInstr.VectorReduce dst op src lanes ty)
      (CompilerIrInstr.VectorReduce
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap src)
        lanes
        ty)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [op (struct-get (box-get payload-box) op)]
        [lhs (struct-get (box-get payload-box) lhs)]
        [rhs (struct-get (box-get payload-box) rhs)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-vector-compare
          (compiler-reg-remap-id remap dst)
          op
          (compiler-reg-remap-value remap lhs)
          (compiler-reg-remap-value remap rhs)
          lanes
          ty))]
    [(CompilerIrInstr.MaskBinOp dst op lhs rhs lanes)
      (CompilerIrInstr.MaskBinOp
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap lhs)
        (compiler-reg-remap-value remap rhs)
        lanes)]
    [(CompilerIrInstr.MaskNot dst src lanes)
      (CompilerIrInstr.MaskNot
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        lanes)]
    [(CompilerIrInstr.MaskReduce dst op src lanes)
      (CompilerIrInstr.MaskReduce
        (compiler-reg-remap-id remap dst)
        op
        (compiler-reg-remap-value remap src)
        lanes)]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [mask (struct-get (box-get payload-box) mask)]
        [true-value (struct-get (box-get payload-box) on-true)]
        [false-value (struct-get (box-get payload-box) on-false)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-select
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap mask)
          (compiler-reg-remap-value remap true-value)
          (compiler-reg-remap-value remap false-value)
          lanes
          ty))]
    [(CompilerIrInstr.VectorLoad dst base index lanes ty)
      (CompilerIrInstr.VectorLoad
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap base)
        (compiler-reg-remap-value remap index)
        lanes
        ty)]
    [(CompilerIrInstr.VectorStore payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [value (struct-get (box-get payload-box) value)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-vector-store
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index)
          (compiler-reg-remap-value remap value)
          lanes
          ty))]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [value (struct-get (box-get payload-box) value)]
        [mask (struct-get (box-get payload-box) mask)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-predicated-store
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index)
          (compiler-reg-remap-value remap value)
          (compiler-reg-remap-value remap mask)
          lanes
          ty))]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [mask (struct-get (box-get payload-box) mask)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-predicated-load
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index)
          (compiler-reg-remap-value remap mask)
          lanes
          ty))]
    [(CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [base (struct-get (box-get payload-box) base)]
        [index-base (struct-get (box-get payload-box) index-base)]
        [index (struct-get (box-get payload-box) index)]
        [lane-offset (struct-get (box-get payload-box) lane-offset)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-gather-load
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap index-base)
          (compiler-reg-remap-value remap index)
          lane-offset
          lanes
          ty))]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [source (struct-get (box-get payload-box) source)]
        [selector-low (struct-get (box-get payload-box) selector-low)]
        [selector-high (struct-get (box-get payload-box) selector-high)]
        [active-lanes (struct-get (box-get payload-box) active-lanes)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [ty (struct-get (box-get payload-box) ty)]
        (ir-instr-vector-shuffle
          (compiler-reg-remap-id remap dst)
          (compiler-reg-remap-value remap source)
          (compiler-reg-remap-value remap selector-low)
          (compiler-reg-remap-maybe-value remap selector-high)
          (compiler-reg-remap-value remap active-lanes)
          lanes
          ty))]
    [(CompilerIrInstr.TailMask dst index length lanes)
      (CompilerIrInstr.TailMask
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap index)
        (compiler-reg-remap-value remap length)
        lanes)]
    [(CompilerIrInstr.EntryArgc dst)
      (CompilerIrInstr.EntryArgc (compiler-reg-remap-id remap dst))]
    [(CompilerIrInstr.EntryArgv dst)
      (CompilerIrInstr.EntryArgv (compiler-reg-remap-id remap dst))]
    [(CompilerIrInstr.EntryEnvp dst)
      (CompilerIrInstr.EntryEnvp (compiler-reg-remap-id remap dst))]
    [(CompilerIrInstr.CpuId dst leaf subleaf reg-index)
      (CompilerIrInstr.CpuId
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap leaf)
        (compiler-reg-remap-value remap subleaf)
        reg-index)]
    [(CompilerIrInstr.Xgetbv dst index)
      (CompilerIrInstr.Xgetbv
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap index))]
    [(CompilerIrInstr.Syscall dst args)
      (CompilerIrInstr.Syscall
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-call-args remap args))]
    [(CompilerIrInstr.Call dst name args ty)
      (CompilerIrInstr.Call
        (compiler-reg-remap-id remap dst)
        name
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(CompilerIrInstr.CallIndirect dst callee args ty)
      (CompilerIrInstr.CallIndirect
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap callee)
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(CompilerIrInstr.CallIndirectC dst callee args ty)
      (CompilerIrInstr.CallIndirectC
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap callee)
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [name (struct-get (box-get payload-box) name)]
        [args (struct-get (box-get payload-box) args)]
        [slots (struct-get (box-get payload-box) slots)]
        (ir-instr-call-cabi-store-result
          (compiler-reg-remap-value remap base)
          name
          (compiler-reg-remap-call-args remap args)
          slots))]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [callee (struct-get (box-get payload-box) callee)]
        [args (struct-get (box-get payload-box) args)]
        [slots (struct-get (box-get payload-box) slots)]
        (ir-instr-call-indirect-cabi-store-result
          (compiler-reg-remap-value remap base)
          (compiler-reg-remap-value remap callee)
          (compiler-reg-remap-call-args remap args)
          slots))]
    [(CompilerIrInstr.SpmdCall payload-box)
      (let
        [callee (struct-get (box-get payload-box) callee)]
        [backend (struct-get (box-get payload-box) backend)]
        [lanes (struct-get (box-get payload-box) lanes)]
        [active-mask (struct-get (box-get payload-box) active-mask)]
        [args (struct-get (box-get payload-box) args)]
        [result (struct-get (box-get payload-box) result)]
        (ir-instr-spmd-call
          callee
          backend
          lanes
          (compiler-reg-remap-value remap active-mask)
          (compiler-reg-remap-spmd-call-args remap args)
          (compiler-reg-remap-spmd-call-result remap result)))]
    [(CompilerIrInstr.TailCall name args ty)
      (CompilerIrInstr.TailCall
        name
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(CompilerIrInstr.TailCallIndirect callee args ty)
      (CompilerIrInstr.TailCallIndirect
        (compiler-reg-remap-value remap callee)
        (compiler-reg-remap-call-args remap args)
        ty)]
    [(CompilerIrInstr.Store name value ty)
      (CompilerIrInstr.Store name (compiler-reg-remap-value remap value) ty)]
    [(CompilerIrInstr.Jump _) instr]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (CompilerIrInstr.Branch
        (compiler-reg-remap-value remap cond)
        true-label
        false-label)]
    [(CompilerIrInstr.Return value)
      (CompilerIrInstr.Return (compiler-reg-remap-maybe-value remap value))]
    [(CompilerIrInstr.Phi dst inputs ty)
      (CompilerIrInstr.Phi
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-phi-inputs remap inputs)
        ty)]
    [(CompilerIrInstr.Pack dst words ty)
      (CompilerIrInstr.Pack
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value-list remap words)
        ty)]
    [(CompilerIrInstr.Word dst src index ty)
      (CompilerIrInstr.Word
        (compiler-reg-remap-id remap dst)
        (compiler-reg-remap-value remap src)
        index
        ty)]
    [(CompilerIrInstr.Switch index base cases default-label)
      (CompilerIrInstr.Switch
        (compiler-reg-remap-value remap index)
        base
        cases
        default-label)]))

;; A 1:1 var remap: the output is exactly as long as the input, so it is
;; written straight into a right-sized dense sequence instead of through a
;; cons spine. The output is FRESH and the input is never written through, so
;; the aliasing graph is unchanged and no unique-ownership argument is needed
;; (refs #5726).
(define (compiler-reg-remap-instr-seq
  [remap : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : CompilerIrInstrSeq
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            out
            index
            (compiler-reg-remap-instr remap (array-ref slots index)))
          (set! index (+ index 1))))
      (CompilerIrInstrSeq out count))))

(define (compiler-reg-remap-blocks
  [remap : (Array i64)]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerIrBlockList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (CompilerIrBlockList.Cons
            (CompilerIrBlock.Block
              label
              (compiler-reg-remap-instr-seq remap instrs))
            (box (compiler-reg-remap-blocks remap (box-get rest))))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [count : i64 (compiler-ir-block-seq-count seq)]
        [slots : (Array CompilerIrBlock)
          (array.make-array CompilerIrBlock count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block label instrs)
                  (array-set!
                    slots
                    i
                    (CompilerIrBlock.Block
                      label
                      (compiler-reg-remap-instr-seq remap instrs)))])
              (set! i (+ i 1))))
          (CompilerIrBlockList.Array (CompilerIrBlockSeq slots count))))]))

(define (compiler-reg-plan-assignments [plan : CompilerRegPlan]) : CompilerRegAssignmentList
  (match plan
    [(CompilerRegPlan.Plan assignments _ _ _ _ _) assignments]))

(define (compiler-reg-plan-ineligible [plan : CompilerRegPlan]) : CompilerLiveI64Set
  (match plan
    [(CompilerRegPlan.Plan _ ineligible _ _ _ _) ineligible]))

(define (compiler-reg-plan-intervals [plan : CompilerRegPlan]) : CompilerRegIntervalSeq
  (match plan
    [(CompilerRegPlan.Plan _ _ intervals _ _ _) intervals]))

(define (compiler-reg-plan-types [plan : CompilerRegPlan]) : CompilerRegVarTypeList
  (match plan
    [(CompilerRegPlan.Plan _ _ _ types _ _) types]))

(define (compiler-reg-plan-caller-save-regs [plan : CompilerRegPlan]) : (Array
    i64)
  (match plan
    [(CompilerRegPlan.Plan _ _ _ _ split _)
      (compiler-reg-call-split-regs split)]))

(define (compiler-reg-plan-caller-save-regions [plan : CompilerRegPlan]) : CompilerRegCallRegionSeq
  (match plan
    [(CompilerRegPlan.Plan _ _ _ _ split _)
      (compiler-reg-call-split-regions split)]))

(define (compiler-reg-assignment-list-merge
  [extra : CompilerRegAssignmentList]
  [base : CompilerRegAssignmentList]) : CompilerRegAssignmentList
  (match extra
    [(CompilerRegAssignmentList.Nil) base]
    [(CompilerRegAssignmentList.Cons item rest)
      (compiler-reg-assignment-list-merge
        (box-get rest)
        (compiler-reg-assignment-insert
          base
          (struct-get item var)
          (struct-get item location)))]))

(define (compiler-reg-var-type-list-merge
  [extra : CompilerRegVarTypeList]
  [base : CompilerRegVarTypeList]) : CompilerRegVarTypeList
  (match extra
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-var-type-list-merge
        (compiler-reg-var-type-seq-to-list seq)
        base)]
    [(CompilerRegVarTypeList.Nil) base]
    [(CompilerRegVarTypeList.Cons item rest)
      (compiler-reg-var-type-list-merge
        (box-get rest)
        (compiler-reg-var-type-insert
          base
          (struct-get item var)
          (struct-get item ty)))]))

(define (compiler-reg-plan-with-call-save-rewrite
  [plan : CompilerRegPlan]
  [rewrite : CompilerRegCallSaveRewrite]) : CompilerRegPlan
  (match plan
    [(CompilerRegPlan.Plan
        assignments
        ineligible
        intervals
        types
        shadows
        split-plan)
      (match rewrite
        [(CompilerRegCallSaveRewrite.Rewrite
            _
            _
            _
            extra-assignments
            extra-types)
          (CompilerRegPlan.Plan
            (compiler-reg-assignment-list-merge extra-assignments assignments)
            ineligible
            intervals
            (compiler-reg-var-type-list-merge extra-types types)
            shadows
            split-plan)])]))

;; Leaf-CSR replanning temporarily preassigns an adjacent compare->branch result
;; to the loop register so the greedy can place the real split range there.
;; That boolean is proven fuse-only by candidate selection and therefore has no
;; materialized home in emitted code. Publish it as frame-free rematerialized
;; metadata after allocation so scratch occupancy does not treat the phantom
;; result as a second physical value. Fresh split vars are >= `in-vars` and keep
;; their real preassigned homes.
(define (compiler-reg-leaf-csr-phantom-assignments
  [assignments : CompilerRegAssignmentList]
  [in-vars : i64]) : CompilerRegAssignmentList
  (match assignments
    [(CompilerRegAssignmentList.Nil) CompilerRegAssignmentList.Nil]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [var : i64 (struct-get item var)]
        (if (< var in-vars)
          (compiler-reg-assignment-cons
            (CompilerRegAssignment
              var
              (CompilerRegLocation.Remat (CompilerIrValue.Bool false)))
            (compiler-reg-leaf-csr-phantom-assignments (box-get rest) in-vars))
          (compiler-reg-leaf-csr-phantom-assignments (box-get rest) in-vars)))]))

(define (compiler-reg-plan-hide-leaf-csr-phantoms
  [plan : CompilerRegPlan]
  [preassignments : CompilerRegAssignmentList]
  [in-vars : i64]) : CompilerRegPlan
  (match plan
    [(CompilerRegPlan.Plan
        assignments
        ineligible
        intervals
        types
        shadows
        split-plan)
      (CompilerRegPlan.Plan
        (compiler-reg-assignment-list-merge
          (compiler-reg-leaf-csr-phantom-assignments preassignments in-vars)
          assignments)
        ineligible
        intervals
        types
        shadows
        split-plan)]))

(define (compiler-reg-plan-var-count-intervals
  [intervals : CompilerRegIntervalSeq]
  [best : i64]) : i64
  (let
    [out : i64 best]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (begin
          (let
            [var : i64
              (struct-get (compiler-reg-interval-seq-ref intervals index) var)]
            (if (>= var out)
              (set! out (+ var 1))
              unit))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-plan-var-count-assignments
  [assignments : CompilerRegAssignmentList]
  [best : i64]) : i64
  (match assignments
    [(CompilerRegAssignmentList.Nil) best]
    [(CompilerRegAssignmentList.Cons item rest)
      (let
        [var : i64 (struct-get item var)]
        (compiler-reg-plan-var-count-assignments
          (box-get rest)
          (if (>= var best)
            (+ var 1)
            best)))]))

(define (compiler-reg-plan-var-count-types
  [types : CompilerRegVarTypeList]
  [best : i64]) : i64
  (match types
    ;; The cons walk keeps the highest id it sees; on the array view that is the
    ;; last present slot, so scan down from the top instead of over every entry.
    [(CompilerRegVarTypeList.Array seq)
      (let
        [present : (Array i64) (struct-get seq present)]
        [index : i64 (- (array-length present) 1)]
        (begin
          (while (if (< index 0)
            false
            (= (array-ref present index) 0))
            (set! index (- index 1)))
          (if (>= index best)
            (+ index 1)
            best)))]
    [(CompilerRegVarTypeList.Nil) best]
    [(CompilerRegVarTypeList.Cons item rest)
      (let
        [var : i64 (struct-get item var)]
        (compiler-reg-plan-var-count-types
          (box-get rest)
          (if (>= var best)
            (+ var 1)
            best)))]))

(define (compiler-reg-plan-var-count [plan : CompilerRegPlan] [min-vars : i64]) : i64
  (match plan
    [(CompilerRegPlan.Plan assignments _ intervals types _ _)
      (compiler-reg-plan-var-count-types
        types
        (compiler-reg-plan-var-count-assignments
          assignments
          (compiler-reg-plan-var-count-intervals intervals min-vars)))]))

;; A scratch requirement is an instruction-selection temporary that must have a
;; physical register for a bounded point range.  The requirement is independent
;; of any particular emitter family: `role` identifies the consumer, while the
;; typed constraint carries the register file and legal-home policy.  An empty
;; assigned register is an explicit "use the legacy scavenger" outcome.
(defenum CompilerRegScratchClass
  (Gp)
  (Xmm))

(defenum CompilerRegScratchRole
  (CallTarget)
  (CallStage)
  (CallMemoryXmm)
  (AggregateWord)
  (PhiCycle)
  (PhiCycleXmm)
  (PhiStage)
  (SwitchIndex)
  (SwitchTable)
  (BoundsLength)
  (BoundsIndex)
  (ShuffleActive)
  (ShuffleSelector)
  (MemoryAddress)
  (MemoryIndex)
  (MemoryValue)
  (CopyDst)
  (CopySrc)
  (CopyValue)
  (CopyValueXmm)
  (SplatValueGp)
  (SplatValueXmm)
  (SimdAddressBase)
  (SimdAddressIndex)
  (VectorPrefixCarry)
  (VectorPrefixBits)
  (VectorPrefixValue)
  (VectorPrefixWork0)
  (VectorPrefixWork1)
  (VectorReduceAccumulator)
  (VectorReduceScratch)
  (FloatCastValueXmm)
  (FloatCastValueGp)
  (FloatCastScratchGp)
  (FloatBitcastValueXmm)
  (FloatBitcastValueGp)
  (FloatMoveValueXmm)
  (FloatMemoryValueXmm)
  (FloatArithmeticResultXmm)
  (FloatArithmeticRhsXmm)
  (FloatCompareLhsXmm)
  (FloatCompareRhsXmm)
  (FloatCompareResultGp)
  (FloatUnaryResultXmm)
  (FloatReturnResultXmm)
  (FloatReturnResultGp)
  (ScalarPrimary)
  (ScalarSecondary)
  (ScalarTertiary)
  (FixedRax)
  (FixedRdx)
  (FixedRcx)
  (BranchTest)
  (CpuIdSave))

(defstruct CompilerRegScratchConstraint
  (register-class CompilerRegScratchClass)
  (allowed CompilerRegIdList)
  (excluded CompilerRegIdList)
  (fixed i64))

(defstruct CompilerRegScratchRequirement
  (point i64)
  (ordinal i64)
  (role CompilerRegScratchRole)
  (constraint CompilerRegScratchConstraint)
  (lo i64)
  (hi i64)
  (var i64))

(defstruct CompilerRegScratchAssignment
  (requirement CompilerRegScratchRequirement)
  (register i64))

;; `first[instruction-index]` plus the slot ordinal is an O(1) item lookup.
;; Points are the allocator's even instruction points, so instruction-index is
;; point/2 for list and dense block representations alike.  The arrays are
;; allocated to the exact function counts: there is no site cap.
(defstruct CompilerRegScratchPlan
  (items (Array CompilerRegScratchAssignment))
  (first (Array i64))
  (slots (Array i64)))

(defenum CompilerRegScratchPlanResult
  (Result CompilerRegPlan CompilerRegScratchPlan))

(define (compiler-reg-scratch-plan-empty) : CompilerRegScratchPlan
  (CompilerRegScratchPlan
    (array.make-array CompilerRegScratchAssignment 0)
    (array.make-array i64 0)
    (array.make-array i64 0)))

(define (compiler-reg-scratch-plan-count [plan : CompilerRegScratchPlan]) : i64
  (array-length (struct-get plan items)))

(define (compiler-reg-scratch-plan-register
  [plan : CompilerRegScratchPlan]
  [point : i64]
  [ordinal : i64]) : i64
  (if (or (< point 0) (not (= (% point 2) 0)) (< ordinal 0))
    compiler-reg-id-invalid
    (let
      [instruction : i64 (/ point 2)]
      [firsts : (Array i64) (struct-get plan first)]
      [slot-counts : (Array i64) (struct-get plan slots)]
      (if (or
        (>= instruction (array-length firsts))
        (>= instruction (array-length slot-counts))
        (>= ordinal (array-ref slot-counts instruction)))
        compiler-reg-id-invalid
        (let
          [index : i64 (+ (array-ref firsts instruction) ordinal)]
          [items : (Array CompilerRegScratchAssignment) (struct-get plan items)]
          (if (or (< index 0) (>= index (array-length items)))
            compiler-reg-id-invalid
            (let
              [item : CompilerRegScratchAssignment (array-ref items index)]
              [requirement : CompilerRegScratchRequirement
                (struct-get item requirement)]
              (if (and
                (= (struct-get requirement point) point)
                (= (struct-get requirement ordinal) ordinal))
                (struct-get item register)
                compiler-reg-id-invalid))))))))

(define (compiler-reg-scratch-var-register-homed?
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register _) true]
        [(CompilerRegLocation.RegisterPair _ _) true]
        [_ false])]
    [_ false]))

(define (compiler-reg-scratch-value-direct?
  [assignments : CompilerRegAssignmentList]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (compiler-reg-scratch-var-register-homed? assignments var)]
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [(CompilerIrValue.Unit) true]
    [_ false]))

(define (compiler-reg-scratch-value-integer-immediate?
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [_ false]))

(define (compiler-reg-scratch-value-register-homed?
  [assignments : CompilerRegAssignmentList]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (compiler-reg-scratch-var-register-homed? assignments var)]
    [_ false]))

(define (compiler-reg-scratch-value-same-home?
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]) : bool
  (match src
    [(CompilerIrValue.Var src-var)
      (if (= dst src-var)
        true
        (match (compiler-reg-assignment-lookup assignments dst)
          [(CompilerRegMaybeLocation.Some dst-location)
            (match (compiler-reg-assignment-lookup assignments src-var)
              [(CompilerRegMaybeLocation.Some src-location)
                (compiler-reg-location-eq? dst-location src-location)]
              [(CompilerRegMaybeLocation.No) false])]
          [(CompilerRegMaybeLocation.No) false]))]
    [_ false]))

(define (compiler-reg-scratch-var-register-home
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : i64
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register reg) reg]
        [_ compiler-reg-id-invalid])]
    [(CompilerRegMaybeLocation.No) compiler-reg-id-invalid]))

(define (compiler-reg-scratch-float-value-register
  [assignments : CompilerRegAssignmentList]
  [value : CompilerIrValue]) : i64
  (match value
    [(CompilerIrValue.Var var)
      (let
        [home : i64 (compiler-reg-scratch-var-register-home assignments var)]
        (if (compiler-abi-xmm-register-id? home)
          home
          compiler-reg-id-invalid))]
    [_ compiler-reg-id-invalid]))

(define (compiler-reg-scratch-float-value-memory?
  [assignments : CompilerRegAssignmentList]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _) true]
            [_ false])]
        [(CompilerRegMaybeLocation.No) true])]
    [(CompilerIrValue.Global _) true]
    [(CompilerIrValue.F64 _) true]
    [_ false]))

(define (compiler-reg-scratch-float-rhs-direct?
  [assignments : CompilerRegAssignmentList]
  [rhs : CompilerIrValue]
  [accumulator : i64]) : bool
  (let
    [home : i64 (compiler-reg-scratch-float-value-register assignments rhs)]
    (or
      (and
        (not (= home compiler-reg-id-invalid))
        (not (compiler-reg-registers-overlap? home accumulator)))
      (compiler-reg-scratch-float-value-memory? assignments rhs))))

(define (compiler-reg-scratch-float-value?
  [types : CompilerRegVarTypeList]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.Var var)
      (match (compiler-reg-var-type-lookup types var)
        [(CompilerRegMaybeType.Some ty) (compiler-reg-float-type? ty)]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerIrValue.F64 _) true]
    [_ false]))

(define (compiler-reg-scratch-float-binop?
  [types : CompilerRegVarTypeList]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : bool
  (or
    (compiler-reg-float-type? ty)
    (compiler-reg-scratch-float-value? types lhs)
    (compiler-reg-scratch-float-value? types rhs)))

(define (compiler-reg-scratch-compare-op? [op : CompilerIrBinOp]) : bool
  (compiler-ir-binop-compare? op))

(define (compiler-reg-scratch-float-arithmetic-slot-count
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [rhs : CompilerIrValue]
  [binop-return : bool]) : i64
  (if binop-return
    (+
      1
      (if (compiler-reg-scratch-float-rhs-direct?
        assignments
        rhs
        (compiler-abi-xmm-register-id 0))
        0
        1))
    (let
      [dst-home : i64 (compiler-reg-scratch-var-register-home assignments dst)]
      (if (and
        (>= (compiler-reg-xmm-family-index dst-home) 0)
        (compiler-reg-scratch-float-rhs-direct? assignments rhs dst-home))
        0
        (+
          1
          (if (compiler-reg-scratch-float-rhs-direct?
            assignments
            rhs
            compiler-reg-id-invalid)
            0
            1))))))

(define (compiler-reg-scratch-float-compare-fallback?
  [assignments : CompilerRegAssignmentList]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : bool
  (let
    [lhs-home : i64 (compiler-reg-scratch-float-value-register assignments lhs)]
    (or
      (= lhs-home compiler-reg-id-invalid)
      (not (compiler-reg-scratch-float-rhs-direct? assignments rhs lhs-home)))))

(define (compiler-reg-scratch-float-compare-slot-count
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [binop-return : bool]) : i64
  (let
    [fallback? : bool
      (compiler-reg-scratch-float-compare-fallback? assignments lhs rhs)]
    [rhs-temp? : bool
      (and
        fallback?
        (not
          (compiler-reg-scratch-float-rhs-direct?
            assignments
            rhs
            compiler-reg-id-invalid)))]
    (if binop-return
      (+
        1
        (if fallback?
          1
          0)
        (if rhs-temp?
          1
          0))
      (+
        (if fallback?
          1
          0)
        (if rhs-temp?
          1
          0)
        (if (compiler-reg-scratch-var-register-homed? assignments dst)
          0
          1)))))

(define (compiler-reg-scratch-cast-xmm-needed?
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : bool
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and from-float to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and (not from-float) to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and from-float (not to-float))
        (not (compiler-reg-scratch-value-register-homed? assignments src))]
      [else false])))

(define (compiler-reg-scratch-cast-gp-count
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : i64
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and (not from-float) to-float)
        ;; Unsigned 64-bit conversion destructively shifts a copy and needs a
        ;; second GP sibling for the low bit, even when the input is homed.
        (match from-ty
          [(AstType.U64) 2]
          [_
            (if (compiler-reg-scratch-value-register-homed? assignments src)
              0
              1)])]
      [(and from-float (not to-float))
        (if (compiler-reg-scratch-var-register-homed? assignments dst)
          0
          1)]
      [else 0])))

(define (compiler-reg-scratch-cast-slot-count
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : i64
  (if (and
    (ast-type-eq-with-seg-bases? type-segment-bases from-ty to-ty)
    (compiler-reg-scratch-value-same-home? assignments dst src))
    0
    (+
      (if (compiler-reg-scratch-cast-xmm-needed?
        assignments
        dst
        src
        from-ty
        to-ty)
        1
        0)
      (compiler-reg-scratch-cast-gp-count assignments dst src from-ty to-ty))))

(define (compiler-reg-scratch-bitcast-xmm-needed?
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : bool
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and from-float (not to-float))
        (not (compiler-reg-scratch-value-register-homed? assignments src))]
      [(and (not from-float) to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and from-float to-float)
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [else false])))

(define (compiler-reg-scratch-bitcast-gp-needed?
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : bool
  (let
    [from-float : bool (compiler-reg-float-type? from-ty)]
    [to-float : bool (compiler-reg-float-type? to-ty)]
    (cond
      [(and from-float (not to-float))
        (not (compiler-reg-scratch-var-register-homed? assignments dst))]
      [(and (not from-float) to-float)
        (not (compiler-reg-scratch-value-register-homed? assignments src))]
      [else false])))

(define (compiler-reg-scratch-bitcast-slot-count
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [src : CompilerIrValue]
  [from-ty : AstType]
  [to-ty : AstType]) : i64
  (+
    (if (compiler-reg-scratch-bitcast-xmm-needed?
      assignments
      dst
      src
      from-ty
      to-ty)
      1
      0)
    (if (compiler-reg-scratch-bitcast-gp-needed?
      assignments
      dst
      src
      from-ty
      to-ty)
      1
      0)))

(define (compiler-reg-scratch-binop-return-next?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 1) (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.BinOp dst _ _ _ _)
        (match (compiler-ir-instr-seq-ref instrs (+ index 1))
          [(CompilerIrInstr.Return maybe)
            (match maybe
              [(CompilerIrMaybeValue.Some (CompilerIrValue.Var value))
                (= value dst)]
              [_ false])]
          [_ false])]
      [_ false])))

(define (compiler-reg-scratch-vreg-slots
  [_type-segment-bases : i64]
  [_abi : CompilerRegTargetAbi]
  [_assignments : CompilerRegAssignmentList]
  [_types : CompilerRegVarTypeList]
  [_instr : CompilerIrInstr]
  [_phi-targets : CompilerRegLabelList]
  [_phi-xmm-targets : CompilerRegLabelList]
  [_binop-return : bool]) : i64
  (cfg
    scratch-vreg
    (match _instr
      ;; Fixed-width ordinals keep the map independent of assignment failure.
      [(CompilerIrInstr.Call _ name _ _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-c-memory-call-name? name))
          2
          1)]
      [(CompilerIrInstr.CallIndirect _ _ _ _) 2]
      [(CompilerIrInstr.CallIndirectC _ _ args _)
        (if (and
          (compiler-reg-linux-abi? _abi)
          (compiler-reg-call-args-have-c-memory-marker? args))
          3
          2)]
      [(CompilerIrInstr.CallCAbiStoreResult payload-box)
        (let
          [name (struct-get (box-get payload-box) name)]
          (if (and
            (compiler-reg-linux-abi? _abi)
            (compiler-reg-c-memory-call-name? name))
            3
            2))]
      [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
        (let
          [args (struct-get (box-get payload-box) args)]
          (if (and
            (compiler-reg-linux-abi? _abi)
            (compiler-reg-call-args-have-c-memory-marker? args))
            3
            2))]
      [(CompilerIrInstr.TailCall _ _ _) 1]
      [(CompilerIrInstr.TailCallIndirect _ _ _) 2]
      [(CompilerIrInstr.Pack _ _ _) 2]
      [(CompilerIrInstr.Word _ _ _ _) 1]
      [(CompilerIrInstr.Jump target)
        (if (compiler-reg-label-list-contains? _phi-targets target)
          (if (compiler-reg-label-list-contains? _phi-xmm-targets target)
            3
            2)
          0)]
      [(CompilerIrInstr.Branch condition true-label false-label)
        (if (or
          (compiler-reg-label-list-contains? _phi-targets true-label)
          (compiler-reg-label-list-contains? _phi-targets false-label))
          (if (or
            (compiler-reg-label-list-contains? _phi-xmm-targets true-label)
            (compiler-reg-label-list-contains? _phi-xmm-targets false-label))
            4
            3)
          (if (compiler-reg-scratch-value-direct? _assignments condition)
            0
            1))]
      [(CompilerIrInstr.Select payload-box)
        (let
          [lanes (struct-get (box-get payload-box) lanes)]
          (if (= lanes 0)
            3
            0))]
      ;; Division has two explicit fixed operands plus three simultaneously
      ;; live GP temporaries. Variable shifts have a fixed %rcx count plus one
      ;; result temporary. Other scalar binops reserve only the staging home
      ;; their selected shape consumes; notably, a Var RHS immediately returned
      ;; through %rax gets one context-aware home instead of taxing every ALU.
      [(CompilerIrInstr.BinOp dst op lhs rhs ty)
        (if (compiler-reg-scratch-float-binop? _types lhs rhs ty)
          (if (compiler-reg-scratch-compare-op? op)
            (compiler-reg-scratch-float-compare-slot-count
              _assignments
              dst
              lhs
              rhs
              _binop-return)
            (compiler-reg-scratch-float-arithmetic-slot-count
              _assignments
              dst
              rhs
              _binop-return))
          (if (compiler-reg-clobber-binop-div? op)
            5
            (if (compiler-reg-clobber-binop-shift? op rhs ty)
              2
              (if (compiler-ir-binop-compare? op)
                ;; Fused comparisons keep two distinct operand homes live
                ;; through the following Branch.
                (if (or
                  (compiler-reg-scratch-value-direct? _assignments lhs)
                  (compiler-reg-scratch-value-direct? _assignments rhs))
                  0
                  2)
                (match op
                  ;; Constant shifts accumulate directly in a register-homed
                  ;; destination; a spill needs one result staging home.
                  [(CompilerIrBinOp.Shl)
                    (if (compiler-reg-scratch-var-register-homed?
                      _assignments
                      dst)
                      0
                      1)]
                  [(CompilerIrBinOp.Shr)
                    (if (compiler-reg-scratch-var-register-homed?
                      _assignments
                      dst)
                      0
                      1)]
                  [_
                    (if _binop-return
                      (match rhs
                        [(CompilerIrValue.Var _) 1]
                        [_ 0])
                      (match rhs
                        [(CompilerIrValue.Var _)
                          (if (compiler-reg-scratch-var-register-homed?
                            _assignments
                            dst)
                            (if (compiler-reg-scratch-value-same-home?
                              _assignments
                              dst
                              rhs)
                              (if (and
                                (compiler-reg-scratch-value-direct?
                                  _assignments
                                  lhs)
                                (match op
                                  [(CompilerIrBinOp.Add) true]
                                  [(CompilerIrBinOp.And) true]
                                  [(CompilerIrBinOp.Or) true]
                                  [(CompilerIrBinOp.BitAnd) true]
                                  [(CompilerIrBinOp.BitOr) true]
                                  [(CompilerIrBinOp.BitXor) true]
                                  [_ false]))
                                0
                                1)
                              0)
                            0)]
                        [_ 0]))])))))]
      [(CompilerIrInstr.UnOp dst _ _ _)
        (if (compiler-reg-scratch-var-register-homed? _assignments dst)
          0
          1)]
      [(CompilerIrInstr.CpuId _ _ _ _) 1]
      [(CompilerIrInstr.Switch _ _ _ _) 2]
      [(CompilerIrInstr.BoundsCheck _ _ _) 2]
      ;; Ordered selector validation keeps active-lanes and the current selector
      ;; in independent GP temporaries.
      [(CompilerIrInstr.VectorShuffle _) 2]
      [(CompilerIrInstr.AddrOf dst _)
        (if (compiler-reg-scratch-var-register-homed? _assignments dst)
          0
          1)]
      [(CompilerIrInstr.Gep dst base offset _)
        (if (and
          (compiler-reg-scratch-var-register-homed? _assignments dst)
          (compiler-reg-scratch-value-direct? _assignments base)
          (compiler-reg-scratch-value-integer-immediate? offset))
          0
          2)]
      [(CompilerIrInstr.Load dst src ty)
        (let
          [address? : bool
            (not (compiler-reg-scratch-value-direct? _assignments src))]
          [value? : bool
            (and
              (compiler-reg-scalar-type? ty)
              (not (compiler-reg-scratch-var-register-homed? _assignments dst)))]
          (if value?
            2
            (if address?
              1
              0)))]
      [(CompilerIrInstr.StorePtr dst src ty)
        (let
          [address? : bool
            (not (compiler-reg-scratch-value-direct? _assignments dst))]
          [value? : bool
            (and
              (compiler-reg-scalar-type? ty)
              (not (compiler-reg-scratch-value-direct? _assignments src)))]
          (if value?
            2
            (if address?
              1
              0)))]
      [(CompilerIrInstr.CopyBytes _ _ size)
        (if (<= size 0)
          0
          (if (>= size 16)
            (if (= (% size 16) 0)
              3
              4)
            3))]
      [(CompilerIrInstr.Store _ value ty)
        (if (and
          (compiler-reg-scalar-type? ty)
          (not (compiler-reg-scratch-value-direct? _assignments value)))
          1
          0)]
      [(CompilerIrInstr.Cast dst src from-ty to-ty)
        (compiler-reg-scratch-cast-slot-count
          _type-segment-bases
          _assignments
          dst
          src
          from-ty
          to-ty)]
      [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
        (compiler-reg-scratch-bitcast-slot-count
          _assignments
          dst
          src
          from-ty
          to-ty)]
      [(CompilerIrInstr.Mov dst src ty)
        (if (and
          (compiler-reg-float-type? ty)
          (not (compiler-reg-scratch-value-same-home? _assignments dst src))
          (not (compiler-reg-scratch-var-register-homed? _assignments dst)))
          1
          0)]
      ;; A non-memory splat stages integer lanes through GP+XMM and float lanes
      ;; through XMM. Keep the two fixed ordinals so emission lookup remains
      ;; stable regardless of the source home and selected element type.
      [(CompilerIrInstr.Splat _ _ _ _) 2]
      ;; Every SIMD indexed address needs a stable base slot. Dynamic indices
      ;; additionally need an independent GP slot; integer immediates fold into
      ;; the addressing displacement and must not reserve that second ordinal.
      [(CompilerIrInstr.VectorLoad _ _ index _ _)
        (if (compiler-reg-scratch-value-integer-immediate? index)
          1
          2)]
      [(CompilerIrInstr.VectorStore payload-box)
        (let
          [index (struct-get (box-get payload-box) index)]
          (if (compiler-reg-scratch-value-integer-immediate? index)
            1
            2))]
      [(CompilerIrInstr.PredicatedStore payload-box)
        (let
          [index (struct-get (box-get payload-box) index)]
          (if (compiler-reg-scratch-value-integer-immediate? index)
            1
            2))]
      [(CompilerIrInstr.PredicatedLoad payload-box)
        (let
          [index (struct-get (box-get payload-box) index)]
          (if (compiler-reg-scratch-value-integer-immediate? index)
            1
            2))]
      [(CompilerIrInstr.GatherLoad payload-box)
        (let
          [index (struct-get (box-get payload-box) index)]
          [lane-offset (struct-get (box-get payload-box) lane-offset)]
          (if (or
            lane-offset
            (compiler-reg-scratch-value-integer-immediate? index))
            1
            2))]
      ;; Numeric and AVX2-bool prefixes need a carry/materialization slot, a
      ;; destination staging slot, and two simultaneous XMM work registers.
      ;; AVX-512 bool prefixes operate in the mask/GP banks and need only their
      ;; carry and prefix-bit GP slots.
      [(CompilerIrInstr.VectorPrefix payload-box)
        (let
          [lanes (struct-get (box-get payload-box) lanes)]
          [elem-ty (struct-get (box-get payload-box) ty)]
          (match elem-ty
            [(AstType.Bool)
              (if (> lanes 32)
                2
                4)]
            [_ 4]))]
      [(CompilerIrInstr.VectorReduce _ _ _ _ _) 2]
      [_ 0])
    0))

(define (compiler-reg-scratch-vreg-count-seq
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [instrs : CompilerIrInstrSeq]
  [phi-targets : CompilerRegLabelList]
  [phi-xmm-targets : CompilerRegLabelList]
  [count : i64]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (struct-get instrs len)]
    [i : i64 0]
    [out : i64 count]
    (begin
      (while (< i len)
        (begin
          (set!
            out
            (+
              out
              (compiler-reg-scratch-vreg-slots
                type-segment-bases
                abi
                assignments
                types
                (array-ref slots i)
                phi-targets
                phi-xmm-targets
                (compiler-reg-scratch-binop-return-next? instrs i))))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-scratch-vreg-count-blocks
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [blocks : CompilerIrBlockList]
  [phi-targets : CompilerRegLabelList]
  [phi-xmm-targets : CompilerRegLabelList]
  [count : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) count]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-scratch-vreg-count-blocks
            type-segment-bases
            abi
            assignments
            types
            (box-get rest)
            phi-targets
            phi-xmm-targets
            (compiler-reg-scratch-vreg-count-seq
              type-segment-bases
              abi
              assignments
              types
              instrs
              phi-targets
              phi-xmm-targets
              count))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [block-count : i64 (compiler-ir-block-seq-count seq)]
        [out : i64 count]
        (begin
          (while (< i block-count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-scratch-vreg-count-seq
                      type-segment-bases
                      abi
                      assignments
                      types
                      instrs
                      phi-targets
                      phi-xmm-targets
                      out))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-scratch-vreg-instr-count-blocks
  [blocks : CompilerIrBlockList]
  [count : i64]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) count]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-scratch-vreg-instr-count-blocks
            (box-get rest)
            (+ count (struct-get instrs len)))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [block-count : i64 (compiler-ir-block-seq-count seq)]
        [out : i64 count]
        (begin
          (while (< i block-count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set! out (+ out (struct-get instrs len)))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-copy-i64-array!
  [dst : (Array i64)]
  [src : (Array i64)]
  [i : i64]) : unit
  (if (>= i (array-length src))
    unit
    (begin
      (if (< i (array-length dst))
        (array-set! dst i (array-ref src i))
        unit)
      (compiler-reg-copy-i64-array! dst src (+ i 1)))))

(define (compiler-reg-copy-ast-type-array!
  [dst : (Array AstType)]
  [src : (Array AstType)]
  [i : i64]) : unit
  (if (>= i (array-length src))
    unit
    (begin
      (if (< i (array-length dst))
        (array-set! dst i (array-ref src i))
        unit)
      (compiler-reg-copy-ast-type-array! dst src (+ i 1)))))

(define (compiler-reg-copy-interval-seq-array!
  [dst : (Array CompilerRegIntervalSeq)]
  [src : (Array CompilerRegIntervalSeq)]
  [i : i64]) : unit
  (if (>= i (array-length src))
    unit
    (begin
      (if (< i (array-length dst))
        (array-set! dst i (array-ref src i))
        unit)
      (compiler-reg-copy-interval-seq-array! dst src (+ i 1)))))

(define (compiler-reg-fill-interval-seq-array!
  [items : (Array CompilerRegIntervalSeq)]
  [i : i64]) : unit
  (if (>= i (array-length items))
    unit
    (begin
      (array-set! items i (compiler-reg-interval-seq-empty))
      (compiler-reg-fill-interval-seq-array! items (+ i 1)))))

(define (compiler-reg-types-from-list-fill!
  [types : CompilerRegVarTypeList]
  [present : (Array i64)]
  [items : (Array AstType)]) : unit
  (match types
    [(CompilerRegVarTypeList.Array seq)
      (compiler-reg-types-from-list-fill!
        (compiler-reg-var-type-seq-to-list seq)
        present
        items)]
    [(CompilerRegVarTypeList.Nil) unit]
    [(CompilerRegVarTypeList.Cons item rest)
      (begin
        (compiler-reg-var-type-array-set!
          present
          items
          (struct-get item var)
          (struct-get item ty))
        (compiler-reg-types-from-list-fill! (box-get rest) present items))]))

(define (compiler-reg-var-types-from-list
  [types : CompilerRegVarTypeList]
  [vars : i64]) : CompilerRegVarTypes
  (let
    [present : (Array i64) (array.make-array i64 vars)]
    [items : (Array AstType) (array.make-array AstType vars)]
    (begin
      (compiler-reg-types-from-list-fill! types present items)
      (CompilerRegVarTypes present items))))

;; Generic constrained scratch-plan construction.  These builders attach the
;; deterministic instruction/ordinal identity, interval, and physical-home policy.
(defenum CompilerRegScratchFillState
  (State i64 i64))

(defstruct CompilerRegScratchPolicy
  (call-allowed CompilerRegIdList)
  (tail-call-allowed CompilerRegIdList)
  (gp-allowed CompilerRegIdList)
  (phi-excluded CompilerRegIdList))

(define (compiler-reg-scratch-call-target-excluded) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-rax
    (compiler-reg-id-cons
      compiler-reg-id-rcx
      (compiler-reg-id-cons
        compiler-reg-id-rdx
        (compiler-reg-id-cons
          compiler-reg-id-r8
          (compiler-reg-id-cons
            compiler-reg-id-r9
            (compiler-reg-id-cons
              compiler-reg-id-rdi
              (compiler-reg-id-cons
                compiler-reg-id-rsi
                (compiler-reg-id-cons compiler-reg-id-r11 CompilerRegIdList.Nil)))))))))

(define (compiler-reg-scratch-used-registers
  [assignments : CompilerRegAssignmentList]
  [regs : CompilerRegIdList]) : CompilerRegIdList
  (match regs
    [(CompilerRegIdList.Nil) CompilerRegIdList.Nil]
    [(CompilerRegIdList.Cons reg rest)
      (if (compiler-reg-assignments-use-register? assignments reg)
        (compiler-reg-id-cons
          reg
          (compiler-reg-scratch-used-registers assignments (box-get rest)))
        (compiler-reg-scratch-used-registers assignments (box-get rest)))]))

(define (compiler-reg-scratch-call-target-allowed
  [abi : CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentList]
  [tail? : bool]) : CompilerRegIdList
  ;; %r10 is the legacy preferred target scratch.  A non-tail call may also use
  ;; a callee-saved register already present in the function plan (and therefore
  ;; already preserved by the prologue); never introduce a save solely for a
  ;; scratch slot.  Tail jumps restore those homes before jumping, so they are
  ;; restricted to %r10.
  (compiler-reg-id-cons
    compiler-reg-id-r10
    (if tail?
      CompilerRegIdList.Nil
      (compiler-reg-scratch-used-registers
        assignments
        (compiler-reg-callee-saved-integer-registers-for-abi abi)))))

(define (compiler-reg-scratch-policy
  [abi : CompilerRegTargetAbi]
  [assignments : CompilerRegAssignmentList]
  [phi-excluded : CompilerRegIdList]) : CompilerRegScratchPolicy
  (CompilerRegScratchPolicy
    (compiler-reg-scratch-call-target-allowed abi assignments false)
    (compiler-reg-scratch-call-target-allowed abi assignments true)
    (compiler-reg-id-cons
      compiler-reg-id-r8
      (compiler-reg-id-cons
        compiler-reg-id-r9
        (compiler-reg-id-cons
          compiler-reg-id-r10
          (compiler-reg-id-cons
            compiler-reg-id-r11
            (compiler-reg-scratch-used-registers
              assignments
              (compiler-reg-callee-saved-integer-registers-for-abi abi))))))
    phi-excluded))

(define (compiler-reg-scratch-call-target-constraint
  [allowed : CompilerRegIdList]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    allowed
    (compiler-reg-scratch-call-target-excluded)
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-gp-constraint-excluding
  [excluded : CompilerRegIdList]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    CompilerRegIdList.Nil
    excluded
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-call-stage-constraint
  [policy : CompilerRegScratchPolicy]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    (struct-get policy call-allowed)
    (compiler-reg-scratch-call-target-excluded)
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-location-registers
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : CompilerRegIdList
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register reg)
          (compiler-reg-id-cons reg CompilerRegIdList.Nil)]
        [(CompilerRegLocation.RegisterPair lo hi)
          (compiler-reg-id-cons
            lo
            (compiler-reg-id-cons hi CompilerRegIdList.Nil))]
        [_ CompilerRegIdList.Nil])]
    [(CompilerRegMaybeLocation.No) CompilerRegIdList.Nil]))

(define (compiler-reg-scratch-value-registers
  [assignments : CompilerRegAssignmentList]
  [value : CompilerIrValue]) : CompilerRegIdList
  (match value
    [(CompilerIrValue.Var var)
      (compiler-reg-scratch-location-registers assignments var)]
    [_ CompilerRegIdList.Nil]))

(define (compiler-reg-scratch-instr-registers
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]) : CompilerRegIdList
  (match instr
    [(CompilerIrInstr.AddrOf dst src)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-location-registers assignments src))]
    [(CompilerIrInstr.Gep dst base offset _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-list-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-scratch-value-registers assignments offset)))]
    [(CompilerIrInstr.Load dst src _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.StorePtr dst src _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-value-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-value-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.Pack dst words _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-pack-registers assignments words))]
    [(CompilerIrInstr.Word dst src _ _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-value-registers assignments index)
        (compiler-reg-scratch-value-registers assignments length))]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [source (struct-get (box-get payload-box) source)]
        [selector-low (struct-get (box-get payload-box) selector-low)]
        [selector-high (struct-get (box-get payload-box) selector-high)]
        [active-lanes (struct-get (box-get payload-box) active-lanes)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments source)
            (compiler-reg-id-list-append
              (compiler-reg-scratch-value-registers assignments selector-low)
              (compiler-reg-id-list-append
                (match selector-high
                  [(CompilerIrMaybeValue.Some value)
                    (compiler-reg-scratch-value-registers assignments value)]
                  [(CompilerIrMaybeValue.No) CompilerRegIdList.Nil])
                (compiler-reg-scratch-value-registers assignments active-lanes))))))]
    [(CompilerIrInstr.BinOp dst _ lhs rhs _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-list-append
          (compiler-reg-scratch-value-registers assignments lhs)
          (compiler-reg-scratch-value-registers assignments rhs)))]
    [(CompilerIrInstr.UnOp dst _ src _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.Branch cond _ _)
      (compiler-reg-scratch-value-registers assignments cond)]
    [(CompilerIrInstr.CpuId dst leaf subleaf _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-list-append
          (compiler-reg-scratch-value-registers assignments leaf)
          (compiler-reg-scratch-value-registers assignments subleaf)))]
    [(CompilerIrInstr.Switch index _ _ _)
      (compiler-reg-scratch-value-registers assignments index)]
    [(CompilerIrInstr.Store _ value _)
      (compiler-reg-scratch-value-registers assignments value)]
    [(CompilerIrInstr.Cast dst src _ _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.Bitcast dst src _ _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.Mov dst src _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.Splat dst value _ _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments value))]
    [(CompilerIrInstr.VectorLoad dst base index _ _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-id-list-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-scratch-value-registers assignments index)))]
    [(CompilerIrInstr.VectorStore payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [value (struct-get (box-get payload-box) value)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments index)
            (compiler-reg-scratch-value-registers assignments value))))]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [value (struct-get (box-get payload-box) value)]
        [mask (struct-get (box-get payload-box) mask)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-value-registers assignments base)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments index)
            (compiler-reg-id-list-append
              (compiler-reg-scratch-value-registers assignments value)
              (compiler-reg-scratch-value-registers assignments mask)))))]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [base (struct-get (box-get payload-box) base)]
        [index (struct-get (box-get payload-box) index)]
        [mask (struct-get (box-get payload-box) mask)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments base)
            (compiler-reg-id-list-append
              (compiler-reg-scratch-value-registers assignments index)
              (compiler-reg-scratch-value-registers assignments mask)))))]
    [(CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [base (struct-get (box-get payload-box) base)]
        [index-base (struct-get (box-get payload-box) index-base)]
        [index (struct-get (box-get payload-box) index)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments base)
            (compiler-reg-id-list-append
              (compiler-reg-scratch-value-registers assignments index-base)
              (compiler-reg-scratch-value-registers assignments index)))))]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [lhs (struct-get (box-get payload-box) lhs)]
        [rhs (struct-get (box-get payload-box) rhs)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments lhs)
            (compiler-reg-scratch-value-registers assignments rhs))))]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [src (struct-get (box-get payload-box) src)]
        [carry (struct-get (box-get payload-box) carry)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments src)
            (compiler-reg-scratch-value-registers assignments carry))))]
    [(CompilerIrInstr.VectorReduce dst _ src _ _)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-location-registers assignments dst)
        (compiler-reg-scratch-value-registers assignments src))]
    [(CompilerIrInstr.Select payload-box)
      (let
        [dst (struct-get (box-get payload-box) dst)]
        [mask (struct-get (box-get payload-box) mask)]
        [on-true (struct-get (box-get payload-box) on-true)]
        [on-false (struct-get (box-get payload-box) on-false)]
        (compiler-reg-id-list-append
          (compiler-reg-scratch-location-registers assignments dst)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-value-registers assignments mask)
            (compiler-reg-id-list-append
              (compiler-reg-scratch-value-registers assignments on-true)
              (compiler-reg-scratch-value-registers assignments on-false)))))]
    [_ CompilerRegIdList.Nil]))

(define (compiler-reg-scratch-memory-constraint
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]) : CompilerRegScratchConstraint
  (compiler-reg-scratch-gp-constraint-excluding
    (compiler-reg-scratch-instr-registers assignments instr)))

(define (compiler-reg-scratch-xmm-constraint
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Xmm)
    CompilerRegIdList.Nil
    (compiler-reg-scratch-instr-registers assignments instr)
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-aggregate-constraint
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]
  [sse? : bool]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (if sse?
      (CompilerRegScratchClass.Xmm)
      (CompilerRegScratchClass.Gp))
    (if sse?
      CompilerRegIdList.Nil
      (struct-get policy gp-allowed))
    (compiler-reg-scratch-instr-registers assignments instr)
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-pack-registers
  [assignments : CompilerRegAssignmentList]
  [words : CompilerIrValueList]) : CompilerRegIdList
  (match words
    [(CompilerIrValueList.Nil) CompilerRegIdList.Nil]
    [(CompilerIrValueList.Cons word rest)
      (compiler-reg-id-list-append
        (compiler-reg-scratch-value-registers assignments word)
        (compiler-reg-scratch-pack-registers assignments (box-get rest)))]
    [(CompilerIrValueList.Array seq)
      (compiler-reg-scratch-pack-registers
        assignments
        (compiler-ir-value-seq-to-list seq))]))

(define (compiler-reg-scratch-phi-constraint
  [policy : CompilerRegScratchPolicy]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    (struct-get policy gp-allowed)
    (struct-get policy phi-excluded)
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-phi-xmm-constraint
  [policy : CompilerRegScratchPolicy]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Xmm)
    CompilerRegIdList.Nil
    (struct-get policy phi-excluded)
    compiler-reg-id-invalid))

(define (compiler-reg-scratch-switch-constraint
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]) : CompilerRegScratchConstraint
  (compiler-reg-scratch-gp-constraint-excluding
    (compiler-reg-id-list-append
      (struct-get policy phi-excluded)
      (compiler-reg-scratch-instr-registers assignments instr))))

(define (compiler-reg-scratch-fixed-constraint
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]
  [reg : i64]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Gp)
    CompilerRegIdList.Nil
    (compiler-reg-scratch-instr-registers assignments instr)
    reg))

(define (compiler-reg-scratch-fixed-xmm-constraint
  [_assignments : CompilerRegAssignmentList]
  [_instr : CompilerIrInstr]
  [reg : i64]) : CompilerRegScratchConstraint
  (CompilerRegScratchConstraint
    (CompilerRegScratchClass.Xmm)
    CompilerRegIdList.Nil
    CompilerRegIdList.Nil
    reg))

(define (compiler-reg-scratch-scalar-constraint
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]
  [extra : CompilerRegIdList]) : CompilerRegScratchConstraint
  (compiler-reg-scratch-gp-constraint-excluding
    (compiler-reg-id-list-append
      extra
      (compiler-reg-scratch-instr-registers assignments instr))))

(define (compiler-reg-scratch-div-fixed-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-rax
    (compiler-reg-id-cons compiler-reg-id-rdx CompilerRegIdList.Nil)))

(define (compiler-reg-scratch-cpuid-fixed-registers) : CompilerRegIdList
  (compiler-reg-id-cons
    compiler-reg-id-rax
    (compiler-reg-id-cons
      compiler-reg-id-rbx
      (compiler-reg-id-cons
        compiler-reg-id-rcx
        (compiler-reg-id-cons compiler-reg-id-rdx CompilerRegIdList.Nil)))))

;; Phi copies execute on predecessor edges, before the merge block's phi
;; destinations become live.  Exclude every phi destination home in the
;; function from both edge scratch slots; source homes already interfere at the
;; predecessor terminator point.  The function-wide union is conservative but
;; also covers fused terminators without rebuilding edge-specific liveness.
(define (compiler-reg-scratch-phi-dst-registers-instr
  [assignments : CompilerRegAssignmentList]
  [instr : CompilerIrInstr]) : CompilerRegIdList
  (match instr
    [(CompilerIrInstr.Phi dst _ _)
      (compiler-reg-scratch-location-registers assignments dst)]
    [_ CompilerRegIdList.Nil]))

(define (compiler-reg-scratch-seq-starts-with-phi?
  [instrs : CompilerIrInstrSeq]) : bool
  (if (= (compiler-ir-instr-seq-count instrs) 0)
    false
    (match (compiler-ir-instr-seq-ref instrs 0)
      [(CompilerIrInstr.Phi _ _ _) true]
      [_ false])))

(define (compiler-reg-scratch-phi-targets-block-seq-from
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : CompilerRegLabelList
  (if (>= index (compiler-ir-block-seq-count blocks))
    CompilerRegLabelList.Nil
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label instrs)
        (let
          [tail : CompilerRegLabelList
            (compiler-reg-scratch-phi-targets-block-seq-from blocks (+ index 1))]
          (if (compiler-reg-scratch-seq-starts-with-phi? instrs)
            (CompilerRegLabelList.Cons label (box tail))
            tail))])))

(define (compiler-reg-scratch-phi-targets-blocks [blocks : CompilerIrBlockList]) : CompilerRegLabelList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerRegLabelList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [tail : CompilerRegLabelList
              (compiler-reg-scratch-phi-targets-blocks (box-get rest))]
            (if (compiler-reg-scratch-seq-starts-with-phi? instrs)
              (CompilerRegLabelList.Cons label (box tail))
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-scratch-phi-targets-block-seq-from seq 0)]))

(define (compiler-reg-scratch-seq-has-float-phi-from?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.Phi _ _ ty)
        (or
          (compiler-reg-float-type? ty)
          (compiler-reg-scratch-seq-has-float-phi-from? instrs (+ index 1)))]
      [_ false])))

(define (compiler-reg-scratch-phi-xmm-targets-block-seq-from
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : CompilerRegLabelList
  (if (>= index (compiler-ir-block-seq-count blocks))
    CompilerRegLabelList.Nil
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label instrs)
        (let
          [tail : CompilerRegLabelList
            (compiler-reg-scratch-phi-xmm-targets-block-seq-from
              blocks
              (+ index 1))]
          (if (compiler-reg-scratch-seq-has-float-phi-from? instrs 0)
            (CompilerRegLabelList.Cons label (box tail))
            tail))])))

(define (compiler-reg-scratch-phi-xmm-targets-blocks
  [blocks : CompilerIrBlockList]) : CompilerRegLabelList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerRegLabelList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [tail : CompilerRegLabelList
              (compiler-reg-scratch-phi-xmm-targets-blocks (box-get rest))]
            (if (compiler-reg-scratch-seq-has-float-phi-from? instrs 0)
              (CompilerRegLabelList.Cons label (box tail))
              tail))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-scratch-phi-xmm-targets-block-seq-from seq 0)]))

(define (compiler-reg-scratch-phi-dst-registers-seq-from
  [assignments : CompilerRegAssignmentList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : CompilerRegIdList
  (if (>= index (compiler-ir-instr-seq-count instrs))
    CompilerRegIdList.Nil
    (compiler-reg-id-list-append
      (compiler-reg-scratch-phi-dst-registers-instr
        assignments
        (compiler-ir-instr-seq-ref instrs index))
      (compiler-reg-scratch-phi-dst-registers-seq-from
        assignments
        instrs
        (+ index 1)))))

(define (compiler-reg-scratch-phi-dst-registers-block-seq-from
  [assignments : CompilerRegAssignmentList]
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : CompilerRegIdList
  (if (>= index (compiler-ir-block-seq-count blocks))
    CompilerRegIdList.Nil
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block _ instrs)
        (compiler-reg-id-list-append
          (compiler-reg-scratch-phi-dst-registers-seq-from assignments instrs 0)
          (compiler-reg-scratch-phi-dst-registers-block-seq-from
            assignments
            blocks
            (+ index 1)))])))

(define (compiler-reg-scratch-phi-dst-registers-blocks
  [assignments : CompilerRegAssignmentList]
  [blocks : CompilerIrBlockList]) : CompilerRegIdList
  (match blocks
    [(CompilerIrBlockList.Nil) CompilerRegIdList.Nil]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-reg-id-list-append
            (compiler-reg-scratch-phi-dst-registers-seq-from
              assignments
              instrs
              0)
            (compiler-reg-scratch-phi-dst-registers-blocks
              assignments
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-scratch-phi-dst-registers-block-seq-from assignments seq 0)]))

(define (compiler-reg-scratch-requirement-local
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [var-types : CompilerRegVarTypeList]
  [instr : CompilerIrInstr]
  [point : i64]
  [ordinal : i64]
  [var : i64]
  [binop-return : bool]) : CompilerRegScratchRequirement
  (match instr
    [(CompilerIrInstr.Call _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.CallStage)
          (CompilerRegScratchRole.CallMemoryXmm))
        (if (= ordinal 0)
          (compiler-reg-scratch-call-stage-constraint policy)
          (compiler-reg-scratch-xmm-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.CallIndirect _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.CallTarget)
          (CompilerRegScratchRole.CallStage))
        (if (= ordinal 0)
          (compiler-reg-scratch-call-target-constraint
            (struct-get policy call-allowed))
          (compiler-reg-scratch-call-stage-constraint policy))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.CallIndirectC _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CallTarget)]
          [(= ordinal 1) (CompilerRegScratchRole.CallStage)]
          [else (CompilerRegScratchRole.CallMemoryXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-call-target-constraint
              (struct-get policy call-allowed))]
          [(= ordinal 1) (compiler-reg-scratch-call-stage-constraint policy)]
          [else (compiler-reg-scratch-xmm-constraint assignments instr)])
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.CallCAbiStoreResult _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CallTarget)]
          [(= ordinal 1) (CompilerRegScratchRole.CallStage)]
          [else (CompilerRegScratchRole.CallMemoryXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-call-target-constraint
              (struct-get policy call-allowed))]
          [(= ordinal 1) (compiler-reg-scratch-call-stage-constraint policy)]
          [else (compiler-reg-scratch-xmm-constraint assignments instr)])
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CallTarget)]
          [(= ordinal 1) (CompilerRegScratchRole.CallStage)]
          [else (CompilerRegScratchRole.CallMemoryXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-call-target-constraint
              (struct-get policy call-allowed))]
          [(= ordinal 1) (compiler-reg-scratch-call-stage-constraint policy)]
          [else (compiler-reg-scratch-xmm-constraint assignments instr)])
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.TailCallIndirect _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.CallTarget)
          (CompilerRegScratchRole.CallStage))
        (if (= ordinal 0)
          (compiler-reg-scratch-call-target-constraint
            (struct-get policy tail-call-allowed))
          (compiler-reg-scratch-call-stage-constraint policy))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.TailCall _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.CallStage)
        (compiler-reg-scratch-call-stage-constraint policy)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Pack _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.AggregateWord)
        (compiler-reg-scratch-aggregate-constraint
          policy
          assignments
          instr
          (compiler-reg-type-register-group-word-sse?
            type-segment-bases
            ty
            ordinal))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Word _ _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.AggregateWord)
        (compiler-reg-scratch-aggregate-constraint
          policy
          assignments
          instr
          (compiler-reg-float-type? ty))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Jump _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.PhiCycle)]
          [(= ordinal 1) (CompilerRegScratchRole.PhiStage)]
          [else (CompilerRegScratchRole.PhiCycleXmm)])
        (if (= ordinal 2)
          (compiler-reg-scratch-phi-xmm-constraint policy)
          (compiler-reg-scratch-phi-constraint policy))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (if (compiler-reg-scratch-float-binop? var-types lhs rhs ty)
        (let
          [compare? : bool (compiler-reg-scratch-compare-op? op)]
          [fallback? : bool
            (and
              compare?
              (compiler-reg-scratch-float-compare-fallback? assignments lhs rhs))]
          [rhs-temp? : bool
            (and
              fallback?
              (not
                (compiler-reg-scratch-float-rhs-direct?
                  assignments
                  rhs
                  compiler-reg-id-invalid)))]
          [role : CompilerRegScratchRole
            (cond
              [(and binop-return compare? (= ordinal 0))
                (CompilerRegScratchRole.FloatReturnResultGp)]
              [(and binop-return compare? (= ordinal 1))
                (CompilerRegScratchRole.FloatCompareLhsXmm)]
              [(and binop-return compare?)
                (CompilerRegScratchRole.FloatCompareRhsXmm)]
              [(and binop-return (= ordinal 0))
                (CompilerRegScratchRole.FloatReturnResultXmm)]
              [binop-return (CompilerRegScratchRole.FloatArithmeticRhsXmm)]
              [(and compare? fallback? (= ordinal 0))
                (CompilerRegScratchRole.FloatCompareLhsXmm)]
              [(and compare? rhs-temp? (= ordinal 1))
                (CompilerRegScratchRole.FloatCompareRhsXmm)]
              [compare? (CompilerRegScratchRole.FloatCompareResultGp)]
              [(= ordinal 0) (CompilerRegScratchRole.FloatArithmeticResultXmm)]
              [else (CompilerRegScratchRole.FloatArithmeticRhsXmm)])]
          [constraint : CompilerRegScratchConstraint
            (match role
              [(CompilerRegScratchRole.FloatReturnResultGp)
                (CompilerRegScratchConstraint
                  (CompilerRegScratchClass.Gp)
                  CompilerRegIdList.Nil
                  CompilerRegIdList.Nil
                  compiler-reg-id-rax)]
              [(CompilerRegScratchRole.FloatReturnResultXmm)
                (compiler-reg-scratch-fixed-xmm-constraint
                  assignments
                  instr
                  (compiler-abi-xmm-register-id 0))]
              [(CompilerRegScratchRole.FloatCompareResultGp)
                (compiler-reg-scratch-scalar-constraint
                  assignments
                  instr
                  CompilerRegIdList.Nil)]
              [_ (compiler-reg-scratch-xmm-constraint assignments instr)])]
          (CompilerRegScratchRequirement
            point
            ordinal
            role
            constraint
            point
            (+ point 1)
            var))
        (let
          [div? : bool (compiler-reg-clobber-binop-div? op)]
          [shift? : bool
            (match instr
              [(CompilerIrInstr.BinOp _ shift-op _ rhs ty)
                (compiler-reg-clobber-binop-shift? shift-op rhs ty)]
              [_ false])]
          [role : CompilerRegScratchRole
            (cond
              [div?
                (cond
                  [(= ordinal 0) (CompilerRegScratchRole.FixedRax)]
                  [(= ordinal 1) (CompilerRegScratchRole.FixedRdx)]
                  [(= ordinal 2) (CompilerRegScratchRole.ScalarPrimary)]
                  [(= ordinal 3) (CompilerRegScratchRole.ScalarSecondary)]
                  [else (CompilerRegScratchRole.ScalarTertiary)])]
              [(and shift? (= ordinal 0)) (CompilerRegScratchRole.FixedRcx)]
              [(= ordinal 0) (CompilerRegScratchRole.ScalarPrimary)]
              [else (CompilerRegScratchRole.ScalarSecondary)])]
          [constraint : CompilerRegScratchConstraint
            (cond
              [(and div? (= ordinal 0))
                (compiler-reg-scratch-fixed-constraint
                  assignments
                  instr
                  compiler-reg-id-rax)]
              [(and div? (= ordinal 1))
                (compiler-reg-scratch-fixed-constraint
                  assignments
                  instr
                  compiler-reg-id-rdx)]
              [(and shift? (= ordinal 0))
                (compiler-reg-scratch-fixed-constraint
                  assignments
                  instr
                  compiler-reg-id-rcx)]
              [else
                (compiler-reg-scratch-scalar-constraint
                  assignments
                  instr
                  (cond
                    [div? (compiler-reg-scratch-div-fixed-registers)]
                    [shift?
                      (compiler-reg-id-cons
                        compiler-reg-id-rcx
                        CompilerRegIdList.Nil)]
                    [else CompilerRegIdList.Nil]))])]
          (CompilerRegScratchRequirement
            point
            ordinal
            role
            constraint
            point
            ;; A compare can fuse through the following Branch. Its operand
            ;; homes end at this IR point, so keep the planned homes live through
            ;; that successor point and explicitly exclude those operands above.
            (if (compiler-reg-clobber-binop-div? op)
              (+ point 1)
              (if (compiler-ir-binop-compare? op)
                (+ point 3)
                (+ point 1)))
            var)))]
    [(CompilerIrInstr.UnOp _ _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (compiler-reg-float-type? ty)
          (CompilerRegScratchRole.FloatUnaryResultXmm)
          (CompilerRegScratchRole.ScalarPrimary))
        (if (compiler-reg-float-type? ty)
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-scalar-constraint
            assignments
            instr
            CompilerRegIdList.Nil))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.CpuId _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.CpuIdSave)
        (compiler-reg-scratch-scalar-constraint
          assignments
          instr
          (compiler-reg-scratch-cpuid-fixed-registers))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Branch _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.BranchTest)]
          [(= ordinal 1) (CompilerRegScratchRole.PhiCycle)]
          [(= ordinal 2) (CompilerRegScratchRole.PhiStage)]
          [else (CompilerRegScratchRole.PhiCycleXmm)])
        (cond
          [(= ordinal 0)
            (compiler-reg-scratch-scalar-constraint
              assignments
              instr
              CompilerRegIdList.Nil)]
          [(= ordinal 3) (compiler-reg-scratch-phi-xmm-constraint policy)]
          [else (compiler-reg-scratch-phi-constraint policy)])
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Switch _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SwitchIndex)
          (CompilerRegScratchRole.SwitchTable))
        (compiler-reg-scratch-switch-constraint policy assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.BoundsCheck _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.BoundsLength)
          (CompilerRegScratchRole.BoundsIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.VectorShuffle _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.ShuffleActive)
          (CompilerRegScratchRole.ShuffleSelector))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.AddrOf _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.MemoryAddress)
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Gep _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.MemoryAddress)
          (CompilerRegScratchRole.MemoryIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        ;; A fused GEP+memory consumer reads these homes at the following
        ;; instruction point. Keep both siblings live through that point.
        (+ point 3)
        var)]
    [(CompilerIrInstr.Load _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.MemoryAddress)
          (if (compiler-reg-float-type? ty)
            (CompilerRegScratchRole.FloatMemoryValueXmm)
            (CompilerRegScratchRole.MemoryValue)))
        (if (and (> ordinal 0) (compiler-reg-float-type? ty))
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.StorePtr _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.MemoryAddress)
          (if (compiler-reg-float-type? ty)
            (CompilerRegScratchRole.FloatMemoryValueXmm)
            (CompilerRegScratchRole.MemoryValue)))
        (if (and (> ordinal 0) (compiler-reg-float-type? ty))
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.CopyBytes _ _ size)
      (CompilerRegScratchRequirement
        point
        ordinal
        (cond
          [(= ordinal 0) (CompilerRegScratchRole.CopyDst)]
          [(= ordinal 1) (CompilerRegScratchRole.CopySrc)]
          [(and (= ordinal 2) (>= size 16))
            (CompilerRegScratchRole.CopyValueXmm)]
          [else (CompilerRegScratchRole.CopyValue)])
        (if (and (= ordinal 2) (>= size 16))
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Store _ _ ty)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (compiler-reg-float-type? ty)
          (CompilerRegScratchRole.FloatMemoryValueXmm)
          (CompilerRegScratchRole.MemoryValue))
        (if (compiler-reg-float-type? ty)
          (compiler-reg-scratch-xmm-constraint assignments instr)
          (compiler-reg-scratch-memory-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Cast dst src from-ty to-ty)
      (let
        [xmm? : bool
          (compiler-reg-scratch-cast-xmm-needed?
            assignments
            dst
            src
            from-ty
            to-ty)]
        [gp-ordinal : i64
          (-
            ordinal
            (if xmm?
              1
              0))]
        (CompilerRegScratchRequirement
          point
          ordinal
          (if (and xmm? (= ordinal 0))
            (CompilerRegScratchRole.FloatCastValueXmm)
            (if (= gp-ordinal 0)
              (CompilerRegScratchRole.FloatCastValueGp)
              (CompilerRegScratchRole.FloatCastScratchGp)))
          (if (and xmm? (= ordinal 0))
            (compiler-reg-scratch-xmm-constraint assignments instr)
            (compiler-reg-scratch-memory-constraint assignments instr))
          point
          (+ point 1)
          var))]
    [(CompilerIrInstr.Bitcast dst src from-ty to-ty)
      (let
        [xmm? : bool
          (compiler-reg-scratch-bitcast-xmm-needed?
            assignments
            dst
            src
            from-ty
            to-ty)]
        (CompilerRegScratchRequirement
          point
          ordinal
          (if (and xmm? (= ordinal 0))
            (CompilerRegScratchRole.FloatBitcastValueXmm)
            (CompilerRegScratchRole.FloatBitcastValueGp))
          (if (and xmm? (= ordinal 0))
            (compiler-reg-scratch-xmm-constraint assignments instr)
            (compiler-reg-scratch-memory-constraint assignments instr))
          point
          (+ point 1)
          var))]
    [(CompilerIrInstr.Mov _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.FloatMoveValueXmm)
        (compiler-reg-scratch-xmm-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Splat _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SplatValueGp)
          (CompilerRegScratchRole.SplatValueXmm))
        (if (= ordinal 0)
          (compiler-reg-scratch-memory-constraint assignments instr)
          (compiler-reg-scratch-xmm-constraint assignments instr))
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.VectorLoad _ _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.VectorStore _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.PredicatedStore _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.PredicatedLoad _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.GatherLoad _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.SimdAddressBase)
          (CompilerRegScratchRole.SimdAddressIndex))
        (compiler-reg-scratch-memory-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (let
        [lanes (struct-get (box-get payload-box) lanes)]
        [elem-ty (struct-get (box-get payload-box) ty)]
        [avx512-bool? : bool
          (match elem-ty
            [(AstType.Bool) (> lanes 32)]
            [_ false])]
        (CompilerRegScratchRequirement
          point
          ordinal
          (cond
            [(= ordinal 0) (CompilerRegScratchRole.VectorPrefixCarry)]
            [avx512-bool? (CompilerRegScratchRole.VectorPrefixBits)]
            [(= ordinal 1) (CompilerRegScratchRole.VectorPrefixValue)]
            [(= ordinal 2) (CompilerRegScratchRole.VectorPrefixWork0)]
            [else (CompilerRegScratchRole.VectorPrefixWork1)])
          (if (or (= ordinal 0) avx512-bool?)
            (compiler-reg-scratch-memory-constraint assignments instr)
            (compiler-reg-scratch-xmm-constraint assignments instr))
          point
          (+ point 1)
          var))]
    [(CompilerIrInstr.VectorReduce _ _ _ _ _)
      (CompilerRegScratchRequirement
        point
        ordinal
        (if (= ordinal 0)
          (CompilerRegScratchRole.VectorReduceAccumulator)
          (CompilerRegScratchRole.VectorReduceScratch))
        (compiler-reg-scratch-xmm-constraint assignments instr)
        point
        (+ point 1)
        var)]
    [(CompilerIrInstr.Select payload-box)
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.ScalarPrimary)
        (compiler-reg-scratch-scalar-constraint
          assignments
          instr
          CompilerRegIdList.Nil)
        point
        (+ point 1)
        var)]
    [_
      ;; Unreachable for a non-zero slot count, but keep a total constructor so
      ;; future role additions fail safely to an unassigned GP requirement.
      (CompilerRegScratchRequirement
        point
        ordinal
        (CompilerRegScratchRole.BoundsLength)
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Gp)
          CompilerRegIdList.Nil
          (compiler-reg-greedy-integer-pool-for-abi abi)
          compiler-reg-id-invalid)
        point
        (+ point 1)
        var)]))

;; Fused backend emission can consume scratch slots from several consecutive IR
;; instructions as one atomic group.  Give every slot in that group the same
;; reservation interval and the union of every consumed instruction's homes.
;; This keeps a later sibling result home from aliasing an earlier planned
;; scratch register even when ordinary IR liveness ends at the sibling point.
(define (compiler-reg-scratch-requirement
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [var-types : CompilerRegVarTypeList]
  [instr : CompilerIrInstr]
  [point : i64]
  [ordinal : i64]
  [var : i64]
  [binop-return : bool]
  [group-lo : i64]
  [group-hi : i64]
  [group-excluded : CompilerRegIdList]) : CompilerRegScratchRequirement
  (let
    [local : CompilerRegScratchRequirement
      (compiler-reg-scratch-requirement-local
        type-segment-bases
        abi
        policy
        assignments
        var-types
        instr
        point
        ordinal
        var
        binop-return)]
    [constraint : CompilerRegScratchConstraint (struct-get local constraint)]
    (CompilerRegScratchRequirement
      (struct-get local point)
      (struct-get local ordinal)
      (struct-get local role)
      (CompilerRegScratchConstraint
        (struct-get constraint register-class)
        (struct-get constraint allowed)
        (match (struct-get local role)
          [(CompilerRegScratchRole.FloatReturnResultXmm)
            (struct-get constraint excluded)]
          [(CompilerRegScratchRole.FloatReturnResultGp)
            (struct-get constraint excluded)]
          [_
            (compiler-reg-id-list-append
              group-excluded
              (struct-get constraint excluded))])
        (struct-get constraint fixed))
      group-lo
      group-hi
      (struct-get local var))))

(define (compiler-reg-scratch-mark-requirement!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]
  [requirement : CompilerRegScratchRequirement]) : unit
  (let
    [var : i64 (struct-get requirement var)]
    [lo : i64 (struct-get requirement lo)]
    [hi : i64 (struct-get requirement hi)]
    (if (or (< var 0) (>= var (array-length starts)))
      unit
      (begin
        (array-set! starts var lo)
        (array-set! ends var hi)
        (array-set!
          segments
          var
          (compiler-reg-interval-seq-prepend
            (CompilerRegInterval var lo hi)
            (compiler-reg-interval-seq-empty)))
        (array-set! present var 1)
        (array-set!
          types
          var
          (match (struct-get (struct-get requirement constraint) register-class)
            [(CompilerRegScratchClass.Gp) (AstType.I64)]
            [(CompilerRegScratchClass.Xmm) (AstType.F64)]))))))

(define (compiler-reg-scratch-instr-gep? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Gep _ _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-load? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Load _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-store-ptr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.StorePtr _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-copy-bytes? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.CopyBytes _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-binop? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ _ _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-branch? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Branch _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-return? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Return _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-not? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.UnOp _ (CompilerIrUnOp.Not) _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-mov? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Mov _ _ _) true]
    [_ false]))

(define (compiler-reg-scratch-instr-jump? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Jump _) true]
    [_ false]))

(define (compiler-reg-scratch-group-init!
  [firsts : (Array i64)]
  [lasts : (Array i64)]
  [len : i64]) : unit
  (let
    [i : i64 0]
    (while (< i len)
      (begin
        (array-set! firsts i i)
        (array-set! lasts i i)
        (set! i (+ i 1))))))

;; Candidate fusion regions are discovered left-to-right.  Existing regions
;; may overlap the new candidate, so merge their complete bounds and publish
;; the resulting common span to every member.
(define (compiler-reg-scratch-group-merge!
  [firsts : (Array i64)]
  [lasts : (Array i64)]
  [start : i64]
  [end : i64]) : unit
  (let
    [lo : i64
      (if (< start (array-ref firsts start))
        start
        (array-ref firsts start))]
    [hi : i64
      (if (> end (array-ref lasts end))
        end
        (array-ref lasts end))]
    [i : i64 lo]
    (begin
      (while (<= i hi)
        (begin
          (if (< (array-ref firsts i) lo)
            (set! lo (array-ref firsts i))
            unit)
          (if (> (array-ref lasts i) hi)
            (set! hi (array-ref lasts i))
            unit)
          (set! i (+ i 1))))
      (set! i lo)
      (while (<= i hi)
        (begin
          (array-set! firsts i lo)
          (array-set! lasts i hi)
          (set! i (+ i 1)))))))

(defenum CompilerRegScratchFusionKind
  (Gep)
  (Load)
  (StorePtr)
  (CopyBytes)
  (BinOp)
  (Branch)
  (Return)
  (Not)
  (Mov)
  (Jump))

(define (compiler-reg-scratch-seq-instr?
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [kind : CompilerRegScratchFusionKind]) : bool
  (if (or (< index 0) (>= index (compiler-ir-instr-seq-count instrs)))
    false
    (let
      [instr : CompilerIrInstr (compiler-ir-instr-seq-ref instrs index)]
      (match kind
        [(CompilerRegScratchFusionKind.Gep)
          (compiler-reg-scratch-instr-gep? instr)]
        [(CompilerRegScratchFusionKind.Load)
          (compiler-reg-scratch-instr-load? instr)]
        [(CompilerRegScratchFusionKind.StorePtr)
          (compiler-reg-scratch-instr-store-ptr? instr)]
        [(CompilerRegScratchFusionKind.CopyBytes)
          (compiler-reg-scratch-instr-copy-bytes? instr)]
        [(CompilerRegScratchFusionKind.BinOp)
          (compiler-reg-scratch-instr-binop? instr)]
        [(CompilerRegScratchFusionKind.Branch)
          (compiler-reg-scratch-instr-branch? instr)]
        [(CompilerRegScratchFusionKind.Return)
          (compiler-reg-scratch-instr-return? instr)]
        [(CompilerRegScratchFusionKind.Not)
          (compiler-reg-scratch-instr-not? instr)]
        [(CompilerRegScratchFusionKind.Mov)
          (compiler-reg-scratch-instr-mov? instr)]
        [(CompilerRegScratchFusionKind.Jump)
          (compiler-reg-scratch-instr-jump? instr)]))))

(define (compiler-reg-scratch-seq-vector-load-binop?
  [instrs : CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 1) (compiler-ir-instr-seq-count instrs))
    false
    (match (compiler-ir-instr-seq-ref instrs index)
      [(CompilerIrInstr.VectorLoad _ _ _ _ _)
        (match (compiler-ir-instr-seq-ref instrs (+ index 1))
          [(CompilerIrInstr.VectorBinOp _) true]
          [_ false])]
      [_ false])))

;; Mirror every backend path that obtains another instruction's planned slot
;; with scratch-plan-register-ahead.  These syntactic candidates are slightly
;; conservative: the backend also checks uses/types before fusing, while the
;; planner safely reserves the group whenever the instruction shape could fuse.
(define (compiler-reg-scratch-fusion-groups!
  [instrs : CompilerIrInstrSeq]
  [firsts : (Array i64)]
  [lasts : (Array i64)]) : unit
  (let
    [len : i64 (compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    (begin
      (compiler-reg-scratch-group-init! firsts lasts len)
      (while (< i len)
        (begin
          (cond
            ;; A SIMD VectorLoad can fold into the following VectorBinOp. The
            ;; address temporaries remain live through the folded instruction,
            ;; whose result and register operand must also be excluded.
            [(compiler-reg-scratch-seq-vector-load-binop? instrs i)
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            ;; Gep+Load can grow into the paired aggregate load or into a
            ;; load/compare/branch bundle.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 3)
                  (CompilerRegScratchFusionKind.Load)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 3))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 3)
                  (CompilerRegScratchFusionKind.Branch)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 3))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.BinOp)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Mov))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Gep))
                (or
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.Load))
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.StorePtr))
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.CopyBytes))))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            ;; Pointer chasing emits two Loads as one unit.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Load)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Load))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.Branch)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            ;; StorePtr/Gep/StorePtr preserves the first store's sibling homes
            ;; while the second address and value are staged.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.StorePtr))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            ;; Compare/branch and not/branch share terminator scratch slots.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.BinOp))
                (or
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.Branch))
                  (compiler-reg-scratch-seq-instr?
                    instrs
                    (+ i 1)
                    (CompilerRegScratchFusionKind.Return))))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Not))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Branch)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.Mov))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Jump)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 1))]
            ;; Div/mod polish can consume a producer and a following fused
            ;; Gep+StorePtr in one emergency preservation region.
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 3)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 3))]
            [(and
                (compiler-reg-scratch-seq-instr?
                  instrs
                  i
                  (CompilerRegScratchFusionKind.BinOp))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 1)
                  (CompilerRegScratchFusionKind.Gep))
                (compiler-reg-scratch-seq-instr?
                  instrs
                  (+ i 2)
                  (CompilerRegScratchFusionKind.StorePtr)))
              (compiler-reg-scratch-group-merge! firsts lasts i (+ i 2))]
            [else unit])
          (set! i (+ i 1)))))))

(define (compiler-reg-scratch-group-registers-from
  [assignments : CompilerRegAssignmentList]
  [instrs : CompilerIrInstrSeq]
  [index : i64]
  [last : i64]) : CompilerRegIdList
  (if (> index last)
    CompilerRegIdList.Nil
    (compiler-reg-id-list-append
      (compiler-reg-scratch-instr-registers
        assignments
        (compiler-ir-instr-seq-ref instrs index))
      (compiler-reg-scratch-group-registers-from
        assignments
        instrs
        (+ index 1)
        last))))

(define (compiler-reg-scratch-fill-slots!
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [var-types : CompilerRegVarTypeList]
  [instr : CompilerIrInstr]
  [point : i64]
  [group-lo : i64]
  [group-hi : i64]
  [group-excluded : CompilerRegIdList]
  [scratch-base : i64]
  [item-start : i64]
  [slot : i64]
  [slot-count : i64]
  [binop-return : bool]
  [items : (Array CompilerRegScratchAssignment)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]) : unit
  (if (>= slot slot-count)
    unit
    (let
      [item-index : i64 (+ item-start slot)]
      [requirement : CompilerRegScratchRequirement
        (compiler-reg-scratch-requirement
          type-segment-bases
          abi
          policy
          assignments
          var-types
          instr
          point
          slot
          (+ scratch-base item-index)
          binop-return
          group-lo
          group-hi
          group-excluded)]
      (begin
        (array-set!
          items
          item-index
          (CompilerRegScratchAssignment requirement compiler-reg-id-invalid))
        (compiler-reg-scratch-mark-requirement!
          starts
          ends
          segments
          present
          types
          requirement)
        (compiler-reg-scratch-fill-slots!
          type-segment-bases
          abi
          policy
          assignments
          var-types
          instr
          point
          group-lo
          group-hi
          group-excluded
          scratch-base
          item-start
          (+ slot 1)
          slot-count
          binop-return
          items
          starts
          ends
          segments
          present
          types)))))

(define (compiler-reg-scratch-fill-seq!
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [var-types : CompilerRegVarTypeList]
  [instrs : CompilerIrInstrSeq]
  [phi-targets : CompilerRegLabelList]
  [phi-xmm-targets : CompilerRegLabelList]
  [instruction-start : i64]
  [item-start : i64]
  [scratch-base : i64]
  [items : (Array CompilerRegScratchAssignment)]
  [firsts : (Array i64)]
  [slot-counts : (Array i64)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]) : CompilerRegScratchFillState
  (let
    [instr-slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (struct-get instrs len)]
    [group-firsts : (Array i64) (array.make-array i64 len)]
    [group-lasts : (Array i64) (array.make-array i64 len)]
    [i : i64 0]
    [instruction : i64 instruction-start]
    [item : i64 item-start]
    (begin
      (compiler-reg-scratch-fusion-groups! instrs group-firsts group-lasts)
      (while (< i len)
        (let
          [instr : CompilerIrInstr (array-ref instr-slots i)]
          [group-first : i64 (array-ref group-firsts i)]
          [group-last : i64 (array-ref group-lasts i)]
          [group-excluded : CompilerRegIdList
            (compiler-reg-scratch-group-registers-from
              assignments
              instrs
              group-first
              group-last)]
          [n : i64
            (compiler-reg-scratch-vreg-slots
              type-segment-bases
              abi
              assignments
              var-types
              instr
              phi-targets
              phi-xmm-targets
              (compiler-reg-scratch-binop-return-next? instrs i))]
          (begin
            (array-set! firsts instruction item)
            (array-set! slot-counts instruction n)
            (compiler-reg-scratch-fill-slots!
              type-segment-bases
              abi
              policy
              assignments
              var-types
              instr
              (* 2 instruction)
              (* 2 (+ instruction-start group-first))
              (+ (* 2 (+ instruction-start group-last)) 1)
              group-excluded
              scratch-base
              item
              0
              n
              (compiler-reg-scratch-binop-return-next? instrs i)
              items
              starts
              ends
              segments
              present
              types)
            (set! item (+ item n))
            (set! instruction (+ instruction 1))
            (set! i (+ i 1)))))
      (CompilerRegScratchFillState.State instruction item))))

(define (compiler-reg-scratch-fill-blocks!
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignments : CompilerRegAssignmentList]
  [var-types : CompilerRegVarTypeList]
  [blocks : CompilerIrBlockList]
  [phi-targets : CompilerRegLabelList]
  [phi-xmm-targets : CompilerRegLabelList]
  [instruction-start : i64]
  [item-start : i64]
  [scratch-base : i64]
  [items : (Array CompilerRegScratchAssignment)]
  [firsts : (Array i64)]
  [slot-counts : (Array i64)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]) : CompilerRegScratchFillState
  (match blocks
    [(CompilerIrBlockList.Nil)
      (CompilerRegScratchFillState.State instruction-start item-start)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-scratch-fill-seq!
            type-segment-bases
            abi
            policy
            assignments
            var-types
            instrs
            phi-targets
            phi-xmm-targets
            instruction-start
            item-start
            scratch-base
            items
            firsts
            slot-counts
            starts
            ends
            segments
            present
            types)
            [(CompilerRegScratchFillState.State next-instruction next-item)
              (compiler-reg-scratch-fill-blocks!
                type-segment-bases
                abi
                policy
                assignments
                var-types
                (box-get rest)
                phi-targets
                phi-xmm-targets
                next-instruction
                next-item
                scratch-base
                items
                firsts
                slot-counts
                starts
                ends
                segments
                present
                types)])])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        [instruction : i64 instruction-start]
        [item : i64 item-start]
        (begin
          (while (< i count)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-scratch-fill-seq!
                    type-segment-bases
                    abi
                    policy
                    assignments
                    var-types
                    instrs
                    phi-targets
                    phi-xmm-targets
                    instruction
                    item
                    scratch-base
                    items
                    firsts
                    slot-counts
                    starts
                    ends
                    segments
                    present
                    types)
                    [(CompilerRegScratchFillState.State
                        next-instruction
                        next-item)
                      (begin
                        (set! instruction next-instruction)
                        (set! item next-item))])])
              (set! i (+ i 1))))
          (CompilerRegScratchFillState.State instruction item)))]))

;; Cycle 14's early model is deliberately narrower than the generic late
;; scratch planner: only scalar SafeDiv/SafeMod with an integer literal divisor
;; contributes worklist entries. BoundsCheck, Switch, variable divmod, ordinary
;; Div/Mod, and float operations remain late-only.
(define (compiler-reg-early-scratch-literal? [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.I64 _) true]
    [(CompilerIrValue.Bool _) true]
    [(CompilerIrValue.Char _) true]
    [_ false]))

(define (compiler-reg-early-scratch-target? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op _ rhs ty)
      (and
        (not (compiler-reg-float-type? ty))
        (match op
          [(CompilerIrBinOp.SafeDiv) true]
          [(CompilerIrBinOp.SafeMod) true]
          [_ false])
        (compiler-reg-early-scratch-literal? rhs))]
    [_ false]))

(define (compiler-reg-early-scratch-count-seq [instrs : CompilerIrInstrSeq]) : i64
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (struct-get instrs len)]
    [i : i64 0]
    [count : i64 0]
    (begin
      (while (< i len)
        (begin
          (if (compiler-reg-early-scratch-target? (array-ref slots i))
            ;; Reuse the generic divmod model's fixed width: rax, rdx, and
            ;; three simultaneous GP temporaries.
            (set! count (+ count 5))
            unit)
          (set! i (+ i 1))))
      count)))

(define (compiler-reg-early-scratch-count-blocks [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (+
            (compiler-reg-early-scratch-count-seq instrs)
            (compiler-reg-early-scratch-count-blocks (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [len : i64 (compiler-ir-block-seq-count seq)]
        [count : i64 0]
        (begin
          (while (< i len)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (set!
                    count
                    (+ count (compiler-reg-early-scratch-count-seq instrs)))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-early-scratch-expansion-requirement
  [requirement : CompilerRegScratchRequirement]) : CompilerRegScratchRequirement
  (let
    [point : i64 (struct-get requirement point)]
    ;; The allocator's half-open [point, point+1] instruction window covers the
    ;; complete atomic divmod expansion. Inputs whose final use is this BinOp end
    ;; at `point` and may therefore donate their register to the expansion; the
    ;; result and every value live through the instruction still overlap it.
    (CompilerRegScratchRequirement
      point
      (struct-get requirement ordinal)
      (struct-get requirement role)
      (struct-get requirement constraint)
      point
      (+ point 1)
      (struct-get requirement var))))

(define (compiler-reg-early-scratch-mark-one!
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignment-list : CompilerRegAssignmentList]
  [assignment-table : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypeList]
  [instr : CompilerIrInstr]
  [point : i64]
  [ordinal : i64]
  [var : i64]
  [binop-return : bool]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]
  [scratch-excluded : (Array CompilerRegIdList)]) : unit
  (let
    [requirement : CompilerRegScratchRequirement
      (compiler-reg-early-scratch-expansion-requirement
        (compiler-reg-scratch-requirement-local
          type-segment-bases
          abi
          policy
          assignment-list
          var-types
          instr
          point
          ordinal
          var
          binop-return))]
    [fixed : i64 (struct-get (struct-get requirement constraint) fixed)]
    (begin
      (compiler-reg-scratch-mark-requirement!
        starts
        ends
        segments
        present
        types
        requirement)
      (array-set!
        scratch-excluded
        var
        (struct-get (struct-get requirement constraint) excluded))
      (if (= fixed compiler-reg-id-invalid)
        unit
        (begin
          (compiler-reg-assignment-table-insert
            assignment-table
            var
            (CompilerRegLocation.Register fixed))
          unit)))))

(define (compiler-reg-early-scratch-fill-seq!
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignment-list : CompilerRegAssignmentList]
  [assignment-table : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypeList]
  [instrs : CompilerIrInstrSeq]
  [block-weight : i64]
  [instruction-start : i64]
  [scratch-start : i64]
  [scratch-base : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]
  [scratch-weights : (Array i64)]
  [scratch-excluded : (Array CompilerRegIdList)]) : CompilerRegScratchFillState
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [len : i64 (struct-get instrs len)]
    [i : i64 0]
    [instruction : i64 instruction-start]
    [scratch : i64 scratch-start]
    (begin
      (while (< i len)
        (let
          [instr : CompilerIrInstr (array-ref slots i)]
          (begin
            (if (compiler-reg-early-scratch-target? instr)
              (let
                [ordinal : i64 0]
                (begin
                  (while (< ordinal 5)
                    (begin
                      (compiler-reg-early-scratch-mark-one!
                        type-segment-bases
                        abi
                        policy
                        assignment-list
                        assignment-table
                        var-types
                        instr
                        (* 2 instruction)
                        ordinal
                        (+ scratch-base scratch ordinal)
                        (compiler-reg-scratch-binop-return-next? instrs i)
                        starts
                        ends
                        segments
                        present
                        types
                        scratch-excluded)
                      ;; Each non-fixed requirement contributes one demand
                      ;; occurrence at the expansion's loop depth.
                      (array-set!
                        scratch-weights
                        (+ scratch ordinal)
                        (if (>= ordinal 2)
                          block-weight
                          0))
                      (set! ordinal (+ ordinal 1))))
                  (set! scratch (+ scratch 5))))
              unit)
            (set! instruction (+ instruction 1))
            (set! i (+ i 1)))))
      (CompilerRegScratchFillState.State instruction scratch))))

(define (compiler-reg-early-scratch-fill-blocks!
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [policy : CompilerRegScratchPolicy]
  [assignment-list : CompilerRegAssignmentList]
  [assignment-table : CompilerRegAssignmentTable]
  [var-types : CompilerRegVarTypeList]
  [blocks : CompilerIrBlockList]
  [depths : (Array i64)]
  [block-index : i64]
  [instruction-start : i64]
  [scratch-start : i64]
  [scratch-base : i64]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [segments : (Array CompilerRegIntervalSeq)]
  [present : (Array i64)]
  [types : (Array AstType)]
  [scratch-weights : (Array i64)]
  [scratch-excluded : (Array CompilerRegIdList)]) : CompilerRegScratchFillState
  (match blocks
    [(CompilerIrBlockList.Nil)
      (CompilerRegScratchFillState.State instruction-start scratch-start)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-early-scratch-fill-seq!
            type-segment-bases
            abi
            policy
            assignment-list
            assignment-table
            var-types
            instrs
            (compiler-reg-loop-depth-weight (array-ref depths block-index))
            instruction-start
            scratch-start
            scratch-base
            starts
            ends
            segments
            present
            types
            scratch-weights
            scratch-excluded)
            [(CompilerRegScratchFillState.State next-instruction next-scratch)
              (compiler-reg-early-scratch-fill-blocks!
                type-segment-bases
                abi
                policy
                assignment-list
                assignment-table
                var-types
                (box-get rest)
                depths
                (+ block-index 1)
                next-instruction
                next-scratch
                scratch-base
                starts
                ends
                segments
                present
                types
                scratch-weights
                scratch-excluded)])])]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [len : i64 (compiler-ir-block-seq-count seq)]
        [instruction : i64 instruction-start]
        [scratch : i64 scratch-start]
        (begin
          (while (< i len)
            (begin
              (match (compiler-ir-block-seq-ref seq i)
                [(CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-early-scratch-fill-seq!
                    type-segment-bases
                    abi
                    policy
                    assignment-list
                    assignment-table
                    var-types
                    instrs
                    (compiler-reg-loop-depth-weight
                      (array-ref depths (+ block-index i)))
                    instruction
                    scratch
                    scratch-base
                    starts
                    ends
                    segments
                    present
                    types
                    scratch-weights
                    scratch-excluded)
                    [(CompilerRegScratchFillState.State
                        next-instruction
                        next-scratch)
                      (begin
                        (set! instruction next-instruction)
                        (set! scratch next-scratch))])])
              (set! i (+ i 1))))
          (CompilerRegScratchFillState.State instruction scratch)))]))

(define (compiler-reg-early-scratch-model
  [type-segment-bases : i64]
  [abi : CompilerRegTargetAbi]
  [func : CompilerIrFunction]
  [base-index : CompilerRegIntervalIndex]
  [base-types : CompilerRegVarTypes]
  [base-assignments : CompilerRegAssignmentTable]
  [enabled : bool]) : CompilerRegEarlyScratchModel
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [scratch-base : i64 (array-length (struct-get base-index starts))]
        [scratch-count : i64
          (if enabled
            (compiler-reg-early-scratch-count-blocks blocks)
            0)]
        (if (= scratch-count 0)
          (CompilerRegEarlyScratchModel
            base-index
            base-types
            base-assignments
            (array.make-array i64 0)
            (array.make-array CompilerRegIdList 0)
            scratch-base
            0)
          (let
            [out-vars : i64 (+ scratch-base scratch-count)]
            [starts : (Array i64) (array.make-array i64 out-vars)]
            [ends : (Array i64) (array.make-array i64 out-vars)]
            [segments : (Array CompilerRegIntervalSeq)
              (array.make-array CompilerRegIntervalSeq out-vars)]
            [present : (Array i64) (array.make-array i64 out-vars)]
            [types : (Array AstType) (array.make-array AstType out-vars)]
            [scratch-weights : (Array i64) (array.make-array i64 scratch-count)]
            [scratch-excluded : (Array CompilerRegIdList)
              (array.make-array CompilerRegIdList out-vars)]
            [depths : (Array i64) (compiler-reg-function-loop-depths blocks)]
            [assignment-list : CompilerRegAssignmentList
              (compiler-reg-assignment-table-to-list base-assignments)]
            [assignments : CompilerRegAssignmentTable
              (compiler-reg-assignment-table-from-list assignment-list out-vars)]
            [policy : CompilerRegScratchPolicy
              (compiler-reg-scratch-policy
                abi
                assignment-list
                CompilerRegIdList.Nil)]
            (begin
              (compiler-reg-fill-i64-array starts -1)
              (compiler-reg-fill-i64-array ends -1)
              (compiler-reg-fill-interval-seq-array! segments 0)
              (compiler-reg-copy-i64-array!
                starts
                (struct-get base-index starts)
                0)
              (compiler-reg-copy-i64-array! ends (struct-get base-index ends) 0)
              (compiler-reg-copy-interval-seq-array!
                segments
                (struct-get base-index segments)
                0)
              (compiler-reg-copy-i64-array!
                present
                (struct-get base-types present)
                0)
              (compiler-reg-copy-ast-type-array!
                types
                (struct-get base-types items)
                0)
              (compiler-reg-early-scratch-fill-blocks!
                type-segment-bases
                abi
                policy
                assignment-list
                assignments
                (compiler-reg-var-types-list base-types)
                blocks
                depths
                0
                0
                0
                scratch-base
                starts
                ends
                segments
                present
                types
                scratch-weights
                scratch-excluded)
              (CompilerRegEarlyScratchModel
                (CompilerRegIntervalIndex starts ends segments)
                (CompilerRegVarTypes present types)
                assignments
                scratch-weights
                scratch-excluded
                scratch-base
                scratch-count)))))]))

(define (compiler-reg-early-scratch-extend-weights
  [weights : (Array i64)]
  [raw-weights : (Array i64)]
  [vars : i64]
  [scratch-base : i64]
  [scratch-count : i64]
  [scratch-weights : (Array i64)]) : (Array i64)
  (if (= scratch-count 0)
    weights
    (let
      [out : (Array i64) (array.make-array i64 vars)]
      [max-raw : i64 0]
      [r : i64 0]
      [v : i64 scratch-base]
      (begin
        (compiler-reg-copy-i64-array! out weights 0)
        (while (< r (array-length raw-weights))
          (begin
            (if (> (array-ref raw-weights r) max-raw)
              (set! max-raw (array-ref raw-weights r))
              unit)
            (set! r (+ r 1))))
        ;; Use the same (discounted * radix + raw) scale as real values. Scratch
        ;; is not rematerialisable, so its discounted and raw costs are equal.
        ;; A non-zero demand wins an exact real-value tie by one unit: failing to
        ;; place it costs a save+restore pair, while evicting the equally cold
        ;; occupant pays one honest spill/reload home. The ordinary greedy keeps
        ;; its strict-lower eviction rule; only these targeted pseudos receive the
        ;; preservation-cost tie-break. An unprofitable requirement remains
        ;; unassigned and the retained late planner/scavenger supplies fallback.
        (while (< v vars)
          (let
            [scratch-index : i64 (- v scratch-base)]
            [weight : i64
              (if (< scratch-index (array-length scratch-weights))
                (array-ref scratch-weights scratch-index)
                0)]
            [combined : i64 (+ (* weight (+ max-raw 1)) weight)]
            [priced : i64
              (if (= weight 0)
                combined
                (+ combined 1))]
            (begin
              (array-set!
                out
                v
                (if (>= priced (compiler-reg-greedy-evict-inf))
                  (- (compiler-reg-greedy-evict-inf) 1)
                  priced))
              (set! v (+ v 1)))))
        out))))

(define (compiler-reg-early-scratch-intervals
  [intervals : CompilerRegIntervalSeq]
  [scratch-base : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count intervals))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          (begin
            (if (>= (struct-get interval var) scratch-base)
              (set! out (compiler-reg-interval-seq-append out interval))
              unit)
            (set! index (+ index 1)))))
      out)))

(define (compiler-reg-assignment-table-copy-range!
  [dst : CompilerRegAssignmentTable]
  [src : CompilerRegAssignmentTable]
  [start : i64]
  [end : i64]) : unit
  (let
    [v : i64 start]
    (while (< v end)
      (begin
        (match (compiler-reg-assignment-table-lookup src v)
          [(CompilerRegMaybeLocation.Some location)
            (begin
              (compiler-reg-assignment-table-insert dst v location)
              unit)]
          [(CompilerRegMaybeLocation.No) unit])
        (set! v (+ v 1))))))

(define (compiler-reg-assignment-table-prefix
  [assignments : CompilerRegAssignmentTable]
  [vars : i64]) : CompilerRegAssignmentTable
  (if (= vars (array-length (struct-get assignments present)))
    assignments
    (let
      [out : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make vars)]
      (begin
        (compiler-reg-assignment-table-copy-range! out assignments 0 vars)
        out))))

(define (compiler-reg-assignment-table-prefix-eq?
  [left : CompilerRegAssignmentTable]
  [right : CompilerRegAssignmentTable]
  [limit : i64]
  [var : i64]) : bool
  (if (>= var limit)
    true
    (and
      (match (compiler-reg-assignment-table-lookup left var)
        [(CompilerRegMaybeLocation.Some left-location)
          (match (compiler-reg-assignment-table-lookup right var)
            [(CompilerRegMaybeLocation.Some right-location)
              (compiler-reg-location-eq? left-location right-location)]
            [(CompilerRegMaybeLocation.No) false])]
        [(CompilerRegMaybeLocation.No)
          (match (compiler-reg-assignment-table-lookup right var)
            [(CompilerRegMaybeLocation.Some _) false]
            [(CompilerRegMaybeLocation.No) true])])
      (compiler-reg-assignment-table-prefix-eq? left right limit (+ var 1)))))

(define (compiler-reg-assignment-table-with-scratch
  [real-assignments : CompilerRegAssignmentTable]
  [scratch-assignments : CompilerRegAssignmentTable]
  [scratch-base : i64]
  [scratch-count : i64]) : CompilerRegAssignmentTable
  (if (= scratch-count 0)
    real-assignments
    (let
      [out-vars : i64 (+ scratch-base scratch-count)]
      [out : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make out-vars)]
      (begin
        (compiler-reg-assignment-table-copy-range!
          out
          real-assignments
          0
          scratch-base)
        (compiler-reg-assignment-table-copy-range!
          out
          scratch-assignments
          scratch-base
          out-vars)
        out))))

(define (compiler-reg-assignment-table-fill!
  [table : CompilerRegAssignmentTable]
  [assignments : CompilerRegAssignmentList]) : unit
  (match assignments
    [(CompilerRegAssignmentList.Nil) unit]
    [(CompilerRegAssignmentList.Cons item rest)
      (begin
        (compiler-reg-assignment-table-insert
          table
          (struct-get item var)
          (struct-get item location))
        (compiler-reg-assignment-table-fill! table (box-get rest)))]))

(define (compiler-reg-assignment-table-from-list
  [assignments : CompilerRegAssignmentList]
  [vars : i64]) : CompilerRegAssignmentTable
  (let
    [table : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-make vars)]
    (begin
      (compiler-reg-assignment-table-fill! table assignments)
      table)))

(define (compiler-reg-scratch-default-pool
  [abi : CompilerRegTargetAbi]
  [register-class : CompilerRegScratchClass]) : CompilerRegIdList
  (match register-class
    [(CompilerRegScratchClass.Gp)
      ;; A scratch interval is confined to one lowering expansion and never
      ;; crosses a call. Give both targets the canonical GP candidate order so
      ;; Win64's shorter volatile prefix cannot advance the same demand to a
      ;; different save class (notably %rbx) solely because of ABI pool order.
      (compiler-reg-greedy-integer-pool-for-abi (CompilerRegTargetAbi.Linux))]
    [(CompilerRegScratchClass.Xmm) (compiler-reg-xmm-registers-for-abi abi)]))

(define (compiler-reg-scratch-constraint-pool
  [abi : CompilerRegTargetAbi]
  [constraint : CompilerRegScratchConstraint]) : CompilerRegIdList
  (let
    [fixed : i64 (struct-get constraint fixed)]
    (if (not (= fixed compiler-reg-id-invalid))
      (compiler-reg-id-cons fixed CompilerRegIdList.Nil)
      (match (struct-get constraint allowed)
        [(CompilerRegIdList.Nil)
          (compiler-reg-scratch-default-pool
            abi
            (struct-get constraint register-class))]
        [(CompilerRegIdList.Cons reg rest)
          (compiler-reg-id-cons reg (box-get rest))]))))

(define (compiler-reg-scratch-register-array [abi : CompilerRegTargetAbi]) : (Array
    i64)
  (let
    ;; Fixed ABI roles must remain addressable by the inverse index even while
    ;; the default-off scratch-vreg experiment keeps XMM0/XMM1 out of the
    ;; ordinary allocator pool.
    [xmm-registers : CompilerRegIdList
      (if (compiler-reg-low-xmm-allocatable?)
        (compiler-reg-xmm-registers-for-abi abi)
        (compiler-reg-id-cons
          (compiler-abi-xmm-register-id 0)
          (compiler-reg-id-cons
            (compiler-abi-xmm-register-id 1)
            (compiler-reg-xmm-registers-for-abi abi))))]
    [registers : CompilerRegIdList
      (compiler-reg-id-list-append
        (compiler-reg-greedy-integer-pool-for-abi (CompilerRegTargetAbi.Linux))
        xmm-registers)]
    [out : (Array i64)
      (array.make-array i64 (compiler-reg-id-list-count registers))]
    (begin
      (compiler-reg-greedy-id-list-to-array registers out 0)
      out)))

;; Every production scratch constraint maps into the combined GP/XMM occupancy
;; above. Keep the full assignment-table scan as a fail-closed fallback for an
;; unrecognized future register spelling rather than silently treating it free.
(define (compiler-reg-scratch-register-free-from?
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [var : i64]
  [reg : i64]
  [index : i64]
  [vars : i64]) : bool
  (if (>= index vars)
    true
    (let
      [present : (Array i64) (struct-get assignments present)]
      [items : (Array CompilerRegLocation) (struct-get assignments items)]
      (if (and
        (not (= index var))
        (< index (array-length present))
        (= (array-ref present index) 1)
        (compiler-reg-location-uses-register? (array-ref items index) reg)
        (compiler-reg-vars-interfere-segmented-index? interval-index var index))
        false
        (compiler-reg-scratch-register-free-from?
          assignments
          interval-index
          var
          reg
          (+ index 1)
          vars)))))

(define (compiler-reg-scratch-pick-register
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [reg-arr : (Array i64)]
  [rcount : i64]
  [var : i64]
  [vars : i64]
  [candidates : CompilerRegIdList]
  [excluded : CompilerRegIdList]) : i64
  (match candidates
    [(CompilerRegIdList.Nil) compiler-reg-id-invalid]
    [(CompilerRegIdList.Cons reg rest)
      (let
        [reg-index : i64 (compiler-reg-greedy-pool-index occupancy reg)]
        (if (and
          (not (compiler-reg-id-list-contains? excluded reg))
          (if (>= reg-index 0)
            (compiler-reg-greedy-reg-free?
              occupancy
              interval-index
              ref-counts
              var
              reg-index)
            (compiler-reg-scratch-register-free-from?
              assignments
              interval-index
              var
              reg
              0
              vars)))
          reg
          (compiler-reg-scratch-pick-register
            assignments
            occupancy
            interval-index
            ref-counts
            reg-arr
            rcount
            var
            vars
            (box-get rest)
            excluded)))]))

(define (compiler-reg-scratch-return-fixed-role?
  [role : CompilerRegScratchRole]) : bool
  (match role
    [(CompilerRegScratchRole.FloatReturnResultXmm) true]
    [(CompilerRegScratchRole.FloatReturnResultGp) true]
    [_ false]))

(define (compiler-reg-scratch-assign-items!
  [abi : CompilerRegTargetAbi]
  [items : (Array CompilerRegScratchAssignment)]
  [index : i64]
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (Array i64)]
  [reg-arr : (Array i64)]
  [rcount : i64]
  [vars : i64]) : unit
  (if (>= index (array-length items))
    unit
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement
        (struct-get item requirement)]
      [constraint : CompilerRegScratchConstraint
        (struct-get requirement constraint)]
      [reg
        : i64
        ;; A return result is the final consumer of its operand homes. Its
        ;; fixed ABI register may therefore overlap an input; a simultaneously
        ;; live RHS preservation requirement is assigned afterward and sees
        ;; this synthetic fixed home, so it must choose a distinct register.
        (if (compiler-reg-scratch-return-fixed-role?
          (struct-get requirement role))
          (struct-get constraint fixed)
          (compiler-reg-scratch-pick-register
            assignments
            occupancy
            interval-index
            ref-counts
            reg-arr
            rcount
            (struct-get requirement var)
            vars
            (compiler-reg-scratch-constraint-pool abi constraint)
            (struct-get constraint excluded)))]
      (begin
        (if (= reg compiler-reg-id-invalid)
          unit
          (begin
            (compiler-reg-assignment-table-insert
              assignments
              (struct-get requirement var)
              (CompilerRegLocation.Register reg))
            (compiler-reg-greedy-occupancy-record-location!
              occupancy
              (struct-get requirement var)
              (CompilerRegLocation.Register reg))
            (array-set!
              items
              index
              (CompilerRegScratchAssignment requirement reg))))
        (compiler-reg-scratch-assign-items!
          abi
          items
          (+ index 1)
          assignments
          occupancy
          interval-index
          ref-counts
          reg-arr
          rcount
          vars)))))

(define (compiler-reg-scratch-clear-group-from!
  [items : (Array CompilerRegScratchAssignment)]
  [index : i64]
  [lo : i64]
  [hi : i64]) : unit
  (if (>= index (array-length items))
    unit
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement
        (struct-get item requirement)]
      (begin
        (if (and
          (= (struct-get requirement lo) lo)
          (= (struct-get requirement hi) hi))
          (array-set!
            items
            index
            (CompilerRegScratchAssignment requirement compiler-reg-id-invalid))
          unit)
        (compiler-reg-scratch-clear-group-from! items (+ index 1) lo hi)))))

;; A fused emitter must never mix a partially allocated planned group with
;; independent scavenger choices.  If any slot in a common reservation span
;; failed, clear every sibling slot so planned-or-scavenge handles the complete
;; group through the legacy sound fallback.
(define (compiler-reg-scratch-clear-incomplete-groups!
  [items : (Array CompilerRegScratchAssignment)]
  [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement
        (struct-get item requirement)]
      (begin
        (if (and
          (> (- (struct-get requirement hi) (struct-get requirement lo)) 1)
          (= (struct-get item register) compiler-reg-id-invalid))
          (compiler-reg-scratch-clear-group-from!
            items
            0
            (struct-get requirement lo)
            (struct-get requirement hi))
          unit)
        (compiler-reg-scratch-clear-incomplete-groups! items (+ index 1))))))

(define (compiler-reg-scratch-callee-saved-register?
  [abi : CompilerRegTargetAbi]
  [reg : i64]) : bool
  (or
    (compiler-reg-id-list-contains? (compiler-reg-sysv-integer-registers) reg)
    (= reg compiler-reg-id-rbp)
    (match abi
      [(CompilerRegTargetAbi.Linux) false]
      [(CompilerRegTargetAbi.Windows)
        (or
          (= reg compiler-reg-id-rsi)
          (= reg compiler-reg-id-rdi)
          (compiler-reg-id-list-contains?
            (compiler-reg-xmm-callee-registers-for-abi abi)
            reg))])))

(define (compiler-reg-scratch-compact-assignments-from
  [abi : CompilerRegTargetAbi]
  [items : (Array CompilerRegScratchAssignment)]
  [index : i64]
  [success : i64]
  [vars : i64]
  [seen : CompilerRegIdList]
  [assignments : CompilerRegAssignmentList]) : CompilerRegAssignmentList
  (if (>= index (array-length items))
    assignments
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [reg : i64 (struct-get item register)]
      (if (or
        (= reg compiler-reg-id-invalid)
        (not (compiler-reg-scratch-callee-saved-register? abi reg))
        (compiler-reg-id-list-contains? seen reg))
        (compiler-reg-scratch-compact-assignments-from
          abi
          items
          (+ index 1)
          success
          vars
          seen
          assignments)
        (compiler-reg-assignment-cons
          (CompilerRegAssignment
            (+ vars success)
            (CompilerRegLocation.Register reg))
          (compiler-reg-scratch-compact-assignments-from
            abi
            items
            (+ index 1)
            (+ success 1)
            vars
            (compiler-reg-id-cons reg seen)
            assignments))))))

(define (compiler-reg-plan-with-scratch-vreg-result
  [_type-segment-bases : i64]
  [_abi : CompilerRegTargetAbi]
  [_func : CompilerIrFunction]
  [plan : CompilerRegPlan]
  [_vars : i64]) : CompilerRegScratchPlanResult
  (cfg
    scratch-vreg
    (match _func
      [(CompilerIrFunction.Function _ _ _ _ blocks)
        (let
          [phi-targets : CompilerRegLabelList
            (compiler-reg-scratch-phi-targets-blocks blocks)]
          [phi-xmm-targets : CompilerRegLabelList
            (compiler-reg-scratch-phi-xmm-targets-blocks blocks)]
          [scratch-count : i64
            (compiler-reg-scratch-vreg-count-blocks
              _type-segment-bases
              _abi
              (compiler-reg-plan-assignments plan)
              (compiler-reg-plan-types plan)
              blocks
              phi-targets
              phi-xmm-targets
              0)]
          [instruction-count : i64
            (compiler-reg-scratch-vreg-instr-count-blocks blocks 0)]
          (if (= scratch-count 0)
            (CompilerRegScratchPlanResult.Result
              plan
              (CompilerRegScratchPlan
                (array.make-array CompilerRegScratchAssignment 0)
                (array.make-array i64 instruction-count)
                (array.make-array i64 instruction-count)))
            (let
              [out-vars : i64 (+ _vars scratch-count)]
              [scratch-policy : CompilerRegScratchPolicy
                (compiler-reg-scratch-policy
                  _abi
                  (compiler-reg-plan-assignments plan)
                  (compiler-reg-scratch-phi-dst-registers-blocks
                    (compiler-reg-plan-assignments plan)
                    blocks))]
              [base-type-info : CompilerRegVarTypes
                (compiler-reg-var-types-from-list
                  (compiler-reg-plan-types plan)
                  _vars)]
              [liveness-handle : CompilerRegLivenessHandle
                (compiler-reg-liveness-handle-make _func false)]
              [base-interval-selection : CompilerRegIntervalSelection
                (compiler-reg-live-interval-selection
                  _func
                  (struct-get liveness-handle baseline))]
              (match base-interval-selection
                [(CompilerRegIntervalSelection.Selection _ base-index)
                  (let
                    [starts : (Array i64) (array.make-array i64 out-vars)]
                    [ends : (Array i64) (array.make-array i64 out-vars)]
                    [segments : (Array CompilerRegIntervalSeq)
                      (array.make-array CompilerRegIntervalSeq out-vars)]
                    [present : (Array i64) (array.make-array i64 out-vars)]
                    [types : (Array AstType)
                      (array.make-array AstType out-vars)]
                    [items : (Array CompilerRegScratchAssignment)
                      (array.make-array
                        CompilerRegScratchAssignment
                        scratch-count)]
                    [firsts : (Array i64)
                      (array.make-array i64 instruction-count)]
                    [slot-counts : (Array i64)
                      (array.make-array i64 instruction-count)]
                    (begin
                      (compiler-reg-fill-i64-array starts -1)
                      (compiler-reg-fill-i64-array ends -1)
                      (compiler-reg-fill-interval-seq-array! segments 0)
                      (compiler-reg-copy-i64-array!
                        starts
                        (struct-get base-index starts)
                        0)
                      (compiler-reg-copy-i64-array!
                        ends
                        (struct-get base-index ends)
                        0)
                      (compiler-reg-copy-interval-seq-array!
                        segments
                        (struct-get base-index segments)
                        0)
                      (compiler-reg-copy-i64-array!
                        present
                        (struct-get base-type-info present)
                        0)
                      (compiler-reg-copy-ast-type-array!
                        types
                        (struct-get base-type-info items)
                        0)
                      (compiler-reg-scratch-fill-blocks!
                        _type-segment-bases
                        _abi
                        scratch-policy
                        (compiler-reg-plan-assignments plan)
                        (compiler-reg-plan-types plan)
                        blocks
                        phi-targets
                        phi-xmm-targets
                        0
                        0
                        _vars
                        items
                        firsts
                        slot-counts
                        starts
                        ends
                        segments
                        present
                        types)
                      (let
                        [type-info : CompilerRegVarTypes
                          (CompilerRegVarTypes present types)]
                        [interval-index : CompilerRegIntervalIndex
                          (CompilerRegIntervalIndex starts ends segments)]
                        [intervals : CompilerRegIntervalSeq
                          (compiler-reg-interval-arrays-to-seq
                            starts
                            ends
                            (- out-vars 1)
                            (compiler-reg-interval-seq-empty))]
                        [assignments : CompilerRegAssignmentTable
                          (compiler-reg-assignment-table-from-list
                            (compiler-reg-plan-assignments plan)
                            out-vars)]
                        [scratch-registers : (Array i64)
                          (compiler-reg-scratch-register-array _abi)]
                        [scratch-register-count : i64
                          (array-length scratch-registers)]
                        [scratch-occupancy : CompilerRegGreedyOccupancy
                          (compiler-reg-greedy-occupancy-make
                            assignments
                            scratch-registers
                            scratch-register-count)]
                        [scratch-ref-counts : (Array i64)
                          (array.make-array i64 out-vars)]
                        (begin
                          ;; Constraint-aware, non-evicting assignment: every
                          ;; synthetic interval and all previously assigned homes
                          ;; are visible before a register is selected.  Failure
                          ;; leaves the item register empty for safe fallback.
                          (compiler-reg-scratch-assign-items!
                            _abi
                            items
                            0
                            assignments
                            scratch-occupancy
                            interval-index
                            scratch-ref-counts
                            scratch-registers
                            scratch-register-count
                            out-vars)
                          (compiler-reg-scratch-clear-incomplete-groups!
                            items
                            0)
                          (CompilerRegScratchPlanResult.Result
                            (match plan
                              [(CompilerRegPlan.Plan
                                  base-assignments
                                  ineligible
                                  base-intervals
                                  base-types
                                  call-split
                                  split-plan)
                                (CompilerRegPlan.Plan
                                  ;; Scratch requirements are not IR values and
                                  ;; never need stack slots. Publish each
                                  ;; successful callee-saved home only once,
                                  ;; densely after the real vars, so prologue
                                  ;; accounting sees it without making
                                  ;; caller-saved temporaries inflate every
                                  ;; var-sized backend table.
                                  (compiler-reg-assignment-list-merge
                                    (compiler-reg-scratch-compact-assignments-from
                                      _abi
                                      items
                                      0
                                      0
                                      _vars
                                      CompilerRegIdList.Nil
                                      CompilerRegAssignmentList.Nil)
                                    base-assignments)
                                  ineligible
                                  base-intervals
                                  base-types
                                  call-split
                                  split-plan)])
                            (CompilerRegScratchPlan items firsts slot-counts))))))]))))])
    (CompilerRegScratchPlanResult.Result plan (compiler-reg-scratch-plan-empty))))

(define (compiler-reg-caller-save-remap-fill!
  [remap : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length remap))
    unit
    (begin
      (array-set! remap index index)
      (compiler-reg-caller-save-remap-fill! remap (+ index 1)))))

(define (compiler-reg-caller-save-remap [vars : i64]) : (Array i64)
  (let
    [remap : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-reg-caller-save-remap-fill! remap 0)
      remap)))

(define (compiler-reg-caller-save-var-type
  [type-info : CompilerRegVarTypes]
  [var : i64]) : AstType
  (match (compiler-reg-var-types-lookup type-info var)
    [(CompilerRegMaybeType.Some ty) ty]
    [(CompilerRegMaybeType.No) (AstType.I64)]))

;; ---------------------------------------------------------------------------
;; M-G2b backend realization of the per-call-region split. Runs FIRST in the
;; backend rewrite pipeline (caller-save -> loop-split -> remat)
;; on blocks byte-identical to the ones the allocator numbered, so the
;; region point coords map 1:1. For each accepted region [lo,hi] of var V:
;;   * at lo: mint a fresh segment var W assigned V's shadow caller-saved
;;     register, emit the entry reload `Mov W <- V` when entry-flag = 1
;;     (V resolves to its own home slot), and remap V -> W;
;;   * every instr in [lo,hi] goes through the remap;
;;   * at hi: emit the exit store `Mov V <- W` when exit-flag = 1 -- BEFORE
;;     hi's instr when it is control flow (a terminator only READS V, so
;;     the order is free), else right after it -- then reset the remap.
;; The remap is strictly PER-VAR, never slot-class-wide: storage coloring
;; later assigns every var its own slot from its own liveness, so
;; coalesce-class members sharing a plan offset can end up in DIFFERENT
;; final slots (their value flows through the class's explicit copy movs,
;; which this rewrite leaves untouched -- a class-wide remap homed on the
;; root's slot reads/writes the wrong storage once coloring de-aliases the
;; members).
;; Regions are block-scoped, kind-0-clobber-free and non-overlapping per
;; var by construction, so no mid-region call handling exists and the home
;; slot is authoritative everywhere outside [lo,hi]. Phi instructions are
;; never remapped (their inputs are read on predecessor EDGES; regions start
;; after the leading phis). The minted W assignments join the plan, so the
;; downstream scavenge-interval rebuild sees W's register occupied over
;; exactly the region -- the same soundness net the loop-split rescue uses.
;; ---------------------------------------------------------------------------
(define (compiler-reg-call-region-list-count
  [regions : CompilerRegCallRegionSeq]) : i64
  (struct-get regions len))

;; Newest-accepted region first, matching the walk order of the former list.
(define (compiler-reg-call-region-fill-arrays!
  [regions : CompilerRegCallRegionSeq]
  [r-var : (Array i64)]
  [r-lo : (Array i64)]
  [r-hi : (Array i64)]
  [r-entry : (Array i64)]
  [r-exit : (Array i64)]
  [i : i64]) : unit
  (let
    [slots : (Array CompilerRegCallRegion) (struct-get regions slots)]
    [index : i64 (- (struct-get regions len) 1)]
    [at : i64 i]
    (while (>= index 0)
      (begin
        (match (array-ref slots index)
          [(CompilerRegCallRegion var lo hi entry-flag exit-flag)
            (begin
              (array-set! r-var at var)
              (array-set! r-lo at lo)
              (array-set! r-hi at hi)
              (array-set! r-entry at entry-flag)
              (array-set! r-exit at exit-flag))])
        (set! at (+ at 1))
        (set! index (- index 1))))))

(define (compiler-reg-call-region-sort-swap!
  [arr : (Array i64)]
  [a : i64]
  [b : i64]) : unit
  (let
    [tmp : i64 (array-ref arr a)]
    (begin
      (array-set! arr a (array-ref arr b))
      (array-set! arr b tmp))))

(define (compiler-reg-call-region-sort-by-lo!
  [r-var : (Array i64)]
  [r-lo : (Array i64)]
  [r-hi : (Array i64)]
  [r-entry : (Array i64)]
  [r-exit : (Array i64)]
  [count : i64]) : unit
  (let
    [i : i64 1]
    (while (< i count)
      (let
        [j : i64 i]
        (begin
          (while (and (> j 0) (> (array-ref r-lo (- j 1)) (array-ref r-lo j)))
            (begin
              (compiler-reg-call-region-sort-swap! r-var (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-lo (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-hi (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-entry (- j 1) j)
              (compiler-reg-call-region-sort-swap! r-exit (- j 1) j)
              (set! j (- j 1))))
          (set! i (+ i 1)))))))

(define (compiler-reg-call-region-control-flow-instr? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Jump _) true]
    [(CompilerIrInstr.Branch _ _ _) true]
    [(CompilerIrInstr.Return _) true]
    [(CompilerIrInstr.Switch _ _ _ _) true]
    [(CompilerIrInstr.TailCall _ _ _) true]
    [(CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ false]))

;; Exit stores for every active root whose region ends at `point` (emitted
;; only when the region redefined the value and it lives on -- exit-flag).
(define (compiler-reg-call-region-exit-stores
  [active : (Array i64)]
  [active-n : i64]
  [act-hi : (Array i64)]
  [act-exit : (Array i64)]
  [act-w : (Array i64)]
  [point : i64]
  [type-info : CompilerRegVarTypes]
  [acc : CompilerIrInstrList]) : CompilerIrInstrList
  (let
    [j : i64 0]
    [out : CompilerIrInstrList acc]
    (begin
      (while (< j active-n)
        (let
          [root : i64 (array-ref active j)]
          (begin
            (if (and
              (= (array-ref act-hi root) point)
              (= (array-ref act-exit root) 1)
              (>= (array-ref act-w root) 0))
              (set!
                out
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Mov
                    root
                    (CompilerIrValue.Var (array-ref act-w root))
                    (compiler-reg-caller-save-var-type type-info root))
                  out))
              unit)
            (set! j (+ j 1)))))
      out)))

(define (compiler-reg-caller-save-rewrite-blocks
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (let
    [regions : CompilerRegCallRegionSeq
      (compiler-reg-plan-caller-save-regions plan)]
    [count : i64 (compiler-reg-call-region-list-count regions)]
    (if (= count 0)
      (CompilerRegCallSaveRewrite.Rewrite
        blocks
        vars
        vars
        CompilerRegAssignmentList.Nil
        CompilerRegVarTypeList.Nil)
      (let
        [shadow-regs : (Array i64) (compiler-reg-plan-caller-save-regs plan)]
        [r-var : (Array i64) (array.make-array i64 count)]
        [r-lo : (Array i64) (array.make-array i64 count)]
        [r-hi : (Array i64) (array.make-array i64 count)]
        [r-entry : (Array i64) (array.make-array i64 count)]
        [r-exit : (Array i64) (array.make-array i64 count)]
        [remap : (Array i64) (compiler-reg-caller-save-remap vars)]
        [act-w : (Array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [act-hi : (Array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [act-exit : (Array i64)
          (array.make-array
            i64
            (if (< vars 1)
              1
              vars))]
        [active : (Array i64) (array.make-array i64 (+ count 1))]
        [active-n : i64 0]
        [next-var : i64 vars]
        [extra-assignments : CompilerRegAssignmentList
          CompilerRegAssignmentList.Nil]
        [extra-types : CompilerRegVarTypeList CompilerRegVarTypeList.Nil]
        [cursor : i64 0]
        [point : i64 0]
        [seq : CompilerIrBlockSeq (compiler-live-ir-block-list-to-seq blocks)]
        [bslots : (Array CompilerIrBlock) (struct-get seq slots)]
        [nblocks : i64 (struct-get seq len)]
        [out-rev : CompilerIrBlockList CompilerIrBlockList.Nil]
        [b : i64 0]
        (begin
          (compiler-reg-call-region-fill-arrays!
            regions
            r-var
            r-lo
            r-hi
            r-entry
            r-exit
            0)
          (compiler-reg-call-region-sort-by-lo!
            r-var
            r-lo
            r-hi
            r-entry
            r-exit
            count)
          (compiler-reg-fill-i64-array act-w (- 0 1))
          (while (< b nblocks)
            (begin
              (match (array-ref bslots b)
                [(CompilerIrBlock.Block label instrs)
                  (let
                    [ilen : i64 (compiler-ir-instr-seq-count instrs)]
                    [span : i64 (* 2 ilen)]
                    (if (or
                      (>= cursor count)
                      (>= (array-ref r-lo cursor) (+ point span)))
                      ;; no region starts here (none can be active across
                      ;; blocks) -> keep the block untouched
                      (begin
                        (set!
                          out-rev
                          (compiler-ir-block-cons
                            (CompilerIrBlock.Block label instrs)
                            out-rev))
                        (set! point (+ point span)))
                      (let
                        [islots : (Array CompilerIrInstr)
                          (struct-get instrs slots)]
                        [i : i64 0]
                        [acc : CompilerIrInstrList CompilerIrInstrList.Nil]
                        (begin
                          (while (< i ilen)
                            (let
                              [instr : CompilerIrInstr (array-ref islots i)]
                              (begin
                                ;; defensive: drop any region whose lo was
                                ;; passed without matching (must not happen)
                                (while (and
                                  (< cursor count)
                                  (< (array-ref r-lo cursor) point))
                                  (set! cursor (+ cursor 1)))
                                ;; activations at this point
                                (while (and
                                  (< cursor count)
                                  (= (array-ref r-lo cursor) point))
                                  (let
                                    [root : i64 (array-ref r-var cursor)]
                                    [w : i64 next-var]
                                    [reg : i64
                                      (if (and
                                        (>= root 0)
                                        (< root (array-length shadow-regs)))
                                        (array-ref shadow-regs root)
                                        compiler-reg-id-invalid)]
                                    [ty : AstType
                                      (compiler-reg-caller-save-var-type
                                        type-info
                                        root)]
                                    (begin
                                      (if (or
                                        (= reg compiler-reg-id-invalid)
                                        (>= (array-ref act-w root) 0))
                                        ;; defensive decline: no register or
                                        ;; already active
                                        unit
                                        (begin
                                          (set! next-var (+ next-var 1))
                                          (set!
                                            extra-assignments
                                            (compiler-reg-assignment-cons
                                              (CompilerRegAssignment
                                                w
                                                (CompilerRegLocation.Register
                                                  reg))
                                              extra-assignments))
                                          (set!
                                            extra-types
                                            (compiler-reg-var-type-insert
                                              extra-types
                                              w
                                              ty))
                                          (if (= (array-ref r-entry cursor) 1)
                                            (set!
                                              acc
                                              (compiler-ir-instr-cons
                                                (CompilerIrInstr.Mov
                                                  w
                                                  (CompilerIrValue.Var root)
                                                  ty)
                                                acc))
                                            unit)
                                          (array-set! act-w root w)
                                          (array-set!
                                            act-hi
                                            root
                                            (array-ref r-hi cursor))
                                          (array-set!
                                            act-exit
                                            root
                                            (array-ref r-exit cursor))
                                          (array-set! remap root w)
                                          (array-set! active active-n root)
                                          (set! active-n (+ active-n 1))))
                                      (set! cursor (+ cursor 1)))))
                                (let
                                  [out-instr : CompilerIrInstr
                                    (if (> active-n 0)
                                      (match instr
                                        [(CompilerIrInstr.Phi _ _ _) instr]
                                        [_
                                          (compiler-reg-remap-instr remap instr)])
                                      instr)]
                                  [cf : bool
                                    (compiler-reg-call-region-control-flow-instr?
                                      instr)]
                                  (begin
                                    (if cf
                                      (begin
                                        (set!
                                          acc
                                          (compiler-reg-call-region-exit-stores
                                            active
                                            active-n
                                            act-hi
                                            act-exit
                                            act-w
                                            point
                                            type-info
                                            acc))
                                        (set!
                                          acc
                                          (compiler-ir-instr-cons out-instr acc)))
                                      (begin
                                        (set!
                                          acc
                                          (compiler-ir-instr-cons out-instr acc))
                                        (set!
                                          acc
                                          (compiler-reg-call-region-exit-stores
                                            active
                                            active-n
                                            act-hi
                                            act-exit
                                            act-w
                                            point
                                            type-info
                                            acc))))
                                    ;; deactivate the regions ending here
                                    (let
                                      [j : i64 0]
                                      (while (< j active-n)
                                        (let
                                          [root : i64 (array-ref active j)]
                                          (if (= (array-ref act-hi root) point)
                                            (begin
                                              (array-set! remap root root)
                                              (array-set! act-w root (- 0 1))
                                              (set! active-n (- active-n 1))
                                              (array-set!
                                                active
                                                j
                                                (array-ref active active-n)))
                                            (set! j (+ j 1))))))))
                                (set! point (+ point 2))
                                (set! i (+ i 1)))))
                          ;; defensive drain: regions are block-scoped
                          (while (> active-n 0)
                            (let
                              [root : i64 (array-ref active (- active-n 1))]
                              (begin
                                (array-set! remap root root)
                                (array-set! act-w root (- 0 1))
                                (set! active-n (- active-n 1)))))
                          (set!
                            out-rev
                            (compiler-ir-block-cons
                              (CompilerIrBlock.Block
                                label
                                (compiler-ir-instr-seq-from-list
                                  (compiler-ir-instr-list-reverse-onto
                                    acc
                                    CompilerIrInstrList.Nil)))
                              out-rev))))))])
              (set! b (+ b 1))))
          (CompilerRegCallSaveRewrite.Rewrite
            (compiler-ir-block-list-reverse-onto
              out-rev
              CompilerIrBlockList.Nil)
            vars
            next-var
            extra-assignments
            extra-types))))))

(define (compiler-reg-remat-table-record-def!
  [table : CompilerRegRematTable]
  [instr : CompilerIrInstr]
  [allow-invariant-loads : bool]) : unit
  (let
    [def-counts : (Array i64) (struct-get table def-counts)]
    [candidates : (Array i64) (struct-get table candidates)]
    [kinds : (Array i64) (struct-get table kinds)]
    [values : (Array CompilerIrValue) (struct-get table values)]
    [offsets : (Array CompilerIrValue) (struct-get table offsets)]
    [op-types : (Array AstType) (struct-get table op-types)]
    [types : (Array AstType) (struct-get table types)]
    (begin
      (compiler-reg-ref-counts-add-set-weighted!
        def-counts
        (compiler-live-instr-defs instr)
        1)
      (match instr
        [(CompilerIrInstr.Mov dst value ty)
          (if (and
            (compiler-reg-remat-mov-value? value allow-invariant-loads)
            (>= dst 0)
            (< dst (array-length candidates))
            (not (= (array-ref candidates dst) 2)))
            (begin
              (array-set! candidates dst 1)
              (array-set! kinds dst (compiler-reg-remat-kind-mov))
              (array-set! values dst value)
              (array-set! op-types dst ty)
              (array-set! types dst ty))
            unit)]
        [(CompilerIrInstr.Gep dst base offset ty)
          (if (and
            (compiler-reg-remat-gep? base offset)
            (>= dst 0)
            (< dst (array-length candidates))
            (not (= (array-ref candidates dst) 2)))
            (begin
              (array-set! candidates dst 1)
              (array-set! kinds dst (compiler-reg-remat-kind-gep))
              (array-set! values dst base)
              (array-set! offsets dst offset)
              (array-set! op-types dst ty)
              (array-set! types dst (compiler-reg-addr-of-result-type)))
            unit)]
        [(CompilerIrInstr.Load dst src ty)
          (if (and
            (compiler-reg-remat-load? src allow-invariant-loads)
            (>= dst 0)
            (< dst (array-length candidates))
            (not (= (array-ref candidates dst) 2)))
            (begin
              (array-set! candidates dst 1)
              (array-set! kinds dst (compiler-reg-remat-kind-load))
              (array-set! values dst src)
              (array-set! op-types dst ty)
              (array-set! types dst ty))
            unit)]
        [(CompilerIrInstr.AddrOf _ src)
          ;; Address-taken values need stable storage. Mark the source as
          ;; poisoned so the use-site remat rewrite cannot replace it with a
          ;; freshly materialized temporary.
          (if (and (>= src 0) (< src (array-length candidates)))
            (begin
              (array-set! candidates src 2)
              unit)
            unit)]
        [_ unit]))))

(define (compiler-reg-remat-table-record-instrs!
  [table : CompilerRegRematTable]
  [instrs : CompilerIrInstrSeq]
  [allow-invariant-loads : bool]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-remat-table-record-def!
          table
          (array-ref slots index)
          allow-invariant-loads)
        (set! index (+ index 1))))))

(define (compiler-reg-remat-table-record-blocks!
  [table : CompilerRegRematTable]
  [blocks : CompilerIrBlockList]
  [allow-invariant-loads : bool]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-reg-remat-table-record-instrs!
              table
              instrs
              allow-invariant-loads)])
        (compiler-reg-remat-table-record-blocks!
          table
          (box-get rest)
          allow-invariant-loads))]
    [(CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (compiler-ir-block-seq-ref seq i)
              [(CompilerIrBlock.Block _ instrs)
                (compiler-reg-remat-table-record-instrs!
                  table
                  instrs
                  allow-invariant-loads)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-remat-table-build [func : CompilerIrFunction]) : CompilerRegRematTable
  (match func
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [def-counts : (Array i64) (array.make-array i64 vars)]
        [candidates : (Array i64) (array.make-array i64 vars)]
        [kinds : (Array i64) (array.make-array i64 vars)]
        [values : (Array CompilerIrValue)
          (array.make-array CompilerIrValue vars)]
        [offsets : (Array CompilerIrValue)
          (array.make-array CompilerIrValue vars)]
        [op-types : (Array AstType) (array.make-array AstType vars)]
        [types : (Array AstType) (array.make-array AstType vars)]
        [allow-invariant-loads : bool
          (compiler-reg-remat-invariant-loads-ok? func)]
        [table : CompilerRegRematTable
          (CompilerRegRematTable
            def-counts
            candidates
            kinds
            values
            offsets
            op-types
            types)]
        (begin
          (compiler-reg-fill-i64-array def-counts 0)
          (compiler-reg-fill-i64-array candidates 0)
          (compiler-reg-fill-i64-array kinds 0)
          ;; Parameters are an implicit definition at function entry (their
          ;; incoming value). Count them so a param that is ALSO written by a
          ;; single in-body `mov` (e.g. a tail-recursion-to-loop back edge that
          ;; assigns a constant, `param <- #false`) is NOT mistaken for a
          ;; single-def rematerialisable var: rematerialising it would recompute
          ;; the constant at the loop-header use and silently drop the
          ;; first-iteration incoming argument value.
          (compiler-reg-param-count-defs! params def-counts)
          (compiler-reg-remat-table-record-blocks!
            table
            blocks
            allow-invariant-loads)
          table))]))

(define (compiler-reg-remat-var-spilled?
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Spill _) true]
        [_ false])]
    [(CompilerRegMaybeLocation.No) true]))

(define (compiler-reg-remat-table-eligible?
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentList]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [var : i64]) : bool
  (let
    [def-counts : (Array i64) (struct-get table def-counts)]
    [candidates : (Array i64) (struct-get table candidates)]
    (and
      (>= var 0)
      (< var (array-length def-counts))
      (= (array-ref def-counts var) 1)
      (= (array-ref candidates var) 1)
      (compiler-reg-remat-var-spilled? assignments var)
      (not (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)))))

(define (compiler-reg-remat-registers-for-type [ty : AstType]) : CompilerRegIdList
  (if (compiler-reg-float-type? ty)
    (compiler-reg-xmm-registers)
    (if (compiler-reg-register-eligible-type? ty)
      (compiler-reg-id-cons compiler-reg-id-r9 CompilerRegIdList.Nil)
      CompilerRegIdList.Nil)))

(define (compiler-reg-remat-interval-active-at?
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [point : i64]) : bool
  (match (compiler-reg-interval-index-lookup intervals var)
    [(CompilerRegMaybeInterval.Some interval)
      (and
        (<= (struct-get interval start) point)
        (<= point (struct-get interval end)))]
    [(CompilerRegMaybeInterval.No) false]))

(define (compiler-reg-remat-location-conflicts-at?
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [point : i64]
  [location : CompilerRegLocation]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (if (and
        (compiler-reg-location-overlaps? (struct-get item location) location)
        (compiler-reg-remat-interval-active-at?
          intervals
          (struct-get item var)
          point))
        true
        (compiler-reg-remat-location-conflicts-at?
          (box-get rest)
          intervals
          point
          location))]))

(define (compiler-reg-remat-first-free-register-at
  [regs : CompilerRegIdList]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [point : i64]
  [chosen : CompilerRegIdList]) : CompilerRegMaybeId
  (match regs
    [(CompilerRegIdList.Nil) CompilerRegMaybeId.No]
    [(CompilerRegIdList.Cons reg rest)
      (if (and
        (not (compiler-reg-id-list-contains? chosen reg))
        (not
          (compiler-reg-remat-location-conflicts-at?
            assignments
            intervals
            point
            (CompilerRegLocation.Register reg))))
        (CompilerRegMaybeId.Some reg)
        (compiler-reg-remat-first-free-register-at
          (box-get rest)
          assignments
          intervals
          point
          chosen))]))

(define (compiler-reg-remat-selected-register
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [point : i64]
  [chosen : CompilerRegIdList]
  [var : i64]) : CompilerRegMaybeId
  (let
    [types : (Array AstType) (struct-get table types)]
    (if (or (< var 0) (>= var (array-length types)))
      CompilerRegMaybeId.No
      (compiler-reg-remat-first-free-register-at
        (compiler-reg-remat-registers-for-type (array-ref types var))
        assignments
        intervals
        point
        chosen))))

(define (compiler-reg-remat-instr
  [table : CompilerRegRematTable]
  [temp : i64]
  [var : i64]) : CompilerIrInstr
  (let
    [kinds : (Array i64) (struct-get table kinds)]
    [values : (Array CompilerIrValue) (struct-get table values)]
    [offsets : (Array CompilerIrValue) (struct-get table offsets)]
    [op-types : (Array AstType) (struct-get table op-types)]
    [types : (Array AstType) (struct-get table types)]
    [ty : AstType (array-ref types var)]
    [value : CompilerIrValue (array-ref values var)]
    (cond
      [(= (array-ref kinds var) (compiler-reg-remat-kind-load))
        (CompilerIrInstr.Load temp value ty)]
      [(= (array-ref kinds var) (compiler-reg-remat-kind-gep))
        (CompilerIrInstr.Gep
          temp
          value
          (array-ref offsets var)
          (array-ref op-types var))]
      [else (CompilerIrInstr.Mov temp value ty)])))

(define (compiler-reg-remat-use-site-ok? [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.Phi _ _ _) false]
    ;; Remat temps are assigned to caller-clobbered homes for a single expanded
    ;; instruction. Avoid instructions whose backend expansion may clobber those
    ;; homes before every operand has been consumed.
    [_ (not (compiler-reg-backend-caller-clobber-instr? instr))]))

;; Reset the entries of a shared, function-scoped identity remap array that a
;; single instruction touched. Only the vars in `uses` (the instruction's
;; operands) could have been overwritten, so restoring identity for those bits
;; returns the array to "no-remap" for the next instruction without an
;; O(vars) rescan/zero. Set bits at ids >= vars are skipped, matching the old
;; ascending `(while (< var vars) ...)` loop which never visited them.
(define (compiler-reg-remat-reset-remap-uses!
  [remap : (Array i64)]
  [uses : CompilerLiveI64Set]
  [vars : i64]) : unit
  (let
    [word-index : i64 0]
    [word-count : i64 (compiler-live-set-word-count uses)]
    (while (< word-index word-count)
      (let
        [bits : i64 (compiler-live-set-word-at-bounded uses word-index)]
        [base : i64 (* word-index (compiler-live-set-word-bits))]
        [bit : i64 0]
        (begin
          (while (not (= bits 0))
            (begin
              (if (not (= (bit-and bits 1) 0))
                (let
                  [var : i64 (+ base bit)]
                  (if (< var vars)
                    (array-set! remap var var)
                    unit))
                unit)
              (set! bits (shr bits 1))
              (set! bit (+ bit 1))))
          (set! word-index (+ word-index 1)))))))

(define (compiler-reg-remat-rewrite-one-instr
  [instr : CompilerIrInstr]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentList]
  [extra-types : CompilerRegVarTypeList]
  [remap : (Array i64)]
  [builder : (&mut builder CompilerIrInstrBuilder)]) : CompilerRegCallSaveInstrRewrite
  (if (compiler-reg-remat-use-site-ok? instr)
    (let
      ;; `uses` is the (1-3 var) operand bitset for THIS instruction. Iterate
      ;; only its set bits in ascending order instead of scanning all `vars`,
      ;; which is byte-identical to the old loop (which also only ran the body
      ;; for set bits in ascending order) but avoids the per-instruction
      ;; O(vars) scan + array zero. `remap` is a function-scoped identity array
      ;; reused across instructions; we restore the bits we set afterwards.
      [uses : CompilerLiveI64Set (compiler-live-instr-uses instr)]
      [types : (Array AstType) (struct-get table types)]
      [chosen : CompilerRegIdList CompilerRegIdList.Nil]
      [out-next-var : i64 next-var]
      [out-extra-assignments : CompilerRegAssignmentList extra-assignments]
      [out-extra-types : CompilerRegVarTypeList extra-types]
      [word-index : i64 0]
      [word-count : i64 (compiler-live-set-word-count uses)]
      (begin
        (while (< word-index word-count)
          (let
            [bits : i64 (compiler-live-set-word-at-bounded uses word-index)]
            [base : i64 (* word-index (compiler-live-set-word-bits))]
            [bit : i64 0]
            (begin
              (while (not (= bits 0))
                (begin
                  (if (not (= (bit-and bits 1) 0))
                    (let
                      [var : i64 (+ base bit)]
                      (if (and
                        (< var vars)
                        (compiler-reg-remat-table-eligible?
                          table
                          assignments
                          parents
                          merged-roots
                          var))
                        (match (compiler-reg-remat-selected-register
                          table
                          assignments
                          intervals
                          point
                          chosen
                          var)
                          [(CompilerRegMaybeId.Some reg)
                            (let
                              [temp : i64 out-next-var]
                              [ty : AstType (array-ref types var)]
                              (begin
                                (array-set! remap var temp)
                                ;; Recipes for one instruction are pushed in
                                ;; the order they are chosen (ascending operand
                                ;; var). That is exactly the order the old
                                ;; reverse-consed `prefix` produced once the
                                ;; reversed accumulator was flipped at the end.
                                (compiler-ir-instr-builder-push!
                                  (&mut builder)
                                  (compiler-reg-remat-instr table temp var))
                                (set! chosen (compiler-reg-id-cons reg chosen))
                                (set!
                                  out-extra-assignments
                                  (compiler-reg-assignment-cons
                                    (CompilerRegAssignment
                                      temp
                                      (CompilerRegLocation.Register reg))
                                    out-extra-assignments))
                                (set!
                                  out-extra-types
                                  (compiler-reg-var-type-insert
                                    out-extra-types
                                    temp
                                    ty))
                                (set! out-next-var (+ out-next-var 1))))]
                          [(CompilerRegMaybeId.No) unit])
                        unit))
                    unit)
                  (set! bits (shr bits 1))
                  (set! bit (+ bit 1))))
              (set! word-index (+ word-index 1)))))
        (if (= out-next-var next-var)
          (begin
            (compiler-ir-instr-builder-push! (&mut builder) instr)
            (CompilerRegCallSaveInstrRewrite.Rewrite
              (+ point 2)
              out-next-var
              out-extra-assignments
              out-extra-types))
          (let
            [rewritten : CompilerIrInstr (compiler-reg-remap-instr remap instr)]
            (begin
              ;; Restore the shared remap array to identity for the next instr.
              (compiler-reg-remat-reset-remap-uses! remap uses vars)
              (compiler-ir-instr-builder-push! (&mut builder) rewritten)
              (CompilerRegCallSaveInstrRewrite.Rewrite
                (+ point 2)
                out-next-var
                out-extra-assignments
                out-extra-types))))))
    (begin
      (compiler-ir-instr-builder-push! (&mut builder) instr)
      (CompilerRegCallSaveInstrRewrite.Rewrite
        (+ point 2)
        next-var
        extra-assignments
        extra-types))))

;; Scan one block's instructions forward, appending each rewritten instruction
;; (preceded by the remat recipes it needs) to the caller's builder. The old
;; shape converted the block to a cons list, walked it building a REVERSED cons
;; accumulator, and flipped it with `compiler-ir-instr-list-reverse-onto`; the
;; forward scan emits in the same final order with no list at all.
(define (compiler-reg-remat-rewrite-instrs
  [instrs : CompilerIrInstrSeq]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentList]
  [extra-types : CompilerRegVarTypeList]
  [remap : (Array i64)]
  [builder : (&mut builder CompilerIrInstrBuilder)]) : CompilerRegCallSaveInstrRewrite
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-instr-seq-count instrs)]
    [out-point : i64 point]
    [out-next-var : i64 next-var]
    [out-extra-assignments : CompilerRegAssignmentList extra-assignments]
    [out-extra-types : CompilerRegVarTypeList extra-types]
    (begin
      (while (< index count)
        (begin
          (match (compiler-reg-remat-rewrite-one-instr
            (compiler-ir-instr-seq-ref instrs index)
            out-point
            vars
            out-next-var
            table
            assignments
            intervals
            parents
            merged-roots
            out-extra-assignments
            out-extra-types
            remap
            (&mut builder))
            [(CompilerRegCallSaveInstrRewrite.Rewrite
                point2
                next-var2
                extra-assignments2
                extra-types2)
              (begin
                (set! out-point point2)
                (set! out-next-var next-var2)
                (set! out-extra-assignments extra-assignments2)
                (set! out-extra-types extra-types2))])
          (set! index (+ index 1))))
      (CompilerRegCallSaveInstrRewrite.Rewrite
        out-point
        out-next-var
        out-extra-assignments
        out-extra-types))))

(define (compiler-reg-remat-rewrite-blocks-rev
  [blocks : CompilerIrBlockList]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentList]
  [extra-types : CompilerRegVarTypeList]
  [remap : (Array i64)]
  [acc : CompilerIrBlockList]) : CompilerRegCallSaveRewrite
  (match blocks
    [(CompilerIrBlockList.Nil)
      (CompilerRegCallSaveRewrite.Rewrite
        acc
        point
        next-var
        extra-assignments
        extra-types)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            ;; Seeded at the block's own length: remat only ever appends recipe
            ;; instructions, and the (majority) blocks with no eligible operand
            ;; land exactly on this capacity with no grow.
            [builder : CompilerIrInstrBuilder
              (compiler-ir-instr-builder-with-capacity
                (compiler-ir-instr-seq-count instrs))]
            (match (compiler-reg-remat-rewrite-instrs
              instrs
              point
              vars
              next-var
              table
              assignments
              intervals
              parents
              merged-roots
              extra-assignments
              extra-types
              remap
              (&mut builder))
              [(CompilerRegCallSaveInstrRewrite.Rewrite
                  next-point
                  next-var2
                  extra-assignments2
                  extra-types2)
                (compiler-reg-remat-rewrite-blocks-rev
                  (box-get rest)
                  next-point
                  vars
                  next-var2
                  table
                  assignments
                  intervals
                  parents
                  merged-roots
                  extra-assignments2
                  extra-types2
                  remap
                  (compiler-ir-block-cons
                    (CompilerIrBlock.Block
                      label
                      (compiler-ir-instr-builder-to-seq builder))
                    acc))]))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-reg-remat-rewrite-block-seq-rev
        seq
        point
        vars
        next-var
        table
        assignments
        intervals
        parents
        merged-roots
        extra-assignments
        extra-types
        remap
        acc)]))

(define (compiler-reg-remat-rewrite-block-seq-rev
  [seq : CompilerIrBlockSeq]
  [point : i64]
  [vars : i64]
  [next-var : i64]
  [table : CompilerRegRematTable]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalIndex]
  [parents : (Array i64)]
  [merged-roots : CompilerLiveI64Set]
  [extra-assignments : CompilerRegAssignmentList]
  [extra-types : CompilerRegVarTypeList]
  [remap : (Array i64)]
  [acc : CompilerIrBlockList]) : CompilerRegCallSaveRewrite
  (let
    [i : i64 0]
    [count : i64 (compiler-ir-block-seq-count seq)]
    [out-point : i64 point]
    [out-next-var : i64 next-var]
    [out-extra-assignments : CompilerRegAssignmentList extra-assignments]
    [out-extra-types : CompilerRegVarTypeList extra-types]
    [out-acc : CompilerIrBlockList acc]
    (begin
      (while (< i count)
        (begin
          (match (compiler-ir-block-seq-ref seq i)
            [(CompilerIrBlock.Block label instrs)
              (let
                [builder : CompilerIrInstrBuilder
                  (compiler-ir-instr-builder-with-capacity
                    (compiler-ir-instr-seq-count instrs))]
                (match (compiler-reg-remat-rewrite-instrs
                  instrs
                  out-point
                  vars
                  out-next-var
                  table
                  assignments
                  intervals
                  parents
                  merged-roots
                  out-extra-assignments
                  out-extra-types
                  remap
                  (&mut builder))
                  [(CompilerRegCallSaveInstrRewrite.Rewrite
                      next-point
                      next-var2
                      extra-assignments2
                      extra-types2)
                    (begin
                      (set! out-point next-point)
                      (set! out-next-var next-var2)
                      (set! out-extra-assignments extra-assignments2)
                      (set! out-extra-types extra-types2)
                      (set!
                        out-acc
                        (compiler-ir-block-cons
                          (CompilerIrBlock.Block
                            label
                            (compiler-ir-instr-builder-to-seq builder))
                          out-acc)))]))])
          (set! i (+ i 1))))
      (CompilerRegCallSaveRewrite.Rewrite
        out-acc
        out-point
        out-next-var
        out-extra-assignments
        out-extra-types))))

;; Remat replaces spilled cheap-recompute defs with recompute-at-use homes;
;; with no Spill assignment in the plan there is nothing to rescue, so skip
;; the remat table, liveness fixpoint, interval selection, and coalesce map
;; for the (majority) spill-free functions.
(define (compiler-reg-assignments-have-spill?
  [assignments : CompilerRegAssignmentList]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (match (struct-get item location)
        [(CompilerRegLocation.Spill _) true]
        [_ (compiler-reg-assignments-have-spill? (box-get rest))])]))

(define (compiler-reg-remat-rewrite-blocks
  [type-segment-bases : i64]
  [func : CompilerIrFunction]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (if (not
    (compiler-reg-assignments-have-spill? (compiler-reg-plan-assignments plan)))
    (CompilerRegCallSaveRewrite.Rewrite
      blocks
      vars
      vars
      CompilerRegAssignmentList.Nil
      CompilerRegVarTypeList.Nil)
    (let
      [table : CompilerRegRematTable (compiler-reg-remat-table-build func)]
      [types : CompilerRegVarTypeList (compiler-reg-var-types-list type-info)]
      [group-vars : CompilerLiveI64Set
        (compiler-reg-function-group-vars type-segment-bases func types)]
      [liveness-handle : CompilerRegLivenessHandle
        (compiler-reg-liveness-handle-make func false)]
      [liveness : CompilerFunctionLiveness
        (struct-get liveness-handle baseline)]
      (match (compiler-reg-live-interval-selection func liveness)
        [(CompilerRegIntervalSelection.Selection intervals interval-index)
          (let
            [coalesce : CompilerRegCoalesceMap
              (compiler-reg-coalesce-map-build
                (compiler-reg-function-moves func false)
                interval-index
                type-info
                group-vars
                vars
                (array.make-array i64 0))]
            [parents : (Array i64) (struct-get coalesce parents)]
            [merged-roots : CompilerLiveI64Set
              (compiler-reg-coalesce-merged-root-set coalesce)]
            ;; One function-scoped identity remap array, reused across every
            ;; instruction. Each rewritten instruction restores the few bits it
            ;; touches (see compiler-reg-remat-reset-remap-uses!), replacing the
            ;; old per-instruction O(vars) allocation + zero + identity fill.
            [remap : (Array i64) (compiler-reg-caller-save-remap vars)]
            (match (compiler-reg-remat-rewrite-blocks-rev
              blocks
              0
              vars
              vars
              table
              (compiler-reg-plan-assignments plan)
              interval-index
              parents
              merged-roots
              CompilerRegAssignmentList.Nil
              CompilerRegVarTypeList.Nil
              remap
              CompilerIrBlockList.Nil)
              [(CompilerRegCallSaveRewrite.Rewrite
                  rev
                  _
                  out-vars
                  extra-assignments
                  extra-types)
                (CompilerRegCallSaveRewrite.Rewrite
                  (compiler-ir-block-list-reverse-onto
                    rev
                    CompilerIrBlockList.Nil)
                  vars
                  out-vars
                  extra-assignments
                  extra-types)]))]))))

(define (compiler-reg-location-register?
  [maybe-location : CompilerRegMaybeLocation]
  [reg : i64]) : bool
  (match maybe-location
    [(CompilerRegMaybeLocation.Some location)
      (compiler-reg-location-uses-register? location reg)]
    [_ false]))

(define (compiler-reg-location-spill-offset?
  [maybe-location : CompilerRegMaybeLocation]
  [offset : i64]) : bool
  (match maybe-location
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Spill found) (= found offset)]
        [_ false])]
    [_ false]))

(define (compiler-reg-unassigned?
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments var)
    [(CompilerRegMaybeLocation.No) true]
    [_ false]))

(define (compiler-reg-location-any-register?
  [maybe-location : CompilerRegMaybeLocation]) : bool
  (match maybe-location
    [(CompilerRegMaybeLocation.Some location)
      (match location
        [(CompilerRegLocation.Register _) true]
        [(CompilerRegLocation.RegisterPair _ _) true]
        [_ false])]
    [_ false]))

(define (compiler-reg-switch-scratch-test-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      (compiler-ir-label "entry")
      (compiler-ir-instr-cons
        (CompilerIrInstr.Switch
          (CompilerIrValue.Var 0)
          1
          (compiler-ir-switch-case-cons
            1
            (compiler-ir-label "one")
            CompilerIrSwitchCaseList.Nil)
          (compiler-ir-label "other"))
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-reg-switch-scratch-test-function) : CompilerIrFunction
  (CompilerIrFunction.Function
    (compiler-ir-test-symbol "switch_scratch_vregs")
    CompilerIrParamList.Nil
    (AstType.I64)
    1
    (compiler-reg-switch-scratch-test-blocks)))

(define (compiler-reg-switch-scratch-test-plan) : CompilerRegPlan
  (CompilerRegPlan.Plan
    (compiler-reg-assignment-cons
      (CompilerRegAssignment
        0
        (CompilerRegLocation.Register compiler-reg-id-r9))
      CompilerRegAssignmentList.Nil)
    (compiler-live-set-empty)
    (compiler-reg-interval-seq-prepend
      (CompilerRegInterval 0 0 1)
      (compiler-reg-interval-seq-empty))
    (compiler-reg-var-type-cons
      (CompilerRegVarType 0 (AstType.I64))
      CompilerRegVarTypeList.Nil)
    (compiler-reg-call-split-empty)
    (compiler-reg-split-plan-empty)))

(define (compiler-reg-switch-scratch-vregs-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [func : CompilerIrFunction (compiler-reg-switch-scratch-test-function)]
      [plan : CompilerRegPlan (compiler-reg-switch-scratch-test-plan)]
      (match (compiler-reg-plan-with-scratch-vreg-result
        (ast-node-pool-reader-type-segment-bases)
        (CompilerRegTargetAbi.Linux)
        func
        plan
        1)
        [(CompilerRegScratchPlanResult.Result out scratch-plan)
          (let
            [index-reg : i64
              (compiler-reg-scratch-plan-register scratch-plan 0 0)]
            [table-reg : i64
              (compiler-reg-scratch-plan-register scratch-plan 0 1)]
            (and
              (= (compiler-reg-plan-var-count out 1) 1)
              (= (compiler-reg-scratch-plan-count scratch-plan) 2)
              (not (= index-reg compiler-reg-id-invalid))
              (not (= table-reg compiler-reg-id-invalid))
              (not (= index-reg table-reg))
              (not (= index-reg compiler-reg-id-r9))
              (not (= table-reg compiler-reg-id-r9))))]))
    true))

(define (compiler-reg-bounds-scratch-test-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      (compiler-ir-label "entry")
      (compiler-ir-instr-cons
        (CompilerIrInstr.BoundsCheck
          (CompilerIrValue.Var 0)
          (CompilerIrValue.I64 8)
          (compiler-ir-label "ok"))
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-reg-bounds-scratch-test-function) : CompilerIrFunction
  (CompilerIrFunction.Function
    (compiler-ir-test-symbol "bounds_scratch_vregs")
    CompilerIrParamList.Nil
    (AstType.I64)
    1
    (compiler-reg-bounds-scratch-test-blocks)))

(define (compiler-reg-bounds-scratch-vregs-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [func : CompilerIrFunction (compiler-reg-bounds-scratch-test-function)]
      [plan : CompilerRegPlan (compiler-reg-switch-scratch-test-plan)]
      (match (compiler-reg-plan-with-scratch-vreg-result
        (ast-node-pool-reader-type-segment-bases)
        (CompilerRegTargetAbi.Linux)
        func
        plan
        1)
        [(CompilerRegScratchPlanResult.Result out scratch-plan)
          (let
            [length-reg : i64
              (compiler-reg-scratch-plan-register scratch-plan 0 0)]
            [index-reg : i64
              (compiler-reg-scratch-plan-register scratch-plan 0 1)]
            (and
              (= (compiler-reg-plan-var-count out 1) 1)
              (= (compiler-reg-scratch-plan-count scratch-plan) 2)
              (not (= length-reg compiler-reg-id-invalid))
              (not (= index-reg compiler-reg-id-invalid))
              (not (= length-reg index-reg))
              (not (= length-reg compiler-reg-id-r9))
              (not (= index-reg compiler-reg-id-r9))))]))
    true))

(define (compiler-reg-memory-scratch-test-plan) : CompilerRegPlan
  (CompilerRegPlan.Plan
    (compiler-reg-assignment-cons
      (CompilerRegAssignment
        0
        (CompilerRegLocation.Register compiler-reg-id-r9))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment
          1
          (CompilerRegLocation.Register compiler-reg-id-r10))
        CompilerRegAssignmentList.Nil))
    (compiler-live-set-empty)
    (compiler-reg-interval-seq-prepend
      (CompilerRegInterval 0 0 1)
      (compiler-reg-interval-seq-prepend
        (CompilerRegInterval 1 0 1)
        (compiler-reg-interval-seq-empty)))
    (compiler-reg-var-type-cons
      (CompilerRegVarType 0 (AstType.U64))
      (compiler-reg-var-type-cons
        (CompilerRegVarType 1 (AstType.U64))
        CompilerRegVarTypeList.Nil))
    (compiler-reg-call-split-empty)
    (compiler-reg-split-plan-empty)))

(define (compiler-reg-memory-scratch-test-function) : CompilerIrFunction
  (CompilerIrFunction.Function
    (intern "memory_scratch_vregs")
    CompilerIrParamList.Nil
    (AstType.Unit)
    2
    (compiler-ir-block-cons
      (compiler-ir-block
        (compiler-ir-label "entry")
        (compiler-ir-instr-cons
          (CompilerIrInstr.CopyBytes
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            7)
          CompilerIrInstrList.Nil))
      CompilerIrBlockList.Nil)))

(define (compiler-reg-memory-scratch-vregs-ok?) : bool
  (cfg
    scratch-vreg
    (match (compiler-reg-plan-with-scratch-vreg-result
      (ast-node-pool-reader-type-segment-bases)
      (CompilerRegTargetAbi.Linux)
      (compiler-reg-memory-scratch-test-function)
      (compiler-reg-memory-scratch-test-plan)
      2)
      [(CompilerRegScratchPlanResult.Result _ scratch-plan)
        (let
          [dst : i64 (compiler-reg-scratch-plan-register scratch-plan 0 0)]
          [src : i64 (compiler-reg-scratch-plan-register scratch-plan 0 1)]
          [value : i64 (compiler-reg-scratch-plan-register scratch-plan 0 2)]
          (and
            (= (compiler-reg-scratch-plan-count scratch-plan) 3)
            (not (= dst compiler-reg-id-invalid))
            (not (= src compiler-reg-id-invalid))
            (not (= value compiler-reg-id-invalid))
            (not (= dst src))
            (not (= dst value))
            (not (= src value))
            (not (= dst compiler-reg-id-r9))
            (not (= dst compiler-reg-id-r10))
            (not (= src compiler-reg-id-r9))
            (not (= src compiler-reg-id-r10))
            (not (= value compiler-reg-id-r9))
            (not (= value compiler-reg-id-r10))))])
    true))

(define (compiler-reg-early-scratch-test-function) : CompilerIrFunction
  (CompilerIrFunction.Function
    (compiler-ir-test-symbol "early_scratch_literal_divmod")
    CompilerIrParamList.Nil
    (AstType.I64)
    2
    (compiler-ir-block-cons
      (compiler-ir-block
        (compiler-ir-label "entry")
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 0 (CompilerIrValue.I64 42) (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp
              1
              (CompilerIrBinOp.SafeMod)
              (CompilerIrValue.Var 0)
              (CompilerIrValue.I64 7)
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Return
                (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
              CompilerIrInstrList.Nil))))
      CompilerIrBlockList.Nil)))

(define (compiler-reg-early-scratch-nontarget-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      (compiler-ir-label "entry")
      (compiler-ir-instr-cons
        (CompilerIrInstr.BoundsCheck
          (CompilerIrValue.Var 0)
          (CompilerIrValue.I64 8)
          (compiler-ir-label "ok"))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Switch
            (CompilerIrValue.Var 0)
            1
            CompilerIrSwitchCaseList.Nil
            (compiler-ir-label "other"))
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp
              1
              (CompilerIrBinOp.SafeMod)
              (CompilerIrValue.Var 0)
              (CompilerIrValue.Var 1)
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                1
                (CompilerIrBinOp.Mod)
                (CompilerIrValue.Var 0)
                (CompilerIrValue.I64 7)
                (AstType.I64))
              CompilerIrInstrList.Nil)))))
    CompilerIrBlockList.Nil))

(define (compiler-reg-early-scratch-slot-range-ok?
  [model : CompilerRegEarlyScratchModel]
  [offset : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [var : i64 (+ (struct-get model scratch-base) offset)]
    [index : CompilerRegIntervalIndex (struct-get model interval-index)]
    (and
      (= (array-ref (struct-get index starts) var) lo)
      (= (array-ref (struct-get index ends) var) hi)
      (let
        [segments : CompilerRegIntervalSeq
          (array-ref (struct-get index segments) var)]
        (and
          (= (compiler-reg-interval-seq-count segments) 1)
          (let
            [found : CompilerRegInterval
              (compiler-reg-interval-seq-ref segments 0)]
            (and
              (= (struct-get found var) var)
              (= (struct-get found start) lo)
              (= (struct-get found end) hi))))))))

(define (compiler-reg-early-scratch-model-for-test [abi : CompilerRegTargetAbi]) : CompilerRegEarlyScratchModel
  (let
    [func : CompilerIrFunction (compiler-reg-early-scratch-test-function)]
    [types : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    (match (compiler-reg-live-interval-selection
      func
      (compiler-live-analyze-function func))
      [(CompilerRegIntervalSelection.Selection _ index)
        (compiler-reg-early-scratch-model
          (ast-node-pool-reader-type-segment-bases)
          abi
          func
          index
          types
          (compiler-reg-assignment-table-insert
            (compiler-reg-assignment-table-make 2)
            0
            (CompilerRegLocation.Register compiler-reg-id-r10))
          true)])))

(define (compiler-reg-early-scratch-model-one-abi-ok?
  [abi : CompilerRegTargetAbi]) : bool
  (let
    [model : CompilerRegEarlyScratchModel
      (compiler-reg-early-scratch-model-for-test abi)]
    [assignments : CompilerRegAssignmentTable (struct-get model assignments)]
    [base : i64 (struct-get model scratch-base)]
    [weights : (Array i64) (struct-get model scratch-weights)]
    [excluded : (Array CompilerRegIdList) (struct-get model scratch-excluded)]
    (and
      (= base 2)
      (= (struct-get model scratch-count) 5)
      (= (array-length weights) 5)
      (= (array-ref weights 0) 0)
      (= (array-ref weights 1) 0)
      (= (array-ref weights 2) 1)
      (= (array-ref weights 3) 1)
      (= (array-ref weights 4) 1)
      (compiler-reg-id-list-contains?
        (array-ref excluded (+ base 2))
        compiler-reg-id-r10)
      (compiler-reg-id-list-contains?
        (array-ref excluded (+ base 3))
        compiler-reg-id-r10)
      (compiler-reg-id-list-contains?
        (array-ref excluded (+ base 4))
        compiler-reg-id-r10)
      (compiler-reg-early-scratch-slot-range-ok? model 0 2 3)
      (compiler-reg-early-scratch-slot-range-ok? model 1 2 3)
      (compiler-reg-early-scratch-slot-range-ok? model 2 2 3)
      (compiler-reg-early-scratch-slot-range-ok? model 3 2 3)
      (compiler-reg-early-scratch-slot-range-ok? model 4 2 3)
      (compiler-reg-location-register?
        (compiler-reg-assignment-table-lookup assignments base)
        compiler-reg-id-rax)
      (compiler-reg-location-register?
        (compiler-reg-assignment-table-lookup assignments (+ base 1))
        compiler-reg-id-rdx)
      (match (compiler-reg-assignment-table-lookup assignments (+ base 2))
        [(CompilerRegMaybeLocation.No) true]
        [_ false])
      (match (compiler-reg-assignment-table-lookup assignments (+ base 3))
        [(CompilerRegMaybeLocation.No) true]
        [_ false])
      (match (compiler-reg-assignment-table-lookup assignments (+ base 4))
        [(CompilerRegMaybeLocation.No) true]
        [_ false]))))

(define (compiler-reg-early-scratch-model-ok?) : bool
  (and
    (=
      (compiler-reg-early-scratch-count-blocks
        (compiler-reg-early-scratch-nontarget-blocks))
      0)
    (compiler-reg-early-scratch-model-one-abi-ok? (CompilerRegTargetAbi.Linux))
    (compiler-reg-early-scratch-model-one-abi-ok?
      (CompilerRegTargetAbi.Windows))))

(define (compiler-reg-scratch-default-pool-target-invariant-ok?) : bool
  (let
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-prepend
        (CompilerRegInterval 0 0 1)
        (compiler-reg-interval-seq-empty))]
    [index : CompilerRegIntervalIndex
      (compiler-reg-interval-index-build intervals 1)]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-make 1)]
    [linux-registers : (Array i64)
      (compiler-reg-scratch-register-array (CompilerRegTargetAbi.Linux))]
    [windows-registers : (Array i64)
      (compiler-reg-scratch-register-array (CompilerRegTargetAbi.Windows))]
    [linux-occupancy : CompilerRegGreedyOccupancy
      (compiler-reg-greedy-occupancy-make
        assignments
        linux-registers
        (array-length linux-registers))]
    [windows-occupancy : CompilerRegGreedyOccupancy
      (compiler-reg-greedy-occupancy-make
        assignments
        windows-registers
        (array-length windows-registers))]
    [excluded : CompilerRegIdList
      (compiler-reg-id-cons compiler-reg-id-rax CompilerRegIdList.Nil)]
    (and
      (=
        (compiler-reg-scratch-pick-register
          assignments
          linux-occupancy
          index
          (array.make-array i64 0)
          linux-registers
          (array-length linux-registers)
          0
          1
          (compiler-reg-scratch-default-pool
            (CompilerRegTargetAbi.Linux)
            (CompilerRegScratchClass.Gp))
          excluded)
        compiler-reg-id-rsi)
      (=
        (compiler-reg-scratch-pick-register
          assignments
          windows-occupancy
          index
          (array.make-array i64 0)
          windows-registers
          (array-length windows-registers)
          0
          1
          (compiler-reg-scratch-default-pool
            (CompilerRegTargetAbi.Windows)
            (CompilerRegScratchClass.Gp))
          excluded)
        compiler-reg-id-rsi)
      ;; XMM volatility differs materially across ABIs and remains ABI-aware.
      (=
        (compiler-reg-scratch-pick-register
          assignments
          windows-occupancy
          index
          (array.make-array i64 0)
          windows-registers
          (array-length windows-registers)
          0
          1
          (compiler-reg-scratch-default-pool
            (CompilerRegTargetAbi.Windows)
            (CompilerRegScratchClass.Xmm))
          CompilerRegIdList.Nil)
        (cfg
          scratch-vreg
          (compiler-abi-xmm-register-id 0)
          (compiler-abi-xmm-register-id 2))))))

(define (compiler-reg-scratch-callee-saved-registers-ok?) : bool
  (and
    (compiler-reg-scratch-callee-saved-register?
      (CompilerRegTargetAbi.Linux)
      compiler-reg-id-r12)
    (compiler-reg-scratch-callee-saved-register?
      (CompilerRegTargetAbi.Linux)
      compiler-reg-id-rbp)
    (not
      (compiler-reg-scratch-callee-saved-register?
        (CompilerRegTargetAbi.Linux)
        compiler-reg-id-rsi))
    (not
      (compiler-reg-scratch-callee-saved-register?
        (CompilerRegTargetAbi.Linux)
        (compiler-abi-xmm-register-id 6)))
    (compiler-reg-scratch-callee-saved-register?
      (CompilerRegTargetAbi.Windows)
      compiler-reg-id-rsi)
    (compiler-reg-scratch-callee-saved-register?
      (CompilerRegTargetAbi.Windows)
      compiler-reg-id-rdi)
    (compiler-reg-scratch-callee-saved-register?
      (CompilerRegTargetAbi.Windows)
      (compiler-abi-xmm-register-id 6))
    (not
      (compiler-reg-scratch-callee-saved-register?
        (CompilerRegTargetAbi.Windows)
        (compiler-abi-xmm-register-id 5)))))

(define (compiler-reg-early-scratch-never-spills-ok?) : bool
  (let
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-prepend
        (CompilerRegInterval 0 0 4)
        (compiler-reg-interval-seq-prepend
          (CompilerRegInterval 1 1 3)
          (compiler-reg-interval-seq-empty)))]
    [index : CompilerRegIntervalIndex
      (compiler-reg-interval-index-build intervals 2)]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 2)
        0
        (CompilerRegLocation.Register compiler-reg-id-r12))]
    [base-weights : (Array i64) (array.make-array i64 1)]
    [raw-weights : (Array i64) (array.make-array i64 1)]
    [scratch-weights : (Array i64) (array.make-array i64 1)]
    [weights : (Array i64) (array.make-array i64 2)]
    [hints : (Array i64) (array.make-array i64 2)]
    (begin
      (array-set! base-weights 0 3)
      (array-set! raw-weights 0 1)
      (array-set! scratch-weights 0 1)
      (set!
        weights
        (compiler-reg-early-scratch-extend-weights
          base-weights
          raw-weights
          2
          1
          1
          scratch-weights))
      (compiler-reg-fill-i64-array hints -1)
      (match (compiler-reg-greedy-state
        intervals
        (compiler-reg-id-cons compiler-reg-id-r12 CompilerRegIdList.Nil)
        assignments
        index
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        weights
        hints
        hints
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (compiler-reg-id-cons compiler-reg-id-r12 CompilerRegIdList.Nil)
        0
        1)
        [(CompilerRegAssignState.State _ out)
          (and
            (= (array-ref weights 0) 3)
            (= (array-ref weights 1) 4)
            (compiler-reg-location-spill-offset?
              (compiler-reg-assignment-table-lookup out 0)
              (compiler-reg-stack-slot-offset 0))
            (compiler-reg-location-register?
              (compiler-reg-assignment-table-lookup out 1)
              compiler-reg-id-r12))]))))

(define (compiler-reg-early-scratch-exclusion-rehomes-ok?) : bool
  (let
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-prepend
        (CompilerRegInterval 0 0 4)
        (compiler-reg-interval-seq-prepend
          (CompilerRegInterval 1 1 3)
          (compiler-reg-interval-seq-empty)))]
    [index : CompilerRegIntervalIndex
      (compiler-reg-interval-index-build intervals 2)]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 2)
        0
        (CompilerRegLocation.Register compiler-reg-id-r12))]
    [weights : (Array i64) (array.make-array i64 2)]
    [hints : (Array i64) (array.make-array i64 2)]
    [excluded : (Array CompilerRegIdList)
      (array.make-array CompilerRegIdList 2)]
    (begin
      (array-set! weights 0 1)
      (array-set! weights 1 2)
      (compiler-reg-fill-i64-array hints -1)
      ;; %r10 is free but is the instruction operand home. The scratch pseudo
      ;; must instead evict the colder, CSR-only real value from %r12; when that
      ;; value is requeued it has no legal register and receives a real spill.
      (array-set!
        excluded
        1
        (compiler-reg-id-cons compiler-reg-id-r10 CompilerRegIdList.Nil))
      (match (compiler-reg-greedy-state-with-scratch-exclusions
        intervals
        (compiler-reg-id-cons
          compiler-reg-id-r10
          (compiler-reg-id-cons compiler-reg-id-r12 CompilerRegIdList.Nil))
        assignments
        index
        (compiler-live-set-empty)
        (compiler-live-set-insert (compiler-live-set-empty) 0)
        weights
        hints
        hints
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (compiler-reg-id-cons compiler-reg-id-r12 CompilerRegIdList.Nil)
        1
        1
        excluded)
        [(CompilerRegAssignState.State _ out)
          (and
            (compiler-reg-location-spill-offset?
              (compiler-reg-assignment-table-lookup out 0)
              (compiler-reg-stack-slot-offset 0))
            (compiler-reg-location-register?
              (compiler-reg-assignment-table-lookup out 1)
              compiler-reg-id-r12))]))))

