        [i : i64 0]
        (while (< i vars)
          (begin
            (set! (array-ref range-of-var i) (- 0 1))
            (set! (array-ref range-base i) (- 0 1))
            (set! i (+ i 1)))))]
    [range-count : i64
      (compiler-reg-color-detect-storage-blocks
        blocks
        range-of-var
        range-base
        range-size
        0)]
