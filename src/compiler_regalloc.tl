    [scratch-state : CompilerRegAssignState
      (if (= early-scratch-count 0)
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          (compiler-reg-global-shared-view scratch-input-assignments))
        (compiler-reg-greedy-state-with-scratch-exclusions
          (compiler-reg-global-shared-view scratch-candidates)
          (compiler-reg-greedy-integer-pool-for-abi target-abi)
          (compiler-reg-global-shared-view scratch-input-assignments)
          (compiler-reg-global-shared-view allocation-index)
          (compiler-reg-global-shared-view group-vars)
          (compiler-reg-global-shared-view param-roots)
          (compiler-reg-global-shared-view eviction-ref-counts)
          (compiler-reg-global-shared-view copy-hints)
          (compiler-reg-global-shared-view arg-prefs)
          (compiler-reg-global-shared-view call-points)
          (compiler-reg-global-shared-view div-points)
          (compiler-reg-global-shared-view shift-points)
          (compiler-reg-global-shared-view integer-registers)
          (compiler-reg-greedy-caller-saved-count-for-abi target-abi)
          early-scratch-base
          (compiler-reg-global-shared-view early-scratch-excluded)))]
    [integer-scratch-assignments : CompilerRegAssignmentTable
      (match (compiler-reg-global-shared-view scratch-state)
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [integer-assignments : CompilerRegAssignmentTable
      (if (or
        (= early-scratch-count 0)
        (compiler-reg-assignment-table-prefix-eq?
          (compiler-reg-global-shared-view base-integer-assignments)
          (compiler-reg-global-shared-view integer-scratch-assignments)
          early-scratch-base
          0))
        (compiler-reg-global-shared-view base-integer-assignments)
        (compiler-reg-assignment-table-prefix
          (compiler-reg-global-shared-view integer-scratch-assignments)
          early-scratch-base))]
    [early-scratch-moved-real? : bool
      (and
        (> early-scratch-count 0)
        (not
          (compiler-reg-assignment-table-prefix-eq?
            (compiler-reg-global-shared-view base-integer-assignments)
            (compiler-reg-global-shared-view integer-assignments)
            early-scratch-base
            0)))]
    ;; Step B: the caller-saved-overflow pass is gone -- the unified greedy already
    ;; allocates the caller-saved zero-call prefix itself, so retrying the same
    ;; registers here was redundant. The call-spanning save/restore rescue (a
    ;; real spill-avoidance, not a register-allocation pass) is kept and fed the
    ;; greedy's assignments directly.
    [integer-with-call-save-state : CompilerRegCallSaveAssignState
      (if (and
        allow-caller-saved-zero-call
        (compiler-reg-assignment-table-has-spill?
          (compiler-reg-global-shared-view integer-assignments)))
        (compiler-reg-assign-caller-saved-call-spanning
          type-segment-bases
          target-abi
          (compiler-reg-global-shared-view func)
          (compiler-reg-global-shared-view integer-candidates)
          (compiler-reg-global-shared-view integer-assignments)
          (compiler-reg-global-shared-view eff-index)
          (compiler-reg-global-shared-view type-info)
          (compiler-reg-global-shared-view group-vars)
          (compiler-reg-global-shared-view coalesce.parents)
          (compiler-reg-global-shared-view base-eviction-ref-counts))
        (CompilerRegCallSaveAssignState.State
          (compiler-reg-global-shared-view integer-assignments)
          (compiler-reg-call-split-empty)))]
    [integer-call-assignments : CompilerRegAssignmentTable
      (match (compiler-reg-global-shared-view integer-with-call-save-state)
        [(CompilerRegCallSaveAssignState.State assignments _) assignments])]
    [call-save-split : CompilerRegCallSplit
      (match (compiler-reg-global-shared-view integer-with-call-save-state)
        [(CompilerRegCallSaveAssignState.State _ split) split])]
    [call-save-shadows : live.CompilerLiveI64Set
      (compiler-reg-call-split-shadows
        (compiler-reg-global-shared-view call-save-split))]
    [scalar-state
      : CompilerRegAssignState
      ;; float -> XMM allocation: the unified greedy over the ABI XMM bank.
      ;; A clobber-spanning float starts at the ABI callee-saved suffix: none on
      ;; SysV (so it spills), XMM6-XMM15 on Win64. Non-spanning floats may use the
      ;; whole configured XMM pool. Reuse the coalesced-class spill weights and copy
      ;; hints so float pressure is ordered by actual use density and moves bias
      ;; toward an already assigned neighbour, matching the integer greedy.
      (compiler-reg-greedy-state-with-scratch-exclusions
        (compiler-reg-candidates
          (compiler-reg-global-shared-view eff-intervals)
          (compiler-reg-global-shared-view type-info)
          (compiler-reg-global-shared-view eff-blocked)
          true)
        (compiler-reg-xmm-registers-for-abi target-abi)
        (compiler-reg-global-shared-view integer-call-assignments)
        (compiler-reg-global-shared-view eff-index)
        (compiler-reg-global-shared-view group-vars)
        (compiler-reg-global-shared-view param-roots)
        (compiler-reg-global-shared-view base-eviction-ref-counts)
        (compiler-reg-global-shared-view copy-hints)
        (compiler-reg-global-shared-view float-arg-prefs)
        (compiler-reg-global-shared-view xmm-call-points)
        (compiler-reg-global-shared-view div-points)
        (compiler-reg-global-shared-view shift-points)
        (compiler-reg-xmm-callee-registers-for-abi target-abi)
        (compiler-reg-xmm-caller-register-count-for-abi target-abi)
        -1
        (compiler-reg-global-shared-view low-xmm-exclusions))]
    [scalar-assignments : CompilerRegAssignmentTable
      (match (compiler-reg-global-shared-view scalar-state)
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [_float-call-arg-demote : unit
      (if allow-caller-saved-zero-call
        (compiler-reg-float-call-args-demote!
          target-abi
          (compiler-reg-global-shared-view func)
          (compiler-reg-global-shared-view type-info)
          (compiler-reg-global-shared-view coalesce)
          (compiler-reg-global-shared-view scalar-assignments))
        unit)]
    [vector-vars : live.CompilerLiveI64Set
      (compiler-reg-global-shared-view vector-mask-defs.uses)]
    [mask-vars : live.CompilerLiveI64Set
      (compiler-reg-global-shared-view vector-mask-defs.defs)]
    ;; Scalar-only functions (no vector or mask IR values) have no special
    ;; candidates at all: the select-false preference walk, both special-candidate
    ;; interval filters, the vector greedy, and the mask fixed-candidate pass all
    ;; return their inputs unchanged, so skip the whole vector/mask prep chain.
    [vector-mask-empty? : bool
      (and
        (=
          (live.compiler-live-set-count
            (compiler-reg-global-shared-view vector-vars))
          0)
        (=
          (live.compiler-live-set-count
            (compiler-reg-global-shared-view mask-vars))
          0))]
    [vector-candidate-vars : live.CompilerLiveI64Set
      (if vector-mask-empty?
        (compiler-reg-global-shared-view vector-vars)
        (if mask-vars-use-vector-registers
          (live.compiler-live-set-union
            (compiler-reg-global-shared-view vector-vars)
            (compiler-reg-global-shared-view mask-vars))
          (compiler-reg-global-shared-view vector-vars)))]
    [mask-candidate-vars : live.CompilerLiveI64Set
      (if vector-mask-empty?
        (compiler-reg-global-shared-view mask-vars)
        (if mask-vars-use-vector-registers
          (live.compiler-live-set-empty)
          (compiler-reg-global-shared-view mask-vars)))]
    [vector-preferences : (__tl_dyn-array i64)
      (if vector-mask-empty?
        (array.make-array i64 0)
        (compiler-reg-function-select-false-preferences
          (compiler-reg-global-shared-view func)
          (array-length interval-index.starts)))]
    [vector-candidates : CompilerRegIntervalSeq
      (if vector-mask-empty?
        (compiler-reg-interval-seq-empty)
        (compiler-reg-special-candidates
          (compiler-reg-global-shared-view intervals)
          (compiler-reg-global-shared-view vector-candidate-vars)
          (compiler-reg-global-shared-view blocked)))]
    [_vector-class-reset : unit
      (compiler-reg-unassign-special-candidates!
        (compiler-reg-global-shared-view scalar-assignments)
        (compiler-reg-global-shared-view vector-candidates))]
    [vector-state
      : CompilerRegAssignState
      ;; Vectors share the XMM physical bank and the scalar greedy's ABI
      ;; clobber rule. `%vecN` is an allocator-only class spelling; backend
      ;; save/restore sees the same physical N through the overlap helper.
      (if vector-mask-empty?
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          (compiler-reg-global-shared-view scalar-assignments))
        (compiler-reg-greedy-state
          (compiler-reg-global-shared-view vector-candidates)
          (compiler-reg-vector-registers-for-abi target-abi)
          (compiler-reg-global-shared-view scalar-assignments)
          (compiler-reg-global-shared-view interval-index)
          (live.compiler-live-set-empty)
          (live.compiler-live-set-empty)
          (array.make-array i64 0)
          (compiler-reg-global-shared-view vector-preferences)
          (array.make-array i64 0)
          (compiler-reg-global-shared-view xmm-call-points)
          (compiler-reg-global-shared-view div-points)
          (compiler-reg-global-shared-view shift-points)
          (compiler-reg-vector-callee-registers-for-abi target-abi)
          (compiler-reg-vector-caller-register-count-for-abi target-abi)
          -1))]
    [vector-assignments : CompilerRegAssignmentTable
      (match (compiler-reg-global-shared-view vector-state)
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [_mask-class-reset
      : unit
      ;; The scalar greedy provisionally homes mask values in GP registers.
      ;; Clear those homes before fixed k-register allocation so excess mask
      ;; pressure remains unassigned and is emitted through the existing
      ;; stack-slot spill path instead of reaching the backend as a GP home.
      (compiler-reg-unassign-special-candidates!
        (compiler-reg-global-shared-view vector-assignments)
        (compiler-reg-special-candidates
          (compiler-reg-global-shared-view intervals)
          (compiler-reg-global-shared-view mask-candidate-vars)
          (compiler-reg-global-shared-view blocked)))]
    [mask-state : CompilerRegAssignState
      (if vector-mask-empty?
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          (compiler-reg-global-shared-view vector-assignments))
        (compiler-reg-assign-fixed-candidates
          (compiler-reg-special-candidates
            (compiler-reg-global-shared-view intervals)
            (compiler-reg-global-shared-view mask-candidate-vars)
            (compiler-reg-global-shared-view blocked))
          (compiler-reg-mask-registers)
          (compiler-reg-active-seq-empty)
          (compiler-reg-global-shared-view vector-assignments)
          (array.make-array i64 0)
          (compiler-reg-global-shared-view interval-index)))]
    [assignments : CompilerRegAssignmentTable
      (match (compiler-reg-global-shared-view mask-state)
        [(CompilerRegAssignState.State _ found) found])]
    ;; SplitKit remains removed; retain only the coalescing parents needed by
    ;; late scratch preservation in its otherwise-empty metadata carrier.
    [split-plan : CompilerRegSplitPlan
      (compiler-reg-split-plan-with-coalesce coalesce.parents)]
    ;; The passes above assigned class ROOTS; expand so every member
    ;; inherits its root's location (realising the coalesce). SIMD/AVX has no
    ;; coalesce map, so this is the identity there.
    [final-assignments : CompilerRegAssignmentTable
      (if allow-caller-saved-zero-call
        (compiler-reg-rewrite-remat-assignments
          (compiler-reg-expand-class-assignments
            (compiler-reg-global-shared-view assignments)
            (compiler-reg-global-shared-view coalesce)
            (compiler-reg-global-shared-view storage-identity-vars)
            (compiler-reg-global-shared-view interval-index.starts)
            (array-length interval-index.starts))
          (compiler-reg-global-shared-view func)
          (compiler-reg-global-shared-view coalesce)
          (compiler-reg-global-shared-view call-save-shadows)
          (array-length interval-index.starts))
        (compiler-reg-global-shared-view assignments))]
    ;; GAP2b: register-pair homing for group values. Runs LAST, when every
    ;; scalar home is final, so pair selection/eviction is judged against the
    ;; exact register landscape the backend will see. Linux scalar-opt2 only
    ;; (the M-G3/M-F gating pattern); every other path is byte-identical.
    [pair-assignments : CompilerRegAssignmentTable
      (if allow-caller-saved-zero-call
        (match target-abi
          [(cabi.CompilerRegTargetAbi.Linux)
            (compiler-reg-assign-group-pairs
              type-segment-bases
              (compiler-reg-global-shared-view func)
              (compiler-reg-global-shared-view type-info)
              (compiler-reg-global-shared-view group-vars)
              (compiler-reg-global-shared-view interval-index)
              (compiler-reg-global-shared-view final-assignments)
              (compiler-reg-global-shared-view base-eviction-ref-counts)
              (compiler-reg-global-shared-view call-points)
              (compiler-reg-global-shared-view call-save-split))]
          [(cabi.CompilerRegTargetAbi.Windows)
            (compiler-reg-global-shared-view final-assignments)])
        (compiler-reg-global-shared-view final-assignments))]
    (CompilerRegPlan.Plan
      (compiler-reg-global-shared-view pair-assignments)
      (compiler-reg-global-shared-view ineligible)
      (compiler-reg-global-shared-view intervals)
      (compiler-reg-global-shared-view type-info)
      (compiler-reg-global-shared-view call-save-split)
      (compiler-reg-global-shared-view split-plan))))

;; SIMD/AVX register plan (unchanged from before #perf): full dataflow-liveness
;; intervals + the call-live-conservative ineligibility, keeping AVX backend
;; golden output byte-identical.
(define (compiler-reg-plan-function-with-type-segment-bases-for-abi-and-representations
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [representations : ir.CompilerIrRepresentationIndex]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make
        (compiler-reg-global-shared-view func)
        false)]
    [liveness : live.CompilerFunctionLiveness liveness-handle.baseline]
    [type-info : CompilerRegVarTypes
      (compiler-reg-function-var-types-with-representations
        (compiler-reg-global-shared-view func)
        representations)]
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-live-intervals
        (compiler-reg-global-shared-view func)
        (compiler-reg-global-shared-view liveness))]
    [ineligible : live.CompilerLiveI64Set
      (compiler-reg-ineligible-vars-simd
        (compiler-reg-global-shared-view func)
        (compiler-reg-global-shared-view type-info)
        (compiler-reg-global-shared-view intervals))]
    [vars : i64
      (match (compiler-reg-global-shared-view func)
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    (compiler-reg-plan-from
      type-segment-bases
      (compiler-reg-global-shared-view func)
      (compiler-reg-global-shared-view liveness-handle)
      (compiler-reg-global-shared-view type-info)
      (compiler-reg-global-shared-view intervals)
      (compiler-reg-interval-index-build
        (compiler-reg-global-shared-view intervals)
        vars)
      (compiler-reg-assignment-table-make vars)
      (compiler-reg-global-shared-view ineligible)
      (compiler-reg-global-shared-view ineligible)
      false
      false
      target-abi
      false
      (- 0 1))))

(define (compiler-reg-plan-function-with-type-segment-bases-for-abi
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-with-type-segment-bases-for-abi-and-representations
    type-segment-bases
    target-abi
    func
    (ir.compiler-ir-representation-index-empty)))

(define (compiler-reg-plan-function-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-with-type-segment-bases-for-abi
    (ast.ast-node-pool-reader-type-segment-bases)
    target-abi
    func))

(define (compiler-reg-plan-function [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-for-abi cabi.CompilerRegTargetAbi.Linux func))

(define (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi-and-representations
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [representations : ir.CompilerIrRepresentationIndex]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make
        (compiler-reg-global-shared-view func)
        false)]
    [liveness : live.CompilerFunctionLiveness liveness-handle.baseline]
    [type-info : CompilerRegVarTypes
      (compiler-reg-function-var-types-with-representations
        (compiler-reg-global-shared-view func)
        representations)]
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-live-intervals
        (compiler-reg-global-shared-view func)
        (compiler-reg-global-shared-view liveness))]
    [ineligible : live.CompilerLiveI64Set
      (compiler-reg-ineligible-vars-simd
        (compiler-reg-global-shared-view func)
        (compiler-reg-global-shared-view type-info)
        (compiler-reg-global-shared-view intervals))]
    [vars : i64
      (match (compiler-reg-global-shared-view func)
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    (compiler-reg-plan-from
      type-segment-bases
      (compiler-reg-global-shared-view func)
      (compiler-reg-global-shared-view liveness-handle)
      (compiler-reg-global-shared-view type-info)
      (compiler-reg-global-shared-view intervals)
      (compiler-reg-interval-index-build
        (compiler-reg-global-shared-view intervals)
        vars)
      (compiler-reg-assignment-table-make vars)
      (compiler-reg-global-shared-view ineligible)
      (compiler-reg-global-shared-view ineligible)
      false
      true
      target-abi
      false
      (- 0 1))))

(define (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi-and-representations
    type-segment-bases
    target-abi
    func
    (ir.compiler-ir-representation-index-empty)))

(define (compiler-reg-plan-function-avx2-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
    (ast.ast-node-pool-reader-type-segment-bases)
    target-abi
    func))

(define (compiler-reg-scalar-full-intervals? [func : ir.CompilerIrFunction]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ _) true]))

;; M-A (RC1) correctness requirement: a register-homed param's home register is
;; WRITTEN by the backend's entry copy in the prologue, before the first
;; instruction, so the param's interval must be reserved from the function's
;; first point. The precise (segmented) builder starts a live-in-at-entry param
;; at point 1 (live-after of instr 0 extends at point+1); a var whose interval
;; is exactly [0,0] would then look disjoint under the coarse [start,end]
;; fallback, share the param's home register, and its instr-0 def would
;; overwrite the param's entry-copied value before the param's first read.
;; Force every used param's interval (both starts[] and its earliest segment)
;; to start at point 0. Params with no interval (never used) are left alone --
;; they never become candidates.
(define (compiler-reg-param-segments-extend-entry
  [segs : CompilerRegIntervalSeq]
  [min-start : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count segs))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segs))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref segs index)]
            [start : i64 interval.start]
            (set!
              out
              (compiler-reg-interval-seq-append
                out
                (CompilerRegInterval
                  interval.var
                  (if (= start min-start)
                    0
                    start)
                  interval.end))))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-param-segments-min-start
  [segs : CompilerRegIntervalSeq]
  [best : i64]) : i64
  (let
    [out : i64 best]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segs))
        (begin
          (let
            [start : i64
              (__tl-project-field
                (compiler-reg-interval-seq-ref segs index)
                start)]
            (if (or (< out 0) (< start out))
              (set! out start)
              unit))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-param-intervals-extend-entry!
  [params : ir.CompilerIrParamList]
  [interval-index : CompilerRegIntervalIndex]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-param-intervals-extend-entry!
        (ir.compiler-ir-param-seq-to-list seq)
        interval-index)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (let
            [starts : (__tl_dyn-array i64) interval-index.starts]
            [segments : (__tl_dyn-array CompilerRegIntervalSeq)
              interval-index.segments]
            (begin
              (if (and
                (>= var 0)
                (< var (array-length starts))
                (> (compiler-reg-global-array-element-shared-view starts var) 0))
                (begin
                  (set! (array-ref starts var) 0)
                  (if (< var (array-length segments))
                    (let
                      [segs : CompilerRegIntervalSeq
                        (compiler-reg-global-array-element-shared-view
                          segments
                          var)]
                      [min-start : i64
                        (compiler-reg-param-segments-min-start
                          (compiler-reg-global-shared-view segs)
                          (- 0 1))]
                      (if (> min-start 0)
                        (begin
                          (set!
                            (array-ref segments var)
                            (compiler-reg-param-segments-extend-entry
                              segs
                              min-start))
                          unit)
                        unit))
                    unit))
                unit)
              (compiler-reg-param-intervals-extend-entry!
                (compiler-reg-box-shared-view rest)
                (compiler-reg-global-shared-view interval-index))))])]))

(define (compiler-reg-live-set-insert-range
  [set : live.CompilerLiveI64Set]
  [start : i64]
  [end : i64]) : live.CompilerLiveI64Set
  (if (>= start end)
    set
    (compiler-reg-live-set-insert-range
      (live.compiler-live-set-insert set start)
      (+ start 1)
      end)))

(define (compiler-reg-plan-function-scalar-cold-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-for-abi-with-types
    target-abi
    (compiler-reg-global-shared-view func)
    forced-spill-from
    (compiler-reg-function-var-types func)))

;; `type-info` must be `(compiler-reg-function-var-types func)`. The backend
;; already needs that view for its caller-save rewrite, so it computes it once
;; and passes it in rather than having both walk the function.
(define (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]
  [forced-assignments : CompilerRegAssignmentTable]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-forced-spill-with-types
    type-segment-bases
    target-abi
    func
    forced-spill-from
    (>= forced-spill-from 0)
    type-info
    forced-assignments))

;; Plan `func` with every variable from `forced-spill-from` up forced into
;; memory. `cold-split?` is a SEPARATE claim and not a consequence of that
;; threshold: it says the function's only kind-0 clobber has been carried away
;; by cycle 20's cold-call rewrite, which is what lets the param ABI-pin gate
;; below ignore the clobber set entirely and lets the same-value coalescing gate
;; read the edge-precise index. The call-hole split mints its carriers in a
;; function that still contains every one of its calls, so it forces them to
;; memory with `cold-split?` FALSE and both gates keep their real inputs.
(define (compiler-reg-plan-function-scalar-forced-spill-with-types
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [cold-split? : bool]
  [type-info : CompilerRegVarTypes]
  [forced-assignments : CompilerRegAssignmentTable]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make
        (compiler-reg-global-shared-view func)
        true)]
    [vars : i64
      (match (compiler-reg-global-shared-view func)
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    [interval-selection : CompilerRegIntervalSelection
      (if (compiler-reg-scalar-full-intervals?
        (compiler-reg-global-shared-view func))
        ;; ALLOCATION RUNS ON EDGE-PRECISE LIVENESS. The baseline treats a
        ;; phi's inputs as uses AT the phi block, so a loop's back-edge def
        ;; appears live-in at the header from EVERY predecessor and leaks
        ;; backward through the versioning guard chain to function entry:
        ;; in a multi-loop function the coalesced loop-carry class then spans
        ;; [entry, loop-end] and the greedy sees one giant cross-function web
        ;; -- hot loop-carried counters lose first-free against every sibling
        ;; loop's residents and spill whole, fragmenting into per-iteration
        ;; mem-to-mem copies (the cfg_domloops/CSR defect, #6248). The EP
        ;; analysis (compiler-live-analyze-function-edge-precise) attributes
        ;; each phi input to its own predecessor edge -- the exact SSA
        ;; interference, identical to the baseline for every var that is not
        ;; a phi input -- so allocation interference, call-span tests, and
        ;; same-value eligibility all get exact inputs and stay sound. The
        ;; coalescing hybrid alone keeps a conservative index (computed on
        ;; its own branch in compiler-reg-plan-from): the live-out-input phi
        ;; exclusion is specified against conservative segments. The
        ;; cold-split caller already used EP for this selection, so it sees
        ;; no change.
        (compiler-reg-live-interval-selection
          (compiler-reg-global-shared-view func)
          (compiler-reg-liveness-handle-edge-precise
            (compiler-reg-global-shared-view liveness-handle)))
        (let
          [block-intervals : CompilerRegIntervalSeq
            (compiler-reg-block-intervals
              (compiler-reg-global-shared-view func))]
          (CompilerRegIntervalSelection.Selection
            (compiler-reg-global-shared-view block-intervals)
            (compiler-reg-interval-index-build
              (compiler-reg-global-shared-view block-intervals)
              vars))))]
    (match (compiler-reg-global-shared-view interval-selection)
      [(CompilerRegIntervalSelection.Selection _ interval-index)
        (let
          ;; M-A (RC1): reserve every used param's interval from function entry
          ;; (mutates the index arrays), then rebuild the interval sequence from
          ;; the mutated arrays so both views agree. Content-identical to the
          ;; builder's sequence when no param moved.
          [_param-extend : unit
            (match (compiler-reg-global-shared-view func)
              [(ir.CompilerIrFunction.Function _ params _ _ _)
                (compiler-reg-param-intervals-extend-entry!
                  (compiler-reg-global-shared-view params)
                  (compiler-reg-global-shared-view interval-index))])]
          [intervals : CompilerRegIntervalSeq
            (compiler-reg-interval-arrays-to-seq
              (compiler-reg-global-shared-view interval-index.starts)
              (compiler-reg-global-shared-view interval-index.ends)
              (- vars 1)
              (compiler-reg-interval-seq-empty))]
          [forced-spill? : bool (>= forced-spill-from 0)]
          [base-ineligible : live.CompilerLiveI64Set
            (let
              [base : live.CompilerLiveI64Set
                (compiler-reg-ineligible-vars-non-params
                  type-segment-bases
                  (compiler-reg-global-shared-view func)
                  (compiler-reg-global-shared-view type-info)
                  target-abi)]
              (if forced-spill?
                (compiler-reg-live-set-insert-range
                  (compiler-reg-global-shared-view base)
                  forced-spill-from
                  vars)
                (compiler-reg-global-shared-view base)))]
          [param-plan : CompilerRegParamAssignPlan
            (compiler-reg-param-assign-plan
              type-segment-bases
              type-info.representations
              target-abi
              (compiler-reg-global-shared-view func)
              (compiler-reg-global-shared-view interval-index)
              (compiler-reg-global-shared-view base-ineligible)
              vars
              cold-split?)]
          (match (compiler-reg-global-shared-view param-plan)
            [(CompilerRegParamAssignPlan.Plan preassignments ineligible blocked)
              (let
                [_forced : unit
                  (compiler-reg-assignment-table-overlay!
                    (compiler-reg-global-shared-view preassignments)
                    (compiler-reg-global-shared-view forced-assignments))]
                (compiler-reg-plan-from
                  type-segment-bases
                  (compiler-reg-global-shared-view func)
                  (compiler-reg-global-shared-view liveness-handle)
                  (compiler-reg-global-shared-view type-info)
                  (compiler-reg-global-shared-view intervals)
                  (compiler-reg-global-shared-view interval-index)
                  (compiler-reg-global-shared-view preassignments)
                  (compiler-reg-global-shared-view ineligible)
                  (compiler-reg-global-shared-view blocked)
                  true
                  false
                  target-abi
                  cold-split?
                  forced-spill-from))]))])))

(define (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
    type-segment-bases
    target-abi
    func
    forced-spill-from
    type-info
    (compiler-reg-assignment-table-empty)))

(define (compiler-reg-plan-function-scalar-cold-for-abi-with-types
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
    (ast.ast-node-pool-reader-type-segment-bases)
    target-abi
    func
    forced-spill-from
    type-info))

(define (compiler-reg-plan-function-scalar-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-for-abi target-abi func (- 0 1)))

(define (compiler-reg-plan-function-scalar [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-for-abi
    cabi.CompilerRegTargetAbi.Linux
    func))

;; The cold-call carrier is the ABI boundary: it must never be colored into a
;; register or rematerialized, because the real call is deliberately absent
;; from the GP clobber mask.  Missing assignments are the backend's ordinary
;; stack-home representation and are therefore valid here.
(cfg
  (any test scavenge-self-check)
  (define (compiler-reg-cold-call-carriers-stack?
    [plan : CompilerRegPlan]
    [temp-start : i64]
    [vars : i64]) : bool
    (if (< temp-start 0)
      true
      (match plan
        [(CompilerRegPlan.Plan assignments _ _ _ _ _)
          (let
            [v : i64 temp-start]
            [ok : bool (< temp-start vars)]
            (begin
              (while (and ok (< v vars))
                (begin
                  (match (compiler-reg-assignment-lookup
                    (compiler-reg-global-shared-view assignments)
                    v)
                    [(CompilerRegMaybeLocation.No) unit]
                    [(CompilerRegMaybeLocation.Some location)
                      (match location
                        [(CompilerRegLocation.Spill _) unit]
                        [_ (set! ok false)])])
                  (set! v (+ v 1))))
              ok))]))))

(define (compiler-reg-plan-function-stack-only-with-representations
  [func : ir.CompilerIrFunction]
  [representations : ir.CompilerIrRepresentationIndex]) : CompilerRegPlan
  (let
    [type-info : CompilerRegVarTypes
      (compiler-reg-function-var-types-with-representations
        func
        representations)]
    (CompilerRegPlan.Plan
      (compiler-reg-assignment-table-empty)
      (live.compiler-live-set-empty)
      (compiler-reg-interval-seq-empty)
      type-info
      (compiler-reg-call-split-empty)
      (compiler-reg-split-plan-empty))))

(define (compiler-reg-plan-function-stack-only [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-stack-only-with-representations
    func
    (ir.compiler-ir-representation-index-empty)))

;; --- stack-slot compaction and storage coloring -----------------------------
;; One frame slot per raw IR variable wastes most of the frame once register
;; allocation has moved many values into registers. The scalar pass renumbers
;; stack-resident scalar variables into a dense frame-slot prefix after regalloc,
;; preserving parameter ids for the prologue spill contract. A second pass
;; colors contiguous inline-storage ranges, sharing those range slots when their
;; AddrOf/Gep-derived pointer lifetimes are disjoint. Variables that already
;; have a register home, dead raw-id holes, and register-only scratch pseudo-vars
;; receive free non-slot ids, and stack-homed register groups are remapped by
;; their word0 id; the backend places word1 in the matching second var-region.
;; Plans with no intervals (the stack-only opt0/opt1 path skips liveness) pass
;; through unchanged. The result's slot count replaces the raw var count in the
;; backend's frame layout.
(defenum CompilerRegColoring
  (None)
  (Remap (__tl_dyn-array i64) i64))

;; Per-var slot-colorability flags: only values the register allocator could
;; legally home in one 64-bit register (scalars and 8-byte handles) are known
;; to occupy exactly one frame slot. Anything else (vectors, masks, inline
;; groups, unknown) is skipped by the scalar interval walk and then receives a
;; private dense slot if it still needs stack storage.
(define (compiler-reg-color-flags
  [types : CompilerRegVarTypes]
  [flags : (__tl_dyn-array bool)]) : unit
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    [index : i64 0]
    [limit : i64
      (if (< (array-length present) (array-length flags))
        (array-length present)
        (array-length flags))]
    (while (< index limit)
      (begin
        (if (= (compiler-reg-global-array-element-shared-view present index) 0)
          unit
          (set!
            (array-ref flags index)
            (or
              (compiler-reg-scalar-type?
                (compiler-reg-global-array-element-shared-view items index))
              (compiler-reg-handle-type?
                (compiler-reg-global-array-element-shared-view items index)))))
        (set! index (+ index 1))))))

;; Mark every variable with a final liveness interval. Combined with direct IR
;; uses/defs below, this distinguishes real values (including dead emitted defs)
;; from gaps in the monotonic variable-id watermark.
(define (compiler-reg-color-reference-intervals!
  [intervals : CompilerRegIntervalSeq]
  [references : (__tl_dyn-array bool)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [var : i64
            (__tl-project-field
              (compiler-reg-interval-seq-ref intervals index)
              var)]
          (if (and (>= var 0) (< var (array-length references)))
            (set! (array-ref references var) true)
            unit))
        (set! index (+ index 1))))))

;; Per-var AstType array for the coloring walk's same-type sharing guard.
;; Every colorable var has a types-list entry (compiler-reg-color-flags only
;; sets its flag from one), so the walk never reads an unwritten element.
(define (compiler-reg-color-var-tys
  [types : CompilerRegVarTypes]
  [tys : (__tl_dyn-array ast.AstType)]) : unit
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    [index : i64 0]
    [limit : i64
      (if (< (array-length present) (array-length tys))
        (array-length present)
        (array-length tys))]
    (while (< index limit)
      (begin
        (if (= (array-ref present index) 0)
          unit
          (set! (array-ref tys index) (array-ref items index)))
        (set! index (+ index 1))))))

(define (compiler-reg-vector-elem-size [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [_ 8]))

(define (compiler-reg-vector-stack-words-for-shape
  [lanes : i64]
  [elem-ty : ast.AstType]) : i64
  (let
    [bytes : i64 (* lanes (compiler-reg-vector-elem-size elem-ty))]
    (if (<= bytes 0)
      1
      (/ (+ bytes 7) 8))))

(define (compiler-reg-vector-stack-words-set!
  [words : (__tl_dyn-array i64)]
  [var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]) : unit
  (if (or (< var 0) (>= var (array-length words)))
    unit
    (let
      [next : i64 (compiler-reg-vector-stack-words-for-shape lanes elem-ty)]
      [old : i64 (array-ref words var)]
      (if (> next old)
        (set! (array-ref words var) next)
        unit))))

(define (compiler-reg-vector-stack-words-set-mask!
  [words : (__tl_dyn-array i64)]
  [var : i64]) : unit
  ;; AVX2 represents lane masks in a full YMM register. AVX-512 uses compact
  ;; k-register spills, but reserving the same four-word range is harmless and
  ;; keeps this target-neutral census conservative.
  (if (or (< var 0) (>= var (array-length words)))
    unit
    (let
      [old : i64 (array-ref words var)]
      (if (> old 3)
        unit
        (set! (array-ref words var) 4)))))

(define (compiler-reg-spmd-avx2-special-param? [name : String]) : bool
  (or
    (compiler-reg-string-prefix?
      (compiler-reg-global-shared-view name)
      "__tl_spmd_active_mask_avx2")
    (compiler-reg-string-prefix?
      (compiler-reg-global-shared-view name)
      "__tl_spmd_varying_arg_avx2_")
    (compiler-reg-string-prefix? name "__tl_spmd_mask_arg_avx2_")))

(define (compiler-reg-vector-stack-words-params!
  [params : ir.CompilerIrParamList]
  [words : (__tl_dyn-array i64)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-vector-stack-words-params!
        (ir.compiler-ir-param-seq-to-list seq)
        words)]
    [(ir.CompilerIrParamList.Cons param rest)
      (begin
        (match param
          [(ir.CompilerIrParam.Param name _ var)
            (if (compiler-reg-spmd-avx2-special-param? name)
              (compiler-reg-vector-stack-words-set-mask!
                (compiler-reg-global-shared-view words)
                var)
              unit)])
        (compiler-reg-vector-stack-words-params!
          (compiler-reg-box-shared-view rest)
          words))]))

(define (compiler-reg-spmd-avx2-special-param-references!
  [params : ir.CompilerIrParamList]
  [references : (__tl_dyn-array bool)]) : unit
  ;; The backend materializes every private ABI parameter before instruction
  ;; emission, including an active mask unused by the helper body. Keep those
  ;; prologue-only writes in the private-range allocation census.
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-spmd-avx2-special-param-references!
        (ir.compiler-ir-param-seq-to-list seq)
        references)]
    [(ir.CompilerIrParamList.Cons param rest)
      (begin
        (match param
          [(ir.CompilerIrParam.Param name _ var)
            (if (and
              (compiler-reg-spmd-avx2-special-param? name)
              (>= var 0)
              (< var (array-length references)))
              (set! (array-ref references var) true)
              unit)])
        (compiler-reg-spmd-avx2-special-param-references!
          (compiler-reg-box-shared-view rest)
          references))]))

(define (compiler-reg-vector-stack-words-instr!
  [instr : ir.CompilerIrInstr]
  [words : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.LaneId dst lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(ir.CompilerIrInstr.Splat dst _ lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [elem-ty (compiler-reg-box-field-shared-view payload-box ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [elem-ty (compiler-reg-box-field-shared-view payload-box ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [elem-ty (compiler-reg-box-field-shared-view payload-box ty)]
        (if (= lanes 0)
          unit
          (match (compiler-reg-global-shared-view elem-ty)
            [(ast.AstType.Bool)
              (compiler-reg-vector-stack-words-set-mask! words dst)]
            [_ (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)])))]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        (compiler-reg-vector-stack-words-set-mask! words dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [elem-ty (compiler-reg-box-field-shared-view payload-box ty)]
        (match (compiler-reg-global-shared-view elem-ty)
          [(ast.AstType.Bool)
            (compiler-reg-vector-stack-words-set-mask! words dst)]
          [_ (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [elem-ty (compiler-reg-box-field-shared-view payload-box ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [elem-ty (compiler-reg-box-field-shared-view payload-box ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (compiler-reg-box-field-shared-view payload-box backend)]
        [lanes (compiler-reg-box-field-shared-view payload-box lanes)]
        [result (compiler-reg-box-field-shared-view payload-box result)]
        (match backend
          [(ir.CompilerIrSpmdBackend.Avx512)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) unit]
              [(ir.CompilerIrSpmdCallResult.Value dst class elem-ty)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Varying)
                    (compiler-reg-vector-stack-words-set!
                      words
                      dst
                      lanes
                      elem-ty)]
                  [_ unit])])]
          [(ir.CompilerIrSpmdBackend.Avx2)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) unit]
              [(ir.CompilerIrSpmdCallResult.Value dst class elem-ty)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Varying)
                    (compiler-reg-vector-stack-words-set!
                      words
                      dst
                      lanes
                      elem-ty)]
                  [(ir.CompilerIrSpmdValueClass.Mask)
                    (compiler-reg-vector-stack-words-set-mask! words dst)]
                  [_ unit])])]
          [_ unit]))]
    [_ unit]))

(define (compiler-reg-vector-stack-words-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [words : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-vector-stack-words-instr!
          (compiler-reg-global-array-element-shared-view slots index)
          (compiler-reg-global-shared-view words))
        (set! index (+ index 1))))))

(define (compiler-reg-vector-stack-words-blocks!
  [blocks : ir.CompilerIrBlockList]
  [words : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-vector-stack-words-seq!
              instrs
              (compiler-reg-global-shared-view words))])
        (compiler-reg-vector-stack-words-blocks!
          (compiler-reg-box-shared-view rest)
          words))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        (while (<
          index
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq)))
          (begin
            (match (ir.compiler-ir-block-seq-ref
              (compiler-reg-global-shared-view seq)
              index)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-vector-stack-words-seq!
                  instrs
                  (compiler-reg-global-shared-view words))])
            (set! index (+ index 1)))))]))

(define (compiler-reg-vector-stack-extra-slots
  [words : (__tl_dyn-array i64)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (array-length words))
    acc
    (let
      [w : i64 (array-ref words index)]
      (compiler-reg-vector-stack-extra-slots
        words
        (+ index 1)
        (if (> w 1)
          (+ acc (- w 1))
          acc)))))

(define (compiler-reg-vector-stack-words-for-var
  [words : (__tl_dyn-array i64)]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length words)))
    1
    (let
      [w : i64 (array-ref words var)]
      (if (> w 1)
        w
        1))))

(define (compiler-reg-color-reserve-private-range!
  [slot-ends : (__tl_dyn-array i64)]
  [next : i64]
  [words : i64]) : i64
  (let
    [size : i64
      (if (> words 1)
        words
        1)]
    [slot : i64
      (compiler-reg-color-next-free-range
        (compiler-reg-global-shared-view slot-ends)
        next
        size
        0)]
    (begin
      (compiler-reg-color-set-range-ends!
        slot-ends
        slot
        size
        9223372036854775807)
      slot)))

;; Sorted insert by (start, var): deterministic processing order.
;; In-place heapsort of an interval array by (start, var) -- deterministic
;; total order, O(n log n), no allocation beyond the array itself (the
;; insertion-sort cons spine it replaces allocated O(n^2) cells, which blew
;; the scratch arena on ~7000-var functions).
(define (compiler-reg-color-interval-before?
  [a : CompilerRegInterval]
  [b : CompilerRegInterval]) : bool
  (let
    [a-start : i64 a.start]
    [b-start : i64 b.start]
    (or (< a-start b-start) (and (= a-start b-start) (< a.var b.var)))))

(define (compiler-reg-color-interval-copy [item : CompilerRegInterval]) : CompilerRegInterval
  (CompilerRegInterval item.var item.start item.end))

(define (compiler-reg-color-sift-down
  [items : (__tl_dyn-array CompilerRegInterval)]
  [root : i64]
  [count : i64]) : unit
  (let
    [node : i64 root]
    [done : bool false]
    (while (not done)
      (let
        [left : i64 (+ (* node 2) 1)]
        [right : i64 (+ (* node 2) 2)]
        [largest : i64
          (let
            [pick : i64 node]
            (begin
              (if (and
                (< left count)
                (compiler-reg-color-interval-before?
                  (array-ref items pick)
                  (array-ref items left)))
                (set! pick left)
                unit)
              (if (and
                (< right count)
                (compiler-reg-color-interval-before?
                  (array-ref items pick)
                  (array-ref items right)))
                (set! pick right)
                unit)
              pick))]
        (if (= largest node)
          (set! done true)
          (let
            [node-item : CompilerRegInterval
              (compiler-reg-color-interval-copy (array-ref items node))]
            [largest-item : CompilerRegInterval
              (compiler-reg-color-interval-copy (array-ref items largest))]
            (begin
              (set! (array-ref items node) largest-item)
              (set! (array-ref items largest) node-item)
              (set! node largest))))))))

(define (compiler-reg-color-heapsort
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]) : unit
  (begin
    (let
      [i : i64 (- (/ count 2) 1)]
      (while (>= i 0)
        (begin
          (compiler-reg-color-sift-down
            (compiler-reg-global-shared-view items)
            i
            count)
          (set! i (- i 1)))))
    (let
      [last : i64 (- count 1)]
      (while (> last 0)
        (let
          [root-item : CompilerRegInterval
            (compiler-reg-color-interval-copy (array-ref items 0))]
          [last-item : CompilerRegInterval
            (compiler-reg-color-interval-copy (array-ref items last))]
          (begin
            (set! (array-ref items 0) last-item)
            (set! (array-ref items last) root-item)
            (compiler-reg-color-sift-down
              (compiler-reg-global-shared-view items)
              0
              last)
            (set! last (- last 1))))))))

;; Per-variable full lifetime end over all split live intervals. The scalar
;; coloring walk assigns each variable one remapped frame slot, so a slot must
;; stay busy until that variable's last interval ends, even if the interval
;; sequence has a hole before a later use. `count` bounds the live prefix of
;; `items` that compiler-reg-color-walk-interval-fill kept.
(define (compiler-reg-color-extent-ends
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]
  [vars : i64]) : (__tl_dyn-array i64)
  (let
    [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [i : i64 0]
    (begin
      (while (< i vars)
        (begin
          (set! (array-ref ends i) (- 0 1))
          (set! i (+ i 1))))
      (set! i 0)
      (while (< i count)
        (let
          [interval : CompilerRegInterval (array-ref items i)]
          [var : i64 interval.var]
          [end : i64 interval.end]
          (begin
            (if (and (>= var 0) (< var vars) (> end (array-ref ends var)))
              (set! (array-ref ends var) end)
              unit)
            (set! i (+ i 1)))))
      ends)))

;; First slot id at or after `from` that is not identity-pinned to a
;; parameter (pins mark slot-ends with i64-max). Fresh slots fill the gaps a
;; sparse parameter id leaves behind, so slot ids never run past the pinned
;; band and the overall renumbering stays inside [0, vars).
(define (compiler-reg-color-next-free-slot
  [slot-ends : (__tl_dyn-array i64)]
  [from : i64]) : i64
  (if (>= from (array-length slot-ends))
    from
    (if (= (array-ref slot-ends from) 9223372036854775807)
      (compiler-reg-color-next-free-slot slot-ends (+ from 1))
      from)))

;; Lowest used slot whose previous occupant ended strictly before `start`.
;; STRICT `<`: phi parallel copies at a block edge read inputs and write
;; destinations at the same interval position, so same-position reuse would let
;; one phi's destination clobber another phi's not-yet-read input through the
;; slot. Parameter pins use i64-max in slot-ends and therefore never match.
;; SAME-TYPE only: sharing a slot MERGES the two variables' ids in the emitted
;; IR, and the rebuilt per-id type table keeps ONE type. The backend recovers
;; operand width/signedness/float-ness from that table (e.g.
;; compiler-backend-binop-operand-ty for bit ops), so merging an i64 with a
;; bool would emit `andb` for a 64-bit bit-and -- a real M-A2 bring-up
;; miscompile (compiler-live-set-minus-words). Only type-identical variables
;; may merge.
(define (compiler-reg-color-find-slot
  [type-segment-bases : i64]
  [slot-ends : (__tl_dyn-array i64)]
  [slot-tys : (__tl_dyn-array ast.AstType)]
  [ty : ast.AstType]
  [used : i64]
  [start : i64]
  [index : i64]) : i64
  (if (>= index used)
    used
    (if (and
      (< (compiler-reg-global-array-element-shared-view slot-ends index) start)
      (ast.ast-type-eq-with-seg-bases?
        type-segment-bases
        (compiler-reg-global-array-element-shared-view slot-tys index)
        (compiler-reg-global-shared-view ty)))
      index
      (compiler-reg-color-find-slot
        type-segment-bases
        slot-ends
        slot-tys
        ty
        used
        start
        (+ index 1)))))

(define (compiler-reg-color-walk
  [type-segment-bases : i64]
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]
  [index : i64]
  [assignment-index : CompilerRegAssignmentTable]
  [pinned : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [colorable : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [slot-ends : (__tl_dyn-array i64)]
  [slot-tys : (__tl_dyn-array ast.AstType)]
  [extent-ends : (__tl_dyn-array i64)]
  [used : i64]
  [remap : (__tl_dyn-array i64)]) : i64
  (if (>= index count)
    used
    (let
      [interval : CompilerRegInterval
        (compiler-reg-global-array-element-shared-view items index)]
      [var : i64 interval.var]
      [start : i64 interval.start]
      [end : i64 interval.end]
      (if (or
        ;; Already renumbered: parameter identity pins (the prologue's
        ;; param spill targets the ORIGINAL id's formula slot, so a pinned
        ;; id must never be reassigned mid-walk) and split intervals (the
        ;; first interval wins; revisiting would leak the first slot).
        (>= (compiler-reg-global-array-element-shared-view remap var) 0)
        (not (compiler-reg-global-array-element-shared-view colorable var))
        (live.compiler-live-set-contains?
          (compiler-reg-global-shared-view pinned)
          var)
        (live.compiler-live-set-contains?
          (compiler-reg-global-shared-view ineligible)
          var)
        ;; Spilled scalars are re-homed by the id remap (the stale
        ;; assignment entry keyed by the old id is never queried);
        ;; register-homed values keep their ids and homes.
        (match (compiler-reg-assignment-table-lookup assignment-index var)
          [(CompilerRegMaybeLocation.Some location)
            (match location
              [(CompilerRegLocation.Spill _) false]
              [_ true])]
          [(CompilerRegMaybeLocation.No) false]))
        (compiler-reg-color-walk
          type-segment-bases
          items
          count
          (+ index 1)
          assignment-index
          pinned
          ineligible
          colorable
          var-tys
          slot-ends
          slot-tys
          extent-ends
          used
          remap)
        (let
          ;; Prefer the lowest SAME-TYPE scalar slot whose prior owner ended
          ;; before this variable starts. Otherwise take a fresh slot,
          ;; skipping param-pinned ids so sparse parameter ids leave no hole.
          [ty : ast.AstType
            (compiler-reg-global-array-element-shared-view var-tys var)]
          [found : i64
            (compiler-reg-color-find-slot
              type-segment-bases
              (compiler-reg-global-shared-view slot-ends)
              (compiler-reg-global-shared-view slot-tys)
              (compiler-reg-global-shared-view ty)
              used
              start
              0)]
          [slot : i64
            (if (>= found used)
              (compiler-reg-color-next-free-slot
                (compiler-reg-global-shared-view slot-ends)
                used)
              found)]
          [next-used : i64
            (if (>= found used)
              (+ slot 1)
              used)]
          [full-end : i64
            (compiler-reg-max
              end
              (compiler-reg-global-array-element-shared-view extent-ends var))]
          (begin
            (set! (array-ref slot-ends slot) full-end)
            (if (< slot (array-length slot-tys))
              (set! (array-ref slot-tys slot) ty)
              unit)
            (set! (array-ref remap var) slot)
            (compiler-reg-color-walk
              type-segment-bases
              items
              count
              (+ index 1)
              assignment-index
              pinned
              ineligible
              colorable
              var-tys
              slot-ends
              slot-tys
              extent-ends
              next-used
              remap)))))))

(define (compiler-reg-color-fill-interval-bounds
  [intervals : CompilerRegIntervalSeq]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 interval.var]
          (if (and (>= var 0) (< var (array-length starts)))
            (begin
              (set! (array-ref starts var) interval.start)
              (set! (array-ref ends var) interval.end))
            unit))
        (set! index (+ index 1))))))

(define (compiler-reg-color-mark-storage-vars
  [range-of-var : (__tl_dyn-array i64)]
  [first : i64]
  [count : i64]
  [range-id : i64]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (if (and (>= (+ first i) 0) (< (+ first i) (array-length range-of-var)))
          (set! (array-ref range-of-var (+ first i)) range-id)
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-detect-storage-seq
  [instrs : ir.CompilerIrInstrSeq]
  [range-of-var : (__tl_dyn-array i64)]
  [range-base : (__tl_dyn-array i64)]
  [range-size : (__tl_dyn-array i64)]
  [range-count : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [i : i64 0]
    [run-first : i64 (- 0 1)]
    [run-last : i64 (- 0 1)]
    [run-count : i64 0]
    [ranges : i64 range-count]
    (begin
      (while (< i len)
        (begin
          (match (array-ref slots i)
            [(ir.CompilerIrInstr.Alloc dst _)
              (if (or (= run-count 0) (= dst (+ run-last 1)))
                (begin
                  (if (= run-count 0)
                    (set! run-first dst)
                    unit)
                  (set! run-last dst)
                  (set! run-count (+ run-count 1)))
                (begin
                  (set! run-first dst)
                  (set! run-last dst)
                  (set! run-count 1)))]
            [(ir.CompilerIrInstr.AddrOf _ src)
              (begin
                (if (and
                  (> run-count 0)
                  (= src run-last)
                  (= run-first (+ (- src run-count) 1))
                  (< ranges (array-length range-base)))
                  (begin
                    (set! (array-ref range-base ranges) src)
                    (set! (array-ref range-size ranges) run-count)
                    (compiler-reg-color-mark-storage-vars
                      (compiler-reg-global-shared-view range-of-var)
                      run-first
                      run-count
                      ranges)
                    (set! ranges (+ ranges 1)))
                  unit)
                (set! run-first (- 0 1))
                (set! run-last (- 0 1))
                (set! run-count 0))]
            [_
              (begin
                (set! run-first (- 0 1))
                (set! run-last (- 0 1))
                (set! run-count 0))])
          (set! i (+ i 1))))
      ranges)))

(define (compiler-reg-color-detect-storage-blocks
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [range-base : (__tl_dyn-array i64)]
  [range-size : (__tl_dyn-array i64)]
  [range-count : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) range-count]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-detect-storage-blocks
            (compiler-reg-box-shared-view rest)
            (compiler-reg-global-shared-view range-of-var)
            (compiler-reg-global-shared-view range-base)
            (compiler-reg-global-shared-view range-size)
            (compiler-reg-color-detect-storage-seq
              instrs
              (compiler-reg-global-shared-view range-of-var)
              range-base
              range-size
              range-count))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 range-count]
        (begin
          (while (<
            i
            (ir.compiler-ir-block-seq-count
              (compiler-reg-global-shared-view seq)))
            (begin
              (match (ir.compiler-ir-block-seq-ref
                (compiler-reg-global-shared-view seq)
                i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    count
                    (compiler-reg-color-detect-storage-seq
                      instrs
                      (compiler-reg-global-shared-view range-of-var)
                      (compiler-reg-global-shared-view range-base)
                      (compiler-reg-global-shared-view range-size)
                      count))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-color-value-root
  [roots : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (and (>= var 0) (< var (array-length roots)))
        (array-ref roots var)
        (- 0 1))]
    [_ (- 0 1)]))

(define (compiler-reg-color-merge-root [acc : i64] [root : i64]) : i64
  (cond
    [(< root 0) (- 0 1)]
    [(< acc 0) root]
    [(= acc root) root]
    [else (- 0 2)]))

(define (compiler-reg-color-phi-root
  [roots : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]
  [acc : i64]) : i64
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) acc]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-phi-root
        roots
        (ir.compiler-ir-phi-input-seq-to-list seq)
        acc)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [next : i64
          (compiler-reg-color-merge-root
            acc
            (compiler-reg-color-value-root
              (compiler-reg-global-shared-view roots)
              value))]
        (if (= next (- 0 1))
          (- 0 1)
          (if (= next (- 0 2))
            (- 0 2)
            (compiler-reg-color-phi-root
              roots
              (compiler-reg-box-shared-view rest)
              next))))]))

(define (compiler-reg-color-set-root!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [dst : i64]
  [root : i64]) : bool
  (if (or (< root 0) (< dst 0) (>= dst (array-length roots)))
    false
    (let
      [old : i64 (array-ref roots dst)]
      (if (= old root)
        false
        (if (< old 0)
          (begin
            (set! (array-ref roots dst) root)
            true)
          (begin
            (if (< old (array-length invalid))
              (set! (array-ref invalid old) true)
              unit)
            (if (< root (array-length invalid))
              (set! (array-ref invalid root) true)
              unit)
            (set! (array-ref roots dst) (- 0 2))
            true))))))

;; Result code of one propagation attempt. Bit 0 says the instruction is one of
;; the forms that can ever set a root, so later rounds must revisit it; bit 1
;; says this attempt actually wrote `roots`/`invalid`.
(define (compiler-reg-color-propagate-root-code [changed : bool]) : i64
  (if changed
    3
    1))

(define (compiler-reg-color-propagate-root-instr
  [instr : ir.CompilerIrInstr]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : i64
  (match instr
    [(ir.CompilerIrInstr.AddrOf dst src)
      (compiler-reg-color-propagate-root-code
        (if (and (>= src 0) (< src (array-length range-of-var)))
          (compiler-reg-color-set-root!
            roots
            invalid
            dst
            (array-ref range-of-var src))
          false))]
    [(ir.CompilerIrInstr.Gep dst base _ _)
      (compiler-reg-color-propagate-root-code
        (compiler-reg-color-set-root!
          (compiler-reg-global-shared-view roots)
          invalid
          dst
          (compiler-reg-color-value-root roots base)))]
    [(ir.CompilerIrInstr.Mov dst value _)
      (compiler-reg-color-propagate-root-code
        (compiler-reg-color-set-root!
          (compiler-reg-global-shared-view roots)
          invalid
          dst
          (compiler-reg-color-value-root roots value)))]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-propagate-root-code
        (compiler-reg-color-set-root!
          (compiler-reg-global-shared-view roots)
          invalid
          dst
          (compiler-reg-color-phi-root roots inputs (- 0 1))))]
    [(ir.CompilerIrInstr.Select payload-box)
      (compiler-reg-color-propagate-root-code
        (let
          [dst (compiler-reg-box-field-shared-view payload-box dst)]
          [true-value (compiler-reg-box-field-shared-view payload-box on-true)]
          [false-value
            (compiler-reg-box-field-shared-view payload-box on-false)]
          [left : i64
            (compiler-reg-color-value-root
              (compiler-reg-global-shared-view roots)
              true-value)]
          [right : i64
            (compiler-reg-color-value-root
              (compiler-reg-global-shared-view roots)
              false-value)]
          (if (>= right 0)
            (compiler-reg-color-set-root! roots invalid dst right)
            (if (and (>= left 0) (= left right))
              (compiler-reg-color-set-root! roots invalid dst left)
              false))))]
    [_ 0]))

;; One block's share of the FIRST propagation round.
;;
;; `cursor` carries the walk's position across blocks: slot 0 is the ordinal of
;; this block's first instruction and slot 1 is the write position in
;; `candidates`.
;;
;; The FIRST round visits every instruction and records, in `candidates`, the
;; function-wide ordinal of each one whose form can set a root. Later rounds
;; replay only those, through compiler-reg-color-propagate-root-replay below. An
;; instruction the first round did not record is one that fell through to the
;; `_` arm above -- it reads nothing and writes nothing on any input, so
;; replaying it can only return "no change". Skipping it therefore leaves the
;; sequence of writes, and so the fixpoint, exactly as it was.
(define (compiler-reg-color-propagate-root-seq
  [instrs : ir.CompilerIrInstrSeq]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [candidates : (__tl_dyn-array i64)]
  [cursor : (__tl_dyn-array i64)]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [base : i64 (compiler-reg-global-array-element-shared-view cursor 0)]
    [at : i64 (compiler-reg-global-array-element-shared-view cursor 1)]
    [changed : bool false]
    [i : i64 0]
    (begin
      (while (< i len)
        (let
          [code : i64
            (compiler-reg-color-propagate-root-instr
              (compiler-reg-global-array-element-shared-view slots i)
              (compiler-reg-global-shared-view range-of-var)
              (compiler-reg-global-shared-view roots)
              (compiler-reg-global-shared-view invalid))]
          (begin
            (if (= (bit-and code 2) 0)
              unit
              (set! changed true))
            (if (= (bit-and code 1) 0)
              unit
              (begin
                (set! (array-ref candidates at) (+ base i))
                (set! at (+ at 1))))
            (set! i (+ i 1)))))
      (set! (array-ref cursor 1) at)
      (set! (array-ref cursor 0) (+ base len))
      changed)))

(define (compiler-reg-color-propagate-root-blocks
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [candidates : (__tl_dyn-array i64)]
  [cursor : (__tl_dyn-array i64)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [head : bool
              (compiler-reg-color-propagate-root-seq
                instrs
                (compiler-reg-global-shared-view range-of-var)
                (compiler-reg-global-shared-view roots)
                (compiler-reg-global-shared-view invalid)
                (compiler-reg-global-shared-view candidates)
                (compiler-reg-global-shared-view cursor))]
            [tail : bool
              (compiler-reg-color-propagate-root-blocks
                (compiler-reg-box-shared-view rest)
                range-of-var
                roots
                invalid
                (compiler-reg-global-shared-view candidates)
                cursor)]
            (or head tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [changed : bool false]
        (begin
          (while (<
            i
            (ir.compiler-ir-block-seq-count
              (compiler-reg-global-shared-view seq)))
            (begin
              (match (ir.compiler-ir-block-seq-ref
                (compiler-reg-global-shared-view seq)
                i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (if (compiler-reg-color-propagate-root-seq
                    instrs
                    (compiler-reg-global-shared-view range-of-var)
                    (compiler-reg-global-shared-view roots)
                    (compiler-reg-global-shared-view invalid)
                    (compiler-reg-global-shared-view candidates)
                    (compiler-reg-global-shared-view cursor))
                    (set! changed true)
                    unit)])
              (set! i (+ i 1))))
          changed))]))

;; Rounds two and up.
;;
;; `candidates[0, count)` holds, in block order, the function-wide ordinal of
;; every instruction the first round recorded. The ordinals are strictly
;; increasing and each block's share is one contiguous run, so a single pass
;; over the block list -- with `base` tracking the ordinal of the current
;; block's first instruction -- reaches exactly those instructions, in exactly
;; the order the per-block routine above reached them, and touches nothing else.
;; The sequence of compiler-reg-color-propagate-root-instr calls, and so the
;; sequence of writes to `roots`/`invalid`, is therefore identical to replaying
;; through that routine; only the walk that delivers them is different.
;;
;; The walk is spelled iteratively with the per-block body inline in both list
;; shapes. That is the whole point of the split: a later round pays no call per
;; block, no `cursor` round-trip, and no collect/replay branch -- it keeps
;; `base` and the `candidates` position in registers across the entire round.
;;
;; Two details keep the inner loop to one compare and one add of bookkeeping.
;; `ord` carries `candidates[at]` across the whole round, refilled with
;; `max-ordinal` once the list is exhausted; since every `limit` is a sum of
;; instruction counts it is far below that sentinel, so `(< ord limit)` decides
;; the block window and the end of the list in a single test, and the ordinal is
;; read once instead of once per guard and once per body. `changed-bits`
;; accumulates the result codes with `bit-or` instead of branching per
;; instruction: bit 1 of the accumulated word is set exactly when some attempt
;; set it, which is the same disjunction the per-block flag computed.
(define (compiler-reg-color-propagate-root-replay
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [candidates : (__tl_dyn-array i64)]
  [count : i64]) : bool
  (let
    [max-ordinal : i64 9223372036854775807]
    [cur : ir.CompilerIrBlockList blocks]
    [at : i64 0]
    [ord : i64
      (if (< 0 count)
        (compiler-reg-global-array-element-shared-view candidates 0)
        max-ordinal)]
    [base : i64 0]
    [changed-bits : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (match cur
          [(ir.CompilerIrBlockList.Nil) (set! done true)]
          [(ir.CompilerIrBlockList.Cons block rest)
            (begin
              (match block
                [(ir.CompilerIrBlock.Block _ instrs)
                  (let
                    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
                    [limit : i64
                      (+
                        base
                        (ir.compiler-ir-instr-seq-count
                          (compiler-reg-global-shared-view instrs)))]
                    (begin
                      (while (< ord limit)
                        (begin
                          (set!
                            changed-bits
                            (bit-or
                              changed-bits
                              (compiler-reg-color-propagate-root-instr
                                (compiler-reg-global-array-element-shared-view
                                  slots
                                  (- ord base))
                                (compiler-reg-global-shared-view range-of-var)
                                (compiler-reg-global-shared-view roots)
                                (compiler-reg-global-shared-view invalid))))
                          (set! at (+ at 1))
                          (set!
                            ord
                            (if (< at count)
                              (compiler-reg-global-array-element-shared-view
                                candidates
                                at)
                              max-ordinal))))
                      (set! base limit)))])
              (set! cur (compiler-reg-box-shared-view rest)))]
          [(ir.CompilerIrBlockList.Array seq)
            (let
              [i : i64 0]
              [n : i64
                (ir.compiler-ir-block-seq-count
                  (compiler-reg-global-shared-view seq))]
              (begin
                (while (< i n)
                  (begin
                    (match (ir.compiler-ir-block-seq-ref
                      (compiler-reg-global-shared-view seq)
                      i)
                      [(ir.CompilerIrBlock.Block _ instrs)
                        (let
                          [slots : (__tl_dyn-array ir.CompilerIrInstr)
                            instrs.slots]
                          [limit : i64
                            (+
                              base
                              (ir.compiler-ir-instr-seq-count
                                (compiler-reg-global-shared-view instrs)))]
                          (begin
                            (while (< ord limit)
                              (begin
                                (set!
                                  changed-bits
                                  (bit-or
                                    changed-bits
                                    (compiler-reg-color-propagate-root-instr
                                      (compiler-reg-global-array-element-shared-view
                                        slots
                                        (- ord base))
                                      (compiler-reg-global-shared-view
                                        range-of-var)
                                      (compiler-reg-global-shared-view roots)
                                      (compiler-reg-global-shared-view invalid))))
                                (set! at (+ at 1))
                                (set!
                                  ord
                                  (if (< at count)
                                    (compiler-reg-global-array-element-shared-view
                                      candidates
                                      at)
                                    max-ordinal))))
                            (set! base limit)))])
                    (set! i (+ i 1))))
                (set! done true)))]))
      (not (= (bit-and changed-bits 2) 0)))))

;; Total instruction count over the block list, from the per-sequence lengths
;; only -- it never touches an instruction.
(define (compiler-reg-color-instr-total
  [blocks : ir.CompilerIrBlockList]
  [total : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) total]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-instr-total
            (compiler-reg-box-shared-view rest)
            (+ total (ir.compiler-ir-instr-seq-count instrs)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 total]
        (begin
          (while (<
            i
            (ir.compiler-ir-block-seq-count
              (compiler-reg-global-shared-view seq)))
            (begin
              (match (ir.compiler-ir-block-seq-ref
                (compiler-reg-global-shared-view seq)
                i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! count (+ count (ir.compiler-ir-instr-seq-count instrs)))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-color-propagate-roots
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : unit
  (let
    [limit : i64 (array-length roots)]
    ;; `limit` is the round cap the loop below already enforced; at zero the
    ;; original loop ran no round at all, so nothing is collected either.
    (if (< limit 1)
      unit
      (let
        [candidates : (__tl_dyn-array i64)
          (array.make-array
            i64
            (compiler-reg-color-instr-total
              (compiler-reg-global-shared-view blocks)
              0))]
        [cursor : (__tl_dyn-array i64) (array.make-array i64 2)]
        [changed : bool
          (compiler-reg-color-propagate-root-blocks
            (compiler-reg-global-shared-view blocks)
            (compiler-reg-global-shared-view range-of-var)
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            (compiler-reg-global-shared-view candidates)
            (compiler-reg-global-shared-view cursor))]
        [count : i64 (array-ref cursor 1)]
        [rounds : i64 1]
        (while (and changed (< rounds limit))
          (begin
            (set!
              changed
              (compiler-reg-color-propagate-root-replay
                (compiler-reg-global-shared-view blocks)
                (compiler-reg-global-shared-view range-of-var)
                (compiler-reg-global-shared-view roots)
                (compiler-reg-global-shared-view invalid)
                (compiler-reg-global-shared-view candidates)
                count))
            (set! rounds (+ rounds 1))))))))

(define (compiler-reg-color-invalidate-root!
  [invalid : (__tl_dyn-array bool)]
  [root : i64]) : unit
  (if (and (>= root 0) (< root (array-length invalid)))
    (set! (array-ref invalid root) true)
    unit))

(define (compiler-reg-color-invalidate-value!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [value : ir.CompilerIrValue]) : unit
  (compiler-reg-color-invalidate-root!
    invalid
    (compiler-reg-color-value-root roots value)))

(define (compiler-reg-color-invalidate-maybe-value!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [value : ir.CompilerIrMaybeValue]) : unit
  (match value
    [(ir.CompilerIrMaybeValue.No) unit]
    [(ir.CompilerIrMaybeValue.Some inner)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        inner)]))

(define (compiler-reg-color-invalidate-call-args!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [args : ir.CompilerIrCallArgs]) : unit
  (match args
    [(ir.CompilerIrCallArgs.Nil) unit]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        a)]
    [(ir.CompilerIrCallArgs.Two a b)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          a)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          b))]
    [(ir.CompilerIrCallArgs.Array items)
      (let
        [i : i64 0]
        [len : i64 (array-length items)]
        (while (< i len)
          (begin
            (compiler-reg-color-invalidate-value!
              (compiler-reg-global-shared-view roots)
              (compiler-reg-global-shared-view invalid)
              (compiler-reg-global-array-element-shared-view items i))
            (set! i (+ i 1)))))]))

(define (compiler-reg-color-invalidate-spmd-call-args!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [args : ir.CompilerIrSpmdCallArgSeq]) : unit
  (let
    [i : i64 0]
    (while (< i args.len)
      (begin
        (match (array-ref args.slots i)
          [(ir.CompilerIrSpmdCallArg.Arg _ value _)
            (compiler-reg-color-invalidate-value! roots invalid value)])
        (set! i (+ i 1))))))

(define (compiler-reg-color-invalidate-phi!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [dst-root : i64]
  [inputs : ir.CompilerIrPhiInputList]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-invalidate-phi!
        roots
        invalid
        dst-root
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [root : i64
          (compiler-reg-color-value-root
            (compiler-reg-global-shared-view roots)
            value)]
        (begin
          (if (and (>= root 0) (not (= root dst-root)))
            (compiler-reg-color-invalidate-root!
              (compiler-reg-global-shared-view invalid)
              root)
            unit)
          (compiler-reg-color-invalidate-phi!
            roots
            invalid
            dst-root
            (compiler-reg-box-shared-view rest))))]))

(define (compiler-reg-color-invalidate-instr!
  [instr : ir.CompilerIrInstr]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst value _)
      (let
        [root : i64
          (compiler-reg-color-value-root
            (compiler-reg-global-shared-view roots)
            value)]
        (if (and
          (>= root 0)
          (or
            (>= dst (array-length roots))
            (not (= (array-ref roots dst) root))))
          (compiler-reg-color-invalidate-root! invalid root)
          unit))]
    [(ir.CompilerIrInstr.Gep dst base _ _)
      (let
        [root : i64
          (compiler-reg-color-value-root
            (compiler-reg-global-shared-view roots)
            base)]
        (if (and
          (>= root 0)
          (or
            (>= dst (array-length roots))
            (not (= (array-ref roots dst) root))))
          (compiler-reg-color-invalidate-root! invalid root)
          unit))]
    [(ir.CompilerIrInstr.StorePtr dst src _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        src)]
    [(ir.CompilerIrInstr.BoundsCheck index length _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          index)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          length))]
    [(ir.CompilerIrInstr.Cast _ src _ _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        src)]
    [(ir.CompilerIrInstr.Bitcast _ src _ _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        src)]
    [(ir.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          lhs)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          rhs))]
    [(ir.CompilerIrInstr.UnOp _ _ value _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        value)]
    [(ir.CompilerIrInstr.Splat _ value _ _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        value)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (compiler-reg-box-field-shared-view payload-box lhs)]
        [rhs (compiler-reg-box-field-shared-view payload-box rhs)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            lhs)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            rhs)))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (compiler-reg-box-field-shared-view payload-box src)]
        [carry (compiler-reg-box-field-shared-view payload-box carry)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            src)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            carry)))]
    [(ir.CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        src)]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (compiler-reg-box-field-shared-view payload-box lhs)]
        [rhs (compiler-reg-box-field-shared-view payload-box rhs)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            lhs)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            rhs)))]
    [(ir.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          lhs)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          rhs))]
    [(ir.CompilerIrInstr.MaskNot _ src _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        src)]
    [(ir.CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        src)]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (compiler-reg-box-field-shared-view payload-box dst)]
        [mask (compiler-reg-box-field-shared-view payload-box mask)]
        [true-value (compiler-reg-box-field-shared-view payload-box on-true)]
        [false-value (compiler-reg-box-field-shared-view payload-box on-false)]
        [left : i64
          (compiler-reg-color-value-root
            (compiler-reg-global-shared-view roots)
            true-value)]
        [right : i64
          (compiler-reg-color-value-root
            (compiler-reg-global-shared-view roots)
            false-value)]
        [dst-root : i64
          (if (and (>= dst 0) (< dst (array-length roots)))
            (array-ref roots dst)
            (- 0 1))]
        (begin
          (compiler-reg-color-invalidate-value!
            roots
            (compiler-reg-global-shared-view invalid)
            mask)
          (if (and (>= left 0) (not (= left dst-root)))
            (compiler-reg-color-invalidate-root!
              (compiler-reg-global-shared-view invalid)
              left)
            unit)
          (if (and (>= right 0) (not (= right dst-root)))
            (compiler-reg-color-invalidate-root! invalid right)
            unit)))]
    [(ir.CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          base)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          index))]
    [(ir.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (compiler-reg-box-field-shared-view payload-box base)]
        [index (compiler-reg-box-field-shared-view payload-box index)]
        [value (compiler-reg-box-field-shared-view payload-box value)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            base)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            index)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            value)))]
    [(ir.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (compiler-reg-box-field-shared-view payload-box base)]
        [index (compiler-reg-box-field-shared-view payload-box index)]
        [value (compiler-reg-box-field-shared-view payload-box value)]
        [mask (compiler-reg-box-field-shared-view payload-box mask)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            base)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            index)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            value)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            mask)))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (compiler-reg-box-field-shared-view payload-box base)]
        [index (compiler-reg-box-field-shared-view payload-box index)]
        [mask (compiler-reg-box-field-shared-view payload-box mask)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            base)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            index)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            mask)))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (compiler-reg-box-field-shared-view payload-box base)]
        [index-base (compiler-reg-box-field-shared-view payload-box index-base)]
        [index (compiler-reg-box-field-shared-view payload-box index)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            base)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            index-base)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            index)))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (compiler-reg-box-field-shared-view payload-box source)]
        [selector-low
          (compiler-reg-box-field-shared-view payload-box selector-low)]
        [selector-high
          (compiler-reg-box-field-shared-view payload-box selector-high)]
        [active-lanes
          (compiler-reg-box-field-shared-view payload-box active-lanes)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            source)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            selector-low)
          (match selector-high
            [(ir.CompilerIrMaybeValue.Some value)
              (compiler-reg-color-invalidate-value!
                (compiler-reg-global-shared-view roots)
                (compiler-reg-global-shared-view invalid)
                value)]
            [(ir.CompilerIrMaybeValue.No) unit])
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            active-lanes)))]
    [(ir.CompilerIrInstr.TailMask _ index length _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          index)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          length))]
    [(ir.CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          leaf)
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          subleaf))]
    [(ir.CompilerIrInstr.Xgetbv _ index)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        index)]
    [(ir.CompilerIrInstr.Syscall _ args)
      (compiler-reg-color-invalidate-call-args! roots invalid args)]
    [(ir.CompilerIrInstr.Call _ name args _)
      (if (string.eq (ir.compiler-ir-symbol-text name) "tl_memcpy")
        unit
        (compiler-reg-color-invalidate-call-args! roots invalid args))]
    [(ir.CompilerIrInstr.CallIndirect _ callee args _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          callee)
        (compiler-reg-color-invalidate-call-args! roots invalid args))]
    [(ir.CompilerIrInstr.CallIndirectC _ callee args _)
      (begin
        (compiler-reg-color-invalidate-value!
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)
          callee)
        (compiler-reg-color-invalidate-call-args! roots invalid args))]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (compiler-reg-box-field-shared-view payload-box base)]
        [args (compiler-reg-box-field-shared-view payload-box args)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            base)
          (compiler-reg-color-invalidate-call-args! roots invalid args)))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (compiler-reg-box-field-shared-view payload-box base)]
        [callee (compiler-reg-box-field-shared-view payload-box callee)]
        [args (compiler-reg-box-field-shared-view payload-box args)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            base)
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            callee)
          (compiler-reg-color-invalidate-call-args! roots invalid args)))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (compiler-reg-box-field-shared-view payload-box active-mask)]
        [args (compiler-reg-box-field-shared-view payload-box args)]
        (begin
          (compiler-reg-color-invalidate-value!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid)
            active-mask)
          (compiler-reg-color-invalidate-spmd-call-args! roots invalid args)))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (compiler-reg-color-invalidate-call-args! roots invalid args)]
    [(ir.CompilerIrInstr.Store _ value _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        value)]
    [(ir.CompilerIrInstr.Branch value _ _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        value)]
    [(ir.CompilerIrInstr.TotalEnumBranch value _ _)
      (compiler-reg-color-invalidate-value!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        value)]
    [(ir.CompilerIrInstr.Return value)
      (compiler-reg-color-invalidate-maybe-value! roots invalid value)]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-invalidate-phi!
        (compiler-reg-global-shared-view roots)
        (compiler-reg-global-shared-view invalid)
        (if (and (>= dst 0) (< dst (array-length roots)))
          (array-ref roots dst)
          (- 0 1))
        (compiler-reg-global-shared-view inputs))]
    [_ unit]))

(define (compiler-reg-color-invalidate-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (compiler-reg-global-shared-view instrs.slots)]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [i : i64 0]
    (while (< i len)
      (begin
        (compiler-reg-color-invalidate-instr!
          (compiler-reg-global-array-element-shared-view slots i)
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid))
        (set! i (+ i 1))))))

(define (compiler-reg-color-invalidate-blocks!
  [blocks : ir.CompilerIrBlockList]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-invalidate-seq!
              (compiler-reg-global-shared-view instrs)
              (compiler-reg-global-shared-view roots)
              (compiler-reg-global-shared-view invalid))])
        (compiler-reg-color-invalidate-blocks!
          (compiler-reg-box-shared-view rest)
          (compiler-reg-global-shared-view roots)
          (compiler-reg-global-shared-view invalid)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (<
          i
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq)))
          (begin
            (match (ir.compiler-ir-block-seq-ref
              (compiler-reg-global-shared-view seq)
              i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-invalidate-seq!
                  (compiler-reg-global-shared-view instrs)
                  (compiler-reg-global-shared-view roots)
                  (compiler-reg-global-shared-view invalid))])
            (set! i (+ i 1)))))]))

(define (compiler-reg-color-range-liveness!
  [roots : (__tl_dyn-array i64)]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [range-starts : (__tl_dyn-array i64)]
  [range-ends : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    [_max-start : i64 9223372036854775807]
    (while (< i (array-length roots))
      (let
        [root : i64 (array-ref roots i)]
        (begin
          (if (and (>= root 0) (< root (array-length range-starts)))
            (let
              [start : i64 (array-ref starts i)]
              [end : i64 (array-ref ends i)]
              (if (>= start 0)
                (begin
                  (if (< start (array-ref range-starts root))
                    (set! (array-ref range-starts root) start)
                    unit)
                  (if (> end (array-ref range-ends root))
                    (set! (array-ref range-ends root) end)
                    unit))
                unit))
            unit)
          (set! i (+ i 1)))))))

(define (compiler-reg-color-range-free?
  [slot-ends : (__tl_dyn-array i64)]
  [slot : i64]
  [size : i64]
  [start : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (if (> (+ slot size) (array-length slot-ends))
        (set! ok false)
        unit)
      (while (and ok (< i size))
        (begin
          (if (< (array-ref slot-ends (+ slot i)) start)
            unit
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

(define (compiler-reg-color-next-free-range
  [slot-ends : (__tl_dyn-array i64)]
  [from : i64]
  [size : i64]
  [start : i64]) : i64
  (let
    [slot : i64 from]
    [done : bool false]
    (begin
      (while (not done)
        (if (compiler-reg-color-range-free?
          (compiler-reg-global-shared-view slot-ends)
          slot
          size
          start)
          (set! done true)
          (set! slot (+ slot 1))))
      slot)))

(define (compiler-reg-color-set-range-ends!
  [slot-ends : (__tl_dyn-array i64)]
  [slot : i64]
  [size : i64]
  [end : i64]) : unit
  (let
    [i : i64 0]
    (while (< i size)
      (begin
        (if (< (+ slot i) (array-length slot-ends))
          (set! (array-ref slot-ends (+ slot i)) end)
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-remap-storage-range!
  [remap : (__tl_dyn-array i64)]
  [base : i64]
  [size : i64]
  [slot : i64]) : unit
  (let
    [first : i64 (+ (- base size) 1)]
    [i : i64 0]
    (while (< i size)
      (begin
        (if (and (>= (+ first i) 0) (< (+ first i) (array-length remap)))
          (set! (array-ref remap (+ first i)) (+ slot i))
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-range-clear?
  [remap : (__tl_dyn-array i64)]
  [base : i64]
  [size : i64]) : bool
  (let
    [first : i64 (+ (- base size) 1)]
    [i : i64 0]
    [ok : bool true]
    (begin
      (while (and ok (< i size))
        (begin
          (if (and
            (>= (+ first i) 0)
            (< (+ first i) (array-length remap))
            (< (array-ref remap (+ first i)) 0))
            unit
            (set! ok false))
          (set! i (+ i 1))))
      ok)))

(define (compiler-reg-color-storage-ranges
  [slot-ends : (__tl_dyn-array i64)]
  [remap : (__tl_dyn-array i64)]
  [range-base : (__tl_dyn-array i64)]
  [range-size : (__tl_dyn-array i64)]
  [range-starts : (__tl_dyn-array i64)]
  [range-ends : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [range-count : i64]
  [from : i64]) : i64
  (let
    [range : i64 0]
    [used : i64 from]
    [max-start : i64 9223372036854775807]
    (begin
      (while (< range range-count)
        (let
          [start : i64 (array-ref range-starts range)]
          [end : i64 (array-ref range-ends range)]
          [size : i64 (array-ref range-size range)]
          [base : i64 (array-ref range-base range)]
          (begin
            (if (and
              (not (array-ref invalid range))
              (< start max-start)
              (>= end start)
              (> size 0)
              (compiler-reg-color-range-clear?
                (compiler-reg-global-shared-view remap)
                base
                size))
              (let
                [slot : i64
                  (compiler-reg-color-next-free-range
                    (compiler-reg-global-shared-view slot-ends)
                    from
                    size
                    start)]
                (begin
                  (compiler-reg-color-set-range-ends!
                    (compiler-reg-global-shared-view slot-ends)
                    slot
                    size
                    end)
                  (compiler-reg-color-remap-storage-range!
                    (compiler-reg-global-shared-view remap)
                    base
                    size
                    slot)
                  (if (> (+ slot size) used)
                    (set! used (+ slot size))
                    unit)))
              unit)
            (set! range (+ range 1)))))
      used)))

;; Color only contiguous inline-storage ranges. These slots are addressed only
;; through AddrOf/Gep-derived pointers, so ranges may share ids with each other
;; when their pointer lifetimes are disjoint. They deliberately start after the
;; scalar stack prefix to avoid giving a real scalar value and an aggregate
;; storage word the same global type-table key.
(define (compiler-reg-color-inline-storage
  [blocks : ir.CompilerIrBlockList]
  [intervals : CompilerRegIntervalSeq]
  [slot-ends : (__tl_dyn-array i64)]
  [remap : (__tl_dyn-array i64)]
  [vars : i64]
  [from : i64]) : i64
  ;; Detection reads and writes only the three arrays it is handed, and most
  ;; functions have no storage range at all, so only those three are allocated
  ;; and seeded up front; the six the rest of the pass needs are built inside
  ;; the non-empty branch. `range-size` is not seeded: `array.make-array`
  ;; zero-fills, detection writes [0, range-count) itself, and
  ;; `compiler-reg-color-storage-ranges` reads no element past that bound.
  ;; `invalid` likewise starts all-false from the zero-fill.
  (let
    [range-of-var : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [range-base : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [range-size : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [_cleared : unit
      (let
        [i : i64 0]
        (while (< i vars)
          (begin
            (set! (array-ref range-of-var i) (- 0 1))
            (set! (array-ref range-base i) (- 0 1))
            (set! i (+ i 1)))))]
    [range-count : i64
      (compiler-reg-color-detect-storage-blocks
        (compiler-reg-global-shared-view blocks)
        (compiler-reg-global-shared-view range-of-var)
        (compiler-reg-global-shared-view range-base)
        (compiler-reg-global-shared-view range-size)
        0)]
    (if (= range-count 0)
      from
      (let
        [range-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [range-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [invalid : (__tl_dyn-array bool) (array.make-array bool vars)]
        [roots : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [max-start : i64 9223372036854775807]
        [_seeded : unit
          (let
            [i : i64 0]
            (while (< i vars)
              (begin
                (set! (array-ref range-starts i) max-start)
                (set! (array-ref range-ends i) (- 0 1))
                (set! (array-ref roots i) (- 0 1))
                (set! (array-ref starts i) (- 0 1))
                (set! (array-ref ends i) (- 0 1))
                (set! i (+ i 1)))))]
        (begin
          (compiler-reg-color-fill-interval-bounds
            (compiler-reg-global-shared-view intervals)
            (compiler-reg-global-shared-view starts)
            (compiler-reg-global-shared-view ends))
          (compiler-reg-color-propagate-roots
            (compiler-reg-global-shared-view blocks)
            (compiler-reg-global-shared-view range-of-var)
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid))
          (compiler-reg-color-invalidate-blocks!
            (compiler-reg-global-shared-view blocks)
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view invalid))
          (compiler-reg-color-range-liveness!
            (compiler-reg-global-shared-view roots)
            (compiler-reg-global-shared-view starts)
            (compiler-reg-global-shared-view ends)
            (compiler-reg-global-shared-view range-starts)
            (compiler-reg-global-shared-view range-ends))
          (compiler-reg-color-storage-ranges
            (compiler-reg-global-shared-view slot-ends)
            (compiler-reg-global-shared-view remap)
            (compiler-reg-global-shared-view range-base)
            (compiler-reg-global-shared-view range-size)
            (compiler-reg-global-shared-view range-starts)
            (compiler-reg-global-shared-view range-ends)
            (compiler-reg-global-shared-view invalid)
            range-count
            from))))))

;; Rebuild the var-type table on remapped keys. Storage-range coloring may alias
;; multiple old inline-storage vars onto the same new id, but those ids are
;; never used as scalar value keys; later entries may overwrite the unused
;; storage type without affecting emission.
(define (compiler-reg-color-scatter-types
  [remap : (__tl_dyn-array i64)]
  [present : (__tl_dyn-array i64)]
  [items : (__tl_dyn-array ast.AstType)]
  [types : CompilerRegVarTypes]) : unit
  (let
    [source-present : (__tl_dyn-array i64) types.present]
    [source-items : (__tl_dyn-array ast.AstType) types.items]
    [index : i64 0]
    (while (< index (array-length source-present))
      (begin
        (if (=
          (compiler-reg-global-array-element-shared-view source-present index)
          0)
          unit
          (compiler-reg-var-type-array-set!
            (compiler-reg-global-shared-view present)
            (compiler-reg-global-shared-view items)
            (compiler-reg-remap-id
              (compiler-reg-global-shared-view remap)
              index)
            (compiler-reg-global-array-element-shared-view source-items index)))
        (set! index (+ index 1))))))

(define (compiler-reg-color-rebuild-types
  [remap : (__tl_dyn-array i64)]
  [vars : i64]
  [types : CompilerRegVarTypes]) : CompilerRegVarTypes
  (let
    [present : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [items : (__tl_dyn-array ast.AstType) (array.make-array ast.AstType vars)]
    (begin
      (compiler-reg-color-scatter-types
        remap
        (compiler-reg-global-shared-view present)
        (compiler-reg-global-shared-view items)
        (compiler-reg-global-shared-view types))
      (CompilerRegVarTypes present items types.representations))))

;; Spilled scalars are dropped: the id remap re-homes them, so emission's
;; formula-slot fallback covers the new id and a stale Spill offset keyed by
;; the old id must never shadow it.
(define (compiler-reg-color-scatter-assignments
  [remap : (__tl_dyn-array i64)]
  [present : (__tl_dyn-array i64)]
  [items : (__tl_dyn-array CompilerRegLocation)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (let
    [source-present : (__tl_dyn-array i64) assignments.present]
    [source-items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [var : i64 0]
    (begin
      (while (< var (array-length source-present))
        (begin
          (if (=
            (compiler-reg-global-array-element-shared-view source-present var)
            0)
            unit
            (let
              [location : CompilerRegLocation
                (compiler-reg-global-array-element-shared-view source-items var)]
              (match (compiler-reg-global-shared-view location)
                [(CompilerRegLocation.Spill _) unit]
                [_
                  (let
                    [new-id : i64
                      (compiler-reg-remap-id
                        (compiler-reg-global-shared-view remap)
                        var)]
                    (if (and (>= new-id 0) (< new-id (array-length present)))
                      (begin
                        (set! (array-ref present new-id) 1)
                        (set! (array-ref items new-id) location))
                      unit))])))
          (set! var (+ var 1))))
      unit)))

(define (compiler-reg-color-rebuild-assignments
  [remap : (__tl_dyn-array i64)]
  [vars : i64]
  [assignments : CompilerRegAssignmentTable]) : CompilerRegAssignmentTable
  (let
    [present : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [items : (__tl_dyn-array CompilerRegLocation)
      (array.make-array CompilerRegLocation vars)]
    (begin
      (compiler-reg-fill-location-array
        (compiler-reg-global-shared-view items)
        (CompilerRegLocation.Spill 0))
      (compiler-reg-color-scatter-assignments
        remap
        (compiler-reg-global-shared-view present)
        (compiler-reg-global-shared-view items)
        assignments)
      (CompilerRegAssignmentTable present items))))

;; Identity-pin scalar parameter variables: the prologue's param spill writes
;; each parameter to its remapped formula slot, and ordinary parameters keep
;; their ids so those slots are never shared. AVX2 private SPMD parameters need
;; a four-word YMM range, so leave those unpinned for the private-range pass.
(define (compiler-reg-color-param-pins
  [params : ir.CompilerIrParamList]
  [remap : (__tl_dyn-array i64)]
  [slot-ends : (__tl_dyn-array i64)]
  [highest : i64]) : i64
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) highest]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-color-param-pins
        (ir.compiler-ir-param-seq-to-list seq)
        remap
        slot-ends
        highest)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name _ var-id)
          (begin
            (if (and
              (not
                (compiler-reg-spmd-avx2-special-param?
                  (compiler-reg-global-shared-view name)))
              (< var-id (array-length remap)))
              (begin
                (set! (array-ref remap var-id) var-id)
                (set! (array-ref slot-ends var-id) 9223372036854775807))
              unit)
            (compiler-reg-color-param-pins
              (compiler-reg-box-shared-view rest)
              remap
              slot-ends
              (if (compiler-reg-spmd-avx2-special-param? name)
                highest
                (compiler-reg-max highest (+ var-id 1)))))])]))

;; --- M-B: stack-homed register-group Mov coalescing -------------------------
;; A group-typed `IrInstrMov dst <- src` between two slot-resident group vars
;; round-trips both 8-byte words through the group-return register pair into a
;; SECOND slot pair (4 movs per enum/struct copy, e.g. every match-scrutinee
;; binding). When src's live range ends exactly where dst's begins -- at the
;; mov itself: src's last read is the copy that first defines dst -- the two
;; vars can share one slot pair. The coloring remap aliases dst's id onto
;; src's id, so the emitted IR carries ONE var (word0 + word1 formula slots
;; follow the id) and the mov becomes a same-home no-op the backend elides.
;;
;; Guards (all required):
;;   * dst != src, both group vars (fn-group-vars) of ast-type-eq? types --
;;     same word count and SSE word classes, and the rebuilt per-id type
;;     table entry stays exact for the merged id;
;;   * both slot-resident (CompilerRegNoLocation): never register/pair (their
;;     homes differ), never Spill (a spilled group uses the adjacent
;;     [offset, offset-8] layout, not the two-region formula slots), never
;;     Remat;
;;   * neither in `ineligible`: excludes AddrOf'd vars, whose intervals
;;     understate pointer-mediated reads, and group params, whose formula
;;     slots are the prologue's ABI hand-off contract;
;;   * neither already remapped (parameter identity pins, storage ranges);
;;   * hull(src).end == hull(dst).start, both hulls present. Interval points
;;     are unique per instruction (2 coords each), so this equality proves
;;     the same instruction carries src's LAST liveness event (a read; src is
;;     not in its live-after) and dst's FIRST (its def) -- and that
;;     instruction is this mov. Vars minted by the caller-save/loop-split/
;;     remat/splitkit rewrites have no plan interval and fail the hull check;
;;     those rewrites only insert reads where a value is genuinely live and
;;     only redefine register-homed values, so the plan hulls remain valid
;;     order witnesses for the NoLocation vars admitted here.
(define (compiler-reg-color-hull-bounds
  [intervals : CompilerRegIntervalSeq]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 interval.var]
          [start : i64 interval.start]
          [end : i64 interval.end]
          (if (and (>= var 0) (< var (array-length starts)))
            (begin
              (if (or
                (< (array-ref starts var) 0)
                (< start (array-ref starts var)))
                (set! (array-ref starts var) start)
                unit)
              (if (> end (array-ref ends var))
                (set! (array-ref ends var) end)
                unit))
            unit))
        (set! index (+ index 1))))))

(define (compiler-reg-color-group-mov-alias-instr!
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [alias : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [remap : (__tl_dyn-array i64)]
  [hull-starts : (__tl_dyn-array i64)]
  [hull-ends : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var src-var)
          (if (and
            (>= dst 0)
            (< dst (array-length alias))
            (>= src-var 0)
            (< src-var (array-length alias))
            (not (= dst src-var))
            (live.compiler-live-set-contains?
              (compiler-reg-global-shared-view group-vars)
              dst)
            (live.compiler-live-set-contains? group-vars src-var)
            (not
              (live.compiler-live-set-contains?
                (compiler-reg-global-shared-view ineligible)
                dst))
            (not (live.compiler-live-set-contains? ineligible src-var))
            (< (compiler-reg-global-array-element-shared-view remap dst) 0)
            (< (compiler-reg-global-array-element-shared-view remap src-var) 0)
            (>=
              (compiler-reg-global-array-element-shared-view hull-starts dst)
              0)
            (>=
              (compiler-reg-global-array-element-shared-view
                hull-starts
                src-var)
              0)
            (=
              (compiler-reg-global-array-element-shared-view hull-ends src-var)
              (compiler-reg-global-array-element-shared-view hull-starts dst))
            (ast.ast-type-eq-with-seg-bases?
              type-segment-bases
              (compiler-reg-global-array-element-shared-view var-tys dst)
              (compiler-reg-global-array-element-shared-view var-tys src-var))
            (match (compiler-reg-assignment-table-lookup assignment-index dst)
              [(CompilerRegMaybeLocation.Some _) false]
              [(CompilerRegMaybeLocation.No) true])
            (match (compiler-reg-assignment-table-lookup
              assignment-index
              src-var)
              [(CompilerRegMaybeLocation.Some _) false]
              [(CompilerRegMaybeLocation.No) true]))
            (set! (array-ref alias dst) src-var)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-color-group-mov-alias-seq!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [alias : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [remap : (__tl_dyn-array i64)]
  [hull-starts : (__tl_dyn-array i64)]
  [hull-ends : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [i : i64 0]
    (while (< i len)
      (begin
        (compiler-reg-color-group-mov-alias-instr!
          type-segment-bases
          (compiler-reg-global-array-element-shared-view slots i)
          (compiler-reg-global-shared-view alias)
          (compiler-reg-global-shared-view group-vars)
          (compiler-reg-global-shared-view ineligible)
          (compiler-reg-global-shared-view assignment-index)
          (compiler-reg-global-shared-view var-tys)
          (compiler-reg-global-shared-view remap)
          (compiler-reg-global-shared-view hull-starts)
          (compiler-reg-global-shared-view hull-ends))
        (set! i (+ i 1))))))

(define (compiler-reg-color-group-mov-alias-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [alias : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [remap : (__tl_dyn-array i64)]
  [hull-starts : (__tl_dyn-array i64)]
  [hull-ends : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-group-mov-alias-seq!
              type-segment-bases
              instrs
              (compiler-reg-global-shared-view alias)
              (compiler-reg-global-shared-view group-vars)
              (compiler-reg-global-shared-view ineligible)
              (compiler-reg-global-shared-view assignment-index)
              (compiler-reg-global-shared-view var-tys)
              (compiler-reg-global-shared-view remap)
              (compiler-reg-global-shared-view hull-starts)
              (compiler-reg-global-shared-view hull-ends))])
        (compiler-reg-color-group-mov-alias-blocks!
          type-segment-bases
          (compiler-reg-box-shared-view rest)
          alias
          group-vars
          ineligible
          assignment-index
          var-tys
          remap
          hull-starts
          hull-ends))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (<
          i
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq)))
          (begin
            (match (ir.compiler-ir-block-seq-ref
              (compiler-reg-global-shared-view seq)
              i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-group-mov-alias-seq!
                  type-segment-bases
                  instrs
                  (compiler-reg-global-shared-view alias)
                  (compiler-reg-global-shared-view group-vars)
                  (compiler-reg-global-shared-view ineligible)
                  (compiler-reg-global-shared-view assignment-index)
                  (compiler-reg-global-shared-view var-tys)
                  (compiler-reg-global-shared-view remap)
                  (compiler-reg-global-shared-view hull-starts)
                  (compiler-reg-global-shared-view hull-ends))])
            (set! i (+ i 1)))))]))

;; Follow an alias chain (C=B after B=A) to its root. Chains are acyclic by
;; construction -- each link strictly advances the hull touch point -- but a
;; step cap keeps this total on any malformed input.
(define (compiler-reg-color-group-alias-root
  [alias : (__tl_dyn-array i64)]
  [var : i64]) : i64
  (let
    [root : i64 var]
    [steps : i64 0]
    (begin
      (while (and
        (< steps 64)
        (>= root 0)
        (< root (array-length alias))
        (>= (array-ref alias root) 0))
        (begin
          (set! root (array-ref alias root))
          (set! steps (+ steps 1))))
      root)))

;; --- M-B2: stack-homed SCALAR phi/mov web slot sharing ----------------------
;; A spilled phi web costs a slot-to-slot copy on every incoming edge: the phi's
;; input is written to ITS slot and then copied into the phi's slot (four
;; instructions once the backend has to scavenge a scratch register through
;; push/pop). When the members never hold a live value at the same time ONE slot
;; serves the whole web and every one of those copies disappears: the coloring
;; remap merges their ids, so `compiler-backend-vars-same-home?` (same var id =>
;; same home) makes the backend's leading-phi-copy builder drop the copy before
;; emission, and a Mov between merged ids is a same-home no-op.
;;
;; INTERFERENCE MODEL. The plan's intervals are the CONSERVATIVE hulls, which
;; treat a phi as USING every input AT THE PHI BLOCK; that leaks a loop carry
;; backward around its own loop, so the carry's hull overlaps its phi's hull from
;; function entry onward and the pairs worth merging all look live at once.
;; Legality is therefore judged on EDGE-PRECISE hulls (LLVM PHIElimination
;; semantics: an input is a copy at the end of ITS OWN predecessor), the exact
;; SSA interference model the register coalescer already trusts, recomputed here
;; over the FINAL rewritten blocks so its point coordinates describe the IR the
;; backend actually emits. The plan's conservative hulls keep their existing job
;; unchanged -- deciding which OTHER variable may reuse a slot -- through the
;; ordinary disjoint-interval walk, which now sees the whole web as one variable
;; and therefore reserves the UNION of the members' conservative hulls.
;;
;; WEB RULE (conservative; when in doubt, no alias). Membership is decided by
;; PAIRWISE EP-hull disjointness: a web may absorb another web only when EVERY
;; cross pair of members has non-overlapping hulls, so every pair of members in
;; the result is provably never live at once. The single exception is a Mov
;; witness: `hull(src).end == hull(dst).start` is admitted for THAT pair --
;; exactly the group-Mov rule above. Interval points are unique per instruction
;; (2 coords each), so that equality proves this mov carries src's LAST liveness
;; event and dst's FIRST. A touch WITHOUT a Mov witness is rejected: the backend
;; may write a destination home before reading a source home, and phi parallel
;; copies at a block edge read inputs and write destinations at the same interval
;; position -- the same hazard that makes compiler-reg-color-find-slot demand a
;; STRICT `<`.
;;
;; ORDER INDEPENDENCE (M-B3). The rule above replaces a monotone one: a variable
;; used to join only when its hull started strictly after the web's LATEST end
;; (`web-end`), and only while still virgin. Both guards made the result depend
;; on the order links are offered, and rejected merges that do not interfere at
;; all. In intern_table's it-intern-slice all three loop carries lost their
;; carry-to-phi merge that way: the web absorbed the LATER back-edge member
;; first, after which `web-end` sat past the earlier member's start even though
;; the two hulls are disjoint; and a phi dst that had already joined one web
;; could never be joined to a second. Both are now expressible: webs are unioned
;; (not just extended), and the admission test looks at all member pairs instead
;; of a single running maximum.
;;
;; The old monotone test is still tried FIRST and, when it passes, takes exactly
;; the old action -- so the Mov at-boundary allowance keeps its precise shape and
;; every merge the previous rule would have made at a given state is still made:
;; `web-end(root) < start(later)` implies `end(m) <= web-end(root) < start(later)`
;; for every member m, which is the all-pairs test. The pass therefore admits a
;; superset of the old merges at each decision point.
;;
;; COST. Webs are held as an intrusive circular member list (`web-next`, a
;; singleton points at itself) with a size counter, and merges are gated on the
;; combined size fitting `compiler-reg-color-scalar-web-cap`. One link attempt is
;; O(1) when either web is a singleton -- the overwhelmingly common case, and
;; exactly today's cost -- and at worst O(cap^2) bounded array reads. The splice
;; itself is O(size(absorbed)) and re-points every absorbed member directly at the
;; surviving root, so `alias` stays the depth-one forest the remap propagation and
;; interval rewrite expect.
;;
;; MEMBERSHIP GUARDS mirror the scalar walk's own admission rules, so a merged
;; web colors exactly as one of its members would have: colorable scalars of one
;; stack word, never group vars (their formula slots are the prologue's ABI
;; hand-off contract), never `ineligible` (AddrOf'd vars, whose intervals
;; understate pointer-mediated reads), never already remapped (parameter
;; identity pins), never register-homed (their homes are not slots),
;; ast-type-identical (the rebuilt per-id type table keeps ONE type for the
;; merged id, and the backend recovers operand width from it), and a plan
;; interval must exist -- vars minted by the caller-save/loop-split/remat
;; rewrites have none and the walk never colors them.
(define (compiler-reg-color-ep-hull-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [live-afters : live.CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [after-items : (__tl_dyn-array live.CompilerLiveI64Set) live-afters.items]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [instr : ir.CompilerIrInstr
            (compiler-reg-global-array-element-shared-view slots index)]
          [live-after : live.CompilerLiveI64Set
            (if (< index (array-length after-items))
              (compiler-reg-global-array-element-shared-view after-items index)
              (live.compiler-live-set-empty))]
          [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
          [id-count : i64
            (live.compiler-live-instr-use-ids-nophi!
              (compiler-reg-global-shared-view instr))]
          (begin
            (if (< id-count 0)
              (begin
                (compiler-reg-extend-set-words
                  (compiler-reg-global-shared-view starts)
                  (compiler-reg-global-shared-view ends)
                  (live.compiler-live-instr-defs
                    (compiler-reg-global-shared-view instr))
                  0
                  out-point)
                (compiler-reg-extend-set-words
                  (compiler-reg-global-shared-view starts)
                  (compiler-reg-global-shared-view ends)
                  (live.compiler-live-instr-uses-nophi instr)
                  0
                  out-point))
              (begin
                (compiler-reg-extend-interval
                  (compiler-reg-global-shared-view starts)
                  (compiler-reg-global-shared-view ends)
                  (live.compiler-live-instr-def-var instr)
                  out-point)
                (compiler-reg-extend-interval-ids!
                  (compiler-reg-global-shared-view starts)
                  (compiler-reg-global-shared-view ends)
                  ids
                  id-count
                  out-point)))
            (compiler-reg-extend-set-words
              (compiler-reg-global-shared-view starts)
              (compiler-reg-global-shared-view ends)
              live-after
              0
              (+ out-point 1))
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-color-ep-hull-blocks!
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (compiler-reg-color-ep-hull-blocks!
            (compiler-reg-box-shared-view rest)
            (compiler-reg-global-shared-view liveness)
            (compiler-reg-color-ep-hull-seq!
              instrs
              (compiler-reg-live-intervals-find-afters liveness label)
              point
              (compiler-reg-global-shared-view starts)
              (compiler-reg-global-shared-view ends))
            starts
            ends)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq))]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref
                (compiler-reg-global-shared-view seq)
                i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    out-point
                    (compiler-reg-color-ep-hull-seq!
                      instrs
                      (compiler-reg-live-intervals-find-afters
                        (compiler-reg-global-shared-view liveness)
                        label)
                      out-point
                      (compiler-reg-global-shared-view starts)
                      (compiler-reg-global-shared-view ends)))])
              (set! i (+ i 1))))
          out-point))]))

;; Per-variable core of the scalar walk's admission test: colorable, not
;; group- or ineligible-pinned, not already renumbered by the parameter pins,
;; and not register-homed. Nothing here changes between the scalar-web builder
;; and the walk itself, so it is decided ONCE per variable and read back as a
;; single array probe by both the web-eligibility pass below and the interval
;; filter that feeds the walk -- which would otherwise repeat two live-set
;; probes and an assignment lookup per variable AND again per interval.
(define (compiler-reg-color-slot-eligible!
  [slot-eligible : (__tl_dyn-array bool)]
  [vars : i64]
  [group-vars : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [assignment-index : CompilerRegAssignmentTable]
  [colorable : (__tl_dyn-array bool)]
  [remap : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (set!
          (array-ref slot-eligible i)
          (and
            (array-ref colorable i)
            (not
              (live.compiler-live-set-contains?
                (compiler-reg-global-shared-view group-vars)
                i))
            (not
              (live.compiler-live-set-contains?
                (compiler-reg-global-shared-view ineligible)
                i))
            (< (array-ref remap i) 0)
            (match (compiler-reg-assignment-table-lookup assignment-index i)
              [(CompilerRegMaybeLocation.Some location)
                (match location
                  [(CompilerRegLocation.Spill _) true]
                  [_ false])]
              [(CompilerRegMaybeLocation.No) true])))
        (set! i (+ i 1))))))

;; One membership decision per variable, taken once so the per-pair test below
;; is three array reads. The scalar walk's own admission test plus the two
;; extra conditions a web member must meet.
(define (compiler-reg-color-scalar-alias-eligible!
  [eligible : (__tl_dyn-array bool)]
  [vars : i64]
  [slot-eligible : (__tl_dyn-array bool)]
  [hull-starts : (__tl_dyn-array i64)]
  [vector-stack-words : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (set!
          (array-ref eligible i)
          (and
            (array-ref slot-eligible i)
            (>= (array-ref hull-starts i) 0)
            (=
              (compiler-reg-vector-stack-words-for-var
                (compiler-reg-global-shared-view vector-stack-words)
                i)
              1)))
        (set! i (+ i 1))))))

;; Largest web the all-pairs admission test will build. Bounds every member walk
;; below and keeps a link attempt's worst case at a few hundred array reads; real
;; webs are far smaller (the deepest in the benchmark corpus is 7).
(define compiler-reg-color-scalar-web-cap : i64
  16)

;; EP hulls are convex intervals, so non-overlap is exactly one endpoint compare.
(define (compiler-reg-color-scalar-hulls-disjoint?
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : bool
  (or
    (< (array-ref ep-ends a) (array-ref ep-starts b))
    (< (array-ref ep-ends b) (array-ref ep-starts a))))

;; Disjointness of `x` against every member of the web whose circular member list
;; starts at `root-b`. The single pair (touch-a, touch-b) -- the Mov witness's own
;; src/dst -- may TOUCH at `end(touch-a) == start(touch-b)`; every other pair must
;; be strictly disjoint. Callers pass -1/-1 when there is no Mov witness, which no
;; real var id can equal.
(define (compiler-reg-color-scalar-web-var-disjoint?
  [web-next : (__tl_dyn-array i64)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [x : i64]
  [root-b : i64]
  [touch-a : i64]
  [touch-b : i64]) : bool
  (let
    [y : i64 root-b]
    [steps : i64 0]
    (begin
      (while (< steps compiler-reg-color-scalar-web-cap)
        (begin
          (unless
            (compiler-reg-color-scalar-hulls-disjoint?
              (compiler-reg-global-shared-view ep-starts)
              (compiler-reg-global-shared-view ep-ends)
              x
              y)
            (unless
              (and
                (or
                  (and (= x touch-a) (= y touch-b))
                  (and (= x touch-b) (= y touch-a)))
                (= (array-ref ep-ends touch-a) (array-ref ep-starts touch-b)))
              (return false)))
          (set! y (array-ref web-next y))
          (set! steps (+ steps 1))
          (when (= y root-b) (return true))))
      false)))

;; Every cross pair of the two webs is disjoint (see the header's WEB RULE).
(define (compiler-reg-color-scalar-webs-disjoint?
  [web-next : (__tl_dyn-array i64)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [root-a : i64]
  [root-b : i64]
  [touch-a : i64]
  [touch-b : i64]) : bool
  (let
    [x : i64 root-a]
    [steps : i64 0]
    (begin
      (while (< steps compiler-reg-color-scalar-web-cap)
        (begin
          (unless
            (compiler-reg-color-scalar-web-var-disjoint?
              (compiler-reg-global-shared-view web-next)
              (compiler-reg-global-shared-view ep-starts)
              (compiler-reg-global-shared-view ep-ends)
              x
              root-b
              touch-a
              touch-b)
            (return false))
          (set! x (array-ref web-next x))
          (set! steps (+ steps 1))
          (when (= x root-a) (return true))))
      false)))

;; Absorb the web rooted at `root-b` into the one rooted at `root-a`: re-point
;; every absorbed member's alias directly at `root-a` (keeping the forest depth
;; one), splice the two circular lists, and carry the size and hull end across.
(define (compiler-reg-color-scalar-web-splice!
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [root-a : i64]
  [root-b : i64]) : unit
  (let
    [a-next : i64 (array-ref web-next root-a)]
    [count : i64 (array-ref web-size root-b)]
    [member : i64 root-b]
    [last : i64 root-b]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref alias member) root-a)
          (set! (array-ref web-root member) false)
          (set!
            (array-ref web-end root-a)
            (compiler-reg-max
              (array-ref web-end root-a)
              (array-ref ep-ends member)))
          (set! last member)
          (set! member (array-ref web-next member))
          (set! i (+ i 1))))
      (set! (array-ref web-next root-a) root-b)
      (set! (array-ref web-next last) a-next)
      (set! (array-ref alias root-a) (- 0 1))
      (set! (array-ref web-root root-a) true)
      (set! (array-ref web-size root-a) (+ (array-ref web-size root-a) count))
      unit)))

;; Join the web owning `later` to the web owning `earlier`. The old monotone test
;; (web's latest EP hull end strictly before `later`'s start, or exactly at it for
;; a Mov witness) is tried first and keeps its exact shape; when it does not
;; apply, the webs merge if EVERY cross pair of members has disjoint hulls. See
;; the header for why the second test subsumes the first at any given state.
(define (compiler-reg-color-scalar-alias-link!
  [type-segment-bases : i64]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [earlier : i64]
  [later : i64]
  [mov-witness : bool]) : unit
  (if (and
    (>= earlier 0)
    (< earlier (array-length alias))
    (>= later 0)
    (< later (array-length alias))
    (not (= earlier later))
    (compiler-reg-global-array-element-shared-view eligible earlier)
    (compiler-reg-global-array-element-shared-view eligible later)
    (>= (compiler-reg-global-array-element-shared-view ep-starts earlier) 0)
    (>= (compiler-reg-global-array-element-shared-view ep-starts later) 0))
    (let
      [root : i64
        (compiler-reg-color-group-alias-root
          (compiler-reg-global-shared-view alias)
          earlier)]
      [other : i64
        (compiler-reg-color-group-alias-root
          (compiler-reg-global-shared-view alias)
          later)]
      [bounded : bool
        (and
          (>= root 0)
          (< root (array-length alias))
          (>= other 0)
          (< other (array-length alias))
          (not (= root other))
          (compiler-reg-global-array-element-shared-view eligible root)
          (compiler-reg-global-array-element-shared-view eligible other)
          (>= (compiler-reg-global-array-element-shared-view web-end root) 0)
          (>= (compiler-reg-global-array-element-shared-view web-end other) 0)
          (ast.ast-type-eq-with-seg-bases?
            type-segment-bases
            (compiler-reg-global-array-element-shared-view var-tys root)
            (compiler-reg-global-array-element-shared-view var-tys later))
          (ast.ast-type-eq-with-seg-bases?
            type-segment-bases
            (compiler-reg-global-array-element-shared-view var-tys root)
            (compiler-reg-global-array-element-shared-view var-tys other)))]
      ;; The pre-M-B3 rule, unchanged: `later` still virgin, and the web's
      ;; running maximum end strictly before its start (or the Mov touch).
      [monotone : bool
        (and
          bounded
          (= other later)
          (< (compiler-reg-global-array-element-shared-view alias later) 0)
          (not (compiler-reg-global-array-element-shared-view web-root later))
          (if (<
            (compiler-reg-global-array-element-shared-view web-end root)
            (compiler-reg-global-array-element-shared-view ep-starts later))
            true
            (and
              mov-witness
              (=
                (compiler-reg-global-array-element-shared-view web-end root)
                (compiler-reg-global-array-element-shared-view ep-ends earlier))
              (=
                (compiler-reg-global-array-element-shared-view ep-ends earlier)
                (compiler-reg-global-array-element-shared-view ep-starts later)))))]
      [merge : bool
        (or
          monotone
          (and
            bounded
            (<=
              (+
                (compiler-reg-global-array-element-shared-view web-size root)
                (compiler-reg-global-array-element-shared-view web-size other))
              compiler-reg-color-scalar-web-cap)
            (compiler-reg-color-scalar-webs-disjoint?
              (compiler-reg-global-shared-view web-next)
              ep-starts
              (compiler-reg-global-shared-view ep-ends)
              root
              other
              (if mov-witness
                earlier
                (- 0 1))
              (if mov-witness
                later
                (- 0 1)))))]
      (if merge
        (compiler-reg-color-scalar-web-splice!
          alias
          web-root
          web-end
          web-next
          web-size
          ep-ends
          root
          other)
        unit))
    unit))

;; A phi pair has no Mov witness, so both orderings are offered and whichever
;; direction the web rule admits wins; equal starts are impossible for distinct
;; defs and are rejected by both attempts.
;;
;; LOOP-CARRY PRIORITY (M-B3). Inputs are offered in TWO passes: `phi-pass` true
;; visits only inputs that are themselves phi definitions, then a second call
;; visits the rest. A phi dst whose sources conflict with each other can join only
;; ONE of their webs, and the first offer wins; taking the phi-defined source
;; first puts the dst in the LOOP CARRY's web rather than a computed value's.
;; That is the profitable choice: the carry's web already spans the header phi and
;; the back-edge phi, so joining it turns several edges' copies into same-home
;; no-ops, while joining a computed value's singleton web can only ever silence
;; the one edge that value arrives on. In it-intern-slice this is exactly
;; `%208 = phi [%187, if_else.36], [%210, if_then.35]`: `%187` (an `add`) truly
;; overlaps `%210` at its own def point, so only one of the two can be joined, and
;; taking `%210` retires the copies on the if_then.35 and if_merge.37 edges
;; (4.15M dynamic) at the cost of one on if_else.36 (0.79M).
(define (compiler-reg-color-scalar-alias-phi-inputs!
  [type-segment-bases : i64]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]
  [phi-pass : bool]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-scalar-alias-phi-inputs!
        type-segment-bases
        alias
        web-root
        web-end
        web-next
        web-size
        eligible
        var-tys
        ep-starts
        ep-ends
        phi-def
        phi-pass
        dst
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (match value
          [(ir.CompilerIrValue.Var src)
            (let
              [src-is-phi : bool
                (and
                  (>= src 0)
                  (< src (array-length phi-def))
                  (array-ref phi-def src))]
              (when
                (if phi-pass
                  src-is-phi
                  (not src-is-phi))
                (begin
                  (compiler-reg-color-scalar-alias-link!
                    type-segment-bases
                    (compiler-reg-global-shared-view alias)
                    (compiler-reg-global-shared-view web-root)
                    (compiler-reg-global-shared-view web-end)
                    (compiler-reg-global-shared-view web-next)
                    (compiler-reg-global-shared-view web-size)
                    (compiler-reg-global-shared-view eligible)
                    (compiler-reg-global-shared-view var-tys)
                    (compiler-reg-global-shared-view ep-starts)
                    (compiler-reg-global-shared-view ep-ends)
                    src
                    dst
                    false)
                  (compiler-reg-color-scalar-alias-link!
                    type-segment-bases
                    (compiler-reg-global-shared-view alias)
                    (compiler-reg-global-shared-view web-root)
                    (compiler-reg-global-shared-view web-end)
                    (compiler-reg-global-shared-view web-next)
                    (compiler-reg-global-shared-view web-size)
                    (compiler-reg-global-shared-view eligible)
                    (compiler-reg-global-shared-view var-tys)
                    (compiler-reg-global-shared-view ep-starts)
                    (compiler-reg-global-shared-view ep-ends)
                    dst
                    src
                    false))))]
          [_ unit])
        (compiler-reg-color-scalar-alias-phi-inputs!
          type-segment-bases
          alias
          web-root
          web-end
          web-next
          web-size
          eligible
          var-tys
          ep-starts
          ep-ends
          phi-def
          phi-pass
          dst
          (compiler-reg-box-shared-view rest)))]))

;; --- the induction-step witness -------------------------------------------------
;;
;; A loop counter's web is `phi <- step`, and the step is `next = cur + k` for a
;; literal `k`, never a Mov. Without a witness for THAT link the pair fails the
;; all-pairs disjointness rule -- `cur` is live from the header down to the step
;; and `next` from the step to the back edge, so the two hulls TOUCH at the step
;; instruction -- and a spilled counter then pays, every iteration, a second slot
;; plus a slot-to-slot phi copy through a scratch register (measured in
;; cfg_domloops: eight instructions per iteration to decrement `pos` and branch,
;; where three suffice).
;;
;; The Mov witness's own argument covers this shape unchanged. Interval points are
;; two coordinates per instruction: an instruction's uses and its def are both
;; stamped at its point, and anything live AFTER it is stamped at point+1. So
;; `hull(src).end == hull(dst).start` still says exactly "src's last liveness event
;; is this instruction, dst's first is this instruction" -- src is dead after the
;; step, which is what makes one home serve both.
;;
;; WHY THE BACKEND IS SAFE HERE. The hazard the header warns about is a
;; destination home written before a source home is read, which is what a parallel
;; copy at a block edge can do. A BinOp is not a parallel copy: the emitter stages
;; the LHS into a register, applies the operator against the RHS operand, and only
;; then writes the destination home (`compiler-backend-binop-asm-with-plan` builds
;; exactly that sequence), so BOTH operands are consumed before the destination is
;; written. That is what makes either operand a legal witness, whatever the other
;; one is.
;;
;; The admitted operator set is the plain two-operand ALU family, whose lowering
;; is that staged sequence and nothing else. Everything with its own register
;; discipline is excluded so no operator that writes a fixed register before
;; consuming its operands can reach the rule: Div/Mod/SafeDiv/SafeMod (the
;; rdx:rax pair plus the planned min/neg registers), Shl/Shr (the %cl count).
;; The comparisons are excluded too -- they define a `bool` while their operands
;; are the compared width, so the link's own type-equality guard would refuse
;; them anyway, and naming them here keeps the reason local.
(define (compiler-reg-color-scalar-step-op? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Add) true]
    [(ir.CompilerIrBinOp.Sub) true]
    [(ir.CompilerIrBinOp.Mul) true]
    [(ir.CompilerIrBinOp.And) true]
    [(ir.CompilerIrBinOp.Or) true]
    [(ir.CompilerIrBinOp.BitAnd) true]
    [(ir.CompilerIrBinOp.BitOr) true]
    [(ir.CompilerIrBinOp.BitXor) true]
    [_ false]))

;; Offer one BinOp operand as the induction-step witness. Both operands are
;; offered, in operand order, and the hull equality decides which one -- if
;; either -- actually dies here. When BOTH do (`dst = a + b` with a and b each
;; last used at this instruction) only the first can join: the second offer finds
;; the destination already rooted in the first operand's web, falls through to
;; the all-pairs rule, and is refused there because a and b are live at once up
;; to this point. So the shared home is always a home the surviving member alone
;; was reading.
(define (compiler-reg-color-scalar-alias-step-operand!
  [type-segment-bases : i64]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [operand : ir.CompilerIrValue]
  [dst : i64]) : unit
  (match operand
    [(ir.CompilerIrValue.Var src-var)
      (compiler-reg-color-scalar-alias-link!
        type-segment-bases
        alias
        web-root
        web-end
        web-next
        web-size
        eligible
        var-tys
        ep-starts
        ep-ends
        src-var
        dst
        true)]
    [_ unit]))

;; One instruction's link offers for ONE pass. `phi-pass` true is the loop-carry
;; priority pass (phi-defined phi inputs only); the Mov witness rides that pass so
;; the second visit adds nothing for non-phi instructions. The caller re-reads the
;; instruction for the second pass because a phi's input list is owned.
(define (compiler-reg-color-scalar-alias-instr!
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]
  [phi-pass : bool]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var src-var)
          (when
            phi-pass
            (compiler-reg-color-scalar-alias-link!
              type-segment-bases
              alias
              web-root
              web-end
              web-next
              web-size
              eligible
              var-tys
              ep-starts
              ep-ends
              src-var
              dst
              true))]
        [_ unit])]
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
      ;; The induction step `next = cur <op> k` and its accumulator cousins:
      ;; same witness as a Mov (see above).
      (when
        (and phi-pass (compiler-reg-color-scalar-step-op? op))
        (begin
          (compiler-reg-color-scalar-alias-step-operand!
            type-segment-bases
            (compiler-reg-global-shared-view alias)
            (compiler-reg-global-shared-view web-root)
            (compiler-reg-global-shared-view web-end)
            (compiler-reg-global-shared-view web-next)
            (compiler-reg-global-shared-view web-size)
            (compiler-reg-global-shared-view eligible)
            (compiler-reg-global-shared-view var-tys)
            (compiler-reg-global-shared-view ep-starts)
            (compiler-reg-global-shared-view ep-ends)
            lhs
            dst)
          (compiler-reg-color-scalar-alias-step-operand!
            type-segment-bases
            alias
            web-root
            web-end
            web-next
            web-size
            eligible
            var-tys
            ep-starts
            ep-ends
            rhs
            dst)))]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-scalar-alias-phi-inputs!
        type-segment-bases
        alias
        web-root
        web-end
        web-next
        web-size
        eligible
        var-tys
        ep-starts
        ep-ends
        phi-def
        phi-pass
        dst
        inputs)]
    [_ unit]))

(define (compiler-reg-color-scalar-alias-seq!
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (compiler-reg-global-shared-view instrs.slots)]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [i : i64 0]
    (while (< i len)
      (begin
        ;; Loop-carry priority: offer this instruction's phi-defined inputs (and
        ;; the Mov witness) first, then its remaining inputs.
        (compiler-reg-color-scalar-alias-instr!
          type-segment-bases
          (compiler-reg-global-array-element-shared-view slots i)
          (compiler-reg-global-shared-view alias)
          (compiler-reg-global-shared-view web-root)
          (compiler-reg-global-shared-view web-end)
          (compiler-reg-global-shared-view web-next)
          (compiler-reg-global-shared-view web-size)
          (compiler-reg-global-shared-view eligible)
          (compiler-reg-global-shared-view var-tys)
          (compiler-reg-global-shared-view ep-starts)
          (compiler-reg-global-shared-view ep-ends)
          (compiler-reg-global-shared-view phi-def)
          true)
        ;; Only a Phi has anything left for the second pass, and re-reading the
        ;; instruction owns a copy -- borrow-test the tag before paying for it.
        (match (& (array-ref slots i))
          [(ir.CompilerIrInstr.Phi _ _ _)
            (compiler-reg-color-scalar-alias-instr!
              type-segment-bases
              (ir.compiler-ir-instr-seq-ref
                (compiler-reg-global-shared-view instrs)
                i)
              (compiler-reg-global-shared-view alias)
              (compiler-reg-global-shared-view web-root)
              (compiler-reg-global-shared-view web-end)
              (compiler-reg-global-shared-view web-next)
              (compiler-reg-global-shared-view web-size)
              (compiler-reg-global-shared-view eligible)
              (compiler-reg-global-shared-view var-tys)
              (compiler-reg-global-shared-view ep-starts)
              (compiler-reg-global-shared-view ep-ends)
              (compiler-reg-global-shared-view phi-def)
              false)]
          [_ unit])
        (set! i (+ i 1))))))

(define (compiler-reg-color-scalar-alias-blocks!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [alias : (__tl_dyn-array i64)]
  [web-root : (__tl_dyn-array bool)]
  [web-end : (__tl_dyn-array i64)]
  [web-next : (__tl_dyn-array i64)]
  [web-size : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [ep-starts : (__tl_dyn-array i64)]
  [ep-ends : (__tl_dyn-array i64)]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-scalar-alias-seq!
              type-segment-bases
              (compiler-reg-global-shared-view instrs)
              (compiler-reg-global-shared-view alias)
              (compiler-reg-global-shared-view web-root)
              (compiler-reg-global-shared-view web-end)
              (compiler-reg-global-shared-view web-next)
              (compiler-reg-global-shared-view web-size)
              (compiler-reg-global-shared-view eligible)
              (compiler-reg-global-shared-view var-tys)
              (compiler-reg-global-shared-view ep-starts)
              (compiler-reg-global-shared-view ep-ends)
              (compiler-reg-global-shared-view phi-def))])
        (compiler-reg-color-scalar-alias-blocks!
          type-segment-bases
          (compiler-reg-box-shared-view rest)
          alias
          web-root
          web-end
          web-next
          web-size
          eligible
          var-tys
          ep-starts
          ep-ends
          phi-def))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (<
          i
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq)))
          (begin
            (match (ir.compiler-ir-block-seq-ref
              (compiler-reg-global-shared-view seq)
              i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-scalar-alias-seq!
                  type-segment-bases
                  (compiler-reg-global-shared-view instrs)
                  (compiler-reg-global-shared-view alias)
                  (compiler-reg-global-shared-view web-root)
                  (compiler-reg-global-shared-view web-end)
                  (compiler-reg-global-shared-view web-next)
                  (compiler-reg-global-shared-view web-size)
                  (compiler-reg-global-shared-view eligible)
                  (compiler-reg-global-shared-view var-tys)
                  (compiler-reg-global-shared-view ep-starts)
                  (compiler-reg-global-shared-view ep-ends)
                  (compiler-reg-global-shared-view phi-def))])
            (set! i (+ i 1)))))]))

;; Mark every variable defined by a Phi, for the loop-carry priority pass.
(define (compiler-reg-color-scalar-phi-def-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (compiler-reg-global-shared-view instrs.slots)]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [i : i64 0]
    (while (< i len)
      (begin
        (match (& (array-ref slots i))
          [(ir.CompilerIrInstr.Phi _ _ _)
            (match (ir.compiler-ir-instr-seq-ref instrs i)
              [(ir.CompilerIrInstr.Phi dst _ _)
                (when
                  (and (>= dst 0) (< dst (array-length phi-def)))
                  (set! (array-ref phi-def dst) true))]
              [_ unit])]
          [_ unit])
        (set! i (+ i 1))))))

(define (compiler-reg-color-scalar-phi-def-blocks!
  [blocks : ir.CompilerIrBlockList]
  [phi-def : (__tl_dyn-array bool)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-color-scalar-phi-def-seq!
              instrs
              (compiler-reg-global-shared-view phi-def))])
        (compiler-reg-color-scalar-phi-def-blocks!
          (compiler-reg-box-shared-view rest)
          phi-def))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        (while (<
          i
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq)))
          (begin
            (match (ir.compiler-ir-block-seq-ref
              (compiler-reg-global-shared-view seq)
              i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-color-scalar-phi-def-seq!
                  instrs
                  (compiler-reg-global-shared-view phi-def))])
            (set! i (+ i 1)))))]))

;; Cheap gate: does any Mov or Phi in the function relate two members-in-waiting?
;; A function with no candidate pair never pays for the edge-precise liveness
;; fixpoint below, which is the only non-trivial cost this pass adds.
(define (compiler-reg-color-scalar-alias-candidate-inputs?
  [eligible : (__tl_dyn-array bool)]
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-scalar-alias-candidate-inputs?
        eligible
        dst
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (if (match value
        [(ir.CompilerIrValue.Var src)
          (and
            (not (= src dst))
            (>= src 0)
            (< src (array-length eligible))
            (array-ref eligible src))]
        [_ false])
        true
        (compiler-reg-color-scalar-alias-candidate-inputs?
          eligible
          dst
          (compiler-reg-box-shared-view rest)))]))

(define (compiler-reg-color-scalar-alias-candidate-instr?
  [instr : ir.CompilerIrInstr]
  [eligible : (__tl_dyn-array bool)]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (and
        (>= dst 0)
        (< dst (array-length eligible))
        (array-ref eligible dst)
        (match src
          [(ir.CompilerIrValue.Var src-var)
            (and
              (not (= src-var dst))
              (>= src-var 0)
              (< src-var (array-length eligible))
              (array-ref eligible src-var))]
          [_ false]))]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (and
        (>= dst 0)
        (< dst (array-length eligible))
        (array-ref eligible dst)
        (compiler-reg-color-scalar-alias-candidate-inputs? eligible dst inputs))]
    [_ false]))

(define (compiler-reg-color-scalar-alias-candidate-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [eligible : (__tl_dyn-array bool)]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64
      (ir.compiler-ir-instr-seq-count (compiler-reg-global-shared-view instrs))]
    [i : i64 0]
    [found : bool false]
    (begin
      (while (and (< i len) (not found))
        (begin
          (if (compiler-reg-color-scalar-alias-candidate-instr?
            (compiler-reg-global-array-element-shared-view slots i)
            (compiler-reg-global-shared-view eligible))
            (set! found true)
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-color-scalar-alias-candidate-blocks?
  [blocks : ir.CompilerIrBlockList]
  [eligible : (__tl_dyn-array bool)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (if (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-scalar-alias-candidate-seq?
            instrs
            (compiler-reg-global-shared-view eligible))])
        true
        (compiler-reg-color-scalar-alias-candidate-blocks?
          (compiler-reg-box-shared-view rest)
          eligible))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64
          (ir.compiler-ir-block-seq-count (compiler-reg-global-shared-view seq))]
        [found : bool false]
        (begin
          (while (and (< i count) (not found))
            (begin
              (if (match (ir.compiler-ir-block-seq-ref
                (compiler-reg-global-shared-view seq)
                i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (compiler-reg-color-scalar-alias-candidate-seq?
                    instrs
                    (compiler-reg-global-shared-view eligible))])
                (set! found true)
                unit)
              (set! i (+ i 1))))
          found))]))

(define (compiler-reg-color-scalar-alias
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [slot-eligible : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [hull-starts : (__tl_dyn-array i64)]
  [vector-stack-words : (__tl_dyn-array i64)]) : (__tl_dyn-array i64)
  (let
    [alias : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [eligible : (__tl_dyn-array bool) (array.make-array bool vars)]
    [_cleared : unit
      (compiler-reg-fill-i64-array
        (compiler-reg-global-shared-view alias)
        (- 0 1))]
    [_eligible : unit
      (compiler-reg-color-scalar-alias-eligible!
        (compiler-reg-global-shared-view eligible)
        vars
        (compiler-reg-global-shared-view slot-eligible)
        (compiler-reg-global-shared-view hull-starts)
        (compiler-reg-global-shared-view vector-stack-words))]
    (begin
      (if (compiler-reg-color-scalar-alias-candidate-blocks?
        (compiler-reg-global-shared-view blocks)
        (compiler-reg-global-shared-view eligible))
        (let
          [ep-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [ep-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [web-end : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [web-root : (__tl_dyn-array bool) (array.make-array bool vars)]
          ;; Intrusive circular member list + size, one web per variable to start
          ;; (a singleton's `web-next` points at itself).
          [web-next : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [web-size : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [phi-def : (__tl_dyn-array bool) (array.make-array bool vars)]
          [liveness : live.CompilerFunctionLiveness
            (live.compiler-live-analyze-blocks-edge-precise
              (compiler-reg-global-shared-view blocks)
              vars)]
          (begin
            (compiler-reg-fill-i64-array
              (compiler-reg-global-shared-view ep-starts)
              (- 0 1))
            (compiler-reg-fill-i64-array
              (compiler-reg-global-shared-view ep-ends)
              (- 0 1))
            (compiler-reg-color-ep-hull-blocks!
              (compiler-reg-global-shared-view blocks)
              (compiler-reg-global-shared-view liveness)
              0
              (compiler-reg-global-shared-view ep-starts)
              (compiler-reg-global-shared-view ep-ends))
            (compiler-reg-color-scalar-phi-def-blocks!
              (compiler-reg-global-shared-view blocks)
              (compiler-reg-global-shared-view phi-def))
            (let
              [i : i64 0]
              (while (< i vars)
                (begin
                  (set! (array-ref web-end i) (array-ref ep-ends i))
                  (set! (array-ref web-root i) false)
                  (set! (array-ref web-next i) i)
                  (set! (array-ref web-size i) 1)
                  (set! i (+ i 1)))))
            (compiler-reg-color-scalar-alias-blocks!
              type-segment-bases
              (compiler-reg-global-shared-view blocks)
              (compiler-reg-global-shared-view alias)
              (compiler-reg-global-shared-view web-root)
              (compiler-reg-global-shared-view web-end)
              (compiler-reg-global-shared-view web-next)
              (compiler-reg-global-shared-view web-size)
              (compiler-reg-global-shared-view eligible)
              (compiler-reg-global-shared-view var-tys)
              (compiler-reg-global-shared-view ep-starts)
              (compiler-reg-global-shared-view ep-ends)
              (compiler-reg-global-shared-view phi-def))))
        unit)
      alias)))

;; Collect the intervals the scalar walk can act on, in the interval sequence's
;; own order, and report how many were kept.
;;
;; An interval is dropped when its web root fails the walk's STATIC skip test,
;; already decided per variable in `slot-eligible`. None of those conditions
;; changes while the walk runs, so the walk would visit such an interval only to
;; skip it without touching any state; dropping it here is invisible to the
;; result and takes ~99% of the entries out of the sort, the extent scan and the
;; walk. The one remaining skip -- `remap` filled in BY the walk for a split
;; interval's earlier sibling -- is dynamic and stays in the walk.
;;
;; Every interval of one variable shares one web root and therefore one verdict,
;; which is what keeps compiler-reg-color-extent-ends exact on the survivors for
;; the variables the walk actually reads. The kept entries still carry their
;; ORIGINAL variable, so the sort key below is the one the full array used;
;; compiler-reg-color-alias-rewrite-intervals! retargets them afterwards exactly
;; as it did before.
(define (compiler-reg-color-walk-interval-fill
  [intervals : CompilerRegIntervalSeq]
  [items : (__tl_dyn-array CompilerRegInterval)]
  [alias : (__tl_dyn-array i64)]
  [slot-eligible : (__tl_dyn-array bool)]) : i64
  (let
    [count : i64 (compiler-reg-interval-seq-count intervals)]
    [index : i64 0]
    [out-index : i64 0]
    (begin
      (while (< index count)
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref intervals index)]
            (if (array-ref
              slot-eligible
              (compiler-reg-color-group-alias-root
                (compiler-reg-global-shared-view alias)
                interval.var))
              (begin
                (set! (array-ref items out-index) interval)
                (set! out-index (+ out-index 1)))
              unit))
          (set! index (+ index 1))))
      out-index)))

;; Retarget every kept interval of an aliased member onto its web root, so the
;; scalar walk colors the web ONCE against the union of the members'
;; conservative hulls (compiler-reg-color-extent-ends then reports that union as
;; the root's extent). Starts are untouched and the array is already sorted on
;; the pre-alias key, so the walk's greedy order is unchanged.
(define (compiler-reg-color-alias-rewrite-intervals!
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]
  [alias : (__tl_dyn-array i64)]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (let
          [interval : CompilerRegInterval (array-ref items i)]
          [var : i64 interval.var]
          [root : i64
            (compiler-reg-color-group-alias-root
              (compiler-reg-global-shared-view alias)
              var)]
          (if (= root var)
            unit
            (begin
              (set!
                (array-ref items i)
                (CompilerRegInterval root interval.start interval.end))
              unit)))
        (set! i (+ i 1))))))

;; Members took no slot of their own during the walk; hand each one its web
;; root's slot. A member the storage pass already claimed keeps that home, so no
;; earlier decision is overwritten.
(define (compiler-reg-color-alias-propagate-remap!
  [remap : (__tl_dyn-array i64)]
  [alias : (__tl_dyn-array i64)]
  [vars : i64]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (if (< (array-ref remap i) 0)
          (let
            [root : i64
              (compiler-reg-color-group-alias-root
                (compiler-reg-global-shared-view alias)
                i)]
            (if (and (not (= root i)) (>= (array-ref remap root) 0))
              (set! (array-ref remap i) (array-ref remap root))
              unit))
          unit)
        (set! i (+ i 1))))))

;; Total frame renumbering: colorable stack scalars share slots when their
;; intervals are disjoint, colorable inline-storage ranges are shared above
;; that scalar prefix, every remaining slot-resident variable gets a private
;; dense slot above them, and register-homed variables move to ids that are not
;; used by a stack slot. The assignment table is rebuilt on the new keys.
;;
;; `fusion-pinned` names spilled variables whose IDENTITY the backend still
;; needs after the renumbering: a single-use address temp the following
;; instruction folds into its addressing mode (see
;; compiler-backend-gep-fusion-pinned-vars). Merging one of those onto a shared
;; representative would make the merged id's use count -- recomputed on the
;; remapped blocks -- far greater than one and silently disable the fusion
;; peephole. Pinned variables are therefore withheld from every sharing
;; mechanism (the scalar walk and its phi/mov webs) and land in the private
;; dense slots below, one fresh slot each.
(define (compiler-reg-color-stack-slots
  [type-segment-bases : i64]
  [plan : CompilerRegPlan]
  [group-vars : live.CompilerLiveI64Set]
  [params : ir.CompilerIrParamList]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [slot-candidate-vars : i64]
  [fusion-pinned : live.CompilerLiveI64Set]) : CompilerRegColoring
  (let
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-plan-intervals (compiler-reg-global-shared-view plan))]
    (if (compiler-reg-interval-seq-empty? intervals)
      CompilerRegColoring.None
      (let
        [vector-stack-words : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [_vector-stack-words : unit
          (begin
            (compiler-reg-vector-stack-words-params!
              (compiler-reg-global-shared-view params)
              (compiler-reg-global-shared-view vector-stack-words))
            (compiler-reg-vector-stack-words-blocks!
              (compiler-reg-global-shared-view blocks)
              (compiler-reg-global-shared-view vector-stack-words)))]
        [slots : i64
          (+
            (+
              vars
              (compiler-reg-vector-stack-extra-slots
                (compiler-reg-global-shared-view vector-stack-words)
                0
                0))
            8)]
        [slot-ends : (__tl_dyn-array i64) (array.make-array i64 slots)]
        [assignments : CompilerRegAssignmentTable
          (compiler-reg-plan-assignments (compiler-reg-global-shared-view plan))]
        [assignment-index : CompilerRegAssignmentTable
          (compiler-reg-assignment-table-with-min-capacity
            (compiler-reg-global-shared-view assignments)
            vars)]
        [ineligible : live.CompilerLiveI64Set
          (compiler-reg-plan-ineligible (compiler-reg-global-shared-view plan))]
        [colorable : (__tl_dyn-array bool) (array.make-array bool vars)]
        ;; Boolean, not a count: the only question asked below is whether the
        ;; variable is referenced at all (see compiler-reg-ref-marks-blocks!).
        [references : (__tl_dyn-array bool) (array.make-array bool vars)]
        [remap : (__tl_dyn-array i64) (array.make-array i64 vars)]
        ;; `colorable` is not cleared here: `array.make-array` zero-fills its
        ;; backing store (bool's default is the all-zero byte), so every element
        ;; already reads `false`, and `compiler-reg-color-flags` below only
        ;; overwrites the entries it decides. `references` above relies on the
        ;; same zero-fill for its "no IR reference" default.
        [_cleared : unit
          (let
            [i : i64 0]
            (begin
              (while (< i slots)
                (begin
                  (set! (array-ref slot-ends i) (- 0 1))
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (set! (array-ref remap i) (- 0 1))
                  (set! i (+ i 1))))))]
        [_flagged : unit
          (begin
            (compiler-reg-color-flags
              (compiler-reg-plan-types (compiler-reg-global-shared-view plan))
              (compiler-reg-global-shared-view colorable))
            ;; Scratch pseudo-vars are consumed through planned registers or
            ;; the legacy scavenger, never through formula stack slots.
            (let
              [i : i64 slot-candidate-vars]
              (while (< i vars)
                (begin
                  (set! (array-ref colorable i) false)
                  (set! i (+ i 1)))))
            ;; Clearing the colorable flag is exactly the "no shared slot"
            ;; decision: it withdraws the variable from the scalar walk AND
            ;; from the phi/mov web builder (the only two mechanisms that hand
            ;; one slot to several variables), leaving the private-slot loop
            ;; below to give it a fresh id of its own.
            (if (>
              (live.compiler-live-set-word-count
                (compiler-reg-global-shared-view fusion-pinned))
              0)
              (let
                [i : i64 0]
                (while (< i vars)
                  (begin
                    (if (live.compiler-live-set-contains?
                      (compiler-reg-global-shared-view fusion-pinned)
                      i)
                      (set! (array-ref colorable i) false)
                      unit)
                    (set! i (+ i 1)))))
              unit))]
        ;; Count direct IR uses and defs, not type-table membership: dead defs
        ;; still emit a write, while raw-id holes and register-only scratch
        ;; pseudo-vars have no instruction reference and need no formula slot.
        [_referenced : unit
          (begin
            (compiler-reg-color-reference-intervals!
              (compiler-reg-global-shared-view intervals)
              (compiler-reg-global-shared-view references))
            (compiler-reg-ref-marks-blocks!
              (compiler-reg-global-shared-view references)
              (compiler-reg-global-shared-view blocks))
            (compiler-reg-spmd-avx2-special-param-references!
              (compiler-reg-global-shared-view params)
              (compiler-reg-global-shared-view references)))]
        [var-tys : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType vars)]
        [slot-tys : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType slots)]
        [_typed : unit
          (compiler-reg-color-var-tys
            (compiler-reg-plan-types (compiler-reg-global-shared-view plan))
            (compiler-reg-global-shared-view var-tys))]
        [param-floor : i64
          (compiler-reg-color-param-pins
            (compiler-reg-global-shared-view params)
            (compiler-reg-global-shared-view remap)
            (compiler-reg-global-shared-view slot-ends)
            0)]
        ;; The scalar walk's per-variable admission test, decided once here --
        ;; after the parameter pins are in `remap`, which is the last write
        ;; before the walk itself starts filling it -- and read by the web
        ;; builder and by the interval filter below.
        [slot-eligible : (__tl_dyn-array bool) (array.make-array bool vars)]
        [_slot-eligible : unit
          (compiler-reg-color-slot-eligible!
            (compiler-reg-global-shared-view slot-eligible)
            vars
            (compiler-reg-global-shared-view group-vars)
            (compiler-reg-global-shared-view ineligible)
            (compiler-reg-global-shared-view assignment-index)
            (compiler-reg-global-shared-view colorable)
            (compiler-reg-global-shared-view remap))]
        ;; Conservative per-var hulls of the plan intervals, shared by the
        ;; scalar-web membership gate below and the group-Mov overlay further
        ;; down (both only ever read them).
        [hull-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [hull-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [_hull-bounds : unit
          (begin
            (compiler-reg-fill-i64-array
              (compiler-reg-global-shared-view hull-starts)
              (- 0 1))
            (compiler-reg-fill-i64-array
              (compiler-reg-global-shared-view hull-ends)
              (- 0 1))
            (compiler-reg-color-hull-bounds
              (compiler-reg-global-shared-view intervals)
              (compiler-reg-global-shared-view hull-starts)
              (compiler-reg-global-shared-view hull-ends)))]
        ;; M-B2: member -> web-root links for scalar phi/mov webs whose
        ;; edge-precise hulls never overlap (see the header above). Applied by
        ;; retargeting the members' intervals onto the root before the walk,
        ;; and by handing each member the root's slot after it.
        [scalar-alias : (__tl_dyn-array i64)
          (compiler-reg-color-scalar-alias
            type-segment-bases
            (compiler-reg-global-shared-view blocks)
            vars
            (compiler-reg-global-shared-view slot-eligible)
            (compiler-reg-global-shared-view var-tys)
            (compiler-reg-global-shared-view hull-starts)
            (compiler-reg-global-shared-view vector-stack-words))]
        [sorted : (__tl_dyn-array CompilerRegInterval)
          (array.make-array
            CompilerRegInterval
            (compiler-reg-interval-seq-count intervals))]
        ;; Only the walk-eligible intervals land in `sorted`; `sorted-count`
        ;; bounds them and everything downstream reads that bound instead of
        ;; the array's capacity.
        [sorted-count : i64
          (compiler-reg-color-walk-interval-fill
            (compiler-reg-global-shared-view intervals)
            (compiler-reg-global-shared-view sorted)
            (compiler-reg-global-shared-view scalar-alias)
            (compiler-reg-global-shared-view slot-eligible))]
        [_sorted : unit
          (compiler-reg-color-heapsort
            (compiler-reg-global-shared-view sorted)
            sorted-count)]
        [_alias-intervals : unit
          (compiler-reg-color-alias-rewrite-intervals!
            (compiler-reg-global-shared-view sorted)
            sorted-count
            (compiler-reg-global-shared-view scalar-alias))]
        [extent-ends : (__tl_dyn-array i64)
          (compiler-reg-color-extent-ends
            (compiler-reg-global-shared-view sorted)
            sorted-count
            vars)]
        [stack-prefix : i64
          (compiler-reg-color-walk
            type-segment-bases
            (compiler-reg-global-shared-view sorted)
            sorted-count
            0
            (compiler-reg-global-shared-view assignment-index)
            (compiler-reg-global-shared-view group-vars)
            (compiler-reg-global-shared-view ineligible)
            (compiler-reg-global-shared-view colorable)
            (compiler-reg-global-shared-view var-tys)
            (compiler-reg-global-shared-view slot-ends)
            (compiler-reg-global-shared-view slot-tys)
            (compiler-reg-global-shared-view extent-ends)
            0
            (compiler-reg-global-shared-view remap))]
        [storage-prefix : i64
          (compiler-reg-color-inline-storage
            (compiler-reg-global-shared-view blocks)
            (compiler-reg-global-shared-view intervals)
            (compiler-reg-global-shared-view slot-ends)
            (compiler-reg-global-shared-view remap)
            vars
            stack-prefix)]
        [_alias-remap : unit
          (compiler-reg-color-alias-propagate-remap!
            (compiler-reg-global-shared-view remap)
            (compiler-reg-global-shared-view scalar-alias)
            vars)]
        [group-alias
          : (__tl_dyn-array i64)
          ;; M-B: dst -> src alias links for coalescable group-typed Movs
          ;; (see compiler-reg-color-group-mov-alias-instr!). Applied in the
          ;; private-slot loop below: an aliased dst shares its root's slot
          ;; pair instead of taking a fresh one.
          (let
            [alias : (__tl_dyn-array i64) (array.make-array i64 vars)]
            (begin
              (compiler-reg-fill-i64-array
                (compiler-reg-global-shared-view alias)
                (- 0 1))
              (compiler-reg-color-group-mov-alias-blocks!
                type-segment-bases
                (compiler-reg-global-shared-view blocks)
                (compiler-reg-global-shared-view alias)
                (compiler-reg-global-shared-view group-vars)
                (compiler-reg-global-shared-view ineligible)
                (compiler-reg-global-shared-view assignment-index)
                (compiler-reg-global-shared-view var-tys)
                (compiler-reg-global-shared-view remap)
                (compiler-reg-global-shared-view hull-starts)
                (compiler-reg-global-shared-view hull-ends))
              alias))]
        [slot-count
          : i64
          ;; Private dense slots for final, real IR variables that the scalar
          ;; and inline-storage walks skipped, one slot each. Raw-id holes and
          ;; register-only scratch pseudo-vars have no frame demand. Group-
          ;; mov-aliased dsts share their root's slot pair (word1 formula
          ;; slots follow the id).
          (let
            [next : i64 storage-prefix]
            [i : i64 0]
            (begin
              (while (and (< i vars) (< i slot-candidate-vars))
                (begin
                  (if (or
                    (not (array-ref references i))
                    (>= (array-ref remap i) 0))
                    unit
                    (let
                      [root : i64
                        (compiler-reg-color-group-alias-root
                          (compiler-reg-global-shared-view group-alias)
                          i)]
                      (if (not (= root i))
                        (begin
                          (if (< (array-ref remap root) 0)
                            (let
                              [words : i64
                                (compiler-reg-vector-stack-words-for-var
                                  (compiler-reg-global-shared-view
                                    vector-stack-words)
                                  root)]
                              [slot : i64
                                (compiler-reg-color-reserve-private-range!
                                  (compiler-reg-global-shared-view slot-ends)
                                  next
                                  words)]
                              (begin
                                (set!
                                  (array-ref remap root)
                                  (+ slot (- words 1)))
                                (set! next (+ slot words))))
                            unit)
                          (set! (array-ref remap i) (array-ref remap root)))
                        (match (compiler-reg-assignment-table-lookup
                          assignment-index
                          i)
                          [(CompilerRegMaybeLocation.Some location)
                            (match location
                              [(CompilerRegLocation.Spill _)
                                (let
                                  [words : i64
                                    (compiler-reg-vector-stack-words-for-var
                                      (compiler-reg-global-shared-view
                                        vector-stack-words)
                                      i)]
                                  [slot : i64
                                    (compiler-reg-color-reserve-private-range!
                                      (compiler-reg-global-shared-view
                                        slot-ends)
                                      next
                                      words)]
                                  (begin
                                    (set!
                                      (array-ref remap i)
                                      (+ slot (- words 1)))
                                    (set! next (+ slot words))))]
                              [_ unit])]
                          [(CompilerRegMaybeLocation.No)
                            (let
                              [words : i64
                                (compiler-reg-vector-stack-words-for-var
                                  (compiler-reg-global-shared-view
                                    vector-stack-words)
                                  i)]
                              [slot : i64
                                (compiler-reg-color-reserve-private-range!
                                  (compiler-reg-global-shared-view slot-ends)
                                  next
                                  words)]
                              (begin
                                (set! (array-ref remap i) (+ slot (- words 1)))
                                (set! next (+ slot words))))]))))
                  (set! i (+ i 1))))
              ;; Scratch pseudo-vars live above the real-IR watermark and are
              ;; register-only. Preserve those already-disjoint ids instead
              ;; of letting the generic free-id pass alias them onto a frame
              ;; slot that belongs to a real value.
              (while (< i vars)
                (begin
                  (if (< (array-ref remap i) 0)
                    (set! (array-ref remap i) i)
                    unit)
                  (set! i (+ i 1))))
              next))]
        [_renumbered
          : unit
          ;; Register-homed and unmentioned variables take the remaining FREE
          ;; ids of [0, vars), in var order (deterministic). Filling gaps
          ;; keeps the renumbering a bijection into [0, vars): an id at or
          ;; past vars would be silently dropped by the raw-var-sized rebuild
          ;; arrays and side tables. A register-homed variable never touches
          ;; its formula slot, so a free id below the watermark is safe.
          ;; `taken` starts all-false from the zero-filled allocation, as
          ;; `references` and `colorable` above do.
          (let
            [taken : (__tl_dyn-array bool) (array.make-array bool vars)]
            [i : i64 0]
            [free : i64 0]
            (begin
              (while (< i vars)
                (begin
                  (if (and
                    (>= (array-ref remap i) 0)
                    (< (array-ref remap i) vars))
                    (set! (array-ref taken (array-ref remap i)) true)
                    unit)
                  (set! i (+ i 1))))
              (set! i 0)
              (while (< i vars)
                (begin
                  (if (< (array-ref remap i) 0)
                    (begin
                      (while (if (< free vars)
                        (array-ref taken free)
                        false)
                        (set! free (+ free 1)))
                      (set! (array-ref remap i) free)
                      (set! free (+ free 1)))
                    unit)
                  (set! i (+ i 1))))))]
        (CompilerRegColoring.Remap
          remap
          (compiler-reg-max slot-count param-floor))))))

;; --- var-id remap application ----------------------------------------------
;; The backend computes stack slots from variable ids at many emission sites,
;; so compaction is applied by rewriting var ids in the IR: each stack-resident
;; variable id becomes its dense slot id and the formula slot follows. Pinned
;; params and register-homed variables keep or receive non-slot ids, so the
;; rebuilt assignment table and formula slots stay valid.
(define (compiler-reg-remap-id [remap : (__tl_dyn-array i64)] [id : i64]) : i64
  (if (and (>= id 0) (< id (array-length remap)))
    (array-ref remap id)
    id))

(define (compiler-reg-remap-value
  [remap : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : ir.CompilerIrValue
  (match (compiler-reg-global-shared-view value)
    [(ir.CompilerIrValue.Var id)
      (ir.CompilerIrValue.Var
        (compiler-reg-remap-id (compiler-reg-global-shared-view remap) id))]
    [_ value]))

(define (compiler-reg-remap-value-list
  [remap : (__tl_dyn-array i64)]
  [values : ir.CompilerIrValueList]) : ir.CompilerIrValueList
  (match (ir.compiler-ir-value-list-force-cons values)
    [(ir.CompilerIrValueList.Nil) ir.CompilerIrValueList.Nil]
    [(ir.CompilerIrValueList.Array seq)
      (compiler-reg-remap-value-list
        remap
        (ir.compiler-ir-value-seq-to-list seq))]
    [(ir.CompilerIrValueList.Cons head rest)
      (ir.compiler-ir-value-cons
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) head)
        (compiler-reg-remap-value-list
          (compiler-reg-global-shared-view remap)
          (compiler-reg-box-shared-view rest)))]))

(define (compiler-reg-remap-params
  [remap : (__tl_dyn-array i64)]
  [params : ir.CompilerIrParamList]) : ir.CompilerIrParamList
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) ir.CompilerIrParamList.Nil]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-remap-params
        (compiler-reg-global-shared-view remap)
        (ir.compiler-ir-param-seq-to-list seq))]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name ty var)
          (ir.compiler-ir-param-cons
            (ir.CompilerIrParam.Param
              name
              ty
              (compiler-reg-remap-id
                (compiler-reg-global-shared-view remap)
                var))
            (compiler-reg-remap-params
              (compiler-reg-global-shared-view remap)
              (compiler-reg-box-shared-view rest)))])]))

(define (compiler-reg-remap-call-args
  [remap : (__tl_dyn-array i64)]
  [args : ir.CompilerIrCallArgs]) : ir.CompilerIrCallArgs
  (match args
    [(ir.CompilerIrCallArgs.Nil) ir.CompilerIrCallArgs.Nil]
    [(ir.CompilerIrCallArgs.One a)
      (ir.CompilerIrCallArgs.One
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) a))]
    [(ir.CompilerIrCallArgs.Two a b)
      (ir.CompilerIrCallArgs.Two
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) a)
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) b))]
    [(ir.CompilerIrCallArgs.Array items)
      (let
        [count : i64 (array-length items)]
        [out : (__tl_dyn-array ir.CompilerIrValue)
          (array.make-array ir.CompilerIrValue count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (begin
              (set!
                (array-ref out i)
                (compiler-reg-remap-value
                  (compiler-reg-global-shared-view remap)
                  (compiler-reg-global-array-element-shared-view items i)))
              (set! i (+ i 1))))
          (ir.CompilerIrCallArgs.Array out)))]))

(define (compiler-reg-remap-spmd-call-arg
  [remap : (__tl_dyn-array i64)]
  [arg : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArg
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class value ty)
      (ir.CompilerIrSpmdCallArg.Arg
        class
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) value)
        ty)]))

(define (compiler-reg-remap-spmd-call-args
  [remap : (__tl_dyn-array i64)]
  [args : ir.CompilerIrSpmdCallArgSeq]) : ir.CompilerIrSpmdCallArgSeq
  (let
    [out : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
      (array.make-array ir.CompilerIrSpmdCallArg args.len)]
    [i : i64 0]
    (begin
      (while (< i args.len)
        (begin
          (set!
            (array-ref out i)
            (compiler-reg-remap-spmd-call-arg remap (array-ref args.slots i)))
          (set! i (+ i 1))))
      (ir.CompilerIrSpmdCallArgSeq out args.len))))

(define (compiler-reg-remap-spmd-call-result
  [remap : (__tl_dyn-array i64)]
  [result : ir.CompilerIrSpmdCallResult]) : ir.CompilerIrSpmdCallResult
  (match result
    [(ir.CompilerIrSpmdCallResult.Unit) ir.CompilerIrSpmdCallResult.Unit]
    [(ir.CompilerIrSpmdCallResult.Value dst class ty)
      (ir.CompilerIrSpmdCallResult.Value
        (compiler-reg-remap-id (compiler-reg-global-shared-view remap) dst)
        class
        ty)]))

(define (compiler-reg-remap-phi-inputs
  [remap : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-remap-phi-inputs
        remap
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) value)
        label
        (compiler-reg-remap-phi-inputs
          (compiler-reg-global-shared-view remap)
          (compiler-reg-box-shared-view rest)))]))

(define (compiler-reg-remap-maybe-value
  [remap : (__tl_dyn-array i64)]
  [value : ir.CompilerIrMaybeValue]) : ir.CompilerIrMaybeValue
  (match value
    [(ir.CompilerIrMaybeValue.No) ir.CompilerIrMaybeValue.No]
    [(ir.CompilerIrMaybeValue.Some inner)
      (ir.CompilerIrMaybeValue.Some
        (compiler-reg-remap-value (compiler-reg-global-shared-view remap) inner))]))

(define (compiler-reg-remap-instr
  [remap : (__tl_dyn-array i64)]
